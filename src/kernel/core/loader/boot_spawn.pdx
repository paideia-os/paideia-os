// src/kernel/core/loader/boot_spawn.pdx — R31.M2-1590 (#1590)
//
// The loader-side multi-task boot spawn path.
//
// What was missing
// ----------------
// Until this module, exactly one userspace task was ever created at boot:
// init. Everything else that calls itself a "userspace server" in this tree
// -- acpi_supervisor, pci_enumerator, echo_server/echo_client -- shipped as
// real source and a real ELF whose RPC surface was proven by the kernel
// calling sys_ipc_send_body / sys_ipc_recv_body / sys_ipc_reply_body against
// init's address space, synthesizing both sides of the conversation. That
// posture ("Option B") proved the mechanism honestly; what it could not
// prove is that any of it works when the server is a distinct ring-3 process
// the scheduler switches to. Three issues (#820, #860, #1015) closed on the
// mechanism, and #1086 stayed open because its deliverable -- kill the
// supervisor mid-evaluation and watch clients see ChannelDead -- had no
// process to kill.
//
// This module is the missing capability, and nothing more: create a task
// from an embedded ELF, give it its own address space, run its _init_caps
// sidecar through the loader, and hand it to the scheduler.
//
// Why there is no sched_spawn to call
// -----------------------------------
// There isn't one, in either direction. `enter_userland_initial`
// (syscall/enter_user.pdx) is a one-shot: it builds an iretq frame, flips
// CR3, and never returns, so it can launch the LAST task from kernel_main
// and no others. The only composable way into ring-3 is the fresh-task
// trampoline convention that sched_switch_r15 documents (switch.pdx §6.2)
// and that sys_fork is currently the sole instance of: pre-populate the
// task's regs_save so that the scheduler's own restore path lands on a
// landing pad which builds the iretq frame itself.
//
// So this module composes the same four writes sys_fork's phase 4.7 makes,
// against the same landing pad. That is deliberate reuse, not imitation:
// sys_fork_child_landing reads only (fork_user_rip, fork_user_rsp,
// fork_user_rflags, user_pml4_pa) off _current_tcb and zeroes rax/rdx before
// iretq. Nothing in it is fork-specific -- the two zeroed registers are
// fork's "child sees 0" semantic, and zeroed argument registers are equally
// correct for an ELF entry point that takes none. Reusing it keeps ONE
// audited ring-3 entry path in the kernel instead of two that must be kept
// in agreement.
//
// The interaction that actually matters: seeding must claim
// ---------------------------------------------------------
// #1587 added the cap_owner column and wired process death to
// cap_owner_sweep_revoke. A task spawned with seeded capabilities must have
// those capabilities CLAIMED for its (pid, generation), or the sweep will
// not find them when it dies. This is not bookkeeping pedantry. The seeding
// happens in loader_seed_caps via the _init_caps sidecar; cap_owner_claim is
// a separate operation guarded by `task_ptr != 0`; and elf_lite_load passed
// a hard-coded 0 there until #1590. The processes that hold the most
// dangerous authority in this system -- an ACPI supervisor holding
// KIND_OP_REGION windows with reach into the embedded controller -- would
// have been exactly the processes whose capabilities survived their death,
// and they would have done so silently, because a sweep against
// CAP_OWNER_NONE matches nothing and returns successfully. The fix is in
// elf_lite.pdx (thread the owner through); the witness that the fix holds
// is `boot_spawn_note_death` below, which refuses to accept a zero-count
// sweep for a task it knows was spawned with seeded caps.
//
// Frame budget
// ------------
// phys_alloc backs a fixed 1024-page (4 MiB) pool (mm/phys_pool.pdx
// PHYS_POOL_PAGES) and returns 0 on exhaustion -- there is no reclaim and
// no growth. A spawned task costs roughly: 1 PML4 root (task_new ->
// aspace_create_user) + ceil(p_memsz/4096) per PT_LOAD segment + up to 3
// intermediate page-table levels per fresh 2 MiB region + 4 user-stack
// pages, so a small server is on the order of a dozen frames.
//
// This module REFUSES rather than overlapping. BOOT_SPAWN_MIN_FREE_FRAMES
// is checked before task_new, so a spawn that could not complete never
// starts, and a spawn that fails midway tears its task back down (task_free
// -> aspace_teardown -> pid_free) instead of leaving a half-mapped aspace on
// the runqueue. The pre-check is deliberately generous relative to the
// measured cost: the failure it exists to prevent is a partially-mapped
// ring-3 task, which faults at an arbitrary later instruction and is
// diagnosed as anything but OOM.
//
// What this module does NOT do
// ----------------------------
// No restart policy, no supervision tree, no dynamic spawn syscall. The
// service registry below records (pid, generation) per spawned task for
// exactly one purpose: so the death path can tell "a service died" from
// "some task died". Restart is #1086's business and belongs with the driver
// lifecycle FSM, not here.
//
// Design: design/ipc/userspace-server-substrate.md §4.4.

module BootSpawn = structure {

  // ==========================================================================
  // Task-slab offsets consumed by the fresh-task trampoline.
  //
  // These are the R15 task_struct offsets, restated here as named constants
  // rather than left as the bare magic numbers sys_fork uses inline. They
  // are read by this module only; sys_fork keeps its own copies (it declares
  // TASK_OFF_FORK_USER_RIP and friends), and the two must agree. If the slab
  // layout ever moves, the cheapest way to find every site is to grep for
  // 1720/1728/1736/2216 -- naming them here at least makes this module's
  // three uses self-describing at the point of use.
  // ==========================================================================

  pub let BSPAWN_OFF_PID          : u64 = 0      // u32
  pub let BSPAWN_OFF_STATE        : u64 = 8      // u32
  pub let BSPAWN_OFF_PML4         : u64 = 16     // u64 (VA form, #658-BOUNDARY)
  pub let BSPAWN_OFF_RS_RSP       : u64 = 32     // regs_save.rsp
  pub let BSPAWN_OFF_RS_RIP       : u64 = 40     // regs_save.rip
  pub let BSPAWN_OFF_RS_RFLAGS    : u64 = 48     // regs_save.rflags
  pub let BSPAWN_OFF_USER_RIP     : u64 = 1720
  pub let BSPAWN_OFF_USER_RSP     : u64 = 1728
  pub let BSPAWN_OFF_USER_RFLAGS  : u64 = 1736
  pub let BSPAWN_OFF_LANDING_RA   : u64 = 2216

  // STATE_RUNNABLE per sched/state.pdx.
  pub let BSPAWN_STATE_RUNNABLE   : u64 = 1

  // regs_save.rflags for a task that has never run.
  //
  // IF=0 is not a default, it is a requirement, and sys_fork.pdx §55-61
  // states why: the continuation's `popfq` and the landing pad's `cli` are
  // separated by one instruction, and an interrupt taken in that window
  // would push a 5-slot iretq frame onto the 24-byte in-slab landing stack
  // and overflow into unrelated slab fields.
  pub let BSPAWN_FRESH_RFLAGS     : u64 = 0x2

  // User RFLAGS the task starts ring-3 execution with: IF=1 (bit 9) plus the
  // architecturally-reserved bit 1. Matches EXECVE_FRESH_RFLAGS in
  // sys_execve_shim.pdx. A spawned server MUST start with interrupts
  // enabled or it can never be preempted and the whole point is lost.
  pub let BSPAWN_USER_RFLAGS      : u64 = 0x202

  // User stack pages, matching sys_execve_shim's EXECVE_USER_STACK_PAGES.
  pub let BSPAWN_USER_STACK_PAGES : u64 = 4

  // ELF64 e_entry lives at header offset 24.
  pub let BSPAWN_EHDR_ENTRY_OFF   : u64 = 24

  // ==========================================================================
  // Frame-budget floor.
  //
  // Checked against phys_alloc_free_count() before task_new. 64 pages is
  // ~5x the measured cost of a small server image and leaves the pool with
  // room for init's own fork/exec traffic afterwards. The number is a floor
  // on the DECISION, not an allocation: nothing is reserved, so a
  // sufficiently adversarial concurrent allocator could still race it. There
  // is no such allocator at R31 -- boot_spawn_user_task runs single-threaded
  // in kernel_main before sti -- and when one appears this check must become
  // a reservation. Recorded rather than assumed.
  // ==========================================================================
  pub let BOOT_SPAWN_MIN_FREE_FRAMES : u64 = 64

  // ==========================================================================
  // Service registry.
  //
  // Fixed 4 rows. Not a general process table -- _pid_table is that -- but a
  // record of which pids this module handed to the scheduler, so the death
  // path can answer "was that a boot-spawned service?" without a heuristic.
  // Generation is recorded alongside pid because a pid alone is ambiguous
  // across recycling: pid 3 dying is only interesting if it is the SAME
  // incarnation of pid 3 this module spawned. That is the identical argument
  // #1583 makes for the driver row's (pid, generation) key, and the same
  // answer.
  // ==========================================================================

  pub let BOOT_SPAWN_MAX : u64 = 4

  pub let mut _boot_spawn_pids  : [u64; 4] = [0; 4]
  pub let mut _boot_spawn_gens  : [u64; 4] = [0; 4]
  pub let mut _boot_spawn_count : u64 = 0

  // Per-row "already reported" latch.
  //
  // A ring-3 fault produces TWO death notifications for the same task, not
  // one: fault_kill calls driver_death_notify itself (fault_kill.pdx §"the
  // authority goes first") and then calls sys_exit_body, whose step 2.6
  // calls it again. That is harmless for the driver row, which is
  // idempotent, but it is fatal to a naive reading of the sweep count: the
  // FIRST sweep revokes and returns a real count, and every subsequent
  // sweep for the same task legitimately matches nothing, because the first
  // one already cleared the column.
  //
  // Without this latch the observer would report a genuine success followed
  // immediately by a spurious failure -- and the spurious failure looks
  // exactly like the real bug #1590 closes, which is the worst possible
  // false positive to leave in a guardrail whose entire job is to
  // distinguish those two cases. So the count is judged once, on the first
  // notification, and repeats return silently.
  pub let mut _boot_spawn_reported : [u64; 4] = [0; 4]

  // Last failure reason from boot_spawn_user_task, for the boot witness's
  // diagnostic KV. Overwritten on every failing call; meaningless after a
  // success.
  pub let mut _boot_spawn_last_error : u64 = 0

  pub let BOOT_SPAWN_ERR_REGISTRY_FULL : u64 = 1
  pub let BOOT_SPAWN_ERR_NO_FRAMES     : u64 = 2
  pub let BOOT_SPAWN_ERR_TASK_NEW      : u64 = 3
  pub let BOOT_SPAWN_ERR_BAD_ENTRY     : u64 = 4
  pub let BOOT_SPAWN_ERR_ELF_LOAD      : u64 = 5
  pub let BOOT_SPAWN_ERR_STACK         : u64 = 6

  // ==========================================================================
  // R31.M2-1599 (#1599): one-shot injection of THE post-claim failure.
  // ==========================================================================
  //
  // #1599 is about what a spawn that fails AFTER claiming capabilities
  // leaves behind. Until this knob existed, the matrix had no failing-spawn
  // case at all, and that is exactly why the missing sweep in task_free
  // went unseen for two milestones.
  //
  // WHY A KNOB AND NOT A BAD IMAGE. The post-claim window is one step wide.
  // Enumerate boot_spawn_user_task's failures against the moment
  // loader_seed_caps stamps cap_owner:
  //
  //   registry_full / no_frames   refuse before task_new — nothing claimed
  //   task_new                    no task — nothing claimed
  //   bad_entry                   step 2, before elf_lite_load — nothing claimed
  //   elf_load                    loader_seed_caps validates EVERY entry,
  //                               including #1596's ownership pre-pass,
  //                               before it mints ANY of them, so a rejected
  //                               sidecar claims nothing either
  //   stack                       THE ONLY ONE. elf_lite_load has returned
  //                               ELF_OK, the sidecar's slots are minted and
  //                               claimed for this task, and user_stack_alloc
  //                               then finds no frames.
  //
  // So no malformed image can reach the state under test; only frame
  // exhaustion can, and arranging genuine exhaustion at exactly this point
  // (past the >= BOOT_SPAWN_MIN_FREE_FRAMES pre-check, short of four stack
  // pages plus their page tables) means perturbing the whole boot's
  // allocator to hit a window a few frames wide. A test that fragile stops
  // being evidence.
  //
  // The knob therefore does the smallest possible thing: when set, the
  // spawn skips user_stack_alloc and takes bspawn_err_stack — the EXISTING
  // production failure path, not a parallel one — so the teardown under
  // test is literally bspawn_fail_free_task, and the state it tears down
  // (caps claimed, stack unmapped) is byte-for-byte what a real
  // user_stack_alloc OOM would have produced.
  //
  // ONE-SHOT BY CONSTRUCTION. boot_spawn_user_task zeroes it on the way
  // past. A knob that stayed armed would turn a witness's forgotten store
  // into every later spawn failing, which is a worse failure than the one
  // being tested. It is .bss-zero at boot and no production path ever
  // writes it.
  pub let mut _boot_spawn_inject_stack_fail : u64 = 0

  // Death-path counters, read by the boot witness and by anything that wants
  // to assert the sweep actually fired. _boot_spawn_deaths counts service
  // deaths observed; _boot_spawn_sweep_total accumulates the matched-slot
  // counts those sweeps returned.
  pub let mut _boot_spawn_deaths      : u64 = 0
  pub let mut _boot_spawn_sweep_total : u64 = 0

  // ==========================================================================
  // Fingerprints.
  //
  // Emitted by boot_spawn_note_death only. The OK line carries the matched
  // count as a decimal KV, and that is the assertion that matters: a sweep
  // which matches ZERO slots for a task that was spawned with seeded
  // capabilities is a failure, not a pass. Asserting the marker without the
  // count would accept exactly the leak #1590 exists to close.
  // ==========================================================================

  // No trailing newline: klog_emit_core appends the KV list and the line
  // terminator itself, so a tag ending in "\n" would push its own count onto
  // a second line and leave the marker assertable without its number. The
  // number is the assertion.
  pub let boot_spawn_sweep_ok_msg   : [u8; 23] = "R31 SPAWN CAP SWEEP OK\0"
  pub let boot_spawn_sweep_fail_msg : [u8; 25] = "R31 SPAWN CAP SWEEP FAIL\0"

  // ==========================================================================
  // boot_spawn_user_task(image_base, image_len) -> task_ptr | 0
  //
  // SysV: rdi = image_base (kernel VA of the raw ELF in .rodata.userbin),
  //       rsi = image_len -> rax = task slab address, or 0 on failure with
  //       _boot_spawn_last_error set.
  //
  // On return the task is RUNNABLE and on the runqueue. It has NOT run.
  //
  // Sequence
  // --------
  //   0. Registry space + frame-budget pre-check. Refuse before allocating.
  //   1. task_new(NULL) -- parent_pid = 0 deliberately. A boot service is
  //      NOT init's child: init's sys_wait4 matches on parent_pid ==
  //      current->pid, so a parent of 0 keeps these tasks entirely outside
  //      init's reap universe. Making them init's children would have init
  //      reaping a daemon out of its own fork/wait sequence, which is a
  //      nondeterminism in init's wire output, not a feature.
  //   2. e_entry from the ELF header (offset 24), non-zero gate.
  //   3. elf_lite_load(pml4, image_base, image_len, task) -- the fourth
  //      argument is #1590's point: the sidecar's capabilities get claimed
  //      for THIS task's (pid, generation).
  //   4. user_stack_alloc(pml4, 4) -- returns the fixed top 0x7FFFFFFFF000.
  //      Safe only because each task has its own PML4; two tasks sharing an
  //      aspace would collide at the same VA.
  //   5. Fresh-task trampoline wiring (see module header).
  //   6. state = RUNNABLE, then runq_enqueue. State BEFORE enqueue, matching
  //      sys_fork phase 4.8: the task becomes reachable through the runqueue
  //      only after it is legal to schedule.
  //   7. Record (pid, generation) in the service registry.
  //
  // Failure teardown: any failure after task_new calls task_free, which runs
  // aspace_teardown, zeroes the slab and releases the pid. A failed spawn
  // therefore leaves no pid consumed and no runqueue entry -- which matters
  // because a leaked pid shifts every subsequent task_new and would be
  // diagnosed as an unrelated regression in init's wire output.
  //
  // R31.M2-1599 (#1599): and, since #1599, task_free also sweeps the
  // capability owner column for the dying (pid, generation). That is not a
  // detail of this function but it is load-bearing FOR it: step 3 claims the
  // image's seeded capabilities for this task, so a failure at step 4 tears
  // down a task that already owns slots. Without the sweep those keys
  // outlived the task and, because pid_gen_bump stamps at allocation rather
  // than at death, still read LIVE -- so #1596's ownership pre-pass refused
  // the NEXT spawn that named the same slots, reporting
  // LOADER_SEED_SLOT_TAKEN against a spawn that had done nothing wrong.
  // _boot_spawn_inject_stack_fail exists to keep that path under test.
  //
  // Register plan: 5-push prologue (rbx/r12/r13/r14/r15) -> rsp %16 == 0 at
  // every nested call site. rbx = task slab, r12 = image_base, r13 =
  // image_len, r14 = e_entry, r15 = user_rsp_top.
  // ==========================================================================

  pub let boot_spawn_user_task : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (image_base: u64) (image_len: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, sched},
      justification: "R31.M2-1590 (#1590): create a schedulable ring-3 task from an embedded ELF at boot -- the loader-side multi-task spawn path that #820/#860/#1015 closed without and that #1086 is blocked on. Refuses before allocating on two pre-checks (service-registry space; phys_alloc_free_count >= BOOT_SPAWN_MIN_FREE_FRAMES) so a spawn that cannot complete never starts and never leaves a half-mapped aspace on the runqueue. Then task_new(NULL) -- parent 0 keeps the task outside init's sys_wait4 matching, which is parent_pid-keyed -- e_entry read from ELF header offset 24 with a non-zero gate, elf_lite_load(pml4, base, len, task) where the fourth argument is the whole point of #1590 (the sidecar's caps are claimed for this task's (pid, generation) via loader_seed_caps -> cap_owner_claim, instead of being stamped CAP_OWNER_NONE which no sweep can match), user_stack_alloc for 4 pages, then the fresh-task trampoline: fork_user_rip/rsp/rflags at +1720/+1728/+1736, regs_save.rip = &sched_switch_r15_continuation at +40, regs_save.rflags = 0x2 (IF=0 -- required, not defaulted: an interrupt between the continuation's popfq and the landing pad's cli would overflow the 24-byte in-slab landing stack), landing RA = &sys_fork_child_landing at +2216, regs_save.rsp = slab+2216. sys_fork_child_landing is reused rather than duplicated because it reads only the four TCB fields above off _current_tcb and zeroes rax/rdx before iretq -- nothing in it is fork-specific, and one audited ring-3 entry path is better than two that must be kept in agreement. Finally state = STATE_RUNNABLE then runq_enqueue (state before enqueue, matching sys_fork phase 4.8), and (pid, generation) recorded in the service registry so the death path can distinguish a service death from any other. Every failure after task_new tears down via task_free (aspace_teardown + slab zero + pid_free), because a leaked pid shifts every subsequent task_new and would surface as an unrelated regression in init's wire output. Register plan: 5-push prologue (rbx/r12/r13/r14/r15) keeps rsp %16 == 0 at all nested call sites; rbx = task slab, r12 = image_base, r13 = image_len, r14 = e_entry, r15 = user_rsp_top. Effects {mem, sysreg} and capabilities {cap, sched}: mem for slab and registry stores, sysreg transitively via elf_lite_load, cap because the delegated loader seed mints and claims capabilities, sched because of runq_enqueue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                      // r12 = image_base
        mov r13, rsi;                      // r13 = image_len
        xor rbx, rbx;                      // rbx = task slab (none yet)

        // ---- Step 0a: service-registry space. ----
        lea rax, [rip + _boot_spawn_count];
        mov rax, [rax];
        mov rcx, 4;                        // BOOT_SPAWN_MAX
        cmp rax, rcx;
        jae bspawn_err_registry_full;

        // ---- Step 0b: frame-budget pre-check. Refuse, do not overlap. ----
        call phys_alloc_free_count;        // rax = free frames
        mov rcx, 64;                       // BOOT_SPAWN_MIN_FREE_FRAMES
        cmp rax, rcx;
        jb bspawn_err_no_frames;

        // ---- Step 1: task_new(NULL). Parent 0 by design (see §Sequence). ----
        xor rdi, rdi;
        call task_new;
        cmp rax, 0;
        je bspawn_err_task_new;
        mov rbx, rax;                      // rbx = task slab

        // ---- Step 2: e_entry (u64 @ ELF header +24), non-zero gate. ----
        mov r14, [r12 + 24];               // r14 = e_entry
        cmp r14, 0;
        je bspawn_err_bad_entry;

        // ---- Step 3: elf_lite_load(pml4, image_base, image_len, task). ----
        // The fourth argument is #1590: without it the sidecar's caps are
        // minted with CAP_OWNER_NONE and the death sweep matches nothing.
        mov rdi, [rbx + 16];               // user_pml4_pa (VA form)
        mov rsi, r12;                      // image_base
        mov rdx, r13;                      // image_len
        mov rcx, rbx;                      // owner_task = this task
        call elf_lite_load;
        cmp rax, 0;                        // ELF_OK
        jne bspawn_err_elf_load;

        // ---- Step 4: user_stack_alloc(pml4, 4). ----
        //
        // R31.M2-1599 (#1599): the one-shot post-claim failure injection,
        // checked HERE because this is the only point in this function at
        // which capabilities are already claimed and a failure is still
        // possible (see §_boot_spawn_inject_stack_fail for the enumeration).
        // Consumed before the branch so a witness that forgets to clear it
        // cannot arm every later spawn.
        lea rcx, [rip + _boot_spawn_inject_stack_fail];
        mov rax, [rcx];
        cmp rax, 0;
        je bspawn_stack_alloc;
        mov [rcx], 0;                      // one-shot: consume the injection
        jmp bspawn_err_stack;              // the REAL failure path, not a copy

      bspawn_stack_alloc:
        mov rdi, [rbx + 16];
        mov rsi, 4;                        // BSPAWN_USER_STACK_PAGES
        call user_stack_alloc;
        cmp rax, 0;
        je bspawn_err_stack;
        mov r15, rax;                      // r15 = user_rsp_top

        // ---- Step 5: fresh-task trampoline wiring. ----
        // (a) the ring-3 state the landing pad will iretq into
        mov [rbx + 1720], r14;             // fork_user_rip = e_entry
        mov [rbx + 1728], r15;             // fork_user_rsp = stack top
        mov rax, 0x202;                    // BSPAWN_USER_RFLAGS (IF=1)
        mov [rbx + 1736], rax;             // fork_user_rflags

        // (b) the kernel-side resume state sched_switch_r15 restores
        lea rax, [rip + sched_switch_r15_continuation];
        mov [rbx + 40], rax;               // regs_save.rip
        mov rax, 0x2;                      // BSPAWN_FRESH_RFLAGS (IF=0)
        mov [rbx + 48], rax;               // regs_save.rflags

        // (c) the landing address the continuation's final `ret` consumes,
        //     placed on the 24-byte in-slab landing stack
        lea rax, [rip + sys_fork_child_landing];
        mov [rbx + 2216], rax;             // landing RA
        mov rax, rbx;
        add rax, 2216;
        mov [rbx + 32], rax;               // regs_save.rsp = slab + 2216

        // ---- Step 6: state RUNNABLE, then enqueue. Order matters. ----
        mov ecx, 1;                        // STATE_RUNNABLE (u32 @ +8)
        mov [rbx + 8], ecx;
        mov rdi, rbx;
        call runq_enqueue;

        // ---- Step 7: record (pid, generation) in the service registry. ----
        xor rdi, rdi;
        mov edi, [rbx + 0];                // pid (u32 zero-ext)
        call pid_gen_read;                 // rax = generation
        // rax may legitimately be any non-zero value; task_new bumped it.
        lea rcx, [rip + _boot_spawn_count];
        mov rcx, [rcx];                    // rcx = index
        lea rdx, [rip + _boot_spawn_gens];
        mov [rdx + rcx*8], rax;
        xor rax, rax;
        mov eax, [rbx + 0];                // pid again
        lea rdx, [rip + _boot_spawn_pids];
        mov [rdx + rcx*8], rax;
        add rcx, 1;
        lea rdx, [rip + _boot_spawn_count];
        mov [rdx], rcx;

        mov rax, rbx;                      // return task slab
        jmp bspawn_epilogue;

        // ---- Failure paths ----
        // Everything after task_new tears the task back down. A leaked pid
        // shifts every subsequent task_new and is diagnosed as an unrelated
        // regression somewhere downstream.
      bspawn_err_registry_full:
        mov rax, 1;
        jmp bspawn_fail_no_task;

      bspawn_err_no_frames:
        mov rax, 2;
        jmp bspawn_fail_no_task;

      bspawn_err_task_new:
        mov rax, 3;
        jmp bspawn_fail_no_task;

      bspawn_err_bad_entry:
        mov rax, 4;
        jmp bspawn_fail_free_task;

      bspawn_err_elf_load:
        mov rax, 5;
        jmp bspawn_fail_free_task;

      bspawn_err_stack:
        mov rax, 6;
        jmp bspawn_fail_free_task;

      bspawn_fail_free_task:
        lea rcx, [rip + _boot_spawn_last_error];
        mov [rcx], rax;
        mov rdi, rbx;
        call task_free;
        xor rax, rax;
        jmp bspawn_epilogue;

      bspawn_fail_no_task:
        lea rcx, [rip + _boot_spawn_last_error];
        mov [rcx], rax;
        xor rax, rax;

      bspawn_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ==========================================================================
  // boot_spawn_is_service(pid, gen) -> row_index + 1, or 0
  //
  // SysV: rdi = pid, rsi = generation -> rax = 1-based row index, or 0 if
  // this (pid, generation) is not a boot-spawned service.
  //
  // Both halves of the key are compared. A pid alone would match a recycled
  // incarnation and attribute a stranger's death to a service that already
  // died -- the same reason #1583 keys the driver row on (pid, generation).
  // ==========================================================================

  pub let boot_spawn_is_service : (u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (gen: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1590 (#1590): linear scan of the 4-row service registry for an exact (pid, generation) match, returning a 1-based index so 0 can mean 'not a service' without a second output. Both halves are compared because a pid alone matches a recycled incarnation, which would attribute a stranger's death to a service that already died -- the same argument #1583 makes for the driver row's key. Leaf, no nested calls, callee-save clean: rax/rcx/rdx/r8/r9 scratch only. Bounded by BOOT_SPAWN_MAX (4) iterations. Effects !{mem} for the two array loads; no capabilities -- the registry is bookkeeping, not authority.",
      block: {
        xor rcx, rcx;                      // rcx = index
      bspawn_is_svc_loop:
        lea rax, [rip + _boot_spawn_count];
        mov rax, [rax];
        cmp rcx, rax;
        jae bspawn_is_svc_none;

        lea rax, [rip + _boot_spawn_pids];
        mov r8, [rax + rcx*8];
        cmp r8, rdi;
        jne bspawn_is_svc_next;

        lea rax, [rip + _boot_spawn_gens];
        mov r9, [rax + rcx*8];
        cmp r9, rsi;
        jne bspawn_is_svc_next;

        mov rax, rcx;
        add rax, 1;                        // 1-based
        ret;

      bspawn_is_svc_next:
        add rcx, 1;
        jmp bspawn_is_svc_loop;

      bspawn_is_svc_none:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // boot_spawn_note_death(pid, gen, sweep_count) -> ()
  //
  // SysV: rdi = pid, rsi = generation, rdx = matched-slot count returned by
  // cap_owner_sweep_revoke. No return value.
  //
  // Called from driver_death_notify immediately after the sweep, for EVERY
  // dying task. Silent unless (pid, gen) is a registered boot-spawned
  // service -- init, shell, child_hello and true all die through the same
  // path and none of them is one.
  //
  // The assertion
  // -------------
  // For a service that was spawned with a non-empty _init_caps sidecar, a
  // sweep that matched ZERO slots is a FAILURE, not a pass. That is the
  // whole shape of the bug #1590 closes: with elf_lite_load's owner
  // hard-coded to 0, every seeded capability was CAP_OWNER_NONE,
  // cap_owner_sweep_revoke returned 0 before reading a single slot, and
  // driver_death_notify discarded the count. The system reported a
  // successful teardown while the dead process's capabilities remained
  // live in the table. So the count is emitted as a decimal KV and the
  // golden asserts its value -- a marker without the number would accept
  // exactly the leak it exists to detect.
  //
  // Register discipline: 3-push prologue (rbx/r12/r13) -> rsp %16 == 0 at
  // both nested call sites. All three arguments are needed after the first
  // call, so all three are parked in callee-save registers.
  // ==========================================================================

  pub let boot_spawn_note_death : (u64, u64, u64) -> () !{mem, sysreg} @{} =
    fn (pid: u64) (gen: u64) (sweep_count: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {},
      justification: "R31.M2-1590 (#1590): the death-side half of #1590's central invariant. Called from driver_death_notify right after cap_owner_sweep_revoke, for every dying task; returns silently unless (pid, generation) matches a row this module put in the service registry, which init/shell/child_hello/true never do. For a registered service it accumulates the counters and emits one klog line carrying the matched-slot count as a decimal KV: OK when the count is non-zero, FAIL when it is zero. Zero is treated as a failure rather than a pass because that is precisely the observable signature of the bug this issue closes -- with elf_lite_load's owner argument hard-coded to 0 every loader-seeded capability was CAP_OWNER_NONE, cap_owner_sweep_revoke returns 0 before reading a single slot when the packed key is 0, and driver_death_notify discards the count, so the teardown reported success while the dead process's capabilities stayed live. Emitting the count rather than a bare marker is the difference between a golden that detects that and one that accepts it. Register discipline: 3-push prologue (rbx = pid, r12 = gen, r13 = sweep_count) keeps rsp %16 == 0 at both nested call sites (boot_spawn_is_service, klog_s1_d1) and preserves all three arguments across the first call. Effects {mem, sysreg}: mem for the counter stores, sysreg transitively via klog. No capabilities -- this observes ownership, it does not exercise it.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                      // pid
        mov r12, rsi;                      // gen
        mov r13, rdx;                      // sweep_count

        mov rdi, rbx;
        mov rsi, r12;
        call boot_spawn_is_service;
        cmp rax, 0;
        je bspawn_note_out;                // not a service: stay silent

        // rax is 1-based; index = rax - 1. Latch the row, and return
        // silently if it was already judged (see §_boot_spawn_reported:
        // a ring-3 fault notifies twice and only the first sweep can
        // have found anything).
        sub rax, 1;
        lea rcx, [rip + _boot_spawn_reported];
        mov rdx, [rcx + rax*8];
        cmp rdx, 0;
        jne bspawn_note_out;
        mov rdx, 1;
        mov [rcx + rax*8], rdx;

        // Accumulate.
        lea rax, [rip + _boot_spawn_deaths];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + _boot_spawn_sweep_total];
        mov rcx, [rax];
        add rcx, r13;
        mov [rax], rcx;

        cmp r13, 0;
        je bspawn_note_zero;

        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + boot_spawn_sweep_ok_msg];
        lea rcx, [rip + k_count];
        mov r8, r13;
        call klog_s1_d1;
        jmp bspawn_note_out;

      bspawn_note_zero:
        // A service died holding no matchable capabilities. Either it was
        // spawned without a sidecar (in which case this line is noise and
        // the registry should not have carried it) or -- the case that
        // matters -- the seed never claimed and the sweep had nothing to
        // find. Both are worth failing on rather than passing over.
        mov rdi, 1;                        // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + boot_spawn_sweep_fail_msg];
        lea rcx, [rip + k_pid];
        mov r8, rbx;
        call klog_s1_d1;

      bspawn_note_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

}
