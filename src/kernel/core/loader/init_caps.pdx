// src/kernel/core/loader/init_caps.pdx — R20b.M4-001 (#1561)
// InitCap sidecar format + validator (init_caps_validate).
//
// Design context
// --------------
// M4 of the R20b userspace-server-substrate cluster: loader hook that
// seeds an image's caps into the target task's cap_table before
// first schedule. Every userspace image that expects seeded caps
// publishes an `_init_caps` array + `_init_caps_count` u16 in its
// .rodata; the loader's post-load hook (M4-002) walks them, colocates
// them into a sidecar blob of the shape §3 of
// design/loader/init-caps-sidecar.md documents, and hands the blob to
// this validator before minting any cap. Failure aborts the image
// load.
//
// This module ships the format + validator only — M4-001. Live minting
// via loader_seed_caps is M4-002.
//
// Record layout (16 bytes per InitCap, natural 8-byte alignment):
//
//   +0    u16 slot            (target slot in the task's cap_table; 0..255)
//   +2    u16 kind            (KIND_* value — matches cap/kind.pdx)
//   +4    u32 rights          (RIGHTS_* mask — matches cap/rights.pdx)
//   +8    u64 target_ptr      (kind-specific; e.g. endpoint tail per kind_endpoint.pdx)
//
// Sidecar blob layout (validator input; §3 of the design doc):
//
//   +0    u16 count             (== _init_caps_count)
//   +2    u8[14] reserved       (padding — first entry aligned to 16)
//   +16   InitCap[count]
//
// Naming style follows elf_lite.pdx (loader/elf_lite.pdx): flat
// snake_case for constants, `init_caps_*` labels for local branches.
//
// Fixture posture
// ---------------
// M4-001 delivers the format + validator only. The boot witness in
// kernel_main.pdx synthesizes a 2-entry sidecar blob in kernel .bss
// and drives init_caps_validate through the accept + reject paths —
// same "structural witness before the real caller lands" posture as
// KindEndpoint.endpoint_cap_mint (M1-001) and FrameHdr.frame_encode /
// frame_decode (M2-001).

module InitCaps = structure {

  // ============================================================================
  // Format constants
  // ============================================================================

  // Size of one InitCap record on the wire (16 bytes).
  pub let INIT_CAP_ENTRY_SIZE : u64 = 16

  // Size of the sidecar's leading count + padding block (bytes 0..15). The
  // first InitCap begins at offset INIT_CAPS_HEADER_SIZE.
  pub let INIT_CAPS_HEADER_SIZE : u64 = 16

  // Maximum accepted slot value (exclusive) — matches cap_table's 256-slot
  // capacity (cap/table.pdx §Table). An entry with slot >= this bound
  // cannot possibly address a valid cap descriptor.
  pub let INIT_CAP_SLOT_MAX : u64 = 256

  // R31.M2-1597 (#1597): THESE TWO CONSTANTS NO LONGER DEFINE ANYTHING.
  //
  // They are retained because other modules reference the names, but the
  // accept set they used to be half of now lives in ONE place --
  // KIND_SEEDABLE_TABLE in cap/kind.pdx -- and init_caps_validate reaches
  // it through kind_is_loader_seedable rather than comparing against
  // literals here.
  //
  // The comment that used to sit here asked whoever added the next derived
  // kind to "gain an explicit accept branch in init_caps_validate below (or
  // the accept-set encoded here in a table-driven follow-up)". That request
  // went unhonoured through the addition of KIND_ACPI, KIND_PCI_DEV and the
  // whole R29/R30 derived family. An instruction to remember is not a
  // mechanism; the table-driven follow-up it anticipated is what #1597 is.
  pub let INIT_CAP_KIND_DRIVER : u64 = 0x15   // KIND_DRIVER  (derived; base KIND_DEVICE)
  pub let INIT_CAP_KIND_DMESG  : u64 = 0x16   // KIND_DMESG   (derived; base KIND_RESERVED)

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success — every entry in the sidecar has a valid slot + kind.
  pub let INIT_CAPS_OK          : u64 = 0

  // Malformed count. Either the sidecar is < 16 bytes (header truncated)
  // or 16 + count*16 > image_len (array overflows the blob).
  pub let INIT_CAPS_BAD_COUNT   : u64 = 0xFFFFFFFF

  // Out-of-range slot: some entry's slot >= INIT_CAP_SLOT_MAX (256).
  pub let INIT_CAPS_BAD_SLOT    : u64 = 0xFFFFFFFE

  // Un-seedable kind: some entry's kind is not in KIND_SEEDABLE_TABLE
  // (cap/kind.pdx). Covers both a kind that does not exist and a kind that
  // exists but may not be handed to an image at load time -- the two are
  // deliberately not distinguished, because telling an untrusted image
  // WHICH of the two it hit is free reconnaissance for no operator benefit.
  pub let INIT_CAPS_BAD_KIND    : u64 = 0xFFFFFFFD

  // ============================================================================
  // init_caps_validate(image_base, image_len) -> rc
  //
  // Signature: init_caps_validate : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): image_base — VA of the sidecar blob's first byte.
  // RSI (input): image_len  — total blob length in bytes.
  // RAX (output): INIT_CAPS_OK (0) on success, else one of the INIT_CAPS_BAD_* codes.
  //
  // Fail-fast: on the first malformed entry, the validator returns the
  // matching error code without inspecting subsequent entries. M4-002
  // aborts the whole image load on any non-zero rc so a partial-seed
  // race cannot leave a task holding a mix of valid + invalid caps.
  //
  // Reads untrusted image bytes → unsafe.
  //
  // Register plan (callee-save via 4-push prologue):
  //   r12 = image_base
  //   r13 = image_len
  //   r14 = count (loaded from [image_base + 0], masked to u16)
  //   r15 = loop index i (0..count)
  //   rax = entry_pa scratch / return value
  //   rcx, r10 = scratch masks/fields
  // ============================================================================
  pub let init_caps_validate : (u64, u64) -> u64 !{mem} @{} =
    fn (image_base: u64) (image_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R20b.M4-001 (#1561): validate an InitCap sidecar blob. Reads count (u16) from [image_base+0]; gates 16 + count*16 <= image_len; iterates count entries at image_base + 16 + i*16 and validates slot < 256 and kind in KIND_SEEDABLE_TABLE via kind_is_loader_seedable (cap/kind.pdx) -- R31.M2-1597 (#1597) replaced an open-coded {0..15, 0x15, 0x16} comparison chain with that call, both widening the set to the kinds two shipped images actually declare (KIND_ACPI 0x20, KIND_PCI_DEV 0x30) and narrowing it off the kernel-object base kinds whose target_ptr is an unvalidated kernel pointer supplied by untrusted image bytes; the prologue grew a fifth push (rbx) purely to keep rsp %16 == 0 at that call. Returns 0 on success or a distinct error code per failure mode. Reads untrusted image memory (the sidecar comes from the userspace image) — thus unsafe. Register plan: r12=image_base, r13=image_len, r14=count, r15=loop index. Follows the elf_lite_parse (loader/elf_lite.pdx) style: callee-save prologue (five pushes since #1597 -- rbx/r12/r13/r14/r15), single epilogue label. Design: design/loader/init-caps-sidecar.md §4.",
      block: {
        // R31.M2-1597 (#1597): FIVE pushes, not four. Sub-check B now calls
        // kind_is_loader_seedable, and this tree's convention (stated in
        // loader_seed_caps' own register plan) is rsp %16 == 0 at a nested
        // call site. Return address 8 + four pushes 32 = 40 leaves rsp %16
        // == 8; rbx is the fifth, taking it to 48 == 0 mod 16. rbx is not
        // otherwise used here -- it is pushed for alignment and for nothing
        // else, which is worth stating so a later reader does not delete it
        // as dead.
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;              // r12 = image_base
        mov r13, rsi;              // r13 = image_len

        // Step 1: header bounds gate — image_len >= 16 (room for count+pad).
        cmp r13, 16;
        jl init_caps_bad_count;

        // Step 2: load count (u16 at [image_base+0]) via qword-read + mask.
        //         Same idiom as elf_lite_parse's e_phnum read.
        mov rax, [r12 + 0];
        mov rcx, 0xFFFF;
        and rax, rcx;
        mov r14, rax;              // r14 = count

        // Step 3: array bounds gate — 16 + count*16 <= image_len.
        //         count*16 = count << 4 (INIT_CAP_ENTRY_SIZE = 16 = 2^4).
        mov rcx, r14;
        shl rcx, 4;                // rcx = count * 16
        add rcx, 16;               // rcx = 16 + count*16
        cmp rcx, r13;
        jg init_caps_bad_count;

        // Step 4: iterate entries.
        xor r15, r15;              // r15 = i = 0

        init_caps_loop:
          cmp r15, r14;
          jge init_caps_ok;

          // entry_pa = image_base + 16 + i*16
          mov rax, r15;
          shl rax, 4;              // rax = i * 16
          add rax, 16;             // + header
          add rax, r12;            // + image_base

          // Sub-check A: slot (u16 at [entry_pa+0]) < INIT_CAP_SLOT_MAX.
          mov rcx, [rax + 0];
          mov r10, 0xFFFF;
          and rcx, r10;
          cmp rcx, 256;            // INIT_CAP_SLOT_MAX
          jge init_caps_bad_slot;

          // Sub-check B: kind (u16 at [entry_pa+2]) must be LOADER-SEEDABLE.
          //
          // R31.M2-1597 (#1597): this used to be an open-coded chain --
          //   `cmp rcx,15 / jle ok ; cmp rcx,0x15 / je ok ; cmp rcx,0x16 / je ok`
          // -- i.e. the closed 4-bit base enum plus two ad-hoc extensions,
          // with a comment asking whoever added the next derived kind to
          // remember to come back here. Nobody did, for rounds, while two
          // shipped userspace images declared sidecar entries naming
          // KIND_ACPI (0x20) and KIND_PCI_DEV (0x30) and consequently could
          // not be loaded at all.
          //
          // The set now has exactly one definition, and it is not here: it
          // is KIND_SEEDABLE_TABLE in cap/kind.pdx, next to the kinds it
          // names, with a stated reason per entry and a build-time check
          // that every entry is a declared kind. A restatement in this file
          // is what drifted; a call cannot.
          //
          // Note this is a NARROWING as well as a widening. `kind <= 15`
          // admitted the kernel-object kinds -- KIND_PROCESS, KIND_THREAD,
          // KIND_PAGE_TABLE, KIND_PAGE, KIND_SCHED_CTX -- whose target_ptr
          // is a kernel pointer that nothing in this validator or in
          // loader_seed_caps checks, supplied by untrusted image bytes.
          // Those are refused now. See cap/kind.pdx §THE LOADER-SEEDABLE SET.
          //
          // Reads 8 bytes starting at offset +2 (unaligned qword straddles
          // slot's high byte + kind + rights_low). Mask leaves only the
          // low 16 bits (kind). Safe because the array-bounds gate above
          // guarantees the full entry (through +15) is in-bounds.
          mov rcx, [rax + 2];
          mov r10, 0xFFFF;
          and rcx, r10;

          // kind_is_loader_seedable(rdi=kind) -> rax in {0,1}. Leaf, and it
          // touches only rax/r10/r11, so r12-r15 (image_base / image_len /
          // count / index) survive the call untouched.
          mov rdi, rcx;
          call kind_is_loader_seedable;
          cmp rax, 0;
          je init_caps_bad_kind;

          init_caps_kind_ok:
          add r15, 1;
          jmp init_caps_loop;

        init_caps_ok:
          xor rax, rax;            // INIT_CAPS_OK
          jmp init_caps_epilogue;

        init_caps_bad_count:
          mov rax, 0xFFFFFFFF;     // INIT_CAPS_BAD_COUNT
          jmp init_caps_epilogue;

        init_caps_bad_slot:
          mov rax, 0xFFFFFFFE;     // INIT_CAPS_BAD_SLOT
          jmp init_caps_epilogue;

        init_caps_bad_kind:
          mov rax, 0xFFFFFFFD;     // INIT_CAPS_BAD_KIND
          jmp init_caps_epilogue;

        init_caps_epilogue:
          pop r15;
          pop r14;
          pop r13;
          pop r12;
          pop rbx;
          ret
      }
    }

}
