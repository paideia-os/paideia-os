// src/kernel/core/loader/seed_caps.pdx — R20b.M4-002 (#1562)
// loader_seed_caps hook — walks a validated InitCap sidecar and mints
// each entry into the target task's cap_table before first schedule.
//
// Design context
// --------------
// M4-002 closes the R20b.M4 loader-capability-seed branch. M4-001
// (#1561) shipped the on-wire InitCap record format
// (src/kernel/core/loader/init_caps.pdx) + the fail-fast
// init_caps_validate primitive. This module is the caller that binds
// the two together: given a colocated sidecar blob, validate it, then
// iterate its entries and mint each cap via the existing
// cap_mint_write primitive (src/kernel/core/cap/mint.pdx).
//
// Placement in elf_lite_load
// --------------------------
// elf_lite_load (src/kernel/core/loader/elf_lite.pdx) grows a call
// into loader_seed_caps at the elf_load_done point — AFTER every
// aspace_map has committed the image's PT_LOAD segments to the target
// user_pml4 and BEFORE elf_lite_load returns ELF_OK to its caller
// (sys_execve's step 3.5, sys_execve.pdx). If loader_seed_caps
// returns any non-zero rc, elf_lite_load propagates it as
// ELF_CAP_SEED_FAILED (0xFFFFFFF9) — the caller then treats the
// image load as a failure and never runq_enqueue's the task, so a
// task can never observe a partially-seeded cap_table (per §6.3 of
// design/loader/init-caps-sidecar.md's fail-fast invariant).
//
// Sidecar shape (input contract — same as init_caps_validate's)
// -------------------------------------------------------------
//   +0    u16 count             (0..N; enforced by init_caps_validate)
//   +2    u8[14] reserved       (padding — first entry aligned to 16)
//   +16   InitCap[count]:
//           +0  u16 slot        (target slot in the cap_table; 0..255)
//           +2  u16 kind        (KIND_* value; matches cap/kind.pdx)
//           +4  u32 rights      (RIGHTS_* mask; matches cap/rights.pdx)
//           +8  u64 target_ptr  (kind-specific)
//
// Per-task cap_table caveat (R20b posture)
// ----------------------------------------
// R20b runs a single global cap_table (cap/table.pdx — [u64; 768]
// backing 256 x 24 B descriptors) shared across tasks. The task_ptr
// argument is therefore unused at R20b; it is threaded through the
// signature so R21+ per-task cap_tables (design/capabilities/
// per-task-cspace.md) drop straight in with the existing loader
// wire-in. cap_mint_write writes to the fixed cap_table symbol; when
// per-task cap_tables land, cap_mint_write grows a task_ptr arg and
// this function forwards it verbatim.
//
// Phase-1 sidecar placement inside ELF (deferred)
// -----------------------------------------------
// design/loader/init-caps-sidecar.md §5 phase-1 sketches loader-side
// symbol-table walking (`_init_caps` + `_init_caps_count`) to build
// the sidecar scratch buffer inside elf_lite_load. That walker is a
// separate, future sub-issue — it is NOT part of M4-002. For M4-002
// the elf_lite_load call site passes a static empty-sidecar scratch
// (count = 0) so the hook is exercised at every real image load
// without minting anything. The boot witness in kernel_main.pdx
// (init_caps_witness_done → loader_seed_witness) synthesizes a
// non-empty sidecar directly and drives the actual mint path.
//
// Naming style follows loader/init_caps.pdx and loader/elf_lite.pdx:
// flat snake_case for constants, `loader_seed_*` labels for local
// branches, module name matches the file basename.

module SeedCaps = structure {

  // ============================================================================
  // Empty-sidecar scratch (elf_lite_load wire-in — phase-1)
  // ============================================================================
  //
  // 16-byte zero-initialized blob = a sidecar with count = 0 and 14
  // bytes of reserved padding. init_caps_validate on a count=0 blob
  // takes the header-bounds gate (image_len >= 16 → OK), the array-
  // bounds gate (16 + 0*16 == 16 <= 16 → OK), and returns
  // INIT_CAPS_OK without touching a single entry. loader_seed_caps
  // therefore returns LOADER_SEED_OK immediately.
  //
  // This buffer is passed by elf_lite_load's post-aspace_map wire-in
  // (elf_lite.pdx §elf_load_seed_hook) so every image load exercises
  // the hook without minting anything — phase-2 (a future sub-issue)
  // replaces this with a per-load scratch that elf_lite_load
  // populates from the image's `_init_caps` / `_init_caps_count`
  // symbols via a second symbol-table pass (see
  // design/loader/init-caps-sidecar.md §5). Marked `mut` because
  // paideia-as's immutable `let` cannot yet accept a bare `[0; 2]`
  // initialiser at rodata scope (matches the runqueue.pdx §runqueue
  // idiom — `pub let mut runqueue : [u64; 2] = [0; 2]`); nothing
  // writes to it after boot.
  pub let mut _loader_seed_empty_sidecar : [u64; 2] = [0; 2]

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success — every entry in the sidecar was validated and minted.
  pub let LOADER_SEED_OK          : u64 = 0

  // Aggregate failure sentinel. Any non-zero rc from init_caps_validate
  // maps to this single code — the specific INIT_CAPS_BAD_* subcode is
  // not preserved here because elf_lite_load only distinguishes
  // "image load succeeded" vs. "image load failed"; the per-entry
  // failure mode is diagnosable via a separate klog line if needed in
  // the future. Value matches ELF_CAP_SEED_FAILED (0xFFFFFFF9) in
  // loader/elf_lite.pdx §Error codes — a single wire-level constant
  // for the elf_lite_load caller taxonomy.
  pub let LOADER_SEED_FAILED      : u64 = 0xFFFFFFF9

  // ============================================================================
  // loader_seed_caps(task_ptr, sidecar_base, sidecar_len) -> rc
  //
  // Signature: loader_seed_caps : (u64, u64, u64) -> u64 !{mem} @{cap}
  // RDI (input): task_ptr    — reserved for R21+ per-task cap_tables (unused at R20b).
  // RSI (input): sidecar_base — VA of a colocated sidecar blob (see §format).
  // RDX (input): sidecar_len  — total blob length in bytes.
  // RAX (output): LOADER_SEED_OK (0) on success, LOADER_SEED_FAILED
  //               (0xFFFFFFF9) if init_caps_validate rejects the blob.
  //
  // Semantics
  // ---------
  //   1. Call init_caps_validate(sidecar_base, sidecar_len). If non-OK
  //      → return LOADER_SEED_FAILED immediately. No mint occurs; the
  //      caller's task_ptr cap_table is unmutated.
  //   2. Load count (u16 at [sidecar_base + 0]).
  //   3. For i in 0..count:
  //        entry_pa = sidecar_base + 16 + i * 16
  //        slot     = u16 at [entry_pa + 0]
  //        kind     = u16 at [entry_pa + 2]
  //        rights   = u32 at [entry_pa + 4]
  //        target_ptr = u64 at [entry_pa + 8]
  //        cap_mint_write(slot, kind, rights, target_ptr)
  //   4. Return LOADER_SEED_OK.
  //
  // Reads untrusted image bytes (sidecar comes from the userspace
  // image) + writes the global cap_table via cap_mint_write. Both are
  // unsafe effects — !{mem}, @{cap}.
  //
  // Register plan (callee-save via 5-push prologue, matches
  // sys_svc_lookup.pdx's 5-push idiom for nested-call alignment):
  //   rbx = sidecar_base (survives cap_mint_write's caller-save clobbers)
  //   r12 = count (loaded from [sidecar_base + 0])
  //   r13 = loop index i (0..count)
  //   r14 = task_ptr (reserved — R20b unused; kept live for future forward)
  //   r15 = scratch (entry_pa)
  //   rax, rcx, rdx, rsi, rdi = SysV scratch for reads + cap_mint_write ABI
  //
  // The 5-push prologue (rbx/r12/r13/r14/r15) aligns rsp % 16 == 0
  // across the init_caps_validate + cap_mint_write nested calls (return
  // addr = 8 B, 5 * 8 = 40 B, total 48 B = 16 mod 0), matching the
  // discipline in sys_svc_lookup_body's justification.
  // ============================================================================
  pub let loader_seed_caps : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (task_ptr: u64) (sidecar_base: u64) (sidecar_len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R20b.M4-002 (#1562): walk a colocated InitCap sidecar blob, validate it via init_caps_validate, then mint each entry into the (single global at R20b) cap_table via cap_mint_write. task_ptr threaded through for R21+ per-task cap_tables (design/capabilities/per-task-cspace.md); unused at R20b since cap_mint_write writes to the fixed cap_table symbol. Called by elf_lite_load at elf_load_done (post-aspace_map, pre-return) and by the boot witness in kernel_main.pdx (loader_seed_witness). Fail-fast: validator rc != 0 -> return LOADER_SEED_FAILED (0xFFFFFFF9) immediately without minting anything. On success, iterates count entries at sidecar_base + 16 + i*16, extracts slot (u16 @ +0), kind (u16 @ +2), rights (u32 @ +4), target_ptr (u64 @ +8), and calls cap_mint_write(rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr) — same ABI as cap/mint.pdx L97-115. Register plan: 5-push prologue (rbx/r12/r13/r14/r15) aligns rsp % 16 == 0 across nested calls (init_caps_validate + cap_mint_write) AND preserves the sidecar_base (rbx), count (r12), loop index (r13), task_ptr (r14) across both call sites — same idiom as sys_svc_lookup.pdx's 5-push register plan. Reads use qword loads + u16/u32 masks (same idiom as init_caps_validate's kind/slot reads at L157/L174). Writes the global cap_table via cap_mint_write — !{mem} + @{cap}. Sidecar bytes are untrusted -> unsafe.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;              // rbx = sidecar_base
        mov r14, rdi;              // r14 = task_ptr (reserved; unused at R20b)

        // Step 1: validate first — fail-fast on any structural error.
        // init_caps_validate ABI: rdi=image_base, rsi=image_len -> rax=rc.
        mov rdi, rbx;              // rdi = sidecar_base
        mov rsi, rdx;              // rsi = sidecar_len
        call init_caps_validate;
        cmp rax, 0;
        jne loader_seed_fail;

        // Step 2: load count (u16 at [sidecar_base + 0]) via qword-read + mask.
        //         Same idiom as init_caps_validate L130-133.
        mov rax, [rbx + 0];
        mov rcx, 0xFFFF;
        and rax, rcx;
        mov r12, rax;              // r12 = count

        // Step 3: iterate count entries.
        xor r13, r13;              // r13 = i = 0

        loader_seed_loop:
          cmp r13, r12;
          jge loader_seed_ok;

          // entry_pa = sidecar_base + 16 + i * 16
          //         = rbx + 16 + (r13 << 4)
          mov r15, r13;
          shl r15, 4;              // r15 = i * 16
          add r15, 16;             // + header
          add r15, rbx;            // + sidecar_base

          // Extract slot (u16 @ +0). Read as qword, mask low 16.
          mov rax, [r15 + 0];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov rdi, rax;            // rdi = slot (arg 0 of cap_mint_write)

          // Extract kind (u16 @ +2). Read qword @ +2; low 16 = kind.
          //   The array-bounds gate inside init_caps_validate guarantees
          //   the full entry (through +15) is in-bounds, so the +2
          //   qword read is safe (straddles slot's high byte + kind +
          //   rights_low).
          mov rax, [r15 + 2];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov rsi, rax;            // rsi = kind (arg 1)

          // Extract rights (u32 @ +4). Read qword @ +4; low 32 = rights.
          mov rax, [r15 + 4];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          mov rdx, rax;            // rdx = rights (arg 2)

          // Extract target_ptr (u64 @ +8). Naturally aligned.
          mov rcx, [r15 + 8];      // rcx = target_ptr (arg 3)

          // cap_mint_write(rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr).
          // Writes the 24-byte descriptor at cap_table + slot*24. Void return.
          call cap_mint_write;

          add r13, 1;
          jmp loader_seed_loop;

        loader_seed_ok:
          xor rax, rax;            // LOADER_SEED_OK
          jmp loader_seed_epilogue;

        loader_seed_fail:
          mov rax, 0xFFFFFFF9;     // LOADER_SEED_FAILED
          jmp loader_seed_epilogue;

        loader_seed_epilogue:
          pop r15;
          pop r14;
          pop r13;
          pop r12;
          pop rbx;
          ret
      }
    } @no_frame

}
