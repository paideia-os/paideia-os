// src/kernel/core/loader/seed_caps.pdx — R20b.M4-002 (#1562) + R20b.M6-001 (#1564)
// loader_seed_caps hook — walks a validated InitCap sidecar and mints
// each entry into the target task's cap_table before first schedule.
// loader_seed_caps_from_symtab (M6-001) — phase-2 driver that resolves
// the sidecar location from the image's own ELF symbol table
// (`_init_caps` + `_init_caps_count`), colocates them into the sidecar
// scratch buffer that loader_seed_caps consumes, then hands off.
//
// Design context
// --------------
// M4-002 closes the R20b.M4 loader-capability-seed branch. M4-001
// (#1561) shipped the on-wire InitCap record format
// (src/kernel/core/loader/init_caps.pdx) + the fail-fast
// init_caps_validate primitive. This module is the caller that binds
// the two together: given a colocated sidecar blob, validate it, then
// iterate its entries and mint each cap via the existing
// cap_mint_write primitive (src/kernel/core/cap/mint.pdx).
//
// M6-001 (#1564) retires the M4-002 empty-sidecar wire-in in
// elf_lite_load. The new loader_seed_caps_from_symtab primitive walks
// the raw ELF image's SHT_SYMTAB (kernel-visible via image_base — NOT
// mapped into the target user_pml4, since elf_lite_load only maps
// PT_LOAD segments), finds `_init_caps` + `_init_caps_count` by name,
// resolves each symbol's file offset via the section header table,
// and colocates their bytes into the sidecar shape §3 of the design
// doc requires (count u16 at +0, 14 bytes padding, entries at +16).
// Missing either symbol -> no-mint, no-error (empty-caps case).
// Structural corruption AFTER symbol resolution -> LOADER_SEED_FAILED
// -> elf_lite_load propagates as ELF_CAP_SEED_FAILED. See §Symbol
// walker semantics below for the full accept/reject taxonomy.
//
// Placement in elf_lite_load
// --------------------------
// elf_lite_load (src/kernel/core/loader/elf_lite.pdx) grows a call
// into loader_seed_caps at the elf_load_done point — AFTER every
// aspace_map has committed the image's PT_LOAD segments to the target
// user_pml4 and BEFORE elf_lite_load returns ELF_OK to its caller
// (sys_execve's step 3.5, sys_execve.pdx). If loader_seed_caps
// returns any non-zero rc, elf_lite_load propagates it as
// ELF_CAP_SEED_FAILED (0xFFFFFFF9) — the caller then treats the
// image load as a failure and never runq_enqueue's the task, so a
// task can never observe a partially-seeded cap_table (per §6.3 of
// design/loader/init-caps-sidecar.md's fail-fast invariant).
//
// Sidecar shape (input contract — same as init_caps_validate's)
// -------------------------------------------------------------
//   +0    u16 count             (0..N; enforced by init_caps_validate)
//   +2    u8[14] reserved       (padding — first entry aligned to 16)
//   +16   InitCap[count]:
//           +0  u16 slot        (target slot in the cap_table; 0..255)
//           +2  u16 kind        (KIND_* value; matches cap/kind.pdx)
//           +4  u32 rights      (RIGHTS_* mask; matches cap/rights.pdx)
//           +8  u64 target_ptr  (kind-specific)
//
// Per-task cap_table caveat (R20b posture)
// ----------------------------------------
// R20b runs a single global cap_table (cap/table.pdx — [u64; 768]
// backing 256 x 24 B descriptors) shared across tasks. The task_ptr
// argument is therefore unused at R20b; it is threaded through the
// signature so R21+ per-task cap_tables (design/capabilities/
// per-task-cspace.md) drop straight in with the existing loader
// wire-in. cap_mint_write writes to the fixed cap_table symbol; when
// per-task cap_tables land, cap_mint_write grows a task_ptr arg and
// this function forwards it verbatim.
//
// Phase-1 sidecar placement inside ELF (deferred)
// -----------------------------------------------
// design/loader/init-caps-sidecar.md §5 phase-1 sketches loader-side
// symbol-table walking (`_init_caps` + `_init_caps_count`) to build
// the sidecar scratch buffer inside elf_lite_load. That walker is a
// separate, future sub-issue — it is NOT part of M4-002. For M4-002
// the elf_lite_load call site passes a static empty-sidecar scratch
// (count = 0) so the hook is exercised at every real image load
// without minting anything. The boot witness in kernel_main.pdx
// (init_caps_witness_done → loader_seed_witness) synthesizes a
// non-empty sidecar directly and drives the actual mint path.
//
// Naming style follows loader/init_caps.pdx and loader/elf_lite.pdx:
// flat snake_case for constants, `loader_seed_*` labels for local
// branches, module name matches the file basename.

module SeedCaps = structure {

  // ============================================================================
  // Empty-sidecar scratch (elf_lite_load wire-in — phase-1)
  // ============================================================================
  //
  // 16-byte zero-initialized blob = a sidecar with count = 0 and 14
  // bytes of reserved padding. init_caps_validate on a count=0 blob
  // takes the header-bounds gate (image_len >= 16 → OK), the array-
  // bounds gate (16 + 0*16 == 16 <= 16 → OK), and returns
  // INIT_CAPS_OK without touching a single entry. loader_seed_caps
  // therefore returns LOADER_SEED_OK immediately.
  //
  // This buffer is passed by elf_lite_load's post-aspace_map wire-in
  // (elf_lite.pdx §elf_load_seed_hook) so every image load exercises
  // the hook without minting anything — phase-2 (a future sub-issue)
  // replaces this with a per-load scratch that elf_lite_load
  // populates from the image's `_init_caps` / `_init_caps_count`
  // symbols via a second symbol-table pass (see
  // design/loader/init-caps-sidecar.md §5). Marked `mut` because
  // paideia-as's immutable `let` cannot yet accept a bare `[0; 2]`
  // initialiser at rodata scope (matches the runqueue.pdx §runqueue
  // idiom — `pub let mut runqueue : [u64; 2] = [0; 2]`); nothing
  // writes to it after boot.
  pub let mut _loader_seed_empty_sidecar : [u64; 2] = [0; 2]

  // ============================================================================
  // Symtab-walker scratch + target-name literals (R20b.M6-001 #1564)
  // ============================================================================
  //
  // _loader_symtab_sidecar_scratch: 4112-byte kernel .bss buffer that
  //   loader_seed_caps_from_symtab colocates the on-image _init_caps
  //   sidecar into before handing off to loader_seed_caps. Sized as
  //   [u64; 514] = 4112 bytes = 16 (header per §3 of
  //   design/loader/init-caps-sidecar.md) + INIT_CAP_SLOT_MAX (256, from
  //   init_caps.pdx) * INIT_CAP_ENTRY_SIZE (16). Sized to the design
  //   maximum so any well-formed sidecar the validator would accept
  //   fits. Single-writer (elf_lite_load is called single-threaded at
  //   R20b — the boot-time init.elf load AND the M6-001 witness's
  //   echo_server.elf load run sequentially in kernel_main). Once R21+
  //   grows a spawn syscall that can invoke elf_lite_load concurrently
  //   the scratch must move to per-CPU or be gated by a spinlock; noted
  //   in §14 of userspace-server-substrate.md as a post-R20b concern.
  //
  //   Marked `let mut` (not immutable `let`) because paideia-as's
  //   `pub let` cannot accept `uninit @align(8)` at rodata scope — same
  //   idiom as _loader_seed_empty_sidecar above and the runqueue.pdx
  //   §runqueue mutable-let convention.
  pub let mut _loader_symtab_sidecar_scratch : [u64; 514] = uninit @align(8)

  // Fixed target-name literals for the symtab walker's byte compare.
  //
  // _init_caps_str: 11 bytes = "_init_caps" (10 chars) + NUL. The walker
  //   matches the first 10 bytes of a candidate symbol name against
  //   this prefix, then reads byte 10 of the candidate to disambiguate:
  //     byte 10 == 0    -> full match: `_init_caps` (entries symbol).
  //     byte 10 == '_'  -> potential `_init_caps_count`; check suffix.
  //     else            -> no match.
  //
  // _init_caps_count_suffix_str: 6 bytes = "count" (5 chars) + NUL.
  //   Compared against bytes 11..17 of a candidate that already matched
  //   the "_init_caps_" prefix (bytes 0..10 == "_init_caps" AND byte 10
  //   == '_'). Bytes: c(0x63) o(0x6F) u(0x75) n(0x6E) t(0x74) NUL(0x00).
  //   Split from _init_caps_str so both target names share the common
  //   10-byte prefix and the walker only reads it once per symbol.
  pub let _init_caps_str : [u8; 11] = "_init_caps\0"
  pub let _init_caps_count_suffix_str : [u8; 6] = "count\0"

  // ============================================================================
  // Symbol walker semantics (loader_seed_caps_from_symtab, R20b.M6-001)
  // ============================================================================
  //
  // Input contract: image_base points at the raw ELF64 image bytes as
  // laid out in the kernel's .rodata.userbin section (identity-mapped,
  // kernel-VA readable). image_len is the byte length of the ELF.
  // elf_lite_load only maps PT_LOAD segments into the target's
  // user_pml4; the section header table + .symtab + .strtab are NOT
  // loaded into that aspace but ARE present in the raw image_base
  // buffer, so the walker reads them there without any user-VA walk.
  //
  // The walker follows this taxonomy:
  //
  //   Structural malformation in ELF header or section table
  //     (image_len < 64, bad e_shentsize, bad e_shnum bounds, no
  //     SHT_SYMTAB, bad symtab sh_entsize, bad sh_link) -> LOADER_SEED_OK
  //     with no mint. Rationale: images without _init_caps are legal
  //     (init.elf, child_hello.elf, true.elf, shell.elf all fall in
  //     this bucket at R20b — they don't declare a sidecar); a missing
  //     symtab is structurally equivalent to "no sidecar symbols".
  //     Errors in this bucket must NOT abort elf_lite_load or init.elf
  //     regresses.
  //
  //   Symbol resolution
  //     For each symbol in .symtab: read st_name (u32 offset into
  //     .strtab), then match the name bytes against _init_caps_str
  //     (10-byte prefix + byte-10 discriminator). Two symbols are
  //     tracked: one whose name is exactly "_init_caps" (entries) and
  //     one whose name is exactly "_init_caps_count" (count). Missing
  //     EITHER -> LOADER_SEED_OK with no mint (the sidecar can't be
  //     constructed without both).
  //
  //   Post-resolution structural failure
  //     Symbol's st_shndx out of range, or the resolved file offset
  //     lies past image_len, or count > INIT_CAP_SLOT_MAX -> hard
  //     failure LOADER_SEED_FAILED. These indicate an image that
  //     declared _init_caps but with corrupt data — the fail-fast
  //     invariant (design §4) means we must abort the load.
  //
  //   Colocation
  //     Read count (u16 via qword-mask, matches init_caps_validate's
  //     idiom) from image_base + count_file_offset. Emit into the
  //     scratch as sidecar shape (§3):
  //         scratch[0..8]  = count in low 16 bits + zeros
  //         scratch[8..16] = zeros (padding pad2)
  //         scratch[16..16+count*16] = memcpy from image_base +
  //                                    entries_file_offset (rep_movsb).
  //     Then call loader_seed_caps(task_ptr, scratch, 16 + count*16).
  //     Its return value passes through verbatim — the validator's own
  //     accept/reject taxonomy still fires (INIT_CAPS_BAD_SLOT / KIND
  //     for entries the walker never inspects per-field). This layered
  //     failure model keeps the walker responsible only for structure
  //     and defers semantic validation to init_caps_validate.
  //
  // ============================================================================

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success — every entry in the sidecar was validated and minted.
  pub let LOADER_SEED_OK          : u64 = 0

  // Aggregate failure sentinel. Any non-zero rc from init_caps_validate
  // maps to this single code — the specific INIT_CAPS_BAD_* subcode is
  // not preserved here because elf_lite_load only distinguishes
  // "image load succeeded" vs. "image load failed"; the per-entry
  // failure mode is diagnosable via a separate klog line if needed in
  // the future. Value matches ELF_CAP_SEED_FAILED (0xFFFFFFF9) in
  // loader/elf_lite.pdx §Error codes — a single wire-level constant
  // for the elf_lite_load caller taxonomy.
  pub let LOADER_SEED_FAILED      : u64 = 0xFFFFFFF9

  // R31.M2-1596 (#1596): the sidecar named a cap slot that a DIFFERENT
  // LIVE task already holds. Distinct from LOADER_SEED_FAILED because the
  // blob is perfectly well-formed -- the validator passed it -- and the
  // refusal is about the state of the machine rather than the shape of the
  // input. An operator reading LOADER_SEED_FAILED looks at the image; an
  // operator reading LOADER_SEED_SLOT_TAKEN looks at what else is running.
  //
  // Both propagate identically through elf_lite_load (which tests rc != 0)
  // as ELF_CAP_SEED_FAILED, so the spawn is refused and the task torn back
  // down either way. The distinction is diagnostic, and it is the entire
  // improvement #1596 asks for: before it, this case was not an error at
  // all. loader_seed_caps minted straight over the other task's descriptor,
  // cap_mint_write cleared its owner claim on the way past, and nothing
  // anywhere reported that authority had changed hands.
  pub let LOADER_SEED_SLOT_TAKEN  : u64 = 0xFFFFFFF8

  // ============================================================================
  // loader_seed_caps(task_ptr, sidecar_base, sidecar_len) -> rc
  //
  // Signature: loader_seed_caps : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap}
  // RDI (input): task_ptr    — reserved for R21+ per-task cap_tables (unused at R20b).
  // RSI (input): sidecar_base — VA of a colocated sidecar blob (see §format).
  // RDX (input): sidecar_len  — total blob length in bytes.
  // RAX (output): LOADER_SEED_OK (0) on success, LOADER_SEED_FAILED
  //               (0xFFFFFFF9) if init_caps_validate rejects the blob.
  //
  // Semantics
  // ---------
  //   1. Call init_caps_validate(sidecar_base, sidecar_len). If non-OK
  //      → return LOADER_SEED_FAILED immediately. No mint occurs; the
  //      caller's task_ptr cap_table is unmutated.
  //   2. Load count (u16 at [sidecar_base + 0]).
  //   2.5 (#1596) PRE-PASS: for each entry, if cap_owner_live_key(slot)
  //      names an owner that is neither CAP_OWNER_NONE nor this task's own
  //      key → return LOADER_SEED_SLOT_TAKEN. Still no mint has occurred.
  //   3. For i in 0..count:
  //        entry_pa = sidecar_base + 16 + i * 16
  //        slot     = u16 at [entry_pa + 0]
  //        kind     = u16 at [entry_pa + 2]
  //        rights   = u32 at [entry_pa + 4]
  //        target_ptr = u64 at [entry_pa + 8]
  //        cap_mint_write(slot, kind, rights, target_ptr)
  //        cap_owner_claim(slot, task->pid)     [R31.M1-1587, if task_ptr != 0]
  //   4. Return LOADER_SEED_OK.
  //
  // Reads untrusted image bytes (sidecar comes from the userspace
  // image) + writes the global cap_table via cap_mint_write. Both are
  // unsafe effects — !{mem}, @{cap}.
  //
  // Register plan (callee-save via 5-push prologue, matches
  // sys_svc_lookup.pdx's 5-push idiom for nested-call alignment):
  //   rbx = sidecar_base (survives cap_mint_write's caller-save clobbers)
  //   r12 = count (loaded from [sidecar_base + 0])
  //   r13 = loop index i (0..count)
  //   r14 = task_ptr (reserved — R20b unused; kept live for future forward)
  //   r15 = my_key during the #1596 pre-pass, then scratch (entry_pa)
  //         during the mint loop. The two uses do not overlap: the pre-pass
  //         runs to completion before the mint loop starts.
  //   rax, rcx, rdx, rsi, rdi = SysV scratch for reads + cap_mint_write ABI
  //
  // The 5-push prologue (rbx/r12/r13/r14/r15) aligns rsp % 16 == 0
  // across the init_caps_validate + cap_mint_write nested calls (return
  // addr = 8 B, 5 * 8 = 40 B, total 48 B = 16 mod 0), matching the
  // discipline in sys_svc_lookup_body's justification.
  // ============================================================================
  pub let loader_seed_caps : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (task_ptr: u64) (sidecar_base: u64) (sidecar_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R20b.M4-002 (#1562) + R31.M1-1587 (#1587): walk a colocated InitCap sidecar blob, validate it via init_caps_validate, then mint each entry into the (single global) cap_table via cap_mint_write AND stamp its owner column with (task->pid, pid_gen_read(pid)) via cap_owner_claim. The task_ptr argument has existed since R20b.M4-002 carrying the comment 'unused at R20b, threaded for R21+ per-task cap_tables'; per-task CSpaces are still not here, but the thing that argument names -- the task these capabilities are being minted FOR -- is exactly what the owner column records, so #1587 uses it for that rather than adding a parallel parameter. task_ptr == 0 (the boot witness's own call, loader_seed_witness) stamps nothing and leaves CAP_OWNER_NONE, which is correct rather than merely convenient: capabilities seeded with no task belong to no process, and CAP_OWNER_NONE is a value no sweep can match. The pid is read as a qword at [task_ptr + 0] and masked to 32 bits, discarding parent_pid at +4, matching sys_fork's own read of the same field. The slot is re-read from the sidecar entry after the mint rather than parked in a register, because every callee-save register is already committed and cap_mint_write preserves them all. Ordering matters: cap_mint_write CLEARS the owner column on every mint, so the claim is a stamp onto a known-clean column rather than an overwrite -- which is what stops a re-used slot from inheriting its previous holder's key. Called by elf_lite_load at elf_load_done (post-aspace_map, pre-return) and by the boot witness in kernel_main.pdx (loader_seed_witness). Fail-fast: validator rc != 0 -> return LOADER_SEED_FAILED (0xFFFFFFF9) immediately without minting anything. On success, iterates count entries at sidecar_base + 16 + i*16, extracts slot (u16 @ +0), kind (u16 @ +2), rights (u32 @ +4), target_ptr (u64 @ +8), and calls cap_mint_write(rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr) — same ABI as cap/mint.pdx L97-115. Register plan: 5-push prologue (rbx/r12/r13/r14/r15) aligns rsp % 16 == 0 across nested calls (init_caps_validate + cap_mint_write) AND preserves the sidecar_base (rbx), count (r12), loop index (r13), task_ptr (r14) across both call sites — same idiom as sys_svc_lookup.pdx's 5-push register plan. Reads use qword loads + u16/u32 masks (same idiom as init_caps_validate's kind/slot reads at L157/L174). Writes the global cap_table via cap_mint_write — !{mem} + @{cap}. Sidecar bytes are untrusted -> unsafe.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;              // rbx = sidecar_base
        mov r14, rdi;              // r14 = task_ptr (reserved; unused at R20b)

        // Step 1: validate first — fail-fast on any structural error.
        // init_caps_validate ABI: rdi=image_base, rsi=image_len -> rax=rc.
        mov rdi, rbx;              // rdi = sidecar_base
        mov rsi, rdx;              // rsi = sidecar_len
        call init_caps_validate;
        cmp rax, 0;
        jne loader_seed_fail;

        // Step 2: load count (u16 at [sidecar_base + 0]) via qword-read + mask.
        //         Same idiom as init_caps_validate L130-133.
        mov rax, [rbx + 0];
        mov rcx, 0xFFFF;
        and rax, rcx;
        mov r12, rax;              // r12 = count

        // ===================================================================
        // Step 2.5 (R31.M2-1596, #1596): THE OWNERSHIP PRE-PASS.
        //
        // Walk every entry and refuse the WHOLE sidecar if any slot it names
        // is already held by a different live task. Nothing is minted until
        // this pass completes.
        //
        // WHY A SEPARATE PASS AND NOT A CHECK INSIDE THE MINT LOOP
        //
        // Because a mid-loop refusal is not a refusal. If entry 3 collides
        // after entries 0..2 have been minted, the load fails, the caller
        // tears the task down -- and three descriptors are left in the
        // global cap_table belonging to a task that no longer exists, with
        // owner columns claimed for a pid that has just been freed and will
        // shortly be reissued. That is strictly worse than the collision
        // being refused, and worse than the silent overwrite this gate
        // exists to replace.
        //
        // The validator above already establishes the same property for
        // structural errors ("no task can observe a partially-seeded
        // cap_table", M4-001 §validator). This extends it to semantic ones.
        // Two passes over at most 256 entries at image load is not a cost
        // worth trading an atomicity property for.
        //
        // WHAT COUNTS AS A COLLISION
        //
        // cap_owner_live_key answers CAP_OWNER_NONE unless a LIVE
        // incarnation stands behind the column, so a slot whose previous
        // holder has died is free -- which it is. Three cases refuse:
        //
        //   - held by another live process    the case #1596 is about
        //   - held by the kernel              CAP_OWNER_KERNEL; seeding
        //                                     over kernel authority is
        //                                     never a thing an image may do
        //   - held by anyone at all, when we are seeding for NO task
        //     (task_ptr == 0, the boot witness). A caller that stamps no
        //     ownership cannot claim a slot, so it must not take one from
        //     someone who did.
        //
        // Re-seeding a slot THIS task already owns is allowed: the key
        // matches and the operation is idempotent.
        //
        // WHY THIS IS AN INTERIM ANSWER, SAID PLAINLY
        //
        // The real fix is per-task capability spaces
        // (design/capabilities/per-task-cspace.md), at which point the slot
        // an image names is private to it and no collision is possible. This
        // gate does not make the global table safe; it makes the ONE
        // dangerous case -- authority silently changing hands with no
        // diagnostic anywhere -- into a refused spawn that says so. The
        // shipped images are additionally kept on disjoint slots by
        // tools/verify-user-cap-sidecars.sh, so a green tree never reaches
        // this refusal.
        // ===================================================================

        // my_key = cap_owner_pack(pid, pid_gen_read(pid)), or 0 for task 0.
        // Computed ONCE, before the scan, rather than per entry.
        xor r15, r15;              // r15 = my_key, provisionally CAP_OWNER_NONE
        cmp r14, 0;
        je loader_seed_precheck_start;

        mov rax, [r14 + 0];        // task->pid (u32 at +0; mask drops parent_pid)
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        mov rdi, rax;
        push rdi;                  // preserve pid across pid_gen_read
        sub rsp, 8;                // keep rsp %16 == 0 at the nested call
        call pid_gen_read;
        add rsp, 8;
        pop rdi;                   // rdi = pid
        mov rsi, rax;              // rsi = generation
        call cap_owner_pack;
        mov r15, rax;              // r15 = my_key (0 if unpackable)

      loader_seed_precheck_start:
        xor r13, r13;              // r13 = i = 0

      loader_seed_precheck_loop:
        cmp r13, r12;
        jge loader_seed_precheck_done;

        // slot = u16 at [sidecar_base + 16 + i*16]
        mov rax, r13;
        shl rax, 4;
        add rax, 16;
        add rax, rbx;
        mov rax, [rax + 0];
        mov rcx, 0xFFFF;
        and rax, rcx;
        mov rdi, rax;              // rdi = slot

        call cap_owner_live_key;   // rax = live key, or CAP_OWNER_NONE

        cmp rax, 0;                // free -> next entry
        je loader_seed_precheck_next;
        cmp rax, r15;              // already ours -> next entry
        je loader_seed_precheck_next;
        jmp loader_seed_slot_taken;

      loader_seed_precheck_next:
        add r13, 1;
        jmp loader_seed_precheck_loop;

      loader_seed_precheck_done:

        // Step 3: iterate count entries.
        xor r13, r13;              // r13 = i = 0

        loader_seed_loop:
          cmp r13, r12;
          jge loader_seed_ok;

          // entry_pa = sidecar_base + 16 + i * 16
          //         = rbx + 16 + (r13 << 4)
          mov r15, r13;
          shl r15, 4;              // r15 = i * 16
          add r15, 16;             // + header
          add r15, rbx;            // + sidecar_base

          // Extract slot (u16 @ +0). Read as qword, mask low 16.
          mov rax, [r15 + 0];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov rdi, rax;            // rdi = slot (arg 0 of cap_mint_write)

          // Extract kind (u16 @ +2). Read qword @ +2; low 16 = kind.
          //   The array-bounds gate inside init_caps_validate guarantees
          //   the full entry (through +15) is in-bounds, so the +2
          //   qword read is safe (straddles slot's high byte + kind +
          //   rights_low).
          mov rax, [r15 + 2];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov rsi, rax;            // rsi = kind (arg 1)

          // Extract rights (u32 @ +4). Read qword @ +4; low 32 = rights.
          mov rax, [r15 + 4];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          mov rdx, rax;            // rdx = rights (arg 2)

          // Extract target_ptr (u64 @ +8). Naturally aligned.
          mov rcx, [r15 + 8];      // rcx = target_ptr (arg 3)

          // cap_mint_write(rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr).
          // Writes the 24-byte descriptor at cap_table + slot*24. Void return.
          // It also clears cap_owner[slot] to CAP_OWNER_NONE — every mint
          // does — so the claim below is a stamp onto a known-clean column
          // rather than an overwrite of whatever the slot's last holder was.
          call cap_mint_write;

          // R31.M1-1587 (#1587): STAMP THE OWNER COLUMN.
          //
          // This is what task_ptr was threaded through for. It has been an
          // argument since R20b.M4-002 with the comment "unused at R20b …
          // for R21+ per-task cap_tables", and per-task CSpaces are still
          // not here — but the thing the argument names, "the task these
          // capabilities are being minted FOR", is exactly what the owner
          // column records. Using it now costs nothing that the CSpace work
          // will have to undo; if anything the column becomes that work's
          // migration oracle.
          //
          // task_ptr == 0 (the boot witness's own call) stamps nothing and
          // leaves CAP_OWNER_NONE, which is correct rather than merely
          // convenient: caps seeded with no task belong to no process.
          cmp r14, 0;
          je loader_seed_next;
          // slot again, re-read from the entry. cap_mint_write preserves
          // every callee-save register, so r15 still names this entry.
          mov rax, [r15 + 0];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov rdi, rax;            // rdi = slot
          // task->pid is a u32 at +0; the qword read also picks up
          // parent_pid at +4, which the mask discards.
          mov rax, [r14 + 0];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          mov rsi, rax;            // rsi = pid
          call cap_owner_claim;

        loader_seed_next:
          add r13, 1;
          jmp loader_seed_loop;

        loader_seed_ok:
          xor rax, rax;            // LOADER_SEED_OK
          jmp loader_seed_epilogue;

        loader_seed_fail:
          mov rax, 0xFFFFFFF9;     // LOADER_SEED_FAILED
          jmp loader_seed_epilogue;

        loader_seed_slot_taken:
          // R31.M2-1596 (#1596). Reached from the pre-pass ONLY, which runs
          // to completion or here before cap_mint_write is called even once.
          // The cap_table is byte-identical to what it was at entry.
          //
          // SAY SO ON THE WIRE. This is the whole point of the issue.
          //
          // The return code alone is not loud enough to count. It is
          // laundered through elf_lite_load into ELF_CAP_SEED_FAILED and
          // then through boot_spawn_user_task into BOOT_SPAWN_ERR_ELF_LOAD,
          // so by the time an operator sees anything it reads "the ELF
          // failed to load" -- which is both true and useless. The
          // condition being reported is that ANOTHER LIVE PROCESS ALREADY
          // HOLDS THIS CAPABILITY SLOT, and the only number that makes that
          // diagnosable is the slot itself.
          //
          // The slot is recomputed here from rbx (sidecar_base) and r13
          // (the pre-pass index, still live) rather than being carried in a
          // register: every callee-save register is committed, and the
          // refusal path runs once and never in a loop, so a reload costs
          // nothing that matters.
          //
          // LEVEL_ERROR, not LEVEL_INFO: a refused seed means a task that
          // was supposed to exist does not.
          //
          // The tag deliberately carries no "OK" token, so
          // tools/verify-fingerprint-coverage.sh does not require a golden
          // to assert it -- this is an event, not a fingerprint. It is the
          // exact string the #1596 mutation test greps for.
          mov rax, r13;
          shl rax, 4;
          add rax, 16;
          add rax, rbx;
          mov rax, [rax + 0];
          mov rcx, 0xFFFF;
          and rax, rcx;
          mov r8, rax;             // r8 = offending slot (klog value)

          mov rdi, 1;              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_CAP_];
          lea rdx, [rip + loader_seed_slot_taken_msg];
          lea rcx, [rip + k_slot];
          call klog_s1_d1;

          mov rax, 0xFFFFFFF8;     // LOADER_SEED_SLOT_TAKEN
          jmp loader_seed_epilogue;

        loader_seed_epilogue:
          pop r15;
          pop r14;
          pop r13;
          pop r12;
          pop rbx;
          ret
      }
    }

  // ============================================================================
  // loader_seed_caps_from_symtab(task_ptr, image_base, image_len) -> rc
  //   R20b.M6-001 (#1564): phase-2 driver for the loader capability-seed
  //   hook. Retires elf_lite_load's phase-1 empty-sidecar wire-in
  //   (elf_lite.pdx §elf_load_done).
  //
  // Signature: loader_seed_caps_from_symtab : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap}
  // RDI (input): task_ptr    — reserved for R21+ per-task cap_tables.
  // RSI (input): image_base  — VA of the raw ELF bytes.
  // RDX (input): image_len   — total ELF byte length.
  // RAX (output): LOADER_SEED_OK (0) on success or "no sidecar",
  //               LOADER_SEED_FAILED (0xFFFFFFF9) on post-resolution
  //               structural failure OR any non-zero rc from
  //               loader_seed_caps' delegation (validator + mint).
  //
  // Full semantic contract: see §Symbol walker semantics comment block
  // near the top of this module.
  //
  // Register plan:
  //   rbx = image_base (const throughout)
  //   r12 = image_len  (const throughout)
  //   r13 = shdr_base = image_base + e_shoff (const after phase 1)
  //   r14 = symtab_ptr = image_base + symtab.sh_offset (const after phase 2)
  //   r15 = strtab_ptr = image_base + strtab.sh_offset (const after phase 2)
  //   r11 = current symbol pointer (advances by 24 per iteration)
  //   rax, rcx, rdx, rdi, rsi, r8, r9, r10 = SysV scratch
  //
  // Stack frame (64 bytes, rsp aligned to 16 across nested calls):
  //   [rsp+0]:  found_count_st_value    (sentinel 0xFFF..FF if not found)
  //   [rsp+8]:  found_count_st_shndx
  //   [rsp+16]: found_entries_st_value  (sentinel 0xFFF..FF if not found)
  //   [rsp+24]: found_entries_st_shndx
  //   [rsp+32]: symtab_end_ptr
  //   [rsp+40]: strtab_size
  //   [rsp+48]: task_ptr (saved from RDI at entry — reloaded for the
  //             nested loader_seed_caps call after all clobbering ops)
  //   [rsp+56]: pad (frame is 64B — even multiple keeps rsp %16 == 0)
  //
  // Entry rsp %16 == 8 (SysV call convention). After 5 pushes: rsp %16
  // == 48 mod 16 == 0. After `sub rsp, 64`: rsp %16 == 0. Nested calls
  // (loader_seed_caps) see rsp %16 == 8 at entry (return addr pushed).
  //
  // ELF layout offsets used (SysV Vol.1 §4.1 ELF64):
  //   Ehdr:  e_shoff u64 @+40, e_shentsize u16 @+58, e_shnum u16 @+60.
  //   Shdr (64 B): sh_type u32 @+4, sh_addr u64 @+16, sh_offset u64
  //     @+24, sh_size u64 @+32, sh_link u32 @+40, sh_entsize u64 @+56.
  //   Sym  (24 B): st_name u32 @+0, st_shndx u16 @+6, st_value u64 @+8.
  //   SHT_SYMTAB = 2.
  //
  // Reads untrusted ELF bytes + writes global cap_table via delegated
  // cap_mint_write. !{mem} + @{cap}. Unsafe because the raw ELF is a
  // userspace-authored image.
  // ============================================================================
  pub let loader_seed_caps_from_symtab : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (task_ptr: u64) (image_base: u64) (image_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R20b.M6-001 (#1564): phase-2 driver retiring elf_lite_load's M4-002 empty-sidecar wire-in. Walks the raw ELF's SHT_SYMTAB by reading the section header table from image_base + e_shoff (kernel-VA visible; NOT in target user_pml4 because elf_lite_load only maps PT_LOAD segments — but the raw image_base buffer IS the .rodata.userbin embedding, identity-mapped low half). Finds the SHT_SYMTAB section (sh_type == 2), reads its sh_link to locate the associated .strtab. Iterates 24-byte symbol records comparing each name against '_init_caps' (10 chars, entries symbol) and '_init_caps_count' (16 chars, count symbol) via a shared 10-byte prefix loop + byte-10 discriminator ('\\0' -> entries, '_' -> continue matching 'count\\0'). Missing either -> LOADER_SEED_OK with no mint (init.elf, shell.elf and every current userspace image except echo_server hit this path). Both found -> translate each st_value to a file offset via the containing section (file_off = section.sh_offset + (st_value - section.sh_addr)), bounds-check, read count (u16 via qword-mask matching init_caps_validate L130-133), bounds-check entries_size = count*16, colocate into _loader_symtab_sidecar_scratch as the §3 sidecar shape (16 header + count*16 entries) via a manual header write + rep_movsb for the entries block, then delegate to loader_seed_caps for validate+mint. Any post-resolution structural corruption (out-of-range st_shndx, out-of-image file offset, count > INIT_CAP_SLOT_MAX=256) -> LOADER_SEED_FAILED. Register plan: 5-push callee-save prologue (rbx=image_base, r12=image_len, r13=shdr_base, r14=symtab_ptr, r15=strtab_ptr) + 64-byte stack frame for 6 spilled scalars (found values/shndx, symtab_end, strtab_size, task_ptr) + rsp %16 alignment. Byte compare uses `mov_b rax, [reg+reg*1]` idiom from svc_broker.pdx L413 (svc_lookup_row). rep_movsb copy uses cld+rep_movsb pattern from libc_test.pdx L136-138. u64/u32/u16 loads follow the mov / mov_d / mov_w narrow-load idiom (mcfg.pdx L197 for mov_w, superblock.pdx L146 for mov_d). Reads untrusted ELF bytes + writes global cap_table via delegated cap_mint_write -> unsafe + !{mem} + @{cap}. task_ptr threaded through untouched for R21+ per-task cap_tables.",
      block: {
        // Prologue: 5-push callee-save + 64B locals -> rsp aligned to 16.
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 64;

        // Save args.
        mov rbx, rsi;              // rbx = image_base
        mov r12, rdx;              // r12 = image_len
        mov [rsp + 48], rdi;       // spill task_ptr for the nested call

        // Initialize "not-found" sentinels for the two tracked symbols.
        // 0xFFFFFFFFFFFFFFFF is not a legal ELF st_value in either
        // section (a low-half rodata VA never reaches that magnitude),
        // so it distinguishes cleanly from a legitimate resolution.
        mov rax, 0xFFFFFFFFFFFFFFFF;
        mov [rsp + 0], rax;        // found_count_st_value = -1
        mov [rsp + 16], rax;       // found_entries_st_value = -1

        // Bounds gate: image_len >= 64 (ELF64 minimum header size).
        cmp r12, 64;
        jb lscf_ok_no_seed;

        // Read e_shoff (u64 @ image_base+40).
        mov r9, [rbx + 40];        // r9 = e_shoff

        // e_shentsize (u16 @ image_base+58); must equal 64 for ELF64.
        xor rax, rax;
        mov_w rax, [rbx + 58];
        cmp rax, 64;
        jne lscf_ok_no_seed;

        // e_shnum (u16 @ image_base+60); zero -> no section table -> no
        // symtab -> no sidecar (harmless, common for stripped images).
        xor rax, rax;
        mov_w rax, [rbx + 60];
        cmp rax, 0;
        je lscf_ok_no_seed;
        mov r8, rax;               // r8 = e_shnum

        // Bounds: e_shoff + e_shnum * 64 <= image_len (section header
        // table must lie inside the ELF bytes). 64 = 2^6 -> shl 6.
        mov rcx, r8;
        shl rcx, 6;                // rcx = e_shnum * 64
        add rcx, r9;               // rcx = e_shoff + e_shnum*64
        cmp rcx, r12;
        ja lscf_ok_no_seed;

        // shdr_base = image_base + e_shoff — const across symbol scan.
        mov r13, rbx;
        add r13, r9;               // r13 = shdr_base

        // ============================================================
        // Phase 1: scan sections for SHT_SYMTAB (sh_type == 2).
        // Uses r14 as loop index; overwritten before phase 2.
        // ============================================================
        xor r14, r14;              // r14 = i = 0
      lscf_scan_sections:
        cmp r14, r8;               // e_shnum
        jae lscf_ok_no_seed;       // no symtab in this image

        // &shdr[i] = shdr_base + i*64
        mov r9, r14;
        shl r9, 6;
        add r9, r13;               // r9 = &shdr[i]

        // Read sh_type (u32 @ +4)
        xor rax, rax;
        mov_d rax, [r9 + 4];
        cmp rax, 2;                // SHT_SYMTAB
        je lscf_found_symtab;

        add r14, 1;
        jmp lscf_scan_sections;

      lscf_found_symtab:
        // r9 = &shdr[symtab]. Verify sh_entsize (u64 @+56) == 24.
        mov rax, [r9 + 56];
        cmp rax, 24;
        jne lscf_ok_no_seed;

        // symtab sh_offset (u64 @+24), sh_size (u64 @+32).
        mov r10, [r9 + 24];        // r10 = symtab sh_offset
        mov rcx, [r9 + 32];        // rcx = symtab sh_size

        // Bounds: symtab_offset + symtab_size <= image_len.
        mov rax, r10;
        add rax, rcx;
        cmp rax, r12;
        ja lscf_ok_no_seed;

        // symtab_ptr = image_base + sh_offset (const across phase 3).
        mov r14, rbx;
        add r14, r10;              // r14 = symtab_ptr

        // symtab_end_ptr = symtab_ptr + sh_size — spill to stack.
        mov rax, r14;
        add rax, rcx;
        mov [rsp + 32], rax;       // [rsp+32] = symtab_end_ptr

        // sh_link (u32 @+40) — index of the associated .strtab.
        xor rcx, rcx;
        mov_d rcx, [r9 + 40];
        cmp rcx, r8;               // must be < e_shnum
        jae lscf_ok_no_seed;

        // &shdr[strtab] = shdr_base + sh_link * 64
        shl rcx, 6;
        add rcx, r13;              // rcx = &shdr[strtab]

        // strtab sh_offset (u64 @+24), sh_size (u64 @+32).
        mov r10, [rcx + 24];       // r10 = strtab_offset
        mov rax, [rcx + 32];       // rax = strtab_size

        // Bounds: strtab_offset + strtab_size <= image_len.
        mov r9, r10;
        add r9, rax;
        cmp r9, r12;
        ja lscf_ok_no_seed;

        // strtab_ptr = image_base + strtab_offset (const across phase 3).
        mov r15, rbx;
        add r15, r10;              // r15 = strtab_ptr

        // Spill strtab_size for per-symbol bounds checks.
        mov [rsp + 40], rax;

        // ============================================================
        // Phase 2: iterate symbols, match names against targets.
        // r14 = symtab_ptr (const), r15 = strtab_ptr (const),
        // [rsp+32] = symtab_end_ptr, [rsp+40] = strtab_size.
        // r11 = current symbol cursor (starts at symtab_ptr).
        // ============================================================
        mov r11, r14;              // r11 = current sym ptr

      lscf_sym_loop:
        mov rax, [rsp + 32];       // symtab_end_ptr
        cmp r11, rax;
        jae lscf_sym_done;

        // Read st_name (u32 @+0).
        xor rax, rax;
        mov_d rax, [r11 + 0];      // rax = st_name (offset into strtab)

        // Bounds: st_name < strtab_size AND remaining >= 11 (min length
        // for "_init_caps\\0"). If remaining < 11, skip.
        mov rcx, [rsp + 40];       // strtab_size
        cmp rax, rcx;
        jae lscf_sym_next;
        sub rcx, rax;              // rcx = remaining bytes
        cmp rcx, 11;
        jb lscf_sym_next;

        // name_ptr = strtab_ptr + st_name.
        mov rdi, r15;
        add rdi, rax;              // rdi = name_ptr

        // Save "remaining" in r8 for the count-suffix bounds check.
        mov r8, rcx;

        // Compare 10 bytes at name_ptr against "_init_caps".
        lea rsi, [rip + _init_caps_str];
        xor rcx, rcx;              // rcx = i = 0
      lscf_prefix_loop:
        cmp rcx, 10;
        jae lscf_prefix_matched;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        xor r9, r9;
        mov_b r9, [rsi + rcx*1];
        cmp rax, r9;
        jne lscf_sym_next;
        add rcx, 1;
        jmp lscf_prefix_loop;

      lscf_prefix_matched:
        // 10-byte prefix "_init_caps" matched. Read byte 10 to
        // disambiguate the two accepted target names.
        xor rax, rax;
        mov_b rax, [rdi + 10];
        cmp rax, 0;                // NUL -> exact "_init_caps"
        je lscf_matched_entries;
        cmp rax, 0x5F;             // '_' -> maybe "_init_caps_count"
        jne lscf_sym_next;

        // Need remaining >= 17 for full "_init_caps_count\\0" (16 chars
        // + NUL). If short, no match.
        cmp r8, 17;
        jb lscf_sym_next;

        // Compare 6 bytes at [rdi+11] against "count\\0".
        add rdi, 11;               // advance to position 11
        lea rsi, [rip + _init_caps_count_suffix_str];
        xor rcx, rcx;              // i = 0
      lscf_suffix_loop:
        cmp rcx, 6;
        jae lscf_matched_count;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        xor r9, r9;
        mov_b r9, [rsi + rcx*1];
        cmp rax, r9;
        jne lscf_sym_next;
        add rcx, 1;
        jmp lscf_suffix_loop;

      lscf_matched_entries:
        // Save (st_shndx u16 @+6, st_value u64 @+8) of entries symbol.
        xor rax, rax;
        mov_w rax, [r11 + 6];
        mov [rsp + 24], rax;       // entries_st_shndx
        mov rax, [r11 + 8];
        mov [rsp + 16], rax;       // entries_st_value
        jmp lscf_sym_next;

      lscf_matched_count:
        // Save (st_shndx, st_value) of count symbol.
        xor rax, rax;
        mov_w rax, [r11 + 6];
        mov [rsp + 8], rax;        // count_st_shndx
        mov rax, [r11 + 8];
        mov [rsp + 0], rax;        // count_st_value
        jmp lscf_sym_next;

      lscf_sym_next:
        add r11, 24;               // advance by sh_entsize (=24)
        jmp lscf_sym_loop;

      lscf_sym_done:
        // ============================================================
        // Phase 3: check both symbols resolved. Missing either -> no
        // sidecar, no mint (LOADER_SEED_OK).
        // ============================================================
        mov rax, [rsp + 0];        // count_st_value
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rcx;
        je lscf_ok_no_seed;

        mov rax, [rsp + 16];       // entries_st_value
        cmp rax, rcx;
        je lscf_ok_no_seed;

        // ============================================================
        // Phase 4: translate st_value -> file offset for both symbols
        // via containing section (file_off = sh_offset + (st_value -
        // sh_addr)). Then read count, colocate, and delegate.
        // ============================================================

        // e_shnum reload (used for shndx bounds).
        xor r8, r8;
        mov_w r8, [rbx + 60];      // r8 = e_shnum

        // --- Count symbol resolution ---
        mov rax, [rsp + 8];        // count_st_shndx
        cmp rax, r8;
        jae lscf_hard_fail;
        // &shdr[count_shndx] = shdr_base + shndx*64
        shl rax, 6;
        add rax, r13;              // rax = &shdr[count]
        mov rcx, [rax + 24];       // sh_offset
        mov r9, [rax + 16];        // sh_addr
        mov r10, [rsp + 0];        // count_st_value
        sub r10, r9;               // r10 = st_value - sh_addr
        add rcx, r10;              // rcx = count_file_offset

        // Bounds: count_file_offset + 8 <= image_len. Reading a full
        // qword since paideia-as emits u16 -> u64 for the underlying
        // symbol; the low 16 bits carry count.
        mov r10, rcx;
        add r10, 8;
        cmp r10, r12;
        ja lscf_hard_fail;

        // Read count (u16 via qword+mask, matches init_caps_validate).
        mov r10, rbx;
        add r10, rcx;              // &image[count_file_offset]
        mov rax, [r10];
        mov rcx, 0xFFFF;
        and rax, rcx;              // rax = count (low 16 bits)

        // count <= INIT_CAP_SLOT_MAX (256). Anything larger cannot fit
        // in the cap_table and is a hard corruption signal.
        cmp rax, 256;
        ja lscf_hard_fail;

        // Save count in r9 (survives entries resolution + colocate).
        mov r9, rax;

        // --- Entries symbol resolution ---
        mov rax, [rsp + 24];       // entries_st_shndx
        cmp rax, r8;
        jae lscf_hard_fail;
        shl rax, 6;
        add rax, r13;              // rax = &shdr[entries]
        mov rcx, [rax + 24];       // sh_offset
        mov r10, [rax + 16];       // sh_addr
        mov r8, [rsp + 16];        // entries_st_value
        sub r8, r10;               // r8 = st_value - sh_addr
        add rcx, r8;               // rcx = entries_file_offset

        // entries_size = count * 16
        mov r10, r9;
        shl r10, 4;                // r10 = count * 16

        // Bounds: entries_file_offset + entries_size <= image_len.
        mov r8, rcx;
        add r8, r10;
        cmp r8, r12;
        ja lscf_hard_fail;

        // ============================================================
        // Phase 5: colocate into scratch as sidecar shape (§3).
        //   scratch[0..8]  = count in low 16 (high 48 zero)
        //   scratch[8..16] = zeros (pad2)
        //   scratch[16..16+count*16] = memcpy from image_base + entries_off
        // ============================================================
        lea r8, [rip + _loader_symtab_sidecar_scratch];

        // scratch[0] = count (u64 with count in low 16, rest zero — the
        // validator masks with 0xFFFF, so higher bits are inert).
        mov [r8 + 0], r9;

        // scratch[8] = 0 (padding pad2 per §3 "MUST be zero at phase-1").
        xor rax, rax;
        mov [r8 + 8], rax;

        // Copy count*16 bytes from image_base + entries_file_offset
        // to scratch + 16 via cld + rep_movsb (matches libc_test.pdx
        // L136-138 idiom). rcx = byte count, rsi = src, rdi = dst.
        mov rdi, r8;
        add rdi, 16;               // dst = scratch + 16
        mov rsi, rbx;
        add rsi, rcx;              // src = image_base + entries_file_off
        // Note: rcx currently holds entries_file_offset; we need
        // r10 (count*16) as the movsb count. Shuffle before rep_movsb.
        mov rcx, r10;              // rcx = count * 16 (movsb byte count)
        cld;
        rep_movsb;

        // ============================================================
        // Phase 6: delegate to loader_seed_caps (validate + mint).
        //   sidecar_len = 16 + count*16. count is still in r9 (movsb
        //   only clobbers rcx/rsi/rdi; r9 is caller-save but no
        //   function call happened between the count read and here).
        // ============================================================
        mov r10, r9;
        shl r10, 4;                // count * 16
        add r10, 16;               // sidecar_len

        mov rdi, [rsp + 48];       // task_ptr
        lea rsi, [rip + _loader_symtab_sidecar_scratch];
        mov rdx, r10;
        call loader_seed_caps;
        // rax = LOADER_SEED_OK (0) or LOADER_SEED_FAILED (0xFFFFFFF9).
        // Pass-through.
        jmp lscf_epilogue;

      lscf_ok_no_seed:
        xor rax, rax;              // LOADER_SEED_OK
        jmp lscf_epilogue;

      lscf_hard_fail:
        mov rax, 0xFFFFFFF9;       // LOADER_SEED_FAILED
        jmp lscf_epilogue;

      lscf_epilogue:
        add rsp, 64;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // R31.M2-1596 (#1596): emitted by loader_seed_caps' LOADER_SEED_SLOT_TAKEN
  // refusal, with the offending cap slot as a decimal KV. No "OK" token --
  // this is an event tag, not a fingerprint, so the coverage gate does not
  // demand a golden for it.
  pub let loader_seed_slot_taken_msg : [u8; 25] = "R31 SEED SLOT TAKEN LIVE\0"

}
