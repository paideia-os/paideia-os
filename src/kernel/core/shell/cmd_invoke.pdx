// src/kernel/core/shell/cmd_invoke.pdx -- R123.M3 (paideia-os #2505)
//
// In-process invoke ABI for light shell commands. Sits between the
// R123.M2 cmd_registry (which resolves shell command names to
// KIND_CMD_MODULE cap handles) and the R123.M3 light-command
// implementations (cmd_light.pdx). Consumer: the R123.M3 boot witness
// (r123_cmd_invoke.pdx) and, once the shell dispatcher lands
// (post-R123.M4), the shell path itself.
//
// =============================================================================
// SECTION 0  ABI
// =============================================================================
//
// Public entry point:
//   cmd_invoke_inproc(cap_handle, stream_in_edge, argv_ptr, argv_len,
//                     cap_env, stream_out_edge) -> u64
//
// Argument register mapping (SysV AMD64, matches paideia-as ABI):
//   rdi = cap_handle       (u64; convention: cmd_module row_idx + 1)
//   rsi = stream_in_edge   (u64; opaque -- pipeline_edge_id or 0)
//   rdx = argv_ptr         (u64; byte pointer into caller memory)
//   rcx = argv_len         (u64; bytes at argv_ptr)
//   r8  = cap_env          (u64; opaque -- cap-env id or 0)
//   r9  = stream_out_edge  (u64; opaque -- pipeline_edge_id or 0)
//
// The dispatched light function receives the five ring-3-visible args
// verbatim (stream_in / argv / cap_env / stream_out), i.e. its ABI is
// the same as this function's WITHOUT the leading cap_handle:
//   light_XXX(stream_in_edge, argv_ptr, argv_len, cap_env, stream_out_edge)
//     -> u64  (rows-produced count, or fresh error sentinel)
//
// =============================================================================
// SECTION 1  cap_handle CONVENTION -- ROW_IDX + 1
// =============================================================================
//
// cmd_registry stores cap_handle in the low 32 bits of a per-entry
// flags word; the registry's free-slot sentinel is flags == 0, so
// storing cap_handle == 0 would collide with the sentinel. To keep
// row_idx == 0 addressable through the registry, cmd_invoke_inproc
// interprets cap_handle as `cmd_module row_idx + 1` -- i.e. a
// cmd_module row 0..15 maps to a registry cap_handle of 1..16.
//
// This is the "+1 offset discipline" the R123.M2 landing comment
// (src/kernel/core/shell/cmd_registry.pdx §2) forecast for the
// "follow-up landing" (this M3). It is enforced HERE (in the invoke
// path) rather than in cmd_registry_insert (which stays opaque about
// what its cap_handle field means) so cmd_registry_insert can serve
// future callers that pick a different tagging scheme.
//
// =============================================================================
// SECTION 2  FAILURE BAND -- 0xFFFFEBC0..0xFFFFEBC7
// =============================================================================
//
// SPEC-vs-CODEBASE DRIFT: the R123.M3 briefing named 0xFFFFEBA0..A7
// as the "fresh band", but pipeline_edge_transport.pdx §fixed
// reserves the entire 0xFFFFEBA0..0xFFFFEBAF strip (three
// PET_BIND_* sentinels at 0xFFFFEBAD/EAE/EAF) and cmd_module.pdx
// §4 documents "R121.M4 duality band 0xFFFFEBA0..0xFFFFEBAF sits
// immediately below". Per feedback_spec_vs_codebase_conflicts:
// PRESERVE the codebase invariant (PET holds EBA0..EBAF, even if
// slots 0..C are unassigned; the block is claimed) and MOVE the CI
// band to the next genuinely fresh strip 0xFFFFEBC0..0xFFFFEBCF.
//
// Neighbours (2026-09-24 sweep):
//   0xFFFFEB80..0xFFFFEB8F  pipeline_edge (PE_MINT_BAD_*, PE_TAIL_*)
//   0xFFFFEB90..0xFFFFEB9F  pipeline_edge_transport (PET_BIND/SEND/RECV)
//   0xFFFFEBA0..0xFFFFEBAF  pipeline_edge_transport (PET duality)
//   0xFFFFEBB0..0xFFFFEBBF  cmd_module (CM_MINT_BAD_*, CM_BAD_SLOT)
//   0xFFFFEBC0..0xFFFFEBC7  (this landing)
//   0xFFFFEBC8..0xFFFFEBDF  free
//   0xFFFFEBE0..0xFFFFEBEF  audit_journal_broker
//   0xFFFFEBF0..0xFFFFEBFF  elevate_broker
//
//   CI_BAD_CAP           0xFFFFEBC0  -- cap_handle == 0, > CM_MAX, or
//                                       the underlying cmd_module row
//                                       is free / decoded as invalid
//                                       (functor_id 0 or CM_DECODE_BAD)
//   CI_NOT_INPROCESS     0xFFFFEBC1  -- cap resolves but the module
//                                       is marked out-of-process; heavy
//                                       commands go through R123.M4
//                                       (fork+exec) which lands later
//   CI_FUNCTOR_NOT_FOUND 0xFFFFEBC2  -- functor_id outside the M3
//                                       light-command range [100..103]
//   CI_ARGV_INVALID      0xFFFFEBC3  -- reserved; not raised at M3
//                                       (argv is opaque here; the R121.
//                                       M3 Cap'n Proto boundary will
//                                       enforce argv shape later)
//
// =============================================================================
// SECTION 3  DISPATCH -- compare cascade, not indirect jump table
// =============================================================================
//
// Four functor_ids (100..103) map 1:1 to light_where / light_sort /
// light_head / light_count. A compare-and-jump cascade dispatches:
//
//   cmp functor_id, 100 ; je light_where
//   cmp functor_id, 101 ; je light_sort
//   cmp functor_id, 102 ; je light_head
//   cmp functor_id, 103 ; je light_count
//
// Rationale for cascade over an indirect table:
//   (a) 4 entries: cascade is ~12 instructions, small enough that a
//       table lookup + indirect call would not be shorter.
//   (b) Avoids the cross-module data-init question: paideia-as's
//       constant-folder for `pub let TAB : [u64; 4] = [(rip + sym), ...]`
//       is not exercised across modules elsewhere; a same-module
//       precedent exists (klog/file_ids.pdx §_klog_files with all
//       symbols in FileIds) but cross-module reach has no precedent.
//   (c) Every branch is a direct rel32 -- kinder to the encoder than
//       `mov rax, [tab + idx*8]; call rax`, and every callee is
//       resolved statically at link time.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * No `test rN, rN` -- every zero-check uses `cmp reg, 0`.
//   * No `and reg, imm64` -- 0xFFFFFFFFFFFFFFFF stages through r10.
//   * No 2-op `imul r, imm`.
//   * No `add reg, [mem]` / `cmp reg, [mem]` -- every memory operand
//     lands in a register first.
//   * No `mov_b [mem]` byte-store.
//   * Reserved-label prefix `ci_` avoids the loop/if/top/done
//     collision class per feedback_paideia_as_reserved_labels.

module CmdInvoke = structure {

  // =========================================================================
  // SECTION 5  CONSTANTS
  // =========================================================================

  pub let CI_OK                : u64 = 0
  pub let CI_BAD_CAP           : u64 = 0xFFFFEBC0
  pub let CI_NOT_INPROCESS     : u64 = 0xFFFFEBC1
  pub let CI_FUNCTOR_NOT_FOUND : u64 = 0xFFFFEBC2
  pub let CI_ARGV_INVALID      : u64 = 0xFFFFEBC3

  // Light-command functor id range: [100..103] (where/sort/head/count).
  pub let CI_FUNCTOR_BASE      : u64 = 100
  pub let CI_FUNCTOR_END       : u64 = 104          // exclusive

  // cmd_module row-idx ceiling (from cmd_module.pdx CM_MAX = 16).
  // Duplicated here as a local constant rather than referenced across
  // modules so a future CM_MAX change gates a paired edit.
  pub let CI_CM_MAX            : u64 = 16

  // =========================================================================
  // SECTION 6  cmd_invoke_inproc(cap, stream_in, argv, argv_len,
  //                              cap_env, stream_out) -> u64
  //
  // Gate order:
  //   (1) cap_handle in [1..CI_CM_MAX]. Otherwise CI_BAD_CAP.
  //   (2) row_idx = cap_handle - 1. functor_id =
  //       cmd_module_get_functor_id(row_idx). Must not be CM_DECODE_BAD
  //       (0xFFFFFFFFFFFFFFFF) and must not be 0. Otherwise CI_BAD_CAP.
  //   (3) cmd_module_is_in_process(row_idx) == 1. Otherwise
  //       CI_NOT_INPROCESS.
  //   (4) functor_id in [CI_FUNCTOR_BASE..CI_FUNCTOR_END). Otherwise
  //       CI_FUNCTOR_NOT_FOUND.
  //   (5) Dispatch to light_where / light_sort / light_head /
  //       light_count via compare cascade. Return the callee's rax
  //       verbatim.
  //
  // Register plan:
  //   All six ABI args must survive two nested cmd_module_* calls
  //   whose caller-save clobbers wreck rdx/rcx/r8/r9. Stash the six
  //   args on a 48-byte local scratch frame at entry, reload the
  //   five downstream args (dropping cap_handle) into the ABI regs
  //   just before the light-command call.
  //
  //   Five callee-save pushes (rbx = row_idx, r12 = functor_id;
  //   r13/r14/r15 unused but pushed for alignment consistency with
  //   sibling cap-substrate helpers). Entry rsp%16==8; +40 -> %16==0;
  //   sub rsp,48 stays at %16==0; nested calls arrive at callee with
  //   rsp%16==8 per SysV.
  // =========================================================================

  pub let cmd_invoke_inproc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (cap_handle: u64) (stream_in_edge: u64) (argv_ptr: u64)
       (argv_len: u64) (cap_env: u64) (stream_out_edge: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M3 (paideia-os #2505): in-process invoke ABI for light shell commands. Convention: cap_handle = cmd_module row_idx + 1 (per R123.M2 comment about '+1 offset discipline' -- keeps row 0 addressable through the registry whose free-slot sentinel is stored-cap_handle==0). Gate order: (1) cap_handle in [1..CI_CM_MAX=16]; (2) cmd_module_get_functor_id(cap-1) yields valid functor (not 0, not CM_DECODE_BAD sentinel 0xFFFFFFFFFFFFFFFF); (3) cmd_module_is_in_process(cap-1) == 1; (4) functor_id in [CI_FUNCTOR_BASE=100..CI_FUNCTOR_END=104). Dispatch is a compare-and-jump cascade (4 direct rel32 branches) rather than a table-indexed indirect call -- see §3 for the design rationale. All six ABI args (rdi..r9) must survive two nested cmd_module_* calls (both caller-save-clobber rdx/rcx/r8/r9), so they are stashed on a local 48-byte scratch frame at entry and the five downstream args reloaded into ABI regs just before the light-command call. Register plan: 5 callee-save pushes (rbx=row_idx cache, r12=functor_id) leave rsp%16==0 after +40; sub rsp,48 keeps %16==0; nested calls arrive at callee with rsp%16==8 per SysV. Failure funnel is straight-line (no cleanup: no allocations happen). Labels prefixed ci_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 48;                    // 6 args × 8 bytes scratch

        // Stash the six ABI args on the scratch frame. This copies
        // BEFORE any gate call clobbers rdi..r9.
        mov [rsp + 0],  rdi;             // cap_handle
        mov [rsp + 8],  rsi;             // stream_in_edge
        mov [rsp + 16], rdx;             // argv_ptr
        mov [rsp + 24], rcx;             // argv_len
        mov [rsp + 32], r8;              // cap_env
        mov [rsp + 40], r9;              // stream_out_edge

        // Gate 1: cap_handle in [1..CI_CM_MAX].
        cmp rdi, 0;
        je  ci_bad_cap;
        mov r10, 16;                     // CI_CM_MAX
        cmp rdi, r10;
        ja  ci_bad_cap;

        // Derive row_idx = cap_handle - 1 into rbx (survives nested).
        mov rbx, rdi;
        sub rbx, 1;

        // Gate 2: cmd_module_get_functor_id(row_idx) must not be
        // CM_DECODE_BAD (0xFFFFFFFFFFFFFFFF) and must not be 0.
        mov rdi, rbx;
        call cmd_module_get_functor_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ci_bad_cap;
        cmp rax, 0;
        je  ci_bad_cap;
        mov r12, rax;                    // r12 = functor_id

        // Gate 3: cmd_module_is_in_process(row_idx) == 1.
        mov rdi, rbx;
        call cmd_module_is_in_process;
        cmp rax, 1;
        jne ci_not_inproc;

        // Gate 4: functor_id in [100..104).
        cmp r12, 100;
        jb  ci_not_found;
        cmp r12, 104;
        jae ci_not_found;

        // Reload the five downstream args into ABI regs (drop
        // cap_handle at scratch[0]).
        mov rdi, [rsp + 8];              // stream_in_edge
        mov rsi, [rsp + 16];             // argv_ptr
        mov rdx, [rsp + 24];             // argv_len
        mov rcx, [rsp + 32];             // cap_env
        mov r8,  [rsp + 40];             // stream_out_edge

        // Dispatch cascade (§3). Every jump is a direct rel32.
        cmp r12, 100;
        je  ci_call_where;
        cmp r12, 101;
        je  ci_call_sort;
        cmp r12, 102;
        je  ci_call_head;
        cmp r12, 103;
        je  ci_call_count;
        // Unreachable given gate 4, but defensive.
        jmp ci_not_found;

      ci_call_where:
        call light_where;
        jmp ci_out;
      ci_call_sort:
        call light_sort;
        jmp ci_out;
      ci_call_head:
        call light_head;
        jmp ci_out;
      ci_call_count:
        call light_count;
        jmp ci_out;

      ci_bad_cap:
        mov rax, 0xFFFFEBC0;             // CI_BAD_CAP
        jmp ci_out;
      ci_not_inproc:
        mov rax, 0xFFFFEBC1;             // CI_NOT_INPROCESS
        jmp ci_out;
      ci_not_found:
        mov rax, 0xFFFFEBC2;             // CI_FUNCTOR_NOT_FOUND

      ci_out:
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
