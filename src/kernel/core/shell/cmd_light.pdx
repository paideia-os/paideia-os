// src/kernel/core/shell/cmd_light.pdx -- R123.M3 (paideia-os #2505)
//
// Reference implementations for the four light shell commands
// (where / sort / head / count), functor_ids 100..103. Consumed by
// src/kernel/core/shell/cmd_invoke.pdx's dispatch cascade after the
// R123.M2 registry resolves a shell-command name to a KIND_CMD_MODULE
// cap handle.
//
// =============================================================================
// SECTION 0  SCOPE -- STUB BODIES
// =============================================================================
//
// R121.M3's Cap'n Proto stream boundary (design/terminal/semantic-
// shell-materialization-plan.md §R121) is DEFERRED per the parent
// R123 briefing. Without it, none of the four light commands have a
// real record-stream ABI to consume or produce -- what would `where`
// filter, or `sort` order, when there is no record shape yet?
//
// R123.M3 therefore lands the invoke ABI PLUMBING with stub bodies:
// each function guardedly touches argv_ptr[0] (to prove the ABI
// marshalled the pointer readably) and returns a distinct
// functor-id-derived constant so the boot witness can assert the
// dispatch table steered to the correct callee:
//
//   light_where -> 100  (== functor_id)
//   light_sort  -> 101
//   light_head  -> 102
//   light_count -> 103
//
// A follow-up landing (post-R121.M3) will grow each stub into a real
// record-filter / order / head-N / count body. The stub-vs-real
// discriminator is the return value: any nonzero row-count value
// today (100..103) reads as "stub landed", and the follow-up will
// return a genuine row count based on argv semantics.
//
// =============================================================================
// SECTION 1  ABI (matches CmdInvoke §0)
// =============================================================================
//
//   rdi = stream_in_edge   (u64; opaque -- unused at M3)
//   rsi = argv_ptr         (u64; byte pointer; guardedly touched)
//   rdx = argv_len         (u64; bytes at argv_ptr; guardedly touched)
//   rcx = cap_env          (u64; opaque -- unused at M3)
//   r8  = stream_out_edge  (u64; opaque -- unused at M3)
//   -> rax = constant row-count value (100..103)
//
// Body pattern (leaf, no callee-save pushes needed):
//   If argv_ptr != 0 AND argv_len > 0, read argv_ptr[0] into a scratch
//   register (rax). This memory read is the ABI-marshal-proof: if the
//   caller passed a bogus pointer, a page fault would land here; if
//   the pointer arrived readable, the stub proceeds and overwrites
//   rax with the return constant. The read is otherwise UNUSED --
//   real predicate / order / limit / accumulate bodies land in the
//   follow-up.
//
// =============================================================================
// SECTION 2  ENCODER DISCIPLINE (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * No `test rN, rN` -- zero-checks use `cmp reg, 0`.
//   * mov_b load bracketed by `xor rax, rax` for explicit
//     zero-extension (paideia-as does not implicitly zero-extend).
//   * Explicit `*1` SIB on the mov_b index (proven idiom, see
//     cmd_module.pdx §13 comment on superblock.pdx §271 encoder-
//     friction note).
//   * Reserved-label prefix `lw_ / ls_ / lh_ / lc_` per feedback_
//     paideia_as_reserved_labels avoids the loop/if/top/done
//     collision class.

module CmdLight = structure {

  // =========================================================================
  // SECTION 3  RETURN CONSTANTS
  // =========================================================================
  //
  // Named for callers that need to assert the round-trip (e.g. the
  // R123.M3 boot witness). Values coincide with functor_id purely for
  // readability at the fingerprint site (fingerprint prints ns=<v>).

  pub let LIGHT_WHERE_RET : u64 = 100
  pub let LIGHT_SORT_RET  : u64 = 101
  pub let LIGHT_HEAD_RET  : u64 = 102
  pub let LIGHT_COUNT_RET : u64 = 103

  // =========================================================================
  // SECTION 4  light_where (functor_id 100)
  // =========================================================================

  pub let light_where : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (stream_in: u64) (argv_ptr: u64) (argv_len: u64)
       (cap_env: u64) (stream_out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M3 (paideia-os #2505): light-command stub for `where`, functor_id 100. STUB body per §0 -- real predicate-filter lands post-R121.M3 when the Cap'n Proto record boundary firms up. Guardedly reads argv_ptr[0] (only when both argv_ptr != 0 AND argv_len > 0) into rax; that read is the ABI-marshal-proof (bogus pointer -> page fault here). rax is then overwritten with the return constant LIGHT_WHERE_RET=100 so the read has no observable effect. Leaf function; no callee-save pushes required. mov_b bracketed by explicit `xor rax, rax` for zero-extension per paideia-as encoder rules. Labels prefixed lw_.",
      block: {
        cmp rsi, 0;
        je  lw_ret;
        cmp rdx, 0;
        je  lw_ret;
        xor rax, rax;
        mov_b rax, [rsi + 0];            // ABI-marshal proof; discard
      lw_ret:
        mov rax, 100;                    // LIGHT_WHERE_RET
        ret
      }
    }

  // =========================================================================
  // SECTION 5  light_sort (functor_id 101)
  // =========================================================================

  pub let light_sort : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (stream_in: u64) (argv_ptr: u64) (argv_len: u64)
       (cap_env: u64) (stream_out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M3 (paideia-os #2505): light-command stub for `sort`, functor_id 101. STUB per §0 -- real order-by lands post-R121.M3. Byte-identical shape to light_where; only the return constant differs (LIGHT_SORT_RET=101). Labels prefixed ls_.",
      block: {
        cmp rsi, 0;
        je  ls_ret;
        cmp rdx, 0;
        je  ls_ret;
        xor rax, rax;
        mov_b rax, [rsi + 0];
      ls_ret:
        mov rax, 101;                    // LIGHT_SORT_RET
        ret
      }
    }

  // =========================================================================
  // SECTION 6  light_head (functor_id 102)
  // =========================================================================

  pub let light_head : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (stream_in: u64) (argv_ptr: u64) (argv_len: u64)
       (cap_env: u64) (stream_out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M3 (paideia-os #2505): light-command stub for `head`, functor_id 102. STUB per §0 -- real head-N lands post-R121.M3. Byte-identical shape to light_where. Return LIGHT_HEAD_RET=102. Labels prefixed lh_.",
      block: {
        cmp rsi, 0;
        je  lh_ret;
        cmp rdx, 0;
        je  lh_ret;
        xor rax, rax;
        mov_b rax, [rsi + 0];
      lh_ret:
        mov rax, 102;                    // LIGHT_HEAD_RET
        ret
      }
    }

  // =========================================================================
  // SECTION 7  light_count (functor_id 103)
  // =========================================================================

  pub let light_count : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (stream_in: u64) (argv_ptr: u64) (argv_len: u64)
       (cap_env: u64) (stream_out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M3 (paideia-os #2505): light-command stub for `count`, functor_id 103. STUB per §0 -- real accumulator lands post-R121.M3. Byte-identical shape to light_where. Return LIGHT_COUNT_RET=103. Labels prefixed lc_.",
      block: {
        cmp rsi, 0;
        je  lc_ret;
        cmp rdx, 0;
        je  lc_ret;
        xor rax, rax;
        mov_b rax, [rsi + 0];
      lc_ret:
        mov rax, 103;                    // LIGHT_COUNT_RET
        ret
      }
    }
}
