// src/kernel/core/shell/repl_loop.pdx -- Wave UMB-W28 R229.M1
// paideia-os #2719
//
// REPL EVALUATOR LOOP SCAFFOLD
// =============================================================================
//
// R229 ("REPL evaluator loop") milestone M1. M1 lands the per-session
// state machine substrate that owns one shell session's
// read/eval/write cycle: a 128-byte row keyed by session_id, a
// line-accumulation buffer, and three direct-call entry points
// (init_session / tick / emit_prompt) that drive the state ordinals
// forward.
//
// The actual EVAL dispatch (PARSED -> EVAL -> WRITING) is deferred to
// R229.M2+. M1 ships only the state machine; the TTY-side write and
// the pds-lang evaluator wiring both land later. At M1 the state
// machine accepts bytes in READING, transitions to PARSED on LF, and
// trips RL_ERR_LINE_OVERFLOW if the 112-byte line_buf fills.
//
// Boot wiring: kernel_main.pdx picks this up with ONE new call right
// after _shell_history_init (R127.M4) and before _hf_init (R127.M7):
//
//   call _shell_history_init;        // R127.M4
//   call _rl_init;                   // R229.M1 (this file)
//   call _hf_init;                   // R127.M7
//
// Shape mirrors _shell_history_init / _shell_jobs_init / _hf_init
// one-for-one. The pool backing is not scrubbed at boot (.bss is
// already zero at real boot; a slot is live only once _rl_init_
// session rewrites every field).
//
// Design: design/shell/repl-loop-scaffold.md.
//
// =============================================================================
// SECTION 1  ROW LAYOUT  --  128 BYTES PER ROW, 8 ROWS
// =============================================================================
//
// Per R229.M1 task directive, each row is 128 bytes = 16 u64. Stride
// 128 is a power of two so row addressing uses `shl rax, 7` -- no imul.
//
//   [+0]    state            (u32)  one of RL_STATE_* ordinals
//   [+4]    line_buf_head    (u32)  next-write index in line_buf
//                                   (0 .. RL_LINE_MAX = 112)
//   [+8]    line_buf         [u8; 112]   bytes accumulated since the
//                                        last PROMPT, LF-included on
//                                        the final byte
//   [+120]  reserved         [u8; 8]     .bss-zero sentinel; R229.M2+
//                                        reinterprets.
//
// Row-addressed capacity: RL_POOL_MAX = 8 (matches shell_session's
// SS_POOL_MAX; a REPL row is keyed by the same session_id).
//
// =============================================================================
// SECTION 2  STATE MACHINE
// =============================================================================
//
//   RL_STATE_PROMPT      = 0   -- prompt about to be emitted
//   RL_STATE_READING     = 1   -- line_buf is accepting bytes
//   RL_STATE_PARSED      = 2   -- LF seen; line_buf holds a full line
//   RL_STATE_EVAL        = 3   -- eval dispatch in flight (R229.M2+)
//   RL_STATE_WRITING     = 4   -- stdout bytes draining to TTY (R229.M2+)
//   RL_STATE_IDLE        = 5   -- between cycles, pre-next-PROMPT
//   RL_STATE_TERMINATED  = 6   -- session over; terminal
//
// Transitions at M1 (any invalid tick returns RL_ERR_STATE):
//
//   (init)        -> PROMPT                  _rl_init_session
//   PROMPT        -> READING                 _rl_emit_prompt
//   IDLE          -> READING                 _rl_emit_prompt
//   READING       -> READING                 _rl_tick (byte != 0x0A)
//   READING       -> PARSED                  _rl_tick (byte == 0x0A)
//   READING       -> IDLE                    _rl_tick (overflow)
//
// R229.M2+ drives PARSED -> EVAL -> WRITING -> IDLE through
// _rl_dispatch (deferred).  M1's _rl_tick returns RL_ERR_STATE when
// called in any non-READING state.
//
// =============================================================================
// SECTION 3  RETURN CODE BAND
// =============================================================================
//
//   RL_OK                  = 0
//   RL_ERR_BAD_SESSION     = reuse SS_ERR_BAD_ID = 0x1102
//   RL_ERR_LINE_OVERFLOW   = 0x3000
//   RL_ERR_STATE           = 0x3001
//
// Band audit (2026-10-14):
//   grep -rnE '0x300[0-1]\b' src/kernel/ -> xhci configure_ep.pdx uses
// these as hardware register values (TRB Type << 10), NOT as return
// codes. Disjoint namespace. Clean band; R229.M2+ may extend to
// 0x3002..0x300F while retaining the first two as pinned.
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the 7-byte
// zero-extending form.
//
// _rl_tick returns a PACKED u64:
//
//     result = (new_state << 32) | status
//
// On success status == RL_OK (0), so result == new_state << 32 and
// the caller recovers new_state by right-shifting 32 bits. new_state
// is in [0, 7), so new_state << 32 is in [0, 7 << 32) -- disjoint
// from every RL_ERR_* value so a caller that treats the whole u64 as
// an error-or-state tagged value never collides.
//
// _rl_init_session and _rl_emit_prompt return RL_OK or RL_ERR_* code
// directly (not packed).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Labels are prefixed `rl_` (repl-loop) to stay clear of `ss_` (shell_
// session), `sh_` (shell_history), `sj_` (shell_jobs), `hf_` (history_
// facts), `cr_` (cmd_registry), and the broader `s_` family. Encoder-
// pitfall posture (feedback_pdx_encoder_pitfalls):
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 7 to compose row-base * 128 stride (never `imul r, imm`)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * single-line `pub let name = "..."`
//   * module basename ReplLoop matches file basename repl_loop.pdx
//   * fingerprint `[u8; N]` with N = string length + 1 (NUL counts)
//
// Stack discipline (SysV, entry rsp%16==8):
//   _rl_init               1 push  (r12 across klog_s1)
//   _rl_init_session       2 pushes + sub rsp, 8 (klog_s1_x1 slot)
//   _rl_tick               5 pushes (rbx, r12, r13, r14, r15)
//   _rl_emit_prompt        2 pushes + sub rsp, 8 (klog_s1_x1 slot)
//
// =============================================================================

module ReplLoop = structure {

  // ==========================================================================
  // Return band (§3)
  // ==========================================================================

  pub let RL_OK                : u64 = 0
  pub let RL_ERR_BAD_SESSION   : u64 = 0x1102    // alias SS_ERR_BAD_ID
  pub let RL_ERR_LINE_OVERFLOW : u64 = 0x3000
  pub let RL_ERR_STATE         : u64 = 0x3001

  // ==========================================================================
  // Pool geometry (§1)
  // ==========================================================================

  pub let RL_POOL_MAX     : u64 = 8     // rows (sessions)
  pub let RL_ROW_BYTES    : u64 = 128   // 16 u64 per row
  pub let RL_LINE_MAX     : u64 = 112   // bytes in line_buf

  // Row-field offsets (bytes, from row base)
  pub let RL_OFF_STATE    : u64 = 0
  pub let RL_OFF_HEAD     : u64 = 4
  pub let RL_OFF_LINE_BUF : u64 = 8
  pub let RL_OFF_RESERVED : u64 = 120

  // State machine (§2)
  pub let RL_STATE_PROMPT     : u64 = 0
  pub let RL_STATE_READING    : u64 = 1
  pub let RL_STATE_PARSED     : u64 = 2
  pub let RL_STATE_EVAL       : u64 = 3
  pub let RL_STATE_WRITING    : u64 = 4
  pub let RL_STATE_IDLE       : u64 = 5
  pub let RL_STATE_TERMINATED : u64 = 6
  pub let RL_STATE_MAX        : u64 = 7   // exclusive upper bound

  // ==========================================================================
  // Storage
  //
  //   _rl_pool  -- 8 rows x 128 bytes = 128 u64. @align(64) puts the
  //                pool start on a cache-line boundary.
  //   _rl_stats -- 16 u64 counters (observability).
  // ==========================================================================

  pub let mut _rl_pool  : [u64; 128] = uninit @align(64)
  pub let mut _rl_stats : [u64; 16]  = uninit @align(64)

  pub let RL_ST_INIT_OK          : u64 = 0
  pub let RL_ST_INIT_SESSION_OK  : u64 = 1
  pub let RL_ST_INIT_SESSION_REJ : u64 = 2
  pub let RL_ST_TICK_BYTE        : u64 = 3   // every accepted byte (hot)
  pub let RL_ST_TICK_PARSED      : u64 = 4   // READING -> PARSED transitions
  pub let RL_ST_TICK_OVERFLOW    : u64 = 5   // line-overflow trips
  pub let RL_ST_TICK_BAD_STATE   : u64 = 6   // tick in non-READING
  pub let RL_ST_TICK_BAD_SESSION : u64 = 7   // tick on invalid session
  pub let RL_ST_EMIT_PROMPT_OK   : u64 = 8
  pub let RL_ST_EMIT_PROMPT_REJ  : u64 = 9
  // slots 10..15 reserved for R229.M2+ eval-dispatch counters

  // ==========================================================================
  // Fingerprint tags (N = len(string) + 1, NUL-inclusive)
  //
  // Only the "OK" tags are extracted by the fingerprint-coverage gate
  // (regex matches bare word OK); the REJ tags are opaque to the gate
  // so no allowlist entry is required for them.
  // ==========================================================================

  // "REPL_LOOP INIT OK"            = 17 chars + NUL => N = 18
  // "REPL_LOOP INIT_SESSION OK"    = 25 chars + NUL => N = 26
  // "REPL_LOOP INIT_SESSION REJ"   = 26 chars + NUL => N = 27
  // "REPL_LOOP TICK OK"            = 17 chars + NUL => N = 18
  // "REPL_LOOP TICK REJ"           = 18 chars + NUL => N = 19
  // "REPL_LOOP EMIT_PROMPT OK"     = 24 chars + NUL => N = 25
  // "REPL_LOOP EMIT_PROMPT REJ"    = 25 chars + NUL => N = 26

  pub let rl_tag_init_ok          : [u8; 18] = "REPL_LOOP INIT OK\0"
  pub let rl_tag_init_session_ok  : [u8; 26] = "REPL_LOOP INIT_SESSION OK\0"
  pub let rl_tag_init_session_rej : [u8; 27] = "REPL_LOOP INIT_SESSION REJ\0"
  pub let rl_tag_tick_ok          : [u8; 18] = "REPL_LOOP TICK OK\0"
  pub let rl_tag_tick_rej         : [u8; 19] = "REPL_LOOP TICK REJ\0"
  pub let rl_tag_emit_prompt_ok   : [u8; 25] = "REPL_LOOP EMIT_PROMPT OK\0"
  pub let rl_tag_emit_prompt_rej  : [u8; 26] = "REPL_LOOP EMIT_PROMPT REJ\0"

  pub let rl_k_sid    : [u8; 4] = "sid\0"
  pub let rl_k_state  : [u8; 6] = "state\0"
  pub let rl_k_errno  : [u8; 6] = "errno\0"

  // ==========================================================================
  // rl_note(slot) -> ()
  //
  // Bounded increment on _rl_stats[slot]. Load-inc-store idiom (no
  // `add reg, [mem]`). Caller passes an RL_ST_* ordinal; the bounds
  // check guards against the stats pool size (16). Pure leaf -- no
  // pushes.
  // ==========================================================================
  pub let rl_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M1 (paideia-os #2719): bounded increment on _rl_stats[slot<16]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed rl_no_.",
      block: {
        cmp rdi, 16;
        jae rl_no_out;
        lea r10, [rip + _rl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      rl_no_out:
        ret
      }
    }

  // ==========================================================================
  // rl_row_base(session_id) -> &_rl_pool[session_id * 128]
  //
  // Row index -> row base pointer. Stride 128 = 2^7 so `shl rax, 7`
  // suffices (no `imul r, imm` encoder gap). Caller is responsible
  // for validating session_id < RL_POOL_MAX = 8 first; this helper
  // is a pure address compute.
  // ==========================================================================
  pub let rl_row_base : (u64) -> u64 !{} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R229.M1 (paideia-os #2719): session_id -> &_rl_pool[session_id*128]. Power-of-two stride uses `shl rax, 7` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates via ss_row_in_use. Pure leaf. Labels prefixed rl_rb_.",
      block: {
        mov rax, rdi;                    // session_id
        shl rax, 7;                      // session_id * 128
        lea r10, [rip + _rl_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // _rl_init() -> ()
  //
  // Boot hook. Defensive scrub of _rl_stats (16 u64 = 128 bytes).
  // .bss zero-init handles the array at real boot; the explicit scrub
  // is defensive for a chaos-restart re-entering init. Emits
  // `REPL_LOOP INIT OK` on completion.
  //
  // _rl_pool is NOT scrubbed (1 KiB zero-fill is wasted work; a REPL
  // row is live only once _rl_init_session rewrites it, and bss is
  // already zero at real boot).
  //
  // Single callee-save push (r12) corrects entry parity rsp%16==8 ->
  // 0 for the sibling klog_s1 call, matching _shell_history_init /
  // _hf_init shape.
  //
  // Labels prefixed rl_in_.
  // ==========================================================================
  pub let _rl_init : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R229.M1 (paideia-os #2719): boot-time scrub of _rl_stats (16 u64 = 128 bytes) + one INIT OK fingerprint. .bss zero-init handles the array at real boot; the explicit scrub is defensive for a chaos-restart re-entering init. _rl_pool (1 KiB) is NOT scrubbed because a REPL row is live only once _rl_init_session has rewritten every field; bss is already zero at real boot. Single callee-save push (r12) corrects entry parity rsp%16==8 -> 0 for the sibling klog_s1 call, matching _shell_history_init / _hf_init shape. Labels prefixed rl_in_.",
      block: {
        push r12;

        // Scrub _rl_stats[0..16].
        lea r10, [rip + _rl_stats];
        xor rax, rax;
        xor rcx, rcx;
      rl_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  rl_in_stats;

        // Bump INIT_OK counter.
        mov rdi, 0;                      // RL_ST_INIT_OK
        call rl_note;

        // Emit INIT OK fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_init_ok];
        call klog_s1;

        pop r12;
        ret
      }
    }

  // ==========================================================================
  // _rl_init_session(session_id) -> errno
  //
  // Attach a REPL state slot to the shell_session row. Validates
  // session_id via ss_row_in_use (R127.M1). On a live session row:
  //   * state         <- RL_STATE_PROMPT (0)
  //   * line_buf_head <- 0  (both bundled as a single u64 store at [+0])
  //   * line_buf[0..112] <- 0  (14 u64 stores)
  //   * reserved      <- 0  (u64 store at [+120])
  //
  // ARGS (SysV):
  //   rdi = session_id
  //
  // RETURNS (rax):
  //   RL_OK                -- row attached
  //   RL_ERR_BAD_SESSION   -- session_id out of range or row free
  //
  // STACK FRAME:
  //   2 callee-save pushes (rbx = session_id, r12 = row_base) + sub rsp, 8
  //   HELD THROUGHOUT the body. Entry rsp%16==8; +2 pushes = +16 ->
  //   rsp%16==8; sub rsp,8 = +24 -> rsp%16==0 at every nested call.
  //   Trailing `add rsp, 8` restores before the two pops.
  //
  // Labels prefixed rl_is_.
  // ==========================================================================
  pub let _rl_init_session : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R229.M1 (paideia-os #2719): attach a REPL state slot to the shell_session row. Validate session_id via ss_row_in_use (else RL_ERR_BAD_SESSION = SS_ERR_BAD_ID = 0x1102). On live row: compute row_base (pool + sid<<7), store 0 at [row+0] (which zeroes BOTH state (lo32 = RL_STATE_PROMPT = 0) and line_buf_head (hi32 = 0) in a single aligned u64 write), zero 14 u64 at [row+8..row+120] (the 112-byte line_buf), zero the u64 at [row+120] (reserved). Bump RL_ST_INIT_SESSION_OK (slot 1), emit `REPL_LOOP INIT_SESSION OK sid=0x<hex>` via klog_s1_x1. Two callee-save pushes (rbx=session_id, r12=row_base) + sub rsp,8 (HELD throughout the body: lands rsp%16==0 at every nested call AND reserves the stack-arg slot for a future klog_s1_x1_d1 upgrade). Encoder-pitfall posture: cmp rN,0 (never test), shl rN,7 for stride-128 (never imul), mov rax,imm32 for the error code (never and r11,imm64). Labels prefixed rl_is_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;                      // alignment + stack-arg slot

        mov rbx, rdi;                    // session_id

        // ---- Validate session_id ----
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  rl_is_bad_id;

        // ---- Compute row base ----
        //   row_base = pool + session_id << 7
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _rl_pool];
        add rax, r10;                    // rax = row base
        mov r12, rax;                    // r12 = row_base

        // ---- Zero state + line_buf_head (single u64 store at [+0]) ----
        //   state = RL_STATE_PROMPT (0) in low 32
        //   line_buf_head = 0 in high 32
        xor r9, r9;
        mov [r12 + 0], r9;

        // ---- Zero line_buf[0..112] via 14 u64 stores at [+8..+120) ----
        //   8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112
        mov [r12 + 8],   r9;
        mov [r12 + 16],  r9;
        mov [r12 + 24],  r9;
        mov [r12 + 32],  r9;
        mov [r12 + 40],  r9;
        mov [r12 + 48],  r9;
        mov [r12 + 56],  r9;
        mov [r12 + 64],  r9;
        mov [r12 + 72],  r9;
        mov [r12 + 80],  r9;
        mov [r12 + 88],  r9;
        mov [r12 + 96],  r9;
        mov [r12 + 104], r9;
        mov [r12 + 112], r9;

        // ---- Zero reserved u64 at [+120] ----
        mov [r12 + 120], r9;

        // ---- Stats + fingerprint ----
        mov rdi, 1;                      // RL_ST_INIT_SESSION_OK
        call rl_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_init_session_ok];
        lea rcx, [rip + rl_k_sid];
        mov r8,  rbx;                    // v_hex = session_id
        call klog_s1_x1;

        xor rax, rax;                    // RL_OK
        jmp rl_is_out;

      rl_is_bad_id:
        mov rdi, 2;                      // RL_ST_INIT_SESSION_REJ
        call rl_note;

        mov r12, 0x1102;                 // RL_ERR_BAD_SESSION

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_init_session_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;

      rl_is_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _rl_tick(session_id, input_byte) -> packed u64
  //
  // Feed one input byte to the state machine. The caller is the TTY
  // input ISR (R128+ deferred wire-up).
  //
  // ARGS (SysV):
  //   rdi = session_id
  //   rsi = input_byte  (low 8 bits meaningful; high bits ignored)
  //
  // RETURNS (rax, packed):
  //   result = (new_state << 32) | status
  //
  //     OK path (byte accepted, stay in READING):
  //       (RL_STATE_READING << 32) | RL_OK
  //       (no fingerprint emitted; stats bump only -- ISR hot path)
  //
  //     OK path (byte 0x0A seen, transition READING -> PARSED):
  //       (RL_STATE_PARSED << 32) | RL_OK
  //       fingerprint: `REPL_LOOP TICK OK sid=... state=0x02`
  //
  //     ERR path (line_buf full, head==112):
  //       (RL_STATE_IDLE << 32) | RL_ERR_LINE_OVERFLOW
  //       fingerprint: `REPL_LOOP TICK REJ sid=... errno=0x3000`
  //
  //     ERR path (tick in non-READING state):
  //       (current_state << 32) | RL_ERR_STATE
  //       fingerprint: `REPL_LOOP TICK REJ sid=... errno=0x3001`
  //
  //     ERR path (invalid session):
  //       (0 << 32) | RL_ERR_BAD_SESSION
  //       fingerprint: `REPL_LOOP TICK REJ sid=... errno=0x1102`
  //
  // STACK FRAME:
  //   5 callee-save pushes (rbx = session_id, r12 = input_byte,
  //   r13 = row_base, r14 = state_and_head_scratch, r15 = return_state).
  //   Entry rsp%16==8; +5 pushes = +40 -> %16==0 at every nested call.
  //   No sub rsp -- the hot path never calls klog, and the cold paths
  //   call klog_s1_x1 (6-reg wrapper, no stack arg).
  //
  // Labels prefixed rl_tk_.
  // ==========================================================================
  pub let _rl_tick : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (input_byte: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R229.M1 (paideia-os #2719): feed one byte to the state machine. Validate session_id via ss_row_in_use (else RL_ERR_BAD_SESSION, state=0 in packed hi32). Compute row_base = pool + sid<<7. Load u64 at [row+0]: state in low 32, line_buf_head in high 32. If state != RL_STATE_READING: emit TICK REJ (errno=0x3001), return (state<<32)|RL_ERR_STATE. If head == 112: transition state to IDLE via u64 store at [row+0] (preserves head for diagnostic), emit TICK REJ (errno=0x3000), return (IDLE<<32)|RL_ERR_LINE_OVERFLOW. Else: write input_byte at [row+8+head] via mov_b scalar-indexed form, head += 1, store packed (head<<32)|state back at [row+0], bump RL_ST_TICK_BYTE (slot 3). If input_byte == 0x0A (LF): transition state to PARSED, store packed (head<<32)|PARSED at [row+0], bump RL_ST_TICK_PARSED (slot 4), emit `REPL_LOOP TICK OK sid=0x<hex> state=0x<hex>`, return (PARSED<<32)|RL_OK. Else: return (READING<<32)|RL_OK with no fingerprint (ISR hot path). Five callee-save pushes (rbx=session_id, r12=input_byte, r13=row_base, r14=packed state+head scratch, r15=return state) land rsp%16==0 at every nested call; no sub rsp because the hot path avoids klog and the cold paths all call klog_s1_x1 (6-reg no-stack-arg wrapper). Encoder-pitfall posture: cmp rN,0 (never test), shl rN,7 for stride-128 (never imul), mov rax,imm32 for all return codes (never and r11,imm64), mov_b [reg+reg*1],reg for the single byte-write (proven in svc/shell_session.pdx name-copy), shift-anchor via shr rN,32 / shl rN,32 to isolate halves of the packed state+head u64. Labels prefixed rl_tk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // session_id
        mov r12, rsi;                    // input_byte

        // ---- Validate session_id ----
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  rl_tk_bad_sid;

        // ---- Compute row base ----
        //   row_base = pool + session_id << 7
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _rl_pool];
        add rax, r10;                    // rax = row base
        mov r13, rax;                    // r13 = row_base

        // ---- Load packed state(lo32) + head(hi32) from [row+0] ----
        mov r14, [r13 + 0];

        // Extract state into r15 (low 32 bits).  Use shift-anchor
        // (shl 32; shr 32) to avoid `and r,imm64`.
        mov r15, r14;
        shl r15, 32;
        shr r15, 32;                     // r15 = state (0..6)

        // state != RL_STATE_READING (1) -> RL_ERR_STATE path.
        cmp r15, 1;
        jne rl_tk_bad_state;

        // Extract head (high 32 bits) into r10.
        mov r10, r14;
        shr r10, 32;                     // r10 = head (0..112)

        // head >= RL_LINE_MAX (112) -> overflow path.
        cmp r10, 112;
        jae rl_tk_overflow;

        // ---- Byte accepted: write line_buf[head] = input_byte ----
        //   addr = row_base + 8 + head
        //   Supported byte-write forms are `[reg + reg*1]` and
        //   `[reg + off]`; the shell_session name-copy uses the former
        //   with a pre-advanced base pointer to avoid the imm
        //   displacement, so we mirror that here: pre-advance r13 by 8
        //   and index with r10.  The pre-advance is temporary; we
        //   subtract it back before the packed state-write.
        add r13, 8;                      // r13 = &row.line_buf[0]
        mov_b [r13 + r10 * 1], r12;      // line_buf[head] = input_byte
        sub r13, 8;                      // restore r13 = row_base

        // ---- head += 1 ----
        add r10, 1;

        // ---- Was this byte an LF (0x0A)?  Isolate low 8 of input_byte
        //      via shift-anchor (shl 56; shr 56) to avoid imm32 AND. ----
        mov r11, r12;
        shl r11, 56;
        shr r11, 56;                     // r11 = input_byte & 0xFF

        // ---- Compose packed (head << 32) | next_state and store BEFORE
        //      any rl_note / klog call (which would clobber r10). ----
        mov r14, r10;                    // r14 = head (in high 32 after shift)
        shl r14, 32;                     // r14 = head << 32

        cmp r11, 10;                     // 0x0A = LF
        je  rl_tk_parsed;

        // ---- Still READING: low 32 = RL_STATE_READING (1), store, bump ----
        or  r14, 1;
        mov [r13 + 0], r14;

        // Bump TICK_BYTE counter (hot-path observability).  rl_note
        // clobbers r10/r11 but we no longer need them.
        mov rdi, 3;                      // RL_ST_TICK_BYTE
        call rl_note;

        // Return (READING << 32) | RL_OK.  RL_OK = 0.
        mov rax, 1;
        shl rax, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rl_tk_parsed:
        // ---- Transition READING -> PARSED: low 32 = PARSED (2), store ----
        or  r14, 2;
        mov [r13 + 0], r14;

        // Bump TICK_BYTE (every accepted byte, LF included) and
        // TICK_PARSED counters.  rl_note clobbers r10/r11.
        mov rdi, 3;                      // RL_ST_TICK_BYTE
        call rl_note;
        mov rdi, 4;                      // RL_ST_TICK_PARSED
        call rl_note;

        // Emit `REPL_LOOP TICK OK sid=0x<hex> state=0x<hex>`.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_tick_ok];
        lea rcx, [rip + rl_k_sid];
        mov r8,  rbx;                    // v_hex = session_id
        call klog_s1_x1;

        // Return (PARSED << 32) | RL_OK.
        mov rax, 2;
        shl rax, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rl_tk_overflow:
        // ---- head == 112: trip to IDLE, return LINE_OVERFLOW ----
        //   Preserve head in the row (diagnostic); store packed
        //   (head<<32) | IDLE(5).
        mov r14, r10;                    // r14 = head (==112)
        shl r14, 32;
        or  r14, 5;                      // low 32 = RL_STATE_IDLE
        mov [r13 + 0], r14;

        // Bump TICK_OVERFLOW counter.
        mov rdi, 5;                      // RL_ST_TICK_OVERFLOW
        call rl_note;

        // Emit `REPL_LOOP TICK REJ sid=0x<hex> errno=0x<hex>`.
        mov r15, 0x3000;                 // RL_ERR_LINE_OVERFLOW
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_tick_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  r15;
        call klog_s1_x1;

        // Return (IDLE << 32) | RL_ERR_LINE_OVERFLOW.
        mov rax, 5;
        shl rax, 32;
        or  rax, 0x3000;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rl_tk_bad_state:
        // ---- tick in non-READING: return RL_ERR_STATE (state unchanged) ----
        //   r15 already holds the current state ordinal.
        //   Bump TICK_BAD_STATE counter.
        mov rdi, 6;                      // RL_ST_TICK_BAD_STATE
        call rl_note;

        // Emit `REPL_LOOP TICK REJ sid=0x<hex> errno=0x<hex>`.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_tick_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  0x3001;                 // RL_ERR_STATE
        call klog_s1_x1;

        // Return (current_state << 32) | RL_ERR_STATE.
        mov rax, r15;
        shl rax, 32;
        or  rax, 0x3001;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rl_tk_bad_sid:
        // ---- Invalid session: return (0 << 32) | RL_ERR_BAD_SESSION ----
        mov rdi, 7;                      // RL_ST_TICK_BAD_SESSION
        call rl_note;

        // Emit `REPL_LOOP TICK REJ errno=0x<hex>`.  klog_s1_x1 only
        // prints one KV; the errno uniquely identifies the rejection
        // class (0x1102 BAD_SESSION / 0x3000 OVERFLOW / 0x3001 STATE).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_tick_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  0x1102;                 // RL_ERR_BAD_SESSION
        call klog_s1_x1;

        mov rax, 0x1102;                 // RL_ERR_BAD_SESSION, state=0
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _rl_emit_prompt(session_id) -> errno
  //
  // Signal that the prompt has been emitted (or should be emitted at
  // M2+).  Validates session_id via ss_row_in_use.  On a live row:
  //
  //   state == PROMPT or state == IDLE:
  //     line_buf_head <- 0 (fresh line)
  //     state         <- RL_STATE_READING (1)
  //     emit EMIT_PROMPT OK; return RL_OK.
  //
  //   otherwise:
  //     emit EMIT_PROMPT REJ errno=0x3001; return RL_ERR_STATE.
  //
  // ARGS (SysV):
  //   rdi = session_id
  //
  // RETURNS (rax):
  //   RL_OK                -- state advanced to READING
  //   RL_ERR_BAD_SESSION   -- session_id out of range or row free
  //   RL_ERR_STATE         -- current state is not PROMPT or IDLE
  //
  // STACK FRAME:
  //   2 callee-save pushes (rbx = session_id, r12 = scratch) + sub rsp, 8
  //   HELD THROUGHOUT the body. Entry rsp%16==8; +2 pushes + 8 = +24
  //   -> rsp%16==0 at every nested call. Trailing `add rsp, 8` before
  //   the two pops.
  //
  // Labels prefixed rl_ep_.
  // ==========================================================================
  pub let _rl_emit_prompt : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R229.M1 (paideia-os #2719): advance a REPL row from PROMPT or IDLE to READING, clearing line_buf_head. Validate session_id via ss_row_in_use (else RL_ERR_BAD_SESSION). Compute row_base = pool + sid<<7. Load u64 at [row+0]: state in low 32, head in high 32. Extract state via shift-anchor (shl 32; shr 32). If state != 0 (PROMPT) AND state != 5 (IDLE): emit REJ (errno=0x3001), return RL_ERR_STATE. Else: store packed value (0 head << 32) | RL_STATE_READING (= 1) at [row+0]; this clears head to 0 AND sets state to READING in one aligned u64 store. Bump RL_ST_EMIT_PROMPT_OK (slot 8), emit `REPL_LOOP EMIT_PROMPT OK sid=0x<hex>` via klog_s1_x1. Note: the actual TTY byte-write for the prompt string is deferred to R229.M2+ (which adds the tty_write hook); M1 is pure state-machine substrate. Two callee-save pushes (rbx=session_id, r12=scratch) + sub rsp,8 (HELD throughout the body: lands rsp%16==0 at every nested call AND reserves a stack-arg slot for a future klog_s1_x1_d1 upgrade). Encoder-pitfall posture: cmp rN,0 (never test), shl rN,7 for stride-128 (never imul), mov rax,imm32 for all return codes (never and r11,imm64), shift-anchor to isolate state from head. Labels prefixed rl_ep_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;                      // alignment + stack-arg slot

        mov rbx, rdi;                    // session_id

        // ---- Validate session_id ----
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  rl_ep_bad_sid;

        // ---- Compute row base ----
        //   row_base = pool + session_id << 7
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _rl_pool];
        add rax, r10;                    // rax = row base
        mov r12, rax;                    // r12 = row_base

        // ---- Extract current state (low 32 of [row+0]) via shift-anchor ----
        mov r11, [r12 + 0];
        shl r11, 32;
        shr r11, 32;                     // r11 = state

        // state must be PROMPT (0) or IDLE (5).
        cmp r11, 0;
        je  rl_ep_ok_path;
        cmp r11, 5;
        je  rl_ep_ok_path;
        jmp rl_ep_bad_state;

      rl_ep_ok_path:
        // ---- Store packed (0 << 32) | RL_STATE_READING (1) at [row+0] ----
        //   This clears head to 0 AND sets state to READING in one
        //   aligned u64 store.
        mov r9, 1;                       // RL_STATE_READING
        mov [r12 + 0], r9;

        // ---- Stats + fingerprint ----
        mov rdi, 8;                      // RL_ST_EMIT_PROMPT_OK
        call rl_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_emit_prompt_ok];
        lea rcx, [rip + rl_k_sid];
        mov r8,  rbx;                    // v_hex = session_id
        call klog_s1_x1;

        xor rax, rax;                    // RL_OK
        jmp rl_ep_out;

      rl_ep_bad_state:
        mov rdi, 9;                      // RL_ST_EMIT_PROMPT_REJ
        call rl_note;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_emit_prompt_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  0x3001;                 // RL_ERR_STATE
        call klog_s1_x1;

        mov rax, 0x3001;                 // RL_ERR_STATE
        jmp rl_ep_out;

      rl_ep_bad_sid:
        mov rdi, 9;                      // RL_ST_EMIT_PROMPT_REJ
        call rl_note;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + rl_tag_emit_prompt_rej];
        lea rcx, [rip + rl_k_errno];
        mov r8,  0x1102;                 // RL_ERR_BAD_SESSION
        call klog_s1_x1;

        mov rax, 0x1102;                 // RL_ERR_BAD_SESSION

      rl_ep_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

}
