// src/kernel/core/shell/cmd_registry_parser.pdx -- UMB-W4 R123.M2 (paideia-os #2586)
//
// On-disk command-registry parser. Consumes a TOML subset at
// `/system/shell/commands.toml` at boot and drives KIND_CMD_MODULE
// (0x5C) row allocation via cmd_module_open from
// src/kernel/core/cap/kind_cmd_module.pdx (UMB-W1 R123.M1, Wave 87).
//
// =============================================================================
// SECTION 0  SCOPE
// =============================================================================
//
// This file is the SUBSTRATE-FACING parser. It owns:
//
//   (a) a 4 KiB file-read buffer (_crp_load_buf) that _cmd_registry_
//       load_boot fills from the VFS at a well-known path, and
//
//   (b) the TOML-subset single-pass byte scanner (_cmd_registry_parse)
//       that converts those bytes into cmd_module_open calls.
//
// The parser is DISTINCT from src/kernel/core/shell/cmd_registry.pdx's
// cr_parse_toml (R123.M2 of the earlier #2504 landing). That file
// populates the LRU LOOKUP CACHE (_cmd_registry_table, 256 rows) and
// scans for the array-of-tables `[[commands]]` header. THIS file:
//
//   * targets the capability substrate (KIND_CMD_MODULE row pool, 8
//     rows), NOT the LRU cache;
//   * recognises `[command.NAME]` dotted-table headers (not the array-
//     of-tables `[[commands]]` form), matching the shape in
//     design/userspace/semantic-shell-materialization-plan.md R123
//     §On-disk registry layout;
//   * exposes a 4-code failure taxonomy (CRP_ERR_BAD_SYNTAX /
//     CRP_ERR_TOO_MANY_ROWS / CRP_ERR_READ / CRP_ERR_NO_FILE) with the
//     byte offset packed into bits 32..63 of CRP_ERR_BAD_SYNTAX for
//     operator diagnosis.
//
// A later M* (R123.M3+) will unify or retire the earlier LRU cache
// once the substrate rows carry enough metadata (functor id + capability
// label + schema digests) to serve lookup directly. At today's wave the
// two coexist with disjoint responsibilities: the LRU cache answers
// shell dispatch lookups, the substrate rows anchor the capability
// side (close + list + handler-fan-out through kind_cmd_module.pdx's
// cap_handler_cmd_module).
//
// =============================================================================
// SECTION 1  TOML SUBSET GRAMMAR
// =============================================================================
//
// Accepted shape, per line (line = run of bytes ending in LF 0x0A or
// buffer end):
//
//   LINE          := BLANK | COMMENT | SECTION | KEYVAL
//   BLANK         := WS* LF?
//   COMMENT       := WS* '#' .* LF?
//   SECTION       := WS* '[' 'c' 'o' 'm' 'm' 'a' 'n' 'd' '.' NAME ']' WS* COMMENT? LF?
//   KEYVAL        := WS* IDENT WS* '=' WS* '"' VALUE '"' WS* COMMENT? LF?
//
//   WS            := SP (0x20) | HT (0x09) | CR (0x0D)
//   IDENT         := [A-Za-z_] [A-Za-z0-9_]*
//   NAME          := [A-Za-z0-9_]+        (1..CRP_NAME_MAX bytes = 64)
//   VALUE         := any byte except '"' (0x22) and LF (0x0A)
//
// Expected keys in each `[command.NAME]` block (not enforced at this
// landing; the parser consumes but does not bind):
//
//   functor      = "pdx.builtin.<name>"
//   capability   = "<domain>.<verb>"       e.g. fs.read
//
// Exact example the parser must accept:
//
//     [command.ls]
//     functor = "pdx.builtin.ls"
//     capability = "fs.read"
//
//     [command.cat]
//     functor = "pdx.builtin.cat"
//     capability = "fs.read"
//
// Semantic action per SECTION: call cmd_module_open(name_ptr, name_len)
// to allocate a KIND_CMD_MODULE row for NAME. Return codes from
// cmd_module_open fold into the parser's return as:
//
//   handle in [0, CM_MODULE_MAX)        -> continue, row count += 1
//   CM_ALREADY_LOADED (0xFFFFFCC5)      -> continue (idempotent dedup)
//   CM_BAD_NAME       (0xFFFFFCC1)      -> CRP_ERR_BAD_SYNTAX with
//                                          offset of the name byte
//   CM_MODULE_FULL    (0xFFFFFCC2)      -> CRP_ERR_TOO_MANY_ROWS
//
// Semantic action per KEYVAL: validate shape, DISCARD value. The functor
// + capability bindings land in R123.M3 (in-process invoke) once the
// row shape carries functor_id + cap-env fields.
//
// =============================================================================
// SECTION 2  ERROR TAXONOMY
// =============================================================================
//
// Five return codes, all occupying imm32 (zero-extend to u64 via the
// `mov rax, imm32` 7-byte emit, same posture as kind_cmd_module.pdx
// §5):
//
//   CRP_OK                = 0x0000
//   CRP_ERR_BAD_SYNTAX    = 0x0C01   (bits 32..63 pack byte offset)
//   CRP_ERR_TOO_MANY_ROWS = 0x0C02   (cmd_module_open returned
//                                     CM_MODULE_FULL -- the pool is
//                                     exhausted)
//   CRP_ERR_READ          = 0x0C03   (vfs_read returned the error
//                                     sentinel 0xFFFFFFFFFFFFFFFF)
//   CRP_ERR_NO_FILE       = 0x0C04   (vfs_open returned 0 -- file
//                                     absent. NON-FATAL at boot: the
//                                     caller continues with an empty
//                                     registry. The code exists so a
//                                     witness or hot-reload call site
//                                     can distinguish "no file" from
//                                     "empty file".)
//   CRP_ERR_RELOAD_BUSY   = 0x0C05   (R123.M6 UMB-W8 paideia-os #2590:
//                                     another reload is already inside
//                                     the critical section guarded by
//                                     _crp_reload_in_flight. The racing
//                                     caller returns immediately
//                                     WITHOUT touching the KCM pool;
//                                     the holder continues to
//                                     completion.)
//
// Byte-offset packing for CRP_ERR_BAD_SYNTAX:
//
//   bits [15:0]    = 0x0C01
//   bits [31:16]   = 0 (reserved)
//   bits [63:32]   = byte_offset (u32) of the first bad byte in the
//                     buffer passed to _cmd_registry_parse. Allows an
//                     operator to grep the registry file at that offset.
//
// =============================================================================
// SECTION 3  BOOT POSTURE
// =============================================================================
//
// _cmd_registry_load_boot is called from kernel_main.pdx AFTER
// _mb_init (microbench site registry up so cap_invoke microbench site
// sees registrations) and BEFORE x2apic_probe_bsp (so the LAPIC-mode
// probe does not block registry population under a long parse).
//
// At today's boot order the VFS is NOT YET up at this slot
// (witness_r16_vfs lands much later in the cascade). _cmd_registry_
// load_boot therefore expects vfs_open to return 0 at first boot, and
// returns CRP_ERR_NO_FILE WITHOUT populating any row. A later landing
// moves the call behind witness_r16_vfs (or re-invokes it there) once
// the FS is up. The CRP_ERR_NO_FILE path is drained to a klog warning
// in the caller; boot continues.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Every constant 0x0C01..0x0C04 fits imm32 (bit 31 clear); every compare
// against them is a direct `cmp rax, 0x0C0N`. The buffer-cap constant
// 4096 fits imm32; so does CRP_MAX_ROWS=8 and CRP_NAME_MAX=64. Byte
// loads use `mov_b rN, [rbx + rcx*1]` with a pre-zero of rN (encoder
// does not zero-extend on its own, per pipe_backend.pdx §57). Zero
// checks use `cmp rN, 0` (never `test rN, rN`). Masked compares stage
// through r10/r11 reg-reg (never `and r11, imm64`). All `pub let`
// string declarations are single-line. Module basename
// `CmdRegistryParser` matches the file basename
// `cmd_registry_parser.pdx`. Every label in this file is prefixed
// `crp_` (reserved-word discipline -- `loop`/`if`/`let` are keywords;
// `crp_` keeps us well clear).
//
// klog_s1_x1 slot convention: the key sits in rcx and the value in r8;
// no stack arg. klog_s1_x2 slot convention: key1 rcx, value1 r8,
// key2 r9, value2 at caller `[rsp+0]` after `sub rsp,16`. This file
// uses only klog_s1 (handler-entry chatter) and klog_s1_x2 (final
// `CMDREG TOML LOADED rows=... err=...` fingerprint).
//
// =============================================================================

module CmdRegistryParser = structure {

  // ==========================================================================
  // SECTION 5  CONSTANTS
  // ==========================================================================

  // Return codes (§2).
  pub let CRP_OK                : u64 = 0
  pub let CRP_ERR_BAD_SYNTAX    : u64 = 0x0C01
  pub let CRP_ERR_TOO_MANY_ROWS : u64 = 0x0C02
  pub let CRP_ERR_READ          : u64 = 0x0C03
  pub let CRP_ERR_NO_FILE       : u64 = 0x0C04
  // R123.M6 UMB-W8 (paideia-os #2590) adds the hot-reload busy
  // sentinel. Returned by _cmd_registry_reload when another CPU (or a
  // re-entrant call on this CPU) is already inside the reload critical
  // section guarded by _crp_reload_in_flight. Fits imm32 (bit 31 clear)
  // so `mov rax, 0x0C05` is a 7-byte encode same as its siblings above.
  pub let CRP_ERR_RELOAD_BUSY   : u64 = 0x0C05

  // Ceilings.
  pub let CRP_MAX_ROWS : u64 = 8     // mirrors kind_cmd_module CM_MODULE_MAX
  pub let CRP_BUF_CAP  : u64 = 4096  // _crp_load_buf capacity
  pub let CRP_NAME_MAX : u64 = 64    // mirrors kind_cmd_module CM_NAME_MAX

  // Known kind_cmd_module.cmd_module_open sentinels (local copies so
  // this module can fold them without pulling the KindCmdModule
  // namespace into every call site).
  pub let CRP_CM_BAD_NAME       : u64 = 0xFFFFFCC1
  pub let CRP_CM_MODULE_FULL    : u64 = 0xFFFFFCC2
  pub let CRP_CM_ALREADY_LOADED : u64 = 0xFFFFFCC5

  // VFS read-error sentinel.
  pub let CRP_VFS_READ_ERR : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 6  STATE
  // ==========================================================================

  // File-read scratch. 4 KiB holds ~20-40 command definitions at
  // 100-200 bytes each (the typical shape of commands.toml at this
  // phase). Overflow is silent at R123.M2: the parser scans only the
  // first CRP_BUF_CAP bytes read.
  pub let mut _crp_load_buf : [u8; 4096] = uninit @align(64)

  // Observability counters:
  //   [0] CRP_ST_PARSE_OK   -- successful parse calls
  //   [1] CRP_ST_LOAD_OK    -- successful boot-load calls
  //   [2] CRP_ST_NO_FILE    -- boot-load calls that hit CRP_ERR_NO_FILE
  //   [3] CRP_ST_READ_ERR   -- boot-load calls that hit CRP_ERR_READ
  //   [4] CRP_ST_SYNTAX     -- parse calls that returned BAD_SYNTAX
  //   [5] CRP_ST_FULL       -- parse calls that returned TOO_MANY_ROWS
  //   [6] CRP_ST_ROWS_ADDED -- cumulative rows added across all loads
  //   [7] reserved
  pub let mut _crp_stats : [u64; 8] = uninit @align(64)

  pub let CRP_ST_PARSE_OK   : u64 = 0
  pub let CRP_ST_LOAD_OK    : u64 = 1
  pub let CRP_ST_NO_FILE    : u64 = 2
  pub let CRP_ST_READ_ERR   : u64 = 3
  pub let CRP_ST_SYNTAX     : u64 = 4
  pub let CRP_ST_FULL       : u64 = 5
  pub let CRP_ST_ROWS_ADDED : u64 = 6

  // Well-known path. 27 chars + NUL = 28.
  pub let crp_path : [u8; 28] = "/system/shell/commands.toml\0"
  pub let CRP_PATH_LEN : u64 = 27

  // Section-header prefix. 9 chars + NUL = 10. Byte-compared one byte
  // at a time against the input cursor.
  pub let crp_prefix : [u8; 10] = "[command.\0"
  pub let CRP_PREFIX_LEN : u64 = 9

  // Fingerprint tags + keys. Byte counts NUL-inclusive per the
  // kernel-logging-substrate.md #699 discipline.
  pub let crp_tag_loaded : [u8; 19] = "CMDREG TOML LOADED\0"

  // R123.M6 UMB-W8 (paideia-os #2590): hot-reload fingerprint tag.
  // Wire shape (klog_s1_x2, SUBSYS_CAP_, LEVEL_INFO):
  //   `CMDREG RELOADED rows=<hex> errno=<hex>`
  // where `rows` is the delta _crp_stats[CRP_ST_ROWS_ADDED] gained
  // by this reload (post - pre, snapshotted around the inner
  // _cmd_registry_load_boot call) and `errno` is the inner call's
  // return code (CRP_OK on clean parse, CRP_ERR_* on failure).
  // 15 chars + NUL = 16. Keys `rows` and `errno` are reused from
  // crp_k_rows / crp_k_errno above.
  pub let crp_tag_reloaded : [u8; 16] = "CMDREG RELOADED\0"

  pub let crp_k_rows   : [u8; 5] = "rows\0"
  pub let crp_k_errno  : [u8; 6] = "errno\0"

  // R123.M6 UMB-W8 (paideia-os #2590): hot-reload in-flight guard.
  // Set to 1 by _cmd_registry_reload via atomic_xchg_u64 at entry;
  // cleared to 0 via atomic_store_u64 at exit. A concurrent caller
  // observing the previous value as 1 returns CRP_ERR_RELOAD_BUSY
  // without touching the KCM pool. Lives in .bss so it starts at 0
  // (idle) at real boot; cmd_registry_parser_init also re-scrubs it
  // defensively on witness replay.
  pub let mut _crp_reload_in_flight : u64 = 0

  // ==========================================================================
  // SECTION 7  cmd_registry_parser_init() -> ()
  //
  // Defensive scrub of _crp_load_buf (4096 bytes) and _crp_stats (8 u64).
  // .bss is already zero at real boot; this call is belt-and-braces per
  // the kind_cmd_module.pdx / cmd_registry.pdx precedent and gives a
  // chaos-restart / witness-replay flow a clean re-scrub point. Called
  // from kernel_main's derived-pool reset cascade (adjacent to
  // cmd_module_init / cmd_registry_init).
  // ==========================================================================
  pub let cmd_registry_parser_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W4 R123.M2 (paideia-os #2586): clear _crp_load_buf (4096 bytes = 512 u64) and _crp_stats (8 u64). Boot + teardown only. .bss already zero at real boot; this is defensive (matches cmd_module_init / cmd_registry_init one-for-one). Labels prefixed crp_in_.",
      block: {
        lea r10, [rip + _crp_load_buf];
        xor rax, rax;
        xor rcx, rcx;
      crp_in_buf:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  crp_in_buf;

        lea r10, [rip + _crp_stats];
        xor rcx, rcx;
      crp_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  crp_in_stats;

        // R123.M6 UMB-W8 (paideia-os #2590): scrub the hot-reload
        // in-flight guard. .bss already zero at real boot; defensive
        // on witness replay / chaos restart so a left-over 1 does
        // not deadlock the first reload after re-init.
        mov [rip + _crp_reload_in_flight], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8  crp_note(stats_slot) -> ()
  //
  // Bump _crp_stats[slot] by 1. Caller passes a CRP_ST_* ordinal.
  // ==========================================================================
  pub let crp_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W4 R123.M2 (paideia-os #2586): bump _crp_stats[slot] by 1. Slot ordinals in {0..7}; caller passes constants only, no bounds check. Pure leaf. Labels prefixed crp_nt_.",
      block: {
        lea r10, [rip + _crp_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9  _cmd_registry_parse(buf_ptr, buf_len) -> errno
  //
  // Hand-rolled single-pass byte scanner over the TOML subset defined
  // in §1. Walks `buf_ptr[0..buf_len)` one line at a time. For each
  // `[command.NAME]` header: extracts NAME and calls cmd_module_open.
  // For each `KEY = "VALUE"` line: validates shape and discards the
  // value. Blank lines and `#` comments are skipped.
  //
  // Return:
  //   CRP_OK (0)                                on clean scan
  //   CRP_ERR_BAD_SYNTAX | (offset << 32)       on first malformed byte
  //   CRP_ERR_TOO_MANY_ROWS                     if cmd_module_open hits
  //                                              CM_MODULE_FULL
  //
  // Register plan: four callee-save pushes (rbx = buf_start, r12 =
  // buf_end, r13 = cursor, r14 = scratch/name_ptr) + sub rsp,8 land
  // rsp%16==0 at every nested call (entry rsp%16==8; +4*8=32 -> 40,
  // 40%16==8; +8 sub -> 48%16==0). cmd_module_open is the only
  // non-leaf call site. Labels prefixed crp_pa_.
  // ==========================================================================
  pub let _cmd_registry_parse : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (buf_ptr: u64) (buf_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W4 R123.M2 (paideia-os #2586): single-pass TOML-subset byte scanner. Per section `[command.NAME]`: call cmd_module_open(name_ptr, name_len); fold CM_MODULE_FULL to CRP_ERR_TOO_MANY_ROWS, CM_BAD_NAME to CRP_ERR_BAD_SYNTAX with name-byte offset. Per key=value line: validate shape, discard value. Returns CRP_OK on clean scan or packed CRP_ERR_BAD_SYNTAX | (byte_offset << 32) on first bad byte. Four callee-save pushes (rbx=buf_start, r12=buf_end, r13=cursor, r14=name_ptr_or_scratch) + sub rsp,8 land rsp%16==0 at the cmd_module_open call (entry 8 + 32 + 8 = 48, 48%16==0). Labels prefixed crp_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov rbx, rdi;                    // buf_start
        mov r12, rsi;
        add r12, rdi;                    // buf_end = buf_start + buf_len
        mov r13, rdi;                    // cursor

        // ------------------------------------------------------------------
      crp_pa_line_start:
        cmp r13, r12;
        jae crp_pa_done;                 // EOF

        // Skip leading WS (SP / HT / CR).
      crp_pa_skip_ws:
        cmp r13, r12;
        jae crp_pa_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;                   // ' '
        je  crp_pa_ws_step;
        cmp r10, 0x09;                   // '\t'
        je  crp_pa_ws_step;
        cmp r10, 0x0D;                   // '\r'
        je  crp_pa_ws_step;
        jmp crp_pa_after_ws;

      crp_pa_ws_step:
        add r13, 1;
        jmp crp_pa_skip_ws;

        // ------------------------------------------------------------------
      crp_pa_after_ws:
        // r10 holds first non-WS byte.
        cmp r10, 0x0A;                   // LF -> blank line
        je  crp_pa_eat_lf;
        cmp r10, 0x23;                   // '#' -> comment
        je  crp_pa_eat_comment;
        cmp r10, 0x5B;                   // '[' -> section header
        je  crp_pa_section;

        // Identifier start? [A-Za-z_]
        cmp r10, 0x41;                   // 'A'
        jb  crp_pa_check_lower;
        cmp r10, 0x5A;                   // 'Z'
        jbe crp_pa_keyval;
      crp_pa_check_lower:
        cmp r10, 0x61;                   // 'a'
        jb  crp_pa_check_us;
        cmp r10, 0x7A;                   // 'z'
        jbe crp_pa_keyval;
      crp_pa_check_us:
        cmp r10, 0x5F;                   // '_'
        je  crp_pa_keyval;
        jmp crp_pa_bad;

        // ------------------------------------------------------------------
      crp_pa_eat_lf:
        add r13, 1;
        jmp crp_pa_line_start;

      crp_pa_eat_comment:
        // Advance past '#' and all bytes up to and including LF (or EOF).
      crp_pa_cmt_scan:
        cmp r13, r12;
        jae crp_pa_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        add r13, 1;
        cmp r10, 0x0A;
        je  crp_pa_line_start;
        jmp crp_pa_cmt_scan;

        // ------------------------------------------------------------------
        // SECTION  [command.NAME]
        //
        // Match 9-byte prefix "[command." then scan NAME until ']'.
      crp_pa_section:
        // Ensure 9 bytes available for the prefix.
        mov r11, r13;
        add r11, 9;
        cmp r11, r12;
        ja  crp_pa_bad;                  // not enough left

        // Byte-compare 9 bytes against crp_prefix.
        lea r14, [rip + crp_prefix];
        xor rcx, rcx;
      crp_pa_pfx_cmp:
        cmp rcx, 9;
        jae crp_pa_pfx_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r11, r11;
        mov_b r11, [r14 + rcx * 1];
        cmp r10, r11;
        jne crp_pa_bad;
        add rcx, 1;
        jmp crp_pa_pfx_cmp;

      crp_pa_pfx_ok:
        add r13, 9;                      // skip "[command."
        mov r14, r13;                    // name_ptr

        // Scan NAME: [A-Za-z0-9_]+ until ']'.
      crp_pa_name_scan:
        cmp r13, r12;
        jae crp_pa_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x5D;                   // ']'
        je  crp_pa_name_end;

        // Digit [0-9]?
        cmp r10, 0x30;
        jb  crp_pa_name_check_u;
        cmp r10, 0x39;
        jbe crp_pa_name_adv;
      crp_pa_name_check_u:
        // Upper [A-Z]?
        cmp r10, 0x41;
        jb  crp_pa_name_check_l;
        cmp r10, 0x5A;
        jbe crp_pa_name_adv;
      crp_pa_name_check_l:
        // Lower [a-z]?
        cmp r10, 0x61;
        jb  crp_pa_name_check_us;
        cmp r10, 0x7A;
        jbe crp_pa_name_adv;
      crp_pa_name_check_us:
        cmp r10, 0x5F;                   // '_'
        je  crp_pa_name_adv;
        jmp crp_pa_bad;

      crp_pa_name_adv:
        add r13, 1;
        jmp crp_pa_name_scan;

      crp_pa_name_end:
        // name_len = r13 - r14. Validate 1..CRP_NAME_MAX.
        mov r11, r13;
        sub r11, r14;                    // name_len
        cmp r11, 0;
        je  crp_pa_bad;                  // empty name
        mov r10, 64;                     // CRP_NAME_MAX
        cmp r11, r10;
        ja  crp_pa_bad;

        // Advance past ']'.
        add r13, 1;

        // Allow trailing WS / optional '#' comment / EOL on this line.
      crp_pa_sec_tail:
        cmp r13, r12;
        jae crp_pa_sec_commit;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  crp_pa_sec_tail_adv;
        cmp r10, 0x09;
        je  crp_pa_sec_tail_adv;
        cmp r10, 0x0D;
        je  crp_pa_sec_tail_adv;
        cmp r10, 0x23;                   // comment
        je  crp_pa_sec_eat_comment;
        cmp r10, 0x0A;
        je  crp_pa_sec_eat_lf;
        jmp crp_pa_bad;
      crp_pa_sec_tail_adv:
        add r13, 1;
        jmp crp_pa_sec_tail;
      crp_pa_sec_eat_comment:
        add r13, 1;
      crp_pa_sec_cmt_scan:
        cmp r13, r12;
        jae crp_pa_sec_commit;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        add r13, 1;
        cmp r10, 0x0A;
        je  crp_pa_sec_commit;
        jmp crp_pa_sec_cmt_scan;
      crp_pa_sec_eat_lf:
        add r13, 1;

      crp_pa_sec_commit:
        // Call cmd_module_open(name_ptr=r14, name_len=r13-r14-tail).
        // We stashed name_len in r11 earlier but r11 is caller-save
        // through the trailing-tail scan; recompute cleanly.
        // name_ptr = r14; scan NAME end was at r13 - (bytes consumed
        // after name). The name_len saved pre-advance is cleaner to
        // recover via a direct resecan, but we instead stashed it in
        // _crp_stats scratch slot 7 would be awkward -- recompute by
        // walking r14 to the ']'.
        //
        // Clean recomputation: find ']' starting at r14. Since we
        // already validated the shape, this scan is guaranteed to
        // terminate before any WS/LF/EOF.
        mov rcx, r14;                    // name walk cursor
      crp_pa_sec_relen:
        xor r10, r10;
        mov_b r10, [rcx + 0];
        cmp r10, 0x5D;                   // ']'
        je  crp_pa_sec_relen_done;
        add rcx, 1;
        jmp crp_pa_sec_relen;
      crp_pa_sec_relen_done:
        mov rsi, rcx;
        sub rsi, r14;                    // name_len

        mov rdi, r14;                    // name_ptr
        call cmd_module_open;

        // Fold return value.
        mov r10, 0xFFFFFCC2;             // CM_MODULE_FULL
        cmp rax, r10;
        je  crp_pa_full;

        mov r10, 0xFFFFFCC1;             // CM_BAD_NAME
        cmp rax, r10;
        je  crp_pa_bad_at_name;

        // Any other value: a successful handle (0..CM_MODULE_MAX-1)
        // or CM_ALREADY_LOADED (0xFFFFFCC5) -> both continue.
        // Bump CRP_ST_ROWS_ADDED only on a FRESH handle (not dedup).
        mov r11, 0xFFFFFCC5;             // CM_ALREADY_LOADED
        cmp rax, r11;
        je  crp_pa_sec_next;             // dup: no row-added bump

        mov rdi, 6;                      // CRP_ST_ROWS_ADDED
        call crp_note;

      crp_pa_sec_next:
        jmp crp_pa_line_start;

      crp_pa_bad_at_name:
        // Report BAD_SYNTAX at the start of NAME (r14 is name_ptr).
        mov r13, r14;
        jmp crp_pa_bad;

        // ------------------------------------------------------------------
        // KEYVAL  KEY WS* = WS* " VALUE " WS* COMMENT? LF?
        //
        // At entry r13 points at the first byte of KEY (which the
        // dispatch loop already verified to be [A-Za-z_]).
      crp_pa_keyval:
        // Consume IDENT: [A-Za-z_][A-Za-z0-9_]*.
      crp_pa_kv_ident:
        add r13, 1;
        cmp r13, r12;
        jae crp_pa_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        // Digit?
        cmp r10, 0x30;
        jb  crp_pa_kv_i_u;
        cmp r10, 0x39;
        jbe crp_pa_kv_ident;
      crp_pa_kv_i_u:
        cmp r10, 0x41;
        jb  crp_pa_kv_i_l;
        cmp r10, 0x5A;
        jbe crp_pa_kv_ident;
      crp_pa_kv_i_l:
        cmp r10, 0x61;
        jb  crp_pa_kv_i_us;
        cmp r10, 0x7A;
        jbe crp_pa_kv_ident;
      crp_pa_kv_i_us:
        cmp r10, 0x5F;                   // '_'
        je  crp_pa_kv_ident;
        // End of IDENT. Fall through: r10 is the delimiter.

        // Skip WS up to '='.
      crp_pa_kv_ws1:
        cmp r10, 0x20;
        je  crp_pa_kv_ws1_adv;
        cmp r10, 0x09;
        je  crp_pa_kv_ws1_adv;
        cmp r10, 0x0D;
        je  crp_pa_kv_ws1_adv;
        jmp crp_pa_kv_want_eq;
      crp_pa_kv_ws1_adv:
        add r13, 1;
        cmp r13, r12;
        jae crp_pa_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        jmp crp_pa_kv_ws1;

      crp_pa_kv_want_eq:
        cmp r10, 0x3D;                   // '='
        jne crp_pa_bad;
        add r13, 1;

        // Skip WS up to '"'.
      crp_pa_kv_ws2:
        cmp r13, r12;
        jae crp_pa_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  crp_pa_kv_ws2_adv;
        cmp r10, 0x09;
        je  crp_pa_kv_ws2_adv;
        cmp r10, 0x0D;
        je  crp_pa_kv_ws2_adv;
        jmp crp_pa_kv_want_quote;
      crp_pa_kv_ws2_adv:
        add r13, 1;
        jmp crp_pa_kv_ws2;

      crp_pa_kv_want_quote:
        cmp r10, 0x22;                   // '"'
        jne crp_pa_bad;
        add r13, 1;

        // Scan VALUE until closing '"'. LF inside value = BAD_SYNTAX.
      crp_pa_kv_val:
        cmp r13, r12;
        jae crp_pa_bad;                  // unterminated string
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x22;                   // closing quote
        je  crp_pa_kv_val_end;
        cmp r10, 0x0A;                   // LF in string
        je  crp_pa_bad;
        add r13, 1;
        jmp crp_pa_kv_val;

      crp_pa_kv_val_end:
        add r13, 1;                      // past closing quote

        // Allow trailing WS, optional comment, EOL.
      crp_pa_kv_tail:
        cmp r13, r12;
        jae crp_pa_line_start;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  crp_pa_kv_tail_adv;
        cmp r10, 0x09;
        je  crp_pa_kv_tail_adv;
        cmp r10, 0x0D;
        je  crp_pa_kv_tail_adv;
        cmp r10, 0x23;
        je  crp_pa_kv_eat_cmt;
        cmp r10, 0x0A;
        je  crp_pa_kv_eat_lf;
        jmp crp_pa_bad;
      crp_pa_kv_tail_adv:
        add r13, 1;
        jmp crp_pa_kv_tail;
      crp_pa_kv_eat_cmt:
        add r13, 1;
      crp_pa_kv_cmt_scan:
        cmp r13, r12;
        jae crp_pa_line_start;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        add r13, 1;
        cmp r10, 0x0A;
        je  crp_pa_line_start;
        jmp crp_pa_kv_cmt_scan;
      crp_pa_kv_eat_lf:
        add r13, 1;
        jmp crp_pa_line_start;

        // ------------------------------------------------------------------
        // crp_note clobbers rax, so stats bump FIRST then rax load.
        // crp_note preserves rbx, r12, r13 (SysV callee-save), so the
        // byte-offset compute (r13 - rbx) remains valid after the call.
      crp_pa_bad:
        mov rdi, 4;                      // CRP_ST_SYNTAX
        call crp_note;
        // Pack offset into bits 32..63 of CRP_ERR_BAD_SYNTAX.
        mov r10, r13;
        sub r10, rbx;                    // byte offset
        shl r10, 32;
        mov rax, 0x0C01;                 // CRP_ERR_BAD_SYNTAX low word
        or  rax, r10;
        jmp crp_pa_out;

      crp_pa_full:
        mov rdi, 5;                      // CRP_ST_FULL
        call crp_note;
        mov rax, 0x0C02;                 // CRP_ERR_TOO_MANY_ROWS
        jmp crp_pa_out;

      crp_pa_done:
        mov rdi, 0;                      // CRP_ST_PARSE_OK
        call crp_note;
        xor rax, rax;                    // CRP_OK

      crp_pa_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10  _cmd_registry_load_boot() -> errno
  //
  // Opens `/system/shell/commands.toml`, reads up to CRP_BUF_CAP bytes
  // into _crp_load_buf, calls _cmd_registry_parse, and emits one
  // `CMDREG TOML LOADED rows=<n> errno=<e>` fingerprint via klog_s1_x2
  // (SUBSYS_CAP_, LEVEL_INFO).
  //
  // Non-fatal paths (boot continues):
  //   * vfs_open returns 0 -> CRP_ERR_NO_FILE. At today's wiring (hook
  //     between _mb_init and x2apic_probe_bsp), the FS is NOT yet up
  //     and vfs_open ALWAYS returns 0; a later landing re-invokes
  //     this after witness_r16_vfs to actually read the file.
  //   * vfs_read returns the error sentinel -> CRP_ERR_READ.
  //
  // Fatal-adjacent paths (caller logs a warning but boot continues):
  //   * CRP_ERR_BAD_SYNTAX (packed with offset).
  //   * CRP_ERR_TOO_MANY_ROWS.
  //
  // Register plan: two callee-save pushes (rbx = vnode_idx, r12 =
  // bytes_read) land rsp%16==0 at every nested call (entry rsp%16==8;
  // +16 pushes -> 24; +8 sub via klog_s1_x2 reservation -> 32; the
  // klog_s1_x2 caller frame uses `sub rsp,16; mov [rsp+0], v2; ...
  // add rsp,16` keeping rsp%16==0 at the call). Labels prefixed crp_lb_.
  // ==========================================================================
  pub let _cmd_registry_load_boot : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W4 R123.M2 (paideia-os #2586): boot driver for the on-disk command registry. Opens /system/shell/commands.toml, reads up to 4 KiB, calls _cmd_registry_parse, emits CMDREG TOML LOADED fingerprint. Non-fatal on NO_FILE/READ_ERR (common at today's early-boot slot where VFS is not yet up); caller logs a warning but boot continues. Two callee-save pushes (rbx=vnode_idx, r12=bytes_read) + sub rsp,8 land rsp%16==0 at every nested call (entry 8 + 16 + 8 = 32, 32%16==0). klog_s1_x2 slot v2 at caller [rsp+0] after sub rsp,16 per Wave 73 I7 regression memory. Labels prefixed crp_lb_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        xor rbx, rbx;                    // vnode_idx = 0
        xor r12, r12;                    // bytes_read = 0

        // (1) vfs_open(path, O_RDONLY=0).
        lea rdi, [rip + crp_path];
        xor rsi, rsi;
        call vfs_open;
        cmp rax, 0;
        je  crp_lb_no_file;
        mov rbx, rax;                    // vnode_idx

        // (2) vfs_read(vnode, buf, 4096, 0).
        mov rdi, rbx;
        lea rsi, [rip + _crp_load_buf];
        mov rdx, 4096;                   // CRP_BUF_CAP
        xor rcx, rcx;                    // offset 0
        call vfs_read;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  crp_lb_read_err;
        mov r12, rax;                    // bytes_read

        // (3) vfs_close(vnode).
        mov rdi, rbx;
        call vfs_close;
        xor rbx, rbx;                    // mark closed

        // (4) Parse.
        lea rdi, [rip + _crp_load_buf];
        mov rsi, r12;
        call _cmd_registry_parse;

        // Park parse_errno in callee-save r12 (bytes_read no longer
        // needed) so the klog + crp_note calls below do not clobber
        // it. We RETURN parse_errno to the caller so a syntax or
        // pool-full outcome surfaces upward; the fingerprint renders
        // only the low 16 bits as hex but the full packed value
        // (bits 32..63 = offset for BAD_SYNTAX) is returned.
        mov r12, rax;                    // r12 = parse_errno (callee-save)

        // Emit `CMDREG TOML LOADED rows=<rows_added> errno=<parse_errno>`
        // via klog_s1_x2 (SUBSYS_CAP_, LEVEL_INFO).
        //   v1 = _crp_stats[CRP_ST_ROWS_ADDED]
        //   v2 = parse_errno (packed low word for operator read)
        lea r10, [rip + _crp_stats];
        mov r9, [r10 + 48];              // _crp_stats[6] (ROWS_ADDED)

        sub rsp, 16;
        mov [rsp + 0], r12;              // v2 = parse_errno
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + crp_tag_loaded];
        lea rcx, [rip + crp_k_rows];
        mov r8, r9;                      // v1 = rows_added
        lea r9, [rip + crp_k_errno];
        call klog_s1_x2;
        add rsp, 16;

        mov rdi, 1;                      // CRP_ST_LOAD_OK
        call crp_note;

        mov rax, r12;                    // return parse_errno
        jmp crp_lb_out;

      crp_lb_no_file:
        mov rdi, 2;                      // CRP_ST_NO_FILE
        call crp_note;
        mov rax, 0x0C04;                 // CRP_ERR_NO_FILE
        jmp crp_lb_out;

      crp_lb_read_err:
        // Attempt a close even on read error (vnode held).
        mov rdi, rbx;
        call vfs_close;
        xor rbx, rbx;
        mov rdi, 3;                      // CRP_ST_READ_ERR
        call crp_note;
        mov rax, 0x0C03;                 // CRP_ERR_READ

      crp_lb_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  BOOT WIRING NOTE
  // --------------------------------------------------------------------------
  //
  // kernel_main.pdx inserts one call AFTER _mb_init and BEFORE
  // x2apic_probe_bsp:
  //
  //     call _cmd_registry_load_boot;
  //
  // The return value may safely be ignored at the top-level cascade:
  // all four error codes (NO_FILE / READ / BAD_SYNTAX / TOO_MANY_ROWS)
  // are drained to a klog line and boot proceeds. The parser's own
  // CMDREG TOML LOADED fingerprint carries the rows_added + errno for
  // operator inspection.
  //
  // The derived-pool reset cascade (adjacent to cmd_module_init /
  // cmd_registry_init in kernel_main's late block) gets a matching
  // defensive scrub:
  //
  //     call cmd_registry_parser_init;
  //
  // At real boot .bss zero-init already leaves _crp_load_buf and
  // _crp_stats empty, so the explicit scrub is belt-and-braces.
  //
  // Cross-module caller sites:
  //   - R123.M3: cmd_invoke_dispatch consults KIND_CMD_MODULE rows
  //     populated by this parser.
  //   - R123.M6 UMB-W8 (paideia-os #2590): _cmd_registry_reload (§12
  //     below) wraps _cmd_registry_load_boot with (a) an atomic-xchg
  //     in-flight guard, (b) kcm_table_reset to flush the KCM row
  //     pool before re-parse, (c) a dedicated CMDREG RELOADED
  //     fingerprint carrying rows=<delta> errno=<e>. CM_OP_RELOAD = 6
  //     in kind_cmd_module.pdx dispatches to this entry point under
  //     the R_CM_WRITE right gate.
  //
  // ==========================================================================
  // SECTION 12  _cmd_registry_reload() -> errno
  //
  // R123.M6 UMB-W8 (paideia-os #2590) hot-reload entry point. Six
  // phases:
  //
  //   (1) Acquire the in-flight guard. atomic_xchg_u64(&_crp_reload_
  //       in_flight, 1) swaps 1 in and returns the previous value.
  //       Previous==1 means another reload is already inside the
  //       critical section (concurrent caller or re-entrant on this
  //       CPU through a nested cap_invoke); return CRP_ERR_RELOAD_BUSY
  //       immediately WITHOUT touching the KCM pool. Previous==0 means
  //       we hold the guard; continue.
  //
  //       The atomic is distinct from a plain `mov` because another
  //       CPU could race between a `cmp [mem], 0 / mov [mem], 1`
  //       pair. xchg's implicit LOCK (SDM Vol 2A §XCHG) delivers
  //       test-and-set atomicity in a single instruction.
  //
  //   (2) Snapshot pre_rows = _crp_stats[CRP_ST_ROWS_ADDED] (slot 6).
  //       The parser counts cumulative row-adds across all parse
  //       runs; the fingerprint's `rows=` field is (post - pre),
  //       the net new rows this reload contributed.
  //
  //   (3) Flush the KIND_CMD_MODULE row pool via kcm_table_reset
  //       (kind_cmd_module.pdx §kcm_table_reset). This zeroes
  //       _kcm_table (48 u64), _kcm_stats (8 u64), _kcm_names
  //       (64 u64 = 512 bytes) and _kcm_name_lens (8 u64), so every
  //       row returns to the EMPTY sentinel (flags==0) and
  //       cmd_module_open starts fresh from row 0 upward.
  //
  //   (4) Re-invoke _cmd_registry_load_boot which (a) opens
  //       /system/shell/commands.toml, (b) reads up to CRP_BUF_CAP
  //       bytes into _crp_load_buf, (c) calls _cmd_registry_parse
  //       which iterates `[command.NAME]` sections and calls
  //       cmd_module_open per section, (d) emits its own CMDREG TOML
  //       LOADED fingerprint. The returned errno surfaces unchanged
  //       in the reload fingerprint and return value.
  //
  //   (5) Snapshot post_rows and emit CMDREG RELOADED rows=<delta>
  //       errno=<e> via klog_s1_x2 (SUBSYS_CAP_, LEVEL_INFO,
  //       crp_tag_reloaded, crp_k_rows, crp_k_errno).
  //
  //   (6) Release the in-flight guard via atomic_store_u64(&_crp_
  //       reload_in_flight, 0). Plain store suffices (we hold
  //       exclusively), but routing through the atomic helper keeps
  //       the discipline uniform and provides TSO release ordering
  //       for the preceding writes to be observed by the next
  //       acquirer.
  //
  // Return value: whatever _cmd_registry_load_boot returned, OR
  // CRP_ERR_RELOAD_BUSY (0x0C05) when phase 1 fails.
  //
  // DEFERRED (R123.M6-followup):
  //   (a) Shadow-table + pointer-swap atomic reload. Today's flush-
  //       then-parse leaves the KCM pool EMPTY for the duration of
  //       phase 4. Concurrent cap_invoke(KIND_CMD_MODULE, OP_LOOKUP)
  //       during that window will miss. The guard prevents concurrent
  //       RELOADs but not LOOKUPs. A follow-up builds the new table
  //       off-side, swaps a `_kcm_table_live` pointer under a seqlock,
  //       and only then frees the old one.
  //   (b) FS-watch (KIND_FS_WATCH) integration. The kind does not
  //       exist. A userspace daemon invokes CM_OP_RELOAD today.
  //
  // Register plan: two callee-save pushes (rbx = pre_rows, r12 =
  // errno) + sub rsp,8 land rsp%16==0 at every nested call (entry
  // rsp%16==8; +16 pushes -> %16==8; +8 sub -> %16==0). klog_s1_x2
  // caller frame uses `sub rsp,16; [rsp+0] = v2; call; add rsp,16`
  // keeping rsp%16==0 at the klog call. The busy early-return path
  // runs BEFORE the pushes to avoid the pop sequence on the fast
  // failure path; a plain `mov rax, 0x0C05; ret` is the exit.
  //
  // Encoder discipline (§4): no `test rN, rN` (every zero-check uses
  // `cmp reg, 0`); no 2-op `imul r, imm`; no `and reg, imm64`; no
  // `add reg, [mem]` / `cmp reg, [mem]`; CRP_ERR_RELOAD_BUSY=0x0C05
  // fits imm32 (bit 31 clear) and loads via the standard 7-byte
  // `mov rax, imm32` zero-extend. Labels prefixed crp_rl_.
  // ==========================================================================
  pub let _cmd_registry_reload : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R123.M6 UMB-W8 (paideia-os #2590): hot-reload entry point. Six phases: (1) acquire in-flight guard via atomic_xchg_u64(&_crp_reload_in_flight, 1); previous==1 -> return CRP_ERR_RELOAD_BUSY (0x0C05) without touching the KCM pool; (2) snapshot pre_rows = _crp_stats[CRP_ST_ROWS_ADDED] (slot 6, offset +48); (3) flush KIND_CMD_MODULE row pool via kcm_table_reset (zeros _kcm_table 48 u64 + _kcm_stats 8 u64 + _kcm_names 64 u64 + _kcm_name_lens 8 u64); (4) re-invoke _cmd_registry_load_boot which opens, reads, parses /system/shell/commands.toml and emits its own CMDREG TOML LOADED fingerprint; (5) snapshot post_rows and emit CMDREG RELOADED rows=<post-pre> errno=<e> via klog_s1_x2 (SUBSYS_CAP_, LEVEL_INFO, crp_tag_reloaded, crp_k_rows, crp_k_errno); (6) release the in-flight guard via atomic_store_u64(&_crp_reload_in_flight, 0). The atomic xchg (not a plain mov) delivers test-and-set atomicity in a single implicit-LOCK instruction per SDM Vol 2A §XCHG; preventing a between-CPU race. Returns inner _cmd_registry_load_boot errno on the normal path, or CRP_ERR_RELOAD_BUSY on contention. Register plan: two callee-save pushes (rbx=pre_rows, r12=errno) + sub rsp,8 land rsp%16==0 at every nested call (entry rsp%16==8; +16+8=24; (8+24)%16==0). klog_s1_x2 caller frame uses sub rsp,16 (v2 at [rsp+0]) keeping rsp%16==0 at the klog call. Busy early-return runs BEFORE the pushes so the exit is a direct `mov rax, imm32; ret`. Deferred: shadow-table + seqlock atomic reload (today concurrent LOOKUPs during phase 4 see an empty pool); FS-watch integration (KIND_FS_WATCH kind does not exist). Labels prefixed crp_rl_.",
      block: {
        // --------------------------------------------------------------
        // Phase 1: acquire the in-flight guard (atomic test-and-set).
        // atomic_xchg_u64(&_crp_reload_in_flight, 1) returns the previous
        // value. Need rsp%16==0 at the call site: entry rsp%16==8 so
        // we sub 8 before the call and add 8 after.
        // --------------------------------------------------------------
        sub rsp, 8;
        lea rdi, [rip + _crp_reload_in_flight];
        mov rsi, 1;
        call atomic_xchg_u64;
        add rsp, 8;
        cmp rax, 0;
        jne crp_rl_busy;

        // Guard acquired. Now set up the body frame.
        push rbx;
        push r12;
        sub  rsp, 8;

        // --------------------------------------------------------------
        // Phase 2: snapshot pre_rows = _crp_stats[CRP_ST_ROWS_ADDED].
        // Slot 6, offset +48 (6*8).
        // --------------------------------------------------------------
        lea r10, [rip + _crp_stats];
        mov rbx, [r10 + 48];             // pre_rows (callee-save)

        // --------------------------------------------------------------
        // Phase 3: flush the KIND_CMD_MODULE row pool.
        // --------------------------------------------------------------
        call kcm_table_reset;

        // --------------------------------------------------------------
        // Phase 4: re-invoke the on-disk load path.
        // --------------------------------------------------------------
        call _cmd_registry_load_boot;
        mov r12, rax;                    // errno (callee-save)

        // --------------------------------------------------------------
        // Phase 5: compute delta rows + emit CMDREG RELOADED.
        //   delta = _crp_stats[6] - pre_rows
        // Unsigned sub is safe: _crp_stats[6] is monotonic (parse-time
        // row-adds never decrease), so post >= pre.
        // --------------------------------------------------------------
        lea r10, [rip + _crp_stats];
        mov r11, [r10 + 48];             // post_rows
        sub r11, rbx;                    // delta

        // klog_s1_x2(level=INFO, SUBSYS_CAP_, crp_tag_reloaded,
        //            crp_k_rows, delta, crp_k_errno, errno)
        sub rsp, 16;
        mov [rsp + 0], r12;              // v2 = errno
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + crp_tag_reloaded];
        lea rcx, [rip + crp_k_rows];
        mov r8, r11;                     // v1 = delta rows
        lea r9, [rip + crp_k_errno];
        call klog_s1_x2;
        add rsp, 16;

        // --------------------------------------------------------------
        // Phase 6: release the in-flight guard.
        // atomic_store_u64(&_crp_reload_in_flight, 0).
        // --------------------------------------------------------------
        lea rdi, [rip + _crp_reload_in_flight];
        xor rsi, rsi;
        call atomic_store_u64;

        mov rax, r12;                    // return errno

        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      crp_rl_busy:
        mov rax, 0x0C05;                 // CRP_ERR_RELOAD_BUSY
        ret
      }
    }
}
