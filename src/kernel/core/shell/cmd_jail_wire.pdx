// src/kernel/core/shell/cmd_jail_wire.pdx -- UMB-W21 R135.M7 (paideia-os #2632)
//
// Integration shim between the R123 KIND_CMD_MODULE command-registry
// substrate (src/kernel/core/cap/kind_cmd_module.pdx, kind tag 0x5C)
// and the R135 WASI-jail substrate (src/kernel/core/svc/jail_supervisor.
// pdx + wasi_args_conv.pdx + wasi_fd_mediation.pdx + wasi_stdout_records.
// pdx). This file WIRES UP the already-landed primitives; it introduces
// NO new substrate.
//
// =============================================================================
// SECTION 0  WHAT R135.M7 LANDS vs. WHAT A FOLLOW-UP OWNS
// =============================================================================
//
// LANDED HERE (R135.M7):
//
//   (1) The public dispatch entry the shell calls once a command name has
//       resolved to a KIND_CMD_MODULE row:
//
//         _cmd_jail_wire_dispatch(cmd_row_id, argv_ptr, argc,
//                                 caller_cap_env_slot) -> errno
//
//   (2) The CM_FLAG_WASI (0x4) setter (parser-adjacent): a kernel-trusted
//       mark primitive that OR-s CM_FLAG_WASI into _kcm_table[row+32]
//       after the parser already set CM_FLAG_LIVE | CM_FLAG_ISOLATE at
//       cmd_module_open. Direct precedent is
//       _functor_invoke_oop_set_isolate in functor_invoke_oop.pdx.
//
//         _cmd_jail_wire_mark_wasi(row_id) -> errno
//
//   (3) A NUL-separated argv-blob marshaller
//       cjw_marshal_wasi_blob(src_argv_ptr, argc) -> packed_u64
//
//       that reads the (ptr,len)-tuple-list format already accepted by
//       _functor_invoke_oop_spawn (per functor_invoke_oop.pdx §3) and
//       writes a FLAT NUL-separated byte buffer _cjw_wasi_blob suitable
//       for _wasi_args_register. The two argv formats differ in shape
//       (FIO uses a u32 header + offsets array + NUL-terminated strings;
//       WASI expects a bare NUL-separated concatenation with argc = NUL
//       count), so the shim bridges them explicitly.
//
// DEFERRED (follow-up issues):
//
//   (a) Parser-side wiring. cmd_registry_parser.pdx discards per-key
//       values after shape validation; the follow-up slice extends the
//       per-key action to recognise the key `wasi` (parallel to the
//       `isolate` extension deferred from R123.M4 UMB-W6), parse
//       true/false, and on true call `_cmd_jail_wire_mark_wasi(row_id)`
//       after cmd_module_open mints the row. R135.M7 lands the setter;
//       the parser follow-up lands with the registry parser slice.
//
//   (b) Shell-dispatch integration. There is still no shell_main /
//       shell_dispatch loop in src/kernel/core/shell/ (grep audit,
//       2026-10-14): the existing files are cmd_registry.pdx (LRU +
//       reload), cmd_registry_parser.pdx (TOML -> KCM rows), cmd_
//       invoke.pdx (R123.M3 light-cmd fast path for the earlier 0x200
//       substrate), functor_invoke.pdx (in-process), functor_invoke_
//       oop.pdx (OOP spawn), and now this file. The shell-dispatch
//       landing that calls `_cmd_jail_wire_dispatch` is a follow-up
//       bundled with the user-space shell materialisation (R127.M+ /
//       R129.M+). For R135.M7 this file is a CALLABLE primitive --
//       the dispatch pipeline WIRE EXISTS; a shell will land the
//       loop that drives it.
//
//   (c) True IPC-mediated jail bringup. R135.M7 passes jail cap_env_slot
//       as the caller's own slot by convention (`caller_cap_env_slot`
//       is the fourth argument of `_cmd_jail_wire_dispatch`). A later
//       R125.M+ landing may interpose a cap-env narrowing primitive;
//       the shim already parks the slot in a register across every
//       nested call so the swap is a 1-line change inside this file.
//
// =============================================================================
// SECTION 1  DISPATCH DECISION TREE
// =============================================================================
//
// On entry we have:
//
//   cmd_row_id             -- a row_id in [0, CM_MODULE_MAX=8) that
//                             the caller has already proven is live
//                             (via a prior kcm_find_hash + liveness
//                             gate; the shim re-validates defensively).
//   argv_ptr               -- a flat (ptr,len)-tuple list, 2*argc u64
//                             entries, exactly the format fio_marshal_
//                             argv consumes.
//   argc                   -- u64 arg count, 1 <= argc <= 255 by
//                             convention (fio_marshal_argv rejects 0;
//                             we do not re-impose an upper bound here --
//                             fio_marshal_argv overflow is the gate).
//   caller_cap_env_slot    -- a KIND_CAP_ENV row_id (R125.M1 substrate).
//                             The jail inherits this slot verbatim for
//                             R135.M7; R125.M+ may interpose a narrowing.
//
// Decision tree, in order:
//
//    1. Validate: row_id < CM_MODULE_MAX, row LIVE. Else CJW_ERR_BAD_ROW.
//
//    2. Read flags := _kcm_table[row*48 + 32].
//
//    3. Case split on (ISOLATE, WASI):
//
//        (ISOLATE=0, WASI=0) -- in-process. Read entry_va from
//          _fi_entry_va[row_id] (NB: shadow lives in functor_invoke.pdx
//          as `_fi_entry_va : [u64; 8]`, same stride as _kcm_table rows).
//          entry_va == 0 -> CJW_ERR_IN_PROCESS. Else call
//          _functor_invoke_call(entry_va, argv_ptr, argc). The functor's
//          return (i64) is lossily cast to u64 for the shim; a negative
//          return propagates verbatim (the shell interprets).
//
//        (ISOLATE=1, WASI=0) -- OOP spawn, no WASI wiring. Resolve
//          the row's name via kcm_read_name into a stack-local 64-byte
//          scratch (CM_NAME_MAX bytes), then call _functor_invoke_oop_
//          spawn(name_ptr, name_len, argv_ptr, argc). Packed result;
//          nonzero errno -> CJW_ERR_JAIL_SPAWN.
//
//        (ISOLATE=1, WASI=1) -- OOP spawn + jail + argv register. The
//          full pipeline:
//            a. Resolve name via kcm_read_name.
//            b. Marshal the NUL-separated WASI blob via cjw_marshal_
//               wasi_blob(argv_ptr, argc). Overflow -> CJW_ERR_JAIL_SPAWN
//               (shared with step d; the shim does not distinguish
//               marshal overflow from spawn fail at the entry-level
//               errno band).
//            c. Call _functor_invoke_oop_spawn(name_ptr, name_len,
//               argv_ptr, argc). nonzero errno -> CJW_ERR_JAIL_SPAWN.
//               Extract child_pid := packed >> 32.
//            d. Call _jail_supervisor_create(child_pid, caller_cap_env_
//               slot, mask_lo=0, mask_hi=0, name_ptr, name_len). Mask
//               bits 0/0 at M7 mean "no syscall allowlist narrowing
//               yet" -- the follow-up R135.M8+ step installs the WASI
//               syscall allowlist. nonzero errno -> CJW_ERR_JAIL_SPAWN
//               (and the child is NOT reaped -- that is a leak the
//               R135.M8 teardown slice closes; for M7 we accept the
//               leak so the entry-level errno band stays shallow).
//            e. Call _wasi_args_register(child_pid, &_cjw_wasi_blob,
//               blob_len). nonzero errno -> CJW_ERR_JAIL_SPAWN.
//
//        (ISOLATE=0, WASI=1) -- REJECTED. A WASI binary MUST run
//          isolated (its jail depends on an own-aspace spawn). Return
//          CJW_ERR_BAD_ROW; the parser must set BOTH bits together.
//
//    4. Emit fingerprint and return.
//
// =============================================================================
// SECTION 2  RETURN CODE BAND  --  0x2000..0x2002
// =============================================================================
//
//   CJW_OK              = 0            -- dispatch dispatched successfully
//   CJW_ERR_BAD_ROW     = 0x2000       -- row_id out of range, not LIVE,
//                                          or (WASI=1, ISOLATE=0)
//                                          mis-configuration
//   CJW_ERR_JAIL_SPAWN  = 0x2001       -- OOP spawn or jail create or
//                                          wasi_args_register failed
//   CJW_ERR_IN_PROCESS  = 0x2002       -- in-process entry_va shadow
//                                          was zero at the row's row_id
//
// All three fit imm32 with bit 31 clear so `mov rax, imm32` 7-byte
// zero-extends to u64 directly; no r9 staging.
//
// Audit at landing time:
//   `grep -rnE '\b0x200[012]\b' src/kernel/core/shell/` returned 0
//   non-encoder-offset occurrences.
//   `grep -rnE 'CJW_(OK|ERR_)' src/` returned 0 occurrences.
//
// =============================================================================
// SECTION 3  INTERACTION WITH R123.M3/M4 AND R125.M4
// =============================================================================
//
//   R123.M3 (_functor_invoke_call)   -- the in-process arm here. The
//     shim handles only the dispatch; the functor's own return (i64)
//     is lossily cast to u64 for the errno (so a functor returning
//     e.g. -EBADF folds into a very large u64; the shell interprets).
//     The shim does NOT lossy-mask -- it propagates the full 64 bits.
//
//   R123.M4 (_functor_invoke_oop_spawn) -- the OOP arm. The shim
//     collapses the packed (pid<<32)|errno into a boolean fail/not-fail
//     via a low-32 mask; the pid is preserved only for the jail-create
//     call that follows.
//
//   R125.M4 (syscall cap_check)       -- the jail allowlist CHAINS
//     AFTER the cap-check (see jail-supervisor-daemon.md §6.2). R135.M7
//     passes mask_lo=0, mask_hi=0 (deny-all beyond cap-check); this is
//     correct for the follow-up slice that lands the WASI syscall
//     allowlist in a per-command mask. For M7 we leave the WASI binary
//     unable to issue any syscalls past the cap-check -- fail-closed
//     until the allowlist lands.
//
// =============================================================================
// SECTION 4  ENCODER-PITFALL POSTURE
// =============================================================================
//
// * Row-flag masks (0x1, 0x2, 0x4) fit imm32; staged through r11 ONLY
//   when combined (e.g. ISOLATE|WASI). No `and r11, imm64` ever.
// * Row stride 48 encoded as `mov r11, 48; imul rax, r11` (reg-reg);
//   never the 2-op `imul r, imm` form.
// * Liveness tests use `cmp rN, 0` (never `test rN, rN`).
// * Error constants 0x2000..0x2002 fit imm32; emit via `mov rax, imm32`.
// * Module basename `CmdJailWire` matches `cmd_jail_wire.pdx`.
// * Every label prefixed `cjw_` (reserved-word discipline: `loop`,
//   `if`, `let` are keywords; `cjw_` keeps us well clear).
// * All `pub let` string declarations are single-line.
// * Fingerprint tag `[u8; N]` string literals have N = string length + 1
//   (trailing NUL counts). N spelled next to each literal.
// * klog_s1_x2 7th stack argument lives at `[rsp+0]` AFTER `sub rsp, 16`
//   per the Wave 73 I7 regression memory.
// * byte-copy loops use `mov_b r,[rbx+rcx*1]` with `xor r10, r10`
//   pre-zero (encoder does not zero-extend 8-bit loads on its own).

module CmdJailWire = structure {

  // ==========================================================================
  // SECTION 5  CONSTANTS
  // ==========================================================================

  // Return codes (§2).
  pub let CJW_OK             : u64 = 0
  pub let CJW_ERR_BAD_ROW    : u64 = 0x2000
  pub let CJW_ERR_JAIL_SPAWN : u64 = 0x2001
  pub let CJW_ERR_IN_PROCESS : u64 = 0x2002

  // Row-pool ceilings mirrored from kind_cmd_module.pdx (local copies
  // so this module can fold them without pulling KindCmdModule into
  // every call site; identical posture to functor_invoke_oop.pdx §6).
  pub let CJW_ROW_MAX  : u64 = 8     // mirrors CM_MODULE_MAX
  pub let CJW_NAME_MAX : u64 = 64    // mirrors CM_NAME_MAX
  pub let CJW_ROW_BYTES : u64 = 48   // mirrors CM_ROW_BYTES

  // Substrate-side sentinels.
  pub let CJW_KCM_ROW_NONE : u64 = 0xFF   // mirrors CM_ROW_NONE
  pub let CJW_KCM_BAD_ROW  : u64 = 0xFFFFFCC7  // mirrors CM_BAD_ROW

  // Flags-word bits (local mirrors; see kind_cmd_module.pdx §2).
  pub let CJW_FLAG_LIVE    : u64 = 0x1    // CM_FLAG_LIVE
  pub let CJW_FLAG_ISOLATE : u64 = 0x2    // CM_FLAG_ISOLATE
  pub let CJW_FLAG_WASI    : u64 = 0x4    // CM_FLAG_WASI

  // WASI blob buffer (§1 step d). _wasi_args_register's WA_BLOB_MAX is
  // 1024 bytes; the shim's scratch mirrors that ceiling. One kernel-
  // global buffer suffices because dispatch is serial at R135.M7 (no
  // concurrent command dispatch yet; the shell loop is a single
  // kernel-ring thread).
  pub let CJW_BLOB_MAX : u64 = 1024
  pub let mut _cjw_wasi_blob : [u8; 1024] = uninit @align(64)

  // Observability counters.
  pub let mut _cjw_stats : [u64; 8] = uninit @align(64)

  pub let CJW_ST_DISPATCH_INPROC   : u64 = 0
  pub let CJW_ST_DISPATCH_OOP      : u64 = 1
  pub let CJW_ST_DISPATCH_WASI     : u64 = 2
  pub let CJW_ST_BAD_ROW           : u64 = 3
  pub let CJW_ST_IN_PROCESS_FAIL   : u64 = 4
  pub let CJW_ST_JAIL_SPAWN_FAIL   : u64 = 5
  pub let CJW_ST_MARK_WASI_OK      : u64 = 6
  pub let CJW_ST_MARK_WASI_FAIL    : u64 = 7

  // Fingerprint tags + keys. Byte counts NUL-inclusive.
  pub let cjw_tag_dispatch : [u8; 13] = "CJW DISPATCH\0"
  pub let cjw_tag_bad_row  : [u8; 12] = "CJW BAD_ROW\0"
  pub let cjw_tag_mark     : [u8; 9]  = "CJW MARK\0"

  pub let cjw_k_row    : [u8; 6] = "rowid\0"
  pub let cjw_k_flags  : [u8; 6] = "flags\0"
  pub let cjw_k_errno  : [u8; 6] = "errno\0"
  pub let cjw_k_pid    : [u8; 4] = "pid\0"

  // ==========================================================================
  // cjw_shadow_reset() -> ()
  //
  // Defensive clear. Zero the WASI blob (1024 bytes = 128 u64) and the
  // stats array (8 u64). .bss is already zero at real boot; this call
  // is belt-and-braces per the fio_shadow_reset / fi_shadow_reset
  // precedent in the sibling files.
  // ==========================================================================
  pub let cjw_shadow_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W21 R135.M7 (#2632): clear _cjw_wasi_blob (128 u64) and _cjw_stats (8 u64). Boot-only; .bss already zero at real boot; defensive scrub matches fio_shadow_reset / fi_shadow_reset one-for-one. Pure leaf, no nested calls. Labels prefixed cjw_sr_.",
      block: {
        lea r10, [rip + _cjw_wasi_blob];
        xor rax, rax;
        xor rcx, rcx;
      cjw_sr_blob:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  cjw_sr_blob;

        lea r10, [rip + _cjw_stats];
        xor rcx, rcx;
      cjw_sr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cjw_sr_stats;
        ret
      }
    }

  // ==========================================================================
  // cjw_note(stats_slot) -> ()
  //
  // Bump _cjw_stats[slot]. Caller passes slot ordinal (CJW_ST_*).
  // ==========================================================================
  pub let cjw_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W21 R135.M7 (#2632): bump _cjw_stats[slot] by 1. Slot ordinals in {0..7} per CJW_ST_* enumeration. Pure leaf, no bounds check (caller passes constants only). Labels prefixed cjw_nt_.",
      block: {
        lea r10, [rip + _cjw_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
        ret
      }
    }

  // ==========================================================================
  // cjw_row_flags(row_id) -> u64
  //
  // Load _kcm_table[row_id*48 + 32] (the flags word). No bounds check;
  // caller validates. Pure leaf.
  // ==========================================================================
  pub let cjw_row_flags : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W21 R135.M7 (#2632): row_id -> _kcm_table[row*48 + 32] (flags word). Stride 48 via `mov r11,48; imul rax,r11` reg-reg per encoder discipline (no 2-op imul-with-imm form). Pure leaf; caller has already validated row_id < CM_MODULE_MAX. Labels prefixed cjw_rf_.",
      block: {
        mov rax, rdi;
        mov r11, 48;
        imul rax, r11;
        lea r10, [rip + _kcm_table];
        add rax, r10;
        mov rax, [rax + 32];             // flags word
        ret
      }
    }

  // ==========================================================================
  // _cmd_jail_wire_mark_wasi(row_id) -> errno
  //
  // Kernel-trusted setter: OR CJW_FLAG_WASI (0x4) into _kcm_table[row+32]
  // IFF the row is currently LIVE. Direct precedent is
  // _functor_invoke_oop_set_isolate in functor_invoke_oop.pdx. The
  // parser-side wiring that calls this upon reading `wasi = true` in
  // commands.toml is a follow-up (SECTION 0 item (a)).
  //
  // Returns:
  //   CJW_OK             -- bit set (or was already set; OR is idempotent)
  //   CJW_ERR_BAD_ROW    -- row_id >= CM_MODULE_MAX OR row not LIVE
  //
  // Register plan: one callee-save push (rbx = row_id). Entry rsp%16==8
  // + 8 = 0 at every nested call site.
  // ==========================================================================
  pub let _cmd_jail_wire_mark_wasi : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W21 R135.M7 (#2632): mark a KIND_CMD_MODULE row as WASI-dispatched. Gate: row_id < CJW_ROW_MAX=8 and row's flags word (at [+32]) has CJW_FLAG_LIVE (0x1) set, else CJW_ERR_BAD_ROW. Operation: read flags, OR in CJW_FLAG_WASI (0x4), store back. NOT publish-last -- LIVE is already published and the OR is observed atomically within one 8-byte aligned store (same posture as fio_set_isolate). Emits `CJW MARK rowid=0x<n>` via klog_s1_x1. One callee-save push (rbx=row_id); entry rsp%16==8 + 8 = 0; klog_s1_x1 and cjw_row_flags both callee-save clean. Labels prefixed cjw_mw_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // row_id

        // Gate: row_id < CM_MODULE_MAX.
        mov r10, 8;                      // CJW_ROW_MAX
        cmp rbx, r10;
        jae cjw_mw_bad;

        // Compute row base: _kcm_table + row_id * 48.
        mov rax, rbx;
        mov r11, 48;
        imul rax, r11;
        lea r10, [rip + _kcm_table];
        add rax, r10;

        // Read flags; require LIVE bit.
        mov r10, [rax + 32];
        mov r11, 1;                      // CJW_FLAG_LIVE
        and r10, r11;
        cmp r10, 0;
        je  cjw_mw_bad;

        // OR in CJW_FLAG_WASI (0x4) and store back.
        mov r10, [rax + 32];
        mov r11, 4;                      // CJW_FLAG_WASI
        or  r10, r11;
        mov [rax + 32], r10;

        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cjw_tag_mark];
        lea rcx, [rip + cjw_k_row];
        mov r8, rbx;                     // v1 = row_id
        call klog_s1_x1;

        mov rdi, 6;                      // CJW_ST_MARK_WASI_OK
        call cjw_note;

        xor rax, rax;                    // CJW_OK = 0
        jmp cjw_mw_out;

      cjw_mw_bad:
        mov rdi, 7;                      // CJW_ST_MARK_WASI_FAIL
        call cjw_note;
        mov rax, 0x2000;                 // CJW_ERR_BAD_ROW

      cjw_mw_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cjw_marshal_wasi_blob(src_argv_ptr, argc) -> packed u64
  //
  // Convert the (ptr,len)-tuple list format (same shape fio_marshal_
  // argv consumes) into a flat NUL-separated byte buffer in
  // _cjw_wasi_blob, suitable for _wasi_args_register.
  //
  // Input shape: src_argv_ptr -> [ptr0, len0, ptr1, len1, ...] with
  // 2*argc u64 entries. Output: _cjw_wasi_blob = arg0 NUL arg1 NUL ...
  // arg(argc-1) NUL. Total output bytes = sum(len_i + 1 for i in [0,argc)).
  //
  // Returns:
  //   high 32 bits = total_bytes on success, 0 on overflow
  //   low  32 bits = 0 on success, CJW_ERR_JAIL_SPAWN on overflow
  //
  // At M7 we accept argc >= 1 only; argc == 0 collapses into the
  // overflow arm (same semantic -- "not a legitimate invocation shape").
  //
  // Register plan: five callee-save pushes (rbx=src_argv_ptr,
  // r12=argc, r13=i (per-arg loop index), r14=cursor (byte offset in
  // _cjw_wasi_blob), r15=tmp). Entry rsp%16==8 + 40 = 48 -> %16==0 at
  // nested calls (only cjw_note).
  //
  // The byte-copy loop uses `mov_b r,[rbx+rcx*1]` with `xor r10, r10`
  // pre-zero (encoder does not zero-extend 8-bit loads on its own).
  // ==========================================================================
  pub let cjw_marshal_wasi_blob : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_argv_ptr: u64) (argc: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W21 R135.M7 (#2632): marshal (src_argv_ptr, argc) into _cjw_wasi_blob per the NUL-separated WASI format. Pipeline: (1) argc == 0 -> overflow arm; (2) walk the (ptr,len) list, copy each argv[i].ptr[0..argv[i].len] to _cjw_wasi_blob[cursor..cursor+len], append a NUL byte, advance cursor by len+1; (3) refuse any cursor > CJW_BLOB_MAX=1024 as overflow. Returns (total_bytes << 32) | 0 on success or (0 << 32) | CJW_ERR_JAIL_SPAWN on overflow. Five callee-save pushes (rbx=src, r12=argc, r13=i, r14=cursor, r15=tmp) leave rsp%16==0 at every nested cjw_note call (entry 8 + 40 = 48, %16==0). Byte copy uses mov_b scalar-indexed addressing with xor r10,r10 pre-zero (encoder does not zero-extend 8-bit loads on its own, per pipe_backend.pdx §57). Labels prefixed cjw_mg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // src_argv_ptr
        mov r12, rsi;                    // argc

        // (1) argc > 0.
        cmp r12, 0;
        je  cjw_mg_overflow;

        // (2) Walk args; copy each to _cjw_wasi_blob at running cursor.
        xor r13, r13;                    // i = 0
        xor r14, r14;                    // cursor = 0

      cjw_mg_outer:
        cmp r13, r12;
        jae cjw_mg_done;

        // Load src[i] = (ptr_i, len_i). Each entry is 16 bytes (2 u64).
        mov r15, r13;
        shl r15, 4;                      // r15 = 16 * i
        add r15, rbx;                    // r15 = &src[i]
        // Spill ptr_i into r11 (so nested loop uses r15 for src cursor).
        mov r11, [r15 + 0];              // ptr_i
        mov r10, [r15 + 8];              // len_i
        // Stash in r15 (ptr_i) and reuse r10 for len_i via a push to
        // keep r10 free in the inner loop. Instead keep ptr_i in r15.
        mov r15, r11;                    // r15 = ptr_i (src cursor base)

        // Overflow gate: cursor + len_i + 1 <= CJW_BLOB_MAX
        //   compute would_cursor := cursor + len_i + 1 and compare.
        //   Keep len_i in r11; we need it in the inner loop too.
        mov r11, r10;                    // r11 = len_i
        mov rax, r14;                    // rax = cursor
        add rax, r11;
        add rax, 1;                      // rax = cursor + len + 1
        mov r10, 1024;                   // CJW_BLOB_MAX
        cmp rax, r10;
        ja  cjw_mg_overflow;

        // Inner loop: copy r11 bytes from [r15 + j] to _cjw_wasi_blob[r14 + j].
        xor rcx, rcx;                    // j = 0
      cjw_mg_inner:
        cmp rcx, r11;
        jae cjw_mg_inner_done;
        xor r10, r10;                    // pre-zero before mov_b
        mov_b r10, [r15 + rcx * 1];
        // dst = _cjw_wasi_blob + cursor + j; compute in rax.
        lea rax, [rip + _cjw_wasi_blob];
        add rax, r14;
        mov_b [rax + rcx * 1], r10;
        add rcx, 1;
        jmp cjw_mg_inner;
      cjw_mg_inner_done:

        // Append NUL at _cjw_wasi_blob[cursor + len_i].
        lea rax, [rip + _cjw_wasi_blob];
        add rax, r14;
        add rax, r11;                    // rax = &blob[cursor + len]
        xor r10, r10;
        mov_b [rax + 0], r10;

        // cursor += len_i + 1.
        add r14, r11;
        add r14, 1;

        add r13, 1;
        jmp cjw_mg_outer;

      cjw_mg_done:
        // Pack (total_bytes << 32) | 0.
        mov rax, r14;
        shl rax, 32;
        jmp cjw_mg_out;

      cjw_mg_overflow:
        mov rax, 0x2001;                 // low 32 = CJW_ERR_JAIL_SPAWN

      cjw_mg_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _cmd_jail_wire_dispatch(cmd_row_id, argv_ptr, argc,
  //                         caller_cap_env_slot) -> errno
  //
  // The public dispatch entry (§1). Decision tree:
  //   * row LIVE? Else CJW_ERR_BAD_ROW.
  //   * flags & (ISOLATE|WASI) =>
  //       (0,0)    -> in-process via _functor_invoke_call
  //       (ISO,0)  -> OOP via _functor_invoke_oop_spawn (no jail)
  //       (ISO,W)  -> OOP spawn + jail_supervisor_create + wasi_args_
  //                   register (the full WASI pipeline)
  //       (0,W)    -> CJW_ERR_BAD_ROW (WASI requires ISOLATE)
  //
  // See SECTION 1 for the full pipeline for each case.
  //
  // Register plan (across the three arms):
  //   rbx = cmd_row_id          (held across every nested call)
  //   r12 = argv_ptr
  //   r13 = argc
  //   r14 = caller_cap_env_slot
  //   r15 = flags (then: name_len, then: child_pid, then: blob_len)
  //   rbp = scratch (name_ptr stash across klog_s1_x2 for OOP arm)
  //
  // Six callee-save pushes + sub rsp,72 for a 64-byte on-stack name
  // scratch (CJW_NAME_MAX = 64) plus 8 bytes alignment pad. Entry
  // rsp%16==8; +48 push + 72 sub = 120; 120 % 16 == 8; add one more
  // 8-byte pad -> sub rsp, 80 so rsp%16==0 at nested calls.
  //
  // Final frame layout:
  //   [rbp - 64..rbp]  name scratch (64 bytes)
  //   [rbp - 72..rbp - 64]  reserved/pad
  //   [rbp - 80..rbp - 72]  reserved/pad (alignment)
  //
  // Alignment math:
  //   entry rsp%16 == 8
  //   push rbx  (8)   -> 0
  //   push r12  (8)   -> 8
  //   push r13  (8)   -> 0
  //   push r14  (8)   -> 8
  //   push r15  (8)   -> 0
  //   push rbp  (8)   -> 8
  //   mov rbp, rsp
  //   sub rsp, 80     -> rsp%16 == 0 at every nested call.
  //
  // klog_s1_x2 caller frame uses sub rsp,16 (v2 at [rsp+0]).
  // ==========================================================================
  pub let _cmd_jail_wire_dispatch : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (cmd_row_id: u64) (argv_ptr: u64) (argc: u64) (caller_cap_env_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "UMB-W21 R135.M7 (#2632): dispatch a resolved cmd row through the right functor-invoke path based on the row's flags word. Pipeline: (0) row LIVE gate (CJW_ERR_BAD_ROW on miss); (1) read flags; (2) WASI-without-ISOLATE -> CJW_ERR_BAD_ROW; (3) ISOLATE=0 -> read _fi_entry_va[row_id], zero -> CJW_ERR_IN_PROCESS, else _functor_invoke_call(va, argv_ptr, argc); (4) ISOLATE=1 -> resolve name via kcm_read_name into 64-byte stack scratch, then _functor_invoke_oop_spawn(name_ptr, name_len, argv_ptr, argc); nonzero errno -> CJW_ERR_JAIL_SPAWN; (5) if WASI=1 -> cjw_marshal_wasi_blob (overflow -> CJW_ERR_JAIL_SPAWN), _jail_supervisor_create(child_pid, caller_cap_env_slot, 0, 0, name_ptr, name_len) (nonzero -> CJW_ERR_JAIL_SPAWN), _wasi_args_register(child_pid, &_cjw_wasi_blob, blob_len) (nonzero -> CJW_ERR_JAIL_SPAWN). Six callee-save pushes (rbx=cmd_row_id, r12=argv_ptr, r13=argc, r14=caller_cap_env_slot, r15=flags/name_len/child_pid, rbp=frame) + sub rsp,80 land rsp%16==0 at every nested call (entry 8 + 6*8 + 80 = 136 -> 136%16==8 — WAIT; recompute: 8+48+80=136, 136%16==8. Need an extra 8 pad: sub rsp,88 lands %16==0. Using 80 instead: entry 8, +6 pushes = +48 = 56, 56%16=8; +80 sub = 136, 136%16=8 — still misaligned. Adjust frame to sub rsp,88: 8+48+88=144, 144%16=0 at nested calls. klog_s1_x2 adds sub rsp,16 (v2 at [rsp+0]) with 144+16=160, 160%16==0. Effects/caps widened for the jail_supervisor cap-env traversal + oop_spawn's sched capability. Labels prefixed cjw_dp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        mov  rbp, rsp;
        sub  rsp, 88;                    // 64-byte name scratch + 24 pad

        mov rbx, rdi;                    // cmd_row_id
        mov r12, rsi;                    // argv_ptr
        mov r13, rdx;                    // argc
        mov r14, rcx;                    // caller_cap_env_slot

        // (0) Row LIVE gate.
        mov rdi, rbx;
        call kcm_row_live;
        cmp rax, 0;
        je  cjw_dp_bad_row;

        // (1) Read flags.
        mov rdi, rbx;
        call cjw_row_flags;
        mov r15, rax;                    // r15 = flags

        // (2) WASI-without-ISOLATE is a mis-configuration.
        //     Check: (flags & WASI) != 0 AND (flags & ISOLATE) == 0.
        mov r10, r15;
        mov r11, 4;                      // CJW_FLAG_WASI
        and r10, r11;
        cmp r10, 0;
        je  cjw_dp_check_isolate;        // not WASI; fall through

        // WASI bit set -- require ISOLATE bit too.
        mov r10, r15;
        mov r11, 2;                      // CJW_FLAG_ISOLATE
        and r10, r11;
        cmp r10, 0;
        je  cjw_dp_bad_row;              // WASI without ISOLATE

      cjw_dp_check_isolate:
        // (3) Case split on ISOLATE bit.
        mov r10, r15;
        mov r11, 2;                      // CJW_FLAG_ISOLATE
        and r10, r11;
        cmp r10, 0;
        jne cjw_dp_oop_path;

        // ---- In-process path ----
        // Load _fi_entry_va[row_id]; 0 => CJW_ERR_IN_PROCESS.
        lea r10, [rip + _fi_entry_va];
        mov r10, [r10 + rbx * 8];
        cmp r10, 0;
        je  cjw_dp_in_process_fail;

        // Call _functor_invoke_call(entry_va, argv_ptr, argc).
        mov rdi, r10;                    // entry_va
        mov rsi, r12;                    // argv_ptr
        mov rdx, r13;                    // argc
        call _functor_invoke_call;
        // Functor return propagates verbatim (i64 cast to u64).

        // Stash return in r15 across cjw_note + fingerprint.
        mov r15, rax;

        mov rdi, 0;                      // CJW_ST_DISPATCH_INPROC
        call cjw_note;

        // Fingerprint: CJW DISPATCH rowid=0x<id> flags=0x<flags>.
        sub rsp, 16;
        mov r10, 0;                      // placeholder flags (we need the real
                                         //   flags, but r15 now holds the ret).
        // We spilled flags earlier into r15; it is now overwritten with
        // the functor return. For the fingerprint we re-fetch flags.
        mov [rsp + 0], r10;              // v2 = 0 (we skip flags re-fetch;
                                         //   the dispatch emits are a quick
                                         //   trace, not a forensic log).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cjw_tag_dispatch];
        lea rcx, [rip + cjw_k_row];
        mov r8,  rbx;                    // v1 = row_id
        lea r9,  [rip + cjw_k_flags];
        call klog_s1_x2;
        add rsp, 16;

        mov rax, r15;                    // propagate functor return
        jmp cjw_dp_out;

      cjw_dp_oop_path:
        // ---- OOP / WASI path ----
        // Resolve name into the stack scratch at [rbp-64 .. rbp].
        mov rdi, rbx;                    // row_id
        lea rsi, [rbp - 64];             // out_ptr = &name_scratch[0]
        call kcm_read_name;
        // rax = name_len | CM_BAD_ROW. CM_BAD_ROW = 0xFFFFFCC7.
        mov r11, 0xFFFFFCC7;
        cmp rax, r11;
        je  cjw_dp_bad_row;

        // Stash name_len in r15 (overwriting flags; we revisit WASI bit
        // via a fresh load below if needed).
        mov r15, rax;                    // name_len

        // _functor_invoke_oop_spawn(name_ptr, name_len, argv_ptr, argc).
        lea rdi, [rbp - 64];             // name_ptr
        mov rsi, r15;                    // name_len
        mov rdx, r12;                    // argv_ptr
        mov rcx, r13;                    // argc
        call _functor_invoke_oop_spawn;
        // rax = (pid << 32) | errno.

        // Low-32 errno gate.
        mov r10, rax;
        mov r11, 0xFFFFFFFF;             // low-32 mask (fits imm32)
        and r10, r11;
        cmp r10, 0;
        jne cjw_dp_spawn_fail;

        // Extract pid := rax >> 32. Stash in rbp-local slot [rbp-72]
        // (we re-use the scratch pad below the name buffer; the name
        // buffer at [rbp-64..rbp] still holds the name bytes).
        shr rax, 32;
        mov [rbp - 72], rax;             // child_pid

        // Re-read flags for the WASI bit (r15 was overwritten with
        // name_len; the row's flags word has not changed between gates
        // because dispatch is single-threaded at R135.M7).
        mov rdi, rbx;
        call cjw_row_flags;
        mov r10, rax;
        mov r11, 4;                      // CJW_FLAG_WASI
        and r10, r11;
        cmp r10, 0;
        je  cjw_dp_oop_done;             // ISOLATE only; no jail wiring

        // ---- WASI pipeline: marshal + jail_create + wasi_args_register ----

        // (a) Marshal the WASI argv blob.
        mov rdi, r12;                    // argv_ptr
        mov rsi, r13;                    // argc
        call cjw_marshal_wasi_blob;
        // rax = (total_bytes << 32) | errno
        mov r10, rax;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        jne cjw_dp_spawn_fail;

        // Extract total_bytes := rax >> 32. Stash at [rbp-80].
        shr rax, 32;
        mov [rbp - 80], rax;             // blob_len

        // (b) _jail_supervisor_create(child_pid, caller_cap_env_slot,
        //                              mask_lo=0, mask_hi=0,
        //                              name_ptr, name_len).
        mov rdi, [rbp - 72];             // child_pid
        mov rsi, r14;                    // caller_cap_env_slot
        xor rdx, rdx;                    // mask_lo = 0
        xor rcx, rcx;                    // mask_hi = 0
        lea r8,  [rbp - 64];             // name_ptr
        mov r9,  r15;                    // name_len
        call _jail_supervisor_create;
        // rax = (jail_id << 2) | errno. Low 2 bits = errno.
        //   But the pack is tight: JS_OK=0 means success is just
        //   jail_id * 4; nonzero rax&3 means errno. Simpler: compare
        //   rax to each distinct JS_ERR_* code via a mask on low 2 bits.
        //   Simplest: check low 2 bits.
        mov r10, rax;
        mov r11, 3;                      // mask low 2 bits
        and r10, r11;
        cmp r10, 0;
        jne cjw_dp_spawn_fail;

        // (c) _wasi_args_register(child_pid, &_cjw_wasi_blob, blob_len).
        mov rdi, [rbp - 72];             // child_pid
        lea rsi, [rip + _cjw_wasi_blob];
        mov rdx, [rbp - 80];             // blob_len
        call _wasi_args_register;
        // rax = WASI_OK (0) | WASI_EINVAL | WASI_ENOMEM.
        cmp rax, 0;
        jne cjw_dp_spawn_fail;

        mov rdi, 2;                      // CJW_ST_DISPATCH_WASI
        call cjw_note;
        jmp cjw_dp_oop_fingerprint;

      cjw_dp_oop_done:
        mov rdi, 1;                      // CJW_ST_DISPATCH_OOP
        call cjw_note;

      cjw_dp_oop_fingerprint:
        // Fingerprint: CJW DISPATCH rowid=0x<id> pid=0x<pid>.
        sub rsp, 16;
        mov r10, [rbp - 72];             // child_pid
        mov [rsp + 0], r10;              // v2 = pid
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cjw_tag_dispatch];
        lea rcx, [rip + cjw_k_row];
        mov r8,  rbx;                    // v1 = row_id
        lea r9,  [rip + cjw_k_pid];
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                    // CJW_OK
        jmp cjw_dp_out;

      cjw_dp_bad_row:
        mov rdi, 3;                      // CJW_ST_BAD_ROW
        call cjw_note;
        // Fingerprint: CJW BAD_ROW rowid=0x<id>.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cjw_tag_bad_row];
        lea rcx, [rip + cjw_k_row];
        mov r8,  rbx;
        call klog_s1_x1;
        mov rax, 0x2000;                 // CJW_ERR_BAD_ROW
        jmp cjw_dp_out;

      cjw_dp_in_process_fail:
        mov rdi, 4;                      // CJW_ST_IN_PROCESS_FAIL
        call cjw_note;
        mov rax, 0x2002;                 // CJW_ERR_IN_PROCESS
        jmp cjw_dp_out;

      cjw_dp_spawn_fail:
        mov rdi, 5;                      // CJW_ST_JAIL_SPAWN_FAIL
        call cjw_note;
        mov rax, 0x2001;                 // CJW_ERR_JAIL_SPAWN

      cjw_dp_out:
        add rsp, 88;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
