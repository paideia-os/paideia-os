// src/kernel/core/shell/cmd_registry.pdx -- R123.M2 (paideia-os #2504)
//
// On-disk command-registry parser + in-memory LRU cache for the R123
// semantic-shell command-loader path. Sits on top of the R123.M1
// KIND_CMD_MODULE substrate (src/kernel/core/cap/cmd_module.pdx): the
// LRU cache stores <name, cap_handle> tuples where cap_handle is the
// row_idx returned by cmd_module_alloc (or, when the R123.M3 dispatch
// integration lands, a full cap_table slot number). The load path
// walks the CoW FS to <root>/shell/commands.toml, parses the file body
// per design/terminal/command-registry.md §CRG-D1 (subset -- see §5
// SCOPE below), mints one KIND_CMD_MODULE per entry via
// cmd_module_alloc, and inserts the resulting handle into the cache.
//
// =============================================================================
// SECTION 0  SCOPE -- what R123.M2 lands vs. what a follow-up owns
// =============================================================================
//
// LANDED HERE (R123.M2):
//   (1) 256-entry LRU cache (init / lookup / insert with true LRU
//       eviction on full, dedup on insert).
//   (2) cmd_registry_load(root_path_ptr, root_path_len) -> u32 that
//       constructs <root>/shell/commands.toml in a scratch buffer,
//       calls vfs_open / vfs_read / vfs_close, and hands the body to
//       cr_parse_toml. Returns 0 gracefully on file-absent
//       (vfs_open returns 0 sentinel).
//   (3) Two-tier lookup at the caller: kernel_main.pdx invokes
//       cmd_registry_load twice (system root + user root) so a user's
//       shell can shadow / extend the system table per CRG-D4.
//
// DEFERRED (R123.M2-followup, tracked as paideia-os follow-up issue):
//   (a) Full TOML field extraction. This file lands cr_parse_toml as a
//       structural walker that recognises `[[commands]]` headers and
//       returns the header count so the load path returns a truthful
//       count; per-key value extraction (name / version_maj /
//       version_min / functor_id / in_process / cap_env) + the
//       cmd_module_alloc + cmd_registry_insert cascade for each parsed
//       entry is left to the follow-up. Justification: the R123.M2
//       acceptance criterion is the witness fingerprint
//       `cmd registry loaded system=3 user=0` from an in-memory seed
//       via cmd_registry_insert (per parent briefing); the on-disk
//       file will not exist at first boot (the CoW FS is empty at
//       R123.M2 landing time), so a full parser is exercised on no
//       real input at boot and would land untested. The follow-up
//       lands with a seeded /system/shell/commands.toml + an
//       acceptance smoke that reads it back through the parser.
//   (b) PQ signature verification per CRG-D3. Per parent briefing:
//       "For R123.M2 skip PQ signature verification (deferred to a
//       follow-up); parse the TOML file body directly." A follow-up
//       will wire libpdx-pq into the per-entry gate.
//   (c) cap_invoke integration for KIND_CMD_MODULE (READ / INCREF /
//       DECREF ops accessible via ring-3 cap_invoke). Owned by
//       R123.M3 per the R123 briefing.
//
// =============================================================================
// SECTION 1  SPEC-vs-CODEBASE RECONCILIATION -- registry field shape
// =============================================================================
//
// design/terminal/command-registry.md §CRG-D1 illustrates the on-disk
// format as `[command."find"]` inline-table with fields substrate,
// binary, schema_input, schema_output, capabilities, version,
// signature. The parent R123.M2 briefing (paideia-os #2504) instead
// specifies:
//
//   [[commands]]
//   name = "..."
//   version_maj = <n>
//   version_min = <n>
//   functor_id = <n>
//   in_process = true|false
//   cap_env = "0x..."
//
// which is the shape that MAPS 1:1 to the KIND_CMD_MODULE row layout
// (name[24] + version_maj u16 + version_min u16 + functor_id u32 +
// in_process u8 + cap_env_ptr u64). The design doc's illustrative
// shape does not carry a functor_id and rides on a different name-
// >binary indirection (substrate=wasm / binary=/path/to.wasm) that
// R125+ will wire under a different set of substrate keys.
//
// Per feedback_spec_vs_codebase_conflicts: PRESERVE the binding
// invariant (the KIND_CMD_MODULE row layout, frozen in R123.M1) and
// FLAG the design-doc drift. cr_parse_toml in this file lands the
// briefing's `[[commands]]` array-of-tables shape; a follow-up will
// reconcile design/terminal/command-registry.md §CRG-D1 to match.
//
// =============================================================================
// SECTION 2  CACHE LAYOUT
// =============================================================================
//
// 256 entries * 32 bytes = 8192 bytes = 1024 u64. Row stride 32 =
// shl 5 (single shift, avoids the 2-op `imul r, imm` encoder pitfall).
//
// Per-entry layout (32 bytes, 4 u64 words):
//   [+0]  name_lo    (u64; name[0..7]  packed little-endian)
//   [+8]  name_mid   (u64; name[8..15] packed little-endian)
//   [+16] name_hi    (u64; name[16..23] packed little-endian; NUL-pad
//                    on short names -- cache init zero-scrubs)
//   [+24] flags      (u64):
//         cap_handle    [31:0]   -- u32 cap handle (0 = free slot)
//         tick          [63:32]  -- u32 monotonic LRU tick
//
// Free-slot sentinel: flags word == 0 (both cap_handle == 0 AND
// tick == 0). On init the entire table is zero-scrubbed so every
// slot is free. On insert the first free slot with the smallest
// index is claimed; on full-table insert the LRU eviction picks the
// entry with the smallest tick.
//
// Caller contract: cap_handle MUST be non-zero. Passing cap_handle
// == 0 is caller error (the entry becomes indistinguishable from a
// free slot and cmd_registry_lookup will report CR_MISS for it).
// The witness passes cap_handle in [1..3] as synthetic placeholders;
// the follow-up load path will pass the row_idx returned by
// cmd_module_alloc + 1 (so row_idx 0 encodes as stored cap_handle 1
// -- see the follow-up landing for the +1 offset discipline).
//
// =============================================================================
// SECTION 3  LRU DISCIPLINE
// =============================================================================
//
// A global monotonic tick counter (_cr_tick) is bumped on every
// successful cmd_registry_insert and every successful
// cmd_registry_lookup. Each entry's tick field is stamped with the
// then-current value. Eviction picks the entry with the smallest
// tick.
//
// Overflow: at u32_max the tick saturates and further updates are
// no-ops (LRU tracking degrades to age-frozen; subsequent evictions
// pick the same slot every time until reset). At 1 tick per shell
// command lookup, u32_max = 4 billion operations before saturation
// -- a boot-time non-issue. A follow-up can add periodic tick
// halving if this becomes real.
//
// =============================================================================
// SECTION 4  FAILURE SENTINELS
// =============================================================================
//
// cmd_registry_lookup:
//   0                       -- MISS (name not in cache; also returned
//                              for cap_handle == 0 poison entries).
//
// cmd_registry_insert:
//   0 = CR_INSERT_OK        -- inserted into a fresh free slot.
//   1 = CR_INSERT_EVICT     -- inserted after LRU-evicting the oldest
//                              entry (table was full).
//   2 = CR_INSERT_DUP       -- name already present; existing entry's
//                              tick refreshed, cap_handle NOT
//                              overwritten. Caller decides whether to
//                              free/replace out-of-band.
//   3 = CR_INSERT_BAD       -- caller passed cap_handle == 0 or
//                              name_len == 0 / > 24 or name_ptr == 0.
//
// cmd_registry_load:
//   <count of entries loaded, u32 zero-extended>
//   0 on file absent, empty file, or parse-yielded-no-entries.
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as encoder posture (feedback_pdx_encoder_pitfalls):
//   * No `test rN, rN` -- every zero-check uses `cmp reg, 0`.
//   * No 2-op `imul r, imm` -- row stride 32 uses shl 5 (single shift).
//   * No `and reg, imm64` -- 0xFFFFFFFF is staged through r10/r11.
//   * No `add reg, [mem]` / `cmp reg, [mem]` -- every memory operand
//     lands in a register first.
//   * No `mov_b [mem]` byte-store where a qword store suffices;
//     mov_b is used for byte loads (with explicit *1 SIB) and byte
//     stores in the name-pack loop only, matching cmd_module.pdx
//     §13 posture.
//   * Reserved-label prefix `cr_` (short for cmd_registry) avoids
//     the `loop`/`if`/`top`/`done` collision class per
//     feedback_paideia_as_reserved_labels; inner labels also carry
//     a second-level prefix (cr_in_ init, cr_nt_ note, cr_np_ name-
//     pack, cr_lu_ lookup, cr_is_ insert, cr_ev_ evict-scan,
//     cr_ld_ load, cr_pt_ parse-toml, cr_pl_ parse-line).

module CmdRegistry = structure {

  // =========================================================================
  // SECTION 6  CONSTANTS
  // =========================================================================

  pub let CR_MAX_ENTRIES   : u64 = 256
  pub let CR_ROW_BYTES     : u64 = 32
  pub let CR_NAME_MAX      : u64 = 24
  pub let CR_LOAD_BUF_CAP  : u64 = 4096
  pub let CR_PATH_SCRATCH  : u64 = 256

  // Insert return codes (§4).
  pub let CR_INSERT_OK    : u64 = 0
  pub let CR_INSERT_EVICT : u64 = 1
  pub let CR_INSERT_DUP   : u64 = 2
  pub let CR_INSERT_BAD   : u64 = 3

  // Lookup sentinel.
  pub let CR_MISS         : u64 = 0

  // Storage: 256 rows * 32 bytes = 8192 bytes = 1024 u64.
  pub let mut _cmd_registry_table : [u64; 1024] = uninit @align(64)
  pub let mut _cmd_registry_stats : [u64; 8]    = uninit @align(64)
  pub let mut _cr_tick            : u64         = 0

  // Path scratch: <root>/shell/commands.toml where root is up to
  // CR_PATH_SCRATCH - len("/shell/commands.toml\0") = 256 - 21 = 235
  // bytes. Ample for a system root ("/system") or a user root
  // ("/users/<u>") at first boot.
  pub let mut _cr_path_scratch    : [u8; 256]   = uninit @align(8)

  // Load buffer: reads up to CR_LOAD_BUF_CAP (4096) bytes from the
  // registry file. A first-cut ceiling; the CoW FS TOML is expected
  // to hold ~10-40 command entries at 100-200 bytes each = 1-8 KB.
  // If the file exceeds this, cmd_registry_load parses only the
  // first CR_LOAD_BUF_CAP bytes and returns the count seen there
  // (truncation is silent -- a follow-up will add a bounded-file
  // sentinel + audit-emit).
  pub let mut _cr_load_buf        : [u8; 4096]  = uninit @align(64)

  // Path suffix + hard-coded system/user root strings. The user root
  // stays at `/users` for R123.M2 (the boot smoke has no per-uid
  // resolution -- multi-user extension will replace this with a
  // per-tcb-uid-derived path). Length constants (excluding NUL) are
  // used by the boot-time load call in kernel_main.pdx.
  //   cr_path_suffix   : "/shell/commands.toml" -- 20 chars + NUL = 21.
  //   cr_system_root   : "/system"              --  7 chars + NUL =  8.
  //   cr_user_root     : "/users"               --  6 chars + NUL =  7.
  pub let cr_path_suffix    : [u8; 21] = "/shell/commands.toml\0"
  pub let cr_system_root    : [u8; 8]  = "/system\0"
  pub let cr_user_root      : [u8; 7]  = "/users\0"
  pub let CR_SYSTEM_ROOT_LEN : u64 = 7
  pub let CR_USER_ROOT_LEN   : u64 = 6

  // Stats indices.
  pub let CR_ST_INSERTS       : u64 = 0
  pub let CR_ST_LOOKUP_HITS   : u64 = 1
  pub let CR_ST_LOOKUP_MISSES : u64 = 2
  pub let CR_ST_EVICTIONS     : u64 = 3
  pub let CR_ST_DUPS          : u64 = 4
  pub let CR_ST_LOADS         : u64 = 5
  pub let CR_ST_MAX           : u64 = 8

  // =========================================================================
  // SECTION 7  cmd_registry_init() -> ()
  // =========================================================================
  //
  // Boot / teardown scrub of the LRU table, the stats table, and
  // the tick counter. .bss already starts zero at real boot;
  // defensive, matches cmd_module_init one-for-one. Called from
  // kernel_main's derived-kind reset cascade (adjacent to
  // cmd_module_init).

  pub let cmd_registry_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): defensive scrub of _cmd_registry_table (1024 u64 = 8192 bytes), _cmd_registry_stats (8 u64), and _cr_tick. Three straight-line loops / stores, mirrors cmd_module_init posture. Labels prefixed cr_in_.",
      block: {
        lea r10, [rip + _cmd_registry_table];
        xor rax, rax;
        xor rcx, rcx;
      cr_in_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 1024;
        jb  cr_in_rows;

        lea r10, [rip + _cmd_registry_stats];
        xor rcx, rcx;
      cr_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cr_in_stats;

        mov [rip + _cr_tick], rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 8  cr_note(which) -- bounded stats increment.
  // =========================================================================

  pub let cr_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): bounded stats increment on _cmd_registry_stats. Load-inc-store idiom. Labels prefixed cr_nt_.",
      block: {
        cmp rdi, 8;
        jae cr_nt_out;
        lea r10, [rip + _cmd_registry_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cr_nt_out:
        ret
      }
    }

  // =========================================================================
  // SECTION 9  cr_bump_tick() -> u64
  //
  // Monotonically increment _cr_tick, saturating at u32_max. Returns
  // the NEW tick value (post-increment). At saturation returns
  // u32_max verbatim on every call (LRU tracking freezes).
  // =========================================================================

  pub let cr_bump_tick : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): bump _cr_tick, saturating at u32_max (0xFFFFFFFF). Load-modify-store. Labels prefixed cr_bt_.",
      block: {
        mov rax, [rip + _cr_tick];
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        jae cr_bt_out;                   // already saturated
        add rax, 1;
        mov [rip + _cr_tick], rax;
      cr_bt_out:
        ret
      }
    }

  // =========================================================================
  // SECTION 10  cr_pack_name(name_ptr, name_len, out_ptr) -> ()
  //
  // Byte-walks up to CR_NAME_MAX bytes from name_ptr into a 24-byte
  // (3 u64) zero-padded scratch at out_ptr. Caller guarantees
  // out_ptr addresses at least 24 zeroable bytes; this function
  // zeroes them before the copy (so short names naturally pad).
  // Caller guarantees name_len in [0..CR_NAME_MAX]; over-length
  // names are silently truncated at 24 bytes.
  // =========================================================================

  pub let cr_pack_name : (u64, u64, u64) -> () !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): pack up to 24 bytes from name_ptr into the 3-u64 slot at out_ptr, zero-padded. Caller supplies both pointers; zero-scrubs the 24 out bytes first, then byte-copies min(name_len, 24) bytes. Labels prefixed cr_np_.",
      block: {
        // Zero the 24-byte scratch (three qword stores).
        xor rax, rax;
        mov [rdx + 0],  rax;
        mov [rdx + 8],  rax;
        mov [rdx + 16], rax;

        // Clamp name_len to 24.
        mov rcx, rsi;
        cmp rcx, 24;
        jbe cr_np_len_ok;
        mov rcx, 24;
      cr_np_len_ok:
        // Byte-copy loop. rcx = remaining, rdi = src, rdx = dst.
        xor r8, r8;                      // i = 0
      cr_np_loop:
        cmp r8, rcx;
        jae cr_np_out;
        xor r10, r10;                    // pre-clear (mov_b does not
                                         //   zero-extend)
        mov_b r10, [rdi + r8 * 1];
        mov_b [rdx + r8 * 1], r10;
        add r8, 1;
        jmp cr_np_loop;
      cr_np_out:
        ret
      }
    }

  // =========================================================================
  // SECTION 11  cmd_registry_lookup(name_ptr, name_len) -> u64
  //
  // Returns cap_handle (nonzero) on hit, 0 (CR_MISS) on miss.
  // Bumps the hit's LRU tick and CR_ST_LOOKUP_HITS on hit;
  // bumps CR_ST_LOOKUP_MISSES on miss. Linear scan over 256 rows;
  // for each row with a nonzero cap_handle, compares all 3 name
  // qwords.
  //
  // Register plan: five callee-save pushes (rbx = row cursor,
  // r12/r13/r14 = packed name lo/mid/hi, r15 = row base pointer)
  // leave rsp%16==0 at every nested call. Local 24-byte name
  // scratch on the stack; the 32-byte sub keeps alignment at 0.
  // =========================================================================

  pub let cmd_registry_lookup : (u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): linear scan over the 256-entry LRU cache for a name match. Register plan: five callee-save pushes (rbx = row idx cursor, r12/r13/r14 = packed name lo/mid/hi, r15 = table base ptr) leave rsp%16==0 at nested calls (entry rsp%16==8; +40 -> %16==0; then sub rsp,32 stays at 0). Bumps CR_ST_LOOKUP_HITS + entry tick on match; bumps CR_ST_LOOKUP_MISSES on miss. Labels prefixed cr_lu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 32;                    // scratch (24 bytes + 8 pad)

        // Pack the query name into local scratch [rsp+0..+23].
        mov rax, rsp;
        // rdi = name_ptr, rsi = name_len already; add out_ptr in rdx.
        mov rdx, rax;
        call cr_pack_name;

        // Load packed name into r12/r13/r14.
        mov r12, [rsp + 0];
        mov r13, [rsp + 8];
        mov r14, [rsp + 16];

        lea r15, [rip + _cmd_registry_table];
        xor rbx, rbx;                    // idx = 0

      cr_lu_scan:
        cmp rbx, 256;
        jae cr_lu_miss;

        // r11 = row base = r15 + idx * 32.
        mov r11, rbx;
        shl r11, 5;                      // idx * 32
        add r11, r15;                    // row ptr

        // flags word.
        mov rax, [r11 + 24];
        // cap_handle = flags[31:0]; if zero, slot is free -- skip.
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        je  cr_lu_next;

        // Compare name qwords.
        mov rax, [r11 + 0];
        cmp rax, r12;
        jne cr_lu_next;
        mov rax, [r11 + 8];
        cmp rax, r13;
        jne cr_lu_next;
        mov rax, [r11 + 16];
        cmp rax, r14;
        jne cr_lu_next;

        // Hit. Repurpose rbx (idx cursor, done) to hold row_ptr
        // across nested calls -- avoids push/pop alignment fuss.
        mov rbx, r11;

        // Extract cap_handle now (before tick overwrite); stash in
        // r12 (name_lo, done -- name compare above used it).
        mov rax, [rbx + 24];
        mov r10, 0xFFFFFFFF;
        and rax, r10;                    // cap_handle
        mov r12, rax;                    // r12 = cap_handle stash

        call cr_bump_tick;               // rax = new tick

        // Overwrite the flags high 32 bits with the new tick.
        mov r10, [rbx + 24];             // old flags
        mov rcx, 0xFFFFFFFF;
        and r10, rcx;                    // keep cap_handle low 32
        shl rax, 32;                     // tick into high 32
        or  r10, rax;
        mov [rbx + 24], r10;

        // Stats bump.
        mov rdi, 1;                      // CR_ST_LOOKUP_HITS
        call cr_note;

        mov rax, r12;                    // restore cap_handle for return
        jmp cr_lu_out;

      cr_lu_next:
        add rbx, 1;
        jmp cr_lu_scan;

      cr_lu_miss:
        mov rdi, 2;                      // CR_ST_LOOKUP_MISSES
        call cr_note;
        xor rax, rax;                    // CR_MISS

      cr_lu_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // SECTION 12  cmd_registry_insert(cap_handle, name_ptr, name_len) -> u32
  //
  // Insert one entry. Returns:
  //   CR_INSERT_OK    (0) -- inserted into a fresh free slot
  //   CR_INSERT_EVICT (1) -- inserted after evicting the LRU entry
  //   CR_INSERT_DUP   (2) -- name already present; entry's tick
  //                          refreshed, cap_handle NOT overwritten
  //   CR_INSERT_BAD   (3) -- cap_handle == 0 OR name_ptr == 0 OR
  //                          name_len not in [1..24]
  //
  // Algorithm:
  //   (1) Validate inputs. Refuse with CR_INSERT_BAD on any gate.
  //   (2) Pack the query name into local scratch.
  //   (3) Dedup scan: if any live entry's 3-name-qwords match,
  //       refresh its tick and return CR_INSERT_DUP.
  //   (4) Free-slot scan: first row with flags == 0 -- claim it,
  //       stamp {cap_handle, fresh tick}, return CR_INSERT_OK.
  //   (5) LRU evict: scan for the row with the smallest tick,
  //       overwrite name + flags, return CR_INSERT_EVICT.
  //
  // Register plan: five callee-save pushes (rbx = phase / row
  // cursor, r12/r13/r14 = packed name lo/mid/hi, r15 = cap_handle
  // stash across calls). sub rsp,32 for local scratch stays 16-
  // aligned at nested calls.
  // =========================================================================

  pub let cmd_registry_insert : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (cap_handle: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): insert one entry with dedup / free-slot / LRU-evict fallback cascade. Gate: cap_handle != 0 AND name_ptr != 0 AND name_len in [1..24] AND cap_handle low 32 bits nonzero (the stored form). Register plan: five callee-save pushes (rbx = row cursor, r12/r13/r14 = packed name lo/mid/hi, r15 = cap_handle stashed across cr_pack_name / cr_bump_tick / cr_note nested calls). Bumps CR_ST_INSERTS on OK/EVICT, CR_ST_EVICTIONS on EVICT, CR_ST_DUPS on DUP. Labels prefixed cr_is_.",
      block: {
        // Gate.
        cmp rdi, 0;
        je  cr_is_bad_leaf;
        cmp rsi, 0;
        je  cr_is_bad_leaf;
        cmp rdx, 0;
        je  cr_is_bad_leaf;
        cmp rdx, 24;
        ja  cr_is_bad_leaf;
        // cap_handle low 32 bits must be nonzero (else stored form
        // collides with free-slot sentinel).
        mov r10, 0xFFFFFFFF;
        mov rax, rdi;
        and rax, r10;
        cmp rax, 0;
        je  cr_is_bad_leaf;

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 32;                    // scratch

        mov r15, rdi;                    // r15 = cap_handle stash

        // Pack name into scratch. cr_pack_name signature:
        //   (name_ptr, name_len, out_ptr) -> ()
        // Insert's own signature is (cap_handle, name_ptr, name_len),
        // so shift arg2/arg3 down into rdi/rsi and set rdx = scratch.
        mov rdi, rsi;                    // rdi = name_ptr (was arg2)
        mov rsi, rdx;                    // rsi = name_len (was arg3)
        mov rdx, rsp;                    // rdx = scratch out ptr
        call cr_pack_name;

        // Load packed name.
        mov r12, [rsp + 0];
        mov r13, [rsp + 8];
        mov r14, [rsp + 16];

        // ------------------------------------------------------------
        // Phase 1: dedup scan.
        // ------------------------------------------------------------
        xor rbx, rbx;                    // idx = 0
      cr_is_dup_scan:
        cmp rbx, 256;
        jae cr_is_free_scan_init;

        mov r11, rbx;
        shl r11, 5;
        lea r10, [rip + _cmd_registry_table];
        add r11, r10;                    // row ptr

        // Skip free slots.
        mov rax, [r11 + 24];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        je  cr_is_dup_next;

        // Compare name.
        mov rax, [r11 + 0];
        cmp rax, r12;
        jne cr_is_dup_next;
        mov rax, [r11 + 8];
        cmp rax, r13;
        jne cr_is_dup_next;
        mov rax, [r11 + 16];
        cmp rax, r14;
        jne cr_is_dup_next;

        // Duplicate. Refresh tick, bump CR_ST_DUPS, return
        // CR_INSERT_DUP. cap_handle is NOT overwritten (caller
        // decides whether to free the old handle out-of-band).
        // Repurpose rbx (idx cursor, done) to hold row_ptr.
        mov rbx, r11;

        call cr_bump_tick;

        mov r10, [rbx + 24];
        mov rcx, 0xFFFFFFFF;
        and r10, rcx;                    // preserve cap_handle
        shl rax, 32;
        or  r10, rax;
        mov [rbx + 24], r10;

        mov rdi, 4;                      // CR_ST_DUPS
        call cr_note;

        mov rax, 2;                      // CR_INSERT_DUP
        jmp cr_is_out;

      cr_is_dup_next:
        add rbx, 1;
        jmp cr_is_dup_scan;

        // ------------------------------------------------------------
        // Phase 2: free-slot scan (first-fit low-to-high).
        // ------------------------------------------------------------
      cr_is_free_scan_init:
        xor rbx, rbx;
      cr_is_free_scan:
        cmp rbx, 256;
        jae cr_is_evict_scan_init;

        mov r11, rbx;
        shl r11, 5;
        lea r10, [rip + _cmd_registry_table];
        add r11, r10;

        mov rax, [r11 + 24];
        cmp rax, 0;                      // whole flags word zero
                                         //   means free
        jne cr_is_free_next;

        // Claim. Repurpose rbx to row_ptr; write name + flags with
        // fresh tick.
        mov rbx, r11;

        mov [rbx + 0],  r12;
        mov [rbx + 8],  r13;
        mov [rbx + 16], r14;

        call cr_bump_tick;               // rax = new tick

        // Compose flags: (tick << 32) | (cap_handle & 0xFFFFFFFF).
        mov r10, 0xFFFFFFFF;
        mov rcx, r15;
        and rcx, r10;                    // cap_handle low 32
        shl rax, 32;
        or  rax, rcx;
        mov [rbx + 24], rax;

        mov rdi, 0;                      // CR_ST_INSERTS
        call cr_note;

        xor rax, rax;                    // CR_INSERT_OK
        jmp cr_is_out;

      cr_is_free_next:
        add rbx, 1;
        jmp cr_is_free_scan;

        // ------------------------------------------------------------
        // Phase 3: LRU evict.
        // Scan all 256 rows for the smallest tick. Track (min_tick,
        // min_idx) in (rcx, rbx). Tie-break: first row wins (idx
        // scan is low-to-high, so `<` not `<=`).
        // ------------------------------------------------------------
      cr_is_evict_scan_init:
        xor rbx, rbx;                    // min_idx = 0
        // Seed min_tick from row 0.
        lea r10, [rip + _cmd_registry_table];
        mov rax, [r10 + 24];
        shr rax, 32;                     // tick
        mov rcx, rax;                    // min_tick = row0.tick

        mov r8, 1;                       // scan cursor starts at 1
      cr_is_evict_scan:
        cmp r8, 256;
        jae cr_is_evict_claim;

        mov r11, r8;
        shl r11, 5;
        lea r10, [rip + _cmd_registry_table];
        add r11, r10;

        mov rax, [r11 + 24];
        shr rax, 32;                     // this row's tick
        cmp rax, rcx;
        jae cr_is_evict_next;

        mov rcx, rax;                    // new min_tick
        mov rbx, r8;                     // new min_idx

      cr_is_evict_next:
        add r8, 1;
        jmp cr_is_evict_scan;

      cr_is_evict_claim:
        // rbx = victim idx. Convert to row_ptr in rbx (reused --
        // idx-cursor role is done at this point).
        mov r11, rbx;
        shl r11, 5;
        lea r10, [rip + _cmd_registry_table];
        add r11, r10;
        mov rbx, r11;                    // rbx = row_ptr

        mov [rbx + 0],  r12;
        mov [rbx + 8],  r13;
        mov [rbx + 16], r14;

        call cr_bump_tick;               // rax = new tick

        mov r10, 0xFFFFFFFF;
        mov rcx, r15;
        and rcx, r10;
        shl rax, 32;
        or  rax, rcx;
        mov [rbx + 24], rax;

        mov rdi, 3;                      // CR_ST_EVICTIONS
        call cr_note;
        mov rdi, 0;                      // CR_ST_INSERTS
        call cr_note;

        mov rax, 1;                      // CR_INSERT_EVICT

      cr_is_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      cr_is_bad_leaf:
        mov rax, 3;                      // CR_INSERT_BAD
        ret
      }
    }

  // =========================================================================
  // SECTION 13  cr_parse_toml(buf_ptr, len) -> u32
  //
  // R123.M2 SKELETON. Scans the buffer for `[[commands]]` header
  // lines and returns the count observed. Does NOT extract per-key
  // values (name / version_maj / version_min / functor_id /
  // in_process / cap_env) nor invoke cmd_module_alloc /
  // cmd_registry_insert for each entry. Full parsing lands in the
  // R123.M2-followup issue -- see §0 SCOPE for the deferral
  // justification.
  //
  // Detection: a line whose first non-whitespace 12 bytes match
  // "[[commands]]" (case-sensitive). Whitespace at start = ' '
  // (0x20) or '\t' (0x09). Everything after those 12 bytes on the
  // line is ignored (a valid TOML header allows only a trailing
  // comment / whitespace; the follow-up parser will assert that).
  //
  // Line boundaries: LF (0x0A) or the buffer end. CR (0x0D) is
  // treated as whitespace / skipped by the scanner. Comments (#)
  // and blank lines are skipped.
  //
  // Register plan: four callee-save pushes (rbx = buf_ptr, r12 =
  // buf_end, r13 = count, r14 = scan cursor). No nested calls, so
  // no alignment sub / add required.
  // =========================================================================

  pub let cr_parse_toml : (u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504) SKELETON parser. Counts `[[commands]]` array-of-tables headers in the buffer; per-key value extraction deferred to R123.M2-followup. Straight-line byte scan with line-start whitespace skip and prefix compare against the 12-byte literal `[[commands]]`. No nested calls. Labels prefixed cr_pt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // buf_ptr
        mov r12, rsi;                    // len
        add r12, rdi;                    // buf_end = buf_ptr + len
        xor r13, r13;                    // count
        mov r14, rdi;                    // cursor

      cr_pt_line_start:
        cmp r14, r12;
        jae cr_pt_out;

        // Skip leading spaces / tabs / CRs.
      cr_pt_skip_ws:
        cmp r14, r12;
        jae cr_pt_out;
        xor rax, rax;
        mov_b rax, [r14 + 0];
        cmp rax, 0x20;                   // space
        je  cr_pt_ws_step;
        cmp rax, 0x09;                   // tab
        je  cr_pt_ws_step;
        cmp rax, 0x0D;                   // CR
        je  cr_pt_ws_step;
        jmp cr_pt_after_ws;
      cr_pt_ws_step:
        add r14, 1;
        jmp cr_pt_skip_ws;

      cr_pt_after_ws:
        // Blank line (LF right after ws).
        cmp rax, 0x0A;
        jne cr_pt_check_comment;
        add r14, 1;
        jmp cr_pt_line_start;

      cr_pt_check_comment:
        cmp rax, 0x23;                   // '#'
        jne cr_pt_check_header;
        // Skip to LF or EOF.
      cr_pt_comment_scan:
        cmp r14, r12;
        jae cr_pt_out;
        xor rax, rax;
        mov_b rax, [r14 + 0];
        cmp rax, 0x0A;
        je  cr_pt_comment_eol;
        add r14, 1;
        jmp cr_pt_comment_scan;
      cr_pt_comment_eol:
        add r14, 1;
        jmp cr_pt_line_start;

      cr_pt_check_header:
        // Need at least 12 bytes left to match "[[commands]]".
        mov r11, r14;
        add r11, 12;
        cmp r11, r12;
        ja  cr_pt_advance_line;          // not enough left

        // Byte-compare 12 bytes against "[[commands]]".
        xor rax, rax;
        mov_b rax, [r14 + 0];
        cmp rax, 0x5B;                   // '['
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 1];
        cmp rax, 0x5B;                   // '['
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 2];
        cmp rax, 0x63;                   // 'c'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 3];
        cmp rax, 0x6F;                   // 'o'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        cmp rax, 0x6D;                   // 'm'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 5];
        cmp rax, 0x6D;                   // 'm'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x61;                   // 'a'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x6E;                   // 'n'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 8];
        cmp rax, 0x64;                   // 'd'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 9];
        cmp rax, 0x73;                   // 's'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 10];
        cmp rax, 0x5D;                   // ']'
        jne cr_pt_advance_line;
        xor rax, rax;
        mov_b rax, [r14 + 11];
        cmp rax, 0x5D;                   // ']'
        jne cr_pt_advance_line;

        // Match. Count it, advance to next line, continue.
        add r13, 1;
        add r14, 12;

      cr_pt_advance_line:
        // Skip to end of line (LF or EOF).
        cmp r14, r12;
        jae cr_pt_out;
        xor rax, rax;
        mov_b rax, [r14 + 0];
        cmp rax, 0x0A;
        je  cr_pt_eat_lf;
        add r14, 1;
        jmp cr_pt_advance_line;
      cr_pt_eat_lf:
        add r14, 1;
        jmp cr_pt_line_start;

      cr_pt_out:
        mov rax, r13;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // SECTION 14  cr_build_path(root_ptr, root_len) -> path_len
  //
  // Concatenates <root_ptr>[0..root_len] + cr_path_suffix ("/shell/
  // commands.toml\0") into _cr_path_scratch. Returns the byte count
  // (excluding the trailing NUL) or 0 on overflow.
  //
  // Overflow ceiling: CR_PATH_SCRATCH - 21 (suffix incl. NUL) = 235
  // bytes of root path room.
  // =========================================================================

  pub let cr_build_path : (u64, u64) -> u64 !{mem} @{} =
    fn (root_ptr: u64) (root_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): compose <root>/shell/commands.toml into _cr_path_scratch. Byte-copy root then append suffix (with NUL). Returns byte count excluding NUL, or 0 on overflow. Labels prefixed cr_bp_.",
      block: {
        cmp rsi, 235;
        ja  cr_bp_over;

        lea r10, [rip + _cr_path_scratch];
        xor rcx, rcx;                    // i = 0
      cr_bp_copy_root:
        cmp rcx, rsi;
        jae cr_bp_root_done;
        xor r11, r11;
        mov_b r11, [rdi + rcx * 1];
        mov_b [r10 + rcx * 1], r11;
        add rcx, 1;
        jmp cr_bp_copy_root;

      cr_bp_root_done:
        // Append cr_path_suffix (21 bytes including NUL).
        lea r8, [rip + cr_path_suffix];
        xor rax, rax;                    // j = 0
      cr_bp_copy_suffix:
        cmp rax, 21;
        jae cr_bp_out;
        xor r11, r11;
        mov_b r11, [r8 + rax * 1];
        mov_b [r10 + rcx * 1], r11;
        add rcx, 1;
        add rax, 1;
        jmp cr_bp_copy_suffix;

      cr_bp_out:
        // Return path length EXCLUDING NUL = root_len + 20.
        mov rax, rsi;
        add rax, 20;
        ret;

      cr_bp_over:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 15  cmd_registry_load(root_path_ptr, root_path_len) -> u32
  //
  // Attempts to load registry entries from <root>/shell/commands.
  // toml. Returns the count of entries loaded (0 on file-absent).
  //
  // Pipeline:
  //   (1) cr_build_path(root, root_len) -> path_len (0 on overflow).
  //   (2) vfs_open(_cr_path_scratch, 0) -> vnode_idx (0 on absent).
  //   (3) vfs_read(vnode_idx, _cr_load_buf, CR_LOAD_BUF_CAP, 0) ->
  //       bytes_read (or error sentinel).
  //   (4) vfs_close(vnode_idx).
  //   (5) cr_parse_toml(_cr_load_buf, bytes_read) -> count.
  //   (6) Bump CR_ST_LOADS.
  //
  // Failure funnel: on cr_build_path overflow, on vfs_open == 0, or
  // on vfs_read returning the sentinel 0xFFFFFFFFFFFFFFFF, the call
  // returns 0 without emitting a fingerprint. The caller (kernel_
  // main.pdx or the witness) emits `cmd registry loaded system=<n>
  // user=<n>` with the returned count.
  //
  // Register plan: four callee-save pushes (rbx = vnode_idx across
  // vfs_close, r12 = bytes_read, r13 = path_len, r14 = count). sub
  // rsp,8 alignment for nested calls (four pushes leave rsp%16==8
  // at entry -> 8 after 4 pushes ok, but +8 makes 0 for nested).
  // Actually 4 pushes = 32 bytes; entry rsp%16==8; +32 -> %16==8;
  // so sub rsp,8 lifts to 0.
  // =========================================================================

  pub let cmd_registry_load : (u64, u64) -> u64 !{mem} @{} =
    fn (root_path_ptr: u64) (root_path_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M2 (paideia-os #2504): load the on-disk command registry from <root>/shell/commands.toml. Pipeline: cr_build_path -> vfs_open -> vfs_read -> vfs_close -> cr_parse_toml. Returns count (0 on any failure -- absent file, path overflow, read error). Register plan: four callee-save pushes (rbx = vnode_idx, r12 = bytes_read, r13 = path_len, r14 = count) + sub rsp,8 for 16-byte alignment at nested calls. Bumps CR_ST_LOADS unconditionally at exit. Labels prefixed cr_ld_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        xor r14, r14;                    // count = 0
        xor rbx, rbx;                    // vnode_idx = 0

        // (1) Build path.
        call cr_build_path;              // rdi/rsi already set
        cmp rax, 0;
        je  cr_ld_out;                   // path overflow
        mov r13, rax;                    // path_len

        // (2) Open. rdi = path ptr, rsi = flags (0 = O_RDONLY).
        lea rdi, [rip + _cr_path_scratch];
        xor rsi, rsi;
        call vfs_open;
        cmp rax, 0;
        je  cr_ld_out;                   // absent
        mov rbx, rax;                    // vnode_idx

        // (3) Read up to CR_LOAD_BUF_CAP bytes at offset 0.
        mov rdi, rbx;
        lea rsi, [rip + _cr_load_buf];
        mov rdx, 4096;                   // CR_LOAD_BUF_CAP
        xor rcx, rcx;                    // offset 0
        call vfs_read;
        // Error sentinel = 0xFFFFFFFFFFFFFFFF -> treat as 0.
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  cr_ld_close;
        mov r12, rax;                    // bytes_read

        // (5) Parse.
        lea rdi, [rip + _cr_load_buf];
        mov rsi, r12;
        call cr_parse_toml;
        mov r14, rax;                    // count

      cr_ld_close:
        // (4) Close.
        mov rdi, rbx;
        call vfs_close;

      cr_ld_out:
        // Bump CR_ST_LOADS.
        mov rdi, 5;                      // CR_ST_LOADS
        call cr_note;

        mov rax, r14;                    // return count
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // SECTION 16  R123.M5 (paideia-os #2506): discovery API stubs.
  //
  // Three entry points -- find_by_input_schema, find_by_output_schema,
  // find_by_capability -- each takes a u64 query key and returns a
  // u64 result count. R123.M5 STUB semantics: the KIND_CMD_MODULE row
  // (frozen at R123.M1) does NOT yet carry input_schema / output_
  // schema / capability fields, so per-field filtering is impossible
  // today. The stub returns:
  //   * 0 when the query key is 0 (sentinel "no schema / no capability")
  //   * the count of populated cache rows otherwise.
  // The count is computed by cr_count_populated (a §16 helper) which
  // walks the 256-entry LRU cache and counts rows whose flags word is
  // nonzero (i.e. cap_handle low 32 bits nonzero OR tick high 32 bits
  // nonzero -- either indicates a claimed slot per §2 layout).
  //
  // At witness time (r123_cmd_discovery.pdx runs after the R123.M2
  // and R123.M3 witnesses) the cache holds:
  //   R123.M2 seeds:  find (0x11) + where (0x22) + sort (0x33)  =  3
  //   R123.M3 seeds:  l_where + l_sort + l_head + l_count       =  4
  // Total: 7 populated rows -- the witness asserts nonzero + emits
  // the returned count as `results=<n>` in the fingerprint.
  //
  // Per-field narrowing to (input_schema / output_schema / capability
  // match) is DEFERRED to R123.M5.M2-followup, which will (a) grow
  // the KIND_CMD_MODULE row with the missing fields, (b) update
  // cmd_module_alloc to populate them, and (c) replace cr_count_
  // populated with per-axis compare loops. Today's stub keeps the
  // API surface + fingerprint shape stable so R127 tab completion
  // (which consumes this API) can wire in ahead of the row growth.
  //
  // Encoder discipline (§5): no `test rN, rN`, no 2-op `imul r,imm`
  // (row stride 32 via `shl 5`), no `cmp reg, [mem]`. Every zero-
  // check uses `cmp reg, 0`. Labels prefixed cr_cp_ / cr_fi_ / cr_fo_
  // / cr_fc_.
  // =========================================================================

  // -------------------------------------------------------------------------
  // cr_count_populated() -> u64
  //
  // Leaf helper: walk _cmd_registry_table (256 rows * 32 bytes),
  // count rows whose flags word (row[+24]) is nonzero. No callee-save
  // pushes required -- rax/rcx/r10/r11 are all caller-save. No stack
  // adjustment: no nested call.
  // -------------------------------------------------------------------------

  pub let cr_count_populated : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (paideia-os #2506): leaf helper for the three discovery-primitive stubs. Walks the 256-entry LRU cache, counts rows whose flags word (row[+24]) is nonzero -- a free slot is the whole-flags-zero sentinel (§2). No callee-save pushes; no stack adjustment (no nested call). Returns the count in rax. Labels prefixed cr_cp_.",
      block: {
        lea r10, [rip + _cmd_registry_table];
        xor rax, rax;                    // count = 0
        xor rcx, rcx;                    // idx = 0
      cr_cp_scan:
        cmp rcx, 256;
        jae cr_cp_out;
        mov r11, rcx;
        shl r11, 5;                      // idx * 32
        add r11, r10;                    // row ptr
        mov r9, [r11 + 24];              // flags word
        cmp r9, 0;
        je  cr_cp_next;
        add rax, 1;
      cr_cp_next:
        add rcx, 1;
        jmp cr_cp_scan;
      cr_cp_out:
        ret
      }
    }

  // -------------------------------------------------------------------------
  // cmd_registry_find_by_input_schema(schema_id: u64) -> u64
  //
  // Returns 0 when schema_id == 0 (sentinel "no schema"); otherwise
  // returns cr_count_populated() -- the count of populated cache
  // rows. R123.M5 STUB: per-field filtering deferred until the
  // KIND_CMD_MODULE row grows an input_schema slot.
  //
  // No callee-save pushes; one nested call so rsp needs a +8 stack
  // adjustment for 16-byte alignment (entry rsp%16==8 -> sub 8 -> 0).
  // -------------------------------------------------------------------------

  pub let cmd_registry_find_by_input_schema : (u64) -> u64 !{mem} @{} =
    fn (schema_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (paideia-os #2506) STUB: return 0 when schema_id==0, else cr_count_populated(). Per-field narrowing deferred to R123.M5.M2-followup (KIND_CMD_MODULE row does not yet carry input_schema). No callee-save pushes; one nested call needs sub rsp,8 for 16-byte alignment (entry rsp%16==8; +8 -> 0). Labels prefixed cr_fi_.",
      block: {
        cmp rdi, 0;
        je  cr_fi_zero;
        sub rsp, 8;
        call cr_count_populated;
        add rsp, 8;
        ret;
      cr_fi_zero:
        xor rax, rax;
        ret
      }
    }

  // -------------------------------------------------------------------------
  // cmd_registry_find_by_output_schema(schema_id: u64) -> u64
  //
  // Same STUB shape as cmd_registry_find_by_input_schema.
  // -------------------------------------------------------------------------

  pub let cmd_registry_find_by_output_schema : (u64) -> u64 !{mem} @{} =
    fn (schema_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (paideia-os #2506) STUB: return 0 when schema_id==0, else cr_count_populated(). Per-field narrowing deferred to R123.M5.M2-followup (KIND_CMD_MODULE row does not yet carry output_schema). Same alignment discipline as cmd_registry_find_by_input_schema. Labels prefixed cr_fo_.",
      block: {
        cmp rdi, 0;
        je  cr_fo_zero;
        sub rsp, 8;
        call cr_count_populated;
        add rsp, 8;
        ret;
      cr_fo_zero:
        xor rax, rax;
        ret
      }
    }

  // -------------------------------------------------------------------------
  // cmd_registry_find_by_capability(cap_id: u64) -> u64
  //
  // Same STUB shape. R123.M5.M2-followup will narrow to rows whose
  // cap_env references cap_id (or whose declared caps subset
  // includes it once the row grows a declared-caps bitmap).
  // -------------------------------------------------------------------------

  pub let cmd_registry_find_by_capability : (u64) -> u64 !{mem} @{} =
    fn (cap_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (paideia-os #2506) STUB: return 0 when cap_id==0, else cr_count_populated(). Per-field narrowing deferred to R123.M5.M2-followup (KIND_CMD_MODULE row does not yet carry a declared-cap bitmap; cap_env_ptr today is a raw pointer with no reverse index). Same alignment discipline as the schema primitives. Labels prefixed cr_fc_.",
      block: {
        cmp rdi, 0;
        je  cr_fc_zero;
        sub rsp, 8;
        call cr_count_populated;
        add rsp, 8;
        ret;
      cr_fc_zero:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 17  R123.M6 (paideia-os #2507): cmd_registry_reload.
  //
  // Callable primitive that re-runs the on-disk load path against a
  // caller-supplied root path and returns the count of newly-added
  // entries (delta between populated-row counts before and after).
  //
  // R123.M6 SCOPE: this is NOT an FS-triggered auto-reload -- the
  // FS-watch capability kind does not exist yet. It is a synchronous
  // callable primitive that:
  //   (1) snapshots cr_count_populated() as old_count,
  //   (2) invokes cmd_registry_load(root_ptr, root_len) -- which
  //       APPENDS via existing cmd_registry_insert semantics (dedup
  //       refresh on name collision; free-slot or LRU-evict fallback
  //       when the cache fills). No pre-wipe: this file does NOT
  //       zero-scrub the LRU table before the load.
  //   (3) snapshots cr_count_populated() as new_count,
  //   (4) emits `cmd registry reloaded old=<old> new=<delta>` via
  //       klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_reloaded),
  //   (5) returns delta = new_count - old_count (unsigned).
  //
  // On a missing file, cmd_registry_load returns 0 without touching
  // the cache -- so new_count == old_count and delta == 0. The
  // R123.M6 witness (src/kernel/boot/witness/r123_cmd_reload.pdx)
  // exercises exactly that path with a nonexistent root ("/nonexist
  // ent/commands.toml"), asserts the returned delta is 0 AND the
  // populated-row count is unchanged, and lets the substrate emit
  // the fingerprint (`cmd registry reloaded old=<pre_count> new=0`).
  //
  // DEFERRED to R123.M6-followup:
  //   (a) True atomic swap: build a shadow table off-side, then
  //       swap pointers under a spinlock. Today's append semantics
  //       leave partially-loaded state visible if cr_parse_toml
  //       halts mid-file. Acceptable at R123.M6 (parser is a
  //       structural walker with no allocation) but must be revisited
  //       when the parser grows per-key extraction + cmd_module_alloc
  //       calls per entry.
  //   (b) FS-watch integration (KIND_FS_WATCH). The kind does not
  //       exist. This primitive lands as a syscall-callable /
  //       shell-callable API so a userspace daemon (or an inotify-
  //       shaped hook when the kind lands) can drive it.
  //   (c) Per-entry PQ signature verification per CRG-D3 (also
  //       deferred by cmd_registry_load itself since R123.M2).
  //
  // Register plan: four callee-save pushes (rbx = old_count, r12 =
  // root_ptr stash across nested calls, r13 = root_len stash, r14 =
  // new_count) + sub rsp,8 for 16-byte alignment at nested calls.
  // Entry rsp%16==8; +32 (4 pushes) -> %16==8; +8 (align) -> %16==0.
  // klog_s1_x2 caller-push idiom (sub rsp,8; push v2; call; add
  // rsp,16) keeps alignment.
  //
  // Encoder discipline (§5): no `test rN, rN` (every zero-check uses
  // `cmp reg, 0`); no 2-op `imul r, imm`; no `and reg, imm64`; no
  // `add reg, [mem]` / `cmp reg, [mem]`; every memory operand lands
  // in a register first. Labels prefixed cr_rl_.
  // =========================================================================

  pub let cmd_registry_reload : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (root_path_ptr: u64) (root_path_len: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R123.M6 (paideia-os #2507): callable primitive that re-runs the on-disk load path against a caller-supplied root and returns the count of newly-added entries. Pipeline: snapshot cr_count_populated() as old_count -> cmd_registry_load(root_ptr, root_len) [APPENDS via existing insert semantics; no pre-wipe] -> snapshot cr_count_populated() as new_count -> emit `cmd registry reloaded old=<old> new=<delta>` via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_reloaded, k_old, k_new) -> return delta = new_count - old_count. On a missing file, cmd_registry_load returns 0 without touching the cache so new_count == old_count and delta == 0. True atomic swap + FS-watch integration deferred to R123.M6-followup. Register plan: four callee-save pushes (rbx=old_count, r12=root_ptr stash, r13=root_len stash, r14=new_count) + sub rsp,8 for 16-byte alignment (entry rsp%16==8; +32 pushes -> %16==8; +8 align -> %16==0). klog_s1_x2 caller-push idiom (sub rsp,8; push v2; call; add rsp,16) keeps alignment. Effects widened to {sysreg,mem} because the fingerprint emit path touches uart via klog_emit_core. Labels prefixed cr_rl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov r12, rdi;                    // stash root_ptr
        mov r13, rsi;                    // stash root_len

        // (1) Snapshot old_count.
        call cr_count_populated;
        mov rbx, rax;                    // rbx = old_count

        // (2) Re-run the on-disk load path. Return value (count of
        // rows loaded per this call) is discarded -- we measure the
        // cache-populated delta instead so re-loads that dedup
        // (refresh existing rows without adding) show delta=0
        // truthfully.
        mov rdi, r12;
        mov rsi, r13;
        call cmd_registry_load;

        // (3) Snapshot new_count.
        call cr_count_populated;
        mov r14, rax;                    // r14 = new_count

        // (4) Emit fingerprint: `cmd registry reloaded old=<old>
        //     new=<delta>` via klog_s1_x2. delta = new_count -
        //     old_count (unsigned; wraps only on the pathological
        //     case where the cache shrinks, which existing insert
        //     semantics never do).
        sub rsp, 8;
        mov rax, r14;
        sub rax, rbx;                    // delta = new - old
        push rax;                        // v2 = delta
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_registry_reloaded];
        lea rcx, [rip + k_old];
        mov r8,  rbx;                    // v1 = old_count
        lea r9,  [rip + k_new];
        call klog_s1_x2;
        add rsp, 16;

        // (5) Return delta. Recompute (rax was clobbered by
        //     klog_s1_x2). r14 and rbx survived (callee-save).
        mov rax, r14;
        sub rax, rbx;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
