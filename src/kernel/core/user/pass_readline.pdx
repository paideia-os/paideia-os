// src/kernel/core/user/pass_readline.pdx — R48.M4-002 (#1532)
//
// Passphrase-entry readline widget for the fb-console.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the MASKING VARIANT of the R17 shell line reader: a caller
// hands it a byte buffer, and it collects keystrokes until the user
// commits with newline.  While collecting, it does NOT echo the
// passphrase back to the framebuffer — it echoes ONE '*' per accepted
// codepoint, so that a shoulder-observer cannot read what was typed.
//
// It is NOT a cryptographic primitive.  It does not touch KDFs, and it
// does not seal the buffer.  Its ONE contract is: (a) return the raw
// UTF-8 bytes the user typed and their length, (b) never let the raw
// bytes reach the framebuffer texture, and (c) zero its internal
// scratch on exit.  Argon2id-KDF unlock is #1527/#1528's job on top of
// the byte-string this returns.
//
// =============================================================================
// §1  ONE BUFFER, ONE COMMIT, ONE ZEROIZATION
// =============================================================================
//
// pass_readline(buf_va, buf_cap) -> len | PR_ERR_*
//
//   buf_va      caller-owned writable buffer. Must be aligned; must be
//               non-zero. If either is false, the widget refuses with
//               PR_ERR_BADARG and does NOT prompt.
//   buf_cap     capacity of buf_va in bytes. Zero -> PR_ERR_BADARG.
//               Capacities > PR_MAX_BUF -> PR_ERR_BADARG (the widget
//               caps at 512 bytes because a fb-console readline that
//               scrolled past the on-screen prompt would render some
//               fraction of the passphrase glyph-mask through screen
//               reflow; the R23 fb-console has a fixed prompt row).
//   returns     the number of bytes stored in buf_va on commit, or
//               PR_ERR_* on failure.
//
// Backspace is honored, one codepoint at a time, and RE-EMITS the mask
// row (paints spaces over the tail glyphs).  CTRL-U wipes the whole
// entry and re-emits the prompt.  Any other control byte outside the
// small navigation set is REFUSED — the widget does not accept escape
// sequences during passphrase entry, because a stray escape from a
// paste buffer could name a text-attribute mode that revealed the
// buffer's contents when the next character was echoed.
//
// =============================================================================
// §2  ZEROIZATION — SCRATCH DIES ON EVERY RETURN, WIN OR LOSE
// =============================================================================
//
// The widget uses a fixed-size .bss scratch for the mask row it writes
// to the console.  On every return path (commit, cancel, error), the
// scratch is memset(0), so a subsequent kernel operation that
// accidentally read [_pr_mask_scratch] would read zeros rather than the
// asterisks (whose count leaks the passphrase length to a residual
// reader).  The caller's buf_va is NOT zeroed — that is the caller's
// responsibility, and is done after the KDF consumes it.
//
// =============================================================================
// §3  ERROR BAND 0xFFFFE510..0xFFFFE51F
// =============================================================================

module PassReadline = structure {

  pub let PR_OK              : u64 = 0
  pub let PR_ERR_BADARG      : u64 = 0xFFFFE51F
  pub let PR_ERR_CANCELLED   : u64 = 0xFFFFE51E
  pub let PR_ERR_OVERFLOW    : u64 = 0xFFFFE51D
  pub let PR_ERR_NOTATTY     : u64 = 0xFFFFE51C
  pub let PR_ERR_INTERNAL    : u64 = 0xFFFFE51B

  pub let PR_MAX_BUF     : u64 = 512
  pub let PR_MIN_BUF     : u64 = 12       // §11 open-question default

  // The mask glyph.
  pub let PR_MASK_BYTE   : u64 = 0x2A     // '*'
  pub let PR_BACKSPACE   : u64 = 0x08
  pub let PR_CTRL_U      : u64 = 0x15
  pub let PR_NEWLINE     : u64 = 0x0A
  pub let PR_CR          : u64 = 0x0D
  pub let PR_ESC         : u64 = 0x1B

  // Mask-emit scratch (§2). Deliberately smaller than the buffer cap
  // (mask glyphs are single-byte; one mask per input byte).
  pub let mut _pr_mask_scratch : [u8; 512] = uninit @align(64)

  // Prompt.
  pub let pr_prompt_msg : [u8; 13] = "Passphrase: \0"

  // ==========================================================================
  // pass_readline_zeroize_scratch() -> ()
  //
  // Explicit zeroization primitive, exposed so bring-up code can prove
  // the mask row is scrubbed independent of the readline call.
  // ==========================================================================

  pub let pass_readline_zeroize_scratch : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-002 (#1532): scrub _pr_mask_scratch to zero. Called from every pass_readline return path AND exposed as a public primitive so tests can pin the invariant. 64 iterations of 8-byte stores over the 512-byte scratch. Leaf. Labels prefixed pr_zs_.",
      block: {
        lea r10, [rip + _pr_mask_scratch];
        xor rax, rax;
        xor rcx, rcx;
      pr_zs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;                     // 64 * 8 = 512
        jb  pr_zs_loop;
        ret
      }
    }

  // ==========================================================================
  // pass_readline_arg_valid(buf_va, buf_cap) -> 1 | 0
  // ==========================================================================

  pub let pass_readline_arg_valid : (u64, u64) -> u64 !{} @{} =
    fn (buf_va: u64) (buf_cap: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-002 (#1532): 1 iff buf_va != 0 AND buf_cap in [PR_MIN_BUF, PR_MAX_BUF]. PR_MIN_BUF is deliberately below the widget's UI hint (the widget will still accept short passphrases; the policy floor sits above this — see model.md §12). PR_MAX_BUF caps at 512 to match _pr_mask_scratch. Pure leaf. Labels prefixed pr_av_.",
      block: {
        cmp rdi, 0;
        je  pr_av_no;
        cmp rsi, 12;                     // PR_MIN_BUF
        jb  pr_av_no;
        mov r10, 512;                    // PR_MAX_BUF
        cmp rsi, r10;
        ja  pr_av_no;
        mov rax, 1;
        ret;
      pr_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pass_readline(buf_va, buf_cap) -> len | PR_ERR_*
  //
  // The full widget.  Actual keystroke I/O routes through the fb-console
  // read primitive; at R48.M4 the R23 fb-console does not yet expose a
  // raw-mode readline hook — the widget is present as a pure predicate
  // over its arguments plus the scratch zeroization posture, and the
  // R23 wire-up (fb-console raw read + mask emit) lands in the R48.M4
  // driver-touchdown fixture that this milestone gates on.
  //
  // Returns PR_ERR_NOTATTY unconditionally today; a follow-up (tracked
  // as R48.M4-002-follow) replaces this stub with the raw-read loop.
  // The important invariant landed HERE is that the scratch zeroization
  // happens on every return path AND that the arg gate refuses zero
  // buffers or over-capped requests.
  // ==========================================================================

  pub let pass_readline : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (buf_va: u64) (buf_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-002 (#1532): the widget entrypoint. Sequence: (1) pass_readline_arg_valid -> PR_ERR_BADARG. (2) zeroize scratch (defensive — a caller invoking the widget twice back to back must not observe residual mask bytes from the previous call). (3) return PR_ERR_NOTATTY as the interim seam: the R23 fb-console does not yet expose a raw-read hook; a follow-up wires that in and replaces the return. Structural invariants pinned here (arg gate + zeroization on every path) are what the R48.M4 smoke fixture asserts. Two pushes leave rsp%16==0. Labels prefixed pr_rl_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        mov rsi, r13;
        call pass_readline_arg_valid;
        cmp rax, 0;
        je  pr_rl_bad;

        call pass_readline_zeroize_scratch;

        mov rax, 0xFFFFE51C;             // PR_ERR_NOTATTY — interim
        jmp pr_rl_out;

      pr_rl_bad:
        call pass_readline_zeroize_scratch;
        mov rax, 0xFFFFE51F;             // PR_ERR_BADARG

      pr_rl_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
