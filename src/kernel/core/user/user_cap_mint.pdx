// src/kernel/core/user/user_cap_mint.pdx — R48.M5-002 (#1538)
//
// user_supervisor's cap-mint authority for KIND_USER + delegated
// sub-caps.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE ROUTE that mints a Cap<KIND_USER> into a caller's
// cap-space.  KIND_USER (0x190) is a derived kind whose parent is
// KIND_HW (14) per model.md §11.2 and R48.M1; this module DOES NOT
// re-declare KIND_USER (that is R48.M1's file) — it uses the numeric
// literal at every gate site.
//
// The mint enters through user_supervisor, which holds
// KIND_SUPERVISOR (16).  A caller that does not hold that root is
// refused at the cap_verify entry.  For sub-user creation (§4.3 of
// model.md — alice creates alice-work), the caller instead holds a
// Cap<KIND_USER> and this module walks the delegation chain.
//
// =============================================================================
// §1  PARAMETERS
// =============================================================================
//
//   ucm_mint(target_slot, parent_slot, pk_fp_lo, quota, mfa) -> code
//
//   target_slot     the cap-space slot receiving the new KIND_USER.
//   parent_slot     the KIND_SUPERVISOR or KIND_USER root the caller
//                   is minting under.  Must be live and carry
//                   RIGHT_MINT.
//   pk_fp_lo        low 8 bytes of the new user's pk_fingerprint.  Used
//                   as the row's identity key.  Must be non-zero.
//   quota           quota_bytes for the new user's subtree.  0 refused.
//   mfa             mfa_bits bitmask (passphrase=1, hw=2, bio=4).
//                   Zero refused — a user with no MFA cannot ever
//                   authenticate, and the supervisor never mints such
//                   a row.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE560..0xFFFFE56F
// =============================================================================

module UserCapMint = structure {

  pub let UCM_KIND_USER      : u64 = 0x190
  pub let UCM_PARENT_KIND    : u64 = 14        // KIND_HW (KIND_USER_BASE)
  // Reserved for the design-time "supervisor" role kind.  Ordinal 16
  // is not currently a live kind in src/kernel/core/cap/kind.pdx
  // (KIND_RESERVED is 15; 16 sits above the base range).  The mint
  // gate treats KIND_HW (14) as the effective root authority for
  // now; a follow-up landing a distinct KIND_SUPERVISOR at 16 flips
  // this comment into a real acceptance branch.
  pub let UCM_SUPERVISOR_KIND: u64 = 16

  pub let UCM_R_USER_READ    : u64 = 0x001
  pub let UCM_R_USER_INVOKE  : u64 = 0x008
  pub let UCM_R_USER_REVOKE  : u64 = 0x010
  pub let UCM_R_USER_MINT    : u64 = 0x200
  pub let UCM_R_USER_ALL     : u64 = 0x219

  pub let UCM_OK              : u64 = 0
  pub let UCM_ERR_BAD_SLOT    : u64 = 0xFFFFE56F
  pub let UCM_ERR_BAD_PARENT  : u64 = 0xFFFFE56E
  pub let UCM_ERR_BAD_RIGHTS  : u64 = 0xFFFFE56D
  pub let UCM_ERR_BAD_FP      : u64 = 0xFFFFE56C
  pub let UCM_ERR_BAD_QUOTA   : u64 = 0xFFFFE56B
  pub let UCM_ERR_BAD_MFA     : u64 = 0xFFFFE56A
  pub let UCM_ERR_UR_ADD      : u64 = 0xFFFFE569
  pub let UCM_ERR_INTERNAL    : u64 = 0xFFFFE568

  // ==========================================================================
  // ucm_parent_valid(parent_slot) -> 1 | 0
  //
  // Discriminates NOTHING (§2 of kind_backlight — the same "the kind
  // half proves nothing" refrain).  A parent slot that names a live
  // KIND_SUPERVISOR OR a live KIND_USER, in either case carrying
  // RIGHT_MINT, is accepted at this gate.  The identity of the
  // parent (which specific user) is enforced by the caller's
  // separate ur_find_by_fp_lo lookup.
  // ==========================================================================

  pub let ucm_parent_valid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M5-002 (#1538): 1 iff parent_slot names a live KIND_SUPERVISOR or KIND_USER descriptor with RIGHT_MINT. Two-way accept because model.md §4.3 (alice creates alice-work) mints under a KIND_USER root. Labels prefixed ucm_pv_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae ucm_pv_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 14;                     // KIND_HW — the effective root
                                         // authority (see UCM_SUPERVISOR_KIND
                                         // comment above)
        je  ucm_pv_check_rights;
        mov r11, 0x190;                  // KIND_USER (delegation from a user)
        cmp r10, r11;
        je  ucm_pv_check_rights;
        jmp ucm_pv_no;

      ucm_pv_check_rights:

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  ucm_pv_no;
        mov rax, 1;
        ret;
      ucm_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ucm_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let ucm_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-002 (#1538): 1 iff (rights & UCM_R_USER_ALL) == rights. Subset test; a MINT bit is inside the mask (unlike leaf kinds) because KIND_USER is a derivation root — alice's cap must carry MINT to create alice-work. Labels prefixed ucm_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x219;                  // UCM_R_USER_ALL
        and rax, r10;
        cmp rax, rdi;
        jne ucm_rv_no;
        mov rax, 1;
        ret;
      ucm_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ucm_mint(target_slot, parent_slot, rights, pk_fp_lo, quota, mfa)
  //   -> UCM_OK | UCM_ERR_*
  //
  // Arity SIX to fit the SysV register window.  Every gate refuses
  // with the specific code; no gate silently defaults.
  // ==========================================================================

  pub let ucm_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (target_slot: u64) (parent_slot: u64) (rights: u64) (pk_fp_lo: u64) (quota: u64) (mfa: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48.M5-002 (#1538): mint a KIND_USER cap. Gates: (1) target_slot < 256 else BAD_SLOT. (2) ucm_parent_valid else BAD_PARENT. (3) ucm_rights_valid else BAD_RIGHTS. (4) pk_fp_lo != 0 else BAD_FP. (5) quota != 0 else BAD_QUOTA (a user with quota=0 cannot write and cannot log in — refuse rather than mint a zombie). (6) mfa != 0 else BAD_MFA. (7) ur_add(fp_lo, login_len=1 as placeholder, quota, delegated_by=0, mfa); pass the ur_add code through as UR_ADD on failure. (8) cap_mint_write(target_slot, KIND_USER, rights, row_id) — target_ptr is the ur row_id so a later cap_verify can rehydrate metadata. Six pushes leave rsp%16==0. Labels prefixed ucm_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // target_slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // pk_fp_lo
        mov rbp, r8;                     // quota
        mov rbx, r9;                     // mfa

        mov r10, 256;
        cmp r12, r10;
        jae ucm_mi_bad_slot;

        mov rdi, r13;
        call ucm_parent_valid;
        cmp rax, 0;
        je  ucm_mi_bad_parent;

        mov rdi, r14;
        call ucm_rights_valid;
        cmp rax, 0;
        je  ucm_mi_bad_rights;

        cmp r15, 0;
        je  ucm_mi_bad_fp;

        cmp rbp, 0;
        je  ucm_mi_bad_quota;

        cmp rbx, 0;
        je  ucm_mi_bad_mfa;

        // ur_add(fp_lo=r15, login_len=1, quota=rbp, delegated_by=0, mfa=rbx).
        mov rdi, r15;
        mov rsi, 1;
        mov rdx, rbp;
        mov rcx, 0;
        mov r8, rbx;
        call ur_add;

        // ur_add returns row_id on success (0..63) or UR_ERR_* on
        // failure.  A legitimate row_id is strictly less than
        // UR_MAX_ROWS = 64; anything else (including the 0xFFFFE55x
        // error band) is a failure.
        mov r10, 64;
        cmp rax, r10;
        jae ucm_mi_ur_fail;

        // rax = row_id. Descriptor: kind=KIND_USER, rights, target_ptr=row_id.
        mov rdi, r12;
        mov rsi, 0x190;                  // KIND_USER
        mov rdx, r14;
        mov rcx, rax;
        call cap_mint_write;

        xor rax, rax;                    // UCM_OK
        jmp ucm_mi_out;

      ucm_mi_bad_slot:

        mov rax, 0xFFFFE56F;

        jmp ucm_mi_out;
      ucm_mi_bad_parent:
        mov rax, 0xFFFFE56E;
        jmp ucm_mi_out;
      ucm_mi_bad_rights:
        mov rax, 0xFFFFE56D;
        jmp ucm_mi_out;
      ucm_mi_bad_fp:
        mov rax, 0xFFFFE56C;
        jmp ucm_mi_out;
      ucm_mi_bad_quota:
        mov rax, 0xFFFFE56B;
        jmp ucm_mi_out;
      ucm_mi_bad_mfa:
        mov rax, 0xFFFFE56A;
        jmp ucm_mi_out;
      ucm_mi_ur_fail:
        mov rax, 0xFFFFE569;

      ucm_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
