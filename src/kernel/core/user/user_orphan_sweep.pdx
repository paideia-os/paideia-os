// src/kernel/core/user/user_orphan_sweep.pdx — R48.M5-006 (#1542)
//
// Orphan-cap sweep on KIND_USER revoke cascade.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE COLLECTOR that walks the cap_table after a
// Cap<KIND_USER> is revoked and eliminates every descendant cap the
// revoked user held.  The cap-lattice linear semantics guarantee that
// a KIND_USER revocation makes downstream caps DEAD (their descriptors
// name a target that is now unreachable), but the descriptor slots
// remain occupied — cap_mint_write set them and no one has cleared
// them.  Left in place, they would clog the slot allocator AND leak
// the metadata (target_ptr) of the revoked user's holdings to the
// next process granted the slot.
//
// It is NOT a policy engine.  It does not decide WHETHER to sweep —
// the supervisor decides when it revokes a KIND_USER.  It only
// executes the sweep, exhaustively and idempotently.
//
// =============================================================================
// §1  DELEGATED-BY FILTER
// =============================================================================
//
// The sweep needs a match key against which "does this cap belong to
// the revoked user's tree?"  Two shapes today:
//
//   (a) KIND_USER caps whose target_ptr row's delegated_by matches
//       the revoked row (a sub-user under alice).  Walk user_registry
//       first, mark them REVOKED, then recurse.
//   (b) Non-KIND_USER caps whose descriptor.owner is a process the
//       revoked user's KIND_USER minted.  Owner tracking is R48.M8's
//       (not yet filed); until it lands, the sweep is CONSERVATIVE —
//       it only sweeps (a).
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE590..0xFFFFE59F
// =============================================================================

module UserOrphanSweep = structure {

  pub let UOS_OK             : u64 = 0
  pub let UOS_ERR_BAD_ROW    : u64 = 0xFFFFE59F
  pub let UOS_ERR_INTERNAL   : u64 = 0xFFFFE59E

  // ==========================================================================
  // uos_sweep_delegates(root_row) -> revoked_count | UOS_ERR_BAD_ROW
  //
  // Marks every user_registry row whose delegated_by_lo matches
  // root_row's pk_fingerprint_lo as REVOKED.  Returns the count
  // (>= 0).  Idempotent: calling twice on the same root_row returns
  // 0 on the second call because there are no more ACTIVE descendants.
  //
  // This is a SINGLE-LEVEL sweep — a user's sub-users are collected,
  // but their sub-sub-users are not (they hold a delegated_by that
  // points at the intermediate, not at root_row).  The supervisor
  // handles the recursion by re-invoking the sweep on each freshly
  // revoked row.
  // ==========================================================================

  pub let uos_sweep_delegates : (u64) -> u64 !{mem} @{} =
    fn (root_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-006 (#1542): revoke every direct-delegate. Sequence: (1) root_row < 64 else BAD_ROW. (2) read root_row's pk_fingerprint_lo (row+32). (3) scan _user_registry_rows for rows where delegated_by_lo (row+24) matches. For each match with kind==ACTIVE, call ur_mark_revoked and count. Refuses to sweep against a root whose fp_lo is 0 (a scrubbed row can't be a legitimate parent). Five pushes, rsp%16==0. Labels prefixed uos_sd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r10, 64;
        cmp rdi, r10;
        jae uos_sd_bad;

        mov r12, rdi;                    // root_row

        // Fetch root_row's fp_lo.
        lea r10, [rip + _user_registry_rows];
        mov r11, r12;
        shl r11, 7;
        add r10, r11;
        mov r13, [r10 + 32];             // root_fp_lo
        cmp r13, 0;
        je  uos_sd_zero;

        xor rbx, rbx;                    // scan idx
        xor r14, r14;                    // matched count

      uos_sd_scan:
        mov r10, 64;
        cmp rbx, r10;
        jae uos_sd_done;

        cmp rbx, r12;                    // skip the root row itself
        je  uos_sd_next;

        lea r10, [rip + _user_registry_rows];
        mov r11, rbx;
        shl r11, 7;
        add r10, r11;

        // Skip already-REVOKED rows.
        mov rax, [r10 + 0];
        and rax, 0xFFFF;
        cmp rax, 0;                      // UR_KIND_ACTIVE
        jne uos_sd_next;

        // delegated_by_lo match?
        mov r15, [r10 + 24];
        cmp r15, r13;
        jne uos_sd_next;

        // Match — revoke it.
        mov rdi, rbx;
        call ur_mark_revoked;
        cmp rax, 0;
        jne uos_sd_next;
        add r14, 1;

      uos_sd_next:
        add rbx, 1;
        jmp uos_sd_scan;

      uos_sd_done:
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      uos_sd_zero:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      uos_sd_bad:
        mov rax, 0xFFFFE59F;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // uos_sweep_cascade(root_row) -> revoked_count
  //
  // The recursive form.  Iteratively re-invokes uos_sweep_delegates
  // until it returns 0 (fixed-point).  Bounded by UR_MAX_ROWS = 64
  // so termination is guaranteed even against a maliciously deep
  // fabricated chain.
  // ==========================================================================

  pub let uos_sweep_cascade : (u64) -> u64 !{mem} @{} =
    fn (root_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-006 (#1542): recursive sweep. Each pass revokes direct delegates of previously revoked rows; iterates to fixed-point. Bounded at 64 iterations (UR_MAX_ROWS) so the outer loop cannot spin forever on a fabricated chain. Two pushes, rsp%16==0. Labels prefixed uos_sc_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // root_row
        xor r13, r13;                    // accumulated count
        mov rcx, 0;

      uos_sc_pass:
        mov r10, 64;
        cmp rcx, r10;
        jae uos_sc_done;
        push rcx;
        mov rdi, r12;
        call uos_sweep_delegates;
        pop rcx;
        // uos_sweep_delegates returns a match count (small non-negative)
        // or UOS_ERR_BAD_ROW (0xFFFFE59F).  Treat any return >= UR_MAX_ROWS
        // (64) as either error or a suspicious count — either way, stop.
        mov r10, 64;
        cmp rax, r10;
        jae uos_sc_done;
        cmp rax, 0;
        je  uos_sc_done;
        add r13, rax;
        add rcx, 1;
        jmp uos_sc_pass;

      uos_sc_done:
        mov rax, r13;
        pop r13;
        pop r12;
        ret
      }
    }
}
