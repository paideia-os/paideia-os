// src/kernel/core/user/elevate_smoke.pdx — R48.M7-003 (#1551)
//
// Elevate smoke fixture — alice requests pkg-install cap, founder
// approves 60s.
//
// =============================================================================
// §0  WHAT THIS FIXTURE PROVES
// =============================================================================
//
// End-to-end through the ElevateChannel + ElevatePolicy substrate:
//
//   (1) elv_pack_req accepts a legitimate REQ.
//   (2) elv_pack_req refuses an over-cap-mask REQ (bits 8..15 set).
//   (3) ep_reset leaves the table empty.
//   (4) ep_install accepts a founder-authored rule for
//       "pdxfs write pkgs + net fetch pkgs + sig verify root", 60s
//       duration cap, unlimited rate.
//   (5) ep_check(target=alice.fp_lo, caps=REQ_CAPS, dur=60s) returns
//       row idx 0.
//   (6) ep_check with a mismatched target returns NO_MATCH.
//   (7) ep_hit_row(0) returns OK.

module ElevateSmoke = structure {

  pub let els_ok_msg : [u8; 18] = "ELEVATE SMOKE OK\n\0"

  pub let ALICE_FP_LO_ELS      : u64 = 0xA11CE00000000001
  pub let BOB_FP_LO_ELS        : u64 = 0xB0B0B00000000001
  pub let PKG_INSTALL_CAPS     : u64 = 0x07              // bits 0,1,2
  pub let SIXTY_SECONDS_NS     : u64 = 60000000000

  pub let elevate_smoke : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M7-003 (#1551): drive the elevate + policy primitives end-to-end. All fabricated identities so no crypto primitive is required. Labels prefixed els_.",
      block: {
        push r12;
        push r13;

        // (1) Pack REQ (caps=0x07, dur=60s).
        mov r10, 0x07;
        mov rdi, r10;
        mov r10, 60000000000;
        mov rsi, r10;
        call elv_pack_req;
        // Expect low byte = ELV_OP_REQ (1); bits [23:8] = caps.
        mov r10, rax;
        and r10, 0xFF;
        cmp r10, 1;
        jne els_fail;

        // (2) Refuse over-cap mask (bits 8..15 set).
        mov r10, 0xFFFF;                 // sets reserved bits 8..15
        mov rdi, r10;
        mov r10, 60000000000;
        mov rsi, r10;
        call elv_pack_req;
        mov r10, 0xFFFFE5EE;             // ELV_ERR_BAD_MASK
        cmp rax, r10;
        jne els_fail;

        // (3) ep_reset.
        call ep_reset;
        call ep_count;
        cmp rax, 0;
        jne els_fail;

        // (4) ep_install rule for alice.
        mov r10, 0xA11CE00000000001;
        mov rdi, r10;
        mov r10, 0x07;
        mov rsi, r10;
        mov r10, 60000000000;
        mov rdx, r10;
        mov rcx, 0;                      // unlimited
        mov r10, 0xF0000E00000000FF;     // founder authorizer fp_lo (fake)
        mov r8, r10;
        call ep_install;
        cmp rax, 0;
        jne els_fail;

        call ep_count;
        cmp rax, 1;
        jne els_fail;

        // (5) ep_check matching.
        mov r10, 0xA11CE00000000001;
        mov rdi, r10;
        mov r10, 0x07;
        mov rsi, r10;
        mov r10, 60000000000;
        mov rdx, r10;
        call ep_check;
        cmp rax, 0;
        jne els_fail;

        // (6) ep_check on bob (mismatched target) — expect NO_MATCH.
        mov r10, 0xB0B0B00000000001;
        mov rdi, r10;
        mov r10, 0x07;
        mov rsi, r10;
        mov r10, 60000000000;
        mov rdx, r10;
        call ep_check;
        mov r10, 0xFFFFE5FA;
        cmp rax, r10;
        jne els_fail;

        // (7) ep_hit_row(0) — expect OK.
        mov rdi, 0;
        call ep_hit_row;
        cmp rax, 0;
        jne els_fail;

        // Emit OK banner as a two-line record — English narrative first,
        // then the byte-identical `ELEVATE SMOKE OK` fingerprint that
        // tests/r17/shell-shutdown.golden:463 anchors on.  R51 Phase C
        // batch 4 (SUBSYS_USER shard, boot-transcript.md §3.5): two-line
        // pattern chosen over bracketed suffix so the whole-line golden
        // still substring-matches the fingerprint line unchanged; see the
        // tag_els_narrative declaration in keys.pdx for the coverage
        // rationale (whole-line OK anchor + covered_by()'s startswith).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + tag_els_narrative];
        call klog_s1;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + els_ok_msg];
        call klog_s1;

      els_fail:
        pop r13;
        pop r12;
        ret
      }
    }
}
