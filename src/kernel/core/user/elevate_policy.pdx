// src/kernel/core/user/elevate_policy.pdx — R48.M7-002 (#1550)
//
// Elevate-policy — signed automated-approval rules with rate limits.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the STATIC POLICY TABLE the elevate approver consults BEFORE
// interactive approval.  A REQ that matches a policy row is
// auto-approved (subject to the row's rate limit and duration cap);
// a REQ that does not match falls through to interactive approval.
//
// Each policy row is signed by an authorizer (typically founder).
// A policy row that fails signature verification at boot is DROPPED
// from the table (not partially trusted): a policy the boot verifier
// cannot prove is authorized MUST NOT auto-approve anything.
//
// =============================================================================
// §1  ROW LAYOUT — 96 bytes
// =============================================================================
//
//   +0    u32 magic = 'PDXP' (0x50585044)
//   +4    u16 version = 1
//   +6    u16 flags     {bit 0 = enabled}
//   +8    u64 target_user_fp_lo    (the user this rule applies to; 0 = any)
//   +16   u64 caps_bitmask         (rule matches when REQ.caps ⊆ this)
//   +24   u64 max_duration_ns      (grant duration capped at this)
//   +32   u32 rate_limit_per_hour  (0 = unlimited)
//   +36   u32 window_hits          (running counter; reset per hour)
//   +40   u64 window_start_ns      (start of the current hour window)
//   +48   u8[16] authorizer_fp     (first 16 bytes of pk_fingerprint)
//   +64   u8[32] sig_slice         (first 32 bytes of ML-DSA sig; the
//                                    rest lives in a companion file)
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE5F0..0xFFFFE5FF
// =============================================================================

module ElevatePolicy = structure {

  pub let EP_MAGIC        : u64 = 0x50585044
  pub let EP_VERSION      : u64 = 1
  pub let EP_ROW_BYTES    : u64 = 96
  pub let EP_MAX_ROWS     : u64 = 64

  pub let EP_FLAG_ENABLED : u64 = 0x0001

  pub let EP_OK              : u64 = 0
  pub let EP_ERR_BADARG      : u64 = 0xFFFFE5FF
  pub let EP_ERR_ENOSPC      : u64 = 0xFFFFE5FE
  pub let EP_ERR_BAD_CAPS    : u64 = 0xFFFFE5FD
  pub let EP_ERR_BAD_DUR     : u64 = 0xFFFFE5FC
  pub let EP_ERR_RATE_LIMIT  : u64 = 0xFFFFE5FB
  pub let EP_ERR_NO_MATCH    : u64 = 0xFFFFE5FA
  pub let EP_ERR_UNSIGNED    : u64 = 0xFFFFE5F9

  // 64 * 96 = 6144 bytes = 768 u64.
  pub let mut _ep_table : [u64; 768] = uninit @align(64)

  //   +0  count       enabled+signed rows loaded from disk
  //   +8  hits        total matches this boot
  //   +16 rate_denies total refused for rate limit
  pub let mut _ep_stats : [u64; 8] = uninit @align(64)

  pub let EP_ST_COUNT       : u64 = 0
  pub let EP_ST_HITS        : u64 = 1
  pub let EP_ST_RATE_DENIES : u64 = 2

  // ==========================================================================
  // ep_reset() -> ()
  // ==========================================================================

  pub let ep_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): scrub table + stats. Boot only. Labels prefixed ep_rs_.",
      block: {
        lea r10, [rip + _ep_table];
        xor rax, rax;
        xor rcx, rcx;
      ep_rs_table:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r11, 768;
        cmp rcx, r11;
        jb  ep_rs_table;

        lea r10, [rip + _ep_stats];
        xor rcx, rcx;
      ep_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ep_rs_stats;
        ret
      }
    }

  pub let ep_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): loaded row count. Leaf.",
      block: {
        lea r10, [rip + _ep_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let ep_row_va : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): idx -> VA. 96 = 64+32 = shl 6 + shl 5. Returns 0 on out-of-range. Labels prefixed ep_va_.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae ep_va_zero;
        mov r10, rdi;
        shl r10, 6;
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        lea rax, [rip + _ep_table];
        add rax, r10;
        ret;
      ep_va_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ep_install(target_fp_lo, caps, max_dur, rate_per_hour, authorizer_fp_lo)
  //   -> idx | EP_ERR_*
  //
  // Appends a policy row.  Does NOT verify the signature — the caller
  // (the boot-time policy loader) is responsible for calling
  // ep_row_signature_valid over each installed row and calling
  // ep_row_disable on any that fail.  This keeps the install path
  // arithmetic-only.
  // ==========================================================================

  pub let ep_install : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (target_fp_lo: u64) (caps: u64) (max_dur: u64) (rate_per_hour: u64) (authorizer_fp_lo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): install a policy row. Gates: (1) caps != 0 else BAD_CAPS. (2) max_dur in [ELV_DUR_MIN_NS, ELV_DUR_MAX_NS] else BAD_DUR (delegates to the range constants via inline stage). (3) count < EP_MAX_ROWS else ENOSPC. (4) write header (magic, version, flags=enabled), target, caps, max_dur, rate_limit, authorizer. Six pushes, rsp%16==0. Labels prefixed ep_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // target_fp_lo
        mov r13, rsi;                    // caps
        mov r14, rdx;                    // max_dur
        mov r15, rcx;                    // rate_per_hour
        mov rbp, r8;                     // authorizer_fp_lo

        cmp r13, 0;
        je  ep_in_bad_caps;

        mov r10, 1000000000;
        cmp r14, r10;
        jb  ep_in_bad_dur;
        mov r11, 3600000000000;
        cmp r14, r11;
        ja  ep_in_bad_dur;

        lea r10, [rip + _ep_stats];
        mov rbx, [r10 + 0];              // count
        mov r11, 64;
        cmp rbx, r11;
        jae ep_in_enospc;

        // Compute row VA = _ep_table + count * 96.
        mov r10, rbx;
        shl r10, 6;
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        lea rcx, [rip + _ep_table];
        add rcx, r10;

        // Word0: magic (32) | version (16) | flags (16) = enabled.
        mov r10, 0x50585044;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 1;                      // EP_FLAG_ENABLED
        shl r11, 48;
        or  r10, r11;
        mov [rcx + 0], r10;

        mov [rcx + 8], r12;              // target_fp_lo
        mov [rcx + 16], r13;             // caps
        mov [rcx + 24], r14;             // max_dur
        // Word4: rate_limit(32) | window_hits(32) = 0.
        mov r10, r15;
        and r10, 0xFFFFFFFF;
        mov [rcx + 32], r10;
        xor r10, r10;
        mov [rcx + 40], r10;             // window_start_ns
        mov [rcx + 48], rbp;             // authorizer_fp_lo (low 8 of 16)
        mov [rcx + 56], r10;             // authorizer_fp mid
        mov [rcx + 64], r10;             // sig_slice
        mov [rcx + 72], r10;
        mov [rcx + 80], r10;
        mov [rcx + 88], r10;

        // count++.
        lea r10, [rip + _ep_stats];
        mov r11, [r10 + 0];
        add r11, 1;
        mov [r10 + 0], r11;

        mov rax, rbx;                    // return the assigned idx
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ep_in_bad_caps:

        mov rax, 0xFFFFE5FD;

        jmp ep_in_out;
      ep_in_bad_dur:
        mov rax, 0xFFFFE5FC;
        jmp ep_in_out;
      ep_in_enospc:
        mov rax, 0xFFFFE5FE;

      ep_in_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ep_check(target_fp_lo, caps, dur) -> idx | EP_ERR_*
  //
  // Looks for the first row matching (target, caps subset, dur cap
  // OK).  Returns row idx on match (caller then applies the rate
  // limit via ep_hit_row); returns EP_ERR_NO_MATCH otherwise.
  // ==========================================================================

  pub let ep_check : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (target_fp_lo: u64) (caps: u64) (dur: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): scan rows for a match. Row matches iff (a) row.flags has ENABLED, (b) row.target == 0 OR row.target == target, (c) (row.caps | caps) == row.caps (requested is a subset of granted), (d) dur <= row.max_dur. Skips rows whose magic is not EP_MAGIC (scrubbed / signature-invalidated). Five pushes leave rsp%16==0. Labels prefixed ep_ck_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // target
        mov r13, rsi;                    // caps
        mov r14, rdx;                    // dur

        lea r15, [rip + _ep_stats];
        mov r15, [r15 + 0];              // count
        xor rbx, rbx;

      ep_ck_scan:
        cmp rbx, r15;
        jae ep_ck_no_match;

        // Row VA.
        mov r10, rbx;
        shl r10, 6;
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        lea rcx, [rip + _ep_table];
        add rcx, r10;

        // Magic.
        mov rax, [rcx + 0];
        mov r10, rax;
        and r10, 0xFFFFFFFF;
        mov r11, 0x50585044;
        cmp r10, r11;
        jne ep_ck_next;

        // Enabled.
        mov r10, rax;
        shr r10, 48;
        and r10, 0xFFFF;
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  ep_ck_next;

        // Target match.
        mov r10, [rcx + 8];
        cmp r10, 0;
        je  ep_ck_target_ok;
        cmp r10, r12;
        jne ep_ck_next;
      ep_ck_target_ok:

        // Caps subset — (caps & row.caps) == caps.
        mov r10, [rcx + 16];
        mov rax, r13;
        and rax, r10;
        cmp rax, r13;
        jne ep_ck_next;

        // Duration cap.
        mov r10, [rcx + 24];
        cmp r14, r10;
        ja  ep_ck_next;

        // Match.
        mov rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ep_ck_next:
        add rbx, 1;
        jmp ep_ck_scan;

      ep_ck_no_match:

        mov rax, 0xFFFFE5FA;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ep_hit_row(idx) -> EP_OK | EP_ERR_*
  //
  // Bumps the window_hits counter on a matched row.  If the counter
  // would exceed rate_limit_per_hour, refuses RATE_LIMIT and bumps
  // the rate_denies stat.  The window-reset (once per hour) is a
  // followup — this MVP treats rate_limit as a lifetime cap.
  // ==========================================================================

  pub let ep_hit_row : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M7-002 (#1550): register a hit on a matched policy row. Refuses RATE_LIMIT if the counter would exceed the row's per-hour cap; refuses BADARG on out-of-range. Labels prefixed ep_hr_.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae ep_hr_bad;

        // Row VA.
        mov r10, rdi;
        shl r10, 6;
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        lea rcx, [rip + _ep_table];
        add rcx, r10;

        // Word4: rate_limit(32) | hits(32).
        mov rax, [rcx + 32];
        mov r10, rax;
        and r10, 0xFFFFFFFF;             // rate_limit
        mov r11, rax;
        shr r11, 32;                     // hits

        cmp r10, 0;
        je  ep_hr_pass;                  // unlimited
        cmp r11, r10;
        jae ep_hr_limit;

      ep_hr_pass:
        add r11, 1;
        shl r11, 32;
        and rax, 0xFFFFFFFF;
        or  rax, r11;
        mov [rcx + 32], rax;

        lea r10, [rip + _ep_stats];
        mov r11, [r10 + 8];              // hits
        add r11, 1;
        mov [r10 + 8], r11;

        xor rax, rax;
        ret;

      ep_hr_limit:
        lea r10, [rip + _ep_stats];
        mov r11, [r10 + 16];             // rate_denies
        add r11, 1;
        mov [r10 + 16], r11;
        mov rax, 0xFFFFE5FB;
        ret;

      ep_hr_bad:

        mov rax, 0xFFFFE5FF;
        ret
      }
    }
}
