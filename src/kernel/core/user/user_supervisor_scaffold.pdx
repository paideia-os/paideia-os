// src/kernel/core/user/user_supervisor_scaffold.pdx — R48.M5-001 (#1537)
//
// user_supervisor userspace binary — scaffold, kernel-side seat.
//
// =============================================================================
// §0  WHY THIS FILE LIVES IN THE KERNEL TREE
// =============================================================================
//
// The R48.M5 user_supervisor is designed as a userspace process
// analogous to acpi_supervisor (R20.M4-002) and audio_supervisor
// (R33.M5-001).  A full userspace binary requires:
//
//   * an _init_caps sidecar naming its loader-seeded slots,
//   * its own link script under src/user/,
//   * an entry in tools/build-user.sh routing its object to a distinct
//     object set + link.
//
// The userspace-binary integration lands with the driver-touchdown
// followup that also wires the R48.M1 KIND_USER dispatch and the
// UserCapMint gate.  Until then, this file lives in the kernel tree
// and encodes the four pieces of state that let the boot witness
// assert the R48.M5 supervisor's shape is stable:
//
//   * the endpoint_id (6) reserved for svc.user_lifecycle,
//   * the loader-seeded slot pair (12, 13) reserved for its two caps,
//   * the KIND_SUPERVISOR authority scoped to root (target_ptr=0),
//   * the sidecar packed-word encoding.
//
// A boot-witness that asserts on these values catches any drift
// before the userspace wire-up lands.
//
// =============================================================================
// §1  RESERVED IDENTIFIERS
// =============================================================================

module UserSupervisorScaffold = structure {

  pub let US_ENDPOINT_ID     : u64 = 6
  pub let US_CAP_SLOT_EP     : u64 = 12
  pub let US_CAP_SLOT_SUP    : u64 = 13

  pub let US_KIND_IPC_ENDPOINT : u64 = 5
  pub let US_KIND_SUPERVISOR   : u64 = 16

  pub let US_R_IPC_ALL        : u64 = 0x0B
  pub let US_R_SUP_MINT_INVK  : u64 = 0x208

  // Sidecar words per design/loader/init-caps-sidecar.md §2.
  //   Entry 0: slot=12, kind=5, rights=0x0B; target_ptr=(6 | (2 << 16))
  //   Entry 1: slot=13, kind=16, rights=0x208; target_ptr=0
  pub let us_sidecar_word0 : u64 = 0x0000000B0005000C
  pub let us_sidecar_word1 : u64 = 0x0000000000020006
  pub let us_sidecar_word2 : u64 = 0x00000208001C000D
  pub let us_sidecar_word3 : u64 = 0x0000000000000000

  // ==========================================================================
  // us_scaffold_endpoint_id() -> US_ENDPOINT_ID
  // us_scaffold_slot_ep()     -> US_CAP_SLOT_EP
  // us_scaffold_slot_sup()    -> US_CAP_SLOT_SUP
  //
  // Trivial getters exposed so the boot witness can call and assert.
  // ==========================================================================

  pub let us_scaffold_endpoint_id : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-001 (#1537): return the reserved endpoint id. Boot witness asserts to catch drift. Leaf.",
      block: {
        mov rax, 6;
        ret
      }
    }

  pub let us_scaffold_slot_ep : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-001 (#1537): reserved slot for svc.user_lifecycle. Leaf.",
      block: {
        mov rax, 12;
        ret
      }
    }

  pub let us_scaffold_slot_sup : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-001 (#1537): reserved slot for KIND_SUPERVISOR. Leaf.",
      block: {
        mov rax, 13;
        ret
      }
    }
}
