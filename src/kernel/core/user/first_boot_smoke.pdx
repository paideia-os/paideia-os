// src/kernel/core/user/first_boot_smoke.pdx — R48.M4-006 (#1536)
//
// First-boot fixture: exercises the M4 provisioning walker on a
// fresh-disk shape and prints "FIRST BOOT SMOKE OK\n" if every gate
// answers the expected value.
//
// =============================================================================
// §0  WHAT THIS FIXTURE PROVES
// =============================================================================
//
// Every M4 primitive whose arbitrated pin is 0 today is exercised here
// to prove its refusal path fires cleanly.  Pinning the refusal path is
// the point at R48.M4 — the affirmative path lands with the crypto +
// PdxFS-mkdir wiring in the followup driver-touchdown milestone.  A
// smoke that only asserted the affirmative path would silently pass
// on the arbitrated-0 tree.
//
// The seven asserts:
//   (1) first_boot_needed answers UNAVAILABLE when pdxfs is not mounted
//       (fresh boot without a mount) — the boot witness runs this
//       fixture BEFORE pdxfs_lite_mount lands.
//   (2) first_boot_cached returns the same UNAVAILABLE after the
//       first_boot_needed call installed it.
//   (3) pass_readline refuses BADARG on a zero buffer.
//   (4) pass_readline refuses NOTATTY on a legitimate buffer (the
//       stub path — pinned by the arbitrated-0 fb-console raw-read).
//   (5) founder_keygen_mint refuses NOCRYPTO on legitimate output
//       buffer pointers (the arbitrated pin is 0).
//   (6) founder_home_provision refuses NOMKDIR on a well-formed login
//       (the arbitrated pin is 0).
//   (7) founder_cap_seed_add succeeds for a base-kind whitelist entry
//       and founder_cap_seed_sign_all refuses NOCRYPTO.

module FirstBootSmoke = structure {

  // Static input buffers for the smoke.
  pub let mut _fbs_pass_buf : [u8; 64] = uninit @align(64)
  pub let mut _fbs_pk_out   : [u8; 1952] = uninit @align(64)
  pub let mut _fbs_sk_out   : [u8; 4032] = uninit @align(64)
  pub let fbs_login : [u8; 8] = "founder\0"

  pub let fbs_ok_msg   : [u8; 21] = "FIRST BOOT SMOKE OK\n\0"

  pub let first_boot_smoke : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-006 (#1536): drive every M4 primitive and assert its refusal-band answer. On any mismatch the fixture returns without emitting the OK banner, so the boot-witness log records the absence rather than a silent pass. Labels prefixed fbs_.",
      block: {
        push r12;
        push r13;
        push r14;                        // odd pushes for rsp%16 stay balanced

        // (1) first_boot_needed on unmounted -> UNAVAILABLE class.
        call first_boot_needed;
        mov r10, 0xFFFFE500;
        cmp rax, r10;
        jb  fbs_fail;                    // must be in the UNAVAILABLE band

        // (2) first_boot_cached -> same answer.
        call first_boot_cached;
        mov r10, 0xFFFFE500;
        cmp rax, r10;
        jb  fbs_fail;

        // (3) pass_readline zero buffer -> BADARG.
        mov rdi, 0;
        mov rsi, 32;
        call pass_readline;
        mov r10, 0xFFFFE51F;
        cmp rax, r10;
        jne fbs_fail;

        // (4) pass_readline legit buffer -> NOTATTY (arbitrated 0 path).
        lea rdi, [rip + _fbs_pass_buf];
        mov rsi, 32;
        call pass_readline;
        mov r10, 0xFFFFE51C;
        cmp rax, r10;
        jne fbs_fail;

        // (5) founder_keygen_mint legit buffers -> NOCRYPTO.
        lea rdi, [rip + _fbs_pk_out];
        lea rsi, [rip + _fbs_sk_out];
        call founder_keygen_mint;
        mov r10, 0xFFFFE52E;
        cmp rax, r10;
        jne fbs_fail;

        // (6) founder_home_provision on 'founder' -> NOMKDIR.
        lea rdi, [rip + fbs_login];
        mov rsi, 7;
        call founder_home_provision;
        mov r10, 0xFFFFE53C;
        cmp rax, r10;
        jne fbs_fail;

        // (7) founder_cap_seed_add on KIND_SUPERVISOR -> OK; then sign -> NOCRYPTO.
        call founder_cap_seed_reset;
        mov rdi, 16;                     // KIND_SUPERVISOR
        mov rsi, 0xFFFF;                 // rights (all)
        mov rdx, 0;
        mov rcx, 0xC0FFEE;               // target_ptr
        mov r8, 0x1234;                  // created_ns
        call founder_cap_seed_add;
        cmp rax, 0;
        jne fbs_fail;

        call founder_cap_seed_sign_all;
        mov r10, 0xFFFFE54E;
        cmp rax, r10;
        jne fbs_fail;

        // Emit the OK banner.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + fbs_ok_msg];
        call klog_s1;

      fbs_fail:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
