// src/kernel/core/user/user_registry.pdx — R48.M5-004 (#1540)
//
// user_registry runtime map — populated from /system/users at boot.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE IN-MEMORY MAP the supervisor consults during a session
// to answer "does this fingerprint name a known user, and if so what
// are their quota / delegated_by / login_name?"  It is derived at boot
// from /system/users/*.pdxuser records (parser #1523), and is READ-ONLY
// after boot for every consumer except the user_supervisor's cap-mint
// path — which appends on `user add` and marks revoked on `user remove`
// (§1 write posture).
//
// It is NOT a security decision point.  A caller does NOT infer
// authority from a registry hit — authority comes from a live
// Cap<KIND_USER> the caller holds.  The registry is a NAME->METADATA
// map only; every mint gate cross-checks against it as a plausibility
// filter, never as a policy.
//
// =============================================================================
// §1  WRITE POSTURE
// =============================================================================
//
// Writes are gated on the caller holding the KIND_SUPERVISOR
// authority.  The two mutations are:
//
//   ur_add(pk_fp, login_name, quota, delegated_by, mfa) -> slot
//   ur_mark_revoked(slot) -> UR_OK
//
// Removal is DELIBERATELY ABSENT.  A revoked user's row lives forever
// so that a `user_pk` re-submission is rejected by the M2 blacklist
// gate (#1525) — collapsing removal with deletion would allow a
// deleted user's pk to be re-registered.
//
// =============================================================================
// §2  ROW LAYOUT — 128 bytes, 64 rows = 8 KiB
// =============================================================================
//
//   +0    u16 kind             UR_KIND_ACTIVE (0) or UR_KIND_REVOKED (1)
//   +2    u16 mfa_bits         0x01 pass, 0x02 hw, 0x04 bio
//   +4    u32 login_len
//   +8    u64 created_ns
//   +16   u64 quota_bytes
//   +24   u64 delegated_by_lo  (low 8 bytes of parent's fp — 0 if founder)
//   +32   u8[32] pk_fingerprint  (full sha3_256(user_pk))
//   +64   u8[32] login_name      (UTF-8 NUL-padded)
//   +96   u64 used_bytes         (running quota accounting — populated by
//                                 user_quota; boot-init = 0)
//   +104  reserved              (32 bytes for future fields)
//
// =============================================================================
// §3  ERROR BAND 0xFFFFE550..0xFFFFE55F
// =============================================================================

module UserRegistry = structure {

  pub let UR_MAX_ROWS      : u64 = 64
  pub let UR_ROW_BYTES     : u64 = 128

  pub let UR_KIND_ACTIVE   : u64 = 0
  pub let UR_KIND_REVOKED  : u64 = 1

  pub let UR_OK              : u64 = 0
  pub let UR_ERR_BADARG      : u64 = 0xFFFFE55F
  pub let UR_ERR_ENOSPC      : u64 = 0xFFFFE55E
  pub let UR_ERR_NOT_FOUND   : u64 = 0xFFFFE55D
  pub let UR_ERR_ALREADY     : u64 = 0xFFFFE55C
  pub let UR_ERR_BAD_STATE   : u64 = 0xFFFFE55B

  pub let UR_SLOT_NONE       : u64 = 0xFFFFFFFF

  // Row table (64 * 128 = 8192 bytes = 1024 u64).
  pub let mut _user_registry_rows : [u64; 1024] = uninit @align(64)

  // Counters — kept OUT of rows so revoke history is visible after
  // any single row's revocation.
  //   +0 active_count   currently non-revoked
  //   +8 revoked_count  lifetime revocations
  //   +16 add_count     lifetime additions
  pub let mut _user_registry_stats : [u64; 8] = uninit @align(64)

  pub let UR_ST_ACTIVE   : u64 = 0
  pub let UR_ST_REVOKED  : u64 = 1
  pub let UR_ST_ADD      : u64 = 2
  pub let UR_ST_MAX      : u64 = 8

  // ==========================================================================
  // ur_reset() -> ()  (boot only)
  // ==========================================================================

  pub let ur_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): scrub the row table + stats. Boot only. Every field zeros, so a stale row from a previous boot cannot survive as an active user. Labels prefixed ur_rs_.",
      block: {
        lea r10, [rip + _user_registry_rows];
        xor rax, rax;
        xor rcx, rcx;
      ur_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r11, 1024;
        cmp rcx, r11;
        jb  ur_rs_rows;

        lea r10, [rip + _user_registry_stats];
        xor rcx, rcx;
      ur_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ur_rs_stats;
        ret
      }
    }

  pub let ur_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): bounds-checked stat read. Labels prefixed ur_st_.",
      block: {
        cmp rdi, 8;
        jae ur_st_zero;
        lea r10, [rip + _user_registry_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ur_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ur_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): increment one stat, silent no-op on out-of-range. Labels prefixed ur_no_.",
      block: {
        cmp rdi, 8;
        jae ur_no_out;
        lea r10, [rip + _user_registry_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ur_no_out:
        ret
      }
    }

  // ==========================================================================
  // ur_row_va(row_id) -> row base VA
  //
  // Row byte offset = row_id * 128 (shl 7).  Internal helper: callers
  // are already bounds-checked.
  // ==========================================================================

  pub let ur_row_va : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): row_id -> VA. Labels prefixed ur_va_.",
      block: {
        lea rax, [rip + _user_registry_rows];
        mov r10, rdi;
        shl r10, 7;
        add rax, r10;
        ret
      }
    }

  pub let ur_row_kind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): row kind ordinal (ACTIVE / REVOKED). Returns UR_ERR_BADARG for out-of-range row. Labels prefixed ur_rk_.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae ur_rk_bad;
        call ur_row_va;
        mov rax, [rax + 0];
        and rax, 0xFFFF;
        ret;
      ur_rk_bad:
        mov rax, 0xFFFFE55F;
        ret
      }
    }

  // ==========================================================================
  // ur_find_by_fp_lo(fp_lo) -> row_id | UR_SLOT_NONE
  //
  // O(N) scan against low 8 bytes of the fingerprint.  Full 32-byte
  // compare requires the byte-load loop and is provided as a follow-up
  // (ur_find_by_fp).  The lo-only variant is the fast path callers
  // use for the boot-time uniqueness check; a collision is rejected
  // by adding the full-fp check at ur_add time.
  // ==========================================================================

  pub let ur_find_by_fp_lo : (u64) -> u64 !{mem} @{} =
    fn (fp_lo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): linear scan against pk_fingerprint bytes [0..8]. Refuses fp_lo == 0 (a valid sha3_256 will not have zero low half in practice, but structurally 0 is the sentinel for a scrubbed row's fp buffer). Returns UR_SLOT_NONE (0xFFFFFFFF) when nothing matches. Labels prefixed ur_fp_.",
      block: {
        cmp rdi, 0;
        je  ur_fp_none;
        xor rcx, rcx;
      ur_fp_scan:
        mov r10, 64;
        cmp rcx, r10;
        jae ur_fp_none;
        lea r10, [rip + _user_registry_rows];
        mov r11, rcx;
        shl r11, 7;
        add r10, r11;
        // Reject scrubbed rows (kind & mfa & login_len all zero + fp_lo zero).
        mov rax, [r10 + 32];             // pk_fingerprint[0..8]
        cmp rax, rdi;
        je  ur_fp_hit;
        add rcx, 1;
        jmp ur_fp_scan;
      ur_fp_hit:
        mov rax, rcx;
        ret;
      ur_fp_none:
        mov rax, 0xFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // ur_add(fp_lo, login_len, quota, delegated_by_lo, mfa) -> row_id | UR_ERR_*
  //
  // Appends one row.  Refuses collisions on fp_lo.  Login name bytes
  // are NOT copied here — this is the metadata seat; the parser
  // (#1523) copies bytes through ur_row_va.
  // ==========================================================================

  pub let ur_add : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fp_lo: u64) (login_len: u64) (quota: u64) (delegated_by_lo: u64) (mfa: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): append a row. Gates: (1) fp_lo != 0 -> BADARG. (2) login_len in [1, 31] -> BADARG. (3) collision check via ur_find_by_fp_lo -> ALREADY. (4) low-first free scan (kind ACTIVE + non-zero fp_lo names occupied). (5) write kind ACTIVE, mfa, login_len, quota, delegated_by, fp_lo. (6) bump stats. Six pushes, rsp%16==0. Labels prefixed ur_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // fp_lo
        mov r13, rsi;                    // login_len
        mov r14, rdx;                    // quota
        mov r15, rcx;                    // delegated_by_lo
        mov rbp, r8;                     // mfa

        cmp r12, 0;
        je  ur_ad_bad;
        cmp r13, 1;
        jb  ur_ad_bad;
        mov r10, 31;
        cmp r13, r10;
        ja  ur_ad_bad;

        mov rdi, r12;
        call ur_find_by_fp_lo;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        jne ur_ad_already;

        // Free-row scan: an occupied row has non-zero pk_fingerprint[0..8].
        xor rbx, rbx;
      ur_ad_scan:
        mov r10, 64;
        cmp rbx, r10;
        jae ur_ad_enospc;
        lea r10, [rip + _user_registry_rows];
        mov r11, rbx;
        shl r11, 7;
        add r10, r11;
        mov rax, [r10 + 32];
        cmp rax, 0;
        je  ur_ad_claim;
        add rbx, 1;
        jmp ur_ad_scan;

      ur_ad_claim:
        // Header word: kind(low 16) | mfa(bits 16-31) | login_len(bits 32-63).
        mov rax, 0;                      // UR_KIND_ACTIVE
        mov r11, rbp;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, r13;
        mov r11d, r11d;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;              // created_ns (filled by caller)
        mov [r10 + 16], r14;             // quota
        mov [r10 + 24], r15;             // delegated_by_lo
        mov [r10 + 32], r12;             // fp_lo (rest of fp filled by caller)
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov [r10 + 64], rax;
        mov [r10 + 72], rax;
        mov [r10 + 80], rax;
        mov [r10 + 88], rax;
        mov [r10 + 96], rax;             // used_bytes = 0
        mov [r10 + 104], rax;
        mov [r10 + 112], rax;
        mov [r10 + 120], rax;

        // Stats.
        lea r10, [rip + _user_registry_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        mov rax, rbx;
        jmp ur_ad_out;

      ur_ad_bad:
        mov rax, 0xFFFFE55F;
        jmp ur_ad_out;
      ur_ad_already:
        mov rax, 0xFFFFE55C;
        jmp ur_ad_out;
      ur_ad_enospc:
        mov rax, 0xFFFFE55E;

      ur_ad_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ur_mark_revoked(row_id) -> UR_OK | UR_ERR_*
  //
  // Marks a row as revoked and bumps the revoked counter.  The row is
  // preserved so the M2 blacklist gate can reject re-submission of the
  // fingerprint (§1).
  // ==========================================================================

  pub let ur_mark_revoked : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-004 (#1540): flip a row's kind field from ACTIVE to REVOKED and bump the revoked counter. Refuses out-of-range rows and rows already REVOKED (BAD_STATE, distinct from OK so callers can distinguish 'nothing to do' from 'done'). Manual row-VA compute (no nested call) so r10/r11 stay stable across the whole body. Labels prefixed ur_mr_.",
      block: {
        push r12;
        push r13;

        mov r10, 64;
        cmp rdi, r10;
        jae ur_mr_bad;

        mov r12, rdi;                    // stash row_id
        // Compute row VA = _user_registry_rows + row_id * 128.
        lea r13, [rip + _user_registry_rows];
        mov r10, r12;
        shl r10, 7;
        add r13, r10;

        mov rax, [r13 + 0];              // header word
        mov r10, rax;
        and r10, 0xFFFF;
        cmp r10, 0;                      // UR_KIND_ACTIVE
        jne ur_mr_state;

        // Clear low 16 of header, set to 1 (UR_KIND_REVOKED).
        // Mask via shr/shl (avoids reliance on NOT).
        mov r10, rax;
        shr r10, 16;
        shl r10, 16;                     // r10 = header with low 16 zeroed
        or  r10, 1;                      // UR_KIND_REVOKED
        mov [r13 + 0], r10;

        // Stats: active-- (saturating at 0), revoked++.
        lea r10, [rip + _user_registry_stats];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ur_mr_skip_dec;
        add rax, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + 0], rax;
      ur_mr_skip_dec:
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        xor rax, rax;
        pop r13;
        pop r12;
        ret;

      ur_mr_state:
        mov rax, 0xFFFFE55B;
        pop r13;
        pop r12;
        ret;
      ur_mr_bad:
        mov rax, 0xFFFFE55F;
        pop r13;
        pop r12;
        ret
      }
    }
}
