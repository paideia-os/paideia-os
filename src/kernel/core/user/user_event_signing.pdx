// src/kernel/core/user/user_event_signing.pdx — R48.M6-002 (#1545)
//
// Event-signing pipeline — every user event is signed by the actor's
// user_sk.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE PIPELINE that walks the just-appended
// UserEventsJournal record, feeds bytes [0..96] to the ML-DSA-65 sign
// primitive under the actor's user_sk, and lays the resulting 3293-
// byte signature into the record's continuation area.
//
// The record's signature area is 224 bytes (see UserEventsJournal §1);
// a 3293-byte signature does not fit.  Layout:
//
//   record   [0..96]     data covered by the signature
//   record   [96..320]   first 224 bytes of the signature
//   record'  [0..320]    next 320 bytes of the signature — record' is
//                        the sequentially-next record with kind=0
//                        (sentinel "signature-continuation"),
//                        actor_fp_lo/subject_fp_lo/body_words all zero.
//   ...                  eleven such continuation records span the
//                        remaining 3069 bytes.
//
// A reader rehydrates by copying [record.sig ++ record'..record'+K.sig]
// contiguously.
//
// It is NOT the signing primitive.  It DELEGATES to the M4-003
// arbitrated crypto primitive; the arbitrated pin here has the same
// meaning as FounderKeygen.founder_keygen_arbitrated.
//
// =============================================================================
// §1  ERROR BAND 0xFFFFE5B0..0xFFFFE5BF
// =============================================================================

module UserEventSigning = structure {

  pub let UES_SIG_LEN         : u64 = 3293
  pub let UES_SIG_IN_LEAD     : u64 = 224
  pub let UES_CONT_KIND       : u64 = 0

  pub let UES_OK             : u64 = 0
  pub let UES_ERR_BADARG     : u64 = 0xFFFFE5BF
  pub let UES_ERR_NOCRYPTO   : u64 = 0xFFFFE5BE
  pub let UES_ERR_NO_RECORD  : u64 = 0xFFFFE5BD
  pub let UES_ERR_INTERNAL   : u64 = 0xFFFFE5BC

  // ==========================================================================
  // ues_arbitrated() -> 0
  //
  // Pinned at 0 until v0.33-crypto SIGN lands.  Same posture as
  // founder_keygen_arbitrated.
  // ==========================================================================

  pub let ues_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M6-002 (#1545): pin at 0 until v0.33-crypto SIGN lands. Boot witness asserts. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ues_sign(seq, user_sk_va) -> UES_OK | UES_ERR_*
  //
  // Signs the record at `seq` with the caller-supplied user_sk (raw
  // ML-DSA-65 secret key bytes, 4032 bytes, held non-swappable per
  // model.md §2.1).  On the arbitrated==0 path, refuses NOCRYPTO
  // without touching the record — an unsigned "signed" record would
  // pass the boot verifier's presence check but fail the signature
  // check as an audit gap, and a caller that got NOCRYPTO from us MUST
  // roll the record back through uej_reset if it wants to.
  // ==========================================================================

  pub let ues_sign : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (seq: u64) (user_sk_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M6-002 (#1545): sign one journal record. Sequence: (1) seq < 256 else BADARG. (2) user_sk_va != 0 else BADARG. (3) uej_record_va(seq) != 0 else NO_RECORD. (4) ues_arbitrated() -> if 0, NOCRYPTO. (5) On arbitrated==1: paideia_mldsa65_sign(user_sk, record+0, 96, sig_scratch); scatter sig_scratch across lead + continuation records. Wiring lands post v0.33-crypto. Four pushes, rsp%16==0. Labels prefixed ues_sg_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov r10, 256;
        cmp r12, r10;
        jae ues_sg_bad;
        cmp r13, 0;
        je  ues_sg_bad;

        mov rdi, r12;
        call uej_record_va;
        cmp rax, 0;
        je  ues_sg_norec;

        call ues_arbitrated;
        cmp rax, 0;
        je  ues_sg_nocrypto;

        // arbitrated==1 delegation path — TBD.
        mov rax, 0xFFFFE5BC;             // UES_ERR_INTERNAL
        jmp ues_sg_out;

      ues_sg_bad:

        mov rax, 0xFFFFE5BF;

        jmp ues_sg_out;
      ues_sg_norec:
        mov rax, 0xFFFFE5BD;
        jmp ues_sg_out;
      ues_sg_nocrypto:
        mov rax, 0xFFFFE5BE;

      ues_sg_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ues_verify(seq, user_pk_va) -> 1 | 0 | UES_ERR_*
  //
  // Verifies that the record at `seq` was signed by user_pk_va.  Same
  // arbitrated posture — refuses NOCRYPTO on pinned-0.  On the
  // arbitrated==1 path returns 1/0.
  // ==========================================================================

  pub let ues_verify : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (seq: u64) (user_pk_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M6-002 (#1545): verify one journal record. Same gates as ues_sign; delegates to paideia_mldsa65_verify. Labels prefixed ues_vf_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov r10, 256;
        cmp r12, r10;
        jae ues_vf_bad;
        cmp r13, 0;
        je  ues_vf_bad;

        mov rdi, r12;
        call uej_record_va;
        cmp rax, 0;
        je  ues_vf_norec;

        call ues_arbitrated;
        cmp rax, 0;
        je  ues_vf_nocrypto;

        mov rax, 0xFFFFE5BC;
        jmp ues_vf_out;

      ues_vf_bad:

        mov rax, 0xFFFFE5BF;

        jmp ues_vf_out;
      ues_vf_norec:
        mov rax, 0xFFFFE5BD;
        jmp ues_vf_out;
      ues_vf_nocrypto:
        mov rax, 0xFFFFE5BE;

      ues_vf_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
