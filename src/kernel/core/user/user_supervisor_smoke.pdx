// src/kernel/core/user/user_supervisor_smoke.pdx — R48.M5-007 (#1543)
//
// user_supervisor fixture: create alice, delegate cap, revoke,
// verify cascade.
//
// =============================================================================
// §0  WHAT THIS FIXTURE PROVES
// =============================================================================
//
// The M5 substrate (registry, cap-mint gate, orphan sweep, quota
// enforcement) is exercised end-to-end against fabricated identities,
// without depending on the R48.M1 KIND_USER kind or the userspace
// binary.  The seven asserts:
//
//   (1) ur_reset leaves the registry clean.
//   (2) ur_add(alice) returns row 0.
//   (3) ur_add(alice-work, delegated_by=alice.fp_lo) returns row 1.
//   (4) ur_find_by_fp_lo(alice.fp_lo) returns row 0.
//   (5) uq_reserve(row 0, bytes<=quota) returns OK.
//   (6) uq_reserve(row 0, bytes>quota) returns EXCEEDED.
//   (7) uos_sweep_cascade(row 0) revokes at least one descendant
//       (alice-work).
//
// On any failure the fixture returns without emitting the OK banner.

module UserSupervisorSmoke = structure {

  pub let uss_ok_msg   : [u8; 27] = "USER SUPERVISOR SMOKE OK\n\0\0"

  pub let ALICE_FP_LO         : u64 = 0xA11CE00000000001
  pub let ALICE_WORK_FP_LO    : u64 = 0xA11CE0000000B33F
  pub let ALICE_QUOTA_BYTES   : u64 = 65536

  pub let user_supervisor_smoke : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M5-007 (#1543): drive the M5 primitives against fabricated identities. Exercises ur_reset, ur_add, ur_find_by_fp_lo, uq_reserve (twice — under and over), uos_sweep_cascade. Uses fabricated fp_lo values so no crypto primitive is required. Labels prefixed uss_.",
      block: {
        push r12;
        push r13;

        // (1) Reset.
        call ur_reset;

        // (2) Add alice.
        mov r10, 0xA11CE00000000001;
        mov rdi, r10;
        mov rsi, 5;                      // login_len = 5 ('alice')
        mov r10, 65536;
        mov rdx, r10;
        mov rcx, 0;                      // delegated_by = 0 (root)
        mov r8, 1;                       // mfa = passphrase
        call ur_add;
        cmp rax, 0;
        jne uss_fail;

        // (3) Add alice-work delegated under alice.
        mov r10, 0xA11CE0000000B33F;
        mov rdi, r10;
        mov rsi, 10;                     // 'alice-work' (chars refused
                                         // by fh_login_valid but here
                                         // ur_add itself only bounds len)
        mov r10, 32768;
        mov rdx, r10;
        mov r10, 0xA11CE00000000001;
        mov rcx, r10;                    // delegated_by = alice.fp_lo
        mov r8, 1;
        call ur_add;
        cmp rax, 1;
        jne uss_fail;

        // (4) Find alice by fp_lo.
        mov r10, 0xA11CE00000000001;
        mov rdi, r10;
        call ur_find_by_fp_lo;
        cmp rax, 0;
        jne uss_fail;

        // (5) Reserve under-quota.
        mov rdi, 0;                      // row 0
        mov rsi, 4096;
        call uq_reserve;
        cmp rax, 0;
        jne uss_fail;

        // (6) Reserve over-quota (65536 - 4096 = 61440 avail; ask for 65536).
        mov rdi, 0;
        mov r10, 65536;
        mov rsi, r10;
        call uq_reserve;
        mov r10, 0xFFFFE58E;             // UQ_ERR_EXCEEDED
        cmp rax, r10;
        jne uss_fail;

        // (7) Cascade revoke alice — expect at least 1 (alice-work).
        mov rdi, 0;
        call uos_sweep_cascade;
        cmp rax, 1;
        jb  uss_fail;

        // Emit OK as a two-line record — English narrative first, then
        // the byte-identical `USER SUPERVISOR SMOKE OK` fingerprint that
        // tests/r17/shell-shutdown.golden:462 anchors on.  R51 Phase C
        // batch 4 (SUBSYS_USER shard, boot-transcript.md §3.5): two-line
        // pattern chosen over bracketed suffix so the whole-line golden
        // still substring-matches the fingerprint line unchanged; see the
        // tag_uss_narrative declaration in keys.pdx for the coverage
        // rationale (whole-line OK anchor + covered_by()'s startswith).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + tag_uss_narrative];
        call klog_s1;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + uss_ok_msg];
        call klog_s1;

      uss_fail:
        pop r13;
        pop r12;
        ret
      }
    }
}
