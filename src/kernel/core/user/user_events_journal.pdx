// src/kernel/core/user/user_events_journal.pdx — R48.M6-001 (#1544)
//
// /system/audit/user-events/ append-only journal on PdxFS v1.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE APPEND ROUTE for user-lifecycle events (create, remove,
// delegate, revoke, elevate).  Every event is a fixed-size record
// packed into a per-event .pdxevent file under /system/audit/user-
// events/<seq>-<kind>.pdxevent.  The pathing is deliberately per-file
// (not one growing log) so a corrupted single event does not blast a
// hole in the journal's readability from the tools side.
//
// It is NOT the signing pipeline.  The signature is populated by
// UserEventSigning (#1545); this module lays out the record and hands
// the byte range to the signer.
//
// =============================================================================
// §1  RECORD LAYOUT — 320 bytes, aligned 64
// =============================================================================
//
//   +0    u32 magic = 'PDXE' (0x45585044 little-endian)
//   +4    u16 version = 1
//   +6    u16 kind   {1=create, 2=remove, 3=delegate, 4=revoke, 5=elevate}
//   +8    u64 seq          monotonic per-boot sequence number
//   +16   u64 tick_ns      monotonic timestamp
//   +24   u64 actor_fp_lo  low 8 bytes of the actor's pk_fingerprint
//   +32   u64 subject_fp_lo target user's fp_lo (or 0 for elevate)
//   +40   u64 body_word0   kind-specific
//   +48   u64 body_word1   kind-specific
//   +56   u64 body_word2   kind-specific
//   +64   u8[32]  reserved   0-filled today
//   +96   u8[224] signature  ML-DSA-65 sig (populated by #1545 signer;
//                             the record header lays out the full 3293-
//                             byte signature over multiple 320-byte
//                             records — the LEAD record's signature
//                             field points at a continuation area).
//
// The 3293-byte ML-DSA signature does not fit in a 320-byte record;
// see UserEventSigning for the continuation layout that spans one
// LEAD + K continuation records so a reader can rehydrate the
// signature into a contiguous 3293-byte buffer.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE5A0..0xFFFFE5AF
// =============================================================================

module UserEventsJournal = structure {

  pub let UEJ_MAGIC        : u64 = 0x45585044
  pub let UEJ_VERSION      : u64 = 1
  pub let UEJ_RECORD_BYTES : u64 = 320
  pub let UEJ_MAX_RECORDS  : u64 = 256

  pub let UEJ_KIND_CREATE   : u64 = 1
  pub let UEJ_KIND_REMOVE   : u64 = 2
  pub let UEJ_KIND_DELEGATE : u64 = 3
  pub let UEJ_KIND_REVOKE   : u64 = 4
  pub let UEJ_KIND_ELEVATE  : u64 = 5
  pub let UEJ_KIND_MAX      : u64 = 5

  pub let UEJ_OK             : u64 = 0
  pub let UEJ_ERR_BADARG     : u64 = 0xFFFFE5AF
  pub let UEJ_ERR_ENOSPC     : u64 = 0xFFFFE5AE
  pub let UEJ_ERR_BAD_KIND   : u64 = 0xFFFFE5AD
  pub let UEJ_ERR_BAD_ACTOR  : u64 = 0xFFFFE5AC
  pub let UEJ_ERR_INTERNAL   : u64 = 0xFFFFE5AB

  // In-memory ring — writable at boot, read-only afterwards from the
  // outside; only uej_append writes.  UEJ_MAX_RECORDS * 320 = 81_920
  // bytes = 10_240 u64.
  pub let mut _uej_ring : [u64; 10240] = uninit @align(64)

  //   +0   seq           next sequence number
  //   +8   head          write index (mod UEJ_MAX_RECORDS)
  //   +16  count         total records written this boot
  //   +24  err           last append error code
  pub let mut _uej_state : [u64; 8] = uninit @align(64)

  pub let UEJ_ST_SEQ   : u64 = 0
  pub let UEJ_ST_HEAD  : u64 = 1
  pub let UEJ_ST_COUNT : u64 = 2
  pub let UEJ_ST_ERR   : u64 = 3

  // ==========================================================================
  // uej_reset() -> ()  (boot only)
  // ==========================================================================

  pub let uej_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-001 (#1544): scrub ring + state. Boot only. Labels prefixed uej_rs_.",
      block: {
        lea r10, [rip + _uej_ring];
        xor rax, rax;
        xor rcx, rcx;
      uej_rs_ring:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r11, 10240;
        cmp rcx, r11;
        jb  uej_rs_ring;

        lea r10, [rip + _uej_state];
        xor rcx, rcx;
      uej_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  uej_rs_state;
        ret
      }
    }

  pub let uej_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M6-001 (#1544): 1 iff kind is in [1, 5]. Labels prefixed uej_kv_.",
      block: {
        cmp rdi, 1;
        jb  uej_kv_no;
        mov r10, 5;
        cmp rdi, r10;
        ja  uej_kv_no;
        mov rax, 1;
        ret;
      uej_kv_no:
        xor rax, rax;
        ret
      }
    }

  pub let uej_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-001 (#1544): total records written this boot. Leaf.",
      block: {
        lea r10, [rip + _uej_state];
        mov rax, [r10 + 16];             // UEJ_ST_COUNT * 8
        ret
      }
    }

  pub let uej_next_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-001 (#1544): pre-view of the next seq that uej_append would install. Read-only. Labels prefixed uej_ns_.",
      block: {
        lea r10, [rip + _uej_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // uej_append(kind, actor_fp_lo, subject_fp_lo, body0, body1, body2)
  //   -> seq | UEJ_ERR_*
  //
  // Fills one record and returns the assigned sequence number.  Does
  // NOT install the signature — the caller must invoke the signer
  // over bytes [0..96] of the returned record.
  // ==========================================================================

  pub let uej_append : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (actor_fp_lo: u64) (subject_fp_lo: u64) (body0: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-001 (#1544): append one event record. Gates: (1) uej_kind_valid -> BAD_KIND. (2) actor_fp_lo != 0 -> BAD_ACTOR (an event with no actor is not audit-able; refuse rather than record a signed 'unknown-actor' event that a future verifier would have no way to prove came from anyone). (3) head < UEJ_MAX_RECORDS else ENOSPC (deliberately not wrap; a wrap would silently DROP older evidence, and a wrap event is an audit boundary the caller MUST handle). (4) Fetch seq, install header words: magic/version/kind, seq, tick_ns (fetched via monotime_ticks_ns_wrapper — TODO wire), actor_fp_lo, subject_fp_lo, body0..body2. (5) bump seq, head, count. Six pushes, rsp%16==0. Labels prefixed uej_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // kind
        mov r13, rsi;                    // actor_fp_lo
        mov r14, rdx;                    // subject_fp_lo
        mov r15, rcx;                    // body0
        mov rbp, r8;                     // body1
        mov rbx, r9;                     // body2

        mov rdi, r12;
        call uej_kind_valid;
        cmp rax, 0;
        je  uej_ap_bad_kind;

        cmp r13, 0;
        je  uej_ap_bad_actor;

        // Head + seq snapshot.
        lea r10, [rip + _uej_state];
        mov rax, [r10 + 8];              // head
        mov r11, 256;                    // UEJ_MAX_RECORDS
        cmp rax, r11;
        jae uej_ap_enospc;

        // Compute record base VA = _uej_ring + head * 320.
        // 320 = 256 + 64.  Compute via shl 8 + shl 6.
        mov r11, rax;
        shl r11, 8;                      // head * 256
        mov rcx, rax;
        shl rcx, 6;                      // head * 64
        add r11, rcx;
        lea rcx, [rip + _uej_ring];
        add rcx, r11;                    // rcx = record VA

        // Word0: [31:0] magic | [47:32] version | [63:48] kind.
        mov rax, 0x45585044;             // UEJ_MAGIC (u32)
        mov r11, 1;                      // UEJ_VERSION (u16)
        shl r11, 32;
        or  rax, r11;
        mov r11, r12;
        and r11, 0xFFFF;
        shl r11, 48;
        or  rax, r11;
        mov [rcx + 0], rax;

        // seq.
        lea r10, [rip + _uej_state];
        mov rax, [r10 + 0];              // seq
        mov [rcx + 8], rax;

        // tick_ns — placeholder; wire monotime source in M6.M-follow.
        xor r11, r11;
        mov [rcx + 16], r11;

        mov [rcx + 24], r13;             // actor_fp_lo
        mov [rcx + 32], r14;             // subject_fp_lo
        mov [rcx + 40], r15;             // body0
        mov [rcx + 48], rbp;             // body1
        mov [rcx + 56], rbx;             // body2

        // Zero the reserved + signature area (bytes 64..320).  32 u64s.
        xor r11, r11;
        xor rax, rax;                    // rax = idx
      uej_ap_zsig:
        mov [rcx + 64 + rax * 8], r11;
        add rax, 1;
        cmp rax, 32;
        jb  uej_ap_zsig;

        // Bump seq, head, count.
        lea r10, [rip + _uej_state];
        mov rax, [r10 + 0];              // seq
        mov r11, rax;
        add r11, 1;
        mov [r10 + 0], r11;

        mov rax, [r10 + 8];              // head
        mov r11, rax;
        add r11, 1;
        mov [r10 + 8], r11;

        mov rax, [r10 + 16];             // count
        mov r11, rax;
        add r11, 1;
        mov [r10 + 16], r11;

        // Return the just-assigned seq.
        mov rax, [r10 + 0];
        add rax, 0xFFFFFFFFFFFFFFFF;     // seq - 1 = the one we wrote
        jmp uej_ap_out;

      uej_ap_bad_kind:

        mov rax, 0xFFFFE5AD;

        jmp uej_ap_out;
      uej_ap_bad_actor:
        mov rax, 0xFFFFE5AC;
        jmp uej_ap_out;
      uej_ap_enospc:
        mov rax, 0xFFFFE5AE;

      uej_ap_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // uej_record_va(seq) -> record VA | 0
  //
  // Returns the VA of the record that carries this seq.  Callers use
  // this to fetch fields; a future reader that memmaps the ring can
  // resolve seq -> record directly.
  // ==========================================================================

  pub let uej_record_va : (u64) -> u64 !{mem} @{} =
    fn (seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-001 (#1544): seq -> record VA. This module assigns seq monotonically starting at 0, so seq is the ring index today. When wrap lands, this function becomes the ONE ROUTE through which seq is resolved, and the wrap policy lives at the callsites. Returns 0 for out-of-range seq. Labels prefixed uej_rv_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae uej_rv_zero;
        mov r11, rdi;
        shl r11, 8;
        mov rax, rdi;
        shl rax, 6;
        add r11, rax;
        lea rax, [rip + _uej_ring];
        add rax, r11;
        ret;
      uej_rv_zero:
        xor rax, rax;
        ret
      }
    }
}
