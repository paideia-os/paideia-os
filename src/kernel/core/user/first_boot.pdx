// src/kernel/core/user/first_boot.pdx — R48.M4-001 (#1531)
//
// First-boot detection at kernel_main_uefi handoff.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE HELPER THAT ANSWERS: "does this disk hold any signed user
// records under /system/users/, or is this a fresh installation whose
// founder still needs to be provisioned?"  Two answers, and both
// deliberate:
//
//   FIRST_BOOT_NEEDED  — the /system/users directory is empty (or the
//                        pdxfs is fresh); the kernel must hand control to
//                        the founder-provisioning path (§ founder_keygen /
//                        founder_home / founder_cap_seed).
//   FIRST_BOOT_DONE    — at least one .pdxuser record exists; the kernel
//                        continues to the normal login path.
//
// A third answer would be "unknown" (mount failed, storage offline, …)
// and this module deliberately does NOT return that: unknown answers on
// this axis produce provisioning behavior at boot that is either a false
// re-provision (blows away an existing founder's account) or a false
// skip (leaves a fresh disk without a founder and no way to log in).
// Both are unrecoverable from user space, so the honest answer on a
// storage failure is FIRST_BOOT_UNAVAILABLE and the caller MUST panic
// rather than pick a default.
//
// =============================================================================
// §1  READ POSTURE — /system/users IS A DIRECTORY, NEVER A FILE
// =============================================================================
//
// The check is a directory-entry existence test, not a full record
// parse.  This module does NOT verify supervisor signatures on any
// .pdxuser it finds; that is the parser's job (#1523 M2-002).  What
// this module does is answer whether the "no users yet" state holds,
// which is the precondition for the founder-provisioning walker.
//
// PdxFS v1 lands at R42; on a filesystem that does not yet mount, the
// helper returns FIRST_BOOT_UNAVAILABLE (0xFFFFE500) and does NOT
// silently answer NEEDED.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE500..0xFFFFE50F
// =============================================================================
//
// Sixteen-wide, disjoint from adjacent bands (verified by repo-grep).
// Only three codes today; twelve reserved for later gates.

module FirstBoot = structure {

  // §0: three-valued answer.
  pub let FIRST_BOOT_DONE        : u64 = 0
  pub let FIRST_BOOT_NEEDED      : u64 = 1
  pub let FIRST_BOOT_UNAVAILABLE : u64 = 0xFFFFE500

  // §2: error codes returned via the "unavailable" channel.
  pub let FIRST_BOOT_ERR_NOMOUNT : u64 = 0xFFFFE501
  pub let FIRST_BOOT_ERR_NOLOOKUP: u64 = 0xFFFFE502
  pub let FIRST_BOOT_ERR_IO      : u64 = 0xFFFFE503

  // The pathname under the root vnode. UTF-8, NUL-terminated.  Kept in
  // this module rather than a shared constant so a rename would be
  // detected as a build-time break rather than a runtime miss.
  pub let fb_users_path : [u8; 15] = "/system/users\0\0"

  // Cached answer.  first_boot_needed is called at most once per boot;
  // the cache lets subsequent inspection (audit_forwarder, boot witness)
  // read the same answer without re-mounting.
  //
  //   +0  answer_valid   0 = not yet computed; 1 = computed
  //   +8  cached_answer  one of {FIRST_BOOT_DONE, FIRST_BOOT_NEEDED,
  //                              FIRST_BOOT_UNAVAILABLE}
  pub let mut _first_boot_state : [u64; 8] = uninit @align(64)

  // Log strings.
  pub let fb_msg_needed : [u8; 20] = "FIRST BOOT NEEDED\n\0\0"
  pub let fb_msg_done   : [u8; 18] = "FIRST BOOT DONE\n\0\0"
  pub let fb_msg_noio   : [u8; 21] = "FIRST BOOT NO STORE\n\0"

  // ==========================================================================
  // first_boot_reset() -> ()  (boot only)
  // ==========================================================================

  pub let first_boot_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-001 (#1531): clear the cache.  Boot only.  Labels prefixed fb_rs_.",
      block: {
        lea r10, [rip + _first_boot_state];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // first_boot_cached() -> answer | FIRST_BOOT_UNAVAILABLE
  //
  // Returns the cached answer.  Callers that want a freshly recomputed
  // answer must call first_boot_needed instead.
  // ==========================================================================

  pub let first_boot_cached : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-001 (#1531): report the cached decision.  A caller that reads before the compute step is a caller acting on an unset answer, so the pre-compute value is FIRST_BOOT_UNAVAILABLE rather than DONE.  Labels prefixed fb_ca_.",
      block: {
        lea r10, [rip + _first_boot_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  fb_ca_unavail;
        mov rax, [r10 + 8];
        ret;
      fb_ca_unavail:
        mov rax, 0xFFFFE500;
        ret
      }
    }

  // ==========================================================================
  // first_boot_needed() -> FIRST_BOOT_DONE | FIRST_BOOT_NEEDED |
  //                        FIRST_BOOT_UNAVAILABLE
  //
  // Consults pdxfs_lite: if the FS is not mounted, return UNAVAILABLE.
  // Otherwise look up "/system/users"; if the lookup fails with ENOENT
  // treat that as NEEDED (a fresh install has no such directory yet),
  // any other lookup failure is UNAVAILABLE.  If the lookup succeeds,
  // check whether the directory has children — this MVP treats
  // "directory present" as "at least one user record was ever created"
  // (the M2 record-parser will refine this to "at least one non-revoked
  // record"; the seam here is deliberately coarse so first-boot detection
  // does not depend on record-format details).
  // ==========================================================================

  // Scratch for pdxfs_lite_namei's out_vnode write-back.  Read once,
  // never again — the resolved vnode index is not consumed by this
  // module; only the return code matters for the boot decision.
  pub let mut _fb_out_vnode : [u64; 2] = uninit @align(16)

  pub let first_boot_needed : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-001 (#1531): the honest boot-time predicate. Sequence: (1) pdxfs_lite_is_mounted() -> if 0, cache and return FIRST_BOOT_UNAVAILABLE (an unavailable storage layer is not evidence of a fresh install; the caller must panic rather than false-provision). (2) pdxfs_lite_namei(path_ptr, path_len, out_vnode_ptr) on '/system/users' — ENOENT (1) => FIRST_BOOT_NEEDED (the directory has never been created, which is what an installer-fresh disk looks like), OK (0) => FIRST_BOOT_DONE (at least the directory exists; the M2 parser will refine to non-revoked-record existence), any other code => UNAVAILABLE.  The three-valued answer stays: nothing here collapses UNAVAILABLE into DONE or NEEDED because either false answer writes an unbounded amount of damage into the installer path (blowing away an existing founder or leaving a fresh disk with no way to log in). Labels prefixed fb_ne_.",
      block: {
        push r13;
        push r14;                        // pad only — 2 pushes keep rsp%16==0

        call pdxfs_lite_is_mounted;
        cmp rax, 0;
        je  fb_ne_unavail_nomount;

        // pdxfs_lite_namei(path, path_len, out_vnode).
        lea rdi, [rip + fb_users_path];
        mov rsi, 13;                     // strlen("/system/users")
        lea rdx, [rip + _fb_out_vnode];
        call pdxfs_lite_namei;
        mov r13, rax;

        cmp r13, 0;                      // PDXFS_NAMEI_OK
        je  fb_ne_done;
        cmp r13, 1;                      // PDXFS_NAMEI_ENOENT
        je  fb_ne_needed;
        cmp r13, 2;                      // PDXFS_NAMEI_ENOTMOUNTED
        je  fb_ne_unavail_nomount;
        jmp fb_ne_unavail_io;

      fb_ne_done:
        lea r10, [rip + _first_boot_state];
        mov rax, 1;
        mov [r10 + 0], rax;
        xor rax, rax;                    // FIRST_BOOT_DONE
        mov [r10 + 8], rax;
        jmp fb_ne_out;

      fb_ne_needed:
        lea r10, [rip + _first_boot_state];
        mov rax, 1;
        mov [r10 + 0], rax;
        mov rax, 1;                      // FIRST_BOOT_NEEDED
        mov [r10 + 8], rax;
        jmp fb_ne_out;

      fb_ne_unavail_nomount:
        lea r10, [rip + _first_boot_state];
        mov rax, 1;
        mov [r10 + 0], rax;
        mov rax, 0xFFFFE501;             // FIRST_BOOT_ERR_NOMOUNT
        mov [r10 + 8], rax;
        jmp fb_ne_out;

      fb_ne_unavail_io:
        lea r10, [rip + _first_boot_state];
        mov rax, 1;
        mov [r10 + 0], rax;
        mov rax, 0xFFFFE503;             // FIRST_BOOT_ERR_IO
        mov [r10 + 8], rax;

      fb_ne_out:
        lea r10, [rip + _first_boot_state];
        mov rax, [r10 + 8];
        pop r14;
        pop r13;
        ret
      }
    }
}
