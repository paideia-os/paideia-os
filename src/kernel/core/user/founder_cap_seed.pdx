// src/kernel/core/user/founder_cap_seed.pdx — R48.M4-005 (#1535)
//
// Initial capability tree signing under paideia_root_pk.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE ROUTE that binds the founder identity to the initial
// mint of every base capability listed in design/user/model.md §3.2:
//
//   KIND_SUPERVISOR         KIND_USER(founder)
//   KIND_PDXFS(root)        KIND_NETWORK(*)
//   KIND_HW                 KIND_DEVICE(*)
//   KIND_DRIVER(*)          KIND_SYSTEM_LOG
//
// Each of these caps is minted into the founder's cap-space AND the
// mint record is signed by paideia_root_pk (the ML-DSA-65 root that
// lived through installer setup — model.md §9.4).  A downstream
// verifier reading the signed cap tree from disk can prove: "yes, this
// founder was created under this root, and this base-cap set was
// authorized at that time."
//
// It is NOT the runtime cap-mint gate — every one of those kinds has
// its own kernel-side mint gate (KindOpRegion.opregion_cap_mint etc.).
// This module builds the ONE-TIME BOOT-TIME record that lets the
// supervisor verify at every subsequent boot that no one has silently
// added a base cap to founder.
//
// =============================================================================
// §1  RECORD LAYOUT (packed, ONE ROW PER BASE CAP)
// =============================================================================
//
//   +0   u16   kind             (base kind ordinal — 0x02..0x1F for base,
//                                or 0x190 for KIND_USER)
//   +2   u16   rights           (subset of kind's rights mask)
//   +4   u32   scope_hint       (kind-specific — e.g. bdf, subtree ino)
//   +8   u64   target_ptr       (matches the descriptor at mint time)
//   +16  u64   created_ns       (monotonic tick at mint)
//   +24  u64   founder_fp_lo    (low 8 bytes of the founder's pk_fingerprint;
//                                the full 32-byte fp lives in _founder_pk_fp)
//   +32  reserved_zero          (32 bytes for future fields)
//   +64  ML-DSA-65 signature over bytes [0..64] under paideia_root_pk
//                                (3293 bytes; layout in row bytes [64..3357])
//   [3360] rounded up to 64-byte alignment (3 bytes reserved+padding)
//
// Row stride: 3360 bytes.  Nine rows: 30,240 bytes total.
//
// =============================================================================
// §2  ARBITRATED
// =============================================================================
//
// founder_cap_seed_arbitrated() is 0 until paideia-as v0.33-crypto lands
// the ML-DSA-65 SIGN primitive (keygen is #1533; the sign primitive is a
// distinct entry point in the same bundle).  Until then, seed_mint
// refuses with FCS_ERR_NOCRYPTO rather than writing an unsigned "signed"
// row — an unverified row on disk is worse than no row at all because
// the boot verifier would silently accept it.
//
// =============================================================================
// §3  ERROR BAND 0xFFFFE540..0xFFFFE54F
// =============================================================================

module FounderCapSeed = structure {

  pub let FCS_ROW_BYTES     : u64 = 3360
  pub let FCS_MAX_ROWS      : u64 = 9
  pub let FCS_SIG_LEN       : u64 = 3293
  pub let FCS_FP_LEN        : u64 = 32

  pub let FCS_OK              : u64 = 0
  pub let FCS_ERR_BADARG      : u64 = 0xFFFFE54F
  pub let FCS_ERR_NOCRYPTO    : u64 = 0xFFFFE54E
  pub let FCS_ERR_ENOSPC      : u64 = 0xFFFFE54D
  pub let FCS_ERR_BAD_KIND    : u64 = 0xFFFFE54C
  pub let FCS_ERR_INTERNAL    : u64 = 0xFFFFE54B

  // Nine row scaffold, .bss.  Written once at first-boot; read
  // read-only at every subsequent boot.  Row layout per §1.
  // 9 * 3360 = 30240 bytes = 3780 u64.
  pub let mut _founder_cap_seed_rows : [u64; 3780] = uninit @align(64)

  // Founder's 32-byte pk_fingerprint, kept in-band with the seed rows
  // so a boot-time verifier reads both from one file.
  pub let mut _founder_pk_fp : [u8; 32] = uninit @align(32)

  // Row occupancy counter.  0..FCS_MAX_ROWS.
  pub let mut _founder_cap_seed_count : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // founder_cap_seed_arbitrated() -> 0
  // ==========================================================================

  pub let founder_cap_seed_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-005 (#1535): report whether the ML-DSA-65 SIGN primitive is available. Pinned at 0 until paideia-as v0.33-crypto lands. Boot witness asserts. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // founder_cap_seed_reset() -> ()  (boot only)
  // ==========================================================================

  pub let founder_cap_seed_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-005 (#1535): clear the row scaffold, the fp buffer, and the row counter. Boot only. Zeroization of the fp buffer is what keeps a residual founder identity from leaking into a later boot's verifier. Labels prefixed fcs_rs_.",
      block: {
        // Row scaffold: 3780 u64s.
        lea r10, [rip + _founder_cap_seed_rows];
        xor rax, rax;
        xor rcx, rcx;
      fcs_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r11, 3780;
        cmp rcx, r11;
        jb  fcs_rs_rows;

        // Fingerprint buffer: 4 u64s.
        lea r10, [rip + _founder_pk_fp];
        xor rcx, rcx;
      fcs_rs_fp:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  fcs_rs_fp;

        // Counter.
        lea r10, [rip + _founder_cap_seed_count];
        mov [r10], rax;
        ret
      }
    }

  pub let founder_cap_seed_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-005 (#1535): occupied-row count. Leaf.",
      block: {
        lea r10, [rip + _founder_cap_seed_count];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // founder_cap_seed_kind_valid(kind) -> 1 | 0
  //
  // The whitelist of base kinds the founder cap tree may reference at
  // seed time.  Everything else is refused: a seed row for
  // KIND_BACKLIGHT would be nonsense at first boot (no backlight is
  // yet discovered) and, worse, would signed-attest a specific panel
  // as "founder-owned" before the driver has even enumerated it.
  // ==========================================================================

  pub let founder_cap_seed_kind_valid : (u64) -> u64 !{} @{} =
    fn (kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-005 (#1535): 1 iff kind is in the base-cap whitelist from model.md §3.2: KIND_PROCESS (1), KIND_PAGE (4), KIND_IPC_ENDPOINT (5), KIND_DEVICE (10), KIND_DRIVER (11), KIND_NETWORK (12), KIND_HW (14), KIND_RESERVED (15), KIND_SUPERVISOR (16), KIND_SYSTEM_LOG (17), or KIND_USER (0x190). Refuses driver-derived kinds (0x15a etc.) — those get minted at driver-touchdown time, not at founder-seed time. Labels prefixed fcs_kv_.",
      block: {
        cmp rdi, 1;
        je  fcs_kv_yes;
        cmp rdi, 4;
        je  fcs_kv_yes;
        cmp rdi, 5;
        je  fcs_kv_yes;
        cmp rdi, 10;
        je  fcs_kv_yes;
        cmp rdi, 11;
        je  fcs_kv_yes;
        cmp rdi, 12;
        je  fcs_kv_yes;
        cmp rdi, 14;
        je  fcs_kv_yes;
        cmp rdi, 15;
        je  fcs_kv_yes;
        cmp rdi, 16;
        je  fcs_kv_yes;
        cmp rdi, 17;
        je  fcs_kv_yes;
        mov r10, 0x190;                  // KIND_USER
        cmp rdi, r10;
        je  fcs_kv_yes;
        xor rax, rax;
        ret;
      fcs_kv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // founder_cap_seed_add(kind, rights, scope_hint, target_ptr, created_ns)
  //   -> FCS_OK | FCS_ERR_*
  //
  // Adds one row.  Signature is deferred to the arbitrated-1 path.
  // ==========================================================================

  pub let founder_cap_seed_add : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (rights: u64) (scope_hint: u64) (target_ptr: u64) (created_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-005 (#1535): append one row to the seed scaffold. Gates: (1) count < FCS_MAX_ROWS -> ENOSPC. (2) kind whitelist -> BAD_KIND. Body writes the header words (kind, rights, scope_hint, target_ptr, created_ns) at row offset [0..24]; leaves signature zone [64..3357] untouched — signing is a separate step that only runs when the arbitrated pin is 1. Row stride 3360 = 3328 + 32; 3328 = 416 * 8 so the row byte offset is (row_id * 3360) which is not a shl. Row byte offset computed as `row_id * 3360` via mul-free build: r10 = row_id * 2048 (shl 11) + row_id * 1024 (shl 10) + row_id * 256 (shl 8) + row_id * 32 (shl 5); 2048+1024+256+32=3360. Six pushes leave rsp%16==0. Labels prefixed fcs_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // kind
        mov r13, rsi;                    // rights
        mov r14, rdx;                    // scope_hint
        mov r15, rcx;                    // target_ptr
        mov rbp, r8;                     // created_ns

        // (1) count check.
        lea r10, [rip + _founder_cap_seed_count];
        mov rbx, [r10];
        mov r11, 9;                      // FCS_MAX_ROWS
        cmp rbx, r11;
        jae fcs_ad_enospc;

        // (2) kind whitelist.
        mov rdi, r12;
        call founder_cap_seed_kind_valid;
        cmp rax, 0;
        je  fcs_ad_bad_kind;

        // Compute row_byte_off = rbx * 3360.
        mov r10, rbx;
        shl r10, 11;                     // rbx * 2048
        mov r11, rbx;
        shl r11, 10;                     // rbx * 1024
        add r10, r11;
        mov r11, rbx;
        shl r11, 8;                      // rbx * 256
        add r10, r11;
        mov r11, rbx;
        shl r11, 5;                      // rbx * 32
        add r10, r11;                    // r10 = rbx * 3360

        lea r11, [rip + _founder_cap_seed_rows];
        add r10, r11;                    // r10 = row base VA

        // Header words at [0..24].  kind in low 16 of word0; rights
        // in bits [31:16]; scope_hint in bits [63:32]; target_ptr @+8;
        // created_ns @+16; founder_fp_lo @+24 (filled by _sign step).
        mov rax, r12;
        and rax, 0xFFFF;
        mov r11, r13;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, r14;
        mov r11d, r11d;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8], r15;
        mov [r10 + 16], rbp;
        xor rax, rax;
        mov [r10 + 24], rax;             // founder_fp_lo (filled later)

        // Bump counter.
        lea r10, [rip + _founder_cap_seed_count];
        add rbx, 1;
        mov [r10], rbx;

        xor rax, rax;                    // FCS_OK
        jmp fcs_ad_out;

      fcs_ad_enospc:
        mov rax, 0xFFFFE54D;
        jmp fcs_ad_out;
      fcs_ad_bad_kind:
        mov rax, 0xFFFFE54C;

      fcs_ad_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // founder_cap_seed_sign_all() -> FCS_OK | FCS_ERR_NOCRYPTO | ...
  //
  // Iterates every row and installs the paideia_root_pk signature.
  // Refuses on the arbitrated==0 path.
  // ==========================================================================

  pub let founder_cap_seed_sign_all : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-005 (#1535): sign every occupied row under paideia_root_pk. Refuses with FCS_ERR_NOCRYPTO on arbitrated==0 so the caller cannot install an unsigned seed record. On arbitrated==1 (post v0.33-crypto sign primitive), iterate rows and call paideia_mldsa65_sign(root_sk, row+0, 64, row+64) for each. Labels prefixed fcs_sa_.",
      block: {
        call founder_cap_seed_arbitrated;
        cmp rax, 0;
        je  fcs_sa_nocrypto;
        mov rax, 0xFFFFE54B;             // FCS_ERR_INTERNAL (path unreachable)
        ret;
      fcs_sa_nocrypto:
        mov rax, 0xFFFFE54E;
        ret
      }
    }
}
