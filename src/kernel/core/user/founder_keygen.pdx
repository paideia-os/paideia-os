// src/kernel/core/user/founder_keygen.pdx — R48.M4-003 (#1533)
//
// Founder ML-DSA-65 keypair generation seam.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is THE SEAM the founder-provisioning walker calls to mint the
// founder's (user_pk, user_sk) pair.  It exposes ONE entry point:
//
//   founder_keygen_mint(pk_out_va, sk_out_va) -> FK_OK | FK_ERR_*
//
// The seam is arbitrated behind founder_keygen_arbitrated().  Same
// posture as backlight_dpaux_arbitrated / ec_access_arbitrated: the
// pin is a value the boot witness asserts on, not a claim in a
// comment.  It returns 0 today because paideia-as v0.33-crypto-kdf
// has not landed yet — no ML-DSA-65 primitive is available in this
// tree.  When v0.33 lands the pin flips to 1 and the mint delegates
// to the crypto primitive; until then, an installer that asks for a
// software-generated founder key is answered with FK_ERR_NOCRYPTO
// rather than a fabricated buffer full of zeros.
//
// This is deliberate: shipping a zeros-filled "founder public key"
// as though it were a real identity would leave a working login path
// whose signing authority any attacker can trivially fabricate.
//
// =============================================================================
// §1  BUFFER SHAPES
// =============================================================================
//
//   pk_out_va  1952 bytes (ML-DSA-65 public key per model.md §9.1)
//   sk_out_va  4032 bytes (ML-DSA-65 secret key per model.md §9.2)
//
// Both must be caller-owned, aligned, non-zero.  The MINT does NOT
// seal the sk — that is #1527's job (Argon2id-KDF + ChaCha20-Poly1305).
// This module returns raw sk bytes; the caller must seal before writing
// to disk.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE520..0xFFFFE52F
// =============================================================================

module FounderKeygen = structure {

  pub let FK_PK_LEN : u64 = 1952
  pub let FK_SK_LEN : u64 = 4032

  pub let FK_OK              : u64 = 0
  pub let FK_ERR_BADARG      : u64 = 0xFFFFE52F
  pub let FK_ERR_NOCRYPTO    : u64 = 0xFFFFE52E
  pub let FK_ERR_INTERNAL    : u64 = 0xFFFFE52D

  // ==========================================================================
  // founder_keygen_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Pinned at 0 by the boot witness so a future
  // milestone plumbing paideia-as v0.33-crypto-kdf cannot land without
  // rewriting the claim that says the crypto primitive is absent.
  // ==========================================================================

  pub let founder_keygen_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-003 (#1533): report whether an ML-DSA-65 keypair primitive is available to this tree. IT RETURNS 0, because paideia-as v0.33-crypto-kdf has not landed. When it does, the pin flips to 1 and this file's mint delegates to the primitive. Boot witness asserts the pin so the claim in the module header cannot silently rot. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // founder_keygen_arg_valid(pk_out, sk_out) -> 1 | 0
  // ==========================================================================

  pub let founder_keygen_arg_valid : (u64, u64) -> u64 !{} @{} =
    fn (pk_out: u64) (sk_out: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-003 (#1533): 1 iff pk_out non-zero AND sk_out non-zero AND pk_out != sk_out (a keygen whose two output buffers alias would write the sk over the pk on any implementation that emits the pk from the sk). Pure leaf. Labels prefixed fk_av_.",
      block: {
        cmp rdi, 0;
        je  fk_av_no;
        cmp rsi, 0;
        je  fk_av_no;
        cmp rdi, rsi;
        je  fk_av_no;
        mov rax, 1;
        ret;
      fk_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // founder_keygen_mint(pk_out_va, sk_out_va) -> FK_OK | FK_ERR_*
  // ==========================================================================

  pub let founder_keygen_mint : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (pk_out_va: u64) (sk_out_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-003 (#1533): mint a founder ML-DSA-65 keypair. Sequence: (1) founder_keygen_arg_valid -> FK_ERR_BADARG. (2) founder_keygen_arbitrated() -> if 0, FK_ERR_NOCRYPTO. This is the STRUCTURAL REFUSAL that keeps the founder from being provisioned with a fabricated key while the crypto primitive is missing. (3) On the arbitrated==1 path (post v0.33-crypto-kdf landing), delegate to paideia_mldsa65_keypair(pk_out, sk_out); return its status. Until then, the delegation call is absent and the arbitrated gate is the sole boundary. Two pushes leave rsp%16==0. Labels prefixed fk_km_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        mov rsi, r13;
        call founder_keygen_arg_valid;
        cmp rax, 0;
        je  fk_km_bad;

        call founder_keygen_arbitrated;
        cmp rax, 0;
        je  fk_km_nocrypto;

        // arbitrated == 1 path: delegate to the crypto primitive.
        // Wire-up lands when paideia-as v0.33 crypto bundle exposes
        // paideia_mldsa65_keypair — until then, this branch is
        // unreachable and refusing here matches the honesty of the
        // arbitrated pin.
        mov rax, 0xFFFFE52D;             // FK_ERR_INTERNAL
        jmp fk_km_out;

      fk_km_bad:
        mov rax, 0xFFFFE52F;             // FK_ERR_BADARG
        jmp fk_km_out;

      fk_km_nocrypto:
        mov rax, 0xFFFFE52E;             // FK_ERR_NOCRYPTO

      fk_km_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
