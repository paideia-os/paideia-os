// src/kernel/core/user/user_quota.pdx — R48.M5-005 (#1541)
//
// Per-user quota_bytes enforcement, backed by user_registry rows.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE PLACE the supervisor consults before signing off on a
// PdxFS v1 write that would extend a user's subtree.  The write path
// (pdxfs_lite_write / pdxfs_v1_cow_write) calls uq_reserve(row_id,
// bytes) BEFORE the write; on success the row's used_bytes is bumped
// and the write proceeds.  A COW clone whose reserve is refused
// (UQ_ERR_EXCEEDED) surfaces the refusal to the caller so the write
// aborts with the specific "quota exceeded" error rather than a generic
// filesystem ENOSPC.
//
// It is NOT the accounting for pre-existing data.  The initial
// used_bytes at boot is 0; the M5.M-follow reconciler walks the
// subtree at boot to populate used_bytes accurately.  Until then,
// uq_reserve uses used_bytes strictly as a monotonic write counter,
// which is CORRECT for a fresh installation (which is the only shape
// the M4 first-boot walker leaves) and CONSERVATIVE for an upgrade
// (usage always looks smaller than reality).  The refusal-under
// direction is the safe one.
//
// =============================================================================
// §1  ARBITRATED
// =============================================================================
//
// uq_arbitrated() reports whether the used_bytes reconciler has run.
// Pinned at 0 today; the pre-reconcile refusal posture treats a
// legitimate reserve above the quota as EXCEEDED (which is correct
// under-count) rather than silently DELETE (which would over-count on
// a wrap).
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE580..0xFFFFE58F
// =============================================================================

module UserQuota = structure {

  pub let UQ_OK              : u64 = 0
  pub let UQ_ERR_BADARG      : u64 = 0xFFFFE58F
  pub let UQ_ERR_EXCEEDED    : u64 = 0xFFFFE58E
  pub let UQ_ERR_NO_USER     : u64 = 0xFFFFE58D
  pub let UQ_ERR_REVOKED     : u64 = 0xFFFFE58C
  pub let UQ_ERR_INTERNAL    : u64 = 0xFFFFE58B

  // ==========================================================================
  // uq_arbitrated() -> 0
  // ==========================================================================

  pub let uq_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-005 (#1541): report whether the used_bytes reconciler has run. IT RETURNS 0. Under the pinned 0 posture, uq_reserve is a monotonic write counter, correct-on-fresh, conservative-on-upgrade. Boot witness asserts the pin. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // uq_reserve(row_id, bytes) -> UQ_OK | UQ_ERR_*
  //
  // Reserves `bytes` against the row's quota.  If the row is out of
  // range, refuse BADARG.  If revoked, refuse REVOKED (distinct from
  // BADARG so the write path can log the useful failure mode).  If
  // used_bytes + bytes > quota_bytes (with overflow-safe check),
  // refuse EXCEEDED.  Otherwise bump used_bytes and return OK.
  // ==========================================================================

  pub let uq_reserve : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) (bytes: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M5-005 (#1541): reserve `bytes` against a user's quota. Sequence: (1) row_id < 64 else BADARG. (2) row's kind must be ACTIVE (0) else REVOKED (distinct code so the write path logs 'attempted write against revoked user' — a policy-visible event). (3) overflow-safe check: bytes > (quota - used) refused as EXCEEDED. Cheap two-add form: r10 = quota - used (saturating at 0 when used > quota via cmp/skip); r11 = bytes; if r11 > r10 -> EXCEEDED. (4) bump used += bytes at row+96. Two pushes leave rsp%16==0. Labels prefixed uq_re_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r10, 64;
        cmp rdi, r10;
        jae uq_re_bad;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // bytes

        // Row VA = _user_registry_rows + row_id * 128.
        lea r14, [rip + _user_registry_rows];
        mov r10, r12;
        shl r10, 7;
        add r14, r10;

        // Kind == ACTIVE?
        mov rax, [r14 + 0];
        and rax, 0xFFFF;
        cmp rax, 0;
        jne uq_re_revoked;

        mov r10, [r14 + 16];             // quota_bytes
        mov r15, [r14 + 96];             // used_bytes

        // Under-usage bail if used > quota (should not happen; treat as EXCEEDED).
        cmp r15, r10;
        ja  uq_re_exceeded;

        // avail = quota - used.
        mov rax, r10;
        // sub emulated as (add rax, 0-r15).  paideia-as supports sub.
        sub rax, r15;
        // Compare bytes vs avail.
        cmp r13, rax;
        ja  uq_re_exceeded;

        // Bump used.
        add r15, r13;
        mov [r14 + 96], r15;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      uq_re_exceeded:
        mov rax, 0xFFFFE58E;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      uq_re_revoked:
        mov rax, 0xFFFFE58C;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      uq_re_bad:
        mov rax, 0xFFFFE58F;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // uq_release(row_id, bytes) -> UQ_OK | UQ_ERR_*
  //
  // Decrements used_bytes by `bytes` (saturating at 0).  Called by the
  // PdxFS v1 GC path when a CoW clone is dropped.  Under the pinned-0
  // arbitrated posture, release is best-effort — over-count remains
  // possible on a boot without reconciliation.  BADARG on out-of-range.
  // ==========================================================================

  pub let uq_release : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M5-005 (#1541): release `bytes` from a row's used counter. Saturating at 0 so a race between reconciler + release cannot underflow the counter into the top of the u64 range. Labels prefixed uq_rl_.",
      block: {
        push r12;
        push r13;

        mov r10, 64;
        cmp rdi, r10;
        jae uq_rl_bad;

        mov r12, rdi;
        mov r13, rsi;

        lea r10, [rip + _user_registry_rows];
        mov r11, r12;
        shl r11, 7;
        add r10, r11;

        mov rax, [r10 + 96];
        cmp rax, r13;
        jbe uq_rl_zero;
        sub rax, r13;
        mov [r10 + 96], rax;
        jmp uq_rl_ok;
      uq_rl_zero:
        xor rax, rax;
        mov [r10 + 96], rax;
      uq_rl_ok:
        xor rax, rax;
        pop r13;
        pop r12;
        ret;
      uq_rl_bad:
        mov rax, 0xFFFFE58F;
        pop r13;
        pop r12;
        ret
      }
    }
}
