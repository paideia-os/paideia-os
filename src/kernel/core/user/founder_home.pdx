// src/kernel/core/user/founder_home.pdx — R48.M4-004 (#1534)
//
// Founder home subtree provisioning on PdxFS v1.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the ONE PROVISIONING WALKER that creates the founder's home
// subtree (/home/<login_name>) and the two per-user metadata
// directories that every user record depends on:
//
//   /home/<login>/.identity/         — user_pk.pdxid + user_sk.enc live here
//   /home/<login>/.remote/           — known-machines.pdxdata (§6.3)
//
// It does NOT populate the crypto material — user_pk.pdxid and
// user_sk.enc land through founder_cap_seed once founder_keygen returns
// a keypair.  The home subtree is a PREREQUISITE for that write; here
// we make the directories exist with the right ownership shape and the
// PdxFS v1 subtree cap ready for the founder cap tree to point at.
//
// This module encapsulates path assembly (login_name -> "/home/<n>")
// with a strict-length gate so a caller cannot smuggle a "/home/../"
// component through it.
//
// =============================================================================
// §1  ARBITRATED
// =============================================================================
//
// founder_home_arbitrated() reports whether PdxFS v1's mkdir /
// subtree-cap-mint pair is wired.  It returns 0 today because PdxFS v1
// mkdir is not yet exposed as a kernel-callable primitive (R42 landed
// the CoW + journal substrate; the mkdir wiring is a follow-up).  The
// provisioning walker refuses with FH_ERR_NOMKDIR when the pin is 0.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE530..0xFFFFE53F
// =============================================================================

module FounderHome = structure {

  pub let FH_OK              : u64 = 0
  pub let FH_ERR_BADARG      : u64 = 0xFFFFE53F
  pub let FH_ERR_LOGIN_LEN   : u64 = 0xFFFFE53E
  pub let FH_ERR_LOGIN_CHAR  : u64 = 0xFFFFE53D
  pub let FH_ERR_NOMKDIR     : u64 = 0xFFFFE53C
  pub let FH_ERR_MKDIR_FAIL  : u64 = 0xFFFFE53B
  pub let FH_ERR_INTERNAL    : u64 = 0xFFFFE53A

  pub let FH_LOGIN_MIN : u64 = 1
  pub let FH_LOGIN_MAX : u64 = 31          // model.md §9.1 login_name is [u8;32] NUL-padded

  // Path scratch — enough for "/home/" + FH_LOGIN_MAX + "/.identity" + NUL.
  //  "/home/" (6) + 31 + "/.identity" (10) + NUL (1) = 48.
  pub let mut _fh_path_scratch : [u8; 64] = uninit @align(64)

  // Static path prefixes.
  pub let fh_home_prefix   : [u8; 7]  = "/home/\0"
  pub let fh_identity_sfx  : [u8; 11] = "/.identity\0"
  pub let fh_remote_sfx    : [u8; 9]  = "/.remote\0"

  // ==========================================================================
  // founder_home_arbitrated() -> 0
  // ==========================================================================

  pub let founder_home_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-004 (#1534): report whether PdxFS v1 mkdir + subtree-cap-mint are wired. IT RETURNS 0 today: R42 landed the CoW + journal substrate; the mkdir wiring lands separately. Boot witness pins the value so the header claim cannot rot. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // founder_home_login_char_valid(c) -> 1 | 0
  //
  // The alphabet a login_name is allowed to contain.  Deliberately
  // restrictive: lowercase ASCII letters, digits, and '_'.  A caller
  // trying to smuggle '/', '.', or NUL through path assembly is
  // refused here rather than at the mkdir boundary; that keeps the
  // path-assembly primitive INJECTION-SAFE against the one exploit
  // Unix has (relative components in a login name).
  // ==========================================================================

  pub let founder_home_login_char_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M4-004 (#1534): 1 iff c is in [a-z0-9_]. Cases: lowercase a-z (0x61..0x7A), digits 0-9 (0x30..0x39), underscore (0x5F). Deliberately excludes '/', '.', NUL, uppercase, hyphen — all of which have historical footguns in path assembly or POSIX identity handling. Leaf. Labels prefixed fh_cv_.",
      block: {
        cmp rdi, 0x61;                   // 'a'
        jb  fh_cv_try_digit;
        cmp rdi, 0x7A;                   // 'z'
        ja  fh_cv_try_digit;
        mov rax, 1;
        ret;
      fh_cv_try_digit:
        cmp rdi, 0x30;                   // '0'
        jb  fh_cv_try_us;
        cmp rdi, 0x39;                   // '9'
        ja  fh_cv_try_us;
        mov rax, 1;
        ret;
      fh_cv_try_us:
        cmp rdi, 0x5F;                   // '_'
        je  fh_cv_yes;
        xor rax, rax;
        ret;
      fh_cv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // founder_home_login_valid(login_va, login_len) -> 1 | 0
  // ==========================================================================

  pub let founder_home_login_valid : (u64, u64) -> u64 !{mem} @{} =
    fn (login_va: u64) (login_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M4-004 (#1534): 1 iff login_va non-zero AND login_len in [FH_LOGIN_MIN, FH_LOGIN_MAX] AND every byte is founder_home_login_char_valid. Refuses zero-length names and names that would overflow the /system/users record layout (32 bytes NUL-padded per model.md §9.1). Labels prefixed fh_lv_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        cmp rdi, 0;
        je  fh_lv_no;
        cmp rsi, 1;                      // FH_LOGIN_MIN
        jb  fh_lv_no;
        mov r10, 31;                     // FH_LOGIN_MAX
        cmp rsi, r10;
        ja  fh_lv_no;

        mov r12, rdi;                    // login_va
        mov r13, rsi;                    // login_len
        xor r14, r14;                    // idx

      fh_lv_scan:
        cmp r14, r13;
        jae fh_lv_yes;
        xor rdi, rdi;
        mov_b rdi, [r12 + r14 * 1];      // byte load — pre-zeroed rdi for zero-ext
        call founder_home_login_char_valid;
        cmp rax, 0;
        je  fh_lv_no;
        add r14, 1;
        jmp fh_lv_scan;

      fh_lv_yes:
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      fh_lv_no:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // founder_home_provision(login_va, login_len) -> FH_OK | FH_ERR_*
  //
  // The full provisioning walker.  Refuses today with FH_ERR_NOMKDIR
  // because the arbitrated gate is pinned at 0.  Even in that refusal
  // it validates the login name so a bad login is refused with the
  // specific code rather than the generic NOMKDIR — that lets the
  // installer distinguish "the user typed something we can't accept"
  // from "the storage layer isn't ready".
  // ==========================================================================

  pub let founder_home_provision : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (login_va: u64) (login_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R48.M4-004 (#1534): provision the founder home subtree. Sequence: (1) founder_home_login_valid -> FH_ERR_LOGIN_LEN | FH_ERR_LOGIN_CHAR (currently collapsed to FH_ERR_LOGIN_LEN; a follow-up separates the two branches once the caller UI needs to distinguish them). (2) founder_home_arbitrated() -> if 0, FH_ERR_NOMKDIR. This structural refusal keeps the founder from being 'provisioned' with a nonexistent home while the mkdir wiring is missing. (3) On arbitrated==1 (post PdxFS v1 mkdir landing): assemble '/home/<login>', mkdir, mkdir '/.identity', mkdir '/.remote', mint the KIND_PDXFS subtree cap, return FH_OK. Wiring lands with #1534-follow. Two pushes leave rsp%16==0. Labels prefixed fh_pr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        mov rsi, r13;
        call founder_home_login_valid;
        cmp rax, 0;
        je  fh_pr_bad_login;

        call founder_home_arbitrated;
        cmp rax, 0;
        je  fh_pr_nomkdir;

        // Post-arbitration path: perform mkdirs + mint. Wiring TBD.
        mov rax, 0xFFFFE53A;             // FH_ERR_INTERNAL
        jmp fh_pr_out;

      fh_pr_bad_login:
        mov rax, 0xFFFFE53E;             // FH_ERR_LOGIN_LEN
        jmp fh_pr_out;

      fh_pr_nomkdir:
        mov rax, 0xFFFFE53C;             // FH_ERR_NOMKDIR

      fh_pr_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
