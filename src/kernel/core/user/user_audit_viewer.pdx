// src/kernel/core/user/user_audit_viewer.pdx — R48.M6-004 (#1547)
//
// audit-viewer basic query API — filter by user, event kind, time
// range.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the KERNEL-SIDE INDEXER over UserEventsJournal that userspace
// tools (`audit list`, `caps audit`) call to fetch a filtered subset
// of the journal without needing to memmap or iterate the ring
// themselves.
//
// It is NOT a full query engine — three predicates only, all AND-ed:
//
//   uav_query(actor_fp_lo, kind, tick_lo, tick_hi, out_seqs_va,
//             out_seqs_cap) -> match_count
//
//   actor_fp_lo    0 means "any actor".
//   kind           0 means "any kind".
//   tick_lo/tick_hi 0 in both means "any time"; otherwise inclusive
//                  range check against record.tick_ns.
//   out_seqs_va    caller-owned u64 array; matches are written seq-
//                  ascending until out_seqs_cap is reached.
//   out_seqs_cap   0 => refuse BADARG.
//
// A caller that wants OR semantics runs the query multiple times.
//
// =============================================================================
// §1  ERROR BAND 0xFFFFE5D0..0xFFFFE5DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band.  The R48 modules collectively occupy
// 0xFFFFE500..0xFFFFE5FF.

module UserAuditViewer = structure {

  pub let UAV_OK             : u64 = 0
  pub let UAV_ERR_BADARG     : u64 = 0xFFFFE5DF
  pub let UAV_ERR_BAD_KIND   : u64 = 0xFFFFE5DE
  pub let UAV_ERR_BAD_RANGE  : u64 = 0xFFFFE5DD
  pub let UAV_ERR_INTERNAL   : u64 = 0xFFFFE5DC

  // ==========================================================================
  // uav_record_match(record_va, actor_fp_lo, kind, tick_lo, tick_hi)
  //   -> 1 | 0
  //
  // Per-record predicate — inlined helper the loop calls.  Returns 0
  // for a scrubbed record (magic != UEJ_MAGIC).
  // ==========================================================================

  pub let uav_record_match : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (rec_va: u64) (actor_fp_lo: u64) (kind: u64) (tick_lo: u64) (tick_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-004 (#1547): per-record AND predicate. Gates in order: (1) magic == UEJ_MAGIC (0x45585044) — a record whose header does not carry the magic is either scrubbed or a signature-continuation; either way it is not a match. (2) kind: 0 accepts, else must equal record.kind. (3) actor_fp_lo: 0 accepts, else must equal record.actor_fp_lo. (4) tick range: if either lo or hi is non-zero, record.tick_ns must fall in [lo, hi] inclusive. Leaf w.r.t. this module. Labels prefixed uav_rm_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rec_va
        mov r13, rsi;                    // actor_fp_lo
        mov r14, rdx;                    // kind
        mov r15, rcx;                    // tick_lo
        // tick_hi stays in r8

        // Magic check (bytes 0..4 of word 0).
        mov rax, [r12 + 0];
        mov r10, rax;
        and r10, 0xFFFFFFFF;
        mov r11, 0x45585044;
        cmp r10, r11;
        jne uav_rm_no;

        // Extract record.kind from bits [63:48] of word 0.
        mov r10, rax;
        shr r10, 48;
        and r10, 0xFFFF;

        cmp r14, 0;
        je  uav_rm_skip_kind;
        cmp r10, r14;
        jne uav_rm_no;

      uav_rm_skip_kind:
        // Actor.
        cmp r13, 0;
        je  uav_rm_skip_actor;
        mov r10, [r12 + 24];
        cmp r10, r13;
        jne uav_rm_no;

      uav_rm_skip_actor:
        // Tick range.  If both r15 (lo) and r8 (hi) are 0, any tick matches.
        cmp r15, 0;
        jne uav_rm_check_range;
        cmp r8, 0;
        je  uav_rm_yes;

      uav_rm_check_range:

        mov r10, [r12 + 16];

        // record.tick_ns;
        cmp r10, r15;
        jb  uav_rm_no;
        cmp r10, r8;
        ja  uav_rm_no;

      uav_rm_yes:

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      uav_rm_no:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // uav_query(actor_fp_lo, kind, tick_lo, tick_hi, out_seqs_va,
  //           out_seqs_cap) -> match_count | UAV_ERR_*
  //
  // Arity SIX.  Iterates seq 0..UEJ_MAX_RECORDS and writes matching
  // seqs to out_seqs_va[0..cap].
  // ==========================================================================

  pub let uav_query : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (actor_fp_lo: u64) (kind: u64) (tick_lo: u64) (tick_hi: u64) (out_seqs_va: u64) (out_seqs_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M6-004 (#1547): fetch the matching-seq list. Gates: (1) out_seqs_va != 0 else BADARG. (2) out_seqs_cap != 0 else BADARG. (3) kind, if non-zero, must be in [1, 5] else BAD_KIND (the sentinel form '0 accepts any' is retained). (4) tick_lo <= tick_hi when both non-zero else BAD_RANGE. Loop 0..UEJ_MAX_RECORDS, call uej_record_va, feed to uav_record_match; on match, write seq to out_seqs and bump match_count; stop when match_count == cap. Six pushes leave rsp%16==0. Labels prefixed uav_qu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // actor_fp_lo
        mov r13, rsi;                    // kind
        mov r14, rdx;                    // tick_lo
        mov r15, rcx;                    // tick_hi
        mov rbp, r8;                     // out_va
        mov rbx, r9;                     // out_cap

        cmp rbp, 0;
        je  uav_qu_bad;
        cmp rbx, 0;
        je  uav_qu_bad;

        cmp r13, 0;
        je  uav_qu_skip_kv;
        mov r10, 5;
        cmp r13, r10;
        ja  uav_qu_bad_kind;
        cmp r13, 1;
        jb  uav_qu_bad_kind;

      uav_qu_skip_kv:
        cmp r14, 0;
        je  uav_qu_skip_rc;
        cmp r15, 0;
        je  uav_qu_skip_rc;
        cmp r14, r15;
        ja  uav_qu_bad_range;

      uav_qu_skip_rc:
        xor r10, r10;                    // seq
        xor r11, r11;                    // match_count

      uav_qu_loop:
        push r10;
        push r11;
        // Alignment: entry rsp%16=8, 6 pushes = 48 bytes -> rsp%16=8; 2 more
        // pushes = 16 bytes -> rsp%16=8. Add one sub for the call.
        sub rsp, 8;

        mov rdi, r10;
        call uej_record_va;
        mov rcx, rax;

        add rsp, 8;

        cmp rcx, 0;
        je  uav_qu_next_pop;

        // Prepare 5-arg call: rec_va=rcx, actor=r12, kind=r13, lo=r14, hi=r15.
        mov rdi, rcx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        mov r8, r15;
        sub rsp, 8;
        call uav_record_match;
        add rsp, 8;

        pop r11;
        pop r10;

        cmp rax, 0;
        je  uav_qu_next;

        // Match — write seq (r10) into out_va[match_count].
        mov rax, r11;
        shl rax, 3;
        add rax, rbp;
        mov [rax], r10;
        add r11, 1;

        cmp r11, rbx;
        jae uav_qu_done;

      uav_qu_next:
        add r10, 1;
        mov rax, 256;
        cmp r10, rax;
        jae uav_qu_done;
        jmp uav_qu_loop;

      uav_qu_next_pop:
        pop r11;
        pop r10;
        add r10, 1;
        mov rax, 256;
        cmp r10, rax;
        jae uav_qu_done;
        jmp uav_qu_loop;

      uav_qu_done:

        mov rax, r11;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      uav_qu_bad:

        mov rax, 0xFFFFE5DF;

        jmp uav_qu_out;
      uav_qu_bad_kind:
        mov rax, 0xFFFFE5DE;
        jmp uav_qu_out;
      uav_qu_bad_range:
        mov rax, 0xFFFFE5DD;

      uav_qu_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
