// src/kernel/core/acpi/gpe_ack.pdx — R30.M4-002 (#1067)
//
// The enable / disable / clear primitives, and the supervisor-side
// acknowledgement that ends a GPE's masked interval.
//
// -----------------------------------------------------------------------------
// Why these are not in the ISR's object
// -----------------------------------------------------------------------------
//
// Everything here runs on the SUPERVISOR's side of the boundary: it is
// called after a userspace handler has finished evaluating a firmware
// control method, in ordinary task context, with interrupts on. None
// of it is reachable from core/acpi/sci_isr.pdx, and keeping it in a
// separate object is what keeps that object's build-asserted call
// allowlist tight enough to mean something. An allowlist that had to
// admit the acknowledgement path would admit read-modify-write cycles
// on the enable register, and the ISR would then be one edit away from
// re-enabling a GPE it had just masked.
//
// -----------------------------------------------------------------------------
// The acknowledgement contract
// -----------------------------------------------------------------------------
//
// A GPE that fires is masked by the ISR and stays masked. gpe_ack is
// the only thing that unmasks it, and it does three things atomically
// from the caller's point of view: resets the strike count (the storm
// gate is about CONSECUTIVE unacknowledged assertions, so a successful
// handler is exactly what should clear it), clears the pending flag,
// and sets the enable bit again.
//
// Two refusals, with distinct codes:
//
//   GPE_ACK_PERM_MASKED  — the storm gate retired this GPE. An
//                          acknowledgement cannot revive it; only an
//                          explicit unregister/register cycle can, and
//                          that is deliberately a decision somebody
//                          has to make rather than something a late
//                          handler completion does by accident.
//   GPE_ACK_NOT_PENDING  — nothing was queued for this GPE. Enabling
//                          on an unsolicited acknowledgement would let
//                          a confused or hostile supervisor unmask
//                          arbitrary platform events.

module GpeAck = structure {

  // ============================================================================
  // gpe_enable(index) -> GPE_OK | GPE_REG_BAD_INDEX
  //
  // Set this GPE's enable bit, leaving its seven neighbours alone.
  // ============================================================================

  pub let gpe_enable : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (index: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-002 (#1067): read-modify-write the enable byte that owns this GPE, setting only its bit. The byte is read back rather than reconstructed from a shadow copy, because a shadow of a hardware register is a second source of truth that goes stale the first time firmware or a suspend path writes the real one. Refuses GPE_REG_BAD_INDEX when gpe_resolve cannot place the index in the configured geometry, before any port is computed. Three pushes (rbx, r12, r13) carry the index, the bit mask and the port across the four nested calls; entry rsp%16 == 8 and an odd push count returns it to 0 at every call site. Labels prefixed gpe_en_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        call gpe_resolve;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_en_bad;
        mov r12, rax;
        and r12, 0xFF;                         // bit index

        mov rdi, r12;
        call gpe_bit_mask;
        mov r12, rax;                          // bit mask

        mov rdi, rbx;
        call gpe_enable_port;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_en_bad;
        mov r13, rax;                          // enable port

        mov rdi, r13;
        call gpe_io_read8;
        or  rax, r12;
        mov rdi, r13;
        mov rsi, rax;
        call gpe_io_write8;

        xor rax, rax;                          // GPE_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_en_bad:
        mov rax, 0xFFFFFFBB;                   // GPE_REG_BAD_INDEX
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_disable(index) -> GPE_OK | GPE_REG_BAD_INDEX
  // ============================================================================

  pub let gpe_disable : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (index: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-002 (#1067): read-modify-write the enable byte, clearing only this GPE's bit. The clear is computed as enable & (enable ^ mask) is avoided in favour of a subtract guarded by a test: if the bit is already clear the write is skipped entirely, and if it is set the new value is enable - mask, which cannot borrow. That keeps the encoder to forms already proven in tree and makes the already-disabled case a no-op rather than a redundant port write -- port writes to a GPE block are not free and an idempotent disable is called on every teardown path. Same GPE_REG_BAD_INDEX gate and same three-push alignment as gpe_enable. Labels prefixed gpe_dis_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        call gpe_resolve;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_dis_bad;
        mov r12, rax;
        and r12, 0xFF;

        mov rdi, r12;
        call gpe_bit_mask;
        mov r12, rax;

        mov rdi, rbx;
        call gpe_enable_port;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_dis_bad;
        mov r13, rax;

        mov rdi, r13;
        call gpe_io_read8;
        mov r11, rax;
        and r11, r12;
        cmp r11, 0;
        je  gpe_dis_done;                      // already clear

        sub rax, r12;
        mov rdi, r13;
        mov rsi, rax;
        call gpe_io_write8;

      gpe_dis_done:
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_dis_bad:
        mov rax, 0xFFFFFFBB;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_clear_status(index) -> GPE_OK | GPE_REG_BAD_INDEX
  // ============================================================================

  pub let gpe_clear_status : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (index: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-002 (#1067): write-1-to-clear this GPE's status bit. The write is the bit mask alone and NOT a read-modify-write: on a write-1-to-clear register, writing back a value read from it clears every bit that happened to be set, including events belonging to seven other subscribers that arrived between the read and the write. Same GPE_REG_BAD_INDEX gate and three-push alignment as gpe_enable. Labels prefixed gpe_cst_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        call gpe_resolve;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_cst_bad;
        mov r12, rax;
        and r12, 0xFF;

        mov rdi, r12;
        call gpe_bit_mask;
        mov r12, rax;

        mov rdi, rbx;
        call gpe_status_port;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_cst_bad;
        mov r13, rax;

        mov rdi, r13;
        mov rsi, r12;
        call gpe_io_write8;

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_cst_bad:
        mov rax, 0xFFFFFFBB;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_ack(index) -> GPE_OK | GPE_REG_BAD_INDEX |
  //                   GPE_ACK_PERM_MASKED | GPE_ACK_NOT_PENDING
  // ============================================================================

  pub let gpe_ack : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (index: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-002 (#1067): the supervisor's report that it has finished handling this GPE, and the only path that unmasks one. Gates in order: gpe_resolve places the index -- GPE_REG_BAD_INDEX; GPE_ROW_F_PERM_MASKED refuses -- GPE_ACK_PERM_MASKED, because the storm gate's retirement must not be undoable by the very handler completion that arrived too late, and reviving a retired GPE is deliberately an explicit unregister/register decision; GPE_ROW_F_PENDING must be set -- GPE_ACK_NOT_PENDING, because an acknowledgement for an event that was never queued would let a confused or hostile supervisor unmask arbitrary platform events. On success: clear the strike count (the storm gate counts CONSECUTIVE unacknowledged assertions, and a completed handler is exactly what should reset it), clear the pending flag, then re-enable. The enable is last, so an event arriving during the acknowledgement finds the row already consistent. Three pushes (rbx, r12, r13) for the odd-count call alignment. Labels prefixed gpe_ack_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        call gpe_resolve;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_ack_bad;

        mov rdi, rbx;
        call gpe_row_flags;
        mov r12, rax;

        mov rax, r12;
        and rax, 2;                            // GPE_ROW_F_PERM_MASKED
        cmp rax, 0;
        jne gpe_ack_retired;

        mov rax, r12;
        and rax, 4;                            // GPE_ROW_F_PENDING
        cmp rax, 0;
        je  gpe_ack_absent;

        mov rdi, rbx;
        call gpe_clear_strikes;
        mov rdi, rbx;
        call gpe_clear_pending;
        mov rdi, rbx;
        call gpe_enable;

        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_ack_bad:
        mov rax, 0xFFFFFFBB;                   // GPE_REG_BAD_INDEX
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_ack_retired:
        mov rax, 0xFFFFFFB6;                   // GPE_ACK_PERM_MASKED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_ack_absent:
        mov rax, 0xFFFFFFB5;                   // GPE_ACK_NOT_PENDING
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
