// src/kernel/core/acpi/evt_stream.pdx — R30.M4-004 (#1069)
//
// The platform-event stream: routing from the ISR's queue to a
// subscriber, and from firmware's own notifications to the same
// subscriber, WITHOUT the subscriber losing the ability to tell those
// two apart.
//
// -----------------------------------------------------------------------------
// Two sources, and why conflating them would be a real bug
// -----------------------------------------------------------------------------
//
// A subscriber to this stream is told about events from two entirely
// different origins:
//
//   ACPI_EVT_SRC_GPE (1)
//     Hardware asserted a General Purpose Event. core/acpi/sci_isr.pdx
//     masked it, cleared its status, struck it and queued a record. The
//     subscriber's obligation is to evaluate the corresponding firmware
//     control method AND THEN ACKNOWLEDGE, because the GPE is masked
//     until it does. Payload: a0 = GPE index, a1 = the enable byte as it
//     read back at enqueue time, a2 = consecutive strike count.
//
//   ACPI_EVT_SRC_NOTIFY (2)
//     Firmware executed Notify(Object, Value) DURING an evaluation. The
//     supervisor's userspace bounded ring (src/user/... , #1059) caught
//     it; this is the kernel-side landing point the supervisor forwards
//     it to so that one stream carries the platform's whole event
//     picture. The subscriber's obligation is to act on the change.
//     THERE IS NOTHING TO ACKNOWLEDGE: no hardware bit is masked and
//     no enable register is waiting. Payload: a0 = target node,
//     a1 = value, a2 = target object type.
//
// The first means "hardware wants attention and is holding its breath
// until you answer". The second means "firmware is telling you something
// changed". A subscriber that could not distinguish them would either
// acknowledge notifications (unmasking GPEs nobody asserted — which
// gpe_ack refuses, so the visible symptom would be a stream of
// GPE_ACK_NOT_PENDING and no clue why) or fail to acknowledge genuine
// GPEs (leaving them masked forever — a device that works exactly once,
// with no error anywhere).
//
// So the source is a FIELD of the record, at offset 0, and it is
// accompanied by a redundant `flags` word carrying
// ACPI_EVT_REC_F_NEEDS_ACK. The redundancy is deliberate: the source
// says where the event came from, the flag says what the subscriber owes
// in return, and a future third source that also needs acknowledgement
// can set the flag without every existing subscriber having to learn a
// new source number.
//
// -----------------------------------------------------------------------------
// Backpressure — the same discipline as the two rings upstream
// -----------------------------------------------------------------------------
//
// This is the THIRD bounded ring in the ACPI path (the ISR-to-kernel
// ring in core/acpi/gpe_table.pdx, the firmware-notification ring in
// userspace, and this one). It deliberately reuses their discipline
// rather than inventing a third:
//
//   DEPTH 32.        The same number as both others, so a reader who has
//                    understood one has understood all three. Thirty-two
//                    is not arbitrary: the mask-before-enqueue rule in
//                    the ISR means each GPE has AT MOST ONE outstanding
//                    event, so the number of records that can be in
//                    flight is bounded by the number of DISTINCT GPEs
//                    currently unacknowledged, and a platform with more
//                    than 32 distinct GPEs simultaneously unacknowledged
//                    is a platform in a storm — which the storm gate
//                    retires at 8 strikes each, on a timescale of
//                    microseconds. Going deeper would not rescue that
//                    machine; it would only delay the loss, enlarge the
//                    set of stale records the subscriber eventually
//                    reads, and move the drop further from the moment
//                    that caused it.
//
//   TAIL-DROP.       A full ring refuses the NEW record and keeps the
//                    old ones. Overwrite-oldest would turn bounded LOSS
//                    into REORDERING, and would erase the first report
//                    of the condition that caused the overrun — the one
//                    record an operator most needs.
//
//   COUNTED.         Two counters, not one, because there are two
//                    distinct reasons a record does not land:
//                      drops    — the ring was full: the subscriber is
//                                 alive but behind.
//                      unrouted — there was nobody to route to: no
//                                 endpoint bound, or the GPE had no
//                                 registered subscriber. A different
//                                 problem with a different fix, and
//                                 summing them into one number would
//                                 make a wedged subscriber and an absent
//                                 one indistinguishable.
//
//   LOCALISABLE.     Every OFFER — accepted, dropped or unrouted alike —
//                    consumes one number from a monotonic `offered`
//                    counter, and accepted records carry that number in
//                    their `seq` field. A subscriber draining records
//                    whose sequences jump from 40 to 43 knows two events
//                    were lost BETWEEN THOSE TWO, not merely that two
//                    were lost somewhere. Counting the refused offers in
//                    the same sequence space is what makes that true;
//                    a sequence that only counted acceptances would be
//                    gapless and therefore useless.
//
//   ACCOUNTING IDENTITY:
//
//       offered == drained + depth + drops + unrouted
//
//   which is the #1059 identity with one extra term for the failure mode
//   that ring does not have. The boot witness asserts it after every
//   phase, which is how a counter that stops being updated is caught.
//
// -----------------------------------------------------------------------------
// The round trip, and the step that is easy to forget
// -----------------------------------------------------------------------------
//
//   assert -> ISR masks, clears, strikes, queues
//          -> acpi_evt_pump routes into this stream
//          -> subscriber drains, evaluates the control method
//          -> subscriber calls acpi_evt_ack
//          -> gpe_ack clears strikes, clears pending, RE-ENABLES
//
// The last step is the whole point. core/acpi/sci_isr.pdx masks a GPE
// before queueing it precisely so it cannot re-fire while its handler is
// outstanding; a GPE that is masked, dispatched, handled and never
// re-enabled is a device that works exactly once, and it produces no
// error anywhere — the handler ran, the method evaluated, nothing
// failed. `acpi_evt_ack` is the only thing in the system that closes
// that loop, and the endpoint's `delivered - acked` difference is the
// observable that says whether it is being closed.
//
// -----------------------------------------------------------------------------
// Readiness, and why the SCI is not unmasked here
// -----------------------------------------------------------------------------
//
// Routing is READY when a KIND_ACPI_EVENT endpoint is bound to this
// stream (`acpi_evt_bind`). Until then every offer is refused and
// counted as unrouted. core/acpi/sci_arm.pdx refuses to unmask the SCI
// while `acpi_evt_ready()` is 0, so in production no interrupt is ever
// delivered into a stream that has nowhere to put it. The ordering is
// enforced in one place and asserted in the witness.
//
// Revocation of the bound endpoint is PUSHED, not polled:
// `acpi_evt_cap_revoke_inner` calls `acpi_evt_unbind_slot`, so a revoked
// endpoint drops readiness in the same operation that frees its row and
// there is no window in which the stream believes it is bound to a
// descriptor that no longer exists.
//
// -----------------------------------------------------------------------------
// Record layout — 32 slots x 64 bytes
// -----------------------------------------------------------------------------
//
//   [+0]  source      1 = GPE, 2 = firmware notification
//   [+8]  subscriber  the opaque identity this record was routed to
//   [+16] a0          GPE index          | notification target node
//   [+24] a1          enable snapshot    | notification value
//   [+32] a2          strike count       | notification object type
//                                        | EC event class (source 3)
//   [+40] seq         the offer number this record IS
//   [+48] flags       ACPI_EVT_REC_F_NEEDS_ACK for a GPE
//   [+56] reserved    zero
//
// Sixty-four bytes rather than the forty-eight the fields need, so the
// slot index is a shift rather than a multiply and each record occupies
// a whole cache line. tools/build.sh asserts that no object other than
// this one relocates against `_acpi_evt_ring` or `_acpi_evt_state`.

module EvtStream = structure {

  // ==========================================================================
  // Geometry
  // ==========================================================================

  pub let ACPI_EVT_SLOTS     : u64 = 32
  pub let ACPI_EVT_SLOT_MASK : u64 = 31
  pub let ACPI_EVT_REC_BYTES : u64 = 64

  // Sources.
  pub let ACPI_EVT_SRC_GPE    : u64 = 1
  pub let ACPI_EVT_SRC_NOTIFY : u64 = 2

  // R31.M1-003 (#1091): the third source — an embedded controller query,
  // routed by core/acpi/ec_route.pdx.
  //
  // acpi_evt_offer's own justification anticipated this: it carries
  // NEEDS_ACK in a `flags` field of its own rather than deriving it from
  // `source`, "so that a future third acknowledging source does not
  // require every subscriber to learn a new source number." This source
  // is the third one, and it is NOT acknowledging — the GPE that woke
  // the machine was already acknowledged by the GPE record that carried
  // it, and acknowledging a query would re-enable a hardware bit twice.
  // So the flags field stays 0 for this source, and the enumeration in
  // gate (3) grows by exactly one value.
  //
  // Payload for this source: a0 = controller address, a1 = query byte,
  // a2 = THE EVENT CLASS (core/acpi/ec_event.pdx) — AC presence, lid,
  // power button, hot-key, or NONE when this kernel has no meaning
  // installed for the byte.
  //
  // R31.M1-005 (#1093) put the class in a2, replacing the subscription
  // row #1091 had there. The row was kernel bookkeeping a subscriber
  // could not act on — no op on any capability takes a row id, and two
  // subscriptions receiving one byte are already told apart by the
  // `subscriber` field — whereas the class is the one thing a subscriber
  // cannot obtain by any other route, because deriving it means reading
  // the controller's firmware bytecode. a2 is source-dependent by design
  // (see the record layout above: "strike count | notification value"),
  // so a third column is the documented pattern and not a repurposing.
  pub let ACPI_EVT_SRC_EC_QUERY : u64 = 3

  // Record flags.
  pub let ACPI_EVT_REC_F_NEEDS_ACK : u64 = 1

  // Record field indices for acpi_evt_peek / acpi_evt_field.
  pub let ACPI_EVT_RF_SOURCE : u64 = 0
  pub let ACPI_EVT_RF_SUB    : u64 = 1
  pub let ACPI_EVT_RF_A0     : u64 = 2
  pub let ACPI_EVT_RF_A1     : u64 = 3
  pub let ACPI_EVT_RF_A2     : u64 = 4
  pub let ACPI_EVT_RF_SEQ    : u64 = 5
  pub let ACPI_EVT_RF_FLAGS  : u64 = 6
  pub let ACPI_EVT_RF_RSVD   : u64 = 7

  // Stream-side failure codes, continuing the 0xFFFFFF9x band opened by
  // core/cap/kind_acpi_event.pdx.
  pub let ACPI_EVT_NOT_READY    : u64 = 0xFFFFFF95
  pub let ACPI_EVT_BIND_BAD_CAP : u64 = 0xFFFFFF94
  pub let ACPI_EVT_BIND_ALREADY : u64 = 0xFFFFFF93
  pub let ACPI_EVT_NOT_BOUND    : u64 = 0xFFFFFF92

  // ==========================================================================
  // Storage
  //
  // _acpi_evt_state:
  //   +0  head      records the subscriber has drained (monotonic)
  //   +8  tail      records accepted                    (monotonic)
  //   +16 drops     offers refused because the ring was full
  //   +24 unrouted  offers refused because there was nobody to route to
  //   +32 offered   every offer, accepted or refused
  //   +40 bound     0 | 1
  //   +48 slot      cap_table slot of the bound KIND_ACPI_EVENT
  //   +56 row       its row_id
  //   +64 armed     1 once core/acpi/sci_arm.pdx has unmasked the SCI
  //
  // head and tail are MONOTONIC counters, not wrapped indices: the
  // difference is the depth directly, and the classic head==tail
  // ambiguity between a full ring and an empty one cannot arise because
  // only the SLOT INDEX derived from them wraps.
  // ==========================================================================

  pub let mut _acpi_evt_ring    : [u64; 256] = uninit @align(64)
  pub let mut _acpi_evt_state   : [u64; 16]  = uninit @align(64)
  pub let mut _acpi_evt_scratch : [u64; 4]   = uninit @align(64)

  // ==========================================================================
  // acpi_evt_stream_reset() -> ()
  // ==========================================================================

  pub let acpi_evt_stream_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): zero every counter, unbind the endpoint and clear the armed flag. Boot and teardown only. The ring's 256 qwords are deliberately NOT cleared: acpi_evt_offer writes all eight words of a slot BEFORE advancing tail, so no drainer can ever observe a slot that is counted but not yet filled, and clearing twice is work for no invariant -- the same reasoning gpe_event_reset and the firmware notification ring use. Zeroing `armed` here matters more than it looks: a reset that left it set would let a later readiness assertion pass against a stale claim that the SCI was already unmasked. Leaf. Labels prefixed acpi_evt_sr_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        xor rax, rax;
        xor rcx, rcx;
      acpi_evt_sr_next:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  acpi_evt_sr_next;
        ret
      }
    }

  // ==========================================================================
  // Accessors
  // ==========================================================================

  pub let acpi_evt_depth : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): tail - head, the number of records the subscriber has not drained. Both counters are boot-monotonic and never masked, so the difference is exact and cannot be confused by a wrap. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 8];
        mov r11, [r10 + 0];
        sub rax, r11;
        ret
      }
    }

  pub let acpi_evt_drained : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): records the subscriber has drained. One of the four terms in offered == drained + depth + drops + unrouted. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let acpi_evt_drops : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): offers refused because the ring was full -- the subscriber is alive but behind. Kept separate from `unrouted` because a wedged subscriber and an absent one need different fixes and a single number would make them indistinguishable. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let acpi_evt_unrouted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): offers refused because there was nobody to route to -- no endpoint bound to the stream, or a GPE with no registered subscriber. THIS IS THE COUNTER THAT MAKES THE NO-SUBSCRIBER CASE LOUD. Dropping an event nobody asked for is defensible; dropping it silently is not, and this counter plus the per-GPE audit record core/acpi/sci_isr.pdx emits on the first unroutable assertion are the two places that fact surfaces. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let acpi_evt_offered : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): every offer this stream has seen, accepted and refused alike. It is the number stamped into each accepted record's seq field, which is what turns a global drop count into a localisable one -- a gap in the drained sequence says WHERE the loss happened, not merely that it happened. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let acpi_evt_ready : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): 1 iff a KIND_ACPI_EVENT endpoint is bound and this stream can deliver. THE GATE core/acpi/sci_arm.pdx CONSULTS BEFORE UNMASKING THE SCI. It is a latched fact rather than a re-validation of the bound descriptor, and that is safe because revocation PUSHES: acpi_evt_cap_revoke_inner calls acpi_evt_unbind_slot, so the flag falls in the same operation that frees the row. A polled re-validation here would additionally have to hold the {cap} capability, which would force every caller up the arming path to hold it too. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let acpi_evt_bound_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): cap_table slot of the bound endpoint, 0 when unbound. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let acpi_evt_bound_row : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): row_id of the bound endpoint, 0 when unbound. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  pub let acpi_evt_armed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): 1 iff core/acpi/sci_arm.pdx has unmasked the SCI redirection entry. Read by the boot witness to assert the unmask ORDERING -- that this is 0 for as long as acpi_evt_ready() is 0. Leaf.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 64];
        ret
      }
    }

  pub let acpi_evt_mark_armed : (u64) -> () !{mem} @{} =
    fn (armed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): record whether the SCI is unmasked. Normalised to 0 or 1 rather than stored raw, so the flag cannot acquire a third value that a later `cmp 1` reads as disarmed and a `cmp 0` reads as armed. Written only by core/acpi/sci_arm.pdx, which is the only module that programs the redirection entry's mask bit. Leaf. Labels prefixed acpi_evt_ma_ per reserved-label discipline.",
      block: {
        xor rax, rax;
        cmp rdi, 0;
        je  acpi_evt_ma_store;
        mov rax, 1;
      acpi_evt_ma_store:
        lea r10, [rip + _acpi_evt_state];
        mov [r10 + 64], rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_bind(cap_slot) -> ACPI_EVT_OK | ACPI_EVT_BIND_*
  // ==========================================================================

  pub let acpi_evt_bind : (u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M4-004 (#1069): bind a KIND_ACPI_EVENT endpoint to the stream, which is what makes routing READY and therefore what the SCI unmask waits on. Gates, in order: (1) not already bound -> ACPI_EVT_BIND_ALREADY. Rebinding is refused rather than replacing, because a silent replacement means the previous subscriber stops receiving events it believes it is still subscribed to -- the same reasoning gpe_register uses for its duplicate gate. (2) cap_slot < 256, checked BEFORE any descriptor arithmetic. (3) kind == 0x151 (KIND_ACPI_EVENT). (4) rights carry RIGHT_INVOKE (0x008), which is the right that entitles a holder to drain and acknowledge; an OBSERVE-only endpoint may introspect itself but must not become the stream's consumer, because binding it would make readiness true for a holder that cannot close a GPE round trip. (5) the row named by target_ptr[15:0] must be LIVE -- a descriptor whose row was freed underneath it would bind the stream to an endpoint whose subscriber identity has been scrubbed, and every subsequent delivery would be counted against a dead row. Gates 2..5 all report ACPI_EVT_BIND_BAD_CAP: they are one question ('is this a usable endpoint?') asked in five parts, and splitting them into five codes would name implementation steps rather than caller-visible mistakes. Three pushes (rbx, r12, r13) carry the slot and row across the nested call; entry rsp%16 == 8 and three pushes return it to 0. Labels prefixed acpi_evt_bd_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 40];
        cmp rax, 0;
        jne acpi_evt_bd_already;

        cmp rbx, 256;
        jae acpi_evt_bd_bad;

        lea rax, [rip + cap_table];
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x151;                  // KIND_ACPI_EVENT
        cmp r10, r11;
        jne acpi_evt_bd_bad;

        mov r10, [rax + 8];
        mov r11, 0x008;                  // RIGHT_INVOKE
        and r10, r11;
        cmp r10, 0;
        je  acpi_evt_bd_bad;

        mov r12, [rax + 16];
        mov r11, 0xFFFF;
        and r12, r11;                    // row_id

        mov rdi, r12;
        call acpi_evt_tail_valid;
        cmp rax, 0;
        je  acpi_evt_bd_bad;

        lea r10, [rip + _acpi_evt_state];
        mov rax, 1;
        mov [r10 + 40], rax;
        mov [r10 + 48], rbx;
        mov [r10 + 56], r12;

        xor rax, rax;                    // ACPI_EVT_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_bd_already:
        mov rax, 0xFFFFFF93;             // ACPI_EVT_BIND_ALREADY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_bd_bad:
        mov rax, 0xFFFFFF94;             // ACPI_EVT_BIND_BAD_CAP
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_unbind() -> ACPI_EVT_OK | ACPI_EVT_NOT_BOUND
  // ==========================================================================

  pub let acpi_evt_unbind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): drop the binding. Counters are deliberately left intact -- an unbind is not a reset, and discarding the drop and unrouted totals at teardown would erase the evidence of what went wrong just as somebody starts looking for it. Refuses ACPI_EVT_NOT_BOUND when nothing was bound, a distinct code from success so an idempotent caller can tell 'never was' from 'done'. Note that this does NOT re-mask the SCI: disarming is core/acpi/sci_arm.pdx's operation because it programs the IOAPIC, and a function that quietly reprogrammed an interrupt controller as a side effect of a bookkeeping change is exactly the kind of hidden hardware write this tree keeps behind one seam. What it does guarantee is that every subsequent offer is refused and COUNTED, so an unbind while armed degrades loudly rather than silently. Leaf. Labels prefixed acpi_evt_ub_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 40];
        cmp rax, 0;
        je  acpi_evt_ub_none;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        ret;
      acpi_evt_ub_none:
        mov rax, 0xFFFFFF92;             // ACPI_EVT_NOT_BOUND
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_unbind_slot(slot) -> ()
  //
  // Called by the KIND_ACPI_EVENT revoke path.
  // ==========================================================================

  pub let acpi_evt_unbind_slot : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): drop the binding IF AND ONLY IF it names this cap_table slot. Called from acpi_evt_cap_revoke_inner, which is what makes revocation pushed rather than polled: readiness falls in the same operation that frees the endpoint's row, so there is no window in which the stream believes it is bound to a descriptor that no longer exists, and no need for the readiness check to re-validate a descriptor (which would force the {cap} capability up the whole arming path). The slot comparison is why this is not simply acpi_evt_unbind: revoking endpoint A must not silently unbind endpoint B. Silent no-op when unbound or when the slot does not match -- a revoke of an unbound endpoint is a normal, correct thing to do. Leaf. Labels prefixed acpi_evt_us_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 40];
        cmp rax, 0;
        je  acpi_evt_us_out;
        mov rax, [r10 + 48];
        cmp rax, rdi;
        jne acpi_evt_us_out;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      acpi_evt_us_out:
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_offer(source, subscriber, a0, a1, a2) -> 1 | 0
  //
  // The single enqueue. Every record in this stream, whatever its
  // origin, comes through here.
  //
  // SysV: rdi=source, rsi=subscriber, rdx=a0, rcx=a1, r8=a2.
  // ==========================================================================

  pub let acpi_evt_offer : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (source: u64, subscriber: u64, a0: u64, a1: u64, a2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): offer one record to the stream. RETURNS 1 WHEN ACCEPTED AND 0 WHEN REFUSED, AND NEVER BLOCKS -- there is no state in which this function waits, which is what lets the routing path be driven from anywhere without inheriting a scheduling dependency. The offer sequence is consumed FIRST, before any gate, so that a refused offer still burns a number and the gap it leaves in the accepted sequence localises the loss; a sequence that only counted acceptances would be gapless and therefore useless for exactly the case it exists to diagnose. Gates then, in order: (1) an endpoint must be bound, else unrouted += 1 -- an offer with nowhere to go. (2) subscriber != 0, else unrouted += 1: zero is gpe_lookup's 'nothing registered' sentinel, so this is the no-subscriber case arriving from the pump, and it is COUNTED rather than ignored. (3) source must be 1 (GPE), 2 (firmware notification) or 3 (embedded-controller query, added by R31.M1-003 / #1091), else unrouted += 1 -- an unknown source would land a record whose payload fields mean nothing, and a subscriber cannot defend itself against a discriminator it does not recognise. The enumeration grew by ONE VALUE and by nothing else: source 3 takes the same four gates in the same order, and it is not an acknowledging source, so the flags word below is left at 0 for it exactly as it is for source 2. (4) tail - head < 32, else drops += 1: TAIL-DROP, refusing the new record and keeping the old ones, because overwrite-oldest turns bounded loss into reordering and erases the first report of the condition that caused the overrun. On acceptance all eight words are written BEFORE tail advances, so a drainer can never observe a slot that is counted but not yet filled; there is one execution context today, but the publish-last discipline is what makes this ring correct when there is not, and retrofitting it later means auditing every store. flags carries ACPI_EVT_REC_F_NEEDS_ACK for a GPE and 0 otherwise -- redundant with `source` on purpose, so that what the subscriber OWES is a field of its own and a future third acknowledging source does not require every subscriber to learn a new source number. Slot = tail & 31, offset = slot << 6. Leaf, no nested calls, caller-save scratch only. Labels prefixed acpi_evt_of_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];

        // ---- consume one offer number, whatever happens next ----
        mov rax, [r10 + 32];
        mov r9, rax;                     // seq = the number this offer IS
        add rax, 1;
        mov [r10 + 32], rax;

        // ---- (1) bound? ----
        mov rax, [r10 + 40];
        cmp rax, 0;
        je  acpi_evt_of_unrouted;

        // ---- (2) a subscriber to route to? ----
        cmp rsi, 0;
        je  acpi_evt_of_unrouted;

        // ---- (3) a source the subscriber can discriminate? ----
        cmp rdi, 1;
        je  acpi_evt_of_src_ok;
        cmp rdi, 2;
        je  acpi_evt_of_src_ok;
        cmp rdi, 3;                      // ACPI_EVT_SRC_EC_QUERY
        jne acpi_evt_of_unrouted;

      acpi_evt_of_src_ok:
        // ---- (4) room? ----
        mov rax, [r10 + 8];
        mov r11, [r10 + 0];
        sub rax, r11;
        cmp rax, 32;                     // ACPI_EVT_SLOTS
        jae acpi_evt_of_full;

        mov rax, [r10 + 8];              // tail
        mov r11, rax;
        and r11, 31;                     // ACPI_EVT_SLOT_MASK
        shl r11, 6;                      // * ACPI_EVT_REC_BYTES
        lea rax, [rip + _acpi_evt_ring];
        add rax, r11;

        mov [rax + 0],  rdi;             // source
        mov [rax + 8],  rsi;             // subscriber
        mov [rax + 16], rdx;             // a0
        mov [rax + 24], rcx;             // a1
        mov [rax + 32], r8;              // a2
        mov [rax + 40], r9;              // seq

        mov r11, 0;
        cmp rdi, 1;                      // ACPI_EVT_SRC_GPE
        jne acpi_evt_of_flags;
        mov r11, 1;                      // ACPI_EVT_REC_F_NEEDS_ACK
      acpi_evt_of_flags:
        mov [rax + 48], r11;
        xor r11, r11;
        mov [rax + 56], r11;

        // ---- publish ----
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 1;
        ret;

      acpi_evt_of_full:
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        xor rax, rax;
        ret;

      acpi_evt_of_unrouted:
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_peek(field) -> value
  // ==========================================================================

  pub let acpi_evt_peek : (u64) -> u64 !{mem} @{} =
    fn (field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): field rdi of the OLDEST pending record. Returns 0 on an empty stream or an out-of-range field WITHOUT latching an error: draining is a poll, and a subscriber that polls an empty stream has done nothing wrong. That is the one place in this module where a zero is not a refusal, and it is safe because a caller establishes non-emptiness with acpi_evt_depth first -- which the witness asserts it must. A peek/pop pair rather than a copy-out through a caller pointer, because handing a raw destination address across this boundary is exactly the aliasing the confinement assertion on _acpi_evt_ring exists to prevent. Slot = head & 31, offset = slot << 6 plus field << 3. Leaf, pure read. Labels prefixed acpi_evt_pk_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_pk_zero;
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 0];              // head
        mov r11, [r10 + 8];              // tail
        cmp rax, r11;
        jae acpi_evt_pk_zero;

        and rax, 31;
        shl rax, 6;
        mov r11, rdi;
        shl r11, 3;
        add rax, r11;
        lea r11, [rip + _acpi_evt_ring];
        add rax, r11;
        mov rax, [rax + 0];
        ret;

      acpi_evt_pk_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_pop() -> 1 | 0
  // ==========================================================================

  pub let acpi_evt_pop : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): retire the oldest pending record. Returns 1 when one was retired, 0 when the stream was already empty. The slot's contents are left in place rather than cleared, because acpi_evt_offer overwrites all eight words before publishing and clearing twice is work for no invariant. Advancing head is what makes the slot reusable, so a subscriber that peeks every field it needs BEFORE popping is reading a stable record; one that pops first and peeks after is reading whatever arrives next, which is why the pair is ordered this way round and documented as such. Leaf. Labels prefixed acpi_evt_pp_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov rax, [r10 + 0];
        mov r11, [r10 + 8];
        cmp rax, r11;
        jae acpi_evt_pp_none;
        add rax, 1;
        mov [r10 + 0], rax;
        mov rax, 1;
        ret;
      acpi_evt_pp_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_field(back, field) -> value
  //
  // Non-consuming read of a retained record, addressed by distance back
  // from the tail. Same shape as gpe_event_field and drv_audit_field.
  // ==========================================================================

  pub let acpi_evt_field : (u64, u64) -> u64 !{mem} @{} =
    fn (back: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): non-consuming read of a retained record, addressed by distance back from the tail -- the same shape gpe_event_field and drv_audit_field use, so a reader who knows one knows all three. Guards: field < 8, back < 32 (the ring never retains more), and back < tail so an unwritten slot is never read. idx = (tail - 1 - back) & 31, offset = idx << 6 plus field << 3. This is how the witness inspects records it has NOT drained, which is what lets it assert that a saturating burst left the OLD records in place rather than the new ones -- the property that distinguishes tail-drop from overwrite-oldest, and which a consuming reader cannot check without destroying it. Leaf, pure read. Labels prefixed acpi_evt_fl_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_evt_state];
        mov r10, [r10 + 8];              // tail
        cmp r10, 0;
        je  acpi_evt_fl_zero;
        cmp rsi, 8;
        jae acpi_evt_fl_zero;
        cmp rdi, 32;
        jae acpi_evt_fl_zero;
        cmp rdi, r10;
        jae acpi_evt_fl_zero;

        sub r10, 1;
        sub r10, rdi;
        and r10, 31;
        shl r10, 6;
        mov rax, rsi;
        shl rax, 3;
        add r10, rax;
        lea r11, [rip + _acpi_evt_ring];
        add r11, r10;
        mov rax, [r11 + 0];
        ret;

      acpi_evt_fl_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_pump() -> number of records routed
  //
  // Drains the ISR's queue and routes each record into this stream.
  // TASK CONTEXT ONLY — it is deliberately not on the ISR's build-
  // asserted call allowlist, and adding it there would defeat the point.
  // ==========================================================================

  pub let acpi_evt_pump : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): move every queued GPE record from the ISR's ring (core/acpi/gpe_table.pdx) into the subscriber stream, stamping each with ACPI_EVT_SRC_GPE and the subscriber identity gpe_lookup reports for that GPE index. THIS RUNS IN TASK CONTEXT, NOT IN THE ISR. That is the whole shape of the design: the ISR's build-asserted allowlist in tools/build.sh admits only bounded non-blocking leaves, and routing -- which consults the dispatch table, the stream state and the endpoint table -- is not something that belongs inside an interrupt even though every individual step of it would be bounded. Keeping the pump out of the allowlist is what keeps that boundary a build failure rather than a convention. Bounded twice over: the ring holds at most 32 records, and an explicit iteration cap of 32 makes the bound local rather than inherited, so a future change to the ring's depth cannot silently make this loop unbounded. gpe_lookup returning 0 (no subscriber) is NOT filtered here -- the offer is made and refused as unrouted, so the no-subscriber case is counted in one place rather than being invisible because the pump quietly skipped it. On acceptance the bound endpoint's delivered counter is incremented, which is the numerator of the delivered-minus-acked difference that detects a round trip that never closes. Three pushes (rbx, r12, r13): rbx = accepted count, r12 = iteration cap, r13 = scratch base recomputed after each call because it is caller-save. Entry rsp%16 == 8 and three pushes return it to 0 at every call site. Labels prefixed acpi_evt_pm_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        xor rbx, rbx;                    // accepted
        xor r12, r12;                    // iterations

      acpi_evt_pm_next:
        cmp r12, 32;
        jae acpi_evt_pm_done;

        lea rdi, [rip + _acpi_evt_scratch];
        call gpe_event_dequeue;
        cmp rax, 0;
        je  acpi_evt_pm_done;

        add r12, 1;

        lea r13, [rip + _acpi_evt_scratch];
        mov rdi, [r13 + 0];              // gpe index
        call gpe_lookup;
        mov rsi, rax;                    // subscriber identity (0 = none)

        lea r13, [rip + _acpi_evt_scratch];
        mov rdi, 1;                      // ACPI_EVT_SRC_GPE
        mov rdx, [r13 + 0];              // a0 = gpe index
        mov rcx, [r13 + 8];              // a1 = enable snapshot
        mov r8,  [r13 + 16];             // a2 = strikes
        call acpi_evt_offer;
        cmp rax, 0;
        je  acpi_evt_pm_next;

        add rbx, 1;

        lea r13, [rip + _acpi_evt_state];
        mov rdi, [r13 + 56];             // bound row
        call acpi_evt_note_delivered;
        jmp acpi_evt_pm_next;

      acpi_evt_pm_done:
        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_notify(node, value, objtype) -> 1 | 0
  //
  // The kernel-side landing point for a firmware Notify() that the
  // supervisor caught in its own userspace ring.
  // ==========================================================================

  pub let acpi_evt_notify : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (node: u64, value: u64, objtype: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-004 (#1069): offer one firmware notification to the stream, stamped ACPI_EVT_SRC_NOTIFY and with no NEEDS_ACK flag -- there is no masked hardware bit behind it and nothing to re-enable. The subscriber identity is the BOUND ENDPOINT'S, not a per-GPE one, because a notification is not tied to a GPE: firmware raised it against an object during an evaluation, and the principal entitled to hear about it is whoever holds the stream. A dead or unbound row makes acpi_evt_row_subscriber return ACPI_EVT_DECODE_BAD, which is normalised to 0 here so that acpi_evt_offer refuses it through the ordinary unrouted gate rather than storing an all-ones identity that a subscriber would have to know to distrust. Returns the offer's verdict unchanged, so a caller draining its userspace ring can stop advancing when the kernel stream is full and retry, rather than discarding a notification twice. Three pushes (rbx, r12, r13) hold the three payload words across the two nested calls; rbx is reused for the offer verdict once the node value has been consumed. Labels prefixed acpi_evt_nt_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // node
        mov r12, rsi;                    // value
        mov r13, rdx;                    // objtype

        lea rax, [rip + _acpi_evt_state];
        mov rdi, [rax + 56];             // bound row
        call acpi_evt_row_subscriber;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne acpi_evt_nt_have;
        xor rax, rax;
      acpi_evt_nt_have:
        mov rsi, rax;                    // subscriber identity

        mov rdi, 2;                      // ACPI_EVT_SRC_NOTIFY
        mov rdx, rbx;                    // a0 = target node
        mov rcx, r12;                    // a1 = value
        mov r8,  r13;                    // a2 = target object type
        call acpi_evt_offer;
        mov rbx, rax;
        cmp rbx, 0;
        je  acpi_evt_nt_out;

        lea rax, [rip + _acpi_evt_state];
        mov rdi, [rax + 56];
        call acpi_evt_note_delivered;

      acpi_evt_nt_out:
        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_ack(gpe_index) -> GPE_OK | ACPI_EVT_NOT_READY | GPE_ACK_*
  //
  // THE STEP THAT CLOSES THE ROUND TRIP.
  // ==========================================================================

  pub let acpi_evt_ack : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (gpe_index: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-004 (#1069): the subscriber's report that it has finished handling a GPE-sourced event, and the only path in this module that reaches hardware. Refuses ACPI_EVT_NOT_READY when no endpoint is bound: an acknowledgement from a principal that is not the stream's consumer would let anything able to call this unmask arbitrary platform events, and unmasking is a WRITE to the GPE enable register. Otherwise it delegates verbatim to gpe_ack (core/acpi/gpe_ack.pdx), whose own gates -- index resolvable, not storm-retired, actually pending -- are the substantive ones and whose code is returned UNCHANGED rather than collapsed into a boolean, because GPE_ACK_NOT_PENDING is exactly what a subscriber gets if it acknowledges a NOTIFY-sourced record by mistake and that diagnosis must survive the layer. Only on GPE_OK is the endpoint's acked counter incremented, so the counter means 'the GPE was re-enabled' rather than 'an acknowledgement was attempted'; delivered minus acked is then the number of platform events this endpoint was told about and never finished, which is the only observable that catches a device that works exactly once. Three pushes (rbx, r12, r13) carry the index and the verdict across the three nested calls. Labels prefixed acpi_evt_ak_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // gpe index

        call acpi_evt_ready;
        cmp rax, 0;
        je  acpi_evt_ak_not_ready;

        mov rdi, rbx;
        call gpe_ack;
        mov r12, rax;
        cmp r12, 0;
        jne acpi_evt_ak_out;

        lea rax, [rip + _acpi_evt_state];
        mov rdi, [rax + 56];             // bound row
        call acpi_evt_note_acked;
        xor r12, r12;

      acpi_evt_ak_out:
        mov rax, r12;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_ak_not_ready:
        mov rax, 0xFFFFFF95;             // ACPI_EVT_NOT_READY
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
