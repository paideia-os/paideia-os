// src/kernel/core/acpi/sci_route.pdx — R30.M4-001 (#1066)
//
// SCI interrupt routing: firmware's SCI_INT to a programmed IOAPIC
// redirection entry, and the KIND_HW_INTERRUPT that authorises it.
//
// -----------------------------------------------------------------------------
// The SCI is level-triggered, active-low and shareable
// -----------------------------------------------------------------------------
//
// ACPI 6.5 §5.2.9 and §4.1 are explicit: "the SCI interrupt ... is
// defined to be a sharable, level, active low interrupt". That is not
// a platform default that firmware may quietly change by omission — it
// is the specified behaviour, and it is what the ISR's clear-before-EOI
// discipline in core/acpi/sci_isr.pdx depends on for correctness.
//
// But it IS something firmware may change by DECLARATION. When SCI_INT
// is below 16 it names an ISA IRQ, and the MADT's Interrupt Source
// Override entries are how firmware republishes an ISA IRQ's global
// system interrupt number, polarity and trigger mode. On essentially
// every shipping x86 platform there is an ISO for the SCI (typically
// source 9 -> GSI 9, level, low) and its presence is the reason the
// numbers must be READ rather than assumed.
//
// So the rule this module implements is:
//
//   * Start from the ACPI-specified SCI defaults: gsi = SCI_INT,
//     polarity = active low, trigger = level.
//   * If a MADT ISO names this source, take its GSI unconditionally.
//   * For polarity and trigger, honour only an EXPLICIT declaration:
//     MPS INTI 01 (active high / edge) and 11 (active low / level) are
//     explicit; 00 is "bus conformant" and 10 is reserved. For an ISA
//     bus, "bus conformant" means active-high edge — which for the SCI
//     would be wrong, and is exactly the case where firmware is saying
//     "no opinion" rather than "edge". A no-opinion answer must leave
//     the ACPI-specified SCI default standing, not overwrite it.
//
// Nothing here is hardcoded: SCI_INT comes from the FADT, the GSI and
// both electrical properties come from the MADT when firmware declares
// them, and the ACPI-specified default is used only where firmware has
// said nothing.
//
// -----------------------------------------------------------------------------
// Packed route
// -----------------------------------------------------------------------------
//
//   bits [31:0]  gsi
//   bit  32      polarity  (1 = active low)
//   bit  33      trigger   (1 = level)
//
// -----------------------------------------------------------------------------
// Why the line is programmed MASKED at R30.M4
// -----------------------------------------------------------------------------
//
// The ISR is installed and the redirection entry is programmed, but
// with the RTE mask bit set. Unmasking is R30.M4-004 (#1069)'s to do,
// because until a userspace subscriber exists there is nothing for a
// queued event to be routed to, and a GPE that fires with no subscriber
// is retired by the storm gate after eight assertions. Delivering
// interrupts to a handler whose only possible outcome is to retire the
// event is not "working"; it is burning the platform's GPEs during
// boot. The mask bit is therefore part of this milestone's contract and
// the boot witness asserts it.

module SciRoute = structure {

  // ============================================================================
  // MPS INTI encodings (ACPI 6.5 §5.2.12.5 Table 5-25)
  // ============================================================================

  pub let MPS_CONFORM  : u64 = 0   // bus conformant — firmware has no opinion
  pub let MPS_EXPLICIT_A : u64 = 1 // active high (polarity) / edge  (trigger)
  pub let MPS_RESERVED : u64 = 2
  pub let MPS_EXPLICIT_B : u64 = 3 // active low  (polarity) / level (trigger)

  // ACPI-specified SCI electrical properties.
  pub let SCI_POLARITY_LOW : u64 = 1
  pub let SCI_TRIGGER_LEVEL : u64 = 1

  // ISO record geometry, as populated by acpi/madt.pdx §madt_parse_isos.
  pub let SCI_ISO_REC_BYTES : u64 = 16

  pub let SCI_ROUTE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // RTE flag bit positions consumed by ioapic_program_redir.
  pub let SCI_RTE_POLARITY_BIT : u64 = 0x100
  pub let SCI_RTE_TRIGGER_BIT  : u64 = 0x200
  pub let SCI_RTE_MASK_BIT     : u64 = 0x400

  // ============================================================================
  // sci_route_resolve(sci_int, iso_base, iso_count) -> packed
  //
  // Pure: takes the override table as arguments rather than reading
  // the MADT globals, so a fixture can drive every branch against a
  // fabricated ISO stream without perturbing the platform's own.
  // ============================================================================

  pub let sci_route_resolve : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sci_int: u64, iso_base: u64, iso_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): resolve SCI_INT to (gsi, polarity, trigger) against a MADT Interrupt Source Override stream. Seeds from the ACPI-specified SCI properties -- gsi = sci_int, polarity = active low, trigger = level (ACPI 6.5 §4.1: the SCI is a sharable, level, active-low interrupt) -- and then applies any override firmware declares. Scan: 16-byte ISO records, u32 source_irq @+0, u32 gsi @+4, u32 mps_inti_flags @+8, first match wins because ACPI 6.5 §5.2.12.5 makes a source unique within the stream. On a match the GSI is taken unconditionally, because a remapped GSI is the whole reason overrides exist. Polarity and trigger are taken only from an EXPLICIT MPS encoding: 01 and 11 are declarations, 00 is 'bus conformant' and 10 is reserved. Bus-conformant on an ISA bus means active-high edge, which for the SCI is wrong; firmware writing 00 is declining to state a preference, and a declined preference must leave the ACPI-specified default standing rather than silently reconfigure the line as edge-triggered -- an edge-configured SCI loses every assertion that arrives while the line is already high, which is precisely the shared-level case the SCI exists to handle. A null iso_base or a zero count skips the scan entirely and returns the defaults. Packing: gsi in [31:0], polarity in bit 32, trigger in bit 33. Leaf, no nested calls, caller-save scratch only (rax/rcx/r8/r9/r10/r11). Labels prefixed sci_res_ per reserved-label discipline.",
      block: {
        // Defaults: gsi = sci_int (low 32 bits), polarity low, trigger level.
        mov rax, 0xFFFFFFFF;
        mov r8, rdi;
        and r8, rax;                           // gsi
        mov r10, 1;                            // polarity = active low
        mov r11, 1;                            // trigger  = level

        cmp rsi, 0;
        je  sci_res_pack;
        cmp rdx, 0;
        je  sci_res_pack;

        xor rcx, rcx;                          // cursor
      sci_res_next:
        cmp rcx, rdx;
        jae sci_res_pack;

        mov r9, rcx;
        shl r9, 4;                             // * SCI_ISO_REC_BYTES
        add r9, rsi;                           // &record

        mov eax, [r9 + 0];                     // source_irq (u32, zero-extended)
        cmp rax, rdi;
        jne sci_res_bump;

        // MATCH. The GSI is taken unconditionally.
        mov eax, [r9 + 4];
        mov r8, rax;

        // mps_inti_flags into r9 (the record address is no longer needed).
        mov eax, [r9 + 8];
        mov r9, rax;

        // Polarity: bits [1:0]. Only 01 and 11 are declarations.
        mov rax, r9;
        and rax, 3;
        cmp rax, 1;
        jne sci_res_pol_b;
        xor r10, r10;                          // explicit active high
        jmp sci_res_trig;
      sci_res_pol_b:
        cmp rax, 3;
        jne sci_res_trig;
        mov r10, 1;                            // explicit active low

      sci_res_trig:
        // Trigger: bits [3:2]. Only 01 and 11 are declarations.
        mov rax, r9;
        shr rax, 2;
        and rax, 3;
        cmp rax, 1;
        jne sci_res_trig_b;
        xor r11, r11;                          // explicit edge
        jmp sci_res_pack;
      sci_res_trig_b:
        cmp rax, 3;
        jne sci_res_pack;
        mov r11, 1;                            // explicit level
        jmp sci_res_pack;

      sci_res_bump:
        add rcx, 1;
        jmp sci_res_next;

      sci_res_pack:
        mov rax, 0xFFFFFFFF;
        and r8, rax;
        shl r10, 32;
        shl r11, 33;
        mov rax, r8;
        or  rax, r10;
        or  rax, r11;
        ret
      }
    }

  pub let sci_route_gsi : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-001 (#1066): bits [31:0] of a packed route. Pure leaf.",
      block: {
        mov rax, 0xFFFFFFFF;
        and rax, rdi;
        ret
      }
    }

  pub let sci_route_polarity : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-001 (#1066): bit 32 of a packed route -- 1 means active low. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 1;
        ret
      }
    }

  pub let sci_route_trigger : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-001 (#1066): bit 33 of a packed route -- 1 means level. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 33;
        and rax, 1;
        ret
      }
    }

  // ============================================================================
  // sci_route_resolve_from_madt(sci_int) -> packed
  //
  // The production entry: the same pure resolver, applied to the ISO
  // stream R20.M2's madt_parse_isos left in core/smp/madt_topology.pdx.
  // ============================================================================

  pub let sci_route_resolve_from_madt : (u64) -> u64 !{mem} @{} =
    fn (sci_int: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): bind sci_route_resolve to the platform's own override stream. An empty stream (BIOS boot with no MADT, or bring-up before topology_seed_from_madt has run) is not an error -- the resolver's ACPI-specified defaults are exactly what an undeclared SCI should get. One push (rbx, unused) brings rsp%16 to 0 at the nested call. Labels prefixed sci_rfm_ per reserved-label discipline.",
      block: {
        push rbx;
        lea rsi, [rip + _madt_scratch_isos];
        lea rax, [rip + _madt_n_isos];
        mov rdx, [rax + 0];
        call sci_route_resolve;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sci_rte_flags(packed, masked) -> flags word for ioapic_program_redir
  // ============================================================================

  pub let sci_rte_flags : (u64, u64) -> u64 !{} @{} =
    fn (packed: u64, masked: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-001 (#1066): translate a packed route into the flags word ioapic_program_redir consumes -- polarity into bit 8, trigger into bit 9, mask into bit 10. Delivery mode (bits 7:0) and destination mode (bit 11) are left zero: fixed delivery to a physical APIC ID, which is what an SCI wants; it is a platform event, not something to broadcast. Pure leaf. Labels prefixed sci_rtef_ per reserved-label discipline.",
      block: {
        xor rax, rax;
        mov r10, rdi;
        shr r10, 32;
        and r10, 1;
        shl r10, 8;
        or  rax, r10;                          // polarity -> bit 8
        mov r10, rdi;
        shr r10, 33;
        and r10, 1;
        shl r10, 9;
        or  rax, r10;                          // trigger -> bit 9
        mov r10, rsi;
        and r10, 1;
        shl r10, 10;
        or  rax, r10;                          // mask -> bit 10
        ret
      }
    }

  // ============================================================================
  // sci_route_program(ioapic_base, packed, vector, dest, masked) -> 1 | 0
  // ============================================================================

  pub let sci_route_program : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (ioapic_base: u64, packed: u64, vector: u64, dest: u64, masked: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): program the IOAPIC redirection entry for the SCI. Refuses a GSI of 0 outright, returning 0 without touching the IOAPIC: on every conforming platform GSI 0 is the 8254 timer, and a firmware table that yielded SCI_INT == 0 is a table we failed to read rather than a platform whose SCI shares the timer line -- reprogramming GSI 0 on that mistaken belief takes the system clock down. A null base is refused for the same reason. Otherwise the flags word is composed by sci_rte_flags and handed to ioapic_program_redir, whose own bounds check rejects a GSI past the IOAPIC maximum redirection entry; its verdict is returned unchanged. Five pushes (rbx, r12, r13, r14, r15) hold base, packed route, vector, destination and the mask request across both nested calls -- every argument has to survive sci_rte_flags, which clobbers the whole caller-save set. Entry rsp%16 == 8 and five pushes return it to 0 at each call site. Labels prefixed sci_prog_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // ioapic base
        mov r12, rsi;                          // packed route
        mov r13, rdx;                          // vector
        mov r14, rcx;                          // destination APIC id
        mov r15, r8;                           // masked

        cmp rbx, 0;
        je  sci_prog_refuse;

        mov rax, 0xFFFFFFFF;
        and rax, r12;                          // gsi
        cmp rax, 0;
        je  sci_prog_refuse;

        mov rdi, r12;
        mov rsi, r15;
        call sci_rte_flags;
        mov r15, rax;                          // flags

        mov rdi, rbx;
        mov rsi, 0xFFFFFFFF;
        and rsi, r12;                          // gsi
        mov rdx, r13;
        mov rcx, r14;
        mov r8,  r15;
        call ioapic_program_redir;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sci_prog_refuse:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sci_route_install(sci_int, vector, dest, masked) -> 1 | 0
  //
  // The production entry: resolve against the platform's own MADT,
  // discover the IOAPIC that owns the resulting GSI, and program it.
  // ============================================================================

  pub let sci_route_install : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (sci_int: u64, vector: u64, dest: u64, masked: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): resolve the SCI against the platform MADT, find the IOAPIC that owns the resulting GSI via ioapic_base_for_gsi -- the same discovery ioapic_route_irq_via_madt uses, extracted in this issue precisely so the two cannot diverge -- and program the redirection entry through sci_route_program. `masked` is passed through rather than forced, so this one function serves both the R30.M4 install (masked, because no subscriber exists yet and a delivered event could only be retired by the storm gate) and the R30.M4-004 unmask, without a second routing path that could resolve polarity differently. Five pushes (rbx, r12, r13, r14, r15) carry all four arguments plus the packed route across the three nested calls; entry rsp%16 == 8 and five pushes return it to 0 at every call site. Labels prefixed sci_inst_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // sci_int
        mov r12, rsi;                          // vector
        mov r13, rdx;                          // destination APIC id
        mov r14, rcx;                          // masked

        mov rdi, rbx;
        call sci_route_resolve_from_madt;
        mov r15, rax;                          // packed route

        mov rdi, 0xFFFFFFFF;
        and rdi, r15;                          // gsi
        call ioapic_base_for_gsi;

        mov rdi, rax;                          // ioapic base
        mov rsi, r15;                          // packed route
        mov rdx, r12;                          // vector
        mov rcx, r13;                          // destination
        mov r8,  r14;                          // masked
        call sci_route_program;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
