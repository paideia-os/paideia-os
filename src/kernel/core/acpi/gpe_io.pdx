// src/kernel/core/acpi/gpe_io.pdx — R30.M4-001 (#1066) / R30.M4-002 (#1067)
//
// The register-access seam for the GPE path.
//
// -----------------------------------------------------------------------------
// Why this module exists separately from the dispatch logic
// -----------------------------------------------------------------------------
//
// The interesting claims in this milestone are ORDERING claims: that
// the status bit is cleared before the interrupt is acknowledged, and
// that the enable bit is cleared before the event is queued. An
// ordering claim cannot be checked by looking at the final state of
// anything — both orderings reach the same final state. It can only be
// checked by observing the sequence of accesses.
//
// So every GPE register access in the kernel goes through exactly two
// functions here, and those two functions have a mode:
//
//   GPE_IO_MODE_PORT  (0, the production default) — real `in`/`out`
//                     against the firmware-named I/O port, and a real
//                     LAPIC EOI.
//   GPE_IO_MODE_SYNTH (1) — the same accesses against a 512-byte RAM
//                     window, each one appended to an ordered trace,
//                     and the EOI recorded as a trace entry rather
//                     than written to the LAPIC.
//
// The dispatch logic in core/acpi/sci_isr.pdx is byte-identical in both
// modes: it does not know the mode exists. That is what makes the
// ordering assertions in tests/kernel/acpi/gpe_synth.pdx assertions
// about the shipping ISR rather than about a test double of it.
//
// -----------------------------------------------------------------------------
// Trace record (3 qwords, 24 B)
// -----------------------------------------------------------------------------
//
//   +0  op     GPE_TRACE_OP_READ / _WRITE / _EOI
//   +8  port   I/O port (0 for an EOI record)
//   +16 value  byte read or written (0 for an EOI record)
//
// The trace is append-only and saturates at GPE_TRACE_MAX records
// rather than wrapping: a wrapped ordering trace can show a clear
// after an EOI that in fact preceded it, which would turn the
// strongest assertion in the milestone into a coin flip.
//
// -----------------------------------------------------------------------------
// Port I/O and the paideia-as effect row
// -----------------------------------------------------------------------------
//
// `in_al` / `out_al` currently carry no effect-row or capability
// coupling in paideia-as (paideia-as#1312): unlike `!{Mmio}`, which
// R29.M2-002 taught the elaborator to require a matching capability
// for, a port access type-checks under any effect row. These two
// functions therefore declare !{sysreg, mem} @{boot} by convention and
// not by enforcement. Confining every GPE port access to this object,
// and asserting that confinement in tools/build.sh, is the substitute
// available today: when #1312 lands, the coupling has exactly one
// place to be applied.

module GpeIo = structure {

  // ============================================================================
  // Modes
  // ============================================================================

  pub let GPE_IO_MODE_PORT  : u64 = 0
  pub let GPE_IO_MODE_SYNTH : u64 = 1

  // ============================================================================
  // Trace
  // ============================================================================

  pub let GPE_TRACE_MAX       : u64 = 128
  pub let GPE_TRACE_OP_READ   : u64 = 1
  pub let GPE_TRACE_OP_WRITE  : u64 = 2
  pub let GPE_TRACE_OP_EOI    : u64 = 3
  pub let GPE_TRACE_NOT_FOUND : u64 = 0xFFFFFFFFFFFFFFFF

  // Synthetic register window: 512 bytes, which covers the largest
  // conforming geometry (two blocks of 32 status + 32 enable bytes)
  // with room to place the two blocks at non-adjacent ports.
  pub let GPE_SYNTH_BYTES : u64 = 512

  // ============================================================================
  // Module storage. Confined to this object; tools/build.sh asserts it.
  // ============================================================================

  pub let mut _gpe_io_mode         : u64 = 0
  pub let mut _gpe_io_synth_origin : u64 = 0
  pub let mut _gpe_io_trace_n      : u64 = 0
  pub let mut _gpe_io_synth_ram    : [u64; 64]  = uninit @align(64)
  pub let mut _gpe_io_trace        : [u64; 384] = uninit @align(64)

  // ============================================================================
  // gpe_io_trace_reset() -> ()
  // ============================================================================

  pub let gpe_io_trace_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): drop the ordering trace to empty. Only the record count is reset; stale record bytes past the count are unreachable through gpe_io_trace_field, which bounds every read against the count. Leaf. Labels prefixed gpe_io_tr_reset_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_trace_n];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let gpe_io_trace_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): number of records appended since the last reset, saturating at GPE_TRACE_MAX. Leaf load.",
      block: {
        lea r10, [rip + _gpe_io_trace_n];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ============================================================================
  // gpe_io_trace_field(idx, field) -> value, or 0 out of range.
  // ============================================================================

  pub let gpe_io_trace_field : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): bounds-checked read into the ordering trace. Guards precede all address arithmetic: field < 3 and idx < the live record count, so no byte past the written prefix of the 9216-byte object is read. Offset = idx*24 + field*8, with idx*24 formed as idx*8 + idx*16 because the encoder's scaled-index forms do not include a 24 stride. Leaf, read-only. Labels prefixed gpe_io_tr_field_ per reserved-label discipline.",
      block: {
        cmp rsi, 3;
        jae gpe_io_tr_field_zero;
        lea r10, [rip + _gpe_io_trace_n];
        mov r10, [r10 + 0];
        cmp rdi, r10;
        jae gpe_io_tr_field_zero;

        mov rax, rdi;
        shl rax, 3;
        mov r11, rdi;
        shl r11, 4;
        add rax, r11;                          // idx * 24
        mov r11, rsi;
        shl r11, 3;
        add rax, r11;                          // + field * 8

        lea r10, [rip + _gpe_io_trace];
        add r10, rax;
        mov rax, [r10 + 0];
        ret;

      gpe_io_tr_field_zero:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // gpe_io_trace_append(op, port, value) -> ()
  //
  // Saturating append. Never called in GPE_IO_MODE_PORT.
  // ============================================================================

  pub let gpe_io_trace_append : (u64, u64, u64) -> () !{mem} @{} =
    fn (op: u64, port: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): append one ordering record, saturating rather than wrapping at GPE_TRACE_MAX. Saturation is the deliberate choice: a wrapped ordering trace can present a status clear as following an EOI it in fact preceded, which would silently invert the strongest assertion this milestone makes. A saturated trace instead reports fewer records than expected, which the witness detects as a count mismatch. Offset = n*24 formed as n*8 + n*16. Leaf. Labels prefixed gpe_io_tr_app_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_trace_n];
        mov r11, [r10 + 0];
        cmp r11, 128;                          // GPE_TRACE_MAX
        jae gpe_io_tr_app_full;

        mov rax, r11;
        shl rax, 3;
        mov r9, r11;
        shl r9, 4;
        add rax, r9;                           // n * 24

        lea r9, [rip + _gpe_io_trace];
        add r9, rax;
        mov [r9 + 0],  rdi;
        mov [r9 + 8],  rsi;
        mov [r9 + 16], rdx;

        add r11, 1;
        mov [r10 + 0], r11;
        ret;

      gpe_io_tr_app_full:
        ret
      }
    }

  // ============================================================================
  // gpe_io_trace_find(op, port, from) -> idx | GPE_TRACE_NOT_FOUND
  //
  // First record at index >= from whose op and port both match.
  // ============================================================================

  pub let gpe_io_trace_find : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, port: u64, from: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): linear scan of the ordering trace for the first (op, port) match at or after `from`. Returning the INDEX rather than a boolean is what lets the witness state its assertions as inequalities between positions -- mask_idx < clear_idx < eoi_idx -- which is the only form in which an ordering claim is checkable. Bounded by the live record count, which is itself bounded by GPE_TRACE_MAX. Leaf, read-only, caller-save scratch only. Labels prefixed gpe_io_tr_find_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_trace_n];
        mov r10, [r10 + 0];
        mov rax, rdx;                          // cursor = from

      gpe_io_tr_find_next:
        cmp rax, r10;
        jae gpe_io_tr_find_miss;

        mov r9, rax;
        shl r9, 3;
        mov r11, rax;
        shl r11, 4;
        add r9, r11;                           // idx * 24
        lea r11, [rip + _gpe_io_trace];
        add r11, r9;

        mov r9, [r11 + 0];
        cmp r9, rdi;
        jne gpe_io_tr_find_bump;
        mov r9, [r11 + 8];
        cmp r9, rsi;
        jne gpe_io_tr_find_bump;
        ret;

      gpe_io_tr_find_bump:
        add rax, 1;
        jmp gpe_io_tr_find_next;

      gpe_io_tr_find_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // gpe_io_trace_find_op(op, from) -> idx | GPE_TRACE_NOT_FOUND
  pub let gpe_io_trace_find_op : (u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, from: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): same scan as gpe_io_trace_find but matching the op alone -- used for the EOI record, which carries no port. Leaf, read-only. Labels prefixed gpe_io_tr_findop_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_trace_n];
        mov r10, [r10 + 0];
        mov rax, rsi;

      gpe_io_tr_findop_next:
        cmp rax, r10;
        jae gpe_io_tr_findop_miss;

        mov r9, rax;
        shl r9, 3;
        mov r11, rax;
        shl r11, 4;
        add r9, r11;
        lea r11, [rip + _gpe_io_trace];
        add r11, r9;

        mov r9, [r11 + 0];
        cmp r9, rdi;
        jne gpe_io_tr_findop_bump;
        ret;

      gpe_io_tr_findop_bump:
        add rax, 1;
        jmp gpe_io_tr_findop_next;

      gpe_io_tr_findop_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // Synthetic-window control. Production never calls these; the mode
  // defaults to GPE_IO_MODE_PORT from .bss zero-init, so a kernel that
  // never mentions them behaves exactly as if this seam did not exist.
  // ============================================================================

  pub let gpe_io_synth_enable : (u64) -> () !{mem} @{} =
    fn (origin: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): point the seam at the 512-byte RAM window, mapping I/O port `origin` to byte 0. Zeroes the window and the trace so a fixture always starts from a known state. Leaf; the 64-qword clear is an unrolled-free counted loop. Labels prefixed gpe_io_se_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_synth_origin];
        mov [r10 + 0], rdi;

        lea r10, [rip + _gpe_io_synth_ram];
        xor rax, rax;
        xor rcx, rcx;
      gpe_io_se_clear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  gpe_io_se_clear;

        lea r10, [rip + _gpe_io_trace_n];
        mov [r10 + 0], rax;

        lea r10, [rip + _gpe_io_mode];
        mov r11, 1;                            // GPE_IO_MODE_SYNTH
        mov [r10 + 0], r11;
        ret
      }
    }

  pub let gpe_io_synth_disable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): return the seam to real port I/O. Called by the fixture on both its success and failure exits so a witness failure cannot leave the kernel addressing RAM in place of the platform's GPE block. Leaf.",
      block: {
        lea r10, [rip + _gpe_io_mode];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let gpe_io_mode : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): current seam mode. Leaf load.",
      block: {
        lea r10, [rip + _gpe_io_mode];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ============================================================================
  // gpe_io_synth_offset(port) -> byte offset | GPE_TRACE_NOT_FOUND
  //
  // Window arithmetic, factored out so the read and write paths cannot
  // disagree about what is inside the window.
  // ============================================================================

  pub let gpe_io_synth_offset : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): port -> offset within the synthetic window, or GPE_TRACE_NOT_FOUND when the port falls outside it. An out-of-window access is NOT clamped: clamping would let a block/bit decomposition bug address a plausible byte of somebody else's register and produce a passing witness. Leaf. Labels prefixed gpe_io_so_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_synth_origin];
        mov r10, [r10 + 0];
        cmp rdi, r10;
        jb  gpe_io_so_out;
        mov rax, rdi;
        sub rax, r10;
        cmp rax, 512;                          // GPE_SYNTH_BYTES
        jae gpe_io_so_out;
        ret;
      gpe_io_so_out:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // gpe_io_synth_poke(port, value) — seed a synthetic register WITHOUT
  // appending to the trace. Fixture setup only; the trace must contain
  // the ISR's accesses and nothing else.
  pub let gpe_io_synth_poke : (u64, u64) -> () !{mem} @{} =
    fn (port: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): untraced byte store into the synthetic window, for fixture setup. Deliberately untraced: the ordering assertions read the trace as a record of what the ISR did, and a fixture that seeded registers through the traced path would have to subtract its own setup from every position it compares. Out-of-window ports are dropped. One push (rbx) preserves the value across the nested offset call and restores rsp%16 to 0 at that call. Labels prefixed gpe_io_poke_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rsi;
        call gpe_io_synth_offset;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_io_poke_out;
        lea r10, [rip + _gpe_io_synth_ram];
        add r10, rax;
        mov_b [r10 + 0], rbx;
      gpe_io_poke_out:
        pop rbx;
        ret
      }
    }

  // gpe_io_synth_peek(port) -> byte, untraced. 0 outside the window.
  pub let gpe_io_synth_peek : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-001 (#1066): untraced byte load from the synthetic window, for fixture assertions about final register state. One push (rbx, unused for value) restores rsp%16 to 0 at the nested offset call. Labels prefixed gpe_io_peek_ per reserved-label discipline.",
      block: {
        push rbx;
        call gpe_io_synth_offset;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_io_peek_out;
        lea r10, [rip + _gpe_io_synth_ram];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        pop rbx;
        ret;
      gpe_io_peek_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_io_read8(port) -> byte
  //
  // THE read. Every GPE status or enable byte the kernel ever observes
  // comes through here.
  // ============================================================================

  pub let gpe_io_read8 : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (port: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): 8-bit read of a GPE register. In GPE_IO_MODE_PORT it is `in_al` against DX with the result masked to a byte -- in_al writes AL only, so rax is zeroed first and masked after, leaving no upper garbage for a caller to compare against. In GPE_IO_MODE_SYNTH it reads the RAM window and appends a GPE_TRACE_OP_READ record. Bounded in both modes: one instruction or one bounded call chain, no loops. This is the only read path for GPE registers in the kernel and tools/build.sh asserts the confinement. Three pushes (rbx, r12, r13) carry the port and the value across the nested calls; entry rsp%16 == 8 and an ODD push count is what returns it to 0 at each call site. paideia-as#1312: in_al carries no effect-row coupling, so the declared !{sysreg} is convention here rather than enforcement. Labels prefixed gpe_io_r8_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;                            // GPE_IO_MODE_SYNTH
        je  gpe_io_r8_synth;

        mov rdx, rdi;
        xor rax, rax;
        in_al al;
        and rax, 0xFF;
        ret;

      gpe_io_r8_synth:
        push rbx;
        push r12;
        push r13;                              // odd push count: rsp%16 == 0 at every nested call
        mov rbx, rdi;                          // port
        call gpe_io_synth_offset;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_io_r8_out;

        lea r10, [rip + _gpe_io_synth_ram];
        add r10, rax;
        xor r12, r12;
        mov_b r12, [r10 + 0];

      gpe_io_r8_emit:
        mov rdi, 1;                            // GPE_TRACE_OP_READ
        mov rsi, rbx;
        mov rdx, r12;
        call gpe_io_trace_append;
        mov rax, r12;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_io_r8_out:
        xor r12, r12;
        jmp gpe_io_r8_emit
      }
    }

  // ============================================================================
  // gpe_io_write8(port, value) -> ()
  // ============================================================================

  pub let gpe_io_write8 : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (port: u64, value: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): 8-bit write of a GPE register. In GPE_IO_MODE_PORT it is `out_al` with DX = port and AL = value. In GPE_IO_MODE_SYNTH it stores into the RAM window and appends a GPE_TRACE_OP_WRITE record; an out-of-window port stores nothing but is STILL traced, so a decomposition bug that addresses outside the fabricated blocks shows up in the trace instead of vanishing. Bounded in both modes. Three pushes (rbx, r12, r13) carry port and value across the nested calls; entry rsp%16 == 8 and an ODD push count is what returns it to 0 at each call site. paideia-as#1312 applies as in gpe_io_read8. Labels prefixed gpe_io_w8_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  gpe_io_w8_synth;

        mov rdx, rdi;
        mov rax, rsi;
        out_al al;
        ret;

      gpe_io_w8_synth:
        push rbx;
        push r12;
        push r13;                              // odd push count: rsp%16 == 0 at every nested call
        mov rbx, rdi;                          // port
        mov r12, rsi;
        and r12, 0xFF;                         // value, byte-sized
        call gpe_io_synth_offset;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_io_w8_emit;

        lea r10, [rip + _gpe_io_synth_ram];
        add r10, rax;
        mov_b [r10 + 0], r12;

      gpe_io_w8_emit:
        mov rdi, 2;                            // GPE_TRACE_OP_WRITE
        mov rsi, rbx;
        mov rdx, r12;
        call gpe_io_trace_append;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_io_eoi() -> ()
  //
  // The acknowledgement, on the same seam as the register accesses so
  // that its POSITION relative to them is observable.
  // ============================================================================

  pub let gpe_io_eoi : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): acknowledge the SCI. In GPE_IO_MODE_PORT this is the real apic_eoi. In GPE_IO_MODE_SYNTH it appends a GPE_TRACE_OP_EOI record and writes nothing -- a fixture must not acknowledge an interrupt the LAPIC never delivered, and recording the acknowledgement is the entire point: clear-before-EOI is an ordering claim, and an ordering claim needs both events on one timeline. One push (rbx, unused) brings rsp%16 to 0 at both nested calls. Labels prefixed gpe_io_eoi_ per reserved-label discipline.",
      block: {
        push rbx;
        lea r10, [rip + _gpe_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  gpe_io_eoi_synth;

        call apic_eoi;
        pop rbx;
        ret;

      gpe_io_eoi_synth:
        mov rdi, 3;                            // GPE_TRACE_OP_EOI
        xor rsi, rsi;
        xor rdx, rdx;
        call gpe_io_trace_append;
        pop rbx;
        ret
      }
    }
}
