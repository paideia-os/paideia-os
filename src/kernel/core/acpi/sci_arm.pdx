// src/kernel/core/acpi/sci_arm.pdx — R30.M4-004 (#1069)
//
// The unmask, and the ordering constraint that guards it.
//
// -----------------------------------------------------------------------------
// Why the unmask is a separate module with a gate in front of it
// -----------------------------------------------------------------------------
//
// R30.M4-001 (#1066) installed the SCI interrupt service routine and
// programmed the IOAPIC redirection entry MASKED, and recorded that
// unmasking belonged to this issue. The reason was not sequencing
// convenience. It was that an interrupt delivered into a system with no
// subscriber has exactly two possible outcomes, and both are bad:
//
//   * The event is queued and never drained. The GPE stays masked
//     because only an acknowledgement re-enables it, and the ring fills
//     with records nobody will read.
//   * The event is not queued at all, because no subscriber is
//     registered for that GPE. The ISR masks it, clears it and strikes
//     it, and after eight strikes the storm gate retires the GPE
//     permanently. Boot would then consume the platform's GPEs, one
//     every eight assertions, before the supervisor process had started.
//
// So the rule is: THE SCI IS NOT UNMASKED UNTIL ROUTING CAN DELIVER.
// `acpi_evt_ready()` is that condition — a KIND_ACPI_EVENT endpoint is
// bound to the stream — and `sci_arm` refuses with SCI_ARM_NOT_READY
// without touching the IOAPIC when it is false. The refusal is checked
// BEFORE the redirection entry is composed, so a failed arm leaves the
// entry exactly as `sci_route_install(..., masked = 1)` left it, which
// the boot witness asserts by reading the RTE back.
//
// -----------------------------------------------------------------------------
// The full ordering, and what happens either side of it
// -----------------------------------------------------------------------------
//
//   1. gpe_config_*         geometry known
//   2. sci_route_install(masked = 1)   ISR installed, line quiet   [#1066]
//   3. gpe_register(index, subscriber) per-GPE subscriber identities
//   4. acpi_evt_cap_mint    endpoint capability, derived from the SCI's
//                           own KIND_HW_INTERRUPT
//   5. acpi_evt_bind        stream ready  <- readiness becomes true here
//   6. sci_arm              THE UNMASK
//
// Before step 6 a GPE cannot fire at all: the line is masked at the
// IOAPIC, so there is nothing to lose. That is the honest answer to
// "what happens to a GPE that fires before any subscriber exists" — in
// the ordered boot path, nothing does, because the hardware is not
// listening yet.
//
// After step 6, if the subscriber disappears (its endpoint is revoked,
// which unbinds the stream), events DO fire and DO get dropped. That
// case is not silent: every such offer increments `acpi_evt_unrouted`,
// and core/acpi/sci_isr.pdx emits one drv_audit_emit record per GPE the
// first time it asserts with no registered subscriber. Dropping an event
// nobody is listening for is defensible; dropping it without saying so
// is not.
//
// -----------------------------------------------------------------------------
// Why this does not re-resolve the route
// -----------------------------------------------------------------------------
//
// `sci_route_install` takes `masked` as a parameter precisely so that
// the arm and the initial install share one resolution path. If this
// module resolved the SCI's GSI, polarity and trigger independently it
// could disagree with the install — and the disagreement that matters is
// trigger mode: an SCI programmed edge-triggered loses every assertion
// arriving while the line is already high, which is the shared-level
// case the SCI exists to handle. One resolver, called twice, cannot
// disagree with itself.

module SciArm = structure {

  pub let SCI_ARM_NOT_READY      : u64 = 0xFFFFFF91
  pub let SCI_ARM_PROGRAM_FAILED : u64 = 0xFFFFFF90

  // ==========================================================================
  // sci_arm(sci_int, vector, dest) -> 0 | SCI_ARM_*
  // ==========================================================================

  pub let sci_arm : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (sci_int: u64, vector: u64, dest: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-004 (#1069): unmask the SCI. THE READINESS GATE IS FIRST AND THE IOAPIC IS NOT TOUCHED WHEN IT REFUSES -- acpi_evt_ready() is consulted before the arguments are even forwarded, so a refused arm leaves the redirection entry exactly as the masked install left it, which is the property the boot witness asserts by reading the RTE back rather than by trusting the return code. On success the same sci_route_install the masked install used is called with masked = 0, so the GSI, polarity and trigger cannot be resolved differently here than they were there; a second resolver would be free to disagree, and the disagreement that matters is trigger mode, because an edge-configured SCI loses every assertion arriving while the line is already high. sci_route_install returns 1 on success and 0 on refusal (null IOAPIC base, GSI 0, or a GSI past the controller's maximum redirection entry), which is translated to SCI_ARM_PROGRAM_FAILED rather than passed through, because a boolean at this layer would be indistinguishable from the readiness refusal. The armed flag is set ONLY after the programming succeeded, so it never claims an unmask that did not happen. Three pushes (rbx, r12, r13) carry the three arguments across the three nested calls; entry rsp%16 == 8 and three pushes return it to 0 at every call site. Labels prefixed sci_arm_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // sci_int
        mov r12, rsi;                    // vector
        mov r13, rdx;                    // destination APIC id

        call acpi_evt_ready;
        cmp rax, 0;
        je  sci_arm_not_ready;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;                    // masked = 0 — THE UNMASK
        call sci_route_install;
        cmp rax, 0;
        je  sci_arm_failed;

        mov rdi, 1;
        call acpi_evt_mark_armed;

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sci_arm_not_ready:
        mov rax, 0xFFFFFF91;             // SCI_ARM_NOT_READY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sci_arm_failed:
        mov rax, 0xFFFFFF90;             // SCI_ARM_PROGRAM_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sci_disarm(sci_int, vector, dest) -> 0 | SCI_ARM_PROGRAM_FAILED
  // ==========================================================================

  pub let sci_disarm : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (sci_int: u64, vector: u64, dest: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-004 (#1069): re-mask the SCI. Deliberately NOT gated on readiness: disarming is the safe direction, and a gate that refused to quiet an interrupt line because the stream was already unbound would make the one recovery a wedged system needs conditional on the thing that wedged it. The armed flag is cleared only after the programming succeeded, for the same reason sci_arm sets it only after: the flag is a claim about the hardware, not about the intent. Same three-push alignment and same single resolver as sci_arm. Labels prefixed sci_disarm_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, 1;                      // masked = 1
        call sci_route_install;
        cmp rax, 0;
        je  sci_disarm_failed;

        xor rdi, rdi;
        call acpi_evt_mark_armed;

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sci_disarm_failed:
        mov rax, 0xFFFFFF90;             // SCI_ARM_PROGRAM_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
