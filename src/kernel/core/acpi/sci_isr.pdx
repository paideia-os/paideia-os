// src/kernel/core/acpi/sci_isr.pdx — R30.M4-001 (#1066)
//
// The SCI interrupt service routine. This file contains exactly one
// function, and that is a structural decision rather than a stylistic
// one — see "The allowlist" below.
//
// -----------------------------------------------------------------------------
// The two orderings, and why neither is negotiable
// -----------------------------------------------------------------------------
//
// (1) MASK, then CLEAR, then EOI.
//
//     The SCI is level-triggered. A level-triggered line stays asserted
//     for as long as its source asserts it, so acknowledging the
//     interrupt without first removing the assertion causes the LAPIC
//     to re-deliver immediately, forever. Clearing the status bit is
//     what removes the assertion — but a status bit whose source is
//     still asserting re-sets the instant it is cleared. Masking first
//     (clearing the ENABLE bit) is what makes the clear stick: the
//     hardware condition for driving the SCI is (STS & EN), so once EN
//     is clear the line is quiet whatever STS does next.
//
//     Hence the order is mask, then clear, then EOI — and the EOI
//     happens once, after every block has been processed, so that no
//     acknowledgement can precede any clear.
//
// (2) MASK, then ENQUEUE.
//
//     A queued event is one the supervisor has not handled yet. If the
//     GPE could re-assert while its handler is still queued, one
//     condition would produce an unbounded number of queued records for
//     a handler that has not run once. Masking before queueing means a
//     GPE has at most one outstanding event, and the supervisor's
//     acknowledgement is the only thing that can produce another.
//
// The event record carries an `enable_snapshot` field which the ISR
// fills by RE-READING the enable register through the same seam as
// every other access, immediately before the record is created. It is
// not a note of what the ISR intended to write. It is what the register
// said at the moment the event was queued, which is the property the
// witness asserts.
//
// -----------------------------------------------------------------------------
// The allowlist — how "no firmware-method evaluation in the ISR" is
// structurally guaranteed rather than merely intended
// -----------------------------------------------------------------------------
//
// A GPE's meaning is a firmware control method. Those methods are
// bytecode, the interpreter lives in a userspace process, and
// evaluating one can block for milliseconds on an embedded-controller
// transaction. None of that may happen here.
//
// Three mechanisms hold that line, in increasing order of strength:
//
//   * tools/lint-no-kernel-aml.sh refuses any build in which a
//     firmware-bytecode identifier appears anywhere under src/kernel/**.
//     That is a NAME check.
//   * The interpreter is in a different address space, reachable only
//     by IPC, and this file issues no IPC. That is an ARCHITECTURE
//     argument, and it depends on nobody adding a send.
//   * tools/build.sh reads `objdump -r` on this object and asserts that
//     the set of symbols it references is a SUBSET of an explicit
//     allowlist. Adding a call to anything not on that list — an
//     interpreter entry point, an IPC send, a scheduler yield, a lock,
//     an allocator — fails the build, by name, with the offending
//     symbol printed. That is a CALL-GRAPH check, and it is the one
//     that does not depend on anybody's diligence.
//
// The allowlist is also what bounds the ISR: every symbol on it is a
// bounded, non-blocking leaf or near-leaf, and nothing else can be
// called, so the ISR's own two nested loops (2 blocks x at most 32
// bytes x 8 bits) are its entire cost.
//
// -----------------------------------------------------------------------------
// Storm handling
// -----------------------------------------------------------------------------
//
// Every assertion of a GPE increments its strike count. Exceeding
// GPE_STORM_THRESHOLD retires the GPE: the enable bit is already clear
// from the mask step and is simply never restored, GPE_ROW_F_PERM_MASKED
// is set so no acknowledgement can bring it back, an audit record is
// emitted, and NO event is queued. The ISR then continues with the next
// bit. The rationale for the specific threshold is in
// core/acpi/gpe_table.pdx.
//
// An asserted GPE with no registered subscriber is masked, cleared and
// struck exactly like any other, but is not queued: there is nobody to
// route the record to, and spending bounded ring slots on unroutable
// records would let an unsubscribed storm evict the reports a
// subscribed handler is waiting for. Its strikes still accumulate, so
// an unsubscribed GPE that fires continuously is retired on the same
// schedule as a subscribed one.

module SciIsr = structure {

  // ============================================================================
  // sci_isr_body() -> number of asserted GPE bits serviced
  //
  // Callable directly (which is what the boot witness does) and from an
  // interrupt entry stub. It touches no interrupt-frame state of its
  // own: the SysV callee-save contract is the whole of its interface.
  //
  // Stack frame after the 5-push prologue and `sub rsp, 80`:
  //   [rsp+0]  block id (0, then 1)
  //   [rsp+8]  status-half width of the current block, in bytes
  //   [rsp+16] I/O port base of the current block's status half
  //   [rsp+24] I/O port base of the current block's enable half
  //   [rsp+32] byte cursor within the block
  //   [rsp+40] first flat GPE index the current block owns
  //   [rsp+48] serviced count (the return value)
  //   [rsp+56] flat index of the GPE currently being accounted
  //   [rsp+64] its strike count
  //   [rsp+72] padding, keeps the frame a multiple of 16
  //
  // Locals live on the stack rather than in registers because every
  // nested call clobbers the caller-save set and there are more live
  // values than callee-save registers. rbx / r13 / r14 / r15 carry the
  // values needed ACROSS calls within the innermost loop.
  // ============================================================================

  pub let sci_isr_body : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066): the SCI interrupt service routine. Outer loop over the two GPE blocks; for each, gpe_block_reg_bytes gives the status-half width (0 for an absent block, which makes the inner loop bound naturally zero) and gpe_block_status_base / gpe_block_enable_base / gpe_block_index_base give the addresses and the index origin -- all four from core/acpi/gpe_block.pdx, so this function contains no block/bit arithmetic of its own beyond byte_cursor*8 + bit. Inner loop over the block status bytes: read status, read enable, and asserted = status & enable, because a latched status bit whose enable is clear does not drive the SCI and must not be treated as an event. If asserted is zero the byte is skipped with no writes at all. Otherwise, in this exact order: (1) MASK -- write enable & ~asserted, computed as enable - asserted since asserted is a subset of enable by construction, so the encoder needs no NOT form. (2) CLEAR -- write asserted back to the status port, which is write-1-to-clear. Masking must precede clearing because the SCI is level-triggered: a status bit whose source is still asserting re-sets the instant it is cleared, and only a clear enable bit makes the line quiet regardless. (3) per-bit accounting over the eight bits of the asserted byte, walking a shifted working copy in r15 so no variable-count shift is needed. For each set bit: gpe_note_strike returns the new consecutive-strike count; above GPE_STORM_THRESHOLD (8) the GPE is retired -- gpe_mark_perm_masked, one drv_audit_emit record with event GPE_AUDIT_EV_STORM, kind 0 (not a capability transition, so mint/revoke accounting is unaffected), subject = GPE index, principal = strike count, outcome 1 -- and NOT queued. The retirement fires on the TRANSITION only (strikes == threshold + 1 exactly): a GPE that keeps asserting after retirement is still masked and cleared every time, because a level-triggered line that is not quiesced livelocks the machine whatever the dispatch table believes, but it is not re-marked and emits no further audit records -- one retirement, one line. At or below the threshold, and only when gpe_lookup reports a registered subscriber, the enable register is RE-READ through the same seam and the byte it returns is stored in the event record as enable_snapshot, which is what makes 'the mask was set at the moment the event was queued' a checkable fact rather than an intention; then gpe_event_enqueue and gpe_mark_pending. (4) EOI once, after both blocks, via gpe_io_eoi -- after every status clear, so no acknowledgement can precede a clear. Bounds: 2 blocks x at most 32 bytes x 8 bits, every call on the build-asserted allowlist, no allocation, no lock, no IPC, no blocking primitive of any kind. Five pushes plus a 80-byte frame keep rsp%16 == 0 at every call site (entry rsp%16 == 8, five pushes bring it to 0, 80 is a multiple of 16). Labels prefixed sci_isr_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 80;

        xor rax, rax;
        mov [rsp + 48], rax;                   // serviced = 0
        mov [rsp + 0],  rax;                   // block = 0

      sci_isr_block_next:
        mov rax, [rsp + 0];
        cmp rax, 2;
        jae sci_isr_blocks_done;

        mov rdi, [rsp + 0];
        call gpe_block_reg_bytes;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je  sci_isr_block_bump;

        mov rdi, [rsp + 0];
        call gpe_block_status_base;
        mov [rsp + 16], rax;

        mov rdi, [rsp + 0];
        call gpe_block_enable_base;
        mov [rsp + 24], rax;

        mov rdi, [rsp + 0];
        call gpe_block_index_base;
        mov [rsp + 40], rax;

        xor rax, rax;
        mov [rsp + 32], rax;                   // byte cursor = 0

      sci_isr_byte_next:
        mov rax, [rsp + 32];
        mov r11, [rsp + 8];
        cmp rax, r11;
        jae sci_isr_block_bump;

        mov r13, [rsp + 16];
        add r13, rax;                          // status port
        mov r14, [rsp + 24];
        add r14, rax;                          // enable port

        // ---- observe ----
        mov rdi, r13;
        call gpe_io_read8;
        mov r12, rax;                          // status

        mov rdi, r14;
        call gpe_io_read8;                     // rax = enable
        and r12, rax;                          // asserted = status & enable
        cmp r12, 0;
        je  sci_isr_byte_bump;

        // ---- (1) MASK: enable & ~asserted, i.e. enable - asserted ----
        sub rax, r12;
        mov rdi, r14;
        mov rsi, rax;
        call gpe_io_write8;

        // ---- (2) CLEAR: write-1-to-clear the asserted status bits ----
        mov rdi, r13;
        mov rsi, r12;
        call gpe_io_write8;

        // ---- (3) per-bit accounting ----
        mov r15, r12;                          // working copy of asserted
        xor rbx, rbx;                          // bit cursor

      sci_isr_bit_next:
        cmp rbx, 8;
        jae sci_isr_byte_bump;

        mov rax, r15;
        and rax, 1;
        cmp rax, 0;
        je  sci_isr_bit_bump;

        // flat index = index_base + byte_cursor*8 + bit
        mov rdi, [rsp + 40];
        mov rax, [rsp + 32];
        shl rax, 3;
        add rdi, rax;
        add rdi, rbx;
        mov [rsp + 56], rdi;

        mov rax, [rsp + 48];
        add rax, 1;
        mov [rsp + 48], rax;                   // serviced += 1

        mov rdi, [rsp + 56];
        call gpe_note_strike;
        mov [rsp + 64], rax;

        mov r11, 8;                            // GPE_STORM_THRESHOLD
        cmp rax, r11;
        jbe sci_isr_bit_dispatch;

        // ---- storm retirement, on the TRANSITION only ----
        // Strikes past threshold+1 mean this GPE is already retired: it
        // is still masked and cleared on every assertion, because a
        // level-triggered line that is not quiesced would livelock the
        // machine whatever the table says, but it is not re-marked and
        // it does not emit a second audit record. One retirement, one
        // record — otherwise a wedged line would flood the audit ring
        // it is supposed to have written exactly one line in.
        mov r11, 9;                            // GPE_STORM_THRESHOLD + 1
        cmp rax, r11;
        jne sci_isr_bit_bump;

        mov rdi, [rsp + 56];
        call gpe_mark_perm_masked;

        mov rdi, 7;                            // GPE_AUDIT_EV_STORM
        xor rsi, rsi;                          // kind 0 — not a cap transition
        mov rdx, [rsp + 56];                   // subject = GPE index
        mov rcx, [rsp + 64];                   // principal = strike count
        mov r8,  1;                            // outcome 1 = retired
        call drv_audit_emit;
        jmp sci_isr_bit_bump;

      sci_isr_bit_dispatch:
        mov rdi, [rsp + 56];
        call gpe_lookup;
        cmp rax, 0;
        je  sci_isr_bit_bump;                  // no subscriber: masked, cleared, struck

        // Re-read the enable register: the snapshot is what the
        // hardware says now, not what we meant to write.
        mov rdi, r14;
        call gpe_io_read8;
        mov rsi, rax;                          // enable_snapshot
        mov rdi, [rsp + 56];
        mov rdx, [rsp + 64];
        call gpe_event_enqueue;

        mov rdi, [rsp + 56];
        call gpe_mark_pending;

      sci_isr_bit_bump:
        shr r15, 1;
        add rbx, 1;
        jmp sci_isr_bit_next;

      sci_isr_byte_bump:
        mov rax, [rsp + 32];
        add rax, 1;
        mov [rsp + 32], rax;
        jmp sci_isr_byte_next;

      sci_isr_block_bump:
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp sci_isr_block_next;

      sci_isr_blocks_done:
        // ---- (4) EOI, once, after every status clear ----
        call gpe_io_eoi;

        mov rax, [rsp + 48];
        add rsp, 80;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
