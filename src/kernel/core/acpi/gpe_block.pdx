// src/kernel/core/acpi/gpe_block.pdx — R30.M4-002 (#1067)
//
// GPE block geometry: the pure arithmetic half of the SCI/GPE path.
//
// -----------------------------------------------------------------------------
// Why this module contains no I/O at all
// -----------------------------------------------------------------------------
//
// A General Purpose Event is identified by a flat index. The hardware
// that reports it is two register blocks of bitmaps. Turning an index
// into (which block, which byte, which bit, which port) is arithmetic,
// and getting that arithmetic wrong does not raise an error — it
// dispatches somebody else's handler. That is the single worst failure
// mode in this milestone, so the decomposition lives here, alone, with
// no register access anywhere in the module: every function in this
// file is a pure function of `_gpe_cfg` and its arguments, and can
// therefore be exercised against a fabricated configuration with no
// hardware and no synthetic-register machinery involved.
//
// The register access itself lives in core/acpi/gpe_io.pdx, which is
// the ONLY module in the kernel that issues in/out against a GPE
// register. The dispatch logic in core/acpi/sci_isr.pdx composes the
// two. That is the register-access / logic split.
//
// -----------------------------------------------------------------------------
// Block layout (ACPI 6.5 §4.8.4.1, §5.2.9)
// -----------------------------------------------------------------------------
//
// GPE0_BLK is GPE0_BLK_LEN bytes long and is split in half:
//
//     [ GPE0_STS : LEN/2 bytes ][ GPE0_EN : LEN/2 bytes ]
//      ^ base                    ^ base + LEN/2
//
// so a block of LEN bytes carries (LEN/2)*8 event bits. GPE0 owns
// indices 0 .. (GPE0_BLK_LEN/2)*8 - 1. GPE1_BLK has the identical
// shape and its indices START at GPE1_BASE (an explicit FADT field,
// NOT a continuation of GPE0's count — firmware chooses it, and on
// several shipping platforms it leaves a hole).
//
// A status bit is write-1-to-clear. An enable bit is plain read/write.
// A GPE is asserted iff (STS & EN) has its bit set: a status bit whose
// enable bit is clear is latched but does not drive the SCI, which is
// exactly what masking exploits.
//
// -----------------------------------------------------------------------------
// Why wrong-block dispatch is not merely unlikely but unrepresentable
// -----------------------------------------------------------------------------
//
// ACPI requires GPE1_BASE to be greater than or equal to the number of
// GPE0 events; overlapping ranges are a firmware bug. Rather than
// resolve an overlap at dispatch time (where a wrong answer is silent),
// gpe_config_set REFUSES an overlapping configuration outright with
// GPE_CFG_OVERLAP. After a successful configuration the two index
// ranges are disjoint by construction, so gpe_resolve's "test GPE0's
// range, then GPE1's" cannot be order-sensitive: no index satisfies
// both tests, and an index satisfying neither is GPE_RESOLVE_BAD
// rather than a default to block 0.
//
// -----------------------------------------------------------------------------
// gpe_resolve packed result
// -----------------------------------------------------------------------------
//
//   bits  [7:0]   bit index within the byte (0..7)
//   bits [15:8]   byte offset within the block's status/enable half
//   bits [23:16]  block id (0 = GPE0, 1 = GPE1)
//   everything else zero
//
// GPE_RESOLVE_BAD is all-ones, which no valid packing can produce
// (block id is 0 or 1, so bits [63:24] are always clear on success).

module GpeBlock = structure {

  // ============================================================================
  // Geometry bounds
  // ============================================================================

  // Per block. GPE1_BASE is a u8 in the FADT, and a block of 32
  // status bytes covers 256 events, so 32 status bytes per block is
  // the largest geometry the index space can even name.
  pub let GPE_MAX_REG_BYTES : u64 = 32

  // Flat index space. GPE1_BASE is a u8 and a block cannot extend
  // past it, so 256 is the hard ceiling on any conforming platform.
  pub let GPE_MAX_INDEX     : u64 = 256

  // ============================================================================
  // Return codes — 0xFFFFFFB0..0xFFFFFFBF, disjoint from every
  // neighbouring block: OPREG_* / DRV_AUDIT_ERR_* at 0xFFFFFFC4..CF,
  // DMA_* at 0xFFFFFFD5..DC, MSIX_* at 0xFFFFFFE7..E9,
  // HW_INT_* at 0xFFFFFFF7..FD.
  // ============================================================================

  pub let GPE_OK                 : u64 = 0
  pub let GPE_CFG_BAD_ARG        : u64 = 0xFFFFFFBF
  pub let GPE_CFG_BAD_LEN        : u64 = 0xFFFFFFBE
  pub let GPE_CFG_OVERLAP        : u64 = 0xFFFFFFBD
  pub let GPE_CFG_RANGE          : u64 = 0xFFFFFFBC
  pub let GPE_REG_BAD_INDEX      : u64 = 0xFFFFFFBB
  pub let GPE_REG_DUPLICATE      : u64 = 0xFFFFFFBA
  pub let GPE_REG_BAD_HANDLER    : u64 = 0xFFFFFFB9
  pub let GPE_REG_NOT_REGISTERED : u64 = 0xFFFFFFB8
  pub let GPE_REG_UNCONFIGURED   : u64 = 0xFFFFFFB7
  pub let GPE_ACK_PERM_MASKED    : u64 = 0xFFFFFFB6
  pub let GPE_ACK_NOT_PENDING    : u64 = 0xFFFFFFB5

  pub let GPE_RESOLVE_BAD        : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // _gpe_cfg — the platform's decoded GPE geometry (64 B).
  //
  //   +0   u64 gpe0_port        I/O port of GPE0_BLK, 0 if absent
  //   +8   u64 gpe0_reg_bytes   GPE0_BLK_LEN / 2 (status half width)
  //   +16  u64 gpe1_port        I/O port of GPE1_BLK, 0 if absent
  //   +24  u64 gpe1_reg_bytes   GPE1_BLK_LEN / 2
  //   +32  u64 gpe1_base        first flat index owned by GPE1
  //   +40  u64 configured       1 iff a successful gpe_config_set ran
  //   +48  u64 gpe0_count       gpe0_reg_bytes * 8
  //   +56  u64 gpe1_count       gpe1_reg_bytes * 8
  //
  // Written only by gpe_config_set / gpe_config_reset, both in this
  // object. tools/build.sh asserts no other object relocates against
  // this symbol, which is what keeps "the geometry was validated"
  // an invariant of the whole kernel rather than a claim about the
  // one call site somebody happened to read.
  // ============================================================================

  pub let mut _gpe_cfg : [u64; 8] = uninit @align(64)

  // ============================================================================
  // gpe_config_reset() -> ()
  //
  // Return the module to the unconfigured state. Every resolver
  // refuses while `configured` is 0, so this is a hard stop rather
  // than a reset to defaults: there are no defensible defaults for a
  // GPE geometry, and inventing one would silently address whatever
  // I/O ports the invented numbers happened to name.
  // ============================================================================

  pub let gpe_config_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): zero all eight qwords of _gpe_cfg, clearing the configured flag last-of-equals (all stores are unconditional so ordering is irrelevant here; the flag is at +40). Leaf, no nested calls, no callee-save writes. Labels prefixed gpe_cfg_reset_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // gpe_config_set(gpe0_port, gpe0_blk_len, gpe1_port, gpe1_blk_len,
  //                gpe1_base) -> GPE_OK | GPE_CFG_*
  //
  // The lengths are the RAW FADT GPE0_BLK_LEN / GPE1_BLK_LEN values —
  // the width of the WHOLE block, status half plus enable half. They
  // must be even (ACPI 6.5 §5.2.9: "This value is a multiple of two")
  // because an odd length cannot be split into two equal halves and
  // any rounding choice silently shifts the enable half by a byte,
  // which masks the wrong eight events.
  //
  // On any refusal the configuration is left FULLY CLEARED, not
  // partially applied: a half-written geometry that still reported
  // `configured == 1` would be worse than no geometry at all.
  // ============================================================================

  pub let gpe_config_set : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (gpe0_port: u64, gpe0_blk_len: u64, gpe1_port: u64,
        gpe1_blk_len: u64, gpe1_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): validate and install the platform GPE geometry. Gate order, each refusal clearing the whole config first so no partially-applied geometry is ever observable: (1) both block lengths must be even -- GPE_CFG_BAD_LEN -- because an odd length has no equal status/enable split and any rounding rule silently displaces the enable half by one byte, masking eight wrong events. (2) each half-width (len/2) must be <= GPE_MAX_REG_BYTES (32) -- GPE_CFG_BAD_LEN -- 32 status bytes is 256 events, the entire flat index space a u8 GPE1_BASE can name. (3) a non-zero-length block must have a non-zero port -- GPE_CFG_BAD_ARG -- a length without an address is a firmware table we cannot act on. (4) both blocks empty -- GPE_CFG_BAD_ARG -- there is nothing to configure. (5) gpe0_count = (gpe0_blk_len/2)*8 must be <= 256 -- GPE_CFG_RANGE. (6) if GPE1 is present: gpe1_base must be < 256 -- GPE_CFG_RANGE; gpe1_base must be >= gpe0_count -- GPE_CFG_OVERLAP, the gate that makes wrong-block dispatch unrepresentable rather than merely unlikely; and gpe1_base + gpe1_count must be <= 256 -- GPE_CFG_RANGE. Only after every gate passes are the eight qwords written and the configured flag raised. Three-push prologue (rbx, r12, r13) purely for scratch that survives the clear-on-failure helper path; entry rsp%16==8 plus three pushes is 8, and there are no nested calls in this body so no further alignment is required. Pure with respect to hardware: no port I/O anywhere in this module. Labels prefixed gpe_cfg_set_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        // r12 = gpe0 half-width, r13 = gpe1 half-width.
        // (1) even-length gate, both blocks.
        mov rax, rsi;
        and rax, 1;
        cmp rax, 0;
        jne gpe_cfg_set_bad_len;
        mov rax, rcx;
        and rax, 1;
        cmp rax, 0;
        jne gpe_cfg_set_bad_len;

        mov r12, rsi;
        shr r12, 1;                            // gpe0_reg_bytes
        mov r13, rcx;
        shr r13, 1;                            // gpe1_reg_bytes

        // (2) half-width ceiling.
        mov rax, 32;                           // GPE_MAX_REG_BYTES
        cmp r12, rax;
        ja  gpe_cfg_set_bad_len;
        cmp r13, rax;
        ja  gpe_cfg_set_bad_len;

        // (3) non-zero length implies non-zero port.
        cmp r12, 0;
        je  gpe_cfg_set_p0_ok;
        cmp rdi, 0;
        je  gpe_cfg_set_bad_arg;
      gpe_cfg_set_p0_ok:
        cmp r13, 0;
        je  gpe_cfg_set_p1_ok;
        cmp rdx, 0;
        je  gpe_cfg_set_bad_arg;
      gpe_cfg_set_p1_ok:

        // (4) at least one block must exist.
        mov rax, r12;
        add rax, r13;
        cmp rax, 0;
        je  gpe_cfg_set_bad_arg;

        // rbx = gpe0_count, rax = gpe1_count.
        mov rbx, r12;
        shl rbx, 3;
        mov rax, r13;
        shl rax, 3;

        // (5) gpe0_count ceiling.
        mov r10, 256;                          // GPE_MAX_INDEX
        cmp rbx, r10;
        ja  gpe_cfg_set_range;

        // (6) GPE1 placement gates (only when GPE1 is present).
        cmp r13, 0;
        je  gpe_cfg_set_commit;

        cmp r8, r10;
        jae gpe_cfg_set_range;                 // gpe1_base must be < 256

        cmp r8, rbx;
        jb  gpe_cfg_set_overlap;               // gpe1_base < gpe0_count

        mov r11, r8;
        add r11, rax;                          // gpe1_base + gpe1_count
        cmp r11, r10;
        ja  gpe_cfg_set_range;

      gpe_cfg_set_commit:
        lea r10, [rip + _gpe_cfg];
        mov [r10 + 0],  rdi;                   // gpe0_port
        mov [r10 + 8],  r12;                   // gpe0_reg_bytes
        mov [r10 + 16], rdx;                   // gpe1_port
        mov [r10 + 24], r13;                   // gpe1_reg_bytes
        mov [r10 + 32], r8;                    // gpe1_base
        mov [r10 + 48], rbx;                   // gpe0_count
        mov [r10 + 56], rax;                   // gpe1_count
        mov r11, 1;
        mov [r10 + 40], r11;                   // configured — written LAST
        xor rax, rax;                          // GPE_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_cfg_set_bad_len:
        mov rbx, 0xFFFFFFBE;                   // GPE_CFG_BAD_LEN
        jmp gpe_cfg_set_refuse;
      gpe_cfg_set_bad_arg:
        mov rbx, 0xFFFFFFBF;                   // GPE_CFG_BAD_ARG
        jmp gpe_cfg_set_refuse;
      gpe_cfg_set_overlap:
        mov rbx, 0xFFFFFFBD;                   // GPE_CFG_OVERLAP
        jmp gpe_cfg_set_refuse;
      gpe_cfg_set_range:
        mov rbx, 0xFFFFFFBC;                   // GPE_CFG_RANGE

      gpe_cfg_set_refuse:
        // Clear the whole configuration inline (no nested call, so the
        // three-push frame needs no realignment) and return the code.
        lea r10, [rip + _gpe_cfg];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_config_from_fadt(fadt_info: u64) -> GPE_OK | GPE_CFG_*
  //
  // Read the five GPE fields out of a 64-byte fadt_info produced by
  // acpi/fadt.pdx §fadt_parse and hand them to gpe_config_set. The
  // geometry is NEVER hard-coded: every number comes from firmware and
  // every number is gated by gpe_config_set before it can address a
  // port.
  // ============================================================================

  pub let gpe_config_from_fadt : (u64) -> u64 !{mem} @{} =
    fn (fadt_info: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): marshal fadt_info's GPE fields into gpe_config_set. Field offsets are the ones acpi/fadt.pdx documents: gpe0_blk_port u16 @ +24, gpe1_blk_port u16 @ +26, gpe0_blk_len u8 @ +28, gpe1_blk_len u8 @ +29, gpe1_base u8 @ +30. A null pointer is GPE_CFG_BAD_ARG before any load. Loads are zero-extended through xor+mov_w / xor+mov_b so no upper garbage reaches the validator. One push (rbx) aligns rsp to a 16-byte boundary for the nested gpe_config_set call: entry rsp%16 == 8, one push takes it to 0. rbx also carries the fadt_info pointer across the argument marshalling, which uses rdi/rsi/rdx/rcx/r8. Labels prefixed gpe_cfg_fadt_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  gpe_cfg_fadt_null;

        push rbx;
        mov rbx, rdi;

        xor rax, rax;
        mov_w rax, [rbx + 24];
        mov rdi, rax;                          // gpe0_port

        xor rax, rax;
        mov_b rax, [rbx + 28];
        mov rsi, rax;                          // gpe0_blk_len

        xor rax, rax;
        mov_w rax, [rbx + 26];
        mov rdx, rax;                          // gpe1_port

        xor rax, rax;
        mov_b rax, [rbx + 29];
        mov rcx, rax;                          // gpe1_blk_len

        xor rax, rax;
        mov_b rax, [rbx + 30];
        mov r8, rax;                           // gpe1_base

        call gpe_config_set;
        pop rbx;
        ret;

      gpe_cfg_fadt_null:
        mov rax, 0xFFFFFFBF;                   // GPE_CFG_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // Configuration readers. Every one of these is a leaf load; they
  // exist so that no other object needs to relocate against _gpe_cfg.
  // ============================================================================

  pub let gpe_configured : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): 1 iff a validated geometry is installed. Leaf load of _gpe_cfg+40. Labels prefixed gpe_configured_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  pub let gpe_total_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): gpe0_count + gpe1_count, or 0 when unconfigured. Note this is a COUNT of events, not the top of the index space -- GPE1 may start above gpe0_count, so the highest valid index is gpe1_base + gpe1_count - 1 and callers must not treat this sum as a bound. Leaf. Labels prefixed gpe_total_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne gpe_total_zero;
        mov rax, [r10 + 48];
        mov r11, [r10 + 56];
        add rax, r11;
        ret;
      gpe_total_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // gpe_block_reg_bytes(block) -> status-half width in bytes, 0 for an
  // absent block or an out-of-range block id.
  pub let gpe_block_reg_bytes : (u64) -> u64 !{mem} @{} =
    fn (block: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): status-half width of GPE0 (block 0, _gpe_cfg+8) or GPE1 (block 1, _gpe_cfg+24). Any other block id, or an unconfigured module, answers 0 -- which makes the ISR's per-block loop bound naturally zero rather than requiring a separate guard at the call site. Leaf. Labels prefixed gpe_brb_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne gpe_brb_zero;
        cmp rdi, 0;
        jne gpe_brb_one;
        mov rax, [r10 + 8];
        ret;
      gpe_brb_one:
        cmp rdi, 1;
        jne gpe_brb_zero;
        mov rax, [r10 + 24];
        ret;
      gpe_brb_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // gpe_block_status_base(block) -> I/O port of the block's status half.
  pub let gpe_block_status_base : (u64) -> u64 !{mem} @{} =
    fn (block: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): the status half starts at the block base, so this is _gpe_cfg+0 for block 0 and _gpe_cfg+16 for block 1. 0 for an unconfigured module or an out-of-range block id; callers reach this only after gpe_block_reg_bytes reported a non-zero width, so a 0 here is unreachable in the ISR and is a defensive answer rather than a live path. Leaf. Labels prefixed gpe_bsb_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne gpe_bsb_zero;
        cmp rdi, 0;
        jne gpe_bsb_one;
        mov rax, [r10 + 0];
        ret;
      gpe_bsb_one:
        cmp rdi, 1;
        jne gpe_bsb_zero;
        mov rax, [r10 + 16];
        ret;
      gpe_bsb_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // gpe_block_enable_base(block) -> I/O port of the block's enable half.
  pub let gpe_block_enable_base : (u64) -> u64 !{mem} @{} =
    fn (block: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): the enable half starts one status-half further on, so this is base + reg_bytes. Computing it here rather than at the call site is the point: an ISR that recomputed the offset would be a second place for the /2 split to be got wrong, and the two places would not have to disagree loudly. 0 for an unconfigured module or an out-of-range block id. Leaf. Labels prefixed gpe_beb_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne gpe_beb_zero;
        cmp rdi, 0;
        jne gpe_beb_one;
        mov rax, [r10 + 0];
        mov r11, [r10 + 8];
        add rax, r11;
        ret;
      gpe_beb_one:
        cmp rdi, 1;
        jne gpe_beb_zero;
        mov rax, [r10 + 16];
        mov r11, [r10 + 24];
        add rax, r11;
        ret;
      gpe_beb_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // gpe_block_index_base(block) -> first flat index the block owns.
  pub let gpe_block_index_base : (u64) -> u64 !{mem} @{} =
    fn (block: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): GPE0 always owns index 0; GPE1 owns gpe1_base, an explicit firmware field and NOT gpe0_count. Conflating the two is the exact bug this accessor exists to make impossible to write by hand -- on platforms where GPE1_BASE leaves a hole above GPE0 the two differ, and the resulting dispatch is off by the size of the hole with no error anywhere. 0 for an out-of-range block id. Leaf. Labels prefixed gpe_bib_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne gpe_bib_zero;
        cmp rdi, 1;
        jne gpe_bib_zero;
        mov rax, [r10 + 32];
        ret;
      gpe_bib_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // gpe_resolve(index) -> packed | GPE_RESOLVE_BAD
  //
  // The whole block/bit decomposition, in one place.
  // ============================================================================

  pub let gpe_resolve : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): flat GPE index -> (block, byte, bit). Refuses outright when unconfigured. GPE0 owns [0, gpe0_count); GPE1 owns [gpe1_base, gpe1_base + gpe1_count). gpe_config_set has already proven these two ranges disjoint (GPE_CFG_OVERLAP), so testing GPE0 first is not a precedence rule that could hide a GPE1 event -- no index is in both. An index in neither range is GPE_RESOLVE_BAD; there is deliberately no fallback to block 0, because a fallback turns an out-of-range index into somebody else's handler. Packing: bit = rel & 7 into [7:0], byte = rel >> 3 into [15:8], block id into [23:16]. Every valid packing leaves [63:24] clear, so the all-ones sentinel is unambiguous. Leaf, no nested calls, caller-save scratch only (r9/r10/r11). Labels prefixed gpe_res_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _gpe_cfg];
        mov r11, [r10 + 40];
        cmp r11, 1;
        jne gpe_res_bad;

        // ---- GPE0: [0, gpe0_count) ----
        mov r11, [r10 + 48];
        cmp rdi, r11;
        jae gpe_res_try1;

        mov rax, rdi;
        shr rax, 3;
        shl rax, 8;                            // byte offset -> [15:8]
        mov r9, rdi;
        and r9, 7;
        or  rax, r9;                           // bit -> [7:0]
        ret;                                   // block id 0 -> [23:16] clear

        // ---- GPE1: [gpe1_base, gpe1_base + gpe1_count) ----
      gpe_res_try1:
        mov r11, [r10 + 56];                   // gpe1_count
        cmp r11, 0;
        je  gpe_res_bad;

        mov r9, [r10 + 32];                    // gpe1_base
        cmp rdi, r9;
        jb  gpe_res_bad;

        mov rax, rdi;
        sub rax, r9;                           // rel within GPE1
        cmp rax, r11;
        jae gpe_res_bad;

        mov r9, rax;
        shr r9, 3;
        shl r9, 8;                             // byte offset -> [15:8]
        and rax, 7;                            // bit -> [7:0]
        or  rax, r9;
        mov r11, 0x10000;                      // block id 1 -> [23:16]
        or  rax, r11;
        ret;

      gpe_res_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;           // GPE_RESOLVE_BAD
        ret
      }
    } @no_frame

  pub let gpe_resolve_bit : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-002 (#1067): bits [7:0] of a gpe_resolve packing. Pure leaf.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let gpe_resolve_byte : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-002 (#1067): bits [15:8] of a gpe_resolve packing. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let gpe_resolve_block : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-002 (#1067): bits [23:16] of a gpe_resolve packing. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  // ============================================================================
  // gpe_status_port(index) / gpe_enable_port(index)
  //
  //   -> the I/O port carrying this event's status / enable byte, or
  //      GPE_RESOLVE_BAD for an index outside the configured geometry.
  //
  // These are the only sanctioned way to turn an index into an address.
  // ============================================================================

  pub let gpe_status_port : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): gpe_resolve then status_base(block) + byte. Propagates GPE_RESOLVE_BAD unchanged rather than substituting a port, so a bad index cannot become an I/O address anywhere downstream. Two pushes (rbx, r12) hold the packing and the block across the two nested calls; entry rsp%16 == 8 and two pushes return it to 8, so a third push (r13, unused) is added to reach 0 at the call boundary. Labels prefixed gpe_sp_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        call gpe_resolve;
        mov rbx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rbx;
        je  gpe_sp_bad;

        mov rbx, rax;                          // packed
        mov r12, rax;
        shr r12, 16;
        and r12, 0xFF;                         // block

        mov rdi, r12;
        call gpe_block_status_base;
        mov r13, rbx;
        shr r13, 8;
        and r13, 0xFF;                         // byte offset
        add rax, r13;

        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_sp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpe_enable_port : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-002 (#1067): gpe_resolve then enable_base(block) + byte, where enable_base already carries the status-half displacement. Same GPE_RESOLVE_BAD propagation and same three-push alignment discipline as gpe_status_port. Labels prefixed gpe_ep_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        call gpe_resolve;
        mov rbx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rbx;
        je  gpe_ep_bad;

        mov rbx, rax;
        mov r12, rax;
        shr r12, 16;
        and r12, 0xFF;

        mov rdi, r12;
        call gpe_block_enable_base;
        mov r13, rbx;
        shr r13, 8;
        and r13, 0xFF;
        add rax, r13;

        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_ep_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // gpe_bit_mask(bit) -> 1 << bit for bit in 0..7, else 0
  //
  // A counted shift rather than a variable-count one: paideia-as
  // encodes shl with an immediate count, and a table lookup would be a
  // second place for the bit numbering to be stated. Bounded at eight
  // iterations, so it is safe to call from interrupt context even
  // though the ISR itself does not need it (it walks a shifted working
  // copy instead).
  // ============================================================================

  pub let gpe_bit_mask : (u64) -> u64 !{} @{} =
    fn (bit: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-002 (#1067): 1 << bit, computed as a counted single-bit shift because the encoder offers no variable-count shift form. Refuses bit >= 8 with 0 rather than wrapping into a neighbouring byte's bit numbering, which would set the wrong event's enable or clear the wrong event's status -- both silent. Pure leaf, at most eight iterations. Labels prefixed gpe_bm_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae gpe_bm_zero;
        mov rax, 1;
        xor rcx, rcx;
      gpe_bm_next:
        cmp rcx, rdi;
        jae gpe_bm_done;
        shl rax, 1;
        add rcx, 1;
        jmp gpe_bm_next;
      gpe_bm_done:
        ret;
      gpe_bm_zero:
        xor rax, rax;
        ret
      }
    } @no_frame
}
