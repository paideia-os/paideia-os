// src/kernel/core/wasi/wasi_args_conv.pdx -- Wave UMB-W17 R135.M3
// paideia-os #2628
//
// WASI ARGV / STDIN CONVERSION STUBS
// =============================================================================
//
// R135.M3 lands the kernel-side side-table that lets a WASI module running
// in a svc.jail-supervisor jail observe its argv via `wasi_args_sizes_get`
// / `wasi_args_get` and read from stdin via `wasi_fd_read(0, ...)`.  M3's
// posture is `stub`: for pids that have NOT been registered via
// `_wasi_args_register(pid, blob_ptr, blob_len)` first, every WASI shim
// returns `WASI_EBADF`.  Real wiring to execve argv lands in M4 (hook into
// sys_execve.pdx just before the aspace swap); real stdin fd mediation
// (fd 0 -> task.fd_table[0] -> vnode -> vfs_read) lands in M5.
//
// Full design: `design/shell/wasi-argv-stdin-conversion.md`.
//
// Companion substrates (M4+ touch-points):
//   - svc/jail_supervisor.pdx (R135.M1/M2) -- 1:1 logical mate; a WASI jail
//     cannot exist without a jail-supervisor row.
//   - syscall/handlers/sys_execve.pdx (R15.M6) -- M4 hooks register-on-exec
//     into step 3.8 (after caps_decl_apply) of this body.
//   - fs/vfs_read.pdx (R16.M1) -- M5 mediates _wasi_stdin_read through fd
//     table + vnode read.
//
// =============================================================================
// SECTION 0  WHY A SIDE TABLE INSTEAD OF A TASK-ROW FIELD
// =============================================================================
//
// Same reasoning as jail_supervisor.pdx §0: widening the task row for WASI-
// specific fields punishes the 99 % of tasks that are not WASI.  A dedicated
// side table keyed by pid keeps the WASI state off the task hot path and
// lives in parallel to the 8-row jail-supervisor pool.  Capacity match
// (WA_POOL_MAX = 8 = JS_POOL_MAX) is intentional -- the two tables are
// logically 1:1 and grow together.
//
// =============================================================================
// SECTION 1  ROW LAYOUT  --  128 BYTES PER ROW, 8 ROWS
// =============================================================================
//
// Stride 128 is a power of two so row addressing uses `shl rax, 7` -- no
// imul (feedback_pdx_encoder_pitfalls: 2-op `imul r, imm` is an encoder gap).
//
//   [+0]    pid                 (u64)  owning pid; 0 is reserved
//   [+8]    blob_len            (u64)  bytes stored (<= WA_BLOB_MAX = 1024)
//   [+16]   argc                (u64)  derived at register time (NUL count)
//   [+24]   argv_buf_size       (u64)  == blob_len (WASI-named alias; the
//                                       WASI spec names it separately from
//                                       argc so we keep the name here)
//   [+32..+103]                        reserved for M4 exec-time metadata
//                                       (parent pid, exec tick, etc.)
//   [+104]  reserved_a          (u64)  slack
//   [+112]  in_use              (u64)  0 = row free, 1 = row allocated.
//                                       .bss zero-init gives us FREE at
//                                       boot (shape mirror of
//                                       jail_supervisor's JS_OFF_IN_USE).
//   [+120]  reserved_b          (u64)  slack
//
// Row-addressed capacity: WA_POOL_MAX = 8 pids.  8 x 128 = 1024 bytes =
// 128 u64.  The in_use field at +112 is the authoritative free/live gate.
// pid==0 is still rejected at register time (WASI_EINVAL) to keep the
// "pid is a positive integer" invariant honest.
//
// =============================================================================
// SECTION 2  BLOB STORE  --  8 KiB TOTAL, 1 KiB PER ROW
// =============================================================================
//
//   _wasi_args_blobs : [u8; 8192] @align(64)
//
// Row `i` owns bytes [i*1024 .. (i+1)*1024).  Row base pointer for the blob
// is `_wasi_args_blobs + (row_idx << 10)` -- power-of-two stride matches
// the row-base discipline above.  WA_BLOB_MAX = 1024.
//
// =============================================================================
// SECTION 3  RETURN CODE BAND (WASI-ALIGNED)
// =============================================================================
//
// Per WASI preview1 `errno`:
//
//   WASI_OK      = 0       (success)
//   WASI_EBADF   = 0x08    (bad fd / pid-not-registered overload)
//   WASI_EINVAL  = 0x1C    (invalid argument)
//   WASI_ENOMEM  = 0x30    (not enough space / cannot allocate)
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the 7-byte
// zero-extending form (never `and r11, imm64`).  See design doc §5 for the
// EBADF-on-unregistered-pid overload rationale.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Labels prefixed `wa_` (wasi-args) to stay clear of `js_` (jail_supervisor),
// `ss_` (shell_session), `cmnt_` (cap_minter), `ks_` (kind_shell_session),
// `sh_` (shell_history).  No reserved paideia-as keyword overlap (reserved:
// loop / if / let).  Encoder-pitfall posture:
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 7            (stride-128 row base; never `imul r, imm`)
//   * shl rN, 10           (stride-1024 blob base; still power-of-two)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * single-line `pub let name = "..."`
//   * module basename WasiArgsConv matches file basename wasi_args_conv.pdx
//     (ddc requires exact match)
//   * no fingerprint tags at M3 -- this module has no boot bringup and no
//     klog surface; M4 may add fingerprints alongside the execve hook.
//
// Stack discipline (SysV, entry rsp%16==8):
//
// Alignment arithmetic (odd n of pushes -> rsp%16==0 at nested call;
// even n of pushes -> rsp%16==8, needs sub rsp,8):
//
//   _wasi_args_row_base          0 pushes (pure leaf, no calls)
//   _wasi_args_blob_base         0 pushes (pure leaf, no calls)
//   _wasi_args_find_row          0 pushes (pure leaf scan, no calls)
//   _wasi_args_find_free         0 pushes (pure leaf scan, no calls)
//   _wasi_args_register          3 pushes (odd -> aligned)
//   _wasi_args_sizes_get         3 pushes (odd -> aligned)
//   _wasi_args_get               4 pushes + sub rsp,8 (even -> aligned)
//   _wasi_stdin_read             2 pushes + sub rsp,8 (even -> aligned)
//
// =============================================================================

module WasiArgsConv = structure {

  // ==========================================================================
  // Return band (WASI-aligned, §3)
  // ==========================================================================

  pub let WASI_OK      : u64 = 0
  pub let WASI_EBADF   : u64 = 0x08
  pub let WASI_EINVAL  : u64 = 0x1C
  pub let WASI_ENOMEM  : u64 = 0x30

  // ==========================================================================
  // Pool + blob geometry (§1, §2)
  // ==========================================================================

  pub let WA_POOL_MAX   : u64 = 8     // rows (jailed WASI pids)
  pub let WA_ROW_BYTES  : u64 = 128   // 16 u64 per row
  pub let WA_BLOB_MAX   : u64 = 1024  // bytes per row's argv blob

  // Row-field offsets (bytes, from row base)
  pub let WA_OFF_PID            : u64 = 0
  pub let WA_OFF_BLOB_LEN       : u64 = 8
  pub let WA_OFF_ARGC           : u64 = 16
  pub let WA_OFF_ARGV_BUF_SIZE  : u64 = 24
  pub let WA_OFF_RESERVED_A     : u64 = 104
  pub let WA_OFF_IN_USE         : u64 = 112
  pub let WA_OFF_RESERVED_B     : u64 = 120

  // Sentinel for "no row matched" (find_row).
  pub let WA_ID_NONE : u64 = 0xFF

  // ==========================================================================
  // Storage
  //
  //   _wasi_args_pool  -- 8 rows x 128 bytes = 128 u64. @align(64) puts the
  //                       pool on a cache-line boundary (rows 0, 2, 4, 6
  //                       land on cache line starts; stride 128 is 2^7 so
  //                       no imul is needed).
  //   _wasi_args_blobs -- 8192 bytes = 8 KiB.  Row i owns bytes [i<<10 ..
  //                       (i+1)<<10).  @align(64) matches the pool.
  // ==========================================================================

  pub let mut _wasi_args_pool  : [u64; 128]  = uninit @align(64)
  pub let mut _wasi_args_blobs : [u8;  8192] = uninit @align(64)

  // ==========================================================================
  // _wasi_args_row_base(row_idx) -> &_wasi_args_pool[row_idx * 128]
  //
  // Row index -> row base pointer.  Stride 128 = 2^7 so `shl rax, 7`
  // suffices (no `imul r, imm` encoder gap, no reg-reg staging).  Caller
  // validates row_idx < WA_POOL_MAX first; this helper is a pure address
  // compute.  Labels prefixed wa_rb_.
  // ==========================================================================
  pub let _wasi_args_row_base : (u64) -> u64 !{} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): row_idx -> &_wasi_args_pool[row_idx*128]. Power-of-two stride uses `shl rax, 7` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates. Pure leaf -- no pushes. Labels prefixed wa_rb_. Mirrors js_row_base one-for-one.",
      block: {
        mov rax, rdi;                    // row_idx
        shl rax, 7;                      // row_idx * 128
        lea r10, [rip + _wasi_args_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_blob_base(row_idx) -> &_wasi_args_blobs[row_idx * 1024]
  //
  // Row index -> blob base pointer.  Stride 1024 = 2^10 so `shl rax, 10`
  // suffices.  Caller validates row_idx < WA_POOL_MAX.  Pure leaf.
  // Labels prefixed wa_bb_.
  // ==========================================================================
  pub let _wasi_args_blob_base : (u64) -> u64 !{} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): row_idx -> &_wasi_args_blobs[row_idx*1024]. Power-of-two stride (shl rax, 10). Pure leaf -- no pushes. Labels prefixed wa_bb_.",
      block: {
        mov rax, rdi;                    // row_idx
        shl rax, 10;                     // row_idx * 1024
        lea r10, [rip + _wasi_args_blobs];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_find_row(pid) -> row_idx | WA_ID_NONE
  //
  // Linear scan _wasi_args_pool[0..WA_POOL_MAX) for the first row whose
  // in_use (word at [+112]) is 1 AND pid (word at [+0]) matches rdi.
  // Return row_idx in [0, 8) on hit, WA_ID_NONE (0xFF) on miss.  pid==0
  // can never match a live row because _wasi_args_register refuses pid==0
  // at mint time with WASI_EINVAL.  Pure leaf -- no pushes, no nested
  // calls.  Labels prefixed wa_fr_.  Shape mirror of _jail_supervisor_
  // lookup.
  // ==========================================================================
  pub let _wasi_args_find_row : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): linear scan _wasi_args_pool[0..WA_POOL_MAX) for the first row whose in_use (word at [+112]) is 1 AND pid (word at [+0]) matches rdi. Return row_idx (0..7) or WA_ID_NONE (0xFF) on miss. pid==0 can never match a live row because _wasi_args_register refuses pid==0 at mint time. Inlined row-base (shl 7). Pure leaf -- no callee-save pushes, no nested calls. Labels prefixed wa_fr_. Mirrors _jail_supervisor_lookup.",
      block: {
        lea r10, [rip + _wasi_args_pool];
        xor rcx, rcx;                    // row_idx cursor
      wa_fr_scan:
        cmp rcx, 8;                      // WA_POOL_MAX
        jae wa_fr_none;

        mov rax, rcx;
        shl rax, 7;                      // row_idx * 128
        add rax, r10;                    // row base

        // Row must be in_use.
        mov r11, [rax + 112];
        cmp r11, 0;
        je  wa_fr_next;

        // pid must match.
        mov r11, [rax + 0];
        cmp r11, rdi;
        je  wa_fr_hit;

      wa_fr_next:
        add rcx, 1;
        jmp wa_fr_scan;

      wa_fr_hit:
        mov rax, rcx;
        ret;

      wa_fr_none:
        mov rax, 0xFF;                   // WA_ID_NONE
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_find_free() -> row_idx | WA_ID_NONE
  //
  // Linear scan for the first row whose in_use field is zero.  Used only
  // by _wasi_args_register when no existing row for the pid is found.
  // Pure leaf (row-base is inlined).  Labels prefixed wa_ff_.
  // ==========================================================================
  pub let _wasi_args_find_free : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): linear scan _wasi_args_pool[0..WA_POOL_MAX) for the first row whose in_use (word at [+112]) is zero. Return row_idx or WA_ID_NONE (0xFF). Inlined row-base (shl 7). Pure leaf -- no pushes. Labels prefixed wa_ff_. Mirrors js_find_free.",
      block: {
        lea r10, [rip + _wasi_args_pool];
        xor rcx, rcx;                    // row_idx cursor
      wa_ff_scan:
        cmp rcx, 8;                      // WA_POOL_MAX
        jae wa_ff_none;

        mov rax, rcx;
        shl rax, 7;                      // row_idx * 128
        add rax, r10;                    // row base
        mov r11, [rax + 112];            // in_use
        cmp r11, 0;
        je  wa_ff_hit;

        add rcx, 1;
        jmp wa_ff_scan;

      wa_ff_hit:
        mov rax, rcx;
        ret;

      wa_ff_none:
        mov rax, 0xFF;                   // WA_ID_NONE
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_register(pid, blob_ptr, blob_len) -> errno
  //
  // Mint (or replace) a side-table row owning a copy of
  // [blob_ptr .. blob_ptr + blob_len).
  //
  // ARGS (SysV):
  //   rdi = pid                 (must be non-zero)
  //   rsi = blob_ptr            (kernel pointer; readable up to blob_len
  //                              bytes)
  //   rdx = blob_len            (<= WA_BLOB_MAX = 1024)
  //
  // RETURNS (rax):
  //   WASI_OK      -- row registered or replaced
  //   WASI_EINVAL  -- pid == 0
  //   WASI_ENOMEM  -- blob_len > WA_BLOB_MAX, or pool full
  //
  // STEP-BY-STEP:
  //   1. pid != 0 -> else WASI_EINVAL.
  //   2. blob_len <= WA_BLOB_MAX -> else WASI_ENOMEM.
  //   3. _wasi_args_find_row(pid) -> row_idx.  If WA_ID_NONE,
  //      _wasi_args_find_free() -> row_idx.  If still WA_ID_NONE,
  //      -> WASI_ENOMEM.
  //   4. Compute row_base (shl 7) and blob_base (shl 10).
  //   5. Byte-copy blob_len bytes from blob_ptr into blob_base.
  //   6. Scan the copied blob: argc = count of NUL bytes.
  //   7. Write fixed fields: pid, blob_len, argc, argv_buf_size=blob_len.
  //   8. Write in_use=1 LAST so a concurrent scanner either sees FREE or
  //      fully-initialised.
  //   9. Return WASI_OK.
  //
  // STACK FRAME:
  //   3 callee-save pushes (rbx=pid, r12=blob_ptr, r13=blob_len).  Entry
  //   rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 -> new rsp%16==0 at
  //   nested calls (odd # of pushes puts us back on 16-byte alignment).
  //   Nested calls: _wasi_args_find_row, _wasi_args_find_free.
  //
  // REGISTER MAP:
  //   rbx = pid                 (held across every nested call)
  //   r12 = blob_ptr            (source address)
  //   r13 = blob_len            (byte count; also written to row[+8])
  //   r14 = row_base            (destination row pointer; after step 4)
  //   r15 = blob_base           (destination blob pointer; after step 4)
  //
  //   -- but r14/r15 are not callee-save'd here (no further nested calls
  //      after step 4) so we reuse r10/r11 instead to keep the push count
  //      at 3.
  //
  // Labels prefixed wa_rg_.
  // ==========================================================================
  pub let _wasi_args_register : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): register (or replace) a WASI argv blob for pid. Validate pid != 0 (WASI_EINVAL), blob_len <= WA_BLOB_MAX=1024 (WASI_ENOMEM), find-or-allocate a row (WASI_ENOMEM on pool full), byte-copy blob_ptr into the row's slice of _wasi_args_blobs, scan for NUL count (= argc), write fixed fields pid/blob_len/argc/argv_buf_size, set in_use=1 LAST so a concurrent scanner sees FREE or fully-initialised. Three callee-save pushes (rbx=pid, r12=blob_ptr, r13=blob_len). Entry rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 -> new rsp%16==0 at every nested call (odd # of pushes puts us back on 16-byte alignment). Nested calls: _wasi_args_find_row, _wasi_args_find_free. After allocation, no more nested calls -- r10/r11 scratch suffices for row_base and blob_base. Byte copy uses mov_b scalar-indexed addressing proven in jail_supervisor.pdx js_cr_name_loop. Encoder-pitfall posture: cmp rN, 0 (never test), shl rN, 7 for stride-128 (never imul), shl rN, 10 for stride-1024, mov rax, imm32 for all WASI codes. Labels prefixed wa_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // pid
        mov r12, rsi;                    // blob_ptr
        mov r13, rdx;                    // blob_len

        // ---- Step 1: pid != 0 ----
        cmp rbx, 0;
        je  wa_rg_bad_pid;

        // ---- Step 2: blob_len <= WA_BLOB_MAX ----
        mov r11, 1024;                   // WA_BLOB_MAX
        cmp r13, r11;
        ja  wa_rg_nomem;

        // ---- Step 3a: find existing row ----
        mov rdi, rbx;
        call _wasi_args_find_row;
        mov r11, 0xFF;                   // WA_ID_NONE
        cmp rax, r11;
        jne wa_rg_have_row;              // reuse existing

        // ---- Step 3b: find free row ----
        call _wasi_args_find_free;
        mov r11, 0xFF;
        cmp rax, r11;
        je  wa_rg_nomem;

      wa_rg_have_row:
        // rax = row_idx.  Compute row_base in r10, blob_base in r11.
        mov r10, rax;
        shl r10, 7;                      // row_idx * 128
        lea r9,  [rip + _wasi_args_pool];
        add r10, r9;                     // r10 = row_base

        mov r11, rax;
        shl r11, 10;                     // row_idx * 1024
        lea r9,  [rip + _wasi_args_blobs];
        add r11, r9;                     // r11 = blob_base

        // ---- Step 5: byte-copy blob_len bytes from r12 (src) to r11 (dst) ----
        // Loop i = 0 .. r13.  mov_b indexed byte load/store.
        xor rcx, rcx;                    // i = 0
      wa_rg_copy:
        cmp rcx, r13;
        jae wa_rg_copy_done;

        xor rax, rax;
        mov_b rax, [r12 + rcx * 1];      // src byte
        mov_b [r11 + rcx * 1], rax;      // dst byte at blob[i]
        add rcx, 1;
        jmp wa_rg_copy;

      wa_rg_copy_done:
        // ---- Step 6: scan the copied blob for NUL bytes (argc) ----
        // r11 still holds blob_base, r13 still holds blob_len.  r9 = argc.
        xor rcx, rcx;                    // i = 0
        xor r9,  r9;                     // argc = 0
      wa_rg_scan:
        cmp rcx, r13;
        jae wa_rg_scan_done;

        xor rax, rax;
        mov_b rax, [r11 + rcx * 1];
        cmp rax, 0;
        jne wa_rg_scan_next;
        add r9, 1;                       // NUL -> argc++
      wa_rg_scan_next:
        add rcx, 1;
        jmp wa_rg_scan;

      wa_rg_scan_done:
        // ---- Step 7: write fixed fields on the row ----
        // r10 = row_base, rbx = pid, r13 = blob_len, r9 = argc.
        mov [r10 + 0],   rbx;            // pid
        mov [r10 + 8],   r13;            // blob_len
        mov [r10 + 16],  r9;             // argc
        mov [r10 + 24],  r13;            // argv_buf_size (== blob_len)

        // ---- Step 8: in_use = 1 LAST ----
        mov r9, 1;
        mov [r10 + 112], r9;

        // ---- Step 9: WASI_OK ----
        xor rax, rax;
        jmp wa_rg_out;

      wa_rg_bad_pid:
        mov rax, 0x1C;                   // WASI_EINVAL
        jmp wa_rg_out;

      wa_rg_nomem:
        mov rax, 0x30;                   // WASI_ENOMEM

      wa_rg_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_sizes_get(pid, argc_out_ptr, argv_buf_size_out_ptr) -> errno
  //
  // Query the sizes a WASI module needs to allocate for its argv buffer.
  //
  // ARGS (SysV):
  //   rdi = pid
  //   rsi = argc_out_ptr            (writable u64 destination)
  //   rdx = argv_buf_size_out_ptr   (writable u64 destination)
  //
  // RETURNS (rax):
  //   WASI_OK      -- sizes written
  //   WASI_EBADF   -- pid not registered
  //   WASI_EINVAL  -- argc_out_ptr == 0 or argv_buf_size_out_ptr == 0
  //
  // STEP-BY-STEP:
  //   1. _wasi_args_find_row(pid).  WA_ID_NONE -> WASI_EBADF.
  //   2. argc_out_ptr != 0 and argv_buf_size_out_ptr != 0 -> else WASI_EINVAL.
  //   3. row_base = row_idx * 128 + pool.
  //      *argc_out_ptr          = row[+16] (argc)
  //      *argv_buf_size_out_ptr = row[+24] (argv_buf_size)
  //   4. Return WASI_OK.
  //
  // STACK FRAME:
  //   3 callee-save pushes (rbx=pid, r12=argc_out_ptr, r13=argv_buf_size_
  //   out_ptr).  The output-pointer registers are saved because the
  //   SysV caller-save rsi/rdx do NOT survive the nested _wasi_args_find_
  //   row call.  Entry rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 ->
  //   new rsp%16==0 at the nested call (odd # of pushes puts us back on
  //   16-byte alignment).  Labels prefixed wa_sz_.
  // ==========================================================================
  pub let _wasi_args_sizes_get : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (argc_out_ptr: u64) (argv_buf_size_out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): WASI args_sizes_get stub. Lookup row for pid; miss -> WASI_EBADF (pid-not-registered overload per design doc §5). Validate argc_out_ptr != 0 and argv_buf_size_out_ptr != 0 -> else WASI_EINVAL. Load row.argc (+16) and row.argv_buf_size (+24); store at the destination pointers. Return WASI_OK. Register map: rbx=pid (held across the find_row call), r12=argc_out_ptr, r13=argv_buf_size_out_ptr (both saved pre-call because the SysV caller-save regs rsi/rdx do not survive the nested call). Three callee-save pushes. Entry rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 -> new rsp%16==0 at the nested call (odd # of pushes puts us back on 16-byte alignment). Encoder posture: cmp rN,0 (never test), shl rN,7 (never imul), mov rax,imm32 for WASI codes. Labels prefixed wa_sz_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // pid
        mov r12, rsi;                    // argc_out_ptr
        mov r13, rdx;                    // argv_buf_size_out_ptr

        // ---- Step 1: lookup row ----
        mov rdi, rbx;
        call _wasi_args_find_row;
        mov r11, 0xFF;                   // WA_ID_NONE
        cmp rax, r11;
        je  wa_sz_badf;

        // rax = row_idx (0..7).  Compute row_base in r10.
        mov r10, rax;
        shl r10, 7;                      // row_idx * 128
        lea r11, [rip + _wasi_args_pool];
        add r10, r11;                    // r10 = row_base

        // ---- Step 2: validate output pointers ----
        cmp r12, 0;
        je  wa_sz_inval;
        cmp r13, 0;
        je  wa_sz_inval;

        // ---- Step 3: write sizes ----
        mov r11, [r10 + 16];             // argc
        mov [r12 + 0], r11;              // *argc_out_ptr = argc

        mov r11, [r10 + 24];             // argv_buf_size
        mov [r13 + 0], r11;              // *argv_buf_size_out_ptr = argv_buf_size

        // ---- Step 4: WASI_OK ----
        xor rax, rax;
        jmp wa_sz_out;

      wa_sz_badf:
        mov rax, 0x08;                   // WASI_EBADF
        jmp wa_sz_out;

      wa_sz_inval:
        mov rax, 0x1C;                   // WASI_EINVAL

      wa_sz_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _wasi_args_get(pid, argv_out_ptr, argv_buf_out_ptr) -> errno
  //
  // Fill the WASI module's argv-pointer array and argv-string buffer.
  //
  // ARGS (SysV):
  //   rdi = pid
  //   rsi = argv_out_ptr      (writable *mut *mut u8 array of argc entries)
  //   rdx = argv_buf_out_ptr  (writable u8 buffer of argv_buf_size bytes)
  //
  // RETURNS (rax):
  //   WASI_OK      -- argv array and buffer filled
  //   WASI_EBADF   -- pid not registered
  //   WASI_EINVAL  -- argv_out_ptr == 0 or argv_buf_out_ptr == 0
  //
  // STEP-BY-STEP:
  //   1. _wasi_args_find_row(pid).  WA_ID_NONE -> WASI_EBADF.
  //   2. argv_out_ptr != 0 and argv_buf_out_ptr != 0 -> else WASI_EINVAL.
  //   3. Load row_base; blob_base = row_idx * 1024 + _wasi_args_blobs;
  //      blob_len = row[+8]; argc = row[+16].
  //   4. argv_out[0] = argv_buf_out_ptr + 0 (always, when argc > 0).
  //      Byte-copy blob_base[i] -> argv_buf_out[i] for i in [0..blob_len).
  //      When src byte is NUL and (i+1 < blob_len), set
  //          argv_out[k++] = argv_buf_out_ptr + i + 1
  //      stopping at k == argc.
  //   5. Return WASI_OK.
  //
  // At M3 argv_out_ptr and argv_buf_out_ptr are KERNEL pointers (the only
  // callers are kernel-side witnesses).  M4 adds the ring-3 wiring: the
  // dispatch layer translates WASM-space pointers to kernel pointers.
  //
  // STACK FRAME:
  //   4 callee-save pushes (rbx=pid, r12=argv_out, r13=argv_buf_out,
  //   r14=row_base) + sub rsp,8 (alignment).  Entry rsp%16==8; +4 pushes
  //   = +32 -> %16==8 (odd!); sub rsp,8 = +40 -> %16==0.  Nested call:
  //   _wasi_args_find_row.  Labels prefixed wa_gt_.
  // ==========================================================================
  pub let _wasi_args_get : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (argv_out_ptr: u64) (argv_buf_out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): WASI args_get stub. Lookup row for pid; miss -> WASI_EBADF. Validate argv_out_ptr != 0 and argv_buf_out_ptr != 0 -> else WASI_EINVAL. Byte-copy blob to argv_buf_out and populate argv_out pointers as we walk the buffer: argv_out[0] at offset 0 (if argc>0), argv_out[k++] at offset (i+1) after each NUL (while k<argc and i+1<blob_len). Four callee-save pushes (rbx=pid, r12=argv_out_ptr, r13=argv_buf_out_ptr, r14=row_base after lookup) + sub rsp,8 (alignment). Entry rsp%16==8; +4 pushes = +32 -> %16==8 odd; sub rsp,8 = +40 -> %16==0 at the one nested call. After find_row returns, no further nested calls occur -- the inner loop uses only r9/r10/r11/rax/rcx scratch. Encoder posture: cmp rN,0 (never test), shl rN,7 and shl rN,10 (never imul), mov rax,imm32 for WASI codes. mov_b indexed byte copy proven in jail_supervisor.pdx. Labels prefixed wa_gt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // pid
        mov r12, rsi;                    // argv_out_ptr
        mov r13, rdx;                    // argv_buf_out_ptr

        // ---- Step 1: lookup row ----
        mov rdi, rbx;
        call _wasi_args_find_row;
        mov r11, 0xFF;                   // WA_ID_NONE
        cmp rax, r11;
        je  wa_gt_badf;

        // rax = row_idx.  Compute row_base in r14.
        mov r14, rax;
        shl r14, 7;                      // row_idx * 128
        lea r11, [rip + _wasi_args_pool];
        add r14, r11;                    // r14 = row_base

        // ---- Step 2: validate output pointers ----
        cmp r12, 0;
        je  wa_gt_inval;
        cmp r13, 0;
        je  wa_gt_inval;

        // ---- Step 3: load blob_base, blob_len, argc ----
        // Recompute blob_base from r14 (= pool_base + row_idx*128).
        // Algebra: (r14 - pool_base) << 3 = (row_idx * 128) << 3
        //        = row_idx * 1024 = offset into _wasi_args_blobs.
        // So shl 3 (not shr 7 + shl 10) is the one-shift form.
        mov r10, r14;
        lea r11, [rip + _wasi_args_pool];
        sub r10, r11;                    // row_idx * 128
        shl r10, 3;                      // row_idx * 1024
        lea r11, [rip + _wasi_args_blobs];
        add r10, r11;                    // r10 = blob_base

        mov r11, [r14 + 8];              // r11 = blob_len
        mov r9,  [r14 + 16];             // r9  = argc

        // ---- Step 4a: write argv_out[0] if argc > 0 ----
        cmp r9, 0;
        je  wa_gt_done;                  // argc==0: nothing to walk

        // argv_out[0] = argv_buf_out_ptr + 0
        mov [r12 + 0], r13;

        // ---- Step 4b: copy blob + populate argv_out[1..argc] ----
        //   rcx = i (byte index into blob)
        //   rax = scratch byte / argv pointer
        //   r8  = k (argv index already written; starts at 1 since argv[0] is set)
        //   r10 = blob_base (src)
        //   r11 = blob_len
        //   r9  = argc
        //   r12 = argv_out_ptr (dst array)
        //   r13 = argv_buf_out_ptr (dst buffer base)
        xor rcx, rcx;                    // i = 0
        mov r8,  1;                      // k = 1 (argv[0] already written)
      wa_gt_loop:
        cmp rcx, r11;
        jae wa_gt_done;

        xor rax, rax;
        mov_b rax, [r10 + rcx * 1];      // src byte
        mov_b [r13 + rcx * 1], rax;      // dst byte

        // If byte is non-NUL, nothing more to do this iteration.
        cmp rax, 0;
        jne wa_gt_loop_next;

        // Byte is NUL.  Check if we have more argv slots to fill AND more
        // bytes remain (i+1 < blob_len).
        cmp r8, r9;
        jae wa_gt_loop_next;             // k == argc: no more slots

        mov rax, rcx;
        add rax, 1;
        cmp rax, r11;
        jae wa_gt_loop_next;             // i+1 == blob_len: trailing NUL,
                                         // no next arg

        // argv_out[k] = argv_buf_out_ptr + i + 1
        mov rax, r13;
        add rax, rcx;
        add rax, 1;
        // Store at argv_out[k].  Address = r12 + k*8.
        mov r9, r8;                      // reuse r9 as scratch (will reload argc below)
        shl r9, 3;                       // k * 8
        add r9, r12;                     // &argv_out[k]
        mov [r9 + 0], rax;

        // Reload argc into r9 (we clobbered it as address scratch).
        mov r9, [r14 + 16];
        add r8, 1;                       // k++

      wa_gt_loop_next:
        add rcx, 1;
        jmp wa_gt_loop;

      wa_gt_done:
        // ---- Step 5: WASI_OK ----
        xor rax, rax;
        jmp wa_gt_out;

      wa_gt_badf:
        mov rax, 0x08;                   // WASI_EBADF
        jmp wa_gt_out;

      wa_gt_inval:
        mov rax, 0x1C;                   // WASI_EINVAL

      wa_gt_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _wasi_stdin_read(pid, iovs_ptr, iovs_len, nread_out_ptr) -> errno
  //
  // M3 STUB.  Reads from the jailed task's stdin into a WASI iovec array.
  //
  // ARGS (SysV):
  //   rdi = pid
  //   rsi = iovs_ptr        (unused at M3; the iovec array pointer; M5 uses)
  //   rdx = iovs_len        (unused at M3; iovec count; M5 uses)
  //   rcx = nread_out_ptr   (writable u64 destination for bytes-read sum)
  //
  // RETURNS (rax):
  //   WASI_OK      -- sum of iovec reads (0 at M3; clean EOF stub)
  //   WASI_EBADF   -- pid not registered
  //   WASI_EINVAL  -- nread_out_ptr == 0
  //
  // STEP-BY-STEP:
  //   1. _wasi_args_find_row(pid).  WA_ID_NONE -> WASI_EBADF.
  //      (Registration gate -- a jail that never had its argv registered
  //      cannot read stdin either.  Shared gate matches the "both argv
  //      and stdin live on the same jail-side table" posture; M5 may
  //      split into a separate fd-registration table.)
  //   2. nread_out_ptr != 0 -> else WASI_EINVAL.
  //   3. *nread_out_ptr = 0 (clean EOF stub).
  //   4. Return WASI_OK.
  //
  // M5 replaces step 3 with: resolve pid's task row via a new
  // task_lookup_by_pid helper, decode fd_table[0]'s vnode index, iterate
  // iovec entries, dispatch to vfs_read for each, sum into *nread_out_ptr.
  //
  // STACK FRAME:
  //   2 callee-save pushes (rbx=pid, r12=nread_out_ptr).  Entry rsp%16==8;
  //   +2 pushes = +16 -> %16==8 odd at nested call -- fix with sub rsp,8
  //   held throughout.  Labels prefixed wa_rd_.
  // ==========================================================================
  pub let _wasi_stdin_read : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (iovs_ptr: u64) (iovs_len: u64) (nread_out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M3 (paideia-os #2628): WASI fd_read(0, ...) STUB. Lookup row for pid; miss -> WASI_EBADF (registration gate shared with argv_* for M3). Validate nread_out_ptr != 0 -> else WASI_EINVAL. Write *nread_out_ptr = 0 (clean EOF). Return WASI_OK. iovs_ptr and iovs_len are ignored at M3; M5 iterates them, resolves pid's fd_table[0] to a vnode, and dispatches vfs_read per iovec. Two callee-save pushes (rbx=pid, r12=nread_out_ptr) + sub rsp,8 (alignment held throughout; nested call _wasi_args_find_row sees rsp%16==0). Entry rsp%16==8; +2 pushes = +16 -> %16==8; sub rsp,8 = +24 -> %16==0. Encoder posture: cmp rN,0 (never test), mov rax,imm32 for WASI codes. Labels prefixed wa_rd_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // pid
        mov r12, rcx;                    // nread_out_ptr (rsi/rdx ignored at M3)

        // ---- Step 1: registration gate ----
        mov rdi, rbx;
        call _wasi_args_find_row;
        mov r11, 0xFF;                   // WA_ID_NONE
        cmp rax, r11;
        je  wa_rd_badf;

        // ---- Step 2: validate nread_out_ptr ----
        cmp r12, 0;
        je  wa_rd_inval;

        // ---- Step 3: clean EOF stub ----
        xor rax, rax;
        mov [r12 + 0], rax;              // *nread_out_ptr = 0

        // ---- Step 4: WASI_OK (rax already zero) ----
        jmp wa_rd_out;

      wa_rd_badf:
        mov rax, 0x08;                   // WASI_EBADF
        jmp wa_rd_out;

      wa_rd_inval:
        mov rax, 0x1C;                   // WASI_EINVAL

      wa_rd_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
