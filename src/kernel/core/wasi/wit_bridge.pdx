// src/kernel/core/wasi/wit_bridge.pdx -- Wave UMB-W19 R135.M5
// paideia-os #2630
//
// WIT-TYPED RECORD BRIDGE SKELETON
// =============================================================================
//
// R135.M5 lands the WIT (WebAssembly Interface Types) -> paideia-os schema
// adapter.  A WASI module whose stdout emits typed records declares its
// record shape in WIT; the bridge parses the WIT text at module-load time
// and feeds the shape into R135.M4's _stdout_records_register_schema.
//
// Full design: `design/shell/wit-typed-record-bridge.md`.
//
// Companion substrates:
//   - wasi/stdout_records.pdx (R135.M4) -- the kernel-side typed-record
//     ring; the bridge calls its _stdout_records_register_schema to seat
//     the TSV field-name schema for feed-time validation.
//   - wasi/wasi_args_conv.pdx (R135.M3) -- the twin side table for WASI
//     argv / stdin; same 8-row shape, same encoder-pitfall posture.
//   - svc/jail_supervisor.pdx (R135.M1/M2) -- the eventual call site at
//     M6+ (execve hook invokes _wit_bridge_register_module after
//     caps_decl_apply).
//   - term/schema_fmt.pdx (R129.M4) -- downstream consumer whose
//     SF_TYPE_U64/I64/STR codes the bridge emits in each WB_FIELD_DESC.
//
// =============================================================================
// SECTION 0  WHY A WIT BRIDGE AT ALL
// =============================================================================
//
// WASI modules declare their component-model interface in WIT; the typed-
// record pipeline wants an SF_TYPE_* code per field.  Rather than force the
// WASI module to emit a redundant TSV schema header on stdout at startup
// (which stdout_records.register_schema would consume), the bridge reads
// the WIT text once at load time and feeds both:
//   1) the per-field type ladder (SF_TYPE_U64/I64/STR) for future
//      schema_fmt wiring, as a sequence of WB_FIELD_DESC entries;
//   2) the TSV field-name schema expected by _stdout_records_register_schema.
//
// Side-table pattern mirrors wasi_args_conv.pdx / stdout_records.pdx:
// scratch buffers only, no per-pid state (the state lives on the ring row
// that register_schema allocates).
//
// =============================================================================
// SECTION 1  WB_FIELD_DESC LAYOUT  --  32 BYTES PER FIELD
// =============================================================================
//
// Stride 32 is a power of two so descriptor addressing uses `shl rax, 5` --
// no imul (feedback_pdx_encoder_pitfalls: 2-op `imul r, imm` is an encoder
// gap).  Width-32 lines up with SF_FIELD_DESC_BYTES so a later milestone
// can swap to schema_fmt's layout with a byte-copy + name-arena fixup.
//
//   [+0]    field_type    (u8)   SF_TYPE_END (0) | SF_TYPE_U64 (1) |
//                                 SF_TYPE_I64 (2) | SF_TYPE_STR (3)
//   [+1]    name_len      (u8)   0 .. WB_NAME_MAX = 30
//   [+2..+31] name_inline (30 B) ASCII field name, zero-padded.
//                                 SF_TYPE_END entries carry zeros here.
//
// =============================================================================
// SECTION 2  WIT -> SF_TYPE_* MAPPING (M5 SUBSET)
// =============================================================================
//
//   bool                    -> SF_TYPE_U64 (0/1 decimal)
//   u8, u16, u32, u64       -> SF_TYPE_U64
//   s8, s16, s32, s64       -> SF_TYPE_I64
//   i8, i16, i32, i64       -> SF_TYPE_I64  (C-flavoured alias)
//   char                    -> SF_TYPE_STR
//   string                  -> SF_TYPE_STR
//
// Deferred to M6+: variant, enum, flags, list<T>, tuple, option<T>,
// result<T,E>, resource, nested record, interface wrapping, comments.
//
// =============================================================================
// SECTION 3  RETURN CODE BAND  --  0x1C00..0x1Cff
// =============================================================================
//
//   WB_OK                   = 0
//   WB_ERR_PARSE            = 0x1C00
//   WB_ERR_UNSUPPORTED_TYPE = 0x1C01   (variant / list / flags / enum /
//                                       resource / comment / interface
//                                       keyword at M5)
//   WB_ERR_OUT_TOO_SMALL    = 0x1C02   (out_schema_cap exhausted)
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the 7-byte
// zero-extending form (never `and r11, imm64`).  register_module
// propagates SR_* codes from _stdout_records_register_schema unchanged.
//
// =============================================================================
// SECTION 4  PACKED RETURN DISCIPLINE  --  parse_type_decl
// =============================================================================
//
// `_wit_bridge_parse_type_decl` returns a packed u64:
//
//   bits [63..32] = bytes_written (0 on failure, (N+1)*32 on success)
//   bits [31.. 0] = status (one of WB_* codes)
//
// Caller unpacks via `(ret >> 32)` for the length and `(ret & 0xFFFFFFFF)`
// for the status.  Non-zero status always comes with bytes_written == 0 at
// M5 (no partial writes retained; caller resizes and retries).
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// Labels prefixed `wb_` to stay clear of `sr_` (stdout_records),
// `wa_` (wasi_args), `js_` (jail_supervisor), `sf_` (schema_fmt),
// `at_` (ansi256-table), `ss_` (shell_session), `cmnt_` (cap_minter),
// `ks_` (kind_shell_session), `sh_` (shell_history).  No reserved
// paideia-as keyword overlap (reserved: loop / if / let / fn / else /
// match / module / structure).  Encoder-pitfall posture:
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * cmp rN, imm32        (bit 31 clear for every ASCII literal)
//   * shl rN, 5            (stride-32 descriptor base; never `imul`)
//   * shl rax, 32          (packed-return hi half; imm8 operand)
//   * shl rN, 32 / shr rN, 32  (zero-extending low-32 extract)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * single-line `pub let name : T = ...`
//   * module basename WitBridge matches wit_bridge.pdx (ddc requires
//     exact match)
//   * no fingerprint tags at M5 -- the module has no boot bringup, no
//     allowlist entry, no klog surface; M6 execve hook will emit
//     `wit convert ok kind=<n>` when register_module becomes reachable.
//
// Stack discipline (SysV, entry rsp%16==8):
//
//   _wb_classify_type              0 pushes (pure leaf, ladder of byte
//                                            compares; no nested calls)
//   _wit_bridge_parse_type_decl    6 pushes + sub rsp, 8
//                                   (rbx=bytes_ptr, r12=bytes_len,
//                                    r13=out_ptr,   r14=out_cap,
//                                    r15=i_cursor,  rbp=fields_written;
//                                    even -> needs rsp,8 pad to realign.
//                                    Nested: _wb_classify_type.  Two
//                                    inner pushes (r10, r11) bracket
//                                    that call site to preserve
//                                    name_off/name_len across the
//                                    caller-save clobber window.)
//   _wit_bridge_register_module    3 pushes
//                                   (rbx=pid, r12=wit_ptr, r13=wit_len;
//                                    odd -> aligned at nested calls to
//                                    _wit_bridge_parse_type_decl and
//                                    _stdout_records_register_schema.)
//
// =============================================================================

module WitBridge = structure {

  // ==========================================================================
  // Return band (section 3)
  // ==========================================================================

  pub let WB_OK                   : u64 = 0
  pub let WB_ERR_PARSE            : u64 = 0x1C00
  pub let WB_ERR_UNSUPPORTED_TYPE : u64 = 0x1C01
  pub let WB_ERR_OUT_TOO_SMALL    : u64 = 0x1C02

  // ==========================================================================
  // SF_TYPE_* mirror constants (match schema_fmt.pdx)
  // ==========================================================================

  pub let WB_SF_TYPE_END : u64 = 0
  pub let WB_SF_TYPE_U64 : u64 = 1
  pub let WB_SF_TYPE_I64 : u64 = 2
  pub let WB_SF_TYPE_STR : u64 = 3

  // ==========================================================================
  // Dimension + layout constants (section 1)
  // ==========================================================================

  pub let WB_FIELD_DESC_BYTES : u64 = 32
  pub let WB_NAME_MAX         : u64 = 30
  pub let WB_MAX_FIELDS       : u64 = 32
  pub let WB_SCRATCH_MAX      : u64 = 1056   // (WB_MAX_FIELDS+1) * 32
  pub let WB_TSV_MAX          : u64 = 256    // SR_SCHEMA_MAX passthrough

  // Field-descriptor offsets (bytes, from desc base)
  pub let WB_OFF_TYPE         : u64 = 0
  pub let WB_OFF_NAME_LEN     : u64 = 1
  pub let WB_OFF_NAME_INLINE  : u64 = 2

  // Sentinel for _wb_classify_type's "not an M5-known type" return.
  pub let WB_CT_UNKNOWN : u64 = 0xFF

  // ==========================================================================
  // Storage
  //
  //   _wit_bridge_desc_scratch -- 1056 bytes = 33 * 32 (32 fields + END
  //                               terminator).  @align(32) matches the
  //                               descriptor stride; register_module is the
  //                               only writer and runs under the kernel
  //                               syscall lock (non-reentrant).
  //   _wit_bridge_tsv_scratch  -- 256 bytes = SR_SCHEMA_MAX.  @align(64)
  //                               puts it on a cache-line boundary matching
  //                               stdout_records' _stdout_records_schemas.
  //
  // .bss zero-init suffices; both scratches are rewritten in full on every
  // register_module call.
  // ==========================================================================

  pub let mut _wit_bridge_desc_scratch : [u8; 1056] = uninit @align(32)
  pub let mut _wit_bridge_tsv_scratch  : [u8;  256] = uninit @align(64)

  // ==========================================================================
  // _wb_classify_type(ident_ptr, ident_len) -> u64
  //
  // Classify a WIT type-keyword ident against the M5-known names.  Returns
  // SF_TYPE_U64 (1), SF_TYPE_I64 (2), SF_TYPE_STR (3), or WB_CT_UNKNOWN
  // (0xFF) on any other ident.
  //
  // ARGS (SysV):  rdi = ident_ptr, rsi = ident_len
  // RETURNS (rax): 1 / 2 / 3 / 0xFF
  //
  // Dispatch is length-switched: branch on `ident_len` first, then compare
  // the exact literal bytes.  Length-2 covers u8/s8/i8.  Length-3 covers
  // u16/u32/u64/s16/s32/s64/i16/i32/i64.  Length-4 covers bool/char.
  // Length-6 covers string.  Any other length is unknown.
  //
  // Pure leaf -- no callee-save pushes, no nested calls.  Labels prefixed
  // wb_ct_.
  // ==========================================================================
  pub let _wb_classify_type : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M5 (paideia-os #2630): classify a WIT type-keyword ident against the M5-known type set (bool, char, string, u8..u64, s8..s64, i8..i64). Returns SF_TYPE_U64 (1), SF_TYPE_I64 (2), SF_TYPE_STR (3), or WB_CT_UNKNOWN (0xFF). Length-switched dispatch: branch on ident_len (rsi), then byte-compare the literal via mov_b indexed loads from rdi. Length-2 handles u8/s8/i8; length-3 handles u16/u32/u64 and s16/s32/s64/i16/i32/i64; length-4 handles bool and char; length-6 handles string. Pure leaf -- no callee-save pushes, no nested calls. Encoder: mov_b indexed load, cmp with imm32 ASCII literals (bit 31 always clear), je/jne, mov rax imm32. Labels prefixed wb_ct_.",
      block: {
        cmp rsi, 2;
        je  wb_ct_len2;
        cmp rsi, 3;
        je  wb_ct_len3;
        cmp rsi, 4;
        je  wb_ct_len4;
        cmp rsi, 6;
        je  wb_ct_len6;
        jmp wb_ct_unknown;

        // ---- length 2: u8 / s8 / i8 ----
      wb_ct_len2:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                  // 'u'
        je  wb_ct_u8;
        cmp rax, 0x73;                  // 's'
        je  wb_ct_s8;
        cmp rax, 0x69;                  // 'i'
        je  wb_ct_i8;
        jmp wb_ct_unknown;
      wb_ct_u8:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x38;                  // '8'
        jne wb_ct_unknown;
        mov rax, 1;
        ret;
      wb_ct_s8:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x38;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;
      wb_ct_i8:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x38;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;

        // ---- length 3: u16/u32/u64 and s/i prefix variants ----
      wb_ct_len3:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                  // 'u'
        je  wb_ct_u_prefix;
        cmp rax, 0x73;                  // 's'
        je  wb_ct_s_prefix;
        cmp rax, 0x69;                  // 'i'
        je  wb_ct_i_prefix;
        jmp wb_ct_unknown;

      wb_ct_u_prefix:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x31;                  // '1' (u16)
        je  wb_ct_u16;
        cmp rax, 0x33;                  // '3' (u32)
        je  wb_ct_u32;
        cmp rax, 0x36;                  // '6' (u64)
        je  wb_ct_u64;
        jmp wb_ct_unknown;
      wb_ct_u16:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x36;                  // '6'
        jne wb_ct_unknown;
        mov rax, 1;
        ret;
      wb_ct_u32:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x32;                  // '2'
        jne wb_ct_unknown;
        mov rax, 1;
        ret;
      wb_ct_u64:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                  // '4'
        jne wb_ct_unknown;
        mov rax, 1;
        ret;

      wb_ct_s_prefix:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x31;
        je  wb_ct_s16;
        cmp rax, 0x33;
        je  wb_ct_s32;
        cmp rax, 0x36;
        je  wb_ct_s64;
        jmp wb_ct_unknown;
      wb_ct_s16:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x36;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;
      wb_ct_s32:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x32;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;
      wb_ct_s64:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;

      wb_ct_i_prefix:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x31;
        je  wb_ct_i16;
        cmp rax, 0x33;
        je  wb_ct_i32;
        cmp rax, 0x36;
        je  wb_ct_i64;
        jmp wb_ct_unknown;
      wb_ct_i16:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x36;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;
      wb_ct_i32:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x32;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;
      wb_ct_i64:
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;
        jne wb_ct_unknown;
        mov rax, 2;
        ret;

        // ---- length 4: bool / char ----
      wb_ct_len4:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x62;                  // 'b'
        je  wb_ct_bool_try;
        cmp rax, 0x63;                  // 'c'
        je  wb_ct_char_try;
        jmp wb_ct_unknown;
      wb_ct_bool_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x6F;                  // 'o'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x6F;
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x6C;                  // 'l'
        jne wb_ct_unknown;
        mov rax, 1;
        ret;
      wb_ct_char_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x68;                  // 'h'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x61;                  // 'a'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x72;                  // 'r'
        jne wb_ct_unknown;
        mov rax, 3;
        ret;

        // ---- length 6: string ----
      wb_ct_len6:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x73;                  // 's'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x74;                  // 't'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x72;                  // 'r'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x69;                  // 'i'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0x6E;                  // 'n'
        jne wb_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 5];
        cmp rax, 0x67;                  // 'g'
        jne wb_ct_unknown;
        mov rax, 3;
        ret;

      wb_ct_unknown:
        mov rax, 0xFF;                  // WB_CT_UNKNOWN
        ret
      }
    }

  // ==========================================================================
  // _wit_bridge_parse_type_decl(bytes_ptr, bytes_len,
  //                             out_schema_ptr, out_schema_cap) -> packed u64
  //
  // Parse a textual WIT `record <name> { field: type, ... }` decl at
  // `bytes_ptr[0..bytes_len)` into a sequence of WB_FIELD_DESC entries at
  // `out_schema_ptr[0..out_schema_cap)`, terminated by one SF_TYPE_END
  // descriptor.  See design doc section 7 for the state machine.
  //
  // ARGS (SysV):
  //   rdi = bytes_ptr        (kernel pointer; readable to bytes_len)
  //   rsi = bytes_len
  //   rdx = out_schema_ptr   (writable; readable up to out_schema_cap)
  //   rcx = out_schema_cap
  //
  // RETURNS (rax, packed u64):
  //   bits [63..32] = bytes_written (0 on failure, (N+1)*32 on success)
  //   bits [31.. 0] = status (WB_OK | WB_ERR_PARSE | WB_ERR_UNSUPPORTED_TYPE |
  //                           WB_ERR_OUT_TOO_SMALL)
  //
  // Register map (callee-save, 6 pushes + sub rsp, 8):
  //   rbx = bytes_ptr        (preserved across the parse)
  //   r12 = bytes_len
  //   r13 = out_schema_ptr
  //   r14 = out_schema_cap
  //   r15 = i (byte cursor, 0..bytes_len)
  //   rbp = fields_written (0..WB_MAX_FIELDS)
  //
  // Scratch: rax (current byte), rcx (temp), rdx/rsi/rdi/r8/r9/r10/r11 free.
  // r10/r11 hold field name_off / name_len across the classify call and are
  // bracketed with push/pop to survive the caller-save clobber window.
  //
  // Labels prefixed wb_pt_.
  // ==========================================================================
  pub let _wit_bridge_parse_type_decl : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_schema_ptr: u64) (out_schema_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M5 (paideia-os #2630): parse WIT `record <name> { field: type, ... }` decl into WB_FIELD_DESC entries + SF_TYPE_END terminator. Returns packed u64 (bytes_written << 32) | status. State machine (design doc section 7): ws-skip -> `record` keyword -> ws -> record-name ident -> ws -> `{` -> body loop (ws -> `}` closes, else field name ident -> ws -> `:` -> ws -> type ident -> classify -> write 32-byte descriptor at out_ptr + fields_written*32 -> ws -> `,` or `}`) -> SF_TYPE_END terminator. Field-name copy and name-pad use mov_b scalar-indexed addressing proven in wasi_args_conv.pdx. Field count capped at WB_MAX_FIELDS=32, name length capped at WB_NAME_MAX=30. Each descriptor write cap-checks (fields_written+1)*32 <= out_schema_cap -> WB_ERR_OUT_TOO_SMALL. Six callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=out_ptr, r14=out_cap, r15=i, rbp=fields_written). Entry rsp%16==8; +6 pushes = +48 bytes = rsp%16==8 (6 pushes net 0 mod 16); sub rsp,8 brings rsp%16==0 at the nested _wb_classify_type call. Inner push r10/r11 + pop r11/r10 bracket that call, preserving name_off/name_len across the caller-save clobber window. Encoder posture: cmp rN,0 (never test), cmp rN,imm32 for every ASCII literal (bit 31 clear), shl rN,5 (stride-32 descriptor base; never imul), shl rax,32 (packed-return hi), mov rax,imm32 for all WB codes. Labels prefixed wb_pt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // bytes_ptr
        mov r12, rsi;                    // bytes_len
        mov r13, rdx;                    // out_schema_ptr
        mov r14, rcx;                    // out_schema_cap

        xor r15, r15;                    // i = 0
        xor rbp, rbp;                    // fields_written = 0

        // ---- Skip leading whitespace, then expect "record" ----
      wb_pt_ws_start:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_start_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_start_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_start_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_start_adv;
        jmp wb_pt_record_kw;
      wb_pt_ws_start_adv:
        add r15, 1;
        jmp wb_pt_ws_start;

      wb_pt_record_kw:
        // Need 6 bytes available for "record"
        mov rcx, r15;
        add rcx, 6;
        cmp rcx, r12;
        ja  wb_pt_parse_err;

        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x72;                  // 'r'
        jne wb_pt_parse_err;
        add r15, 1;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x65;                  // 'e'
        jne wb_pt_parse_err;
        add r15, 1;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x63;                  // 'c'
        jne wb_pt_parse_err;
        add r15, 1;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x6F;                  // 'o'
        jne wb_pt_parse_err;
        add r15, 1;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x72;                  // 'r'
        jne wb_pt_parse_err;
        add r15, 1;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x64;                  // 'd'
        jne wb_pt_parse_err;
        add r15, 1;

        // After "record", require at least one whitespace byte
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_record_sep_ok;
        cmp rax, 0x09;
        je  wb_pt_record_sep_ok;
        cmp rax, 0x0A;
        je  wb_pt_record_sep_ok;
        cmp rax, 0x0D;
        je  wb_pt_record_sep_ok;
        jmp wb_pt_parse_err;
      wb_pt_record_sep_ok:
        add r15, 1;

        // Skip ws, then scan+discard record name ident
      wb_pt_ws_name:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_name_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_name_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_name_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_name_adv;
        jmp wb_pt_rname_start;
      wb_pt_ws_name_adv:
        add r15, 1;
        jmp wb_pt_ws_name;

      wb_pt_rname_start:
        // ident-start check: '_' or letter
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x5F;                  // '_'
        je  wb_pt_rname_adv0;
        cmp rax, 0x41;
        jb  wb_pt_parse_err;
        cmp rax, 0x5A;
        jbe wb_pt_rname_adv0;
        cmp rax, 0x61;
        jb  wb_pt_parse_err;
        cmp rax, 0x7A;
        jbe wb_pt_rname_adv0;
        jmp wb_pt_parse_err;
      wb_pt_rname_adv0:
        add r15, 1;
      wb_pt_rname_loop:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x30;
        jb  wb_pt_rname_done;
        cmp rax, 0x39;
        jbe wb_pt_rname_adv;
        cmp rax, 0x41;
        jb  wb_pt_rname_sym;
        cmp rax, 0x5A;
        jbe wb_pt_rname_adv;
        cmp rax, 0x61;
        jb  wb_pt_rname_sym;
        cmp rax, 0x7A;
        jbe wb_pt_rname_adv;
        jmp wb_pt_rname_sym;
      wb_pt_rname_sym:
        cmp rax, 0x5F;                  // '_'
        je  wb_pt_rname_adv;
        cmp rax, 0x2D;                  // '-'
        je  wb_pt_rname_adv;
        jmp wb_pt_rname_done;
      wb_pt_rname_adv:
        add r15, 1;
        jmp wb_pt_rname_loop;

      wb_pt_rname_done:
        // Skip ws, expect '{'
      wb_pt_ws_lbrace:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_lbrace_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_lbrace_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_lbrace_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_lbrace_adv;
        cmp rax, 0x7B;                  // '{'
        je  wb_pt_lbrace_ok;
        jmp wb_pt_parse_err;
      wb_pt_ws_lbrace_adv:
        add r15, 1;
        jmp wb_pt_ws_lbrace;

      wb_pt_lbrace_ok:
        add r15, 1;

        // ---- Body loop ----
      wb_pt_body_loop:
      wb_pt_ws_body:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_body_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_body_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_body_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_body_adv;
        cmp rax, 0x7D;                  // '}'
        je  wb_pt_rbrace;
        jmp wb_pt_field_start;
      wb_pt_ws_body_adv:
        add r15, 1;
        jmp wb_pt_ws_body;

      wb_pt_field_start:
        // Field count cap
        cmp rbp, 32;                    // WB_MAX_FIELDS
        jae wb_pt_parse_err;

        // Save name_off in r10
        mov r10, r15;

        // Field-name ident-start check
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x5F;
        je  wb_pt_fname_adv0;
        cmp rax, 0x41;
        jb  wb_pt_parse_err;
        cmp rax, 0x5A;
        jbe wb_pt_fname_adv0;
        cmp rax, 0x61;
        jb  wb_pt_parse_err;
        cmp rax, 0x7A;
        jbe wb_pt_fname_adv0;
        jmp wb_pt_parse_err;
      wb_pt_fname_adv0:
        add r15, 1;
      wb_pt_fname_loop:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x30;
        jb  wb_pt_fname_done;
        cmp rax, 0x39;
        jbe wb_pt_fname_adv;
        cmp rax, 0x41;
        jb  wb_pt_fname_sym;
        cmp rax, 0x5A;
        jbe wb_pt_fname_adv;
        cmp rax, 0x61;
        jb  wb_pt_fname_sym;
        cmp rax, 0x7A;
        jbe wb_pt_fname_adv;
        jmp wb_pt_fname_sym;
      wb_pt_fname_sym:
        cmp rax, 0x5F;
        je  wb_pt_fname_adv;
        cmp rax, 0x2D;
        je  wb_pt_fname_adv;
        jmp wb_pt_fname_done;
      wb_pt_fname_adv:
        add r15, 1;
        jmp wb_pt_fname_loop;

      wb_pt_fname_done:
        // name_len = r15 - r10 in r11
        mov r11, r15;
        sub r11, r10;
        cmp r11, 0;
        je  wb_pt_parse_err;
        cmp r11, 30;                    // WB_NAME_MAX
        ja  wb_pt_parse_err;

        // Skip ws, expect ':'
      wb_pt_ws_colon:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_colon_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_colon_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_colon_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_colon_adv;
        cmp rax, 0x3A;                  // ':'
        je  wb_pt_colon_ok;
        jmp wb_pt_parse_err;
      wb_pt_ws_colon_adv:
        add r15, 1;
        jmp wb_pt_ws_colon;

      wb_pt_colon_ok:
        add r15, 1;

        // Skip ws, scan type ident
      wb_pt_ws_type:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_type_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_type_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_type_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_type_adv;
        jmp wb_pt_tname_start;
      wb_pt_ws_type_adv:
        add r15, 1;
        jmp wb_pt_ws_type;

      wb_pt_tname_start:
        // Type-ident start (letter only; types never begin with '_' or '-')
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x41;
        jb  wb_pt_parse_err;
        cmp rax, 0x5A;
        jbe wb_pt_tname_scan;
        cmp rax, 0x61;
        jb  wb_pt_parse_err;
        cmp rax, 0x7A;
        jbe wb_pt_tname_scan;
        jmp wb_pt_parse_err;
      wb_pt_tname_scan:
        // Save type_off in r9
        mov r9, r15;
        add r15, 1;
      wb_pt_tname_loop:
        cmp r15, r12;
        jae wb_pt_tname_done;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x30;
        jb  wb_pt_tname_done;
        cmp rax, 0x39;
        jbe wb_pt_tname_adv;
        cmp rax, 0x41;
        jb  wb_pt_tname_sym;
        cmp rax, 0x5A;
        jbe wb_pt_tname_adv;
        cmp rax, 0x61;
        jb  wb_pt_tname_sym;
        cmp rax, 0x7A;
        jbe wb_pt_tname_adv;
        jmp wb_pt_tname_sym;
      wb_pt_tname_sym:
        cmp rax, 0x5F;
        je  wb_pt_tname_adv;
        cmp rax, 0x2D;
        je  wb_pt_tname_adv;
        jmp wb_pt_tname_done;
      wb_pt_tname_adv:
        add r15, 1;
        jmp wb_pt_tname_loop;

      wb_pt_tname_done:
        // type_len = r15 - r9 in r8
        mov r8, r15;
        sub r8, r9;
        cmp r8, 0;
        je  wb_pt_parse_err;

        // Classify.  Save name_off / name_len (r10 / r11) across the call.
        push r10;
        push r11;
        lea rdi, [rbx + r9 * 1];
        mov rsi, r8;
        call _wb_classify_type;
        pop r11;
        pop r10;

        // Classify returned sf_type in rax, or 0xFF for unknown.
        mov rcx, 0xFF;
        cmp rax, rcx;
        je  wb_pt_unsupported;

        // sf_type in r9 (free since we're past type-ident scan)
        mov r9, rax;

        // Cap check: (fields_written+1) * 32 <= out_schema_cap
        mov rcx, rbp;
        add rcx, 1;
        shl rcx, 5;
        cmp rcx, r14;
        ja  wb_pt_out_too_small;

        // desc_base = out_ptr + fields_written*32 in rcx
        mov rcx, rbp;
        shl rcx, 5;
        add rcx, r13;

        // desc[0] = sf_type (byte)
        mov_b [rcx + 0], r9;
        // desc[1] = name_len (byte)
        mov_b [rcx + 1], r11;

        // name_inline copy: src = rbx + r10, dst = rcx + 2, len = r11
        lea rsi, [rbx + r10 * 1];
        lea rdx, [rcx + 2];
        xor rdi, rdi;                   // j = 0
      wb_pt_name_copy:
        cmp rdi, r11;
        jae wb_pt_name_pad;
        xor rax, rax;
        mov_b rax, [rsi + rdi * 1];
        mov_b [rdx + rdi * 1], rax;
        add rdi, 1;
        jmp wb_pt_name_copy;

      wb_pt_name_pad:
        // zero-pad name_inline[name_len .. 30)
        cmp rdi, 30;
        jae wb_pt_desc_done;
        xor rax, rax;
        mov_b [rdx + rdi * 1], rax;
        add rdi, 1;
        jmp wb_pt_name_pad;

      wb_pt_desc_done:
        // Zero the trailing 2 bytes [30 .. 32) of the descriptor
        // (desc + 30, desc + 31) to keep the row canonical.
        xor rax, rax;
        mov_b [rcx + 30], rax;
        mov_b [rcx + 31], rax;

        add rbp, 1;                     // fields_written += 1

        // Skip ws, expect ',' or '}'
      wb_pt_ws_sep:
        cmp r15, r12;
        jae wb_pt_parse_err;
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x20;
        je  wb_pt_ws_sep_adv;
        cmp rax, 0x09;
        je  wb_pt_ws_sep_adv;
        cmp rax, 0x0A;
        je  wb_pt_ws_sep_adv;
        cmp rax, 0x0D;
        je  wb_pt_ws_sep_adv;
        cmp rax, 0x2C;                  // ','
        je  wb_pt_comma;
        cmp rax, 0x7D;                  // '}'
        je  wb_pt_rbrace;
        jmp wb_pt_parse_err;
      wb_pt_ws_sep_adv:
        add r15, 1;
        jmp wb_pt_ws_sep;

      wb_pt_comma:
        add r15, 1;
        jmp wb_pt_body_loop;

      wb_pt_rbrace:
        add r15, 1;

        // Terminator: write SF_TYPE_END descriptor at out_ptr + fields_written*32
        mov rcx, rbp;
        add rcx, 1;
        shl rcx, 5;
        cmp rcx, r14;
        ja  wb_pt_out_too_small;

        mov rcx, rbp;
        shl rcx, 5;
        add rcx, r13;                    // rcx = terminator base

        // Zero 32 bytes
        xor rax, rax;
        xor rdi, rdi;
      wb_pt_end_zero:
        cmp rdi, 32;
        jae wb_pt_end_zero_done;
        mov_b [rcx + rdi * 1], rax;
        add rdi, 1;
        jmp wb_pt_end_zero;

      wb_pt_end_zero_done:
        // bytes_written = (fields_written + 1) * 32
        mov rax, rbp;
        add rax, 1;
        shl rax, 5;
        shl rax, 32;                     // (bytes_written << 32) | WB_OK
        jmp wb_pt_out;

      wb_pt_parse_err:
        mov rax, 0x1C00;                 // WB_ERR_PARSE
        jmp wb_pt_out;

      wb_pt_unsupported:
        mov rax, 0x1C01;                 // WB_ERR_UNSUPPORTED_TYPE
        jmp wb_pt_out;

      wb_pt_out_too_small:
        mov rax, 0x1C02;                 // WB_ERR_OUT_TOO_SMALL

      wb_pt_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _wit_bridge_register_module(pid, wit_type_decl_ptr, wit_type_decl_len)
  //       -> errno
  //
  // Convenience wrapper that parses the WIT decl into _wit_bridge_desc_scratch,
  // derives the TSV field-name schema in _wit_bridge_tsv_scratch, and calls
  // _stdout_records_register_schema.
  //
  // ARGS (SysV):
  //   rdi = pid
  //   rsi = wit_type_decl_ptr
  //   rdx = wit_type_decl_len
  //
  // RETURNS (rax): errno
  //   WB_OK                       -- schema registered on stdout_records
  //   WB_ERR_PARSE                -- parse failure or TSV overflow
  //                                   (SR_SCHEMA_MAX = 256 ceiling)
  //   WB_ERR_UNSUPPORTED_TYPE     -- unknown WIT type keyword
  //   WB_ERR_OUT_TOO_SMALL        -- (unreachable: scratch is sized to the
  //                                   maximum WB_MAX_FIELDS case; included
  //                                   for defence in depth)
  //   SR_ERR_BAD_PID              -- pid == 0 or stdout_records refused
  //   SR_ERR_RING_FULL            -- stdout_records pool full
  //   SR_ERR_SCHEMA_MISMATCH      -- stdout_records rejected the TSV
  //
  // STEP-BY-STEP:
  //   1. Call _wit_bridge_parse_type_decl into _wit_bridge_desc_scratch.
  //      On non-OK status, return it verbatim.
  //   2. num_fields = bytes_written / 32 - 1.
  //   3. For i in 0..num_fields:
  //        if i > 0, write '\t' into tsv_scratch; bail if tsv_len >= 256.
  //        copy desc[i].name_inline[0..name_len] into tsv_scratch; bail
  //        on tsv_len overflow.
  //   4. Call _stdout_records_register_schema(pid, tsv_scratch, tsv_len).
  //      Return its status verbatim.
  //
  // STACK FRAME:
  //   3 callee-save pushes (rbx=pid, r12=wit_ptr, r13=wit_len).
  //   Entry rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 -> new rsp%16==0
  //   at every nested call (odd # of pushes puts us back on 16-byte
  //   alignment).  Nested calls: _wit_bridge_parse_type_decl and
  //   _stdout_records_register_schema.
  //
  // Labels prefixed wb_rm_.
  // ==========================================================================
  pub let _wit_bridge_register_module : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (wit_type_decl_ptr: u64) (wit_type_decl_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R135.M5 (paideia-os #2630): convenience wrapper -- parse WIT decl into _wit_bridge_desc_scratch, build TSV field-name schema in _wit_bridge_tsv_scratch, call _stdout_records_register_schema. On parse error returns WB_ERR_* verbatim; on TSV overflow (SR_SCHEMA_MAX=256 ceiling) returns WB_ERR_PARSE; otherwise returns the SR_* status from stdout_records. Three callee-save pushes (rbx=pid, r12=wit_ptr, r13=wit_len). Entry rsp%16==8; +3 pushes = +24 bytes = +8 mod 16 -> new rsp%16==0 at every nested call (odd # of pushes puts us back on 16-byte alignment). Nested calls: _wit_bridge_parse_type_decl and _stdout_records_register_schema. Status/length unpack uses shl r11,32 / shr r11,32 (zero-extend low 32) to avoid `and r11, imm64` encoder gap. TSV loop copies each desc[i].name_inline[0..name_len] via mov_b scalar-indexed addressing proven in wasi_args_conv.pdx. Non-reentrant: both scratches are static .bss owned by the module; the eventual M6 execve hook holds the kernel syscall lock during register. Encoder posture: cmp rN,0 (never test), shl rN,5 (descriptor stride; never imul), mov rax,imm32 for all WB codes. Labels prefixed wb_rm_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // pid
        mov r12, rsi;                    // wit_ptr
        mov r13, rdx;                    // wit_len

        // ---- Step 1: parse into desc scratch ----
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + _wit_bridge_desc_scratch];
        mov rcx, 1056;                   // WB_SCRATCH_MAX
        call _wit_bridge_parse_type_decl;

        // Unpack status (low 32) and bytes_written (hi 32).
        mov r10, rax;
        shl r10, 32;
        shr r10, 32;                     // r10 = status
        mov r11, rax;
        shr r11, 32;                     // r11 = bytes_written

        cmp r10, 0;
        jne wb_rm_parse_err_return;

        // ---- Step 2: num_fields = bytes_written / 32 - 1 ----
        mov rax, r11;
        shr rax, 5;                      // bytes_written / 32 = N+1
        cmp rax, 0;
        je  wb_rm_tsv_done;              // defensive -- shouldn't happen
        sub rax, 1;                      // rax = num_fields
        mov r11, rax;                    // r11 = num_fields

        // ---- Step 3: build TSV from descriptors ----
        lea r8, [rip + _wit_bridge_desc_scratch];
        lea r9, [rip + _wit_bridge_tsv_scratch];
        xor r10, r10;                    // r10 = tsv_len
        xor rcx, rcx;                    // rcx = i

      wb_rm_tsv_loop:
        cmp rcx, r11;
        jae wb_rm_tsv_done;

        // Separator: if i > 0, write '\t'
        cmp rcx, 0;
        je  wb_rm_tsv_no_tab;
        cmp r10, 256;                    // WB_TSV_MAX
        jae wb_rm_tsv_overflow;
        mov rax, 9;                      // '\t'
        mov_b [r9 + r10 * 1], rax;
        add r10, 1;
      wb_rm_tsv_no_tab:

        // desc_base = r8 + i*32
        mov rax, rcx;
        shl rax, 5;
        add rax, r8;                     // rax = desc base

        // name_len = desc[1]
        xor rsi, rsi;
        mov_b rsi, [rax + 1];            // rsi = name_len (0..30)

        // Copy name_inline (desc[2..2+name_len]) -> tsv[r10..r10+name_len]
        lea rdx, [rax + 2];              // src = desc base + 2
        xor rdi, rdi;                    // j = 0

      wb_rm_tsv_copy:
        cmp rdi, rsi;
        jae wb_rm_tsv_copy_done;
        cmp r10, 256;
        jae wb_rm_tsv_overflow;
        xor rax, rax;
        mov_b rax, [rdx + rdi * 1];
        mov_b [r9 + r10 * 1], rax;
        add r10, 1;
        add rdi, 1;
        jmp wb_rm_tsv_copy;

      wb_rm_tsv_copy_done:
        add rcx, 1;
        jmp wb_rm_tsv_loop;

      wb_rm_tsv_done:
        // ---- Step 4: call _stdout_records_register_schema ----
        mov rdi, rbx;                    // pid
        lea rsi, [rip + _wit_bridge_tsv_scratch];
        mov rdx, r10;                    // tsv_len
        call _stdout_records_register_schema;
        // rax = SR_* status (passthrough)
        jmp wb_rm_out;

      wb_rm_tsv_overflow:
        mov rax, 0x1C00;                 // WB_ERR_PARSE (TSV too wide)
        jmp wb_rm_out;

      wb_rm_parse_err_return:
        mov rax, r10;                    // propagate WB_ERR_*

      wb_rm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
