// src/kernel/core/apic/tpr.pdx — R14b-M5-007b / #646
// LAPIC Task Priority Register (TPR) initialization
//
// Writes TPR = 0 so the LAPIC accepts interrupts of every priority
// class. Architecturally the post-INIT value is already 0 (Intel SDM
// Vol 3A §10.8.3.1), but QEMU-TCG has historically shipped LAPIC
// states where TPR is non-zero at kernel entry. Programming TPR = 0
// explicitly removes an entire class of "why won't the IPI fire"
// debug session and costs exactly one 32-bit MMIO store at boot.
//
// TPR field layout (32-bit MMIO at 0xFEE00080):
//   [7:4]  Task Priority Class (0..15) — interrupts whose vector
//          class (vec[7:4]) is <= TPR class are blocked.
//   [3:0]  Task Priority Sub-Class (unused for gating in Fixed IPIs).
//
// A vector 0xF0 IPI has priority class 0xF (bits 7:4 = 0xF). With
// TPR = 0 all classes 0..0xF are accepted.
//
// Called by kernel_main after apic_svr_enable and before pic_mask_all.
// Prereq module: LapicTimer.apic_svr_enable (SVR bit 8 set globally).
//
// Issue: #646
// Design: design/kernel/r14b-m5-646-self-ipi-runtime-delivery.md
// Predecessor design: design/kernel/r14b-m5-007b-ipi-runtime-delivery.md §3.1

module Tpr = structure {
  // LAPIC TPR MMIO offset (from 0xFEE00000).
  let LAPIC_TPR_OFFSET : u64 = 0x80
  let LAPIC_MMIO_BASE  : u64 = 0xFEE00000

  pub let apic_tpr_init : () -> () !{sysreg, mem} @{boot} = fn() -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R22-M1-002 (#845). Initialize LAPIC TPR = 0. Entry dispatch on _x2apic_active: nonzero → wrmsr IA32_X2APIC_TPR (MSR 0x808 = 0x800 + (0x80 >> 4)) with value 0. Zero → fall through to xAPIC MMIO write at 0xFEE00080 (R21 posture). Original #646 rationale: TPR[7:4] is the priority class; writing 0 opens the gate for every priority class. Architectural post-INIT value is 0, but explicit write removes any ambiguity from firmware / warm-reset paths. Encoder: mov / cmp / jne / wrmsr / xor / mov_d — all pre-existing.",
    block: {
      // R22-M1 (#845): x2APIC dispatch.
      mov rax, [rip + _x2apic_active];
      cmp rax, 0;
      jne apic_tpr_init_x2apic;

      // ---- xAPIC MMIO fallback path (R21 posture) ----
      mov rax, 0xFEE00080;
      xor rcx, rcx;
      mov_d [rax], rcx;
      ret;

    apic_tpr_init_x2apic:
      // ---- x2APIC MSR path: wrmsr(IA32_X2APIC_TPR=0x808, 0) ----
      mov rcx, 0x808;
      xor rax, rax;
      xor rdx, rdx;
      wrmsr;
      ret
    }
  }
}
