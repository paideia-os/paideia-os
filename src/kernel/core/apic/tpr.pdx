// src/kernel/core/apic/tpr.pdx — R14b-M5-007b / #646
// LAPIC Task Priority Register (TPR) initialization
//
// Writes TPR = 0 so the LAPIC accepts interrupts of every priority
// class. Architecturally the post-INIT value is already 0 (Intel SDM
// Vol 3A §10.8.3.1), but QEMU-TCG has historically shipped LAPIC
// states where TPR is non-zero at kernel entry. Programming TPR = 0
// explicitly removes an entire class of "why won't the IPI fire"
// debug session and costs exactly one 32-bit MMIO store at boot.
//
// TPR field layout (32-bit MMIO at 0xFEE00080):
//   [7:4]  Task Priority Class (0..15) — interrupts whose vector
//          class (vec[7:4]) is <= TPR class are blocked.
//   [3:0]  Task Priority Sub-Class (unused for gating in Fixed IPIs).
//
// A vector 0xF0 IPI has priority class 0xF (bits 7:4 = 0xF). With
// TPR = 0 all classes 0..0xF are accepted.
//
// Called by kernel_main after apic_svr_enable and before pic_mask_all.
// Prereq module: LapicTimer.apic_svr_enable (SVR bit 8 set globally).
//
// Issue: #646
// Design: design/kernel/r14b-m5-646-self-ipi-runtime-delivery.md
// Predecessor design: design/kernel/r14b-m5-007b-ipi-runtime-delivery.md §3.1

module Tpr = structure {
  // LAPIC TPR MMIO offset (from 0xFEE00000).
  let LAPIC_TPR_OFFSET : u64 = 0x80
  let LAPIC_MMIO_BASE  : u64 = 0xFEE00000

  pub let apic_tpr_init : () -> () !{sysreg, mem} @{boot} = fn() -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "#646 R14b-M5-007b: write LAPIC Task Priority Register MMIO 0xFEE00080 = 0. Per Intel SDM Vol 3A §10.8.3.1, TPR[7:4] is the priority class; interrupts whose vector[7:4] <= TPR[7:4] are blocked. Writing 0 opens the gate for every priority class, which is required for the vec 0xF0 (class 0xF) self-IPI witness downstream to be delivered. Architectural post-INIT value is 0, but QEMU-TCG's LAPIC emulation has been observed to ship non-zero TPR states across `-kernel` reloads; the explicit write removes that ambiguity. Uses mov_d [rax], rcx sized 32-bit store to match the established LAPIC MMIO idiom in eoi.pdx and lapic_timer.pdx and defend against a future paideia-as elaborator regression re-introducing #1251 (narrow-suffix store silently widened to 64-bit REX.W). Real hardware: this is a no-op at boot (TPR is 0 out of INIT) but stays correct post-migration to KVM and post-move to a warm-reset OS. Leaf function; no prologue/epilogue.",
    block: {
      // TPR = 0 — accept all priority classes.
      // mov_d = sized 32-bit store; LAPIC registers are strictly 32-bit
      // per SDM Vol 3A §10.4.1. Defends against paideia-as #1251-class
      // regressions that widened bare `mov [rax], ecx` to a REX.W
      // 64-bit store spilling into adjacent LAPIC slots.
      mov rax, 0xFEE00080;
      xor rcx, rcx;
      mov_d [rax], rcx;
      ret
    }
  }
}
