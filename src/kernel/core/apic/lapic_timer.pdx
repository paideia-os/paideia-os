// src/kernel/core/apic/lapic_timer.pdx — Phase 6 / R9-m2-002
// LAPIC Timer with TSC-Deadline Mode
// Issue: #357
//
// Programs the local APIC timer to use TSC-deadline mode, providing precise
// deadline-based interrupts synchronized with the CPU's Time Stamp Counter.

module LapicTimer = structure {
  // ============================================================================
  // LAPIC Timer MMIO Constants
  // ============================================================================

  // LAPIC Timer register offsets (MMIO base = 0xFEE00000).
  let LAPIC_LVT_TIMER_OFFSET : u64 = 0x320      // LVT Timer (RW)
  let LAPIC_TIMER_INIT_COUNT_OFFSET : u64 = 0x380  // Timer Initial Count (RW)
  let LAPIC_TIMER_DIV_CONFIG_OFFSET : u64 = 0x3E0  // Timer Divide Configuration (RW)
  let LAPIC_SVR_OFFSET : u64 = 0xF0             // Spurious-Interrupt-Vector Register (RW)
  let LAPIC_MMIO_BASE : u64 = 0xFEE00000

  // LVT Timer bits:
  //   [7:0]   = vector (32 for timer interrupt)
  //   [17:16] = timer mode (00 = one-shot, 01 = periodic, 10 = TSC-deadline)
  let LAPIC_TIMER_MODE_PERIODIC : u64 = 1       // 0b01 in bits 17:16
  let LAPIC_TIMER_MODE_TSC_DEADLINE : u64 = 2   // 0b10 in bits 17:16
  let LAPIC_TIMER_VECTOR : u64 = 32

  // IA32_TSC_DEADLINE MSR — write target TSC value to arm timer (TSC-deadline mode)
  let IA32_TSC_DEADLINE_MSR : u64 = 0x6E0

  // Timer Divide Configuration values (bits 3:0).
  // Divides the bus clock by 2^n. Value 0xB = divide by 1 (no division).
  let LAPIC_TIMER_DIV_1 : u64 = 0xB

  // SVR register bits:
  //   [7:0]   = spurious interrupt vector (0xFF for reserved unused vector)
  //   [8]     = APIC software enable bit (1 = enabled)
  let LAPIC_SVR_ENABLE_BIT : u64 = 0x100  // bit 8
  let LAPIC_SVR_SPURIOUS_VECTOR : u64 = 0xFF  // spurious vector

  // ============================================================================
  // LAPIC Software Enable (R11-m1-002)
  // ============================================================================
  // R11-m1-002: Enable LAPIC Spurious-Interrupt-Vector register (SVR).
  // Per Intel SDM Vol 3A §10.4.7.1, software must set bit 8 (enable) in SVR
  // to globally enable LAPIC delivery. Without this, LAPIC is disabled and
  // interrupts are not delivered (even if LVT registers are programmed).

  pub let apic_svr_enable : () -> () !{sysreg, mem} @{boot} = fn() -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md). Enable LAPIC via SVR (bit 8 set + spurious vector 0xFF = 0x1FF) using the platform-mapped xAPIC MMIO window. Fallback path composes SVR address from _xapic_mmio_va (populated at boot by platform_map_early_mmio) plus +0xF0, rather than materializing hard-coded 0xFEE000F0. Byte-identical to pre-step-4 on PVH boots (identity VA); walks a mapped kernel VA on UEFI/T14. Original R22-M1-002 (#845) + R11-m1-002 rationale preserved: Entry dispatch on _x2apic_active — nonzero → wrmsr IA32_X2APIC_SIVR (MSR 0x80F); zero → xAPIC MMIO fallback. Per SDM Vol 3A §10.4.7.1, LAPIC is globally disabled until software sets bit 8 in SVR; must be called before any interrupts are enabled (sti). Encoder: mov (rip-rel mem load) / cmp / jne / wrmsr / add r64,imm8 / mov_d — all pre-existing.",
    block: {
      // R22-M1 (#845): x2APIC dispatch.
      mov rax, [rip + _x2apic_active];
      cmp rax, 0;
      jne apic_svr_enable_x2apic;

      // ---- xAPIC MMIO fallback path (boot-mmio-mapping step 4) ----
      mov rax, [rip + _xapic_mmio_va];
      add rax, 0xF0;
      mov rcx, 0x1FF;
      mov_d [rax], rcx;
      ret;

    apic_svr_enable_x2apic:
      // ---- x2APIC MSR path: wrmsr(IA32_X2APIC_SIVR=0x80F, 0x1FF) ----
      mov rcx, 0x80F;
      mov rax, 0x1FF;
      xor rdx, rdx;
      wrmsr;
      ret
    }
  }

  // ============================================================================
  // LAPIC Timer Initialization (R10-m2-002, periodic mode fallback)
  // ============================================================================
  // R9-m2-002: TSC-deadline mode initialization (for KVM/host CPU with TSC-deadline)
  // R10-m2-002: Fallback to periodic mode for QEMU TCG (which lacks TSC-deadline support)

  // TSC-Deadline Mode (R9-m2-002): Not usable with QEMU TCG; kept for reference.
  pub let lapic_timer_init : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md). Initialize LAPIC LVT Timer for periodic mode + vector 32 (value 0x20020) using the platform-mapped xAPIC MMIO window. Fallback path composes LVT_TIMER address from _xapic_mmio_va (populated at boot by platform_map_early_mmio) plus +0x320. Original R22-M1-002 (#845) + R10-m2-002 rationale preserved: Entry dispatch on _x2apic_active — nonzero → wrmsr IA32_X2APIC_LVT_TIMER (MSR 0x832 = 0x800 + (0x320 >> 4)) with 0x20020; zero → xAPIC MMIO fallback. Bits 17:16 = 0b01 selects periodic mode; bits 7:0 = 32 = timer vector. Encoder: mov (rip-rel mem load) / cmp / jne / wrmsr / add r64,imm32 / mov_d — all pre-existing.",
    block: {
      // R22-M1 (#845): x2APIC dispatch.
      mov rax, [rip + _x2apic_active];
      cmp rax, 0;
      jne lapic_timer_init_x2apic;

      // ---- xAPIC MMIO fallback path (boot-mmio-mapping step 4) ----
      mov rax, [rip + _xapic_mmio_va];
      add rax, 0x320;
      mov rcx, 0x20020;  // (1 << 17) | 32 = 0x20020 (periodic mode)
      mov_d [rax], rcx;
      ret;

    lapic_timer_init_x2apic:
      // ---- x2APIC MSR path: wrmsr(IA32_X2APIC_LVT_TIMER=0x832, 0x20020) ----
      mov rcx, 0x832;
      mov rax, 0x20020;
      xor rdx, rdx;
      wrmsr;
      ret
    }
  }

  // Periodic mode setup: write DCR and initial count.
  pub let lapic_timer_init_periodic_count : (u64) -> () !{sysreg, mem} @{boot} =
    fn (init_count: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md). Program LAPIC divide-by-1 + initial count using the platform-mapped xAPIC MMIO window. Fallback path composes DCR and Initial-Count addresses from _xapic_mmio_va (populated at boot by platform_map_early_mmio) plus +0x3E0 / +0x380. Two independent re-loads of _xapic_mmio_va (no cross-call callee-save needed; leaf). Original R22-M1-002 (#845) + R10-m2-002 rationale preserved: Entry dispatch on _x2apic_active — nonzero → wrmsr IA32_X2APIC_DIV_CONF (MSR 0x83E) with 0xB, then wrmsr IA32_X2APIC_INIT_COUNT (MSR 0x838) with RDI; zero → xAPIC MMIO fallback. DCR = 0xB (divide by 1) is the highest-resolution timer setting; per SDM §10.5.1.1 initial count decrements every bus clock and fires vector on reaching zero. RDI preserved into both branches (SysV arg reg, caller retains ownership). Encoder: mov (rip-rel mem load) / cmp / jne / wrmsr / add r64,imm32 / mov_d / xor / shr — all pre-existing.",
      block: {
        // R22-M1 (#845): x2APIC dispatch.
        mov rax, [rip + _x2apic_active];
        cmp rax, 0;
        jne lapic_timer_init_periodic_count_x2apic;

        // ---- xAPIC MMIO fallback path (boot-mmio-mapping step 4) ----
        mov rax, [rip + _xapic_mmio_va];
        add rax, 0x3E0;
        mov rcx, 0xB;
        mov_d [rax], rcx;

        mov rax, [rip + _xapic_mmio_va];
        add rax, 0x380;
        mov rcx, rdi;
        mov_d [rax], rcx;
        ret;

      lapic_timer_init_periodic_count_x2apic:
        // ---- x2APIC MSR path ----
        // wrmsr(IA32_X2APIC_DIV_CONF=0x83E, 0xB)
        mov rcx, 0x83E;
        mov rax, 0xB;
        xor rdx, rdx;
        wrmsr;

        // wrmsr(IA32_X2APIC_INIT_COUNT=0x838, RDI)  — RDI holds initial count
        mov rcx, 0x838;
        mov rax, rdi;
        mov rdx, rdi;
        shr rdx, 32;
        wrmsr;
        ret
      }
    }

  // ============================================================================
  // LAPIC Timer Rearm (R10-m2-002 periodic no-op + R18-M5-003 #777 TSC-deadline dispatch)
  // ============================================================================
  // Per-CPU dispatch based on CB[PERCPU_OFF_LAPIC_TIMER_DEADLINE=+56]:
  //   CB[+56] == 0  → periodic mode active on this CPU (or timer not
  //                   yet armed) → return (periodic auto-reloads).
  //   CB[+56] != 0  → TSC-deadline mode active on this CPU → delegate
  //                   to TscDeadline.tsc_deadline_rearm(interval),
  //                   which advances the deadline by interval and
  //                   wrmsr's IA32_TSC_DEADLINE.
  //
  // R18-M5-003 (#777): the calling CPU's own CB is reached via
  // rdmsr IA32_GS_BASE (same idiom as ipi/vectors.pdx L82). The
  // dispatch is per-CPU: BSP stays periodic (CB[+56] == 0 until a
  // follow-up wires tsc_deadline_arm_first into kernel_main); APs
  // that later arm TSC-deadline in their AP-entry path will set
  // CB[+56] and this dispatch will re-arm on every tick.
  //
  // Caller (exceptions.pdx handle_timer) passes RDI = interval. In
  // periodic mode the value is discarded; in TSC-deadline mode it is
  // the per-tick TSC period (typically TscDeadline.TSC_TICK_PERIOD).

  pub let lapic_timer_rearm : (u64) -> () !{sysreg, mem} @{boot} = fn (interval: u64) -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R10-m2-002 + R18-M5-003 (#777): Per-CPU timer re-arm dispatcher. (1) Read this CPU's Percpu CB VA via rdmsr IA32_GS_BASE (0xC0000101) + EDX:EAX reconstruct (SDM Vol 2C §5.2.9) — same idiom used across ipi/vectors.pdx L82, sched/pick_next.pdx L119, sched/ap_bringup.pdx L120. (2) Load CB[+56] (PERCPU_OFF_LAPIC_TIMER_DEADLINE per percpu.pdx L88). Non-zero flags 'TSC-deadline mode active on this CPU' — the flag is set as a side effect of tsc_deadline_arm_first's deadline publish, so no separate init flag is needed. (3) If zero, return — periodic mode, timer LVT auto-reloads from Initial Count, no software re-arm required (matches the pre-#777 behavior). (4) If non-zero, delegate to TscDeadline.tsc_deadline_rearm with RDI (interval) passed through unchanged; the callee re-reads CB VA via its own rdmsr (accepted: two rdmsrs on the TSC-deadline path per tick — hoisting the CB VA into a caller-save reg across the call would require establishing r8 as a shared contract with TscDeadline, and paideia-as's cross-module ABI does not model callee-save extensions today). The delegation is a plain SysV call — sub rsp, 8 / add rsp, 8 around it keeps rsp % 16 == 0 across the call boundary (function entry rsp % 16 == 8 by SysV, our unsafe block does no pushes, so the pre-call rsp % 16 == 8 → sub 8 → rsp % 16 == 0 as the ABI requires). Effect row widened from {sysreg} to {sysreg, mem} — {mem} covers the CB[+56] load and the delegated wrmsr/CB store chain in tsc_deadline_rearm. Encoder: rdmsr / shl / or / mov / cmp / je / call / add / sub / ret — all pre-existing. Preserves BSP tick smoke: BSP's CB[+56] is .bss zero until a follow-up issue calls tsc_deadline_arm_first from kernel_main; until then this function behaves exactly as the pre-#777 no-op.",
    block: {
      // (1) rax = &CB[current_cpu] via rdmsr IA32_GS_BASE
      mov rcx, 0xC0000101;                        // IA32_GS_BASE
      rdmsr;
      shl rdx, 32;
      or rax, rdx;

      // (2) Load CB[+56] (PERCPU_OFF_LAPIC_TIMER_DEADLINE)
      mov rcx, [rax + 56];
      cmp rcx, 0;
      je lapic_timer_rearm_periodic;

      // (4) TSC-deadline mode: delegate. RDI (interval) already holds
      // the caller-supplied period; pass through unchanged.
      sub rsp, 8;                                 // realign rsp % 16 == 0 for SysV
      call tsc_deadline_rearm;
      add rsp, 8;
      ret;

      lapic_timer_rearm_periodic:
      // (3) Periodic mode (or timer not yet armed): no-op — the LAPIC
      // reloads the Initial Count register in hardware every expiry.
      ret
    }
  }
}
