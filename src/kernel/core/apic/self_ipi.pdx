// src/kernel/core/apic/self_ipi.pdx — R14b-M5-007b / #646
// Self-targeted IPI issue via LAPIC ICR SELF shorthand
//
// Exports:
//   apic_send_self_ipi(vec: u64) — send a Fixed, edge-triggered IPI
//     to *this* CPU at vector `vec`. Blocks until the LAPIC delivery-
//     status bit clears (bounded).
//
// This module provides the missing primitive the R14b.M5 IPI substrate
// needs to prove runtime delivery end-to-end. The trampolines,
// handlers, counters, and IDT wiring for vec 0xF0/0xF1 already exist
// (see src/kernel/core/ipi/vectors.pdx, src/kernel/core/int/idt.pdx),
// but no code in the kernel actually issues an ICR write. Without an
// ICR write there is no IPI, so the R14b-m5-007 witness's counter
// stays 0 forever — not because delivery is broken but because
// delivery is never attempted.
//
// ICR_LO layout (xAPIC, MMIO 0xFEE00300, 32-bit):
//   [7:0]    Vector
//   [10:8]   Delivery mode        (0b000 = Fixed)
//   [11]     Destination mode     (0 = Physical; unused for SELF)
//   [12]     Delivery status      (R/O; poll for 0 = idle)
//   [14]     Level                (1 = Assert)
//   [15]     Trigger mode         (0 = Edge)
//   [19:18]  Destination shorthand (01 = Self)
//
// Composed value for SELF-shorthand Fixed edge-triggered IPI:
//   (1 << 18) | (1 << 14) | (vec & 0xFF)
// = 0x40000  | 0x4000    | vec
// = 0x44000  | vec
//
// Per Intel SDM Vol 3A §10.6.1:
//   * ICR_LO write triggers delivery — writing ICR_HI is not required
//     to kick a send but we clear it for hygiene.
//   * For SELF shorthand, the destination field in ICR_HI is a
//     don't-care.
//   * All ICR access is 32-bit; a 64-bit access is undefined per
//     §10.4.1 ("register access must be 32-bit wide") — motivating
//     the mov_d idiom (matches eoi.pdx / lapic_timer.pdx).
//
// Preconditions:
//   * apic_svr_enable has been called (bit 8 of SVR set — LAPIC on).
//   * apic_tpr_init has been called (TPR = 0 — no priority gating).
//   * IDT entry for `vec` is wired to a valid trampoline.
//   * The caller opens RFLAGS.IF *around* this call so the pending
//     IPI can actually dispatch. This function does NOT toggle IF.
//     If IF is off, the IPI queues in the LAPIC's IRR and dispatches
//     the instant IF becomes 1 (post sti-shadow).
//
// Prior attempts and why this one differs:
//   Attempt 0d5659e (reverted in c14b869) wrote LAPIC MMIO with bare
//   `mov [rax], ecx`. On paideia-as v0.13.x that silently emitted a
//   64-bit REX.W store (paideia-as #1251) which QEMU-TCG's LAPIC
//   rejected or corrupted, so the IPI never delivered. That attempt
//   is superseded now that paideia-as v0.20.1 fixes #1251; this
//   module additionally uses the explicit mov_d idiom as
//   defence-in-depth against a future encoder regression.
//
// Issue: #646
// Design: design/kernel/r14b-m5-646-self-ipi-runtime-delivery.md
// Predecessor design: design/kernel/r14b-m5-007b-ipi-runtime-delivery.md §3.2

module SelfIpi = structure {
  // LAPIC ICR register offsets (xAPIC MMIO).
  let LAPIC_ICR_LO_OFFSET : u64 = 0x300
  let LAPIC_ICR_HI_OFFSET : u64 = 0x310
  let LAPIC_MMIO_BASE     : u64 = 0xFEE00000

  // (Self shorthand << 18) | (Assert << 14). OR with 8-bit vector.
  let ICR_SELF_ASSERT_MASK : u64 = 0x44000

  // Bounded poll on ICR_LO bit 12 (delivery status). 100k reads is
  // well under the 5-second smoke-mode budget on QEMU-TCG.
  let ICR_DELIVERY_STATUS_BIT : u64 = 0x1000
  let ICR_POLL_BUDGET         : u64 = 100000

  pub let apic_send_self_ipi : (u64) -> () !{sysreg, mem} @{boot} =
    fn (vec: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#646 R14b-M5-007b: issue a Fixed edge-triggered SELF-shorthand IPI to `vec` (RDI). ICR_HI (MMIO 0xFEE00310) is a don't-care under SELF shorthand but written to 0 for hygiene. ICR_LO (MMIO 0xFEE00300) receives (SELF_SHORTHAND << 18) | (ASSERT << 14) | (Fixed << 8) | (vec & 0xFF) = 0x44000 | (vec & 0xFF). The MMIO write itself triggers delivery per Intel SDM Vol 3A §10.6.1; the poll loop reads ICR_LO bit 12 (delivery status) until it clears to 0. Poll bound = 100k reads guards against a sticky delivery-status bit (some QEMU-TCG versions never clear it) so callers do not hang; the outer counter poll in the caller catches actual delivery failure. All three MMIO stores use mov_d [rax], rcx (sized 32-bit) matching the established LAPIC MMIO idiom in eoi.pdx and lapic_timer.pdx, defending against a future paideia-as elaborator regression re-introducing #1251 (narrow-suffix store silently widened to REX.W). The delivery-status read uses `mov ecx, [rax]` — 32-bit load zero-extends into RCX per Intel SDM Vol 2A §3.4.1.1, same idiom as ioapic.pdx:115. Preconditions: apic_svr_enable + apic_tpr_init called; IDT entry for `vec` wired; caller manages RFLAGS.IF around this call. Callee-clobber: RAX, RCX (SysV caller-save); RDI consumed; all other GPRs preserved.",
      block: {
        // ---- ICR_HI = 0 (destination field unused for SELF, hygiene) ----
        // mov_d = sized 32-bit store. LAPIC registers are 32-bit only
        // per SDM Vol 3A §10.4.1; a 64-bit access would spill into the
        // adjacent register slot (0xFEE00318 in this case).
        mov rax, 0xFEE00310;
        xor rcx, rcx;
        mov_d [rax], rcx;

        // ---- Compose ICR_LO value in RCX ----
        // ICR_LO = 0x44000 | (vec & 0xFF)
        //        = (SELF shorthand << 18) | (Assert level << 14) | vec.
        // RDI holds the caller-supplied vector.
        mov rcx, rdi;
        and rcx, 0xFF;
        mov rax, 0x44000;
        or rcx, rax;

        // ---- ICR_LO write kicks delivery ----
        mov rax, 0xFEE00300;
        mov_d [rax], rcx;

        // ---- Bounded poll for delivery-status = idle ----
        // ICR_LO bit 12 goes to 1 while the LAPIC is delivering the
        // IPI, then returns to 0. Read is 32-bit (mov ecx, [rax] zero-
        // extends into RCX). We AND with 0x1000 to isolate bit 12;
        // jump-if-zero exits.
        //
        // Bounded by ICR_POLL_BUDGET (100k reads) — if the bit never
        // clears (a known TCG quirk in some builds), we exit anyway
        // and the outer counter-poll in the caller becomes the real
        // delivery-fail signal. This prevents smoke-mode hangs.
        mov rax, 0xFEE00300;
        mov rdx, 100000;
        self_ipi_wait:
          mov ecx, [rax];
          and rcx, 0x1000;
          je self_ipi_wait_done;
          sub rdx, 1;
          jnz self_ipi_wait;
        self_ipi_wait_done:
          ret
      }
    }
}
