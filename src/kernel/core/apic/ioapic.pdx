// src/kernel/core/apic/ioapic.pdx — R16-M4-005 (#599)
// I/O APIC Redirect Table Programmer.
//
// Superseded the Phase 6 stubs (stub_ioapic_set_redir,
// stub_ioapic_mask, stub_ioapic_unmask) which had zero call
// sites. This module provides the real primitives needed to
// route platform IRQs to specific CPU cores and interrupt
// vectors via the IOAPIC's Redirection Table.
//
// The IOAPIC exposes its registers via a 2-step MMIO protocol:
//   1. Write the 8-bit register index to IOREGSEL @ base + 0x00
//   2. Read/write the 32-bit data via IOWIN @ base + 0x10
// All accesses are 32-bit-only (Intel 82093AA §3.2.1).
//
// Each Redirection Table Entry (RTE) is 64 bits split across
// two consecutive 32-bit IOAPIC registers:
//   RTE #n LO = IOAPIC register 0x10 + n*2   (bits 0-31 of RTE)
//   RTE #n HI = IOAPIC register 0x10 + n*2+1 (bits 32-63 of RTE)
//
// RTE layout (Intel 82093AA §3.2.4):
//   LO bits 0-7:   vector (interrupt vector delivered to LAPIC)
//   LO bits 8-10:  delivery mode (0=Fixed, 1=Lowest Priority, ...)
//   LO bit 11:     destination mode (0=Physical, 1=Logical)
//   LO bit 12:     delivery status (RO)
//   LO bit 13:     polarity (0=Active High, 1=Active Low)
//   LO bit 14:     remote IRR (RO, for level-triggered)
//   LO bit 15:     trigger mode (0=Edge, 1=Level)
//   LO bit 16:     mask (0=Unmasked, 1=Masked — no delivery)
//   LO bits 17-31: reserved (0)
//   HI bits 0-23:  reserved (0)
//   HI bits 24-31: destination (APIC ID in physical mode)
//
// This module exports four primitives:
//   ioapic_write(reg_idx, val)                  → generic register write
//   ioapic_read(reg_idx)                        → generic register read
//   ioapic_route_irq(irq, vec, dest_apic_id)    → program RTE #irq
//   ioapic_irq4_init()                          → wrapper for IRQ 4 → 0x24 → CPU 0
//
// The R16.M4 driver uses ioapic_irq4_init only; ioapic_route_irq
// is exposed for R17+ device driver reuse (keyboard IRQ 1, etc.).
//
// See design/kernel/r16-m4-005-ioapic-irq4.md for full contract.

module Ioapic = structure {
  // ============================================================================
  // I/O APIC Constants
  // ============================================================================

  // IOAPIC MMIO base on standard PC platforms (Intel ICH9, QEMU q35/pc).
  // MADT walk would confirm this at runtime; hard-coded here pending
  // core/acpi/madt.pdx implementation (Phase 6 stub, #167).
  let IOAPIC_MMIO_BASE : u64 = 0xFEC00000

  // Register offsets from IOAPIC_MMIO_BASE.
  let IOAPIC_IOREGSEL_OFFSET : u64 = 0x00
  let IOAPIC_IOWIN_OFFSET    : u64 = 0x10

  // Base of the Redirection Table register range (register 0x10 = RTE #0 LO).
  // RTE #n occupies registers [0x10 + n*2, 0x10 + n*2 + 1].
  let IOAPIC_REDIRTBL_BASE : u64 = 0x10

  // Standard maximum RTE count on a 24-input IOAPIC (register 0x00 IOAPICVER
  // bits 16-23 encode the max redirection entry count; 24 for ICH IOAPICs).
  let IOAPIC_MAX_INPUTS : u64 = 24

  // ============================================================================
  // ioapic_write — write a 32-bit value to an IOAPIC internal register
  //
  // Input:  rdi = reg_idx (8-bit; e.g. 0x18 for RTE #4 LO)
  //         rsi = val (32-bit; upper 32 bits ignored)
  // Output: (none)
  //
  // Side effects:
  //   32-bit MMIO write to IOAPIC_MMIO_BASE + 0x00 (IOREGSEL) selects the
  //   internal register, then 32-bit MMIO write to +0x10 (IOWIN) commits
  //   the value into the selected register.
  //
  // Clobbers (SysV caller-save):
  //   rax.
  // ============================================================================
  pub let ioapic_write : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (reg_idx: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md) + R16-M4-005 (#599): 32-bit MMIO write to IOAPIC internal register via the platform-mapped IOAPIC MMIO window. Base is now loaded from _ioapic_mmio_va (populated at boot by platform_map_early_mmio via platform_mmio_map — runs at kernel_main.pdx right after pat_init_this_cpu, well before this driver is called) rather than materializing hard-coded 0xFEC00000. On PVH -kernel boots _ioapic_mmio_va = identity VA so the store address is byte-identical to the pre-step-4 value; on UEFI/T14 it lives in PML4[321]. Standard IOREGSEL/IOWIN 2-step protocol (Intel 82093AA §3.2.1): load IOAPIC base into rax, write low32 of reg_idx (rdi) to IOREGSEL at base+0x00, then write low32 of val (rsi) to IOWIN at base+0x10. Both stores are 32-bit as required by the IOAPIC spec — 64-bit access would attempt to load the pad word at offset +0x14 and produce undefined behavior on real hardware. Leaf function: no prologue/epilogue, no nested call, no stack frame. Encoder: mov (rip-rel mem load) / 32-bit-source-to-memory store class (`MOV r/m32, r32` opcode 0x89) — all proven. Reads of the pair from real hardware appear as two independent bus transactions per Intel 82093AA §3.2.2 — no fence needed between them because MMIO stores are serialized in program order on the same address window per Intel SDM Vol 3A §11.3.1. Audit: r16-m4-005-ioapic-irq4.",
      block: {
        mov rax, [rip + _ioapic_mmio_va]
        mov [rax], edi
        mov [rax + 0x10], esi
        ret
      }
    }

  // ============================================================================
  // ioapic_read — read a 32-bit value from an IOAPIC internal register
  //
  // Input:  rdi = reg_idx (8-bit)
  // Output: rax = 32-bit register value, zero-extended to 64 bits
  //
  // Side effects:
  //   32-bit MMIO write to IOREGSEL (selects register), then 32-bit
  //   MMIO read from IOWIN (returns the selected register's value).
  //
  // Clobbers (SysV caller-save):
  //   rax (return value).
  // ============================================================================
  pub let ioapic_read : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (reg_idx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md) + R16-M4-005 (#599): 32-bit MMIO read from IOAPIC internal register via IOREGSEL/IOWIN protocol (Intel 82093AA §3.2.1). Base is now loaded from _ioapic_mmio_va (populated at boot by platform_map_early_mmio) rather than hard-coded 0xFEC00000. Load IOAPIC base into rax, write reg_idx to IOREGSEL at base+0x00, then load IOWIN via `mov eax, [rax + 0x10]` — 32-bit load zero-extends into the upper 32 bits of rax per Intel Vol 2A §3.4.1.1, producing a proper u64 return with the IOWIN value in bits 0-31 and 0s in bits 32-63. Reuses rax as both base-address source AND destination for the load — legal because x86 encoding orders address computation before destination write. Same reuse-pattern as sys_wait.pdx:34 (`mov edx, [rax + 4]`). Leaf function: no prologue/epilogue. Encoder: mov (rip-rel mem load) / 32-bit-memory-to-register load class — all proven. Read is 32-bit-only — a 64-bit load would attempt to also load the pad word at offset +0x14 producing undefined data in bits 32-63. Audit: r16-m4-005-ioapic-irq4.",
      block: {
        mov rax, [rip + _ioapic_mmio_va]
        mov [rax], edi
        mov eax, [rax + 0x10]
        ret
      }
    }

  // ============================================================================
  // ioapic_route_irq — program IOAPIC Redirection Table Entry for `irq`
  //
  // Input:  rdi = irq (0..23; IOAPIC input line)
  //         rsi = vec (0..255; IDT vector delivered to LAPIC)
  //         rdx = dest_apic_id (0..255; physical APIC ID of target LAPIC)
  // Output: (none)
  //
  // Programmed RTE flags: Fixed delivery, Physical destination mode,
  //   Active High polarity, Edge trigger, Unmasked (mask=0). These
  //   defaults are correct for ISA-legacy edge-triggered IRQs (UART,
  //   keyboard, RTC). Level-triggered IRQs (PCI legacy INT#, IOAPIC
  //   PIRQ) would require polarity=Active Low + trigger=Level — add
  //   a future variant `ioapic_route_irq_level` for that.
  //
  // Side effects:
  //   Two nested `call ioapic_write` for the HI and LO halves of the
  //   RTE. HI is programmed first (dest), then LO (which includes vec
  //   and mask=0). Ordering per Intel §3.2.4 to avoid transient
  //   half-written RTE state visible to the LAPIC.
  //
  // Clobbers (SysV caller-save):
  //   rax, rcx, rdi, rsi, r8-r11 (transitively via ioapic_write).
  // ============================================================================
  pub let ioapic_route_irq : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (irq: u64, vec: u64, dest_apic_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R16-M4-005 (#599): General primitive to program IOAPIC RTE for any IRQ with vector/destination/standard-flags. R16.M4 caller (ioapic_irq4_init) uses it for IRQ 4 → vec 0x24 → CPU 0; R17+ device driver plane will reuse for keyboard IRQ 1, mouse IRQ 12, etc. Body: (1) 4-push prologue preserving r12-r15 for the four computed values (LO reg idx, HI reg idx, LO value, HI value) that must survive the two nested `call ioapic_write` — those calls are SysV caller-save so r8-r11 would be clobbered. rsp entry-alignment %16==8 → after 4 pushes still %16==8, matching nested call requirement. (2) Compute LO reg = 0x10 + irq*2 into r12 via `shl r12, 1; add r12, 0x10`; HI reg = r12 + 1 into r13. (3) LO value = vec directly (delivery=fixed=0, dest_mode=phys=0, polarity=high=0, trigger=edge=0, mask=0 → LO = vec byte). HI value = dest_apic_id << 24 (dest field is bits 24-31 of the 32-bit HI register). (4) Program HI first (`call ioapic_write` with rdi=r13, rsi=r15), then LO (`call ioapic_write` with rdi=r12, rsi=r14). HI-first ordering per Intel §3.2.4: ensures the LAPIC never sees a half-written RTE where the vector is programmed but the destination still points at the wrong LAPIC. At R16.M4-005 witness time, LAPIC is disabled so any ordering would be inert; observing the convention is R17+ SMP correctness insurance. (5) 4-pop epilogue + ret. Runs with IF=0 by construction (witness slot in kernel_main is inside the boot cli window). Encoder: no new mnemonics — `push/pop r12-r15`, `shl reg, imm8`, `add reg, imm8`, `mov reg, reg`, `call sym` all proven. Audit: r16-m4-005-ioapic-irq4.",
      block: {
        // 4-push prologue: preserve r12-r15 across nested ioapic_write calls
        push r12
        push r13
        push r14
        push r15

        // r12 = LO reg = 0x10 + irq*2
        mov r12, rdi
        shl r12, 1
        add r12, 0x10

        // r13 = HI reg = LO + 1
        mov r13, r12
        add r13, 1

        // r14 = LO value = vec (all other fields default 0)
        mov r14, rsi

        // r15 = HI value = dest_apic_id << 24 (dest field at bits 24-31)
        mov r15, rdx
        shl r15, 24

        // --- Program HI first (dest), then LO (vec + mask=0). ---
        // Ordering per Intel 82093AA §3.2.4: HI-first prevents the LAPIC
        // from seeing a valid vector routed to the wrong destination in
        // a hypothetical mid-write interrupt window.
        mov rdi, r13
        mov rsi, r15
        call ioapic_write

        mov rdi, r12
        mov rsi, r14
        call ioapic_write

        // Epilogue
        pop r15
        pop r14
        pop r13
        pop r12
        ret
      }
    }

  // ============================================================================
  // ioapic_irq4_init — thin wrapper: route IRQ 4 → vector 0x24 → CPU 0
  //
  // Input:  (none)
  // Output: (none)
  //
  // Freezes the IRQ 4 / vector 0x24 / CPU 0 magic numbers in a single
  // named call site. Used by the R16-M4-005 witness (kernel_main.pdx)
  // and any future boot-init call that wants "route the UART" without
  // repeating the parameter triple.
  //
  // Idempotent: safe to call multiple times. Subsequent calls
  // re-write the RTE with identical values (no state divergence).
  //
  // Side effects:
  //   Transitively via ioapic_route_irq: two 32-bit MMIO writes to
  //   IOAPIC_MMIO_BASE (IOREGSEL) + IOWIN, for both LO (0x18) and
  //   HI (0x19) halves of RTE #4.
  //
  // Clobbers (SysV caller-save):
  //   rax, rcx, rdi, rsi, rdx, r8-r11 (transitively).
  // ============================================================================
  pub let ioapic_irq4_init : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R16-M4-005 (#599): Wrapper for the R16.M4 UART RX interrupt routing configuration. Sets rdi=4 (IRQ 4 = COM1 in standard PC ISA IRQ assignment; identity-mapped to GSI 4 on QEMU q35/pc — MADT would confirm dynamically post-#167), rsi=0x24 (IDT slot 36 wired to _uart_rx_trampoline by R16-M4-004 #598), rdx=0 (CPU 0 = BSP = APIC ID 0 on QEMU default), then calls ioapic_route_irq. Alignment: caller's rsp%16==8 (SysV entry) preserved through the call (no prologue), so ioapic_route_irq sees rsp%16==8 at its own entry — correct. Encoder: `mov rN, imm`, `xor rdx, rdx`, `call sym`, `ret` all proven. Audit: r16-m4-005-ioapic-irq4.",
    block: {
      mov rdi, 4          // irq = 4 (COM1 UART)
      mov rsi, 0x24       // vec = 0x24 (IDT slot 36, from #598)
      xor rdx, rdx        // dest_apic_id = 0 (BSP)
      call ioapic_route_irq
      ret
    }
  }

  // ============================================================================
  // R21.M3 (#833/#834): base-parametric IOAPIC MMIO primitives.
  // ============================================================================
  //
  // The four original functions above (ioapic_write, ioapic_read,
  // ioapic_route_irq, ioapic_irq4_init) hard-code IOAPIC_MMIO_BASE
  // = 0xFEC00000 and use fixed defaults for delivery-mode / polarity /
  // trigger / mask. That is sufficient for the R16.M4 UART-RX wiring on
  // QEMU q35/pc, which is a single-IOAPIC platform with no ACPI Interrupt
  // Source Override records for IRQ 4.
  //
  // Under R20.M2 the MADT parsers (acpi/madt.pdx) landed. A real platform
  // may publish one or more IOAPICs at firmware-chosen MMIO bases, each
  // covering a distinct GSI range (see madt.pdx `_madt_scratch_ioapics`).
  // R21.M3 introduces base-parametric primitives so downstream device
  // drivers can program the specific IOAPIC that owns their GSI, and can
  // request non-default delivery/polarity/trigger/mask configurations
  // (level-triggered PCI legacy IRQs, one-shot NMIs, masked-until-ready
  // registration flows, etc.).
  //
  // These new primitives (ioapic_read_at, ioapic_write_at,
  // ioapic_max_redirection_entries, ioapic_program_redir, ioapic_mask,
  // ioapic_unmask) live in the same module as the R16.M4 originals rather
  // than superseding them: the boot-time UART IRQ 4 witness at
  // kernel_main.pdx L5758-5793 depends on the exact byte-for-byte behavior
  // of the R16.M4 functions and their symbol names. The originals will be
  // migrated to thin wrappers around the base-parametric bodies in a
  // follow-up (design/kernel/r21-m3-ioapic-primitives.md §6 — deferred
  // until we can re-run the entire R16.M4 witness matrix after the diff).
  //
  // -----------------------------------------------------------------------------
  // Serialization discipline
  // -----------------------------------------------------------------------------
  //
  // Every base-parametric access brackets the IOREGSEL + IOWIN pair with
  // `mfence`. Rationale:
  //
  //   (a) mfence-BEFORE: earlier WB stores that a caller may have made to
  //       peer data structures (e.g. per-CPU IRQ counters, RTE-lookup
  //       tables) must retire before IOREGSEL is armed — the receiver
  //       that services the interrupt this RTE routes will observe those
  //       stores only if they globally publish before the IOAPIC latches
  //       the new routing. x86 TSO does not order WB stores before UC
  //       MMIO stores from the same CPU (SDM Vol 3A §11.3.1).
  //
  //   (b) mfence-AFTER: the IOWIN store must be globally visible before
  //       any downstream code observes side-effects of the newly-programmed
  //       RTE (e.g. re-enabling interrupts, dropping a lock the driver
  //       held during reprogramming). Same TSO gap as (a) in the other
  //       direction.
  //
  // The R16.M4 originals omit the fences intentionally: they run inside
  // the boot `cli` window with no cross-CPU concerns and no adjacent WB
  // stores that must publish in order with the IOAPIC accesses. Adding
  // fences would change their emitted bytes and force re-witnessing the
  // R16.M4 chain, which is out of scope for R21.M3.
  //
  // -----------------------------------------------------------------------------
  // Encoder-gap posture
  // -----------------------------------------------------------------------------
  //
  //   G1 (paideia-as v0.20.1): `mov [mem], reg32` narrow-store silently
  //       widens to REX.W. Every 32-bit MMIO store below uses the sized
  //       `mov_d [mem], reg` mnemonic (same posture as apic/eoi.pdx,
  //       apic/lapic_timer.pdx, apic/init_sipi.pdx).
  //
  //   `mov eax, [mem]` 32-bit LOADS zero-extend correctly per SDM Vol 2A
  //       §3.4.1.1 — no sized-mnemonic workaround needed on the read side.

  // ============================================================================
  // ioapic_read_at(base, index) -> u32 (returned in rax, zero-extended)
  // ============================================================================
  //
  // SysV: (base: u64, index: u64) -> u64
  //   rdi = MMIO base (typically 0xFEC00000 on ICH9/q35; MADT-supplied
  //         on multi-IOAPIC platforms).
  //   rsi = 8-bit IOAPIC internal register index (0x00 = IOAPICID,
  //         0x01 = IOAPICVER, 0x02 = IOAPICARB, 0x10+2n = RTE #n LO,
  //         0x11+2n = RTE #n HI).
  // Returns rax = 32-bit register value in low 32 bits (zero-extended).

  pub let ioapic_read_at : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, index: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-001 (#833): base-parametric IOAPIC internal-register read. rdi = MMIO base (any 32-bit-aligned IOAPIC MMIO address; validated by caller against the MADT IOAPIC entries or hard-coded 0xFEC00000 for the QEMU q35/PC default). rsi = 8-bit register index in low byte (IOAPIC only decodes bits 7:0 of IOREGSEL per Intel 82093AA §3.2.1). Body: (1) mfence — earlier WB stores retire before the IOREGSEL arm (TSO does not order WB → UC MMIO on the same CPU, SDM Vol 3A §11.3.1). (2) mov_d [rdi], rsi — 32-bit MMIO store to IOREGSEL @ base+0. mov_d is the sized-32-bit form per the G1 encoder-gap workaround established across apic/eoi.pdx, apic/lapic_timer.pdx, apic/init_sipi.pdx — bare `mov [rdi], rsi` would widen to REX.W and write 8 bytes into a 4-byte register slot. (3) mov eax, [rdi + 0x10] — 32-bit MMIO load from IOWIN. Zero-extends into rax per SDM Vol 2A §3.4.1.1 — the u64 return has the register value in bits 0..31 and 0 in bits 32..63. Read-back is a distinct bus transaction from the IOREGSEL store per Intel 82093AA §3.2.2 — no fence required between the two: MMIO accesses to the same UC page are serialized in program order per SDM Vol 3A §11.3.1. (4) mfence — the read result must complete before any downstream code observes side-effects (e.g. a caller acting on the returned value to reprogram or unlock). Leaf function, no prologue. Encoder: no new mnemonics beyond mfence (already in tree via mm/tlb_shootdown.pdx).",
      block: {
        mfence;
        mov_d [rdi], rsi;
        mov eax, [rdi + 0x10];
        mfence;
        ret
      }
    }

  // ============================================================================
  // ioapic_write_at(base, index, value)
  // ============================================================================
  //
  // SysV: (base: u64, index: u64, value: u64) -> ()
  //   rdi = MMIO base
  //   rsi = register index
  //   rdx = 32-bit value (low 32 bits written; upper 32 bits ignored)

  pub let ioapic_write_at : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, index: u64, value: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-001 (#833): base-parametric IOAPIC internal-register write. Same 2-step IOREGSEL/IOWIN protocol as ioapic_read_at, with a store to IOWIN instead of a load. Body: (1) mfence — bracket earlier WB stores. (2) mov_d [rdi], rsi — arm IOREGSEL with the register index (G1: sized 32-bit store). (3) mov_d [rdi + 0x10], rdx — commit the value to IOWIN (G1). (4) mfence — value must publish before downstream operations observe the RTE change. MMIO accesses to the same UC page serialize in program order per SDM Vol 3A §11.3.1, so the two stores land in the correct order without an intermediate fence — the bracket fences protect the boundary with non-MMIO stores on either side. Leaf function.",
      block: {
        mfence;
        mov_d [rdi], rsi;
        mov_d [rdi + 0x10], rdx;
        mfence;
        ret
      }
    }

  // ============================================================================
  // ioapic_max_redirection_entries(base) -> u32 (returns MRE+1, i.e. count)
  // ============================================================================
  //
  // Reads IOAPICVER (register index 0x01), extracts the Maximum
  // Redirection Entry field (bits 23..16), and returns MRE + 1 — the
  // count of RTEs this IOAPIC supports (24 on ICH9/q35).

  pub let ioapic_max_redirection_entries : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-001 (#833): return the number of Redirection Table Entries supported by the IOAPIC at `base`. Per Intel 82093AA §3.2.2, IOAPICVER (register index 0x01) encodes the version in bits 7:0 and the Maximum Redirection Entry (MRE) in bits 23:16 — the highest RTE index the IOAPIC accepts, so the count is MRE+1. Body: call ioapic_read_at(base, 0x01) → rax = IOAPICVER; shift right 16, mask to 8 bits → rax = MRE; add 1 → rax = count. 1-align sub rsp,8 / add rsp,8 bracket the nested call: caller-side rsp%16==8 → after sub rsp,8 → rsp%16==0 for the SysV-required 16-byte call boundary. Encoder: shr / and / add / call — all pre-#833 proven.",
      block: {
        sub rsp, 8;
        mov rsi, 1;
        call ioapic_read_at;
        shr rax, 16;
        and rax, 0xFF;
        add rax, 1;
        add rsp, 8;
        ret
      }
    }

  // ============================================================================
  // ioapic_program_redir(base, gsi, vector, dest_apic_id, flags) -> 1 | 0
  // ============================================================================
  //
  // Programs a full 64-bit Redirection Table Entry for `gsi` on the
  // IOAPIC at `base`. Returns 1 on success, 0 if `gsi` is out of range
  // (i.e. gsi >= MRE+1).
  //
  // The 8-field IOAPIC RTE spec (vector, delivery-mode, dest-mode,
  // polarity, trigger, mask) is packed into a single `flags` u64
  // argument to fit SysV's 6-register calling convention without spilling
  // to the stack:
  //
  //   flags[ 7: 0]  delivery_mode
  //                   0 = Fixed
  //                   1 = Lowest Priority
  //                   2 = SMI
  //                   4 = NMI
  //                   5 = INIT
  //                   7 = ExtINT
  //   flags[ 8]     polarity (0 = active-high, 1 = active-low)
  //   flags[ 9]     trigger  (0 = edge,        1 = level)
  //   flags[10]     mask     (0 = unmasked,    1 = masked)
  //   flags[11]     dest_mode (0 = physical,   1 = logical)
  //
  // The default flags=0 selects Fixed/high/edge/unmasked/physical —
  // correct for ISA-legacy edge IRQs (UART, keyboard). PCI legacy INT#
  // needs flags = 0x300 (polarity=low, trigger=level). Level-triggered
  // NMI would be flags = 0x304 (delivery=4, polarity=low, trigger=level).
  //
  // Programming order: HI first (dest byte), then LO (which carries the
  // mask bit — writing LO last ensures the LAPIC never sees a valid
  // vector routed to the wrong destination in the transient window
  // between the two 32-bit stores).

  pub let ioapic_program_redir : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, gsi: u64, vector: u64, dest_apic_id: u64, flags: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-002 (#834): full-field IOAPIC RTE programmer. Signature packs the 6 spec fields (delivery-mode, dest-mode, polarity, trigger, mask, plus vector and dest as top-level args) into 5 SysV registers by combining the mode/polarity/trigger/mask/dest-mode bits into a single `flags` word — avoids stack-arg passing which the paideia-as v0.20.1 caller-side encoding cannot express cleanly. Body: (1) 5-push prologue (rbx, r12, r13, r14, r15) — needed for the two nested ioapic_write_at calls plus the MRE-bounds-check call. rsp%16==8 entry → +40 → rsp%16==0 pre-call (SysV-correct). (2) Save args in callee-save regs BEFORE the MRE call clobbers caller-save: r12=base, r13=gsi. (3) Compose LO dword in r14 from vector (bits 7:0), delivery_mode (bits 10:8 from flags[7:0]), dest_mode (bit 11 from flags[11]), polarity (bit 13 from flags[8]), trigger (bit 15 from flags[9]), mask (bit 16 from flags[10]). (4) Compose HI dword in r15 = (dest_apic_id & 0xFF) << 24 — the 8-bit xAPIC destination field lives in bits 31:24 of the HI register. (5) Bounds check: call ioapic_max_redirection_entries(base) → rax = count; if gsi >= count, jump to reject path (rax=0 return). (6) HI-first: call ioapic_write_at(base, 0x11 + 2*gsi, HI). (7) LO: call ioapic_write_at(base, 0x10 + 2*gsi, LO) — LO carries the mask bit, so writing it last ensures no half-programmed RTE window is visible to the LAPIC (Intel 82093AA §3.2.4 ordering recommendation). (8) Return 1 on success. Reject path returns 0. Register discipline: rbx unused (kept in prologue for review-symmetry with the 5-push pattern established by acpi/madt.pdx parsers). All caller-save regs are re-materialized between calls; only r12/r13/r14/r15 hold live state across calls. Encoder: mov reg,reg; and imm; or reg,reg; shl reg,imm; shr reg,imm; cmp reg,reg; jae; call; ret — all pre-#834 proven.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save args in callee-save regs.
        mov r12, rdi;                       // r12 = base
        mov r13, rsi;                       // r13 = gsi

        // ---- Compose LO dword in r14 ----
        // Vector (bits 7:0).
        mov r14, rdx;
        and r14, 0xFF;

        // Delivery mode: flags[7:0] → LO[10:8].
        mov rax, r8;
        and rax, 0xFF;
        shl rax, 8;
        or  r14, rax;

        // Dest mode: flags[11] → LO[11].
        mov rax, r8;
        shr rax, 11;
        and rax, 1;
        shl rax, 11;
        or  r14, rax;

        // Polarity: flags[8] → LO[13].
        mov rax, r8;
        shr rax, 8;
        and rax, 1;
        shl rax, 13;
        or  r14, rax;

        // Trigger: flags[9] → LO[15].
        mov rax, r8;
        shr rax, 9;
        and rax, 1;
        shl rax, 15;
        or  r14, rax;

        // Mask: flags[10] → LO[16].
        mov rax, r8;
        shr rax, 10;
        and rax, 1;
        shl rax, 16;
        or  r14, rax;

        // ---- Compose HI dword in r15 = (dest & 0xFF) << 24 ----
        mov r15, rcx;
        and r15, 0xFF;
        shl r15, 24;

        // ---- Bounds check: gsi < MRE+1 ----
        mov rdi, r12;
        call ioapic_max_redirection_entries;
        cmp r13, rax;
        jae ipr_reject;

        // ---- Write HI first (0x11 + 2*gsi) ----
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x11;
        mov rdx, r15;
        call ioapic_write_at;

        // ---- Write LO (0x10 + 2*gsi) ----
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x10;
        mov rdx, r14;
        call ioapic_write_at;

        mov rax, 1;
        jmp ipr_epilogue;

      ipr_reject:
        mov rax, 0;

      ipr_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ioapic_mask(base, gsi) -> 1 | 0
  // ============================================================================
  //
  // Read-modify-write on the LO dword to set the mask bit (bit 16).
  // Returns 1 on success, 0 if gsi is out of range.

  pub let ioapic_mask : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, gsi: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-002 (#834): mask an IOAPIC RTE by setting bit 16 of the LO dword via read-modify-write. Only touches the mask bit — all other RTE fields (vector, delivery, dest, polarity, trigger, dest-mode) are preserved. Contract: after this returns 1, the IOAPIC drops any inbound edge/level on `gsi` (SDM Vol 3A §10.11.4). Body: (1) 3-push prologue (rbx=saved LO across write, r12=base, r13=gsi) — rsp%16==8 entry → +24 → rsp%16==0 pre-call. (2) Bounds check via ioapic_max_redirection_entries; reject if gsi >= count. (3) Compute LO reg = 0x10 + 2*gsi; call ioapic_read_at → rax = current LO. (4) Set bit 16: or rbx, 0x10000. (5) Write back via ioapic_write_at. Return 1. Reject path returns 0. Bit-16 mask via `or rbx, 0x10000` — the imm32 encoding for OR-imm is well-established (see cpu_features.pdx `and rax, 0x10000`). Encoder: no new mnemonics.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                       // base
        mov r13, rsi;                       // gsi

        // Bounds check.
        mov rdi, r12;
        call ioapic_max_redirection_entries;
        cmp r13, rax;
        jae ioapic_mask_reject;

        // Read current LO.
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x10;
        call ioapic_read_at;
        mov rbx, rax;

        // Set mask bit (16).
        or rbx, 0x10000;

        // Write back.
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x10;
        mov rdx, rbx;
        call ioapic_write_at;

        mov rax, 1;
        jmp ioapic_mask_done;

      ioapic_mask_reject:
        mov rax, 0;

      ioapic_mask_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ioapic_unmask(base, gsi) -> 1 | 0
  // ============================================================================
  //
  // Read-modify-write on the LO dword to clear the mask bit (bit 16).
  // Returns 1 on success, 0 if gsi is out of range.

  pub let ioapic_unmask : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, gsi: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-002 (#834): unmask an IOAPIC RTE by clearing bit 16 of the LO dword via read-modify-write. Symmetric with ioapic_mask; only the bit-manipulation step differs. Clear-bit-16 uses `mov rax, 0xFFFFFFFFFFFEFFFF; and rbx, rax` — paideia-as v0.20.1 lacks a first-class `not` mnemonic (see mm/uefi_phys_seed.pdx L322 posture), so bit clearing is done via a full 64-bit mask constant loaded into a scratch register and AND-ed. The mask has bit 16 zero and every other bit set. This is cleaner than the alternative `xor rbx, 0x10000` which would only work if bit 16 was known to be set — for an idempotent unmask we need the true clear semantic. Encoder: mov imm64, and reg,reg — all proven.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // Bounds check.
        mov rdi, r12;
        call ioapic_max_redirection_entries;
        cmp r13, rax;
        jae ioapic_unmask_reject;

        // Read current LO.
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x10;
        call ioapic_read_at;
        mov rbx, rax;

        // Clear mask bit (16): rbx &= ~(1 << 16).
        mov rax, 0xFFFFFFFFFFFEFFFF;
        and rbx, rax;

        // Write back.
        mov rdi, r12;
        mov rsi, r13;
        shl rsi, 1;
        add rsi, 0x10;
        mov rdx, rbx;
        call ioapic_write_at;

        mov rax, 1;
        jmp ioapic_unmask_done;

      ioapic_unmask_reject:
        mov rax, 0;

      ioapic_unmask_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
