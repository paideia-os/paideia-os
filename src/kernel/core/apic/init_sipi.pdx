// src/kernel/core/apic/init_sipi.pdx — R18-M1-001 / #760
// LAPIC ICR: INIT-IPI and STARTUP-IPI (SIPI) primitives for AP wake
// Issue: paideia-os/paideia-os#760
//
// Exports:
//   lapic_send_init_ipi(target_apic_id: u64) — Level=Assert, Delivery=INIT (5),
//     no shorthand + physical destination mode. Writes ICR_HI then ICR_LO,
//     then polls delivery-status idle. Vector byte is a don't-care for INIT.
//
//   lapic_send_startup_ipi(target_apic_id: u64, trampoline_phys: u64) —
//     Level=Assert, Delivery=Startup (6). Vector byte = (trampoline_phys >> 12)
//     truncated to 8 bits. AP wakes in real mode at CS:IP = (vector << 8):0000.
//     Trampoline MUST live in the low 1 MiB on a 4 KiB boundary.
//
// Intel SDM Vol 3A §10.6:
//   ICR_LO (MMIO 0xFEE00300, 32-bit):
//     [ 7: 0]  Vector
//     [10: 8]  Delivery mode (000=Fixed, 100=NMI, 101=INIT, 110=Startup)
//     [   11]  Destination mode (0=Physical, 1=Logical)
//     [   12]  Delivery status (R/O — 0=idle, 1=send-pending)
//     [   14]  Level              (1=Assert; must be 1 for INIT/SIPI level)
//     [   15]  Trigger mode       (0=Edge for INIT/SIPI; INIT-DeAssert would set 1)
//     [19:18]  Destination shorthand (00=No shorthand; use ICR_HI dest)
//   ICR_HI (MMIO 0xFEE00310, 32-bit):
//     [31:24]  Destination APIC ID (xAPIC 8-bit; x2APIC uses full 32-bit MSR path)
//
// All LAPIC MMIO writes MUST be 32-bit (mov_d) — bare `mov [rax], rcx` emits
// REX.W 64-bit stores that spill into adjacent register slots and are silently
// dropped or corrupted by QEMU LAPIC. This module uses the mov_d idiom
// established by self_ipi.pdx / lapic_timer.pdx (defence against paideia-as
// #1251-class encoder regressions).
//
// This module does NOT drive the INIT->SIPI->SIPI orchestration or the timing
// (Intel spec: 10 ms after INIT; 200 us between the two SIPIs). That lives in
// src/kernel/core/smp/ap_boot.pdx (issue #760 orchestrator). This module is
// the LAPIC-ICR primitive layer only.
//
// R18 preconditions inherited from BSP boot:
//   * apic_enable   — IA32_APIC_BASE.EN set.
//   * apic_svr_enable — LAPIC SVR bit 8 set.
//   * apic_tpr_init — TPR = 0.
// Encoder: paideia-as v0.20.1+ (mov_d + mov imm64 + call/ret). No new gaps.

module InitSipi = structure {
  // xAPIC ICR MMIO offsets (LAPIC base = 0xFEE00000).
  let LAPIC_ICR_LO_ADDR : u64 = 0xFEE00300
  let LAPIC_ICR_HI_ADDR : u64 = 0xFEE00310

  // ICR_LO composed field values (pre-shifted). Composition is:
  //   ICR_LO = ICR_LEVEL_ASSERT
  //          | ICR_DEST_MODE_PHYS
  //          | ICR_DEST_SHORTHAND_NONE
  //          | (delivery_mode << 8)
  //          | (vector & 0xFF)
  //   ICR_HI = (dest_apic_id & 0xFF) << 24
  let ICR_LEVEL_ASSERT       : u64 = 0x4000   // bit 14
  let ICR_DELIVERY_INIT      : u64 = 0x500    // 5 << 8
  let ICR_DELIVERY_STARTUP   : u64 = 0x600    // 6 << 8

  // Delivery-status poll (bit 12). See self_ipi.pdx for rationale on the
  // bounded budget — some TCG builds never clear the bit.
  let ICR_DELIVERY_STATUS_BIT : u64 = 0x1000

  // ============================================================================
  // lapic_send_init_ipi(target_apic_id)
  // ============================================================================
  // Sends Level=Assert INIT IPI to `target_apic_id` (RDI, physical dest).
  // Writes ICR_HI (dest byte) then ICR_LO (kick). Polls delivery-status to
  // clear (bounded 100k iterations).
  //
  // Callee-clobber (SysV caller-save): RAX, RCX, RDX. RDI consumed.
  // Callee-preserve: RBX, RBP, R12-R15 (touched not at all).
  pub let lapic_send_init_ipi : (u64) -> () !{sysreg, mem} @{boot} =
    fn (target_apic_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#760 R18-M1-001: issue Level=Assert INIT IPI to physical destination RDI. ICR_HI (MMIO 0xFEE00310) receives (RDI & 0xFF) << 24 — the 8-bit xAPIC destination field lives in [31:24]. ICR_LO (MMIO 0xFEE00300) receives ICR_LEVEL_ASSERT (0x4000) | ICR_DELIVERY_INIT (0x500) — destination shorthand 00 (no shorthand), destination mode 0 (physical), trigger 0 (edge), vector byte 0 (don't-care for INIT). Both stores use mov_d (32-bit sized) matching the established LAPIC MMIO idiom in self_ipi.pdx / lapic_timer.pdx, defending against a paideia-as elaborator regression re-introducing #1251 (narrow-suffix store silently widened to REX.W). Delivery-status poll on ICR_LO bit 12 with 100k budget mirrors self_ipi's pattern. The MMIO write to ICR_LO is what triggers delivery per Intel SDM Vol 3A §10.6.1. This function does not wait 10 ms; that spacing belongs to the ap_wake orchestrator per Intel MP-init spec §B.4.",
      block: {
        // ---- ICR_HI = (apic_id & 0xFF) << 24 ----
        mov rcx, rdi;
        and rcx, 0xFF;
        shl rcx, 24;
        mov rax, 0xFEE00310;
        mov_d [rax], rcx;

        // ---- ICR_LO = Assert | INIT (delivery mode 5) ----
        // Vector byte = 0 (don't-care for INIT).
        mov rcx, 0x4500;                     // 0x4000 | 0x500
        mov rax, 0xFEE00300;
        mov_d [rax], rcx;

        // ---- Bounded poll on ICR_LO bit 12 (delivery status). ----
        mov rax, 0xFEE00300;
        mov rdx, 100000;
        init_ipi_wait:
          mov ecx, [rax];
          and rcx, 0x1000;
          je init_ipi_wait_done;
          sub rdx, 1;
          jnz init_ipi_wait;
        init_ipi_wait_done:
          ret
      }
    }

  // ============================================================================
  // lapic_send_startup_ipi(target_apic_id, trampoline_phys)
  // ============================================================================
  // Sends Level=Assert Startup IPI (SIPI) to `target_apic_id` (RDI) with the
  // trampoline page vector derived from `trampoline_phys` (RSI). Per Intel
  // SDM Vol 3A §10.6.4, the AP wakes at CS:IP = (vector << 8):0000, i.e.,
  // physical `vector << 12`. So `vector = trampoline_phys >> 12`, truncated
  // to 8 bits — trampoline must be in the low 1 MiB on a 4 KiB boundary.
  //
  // Callee-clobber: RAX, RCX, RDX. RDI, RSI consumed.
  pub let lapic_send_startup_ipi : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (target_apic_id: u64, trampoline_phys: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#760 R18-M1-001: issue Level=Assert Startup IPI (SIPI) to physical destination RDI. Trampoline page derived from RSI: vector = (RSI >> 12) & 0xFF. Per Intel SDM Vol 3A §10.6.4, AP wakes in real mode at CS:IP = (vector << 8):0000 (physical = vector << 12). Trampoline MUST live in low 1 MiB on 4 KiB boundary — enforced by caller (ap_wake orchestrator + #761 trampoline placement). ICR_HI (0xFEE00310) = (RDI & 0xFF) << 24. ICR_LO (0xFEE00300) = ICR_LEVEL_ASSERT (0x4000) | ICR_DELIVERY_STARTUP (0x600) | vector — all in [15:0], no shorthand ([19:18]=00), physical dest mode ([11]=0), edge trigger ([15]=0). Both stores use mov_d 32-bit sized. Delivery-status poll bounded 100k. Intel MP-init spec §B.4 requires TWO SIPI deliveries with ~200 us spacing after INIT + 10 ms; both spacing and the double-send belong to the ap_wake orchestrator, not this primitive. This function is idempotent to duplicate delivery for identical (apic_id, trampoline) pairs modulo the AP's post-INIT WFS state (AP ignores SIPIs after leaving WFS — same-vector re-arm is a no-op).",
      block: {
        // ---- Compute vector byte from trampoline_phys (RSI). ----
        mov rax, rsi;
        shr rax, 12;
        and rax, 0xFF;

        // Save vector byte in R11 (SysV caller-save; free to use here).
        mov r11, rax;

        // ---- ICR_HI = (apic_id & 0xFF) << 24 ----
        mov rcx, rdi;
        and rcx, 0xFF;
        shl rcx, 24;
        mov rax, 0xFEE00310;
        mov_d [rax], rcx;

        // ---- ICR_LO = Assert | Startup (delivery mode 6) | vector ----
        mov rcx, 0x4600;                     // 0x4000 | 0x600
        or rcx, r11;
        mov rax, 0xFEE00300;
        mov_d [rax], rcx;

        // ---- Bounded poll on ICR_LO bit 12 (delivery status). ----
        mov rax, 0xFEE00300;
        mov rdx, 100000;
        sipi_wait:
          mov ecx, [rax];
          and rcx, 0x1000;
          je sipi_wait_done;
          sub rdx, 1;
          jnz sipi_wait;
        sipi_wait_done:
          ret
      }
    }
}
