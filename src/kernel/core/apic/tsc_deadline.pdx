// src/kernel/core/apic/tsc_deadline.pdx — R18-M5-003 / #777
// Per-CPU LAPIC TSC-deadline timer arming
// Issue: paideia-os/paideia-os#777
//
// Exports:
//   tsc_deadline_available() -> u64
//     Returns 1 if the CPU advertises IA32_TSC_DEADLINE support
//     (CPUID.01H:ECX[24]); 0 otherwise. Callers gate the LVT program
//     and MSR arm on this bit — writing IA32_TSC_DEADLINE (0x6E0) on
//     a CPU that does not advertise the feature raises #GP.
//
//   lapic_timer_init_tsc_deadline()
//     Programs LAPIC LVT Timer (MMIO 0xFEE00320) to TSC-deadline mode
//     with vector 32. Value = (0b10 << 17) | 32 = 0x40020. Sized 32-bit
//     store per the #662 Fix B pattern in lapic_timer.pdx (bare
//     `mov [rax], rcx` widens to REX.W 64-bit, spilling into the LVT
//     Thermal slot at 0x33 — QEMU's LAPIC rejects the 8-byte store).
//
//   tsc_deadline_arm_first(period: u64)
//     First-arm on the calling CPU: deadline = rdtsc + period; wrmsr
//     IA32_TSC_DEADLINE; store deadline into this CPU's
//     CB[PERCPU_OFF_LAPIC_TIMER_DEADLINE=+56]. A non-zero CB[+56] also
//     serves as the "TSC-deadline active" flag consulted by
//     LapicTimer.lapic_timer_rearm to distinguish the periodic-mode
//     no-op path from the TSC-deadline re-arm path.
//
//   tsc_deadline_rearm(period: u64)
//     ISR re-arm: deadline = CB[+56] + period; wrmsr IA32_TSC_DEADLINE;
//     update CB[+56]. Called from the timer ISR tail (via
//     LapicTimer.lapic_timer_rearm's dispatch) once TSC-deadline mode
//     is active on the calling CPU.
//
// Per-CPU discipline:
//   The deadline is stored in the caller's Percpu CB slot (obtained via
//   rdmsr IA32_GS_BASE — same idiom as ipi/vectors.pdx L82,
//   sched/pick_next.pdx L119, sched/ap_bringup.pdx L120). Every CPU
//   arming its own timer walks its own CB; no shared state.
//
// AP-side gating (see design/roadmap/r18-plus-bare-metal.md §R18):
//   APs cannot receive timer interrupts until an IDT is installed on
//   the AP side. #762/#766 leave APs in cli/hlt; #777 provides the
//   arming machinery but the AP timer witness (AC #3: "8 cores tick
//   independently at 100 Hz") lands with the AP-IDT install issue.
//   The BSP path is unaffected: it stays in periodic mode until a
//   follow-up wires lapic_timer_init_tsc_deadline into kernel_main.
//
// Encoder: paideia-as v0.20.1+ (rdmsr / wrmsr / rdtsc / mov / mov_d /
// cpuid / cmp / jne / ret + rip-relative lea). No new gaps.

module TscDeadline = structure {
  // ============================================================================
  // Constants
  // ============================================================================

  // CPUID.01H:ECX bit 24 — IA32_TSC_DEADLINE MSR supported.
  let CPUID_01H_ECX_TSC_DEADLINE : u64 = 0x1000000   // bit 24

  // IA32_TSC_DEADLINE MSR (Intel SDM Vol 3A §10.5.4.1).
  let IA32_TSC_DEADLINE_MSR : u64 = 0x6E0

  // IA32_GS_BASE MSR — same MSR used across the codebase for per-CPU CB
  // access (see gs_base.pdx). rdmsr IA32_GS_BASE + reconstruct EDX:EAX =
  // &CB[current_cpu].
  let IA32_GS_BASE_MSR : u64 = 0xC0000101

  // Per-CPU CB field offset for the current TSC deadline value. Mirrors
  // PERCPU_OFF_LAPIC_TIMER_DEADLINE (percpu.pdx L88); duplicated as an
  // immediate here because paideia-as inlines constants at build time
  // and cross-module constant references are not encoded as immediates.
  let CB_OFF_DEADLINE : u64 = 56

  // LAPIC LVT Timer MMIO address (xAPIC base 0xFEE00000 + LVT_TIMER 0x320).
  let LAPIC_LVT_TIMER_ADDR : u64 = 0xFEE00320

  // LVT Timer value: (0b10 << 17) TSC-deadline mode | vector 32 = 0x40020.
  let LVT_TIMER_TSC_DEADLINE_V32 : u64 = 0x40020

  // Default per-CPU tick period in TSC cycles. Sized to ~10 ms at a 1 GHz
  // TSC clock (10_000_000 cycles) — matches lapic_isr.pdx DEFAULT_INTERVAL
  // and lines up with the 100 Hz periodic-mode target of #565. Real
  // deployments will replace this with a calibrated value derived from
  // CPUID.15H or a PIT-based calibration loop; the constant lives here as
  // a placeholder until the calibration issue lands.
  pub let TSC_TICK_PERIOD : u64 = 10000000

  // ============================================================================
  // tsc_deadline_available() -> u64
  // ============================================================================
  // Returns 1 in rax if CPUID.01H:ECX[24] is set; 0 otherwise.
  //
  // Register discipline (SysV): cpuid clobbers rax/rbx/rcx/rdx (all
  // caller-save). No callee-save touched. Leaf.
  pub let tsc_deadline_available : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R18-M5-003 (#777): CPUID leaf 1 (CPUID.01H) feature detection for the IA32_TSC_DEADLINE MSR. Load rax=1, cpuid; test ECX bit 24 (mask 0x1000000). Non-zero → return 1 (feature present); zero → return 0. Callers gate lapic_timer_init_tsc_deadline / tsc_deadline_arm_first on the returned bit — writing IA32_TSC_DEADLINE (0x6E0) on a CPU that does not advertise the feature raises #GP per Intel SDM Vol 3A §10.5.4.1. Modern x86 (Nehalem+, all AMD Bulldozer+) advertise the bit; QEMU with -cpu max or -cpu host exposes it, plain -cpu qemu64 does not. Mirrors the smep.pdx / smap.pdx / nx.pdx CPUID-gate idiom (test bit, jz skip). Encoder: cpuid (0F A2) and rcx, imm32; cmp/je/mov — all pre-existing. Leaf function, no callee-save clobber; rax/rbx/rcx/rdx all caller-save per SysV.",
      block: {
        mov rax, 1;
        cpuid;
        and rcx, 0x1000000;                       // ECX bit 24
        cmp rcx, 0;
        je tsc_deadline_available_no;
        mov rax, 1;
        ret;

        tsc_deadline_available_no:
        mov rax, 0;
        ret
      }
    }

  // ============================================================================
  // lapic_timer_init_tsc_deadline()
  // ============================================================================
  // Programs LAPIC LVT Timer (MMIO 0xFEE00320) for TSC-deadline mode with
  // vector 32. Caller MUST verify tsc_deadline_available() == 1 first.
  //
  // Register discipline: rax + rcx scratch (both caller-save). Leaf.
  pub let lapic_timer_init_tsc_deadline : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R18-M5-003 (#777): Program LAPIC LVT Timer register (xAPIC MMIO 0xFEE00320) to TSC-deadline mode + vector 32. Value = (0b10 << 17) | 32 = 0x40020 per Intel SDM Vol 3A §10.5.1 (LVT Timer: bits 17:16 = 10 selects TSC-deadline, bits 7:0 = vector). Sized 32-bit store via mov_d — the #662 Fix B pattern used throughout lapic_timer.pdx (bare `mov [rax], rcx` emits REX.W 64-bit store; QEMU's LAPIC MMIO model rejects 8-byte writes at LVT Timer slot 0x32 because they spill into the adjacent LVT Thermal slot at 0x33). Caller MUST verify tsc_deadline_available() returned 1 before invoking — programming TSC-deadline mode on a CPU without the feature does not raise #GP at the LVT write, but the subsequent wrmsr IA32_TSC_DEADLINE (0x6E0) does. Per-CPU: each AP calls this from its own AP entry once tsc_deadline_available holds; BSP calls it from kernel_main (wire-in follow-up). Encoder: mov / mov_d — pre-existing.",
      block: {
        mov rax, 0xFEE00320;                      // LAPIC LVT Timer MMIO
        mov rcx, 0x40020;                         // TSC-deadline mode | vec 32
        mov_d [rax], rcx;                         // 32-bit store (Fix B pattern)
        ret
      }
    }

  // ============================================================================
  // tsc_deadline_arm_first(period: u64)
  // ============================================================================
  // First-arm on the calling CPU: deadline = rdtsc + period. Writes MSR
  // and publishes deadline into CB[+56] on the calling CPU (via GS_BASE).
  // A non-zero CB[+56] also flags "TSC-deadline active" for the ISR-side
  // re-arm dispatch in LapicTimer.lapic_timer_rearm.
  //
  // Register discipline: rax/rcx/rdx/r8 scratch (all caller-save). Leaf.
  //   r8 = CB VA (survives across the rdtsc that reclobbers rax/rdx).
  pub let tsc_deadline_arm_first : (u64) -> () !{sysreg, mem} @{boot} =
    fn (period: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R18-M5-003 (#777): First-arm the LAPIC TSC-deadline timer on the calling CPU. (a) Read CB VA via rdmsr IA32_GS_BASE (0xC0000101) + EDX:EAX reconstruct (SDM Vol 2C §5.2.9) — same idiom used across ipi/vectors.pdx L82, sched/pick_next.pdx L119, sched/ap_bringup.pdx L120. r8 (caller-save; safe within this unsafe block — no nested calls) stashes the CB VA across the subsequent rdtsc that reclobbers rax/rdx. (b) rdtsc; shl rdx, 32; or rax, rdx → rax = current TSC (u64) — same idiom as klog/tsc.pdx kread_tsc. (c) add rax, rdi → rax = deadline (TSC + period). (d) Store deadline into CB[+56] (PERCPU_OFF_LAPIC_TIMER_DEADLINE per percpu.pdx L88) as a full 8-byte store — the field is declared u64, so REX.W width matches (no mov_d hazard). Non-zero CB[+56] doubles as the 'TSC-deadline active' flag consulted by LapicTimer.lapic_timer_rearm to distinguish the periodic-mode no-op path from the TSC-deadline re-arm path. (e) Split deadline into edx:eax for wrmsr — mov rdx, rax; shr rdx, 32 → edx = high 32, eax preserved with low 32. (f) mov rcx, IA32_TSC_DEADLINE (0x6E0); wrmsr — arms the LAPIC. Per Intel SDM Vol 3A §10.5.4.1, writing a non-zero value to IA32_TSC_DEADLINE arms the timer to fire when TSC crosses the written value; write of zero disarms. Caller MUST verify tsc_deadline_available() == 1 before invoking (wrmsr on unsupported CPU raises #GP). Encoder: rdmsr / rdtsc / wrmsr / shl / shr / add / mov / or — all pre-existing. Leaf; caller-save discipline; capability {boot} restricts to bring-up.",
      block: {
        // (a) rax = CB VA via rdmsr IA32_GS_BASE
        mov rcx, 0xC0000101;
        rdmsr;
        shl rdx, 32;
        or rax, rdx;
        mov r8, rax;                              // r8 = CB VA (stash across rdtsc)

        // (b) rax = current TSC (u64)
        rdtsc;
        shl rdx, 32;
        or rax, rdx;

        // (c) rax = deadline = TSC + period
        add rax, rdi;

        // (d) CB[+56] = deadline (also acts as "TSC-deadline active" flag)
        mov [r8 + 56], rax;

        // (e) Split deadline into edx:eax for wrmsr
        mov rdx, rax;
        shr rdx, 32;                              // rdx = high 32 bits

        // (f) wrmsr IA32_TSC_DEADLINE = deadline
        mov rcx, 0x6E0;
        wrmsr;
        ret
      }
    }

  // ============================================================================
  // tsc_deadline_rearm(period: u64)
  // ============================================================================
  // Timer-ISR re-arm on the calling CPU: new_deadline = CB[+56] + period.
  // Idempotent under repeated ticks; caller-supplied period is the fixed
  // TSC-tick interval (typically TSC_TICK_PERIOD).
  //
  // Register discipline: rax/rcx/rdx/r8 scratch (all caller-save). Leaf.
  //   r8 = CB VA (survives across the wrmsr split that reclobbers rax/rdx).
  pub let tsc_deadline_rearm : (u64) -> () !{sysreg, mem} @{boot} =
    fn (period: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R18-M5-003 (#777): Re-arm the LAPIC TSC-deadline timer from the timer ISR tail on the calling CPU. (a) rax = CB VA via rdmsr IA32_GS_BASE (0xC0000101) + EDX:EAX reconstruct — same idiom as tsc_deadline_arm_first (a). r8 stashes CB VA across the wrmsr edx:eax split. (b) rcx = CB[+56] (current deadline). (c) rcx += period (new deadline). (d) CB[+56] = new deadline — advances the per-CPU deadline monotonically; repeated ticks accumulate ahead of TSC (guarantees no missed ticks even if the ISR takes longer than one period, at the cost of a stall-catchup burst — accepted for MVP). (e) Split new deadline into edx:eax for wrmsr: mov rax, rcx; mov rdx, rcx; shr rdx, 32. (f) mov rcx, 0x6E0 (IA32_TSC_DEADLINE); wrmsr. Per Intel SDM Vol 3A §10.5.4.1, subsequent write to the MSR simply re-arms; no self-EOI needed here (caller does apic_eoi separately). Called from LapicTimer.lapic_timer_rearm when CB[+56] != 0 (TSC-deadline mode active on this CPU). Callee MUST NOT be invoked on a CPU that does not advertise TSC-deadline — wrmsr on an unsupported CPU raises #GP. Gating lives in the tsc_deadline_arm_first entry path (the only writer of CB[+56]). Encoder: rdmsr / wrmsr / shr / add / mov / or — all pre-existing. Leaf; caller-save discipline; capability {boot} — cross-checked against handle_timer's {boot} capability in exceptions.pdx.",
      block: {
        // (a) rax = CB VA via rdmsr IA32_GS_BASE
        mov rcx, 0xC0000101;
        rdmsr;
        shl rdx, 32;
        or rax, rdx;
        mov r8, rax;                              // r8 = CB VA

        // (b) rcx = current deadline from CB[+56]
        mov rcx, [r8 + 56];

        // (c) rcx = new deadline = current + period
        add rcx, rdi;

        // (d) CB[+56] = new deadline
        mov [r8 + 56], rcx;

        // (e) Split new deadline into edx:eax for wrmsr
        mov rax, rcx;
        mov rdx, rcx;
        shr rdx, 32;                              // rdx = high 32 bits

        // (f) wrmsr IA32_TSC_DEADLINE = new deadline
        mov rcx, 0x6E0;
        wrmsr;
        ret
      }
    }
}
