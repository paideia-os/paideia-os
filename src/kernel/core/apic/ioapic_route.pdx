// src/kernel/core/apic/ioapic_route.pdx — R21.M3-003 (#835)
//
// MADT-aware IOAPIC route helper. Wraps ioapic_program_redir with:
//
//   (1) An Interrupt Source Override (ISO) lookup: ISA IRQs may be
//       remapped to non-identity GSIs by firmware. The canonical
//       example is PIT IRQ 0 landing on GSI 2 on virtually every PC-AT
//       machine. R20.M2's madt_parse_isos populates
//       core/smp/madt_topology.pdx `_madt_scratch_isos` (16 B records:
//       source_irq @+0, gsi @+4, mps_inti_flags @+8) which we scan
//       here for a source_irq match.
//
//   (2) An IOAPIC-by-GSI lookup: a platform may publish multiple
//       IOAPICs, each covering a contiguous GSI range. R20.M2's
//       madt_parse_ioapics populates `_madt_scratch_ioapics` (24 B
//       records: id @+0 u64, mmio_base @+8 u64, gsi_base @+16 u32).
//       We pick the IOAPIC with the largest gsi_base <= gsi (the
//       standard "IOAPIC owns [gsi_base, gsi_base + MRE+1)" rule).
//
// When the MADT scratch tables are empty (`_madt_n_ioapics == 0` or
// `_madt_n_isos == 0`), we fall back to platform defaults:
//   * No ISO match → identity gsi = source_irq, polarity=high, trigger=edge.
//   * No IOAPIC records → base = 0xFEC00000 (Intel ICH9/QEMU q35 PC).
//
// This module does NOT replace the R16.M4 `ioapic_route_irq` in
// apic/ioapic.pdx — that function has zero-fence, no-bounds-check,
// hard-coded-defaults behavior that the R16.M4 UART IRQ 4 witness at
// kernel_main.pdx L5758-5793 depends on byte-for-byte. The eventual
// migration of R16.M4 IRQ 4 wiring onto this MADT-aware helper is
// tracked in design/kernel/r21-m3-ioapic-primitives.md §6.
//
// -----------------------------------------------------------------------------
// MPS INTI flags → RTE flags mapping (ACPI 6.5 §5.2.13, MP spec §4.3.4)
// -----------------------------------------------------------------------------
//
// The ISO record's `mps_inti_flags` u16 encodes:
//   bits 1:0  polarity  00=bus-conformant, 01=active-high, 10=reserved, 11=active-low
//   bits 3:2  trigger   00=bus-conformant, 01=edge,        10=reserved, 11=level
//
// For ISA source (bus=0, spec-locked), the "bus-conformant" default is
// active-high edge. So the mapping to IOAPIC RTE flags is:
//
//   polarity: MPS 11 → RTE bit 8 = 1 (low). Else RTE bit 8 = 0 (high).
//   trigger:  MPS 11 → RTE bit 9 = 1 (level). Else RTE bit 9 = 0 (edge).
//
// The delivery-mode + dest-mode + mask bits of RTE flags stay 0 (fixed /
// physical / unmasked) — the R21.M3 caller surface is device-driver
// wiring for edge-triggered ISA IRQs; NMI/SMI routing has its own path
// (madt_parse_lapic_nmis, R21.M3 follow-up).

module IoapicRoute = structure {
  // ============================================================================
  // ioapic_base_for_gsi(gsi) -> MMIO base of the IOAPIC that owns `gsi`
  // ============================================================================
  //
  // R30.M4-001 (#1066): extracted from ioapic_route_irq_via_madt's body
  // so the SCI path in core/acpi/sci_route.pdx can ask the same question
  // without re-deriving the answer. The extraction is deliberate rather
  // than a copy: "which IOAPIC owns this GSI" has exactly one right
  // answer on a platform, and two implementations of it can disagree
  // without either one being obviously wrong at the point of use.
  //
  // Returns the ICH9/q35 default 0xFEC00000 when the MADT scratch table
  // is empty — the same fallback the caller used before the extraction,
  // and the right one for BIOS boots and for bring-up before
  // topology_seed_from_madt has run.

  pub let ioapic_base_for_gsi : (u64) -> u64 !{mem} @{} =
    fn (gsi: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md) + R30.M4-001 (#1066): IOAPIC-owner discovery. Iterates _madt_scratch_ioapics[0.._madt_n_ioapics) — 24-byte records, u64 id @+0, u64 mmio_base @+8, u32 gsi_base @+16 — and keeps the candidate with the highest gsi_base that is still <= gsi, which is the standard 'an IOAPIC owns [gsi_base, gsi_base + MRE + 1)' rule applied to an unsorted table. Empty-table fallback is now loaded from _ioapic_mmio_va (populated at boot by platform_map_early_mmio via platform_mmio_map) rather than hard-coded 0xFEC00000 — on PVH -kernel boots the mapped VA equals the identity VA so the fallback is byte-identical to the pre-step-4 value; on UEFI/T14 it lives in PML4[321]. The caller's bounds check (ioapic_program_redir against the chosen IOAPIC's maximum redirection entry) is what catches a GSI past the end of the winning IOAPIC's range, so this function does not need to know the range's top. Note: MADT scratch table entries at +8 remain raw physical bases (populated by acpi/madt.pdx from ACPI records); on UEFI/T14 those callers will need their own platform_mmio_map registration in a later step. Leaf, read-only, caller-save scratch only (rax/rcx/rdx/r8/r9/r10/r11). Labels prefixed ioapic_bfg_ per reserved-label discipline.",
      block: {
        mov r8,  [rip + _ioapic_mmio_va];   // default base (mapped)
        xor r9,  r9;                        // best gsi_base seen so far

        lea r10, [rip + _madt_n_ioapics];
        mov r10, [r10 + 0];
        cmp r10, 0;
        je  ioapic_bfg_done;

        lea r11, [rip + _madt_scratch_ioapics];
        xor rcx, rcx;

      ioapic_bfg_loop:
        cmp rcx, r10;
        jae ioapic_bfg_done;

        // record addr = r11 + rcx * 24 (= rcx*8 + rcx*16)
        mov rax, rcx;
        shl rax, 3;
        mov rdx, rcx;
        shl rdx, 4;
        add rax, rdx;
        add rax, r11;

        // gsi_base (u32 @ +16) -> rdx
        mov edx, [rax + 16];

        cmp rdx, rdi;
        ja  ioapic_bfg_next;                // starts past our GSI
        cmp rdx, r9;
        jb  ioapic_bfg_next;                // not the highest so far

        mov r8, [rax + 8];
        mov r9, rdx;

      ioapic_bfg_next:
        add rcx, 1;
        jmp ioapic_bfg_loop;

      ioapic_bfg_done:
        mov rax, r8;
        ret
      }
    }

  // ============================================================================
  // ioapic_route_irq_via_madt(source_irq, vector, dest_apic_id) -> 1 | 0
  // ============================================================================
  //
  // SysV: (source_irq: u64, vector: u64, dest_apic_id: u64) -> u64
  //   rdi = source_irq (ISA IRQ number in low 8 bits)
  //   rsi = vector    (IDT vector in low 8 bits)
  //   rdx = dest      (destination APIC ID in low 8 bits, physical mode)
  //
  // Returns rax = 1 on success, 0 if the chosen IOAPIC's bounds check
  // in ioapic_program_redir rejects the resolved GSI.

  pub let ioapic_route_irq_via_madt : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (source_irq: u64, vector: u64, dest_apic_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-003 (#835): MADT-aware IOAPIC route helper. Wraps ioapic_program_redir with (1) ISA IRQ → GSI translation via madt_parse_isos results, (2) IOAPIC-owner discovery via madt_parse_ioapics results, and (3) MPS INTI flags → RTE flags translation. Falls back to platform defaults when the MADT scratch tables are empty (BIOS boot with no ACPI, or bring-up before topology_seed_from_madt has run). Body: (a) 5-push prologue (rbx=flags accumulator, r12=source_irq, r13=vector, r14=dest, r15=resolved gsi — all callee-save across the nested ioapic_program_redir call). rsp%16==8 entry → +40 → rsp%16==0 pre-call. (b) Initialize: r15=source_irq (identity fallback), rbx=0 (high/edge/fixed/physical/unmasked defaults). (c) ISO scan: iterate _madt_scratch_isos[0.._madt_n_isos) — each 16-byte record; compare u32 source_irq at +0 against r12; on match, extract u32 gsi at +4 into r15 and u32 mps_inti_flags at +8 for polarity/trigger derivation. MPS bits (1:0)==3 → set flags bit 8 (polarity=low); MPS bits (3:2)==3 → set flags bit 9 (trigger=level). First match wins (per ACPI 6.5 §5.2.12.5 a source_irq is spec-unique in the ISO stream). (d) IOAPIC-owner scan: iterate _madt_scratch_ioapics[0.._madt_n_ioapics) — each 24-byte record; compare u32 gsi_base at +16 against r15; if gsi_base <= r15, provisionally pick this IOAPIC's u64 mmio_base at +8 into a scratch reg. Since the scratch table isn't sorted, we keep the LAST match with gsi_base<=r15 that also has the highest gsi_base seen so far. If the table is empty (_madt_n_ioapics == 0), the fallback of 0xFEC00000 (ICH9/q35 default) stands. (e) Call ioapic_program_redir(base, r15, r13, r14, rbx) — its bounds check catches gsi >= MRE+1 (returns 0). (f) Return whatever ioapic_program_redir returned in rax. Encoder: mov reg,reg; cmp reg,reg; jne/jae/je; shl reg,imm; shr reg,imm; and reg,imm; or reg,imm; call — all pre-#835 proven.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // r12 = source_irq (masked to u8)
        mov r12, rdi;
        and r12, 0xFF;

        // r13 = vector, r14 = dest_apic_id
        mov r13, rsi;
        mov r14, rdx;

        // r15 = gsi (identity default = source_irq)
        mov r15, r12;

        // rbx = flags (default 0 = fixed/physical/high/edge/unmasked)
        xor rbx, rbx;

        // ---- ISO scan ----
        //   rcx = idx, r8 = count, r9 = table base
        xor rcx, rcx;
        mov r8, [rip + _madt_n_isos];
        lea r9, [rip + _madt_scratch_isos];

      iso_scan_loop:
        cmp rcx, r8;
        jae iso_scan_done;

        // record addr = r9 + rcx * 16
        mov rax, rcx;
        shl rax, 4;
        add rax, r9;

        // source_irq (u32 @ +0) → rdx (zero-ext)
        mov edx, [rax];
        cmp rdx, r12;
        jne iso_scan_next;

        // MATCH. Extract gsi (u32 @ +4) into r15.
        mov edx, [rax + 4];
        mov r15, rdx;

        // Extract mps_inti_flags (u32 @ +8) → derive polarity/trigger.
        mov edx, [rax + 8];

        // Reset rbx (in case a partial prior scan iteration touched it — it did not, but be defensive).
        xor rbx, rbx;

        // polarity: (mps & 3) == 3 → set RTE bit 8.
        mov r10, rdx;
        and r10, 3;
        cmp r10, 3;
        jne iso_pol_skip;
        or  rbx, 0x100;
      iso_pol_skip:

        // trigger: ((mps >> 2) & 3) == 3 → set RTE bit 9.
        mov r10, rdx;
        shr r10, 2;
        and r10, 3;
        cmp r10, 3;
        jne iso_trig_skip;
        or  rbx, 0x200;
      iso_trig_skip:

        // First match wins.
        jmp iso_scan_done;

      iso_scan_next:
        add rcx, 1;
        jmp iso_scan_loop;

      iso_scan_done:

        // ---- IOAPIC-owner scan ----
        //   R30.M4-001 (#1066): the scan that used to be inlined here is
        //   now ioapic_base_for_gsi above, so the SCI path and this path
        //   cannot disagree about which IOAPIC owns a GSI. r15 (gsi),
        //   rbx (flags), r12 (source_irq), r13 (vector) and r14 (dest)
        //   are all callee-save and survive the nested call; the 5-push
        //   prologue already leaves rsp%16 == 0 at the call boundary.
        mov rdi, r15;
        call ioapic_base_for_gsi;
        mov r8, rax;

        // ---- Call ioapic_program_redir(r8=base, r15=gsi, r13=vector, r14=dest, rbx=flags) ----
        mov rdi, r8;
        mov rsi, r15;
        mov rdx, r13;
        mov rcx, r14;
        mov r8,  rbx;
        call ioapic_program_redir;

        // rax holds the return value from ioapic_program_redir.
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ioapic_route_witness_legacy_isas — R111.M2-008 (paideia-os #2360)
  // ============================================================================
  //
  // SysV: () -> ()
  //
  // Walks the legacy ISA IRQ range [0..15] and asks
  // madt_iso_gsi_for_irq(irq) for the resolved GSI on each.  Tallies
  // `identity` (resolved gsi == irq) vs `overridden` (resolved gsi != irq)
  // and emits a single klog rollup:
  //
  //   INFO  boot  IOAPIC ROUTE OK identity=<n> overridden=<n>
  //
  // Where identity + overridden == 16 on every well-formed platform
  // (there are exactly 16 legacy ISA IRQs).  The `identity=16 overridden=0`
  // shape is what QEMU-TCG q35 / i440fx under `-kernel` produce (no MADT
  // reachable via the `-kernel` boot flow's env==0 path OR a MADT with no
  // ISOs); the T14 G4 / EPYC real-hardware shape typically shows
  // `identity=13 overridden=3` or similar (SCI ISO + IRQ0→GSI2 remap +
  // occasionally an IRQ9 legacy fixup).
  //
  // This is a diagnostic-only witness: it does NOT program any IOAPIC
  // Redirection Table Entries.  Actual RTE programming for a specific
  // legacy IRQ still flows through ioapic_route_irq_via_madt above (which
  // does its own inline ISO scan for GSI + polarity + trigger — the
  // extraction to madt_iso_gsi_for_irq is deliberately GSI-only, matching
  // the accessor's public contract; a caller that needs the full MPS
  // flags derivation should reach for ioapic_route_irq_via_madt directly).
  //
  // Coverage posture: the OK-token in tag_ioapic_route_ok is what
  // verify-fingerprint-coverage.sh looks for; the allowlist entry in
  // tools/verify-fingerprint-coverage.sh names the same "fires on every
  // boot, no golden pins the literal yet" posture the R111.M1-004
  // sibling entries (`ACPI RSDP HANDOFF OK`, `ACPI TABLES SUMMARY OK`)
  // already use.
  //
  // Register plan (3-push callee-save prologue, aligned for nested call):
  //   Prologue: push rbx, r12, r13 (+24 → rsp%16 goes 8→0).
  //   rbx = identity counter (u64, 0..16).
  //   r12 = overridden counter (u64, 0..16).
  //   r13 = irq loop cursor (u64, 0..15 inclusive).
  //   Body rsp%16 == 0 across the whole loop; each
  //   `call madt_iso_gsi_for_irq` sees rsp%16 == 0 at CALL boundary.
  //   The rollup emit brackets its ONE stack arg (v2 = overridden)
  //   with a `sub rsp, 8` pad + `push r12` (== 16 B, rsp%16 back to 0
  //   pre-CALL), then `add rsp, 16` restore.
  //
  // Encoder posture (paideia-as v0.36+ baseline):
  //   push/pop, mov reg,reg, mov reg,imm8, cmp reg,reg, cmp reg,imm8,
  //   je/jne/jae/jmp, add reg,imm8, lea reg,[rip+sym], sub rsp,imm8,
  //   push reg, call rel32, xor reg,reg, ret.  No test rN,rN; no `and
  //   reg,imm64`; no 2-op `imul reg,imm`; no `cmp reg,[mem]`.  Labels
  //   prefixed `ioapic_wla_` per reserved-label discipline.

  pub let ioapic_route_witness_legacy_isas : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R111.M2-008 (paideia-os #2360). Legacy ISA IRQ [0..15] MADT ISO resolution rollup. Walks each IRQ through the public madt_iso_gsi_for_irq accessor, tallies identity vs overridden, and emits a single `INFO boot IOAPIC ROUTE OK identity=<n> overridden=<n>` klog rollup via klog_s1_d2 (2 decimal KVs). Body: (a) 3-push callee-save prologue (rbx=identity counter, r12=overridden counter, r13=irq cursor). Entry rsp%16==8; 3 pushes = 24 B → rsp%16==0 in body. All three regs are SysV callee-save, so the nested `call madt_iso_gsi_for_irq` (which uses only caller-save scratch rax/rcx/rdx/r10/r11 per its own justification) preserves them across the call. (b) Init: xor rbx,rbx; xor r12,r12; xor r13,r13. (c) Loop: cmp r13, 16; jae done; mov rdi, r13; call madt_iso_gsi_for_irq; cmp rax, r13; if equal → identity path (add rbx,1); else → overridden path (add r12,1). Bump r13, jmp loop. (d) Rollup emit: klog_s1_d2 signature = rdi=level, rsi=subsys, rdx=tag, rcx=k1, r8=v1, r9=k2, [rsp+8]=v2. Body rsp%16==0 → sub rsp, 8 (pad) + push r12 (v2 = overridden) = 16 B → rsp%16==0 pre-CALL. Register args: rdi=3 (LEVEL_INFO), rsi=SUBSYS_BOOT (matching the phase1 sibling fingerprints' subsys choice), rdx=tag_ioapic_route_ok, rcx=k_identity, r8=rbx (v1 = identity), r9=k_overridden. Call klog_s1_d2; add rsp, 16. (e) 3-pop epilogue + ret. Encoder-gap posture (v0.36+): only proven mnemonics. Labels ioapic_wla_ prefixed per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        xor rbx, rbx;                          // identity = 0
        xor r12, r12;                          // overridden = 0
        xor r13, r13;                          // irq = 0

      ioapic_wla_loop:
        cmp r13, 16;
        jae ioapic_wla_emit;

        // gsi = madt_iso_gsi_for_irq(irq)
        mov rdi, r13;
        call madt_iso_gsi_for_irq;

        // if (gsi == irq) identity++; else overridden++;
        cmp rax, r13;
        jne ioapic_wla_over;
        add rbx, 1;
        jmp ioapic_wla_bump;

      ioapic_wla_over:
        add r12, 1;

      ioapic_wla_bump:
        add r13, 1;
        jmp ioapic_wla_loop;

      ioapic_wla_emit:
        // klog_s1_d2(INFO, SUBSYS_BOOT, tag_ioapic_route_ok,
        //            k_identity, rbx /*identity*/,
        //            k_overridden, [rsp+8]=r12 /*overridden*/)
        //
        // Body rsp%16 == 0; one 8-byte pad + one 8-byte push = 16 B →
        // rsp%16 back to 0 pre-CALL.  Callee sees v2 at [rsp+8].
        sub rsp, 8;                            // alignment pad
        push r12;                              // v2 = overridden

        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_ioapic_route_ok];
        lea rcx, [rip + k_identity];           // k1
        mov r8, rbx;                           // v1 = identity
        lea r9, [rip + k_overridden];          // k2

        call klog_s1_d2;
        add rsp, 16;                           // pop push + pad

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
