// src/kernel/core/apic/x2apic.pdx — R21-M5-003 (#844)
//
// x2APIC (Extended Local APIC) probe + MSR-mode helpers.
//
// x2APIC replaces the 32-bit MMIO xAPIC interface at 0xFEE00000 with
// a 64-bit MSR interface at MSRs 0x800..0x83F. The transition is
// selected by setting IA32_APIC_BASE bit 10 (X2APIC_ENABLE) alongside
// bit 11 (XAPIC global enable). Once enabled:
//
//   * All LAPIC registers are accessed via rdmsr/wrmsr at MSRs
//     0x800 + (mmio_offset >> 4).
//   * The 8-bit destination field grows to 32 bits, unblocking
//     >255-CPU topologies (relevant for future server hardware).
//   * MMIO access at 0xFEE00000 is DISABLED — any write there
//     produces undefined behaviour per Intel SDM Vol 3A §10.12.2.
//     This makes x2APIC enable a whole-kernel atomic switch: every
//     xAPIC MMIO consumer (eoi.pdx / tpr.pdx / ipi.pdx /
//     self_ipi.pdx / lapic_timer.pdx / tsc_deadline.pdx / and
//     init_sipi.pdx's ICR encoding) must migrate to MSR access
//     together.
//
// -----------------------------------------------------------------------------
// R21.M5 policy: PROBE-ONLY, defer enable + xAPIC retirement
// -----------------------------------------------------------------------------
//
// #844 lands the substrate (probe fn + read/write MSR helpers) plus
// a boot fingerprint indicating availability. It does NOT enable
// x2APIC because #845 (retire xAPIC MMIO code paths) is a large-
// surface refactor with SMP as the primary regression gate. Enabling
// x2APIC without first retiring MMIO would silently break every
// downstream IPI / EOI / LAPIC-timer path — boot_smp would fail on
// the first inter-CPU IPI attempt.
//
// The retirement + enable is scheduled for R22.M1 (or an intra-R21
// follow-up if the T14 G4 fixture arrives), tracked as #845 →
// deferred with rationale in the R21 closure retro.
//
// -----------------------------------------------------------------------------
// MSR layout for x2APIC (Intel SDM Vol 3A §10.12.1.2)
// -----------------------------------------------------------------------------
//
//   MSR 0x1B    IA32_APIC_BASE
//               [10]  X2APIC_ENABLE
//               [11]  XAPIC_ENABLE (global)
//               [12:35] APIC base PA (irrelevant in x2APIC)
//   MSR 0x800   APIC_ID           (32-bit ID; contrast xAPIC 8-bit)
//   MSR 0x801   APIC_VERSION
//   MSR 0x80B   EOI               (write 0; no-op reads)
//   MSR 0x830   ICR               (single 64-bit; contrast xAPIC 2×32)
//   MSR 0x832   LVT_TIMER
//   MSR 0x838   TIMER_INIT_COUNT
//   MSR 0x839   TIMER_CURR_COUNT
//   MSR 0x83E   TIMER_DIV_CONFIG
//
// Convention: MSR = 0x800 + (mmio_offset >> 4). ICR gets a single
// MSR (0x830) because the 32-bit dest field is now part of the
// 64-bit ICR word — no separate ICR_HI needed.

module X2apic = structure {
  // ============================================================================
  // MSR + CPUID constants
  // ============================================================================

  // CPUID.01H:ECX bit 21 → x2APIC supported.
  pub let CPUID_01_ECX_X2APIC     : u64 = 0x200000    // bit 21

  // IA32_APIC_BASE.
  pub let IA32_APIC_BASE_MSR      : u64 = 0x1B
  pub let APIC_BASE_X2APIC_ENABLE : u64 = 0x400       // bit 10
  pub let APIC_BASE_XAPIC_ENABLE  : u64 = 0x800       // bit 11 (global)

  // x2APIC MSR base — plain LAPIC register i lives at (0x800 + (i >> 4)).
  pub let X2APIC_MSR_BASE         : u64 = 0x800

  // ============================================================================
  // _x2apic_supported — 1 iff CPUID.01H:ECX bit 21 is set (populated by
  // x2apic_probe_bsp; 0 means "not yet probed" or "unsupported").
  // ============================================================================

  pub let mut _x2apic_supported : u64 = 0

  // ============================================================================
  // _x2apic_active — 1 iff the calling CPU (and by extension the system) is
  // in x2APIC MSR mode. Set by x2apic_enable_this_cpu on each CPU that
  // successfully enables. Read by every LAPIC MMIO consumer (apic_eoi,
  // apic_tpr_init, apic_svr_enable, lapic_timer_init, lapic_write_icr,
  // apic_send_self_ipi, lapic_send_init_ipi, lapic_send_startup_ipi,
  // lapic_timer_init_tsc_deadline) as a per-boot dispatch flag: nonzero
  // routes the operation via wrmsr on the corresponding x2APIC MSR;
  // zero falls through to the existing xAPIC MMIO code path.
  //
  // Global-not-per-CPU rationale: the enable is applied to every CPU
  // (BSP in kernel_main after x2apic_probe_bsp; each AP in ap_entry
  // after gs_base_init_ap), gated on _x2apic_supported. Between BSP
  // enable and AP enable, the BSP-side IPI to APs uses x2APIC MSR
  // path; the AP receives on xAPIC MMIO — this is spec-legal (SDM
  // Vol 3A §10.12: source/dest mode independence for delivery) and
  // the transient window is bounded by INIT/SIPI/AP-boot latency.
  // The flag transitions 0 → 1 once at BSP-enable time (never back
  // to 0); reads race-free without synchronization.
  //
  // On QEMU-TCG (no x2APIC): _x2apic_supported stays 0, BSP and APs
  // skip enable, _x2apic_active stays 0 forever → all consumers
  // continue to use xAPIC MMIO exactly as they did in R21. This is
  // the boot_smp fallback path.

  pub let mut _x2apic_active : u64 = 0

  // ============================================================================
  // x2apic_probe() -> u64
  // ============================================================================
  //
  // CPUID.01H:ECX bit 21 test. Returns 1 iff the CPU advertises
  // x2APIC support; 0 otherwise. Modern hardware (Nehalem+, all AMD
  // Bulldozer+) advertises the bit; QEMU exposes it under `-cpu max`
  // and `-cpu host`; qemu64 default does not (matches the
  // tsc_deadline_available idiom in apic/tsc_deadline.pdx L93).
  //
  // Leaf; no callee-save touch. Register: cpuid clobbers rax/rbx/rcx/rdx
  // (all SysV caller-save).

  pub let x2apic_probe : () -> u64 !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R21-M5-003 (#844). CPUID leaf 1 feature detection for x2APIC. Load rax=1, cpuid; test ECX bit 21 (mask 0x200000). Non-zero → return 1 (feature present); zero → return 0. Mirrors the tsc_deadline_available (apic/tsc_deadline.pdx L93) CPUID-gate idiom exactly. Modern x86 (Nehalem+, all AMD Bulldozer+) advertises the bit; QEMU with -cpu max or -cpu host exposes it, plain -cpu qemu64 does not. Encoder: cpuid (0F A2) and rcx, imm32; cmp/je/mov — all pre-existing. Leaf; rax/rbx/rcx/rdx all caller-save.",
      block: {
        mov rax, 1;
        cpuid;
        and rcx, 0x200000;                        // ECX bit 21
        cmp rcx, 0;
        je x2apic_probe_no;
        mov rax, 1;
        ret;

        x2apic_probe_no:
        mov rax, 0;
        ret
      }
    }

  // ============================================================================
  // x2apic_probe_bsp() — BSP-once probe with fingerprint emission
  // ============================================================================
  //
  // Wrapper for x2apic_probe: called from kernel_main once on the BSP,
  // publishes _x2apic_supported, and emits "X2APIC AVAILABLE" or
  // "X2APIC ABSENT" fingerprint. Not called on APs — APs enumerate
  // via IA32_APIC_BASE readback in the per-CPU init path (deferred).
  //
  // Register: 0-push leaf but does nested calls. Entry rsp%16==8;
  // nested call to klog_s1 needs rsp%16==0 — use sub/add rsp,8.

  pub let x2apic_probe_bsp : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M5-003 (#844) + R51 Phase C (SUBSYS_APIC shard, design/kernel/boot-transcript.md §7). BSP-once x2APIC probe with fingerprint. (1) call x2apic_probe (returns 1/0 in rax). (2) Store rax → _x2apic_supported. (3) Branch on rax: nonzero → klog_s1(INFO, SUBSYS_APIC, tag_x2apic_available_narrative); zero → klog_s1(INFO, SUBSYS_APIC, tag_x2apic_absent_narrative). SUBSYS_APIC chosen over SUBSYS_TIME because this concerns interrupt-controller substrate. R51 rewrite: old tags `X2APIC AVAILABLE` and `X2APIC ABSENT` renamed to their `_narrative` counterparts (`x2APIC supported on this CPU [legacy: X2APIC AVAILABLE]` and `x2APIC not present on this CPU [legacy: X2APIC ABSENT]`) via memo §5.1 option-B bracketed legacy suffix.  No golden asserts either marker (grep tests/ returns zero hits) and neither carries an OK token, so the rewrite is coverage-neutral and golden-neutral.  The bracketed markers preserve operator grep parity with the pre-R51 wire and with tools/nvme-hw-smoke.md / tools/pdxfs-lite-e2e-smoke.md prose that names the historic markers.  Old tags deleted from keys.pdx (sole consumer was this file).  Stack: 1 callee-save push (rbx) preserves the probe result across the store + klog call, aligning rsp%16==0 pre-call. sub/add rsp,8 alternative rejected because we need to preserve the value across two calls anyway. Not enabling x2APIC here — enabling would silently disable xAPIC MMIO (SDM Vol 3A §10.12.2), breaking every downstream eoi.pdx / tpr.pdx / ipi.pdx / lapic_timer.pdx callsite. The full enable + MMIO retirement is #845, deferred to R22.M1 (see design/round-retrospectives/r21-closure.md 'What Didn't Work'). Encoder: mov / cmp / jne / call / lea — all pre-existing.",
      block: {
        push rbx;

        // (1) rax = x2apic_probe().
        call x2apic_probe;
        mov rbx, rax;                             // stash across store + klog

        // (2) _x2apic_supported = rbx.
        mov [rip + _x2apic_supported], rbx;

        // (3) Emit fingerprint.
        cmp rbx, 0;
        je x2apic_probe_bsp_absent;

        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_APIC];
        lea rdx, [rip + tag_x2apic_available_narrative];
        call klog_s1;
        pop rbx;
        ret;

      x2apic_probe_bsp_absent:
        mov rdi, 3;                               // LEVEL_INFO (informational; qemu64 default hits this)
        lea rsi, [rip + SUBSYS_APIC];
        lea rdx, [rip + tag_x2apic_absent_narrative];
        call klog_s1;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // x2apic_enable_this_cpu() — DORMANT
  // ============================================================================
  //
  // Reads IA32_APIC_BASE (MSR 0x1B), sets X2APIC_ENABLE bit 10 while
  // preserving XAPIC_ENABLE bit 11, writes back. After this executes
  // the calling CPU responds ONLY to MSR-based APIC access; xAPIC
  // MMIO at 0xFEE00000 is silently disabled per SDM Vol 3A §10.12.2.
  //
  // NOT called from kernel_main under R21.M5 — full xAPIC retirement
  // (#845) is deferred. Kept as the concrete implementation the
  // future retirement issue will wire in, and as a compile-time
  // proof that the substrate is ready.
  //
  // If a caller invokes this today without first retiring the xAPIC
  // MMIO consumers, expect boot_smp to fail on the first IPI attempt.

  pub let x2apic_enable_this_cpu : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-002 (#845). Enable x2APIC on the calling CPU by setting IA32_APIC_BASE.X2APIC (bit 10) alongside the XAPIC global-enable (bit 11). Sequence: (1) mov rcx, 0x1B (IA32_APIC_BASE_MSR); rdmsr → EDX:EAX. (2) Reconstruct u64 in rax: shl rdx,32; or rax,rdx. (3) or rax, 0xC00 (both bits 10 and 11 — architecturally required to preserve XAPIC enable per SDM Vol 3A §10.12.1). (4) mov rdx, rax; shr rdx, 32 → EDX:EAX. (5) wrmsr. Per Intel SDM Vol 3A §10.12.2: after this write, the CPU is in x2APIC mode; MMIO xAPIC access at 0xFEE00000 is disabled. (6) Store 1 → _x2apic_active — publishes the dispatch flag every LAPIC-MMIO consumer (apic_eoi / apic_tpr_init / apic_svr_enable / lapic_timer_init / lapic_write_icr / apic_send_self_ipi / lapic_send_init_ipi / lapic_send_startup_ipi / lapic_timer_init_tsc_deadline) reads at entry to route through the x2APIC MSR path instead of the retired MMIO path. Effect widened from {sysreg} to {sysreg, mem} — {mem} covers the _x2apic_active store. Leaf; all clobbered regs (rax/rcx/rdx) caller-save.",
      block: {
        mov rcx, 0x1B;                             // IA32_APIC_BASE_MSR
        rdmsr;                                     // EDX:EAX = APIC_BASE
        shl rdx, 32;
        or rax, rdx;
        or rax, 0xC00;                             // X2APIC_ENABLE | XAPIC_ENABLE
        mov rdx, rax;
        shr rdx, 32;
        mov rcx, 0x1B;
        wrmsr;

        // (6) Publish dispatch flag — every LAPIC MMIO consumer reads this
        // at entry and routes to x2APIC MSR path if nonzero.
        mov rax, 1;
        mov [rip + _x2apic_active], rax;
        ret
      }
    }

  // ============================================================================
  // x2apic_enable_bsp() — BSP-only wrapper (gated on _x2apic_supported)
  // ============================================================================
  //
  // Called from kernel_main after x2apic_probe_bsp. If the BSP probe
  // did NOT find x2APIC (qemu64 default, TCG, pre-Nehalem), this is
  // a no-op — the kernel continues in xAPIC MMIO mode and _x2apic_active
  // stays 0. If x2APIC IS supported, enables it and emits the
  // "X2APIC ENABLED BSP" fingerprint.
  //
  // Register: 1 callee-save push (rbx) preserves nothing important —
  // we use sub/add rsp,8 for alignment. Two nested calls (enable_this_cpu
  // + klog_s1).

  pub let x2apic_enable_bsp : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-002 (#845) + R51 Phase C (SUBSYS_APIC shard, design/kernel/boot-transcript.md §7). BSP-only x2APIC enable orchestrator. (1) Load _x2apic_supported (populated by earlier x2apic_probe_bsp). (2) If zero → return immediately (no-op; kernel continues in xAPIC MMIO mode). (3) Otherwise call x2apic_enable_this_cpu → CPU switches to x2APIC MSR mode; _x2apic_active := 1. (4) Emit klog_s1(LEVEL_INFO, SUBSYS_APIC, tag_x2apic_enabled_bsp_narrative) as the fingerprint proving the switch landed. R51 rewrite: tag_x2apic_enabled_bsp (`X2APIC ENABLED BSP`) renamed to tag_x2apic_enabled_bsp_narrative (`x2APIC MSR mode enabled on BSP [legacy: X2APIC ENABLED BSP]`) via memo §5.1 option-B bracketed legacy suffix.  No golden asserts `X2APIC ENABLED BSP` and the marker carries no OK token, so the rewrite is coverage-neutral and golden-neutral.  The bracketed marker preserves operator grep parity with tools/nvme-hw-smoke.md and tools/pdxfs-lite-e2e-smoke.md prose that names the historic wire string.  Old tag deleted from keys.pdx (sole consumer).  Two nested calls; both leaves needing rsp%16==0 pre-call. sub rsp,8 at entry establishes the alignment (entry rsp%16==8 → sub 8 → rsp%16==0), maintained across both calls. add rsp,8 at exit restores. Encoder: mov / cmp / je / call / lea / sub / add / ret — all pre-existing. Not gated on any per-CPU flag: BSP is the only caller by convention (ap_entry uses x2apic_enable_ap).",
      block: {
        sub rsp, 8;

        mov rax, [rip + _x2apic_supported];
        cmp rax, 0;
        je x2apic_enable_bsp_skip;

        call x2apic_enable_this_cpu;

        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_APIC];
        lea rdx, [rip + tag_x2apic_enabled_bsp_narrative];
        call klog_s1;

      x2apic_enable_bsp_skip:
        add rsp, 8;
        ret
      }
    }

  // ============================================================================
  // x2apic_enable_ap() — AP-side per-CPU wrapper (gated on _x2apic_supported)
  // ============================================================================
  //
  // Called from ap_entry.pdx after gs_base_init_ap has programmed IA32_GS_BASE.
  // Each AP independently checks _x2apic_supported (already set by BSP
  // during its own probe) and, if nonzero, enables x2APIC on this AP.
  // No fingerprint — APs would race the serial line; the BSP's
  // X2APIC ENABLED BSP is the single-source witness.

  pub let x2apic_enable_ap : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-002 (#845). AP-side x2APIC enable. Each AP reads _x2apic_supported (BSP-populated) once and, if nonzero, calls x2apic_enable_this_cpu to switch this AP into x2APIC MSR mode. Idempotent under repeated invocation on the same AP (wrmsr APIC_BASE with X2APIC + XAPIC bits is safe to repeat per SDM §10.12.1). No fingerprint — AP fingerprints in ap_entry (CPU_ID_XX_HELLO, GS_OK_XX) race the serial line under 4-CPU boot_smp; a single-line 'X2APIC ENABLED AP N' would interleave garbled. The BSP's X2APIC ENABLED BSP is the sufficient witness that the dispatch path is armed. sub/add rsp,8 for SysV 16-B alignment across the nested call. Leaf otherwise.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _x2apic_supported];
        cmp rax, 0;
        je x2apic_enable_ap_skip;

        call x2apic_enable_this_cpu;

      x2apic_enable_ap_skip:
        add rsp, 8;
        ret
      }
    }

  // ============================================================================
  // x2apic_read(reg_offset: u32) -> u64
  // ============================================================================
  //
  // Read x2APIC MSR reg_offset >> 4 (converting the xAPIC MMIO byte
  // offset to the corresponding MSR index). Returns the u64 value.
  //
  // Callers pass the pre-x2APIC xAPIC MMIO offset (e.g. 0xB0 for EOI)
  // rather than the raw MSR (0x80B) so the migration is a pure
  // MMIO-store → x2apic_write substitution at each callsite. This
  // matches the design in #845 — the retirement issue will do
  // a mechanical rewrite of every xAPIC MMIO callsite to invoke
  // x2apic_read / x2apic_write.
  //
  // Args: rdi = xAPIC MMIO offset (u32 in low 32 bits).
  // Returns: rax = MSR value (u64 — for 32-bit-only LAPIC regs, high
  // half is 0 per SDM §10.12.1.1).
  //
  // Leaf; rax/rcx/rdx SysV caller-save. Only safe to call AFTER
  // x2apic_enable_this_cpu.

  pub let x2apic_read : (u64) -> u64 !{sysreg} @{boot} =
    fn (reg_offset: u64) -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R21-M5-003 (#844). Read x2APIC MSR at index 0x800 + (reg_offset >> 4). Convert xAPIC MMIO offset to MSR index in place: rcx = rdi >> 4; add rcx, 0x800. Then rdmsr → EDX:EAX; reconstruct u64 in rax via shl rdx,32; or rax,rdx. Per Intel SDM Vol 3A §10.12.1.1, LAPIC MSR reads return the register value zero-extended to 64 bits for the 32-bit-only registers (EOI, LVT_TIMER, TPR, etc.) — the high half of rax is 0 for those. Only ICR (MSR 0x830) uses the full 64-bit width. Encoder: shr / add / rdmsr / shl / or — all pre-existing. Leaf; rax/rcx/rdx SysV caller-save. PRECONDITION: x2apic_enable_this_cpu has been called on this CPU; rdmsr of an x2APIC MSR when x2APIC is disabled raises #GP per SDM §10.12.1.3.",
      block: {
        mov rcx, rdi;
        shr rcx, 4;
        add rcx, 0x800;                            // X2APIC_MSR_BASE
        rdmsr;
        shl rdx, 32;
        or rax, rdx;
        ret
      }
    }

  // ============================================================================
  // x2apic_write(reg_offset: u32, value: u64) -> ()
  // ============================================================================
  //
  // Write x2APIC MSR reg_offset >> 4. For 32-bit-only registers pass
  // the value in the low 32 bits of rsi (high half is architecturally
  // zero-extended per SDM §10.12.1.1). For ICR (offset 0x300 → MSR
  // 0x830) the full 64-bit rsi encodes {vector, delivery mode, dest
  // shorthand, dest APIC ID}.

  pub let x2apic_write : (u64, u64) -> () !{sysreg} @{boot} =
    fn (reg_offset: u64, value: u64) -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R21-M5-003 (#844). Write x2APIC MSR at index 0x800 + (reg_offset >> 4) with 64-bit value in rsi. Sequence: (1) mov rax, rsi (low 32 bits become EAX). (2) mov rdx, rsi; shr rdx, 32 (high 32 bits become EDX). (3) mov rcx, rdi; shr rcx, 4; add rcx, 0x800. (4) wrmsr — atomic 64-bit write per SDM Vol 3A §10.12.1.1. For 32-bit-only registers callers pass value in low 32 bits (rsi < 2^32); the high half is architecturally required to be zero per SDM §10.12.1.1 or the wrmsr raises #GP. Only ICR (offset 0x300) uses the full 64-bit width. Encoder: mov / shr / add / wrmsr — all pre-existing. Leaf; rax/rcx/rdx SysV caller-save. PRECONDITION: x2apic_enable_this_cpu has been called on this CPU; wrmsr to an x2APIC MSR when x2APIC is disabled raises #GP.",
      block: {
        mov rax, rsi;                              // EAX = low 32 of value
        mov rdx, rsi;
        shr rdx, 32;                               // EDX = high 32 of value

        mov rcx, rdi;
        shr rcx, 4;
        add rcx, 0x800;

        wrmsr;
        ret
      }
    }
}
