// src/kernel/core/apic/eoi.pdx — Phase 6 / R9-m2-003
// End-of-Interrupt (EOI) Helper
// Issue: #358
//
// Issues EOI (End-of-Interrupt) signal to the LAPIC to acknowledge interrupt processing
// and re-enable lower-priority interrupts.

module Eoi = structure {
  // ============================================================================
  // EOI Constants and MMIO
  // ============================================================================

  // LAPIC EOI register (MMIO @ 0xFEE00000 + 0xB0).
  let LAPIC_EOI_OFFSET : u64 = 0xB0
  let LAPIC_MMIO_BASE : u64 = 0xFEE00000

  // Spurious interrupt vector (0xFF) — no EOI needed
  let SPURIOUS_VECTOR : u64 = 0xFF

  // ============================================================================
  // EOI Operation (R9-m2-003)
  // ============================================================================
  // Procedure:
  //   1. Write 0 to LAPIC EOI register (MMIO 0xFEE000B0)
  //   2. This signals end-of-interrupt to the LAPIC
  //   3. LAPIC will acknowledge the interrupt and re-enable lower priorities
  //
  // Note: LAPIC EOI writes are 32-bit; we write 0 to the register.

  pub let apic_eoi : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R22-M1-002 (#845). Signal EOI to LAPIC. Entry dispatch on _x2apic_active: nonzero → wrmsr IA32_X2APIC_EOI (MSR 0x80B = 0x800 + (0xB0 >> 4)) with value 0 — writing zero to the EOI MSR is the x2APIC EOI mechanism per SDM Vol 3A §10.12.7. Zero → fall through to the xAPIC MMIO write at 0xFEE000B0 (retained as the QEMU-TCG fallback path). Retirement posture: this MMIO write path is the fallback branch; x2APIC is primary on real HW/KVM. Under TCG (which lacks CPUID.01H:ECX bit 21) _x2apic_active stays 0, dispatch falls through, and the module behaves exactly as R21. Encoder: mov / cmp / jne / wrmsr / xor / mov_d — all pre-existing.",
    block: {
      // R22-M1 (#845): x2APIC dispatch.
      mov rax, [rip + _x2apic_active];
      cmp rax, 0;
      jne apic_eoi_x2apic;

      // ---- xAPIC MMIO fallback path (R21 posture) ----
      // #662 Fix B: mov_d (sized 32-bit) to bypass paideia-as elaborator gap
      // that widens bare `mov [rax], ecx` to REX.W 64-bit store.
      mov rax, 0xFEE000B0;
      xor rcx, rcx;
      mov_d [rax], rcx;
      ret;

    apic_eoi_x2apic:
      // ---- x2APIC MSR path: wrmsr(IA32_X2APIC_EOI=0x80B, 0) ----
      mov rcx, 0x80B;
      xor rax, rax;
      xor rdx, rdx;
      wrmsr;
      ret
    }
  }
}
