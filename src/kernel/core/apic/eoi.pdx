// src/kernel/core/apic/eoi.pdx — Phase 6 / R9-m2-003
// End-of-Interrupt (EOI) Helper
// Issue: #358
//
// Issues EOI (End-of-Interrupt) signal to the LAPIC to acknowledge interrupt processing
// and re-enable lower-priority interrupts.

module Eoi = structure {
  // ============================================================================
  // EOI Constants and MMIO
  // ============================================================================

  // LAPIC EOI register (MMIO @ 0xFEE00000 + 0xB0).
  let LAPIC_EOI_OFFSET : u64 = 0xB0
  let LAPIC_MMIO_BASE : u64 = 0xFEE00000

  // Spurious interrupt vector (0xFF) — no EOI needed
  let SPURIOUS_VECTOR : u64 = 0xFF

  // ============================================================================
  // EOI Operation (R9-m2-003)
  // ============================================================================
  // Procedure:
  //   1. Write 0 to LAPIC EOI register (MMIO 0xFEE000B0)
  //   2. This signals end-of-interrupt to the LAPIC
  //   3. LAPIC will acknowledge the interrupt and re-enable lower priorities
  //
  // Note: LAPIC EOI writes are 32-bit; we write 0 to the register.

  pub let apic_eoi : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "boot-mmio-mapping step 4 (design/kernel/boot-mmio-mapping.md). Signal EOI to LAPIC via the platform-mapped xAPIC MMIO window. Fallback path now composes the EOI-register address from _xapic_mmio_va (populated at boot by platform_map_early_mmio via platform_mmio_map — runs at kernel_main.pdx right after pat_init_this_cpu, well before any ISR can fire) plus the +0xB0 offset, rather than materializing hard-coded 0xFEE000B0. On PVH -kernel boots _xapic_mmio_va holds the identity VA (0xFEE00000) via the MAP_HUGE fallback so the emitted addr is byte-identical to the pre-step-4 value; on UEFI/T14 it holds a higher-half PML4[321] VA so the same code walks a properly mapped kernel VA. Original R22-M1-002 (#845) rationale preserved: Entry dispatch on _x2apic_active — nonzero → wrmsr IA32_X2APIC_EOI (MSR 0x80B = 0x800 + (0xB0 >> 4)) with value 0 (SDM Vol 3A §10.12.7); zero → xAPIC MMIO fallback. x2APIC is primary on real HW/KVM; TCG (no CPUID.01H:ECX bit 21) keeps _x2apic_active at 0 and always hits the fallback. #662 Fix B mov_d idiom still used for the 32-bit store (LAPIC MMIO is strictly 32-bit per SDM §10.4.1; bare `mov [rax], ecx` widens to REX.W and spills into the adjacent register slot). Encoder: mov (rip-rel mem load) / cmp / jne / wrmsr / xor / add r64,imm8 / mov_d — all pre-existing.",
    block: {
      // R22-M1 (#845): x2APIC dispatch.
      mov rax, [rip + _x2apic_active];
      cmp rax, 0;
      jne apic_eoi_x2apic;

      // ---- xAPIC MMIO fallback path (boot-mmio-mapping step 4) ----
      // Load the mapped xAPIC MMIO base + EOI offset (0xB0). _xapic_mmio_va
      // is populated at boot by platform_map_early_mmio. #662 Fix B: mov_d
      // (sized 32-bit) bypasses the paideia-as elaborator gap that widens
      // bare `mov [rax], ecx` to REX.W 64-bit.
      mov rax, [rip + _xapic_mmio_va];
      add rax, 0xB0;
      xor rcx, rcx;
      mov_d [rax], rcx;
      ret;

    apic_eoi_x2apic:
      // ---- x2APIC MSR path: wrmsr(IA32_X2APIC_EOI=0x80B, 0) ----
      mov rcx, 0x80B;
      xor rax, rax;
      xor rdx, rdx;
      wrmsr;
      ret
    }
  }
}
