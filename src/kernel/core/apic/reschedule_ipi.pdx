// src/kernel/core/apic/reschedule_ipi.pdx — R18-M4-002 / #772
// Cross-CPU reschedule IPI — vector reservation + sender wrapper
// Issue: paideia-os/paideia-os#772
//
// Exports:
//   RESCHEDULE_VECTOR : u64 = 0xF1
//     The IPI vector reserved for cross-CPU reschedule requests. Chosen at
//     0xF1 for continuity with R14b-m5-006 (#511) which pre-allocated this
//     vector for reschedule semantics in the reserved user-defined IPI
//     range 0xF0..0xFE (SDM Vol 3A §10.6.2 — vectors 0x10..0xFF are
//     available for OS use; the 0xF0-0xFE tail is by convention reserved
//     for high-priority IPI traffic where the LAPIC TPR window matters).
//     Reusing 0xF1 avoids re-plumbing IDT / KPTI entry stub / trampoline
//     that R14b-m5-006 already landed:
//       - IDT vec 241 wired to _isr_stub_241 in int/idt.pdx idt_install().
//       - _isr_stub_241 in int/isr_trampoline.pdx (KPTI CR3 flip stub).
//       - _ipi_trampoline_f1 in ipi/vectors.pdx (15-GPR save + apic_eoi +
//         handler call + iretq).
//       - _ipi_handler_f1 in ipi/vectors.pdx — upgraded from R14b-era
//         counter stub to real per-CPU preempt_needed setter by #772.
//
//   lapic_send_reschedule_ipi(target_apic_id: u64) -> ()
//     Fixed-mode, physical-destination reschedule IPI to target_apic_id.
//     Thin wrapper over lapic_send_ipi_fixed(target, RESCHEDULE_VECTOR).
//     The receiving CPU's IDT-vec-241 dispatch path apic_eoi's then invokes
//     _ipi_handler_f1, which writes 1 to [gs:PERCPU_OFF_PREEMPT_NEEDED]
//     (+48 per Percpu layout). The receiver's next IRQ-tail preempt check
//     (trampoline_vec32 tail; future syscall-return / #PF-return tails
//     added alongside R18.M4-007) consumes the flag and reschedules via
//     sched_pick_next_r15 + sched_switch_r15.
//
// Testability (R18.M4 posture):
//   - BSP-self dispatch (lapic_send_reschedule_ipi(bsp_apic_id)) is
//     immediately testable: BSP has IDT + GS_BASE + LAPIC SVR/TPR
//     programmed (#766). The AC in issue #772 ("BSP wakes a task on AP-3;
//     AP-3 preempts within one tick") requires AP-side IDT install first —
//     APs today halt in cli;hlt per #762 with no IDT loaded, so any IPI
//     to an AP would #GP on delivery. AP-IDT install is a peer R18.M3
//     item; once it lands, this sender + the existing handler close the
//     acceptance fixture with no code change on this side.
//   - Self-target (loopback) sends via lapic_send_ipi_self (self_ipi.pdx)
//     with vector = RESCHEDULE_VECTOR is a strictly cheaper witness path
//     that avoids the target-lookup and ICR_HI destination byte entirely;
//     both paths land at the same _ipi_handler_f1 entry.
//
// Non-goals:
//   - Broadcast reschedule (all-CPUs shorthand-10/11). The unicast form is
//     the R18.M4 primitive; broadcast reschedule lands with the load-
//     balancer work in R19/R20 alongside the runqueue steal path.
//   - Priority tagging (LAPIC TPR-aware vector selection). Reserved for
//     the R21+ deadline-aware scheduler; 0xF1 remains the single-priority
//     reschedule vector until then.
//
// Encoder: paideia-as v0.20.1+ (mov imm64 + sub/add rsp + call/ret). No
// new gaps.

module RescheduleIpi = structure {
  // Reserved IPI vector for cross-CPU reschedule (see header block).
  pub let RESCHEDULE_VECTOR : u64 = 0xF1

  // ============================================================================
  // lapic_send_reschedule_ipi(target_apic_id) — send RESCHEDULE_VECTOR
  // ============================================================================
  // RDI = target APIC ID (xAPIC 8-bit; forwarded to lapic_send_ipi_fixed
  // which masks with 0xFF). Composes RSI = RESCHEDULE_VECTOR (0xF1) and
  // tail-calls lapic_send_ipi_fixed.
  //
  // Callee-clobber: RAX, RCX, RDX (via base helper's ICR MMIO writes).
  // RDI consumed.
  pub let lapic_send_reschedule_ipi : (u64) -> () !{sysreg, mem} @{boot} =
    fn (target_apic_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#772 R18-M4-002: cross-CPU reschedule IPI dispatch. Composes RSI = RESCHEDULE_VECTOR (0xF1) — the vector byte consumed by lapic_send_ipi_fixed's ICR_LO composition (which masks with 0xFF and ORs into ICR_SHORTHAND_NONE_BASE 0x4000). RDI carries target_apic_id through untouched. sub rsp,8 / add rsp,8 keeps 16-byte SysV alignment across the nested `call lapic_send_ipi_fixed` — matches the alignment idiom in lapic_send_ipi_self / lapic_send_ipi_broadcast_* in apic/ipi.pdx. Not implemented as tail-jmp (`jmp lapic_send_ipi_fixed`) because paideia-as's inter-module direct-jmp encoding is less battle-tested than the call/ret pair in this codebase's IPI path — the extra ret costs one cycle and buys us the encoder-tested call site. Receiving CPU's IDT vec 241 dispatch (_isr_stub_241 -> _ipi_trampoline_f1 -> _ipi_handler_f1) apic_eoi's then writes 1 to that CPU's [gs:PERCPU_OFF_PREEMPT_NEEDED]; the flag is drained by the next IRQ-tail preempt check (trampoline_vec32 tail today; syscall/#PF-return tails to be added under R18.M4-007). Testability note: BSP-self dispatch works today (BSP has IDT + GS_BASE + LAPIC init); AP-target dispatch is gated on AP-side IDT install (R18.M3 peer work), which is why the #772 AC's AP-3 fixture is documented as unblocked-by-this-issue rather than witnessed here. Callee-clobber: RAX, RCX, RDX; RDI consumed.",
      block: {
        // RSI = RESCHEDULE_VECTOR (0xF1) — vector byte for ICR_LO.
        mov rsi, 0xF1;

        // Nested call — preserve 16-byte SysV stack alignment.
        sub rsp, 8;
        call lapic_send_ipi_fixed;
        add rsp, 8;
        ret
      }
    }
}
