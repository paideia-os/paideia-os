// src/kernel/core/cpu/cpu_features.pdx — R21.M2 (#830 / #831)
//
// CPUID feature-bit gating for AVX2 (#830) and AVX-512 (#831).
// Populates a small pair of BSS-resident boolean flags read by higher-
// level code before it dares emit VEX/EVEX-encoded SIMD instructions.
//
// Round: R21 — FPU/XSAVE + interrupt controller completion
// Milestone: R21.M2 — AVX2/AVX-512 gating + fixtures
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R21
// Encoder floor: paideia-as v0.20.1+ (cpuid + baseline GPR ops only).
//
// ==============================================================================
// Design summary
// ==============================================================================
//
// AVX-family CPU features are gated by TWO orthogonal predicates that BOTH
// must succeed before software may safely execute the corresponding SIMD:
//
//   (1) CPU support        — CPUID advertises the feature bits.
//   (2) OS enablement      — XCR0 (via xsetbv) has the state components the
//                            feature uses; without them, the CPU raises #NM
//                            or #UD on the first instruction that references
//                            the wide vector register file.
//
// XSAVE (#825/#826, R21.M1) already handles (2) for the mask 0x7 (x87|SSE|
// YMM).  The globals `_xsave_supported_mask` and `_xsave_xcr0_target` in
// core/cpu/xsave.pdx cache the results of the CPUID.0x0D probe and the
// XCR0 program.  This module folds those OS-enablement facts back into a
// per-feature "actually usable" boolean.
//
//   AVX2 requires:
//     - CPUID.01H:ECX bit 28  (AVX baseline — YMM register file exists)
//     - CPUID.07H:EBX bit  5  (AVX2 integer instructions)
//     - CPUID.01H:ECX bit 27  (OSXSAVE — CR4.OSXSAVE was set by the OS)
//     - XCR0 bit 2 (YMM_Hi128) enabled — inherited from XSAVE_XCR0_TARGET
//
//   AVX-512 (Foundation) requires:
//     - CPUID.07H:EBX bit 16  (AVX512F)
//     - XCR0 bits 5,6,7 (OpMask, ZMM_Hi256, Hi16_ZMM) all enabled
//     - Same OSXSAVE precondition
//   plus optionally advertising additional AVX-512 subsets:
//     - CPUID.07H:EBX bit 17  (AVX512DQ)
//     - CPUID.07H:EBX bit 28  (AVX512CD)
//     - CPUID.07H:EBX bit 30  (AVX512BW)
//     - CPUID.07H:EBX bit 31  (AVX512VL)
//
// On T14 G4 (Raptor Lake U/P, hybrid P+E core layout with fused-off AVX-512
// on P-cores in client SKUs) — expected result: AVX2 = 1, AVX-512 = 0.
// On QEMU -cpu max: AVX2 = 1; AVX-512 = 0 iff XCR0 mask 0x21F does NOT set
// the AVX-512 XSAVE state bits (5|6|7) — which is our R21.M1 target
// (XCR0_BASELINE|YMM = 0x7).  So both current MVP hardware surfaces should
// report {AVX2=1, AVX-512=0}.
//
// The two-predicate AND pattern makes the returned booleans SAFE to gate
// SIMD use — regardless of whether the CPU supports the ISA, the OS
// enablement half of the invariant covers the "processor won't fault"
// half of the contract.
//
// ==============================================================================
// Storage
// ==============================================================================
//
//   _cpu_has_avx2       (u64, 0 or 1) — set by cpu_probe_avx2.
//   _cpu_has_avx512     (u64, 0 or 1) — set by cpu_probe_avx512.
//   _cpu_avx512_bits    (u64)         — raw CPUID.07H:EBX subset bitmap for
//                                       the AVX-512 subsets we care about
//                                       (F|DQ|CD|BW|VL packed into low 5 bits).
//                                       Emitted in the fingerprint for
//                                       diagnostic parity with real HW.
//
// Both `_cpu_has_*` fields default to 0 (safest — treat unprobed CPU as
// "no SIMD").  Callers MUST call cpu_probe_avx2 / cpu_probe_avx512 exactly
// once on BSP boot AFTER xsave_enable_this_cpu ran (so XCR0 is set).
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - cpuid                (0F A2) — encoder R11
// - baseline GPR ops     — mov / cmp / and / or / shr / jz / jne
// - klog_s1 / klog_s1_x1 wrappers (core/klog/wrappers.pdx)
//
// No VEX / EVEX emission in this file — this is pure detect-only.  Actual
// SIMD-issuing code is in tests/kernel/cpu/ymm_preserve.pdx (#832).

module CpuFeatures = structure {

  // ==========================================================================
  // CPUID leaves + feature-bit masks (SDM Vol 2, chapter 3, "CPUID").
  // ==========================================================================

  // CPUID.01H:ECX bit masks (leaf 1, ECX register).
  pub let CPUID_01_ECX_OSXSAVE : u64 = 0x08000000     // bit 27
  pub let CPUID_01_ECX_AVX     : u64 = 0x10000000     // bit 28

  // CPUID.07H:EBX bit masks (leaf 7 subleaf 0, EBX register).
  pub let CPUID_07_EBX_AVX2     : u64 = 0x20            // bit 5
  pub let CPUID_07_EBX_AVX512F  : u64 = 0x10000         // bit 16
  pub let CPUID_07_EBX_AVX512DQ : u64 = 0x20000         // bit 17
  pub let CPUID_07_EBX_AVX512CD : u64 = 0x10000000      // bit 28
  pub let CPUID_07_EBX_AVX512BW : u64 = 0x40000000      // bit 30
  pub let CPUID_07_EBX_AVX512VL : u64 = 0x80000000      // bit 31

  // XCR0 masks (mirror of xsave.pdx constants — kept local so this module
  // reads standalone; the values MUST agree with Xsave.XCR0_* below).
  pub let CPU_XCR0_YMM       : u64 = 0x4              // bit 2  — AVX YMM_Hi128
  pub let CPU_XCR0_OPMASK    : u64 = 0x20             // bit 5  — AVX-512 K0..K7
  pub let CPU_XCR0_ZMM_HI256 : u64 = 0x40             // bit 6  — AVX-512 ZMM low16 hi256
  pub let CPU_XCR0_HI16_ZMM  : u64 = 0x80             // bit 7  — AVX-512 ZMM16..31
  pub let CPU_XCR0_AVX512    : u64 = 0xE0             // 5 | 6 | 7 combined

  // ==========================================================================
  // Storage
  // ==========================================================================
  //
  // Zero-init in .bss.  Both `_cpu_has_*` remain 0 until the corresponding
  // probe function runs; higher-level guards inspect the flag with a simple
  // `mov rax, [rip + _cpu_has_avx2]; cmp rax, 0; jne use_avx2_path`.
  // ==========================================================================
  pub let mut _cpu_has_avx2    : u64 = 0
  pub let mut _cpu_has_avx512  : u64 = 0
  pub let mut _cpu_avx512_bits : u64 = 0

  // ==========================================================================
  // cpu_avx2_available: reads-only accessor for the AVX2 flag.
  // ==========================================================================
  //
  // Returns u64 (0 or 1) — pdx has no `bool` first-class type at present, so
  // the boolean convention is "0 = false, nonzero = true"; callers use
  // `cmp rax, 0; jne yes` per xsave.pdx precedent.
  //
  // Leaf, no clobber discipline beyond rax return.  Cheap enough to inline
  // at every SIMD guard site but exposed as a call for future flexibility
  // (e.g. if we ever gate on a runtime-toggleable disable knob).
  // ==========================================================================
  pub let cpu_avx2_available : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M2 #830 accessor.  Returns [_cpu_has_avx2] as u64 (0=false, 1=true).  Leaf; no register discipline beyond rax return.  Callers use `cmp rax, 0; jne use_avx2` to gate VEX-256 emission on the just-probed CPU.  Safe to call before cpu_probe_avx2 (returns 0 — treat unprobed CPU as no-SIMD, matching the conservative default).",
      block: {
        mov rax, [rip + _cpu_has_avx2];
        ret
      }
    }

  // ==========================================================================
  // cpu_avx512_available: reads-only accessor for the AVX-512 flag.
  // ==========================================================================
  pub let cpu_avx512_available : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R21-M2 #831 accessor.  Returns [_cpu_has_avx512] as u64 (0=false, 1=true).  Mirror of cpu_avx2_available.  On T14 G4 (Raptor Lake U/P) and QEMU -cpu max at MVP XCR0=0x7, this returns 0 — AVX-512 remains gated off until either the CPU turns on the F bit (Server SKU) or the OS extends XCR0 with the {opmask, ZMM_hi256, Hi16_ZMM} triple (R35+ scope).",
      block: {
        mov rax, [rip + _cpu_has_avx512];
        ret
      }
    }

  // ==========================================================================
  // cpu_probe_avx2: populate _cpu_has_avx2 + fingerprint (#830).
  // ==========================================================================
  //
  // Sequence:
  //   (1) CPUID.0 → EAX = max_std_leaf.  If < 7, AVX2 impossible (leaf 7
  //       needed for the AVX2 bit).  Set flag=0, emit "unavailable", return.
  //   (2) CPUID.01H → ECX.  Test OSXSAVE (bit 27) AND AVX (bit 28) — both
  //       required.  Missing either ⇒ flag=0, "unavailable", return.
  //   (3) Test XCR0 bit 2 (YMM_Hi128) via cached _xsave_xcr0_target.  Missing
  //       ⇒ flag=0, "unavailable", return.
  //   (4) CPUID.07H subleaf 0 → EBX.  Test bit 5 (AVX2).  Missing ⇒ flag=0.
  //   (5) All predicates hold ⇒ flag=1, emit "available", return.
  //
  // Design note: we DO NOT re-inspect CR4.OSXSAVE via `mov rax, cr4` — the
  // CPUID.01H ECX bit 27 (OSXSAVE) is a MIRROR of that CR4 bit per SDM Vol 2
  // "CPUID" §OSXSAVE Feature Flag.  Reading it via CPUID is faster (no
  // control-register access) and matches Linux's arch/x86/kernel/cpu/common.c
  // convention.
  //
  // Register / call discipline: not a leaf (calls klog_s1_x1 on both
  // branches).  2-push prologue (rbx, r12) for the two persistent operand
  // registers (rbx = ECX from leaf 1, r12 = EBX from leaf 7).  rsp %16 == 0
  // at every nested call boundary.
  // ==========================================================================
  pub let cpu_probe_avx2 : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "R21-M2 #830 (AVX2 CPU-feature probe + gate).  Runs on BSP once after xsave_enable_this_cpu.  Four-predicate AND: max_std_leaf >= 7 AND CPUID.01H:ECX[27:28] = {OSXSAVE, AVX} AND XCR0[2] = YMM enabled AND CPUID.07H:EBX[5] = AVX2.  Failing any predicate leaves _cpu_has_avx2 = 0 and emits klog_s1 tag_cpu_avx2_absent; passing all four sets _cpu_has_avx2 = 1 and emits klog_s1 tag_cpu_avx2_avail.  Register: rbx = leaf-1 ECX preserved across leaf-7 CPUID clobber (both leaves smash rbx per CPUID contract, so this is a save+reload pattern), r12 = leaf-7 EBX for the final AND.  2-push prologue.  klog_s1 called at rsp%16 == 0 after 2-push (entry rsp%16 == 8 + push*2 → 0).  Predicate short-circuits jump forward to the shared 'absent' emit; passing paths fall through to the 'avail' emit at the tail.",
      block: {
        push rbx;
        push r12;

        // (1) Discover max_std_leaf.
        mov rax, 0;
        xor rcx, rcx;
        cpuid;
        cmp rax, 7;
        jb cpu_probe_avx2_absent;

        // (2) CPUID.01H → ECX.  Save into rbx (rbx clobbered by leaf 7).
        mov rax, 1;
        xor rcx, rcx;
        cpuid;
        mov rbx, rcx;                       // rbx = ECX (feature bits)

        // OSXSAVE (bit 27) required.
        mov rax, rbx;
        and rax, 0x08000000;                // CPUID_01_ECX_OSXSAVE
        cmp rax, 0;
        je cpu_probe_avx2_absent;

        // AVX (bit 28) required — YMM register file must exist.
        mov rax, rbx;
        and rax, 0x10000000;                // CPUID_01_ECX_AVX
        cmp rax, 0;
        je cpu_probe_avx2_absent;

        // (3) XCR0 bit 2 (YMM_Hi128).  Read cached xsave_xcr0_target.
        mov rax, [rip + _xsave_xcr0_target];
        and rax, 0x4;                       // CPU_XCR0_YMM
        cmp rax, 0;
        je cpu_probe_avx2_absent;

        // (4) CPUID.07H subleaf 0 → EBX.  Test bit 5 (AVX2).
        mov rax, 7;
        xor rcx, rcx;
        cpuid;
        mov r12, rbx;                       // r12 = leaf-7 EBX
        and r12, 0x20;                      // CPUID_07_EBX_AVX2
        cmp r12, 0;
        je cpu_probe_avx2_absent;

        // (5) All predicates hold ⇒ AVX2 usable.
        mov rax, 1;
        mov [rip + _cpu_has_avx2], rax;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_cpu_avx2_avail];
        call klog_s1;

        pop r12;
        pop rbx;
        ret;

      cpu_probe_avx2_absent:
        // Flag already 0 (BSS init); leave as-is, emit fingerprint.
        mov rdi, 3;                          // LEVEL_INFO (absent is not an error on client SKUs)
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_cpu_avx2_absent];
        call klog_s1;

        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cpu_probe_avx512: populate _cpu_has_avx512 + fingerprint (#831).
  // ==========================================================================
  //
  // Same AND-chain shape as cpu_probe_avx2 but with a wider bitmap:
  //   (1) max_std_leaf >= 7 (else no leaf-7 access).
  //   (2) CPUID.01H:ECX bit 27 (OSXSAVE) set.
  //   (3) XCR0 bits {5,6,7} — opmask + ZMM_Hi256 + Hi16_ZMM — ALL set.
  //   (4) CPUID.07H:EBX bit 16 (AVX512F — the "foundation" flag; every other
  //       AVX-512 subset architecturally requires F set as well).
  //   (5) Sample the four common subset flags {DQ, CD, BW, VL} into a packed
  //       5-bit map for the fingerprint diagnostic.
  //
  // On T14 G4 Raptor Lake (client): Intel disables AVX-512 at core level even
  // though the P-core silicon supports it — the hybrid P+E design forced the
  // fuse because E-cores lack AVX-512.  Predicate (4) → 0.  Result: flag=0.
  // Fingerprint emits with bits=0.
  //
  // On QEMU -cpu max at R21.M1's XCR0 = 0x7 (no OS enablement for opmask/
  // ZMM), predicate (3) → 0.  Same result: flag=0, bits sampled but flag off.
  //
  // On future server hardware or extended XCR0 (R35+): predicate (3) & (4)
  // both hold; bits reflect actual F/DQ/CD/BW/VL surface.
  //
  // Register / call discipline: 2-push (rbx, r12) mirror of cpu_probe_avx2;
  // r12 accumulates the packed subset bitmap across the AND-chain.
  // ==========================================================================
  pub let cpu_probe_avx512 : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "R21-M2 #831 (AVX-512 CPU-feature probe + gate).  BSP-once after xsave_enable_this_cpu.  Two-phase: (A) sample CPUID.07H:EBX bits {16,17,28,30,31} = {F,DQ,CD,BW,VL} into a packed 5-bit map (r12, F=bit0, DQ=bit1, CD=bit2, BW=bit3, VL=bit4) — publishes to _cpu_avx512_bits unconditionally so debugging why the gate closed is possible from the wire alone.  (B) Four-predicate AND: max_std_leaf >= 7 AND CPUID.01H:ECX[27] = OSXSAVE AND XCR0 & 0xE0 == 0xE0 (all three of opmask, ZMM_Hi256, Hi16_ZMM enabled) AND F bit of the sampled map = 1.  Passes ⇒ _cpu_has_avx512 = 1, emits tag_cpu_avx512_avail; any predicate fails ⇒ flag stays 0, emits tag_cpu_avx512_absent — both fingerprints carry k_bits kv with the sampled subset map.  Register: rbx = leaf-7 EBX preserved across bit-mask arithmetic (rbx clobbered again on subsequent CPUIDs, so we set it once and never overwrite it inside the sampling block), r12 = packed bitmap.  2-push prologue.  klog_s1_x1 arg discipline: rdi=level, rsi=subsys, rdx=tag, rcx=key, r8=value; rsp%16 == 0 pre-call after 2-push (entry rsp%16 == 8).",
      block: {
        push rbx;
        push r12;

        xor r12, r12;                        // r12 = packed subset bitmap (accumulator)

        // ==============================================================
        // Phase A: sample CPUID.07H:EBX subset bits into r12 unconditionally.
        // ==============================================================
        //
        // A leaf-7 read requires max_std_leaf >= 7. If the CPU is too old
        // (pre-Haswell — leaf 7 didn't exist), skip sampling; bitmap stays 0.
        mov rax, 0;
        xor rcx, rcx;
        cpuid;
        cmp rax, 7;
        jb cpu_probe_avx512_sampled;         // no leaf 7 → bitmap = 0

        mov rax, 7;
        xor rcx, rcx;
        cpuid;                               // rbx = leaf-7 EBX

        // Pack F (bit 16) → packed bit 0.
        mov rax, rbx;
        and rax, 0x10000;                   // CPUID_07_EBX_AVX512F
        cmp rax, 0;
        je cpu_probe_avx512_skip_f;
        or r12, 0x1;
      cpu_probe_avx512_skip_f:

        // Pack DQ (bit 17) → packed bit 1.
        mov rax, rbx;
        and rax, 0x20000;                   // CPUID_07_EBX_AVX512DQ
        cmp rax, 0;
        je cpu_probe_avx512_skip_dq;
        or r12, 0x2;
      cpu_probe_avx512_skip_dq:

        // Pack CD (bit 28) → packed bit 2.
        mov rax, rbx;
        and rax, 0x10000000;                // CPUID_07_EBX_AVX512CD
        cmp rax, 0;
        je cpu_probe_avx512_skip_cd;
        or r12, 0x4;
      cpu_probe_avx512_skip_cd:

        // Pack BW (bit 30) → packed bit 3.
        mov rax, rbx;
        and rax, 0x40000000;                // CPUID_07_EBX_AVX512BW
        cmp rax, 0;
        je cpu_probe_avx512_skip_bw;
        or r12, 0x8;
      cpu_probe_avx512_skip_bw:

        // Pack VL (bit 31) → packed bit 4.
        mov rax, rbx;
        and rax, 0x80000000;                // CPUID_07_EBX_AVX512VL
        cmp rax, 0;
        je cpu_probe_avx512_skip_vl;
        or r12, 0x10;
      cpu_probe_avx512_skip_vl:

      cpu_probe_avx512_sampled:
        // Publish the sampled bitmap regardless of the "usable" predicates
        // below.  A CPU whose F is set but whose OS enablement is off will
        // read _cpu_avx512_bits = 0x1 (or higher) while _cpu_has_avx512 = 0
        // — a self-documenting witness of "the CPU supports it, the OS
        // just hasn't enabled the XSAVE components".
        mov [rip + _cpu_avx512_bits], r12;

        // ==============================================================
        // Phase B: usable-AND-chain — sets _cpu_has_avx512 only if
        // every predicate passes.
        // ==============================================================

        // Predicate (1) already established above (leaf 7 available; we
        // did the max_std_leaf >= 7 check before sampling).  If we jumped
        // to cpu_probe_avx512_sampled without going through the sampling
        // block, r12 = 0 and predicate (4) below will fail on F.

        // (2) OSXSAVE via CPUID.01H:ECX bit 27.
        mov rax, 1;
        xor rcx, rcx;
        cpuid;
        mov rbx, rcx;                       // rbx = leaf-1 ECX
        and rbx, 0x08000000;                // CPUID_01_ECX_OSXSAVE
        cmp rbx, 0;
        je cpu_probe_avx512_absent;

        // (3) XCR0 & 0xE0 == 0xE0 (all of opmask, ZMM_Hi256, Hi16_ZMM set).
        mov rax, [rip + _xsave_xcr0_target];
        and rax, 0xE0;                      // CPU_XCR0_AVX512
        cmp rax, 0xE0;
        jne cpu_probe_avx512_absent;

        // (4) F bit sampled above.  Reject if not set.
        mov rax, r12;
        and rax, 0x1;                       // packed F bit
        cmp rax, 0;
        je cpu_probe_avx512_absent;

        // All predicates hold ⇒ AVX-512 usable.
        mov rax, 1;
        mov [rip + _cpu_has_avx512], rax;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_cpu_avx512_avail];
        lea rcx, [rip + k_bits];
        mov r8, r12;
        call klog_s1_x1;

        pop r12;
        pop rbx;
        ret;

      cpu_probe_avx512_absent:
        // Bitmap already published; flag stays 0 (BSS init).
        mov rdi, 3;                          // LEVEL_INFO (absent on Raptor Lake U/P is expected)
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_cpu_avx512_absent];
        lea rcx, [rip + k_bits];
        mov r8, r12;
        call klog_s1_x1;

        pop r12;
        pop rbx;
        ret
      }
    }
}
