// src/kernel/core/pci/msi.pdx — R21-M4-002 (#838)
//
// MSI (Message Signaled Interrupt) capability programmer.
//
// This is the PCI-config-space side of MSI enablement.  The R21.M3
// core/apic/msi.pdx (Phase 6 stub) is orthogonal — it never grew a
// real implementation, and has no call sites; keeping it around for
// symbol continuity is harmless.  This new module lives under
// core/pci/ to align with the R21.M4 PCI capability chain
// (config.pdx / cap.pdx) it depends on.
//
// -----------------------------------------------------------------------------
// MSI capability layout (PCI 2.2+ §6.8.1)
// -----------------------------------------------------------------------------
//
// At cap_offset (as returned by pci_find_cap for cap_id=0x05):
//
//   +0  u8  cap_id            (0x05)
//   +1  u8  next_ptr
//   +2  u16 msg_control
//       bit 0     msi_enable          (0=disabled, 1=enabled)
//       bits 3:1  multi_msg_capable   (log2 of vectors supported: 0..5)
//       bits 6:4  multi_msg_enable    (log2 of vectors requested: 0..5)
//       bit 7     addr_64_capable     (0=32-bit MSI, 1=64-bit MSI)
//       bit 8     per_vec_masking     (0=no, 1=yes — extra maskbits regs)
//       bits 15:9 reserved
//   +4  u32 msg_addr_lo
//   +8  u32 msg_addr_hi       (present ONLY if addr_64_capable=1)
//   +N  u16 msg_data          (N = 8 if 32-bit, N = 12 if 64-bit)
//   +N+4 (opt) u32 mask_bits  (present if per_vec_masking=1)
//   +N+8 (opt) u32 pending_bits
//
// MSI address encoding (Intel SDM Vol 3A §11.11.1):
//   bits 31:20 = 0xFEE           (fixed prefix for LAPIC message region)
//   bits 19:12 = dest APIC ID    (physical mode, 8 bits)
//   bit  3     = redirection hint (RH: 0 = direct)
//   bit  2     = destination mode (DM: 0 = physical)
//   bits 11:4  = reserved (0)
//   bits 1:0   = reserved (0)
//
// MSI data encoding:
//   bits 7:0   = vector
//   bits 10:8  = delivery mode (000 = Fixed)
//   bit  14    = level (edge-triggered leave 0)
//   bit  15    = trigger mode (0 = edge)
//
// -----------------------------------------------------------------------------
// This module's contract
// -----------------------------------------------------------------------------
//
// msi_enable(seg, bus, dev, func, vector, dest_apic_id) -> u64
//   Programs a single-vector Fixed/Edge/Physical MSI:
//     - MSI address = 0xFEE00000 | (dest_apic_id << 12)
//     - MSI data    = vector (delivery=Fixed, trigger=edge, level=0)
//     - Sets msg_control bit 0 (msi_enable)
//     - Requests 1 vector (multi_msg_enable = 0)
//   Returns 1 on success, 0 if the MSI capability is not found.
//
// Multi-vector MSI (Multi-Message Enable > 0) is deferred (R21.M4+
// scope) — MMC handles the "device has 4 vectors starting at
// vector..vector+3" case that virtio uses only for MSI-X (which is the
// R21.M4 default path for multi-vector).  Bare MSI multi-vector is
// rarely used in modern devices — most either advertise 1 MSI or
// prefer MSI-X.

module Msi = structure {

  // Capability register offsets (relative to cap_offset).
  pub let MSI_OFF_MSG_CONTROL  : u64 = 2      // u16
  pub let MSI_OFF_ADDR_LO      : u64 = 4      // u32
  pub let MSI_OFF_ADDR_HI      : u64 = 8      // u32 (only if 64-bit)
  pub let MSI_OFF_DATA_32      : u64 = 8      // u16 (32-bit variant)
  pub let MSI_OFF_DATA_64      : u64 = 12     // u16 (64-bit variant)

  pub let MSI_CAP_ID           : u64 = 0x05
  pub let MSI_ADDR_BASE        : u64 = 0xFEE00000

  // ==========================================================================
  // msi_enable(seg, bus, dev, func, vector, dest_apic_id) -> u64
  // ==========================================================================
  //
  // SysV: (seg, bus, dev, func, vector, dest_apic_id) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func, r8=vector, r9=dest_apic_id
  //
  // Returns rax = 1 on success, 0 if MSI cap not found.
  //
  // Register plan (6 pushes + 8-byte align = 56 B → rsp%16==0 pre-call):
  //   r12=seg, r13=bus, r14=dev, r15=func
  //   rbx=vector, rbp=dest_apic_id (both u8)
  //   Stack slots: [rsp+0]=cap_offset (u64), [rsp+8]=msg_control (u64),
  //                [rsp+16]=addr_64_flag (u64, 0 or 1)
  //   Wait — only [rsp+0] is align. Use 3 words = 24 bytes, still 16-aligned
  //   AFTER pushes. 6 pushes = 48; +24 = 72; entry rsp%16==8 → 8+72=80 %16=0.

  pub let msi_enable : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, vector: u64, dest_apic_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-002 (#838): Program single-vector Fixed/Edge/Physical MSI. Body: (1) 6-push callee-save prologue (rbx, rbp, r12, r13, r14, r15) + `sub rsp, 24` for three scratch slots and stack-alignment: 6 pushes = 48 B, sub 24 = 72; entry rsp%16==8 → 8+72=80, %16==0 (SysV pre-call aligned). (2) Save BDF into r12/r13/r14/r15, vector into rbx (masked u8), dest into rbp (masked u8). (3) Call pci_find_cap(seg, bus, dev, func, MSI_CAP_ID=0x05); if returns 0 → not found → return 0. Save cap_offset in [rsp+0]. (4) Read msg_control (u16 @ cap_offset+2). Save in [rsp+8]. (5) Decode addr_64_capable = bit 7 of msg_control; save in [rsp+16]. (6) Program addr_lo (u32 @ cap_offset+4) = 0xFEE00000 | (dest << 12). (7) If addr_64: program addr_hi (u32 @ cap_offset+8) = 0. (8) Program msg_data at (cap_offset + 8) for 32-bit variant or (cap_offset + 12) for 64-bit — write u32 with vector in low 8 bits and other fields = 0 (Fixed/edge). Since pci_config_write_u32 writes a full dword, upper 16 bits are 0 which matches the reserved-zero contract of MSI data. Actually — msg_data is u16 not u32; but ECAM writes are dword-only in strict alignment. For 32-bit variant, msg_data lives at cap_offset+8 which is dword-aligned; for 64-bit variant, cap_offset+12 which is also dword-aligned. Writing a full u32 with high 16 bits = 0 is spec-correct as the upper 16 bits of the config-space dword at those offsets are 'reserved must be preserved' but since we know msg_data was 0 initially (cap default), writing 0 is safe. To be robust in the presence of concurrent modifications (should never happen at boot time), we could RMW: read u32, mask, or, write. For R21.M4 boot programming this is unnecessary. (9) Set msg_control bit 0 (msi_enable). Read msg_control from [rsp+8] into rax; `or rax, 1`; write back via pci_config_write_u32 at cap_offset+2. Wait — msg_control is u16 at offset+2, so it lives in the upper 16 bits of the dword at offset+0 (cap_id/next_ptr in low 16, msg_control in high 16). Writing the full dword would clobber cap_id/next_ptr. Must RMW: read dword at (cap_offset & ~3) = cap_offset (since cap_offset is dword-aligned per PCI spec), mask upper 16 bits, OR the new msg_control shifted << 16, then write. Simpler: since msg_control offset = cap_offset+2, and (cap_offset+2) & ~3 = cap_offset, we RMW dword at cap_offset: read → set bit 18 (= bit 0 of msg_control) → write. That is: `or rax, 0x40000` (bit 16+2 = bit 18? no wait — bit 0 of the u16 at byte-offset +2 is bit 16 of the containing dword at byte-offset +0). Actually if we read dword at cap_offset: bytes 0/1 = cap_id/next_ptr, bytes 2/3 = msg_control low/high. Bit 0 of msg_control = bit 16 of the dword. So enable-bit is bit 16 = 0x10000. Return 1. Encoder: mov, shl, or, and, cmp/je, call — all pre-#838 proven.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;                           // [rsp+0]=cap, [rsp+8]=msgctrl, [rsp+16]=addr64

        // Save args in callee-save regs.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // vector
        and rbx, 0xFF;
        mov rbp, r9;                           // dest_apic_id
        and rbp, 0xFF;

        // ---- (3) Find MSI cap ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x05;                          // MSI_CAP_ID
        call pci_find_cap;

        cmp rax, 0;
        je msi_enable_notfound;

        mov [rsp + 0], rax;                    // save cap_offset

        // ---- (4) Read msg_control (u16 @ cap+2) ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        add r8, 2;                             // MSI_OFF_MSG_CONTROL
        call pci_config_read_u16;

        mov [rsp + 8], rax;                    // save msg_control

        // ---- (5) Decode addr_64_capable = bit 7 ----
        mov r10, rax;
        shr r10, 7;
        and r10, 1;
        mov [rsp + 16], r10;                   // save addr_64 flag

        // ---- (6) Program addr_lo = 0xFEE00000 | (dest << 12) ----
        mov r9, rbp;                           // r9 = dest (arg-6 slot)
        shl r9, 12;
        mov r10, 0xFEE00000;
        or r9, r10;                            // r9 = addr_lo value

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        add r8, 4;                             // MSI_OFF_ADDR_LO
        call pci_config_write_u32;

        // ---- (7) If 64-bit capable, program addr_hi = 0 ----
        mov r10, [rsp + 16];
        cmp r10, 0;
        je msi_enable_addr32;

        // 64-bit variant: addr_hi = 0 @ cap+8, msg_data @ cap+12.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        add r8, 8;                             // MSI_OFF_ADDR_HI
        mov r9, 0;
        call pci_config_write_u32;

        // msg_data offset = 12 for 64-bit; note the dword at cap+12 also
        // holds mask_bits for 64-bit + per-vec-mask devices but for the
        // "1-vector, no per-vec-mask" default, cap+12 is msg_data (u16)
        // + reserved upper 16.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        add r8, 12;                            // MSI_OFF_DATA_64
        mov r9, rbx;                           // r9 = vector (Fixed/edge → high fields 0)
        call pci_config_write_u32;

        jmp msi_enable_set_ctrl;

      msi_enable_addr32:
        // 32-bit variant: msg_data at cap+8.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        add r8, 8;                             // MSI_OFF_DATA_32
        mov r9, rbx;                           // vector
        call pci_config_write_u32;

      msi_enable_set_ctrl:
        // ---- (9) Set msi_enable bit ----
        // msg_control lives at cap_offset+2, i.e. high 16 bits of the
        // dword at cap_offset. Read the full dword, set bit 16
        // (= bit 0 of msg_control), write back.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];                     // cap_offset (dword-aligned)
        call pci_config_read_u32;

        or rax, 0x10000;                       // set enable bit
        mov r9, rax;                           // value

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        call pci_config_write_u32;

        mov rax, 1;                            // success
        jmp msi_enable_done;

      msi_enable_notfound:
        mov rax, 0;

      msi_enable_done:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
