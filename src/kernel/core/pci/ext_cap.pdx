// src/kernel/core/pci/ext_cap.pdx — R22-M3-002 (#857)
//
// PCIe Extended Capability walker.
//
// PCIe extended capabilities live in *extended* configuration space
// (offsets 0x100..0xFFF) — a region that is only reachable via the
// ECAM MMIO aperture; the legacy 0xCF8/0xCFC CF8/CFC pair cannot
// address it. That is why this walker is "ECAM-native" and depends on
// pci_config_read_u32 (src/kernel/core/pci/config.pdx) which routes
// every access through the MCFG-derived segment base.
//
// -----------------------------------------------------------------------------
// Extended-capability header layout (PCIe base 5.0 §7.6.1)
// -----------------------------------------------------------------------------
//
// One u32 word at the header offset:
//
//   bits 15:0   PCI Express Extended Capability ID
//   bits 19:16  Capability Version (integer; 1 or 2 typical)
//   bits 31:20  Next Capability Offset (dword-aligned; 0 terminates)
//
// The first extended capability header — if present — always sits at
// offset 0x100. When no extended capabilities are implemented the
// device returns 0x00000000 for the read at 0x100 (per PCIe 5.0
// §7.5.1.1.2) and the walk terminates on the first iteration.
//
// -----------------------------------------------------------------------------
// Termination guard
// -----------------------------------------------------------------------------
//
// The walker bounds the number of visited extended capabilities at 48
// — same defensive bound as the legacy capability walker in cap.pdx.
// The theoretical maximum with the smallest 8-byte spacing across
// 3840 bytes of extended config space is ~480, but no shipping device
// approaches even 32 extended capabilities. 48 is a safe conservative
// ceiling that catches a cyclic or corrupt next-ptr chain without
// hanging.
//
// -----------------------------------------------------------------------------
// Callback contract (pcie_walk_ext_caps)
// -----------------------------------------------------------------------------
//
// The callback signature is fn(ext_cap_id: u64, cap_off: u64) -> ()
// (identical shape to Cap.pci_walk_caps). It MUST return normally
// (`ret`) and MUST preserve rbx / rbp / r12 / r13 / r14 / r15 (SysV
// callee-save). Volatile regs are free for the callback to clobber.

module ExtCap = structure {

  // ============================================================================
  // R22-M3-002 (#857): Named PCIe Extended Capability IDs
  // ============================================================================
  //
  // u16 field extracted from bits 15:0 of the header word. Extended
  // capability IDs occupy a separate namespace from legacy capability
  // IDs — a device may implement, for example, both PCI_CAP_PCIE
  // (legacy cap 0x10) and PCIE_EXT_CAP_AER (extended cap 0x0001)
  // simultaneously.

  pub let PCIE_EXT_CAP_AER         : u64 = 0x0001   // Advanced Error Reporting
  pub let PCIE_EXT_CAP_VC          : u64 = 0x0002   // Virtual Channel
  pub let PCIE_EXT_CAP_SERIAL      : u64 = 0x0003   // Device Serial Number
  pub let PCIE_EXT_CAP_PWR_BUDGET  : u64 = 0x0004   // Power Budgeting
  pub let PCIE_EXT_CAP_RCLD        : u64 = 0x0005   // Root Complex Link Declaration
  pub let PCIE_EXT_CAP_ACS         : u64 = 0x000D   // Access Control Services
  pub let PCIE_EXT_CAP_ATS         : u64 = 0x000F   // Address Translation Services
  pub let PCIE_EXT_CAP_SRIOV       : u64 = 0x0010   // Single-Root I/O Virtualization
  pub let PCIE_EXT_CAP_DPC         : u64 = 0x001D   // Downstream Port Containment

  // ============================================================================
  // First extended-capability header offset (PCIe base 5.0 §7.5.1.1.2)
  // ============================================================================

  pub let PCIE_EXT_CAP_BASE   : u64 = 0x100
  pub let PCIE_EXT_CAP_MAX    : u64 = 48

  // ==========================================================================
  // pcie_find_ext_cap(seg, bus, dev, func, ext_cap_id) -> u16
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, ext_cap_id: u64) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func, r8=ext_cap_id (u16 in low bits)
  //
  // Returns rax = extended-capability header offset (u16) if found,
  // else 0.
  //
  // Register plan (6-push callee-save + 1-align + counter slot):
  //   r12 = seg, r13 = bus, r14 = dev, r15 = func
  //   rbx = target ext_cap_id (u16)
  //   rbp = cursor (current header offset in extended config space)
  //   [rsp+0] = visit counter (survives the pci_config_read_u32 call)

  pub let pcie_find_ext_cap : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, ext_cap_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M3-002 (#857): PCIe extended-capability chain lookup. Body: (1) 6-push callee-save prologue (rbx, rbp, r12..r15) + `sub rsp, 8` 1-align + counter slot. Entry rsp%16==8; 6 pushes → rsp%16=8; sub 8 → rsp%16=0 for the nested pci_config_read_u32 calls. (2) Save r12=seg, r13=bus, r14=dev, r15=func, rbx=ext_cap_id (masked to u16). (3) Initialize cursor rbp = PCIE_EXT_CAP_BASE (0x100). (4) Loop guard: cursor==0 → not-found; visit counter >= PCIE_EXT_CAP_MAX (48) → not-found. (5) Read u32 header at cursor. If the header word is 0x00000000 the device implements no extended caps (or the walk has reached one-past-the-last) → not-found. Otherwise extract cap_id (rax & 0xFFFF) and compare to rbx. On match, return cursor. On miss, extract next_ptr (rax >> 20) & 0xFFC (12 bits, dword-aligned) → new cursor; increment counter; loop. Encoder: only push/pop, mov reg,reg, mov reg,imm, shr, and, cmp/jae/je, call, ret — all pre-#856 proven. Same 48-visit safety bound as Cap.pci_find_cap and Cap.pci_walk_caps; matches Linux pci_find_ext_capability's PCI_FIND_CAP_TTL of 480 divided by the smallest practical spacing (Linux uses 480, we use 48 — bound is tighter but still comfortably above any real-world device).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // 1-align + visit counter slot @[rsp+0]

        // Initialize visit counter.
        mov rax, 0;
        mov [rsp], rax;

        // Save args in callee-save regs.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // ext_cap_id
        and rbx, 0xFFFF;                       // mask to u16

        // Cursor starts at PCIE_EXT_CAP_BASE = 0x100.
        mov rbp, 0x100;

      pcie_find_ext_cap_loop:
        // End-of-list guard.
        cmp rbp, 0;
        je pcie_find_ext_cap_notfound;

        // Visit-count guard.
        mov rax, [rsp];
        cmp rax, 48;
        jae pcie_find_ext_cap_notfound;

        // Read u32 header at cursor.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        call pci_config_read_u32;

        // Header of 0x00000000 → device implements no extended caps.
        cmp rax, 0;
        je pcie_find_ext_cap_notfound;

        // Extract cap_id (bits 15:0).
        mov r10, rax;
        and r10, 0xFFFF;

        // Compare against target.
        cmp r10, rbx;
        je pcie_find_ext_cap_hit;

        // Extract next_ptr (bits 31:20).
        shr rax, 20;
        and rax, 0xFFC;                        // dword-aligned mask (12 bits, low 2 zeroed)
        mov rbp, rax;

        // Increment visit counter.
        mov rax, [rsp];
        add rax, 1;
        mov [rsp], rax;

        jmp pcie_find_ext_cap_loop;

      pcie_find_ext_cap_hit:
        mov rax, rbp;                          // return current cap offset
        and rax, 0xFFFF;
        jmp pcie_find_ext_cap_done;

      pcie_find_ext_cap_notfound:
        mov rax, 0;

      pcie_find_ext_cap_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pcie_walk_ext_caps(seg, bus, dev, func, callback) -> u64
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, callback: u64) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func,
  //   r8=callback fn(ext_cap_id, cap_off) -> ()
  //
  // Returns rax = number of extended capabilities visited.
  //
  // Register plan (identical to pcie_find_ext_cap but rbx holds the
  // callback pointer instead of the target ext_cap_id):
  //   r12 = seg, r13 = bus, r14 = dev, r15 = func
  //   rbx = callback function pointer
  //   rbp = cursor
  //   [rsp+0] = visit counter

  pub let pcie_walk_ext_caps : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, callback: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M3-002 (#857): PCIe extended-capability enumeration with callback dispatch. Structural sibling to pcie_find_ext_cap — same 6-push callee-save prologue, same PCIE_EXT_CAP_BASE seed, same 48-visit safety bound, same header-word-zero termination, same next-ptr extract via `shr rax, 20; and rax, 0xFFC`. The loop body differs: on each valid header the walker dispatches callback(ext_cap_id_u64, cap_off_u64) via indirect `call rbx` (same idiom as Cap.pci_walk_caps `call rbx` and acpi_xsdt_iter's `call r15` in src/kernel/acpi/xsdt.pdx L198). The visit counter lives in the 1-align stack slot [rsp+0] so it survives the indirect callback call and the nested pci_config_read_u32 calls. Return value = visit count (reloaded from [rsp+0] at epilogue). Callback preserves rbx/rbp/r12..r15 per SysV so the cursor and callback-pointer registers survive across dispatch.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // 1-align + visit counter slot @[rsp+0]

        mov rax, 0;
        mov [rsp], rax;

        // Save args in callee-save regs.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // callback

        // Cursor seeded at PCIE_EXT_CAP_BASE.
        mov rbp, 0x100;

      pcie_walk_ext_caps_loop:
        // End-of-list guard.
        cmp rbp, 0;
        je pcie_walk_ext_caps_done;

        // Visit-count guard.
        mov rax, [rsp];
        cmp rax, 48;
        jae pcie_walk_ext_caps_done;

        // Read u32 header at cursor.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        call pci_config_read_u32;

        // Header of 0x00000000 → device implements no extended caps.
        cmp rax, 0;
        je pcie_walk_ext_caps_done;

        // Dispatch callback(ext_cap_id, cap_off).
        //   arg0 = rax & 0xFFFF
        //   arg1 = rbp (cursor)
        mov r10, rax;                          // preserve full header in r10 for next-ptr extract
        mov rdi, rax;
        and rdi, 0xFFFF;
        mov rsi, rbp;
        and rsi, 0xFFFF;
        // Preserve r10 across callback (indirect callee may clobber r10;
        // stash on stack).
        push r10;
        sub rsp, 8;                            // realign to 16 before call
        call rbx;
        add rsp, 8;
        pop r10;

        // Extract next_ptr (bits 31:20 of the original header word in r10).
        mov rax, r10;
        shr rax, 20;
        and rax, 0xFFC;
        mov rbp, rax;

        // Increment visit counter.
        mov rax, [rsp];
        add rax, 1;
        mov [rsp], rax;

        jmp pcie_walk_ext_caps_loop;

      pcie_walk_ext_caps_done:
        mov rax, [rsp];                        // return visit count
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
