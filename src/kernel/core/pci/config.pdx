// src/kernel/core/pci/config.pdx — R21-M4-001 (#837 support)
//
// PCI Enhanced Configuration Access Mechanism (ECAM) accessors.
//
// Given a (segment, bus, device, function, register-offset) tuple,
// compute the MMIO virtual address inside the segment's ECAM window
// and issue a 32/16/8-bit MMIO access:
//
//   ecam_addr(seg, bus, dev, fn, off)
//     = mcfg_ecam_base_for_segment(seg)      // R20-M3-001 (#814)
//       + (bus << 20)                        // 256 KB per bus
//       + (dev << 15)                        //  32 KB per device
//       + (fn  << 12)                        //   4 KB per function
//       + off                                //   0..0xFFF register offset
//
// This module intentionally omits any device-presence pre-check — the
// caller (typically PciCap.pci_find_cap) is responsible for treating a
// vendor_id read of 0xFFFF as "no device" and short-circuiting the
// walk.  A read on a non-existent function ECAM slot returns 0xFFFFFFFF
// on real hardware and QEMU q35 alike; the segment-base-zero path here
// (segment not present in MCFG) returns 0xFFFFFFFF for reads as a
// spec-compatible synthetic "absent" signal.
//
// -----------------------------------------------------------------------------
// MMIO serialization discipline
// -----------------------------------------------------------------------------
//
// Every ECAM access is bracketed with `mfence` (same posture as R21.M3
// ioapic_read_at / ioapic_write_at in core/apic/ioapic.pdx).  Rationale:
//
//   * Config-space MMIO is UC on real hardware (marked so by the
//     firmware page-attribute table for the ECAM aperture); on the
//     paideia-os identity-map path it is also strong-uncacheable via
//     the boot page tables.  The mfence brackets protect the boundary
//     with WB stores that a caller may make to peer bookkeeping
//     structures (e.g. capability-list visit counters) which must
//     publish in order with the ECAM access itself — x86 TSO does
//     not order WB → UC MMIO from the same CPU (SDM Vol 3A §11.3.1).
//
// -----------------------------------------------------------------------------
// Encoder-gap posture (paideia-as v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1 (paideia-as v0.20.1): `mov [mem], reg32` narrow-store silently
//       widens to REX.W.  Every 32-bit MMIO store uses `mov_d`.
//
//   32-bit MMIO LOADS via `mov eax, [mem]` zero-extend correctly per
//       SDM Vol 2A §3.4.1.1 — no sized-mnemonic workaround needed
//       on the read side (same posture as ioapic_read_at).
//
// -----------------------------------------------------------------------------
// Register plan (pci_config_read_u32, 5-push callee-save)
// -----------------------------------------------------------------------------
//
//   push rbx, r12, r13, r14, r15 (40 B → rsp%16==0 for the nested call).
//     r12 = bus, r13 = dev, r14 = fn, r15 = offset — preserved across
//     the mcfg_ecam_base_for_segment call which returns the segment's
//     ECAM base_pa in rax.

module Config = structure {

  // ==========================================================================
  // pci_config_read_u32(seg, bus, dev, fn, offset) -> u32
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, offset: u64) -> u64
  //   rdi = segment (u16 in low bits)
  //   rsi = bus     (u8  in low bits)
  //   rdx = device  (u5  in low bits)
  //   rcx = function (u3 in low bits)
  //   r8  = register offset (u12 in low bits)
  //
  // Returns rax = 32-bit register value zero-extended into u64, or
  // 0xFFFFFFFF if the segment is not present in MCFG (defensive — a
  // caller that walked to a non-existent segment observes the same
  // "device absent" signal it would see reading a non-existent BDF's
  // vendor_id).

  pub let pci_config_read_u32 : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-001 (#837 support): 32-bit ECAM read via segment-scoped MMIO. Body: (1) 5-push callee-save prologue (rbx, r12, r13, r14, r15). Entry rsp%16==8 → after 5 pushes rsp%16==0 (SysV call-boundary aligned). (2) Save bus/dev/fn/offset into r12/r13/r14/r15 — the nested mcfg_ecam_base_for_segment call is SysV-caller-save-only. (3) Call mcfg_ecam_base_for_segment(seg) — rdi still holds seg from the caller. Returns base_pa in rax; if zero, jump to `pci_read_absent` returning 0xFFFFFFFF (segment not in MCFG → device absent by construction). (4) Compute ecam_addr = base + (bus<<20) + (dev<<15) + (fn<<12) + offset — shift-left via `shl` on a scratch reg (rbx), accumulate into rax. shl-immediate encoding proven throughout tree (ioapic.pdx L157/162, mcfg.pdx L183/185). (5) Materialize address in rcx so we can preserve the return-value slot rax across the load. (6) mfence — bracket earlier WB stores (SDM Vol 3A §11.3.1). (7) mov eax, [rcx] — 32-bit MMIO load, zero-extends into rax per SDM Vol 2A §3.4.1.1. (8) mfence — bracket following stores. (9) 5-pop epilogue + ret. Encoder: no new mnemonics — push/pop, mov reg,reg, mov reg,imm, shl, add, cmp/je, mfence, mov reg32,[mem], call, ret all pre-#837 proven.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save args into callee-save regs — the mcfg call is caller-save-only.
        mov r12, rsi;                          // bus
        mov r13, rdx;                          // dev
        mov r14, rcx;                          // fn
        mov r15, r8;                           // offset

        // rdi already holds seg — call the R20.M3 lookup helper.
        call mcfg_ecam_base_for_segment;

        // Segment not in MCFG → synthesize an "absent device" read.
        cmp rax, 0;
        je pci_read_absent;

        // rax += bus << 20
        mov rbx, r12;
        shl rbx, 20;
        add rax, rbx;

        // rax += dev << 15
        mov rbx, r13;
        shl rbx, 15;
        add rax, rbx;

        // rax += fn << 12
        mov rbx, r14;
        shl rbx, 12;
        add rax, rbx;

        // rax += offset
        add rax, r15;

        // Move MMIO address into rcx so the load can overwrite rax freely.
        mov rcx, rax;

        mfence;
        mov eax, [rcx];                        // 32-bit load, zero-extends to rax
        mfence;
        jmp pci_read_done;

      pci_read_absent:
        mov rax, 0xFFFFFFFF;

      pci_read_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pci_config_write_u32(seg, bus, dev, fn, offset, value) -> ()
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, offset: u64, value: u64) -> ()
  //   rdi=seg, rsi=bus, rdx=dev, rcx=fn, r8=offset, r9=value
  //
  // Silent no-op if the segment is not present in MCFG (mirrors the
  // read-side absence-signal path).  Uses the `mov_d` sized-32-bit
  // store form to avoid REX.W widening (G1 encoder-gap workaround
  // established across apic/eoi.pdx, apic/ioapic.pdx, apic/init_sipi.pdx).

  pub let pci_config_write_u32 : (u64, u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, offset: u64, value: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-001 (#837 support): 32-bit ECAM write via segment-scoped MMIO. Uses the same segment→base→addr computation as pci_config_read_u32 but with a `mov_d [addr], value` MMIO store instead of a load. Body: 5-push callee-save + `sub rsp, 8` 1-align (6 slots pushed = 48 B; entry rsp%16==8 → 48+8 = 56 → rsp%16==8, so 1-align needed). Wait: 5 pushes push 40 B; rsp%16 goes 8 → 0 (aligned for the nested call). We must ALSO preserve `value` across the call (r9 is caller-save) — stash it in rbx alongside bus/dev/fn/offset in r12-r15. No 1-align required (5 pushes already aligned). Call mcfg_ecam_base_for_segment; if base is 0, silently return (segment not in MCFG). Otherwise compute ecam_addr = base + (bus<<20) + (dev<<15) + (fn<<12) + offset into rcx; mfence; mov_d [rcx], rbx; mfence. Return via 5-pop epilogue. mov_d is the G1 sized-32-bit store — bare `mov [rcx], ebx` would silently widen to REX.W and write 8 bytes into a 4-byte config-space slot, spilling into the neighboring register.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save args in callee-save regs across the nested call.
        mov r12, rsi;                          // bus
        mov r13, rdx;                          // dev
        mov r14, rcx;                          // fn
        mov r15, r8;                           // offset
        mov rbx, r9;                           // value

        call mcfg_ecam_base_for_segment;

        // Segment not present → silent no-op.
        cmp rax, 0;
        je pci_write_done;

        // rax += bus << 20
        mov rcx, r12;
        shl rcx, 20;
        add rax, rcx;

        // rax += dev << 15
        mov rcx, r13;
        shl rcx, 15;
        add rax, rcx;

        // rax += fn << 12
        mov rcx, r14;
        shl rcx, 12;
        add rax, rcx;

        // rax += offset
        add rax, r15;

        // rcx = MMIO address; rbx = value.
        mov rcx, rax;

        mfence;
        mov_d [rcx], rbx;                      // G1: sized 32-bit store
        mfence;

      pci_write_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pci_config_read_u16(seg, bus, dev, fn, offset) -> u16
  // ==========================================================================
  //
  // Reads the containing u32 (offset & ~3) and extracts the u16 field.
  // Offset need not be dword-aligned; only 2-byte alignment is required
  // by the PCI spec (u16 fields never straddle a dword boundary).
  //
  // Return: u16 zero-extended into rax, or 0xFFFF on segment-not-present.

  pub let pci_config_read_u16 : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-001 (#837 support): u16 ECAM read helper. Wraps pci_config_read_u32 by reading the dword at (offset & ~3), then shifting/masking to extract the target u16. Body: 1-align sub rsp,8 to satisfy SysV 16-byte call-boundary alignment (entry rsp%16==8 → sub 8 → rsp%16==0). Save the raw offset in r10 to compute the shift amount later — r10 is caller-save but we compute the shift before the call so no preservation needed. Actually simpler: pass (offset & ~3) as the aligned dword offset, then post-call shift by (offset & 2) * 8 bits, mask 0xFFFF. Since we need `offset` (the original) preserved across the call, save it locally. Use rbx (callee-save) for the byte-shift amount: (offset & 2) << 3 = 0 or 16. Prologue: push rbx (1 push) — rsp%16 goes 8 → 0. Save shift bits in rbx before the call. After call, shr rax, cl; and rax, 0xFFFF. Encoder: shr rax, cl requires the shift count in cl register — proven throughout tree. Actually simpler: `shr rax, imm8` — but the imm depends on offset, so we need shr-by-cl. mov cl, bl to load the shift amount into cl.",
      block: {
        push rbx;

        // Save bit-shift amount (either 0 or 16) in rbx.
        // shift = (offset & 2) << 3 = (offset & 2) * 8
        mov rbx, r8;                           // rbx = offset
        and rbx, 2;                            // rbx = 0 or 2
        shl rbx, 3;                            // rbx = 0 or 16

        // Align offset to dword: r8 = offset & ~3
        and r8, 0xFFFFFFFFFFFFFFFC;

        call pci_config_read_u32;

        // rax >>= shift (rbx holds shift count; move to cl)
        mov rcx, rbx;
        shr rax, cl;

        // rax &= 0xFFFF
        and rax, 0xFFFF;

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pci_config_read_u8(seg, bus, dev, fn, offset) -> u8
  // ==========================================================================
  //
  // Reads the containing u32 and extracts the u8 field at (offset & 3).

  pub let pci_config_read_u8 : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-001 (#837 support): u8 ECAM read helper. Same shape as pci_config_read_u16 but with shift = (offset & 3) * 8 (yielding 0, 8, 16, or 24) and mask 0xFF. `and r8, ~3` = `and r8, 0xFFFFFFFFFFFFFFFC` — same 64-bit mask constant pattern as core/apic/ioapic.pdx L598 for bit clearing.",
      block: {
        push rbx;

        // shift = (offset & 3) << 3
        mov rbx, r8;
        and rbx, 3;
        shl rbx, 3;

        // Align offset to dword.
        and r8, 0xFFFFFFFFFFFFFFFC;

        call pci_config_read_u32;

        mov rcx, rbx;
        shr rax, cl;
        and rax, 0xFF;

        pop rbx;
        ret
      }
    }
}
