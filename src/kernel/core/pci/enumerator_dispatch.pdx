// src/kernel/core/pci/enumerator_dispatch.pdx — R22-M3-005 / #860
//
// PCI-enumerator RPC dispatch helpers (kernel-side).
//
// Design context
// --------------
// Implements the three request/reply body-builders that the
// pci_enumerator userspace server exposes over IPC — but callable
// directly from the kernel-side witness that discharges #860's
// acceptance criteria (per the "Option B — kernel-side witness driving
// the RPC" posture documented in the iteration brief and matching the
// R20b.M5-001 / M6-003 / R20-M4-002 witness discipline).
//
// The three RPCs (design/ipc/pci-enumerator-schema.md §4, TBD):
//
//   op = 1  PCI_OP_LIST_DEVICES  → pci_enum_list_devices
//   op = 2  PCI_OP_DEVICE_INFO   → pci_enum_device_info
//   op = 3  PCI_OP_GET_BAR_CAP   → pci_enum_get_bar_cap
//
// Each helper writes a variable-length or fixed-length response payload
// into a caller-provided buffer and returns the number of bytes written
// (rax = len, callable straight into sys_ipc_reply_body's payload_len
// argument).
//
// Response payload layouts
// ------------------------
// Concretised from the R22-M3-005 pci_enumerator.pdx binary's dispatch
// arms — the wire shapes are matched byte-for-byte so a future
// ring-3 spawn of the userspace server can drop-in-replace the
// kernel-side dispatch without breaking clients.
//
//   ---- op=1 list_devices (variable) ----
//     +0  u16 n_devices
//     +2  dev_desc[n_devices], each 16 B:
//         +0   u16 bdf                 (bus<<8 | dev<<3 | fn — 16-bit BDF form
//                                        matching bdf_pack's low 16 bits when
//                                        seg=0)
//         +2   u16 vendor              (u16 from record+8)
//         +4   u16 device              (u16 from record+10)
//         +6   u16 _pad
//         +8   u32 class               ((class_code<<16) | (subclass<<8) — the
//                                        two 8-bit fields at record+6/+7 packed
//                                        into a 24-bit class-subclass-progif
//                                        triple with prog_if=0 at bits 0..7)
//        +12   u32 _pad2
//     payload_len = 2 + 16 * n_devices.
//
//   ---- op=2 device_info (fixed 64 B) ----
//     +0   u16 bdf
//     +2   u16 vendor
//     +4   u16 device
//     +6   u16 subsystem_vendor        (0 at R22.M3 — not yet parsed into
//                                        _pci_devices; slot reserved for
//                                        R23 driver-plane pull-up)
//     +8   u16 subsystem_id            (0 at R22.M3 — see above)
//    +10   u16 _pad
//    +12   u32 class                   ((class_code<<16)|(subclass<<8))
//    +16   u64 bars[6]                 (all zeros at R22.M3 — BAR sizing +
//                                        base-pa readback happens per-BAR
//                                        via pci_bar_size/pci_bar_decode
//                                        during driver-attach in R23)
//     Total = 64 bytes. Not-found (bdf not in _pci_devices) → returns 0
//     (empty payload signals absence to the caller — same convention as
//     sup_get_hpet's null-info path).
//
//   ---- op=3 get_bar_cap (fixed 40 B) ----
//     +0   u64 base_pa                 (bar_info.base_pa; 0 at R22.M3)
//     +8   u64 size                    (bar_info.size; 0 at R22.M3 —
//                                        pci_bar_size requires the BAR
//                                        decoder to be disabled, deferred
//                                        to R23 driver-attach)
//    +16   u8  kind                    (0 = absent at R22.M3)
//    +17   u8  prefetchable            (0)
//    +18   u8  is_64bit                (0)
//    +19   u8  bar_idx                 (echo of the caller's idx arg)
//    +20   u32 _pad
//    +24   u64 cap_handle              (device_cap_mint result from
//                                        _pci_devices[i]+16 — the scaffold
//                                        mint at R22.M3 returns
//                                        PCI_DEV_MINT_OK=0 for every valid
//                                        bdf, so this slot is 0 today;
//                                        real BAR-cap minting is R23 work)
//    +32   u64 _reserved
//     Total = 40 bytes. Not-found → returns 0.
//
// All multi-byte scalars are little-endian (matches x86-64 native u64
// stores and the record layout in core/pci/enum.pdx).
//
// Callers MUST pass out_max >= the maximum expected payload_len for each
// op (safe upper bounds: list_devices = 2 + 16*256 = 4098 -> caps at 4088
// bytes = FRAME_MAX_PAYLOAD, so n_devices_written may be less than
// _pci_device_count if the record cap trips; device_info = 64; get_bar_cap
// = 40). The witness passes 4088 (FRAME_MAX_PAYLOAD) for all three which
// comfortably fits.
//
// _pci_devices record layout (mirror of core/pci/enum.pdx §Layout)
// ----------------------------------------------------------------
//   +0    u16 segment
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  header_type
//   +6    u8  class_code
//   +7    u8  subclass
//   +8    u16 vendor_id
//   +10   u16 device_id
//   +12   u8  cap_ptr
//   +13   u8  _pad0
//   +14   u16 bar_kinds_bitmap
//   +16   u64 cap_handle (from pci_publish_caps; scaffolding at R22.M3)
//   +24   u64 _reserved_1
//   +32   end
//
// paideia-as encoder-gap posture (v0.22.x+):
//   G1: mov [mem], reg32 widens → mov_d for u32 stores.
//   G4: cmp al, imm may miscompile → full-register compares.
//
// Reserved-label discipline: paideia-as reserves `loop`, `next` etc. as
// keywords; all labels below are prefixed with the function's short
// name (`pel_` = pci_enum_list, `pei_` = device_info, `peg_` =
// get_bar_cap).

module EnumeratorDispatch = structure {

  // ============================================================================
  // Layout constants (mirror of the doc-block above).
  // ============================================================================

  pub let PCI_ENUM_LIST_DESC_SIZE   : u64 = 16
  pub let PCI_ENUM_LIST_HEADER_SIZE : u64 = 2   // u16 n_devices

  pub let PCI_ENUM_DEV_INFO_SIZE    : u64 = 64  // fixed
  pub let PCI_ENUM_BAR_CAP_SIZE     : u64 = 40  // fixed

  // ============================================================================
  // bdf_pack_from_record(record_ptr) -> u64  [inlined; see below]
  //
  // The 16-bit BDF form we emit in list_devices' per-entry desc packs
  // (bus, dev, fn) into a single u16 as:
  //   bits 15:8 = bus (u8)
  //   bits 7:3  = dev (5 bits)
  //   bits 2:0  = fn  (3 bits)
  // This matches the standard PCI 2.3+ BDF layout (bus*256 + dev*8 + fn).
  // seg is dropped at this width — clients that care about seg parse the
  // full record via device_info.
  // ============================================================================

  // ============================================================================
  // pci_enum_list_devices(out: u64, out_max: u64) -> u64
  //
  //   rdi = out buffer (caller-allocated, >= 2 + 16*n_devices bytes).
  //   rsi = out_max (bytes; helper stops writing when the next record
  //         would exceed this).
  //
  //   Returns rax = bytes written (2 + 16 * n_devices_recorded).
  //   _pci_device_count == 0 returns a lone u16 zero (2 bytes) — a
  //   valid empty enumeration (the primary path under -kernel boot
  //   where MCFG is absent).
  //
  // Per-entry decode (from _pci_devices[i] at 32-byte stride):
  //   bus       = *(u8*) (record + 2)
  //   dev       = *(u8*) (record + 3)
  //   fn        = *(u8*) (record + 4)
  //   class_c   = *(u8*) (record + 6)
  //   subclass  = *(u8*) (record + 7)
  //   vendor    = *(u16*)(record + 8)
  //   device    = *(u16*)(record + 10)
  //
  //   bdf_u16   = (bus << 8) | (dev << 3) | fn
  //   class_u32 = (class_c << 16) | (subclass << 8)
  //
  // Register plan (5-push callee-save):
  //   rbx = out cursor (advances by PCI_ENUM_LIST_DESC_SIZE per record)
  //   r12 = _pci_device_count
  //   r13 = loop index i
  //   r14 = &_pci_devices[i]
  //   r15 = out_end (out_base + out_max)
  //   r10/r11 = per-iteration scratch (bus / dev / fn / etc.)
  // ============================================================================

  pub let pci_enum_list_devices : (u64, u64) -> u64 !{mem} @{} =
    fn (out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M3-005 (#860): pci_enumerator.list_devices body — walks _pci_devices[0..N] (records at 32-byte stride, N in _pci_device_count) and copies a 16-byte dev_desc per function to the caller's buffer, prefixed by a u16 count. Per record: bdf (u16 = (bus<<8)|(dev<<3)|fn) → u16 @ out+0 via mov_w; vendor (u16 @ record+8) → u16 @ out+2; device (u16 @ record+10) → u16 @ out+4; _pad u16 @ out+6 = 0; class (u32 = (class_code<<16)|(subclass<<8)) → u32 @ out+8 via mov_d (G1); _pad2 u32 @ out+12 = 0. Buffer-full check inside the loop: `mov rax, rbx; add rax, 16; cmp rax, r15; ja done` — same two-word add+cmp+ja pattern as sup_get_mcfg_ranges §L448. _pci_device_count == 0 short-circuits with count=0 (writes just the 2-byte header + returns 2) — an empty enumeration is a valid response (the primary path under -kernel boot where MCFG is absent). Register plan: 5-push callee-save (rbx=out cursor, r12=count, r13=index, r14=record ptr, r15=out end). Encoder-gap posture: G1 (mov_d for every u32 store), G4 (full-reg cmp for the size gate). Reserved-label discipline: prefix `pel_` on every label.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Save + prepare ----
        mov rbx, rdi;                          // rbx = out cursor
        mov r15, rdi;
        add r15, rsi;                          // r15 = out_end

        // Write count placeholder = 0 at out+0 (u16). Advance cursor 2.
        xor rax, rax;
        mov_w [rbx], rax;
        add rbx, 2;

        // Load _pci_device_count into r12.
        mov r12, [rip + _pci_device_count];

        // Zero-count short-circuit: return just the 2-byte header.
        cmp r12, 0;
        je  pel_done;

        // Loop index i = 0.
        xor r13, r13;

      pel_loop:
        cmp r13, r12;
        jae pel_done;

        // Buffer-full check — need room for 16 more bytes.
        mov rax, rbx;
        add rax, 16;
        cmp rax, r15;
        ja  pel_done;

        // r14 = &_pci_devices[i] = base + (i << 5)
        mov rax, r13;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // ---- bdf_u16 = (bus << 8) | (dev << 3) | fn ----
        //   bus  @ record+2
        //   dev  @ record+3
        //   fn   @ record+4
        xor rax, rax;
        mov_b rax, [r14 + 2];                  // rax = bus
        shl rax, 8;                            // rax = bus << 8
        mov r10, rax;
        xor rax, rax;
        mov_b rax, [r14 + 3];                  // rax = dev
        and rax, 0x1F;                         // 5 bits
        shl rax, 3;                            // dev << 3
        or  r10, rax;
        xor rax, rax;
        mov_b rax, [r14 + 4];                  // rax = fn
        and rax, 7;                            // 3 bits
        or  r10, rax;                          // r10 = bdf_u16

        mov_w [rbx + 0], r10;

        // ---- vendor (u16 @ record+8) → u16 @ out+2 ----
        xor rax, rax;
        mov_w rax, [r14 + 8];
        mov_w [rbx + 2], rax;

        // ---- device (u16 @ record+10) → u16 @ out+4 ----
        xor rax, rax;
        mov_w rax, [r14 + 10];
        mov_w [rbx + 4], rax;

        // ---- _pad u16 @ out+6 = 0 ----
        xor rax, rax;
        mov_w [rbx + 6], rax;

        // ---- class_u32 = (class_code << 16) | (subclass << 8) ----
        //   class_code @ record+6, subclass @ record+7.
        xor rax, rax;
        mov_b rax, [r14 + 6];                  // class_code
        shl rax, 16;
        mov r10, rax;
        xor rax, rax;
        mov_b rax, [r14 + 7];                  // subclass
        shl rax, 8;
        or  r10, rax;                          // r10 = class_u32
        mov_d [rbx + 8], r10;

        // ---- _pad2 u32 @ out+12 = 0 ----
        xor rax, rax;
        mov_d [rbx + 12], rax;

        add rbx, 16;
        add r13, 1;
        jmp pel_loop;

      pel_done:
        // Patch the count at out_base = rbx - 2 - r13*16 (r13 counts
        // records written even on early buffer-full exit).
        mov rax, r13;
        shl rax, 4;                            // *16
        mov r10, rbx;
        sub r10, rax;
        sub r10, 2;                            // r10 = out_base
        mov_w [r10], r13;                      // write count (low 16 bits)

        // Return bytes written = 2 + 16*count = (rbx - out_base).
        mov rax, rbx;
        sub rax, r10;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_enum_device_info(bdf: u64, out: u64, out_max: u64) -> u64
  //
  //   rdi = bdf (16-bit form: bus<<8 | dev<<3 | fn — matches the wire
  //         width emitted by list_devices; only low 16 bits consulted).
  //   rsi = out buffer.
  //   rdx = out_max bytes.
  //
  // Returns rax = 64 on match, 0 on not-found (bdf not in _pci_devices
  // or out_max < 64).
  //
  // Look-up strategy: linear scan of _pci_devices[0..N] comparing the
  // low 16 bits of (bus<<8 | dev<<3 | fn) against the requested bdf.
  // N is bounded by PCI_MAX_DEVICES=256 so the scan is O(256) worst
  // case — comfortable under the ~30k-tick RPC-roundtrip budget.
  //
  // Response layout: see file header §op=2. Fields not yet parsed by
  // the R22.M3 enumerator (subsystem_vendor, subsystem_id, BARs) are
  // written as 0 — clients tolerate this per the append-only version
  // discipline (schema §6.3 TBD).
  //
  // Register plan (5-push callee-save):
  //   rbx = out cursor / out_base
  //   r12 = bdf_key (low 16 bits)
  //   r13 = _pci_device_count
  //   r14 = loop index
  //   r15 = matched record ptr (or 0)
  // ============================================================================

  pub let pci_enum_device_info : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bdf: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M3-005 (#860): pci_enumerator.device_info body — linear-scan _pci_devices[0..N] for a record matching the 16-bit bdf_key (bus<<8|dev<<3|fn), then encode the 64-byte fixed response. Not-found or out_max<64 returns 0 (empty payload signals absence). Response layout: +0 u16 bdf, +2 u16 vendor, +4 u16 device, +6 u16 sub_vendor, +8 u16 sub_id, +10 u16 _pad, +12 u32 class, +16 u64 bars[6]. sub_vendor/sub_id/bars stay zero at R22.M3 (not yet parsed into _pci_devices — schema §6.3 append-only discipline lets a later parser populate them without breaking clients). Scan cost bounded by PCI_MAX_DEVICES=256; comfortable under the ~30k-tick RPC roundtrip budget. Register plan: 5-push callee-save (rbx=out cursor/base, r12=bdf_key, r13=count, r14=index, r15=matched record ptr). G1: mov_d for u32 stores. G4: full-reg cmp for the bdf compare + size gate.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                          // rbx = out (base)
        mov r12, rdi;
        and r12, 0xFFFF;                       // r12 = bdf_key masked to u16

        // Out_max size gate.
        cmp rdx, 64;
        jb  pei_notfound;

        // _pci_device_count -> r13.
        mov r13, [rip + _pci_device_count];

        // Zero devices → not found.
        cmp r13, 0;
        je  pei_notfound;

        xor r14, r14;                          // loop index
        xor r15, r15;                          // matched ptr = 0

      pei_scan:
        cmp r14, r13;
        jae pei_scan_done;

        // record_ptr = &_pci_devices[i]
        mov rax, r14;
        shl rax, 5;
        lea r10, [rip + _pci_devices];
        add r10, rax;

        // Compute this record's bdf_key = (bus<<8) | (dev<<3) | fn.
        xor rax, rax;
        mov_b rax, [r10 + 2];                  // bus
        shl rax, 8;
        mov r11, rax;
        xor rax, rax;
        mov_b rax, [r10 + 3];                  // dev
        and rax, 0x1F;
        shl rax, 3;
        or  r11, rax;
        xor rax, rax;
        mov_b rax, [r10 + 4];                  // fn
        and rax, 7;
        or  r11, rax;                          // r11 = record's bdf_key

        cmp r11, r12;
        jne pei_scan_next;

        // Match — stash record ptr, exit loop.
        mov r15, r10;
        jmp pei_scan_done;

      pei_scan_next:
        add r14, 1;
        jmp pei_scan;

      pei_scan_done:
        cmp r15, 0;
        je  pei_notfound;

        // ---- Encode 64-byte response ----
        // +0 u16 bdf (echo back caller's bdf_key)
        mov_w [rbx + 0], r12;

        // +2 u16 vendor  (u16 @ record+8)
        xor rax, rax;
        mov_w rax, [r15 + 8];
        mov_w [rbx + 2], rax;

        // +4 u16 device  (u16 @ record+10)
        xor rax, rax;
        mov_w rax, [r15 + 10];
        mov_w [rbx + 4], rax;

        // +6 u16 sub_vendor = 0 (R22.M3: not parsed into _pci_devices)
        xor rax, rax;
        mov_w [rbx + 6], rax;

        // +8 u16 sub_id = 0
        mov_w [rbx + 8], rax;

        // +10 u16 _pad = 0
        mov_w [rbx + 10], rax;

        // +12 u32 class = (class_code << 16) | (subclass << 8)
        xor rax, rax;
        mov_b rax, [r15 + 6];                  // class_code
        shl rax, 16;
        mov r10, rax;
        xor rax, rax;
        mov_b rax, [r15 + 7];                  // subclass
        shl rax, 8;
        or  r10, rax;
        mov_d [rbx + 12], r10;

        // +16..+63 u64 bars[6] = 0 (R22.M3: BAR probing deferred to R23
        // driver-attach; slot reserved so ring-3 clients can size the
        // response without a schema bump.)
        xor rax, rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;
        mov [rbx + 32], rax;
        mov [rbx + 40], rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        // Return 64.
        mov rax, 64;
        jmp pei_epilogue;

      pei_notfound:
        xor rax, rax;

      pei_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_enum_get_bar_cap(bdf: u64, idx: u64, out: u64, out_max: u64) -> u64
  //
  //   rdi = bdf (16-bit form as in device_info).
  //   rsi = idx (0..5).
  //   rdx = out buffer.
  //   rcx = out_max bytes.
  //
  // Returns rax = 40 on match, 0 on not-found (bdf not in _pci_devices,
  // idx out-of-range, or out_max < 40).
  //
  // Response layout: see file header §op=3. base_pa/size/kind all zero
  // at R22.M3 (pci_bar_size requires the BAR decoder to be disabled and
  // per-BAR sizing is deferred to R23 driver-attach — see core/pci/bar.pdx
  // §L23 "disable before, enable after" note). cap_handle is read from
  // _pci_devices[i]+16 (populated by pci_publish_caps; scaffolding at
  // R22.M3 = PCI_DEV_MINT_OK=0 for every mint). bar_idx is echoed back
  // to the caller as a sanity byte.
  //
  // Register plan (5-push callee-save + 1-byte pad = 48 bytes → rsp%16
  // aligned for the (unused) nested-call boundary):
  //   rbx = out cursor / out_base
  //   r12 = bdf_key
  //   r13 = idx (masked to low byte)
  //   r14 = matched record ptr (or 0)
  //   r15 = _pci_device_count (scratch across the linear scan)
  // ============================================================================

  pub let pci_enum_get_bar_cap : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bdf: u64, idx: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M3-005 (#860): pci_enumerator.get_bar_cap body — look up _pci_devices record by bdf_key (linear scan, same shape as pci_enum_device_info), gate idx<=5, encode the 40-byte fixed response. Not-found (bdf miss / idx>5 / out_max<40) returns 0. Response layout: +0 u64 base_pa, +8 u64 size, +16 u8 kind, +17 u8 prefetchable, +18 u8 is_64bit, +19 u8 bar_idx, +20 u32 _pad, +24 u64 cap_handle, +32 u64 _reserved. base_pa/size/kind/prefetchable/is_64bit stay zero at R22.M3 — pci_bar_size requires BAR decoder disable (core/pci/bar.pdx §L23) and per-BAR sizing is deferred to R23 driver-attach. bar_idx echoes back the caller's idx as a sanity byte (u8 mask). cap_handle read from record+16 (populated by pci_publish_caps; scaffolding at R22.M3 returns PCI_DEV_MINT_OK=0). Register plan: 5-push callee-save (rbx=out cursor/base, r12=bdf, r13=idx, r14=matched ptr, r15=count). G1: mov_d for u32 stores. G4: full-reg cmp on idx gate + bdf compare + size gate.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdx;                          // rbx = out (base)
        mov r12, rdi;
        and r12, 0xFFFF;                       // r12 = bdf_key
        mov r13, rsi;
        and r13, 0xFF;                         // r13 = idx (u8)

        // Size gate: need >=40 bytes.
        cmp rcx, 40;
        jb  peg_notfound;

        // idx range gate: <=5.
        cmp r13, 5;
        ja  peg_notfound;

        // _pci_device_count -> r15.
        mov r15, [rip + _pci_device_count];
        cmp r15, 0;
        je  peg_notfound;

        // Linear scan (mirror of pei_scan).
        xor rax, rax;                          // rax = loop index i
        mov r14, 0;                            // r14 = matched ptr = 0

      peg_scan:
        cmp rax, r15;
        jae peg_scan_done;

        mov r10, rax;
        shl r10, 5;
        lea r11, [rip + _pci_devices];
        add r11, r10;                          // r11 = &_pci_devices[i]

        // Compute this record's bdf_key.
        xor r10, r10;
        mov_b r10, [r11 + 2];                  // bus
        shl r10, 8;
        mov r8, r10;
        xor r10, r10;
        mov_b r10, [r11 + 3];                  // dev
        and r10, 0x1F;
        shl r10, 3;
        or  r8, r10;
        xor r10, r10;
        mov_b r10, [r11 + 4];                  // fn
        and r10, 7;
        or  r8, r10;                           // r8 = record's bdf_key

        cmp r8, r12;
        jne peg_scan_next;

        // Match.
        mov r14, r11;
        jmp peg_scan_done;

      peg_scan_next:
        add rax, 1;
        jmp peg_scan;

      peg_scan_done:
        cmp r14, 0;
        je  peg_notfound;

        // ---- Encode 40-byte response ----
        // +0 u64 base_pa = 0 (R22.M3: BAR probing deferred)
        xor rax, rax;
        mov [rbx + 0], rax;

        // +8 u64 size = 0
        mov [rbx + 8], rax;

        // +16 u8 kind = 0
        mov_b [rbx + 16], rax;

        // +17 u8 prefetchable = 0
        mov_b [rbx + 17], rax;

        // +18 u8 is_64bit = 0
        mov_b [rbx + 18], rax;

        // +19 u8 bar_idx = caller's idx
        mov_b [rbx + 19], r13;

        // +20 u32 _pad = 0
        mov_d [rbx + 20], rax;

        // +24 u64 cap_handle = record+16 (populated by pci_publish_caps)
        mov r10, [r14 + 16];
        mov [rbx + 24], r10;

        // +32 u64 _reserved = 0
        mov [rbx + 32], rax;

        // Return 40.
        mov rax, 40;
        jmp peg_epilogue;

      peg_notfound:
        xor rax, rax;

      peg_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
