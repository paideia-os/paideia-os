// src/kernel/core/pci/cap.pdx — R21-M4-001 (#837)
//
// PCI capability-list walker.
//
// The PCI 2.3+ / PCIe capability list is a singly-linked chain of
// 2-byte headers embedded in configuration space at (cap_ptr, next_ptr)
// pairs.  Root pointer lives at config offset 0x34 (u8, dword-index
// into config space; the low 2 bits must be masked before dereference).
//
// Prerequisites for a valid capability list:
//   * Config-space read at offset 0x00 (Vendor ID, u16) is not 0xFFFF
//     (device present).
//   * Config-space read at offset 0x06 (Status Register, u16) has
//     bit 4 (Capabilities List) set.  If this bit is clear, the device
//     has no capability chain at all — return not-found immediately.
//
// Each capability header (2 bytes at `cap_ptr`) is:
//   +0  u8  cap_id      (0x05=MSI, 0x11=MSI-X, 0x10=PCIe, others)
//   +1  u8  next_ptr    (0=end-of-list; otherwise dword-aligned offset)
//
// Both `cap_ptr` and `next_ptr` are constrained to [0x40, 0xFF] on
// legacy PCI (the standard header occupies 0x00-0x3F); we permit
// [0x40, 0xFFC] to cover extended-config-space MSI-X entries.
//
// -----------------------------------------------------------------------------
// Termination guard
// -----------------------------------------------------------------------------
//
// The walker bounds the number of visited capabilities at 48 (the
// theoretical maximum with the smallest 4-byte spacing across 256-byte
// legacy config space would be 64; 48 is a safe conservative ceiling
// that still tolerates all conforming devices).  Reaching the cap on a
// cyclic or corrupt chain falls through as "not found" — never a
// runtime hang.

module Cap = structure {

  // ==========================================================================
  // R22-M3-001 (#856): Named PCI capability IDs (PCI 3.0 §H.4)
  // ==========================================================================
  //
  // Each u64 constant is the u8 capability-ID byte at offset +0 of a
  // capability header in legacy configuration space. Kept at module
  // scope so downstream drivers reference them as `Cap.PCI_CAP_MSI`
  // rather than magic numbers. Order matches the PCI spec table with
  // gaps filled in numerically.

  pub let PCI_CAP_PWR_MGMT   : u64 = 0x01   // Power Management (PCI 2.2+)
  pub let PCI_CAP_AGP        : u64 = 0x02   // AGP (deprecated; kept for enumeration)
  pub let PCI_CAP_VPD        : u64 = 0x03   // Vital Product Data
  pub let PCI_CAP_SLOTID     : u64 = 0x04   // Slot Identification (PCI bridges)
  pub let PCI_CAP_MSI        : u64 = 0x05   // Message Signaled Interrupts
  pub let PCI_CAP_CHSWP      : u64 = 0x06   // CompactPCI Hot-Swap
  pub let PCI_CAP_PCIX       : u64 = 0x07   // PCI-X (deprecated; kept for enumeration)
  pub let PCI_CAP_HT         : u64 = 0x08   // HyperTransport
  pub let PCI_CAP_VENDOR     : u64 = 0x09   // Vendor-Specific
  pub let PCI_CAP_DBGPORT    : u64 = 0x0A   // Debug Port
  pub let PCI_CAP_CPCICSR    : u64 = 0x0B   // CompactPCI CSR
  pub let PCI_CAP_HOTPLUG    : u64 = 0x0C   // PCI Hot-Plug
  pub let PCI_CAP_BRIDGE_SUB : u64 = 0x0D   // PCI Bridge Subsystem Vendor/Device ID
  pub let PCI_CAP_AGP8X      : u64 = 0x0E   // AGP 8x
  pub let PCI_CAP_SECURE     : u64 = 0x0F   // Secure Device (PCI SIG "Secure Device")
  pub let PCI_CAP_PCIE       : u64 = 0x10   // PCI Express
  pub let PCI_CAP_MSIX       : u64 = 0x11   // MSI-X
  pub let PCI_CAP_SATA       : u64 = 0x12   // SATA Data/Index Configuration
  pub let PCI_CAP_AF         : u64 = 0x13   // Advanced Features (PCI 3.0 §H.11)

  // ==========================================================================
  // pci_find_cap(seg, bus, dev, func, cap_id) -> u16
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, cap_id: u64) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func, r8=cap_id (u8 in low bits)
  //
  // Returns rax = capability-header offset (u16) if found, else 0.
  //
  // Register plan (6 pushes + 8-byte align = 56 B → rsp%16==0 pre-call):
  //   rbx = cap_id (u8, from r8)
  //   rbp = cursor (u16, current cap offset in config space)
  //   r12 = seg, r13 = bus, r14 = dev, r15 = func
  //
  // Uses rbp as a callee-save cursor even though rbp is conventionally
  // a frame pointer — rbp is a valid SysV callee-save reg per SDM Vol
  // 1 §3.4.1, and none of the nested pci_config_read_u8 / u16 calls
  // touch it.  Same posture as core/int/dump.pdx which pushes rbp then
  // uses it as scratch.

  pub let pci_find_cap : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, cap_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-001 (#837): PCI capability-list walker. Body: (1) 6-push callee-save prologue (rbx, rbp, r12, r13, r14, r15) + `sub rsp, 8` 1-align. Entry rsp%16==8; after 6 pushes (48 B) → rsp%16=8; sub 8 → rsp%16=0 for the nested calls. (2) Save all args in callee-save regs: r12=seg, r13=bus, r14=dev, r15=func, rbx=cap_id (masked to u8). (3) Presence check: call pci_config_read_u16(seg, bus, dev, func, 0x00) → vendor_id. If rax==0xFFFF (all-ones), device absent → return 0. (4) Status-list check: call pci_config_read_u16(seg, bus, dev, func, 0x06) → status; if bit 4 clear (`and rax, 0x10; cmp rax, 0; je notfound`), device has no capability list → return 0. (5) Root pointer: call pci_config_read_u8(seg, bus, dev, func, 0x34) → cap_ptr; mask low 2 bits (`and rax, 0xFC`) — spec says cap pointers are dword-aligned and the low 2 bits are reserved. Save into rbp. (6) Bound the walk at 48 iterations (r10 counter): each iteration checks `rbp == 0` (end-of-list → notfound) and `r10 >= 48` (corrupt/cyclic → notfound), otherwise reads (u8 cap_id, u8 next_ptr) via two pci_config_read_u8 calls (rbp+0 and rbp+1) and compares cap_id against rbx. On match, return rbp (u16 zero-extended). On miss, load next_ptr (masked to 0xFC) into rbp, increment r10, loop. (7) Not-found epilogue returns 0. r10 is caller-save but not touched by pci_config_read_u8 (which internally uses rbx as its own scratch — but rbx is callee-save for pci_config_read_u8 too, so preserved). r10 is however clobbered across the read call; we re-load it via a saved counter in another callee-save reg. Actually simpler: keep the visit counter in a callee-save reg (spill to memory since we've used rbp/rbx/r12-r15). Use the stack slot below the align pad — [rsp+0] holds the counter. Increment via `mov rax, [rsp]; add rax, 1; mov [rsp], rax` sandwich; compare via `mov rax, [rsp]; cmp rax, 48`. Encoder: mov reg,[rsp]; add reg, imm; mov [rsp], reg; cmp/jae; call — all pre-#837 proven.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // 1-align + visit counter slot @[rsp+0]

        // Initialize visit counter at [rsp+0].
        mov rax, 0;
        mov [rsp], rax;

        // Save args in callee-save regs.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // cap_id
        and rbx, 0xFF;                         // mask to u8

        // ---- (3) Presence check: read vendor_id (u16 @ 0x00). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x00;
        call pci_config_read_u16;

        // If vendor_id == 0xFFFF, device absent.
        cmp rax, 0xFFFF;
        je pci_find_cap_notfound;

        // ---- (4) Capabilities-List bit: read status (u16 @ 0x06). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x06;
        call pci_config_read_u16;

        // Test bit 4 of status.
        and rax, 0x10;
        cmp rax, 0;
        je pci_find_cap_notfound;

        // ---- (5) Root pointer: read cap_ptr (u8 @ 0x34). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x34;
        call pci_config_read_u8;

        // Mask low 2 bits — dword-aligned.
        and rax, 0xFC;
        mov rbp, rax;                          // rbp = cursor

      pci_find_cap_loop:
        // End-of-list guard.
        cmp rbp, 0;
        je pci_find_cap_notfound;

        // Visit-count guard: 48 max.
        mov rax, [rsp];
        cmp rax, 48;
        jae pci_find_cap_notfound;

        // Read cap_id at rbp+0.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;                           // offset = cursor
        call pci_config_read_u8;

        // Compare against target cap_id.
        cmp rax, rbx;
        je pci_find_cap_hit;

        // Read next_ptr at rbp+1.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        add r8, 1;
        call pci_config_read_u8;

        // Mask low 2 bits, advance cursor.
        and rax, 0xFC;
        mov rbp, rax;

        // Increment visit counter.
        mov rax, [rsp];
        add rax, 1;
        mov [rsp], rax;

        jmp pci_find_cap_loop;

      pci_find_cap_hit:
        mov rax, rbp;                          // return current cap offset
        and rax, 0xFFFF;                       // ensure u16
        jmp pci_find_cap_done;

      pci_find_cap_notfound:
        mov rax, 0;

      pci_find_cap_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // R22-M3-001 (#856)
  // pci_walk_caps(seg, bus, dev, func, callback) -> u64
  // ==========================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, func: u64, callback: u64) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func, r8=callback fn(cap_id, cap_off) -> ()
  //
  // Returns rax = number of capabilities visited.
  //
  // Structural sibling to pci_find_cap: same presence check, same
  // status-bit gate, same root-pointer read, same 48-visit safety cap,
  // same dword-alignment mask. The difference is the loop body: instead
  // of matching a target cap_id, we invoke the caller-supplied
  // callback(cap_id_u64, cap_off_u64) for every capability header seen.
  //
  // The callback contract mirrors acpi_xsdt_iter (see
  // src/kernel/acpi/xsdt.pdx): the callback MUST return normally (`ret`)
  // and MUST preserve rbx / rbp / r12 / r13 / r14 / r15 (SysV callee-
  // save). Volatile regs (rax, rcx, rdx, rsi, rdi, r8..r11) are free
  // for the callback to clobber; the walker reloads its cursor from
  // callee-save state on each iteration.
  //
  // Register plan (identical prologue to pci_find_cap, one extra
  // callee-save reg for the callback pointer — spill the visit counter
  // to the 1-align stack slot as before):
  //
  //   r12 = seg, r13 = bus, r14 = dev, r15 = func
  //   rbx = callback function pointer
  //   rbp = cursor (current cap offset in config space)
  //   [rsp+0] = visit counter (survives the indirect call)
  //
  // Stack frame: 6 × push + `sub rsp, 8` = 56 B → post-prologue rsp%16
  // == 0 (SysV call-boundary aligned).

  pub let pci_walk_caps : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, callback: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M3-001 (#856): PCI capability-list walker with callback dispatch. Structural sibling to pci_find_cap — same presence check (vendor_id != 0xFFFF at offset 0x00), same status-bit gate (bit 4 of status at 0x06), same root-pointer at offset 0x34 dword-aligned via `and 0xFC`, same 48-visit safety cap and end-of-list guard on rbp==0. The loop body differs: on each header the walker reads cap_id (u8 @ cursor+0), invokes callback(cap_id_u64, cursor_u64) via indirect `call rbx` (same idiom as acpi_xsdt_iter's `call r15` in src/kernel/acpi/xsdt.pdx L198 and vops dispatcher's `call rax`), then reads next_ptr (u8 @ cursor+1), masks low 2 bits, and advances. The visit counter lives in the 1-align stack slot [rsp+0] because it must survive the indirect callback call (callback is caller-save-preserving per SysV — it preserves rbx/rbp/r12..r15 for us, but the counter would be in a volatile reg otherwise). Return value = visit count (rax reloaded from [rsp+0] at epilogue). Preserves rbx by pushing it in the prologue so callers who nested pci_walk_caps see their own rbx intact.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // 1-align + visit counter slot @[rsp+0]

        // Initialize visit counter at [rsp+0].
        mov rax, 0;
        mov [rsp], rax;

        // Save args in callee-save regs.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // callback

        // ---- Presence check: read vendor_id (u16 @ 0x00). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x00;
        call pci_config_read_u16;

        cmp rax, 0xFFFF;
        je pci_walk_caps_done;

        // ---- Capabilities-List bit: read status (u16 @ 0x06). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x06;
        call pci_config_read_u16;

        and rax, 0x10;
        cmp rax, 0;
        je pci_walk_caps_done;

        // ---- Root pointer: read cap_ptr (u8 @ 0x34). ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x34;
        call pci_config_read_u8;

        and rax, 0xFC;                         // dword-aligned per spec
        mov rbp, rax;                          // rbp = cursor

      pci_walk_caps_loop:
        // End-of-list guard.
        cmp rbp, 0;
        je pci_walk_caps_done;

        // Visit-count guard: 48 max (identical bound to pci_find_cap).
        mov rax, [rsp];
        cmp rax, 48;
        jae pci_walk_caps_done;

        // Read cap_id at rbp+0.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        call pci_config_read_u8;

        // Dispatch callback(cap_id, cap_off).
        // rax already holds cap_id (u8 zero-extended). rbp holds cursor.
        mov rdi, rax;                          // arg0 = cap_id
        mov rsi, rbp;                          // arg1 = cap_off (u16 zero-extended)
        and rsi, 0xFFFF;
        call rbx;

        // Read next_ptr at rbp+1.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        add r8, 1;
        call pci_config_read_u8;

        // Mask low 2 bits, advance cursor.
        and rax, 0xFC;
        mov rbp, rax;

        // Increment visit counter.
        mov rax, [rsp];
        add rax, 1;
        mov [rsp], rax;

        jmp pci_walk_caps_loop;

      pci_walk_caps_done:
        mov rax, [rsp];                        // return visit count
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
