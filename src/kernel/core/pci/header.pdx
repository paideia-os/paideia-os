// src/kernel/core/pci/header.pdx — R22-M1-001 (#850)
//
// PCI configuration-space header decoders — Type 0 (endpoint) and
// Type 1 (bridge).
//
// The first 64 bytes of every PCI function's configuration space are
// architecturally fixed to one of two "header type" layouts, selected
// by bit 6..0 of the u8 at offset 0x0E (bit 7 is the multi-function
// flag, orthogonal here):
//
//   Header type 0x00 — general endpoint (NIC, GPU, disk, etc.)
//   Header type 0x01 — PCI-to-PCI bridge
//   Header type 0x02 — CardBus bridge  (legacy; not decoded here — the
//                      last hardware to ship this was pre-2010 laptop
//                      docking chipsets; unsupported by paideia-os)
//
// -----------------------------------------------------------------------------
// Type 0 (endpoint) — 64-byte prefix (offsets 0x00..0x3F)
// -----------------------------------------------------------------------------
//
//   +0x00  u16 vendor_id            u16 device_id
//   +0x04  u16 command              u16 status
//   +0x08  u8  revision_id          u8 prog_if      u8 subclass     u8 class_code
//   +0x0C  u8  cache_line_size      u8 lat_timer    u8 header_type  u8 bist
//   +0x10  u32 bar0
//   +0x14  u32 bar1
//   +0x18  u32 bar2
//   +0x1C  u32 bar3
//   +0x20  u32 bar4
//   +0x24  u32 bar5
//   +0x28  u32 cardbus_cis_ptr      (unused for non-CardBus; still readable)
//   +0x2C  u16 sub_vendor_id        u16 sub_device_id
//   +0x30  u32 rom_bar
//   +0x34  u8  cap_ptr              [3-byte reserved]
//   +0x38  u32 reserved
//   +0x3C  u8  interrupt_line       u8 interrupt_pin  u8 min_grant  u8 max_lat
//
// Out struct layout (56 bytes, @align(8)) — packed to match a caller's
// zero-copy consumption pattern:
//
//   +0    u16 vendor_id
//   +2    u16 device_id
//   +4    u16 command
//   +6    u16 status
//   +8    u8  revision_id
//   +9    u8  prog_if
//   +10   u8  subclass
//   +11   u8  class_code
//   +12   u8  cache_line_size
//   +13   u8  lat_timer
//   +14   u8  header_type
//   +15   u8  bist
//   +16   u32 bar0
//   +20   u32 bar1
//   +24   u32 bar2
//   +28   u32 bar3
//   +32   u32 bar4
//   +36   u32 bar5
//   +40   u16 sub_vendor_id
//   +42   u16 sub_device_id
//   +44   u32 rom_bar
//   +48   u8  cap_ptr
//   +49   u8  interrupt_line
//   +50   u8  interrupt_pin
//   +51   u8  min_grant
//   +52   u8  max_lat
//   +53   u8  _pad[3]
//   +56   end
//
// -----------------------------------------------------------------------------
// Type 1 (bridge) — 64-byte prefix (offsets 0x00..0x3F)
// -----------------------------------------------------------------------------
//
//   +0x00  u16 vendor_id            u16 device_id
//   +0x04  u16 command              u16 status
//   +0x08  u8  revision_id          u8 prog_if      u8 subclass     u8 class_code
//   +0x0C  u8  cache_line_size      u8 lat_timer    u8 header_type  u8 bist
//   +0x10  u32 bar0
//   +0x14  u32 bar1
//   +0x18  u8  primary_bus          u8 secondary_bus  u8 subordinate_bus  u8 sec_lat_timer
//   +0x1C  u8  io_base              u8 io_limit       u16 secondary_status
//   +0x20  u16 mem_base             u16 mem_limit
//   +0x24  u16 pref_mem_base        u16 pref_mem_limit
//   +0x28  u32 pref_base_upper32
//   +0x2C  u32 pref_limit_upper32
//   +0x30  u16 io_base_upper16      u16 io_limit_upper16
//   +0x34  u8  cap_ptr              [3-byte reserved]
//   +0x38  u32 rom_bar
//   +0x3C  u8  interrupt_line       u8 interrupt_pin  u16 bridge_control
//
// Out struct layout (56 bytes, @align(8)):
//
//   +0    u16 vendor_id
//   +2    u16 device_id
//   +4    u16 command
//   +6    u16 status
//   +8    u8  revision_id
//   +9    u8  prog_if
//   +10   u8  subclass
//   +11   u8  class_code
//   +12   u8  cache_line_size
//   +13   u8  lat_timer
//   +14   u8  header_type
//   +15   u8  bist
//   +16   u32 bar0
//   +20   u32 bar1
//   +24   u8  primary_bus
//   +25   u8  secondary_bus
//   +26   u8  subordinate_bus
//   +27   u8  sec_lat_timer
//   +28   u8  io_base
//   +29   u8  io_limit
//   +30   u16 secondary_status
//   +32   u16 mem_base
//   +34   u16 mem_limit
//   +36   u16 pref_mem_base
//   +38   u16 pref_mem_limit
//   +40   u32 pref_base_upper32
//   +44   u32 pref_limit_upper32
//   +48   u16 io_base_upper16
//   +50   u16 io_limit_upper16
//   +52   u8  cap_ptr
//   +53   u8  interrupt_line
//   +54   u8  interrupt_pin
//   +55   u16 bridge_control  (u16 written as low byte @ +55, high @ +56 — but we cap struct at 56 B; store low byte only for size symmetry)
//
// For R22.M1 the exact tail layout of Type-1 is documentary — R22.M2's
// bus scanner will consume secondary_bus / subordinate_bus for bridge
// walk; every other field is stored for later consumers.
//
// -----------------------------------------------------------------------------
// pci_probe_device(seg, bus, dev, fn) -> u64
// -----------------------------------------------------------------------------
//
// Reads vendor_id (u16 @ 0x00). If 0xFFFF the function is absent
// (returns 0). Otherwise reads header_type (u8 @ 0x0E) and returns
// (header_type & 0x7F) + 1 packed into low byte:
//
//   return value  meaning
//   0             absent — vendor_id was 0xFFFF
//   1             Type 0 (endpoint)
//   2             Type 1 (bridge)
//   3             Type 2 (CardBus — not decoded here)
//   4             unknown header type (>= 3)
//
// (We add 1 so that "0" unambiguously means "absent". Callers must
// subtract 1 to recover the raw header type when needed.)
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens → use `mov_d` for u32
//        stores.  For u16 stores use `mov_w`; for u8 stores use `mov_b`.
//   G4: full-register compares.
//
// -----------------------------------------------------------------------------
// Register plan (pci_probe_device, 5-push callee-save)
// -----------------------------------------------------------------------------
//
//   push rbx, r12, r13, r14, r15 (40 B) — rsp%16==0 pre-call.
//   Save seg/bus/dev/fn in r12/r13/r14/r15 for the second read call.
//
// -----------------------------------------------------------------------------
// Register plan (pci_read_type0_header / pci_read_type1_header, 6-push + 8 align)
// -----------------------------------------------------------------------------
//
//   push rbx, rbp, r12, r13, r14, r15 (48 B); sub rsp, 8 (align).
//   rbx = out ptr; r12..r15 = seg/bus/dev/fn.  Each field is read via
//   one pci_config_read_uN call and stored into rbx + offset via the
//   size-appropriate mov_b / mov_w / mov_d.

module Header = structure {

  // ==========================================================================
  // Layout constants (out struct offsets — Type 0)
  // ==========================================================================

  pub let PCI_TYPE0_OUT_SIZE          : u64 = 56

  // ==========================================================================
  // Layout constants (out struct offsets — Type 1)
  // ==========================================================================

  pub let PCI_TYPE1_OUT_SIZE          : u64 = 56

  // ==========================================================================
  // pci_probe_device(seg, bus, dev, fn) -> u64
  // ==========================================================================
  //
  // SysV: (seg, bus, dev, fn) — rdi=seg, rsi=bus, rdx=dev, rcx=fn.
  // Returns rax = 0 (absent) or 1|2|3|4 (type + 1).

  pub let pci_probe_device : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-001 (#850): PCI device presence + header-type probe. Body: (1) 5-push callee-save (rbx, r12-r15) — 40 B → rsp%16==0 pre-call. (2) Save seg/bus/dev/fn into r12/r13/r14/r15. (3) Call pci_config_read_u16(seg, bus, dev, fn, 0x00) — returns vendor_id in rax. If 0xFFFF, function is absent per PCI 3.0 §6.1 (reads to an unimplemented function return all-ones). Return 0. (4) Otherwise, restore args and call pci_config_read_u8(seg, bus, dev, fn, 0x0E) — returns header_type u8. Mask bit 7 (multi-function flag, orthogonal to type). (5) Compare masked value to 0/1/2; return 1/2/3 respectively; else return 4 (unknown). We deliberately add 1 to the raw type so the 'absent' signal (0) is disjoint from any valid header type. Encoder: no new mnemonics. Nested calls to pci_config_read_u16 and pci_config_read_u8 use standard SysV; both are R21.M4 pre-existing.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save args (seg was already in rdi; the callee will clobber rdi).
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // (1) Read vendor_id (u16 @ 0x00).
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8,  0;
        call pci_config_read_u16;

        cmp rax, 0xFFFF;
        je pci_probe_absent;

        // (2) Read header_type (u8 @ 0x0E).
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8,  0x0E;
        call pci_config_read_u8;

        // Mask off the multi-function flag (bit 7).
        and rax, 0x7F;

        // Classify: 0 → 1, 1 → 2, 2 → 3, other → 4.
        cmp rax, 0;
        je pci_probe_type0;
        cmp rax, 1;
        je pci_probe_type1;
        cmp rax, 2;
        je pci_probe_type2;

        mov rax, 4;
        jmp pci_probe_done;

      pci_probe_type0:
        mov rax, 1;
        jmp pci_probe_done;

      pci_probe_type1:
        mov rax, 2;
        jmp pci_probe_done;

      pci_probe_type2:
        mov rax, 3;
        jmp pci_probe_done;

      pci_probe_absent:
        xor rax, rax;

      pci_probe_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pci_read_type0_header(seg, bus, dev, fn, out) -> ()
  // ==========================================================================
  //
  // SysV: rdi=seg, rsi=bus, rdx=dev, rcx=fn, r8=out.
  // Populates the 56-byte PCI Type 0 out struct (see module-doc layout).
  //
  // Precondition: caller has verified pci_probe_device returned 1 (endpoint).
  // If the device is absent the reads yield 0xFFFF..0xFFFFFFFF and are
  // stored verbatim — the caller is responsible for the presence guard.

  pub let pci_read_type0_header : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, out: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-001 (#850): PCI Type 0 (endpoint) header decoder. Reads the 64-byte config-space prefix via 26 pci_config_read_u{8,16,32} calls and stores each field into the caller's 56-byte out struct at the offsets documented in the module header. Body: (1) 6-push callee-save (rbx, rbp, r12-r15) + sub rsp, 8 for SysV 16-B alignment across the nested calls — entry rsp%16==8; 6 pushes = 48 B → rsp%16==8; sub 8 → rsp%16==0. (2) rbx = out; r12/r13/r14/r15 = seg/bus/dev/fn. (3) For each field, restore rdi/rsi/rdx/rcx from r12-r15, set r8 = config offset, call pci_config_read_uN, then store rax into [rbx + out_offset] via the appropriate sized store (mov_b for u8, mov_w for u16, mov_d for u32 — all G1-safe sized stores). BARs are the bulk of the work: 6 × u32 reads to 0x10, 0x14, 0x18, 0x1C, 0x20, 0x24. Epilogue: add rsp, 8; 6-pop; ret. Encoder: no new mnemonics; every op pre-existing in the R21.M4 pci_config_* callers (msi.pdx / msix.pdx). Absent-device semantics: if caller invokes with a non-existent BDF, every read returns 0xFFFF or 0xFFFFFFFF; the out struct is populated with those sentinels verbatim — no in-band error signalling. Callers gate on pci_probe_device first.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, r8;               // out
        mov r12, rdi;              // seg
        mov r13, rsi;              // bus
        mov r14, rdx;              // dev
        mov r15, rcx;              // fn

        // ---- +0x00 u16 vendor_id → out+0 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x00;
        call pci_config_read_u16;
        mov_w [rbx + 0], rax;

        // ---- +0x02 u16 device_id → out+2 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x02;
        call pci_config_read_u16;
        mov_w [rbx + 2], rax;

        // ---- +0x04 u16 command → out+4 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x04;
        call pci_config_read_u16;
        mov_w [rbx + 4], rax;

        // ---- +0x06 u16 status → out+6 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x06;
        call pci_config_read_u16;
        mov_w [rbx + 6], rax;

        // ---- +0x08 u8 revision_id → out+8 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x08;
        call pci_config_read_u8;
        mov_b [rbx + 8], rax;

        // ---- +0x09 u8 prog_if → out+9 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x09;
        call pci_config_read_u8;
        mov_b [rbx + 9], rax;

        // ---- +0x0A u8 subclass → out+10 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0A;
        call pci_config_read_u8;
        mov_b [rbx + 10], rax;

        // ---- +0x0B u8 class_code → out+11 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0B;
        call pci_config_read_u8;
        mov_b [rbx + 11], rax;

        // ---- +0x0C u8 cache_line_size → out+12 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0C;
        call pci_config_read_u8;
        mov_b [rbx + 12], rax;

        // ---- +0x0D u8 lat_timer → out+13 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0D;
        call pci_config_read_u8;
        mov_b [rbx + 13], rax;

        // ---- +0x0E u8 header_type → out+14 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0E;
        call pci_config_read_u8;
        mov_b [rbx + 14], rax;

        // ---- +0x0F u8 bist → out+15 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0F;
        call pci_config_read_u8;
        mov_b [rbx + 15], rax;

        // ---- +0x10..0x24 u32 bar0..bar5 → out+16..36 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x10;
        call pci_config_read_u32;
        mov_d [rbx + 16], rax;

        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x14;
        call pci_config_read_u32;
        mov_d [rbx + 20], rax;

        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x18;
        call pci_config_read_u32;
        mov_d [rbx + 24], rax;

        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x1C;
        call pci_config_read_u32;
        mov_d [rbx + 28], rax;

        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x20;
        call pci_config_read_u32;
        mov_d [rbx + 32], rax;

        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x24;
        call pci_config_read_u32;
        mov_d [rbx + 36], rax;

        // ---- +0x2C u16 sub_vendor_id → out+40 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x2C;
        call pci_config_read_u16;
        mov_w [rbx + 40], rax;

        // ---- +0x2E u16 sub_device_id → out+42 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x2E;
        call pci_config_read_u16;
        mov_w [rbx + 42], rax;

        // ---- +0x30 u32 rom_bar → out+44 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x30;
        call pci_config_read_u32;
        mov_d [rbx + 44], rax;

        // ---- +0x34 u8 cap_ptr → out+48 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x34;
        call pci_config_read_u8;
        mov_b [rbx + 48], rax;

        // ---- +0x3C u8 interrupt_line → out+49 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x3C;
        call pci_config_read_u8;
        mov_b [rbx + 49], rax;

        // ---- +0x3D u8 interrupt_pin → out+50 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x3D;
        call pci_config_read_u8;
        mov_b [rbx + 50], rax;

        // ---- +0x3E u8 min_grant → out+51 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x3E;
        call pci_config_read_u8;
        mov_b [rbx + 51], rax;

        // ---- +0x3F u8 max_lat → out+52 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x3F;
        call pci_config_read_u8;
        mov_b [rbx + 52], rax;

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pci_read_type1_header(seg, bus, dev, fn, out) -> ()
  // ==========================================================================
  //
  // SysV: rdi=seg, rsi=bus, rdx=dev, rcx=fn, r8=out.
  // Populates the 56-byte PCI Type 1 out struct (see module-doc layout).

  pub let pci_read_type1_header : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, out: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M1-001 (#850): PCI Type 1 (bridge) header decoder. Same shape as pci_read_type0_header; the +0x00..0x0F common prefix decodes identically. Diverges at +0x18: the bridge bus-number quartet (primary_bus, secondary_bus, subordinate_bus, sec_lat_timer) plus io_base/limit + secondary_status + memory windows. The tail bytes (interrupt_line, interrupt_pin) at +0x3C..0x3D match Type 0's slot but the +0x3E u16 is bridge_control (not min_grant/max_lat). Body: 6-push (rbx, rbp, r12-r15) + sub rsp,8. Field-by-field read+store; every u8 uses mov_b, u16 uses mov_w, u32 uses mov_d (G1-safe). bridge_control at +0x3E is a u16 which the module-doc layout stores as its low byte at out+55 (documentary — R22.M2 bridge walker uses only secondary_bus / subordinate_bus at out+25/+26). No new encoder gaps; every op pre-existing.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, r8;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // ---- +0x00 u16 vendor_id → out+0 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x00;
        call pci_config_read_u16;
        mov_w [rbx + 0], rax;

        // ---- +0x02 u16 device_id → out+2 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x02;
        call pci_config_read_u16;
        mov_w [rbx + 2], rax;

        // ---- +0x04 u16 command → out+4 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x04;
        call pci_config_read_u16;
        mov_w [rbx + 4], rax;

        // ---- +0x06 u16 status → out+6 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x06;
        call pci_config_read_u16;
        mov_w [rbx + 6], rax;

        // ---- +0x08 u8 revision_id → out+8 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x08;
        call pci_config_read_u8;
        mov_b [rbx + 8], rax;

        // ---- +0x09 u8 prog_if → out+9 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x09;
        call pci_config_read_u8;
        mov_b [rbx + 9], rax;

        // ---- +0x0A u8 subclass → out+10 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0A;
        call pci_config_read_u8;
        mov_b [rbx + 10], rax;

        // ---- +0x0B u8 class_code → out+11 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0B;
        call pci_config_read_u8;
        mov_b [rbx + 11], rax;

        // ---- +0x0C u8 cache_line_size → out+12 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0C;
        call pci_config_read_u8;
        mov_b [rbx + 12], rax;

        // ---- +0x0D u8 lat_timer → out+13 ----
        mov rdi, r12; mov rsi, r13; mov rdx, r14; mov rcx, r15; mov r8, 0x0D;
