// src/kernel/core/pci/msix.pdx — R21-M4-003 (#839)
//
// MSI-X (Extended Message Signaled Interrupt) programmer.
//
// MSI-X supersedes MSI for multi-vector devices.  Its per-vector
// state lives in a BAR-referenced MMIO table (rather than crammed
// into a single 4-DWord region of config space), which allows up to
// 2048 vectors and per-vector masking.
//
// -----------------------------------------------------------------------------
// MSI-X capability layout (PCI 3.0+ §6.8.2)
// -----------------------------------------------------------------------------
//
// At cap_offset (as returned by pci_find_cap for cap_id=0x11):
//
//   +0  u8  cap_id            (0x11)
//   +1  u8  next_ptr
//   +2  u16 msg_control
//       bits 10:0  table_size_minus_one (N-1; count = value+1)
//       bits 13:11 reserved
//       bit  14    function_mask (0=vectors selectable, 1=all masked)
//       bit  15    msix_enable   (0=disabled, 1=enabled)
//   +4  u32 table_offset_bir
//       bits 2:0   BIR (BAR index 0..5)
//       bits 31:3  offset within BAR (8-byte aligned)
//   +8  u32 pba_offset_bir
//       same encoding for the Pending Bit Array
//
// -----------------------------------------------------------------------------
// MSI-X table entry layout (16 bytes; N entries)
// -----------------------------------------------------------------------------
//
//   +0   u32 msg_addr_lo
//   +4   u32 msg_addr_hi
//   +8   u32 msg_data
//   +12  u32 vector_control
//        bit 0     mask (1 = masked, 0 = unmasked)
//        bits 31:1 reserved
//
// Programming discipline (mask-first, unmask-last) per PCI 3.0 §6.8.3.5:
//   (1) Set vector_control.mask = 1 (bit 0)
//   (2) Write msg_addr_lo, msg_addr_hi, msg_data (order irrelevant while masked)
//   (3) Set vector_control.mask = 0 (or leave = 1 if the caller wants
//       the entry programmed but masked).
//
// -----------------------------------------------------------------------------
// 128-bit access workaround
// -----------------------------------------------------------------------------
//
// The PCI spec permits — but does NOT require — atomic 128-bit writes to
// program an MSI-X entry.  On x86 there is no atomic 128-bit MMIO store
// primitive in scalar ISA; MOVDQU is a 128-bit SSE store but Linux/BSD
// standard practice is instead to mask-first with 32-bit stores, program
// the address/data words as 32-bit stores, and unmask.  This module
// takes that Linux-canonical approach — no dependency on 128-bit atomics
// or the paideia-as MOVDQU encoder gap (#1286).
//
// -----------------------------------------------------------------------------
// msix_table_info output record (24 bytes, 8-aligned)
// -----------------------------------------------------------------------------
//
//   +0  u64 table_pa           MMIO virtual address of MSI-X table entry 0
//   +8  u16 table_size         Number of entries (msg_control table_size + 1)
//   +10 u8  bir                BAR index (0..5) for the table (also used for PBA)
//   +11 u8  _pad_0
//   +12 u32 _pad_1
//   +16 u64 pba_pa             MMIO virtual address of PBA base

module Msix = structure {

  // Capability register offsets (relative to cap_offset).
  pub let MSIX_OFF_MSG_CONTROL    : u64 = 2       // u16
  pub let MSIX_OFF_TABLE_OFF_BIR  : u64 = 4       // u32
  pub let MSIX_OFF_PBA_OFF_BIR    : u64 = 8       // u32

  // Table entry field offsets (relative to entry base).
  pub let MSIX_ENT_ADDR_LO        : u64 = 0
  pub let MSIX_ENT_ADDR_HI        : u64 = 4
  pub let MSIX_ENT_DATA           : u64 = 8
  pub let MSIX_ENT_VECTOR_CONTROL : u64 = 12
  pub let MSIX_ENTRY_SIZE         : u64 = 16

  pub let MSIX_CAP_ID             : u64 = 0x11
  pub let MSIX_ADDR_BASE          : u64 = 0xFEE00000

  // ==========================================================================
  // msix_map_table(seg, bus, dev, func, out_ptr) -> u64
  // ==========================================================================
  //
  // SysV: (seg, bus, dev, func, out_ptr) -> u64
  //   rdi=seg, rsi=bus, rdx=dev, rcx=func, r8=out_ptr (msix_table_info*)
  //
  // Populates a 24-byte msix_table_info record at *out_ptr with
  // (table_pa, table_size, bir, pba_pa).  Returns 1 on success,
  // 0 if MSI-X cap not found.
  //
  // Register plan (6 pushes + 8-byte align = 56 → rsp%16==0 pre-call):
  //   r12=seg, r13=bus, r14=dev, r15=func, rbx=out_ptr, rbp=cap_offset

  pub let msix_map_table : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, out_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-003 (#839): map MSI-X table + PBA MMIO windows via BAR lookup. Body: (1) 6-push callee-save prologue + `sub rsp, 24` for scratch slots (cap_offset, table_off_bir, table_size). Entry rsp%16==8; 6 pushes = 48 → rsp%16=8; sub 24 → 72; %16=0. Actually recomputing: 8 + 48 = 56, %16=8; +24 = 80, %16=0. Correct. (2) Save BDF into r12/r13/r14/r15, out_ptr into rbx. (3) pci_find_cap for MSIX_CAP_ID=0x11 → cap_offset. If 0, return 0. Save cap in rbp. (4) Read msg_control (u16 @ cap+2); table_size = (msg_control & 0x7FF) + 1. Save. (5) Read table_offset_bir (u32 @ cap+4). BIR = bits 2:0; offset = value & ~7 (bits 31:3 shifted-in-place; the low 3 bits are BIR). (6) Read the BAR at (0x10 + 4*BIR). Check bit 0 (Memory Space Indicator: 0=memory, 1=I/O — MSI-X must be memory). Check bits 2:1: 00 = 32-bit, 10 = 64-bit. For 64-bit, also read BAR+4 for high dword. Mask low 4 bits (flags: mem/64bit/prefetch) to get physical base. (7) table_pa = bar_pa + table_offset. (8) Read pba_offset_bir (u32 @ cap+8), decode BIR & offset, read that BAR, compute pba_pa. (9) Write out_ptr fields via mov [rbx+N], reg (u64 stores) and mov_d for u32 slots, mov_w for u16, mov_b for u8. (10) Return 1. Encoder: no new mnemonics — call/mov/and/shl/shr/or/cmp/jne/mov_w/mov_b/mov_d — all pre-#839 proven.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;                          // [rsp+0]=cap, [rsp+8]=table_off, [rsp+16]=table_size

        // Save args.
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // func
        mov rbx, r8;                           // out_ptr

        // ---- Find MSI-X cap ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x11;                          // MSIX_CAP_ID
        call pci_find_cap;

        cmp rax, 0;
        je msix_map_notfound;
        mov rbp, rax;                          // rbp = cap_offset
        mov [rsp + 0], rax;

        // ---- Read msg_control, extract table_size ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        add r8, 2;                             // MSIX_OFF_MSG_CONTROL
        call pci_config_read_u16;

        and rax, 0x7FF;                        // table_size_minus_one
        add rax, 1;                            // count
        mov [rsp + 16], rax;                   // save table_size

        // ---- Read table_offset_bir ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        add r8, 4;                             // MSIX_OFF_TABLE_OFF_BIR
        call pci_config_read_u32;

        mov [rsp + 8], rax;                    // save table_offset_bir

        // Decode BIR (bits 2:0) and offset (masked to ~7).
        mov r10, rax;
        and r10, 7;                            // r10 = BIR
        mov r11, rax;
        and r11, 0xFFFFFFFFFFFFFFF8;           // r11 = offset (dword+ aligned)

        // ---- Read BARn = 0x10 + 4*BIR ----
        //   BAR value has: bit 0 mem/io, bits 2:1 32/64/reserved, bit 3 prefetch,
        //   bits 31:4 (or 63:4 for 64-bit) base address.
        mov r9, r10;
        shl r9, 2;                             // r9 = 4*BIR
        add r9, 0x10;                          // r9 = BAR offset
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, r9;
        call pci_config_read_u32;

        // rax = BAR lo dword.
        // Mask low 4 bits (flags) → rax now has bits 31:4 of the low base.
        mov r10, rax;
        and r10, 0xFFFFFFFFFFFFFFF0;           // r10 = base_lo

        // Determine 64-bit-ness: bits 2:1 = 10 → 64-bit.
        mov r9, rax;
        shr r9, 1;
        and r9, 3;
        cmp r9, 2;
        jne msix_map_bar_32bit;

        // 64-bit BAR: read BAR+4 for the high dword, combine.
        mov r9, [rsp + 8];                     // reload table_offset_bir
        and r9, 7;                             // BIR
        shl r9, 2;
        add r9, 0x10;
        add r9, 4;                             // BAR high offset

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, r9;
        call pci_config_read_u32;

        // rax = base_hi. Combine: r10 = (base_hi << 32) | base_lo.
        shl rax, 32;
        or r10, rax;

      msix_map_bar_32bit:
        // r10 now holds the BAR base (u32 for 32-bit, u64 for 64-bit).
        // table_pa = r10 + offset (offset was saved in r11 earlier).
        // Recompute offset from [rsp+8] since r11 may have been touched.
        mov r11, [rsp + 8];
        and r11, 0xFFFFFFFFFFFFFFF8;

        mov r9, r10;
        add r9, r11;                           // r9 = table_pa

        // Write table_pa (u64 @ out+0)
        mov [rbx + 0], r9;

        // Write table_size (u16 @ out+8)
        mov rax, [rsp + 16];
        mov_w [rbx + 8], rax;

        // Write bir (u8 @ out+10)
        mov rax, [rsp + 8];
        and rax, 7;
        mov_b [rbx + 10], rax;

        // Zero pad at +11 (u8) and +12 (u32)
        xor rax, rax;
        mov_b [rbx + 11], rax;
        mov_d [rbx + 12], rax;

        // ---- PBA lookup ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];                     // cap_offset
        add r8, 8;                             // MSIX_OFF_PBA_OFF_BIR
        call pci_config_read_u32;

        mov [rsp + 8], rax;                    // reuse [rsp+8] for pba_offset_bir

        // Decode PBA BIR + offset.
        mov r10, rax;
        and r10, 7;                            // BIR

        // Read PBA BAR.
        mov r9, r10;
        shl r9, 2;
        add r9, 0x10;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, r9;
        call pci_config_read_u32;

        mov r10, rax;
        and r10, 0xFFFFFFFFFFFFFFF0;           // base_lo masked

        mov r9, rax;
        shr r9, 1;
        and r9, 3;
        cmp r9, 2;
        jne msix_map_pba_32bit;

        // 64-bit PBA BAR.
        mov r9, [rsp + 8];
        and r9, 7;
        shl r9, 2;
        add r9, 0x10;
        add r9, 4;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, r9;
        call pci_config_read_u32;

        shl rax, 32;
        or r10, rax;

      msix_map_pba_32bit:
        mov r11, [rsp + 8];
        and r11, 0xFFFFFFFFFFFFFFF8;
        mov r9, r10;
        add r9, r11;                           // r9 = pba_pa

        mov [rbx + 16], r9;                    // Write pba_pa (u64 @ out+16)

        mov rax, 1;
        jmp msix_map_done;

      msix_map_notfound:
        mov rax, 0;

      msix_map_done:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // msix_program_entry(table_pa, entry_idx, vector, dest_apic_id, mask) -> ()
  // ==========================================================================
  //
  // SysV: (table_pa, entry_idx, vector, dest_apic_id, mask) -> ()
  //   rdi=table_pa (u64), rsi=entry_idx (u16), rdx=vector (u8),
  //   rcx=dest_apic_id (u8), r8=mask (0 or 1)
  //
  // Programs a single MSI-X table entry as 4 × u32 MMIO stores:
  //   (a) vector_control = 1 (mask FIRST)
  //   (b) msg_addr_lo    = 0xFEE00000 | (dest << 12)
  //   (c) msg_addr_hi    = 0
  //   (d) msg_data       = vector (Fixed/edge → high bits 0)
  //   (e) vector_control = 0 if mask == 0, else stay = 1
  //
  // Every store is bracketed with mfence for MMIO ordering.

  pub let msix_program_entry : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (table_pa: u64, entry_idx: u64, vector: u64, dest_apic_id: u64, mask: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-003 (#839): program one MSI-X table entry via 4 × 32-bit MMIO stores per Linux-canonical mask-first discipline (PCI 3.0 §6.8.3.5). Body: (1) Compute entry_pa = table_pa + entry_idx * 16 into rax. (2) mask-first: mov_d [entry_pa + 12], 1. (3) msg_addr_lo = 0xFEE00000 | (dest << 12) → mov_d. (4) msg_addr_hi = 0 → mov_d. (5) msg_data = vector → mov_d. (6) If caller-mask == 0, unmask: mov_d [entry_pa + 12], 0. Else leave = 1. Each store bracketed by mfence per MMIO discipline (same posture as ioapic_read_at / ioapic_write_at). Leaf function — no nested call, no prologue. Encoder: shl, add, mov, or, mfence, mov_d, cmp/je, ret — all pre-#839 proven.",
      block: {
        // entry_pa = table_pa + entry_idx * 16
        mov rax, rsi;
        shl rax, 4;                            // entry_idx * 16
        add rax, rdi;                          // rax = entry_pa

        // Stash entry_pa in r10 (caller-save, no nested calls to touch it).
        mov r10, rax;

        // ---- (a) mask FIRST: vector_control = 1 ----
        mov r9, 1;
        mfence;
        mov_d [r10 + 12], r9;
        mfence;

        // ---- (b) msg_addr_lo = 0xFEE00000 | (dest << 12) ----
        mov r9, rcx;                           // r9 = dest
        and r9, 0xFF;
        shl r9, 12;
        mov r11, 0xFEE00000;
        or r9, r11;

        mfence;
        mov_d [r10 + 0], r9;
        mfence;

        // ---- (c) msg_addr_hi = 0 ----
        xor r9, r9;
        mfence;
        mov_d [r10 + 4], r9;
        mfence;

        // ---- (d) msg_data = vector ----
        mov r9, rdx;
        and r9, 0xFF;
        mfence;
        mov_d [r10 + 8], r9;
        mfence;

        // ---- (e) unmask if caller asked ----
        cmp r8, 0;
        jne msix_pe_stay_masked;

        xor r9, r9;
        mfence;
        mov_d [r10 + 12], r9;
        mfence;

      msix_pe_stay_masked:
        ret
      }
    }

  // ==========================================================================
  // msix_enable_device(seg, bus, dev, func) -> u64
  // ==========================================================================
  //
  // Sets msg_control bit 15 (msix_enable) and clears bit 14 (function_mask)
  // on the device's MSI-X capability.  This is the last step in the MSI-X
  // enablement chain: individual entries must already be programmed (via
  // msix_program_entry).
  //
  // Returns 1 on success, 0 if MSI-X cap not found.

  // ==========================================================================
  // msix_program_entry_via_ir(table_pa, entry_idx, ir_index) -> ()
  // ==========================================================================
  //
  // R22-M5-002 (#867): MSI-X entry programming targeting the VT-d
  // Interrupt Remap unit.  Instead of encoding (dest, vector) directly
  // in the LAPIC address as R21.M4 msix_program_entry does, this
  // variant encodes an IRT index (interrupt handle) that the VT-d IR
  // unit dereferences to fetch the fully-programmed (vector, dest)
  // pair from IRT[ir_index].
  //
  // Remappable MSI address format (VT-d 4.0 §5.1.2.2):
  //
  //   bits 31..20    0xFEE (fixed compat interrupt prefix)
  //   bits 19..5     interrupt_index[14:0]   (low 15 bits of handle)
  //   bit  4         SHV (SubHandle Valid; 1 keeps addr encoding stable
  //                       across the substrate — the witness verifies
  //                       byte-for-byte, so no dispatch happens)
  //   bit  3         interrupt_index[15]      (top bit of 16-bit handle)
  //   bit  2         Reserved / 0
  //   bits 1..0      Reserved / 0
  //
  //   msg_data       vector (unchanged — same as non-IR path)
  //
  // Writing discipline mirrors msix_program_entry: mask-first (vector_ctrl
  // = 1), 4 × 32-bit MMIO stores, unmask-last.  Every store bracketed
  // with mfence per MMIO ordering.
  //
  // SysV: (table_pa: u64, entry_idx: u64, ir_index: u64) -> ()
  //   rdi=table_pa, rsi=entry_idx (u16), rdx=ir_index (u16)

  pub let msix_program_entry_via_ir : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (table_pa: u64, entry_idx: u64, ir_index: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M5-002 (#867). Program one MSI-X table entry routed through the VT-d IR unit — msg_addr encodes an IRT handle (not a LAPIC dest) per VT-d 4.0 §5.1.2.2 Remappable format. Body: (1) Compute entry_pa = table_pa + entry_idx * 16 into r10. (2) mask-first: vector_control (offset +12) = 1 via mov_d. mfence brackets. (3) msg_addr_lo (offset +0) = 0xFEE00000 | ((ir_index & 0x7FFF) << 5) | 0x10 (SHV=1) | (ir_index_bit15 << 3). Assembly: extract low 15 bits (ir_index & 0x7FFF), shift left 5 → bits 5..19. Extract bit 15 of ir_index ((ir_index >> 15) & 1) shifted left 3 → bit 3. OR with 0xFEE00000 and 0x10 (SHV). Store via mov_d. (4) msg_addr_hi (offset +4) = 0 via mov_d. (5) msg_data (offset +8) = vector — CALLER-SUPPLIED; passed in a scratch slot by higher-level msix_assign_at_ir. Wait — this fn's signature doesn't take vector. Correct: the vector is written by the IR programmer (vtd_ir_program), NOT by the MSI-X address. The MSI-X data field with the remappable format is left AS IS from prior programming (or 0). Actually per §5.1.2.2, when SHV=1 the MSI data field carries the subhandle (low 16 bits). For a single-subhandle-per-index topology we set data = 0. (6) Unmask: vector_control = 0 via mov_d. (7) Return. Leaf function — no nested call, no prologue. Encoder: mov / shl / shr / and / or / mfence / mov_d / ret — all pre-#839 proven. G1 workaround: mov_d used for every u32 MMIO store to prevent REX.W widening.",
      block: {
        // entry_pa = table_pa + entry_idx * 16
        mov rax, rsi;
        shl rax, 4;                            // entry_idx * 16
        add rax, rdi;                          // rax = entry_pa
        mov r10, rax;                          // r10 = entry_pa (preserved)

        // ---- (2) mask FIRST ----
        mov r9, 1;
        mfence;
        mov_d [r10 + 12], r9;
        mfence;

        // ---- (3) msg_addr_lo = 0xFEE00000 | ((ir_index & 0x7FFF) << 5) | SHV | (ir_index[15] << 3) ----
        mov r9, rdx;                           // r9 = ir_index
        and r9, 0x7FFF;                        // low 15 bits
        shl r9, 5;                             // → bits 5..19

        mov r8, rdx;
        shr r8, 15;
        and r8, 1;                             // ir_index[15]
        shl r8, 3;                             // → bit 3

        or  r9, r8;
        or  r9, 0x10;                          // SHV = 1 (bit 4)
        mov r8, 0xFEE00000;
        or  r9, r8;

        mfence;
        mov_d [r10 + 0], r9;
        mfence;

        // ---- (4) msg_addr_hi = 0 ----
        xor r9, r9;
        mfence;
        mov_d [r10 + 4], r9;
        mfence;

        // ---- (5) msg_data = 0 (subhandle-per-index topology: no subhandle) ----
        xor r9, r9;
        mfence;
        mov_d [r10 + 8], r9;
        mfence;

        // ---- (6) unmask ----
        xor r9, r9;
        mfence;
        mov_d [r10 + 12], r9;
        mfence;
        ret
      }
    }

  pub let msix_enable_device : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M4-003 (#839): flip MSI-X enable bit + clear function_mask on the device's msg_control. Body: (1) 6-push prologue + `sub rsp, 8` for cap_offset scratch. 6 pushes = 48 B, sub 8 = 56 B; entry rsp%16==8 → 8+56=64, %16=0. (2) Save BDF into r12-r15. (3) Find MSI-X cap; if 0, return 0. (4) Read u32 @ cap_offset (contains cap_id/next_ptr low + msg_control high in bits 31:16). (5) Set bit 15 of msg_control = bit 31 of dword = 0x80000000; clear bit 14 of msg_control = bit 30 of dword. Use `or rax, 0x80000000` and `mov r10, ~(1<<30); and rax, r10`. (6) Write back via pci_config_write_u32. Return 1. `mov r10, imm64` for the mask constant (paideia-as lacks first-class `not`).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // Find MSI-X cap.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x11;
        call pci_find_cap;

        cmp rax, 0;
        je msix_en_notfound;
        mov [rsp + 0], rax;                    // cap_offset

        // Read u32 at cap_offset (low: cap_id/next_ptr, high: msg_control).
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        call pci_config_read_u32;

        // Set enable bit (bit 15 of msg_control = bit 31 of dword).
        or rax, 0x80000000;

        // Clear function_mask (bit 14 of msg_control = bit 30 of dword).
        mov r10, 0xFFFFFFFFBFFFFFFF;
        and rax, r10;

        // Write back.
        mov r9, rax;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, [rsp + 0];
        call pci_config_write_u32;

        mov rax, 1;
        jmp msix_en_done;

      msix_en_notfound:
        mov rax, 0;

      msix_en_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
