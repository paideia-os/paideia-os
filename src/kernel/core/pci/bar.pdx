// src/kernel/core/pci/bar.pdx — R22-M2-002 (#852, #853, #854)
//
// PCI BAR (Base Address Register) sizing, decoding, and MMIO mapping
// helpers.
//
// -----------------------------------------------------------------------------
// BAR sizing (PCI 3.0 §6.2.5)
// -----------------------------------------------------------------------------
//
// Software probes the size of a BAR-mapped region by:
//   (1) reading the current BAR value (to restore later);
//   (2) writing 0xFFFFFFFF to the BAR;
//   (3) reading it back — the device returns 1s for every bit it
//       decodes as an address input;
//   (4) masking out the low type bits (bit 0 for I/O; bits 3..0 for
//       memory), inverting, +1 to compute the size;
//   (5) restoring the saved BAR value.
//
// This procedure is safe against a live device *only* if the BAR's
// address decoder is disabled — PCI §6.2.5 requires the caller to
// clear the appropriate bit in the command register (bit 0 for I/O,
// bit 1 for memory) before sizing.  R22.M2 exposes the raw sizing
// primitive; the "disable before, enable after" protocol lives at
// driver-attach time.
//
// -----------------------------------------------------------------------------
// BAR type encoding (low bits of the BAR)
// -----------------------------------------------------------------------------
//
//   bit 0     = 0: Memory BAR
//               1: I/O BAR
//
//   Memory BAR (bit 0 = 0):
//     bits 2..1 = 00: 32-bit BAR
//                 10: 64-bit BAR (bar_idx and bar_idx+1 combined)
//                 01: reserved (was <1 MB; ignored)
//                 11: reserved
//     bit 3     = 1: prefetchable
//
//   I/O BAR (bit 0 = 1):
//     bit 1 reserved; bits 31..2 = base address
//
// -----------------------------------------------------------------------------
// bar_info out struct (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u64 base_pa           low 32 bits from bar_lo, high from bar_hi
//                               (0 for 32-bit/IO BARs)
//   +8    u64 size              computed size in bytes (0 = absent BAR)
//   +16   u8  kind              0=absent, 1=IO, 2=MEM32, 3=MEM64
//   +17   u8  prefetchable      0/1
//   +18   u8  is_64bit          0/1 (memory BARs only)
//   +19   u8  bar_idx           0..5
//   +20   u32 _pad
//   +24   u64 _reserved
//   +32   end
//
// -----------------------------------------------------------------------------
// MMIO mapping (#853)
// -----------------------------------------------------------------------------
//
// map_mmio_region(pa, va, size, cacheability) — reserves the VA range
// via per-4KB aspace_map calls with PAT bits derived from cacheability.
// PAT programming (WC-slot enable) is R23 driver-plane work; M2 lands
// the SYMBOL so linkers can resolve driver-plane callers.
//
// pci_map_bar_uc / pci_map_bar_wc — convenience wrappers that thread
// a bar_info through map_mmio_region.  For M2 both are documented but
// intentionally return 0 — no BAR is mapped at boot; every consumer
// path in the R22.M2 kernel walks _pci_devices records without
// touching MMIO.  Real BAR mapping is per-driver-attach in R23.

module Bar = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PCI_BAR_KIND_ABSENT   : u64 = 0
  pub let PCI_BAR_KIND_IO       : u64 = 1
  pub let PCI_BAR_KIND_MEM32    : u64 = 2
  pub let PCI_BAR_KIND_MEM64    : u64 = 3

  pub let PCI_BAR_MMIO_UC       : u64 = 0   // uncacheable (PCD=1, PWT=1)
  pub let PCI_BAR_MMIO_WC       : u64 = 1   // write-combining (PAT slot 2/6)

  pub let BAR_INFO_SIZE_BYTES   : u64 = 32

  // ============================================================================
  // pci_bar_size(seg, bus, dev, fn, bar_idx) -> u64
  // ============================================================================
  //
  // SysV: (seg, bus, dev, fn, bar_idx) → u64 (size in bytes, 0 if BAR unused)
  //   rdi=seg, rsi=bus, rdx=dev, rcx=fn, r8=bar_idx (0..5)
  //
  // Returns rax = size in bytes (rounded up to next power of two per
  // PCI's readback contract), or 0 if the BAR is unimplemented.
  //
  // For 64-bit memory BARs this returns the size derived from the LOW
  // dword only — callers that need the true 64-bit-decoded size must
  // additionally read bar_idx+1 and combine via pci_bar_decode.
  //
  // Register plan (6 pushes + 8 align):
  //   rbx = original BAR value (for restoration)
  //   r12..r15 = seg/bus/dev/fn
  //   rbp = bar_offset (= 0x10 + bar_idx*4)

  pub let pci_bar_size : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, func: u64, bar_idx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M2-002 (#852): PCI BAR size probe. Body: (1) 6-push callee-save (rbx, rbp, r12-r15) + sub rsp,8 for SysV 16-B alignment across nested calls (entry rsp%16==8; 6 pushes = 48 → rsp%16=8; sub 8 → 0). (2) Save seg/bus/dev/fn in r12-r15; compute bar_offset = 0x10 + bar_idx*4 into rbp (bar_idx clamped to 0..5 — caller ensures). (3) Save current BAR: call pci_config_read_u32(seg, bus, dev, fn, bar_offset); rbx = rax. (4) Write 0xFFFFFFFF probe: call pci_config_write_u32(...) with value 0xFFFFFFFF. (5) Read back: call pci_config_read_u32(...) → rax = readback. (6) Restore original BAR: call pci_config_write_u32(...) with rbx. (7) Compute size: if readback == 0 or 0xFFFFFFFF → BAR unimplemented, return 0. Else: mask type bits (I/O: `and rax, 0xFFFFFFFC`; MEM: `and rax, 0xFFFFFFF0`). Invert (`not rax`) and truncate to 32 bits (`and rax, 0xFFFFFFFF`), then +1 to yield size. Type discrimination via bit 0 of the ORIGINAL BAR value (rbx). Return via 6-pop epilogue. Encoder: not, and-with-imm32, cmp, jz — all pre-existing in R21.M4 pci_* callers. G4 full-reg compares.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // Save args in callee-save regs.
        mov r12, rdi;                                // seg
        mov r13, rsi;                                // bus
        mov r14, rdx;                                // dev
        mov r15, rcx;                                // fn

        // bar_offset = 0x10 + bar_idx * 4
        mov rbp, r8;
        shl rbp, 2;
        add rbp, 0x10;

        // (3) Save current BAR.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        call pci_config_read_u32;
        mov rbx, rax;                                // rbx = saved BAR

        // (4) Write probe value 0xFFFFFFFF.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        mov r9, 0xFFFFFFFF;
        call pci_config_write_u32;

        // (5) Read back.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        call pci_config_read_u32;
        mov r10, rax;                                // r10 = readback

        // (6) Restore original BAR.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, rbp;
        mov r9, rbx;
        call pci_config_write_u32;

        // (7) Compute size from r10 (readback).

        // BAR unimplemented?
        cmp r10, 0;
        je bar_size_zero;
        mov rax, 0xFFFFFFFF;
        cmp r10, rax;
        je bar_size_zero;

        // Type mask: bit 0 of rbx.
        mov rax, rbx;
        and rax, 1;
        cmp rax, 1;
        je bar_size_io;

        // Memory BAR: mask low 4 bits.
        and r10, 0xFFFFFFF0;
        jmp bar_size_compute;

      bar_size_io:
        // I/O BAR: mask low 2 bits.
        and r10, 0xFFFFFFFC;

      bar_size_compute:
        // r10 = masked readback. Size = (~r10 & 0xFFFFFFFF) + 1
        // Equivalent to two's complement (-r10) truncated to 32 bits.
        // paideia-as does not yet lower `not` / `neg`; emit as
        // `xor rax, rax; sub rax, r10; and rax, 0xFFFFFFFF`.
        xor rax, rax;
        sub rax, r10;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp bar_size_done;

      bar_size_zero:
        xor rax, rax;

      bar_size_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_bar_decode(bar_lo, bar_hi_or_zero, size, out) -> ()
  // ============================================================================
  //
  // SysV: (bar_lo: u32, bar_hi: u32, size: u64, out: *bar_info) → ()
  //   rdi=bar_lo, rsi=bar_hi, rdx=size, rcx=out
  //
  // Populates a 32-byte bar_info struct at `out`. Caller sets bar_idx
  // separately post-call (this function does not know which BAR index
  // is being decoded).
  //
  // For 32-bit / I/O BARs pass bar_hi=0. For 64-bit BARs pass bar_hi
  // = pci_config_read_u32(seg, bus, dev, fn, bar_offset + 4).
  //
  // -----------------------------------------------------------------------------
  // Leaf function — no nested calls, no callee-save prologue needed
  // beyond preserving rbx if we use it. Written flat with rax/r10/r11
  // scratch registers so no push/pop.

  pub let pci_bar_decode : (u64, u64, u64, u64) -> () !{mem} @{boot} =
    fn (bar_lo: u64, bar_hi: u64, size: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M2-002 (#852): decode a raw BAR pair into the 32-byte bar_info struct. Type discrimination on bar_lo bit 0 (IO vs MEM), bits 2..1 (32/64-bit), bit 3 (prefetchable). Memory BAR base = bar_lo & 0xFFFFFFF0 combined with bar_hi (for 64-bit) as (bar_hi << 32) | (bar_lo & 0xFFFFFFF0). I/O BAR base = bar_lo & 0xFFFFFFFC. Absent (size==0): kind=0, everything else zero. Leaf function — no nested calls; no callee-save prologue needed. G1: mov_b for u8 stores; base_pa stored via bare `mov [out+0], rax` (u64 — bare mov is safe). G4: full-register compares.",
      block: {
        // Zero every field first — subsequent writes overwrite selectively.
        xor rax, rax;
        mov [rcx + 0], rax;                          // base_pa
        mov [rcx + 8], rax;                          // size
        mov_b [rcx + 16], rax;                       // kind
        mov_b [rcx + 17], rax;                       // prefetchable
        mov_b [rcx + 18], rax;                       // is_64bit
        mov_b [rcx + 19], rax;                       // bar_idx (caller sets)
        mov_d [rcx + 20], rax;                       // _pad
        mov [rcx + 24], rax;                         // _reserved

        // If size == 0, BAR unimplemented — kind stays 0, done.
        cmp rdx, 0;
        je bar_decode_done;

        // Store size verbatim.
        mov [rcx + 8], rdx;

        // Type discrimination.
        mov rax, rdi;
        and rax, 1;
        cmp rax, 1;
        je bar_decode_io;

        // ---- Memory BAR ----
        // Prefetchable: bit 3.
        mov rax, rdi;
        shr rax, 3;
        and rax, 1;
        mov_b [rcx + 17], rax;

        // 32 vs 64: bits 2..1 == 10 → 64-bit.
        mov rax, rdi;
        shr rax, 1;
        and rax, 3;
        cmp rax, 2;
        je bar_decode_mem64;

        // MEM32
        mov rax, 2;                                   // PCI_BAR_KIND_MEM32
        mov_b [rcx + 16], rax;
        xor rax, rax;
        mov_b [rcx + 18], rax;                       // is_64bit = 0

        // base_pa = bar_lo & 0xFFFFFFF0
        mov rax, rdi;
        and rax, 0xFFFFFFF0;
        mov [rcx + 0], rax;
        jmp bar_decode_done;

      bar_decode_mem64:
        mov rax, 3;                                   // PCI_BAR_KIND_MEM64
        mov_b [rcx + 16], rax;
        mov rax, 1;
        mov_b [rcx + 18], rax;                       // is_64bit = 1

        // base_pa = (bar_hi << 32) | (bar_lo & 0xFFFFFFF0)
        mov rax, rdi;
        and rax, 0xFFFFFFF0;
        mov r10, rsi;
        shl r10, 32;
        or rax, r10;
        mov [rcx + 0], rax;
        jmp bar_decode_done;

      bar_decode_io:
        mov rax, 1;                                   // PCI_BAR_KIND_IO
        mov_b [rcx + 16], rax;
        xor rax, rax;
        mov_b [rcx + 17], rax;                       // prefetchable = 0 (IO)
        mov_b [rcx + 18], rax;                       // is_64bit = 0

        // base_pa = bar_lo & 0xFFFFFFFC
        mov rax, rdi;
        and rax, 0xFFFFFFFC;
        mov [rcx + 0], rax;

      bar_decode_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // map_mmio_region(pa, va, size, cacheability) -> u64  [DEFERRED — R23]
  // ============================================================================
  //
  // Reserves the VA range [va, va+size) and installs 4 KiB PTEs with
  // PAT bits derived from `cacheability`.
  //
  // For R22.M2 this function exists as a linker symbol so R23 driver-
  // plane consumers can call it, but it deliberately returns 0
  // (unimplemented) and does not walk page tables.  Real implementation
  // depends on:
  //
  //   * A kernel-VA arena allocator (currently ad-hoc; several boot
  //     paths hard-code kernel VAs).
  //   * PAT MSR programming so slot 2 encodes WC (default is UC-).
  //     None of the current boot paths need WC yet.
  //   * A caller-side flush protocol for the mapped range (INVLPG per
  //     4 KB page — aspace_map already provides this on the leaf).
  //
  // -----------------------------------------------------------------------------
  // Return: 0 (unimplemented).

  pub let map_mmio_region : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (pa: u64, va: u64, size: u64, cacheability: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M2-003 (#853): map_mmio_region deferred stub. Design contract lands the symbol so R23 driver-plane callers link cleanly; body returns 0 (unimplemented). Rationale: (a) aspace_map's leaf-PTE writer subtracts KERNEL_VMA_BASE from the paddr arg (treating it as a phys_alloc-style VA — see aspace_map.pdx L225-227 comment for the #652 history), so passing a genuine hardware PA (like 0xFEE00000 LAPIC) underflows. A dedicated MMIO walker is R23 work. (b) PAT MSR programming (WC-slot enable) requires an MTRR/PAT overhaul that no current boot path needs — every LAPIC/IOAPIC/HPET consumer today uses the identity-mapped page-tables set up in boot_stub.S with default UC- attributes. (c) A kernel-VA arena allocator (`kva_reserve(size)`) does not yet exist — several boot paths hard-code kernel VAs. Fixing all three is a coordinated R23 milestone.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // pci_map_bar_uc(bar_info) -> u64  [DEFERRED — R23]
  // ============================================================================
  //
  // Reserves a kernel VA range for the BAR at bar_info+0 (size at
  // bar_info+8) and maps it with UC (PCD=1, PWT=1, PAT=0) attributes.
  //
  // Returns the kernel VA on success, 0 on failure.
  //
  // Deferred to R23 — see map_mmio_region rationale.

  pub let pci_map_bar_uc : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar_info: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M2-003 (#853): pci_map_bar_uc deferred stub. Depends on map_mmio_region + kva_reserve; R23 driver-plane work. Body returns 0.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // pci_map_bar_wc(bar_info) -> u64  [DEFERRED — R23]
  // ============================================================================
  //
  // WC variant. Requires PAT MSR programming to redefine PAT slot 2 as
  // WC (default is UC-). None of the R22 boot paths need WC yet; this
  // symbol exists so future GOP framebuffer / GPU-BAR consumers link
  // against it without a phase-6 refactor.

  pub let pci_map_bar_wc : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar_info: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M2-003 (#853): pci_map_bar_wc deferred stub. Additionally requires PAT MSR reprogramming (WC slot enable). Body returns 0.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame
}
