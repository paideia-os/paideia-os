// src/kernel/core/pci/publish.pdx — R22-M3-004 (#859)
//
// KIND_PCI_DEV capability-tree publication.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, the
// boot path calls pci_publish_caps to mint a KIND_PCI_DEV capability
// for each function with the default minimum-privilege rights
// R_DEV_CONFIG_READ. The returned cap handle is stashed into the
// per-device `cap_handle` slot at record offset +16.
//
// -----------------------------------------------------------------------------
// _pci_devices record layout revision (R22-M3)
// -----------------------------------------------------------------------------
//
// The R22.M2 record layout reserved two u64 slots at +16 / +24. We
// now claim +16 for the KIND_PCI_DEV cap handle (the mint scaffolding
// currently returns 0 — see device_cap.pdx §Fixture posture). +24
// remains reserved for a future BAR-mapping cap handle when the
// userspace-server round wires BAR MMIO into the driver-hosting flow.
//
// The zero-initialization in pci_enumerate_all already clears both
// slots, so pci_publish_caps only needs to write the mint result;
// devices for which mint fails leave the slot at 0.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   PCI CAP PUBLISH N=<count>
//
// One line at INFO under SUBSYS_PCI_ once all devices have been
// visited. Callers grep for this string to gate CI on the publication
// having run.

module Publish = structure {

  // ==========================================================================
  // pci_publish_caps() -> u64
  // ==========================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of successful mints. A mint returning
  //   PCI_DEV_MINT_OK (0) counts as success; any non-zero mint result
  //   is treated as a failed publication for that device (the cap
  //   slot is left at 0 and the failure is silently absorbed — the
  //   scaffolding mint gate cannot fail unless the caller passes bad
  //   rights or a zero bdf, neither of which pci_publish_caps does).
  //
  // Register plan (5-push callee-save + counter slot):
  //   rbx = success counter
  //   r12 = loop index i (0 .. _pci_device_count)
  //   r13 = _pci_device_count (loaded once)
  //   r14 = pointer to _pci_devices[i]
  //   r15 = scratch across nested calls

  pub let pci_publish_caps : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M3-004 (#859) KIND_PCI_DEV capability-tree publication. Body: (1) 5-push callee-save prologue (rbx, r12, r13, r14, r15) — 40 B, entry rsp%16==8 → post-prologue rsp%16==0 (SysV call-boundary aligned). (2) Init counter rbx=0; load _pci_device_count into r13; init i=r12=0. (3) Per-iteration: (a) i >= r13 → done. (b) Compute &_pci_devices[i] as base + (i << 5) — record stride 32 = shl 5. (c) Load seg (u16 @+0), bus (u8 @+2), dev (u8 @+3), fn (u8 @+4) as zero-extended u64s from the record. Encoder posture: 16-bit MMIO reads via `mov ax, [mem]` don't zero-extend; use `xor rax,rax; mov ax, [mem]` (or the movzx idiom). paideia-as v0.22.x supports `movzx r64, r/m16` and `movzx r64, r/m8`; use them for cleanliness (proven encoder gate via core/pci/config.pdx). (d) Call bdf_pack(seg, bus, dev, fn) → rax = bdf key. (e) Call device_cap_mint(bdf, R_DEV_CONFIG_READ=0x01) → rax = mint result. (f) Write rax to _pci_devices[i] + 16 (cap_handle). (g) If rax == 0 (PCI_DEV_MINT_OK), increment success counter rbx. (h) Advance i. (4) Emit klog_s1_d1(INFO, PCI_, tag_pci_cap_publish, k_n, count) fingerprint. (5) Return rbx. Reserved-label discipline: all labels prefixed `pub_` to avoid `loop` / `next`. G1 sized-store posture applies: the cap-handle write is a 64-bit store so plain `mov [mem], reg` is correct (no widening hazard). Callee-save discipline: bdf_pack, device_cap_mint, klog_s1_d1 all preserve rbx/r12..r15 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Success counter.
        xor rbx, rbx;

        // r13 = _pci_device_count.
        mov r13, [rip + _pci_device_count];

        // r12 = i = 0.
        xor r12, r12;

      pub_loop:
        cmp r12, r13;
        jae pub_done;

        // r14 = &_pci_devices[i] = base + (i << 5)
        mov rax, r12;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // Load seg (u16 @ +0) — zero-extended via mov_w (G4 posture).
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov rdi, rax;                          // arg0 = seg

        // Load bus (u8 @ +2).
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov rsi, rax;                          // arg1 = bus

        // Load dev (u8 @ +3).
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov rdx, rax;                          // arg2 = dev

        // Load fn (u8 @ +4).
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov rcx, rax;                          // arg3 = fn

        call bdf_pack;

        // rax = bdf key. Now call device_cap_mint(bdf, R_DEV_CONFIG_READ).
        mov rdi, rax;
        mov rsi, 0x01;                         // R_DEV_CONFIG_READ
        call device_cap_mint;

        // Store cap_handle at _pci_devices[i] + 16.
        mov [r14 + 16], rax;

        // If mint result == 0 (PCI_DEV_MINT_OK), count success.
        cmp rax, 0;
        jne pub_next;
        add rbx, 1;

      pub_next:
        add r12, 1;
        jmp pub_loop;

      pub_done:
        // Emit "PCI CAP PUBLISH N=<count>".
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_cap_publish];
        lea rcx, [rip + k_n];
        mov r8, rbx;                               // v1 = success count
        call klog_s1_d1;

        mov rax, rbx;                              // return success count

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
