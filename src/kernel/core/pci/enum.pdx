// src/kernel/core/pci/enum.pdx — R22-M2-001 (#851, #854, #855)
//
// PCI bus enumeration — recursive (bridge-descending) BDF walk.
//
// For every present function under every reachable bus, the enumerator
// records a compact 32-byte pci_device_record and emits one klog line so
// the on-wire fingerprint deterministically enumerates the topology.
//
// -----------------------------------------------------------------------------
// pci_device_record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 segment
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  header_type          // raw (bit 7 = multi-function flag)
//   +6    u8  class_code
//   +7    u8  subclass
//   +8    u16 vendor_id
//   +10   u16 device_id
//   +12   u8  cap_ptr              // 0 if no capabilities-list
//   +13   u8  _pad0
//   +14   u16 bar_kinds_bitmap     // 2 bits × 6 BARs: 00=absent, 01=IO,
//                                  //   10=MEM32, 11=MEM64 (populated by
//                                  //   pci_bar_scan_device — R22.M2 optional)
//   +16   u64 _reserved_0
//   +24   u64 _reserved_1
//   +32   end
//
// -----------------------------------------------------------------------------
// Bus queue (bounded, 32 entries)
// -----------------------------------------------------------------------------
//
// Bridges (Type-1 headers) publish a `secondary_bus` (u8 @ 0x19) that
// downstream devices live on. The enumerator enqueues the secondary
// bus, drains the queue in FIFO order, and de-duplicates via a
// 256-bit visited bitmap. A 32-slot queue tolerates every consumer/
// server chipset shipped to date; overflow silently drops.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens → use `mov_d` / `mov_w`
//       / `mov_b` for sized stores.
//   G4: full-register compares.
//
// -----------------------------------------------------------------------------
// MCFG-absent behavior
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot, phase1_acpi_gather typically cannot find
// the RSDP on QEMU q35, so `_mcfg_count` stays 0.  The enumerator
// short-circuits with the "PCI ENUM SKIP no MCFG" fingerprint rather
// than walking 65536 phantom BDF slots reading 0xFFFFFFFF.

module Enum = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PCI_DEV_RECORD_SIZE  : u64 = 32
  pub let PCI_MAX_DEVICES      : u64 = 256
  pub let PCI_BUS_QUEUE_CAP    : u64 = 32

  // ============================================================================
  // Canonical static slots — all @align(8), .bss-backed
  // ============================================================================
  //
  //   _pci_devices           : 256 × 32 B = 8192 B (= 1024 × u64)
  //   _pci_device_count      : populated by pci_enumerate_all
  //   _pci_bus_queue         : 32 × u8  = 32 B (aligned via u64 array of 4)
  //   _pci_bus_visited       : 256-bit bitmap = 32 B (aligned via u64 array of 4)

  pub let mut _pci_devices        : [u64; 1024] = uninit @align(8)
  pub let mut _pci_device_count   : u64         = 0
  pub let mut _pci_bus_queue      : [u64; 4]    = uninit @align(8)
  pub let mut _pci_bus_visited    : [u64; 4]    = uninit @align(8)

  // ============================================================================
  // pci_enumerate_all(seg) -> u64
  // ============================================================================
  //
  // SysV: (seg: u64) -> u64
  //   rdi = segment (u16 in low bits)
  //
  // Returns rax = number of devices recorded.
  //
  // -----------------------------------------------------------------------------
  // Stack frame
  // -----------------------------------------------------------------------------
  //
  //   push rbx, rbp, r12, r13, r14, r15 (48 B)
  //   sub rsp, 40 (5 u64 scratch slots)
  //   Total decrement: 88 B. Entry rsp%16==8 → post-prologue rsp%16==0
  //   for every nested call boundary (no per-call re-align needed).
  //
  //   Scratch layout (per BDF iteration):
  //     [rsp+0]  = record_ptr
  //     [rsp+8]  = hdr_type_masked (bit 7 stripped)
  //     [rsp+16] = vendor_id
  //     [rsp+24] = device_id
  //     [rsp+32] = (spare)
  //
  //   Callee-save regs:
  //     r12 = segment           (u16)
  //     r13 = current bus       (u8)
  //     r14 = current dev       (u8)
  //     r15 = current fn        (u8)
  //     rbx = queue head cursor (0..32)
  //     rbp = queue tail cursor (0..32)

  pub let pci_enumerate_all : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M2-001 (#851/#854/#855). PCI recursive-descent bus enumerator. Body: (1) MCFG-absence guard: read _mcfg_count; if 0 → emit klog_s1(INFO, PCI_, tag_pci_enum_skip_no_mcfg), zero _pci_device_count, return 0. This is the primary path under BIOS/`-kernel` boot on QEMU q35 where the RSDP is not published. (2) Init: zero _pci_device_count and _pci_bus_visited (4 × u64 = 32 B). Enqueue bus 0, mark visited bit 0. (3) Outer bus-drain loop (rbx=head, rbp=tail; while head<tail dequeue). (4) Inner dev/fn iteration (r14 0..31, r15 0..7). Per BDF: pci_probe_device — absent + fn==0 breaks fn-loop early (single-function-device optimisation); absent + fn>0 just skips. (5) For present function: populate record[count] via sequential pci_config_read_u{8,16} calls into record slots at 32-byte stride, populate vendor/device/class/subclass/header_type/cap_ptr. bar_kinds_bitmap kept zero at M2 — populated by pci_bar_scan_device on driver-attach in R23. (6) Emit klog_s1_x4(INFO, PCI_, tag_pci_dev, k_bus, bus, k_dev, dev, k_vendor, vendor, k_device, device) — 4 KV pairs is klog's max arity. (7) Bridge check: if (header_type & 0x7F) == 1 → read secondary_bus (u8 @ 0x19); if not already in visited bitmap → mark visited and enqueue. (8) On outer loop exit: emit klog_s1_d1(INFO, PCI_, tag_pci_enum_done, k_devices, count); return count. All nested pci_config_read_u{8,16} preserve callee-saves per SysV — record_ptr and per-BDF scratch survive across every read via stack slots [rsp+0..32]. Stack invariant: 6 pushes + sub rsp,40 = 88 B → rsp%16==0 (post-prologue). klog_s1_x4 5-push emit path uses one 8-byte pre-align (sub rsp,8; push5args; call; add rsp,40; add rsp,8) matching core/int/dump.pdx L80 pattern. G1 sized stores; G4 full-reg compares. Reserved labels avoided (loop → enum_bus_drain/enum_dev_iter/enum_fn_iter). Queue overflow silently drops (no counter — real overflow means firmware topology exceeds every consumer/server board ever built).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        // ---- Save segment. ----
        mov r12, rdi;

        // ---- (1) MCFG absence guard. ----
        mov rax, [rip + _mcfg_count];
        cmp rax, 0;
        jne enum_mcfg_present;

        // Emit "PCI ENUM SKIP no MCFG".
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_enum_skip_no_mcfg];
        call klog_s1;

        // Zero _pci_device_count and return 0.
        xor rax, rax;
        mov [rip + _pci_device_count], rax;
        jmp enum_epilogue;

      enum_mcfg_present:

        // ---- (2) Zero device count + visited bitmap (4 × u64 = 32 B). ----
        xor rax, rax;
        mov [rip + _pci_device_count], rax;
        mov [rip + _pci_bus_visited + 0],  rax;
        mov [rip + _pci_bus_visited + 8],  rax;
        mov [rip + _pci_bus_visited + 16], rax;
        mov [rip + _pci_bus_visited + 24], rax;

        // ---- (3) Enqueue bus 0 into queue[0] as a u8. ----
        lea rax, [rip + _pci_bus_queue];
        xor rcx, rcx;
        mov_b [rax + 0], rcx;

        // Set visited bit 0 (byte 0, bit 0).
        lea rax, [rip + _pci_bus_visited];
        xor rcx, rcx;
        mov_b rcx, [rax + 0];
        or rcx, 1;
        mov_b [rax + 0], rcx;

        // head = 0, tail = 1.
        xor rbx, rbx;
        mov rbp, 1;

        // ================================================================
        // (4) Bus-drain outer loop.
        // ================================================================
      enum_bus_drain:
        cmp rbx, rbp;
        jae enum_bus_drain_done;

        // Load current bus into r13.
        lea rax, [rip + _pci_bus_queue];
        xor r13, r13;
        mov_b r13, [rax + rbx*1];
        add rbx, 1;

        // ---- dev 0..31 ----
        xor r14, r14;
      enum_dev_iter:
        cmp r14, 32;
        jae enum_dev_iter_done;

        // ---- fn 0..7 ----
        xor r15, r15;
      enum_fn_iter:
        cmp r15, 8;
        jae enum_fn_iter_done;

        // pci_probe_device(seg, bus, dev, fn)
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call pci_probe_device;

        // If 0 (absent):
        //   - fn==0: single-function absent → skip whole slot.
        //   - fn>0:  just skip this function.
        cmp rax, 0;
        jne enum_fn_present;

        cmp r15, 0;
        je enum_fn_iter_done;
        jmp enum_fn_next;

      enum_fn_present:
        // ---- (5) Compute record ptr and stash it. ----
        mov rcx, [rip + _pci_device_count];
        cmp rcx, 256;                                // PCI_MAX_DEVICES
        jae enum_skip_record;                        // silent overflow

        mov rax, rcx;
        shl rax, 5;                                  // *32
        lea rdi, [rip + _pci_devices];
        add rax, rdi;                                // rax = &record[count]
        mov [rsp + 0], rax;                          // stash record_ptr

        // ---- +0 u16 segment ----
        mov_w [rax + 0], r12;

        // ---- +2 u8 bus ----
        mov_b [rax + 2], r13;

        // ---- +3 u8 dev ----
        mov_b [rax + 3], r14;

        // ---- +4 u8 fn ----
        mov_b [rax + 4], r15;

        // ---- header_type (u8 @ 0x0E) → +5 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0E;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 5], rax;
        and rax, 0x7F;                               // strip multi-function bit
        mov [rsp + 8], rax;                          // stash hdr_type_masked

        // ---- class_code (u8 @ 0x0B) → +6 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0B;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 6], rax;

        // ---- subclass (u8 @ 0x0A) → +7 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0A;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 7], rax;

        // ---- vendor_id (u16 @ 0x00) → +8 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x00;
        call pci_config_read_u16;
        mov rcx, [rsp + 0];
        mov_w [rcx + 8], rax;
        mov [rsp + 16], rax;                         // stash vendor_id

        // ---- device_id (u16 @ 0x02) → +10 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x02;
        call pci_config_read_u16;
        mov rcx, [rsp + 0];
        mov_w [rcx + 10], rax;
        mov [rsp + 24], rax;                         // stash device_id

        // ---- cap_ptr (u8 @ 0x34) → +12 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x34;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 12], rax;

        // ---- Zero tail (u8 _pad0 @+13, u16 bar_kinds_bitmap @+14,
        //      u64 _reserved_0 @+16, u64 _reserved_1 @+24). ----
        mov rcx, [rsp + 0];
        xor rax, rax;
        mov_b [rcx + 13], rax;
        mov_w [rcx + 14], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;

        // Advance _pci_device_count.
        mov rax, [rip + _pci_device_count];
        add rax, 1;
        mov [rip + _pci_device_count], rax;

        // ---- (6) klog_s1_x4(INFO, PCI_, tag_pci_dev,
        //          k_bus, bus, k_dev, dev, k_vendor, vendor, k_device, device)
        //
        // Stack extended-args convention (klog_s1_x4 @rbp+16..48):
        //   [rbp+16]=v2(dev), [rbp+24]=k3, [rbp+32]=v3(vendor),
        //   [rbp+40]=k4, [rbp+48]=v4(device)
        // Push in reverse order (rightmost first). Pre-align sub rsp,8
        // then 5 × push (40 B) → rsp%16==0 at call. ---- ----
        sub rsp, 8;
        mov rax, [rsp + 32];                         // device_id (was [rsp+24] pre-sub)
        push rax;                                    // v4 (rightmost)
        lea rax, [rip + k_device];
        push rax;                                    // k4
        mov rax, [rsp + 40];                         // vendor_id (was [rsp+16] pre-sub-8-and-2-push)
        push rax;                                    // v3
        lea rax, [rip + k_vendor];
        push rax;                                    // k3
        mov rax, r14;                                // dev
        push rax;                                    // v2

        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_dev];
        lea rcx, [rip + k_bus];
        mov r8, r13;                                 // v1 = bus
        lea r9, [rip + k_dev];
        call klog_s1_x4;

        add rsp, 40;                                 // pop 5 pushed args
        add rsp, 8;                                  // undo pre-align

        // ---- (7) Bridge check ----
        mov rax, [rsp + 8];                          // hdr_type_masked
        cmp rax, 1;                                  // Type 1 (bridge)?
        jne enum_after_bridge;

        // secondary_bus (u8 @ 0x19)
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x19;
        call pci_config_read_u8;

        // rax = sec. Skip 0 (self / uninitialized bridge).
        cmp rax, 0;
        je enum_after_bridge;

        // Visited: byte = sec >> 3, bit = sec & 7.
        mov r10, rax;                                // r10 = sec (also enqueue value)
        mov r11, rax;
        shr r11, 3;                                  // r11 = byte index
        mov r8, rax;
        and r8, 7;                                   // r8 = bit index

        lea rdi, [rip + _pci_bus_visited];
        xor rcx, rcx;
        mov_b rcx, [rdi + r11*1];

        // r9 = 1 << bit_index
        mov r9, 1;
        push rcx;
        mov rcx, r8;
        shl r9, cl;
        pop rcx;

        // If already visited, skip.
        mov r8, rcx;
        and r8, r9;
        jnz enum_after_bridge;

        // Mark visited.
        or rcx, r9;
        // Compute address into scratch reg (mov_b store does not
        // support reg+reg SIB in current encoder).
        mov r8, rdi;
        add r8, r11;
        mov_b [r8 + 0], rcx;

        // Enqueue if space.
        cmp rbp, 32;
        jae enum_after_bridge;

        lea rdi, [rip + _pci_bus_queue];
        mov r8, rdi;
        add r8, rbp;
        mov_b [r8 + 0], r10;
        add rbp, 1;

      enum_after_bridge:
        jmp enum_fn_next;

      enum_skip_record:
        // Overflow — silent drop. Fall into fn advance.

      enum_fn_next:
        add r15, 1;
        jmp enum_fn_iter;

      enum_fn_iter_done:
        add r14, 1;
        jmp enum_dev_iter;

      enum_dev_iter_done:
        jmp enum_bus_drain;

      enum_bus_drain_done:

        // ---- (8) Emit "PCI ENUM DONE devices=<N>" ----
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_enum_done];
        lea rcx, [rip + k_devices];
        mov r8, [rip + _pci_device_count];
        call klog_s1_d1;

        mov rax, [rip + _pci_device_count];

      enum_epilogue:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_enumerate_segment_range(seg, start_bus, end_bus) -> u64
  // ============================================================================
  //
  // R111.M2-005 (paideia-os #2357): real-HW-capable ECAM walker.
  //
  // SysV: (seg: u64, start_bus: u64, end_bus: u64) -> u64
  //   rdi = segment (u16 in low bits)
  //   rsi = start_bus (u8 in low bits)  — first bus of this segment's ECAM
  //   rdx = end_bus (u8 in low bits)    — last bus (inclusive) of this segment
  //
  // Returns rax = 0 (count is aggregated in the shared _pci_device_count
  // slot by the caller). The APPEND-mode helper is a byte-shape sibling of
  // pci_enumerate_all: same bus queue, same visited bitmap, same per-BDF
  // decode, same Type-1 bridge descent — but with three real-HW-specific
  // differences:
  //
  //   (1) Seeds the queue with `start_bus` (arg1) rather than bus 0, so
  //       segments whose first bus is non-zero (2-socket EPYC's second
  //       segment, AMD I/O-die multi-domain layouts) are walked correctly.
  //
  //   (2) Bounds-checks each bridge's secondary_bus against [start_bus,
  //       end_bus] before enqueue. On well-formed firmware a bridge in
  //       segment N only publishes a secondary in segment N's range, so
  //       the check is defensive; it also prevents corrupted/malicious
  //       bridge headers from causing the walker to reach out-of-segment
  //       ECAM addresses that would fault or return garbage.
  //
  //   (3) Does NOT zero _pci_device_count or _pci_bus_visited. The caller
  //       (pci_enumerate_all_segments) resets them once at the start of
  //       the multi-segment walk. This lets us append records from
  //       multiple segments into the same _pci_devices array.
  //
  //   (4) Does NOT emit the PCI ENUM SKIP no MCFG or PCI ENUM DONE
  //       fingerprints — those are the caller's responsibility.
  //
  // Per present function, the helper emits BOTH the legacy PCI DEV
  // fingerprint (unchanged, for backward compat with R22 golden fixtures
  // and downstream log-parsing tools) AND the new PCIE BDF fingerprint
  // that carries seg/fn/class (the three fields the R22 emit dropped).
  //
  // -----------------------------------------------------------------------------
  // Stack frame
  // -----------------------------------------------------------------------------
  //
  //   push rbx, rbp, r12, r13, r14, r15 (48 B)
  //   sub rsp, 56 (7 u64 scratch slots)
  //   Total decrement: 104 B. Entry rsp%16==8 -> post-prologue rsp%16==0.
  //
  //   Scratch layout:
  //     [rsp+0]  = record_ptr
  //     [rsp+8]  = hdr_type_masked (bit 7 stripped)
  //     [rsp+16] = vendor_id
  //     [rsp+24] = device_id
  //     [rsp+32] = packed_bus_range = (start_bus << 8) | end_bus
  //     [rsp+40] = class_u24 = (class_code << 16) | (subclass << 8)
  //     [rsp+48] = packed_bdf = (seg<<32) | (bus<<16) | (dev<<8) | fn
  //
  //   Callee-save regs:
  //     r12 = segment
  //     r13 = current bus
  //     r14 = current dev
  //     r15 = current fn
  //     rbx = queue head cursor (0..32)
  //     rbp = queue tail cursor (0..32)
  //
  // Labels use `pesr_` prefix (pci-enumerate-segment-range) to avoid
  // clashing with the pci_enumerate_all `enum_*` labels in the same module.

  pub let pci_enumerate_segment_range : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, start_bus: u64, end_bus: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M2-005 (paideia-os #2357). Real-HW-capable APPEND-mode PCIe ECAM walker. Byte-shape sibling of pci_enumerate_all with three targeted differences: (a) queue seeded with start_bus (arg1) not 0, so segments whose first bus is non-zero are walked correctly; (b) bounds-check each bridge's secondary_bus against [start_bus, end_bus] before enqueue, preventing cross-segment aliasing and corrupted-bridge-header out-of-segment reads; (c) NO zero-init of _pci_device_count or _pci_bus_visited (caller resets once) and NO PCI ENUM SKIP / DONE emits (caller emits once). Per BDF the helper emits both the legacy PCI DEV klog_s1_x4 fingerprint (unchanged, preserves R22 golden fixtures and downstream tool compat) and the new PCIE BDF klog_s1_x4 fingerprint that carries seg/fn/class (the three fields the R22 emit dropped) in a single packed u64 (bdf=seg<<32|bus<<16|dev<<8|fn) plus vid/did/class_u24. Stack frame: 6 pushes (rbx/rbp/r12..r15) = 48B + sub rsp,56 = 104B decrement; entry rsp%16==8 -> post-prologue rsp%16==0 (nested pci_probe_device / pci_config_read_u8 / klog_s1_x4 all SysV-aligned). Scratch slots [rsp+0..48]: record_ptr, hdr_type_masked, vendor_id, device_id, packed_bus_range, class_u24, packed_bdf. Bounds check on bridge enqueue: `mov rcx, [rsp+32]; mov r10, rcx; shr r10, 8; and r10, 0xFF; and rcx, 0xFF; cmp rax, r10; jb skip; cmp rax, rcx; ja skip`. Klog emit uses the same 5-push pre-align pattern as pci_enumerate_all's PCI DEV emit (sub rsp,8; push5args; call; add rsp,40; add rsp,8); computed packed_bdf/class_u24 stashed in scratch BEFORE the sub-rsp-push chain so offset arithmetic is stable across the two consecutive klog_s1_x4 calls. Labels prefixed pesr_ to avoid conflict with enum_* labels in the pci_enumerate_all sibling.  G1 sized stores; G4 full-reg compares.  Reserved-label discipline: pesr_bus_drain / pesr_dev_iter / pesr_fn_iter / pesr_fn_present / pesr_after_bridge / pesr_fn_next / pesr_epilogue etc.  Queue overflow silently drops (same posture as pci_enumerate_all).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;

        // ---- Save args + stash bus range. ----
        mov r12, rdi;                                // seg
        // packed_bus_range = (start_bus << 8) | end_bus into [rsp+32]
        mov rax, rsi;                                // start_bus
        and rax, 0xFF;
        shl rax, 8;
        mov rcx, rdx;                                // end_bus
        and rcx, 0xFF;
        or  rax, rcx;
        mov [rsp + 32], rax;

        // ---- Init queue: enqueue start_bus into queue[0] as a u8. ----
        lea rax, [rip + _pci_bus_queue];
        mov rcx, rsi;                                // start_bus
        and rcx, 0xFF;
        mov_b [rax + 0], rcx;

        // Set visited bit for start_bus.
        //   byte_idx = start_bus >> 3, bit = start_bus & 7
        mov rcx, rsi;
        and rcx, 0xFF;
        mov r10, rcx;
        shr r10, 3;                                  // r10 = byte index
        mov r11, rcx;
        and r11, 7;                                  // r11 = bit index

        lea rdi, [rip + _pci_bus_visited];
        mov r8, rdi;
        add r8, r10;                                 // r8 = &_pci_bus_visited[byte_idx]
        xor rcx, rcx;
        mov_b rcx, [r8 + 0];

        // r9 = 1 << bit_index
        mov r9, 1;
        push rcx;                                    // preserve rcx (visited byte)
        mov rcx, r11;
        shl r9, cl;
        pop rcx;
        or  rcx, r9;
        mov_b [r8 + 0], rcx;

        // head = 0, tail = 1.
        xor rbx, rbx;
        mov rbp, 1;

        // ================================================================
        // Bus-drain outer loop.
        // ================================================================
      pesr_bus_drain:
        cmp rbx, rbp;
        jae pesr_bus_drain_done;

        // Load current bus into r13.
        lea rax, [rip + _pci_bus_queue];
        xor r13, r13;
        mov_b r13, [rax + rbx*1];
        add rbx, 1;

        // ---- dev 0..31 ----
        xor r14, r14;
      pesr_dev_iter:
        cmp r14, 32;
        jae pesr_dev_iter_done;

        // ---- fn 0..7 ----
        xor r15, r15;
      pesr_fn_iter:
        cmp r15, 8;
        jae pesr_fn_iter_done;

        // pci_probe_device(seg, bus, dev, fn)
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call pci_probe_device;

        // If 0 (absent):
        //   - fn==0: single-function absent -> skip whole slot.
        //   - fn>0:  just skip this function.
        cmp rax, 0;
        jne pesr_fn_present;

        cmp r15, 0;
        je pesr_fn_iter_done;
        jmp pesr_fn_next;

      pesr_fn_present:
        // ---- Compute record ptr and stash it. ----
        mov rcx, [rip + _pci_device_count];
        cmp rcx, 256;                                // PCI_MAX_DEVICES
        jae pesr_skip_record;                        // silent overflow

        mov rax, rcx;
        shl rax, 5;                                  // *32
        lea rdi, [rip + _pci_devices];
        add rax, rdi;                                // rax = &record[count]
        mov [rsp + 0], rax;                          // stash record_ptr

        // ---- +0 u16 segment ----
        mov_w [rax + 0], r12;

        // ---- +2 u8 bus ----
        mov_b [rax + 2], r13;

        // ---- +3 u8 dev ----
        mov_b [rax + 3], r14;

        // ---- +4 u8 fn ----
        mov_b [rax + 4], r15;

        // ---- header_type (u8 @ 0x0E) -> +5 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0E;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 5], rax;
        and rax, 0x7F;                               // strip multi-function bit
        mov [rsp + 8], rax;                          // stash hdr_type_masked

        // ---- class_code (u8 @ 0x0B) -> +6 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0B;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 6], rax;

        // ---- subclass (u8 @ 0x0A) -> +7 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x0A;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 7], rax;

        // ---- vendor_id (u16 @ 0x00) -> +8 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x00;
        call pci_config_read_u16;
        mov rcx, [rsp + 0];
        mov_w [rcx + 8], rax;
        mov [rsp + 16], rax;                         // stash vendor_id

        // ---- device_id (u16 @ 0x02) -> +10 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x02;
        call pci_config_read_u16;
        mov rcx, [rsp + 0];
        mov_w [rcx + 10], rax;
        mov [rsp + 24], rax;                         // stash device_id

        // ---- cap_ptr (u8 @ 0x34) -> +12 ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x34;
        call pci_config_read_u8;
        mov rcx, [rsp + 0];
        mov_b [rcx + 12], rax;

        // ---- Zero tail (u8 _pad0 @+13, u16 bar_kinds_bitmap @+14,
        //      u64 _reserved_0 @+16, u64 _reserved_1 @+24). ----
        mov rcx, [rsp + 0];
        xor rax, rax;
        mov_b [rcx + 13], rax;
        mov_w [rcx + 14], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;

        // Advance _pci_device_count.
        mov rax, [rip + _pci_device_count];
        add rax, 1;
        mov [rip + _pci_device_count], rax;

        // ---- Legacy PCI DEV emit (preserved for R22 golden fixtures +
        //      downstream log-parsing tool compat).  Same shape as
        //      pci_enumerate_all's L318..347 block. ----
        sub rsp, 8;
        mov rax, [rsp + 32];                         // device_id (was [rsp+24] pre-sub)
        push rax;                                    // v4
        lea rax, [rip + k_device];
        push rax;                                    // k4
        mov rax, [rsp + 40];                         // vendor_id
        push rax;                                    // v3
        lea rax, [rip + k_vendor];
        push rax;                                    // k3
        mov rax, r14;                                // dev
        push rax;                                    // v2

        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_dev];
        lea rcx, [rip + k_bus];
        mov r8, r13;                                 // v1 = bus
        lea r9, [rip + k_dev];
        call klog_s1_x4;

        add rsp, 40;
        add rsp, 8;

        // ---- Compute packed_bdf into [rsp+48] BEFORE the PCIE BDF
        //      emit's sub-rsp+push chain so offset arithmetic stays stable.
        //      packed_bdf = (seg << 32) | (bus << 16) | (dev << 8) | fn ----
        mov rax, r12;                                // seg
        shl rax, 32;
        mov r10, rax;                                // r10 = seg << 32
        mov rax, r13;                                // bus
        and rax, 0xFF;
        shl rax, 16;
        or  r10, rax;                                // + bus << 16
        mov rax, r14;                                // dev
        and rax, 0x1F;                               // 5 bits
        shl rax, 8;
        or  r10, rax;                                // + dev << 8
        mov rax, r15;                                // fn
        and rax, 7;                                  // 3 bits
        or  r10, rax;
        mov [rsp + 48], r10;                         // stash packed_bdf

        // ---- Compute class_u24 into [rsp+40].
        //      class_u24 = (class_code << 16) | (subclass << 8).
        //      Re-read from record via [rsp+0]. ----
        mov rcx, [rsp + 0];                          // record_ptr
        xor rax, rax;
        mov_b rax, [rcx + 6];                        // class_code
        shl rax, 16;
        mov r11, rax;
        xor rax, rax;
        mov_b rax, [rcx + 7];                        // subclass
        shl rax, 8;
        or  r11, rax;
        mov [rsp + 40], r11;                         // stash class_u24

        // ---- New PCIE BDF emit: klog_s1_x4(INFO, PCI_, tag_pcie_bdf,
        //          k_bdf, packed_bdf, k_vid, vid, k_did, did, k_class,
        //          class_u24)
        //
        // Stack args (deepest -> top): v4=class_u24, k4=k_class, v3=did,
        //   k3=k_did, v2=vid.  Register args: rcx=k_bdf, r8=packed_bdf,
        //   r9=k_vid.  Same 5-push pre-align pattern as the PCI DEV emit.
        //
        // Post-prologue rsp = rsp0.  Scratch slots at [rsp0+0..48].
        // Pre-sub +8 shifts every slot up by 8; each push shifts by 8 more.
        // Read offsets computed via: (orig_slot + 8 + 8*pushes_done).
        //   v4 = class_u24 @ rsp0+40 -> read at [rsp+48] (post-sub)
        //   v3 = did       @ rsp0+24 -> read at [rsp+48] (after 2 pushes)
        //   v2 = vid       @ rsp0+16 -> read at [rsp+56] (after 4 pushes)
        //   v1 = packed_bdf @ rsp0+48 -> read at [rsp+96] (after 5 pushes,
        //                                                  needed in r8 pre-call)
        sub rsp, 8;                                  // pre-align

        // v4 = class_u24
        mov rax, [rsp + 48];
        push rax;

        // k4 = k_class
        lea rax, [rip + k_class];
        push rax;

        // v3 = device_id
        mov rax, [rsp + 48];
        push rax;

        // k3 = k_did
        lea rax, [rip + k_did];
        push rax;

        // v2 = vendor_id
        mov rax, [rsp + 56];
        push rax;

        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pcie_bdf];
        lea rcx, [rip + k_bdf];
        mov r8, [rsp + 96];                          // v1 = packed_bdf
        lea r9, [rip + k_vid];
        call klog_s1_x4;

        add rsp, 40;                                 // pop 5 pushed args
        add rsp, 8;                                  // undo pre-align

        // ---- Bridge check ----
        mov rax, [rsp + 8];                          // hdr_type_masked
        cmp rax, 1;                                  // Type 1 (bridge)?
        jne pesr_after_bridge;

        // secondary_bus (u8 @ 0x19)
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8, 0x19;
        call pci_config_read_u8;

        // rax = sec. Skip 0 (self / uninitialized bridge).
        cmp rax, 0;
        je pesr_after_bridge;

        // ---- R111.M2-005: bounds check sec in [start_bus, end_bus] ----
        //   packed_bus_range = (start<<8) | end at [rsp+32].
        mov rcx, [rsp + 32];
        mov r10, rcx;
        shr r10, 8;
        and r10, 0xFF;                               // r10 = start_bus
        and rcx, 0xFF;                               // rcx = end_bus

        // sec < start_bus -> skip.
        cmp rax, r10;
        jb pesr_after_bridge;
        // sec > end_bus -> skip.
        cmp rax, rcx;
        ja pesr_after_bridge;

        // Visited: byte = sec >> 3, bit = sec & 7.
        mov r10, rax;                                // r10 = sec (also enqueue value)
        mov r11, rax;
        shr r11, 3;                                  // r11 = byte index
        mov r8, rax;
        and r8, 7;                                   // r8 = bit index

        lea rdi, [rip + _pci_bus_visited];
        xor rcx, rcx;
        mov_b rcx, [rdi + r11*1];

        // r9 = 1 << bit_index
        mov r9, 1;
        push rcx;
        mov rcx, r8;
        shl r9, cl;
        pop rcx;

        // If already visited, skip.
        mov r8, rcx;
        and r8, r9;
        jnz pesr_after_bridge;

        // Mark visited.
        or rcx, r9;
        mov r8, rdi;
        add r8, r11;
        mov_b [r8 + 0], rcx;

        // Enqueue if space.
        cmp rbp, 32;
        jae pesr_after_bridge;

        lea rdi, [rip + _pci_bus_queue];
        mov r8, rdi;
        add r8, rbp;
        mov_b [r8 + 0], r10;
        add rbp, 1;

      pesr_after_bridge:
        jmp pesr_fn_next;

      pesr_skip_record:
        // Overflow — silent drop. Fall into fn advance.

      pesr_fn_next:
        add r15, 1;
        jmp pesr_fn_iter;

      pesr_fn_iter_done:
        add r14, 1;
        jmp pesr_dev_iter;

      pesr_dev_iter_done:
        jmp pesr_bus_drain;

      pesr_bus_drain_done:

        xor rax, rax;                                // caller reads _pci_device_count directly
        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_enumerate_all_segments() -> u64
  // ============================================================================
  //
  // R111.M2-005 (paideia-os #2357): multi-segment orchestrator for real HW.
  //
  // SysV: () -> u64
  //   Returns rax = total device count aggregated across every MCFG segment.
  //
  // Sequence:
  //   (1) MCFG-absence guard: _mcfg_count == 0 -> emit "PCI ENUM SKIP no
  //       MCFG", zero _pci_device_count, return 0. Matches pci_enumerate_all
  //       posture for the QEMU -kernel PVH boot path (no RSDP).
  //   (2) Zero _pci_device_count and _pci_bus_visited (4 x u64 = 32 B) ONCE
  //       before iterating segments. On well-formed firmware bus numbers
  //       are disjoint across segments so the shared visited bitmap is
  //       correct without per-segment reset. The pci_enumerate_segment_range
  //       helper deliberately does NOT reset these fields — that is this
  //       orchestrator's job.
  //   (3) For each segment in _mcfg_segments[0.._mcfg_count):
  //         load seg (u16 @ record+8), start_bus (u8 @ record+10),
  //         end_bus (u8 @ record+11); call
  //         pci_enumerate_segment_range(seg, start_bus, end_bus).
  //   (4) Emit "PCI ENUM DONE devices=<total>" (klog_s1_d1) once at end.
  //   (5) Return _pci_device_count in rax.
  //
  // On a 99%-of-hardware layout (single segment, bus 0..0xFF) the outer
  // loop runs exactly once and the observable behavior matches R22's
  // pci_enumerate_all(0) byte-for-byte at the boot-transcript layer,
  // except for the additional PCIE BDF fingerprint emitted per BDF.
  //
  // Register plan (4-push callee-save + 8-align):
  //   rbx = base of _mcfg_segments (loaded once)
  //   r12 = _mcfg_count (loop cap)
  //   r13 = loop index i
  //   r14 = per-iteration record VA (recomputed each iteration)
  //   Entry rsp%16==8; 4 pushes = 32B -> rsp%16==8; sub 8 -> rsp%16==0.

  pub let pci_enumerate_all_segments : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M2-005 (paideia-os #2357): multi-segment orchestrator invoked from kernel_main in place of pci_enumerate_all(0). Body: (1) MCFG-absence guard identical to pci_enumerate_all — reads _mcfg_count, if 0 emits klog_s1(LEVEL_INFO, SUBSYS_PCI_, tag_pci_enum_skip_no_mcfg), zeros _pci_device_count, returns 0. (2) One-shot zero of _pci_device_count + _pci_bus_visited (4 x u64 = 32B) BEFORE the per-segment loop; pci_enumerate_segment_range deliberately does not reset those slots so per-segment calls append into the shared _pci_devices array with a shared visited bitmap (bus numbers are disjoint across segments per PCI Firmware Spec 3.3, so cross-segment visited-bit aliasing is impossible on well-formed firmware). (3) Load _mcfg_count into r12 and &_mcfg_segments into rbx (both once). Loop rax=r13 in 0..r12: compute record VA = rbx + r13*24 via the 24=8+16 shift trick (same pattern as mcfg_ecam_base_for_segment and mcfg_parse_segments); load seg into rdi via xor+mov_w [r14+8], start_bus into rsi via xor+mov_b [r14+10], end_bus into rdx via xor+mov_b [r14+11]; call pci_enumerate_segment_range (SysV-aligned at post-prologue rsp%16==0). (4) After the loop, emit klog_s1_d1(LEVEL_INFO, SUBSYS_PCI_, tag_pci_enum_done, k_devices, _pci_device_count). (5) Return _pci_device_count in rax. Register plan: 4-push callee-save (rbx=&_mcfg_segments base, r12=_mcfg_count cap, r13=loop index, r14=per-iter record VA) + sub rsp,8 for alignment; entry rsp%16==8 -> 4 pushes = 32B -> rsp%16==8 -> sub 8 -> rsp%16==0 for the nested calls. Encoder: same instruction floor as pci_enumerate_all + platform_map_mcfg_segments (mov / lea / xor / mov_b / mov_w / mov_d [rip+sym] loads and stores, shl / add / sub / and / or r64,imm8|imm32, cmp / je / jne / jae / jmp, call rel32, ret) — all pre-existing. Labels prefixed peas_ to avoid clash with enum_* (pci_enumerate_all) and pesr_ (pci_enumerate_segment_range) label spaces.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // ---- (1) MCFG absence guard. ----
        mov rax, [rip + _mcfg_count];
        cmp rax, 0;
        jne peas_mcfg_present;

        // Emit "PCI ENUM SKIP no MCFG".
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_enum_skip_no_mcfg];
        call klog_s1;

        // Zero _pci_device_count and return 0.
        xor rax, rax;
        mov [rip + _pci_device_count], rax;
        jmp peas_epilogue;

      peas_mcfg_present:

        // ---- (2) One-shot zero of _pci_device_count + visited bitmap. ----
        xor rax, rax;
        mov [rip + _pci_device_count], rax;
        mov [rip + _pci_bus_visited + 0],  rax;
        mov [rip + _pci_bus_visited + 8],  rax;
        mov [rip + _pci_bus_visited + 16], rax;
        mov [rip + _pci_bus_visited + 24], rax;

        // ---- (3) Loop segments. ----
        lea rbx, [rip + _mcfg_segments];
        mov r12, [rip + _mcfg_count];
        xor r13, r13;                                // index = 0

      peas_seg_loop:
        cmp r13, r12;
        jae peas_seg_loop_done;

        // record VA = _mcfg_segments + r13 * 24 (= r13*8 + r13*16)
        mov rax, r13;
        shl rax, 3;                                  // r13 * 8
        mov r14, rax;
        mov rax, r13;
        shl rax, 4;                                  // r13 * 16
        add rax, r14;                                // rax = r13 * 24
        mov r14, rbx;
        add r14, rax;                                // r14 = record VA

        // Load seg (u16 @ record+8), zero-extended.
        xor rdi, rdi;
        mov_w rdi, [r14 + 8];

        // Load start_bus (u8 @ record+10), zero-extended.
        xor rsi, rsi;
        mov_b rsi, [r14 + 10];

        // Load end_bus (u8 @ record+11), zero-extended.
        xor rdx, rdx;
        mov_b rdx, [r14 + 11];

        call pci_enumerate_segment_range;

        add r13, 1;
        jmp peas_seg_loop;

      peas_seg_loop_done:

        // ---- (4) Emit "PCI ENUM DONE devices=<N>". ----
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_PCI_];
        lea rdx, [rip + tag_pci_enum_done];
        lea rcx, [rip + k_devices];
        mov r8, [rip + _pci_device_count];
        call klog_s1_d1;

        // ---- (5) Return _pci_device_count. ----
        mov rax, [rip + _pci_device_count];

      peas_epilogue:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pci_probe_table_find(vid_did) -> u64
  // ============================================================================
  //
  // R111.M2-006 (paideia-os #2358): probe-table lookup helper.
  //
  // SysV: (vid_did: u64) -> u64
  //   rdi = (vid << 16) | did   — both u16, packed into the low 32 bits.
  //         Upper 32 bits are ignored (defensive mask applied on entry).
  //
  // Returns:
  //   rax = index of the first matching record in _pci_devices (0 ..
  //         _pci_device_count), OR 0xFFFFFFFFFFFFFFFF (u64::MAX = -1)
  //         when no record matches.
  //
  // The lookup walks the enum-published _pci_devices table produced by
  // pci_enumerate_all_segments (record layout: vid at u16 @+8, did at
  // u16 @+10, record stride 32). Downstream driver probes (bochs_stdvga,
  // rtl8139, e1000e, virtio-net, nvme, ...) consult this helper instead
  // of re-walking config space, so the config-space walk cost is paid
  // exactly once by the enumerator and every driver amortises against
  // the shared table. Multi-DID probes (e1000e's 20-DID membership
  // across 6 Intel ranges) still walk _pci_devices directly for the
  // range-check pattern — pci_probe_table_find is optimised for the
  // single-(vid,did) case that covers most single-purpose drivers.
  //
  // -----------------------------------------------------------------------------
  // Register plan
  // -----------------------------------------------------------------------------
  //
  //   Callee-save: rbx, r12, r13 (3 pushes = 24 B).
  //   Entry rsp%16==8; after 3 pushes rsp%16==0. This function makes
  //   NO nested calls, so no additional alignment pad is required —
  //   the misaligned exit rsp%16==0 is the entry state a caller
  //   restored across ret.
  //
  //   rbx = loop index i (0 .. _pci_device_count)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = wanted vid_did (masked to low 32 bits)
  //
  // Labels prefixed `ppt_` to avoid clashing with the enum_* /
  // pesr_ / peas_ label spaces used by the sibling entry points.

  pub let pci_probe_table_find : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (vid_did: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M2-006 (paideia-os #2358). Probe-table lookup helper. Takes packed vid_did (vid<<16 | did) and returns the index of the first matching _pci_devices record or 0xFFFFFFFFFFFFFFFF (-1) if none matches. Downstream driver probes (bochs_stdvga, rtl8139, ...) consult this instead of re-walking config space so the ECAM cost paid once by pci_enumerate_all_segments amortises across every driver. Body: (1) 3-push callee-save prologue (rbx, r12, r13) = 24 B; entry rsp%16==8 -> rsp%16==0 post-prologue (no nested calls, no extra pad). (2) Mask rdi to low 32 bits into r13 (defensive against callers accidentally leaving high bits set). (3) Load _pci_device_count into r12. (4) Init i=rbx=0. (5) Loop: cmp rbx, r12; jae notfound. (6) Compute record ptr = _pci_devices + (i << 5) into rax; read vid (u16 @+8) into rcx via `xor rcx,rcx; mov_w rcx, [rax+8]` (encoder dst-zero form — no mov_wzx), shift rcx <<= 16, read did (u16 @+10) into rdx via `xor rdx,rdx; mov_w rdx, [rax+10]`, or rcx, rdx to form packed. cmp rcx, r13; je match. (7) Advance i, loop. (8) notfound: mov rax, 0xFFFFFFFFFFFFFFFF (imm64 supported per fs/vops.pdx L24) and jmp epilogue. (9) match: mov rax, rbx. (10) Epilogue: pop r13/r12/rbx, ret. Encoder posture: G1 sized loads via mov_w dst-zero form; G4 full-register compares (cmp rcx, r13; cmp rbx, r12) — no cmp reg,[mem]. Reserved-label discipline: labels prefixed `ppt_` (loop -> ppt_find_loop, next -> ppt_find_next, etc.).",
      block: {
        push rbx;
        push r12;
        push r13;

        // Mask wanted vid_did to low 32 bits (defensive against callers
        // leaving high bits set by accident — the packed representation
        // is (vid16 << 16) | did16, so bits [63:32] must be zero).
        //
        // Uses the shl-then-shr round trip rather than `and r13,
        // 0xFFFFFFFF` because `AND r64, imm32` sign-extends the imm32:
        // 0xFFFFFFFF has bit 31 set, so the encoded imm32 sign-extends
        // to 0xFFFFFFFFFFFFFFFF and the mask silently no-ops. See the
        // superblock.pdx §sb_validate_sig_scope note (§L699) that
        // documents the same hazard.
        mov r13, rdi;
        shl r13, 32;
        shr r13, 32;

        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                                // i = 0

      ppt_find_loop:
        cmp rbx, r12;
        jae ppt_find_notfound;

        // rax = &_pci_devices[i] = base + (i << 5)
        mov rax, rbx;
        shl rax, 5;
        lea rcx, [rip + _pci_devices];
        add rax, rcx;                                // rax = record ptr

        // Read vid (u16 @+8) into rcx (zero-extended via dst-zero form).
        xor rcx, rcx;
        mov_w rcx, [rax + 8];
        shl rcx, 16;                                 // rcx = vid << 16

        // Read did (u16 @+10) into rdx (zero-extended via dst-zero form).
        xor rdx, rdx;
        mov_w rdx, [rax + 10];
        or rcx, rdx;                                 // rcx = (vid<<16)|did

        cmp rcx, r13;
        je ppt_find_match;

        add rbx, 1;
        jmp ppt_find_loop;

      ppt_find_notfound:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        jmp ppt_find_epilogue;

      ppt_find_match:
        mov rax, rbx;

      ppt_find_epilogue:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
