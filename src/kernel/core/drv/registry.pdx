// src/kernel/core/drv/registry.pdx — Wave 59 D4 (#2521) skeleton
//
// Driver registry v2 — in-kernel signed-manifest + rollback substrate.
//
// Design reference
// ----------------
// `design/drivers/registry.md` (Wave 59 D4) is the binding spec. Companion
// to the on-disk `design/drivers/registry-v2.md` (R29.M3); this file owns
// the in-RAM, cap-attributed table of BOUND drivers; that file owns the
// durable, signed-at-rest ENTITLEMENT image. The two cross-reference by
// manifest name — see §0.4 of the design doc.
//
// What this file is
// -----------------
// Structural stub: declares the registry-row shape, the backing .bss
// table, and the five entrypoints:
//
//   driver_registry_bind            — mint path, consumes a manifest row,
//                                     ML-DSA-65 verifies against
//                                     paideia_root_pk, returns Cap<KIND_DRIVER>
//   driver_registry_unbind          — tear down a bound driver
//   driver_registry_lookup          — supervisor-side name -> cap resolve
//   driver_registry_begin_rollback  — mint Cap<KIND_ROLLBACK_TOKEN> for a
//                                     staged version swap
//   driver_registry_commit_rollback — consume the token to perform swap
//
// Every entrypoint emits a `.rodata` dispatch-chatter tag through klog_s1
// (SUBSYS_DRV_, KLOG_INFO) and returns INVOKE_UNSUPPORTED
// (0xFFFFFFFFFFFFFFFC). Real bodies — the eight-gate signature
// verification against the manifest row, the BLAKE3-digest-vs-binary
// cross-check, the rollback-attic plumbing, the per-event fingerprints
// (`DRV REG OK`, `DRV SIG OK`, `DRV ROLLBACK BEGIN/COMMIT/ABORT`) — land
// in the Wave 59 D4 follow-up slice per `design/drivers/registry.md §2`.
//
// Capability shape (design §1.1)
// -----------------------------
// KIND_DRIVER = 0x15 (derived tag; pre-existing in `src/kernel/core/cap/
// kind.pdx` line 151, runtime base KIND_DEVICE = 10). The follow-up slice
// adds the dispatch handler for this tag in `cap_invoke_dispatch`.
//
// KIND_ROLLBACK_TOKEN = 0x160 (NEW; derived tag out of 4-bit range,
// runtime base KIND_RESERVED = 15). A one-shot cap minted by
// `driver_registry_begin_rollback` and consumed by `_commit_rollback` or
// `_abort_rollback`. §1.2 of the design doc pins the rights ladder:
//   R_ROLLBACK_COMMIT  = 0x01
//   R_ROLLBACK_ABORT   = 0x02
//   R_ROLLBACK_INSPECT = 0x10
//   R_ROLLBACK_ALL     = 0x13
//
// Row layout (design §1.4.1)
// -------------------------
// 64-byte row, 32 slots, 2 KiB .bss. The hot row holds the fields the
// dispatch path reads on every op (status, generation, version, name,
// cap_holder_slot, manifest_offset, teardown_fn, rollback_token_id,
// row_checksum). The cold slab (`_drv_manifest_region`, 32 × 256 B) and
// the signature region (`_drv_signature_region`, 32 × 3309 B rounded)
// land with the real bodies — the skeleton PR declares only the hot row
// backing to keep the delta minimal and the mint-gate failure mode
// honest (every entrypoint returns INVOKE_UNSUPPORTED, so even a
// mis-wired boot path cannot reach the manifest + signature paths).
//
// Return-code block (design §7)
// ----------------------------
// 0xFFFFFC50..0xFFFFFC5F — DRV_REG_* family. Disjoint from DMA
// (0xFFFFFFD0..DF), timeline (0xFFFFFFC4..CF, kind_hw_timeline.pdx §136),
// MSIX (0xFFFFFFE7..EF), HW_INT (0xFFFFFFF7..FF), and from the on-disk
// registry cluster at 0xFFFFFD00..FDEF. Previously comment-reserved by
// `hda/reset.pdx §4` (R33.M1 scaffold) with zero codes defined; the
// follow-up PR to that file relocates its reservation.
//
// Fingerprint tags (design §6)
// ---------------------------
// This skeleton emits exactly one dispatch-chatter tag `drv_registry_msg`
// from every entrypoint, declared in-module. The follow-up slice relocates
// it into `tags.pdx` and adds the per-event tag catalog:
//   DRV REG OK name=<..> ver=<..> hash=<16hex>
//   DRV SIG OK  /  DRV SIG SCAFFOLD
//   DRV UNBIND OK name=<..>
//   DRV ROLLBACK BEGIN name=<..> staged_ver=<..>
//   DRV ROLLBACK COMMIT name=<..> old_ver=<..> new_ver=<..>
//   DRV ROLLBACK ABORT name=<..>
//   DRV QUARANTINE name=<..> rc=<hex>
//
// What this file does NOT do yet (deferred to the follow-up slice)
// ---------------------------------------------------------------
//   * Manifest-region + signature-region .bss reservations (§3).
//   * Eight-gate signature verification against paideia_root_pk via
//     `driver_sig_verify_algo` (§4).
//   * BLAKE3-digest cross-check against the binary.
//   * Rollback-attic read path for the staged manifest.
//   * Row-checksum xorshift (§1.4.1).
//   * Cap-table mint for KIND_DRIVER and KIND_ROLLBACK_TOKEN.
//   * Dispatch wiring in cap_invoke_dispatch for both kinds.
//   * Per-event fingerprint emission.
//   * Boot witness in `kernel_main.pdx`.
//
// The skeleton compiles under paideia-as v0.36.81 and emits witness
// chatter so a boot-witness can observe the entry sites are wired; every
// entrypoint returns INVOKE_UNSUPPORTED so a mis-wired dispatch cannot
// create a cap that silently claims a slot.

module Registry = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind for KIND_DRIVER (LAM kind-hint slot). Pre-existing
  // in src/kernel/core/cap/kind.pdx line 150.
  pub let KIND_DRIVER_BASE : u64 = 10

  // Derived-kind tag for KIND_DRIVER. Pre-existing (decimal 21).
  pub let KIND_DRIVER : u64 = 0x15

  // Runtime base kind for KIND_ROLLBACK_TOKEN. Picks KIND_RESERVED = 15
  // for the same reason KIND_DMESG does: a rollback token is not
  // device-adjacent, not notification-adjacent, not memory-adjacent.
  pub let KIND_ROLLBACK_TOKEN_BASE : u64 = 15

  // Derived-kind tag for KIND_ROLLBACK_TOKEN. 0x160 — above the R29
  // derived-kind block (0x140..0x143) and the OP_REGION / FW_SESSION
  // range (0x150..0x155) that landed later. Decimal 352.
  pub let KIND_ROLLBACK_TOKEN : u64 = 0x160

  // ============================================================================
  // Rights (subset of R_DRIVER_ALL — pre-existing in design/drivers/driver-cap.md)
  // ============================================================================

  pub let R_DRIVER_INVOKE   : u64 = 0x01
  pub let R_DRIVER_MANIFEST : u64 = 0x02
  pub let R_DRIVER_UNBIND   : u64 = 0x04
  pub let R_DRIVER_ADMIN    : u64 = 0x08
  pub let R_DRIVER_ALL      : u64 = 0x0F

  // ============================================================================
  // Rights for KIND_ROLLBACK_TOKEN (NEW, this PR; design §1.2)
  // ============================================================================

  pub let R_ROLLBACK_COMMIT  : u64 = 0x01
  pub let R_ROLLBACK_ABORT   : u64 = 0x02
  pub let R_ROLLBACK_INSPECT : u64 = 0x10
  pub let R_ROLLBACK_ALL     : u64 = 0x13

  // ============================================================================
  // Row status enumeration (row header byte [7:0])
  // ============================================================================

  pub let DRV_STATUS_FREE             : u64 = 0
  pub let DRV_STATUS_BOUND            : u64 = 1
  pub let DRV_STATUS_ROLLBACK_PENDING : u64 = 2
  pub let DRV_STATUS_REVOKED          : u64 = 3

  // ============================================================================
  // Manifest flag bits (manifest row [+56])
  // ============================================================================

  pub let DRV_FLAG_FIRMWARE_REQUIRED : u64 = 0x01
  pub let DRV_FLAG_ROLLBACK_ALLOWED  : u64 = 0x02
  pub let DRV_FLAG_DMA_CAPABLE       : u64 = 0x04
  pub let DRV_FLAG_ISR_CAPABLE       : u64 = 0x08

  // ============================================================================
  // Table caps + field domains
  // ============================================================================

  // 32 slots — matches _driver_table (driver_table.pdx) and the on-disk
  // registry v2 cap (REGISTRY_V2_MAX_RECORDS = 32).
  pub let DRV_REGISTRY_MAX : u64 = 32

  // 64 bytes per hot row (design §1.4.1).
  pub let DRV_ROW_BYTES : u64 = 64

  // 256 bytes per manifest row (design §1.4.2). Reserved for the
  // follow-up slice; not allocated here.
  pub let DRV_MANIFEST_BYTES : u64 = 256

  // ML-DSA-65 signature body length — matches sig_verify.pdx
  // SIG_ML_DSA_65_SIG_BYTES. Reserved for the follow-up slice.
  pub let DRV_SIG_BYTES : u64 = 3309

  // ML-DSA-65 public key length — matches sig_verify.pdx
  // SIG_ML_DSA_65_PK_BYTES. Reserved for the follow-up slice.
  pub let DRV_PK_BYTES : u64 = 1952

  // Signature algorithm identifier — matches sig_verify.pdx
  // SIG_ALGO_ML_DSA_65. The scaffold-epoch bind gate (R28..R31) accepts
  // an all-zero 3309-byte body; R32 flips to real verification.
  pub let DRV_SIG_ALGO_ML_DSA_65 : u64 = 1

  // ============================================================================
  // Return codes
  //
  // Block 0xFFFFFC50..0xFFFFFC5F — DRV_REG family. Disjoint from DMA
  // (0xFFFFFFD0..DF), timeline (0xFFFFFFC4..CF), MSIX (0xFFFFFFE7..EF),
  // HW_INT (0xFFFFFFF7..FF), and from the on-disk registry cluster at
  // 0xFFFFFD00..FDEF (registry_v2 / _persist / _lookup / _snapshot /
  // keyring / sig_verify). Previously comment-reserved by hda/reset.pdx
  // §4 (R33.M1 scaffold) with zero codes defined; the follow-up PR to
  // that file relocates its reservation.
  // ============================================================================

  pub let DRV_REG_OK                   : u64 = 0

  pub let DRV_REG_BAD_ARG              : u64 = 0xFFFFFC50
  pub let DRV_REG_SIG_FAIL             : u64 = 0xFFFFFC51
  pub let DRV_REG_HASH_MISMATCH        : u64 = 0xFFFFFC52
  pub let DRV_REG_NAME_IN_USE          : u64 = 0xFFFFFC53
  pub let DRV_REG_ENOSPC               : u64 = 0xFFFFFC54
  pub let DRV_REG_WRONG_KIND           : u64 = 0xFFFFFC55
  pub let DRV_REG_ROW_CORRUPT          : u64 = 0xFFFFFC56
  pub let DRV_REG_ROLLBACK_IN_PROGRESS : u64 = 0xFFFFFC57
  pub let DRV_REG_NOT_FOUND            : u64 = 0xFFFFFC58
  pub let DRV_REG_BAD_NAME             : u64 = 0xFFFFFC59
  pub let DRV_REG_BAD_STATE            : u64 = 0xFFFFFC5A
  pub let DRV_REG_ROLLBACK_FORBIDDEN   : u64 = 0xFFFFFC5B
  pub let DRV_REG_NO_STAGED            : u64 = 0xFFFFFC5C
  pub let DRV_REG_TOKEN_EXPIRED        : u64 = 0xFFFFFC5D
  pub let DRV_REG_TEARDOWN_FAIL        : u64 = 0xFFFFFC5E
  pub let DRV_REG_ENOCRYPTO            : u64 = 0xFFFFFC5F

  // Standard dispatch-return sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ============================================================================
  // Backing table (.bss, align 64)
  //
  // 32 slots × 64 bytes = 2048 bytes = 256 u64s. .bss zero-init means
  // every slot starts with status = DRV_STATUS_FREE (byte 0 of the
  // [+0] u64), which is the free sentinel the real `_bind` path will
  // scan for. The manifest and signature regions land with the real
  // bodies in the follow-up slice.
  // ============================================================================

  pub let mut _drv_registry_table : [u64; 256] = uninit @align(64)

  // Monotonic generation counter — bumps on every bind, unbind, commit,
  // abort, and quarantine. Caps carry the generation at mint time;
  // cap_invoke_dispatch compares and fails stale caps with INVOKE_DENIED.
  // Initialized to zero via .bss; the first bind bumps to 1.
  pub let mut _drv_registry_generation : u64 = 0

  // ============================================================================
  // Dispatch-chatter tag (.rodata)
  //
  // Declared in-module (rather than in tags.pdx) for the skeleton wave:
  // the stub body references exactly one tag and declaring it here
  // keeps the skeleton PR self-contained. The follow-up slice relocates
  // this symbol into tags.pdx alongside its siblings and adds the
  // per-event fingerprint tags enumerated in design §6.
  //
  // 26 printable chars + NUL = 27 bytes.
  // ============================================================================

  pub let drv_registry_msg : [u8; 27] = "driver registry invocation\0"

  // ============================================================================
  // driver_registry_bind(manifest_ptr) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - validate manifest_ptr != 0 and 8-byte-aligned -> DRV_REG_BAD_ARG
  //   - driver_sig_verify_algo(ML_DSA_65, manifest_ptr, 256, sig_ptr,
  //     3309, root_pk, 1952) -> SIG_OK (R32+) or SIG_UNSIGNED_SCAFFOLD
  //     (R28..R31); any SIG_BAD_* or SIG_UNVERIFIABLE -> DRV_REG_SIG_FAIL
  //   - BLAKE3-hash the binary; compare against manifest.signed_blake3
  //     -> mismatch -> DRV_REG_HASH_MISMATCH
  //   - name uniqueness scan over _drv_registry_table -> hit -> NAME_IN_USE
  //   - find FREE slot -> none -> DRV_REG_ENOSPC
  //   - fill hot row + manifest + signature regions; compute checksum
  //   - mint KIND_DRIVER cap over the row; target_ptr = row_index
  //   - emit "DRV REG OK name=<..> ver=<..> hash=<16hex>" + "DRV SIG OK"
  //
  // SysV ABI: rdi = manifest_ptr. Returns cap slot on success.
  // ============================================================================

  pub let driver_registry_bind : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (manifest_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D4 (#2521) skeleton: driver_registry_bind entry. Emits klog_s1(INFO=3, SUBSYS_DRV_, drv_registry_msg) chatter so a boot-witness can observe the entry site is wired, and returns INVOKE_UNSUPPORTED (0xFF..FC). Real body deferred to the Wave 59 D4 follow-up slice per design/drivers/registry.md §2.1. Leaf shape: single call klog_s1, immediate rax load, ret. RDI arg (manifest_ptr) is not read after the klog_s1 call in this skeleton — the real body preserves it across the call via rbx. SysV one-arg prologue needs no stack adjustment (rsp%16==8 at entry, we do not call another function after klog_s1). Labels: none; straight-line code.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + drv_registry_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // driver_registry_unbind(cap_slot) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - cap_table[cap_slot].kind == KIND_DRIVER -> else DRV_REG_WRONG_KIND
  //   - fetch row via target_ptr; validate row_checksum
  //     -> mismatch -> DRV_REG_ROW_CORRUPT + quarantine
  //   - row.rollback_token_id != 0 -> DRV_REG_ROLLBACK_IN_PROGRESS
  //   - call teardown_fn(cap_slot); propagate its return
  //   - zero manifest + signature regions for this slot
  //   - row.status = REVOKED; generation++
  //   - emit "DRV UNBIND OK name=<..>"
  //
  // SysV ABI: rdi = cap_slot.
  // ============================================================================

  pub let driver_registry_unbind : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D4 (#2521) skeleton: driver_registry_unbind entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design/drivers/registry.md §2.2. Leaf shape; klog_s1 is the only call.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + drv_registry_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // driver_registry_lookup(name_ptr, name_len) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - name_len == 0 or > 16 -> DRV_REG_BAD_NAME
  //   - exact-name scan over _drv_registry_table, status == BOUND rows only
  //   - prefix matches do NOT hit (exact-name discipline from
  //     registry_lookup.pdx §8.1); the record's byte at [name_len] must
  //     be NUL unless name_len == 16
  //   - miss -> DRV_REG_NOT_FOUND
  //   - hit -> return the KIND_DRIVER cap slot (NOT the row index)
  //
  // SysV ABI: rdi = name_ptr, rsi = name_len.
  // ============================================================================

  pub let driver_registry_lookup : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D4 (#2521) skeleton: driver_registry_lookup entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design/drivers/registry.md §2.3. Reuses the exact-name discipline of registry_lookup.pdx §8.1 — not-found cannot be zero because index 0 is a legitimate hit; the DRV_REG_NOT_FOUND code at 0xFFFFFC58 is far outside the valid index range. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + drv_registry_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // driver_registry_begin_rollback(name_ptr, name_len, target_version) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - _lookup(name) -> DRV_REG_NOT_FOUND if absent
  //   - fetch row; validate checksum
  //   - row.status != BOUND -> DRV_REG_BAD_STATE
  //   - row.rollback_token_id != 0 -> DRV_REG_ROLLBACK_IN_PROGRESS
  //   - manifest.flags.ROLLBACK_ALLOWED == 0 -> DRV_REG_ROLLBACK_FORBIDDEN
  //   - locate staged version in attic (deferred: returns DRV_REG_NO_STAGED
  //     until Wave 60+ attic lands)
  //   - verify staged manifest's signature (bind-gate equivalent)
  //   - mint KIND_ROLLBACK_TOKEN cap; target_ptr = {row_index[15:0],
  //     staged_version[47:16]}; row.rollback_token_id = cap's generation
  //   - row.status = ROLLBACK_PENDING
  //   - emit "DRV ROLLBACK BEGIN name=<..> staged_ver=<..>"
  //
  // SysV ABI: rdi = name_ptr, rsi = name_len, rdx = target_version
  // (packed major16/minor16/patch16/_16).
  // ============================================================================

  pub let driver_registry_begin_rollback : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (name_ptr: u64) (name_len: u64) (target_version: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D4 (#2521) skeleton: driver_registry_begin_rollback entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design/drivers/registry.md §2.4. Two-phase rollback discipline — the staged version is named here but not yet applied; _commit_rollback consumes the minted token. Leaf shape; no stack spill despite three-arg signature (SysV passes all three in rdi/rsi/rdx and we read none after klog_s1).",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + drv_registry_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // driver_registry_commit_rollback(token_cap_slot) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - cap_table[token_cap_slot].kind == KIND_ROLLBACK_TOKEN
  //     -> else DRV_REG_WRONG_KIND
  //   - rights gate R_ROLLBACK_COMMIT -> else INVOKE_DENIED
  //   - fetch row from target_ptr; validate checksum; verify
  //     row.rollback_token_id matches cap's generation
  //   - call current driver's teardown_fn
  //   - swap manifest + signature regions to staged version
  //   - re-run §5 signature gate against staged manifest (defense in
  //     depth: the attic may have been mutated since _begin_rollback)
  //   - refill hot row; clear rollback_token_id; generation++; status=BOUND
  //   - revoke the rollback token cap (consumed)
  //   - emit "DRV ROLLBACK COMMIT name=<..> old_ver=<..> new_ver=<..>"
  //
  // SysV ABI: rdi = token_cap_slot.
  // ============================================================================

  pub let driver_registry_commit_rollback : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (token_cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D4 (#2521) skeleton: driver_registry_commit_rollback entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design/drivers/registry.md §2.5. The sibling driver_registry_abort_rollback is a trivial variant (same cap validation, no swap, same generation bump) that lands with commit's real body — it is NOT one of the five entrypoints this skeleton PR declares. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + drv_registry_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }
}
