// src/kernel/core/svc/shell_history.pdx -- Wave UMB-W15 R127.M4
// paideia-os #2600
//
// SHELL HISTORY STORAGE SUBSTRATE
// =============================================================================
//
// R127 ("REPL session process + history storage") milestone M4. M1
// landed the daemon that owns the shell_session row pool (and reserved
// history_head / history_tail fields at [+24] / [+32]).  M2 added the
// KIND_SHELL_SESSION cap-invoke surface.  M3 added the raw-mode TTY
// substrate.  M4 lands the HISTORY STORAGE SUBSTRATE: a bounded,
// in-kernel ring of command strings keyed by session_id, populated
// as the shell parent dispatches commands.
//
// The ring is a pure library.  No endpoint is claimed; the direct-
// call API is the in-kernel surface.  R127.M5 (job control + shell
// parent dispatch loop) is the first wave with a production caller
// that drives APPEND / READ end-to-end.  M4 adds only the INIT boot
// fingerprint to the smoke-mode wire; APPEND / READ paths are
// present-but-unreached at M4 and allowlisted upstream.
//
// =============================================================================
// SECTION 1  GEOMETRY  --  128 KiB BACKING, 8 SESSIONS, 128 ENTRIES
// =============================================================================
//
//   per-entry stride  = 128 bytes                            (shl 7)
//   per-session ring  = 128 entries x 128 bytes = 16 KiB     (shl 14)
//   pool              = 8 sessions x 16 KiB    = 128 KiB
//
// Backing storage: _shell_history_rings : [u8; 131072] in .bss,
// @align(64) so the first ring (session 0) sits on a cache-line
// boundary and session N's ring starts at (N << 14) from the pool
// base -- no `imul r, imm` is ever needed to address a slot.
//
// Entry layout:
//
//   [+0]   len         (u16)   bytes-to-read in cmd_bytes (0..126)
//   [+2]   cmd_bytes   [u8; 126]  the command text (ASCII; terminator
//                                 is NOT stored -- len is authoritative)
//
// =============================================================================
// SECTION 2  SEMANTICS  --  MONOTONIC head/tail WITH EVICTION
// =============================================================================
//
// history_head and history_tail on the shell_session row are u64
// monotonic counters.  They NEVER wrap in realistic lifetime (2^64
// ops at 1 GHz = 584 years).  Slot indices are the low 7 bits.
//
//   write_slot = history_head & 0x7F
//   read_slot(i_from_head) = (history_head - 1 - i) & 0x7F
//
//   count = history_head - history_tail      // invariant: in [0, 128]
//
// Append:
//
//   entry[write_slot] <- {len, cmd}
//   history_head += 1
//   if (history_head - history_tail) > 128:
//       history_tail = history_head - 128    // evict oldest
//
// After the first eviction the ring holds exactly 128 entries;
// count saturates at 128.
//
// Truncation: a cmd_len > 126 is clamped at mint time.  The stored
// entry has len = 126, cmd_bytes[0..123] = first 123 bytes of input,
// cmd_bytes[123..126] = "..." (three ASCII 0x2E bytes) so the three
// trailing dots are the audit signal that truncation happened.
//
// =============================================================================
// SECTION 3  RETURN CODE BAND  --  0x1106 ONWARDS
// =============================================================================
//
//   SH_OK                = 0
//   SH_ERR_BAD_SESSION   = reuse SS_ERR_BAD_ID = 0x1102
//   SH_ERR_OUT_TOO_SMALL = 0x1106
//   SH_ERR_EMPTY         = 0x1107
//
// Band audit (2026-10-13):
//   `grep -rnE '0x110[6-7]\b' src/kernel/` -> zero hits.  Clean band;
// R127.M5+ may extend to 0x1108..0x110F while retaining the first
// two SH_* as pinned.
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the
// 7-byte zero-extending form.
//
// _shell_history_read returns a PACKED u64:
//
//   result = (bytes_written << 32) | status
//
// On success status == SH_OK (0), so result == bytes_written << 32
// and the caller recovers bytes_written by right-shifting 32 bits.
// bytes_written is in [0, 126], so bytes_written << 32 lies in
// [0, 126 << 32) -- disjoint from every SH_ERR_* value so a caller
// that treats the whole u64 as an error-or-length tagged value never
// collides.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Labels are prefixed `sh_` (shell-history) to stay clear of `ss_`
// (ipc/shell_session) and `svc_` (ipc/svc_broker).  Encoder-pitfall
// posture (feedback_pdx_encoder_pitfalls):
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 7            (entry-stride compose)
//   * shl rN, 14           (ring-base compose; 14 fits imm8)
//   * and rN, 0x7F         (slot-index mask; fits imm32)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * mov_w rax, [addr]    (proven in src/kernel/acpi/mcfg.pdx)
//   * mov_b [reg + reg*1], reg  (proven in shell_session.pdx name copy)
//   * single-line `pub let name = "..."`
//   * module basename ShellHistory matches file basename shell_history.pdx
//   * fingerprint [u8; N] with N = len(string) + 1 (NUL counts)
//
// Stack discipline (SysV, entry rsp%16==8):
//   _shell_history_init         1 push (r12 across the klog call)
//   _shell_history_count        1 push (rbx = session_id)
//   _shell_history_append       5 pushes + sub rsp, 16
//                                 (stack-arg slot for klog_s1_x1_d1)
//   _shell_history_read         5 pushes + sub rsp, 16
//
// =============================================================================
// SECTION 5  BOOT WIRING
// =============================================================================
//
// kernel_main.pdx picks this up with ONE new call right after
// _shell_session_init (R127.M1):
//
//   call _shell_session_init;        // ENDPOINT 21, R127.M1
//   call _shell_history_init;        // R127.M4 (this file)
//   call witness_r30_platform;       // R30 platform witness cascade
//
// Placement rationale: _shell_history_init MUST follow _shell_session_
// init so an audit grep sees the two substrate fingerprints
// (SHELL_SESSION INIT OK -> SHELL_HISTORY INIT OK) in subsystem order.
//
// =============================================================================

module ShellHistory = structure {

  // ==========================================================================
  // Return band (§3)
  // ==========================================================================

  pub let SH_OK                : u64 = 0
  pub let SH_ERR_BAD_SESSION   : u64 = 0x1102    // alias SS_ERR_BAD_ID
  pub let SH_ERR_OUT_TOO_SMALL : u64 = 0x1106
  pub let SH_ERR_EMPTY         : u64 = 0x1107

  // ==========================================================================
  // Pool geometry (§1)
  // ==========================================================================

  pub let SH_RING_ENTRIES      : u64 = 128       // per session
  pub let SH_ENTRY_BYTES       : u64 = 128       // u16 len + 126 bytes
  pub let SH_RING_BYTES        : u64 = 16384     // 128 * 128 = 16 KiB
  pub let SH_POOL_BYTES        : u64 = 131072    // 8 * 16384 = 128 KiB
  pub let SH_SLOT_MASK         : u64 = 0x7F      // (head) & 0x7F
  pub let SH_CMD_MAX           : u64 = 126       // body bytes per entry
  pub let SH_CMD_HEAD          : u64 = 123       // bytes kept on truncation
  pub let SH_ENTRY_BODY_OFF    : u64 = 2         // cmd_bytes starts here

  // Shell-session row-field offsets (mirror svc/shell_session.pdx §1).
  pub let SH_ROW_OFF_HIST_HEAD : u64 = 24
  pub let SH_ROW_OFF_HIST_TAIL : u64 = 32

  // ==========================================================================
  // Storage
  //
  //   _shell_history_rings  -- 128 KiB backing. @align(64) puts the
  //                            first ring on a cache-line boundary;
  //                            per-session ring base = pool + (sid << 14).
  //   _shell_history_stats  -- 14 u64 counters (observability).
  // ==========================================================================

  pub let mut _shell_history_rings : [u8;  131072] = uninit @align(64)
  pub let mut _shell_history_stats : [u64; 14]     = uninit @align(64)

  pub let SH_ST_INIT_OK       : u64 = 0
  pub let SH_ST_APPEND_OK     : u64 = 1
  pub let SH_ST_APPEND_REJ    : u64 = 2
  pub let SH_ST_APPEND_TRUNC  : u64 = 3
  pub let SH_ST_READ_OK       : u64 = 4
  pub let SH_ST_READ_REJ      : u64 = 5
  pub let SH_ST_READ_EMPTY    : u64 = 6
  pub let SH_ST_COUNT_OK      : u64 = 7
  pub let SH_ST_COUNT_REJ     : u64 = 8
  pub let SH_ST_EVICT         : u64 = 9

  // ==========================================================================
  // Fingerprint tags (N = len(string) + 1, NUL inclusive).
  //
  // Only the "OK" tags are extracted by the fingerprint-coverage gate;
  // the REJ tags are opaque to the gate so no allowlist entry is
  // required for them.
  // ==========================================================================

  // "SHELL_HISTORY INIT OK"   = 21 chars + NUL => N = 22
  // "SHELL_HISTORY APPEND OK" = 23 chars + NUL => N = 24
  // "SHELL_HISTORY APPEND REJ"= 24 chars + NUL => N = 25
  // "SHELL_HISTORY READ OK"   = 21 chars + NUL => N = 22
  // "SHELL_HISTORY READ REJ"  = 22 chars + NUL => N = 23

  pub let sh_tag_init_ok     : [u8; 22] = "SHELL_HISTORY INIT OK\0"
  pub let sh_tag_append_ok   : [u8; 24] = "SHELL_HISTORY APPEND OK\0"
  pub let sh_tag_append_rej  : [u8; 25] = "SHELL_HISTORY APPEND REJ\0"
  pub let sh_tag_read_ok     : [u8; 22] = "SHELL_HISTORY READ OK\0"
  pub let sh_tag_read_rej    : [u8; 23] = "SHELL_HISTORY READ REJ\0"

  pub let sh_k_sid    : [u8; 4] = "sid\0"
  pub let sh_k_len    : [u8; 4] = "len\0"
  pub let sh_k_errno  : [u8; 6] = "errno\0"

  // ==========================================================================
  // sh_note(slot) -> ()
  //
  // Bounded increment on _shell_history_stats[slot]. Load-inc-store
  // idiom (no `add reg, [mem]`). Caller passes an SH_ST_* ordinal;
  // the bounds check guards against the stats pool size (14). Pure
  // leaf -- no pushes.
  // ==========================================================================
  pub let sh_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R127.M4 (paideia-os #2600): bounded increment on _shell_history_stats[slot<14]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed sh_no_.",
      block: {
        cmp rdi, 14;
        jae sh_no_out;
        lea r10, [rip + _shell_history_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sh_no_out:
        ret
      }
    }

  // ==========================================================================
  // sh_row_base(session_id) -> &_shell_session_pool[session_id * 128]
  //
  // Row index -> row base pointer. Stride 128 = 2^7 so `shl rax, 7`
  // suffices (no `imul r, imm` encoder gap). Caller is responsible
  // for validating session_id < SS_POOL_MAX = 8 first; this helper
  // is a pure address compute. Mirrors ss_row_base one-for-one but
  // kept local to shell_history so the module stands on its own.
  // ==========================================================================
  pub let sh_row_base : (u64) -> u64 !{} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R127.M4 (paideia-os #2600): session_id -> &_shell_session_pool[session_id*128]. Power-of-two stride uses `shl rax, 7` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates via ss_row_in_use. Labels prefixed sh_rb_.",
      block: {
        mov rax, rdi;
        shl rax, 7;
        lea r10, [rip + _shell_session_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // sh_ring_entry_base(session_id, slot_index) -> &entry
  //
  // Pure address compute. ring_base = pool + (sid << 14); entry =
  // ring_base + (slot_index << 7). Caller is responsible for keeping
  // session_id < 8 and slot_index < 128 so the resulting pointer
  // lands inside _shell_history_rings; shell_history always masks
  // slot_index with SH_SLOT_MASK (0x7F) before entering here.
  // ==========================================================================
  pub let sh_ring_entry_base : (u64, u64) -> u64 !{} @{} =
    fn (session_id: u64) (slot_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R127.M4 (paideia-os #2600): &_shell_history_rings[sid*16384 + slot*128]. Composed as (sid << 14) + (slot << 7). Both shifts fit imm8 and both strides are powers of two so no 2-op imul-with-imm is required. Pure leaf. Labels prefixed sh_re_.",
      block: {
        mov rax, rdi;                    // session_id
        shl rax, 14;                     // sid * 16384
        mov r10, rsi;                    // slot_index
        shl r10, 7;                      // slot * 128
        add rax, r10;                    // sid * 16384 + slot * 128
        lea r10, [rip + _shell_history_rings];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // _shell_history_init() -> ()
  //
  // Boot hook. Defensive scrub of _shell_history_stats (14 u64 = 112
  // bytes). .bss zero-init handles the array at real boot; the
  // explicit scrub is defensive for a chaos-restart re-entering init.
  // Emits `SHELL_HISTORY INIT OK` on completion.
  //
  // Single callee-save push (r12) corrects entry parity rsp%16==8 ->
  // 0 for the sibling klog_s1 call, matching kind_shell_session_init
  // shape.
  //
  // Note: _shell_history_rings is NOT scrubbed here -- a 128 KiB
  // zero-fill at boot is wasted work (bss is already zero), and the
  // entries are gated by the history_head / history_tail counters
  // on each shell_session row which are themselves zero at mint
  // (R127.M1 _shell_session_create). So a stale ring entry is
  // unreachable via the public API even on chaos restart.
  //
  // Labels prefixed sh_in_.
  // ==========================================================================
  pub let _shell_history_init : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): boot-time scrub of _shell_history_stats (14 u64 = 112 bytes) + one INIT OK fingerprint. .bss zero-init handles the array at real boot; the explicit scrub is defensive for a chaos-restart re-entering init. The 128 KiB _shell_history_rings backing is NOT scrubbed because the counters on each shell_session row (history_head / history_tail at [+24] / [+32]) gate reach to any entry; a stale entry is unreachable. Single callee-save push (r12) corrects entry parity rsp%16==8 -> 0 for the sibling klog_s1 call, matching kind_shell_session_init shape. Labels prefixed sh_in_.",
      block: {
        push r12;

        // Scrub _shell_history_stats[0..14].
        lea r10, [rip + _shell_history_stats];
        xor rax, rax;
        xor rcx, rcx;
      sh_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 14;
        jb  sh_in_stats;

        // Bump INIT_OK counter.
        mov rdi, 0;                      // SH_ST_INIT_OK
        call sh_note;

        // Emit INIT OK fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_init_ok];
        call klog_s1;

        pop r12;
        ret
      }
    }

  // ==========================================================================
  // _shell_history_append(session_id, cmd_ptr, cmd_len) -> errno
  //
  // Validate session_id (SH_ERR_BAD_SESSION on bad / free row). Load
  // history_head / history_tail from [row+24] / [row+32]. Clamp
  // cmd_len to 126; on truncation also writes cmd_bytes[123..126] =
  // "..." as the audit signal. Byte-copies into the ring entry at
  // (head & 0x7F) within the per-session ring, bumps history_head,
  // and if (new_head - history_tail) > 128 advances history_tail to
  // keep the invariant. Writes both counters back. Emits
  // `SHELL_HISTORY APPEND OK sid=0x<hex> len=<dec>`.
  //
  // ARGS (SysV):
  //   rdi = session_id
  //   rsi = cmd_ptr   (readable up to cmd_len bytes; pointer safety
  //                    deferred to R128 ring-3 syscall gate -- M4 is
  //                    supervisor-reach only)
  //   rdx = cmd_len   (clamped to SH_CMD_MAX = 126)
  //
  // RETURNS (rax):
  //   SH_OK                -- entry written
  //   SH_ERR_BAD_SESSION   -- session_id out of range or row not in use
  //
  // STACK FRAME:
  //   5 callee-save pushes (rbx = session_id, r12 = cmd_ptr,
  //   r13 = clamped_len, r14 = row_base, r15 = history_head) +
  //   sub rsp, 16 (8-byte stack-arg slot for klog_s1_x1_d1 + 8-byte
  //   pad). Entry rsp%16==8; +5 pushes + 16 = +56 -> %16==0 at every
  //   nested call.
  //
  // Labels prefixed sh_ap_.
  // ==========================================================================
  pub let _shell_history_append : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (cmd_ptr: u64) (cmd_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): append one command to the per-session ring. Validate session_id via ss_row_in_use (else SH_ERR_BAD_SESSION). Load history_head / history_tail from shell_session row at [+24] / [+32]. Clamp cmd_len to SH_CMD_MAX = 126; if the input was longer bump SH_ST_APPEND_TRUNC and queue a `...` write at cmd_bytes[123..126] after the main byte copy. Compute entry base = _shell_history_rings + (sid << 14) + ((head & 0x7F) << 7); write len (u16) at [entry+0] via mov_w; byte-copy clamped_len bytes from cmd_ptr to [entry+2+i] via proven mov_b scalar-indexed form. If truncation flagged, overwrite cmd_bytes[123..126] with 0x2E (ASCII '.'). Bump history_head by 1; if (new_head - history_tail) > 128 set history_tail = new_head - 128 (eviction) and bump SH_ST_EVICT. Write head and tail back to [row+24] / [row+32]. Bump SH_ST_APPEND_OK and emit `SHELL_HISTORY APPEND OK sid=0x<hex> len=<dec>` via klog_s1_x1_d1 (6-reg + 1-stack-arg wrapper, len on [rsp+0]). Five callee-save pushes (rbx=session_id, r12=cmd_ptr, r13=clamped_len, r14=row_base, r15=history_head) + sub rsp,16 pad = 56 bytes land rsp%16==0 at every nested call. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,7 / shl rN,14 for stride compose (never imul), mov rax,imm32 for all error codes (never and r11,imm64), mov_w for the u16 len store, mov_b scalar-indexed for the byte copy. Labels prefixed sh_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                     // stack-arg slot + pad

        mov rbx, rdi;                    // session_id
        mov r12, rsi;                    // cmd_ptr
        mov r13, rdx;                    // cmd_len (unclamped)

        // ---- Validate session_id ----
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  sh_ap_bad_id;

        // ---- Clamp cmd_len to SH_CMD_MAX = 126 ----
        // Also detect truncation (track in r9 scratch so we can bump
        // SH_ST_APPEND_TRUNC later; we don't need a callee-save for
        // this because we won't call anything between here and the
        // truncation-tail write that could clobber it; use a stack
        // slot at [rsp+8] (the pad slot) as persistent storage).
        xor r9, r9;                      // truncated flag = 0
        mov [rsp + 8], r9;               // persist in pad slot
        mov r10, 126;                    // SH_CMD_MAX
        cmp r13, r10;
        jbe sh_ap_len_ok;
        // Truncated: clamp len to 126 and remember.
        mov r13, r10;                    // clamped_len = 126
        mov r9, 1;
        mov [rsp + 8], r9;               // truncated = 1
      sh_ap_len_ok:

        // ---- Compute row base and load head / tail ----
        //   row_base = _shell_session_pool + (sid << 7)
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _shell_session_pool];
        add rax, r10;
        mov r14, rax;                    // r14 = row_base

        mov r15, [r14 + 24];             // r15 = history_head

        // ---- Compute entry base ----
        //   entry_base = _shell_history_rings + (sid << 14) +
        //                ((head & 0x7F) << 7)
        mov rax, rbx;
        shl rax, 14;                     // sid * 16384
        mov r10, r15;
        and r10, 0x7F;                   // slot_index
        shl r10, 7;                      // slot * 128
        add rax, r10;                    // sid*16384 + slot*128
        lea r10, [rip + _shell_history_rings];
        add rax, r10;
        // rax = entry_base; park it in r10 for the copy below.
        mov r10, rax;

        // ---- Write len (u16) at [entry_base + 0] ----
        mov rax, r13;                    // clamped_len
        mov_w [r10 + 0], rax;

        // ---- Byte-copy clamped_len bytes from cmd_ptr to [entry+2+i] ----
        // Pre-advance destination pointer by SH_ENTRY_BODY_OFF (2) to
        // sidestep the `mov_b [reg + reg*1 + off], reg` encoder gap
        // (see shell_session.pdx _shell_session_create name copy).
        mov r11, r10;                    // r11 = &entry + 0
        add r11, 2;                      // r11 = &entry.cmd_bytes[0]

        // Determine actual copy count: if truncated, copy 123 bytes
        // of the input; else copy clamped_len bytes.
        mov rcx, r13;                    // default copy_count = clamped_len
        mov r9, [rsp + 8];               // truncated flag
        cmp r9, 0;
        je  sh_ap_copy_setup;
        mov rcx, 123;                    // SH_CMD_HEAD on truncation
      sh_ap_copy_setup:
        // r_copy_count now in rcx; we loop i = 0 .. rcx; keep in r9.
        mov r9, rcx;                     // r9 = copy_count (bound)
        xor rcx, rcx;                    // i = 0
      sh_ap_copy_loop:
        cmp rcx, r9;
        jae sh_ap_copy_done;
        xor rax, rax;
        mov_b rax, [r12 + rcx * 1];
        mov_b [r11 + rcx * 1], rax;
        add rcx, 1;
        jmp sh_ap_copy_loop;
      sh_ap_copy_done:

        // ---- On truncation, overwrite cmd_bytes[123..126] = "..." ----
        mov r9, [rsp + 8];               // truncated flag
        cmp r9, 0;
        je  sh_ap_no_ellipsis;
        mov rax, 0x2E;                   // '.'
        mov_b [r11 + 123], rax;
        mov_b [r11 + 124], rax;
        mov_b [r11 + 125], rax;
        // Bump truncation counter.
        mov rdi, 3;                      // SH_ST_APPEND_TRUNC
        call sh_note;
      sh_ap_no_ellipsis:

        // ---- Advance history_head ----
        add r15, 1;                      // new_head = old_head + 1
        mov [r14 + 24], r15;             // write head back

        // ---- Eviction: if (new_head - tail) > 128, tail = new_head - 128 ----
        mov r10, [r14 + 32];             // r10 = tail
        mov r11, r15;
        sub r11, r10;                    // r11 = new_head - tail
        cmp r11, 128;
        jbe sh_ap_no_evict;
        mov r11, r15;
        sub r11, 128;                    // new_tail = new_head - 128
        mov [r14 + 32], r11;
        mov rdi, 9;                      // SH_ST_EVICT
        call sh_note;
      sh_ap_no_evict:

        // ---- Stats + fingerprint ----
        mov rdi, 1;                      // SH_ST_APPEND_OK
        call sh_note;

        // klog_s1_x1_d1 (6 regs + 1 stack arg). Stack arg slot is
        // the [rsp+0] 8-byte we reserved on entry; write len there
        // and call. (sid in hex via r8, len in dec via [rsp+0].)
        mov [rsp + 0], r13;              // v_dec = clamped_len
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_append_ok];
        lea rcx, [rip + sh_k_sid];
        mov r8,  rbx;                    // v_hex = session_id
        lea r9,  [rip + sh_k_len];
        call klog_s1_x1_d1;

        xor rax, rax;                    // SH_OK
        jmp sh_ap_out;

      sh_ap_bad_id:
        mov rdi, 2;                      // SH_ST_APPEND_REJ
        call sh_note;

        mov r12, 0x1102;                 // SH_ERR_BAD_SESSION

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_append_rej];
        lea rcx, [rip + sh_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;

      sh_ap_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _shell_history_read(session_id, index_from_head, out_ptr, out_cap)
  //                                                           -> packed u64
  //
  // Validate session_id (SH_ERR_BAD_SESSION on bad / free row). Compute
  // count = history_head - history_tail; if index_from_head >= count
  // return SH_ERR_EMPTY. Compute read_slot = (history_head - 1 -
  // index_from_head) & 0x7F. Load len (u16) at [entry+0]. If len >
  // out_cap return SH_ERR_OUT_TOO_SMALL. Byte-copy len bytes from
  // [entry+2] to out_ptr. Return packed (len << 32) | SH_OK.
  //
  // ARGS (SysV):
  //   rdi = session_id
  //   rsi = index_from_head  (0 = most-recent, count-1 = oldest live)
  //   rdx = out_ptr          (writable up to out_cap bytes)
  //   rcx = out_cap          (bytes available at out_ptr)
  //
  // RETURNS (rax):
  //   Packed on success: (bytes_written << 32) | SH_OK, i.e.
  //       result == bytes_written << 32  (status bits are zero)
  //   SH_ERR_BAD_SESSION    -- bad session_id
  //   SH_ERR_EMPTY          -- index_from_head >= count
  //   SH_ERR_OUT_TOO_SMALL  -- len > out_cap
  //
  // STACK FRAME:
  //   5 callee-save pushes (rbx = session_id, r12 = index_from_head,
  //   r13 = out_ptr, r14 = out_cap, r15 = entry_len) + sub rsp, 16
  //   (8-byte stack-arg slot for klog_s1_x1_d1 + 8-byte pad). Entry
  //   rsp%16==8; +5 pushes + 16 = +56 -> %16==0 at every nested call.
  //
  // Labels prefixed sh_rd_.
  // ==========================================================================
  pub let _shell_history_read : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (index_from_head: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): read the i-th most-recent command from the ring. Validate session_id via ss_row_in_use (else SH_ERR_BAD_SESSION). Load history_head / history_tail from shell_session row at [+24] / [+32]; compute count = head - tail. If index_from_head >= count return SH_ERR_EMPTY. Compute read_slot = (head - 1 - index) & 0x7F; entry_base = _shell_history_rings + (sid << 14) + (slot << 7). Load len (u16) via mov_w; if len > out_cap return SH_ERR_OUT_TOO_SMALL. Byte-copy len bytes from [entry+2+i] to [out_ptr+i] via proven mov_b scalar-indexed form. Bump SH_ST_READ_OK and emit `SHELL_HISTORY READ OK sid=0x<hex> len=<dec>` via klog_s1_x1_d1 (6-reg + 1-stack-arg wrapper, len on [rsp+0]). Return packed (len << 32) | SH_OK. Five callee-save pushes (rbx=session_id, r12=index_from_head, r13=out_ptr, r14=out_cap, r15=entry_len) + sub rsp,16 pad = 56 bytes land rsp%16==0 at every nested call. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,7 / shl rN,14 for stride compose (never imul), mov rax,imm32 for all error codes (never and r11,imm64), mov_w for the u16 len load, mov_b scalar-indexed for the byte copy. Labels prefixed sh_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                     // stack-arg slot + pad

        mov rbx, rdi;                    // session_id
        mov r12, rsi;                    // index_from_head
        mov r13, rdx;                    // out_ptr
        mov r14, rcx;                    // out_cap

        // ---- Validate session_id ----
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  sh_rd_bad_id;

        // ---- Compute row base; load head / tail ----
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _shell_session_pool];
        add rax, r10;
        // rax = row_base
        mov r11, [rax + 24];             // r11 = history_head
        mov r10, [rax + 32];             // r10 = history_tail

        // count = head - tail
        mov r9, r11;
        sub r9, r10;                     // r9 = count

        // If index_from_head >= count -> SH_ERR_EMPTY.
        cmp r12, r9;
        jae sh_rd_empty;

        // ---- Compute read_slot = (head - 1 - index) & 0x7F ----
        //   r11 = head; subtract 1; subtract index; mask low 7 bits.
        sub r11, 1;
        sub r11, r12;                    // r11 = head - 1 - index
        and r11, 0x7F;                   // r11 = slot_index

        // ---- Compute entry base ----
        //   entry_base = _shell_history_rings + (sid << 14) +
        //                (slot << 7)
        mov rax, rbx;
        shl rax, 14;                     // sid * 16384
        mov r10, r11;
        shl r10, 7;                      // slot * 128
        add rax, r10;
        lea r10, [rip + _shell_history_rings];
        add rax, r10;
        // rax = entry_base; park it in r11 for the loads below.
        mov r11, rax;

        // ---- Load len (u16) at [entry+0] ----
        xor rax, rax;
        mov_w rax, [r11 + 0];
        mov r15, rax;                    // r15 = len

        // ---- out_cap check ----
        cmp r15, r14;
        ja  sh_rd_too_small;

        // ---- Byte-copy len bytes from [entry+2+i] to [out_ptr+i] ----
        // Pre-advance src pointer past the 2-byte len header.
        mov r10, r11;
        add r10, 2;                      // r10 = &entry.cmd_bytes[0]

        xor rcx, rcx;                    // i = 0
      sh_rd_copy_loop:
        cmp rcx, r15;
        jae sh_rd_copy_done;
        xor rax, rax;
        mov_b rax, [r10 + rcx * 1];
        mov_b [r13 + rcx * 1], rax;
        add rcx, 1;
        jmp sh_rd_copy_loop;
      sh_rd_copy_done:

        // ---- Stats + fingerprint ----
        mov rdi, 4;                      // SH_ST_READ_OK
        call sh_note;

        // klog_s1_x1_d1 (6 regs + 1 stack arg).
        mov [rsp + 0], r15;              // v_dec = len
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_read_ok];
        lea rcx, [rip + sh_k_sid];
        mov r8,  rbx;                    // v_hex = session_id
        lea r9,  [rip + sh_k_len];
        call klog_s1_x1_d1;

        // ---- Pack return: (len << 32) | SH_OK ----
        mov rax, r15;
        shl rax, 32;
        jmp sh_rd_out;

      sh_rd_bad_id:
        mov rdi, 5;                      // SH_ST_READ_REJ
        call sh_note;

        mov r12, 0x1102;                 // SH_ERR_BAD_SESSION

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_read_rej];
        lea rcx, [rip + sh_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        jmp sh_rd_out;

      sh_rd_empty:
        mov rdi, 6;                      // SH_ST_READ_EMPTY
        call sh_note;
        mov rdi, 5;                      // SH_ST_READ_REJ
        call sh_note;

        mov r12, 0x1107;                 // SH_ERR_EMPTY

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_read_rej];
        lea rcx, [rip + sh_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        jmp sh_rd_out;

      sh_rd_too_small:
        mov rdi, 5;                      // SH_ST_READ_REJ
        call sh_note;

        mov r12, 0x1106;                 // SH_ERR_OUT_TOO_SMALL

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_USER];
        lea rdx, [rip + sh_tag_read_rej];
        lea rcx, [rip + sh_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;

      sh_rd_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _shell_history_count(session_id) -> count (0..128)
  //
  // Pure read. Validate session_id via ss_row_in_use; on invalid
  // return 0 (a dropped session's count is zero, which is a safe
  // sentinel because a caller that reaches COUNT on a bad sid would
  // also fail on APPEND / READ with SH_ERR_BAD_SESSION). Load
  // history_head and history_tail; return head - tail.
  //
  // Invariant on live rows: 0 <= head - tail <= 128. Count saturates
  // at 128 after the first eviction.
  //
  // ARGS (SysV):
  //   rdi = session_id
  //
  // RETURNS (rax):
  //   count in [0, 128]   -- live row
  //   0                    -- session_id out of range or row free
  //
  // STACK FRAME:
  //   1 callee-save push (rbx = session_id). Entry rsp%16==8; +1 push
  //   -> %16==0 at the ss_row_in_use + sh_note nested calls.
  //
  // Labels prefixed sh_ct_.
  // ==========================================================================
  pub let _shell_history_count : (u64) -> u64 !{mem} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): return the live count = history_head - history_tail on the shell_session row. Validate session_id via ss_row_in_use (else return 0). Pure reader -- no fingerprint; bumps SH_ST_COUNT_OK or SH_ST_COUNT_REJ for observability. Single callee-save push (rbx = session_id) corrects entry parity rsp%16==8 -> 0 for the two nested calls. Labels prefixed sh_ct_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // session_id

        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  sh_ct_bad;

        // Compute row base.
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _shell_session_pool];
        add rax, r10;

        // count = head - tail.
        mov r11, [rax + 24];             // r11 = head
        mov r10, [rax + 32];             // r10 = tail
        sub r11, r10;                    // r11 = count

        mov rdi, 7;                      // SH_ST_COUNT_OK
        call sh_note;

        mov rax, r11;
        pop rbx;
        ret;

      sh_ct_bad:
        mov rdi, 8;                      // SH_ST_COUNT_REJ
        call sh_note;
        xor rax, rax;                    // 0 count on bad sid
        pop rbx;
        ret
      }
    }

}
