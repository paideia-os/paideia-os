// src/kernel/core/svc/federation_discovery.pdx -- Wave UMB-W21 R137.M3
// paideia-os #2635
//
// SVC.FEDERATION-DISCOVERY: PEER DISCOVERY VIA FEDERATION CAP
// =============================================================================
//
// R137 ("cross-host pipeline transport") milestone M3.  M3 lands the
// IN-KERNEL federation registry that identifies trust boundaries
// ("federations") and enumerates the reachable peers belonging to each
// one.  A FEDERATION is a NAMED TRUST SET -- the opaque trust-boundary
// over which the R137.M2 hybrid-KEM handshake is allowed to proceed.
// A PEER is a (remote_ip, remote_port, name) tuple registered against
// a federation.
//
// The federation registry is NOT a routing table.  It does not know
// which network the peer is reachable on, nor which link to use.  It
// is the AUTHORISATION tier that the R137.M2 handshake consults BEFORE
// it starts a ML-KEM-768 Encaps against an unknown ek: a handshake may
// only proceed against a peer registered to the federation that minted
// the invoking cap.
//
// Service name:    (none at M3; direct-call API only)
// Endpoint id:     (none at M3; a cap_invoke dispatch surface + broker
//                   row land with R137.M5 KIND_FEDERATION kind
//                   registration)
// Direct API:      _fd_init
//                  _fd_federation_register
//                  _fd_peer_register
//                  _fd_peer_lookup
//                  _fd_peer_list
//
// =============================================================================
// SECTION 0  WHY A DEDICATED REGISTRY INSTEAD OF A TASK FIELD
// =============================================================================
//
// A federation is an authority that outlives any single task.  Pinning
// the federation set to a task struct would (a) duplicate the whole
// peer list across every task carrying the capability, and (b) risk
// trust-set drift across the fork/exec boundary.  A kernel-global
// registry keyed by `fed_id` keeps the set canonical and lets a cap-
// invoke dispatcher (R137.M5) resolve the authority once and consult
// it on every peer_lookup from any invoker.
//
// Shape mirrors `svc.remote-shell` (R137.M1, remote_shell.pdx) and
// `svc.jail-supervisor` (R135.M1) one-for-one in its storage posture:
// a fixed-size row pool with .bss zero-init as the FREE sentinel and
// a linear-scan find-free.  The M3 posture is INTENTIONALLY LEAN: no
// broker row, no cap-invoke dispatch, no endpoint claim.  Those lift
// into R137.M5 when the KIND_FEDERATION kind registers.
//
// =============================================================================
// SECTION 1  ROW LAYOUT  --  TWO POOLS, 64 BYTES PER ROW
// =============================================================================
//
// FEDERATION POOL -- 8 rows x 64 bytes = 512 bytes
// -------------------------------------------------
//
// Logical fields per federation (task directive):
//
//   fed_id       : u32   -- caller-chosen identifier; MUST be nonzero
//                           (0 is the FREE sentinel for .bss zero-init)
//   flags        : u32   -- reserved for R137.M5 (bit 0 = "cap minted")
//   peer_count   : u32   -- number of registered peers in this
//                           federation's slot (invariant: < 8)
//   reserved     : u32   -- reserved
//   name         : [u8; 48]  -- human-readable federation name; last
//                           byte reserved for trailing NUL (max 47
//                           usable)
//
// Packed storage (all u64 lanes):
//
//   [+0]   fed_hdr0  (u64) = fed_id (low 32) | flags (high 32)
//                           A single u64 store captures the FREE/LIVE
//                           sentinel and the flag word.  fed_id==0 is
//                           the FREE sentinel for .bss zero-init.
//
//   [+8]   fed_hdr1  (u64) = peer_count (low 32) | reserved (high 32)
//                           peer_count MUST stay < 8; _fd_peer_register
//                           enforces.
//
//   [+16]  name[ 0.. 7]  (u64 word; 8 bytes of name)
//   [+24]  name[ 8..15]
//   [+32]  name[16..23]
//   [+40]  name[24..31]
//   [+48]  name[32..39]
//   [+56]  name[40..47]  (last byte is reserved for trailing NUL;
//                         max usable name length is 47)
//
// PEER POOL -- 64 rows x 64 bytes = 4 KiB
// ----------------------------------------
//
// Peer rows are "slotted" to the federation that owns them.  The row
// for the k-th peer of federation at slot s is at index (s * 8 + k).
// This organisation is simpler than a flat free-list because:
//
//   (a) peer_count on the federation record IS the next-free index
//       in that federation's 8-slot range,
//   (b) a peer_lookup(fed_id, index) requires no scan beyond the
//       federation-slot lookup, and
//   (c) deletion of a federation (R137.M5) can zero the whole 8-slot
//       range without touching other federations.
//
// Peer-row row index: fed_slot * 8 + peer_index, where fed_slot in
// [0, 8) and peer_index in [0, 8).  Max row index = 63.  Stride 64 is
// a power of two so row addressing uses `shl rax, 6` -- no 2-op
// `imul r, imm` (feedback_pdx_encoder_pitfalls).
//
// Logical fields per peer (task directive, adjusted to fit 64 B):
//
//   fed_id          : u32   -- the federation this peer belongs to
//                              (0 = FREE sentinel)
//   remote_ip       : u32   -- IPv4 address of peer host
//   remote_port     : u16   -- TCP port on peer host
//   status          : u16   -- 0=UNKNOWN, 1=REACHABLE, 2=UNREACHABLE
//   reserved        : u32   -- reserved
//   last_seen_tsc   : u64   -- rdtsc at last successful contact
//   name            : [u8; 40]  -- display name; last byte NUL
//
// NOTE on name size: the task directive specifies [u8; 48] for the
// peer name but the full field list sums to 72 B (not 64 B).  The
// pragmatic resolution is to shrink the peer name to 40 B (39 usable
// + NUL) which keeps every other field intact and preserves the "64 B
// per row, power-of-two stride" invariant.  Federation names stay at
// 48 B (47 + NUL) because the federation record's other fields leave
// exactly 48 B for the name.
//
// Packed storage:
//
//   [+0]   peer_hdr0 (u64) = fed_id (low 32) | remote_ip (high 32)
//                           fed_id==0 is the FREE sentinel.  A single
//                           u64 store captures both.
//
//   [+8]   peer_hdr1 (u64) = remote_port (bits 0..15) |
//                            status      (bits 16..31) |
//                            reserved    (bits 32..63)
//                           Single u64 store captures all three.
//
//   [+16]  last_seen_tsc (u64) -- rdtsc sample at register time
//                           (updated by R137.M5 reachability probe).
//
//   [+24]  name[ 0.. 7]  (u64 word)
//   [+32]  name[ 8..15]
//   [+40]  name[16..23]
//   [+48]  name[24..31]
//   [+56]  name[32..39]  (last byte is reserved for trailing NUL;
//                         max usable name length is 39)
//
// Row-addressed capacity: FD_FED_MAX = 8 federations, FD_PEER_PER_FED
// = 8 peers each, FD_PEER_MAX = 64 total peers.  fed_id==0 at
// peer_hdr0's low 32 is the authoritative FREE/LIVE gate for a peer
// row; .bss zero-init gives us FREE at real boot.
//
// =============================================================================
// SECTION 2  PUBLIC API SEMANTICS
// =============================================================================
//
// _fd_init() -> errno
//   Idempotent boot hook.  Emits `FED_DISC INIT OK` and bumps the
//   corresponding stats slot.  Returns FD_OK unconditionally -- the
//   .bss zero-init suffices to put every federation and peer slot
//   into the FREE state (fed_id==0 at both pools' row[0..+8)).  No
//   endpoint claim, no broker row at M3.
//
// _fd_federation_register(fed_id, name_ptr, name_len) -> errno
//   Register a new federation under `fed_id`.  `fed_id` MUST be
//   nonzero (0 is reserved as the FREE sentinel).
//
//   Idempotent on fed_id: if a federation with the same fed_id is
//   already registered, returns FD_OK WITHOUT updating the name or
//   peer_count (name updates would race the peer_count invariant
//   with cross-cap registration ordering; R137.M5 may lift to a
//   name-update API if the user story demands it).
//
//   Returns:
//     FD_OK            -- new row minted (or idempotent re-register)
//     FD_ERR_FED_FULL  -- all 8 federation rows are in use AND no
//                          existing row matches fed_id
//     FD_ERR_BAD_FED   -- fed_id == 0
//
// _fd_peer_register(fed_id, remote_ip, remote_port, name_ptr, name_len)
//                                                               -> errno
//   Append a peer to `fed_id`'s peer slot range.  The peer's status
//   is initialised to UNKNOWN (0) -- reachability probing is a
//   separate R137.M5 concern.
//
//   Returns:
//     FD_OK             -- peer row minted at (fed_slot * 8 +
//                           peer_count); peer_count incremented
//     FD_ERR_BAD_FED    -- fed_id not registered (or == 0)
//     FD_ERR_PEER_FULL  -- federation's peer_count is already 8
//
// _fd_peer_lookup(fed_id, index) -> packed u64
//   Return the status + endpoint of the index-th peer in fed_id's
//   peer list.
//
//   SUCCESS encoding (packed u64):
//     bits  0..15  = remote_port (u16)
//     bits 16..47  = remote_ip   (u32)
//     bits 48..63  = status      (u16; 0/1/2)
//
//   ERROR encoding: the raw errno value (FD_ERR_* in [0x2100, 0x2104))
//   is returned directly.
//
//   Collision caveat: a peer with status=UNKNOWN (0), remote_ip==0,
//   remote_port in {0x2100, 0x2101, 0x2102, 0x2103} would collide
//   with the four error codes.  Mitigation: the registering caller
//   is responsible for not registering 0.0.0.0:0x210N peers.  R137.M5
//   lifts to a dedicated out-parameter form once the KIND_FEDERATION
//   cap-invoke surface is in place and this one-u64 constraint is
//   lifted.
//
//   Returns:
//     (status<<48) | (remote_ip<<16) | remote_port -- on success
//     FD_ERR_BAD_FED    -- fed_id not registered
//     FD_ERR_BAD_INDEX  -- index >= federation's peer_count
//
// _fd_peer_list(fed_id, out_ptr, out_cap) -> packed u64
//   Write up to min(peer_count, out_cap) peer entries into out_ptr.
//   Each entry is a packed u64 with the same shape as _fd_peer_lookup's
//   success return.  out_cap is in units of u64 entries (callers that
//   want all peers should pass out_cap=8).
//
//   SUCCESS encoding (packed u64):
//     bits  0..15  = FD_OK (= 0)
//     bits 16..47  = number of entries written (u32; <= 8)
//
//   Returns:
//     (count<<16) | FD_OK  -- on success; count entries written
//     FD_ERR_BAD_FED       -- fed_id not registered
//
// =============================================================================
// SECTION 3  RETURN CODE BAND
// =============================================================================
//
// Per task directive:
//
//   FD_OK             = 0
//   FD_ERR_FED_FULL   = 0x2100
//   FD_ERR_PEER_FULL  = 0x2101
//   FD_ERR_BAD_FED    = 0x2102
//   FD_ERR_BAD_INDEX  = 0x2103
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the 7-byte
// zero-extending form (never `and r11, imm64`).  Band audit (2026-10-
// 14): `grep -rnE '0x210[0-3]\b' src/kernel/ 2>/dev/null` finds
// pre-existing hits in src/kernel/core/syscall/handlers/sys_execve_
// shim.pdx (`mov rax, 0x2100`), but those are user-aspace frame-
// layout OFFSET constants (data_base + 0x2100), not return-code
// values; they never flow into an errno comparison and so do not
// collide with the FD_ERR_* band's semantic meaning as return-code
// values.  Clean band for return-code purposes; R137.M5+ may extend
// to 0x2104..0x210F while retaining the first four as pinned.
//
// =============================================================================
// SECTION 4  INTERACTION WITH R137.M2 (HANDSHAKE) + R137.M4 (WIRE)
// =============================================================================
//
// R137.M2's handshake entries (`_rsh_server_keygen`, `_rsh_init_client`,
// `_rsh_accept_server`, `_rsh_derive_session_key`) at M3 do NOT yet
// consult this registry.  R137.M5 (KIND_FEDERATION cap-invoke) lifts
// to:
//
//   (a) a `fd_authorise_handshake(fed_id, remote_ip, remote_port) ->
//       errno` entry that scans the federation's peer rows for a
//       match and returns FD_ERR_BAD_FED / FD_ERR_BAD_INDEX on miss;
//
//   (b) a `_rsh_init_client` / `_rsh_server_keygen` precondition that
//       calls fd_authorise_handshake before starting the ML-KEM
//       round-trip.
//
// Until (a) and (b) land, the federation registry is a RECORD-ONLY
// substrate: callers may register federations and peers for
// observability, but no handshake path consults the registry.  This
// matches the "data substrate before policy" shape of R135.M1
// (jail_supervisor landed its row pool before any syscall consulted
// it in R135.M3) and R127.M1 (shell_session rows pre-dated the TTY
// line-discipline flip in R127.M3).
//
// R137.M4 (cross-host record wire) separately uses the peer registry
// to resolve a `(fed_id, peer_index)` tuple into the (remote_ip,
// remote_port) the wire framer connects to.  The packed-u64 return
// of _fd_peer_lookup is deliberately wire-ready: the framer unpacks
// without further allocation.
//
// =============================================================================
// SECTION 5  SECURITY POSTURE
// =============================================================================
//
// R137.M3's security posture is "trust the caller for shape":
//
//   * No validation of remote_ip / remote_port.  The caller (R137.M5
//     cap-minter or a direct-call bootstrap path) is responsible for
//     only registering peers it has out-of-band reason to trust.
//   * No validation of fed_id's identity beyond nonzero and in-pool.
//     Any caller that can reach _fd_federation_register can mint a
//     federation under any (nonzero) fed_id; the authority model is
//     "whoever registered a federation first owns its peer list".
//     R137.M5 lifts this to "the KIND_FEDERATION cap controls which
//     fed_id it may register against" when the cap-invoke dispatch
//     surface lands.
//   * No authentication of a peer at register time.  Reachability is
//     an UNKNOWN status until R137.M5's probe path promotes it to
//     REACHABLE or UNREACHABLE.
//   * No cap-invoke surface at M3.  The direct-call API is the only
//     surface and is reachable only from inside the kernel; ring-3
//     callers cannot reach it until R137.M5 lands the KIND_FEDERATION
//     kind and its cap_invoke arm.
//
// The ML-KEM-768 hybrid handshake (R137.M2) is the authoritative
// cryptographic gate between a connected TCP endpoint and a session
// key the remote peer can derive.  The federation registry at M3
// records WHICH endpoints are IN-SCOPE for a handshake; it does not
// itself prevent an out-of-scope handshake from succeeding.  That
// gating is R137.M5's job.
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE
// =============================================================================
//
// Labels are prefixed `fed_` (NOT `fd_`).  The `fd_` prefix is heavily
// used in the file-descriptor subsystem (`fd_table.pdx`,
// `fd_inherit.pdx`, `fd_cloexec.pdx`, task.fd_table[...] accessors);
// a label collision there would silently cross-ref at link time.
// Public symbols retain the task-directive `_fd_` prefix (which is
// unambiguous as function names because the fd-subsystem's symbols
// are `fd_*` without the leading underscore for internal helpers and
// `sys_*` for syscall entries).
//
// Module basename `FederationDiscovery` matches file basename
// `federation_discovery.pdx` (ddc requires exact match).
//
// Encoder-pitfall posture (feedback_pdx_encoder_pitfalls):
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 6 to compose row-base * 64 stride (never `imul r, imm`)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * single-line `pub let name = "..."`
//   * module basename FederationDiscovery matches file basename
//     federation_discovery.pdx (ddc requires exact match)
//   * fingerprint `[u8; N]` with N = string length + 1 (NUL counts)
//
// Stack discipline (SysV, entry rsp%16==8):
//   fed_note                  0 pushes (pure leaf)
//   fed_fed_row               0 pushes (pure leaf address compute)
//   fed_peer_row              0 pushes (pure leaf address compute)
//   fed_find_fed              0 pushes (pure leaf scan)
//   _fd_init                  1 push  (r12 across the klog call)
//   _fd_federation_register   4 pushes + sub rsp, 8
//                                  (rbx=fed_id, r12=name_ptr,
//                                   r13=name_len, r14=slot)
//   _fd_peer_register         5 pushes + sub rsp, 16
//                                  (name_len spill)
//   _fd_peer_lookup           2 pushes + sub rsp, 8
//   _fd_peer_list             4 pushes + sub rsp, 8
//
// =============================================================================

module FederationDiscovery = structure {

  // ==========================================================================
  // Return band (task-pinned, §3)
  // ==========================================================================

  pub let FD_OK            : u64 = 0
  pub let FD_ERR_FED_FULL  : u64 = 0x2100
  pub let FD_ERR_PEER_FULL : u64 = 0x2101
  pub let FD_ERR_BAD_FED   : u64 = 0x2102
  pub let FD_ERR_BAD_INDEX : u64 = 0x2103

  // ==========================================================================
  // Pool geometry (§1)
  // ==========================================================================

  pub let FD_FED_MAX       : u64 = 8     // federations
  pub let FD_PEER_PER_FED  : u64 = 8     // peers per federation
  pub let FD_PEER_MAX      : u64 = 64    // total peer rows
  pub let FD_ROW_BYTES     : u64 = 64    // 8 u64 per row (stride 2^6)

  // Federation row-field offsets (bytes, from row base)
  pub let FD_FED_OFF_HDR0  : u64 = 0     // packed fed_id | flags
  pub let FD_FED_OFF_HDR1  : u64 = 8     // packed peer_count | reserved
  pub let FD_FED_OFF_NAME  : u64 = 16    // 48 bytes (last reserved for NUL)

  pub let FD_FED_NAME_MAX  : u64 = 47    // 48 bytes with trailing NUL

  // Peer row-field offsets (bytes, from row base)
  pub let FD_PEER_OFF_HDR0 : u64 = 0     // packed fed_id | remote_ip
  pub let FD_PEER_OFF_HDR1 : u64 = 8     // packed remote_port | status | reserved
  pub let FD_PEER_OFF_TSC  : u64 = 16    // last_seen_tsc
  pub let FD_PEER_OFF_NAME : u64 = 24    // 40 bytes (last reserved for NUL)

  pub let FD_PEER_NAME_MAX : u64 = 39    // 40 bytes with trailing NUL

  // Status values
  pub let FD_STATUS_UNKNOWN     : u64 = 0
  pub let FD_STATUS_REACHABLE   : u64 = 1
  pub let FD_STATUS_UNREACHABLE : u64 = 2

  // Sentinel for "no federation slot matched".
  pub let FD_SLOT_NONE : u64 = 0xFF

  // ==========================================================================
  // Storage
  //
  //   _fd_federation_pool -- 8 rows x 64 bytes = 64 u64 = 512 bytes.
  //                          @align(64) puts the pool start on a
  //                          cache-line boundary (every row lands on a
  //                          cache line start since 64 is a cache line).
  //   _fd_peer_pool       -- 64 rows x 64 bytes = 512 u64 = 4 KiB.
  //                          @align(4096) puts the pool on its own
  //                          page frame so a future reader-view
  //                          (R137.M5) can map it with a single PTE.
  //   _fd_stats           -- 16 u64 counters (observability).
  // ==========================================================================

  pub let mut _fd_federation_pool : [u64; 64]  = uninit @align(64)
  pub let mut _fd_peer_pool       : [u64; 512] = uninit @align(4096)
  pub let mut _fd_stats           : [u64; 16]  = uninit @align(64)

  // Stats slot ordinals
  pub let FD_ST_INIT_OK        : u64 = 0
  pub let FD_ST_FED_REG_OK     : u64 = 1
  pub let FD_ST_FED_REG_REJ    : u64 = 2
  pub let FD_ST_PEER_REG_OK    : u64 = 3
  pub let FD_ST_PEER_REG_REJ   : u64 = 4
  pub let FD_ST_LOOKUP_OK      : u64 = 5
  pub let FD_ST_LOOKUP_REJ     : u64 = 6
  pub let FD_ST_LIST_OK        : u64 = 7
  pub let FD_ST_LIST_REJ       : u64 = 8

  // ==========================================================================
  // Fingerprint tags (N = len(string) + 1, NUL-inclusive)
  //
  // Only the "OK" tags are extracted by the fingerprint-coverage gate
  // (regex matches bare word OK); the REJ tags are opaque to the gate
  // so no allowlist entry is required for them.
  //
  // "FED_DISC INIT OK"       = 16 chars, +1 NUL => N=17
  // "FED_DISC FED_REG OK"    = 19 chars, +1 NUL => N=20
  // "FED_DISC FED_REG REJ"   = 20 chars, +1 NUL => N=21
  // "FED_DISC PEER_REG OK"   = 20 chars, +1 NUL => N=21
  // "FED_DISC PEER_REG REJ"  = 21 chars, +1 NUL => N=22
  // "FED_DISC LOOKUP OK"     = 18 chars, +1 NUL => N=19
  // "FED_DISC LOOKUP REJ"    = 19 chars, +1 NUL => N=20
  // "FED_DISC LIST OK"       = 16 chars, +1 NUL => N=17
  // "FED_DISC LIST REJ"      = 17 chars, +1 NUL => N=18
  // ==========================================================================

  pub let fed_tag_init_ok      : [u8; 17] = "FED_DISC INIT OK\0"
  pub let fed_tag_fed_reg_ok   : [u8; 20] = "FED_DISC FED_REG OK\0"
  pub let fed_tag_fed_reg_rej  : [u8; 21] = "FED_DISC FED_REG REJ\0"
  pub let fed_tag_peer_reg_ok  : [u8; 21] = "FED_DISC PEER_REG OK\0"
  pub let fed_tag_peer_reg_rej : [u8; 22] = "FED_DISC PEER_REG REJ\0"
  pub let fed_tag_lookup_ok    : [u8; 19] = "FED_DISC LOOKUP OK\0"
  pub let fed_tag_lookup_rej   : [u8; 20] = "FED_DISC LOOKUP REJ\0"
  pub let fed_tag_list_ok      : [u8; 17] = "FED_DISC LIST OK\0"
  pub let fed_tag_list_rej     : [u8; 18] = "FED_DISC LIST REJ\0"

  pub let fed_k_fid    : [u8; 4] = "fid\0"
  pub let fed_k_slot   : [u8; 5] = "slot\0"
  pub let fed_k_errno  : [u8; 6] = "errno\0"
  pub let fed_k_count  : [u8; 6] = "count\0"
  pub let fed_k_idx    : [u8; 4] = "idx\0"

  // ==========================================================================
  // fed_note(slot) -> ()
  //
  // Bounded increment on _fd_stats[slot].  Same shape as rs_note /
  // js_note / ss_note (load-inc-store; no `add reg, [mem]`).  Caller
  // passes an FD_ST_* ordinal in [0, 16); out-of-range slots silently
  // no-op.  Pure leaf -- no pushes.  Labels prefixed fed_no_.
  // ==========================================================================
  pub let fed_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M3 (paideia-os #2635): bounded increment on _fd_stats[slot<16]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed fed_no_. Mirrors rs_note / js_note / ss_note shape.",
      block: {
        cmp rdi, 16;
        jae fed_no_out;
        lea r10, [rip + _fd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fed_no_out:
        ret
      }
    }

  // ==========================================================================
  // fed_fed_row(slot) -> &_fd_federation_pool[slot*64]
  //
  // Federation-row index -> row base pointer.  Stride 64 = 2^6 so
  // `shl rax, 6` suffices (no `imul r, imm` encoder gap).  Caller
  // validates slot < FD_FED_MAX first; this helper is a pure address
  // compute.
  // ==========================================================================
  pub let fed_fed_row : (u64) -> u64 !{} @{} =
    fn (slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R137.M3 (paideia-os #2635): slot -> &_fd_federation_pool[slot*64]. Power-of-two stride uses `shl rax, 6` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates. Labels prefixed fed_fr_. Mirrors rs_row_base shape.",
      block: {
        mov rax, rdi;                    // slot
        shl rax, 6;                      // slot * 64
        lea r10, [rip + _fd_federation_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fed_peer_row(row_idx) -> &_fd_peer_pool[row_idx*64]
  //
  // Peer-row index -> row base pointer.  row_idx = fed_slot * 8 +
  // peer_index.  Stride 64 = 2^6 so `shl rax, 6` suffices.  Caller
  // validates row_idx < FD_PEER_MAX first.  Pure leaf.
  // ==========================================================================
  pub let fed_peer_row : (u64) -> u64 !{} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R137.M3 (paideia-os #2635): row_idx -> &_fd_peer_pool[row_idx*64]. row_idx = fed_slot*8 + peer_index. Power-of-two stride uses `shl rax, 6`. Pure leaf. Labels prefixed fed_pr_.",
      block: {
        mov rax, rdi;                    // row_idx
        shl rax, 6;                      // row_idx * 64
        lea r10, [rip + _fd_peer_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fed_find_fed(fed_id) -> slot | FD_SLOT_NONE
  //
  // Linear scan _fd_federation_pool[0..FD_FED_MAX) for the first row
  // whose fed_id (low 32 of hdr0) matches the arg.  Returns slot in
  // [0, 8) or FD_SLOT_NONE (0xFF) if no match.  Caller must have
  // already validated fed_id != 0 (since fed_id==0 is the FREE
  // sentinel and would spuriously match free rows).  Pure leaf.
  //
  // 32-bit mask uses `shl rax, 32; shr rax, 32` rather than
  // `and rax, 0xFFFFFFFF` -- shift-trick avoids any imm encoding.
  //
  // Labels prefixed fed_ff_.
  // ==========================================================================
  pub let fed_find_fed : (u64) -> u64 !{mem} @{} =
    fn (fed_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M3 (paideia-os #2635): linear scan _fd_federation_pool[0..FD_FED_MAX) for the first row whose fed_id (low 32 of hdr0 at [+0]) matches rdi. Return slot or FD_SLOT_NONE (0xFF). Inlined row-base (shl 6). Pure leaf -- no pushes. The 32-bit mask uses shift-trick (shl 32; shr 32) rather than and-with-imm64. Caller must validate fed_id != 0 before invoking (fed_id==0 is the FREE sentinel). Labels prefixed fed_ff_.",
      block: {
        lea r10, [rip + _fd_federation_pool];
        xor rcx, rcx;                    // slot cursor
      fed_ff_scan:
        cmp rcx, 8;                      // FD_FED_MAX
        jae fed_ff_none;

        mov rax, rcx;
        shl rax, 6;                      // slot * 64
        add rax, r10;                    // row base
        mov r11, [rax + 0];              // hdr0 (fed_id | flags)
        shl r11, 32;                     // zero high 32 (shift up)
        shr r11, 32;                     // low 32 only -- fed_id
        cmp r11, rdi;                    // match?
        je  fed_ff_hit;

        add rcx, 1;
        jmp fed_ff_scan;

      fed_ff_hit:
        mov rax, rcx;
        ret;

      fed_ff_none:
        mov rax, 0xFF;                   // FD_SLOT_NONE
        ret
      }
    }

  // ==========================================================================
  // fed_find_free_fed() -> slot | FD_SLOT_NONE
  //
  // Linear scan _fd_federation_pool for the first row whose fed_id
  // (low 32 of hdr0) is zero.  Returns slot or FD_SLOT_NONE.  Pure
  // leaf.  Labels prefixed fed_fe_.
  // ==========================================================================
  pub let fed_find_free_fed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M3 (paideia-os #2635): linear scan _fd_federation_pool[0..FD_FED_MAX) for the first row whose fed_id (low 32 of hdr0) is zero (FREE sentinel). Return slot or FD_SLOT_NONE. Shift-trick 32-bit mask. Pure leaf. Labels prefixed fed_fe_.",
      block: {
        lea r10, [rip + _fd_federation_pool];
        xor rcx, rcx;                    // slot cursor
      fed_fe_scan:
        cmp rcx, 8;                      // FD_FED_MAX
        jae fed_fe_none;

        mov rax, rcx;
        shl rax, 6;                      // slot * 64
        add rax, r10;                    // row base
        mov r11, [rax + 0];              // hdr0 (fed_id | flags)
        shl r11, 32;
        shr r11, 32;                     // low 32: fed_id
        cmp r11, 0;
        je  fed_fe_hit;

        add rcx, 1;
        jmp fed_fe_scan;

      fed_fe_hit:
        mov rax, rcx;
        ret;

      fed_fe_none:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // _fd_init() -> errno
  //
  // Boot hook.  No endpoint claim, no broker row at M3 -- the
  // federation registry is a direct-call substrate until R137.M5
  // registers KIND_FEDERATION and its cap_invoke arm.  .bss zero-
  // init at kernel boot puts every federation and peer row's fed_id
  // field at zero (the FREE sentinel), so no runtime priming is
  // required.
  //
  // The function exists to (a) emit a boot fingerprint (same posture
  // as every other svc.* daemon), and (b) provide a kernel_main.pdx
  // hook point for R137.M5 to layer the cap-invoke bringup onto
  // without a kernel_main revision.
  //
  // Returns FD_OK unconditionally.
  //
  // Register plan: 1 callee-save push (r12 for defensive parity with
  // sibling _*_init functions; not strictly required here since there
  // are no cross-call return values to park, but keeps the shape
  // consistent with _remote_shell_init / _jail_supervisor_init for
  // the fingerprint-emission block).
  //
  // Labels prefixed fed_in_.
  // ==========================================================================
  pub let _fd_init : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M3 (paideia-os #2635): boot hook for the federation registry. No endpoint claim and no broker row at M3 (R137.M5 lifts via KIND_FEDERATION cap-invoke registration). .bss zero-init puts fed_id==0 in every federation and peer row, which IS the FREE sentinel, so no runtime priming is required. Emits `FED_DISC INIT OK` and bumps FD_ST_INIT_OK. Single callee-save push (r12) corrects entry parity rsp%16==8 -> 0 for the klog_s1 call; r12 is unused but keeps shape consistent with sibling _*_init functions and reserves a landing pad for R137.M5's endpoint_alloc_at return. Returns FD_OK (0) unconditionally. Labels prefixed fed_in_.",
      block: {
        push r12;

        mov rdi, 0;                      // FD_ST_INIT_OK
        call fed_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_init_ok];
        call klog_s1;

        xor rax, rax;                    // FD_OK
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // _fd_federation_register(fed_id, name_ptr, name_len) -> errno
  //
  // Mint a federation row (or idempotent re-register).
  //
  // ARGS (SysV):
  //   rdi = fed_id    (u32 payload, zero-extended; MUST be nonzero)
  //   rsi = name_ptr  (readable up to name_len bytes; may be 0 iff
  //                     name_len is 0)
  //   rdx = name_len  (clamped to FD_FED_NAME_MAX = 47)
  //
  // RETURNS (rax):
  //   FD_OK            -- new row minted (or idempotent re-register)
  //   FD_ERR_FED_FULL  -- all 8 federation rows in use AND no match
  //   FD_ERR_BAD_FED   -- fed_id == 0
  //
  // STEP-BY-STEP:
  //   (1) Validate fed_id != 0.
  //   (2) fed_find_fed(fed_id) -- if hit, return FD_OK (idempotent).
  //   (3) fed_find_free_fed() -- if FD_SLOT_NONE, return FD_ERR_FED_FULL.
  //   (4) Init row:
  //         hdr0 <- fed_id (low 32) | 0 (flags = 0)
  //         hdr1 <- 0 (peer_count = 0, reserved = 0)
  //         name[0..47] <- byte-copy up to min(name_len, 47); NUL at
  //                        byte min(name_len, 47)
  //   (5) Bump FD_ST_FED_REG_OK; emit `FED_DISC FED_REG OK fid=0x<hex>`.
  //   (6) Return FD_OK.
  //
  // STACK FRAME:
  //   4 callee-save pushes (rbx=fed_id, r12=name_ptr, r13=name_len,
  //                        r14=slot after allocation) + sub rsp, 8
  //   pad.  Entry %16==8; +4*8=+32 -> %16==8; sub rsp,8 -> %16==0
  //   call-ready.
  //
  // Labels prefixed fed_fr_.
  // ==========================================================================
  pub let _fd_federation_register : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (fed_id: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M3 (paideia-os #2635): mint a federation row (or idempotent re-register on duplicate fed_id). Validate fed_id != 0 (FD_ERR_BAD_FED on zero -- fed_id==0 is the FREE sentinel). Call fed_find_fed(fed_id); if hit (slot != FD_SLOT_NONE), return FD_OK without touching the existing row (idempotent re-register posture; name updates deferred to R137.M5). Else call fed_find_free_fed; if FD_SLOT_NONE, return FD_ERR_FED_FULL. Write hdr0 = fed_id (low 32) | 0 (flags), hdr1 = 0 (peer_count=0, reserved=0), byte-copy up to min(name_len, 47) bytes with trailing NUL. Observable-last ordering: hdr0 is written LAST so a concurrent scanner either sees FREE (fed_id==0) or fully-initialised. Bump FD_ST_FED_REG_OK, emit `FED_DISC FED_REG OK fid=0x<hex>`, return FD_OK. Four callee-save pushes (rbx=fed_id across the three nested calls + name copy, r12=name_ptr, r13=name_len, r14=slot) + sub rsp,8 pad. Entry rsp%16==8; +4 pushes = +32 -> %16==8; sub rsp,8 -> %16==0 at every nested call. Byte copy uses mov_b scalar-indexed addressing (pre-advanced dst pointer to sidestep the unsupported mov_b [reg+reg*1+off],reg store form). Encoder-pitfall posture: cmp rN,0 (never test), shl rN,6 for stride-64 (never imul), mov rax, imm32 for all error codes. Labels prefixed fed_fr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // fed_id
        mov r12, rsi;                    // name_ptr
        mov r13, rdx;                    // name_len

        // (1) Validate fed_id != 0.
        cmp rbx, 0;
        je  fed_fr_bad_fed;

        // (2) Idempotent re-register: does fed_id already exist?
        mov rdi, rbx;
        call fed_find_fed;
        mov r11, 0xFF;                   // FD_SLOT_NONE
        cmp rax, r11;
        jne fed_fr_already;              // already registered -> idempotent OK

        // (3) Find a free federation slot.
        call fed_find_free_fed;
        mov r11, 0xFF;
        cmp rax, r11;
        je  fed_fr_full;

        mov r14, rax;                    // r14 = free slot

        // Compute row base: slot << 6 + pool base.
        mov rax, r14;
        shl rax, 6;
        lea r10, [rip + _fd_federation_pool];
        add rax, r10;                    // rax = row base
        mov r10, rax;                    // keep row base in r10

        // (4a) hdr1 = 0 (peer_count = 0, reserved = 0).
        xor r9, r9;
        mov [r10 + 8], r9;

        // (4b) Name copy up to min(name_len, 47) bytes with trailing NUL.
        //      Clamp name_len.
        mov r11, 47;                     // FD_FED_NAME_MAX
        cmp r13, r11;
        jbe fed_fr_len_ok;
        mov r13, r11;                    // clamp
      fed_fr_len_ok:

        // Pre-advance dst pointer by FD_FED_OFF_NAME (16) to sidestep
        // mov_b [reg+reg*1+off],reg (same technique as remote_shell.pdx
        // rs_ac_name_loop).
        mov r9, r10;
        add r9, 16;                      // &row.name[0]

        xor rcx, rcx;                    // i = 0
      fed_fr_name_loop:
        cmp rcx, r13;
        jae fed_fr_name_done;

        xor rax, rax;
        mov_b rax, [r12 + rcx * 1];
        mov_b [r9 + rcx * 1], rax;
        add rcx, 1;
        jmp fed_fr_name_loop;

      fed_fr_name_done:
        // NUL at [name + clamped_len].  In-bounds (name field spans
        // [+16..+64), 48 bytes).
        xor rax, rax;
        mov_b [r9 + rcx * 1], rax;

        // (4c) hdr0 = fed_id (low 32) | 0 (flags).  Written LAST so a
        //      concurrent scanner either sees FREE or fully-initialised.
        mov [r10 + 0], rbx;

        // (5) Stats + fingerprint.
        mov rdi, 1;                      // FD_ST_FED_REG_OK
        call fed_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_fed_reg_ok];
        lea rcx, [rip + fed_k_fid];
        mov r8,  rbx;                    // fed_id in hex KV
        call klog_s1_x1;

        xor rax, rax;                    // FD_OK
        jmp fed_fr_out;

      fed_fr_already:
        // Idempotent re-register.  Bump OK + fingerprint anyway so
        // the counter reflects user intent (observability over
        // strictness).  Emit the OK tag (not REJ).
        mov rdi, 1;                      // FD_ST_FED_REG_OK
        call fed_note;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_fed_reg_ok];
        lea rcx, [rip + fed_k_fid];
        mov r8,  rbx;
        call klog_s1_x1;

        xor rax, rax;                    // FD_OK
        jmp fed_fr_out;

      fed_fr_bad_fed:
        mov rdi, 2;                      // FD_ST_FED_REG_REJ
        call fed_note;

        mov r14, 0x2102;                 // FD_ERR_BAD_FED (reuse r14)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_fed_reg_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r14;
        call klog_s1_x1;

        mov rax, r14;
        jmp fed_fr_out;

      fed_fr_full:
        mov rdi, 2;                      // FD_ST_FED_REG_REJ
        call fed_note;

        mov r14, 0x2100;                 // FD_ERR_FED_FULL

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_fed_reg_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r14;
        call klog_s1_x1;

        mov rax, r14;

      fed_fr_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fd_peer_register(fed_id, remote_ip, remote_port, name_ptr, name_len)
  //                                                              -> errno
  //
  // Append a peer to fed_id's peer slot range.
  //
  // ARGS (SysV):
  //   rdi = fed_id         (u32 payload, zero-extended)
  //   rsi = remote_ip      (u32 payload, zero-extended)
  //   rdx = remote_port    (u16 payload, zero-extended)
  //   rcx = name_ptr
  //   r8  = name_len       (clamped to FD_PEER_NAME_MAX = 39)
  //
  // RETURNS (rax):
  //   FD_OK             -- peer row minted at (fed_slot*8 + peer_count);
  //                         peer_count incremented
  //   FD_ERR_BAD_FED    -- fed_id not registered (or == 0)
  //   FD_ERR_PEER_FULL  -- federation's peer_count already 8
  //
  // STEP-BY-STEP:
  //   (1) Validate fed_id != 0.
  //   (2) fed_find_fed(fed_id) -- if FD_SLOT_NONE -> FD_ERR_BAD_FED.
  //   (3) Load federation.peer_count from hdr1 low 32; if >= 8 ->
  //       FD_ERR_PEER_FULL.
  //   (4) Compute peer_row = fed_slot * 8 + peer_count.
  //   (5) Init peer row:
  //         hdr0 <- fed_id (low 32) | remote_ip (high 32)
  //         hdr1 <- remote_port (bits 0..15) |
  //                 FD_STATUS_UNKNOWN (bits 16..31) |
  //                 0 (bits 32..63)
  //         last_seen_tsc <- rdtsc sample
  //         name[0..39] <- byte-copy up to min(name_len, 39); NUL
  //   (6) Increment federation.peer_count (write back to hdr1).
  //   (7) Bump FD_ST_PEER_REG_OK; emit `FED_DISC PEER_REG OK fid=...`.
  //   (8) Return FD_OK.
  //
  // STACK FRAME:
  //   5 callee-save pushes (rbx=fed_id, r12=remote_ip, r13=remote_port,
  //                         r14=name_ptr, r15=fed_slot after lookup) +
  //   sub rsp, 16 (name_len spill + pad).  Entry %16==8; +5*8=+40 ->
  //   %16==0; sub rsp,16 -> %16==0 at every nested call.
  //
  // Labels prefixed fed_pg_.
  // ==========================================================================
  pub let _fd_peer_register : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (fed_id: u64) (remote_ip: u64) (remote_port: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M3 (paideia-os #2635): append a peer to fed_id's 8-slot peer range. Validate fed_id != 0 (FD_ERR_BAD_FED); call fed_find_fed; miss -> FD_ERR_BAD_FED. Read federation.peer_count from hdr1 low 32 via shift-trick mask (shl 32; shr 32); if >= 8 -> FD_ERR_PEER_FULL. Compute peer_row = fed_slot*8 + peer_count. Write peer hdr0 = fed_id | (remote_ip << 32); hdr1 = remote_port | (FD_STATUS_UNKNOWN << 16); last_seen_tsc = rdtsc; name byte-copy up to min(name_len, 39) with NUL. Increment federation.peer_count (write back to hdr1 preserving reserved high 32). Observable-last ordering: peer hdr0 is written LAST so a concurrent scanner sees FREE or fully-initialised. Bump FD_ST_PEER_REG_OK, emit fingerprint, return FD_OK. Five callee-save pushes (rbx=fed_id, r12=remote_ip, r13=remote_port, r14=name_ptr, r15=fed_slot) + sub rsp,16 (name_len spill at [rsp+0], 8B pad at [rsp+8]). Entry rsp%16==8; +5 pushes = +40 -> %16==0; sub rsp,16 = +56 -> %16==0 at every nested call. rdtsc populates edx:eax; reconstruct via shl rdx,32; or rax,rdx. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,6 for stride-64 (never imul), shl rN,3 for *8 (fed_slot -> peer_row base; combined with *64 gives shl 9), mov rax, imm32 for all error codes. Labels prefixed fed_pg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                    // fed_id
        mov r12, rsi;                    // remote_ip
        mov r13, rdx;                    // remote_port
        mov r14, rcx;                    // name_ptr
        mov [rsp + 0], r8;               // name_len spill

        // (1) Validate fed_id != 0.
        cmp rbx, 0;
        je  fed_pg_bad_fed;

        // (2) Locate federation slot.
        mov rdi, rbx;
        call fed_find_fed;
        mov r11, 0xFF;                   // FD_SLOT_NONE
        cmp rax, r11;
        je  fed_pg_bad_fed;

        mov r15, rax;                    // r15 = fed_slot

        // Compute federation row base.
        mov rax, r15;
        shl rax, 6;
        lea r10, [rip + _fd_federation_pool];
        add rax, r10;                    // rax = fed row base
        mov r10, rax;                    // r10 = fed row base (held)

        // (3) Read peer_count from hdr1 low 32.
        mov r9, [r10 + 8];               // hdr1
        shl r9, 32;
        shr r9, 32;                      // low 32: peer_count

        cmp r9, 8;                       // FD_PEER_PER_FED
        jae fed_pg_peer_full;

        // (4) Compute peer_row_idx = fed_slot * 8 + peer_count.
        //     Then peer_row_base = _fd_peer_pool + peer_row_idx * 64.
        //     Equivalently: _fd_peer_pool + fed_slot * 512 + peer_count * 64.
        //     Keep r11 = peer_row_base.
        mov rax, r15;                    // fed_slot
        shl rax, 3;                      // fed_slot * 8 (peer index base)
        add rax, r9;                     // + peer_count = peer_row_idx
        shl rax, 6;                      // peer_row_idx * 64
        lea r11, [rip + _fd_peer_pool];
        add r11, rax;                    // r11 = peer row base

        // (5a) peer hdr1 = remote_port | (FD_STATUS_UNKNOWN << 16) |
        //                   0 << 32.  FD_STATUS_UNKNOWN == 0 so hdr1
        //                   collapses to remote_port.
        mov [r11 + 8], r13;              // remote_port (low 16); rest zero

        // (5b) peer last_seen_tsc = rdtsc.
        //      r11 holds peer row base; rdtsc writes edx:eax only.
        rdtsc;
        shl rdx, 32;
        or  rax, rdx;
        mov [r11 + 16], rax;

        // (5c) Name copy up to min(name_len, 39) bytes with trailing NUL.
        mov rcx, [rsp + 0];              // name_len (unclamped)
        mov rax, 39;                     // FD_PEER_NAME_MAX
        cmp rcx, rax;
        jbe fed_pg_len_ok;
        mov rcx, rax;                    // clamp
      fed_pg_len_ok:
        // Spill clamped name_len to free rcx for the loop counter.
        mov [rsp + 8], rcx;              // clamped name_len

        // Pre-advance dst pointer by FD_PEER_OFF_NAME (24).
        mov r9, r11;
        add r9, 24;                      // &peer.name[0]

        xor rcx, rcx;                    // i = 0
      fed_pg_name_loop:
        mov rax, [rsp + 8];              // clamped name_len
        cmp rcx, rax;
        jae fed_pg_name_done;

        xor rax, rax;
        mov_b rax, [r14 + rcx * 1];
        mov_b [r9 + rcx * 1], rax;
        add rcx, 1;
        jmp fed_pg_name_loop;

      fed_pg_name_done:
        // NUL at [name + clamped_len].  In-bounds (name field spans
        // [+24..+64), 40 bytes).
        xor rax, rax;
        mov_b [r9 + rcx * 1], rax;

        // (5d) peer hdr0 = fed_id (low 32) | remote_ip (high 32).
        //      Written LAST so a concurrent scanner either sees FREE
        //      (fed_id==0) or fully-initialised.
        mov rax, r12;                    // remote_ip
        shl rax, 32;                     // place at high 32
        or  rax, rbx;                    // | fed_id (low 32)
        mov [r11 + 0], rax;

        // (6) Increment federation.peer_count (hdr1 low 32),
        //     preserving reserved high 32.
        //     Load hdr1; extract low 32 via shift-trick; +1; recombine
        //     with high 32.
        mov r9, [r10 + 8];               // old hdr1
        mov rax, r9;
        shr rax, 32;                     // rax = reserved (high 32)
        shl rax, 32;                     // reserved in high 32, low 32=0
        mov rcx, r9;
        shl rcx, 32;                     // zero high 32 of rcx
        shr rcx, 32;                     // rcx = old peer_count
        add rcx, 1;                      // new peer_count
        or  rax, rcx;                    // combine
        mov [r10 + 8], rax;              // store back

        // (7) Stats + fingerprint.
        mov rdi, 3;                      // FD_ST_PEER_REG_OK
        call fed_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_peer_reg_ok];
        lea rcx, [rip + fed_k_fid];
        mov r8,  rbx;                    // fed_id in hex KV
        call klog_s1_x1;

        xor rax, rax;                    // FD_OK
        jmp fed_pg_out;

      fed_pg_bad_fed:
        mov rdi, 4;                      // FD_ST_PEER_REG_REJ
        call fed_note;

        mov r15, 0x2102;                 // FD_ERR_BAD_FED (reuse r15)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_peer_reg_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r15;
        call klog_s1_x1;

        mov rax, r15;
        jmp fed_pg_out;

      fed_pg_peer_full:
        mov rdi, 4;                      // FD_ST_PEER_REG_REJ
        call fed_note;

        mov r15, 0x2101;                 // FD_ERR_PEER_FULL

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_peer_reg_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r15;
        call klog_s1_x1;

        mov rax, r15;

      fed_pg_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fd_peer_lookup(fed_id, index) -> packed u64
  //
  // Return the status + endpoint of the index-th peer in fed_id's
  // peer list.
  //
  // ARGS (SysV):
  //   rdi = fed_id (u32 payload)
  //   rsi = index  (u64; MUST be < federation.peer_count)
  //
  // RETURNS (rax):
  //   SUCCESS: (status<<48) | (remote_ip<<16) | remote_port
  //   FD_ERR_BAD_FED    -- fed_id not registered (or == 0)
  //   FD_ERR_BAD_INDEX  -- index >= federation.peer_count
  //
  // STEP-BY-STEP:
  //   (1) Validate fed_id != 0.
  //   (2) fed_find_fed(fed_id); miss -> FD_ERR_BAD_FED.
  //   (3) Load federation.peer_count; if index >= peer_count ->
  //       FD_ERR_BAD_INDEX.
  //   (4) Compute peer_row_idx = fed_slot * 8 + index.
  //   (5) Load peer.hdr0 -- extract remote_ip (high 32).
  //       Load peer.hdr1 -- extract remote_port (bits 0..15), status
  //                          (bits 16..31).
  //       Pack = (status << 48) | (remote_ip << 16) | remote_port.
  //   (6) Bump FD_ST_LOOKUP_OK; emit fingerprint; return packed.
  //
  // STACK FRAME:
  //   2 callee-save pushes (rbx=fed_id, r12=index) + sub rsp, 8 pad.
  //   Entry %16==8; +16 -> %16==8; sub rsp,8 -> %16==0 at nested
  //   calls.
  //
  // Labels prefixed fed_pl_.
  // ==========================================================================
  pub let _fd_peer_lookup : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (fed_id: u64) (index: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M3 (paideia-os #2635): return packed (status<<48)|(remote_ip<<16)|remote_port for the index-th peer in fed_id. Validate fed_id != 0 (FD_ERR_BAD_FED); fed_find_fed; miss -> FD_ERR_BAD_FED. Load federation.peer_count from hdr1 low 32 via shift-trick mask; if index >= peer_count -> FD_ERR_BAD_INDEX. Compute peer_row_idx = fed_slot*8 + index; peer_row_base = _fd_peer_pool + peer_row_idx*64. Load peer.hdr0; extract remote_ip (high 32) via shr 32. Load peer.hdr1; extract remote_port (low 16) via shift-trick (shl 48; shr 48), extract status (bits 16..31) via shr 16 + shift-trick low-16 mask. Pack = (status<<48)|(remote_ip<<16)|remote_port. Bump FD_ST_LOOKUP_OK, emit `FED_DISC LOOKUP OK fid=0x<hex>`, return packed. Two callee-save pushes (rbx=fed_id, r12=index) + sub rsp,8 pad. Entry rsp%16==8; +16 -> %16==8; sub rsp,8 -> %16==0 at every nested call. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,6 for stride-64, mov rax, imm32 for error codes. Labels prefixed fed_pl_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // fed_id
        mov r12, rsi;                    // index

        // (1) Validate fed_id != 0.
        cmp rbx, 0;
        je  fed_pl_bad_fed;

        // (2) Locate federation slot.
        mov rdi, rbx;
        call fed_find_fed;
        mov r11, 0xFF;
        cmp rax, r11;
        je  fed_pl_bad_fed;

        // rax = fed_slot.  Hold in r10 for the row-base compute.
        mov r10, rax;                    // r10 = fed_slot

        // Compute federation row base to read peer_count.
        mov rax, r10;
        shl rax, 6;                      // fed_slot * 64
        lea r9, [rip + _fd_federation_pool];
        add rax, r9;                     // rax = fed row base

        mov r9, [rax + 8];               // hdr1
        shl r9, 32;
        shr r9, 32;                      // low 32: peer_count

        // (3) Check index < peer_count.
        cmp r12, r9;
        jae fed_pl_bad_index;

        // (4) Compute peer_row_idx = fed_slot*8 + index.
        //     peer_row_base = _fd_peer_pool + peer_row_idx*64.
        mov rax, r10;                    // fed_slot
        shl rax, 3;                      // fed_slot * 8
        add rax, r12;                    // + index = peer_row_idx
        shl rax, 6;                      // peer_row_idx * 64
        lea r11, [rip + _fd_peer_pool];
        add r11, rax;                    // r11 = peer row base

        // (5) Extract and pack.
        //   remote_ip from peer.hdr0 (high 32).
        mov r9, [r11 + 0];
        shr r9, 32;                      // r9 = remote_ip (bits 0..31)

        //   remote_port (low 16) and status (bits 16..31) from peer.hdr1.
        mov rax, [r11 + 8];
        //   rcx = remote_port (low 16).  Shift-trick low-16 mask.
        mov rcx, rax;
        shl rcx, 48;
        shr rcx, 48;                     // rcx = remote_port

        //   rdx = status (bits 16..31).
        mov rdx, rax;
        shr rdx, 16;                     // bits 0..15 now hold old bits 16..31
        shl rdx, 48;
        shr rdx, 48;                     // rdx = status (low 16)

        //   Pack = (status << 48) | (remote_ip << 16) | remote_port.
        shl rdx, 48;                     // status at bits 48..63
        shl r9, 16;                      // remote_ip at bits 16..47
        or  rdx, r9;
        or  rdx, rcx;                    // | remote_port at bits 0..15
        mov r12, rdx;                    // park packed result in r12 (callee-save)

        // (6) Stats + fingerprint.
        mov rdi, 5;                      // FD_ST_LOOKUP_OK
        call fed_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_lookup_ok];
        lea rcx, [rip + fed_k_fid];
        mov r8,  rbx;                    // fed_id in hex KV
        call klog_s1_x1;

        mov rax, r12;                    // packed result
        jmp fed_pl_out;

      fed_pl_bad_fed:
        mov rdi, 6;                      // FD_ST_LOOKUP_REJ
        call fed_note;

        mov r12, 0x2102;                 // FD_ERR_BAD_FED

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_lookup_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        jmp fed_pl_out;

      fed_pl_bad_index:
        mov rdi, 6;                      // FD_ST_LOOKUP_REJ
        call fed_note;

        mov r12, 0x2103;                 // FD_ERR_BAD_INDEX

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_lookup_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;

      fed_pl_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fd_peer_list(fed_id, out_ptr, out_cap) -> packed u64
  //
  // Write up to min(peer_count, out_cap) packed peer entries to
  // out_ptr.  Each entry is a packed u64 with the same shape as
  // _fd_peer_lookup's success return.
  //
  // ARGS (SysV):
  //   rdi = fed_id
  //   rsi = out_ptr   (writable; must have room for out_cap * 8 bytes)
  //   rdx = out_cap   (number of u64 entries callers can accept)
  //
  // RETURNS (rax):
  //   SUCCESS: (count << 16) | FD_OK  -- count entries written to out_ptr
  //   FD_ERR_BAD_FED      -- fed_id not registered (or == 0)
  //
  // STEP-BY-STEP:
  //   (1) Validate fed_id != 0.
  //   (2) fed_find_fed(fed_id); miss -> FD_ERR_BAD_FED.
  //   (3) Load peer_count; count = min(peer_count, out_cap).
  //   (4) For i in [0, count):
  //         peer_row = fed_slot*8 + i.
  //         Pack = (status<<48)|(remote_ip<<16)|remote_port.
  //         out_ptr[i] = Pack.
  //   (5) Bump FD_ST_LIST_OK; emit `FED_DISC LIST OK fid=... count=...`.
  //   (6) Return (count << 16) | FD_OK.
  //
  // STACK FRAME:
  //   4 callee-save pushes (rbx=fed_id, r12=out_ptr, r13=out_cap,
  //                         r14=count-after-min) + sub rsp,8 pad.
  //   Entry %16==8; +32 -> %16==8; sub rsp,8 -> %16==0 at nested calls.
  //
  // Labels prefixed fed_pt_.
  // ==========================================================================
  pub let _fd_peer_list : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (fed_id: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M3 (paideia-os #2635): write up to min(peer_count, out_cap) packed peer entries into out_ptr. Each entry is a packed u64 (status<<48)|(remote_ip<<16)|remote_port matching _fd_peer_lookup's success return. Validate fed_id != 0 (FD_ERR_BAD_FED); fed_find_fed; miss -> FD_ERR_BAD_FED. Load federation.peer_count from hdr1 low 32; count = min(peer_count, out_cap). Walk peer rows [fed_slot*8 .. fed_slot*8+count); for each, load hdr0/hdr1, extract remote_ip/remote_port/status via shift-trick masks, pack and store at out_ptr[i]. Bump FD_ST_LIST_OK, emit `FED_DISC LIST OK fid=0x<hex>`, return (count<<16)|FD_OK. Four callee-save pushes (rbx=fed_id, r12=out_ptr, r13=out_cap, r14=count) + sub rsp,8 pad. Entry rsp%16==8; +32 -> %16==8; sub rsp,8 -> %16==0 at every nested call. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,6 for stride-64, shift-trick for 16-bit and 32-bit masks (never and-with-imm64), mov rax, imm32 for error codes. Labels prefixed fed_pt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // fed_id
        mov r12, rsi;                    // out_ptr
        mov r13, rdx;                    // out_cap

        // (1) Validate fed_id != 0.
        cmp rbx, 0;
        je  fed_pt_bad_fed;

        // (2) Locate federation slot.
        mov rdi, rbx;
        call fed_find_fed;
        mov r11, 0xFF;
        cmp rax, r11;
        je  fed_pt_bad_fed;

        mov r10, rax;                    // r10 = fed_slot (held across loop)

        // Compute federation row base; read peer_count.
        mov rax, r10;
        shl rax, 6;
        lea r9, [rip + _fd_federation_pool];
        add rax, r9;                     // rax = fed row base

        mov r9, [rax + 8];               // hdr1
        shl r9, 32;
        shr r9, 32;                      // r9 = peer_count

        // (3) count = min(peer_count, out_cap).
        mov r14, r9;                     // r14 = peer_count
        cmp r14, r13;
        jbe fed_pt_count_ok;
        mov r14, r13;                    // r14 = out_cap (smaller)
      fed_pt_count_ok:

        // (4) Walk peers [fed_slot*8 .. fed_slot*8 + count).
        //     Precompute peer_pool_base_for_fed = &_fd_peer_pool +
        //                                          fed_slot * 8 * 64.
        //     Keep in r11.
        mov rax, r10;                    // fed_slot
        shl rax, 9;                      // fed_slot * 512 (= 8*64)
        lea r11, [rip + _fd_peer_pool];
        add r11, rax;                    // r11 = &peer_pool[fed_slot*8]

        xor rcx, rcx;                    // i = 0
      fed_pt_loop:
        cmp rcx, r14;
        jae fed_pt_done;

        // peer_row_base_i = r11 + i*64.
        mov rax, rcx;
        shl rax, 6;
        add rax, r11;                    // rax = peer row base
        mov r9, rax;                     // r9 = peer row base

        //   remote_ip from peer.hdr0 (high 32).
        mov rax, [r9 + 0];
        shr rax, 32;                     // rax = remote_ip
        mov rdi, rax;                    // park remote_ip in rdi

        //   remote_port + status from peer.hdr1.
        mov rax, [r9 + 8];

        mov rsi, rax;                    // rsi = tmp for remote_port
        shl rsi, 48;
        shr rsi, 48;                     // rsi = remote_port (low 16)

        mov rdx, rax;                    // rdx = tmp for status
        shr rdx, 16;                     // old bits 16..31 -> bits 0..15
        shl rdx, 48;
        shr rdx, 48;                     // rdx = status (low 16)

        //   Pack = (status << 48) | (remote_ip << 16) | remote_port.
        shl rdx, 48;
        shl rdi, 16;
        or  rdx, rdi;
        or  rdx, rsi;                    // rdx = packed u64

        //   out_ptr[i] = packed.
        mov rax, rcx;
        shl rax, 3;                      // i * 8 (u64 entries)
        mov [r12 + rax * 1], rdx;

        add rcx, 1;
        jmp fed_pt_loop;

      fed_pt_done:
        // (5) Stats + fingerprint.
        mov rdi, 7;                      // FD_ST_LIST_OK
        call fed_note;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_list_ok];
        lea rcx, [rip + fed_k_fid];
        mov r8,  rbx;                    // fed_id in hex KV
        call klog_s1_x1;

        // (6) Return (count << 16) | FD_OK.
        mov rax, r14;
        shl rax, 16;
        jmp fed_pt_out;

      fed_pt_bad_fed:
        mov rdi, 8;                      // FD_ST_LIST_REJ
        call fed_note;

        mov r14, 0x2102;                 // FD_ERR_BAD_FED (reuse r14)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + fed_tag_list_rej];
        lea rcx, [rip + fed_k_errno];
        mov r8,  r14;
        call klog_s1_x1;

        mov rax, r14;

      fed_pt_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx picks this up with ONE new call AFTER
  // _remote_shell_init and BEFORE witness_r30_platform:
  //
  //   call _cap_minter_init;           // ENDPOINT 20, R125.M2
  //   call _syscall_rights_table_init; // R125.M4
  //   call _shell_session_init;        // ENDPOINT 21, R127.M1
  //   call _shell_history_init;        // R127.M4
  //   call _shell_jobs_init;           // R127.M6
  //   call _jail_supervisor_init;      // ENDPOINT 22, R135.M1
  //   call _remote_shell_init;         // ENDPOINT 24, R137.M1
  //   call _fd_init;                   // R137.M3 (this file)
  //   call witness_r30_platform;       // R30 platform witness cascade
  //
  // Placement rationale: AFTER _remote_shell_init (so the handshake
  // substrate the registry layers trust onto is already up) and BEFORE
  // witness_r30_platform (so a future platform witness that spins up
  // a federation + peer cascade sees the registry).
  //
  // No cap_invoke dispatch arm at R137.M3.  Named-IPC callers must
  // route through the broker (deferred to R137.M5 which will
  // endpoint_alloc_at + svc_register this daemon alongside the
  // KIND_FEDERATION kind registration).  The direct-call API above is
  // the in-kernel surface for R137.M4's wire framer and the
  // future R137.M5 cap-invoke dispatcher.
  //
  // See design/shell/federation-discovery.md for the full design
  // (federation semantics, trust boundary, interaction with R137.M2
  // handshake and R137.M4 wire).
  // ==========================================================================
}
