// src/kernel/core/svc/cap_minter.pdx -- Wave UMB-W9 R125.M2
// paideia-os #2592
//
// SVC.CAP-MINTER DAEMON: SUB-CAPABILITY DERIVATION SERVICE
// =============================================================================
//
// R125 ("capability flow at exec") milestone M2.  M1 (Wave UMB-W1,
// paideia-os #2591) landed the KIND_CAP_ENV substrate (kind id 0x5D,
// 16-env row pool, 6 slots per env; see src/kernel/core/cap/
// kind_cap_env.pdx).  M2 adds the kernel-level daemon that running
// processes consult when they need a NARROWED VIEW of a capability
// they already hold -- "give me a read-only subset of cap X".
//
// Service name:    "svc.cap-minter"
// Endpoint id:     20 (claimed via endpoint_alloc_at)
// Broker row:      svc_register("svc.cap-minter", 14, 20)
// Caller interface: _cap_minter_derive(parent_cap_slot,
//                                     requested_rights,
//                                     out_slot_ptr) -> errno
//
// =============================================================================
// SECTION 0  WHY A DAEMON INSTEAD OF A HANDLER
// =============================================================================
//
// Derivation is a MUTATION of the caller's cap-env (it writes a child
// cap into a free env slot) and an allocation of a fresh cap_table
// descriptor.  Neither action is on the "every op reads only" surface
// of cap_handler_cap_env (R125.M1 handler is read-only; its three ops
// are COUNT / LOOKUP / IS_FROZEN).  M2 keeps the handler read-only and
// routes DERIVE through a NAMED endpoint that running processes bind
// via svc_lookup("svc.cap-minter").  The handler-side wiring is a
// separate decision deferred to R125.M3 which lifts caller-context
// propagation; today the reserved op number is CAP_ENV_OP_DERIVE = 3
// (bumped from OP_MAX=2 in kind_cap_env.pdx by this landing) and the
// dispatch arm itself remains unwired until the ring-3-caller env is
// in scope.
//
// =============================================================================
// SECTION 1  SUB-CAPABILITY DERIVATION SEMANTICS
// =============================================================================
//
// A derived child cap:
//   (a) names the SAME underlying KIND resource as its parent
//       (same `kind`, same `target_ptr` in cap/table.pdx terms);
//   (b) carries a STRICT SUBSET of the parent's rights
//       (requested_rights & ~parent_rights == 0);
//   (c) occupies a FRESH cap_table slot (independent lifetime; the
//       parent's revoke does not implicitly revoke the child at M2 --
//       lineage tracking is R128 scope);
//   (d) is INSERTED into a free env slot of the caller's cap-env so
//       the caller can refer to it by env-slot id (0..5).
//
// The narrow-only invariant (b) is THE LOAD-BEARING check -- a widened
// right is a privilege escalation.  It is enforced by
//     mov rax, requested_rights
//     and rax, parent_rights
//     cmp rax, requested_rights       ; equal iff requested <= parent
//     jne cmnt_de_widen
// which uses no `not reg` form (paideia-as encoder gap on `not` is
// avoided by the equivalent AND-compare).
//
// =============================================================================
// SECTION 2  CALLER CONTEXT -- THE ACTIVE ENV
// =============================================================================
//
// The task's 3-arg signature omits an env_handle; the daemon resolves
// the caller's cap-env through an AMBIENT GLOBAL:
//
//   _cap_minter_active_env : [u64; 1]
//
// containing either CAP_ENV_ROW_NONE (0xFF, no caller bound) or the
// env_handle of the current caller.  At M2 the global is set by:
//
//   (i) a boot smoke harness which pins an env_handle before calling
//       _cap_minter_derive directly, OR
//  (ii) a cross-module writer in the IPC dispatcher that resolves the
//       caller's cap-env from its process cap-env slot (deferred to
//       R125.M3 which lifts process->env binding).
//
// On every _cap_minter_derive entry we re-read the global and treat
// CAP_ENV_ROW_NONE as "no caller" -> CM_ERR_PARENT_INVALID (the parent
// cap slot is unreachable because there is no env to look it up in).
//
// =============================================================================
// SECTION 3  DERIVED-CAP SLOT RANGE
// =============================================================================
//
// cap/slab.pdx's slab_alloc is a Phase-2 stub that returns
// CAP_SLAB_CAPACITY (256) unconditionally -- a semantic "slab full"
// sentinel until the free-list is rewritten.  Using it here would make
// every M2 derivation return CM_ERR_ENV_FULL, which is useless for
// bringup.  Until the slab is rewritten, the cap-minter owns a
// RESERVED RANGE of cap_table slots:
//
//   CM_SLOT_BASE  = 192
//   CM_SLOT_LIMIT = 256       (= CAP_SLOT_MAX)
//
// The range [192, 256) gives the daemon 64 derived cap slots.  Low
// slots (0..191) remain available for early-boot kernel-side mints,
// witness fixtures and ring-3 syscall-minted descriptors; the gap at
// 192 is a deliberate frontier so a bulk `grep '*24+0]' ...` audit at
// landing time showed zero live producers in [192, 256).  A proper
// slab allocator with a lineage-aware free list arrives with R128.M*
// (lineage) + Phase-3 slab rewrite; at that point this reserved range
// becomes a no-op (the slab hands back any free slot).
//
// =============================================================================
// SECTION 4  FROZEN ENV POSTURE
// =============================================================================
//
// The R125.M1 cap-env has a FREEZE operation that the shell calls just
// before handing the env to a cmd-module launch (R123.M4).  After
// FREEZE, cap_env_insert refuses with CAP_ENV_ENV_FROZEN.  A derive
// request on a frozen env therefore cannot land its child cap in the
// caller's env, and we return CM_ERR_ENV_FULL (the env has effectively
// zero mutable slots left -- the FROZEN condition is a special case of
// the "no room to insert" taxonomy).  A dedicated CM_ERR_FROZEN code
// is reserved for R125.M3 which may need to distinguish frozen-env
// errors in the caller-feedback path; at M2 the ambiguity is harmless
// because every derive against a frozen env is a programming error
// (the shell is supposed to derive child caps BEFORE freezing).  See
// design/shell/cap-minter-daemon.md §4 for the full discussion.
//
// =============================================================================
// SECTION 5  RETURN CODE BAND
// =============================================================================
//
// Per task directive:
//
//   CM_OK                 = 0
//   CM_ERR_PARENT_INVALID = 0x0F01
//   CM_ERR_RIGHTS_WIDEN   = 0x0F02
//   CM_ERR_ENV_FULL       = 0x0F03
//
// All fit imm32 with bit 31 clear so `mov rax, imm32` emits the 7-byte
// zero-extending form.  Band audit (2026-10-11):
//   `grep -rnE '0x0F0[1-3]\b' src/kernel/ 2>/dev/null` -> zero hits.
// Clean band.  R125.M3+ may extend the band to 0x0F04..0x0F0F while
// retaining the first three as pinned.
//
// Bringup codes (adjacent to schema_registry's EB4E/EB4F convention,
// using the free EBC8..EBDF band noted in cmd_invoke.pdx):
//
//   CM_BRINGUP_EP_FAIL  = 0xFFFFEBD0  (endpoint_alloc_at(20) refused)
//   CM_BRINGUP_REG_FAIL = 0xFFFFEBD1  (svc_register refused)
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE
// =============================================================================
//
// Labels are prefixed `cmnt_` (cap-minter) to stay clear of `cm_`
// (cap/cmd_module.pdx), `kcm_` (kind_cmd_module.pdx) and `ce_` (kind_
// cap_env.pdx).  Every reserved-word keyword (loop/if/let) is already
// outside this family.  Encoder-pitfall posture:
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 3 / shl rN, 4 to compose stride*24 (never `imul r, imm`)
//   * mov rax, imm32       (never `and r11, imm64`)
//   * single-line `pub let name = "..."`
//   * module basename CapMinter matches file basename cap_minter.pdx
//   * fingerprint `[u8; N]` with N = string length + 1 (NUL counts)
//
// Stack discipline (SysV, entry rsp%16==8):
//   _cap_minter_init          1 push  (ok)
//   _cap_minter_set_active_env 0 pushes (pure leaf)
//   _cap_minter_get_active_env 0 pushes (pure leaf)
//   _cap_minter_derive        5 pushes + sub rsp,32 (details inline)
//
// =============================================================================

module CapMinter = structure {

  // ==========================================================================
  // Service identity
  // ==========================================================================

  pub let CAP_MINTER_ENDPOINT_ID : u64 = 20
  pub let CAP_MINTER_NAME_LEN    : u64 = 14          // "svc.cap-minter" is 14 bytes

  // "svc.cap-minter" (14 chars) + NUL => [u8; 15].
  pub let cap_minter_name : [u8; 15] = "svc.cap-minter\0"

  // ==========================================================================
  // Return band (task-pinned)
  // ==========================================================================

  pub let CM_OK                 : u64 = 0
  pub let CM_ERR_PARENT_INVALID : u64 = 0x0F01
  pub let CM_ERR_RIGHTS_WIDEN   : u64 = 0x0F02
  pub let CM_ERR_ENV_FULL       : u64 = 0x0F03

  // Bringup codes (free band EBC8..EBDF).
  pub let CM_BRINGUP_EP_FAIL  : u64 = 0xFFFFEBD0
  pub let CM_BRINGUP_REG_FAIL : u64 = 0xFFFFEBD1

  // ==========================================================================
  // Geometry constants (cap_table shape -- MUST match cap/table.pdx)
  // ==========================================================================

  pub let CM_CAP_SLOT_MAX   : u64 = 256     // cap/table.pdx CAP_SLOT_MAX
  pub let CM_CAP_DESC_BYTES : u64 = 24      // cap/table.pdx CAP_DESC_BYTES
  pub let CM_CAP_ENV_SLOTS  : u64 = 6       // kind_cap_env.pdx CAP_ENV_SLOTS

  // Derived-cap slot range (see §3). Scanned for kind==0 at mint time.
  pub let CM_SLOT_BASE  : u64 = 192
  pub let CM_SLOT_LIMIT : u64 = 256         // half-open upper bound

  // Env-handle sentinel (shadow of kind_cap_env.pdx CAP_ENV_ROW_NONE).
  pub let CM_ENV_NONE : u64 = 0xFF

  // Env flag (shadow of kind_cap_env.pdx CAP_ENV_FLAG_FROZEN).
  pub let CM_ENV_FLAG_FROZEN : u64 = 0x2

  // ==========================================================================
  // State
  //
  //   _cap_minter_active_env  -- the ambient caller env (CM_ENV_NONE =
  //                              none bound).  At M2 set by the smoke
  //                              harness; at M3+ by the IPC dispatcher
  //                              from the caller's process cap-env.
  //
  //   _cap_minter_stats       -- 8 u64 counters (observability).
  // ==========================================================================

  pub let mut _cap_minter_active_env : [u64; 1] = uninit @align(64)
  pub let mut _cap_minter_stats      : [u64; 8] = uninit @align(64)

  pub let CM_ST_INIT_OK          : u64 = 0
  pub let CM_ST_INIT_EP_FAIL     : u64 = 1
  pub let CM_ST_INIT_REG_FAIL    : u64 = 2
  pub let CM_ST_DERIVE_OK        : u64 = 3
  pub let CM_ST_DERIVE_PARENT    : u64 = 4
  pub let CM_ST_DERIVE_WIDEN     : u64 = 5
  pub let CM_ST_DERIVE_ENV_FULL  : u64 = 6
  pub let CM_ST_SET_ACTIVE_ENV   : u64 = 7

  // ==========================================================================
  // Fingerprint tags (N = len(string) + 1, NUL-inclusive)
  // ==========================================================================

  // "CAP_MINTER INIT OK"    = 18 chars, +1 NUL => N=19
  // "CAP_MINTER INIT FAIL"  = 20 chars, +1 NUL => N=21
  // "CAP_MINTER DERIVE OK"  = 20 chars, +1 NUL => N=21
  // "CAP_MINTER DERIVE REJ" = 21 chars, +1 NUL => N=22
  // "CAP_MINTER SET_ENV"    = 18 chars, +1 NUL => N=19
  pub let cmnt_tag_init_ok     : [u8; 19] = "CAP_MINTER INIT OK\0"
  pub let cmnt_tag_init_fail   : [u8; 21] = "CAP_MINTER INIT FAIL\0"
  pub let cmnt_tag_derive_ok   : [u8; 21] = "CAP_MINTER DERIVE OK\0"
  pub let cmnt_tag_derive_rej  : [u8; 22] = "CAP_MINTER DERIVE REJ\0"
  pub let cmnt_tag_set_env     : [u8; 19] = "CAP_MINTER SET_ENV\0"

  pub let cmnt_k_env    : [u8; 4] = "env\0"
  pub let cmnt_k_slot   : [u8; 5] = "slot\0"
  pub let cmnt_k_errno  : [u8; 6] = "errno\0"
  pub let cmnt_k_newcap : [u8; 7] = "newcap\0"

  // ==========================================================================
  // cmnt_note(slot) -> ()
  //
  // Bounded increment on _cap_minter_stats[slot].  Same shape as
  // cap_env_note in kind_cap_env.pdx (load-inc-store; no `add reg,
  // [mem]`).  Caller passes a CM_ST_* ordinal; the bounds check guards
  // the pool size (8).
  // ==========================================================================
  pub let cmnt_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M2 (paideia-os #2592): bounded increment on _cap_minter_stats[slot<8]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed cmnt_no_.",
      block: {
        cmp rdi, 8;
        jae cmnt_no_out;
        lea r10, [rip + _cap_minter_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cmnt_no_out:
        ret
      }
    }

  // ==========================================================================
  // _cap_minter_set_active_env(env_handle) -> ()
  //
  // Harness-side setter.  Validates env_handle is < 16 OR == CM_ENV_NONE
  // (clear).  Any other value is silently clamped to CM_ENV_NONE so a
  // test harness that passes a bad handle leaves the daemon in a
  // well-defined "no caller" posture rather than a half-set state.
  // Bumps CM_ST_SET_ACTIVE_ENV and emits `CAP_MINTER SET_ENV env=0x..`.
  //
  // Register plan: 1 callee-save push (rbx = env_handle) lands rsp%16==0
  // at the klog_s1_x1 call (5-reg wrapper, no stack arg).
  // ==========================================================================
  pub let _cap_minter_set_active_env : (u64) -> () !{mem, sysreg} @{cap} =
    fn (env_handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M2 (paideia-os #2592): write _cap_minter_active_env[0]. Valid inputs: env_handle in [0, 16) or == 0xFF (CM_ENV_NONE). Any other value is clamped to 0xFF so a stale harness pass cannot park a nonsense handle. Bumps CM_ST_SET_ACTIVE_ENV; emits `CAP_MINTER SET_ENV env=0x<16-hex>` via klog_s1_x1 (5-reg wrapper, no stack arg). One callee-save push (rbx) lands rsp%16==0 at the klog call. Labels prefixed cmnt_sa_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // candidate env_handle

        // Validate: rbx < 16 OR rbx == CM_ENV_NONE (0xFF).
        mov r10, 16;
        cmp rbx, r10;
        jb  cmnt_sa_store;
        mov r10, 0xFF;
        cmp rbx, r10;
        je  cmnt_sa_store;

        // Out of range: clamp to CM_ENV_NONE.
        mov rbx, 0xFF;

      cmnt_sa_store:
        lea r10, [rip + _cap_minter_active_env];
        mov [r10 + 0], rbx;

        // Bump CM_ST_SET_ACTIVE_ENV (= 7).
        mov rdi, 7;
        call cmnt_note;

        // Emit `CAP_MINTER SET_ENV env=0x<hex>`.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_set_env];
        lea rcx, [rip + cmnt_k_env];
        mov r8,  rbx;
        call klog_s1_x1;

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _cap_minter_get_active_env() -> env_handle (CM_ENV_NONE if unset)
  //
  // Pure read.  Returned verbatim; CM_ENV_NONE (0xFF) means no caller
  // is bound.  Pure leaf -- no pushes.
  // ==========================================================================
  pub let _cap_minter_get_active_env : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M2 (paideia-os #2592): pure read of _cap_minter_active_env[0]. Pure leaf. Labels prefixed cmnt_ga_.",
      block: {
        lea r10, [rip + _cap_minter_active_env];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // _cap_minter_init() -> CM_OK | CM_BRINGUP_*
  //
  // Boot hook.  Shape mirrors schema_registry_bringup one-for-one:
  //   (1) endpoint_alloc_at(20).  On refusal -> CM_BRINGUP_EP_FAIL
  //       WITHOUT calling svc_register (the row never publishes a name
  //       against an endpoint id we did not claim -- the "do not
  //       partially install the row" discipline from R48-PREP-005.M1
  //       and R90-XREPO.012.M2-002).
  //   (2) svc_register("svc.cap-minter", 14, 20).  Any non-zero code
  //       (NAME_LEN / DUP / FULL) maps to CM_BRINGUP_REG_FAIL.
  //   (3) ALSO initialises _cap_minter_active_env[0] to CM_ENV_NONE so
  //       a chaos-restart flow that re-enters init gets a clean state
  //       (.bss zero-init would leave it at 0 which is a VALID env
  //       handle -- 0xFF is the "no caller" sentinel).
  //
  // Register plan: 1 callee-save push (r12) to correct entry parity
  // rsp%16==8 -> 0 for the two sibling (non-nested) calls, matching
  // schema_registry_bringup's shape.
  //
  // Fingerprint emission:
  //   On success:  `CAP_MINTER INIT OK` (no KV).
  //   On EP fail:  `CAP_MINTER INIT FAIL errno=0x<hex>` with EP_FAIL.
  //   On REG fail: `CAP_MINTER INIT FAIL errno=0x<hex>` with REG_FAIL.
  // ==========================================================================
  pub let _cap_minter_init : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M2 (paideia-os #2592): kernel-side bringup for svc.cap-minter. Claims CAP_MINTER_ENDPOINT_ID (20) via endpoint_alloc_at; on refusal returns CM_BRINGUP_EP_FAIL WITHOUT calling svc_register. On successful claim, calls svc_register(cap_minter_name, 14, 20) and translates its {0=OK, 1=NAME_LEN, 2=DUP, 3=FULL} return into CM_OK / CM_BRINGUP_REG_FAIL. ALSO writes _cap_minter_active_env[0] = CM_ENV_NONE so a chaos-restart re-entering init gets a well-defined no-caller state (bss-zero would otherwise look like env_handle 0). Single callee-save push (r12) to correct entry parity rsp%16==8 -> 0 for the two sibling (non-nested) calls, matching schema_registry_bringup / elevate_broker_bringup one-for-one. Bumps CM_ST_INIT_OK / INIT_EP_FAIL / INIT_REG_FAIL and emits one fingerprint. Labels prefixed cmnt_in_.",
      block: {
        push r12;

        // Normalise ambient state: _cap_minter_active_env <- CM_ENV_NONE.
        lea r10, [rip + _cap_minter_active_env];
        mov r11, 0xFF;                   // CM_ENV_NONE
        mov [r10 + 0], r11;

        // (1) endpoint_alloc_at(20).
        mov rdi, 20;                     // CAP_MINTER_ENDPOINT_ID
        call endpoint_alloc_at;
        cmp rax, 0;
        jne cmnt_in_ep_fail;

        // (2) svc_register("svc.cap-minter", 14, 20).
        lea rdi, [rip + cap_minter_name];
        mov rsi, 14;                     // CAP_MINTER_NAME_LEN
        mov rdx, 20;                     // endpoint id
        call svc_register;
        cmp rax, 0;
        jne cmnt_in_reg_fail;

        // Success path.
        mov rdi, 0;                      // CM_ST_INIT_OK
        call cmnt_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_init_ok];
        call klog_s1;

        xor rax, rax;                    // CM_OK
        pop r12;
        ret;

      cmnt_in_ep_fail:
        mov rdi, 1;                      // CM_ST_INIT_EP_FAIL
        call cmnt_note;

        mov r12, 0xFFFFEBD0;             // CM_BRINGUP_EP_FAIL (preserve
                                         // across the klog call via r12)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_init_fail];
        lea rcx, [rip + cmnt_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        pop r12;
        ret;

      cmnt_in_reg_fail:
        mov rdi, 2;                      // CM_ST_INIT_REG_FAIL
        call cmnt_note;

        mov r12, 0xFFFFEBD1;             // CM_BRINGUP_REG_FAIL

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_init_fail];
        lea rcx, [rip + cmnt_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cmnt_find_free_env_slot(env_handle) -> slot | CM_ENV_SLOTS (6, sentinel)
  //
  // Scan 0..CAP_ENV_SLOTS of the given env for the first slot whose
  // cap_env_lookup returns 0 (empty).  Returns the slot id, or 6 (==
  // CAP_ENV_SLOTS) as the "none free" sentinel -- a valid slot is
  // strictly < 6 so 6 is unambiguous.
  //
  // Register plan: 2 callee-save pushes (rbx = env_handle, r12 = slot
  // cursor) + sub rsp,8 to realign.  Entry rsp%16==8; +2 pushes = +16
  // -> %16==8; +sub8 = +24 -> %16==0 (call-ready for the nested
  // cap_env_lookup).  Trailing `add rsp, 8` restores before the pops.
  // ==========================================================================
  pub let cmnt_find_free_env_slot : (u64) -> u64 !{mem} @{} =
    fn (env_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M2 (paideia-os #2592): scan 0..CAP_ENV_SLOTS of env for the first slot where cap_env_lookup returns 0. Returns slot id (0..5), or 6 as the 'none free' sentinel (unambiguous because 6 is OUTSIDE the valid range). Two callee-save pushes (rbx=env_handle, r12=slot cursor) + sub rsp,8 land rsp%16==0 at the nested cap_env_lookup call. Labels prefixed cmnt_fs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // env_handle
        xor r12, r12;                    // slot cursor = 0

      cmnt_fs_scan:
        cmp r12, 6;                      // CAP_ENV_SLOTS
        jae cmnt_fs_none;

        mov rdi, rbx;
        mov rsi, r12;
        call cap_env_lookup;
        cmp rax, 0;
        je  cmnt_fs_hit;

        add r12, 1;
        jmp cmnt_fs_scan;

      cmnt_fs_hit:
        mov rax, r12;
        jmp cmnt_fs_out;

      cmnt_fs_none:
        mov rax, 6;                      // CAP_ENV_SLOTS (sentinel)

      cmnt_fs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cmnt_find_free_cap_slot() -> cap_table slot | CM_CAP_SLOT_MAX (256)
  //
  // Scan [CM_SLOT_BASE, CM_SLOT_LIMIT) of cap_table for the first slot
  // whose kind (at offset +0) is zero.  Returns the slot id, or 256 as
  // the "none free" sentinel.  Pure leaf -- no pushes.
  //
  // Address compute per slot: cap_table + slot*24.  stride 24 = 8 + 16,
  // so (slot<<3) + (slot<<4) composes it in two shifts (no 2-op imul
  // which the paideia-as encoder does not emit for `imul r, imm`).
  //
  // See §3 for why we scan a reserved range rather than slab_alloc'ing.
  // ==========================================================================
  pub let cmnt_find_free_cap_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M2 (paideia-os #2592): scan cap_table slots [CM_SLOT_BASE=192, CM_SLOT_LIMIT=256) for the first slot whose kind field (at [cap_table + slot*24 + 0]) is zero. Returns slot id (192..255), or 256 as the 'none free' sentinel. Stride 24 composed as (slot<<3)+(slot<<4) because paideia-as does not emit 2-op `imul r, imm`. Pure leaf -- no pushes. Labels prefixed cmnt_fc_.",
      block: {
        lea r10, [rip + cap_table];
        mov rcx, 192;                    // slot cursor = CM_SLOT_BASE

      cmnt_fc_scan:
        mov r11, 256;                    // CM_SLOT_LIMIT
        cmp rcx, r11;
        jae cmnt_fc_none;

        // Compute slot * 24 = (slot<<3) + (slot<<4).
        mov rax, rcx;
        shl rax, 3;                      // slot * 8
        mov r11, rcx;
        shl r11, 4;                      // slot * 16
        add rax, r11;                    // slot * 24
        add rax, r10;                    // &cap_table[slot]

        mov r11, [rax + 0];              // kind
        cmp r11, 0;
        je  cmnt_fc_hit;

        add rcx, 1;
        jmp cmnt_fc_scan;

      cmnt_fc_hit:
        mov rax, rcx;
        ret;

      cmnt_fc_none:
        mov rax, 256;                    // CM_CAP_SLOT_MAX
        ret
      }
    }

  // ==========================================================================
  // _cap_minter_derive(parent_cap_slot, requested_rights, out_slot_ptr)
  //                                                              -> errno
  //
  // The core sub-cap derivation entrypoint.
  //
  // ARGS (SysV):
  //   rdi = parent_cap_slot  (env slot id 0..5 within caller's env)
  //   rsi = requested_rights (bit mask, 64 bits)
  //   rdx = out_slot_ptr     (writeable u64* -- receives new env slot
  //                           id on success; untouched on error)
  //
  // RETURNS (rax):
  //   CM_OK                   -- derivation succeeded, *out_slot_ptr written
  //   CM_ERR_PARENT_INVALID   -- active env unset, parent slot empty or
  //                              out of range, parent cap_table slot
  //                              out of range or kind==0
  //   CM_ERR_RIGHTS_WIDEN     -- requested_rights not a subset of
  //                              parent_rights
  //   CM_ERR_ENV_FULL         -- env is frozen, env has no free slot,
  //                              OR cap_table reserved range is full
  //                              (all three collapse to "cannot land
  //                              the child cap"; see §4)
  //
  // STEP-BY-STEP:
  //   1. Load _cap_minter_active_env[0]; if 0xFF -> CM_ERR_PARENT_INVALID.
  //   2. cap_env_row_in_use(env) -> if 0 -> CM_ERR_PARENT_INVALID.
  //   3. Validate parent_cap_slot < CAP_ENV_SLOTS; else PARENT_INVALID.
  //   4. parent_cap_idx = cap_env_lookup(env, parent_cap_slot).  If 0
  //      (empty slot) -> CM_ERR_PARENT_INVALID.
  //   5. Validate parent_cap_idx < CAP_SLOT_MAX; else PARENT_INVALID.
  //   6. Load [cap_table + parent_cap_idx*24]: parent_kind at +0,
  //      parent_rights at +8, parent_target_ptr at +16.  If
  //      parent_kind == 0 -> CM_ERR_PARENT_INVALID.
  //   7. Narrow-only check: (requested_rights & parent_rights) ==
  //      requested_rights.  Else -> CM_ERR_RIGHTS_WIDEN.
  //   8. Check env not frozen (flags & FROZEN == 0).  If frozen ->
  //      CM_ERR_ENV_FULL.
  //   9. cmnt_find_free_env_slot(env) -> free_env_slot.  If 6 ->
  //      CM_ERR_ENV_FULL.
  //  10. cmnt_find_free_cap_slot() -> new_cap_idx.  If 256 ->
  //      CM_ERR_ENV_FULL (the cap-minter's reserved range is
  //      exhausted; see §3).
  //  11. cap_mint_write(new_cap_idx, parent_kind, requested_rights,
  //                     parent_target_ptr).
  //  12. cap_env_insert(env, free_env_slot, new_cap_idx).  Any
  //      non-zero return (should not happen -- we validated env and
  //      slot) collapses to CM_ERR_ENV_FULL.
  //  13. [out_slot_ptr] = free_env_slot.
  //  14. Emit `CAP_MINTER DERIVE OK env=0x.. slot=<dec> newcap=0x..`.
  //  15. Bump CM_ST_DERIVE_OK; return CM_OK.
  //
  // STACK FRAME:
  //   5 callee-save pushes + sub rsp, 16 (16-byte spill frame).
  //   Entry rsp%16==8; +5 pushes = +40 -> %16==0; +sub16 -> %16==0
  //   (call-ready at every nested call).
  //
  //   REGISTER MAP:
  //     rbx = env_handle (throughout steps 1..15)
  //     r12 = parent_cap_slot (steps 2..4); then free_env_slot (steps 9..15)
  //     r13 = requested_rights (throughout; needed at steps 7, 11)
  //     r14 = out_slot_ptr (needed at step 13)
  //     r15 = parent_cap_table_idx (steps 4..6); then scratch for
  //           parent_rights (step 7); then new_cap_idx (steps 10..15)
  //
  //   STACK SPILL:
  //     [rsp+0] = parent_cap_table_idx (written step 4; re-read step 11
  //               to recover parent_kind + parent_target_ptr from the
  //               cap_table row, because r15 has been reused for
  //               new_cap_idx by that point)
  //     [rsp+8] = pad (keeps rsp%16==0)
  //
  //   The spill at [rsp+0] is cheap: one 8-byte store on entry's
  //   validation path, one 8-byte load at the mint step.  Trading 16
  //   bytes of stack for one extra register's worth of state keeps the
  //   push/pop count at 5 and avoids a sixth callee-save slot.  Labels
  //   prefixed cmnt_de_.
  // ==========================================================================
  pub let _cap_minter_derive : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_cap_slot: u64) (requested_rights: u64) (out_slot_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M2 (paideia-os #2592): the sub-cap derive hot path. See the long comment above the function for the 15-step algorithm, failure taxonomy, and the register timeline (rbx=env, r12=parent_slot then free_env_slot, r13=requested_rights, r14=out_slot_ptr, r15=multi-use scratch). The parent_kind and parent_target_ptr are re-read from cap_table at mint time rather than held across the free-slot scans -- two memory loads trade cleanly for the one-frame no-sub-rsp posture (5 pushes + call-ready). The narrow-only invariant is enforced by `mov rax, req; and rax, par; cmp rax, req; jne widen` which avoids the paideia-as `not reg` encoder gap. All error paths bump a stat and jump to a single epilogue that pops the 5 regs. Labels prefixed cmnt_de_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                     // spill frame: [rsp+0] = parent_cap_table_idx

        mov r12, rdi;                    // parent_cap_slot
        mov r13, rsi;                    // requested_rights
        mov r14, rdx;                    // out_slot_ptr

        // ---- Step 1: load active env ----
        lea r10, [rip + _cap_minter_active_env];
        mov rbx, [r10 + 0];
        mov r11, 0xFF;                   // CM_ENV_NONE
        cmp rbx, r11;
        je  cmnt_de_parent;

        // ---- Step 2: env must be in use ----
        mov rdi, rbx;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  cmnt_de_parent;

        // ---- Step 3: parent_cap_slot < CAP_ENV_SLOTS ----
        cmp r12, 6;                      // CAP_ENV_SLOTS
        jae cmnt_de_parent;

        // ---- Step 4: lookup parent cap_table idx in env ----
        mov rdi, rbx;
        mov rsi, r12;
        call cap_env_lookup;
        cmp rax, 0;
        je  cmnt_de_parent;              // empty env slot

        // Spill parent_cap_table_idx for step 11 re-read.
        mov [rsp + 0], rax;
        // Keep in r15 for the step 5..7 ladder.
        mov r15, rax;                    // r15 = parent_cap_table_idx

        // ---- Step 5: parent_cap_idx < CAP_SLOT_MAX ----
        mov r11, 256;                    // CM_CAP_SLOT_MAX
        cmp r15, r11;
        jae cmnt_de_parent;

        // ---- Step 6: load parent descriptor; validate kind != 0 ----
        //   &cap_table[parent_cap_idx] = cap_table + parent_cap_idx*24
        mov rax, r15;
        shl rax, 3;                      // idx * 8
        mov r11, r15;
        shl r11, 4;                      // idx * 16
        add rax, r11;                    // idx * 24
        lea r10, [rip + cap_table];
        add rax, r10;                    // &cap_table[idx]

        mov r9,  [rax + 0];              // parent_kind
        cmp r9,  0;
        je  cmnt_de_parent;

        //   parent_rights at +8 for the narrow check below.
        //   Reuse r15 (parent_cap_table_idx has already been spilled).
        mov r15, [rax + 8];              // r15 = parent_rights

        // ---- Step 7: narrow-only check ----
        //   (requested_rights & parent_rights) == requested_rights
        //   AND-and-compare avoids the paideia-as `not reg` encoder gap.
        mov rax, r13;
        and rax, r15;
        cmp rax, r13;
        jne cmnt_de_widen;

        // ---- Step 8: env not frozen ----
        //   row_base = cap_env_row_base(env); flags = [row_base+0]
        mov rdi, rbx;
        call cap_env_row_base;
        mov r11, [rax + 0];              // flags
        mov r9,  2;                      // CM_ENV_FLAG_FROZEN
        and r11, r9;
        cmp r11, 0;
        jne cmnt_de_envfull;

        // ---- Step 9: find a free env slot ----
        mov rdi, rbx;
        call cmnt_find_free_env_slot;
        cmp rax, 6;                      // CAP_ENV_SLOTS -> sentinel
        jae cmnt_de_envfull;

        // r12 <- free_env_slot (parent_slot no longer needed).
        mov r12, rax;

        // ---- Step 10: find a free cap_table slot ----
        call cmnt_find_free_cap_slot;
        mov r11, 256;                    // CM_CAP_SLOT_MAX
        cmp rax, r11;
        jae cmnt_de_envfull;

        // r15 <- new_cap_idx.
        mov r15, rax;

        // ---- Step 11: cap_mint_write(new_cap_idx, parent_kind,
        //                              requested_rights, parent_target_ptr)
        //
        // Reload parent_cap_table_idx from the stack spill, then
        // re-read the parent row to get parent_kind and parent_target_
        // ptr.  Two cache-hot 8-byte loads; sees the SAME row we
        // validated in step 6 (no race -- this is a single-flow
        // substrate at R125.M2; concurrency arrives with R125.M4+).
        mov r11, [rsp + 0];              // r11 = parent_cap_table_idx
        mov rax, r11;
        shl rax, 3;
        mov r9,  r11;
        shl r9,  4;
        add rax, r9;
        lea r10, [rip + cap_table];
        add rax, r10;                    // &cap_table[parent_cap_table_idx]

        mov rdi, r15;                    // rdi = new_cap_idx (slot)
        mov rsi, [rax + 0];              // rsi = parent_kind
        mov rcx, [rax + 16];             // rcx = parent_target_ptr
        mov rdx, r13;                    // rdx = requested_rights
        call cap_mint_write;

        // ---- Step 12: insert new cap into env ----
        mov rdi, rbx;                    // env_handle
        mov rsi, r12;                    // free_env_slot
        mov rdx, r15;                    // new_cap_idx (as the cap value
                                         // written into the env slot --
                                         // this is the cap_table index,
                                         // matching cap_env_insert's
                                         // "cap" u64 field)
        call cap_env_insert;
        cmp rax, 0;
        jne cmnt_de_envfull;

        // ---- Step 13: write *out_slot_ptr = free_env_slot ----
        mov [r14 + 0], r12;

        // ---- Step 14: fingerprint ----
        //   `CAP_MINTER DERIVE OK env=0x<hex>`.  env is the headline
        //   identifier; slot+newcap are observable via the stats pool
        //   and the subsequent CAP_ENV INSERT fingerprint already
        //   emitted by cap_env_insert (which includes both env and
        //   slot).  A dedicated klog_s1_x2_d1-style 3-KV emit is
        //   available but adds a stack frame; keeping the derive hot
        //   path at one klog_s1_x1 matches the one-fingerprint-per-
        //   outcome discipline from schema_registry / elevate_broker.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_derive_ok];
        lea rcx, [rip + cmnt_k_env];
        mov r8,  rbx;
        call klog_s1_x1;

        // ---- Step 15: stats + success return ----
        mov rdi, 3;                      // CM_ST_DERIVE_OK
        call cmnt_note;

        xor rax, rax;                    // CM_OK
        jmp cmnt_de_out;

      cmnt_de_parent:
        mov rdi, 4;                      // CM_ST_DERIVE_PARENT
        call cmnt_note;

        mov r12, 0x0F01;                 // CM_ERR_PARENT_INVALID (held
                                         // in r12 across the klog call)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_derive_rej];
        lea rcx, [rip + cmnt_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        jmp cmnt_de_out;

      cmnt_de_widen:
        mov rdi, 5;                      // CM_ST_DERIVE_WIDEN
        call cmnt_note;

        mov r12, 0x0F02;                 // CM_ERR_RIGHTS_WIDEN

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_derive_rej];
        lea rcx, [rip + cmnt_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        jmp cmnt_de_out;

      cmnt_de_envfull:
        mov rdi, 6;                      // CM_ST_DERIVE_ENV_FULL
        call cmnt_note;

        mov r12, 0x0F03;                 // CM_ERR_ENV_FULL

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cmnt_tag_derive_rej];
        lea rcx, [rip + cmnt_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;

      cmnt_de_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx picks this up with ONE new call alongside the
  // existing svc.* bringups:
  //
  //   call elevate_broker_bringup;     // ENDPOINT 16, R48-PREP-005.M1
  //   call schema_registry_bringup;    // ENDPOINT 18, R90-XREPO.012.M2
  //   call _cap_minter_init;           // ENDPOINT 20, R125.M2 (this file)
  //
  // Placement: AFTER the two existing svc.* bringups above (so the
  // broker table has the elevate and schema rows published first) and
  // BEFORE any user-space init (so a user process that binds
  // "svc.cap-minter" at startup sees it).
  //
  // ----------------
  // Dispatch arm reservation (kind_cap_env.pdx)
  //
  // This landing also edits kind_cap_env.pdx to add
  //
  //   pub let CAP_ENV_OP_DERIVE : u64 = 3
  //   // (OP_MAX bumped from 2 to 3)
  //
  // which RESERVES the op number for a future dispatch arm in
  // cap_handler_cap_env.  The arm itself is NOT wired at M2:
  // cap_handler_cap_env currently masks op_arg to its low 16 bits
  // (op_code + slot) and a usable DERIVE call needs more bits for
  // requested_rights plus a seat for an out-ptr equivalent.  The
  // op-level encoding is designed in design/shell/cap-minter-
  // daemon.md §7 (interaction with R125.M3) and wired by the
  // caller-context lift when that lands.
  //
  // Named-IPC callers at M2 route through the broker:
  //
  //   endpoint_id = svc_lookup("svc.cap-minter")    (= 20)
  //   send DERIVE frame to endpoint_id, receive REPLY
  //
  // The frame body carries parent_cap_slot, requested_rights, and
  // reads back the new env_slot_id on OK.  The IPC-side frame layout
  // sits in design/shell/cap-minter-daemon.md §3.3.
  // ==========================================================================
}
