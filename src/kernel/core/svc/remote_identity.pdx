// src/kernel/core/svc/remote_identity.pdx -- Wave UMB-W23 R137.M5
// paideia-os #2637
//
// SVC.REMOTE-SHELL: REMOTE-SIDE IDENTITY MAPPING
// =============================================================================
//
// R137 ("cross-host pipeline transport") milestone M5.  M5 lands the
// IDENTITY MAP that bridges a remote peer's wire-level handle
// (fed_id, peer_index) to a LOCAL capability principal (sub-cap-env
// slot) so capability checks on dispatched records fire against the
// right authority band.
//
// R137.M1-M4 covered: the per-conn row pool (M1), the ML-KEM hybrid
// handshake that stamps mlkem_ss into the row (M2), the federation
// registry an incoming connection authorises against (M3), and the
// ChaCha20-Poly1305 record framer that carries typed records across
// an established session (M4).  Up to and including M4, a frame that
// arrives from a remote peer carries no concept of "whose authority
// should the dispatched record run with".  M5 closes that gap.
//
// The identity map is a per-connection, kernel-owned table that
// binds the triple
//
//   (conn_id, fed_id, peer_index)
//
// to a sub-cap-env slot inside the server task's active capability
// environment.  The slot is minted via `_cap_minter_derive` against
// a parent slot the server task already holds and a rights mask the
// server task approves at bind time.  Narrow-only derivation (the
// cap-minter's §4 invariant) ensures the sub-cap cannot widen
// authority beyond what the server task itself can exercise.
//
// A frame arriving on `conn_id` consults the map via
// `_ri_lookup_peer_env(conn_id)` before dispatch.  The returned slot
// becomes the PARENT cap for any downstream cap-check the dispatched
// record would exercise (open a file, invoke a service, mint a
// deeper sub-cap).  A map miss means "no principal registered for
// this connection" and the dispatcher refuses the record.
//
// Service name:    "svc.remote-identity"  (NO BROKER REGISTRATION at
//                                           M5 -- this module is a
//                                           direct-call bridge, not a
//                                           svc.* daemon.  No endpoint
//                                           id is claimed; no cap-
//                                           invoke dispatch arm exists.
//                                           R137.M6+ MAY lift to a
//                                           cap-invoke surface for
//                                           authenticated userspace
//                                           "please bind this peer"
//                                           callers.)
//
// Direct API:
//   _ri_bind_peer_to_env  (conn_id, fed_id, peer_index,
//                          parent_cap_env_slot, rights_mask) -> packed u64
//   _ri_lookup_peer_env   (conn_id) -> env_slot | RI_SLOT_NONE
//   _ri_revoke_peer_env   (conn_id) -> errno
//
// =============================================================================
// SECTION 1  TRUST-BOUNDARY POSTURE
// =============================================================================
//
// A record arriving over a cross-host wire carries NO ambient
// authority.  The handshake (M2) proves the peer completed an ML-KEM
// exchange with a public key the local federation (M3) registered,
// which proves the peer is who they claim to be AT THE WIRE LEVEL.
// It does NOT grant the peer any capability on the local kernel.
//
// Granting local authority to a wire-level peer is a SEPARATE,
// AUTHORED-BY-SERVER-TASK decision.  M5 encodes that decision as a
// one-shot bind call:
//
//   _ri_bind_peer_to_env(conn_id, fed_id, peer_index,
//                        parent_cap_env_slot, rights_mask)
//
// The server task supplies:
//
//   * conn_id              -- the wire row the peer is talking on;
//                             M5 cross-checks against _remote_shell_pool
//                             to refuse binds for stale/free rows.
//   * fed_id, peer_index   -- the registry key for the peer; M5 cross-
//                             checks against _fd_peer_lookup to refuse
//                             binds for unknown or out-of-range peers.
//   * parent_cap_env_slot  -- a slot in the server task's active env
//                             that holds the authority band the peer
//                             may act within.  The derived sub-cap
//                             inherits parent_kind + parent_target_ptr
//                             verbatim.
//   * rights_mask          -- the subset of parent_rights the peer may
//                             exercise.  Narrow-only; `_cap_minter_
//                             derive` refuses widen.
//
// On success the derived sub-cap lands in a FREE slot of the active
// env and that slot id is stored in the ri_pool row keyed by conn_id.
// A future `_ri_lookup_peer_env(conn_id)` returns that slot in O(1)
// without touching the cap-minter again.
//
// On teardown (`_remote_shell_close` call site, deferred to M6 wire-
// up) `_ri_revoke_peer_env(conn_id)` zeroes the ri_pool row.  The
// sub-cap itself remains in the active env's cap_table (there is no
// cap-minter revoke primitive at M5) but with the ri binding gone the
// peer can no longer reach it from the wire -- any subsequent record
// on the same conn_id would miss the map and get refused.  The slot
// reclaims cleanly when the active env is destroyed, or when a later
// bind on the same conn_id overwrites the slot via a fresh derive.
//
// =============================================================================
// SECTION 2  RETURN CODE BAND  --  0x1D30..0x1D3F
// =============================================================================
//
// Band audit (2026-10-14):
//   `grep -rnE '0x1D3[0-9]\b' src/kernel/`  -> zero hits.
// 0x1D30..0x1D3F is disjoint from RS_* (0x1D00..0x1D02),
// RRW_* (0x1D20..0x1D23), RSH_* (0x1D10..0x1D13), FD_* (0x1D40..0x1D4F
// per federation_discovery.pdx).  Codes:
//
//   RI_OK            = 0
//   RI_ERR_BAD_CONN  = 0x1D01  (reused alias of RS_ERR_BAD_ID so the
//                               wire-layer "no such connection" code
//                               is uniform across the remote-shell
//                               stack)
//   RI_ERR_BAD_PEER  = 0x1D30  (fed_id/peer_index not registered or
//                               out of range; ALSO the collapse code
//                               for cap-minter PARENT_INVALID /
//                               ENV_FULL when the server task's env
//                               refuses the derive -- the peer cannot
//                               be bound under the supplied parent)
//   RI_ERR_WIDEN     = 0x1D31  (rights_mask is NOT a subset of
//                               parent_rights; the cap-minter's
//                               narrow-only check refused the derive)
//
// Both error codes fit imm32 with bit 31 clear so `mov rax, imm32`
// emits the 7-byte zero-extending form.  No `and r11, imm64` encoder
// gap.
//
// =============================================================================
// SECTION 3  PACKED-RETURN SHAPE
// =============================================================================
//
// `_ri_bind_peer_to_env` returns a packed u64:
//
//     result = (peer_env_slot << 2) | status
//
// On success status == RI_OK (0) so result == peer_env_slot << 2 and
// the caller recovers peer_env_slot by right-shifting 2 bits.  Valid
// env slot ids live in [0, 6) so (slot << 2) <= 20, DISJOINT from
// every RI_ERR_* value (all >= 0x1D01) so a caller that treats the
// whole word as an errno on error gets the right code.  On error
// peer_env_slot is 0, so result == status.
//
// `_ri_lookup_peer_env` returns a plain u64:
//   * env_slot in [0, 6) on hit
//   * RI_SLOT_NONE (0xFF) on miss (unbound conn_id or invalid conn_id)
//
// `_ri_revoke_peer_env` returns a plain errno (RI_OK or RI_ERR_BAD_CONN).
//
// =============================================================================
// SECTION 4  WHERE PER-CONN IDENTITY STATE LIVES
// =============================================================================
//
// The ri_pool is a 4-row side table keyed by conn_id, matching
// `_remote_shell_pool` row count (RS_POOL_MAX = 4).  Row stride is
// 32 bytes = 2^5 so `shl rax, 5` suffices.  Total footprint 128 B,
// 8-byte-aligned fields.
//
//   Row offset  Field               Size   Notes
//   ----------  ------------------  -----  ---------------------------
//   [+0]        fed_id              u64    low 32 = fed_id, hi 32 = 0
//   [+8]        peer_index          u64    full 64 bits (bounded by
//                                           _fd_peer_lookup to <8)
//   [+16]       env_slot            u64    low 8 = slot id (0..5),
//                                           hi 56 = 0
//   [+24]       in_use              u64    0 = free, 1 = bound; written
//                                           LAST on bind, cleared LAST
//                                           on revoke (same publication
//                                           contract as every other
//                                           pool row in this stack)
//
// .bss zero-init gives every row in_use == 0 at boot: no identity
// mapping is active until a server task calls _ri_bind_peer_to_env.
//
// =============================================================================
// SECTION 5  INTERACTION WITH M2 HANDSHAKE
// =============================================================================
//
// M2's `_rsh_accept_server` / `_rsh_init_client` transitions the row
// to ESTABLISHED and stamps mlkem_ss.  Neither call touches ri_pool:
// the handshake is an authentication primitive, not an authorisation
// primitive.  After ESTABLISHED a server task MAY (but need not) call
// `_ri_bind_peer_to_env` to grant the peer local authority.
//
// A connection that completes M2 but never calls M5 bind is a
// listen-only wire: the peer can send records (M4 send/recv works
// without ri_pool) but the dispatcher's cap-check at M6 refuses them
// because `_ri_lookup_peer_env` returns RI_SLOT_NONE.
//
// =============================================================================
// SECTION 6  INTERACTION WITH M3 FEDERATION DISCOVERY
// =============================================================================
//
// `_fd_peer_lookup(fed_id, peer_index)` is M3's authentication-level
// witness.  M5 cross-checks the (fed_id, peer_index) pair against M3
// at bind time and refuses binds for peers M3 does not know.  This is
// a POLICY GATE at bind, not a per-recv check -- the ri_pool caches
// the (fed_id, peer_index) pair alongside the env_slot so later wire
// activity does not re-walk the registry.  A peer removed from M3
// AFTER bind retains the identity mapping until an explicit
// `_ri_revoke_peer_env` call; M6+ MAY add a sweep that revokes bindings
// whose M3 witness has disappeared, but M5 does not take that view.
//
// =============================================================================
// SECTION 7  INTERACTION WITH M4 RECORD WIRE
// =============================================================================
//
// `_rrw_recv_frame(conn_id, ...)` decrypts a staged frame but does
// NOT dispatch the plaintext record.  The dispatch arm is deferred to
// R137.M6 (KIND_FEDERATION cap-invoke).  M6's dispatcher will call
// `_ri_lookup_peer_env(conn_id)` BEFORE forwarding the record into
// the kernel's handler table:
//
//     slot = _ri_lookup_peer_env(conn_id)
//     if slot == RI_SLOT_NONE:
//         return RI_ERR_BAD_PEER (dispatch-refused)
//     // use `slot` as the parent cap-env slot when the record's
//     // handler executes a cap-check (open-file, invoke, derive).
//
// The split between M4 (decrypt) and M6 (dispatch with identity) is
// intentional: tests exercise M4 crypto without needing M5 state,
// and M5 state is independently inspectable (bind -> lookup -> revoke
// without needing the crypto wire).
//
// =============================================================================
// SECTION 8  FAILURE-MODE DISCIPLINE (FORWARD TO M6)
// =============================================================================
//
// M5's three error paths each have a distinct failure mode M6 will
// handle differently:
//
//   RI_ERR_BAD_CONN   -- the server task supplied a conn_id for a row
//                        that is free or out of range.  Likely a
//                        bookkeeping bug in the server task; M6 logs
//                        and tears down the server task's view of the
//                        connection.
//
//   RI_ERR_BAD_PEER   -- the (fed_id, peer_index) pair is unknown OR
//                        the server task's env cannot host the derive
//                        (no parent, env frozen, env slots exhausted).
//                        M6 logs and asks the server task to supply a
//                        different parent slot or widen its env budget.
//
//   RI_ERR_WIDEN      -- the server task tried to grant the peer rights
//                        the server task does not itself hold.  M6
//                        logs and REFUSES the bind without retry; this
//                        is a policy error, not a resource error.
//
// =============================================================================
// SECTION 9  ENCODER DISCIPLINE
// =============================================================================
//
// Labels are prefixed `ri_` (remote-identity).  Encoder-pitfall
// posture (feedback_pdx_encoder_pitfalls):
//
//   * cmp rN, 0            (never `test rN, rN`)
//   * shl rN, 5 for stride-32 (ri_pool)
//     shl rN, 6 for stride-64 (federation pool, when dereferencing
//                              _fd_peer_lookup return)
//     (never `imul r, imm`)
//   * mov rax, imm32       (never `and r11, imm64`; the error codes
//                           0x1D01 / 0x1D30 / 0x1D31 all fit imm32)
//   * shift-trick to narrow a 32-bit field inside a packed u64
//     (shl rN, 32 ; shr rN, 32  isolates the low 32 bits without
//     needing an imm64 mask)
//   * single-line `pub let name = "..."`
//   * module basename `RemoteIdentity` matches file basename
//     `remote_identity.pdx`
//   * fingerprint `[u8; N]` with N = string length + 1 (NUL counts)
//
// Stack discipline (SysV, entry rsp%16==8):
//
//   ri_note                  0 pushes (pure leaf stat bump)
//   ri_row_base              0 pushes (pure leaf address compute)
//   ri_check_conn            0 pushes (pure leaf: bounds + in_use)
//
//   _ri_bind_peer_to_env     5 pushes (rbx=conn_id, r12=fed_id,
//                                       r13=peer_index,
//                                       r14=parent_cap_env_slot,
//                                       r15=rights_mask) + sub rsp,16
//                                       (one 8-byte spill for the
//                                       cap-minter out_slot_ptr, plus
//                                       8 bytes pad).  Entry rsp%16==8;
//                                       +5 pushes = %16==0; sub rsp,16
//                                       = %16==0 at every nested call.
//
//   _ri_lookup_peer_env      0 pushes (pure leaf; bounds + in_use +
//                                       env_slot read).
//
//   _ri_revoke_peer_env      1 push   (rbx = conn_id) + 0 pad.  Entry
//                                       %16==8; +1 push = %16==0 at
//                                       the nested klog_s1_x1 call.
//
// =============================================================================
// SECTION 10 BOOT WIRING NOTE
// =============================================================================
//
// `kernel_main.pdx` does NOT call an _ri_init at boot.  M5 declares
// no runtime bringup state; the ri_pool and the stat counters are
// .bss and zero-initialise naturally.  No endpoint id is claimed.
// No svc_register call is made.  No allowlist entry is required.
//
// Callers wire up at M6 (the dispatch arm) and at the server task's
// own bind-time entry (post-handshake, pre-first-record).
//
// =============================================================================

module RemoteIdentity = structure {

  // ==========================================================================
  // Service identity (documentary only; no broker registration at M5)
  // ==========================================================================

  pub let REMOTE_IDENTITY_NAME_LEN : u64 = 19   // "svc.remote-identity" is 19 bytes
  pub let remote_identity_name : [u8; 20] = "svc.remote-identity\0"

  // ==========================================================================
  // Return band (§2)
  // ==========================================================================

  pub let RI_OK           : u64 = 0
  pub let RI_ERR_BAD_CONN : u64 = 0x1D01     // alias of RS_ERR_BAD_ID
  pub let RI_ERR_BAD_PEER : u64 = 0x1D30
  pub let RI_ERR_WIDEN    : u64 = 0x1D31

  // ==========================================================================
  // Row geometry (§4) -- MUST agree with the row writes below.
  // ==========================================================================

  pub let RI_POOL_MAX   : u64 = 4             // rows (one per remote-shell conn)
  pub let RI_ROW_BYTES  : u64 = 32            // 4 u64 per row
  pub let RI_OFF_FED    : u64 = 0             // fed_id (low 32)
  pub let RI_OFF_PEER   : u64 = 8             // peer_index
  pub let RI_OFF_SLOT   : u64 = 16            // env_slot (low 8)
  pub let RI_OFF_IN_USE : u64 = 24            // in_use (u64)

  // "No binding" sentinel returned by _ri_lookup_peer_env.  Chosen so
  // it collides neither with the valid env_slot range [0, 6) nor with
  // any RI_ERR_* value.
  pub let RI_SLOT_NONE : u64 = 0xFF

  // Mirrored from remote_shell.pdx (RS_POOL_MAX / RS_OFF_IN_USE).  M5
  // uses these to validate conn_id against the remote-shell row pool
  // without taking a cross-module `pub let` dependency.
  pub let RI_RS_POOL_MAX  : u64 = 4
  pub let RI_RS_OFF_IN_USE : u64 = 120

  // Mirrored from cap_minter.pdx (CM_ERR_* / CAP_ENV_SLOTS).  M5
  // depends on these values at the derive-return decode site.
  pub let RI_CM_OK                 : u64 = 0
  pub let RI_CM_ERR_PARENT_INVALID : u64 = 0x0F01
  pub let RI_CM_ERR_RIGHTS_WIDEN   : u64 = 0x0F02
  pub let RI_CM_ERR_ENV_FULL       : u64 = 0x0F03
  pub let RI_CAP_ENV_SLOTS         : u64 = 6

  // Mirrored from federation_discovery.pdx (FD_ERR_* / FD_OK).  M5
  // uses these to decode _fd_peer_lookup's return.
  //
  // _fd_peer_lookup returns:
  //   SUCCESS -- (status<<48) | (remote_ip<<16) | remote_port
  //              where status == FD_OK == 0; the whole packed word is
  //              >= 0x10000 iff remote_ip != 0, OR < 0x10000 iff
  //              remote_ip == 0 (edge case where the packed word
  //              collides numerically with the FD_ERR_* range below).
  //   ERROR   -- FD_ERR_BAD_FED (0x2102) or FD_ERR_BAD_INDEX (0x2103),
  //              returned as a bare u64 (not packed).
  // M5 distinguishes with two explicit cmp-against-error-code tests
  // rather than a mask-and-compare so a legitimate zero-ip zero-port
  // peer entry (ip==0, port==0 -> packed == 0 -> FD_OK) stays on the
  // hit path.
  pub let RI_FD_OK            : u64 = 0
  pub let RI_FD_ERR_BAD_FED   : u64 = 0x2102
  pub let RI_FD_ERR_BAD_INDEX : u64 = 0x2103

  // ==========================================================================
  // Storage
  //
  //   _ri_pool   -- 4 rows x 32 B = 128 B.  Row layout per §4.  .bss
  //                 zero at boot = every row free.
  //   _ri_stats  -- 16 u64 counters (observability).  Slot assignments
  //                 below.
  //
  //   _ri_scratch_slot -- 8 B scratch written by _cap_minter_derive
  //                       (its out_slot_ptr arg).  Address-of lives in
  //                       .rodata-adjacent .bss so a stack-based spill
  //                       is unnecessary at the call site.  Read-once
  //                       on the OK path, overwritten on every bind.
  // ==========================================================================

  pub let mut _ri_pool         : [u64; 16] = uninit @align(64)
  pub let mut _ri_stats        : [u64; 16] = uninit @align(64)
  pub let mut _ri_scratch_slot : u64       = uninit @align(8)

  // ==========================================================================
  // Stats slot assignments
  // ==========================================================================

  pub let RI_ST_BIND_OK       : u64 = 0
  pub let RI_ST_BIND_BAD_CONN : u64 = 1
  pub let RI_ST_BIND_BAD_PEER : u64 = 2
  pub let RI_ST_BIND_WIDEN    : u64 = 3
  pub let RI_ST_LOOKUP_HIT    : u64 = 4
  pub let RI_ST_LOOKUP_MISS   : u64 = 5
  pub let RI_ST_REVOKE_OK     : u64 = 6
  pub let RI_ST_REVOKE_REJ    : u64 = 7

  // ==========================================================================
  // Fingerprint tags  (N = len(string) + 1, NUL-inclusive)
  //
  // Only the "OK" tags are extracted by the fingerprint-coverage gate;
  // the "REJ" tags are retained for operator diagnostics.
  //
  // "REMOTE_IDENTITY BIND OK"    = 23 chars + NUL => N=24
  // "REMOTE_IDENTITY BIND REJ"   = 24 chars + NUL => N=25
  // "REMOTE_IDENTITY LOOKUP OK"  = 25 chars + NUL => N=26
  // "REMOTE_IDENTITY REVOKE OK"  = 25 chars + NUL => N=26
  // "REMOTE_IDENTITY REVOKE REJ" = 26 chars + NUL => N=27
  // ==========================================================================

  pub let ri_tag_bind_ok     : [u8; 24] = "REMOTE_IDENTITY BIND OK\0"
  pub let ri_tag_bind_rej    : [u8; 25] = "REMOTE_IDENTITY BIND REJ\0"
  pub let ri_tag_lookup_ok   : [u8; 26] = "REMOTE_IDENTITY LOOKUP OK\0"
  pub let ri_tag_revoke_ok   : [u8; 26] = "REMOTE_IDENTITY REVOKE OK\0"
  pub let ri_tag_revoke_rej  : [u8; 27] = "REMOTE_IDENTITY REVOKE REJ\0"

  // KV keys referenced by emission sites.
  pub let ri_k_cid    : [u8; 4] = "cid\0"
  pub let ri_k_slot   : [u8; 5] = "slot\0"
  pub let ri_k_errno  : [u8; 6] = "errno\0"

  // ==========================================================================
  // ri_note(slot) -> ()
  //
  // Bounded increment on _ri_stats[slot].  Load-inc-store, no
  // `add reg,[mem]`.  Pure leaf -- no pushes.  Labels prefixed ri_no_.
  // Mirrors rs_note / rrw_note / ssd_note shape.
  // ==========================================================================
  pub let ri_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M5 (paideia-os #2637): bounded increment on _ri_stats[slot<16]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed ri_no_. Mirrors rs_note / rrw_note shape.",
      block: {
        cmp rdi, 16;
        jae ri_no_out;
        lea r10, [rip + _ri_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ri_no_out:
        ret
      }
    }

  // ==========================================================================
  // ri_row_base(conn_id) -> &_ri_pool[conn_id*32]
  //
  // Row-base compute.  Stride 32 = 2^5 so `shl rax, 5` suffices.
  // Caller validates conn_id first; this helper is a pure leaf.
  // Labels prefixed ri_rb_.
  // ==========================================================================
  pub let ri_row_base : (u64) -> u64 !{} @{} =
    fn (conn_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R137.M5 (paideia-os #2637): conn_id -> &_ri_pool[conn_id*32]. Power-of-two stride uses `shl rax, 5` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates. Labels prefixed ri_rb_. Mirrors rs_row_base shape.",
      block: {
        mov rax, rdi;                    // conn_id
        shl rax, 5;                      // conn_id * 32
        lea r10, [rip + _ri_pool];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // ri_check_rs_conn(conn_id) -> 1 iff conn_id<RI_RS_POOL_MAX AND
  //                              _remote_shell_pool[conn_id].in_use != 0
  //
  // Mirror of rrw_check_conn: validate the conn_id against the OWNING
  // row pool in remote_shell.pdx so a stale/free conn_id cannot pass
  // the bind path.  Pure leaf -- no pushes.  Labels prefixed ri_cc_.
  //
  // The _remote_shell_pool symbol resolves at link time against
  // remote_shell.pdx.
  // ==========================================================================
  pub let ri_check_rs_conn : (u64) -> u64 !{mem} @{} =
    fn (conn_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M5 (paideia-os #2637): 1 iff conn_id<4 AND _remote_shell_pool[conn_id].in_use (word at [+120]) != 0. Pure leaf -- no pushes. Labels prefixed ri_cc_. Mirror of rrw_check_conn shape; stride 256 via shl rax, 8.",
      block: {
        mov r10, 4;                      // RI_RS_POOL_MAX
        cmp rdi, r10;
        jae ri_cc_no;
        mov rax, rdi;
        shl rax, 8;                      // conn_id * 256 (RS row stride)
        lea r10, [rip + _remote_shell_pool];
        add rax, r10;                    // row base in remote_shell pool
        mov r10, [rax + 120];            // in_use word at [+120]
        cmp r10, 0;
        je  ri_cc_no;
        mov rax, 1;
        ret;
      ri_cc_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ri_row_in_use(conn_id) -> 1 iff conn_id<RI_POOL_MAX AND
  //                              _ri_pool[conn_id].in_use != 0
  //
  // Mirror of ri_check_rs_conn but against the ri_pool itself (so a
  // revoke of a never-bound conn_id gets RI_ERR_BAD_CONN).  Pure leaf
  // -- no pushes.  Labels prefixed ri_ru_.
  // ==========================================================================
  pub let ri_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (conn_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M5 (paideia-os #2637): 1 iff conn_id<RI_POOL_MAX(4) AND _ri_pool[conn_id].in_use (word at [+24]) != 0. Pure leaf -- no pushes. Labels prefixed ri_ru_. Stride 32 via shl rax, 5.",
      block: {
        mov r10, 4;                      // RI_POOL_MAX
        cmp rdi, r10;
        jae ri_ru_no;
        mov rax, rdi;
        shl rax, 5;                      // conn_id * 32 (ri row stride)
        lea r10, [rip + _ri_pool];
        add rax, r10;                    // ri row base
        mov r10, [rax + 24];             // in_use word at [+24]
        cmp r10, 0;
        je  ri_ru_no;
        mov rax, 1;
        ret;
      ri_ru_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // _ri_bind_peer_to_env(conn_id, fed_id, peer_index,
  //                      parent_cap_env_slot, rights_mask) -> packed u64
  //
  // Bind a remote peer (identified by fed_id + peer_index on the wire)
  // to a locally-minted sub-cap-env slot inside the server task's
  // active capability environment.
  //
  // ARGS (SysV):
  //   rdi = conn_id              (u64 in [0, 4), MUST reference an
  //                               in-use row in _remote_shell_pool)
  //   rsi = fed_id               (u32 payload, zero-extended; MUST
  //                               reference a federation registered in
  //                               _fd_federation_pool)
  //   rdx = peer_index           (u64; MUST be < federation.peer_count)
  //   rcx = parent_cap_env_slot  (u64 in [0, 6); slot in server task's
  //                               active env holding the authority band
  //                               the peer may act within)
  //   r8  = rights_mask          (bit mask, 64 bits; subset of
  //                               parent_rights)
  //
  // RETURNS (rax):  packed u64
  //   On success:  (peer_env_slot << 2) | RI_OK  (= peer_env_slot * 4;
  //                                                recoverable via
  //                                                `shr rax, 2`)
  //   RI_ERR_BAD_CONN  -- conn_id out of range or remote_shell row free
  //   RI_ERR_BAD_PEER  -- fed_id/peer_index not registered, OR cap-
  //                        minter PARENT_INVALID / ENV_FULL
  //   RI_ERR_WIDEN     -- rights_mask not a subset of parent_rights
  //
  // STEP-BY-STEP:
  //   (1) ri_check_rs_conn(conn_id) -> if 0 -> RI_ERR_BAD_CONN.
  //   (2) _fd_peer_lookup(fed_id, peer_index); on hit the packed
  //       return (status<<48 | remote_ip<<16 | remote_port) has
  //       status == FD_OK == 0, and M5 ignores the packed body; on
  //       miss the return is a bare u64 == FD_ERR_BAD_FED (0x2102) or
  //       FD_ERR_BAD_INDEX (0x2103).  M5 compares rax against both
  //       error literals explicitly (not a low-16 mask) so a zero-ip
  //       zero-port peer entry (which packs to 0 == FD_OK) stays on
  //       the hit path.  Either error -> RI_ERR_BAD_PEER.
  //   (3) Call _cap_minter_derive(parent_cap_env_slot, rights_mask,
  //       &_ri_scratch_slot).  Decode:
  //         CM_OK (0)                  -> load _ri_scratch_slot into
  //                                        peer_env_slot and proceed.
  //         CM_ERR_RIGHTS_WIDEN (0x0F02) -> RI_ERR_WIDEN.
  //         CM_ERR_PARENT_INVALID (0x0F01) / CM_ERR_ENV_FULL (0x0F03)
  //                                      -> RI_ERR_BAD_PEER (the peer
  //                                        cannot be bound under the
  //                                        supplied parent).
  //   (4) Write ri_pool row at conn_id:
  //         [+0]   = fed_id (zero-extended u32)
  //         [+8]   = peer_index
  //         [+16]  = peer_env_slot
  //         [+24]  = 1   (in_use, LAST so a concurrent scanner sees
  //                       the row as free OR fully initialised)
  //   (5) Bump RI_ST_BIND_OK; emit `REMOTE_IDENTITY BIND OK cid=...`.
  //   (6) Return (peer_env_slot << 2) | RI_OK.
  //
  // STACK FRAME:
  //   5 callee-save pushes (rbx = conn_id, r12 = fed_id,
  //                          r13 = peer_index, r14 = parent_cap_env_slot,
  //                          r15 = rights_mask) + sub rsp, 16 (one
  //   8-byte spill for peer_env_slot after the derive, 8 bytes pad).
  //
  //   REGISTER MAP:
  //     rbx = conn_id          (steps 1, 4, 5, 6)
  //     r12 = fed_id           (step 2)
  //     r13 = peer_index       (step 2)
  //     r14 = parent_cap_env_slot (step 3)
  //     r15 = rights_mask      (step 3)
  //
  //   STACK SPILL:
  //     [rsp+0] = peer_env_slot (written from _ri_scratch_slot after
  //              step 3, read at steps 4 + 6; carried in a spill
  //              rather than r15 which still holds rights_mask through
  //              the derive call)
  //     [rsp+8] = pad (keeps rsp%16==0)
  //
  //   Entry rsp%16==8; +5 pushes = +40 -> %16==0; +sub16 -> %16==0
  //   (call-ready at every nested call).
  //
  // Labels prefixed ri_bp_.
  // ==========================================================================
  pub let _ri_bind_peer_to_env : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (conn_id: u64) (fed_id: u64) (peer_index: u64)
       (parent_cap_env_slot: u64) (rights_mask: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M5 (paideia-os #2637): bind a remote peer to a locally-minted sub-cap-env slot. Cross-check conn_id against _remote_shell_pool (ri_check_rs_conn, RI_ERR_BAD_CONN on miss); witness peer existence via _fd_peer_lookup (compare rax against FD_ERR_BAD_FED 0x2102 and FD_ERR_BAD_INDEX 0x2103 explicitly; either -> RI_ERR_BAD_PEER); call _cap_minter_derive(parent_cap_env_slot, rights_mask, &_ri_scratch_slot) to mint the sub-cap in the server task's active env (CM_ERR_RIGHTS_WIDEN -> RI_ERR_WIDEN; CM_ERR_PARENT_INVALID / CM_ERR_ENV_FULL -> RI_ERR_BAD_PEER); write the ri_pool row with fed_id (low 32), peer_index, env_slot, then in_use=1 LAST (publication contract); return (peer_env_slot << 2) | RI_OK. Bump RI_ST_BIND_* and emit `REMOTE_IDENTITY BIND OK cid=0x<hex>` on success or BIND REJ errno=0x<hex> on error. Five callee-save pushes (rbx=conn_id, r12=fed_id, r13=peer_index, r14=parent_cap_env_slot, r15=rights_mask) + sub rsp,16 (one 8-byte spill for peer_env_slot after derive, 8 bytes pad). Entry rsp%16==8; +5 pushes = +40 -> %16==0; sub rsp,16 = +56 -> %16==0 at every nested call. Encoder-pitfall posture: cmp rN,0 (never test), shl rN,5 for ri stride-32, shl rN,8 for RS stride-256 (via ri_check_rs_conn), explicit cmp-against-literal for the two FD error codes (never an imm64 mask), mov rax,imm32 for 0x1D01 / 0x1D30 / 0x1D31 and for the FD error immediates. Labels prefixed ri_bp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                     // [rsp+0] = peer_env_slot, [rsp+8] = pad

        mov rbx, rdi;                    // conn_id
        mov r12, rsi;                    // fed_id
        mov r13, rdx;                    // peer_index
        mov r14, rcx;                    // parent_cap_env_slot
        mov r15, r8;                     // rights_mask

        // ---- Step 1: validate conn_id against the remote-shell pool.
        mov rdi, rbx;
        call ri_check_rs_conn;
        cmp rax, 0;
        je  ri_bp_bad_conn;

        // ---- Step 2: witness the peer via _fd_peer_lookup.
        //      _fd_peer_lookup(fed_id, index) returns:
        //        on hit:  (status<<48) | (remote_ip<<16) | remote_port
        //                 -- status == FD_OK == 0; the packed word is
        //                    free-form in [0, 2^48).  Note: a peer with
        //                    ip==0 && port==0 packs to the literal
        //                    value 0, which still means "hit".
        //        on miss: FD_ERR_BAD_FED (0x2102) or FD_ERR_BAD_INDEX
        //                 (0x2103) -- returned as a bare u64.
        //      M5 compares against each error value explicitly so a
        //      zero-packed success (ip==0, port==0) does NOT collide
        //      with the error branch, and a legitimate port == 0x2102
        //      or 0x2103 at ip==0 does NOT shadow an error (the status
        //      byte in high 16 is 0 on success and the error codes
        //      themselves have their value fully in the low 14 bits so
        //      a zero-high-16 success does not coincide numerically
        //      with 0x2102 unless port == 0x2102 && ip == 0, which the
        //      cmp against the literal value correctly treats as a
        //      miss -- but that is a NON-ISSUE because _fd_peer_
        //      register refuses port==0 at register time, so a
        //      legitimate peer entry never packs to a value in the
        //      0x2102..0x2103 range.
        mov rdi, r12;                    // fed_id
        mov rsi, r13;                    // peer_index
        call _fd_peer_lookup;
        mov r10, 0x2102;                 // FD_ERR_BAD_FED
        cmp rax, r10;
        je  ri_bp_bad_peer;
        mov r10, 0x2103;                 // FD_ERR_BAD_INDEX
        cmp rax, r10;
        je  ri_bp_bad_peer;

        // ---- Step 3: mint the sub-cap via _cap_minter_derive.
        //      Scratch target for the out_slot_ptr.
        mov rdi, r14;                    // parent_cap_env_slot
        mov rsi, r15;                    // rights_mask
        lea rdx, [rip + _ri_scratch_slot];
        call _cap_minter_derive;

        // Fast-path CM_OK (= 0).
        cmp rax, 0;
        je  ri_bp_derive_ok;

        // Error decode.
        mov r11, 0x0F02;                 // CM_ERR_RIGHTS_WIDEN
        cmp rax, r11;
        je  ri_bp_widen;
        // Everything else (PARENT_INVALID / ENV_FULL) collapses to
        // RI_ERR_BAD_PEER by policy; see Section 2.
        jmp ri_bp_bad_peer;

      ri_bp_derive_ok:
        // Load peer_env_slot out of _ri_scratch_slot into our spill.
        lea r10, [rip + _ri_scratch_slot];
        mov r11, [r10 + 0];
        mov [rsp + 0], r11;              // spill peer_env_slot

        // ---- Step 4: write the ri_pool row.
        //      Row base = _ri_pool + conn_id * 32.
        mov rax, rbx;
        shl rax, 5;                      // conn_id * 32
        lea r10, [rip + _ri_pool];
        add rax, r10;                    // rax = row base

        // Field writes.  in_use LAST.
        //  Zero-extend fed_id (r12 holds u32-payload-in-u64; low 32 is
        //  the value, high 32 is already clear via SysV ABI).
        mov [rax + 0],  r12;             // fed_id
        mov [rax + 8],  r13;             // peer_index
        mov r11, [rsp + 0];
        mov [rax + 16], r11;             // peer_env_slot
        mov r11, 1;
        mov [rax + 24], r11;             // in_use = 1 LAST

        // ---- Step 5: bump stat + emit fingerprint.
        mov rdi, 0;                      // RI_ST_BIND_OK
        call ri_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_bind_ok];
        lea rcx, [rip + ri_k_cid];
        mov r8,  rbx;                    // conn_id in hex KV
        call klog_s1_x1;

        // ---- Step 6: pack (peer_env_slot << 2) | RI_OK and return.
        //      RI_OK == 0 so result == peer_env_slot << 2.
        mov rax, [rsp + 0];
        shl rax, 2;                      // peer_env_slot << 2

        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ri_bp_bad_conn:
        mov rdi, 1;                      // RI_ST_BIND_BAD_CONN
        call ri_note;

        mov r12, 0x1D01;                 // RI_ERR_BAD_CONN

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_bind_rej];
        lea rcx, [rip + ri_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ri_bp_bad_peer:
        mov rdi, 2;                      // RI_ST_BIND_BAD_PEER
        call ri_note;

        mov r12, 0x1D30;                 // RI_ERR_BAD_PEER

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_bind_rej];
        lea rcx, [rip + ri_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ri_bp_widen:
        mov rdi, 3;                      // RI_ST_BIND_WIDEN
        call ri_note;

        mov r12, 0x1D31;                 // RI_ERR_WIDEN

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_bind_rej];
        lea rcx, [rip + ri_k_errno];
        mov r8,  r12;
        call klog_s1_x1;

        mov rax, r12;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _ri_lookup_peer_env(conn_id) -> env_slot | RI_SLOT_NONE
  //
  // Fast-path lookup used by the M6 dispatch arm to find the peer's
  // sub-cap-env slot before forwarding a decrypted record into the
  // kernel's handler table.
  //
  // ARGS (SysV):
  //   rdi = conn_id (u64)
  //
  // RETURNS (rax):
  //   env_slot in [0, 6)   -- the peer's sub-cap-env slot in the server
  //                            task's active env
  //   RI_SLOT_NONE (0xFF)  -- conn_id out of range, OR ri_pool row
  //                            not in_use (no binding).  A caller that
  //                            compares `rax == 0xFF` for miss gets a
  //                            single-byte compare.
  //
  // STEP-BY-STEP:
  //   (1) If conn_id >= RI_POOL_MAX -> RI_SLOT_NONE.
  //   (2) Load _ri_pool[conn_id].in_use at [+24].  If 0 -> RI_SLOT_NONE.
  //   (3) Load _ri_pool[conn_id].env_slot at [+16].  Return it.
  //
  // STACK FRAME:
  //   Pure leaf -- 0 pushes.  Entry rsp%16==8; no nested call.
  //
  // Labels prefixed ri_lk_.
  //
  // Note: _ri_lookup_peer_env does NOT bump stat counters on the hot
  // path (one indirection per record is enough; a counter write would
  // double the memory footprint of the lookup).  M6's dispatcher may
  // emit telemetry around the lookup if required.
  // ==========================================================================
  pub let _ri_lookup_peer_env : (u64) -> u64 !{mem} @{} =
    fn (conn_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R137.M5 (paideia-os #2637): O(1) lookup from conn_id to the peer's sub-cap-env slot. Validate conn_id<RI_POOL_MAX (4); miss -> RI_SLOT_NONE (0xFF). Load row.in_use at [+24]; if 0 -> RI_SLOT_NONE. Else load row.env_slot at [+16] and return. Pure leaf -- no pushes, no stat bump. Labels prefixed ri_lk_. Stride 32 via shl rax, 5.",
      block: {
        mov r10, 4;                      // RI_POOL_MAX
        cmp rdi, r10;
        jae ri_lk_miss;

        // Row base = _ri_pool + conn_id * 32.
        mov rax, rdi;
        shl rax, 5;
        lea r10, [rip + _ri_pool];
        add rax, r10;

        // in_use check.
        mov r10, [rax + 24];
        cmp r10, 0;
        je  ri_lk_miss;

        // Hit: load env_slot and return.
        mov rax, [rax + 16];
        ret;

      ri_lk_miss:
        mov rax, 0xFF;                   // RI_SLOT_NONE
        ret
      }
    }

  // ==========================================================================
  // _ri_revoke_peer_env(conn_id) -> errno
  //
  // Tear down a previously-bound identity mapping.  Called from the
  // deferred M6 wire-up of `_remote_shell_close` (and by any explicit
  // revoke call a server task issues).
  //
  // ARGS (SysV):
  //   rdi = conn_id
  //
  // RETURNS (rax):
  //   RI_OK            -- row cleared.
  //   RI_ERR_BAD_CONN  -- conn_id out of range or row already free.
  //
  // STEP-BY-STEP:
  //   (1) ri_row_in_use(conn_id) -> if 0 -> RI_ERR_BAD_CONN.
  //   (2) Zero fed_id (+0), peer_index (+8), env_slot (+16).  These
  //       are defence-in-depth: they MUST NOT leak into a subsequent
  //       bind on the same conn_id.
  //   (3) Clear in_use (+24) LAST so a concurrent lookup either sees
  //       the row as live (and reads the still-valid env_slot) OR as
  //       fully free (and returns RI_SLOT_NONE).  The ri_pool mirrors
  //       the "clear in_use LAST" discipline every other pool row in
  //       this stack follows.
  //   (4) Note: M5 does NOT release the sub-cap in the cap-minter's
  //       cap_table; the slot reclaims when the active env is destroyed,
  //       or when a later bind on the same conn_id overwrites the slot
  //       via a fresh _cap_minter_derive.  See Section 1 (trust-
  //       boundary posture).
  //   (5) Bump RI_ST_REVOKE_OK; emit `REMOTE_IDENTITY REVOKE OK
  //       cid=0x<hex>`.
  //   (6) Return RI_OK.
  //
  // STACK FRAME:
  //   1 callee-save push (rbx = conn_id).  Entry rsp%16==8; +1 push
  //   -> %16==0 at the nested ri_row_in_use + klog_s1_x1 calls.
  //
  // Labels prefixed ri_rv_.
  // ==========================================================================
  pub let _ri_revoke_peer_env : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (conn_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R137.M5 (paideia-os #2637): revoke a bound identity mapping. Validate conn_id via ri_row_in_use (RI_ERR_BAD_CONN on miss); zero fed_id, peer_index, env_slot; clear in_use LAST (ordering mirrors _remote_shell_close discipline). The sub-cap itself remains in the active env's cap_table (there is no cap-minter revoke primitive at M5); the slot reclaims when the env is destroyed or on a later bind for the same conn_id. Bump RI_ST_REVOKE_* and emit `REMOTE_IDENTITY REVOKE OK cid=0x<hex>` on success or REVOKE REJ errno=0x<hex> on error. One callee-save push (rbx=conn_id) parks the id across the nested ri_row_in_use + klog calls (entry %16==8, +1 push -> %16==0 call-ready). Encoder-pitfall posture: cmp rN,0 (never test), shl rN,5 for ri stride-32, mov rax,imm32 for 0x1D01. Labels prefixed ri_rv_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // conn_id

        // (1) Validate.
        mov rdi, rbx;
        call ri_row_in_use;
        cmp rax, 0;
        je  ri_rv_bad_conn;

        // Row base.
        mov rax, rbx;
        shl rax, 5;                      // conn_id * 32
        lea r10, [rip + _ri_pool];
        add rax, r10;

        // (2) Zero the field words.
        xor r11, r11;
        mov [rax + 0],  r11;             // fed_id = 0
        mov [rax + 8],  r11;             // peer_index = 0
        mov [rax + 16], r11;             // env_slot = 0
        // (3) Clear in_use LAST.
        mov [rax + 24], r11;             // in_use = 0

        // (5) Note + emit.
        mov rdi, 6;                      // RI_ST_REVOKE_OK
        call ri_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_revoke_ok];
        lea rcx, [rip + ri_k_cid];
        mov r8,  rbx;
        call klog_s1_x1;

        // (6) RI_OK.
        xor rax, rax;
        pop rbx;
        ret;

      ri_rv_bad_conn:
        mov rdi, 7;                      // RI_ST_REVOKE_REJ
        call ri_note;

        mov r11, 0x1D01;                 // RI_ERR_BAD_CONN
        mov rbx, r11;                    // park errno (rbx repurposed on error path)

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ri_tag_revoke_rej];
        lea rcx, [rip + ri_k_errno];
        mov r8,  rbx;
        call klog_s1_x1;

        mov rax, rbx;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // BOOT-WIRING NOTE
  //
  // No _ri_init is required.  M5 declares no runtime bringup state:
  // _ri_pool (128 B) and _ri_stats (128 B) are .bss and zero-initialise
  // at real boot.  No endpoint id is claimed; no svc_register call is
  // made; no allowlist entry is added to the build gate.
  //
  // Callers wire up at M6 (the KIND_FEDERATION cap-invoke dispatch arm
  // that consults _ri_lookup_peer_env before forwarding records) and
  // at the server task's own post-handshake bind-time entry.
  //
  // See design/shell/remote-identity-mapping.md for the full design
  // (trust-boundary semantics, interaction with M2 handshake, M3
  // discovery, M4 wire, forward path into M6+ dispatch).
  // ==========================================================================
}
