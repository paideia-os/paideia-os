// src/kernel/core/int/dump.pdx — M3-001 (#689) exception frame dump
// Issue: #689
// [unsafe] — dumps structured trap frame fields to klog at PANIC level
// Audit: design/kernel/kernel-logging-substrate.md §5.3
//
// M3-001 exception frame logging. Reads trap frame fields from caller-provided
// pointer (frame_ptr, which holds the rsp at trampoline _typed_handler_6's
// post-pushes checkpoint) and emits three PANIC-level structured log lines via
// klog_s1_x4 (vec/err/rip/cs), klog_s1_x3 (rfl/rsp/ss), and conditional
// klog_s1_x1 (cr2 iff vec==14). Frame offsets +120..+168 from frame_ptr register.
//
// Register discipline:
// - Preserves rbx, r12-r15.
// - Clobbers rax, rcx, rdx, rsi, rdi, r8-r11, r13-r14.
// - Prologue: push rbp; mov rbp, rsp; push r13; push r14; mov r13, rdi.
// - After 3 pushes, rsp % 16 == 0. Prepend sub rsp,8 before klog_s1_x4/x3
//   stack arg pushes to maintain rsp ≡ 0 mod 16 immediately before call.
// - klog_s1_x* preserve r12-r15 across the nested calls.
//
// Not wired to exc_handle yet; call-site integration is #690.

module Dump = structure {

  pub let klog_dump_trap_frame : (u64) -> () !{sysreg, mem} @{} =
    fn (frame_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M3-001 exception frame dump. Load trap frame fields at offsets +120..+168 from frame_ptr (rdi). Emit three PANIC-level structured lines: (1) klog_s1_x4 for vec/err/rip/cs; (2) klog_s1_x3 for rfl/rsp/ss; (3) conditional klog_s1_x1 for cr2 iff vec==14. Prologue saves rbp/r13/r14 and holds frame_ptr in r13 across klog wrapper calls (which preserve r12-r15). Stack alignment: after 3 pushes, rsp % 16 == 0; prepend sub rsp,8 before x4/x3 arg pushes, add rsp,8 on cleanup. Epilogue restores r14/r13/rbp.",
      block: {
        push rbp;
        mov rbp, rsp;
        push r13;
        push r14;
        mov r13, rdi;                  // r13 = frame_ptr (survives klog_s1_x* calls)

        // ====================================================================
        // Load trap frame fields
        // ====================================================================
        // vec @ frame_ptr + 120
        mov rax, [r13 + 120];
        mov r14, rax;                  // r14 = vec (survives nested calls)

        mov rax, [r13 + 128];          // err @ frame_ptr + 128
        mov r8, rax;                   // r8 = err (for klog_s1_x4)

        mov rax, [r13 + 136];          // rip @ frame_ptr + 136
        mov r9, rax;                   // r9 = rip (for klog_s1_x4)

        mov rax, [r13 + 144];          // cs @ frame_ptr + 144
        mov r10, rax;                  // r10 = cs (for klog_s1_x4)

        // ====================================================================
        // Emit first line: klog_s1_x4(PANIC, INT_, tag_trap_frame,
        //                             k_vec, vec, k_err, err, k_rip, rip, k_cs, cs)
        // ====================================================================
        // Stack alignment: after 3 pushes (rbp/r13/r14), rsp % 16 == 8.
        // Need to subtract 8 more bytes to align rsp ≡ 0 mod 16 before klog_s1_x4 call.
        sub rsp, 8;

        // Push args in reverse order: v4, k4, v3, k3, v2 (for SysV ABI)
        // v4 = cs (in r10)
        mov rax, r10;
        push rax;

        // k4 = k_cs
        lea rax, [rip + k_cs];
        push rax;

        // v3 = rip (in r9)
        mov rax, r9;
        push rax;

        // k3 = k_rip
        lea rax, [rip + k_rip];
        push rax;

        // v2 = err (in r8)
        mov rax, r8;
        push rax;

        // Call klog_s1_x4(PANIC, INT_, tag_trap_frame, k_vec, vec, k_err, err, ...)
        mov rdi, 0;                    // level = PANIC
        lea rsi, [rip + SUBSYS_INT_];  // subsys
        lea rdx, [rip + tag_trap_frame]; // tag
        lea rcx, [rip + k_vec];        // k1
        mov r8, r14;                   // v1 = vec (from r14)
        lea r9, [rip + k_err];         // k2
        call klog_s1_x4;

        add rsp, 40;                   // pop 5 args
        add rsp, 8;                    // undo sub rsp, 8 alignment adjustment

        // ====================================================================
        // Load remaining frame fields for second line
        // ====================================================================
        mov rax, [r13 + 152];          // rfl @ frame_ptr + 152
        mov r8, rax;                   // r8 = rfl

        mov rax, [r13 + 160];          // rsp @ frame_ptr + 160
        mov r9, rax;                   // r9 = rsp

        mov rax, [r13 + 168];          // ss @ frame_ptr + 168
        mov r10, rax;                  // r10 = ss

        // ====================================================================
        // Emit second line: klog_s1_x3(PANIC, INT_, tag_trap_frame,
        //                              k_rfl, rfl, k_rsp, rsp, k_ss, ss)
        // ====================================================================
        sub rsp, 8;                    // align for klog_s1_x3

        // Push args in reverse order: v3, k3, v2
        mov rax, r10;
        push rax;

        lea rax, [rip + k_ss];
        push rax;

        mov rax, r9;
        push rax;

        mov rdi, 0;                    // level = PANIC
        lea rsi, [rip + SUBSYS_INT_];  // subsys
        lea rdx, [rip + tag_trap_frame]; // tag
        lea rcx, [rip + k_rfl];        // k1
        mov r8, r8;                    // v1 = rfl (already in r8)
        lea r9, [rip + k_rsp];         // k2
        call klog_s1_x3;

        add rsp, 24;                   // pop 3 args
        add rsp, 8;                    // undo sub rsp, 8 alignment adjustment

        // ====================================================================
        // Conditional: if vec == 14, read CR2 and emit third line
        // ====================================================================
        cmp r14, 14;
        jne dump_exit;

        // Read CR2 into rax
        mov rax, cr2;

        // Emit klog_s1_x1(PANIC, INT_, tag_pf, k_cr2, cr2_value)
        mov rdi, 0;                    // level = PANIC
        lea rsi, [rip + SUBSYS_INT_];  // subsys
        lea rdx, [rip + tag_pf];       // tag
        lea rcx, [rip + k_cr2];        // key
        mov r8, rax;                   // value = cr2 (from rax)
        call klog_s1_x1;

        dump_exit:
        pop r14;
        pop r13;
        pop rbp;
        ret;
      }
    }
}
