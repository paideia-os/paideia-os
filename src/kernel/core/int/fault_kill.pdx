// src/kernel/core/int/fault_kill.pdx — R31.M0-1583 (#1583)
//
// A ring-3 fault kills the task, not the machine — and takes the task's
// capabilities with it.
//
// Why this is the arm that matters
// --------------------------------
// #1583 wires process death to the R29 cascade from two places: sys_exit
// and here. They are not equally important.
//
// A process that calls exit has usually finished its work. It is the case
// LEAST likely to be holding an OpRegion window, an I2C claim, or the ACPI
// Global Lock. The process that faults mid-transaction is exactly the one
// that is. Wiring sys_exit alone would pass every test that could be
// written while leaving the real hazard untouched, which is why this file
// exists rather than a comment saying the fault path is future work.
//
// What was here before
// --------------------
// Nothing. Every CPU exception in this kernel ended in exc_handle ->
// klog_panic -> halt, with no CPL discrimination anywhere: the only place
// CS.RPL was read was the KPTI plumbing in isr_trampoline.pdx, and it used
// it to decide swapgs and the CR3 flip, never policy. A #GP raised by a
// ring-3 process therefore stopped the machine.
//
// For a microkernel that is the wrong answer twice over. It is wrong as
// policy — a userspace fault is an ordinary event and the kernel is
// supposed to be the part that survives it — and it is wrong as
// *isolation*, because a machine that halts on a bubble crash has not
// contained the crash, it has been taken down by it.
//
// The decision this file makes
// ----------------------------
// fault_ring3_death_check answers one question: may this fault be turned
// into a task death? It says yes only when all four hold:
//
//   1. The fault came from CPL 3. A ring-0 fault is a kernel-integrity
//      failure and MUST still panic — continuing from one means running the
//      rest of boot on an invariant that has already been observed broken.
//   2. There is a current task. A fault with _current_tcb == 0 happened
//      before the scheduler existed, and there is nothing to kill.
//   3. Its pid is greater than 1. Killing init leaves nothing to schedule
//      and nothing to reap the corpse; a panic names the problem, whereas
//      switching away from a dead init would hang with no diagnosis.
//   4. It is not already a zombie. A fault in a task that has already died
//      means the death path itself faulted, and running it again would
//      recurse. Panic instead — that one really is a kernel bug.
//
// Every declining answer preserves the previous behaviour exactly, which is
// why this can be added to four live exception handlers without changing
// what any of them do today.
//
// The split, and why it is not one function
// -----------------------------------------
// This function performs the revocation and marks the task ZOMBIE, and then
// RETURNS. It does not dequeue and it does not switch. The handler does
// that, in four instructions, guarded by the return value.
//
// The split is what makes the fault path testable. A witness can build a
// trap frame with a ring-3 CS, point _current_tcb at a task it controls,
// call this, and assert on everything that matters: the row unbound, the
// endpoints dead, the clients woken, the node re-armed, the task ZOMBIE
// with a fault-shaped exit status. What it cannot do is survive
// sched_switch_r15 — and it does not have to, because the scheduling tail
// is byte-identical to dispatch_exit's, which every shell smoke mode runs
// on every `exit`.
//
// Fusing the two would have made the whole path untestable and left the
// interesting half — the revocation — witnessed only by a real fault
// arriving at a real moment. That is the shape of an assertion that is
// never observed failing.
//
// Related: design/acpi/crash-isolation.md §4.4's residual. A bubble that
// faults INSIDE the ACPI Global Lock's critical section still strands the
// lock. This path cannot fix that: aml_glk_abandon's bookkeeping lives in
// the dying process's address space, and the kernel cannot execute there.
// Closing it needs ownership evidence that survives the process — the
// journal design in that section — which this path is a precondition for
// but not a substitute for.

module FaultKill = structure {

  // ============================================================================
  // Trap-frame geometry — offsets from the frame pointer the ISR
  // trampolines pass in rdi. Mirrors int/dump.pdx's decoder; named here
  // because a policy decision that reads CS must not read it by literal.
  // ============================================================================

  pub let FAULT_FRAME_OFF_VECTOR : u64 = 120
  pub let FAULT_FRAME_OFF_ERRCODE: u64 = 128
  pub let FAULT_FRAME_OFF_RIP    : u64 = 136
  pub let FAULT_FRAME_OFF_CS     : u64 = 144
  pub let FAULT_FRAME_OFF_RFLAGS : u64 = 152
  pub let FAULT_FRAME_OFF_RSP    : u64 = 160

  // ============================================================================
  // Verdicts
  // ============================================================================

  // Not a ring-3 task fault. The caller must fall through to its existing
  // dump-and-panic path, unchanged.
  pub let FAULT_KILL_DECLINE     : u64 = 0

  // The task is ZOMBIE and its driver authority is revoked. The caller must
  // now dequeue it and switch away, and must NOT return through iretq.
  pub let FAULT_KILL_TERMINATED  : u64 = 1

  // ============================================================================
  // Exit-status encoding
  //
  // A fault death is recorded as FAULT_KILL_STATUS_BASE | vector, so a
  // parent reaping the corpse can tell "died on #GP" from "exited 13".
  // The base is above any exit status a process can pass to sys_exit
  // through the u8 the ABI carries, so the two spaces cannot collide.
  // ============================================================================

  pub let FAULT_KILL_STATUS_BASE : u64 = 0x100

  // ============================================================================
  // fault_ring3_death_check(frame_ptr, vector) -> u64
  //
  // Returns FAULT_KILL_DECLINE (0) or FAULT_KILL_TERMINATED (1).
  //
  // On TERMINATED, and in this order:
  //   1. driver_death_notify(pid) — the authority goes FIRST. If the order
  //      were reversed and something below faulted, the capabilities would
  //      still be live and the task would already be marked dead, which is
  //      precisely the leak this exists to close, reached by a different
  //      route.
  //   2. sys_exit_body(tcb, FAULT_KILL_STATUS_BASE | vector) — the ordinary
  //      termination body: ZOMBIE, exit status, orphan reparenting, parent
  //      wake. Reusing it rather than open-coding is the point: a fault
  //      death and an exit death must leave the task in the SAME state, and
  //      two functions that produce "the same state" drift.
  //
  //      Note that sys_exit_body itself now calls driver_death_notify at
  //      its step 2.6, so the notify above is the SECOND call for this pid
  //      by the time step 2.6 runs — and it resolves nothing, because the
  //      first call consumed the binding. That is not redundancy to be
  //      cleaned up; it is the idempotence property being exercised on
  //      every single fault death, which is the best possible place for it
  //      to be exercised. Doing the notify explicitly here also keeps the
  //      ordering guarantee above true independent of what sys_exit_body
  //      chooses to do.
  //
  //   3. A klog line, so a fault death is visible on the wire. It carries
  //      no "OK" token deliberately: this is an event, not a fingerprint,
  //      and a marker in tools/verify-fingerprint-coverage.sh's emitted set
  //      would need a golden to assert it — which would mean asserting that
  //      a smoke run faults.
  // ============================================================================

  pub let fault_ring3_death_check : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (frame_ptr: u64) (vector: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R31.M0-1583 (#1583): decide whether a CPU exception may be turned into a task death, and if so perform the death. Five pushes (rbx/r12/r13/r14/r15) put rsp at %16 == 0 for every nested call; rbx = frame_ptr, r12 = vector, r13 = current TCB, r14 = pid. Four gates, all declining to the caller's existing panic path so the previous behaviour is preserved exactly wherever the answer is no: (1) trap-frame CS at +144 masked to 3 must equal 3 — a ring-0 fault is a kernel-integrity failure and continuing past one means running on an invariant already observed broken; the mask is RPL and not a comparison against a selector literal, so a future GDT rearrangement cannot silently invert the test. (2) _current_tcb != 0 — a fault before the scheduler exists has no task to kill. (3) pid > 1 — killing init leaves nothing to schedule and nothing to reap, and a panic names that, whereas switching away from a dead init hangs with no diagnosis; the test is `jbe 1` so pid 0 (the reserved sentinel, which a partially-initialised TCB reads as) declines too. (4) state != STATE_ZOMBIE (3) — a fault inside an already-dead task means the death path itself faulted, and re-entering it would recurse; that one genuinely is a kernel bug and must panic. Then, in order: driver_death_notify(pid) FIRST, because the authority must go before the task is marked dead — reversed, a fault in the marking would leave live capabilities on a task already recorded as dead, which is the same leak reached by another route; sys_exit_body(tcb, FAULT_KILL_STATUS_BASE | vector), reused rather than open-coded so a fault death and an exit death cannot drift into producing different task states, and accepted as a SECOND driver_death_notify for this pid (its own step 2.6) which resolves nothing because the first consumed the binding — that is the idempotence property being exercised on every fault death rather than only in a test; klog_s1 at LEVEL_ERROR so the death is on the wire, with a message deliberately carrying no OK token because it is an event and not a fingerprint. Returns FAULT_KILL_TERMINATED; the caller performs runq_dequeue + pick + switch. The split is what makes this testable: a witness can drive it with a synthetic ring-3 frame and a task it controls and assert on the revocation, whereas a fused version could only be witnessed by a real fault at a real moment.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // 5 pushes -> rsp %16 = 0

        mov rbx, rdi;                        // frame_ptr
        mov r12, rsi;                        // vector

        // ---- gate 1: the fault must have come from ring 3 ----
        mov rax, [rbx + 144];                // FAULT_FRAME_OFF_CS
        mov r10, 3;
        and rax, r10;                        // CS.RPL
        cmp rax, 3;
        jne fault_kill_decline;

        // ---- gate 2: there must be a current task ----
        mov r13, [rip + _current_tcb];
        cmp r13, 0;
        je  fault_kill_decline;

        // ---- gate 3: it must not be init (or the pid-0 sentinel) ----
        mov eax, [r13 + 0];                  // TASK_OFF_PID (u32)
        mov r14, rax;
        cmp r14, 1;
        jbe fault_kill_decline;

        // ---- gate 4: it must not already be dead ----
        mov eax, [r13 + 8];                  // TASK_OFF_STATE (u32)
        cmp rax, 3;                          // STATE_ZOMBIE
        je  fault_kill_decline;

        // ---- the authority goes first ----
        mov rdi, r14;
        call driver_death_notify;            // rc discarded; audited inside

        // ---- then the ordinary termination body ----
        mov rdi, r13;                        // current
        mov rsi, r12;                        // vector
        mov r10, 0x100;                      // FAULT_KILL_STATUS_BASE
        or  rsi, r10;                        // status = BASE | vector
        call sys_exit_body;

        // ---- put it on the wire ----
        // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7):
        // in-place rewrite via memo §5.1 option-B bracketed legacy
        // suffix.  No golden asserts `RING3 FAULT: TASK TERMINATED`
        // (grep tests/ returns zero hits) and the marker carries no OK
        // token, so the rewrite is coverage-neutral and golden-neutral.
        // The bracketed `RING3 FAULT` marker preserves operator grep
        // parity for anyone chasing a ring-3 death post-mortem.  Old
        // tag_ring3_fault_kill deleted from keys.pdx (sole consumer).
        mov rdi, 1;                          // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_INT_];
        lea rdx, [rip + tag_ring3_fault_kill_narrative];
        call klog_s1;

        mov rax, 1;                          // FAULT_KILL_TERMINATED
        jmp fault_kill_epilogue;

      fault_kill_decline:
        xor rax, rax;                        // FAULT_KILL_DECLINE

      fault_kill_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
