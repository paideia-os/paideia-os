// src/kernel/core/int/isr_trampoline.pdx — #720 (#656 Phase C)
//
// Infrastructure module for strict-KPTI ISR return path. Adds a shared
// `_isr_return` stub that lives in a new `.text.isr_trampoline` section —
// mappable into user_pml4 (executable, RO, U=0) so ring-3-to-ring-0
// exception dispatch can flip CR3 back to user_pml4 before iretq without
// faulting on unreachable-code-page.
//
// Scope for Phase C (additive):
//   - `_isr_return` — shared iretq epilogue with CPL peek + swapgs + CR3
//     unflip. Currently dead code (no caller wires to it yet).
//   - Entry stubs (`_isr_stub_N`) + IDT gate rewiring + modification of the
//     existing `trampoline_vec*` tails to `jmp _isr_return` are deferred to
//     #721 (#656 Phase D), where they land atomically.
//
// Stack at `_isr_return` entry (5-slot iretq frame — vec + errcode
// placeholder already popped by the caller's `add rsp, 16`):
//   [rsp+0]  = rip
//   [rsp+8]  = cs
//   [rsp+16] = rflags
//   [rsp+24] = rsp (user, if RPL=3)
//   [rsp+32] = ss  (user, if RPL=3)
//
// Ring-3 return: reverse of the entry-stub prologue —
//   1. save rax to trampoline-data scratch slot (needed as a temp for CPL check
//      and for the CR3 imm-load)
//   2. peek saved CS; test RPL == 3
//   3. if from ring-3: reload saved user CR3 from `_user_cr3_save`; swapgs
//   4. restore rax; iretq
//
// The scratch slot `_isr_scratch_rax` and CR3 save slot `_user_cr3_save` are
// added to `src/kernel/core/syscall/trampoline_data.pdx` (mapped in user_pml4
// via PT[261], per #645). Both slots are single-writer — nested NMI/#MC would
// clobber `_isr_scratch_rax` but those vectors are not in the wired set today;
// paranoid-entry is a future concern.
//
// Audit: paideia-os#720 (#656 Phase C).

module IsrTrampoline = structure {

  pub let _isr_return : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { },
    justification: "#720 (#656 Phase C): shared iretq epilogue for strict-KPTI ISR return. Peeks saved CS on the iretq frame at [rsp+8]; if RPL==3, unflips CR3 (reload from _user_cr3_save) and swapgs before iretq. Preserves rax across the CPL check via _isr_scratch_rax scratch slot in the trampoline data page (mapped in user_pml4 via PT[261]). Currently dead code — Phase D (#721) wires callers by modifying existing trampoline_vec* tails to jmp here. Ordering mirrors syscall_entry (entry.pdx L26+56): CR3-then-swapgs on the way out, matching the reverse of entry-stub swapgs-then-CR3.",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je isr_return_kernel;

      mov rax, [rip + _user_cr3_save];
      mov cr3, rax;
      swapgs;

      isr_return_kernel:
      mov rax, [rip + _isr_scratch_rax];
      iretq
    }
  }
}
