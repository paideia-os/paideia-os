// src/kernel/core/int/isr_trampoline.pdx — #720 Phase C + #721 Phase D
//
// Strict-KPTI ISR trampoline. Lives in .text.isr_trampoline (mapped in
// user_pml4 as executable RO by kpti_build_user_pml4) so ring-3-to-ring-0
// exception dispatch can flip CR3 back to kernel_pml4 BEFORE fetching any
// regular .text instruction.
//
// Phase C landed: shared `_isr_return` epilogue with CPL peek + swapgs +
// CR3 unflip.
//
// Phase D adds: 11 entry stubs (`_isr_stub_N` for N in
// {0,3,6,8,13,14,32,33,36,240,241}). Each stub does:
//   1. Save rax to `_isr_scratch_rax` (temp for CPL check + CR3 imm load).
//   2. Peek saved CS at [rsp+CS_OFFSET]; CS_OFFSET = 8 for non-errcode
//      vectors, 16 for errcode vectors (8/13/14).
//   3. Test CS.RPL. If from ring 0: skip swapgs + CR3 flip.
//   4. If from ring 3: swapgs; save user CR3 to `_user_cr3_save`; load
//      kernel CR3 from `_kernel_pml4_pa` (both slots on the KPTI trampoline
//      data page — accessible pre-flip via PT[261] mapping).
//   5. Restore rax; jmp to existing `trampoline_vec_N` (in .text) which now
//      runs under kernel CR3 with the full kernel address space visible.
//
// Return path: existing `trampoline_vec_N` tails are rewritten (in Phase D)
// to `jmp _isr_return` instead of `iretq`. `_isr_return` reverses the flip
// only if CS.RPL was 3.
//
// Singleton caveats (do not multi-task ring-3 without addressing):
//   - `_user_cr3_save` and `_isr_scratch_rax` are single-slot. Preemption
//     from ring-3 that context-switches to another ring-3 task will clobber
//     both. Fine for single-task shell today. Per-task save discipline is a
//     follow-up (deferred pre-multi-task).
//   - `_isr_scratch_rax` is likewise not paranoid-entry-safe. NMI (vec 2)
//     and #MC (vec 18) are NOT in the wired set today; adding them requires
//     paranoid-entry with a per-IST scratch slot.
//
// Labels within each stub function are function-scoped in paideia-as (like
// `no_preempt:` in idt.pdx vec-32). Each stub is its own `pub let`.
//
// Audit: paideia-os#720 (Phase C), paideia-os#721 (Phase D).

module IsrTrampoline = structure {

  pub let _isr_return : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { },
    justification: "#720 (#656 Phase C): shared iretq epilogue for strict-KPTI ISR return. Peeks saved CS on the iretq frame at [rsp+8]; if RPL==3, unflips CR3 (reload from _user_cr3_save) and swapgs before iretq. Preserves rax across the CPL check via _isr_scratch_rax scratch slot in the trampoline data page (mapped in user_pml4 via PT[261]). Ordering mirrors syscall_entry (entry.pdx L26+56): CR3-then-swapgs on the way out, matching the reverse of entry-stub swapgs-then-CR3.",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je isr_return_kernel;

      mov rax, [rip + _user_cr3_save];
      mov cr3, rax;
      swapgs;

      isr_return_kernel:
      mov rax, [rip + _isr_scratch_rax];
      iretq
    }
  }

  // ==== Phase D entry stubs ====
  // Non-errcode vectors: CS at [rsp+8]. Errcode vectors: CS at [rsp+16].

  pub let _isr_stub_0 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 0 (#DE, no CPU-pushed errcode; CS at [rsp+8]). Ring-3 branch: swapgs, save user CR3 to _user_cr3_save, load kernel_pml4_pa into CR3, then jmp trampoline_vec0 (which now runs safely under kernel CR3). Ring-0 branch: skip flip, jmp directly. rax preserved via _isr_scratch_rax (trampoline data page, pre-flip readable).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub0_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub0_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec0
    }
  }

  pub let _isr_stub_3 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 3 (#BP, no errcode; CS at [rsp+8]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub3_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub3_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec3
    }
  }

  pub let _isr_stub_6 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 6 (#UD, no errcode; CS at [rsp+8]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub6_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub6_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec6
    }
  }

  pub let _isr_stub_8 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 8 (#DF, CPU-pushed errcode; CS at [rsp+16]). Uses IST1 stack (auto-loaded by CPU pre-stub, mapped by Phase A). Errcode-variant CS offset (16 not 8).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 16];
      and rax, 3;
      je stub8_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub8_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec8
    }
  }

  pub let _isr_stub_13 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 13 (#GP, CPU-pushed errcode; CS at [rsp+16]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 16];
      and rax, 3;
      je stub13_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub13_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec13
    }
  }

  pub let _isr_stub_14 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 14 (#PF, CPU-pushed errcode; CS at [rsp+16]). Uses IST2 stack (auto-loaded by CPU pre-stub, mapped by Phase A).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 16];
      and rax, 3;
      je stub14_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub14_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec14
    }
  }

  pub let _isr_stub_32 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 32 (LAPIC timer, no errcode; CS at [rsp+8]). Ring-3 case matters once real user processes run.",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub32_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub32_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec32
    }
  }

  pub let _isr_stub_33 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 33 (LAPIC error/spurious, no errcode; CS at [rsp+8]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub33_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub33_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp trampoline_vec33
    }
  }

  pub let _isr_stub_36 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 36 (UART RX IRQ 4, no errcode; CS at [rsp+8]). Wraps existing _uart_rx_trampoline in rx_trampoline.pdx.",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub36_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub36_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp _uart_rx_trampoline
    }
  }

  pub let _isr_stub_240 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 240 (self-IPI f0, no errcode; CS at [rsp+8]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub240_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub240_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp _ipi_trampoline_f0
    }
  }

  pub let _isr_stub_241 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem }, capabilities: { },
    justification: "#721 Phase D: strict-KPTI entry stub for vec 241 (self-IPI f1, no errcode; CS at [rsp+8]).",
    block: {
      mov [rip + _isr_scratch_rax], rax;
      mov rax, [rsp + 8];
      and rax, 3;
      je stub241_kernel;
      swapgs;
      mov rax, cr3;
      mov [rip + _user_cr3_save], rax;
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      stub241_kernel:
      mov rax, [rip + _isr_scratch_rax];
      jmp _ipi_trampoline_f1
    }
  }
}
