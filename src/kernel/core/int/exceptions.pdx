// src/kernel/core/int/exceptions.pdx — Phase 6 / R6.5-001, R6.5-006
// CPU exception vector constants + handlers (trace + halt)
// Issues: R6.5-001 (#252), R6.5-006 (#257)
//
// Per .plans §2.6:
//   R6.5-001 references exceptions 0..31 handlers installed in the IDT.
//   R6.5-006: vectors 0,3,6,8,13,14 each write a one-line trace to UART and
//     halt the CPU. Page fault (14) additionally reads CR2 for the faulting
//     address. Each handler <= 8 instructions.
//
// HONEST SCOPE (paideia-as 0.6.0): the vector constants and per-vector dispatch
// are real. The trace emission (UART) and the halt loop are gated on the
// uart_puts loop + hlt-loop encoders; CR2 read is gated on the mov-from-CR2
// operand. The privileged halt is in a structured unsafe block.

module Exceptions = structure {
  // ============================================================================
  // Exception vectors
  // ============================================================================
  let EXC_DE  : u64 = 0    // divide error
  let EXC_BP  : u64 = 3    // breakpoint
  let EXC_UD  : u64 = 6    // invalid opcode
  let EXC_DF  : u64 = 8    // double fault (IST)
  let EXC_GP  : u64 = 13   // general protection
  let EXC_PF  : u64 = 14   // page fault (reads CR2)
  let EXC_NMI : u64 = 2
  let EXC_MC  : u64 = 18

  // Does this vector push an error code on the stack? (DF, GP, PF do.)
  // R12-m5-001 note: rewritten from pure-fn nested if-else to unsafe block
  // because paideia-as v0.11.0+19 does not lower pure-fn if-else bodies
  // (paideia-as #913 tracks the elaborator gap).
  let exc_has_error_code : (u64) -> u64 !{} @{} =
    fn (vector: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Return 1 if vector pushes an error code (DF=8, GP=13, PF=14 per Intel SDM Vol 3A 6.13), else 0. Rewritten as unsafe block until paideia-as #913 lands pure-fn if-else lowering.",
      block: {
        cmp rdi, 8;
        je exc_has_error_code_yes;
        cmp rdi, 13;
        je exc_has_error_code_yes;
        cmp rdi, 14;
        je exc_has_error_code_yes;
        mov rax, 0;
        ret;
        exc_has_error_code_yes:
          mov rax, 1;
          ret
      }
    }

  // Does this vector read CR2? (Page fault only.)
  // R12-m5-001 note: rewritten as unsafe block per paideia-as #913.
  let exc_reads_cr2 : (u64) -> u64 !{} @{} =
    fn (vector: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Return 1 if vector reads CR2 (PF=14 only), else 0. Rewritten as unsafe block until paideia-as #913 lands pure-fn if-else lowering.",
      block: {
        cmp rdi, 14;
        je exc_reads_cr2_yes;
        mov rax, 0;
        ret;
        exc_reads_cr2_yes:
          mov rax, 1;
          ret
      }
    }

  // cpu_halt — privileged: stop the CPU after an unrecoverable exception.
  let cpu_halt : () -> () !{sysreg} @{} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: { },
      justification: "Halt the CPU after an unrecoverable exception. Real body: cli; hlt in an infinite loop so a spurious wake re-halts. paideia-as 0.6.0 emits hlt; the cli + loop wrapper is gated on the loop/jmp encoder. Phase 7+ replaces unconditional halt with recoverable page-fault handling.",
      block: {
        hlt
      }
    }

  // exc_handle(vector): the common handler. Emits "EXC HALT" then halts.
  // #679 debug: previously silent cpu_halt hid any unexpected exception.
  // Now emits the generic "EXC HALT\n" line before hlt so post-iretq faults
  // are visible on serial. Per-vector formatting (vector=N, rip=..., cr2=...)
  // is a future improvement gated on int→string helpers.
  let mut last_vector : u64 = 0
  let mut last_cr2_read : u64 = 0
  let exc_handle : (u64) -> u64 !{sysreg, mem} @{} =
    fn (vector: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R6.5-006 common exception halt path + #679 debug + M4-002 (#693) migrate to klog_panic + R51 Phase C (SUBSYS_INT shard, design/kernel/boot-transcript.md §7). Save vector into r12 (callee-saved across klog_panic). Publish r12 to last_vector for post-mortem inspection before calling klog_panic. Call klog_panic(SUBSYS_INT_, tag_exc_halt_narrative) which halts (cli + hlt spin). R51 rewrite: tag_exc_halt (`EXC HALT`) renamed to tag_exc_halt_narrative (`unhandled exception halted [legacy: EXC HALT]`) via memo §5.1 option-B bracketed legacy suffix. klog_panic emits the tag string as the message body, so the tag IS the panic message; the golden tests/logging/expected-panic-dump.txt line 3 (`EXC HALT`) pins the substring, and tools/run-smoke.sh's ordered-substring rule still matches `EXC HALT` inside `[legacy: EXC HALT]`. The bracketed marker is kept per memo §3.5 (`keep the token operators grep for` for panic messages) so an operator searching a captured log for `EXC HALT` still finds it. Old tag_exc_halt deleted from keys.pdx — sole consumer was this file. Effects widened to {sysreg, mem} to cover klog_panic (I/O port write) + memory-store of last_vector. Never returns to caller (klog_panic), so the trailing ret is only there to satisfy paideia-as's block-return shape.",
      block: {
        push r12;
        mov r12, rdi;
        mov [rip + last_vector], r12;
        lea rdi, [rip + SUBSYS_INT_];
        lea rsi, [rip + tag_exc_halt_narrative];
        call klog_panic;
        pop r12;
        ret
      }
    }

  // R6.5-006 + #660 Phase B: read CR2 (the faulting linear address) — page-fault only.
  // paideia-as #1247 (enable CR2 in encode_mov_cr_inst) lets us emit the real
  // opcode. Prior to that fix, this was a `mov rax, rax` placeholder.
  let read_cr2 : () -> u64 !{sysreg} @{} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: { },
      justification: "mov rax, cr2 to obtain the faulting linear address for a page fault, per Intel SDM Vol 3A §4.7 (linear-address-of-fault reporting). CR2 is written by hardware at each #PF and is read via `mov rax, cr2` (opcode 0F 20 D0). paideia-as #1247 enabled this encoder. Ring-0 only; harmless if invoked when no #PF has happened (returns stale value). Used by handle_pf to publish last_cr2_read for downstream diagnostics and (post-#661) pf_handle_cow's fault-VA input.",
      block: {
        mov rax, cr2;
        ret
      }
    }

  // The six named exception handlers. Each writes its trace line and halts.
  // Page fault additionally reads CR2 before halting (Phase 7+ makes PF
  // recoverable; for R7 it traces + halts like the others).
  pub let handle_de : () -> u64 = fn () -> exc_handle(EXC_DE)
  pub let handle_bp : () -> u64 = fn () -> exc_handle(EXC_BP)
  pub let handle_ud : () -> u64 = fn () -> exc_handle(EXC_UD)
  pub let handle_df : () -> u64 = fn () -> exc_handle(EXC_DF)
  pub let handle_gp : () -> u64 = fn () -> exc_handle(EXC_GP)
  pub let handle_pf : () -> u64 = fn () -> {
    let fault_addr : u64 = read_cr2();
    last_cr2_read = fault_addr;
    exc_handle(EXC_PF)
  }

  // ============================================================================
  // Timer Interrupt Handler (R9-m2-004, R10-m2-003)
  // ============================================================================
  // Global tick counter: incremented by each timer interrupt.
  pub let mut _tick_count : u64 = 0

  // Timer ISR (vector 32) handler: R15-M7-566 (#566) — preemptive scheduling.
  //
  // Called from trampoline_vec32 (core/int/idt.pdx) on every LAPIC timer
  // tick (~100 Hz per lapic_timer_init_periodic_count in kernel_main).
  // Procedure:
  //   1. Load _current_tcb; skip everything if unset (pre-sti window).
  //   2. If current is the idle task: jump straight to the preempt-request
  //      tail (handle_timer_set_preempt).  Idle has no budget to consume,
  //      but we must set _preempt_needed so trampoline_vec32's tail evaluates
  //      the runqueue and switches away when a task becomes runnable via IRQ
  //      (e.g. UART RX unblocking a shell).  This is the paideia-os #758
  //      wave-2 fix: pre-#758 the idle-current path skipped straight to ack,
  //      so an IRQ-woken task waited forever behind idle's sti;hlt;jmp.
  //   3. Non-idle: decrement sched_budget (u32 at TCB offset +112) using a
  //      sized 32-bit store (mov_d) so the write does not straddle into
  //      +116..+119.
  //   4. If budget hit 0: reset to SCHED_BUDGET_DEFAULT and fall through to
  //      handle_timer_set_preempt, which sets _preempt_needed = 1.  The
  //      trampoline's post-return preempt tail (core/int/idt.pdx
  //      trampoline_vec32) will then consult sched_pick_next_r15 and, if a
  //      different runnable task exists, invoke sched_switch_r15 to it.
  //      Empty-runq idle ticks are safe: sched_pick_next_r15 returns
  //      _idle_tcb as fallback, and the trampoline's `next == current` guard
  //      catches idle→idle and skips the switch.
  //   5. Rearm the LAPIC timer (no-op in periodic mode; kept for future
  //      TSC-deadline mode migration).
  //   6. Signal EOI to LAPIC.
  //   7. Return to trampoline_vec32 (which pops GPRs + iretq).
  //
  // Field discipline (see design/kernel/r15-m7-566-timer-preempt.md §3.1):
  //   TCB.sched_budget lives at +112 as a u32.  The pre-#566 body used
  //   offset +172 (R11 TCB.budget), which under the R15 task_struct layout
  //   straddled fd_table[0]'s upper half and fd_table[1]'s lower half —
  //   an 8-byte u64 read/write silently corrupted 8 bytes of stdio pointers
  //   on every tick.  The AC survived only because fd∈{1,2} writes routed
  //   through dispatch_write's UART fast-path, bypassing the corrupted
  //   pointer; any read syscall via the vfs would have page-faulted.
  //   #566 fixes both defects: correct offset (+112) and sized store (mov_d).
  //
  // Preemption-safety: this handler runs with IF=0 (IDT gate type 0x8E
  // clears IF on entry).  All memory ops here are on the current TCB slab
  // and two global flags — no runqueue mutation — so a nested timer tick
  // (impossible under IF=0 but a useful invariant) would find only stale
  // snapshots, never partial state.
  pub let handle_timer : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R15-M7-566 (#566) + R17-M5-758 wave-2 (paideia-os #758): R15-correct preemptive timer ISR body. (1) Load _current_tcb into rax; if 0 (pre-sti window during boot before init's _current_tcb publish) jump to ack. (2) If rax == _idle_tcb, jump to handle_timer_set_preempt (idle path — always request preempt so trampoline evaluates runqueue and switches to any IRQ-woken task; empty-runq case is safe because sched_pick_next_r15 falls back to _idle_tcb and the trampoline's `next == current` guard catches idle→idle and no-ops the switch). Pre-#758 wave-2 this jumped straight to handle_timer_ack, deferring runqueue evaluation until idle happened to be preempted for some other reason — which never happened, since idle IS what runs when nothing else is runnable, so an IRQ-woken task like a shell blocked in tty_read waited forever behind idle's sti;hlt;jmp. Wake latency with the new path is bounded by one timer period (~10ms at 100Hz LAPIC), acceptable for interactive latency and cheaper than an eager-switch-from-ISR path (sched_wake from an ISR would require the ring-3-return path to swap in-flight, tracked separately as Phase-9 in sched/wake_block.pdx). (3) Non-idle: decrement sched_budget u32 at rax+112 using a scratch ecx + mov_d sized store — this avoids the pre-#566 defect where a bare `mov [rax+172], rcx` widened to REX.W and corrupted 8 bytes of adjacent fd_table entries. (4) If ecx == 0 after decrement, reset to SCHED_BUDGET_DEFAULT via mov_d and fall through to handle_timer_set_preempt (shared tail with the idle path); else jne to handle_timer_ack. handle_timer_set_preempt sets _preempt_needed = 1 unconditionally — trampoline_vec32's preempt tail consumes the flag. (5) Rearm LAPIC (no-op in periodic mode — call kept for TSC-deadline mode symmetry per lapic_timer_rearm's own note) + apic_eoi. Register discipline: rax scratch (current TCB / _idle_tcb / _preempt_needed base), rcx scratch (budget value / reset constant / flag value), rdi scratch (lapic_timer_rearm arg). All caller-save. No callee-save touched. IF stays 0 throughout (gate-cleared, sti not issued). See design/kernel/r15-m7-566-timer-preempt.md §3.2.",
    block: {
      // (1) rax = _current_tcb; skip if unset
      lea rax, [rip + _current_tcb]
      mov rax, [rax]
      cmp rax, 0
      je handle_timer_ack

      // (2) #758 wave-2: if current == _idle_tcb, jump to preempt-request
      //     tail. Idle has no budget to decrement, but we must request
      //     preemption so the trampoline evaluates the runqueue and picks up
      //     any IRQ-woken task (e.g. UART RX unblocking tty_read → shell).
      //     If the runqueue is empty, sched_pick_next_r15 returns _idle_tcb
      //     and the trampoline's `next == current` guard skips the switch —
      //     cost is one extra call per tick when idle.
      lea rcx, [rip + _idle_tcb]
      mov rcx, [rcx]
      cmp rax, rcx
      je handle_timer_set_preempt

      // (3) Non-idle: decrement sched_budget (u32) at +112 using sized 32-bit store
      mov rcx, 0
      mov rcx, [rax + 112]                    // rcx = budget (only low 4 bytes meaningful)
      sub rcx, 1                              // rcx-- (may underflow low 32 to 0xFFFFFFFF; we
                                              // only care about the low-32 zero test)
      mov_d [rax + 112], rcx                  // write 4 bytes back

      // (4) If low-32 of decrement is 0, budget hit exactly zero — reset + preempt
      and rcx, 0xFFFFFFFF
      cmp rcx, 0
      jne handle_timer_ack

      // Reset budget to SCHED_BUDGET_DEFAULT (must match task_pool.pdx)
      mov rcx, 1000000
      mov_d [rax + 112], rcx

      // Fall through to shared preempt-request tail.

    handle_timer_set_preempt:
      // Set _preempt_needed = 1. Shared tail for the idle-current path (#758
      // wave-2) and the budget-expired path. Clobbers rax (rewritten from
      // current TCB to &_preempt_needed) — safe because everything below
      // uses rdi/rcx only.
      lea rax, [rip + _preempt_needed]
      mov rcx, 1
      mov [rax], rcx

    handle_timer_ack:
      // (5) Rearm + EOI (unchanged behavior — periodic mode auto-reload)
      mov rdi, 100
      call lapic_timer_rearm
      call apic_eoi
      ret
    }
  }

  // ============================================================================
  // R10-m1-002: Typed handler wrappers (called from ISR trampolines)
  // ============================================================================
  // These 7 wrappers receive the trap frame pointer in RDI (per calling
  // convention). Each ignores the frame ptr (R10 trap-frame decode deferred
  // to R11) and dispatches to the corresponding exception handler.

  pub let _typed_handler_0 : (u64) -> () !{sysreg,mem} @{boot,cap,sched} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot,cap,sched},
    justification:"R10-m1-002 + M3-002 (#690) + R31.M0-1583 (#1583): Wrapper for vec 0 (Divide Error). R10 base: receives trap frame ptr in rdi. M3-002 adds: call klog_dump_trap_frame(frame_ptr) at entry to log the exception before dispatch. #1583 adds the ring-3 arm: preserve frame_ptr in callee-saved r12 (the trampoline pushed and will pop all 15 GPRs, so this cannot reach the interrupted task), then fault_ring3_death_check(frame, 0). On DECLINE the previous behaviour runs verbatim — dump, handle_de, panic — so a ring-0 divide error is unchanged. On TERMINATED the task is already ZOMBIE with its driver authority revoked, and the same four-call tail dispatch_exit uses (runq_dequeue, sched_pick_next_r15, sched_switch_r15) abandons the trap frame rather than iretq-ing back into a dead task. The `sub rsp, 8` before each call presents rsp %16 == 0, since a trampoline `call` into this handler leaves entry rsp %16 == 8. Capabilities widened @{boot} -> @{boot, cap, sched}: {cap} from the transitive driver_lifecycle_teardown revocation, {sched} from sys_exit_body's wake and the scheduling tail.",
    block: {
      mov r12, rdi;

      sub rsp, 8;                      // entry rsp%16==8 -> 0 for the call
      mov rdi, r12;
      mov rsi, 0;                      // EXC_DE
      call fault_ring3_death_check;
      add rsp, 8;
      cmp rax, 0;
      jne typed0_terminated;

      mov rdi, r12;
      call klog_dump_trap_frame;
      call handle_de;
      ret;

      typed0_terminated:
      sub rsp, 8;
      mov rdi, [rip + _current_tcb];
      call runq_dequeue;
      call sched_pick_next_r15;
      mov rdi, rax;
      call sched_switch_r15;
      jmp typed0_terminated
    }
  }

  pub let _typed_handler_3 : (u64) -> () !{sysreg,mem} @{boot} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot},
    justification:"R10-m1-002 + M3-002 (#690): Thin wrapper for vec 3 (Breakpoint). R10 base: Receives trap frame ptr in rdi; ignored. M3-002 adds: call klog_dump_trap_frame(frame_ptr) at entry to log the exception before dispatch. Then call handle_bp and return.",
    block: { call klog_dump_trap_frame; call handle_bp; ret }
  }

  pub let _typed_handler_6 : (u64) -> () !{sysreg,mem} @{boot,cap,sched} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot,cap,sched},
    justification:"R10-m1-002 + R14-M3-007c (#650) + M3-002 (#690) + M7-b (#699): Wrapper for vec 6 (Invalid Opcode). R10 base: receives trap frame ptr in rdi; ignored (per R10-m1-002). R14-M3-007c rewrite: check _ud_witness_active flag (set by kernel_main witness block). If set: this is the ud2-in-ring3 witness; save frame_ptr in r12 (callee-saved; klog_s1 preserves it per SysV ABI) -> klog_s1(LEVEL_INFO, SUBSYS_INT_, tag_r14_ud_ok) emits marker -> clear flag -> advance [r12+136] (trap-frame RIP) by 2 past the ud2 opcode -> return to trampoline's iretq epilogue, which resumes ring-3 at RIP+2 (the hlt byte) -> hlt in ring-3 raises #GP -> _typed_handler_13's #652 resume path finishes the run. Else (flag clear): normal #UD path (M3-002: call klog_dump_trap_frame to log frame fields before dispatch), call handle_ud and return. R31.M0-1583 (#1583) adds the ring-3 arm to the NORMAL path only, ordered strictly after the #650 witness check so boot_r14b_ud is untouched: fault_ring3_death_check(r12, EXC_UD) and, on FAULT_KILL_TERMINATED, the four-call tail dispatch_exit uses (runq_dequeue, sched_pick_next_r15, sched_switch_r15) which abandons the trap frame rather than iretq-ing back into a dead task. On DECLINE — every ring-0 #UD — the previous behaviour runs verbatim. It also repairs the klog_dump_trap_frame call, which now receives r12 (the real frame) rather than whatever the preceding klog left in rdi. `sub rsp, 8` presents rsp %16 == 0 at each call, since a trampoline `call` into this handler leaves entry rsp %16 == 8. Capabilities widened @{boot} -> @{boot, cap, sched}: {cap} from the transitive driver_lifecycle_teardown revocation, {sched} from sys_exit_body's wake and the scheduling tail.",
    block: {
      // Save frame_ptr in callee-preserved r12 (survives uart_puts, which
      // clobbers only rax/rcx/rsi/rdi per uart_puts's implementation).
      mov r12, rdi;

      // Ring-3 UD witness path: check flag first.
      lea rax, [rip + _ud_witness_active];
      mov rax, [rax];
      cmp rax, 1;
      jne typed6_normal_ud;

      // One-shot: clear the flag so subsequent #UDs halt normally.
      lea rax, [rip + _ud_witness_active];
      mov rcx, 0;
      mov [rax], rcx;

      // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7):
      // Emit English narrative BEFORE the tag_ud_ok fingerprint.
      // Two-line strategy (§5.1 option A) rather than a bracketed
      // suffix on tag_ud_ok because that tag carries an `OK` token
      // AND is asserted contiguously by
      //   tests/r14b/expected-boot-r14b-ud.txt:8   UD OK
      // A bracketed suffix would leave the OK-token in the marker but
      // change the full string, and verify-fingerprint-coverage.sh
      // matches markers by whole-string startswith/startswith parity
      // (see covered_by in tools/verify-fingerprint-coverage.sh): a new
      // marker `ring-3 #UD witness resumed [legacy: UD OK]` would not
      // be covered by the golden line `UD OK`.  Keeping tag_ud_ok
      // byte-identical preserves both the golden match and the
      // coverage relationship.  Narrative body carries no OK token.
      // Alignment matches the existing tag_ud_ok call style (this
      // handler is entered from trampoline_vec6 with rsp already at
      // the level klog_s1 expects for the fingerprint emit).  r12 is
      // callee-save across klog_s1 so frame_ptr survives.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_INT_];
      lea rdx, [rip + tag_ud_narrative];
      call klog_s1;

      // Emit witness marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_INT_];
      lea rdx, [rip + tag_ud_ok];
      call klog_s1;

      // Advance the CPU-pushed RIP past the 2-byte ud2 opcode.
      // r12 still holds frame_ptr (uart_puts preserved it — SysV callee-save).
      mov rax, [r12 + 136];
      lea rax, [rax + 2];
      mov [r12 + 136], rax;

      // Return to trampoline_vec6, which pops 15 GPRs, adds rsp by 16
      // (discards vector+errcode-placeholder), iretq's back to ring-3 at
      // the new RIP (= original + 2), which is the hlt byte. Ring-3 then
      // raises #GP and _typed_handler_13's #652 witness path finishes the
      // run.
      ret;

      // --- Normal path (M3-002: dump before halt) ---
      typed6_normal_ud:
      // R31.M0-1583 (#1583): a ring-3 #UD kills the task, not the machine.
      // Declines for anything else, so the ring-0 path below is unchanged.
      // r12 still holds frame_ptr; fault_ring3_death_check preserves it.
      sub rsp, 8;                      // entry rsp%16==8 -> 0 for the call
      mov rdi, r12;
      mov rsi, 6;                      // EXC_UD
      call fault_ring3_death_check;
      add rsp, 8;
      cmp rax, 0;
      jne typed6_terminated;

      mov rdi, r12;                    // dump the REAL frame
      call klog_dump_trap_frame;
      call handle_ud;
      ret;

      typed6_terminated:
      sub rsp, 8;
      mov rdi, [rip + _current_tcb];
      call runq_dequeue;
      call sched_pick_next_r15;
      mov rdi, rax;
      call sched_switch_r15;
      jmp typed6_terminated
    }
  }

  pub let _typed_handler_8 : (u64) -> () !{sysreg,mem} @{boot} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot},
    justification:"R10-m1-002 + M3-002 (#690): Thin wrapper for vec 8 (Double Fault). R10 base: Receives trap frame ptr in rdi; ignored. M3-002 adds: call klog_dump_trap_frame(frame_ptr) at entry to log the exception before dispatch. Then call handle_df and return.",
    block: { call klog_dump_trap_frame; call handle_df; ret }
  }

  pub let _typed_handler_13 : (u64) -> () !{sysreg,mem} @{boot,cap,sched} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot,cap,sched},
    justification:"R10-m1-002 + R15-M2-006b (#652) + M3-002 (#690) + M7-b (#699): Wrapper for vec 13 (General Protection). R10 base: receives trap frame ptr in rdi; ignored. R15-M2-006b rewrite: check _ring3_witness_active flag (set by kernel_main witness block). If set: this is the hlt-in-ring3 witness; klog_s1(LEVEL_DEBUG, SUBSYS_INT_, tag_r15_handler_called) at entry unconditionally; then after witness check, klog_s1(LEVEL_DEBUG, SUBSYS_INT_, tag_r15_gp_debug) emits bisection marker; clear flag -> klog_s1(LEVEL_INFO, SUBSYS_INT_, tag_r15_ring3_hello_ok) emits success marker -> swapgs -> mov cr3, _kernel_pml4_pa -> restore rsp -> klog_s1(LEVEL_INFO, SUBSYS_INT_, tag_r15_witness_resumed) emits resumed marker -> call boot_continue_after_ring3 (the extracted tail of kernel_main_64, a real pub top-level symbol) directly, abandoning the trap frame and the trampoline's pop-GPRs/iretq epilogue entirely (RSP0 is a fixed per-CPU stack reused from the top on the next interrupt, so nothing leaks). All klog_s1 calls clobber rdi/rsi/rdx but not rax/rcx/rdx; register liveness verified: args to swapgs/mov cr3/mov rsp/call are read from memory or rcx/rax (callee-saved). A first attempt tried to resume by rewriting the trap frame's RIP field and letting the trampoline's iretq carry on, but that was unsound: a #GP is a fault (CPU saves the RIP of the faulting instruction itself — here the 1-byte user hlt at 0x400000 — not the instruction after it), there is nothing encoded after that byte to skip over, and the intended target (kernel_main_64's old inline resume point) lived in a different module — none of which an arithmetic offset on a user-space RIP could ever reach; paideia-as also has no lea-of-local-label support, which is why the resume target had to become a real top-level function instead. Else (flag clear): normal #GP path (M3-002: call klog_dump_trap_frame to log frame fields before dispatch), call handle_gp and return. R31.M0-1583 (#1583) makes two changes. First, `mov r12, rdi` at the very top preserves frame_ptr BEFORE the unconditional debug klog destroys rdi — the trampoline pushed and will pop all 15 GPRs, so writing r12 here cannot reach the interrupted task, and this repairs the klog_dump_trap_frame call on the normal path, which had been dumping whatever klog_s1 left in rdi rather than the frame. Second, the normal path gains the ring-3 arm, ordered strictly after the #652 witness check so boot_r15_ring3 is untouched: fault_ring3_death_check(r12, EXC_GP) and, on FAULT_KILL_TERMINATED, the four-call tail dispatch_exit uses. This is the vector that matters most — a ring-3 process executing a privileged instruction, reloading a bad segment or touching a non-canonical address arrives here, and until #1583 it stopped the machine. A ring-0 #GP still panics, and that refusal is asserted in tests/kernel/driver/death_witness.pdx sub-test C rather than assumed. Capabilities widened @{boot} -> @{boot, cap, sched}.",
    block: {
      // R31.M0-1583 (#1583): preserve frame_ptr in callee-saved r12 BEFORE
      // the debug klog below destroys rdi. The trampoline pushed all 15
      // GPRs and pops them back on the way out, so writing r12 here cannot
      // reach the interrupted task — same discipline as _typed_handler_6.
      // This also repairs the klog_dump_trap_frame call on the normal path,
      // which had been receiving whatever klog_s1 left in rdi rather than
      // the frame.
      mov r12, rdi;

      // Ring-3 witness path: check flag first
      lea rax, [rip + _ring3_witness_active];
      mov rax, [rax];
      cmp rax, 1;
      jne typed13_normal_gp;

      // One-shot: clear the flag so subsequent #GPs halt normally.
      lea rax, [rip + _ring3_witness_active];
      mov rcx, 0;
      mov [rax], rcx;

      // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7):
      // Emit English narrative BEFORE the tag_ring3_hello_ok fingerprint.
      // Two-line strategy (§5.1 option A) rather than a bracketed
      // suffix on tag_ring3_hello_ok because that tag carries an `OK`
      // token AND is asserted contiguously by five goldens including
      //   tests/r15/expected-boot-r15-ring3.txt:15   RING3 HELLO OK
      //   tests/r14b/expected-boot-r14b-ud.txt:9     RING3 HELLO OK
      //   tests/r17/expected-boot-r17-init.txt:6     RING3 HELLO OK
      // A bracketed suffix would break the covered_by parity in
      // tools/verify-fingerprint-coverage.sh (see UD OK note above).
      // Narrative body carries no OK token.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_INT_];
      lea rdx, [rip + tag_ring3_hello_narrative];
      call klog_s1;

      // Emit witness marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_INT_];
      lea rdx, [rip + tag_ring3_hello_ok];
      call klog_s1;

      // #721 Phase D: the ISR entry stub (_isr_stub_13) already did swapgs
      // + CR3 flip on ring-3 entry, so we must NOT swapgs again here (would
      // double-swap and desync GS). CR3 reload below is redundant-but-
      // idempotent (kept for defensive/documentation clarity). RSP restore
      // is still needed because we're abandoning the ISR frame + 15 saved
      // GPRs on RSP0 and jumping back into the boot-time kernel stack.
      // boot_continue_after_ring3 is a `pub` top-level function (defined in
      // kernel_main.pdx) precisely so it is reachable from this module via
      // an ordinary cross-module call, not a local-label jump.
      mov rax, [rip + _kernel_pml4_pa];
      mov cr3, rax;
      mov rsp, [rip + _kernel_resume_rsp];

      // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7): in-place
      // rewrite via memo §5.1 option-B bracketed legacy suffix.  No
      // golden asserts `WITNESS RESUMED` (grep tests/ returns zero
      // hits) and the marker carries no OK token, so the rewrite is
      // coverage-neutral and golden-neutral.  The bracketed marker
      // preserves operator grep parity with the pre-R51 wire.  Old
      // tag_witness_resumed deleted from keys.pdx.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_INT_];
      lea rdx, [rip + tag_witness_resumed_narrative];
      call klog_s1;

      call boot_continue_after_ring3;

      // Unreachable belt-and-braces (boot_continue_after_ring3 never returns).
      hlt;
      ret;

      // --- Normal path (M3-002: dump before halt) ---
      typed13_normal_gp:
      // R31.M0-1583 (#1583): a ring-3 #GP kills the task, not the machine.
      // This is the vector that matters most: a ring-3 process that
      // executes a privileged instruction, reloads a bad segment, or
      // touches a non-canonical address arrives here, and until now it
      // stopped the machine. Declines for a ring-0 #GP, which must still
      // panic — a kernel-integrity failure is not something to continue
      // past. Ordered AFTER the #652 witness check so boot_r15_ring3 is
      // untouched.
      sub rsp, 8;                      // entry rsp%16==8 -> 0 for the call
      mov rdi, r12;
      mov rsi, 13;                     // EXC_GP
      call fault_ring3_death_check;
      add rsp, 8;
      cmp rax, 0;
      jne typed13_terminated;

      mov rdi, r12;                    // dump the REAL frame
      call klog_dump_trap_frame;
      call handle_gp;
      ret;

      typed13_terminated:
      // The task is ZOMBIE and its driver authority is revoked. Abandon the
      // trap frame and the trampoline's iretq epilogue entirely and switch
      // to another task — the same four-call tail dispatch_exit runs, and
      // for the same reason: returning through iretq would resume a dead
      // task in ring 3 on the instruction that faulted.
      sub rsp, 8;
      mov rdi, [rip + _current_tcb];
      call runq_dequeue;
      call sched_pick_next_r15;
      mov rdi, rax;
      call sched_switch_r15;
      jmp typed13_terminated
    }
  }

  pub let _typed_handler_14 : (u64) -> () !{sysreg,mem} @{boot,cap,sched} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg,mem}, capabilities:{boot,cap,sched},
    justification:"R10-m1-002 + R14b-M5-008 (#660) + R17-M0-727-D8 (#727): Wrapper for vec 14 (Page Fault). R10 base: receives trap frame ptr in rdi. R14b-M5-008 original wiring: only invoked pf_handle_cow when _cow_witness_active flag was set — that gate was witness-only, so real ring-3 CoW faults (post-fork parent's first user-stack write) fell straight through to handle_pf → EXC HALT, blocking init from ever making forward progress past `INIT ENTERED RING3`. R17-M0-727-D8 rewrite: ALWAYS invoke pf_handle_cow first. pf_handle_cow validates the fault shape internally (err_code must be exactly P|W with no reserved bits; leaf PTE must be PRESENT + ~RW + COW; frame refcount must be 1 [fast-flip] or ≥2 [split]); any non-CoW fault is rejected via one of the pf_cow_err_* labels which return PF_HANDLE_KILL (1). Only then do we fall through to the normal handle_pf panic path. The former `_cow_witness_active` flag now only gates verbose klog emission inside pf_handle_cow, not the dispatch. On PF_HANDLE_OK (0), return to trampoline's iretq epilogue and the CPU re-executes the faulting write on the now-writable (or freshly split) page. R31.M0-1583 (#1583) adds the ring-3 arm on the typed14_normal_pf path — i.e. only for faults pf_handle_cow has already REJECTED, so a genuine CoW fault is still resolved and resumed exactly as before: fault_ring3_death_check(r12, EXC_PF) and, on FAULT_KILL_TERMINATED, the four-call tail dispatch_exit uses. A ring-0 page fault still panics; a kernel dereference of a bad pointer is not a userspace event, which is the whole point of the CPL gate. This handler runs on IST3 and the terminated arm abandons it, which is sound for the same reason the #652 resume path in _typed_handler_13 is: an IST stack is a fixed per-CPU region reused from the top on the next entry, so nothing leaks by not unwinding it. Capabilities widened @{boot} -> @{boot, cap, sched}.",
    block: {
      // Preserve frame_ptr in callee-saved r12 (for fallback to handle_pf)
      mov r12, rdi;

      // R17-M0-727-D8 (#727): always attempt CoW resolution first. The old
      // `_cow_witness_active` gate was witness-only; real ring-3 CoW faults
      // (init's first user-stack write after sys_fork stripped RW+set COW
      // via aspace_clone_cow) skipped this call and hit EXC HALT. pf_handle_
      // cow validates the fault shape and returns PF_HANDLE_KILL for any
      // non-CoW fault, so it is safe to invoke unconditionally.
      mov rdi, r12;                    // frame_ptr → rdi
      call pf_handle_cow;
      cmp rax, 0;                      // PF_HANDLE_OK?
      je typed14_return;                // yes — iretq re-executes write

      // KILL — fall through to normal panic path
      jmp typed14_normal_pf;

    typed14_return:
      ret;

    typed14_normal_pf:
      // R31.M0-1583 (#1583): a ring-3 page fault that CoW could not resolve
      // kills the task, not the machine. Ordered AFTER pf_handle_cow, so a
      // genuine CoW fault is still resolved and resumed — only faults that
      // CoW rejected reach here. A ring-0 page fault still panics, which is
      // the whole point of the CPL gate: a kernel dereference of a bad
      // pointer is not a userspace event.
      //
      // This runs on IST3 and abandons it on the terminated arm. That is
      // sound for the same reason _typed_handler_13's #652 resume path is:
      // the IST stack is a fixed per-CPU region reused from the top on the
      // next entry, so nothing leaks by not unwinding it.
      sub rsp, 8;                      // entry rsp%16==8 -> 0 for the call
      mov rdi, r12;
      mov rsi, 14;                     // EXC_PF
      call fault_ring3_death_check;
      add rsp, 8;
      cmp rax, 0;
      jne typed14_terminated;

      mov rdi, r12;                    // dump the REAL frame (rip/err/cr2)
      call klog_dump_trap_frame;
      call handle_pf;
      ret;

    typed14_terminated:
      sub rsp, 8;
      mov rdi, [rip + _current_tcb];
      call runq_dequeue;
      call sched_pick_next_r15;
      mov rdi, rax;
      call sched_switch_r15;
      jmp typed14_terminated
    }
  }

  // Default IPI handler (vec 33): signal EOI and return.
  pub let handle_ipi_default : () -> () !{sysreg} @{boot} = fn () -> unsafe {
    effects:{sysreg}, capabilities:{boot},
    justification:"R10-m1-002: Default IPI handler for vec 33. Signals APIC EOI and returns. Real body: call apic_eoi; ret. Production R11+ replaces this with real IPI dispatch.",
    block: { call apic_eoi; ret }
  }

  pub let _typed_handler_33 : (u64) -> () !{sysreg} @{boot} = fn(frame_ptr: u64) -> unsafe {
    effects:{sysreg}, capabilities:{boot},
    justification:"R10-m1-002: Thin wrapper for vec 33 (IPI). Receives trap frame ptr in rdi; ignored. Calls handle_ipi_default and returns.",
    block: { call handle_ipi_default; ret }
  }
}
