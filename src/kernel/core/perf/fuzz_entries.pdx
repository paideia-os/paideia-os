// src/kernel/core/perf/fuzz_entries.pdx -- UMB-W22 R141.M3 landing
// paideia-os #2647 (umbrella decomposition wave 22).
//
// Kernel-side fuzz-testing entry points. Each entry wraps one parser
// surface (cmd_registry, wit_bridge, stdout_records) with an RDTSC
// bracket so the fuzzer's per-case cost is a first-class microbench
// datum, and dumps the enclosing site via _perf_sink_dump_site after
// each call so a userspace holder of KIND_MICROBENCH can tail the
// perf-sink klog stream and watch (count, min, max, mean) accrete as
// the corpus is drained. The entries themselves are POST-crash: a
// non-zero return from the target parser is the EXPECTED outcome
// (parser-rejects dominate random bytes). A real crash becomes
// observable to the fuzzer at a future milestone when a trampoline
// signal-handler path intercepts #PF/#UD/#DE from within the fuzz
// window and reports the offending byte offset; at R141.M3 that path
// is a stub that always returns 0.
//
// =============================================================================
// SECTION 0  POSTURE
// =============================================================================
//
// Fuzz entries are PURE PERF-INSTRUMENTATION substrate: no capability
// authority of their own (a future KIND_FUZZ cap is the gate that
// reaches here; today only kernel-mode callers exist, so the entries
// are reachable only inside the kernel), no scheduler coupling, no
// cross-core guards. The RDTSC bracket, the stats update, and the
// perf-sink dump all serialise through the microbench harness and
// the klog ring; the fuzz layer itself takes no locks.
//
// =============================================================================
// SECTION 1  ENTRY CATALOG
// =============================================================================
//
// At R141.M3 three entries are registered. Each entry is a shim that
// routes its argument bytes to a specific parser surface:
//
//   id   name          target parser               signature
//   0    fuzz_cmd_reg  _cmd_registry_parse         (buf_ptr, buf_len)
//   1    fuzz_wit_br   _wit_bridge_parse_type_decl (buf_ptr, buf_len,
//                                                     out_ptr, out_cap)
//   2    fuzz_stdout   _stdout_records_feed        (pid, buf_ptr,
//                                                     buf_len)
//
// For entry 1 (wit_bridge), the fuzz shim provides its own 1056-byte
// scratch buffer (_fz_wit_scratch) as the out_schema landing region.
// 1056 = WB_SCRATCH_MAX (WB_MAX_FIELDS=32 + 1 END descriptor * 32 B).
// For entry 2 (stdout_records), the fuzz shim reads the stashed PID
// from _fz_corpus_stdout_pid (default 1) so the corpus runner has a
// well-defined target without threading a pid through its byte loop;
// the direct 3-arg form _fuzz_stdout_records(pid, ...) accepts pid as
// its first argument and bypasses the stash.
//
// Each shim's register plan parks the three "across the parser call"
// values -- start_tsc, site_id, errno -- plus the pre-call args in
// callee-save registers. See the per-function justifications for
// stack-alignment arithmetic.
//
// =============================================================================
// SECTION 2  MONITOR HOOK  --  RDTSC BRACKET + PERF-SINK DUMP
// =============================================================================
//
// Each _fuzz_<entry> call follows the same five-step pattern:
//
//   1. site_id := [rip + _fz_site_<entry>_id]       -- resolved at
//                                                     _fz_init time
//   2. start_tsc := _mb_sample_begin(site_id)       -- rdtsc + pack
//   3. errno := <target parser>(args...)            -- the measured
//                                                     window
//   4. _mb_sample_end(site_id, start_tsc)           -- rdtsc + delta
//                                                     + min/max/sum/
//                                                     ring update
//   5. _perf_sink_dump_site(site_id)                -- one klog line
//                                                     `PERF SITE
//                                                     name=... count=
//                                                     ... min=... max
//                                                     =... mean=...`
//
// The dump at step 5 is per-call rather than per-batch so a userspace
// tail sees progress on every corpus case. Future tunings may hoist
// the dump out of the fuzz window into a periodic timer or defer it
// to _fuzz_run_corpus end-of-pass, but R141.M3 wants the simplest
// observable loop.
//
// =============================================================================
// SECTION 3  CORPUS FORMAT
// =============================================================================
//
// _fuzz_run_corpus(entry_id, corpus_ptr, corpus_len) iterates the
// corpus byte-by-byte, treating every 0x0A ('\n') as a case boundary.
// Each inter-newline run is one case; a final run without a trailing
// '\n' is still fed as a case (tail-flush). cases_run counts every
// case dispatched, including empty (zero-length) cases, which the
// target parsers absorb as "empty input -> parser-reject or zero-
// write ok" with no state change. The newline is NOT included in the
// case bytes.
//
// Example 32-byte corpus (two cases + a tail):
//
//   [command.one]\n[command.two]\n[command.thr
//   ^-------------^   ^------------^   ^---------^
//    case 0 (14 B)     case 1 (13 B)    case 2 (10 B, tail)
//
// cases_run after this corpus runs = 3; first_crash_byte_offset = 0.
//
// =============================================================================
// SECTION 4  RETURN CODES
// =============================================================================
//
// FZ_OK                = 0
// FZ_ERR_BAD_ENTRY     = 0x2400
// FZ_ERR_CORPUS_EMPTY  = 0x2401
//
// Both error codes fit imm32 with bit 31 clear; the error-band base
// 0x2400 is adjacent to PS_ERR_NO_SITES=0x1300 (perf_sink) and
// MB_ERR_BAD_*=0x40000001.. (microbench) but outside both. The
// literal 0x2400 appears elsewhere only in drivers/xhci/slot.pdx as
// an unrelated xHCI control-register value (Enable Slot command,
// (9 << 10) | SlotType=0 = 0x2400) that is never cross-compared
// with an errno word, so the numeric clash is cosmetic.
//
// Each per-entry fuzz shim returns the TARGET PARSER's errno
// verbatim; it does not interpret or re-code the value. The caller
// (a future KIND_FUZZ cap handler, or a kernel-mode test driver)
// decides whether a given errno is a "finding" or an "expected
// reject" based on the parser's own return band.
//
// =============================================================================
// SECTION 5  OBSERVABILITY COUNTERS  --  8 SLOTS
// =============================================================================
//
// _fz_stats[8] via _fz_note(slot). All slots fit imm8:
//
//   FZ_ST_INIT_OK            = 0
//   FZ_ST_CMD_OK             = 1   // _fuzz_cmd_registry tail
//   FZ_ST_WIT_OK             = 2   // _fuzz_wit_bridge tail
//   FZ_ST_STDOUT_OK          = 3   // _fuzz_stdout_records tail
//   FZ_ST_CORPUS_OK          = 4   // _fuzz_run_corpus end-of-pass
//   FZ_ST_CORPUS_BAD_ENTRY   = 5   // _fuzz_run_corpus bad entry gate
//   FZ_ST_CORPUS_EMPTY       = 6   // _fuzz_run_corpus empty gate
//   // slot 7 reserved for M4 crash-trampoline hit counter.
//
// =============================================================================
// SECTION 6  INTERACTION WITH R141.M1 + R141.M2
// =============================================================================
//
// * R141.M1 (microbench): the three fuzz sites are allocated through
//   _mb_site_register(), consuming three of the sixteen MB_MAX_SITES
//   slots. After _mb_init registers cap_invoke (slot 0), _fz_init
//   registers fuzz_cmd_reg (slot 1), fuzz_wit_br (slot 2), fuzz_stdout
//   (slot 3), leaving twelve slots for future R141.M* sites.
// * R141.M2 (perf-sink): the per-call dump reaches klog_emit_core via
//   _perf_sink_dump_site. Each fuzz call emits one 5-KV `PERF SITE`
//   line; _fuzz_run_corpus therefore produces N dump lines for an
//   N-case corpus. A future -tunning milestone may batch dumps.
//
// =============================================================================
// SECTION 7  paideia-as encoder-gap posture
// =============================================================================
//
// * No 2-op `imul r, imm` -- not used.
// * No `and r, imm64` -- not used.
// * All liveness/zero tests use `cmp rN, 0` (never `test rN, rN`).
// * All `pub let` string decls are single-line.
// * Module basename `FuzzEntries` matches file basename
//   `fuzz_entries.pdx`.
// * Every label in this file is prefixed `fz_` (reserved-word
//   discipline -- `loop`/`if`/`let` are keywords).
// * Return constants FZ_OK (0), FZ_ERR_BAD_ENTRY (0x2400),
//   FZ_ERR_CORPUS_EMPTY (0x2401) fit imm32.
// * Byte load `mov_b` with pre-zeroed destination idiom.
// * Packed-return high half via `shl rax, 32` (power-of-two shift).

module FuzzEntries = structure {

  // Error codes (§4).
  pub let FZ_OK                : u64 = 0
  pub let FZ_ERR_BAD_ENTRY     : u64 = 0x2400
  pub let FZ_ERR_CORPUS_EMPTY  : u64 = 0x2401

  // Entry identifiers (§1).
  pub let FZ_ENTRY_CMD_REG : u64 = 0
  pub let FZ_ENTRY_WIT_BR  : u64 = 1
  pub let FZ_ENTRY_STDOUT  : u64 = 2
  pub let FZ_ENTRY_COUNT   : u64 = 3

  // Observability slot indices (§5).
  pub let FZ_ST_INIT_OK          : u64 = 0
  pub let FZ_ST_CMD_OK           : u64 = 1
  pub let FZ_ST_WIT_OK           : u64 = 2
  pub let FZ_ST_STDOUT_OK        : u64 = 3
  pub let FZ_ST_CORPUS_OK        : u64 = 4
  pub let FZ_ST_CORPUS_BAD_ENTRY : u64 = 5
  pub let FZ_ST_CORPUS_EMPTY     : u64 = 6

  // Site-slot sentinel: unresolved until _fz_init runs.
  pub let FZ_SITE_NONE : u64 = 0xFF

  // Default PID for _fuzz_run_corpus's stdout_records dispatch.
  pub let FZ_STDOUT_PID_DEFAULT : u64 = 1

  // wit_bridge scratch budget: WB_SCRATCH_MAX = (WB_MAX_FIELDS+1)*32
  // = (32+1)*32 = 1056. Mirrors the WitBridge module's own scratch.
  pub let FZ_WIT_SCRATCH_BYTES : u64 = 1056

  // -----------------------------------------------------------------
  // Storage
  // -----------------------------------------------------------------
  //
  // Three site-id slots (resolved at _fz_init). Observability. One
  // scratch buffer for wit_bridge's out_schema landing. One stashed
  // pid for the corpus runner's stdout_records dispatch. .bss zero-
  // init puts site-id slots at 0 which is incorrect (0 is cap_invoke's
  // slot!), so _fz_init MUST run before any _fuzz_* entry is reachable
  // -- in practice the kernel_main.pdx boot order ensures this.

  pub let mut _fz_site_cmd_reg_id : u64 = 0xFF
  pub let mut _fz_site_wit_br_id  : u64 = 0xFF
  pub let mut _fz_site_stdout_id  : u64 = 0xFF

  pub let mut _fz_stats : [u64; 8] = uninit @align(64)

  pub let mut _fz_wit_scratch : [u8; 1056] = uninit @align(32)

  pub let mut _fz_corpus_stdout_pid : u64 = 1

  // Fingerprint tags. Byte counts NUL-inclusive per kernel-logging-
  // substrate.md discipline.
  pub let fz_tag_init   : [u8; 16] = "FUZZ ENTRY INIT\0"

  // Site names (NUL-inclusive counts; name_len passed to
  // _mb_site_register is ex-NUL).
  pub let fz_name_cmd_reg : [u8; 13] = "fuzz_cmd_reg\0"
  pub let fz_name_wit_br  : [u8; 12] = "fuzz_wit_br\0"
  pub let fz_name_stdout  : [u8; 12] = "fuzz_stdout\0"

  // ==========================================================================
  // _fz_note(stats_slot) -> ()
  //
  // Bump _fz_stats[slot]. Caller passes FZ_ST_* constants only.
  // ==========================================================================
  pub let _fz_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W22 R141.M3 (#2647): bounded increment on _fz_stats[slot]. Caller passes FZ_ST_* constants (0..6) so no out-of-range path is reachable from the shim surface; the cmp/jae guards against caller-stack corruption only. Pure leaf, no callee-save pushes. Labels prefixed fz_no_.",
      block: {
        cmp rdi, 8;
        jae fz_no_out;
        lea r10, [rip + _fz_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fz_no_out:
        ret
      }
    }

  // ==========================================================================
  // _fz_init() -> ()
  //
  // Register the three fuzz sites with the microbench harness, stash
  // the returned site_ids, and emit a `FUZZ ENTRY INIT` fingerprint
  // via klog_s1. Must run AFTER _mb_init (so _mb_site_count_var is at
  // least 1 and the registry pool has room) and AFTER _perf_sink_init
  // (so perf-sink's INIT fingerprint is already on the wire ahead of
  // the first `FUZZ ENTRY INIT`). The kernel_main.pdx boot order
  // enforces this.
  //
  // Register plan: no callee-save push. Entry rsp%16==8; `sub rsp,8`
  // aligns to rsp%16==0 at every nested call; `add rsp,8` before ret
  // restores.
  // ==========================================================================
  pub let _fz_init : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "UMB-W22 R141.M3 (#2647): fuzz-entry harness boot entry. Registers three sites with _mb_site_register (fuzz_cmd_reg name_len=12, fuzz_wit_br name_len=11, fuzz_stdout name_len=11) and stashes each returned site_id in BSS. Bumps FZ_ST_INIT_OK and emits `FUZZ ENTRY INIT` fingerprint via klog_s1. Four nested calls (three register + one klog) + one _fz_note call = five nested calls. Entry rsp%16==8; `sub rsp,8` aligns to rsp%16==0 at every nested call; `add rsp,8` before ret restores. Labels prefixed fz_in_.",
      block: {
        sub rsp, 8;

        // Site 0: fuzz_cmd_reg.
        lea rdi, [rip + fz_name_cmd_reg];
        mov rsi, 12;
        call _mb_site_register;
        mov [rip + _fz_site_cmd_reg_id], rax;

        // Site 1: fuzz_wit_br.
        lea rdi, [rip + fz_name_wit_br];
        mov rsi, 11;
        call _mb_site_register;
        mov [rip + _fz_site_wit_br_id], rax;

        // Site 2: fuzz_stdout.
        lea rdi, [rip + fz_name_stdout];
        mov rsi, 11;
        call _mb_site_register;
        mov [rip + _fz_site_stdout_id], rax;

        // Observability.
        mov rdi, 0;                      // FZ_ST_INIT_OK
        call _fz_note;

        // Fingerprint `FUZZ ENTRY INIT` via klog_s1 (no KV).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + fz_tag_init];
        call klog_s1;

        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _fuzz_cmd_registry(bytes_ptr, bytes_len) -> errno
  //
  // Fuzz entry for _cmd_registry_parse. Wraps the parser call in a
  // microbench RDTSC bracket and dumps the enclosing site via
  // _perf_sink_dump_site at the tail.
  //
  // Register plan: five callee-save pushes (rbx=bytes_ptr, r12=
  // bytes_len, r13=site_id, r14=start_tsc, r15=errno). Entry rsp%16
  // ==8; +5*8=40 -> rsp%16==(8+40)%16==0 at every nested call. The
  // five values straddle _cmd_registry_parse's caller-save clobber
  // window; errno (r15) is populated from rax immediately after.
  // ==========================================================================
  pub let _fuzz_cmd_registry : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W22 R141.M3 (#2647): fuzz entry 0. Load site_id from _fz_site_cmd_reg_id. Open RDTSC window via _mb_sample_begin(site_id). Call _cmd_registry_parse(bytes_ptr, bytes_len); capture errno. Close window via _mb_sample_end(site_id, start_tsc). Dump the site via _perf_sink_dump_site(site_id). Bump FZ_ST_CMD_OK. Return errno. Five callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=site_id, r14=start_tsc, r15=errno) land rsp%16==0 at every nested call (entry 8 + 40 = 48, 48%16==0). Labels prefixed fz_cr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bytes_ptr
        mov r12, rsi;                    // bytes_len
        mov r13, [rip + _fz_site_cmd_reg_id];

        // Open RDTSC window.
        mov rdi, r13;
        call _mb_sample_begin;
        mov r14, rax;                    // start_tsc

        // Call target parser.
        mov rdi, rbx;
        mov rsi, r12;
        call _cmd_registry_parse;
        mov r15, rax;                    // errno

        // Close RDTSC window.
        mov rdi, r13;
        mov rsi, r14;
        call _mb_sample_end;

        // Dump the site to perf-sink.
        mov rdi, r13;
        call _perf_sink_dump_site;

        // Bump FZ_ST_CMD_OK.
        mov rdi, 1;
        call _fz_note;

        mov rax, r15;                    // return errno

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fuzz_wit_bridge(bytes_ptr, bytes_len) -> errno
  //
  // Fuzz entry for _wit_bridge_parse_type_decl. The target parser
  // takes two extra args (out_schema_ptr, out_schema_cap); the shim
  // supplies its own _fz_wit_scratch[1056] = WB_SCRATCH_MAX buffer so
  // the fuzz corpus can be arbitrary bytes without caller-side setup.
  //
  // Register plan: same 5-push shape as _fuzz_cmd_registry. The two
  // scratch-pointer and -cap values are built on the fly from the
  // module-level _fz_wit_scratch symbol (via lea) and the imm32
  // 1056; neither needs a callee-save slot.
  // ==========================================================================
  pub let _fuzz_wit_bridge : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W22 R141.M3 (#2647): fuzz entry 1. Load site_id from _fz_site_wit_br_id. Open RDTSC window via _mb_sample_begin(site_id). Call _wit_bridge_parse_type_decl(bytes_ptr, bytes_len, &_fz_wit_scratch, 1056); capture errno (packed `fields_written << 32 | status`). Close window via _mb_sample_end. Dump site via _perf_sink_dump_site. Bump FZ_ST_WIT_OK. Return errno. Five callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=site_id, r14=start_tsc, r15=errno) land rsp%16==0 at every nested call (entry 8 + 40 = 48, 48%16==0). Labels prefixed fz_wb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bytes_ptr
        mov r12, rsi;                    // bytes_len
        mov r13, [rip + _fz_site_wit_br_id];

        // Open RDTSC window.
        mov rdi, r13;
        call _mb_sample_begin;
        mov r14, rax;                    // start_tsc

        // Call target parser with scratch buffer.
        mov rdi, rbx;
        mov rsi, r12;
        lea rdx, [rip + _fz_wit_scratch];
        mov rcx, 1056;                   // FZ_WIT_SCRATCH_BYTES
        call _wit_bridge_parse_type_decl;
        mov r15, rax;                    // errno (packed)

        // Close RDTSC window.
        mov rdi, r13;
        mov rsi, r14;
        call _mb_sample_end;

        // Dump the site to perf-sink.
        mov rdi, r13;
        call _perf_sink_dump_site;

        // Bump FZ_ST_WIT_OK.
        mov rdi, 2;
        call _fz_note;

        mov rax, r15;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fuzz_stdout_records(pid, bytes_ptr, bytes_len) -> errno
  //
  // Fuzz entry for _stdout_records_feed. Direct 3-arg form; the pid
  // argument is passed through verbatim so a caller can test the
  // schema-mismatch and bad-pid branches directly.
  //
  // Register plan: six callee-save pushes (rbx=pid, r12=bytes_ptr,
  // r13=bytes_len, r14=site_id, r15=start_tsc, rbp=errno) + sub rsp,8.
  // Entry rsp%16==8; +6*8=48 -> rsp%16==(8+48)%16==8; +8 sub -> rsp
  // %16==0 at every nested call. Six slots are needed because errno
  // and start_tsc both must survive the parser call window (end-call
  // reads start_tsc; return value reads errno), so neither can share
  // a slot.
  // ==========================================================================
  pub let _fuzz_stdout_records : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (pid: u64) (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W22 R141.M3 (#2647): fuzz entry 2. Load site_id from _fz_site_stdout_id. Open RDTSC window via _mb_sample_begin(site_id). Call _stdout_records_feed(pid, bytes_ptr, bytes_len); capture errno. Close window via _mb_sample_end. Dump site via _perf_sink_dump_site. Bump FZ_ST_STDOUT_OK. Return errno. Six callee-save pushes (rbx=pid, r12=bytes_ptr, r13=bytes_len, r14=site_id, r15=start_tsc, rbp=errno) + sub rsp,8 land rsp%16==0 at every nested call (entry 8 + 48 + 8 = 64, 64%16==0). Labels prefixed fz_sr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // pid
        mov r12, rsi;                    // bytes_ptr
        mov r13, rdx;                    // bytes_len
        mov r14, [rip + _fz_site_stdout_id];

        // Open RDTSC window.
        mov rdi, r14;
        call _mb_sample_begin;
        mov r15, rax;                    // start_tsc

        // Call target parser.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _stdout_records_feed;
        mov rbp, rax;                    // errno

        // Close RDTSC window.
        mov rdi, r14;
        mov rsi, r15;
        call _mb_sample_end;

        // Dump the site to perf-sink.
        mov rdi, r14;
        call _perf_sink_dump_site;

        // Bump FZ_ST_STDOUT_OK.
        mov rdi, 3;
        call _fz_note;

        mov rax, rbp;

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fz_run_case(entry_id, bytes_ptr, bytes_len) -> errno
  //
  // Internal dispatcher: _fuzz_run_corpus's inner loop calls this
  // once per corpus case. Routes to _fuzz_cmd_registry (entry 0),
  // _fuzz_wit_bridge (entry 1), or _fuzz_stdout_records with the
  // stashed PID (entry 2). Unknown entry_id returns FZ_ERR_BAD_ENTRY;
  // the outer loop treats that as a dispatch anomaly rather than a
  // parser-level finding (see _fuzz_run_corpus's entry_id gate at
  // the top -- in practice this branch is unreachable from
  // _fuzz_run_corpus but exists for defensive routing when callers
  // reuse _fz_run_case directly).
  //
  // Register plan: one callee-save push (rbx = entry_id). Entry
  // rsp%16==8; +1*8=8 -> rsp%16==(8+8)%16==0 at every nested call.
  // ==========================================================================
  pub let _fz_run_case : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (entry_id: u64) (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W22 R141.M3 (#2647): dispatcher for _fuzz_run_corpus's inner loop. Switch on entry_id in rdi: 0 -> _fuzz_cmd_registry(rsi, rdx); 1 -> _fuzz_wit_bridge(rsi, rdx); 2 -> _fuzz_stdout_records([_fz_corpus_stdout_pid], rsi, rdx); other -> FZ_ERR_BAD_ENTRY. One callee-save push (rbx = entry_id) lands rsp%16==0 at every nested call (entry 8 + 8 = 16, 16%16==0). Labels prefixed fz_rk_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // entry_id

        cmp rbx, 0;
        je  fz_rk_cmd;
        cmp rbx, 1;
        je  fz_rk_wit;
        cmp rbx, 2;
        je  fz_rk_stdout;

        // Unknown entry.
        mov rax, 0x2400;                 // FZ_ERR_BAD_ENTRY
        jmp fz_rk_out;

      fz_rk_cmd:
        mov rdi, rsi;
        mov rsi, rdx;
        call _fuzz_cmd_registry;
        jmp fz_rk_out;

      fz_rk_wit:
        mov rdi, rsi;
        mov rsi, rdx;
        call _fuzz_wit_bridge;
        jmp fz_rk_out;

      fz_rk_stdout:
        // Shift (rsi, rdx) to (rsi, rdx) stays; prepend pid in rdi.
        mov rcx, rsi;                    // bytes_ptr -> scratch
        mov r8, rdx;                     // bytes_len -> scratch
        mov rdi, [rip + _fz_corpus_stdout_pid];
        mov rsi, rcx;                    // bytes_ptr
        mov rdx, r8;                     // bytes_len
        call _fuzz_stdout_records;

      fz_rk_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _fuzz_run_corpus(entry_id, corpus_ptr, corpus_len) -> packed u64
  //
  // Iterate the corpus byte-by-byte, dispatching every newline-
  // delimited case to _fz_run_case. Returns `(cases_run << 32) |
  // first_crash_byte_offset_or_0`. At R141.M3 the low 32 bits are
  // always zero -- real crash detection lands with the fault-
  // trampoline wave described in design/perf/fuzz-entry-points.md §8.
  //
  // Gates:
  //   * entry_id >= FZ_ENTRY_COUNT (3)  -> FZ_ERR_BAD_ENTRY in rax
  //                                        (no `<< 32` shift)
  //   * corpus_len == 0                 -> FZ_ERR_CORPUS_EMPTY in rax
  //
  // Register plan: six callee-save pushes (rbx=entry_id, r12=corpus_
  // ptr, r13=corpus_len, r14=cursor, r15=line_start, rbp=cases_run)
  // + sub rsp,8 land rsp%16==0 at every nested call (entry 8 + 48 +
  // 8 = 64, 64%16==0). Labels prefixed fz_rc_.
  // ==========================================================================
  pub let _fuzz_run_corpus : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (entry_id: u64) (corpus_ptr: u64) (corpus_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W22 R141.M3 (#2647): corpus-driver for the three fuzz entries. Walks corpus bytes, splitting on 0x0A ('\\n'); each inter-newline run (including a trailing partial without '\\n') is one case fed to _fz_run_case(entry_id, case_ptr, case_len). Returns packed u64 (cases_run << 32) | first_crash_byte_offset_or_0 on success; the low 32 bits are always 0 at M3 (fault-trampoline not yet landed). Gates: entry_id >= 3 -> FZ_ERR_BAD_ENTRY=0x2400 (bump FZ_ST_CORPUS_BAD_ENTRY); corpus_len == 0 -> FZ_ERR_CORPUS_EMPTY=0x2401 (bump FZ_ST_CORPUS_EMPTY). Six callee-save pushes (rbx=entry_id, r12=corpus_ptr, r13=corpus_len, r14=cursor, r15=line_start, rbp=cases_run) + sub rsp,8 land rsp%16==0 at every nested call (entry 8 + 48 + 8 = 64, 64%16==0). Byte load via mov_b with pre-zero. Packed-return high half via shl rax,32. Labels prefixed fz_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // entry_id
        mov r12, rsi;                    // corpus_ptr
        mov r13, rdx;                    // corpus_len

        // Entry-id gate.
        cmp rbx, 3;                      // FZ_ENTRY_COUNT
        jae fz_rc_bad_entry;

        // Empty-corpus gate.
        cmp r13, 0;
        je  fz_rc_empty;

        xor r14, r14;                    // cursor = 0
        xor r15, r15;                    // line_start = 0
        xor rbp, rbp;                    // cases_run = 0

      fz_rc_loop:
        cmp r14, r13;
        jae fz_rc_tail;

        xor rax, rax;
        mov_b rax, [r12 + r14 * 1];
        cmp rax, 0x0A;                   // '\n'
        je  fz_rc_fire_line;

        add r14, 1;
        jmp fz_rc_loop;

      fz_rc_fire_line:
        // case_ptr = corpus_ptr + line_start
        // case_len = cursor - line_start
        mov rdi, rbx;                    // entry_id
        mov rsi, r12;
        add rsi, r15;                    // case_ptr
        mov rdx, r14;
        sub rdx, r15;                    // case_len
        call _fz_run_case;
        add rbp, 1;                      // cases_run += 1

        add r14, 1;                      // skip the LF
        mov r15, r14;                    // line_start = cursor
        jmp fz_rc_loop;

      fz_rc_tail:
        // Flush final partial line if any (line_start < cursor).
        cmp r15, r14;
        jae fz_rc_done;

        mov rdi, rbx;
        mov rsi, r12;
        add rsi, r15;
        mov rdx, r14;
        sub rdx, r15;
        call _fz_run_case;
        add rbp, 1;

      fz_rc_done:
        mov rdi, 4;                      // FZ_ST_CORPUS_OK
        call _fz_note;
        mov rax, rbp;                    // cases_run
        shl rax, 32;                     // (cases_run << 32) | 0
        jmp fz_rc_out;

      fz_rc_bad_entry:
        mov rdi, 5;                      // FZ_ST_CORPUS_BAD_ENTRY
        call _fz_note;
        mov rax, 0x2400;                 // FZ_ERR_BAD_ENTRY
        jmp fz_rc_out;

      fz_rc_empty:
        mov rdi, 6;                      // FZ_ST_CORPUS_EMPTY
        call _fz_note;
        mov rax, 0x2401;                 // FZ_ERR_CORPUS_EMPTY

      fz_rc_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
