// src/kernel/core/perf/cap_adversary.pdx -- Wave UMB-W23 R141.M4
// paideia-os #2648
//
// CAPABILITY-FLOW ADVERSARIAL TEST HARNESS
// =============================================================================
//
// R141 ("kernel-space performance measurement") milestone M4.  The three
// preceding milestones built the measurement substrate:
//
//   R141.M1 (Wave UMB-W3,  #2645) -- microbench RDTSC harness.
//   R141.M2 (Wave UMB-W13, #2646) -- perf-sink klog dumper.
//   R141.M3 (Wave UMB-W22, #2647) -- byte-level fuzz entries.
//
// R141.M4 (this file, Wave UMB-W23, #2648) adds the ADVERSARIAL layer for
// the R125 cap-flow substrate: a kernel-side test harness that constructs
// hostile inputs against each of the four invariants _cap_minter_derive
// enforces plus the lineage-level revoke semantics the shell relies on,
// confirms the daemon REFUSES, and reports PASS/FAIL per case.  Without
// this harness, every cap-flow invariant is argued (in design docs and
// per-function justifications) but never ADVERSARIALLY exercised: a
// future refactor could invert a `jne` into a `je` and the whole R125
// cap-flow invariant would collapse silently with no witness.
//
// =============================================================================
// SECTION 0  POSTURE
// =============================================================================
//
// The adversary is PURE TEST HARNESS: no capability authority of its own
// (every call is kernel-mode-only), no scheduler coupling, no cross-core
// guards.  Each test allocates fresh env rows via cap_env_create, mints
// its own parent capability directly into a RESERVED cap_table slot
// range [100, 110), exercises the daemon, and cleans up (zeroes the env
// via cap_env_destroy, zeroes the parent cap_table row via
// cadv_clear_cap_slot).  Tests are side-effect-isolated from each other
// and from the surrounding boot sequence; running the harness after
// system is up is a no-op on persistent state once every test returns.
//
// The parent slot range [100, 110) sits between the low-slot kernel
// mints (0..99 reserved for boot witnesses + ring-3 syscall-minted
// descriptors) and the cap-minter's own derived-cap range [192, 256)
// (see svc/cap_minter.pdx §3).  Band audit (2026-10-14):
//   `grep -rnE 'cap_table.*(\* ?10[0-9] ?\* ?24)' src/kernel/`
//   returned zero hits -- the band is clear.
//
// =============================================================================
// SECTION 1  ADVERSARIAL CASES
// =============================================================================
//
// At R141.M4 five cases are registered.  Each targets ONE invariant and
// expects ONE specific errno from the daemon surface.
//
//   id   name               invariant tested          expected errno
//   0    narrow_only        requested ! > parent      CM_ERR_RIGHTS_WIDEN
//                                                     = 0x0F02
//   1    bad_parent         parent slot occupied      CM_ERR_PARENT_INVALID
//                                                     = 0x0F01
//   2    env_full           env capacity              CM_ERR_ENV_FULL
//                                                     = 0x0F03
//   3    cross_env_leak     active env isolation      CM_ERR_PARENT_INVALID
//                                                     = 0x0F01
//   4    revoke_blocks_use  revoked cap unreachable   CM_ERR_PARENT_INVALID
//                                                     = 0x0F01
//
// Each test returns:
//   CA_ADV_OK                 (0)      -- expected errno observed.
//   CA_ADV_UNEXPECTED_SUCCESS (0x2500) -- daemon reported CM_OK where
//                                         the invariant should have
//                                         forced a refusal.  This is
//                                         the LOAD-BEARING failure
//                                         mode: it means a privilege-
//                                         escalation path exists.
//   CA_ADV_UNEXPECTED_ERRNO   (0x2501) -- daemon refused but with the
//                                         wrong code (e.g. ENV_FULL
//                                         where WIDEN was expected).
//                                         Weaker than UNEXPECTED_SUCCESS
//                                         (no escalation) but still an
//                                         API-contract break -- the
//                                         caller's error-handling
//                                         ladder was designed against
//                                         the pinned taxonomy.
//
// =============================================================================
// SECTION 2  FINGERPRINT CONTRACT
// =============================================================================
//
// Each test emits exactly ONE klog line at the classify step:
//
//   PASS:  `CAP_ADV <name> PASS`           (klog_s1, no KV)
//   FAIL:  `CAP_ADV <name> FAIL errno=0x<hex>`  (klog_s1_x1, one hex KV)
//
// The ten pre-built tag strings sit alongside the one key tag
// (`cadv_k_errno`).  Tag byte counts are NUL-inclusive per
// kernel-logging-substrate.md discipline (N = len(string) + 1).  A FAIL
// line in the test log is intended to be `grep -i cap_adv.*fail`-able
// without further parsing; the one-line-per-case rule stays even when
// run_all drives all five back-to-back.
//
// =============================================================================
// SECTION 3  RUN-ALL PACKING
// =============================================================================
//
// _ca_run_all() iterates all five tests and returns a packed u64:
//
//   bits [63:32] = fail_mask (bit i set iff test i returned non-OK)
//   bits [31:0]  = pass_count (0..5)
//
// Packing lets a userspace reader (future KIND_FUZZ cap handler, or a
// kernel-mode shell command) decode the summary in two cheap moves:
//
//   fail_mask  = result >> 32
//   pass_count = result & 0xFFFFFFFF
//
// A healthy harness returns (0 << 32) | 5 = 5.  Any non-zero high half
// is an immediate regression signal; the low half tells an operator how
// many of the invariants still hold while a fix is prepared.
//
// =============================================================================
// SECTION 4  RETURN CODE BAND
// =============================================================================
//
// Per task directive:
//
//   CA_ADV_OK                 = 0
//   CA_ADV_UNEXPECTED_SUCCESS = 0x2500
//   CA_ADV_UNEXPECTED_ERRNO   = 0x2501
//
// Both error codes fit imm32 with bit 31 clear (7-byte `mov rax, imm32`
// zero-extend emit).  Band audit (2026-10-14):
//   `grep -rnE '0x250[01]\b' src/kernel/ 2>/dev/null` -> zero hits.
// Clean band.  The adjacent band base 0x2400 belongs to R141.M3
// fuzz_entries (FZ_ERR_BAD_ENTRY / FZ_ERR_CORPUS_EMPTY); 0x2500 is a
// clean next-slice step.
//
// =============================================================================
// SECTION 5  PARENT CAPABILITY FIXTURE
// =============================================================================
//
// Each test needs a well-formed parent capability to derive from.  The
// fixture is a 24-byte row in cap_table at a slot in [100, 110):
//
//   kind       = CADV_PARENT_KIND       (0xAD, "adversary")
//   rights     = test-specific (0x001 narrow, 0xFF wide)
//   target_ptr = CADV_PARENT_TARGET     (0xBEEF, placeholder)
//
// The kind 0xAD is deliberately NOT a registered dispatch arm anywhere
// in cap/invoke.pdx (band audit 2026-10-14: zero hits for `cmp rcx,
// 0xAD`).  A ring-3 cap_invoke against this row would return
// INVOKE_UNSUPPORTED, which is correct: the fixture exists only to
// satisfy _cap_minter_derive's `parent_kind != 0` validation at step 6.
// The derive path writes a NEW cap_table row (not this one) via
// cap_mint_write.
//
// After each test, cadv_clear_cap_slot zeroes the three descriptor
// words AND the owner column, matching the generic revoke-sweep shape
// in cap/owner.pdx without routing through cap_revoke_slot's per-kind
// dispatch.  Routing through cap_revoke_slot would couple the harness
// to the entire kind-table (a change to a per-kind revoke would break
// the harness even though the invariant under test did not change);
// direct zeroing is self-contained.
//
// =============================================================================
// SECTION 6  ACTIVE-ENV HANDLING
// =============================================================================
//
// _cap_minter_derive resolves the caller env through the ambient global
// _cap_minter_active_env (svc/cap_minter.pdx §2).  Each test sets the
// ambient env to its own fresh handle at entry and resets it to
// CM_ENV_NONE (0xFF) at exit.  No test depends on a prior test's
// setting; _ca_run_all runs the five tests back-to-back and the final
// active-env state is CM_ENV_NONE.  A production boot that invokes
// _ca_run_all BEFORE user-space is up therefore leaves the ambient env
// in the exact state _cap_minter_init writes.
//
// =============================================================================
// SECTION 7  HOW TO ADD A NEW CASE
// =============================================================================
//
// 1. Add a bit index CA_TEST_<NAME> and bump CA_TEST_COUNT.
// 2. Add two fingerprint tag literals:
//      cadv_tag_<name>_pass : [u8; N] = "CAP_ADV <name> PASS\0"
//      cadv_tag_<name>_fail : [u8; N] = "CAP_ADV <name> FAIL\0"
//    with N = len(string) + 1 (count the NUL).
// 3. Write _ca_test_<name>() -> errno following the shape of the five
//    existing tests: setup -> invoke daemon surface -> capture errno ->
//    cleanup -> cadv_classify_and_emit(expected, actual, pass_tag,
//    fail_tag).  The classify helper is the only correct way to emit
//    the fingerprint and compute the result code -- do not inline it,
//    the FAIL/UNEXPECTED_SUCCESS discrimination belongs in one place.
// 4. In _ca_run_all, add a `call _ca_test_<name>` + bit/count update
//    arm BEFORE the final `shl r12, 32` packing.
//
// =============================================================================
// SECTION 8  paideia-as encoder-gap posture
// =============================================================================
//
// * No 2-op `imul r, imm` -- stride 24 composed as (slot<<3)+(slot<<4),
//   mirroring svc/cap_minter.pdx and cap/mint.pdx.
// * No `and r, imm64` -- every mask fits imm32.
// * All liveness/zero tests use `cmp rN, 0` (never `test rN, rN`).
// * All `pub let` string decls are single-line.
// * Module basename `CapAdversary` matches file basename
//   `cap_adversary.pdx`.
// * Every label in this file is prefixed `cadv_` (reserved-word
//   discipline -- `loop`/`if`/`let` are keywords; `ca_` prefix is
//   already taken by cmd_audit; `cap_` is too generic).
// * `or` is reg-reg only (no `or r, imm` -- paideia-as encoder gap).
//   Immediate ORs are staged via a scratch register: `mov r10, imm;
//   or rN, r10`.
// * Return constants CA_ADV_OK (0), CA_ADV_UNEXPECTED_SUCCESS (0x2500),
//   CA_ADV_UNEXPECTED_ERRNO (0x2501) all fit imm32.
// * Packed-return high half via `shl rN, 32` (power-of-two shift).
// * Fingerprint `[u8; N]` strings have N = string length + 1 (NUL
//   counts).  The count is spelled next to each literal for audit.
//
// Stack discipline (SysV, entry rsp%16==8):
//   cadv_note                 0 pushes (pure leaf)
//   cadv_mint_parent          0 pushes + sub rsp,8 (one nested call)
//   cadv_clear_cap_slot       0 pushes (pure leaf; direct stores)
//   cadv_classify_and_emit    3 pushes (rbx,r12,r13)   -> %16==0
//   _ca_test_narrow_only      2 pushes + sub rsp,8     -> %16==0
//   _ca_test_bad_parent       2 pushes + sub rsp,8     -> %16==0
//   _ca_test_env_full         2 pushes + sub rsp,8     -> %16==0
//   _ca_test_cross_env_leak   3 pushes                 -> %16==0
//   _ca_test_revoke_blocks_use 4 pushes + sub rsp,8    -> %16==0
//   _ca_run_all               2 pushes + sub rsp,8     -> %16==0
//
// =============================================================================

module CapAdversary = structure {

  // ==========================================================================
  // SECTION 9  Return band (§4) + test identities
  // ==========================================================================

  pub let CA_ADV_OK                 : u64 = 0
  pub let CA_ADV_UNEXPECTED_SUCCESS : u64 = 0x2500
  pub let CA_ADV_UNEXPECTED_ERRNO   : u64 = 0x2501

  pub let CA_TEST_NARROW_ONLY       : u64 = 0
  pub let CA_TEST_BAD_PARENT        : u64 = 1
  pub let CA_TEST_ENV_FULL          : u64 = 2
  pub let CA_TEST_CROSS_ENV_LEAK    : u64 = 3
  pub let CA_TEST_REVOKE_BLOCKS_USE : u64 = 4
  pub let CA_TEST_COUNT             : u64 = 5

  // Shadow of svc/cap_minter.pdx constants (used in the expected-errno
  // compare in classify).  Keeping them local avoids a direct cross-
  // module import pattern and matches how fuzz_entries shadows its
  // sibling constants.
  pub let CM_OK_SHADOW                 : u64 = 0
  pub let CM_ERR_PARENT_INVALID_SHADOW : u64 = 0x0F01
  pub let CM_ERR_RIGHTS_WIDEN_SHADOW   : u64 = 0x0F02
  pub let CM_ERR_ENV_FULL_SHADOW       : u64 = 0x0F03

  // Env-handle sentinel (shadow of KindCapEnv.CAP_ENV_ROW_NONE and
  // CapMinter.CM_ENV_NONE).
  pub let CADV_ENV_NONE : u64 = 0xFF

  // ==========================================================================
  // SECTION 10  Parent fixture (§5)
  // ==========================================================================

  // Reserved cap_table slot range [100, 110) for parent fixtures.  All
  // five tests use CADV_PARENT_SLOT (= 100); the extra slots up to 110
  // are reserved for future multi-parent cases.
  pub let CADV_PARENT_SLOT   : u64 = 100
  pub let CADV_PARENT_KIND   : u64 = 0xAD        // "adversary" -- not a
                                                 //  dispatched kind.
  pub let CADV_PARENT_TARGET : u64 = 0xBEEF      // placeholder target_ptr

  // Rights presets used by the five tests.
  pub let CADV_RIGHTS_NARROW : u64 = 0x001       // single-bit parent
  pub let CADV_RIGHTS_WIDE   : u64 = 0x0FF       // full-mask parent
  pub let CADV_RIGHTS_WIDEN  : u64 = 0x003       // for narrow-only test:
                                                 //  requested wider than
                                                 //  CADV_RIGHTS_NARROW.

  // ==========================================================================
  // SECTION 11  State
  // ==========================================================================
  //
  //   _cadv_scratch_out  -- u64 landing region for _cap_minter_derive's
  //                         out_slot_ptr argument.  Reused across every
  //                         test (single-threaded harness).
  //
  //   _cadv_stats        -- 8 u64 counters (observability).

  pub let mut _cadv_scratch_out : [u64; 1] = uninit @align(64)
  pub let mut _cadv_stats       : [u64; 8] = uninit @align(64)

  pub let CADV_ST_NARROW_OK       : u64 = 0
  pub let CADV_ST_BAD_PARENT_OK   : u64 = 1
  pub let CADV_ST_ENV_FULL_OK     : u64 = 2
  pub let CADV_ST_CROSS_OK        : u64 = 3
  pub let CADV_ST_REVOKE_OK       : u64 = 4
  pub let CADV_ST_RUN_ALL_INVOKED : u64 = 5
  pub let CADV_ST_ANY_FAIL        : u64 = 6

  // ==========================================================================
  // SECTION 12  Fingerprint tags (§2)
  // ==========================================================================
  //
  // N = len(string) + 1 (NUL counts).  "CAP_ADV " is 8 chars; "PASS"
  // and "FAIL" are 4 chars each; the inter-token space adds 1 char.
  //
  //   "CAP_ADV narrow_only PASS"        -> 8+11+1+4 = 24, +1 NUL => N=25
  //   "CAP_ADV narrow_only FAIL"        -> 8+11+1+4 = 24, +1 NUL => N=25
  //   "CAP_ADV bad_parent PASS"         -> 8+10+1+4 = 23, +1 NUL => N=24
  //   "CAP_ADV bad_parent FAIL"         -> 8+10+1+4 = 23, +1 NUL => N=24
  //   "CAP_ADV env_full PASS"           -> 8+ 8+1+4 = 21, +1 NUL => N=22
  //   "CAP_ADV env_full FAIL"           -> 8+ 8+1+4 = 21, +1 NUL => N=22
  //   "CAP_ADV cross_env_leak PASS"     -> 8+14+1+4 = 27, +1 NUL => N=28
  //   "CAP_ADV cross_env_leak FAIL"     -> 8+14+1+4 = 27, +1 NUL => N=28
  //   "CAP_ADV revoke_blocks_use PASS"  -> 8+17+1+4 = 30, +1 NUL => N=31
  //   "CAP_ADV revoke_blocks_use FAIL"  -> 8+17+1+4 = 30, +1 NUL => N=31

  pub let cadv_tag_narrow_only_pass       : [u8; 25] = "CAP_ADV narrow_only PASS\0"
  pub let cadv_tag_narrow_only_fail       : [u8; 25] = "CAP_ADV narrow_only FAIL\0"
  pub let cadv_tag_bad_parent_pass        : [u8; 24] = "CAP_ADV bad_parent PASS\0"
  pub let cadv_tag_bad_parent_fail        : [u8; 24] = "CAP_ADV bad_parent FAIL\0"
  pub let cadv_tag_env_full_pass          : [u8; 22] = "CAP_ADV env_full PASS\0"
  pub let cadv_tag_env_full_fail          : [u8; 22] = "CAP_ADV env_full FAIL\0"
  pub let cadv_tag_cross_env_leak_pass    : [u8; 28] = "CAP_ADV cross_env_leak PASS\0"
  pub let cadv_tag_cross_env_leak_fail    : [u8; 28] = "CAP_ADV cross_env_leak FAIL\0"
  pub let cadv_tag_revoke_blocks_use_pass : [u8; 31] = "CAP_ADV revoke_blocks_use PASS\0"
  pub let cadv_tag_revoke_blocks_use_fail : [u8; 31] = "CAP_ADV revoke_blocks_use FAIL\0"

  // Key tag reused across every FAIL line.  "errno" = 5 chars + NUL => N=6.
  pub let cadv_k_errno : [u8; 6] = "errno\0"

  // ==========================================================================
  // SECTION 13  cadv_note(slot) -> ()
  //
  // Bounded increment on _cadv_stats[slot].  Same shape as cap_env_note
  // and cmnt_note; load-inc-store (no `add reg, [mem]`).  Caller passes
  // a CADV_ST_* ordinal; the bounds check guards the pool size (8).
  // Pure leaf -- no pushes.
  // ==========================================================================
  pub let cadv_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R141.M4 (paideia-os #2648): bounded increment on _cadv_stats[slot<8]. Load-inc-store, no `add reg,[mem]`. Pure leaf -- no pushes. Labels prefixed cadv_no_.",
      block: {
        cmp rdi, 8;
        jae cadv_no_out;
        lea r10, [rip + _cadv_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cadv_no_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION 14  cadv_mint_parent(cap_slot, rights) -> ()
  //
  // Write a parent capability fixture into cap_table[cap_slot].  Thin
  // wrapper over cap_mint_write that fixes kind = CADV_PARENT_KIND
  // (0xAD) and target_ptr = CADV_PARENT_TARGET (0xBEEF) so the two
  // "variable" axes of a parent fixture are the SLOT (so a future
  // multi-parent test can pick its own) and the RIGHTS (so narrow_only
  // can pass 0x001 while env_full / cross_env_leak / revoke_blocks_use
  // pass 0xFF).  cap_mint_write ABI is (rdi=slot, rsi=kind, rdx=rights,
  // rcx=target_ptr).
  //
  // Register plan: no callee-save push (two values arrive in rdi/rsi
  // and are shuffled into their final argument registers before the
  // single nested call).  `sub rsp, 8` aligns rsp%16==0 at that call.
  // ==========================================================================
  pub let cadv_mint_parent : (u64, u64) -> () !{mem} @{cap} =
    fn (cap_slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): write a parent capability fixture via cap_mint_write(slot=cap_slot, kind=0xAD, rights, target_ptr=0xBEEF). The two caller-supplied axes (cap_slot in rdi, rights in rsi) are routed into cap_mint_write's rdi/rdx argument slots; kind (0xAD) and target_ptr (0xBEEF) are set from local constants. Single nested call; `sub rsp, 8` aligns rsp%16==0. Labels prefixed cadv_mp_.",
      block: {
        sub rsp, 8;

        // Shuffle: incoming (rdi=slot, rsi=rights) -> cap_mint_write
        // ABI (rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr).
        // slot already in rdi.  Move rights (rsi) to rdx first, then
        // populate rsi/rcx with constants.
        mov rdx, rsi;                    // rdx = rights
        mov rsi, 0xAD;                   // rsi = CADV_PARENT_KIND
        mov rcx, 0xBEEF;                 // rcx = CADV_PARENT_TARGET
        call cap_mint_write;

        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // SECTION 15  cadv_clear_cap_slot(cap_slot) -> ()
  //
  // Zero the three descriptor words at cap_table + cap_slot*24.  Used
  // as the harness-local revoke primitive: it is INTENTIONALLY a direct
  // write rather than a call to cap_revoke_slot, so the test harness
  // does not couple to the kind-dispatch table in cap/owner.pdx (see
  // §5).  Pure leaf -- no pushes, no nested calls.  Stride 24 composed
  // as (slot<<3)+(slot<<4).
  //
  // No bounds check by policy: caller passes a slot in [100, 110) for
  // parent-fixture cleanup, or a slot in [192, 256) for a derived-child
  // revoke in _ca_test_revoke_blocks_use.  Both ranges are well inside
  // CAP_SLOT_MAX (256).
  // ==========================================================================
  pub let cadv_clear_cap_slot : (u64) -> () !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): zero the three descriptor words at cap_table + cap_slot*24. Direct store rather than a cap_revoke_slot dispatch keeps the harness decoupled from the per-kind revoke table (see §5). Stride 24 composed as (slot<<3)+(slot<<4) because paideia-as does not emit 2-op `imul r, imm`. Pure leaf -- no pushes. Labels prefixed cadv_cs_.",
      block: {
        mov rax, rdi;
        shl rax, 3;                      // slot * 8
        mov r11, rdi;
        shl r11, 4;                      // slot * 16
        add rax, r11;                    // slot * 24
        lea r10, [rip + cap_table];
        add rax, r10;                    // &cap_table[cap_slot]

        xor r11, r11;
        mov [rax + 0],  r11;             // kind = 0
        mov [rax + 8],  r11;             // rights = 0
        mov [rax + 16], r11;             // target_ptr = 0
        ret
      }
    }

  // ==========================================================================
  // SECTION 16  cadv_classify_and_emit(expected, actual, tag_pass, tag_fail)
  //                                                                 -> u64
  //
  // Common post-amble for every test.  Compares actual vs expected,
  // emits one klog line (klog_s1 for PASS, klog_s1_x1 for FAIL), and
  // returns one of CA_ADV_OK / CA_ADV_UNEXPECTED_SUCCESS /
  // CA_ADV_UNEXPECTED_ERRNO:
  //
  //   actual == expected  -> emit `<tag_pass>`, return CA_ADV_OK
  //   actual == 0 (!= exp)-> emit `<tag_fail> errno=0x0`,
  //                          return CA_ADV_UNEXPECTED_SUCCESS
  //   else                -> emit `<tag_fail> errno=0x<actual>`,
  //                          return CA_ADV_UNEXPECTED_ERRNO
  //
  // Centralising this means a future shift in failure taxonomy (e.g.
  // adding a CA_ADV_TRANSIENT category) requires one edit here, not
  // five.  The task directive pins the current three; this comment
  // documents the extension point.
  //
  // Register plan: three callee-save pushes (rbx=actual, r12=tag_pass,
  // r13=tag_fail).  Entry rsp%16==8; +3 pushes = +24 -> %16==0 at
  // every nested call.
  // ==========================================================================
  pub let cadv_classify_and_emit : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (expected: u64) (actual: u64) (tag_pass: u64) (tag_fail: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): compare actual vs expected, emit one klog_s1 (PASS) or klog_s1_x1 (FAIL, with the actual errno as a hex KV) and return CA_ADV_OK / CA_ADV_UNEXPECTED_SUCCESS / CA_ADV_UNEXPECTED_ERRNO. Three callee-save pushes (rbx=actual, r12=tag_pass, r13=tag_fail) land rsp%16==0 at every nested call. Labels prefixed cadv_cl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rsi;                    // actual
        mov r12, rdx;                    // tag_pass
        mov r13, rcx;                    // tag_fail

        cmp rbx, rdi;                    // actual vs expected
        jne cadv_cl_fail;

        // ---- PASS path ----
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        mov rdx, r12;                    // tag_pass
        call klog_s1;
        xor rax, rax;                    // CA_ADV_OK
        jmp cadv_cl_out;

      cadv_cl_fail:
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        mov rdx, r13;                    // tag_fail
        lea rcx, [rip + cadv_k_errno];
        mov r8,  rbx;                    // v_hex = actual
        call klog_s1_x1;

        // Discriminate UNEXPECTED_SUCCESS (actual == 0) vs
        // UNEXPECTED_ERRNO (actual != 0).
        cmp rbx, 0;
        jne cadv_cl_errno;
        mov rax, 0x2500;                 // CA_ADV_UNEXPECTED_SUCCESS
        jmp cadv_cl_out;

      cadv_cl_errno:
        mov rax, 0x2501;                 // CA_ADV_UNEXPECTED_ERRNO

      cadv_cl_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 17  _ca_test_narrow_only() -> errno
  //
  // Adversary 0: tries to derive a child cap with rights WIDER than the
  // parent.  The parent fixture has rights = CADV_RIGHTS_NARROW (0x001).
  // The derive request asks for CADV_RIGHTS_WIDEN (0x003 -- bit 1 is
  // NOT in parent).  _cap_minter_derive step 7's narrow-only check
  //   `(requested & parent) == requested`
  // evaluates `(0x003 & 0x001) == 0x001 != 0x003`, so the daemon MUST
  // return CM_ERR_RIGHTS_WIDEN (0x0F02).
  //
  // Register plan: 2 pushes (rbx=env_handle, r12=actual_errno) +
  // `sub rsp, 8`.  Entry rsp%16==8; +2*8+8 = +24 -> %16==0 at every
  // nested call.
  // ==========================================================================
  pub let _ca_test_narrow_only : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): adversarial test 0 (narrow_only). Mint a parent cap with rights 0x001 at cap_table[100], insert it into a fresh env's slot 0, set active env, call _cap_minter_derive(slot=0, requested_rights=0x003, &scratch_out). Expected errno = CM_ERR_RIGHTS_WIDEN (0x0F02). Clean up (reset active env, destroy env, clear parent slot). Classify. Two callee-save pushes (rbx=env_handle, r12=actual_errno) + sub rsp,8 land rsp%16==0 at every nested call. Labels prefixed cadv_no_test_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // ---- Setup: create env, mint parent, insert, set active ----
        call cap_env_create;
        mov rbx, rax;                    // env_handle (may be an error
                                         // sentinel; downstream calls
                                         // tolerate that and the test
                                         // will classify as a FAIL).

        mov rdi, 100;                    // CADV_PARENT_SLOT
        mov rsi, 0x001;                  // CADV_RIGHTS_NARROW
        call cadv_mint_parent;

        mov rdi, rbx;
        mov rsi, 0;                      // slot 0 for the parent
        mov rdx, 100;                    // cap value = parent cap_table idx
        call cap_env_insert;

        mov rdi, rbx;
        call _cap_minter_set_active_env;

        // ---- Invoke: derive with wider rights ----
        mov rdi, 0;                      // parent env slot
        mov rsi, 0x003;                  // CADV_RIGHTS_WIDEN (> parent)
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;
        mov r12, rax;                    // actual_errno

        // ---- Cleanup ----
        mov rdi, 0xFF;                   // CADV_ENV_NONE
        call _cap_minter_set_active_env;

        mov rdi, rbx;
        call cap_env_destroy;

        mov rdi, 100;
        call cadv_clear_cap_slot;

        // ---- Classify ----
        mov rdi, 0x0F02;                 // expected: CM_ERR_RIGHTS_WIDEN
        mov rsi, r12;                    // actual
        lea rdx, [rip + cadv_tag_narrow_only_pass];
        lea rcx, [rip + cadv_tag_narrow_only_fail];
        call cadv_classify_and_emit;

        // Bump narrow_only stat on PASS (rax == 0).
        cmp rax, 0;
        jne cadv_no_test_out;
        mov rdi, 0;                      // CADV_ST_NARROW_OK
        call cadv_note;
        xor rax, rax;

      cadv_no_test_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 18  _ca_test_bad_parent() -> errno
  //
  // Adversary 1: tries to derive from an EMPTY env slot (no parent cap
  // was inserted).  _cap_minter_derive step 4's cap_env_lookup returns
  // 0 for an empty slot, which falls into the PARENT_INVALID branch.
  // Expected errno = CM_ERR_PARENT_INVALID (0x0F01).
  //
  // Register plan: 2 pushes (rbx=env_handle, r12=actual_errno) +
  // `sub rsp, 8`.
  // ==========================================================================
  pub let _ca_test_bad_parent : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): adversarial test 1 (bad_parent). Create a fresh env, set it active WITHOUT inserting any parent cap, call _cap_minter_derive(slot=0, requested_rights=0x001, &scratch_out). Expected errno = CM_ERR_PARENT_INVALID (0x0F01) because the env's slot 0 is empty. Two callee-save pushes (rbx=env_handle, r12=actual_errno) + sub rsp,8 land rsp%16==0 at every nested call. Labels prefixed cadv_bp_test_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // ---- Setup: create env, set active (NO insert) ----
        call cap_env_create;
        mov rbx, rax;

        mov rdi, rbx;
        call _cap_minter_set_active_env;

        // ---- Invoke: derive from empty slot 0 ----
        mov rdi, 0;                      // parent env slot (empty)
        mov rsi, 0x001;                  // CADV_RIGHTS_NARROW
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;
        mov r12, rax;

        // ---- Cleanup ----
        mov rdi, 0xFF;
        call _cap_minter_set_active_env;

        mov rdi, rbx;
        call cap_env_destroy;

        // ---- Classify ----
        mov rdi, 0x0F01;                 // expected: CM_ERR_PARENT_INVALID
        mov rsi, r12;
        lea rdx, [rip + cadv_tag_bad_parent_pass];
        lea rcx, [rip + cadv_tag_bad_parent_fail];
        call cadv_classify_and_emit;

        cmp rax, 0;
        jne cadv_bp_test_out;
        mov rdi, 1;                      // CADV_ST_BAD_PARENT_OK
        call cadv_note;
        xor rax, rax;

      cadv_bp_test_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 19  _ca_test_env_full() -> errno
  //
  // Adversary 2: fills every one of the env's six cap slots, then tries
  // to derive one more child.  _cap_minter_derive step 9's
  // cmnt_find_free_env_slot returns the sentinel 6 (no free slot),
  // which collapses to CM_ERR_ENV_FULL (0x0F03).
  //
  // All six env slots are filled with the same parent cap_table idx
  // (100); the daemon's narrow-only check (step 7) passes because
  // parent_rights (0xFF) wholly contains requested_rights (0x001).
  // The failure therefore specifically exercises the env-side capacity
  // invariant, not a conflation with the rights invariant.
  //
  // Register plan: 2 pushes (rbx=env_handle, r12=actual_errno) +
  // `sub rsp, 8`.  The fill loop uses r13 implicitly through a short
  // sub rsp stash -- no, it uses a direct cursor in rax that we rebuild
  // each iteration from an incrementing counter in r11.  Actually, the
  // simpler form: cursor in a caller-save reg (rcx) that is clobbered
  // only by cap_env_insert's own callee-save discipline; we reload the
  // cursor from a stack slot after the call.  Simpler-still: three
  // pushes (rbx, r12, r13 cursor).  Switch to 3-push shape.
  //
  // Revised register plan: 3 pushes (rbx=env_handle, r12=actual_errno,
  // r13=cursor).  Entry %16==8; +3*8 = +24 -> %16==0 at every nested
  // call.  No `sub rsp` needed.
  // ==========================================================================
  pub let _ca_test_env_full : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): adversarial test 2 (env_full). Create a fresh env, mint one parent (slot 100 rights 0xFF), insert it into all six env slots (0..5) using the SAME cap_table idx 100 as the fill value -- cap_env_insert bumps cap_count on each 0->non-zero transition and halts the 7th insert with CAP_ENV_ENV_FULL. Set active env. Call _cap_minter_derive(slot=0, requested_rights=0x001, &scratch_out). Expected errno = CM_ERR_ENV_FULL (0x0F03) because step 9's cmnt_find_free_env_slot returns the no-free sentinel. Three callee-save pushes (rbx=env_handle, r12=actual_errno, r13=cursor) land rsp%16==0 at every nested call. Labels prefixed cadv_ef_test_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // ---- Setup ----
        call cap_env_create;
        mov rbx, rax;

        mov rdi, 100;
        mov rsi, 0xFF;                   // CADV_RIGHTS_WIDE
        call cadv_mint_parent;

        // Fill slots 0..5 with cap value 100.
        xor r13, r13;                    // cursor = 0
      cadv_ef_test_fill:
        mov rdi, rbx;                    // env
        mov rsi, r13;                    // slot
        mov rdx, 100;                    // cap value
        call cap_env_insert;
        add r13, 1;
        cmp r13, 6;
        jb  cadv_ef_test_fill;

        mov rdi, rbx;
        call _cap_minter_set_active_env;

        // ---- Invoke ----
        mov rdi, 0;                      // parent slot (occupied with 100)
        mov rsi, 0x001;
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;
        mov r12, rax;

        // ---- Cleanup ----
        mov rdi, 0xFF;
        call _cap_minter_set_active_env;

        mov rdi, rbx;
        call cap_env_destroy;

        mov rdi, 100;
        call cadv_clear_cap_slot;

        // ---- Classify ----
        mov rdi, 0x0F03;                 // CM_ERR_ENV_FULL
        mov rsi, r12;
        lea rdx, [rip + cadv_tag_env_full_pass];
        lea rcx, [rip + cadv_tag_env_full_fail];
        call cadv_classify_and_emit;

        cmp rax, 0;
        jne cadv_ef_test_out;
        mov rdi, 2;                      // CADV_ST_ENV_FULL_OK
        call cadv_note;
        xor rax, rax;

      cadv_ef_test_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 20  _ca_test_cross_env_leak() -> errno
  //
  // Adversary 3: creates two envs (A, B), inserts a parent cap into
  // env A's slot 0, then sets the ambient active env to B and tries to
  // derive from slot 0.  Env B has no cap at slot 0, so step 4's
  // cap_env_lookup returns 0 and the daemon refuses with
  // CM_ERR_PARENT_INVALID (0x0F01).
  //
  // This case exercises the R125 principle that the active-env rebind
  // CANNOT leak capability authority across envs.  A regression here
  // would be the single scariest cap-flow break: a shell could set
  // active env to a different session's env and reach caps it never
  // held.
  //
  // Register plan: 3 pushes (rbx=env_A, r12=env_B, r13=actual_errno).
  // Entry %16==8; +3*8 = +24 -> %16==0 at every nested call.
  // ==========================================================================
  pub let _ca_test_cross_env_leak : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): adversarial test 3 (cross_env_leak). Create env_A, mint parent (slot 100 rights 0xFF), insert into env_A slot 0. Create env_B (empty). Set active env to env_B. Call _cap_minter_derive(slot=0, requested_rights=0x001, &scratch_out). Expected errno = CM_ERR_PARENT_INVALID (0x0F01) -- env_B has no cap at slot 0 so cap_env_lookup returns 0. Three callee-save pushes (rbx=env_A, r12=env_B, r13=actual_errno) land rsp%16==0 at every nested call. Labels prefixed cadv_cl_test_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // ---- Setup env_A with a parent cap ----
        call cap_env_create;
        mov rbx, rax;                    // env_A

        mov rdi, 100;
        mov rsi, 0xFF;
        call cadv_mint_parent;

        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 100;
        call cap_env_insert;

        // ---- Setup env_B (empty) ----
        call cap_env_create;
        mov r12, rax;                    // env_B

        // ---- Bind active to env_B ----
        mov rdi, r12;
        call _cap_minter_set_active_env;

        // ---- Invoke: derive from slot 0 (empty in env_B) ----
        mov rdi, 0;
        mov rsi, 0x001;
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;
        mov r13, rax;

        // ---- Cleanup ----
        mov rdi, 0xFF;
        call _cap_minter_set_active_env;

        mov rdi, rbx;
        call cap_env_destroy;

        mov rdi, r12;
        call cap_env_destroy;

        mov rdi, 100;
        call cadv_clear_cap_slot;

        // ---- Classify ----
        mov rdi, 0x0F01;                 // CM_ERR_PARENT_INVALID
        mov rsi, r13;
        lea rdx, [rip + cadv_tag_cross_env_leak_pass];
        lea rcx, [rip + cadv_tag_cross_env_leak_fail];
        call cadv_classify_and_emit;

        cmp rax, 0;
        jne cadv_cl_test_out;
        mov rdi, 3;                      // CADV_ST_CROSS_OK
        call cadv_note;
        xor rax, rax;

      cadv_cl_test_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 21  _ca_test_revoke_blocks_use() -> errno
  //
  // Adversary 4: derive a child cap successfully, revoke the child's
  // cap_table row (zero kind/rights/target_ptr), then try to USE the
  // child as a parent for a second derive.  The second derive's step
  // 6 reads parent_kind at cap_table + child_idx*24 + 0 and finds 0,
  // which falls into the PARENT_INVALID branch.  Expected errno =
  // CM_ERR_PARENT_INVALID (0x0F01).
  //
  // Observations the test does NOT make at R141.M4:
  //   * The child's env slot in the env row is UNCHANGED by the revoke
  //     (lineage tracking is R128 scope).  The daemon catches the
  //     revoked state only via the kind == 0 check at step 6, not via
  //     an env-side bookkeeping update.  That is the designed-in
  //     posture; a future R128 landing will exercise the env-side
  //     cascade here.
  //   * The "USE" of the child cap is a derive attempt rather than a
  //     cap_invoke, because KIND_ADVERSARY (0xAD) has no dispatcher
  //     arm.  The derive path is the richest reachable use of a cap
  //     without a per-kind handler.
  //
  // Register plan: 4 pushes (rbx=env_handle, r12=child_env_slot,
  // r13=child_cap_idx, r14=actual_errno) + `sub rsp, 8`.  Entry
  // %16==8; +4*8+8 = +40 -> %16==0 at every nested call.
  // ==========================================================================
  pub let _ca_test_revoke_blocks_use : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): adversarial test 4 (revoke_blocks_use). (a) Mint parent (slot 100 rights 0xFF), insert into env slot 0, set active env. (b) First derive: _cap_minter_derive(slot=0, requested_rights=0x001, &scratch_out). If this fails, propagate its errno into the classify step -- the test will FAIL as UNEXPECTED_ERRNO (no PARENT_INVALID until revoke) and that is the correct audit result because the harness could not reach the revoke step. (c) Read child_env_slot from scratch_out, cap_env_lookup to get child_cap_idx, cadv_clear_cap_slot(child_cap_idx) to revoke the descriptor directly (see §5 on why not cap_revoke_slot). (d) Second derive uses child_env_slot as parent -- step 6 reads kind==0 and refuses. Expected errno = CM_ERR_PARENT_INVALID (0x0F01). Four callee-save pushes (rbx=env, r12=child_env_slot, r13=child_cap_idx, r14=actual_errno) + sub rsp,8 land rsp%16==0 at every nested call. Labels prefixed cadv_rb_test_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // ---- Setup ----
        call cap_env_create;
        mov rbx, rax;

        mov rdi, 100;
        mov rsi, 0xFF;
        call cadv_mint_parent;

        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 100;
        call cap_env_insert;

        mov rdi, rbx;
        call _cap_minter_set_active_env;

        // ---- (b) First derive: expected to succeed ----
        mov rdi, 0;                      // parent slot
        mov rsi, 0x001;
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;

        // If first derive failed, record its errno as the "actual" and
        // jump past the revoke + second-derive machinery.  classify
        // will catch the mismatch.
        cmp rax, 0;
        jne cadv_rb_test_setup_fail;

        // (c) Read child_env_slot and child_cap_idx.
        mov r10, [rip + _cadv_scratch_out];
        mov r12, r10;                    // child_env_slot

        mov rdi, rbx;
        mov rsi, r12;
        call cap_env_lookup;
        mov r13, rax;                    // child_cap_idx

        // Revoke: direct descriptor clear.
        mov rdi, r13;
        call cadv_clear_cap_slot;

        // ---- (d) Second derive: expected to fail PARENT_INVALID ----
        mov rdi, r12;                    // use child's env slot as parent
        mov rsi, 0x001;
        lea rdx, [rip + _cadv_scratch_out];
        call _cap_minter_derive;
        mov r14, rax;

        jmp cadv_rb_test_cleanup;

      cadv_rb_test_setup_fail:
        // Propagate the first-derive errno so classify emits a FAIL
        // audit line.  The child_cap_idx is undefined; we only clean
        // parent-side state in the cleanup block below.
        mov r14, rax;

      cadv_rb_test_cleanup:
        mov rdi, 0xFF;
        call _cap_minter_set_active_env;

        mov rdi, rbx;
        call cap_env_destroy;

        mov rdi, 100;
        call cadv_clear_cap_slot;

        // ---- Classify ----
        mov rdi, 0x0F01;                 // CM_ERR_PARENT_INVALID
        mov rsi, r14;
        lea rdx, [rip + cadv_tag_revoke_blocks_use_pass];
        lea rcx, [rip + cadv_tag_revoke_blocks_use_fail];
        call cadv_classify_and_emit;

        cmp rax, 0;
        jne cadv_rb_test_out;
        mov rdi, 4;                      // CADV_ST_REVOKE_OK
        call cadv_note;
        xor rax, rax;

      cadv_rb_test_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 22  _ca_run_all() -> packed u64
  //
  // Drives all five tests back-to-back.  Returns:
  //   bits [63:32] = fail_mask (bit i set iff _ca_test_<i> returned != 0)
  //   bits [31:0]  = pass_count (number of tests that returned CA_ADV_OK)
  //
  // Also bumps CADV_ST_RUN_ALL_INVOKED and CADV_ST_ANY_FAIL (the latter
  // only if any test returned non-zero), giving a boot-time observer
  // a single counter to watch for cap-flow regressions.
  //
  // Register plan: 2 pushes (rbx=pass_count, r12=fail_mask) +
  // `sub rsp, 8`.  Each test call lands with rsp%16==0.  OR-with-imm
  // is staged via r10 (`mov r10, imm; or r12, r10`) because paideia-as
  // emits only reg-reg `or`.
  // ==========================================================================
  pub let _ca_run_all : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R141.M4 (paideia-os #2648): run all five adversarial tests back-to-back, pack result as (fail_mask<<32)|pass_count. Each test's non-zero return sets one bit in fail_mask (bit i for test i) and a zero return bumps pass_count. OR-with-imm staged via r10 (reg-reg `or` only; paideia-as encoder gap). CADV_ST_RUN_ALL_INVOKED is unconditional; CADV_ST_ANY_FAIL is bumped iff fail_mask != 0 at the tail. Two callee-save pushes (rbx=pass_count, r12=fail_mask) + sub rsp,8 land rsp%16==0 at every nested call (entry 8 + 16 + 8 = 32, %16==0). Labels prefixed cadv_ra_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        xor rbx, rbx;                    // pass_count = 0
        xor r12, r12;                    // fail_mask  = 0

        // Observability: run_all invoked.
        mov rdi, 5;                      // CADV_ST_RUN_ALL_INVOKED
        call cadv_note;

        // ---- Test 0: narrow_only ----
        call _ca_test_narrow_only;
        cmp rax, 0;
        jne cadv_ra_t0_fail;
        add rbx, 1;
        jmp cadv_ra_t1;
      cadv_ra_t0_fail:
        mov r10, 1;                      // bit 0
        or  r12, r10;

      cadv_ra_t1:
        // ---- Test 1: bad_parent ----
        call _ca_test_bad_parent;
        cmp rax, 0;
        jne cadv_ra_t1_fail;
        add rbx, 1;
        jmp cadv_ra_t2;
      cadv_ra_t1_fail:
        mov r10, 2;                      // bit 1
        or  r12, r10;

      cadv_ra_t2:
        // ---- Test 2: env_full ----
        call _ca_test_env_full;
        cmp rax, 0;
        jne cadv_ra_t2_fail;
        add rbx, 1;
        jmp cadv_ra_t3;
      cadv_ra_t2_fail:
        mov r10, 4;                      // bit 2
        or  r12, r10;

      cadv_ra_t3:
        // ---- Test 3: cross_env_leak ----
        call _ca_test_cross_env_leak;
        cmp rax, 0;
        jne cadv_ra_t3_fail;
        add rbx, 1;
        jmp cadv_ra_t4;
      cadv_ra_t3_fail:
        mov r10, 8;                      // bit 3
        or  r12, r10;

      cadv_ra_t4:
        // ---- Test 4: revoke_blocks_use ----
        call _ca_test_revoke_blocks_use;
        cmp rax, 0;
        jne cadv_ra_t4_fail;
        add rbx, 1;
        jmp cadv_ra_done;
      cadv_ra_t4_fail:
        mov r10, 16;                     // bit 4
        or  r12, r10;

      cadv_ra_done:
        // Bump ANY_FAIL stat iff fail_mask != 0.
        cmp r12, 0;
        je  cadv_ra_pack;
        mov rdi, 6;                      // CADV_ST_ANY_FAIL
        call cadv_note;

      cadv_ra_pack:
        // Pack: (fail_mask << 32) | pass_count.
        shl r12, 32;
        mov rax, rbx;
        or  rax, r12;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 23  Boot wiring note
  // ----------------
  // The harness has NO boot hook of its own.  Every call site is an
  // explicit kernel-mode invocation of _ca_run_all (or one of the five
  // individual tests).  Reasonable call sites:
  //
  //   (i)  A one-shot after _cap_minter_init in kernel_main.pdx so a
  //        regression on any cap-flow invariant fires at boot before
  //        user-space launches.  The call is `call _ca_run_all;` and
  //        the returned packed u64 can be klog'd via the perf-sink
  //        dumper or stored in a BSS global for later inspection.
  //
  //   (ii) A future KIND_FUZZ or KIND_PERF cap handler that routes a
  //        ring-3 request into this harness.  The individual tests are
  //        public (`pub let _ca_test_*`) specifically so such a handler
  //        can pick-and-mix cases.
  //
  // Wiring is intentionally DEFERRED to a successor milestone: landing
  // the harness without a boot hook keeps this slice self-contained
  // and lets the kernel_main.pdx edit arrive in its own named ticket.
  // ==========================================================================
}
