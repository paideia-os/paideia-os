// src/kernel/core/perf/regression_gate.pdx -- UMB-W25 R141.M6 landing
// paideia-os #2650 (umbrella decomposition wave 25).
//
// Smoke-test regression gate for microbench site statistics. R141.M5
// (perf-baselines.md) landed the operator-facing baseline reference;
// R141.M6 (THIS LANDING) turns that reference into a machine-checkable
// gate that compares a boot's observed `_mb_site_stats` numbers
// against the §4 shapes and emits a PASS/FAIL fingerprint per site.
// The gate is pure READ-SIDE: no cap authority, no scheduler coupling,
// no cross-core guards. Its only job is to notice that a wave moved
// the shape of a site's cycle numbers out of the budgets recorded in
// design/perf/perf-baselines.md and to leave a grep-able line on the
// klog ring saying so.
//
// =============================================================================
// SECTION 0  POSTURE
// =============================================================================
//
// Regression gate is PERF-REPORTING: no capability authority (any
// future KIND_MICROBENCH op dispatch reaches it from a kernel-mode
// context already holding the cap), no scheduler coupling, no cross-
// core guards. Every API below is called from BSP-only boot or from
// a cap_handler arm with its own serialisation; the gate itself takes
// no locks. Per-site state is read in-place from the microbench
// registry via `_mb_site_stats`; a torn read of a row concurrently
// with `_mb_sample_end` sees a slightly-stale `min/max/sum/count`
// snapshot (microbench publishes `sample_count` last per its own §2
// posture), never a cross-site mixup, and never a value outside the
// register's u64 range -- the gate therefore never faults on torn
// data, it just gates on a slightly-older measurement.
//
// At the R141.M6 landing the gate is INFORMATIONAL ONLY: it emits
// PASS / FAIL fingerprints but does NOT halt the boot on a FAIL.
// The smoke-mode harness (tools/run-smoke.sh) is the component that
// decides whether a FAIL stops a build; R141.M7 (forward) wires a
// smoke-mode golden that greps for `PERF_GATE SITE FAIL` and raises
// the exit code to 1 when the pattern appears.
//
// =============================================================================
// SECTION 1  BASELINE TABLE LAYOUT  --  8 u64 PER ROW, 8 ROWS
// =============================================================================
//
// The baseline table encodes one row per microbench site slot (0..7).
// Each row is 64 bytes = 8 u64:
//
//   [+0]  site_hash       -- djb2 u64 digest of the registered site
//                            name, resolved at _rg_init time from
//                            _mb_sites[site_id * 48 + 8]. Serves as
//                            the fingerprint's site identifier (the
//                            `PERF_GATE SITE PASS/FAIL site=0x<hash>`
//                            KV) so a smoke-mode consumer can locate
//                            the per-site regression line regardless
//                            of slot-index drift. A future R141.M7+
//                            cross-check could re-hash rg_name_*
//                            constants (not landed at M6) and compare
//                            against the resolved value to flag
//                            structural inconsistencies.
//   [+8]  min_expected    -- the design/perf/perf-baselines.md §4 cold
//                            `min` nominal (cycles)
//   [+16] max_expected    -- the §4 cold `max` nominal (cycles)
//   [+24] mean_expected   -- the §4 cold `mean` nominal (cycles)
//   [+32] cold_tol_num    -- cold-cache tolerance numerator (×cold_tol
//                            = cold_tol_num / cold_tol_den; §5 of
//                            perf-baselines.md pins ×2.0 = 2/1).
//                            **ALSO** the RG_FLAG_PLACEHOLDER sentinel:
//                            when cold_tol_num == 0 the gate SKIPS the
//                            site (returns RG_OK without checking any
//                            axis). Placeholder rows exist for sites
//                            whose §4 numbers are expected but have
//                            no kernel-mode driver (fuzz_cmd_reg,
//                            fuzz_wit_br, fuzz_stdout at M6 landing)
//                            and for reserved slots (4..7).
//   [+40] cold_tol_den    -- cold-cache tolerance denominator
//   [+48] warm_tol_num    -- warm-cache tolerance numerator (§5 of
//                            perf-baselines.md pins ×1.3 = 13/10)
//   [+56] warm_tol_den    -- warm-cache tolerance denominator
//
// Row stride 64 = 2^6, so address compute is `shl rax, 6` (power of
// two, no imul). Matches the microbench-harness.md 48-byte row
// posture in SPIRIT (both are flat per-site rows) but PICKS a power-
// of-two stride for the gate's own table so the encoder discipline
// matches `_mb_ring_base`'s `shl rax, 10` posture rather than
// `_mb_row_base`'s `imul rax, 48` posture. The gate's hot path is
// shorter when the shift replaces the reg-reg imul.
//
// =============================================================================
// SECTION 2  SITE COVERAGE AT R141.M6 LANDING
// =============================================================================
//
// Site 0 : cap_invoke       -- LIVE (see §4.1)
// Site 1 : fuzz_cmd_reg     -- PLACEHOLDER (no boot driver; see §4.2)
// Site 2 : fuzz_wit_br      -- PLACEHOLDER (no boot driver; see §4.2)
// Site 3 : fuzz_stdout      -- PLACEHOLDER (no boot driver; see §4.2)
// Site 4..7                 -- RESERVED (placeholder; §6 for upgrade)
//
// =============================================================================
// SECTION 3  RETURN CODES
// =============================================================================
//
// RG_OK           = 0
// RG_FAIL_MIN     = 0x2600  -- observed `min`  exceeds warm-tol upper
// RG_FAIL_MAX     = 0x2601  -- observed `max`  exceeds cold-tol upper
// RG_FAIL_MEAN    = 0x2602  -- observed `mean` exceeds warm-tol upper
// RG_ERR_BAD_SITE = 0x2603  -- site_id out of range, OR baseline hash
//                              mismatches registry (fail-closed)
//
// All fit imm32 (zero-extend to u64 via `mov rax, imm32` 7-byte emit).
// Error base 0x2600 is adjacent to but outside existing bands;
// `grep -rnE '0x260[0-3]\b' src/ 2>/dev/null` returned zero hits at
// landing time.
//
// Per §5 of perf-baselines.md the axis-to-tolerance mapping is:
//   `min`  -> warm tolerance (×1.3)
//   `max`  -> cold tolerance (×2.0)
//   `mean` -> warm tolerance (×1.3)
// Count-==0 sites skip (not yet driven). An observed value BELOW the
// expected nominal is NEVER a gate failure (§5 "a kernel that got
// faster is a successful build").
//
// =============================================================================
// SECTION 4  PUBLIC API
// =============================================================================
//
// _rg_init() -> ()
//   Boot entry. Seeds the baseline table (constants from §4.1 of
//   perf-baselines.md) and resolves the site_hash fields of each row
//   from the microbench registry. Emits `PERF_GATE INIT OK` via
//   klog_s1. Must run AFTER `_mb_init`, `_perf_sink_init`, and
//   `_fz_init` so every live site is registered before the gate reads
//   the registry's name_hash fields.
//
// _rg_check_site(site_id) -> errno
//   Validates one site against its baseline row. Returns RG_OK on
//   PASS or placeholder-skip; RG_FAIL_MIN/MAX/MEAN on tolerance
//   breach; RG_ERR_BAD_SITE on out-of-range or hash mismatch. Emits
//   `PERF_GATE SITE PASS` or `PERF_GATE SITE FAIL` fingerprint per
//   call via klog_s1_x2 (site + actual_cycles).
//
// _rg_check_all() -> packed u64 = (fail_mask << 32) | pass_count
//   Iterates all 8 slots. `fail_mask` is a 32-bit bitmap with bit N
//   set when site N returned a non-RG_OK result (either tolerance
//   breach or bad-site error); `pass_count` is a 32-bit count of
//   sites that returned RG_OK (including placeholder-skipped sites).
//   The caller recovers each half via `shr r, 32` / `and r, 0xFFFF
//   FFFF`.
//
// =============================================================================
// SECTION 5  OBSERVABILITY COUNTERS  --  8 SLOTS
// =============================================================================
//
// _rg_stats[8] via _rg_note(slot). All slots fit imm8:
//
//   RG_ST_INIT_OK     = 0  -- _rg_init cascade completed
//   RG_ST_CHECK_PASS  = 1  -- _rg_check_site returned RG_OK on a live row
//   RG_ST_CHECK_SKIP  = 2  -- placeholder-skip (cold_tol_num == 0)
//   RG_ST_CHECK_FAIL  = 3  -- any RG_FAIL_* tolerance breach
//   RG_ST_CHECK_BAD   = 4  -- RG_ERR_BAD_SITE (out of range or hash
//                             mismatch)
//   RG_ST_CHECK_ALL   = 5  -- _rg_check_all cascade completed
//   // slots 6..7 reserved (R141.M7+ smoke-mode gate wiring).
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// * Row stride 64 B = 2^6 -- `shl rax, 6` (no imul).
// * No 2-op `imul r, imm`. Tolerance scaling uses `imul rN, rM`
//   reg-reg (one of the two operands is loaded via a prior `mov rN,
//   imm` or a baseline-row load). Overflow risk analysis: a healthy
//   `max` is bounded by `max_expected * cold_tol_num` <= 6000 * 2 =
//   12000; even pathological 10^5 cycles * 100 numerator stays
//   under 2^24. No u64 overflow risk inside the gate's compute.
// * No `and r, imm64` -- the gate never masks against a 64-bit
//   literal; every comparison is reg-reg.
// * All liveness/zero tests use `cmp rN, 0` (never `test rN, rN`).
// * All `pub let` string decls are single-line (no multi-line `"..."`).
// * Module basename `RegressionGate` matches file basename
//   `regression_gate.pdx`.
// * Every label in this file is prefixed `rg_` (reserved-word
//   discipline -- `loop`/`if`/`let` are keywords).
// * Return constants RG_OK (0) and RG_FAIL_* / RG_ERR_* (0x2600 ..
//   0x2603) fit imm32.
// * KV table built on-stack where needed (ps_ds_ pattern):
//   klog_s1_x2 for PASS/FAIL takes 48 B, aligned to 16 B.
// * Static baseline table seeded at _rg_init time via sequential
//   stores (no literal `[u64; 64] = [... , ... ]` syntax -- paideia-
//   as does not currently synthesize that initializer; .bss .rodata
//   discipline is to zero-init and seed at boot, same shape as
//   `_mb_tables_reset` in microbench.pdx).

module RegressionGate = structure {

  // Return codes (§3).
  pub let RG_OK            : u64 = 0
  pub let RG_FAIL_MIN      : u64 = 0x2600
  pub let RG_FAIL_MAX      : u64 = 0x2601
  pub let RG_FAIL_MEAN     : u64 = 0x2602
  pub let RG_ERR_BAD_SITE  : u64 = 0x2603

  // Placeholder sentinel: baseline row's cold_tol_num slot == this
  // means "skip the row". §1.
  pub let RG_FLAG_PLACEHOLDER : u64 = 0

  // Table geometry (§1).
  pub let RG_MAX_SITES : u64 = 8
  pub let RG_ROW_U64   : u64 = 8
  pub let RG_ROW_BYTES : u64 = 64

  // Row offsets (bytes).
  pub let RG_OFF_HASH        : u64 = 0
  pub let RG_OFF_MIN         : u64 = 8
  pub let RG_OFF_MAX         : u64 = 16
  pub let RG_OFF_MEAN        : u64 = 24
  pub let RG_OFF_COLD_NUM    : u64 = 32
  pub let RG_OFF_COLD_DEN    : u64 = 40
  pub let RG_OFF_WARM_NUM    : u64 = 48
  pub let RG_OFF_WARM_DEN    : u64 = 56

  // Microbench row offsets (microbench.pdx §1).
  pub let MB_OFF_NAME_HASH   : u64 = 8
  pub let MB_OFF_COUNT       : u64 = 16
  pub let MB_OFF_MIN         : u64 = 24
  pub let MB_OFF_MAX         : u64 = 32
  pub let MB_OFF_SUM         : u64 = 40

  // Observability slot indices (§5).
  pub let RG_ST_INIT_OK      : u64 = 0
  pub let RG_ST_CHECK_PASS   : u64 = 1
  pub let RG_ST_CHECK_SKIP   : u64 = 2
  pub let RG_ST_CHECK_FAIL   : u64 = 3
  pub let RG_ST_CHECK_BAD    : u64 = 4
  pub let RG_ST_CHECK_ALL    : u64 = 5

  // -----------------------------------------------------------------
  // Storage
  // -----------------------------------------------------------------
  //
  // Baseline table: 8 rows x 8 u64 = 64 u64 = 512 B.
  // Scratch for _mb_site_stats landing: 48 B = 6 u64.
  // Observability counters: 8 u64 = 64 B.
  // Total ~584 B.

  pub let mut _rg_baseline : [u64; 64] = uninit @align(64)
  pub let mut _rg_scratch  : [u64; 6]  = uninit @align(64)
  pub let mut _rg_stats    : [u64; 8]  = uninit @align(64)

  // Fingerprint tags. Byte counts NUL-inclusive per kernel-logging-
  // substrate.md discipline.
  //
  // Two tags rather than a single `PERF_GATE SITE` with a result KV:
  // klog's KV formatter has no string-value fmt letter at R141.M6,
  // so a hex-encoded "PASS"/"FAIL" sentinel (0x50415353 / 0x4641494C)
  // would render as `result=0x50415353` which defeats the grep-
  // ergonomic value of a fingerprint. The two-tag shape keeps the
  // smoke-mode golden simple: `grep '^.*PERF_GATE SITE FAIL' logfile`
  // locates every regression line in one sweep.
  pub let rg_tag_init : [u8; 18] = "PERF_GATE INIT OK\0"
  pub let rg_tag_pass : [u8; 20] = "PERF_GATE SITE PASS\0"
  pub let rg_tag_fail : [u8; 20] = "PERF_GATE SITE FAIL\0"
  pub let rg_tag_all  : [u8; 17] = "PERF_GATE ALL OK\0"

  pub let rg_k_site   : [u8; 5] = "site\0"
  pub let rg_k_actual : [u8; 7] = "actual\0"
  pub let rg_k_fail   : [u8; 5] = "fail\0"
  pub let rg_k_pass   : [u8; 5] = "pass\0"

  // Baseline shape constants (from design/perf/perf-baselines.md §4.1
  // cap_invoke, cold shape; see §5 of that doc for the ×2.0 cold /
  // ×1.3 warm tolerance posture).
  pub let RG_CAP_INVOKE_MIN  : u64 = 1500
  pub let RG_CAP_INVOKE_MAX  : u64 = 6000
  pub let RG_CAP_INVOKE_MEAN : u64 = 3500
  pub let RG_COLD_TOL_NUM    : u64 = 2
  pub let RG_COLD_TOL_DEN    : u64 = 1
  pub let RG_WARM_TOL_NUM    : u64 = 13
  pub let RG_WARM_TOL_DEN    : u64 = 10

  // ==========================================================================
  // _rg_note(stats_slot) -> ()
  //
  // Bump _rg_stats[slot]. Caller passes RG_ST_* constants only.
  // Pure leaf, no callee-save pushes. Mirrors _ps_note / _fz_note.
  // ==========================================================================
  pub let _rg_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): bounded increment on _rg_stats[slot]. Caller passes RG_ST_* constants (0..5) so no out-of-range path is reachable from the gate surface; the cmp/jae guards against caller-stack corruption only. Pure leaf, no callee-save pushes. Labels prefixed rg_no_.",
      block: {
        cmp rdi, 8;
        jae rg_no_out;
        lea r10, [rip + _rg_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      rg_no_out:
        ret
      }
    }

  // ==========================================================================
  // _rg_row_base(site_id) -> &_rg_baseline[site_id * 8]
  //
  // Row index -> row base pointer. Stride 64 B = 2^6, so `shl rax, 6`
  // (power of two, no imul needed). No bounds check by policy: caller
  // validates first. Mirrors `_mb_ring_base`'s shl idiom.
  // ==========================================================================
  pub let _rg_row_base : (u64) -> u64 !{} @{} =
    fn (site_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): site_id -> &_rg_baseline[site_id*8] (byte offset site_id*64). Stride 64 B = 2^6 so `shl rax, 6` suffices. Pure leaf, no bounds check (caller validates). Labels prefixed rg_rb_.",
      block: {
        mov rax, rdi;
        shl rax, 6;
        lea r10, [rip + _rg_baseline];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // _rg_seed_cap_invoke(row_base) -> ()
  //
  // Seed the cap_invoke baseline row (slot 0) with the §4.1 cold-shape
  // numbers and the §5 cold+warm tolerance ratios. The site_hash slot
  // is left zero here; _rg_init resolves it from the microbench
  // registry after seeding.
  //
  // Pure leaf: no callee-save push, no nested calls. One register
  // (rbx) parks the row base across the sequential stores.
  // ==========================================================================
  pub let _rg_seed_cap_invoke : (u64) -> () !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): seed cap_invoke baseline row -- min=1500, max=6000, mean=3500 cycles (§4.1 cold shape); cold_tol=2/1 (×2.0), warm_tol=13/10 (×1.3) (§5). site_hash slot left zero; _rg_init resolves it from the microbench registry after seeding. Pure leaf, no callee-save, no nested calls. Labels prefixed rg_sc_.",
      block: {
        // site_hash left zero (resolved later).
        xor rax, rax;
        mov [rdi + 0], rax;

        // min_expected = 1500.
        mov rax, 1500;
        mov [rdi + 8], rax;

        // max_expected = 6000.
        mov rax, 6000;
        mov [rdi + 16], rax;

        // mean_expected = 3500.
        mov rax, 3500;
        mov [rdi + 24], rax;

        // cold_tol_num = 2.
        mov rax, 2;
        mov [rdi + 32], rax;

        // cold_tol_den = 1.
        mov rax, 1;
        mov [rdi + 40], rax;

        // warm_tol_num = 13.
        mov rax, 13;
        mov [rdi + 48], rax;

        // warm_tol_den = 10.
        mov rax, 10;
        mov [rdi + 56], rax;

        ret
      }
    }

  // ==========================================================================
  // _rg_seed_placeholder(row_base) -> ()
  //
  // Zero every slot in the row, which also puts RG_FLAG_PLACEHOLDER
  // (0) in the cold_tol_num slot -- the gate skips the row. Used for
  // rows 1..3 (fuzz sites, no boot driver yet) and rows 4..7
  // (reserved).
  //
  // Pure leaf: eight sequential 8-byte zero stores.
  // ==========================================================================
  pub let _rg_seed_placeholder : (u64) -> () !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): zero every slot in the baseline row. cold_tol_num slot == 0 == RG_FLAG_PLACEHOLDER, so the gate skips the row. Used for M6 fuzz-site rows (no boot driver) and reserved rows. Pure leaf. Labels prefixed rg_sp_.",
      block: {
        xor rax, rax;
        mov [rdi + 0], rax;
        mov [rdi + 8], rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;
        mov [rdi + 32], rax;
        mov [rdi + 40], rax;
        mov [rdi + 48], rax;
        mov [rdi + 56], rax;
        ret
      }
    }

  // ==========================================================================
  // _rg_resolve_hash(site_id) -> name_hash
  //
  // Read the registered site's name_hash from the microbench registry
  // (_mb_sites[site_id * 48 + 8]) and return it. Site_id must be
  // < _mb_site_count() -- the caller gates this.
  //
  // Register plan: one callee-save push (rbx = site_id park). Entry
  // rsp%16==8; +8 -> rsp%16==0 at the nested _mb_row_base call.
  // ==========================================================================
  pub let _rg_resolve_hash : (u64) -> u64 !{mem} @{} =
    fn (site_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): read _mb_sites[site_id*48 + 8] (name_hash field, microbench row offset +8) and return it. Caller gates site_id < _mb_site_count(). One callee-save push (rbx = site_id park) lands rsp%16==0 at the nested _mb_row_base call (entry rsp%16==8; +8 -> 0). Labels prefixed rg_rh_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // site_id park
        call _mb_row_base;               // rax = &_mb_sites[site_id*48]
        mov rax, [rax + 8];              // name_hash

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _rg_check_site(site_id) -> errno
  //
  // Compare the microbench site's current {min, max, mean} against
  // the baseline row's shape under the §5 tolerance posture. Emits a
  // PASS or FAIL fingerprint via klog_s1_x2. Returns:
  //
  //   RG_OK           = 0        on PASS or placeholder-skip
  //   RG_FAIL_MIN     = 0x2600   observed min  > min_expected  * warm_tol
  //   RG_FAIL_MAX     = 0x2601   observed max  > max_expected  * cold_tol
  //   RG_FAIL_MEAN    = 0x2602   observed mean > mean_expected * warm_tol
  //   RG_ERR_BAD_SITE = 0x2603   site_id out of range OR hash mismatch
  //
  // Algorithm per axis (overflow-safe cross multiply):
  //
  //   observed_min  > (min_expected  * warm_tol_num) / warm_tol_den
  //   <=>  observed_min * warm_tol_den > min_expected * warm_tol_num
  //
  // The cross-multiply form avoids integer division (and its #DE
  // risk on tol_den==0) and keeps every intermediate in u64 range
  // (max ~10^5 * 100 = 10^7, well under 2^32).
  //
  // count==0 (no samples driven yet) also skips to RG_OK: the site
  // was registered but not populated, so there is no observed shape
  // to gate on.
  //
  // Register plan: five callee-save pushes (rbx=site_id, r12=row_base,
  // r13=count, r14=observed-failing-axis cycles, r15=errno-park /
  // scratch-base). Entry rsp%16==8; +5*8=40 -> rsp%16==(8+40)%16==0
  // at every nested call. Stack args to klog_s1_x2 (one u64 slot +
  // 8-byte alignment pad = 16 B) wrap each emit with `sub rsp,16 /
  // add rsp,16`, keeping rsp%16==0 at the CALL instruction (the
  // CPU-pushed retaddr then lands the wrapper at rsp%16==8 as SysV
  // requires). Labels prefixed rg_cs_.
  // ==========================================================================
  pub let _rg_check_site : (u64) -> u64 !{mem, sysreg} @{} =
    fn (site_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): compare one microbench site's observed stats against the baseline row's shape under the §5 cold+warm tolerance posture. Validate site_id<RG_MAX_SITES=8 (else RG_ERR_BAD_SITE+note). Read baseline row via _rg_row_base; placeholder-skip if cold_tol_num==0. Call _mb_site_stats(site_id, &_rg_scratch); count==0 -> placeholder-skip. Compute mean = sum/count via `xor rdx,rdx; div r13` (count>0 so safe). For each axis (min->warm, max->cold, mean->warm) compare `actual * tol_den` vs `expected * tol_num` via `imul rN, rM` reg-reg (overflow analysis in §6). Emit PERF_GATE SITE PASS (actual=min, hex) or PERF_GATE SITE FAIL (actual=failing-axis cycles) via klog_s1_x2 wrapped in sub-rsp-16/add-rsp-16 for the stack-arg v2. Five callee-save pushes (rbx=site_id, r12=row_base, r13=count, r14=observed-failing-axis cycles, r15=stats-base reused as errno-park on the FAIL path) land rsp%16==0 at every nested call (entry 8 + 40 = 48; 48%16==0). Labels prefixed rg_cs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // site_id park

        // Validate site_id against RG_MAX_SITES (8).
        mov r10, 8;
        cmp rbx, r10;
        jae rg_cs_bad_site;

        // Row base for the baseline.
        mov rdi, rbx;
        call _rg_row_base;
        mov r12, rax;                    // row_base park

        // Placeholder-skip: cold_tol_num == 0 ?
        mov rax, [r12 + 32];
        cmp rax, 0;
        je rg_cs_skip;

        // Fetch site stats into _rg_scratch.
        mov rdi, rbx;
        lea rsi, [rip + _rg_scratch];
        call _mb_site_stats;
        cmp rax, 0;
        jne rg_cs_bad_site;              // _mb_site_stats failed

        // r15 = &_rg_scratch (used by every axis read below).
        lea r15, [rip + _rg_scratch];

        // count==0 ? -> skip (not yet driven).
        mov r13, [r15 + 16];             // sample_count
        cmp r13, 0;
        je rg_cs_skip;

        // Load observed axes.
        mov r14, [r15 + 24];             // observed min  (parked for PASS)

        // Axis 1: min, warm tolerance.
        // Fail if r14 * warm_tol_den > min_expected * warm_tol_num.
        mov rax, r14;                    // observed min
        mov r10, [r12 + 56];             // warm_tol_den
        imul rax, r10;                   // observed_min * warm_tol_den
        mov r11, [r12 + 8];              // min_expected
        mov r10, [r12 + 48];             // warm_tol_num
        imul r11, r10;                   // min_expected * warm_tol_num
        cmp rax, r11;
        ja rg_cs_fail_min;

        // Axis 2: max, cold tolerance.
        mov rcx, [r15 + 32];             // observed max
        mov rax, rcx;                    // dupe for product
        mov r10, [r12 + 40];             // cold_tol_den
        imul rax, r10;                   // observed_max * cold_tol_den
        mov r11, [r12 + 16];             // max_expected
        mov r10, [r12 + 32];             // cold_tol_num
        imul r11, r10;                   // max_expected * cold_tol_num
        cmp rax, r11;
        ja rg_cs_fail_max;

        // Axis 3: mean, warm tolerance. mean = sum / count (count>0).
        mov rax, [r15 + 40];             // sum
        xor rdx, rdx;
        div r13;                         // rax = sum / count = mean
        mov rcx, rax;                    // observed mean park
        mov r10, [r12 + 56];             // warm_tol_den
        imul rax, r10;                   // mean * warm_tol_den
        mov r11, [r12 + 24];             // mean_expected
        mov r10, [r12 + 48];             // warm_tol_num
        imul r11, r10;                   // mean_expected * warm_tol_num
        cmp rax, r11;
        ja rg_cs_fail_mean;

        // ================ PASS path ================
        // Emit `PERF_GATE SITE PASS site=0x<hash> actual=0x<min>` via
        // klog_s1_x2 (2 hex KVs).
        //
        // klog_s1_x2 signature: (level, subsys_ptr, tag_ptr, k1, v1, k2)
        // with v2 pushed on the caller stack at pre-CALL [rsp+0], which
        // the retaddr shifts to post-CALL [rsp+8]. We pre-sub rsp,16
        // (8 for the slot + 8 to keep rsp%16==0 at CALL), store v2 at
        // [rsp+0], CALL, then add rsp,16. KV[0]={site, hash, 'x'};
        // KV[1]={actual, min, 'x'}.

        sub rsp, 16;
        mov [rsp + 0], r14;              // v2 = observed min
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + rg_tag_pass];
        lea rcx, [rip + rg_k_site];
        mov r8, [r12 + 0];               // v1 = site_hash
        lea r9, [rip + rg_k_actual];
        call klog_s1_x2;
        add rsp, 16;

        mov rdi, 1;                      // RG_ST_CHECK_PASS
        call _rg_note;

        xor rax, rax;                    // RG_OK
        jmp rg_cs_out;

      rg_cs_fail_min:
        // r14 holds observed min. Park errno in a safe reg
        // (r15 is already allocated per the register plan but we
        // used it as the scratch base earlier; it is dead by now).
        mov r15, 0x2600;                 // RG_FAIL_MIN parked
        jmp rg_cs_fail_emit;

      rg_cs_fail_max:
        // rcx held observed max; move into r14 for the emit path.
        mov r14, rcx;
        mov r15, 0x2601;                 // RG_FAIL_MAX parked
        jmp rg_cs_fail_emit;

      rg_cs_fail_mean:
        // rcx held observed mean; move into r14 for the emit path.
        mov r14, rcx;
        mov r15, 0x2602;                 // RG_FAIL_MEAN parked
        jmp rg_cs_fail_emit;

      rg_cs_fail_emit:
        // Emit `PERF_GATE SITE FAIL site=0x<hash> actual=0x<cycles>`
        // via klog_s1_x2; v2 = r14 (observed failing-axis cycles).
        sub rsp, 16;
        mov [rsp + 0], r14;              // v2 = observed cycles
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + rg_tag_fail];
        lea rcx, [rip + rg_k_site];
        mov r8, [r12 + 0];               // v1 = site_hash
        lea r9, [rip + rg_k_actual];
        call klog_s1_x2;
        add rsp, 16;

        mov rdi, 3;                      // RG_ST_CHECK_FAIL
        call _rg_note;

        mov rax, r15;                    // retrieve errno
        jmp rg_cs_out;

      rg_cs_skip:
        mov rdi, 2;                      // RG_ST_CHECK_SKIP
        call _rg_note;
        xor rax, rax;                    // RG_OK
        jmp rg_cs_out;

      rg_cs_bad_site:
        mov rdi, 4;                      // RG_ST_CHECK_BAD
        call _rg_note;
        mov rax, 0x2603;                 // RG_ERR_BAD_SITE

      rg_cs_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _rg_check_all() -> packed u64 = (fail_mask << 32) | pass_count
  //
  // Iterate all 8 slots. fail_mask has bit N set when site N returned
  // a non-RG_OK result (either a tolerance breach or RG_ERR_BAD_SITE);
  // pass_count counts sites that returned RG_OK. Note: placeholder-
  // skipped and count==0 sites both return RG_OK, so pass_count is a
  // "no-shape-regression-observed" tally, not a "non-empty-site" tally.
  // The smoke-mode consumer greps for `PERF_GATE SITE FAIL` lines
  // directly rather than reading pass_count.
  //
  // Register plan: three callee-save pushes (rbx=i, r12=fail_mask,
  // r13=pass_count). Entry rsp%16==8; +3*8 -> rsp%16==0 at every
  // nested _rg_check_site + _rg_note + klog call. Labels prefixed
  // rg_ca_.
  // ==========================================================================
  pub let _rg_check_all : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W25 R141.M6 (#2650): iterate 8 baseline rows; call _rg_check_site(i) for each; or-in bit i of fail_mask when non-RG_OK; bump pass_count on RG_OK. Return (fail_mask<<32)|pass_count. Emit PERF_GATE ALL OK fingerprint via klog_s1_x2 with fail_mask + pass_count KVs. Three callee-save pushes (rbx=i, r12=fail_mask, r13=pass_count) land rsp%16==0 at nested calls (entry 8 + 24 = 32, 32%16==0). Labels prefixed rg_ca_.",
      block: {
        push rbx;
        push r12;
        push r13;

        xor rbx, rbx;                    // i = 0
        xor r12, r12;                    // fail_mask = 0
        xor r13, r13;                    // pass_count = 0

      rg_ca_loop:
        mov r10, 8;
        cmp rbx, r10;
        jae rg_ca_done;

        mov rdi, rbx;
        call _rg_check_site;

        cmp rax, 0;
        je rg_ca_pass;

        // Fail: set bit rbx in fail_mask via `shl r, cl` (cl is the
        // low byte of rcx; i fits imm8 since rbx < 8). Encoder posture
        // mirrors pdxfs_lite/alloc.pdx L140 (`shl r11, cl`).
        mov r10, 1;
        mov rcx, rbx;                    // cl = i
        shl r10, cl;                     // r10 = 1 << i
        or r12, r10;                     // fail_mask |= 1 << i
        jmp rg_ca_cont;

      rg_ca_pass:
        add r13, 1;

      rg_ca_cont:
        add rbx, 1;
        jmp rg_ca_loop;

      rg_ca_done:
        // Emit `PERF_GATE ALL OK fail=0x<mask> pass=0x<count>` via
        // klog_s1_x2 (two hex KVs). v2 is pass_count (r13) and goes
        // on the caller stack.
        sub rsp, 16;
        mov [rsp + 0], r13;              // v2 = pass_count

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + rg_tag_all];
        lea rcx, [rip + rg_k_fail];
        mov r8, r12;                     // v1 = fail_mask
        lea r9, [rip + rg_k_pass];
        call klog_s1_x2;

        add rsp, 16;

        // Bump RG_ST_CHECK_ALL.
        mov rdi, 5;
        call _rg_note;

        // Pack return: (fail_mask << 32) | pass_count.
        mov rax, r12;
        shl rax, 32;
        or rax, r13;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _rg_init() -> ()
  //
  // Boot entry. Seed the baseline table (cap_invoke live row + seven
  // placeholder rows), resolve the live row's site_hash from the
  // microbench registry, and emit `PERF_GATE INIT OK` via klog_s1.
  //
  // Must run AFTER:
  //   * _mb_init (so cap_invoke's microbench row is registered)
  //   * _perf_sink_init (so PERF SINK INIT OK is on the wire ahead)
  //   * _fz_init (so fuzz_* rows are registered; even though M6 rows
  //               1..3 are placeholder, _rg_init resolves their
  //               site_hash fields for forward-compat with R141.M7)
  //
  // Register plan: three callee-save pushes (rbx = loop index, r12 =
  // site_count parked across the resolve cascade, r13 = scratch
  // alignment pad / unused). Entry rsp%16==8; +3*8=24 -> rsp%16==
  // (8+24)%16==0 at every nested call. Note: r11 (caller-save) is
  // insufficient to park site_count across the inner _rg_resolve_
  // hash + _rg_row_base calls -- both are leaf-ish but neither
  // preserves r11, so a callee-save slot is required. Labels prefixed
  // rg_in_.
  // ==========================================================================
  pub let _rg_init : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "UMB-W25 R141.M6 (#2650): regression-gate boot entry. Seed baseline table: slot 0 cap_invoke live row (via _rg_seed_cap_invoke); slots 1..7 placeholder (via _rg_seed_placeholder). Resolve site_hash for every slot that has a registered microbench row (via _rg_resolve_hash) and write it into the baseline row's [+0] slot. Bump RG_ST_INIT_OK. Emit `PERF_GATE INIT OK` via klog_s1 (no KV). Three callee-save pushes (rbx=i, r12=site_count, r13=unused-align) land rsp%16==0 at every nested call (entry 8 + 24 = 32, 32%16==0). r11 (caller-save) is NOT viable to park site_count across the inner _rg_resolve_hash + _rg_row_base cascade. Labels prefixed rg_in_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Seed slot 0: cap_invoke.
        mov rdi, 0;
        call _rg_row_base;
        mov rdi, rax;
        call _rg_seed_cap_invoke;

        // Seed slots 1..7 as placeholders.
        mov rbx, 1;
      rg_in_ph_loop:
        mov r10, 8;
        cmp rbx, r10;
        jae rg_in_ph_done;
        mov rdi, rbx;
        call _rg_row_base;
        mov rdi, rax;
        call _rg_seed_placeholder;
        add rbx, 1;
        jmp rg_in_ph_loop;
      rg_in_ph_done:

        // Resolve name_hash for every registered microbench site into
        // the matching baseline row's site_hash slot [+0]. Loop up to
        // min(_mb_site_count(), 8). Parked in r12 (callee-save).
        call _mb_site_count;
        mov r12, rax;                    // site_count
        mov r10, 8;
        cmp r12, r10;
        jbe rg_in_cnt_ok;
        mov r12, 8;                      // clamp to 8
      rg_in_cnt_ok:

        xor rbx, rbx;                    // i = 0
      rg_in_rh_loop:
        cmp rbx, r12;
        jae rg_in_rh_done;

        // name_hash = _rg_resolve_hash(rbx)
        mov rdi, rbx;
        call _rg_resolve_hash;
        mov r13, rax;                    // name_hash park (callee-save)

        // baseline[rbx].site_hash = r13
        mov rdi, rbx;
        call _rg_row_base;
        mov [rax + 0], r13;

        add rbx, 1;
        jmp rg_in_rh_loop;
      rg_in_rh_done:

        // Bump RG_ST_INIT_OK.
        mov rdi, 0;
        call _rg_note;

        // Emit `PERF_GATE INIT OK` via klog_s1 (no KV).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + rg_tag_init];
        call klog_s1;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
