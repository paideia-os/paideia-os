// src/kernel/core/perf/perf_sink.pdx -- UMB-W13 R141.M2 landing
// paideia-os #2646 (umbrella decomposition wave 13).
//
// Perf-sink logging layer. Periodic or on-demand dump of per-site
// microbench statistics (perf/microbench.pdx) to a structured klog
// sink. At R141.M2 the sink is STATIC: every dump line goes straight
// to the klog ring via klog_emit_core, dressed as the `PERF SITE` tag
// with a 5-KV table of {name_hash, sample_count, min, max, mean}
// cycles. R141.M3 wraps this with a KIND_LOG_SINK capability, at
// which point the sink becomes dynamically retargetable (dump into a
// userspace-owned ring, bind to a pdxfs view, forward to a remote
// collector, ...) without changing a line of this module's body.
//
// =============================================================================
// SECTION 0  POSTURE
// =============================================================================
//
// Perf-sink is a PERF-REPORTING substrate: no capability authority
// (the KIND_MICROBENCH dispatcher in cap/kind_microbench.pdx is the
// cap-gate that reaches here), no scheduler coupling, no cross-core
// guards. The dump path is called from one of three contexts:
//
//   (1) a cap_handler_microbench op (MB_OP_DUMP_ALL=5) under a
//       userspace-held KIND_MICROBENCH cap with R_MB_READ;
//   (2) a future on-demand kernel witness (R141.M* debug plot);
//   (3) a periodic timer-driven ping (R141.M* automatic dump), none
//       of which exists at this landing.
//
// Every dump path serialises itself through klog_emit_core's single-
// writer gate; a torn read of a per-site row concurrently with
// _mb_sample_end sees a slightly-stale min/max/sum/count snapshot
// (the microbench harness publishes sample_count LAST per its own
// §2 posture), never a cross-site mixup. The sink itself takes no
// locks.
//
// =============================================================================
// SECTION 1  DUMP LINE FORMAT
// =============================================================================
//
// Per #2646 directive, each dumped site emits ONE klog line via
// klog_emit_core with:
//
//   level     = LEVEL_INFO (3)
//   subsys    = SUBSYS_TIME ("time\0")      (shared with microbench
//                                              init/register lines;
//                                              a dedicated SUBSYS_PERF
//                                              shard lands with R141.M3)
//   tag       = "PERF SITE\0"
//   kvs       = 5 entries:
//                 [0] name  = djb2 name_hash                 fmt='x' (hex)
//                 [1] count = sample_count                   fmt='d' (dec)
//                 [2] min   = min_cycles                     fmt='d' (dec)
//                 [3] max   = max_cycles                     fmt='d' (dec)
//                 [4] mean  = sum_cycles / sample_count      fmt='d' (dec)
//
// Rendered form (klog_emit_core adds timestamp / level / cpu / subsys
// prefix per boot-transcript.md §4.1):
//
//   [  <sec>.<usec>] INFO cpu0 time: PERF SITE name=0x<16-hex>
//                                     count=<N> min=<N> max=<N> mean=<N>
//
// `mean` is computed as `sum / count` with a count==0 guard that
// substitutes 0 (never raises #DE). The guard matters because a site
// may be REGISTERED without ever having its bracket entered -- the
// skeleton registers cap_invoke at _mb_init time, so the first dump
// after boot (before any ring-3 cap_invoke) would see count=0 for
// every site but the one the current boot path has already crossed.
//
// =============================================================================
// SECTION 2  PUBLIC API
// =============================================================================
//
// _perf_sink_init() -> ()
//   Boot entry. Emits `PERF SINK INIT OK` fingerprint via klog_s1 and
//   bumps PS_ST_INIT_OK. The static sink requires no state init at M2
//   (R141.M3's KIND_LOG_SINK wiring adds a sink-table reset here).
//
// _perf_sink_dump_all() -> u64
//   Iterates all registered microbench sites in [0, _mb_site_count())
//   and emits one `PERF SITE ...` line per site. Returns PS_OK on
//   success, PS_ERR_NO_SITES when the registry is empty (the kernel
//   has not yet reached _mb_init, or _mb_init registered zero sites;
//   neither case is reachable in a healthy boot).
//
// _perf_sink_dump_site(site_id: u64) -> u64
//   Single-site variant. Validates site_id < _mb_site_count(), reads
//   the 48 B row from _mb_sites, formats the 5-KV table on the stack,
//   and calls klog_emit_core. Returns PS_OK or PS_ERR_NO_SITES.
//
// =============================================================================
// SECTION 3  RETURN CODES
// =============================================================================
//
// PS_OK           = 0
// PS_ERR_NO_SITES = 0x1300
//
// Both fit imm32 (zero-extend to u64 via `mov rax, imm32` 7-byte
// emit). The error-band base 0x1300 is adjacent to the existing
// KMB_BAD_SITE=0xFFFFFCC7 upper band but outside it; `grep -rnE
// '0x1300\b' src/ 2>/dev/null` returned zero hits at landing time.
//
// =============================================================================
// SECTION 4  OBSERVABILITY COUNTERS  --  8 SLOTS
// =============================================================================
//
// _ps_stats[8] via _ps_note(slot). All slots fit imm8:
//
//   PS_ST_INIT_OK      = 0
//   PS_ST_DUMP_OK      = 1   // _perf_sink_dump_all end-of-cascade
//   PS_ST_DUMP_NO_SITES = 2  // dump_all called with empty registry
//   PS_ST_SITE_OK      = 3   // _perf_sink_dump_site per-call tally
//   PS_ST_SITE_BAD     = 4   // _perf_sink_dump_site out-of-range gate
//   // slots 5..7 reserved for M3 KIND_LOG_SINK wiring (sink_register,
//   // sink_unregister, sink_dispatch).
//
// =============================================================================
// SECTION 5  paideia-as encoder-gap posture
// =============================================================================
//
// * No 2-op `imul r, imm` -- we never need one (site stride compute
//   lives in microbench.pdx; this file only reads row offsets).
// * No `and r, imm64` -- rights mask comparisons stage through r11
//   (not needed in this file at all; the cap_handler_microbench arm
//   runs the rights gate before dispatching here).
// * All liveness/zero tests use `cmp rN, 0` (never `test rN, rN`).
// * All `pub let` string decls are single-line.
// * Module basename `PerfSink` matches file basename `perf_sink.pdx`.
// * Every label in this file is prefixed `ps_` (reserved-word
//   discipline -- `loop`/`if`/`let` are keywords).
// * Return constants PS_OK (0) and PS_ERR_NO_SITES (0x1300) fit imm32.
// * KV table built on-stack: 5 entries x 24 bytes = 120 bytes, rounded
//   to 128 for 16-byte alignment at every nested call site.
// * Mean compute: `xor rdx, rdx; div rN` reg-reg (paideia-as supports
//   `div reg` directly; same posture as klog/hex.pdx::u64_to_dec L105).

module PerfSink = structure {

  // Error codes (§3).
  pub let PS_OK            : u64 = 0
  pub let PS_ERR_NO_SITES  : u64 = 0x1300

  // Observability slot indices (§4).
  pub let PS_ST_INIT_OK       : u64 = 0
  pub let PS_ST_DUMP_OK       : u64 = 1
  pub let PS_ST_DUMP_NO_SITES : u64 = 2
  pub let PS_ST_SITE_OK       : u64 = 3
  pub let PS_ST_SITE_BAD      : u64 = 4

  // Observability storage.
  pub let mut _ps_stats : [u64; 8] = uninit @align(64)

  // Fingerprint tags. Byte counts NUL-inclusive per kernel-logging-
  // substrate.md discipline.
  pub let ps_tag_init : [u8; 18] = "PERF SINK INIT OK\0"
  pub let ps_tag_dump : [u8; 18] = "PERF SINK DUMP OK\0"
  pub let ps_tag_site : [u8; 10] = "PERF SITE\0"

  // KV key labels.
  pub let ps_k_name  : [u8; 5] = "name\0"
  pub let ps_k_count : [u8; 6] = "count\0"
  pub let ps_k_min   : [u8; 4] = "min\0"
  pub let ps_k_max   : [u8; 4] = "max\0"
  pub let ps_k_mean  : [u8; 5] = "mean\0"
  pub let ps_k_sites : [u8; 6] = "sites\0"

  // ==========================================================================
  // _ps_note(stats_slot) -> ()
  //
  // Bump _ps_stats[slot]. Caller passes PS_ST_* constants only.
  // ==========================================================================
  pub let _ps_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W13 R141.M2 (#2646): bounded increment on _ps_stats[slot]. Caller passes PS_ST_* constants so no out-of-range path is reachable from the handler surface; the cmp/jae guards against caller-stack corruption only. Pure leaf, no callee-save pushes. Labels prefixed ps_no_.",
      block: {
        cmp rdi, 8;
        jae ps_no_out;
        lea r10, [rip + _ps_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ps_no_out:
        ret
      }
    }

  // ==========================================================================
  // _perf_sink_init() -> ()
  //
  // Boot entry. Emits `PERF SINK INIT OK` via klog_s1 (no KV) and
  // bumps PS_ST_INIT_OK. Must run AFTER _mb_init so the site registry
  // exists; see kernel_main.pdx wiring.
  //
  // Register plan: entry rsp%16==8; `sub rsp,8` aligns to rsp%16==0
  // at every nested call; `add rsp,8` before ret restores. No
  // callee-save pushes needed (no live caller state across the two
  // calls -- both are standalone).
  // ==========================================================================
  pub let _perf_sink_init : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "UMB-W13 R141.M2 (#2646): perf-sink boot entry. Step 1: bump PS_ST_INIT_OK via _ps_note. Step 2: emit `PERF SINK INIT OK` fingerprint via klog_s1 (no KV). Static sink requires no table init at M2; the klog ring and the microbench site registry (already up by _mb_init) are the only substrate dependencies. Entry rsp%16==8; `sub rsp,8` aligns to rsp%16==0 at every nested call; `add rsp,8` before ret restores. Labels prefixed ps_in_.",
      block: {
        sub rsp, 8;

        // Step 1: bump PS_ST_INIT_OK.
        mov rdi, 0;                      // PS_ST_INIT_OK
        call _ps_note;

        // Step 2: fingerprint `PERF SINK INIT OK` via klog_s1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + ps_tag_init];
        call klog_s1;

        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _perf_sink_dump_site(site_id) -> u64
  //
  // Snapshot one site's row from _mb_sites and emit a single
  // `PERF SITE ...` klog line via klog_emit_core with a 5-KV table
  // built on the caller stack.
  //
  // Returns:
  //   PS_OK           = 0        on success
  //   PS_ERR_NO_SITES = 0x1300   when site_id >= _mb_site_count()
  //
  // KV table layout (5 entries x 24 bytes = 120 B, 8 B pad -> 128 B):
  //
  //   [rsp + 0]    KV[0].key_ptr   = &ps_k_name  ("name\0")
  //   [rsp + 8]    KV[0].value     = name_hash   ([row+8])
  //   [rsp + 16]   KV[0].fmt       = 0x78 'x'    hex
  //   [rsp + 24]   KV[1].key_ptr   = &ps_k_count ("count\0")
  //   [rsp + 32]   KV[1].value     = sample_count([row+16])
  //   [rsp + 40]   KV[1].fmt       = 0x64 'd'    dec
  //   [rsp + 48]   KV[2].key_ptr   = &ps_k_min   ("min\0")
  //   [rsp + 56]   KV[2].value     = min_cycles  ([row+24])
  //   [rsp + 64]   KV[2].fmt       = 0x64 'd'    dec
  //   [rsp + 72]   KV[3].key_ptr   = &ps_k_max   ("max\0")
  //   [rsp + 80]   KV[3].value     = max_cycles  ([row+32])
  //   [rsp + 88]   KV[3].fmt       = 0x64 'd'    dec
  //   [rsp + 96]   KV[4].key_ptr   = &ps_k_mean  ("mean\0")
  //   [rsp + 104]  KV[4].value     = sum/count   ([row+40]/count)
  //   [rsp + 112]  KV[4].fmt       = 0x64 'd'    dec
  //   [rsp + 120]  (pad)
  //
  // Register plan: three callee-save pushes (rbx=site_id, r12=row_base,
  // r13=sample_count). Entry rsp%16==8; +3 pushes -> rsp%16==0, then
  // `sub rsp,128` keeps rsp%16==0 at every nested call. Epilogue
  // mirrors.
  // ==========================================================================
  pub let _perf_sink_dump_site : (u64) -> u64 !{mem, sysreg} @{} =
    fn (site_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W13 R141.M2 (#2646): snapshot one microbench row and emit a `PERF SITE name=0x<16-hex> count=<N> min=<N> max=<N> mean=<N>` klog line via klog_emit_core with a 5-KV table built on-stack. Validate site_id < _mb_site_count() (else PS_ERR_NO_SITES=0x1300, bump PS_ST_SITE_BAD). Row base via _mb_row_base. Mean = sum/count via `xor rdx,rdx; div r13` with count==0 guard substituting 0 (never #DE). Three callee-save pushes (rbx=site_id, r12=row_base, r13=sample_count) + sub rsp,128 (120 B KV table + 8 B pad) land rsp%16==0 at every nested call (entry rsp%16==8; +24 -> rsp%16==0; +128 -> rsp%16==0). Labels prefixed ps_ds_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 128;

        mov rbx, rdi;                    // rbx = site_id

        // Validate site_id against the site registry.
        call _mb_site_count;             // rax = site_count
        cmp rbx, rax;
        jae ps_ds_bad_site;

        // Row base.
        mov rdi, rbx;
        call _mb_row_base;               // rax = &_mb_sites[site_id*48]
        mov r12, rax;                    // r12 = row_base

        // KV[0]: name = name_hash (hex).
        mov rax, [r12 + 8];              // name_hash
        lea rcx, [rip + ps_k_name];
        mov [rsp + 0], rcx;
        mov [rsp + 8], rax;
        mov rax, 0x78;                   // 'x' hex
        mov [rsp + 16], rax;

        // KV[1]: count = sample_count (decimal).
        mov r13, [r12 + 16];             // r13 = sample_count (parked for mean)
        lea rcx, [rip + ps_k_count];
        mov [rsp + 24], rcx;
        mov [rsp + 32], r13;
        mov rax, 0x64;                   // 'd' dec
        mov [rsp + 40], rax;

        // KV[2]: min = min_cycles (decimal).
        mov rax, [r12 + 24];
        lea rcx, [rip + ps_k_min];
        mov [rsp + 48], rcx;
        mov [rsp + 56], rax;
        mov rax, 0x64;
        mov [rsp + 64], rax;

        // KV[3]: max = max_cycles (decimal).
        mov rax, [r12 + 32];
        lea rcx, [rip + ps_k_max];
        mov [rsp + 72], rcx;
        mov [rsp + 80], rax;
        mov rax, 0x64;
        mov [rsp + 88], rax;

        // KV[4]: mean = sum/count (decimal). count==0 guard -> 0.
        cmp r13, 0;
        je ps_ds_mean_zero;
        mov rax, [r12 + 40];             // sum
        xor rdx, rdx;
        div r13;                         // rax = sum / count
        jmp ps_ds_mean_store;

      ps_ds_mean_zero:
        xor rax, rax;

      ps_ds_mean_store:
        lea rcx, [rip + ps_k_mean];
        mov [rsp + 96], rcx;
        mov [rsp + 104], rax;
        mov rax, 0x64;
        mov [rsp + 112], rax;

        // klog_emit_core(level=3, subsys=SUBSYS_TIME, tag=ps_tag_site,
        //                kvs_ptr=rsp, kv_count=5).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + ps_tag_site];
        mov rcx, rsp;                    // kvs_ptr = &KV[0]
        mov r8, 5;                       // kv_count
        call klog_emit_core;

        // Bump PS_ST_SITE_OK.
        mov rdi, 3;                      // PS_ST_SITE_OK
        call _ps_note;

        xor rax, rax;                    // PS_OK
        jmp ps_ds_out;

      ps_ds_bad_site:
        mov rdi, 4;                      // PS_ST_SITE_BAD
        call _ps_note;
        mov rax, 0x1300;                 // PS_ERR_NO_SITES

      ps_ds_out:
        add rsp, 128;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _perf_sink_dump_all() -> u64
  //
  // Iterate [0, _mb_site_count()) and call _perf_sink_dump_site for
  // each. Emits a final `PERF SINK DUMP OK sites=0x<N>` summary line
  // via klog_s1_x1. Returns PS_OK on success, PS_ERR_NO_SITES when
  // the registry is empty (no _mb_init call, or _mb_init registered
  // zero sites -- neither case is reachable in a healthy boot).
  //
  // Register plan: two callee-save pushes (rbx=i, r12=site_count) +
  // sub rsp,8 land rsp%16==0 at every nested call (entry rsp%16==8;
  // +16 -> rsp%16==8; +8 -> rsp%16==0).
  // ==========================================================================
  pub let _perf_sink_dump_all : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W13 R141.M2 (#2646): iterate every registered microbench site and emit one `PERF SITE` klog line per site via _perf_sink_dump_site, then emit a `PERF SINK DUMP OK sites=0x<N>` summary via klog_s1_x1. Empty-registry gate returns PS_ERR_NO_SITES=0x1300 and bumps PS_ST_DUMP_NO_SITES. Loop variable i (rbx), total count (r12). Two callee-save pushes + sub rsp,8 land rsp%16==0 at every nested call. Labels prefixed ps_da_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // Fetch site count.
        call _mb_site_count;
        cmp rax, 0;
        je ps_da_no_sites;

        mov r12, rax;                    // r12 = site_count
        xor rbx, rbx;                    // rbx = i = 0

      ps_da_loop:
        cmp rbx, r12;
        jae ps_da_done;
        mov rdi, rbx;
        call _perf_sink_dump_site;
        add rbx, 1;
        jmp ps_da_loop;

      ps_da_done:
        // Summary `PERF SINK DUMP OK sites=0x<16-hex>` via klog_s1_x1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + ps_tag_dump];
        lea rcx, [rip + ps_k_sites];
        mov r8, r12;                     // site_count
        call klog_s1_x1;

        // Bump PS_ST_DUMP_OK.
        mov rdi, 1;                      // PS_ST_DUMP_OK
        call _ps_note;

        xor rax, rax;                    // PS_OK
        jmp ps_da_out;

      ps_da_no_sites:
        mov rdi, 2;                      // PS_ST_DUMP_NO_SITES
        call _ps_note;
        mov rax, 0x1300;                 // PS_ERR_NO_SITES

      ps_da_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
