// src/kernel/core/policy/battery_monitor.pdx — R31.M3-003 (#1101)
//
// The kernel-side scaffold of battery_monitor: a per-row cache of the
// previous {percent, state} sample, a per-row pending-flag word, and one
// entry-point (`battery_monitor_tick`) that installs a report and sets
// the pending flags a subscriber would later dispatch.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is a DELTA DETECTOR over KIND_BATTERY rows, and NOT a supervisor
// server. Same discipline as thermal_policy.pdx §0: no fan here, no
// shutdown path here, NO IPC SEND here, and NO CALL that talks to a
// subscriber over an endpoint. `design/ipc/battery-channel-schema.md`
// §7 records that a cross-process endpoint is deferred, and this module
// exists so that when the endpoint arrives its dispatcher reads a
// pending-flag word rather than re-deriving the transitions from a
// history nobody kept.
//
// The name matches `design/roadmap/next-wave-softarch.md` §5
// (R31.M3 — `battery_monitor` server) and the module is what the
// eventual userspace server invokes when it wakes on an _BST
// notification. It is NOT the server: no notification-subscription
// primitive is called here, and the tick function is invoked
// synchronously by the boot witness for the same reason
// `thermal_policy_intent_of_slot` is — the pure computation is
// testable at boot, so the transitions are witnessed before any
// consumer arrives.
//
// The AML `_BST` reader (#1097 pattern) is not yet present for the
// battery path. Rather than block this milestone on it, tick takes
// {percent, mv, state} as parameters — the same shape
// `battery_report_install` does — and the witness drives it directly.
// When the AML reader lands, it becomes the caller and this file does
// not change.
//
// =============================================================================
// §1  WHY DELTA DETECTION IS A KERNEL FUNCTION AND NOT A SUBSCRIBER'S
// =============================================================================
//
// A subscriber that computed "did the state change since the last
// event" from its own memory would be a subscriber whose account of the
// pack's history depends on its uptime. Restart the subscriber, and
// every state transition since the pack was minted looks like a fresh
// STATE_CHANGED. Bind two subscribers, and they get two histories that
// agree only until one of them misses an event.
//
// The delta is a property of the ROW, and the row is a kernel object
// (`kind_battery.pdx` §1), so the previous-sample cache lives beside
// it: `_battery_monitor_prev`. One writer -- `battery_monitor_tick` --
// and the same allocator confinement `_battery_table` has in
// `kind_battery.pdx`. A second writer of the prev cache would be a
// second decision about what the last sample was, and the two would
// disagree by exactly one transition every time a subscriber wanted
// them to agree.
//
// The pending-flag word (`_battery_monitor_flags`) is the same
// argument at one remove: it says WHICH transitions have been observed
// but not yet dispatched. A subscriber acks a flag it has dispatched
// (`battery_monitor_ack`); nothing else clears it. A dispatcher that
// re-derived which flags to raise from the current sample would raise
// STATE_CHANGED whenever the state was different from what it was
// asked ABOUT LAST, which is not the same question.
//
// =============================================================================
// §2  THE THRESHOLD IS INSTALLED, NOT COMPILED IN
// =============================================================================
//
// Same shape as `thermal_policy.pdx` §2. The low-warning threshold is
// a POLICY -- on a laptop the operator has three power profiles and
// the threshold is different in each -- and a compiled-in threshold is
// the kernel choosing one for them. So the module holds
// `_battery_monitor_threshold`, zero-initialised so
// `battery_monitor_table_reset` fills the default
// (`BATTERY_MONITOR_LOW_PCT_DEFAULT` = 5) at boot and every install
// after that goes through `battery_monitor_threshold_install`.
//
// MONOTONICITY, mirroring the ec_event and thermal_policy maps: once
// the threshold acquires a non-zero value, installing the SAME value
// is idempotent OK, and installing a DIFFERENT value is refused
// (BATTERY_MONITOR_THRESHOLD_ALREADY). A threshold that could be
// silently raised at runtime would let a supervisor claim "I never
// heard about low battery" for a pack that spent an hour past the
// previous limit, and a threshold that could be lowered would let a
// hostile process suppress the warning by moving the line under a
// perpetually-charging pack.
//
// Total re-tuning is `battery_monitor_table_reset` followed by one
// install. A per-cell change API is deliberately absent for the same
// reason `thermal_policy_map_install` has none: the wholesale reset
// is the reviewable operation, and a per-cell mutator is a way to
// change the threshold without the transition being visible to any
// reader of the module's log.
//
// =============================================================================
// §3  HYSTERESIS ON THE LOW WARNING, NONE ON THE STATE
// =============================================================================
//
// A pack sitting at the threshold with 1% ripple would emit one
// LOW_WARNING per sample if the crossing were re-evaluated every
// tick. So the module maintains a per-row LATCH bit: once
// LOW_WARNING is set, it does not re-arm until the percent has
// climbed above `threshold + BATTERY_MONITOR_LOW_HYST_PCT` (3, so 8
// re-arms 5). The latch bit is INTERNAL and does not appear in the
// dispatched flags a subscriber reads.
//
// STATE_CHANGED does NOT have hysteresis and does NOT latch. Two
// samples at different state ordinals are a transition, and a
// transition dropped is a subscriber's model of the pack drifting
// silently. A brief blip from DISCHARGING to CHARGING to DISCHARGING
// is three events and every one of them is real.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO
// =============================================================================
//
// Stated plainly:
//
//   * NOTHING PULLS A LIVE READING. tick is called with a sample; no
//     AML _BST reader binds it yet (#1097 for _TMP is the sibling
//     pattern the battery counterpart would follow).
//   * NOTHING DISPATCHES AN EVENT. The pending-flag word is set by
//     tick and cleared by ack; the wire dispatch is a
//     KIND_IPC_ENDPOINT operation and no endpoint is bound to this
//     schema yet.
//   * NOTHING TUNES THE THRESHOLD FROM RING 3. The install call is a
//     kernel function today; the syscall shim that exposes it will
//     arrive with the userspace server and be gated by a capability
//     rather than by the boot authority the kernel witness uses.
//   * NOTHING SHUTS THE MACHINE DOWN. A CRITICAL state is stored, a
//     LOW_WARNING is set; kind_battery §4 records that no platform
//     shutdown path exists in this kernel at all.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFE60..0xFFFFFE6F
// =============================================================================
//
// Disjoint from every other in-tree band: KIND_BATTERY 40..4F,
// BatteryChannel 50..5F, KIND_THERMAL_ZONE 30..3F, thermal_policy
// 20..2A, owner 2B..2F. 0xFFFFFE60..6F was free.
//
// =============================================================================

module BatteryMonitor = structure {

  // ==========================================================================
  // Sizing. One row per battery, and BATTERY_MAX is 8 (kind_battery §5).
  // ==========================================================================

  pub let BATTERY_MONITOR_MAX : u64 = 8

  // ==========================================================================
  // The default low-warning threshold and its hysteresis.
  //
  // Default 5% because that is the point below which a hard shutdown
  // becomes an event the operator wants to be told about before it
  // happens, on a T14 G4 pack whose typical DISCHARGING-to-empty
  // window at that percent is 8 to 12 minutes. The hysteresis is
  // ADDITIVE (threshold + HYST) so it does not depend on how low the
  // threshold is set: 5 re-arms at 8, 15 re-arms at 18.
  // ==========================================================================

  pub let BATTERY_MONITOR_LOW_PCT_DEFAULT : u64 = 5
  pub let BATTERY_MONITOR_LOW_HYST_PCT    : u64 = 3

  // ==========================================================================
  // §5's failure taxonomy -- 0xFFFFFE60..0xFFFFFE6F.
  // ==========================================================================

  pub let BATTERY_MONITOR_OK                : u64 = 0
  pub let BATTERY_MONITOR_BAD_ROW           : u64 = 0xFFFFFE6F
  pub let BATTERY_MONITOR_BAD_PERCENT       : u64 = 0xFFFFFE6E
  pub let BATTERY_MONITOR_BAD_STATE         : u64 = 0xFFFFFE6D
  pub let BATTERY_MONITOR_BAD_THRESHOLD     : u64 = 0xFFFFFE6C
  pub let BATTERY_MONITOR_THRESHOLD_ALREADY : u64 = 0xFFFFFE6B
  pub let BATTERY_MONITOR_BAD_ACK           : u64 = 0xFFFFFE6A

  // Positional sentinel for a row that does not exist or has no prior
  // sample.
  pub let BATTERY_MONITOR_UNSEEN : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // The pending-flag bits. Bits 0..15 are the DISPATCHABLE flags a
  // subscriber sees; bits 16..31 are INTERNAL housekeeping. A future
  // dispatcher masks with BATTERY_MONITOR_FLAGS_DISPATCHABLE before
  // handing the word out; ack refuses any bit outside that mask.
  // ==========================================================================

  pub let BATTERY_MONITOR_F_STATE_CHANGED : u64 = 0x0001
  pub let BATTERY_MONITOR_F_LOW_WARNING   : u64 = 0x0002

  // Internal: the LOW warning has fired for this pack and has not yet
  // re-armed. Not returned by battery_monitor_flags, not cleared by ack.
  pub let BATTERY_MONITOR_F_LOW_LATCHED   : u64 = 0x10000

  pub let BATTERY_MONITOR_FLAGS_DISPATCHABLE : u64 = 0x0003
  pub let BATTERY_MONITOR_FLAGS_ALL          : u64 = 0x10003

  // ==========================================================================
  // Prev-sample word layout, one per row.
  //   [7:0]   prev_pct
  //   [15:8]  prev_state
  //   [16]    seen (0 = never sampled since reset)
  //   [63:17] reserved (zero)
  // Kept as one word so a tick's read-then-write is one load and one
  // store, and every subsequent computation switches on already-loaded
  // registers.
  // ==========================================================================

  pub let BATTERY_MONITOR_PREV_SEEN_BIT : u64 = 0x10000

  // ==========================================================================
  // Storage.
  //
  // Two 8-slot arrays and one scalar. tools/build.sh confines all three
  // to core/policy/battery_monitor.o. The confinement matters most for
  // the threshold: a second writer could raise or lower it with no
  // capability involved, which is exactly the mutation §2 refuses.
  // ==========================================================================

  pub let mut _battery_monitor_prev      : [u64; 8] = uninit @align(64)
  pub let mut _battery_monitor_flags     : [u64; 8] = uninit @align(64)
  pub let mut _battery_monitor_threshold : u64 = 0

  // ==========================================================================
  // battery_monitor_table_reset() -> ()
  //
  // Clear every row's prev-sample and pending flags, and install the
  // default threshold. Boot and teardown only. Not a violation of §2's
  // monotonicity: what monotonicity forbids is a threshold acquiring a
  // second value while the monitor is in service, and this runs when
  // no consumer can be reading. Labels prefixed bm_rs_.
  // ==========================================================================

  pub let battery_monitor_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): return every prev-sample and every pending-flag word to zero, then install BATTERY_MONITOR_LOW_PCT_DEFAULT as the threshold. Called by the witness on entry and on both exits; a fixture whose failure path left a threshold or a latched LOW would make every later witness observe state some earlier one wrote. Immediate bounds (8 iterations, not sizeof/8) for the reason thermal_policy_map_reset uses them: an immediate refuses to build under a table resize, a computed bound silently sweeps whatever the new size is. Two separate store loops rather than one over the sum, mirroring battery_table_reset: the two arrays have different meanings and one loop over their total would encode their adjacency in .bss as a fact code depends on. Leaf. Labels prefixed bm_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _battery_monitor_prev];
        xor rax, rax;
        xor rcx, rcx;
      bm_rs_prev:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bm_rs_prev;

        lea r10, [rip + _battery_monitor_flags];
        xor rcx, rcx;
      bm_rs_flags:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bm_rs_flags;

        // Install the default.
        mov rax, 5;                      // BATTERY_MONITOR_LOW_PCT_DEFAULT
        lea r10, [rip + _battery_monitor_threshold];
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_threshold_install(pct) -> BATTERY_MONITOR_OK
  //                                         | BATTERY_MONITOR_BAD_THRESHOLD
  //                                         | BATTERY_MONITOR_THRESHOLD_ALREADY
  //
  // §2's install. pct in [0, 100] and monotone: same-as-current is
  // idempotent OK, different is refused. Zero is a legitimate
  // threshold (never fire LOW_WARNING) and is admitted; the .bss
  // sentinel that would collide with it is not zero but the
  // "threshold has never been touched" case that only exists before
  // battery_monitor_table_reset -- which installs the default -- has
  // run.
  // ==========================================================================

  pub let battery_monitor_threshold_install : (u64) -> u64 !{mem} @{} =
    fn (pct: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): install the low-warning threshold. Gate (1): pct > BATTERY_PCT_MAX (100) -> BAD_THRESHOLD; refused rather than clamped for the reason battery_percent_valid refuses out-of-range percents -- a threshold of 200 that silently became 100 would fire LOW_WARNING on every sample of a full pack, which is the class of never-fires bug ec_event's §3 warns about at length. Gate (2): monotonicity. Read the current threshold; equal to pct -> return OK without store (idempotent); different -> THRESHOLD_ALREADY. The stored zero after a fresh reset is treated the same as any other current value: a caller that resets and then reinstalls is a caller taking the reset-then-install shape §2 mandates. Read-modify-write on one scalar; no SMP window is problematic because there is exactly one caller (the eventual thermal-policy-shim analogue) and it holds the boot authority. Leaf, no nested calls. Labels prefixed bm_ti_ per reserved-label discipline.",
      block: {
        mov r10, 100;                    // BATTERY_PCT_MAX
        cmp rdi, r10;
        ja  bm_ti_bad;

        lea r10, [rip + _battery_monitor_threshold];
        mov rax, [r10 + 0];
        cmp rax, rdi;
        je  bm_ti_same;

        // Non-zero current, different value -> refuse.
        // (A zero current is the pre-reset state; the reset installer
        //  is the only legitimate way to get here from zero.)
        cmp rax, 0;
        jne bm_ti_already;
        mov [r10 + 0], rdi;
        xor rax, rax;
        ret;

      bm_ti_same:
        xor rax, rax;
        ret;

      bm_ti_bad:
        mov rax, 0xFFFFFE6C;             // BATTERY_MONITOR_BAD_THRESHOLD
        ret;
      bm_ti_already:
        mov rax, 0xFFFFFE6B;             // BATTERY_MONITOR_THRESHOLD_ALREADY
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_threshold() -> u64
  //
  // Read the current low-warning threshold. Not gated on any right:
  // the threshold is diagnostic and no future reader will hold a
  // right this file mints. Leaf.
  // ==========================================================================

  pub let battery_monitor_threshold : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): read the installed low-warning threshold. rip-relative lea then one qword load. Named accessor rather than a load at the call site so a future field addition (a hysteresis mutator, an over-threshold cell for FULL warnings) cannot silently change what a caller reads. Leaf, no nested calls. Labels prefixed bm_th_ per reserved-label discipline.",
      block: {
        lea rax, [rip + _battery_monitor_threshold];
        mov rax, [rax + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_row_valid(row) -> 1 | 0
  //
  // Bounds check. Every accessor gates on this so an out-of-range row
  // does not read the wrong array element or write past _flags.
  // ==========================================================================

  pub let battery_monitor_row_valid : (u64) -> u64 !{} @{} =
    fn (row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-003 (#1101): 1 iff row < BATTERY_MONITOR_MAX (8). Ordering: bound is an immediate 8 rather than a symbol so it fails to build under a resize the two arrays would then diverge across; battery_table_reset uses the same discipline for the same reason. Pure leaf. Labels prefixed bm_rv_.",
      block: {
        cmp rdi, 8;                      // BATTERY_MONITOR_MAX
        jae bm_rv_no;
        mov rax, 1;
        ret;
      bm_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_prev(row) -> word | BATTERY_MONITOR_UNSEEN
  //
  // Raw prev-sample word. BATTERY_MONITOR_UNSEEN for an out-of-range
  // row. A caller distinguishes "row exists but never sampled" from
  // "unseen" by checking the seen bit inside the returned word (bit
  // 16); the sentinel is for out-of-range rows only.
  // ==========================================================================

  pub let battery_monitor_prev : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): raw prev-sample word of a row, or BATTERY_MONITOR_UNSEEN for an out-of-range row. Diagnostic and witness-facing; every internal reader in this module loads the array element directly so this function's arity has no impact on the tick's inner loop. Leaf, no nested calls. Labels prefixed bm_pr_.",
      block: {
        cmp rdi, 8;                      // BATTERY_MONITOR_MAX
        jae bm_pr_no;
        lea r10, [rip + _battery_monitor_prev];
        mov rax, [r10 + rdi * 8];
        ret;
      bm_pr_no:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_flags(row) -> flags | BATTERY_MONITOR_UNSEEN
  //
  // The DISPATCHABLE flags (F_STATE_CHANGED | F_LOW_WARNING); the
  // internal LOW_LATCHED bit is masked off. This is what a dispatcher
  // hands to a subscriber; the subscriber calls ack after dispatch.
  // ==========================================================================

  pub let battery_monitor_flags : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): dispatchable pending flags of a row, or BATTERY_MONITOR_UNSEEN. Load and mask with BATTERY_MONITOR_FLAGS_DISPATCHABLE (0x03). Masking rather than returning the raw word is what keeps LOW_LATCHED (bit 16) out of a subscriber's decision -- a subscriber that saw the latch would clear it via ack (§next), and the re-arming discipline of §3 would collapse into 'the latch re-fires on the first sample after the ack', which is one LOW_WARNING per ack rather than one per crossing. Leaf. Labels prefixed bm_fl_.",
      block: {
        cmp rdi, 8;                      // BATTERY_MONITOR_MAX
        jae bm_fl_no;
        lea r10, [rip + _battery_monitor_flags];
        mov rax, [r10 + rdi * 8];
        mov r10, 3;                      // BATTERY_MONITOR_FLAGS_DISPATCHABLE
        and rax, r10;
        ret;
      bm_fl_no:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_flags_raw(row) -> word | BATTERY_MONITOR_UNSEEN
  //
  // Diagnostic accessor: returns the whole flag word, including
  // LOW_LATCHED. Not for a dispatcher's use; the witness reads it to
  // assert that the internal latch bit is set/cleared correctly across
  // the crossing/recovery.
  // ==========================================================================

  pub let battery_monitor_flags_raw : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): raw flag word, including LOW_LATCHED. Diagnostic; a dispatcher must call battery_monitor_flags instead. Its existence is what makes the latch's presence testable at all -- an internal bit no reader can observe is an internal bit whose behaviour depends on hope. Leaf. Labels prefixed bm_fr_.",
      block: {
        cmp rdi, 8;
        jae bm_fr_no;
        lea r10, [rip + _battery_monitor_flags];
        mov rax, [r10 + rdi * 8];
        ret;
      bm_fr_no:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_ack(row, mask) -> BATTERY_MONITOR_OK | BAD_ROW | BAD_ACK
  //
  // Clear the dispatchable bits in `mask` from `row`'s flag word.
  // Refuses any mask bit outside FLAGS_DISPATCHABLE: an ack that
  // could clear LOW_LATCHED would let a subscriber re-arm the low
  // warning without the pack ever recovering, and a subscriber that
  // could clear reserved bits could hand-forge a flag word.
  // ==========================================================================

  pub let battery_monitor_ack : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): clear dispatchable pending bits. Gate (1): row < BATTERY_MONITOR_MAX -> BAD_ROW. Gate (2): mask & ~FLAGS_DISPATCHABLE != 0 -> BAD_ACK; refused not masked because a caller that supplied a wide mask should not silently get a narrow ack -- the confusion would be a dispatcher that thought it cleared LOW_LATCHED and re-fires LOW_WARNING on the next tick, which is one warning per tick under a hostile subscriber. Clear: flags = flags & ~mask. Load, and-not, store. Read-modify-write on one word, no SMP concern here for the same reason threshold_install has none. Leaf. Labels prefixed bm_ak_.",
      block: {
        cmp rdi, 8;                      // BATTERY_MONITOR_MAX
        jae bm_ak_bad_row;

        // mask outside dispatchable set -> BAD_ACK.
        mov rax, rsi;
        mov r10, 3;                      // FLAGS_DISPATCHABLE (~mask below is the inverse)
        not r10;                         // ~FLAGS_DISPATCHABLE
        and rax, r10;
        cmp rax, 0;
        jne bm_ak_bad_ack;

        lea r10, [rip + _battery_monitor_flags];
        mov rax, [r10 + rdi * 8];
        mov r11, rsi;
        not r11;
        and rax, r11;                    // clear the ack'd bits
        mov [r10 + rdi * 8], rax;
        xor rax, rax;                    // BATTERY_MONITOR_OK
        ret;

      bm_ak_bad_row:
        mov rax, 0xFFFFFE6F;
        ret;
      bm_ak_bad_ack:
        mov rax, 0xFFFFFE6A;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_seen(row) -> 1 | 0
  //
  // 1 iff the row has been sampled at least once since the last reset.
  // Distinguishes "battery capability exists but nothing has ticked
  // yet" from "row has been sampled", which is what the tick uses to
  // decide whether it can compute a delta at all.
  // ==========================================================================

  pub let battery_monitor_seen : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-003 (#1101): 1 iff the row has been sampled at least once since reset. Bit 16 (BATTERY_MONITOR_PREV_SEEN_BIT) of the prev-sample word. Returns 0 for an out-of-range row rather than a sentinel because the caller (the tick's first-sample check) branches on 0/1 and a sentinel would be a third case for a two-case decision. Leaf. Labels prefixed bm_se_.",
      block: {
        cmp rdi, 8;
        jae bm_se_no;
        lea r10, [rip + _battery_monitor_prev];
        mov rax, [r10 + rdi * 8];
        shr rax, 16;
        and rax, 1;
        ret;
      bm_se_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_monitor_tick(slot, percent, mv, state) -> u64
  //
  // The one entry point. Steps, in order:
  //
  //   (1) Resolve the slot to a row via battery_row_of_slot. A slot
  //       that names no live KIND_BATTERY answers BATTERY_ROW_NONE
  //       (0xFF) -> return BATTERY_MONITOR_BAD_ROW.
  //   (2) Call battery_report_install(slot, percent, mv, state) to
  //       push the sample. If it refuses (implausible field),
  //       propagate its code verbatim; the sample is not cached in
  //       the prev word and no flags move -- an implausible report
  //       is a fact about the sensor, not about the pack's state.
  //   (3) Load the row's prev-sample word. If seen bit is 0, this is
  //       the FIRST sample: set the prev word to (pct, state, seen=1)
  //       and return OK with no flags -- there is nothing to compare
  //       against.
  //   (4) Compare the new state ordinal to the prev's. If different,
  //       set F_STATE_CHANGED.
  //   (5) The LOW crossing:
  //         if not LOW_LATCHED and pct <= threshold:
  //           set F_LOW_WARNING and LOW_LATCHED.
  //         if LOW_LATCHED and pct > threshold + HYST:
  //           clear LOW_LATCHED (no flag change; re-arms the crossing).
  //   (6) Store the new prev-sample word.
  //
  // ARITY FOUR, PINNED. A fifth parameter would be a caller-supplied
  // threshold, and a per-tick threshold defeats the monotonicity of
  // §2 in one call site.
  //
  // ROW GATES ON `battery_row_of_slot`, WHICH GATES ON THE CAPABILITY.
  // The tick is called with a slot the caller must already possess
  // (a battery cap held by the monitor server); the monitor's own
  // authority to hold that cap is what upstream capability system
  // decisions have already authorised.
  // ==========================================================================

  pub let battery_monitor_tick : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (percent: u64) (mv: u64) (state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-003 (#1101): install one battery sample and update the delta-detector. SIX PUSHES (rbx, r12, r13, r14, r15, rbp) for the callee-save registers held across the nested calls (battery_row_of_slot, battery_report_install). Entry rsp%16 == 8, six pushes -> 0, satisfying SysV at both call sites. rbx = row_id, r12 = percent, r13 = mv, r14 = state, r15 = slot, rbp = flag scratch. Step (1): resolve slot -> row via battery_row_of_slot; 0xFF -> BAD_ROW. Step (2): call battery_report_install(slot, percent, mv, state); non-zero -> propagate. THIS IS THE POINT AT WHICH AN IMPLAUSIBLE REPORT IS REJECTED, and returning its code verbatim is what lets a caller distinguish 'the sensor lied' from 'the delta detector could not run' -- the two need different responses. Step (3): first-sample check via SEEN bit; if clear, install seen=1 with prev fields and return OK, no flags. Otherwise: Step (4) state delta -- prev_state = (prev>>8) & 0xFF; if state != prev_state, or F_STATE_CHANGED into the flag word. Step (5) LOW crossing -- load flags, check LOW_LATCHED. Unlatched and pct <= threshold: or F_LOW_WARNING | F_LOW_LATCHED. Latched and pct > threshold + HYST: clear F_LOW_LATCHED (leaves any pending F_LOW_WARNING alone; ack is what clears the dispatchable bit). Note the HYST comparison uses '>', not '>=': a percent at exactly threshold+HYST is NOT yet enough to re-arm, which is the class of borderline-flap bug §3 refuses in one direction. Step (6): rebuild prev word as (pct | (state<<8) | SEEN_BIT) and store. Written as one straight-line block with three branches that all fall into the same store-and-return -- no nested loops. Labels prefixed bm_tk_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;                        // 6 pushes -> rsp%16 = 0

        mov r15, rdi;                    // slot
        mov r12, rsi;                    // percent
        mov r13, rdx;                    // mv
        mov r14, rcx;                    // state

        // (1) resolve slot -> row.
        mov rdi, r15;
        call battery_row_of_slot;
        mov r10, 0xFF;                   // BATTERY_ROW_NONE
        cmp rax, r10;
        je  bm_tk_bad_row;
        mov rbx, rax;                    // row_id

        // (2) install the sample.
        mov rdi, r15;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call battery_report_install;
        cmp rax, 0;                      // BATTERY_OK
        jne bm_tk_out;                   // rax holds refusal; teardown and return

        // (3) first-sample check.
        lea r10, [rip + _battery_monitor_prev];
        mov rax, [r10 + rbx * 8];        // prev word
        mov r11, rax;
        shr r11, 16;
        and r11, 1;                      // seen bit
        cmp r11, 0;
        je  bm_tk_first;

        // (4) state delta.
        lea r10, [rip + _battery_monitor_flags];
        mov rbp, [r10 + rbx * 8];        // current flags

        mov r11, rax;                    // prev word again
        shr r11, 8;
        and r11, 0xFF;                   // prev_state
        cmp r14, r11;
        je  bm_tk_no_state_delta;
        or  rbp, 1;                      // F_STATE_CHANGED

      bm_tk_no_state_delta:
        // (5) LOW crossing.
        // LOW_LATCHED bit is bit 16 of flags.
        mov r11, rbp;
        shr r11, 16;
        and r11, 1;                      // latched?
        cmp r11, 0;
        jne bm_tk_latched;

        // Unlatched: fire if pct <= threshold.
        lea r10, [rip + _battery_monitor_threshold];
        mov r10, [r10 + 0];
        cmp r12, r10;
        ja  bm_tk_low_done;              // still above
        or  rbp, 2;                      // F_LOW_WARNING
        mov r11, 1;
        shl r11, 16;
        or  rbp, r11;                    // F_LOW_LATCHED
        jmp bm_tk_low_done;

      bm_tk_latched:
        // Latched: re-arm if pct > threshold + HYST.
        lea r10, [rip + _battery_monitor_threshold];
        mov r10, [r10 + 0];
        add r10, 3;                      // BATTERY_MONITOR_LOW_HYST_PCT
        cmp r12, r10;
        jbe bm_tk_low_done;              // not yet above threshold+HYST
        // Clear the LATCH bit only; leave any pending F_LOW_WARNING alone.
        mov r11, 1;
        shl r11, 16;
        not r11;
        and rbp, r11;

      bm_tk_low_done:
        // Store flags back.
        lea r10, [rip + _battery_monitor_flags];
        mov [r10 + rbx * 8], rbp;

        // (6) store new prev word.
        mov rax, r12;                    // pct
        mov r10, r14;
        shl r10, 8;
        or  rax, r10;                    // state<<8
        mov r10, 1;
        shl r10, 16;
        or  rax, r10;                    // SEEN
        lea r10, [rip + _battery_monitor_prev];
        mov [r10 + rbx * 8], rax;

        xor rax, rax;                    // BATTERY_MONITOR_OK
        jmp bm_tk_out;

      bm_tk_first:
        // First sample: prev = (pct | (state<<8) | SEEN), no flags.
        mov rax, r12;
        mov r10, r14;
        shl r10, 8;
        or  rax, r10;
        mov r10, 1;
        shl r10, 16;
        or  rax, r10;
        lea r10, [rip + _battery_monitor_prev];
        mov [r10 + rbx * 8], rax;
        xor rax, rax;
        jmp bm_tk_out;

      bm_tk_bad_row:
        mov rax, 0xFFFFFE6F;             // BATTERY_MONITOR_BAD_ROW

      bm_tk_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
