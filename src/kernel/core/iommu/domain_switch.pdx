// src/kernel/core/iommu/domain_switch.pdx — R29.M5-004 (#1039)
//
// The IOMMU domain-switching contract between a userspace driver and the
// kernel: the only path by which a KIND_DMA_DOMAIN capability becomes an
// IOMMU context entry attributed to a specific PCI function.
//
// =====================================================================
// 1. Why the kernel owns this at all
// =====================================================================
//
// design/roadmap/next-wave-softarch.md §3 R29 draws exactly one line
// through the driver framework: "Kernel owns only: IDT install, LAPIC
// EOI, IPI delivery, KIND_INTERRUPT mint, IOMMU domain switching."
// Everything else about a driver — probe, ring management, firmware
// upload, MMIO — is userspace.
//
// Context-entry programming is on the kernel side of that line because a
// context entry is the *only* structure in the machine that decides
// which physical pages a bus-mastering device may reach. A driver that
// could write its own context entry could point it at a page table it
// controls, which is not "a driver with a DMA capability" — it is a
// driver with unmediated physical memory access, i.e. the exact thing
// the IOMMU exists to prevent. Handing a driver an MMIO window onto the
// context table would make the KIND_DMA_DOMAIN capability decorative.
//
// So the contract is: the driver *requests*, the kernel *validates and
// programs*. The driver never sees a context-table address.
//
// =====================================================================
// 2. The contract
// =====================================================================
//
// What a driver may request
// -------------------------
//   iommu_domain_switch(cap_slot, row_id, bus_dev_fn)
//       "Make the domain I hold the owner of the IOMMU context entry
//        for this PCI function."
//   iommu_domain_unswitch(cap_slot, row_id)
//       "Release the context entry my domain currently owns."
//
// The driver names its domain by the cap_table slot it holds plus the
// row id that slot's descriptor points at. Passing both is deliberate
// redundancy: the kernel checks they agree, so a driver that guesses a
// row id it does not hold a capability for is refused at the first gate
// rather than at whatever gate happens to notice later.
//
// What the kernel validates (in this order; each failure a distinct code)
// ---------------------------------------------------------------------
//   1. ARGUMENT WELL-FORMEDNESS   row_id < DMA_DOMAIN_MAX, bdf < 2^16
//                                 -> IOMMU_SW_ERR_BAD_ARG
//   2. HOLDER                     cap_table[cap_slot].kind ==
//                                 KIND_DMA_DOMAIN, and its target_ptr
//                                 row id == the row_id argument
//                                 -> IOMMU_SW_ERR_NOT_HELD
//   3. AUTHORITY                  the capability carries RIGHT_MINT
//                                 -> IOMMU_SW_ERR_NO_RIGHT
//   4. LIVENESS                   the row is in_use
//                                 -> IOMMU_SW_ERR_DEAD_ROW
//   5. QUIESCENCE                 the row is not mid-switch
//                                 -> IOMMU_SW_ERR_IN_TRANSITION
//   6. BINDING                    bdf ∈ the domain's (base, mask)
//                                 binding
//                                 -> IOMMU_SW_ERR_BDF_UNBOUND
//   7. EXCLUSIVITY                no *other* live domain currently owns
//                                 the context entry for this bdf
//                                 -> IOMMU_SW_ERR_CTX_OWNED
//
// Why RIGHT_MINT and not RIGHT_INVOKE (gate 3): switching a domain onto
// a function widens what that function can reach from nothing to the
// domain's whole mapped set. That is the same authority class as OP_MAP
// (see kind_dma_domain.pdx §Rights discipline), and grouping it with the
// read-only query ops would let a monitor holding only INVOKE re-point
// production hardware.
//
// Why exclusivity is a kernel check and not a driver convention (gate 7):
// VT-d has exactly one context entry per (bus, devfn). Two domains
// believing they own the same entry is not a race the last writer wins —
// it is one driver silently acquiring the other's memory reach. The scan
// is O(DMA_DOMAIN_MAX) = O(32), which is nothing on a path taken once
// per device arrival.
//
// What the kernel refuses to do at all
// ------------------------------------
//   * Program a context entry for a BDF outside the domain's binding,
//     even if that BDF is unowned. The binding is the supervisor's
//     statement of what the driver process owns; an unowned entry is not
//     an invitation.
//   * Steal a context entry from another live domain. There is no
//     "force" flag. The supervisor revokes the other domain first —
//     which is an auditable act — or the request stays refused.
//   * Act on a row that is mid-switch. See §3.
//
// =====================================================================
// 3. The context-entry state machine (row [+24], reserved by #1036)
// =====================================================================
//
//   NONE ──switch──▶ PENDING ──commit──▶ PROGRAMMED
//                       │                    │
//                       └◀──── restore ──────┤ (hardware refused)
//                                            │
//   PROGRAMMED ──switch(other bdf)──▶ PENDING ──▶ PROGRAMMED
//   PROGRAMMED ──unswitch──▶ PENDING ──▶ NONE
//
// PENDING is never a resting state. Every path that writes it either
// completes to PROGRAMMED/NONE or restores the exact prior word — the
// snapshot/restore is why kind_dma_domain.pdx exposes dma_ctx_read /
// dma_ctx_write over the whole word rather than per-field setters.
//
// A request against a PENDING row is refused rather than queued. At the
// R29 substrate stage the kernel is single-flow and non-preemptible, so
// PENDING is observable only if a fault unwound the middle of a switch;
// refusing is the correct response to "the previous switch did not
// finish" in a way that queuing would paper over.
//
// =====================================================================
// 4. Real VT-d programming — what landed and what is gated
// =====================================================================
//
// THE SOFTWARE CONTRACT IS REAL AND COMPLETE. Validation, the state
// machine, ownership accounting, and teardown all execute unconditionally
// and are exercised by the boot witness.
//
// THE HARDWARE WRITE IS WIRED BUT DORMANT. iommu_ctx_commit_hw calls the
// real R22 primitive `vtd_context_program` (src/kernel/core/iommu/
// vtd_ctx.pdx), and iommu_ctx_uncommit_hw clears the entry's two qwords
// directly. Neither runs today, because R22 left its tables unwired:
//
//   * Features.IOMMU_ENABLED is 0 (src/kernel/core/config/features.pdx
//     §IOMMU_ENABLED) — VT-d translation is not enabled at boot.
//   * vtd_root_init's own justification records "NOT WIRED AT M4 BOOT —
//     kernel_main never calls this", so _vtd_root_va is 0.
//   * vtd_context_program needs a per-bus context-table page and an SLPT
//     root PA. Neither is allocated anywhere in the tree yet; both are
//     R22.M5's deliverable.
//
// Rather than fake any of that, this module takes the three missing
// values as an explicit registration: R22.M5's enable path calls
// `iommu_hw_backing_set(bus, ctx_table_va, slpt_root_pa)` once it has
// allocated them (and only when Features.IOMMU_ENABLED is 1), which sets
// _iommu_hw_ready. Until that call happens, iommu_ctx_commit_hw returns
// IOMMU_HW_GATED and the switch completes as a SOFTWARE-ONLY ownership
// record: the domain owns the context entry in the kernel's accounting,
// the row's hw_committed bit stays 0, and no hardware was touched.
//
// That distinction is recorded per-row rather than inferred, because a
// teardown must know whether there is a hardware entry to clear. A
// domain torn down with hw_committed = 0 skips the hardware path; one
// with hw_committed = 1 clears the entry before releasing the row.
//
// This is a gate, not a stub: the code path from iommu_domain_switch to
// vtd_context_program is complete and typed, and flipping it on is one
// call from R22.M5 rather than a body someone has to write.
//
// =====================================================================
// 5. Return-code block
// =====================================================================
//
// 0xFFFFFFC6..0xFFFFFFCF — disjoint from DMA_* (0xFFFFFFD1..0xFFFFFFDF),
// MSIX_* (0xFFFFFFE7..0xFFFFFFEF), HW_INT_* (0xFFFFFFF7..0xFFFFFFFF) and
// the DRIVER_* blocks (0xFFFFFE.. / 0xFFFFFF0..), so a mixed failure
// trace names its originating module unambiguously.

module DomainSwitch = structure {

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success family. Three distinct non-error values, because the caller
  // legitimately needs to tell them apart: OK means the kernel changed
  // something, OK_NOOP means the requested state already held (so a
  // retry loop must not treat it as progress), and HW_GATED is what
  // iommu_ctx_commit_hw reports upward — it never escapes as the result
  // of iommu_domain_switch itself.
  pub let IOMMU_SW_OK               : u64 = 0
  pub let IOMMU_SW_OK_NOOP          : u64 = 1
  pub let IOMMU_HW_GATED            : u64 = 2

  pub let IOMMU_SW_ERR_BAD_ARG        : u64 = 0xFFFFFFCF
  pub let IOMMU_SW_ERR_NOT_HELD       : u64 = 0xFFFFFFCE
  pub let IOMMU_SW_ERR_NO_RIGHT       : u64 = 0xFFFFFFCD
  pub let IOMMU_SW_ERR_DEAD_ROW       : u64 = 0xFFFFFFCC
  pub let IOMMU_SW_ERR_BDF_UNBOUND    : u64 = 0xFFFFFFCB
  pub let IOMMU_SW_ERR_CTX_OWNED      : u64 = 0xFFFFFFCA
  pub let IOMMU_SW_ERR_IN_TRANSITION  : u64 = 0xFFFFFFC9
  pub let IOMMU_SW_ERR_NOT_PROGRAMMED : u64 = 0xFFFFFFC8
  pub let IOMMU_SW_ERR_HW_UNAVAIL     : u64 = 0xFFFFFFC7
  pub let IOMMU_SW_ERR_HW_FAIL        : u64 = 0xFFFFFFC6

  // Sentinel returned by iommu_ctx_owner_find when no live domain owns
  // the queried context entry. Cannot collide with a row id (< 32).
  pub let IOMMU_CTX_OWNER_NONE      : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // R22 hardware-backing registration (see §4)
  //
  // All four are zero at .bss init and stay zero until R22.M5 calls
  // iommu_hw_backing_set. _iommu_hw_ready is the single test the commit
  // path makes; the other three are only read once it is set.
  // ============================================================================

  pub let mut _iommu_hw_ready   : u64 = 0
  pub let mut _iommu_hw_bus     : u64 = 0
  pub let mut _iommu_hw_ctx_va  : u64 = 0
  pub let mut _iommu_hw_slpt_pa : u64 = 0

  // ============================================================================
  // Audit strings (.rodata)
  //
  // Emitted under SUBSYS_CAP_ at LEVEL_INFO, the same channel the
  // KIND_DMA_DOMAIN dispatch chatter uses — bind/unbind are capability
  // state changes, and routing them to the same subsystem keeps a
  // domain's whole life (mint, bind, unbind, revoke) on one filter.
  // ============================================================================

  pub let iommu_bind_msg   : [u8; 18] = "IOMMU DOMAIN BIND\0"
  pub let iommu_unbind_msg : [u8; 20] = "IOMMU DOMAIN UNBIND\0"
  pub let iommu_k_bdf      : [u8; 4]  = "bdf\0"
  pub let iommu_k_row      : [u8; 4]  = "row\0"

  // ============================================================================
  // iommu_hw_backing_set(bus, ctx_table_va, slpt_root_pa) -> u64
  //
  // R22.M5's hook. Registers the three values vtd_context_program needs
  // and arms the hardware path. Returns IOMMU_SW_OK, or
  // IOMMU_SW_ERR_BAD_ARG if bus >= 256 or either address is zero.
  //
  // One bus is supported, not 256. VT-d wants one context-table page per
  // bus; allocating and tracking that fan-out is R22.M5's job, not this
  // module's, and pretending to a 256-entry table here would be storage
  // that no caller could populate. A commit request for a bus other than
  // the registered one returns IOMMU_SW_ERR_HW_UNAVAIL — an honest "the
  // backing for that bus has not been brought up" rather than a silent
  // write to the wrong page.
  // ============================================================================

  pub let iommu_hw_backing_set : (u64, u64, u64) -> u64 !{mem} @{boot} =
    fn (bus: u64) (ctx_table_va: u64) (slpt_root_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R29.M5-004 (#1039): register the R22 hardware backing for the context-entry commit path. Gates: bus >= 256 -> IOMMU_SW_ERR_BAD_ARG; ctx_table_va == 0 -> BAD_ARG; slpt_root_pa == 0 -> BAD_ARG (a zero address can never be a valid table, and admitting it would arm the hardware path onto a null page). Commit order matters: store bus/ctx_va/slpt_pa FIRST, then set _iommu_hw_ready last, so no concurrent reader can observe ready=1 alongside an unpopulated address. Leaf function; four rip-relative stores.",
      block: {
        cmp rdi, 256;
        jae iommu_backing_bad_arg;

        cmp rsi, 0;
        je  iommu_backing_bad_arg;

        cmp rdx, 0;
        je  iommu_backing_bad_arg;

        mov [rip + _iommu_hw_bus], rdi;
        mov [rip + _iommu_hw_ctx_va], rsi;
        mov [rip + _iommu_hw_slpt_pa], rdx;

        // Arm last — see justification.
        mov rax, 1;
        mov [rip + _iommu_hw_ready], rax;

        xor rax, rax;                        // IOMMU_SW_OK
        ret;

      iommu_backing_bad_arg:
        mov rax, 0xFFFFFFCF;                 // IOMMU_SW_ERR_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // iommu_hw_backing_clear() -> ()
  //
  // Disarms the hardware path. Clears _iommu_hw_ready FIRST so no window
  // exists in which ready is set over stale addresses.
  // ============================================================================

  pub let iommu_hw_backing_clear : () -> () !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R29.M5-004 (#1039): disarm the hardware commit path. Zero _iommu_hw_ready first (so a reader that sees ready=0 can never go on to read a stale address), then zero bus / ctx_va / slpt_pa. Leaf function.",
      block: {
        xor rax, rax;
        mov [rip + _iommu_hw_ready], rax;
        mov [rip + _iommu_hw_bus], rax;
        mov [rip + _iommu_hw_ctx_va], rax;
        mov [rip + _iommu_hw_slpt_pa], rax;
        ret
      }
    }

  // ============================================================================
  // iommu_ctx_owner_find(bus_dev_fn) -> u64
  //
  // Returns the row id of the live KIND_DMA_DOMAIN row that currently
  // owns the context entry for bus_dev_fn (ctx_state != DMA_CTX_NONE and
  // ctx_bdf == bus_dev_fn), or IOMMU_CTX_OWNER_NONE if none does.
  //
  // Low-first scan over DMA_DOMAIN_MAX rows. A PENDING row counts as an
  // owner: a switch that is mid-flight has already staked its claim, and
  // letting a second domain slip in during that window is precisely the
  // split-brain the state machine exists to prevent.
  // ============================================================================

  pub let iommu_ctx_owner_find : (u64) -> u64 !{mem} @{} =
    fn (bus_dev_fn: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): scan rows 0..DMA_DOMAIN_MAX for the current owner of a context entry. Per row: dma_ctx_state(i) -> skip on DMA_CTX_NONE (0) and skip on DMA_DECODE_BAD (0xFF..FF, meaning the row is dead or out of range — a dead row owns nothing); otherwise dma_ctx_bdf(i) and compare against the query. First match wins and its row id is returned; exhaustion returns IOMMU_CTX_OWNER_NONE. Callee-save: rbx = row cursor, r12 = queried bdf, both pushed; sub rsp,8 restores 16-byte alignment for the two nested calls per iteration (entry rsp %16 == 8; two pushes -> %16 == 8; sub 8 -> %16 == 0). Same push/sub discipline as vtd_root_init in iommu/vtd_ctx.pdx.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov r12, rdi;                        // queried bdf
        xor rbx, rbx;                        // row cursor

      iommu_owner_loop:
        cmp rbx, 32;                         // DMA_DOMAIN_MAX
        jae iommu_owner_none;

        mov rdi, rbx;
        call dma_ctx_state;

        cmp rax, 0;                          // DMA_CTX_NONE
        je  iommu_owner_next;

        mov r10, 0xFFFFFFFFFFFFFFFF;         // DMA_DECODE_BAD -> dead row
        cmp rax, r10;
        je  iommu_owner_next;

        mov rdi, rbx;
        call dma_ctx_bdf;
        cmp rax, r12;
        jne iommu_owner_next;

        mov rax, rbx;                        // owner found
        jmp iommu_owner_done;

      iommu_owner_next:
        add rbx, 1;
        jmp iommu_owner_loop;

      iommu_owner_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;         // IOMMU_CTX_OWNER_NONE

      iommu_owner_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // iommu_domain_check_holder(cap_slot, row_id) -> u64
  //
  // Gates 1..3 of §2, factored out because switch and unswitch must apply
  // them identically — a divergence between the two would be a hole that
  // only shows up on the release path.
  //
  // Returns 0 when the caller genuinely holds the named domain with
  // RIGHT_MINT, else the matching IOMMU_SW_ERR_* code.
  // ============================================================================

  pub let iommu_domain_check_holder : (u64, u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M5-004 (#1039): holder + authority gate for the domain-switching contract. (1) cap_slot >= 256 -> IOMMU_SW_ERR_BAD_ARG. (2) Load the descriptor at cap_table + cap_slot*24 (stride 24 = kind + rights + target_ptr, per cap/mint.pdx). (3) kind != KIND_DMA_DOMAIN (0x142) -> IOMMU_SW_ERR_NOT_HELD. (4) target_ptr bits [15:0] != row_id -> IOMMU_SW_ERR_NOT_HELD: the capability the caller presented does not name the row it asked about, so it holds nothing relevant. Reporting this as NOT_HELD rather than BAD_ARG is deliberate — from the caller's side it is indistinguishable from presenting a capability it does not own. (5) rights & RIGHT_MINT (0x200) == 0 -> IOMMU_SW_ERR_NO_RIGHT. Returns 0 on success. Pure read; leaf function; no writes.",
      block: {
        cmp rdi, 256;
        jae iommu_holder_bad_arg;

        // cap_table + cap_slot * 24.
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // kind == KIND_DMA_DOMAIN?
        mov r10, [rax + 0];
        mov r11, 0x142;
        cmp r10, r11;
        jne iommu_holder_not_held;

        // target_ptr row id == row_id argument?
        mov r10, [rax + 16];
        mov r11, 0xFFFF;
        and r10, r11;
        cmp r10, rsi;
        jne iommu_holder_not_held;

        // rights & RIGHT_MINT?
        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  iommu_holder_no_right;

        xor rax, rax;
        ret;

      iommu_holder_not_held:
        mov rax, 0xFFFFFFCE;                 // IOMMU_SW_ERR_NOT_HELD
        ret;

      iommu_holder_no_right:
        mov rax, 0xFFFFFFCD;                 // IOMMU_SW_ERR_NO_RIGHT
        ret;

      iommu_holder_bad_arg:
        mov rax, 0xFFFFFFCF;                 // IOMMU_SW_ERR_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // iommu_ctx_commit_hw(row_id, bus_dev_fn) -> u64
  //
  // The hardware half. Returns:
  //   IOMMU_SW_OK              — a real VT-d context entry was written.
  //   IOMMU_HW_GATED           — R22 backing not registered; nothing was
  //                              written and the caller should record the
  //                              switch as software-only.
  //   IOMMU_SW_ERR_HW_UNAVAIL  — backing IS registered but incomplete or
  //                              for a different bus. This is a real
  //                              failure, not a gate: someone armed the
  //                              path and then asked it to do something
  //                              it cannot.
  //
  // The DID (hardware TLB tag) is the domain's iommu_ctx_id truncated to
  // the 16 bits VT-d's context-entry DID field provides.
  // ============================================================================

  pub let iommu_ctx_commit_hw : (u64, u64) -> u64 !{mem} @{boot} =
    fn (row_id: u64) (bus_dev_fn: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R29.M5-004 (#1039): program the real VT-d context entry for a domain/BDF pair via the R22 primitive vtd_context_program. Sequence: (1) _iommu_hw_ready == 0 -> IOMMU_HW_GATED (the R22.M5 backing has not been registered; see file header §4). (2) _vtd_root_va == 0 -> IOMMU_SW_ERR_HW_UNAVAIL (root table never allocated — vtd_root_init is not called at boot). (3) _iommu_hw_ctx_va == 0 or _iommu_hw_slpt_pa == 0 -> HW_UNAVAIL. (4) bus = bdf >> 8; bus != _iommu_hw_bus -> HW_UNAVAIL (only the registered bus has a context-table page). (5) did = dma_tail_decode_ctx_id(row_id) & 0xFFFF — the context entry's DID field is 16 bits (VT-d 4.0 §9.3 qword[1] bits 8..23). (6) vtd_context_program(root_va, ctx_table_va, bus, devfn, slpt_root_pa, did) with devfn = bdf & 0xFF. Return IOMMU_SW_OK. Callee-save: rbx=row_id, r12=bdf, r13=root_va, r14=ctx_table_va, r15=slpt_root_pa — five pushes, so rsp is 16-byte aligned at every nested call (entry %16 == 8, five pushes -> %16 == 0). r9 (domain_id, the sixth SysV argument) is loaded after the decode call and before the argument registers, so nothing clobbers it.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // row_id
        mov r12, rsi;                        // bdf

        mov rax, [rip + _iommu_hw_ready];
        cmp rax, 0;
        je  iommu_commit_gated;

        mov rax, [rip + _vtd_root_va];
        cmp rax, 0;
        je  iommu_commit_unavail;
        mov r13, rax;                        // root_va

        mov rax, [rip + _iommu_hw_ctx_va];
        cmp rax, 0;
        je  iommu_commit_unavail;
        mov r14, rax;                        // ctx_table_va

        mov rax, [rip + _iommu_hw_slpt_pa];
        cmp rax, 0;
        je  iommu_commit_unavail;
        mov r15, rax;                        // slpt_root_pa

        // Registered-bus gate.
        mov rax, r12;
        shr rax, 8;                          // bus
        mov r10, [rip + _iommu_hw_bus];
        cmp rax, r10;
        jne iommu_commit_unavail;

        // did = iommu_ctx_id & 0xFFFF.
        mov rdi, rbx;
        call dma_tail_decode_ctx_id;
        mov r10, 0xFFFF;
        and rax, r10;
        mov r9, rax;                         // arg 6: domain_id

        mov rdi, r13;                        // arg 1: root_va
        mov rsi, r14;                        // arg 2: ctx_table_va
        mov rdx, r12;
        shr rdx, 8;                          // arg 3: bus
        mov rcx, r12;
        mov r10, 0xFF;
        and rcx, r10;                        // arg 4: devfn
        mov r8, r15;                         // arg 5: slpt_root_pa
        call vtd_context_program;

        xor rax, rax;                        // IOMMU_SW_OK
        jmp iommu_commit_epilogue;

      iommu_commit_gated:
        mov rax, 2;                          // IOMMU_HW_GATED
        jmp iommu_commit_epilogue;

      iommu_commit_unavail:
        mov rax, 0xFFFFFFC7;                 // IOMMU_SW_ERR_HW_UNAVAIL

      iommu_commit_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // iommu_ctx_uncommit_hw(bus_dev_fn) -> u64
  //
  // Clears the context entry for a BDF by zeroing both qwords, which
  // drops the Present bit — after this the hardware faults any DMA from
  // that source id rather than translating it through a stale SLPT.
  //
  // Zeroing both qwords rather than clearing bit 0 is deliberate: leaving
  // the SLPT pointer and DID behind in a non-present entry is a
  // ready-made re-enable for anything that later sets the P bit without
  // reprogramming, and it leaks which domain used to own the function.
  // ============================================================================

  pub let iommu_ctx_uncommit_hw : (u64) -> u64 !{mem} @{boot} =
    fn (bus_dev_fn: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R29.M5-004 (#1039): clear the VT-d context entry for a BDF. Gates: _iommu_hw_ready == 0 -> IOMMU_HW_GATED (nothing was ever programmed); _iommu_hw_ctx_va == 0 -> IOMMU_SW_ERR_HW_UNAVAIL; (bdf >> 8) != _iommu_hw_bus -> HW_UNAVAIL. Entry address = _iommu_hw_ctx_va + (bdf & 0xFF) * 16 (context entries are 16 bytes, VT-d 4.0 §9.3). Zero both qwords — qword[0] carries the Present bit and the SLPT pointer, qword[1] the AW and DID. Return IOMMU_SW_OK. Leaf function; two u64 stores, no nested calls. Ordering: plain stores suffice because hardware only walks this table during device DMA translation, and the entry being cleared is exactly the one whose translations are being withdrawn (same reasoning as vtd_context_program's ordering note).",
      block: {
        mov rax, [rip + _iommu_hw_ready];
        cmp rax, 0;
        je  iommu_uncommit_gated;

        mov r8, [rip + _iommu_hw_ctx_va];
        cmp r8, 0;
        je  iommu_uncommit_unavail;

        mov r10, rdi;
        shr r10, 8;                          // bus
        mov r11, [rip + _iommu_hw_bus];
        cmp r10, r11;
        jne iommu_uncommit_unavail;

        mov r10, rdi;
        mov r11, 0xFF;
        and r10, r11;                        // devfn
        shl r10, 4;                          // * 16
        add r8, r10;                         // &ctx_entry

        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;

        xor rax, rax;                        // IOMMU_SW_OK
        ret;

      iommu_uncommit_gated:
        mov rax, 2;                          // IOMMU_HW_GATED
        ret;

      iommu_uncommit_unavail:
        mov rax, 0xFFFFFFC7;                 // IOMMU_SW_ERR_HW_UNAVAIL
        ret
      }
    }

  // ============================================================================
  // iommu_domain_switch(cap_slot, row_id, bus_dev_fn) -> u64
  //
  // THE entry point of the contract. Applies gates 1..7 of §2, drives the
  // state machine of §3, and attempts the hardware commit of §4.
  //
  // Returns IOMMU_SW_OK on a completed switch, IOMMU_SW_OK_NOOP when the
  // domain already owns the context entry for exactly this BDF, or one of
  // the IOMMU_SW_ERR_* codes. On any hardware failure the row's prior
  // context word is restored byte-for-byte before returning.
  //
  // SysV ABI: rdi = cap_slot, rsi = row_id, rdx = bus_dev_fn.
  // ============================================================================

  pub let iommu_domain_switch : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (row_id: u64) (bus_dev_fn: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-004 (#1039): kernel-side IOMMU domain-switch. Gate order (each a distinct code): row_id >= DMA_DOMAIN_MAX or bdf >= 2^16 -> IOMMU_SW_ERR_BAD_ARG; iommu_domain_check_holder -> NOT_HELD / NO_RIGHT / BAD_ARG propagated verbatim; dma_tail_valid == 0 -> DEAD_ROW; ctx_state == DMA_CTX_PENDING -> IN_TRANSITION; ctx_state == DMA_CTX_PROGRAMMED with ctx_bdf == bdf -> OK_NOOP (checked BEFORE the binding gate so an idempotent re-request cannot be refused by a binding that was narrowed after the original switch); dma_bdf_in_binding == 0 -> BDF_UNBOUND; iommu_ctx_owner_find(bdf) names a row other than this one -> CTX_OWNED. Commit sequence: snapshot the whole [+24] word (r13), write PENDING preserving the old bdf/hw bits, call iommu_ctx_commit_hw. IOMMU_HW_GATED -> hw flag 0 (software-only ownership); IOMMU_SW_OK -> hw flag 1; anything else -> restore the snapshot and return the hardware code. Then dma_ctx_pack(DMA_CTX_PROGRAMMED, bdf, hw) + dma_ctx_write, and emit the bind audit line via klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, iommu_bind_msg, iommu_k_bdf, bdf). A dma_ctx_write failure is returned verbatim rather than masked — the row was live at the liveness gate, so a refusal there means the table changed underneath us and inventing a success would be worse than a surprising code. Callee-save: rbx=row_id, r12=bdf, r13=snapshot word, r14=hw flag / saved rc, r15=cap_slot. Five pushes leave rsp 16-byte aligned at every nested call (entry %16 == 8, five pushes -> %16 == 0).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r15, rdi;                        // cap_slot
        mov rbx, rsi;                        // row_id
        mov r12, rdx;                        // bdf

        // -- Gate 1: argument well-formedness.
        cmp rbx, 32;                         // DMA_DOMAIN_MAX
        jae iommu_sw_bad_arg;

        mov r10, r12;
        shr r10, 16;
        cmp r10, 0;
        jne iommu_sw_bad_arg;

        // -- Gates 2 + 3: holder + authority.
        mov rdi, r15;
        mov rsi, rbx;
        call iommu_domain_check_holder;
        cmp rax, 0;
        jne iommu_sw_epilogue;               // propagate verbatim

        // -- Gate 4: liveness.
        mov rdi, rbx;
        call dma_tail_valid;
        cmp rax, 0;
        je  iommu_sw_dead_row;

        // Snapshot the context word.
        mov rdi, rbx;
        call dma_ctx_read;
        mov r13, rax;

        mov r14, r13;
        mov r10, 0xFF;
        and r14, r10;                        // ctx_state

        // -- Gate 5: quiescence.
        cmp r14, 1;                          // DMA_CTX_PENDING
        je  iommu_sw_in_transition;

        // Idempotence: already PROGRAMMED onto this exact BDF?
        cmp r14, 2;                          // DMA_CTX_PROGRAMMED
        jne iommu_sw_binding;
        mov rax, r13;
        shr rax, 8;
        mov r10, 0xFFFF;
        and rax, r10;                        // ctx_bdf
        cmp rax, r12;
        je  iommu_sw_noop;

      iommu_sw_binding:
        // -- Gate 6: BDF within the domain's binding.
        mov rdi, rbx;
        mov rsi, r12;
        call dma_bdf_in_binding;
        cmp rax, 0;
        je  iommu_sw_unbound;

        // -- Gate 7: context-entry exclusivity.
        mov rdi, r12;
        call iommu_ctx_owner_find;
        mov r10, 0xFFFFFFFFFFFFFFFF;         // IOMMU_CTX_OWNER_NONE
        cmp rax, r10;
        je  iommu_sw_owner_ok;
        cmp rax, rbx;
        jne iommu_sw_ctx_owned;

      iommu_sw_owner_ok:
        // Enter PENDING, preserving the old bdf + hw bits.
        mov rsi, r13;
        mov r10, 0xFFFFFF00;
        and rsi, r10;                        // clear state byte
        mov r10, 1;                          // DMA_CTX_PENDING
        or  rsi, r10;
        mov rdi, rbx;
        call dma_ctx_write;
        cmp rax, 0;
        jne iommu_sw_epilogue;

        // Hardware commit.
        mov rdi, rbx;
        mov rsi, r12;
        call iommu_ctx_commit_hw;

        mov r10, 2;                          // IOMMU_HW_GATED
        cmp rax, r10;
        je  iommu_sw_hw_gated;
        cmp rax, 0;                          // IOMMU_SW_OK
        jne iommu_sw_hw_fail;
        mov r14, 1;                          // hw_committed = 1
        jmp iommu_sw_hw_done;

      iommu_sw_hw_gated:
        xor r14, r14;                        // hw_committed = 0

      iommu_sw_hw_done:
        // Commit PROGRAMMED.
        mov rdi, 2;                          // DMA_CTX_PROGRAMMED
        mov rsi, r12;                        // bdf
        mov rdx, r14;                        // hw flag
        call dma_ctx_pack;
        mov rsi, rax;
        mov rdi, rbx;
        call dma_ctx_write;
        cmp rax, 0;
        jne iommu_sw_epilogue;

        // Audit: bind.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + iommu_bind_msg];
        lea rcx, [rip + iommu_k_bdf];
        mov r8,  r12;
        call klog_s1_x1;

        xor rax, rax;                        // IOMMU_SW_OK
        jmp iommu_sw_epilogue;

      iommu_sw_hw_fail:
        // Restore the snapshot verbatim, then report the hardware code.
        mov r14, rax;
        mov rdi, rbx;
        mov rsi, r13;
        call dma_ctx_write;
        mov rax, r14;
        jmp iommu_sw_epilogue;

      iommu_sw_noop:
        mov rax, 1;                          // IOMMU_SW_OK_NOOP
        jmp iommu_sw_epilogue;

      iommu_sw_dead_row:
        mov rax, 0xFFFFFFCC;                 // IOMMU_SW_ERR_DEAD_ROW
        jmp iommu_sw_epilogue;

      iommu_sw_in_transition:
        mov rax, 0xFFFFFFC9;                 // IOMMU_SW_ERR_IN_TRANSITION
        jmp iommu_sw_epilogue;

      iommu_sw_unbound:
        mov rax, 0xFFFFFFCB;                 // IOMMU_SW_ERR_BDF_UNBOUND
        jmp iommu_sw_epilogue;

      iommu_sw_ctx_owned:
        mov rax, 0xFFFFFFCA;                 // IOMMU_SW_ERR_CTX_OWNED
        jmp iommu_sw_epilogue;

      iommu_sw_bad_arg:
        mov rax, 0xFFFFFFCF;                 // IOMMU_SW_ERR_BAD_ARG

      iommu_sw_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // iommu_domain_unswitch(cap_slot, row_id) -> u64
  //
  // Releases the context entry the domain owns. Applies the same holder +
  // authority gates as the switch path (a driver must not be able to
  // release an entry it could not have acquired), then:
  //
  //   PROGRAMMED -> PENDING -> (clear hardware if committed) -> NONE
  //
  // Returns IOMMU_SW_OK, or:
  //   IOMMU_SW_ERR_NOT_PROGRAMMED — the domain owns no context entry.
  //   IOMMU_SW_ERR_IN_TRANSITION  — a switch is mid-flight.
  //   the holder/liveness codes    — as for the switch path.
  //
  // A hardware clear that reports IOMMU_HW_GATED is treated as success:
  // nothing was ever programmed, so nothing needs clearing. Any other
  // hardware failure restores the prior word and is reported, because
  // dropping the software record while a live hardware entry remains
  // would leave a device with reach nobody accounts for — the precise
  // failure the cascade-revoke discipline exists to prevent.
  //
  // SysV ABI: rdi = cap_slot, rsi = row_id.
  // ============================================================================

  pub let iommu_domain_unswitch : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-004 (#1039): release the context entry a domain owns. Gates: row_id >= DMA_DOMAIN_MAX -> IOMMU_SW_ERR_BAD_ARG; iommu_domain_check_holder propagated verbatim; dma_tail_valid == 0 -> DEAD_ROW; ctx_state == DMA_CTX_NONE -> NOT_PROGRAMMED; ctx_state == DMA_CTX_PENDING -> IN_TRANSITION. Sequence: snapshot the [+24] word (r13); extract ctx_bdf (r12) and hw_committed (r14) from the snapshot rather than re-reading, so the hardware clear targets exactly the BDF the software record names; write PENDING preserving the rest; if hw_committed call iommu_ctx_uncommit_hw(bdf) — IOMMU_SW_OK or IOMMU_HW_GATED both proceed, anything else restores the snapshot and returns the hardware code; write the all-zero word (DMA_CTX_NONE, bdf 0, hw 0); emit the unbind audit line via klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, iommu_unbind_msg, iommu_k_row, row_id). Callee-save: rbx=row_id, r12=bdf, r13=snapshot, r14=hw flag / saved rc, r15=cap_slot; five pushes keep rsp 16-byte aligned at every nested call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r15, rdi;                        // cap_slot
        mov rbx, rsi;                        // row_id

        cmp rbx, 32;                         // DMA_DOMAIN_MAX
        jae iommu_us_bad_arg;

        mov rdi, r15;
        mov rsi, rbx;
        call iommu_domain_check_holder;
        cmp rax, 0;
        jne iommu_us_epilogue;

        mov rdi, rbx;
        call dma_tail_valid;
        cmp rax, 0;
        je  iommu_us_dead_row;

        mov rdi, rbx;
        call dma_ctx_read;
        mov r13, rax;

        mov r14, r13;
        mov r10, 0xFF;
        and r14, r10;                        // ctx_state

        cmp r14, 0;                          // DMA_CTX_NONE
        je  iommu_us_not_programmed;
        cmp r14, 1;                          // DMA_CTX_PENDING
        je  iommu_us_in_transition;

        // ctx_bdf + hw_committed from the snapshot.
        mov r12, r13;
        shr r12, 8;
        mov r10, 0xFFFF;
        and r12, r10;                        // bdf

        mov r14, r13;
        shr r14, 24;
        mov r10, 0xFF;
        and r14, r10;                        // hw_committed

        // Enter PENDING.
        mov rsi, r13;
        mov r10, 0xFFFFFF00;
        and rsi, r10;
        mov r10, 1;                          // DMA_CTX_PENDING
        or  rsi, r10;
        mov rdi, rbx;
        call dma_ctx_write;
        cmp rax, 0;
        jne iommu_us_epilogue;

        // Clear hardware only if something was committed.
        cmp r14, 0;
        je  iommu_us_hw_done;

        mov rdi, r12;
        call iommu_ctx_uncommit_hw;
        cmp rax, 0;                          // IOMMU_SW_OK
        je  iommu_us_hw_done;
        mov r10, 2;                          // IOMMU_HW_GATED
        cmp rax, r10;
        je  iommu_us_hw_done;

        // Real hardware failure — restore and report.
        mov r14, rax;
        mov rdi, rbx;
        mov rsi, r13;
        call dma_ctx_write;
        mov rax, r14;
        jmp iommu_us_epilogue;

      iommu_us_hw_done:
        // Commit NONE — all fields cleared in one store.
        mov rdi, rbx;
        xor rsi, rsi;
        call dma_ctx_write;
        cmp rax, 0;
        jne iommu_us_epilogue;

        // Audit: unbind.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + iommu_unbind_msg];
        lea rcx, [rip + iommu_k_row];
        mov r8,  rbx;
        call klog_s1_x1;

        xor rax, rax;                        // IOMMU_SW_OK
        jmp iommu_us_epilogue;

      iommu_us_dead_row:
        mov rax, 0xFFFFFFCC;                 // IOMMU_SW_ERR_DEAD_ROW
        jmp iommu_us_epilogue;

      iommu_us_not_programmed:
        mov rax, 0xFFFFFFC8;                 // IOMMU_SW_ERR_NOT_PROGRAMMED
        jmp iommu_us_epilogue;

      iommu_us_in_transition:
        mov rax, 0xFFFFFFC9;                 // IOMMU_SW_ERR_IN_TRANSITION
        jmp iommu_us_epilogue;

      iommu_us_bad_arg:
        mov rax, 0xFFFFFFCF;                 // IOMMU_SW_ERR_BAD_ARG

      iommu_us_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
