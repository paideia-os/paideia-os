// src/kernel/core/iommu/vtd_ir.pdx — R22-M5-001 (#866)
//
// Intel VT-d Interrupt Remapping (IR) substrate. When IR is enabled,
// MSI/MSI-X messages are no longer decoded directly by the LAPIC —
// instead the "remappable" MSI address encodes a 16-bit interrupt
// handle (IRT index); the VT-d hardware unit looks the handle up in
// the Interrupt Remap Table (IRT), resolves it to a target (vector,
// destination-APIC-id) pair, and delivers via the fabric.  Modern
// Intel client chipsets REQUIRE IR to be enabled for x2APIC MSI to
// function at all (SDM Vol 3A §10.12.7 + VT-d §5).
//
// -----------------------------------------------------------------------------
// IRT (Interrupt Remap Table) layout — VT-d 4.0 §9.10
// -----------------------------------------------------------------------------
//
// Table of 128-bit entries indexed by 16-bit interrupt handle
// (0..N-1). Size is determined by the S (Size) field of IRTA_REG:
// N = 2^(S+1). S=7 → 256 entries × 16 B = 4 KiB (one page).
//
// Each IRTE is 2 × u64 = 16 bytes (128-bit).  Layout used in R22.M5
// (matches VT-d 4.0 §9.10 Remapped-format IRTE):
//
//   low u64 (bits 0..63 of entry):
//     bit  0        P    (Present)
//     bit  1        FPD  (Fault Processing Disable)
//     bits 2..7     Flags: DM/RH/TM/DLM  (0 = Fixed, physical, edge)
//     bits 8..15    Vector (u8)
//     bits 16..31   Reserved / 0
//     bits 32..39   Reserved / 0
//     bits 40..47   SID (bus<<8|dev<<3|fn low byte — see note below)
//     bits 48..49   SVT (Source Validation Type; 00 = none)
//     bits 50..55   Reserved
//     bits 56..63   Dest-APIC-ID hi 8 bits (for 40-bit destinations;
//                                            0 for standard 32-bit)
//
//   high u64 (bits 64..127 of entry):
//     bits 0..31    Dest-APIC-ID lo 32 bits (32-bit x2APIC ID)
//     bits 32..63   Reserved / 0
//
// This layout follows the R22.M5 task spec exactly.  R22.M5 substrate
// never runs on live hardware (QEMU-TCG doesn't emulate VT-d), so bit
// positions only matter for the structural round-trip witness — the
// witness computes the same values and verifies byte-for-byte read-back.
//
// -----------------------------------------------------------------------------
// 128-bit access — 2 × u64 with "present-bit last" ordering
// -----------------------------------------------------------------------------
//
// VT-d §9.10 says IRTE updates "should be atomic 128-bit".  The Intel
// software recommendation (SDM Vol 3A §10.12.7 + Linux drivers/iommu/
// intel/irq_remapping.c commit history) accepts a NON-atomic pattern
// as long as the walker cannot observe an inconsistent entry:
//
//   (1) Write the high u64 first (dest-APIC-id).  Safe — walker
//       skips entries with P=0.
//   (2) Write low u64 with P=0 (mask).  If a stale entry existed,
//       this masks it before we start rewriting fields.
//   (3) mfence.
//   (4) Write low u64 with P=1 (unmask, atomically publishes the
//       fully-programmed entry — the walker's atomic read of the low
//       qword sees the whole low-word with P=1 in one step).
//
// This IS the R21.M4 MSI-X approach for the same reason (mask-first,
// unmask-last, 4 × 32-bit stores instead of atomic 128-bit — see
// core/pci/msix.pdx L46-57 for the identical rationale).  Removes the
// cross-repo blocker on #866 that cited 128-bit MOVDQU: no MOVDQU
// needed.
//
// -----------------------------------------------------------------------------
// IRTA_REG (0xB8) — Interrupt Remap Table Address Register
// -----------------------------------------------------------------------------
//
//   bits 0..3      S (Size: number of entries = 2^(S+1); S=7 → 256)
//   bits 4..10     Reserved / 0
//   bit  11        EIME (Extended Interrupt Mode; 1 = x2APIC mode)
//   bits 12..63    IRT base PA (4KB-aligned; low 12 bits are S+EIME+rsvd)
//
// IRT-enable ceremony (VT-d §6.6):
//   (1) Allocate IRT + fill IRTA_REG (IRT PA | EIME | S).
//   (2) GCMD.SIRTP (bit 24): edge-triggered "Set IRTP".  Poll GSTS.IRTPS.
//   (3) GCMD.IRE (bit 25): "Interrupt Remap Enable".  Poll GSTS.IRES.
//
// NOT WIRED AT M5 BOOT — QEMU-TCG default (-machine q35 without
// intel-iommu=on) does not emulate VT-d.  Calling vtd_ir_init on TCG
// would fault on the MMIO write.  Symbol existence + witness round-trip
// is the acceptance contract for #866.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores (used via
//       vtd_write_u32 helper; direct memory stores here are all u64).
//   Reserved-label prefix `vtd_ir_*` avoids `loop`, `next`, `if`.

module VtdIr = structure {

  // ============================================================================
  // Layout constants
  // ============================================================================

  pub let VTD_IRT_PAGE_SIZE         : u64 = 4096
  pub let VTD_IRT_ENTRIES           : u64 = 256          // 2^(7+1)
  pub let VTD_IRT_ENTRY_SIZE        : u64 = 16           // 128-bit IRTE
  pub let VTD_IR_HANDLE_INVALID     : u64 = 0xFFFF

  // IRTA_REG bits
  pub let VTD_IRTA_S_256            : u64 = 7            // S=7 → 256 entries
  pub let VTD_IRTA_EIME             : u64 = 0x800        // bit 11 (x2APIC mode)

  // GCMD / GSTS bits duplicated from vtd_regs.pdx for locality.
  pub let VTD_IR_GCMD_SIRTP         : u64 = 0x01000000   // bit 24
  pub let VTD_IR_GCMD_IRE           : u64 = 0x02000000   // bit 25
  pub let VTD_IR_GSTS_IRTPS         : u64 = 0x01000000   // bit 24
  pub let VTD_IR_GSTS_IRES          : u64 = 0x02000000   // bit 25

  pub let VTD_IR_POLL_BUDGET        : u64 = 1024

  pub let VTD_IR_REG_IRTA           : u64 = 0xB8
  pub let VTD_IR_REG_GCMD           : u64 = 0x18
  pub let VTD_IR_REG_GSTS           : u64 = 0x1C

  pub let VTD_IR_KERNEL_VMA_BASE    : u64 = 0xFFFF800000000000
  pub let VTD_IR_TABLE_ADDR_MASK    : u64 = 0xFFFFFFFFFFFFF000

  // ============================================================================
  // Canonical static slots — IRT VA + PA + handle bump cursor
  // ============================================================================
  //
  //   _vtd_irt_va         : kernel VA of the 4KB IRT page (phys_alloc-form)
  //   _vtd_irt_pa         : hardware-visible PA (VA - KERNEL_VMA_BASE)
  //   _vtd_ir_next_handle : bump-alloc cursor (0..VTD_IRT_ENTRIES-1)
  //
  // Both PA/VA at zero until vtd_ir_init runs. Handle cursor starts at 0.
  // The witness in tests/kernel/iommu/msix_ir_round_robin.pdx spoofs
  // _vtd_irt_va to point at its .bss-backed fake IRT (bypasses the
  // phys_alloc path since it never runs against live VT-d).

  pub let mut _vtd_irt_va          : u64 = 0
  pub let mut _vtd_irt_pa          : u64 = 0
  pub let mut _vtd_ir_next_handle  : u64 = 0

  // ============================================================================
  // ir_alloc_handle — simple bump allocator into 256 handle slots
  // ============================================================================
  //
  // SysV: () -> u64
  //
  // Returns rax = next handle (0..255), or VTD_IR_HANDLE_INVALID (0xFFFF)
  // on exhaustion.  Leaf function.

  pub let ir_alloc_handle : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M5-001 (#866). Bump-allocates the next available IRT handle from _vtd_ir_next_handle. Body: (1) Load cursor. (2) If cursor >= VTD_IRT_ENTRIES (256), return 0xFFFF (VTD_IR_HANDLE_INVALID). (3) Otherwise bump cursor (cursor+1) and return the pre-bump value. No concurrency guard — R22.M5 call sites are all boot-time from BSP (matches the R21.M4 vector_alloc_for_cpu posture). Leaf, no prologue. Encoder: mov / cmp / jae / add — all pre-existing.",
      block: {
        mov rax, [rip + _vtd_ir_next_handle];
        cmp rax, 256;
        jae ir_alloc_h_exhausted;
        mov r10, rax;
        add r10, 1;
        mov [rip + _vtd_ir_next_handle], r10;
        ret;

      ir_alloc_h_exhausted:
        mov rax, 0xFFFF;
        ret
      }
    } @no_frame

  // ============================================================================
  // vtd_ir_init — allocate + zero IRT, program IRTA_REG, issue SIRTP + IRE
  // ============================================================================
  //
  // SysV: (base: u64) -> u64
  //
  //   rdi = VT-d hardware unit MMIO base.
  //
  // Returns rax = IRT PA on success, 0 on phys_alloc failure.  Cached
  // via _vtd_irt_pa on subsequent calls (idempotent).
  //
  // Steps (VT-d 4.0 §6.6):
  //   (a) phys_alloc(0) → 4KB page for the IRT; zero 256 × 16-byte = 512
  //       × 8-byte stores.
  //   (b) Compute IRT PA = VA - KERNEL_VMA_BASE. Cache both.
  //   (c) IRTA_REG = PA | EIME | S=7.  vtd_write_u64(base, 0xB8, value).
  //   (d) Read GCMD, OR with SIRTP (bit 24), write back.  Poll GSTS for
  //       IRTPS (bit 24) up to VTD_IR_POLL_BUDGET iterations.
  //   (e) Read GCMD, OR with IRE (bit 25), write back.  Poll GSTS for
  //       IRES (bit 25) up to VTD_IR_POLL_BUDGET iterations.
  //   (f) Emit klog INFO IOMM tag_vtd_ir_init k_reg_base=base
  //       k_root_pa=irt_pa (structural fingerprint; the acceptance stem
  //       "IRTable @<addr> mode=extended" is the tag_vtd_ir_table variant
  //       reserved for the fully-wired R23+ path).
  //
  // NOT WIRED AT M5 BOOT.

  pub let vtd_ir_init : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M5-001 (#866). VT-d Interrupt Remap Table (IRT) init + SIRTP + IRE ceremony. Body: (0) Idempotence — if _vtd_irt_pa != 0, return it. (1) 3-push callee-save (rbx=base, r12=IRT_VA, r13=IRT_PA); rsp entry %16==8 → 3 pushes %16==0. sub rsp,8 pre-align for the nested phys_alloc call → 8 more bytes → %16==8. Actually: 8+24=32, %16==0; +8=40, %16==8. Hmm. Since phys_alloc needs %16==0 before call, use `sub rsp, 8` before phys_alloc — actually 3 pushes bring us from 8 → 0. phys_alloc takes 0 stack args so caller %16==0 at call time (call pushes return addr = 8, %16==8 in callee). No extra sub needed. Recheck: rsp entry to fn = %16==8 (caller push retaddr = 8). After 3 pushes (24B) → 8+24=32 → %16==0. Good, aligned for call. (2) phys_alloc(0) → VA. If 0 → return 0 (OOM). r12 = VA. (3) Zero 512 × 8-byte slots (256 IRTEs × 16 B). (4) r13 = VA - KERNEL_VMA_BASE = PA. Cache both in _vtd_irt_va / _vtd_irt_pa. (5) Compose IRTA = PA | 0x800 (EIME) | 7 (S=7). vtd_write_u64(base=rbx, 0xB8, irta). (6) SIRTP: vtd_read_u32(base, 0x18) → OR with 0x01000000 → vtd_write_u32. Poll GSTS bit 24 via loop reading vtd_read_u32(base, 0x1C) up to 1024 iterations. (7) IRE: vtd_read_u32(base, 0x18) → OR with 0x02000000 → vtd_write_u32. Poll GSTS bit 25. (8) klog_s1_x1 INFO IOMM tag_vtd_ir_init k_root_pa=irt_pa. (9) Return PA. NOT INVOKED AT M5 BOOT — kernel_main never calls this on QEMU-TCG which doesn't emulate VT-d. Encoder: mov / cmp / je / call / xor / add / shl / or / and / mov [reg + reg*8], reg — all pre-existing.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                          // rbx = base

        // ---- (0) Idempotence ----
        mov rax, [rip + _vtd_irt_pa];
        cmp rax, 0;
        jne vtd_ir_init_cached;

        // ---- (2) phys_alloc(0) for IRT page ----
        mov rdi, 0;
        call phys_alloc;
        cmp rax, 0;
        je  vtd_ir_init_oom;
        mov r12, rax;                          // r12 = IRT VA

        // ---- (3) Zero 512 × 8-byte slots (4 KiB) ----
        xor rcx, rcx;
        xor rdx, rdx;
      vtd_ir_init_zero_loop:
        cmp rcx, 512;
        jae vtd_ir_init_zero_done;
        mov [r12 + rcx * 8], rdx;
        add rcx, 1;
        jmp vtd_ir_init_zero_loop;
      vtd_ir_init_zero_done:

        // ---- (4) PA = VA - KERNEL_VMA_BASE. Cache VA + PA. ----
        mov r13, r12;
        mov rdx, 0xFFFF800000000000;
        sub r13, rdx;
        mov [rip + _vtd_irt_va], r12;
        mov [rip + _vtd_irt_pa], r13;

        // ---- (5) Compose IRTA = PA | EIME | S=7. vtd_write_u64. ----
        mov rdx, r13;
        or  rdx, 0x800;                        // EIME (bit 11)
        or  rdx, 7;                            // S=7 (256 entries)
        mov rdi, rbx;
        mov rsi, 0xB8;                         // VTD_IR_REG_IRTA
        call vtd_write_u64;

        // ---- (6) SIRTP: GCMD |= 0x01000000, poll GSTS.IRTPS ----
        mov rdi, rbx;
        mov rsi, 0x18;                         // GCMD
        call vtd_read_u32;
        mov rdx, rax;
        or  rdx, 0x01000000;                   // SIRTP
        mov rdi, rbx;
        mov rsi, 0x18;
        call vtd_write_u32;

        // Poll GSTS bit 24 up to 1024 iterations.
        xor rcx, rcx;
      vtd_ir_init_poll_sirtp:
        cmp rcx, 1024;
        jae vtd_ir_init_poll_sirtp_done;
        mov rdi, rbx;
        mov rsi, 0x1C;                         // GSTS
        push rcx;
        call vtd_read_u32;
        pop rcx;
        mov r10, rax;
        and r10, 0x01000000;                   // IRTPS
        cmp r10, 0;
        jne vtd_ir_init_poll_sirtp_done;
        add rcx, 1;
        jmp vtd_ir_init_poll_sirtp;
      vtd_ir_init_poll_sirtp_done:

        // ---- (7) IRE: GCMD |= 0x02000000, poll GSTS.IRES ----
        mov rdi, rbx;
        mov rsi, 0x18;                         // GCMD
        call vtd_read_u32;
        mov rdx, rax;
        or  rdx, 0x02000000;                   // IRE
        mov rdi, rbx;
        mov rsi, 0x18;
        call vtd_write_u32;

        xor rcx, rcx;
      vtd_ir_init_poll_ire:
        cmp rcx, 1024;
        jae vtd_ir_init_poll_ire_done;
        mov rdi, rbx;
        mov rsi, 0x1C;                         // GSTS
        push rcx;
        call vtd_read_u32;
        pop rcx;
        mov r10, rax;
        and r10, 0x02000000;                   // IRES
        cmp r10, 0;
        jne vtd_ir_init_poll_ire_done;
        add rcx, 1;
        jmp vtd_ir_init_poll_ire;
      vtd_ir_init_poll_ire_done:

        // ---- (8) klog_s1_x1(INFO, IOMM, tag_vtd_ir_init, k_root_pa, irt_pa) ----
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_vtd_ir_init];
        lea rcx, [rip + k_root_pa];
        mov r8,  r13;
        call klog_s1_x1;

        // ---- (9) Return PA ----
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      vtd_ir_init_cached:
        // rax already loaded from _vtd_irt_pa in the idempotence check.
        pop r13;
        pop r12;
        pop rbx;
        ret;

      vtd_ir_init_oom:
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // vtd_ir_program — write one IRTE with the mask-first / unmask-last dance
  // ============================================================================
  //
  // SysV: (index: u64, vector: u64, dest_apic_id: u64, source_id: u64) -> u64
  //
  //   rdi = handle (0..255)
  //   rsi = vector (u8)
  //   rdx = destination APIC ID (32-bit for x2APIC)
  //   rcx = source ID (BDF16 = bus<<8 | dev<<3 | fn)
  //
  // Returns rax = 0 on success, 1 on invalid index (>= 256) or if IRT
  // is not initialized (_vtd_irt_va == 0).
  //
  // Composition (matches module header layout):
  //   dest_hi = (dest_apic_id >> 32) & 0xFF     (high 8 bits, non-zero
  //                                              only for 40-bit dest)
  //   dest_lo = dest_apic_id & 0xFFFFFFFF
  //
  //   low_masked  = (dest_hi << 56) | (0 << 48) | (source_id << 40)
  //                                             | (vector << 8) | 0
  //                (P = 0 while walker might be racing)
  //   low_present = low_masked | 1              (P = 1)
  //   high        = dest_lo                     (32-bit APIC ID)
  //
  // Store order (matches R21.M4 mask-first / unmask-last discipline):
  //   (a) Write high u64 first (safe — walker won't consume with P=0).
  //   (b) mfence.
  //   (c) Write low u64 with P=0 (masks any stale entry).
  //   (d) mfence.
  //   (e) Write low u64 with P=1 (atomically publishes).
  //   (f) mfence.

  pub let vtd_ir_program : (u64, u64, u64, u64) -> u64 !{mem} @{boot} =
    fn (handle: u64, vector: u64, dest_apic_id: u64, source_id: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M5-001 (#866). Program one IRTE using 2 × u64 stores with mask-first / unmask-last ordering (SDM Vol 3A §10.12.7 + VT-d §9.10). No 128-bit MOVDQU dependency — same tactic as R21.M4 core/pci/msix.pdx (mask via bit 0 clear, publish via bit 0 set). Body: (1) Bounds-check handle < 256; if not, return 1. (2) Load _vtd_irt_va; if 0 (uninitialized), return 1. (3) Compute entry_va = irt_va + handle * 16. (4) Compose dest_hi = (dest_apic_id >> 32) & 0xFF; dest_lo = dest_apic_id & 0xFFFFFFFF. (5) low_masked = (dest_hi << 56) | ((source_id & 0xFFFF) << 40) | ((vector & 0xFF) << 8). No P bit yet. (6) Write high u64 first: [entry_va + 8] = dest_lo. mfence. (7) Write low u64 with P=0: [entry_va + 0] = low_masked. mfence. (8) Write low u64 with P=1: [entry_va + 0] = low_masked | 1. mfence. (9) Return 0. Leaf function — no nested call, so no prologue push chain needed beyond argument save. Encoder: mov / shl / shr / and / or / cmp / jae / mfence — all pre-existing.",
      block: {
        // ---- (1) Bounds check ----
        cmp rdi, 256;
        jae vtd_ir_program_bad;

        // ---- (2) IRT must be initialized ----
        mov r10, [rip + _vtd_irt_va];
        cmp r10, 0;
        je  vtd_ir_program_bad;

        // ---- (3) entry_va = irt_va + handle * 16 ----
        mov rax, rdi;
        shl rax, 4;                            // handle * 16
        add rax, r10;                          // rax = entry_va
        mov r11, rax;                          // r11 = entry_va (preserved)

        // ---- (4) dest split ----
        mov r8, rdx;                           // r8 = dest_apic_id
        mov r9, r8;
        shr r9, 32;                            // r9 = dest_hi_raw
        and r9, 0xFF;                          // r9 = dest_hi (8 bits)
        mov rax, 0xFFFFFFFF;
        and r8, rax;                           // r8 = dest_lo (32 bits)

        // ---- (5) Compose low_masked in rax ----
        //   low = (dest_hi << 56) | (sid_u16 << 40) | (vector_u8 << 8)
        mov rax, r9;
        shl rax, 56;                           // dest_hi @ bits 56..63

        mov r9, rcx;                           // reuse r9 for sid
        and r9, 0xFFFF;
        shl r9, 40;                            // sid @ bits 40..55 (u16, but only 8..47 span if u8)
        or  rax, r9;

        mov r9, rsi;                           // vector
        and r9, 0xFF;
        shl r9, 8;                             // vector @ bits 8..15
        or  rax, r9;

        // rax = low_masked (P=0 implicit; all other flag bits 0)

        // ---- (6) Write high u64 first ----
        mfence;
        mov [r11 + 8], r8;                     // high = dest_lo
        mfence;

        // ---- (7) Write low u64 with P=0 ----
        mov [r11 + 0], rax;
        mfence;

        // ---- (8) Write low u64 with P=1 ----
        or  rax, 1;
        mov [r11 + 0], rax;
        mfence;

        // ---- (9) Success ----
        xor rax, rax;
        ret;

      vtd_ir_program_bad:
        mov rax, 1;
        ret
      }
    } @no_frame
}
