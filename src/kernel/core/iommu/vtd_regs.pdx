// src/kernel/core/iommu/vtd_regs.pdx — R22-M4-002 (#862)
//
// Intel VT-d hardware unit MMIO register-set accessors. Each VT-d
// hardware unit exposes a page-sized MMIO window whose base is
// reported by a DMAR DRHD sub-structure (see dmar.pdx). The register
// layout is fixed per Intel VT-d 4.0 §11 — the offsets in this file
// match Table 11-1 verbatim.
//
// -----------------------------------------------------------------------------
// Register layout (offsets from register_base, VT-d 4.0 §11.4)
// -----------------------------------------------------------------------------
//
//   0x00  VER          u32   Architecture Version Register (major.minor)
//   0x04  reserved     u32
//   0x08  CAP          u64   Capability Register (features + sizes)
//   0x10  ECAP         u64   Extended Capability Register (post-1.0 features)
//   0x18  GCMD         u32   Global Command Register (write-1-to-request)
//   0x1C  GSTS         u32   Global Status Register (read-only status)
//   0x20  RTADDR       u64   Root-Table Address Register (SLPT root PA + TTM)
//   0x28  CCMD         u64   Context Command Register (invalidations)
//   0x30  reserved     u32
//   0x34  FSTS         u32   Fault Status Register (PPF / PFO / ITE / etc.)
//   0x38  FECTL        u32   Fault Event Control Register (mask bit 31)
//   0x3C  FEDATA       u32   Fault Event Data Register (IRQ delivery data)
//   0x40  FEADDR       u32   Fault Event Address Register (IRQ dest addr lo)
//   0x44  FEUADDR      u32   Fault Event Upper Address Register (dest addr hi)
//
// Higher offsets (Advanced Fault Log, PMEN, IQ*, IRT*, PQ*) are R23+
// scope and not exposed here.
//
// -----------------------------------------------------------------------------
// GCMD/GSTS bits (Table 11-2 / 11-3) — reference for R22.M5+ enable path
// -----------------------------------------------------------------------------
//
//   bit 31  TE / TES     Translation Enable / Enabled Status
//   bit 30  SRTP / RTPS  Set Root Table Pointer / Root Table Ptr Status
//   bit 29  SFL          Set Fault Log
//   bit 28  EAFL         Enable Advanced Fault Logging
//   bit 27  WBF          Write Buffer Flush
//   bit 26  QIE / QIES   Queued Invalidation Enable
//   bit 25  IRE / IRES   Interrupt-Remap Enable
//   bit 24  SIRTP        Set Interrupt Remap Table Pointer
//   bit 23  CFI          Compatibility Format Interrupt
//
// -----------------------------------------------------------------------------
// FSTS bits (Table 11-13) — read by vtd_fault_dispatch (vtd_fault.pdx)
// -----------------------------------------------------------------------------
//
//   bit 0   PPF   Primary Pending Fault  (write-1-to-clear on FRR bits)
//   bit 1   PFO   Primary Fault Overflow (write-1-to-clear)
//   bits 8..15  FRI  Index of first pending fault in FRR ring
//
// -----------------------------------------------------------------------------
// _vtd_base — MVP hard-coded MMIO base
// -----------------------------------------------------------------------------
//
// R22.M4 hard-codes _vtd_base = 0xFED90000 (Intel PCH default per Intel
// Cannon Point / Comet Point PCH documentation). Under real firmware,
// R22.M5 will overwrite this from the DMAR DRHD register_base field
// once has_dmar is set. QEMU-TCG (-machine q35 without intel-iommu)
// does not emulate VT-d, so touching this address returns 0xFFFF_FFFF
// / faults — the R22.M4 close is careful to NEVER call these accessors
// at boot on TCG.
//
// -----------------------------------------------------------------------------
// MMIO ordering discipline
// -----------------------------------------------------------------------------
//
// All accessors bracket the MMIO transaction with `mfence` per the
// pattern established in core/apic/ioapic.pdx L263-273:
//   (a) mfence-BEFORE: earlier WB stores retire before UC MMIO
//       transaction begins (SDM Vol 3A §11.3.1 — WB→UC not ordered).
//   (b) mfence-AFTER: the MMIO transaction publishes / completes
//       before downstream code observes side-effects.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores.

module VtdRegs = structure {

  // ============================================================================
  // Register offsets (bytes from register_base)
  // ============================================================================

  pub let VTD_REG_VER               : u64 = 0x00
  pub let VTD_REG_CAP               : u64 = 0x08
  pub let VTD_REG_ECAP              : u64 = 0x10
  pub let VTD_REG_GCMD              : u64 = 0x18
  pub let VTD_REG_GSTS              : u64 = 0x1C
  pub let VTD_REG_RTADDR            : u64 = 0x20
  pub let VTD_REG_CCMD              : u64 = 0x28
  pub let VTD_REG_FSTS              : u64 = 0x34
  pub let VTD_REG_FECTL             : u64 = 0x38
  pub let VTD_REG_FEDATA            : u64 = 0x3C
  pub let VTD_REG_FEADDR            : u64 = 0x40
  pub let VTD_REG_FEUADDR           : u64 = 0x44

  // ============================================================================
  // GCMD / GSTS control bits (§11.4.4)
  // ============================================================================

  pub let VTD_GCMD_TE               : u64 = 0x80000000
  pub let VTD_GCMD_SRTP             : u64 = 0x40000000
  pub let VTD_GCMD_QIE              : u64 = 0x04000000
  pub let VTD_GCMD_IRE              : u64 = 0x02000000
  pub let VTD_GCMD_SIRTP            : u64 = 0x01000000

  pub let VTD_GSTS_TES              : u64 = 0x80000000
  pub let VTD_GSTS_RTPS             : u64 = 0x40000000

  // ============================================================================
  // FSTS status bits (§11.4.9)
  // ============================================================================

  pub let VTD_FSTS_PPF              : u64 = 0x00000002
  pub let VTD_FSTS_PFO              : u64 = 0x00000001

  // ============================================================================
  // MMIO base — hard-coded PCH default until R22.M5 wires DMAR-derived value
  // ============================================================================

  pub let mut _vtd_base : u64 = 0xFED90000

  // ============================================================================
  // vtd_read_u32 — 32-bit MMIO read from register_base + offset
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //
  //   rdi = MMIO base (typically _vtd_base or a DRHD-published unit base)
  //   rsi = register offset (VTD_REG_* constant)
  //
  // Returns rax = 32-bit register value, zero-extended to 64 bits.
  //
  // Leaf function. mfence brackets the MMIO transaction.

  pub let vtd_read_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-002 (#862). VT-d register-set 32-bit MMIO read. rdi = MMIO base (page-aligned per VT-d §11.1), rsi = register offset (VTD_REG_* constant). Body: (1) mfence — earlier WB stores retire before this UC MMIO transaction (SDM Vol 3A §11.3.1: WB→UC on same CPU is not TSO-ordered). (2) Compute effective address = base + offset. (3) mov eax, [rax] — 32-bit MMIO load; zero-extends into upper 32 bits of rax per SDM Vol 2A §3.4.1.1. (4) mfence — result must complete before downstream code observes side-effects (typical: caller acts on the returned value). Leaf function, no prologue. Same MMIO discipline as core/apic/ioapic.pdx L263 (base-parametric IOAPIC read).",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    } @no_frame

  // ============================================================================
  // vtd_write_u32 — 32-bit MMIO write to register_base + offset
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64, val: u64) -> ()
  //
  //   rdi = MMIO base
  //   rsi = register offset
  //   rdx = value (low 32 bits stored; high bits ignored)

  pub let vtd_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-002 (#862). VT-d register-set 32-bit MMIO write. rdi = MMIO base, rsi = register offset, rdx = value (low 32 bits stored). Body: (1) mfence — bracket earlier WB stores. (2) Compute effective address = base + offset. (3) mov_d [rax], rdx — 32-bit MMIO store (G1: sized-32-bit form; bare `mov [rax], rdx` widens to REX.W and writes 8 bytes into a 4-byte register slot, corrupting the adjacent register). (4) mfence — value must publish before downstream observation. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    } @no_frame

  // ============================================================================
  // vtd_read_u64 — 64-bit MMIO read (CAP, ECAP, RTADDR, CCMD)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //
  //   rdi = MMIO base
  //   rsi = register offset (must be 8-byte-aligned per VT-d §11.1)
  //
  // Returns rax = 64-bit register value.

  pub let vtd_read_u64 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-002 (#862). VT-d register-set 64-bit MMIO read (CAP @ 0x08, ECAP @ 0x10, RTADDR @ 0x20, CCMD @ 0x28 — all naturally 8-byte-aligned per VT-d §11.1). Body: mfence / lea addr / mov rax, [addr] (plain 64-bit load; no encoder-gap risk since the destination *is* rax) / mfence. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov rax, [rax];
        mfence;
        ret
      }
    } @no_frame

  // ============================================================================
  // vtd_write_u64 — 64-bit MMIO write (RTADDR, CCMD)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64, val: u64) -> ()

  pub let vtd_write_u64 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-002 (#862). VT-d register-set 64-bit MMIO write (RTADDR programming during SRTP flow; CCMD invalidation submissions). Body: mfence / lea addr / mov [addr], rdx (plain 64-bit store — no G1 risk since the source is a 64-bit register and the intended store width is 8 bytes, matching REX.W) / mfence. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov [rax], rdx;
        mfence;
        ret
      }
    } @no_frame

  // ============================================================================
  // vtd_capabilities_dump — emit VER/CAP/ECAP fingerprint
  // ============================================================================
  //
  // SysV: (base: u64) -> ()
  //
  //   rdi = VT-d hardware unit MMIO base
  //
  // Emits klog line:
  //   INFO IOMM tag_vtd_regs_dump ver=<u32> cap=<u64_low32> ecap=<u64_low32>
  //
  // NOT INVOKED AT R22.M4 BOOT. Reserved for R22.M5 wire-up on a
  // platform where DMAR-derived _vtd_base is validated. On QEMU-TCG
  // (which does not emulate VT-d), calling this would trap on the
  // MMIO load — deliberately never called from kernel_main at M4.

  pub let vtd_capabilities_dump : (u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-002 (#862). Emits VT-d VER/CAP/ECAP fingerprint. Body: 4-push callee-save prologue (rbx=base, r12=ver, r13=cap, r14=ecap). Stack alignment: entry rsp%16==8; after 4 pushes rsp%16==8 (even push count preserves parity); after subsequent 5 stack-arg pushes (40 B) → rsp%16 == (8-40)%16 == 0 — aligned for the nested klog_s1_x4 call. No sub rsp for pre-align needed. (1) vtd_read_u32(base, VTD_REG_VER) → r12. (2) vtd_read_u64(base, VTD_REG_CAP) → r13 (full u64; klog prints in hex). (3) vtd_read_u64(base, VTD_REG_ECAP) → r14 (full u64). (4) klog_s1_x4(INFO, IOMM, tag_vtd_regs_dump, k_reg_base, base, k_ver, ver, k_cap, cap, k_ecap, ecap). Extended args (v_ecap / k_ecap / v_cap / k_cap / v_ver) pushed on stack in right-to-left order per SysV extended-args convention (matches core/pci/enum.pdx L318-344). k_ver goes in r9 (2nd register KV key). NOT INVOKED AT M4 BOOT — kernel_main never calls this. First real invocation lands in R22.M5 wire-up. Encoder: mov / add / call / lea / push / pop — all pre-#862 proven.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                          // rbx = base

        // ---- (1) VER (u32) ----
        mov rdi, rbx;
        mov rsi, 0x00;                         // VTD_REG_VER
        call vtd_read_u32;
        mov r12, rax;

        // ---- (2) CAP (u64) — full u64 for hex fingerprint ----
        mov rdi, rbx;
        mov rsi, 0x08;                         // VTD_REG_CAP
        call vtd_read_u64;
        mov r13, rax;

        // ---- (3) ECAP (u64) — full u64 for hex fingerprint ----
        mov rdi, rbx;
        mov rsi, 0x10;                         // VTD_REG_ECAP
        call vtd_read_u64;
        mov r14, rax;

        // ---- (4) klog_s1_x4(INFO, IOMM, tag_vtd_regs_dump, kvs...) ----
        // Right-to-left push order for stack args (SysV extended-args).
        // Post 5 pushes: klog_s1_x4 sees at [rsp+8]=v2, [rsp+16]=k3,
        // [rsp+24]=v3, [rsp+32]=k4, [rsp+40]=v4.
        push r14;                              // v4 = ecap
        lea rax, [rip + k_ecap];
        push rax;                              // k4
        push r13;                              // v3 = cap
        lea rax, [rip + k_cap];
        push rax;                              // k3
        push r12;                              // v2 = ver

        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_vtd_regs_dump];
        lea rcx, [rip + k_reg_base];           // k1
        mov r8,  rbx;                          // v1 = base
        lea r9,  [rip + k_ver];                // k2 = k_ver

        call klog_s1_x4;

        add rsp, 40;                           // pop 5 stack args
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
