// src/kernel/core/iommu/dmar.pdx — R22-M4-001 (#861)
//
// DMAR (DMA Remapping Reporting) ACPI table parser. The DMAR table
// (SDT signature "DMAR", SIG_DMAR = 0x52414D44 in SdtHdr) is the ACPI
// table that Intel firmware publishes to describe every VT-d (IOMMU)
// hardware unit ("DRHD" = DMA Remapping Hardware unit Definition) on
// the platform, along with legacy DMA carveouts (RMRR), ATS reporting
// (ATSR), and NUMA affinity records (RHSA).
//
// R22.M4 ONLY parses the DRHD entries. RMRR/ATSR/RHSA are skipped via
// the length-prefixed walk (their bodies are never dereferenced) —
// R22.M5+ can add them as separate parsers reusing this walker shape.
//
// -----------------------------------------------------------------------------
// DMAR on-wire layout (Intel VT-d 4.0 §8.1)
// -----------------------------------------------------------------------------
//
//   +0..35    sdt_hdr             — signature "DMAR" (SIG_DMAR = 0x52414D44 LE)
//   +36       u8  host_address_width — HAW-1 (e.g. 47 for 48-bit HAW)
//   +37       u8  flags               — bit 0 = INTR_REMAP present,
//                                       bit 1 = X2APIC_OPT_OUT,
//                                       bit 2 = DMA_CTRL_PLATFORM_OPT_IN
//   +38..47   reserved (10 bytes)
//   +48..     remapping-structures TLV stream — variable-length records:
//
//     Every sub-structure begins with:
//        +0  u16 type
//        +2  u16 length   (total record size including this header)
//
//   Sub-structure types walked (VT-d §8.3 .. §8.7):
//     0  DRHD  DMA Remapping Hardware Unit Definition   (parsed)
//     1  RMRR  Reserved Memory Region Reporting         (skipped)
//     2  ATSR  Root-Port ATS Capability Reporting       (skipped)
//     3  RHSA  Remapping Hardware Static Affinity       (skipped)
//     4  ANDD  ACPI Name-space Device Declaration       (skipped)
//     5  SATC  SoC Integrated Address Translation Cache (skipped)
//     6  SIDP  SoC Integrated Device Property           (skipped)
//
// -----------------------------------------------------------------------------
// DRHD body (VT-d 4.0 §8.3.1)
// -----------------------------------------------------------------------------
//
//     +0  u16 type = 0
//     +2  u16 length
//     +4  u8  flags               bit 0 = INCLUDE_PCI_ALL (catch-all unit)
//     +5  u8  size                bits 0..4 = pasid table entries log2 (R22.M4 unused)
//     +6  u16 segment
//     +8  u64 register_base       MMIO base for this VT-d hardware unit
//    +16  ... device scope entries (skipped by extractor — R22.M4 records
//                                    the unit as (segment, register_base)
//                                    only; scope binding is R23+ work).
//
// -----------------------------------------------------------------------------
// drhd_entry storage record (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//     +0  u8  flags               DRHD flags byte verbatim
//     +1  u8  _pad0
//     +2  u16 segment             PCI-segment-group this unit covers
//     +4  u32 _pad1
//     +8  u64 register_base       MMIO base (VT-d register set anchor)
//    +16  u64 _reserved0          reserved for R23 device-scope pointer
//    +24  u64 _reserved1          reserved for R23 refcount / ioremap slot
//    +32  end
//
// -----------------------------------------------------------------------------
// Storage model
// -----------------------------------------------------------------------------
//
// A caller-provided output array + a canonical static slot
// (_dmar_drhds[8], _dmar_drhd_count) mirror the mcfg.pdx pattern.
// R22.M5 wire-up will invoke `dmar_parse_drhds(dmar, _dmar_drhds, 8)`
// once has_dmar is set in phase1_acpi_info. Until then the .bss zero
// state (_dmar_drhd_count = 0) is a valid "no DRHDs discovered" signal.
//
// 8 DRHDs covers every consumer/server board shipped through 2026 —
// typical desktop platforms publish 1..2, dual-socket Xeon/EPYC 2..4,
// 4-socket 4..8. Beyond that, silently drops.
//
// -----------------------------------------------------------------------------
// Wire-up posture (R22.M4 close)
// -----------------------------------------------------------------------------
//
// `dmar_parse_drhds` is DEFINED and LINKED but NOT CALLED from
// kernel_main at R22.M4 close. The link-side existence of the symbol
// is the M4 acceptance witness. R22.M5 will (a) add a DMAR branch to
// phase1_acpi_gather that sets has_dmar = 1 on checksum success, and
// (b) invoke dmar_parse_drhds from an IOMMU bring-up path that
// short-circuits on has_dmar == 0.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 stores.
//   G4: cmp al, imm may miscompile → full-register compares.
//   Reserved labels (`loop`, `if`, `next`) avoided via `dmar_walk_*` prefix.

module Dmar = structure {

  // ============================================================================
  // Layout constants — DMAR header
  // ============================================================================

  pub let DMAR_OFFSET_HAW               : u64 = 36
  pub let DMAR_OFFSET_FLAGS             : u64 = 37
  pub let DMAR_OFFSET_RESERVED          : u64 = 38
  pub let DMAR_OFFSET_SUBSTRUCTURES     : u64 = 48

  pub let DMAR_FLAG_INTR_REMAP          : u64 = 0x01
  pub let DMAR_FLAG_X2APIC_OPT_OUT      : u64 = 0x02

  // ============================================================================
  // Layout constants — sub-structure TLV
  // ============================================================================

  pub let DMAR_SUB_OFFSET_TYPE          : u64 = 0
  pub let DMAR_SUB_OFFSET_LENGTH        : u64 = 2

  pub let DMAR_TYPE_DRHD                : u64 = 0
  pub let DMAR_TYPE_RMRR                : u64 = 1
  pub let DMAR_TYPE_ATSR                : u64 = 2
  pub let DMAR_TYPE_RHSA                : u64 = 3
  pub let DMAR_TYPE_ANDD                : u64 = 4
  pub let DMAR_TYPE_SATC                : u64 = 5

  // ============================================================================
  // Layout constants — DRHD body
  // ============================================================================

  pub let DRHD_OFFSET_FLAGS             : u64 = 4
  pub let DRHD_OFFSET_SIZE              : u64 = 5
  pub let DRHD_OFFSET_SEGMENT           : u64 = 6
  pub let DRHD_OFFSET_REGISTER_BASE     : u64 = 8

  pub let DRHD_FLAG_INCLUDE_PCI_ALL     : u64 = 0x01

  // ============================================================================
  // Layout constants — drhd_entry storage record
  // ============================================================================

  pub let DRHD_ENTRY_SIZE               : u64 = 32

  pub let DRHD_ENTRY_OFFSET_FLAGS         : u64 = 0
  pub let DRHD_ENTRY_OFFSET_SEGMENT       : u64 = 2
  pub let DRHD_ENTRY_OFFSET_REGISTER_BASE : u64 = 8

  pub let DMAR_MAX_DRHDS                : u64 = 8

  // ============================================================================
  // Canonical static slot — populated by R22.M5 wire-up (phase1_gather
  // extension). Until then, .bss zero state means "no DRHDs discovered".
  // ============================================================================
  //
  //   _dmar_drhds        : 8 × 32 B = 256 B = 32 × u64
  //   _dmar_drhd_count   : entries populated by the last dmar_parse_drhds call

  pub let mut _dmar_drhds      : [u64; 32] = uninit @align(8)
  pub let mut _dmar_drhd_count : u64       = 0

  // ============================================================================
  // dmar_parse_drhds — extract Type-0 (DRHD) sub-structures
  // ============================================================================
  //
  // SysV: (dmar: u64, out_arr: u64, max: u64) -> u64
  //
  //   rdi = DMAR base (a valid *sdt_hdr with signature "DMAR"; caller
  //         MUST have checksum-validated it via acpi_checksum_ok).
  //   rsi = out array (caller-allocated [drhd_entry; max], 32-byte records).
  //   rdx = max — capacity ceiling; DRHDs past this cap are silently
  //         dropped (no drop counter — 8 DRHDs covers every board
  //         through 2026; overflow means either a spec-violating fake
  //         or a caller under-provisioned buffer).
  //
  // Returns rax = number of DRHDs written to out_arr.
  //
  // Iteration: cursor starts at DMAR+48 (DMAR_OFFSET_SUBSTRUCTURES),
  // advances by sub-structure length per iteration, stops when cursor+4
  // > DMAR+DMAR.length. Non-DRHD sub-structures are silently skipped
  // via the length-prefixed walk — their bodies are never dereferenced.
  //
  // Register plan (5-push callee-save prologue):
  //   Prologue: push rbx, r12, r13, r14, r15 (+40 → rsp%16==0 in body).
  //   r12 = DMAR base           (arg0)
  //   rbx = out array base       (arg1)
  //   r8  = max cap              (arg2)
  //   r13 = end of table         (= DMAR + DMAR.length)
  //   r14 = cursor               (advances by sub.length)
  //   r15 = matching-count       (return value)

  pub let dmar_parse_drhds : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dmar: u64, out_arr: u64, max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R22-M4-001 (#861). DMAR Type-0 (DRHD) sub-structure extractor. Walks the variable-length TLV stream at dmar+DMAR_OFFSET_SUBSTRUCTURES (48) up to dmar+dmar->length. Per iteration: (a) bounds-guard 4 bytes for the (type, length) header; (b) zero-extend-load type (u16 @ +0) and length (u16 @ +2) via xor+mov_w; (c) reject length<4 (would infinite-loop) or cursor+length>end (truncated malformed entry) — both bail cleanly returning the count-so-far; (d) if type == DMAR_TYPE_DRHD (0): if count < max, extract flags (u8 @ +4), segment (u16 @ +6), register_base (u64 @ +8) — u64 at offset 8 from a cursor that started at DMAR+48 lands at an 8-aligned host address; x86-64 tolerates unaligned qword loads per SDM Vol 3A §7.1.1 regardless (same posture as mcfg.pdx L109). Write into the 32-byte out record: flags u8 @ +0 via mov_b, segment u16 @ +2 via mov_w, u32 _pad1 @ +4 zero via mov_d (G1), register_base u64 @ +8 via plain mov, u64 _reserved0 @ +16 zero, u64 _reserved1 @ +24 zero. Advance cursor by length regardless of type match — this is the mechanism by which non-DRHD records (RMRR, ATSR, RHSA, ANDD, SATC) are skipped without dereferencing their bodies beyond the 4-byte header. Silent-drop past max — no counter; DRHDs > 8 means either fake firmware or a broken caller and is worth an out-of-band assertion but not a runtime counter. Full-register compares (G4). Leaf function; 5-push callee-save prologue matches madt_parse_lapics / mcfg_parse_segments for review-symmetry even though no nested call needs the alignment.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Save args ----
        mov r12, rdi;                          // r12 = dmar base
        mov rbx, rsi;                          // rbx = out base
        mov r8,  rdx;                          // r8  = max

        // ---- end = dmar + dmar->length (u32 @ +4, zero-extended) ----
        xor rax, rax;
        mov eax, [r12 + 4];
        mov r13, r12;
        add r13, rax;

        // ---- cursor = dmar + 48 ----
        mov r14, r12;
        add r14, 48;

        // ---- count = 0 ----
        xor r15, r15;

      dmar_walk_loop:
        // Need at least 4 bytes for (type u16, length u16).
        mov rax, r14;
        add rax, 4;
        cmp rax, r13;
        ja  dmar_walk_done;

        // type = *(u16*)(cursor+0)
        xor rcx, rcx;
        mov_w rcx, [r14 + 0];

        // length = *(u16*)(cursor+2)
        xor rdx, rdx;
        mov_w rdx, [r14 + 2];

        // length < 4 → malformed; bail rather than loop forever.
        cmp rdx, 4;
        jb  dmar_walk_done;

        // cursor + length > end → truncated; bail.
        mov rax, r14;
        add rax, rdx;
        cmp rax, r13;
        ja  dmar_walk_done;

        // Type dispatch. DMAR_TYPE_DRHD = 0.
        cmp rcx, 0;
        jne dmar_walk_advance;

        // Capacity check — silently drop past max.
        cmp r15, r8;
        jae dmar_walk_advance;

        // out_slot = out + count * 32
        mov rax, r15;
        shl rax, 5;                            // count * 32
        mov r9,  rbx;
        add r9,  rax;

        // flags (u8 @ cursor+4) → u8 @ out+0
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov_b [r9 + 0], rax;

        // _pad0 (u8 @ out+1) = 0
        xor rax, rax;
        mov_b [r9 + 1], rax;

        // segment (u16 @ cursor+6) → u16 @ out+2
        xor rax, rax;
        mov_w rax, [r14 + 6];
        mov_w [r9 + 2], rax;

        // _pad1 (u32 @ out+4) = 0 — G1 sized store
        xor rax, rax;
        mov_d [r9 + 4], rax;

        // register_base (u64 @ cursor+8) → u64 @ out+8
        mov rax, [r14 + 8];
        mov [r9 + 8], rax;

        // _reserved0 (u64 @ out+16) = 0
        xor rax, rax;
        mov [r9 + 16], rax;

        // _reserved1 (u64 @ out+24) = 0
        xor rax, rax;
        mov [r9 + 24], rax;

        add r15, 1;

      dmar_walk_advance:
        // Advance cursor by length (rdx holds it).
        add r14, rdx;
        jmp dmar_walk_loop;

      dmar_walk_done:
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
