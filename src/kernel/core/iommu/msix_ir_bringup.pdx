// src/kernel/core/iommu/msix_ir_bringup.pdx — R111.M2-007 (paideia-os #2359)
//
// MSI-X + VT-d Interrupt Remapping (IR) real-HW baseline bring-up.
//
// The R111.M2 wave (design/roadmap/t14-bootable-usb-wave.md §4.B) opens
// paideia-os to real hardware — starting with a Lenovo T14 G4 running
// Raptor Lake client silicon. Raptor Lake REQUIRES IR-mode MSI-X for
// x2APIC reliability (SDM Vol 3A §10.12.7 + VT-d 4.0 §5): bare MSI-X
// without IR is where the "phantom IRQ" class of long-standing Linux
// bugs originally lived.  Prior to R111.M2, the paideia-os R21.M4
// (MSI-X) and R22.M4/M5 (DMAR + IR) substrates existed as symbols but
// were not wired into kernel_main — this file lands the wire-in.
//
// -----------------------------------------------------------------------------
// Bring-up sequence
// -----------------------------------------------------------------------------
//
//   msix_ir_bringup_all() runs once from kernel_main_64 after
//   phase1_acpi_gather (populates has_dmar + _dmar_drhds) and after
//   pci_publish_caps (populates _pci_devices records). Sequence:
//
//     (a) Read has_dmar from _phase1_acpi_info + PHASE1_OFFSET_HAS_DMAR
//         (=147). 0 means the platform has no VT-d ACPI report at all
//         (QEMU-TCG default; older platforms) → fingerprint `MSIX IR
//         OFF`, _msix_ir_active stays 0, done.
//
//     (b) Read _dmar_drhd_count. 0 means the DMAR table is present but
//         has no DRHD entries — spec-legal but useless for us → same
//         fallback as (a).
//
//     (c) Call vtd_ir_init(_dmar_drhds[0].register_base). Reads the
//         first DRHD's MMIO base at offset 8 within the 32-byte
//         drhd_entry record (per Dmar.DRHD_ENTRY_OFFSET_REGISTER_BASE
//         = 8). vtd_ir_init allocates a 4 KiB IRT page, zero-fills 256
//         IRTEs, programs IRTA_REG with (PA | EIME | S=7), issues
//         SIRTP + IRE, and polls GSTS.IRTPS / GSTS.IRES. Returns the
//         IRT PA on success, 0 on OOM. OOM → fallback.
//
//     (d) On success: fingerprint `MSIX IR TABLE OK entries=256`,
//         _msix_ir_active = 1.
//
// -----------------------------------------------------------------------------
// Per-device MSI-X programming
// -----------------------------------------------------------------------------
//
//   msix_ir_program_device(seg, bus, dev, fn, num_vec) programs
//   `num_vec` MSI-X entries on the caller-named function, dispatching
//   through the IR path when _msix_ir_active != 0 and through the
//   direct-APIC path otherwise. Per vector emits one line:
//
//     `MSIX VEC OK` bdf=<b:d.f-packed> vec=<v> addr=<msg_addr_lo>
//                   irt=<slot|0xFFFF>
//
//   Where irt=0xFFFF marks the direct-APIC route (no IR indirection).
//   bdf packs as (bus << 8) | (dev << 3) | fn — the PCI-canonical
//   16-bit key. msg_addr is read back from the MSI-X table entry's
//   msg_addr_lo dword after programming (byte-level verification that
//   the mov_d G1-sized store actually landed).
//
//   Round-robins cpu_idx across 0..3 to spread interrupts (matches the
//   R21.M4 msix_round_robin witness discipline).
//
// -----------------------------------------------------------------------------
// Fallback fingerprint semantics
// -----------------------------------------------------------------------------
//
//   `MSIX IR OFF` — VT-d absent, malformed, or exhausted. Documented
//                   behavior: MSI-X is still delivered, but via direct
//                   APIC (no IRT indirection). Fires on every QEMU-TCG
//                   -kernel boot and is the assertable signal in the
//                   default matrix; asserted by an R111-era golden.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.36+)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores (used
//       transitively via msix_program_entry / msix_program_entry_via_ir).
//   G4: full-register compares (cmp reg,imm never on 8-bit slice).
//   No test rN,rN. No 2-op `imul r,imm`. No `and reg, imm64`.
//   Reserved-label prefix `mibr_` on every local label to avoid
//   `loop`, `if`, `next` collision.

module MsixIrBringup = structure {

  // ============================================================================
  // Canonical static slot — the IR-active flag every MSI-X programming
  // consumer reads through msix_ir_is_active().
  // ============================================================================
  //
  //   0 = VT-d IR not up (direct-APIC MSI-X path)
  //   1 = VT-d IR up (IRT-routed MSI-X path)
  //
  // Bumps once at bring-up. Never resets during the life of a boot.

  pub let mut _msix_ir_active : u64 = 0

  // ============================================================================
  // msix_ir_is_active — accessor for downstream driver-attach code
  // ============================================================================
  //
  // SysV: () -> u64
  //
  // Returns rax = _msix_ir_active (0 or 1). Leaf, no callee-save.
  //
  // Placement rationale: every future driver that programs MSI-X
  // (e1000e, xhci, nvme, virtio-net, ...) dispatches through this
  // accessor rather than reading the .bss slot directly, so a later
  // policy shift (e.g. per-DRHD IR gating for multi-socket boards)
  // is a signature change here rather than a fan-out edit.

  pub let msix_ir_is_active : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M2-007 (paideia-os #2359). Accessor for _msix_ir_active. Reads the u64 slot into rax. Leaf function; no callee-save touched; no stack use. Encoder: single mov rip-relative + ret — both pre-#2359 proven.",
      block: {
        mov rax, [rip + _msix_ir_active];
        ret
      }
    }

  // ============================================================================
  // msix_ir_bringup_all — DMAR presence check + IRT init + fingerprint
  // ============================================================================
  //
  // SysV: () -> u64
  //
  // Returns rax = 1 iff VT-d IR is now active (fingerprint `MSIX IR
  // TABLE OK entries=<n>` fired), 0 otherwise (fingerprint `MSIX IR
  // OFF` fired).
  //
  // Register plan (2-push callee-save):
  //   Prologue: push rbx (base ptr), r12 (drhd entry ptr) → +16 B.
  //   Entry rsp%16==8; 2 pushes → rsp%16==8 (16 % 16 = 0 change).
  //   sub rsp, 8 for pre-align → rsp%16==0 at every nested call.
  //   Total decrement: 24 B.

  pub let msix_ir_bringup_all : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M2-007 (paideia-os #2359). VT-d IR bring-up orchestrator. Body: (1) 2-push callee-save prologue + sub rsp,8 pre-align. Entry rsp%16==8; 2 pushes = 16 B (0 parity change) → rsp%16==8; sub 8 → rsp%16==0 for nested calls. (2) Read has_dmar (u8 @ _phase1_acpi_info + PHASE1_OFFSET_HAS_DMAR=147) via mov_b + and 0xff. If 0, jump to mibr_off. (3) Read _dmar_drhd_count (u64). If 0, mibr_off. (4) Compute &_dmar_drhds[0].register_base via lea + DRHD_ENTRY_OFFSET_REGISTER_BASE(=8). Load register_base u64. (5) Call vtd_ir_init(base). rax = IRT PA (nonzero on success, 0 on OOM). Cmp 0 → jump mibr_off. (6) Success path: mov rax,1; store to _msix_ir_active. Emit klog_s1_d1(INFO, IOMM, tag_msix_ir_table_ok, k_entries, VTD_IRT_ENTRIES=256). Return 1. (7) Fallback (mibr_off): store 0 to _msix_ir_active (defensive, already zero). Emit klog_s1(INFO, IOMM, tag_msix_ir_off). Return 0. Encoder: mov / mov_b / and / cmp / je / jne / lea / call / xor / ret — all pre-existing. No `test rN,rN`, no `and reg,imm64`, no 2-op imul.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // ---- (2) Read has_dmar (u8 @ _phase1_acpi_info + 147) ----
        lea rbx, [rip + _phase1_acpi_info];
        xor rax, rax;
        mov_b rax, [rbx + 147];               // PHASE1_OFFSET_HAS_DMAR
        and rax, 0xff;
        cmp rax, 0;
        je  mibr_off;

        // ---- (3) Read _dmar_drhd_count ----
        mov rax, [rip + _dmar_drhd_count];
        cmp rax, 0;
        je  mibr_off;

        // ---- (4) &_dmar_drhds[0].register_base (u64 @ offset 8) ----
        lea r12, [rip + _dmar_drhds];
        mov rdi, [r12 + 8];                   // DRHD_ENTRY_OFFSET_REGISTER_BASE
        cmp rdi, 0;
        je  mibr_off;

        // ---- (5) vtd_ir_init(base) ----
        call vtd_ir_init;
        cmp rax, 0;
        je  mibr_off;

        // ---- (6) Success: latch active + emit MSIX IR TABLE OK ----
        mov rax, 1;
        mov [rip + _msix_ir_active], rax;

        // klog_s1_d1(LEVEL_INFO=3, SUBSYS_IOMM, tag_msix_ir_table_ok,
        //            k_entries, VTD_IRT_ENTRIES=256)
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_msix_ir_table_ok];
        lea rcx, [rip + k_entries];
        mov r8,  256;                          // VTD_IRT_ENTRIES
        call klog_s1_d1;

        mov rax, 1;
        jmp mibr_done;

      mibr_off:
        // Defensive: reset _msix_ir_active in case of partial-init retry.
        xor rax, rax;
        mov [rip + _msix_ir_active], rax;

        // klog_s1(LEVEL_INFO, SUBSYS_IOMM, tag_msix_ir_off)
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_msix_ir_off];
        call klog_s1;

        xor rax, rax;

      mibr_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // msix_ir_program_device — program N MSI-X vectors on one PCI function
  // ============================================================================
  //
  // SysV: (seg: u64, bus: u64, dev: u64, fn: u64, num_vec: u64) -> u64
  //
  //   rdi = segment (u16)
  //   rsi = bus (u8)
  //   rdx = dev (u8)
  //   rcx = fn (u8)
  //   r8  = num_vec (bounded by device MSI-X table_size AND MSIX_ASSIGN_MAX
  //         and by _msix_bringup_scratch_max=32 for the local table_info
  //         window; callers pass 1..32).
  //
  // Returns rax = number of vectors successfully programmed (0 if the
  // function has no MSI-X cap or the BAR mapping failed).
  //
  // Per vector fingerprint:
  //   `MSIX VEC OK` bdf=<packed>, vec=<v>, addr=<msg_addr_lo>, irt=<slot>
  //
  // Register plan (6-push callee-save + sub rsp,64 for scratch slots):
  //   Entry rsp%16==8; 6 pushes (48 B) → rsp%16==8; sub 64 → rsp%16==8;
  //   +8 more align → sub 72. Rounded: sub rsp,72 → 8+48+72 = 128, %16=0.
  //
  //   Scratch:
  //     [rsp + 0..23]   msix_table_info record (24 B — see msix.pdx §L59)
  //     [rsp + 24]      loop index i
  //     [rsp + 32]      cpu_idx round-robin cursor (0..3)
  //     [rsp + 40]      assigned vector (per iteration)
  //     [rsp + 48]      msg_addr_lo readback
  //     [rsp + 56]      irt slot (from _msix_assignments tail or 0xFFFF)
  //     [rsp + 64]      pad

  pub let msix_ir_program_device : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, fn: u64, num_vec: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M2-007 (paideia-os #2359). Per-device MSI-X vector programmer dispatching through the IR path when _msix_ir_active != 0. Body: (1) 6-push callee-save prologue + sub rsp,72 for a 24-B msix_table_info record and per-iteration scratch. Entry rsp%16==8; 6 pushes = 48 B (no parity change); sub 72 → 8+48+72=128, %16=0 (aligned for nested calls). (2) Stash args in callee-save: r12=seg, r13=bus, r14=dev, r15=fn, rbx=num_vec, rbp=loop-index reset holder (used as scratch during loop). (3) Call msix_map_table(seg, bus, dev, fn, &table_info=[rsp+0]) → rax. If 0 (MSI-X cap not found), skip to done with rax=0. (4) Load table_pa from [rsp+0] (u64 @ +0 of table_info). Load table_size from [rsp+8] (u16 @ +8, but the record's u16 slot; extract via xor+mov_w). (5) Cap num_vec ≤ table_size. If num_vec > table_size, set num_vec = table_size. Store [rsp+24]=0 (i), [rsp+32]=0 (cpu_idx cursor). (6) Loop mibr_pd_top: cmp i,num_vec; jae mibr_pd_epilogue. (7) Per iteration: (7a) Read cpu_idx from [rsp+32]; compute vector via IR- or direct-path assign. Dispatch on msix_ir_is_active(): if rax != 0 → msix_assign_at_ir(table_pa, bus, dev, fn, entry_idx=i, cpu_idx=cpu_idx); else msix_assign_at(...). Both return u64 vector (or 0xFF on exhausted). Save at [rsp+40]. (7b) Read back msg_addr_lo from table entry: entry_pa = table_pa + i*16; addr_lo = *(u32*)(entry_pa + 0). Load via xor rax,rax; mov_d then variable-width — actually mov_d is a *store* mnemonic in paideia-as; the load path uses `mov eax, [mem]` which zero-extends into rax per x86-64 semantics. Save at [rsp+48]. (7c) Compute irt slot: on IR-active path the R21.M4 msix_assignments ledger doesn't carry the handle, so use the vector-pool convention: read _vtd_ir_next_handle post-assign to derive last handle = (_vtd_ir_next_handle - 1) — the bump-alloc convention lets us reconstruct without extending msix_assign_at_ir's return value. On direct-APIC path, irt = 0xFFFF (sentinel). Save at [rsp+56]. (7d) Compute bdf_packed = (bus << 8) | (dev << 3) | fn. (7e) Emit klog_s1_x4(INFO, IOMM, tag_msix_vec_ok, k_bdf, bdf_packed, k_vec, vector, k_addr, addr_lo, k_irt, irt_slot). klog_s1_x4 is limited to 6 register args; caller pushes v2=vector, k3=k_addr, v3=addr_lo, k4=k_irt, v4=irt_slot on the stack in reverse before the call. (7f) Bump i, cpu_idx round-robin. Loop. (8) Epilogue: mov rax,i; teardown; ret. All nested calls occur at rsp%16==0. Encoder: mov / mov_b (readback) / xor / cmp / jae / je / jne / call / lea / shl / or / and / push / pop / ret — all pre-existing. No `test rN,rN`, no `imul r,imm` (2-op), no `and reg,imm64`, no `cmp reg, [mem]` (all cmps are reg-to-reg or reg-to-imm8/imm32).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 72;

        // ---- (2) Stash args ----
        mov r12, rdi;                          // seg
        mov r13, rsi;                          // bus
        mov r14, rdx;                          // dev
        mov r15, rcx;                          // fn
        mov rbx, r8;                           // num_vec

        // ---- (3) msix_map_table(seg, bus, dev, fn, &table_info) ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        lea r8,  [rsp + 0];                    // &msix_table_info
        call msix_map_table;

        cmp rax, 0;
        je  mibr_pd_no_cap;

        // ---- (4) table_pa = [rsp+0]; table_size = [rsp+8] (u16 slot) ----
        // We keep table_pa live in a callee-save reg across the loop.
        // rbp = table_pa (kept for the whole loop body).
        mov rbp, [rsp + 0];

        // Load u16 table_size at [rsp+8]. mov_w-load form is:
        //   xor rax,rax; mov_w rax, [rsp+8]  (zero-extend load)
        xor rax, rax;
        mov_w rax, [rsp + 8];
        // rax = table_size

        // ---- (5) Cap num_vec ≤ table_size ----
        cmp rbx, rax;
        jbe mibr_pd_cap_ok;
        mov rbx, rax;                          // clamp

      mibr_pd_cap_ok:
        // Initialize loop index and cpu round-robin cursor.
        xor rax, rax;
        mov [rsp + 24], rax;                   // i = 0
        mov [rsp + 32], rax;                   // cpu_idx = 0

      mibr_pd_top:
        // ---- (6) Loop guard: while i < num_vec ----
        mov rax, [rsp + 24];
        cmp rax, rbx;
        jae mibr_pd_epilogue;

        // ---- (7a) Dispatch: msix_assign_at_ir OR msix_assign_at ----
        call msix_ir_is_active;
        cmp rax, 0;
        je  mibr_pd_direct;

        // IR-active path: msix_assign_at_ir(table_pa, bus, dev, fn,
        //                                    entry_idx=i, cpu_idx)
        mov rdi, rbp;                          // table_pa
        mov rsi, r13;                          // bus
        mov rdx, r14;                          // dev
        mov rcx, r15;                          // fn
        mov r8,  [rsp + 24];                   // entry_idx = i
        mov r9,  [rsp + 32];                   // cpu_idx
        call msix_assign_at_ir;
        jmp mibr_pd_assign_done;

      mibr_pd_direct:
        // Direct-APIC path: msix_assign_at(table_pa, bus, dev, fn,
        //                                   entry_idx=i, cpu_idx)
        mov rdi, rbp;                          // table_pa
        mov rsi, r13;                          // bus
        mov rdx, r14;                          // dev
        mov rcx, r15;                          // fn
        mov r8,  [rsp + 24];                   // entry_idx = i
        mov r9,  [rsp + 32];                   // cpu_idx
        call msix_assign_at;

      mibr_pd_assign_done:
        // rax = allocated vector (or 0xFF on exhaustion of vector pool
        //       OR IR handle pool).  On exhaustion we bail the whole
        //       loop -- emitting `MSIX VEC OK` with a stale IRT slot
        //       would confuse the fingerprint audit, and every
        //       subsequent iteration would keep hitting the same
        //       exhaustion.  The count already-programmed is returned
        //       via the epilogue.
        cmp rax, 0xFF;
        je  mibr_pd_epilogue;
        mov [rsp + 40], rax;                   // save vector

        // ---- (7b) Read back msg_addr_lo from the table entry ----
        //   entry_pa = table_pa + i*16
        mov rax, [rsp + 24];                   // i
        shl rax, 4;                            // i*16
        add rax, rbp;                          // rax = entry_pa
        // addr_lo = *(u32*)(entry_pa + 0)  — MSIX_ENT_ADDR_LO=0.
        // Zero-extending 32-bit load lands in rax via the 32-bit
        // register alias (x86-64 auto-zero-extend semantic).
        xor rcx, rcx;
        mov ecx, [rax + 0];
        mov [rsp + 48], rcx;                   // save addr_lo

        // ---- (7c) Compute irt slot ----
        // Direct path → irt = 0xFFFF sentinel.
        // IR path     → last handle = _vtd_ir_next_handle - 1
        //               (the bump-alloc convention in vtd_ir.pdx).
        call msix_ir_is_active;
        cmp rax, 0;
        je  mibr_pd_irt_direct;

        mov rax, [rip + _vtd_ir_next_handle];
        cmp rax, 0;
        je  mibr_pd_irt_direct;                // defensive: shouldn't happen
        sub rax, 1;
        mov [rsp + 56], rax;
        jmp mibr_pd_irt_done;

      mibr_pd_irt_direct:
        mov rax, 0xFFFF;                       // no IR indirection
        mov [rsp + 56], rax;

      mibr_pd_irt_done:
        // ---- (7d) Pack bdf_packed = (bus<<8) | (dev<<3) | fn ----
        mov rax, r13;                          // bus
        and rax, 0xff;
        shl rax, 8;
        mov rcx, r14;                          // dev
        and rcx, 0x1f;
        shl rcx, 3;
        or  rax, rcx;
        mov rcx, r15;                          // fn
        and rcx, 0x07;
        or  rax, rcx;                          // rax = bdf_packed

        // ---- (7e) Emit fingerprint via klog_s1_x4 ----
        //   klog_s1_x4(level=3, subsys=SUBSYS_IOMM, tag=tag_msix_vec_ok,
        //              k1=k_bdf, v1=bdf_packed,
        //              k2=k_vec, v2=vector,
        //              k3=k_addr, v3=addr_lo,
        //              k4=k_irt, v4=irt_slot)
        //
        // klog_s1_x4 signature carries the first 3 KV entries in regs
        // and expects v2, k3, v3, k4, v4 pushed on the stack in the
        // order below (see core/klog/wrappers.pdx L165-171).  The
        // caller pushes them right-to-left so [rsp+8] resolves to v2,
        // [rsp+16] to k3, [rsp+24] to v3, [rsp+32] to k4, [rsp+40] to
        // v4 after the call instruction pushes the return address.
        //
        // Stack invariant across this emit: post 6-push+sub72 our rsp
        // is aligned to 16 bytes (32 % 16 = 0? — 6*8+72=120, +8 entry
        // pad = 128; 128 % 16 = 0). Push 5 extra 8-byte values → 128 +
        // 40 = 168; %16 = 8. We need %16=0 before the call, so pre-pad
        // with sub rsp,8 → 176, %16=0. After call, add rsp,48 (5*8 + 8
        // pad).
        sub rsp, 8;                            // pre-align pad
        // Push v4 = irt (was [rsp+56 pre-sub] = [rsp+64 post-sub]).
        mov rax, [rsp + 64];
        push rax;
        // Push k4 = k_irt.
        lea rax, [rip + k_irt];
        push rax;
        // Push v3 = addr_lo (was [rsp+48 pre-sub] = [rsp+56 post-sub];
        // now offset increased by 2 push × 8 = +16 → [rsp+72]).
        mov rax, [rsp + 72];
        push rax;
        // Push k3 = k_addr.
        lea rax, [rip + k_addr];
        push rax;
        // Push v2 = vector (was [rsp+40 pre-sub] = [rsp+48 post-sub];
        // now offset increased by 4 push × 8 = +32 → [rsp+80]).
        mov rax, [rsp + 80];
        push rax;

        // v1 = bdf_packed (in rax before pushes; we clobbered it).
        // Recompute (cheap): bdf_packed lives in no other reg — redo.
        mov rax, r13; and rax, 0xff; shl rax, 8;
        mov rcx, r14; and rcx, 0x1f; shl rcx, 3;
        or  rax, rcx;
        mov rcx, r15; and rcx, 0x07;
        or  rax, rcx;                          // rax = bdf_packed

        // Load klog_s1_x4 arg regs:
        //   rdi = level  = 3
        //   rsi = subsys = &SUBSYS_IOMM
        //   rdx = tag    = &tag_msix_vec_ok
        //   rcx = k1     = &k_bdf
        //   r8  = v1     = bdf_packed (rax)
        //   r9  = k2     = &k_vec
        //   [rsp+8]=v2 = vector      (already staged via push above)
        //   [rsp+16]=k3 = k_addr     (staged)
        //   [rsp+24]=v3 = addr_lo    (staged)
        //   [rsp+32]=k4 = k_irt      (staged)
        //   [rsp+40]=v4 = irt        (staged)
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_msix_vec_ok];
        lea rcx, [rip + k_bdf];
        mov r8,  rax;                          // v1 = bdf_packed
        lea r9,  [rip + k_vec];
        call klog_s1_x4;

        // Restore stack: 5 pushes + pre-align pad = 48 B.
        add rsp, 48;

        // ---- (7f) Bump i and round-robin cpu_idx ----
        mov rax, [rsp + 24];
        add rax, 1;
        mov [rsp + 24], rax;

        // cpu_idx = (cpu_idx + 1) & 3  — round-robin across 4 CPUs.
        mov rax, [rsp + 32];
        add rax, 1;
        and rax, 3;
        mov [rsp + 32], rax;

        jmp mibr_pd_top;

      mibr_pd_no_cap:
        // MSI-X cap not found — nothing to program.
        xor rax, rax;
        jmp mibr_pd_done;

      mibr_pd_epilogue:
        // rax = i = number of vectors programmed.
        mov rax, [rsp + 24];

      mibr_pd_done:
        add rsp, 72;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
