// src/kernel/core/iommu/vtd_fault.pdx — R22-M4-005 (#865)
//
// VT-d DMA-fault handler. The VT-d hardware unit logs faults into an
// on-chip ring of Fault Recording Registers (FRRs) and signals the OS
// via a dedicated MSI (programmed through FEDATA/FEADDR/FEUADDR).
// This module provides the FRR drain routine — the IDT wire-up + MSI
// vector allocation are R23 territory (per-CPU vector allocation is
// R22.M5+ scope; MSI routing to a specific CPU + IDT install is R23).
//
// -----------------------------------------------------------------------------
// FSTS bits (VT-d 4.0 Table 11-13)
// -----------------------------------------------------------------------------
//
//   bit 0    PFO   Primary Fault Overflow (write-1-to-clear)
//   bit 1    PPF   Primary Pending Fault  (asserted while any FRR.F is set)
//   bit 2    AFO   Advanced Fault Overflow
//   bit 3    APF   Advanced Pending Fault
//   bit 4    IQE   Invalidation Queue Error
//   bit 5    ICE   Invalidation Completion Error
//   bit 6    ITE   Invalidation Time-out Error
//   bits 8..15  FRI  Fault Record Index (of first pending record)
//
// -----------------------------------------------------------------------------
// Fault Recording Register (FRR) layout (VT-d 4.0 Table 11-15)
// -----------------------------------------------------------------------------
//
// Each FRR is 128 bits (16 bytes), living at register offset:
//
//   frr_base = base + FRO*16    where FRO = (CAP >> 24) & 0x3FF
//
// Layout (qword[0] = low 64, qword[1] = high 64):
//
//   qword[0]:
//     bits 0..63    FI (Fault Info; typically the faulting IOVA)
//
//   qword[1]:
//     bits 0..11    SID (Source Identifier = BDF16: bus<<8 | dev<<3 | fn)
//     bits 12..31   reserved
//     bits 32..47   FR (Fault Reason)  — VT-d Table 11-16 fault codes
//     bit 62        AT (Address Type)  — 00=UT, 01=TR, 10=T
//     bit 63        F  (Fault; write-1-to-clear the record)
//
// The FRR ring is a circular queue of NFR (Number of Fault-recording
// Registers) records, where NFR = ((CAP >> 40) & 0xFF) + 1. Software
// drains by walking records, emitting fingerprints per set F bit,
// then writing 1 to bit 63 to clear.
//
// -----------------------------------------------------------------------------
// R22.M4 scope
// -----------------------------------------------------------------------------
//
//   (a) Read FSTS. If PPF (bit 1) is clear → emit "VTD FAULT HANDLER
//       OK" and return 0.
//   (b) Otherwise: derive FRO + NFR from CAP.
//   (c) Walk NFR records — for each with F=1, write-1-to-clear the F
//       bit and increment drained_count.
//   (d) Clear FSTS.PPF by RW1C.
//   (e) Emit klog_s1_d1(INFO, IOMM, tag_vtd_fault, k_n, drained_count).
//   (f) Return drained_count.
//
// The rich per-fault dump (bdf / reason / iova via klog_s1_x4) is
// deferred to R23 when the handler runs in an actual interrupt
// context — at M4 substrate close, drained-count fingerprint is the
// operational contract every downstream driver-code review needs.
//
// IDT wiring deferred: needs per-CPU vector allocation (R22.M5) +
// AP-side IDT install (R23). Once wired, the interrupt handler
// calls vtd_fault_dispatch(_vtd_base) after acknowledging the LAPIC.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 stores (used via
//       vtd_write_u32 helper — no direct MMIO here).
//   Reserved-label prefix `vtd_fault_*` avoids `loop`, `next`.

module VtdFault = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let VTD_FAULT_LOOP_BUDGET     : u64 = 256    // hardware NFR max per VT-d §11.4.10.1

  // ============================================================================
  // vtd_fault_dispatch — drain the FRR ring, emit fingerprint
  // ============================================================================
  //
  // SysV: (base: u64) -> u64
  //
  //   rdi = VT-d hardware unit MMIO base.
  //
  // Returns rax = number of faults drained (0 if no PPF; >=1 otherwise).
  //
  // NOT WIRED AT M4 BOOT.

  pub let vtd_fault_dispatch : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R22-M4-005 (#865). VT-d FRR ring drain + drained-count fingerprint. Body: (1) 5-push callee-save prologue (rbx=base, r12=frr_base_offset, r13=nfr, r14=drained_count, r15=iteration index i); rsp entry %16==8 → 5 pushes %16==0. (2) Read FSTS via vtd_read_u32(base, 0x34). If PPF (0x2) clear, emit klog_s1(INFO, IOMM, tag_vtd_fault_handler_ok) and return 0. (3) Read CAP via vtd_read_u64(base, 0x08). Extract FRO = (CAP >> 24) & 0x3FF (10-bit field); frr_base_offset = FRO * 16 (kept as offset-from-base since our accessors are offset-based). Extract NFR = ((CAP >> 40) & 0xFF) + 1; cap at 256 defensively. (4) Iterate i in 0..NFR: (a) qword[1] offset = frr_base_offset + i*16 + 8; call vtd_read_u64(base, offset). (b) Check bit 63 (F). If clear, continue. (c) Write qword[1] back with bit 63 set — vtd_write_u64(base, offset, 0x8000000000000000). Hardware clears the record on RW1C. (d) drained_count++. (5) After the loop, clear FSTS.PPF via vtd_write_u32(base, 0x34, 0x2). (6) Emit klog_s1_d1(INFO, IOMM, tag_vtd_fault, k_n, drained_count). (7) Return drained_count. Per-nested-call alignment: after 5 pushes %16==0, so nested calls are aligned without extra padding. Encoder: mov / call / and / shr / or / cmp / je / jae / add / lea — all pre-#865 proven. Deferred: rich per-fault dump (bdf/reason/iova via klog_s1_x4) — R23 IDT-handler-context scope.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // rbx = base
        xor r14, r14;                          // r14 = drained_count = 0

        // ---- (2) Read FSTS ----
        mov rdi, rbx;
        mov rsi, 0x34;                         // VTD_REG_FSTS
        call vtd_read_u32;

        mov r10, rax;
        and r10, 0x2;                          // PPF
        cmp r10, 0;
        jne vtd_fault_drain;

        // No PPF: emit OK and return 0.
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_vtd_fault_handler_ok];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      vtd_fault_drain:

        // ---- (3) Read CAP: derive FRO + NFR ----
        mov rdi, rbx;
        mov rsi, 0x08;                         // VTD_REG_CAP
        call vtd_read_u64;

        // FRO = (CAP >> 24) & 0x3FF  (10 bits; unit = 16 bytes)
        mov r10, rax;
        shr r10, 24;
        mov r11, 0x3FF;
        and r10, r11;
        shl r10, 4;                            // FRO * 16
        mov r12, r10;                          // r12 = frr_base_offset

        // NFR = ((CAP >> 40) & 0xFF) + 1
        mov r10, rax;
        shr r10, 40;
        mov r11, 0xFF;
        and r10, r11;
        add r10, 1;

        // Cap NFR at 256 defensively.
        mov r11, 256;
        cmp r10, r11;
        jbe vtd_fault_nfr_ok;
        mov r10, 256;
      vtd_fault_nfr_ok:
        mov r13, r10;                          // r13 = nfr

        xor r15, r15;                          // r15 = i = 0

      vtd_fault_walk:
        cmp r15, r13;
        jae vtd_fault_walk_done;

        // qword[1] offset = frr_base_offset + i*16 + 8
        mov rax, r15;
        shl rax, 4;
        add rax, r12;
        add rax, 8;
        mov r10, rax;                          // r10 = qword[1] offset

        mov rdi, rbx;
        mov rsi, r10;
        call vtd_read_u64;

        // Check bit 63 (F).
        mov r11, rax;
        shr r11, 63;
        cmp r11, 0;
        je  vtd_fault_walk_next;

        // Recompute qword[1] offset (r10 clobbered by call).
        mov r10, r15;
        shl r10, 4;
        add r10, r12;
        add r10, 8;

        // Write-1-to-clear F.
        mov rdi, rbx;
        mov rsi, r10;
        mov rdx, 0x8000000000000000;           // bit 63
        call vtd_write_u64;

        add r14, 1;

      vtd_fault_walk_next:
        add r15, 1;
        jmp vtd_fault_walk;

      vtd_fault_walk_done:

        // ---- (5) Clear FSTS.PPF (RW1C bit 1) ----
        mov rdi, rbx;
        mov rsi, 0x34;                         // VTD_REG_FSTS
        mov rdx, 0x2;                          // PPF
        call vtd_write_u32;

        // ---- (6) Emit klog_s1_d1(INFO, IOMM, tag_vtd_fault, k_n, drained_count) ----
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IOMM];
        lea rdx, [rip + tag_vtd_fault];
        lea rcx, [rip + k_n];
        mov r8,  r14;                          // drained_count
        call klog_s1_d1;

        // ---- (7) Return drained_count ----
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
