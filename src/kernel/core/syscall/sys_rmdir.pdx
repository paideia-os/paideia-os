// src/kernel/core/syscall/sys_rmdir.pdx -- R56.M3-004 (paideia-os #1793)
//
// SYS_RMDIR -- ring-3 rmdir syscall body + shim (sysno 80).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/kernel/vfs-metadata-syscalls.md and paideia-os R56.M3 milestone
// item R56.M3-004:
//
//   "sys_rmdir(path_ptr, path_len) -> i64. Path resolution then invoke
//    vop_rmdir on the parent vnode with the basename."
//
// This body is the near-identical twin of sys_mkdir_body (sibling file)
// with two differences: no `mode` arg (rmdir does not create), and the
// vops surface is vops_rmdir (VOPS_RMDIR_OFFSET=80, 3-arg) instead of
// vops_mkdir (VOPS_MKDIR_OFFSET=72, 4-arg).  Every other step -- path
// walk, split, resolve, backend dispatch, fingerprint emit -- follows
// the same shape.  See sys_mkdir.pdx §Composition for the step-by-step
// walk-through; only the vops dispatch (step 8) and the fingerprint tag
// (step 9) differ.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
//   0                            -- success
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- user_read_str_via_walk rejected buf
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- no '/' in path, empty basename,
//                                    missing root, or path_resolve
//                                    returned 0
//   0xFFFFFFFFFFFFFFFB (-EIO)    -- vops_rmdir returned a non-zero
//                                    backend errno (target-not-dir,
//                                    dir-not-empty, backend has no
//                                    wired rmdir body)
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// !{mem, sysreg} @{cap} -- identical to sys_mkdir_body's row (the two
// share the same walker + resolver + klog paths; only the vops slot
// changes).

module SysRmdir = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_RMDIR_OK          : u64 = 0
  pub let SYS_RMDIR_ERR_ENOENT  : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_RMDIR_ERR_EFAULT  : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYS_RMDIR_ERR_EIO     : u64 = 0xFFFFFFFFFFFFFFFB

  pub let SYS_RMDIR_PATH_MAX    : u64 = 256

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall path bounce scratch. Same discipline as
  // _sys_mkdir_path_scratch above and _sys_stat_path_scratch (sys_
  // stat.pdx L153). Single-flow at R56.M3-004; per-TCB migration is
  // a follow-up on the same wave that moves the sys_mkdir / sys_
  // stat / sys_getdents scratches into their per-TCB slabs.
  pub let mut _sys_rmdir_path_scratch : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_rmdir_body(path_va, path_len) -> u64
  //
  // SysV: rdi=path_va, rsi=path_len
  //   -> rax = 0 on success, or -EFAULT / -ENOENT / -EIO sentinel.
  //
  // Register plan (4-push callee-save):
  //   r12 = path_len (capped)   (dead post walker; kept for uniform
  //                              register recovery with the sibling)
  //   r13 = multi-role: path_va -> strlen -> root_idx
  //   r14 = basename_ptr
  //   r15 = basename_len
  //
  // Note: no rbx save needed here (rmdir has no `mode` to preserve
  // across the whole body -- the vops_rmdir args reduce to 3, and
  // basename_ptr / basename_len are enough). Prologue is 4 pushes.
  // Alignment: entry rsp%16==8, 4 pushes -> %16==8. Add `sub rsp, 8`
  // for the nested-call alignment (unlike sys_mkdir_body which uses
  // 5 pushes to naturally land at %16==0). This makes the epilogue
  // symmetric: add rsp, 8; 4 pops; ret.
  // ==========================================================================
  pub let sys_rmdir_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_va: u64) (path_len: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R56.M3-004 (#1793): sys_rmdir body -- ring-3 rmdir syscall (sysno 80). Near-identical to sys_mkdir_body (sibling file) with two differences: no `mode` arg (so 4 pushes instead of 5, with a sub rsp,8 alignment pad), and vops_rmdir dispatch (VOPS_RMDIR_OFFSET=80, 3-arg) instead of vops_mkdir. 4-push callee-save prologue (r12=capped path_len, r13=multi-role, r14=basename_ptr, r15=basename_len) + sub rsp,8 lands rsp%16==0 (entry %16==8 - 32 - 8 = %16==0) at nested call sites. Body: (1) Cap path_len at SYS_RMDIR_PATH_MAX-1=255; if 0 bump to 1. (2) user_read_str_via_walk -> strlen or 0. 0 -> EFAULT. Save strlen into r13. (3) Last-slash scan (mov_b, backward-tracking via last-seen rcx). No slash -> ENOENT. NUL-terminate at slash. basename_ptr = scratch + slash + 1 -> r14. (4) basename_len = r13 - rcx - 1 (register-only per encoder gap). basename_len == 0 -> ENOENT. (5) mount_root_vnode -> root_idx; 0 -> ENOENT; save into r13. (6) path_resolve -> parent_vnode_idx; 0 -> ENOENT. (7) vnode_slot -> &parent_vnode. (8) vops_rmdir(&parent_vnode, r14, r15). Non-zero -> EIO. (9) klog_s1_x1(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_rmdir_ok, k_path, &scratch). (10) rax=0; jmp done. Failure arms: sysrm_efault / sysrm_enoent / sysrm_eio. Labels prefixed sysrm_ (distinct from sysmk_ and sysstat_). Same encoder discipline as sys_mkdir_body: no `add reg, [mem]` / no `sub reg, [mem]`, all mem-derived values staged through registers.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;
        // 4 pushes (32) + sub 8 = 40, entry %16==8 + 40 = %16==0 at
        // nested call sites (SysV requirement).

        mov r12, rsi;                    // r12 = path_len (raw)
        mov r13, rdi;                    // r13 = path_va

        // ---- (1) Cap path_len at SYS_RMDIR_PATH_MAX - 1 = 255 ----
        mov r10, 255;
        cmp r12, r10;
        jbe sysrm_cap_ok;
        mov r12, r10;
      sysrm_cap_ok:
        cmp r12, 0;
        jne sysrm_len_ok;
        mov r12, 1;
      sysrm_len_ok:

        // ---- (2) user_read_str_via_walk(path_va, scratch, cap) ----
        mov rdi, r13;                    // arg0 = user path_va
        lea rsi, [rip + _sys_rmdir_path_scratch];
        mov rdx, r12;
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  sysrm_efault;
        mov r13, rax;                    // r13 = strlen

        // ---- (3) Locate last '/' ----
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        xor r9, r9;
        lea r10, [rip + _sys_rmdir_path_scratch];

      sysrm_scan_top:
        cmp r9, r13;
        jae sysrm_scan_done;
        xor r8, r8;
        mov_b r8, [r10 + r9*1];
        cmp r8, 0x2F;                    // '/'
        jne sysrm_scan_next;
        mov rcx, r9;
      sysrm_scan_next:
        add r9, 1;
        jmp sysrm_scan_top;

      sysrm_scan_done:
        cmp rcx, 0xFFFFFFFFFFFFFFFF;
        je  sysrm_enoent;

        // NUL-terminate at slash offset.
        xor r8, r8;
        mov_b [r10 + rcx*1], r8;

        // basename_ptr = &scratch + rcx + 1.
        mov r14, r10;
        add r14, rcx;
        add r14, 1;

        // ---- (4) basename_len = strlen - rcx - 1 (register-only) ----
        mov r15, r13;
        sub r15, rcx;
        sub r15, 1;
        cmp r15, 0;
        je  sysrm_enoent;

        // ---- (5) mount_root_vnode() ----
        call mount_root_vnode;
        cmp rax, 0;
        je  sysrm_enoent;
        mov r13, rax;                    // r13 = root_idx

        // ---- (6) path_resolve(kernel_path, root_idx, cwd) ----
        // R86.M1-005 (#1958): cwd from TASK_OFF_CWD (+160), not hardcoded 0.
        lea rdi, [rip + _sys_rmdir_path_scratch];
        mov rsi, r13;
        mov rax, [rip + _current_tcb];
        mov rdx, [rax + 160];            // cwd (TASK_OFF_CWD)
        call path_resolve;
        cmp rax, 0;
        je  sysrm_enoent;

        // ---- (7) vnode_slot(parent_vnode_idx) -> &parent_vnode ----
        mov rdi, rax;
        call vnode_slot;

        // ---- (8) vops_rmdir(&parent_vnode, basename_ptr, basename_len) ----
        mov rdi, rax;                    // arg0 = &parent_vnode
        mov rsi, r14;                    // arg1 = basename_ptr
        mov rdx, r15;                    // arg2 = basename_len
        call vops_rmdir;
        cmp rax, 0;
        jne sysrm_eio;

        // ---- (9) Fingerprint emit ----
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_rmdir_ok];
        lea rcx, [rip + k_path];
        lea r8,  [rip + _sys_rmdir_path_scratch];
        call klog_s1_x1;

        // ---- (10) Success return ----
        xor rax, rax;
        jmp sysrm_done;

      sysrm_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        jmp sysrm_done;

      sysrm_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sysrm_done;

      sysrm_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;

      sysrm_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
