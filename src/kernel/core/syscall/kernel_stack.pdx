// src/kernel/core/syscall/kernel_stack.pdx — R13-m5-002 (#428) — SYSCALL kernel stack
// 16 KiB per-BSP kernel stack + saved-rsp slot.
// SINGLE-CPU ONLY. R13-m6 must convert to per-CPU (via [gs:KSTACK_SLOT]).
// Multi-CPU boot with this file unchanged = data race on rsp switch = crash.
//
// R17-M0-728 (#728 D9): DEPRECATED — replaced by per-task kernel stacks in
// task_pool.pdx (_task_kernel_stacks, indexed by pid).  The single-global
// design here corrupted the saved kernel-call chain of any task that
// blocked mid-syscall (specifically: init's `call sched_switch_r15` return
// address inside sched_block was clobbered when child's syscalls reset
// rsp to the same base and pushed their own chain).  syscall_entry no
// longer references _syscall_kernel_stack; the symbol is retained solely
// to avoid churning downstream link/build artifacts, and can be deleted
// once a full-tree grep confirms nothing else names it.  See design/
// kernel/r17-m0-728-d9-sys-exit-sched-switch-ud.md §6.1.

module KernelStack = structure {
  pub let SYSCALL_STACK_QWORDS : u64 = 2048
  pub let SYSCALL_STACK_BYTES : u64 = 16384

  pub let mut _syscall_kernel_stack : [u64; 2048] = uninit @align(16)
}
