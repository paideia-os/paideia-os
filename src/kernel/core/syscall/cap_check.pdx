// src/kernel/core/syscall/cap_check.pdx -- Wave UMB-W12 R125.M4
// paideia-os #2594
//
// Syscall-entry capability check integration.
//
// =============================================================================
// SECTION 0  WHY THIS FILE
// =============================================================================
//
// R125 (umbrella paideia-os #2478) says "every command runs in a bounded
// cap-flow".  Three preceding milestones built the substrate:
//
//   R125.M1 (Wave 87, #2591) -- KIND_CAP_ENV substrate.  16 envs x 6 cap
//     slots in _cap_env_table.  Shells mint, insert, freeze, destroy.
//   R125.M2 (Wave 96, #2592) -- svc.cap-minter daemon with
//     _cap_minter_derive, _cap_minter_set_active_env, _cap_minter_get_
//     active_env.  Daemon narrows a parent cap into a child env slot.
//   R125.M3 (Wave 98, #2593, #2733) -- ELF `.caps.decl` loader with the
//     sys_execve splice.  caps_decl_apply walks a packed table of
//     DERIVE requests at execve time; soft-fail bridge posture.
//
// R125.M4 (this file, Wave UMB-W12, #2594) adds the kernel-entry gate:
// before dispatching to a syscall body, verify the caller's active
// cap-env grants the required right for that syscall.  Without this
// gate, every userspace process could call every syscall regardless of
// what caps the shell handed in -- the R125 "bounded cap-flow" invariant
// would be an advisory, not an enforced one.
//
// =============================================================================
// SECTION 1  BRIDGE POSTURE  --  M4 vs. M5
// =============================================================================
//
// M4 (this landing) is INTENTIONALLY INCOMPLETE.  The rights table
// specifies non-zero required rights for ONLY four sysnos:
//
//   75  sys_mount      -> R_SYS_MOUNT     = 0x001
//   135 sys_vol_mint   -> R_SYS_VOL_MINT  = 0x002
//   136 sys_dek_seal   -> R_SYS_CRYPTO    = 0x004
//   137 sys_dek_apply  -> R_SYS_CRYPTO    = 0x004
//
// All other sysnos keep R_SYS_ANY (= 0) which the fast-path returns
// CC_OK for without any env scan.  Rationale: these four are the
// supervisor-privileged volume/crypto surface that already runs through
// the shell's cap-env (R123 cmd-module launch), so flipping the gate
// here immediately regresses the shell -> svc.pdxfs / svc.cap-minter
// call paths if the shell forgets to insert the appropriate caps.
// Every OTHER syscall (read, write, open, pipe, fork, execve, mkdir,
// chdir, ...) stays unchecked at M4 so the kernel-main-only test matrix
// does not implode in one wave.
//
// M5 (follow-on ticket, not scoped here) widens the table so EVERY
// sysno carries a required-rights entry.  The _syscall_rights_table
// slot is already there -- M5 just populates the non-zero mask bits.
// This file does NOT get a second pass at M5 beyond the table init.
//
// Additional bridge softening at M4:
//   (a) `caller_env_handle == 0xFF` (CM_ENV_NONE, from
//       _cap_minter_get_active_env when no env is bound) returns CC_OK
//       regardless of the required mask.  Kernel-origin paths and the
//       pre-userspace init task do not run under any cap-env; failing
//       them hard would break every boot witness that calls sys_mount
//       at BSP bringup.  M5 flips this to CC_DENIED once the init task
//       mint-FreezEs its own supervisor cap-env.
//   (b) `caller_env_handle >= 16` (CAP_ENV_MAX) is treated the same as
//       0xFF (soft-fail -> CC_OK).  A nonsense handle is almost
//       certainly a stale harness pass; the audit trail belongs in
//       svc.cap-minter's own fingerprints, not in a hard-stop at the
//       syscall boundary.
//
// =============================================================================
// SECTION 2  CAP INTERPRETATION  --  M4 SIMPLIFICATION
// =============================================================================
//
// A KIND_CAP_ENV row's six slots each store a u64.  At M3 the shell
// INSERTs cap-table indices (what _cap_minter_derive returns) into
// those slots.  Deep rights introspection would require this check
// function to re-walk the cap_table at [cap_table + idx*24 + 8] to
// read the rights field, matching ipc_slot_to_endpoint's shape in
// dispatch.pdx L353-394.
//
// M4 adopts the SIMPLER interpretation: the stored u64 is read as a
// RIGHTS MASK DIRECTLY, and the test is `(stored & required) ==
// required`.  Two reasons:
//
//   (1) The task directive spells the check that way ("scan for a cap
//       whose `rights & required_right == required_right`") -- treating
//       the slot value as a bitmask is the smallest literal reading.
//   (2) The shell is the only cap-env minter at R125.M4 and it already
//       chooses which rights-level mask to store (R_SYS_* constants
//       below).  The cap_table-dereference layer stays available for
//       M5 without changing the on-disk .caps.decl format.
//
// Future (M5+): swap the direct read for a cap_table[idx+8] fetch to
// recover the full capability-descriptor semantics.  The scan shape
// (slot 0..5, `rights & required == required`) stays identical.
//
// =============================================================================
// SECTION 3  INSERTION POINT IN dispatch.pdx
// =============================================================================
//
// The cap-check runs in syscall_dispatch AFTER the out-of-band 517/527
// arms (sys_cwd_resolve, sys_pdxfs_fault_inject) and BEFORE the main
// bounds check `cmp rdi, 137; ja dispatch_enosys`.  Both out-of-band
// sysnos are supervisor-only at M4 and the dispatch's own 517-first/
// 527-second arm sees them before any bound widens; M5 lifts them
// under the gate by giving them table entries once the bound-check
// pattern changes.
//
// At the insertion point rsp%16==8 (SysV entry).  Five callee-save
// pushes (rsi, rdx, rcx, r8, rdi -- all SysV syscall args as left-
// rotated by entry.pdx) land rsp%16==0 for the two nested calls
// (_cap_minter_get_active_env + _syscall_cap_check).  On CC_OK we pop
// the args in reverse order and fall through to the existing cascade.
// On CC_DENIED we discard the saved args (`add rsp, 40`) and `ret`
// with rax = -EACCES (0xFFFFFFFFFFFFFFF3).  On CC_BAD_SYSNO we return
// rax = -ENOSYS (0xFFFFFFFFFFFFFFDA) -- the same code the existing
// dispatch_enosys returns, so a userspace probe cannot distinguish a
// kernel-level "unimplemented" from the cap-check's "unrecognised
// sysno" branch.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  CC_OK / CC_DENIED / CC_BAD_SYSNO
// =============================================================================
//
// Internal taxonomy (not exposed to userspace; the dispatch shim
// translates to the standard Linux-style negative errno sentinels):
//
//   CC_OK          = 0            -- caller may dispatch
//   CC_DENIED      = 0x0F40       -- env present, no slot grants required
//   CC_BAD_SYSNO   = 0x0F41       -- sysno >= 138 (table out-of-range)
//
// Band audit (2026-10-13): `grep -rnE '0x0F4[01]\b' src/ 2>/dev/null`
// returned zero hits for the exact 0x0F40 / 0x0F41 pair -- clean band
// with no adjacent namespace.  Both fit imm32 (bit 31 clear, 7-byte
// `mov rax, imm32` zero-extend-safe).  Chosen deliberately NOT in the
// 0xFFFFFxxx band because they are INTERNAL only -- the dispatch shim
// never bubbles them out to userspace; a user-visible leak would be
// an audit regression and the distinct band makes a grep audit trivial.
//
// =============================================================================
// SECTION 5  paideia-as encoder-gap posture
// =============================================================================
//
// Table stride 8 is a power-of-two: `mov r11, idx; shl r11, 3; add rN,
// r11` (no `imul r, imm`).  All error sentinels fit imm32 so `mov rax,
// imm32` emits the 7-byte zero-extend form.  Rights-mask comparisons
// use `cmp rN, imm32` directly (0x001, 0x002, 0x004 all fit).  flag-
// bit tests use `cmp rN, 0` (never `test rN, rN`).  All `pub let`
// string declarations are single-line (there are none in this file).
// Module basename `CapCheck` matches `cap_check.pdx`.  Every label is
// prefixed `cc_` or `srti_` (reserved-word discipline -- `loop`/`if`/
// `let` are keywords).
//
// klog hooks: _syscall_cap_check is a hot-path leaf-ish (one nested
// call to cap_env_lookup); it does NOT emit any klog line to keep the
// per-syscall overhead at a few dozen instructions.  _syscall_rights_
// table_init emits one `SYSCALL CAP_CHECK TABLE OK` fingerprint via
// klog_s1 (0-KV wrapper) at boot so an audit can confirm the table was
// populated.
//
// =============================================================================
// SECTION 6  REGISTER PLAN  --  _syscall_cap_check
// =============================================================================
//
// Three callee-save pushes (rbx = required_right, r12 = env_handle,
// r13 = slot cursor).  Entry rsp%16==8; +3 pushes = +24 -> rsp%16==0
// (call-ready at the single nested cap_env_lookup call).
//
// Caller-save scratches used freely: rax (return + nested call ret),
// rcx / rdx / r8 / r9 / r10 / r11 (temps).  None are preserved
// across the nested call -- the required_right and env_handle live
// in callee-save rbx/r12 and the slot cursor in r13.

module CapCheck = structure {

  // ==========================================================================
  // SECTION 7  Return codes + rights masks (§4, §2)
  // ==========================================================================

  pub let CC_OK          : u64 = 0
  pub let CC_DENIED      : u64 = 0x0F40
  pub let CC_BAD_SYSNO   : u64 = 0x0F41

  // Right-mask constants.  R_SYS_ANY (= 0) is the fast-path default --
  // _syscall_rights_table stays bss-zero for every sysno M4 does not
  // explicitly populate.
  pub let R_SYS_ANY       : u64 = 0x000
  pub let R_SYS_MOUNT     : u64 = 0x001
  pub let R_SYS_VOL_MINT  : u64 = 0x002
  pub let R_SYS_CRYPTO    : u64 = 0x004

  // Table geometry.  Matches the dispatch.pdx bounds-check limit
  // (`cmp rdi, 137; ja dispatch_enosys`) so sysno 0..137 inclusive are
  // table-covered and 138+ returns CC_BAD_SYSNO.  Grow this in lockstep
  // with the dispatch bounds whenever a new in-band sysno lands.
  pub let SYSCALL_RIGHTS_TABLE_LEN : u64 = 138
  pub let CAP_ENV_NONE_SENTINEL    : u64 = 0xFF
  pub let CAP_ENV_MAX_HANDLE       : u64 = 16    // mirrors KindCapEnv.CAP_ENV_MAX
  pub let CAP_ENV_SLOTS_HERE       : u64 = 6     // mirrors KindCapEnv.CAP_ENV_SLOTS

  // ==========================================================================
  // SECTION 8  Static table (bss-zero init matches R_SYS_ANY fast-path)
  // ==========================================================================
  //
  // 138 u64 = 1104 bytes.  @align(64) so a cache-line fetch covers the
  // small (<= 8-entry) populated-sysno subset M4 writes.
  pub let mut _syscall_rights_table : [u64; 138] = uninit @align(64)

  // Boot fingerprint (SECTION 5).  N = len + 1 NUL.
  //   "SYSCALL CAP_CHECK TABLE OK" = 26 chars + NUL = N=27
  pub let srti_tag_ok : [u8; 27] = "SYSCALL CAP_CHECK TABLE OK\0"

  // ==========================================================================
  // SECTION 9  _syscall_rights_table_init() -> ()
  //
  // Boot-time scrub.  Zeroes every entry (defensive; .bss is already
  // zero at real boot but the chaos-restart / witness-replay path
  // may re-enter), then writes the four M4-mandated non-zero entries.
  //
  // Register plan: pure leaf (no nested calls at the table-write phase;
  // the klog_s0 fingerprint at the tail is the only call and lives
  // behind a `sub rsp, 8` alignment pad).  No callee-save pushes.
  // ==========================================================================
  pub let _syscall_rights_table_init : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R125.M4 (paideia-os #2594): populate _syscall_rights_table.  Linear zero of 138 u64 slots (bss already-zero at real boot; defensive against chaos-restart) then four direct stores for the M4 populated set (sys_mount=75 -> R_SYS_MOUNT, sys_vol_mint=135 -> R_SYS_VOL_MINT, sys_dek_seal=136 -> R_SYS_CRYPTO, sys_dek_apply=137 -> R_SYS_CRYPTO).  Each offset is a decimal constant (sysno * 8) emitted directly so no `imul r, imm` form is reached.  Tail emits one `SYSCALL CAP_CHECK TABLE OK` klog_s1 fingerprint (0-KV wrapper -- (level, subsys, tag)) so an audit grep can confirm the table was populated.  Pure leaf except the terminal klog_s1 call which lands with rsp%16==0 via a `sub rsp, 8` alignment pad (entry rsp%16==8, pad -> %16==0).  Labels prefixed srti_.",
      block: {
        // ---- Phase 1: zero all 138 slots ----
        lea r10, [rip + _syscall_rights_table];
        xor rax, rax;
        xor rcx, rcx;
      srti_zero:
        mov r11, 138;
        cmp rcx, r11;
        jae srti_populate;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp srti_zero;

      srti_populate:
        // ---- Phase 2: four M4 entries ----
        // 75 * 8 = 600
        mov r11, 0x001;
        mov [r10 + 600], r11;
        // 135 * 8 = 1080
        mov r11, 0x002;
        mov [r10 + 1080], r11;
        // 136 * 8 = 1088
        mov r11, 0x004;
        mov [r10 + 1088], r11;
        // 137 * 8 = 1096
        mov [r10 + 1096], r11;

        // ---- Phase 3: boot fingerprint ----
        // klog_s1(level=3 LEVEL_INFO, subsys=SUBSYS_CAP_, tag=srti_tag_ok)
        sub rsp, 8;                      // SysV alignment pad
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + srti_tag_ok];
        call klog_s1;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10  _syscall_cap_check(sysno, caller_env_handle) -> errno
  //
  // See SECTION 6 for the register plan.  Three callee-save pushes
  // (rbx = required_right, r12 = env_handle, r13 = slot cursor) land
  // rsp%16==0 at the single nested cap_env_lookup call (entry
  // rsp%16==8; +3 pushes = +24 -> %16==0).
  //
  // Return protocol:
  //   CC_OK          -- caller may dispatch (fast-path hit, env-unset
  //                     bridge path, or scan found a satisfying slot)
  //   CC_DENIED      -- env in-range + required non-zero + no slot
  //                     satisfies.  Dispatch returns -EACCES.
  //   CC_BAD_SYSNO   -- sysno >= 138.  Dispatch returns -ENOSYS.
  // ==========================================================================
  pub let _syscall_cap_check : (u64, u64) -> u64 !{mem} @{cap} =
    fn (sysno: u64) (caller_env_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R125.M4 (paideia-os #2594): per-syscall cap-env check.  Three callee-save pushes (rbx=required_right, r12=env_handle, r13=slot cursor) land rsp%16==0 at the single nested cap_env_lookup call (entry rsp%16==8; +3 pushes = +24 -> %16==0).  Phase 1 bounds-check sysno<SYSCALL_RIGHTS_TABLE_LEN(138) -> CC_BAD_SYSNO on overflow.  Phase 2 loads required_right from _syscall_rights_table[sysno]; if 0 (R_SYS_ANY) returns CC_OK immediately (hot-path for every non-populated sysno at M4).  Phase 3 bridge-posture softens: env_handle == CAP_ENV_NONE_SENTINEL(0xFF) OR env_handle >= CAP_ENV_MAX_HANDLE(16) returns CC_OK (SECTION 1 (a)/(b)).  Phase 4 scans slots 0..5 via cap_env_lookup; each stored u64 is read as a rights mask directly (SECTION 2 M4 simplification).  First slot whose (stored & required) == required returns CC_OK; empty slot (stored == 0) is skipped.  Exhausting all 6 slots returns CC_DENIED.  Labels prefixed cc_.",
      block: {
        // ---- Prologue: 3 callee-save pushes ----
        push rbx;
        push r12;
        push r13;

        // Save args.  rdi/rsi are caller-save; the nested cap_env_lookup
        // call will clobber them.
        mov r12, rsi;                    // r12 = caller_env_handle

        // ---- Phase 1: sysno bounds ----
        mov r10, 138;                    // SYSCALL_RIGHTS_TABLE_LEN
        cmp rdi, r10;
        jae cc_bad_sysno;

        // ---- Phase 2: load required_right ----
        lea r10, [rip + _syscall_rights_table];
        mov r11, rdi;
        shl r11, 3;                      // sysno * 8
        add r10, r11;
        mov rbx, [r10 + 0];              // rbx = required_right

        // Fast-path: required == 0 (R_SYS_ANY) -> CC_OK.
        cmp rbx, 0;
        je  cc_ok;

        // ---- Phase 3: bridge-posture softening ----
        // env_handle == 0xFF (CM_ENV_NONE) -> CC_OK.
        mov r10, 0xFF;                   // CAP_ENV_NONE_SENTINEL
        cmp r12, r10;
        je  cc_ok;

        // env_handle >= CAP_ENV_MAX_HANDLE -> CC_OK (treat as unset).
        mov r10, 16;                     // CAP_ENV_MAX_HANDLE
        cmp r12, r10;
        jae cc_ok;

        // ---- Phase 4: scan slots 0..5 ----
        xor r13, r13;                    // slot cursor = 0

      cc_scan:
        mov r10, 6;                      // CAP_ENV_SLOTS_HERE
        cmp r13, r10;
        jae cc_denied;

        // cap_env_lookup(env_handle, slot) -> cap_value | 0
        mov rdi, r12;
        mov rsi, r13;
        call cap_env_lookup;

        // Empty slot (0) -> advance.  Any non-zero value is treated as
        // a rights-mask candidate per SECTION 2.
        cmp rax, 0;
        je  cc_scan_next;

        // Rights test: (stored & required) == required.
        mov r10, rax;
        and r10, rbx;
        cmp r10, rbx;
        je  cc_ok;

      cc_scan_next:
        add r13, 1;
        jmp cc_scan;

        // ---- Return arms ----
      cc_ok:
        xor rax, rax;                    // CC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      cc_denied:
        mov rax, 0x0F40;                 // CC_DENIED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      cc_bad_sysno:
        mov rax, 0x0F41;                 // CC_BAD_SYSNO
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
