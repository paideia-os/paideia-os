// src/kernel/core/syscall/sys_stat.pdx -- R56.M3-002 (paideia-os #1791)
//
// SYS_STAT -- ring-3 stat syscall body + dispatch shim (sysno 77).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/kernel/vfs-metadata-syscalls.md and paideia-os R56.M3 milestone
// item R56.M3-002:
//
//   "New src/kernel/core/syscall/sys_stat.pdx (body + shim).
//    rdi=path_ptr, rsi=path_len, rdx=stat_buf_ptr (user).
//    Fills a 64-byte kernel-side stat struct
//    {ino, size, mtime, mode, nlink, uid, gid, blksize, blocks}
//    then copies to user via ptr_check."
//
// The R56.M3-001 sibling (paideia-os #1790, landed at 36465b1) widened
// dispatch.pdx's bounds check from 76 -> 82 and added six ENOSYS
// forward-declaration stubs (dispatch_stat / _getdents / _mkdir / _rmdir
// / _unlink / _rename). This landing rewrites dispatch_stat from that
// stub into a real shim that calls sys_stat_body defined below.
//
// The five sibling ENOSYS stubs (78..82) remain untouched here; they
// land at issues #1792..#1795 (per #1790's commit body) and each rewrites
// its own dispatch label in-place.
//
// -----------------------------------------------------------------------------
// Kernel-side stat struct layout (frozen at this landing)
// -----------------------------------------------------------------------------
//
// A 64-byte packed record. Consumed by ring-3 stat-format tooling (ls,
// stat, du) via the standard SysV pack-then-copy convention -- the low
// bytes hold the frequently-read fields (ino, size) so a caller that
// only wants the size does not have to fault in the tail:
//
//   +0   ino      u64   -- inode index within the backend
//                          (tmpfs: pool idx; pdxfs-lite: on-disk id;
//                           pdxfs-block: on-disk id or 0 at M3 stub)
//   +8   size     u64   -- byte-length of the file
//   +16  mtime    u64   -- last-modification wall time in nanoseconds
//                          since boot (0 at R56 pending clock wire-up)
//   +24  mode     u32   -- POSIX mode word (0 for tmpfs; low 12 bits of
//                          on-disk mode for pdxfs-lite)
//   +28  nlink    u32   -- link count
//   +32  uid      u32   -- owner user id (0 for tmpfs)
//   +36  gid      u32   -- owner group id (0 for tmpfs)
//   +40  blksize  u32   -- preferred I/O block size (4096 = one page)
//   +44  blocks   u32   -- ceil(size / 4096); u32-cast safe at R56
//                          (tmpfs cap 16 pages/file; pdxfs-lite cap
//                          fits far below u32-worth of pages)
//   +48..+63             -- reserved, zeroed for forward-compat
//
// Two u64 stores cover the reserved tail cleanly. When R57+ adds atime /
// ctime / rdev the reserved band shrinks in-place without touching any
// caller.
//
// -----------------------------------------------------------------------------
// Composition
// -----------------------------------------------------------------------------
//
// sys_stat_body walks the caller-supplied user path into a kernel scratch
// via user_read_str_via_walk (same helper dispatch_open uses), resolves
// via path_resolve against mount_root_vnode, dispatches through the R56
// vops_stat slot (VOPS_STAT_OFFSET=56 in vops.pdx) to the per-backend
// adapter, then copies the resulting 64-byte kernel-side stat scratch
// back to the caller via user_ptr_ok + user_write_bytes_via_walk. On
// success emits the R56.M3-002 fingerprint via klog_s1_x2 with the two
// k=v pairs (path, size) per the task's own emit contract, then returns
// 0.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// Distinct sentinels line up with POSIX errno signs (Linux-style negative
// u64s so a caller uses `cmp rax, 0; jl err` for a single-branch sign
// test):
//
//   0                            -- success
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- user pointer refused (path VA in the
//                                    kernel half OR stat_buf VA in the
//                                    kernel half OR walker fault mid-copy)
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- path_resolve returned 0 (no such path)
//                                    OR vops_stat returned
//                                    VOPS_ERR_NOT_SUPPORTED (backend has
//                                    no stat adapter registered -- treated
//                                    as ENOENT for the ring-3 caller so
//                                    ls does not have to know the vops
//                                    surface)
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// Per the R56.M3-002 task pin:
//   `!{mem, sysreg} @{cap}`
//
// The mem effect covers path_resolve + vops_stat's field reads + the
// user_write copy. The sysreg effect covers the two walker calls
// (user_read_str_via_walk / user_write_bytes_via_walk both list sysreg
// in their own effect rows). The cap capability is a forward-compat
// annotation for a R57+ evolution that gates stat on per-mount VOL_RIGHT
// or per-inode capability checks; no cap operation runs here today, but
// keeping the annotation avoids re-annotating every witness when the
// gate lands (matches the sys_mount_body posture at R53.M2-002).
//
// -----------------------------------------------------------------------------
// Reserved-label / mov_b / test discipline
// -----------------------------------------------------------------------------
//
// All labels prefixed `sysstat_` -- none of {done, fail, enoent, efault}
// is a paideia-as reserved word, but the prefix protects against future
// grammar additions and follows the sys_mount_body precedent (smb_...).
// No `test` mnemonic (unavailable). No `mov_b` (walkers own byte-
// granularity access; the body writes u64/u32-shaped fields via aligned
// stores only).

module SysStat = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_STAT_OK               : u64 = 0
  pub let SYS_STAT_ERR_ENOENT       : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_STAT_ERR_EFAULT       : u64 = 0xFFFFFFFFFFFFFFF2

  // Path length cap. Matches DISPATCH_PATH_MAX (dispatch.pdx L84),
  // _vfs_open_parent_scratch (vfs_open.pdx), sys_mount's own
  // SYS_MOUNT_PATH_MAX (256), and PATH_MAX (path.pdx L18). Any user
  // caller with a POSIX-legal PATH_MAX buffer sees no length-shrink
  // surprise.
  pub let SYS_STAT_PATH_MAX         : u64 = 256

  // Kernel-side stat struct byte count (frozen by the layout table in
  // the module header). Passed as the len arg to user_ptr_ok +
  // user_write_bytes_via_walk.
  pub let SYS_STAT_STRUCT_BYTES     : u64 = 64

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall path bounce scratch. Same discipline as dispatch.pdx's
  // _dispatch_open_path_scratch: the syscall body walks the user path
  // into this .bss buffer under kernel CR3 (strict-KPTI has flipped CR3
  // by the time we run, so any raw ring-3 VA is unresolvable), then
  // passes the kernel-VA scratch to path_resolve. Single-flow at R56.M3
  // (no concurrent sys_stat callers on the smoke path); a follow-up
  // wave that lands per-TCB stat scratches (SMP-safe multi-caller stat)
  // migrates this field into a per-task slot.
  pub let mut _sys_stat_path_scratch : [u8; 256] = uninit @align(8)

  // 64-byte kernel-side stat scratch. Filled in-place by vops_stat's
  // backend adapter, then walked out to the user's buffer via
  // user_write_bytes_via_walk. Same single-flow argument as the path
  // scratch above.
  pub let mut _sys_stat_out_scratch  : [u64; 8]  = uninit @align(8)

  // ==========================================================================
  // sys_stat_body(path_va, path_len, stat_buf_va) -> u64
  //
  // SysV: rdi=path_va (user VA, NUL-terminated), rsi=path_len (user
  //       length hint -- used only as an upper bound during the walker
  //       copy; the walker itself stops at the first NUL per its own
  //       contract), rdx=stat_buf_va (user VA to a 64-byte destination
  //       struct).
  //   -> rax = 0 on success, or -EFAULT / -ENOENT sentinel on failure.
  //
  // Sequence:
  //   (1) Cap the walker length: min(path_len, SYS_STAT_PATH_MAX-1) so
  //       user_read_str_via_walk stops at NUL within a bounded window.
  //   (2) user_ptr_ok(stat_buf_va, 64) -> reject a kernel-half stat_buf
  //       up-front. Any failure -> -EFAULT.
  //   (3) user_read_str_via_walk(user_path_va=r13, kernel_dst=&scratch,
  //       cap=path_len_capped) -> rax = strlen or 0 on fault. 0 -> -EFAULT.
  //   (4) mount_root_vnode() -> rax = root idx. 0 -> -ENOENT (no mounted
  //       root -- unusual, but the ENOENT taxonomy applies because a
  //       ring-3 caller cannot distinguish "no root" from "no such path"
  //       in a portable way, and the ring-3 tool that would care --
  //       mount(2) itself -- is the sys_mount body a level up).
  //   (5) path_resolve(kernel_path=&scratch, root_idx=r13, cwd=0)
  //       -> rax = vnode_idx or 0. 0 -> -ENOENT.
  //   (6) vnode_slot(vnode_idx) -> rax = &vnode. (Pure address
  //       arithmetic; cannot fail for a valid idx.)
  //   (7) vops_stat(&vnode, &_sys_stat_out_scratch) -> rax = 0 or
  //       VOPS_ERR_NOT_SUPPORTED. Non-zero -> -ENOENT (map "backend has
  //       no adapter" to the same errno ring-3 sees for a lookup miss).
  //   (8) user_write_bytes_via_walk(user_va=stat_buf_va, kernel_src=
  //       &_sys_stat_out_scratch, len=64) -> rax = 0 or -EFAULT.
  //       Non-zero -> -EFAULT.
  //   (9) Fingerprint emit via klog_s1_x2 (LEVEL_INFO, SUBSYS_FS_,
  //       tag_sys_stat_ok, k_path, &scratch (path buf VA as hex),
  //       k_size, [scratch_stat+8] (size as hex)).
  //  (10) Return 0.
  //
  // Register plan (5-push callee-save; entry rsp%16==8 + 40 = %16==0 at
  // every nested call site; nested callees see %16==8 at entry per
  // SysV):
  //   rbx = stat_buf_va       (survives all six nested calls; consumed
  //                             at step 8 as the user-write destination)
  //   r12 = path_len (capped)  (dead after step 3; kept in prologue for
  //                             uniform register recovery)
  //   r13 = path_va            (initially the user VA at step 3;
  //                             repurposed at step 4 to hold root
  //                             vnode idx across path_resolve; repurposed
  //                             again at step 9 to hold size u64 across
  //                             the fingerprint call)
  //   r14 = vnode_idx          (result of step 5; consumed at step 6)
  //   r15 = &vnode             (result of step 6; consumed at step 7)
  //
  // Alignment discipline: 5 pushes leave rsp%16==0 which is exactly
  // what SysV requires at a nested call site (no pad needed for the
  // six regular calls).  The klog_s1_x2 site at step 9 pushes v2 as
  // the 7th arg; a bare push there would break alignment (%16==8), so
  // a matching `sub rsp, 8` precedes the push and `add rsp, 16`
  // undoes both.  Matches sys_mount_body's own 5-push discipline
  // (sys_mount.pdx L326 "5 pushes (40 B) leave rsp%16==0 with no pad
  // needed") extended with the assert.pdx-style push-v2 idiom for the
  // klog call.
  // ==========================================================================
  pub let sys_stat_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_va: u64) (path_len: u64) (stat_buf_va: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R56.M3-002 (#1791): sys_stat body -- ring-3 stat syscall (sysno 77). Walks user path into kernel .bss scratch via user_read_str_via_walk, resolves via mount_root_vnode + path_resolve, dispatches through the R56 vops_stat slot (VOPS_STAT_OFFSET=56) to the per-backend adapter that populates a 64-byte kernel-side stat scratch, then copies the scratch back to the caller via user_ptr_ok + user_write_bytes_via_walk. Emits the R56.M3-002 fingerprint via klog_s1_x2 (tag_sys_stat_ok + k_path + k_size) on the success arm only. 5-push callee-save prologue (rbx=stat_buf_va, r12=path_len, r13=path_va-then-root_idx-then-size, r14=vnode_idx, r15=&vnode) leaves rsp%16==0 which is exactly what SysV requires at every nested call site (entry rsp%16==8, minus 40 = %16==0; callee's own retaddr push then delivers rsp%16==8 at body entry per SysV). Matches sys_mount_body's own 5-push discipline (sys_mount.pdx L326). Body: (1) Cap path_len at SYS_STAT_PATH_MAX-1 = 255 so the walker's own #741 layer-2 gate accepts a user_va + cap that ends strictly below KERNEL_VMA_BASE (walker's contract). If path_len == 0, still call the walker with cap=1 so a `/` root stat resolves; the walker returns strlen (0 = fault at first byte, > 0 = success). (2) user_ptr_ok(stat_buf_va=rdx, len=64) -> 0/1. Non-zero -> SYS_STAT_ERR_EFAULT. (3) user_read_str_via_walk(user_path_va=r13, kernel_dst=&_sys_stat_path_scratch, cap=r12_capped) -> rax = strlen or 0 on fault. 0 -> SYS_STAT_ERR_EFAULT. (4) mount_root_vnode() -> rax = root_idx. 0 -> SYS_STAT_ERR_ENOENT. Save into r13. (5) path_resolve(kernel_path=&_sys_stat_path_scratch, root_idx=r13, cwd=0) -> rax = vnode_idx or 0. 0 -> SYS_STAT_ERR_ENOENT. Save into r14. (6) vnode_slot(r14) -> rax = &vnode. Save into r15. (7) vops_stat(r15, &_sys_stat_out_scratch) -> rax = 0 or VOPS_ERR_NOT_SUPPORTED (0xFFFFFFFFFFFFFFFF). Non-zero -> SYS_STAT_ERR_ENOENT (ring-3 sees a uniform lookup-failure taxonomy regardless of whether the backend refused via ENOENT or via a missing adapter). (8) user_write_bytes_via_walk(user_va=rbx, kernel_src=&_sys_stat_out_scratch, len=64) -> rax = 0 or -EFAULT. Non-zero -> SYS_STAT_ERR_EFAULT. (9) Fingerprint emit: klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_stat_ok, k_path, &_sys_stat_path_scratch, k_size, [_sys_stat_out_scratch+8]) with v2 (size) pushed as the 7th arg per the klog_s1_x2 stack convention (wrappers.pdx L70-107). Save size into r13 across the push (r13 already dead post step 5 -> reused). Alignment for the klog site: post-prologue rsp%16==0, so a bare `push v2` would land at %16==8 -- SysV violation -- so we sub rsp,8 first (%16==8), then push v2 (%16==0), then CALL; symmetric add rsp,16 restores. Assert.pdx (L38-73) uses the sibling 4-push-then-push-v2 shape where the 4 pushes already end at %16==8 and one v2 push completes the alignment. (10) mov rax, 0; jmp sysstat_done. All failure arms jmp sysstat_done via a distinct label that sets rax to the appropriate sentinel. Effects {mem, sysreg} @{cap} match the R56.M3-002 task pin exactly. Labels prefixed sysstat_ -- grep audit: no `sysstat_` collisions elsewhere in src/kernel/. No test instruction; no mov_b (walker owns byte-granularity access; struct writes are all u64/u32 shape via aligned stores in the per-backend adapters).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // No sub rsp,8 pad: 5 pushes leave rsp%16==0 (entry %16==8, minus
        // 40 = %16==0) which is exactly what SysV requires at a nested
        // call site.  Matches sys_mount_body's own 5-push prologue
        // discipline (sys_mount.pdx L326 "5 pushes (40 B) leave
        // rsp%16==0 with no pad needed").

        mov rbx, rdx;                    // rbx = stat_buf_va (survives all calls)
        mov r12, rsi;                    // r12 = path_len (raw)
        mov r13, rdi;                    // r13 = path_va (walker arg0)

        // ---- (1) Cap path_len at SYS_STAT_PATH_MAX-1 = 255 ----
        // A zero-length caller still gets cap=1 so the walker sees at
        // least one byte of headroom for the NUL-only path case.
        mov r10, 255;                    // SYS_STAT_PATH_MAX - 1
        cmp r12, r10;
        jbe sysstat_cap_ok;
        mov r12, r10;
      sysstat_cap_ok:
        cmp r12, 0;
        jne sysstat_len_ok;
        mov r12, 1;
      sysstat_len_ok:

        // ---- (2) user_ptr_ok(stat_buf_va, 64) ----
        mov rdi, rbx;                    // arg0 = stat_buf_va
        mov rsi, 64;                     // arg1 = SYS_STAT_STRUCT_BYTES
        call user_ptr_ok;                // rax = 0 (OK) or 1 (fault)
        cmp rax, 0;
        jne sysstat_efault;

        // ---- (3) user_read_str_via_walk(path_va, scratch, cap) ----
        mov rdi, r13;                    // arg0 = user path_va
        lea rsi, [rip + _sys_stat_path_scratch];   // arg1 = kernel dst
        mov rdx, r12;                    // arg2 = capped cap
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  sysstat_efault;              // 0 = walker rejected user_va

        // ---- (4) mount_root_vnode() ----
        call mount_root_vnode;           // rax = root_vnode_idx
        cmp rax, 0;
        je  sysstat_enoent;
        mov r13, rax;                    // r13 = root_idx (path_va dead)

        // ---- (5) path_resolve(kernel_path, root_idx, cwd=0) ----
        lea rdi, [rip + _sys_stat_path_scratch];   // arg0 = kernel path
        mov rsi, r13;                    // arg1 = root_idx
        xor rdx, rdx;                    // arg2 = cwd = 0
        call path_resolve;               // rax = vnode_idx or 0
        cmp rax, 0;
        je  sysstat_enoent;
        mov r14, rax;                    // r14 = vnode_idx

        // ---- (6) vnode_slot(vnode_idx) -> &vnode ----
        mov rdi, r14;
        call vnode_slot;                 // rax = &vnode
        mov r15, rax;                    // r15 = &vnode

        // ---- (7) vops_stat(&vnode, &_sys_stat_out_scratch) ----
        mov rdi, r15;                    // arg0 = &vnode
        lea rsi, [rip + _sys_stat_out_scratch];    // arg1 = kernel stat scratch
        call vops_stat;                  // rax = 0 or VOPS_ERR_NOT_SUPPORTED
        cmp rax, 0;
        jne sysstat_enoent;              // any error -> ENOENT for ring-3

        // ---- (8) user_write_bytes_via_walk(stat_buf_va, scratch, 64) ----
        mov rdi, rbx;                    // arg0 = user stat_buf_va
        lea rsi, [rip + _sys_stat_out_scratch];    // arg1 = kernel src
        mov rdx, 64;                     // arg2 = SYS_STAT_STRUCT_BYTES
        call user_write_bytes_via_walk;  // rax = 0 or -EFAULT
        cmp rax, 0;
        jne sysstat_efault;

        // ---- (9) Fingerprint emit ----
        // klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_stat_ok,
        //            k_path, v1=&_sys_stat_path_scratch (as hex u64),
        //            k_size, v2=[_sys_stat_out_scratch+8] (size as hex))
        //
        // klog_s1_x2 signature (wrappers.pdx L72): rdi=level, rsi=subsys,
        // rdx=tag, rcx=k1, r8=v1, r9=k2, [rsp+8]=v2 (7th arg on stack).
        //
        // v2 (size u64) lives at _sys_stat_out_scratch + 8. Load into r13
        // (dead post step 5) then push before the call.
        //
        // Alignment: post-prologue rsp%16==0. klog_s1_x2 expects
        // (rsp+8) at CALL to be %16==0 which means rsp%16==0 at CALL.
        // A bare `push r13` would bring us to %16==8 -- a SysV
        // violation -- so we sub rsp,8 first (%16==8), then push r13
        // (%16==0), and undo both with add rsp,16 after the call.
        // Matches the assert.pdx pattern (L38-73) where 4 pushes
        // already left %16==8 and a single push r8 completed the
        // alignment to %16==0.
        mov r13, [rip + _sys_stat_out_scratch + 8]; // r13 = size
        sub rsp, 8;                                  // pre-push pad (%16==8)
        push r13;                                    // v2 on stack (%16==0)
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_stat_ok];
        lea rcx, [rip + k_path];                     // k1 = "path"
        lea r8,  [rip + _sys_stat_path_scratch];     // v1 = path buf VA
        lea r9,  [rip + k_size];                     // k2 = "size"
        call klog_s1_x2;
        add rsp, 16;                                 // drop v2 + pad

        // ---- (10) Success return ----
        xor rax, rax;                    // SYS_STAT_OK = 0
        jmp sysstat_done;

      sysstat_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp sysstat_done;

      sysstat_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT

      sysstat_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
