// src/kernel/core/syscall/handlers/sys_pdxfs_stat_by_inode.pdx
// R90-XREPO.010.M1-002 (paideia-os #2110): sys_pdxfs_stat_by_inode body.
//
// Ring-3 stat-by-inode: given a raw tmpfs inode index, populate a
// 32-byte kernel-side stat record and copy it back to the caller.
// Blocks 3 of the 6 columns in `ls -l` (mode, size, mtime); owner /
// group / nlink land in a future evolution of the record shape.
//
// Contract (SysV, 2 args):
//   rdi = inode_no      -- tmpfs inode index in [1, TMPFS_MAX=256)
//   rsi = out_stat_va   -- user VA to a 32-byte destination record
//   -> rax = 0 on success, or a negative-errno sentinel u64:
//        -EFAULT (0xFFFFFFFFFFFFFFF2)  out_stat_va failed user_ptr_ok,
//                                       or user_write_bytes_via_walk
//                                       faulted mid-copy
//        -ENOENT (0xFFFFFFFFFFFFFFFE)  inode_no out of range (0 or
//                                       >= TMPFS_MAX), or the target
//                                       slot's type byte at +0 is zero
//                                       (unallocated, since tmpfs_inode_
//                                       free rep_stosq's the payload
//                                       before releasing the bitmap bit
//                                       so type==0 is the durable
//                                       "unallocated" signal)
//
// Output record (32 bytes; matches the layout the issue text pins):
//   +0   mode_bits  u64  -- POSIX mode word:
//                            S_IFDIR (0o040000) | 0o755 (VNODE_TYPE_DIR)
//                              = 0x41ED
//                            S_IFREG (0o100000) | 0o644 (VNODE_TYPE_REG)
//                              = 0x81A4
//   +8   size_bytes u64  -- byte length of the file
//                            (tmpfs inode +8, TMPFS_INODE_SIZE_OFFSET)
//   +16  mtime_ns   u64  -- last-modification wall time in nanoseconds:
//                            _tick_count * 10_000_000 (100 Hz LAPIC
//                            tick period in ns, from int/exceptions.pdx
//                            handle_timer's counter). Matches the UEJ
//                            convention landed at R90-XREPO.011.M1-005
//                            (#2120), see user_events_journal.pdx L318,
//                            so a downstream reader can align two
//                            surfaces without a clock-domain conversion.
//                            The two literals move together if LAPIC
//                            is ever retimed.
//   +24  ctime_ns   u64  -- reserved, zeroed at this landing (the
//                            tmpfs inode has neither mtime nor ctime
//                            today; when a distinct ctime field lands
//                            in the tmpfs inode layout, populate here
//                            without touching this record's byte width)
//
// TMPFS inode layout consumed here (src/kernel/core/fs/tmpfs/inode.pdx
// §Layout):
//   +0   type    u8    -- VNODE_TYPE_REG=1, VNODE_TYPE_DIR=2 (per
//                          src/kernel/core/fs/tmpfs/vops.pdx L282)
//   +1   flags   u8
//   +8   size    u64
//   (no on-disk mode / mtime / ctime today -- see file header)
//
// Sequence (sys_pdxfs_stat_by_inode_body):
//   (1) user_ptr_ok(out_stat_va, 32) -> 0 (OK) or 1 (fault). Fault
//       -> -EFAULT.
//   (2) sys_pdxfs_stat_by_inode_scratch_fill(inode_no) -> 0 or -ENOENT.
//       Inner helper (below) does the bounds check + tmpfs_inode_slot
//       lookup + inode.type gate + scratch population, all under
//       kernel CR3 (no user-VA touch). Forwards -ENOENT verbatim.
//   (3) user_write_bytes_via_walk(out_stat_va, &scratch, 32) -> 0 or
//       -EFAULT. Non-zero -> -EFAULT.
//   (4) Fingerprint emit via klog_s1_d2(LEVEL_INFO, SUBSYS_FS_,
//       tag_sys_pdxfs_stat_by_inode_ok, k_ino, inode_no, k_size, size).
//   (5) xor rax, rax -- return 0.
//
// Splitting the fill logic into its own leaf helper is what lets a
// boot witness exercise the fill path without tripping user_ptr_ok's
// range gate (kernel-half VAs are refused). Matches the pattern
// sys_getdents / cap_handler_pdxfs_file take by exposing their inner
// worker to sibling witnesses.
//
// Register plan (sys_pdxfs_stat_by_inode_body -- 3 callee-save
// pushes leave rsp%16==0 for every nested call from entry rsp%16==8;
// matches every leaf-adjacent sys_* body's alignment shape):
//   rbx = out_stat_va   (survives user_ptr_ok + scratch_fill;
//                        consumed at step 3 as the user-write dst)
//   r12 = inode_no      (survives every nested call; consumed at
//                        fingerprint as v1)
//   r13 = size          (reloaded from scratch after step 2;
//                        consumed at fingerprint as v2)
//
// klog_s1_d2's 7th arg (v2) is passed on the stack (see klog/wrappers.
// pdx L258). Post-prologue rsp%16==0, so a bare push v2 lands at
// %16==8 -- SysV violation -- so we sub rsp,8 first (%16==8) then
// push r13 (%16==0), and undo with add rsp,16 after. Matches sys_stat_
// body's step-(9) klog pattern verbatim.
//
// Register plan (sys_pdxfs_stat_by_inode_scratch_fill -- one callee-
// save push leaves rsp%16==0 for the single nested tmpfs_inode_slot
// call from entry rsp%16==8):
//   rbx = inode_no      (survives the tmpfs_inode_slot call so the
//                        field loads and the ENOENT sentinel return
//                        share one save)
//
// [unsafe] -- writes _sys_pdxfs_stat_by_inode_out_scratch (mem);
// user_write_bytes_via_walk transitively touches sysreg via the walker;
// klog_s1_d2 transitively reads TSC + writes UART MMIO. Capability
// {cap} is a forward-compat annotation for a future R91+ evolution
// that gates stat on per-mount VOL_RIGHT or per-inode capability
// checks (matches sys_stat's own posture at sys_stat.pdx L226 -- no
// cap operation runs here today).
//
// Reserved-label discipline: labels prefixed `spsi_` (sys pdxfs stat
// by inode). `loop`, `if` etc. are keywords and never used as labels.

module SysPdxfsStatByInode = structure {

  // ==========================================================================
  // Sentinels + constants
  // ==========================================================================

  pub let SYS_PDXFS_STAT_BY_INODE_OK           : u64 = 0
  pub let SYS_PDXFS_STAT_BY_INODE_ERR_ENOENT   : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_PDXFS_STAT_BY_INODE_ERR_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2

  // Byte count of the output record. Passed as the len arg to
  // user_ptr_ok + user_write_bytes_via_walk.
  pub let SYS_PDXFS_STAT_BY_INODE_STRUCT_BYTES : u64 = 32

  // tmpfs inode pool upper bound. Duplicated (rather than symbolically
  // referenced) from src/kernel/core/fs/tmpfs/inode.pdx TMPFS_MAX so
  // this leaf helper has no cross-module load; the two literals must
  // move together if TMPFS_MAX is ever widened again beyond the
  // paideia-os #2004 grow from 64 to 256.
  pub let SYS_PDXFS_STAT_BY_INODE_TMPFS_MAX    : u64 = 256

  // POSIX mode-word literals for the two tmpfs vnode types.
  //   VNODE_TYPE_REG=1 -> S_IFREG (0o100000) | 0o644 = 0o100644 = 0x81A4
  //   VNODE_TYPE_DIR=2 -> S_IFDIR (0o040000) | 0o755 = 0o040755 = 0x41ED
  // paideia-as prefers hex literals in code (octal only appears in
  // comments across src/kernel/, see kind_pdxfs_file.pdx L760 which
  // pins the same 0o644 -> 0x1A4 convention).
  pub let SYS_PDXFS_STAT_BY_INODE_MODE_REG     : u64 = 0x81A4
  pub let SYS_PDXFS_STAT_BY_INODE_MODE_DIR     : u64 = 0x41ED

  // LAPIC tick period in ns (100 Hz -> 10_000_000 ns per tick). Matches
  // the UEJ convention at src/kernel/core/user/user_events_journal.pdx
  // L318 byte-for-byte -- the two must move together if the LAPIC
  // period is ever retimed.
  pub let SYS_PDXFS_STAT_BY_INODE_TICK_NS      : u64 = 10000000

  // vnode type discriminants (mirrors src/kernel/core/fs/tmpfs/vops.pdx
  // L282). Kept as named constants so a future reader can grep the
  // numeric values back to a name.
  pub let SYS_PDXFS_STAT_BY_INODE_VN_TYPE_REG  : u64 = 1
  pub let SYS_PDXFS_STAT_BY_INODE_VN_TYPE_DIR  : u64 = 2

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // 32-byte kernel-side output scratch. Filled in-place by the fill
  // helper below, then walked out to the user's buffer via user_write_
  // bytes_via_walk. Same discipline as sys_stat's _sys_stat_out_scratch
  // (sys_stat.pdx L159): single-flow at R90-XREPO.010 (no concurrent
  // sys_pdxfs_stat_by_inode callers on the smoke path); a follow-up
  // wave that lands per-TCB stat scratches (SMP-safe multi-caller
  // sys_pdxfs_stat_by_inode) migrates this into a per-task slot.
  pub let mut _sys_pdxfs_stat_by_inode_out_scratch : [u64; 4] = uninit @align(8)

  // ==========================================================================
  // sys_pdxfs_stat_by_inode_scratch_fill(inode_no) -> u64
  //
  // Kernel-only helper: bounds-check inode_no, resolve to a tmpfs
  // inode pointer, gate on the type byte, and populate _sys_pdxfs_
  // stat_by_inode_out_scratch with (mode_bits, size, mtime_ns, 0).
  //
  //   rax = 0                    on success (scratch populated)
  //   rax = -ENOENT (0xFFFF...FE) inode_no OOR or slot unallocated
  //
  // Exposed so boot witnesses can exercise the fill path without
  // tripping user_ptr_ok's range gate (kernel-half VAs are refused).
  // The syscall body calls this helper after its own user_ptr_ok
  // check, then walks the scratch out to the caller.
  //
  // Register plan: one callee-save push (rbx = inode_no) survives the
  // single nested tmpfs_inode_slot call. Entry rsp%16==8; one push
  // lands rsp%16==0, aligned for the nested call per SysV.
  // ==========================================================================
  pub let sys_pdxfs_stat_by_inode_scratch_fill : (u64) -> u64 !{mem} @{} =
    fn (inode_no: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R90-XREPO.010.M1-002 (paideia-os #2110): kernel-only helper that populates the 32-byte _sys_pdxfs_stat_by_inode_out_scratch record for the given tmpfs inode index. Split from the syscall body so a boot witness can exercise the fill path without tripping user_ptr_ok's range gate (kernel-half VAs are refused). Sequence: (1) inode_no in (0, TMPFS_MAX=256) else -ENOENT (0 is the reserved sentinel per inode.pdx L11; >= TMPFS_MAX is OOR). (2) tmpfs_inode_slot(inode_no) -> &inode; pure address arithmetic that never fails so no error check. (3) Load inode.type at +0 (u8 zero-extended via mov_b + xor idiom from tmpfs/create.pdx L60); if 0 -> -ENOENT (tmpfs_inode_free rep_stosq's the 256-byte payload before releasing the bitmap bit, so type==0 is the durable 'unallocated' signal). (4) Compute mode_bits: default = SYS_PDXFS_STAT_BY_INODE_MODE_REG (0x81A4 = S_IFREG | 0o644); if type == VNODE_TYPE_DIR (2), override with SYS_PDXFS_STAT_BY_INODE_MODE_DIR (0x41ED = S_IFDIR | 0o755). Any other type value (defensive; today only 1 and 2 are minted by tmpfs_create) also gets REG -- a future TYPE_LNK etc. lands its own branch. (5) Load size from [&inode + TMPFS_INODE_SIZE_OFFSET (8)]. (6) Compute mtime_ns = _tick_count * 10_000_000 via mov [rip + _tick_count] + mov imm + 2-op imul, matching user_events_journal.pdx L331-333 byte-for-byte. (7) Store mode_bits/size/mtime_ns to scratch +0/+8/+16, zero at +24. Return 0. Effects {mem}: reads _tick_count + _tmpfs_inode_pool, writes _sys_pdxfs_stat_by_inode_out_scratch. Capabilities {}: leaf-adjacent; no cap gate. Encoder-conservative: mov/mov_b/cmp/je/jne/jae/xor/imul/lea/push/pop/call/ret only, every form already proven in tmpfs/create.pdx + user_events_journal.pdx. Reserved labels: spsi_f_. No test mnemonic (unavailable per project convention).",
      block: {
        push rbx;

        mov rbx, rdi;                    // rbx = inode_no

        // ---- (1) Bounds check ----
        cmp rbx, 0;
        je  spsi_f_enoent;
        mov r10, 256;                    // SYS_PDXFS_STAT_BY_INODE_TMPFS_MAX
        cmp rbx, r10;
        jae spsi_f_enoent;

        // ---- (2) tmpfs_inode_slot(inode_no) -> &inode ----
        mov rdi, rbx;
        call tmpfs_inode_slot;           // rax = &inode

        // ---- (3) type gate at +0 (u8 zero-extended) ----
        xor rcx, rcx;
        mov_b rcx, [rax + 0];            // TMPFS_INODE_TYPE_OFFSET = 0
        cmp rcx, 0;
        je  spsi_f_enoent;               // unallocated slot

        // ---- (4) mode_bits from type ----
        // Default = REG (0x81A4 = S_IFREG | 0o644). If DIR (type==2),
        // override with 0x41ED = S_IFDIR | 0o755.
        mov r10, 0x81A4;                 // SYS_PDXFS_STAT_BY_INODE_MODE_REG
        cmp rcx, 2;                      // VNODE_TYPE_DIR
        jne spsi_f_mode_done;
        mov r10, 0x41ED;                 // SYS_PDXFS_STAT_BY_INODE_MODE_DIR
      spsi_f_mode_done:

        // ---- (5) size at +8 (u64) ----
        mov r8, [rax + 8];               // TMPFS_INODE_SIZE_OFFSET = 8

        // ---- (6) mtime_ns = _tick_count * 10_000_000 ----
        // 2-op imul + immediate multiplier follows user_events_journal.
        // pdx L331-333's own idiom byte-for-byte.
        mov r9, [rip + _tick_count];
        mov r11, 10000000;               // SYS_PDXFS_STAT_BY_INODE_TICK_NS
        imul r9, r11;                    // r9 = tick_ns

        // ---- (7) Populate scratch ----
        lea rcx, [rip + _sys_pdxfs_stat_by_inode_out_scratch];
        mov [rcx + 0], r10;              // mode_bits
        mov [rcx + 8], r8;                // size_bytes
        mov [rcx + 16], r9;              // mtime_ns
        xor r11, r11;
        mov [rcx + 24], r11;             // ctime_ns = 0 (reserved)

        xor rax, rax;                    // success
        jmp spsi_f_done;

      spsi_f_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT

      spsi_f_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sys_pdxfs_stat_by_inode_body(inode_no, out_stat_va) -> u64
  //
  // Ring-3 syscall body. See file header for the full sequence + error
  // taxonomy. Register + alignment discipline is documented in the
  // file header's "Register plan" section.
  // ==========================================================================
  pub let sys_pdxfs_stat_by_inode_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (inode_no: u64, out_stat_va: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R90-XREPO.010.M1-002 (paideia-os #2110): sys_pdxfs_stat_by_inode body, SC+ ID 106. Entry: rdi=inode_no, rsi=out_stat_va. Three-push callee-save prologue (rbx=out_stat_va, r12=inode_no, r13=size) leaves rsp%16==0 for every nested call (entry rsp%16==8, minus 24 = %16==0). Sequence: (1) user_ptr_ok(out_stat_va, 32) -> 0/1. Non-zero -> -EFAULT. Rejects a kernel-half stat_buf up-front, matching sys_stat_body's step (2). (2) sys_pdxfs_stat_by_inode_scratch_fill(inode_no) -> 0 or -ENOENT. Forwards -ENOENT verbatim; the inner helper does the bounds check + tmpfs_inode_slot + type-byte gate + scratch population. (3) Reload size from _sys_pdxfs_stat_by_inode_out_scratch + 8 into r13 (dead after step 2; consumed at fingerprint as v2). (4) user_write_bytes_via_walk(out_stat_va=rbx, kernel_src=&scratch, len=32) -> 0 or -EFAULT. Non-zero -> -EFAULT. (5) Fingerprint emit: klog_s1_d2(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_stat_by_inode_ok, k_ino=v1=inode_no, k_size=v2=size) with v2 pushed as the 7th arg per the klog_s1_d2 stack convention (wrappers.pdx L258). Alignment for the klog site: post-prologue rsp%16==0, so a bare push v2 would land at %16==8 -- SysV violation -- so we sub rsp,8 first (%16==8), then push r13 (%16==0), then CALL; symmetric add rsp,16 undoes both. Matches sys_stat_body's step-(9) klog pattern (sys_stat.pdx L332-341) byte-for-byte. (6) xor rax, rax -- success. All failure arms jmp spsi_done via a shared label that sets rax to the appropriate sentinel. Effects {mem, sysreg}: mem for scratch writes; sysreg transitively from user_write_bytes_via_walk's walker + klog_s1_d2's TSC read (matches sys_stat_body's identical widening rationale). Capability {cap}: forward-compat annotation for a future R91+ per-mount VOL_RIGHT gate on stat (matches sys_stat's L226 posture). Encoder-conservative: cmp/je/jne/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in sys_stat / sys_pdxfs_txn_commit / the R42-PREP-007 sys_pdxfs_txn_open body. Reserved labels: spsi_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rsi;                    // rbx = out_stat_va (survives all calls)
        mov r12, rdi;                    // r12 = inode_no

        // ---- (1) user_ptr_ok(out_stat_va, 32) ----
        mov rdi, rbx;
        mov rsi, 32;                     // SYS_PDXFS_STAT_BY_INODE_STRUCT_BYTES
        call user_ptr_ok;                // rax = 0 (OK) or 1 (fault)
        cmp rax, 0;
        jne spsi_efault;

        // ---- (2) Fill kernel scratch via inner helper ----
        mov rdi, r12;                    // arg0 = inode_no
        call sys_pdxfs_stat_by_inode_scratch_fill;
        cmp rax, 0;
        jne spsi_done;                   // -ENOENT forwards verbatim

        // ---- (3) Reload size from scratch for the fingerprint ----
        mov r13, [rip + _sys_pdxfs_stat_by_inode_out_scratch + 8];

        // ---- (4) user_write_bytes_via_walk(out_stat_va, &scratch, 32) ----
        mov rdi, rbx;                    // arg0 = user out_stat_va
        lea rsi, [rip + _sys_pdxfs_stat_by_inode_out_scratch];
        mov rdx, 32;                     // arg2 = SYS_PDXFS_STAT_BY_INODE_STRUCT_BYTES
        call user_write_bytes_via_walk;  // rax = 0 or -EFAULT
        cmp rax, 0;
        jne spsi_efault;

        // ---- (5) Fingerprint emit ----
        // klog_s1_d2(LEVEL_INFO=3, SUBSYS_FS_, tag, k_ino, v1=inode_no,
        //            k_size, v2=size)
        //
        // Post-prologue rsp%16==0. klog_s1_d2 wants (rsp+8) at CALL to
        // be %16==0 (equiv. rsp%16==0 at CALL). A bare `push r13`
        // would bring us to %16==8 -- SysV violation -- so we sub rsp,8
        // first (%16==8), then push r13 (%16==0), and undo both with
        // add rsp,16 after the call.
        mov rdi, 3;                                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_stat_by_inode_ok];
        lea rcx, [rip + k_ino];                            // k1 = "ino"
        mov r8, r12;                                       // v1 = inode_no
        lea r9, [rip + k_size];                            // k2 = "size"
        sub rsp, 8;                                        // pre-push pad (%16==8)
        push r13;                                          // v2 = size (%16==0)
        call klog_s1_d2;
        add rsp, 16;                                       // drop v2 + pad

        // ---- (6) Success return ----
        xor rax, rax;                    // SYS_PDXFS_STAT_BY_INODE_OK = 0
        jmp spsi_done;

      spsi_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT

      spsi_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
