// src/kernel/core/syscall/handlers/sys_pdxfs_txn_abort.pdx
// R90-XREPO.010.M1-003 (paideia-os #2111): sys_pdxfs_txn_abort body.
//
// The ring-3-facing ABORT half of the KIND_PDXFS_TXN lifecycle. Sibling to
// sys_pdxfs_txn_commit (sysno 104, same milestone). Reuses the existing
// pdxfs_txn_abort_wal (#1713) + pdxfs_txn_row_transition (#1629) machinery
// that cap_handler_pdxfs_txn's pxt_hn_abort arm already drives via
// cap_invoke -- this syscall gives userspace a direct abort path that does
// not require staging a cap_invoke op_arg, and (unlike cap_invoke's polymorphic
// return) surfaces a POSIX-shape "0 | -errno" result.
//
// Contract (SysV, 1 arg):
//   rdi = cap_slot   -- KIND_PDXFS_TXN cap slot returned by sys_pdxfs_txn_open
//   -> rax = 0 on success, or a negative-errno / sentinel u64 on failure:
//        -EBADF (0xFFFFFFFFFFFFFFF7 = -9)  -- cap_slot does not name a live
//                                             KIND_PDXFS_TXN
//        PXT_BAD_TRANSITION (0xFFFFEC15)  -- row already COMMITTED / ABORTED
//        <any journal error>              -- pdxfs_txn_abort_wal forwards
//                                             its underlying journal_append /
//                                             sb_read failure verbatim
//
// SCOPE at this landing (undo-body replay landed by #2112):
//
//   The parent milestone's issue text names two work items for abort:
//   (a) mark ABORTED + release txn slot, and (b) "iterate the txn's WAL
//   entries in reverse, apply undo body if present".  Sub-item (b) has
//   landed with R90-XREPO.010.M1-004 (paideia-os #2112) via
//   pdxfs_txn_undo_replay (src/kernel/core/fs/pdxfs/undo.pdx) -- this
//   body now invokes it after the OPEN -> ABORTED transition succeeds.
//   #2112 also lands the paired sys_pdxfs_undo_write (sysno 107) which
//   stages the undo records this replay consumes.
//
//   So this landing:
//     - Writes JOP_ABORT to the journal via pdxfs_txn_abort_wal (#1713)
//       exactly like the cap_invoke pxt_hn_abort arm already does.
//     - Transitions the row OPEN -> ABORTED via pdxfs_txn_row_transition.
//     - Invokes pdxfs_txn_undo_replay(row_id) to walk the row's undo
//       records in REVERSE order and restore each pre-image via
//       tmpfs_write (see undo.pdx §4 REPLAY DISCIPLINE).  A row with
//       no records is a legal no-op (returns 0) so pre-#2112 callers
//       that never staged undo records continue to observe today's
//       "just mark ABORTED" semantics.
//     - Bumps PXT_ST_ABORTS.
//     - Emits TWO fingerprints on the OK path: the pre-existing
//       `sys pdxfs txn abort ok -- txn=<row>` line AND a new
//       `sys pdxfs undo replay ok -- txn=<row> entries=<n>` line
//       surfacing the count of records replayed (entries=0 on a
//       row with no undo history).
//   The row's state field is the observable outcome at this landing --
//   downstream replay logic that a future undo primitive would consult
//   (design/filesystem/volume-fs-substrate.md §4.5) already treats
//   ABORTED as "skip this transaction's data-region records", so the
//   ABORTED marker alone is sufficient to make the abort visible to
//   the replay path even without per-record undo bodies.
//
//   The "release txn slot" work is deferred alongside the sys_pdxfs_txn_
//   commit sibling's own row-release / cap-slot-clear deferral -- both
//   milestones await a future sys_pdxfs_txn_close syscall (see dispatch.
//   pdx sysno 70's own "sys_pdxfs_txn_close for revoke" placeholder).
//   Deferring row release preserves the caller's ability to query the
//   post-abort state field via cap_invoke query ops, matching pxt_hn_
//   abort's own posture (neither this syscall nor the cap_invoke path
//   releases the row today).
//
// Sequencing mirrors cap_handler_pdxfs_txn's pxt_hn_abort arm one-for-one
// (extended by R90-XREPO.010.M1-004 with the undo-replay + second-
// fingerprint pair after the state transition):
//   (1) Resolve cap_slot -> row_id via pdxfs_txn_row_of_slot. PXT_ROW_NONE
//       -> -EBADF.
//   (2) pdxfs_txn_abort_wal(row_id) -- JOP_ABORT record (no BD_OP_FLUSH,
//       matching plan §M6-005's "no data-region writes" wording; see
//       #1713 header). Forward sentinel on non-zero.
//   (3) pdxfs_txn_row_transition(row_id, PXT_STATE_ABORTED=3). Gates on
//       OPEN.
//   (4) pdxfs_txn_undo_replay(row_id) -- walk the row's undo records in
//       REVERSE order, restoring each pre-image via tmpfs_write.  A row
//       with no records is a legal no-op (returns 0); non-zero returns
//       are the substrate's -EINVAL sentinel, which we IGNORE at this
//       landing (the row is already ABORTED and there is no meaningful
//       ring-3 recovery -- the fingerprint emit below carries the
//       replayed count so an operator can see whether the row had
//       records to replay).  We save the return in r14 so it can flow
//       into the fingerprint on the OK path.
//   (5) pdxfs_txn_note(PXT_ST_ABORTS=5) -- success-only bump.
//   (6) Emit `sys pdxfs txn abort ok [legacy: SYS PDXFS TXN ABORT OK]
//       -- txn=<row>` via klog_s1_d1.
//   (7) Emit `sys pdxfs undo replay ok [legacy: SYS PDXFS UNDO REPLAY OK]
//       -- txn=<row> entries=<n>` via klog_s1_d2 (entries = the count
//       pdxfs_txn_undo_replay returned in step (4)).  Always emitted on
//       the OK path so a caller can correlate every txn abort with a
//       matching replay-completion line -- even entries=0 rows produce
//       the line.
//   (8) Return 0.
//
// Register plan (extended for #2112's undo-replay + second-fingerprint
// pair):
//   push r12  -- row_id (survives the whole body)
//   push r14  -- replay entries count (survives from step (4) to step (7))
//   sub rsp, 8 -- align rsp%16 == 0 for nested calls
// Entry rsp%16 == 8 (SysV) + 2 pushes + 8-byte pad = 24 bytes -> post-
// prologue rsp%16 == 0.  Balanced call/ret pairs preserve alignment for
// every nested call.  r14 is callee-save so it survives across the
// pdxfs_txn_note + klog_s1_d1 calls without any per-call push.
//
// [unsafe] -- same transitive posture as sys_pdxfs_txn_commit_body.
// Audit: design/filesystem/volume-fs-substrate.md §4.5.
//
// Reserved-label discipline: labels prefixed `spta_`. `loop`, `if` etc.
// are keywords and never used as labels.

module SysPdxfsTxnAbort = structure {

  // Linux errno -EBADF == -9 sign-extended.
  pub let SYS_PDXFS_TXN_ABORT_EBADF : u64 = 0xFFFFFFFFFFFFFFF7

  // ==========================================================================
  // sys_pdxfs_txn_abort_body(cap_slot) -> 0 | -EBADF | <sentinel>
  //
  // See file header for the full sequence + error taxonomy. Undo-body
  // replay is DEFERRED to paideia-os #2112 per the parent milestone's own
  // note; this landing writes JOP_ABORT + transitions the state, which is
  // the observable half the replay path needs to skip this txn's records
  // regardless of whether per-record undo bodies land.
  // ==========================================================================
  pub let sys_pdxfs_txn_abort_body : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R90-XREPO.010.M1-003 (paideia-os #2111) + R90-XREPO.010.M1-004 (paideia-os #2112 extension): sys_pdxfs_txn_abort body, SC+ ID 105. Entry: rdi=cap_slot. Two-push callee-save prologue (r12 = row_id, r14 = replay entries count) + `sub rsp,8` pad = 24 bytes -> rsp%16==0 for every nested call from entry rsp%16==8 SysV. Sequence mirrors cap_handler_pdxfs_txn's pxt_hn_abort arm (extended by #2112 with the undo-replay + second-fingerprint pair after the state transition): (1) pdxfs_txn_row_of_slot -> row_id or PXT_ROW_NONE -> -EBADF. (2) pdxfs_txn_abort_wal writes JOP_ABORT (no BD_OP_FLUSH per #1713); non-zero return propagates. (3) pdxfs_txn_row_transition(PXT_STATE_ABORTED=3); PXT_BAD_TRANSITION propagates. (4) pdxfs_txn_undo_replay(row_id) -- walks the row's undo records in REVERSE order restoring each pre-image via tmpfs_write; a row with no records is a legal no-op (returns 0). Return saved to r14 (callee-save, survives to the fingerprint emit). We intentionally IGNORE a substrate error (PDXFS_UNDO_EINVAL) at this landing: the row is already ABORTED and there is no meaningful ring-3 recovery -- the fingerprint below still emits so an operator sees the count (0 in that case). (5) pdxfs_txn_note(PXT_ST_ABORTS=5) on success only. (6) klog_s1_d1(SUBSYS_FS__, tag_sys_pdxfs_txn_abort_ok, k_txn, row_id) -- pre-existing per-abort line. (7) klog_s1_d2(SUBSYS_FS__, tag_sys_pdxfs_undo_replay_ok, k_txn, row_id, k_entries, r14) -- new #2112 line pairing entries count with row_id.  klog_s1_d2 wants v2 pushed on stack; we `push r14` (== entries) after `sub rsp,8` to land the pre-call rsp%16==0. (8) xor rax, rax return 0.  Row release + cap slot clear are deferred alongside sys_pdxfs_txn_commit's identical deferral, awaiting a future sys_pdxfs_txn_close syscall. Effects/capabilities identical to sys_pdxfs_txn_commit_body. Encoder-conservative: cmp/je/jae/jne/mov/lea/xor/push/pop/call/sub/add/ret only. Reserved labels: spta_.",
      block: {
        push r12;
        push r14;
        sub rsp, 8;                      // align rsp%16 == 0

        // ---- Step (1): resolve cap_slot -> row_id ----
        call pdxfs_txn_row_of_slot;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae spta_ebadf;
        mov r12, rax;                    // r12 = row_id

        // ---- Step (2): pdxfs_txn_abort_wal(row_id) ----
        mov rdi, r12;
        call pdxfs_txn_abort_wal;
        cmp rax, 0;
        jne spta_out;                    // forward sentinel verbatim

        // ---- Step (3): OPEN -> ABORTED transition ----
        mov rdi, r12;
        mov rsi, 3;                      // PXT_STATE_ABORTED
        call pdxfs_txn_row_transition;
        cmp rax, 0;
        jne spta_out;

        // ---- Step (4): replay undo records (in reverse). Substrate
        //     no-op on empty row (returns 0).  Save the entries count
        //     in r14 (callee-save) for the fingerprint below.
        mov rdi, r12;
        call pdxfs_txn_undo_replay;
        mov r14, rax;                    // r14 = entries replayed

        // ---- Step (5): bump PXT_ST_ABORTS ----
        mov rdi, 5;                      // PXT_ST_ABORTS
        call pdxfs_txn_note;

        // ---- Step (6): emit per-abort fingerprint ----
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_txn_abort_ok];
        lea rcx, [rip + k_txn];
        mov r8, r12;                     // v1 = row_id
        call klog_s1_d1;

        // ---- Step (7): emit undo-replay fingerprint ----
        //   klog_s1_d2(level, subsys, tag, k1, v1, k2 [, v2 on stack]).
        //   Ambient rsp%16 == 0 after the prologue.  sub rsp, 8 -> %16 == 8;
        //   push r14 (entries == v2) -> %16 == 0 for the call.  add rsp, 16
        //   undoes pad + push post-call.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_undo_replay_ok];
        lea rcx, [rip + k_txn];
        mov r8, r12;                     // v1 = row_id
        lea r9, [rip + k_entries];
        sub rsp, 8;                      // align pad
        push r14;                        // v2 = entries
        call klog_s1_d2;
        add rsp, 16;                     // undo push + pad

        // ---- Step (8): return 0 ----
        xor rax, rax;
        jmp spta_out;

      spta_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;     // -EBADF (-9)

      spta_out:
        add rsp, 8;
        pop r14;
        pop r12;
        ret
      }
    }
}
