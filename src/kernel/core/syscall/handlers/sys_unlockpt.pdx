// src/kernel/core/syscall/handlers/sys_unlockpt.pdx -- Wave iota (ι-02,
// paideia-os pdxterm real-body wave)
//
// sys_unlockpt(master_fd) -> 0 | -EBADF. SC+ ID 124.
//
// POSIX unlockpt(3) removes an internal lock on the slave pty device so
// it may be opened. sys_openpty (SC+ 122) hands back an already-open
// slave_fd directly -- there is no separate open-the-slave-by-path step
// and therefore no lock to remove. Byte-identical structural-validity
// posture to sys_grantpt.pdx (SC+ 123): confirms `master_fd` is a live
// PTY-tagged fd on the master side and no-ops otherwise. See sys_
// grantpt.pdx's own header for the full rationale (this file exists
// purely for API completeness alongside it).

module SysUnlockpt = structure {
  pub let SYS_UNLOCKPT_ERR_EBADF : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF (-9)

  pub let FD_TABLE_MAX : u64 = 32
  pub let PTY_FD_TAG      : u64 = 0x8000
  pub let PTY_FD_SIDE_BIT : u64 = 0x20

  // ==========================================================================
  // sys_unlockpt_body — validate master_fd is a live PTY master fd
  //
  // Input:
  //   rdi = current    (task_struct*, must be non-NULL)
  //   rsi = master_fd  (u64)
  //
  // Output:
  //   rax = 0                              on success
  //   rax = 0xFFFFFFFFFFFFFFF7 (-EBADF)    same four refusal cases as
  //         sys_grantpt_body (see that file's justification)
  // ==========================================================================
  pub let sys_unlockpt_body : (u64, u64) -> u64 !{mem} @{} =
    fn (current: u64) (master_fd: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave iota (ι-02): sys_unlockpt -- byte-identical body shape to sys_grantpt_body (structural validity check only; see that file's header for the full rationale on why there is nothing to lock/unlock at this landing). Two-push prologue (rbx=current, r12=master_fd) plus sub rsp,8 leaves rsp%16==0 for the nested fd_get calls. Labels prefixed sys_unlockpt_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                        // current
        mov r12, rsi;                        // master_fd

        cmp r12, 32;
        jae sys_unlockpt_ebadf;

        mov rdi, rbx;
        mov rsi, r12;
        call fd_get;
        cmp rax, 0;
        je  sys_unlockpt_ebadf;

        mov rdi, rax;
        call pty_fd_entry_is_pty;
        cmp rax, 0;
        je  sys_unlockpt_ebadf;

        mov rdi, rbx;
        mov rsi, r12;
        call fd_get;
        mov rdi, rax;
        call pty_fd_entry_side;
        cmp rax, 0;                          // 0 == master
        jne sys_unlockpt_ebadf;

        xor rax, rax;
        jmp sys_unlockpt_done;

      sys_unlockpt_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF

      sys_unlockpt_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
