// src/kernel/core/syscall/handlers/sys_sched_wait_ns.pdx — COMP-IMPL-07 (Wave UUU)
//
// sys_sched_wait_ns(ns) -> 0. SC+ ID 116.
//
// Ring-3 nanosecond-duration sleep. Puts the calling task into
// TASK_STATE_WAITING via a timer-wheel entry (sched/sched_wait_ns.pdx
// §sched_wait_ns) instead of the caller spinning in a ring-3 busy-wait
// loop re-reading sys_clock_read_ns — the pattern svc-compositor's
// render_loop used before this landing. The task re-enters the runqueue
// once sched_wait_ns_sweep (same file, wired into int/exceptions.pdx
// handle_timer's per-tick path) observes the deadline has elapsed.
//
// No user pointers on this syscall — a0 is a plain u64 duration, not a
// VA — so no user_ptr_ok gate and no KPTI bounce, matching
// sys_clock_read_ns_body's own posture for the same reason.
//
// [unsafe] — dispatches into scheduler state (sched_block via
// sched_wait_ns).
// Audit: design/kernel/sched-wait.md (SchedWait precedent this file's
//        wait-kind convention extends; see sched/sched_wait_ns.pdx
//        header for why a new wait_kind rather than reuse).

module SysSchedWaitNs = structure {
  // ==========================================================================
  // sys_sched_wait_ns_body(ns) -> u64 — thin tail-call into
  // SchedWaitNs.sched_wait_ns.
  //
  // Leaf shim: the real mechanism (deadline compute, TCB field writes,
  // sched_block) lives in sched/sched_wait_ns.pdx so int/exceptions.pdx's
  // handle_timer can call the sweep half (sched_wait_ns_sweep) without
  // depending on the syscall-handler layer. This body exists as its own
  // file/module per the syscall-handler-per-file convention every other
  // sysno in this directory follows (sys_kill.pdx, clock_read_ns.pdx,
  // sys_icmp_echo.pdx, ...) and to keep the dispatch shim's `call`
  // target inside the handlers/ namespace like every sibling syscall.
  //
  // Register discipline: entry rsp%16==8 (dispatch shim's `sub rsp,8`
  // pad before `call`, matching every other body in this directory).
  // No callee-save needed here — a bare tail-call with no register
  // shuffle (rdi already holds ns, exactly SchedWaitNs.sched_wait_ns's
  // own arg0). `jmp` rather than `call`+`ret` would also be legal (true
  // tail call) but this tree's convention (sys_clock_read_ns_body,
  // sys_taskinfo's per-field getters, ...) uses `call`+`ret` uniformly
  // even for single-callee bodies, so this file matches that shape
  // rather than introducing a `jmp`-tail-call idiom nothing else here
  // uses.
  pub let sys_sched_wait_ns_body : (u64) -> u64 !{mem, sysreg} @{sched, boot} =
    fn (ns: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {sched, boot},
      justification: "COMP-IMPL-07 (Wave UUU): sys_sched_wait_ns body, SC+ ID 116. Entry: rdi=ns (u64 nanoseconds), no other args, no user pointers (a plain duration value, not a VA — matches sys_clock_read_ns_body's own no-user-ptr-gate posture). Thin call-through into SchedWaitNs.sched_wait_ns(ns) (sched/sched_wait_ns.pdx), which computes deadline=hpet_now_ns()+ns, records (SCHED_WAIT_TIMER_NS, 0, deadline) into the caller's TCB (+448/+456/+480), and calls sched_block to self-suspend; returns 0 once sched_wait_ns_sweep (same file, wired into int/exceptions.pdx handle_timer's per-tick path) observes the deadline elapsed and calls sched_wake on this task. rax=0 propagates verbatim as this syscall's return value on both the immediate ns==0 fast path and the real-sleep path (SchedWaitNs.sched_wait_ns itself returns 0 in both cases). Alignment: entry rsp%16==8 (dispatch shim's `sub rsp,8` pad before `call sys_sched_wait_ns_body`, mirroring every sibling body's own alignment comment in this directory); the single nested `call sched_wait_ns` needs rsp%16==0 at the call site, so this body adds its own `sub rsp,8` / `add rsp,8` bracket around the call — same idiom sys_clock_read_ns_body uses around its own single nested `call hpet_now_ns`. No callee-save registers touched (rdi is already the correct arg0 for the callee; rax is the return value). Effects {mem,sysreg} and capabilities {sched,boot} both propagate verbatim from SchedWaitNs.sched_wait_ns's own declared set — this shim adds no additional effect or capability of its own.",
      block: {
        sub rsp, 8;                            // SysV alignment pad
        call sched_wait_ns;                    // rax = 0
        add rsp, 8;
        ret
      }
    }
}
