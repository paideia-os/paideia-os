// src/kernel/core/syscall/handlers/sys_socket.pdx — R72.M1-005 (#1927)
//
// sys_socket(domain, type, proto) -> cap_slot | -errno. SC+ ID 87.
// MVP scope: AF_INET (2) / SOCK_STREAM (1) only; proto is not
// inspected (0 or IPPROTO_TCP=6 both mean "TCP", the only protocol
// this round implements). All the real work is net/tcp_socket.pdx's
// tcp_socket_new — this body is pure ABI validation + a thin call.

module SysSocket = structure {

  pub let SYS_SOCKET_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let AF_INET     : u64 = 2
  pub let SOCK_STREAM : u64 = 1

  pub let sys_socket_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (domain: u64, sock_type: u64, proto: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_socket, SC+ ID 87. Validates domain==AF_INET(2) and sock_type==SOCK_STREAM(1) -- the only combination this MVP's TCP substrate implements (no UDP-via-socket(), no AF_UNIX); proto is accepted but not inspected since 0 and IPPROTO_TCP=6 both mean the one protocol this round has. On a mismatch: -EINVAL, no allocation touched. On a match: tail into tcp_socket_new (net/tcp_socket.pdx), which does the actual TCB-allocate + cap-mint work. No pushes needed -- neither arg survives past the validation, and the single nested call needs only an alignment pad (entry rsp%16==8; sub rsp,8 lands rsp%16==0).",
      block: {
        cmp rdi, 2;
        jne sys_socket_einval;
        cmp rsi, 1;
        jne sys_socket_einval;

        sub rsp, 8;
        call tcp_socket_new;
        add rsp, 8;
        ret;

      sys_socket_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        ret
      }
    }
}
