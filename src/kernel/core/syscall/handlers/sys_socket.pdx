// src/kernel/core/syscall/handlers/sys_socket.pdx — R72.M1-005 (#1927)
//                                                    R100-PREP-002 (#2008)
//
// sys_socket(domain, type, proto) -> cap_slot | -errno. SC+ ID 87.
//
// Scope:
//   domain = AF_INET (2)      -- only network family this MVP implements
//   type   = SOCK_STREAM (1)  -> tail-call tcp_socket_new (net/tcp_socket.pdx)
//   type   = SOCK_DGRAM  (2)  -> tail-call udp_socket_new (net/udp_socket.pdx)
//                                (R100-PREP-002 #2008: adds the SOCK_DGRAM
//                                branch. proto not inspected for either
//                                type -- 0 or the natural IPPROTO_TCP=6
//                                / IPPROTO_UDP=17 both mean the one
//                                protocol per socket type this round has.)
//
// AF_UNIX is out of scope; every mismatch (bad domain, bad type) returns
// -EINVAL without touching an allocation.

module SysSocket = structure {

  pub let SYS_SOCKET_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let AF_INET     : u64 = 2
  pub let SOCK_STREAM : u64 = 1
  pub let SOCK_DGRAM  : u64 = 2

  pub let sys_socket_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (domain: u64, sock_type: u64, proto: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008): sys_socket, SC+ ID 87. Validates domain==AF_INET(2) and dispatches on sock_type: 1 (SOCK_STREAM) -> tcp_socket_new; 2 (SOCK_DGRAM) -> udp_socket_new. Any other type or domain -> -EINVAL, no allocation touched. proto is accepted but not inspected -- 0 is the polymorphic wildcard both branches accept, and IPPROTO_TCP=6 / IPPROTO_UDP=17 are the only alternatives that would mean anything here at this round. Neither arg survives past the dispatch cmp, so no callee-save is needed; the single nested call needs only an alignment pad (entry rsp%16==8; sub rsp,8 lands rsp%16==0). Labels prefixed sys_socket_.",
      block: {
        cmp rdi, 2;                       // AF_INET
        jne sys_socket_einval;

        cmp rsi, 1;                       // SOCK_STREAM
        je sys_socket_do_tcp;
        cmp rsi, 2;                       // SOCK_DGRAM
        je sys_socket_do_udp;
        jmp sys_socket_einval;

      sys_socket_do_tcp:
        sub rsp, 8;
        call tcp_socket_new;
        add rsp, 8;
        ret;

      sys_socket_do_udp:
        sub rsp, 8;
        call udp_socket_new;
        add rsp, 8;
        ret;

      sys_socket_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        ret
      }
    }
}
