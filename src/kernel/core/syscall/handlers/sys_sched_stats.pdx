// src/kernel/core/syscall/handlers/sys_sched_stats.pdx — Wave κ (κ-04)
//
// sys_sched_stats(pid, out_ns_va) -> 0 | -ENOENT | -EFAULT | -EINVAL.
// SC+ sysno 117.
//
// Ring-3 read of a target task's cumulative CPU time in nanoseconds.
// The kernel-side substrate lives in sched/sched_stats.pdx; this file
// is the syscall boundary wrapper — user-pointer validation, ENOENT
// gate against _pid_table (task_pool.pdx), and the KPTI-safe write of
// the u64 ns value back to the caller.
//
// Contract (SysV, 2 args):
//   rdi = pid          — target pid in [1, PID_MAX=63]
//   rsi = out_ns_va    — user VA to an 8-byte destination u64
//
//   -> rax = 0 on success (u64 ns written to *out_ns_va)
//      -EFAULT (0xFFFFFFFFFFFFFFF2) — out_ns_va failed user_ptr_ok, or
//                                     user_write_bytes_via_walk faulted
//      -ENOENT (0xFFFFFFFFFFFFFFFE) — pid not present in _pid_table
//      -EINVAL (0xFFFFFFFFFFFFFFFF) — pid out of range (0 or >= 64)
//
// SYSNO 117 RATIONALE
//
// Wave UUU (COMP-IMPL-07) claimed sysno 116 for sys_sched_wait_ns (see
// dispatch.pdx L848-849). 117 is the next free slot in the low-density
// contiguous band and matches the "sched" theme of 116 — a future
// reader inspecting the sched cluster (117 sched_stats, 118+ TBD)
// sees related surfaces adjacent rather than scattered.
//
// SCRATCH BUFFER
//
// user_write_bytes_via_walk needs a kernel-side source buffer that
// survives the KPTI-bounce copy. An 8-byte per-syscall scratch lives
// here as _sys_sched_stats_out_scratch. This matches the R42-PREP-007+
// per-syscall scratch discipline every ring-3 body in this directory
// follows (sys_pdxfs_stat_by_inode's own _sys_pdxfs_stat_by_inode_out_
// scratch precedent).
//
// Audit: design/kernel/wave-kappa-scheduling.md §κ-04.

module SysSchedStats = structure {
  // ==========================================================================
  // Per-syscall scratch buffer. 8 bytes suffices for a single u64.
  // ==========================================================================
  pub let mut _sys_sched_stats_out_scratch : [u64; 1] = [0]

  // ==========================================================================
  // sys_sched_stats_body(pid, out_ns_va) -> u64
  // ==========================================================================
  pub let sys_sched_stats_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pid: u64, out_ns_va: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "Wave κ (κ-04): sys_sched_stats body, SC+ sysno 117. Entry: rdi=pid, rsi=out_ns_va. 2-push callee-save prologue (rbx=out_ns_va, r12=pid) — entry rsp%16==8, 2 pushes -> 8; every nested call brackets with sub rsp,8/add rsp,8 so the SysV %16==0 requirement holds at each call boundary. Sequence: (1) EINVAL gate: pid==0 or pid>=64 -> -EINVAL. (2) user_ptr_ok(out_ns_va, 8) -> 0 or 1; non-zero -> -EFAULT. Rejects a kernel-half destination up-front (matches sys_pdxfs_stat_by_inode step 1). (3) pid_alive(pid) — task_pool.pdx §pid_alive returns 1 iff _pid_table[pid] names a live task slab. 0 -> -ENOENT. Gates on liveness rather than pid_gen_read (which persists across pid_free per #1583); a reaped pid should read as ENOENT, not surface stale ns. (4) sched_stats_read(pid) -> rax=ns; store into _sys_sched_stats_out_scratch. (5) user_write_bytes_via_walk(out_ns_va, &scratch, 8) -> 0 or -EFAULT. (6) Success: rax=0. All error arms jmp sss_done via shared exit. Effects {mem, sysreg}: mem for scratch/array reads and TCB reads via pid_alive; sysreg transitive from user_write_bytes_via_walk's walker. Capability {cap}: forward-compat annotation for a future per-task VOL_RIGHT gate on stats (matches sys_stat's own posture, sys_stat.pdx L226). Labels prefixed sss_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rsi;                          // rbx = out_ns_va (survives calls)
        mov r12, rdi;                          // r12 = pid

        // (1) EINVAL gate.
        cmp r12, 0;
        je  sss_einval;
        cmp r12, 64;
        jae sss_einval;

        // (2) user_ptr_ok(out_ns_va, 8).
        mov rdi, rbx;
        mov rsi, 8;
        sub rsp, 8;
        call user_ptr_ok;
        add rsp, 8;
        cmp rax, 0;
        jne sss_efault;

        // (3) pid_alive(pid).
        mov rdi, r12;
        sub rsp, 8;
        call pid_alive;
        add rsp, 8;
        cmp rax, 0;
        je  sss_enoent;

        // (4) sched_stats_read(pid) -> ns; stash into scratch.
        mov rdi, r12;
        sub rsp, 8;
        call sched_stats_read;
        add rsp, 8;
        lea rcx, [rip + _sys_sched_stats_out_scratch];
        mov [rcx], rax;

        // (5) user_write_bytes_via_walk(out_ns_va, &scratch, 8).
        mov rdi, rbx;
        lea rsi, [rip + _sys_sched_stats_out_scratch];
        mov rdx, 8;
        sub rsp, 8;
        call user_write_bytes_via_walk;
        add rsp, 8;
        cmp rax, 0;
        jne sss_efault;

        xor rax, rax;                          // success
        jmp sss_done;

      sss_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sss_done;

      sss_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        jmp sss_done;

      sss_einval:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      sss_done:
        pop r12;
        pop rbx;
        ret
      }
    }
}
