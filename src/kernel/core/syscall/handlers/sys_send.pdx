// src/kernel/core/syscall/handlers/sys_send.pdx — R72.M1-005 (#1927)
//                                                  R100-PREP-002 (#2008)
//
// sys_send(fd, buf_va, len) -> bytes_sent | -errno. SC+ ID 92.
// Capped at 1024 bytes per call (POSIX short-write semantics for TCP:
// a caller asking for more gets fewer bytes back and calls again).
// For UDP the same cap doubles as the per-datagram maximum
// (UDP_DGRAM_MAX in net/udp_socket.pdx == 1024), and the semantics
// change: EXACTLY ONE datagram per call, no split.
//
// Bounced through a kernel-side scratch (this file's own convention,
// matching dispatch.pdx's per-syscall bounce-buffer discipline) before
// handing to tcp_send_segment (TCP) or udp_socket_send_body (UDP).
//
// Dispatch by cap kind (via the generic tcp_socket_resolve):
//   KIND_TCP_SOCKET (0x1AB) -> tcp_send_segment(tcb_idx, ACK|PSH,
//                              scratch, len)  [ESTABLISHED required].
//   KIND_UDP_SOCKET (0x1A8) -> udp_socket_send_body(sock_idx, scratch,
//                              len)  [CONNECTED required].
//   any other / not a socket -> -EBADF.

module SysSend = structure {

  pub let SYS_SEND_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let SYS_SEND_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)
  pub let SYS_SEND_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT   (-14)
  pub let SYS_SEND_EACCES   : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES   (-13)
  pub let SYS_SEND_MAX      : u64 = 1024

  pub let mut _sys_send_scratch : [u8; 1024] = uninit @align(8)

  pub let sys_send_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008): sys_send, SC+ ID 92. Caps len at 1024 (SYS_SEND_MAX == UDP_DGRAM_MAX). Resolves fd first as KIND_TCP_SOCKET; on hit, executes the R72 TCP branch (ESTABLISHED gate + tcp_send_segment(ACK|PSH)). On TCP miss, resolves as KIND_UDP_SOCKET; on hit, calls udp_socket_send_body(sock_idx, scratch, len) which requires CONNECTED and delivers one datagram (loopback fast path or, for off-box, the deferred R93.M2 wire stub). Both miss -> -EBADF. Bounce buffer is _sys_send_scratch (1 KiB, shared across both branches -- sys_send is per-syscall, non-reentrant, so a single scratch is safe). user_ptr_ok gates the range BEFORE user_read_bytes_via_walk performs the strict-KPTI-safe per-byte copy into _sys_send_scratch. 3-push callee-save (rbx=target_idx after resolve, r12=buf_va, r13=capped_len): entry rsp%16==8, three pushes (24 bytes) land rsp%16==0. Neither TCP nor UDP branch keeps a socket-row pointer alive across a nested call (both look up state via a re-computed row_ptr held in a caller-save reg for the state check only), matching the R72 body's discipline. Reserved labels: sys_send_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rax, 1024;
        cmp r13, rax;
        jbe sys_send_len_ok;
        mov r13, rax;
      sys_send_len_ok:

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_send_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;                        // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_send_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp sys_send_done;

      sys_send_have_tcp:
        // R95.M4-001 (paideia-os #2083): send requires R_SOCKET_WRITE.
        // rsp%16==0 after the 3-push prologue; push rax -> 8, sub rsp,8
        // -> 0 for the call, then reverse.
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x002;                        // R_SOCKET_WRITE
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_send_eaccess;
        jmp sys_send_do_tcp;

      sys_send_have_udp:
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x002;                        // R_SOCKET_WRITE
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_send_eaccess;
        jmp sys_send_do_udp;

      sys_send_do_tcp:
        mov rbx, rax;                          // tcb_idx

        // Require TCP_ST_ESTABLISHED (@+0 == 4).
        mov rcx, rbx;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;
        mov rdx, [rcx + 0];
        cmp rdx, 4;
        jne sys_send_enotconn;

        // KPTI-safe bounce copy user -> scratch.
        mov rdi, r12;
        mov rsi, r13;
        call user_ptr_ok;
        cmp rax, 0;
        jne sys_send_efault;

        lea rdi, [rip + _sys_send_scratch];
        mov rsi, r12;
        mov rdx, r13;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sys_send_efault;

        mov rdi, rbx;
        mov rsi, 0x18;                          // ACK|PSH
        lea rdx, [rip + _sys_send_scratch];
        mov rcx, r13;
        call tcp_send_segment;

        mov rax, r13;
        jmp sys_send_done;

      sys_send_do_udp:
        mov rbx, rax;                          // sock_idx

        // Require UDP_ST_CONNECTED (@+0 == 2).
        mov rcx, rbx;
        shl rcx, 7;
        lea rdx, [rip + _udp_socket_table];
        add rcx, rdx;
        mov rdx, [rcx + 0];
        cmp rdx, 2;
        jne sys_send_enotconn;

        // KPTI-safe bounce copy user -> scratch.
        mov rdi, r12;
        mov rsi, r13;
        call user_ptr_ok;
        cmp rax, 0;
        jne sys_send_efault;

        lea rdi, [rip + _sys_send_scratch];
        mov rsi, r12;
        mov rdx, r13;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sys_send_efault;

        mov rdi, rbx;
        lea rsi, [rip + _sys_send_scratch];
        mov rdx, r13;
        call udp_socket_send_body;
        // udp_socket_send_body returns bytes on success, -ENOTCONN on
        // a state-race (should not happen -- we checked above -- but
        // pass through to be honest). If it returned a negative errno,
        // rax carries that; otherwise it carries r13. Either way, forward.
        jmp sys_send_done;

      sys_send_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_send_done;

      sys_send_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sys_send_done;

      sys_send_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;           // -EACCES

      sys_send_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
