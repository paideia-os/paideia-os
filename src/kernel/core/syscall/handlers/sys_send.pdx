// src/kernel/core/syscall/handlers/sys_send.pdx — R72.M1-005 (#1927)
//
// sys_send(fd, buf_va, len) -> bytes_sent | -errno. SC+ ID 92.
// Capped at 1024 bytes per call (POSIX short-write semantics: a caller
// asking for more gets fewer bytes back and calls again), bounced
// through a kernel-side scratch (this file's own convention, matching
// dispatch.pdx's per-syscall bounce-buffer discipline) before handing
// the segment to net/tcp.pdx's tcp_send_segment.

module SysSend = structure {

  pub let SYS_SEND_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let SYS_SEND_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)
  pub let SYS_SEND_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT   (-14)
  pub let SYS_SEND_MAX      : u64 = 1024

  pub let mut _sys_send_scratch : [u8; 1024] = uninit @align(8)

  pub let sys_send_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_send, SC+ ID 92. Caps len at 1024 (SYS_SEND_MAX) before touching anything -- short-write semantics, matching dispatch.pdx's DISPATCH_IO_MAX discipline for sys_read/sys_write. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. Requires TCP_ST_ESTABLISHED (@+0==4) -- -ENOTCONN otherwise (no half-open write-before-handshake-completes path at this MVP). user_ptr_ok gates the range BEFORE user_read_bytes_via_walk performs the strict-KPTI-safe per-byte copy into _sys_send_scratch (both helpers per syscall/ptr_check.pdx + syscall/user_read.pdx, the same pair dispatch.pdx's older bounce-buffer callers use, applied here at the BODY layer per the newer sys_chdir/sys_getcwd convention rather than at the dispatch shim). tcp_send_segment(tcb_idx, ACK|PSH=0x18, scratch_ptr, capped_len) then builds and (for a loopback peer) synchronously delivers the segment. 3-push callee-save (rbx=tcb_idx after resolve, r12=buf_va, r13=capped_len): entry rsp%16==8, three pushes (24 bytes) land rsp%16==0 -- no further pad needed for any of the four nested calls. tcb_ptr is NOT kept live across a call here (unlike sys_recv, which must re-read rx_head after its copy) -- it is read once for the state check and never needed again, so it stays in a caller-save register (rcx) safely. Reserved labels: sys_send_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rax, 1024;
        cmp r13, rax;
        jbe sys_send_len_ok;
        mov r13, rax;
      sys_send_len_ok:

        mov rdi, rbx;
        mov rsi, 0x1A5;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_send_ebadf;

        mov rbx, rax;                          // tcb_idx

        mov rcx, rbx;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;
        mov rdx, [rcx + 0];
        cmp rdx, 4;
        jne sys_send_enotconn;

        mov rdi, r12;
        mov rsi, r13;
        call user_ptr_ok;
        cmp rax, 0;
        jne sys_send_efault;

        lea rdi, [rip + _sys_send_scratch];
        mov rsi, r12;
        mov rdx, r13;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sys_send_efault;

        mov rdi, rbx;
        mov rsi, 0x18;                          // ACK|PSH
        lea rdx, [rip + _sys_send_scratch];
        mov rcx, r13;
        call tcp_send_segment;

        mov rax, r13;
        jmp sys_send_done;

      sys_send_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_send_done;

      sys_send_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_send_done;

      sys_send_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;

      sys_send_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
