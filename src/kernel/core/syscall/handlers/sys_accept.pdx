// src/kernel/core/syscall/handlers/sys_accept.pdx — R72.M1-005 (#1927)
//
// sys_accept(fd) -> new_fd | -errno. SC+ ID 90. Non-blocking at this
// MVP: no pending completed connection returns -EAGAIN immediately
// rather than parking the caller in a wait queue -- a real blocking
// accept() needs the scheduler-block plumbing sys_wait4/#724-D5a
// already established elsewhere in this tree, wiring that in for
// sockets is left to a follow-up round.

module SysAccept = structure {

  pub let SYS_ACCEPT_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_ACCEPT_EAGAIN : u64 = 0xFFFFFFFFFFFFFFF5   // -EAGAIN (-11)

  pub let sys_accept_body : (u64) -> u64 !{mem} @{cap} =
    fn (fd: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_accept, SC+ ID 90. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_LISTENER) -- -EBADF on a miss (including a fd naming a plain KIND_TCP_SOCKET rather than a listener; listen() must run first). tcp_accept_pending(listener_idx) then answers whether a child TCB has completed its handshake: TCP_NONE means still-handshaking-or-nothing-pending, surfaced as -EAGAIN rather than blocking. On a hit, tcp_socket_mint_child wraps the already-claimed child TCB in a fresh KIND_TCP_SOCKET cap and that new slot is the return value. 1-push callee-save (rbx=fd, though unused past the first call -- kept for symmetry with the sibling handlers rather than eliding the save for one dead register): entry rsp%16==8, one push lands rsp%16==0 for all three sequential nested calls.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        mov rsi, 0x1AC;                        // KIND_TCP_LISTENER (fix#2005)
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_accept_ebadf;

        mov rdi, rax;
        call tcp_accept_pending;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_accept_eagain;

        mov rdi, rax;
        call tcp_socket_mint_child;
        jmp sys_accept_done;

      sys_accept_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_accept_done;

      sys_accept_eagain:
        mov rax, 0xFFFFFFFFFFFFFFF5;

      sys_accept_done:
        pop rbx;
        ret
      }
    }
}
