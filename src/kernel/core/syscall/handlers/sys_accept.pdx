// src/kernel/core/syscall/handlers/sys_accept.pdx — R72.M1-005 (#1927)
//                                                    R94.M4-001 (#2068)
//
// sys_accept(fd) -> new_fd | -errno. SC+ ID 90. R94.M4-001 replaces
// R72's -EAGAIN-on-no-pending posture with a real blocking behavior
// via sched_wake_block: no pending completed connection registers the
// current task as _tcp_accept_waiter and sched_blocks; the RX path
// (tcp_rx_handle after a listener's backlog fills) fires
// tcp_wake_accept_if_any which sched_wakes the parked task. On resume
// we re-check tcp_accept_pending once and return.
//
// The non-blocking mode (returning -EAGAIN immediately) is available
// via the O_NONBLOCK-equivalent flag hooked up by R94.M4-002 (a
// setsockopt-shape widening). MVP default: blocking. Deferred: multi-
// caller accept() on a single listener -- a bitmap over waiter TCBs
// replaces the single-slot table in the follow-up round.

module SysAccept = structure {

  pub let SYS_ACCEPT_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_ACCEPT_EAGAIN : u64 = 0xFFFFFFFFFFFFFFF5   // -EAGAIN (-11)
  pub let SYS_ACCEPT_EACCES : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES (-13)

  pub let sys_accept_body : (u64) -> u64 !{sysreg, mem} @{cap, sched, boot} =
    fn (fd: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {cap, sched, boot},
      justification: "R72.M1-005 + R94.M4-001 (#1927/#2068): sys_accept, SC+ ID 90. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_LISTENER) -- -EBADF on a miss (including a fd naming a plain KIND_TCP_SOCKET). Rights-check R_SOCKET_LISTEN. tcp_accept_pending returns child TCB idx or TCP_NONE. R94 blocking path: TCP_NONE with a waiter-empty slot registers _current_tcb as the listener's waiter and calls sched_block; on resume re-checks tcp_accept_pending once and either mints the child cap or returns -EAGAIN (in the odd case where the wake happened but the pending slot was cleared out from under us -- defensive). 2-push callee-save (rbx=fd, r12=listener_idx across sched_block) + sub rsp,8: entry rsp%16==8, 2 pushes 16B -> %16==8, sub 8 -> 0 for every nested call.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        mov rdi, rbx;
        mov rsi, 0x1AC;                        // KIND_TCP_LISTENER (fix#2005)
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_accept_ebadf;
        mov r12, rax;                          // listener_idx

        // Rights check.
        mov rdi, rbx;
        mov rsi, 0x004;                        // R_SOCKET_LISTEN
        call sock_cap_check_rights;
        cmp rax, 0;
        jne sys_accept_eaccess;

      sys_accept_check:
        mov rdi, r12;
        call tcp_accept_pending;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_accept_have_child;

        // R94.M4-001: block on the listener. Refuse to double-register.
        mov rax, r12; shl rax, 3;
        lea rcx, [rip + _tcp_accept_waiter_table];
        add rcx, rax;
        mov rax, [rcx + 0];
        cmp rax, 0;
        jne sys_accept_eagain;                 // another waiter already parked

        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je sys_accept_eagain;                  // no current task (boot path); fall through
        mov [rcx + 0], rax;

        call sched_block;
        // On resume the wake side has already cleared our slot. Re-check.
        jmp sys_accept_check;

      sys_accept_have_child:
        mov rdi, rax;
        call tcp_socket_mint_child;
        jmp sys_accept_done;

      sys_accept_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_accept_done;

      sys_accept_eagain:
        mov rax, 0xFFFFFFFFFFFFFFF5;
        jmp sys_accept_done;

      sys_accept_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;           // -EACCES

      sys_accept_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
