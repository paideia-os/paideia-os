// src/kernel/core/syscall/handlers/sys_readlink.pdx -- Wave λ (λ-02)
//
// SYS_READLINK -- ring-3 readlink syscall body + dispatch shim (sysno 126).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Wave λ filesystem improvement plan (α-τ), item λ-02:
//
//   "sys_readlink(path: *u8, buf: *u8, bufsize: u64) -> u64 (bytes
//    written, or -EINVAL if target not a symlink, -ENOENT if missing).
//    Sysno 126 (fresh, above the current cmp rdi, 124 bounds gate;
//    Linux convention 89 is already claimed by sys_listen).  Body:
//    path_resolve -> vfs_readlink -> check S_IFLNK bit -> if symlink,
//    read backing string into buf, return length; else -EINVAL."
//
// The vops_readlink dispatcher (VOPS_READLINK_OFFSET=96) does the
// type-gate on its own inside each backend's adapter (tmpfs_readlink
// gates on inode.type == 3 = LNK; pdxfs stubs refuse outright), so
// the syscall body only needs to walk the caller's path + buffer,
// dispatch through vops, and marshal the result to user space via
// user_write_bytes_via_walk.
//
// -----------------------------------------------------------------------------
// Composition
// -----------------------------------------------------------------------------
//
// sys_readlink_body:
//   (1) Cap bufsize at SYS_READLINK_BUF_MAX = 256 (matches the tmpfs
//       symlink pool slot; a larger caller-provided buffer sees a
//       short-read).
//   (2) user_ptr_ok(buf_va, capped_bufsize) -> reject any kernel-half
//       buf up front (defence-in-depth per #741).  Failure -> -EFAULT.
//   (3) user_read_str_via_walk(path_va, &_sys_readlink_path_scratch,
//       cap=256) -> strlen or 0 on fault.  0 -> -EFAULT.
//   (4) mount_root_vnode() -> root_idx.  0 -> -ENOENT.
//   (5) path_resolve(&scratch, root_idx, cwd from TASK_OFF_CWD +160)
//       -> vnode_idx.  0 -> -ENOENT.
//   (6) vnode_slot(vnode_idx) -> &vnode.
//   (7) vops_readlink(&vnode, &_sys_readlink_buf_scratch, capped_bufsize)
//       -> byte count on success, -EINVAL if not a symlink, or
//       VOPS_ERR_NOT_SUPPORTED sentinel.  Sign-test rax: negative
//       values pass through as-is; positive values proceed to walker.
//   (8) user_write_bytes_via_walk(buf_va, kernel_src=&_sys_readlink_buf_
//       scratch, len=rax) -> 0 or -EFAULT.  Non-zero -> -EFAULT.
//   (9) Return byte count (rax from step 7).
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
//   > 0                          -- byte count written (success)
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- user_ptr_ok / walker rejected
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- missing mount root or path_resolve
//                                    returned 0
//   0xFFFFFFFFFFFFFFEA (-EINVAL) -- target is not a symlink
//                                    (backend-adapter refusal)
//   0xFFFFFFFFFFFFFFFF (VOPS_ERR_NOT_SUPPORTED) -- backend has no wired
//                                    readlink body; treated as -EINVAL
//                                    for ring-3 (ls tolerates it as
//                                    "not a symlink")
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// !{mem, sysreg} @{cap} -- symmetric to sys_symlink_body / sys_stat_body.
//
// -----------------------------------------------------------------------------
// Reserved-label / mov_b / test discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `sysrdl_`.  No `test` mnemonic.  No mov_b in this body
// (walker handles byte granularity).

module SysReadlink = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_READLINK_ERR_ENOENT : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_READLINK_ERR_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYS_READLINK_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA

  pub let SYS_READLINK_PATH_MAX   : u64 = 256
  pub let SYS_READLINK_BUF_MAX    : u64 = 256

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Path bounce scratch: kernel dst for the walker's copy-in of the
  // caller's path_va.  Same discipline as _sys_mkdir_path_scratch.
  pub let mut _sys_readlink_path_scratch : [u8; 256] = uninit @align(8)

  // Result bounce scratch: kernel dst for vops_readlink's target-string
  // copy.  Symmetric to _dispatch_taskinfo_scratch / _dispatch_pdxfs_dir_
  // scratch: the backend adapter writes into this kernel VA scratch and
  // the syscall body then walk-copies out to the user buf via user_write_
  // bytes_via_walk.  Keeps the backend adapter's contract ("buf is a
  // kernel VA") unchanged and confines the trust-boundary walk to the
  // syscall boundary.
  pub let mut _sys_readlink_buf_scratch  : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_readlink_body(path_va, buf_va, bufsize) -> u64
  //
  // SysV: rdi = path_va, rsi = buf_va, rdx = bufsize
  //   -> rax = byte count on success, or -EFAULT / -ENOENT / -EINVAL
  //      sentinel.
  //
  // Register plan (5-push callee-save; entry rsp%16==8 + 40 = %16==0
  // for nested calls; matches sys_stat_body's 5-push discipline):
  //   rbx = buf_va       (survives across all nested calls; consumed
  //                        at step 8 as walker dst)
  //   r12 = bufsize      (capped; consumed at step 7 as vops arg + at
  //                        step 8 as walker len; kept live throughout)
  //   r13 = path_va      (initial walker arg0; repurposed to root_idx
  //                        after step 4; repurposed to bytecount rax
  //                        after step 7 across the walker in step 8)
  //   r14 = vnode_idx    (result of step 5; consumed at step 6)
  //   r15 = &vnode       (result of step 6; consumed at step 7)
  // ==========================================================================
  pub let sys_readlink_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_va: u64) (buf_va: u64) (bufsize: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "Wave λ (λ-02): sys_readlink body -- ring-3 readlink syscall (sysno 126). Walks user path into kernel .bss scratch via user_read_str_via_walk, resolves via mount_root_vnode + path_resolve (cwd from TASK_OFF_CWD), dispatches through the Wave λ vops_readlink slot (VOPS_READLINK_OFFSET=96) to the per-backend adapter (tmpfs: real; pdxfs_lite / pdxfs_block: refusal stubs), then walk-copies the resulting kernel scratch buffer out to the caller via user_write_bytes_via_walk. 5-push callee-save prologue (rbx=buf_va, r12=capped bufsize, r13=multi-role, r14=vnode_idx, r15=&vnode) leaves rsp%16==0 (entry %16==8 - 40 = %16==0) which is SysV-correct at nested call sites (matches sys_stat_body's 5-push discipline). Body: (1) Cap bufsize at SYS_READLINK_BUF_MAX=256; save to r12. (2) user_ptr_ok(buf_va, r12) -> 0/1. Non-zero -> EFAULT. (3) user_read_str_via_walk(path_va=r13, &_sys_readlink_path_scratch, cap=256) -> strlen or 0. 0 -> EFAULT. (4) mount_root_vnode -> root_idx. 0 -> ENOENT. Save into r13. (5) path_resolve(&scratch, r13, cwd@+160) -> vnode_idx. 0 -> ENOENT. Save into r14. (6) vnode_slot(r14) -> &vnode. Save into r15. (7) vops_readlink(r15, &_sys_readlink_buf_scratch, r12) -> byte count on success, -EINVAL / -ENOSUP on failure. Sign-test: bit 63 set -> pass through as -EINVAL (both backend -EINVAL 0xFFFFFFFFFFFFFFEA and VOPS_ERR_NOT_SUPPORTED 0xFFFFFFFFFFFFFFFF have bit 63 set, treated uniformly as 'not a symlink' for ring-3). (8) user_write_bytes_via_walk(rbx=buf_va, &scratch, rax=byte count) -> 0 or -EFAULT. Non-zero -> EFAULT. (9) Return byte count (r13 stash). Labels prefixed sysrdl_. No test; no mov_b in this body (walker owns byte granularity). Encoder discipline: sign-test uses `cmp rax, 0; jl` (jl = signed less than), which the encoder accepts.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // 5 pushes (40) + entry %16==8 = 48, %16==0 at nested call sites.

        mov rbx, rsi;                    // rbx = buf_va (survives all calls)
        mov r12, rdx;                    // r12 = bufsize (raw)
        mov r13, rdi;                    // r13 = path_va

        // ---- (1) Cap bufsize at SYS_READLINK_BUF_MAX = 256 ----
        mov rax, 256;
        cmp r12, rax;
        jbe sysrdl_bs_ok;
        mov r12, rax;
      sysrdl_bs_ok:
        // Refuse zero-sized buf (caller has nowhere for a link target).
        cmp r12, 0;
        je  sysrdl_efault;

        // ---- (2) user_ptr_ok(buf_va, bufsize) ----
        mov rdi, rbx;
        mov rsi, r12;
        call user_ptr_ok;                // rax = 0 (OK) or 1 (fault)
        cmp rax, 0;
        jne sysrdl_efault;

        // ---- (3) user_read_str_via_walk(path_va, path_scratch, cap=256) ----
        mov rdi, r13;
        lea rsi, [rip + _sys_readlink_path_scratch];
        mov rdx, 256;
        call user_read_str_via_walk;
        cmp rax, 0;
        je  sysrdl_efault;

        // ---- (4) mount_root_vnode() ----
        call mount_root_vnode;
        cmp rax, 0;
        je  sysrdl_enoent;
        mov r13, rax;                    // r13 = root_idx (path_va dead)

        // ---- (5) path_resolve(kernel_path, root_idx, cwd) ----
        lea rdi, [rip + _sys_readlink_path_scratch];
        mov rsi, r13;
        mov rax, [rip + _current_tcb];
        mov rdx, [rax + 160];            // cwd (TASK_OFF_CWD)
        call path_resolve;
        cmp rax, 0;
        je  sysrdl_enoent;
        mov r14, rax;                    // r14 = vnode_idx

        // ---- (6) vnode_slot(vnode_idx) -> &vnode ----
        mov rdi, r14;
        call vnode_slot;
        mov r15, rax;                    // r15 = &vnode

        // ---- (7) vops_readlink(&vnode, buf_scratch, bufsize) ----
        mov rdi, r15;
        lea rsi, [rip + _sys_readlink_buf_scratch];
        mov rdx, r12;                    // capped bufsize
        call vops_readlink;              // rax = byte count or -errno / -nosup

        // Sign-test: rax < 0 (bit 63 set) -> pass through as EINVAL
        // (uniform 'not a symlink' shape for ring-3; both -EINVAL and
        // VOPS_ERR_NOT_SUPPORTED land here).  Then rax == 0 -> return 0
        // (empty target / nothing to copy).  The `je` reuses ZF from the
        // preceding `cmp rax, 0` without a second cmp — jl only fires
        // for strictly-negative rax and clears ZF, so falling through
        // preserves the flags for the je test.
        cmp rax, 0;
        jl  sysrdl_einval;
        je  sysrdl_done_zero;

        // ---- (8) user_write_bytes_via_walk(buf_va, scratch, rax) ----
        mov r13, rax;                    // stash byte count across walker
        mov rdi, rbx;                    // arg0 = user buf_va
        lea rsi, [rip + _sys_readlink_buf_scratch];
        mov rdx, r13;                    // arg2 = byte count
        call user_write_bytes_via_walk;  // rax = 0 or -EFAULT
        cmp rax, 0;
        jne sysrdl_efault;

        // ---- (9) Success return ----
        mov rax, r13;                    // rax = byte count
        jmp sysrdl_done;

      sysrdl_done_zero:
        xor rax, rax;
        jmp sysrdl_done;

      sysrdl_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        jmp sysrdl_done;

      sysrdl_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sysrdl_done;

      sysrdl_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      sysrdl_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
