// src/kernel/core/syscall/handlers/sched_affinity.pdx — #1582 part B
// sys_sched_setaffinity / sys_sched_getaffinity + LP-E class reservation.
//
// Three bodies live in one module because they share one field (TCB.cpu_mask
// at +128) and one global (_reserved_lpe_task_pid) and are wired into the
// scheduler at one place (sched_pick_next_r15 in src/kernel/core/sched/
// pick_next.pdx). Splitting them across files would make the (TCB layout,
// scheduler consult, syscall entry) triple three files instead of two.
//
// -----------------------------------------------------------------------------
// TCB field: TCB_OFF_CPU_MASK (=128) — u64
// -----------------------------------------------------------------------------
//
// Placed at TCB byte offset +128. Fits inside the pre-existing R15 task_struct
// (TASK_STRUCT_BYTES = 2224) — no new qword required, no verify-task-pool-
// bounds.sh rewrite, no bump to TASK_STRUCT_QWORDS or the 19 standalone slabs
// pinned by that gate. The slot is one of the "56-byte gap +112..+167 was
// R11-era callee-save spill space that R15 task_struct never wrote — verified
// clean via grep for +112/+120/+128/+136/+144/+152 memops across the R15
// sched/syscall paths" range documented in task_pool.pdx §TASK_OFF_SCHED_BUDGET
// and cross-referenced in state.pdx §TASK_OFF_WAIT_ENDPOINT_ID.
//
// The R11-era slots at +128 / +136 are used only by sched/preempt.pdx (R11
// preemption of R10-era 23-qword TCBs) and sched/switch.pdx §sched_switch_regs
// (R10 2-task witness), both of which operate on distinct static slabs
// (_task_a_tcb, _task_b_tcb, _runq_witness_task_N — all sized to fit their
// own R11 layout with +128/+136 as legitimate scratch). Neither touches a
// modern R15 task_struct at +128, so we own the slot on this side.
//
// Semantics:
//   cpu_mask == 0  ⇒ "all CPUs allowed" (the default after task_new's
//                    rep_stosq zero-init — no explicit setter call required
//                    for tasks that never care about affinity)
//   cpu_mask != 0  ⇒ eligible on CPU c iff (cpu_mask & (1 << c)) != 0
//
// This treatment of 0 as "wildcard rather than empty" is deliberate: it lets
// every existing witness task (sched_witness_*_tcb, sys_*_witness_task, and
// every pool-allocated task before the first setaffinity call) participate
// in scheduling without an eager setter call at task_new time. The setter
// refuses an explicit 0 mask with -EINVAL for the same reason POSIX
// sched_setaffinity refuses one: a task with no eligible CPUs is a defect
// waiting to deadlock the scheduler.
//
// -----------------------------------------------------------------------------
// Global: _reserved_lpe_task_pid — u64
// -----------------------------------------------------------------------------
//
// 0 = unreserved. Non-zero = the pid whose task the scheduler prefers when
// dispatching on a class-3 (LP-E) core. Set via sys_reserve_lpe_class(pid);
// idempotent when the caller passes the same pid it previously reserved,
// refused with -EEXIST when a different pid is already there. No release
// primitive at MVP — the reservation lasts for the boot. Future work
// (design/multicore/lpe-reservation.md placeholder) will add release, per-
// process quota, and re-arm on driver restart; the R31.M0 scope is one
// permanent reservation, exercised end-to-end by the AML executor task
// (#1087) which reserves LP-E via sys_reserve_lpe_class to sidestep P-core
// scheduling jitter.
//
// The reservation is a HINT to sched_pick_next_r15, not a hard binding: if
// the reserved task is not runnable on the current LP-E core (e.g. blocked
// on IPC, or its cpu_mask excludes this CPU) the picker falls through to
// the standard affinity walk. This keeps the reservation from starving the
// LP-E core when the reserved task is idle — a strict binding would leave
// the core running the idle TCB while other affinity-eligible tasks wait.
//
// Cross-references:
//   src/kernel/core/sched/pick_next.pdx §sched_pick_next_r15 (consumer)
//   src/kernel/core/syscall/dispatch.pdx §dispatch_sched_setaffinity et al
//   src/kernel/core/smp/topology.pdx §CPU class 3 = LP-E
//   src/kernel/core/smp/percpu.pdx §PERCPU_OFF_HYBRID_CLASS (+120)
//
// [unsafe] — TCB field writes (setaffinity) + module-scope u64 store
// (reserve). No user pointers cross this file.
// Audit: no wire fingerprint here; the R30 witness
//        (tests/kernel/syscall/sched_affinity_synth.pdx) carries the
//        acceptance signal.

module SchedAffinity = structure {
  // ============================================================================
  // Layout
  // ============================================================================

  // TCB byte offset of the cpu_mask field (u64). See file header for the
  // placement rationale — inside the R11-era-spill gap that the R15 task_struct
  // never writes. task_new's rep_stosq of 278 qwords covers this slot at zero,
  // so every freshly-constructed task starts with cpu_mask == 0 (== "all CPUs
  // allowed" per the semantics above).
  pub let TCB_OFF_CPU_MASK : u64 = 128

  // ============================================================================
  // Errno sentinels (Linux-style negative-errno u64)
  // ============================================================================
  //
  // Matches the sign-testable-with-`jl` convention used across the syscall
  // dispatch layer (dispatch.pdx §ipc_slot_to_endpoint returns -EBADF and
  // -EACCES the same way).
  pub let SYS_SCHED_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -22
  pub let SYS_SCHED_ERR_EEXIST : u64 = 0xFFFFFFFFFFFFFFEF   // -17

  // ============================================================================
  // Global: LP-E reservation slot (0 == unreserved)
  // ============================================================================
  //
  // Single u64 in .bss. .bss-zero == 0 == unreserved is exactly the encoding
  // sys_reserve_lpe_class_body checks against, so no explicit init is needed
  // at boot. Concurrent-write race: at R31.M0 there is no cross-CPU concurrent
  // sys_reserve_lpe_class caller (single ring-3 process, single reservation
  // by construction); if two callers ever race, the loser sees the winner's
  // pid in the guard and returns -EEXIST — same shape as POSIX file creation
  // with O_EXCL. Widening to a per-class array or per-CPU reservation is
  // deferred to design/multicore/lpe-reservation.md.
  pub let mut _reserved_lpe_task_pid : u64 = 0

  // ============================================================================
  // CPU-mask width — MAX_CPUS from Percpu (=4 at R18.M1 ceiling).
  //
  // Any bit set beyond bit MAX_CPUS-1 is refused with -EINVAL. Duplicating
  // the literal here (rather than a cross-module reference) matches the
  // paideia-as constant-inlining discipline that state.pdx documents:
  // paideia-as does not resolve cross-module `let` at parse time, so every
  // consumer inlines the number. Kept in one place per file for auditability.
  //
  // (1 << 4) - 1 = 0x0F. A mask with any bit at position >= 4 fails
  // `(mask & ~0x0F) == 0`, i.e. `mask & 0xFFFFFFFFFFFFFFF0` is non-zero.
  pub let SYS_SCHED_CPU_MASK_VALID : u64 = 0xF                    // (1 << MAX_CPUS) - 1
  pub let SYS_SCHED_CPU_MASK_INVALID : u64 = 0xFFFFFFFFFFFFFFF0   // ~SYS_SCHED_CPU_MASK_VALID

  // ============================================================================
  // sys_sched_setaffinity_body(current: u64, cpu_mask: u64) -> i64
  // ============================================================================
  //
  // Writes cpu_mask into current TCB at TCB_OFF_CPU_MASK (+128). The
  // dispatch shim loads _current_tcb into rdi before the call.
  //
  // Refusals:
  //   cpu_mask == 0                                     → -EINVAL
  //   cpu_mask & SYS_SCHED_CPU_MASK_INVALID != 0        → -EINVAL
  //     (any bit beyond MAX_CPUS-1)
  //
  // Success: rax = 0, TCB.cpu_mask := cpu_mask.
  //
  // Register plan (leaf, no nested call):
  //   rdi = current (in), consumed
  //   rsi = cpu_mask (in), consumed
  //   rax = return code
  //   rcx = scratch for mask-validation
  //
  // No callee-save touched; the whole body is `cmp / je / and / jne / mov`
  // with no memory-effecting call.
  pub let sys_sched_setaffinity_body : (u64, u64) -> u64 !{mem} @{} =
    fn (current: u64) (cpu_mask: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "#1582 part B: write cpu_mask into current TCB at TCB_OFF_CPU_MASK (+128). Two-gate validation before the store: (1) cpu_mask == 0 -> -EINVAL — a task with no eligible CPUs would deadlock the scheduler the moment sched_pick_next_r15 tried to run it (matches POSIX sched_setaffinity's EINVAL on an empty mask). The 0-mask is reserved as the 'wildcard' encoding for freshly-constructed tasks that never called setaffinity, distinguished from an explicit user-provided 0 by which side of the syscall boundary produced it. (2) cpu_mask & SYS_SCHED_CPU_MASK_INVALID != 0 -> -EINVAL — any bit beyond MAX_CPUS-1 (i.e. beyond bit 3 for MAX_CPUS=4) names a CPU that does not exist on this hardware; accepting it would let a task 'reserve' a phantom core and starve on real ones. Both refusals return -EINVAL (0xFFFFFFFFFFFFFFEA) so the caller has one errno to check with `cmp rax, 0; jl err` per the negative-errno-u64 convention. Store on success: `mov [rdi + 128], rsi`; rax = 0. Leaf function, no callee-save touched — rax/rcx are the only writes and both are caller-save. No user pointer on this syscall (raw u64 arg via SysV rsi), so no user_ptr_ok gate is needed. The read is symmetric via sys_sched_getaffinity_body; the scheduler consult lives in sched/pick_next.pdx §sched_pick_next_r15 which reads [walk + 128] with the same 0=wildcard semantics. Effects {mem} for the TCB write; capabilities empty (no @{sched} needed — this is a store into the caller's own TCB, not a runqueue mutation).",
      block: {
        // ---- Gate 1: cpu_mask == 0 -> -EINVAL ----
        cmp rsi, 0;
        je sys_sched_setaff_einval;

        // ---- Gate 2: cpu_mask & INVALID != 0 -> -EINVAL ----
        mov rcx, rsi;
        mov rax, 0xFFFFFFFFFFFFFFF0;              // SYS_SCHED_CPU_MASK_INVALID
        and rcx, rax;
        cmp rcx, 0;
        jne sys_sched_setaff_einval;

        // ---- Store: TCB.cpu_mask := cpu_mask ----
        mov [rdi + 128], rsi;                     // TCB_OFF_CPU_MASK
        xor rax, rax;                             // return 0
        ret;

      sys_sched_setaff_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;              // -EINVAL
        ret
      }
    }

  // ============================================================================
  // sys_sched_getaffinity_body(current: u64) -> u64
  // ============================================================================
  //
  // Reads current TCB's cpu_mask (u64 at +128). If the stored value is 0
  // (uninitialized — task_new's rep_stosq default), returns ~0u64 so the
  // caller sees an explicit "all CPUs allowed" rather than the sentinel
  // 0 which POSIX applications interpret as "empty set". This translation
  // is the reason 0 is a legal internal encoding but not a legal external
  // one: the setter refuses it, the getter never emits it.
  //
  // Register plan (leaf):
  //   rdi = current (in), consumed
  //   rax = return
  //   rcx = scratch
  //
  // No callee-save touched; no nested call.
  pub let sys_sched_getaffinity_body : (u64) -> u64 !{mem} @{} =
    fn (current: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "#1582 part B: read cpu_mask from current TCB at TCB_OFF_CPU_MASK (+128). If the raw stored value is 0 (task_new zero-init default — no explicit setaffinity call ever happened for this task) translate to ~0u64 so the ring-3 caller sees 'all CPUs allowed' rather than 'no CPUs allowed'. The internal 0=wildcard encoding is a scheduler-side convenience (sched_pick_next_r15's `mov rcx, [walk+128]; cmp rcx, 0; je pick_found` gate treats 0 as universally-eligible without a second load); the syscall boundary is where that convenience gets normalized into POSIX-shaped semantics. Non-zero stored values pass through verbatim — the setter has already validated them against SYS_SCHED_CPU_MASK_INVALID at write time, so a get can never return a bit beyond MAX_CPUS-1 unless someone poked the TCB slab directly. Leaf function; no nested call. Effects {mem} for the TCB read; capabilities empty. Return value is always non-zero on success (either the caller-provided mask that passed setaffinity's gates, or ~0u64 for the wildcard case) — there is no failure mode.",
      block: {
        mov rax, [rdi + 128];                     // TCB_OFF_CPU_MASK
        cmp rax, 0;
        jne sys_sched_getaff_done;
        // Uninitialized -> all cores allowed sentinel
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sys_sched_getaff_done:
        ret
      }
    }

  // ============================================================================
  // sys_reserve_lpe_class_body(pid: u64) -> u64
  // ============================================================================
  //
  // Atomic-ish reserve of the LP-E class for a single pid. Refuses with
  // -EEXIST if _reserved_lpe_task_pid is already non-zero and different
  // from the passed pid; idempotent when the caller re-reserves the same
  // pid (returns 0). No release primitive at MVP — the reservation lasts
  // for the boot.
  //
  // The reservation is a HINT to sched_pick_next_r15 (pick_next.pdx),
  // consulted when running on a class-3 (LP-E) core. If the reserved task
  // is not runnable on the current core (blocked, or cpu_mask excludes
  // this CPU) the picker falls through to the standard affinity walk —
  // the reservation does not starve the core when the reserved task is
  // idle. See file-header §LP-E reservation for the rationale.
  //
  // AML executor task (#1087) reserves LP-E via sys_reserve_lpe_class to
  // sidestep P-core scheduling jitter, which is the primary consumer this
  // MVP is sized for.
  //
  // Register plan (leaf; single memory-effecting store):
  //   rdi = pid (in)
  //   rax = &_reserved_lpe_task_pid / return
  //   rcx = current stored pid
  //
  // No callee-save touched.
  pub let sys_reserve_lpe_class_body : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "#1582 part B: reserve LP-E class for `pid` via _reserved_lpe_task_pid. Sequence: (1) refuse pid == 0 with -EINVAL — pid 0 is the reserved sentinel throughout the kernel (pid_alloc never issues it per task_pool.pdx §pid_alloc, and _reserved_lpe_task_pid == 0 is the 'unreserved' encoding), so accepting it would clobber the reservation state via what looks like a legitimate call. (2) Load current stored pid; if 0 (unreserved), fall through to the store. (3) If stored pid == caller's pid, return 0 (idempotent re-reservation — matches POSIX semantics for repeated identical mutations). (4) Otherwise return -EEXIST (0xFFFFFFFFFFFFFFEF) — a different pid already owns the reservation. (5) Store: _reserved_lpe_task_pid = pid; return 0. Leaf function, no nested call. The reservation is a HINT consumed by sched_pick_next_r15's LP-E branch (pick_next.pdx §pick_next_lpe_walk); it does not preempt on set (per #1582 design directive 'Do NOT preempt on affinity change') and it does not force the reserved task onto LP-E when the task's own cpu_mask excludes it (the picker falls through to the standard affinity walk). AML executor task (#1087) reserves LP-E via sys_reserve_lpe_class to sidestep P-core scheduling jitter. No release primitive at MVP — the reservation lasts for the boot. Concurrency: at R31.M0 there is no cross-CPU concurrent caller (single ring-3 process, one reservation by construction). If two callers ever race, the loser sees the winner's pid in the cmp and returns -EEXIST — the same shape as O_EXCL. Effects {mem} for the u64 store, capabilities empty (no @{sched} — this is a hint that pick_next.pdx consumes, not a runqueue mutation).",
      block: {
        // ---- Gate: pid == 0 -> -EINVAL ----
        cmp rdi, 0;
        je sys_reserve_lpe_einval;

        // Load current stored reservation
        lea rax, [rip + _reserved_lpe_task_pid];
        mov rcx, [rax];

        // Unreserved (0) -> take it
        cmp rcx, 0;
        je sys_reserve_lpe_store;

        // Already reserved by same pid -> idempotent OK
        cmp rcx, rdi;
        je sys_reserve_lpe_ok;

        // Different pid -> -EEXIST
        mov rax, 0xFFFFFFFFFFFFFFEF;              // -EEXIST
        ret;

      sys_reserve_lpe_store:
        mov [rax], rdi;                           // _reserved_lpe_task_pid = pid
      sys_reserve_lpe_ok:
        xor rax, rax;
        ret;

      sys_reserve_lpe_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;              // -EINVAL
        ret
      }
    }
}
