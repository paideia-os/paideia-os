// src/kernel/core/syscall/handlers/sys_display_hotplug_subscribe.pdx -- R105.M4-002
//
// sys_display_hotplug_subscribe(hpch_cap_slot) -> 0 | -errno
//
// Sysno 113. Attach a KIND_HOTPLUG_CHANNEL cap the caller holds to the
// running system's HPD ISR fanout table. The cap must already exist
// (minted via kind_hotplug_channel_mint_body); this syscall's role is
// the "publish to the fanout table" step -- at R105 the fanout table
// IS _hpch_table, so the syscall's only observable effect is validating
// the cap and returning success.
//
// Rights required: R_HPCH_SUBSCRIBE (0x001). -EACCES if absent,
// -EBADF on kind mismatch.
//
// The actual delivery path (hotplug_channel_deliver) runs from the HPD
// ISR (or a simulated-hotplug witness) and bumps the row's delivered
// counter; a compositor reading the count sees changes without polling
// the display-output cap.

module SysDisplayHotplugSubscribe = structure {

  pub let SYSHP_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYSHP_ERR_EACCES : u64 = 0xFFFFFFFFFFFFFFF3

  pub let sys_display_hotplug_subscribe_body : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (hpch_cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M4-002 (sysno 113): resolve hpch_cap_slot -> hpch_row_id via cap_table (kind gate + R_HPCH_SUBSCRIBE rights gate). At R105 the fanout table IS _hpch_table so validation is the primary observable effect; the cap's own liveness ensures hotplug_channel_deliver will iterate over it. Register plan: rbx=cap_slot. 1 callee-save push. Labels prefixed syshp_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // hpch_cap_slot

        cmp rbx, 256;
        jae syshp_ebadf;

        lea rax, [rip + cap_table];
        mov r10, rbx;
        shl r10, 3;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        add rax, r10;

        mov r10, [rax + 0];
        mov r11, 0x1B1;                  // KIND_HOTPLUG_CHANNEL
        cmp r10, r11;
        jne syshp_ebadf;

        mov r10, [rax + 8];
        mov r11, 0x001;                  // R_HPCH_SUBSCRIBE
        and r10, r11;
        cmp r10, r11;
        jne syshp_eacces;

        // Verify row is live.
        mov r10, [rax + 16];
        and r10, 0xFF;
        mov rdi, r10;
        call hpch_row_valid;
        cmp rax, 0;
        je  syshp_ebadf;

        xor rax, rax;
        jmp syshp_out;

      syshp_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp syshp_out;
      syshp_eacces:
        mov rax, 0xFFFFFFFFFFFFFFF3;

      syshp_out:
        pop rbx;
        ret
      }
    }
}
