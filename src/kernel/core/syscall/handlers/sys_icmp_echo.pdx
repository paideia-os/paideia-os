// src/kernel/core/syscall/handlers/sys_icmp_echo.pdx -- R100-PREP-003
// (paideia-os #2009)
//
// sys_icmp_echo(dst_addr_ptr, seq, payload_ptr, payload_len, timeout_ms)
//   -> rtt_ns (>=0) | -EPERM | -EINVAL. SC+ ID 103.
//
// SCOPE at this PREP landing:
//
//   * Capability gate: R_NET_PRIVILEGED_PROTOCOL, checked via
//     cap_check_r_net_privileged_protocol(_current_tcb) (see
//     src/kernel/core/cap/cap_net_privileged.pdx). Fails closed with
//     -EPERM. Two callers pass today: boot context (_current_tcb==0)
//     and pid==1 (init).
//
//   * dst_addr_ptr: a KERNEL VA pointing at a 4-byte IPv4 address. The
//     boot witness passes &_r100pep3_dst; a future userspace ping tool
//     will pass through the dispatch layer where the shim will
//     KPTI-bounce the 4 bytes into a kernel scratch (deferred -- the
//     dispatch shim at R100-PREP-003 does not yet materialize that
//     bounce and the sysno is not yet reachable by ring-3 tasks anyway,
//     since the cap gate refuses every task other than init).
//
//   * payload_ptr / payload_len: same KERNEL VA convention. Cap at 256
//     bytes (matches the ICMP wire cap _icmp_echo_req_scratch sizes
//     for -- see net/icmp.pdx). payload_ptr may be 0 iff payload_len==0.
//
//   * Timestamp before / after via hpet_now_ns; rtt_ns = t2 - t1. For a
//     loopback dst (byte-for-byte == _ipv4_my_ip) the ICMP send path
//     synchronously drives icmp_rx_handle, so t2-t1 measures the full
//     kernel-side echo round-trip. For an off-box dst the send path
//     enqueues into e1000e (or bails with IPV4_E_ARP_PENDING on a cold
//     ARP cache) and t2-t1 measures the tx dispatch alone -- reply-wait
//     matching is deferred to when scheduler-side wait/wake plumbing
//     for L4 protocols exists (design/networking/r91-plan.md §17).
//     timeout_ms is accepted but unused at this landing (documented,
//     not silently ignored -- see justification below); a future round
//     that adds wait-for-reply matching will honor it.
//
//   * Fingerprint on success: `sys icmp echo ok [legacy: SYS ICMP ECHO
//     OK] -- rtt_ns=<n>` via klog_s1_d1(SUBSYS_NET_,
//     tag_sys_icmp_echo_ok, k_rtt_ns, rtt_ns). No fingerprint on
//     failure (matches every other sys_* handler's "OK path only"
//     discipline).
//
// Reserved-label discipline: labels prefixed `sie_`. `loop`, `if` etc.
// are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same discipline as sys_kill.pdx and
// every other handler in this dir).

module SysIcmpEcho = structure {

  // -errno constants (u64 sign-extended two's complement, matching every
  // other sys_* handler's SysV return convention).
  pub let SYS_ICMP_ECHO_EPERM  : u64 = 0xFFFFFFFFFFFFFFFF   // -EPERM  (-1)
  pub let SYS_ICMP_ECHO_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)

  // Payload ceiling. 256 = the max ICMP Echo Request payload
  // net/icmp.pdx supports today (its _icmp_echo_req_scratch is 320 B
  // total, with 8 B ICMP header + 256 B payload = 264 B leaving 56 B
  // of slack).
  pub let SYS_ICMP_ECHO_PAYLOAD_MAX : u64 = 256

  // sys_icmp_echo_body -- SysV entry, SC+ ID 103.
  //
  // Args (SysV):
  //   rdi = dst_addr_ptr (KERNEL VA pointing at 4 bytes of IPv4 addr)
  //   rsi = seq          (u16; low 16 bits used)
  //   rdx = payload_ptr  (KERNEL VA; may be 0 iff payload_len==0)
  //   rcx = payload_len  (0..256)
  //   r8  = timeout_ms   (u64; accepted, unused at this landing)
  //
  // Return: rtt_ns (>=0) | SYS_ICMP_ECHO_EPERM | SYS_ICMP_ECHO_EINVAL.
  //
  // Register plan (5-push callee-save + sub rsp,8 pad):
  //   rbx = dst_addr_ptr   (survives across every nested call)
  //   rbp = t1             (hpet timestamp before send)
  //   r12 = seq
  //   r13 = payload_ptr
  //   r14 = payload_len
  //   r15 = rtt_ns         (populated after the second hpet_now_ns)
  //   5 pushes = 40; entry rsp%16==8 -> 48, sub rsp,8 -> 56, %16==0
  //   (aligned for hpet_now_ns / cap_check_r_net_privileged_protocol /
  //   icmp_send_echo_request / klog_s1_d1).
  pub let sys_icmp_echo_body : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{cap} =
    fn (dst_addr_ptr: u64) (seq: u64) (payload_ptr: u64) (payload_len: u64)
       (timeout_ms: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {cap},
      justification: "R100-PREP-003 (paideia-os #2009): sys_icmp_echo body, SC+ ID 103. Entry: rdi=dst_addr_ptr, rsi=seq, rdx=payload_ptr, rcx=payload_len, r8=timeout_ms. 5-push callee-save prologue (rbx, rbp, r12, r13, r14; skipping r15 because r15 is not needed across any nested call -- the rtt result lives in rax after the second hpet_now_ns and goes straight into the klog v1 slot without a callee-save clobber intervening) + sub rsp,8 pad: entry rsp%16==8 (dispatch shim's `sub rsp,8` pad before `call`), 5 pushes -> rsp%16==8+40=48, sub rsp,8 -> rsp%16==0, aligned for every nested call (hpet_now_ns/cap_check/icmp_send_echo_request/klog_s1_d1). Phase 1: capability gate FIRST (before any argument validation) -- load _current_tcb, call cap_check_r_net_privileged_protocol; rax==0 -> return -EPERM. Fail-closed posture: exactly the two callers this landing knows about (boot context via _current_tcb==0, pid==1 via TASK_OFF_PID==1) pass; every other ring-3 task refuses. Phase 2: argument validation -- payload_len > 256 -> -EINVAL; payload_len != 0 AND payload_ptr == 0 -> -EINVAL. dst_addr_ptr==0 -> -EINVAL (a null dst pointer would fault icmp_send_echo_request's dst byte-compare loop). Phase 3: timestamp t1 via hpet_now_ns (returns u64 ns since boot; 0 iff HPET was not initialized, in which case rtt_ns will be 0 too -- an honest report of `no clock available`). Save t1 into rbp. Phase 4: icmp_send_echo_request(dst_addr_ptr=rbx, ident=1, seq=r12, payload_ptr=r13, payload_len=r14). Ident is a fixed literal 1 at this landing (a real ping tool would spin per-task idents; this syscall serves only the boot witness and init today, so a fixed value keeps the reply demux single-value). The return value is DELIBERATELY IGNORED here: an ARP-miss (return 3) on the off-box path is a legitimate `packet is on the wire, wait for reply` outcome -- and at this landing there is no wait-for-reply, so the tx-dispatch-time is what we return regardless. Phase 5: timestamp t2 via hpet_now_ns; rtt_ns = t2 - t1 in rax. Guard against a t2<t1 underflow (HPET counter reset or two-tick reordering under an unmapped MMIO region): if t2 < t1, set rtt_ns = 0 rather than propagating an underflowed 0xFFFFFFFF... which the user would misread as -EINVAL. Phase 6: emit fingerprint `sys icmp echo ok [legacy: SYS ICMP ECHO OK] -- rtt_ns=<n>` via klog_s1_d1(LEVEL_INFO=3, SUBSYS_NET_, tag_sys_icmp_echo_ok, k_rtt_ns, rtt_ns). Phase 7: return rtt_ns in rax. timeout_ms (r8 at entry, saved via the callee-save prologue implicitly since we do not touch r8 after entry): accepted, unused at this landing. A future round adding wait-for-reply will consume it via an hpet_now_ns polling loop; the sysno's ABI stays byte-identical. Register discipline: rbx/rbp/r12/r13/r14 preserved via 5-push prologue and survive every nested call (all callee-save per SysV). Effects {mem,sysreg}: mem for the scratch buffer accesses transitive through icmp_send_echo_request and _current_tcb read; sysreg transitively from hpet_now_ns's MMIO read and klog_s1_d1's TSC read (matches sys_kill_body's identical widening rationale). Capability {cap}: cap_check_r_net_privileged_protocol needs it; icmp_send_echo_request needs none; klog needs none. Encoder-conservative: cmp/je/jne/mov/xor/lea/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in sys_kill/sys_send/sys_recv handlers. Reserved labels: sie_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // dst_addr_ptr
        mov r12, rsi;                    // seq
        mov r13, rdx;                    // payload_ptr
        mov r14, rcx;                    // payload_len

        // ---- Phase 1: capability gate FIRST ----
        mov rdi, [rip + _current_tcb];
        call cap_check_r_net_privileged_protocol;
        cmp rax, 0;
        jne sie_cap_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // -EPERM
        jmp sie_return;
      sie_cap_ok:

        // ---- Phase 2: argument validation ----
        // payload_len <= 256
        mov rax, 256;
        cmp r14, rax;
        ja  sie_einval;

        // payload_len != 0 AND payload_ptr == 0 -> EINVAL
        cmp r14, 0;
        je  sie_len_ok;
        cmp r13, 0;
        jne sie_len_ok;
        jmp sie_einval;
      sie_len_ok:

        // dst_addr_ptr must be non-null (would fault the byte-compare
        // loop in icmp_send_echo_request otherwise).
        cmp rbx, 0;
        jne sie_dst_ok;
      sie_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;     // -EINVAL
        jmp sie_return;
      sie_dst_ok:

        // ---- Phase 3: timestamp t1 ----
        call hpet_now_ns;
        mov rbp, rax;                    // t1

        // ---- Phase 4: send the ICMP Echo Request ----
        mov rdi, rbx;                    // dst_addr_ptr
        mov rsi, 1;                      // ident = 1
        mov rdx, r12;                    // seq
        mov rcx, r13;                    // payload_ptr
        mov r8,  r14;                    // payload_len
        call icmp_send_echo_request;
        // rax carries send result. Deliberately IGNORED per justification.

        // ---- Phase 5: timestamp t2 -> rtt_ns ----
        call hpet_now_ns;
        // rtt_ns = rax - rbp. Guard against underflow.
        cmp rax, rbp;
        jae sie_rtt_ok;
        xor rax, rax;                    // underflow -> report 0
        jmp sie_rtt_have;
      sie_rtt_ok:
        sub rax, rbp;
      sie_rtt_have:
        mov r14, rax;                    // stash rtt_ns for both klog + return
                                         // (r14 was payload_len, dead here)

        // ---- Phase 6: emit fingerprint ----
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_sys_icmp_echo_ok];
        lea rcx, [rip + k_rtt_ns];
        mov r8,  r14;                    // v1 = rtt_ns
        call klog_s1_d1;

        // ---- Phase 7: return rtt_ns ----
        mov rax, r14;

      sie_return:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
