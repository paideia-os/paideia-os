// src/kernel/core/syscall/handlers/sys_kill.pdx — R73.M1-001 (paideia-os #1938)
//
// sys_kill(pid, signum) -> 0 | -EINVAL | -ESRCH. SC+ ID 95.
//
// MVP scope: SIGSTOP (19) and SIGCONT (18) only — every other signum is
// -EINVAL. No process groups, no session leadership: pid names exactly
// one _pid_table slot, matching the pid identity model every other
// pid-taking syscall in this tree already uses (sys_wait's linear scan,
// task_slab_of_pid's bounds, pid_alive's liveness check) rather than
// inventing a job-control-specific lookup. This is the kernel-side half
// of R73's shell job control (^Z/bg/fg); the shell-side process-group
// tracking + fingerprint (`shell job ok -- ...`) lives in the shell
// satellite repo (R73.M1-002/003/006), out of scope here.
//
// State-machine summary (full rationale in sched/state.pdx's "New at
// R73.M1-001" header paragraph):
//
//   SIGSTOP: ZOMBIE -> no-op (can't stop a corpse; touching its state
//              would make it unreapable by sys_wait_body's ZOMBIE scan).
//            STOPPED -> no-op (idempotent).
//            RUNNABLE -> runq_dequeue (unlink FIRST — the runqueue is
//              the ONLY thing sched_pick_next_r15 consults; it never
//              reads the state field) THEN state := STOPPED.
//            WAITING / WAITING_IPC -> state := STOPPED directly; the
//              task has no runqueue linkage to remove (sched_block
//              already dequeued it at the point it blocked).
//
//   SIGCONT: STOPPED -> sched_wake (state := RUNNABLE + its own
//              affinity-aware local/cross-CPU enqueue, reused verbatim
//              rather than hand-rolling a second enqueue path).
//            anything else -> no-op (POSIX: SIGCONT on a task that
//              isn't stopped has no effect).
//
// Known limitation (documented, not silently assumed): runq_dequeue
// operates on the CALLING CPU's own per-CPU runqueue (rdmsr IA32_GS_BASE
// self-lookup — see runqueue.pdx). If the target task were linked into a
// DIFFERENT CPU's runqueue, calling runq_dequeue from here would misfire
// on an endpoint removal (patching the wrong CB's head/tail). There is
// no runq_dequeue_remote(cpu_idx, task) counterpart to runq_enqueue_
// remote / runq_dequeue_head_remote (#1883/#1888) — only a head-only
// remote pop exists, not arbitrary-task remote removal. This is safe in
// practice at R73: real cross-CPU task placement is dormant outside the
// boot_r69_smp_dispatch witness (runqueue.pdx's own sched_try_steal
// header documents the AP idle-steal call site as a guaranteed no-op
// before any application task exists), so every user task's runqueue
// linkage today is on whichever CPU last woke it — which for R73's shell
// job-control use (stopping/continuing one's own foreground/background
// child) is the caller's own CPU. A future round adding real multi-CPU
// user-task dispatch will need a true remote-dequeue-by-task primitive;
// deferred here with the same posture #1888's own header takes toward
// its currently-dormant call site.

module SysKill = structure {

  pub let SYS_KILL_ESRCH  : u64 = 0xFFFFFFFFFFFFFFFD   // -ESRCH (-3)
  pub let SYS_KILL_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)

  // POSIX-aligned signal numbers. Only these two are implemented; every
  // other value is -EINVAL for this MVP (SIGTERM/SIGKILL/process-group
  // delivery all explicitly out of scope — see design R73.M1-001).
  pub let SIGCONT : u64 = 18
  pub let SIGSTOP : u64 = 19

  // Task-state constants, duplicated locally per this tree's established
  // cross-module-let-does-not-resolve-at-parse-time discipline (paideia-
  // as does not resolve another module's `let` at parse time — see
  // sys_fork.pdx / sys_exit.pdx's own local TASK_OFF_* duplicates for the
  // precedent). Canonical source: sched/state.pdx.
  pub let TASK_STATE_RUNNABLE : u32 = 1
  pub let TASK_STATE_ZOMBIE   : u32 = 3
  pub let TASK_STATE_STOPPED  : u32 = 5

  // _pid_table bound (sched/task_pool.pdx's MAX_PIDS, duplicated locally
  // per the same discipline).
  pub let MAX_PIDS : u64 = 64

  pub let sys_kill_body : (u64, u64) -> u64 !{mem, sysreg} @{sched} =
    fn (pid: u64) (signum: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {sched},
      justification: "R73.M1-001 (paideia-os #1938): sys_kill body, SC+ ID 95. Entry: rdi=pid, rsi=signum. 3-push callee-save prologue (rbx, r12, r13) -- entry rsp%16==8 (dispatch shim's `sub rsp,8` pad before `call`), 3 (odd) pushes land exactly at rsp%16==0, the state every nested call below requires; unchanged for the rest of the body since every subsequent call (runq_dequeue / sched_wake / klog_s1_d2) is a balanced call/ret pair. r12=pid, r13=signum (both copied out of rdi/rsi immediately so the registers are free, and both survive every nested call as callee-save). Phase 1: validate signum FIRST (matches POSIX kill(2): an invalid signal number is -EINVAL regardless of whether pid names a live task) -- cmp r13 against 19 (SIGSTOP) then 18 (SIGCONT); neither match -> rax=-EINVAL, jump kill_return. Phase 2: bounds-check pid (0 and >=64 both -ESRCH, mirroring task_slab_of_pid's / pid_alive's own two-sided check) then a direct _pid_table[pid] load into rbx -- deliberately NOT routed through task_slab_of_pid + a separate pid_alive liveness call, since _pid_table[pid] itself already IS the slab pointer (0 for dead-or-never-allocated, matching pid_alive's own load source) and this call site needs nothing task_slab_of_pid's pure-arithmetic recomputation would add. rbx==0 -> -ESRCH. Phase 3: dispatch on r13. SIGSTOP (kill_do_sigstop): load ecx=[rbx+8] (state). ZOMBIE(3) or already-STOPPED(5) -> kill_mark_ok unchanged (idempotent / can't-stop-a-corpse, see file-header rationale -- overwriting a ZOMBIE's state would make it unreapable by sys_wait_body's own state==ZOMBIE(3) scan, a real fd/pid leak, not cosmetic). RUNNABLE(1) -> `mov rdi,rbx; call runq_dequeue` (unlink from the calling CPU's own per-CPU runqueue -- see file-header 'Known limitation' paragraph for the same-CPU assumption) THEN fall into the shared state-write. Any other state (WAITING(2)/WAITING_IPC(4)) skips the dequeue -- sched_block already unlinked those tasks at the point they blocked, so calling runq_dequeue on them would corrupt the calling CPU's CB.head/tail via runq_dequeue's own endpoint-removal branch (task.prev==0 -> CB.head=task.next=0), since a doubly-off-runq task's next/prev are already both zero. kill_sigstop_mark: ecx=5 (TASK_STATE_STOPPED); mov [rbx+8],ecx; fall to kill_mark_ok. SIGCONT (kill_do_sigcont): load ecx=[rbx+8]; not STOPPED(5) -> kill_mark_ok unchanged (POSIX: SIGCONT on a non-stopped task is a no-op). STOPPED -> `mov rdi,rbx; call sched_wake` -- reuses sched_wake (sched/wake_block.pdx) verbatim rather than hand-rolling a second RUNNABLE+enqueue path; sched_wake's own 'already RUNNABLE' early-exit guard is harmless here (state is STOPPED, not RUNNABLE, so it always proceeds), and its affinity-aware local/cross-CPU-IPI enqueue (#1883) is exactly the enqueue behavior a resumed task needs. Phase 4 (kill_mark_ok, success path only -- the EINVAL/ESRCH branches jump past this to kill_return): emit `sys kill ok -- pid=<P> sig=<S>` via klog_s1_d2(LEVEL_INFO=3, SUBSYS_SCHD, tag_sys_kill_ok, k_pid, v1=r12, k_sig, [stack]=v2=r13). Pre-call state here is rsp%16==0 (established by the prologue, unperturbed by the balanced runq_dequeue/sched_wake calls), so the stack-arg staging needs the same `sub rsp,8` compensating pad used at sys_execve_shim.pdx's own klog_s1_d2 call site (Phase 9d) before the single `push r13` (v2): sub+push = 16 bytes (even), preserving rsp%16==0 at the `call` instruction so klog_s1_d2 sees its expected rsp%16==8 entry state. `add rsp,16` afterward undoes both. xor rax,rax for the OK return, falling straight into kill_return (no jmp needed -- kill_mark_ok's last instruction is immediately followed by the epilogue labels). kill_esrch / the Phase-1 EINVAL branch both set rax explicitly and jump to kill_return. Epilogue: pop r13/r12/rbx; ret -- reached from every path (EINVAL, ESRCH, and the OK fall-through) since all three pushes happened before any branch. Register discipline: rbx (slab pointer, callee-save, live from Phase 2 through Phase 4), r12 (pid, callee-save, live end-to-end for the fingerprint), r13 (signum, callee-save, live end-to-end for both the dispatch branch and the fingerprint) all callee-save-preserved via the 3-push prologue and survive runq_dequeue/sched_wake/klog_s1_d2 (all of which are only guaranteed to preserve the SysV callee-save set). rax/rcx/rdx/rdi/rsi/r8/r9 caller-save scratch throughout. Effects {mem} for the _pid_table load and the state-field read/write; {sysreg} transitively from runq_dequeue's and sched_wake's own rdmsr IA32_GS_BASE reads plus klog_s1_d2's underlying TSC read (matches sys_ipc_send_body's identical mem+sysreg widening rationale for the same two transitive sources). Capability {sched}: both runq_dequeue and sched_wake require it; klog_s1_d2 needs none. Encoder: cmp/je/jne/jae/mov/lea/xor/push/pop/call/ret/sub/add -- every form already proven at this exact shape elsewhere in the tree (sys_wait_body's inline _pid_table scan, sched_wake's own state-check-then-branch, sys_execve_shim's klog_s1_d2 call-site pad).",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;                      // r12 = pid (preserved across every nested call)
        mov r13, rsi;                      // r13 = signum (preserved across every nested call)

        // ---- Phase 1: validate signum (POSIX order — bad signal is
        // -EINVAL regardless of whether pid names a live task) ----
        cmp r13, 19;                       // SIGSTOP
        je  kill_sig_ok;
        cmp r13, 18;                       // SIGCONT
        je  kill_sig_ok;
        mov rax, 0xFFFFFFFFFFFFFFEA;       // -EINVAL
        jmp kill_return;
      kill_sig_ok:

        // ---- Phase 2: bounds-check + direct _pid_table lookup ----
        cmp r12, 0;                        // pid 0 = reserved sentinel
        je  kill_esrch;
        cmp r12, 64;                       // MAX_PIDS (table bound)
        jae kill_esrch;
        lea rax, [rip + _pid_table];
        mov rbx, [rax + r12*8];            // rbx = slab | 0
        cmp rbx, 0;
        je  kill_esrch;

        // ---- Phase 3: dispatch by signum (only 18/19 reach here) ----
        cmp r13, 19;                       // SIGSTOP
        je  kill_do_sigstop;
        jmp kill_do_sigcont;

      kill_do_sigstop:
        mov ecx, [rbx + 8];                // ecx = state
        cmp ecx, 3;                        // ZOMBIE — nothing to stop
        je  kill_mark_ok;
        cmp ecx, 5;                        // already STOPPED — idempotent
        je  kill_mark_ok;
        cmp ecx, 1;                        // RUNNABLE?
        jne kill_sigstop_mark;             // WAITING/WAITING_IPC: already off-runq, skip dequeue
        mov rdi, rbx;
        call runq_dequeue;                 // unlink BEFORE the state flip
      kill_sigstop_mark:
        mov ecx, 5;                        // TASK_STATE_STOPPED
        mov [rbx + 8], ecx;
        jmp kill_mark_ok;

      kill_do_sigcont:
        mov ecx, [rbx + 8];
        cmp ecx, 5;                        // STOPPED?
        jne kill_mark_ok;                  // not stopped: no-op
        mov rdi, rbx;
        call sched_wake;                   // STOPPED -> RUNNABLE + affinity-aware enqueue
        jmp kill_mark_ok;

      kill_esrch:
        mov rax, 0xFFFFFFFFFFFFFFFD;       // -ESRCH
        jmp kill_return;

      kill_mark_ok:
        // Fingerprint: sys kill ok -- pid=<r12> sig=<r13>
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_sys_kill_ok];
        lea rcx, [rip + k_pid];
        mov r8, r12;                       // v1 = pid
        lea r9, [rip + k_sig];
        sub rsp, 8;                        // alignment pad (rsp%16: 0 -> 8)
        push r13;                          // v2 = signum;   rsp%16: 8 -> 0
        call klog_s1_d2;
        add rsp, 16;                       // undo pad + push
        xor rax, rax;                      // return 0 (OK)

      kill_return:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
