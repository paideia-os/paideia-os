// src/kernel/core/syscall/handlers/sys_page_flip.pdx -- R105.M3-002
//
// sys_page_flip(pgfl_cap_slot, target_fb_slot_hint) -> 0 | -errno
//
// Sysno 111. NON-BLOCKING submit against a KIND_PAGE_FLIP cap the caller
// holds. Delegates to pgfl_submit. Rights required: R_FLIP_INVOKE
// (0x001). Refuses with -EACCES if absent, -EBADF on kind mismatch,
// -EAGAIN on PGFL_SUBMIT_BUSY (in-flight).
//
// target_fb_slot_hint: at R105 the flip is "advance the row's
// active_fb_slot by 1" (the compositor's double-buffer alternator lives
// upstream; a real compositor passes the concrete target slot here).
// A caller passing 0 means "keep the current active_fb_slot" (a no-op
// flip that still exercises the vblank round-trip -- what the R105
// witness uses).
//
// Prompt spec: `sys_page_flip(fb_cap, params_pa) -> u64`. The params_pa
// argument here is repurposed as target_fb_slot_hint; a params block
// carrying (rectangles, sync-timeline value) grows in R106 once the
// KIND_MODESET_TXN atomic-commit path is wired through. This landing
// keeps the ABI stable while the parameter shape is a single u64.

module SysPageFlip = structure {

  pub let SYSFL_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYSFL_ERR_EACCES : u64 = 0xFFFFFFFFFFFFFFF3
  pub let SYSFL_ERR_EAGAIN : u64 = 0xFFFFFFFFFFFFFFF5
  pub let SYSFL_ERR_EIO    : u64 = 0xFFFFFFFFFFFFFFFB

  pub let sys_page_flip_body : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (pgfl_cap_slot: u64) (target_fb_slot_hint: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R105.M3-002 (sysno 111): resolve pgfl_cap_slot -> pgfl_row_id via cap_table (kind gate + R_FLIP_INVOKE rights gate), then delegate to pgfl_submit(row_id, target_fb_slot). Translates PGFL_SUBMIT_BUSY sentinel to -EAGAIN and PGFL_BAD_SLOT to -EBADF; passes 0 through unchanged. Register plan: rbx=pgfl_row_id, r12=target_fb_slot_hint. 2 callee-save pushes + sub rsp,8 pad. Labels prefixed sysfl_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov r12, rsi;                    // target_fb_slot_hint

        cmp rdi, 256;
        jae sysfl_ebadf;

        lea rax, [rip + cap_table];
        mov r10, rdi;
        shl r10, 3;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        add rax, r10;

        mov r10, [rax + 0];
        mov r11, 0x1B0;                  // KIND_PAGE_FLIP
        cmp r10, r11;
        jne sysfl_ebadf;

        mov r10, [rax + 8];
        mov r11, 0x001;                  // R_FLIP_INVOKE
        and r10, r11;
        cmp r10, r11;
        jne sysfl_eacces;

        mov r10, [rax + 16];
        and r10, 0xFF;
        mov rbx, r10;                    // pgfl_row_id

        // pgfl_submit(row_id, target_fb_slot).
        mov rdi, rbx;
        mov rsi, r12;
        call pgfl_submit;

        // 0 -> success; 0xFFFFEB59 -> -EAGAIN; 0xFFFFEB5A -> -EBADF.
        cmp rax, 0;
        je  sysfl_out;
        mov r10, 0xFFFFEB59;
        cmp rax, r10;
        je  sysfl_eagain;
        mov r10, 0xFFFFEB5A;
        cmp rax, r10;
        je  sysfl_ebadf;
        // Any other sentinel -> -EIO.
        jmp sysfl_eio;

      sysfl_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sysfl_out;
      sysfl_eacces:
        mov rax, 0xFFFFFFFFFFFFFFF3;
        jmp sysfl_out;
      sysfl_eagain:
        mov rax, 0xFFFFFFFFFFFFFFF5;
        jmp sysfl_out;
      sysfl_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;

      sysfl_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
