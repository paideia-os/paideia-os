// src/kernel/core/syscall/handlers/sys_ipc_reply.pdx — R20b.M3-002 (#1559)
//                                                      + R20b.M6-003 (#1566)
// sys_ipc_reply body — non-blocking reply on an IPC endpoint (sysno 41).
//
// Design context
// --------------
// Companion body to sys_ipc_send (see sys_ipc_send.pdx §Design context).
// Per design/ipc/userspace-server-substrate.md §5.1 and
// acpi-supervisor-schema.md §3, a reply is byte-identical to a send but
// with the request's op field bit 7 flipped ("a reply's op is the request
// op with bit 7 set"). frame.pdx exposes FRAME_OP_REPLY_BIT (= 0x80) as
// the named constant; this body enforces that gate before falling through
// to sys_ipc_send_body.
//
// R20b.M6-003 (#1566): dual-endpoint reply routing
// -------------------------------------------------
// Per userspace-server-substrate.md §4.4 (Option A compact variant), the
// v1 header's reserved u16 `flags` slot is repurposed as `reply_endpoint_id`:
// a client sets it to its own reply endpoint's id, the server preserves
// it into its reply hdr, and THIS body reads it out of the hdr and
// overrides the incoming `id` argument with it when non-zero. The
// override closes the same-endpoint request/reply race (see §4.4 for
// the failure mode).
//
// Semantic branch:
//   hdr.reply_endpoint_id == 0            -> publish reply to `id`
//                                             (legacy same-endpoint;
//                                             matches every R20b.M1..M5
//                                             witness's flags=0 shape).
//   hdr.reply_endpoint_id in [1, 127]     -> publish reply to that
//                                             endpoint (dual-endpoint;
//                                             the new echo_client/server
//                                             witness).
//   hdr.reply_endpoint_id in [128, 65535] -> passes through to
//                                             sys_ipc_send_body which
//                                             rejects via endpoint_lookup's
//                                             bounds gate as BAD_ID.
//
// Walker read expansion: the M3-002 body walker-copied 1 byte (op) for
// the bit-7 check. M6-003 grows this to 4 bytes (op + ver + reply_ep_id
// low + reply_ep_id high) so both fields are available from the same
// walker call. Cost: negligible — the walker's amortized 4-level page
// walk is done once per byte inside the first 4 bytes of the same page.
//
// Enforcement placement
// ---------------------
// The bit-7 check happens in this body — NOT in sys_ipc_send_body — so
// the send body stays symmetric across request and reply semantics (a
// well-formed request send would also carry the bit-flipped op if the
// caller wanted to encode a reply, but the send API contract per §4.1
// makes bit 7 a caller-set discriminator, not a syscall-side constraint).
// Pushing the assertion up to sys_ipc_reply keeps sys_ipc_send free of
// the schema-version-dependent bit check and allows a future FRAME_OP_*
// widening (per acpi-supervisor-schema.md §3's "u8 op — RPC opcode; reply's
// op is request's op|0x80") to touch only this file.
//
// Copy-once discipline
// --------------------
// The bit-7 check requires reading the op byte from user memory BEFORE
// deciding whether to publish. The natural options are:
//
//   (a) Pre-walk the op byte here, check bit 7, then delegate to
//       sys_ipc_send_body (which will re-walk the full 8-byte hdr inside
//       user_bounce_send). Cost: one extra 1-byte user_read_bytes_via_walk
//       call — negligible; walker's 4-level walk is amortized on the same
//       page as the 8-byte hdr copy.
//
//   (b) Re-implement the full send-body logic here with the bit-7 check
//       between user_bounce_send and the wake path. Cost: duplicated ~40
//       lines of logic; every future sys_ipc_send fix has to be applied
//       twice.
//
// Choice: (a). One extra walker call is cheap; code duplication is
// long-term expensive. The bit-7 check runs BEFORE any endpoint state is
// mutated, so a rejection leaves the endpoint arena + row untouched — a
// clean failure model that (b)'s post-publish assertion could not match
// without rolling back the publish (worse still).
//
// Error taxonomy
// --------------
// This body's distinct-error space:
//   0                             success (delegated from sys_ipc_send_body)
//   1 / 2 / 3 / -EFAULT (0xFFFFFFFFFFFFFFF2)
//                                 pass-through from sys_ipc_send_body
//   -EFAULT (0xFFFFFFFFFFFFFFF2)  walker failure on the pre-check read
//                                 (indistinguishable from user_bounce_send's
//                                 own -EFAULT — same class of failure)
//   -EINVAL (0xFFFFFFFFFFFFFFEA)  hdr.op bit 7 not set (the reply-gate
//                                 rejection; distinct from every other
//                                 error code so a caller can discriminate
//                                 via cmp rax, -22)
//
// Cross-references
// ----------------
//   design/ipc/userspace-server-substrate.md §4.1, §5.1
//   design/ipc/acpi-supervisor-schema.md §3
//   src/kernel/core/ipc/frame.pdx §FRAME_OP_REPLY_BIT (= 0x80)
//   src/kernel/core/syscall/handlers/sys_ipc_send.pdx (delegate)
//   src/kernel/core/syscall/user_read.pdx §user_read_bytes_via_walk

module SysIpcReply = structure {

  // ============================================================================
  // Result-code sentinels.
  //
  // The pass-through set mirrors sys_ipc_send.pdx (see there for the
  // rationale). The distinct reply-gate rejection is -EINVAL (0xFFFFFFFFFFFFFFEA
  // == -22 signed) — chosen because:
  //   (1) It sits outside the 0..3 substrate-error range and outside -EFAULT
  //       (-14), so callers can discriminate with a single compare.
  //   (2) Standard POSIX errno for "invalid argument" — the reply-bit
  //       requirement is a schema-level argument constraint on hdr.op,
  //       not a resource-limit or fault condition.
  // ============================================================================

  pub let SYS_IPC_REPLY_ERR_EFAULT       : u64 = 0xFFFFFFFFFFFFFFF2   // -14
  pub let SYS_IPC_REPLY_ERR_NOT_REPLY    : u64 = 0xFFFFFFFFFFFFFFEA   // -22 (-EINVAL)

  // ============================================================================
  // Kernel-side scratch for the 4-byte prefix pre-check.
  //
  // Sized to a full u64 (8 bytes) so the walker copies the low u64 of
  // the packed hdr in one call — R20b.M6-003 grew the prefix from 1 byte
  // (op only, M3-002) to 4 bytes (op + ver + reply_endpoint_id) to serve
  // both the bit-7 reply-op check AND the dual-endpoint routing decision
  // from a single walker call. The two extra bytes cost nothing in
  // walker time (same page, same walk); the scratch slot is already
  // padded to 8 bytes for @align(8) so widening the declared type
  // consumes no additional .bss.
  //
  // @align(8) matches the discipline used by the KPTI-bounce scratches in
  // user_bounce.pdx and dispatch.pdx (dispatch_open/read/write scratches).
  //
  // .bss placement (uninit): freshly zero on first boot; each reply call
  // overwrites the bytes in-place, so no explicit reset needed.
  //
  // Single-flow discipline: R20b's single in-flight IPC per endpoint
  // (design §4.2) means no two callers touch this scratch concurrently.
  // R21+ SMP moves this into the TCB slab (matches the deferral note in
  // user_bounce.pdx §Kernel-side scratch discipline).
  // ============================================================================

  pub let mut _sys_ipc_reply_op_scratch : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // sys_ipc_reply_body(id, user_hdr_va, user_payload_va, payload_len) -> u64
  //
  // SysV ABI: rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=payload_len
  //        -> rax = 0 on success, or one of:
  //             -EFAULT (0xFFFFFFFFFFFFFFF2)  walker failure at pre-check
  //             -EINVAL (0xFFFFFFFFFFFFFFEA)  hdr.op bit 7 not set
  //             pass-through error code from sys_ipc_send_body.
  //
  // Register plan (5-push callee-save prologue aligns rsp %16 == 0 for
  // nested calls; entry rsp %16 == 8 SysV; 5*8=40; 8+40=48; 48%16=0):
  //   rbx = endpoint id                (survives walker + send-body calls;
  //                                     overridden by reply_endpoint_id
  //                                     from the hdr if that field is non-zero
  //                                     — R20b.M6-003 dual-endpoint routing)
  //   r12 = user_hdr_va                (survives walker + send-body calls)
  //   r13 = user_payload_va            (survives walker + send-body calls)
  //   r14 = payload_len                (survives walker + send-body calls)
  //   r15 unused (pushed for alignment)
  //
  // Flow (R20b.M6-003 revision):
  //   (1) Save the four SysV args into rbx/r12/r13/r14 — walker's caller-
  //       save clobber (rax/rcx/rdx/rdi/rsi/r8-r10) would otherwise lose them.
  //   (2) user_read_bytes_via_walk(kernel_dst=_sys_ipc_reply_op_scratch,
  //       user_va=user_hdr_va, len=4) — pull the low 4 bytes of the hdr
  //       (op@+0, ver@+1, reply_endpoint_id@+2..+3) in one walker call.
  //   (3) On walker rc != 0: return -EFAULT.
  //   (4) Load those 4 bytes as a u32; check bit 7 of op. On bit-7-clear:
  //       return -EINVAL.
  //   (5) Extract reply_endpoint_id = (u32 >> 16) & 0xFFFF. If non-zero,
  //       override rbx with reply_endpoint_id (dual-endpoint routing per
  //       userspace-server-substrate.md §4.4).
  //   (6) Restore SysV args from callee-save regs; call sys_ipc_send_body.
  //   (7) Return sys_ipc_send_body's rc verbatim.
  // ==========================================================================

  pub let sys_ipc_reply_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (id: u64) (user_hdr_va: u64) (user_payload_va: u64) (payload_len: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, sched},
      justification: "R20b.M3-002 (#1559) + R20b.M6-003 (#1566): sys_ipc_reply body — pre-check hdr.op bit 7 (FRAME_OP_REPLY_BIT = 0x80 per frame.pdx / acpi-supervisor-schema.md §3), extract hdr.reply_endpoint_id for dual-endpoint routing (per userspace-server-substrate.md §4.4), then delegate to sys_ipc_send_body against the (possibly overridden) target endpoint. 5-push callee-save prologue (rbx/r12/r13/r14/r15) aligns rsp %16 == 0 for nested calls AND preserves the four SysV args across user_read_bytes_via_walk (walker's caller-save clobber covers rax/rcx/rdx/rdi/rsi/r8-r10 per user_read.pdx §user_read_bytes_via_walk register plan). rbx=id (mutable: overridden by hdr.reply_endpoint_id if non-zero), r12=user_hdr_va, r13=user_payload_va, r14=payload_len. r15 pushed for alignment only. Flow: (a) Save args into callee-save regs. (b) `call user_read_bytes_via_walk` with rdi=_sys_ipc_reply_op_scratch, rsi=r12 (user_hdr_va), rdx=4 (op + ver + reply_endpoint_id low + high). rax = 0 (OK) or 0xFFFFFFFFFFFFFFF2 (-EFAULT — walker's own sentinel per user_read.pdx). Grown from 1 to 4 bytes at M6-003 to serve both the bit-7 check AND dual-endpoint routing from ONE walker call — cost negligible since the walker's 4-level page walk is amortized across the same page. (c) `cmp rax, 0; jne sys_ipc_reply_done_efault` — walker failure short-circuits with -EFAULT. (d) Load the low 4 bytes of the scratch: `lea rax, [rip + _sys_ipc_reply_op_scratch]; mov r10, [rax]` loads the full u64 (scratch is u64-slot @align(8)); the low 4 bytes are op | (ver<<8) | (reply_eid<<16). (e) Check bit 7 of op: `mov rcx, r10; and rcx, 0x80; cmp rcx, 0; je sys_ipc_reply_done_not_reply`. FRAME_OP_REPLY_BIT is 0x80 (frame.pdx §L112). (f) Extract reply_endpoint_id: `mov rcx, r10; shr rcx, 16; and rcx, 0xFFFF` — bytes 2..3 of the hdr as a u16. This matches frame_hdr_reply_endpoint_id's semantics exactly (frame.pdx §frame_hdr_reply_endpoint_id). (g) Override branch: `cmp rcx, 0; je sys_ipc_reply_route_source; mov rbx, rcx; sys_ipc_reply_route_source:` — non-zero → replace endpoint id with reply_endpoint_id (dual-endpoint); zero → keep rbx (legacy same-endpoint per §4.4 compat table). (h) Restore args + delegate: `mov rdi, rbx; mov rsi, r12; mov rdx, r13; mov rcx, r14; call sys_ipc_send_body`. rax carries the send body's return verbatim. If reply_endpoint_id was invalid (>=128), sys_ipc_send_body's endpoint_lookup gate rejects with BAD_ID (2) — passes through cleanly. (i) Epilogue: pop r15/r14/r13/r12/rbx; ret. Error paths (sys_ipc_reply_done_efault, sys_ipc_reply_done_not_reply) each load rax with the sentinel and jmp to the common epilogue. Cross-module `call sys_ipc_send_body` proven in dispatch.pdx §dispatch_ipc_recv (cross-module `call sys_ipc_recv_body`). Cross-file [rip + _sys_ipc_reply_op_scratch] proven in every dispatch handler that references a local .bss scratch. Widening rationale: !{mem,sysreg} @{cap,sched} — inherited via the sys_ipc_send_body tail call, plus mem from the walker read.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // rbx = id
        mov r12, rsi;                            // r12 = user_hdr_va
        mov r13, rdx;                            // r13 = user_payload_va
        mov r14, rcx;                            // r14 = payload_len

        // ---- Step 1: walker-copy the low 4 hdr bytes from user_hdr_va ----
        // R20b.M6-003 (#1566): 4-byte walker read fetches op (byte 0) +
        // ver (byte 1) + reply_endpoint_id (bytes 2..3) in ONE call.
        // The walker's 4-level page walk is amortized across the four
        // bytes on the same page (frame hdrs never cross a page boundary
        // — they're 8 bytes at whatever alignment the caller uses,
        // and every M2..M5 witness places them at 8-byte-aligned addrs).
        lea rdi, [rip + _sys_ipc_reply_op_scratch];
        mov rsi, r12;                            // user_hdr_va
        mov rdx, 4;                              // len = 4 (op+ver+reply_eid)
        call user_read_bytes_via_walk;           // rax = 0 (OK) or -EFAULT
        cmp rax, 0;
        jne sys_ipc_reply_done_efault;

        // ---- Step 2: load the 4-byte hdr prefix as a u64 ----
        // Scratch is [u64;1] @align(8); a full u64 load recovers
        // op | (ver<<8) | (reply_eid<<16) | (garbage<<32); we mask
        // downstream so the high 32 bits are inert.
        lea rax, [rip + _sys_ipc_reply_op_scratch];
        mov r10, [rax];                          // r10 = hdr low u64 (4 valid B)

        // ---- Step 3: test bit 7 of op (byte 0 = bits 0..7 of r10) ----
        mov rcx, r10;
        and rcx, 0x80;                           // FRAME_OP_REPLY_BIT
        cmp rcx, 0;
        je  sys_ipc_reply_done_not_reply;        // bit 7 clear -> reject

        // ---- Step 4: extract reply_endpoint_id (bytes 2..3 of hdr) ----
        // Matches frame_hdr_reply_endpoint_id's shift+mask.
        mov rcx, r10;
        shr rcx, 16;
        and rcx, 0xFFFF;                         // rcx = reply_endpoint_id (u16)

        // ---- Step 5: dual-endpoint routing override (M6-003 §4.4) ----
        // Non-zero reply_endpoint_id overrides the incoming id; zero
        // preserves the legacy same-endpoint semantic.
        cmp rcx, 0;
        je  sys_ipc_reply_route_source;
        mov rbx, rcx;                            // route reply to reply_endpoint_id
      sys_ipc_reply_route_source:

        // ---- Step 6: delegate to sys_ipc_send_body against the resolved id ----
        mov rdi, rbx;                            // id (possibly overridden)
        mov rsi, r12;                            // user_hdr_va
        mov rdx, r13;                            // user_payload_va
        mov rcx, r14;                            // payload_len
        call sys_ipc_send_body;                  // rax = send rc (pass through)

      sys_ipc_reply_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sys_ipc_reply_done_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;             // -EFAULT
        jmp sys_ipc_reply_done;

      sys_ipc_reply_done_not_reply:
        mov rax, 0xFFFFFFFFFFFFFFEA;             // -EINVAL (bit-7 not set)
        jmp sys_ipc_reply_done
      }
    }
}
