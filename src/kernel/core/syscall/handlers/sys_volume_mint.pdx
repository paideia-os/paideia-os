// src/kernel/core/syscall/handlers/sys_volume_mint.pdx
// R90-XREPO.LV11.M2-003 (paideia-os #2225): sys_volume_mint body.
//
// The ring-3-facing KIND_VOLUME mint syscall. Closes the SECTION 0
// gap kind_volume.pdx §0 has named since R52.M5-001 landed:
//
//     No cap-invoke op that reaches kind_volume_mint. The kernel HAS
//     the mint primitive internally (volume_cap_mint_inner) but
//     exposes no ring-3-reachable syscall or cap-invoke ordinal that
//     lets a mount.pdxfs / mkfs.pdxfs running in ring 3 mint a fresh
//     KIND_VOLUME from a KIND_BLOCK_DEVICE parent.
//
// This handler wires the marshalling shim: it walks the caller's
// volume descriptor into a kernel-side scratch, parses the descriptor
// fields, stages a transient KIND_MEMORY parent cap, calls the
// existing volume_cap_mint_inner primitive, publishes the resulting
// row into a fresh cap_table slot with rights = R_VOL_INVOKE +
// R_VOL_OBSERVE, and returns the slot to the caller. The semantic
// validation of the superblock (pdxb_verify_superblock) lives in
// libpdx-volume; this handler carries the marshalling only.
//
// Contract (SysV, 2 args):
//   rdi = vol_desc_va  -- user VA of a NUL-terminated volume descriptor
//                         (see SECTION 1 for the wire layout)
//   rsi = vol_desc_len -- byte length of the descriptor, in [40, 256]
//   -> rax = 0..127 on success (cap_table slot ID)
//        or a negative-errno u64 on failure:
//        -EFAULT   (0xFFFFFFFFFFFFFFF2)  vol_desc_va failed user_ptr_ok,
//                                        or user_read_bytes_via_walk
//                                        faulted mid-copy
//        -EINVAL   (0xFFFFFFFFFFFFFFEA)  vol_desc_len < 40 or > 256, or
//                                        descriptor magic mismatch, or
//                                        backend_kind not 1, or
//                                        device_slot >= 256
//        -ENOSPC   (0xFFFFFFFFFFFFFFE4)  cap_table full (no free slot)
//        -EIO      (0xFFFFFFFFFFFFFFFB)  volume_cap_mint_inner refused
//                                        (fold VOL_MINT_BAD_* / VOL_
//                                        REGISTRY_FULL into a single
//                                        surface-level -EIO)
//
// =============================================================================
// SECTION 1  VOLUME DESCRIPTOR WIRE FORMAT (40 bytes minimum)
// =============================================================================
//
//   [+0]   magic       (u64)  =  0x3143534456584450 = "PDXVDSC1" LE
//   [+8]   device_slot (u64)  -- KIND_BLOCK_DEVICE / KIND_BLKDEV cap
//                                slot the caller holds against the
//                                backing block device (must be in
//                                [0, 256)); this handler stores it
//                                into the volume row's header via
//                                volume_hdr_pack.
//   [+16]  uuid_lo     (u64)  -- low 64 bits of the volume UUID
//   [+24]  uuid_hi     (u64)  -- high 64 bits of the volume UUID
//   [+32]  backend_kind(u64)  -- 1 = PDXFS_BLOCK (the only supported
//                                backend at this landing); other
//                                values refused with -EINVAL
//   [+40]  reserved    (up to 216 bytes) -- ignored by this handler;
//                                may carry a superblock PA / journal
//                                head hint for the libpdx-volume
//                                pdxb_verify_superblock helper the
//                                caller runs BEFORE issuing this
//                                syscall.
//
// The 40-byte minimum matches libpdx-volume/src/vol_kind.pdx v1.1.0's
// vol_kind_mint_elevate stub layout byte-for-byte. Descriptors up to
// 256 bytes are accepted so a future landing can bolt on optional
// tail fields without breaking the wire contract.
//
// =============================================================================
// SECTION 2  MINT STAGING SLOT
// =============================================================================
//
// The KIND_VOLUME derivation gate (volume_check_parent_memory) requires
// parent.kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200).
// Ring-3 callers HOLD a KIND_BLOCK_DEVICE cap, not a KIND_MEMORY cap;
// this handler pre-mints a transient KIND_MEMORY parent at a fixed
// staging slot (SYSVM_STAGING_SLOT = 134, free by construction --
// R66v2 caps sit below 128; sys_framebuffer_create claims 132;
// drivers/dpy/iris_xe_vblank_isr.pdx §L26 names 133 as its own
// future staging slot; boot witnesses pdxfs_pkg_install_smoke.pdx
// and r104_iris_xe_flip.pdx consume 136 and 137; slot 134 is the
// first genuinely unclaimed slot in the 128..255 band at this
// landing), calls volume_cap_mint_inner, then scrubs the staging
// slot so it does not leak the transient authority.
//
// The staging-slot pattern mirrors sys_framebuffer_create's SYSFB_
// STAGING_SLOT (132) one-for-one; a future round that lands a real
// KIND_BLOCK_DEVICE -> KIND_VOLUME derivation gate replaces this
// staging dance with a direct parent-gate on the caller-held block-
// device cap (matches libpdx-volume/src/vol_kind.pdx v1.1.0's
// vol_kind_mint_elevate design intent).
//
// =============================================================================
// SECTION 3  ENCODER DISCIPLINE
// =============================================================================
//
// No `add reg, [mem]`, no `mov_bzx` / `mov_wzx`, no `test`. KIND_
// VOLUME (0x1A0) and KIND_MEMORY (4) both stage through r10/r11
// where compares matter. Descriptor magic 0x3143534456584450 is a
// 64-bit immediate, staged through r11. Labels prefixed `svm_`
// (sys-volume-mint).

module SysVolumeMint = structure {

  // Sysno 114 (see design/user/syscall-table.md; wired at
  // src/kernel/core/syscall/dispatch.pdx dispatch_volume_mint).
  pub let SYSVM_SYSNO : u64 = 114

  // Descriptor magic (see SECTION 1). "PDXVDSC1" in LE u64 form.
  pub let SYSVM_MAGIC : u64 = 0x3143534456584450

  // Descriptor length bounds.
  pub let SYSVM_DESC_MIN : u64 = 40
  pub let SYSVM_DESC_MAX : u64 = 256

  // Backend kind gate: only PDXFS_BLOCK supported at this landing.
  pub let SYSVM_BACKEND_PDXFS_BLOCK : u64 = 1

  // Transient KIND_MEMORY parent staging slot (see SECTION 2).
  pub let SYSVM_STAGING_SLOT : u64 = 134

  // Errno sentinels (SysV sign-extended u64 form).
  pub let SYSVM_ERR_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYSVM_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA
  pub let SYSVM_ERR_ENOSPC : u64 = 0xFFFFFFFFFFFFFFE4
  pub let SYSVM_ERR_EIO    : u64 = 0xFFFFFFFFFFFFFFFB

  // Local copies of the constants this handler needs, avoiding
  // cross-module let resolution the way sys_framebuffer_create.pdx
  // takes at L36-41.
  pub let SYSVM_KIND_VOLUME    : u64 = 0x1A0
  pub let SYSVM_KIND_MEMORY    : u64 = 4
  pub let SYSVM_R_VOL_INVOKE   : u64 = 0x008
  pub let SYSVM_R_VOL_OBSERVE  : u64 = 0x400
  pub let SYSVM_R_VOL_MINT_BUS : u64 = 0x408   // (INVOKE | OBSERVE) at publish
  pub let SYSVM_RIGHT_MINT     : u64 = 0x200
  pub let SYSVM_CAP_SLOT_MAX   : u64 = 256

  // Bounce buffer for the incoming descriptor. Sized to SYSVM_DESC_
  // MAX; per-syscall (single-writer at this landing, matching the
  // sibling _dispatch_*_scratch discipline in syscall/dispatch.pdx).
  pub let mut _sys_volume_mint_desc_scratch : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_volume_mint_body(vol_desc_va, vol_desc_len) -> u64
  //
  // See file header for the full contract + sequence + error
  // taxonomy. Called by dispatch_volume_mint after the SysV register
  // shuffle (rsi=a0, rdx=a1 -> rdi=a0, rsi=a1).
  //
  // Sequence:
  //   (1) vol_desc_len in [SYSVM_DESC_MIN, SYSVM_DESC_MAX] else -EINVAL.
  //   (2) user_ptr_ok(vol_desc_va, vol_desc_len) -> 0/1. Non-zero -> -EFAULT.
  //   (3) user_read_bytes_via_walk(_sys_volume_mint_desc_scratch,
  //                                vol_desc_va, vol_desc_len) -> 0 or -EFAULT.
  //   (4) Parse the descriptor:
  //         magic         @ scratch+0   must == SYSVM_MAGIC else -EINVAL
  //         device_slot   @ scratch+8   must < 256 else -EINVAL
  //         uuid_lo       @ scratch+16
  //         uuid_hi       @ scratch+24
  //         backend_kind  @ scratch+32  must == 1 else -EINVAL
  //   (5) volume_hdr_pack(device_slot, mount_slot = 0xFFFF) -> hdr.
  //   (6) Pre-mint transient KIND_MEMORY parent at SYSVM_STAGING_SLOT
  //         with target_ptr = 0 (opaque; the volume mint's parent
  //         gate consults only kind + RIGHT_MINT, not target_ptr).
  //   (7) volume_cap_mint_inner(SYSVM_STAGING_SLOT, R_VOL_INVOKE +
  //         R_VOL_OBSERVE + R_VOL_READ (0x001), hdr, uuid_lo, uuid_hi)
  //         -> row_id in [0, 16) or VOL_MINT_* sentinel.
  //         Any sentinel folds to -EIO.
  //   (8) Scrub SYSVM_STAGING_SLOT (cap_mint_write with kind=0,
  //         rights=0, target=0).
  //   (9) Free-slot scan of cap_table for kind==0. -ENOSPC if full.
  //   (10) cap_mint_write(slot, KIND_VOLUME, R_VOL_INVOKE | R_VOL_
  //         OBSERVE, target = row_id).
  //   (11) Emit fingerprint via klog_s1_d2(LEVEL_INFO, SUBSYS_CAP_,
  //         tag_sys_volume_mint_ok, k_slot, cap_slot, k_row, row_id).
  //   (12) Return cap_slot.
  //
  // Register plan: rbx=vol_desc_va, r12=vol_desc_len, r13=hdr /
  // row_id, r14=uuid_lo / cap_slot, r15=uuid_hi, rbp=device_slot.
  // Six callee-save pushes + sub rsp,8 pad = 56 bytes -> rsp%16==0
  // for every nested call from entry rsp%16==8.
  // ==========================================================================

  pub let sys_volume_mint_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (vol_desc_va: u64) (vol_desc_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M2-003 (paideia-os #2225): sys_volume_mint body, SC+ ID 114. Entry: rdi=vol_desc_va, rsi=vol_desc_len. Sequence: (1) length bounds in [40,256] -> -EINVAL; (2) user_ptr_ok(va,len) -> -EFAULT; (3) user_read_bytes_via_walk into _sys_volume_mint_desc_scratch -> -EFAULT; (4) parse magic, device_slot (<256), uuid_lo, uuid_hi, backend_kind (==1) -> -EINVAL on any mismatch; (5) volume_hdr_pack(device_slot, 0xFFFF) via inline compute (device_slot in bits [39:24], mount_slot 0xFFFF in bits [55:40]); (6) cap_mint_write(134, KIND_MEMORY=4, RIGHT_MINT=0x200, 0) to stage the transient parent; (7) volume_cap_mint_inner(134, R_VOL_INVOKE|R_VOL_OBSERVE|R_VOL_READ=0x409, hdr, uuid_lo, uuid_hi) -> row_id or sentinel; fold sentinel to -EIO; (8) scrub staging slot (cap_mint_write with all zeros); (9) free-slot scan of cap_table for kind==0 in [0, 256); (10) cap_mint_write(slot, KIND_VOLUME=0x1A0, R_VOL_INVOKE|R_VOL_OBSERVE=0x408, row_id); (11) klog_s1_d2 fingerprint with tag_sys_volume_mint_ok / k_slot / k_row; (12) return slot. Six callee-save pushes + sub rsp,8 pad = 56 bytes -> rsp%16==0 for every nested call from entry rsp%16==8 SysV. Failure funnels: svm_efault / svm_einval / svm_enospc / svm_eio each set rax and jmp svm_out. Effects {mem, sysreg}: mem for scratch + row + cap_table writes; sysreg transitively from user_read_bytes_via_walk's walker + klog_s1_d2's TSC read. Capability {cap}: transitively via cap_mint_write. Encoder-conservative: cmp/je/jne/jae/ja/mov/lea/xor/shl/shr/or/and/push/pop/call/sub/add/ret only; magic literal 0x3143534456584450 stages through r11 first. Labels prefixed svm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // vol_desc_va
        mov r12, rsi;                    // vol_desc_len

        // ---- (1) Length bounds ----
        mov r10, 40;                     // SYSVM_DESC_MIN
        cmp r12, r10;
        jb  svm_einval;
        mov r10, 256;                    // SYSVM_DESC_MAX
        cmp r12, r10;
        ja  svm_einval;

        // ---- (2) user_ptr_ok(va, len) ----
        mov rdi, rbx;
        mov rsi, r12;
        call user_ptr_ok;
        cmp rax, 0;
        jne svm_efault;

        // ---- (3) user_read_bytes_via_walk(scratch, va, len) ----
        lea rdi, [rip + _sys_volume_mint_desc_scratch];
        mov rsi, rbx;
        mov rdx, r12;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne svm_efault;

        // ---- (4) Parse descriptor ----
        // magic @ scratch+0 must equal SYSVM_MAGIC.
        lea r10, [rip + _sys_volume_mint_desc_scratch];
        mov rax, [r10 + 0];
        mov r11, 0x3143534456584450;     // SYSVM_MAGIC
        cmp rax, r11;
        jne svm_einval;

        // device_slot @ scratch+8; must < 256.
        mov rbp, [r10 + 8];              // rbp = device_slot
        mov r11, 256;
        cmp rbp, r11;
        jae svm_einval;

        // uuid_lo @ scratch+16, uuid_hi @ scratch+24.
        mov r14, [r10 + 16];             // r14 = uuid_lo
        mov r15, [r10 + 24];             // r15 = uuid_hi

        // backend_kind @ scratch+32 must == 1.
        mov rax, [r10 + 32];
        cmp rax, 1;                      // SYSVM_BACKEND_PDXFS_BLOCK
        jne svm_einval;

        // ---- (5) Pack hdr inline: device_slot in [39:24] | mount_slot
        //         0xFFFF in [55:40]. Bits [63:56] left zero (volume_
        //         tail_alloc's allocator publishes the in_use marker
        //         itself). ----
        mov rax, rbp;
        shl rax, 24;                     // device_slot in [39:24]
        mov r11, 0xFFFF;
        shl r11, 40;                     // mount_slot 0xFFFF in [55:40]
        or  rax, r11;
        mov r13, rax;                    // r13 = hdr

        // ---- (6) Stage transient KIND_MEMORY parent ----
        //   cap_mint_write(134, KIND_MEMORY=4, RIGHT_MINT=0x200, 0).
        mov rdi, 134;                    // SYSVM_STAGING_SLOT
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;                    // target_ptr = 0 (opaque)
        call cap_mint_write;

        // ---- (7) volume_cap_mint_inner(parent=134, rights=0x409,
        //         hdr, uuid_lo, uuid_hi) ----
        //   R_VOL_READ (0x001) | R_VOL_INVOKE (0x008) | R_VOL_OBSERVE
        //   (0x400) = 0x409. Match volume_rights_valid's subset test
        //   against R_VOL_ALL = 0x43B (0x409 is a legal subset).
        mov rdi, 134;                    // parent_slot
        mov rsi, 0x409;                  // rights (READ|INVOKE|OBSERVE)
        mov rdx, r13;                    // hdr
        mov rcx, r14;                    // uuid_lo
        mov r8,  r15;                    // uuid_hi
        call volume_cap_mint_inner;
        // rax = row_id in [0, 16) or VOL_MINT_* / VOL_REGISTRY_FULL /
        // VOL_TAIL_BAD_ARG sentinel (all >= 0xFFFFED20).
        mov r10, 16;                     // VOL_MAX
        cmp rax, r10;
        jae svm_eio;
        mov r13, rax;                    // r13 = row_id (survives)

        // ---- (8) Scrub the staging slot ----
        mov rdi, 134;                    // SYSVM_STAGING_SLOT
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // ---- (9) Free-slot scan of cap_table for kind==0 ----
        // r14 reused as slot cursor (uuid_lo dead post step 7).
        xor r14, r14;                    // slot cursor
      svm_scan:
        mov r10, 256;                    // SYSVM_CAP_SLOT_MAX
        cmp r14, r10;
        jae svm_enospc;
        lea rax, [rip + cap_table];
        mov r10, r14;
        shl r10, 3;
        mov r11, r14;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov rcx, [rax + 0];
        cmp rcx, 0;
        je  svm_slot_ok;
        add r14, 1;
        jmp svm_scan;
      svm_slot_ok:

        // ---- (10) Publish KIND_VOLUME cap ----
        //   cap_mint_write(r14, KIND_VOLUME=0x1A0, R_VOL_INVOKE |
        //                  R_VOL_OBSERVE = 0x408, row_id).
        mov rdi, r14;                    // slot
        mov rsi, 0x1A0;                  // KIND_VOLUME
        mov rdx, 0x408;                  // R_VOL_INVOKE | R_VOL_OBSERVE
        mov rcx, r13;                    // target = row_id
        call cap_mint_write;

        // ---- (11) Fingerprint emit ----
        //   klog_s1_d2(LEVEL_INFO=3, SUBSYS_CAP_, tag_sys_volume_mint_ok,
        //              k_slot, cap_slot, k_row, row_id).
        // r14 = cap_slot, r13 = row_id (v2 on stack).
        mov rdi, 3;                                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_sys_volume_mint_ok];
        lea rcx, [rip + k_slot];
        mov r8, r14;                                       // v1 = cap_slot
        lea r9, [rip + k_row];
        sub rsp, 8;                                        // pad (%16: 0 -> 8)
        push r13;                                          // v2 = row_id (%16: 8 -> 0)
        call klog_s1_d2;
        add rsp, 16;

        // ---- (12) Success: return cap_slot ----
        mov rax, r14;
        jmp svm_out;

      svm_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT
        jmp svm_out;
      svm_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;     // -EINVAL
        jmp svm_out;
      svm_enospc:
        mov rax, 0xFFFFFFFFFFFFFFE4;     // -ENOSPC
        jmp svm_out;
      svm_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;     // -EIO

      svm_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
