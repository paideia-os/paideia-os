// src/kernel/core/syscall/handlers/sys_execve_shim.pdx — R17-M0-671 (#671)
//   + R17-M0-730 D10b (#730): return-frame rewrite for exec-completes semantics.
// sys_execve dispatch shim: path→image copy-in + syscall return-frame rewrite.
//
// Bridges the SC+ userland ABI shape execve(path, argv, envp) to the
// kernel-internal sys_execve_body(current, image_ptr, image_len) contract
// from #555. Full design: design/kernel/r17-m0-671-sys-execve-shim.md and
// design/kernel/r17-m0-730-d10-execve-complete.md.
//
// Sequence (all failure paths return sign-extended -errno in rax, rdx=0):
//   1. user_ptr_ok(path_va, 1)                         — reject kernel ptrs early
//   2. Byte-copy path into _execve_path_scratch        — bounded 256 B, NUL-terminated
//   3. vfs_open(scratch_path, O_RDONLY=0) → vnode_idx  — 0 => -ENOENT
//   4. Page-sized read loop into _execve_image_scratch — until EOF / short / cap
//   5. ELF magic check on image[0..4] == "\x7fELF"     — mismatch => -ENOEXEC
//   6. vfs_close(vnode_idx)                            — best-effort refcount drop
//   7. sys_execve_body(current, image, image_len)      — commits new aspace in TCB+16
//   8. (D10b) On body success (rax==0): user_stack_alloc(new_pml4_va, 4)
//      → new_user_rsp_top; rewrite syscall return frame so sysret enters the
//      new image:
//        [current.kstack_top -  8] = entry_rip (from body's rdx)
//        [current.kstack_top - 16] = 0x202 (fresh IF=1 rflags)
//        [current + 104]            = new_user_rsp_top
//      The syscall_entry epilogue reads these three slots plus TCB+16 (new
//      user_pml4_va, already committed by body) to construct the sysret
//      return. See design doc §4 for the exact stack topology.

module SysExecveShim = structure {
  // ==========================================================================
  // Constants
  // ==========================================================================

  // Path buffer cap — matches _vfs_open_parent_scratch's 256 B (see vfs_open.pdx).
  pub let EXECVE_PATH_MAX  : u64 = 256

  // Image buffer cap — matches tmpfs's 64 KiB file-size cap (tmpfs/write.pdx
  // section 4.4 range gate). 16 × 4 KiB pages, aligned so a future backtrack
  // to phys_alloc(4) is drop-in.
  pub let EXECVE_IMAGE_MAX : u64 = 65536
  pub let EXECVE_PAGE_SIZE : u64 = 4096

  // Linux errno constants (sign-extended to u64), matching PtrCheck.EFAULT
  // and sys_open.pdx conventions.
  pub let EFAULT_U64  : u64 = 0xFFFFFFFFFFFFFFF2   // -14
  pub let ENOENT_U64  : u64 = 0xFFFFFFFFFFFFFFFE   // -2
  pub let EIO_U64     : u64 = 0xFFFFFFFFFFFFFFFB   // -5
  pub let ENOEXEC_U64 : u64 = 0xFFFFFFFFFFFFFFF8   // -8
  pub let E2BIG_U64   : u64 = 0xFFFFFFFFFFFFFFF9   // -7
  pub let ENOMEM_U64  : u64 = 0xFFFFFFFFFFFFFFF4   // -12

  // (D10b) TCB byte-offsets used for return-frame rewrite. Must match
  // task_pool.pdx (KSTACK_TOP @+24) and entry.pdx (SAVED_USER_RSP @+104).
  pub let TCB_OFF_KSTACK_TOP     : u64 = 24
  pub let TCB_OFF_SAVED_USER_RSP : u64 = 104

  // (D10b) Fresh user RFLAGS for exec-completes sysret. Bit 1 is reserved-
  // must-be-1, bit 9 is IF (interrupts on). Matches enter_userland_initial's
  // iretq frame (enter_user.pdx) and Linux/BSD execve semantics.
  pub let EXECVE_FRESH_RFLAGS : u64 = 0x202

  // (D10b) User-stack size for the new image (in 4 KiB pages). Matches the
  // init_boot_bootstrap allocation in kernel_main so the new process gets
  // the same stack footprint init had at boot.
  pub let EXECVE_USER_STACK_PAGES : u64 = 4

  // VOPS error sentinel (matches vfs_read.pdx / tmpfs_read.pdx failure return).
  pub let VOPS_ERR_SENTINEL : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Kernel-owned scratch storage (.bss)
  //
  // Both live in the kernel high-half; loads/stores use RIP-relative lea.
  // _execve_image_scratch is @align(4096) so a future backtrack to phys_alloc
  // (per design §3.4 rationale 2) is a drop-in replacement.
  // ==========================================================================
  pub let mut _execve_path_scratch  : [u8; 256]   = uninit @align(8)
  pub let mut _execve_image_scratch : [u8; 65536] = uninit @align(4096)

  // ==========================================================================
  // sys_execve_shim(current, path_va, argv_va, envp_va) -> u64
  //
  // SysV AMD64:
  //   rdi = current   (task_struct*, non-NULL — dispatcher loads _current_tcb)
  //   rsi = path_va   (user VA of NUL-terminated path)
  //   rdx = argv_va   (IGNORED at R17.M0 — see design §1 Non-Scope)
  //   rcx = envp_va   (IGNORED at R17.M0 — see design §1 Non-Scope)
  //
  // Returns:
  //   rax = 0 on success (with rdx = ELF e_entry from sys_execve_body)
  //   rax = -errno on failure (rdx = 0)
  // ==========================================================================
  pub let sys_execve_shim : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (current: u64) (path_va: u64) (argv_va: u64) (envp_va: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {},
      justification: "R17-M0-671 (#671): sys_execve dispatch shim. Bridges the SC+ userland execve(path, argv, envp) shape to sys_execve_body(current, image_ptr, image_len) from #555, which cannot accept a path directly (its ABI expects an already-loaded ELF blob). Five-push callee-save prologue (rbx, r12, r13, r14, r15) lands rsp%16==0 for every nested call per SysV AMD64. Register plan: rbx=current (needed for sys_execve_body), r12=path_va (needed only through phase 3 copy, then dead), r13=vnode_idx (set by vfs_open in phase 4, used by vfs_read in phase 5 and vfs_close in phase 7), r14=byte-index / offset / image_len (repurposed across phases 3→5→8), r15=_execve_image_scratch base VA (lea'd once in phase 5, used by phase 6 magic check and phase 8 sys_execve_body call). Phase 2 calls user_ptr_ok(path_va, 1) to reject a kernel-half pointer up front — Phase 1 range check per #541; per-page walk is deferred. Phase 3 byte-copies path bytes from user VA (r12) into _execve_path_scratch via `mov_b rax, [r12 + r14*1]; mov_b [scratch + r14*1], rax` with NUL detection; loop bound = EXECVE_PATH_MAX = 256; overrun => -EFAULT. rax is pre-zeroed (xor rax, rax) before every mov_b load to guarantee upper-bit zero-extension (matches path.pdx and libc_test.pdx convention; the mov_b primitive emits an 8-bit MOV that does NOT movzx, so pre-zeroing is required for the subsequent `cmp rax, 0` byte compare to see only the loaded byte). Phase 4 calls vfs_open(scratch, O_RDONLY=0); a zero return means either path unresolvable or tmpfs backing missing, both surfaced as -ENOENT. Phase 5 is a page-loop calling vfs_read(r13, r15+offset, 4096, offset) at offsets 0, 4096, 8192, ... Each iteration receives EITHER a full-page 4096 return (continue), a short return < 4096 (last chunk, exit loop), a 0 return (EOF at page boundary, exit loop), or the VOPS_ERR_SENTINEL (0xFFFFFFFFFFFFFFFF, error — vfs_close and return -EIO). If offset ever reaches EXECVE_IMAGE_MAX (65536) before EOF, return -E2BIG (with vfs_close). Cross-page reads are structurally prevented by the page-aligned offset schedule: tmpfs_read.pdx §4.7 forbids cross-page but each iteration here fits inside one page by construction. Phase 6 validates ELF magic byte-by-byte at image[0..4]; mismatch => -ENOEXEC. Phase 7 vfs_close(vnode_idx); return value ignored per #576's phase 3.4 discipline (every legal producer-side vnode_idx round-trips safely through vfs_close's decrement). Phase 8 marshals (rbx, r15, r14) into (rdi, rsi, rdx) and calls sys_execve_body — its {rax, rdx} pair propagates verbatim as our return. Alignment for the sys_execve_body call: 5-push prologue + return-address = 48 B = 16 mod 0 aligned, no additional sub rsp,8 needed. All error branches jump to labelled shared exits (fail_efault, fail_enoent, fail_eio_close, fail_ebad_close, fail_e2big_close) that set rax=-errno, rdx=0, and (for the *_close variants) invoke vfs_close(r13) to release the vnode refcount before returning — matches the resource-discipline rule that every successful vfs_open must be paired with a vfs_close on every failure path past phase 4. On path-copy failure (phase 3) the vnode hasn't been opened yet, so no close needed.",
      block: {
        // ===== Prologue (5 pushes for rsp%16==0 at nested calls) =====
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ===== Phase 1: Save args in callee-save regs =====
        mov rbx, rdi;                             // rbx = current
        mov r12, rsi;                             // r12 = path_va
        // rdx (argv_va), rcx (envp_va) intentionally ignored at R17.M0.

        // ===== Phase 2: user_ptr_ok(path_va, 1) — reject kernel pointers =====
        mov rdi, r12;                             // arg0 = path_va
        mov rsi, 1;                               // arg1 = len (1 byte probe)
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        cmp rax, 0;
        jne sys_execve_shim_fail_efault;

        // ===== Phase 3: Copy path from user VA into _execve_path_scratch =====
        // R17-M0-730 D10d (#730): strict-KPTI-safe path copy.
        //
        // Original Phase 3 did `mov_b rax, [r12]` reading via the caller's
        // user VA under kernel CR3 (post-syscall_entry CR3 flip).  That
        // read hits the boot PML4's low identity map at PHYSICAL
        // address=user_va, which does NOT contain the user PML4's
        // per-VA→phys mapping — same silent-NUL failure #724 D4 fixed
        // for sys_debug_puts.  Confirmed on wire: shim printed 'Sn'
        // (entered, then ENOENT) because vfs_open received a zero-length
        // (immediate NUL) path buffer — the first byte read of the user
        // path from the wrong physical page happened to be 0.
        //
        // Fix: delegate to user_read_str_via_walk which does a per-byte
        // 4-level PML4 walk and reads via the higher-half identity map.
        //
        // Return semantics: >0 = strlen (NUL already copied at kernel
        // dst[strlen]); 0 = fault (unmapped) OR cap-overflow with no NUL —
        // both surface as -EFAULT.
        mov rdi, r12;                             // arg0 = path_va (user VA)
        lea rsi, [rip + _execve_path_scratch];    // arg1 = kernel_dst
        mov rdx, 256;                             // arg2 = cap = EXECVE_PATH_MAX
        call user_read_str_via_walk;              // rax = strlen or 0
        cmp rax, 0;
        je  sys_execve_shim_fail_efault;

      sys_execve_shim_copied:
        // ===== Phase 4: vfs_open(scratch_path, O_RDONLY=0) =====
        lea rdi, [rip + _execve_path_scratch];    // arg0 = path_ptr (kernel scratch)
        xor rsi, rsi;                             // arg1 = flags (O_RDONLY = 0)
        call vfs_open;                            // rax = vnode_idx (u16 low bits) or 0
        cmp rax, 0;
        je  sys_execve_shim_fail_enoent;
        mov r13, rax;                             // r13 = vnode_idx (survives loop + close)

        // ===== Phase 5: page-sized read loop into _execve_image_scratch =====
        //   r14 = accumulated offset (bytes read so far); starts at 0
        //   r15 = _execve_image_scratch base VA (stable throughout)
        //   Each iteration: vfs_read(r13, r15+r14, 4096, r14)
        //     rax == VOPS_ERR_SENTINEL => -EIO (after vfs_close)
        //     rax == 0                 => EOF at page boundary, exit loop
        //     rax <  4096              => short chunk, add to r14, exit loop
        //     rax == 4096              => full page, add, continue
        //   Cap: r14 must stay strictly below EXECVE_IMAGE_MAX; hitting the cap
        //   before EOF => -E2BIG.
        xor r14, r14;                             // r14 = image offset / bytes read
        lea r15, [rip + _execve_image_scratch];   // r15 = image scratch base

      sys_execve_shim_read_loop:
        // Cap check (before issuing another read).
        // Debugger note (2026-08-06): must be `ja`, not `jae`. At r14 == 65536
        // we're EXACTLY at tmpfs's own file-size ceiling; letting vfs_read run
        // returns 0 (EOF via offset >= size) and the loop exits cleanly. The
        // prior `jae` spuriously rejected any file of exactly 65536 bytes as
        // -E2BIG despite not overflowing the buffer.
        mov rax, 65536;                           // EXECVE_IMAGE_MAX
        cmp r14, rax;
        ja  sys_execve_shim_fail_e2big_close;

        // vfs_read(vnode_idx=r13, buf=r15+r14, len=4096, offset=r14)
        mov rdi, r13;                             // arg0 = vnode_idx
        mov rsi, r15;
        add rsi, r14;                             // arg1 = buf ptr = scratch + offset
        mov rdx, 4096;                            // arg2 = len
        mov rcx, r14;                             // arg3 = offset
        call vfs_read;                            // rax = bytes read or sentinel

        // Error sentinel check.
        mov rcx, 0xFFFFFFFFFFFFFFFF;              // VOPS_ERR_SENTINEL
        cmp rax, rcx;
        je  sys_execve_shim_fail_eio_close;

        // EOF (0 bytes) at page boundary.
        cmp rax, 0;
        je  sys_execve_shim_read_done;

        // Accumulate.
        add r14, rax;

        // Short chunk (< 4096) means the file ended mid-page: last iteration.
        cmp rax, 4096;
        jb  sys_execve_shim_read_done;

        // Full page — go around.
        jmp sys_execve_shim_read_loop;

      sys_execve_shim_read_done:
        // r14 = total bytes read = image_len.

        // ===== Phase 6: ELF magic check =====
        // Need at least 4 bytes for the magic (in practice ELF64 header is
        // 64 bytes; sys_execve_body / elf_lite_load will re-verify header
        // size and phdr integrity, but we do a quick prefilter to catch
        // clearly non-ELF payloads before allocating a new aspace).
        cmp r14, 4;
        jb  sys_execve_shim_fail_ebad_close;

        xor rax, rax;                             // pre-zero for byte load
        mov_b rax, [r15 + 0];
        cmp rax, 0x7F;                            // \x7f
        jne sys_execve_shim_fail_ebad_close;
        xor rax, rax;
        mov_b rax, [r15 + 1];
        cmp rax, 0x45;                            // 'E'
        jne sys_execve_shim_fail_ebad_close;
        xor rax, rax;
        mov_b rax, [r15 + 2];
        cmp rax, 0x4C;                            // 'L'
        jne sys_execve_shim_fail_ebad_close;
        xor rax, rax;
        mov_b rax, [r15 + 3];
        cmp rax, 0x46;                            // 'F'
        jne sys_execve_shim_fail_ebad_close;

        // ===== Phase 7: vfs_close(vnode_idx) — drop refcount =====
        // return value ignored per vfs_close.pdx §6 mode-4 discipline.
        mov rdi, r13;
        call vfs_close;

        // ===== Phase 8: sys_execve_body(current, image_ptr, image_len) =====
        // On success: rax = 0, rdx = entry_rip (u64 = ELF e_entry).
        // On failure: rax = ELF_* errno (0xFFFFFFFA..FF), rdx = 0.
        // On failure we forward {rax, rdx} verbatim (jmp done).
        mov rdi, rbx;                             // arg0 = current
        mov rsi, r15;                             // arg1 = image_ptr = scratch base
        mov rdx, r14;                             // arg2 = image_len
        call sys_execve_body;                     // {rax, rdx} = body's return

        // Body-failure fast return.
        cmp rax, 0;
        jne sys_execve_shim_done;                 // rax != 0 → failure, {rax,rdx} passthrough

        // ===== Phase 9 (D10b): exec-completes — allocate user stack + =====
        //                       rewrite syscall return frame.
        //
        // At this point:
        //   rbx = current (task_struct*)
        //   rax = 0, rdx = entry_rip
        //   TCB.user_pml4_va @+16 = NEW aspace's PML4 VA (committed by body)
        //   Old aspace was torn down by body — the ONLY VA still valid in
        //   the new aspace is the ELF's mapped segments; NO stack exists.
        //
        // Plan: (a) stash entry_rip in r14 (image_len is dead post-body);
        // (b) user_stack_alloc(new_pml4_va, EXECVE_USER_STACK_PAGES) → r13;
        // (c) if OOM, jump to fail_nomem (the process is in a broken state —
        // old aspace gone, no stack — but at least sysret with -ENOMEM lets
        // the caller observe the failure; likely followed by a #PF that
        // kills the process); (d) rewrite the three slots (kstack_top-8,
        // kstack_top-16, TCB+104) so syscall_entry's epilogue sysrets into
        // the new image with fresh rflags on the new stack.
        //
        // Register discipline: rbx (current) and r15 (image scratch base)
        // survive the user_stack_alloc call per SysV callee-save. r14 is
        // repurposed from image_len (dead post-body) to entry_rip. r13 is
        // repurposed from vnode_idx (dead post-vfs_close in phase 7) to
        // user_rsp_top. Alignment: user_stack_alloc's own 4-push prologue
        // (r12-r15) already handles its own %16==8 entry contract; the shim
        // entered at %16==8 (dispatch's sub rsp,8 pad + our 5-push prologue),
        // so the call site here is %16==8 — no additional pad needed.
        mov r14, rdx;                             // r14 = entry_rip (save)
        mov rdi, [rbx + 16];                      // arg0 = new_pml4_va (VA form)
        mov rsi, 4;                               // arg1 = EXECVE_USER_STACK_PAGES
        call user_stack_alloc;                    // rax = user_rsp_top or 0
        cmp rax, 0;
        je  sys_execve_shim_fail_nomem;
        mov r13, rax;                             // r13 = new user_rsp_top

        // (d.1) Rewrite [current.kstack_top - 8] with entry_rip. This slot
        //       holds the user RIP that syscall_entry pushed (rcx post-syscall
        //       via SDM §6.15 SYSCALL semantics). The epilogue's `pop rcx`
        //       will load this into rcx, and sysret loads RIP <- rcx.
        mov rax, [rbx + 24];                      // rax = current.kstack_top
        mov [rax - 8], r14;                       // saved user RIP := entry_rip

        // (d.2) Rewrite [current.kstack_top - 16] with fresh rflags. This slot
        //       holds the user rflags that syscall_entry pushed (r11 pre-syscall
        //       masked by IA32_FMASK). The epilogue's `pop r11` loads this into
        //       r11, and sysret loads RFLAGS <- r11. 0x202 = IF|reserved-1.
        mov rcx, 0x202;                           // EXECVE_FRESH_RFLAGS
        mov [rax - 16], rcx;                      // saved user rflags := 0x202

        // (d.3) Rewrite TCB.saved_user_rsp @+104 with new user_rsp_top. The
        //       epilogue reloads rsp from this slot after the CR3 flip.
        //       #728 D9 wired this slot; before D9 it was a global that
        //       would have been clobbered by intervening tasks.
        mov [rbx + 104], r13;                     // TCB.saved_user_rsp := new rsp

        // Success return: rax = 0 (execve returns 0 to child on success,
        // which the child never observes because sysret jumps to entry_rip,
        // not to the post-syscall instruction of the pre-execve code).
        // rdx cleared so nothing about the new image leaks into user rdx.
        xor rax, rax;
        xor rdx, rdx;
        jmp sys_execve_shim_done;

      sys_execve_shim_fail_nomem:
        // Rare: user_stack_alloc OOM'd. Old aspace already torn down by
        // body; TCB+16 already committed to new_pml4. The process is
        // structurally broken but rax=-ENOMEM at least surfaces the error.
        // A subsequent #PF (on sysret's instruction fetch or first user
        // access) will kill the process.
        mov rax, 0xFFFFFFFFFFFFFFF4;              // -ENOMEM
        xor rdx, rdx;
        jmp sys_execve_shim_done;

        // ===== Failure exits =====
        // Path-copy / user-pointer failures: no vnode was opened, no close.
      sys_execve_shim_fail_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        xor rdx, rdx;
        jmp sys_execve_shim_done;

        // vfs_open failure: same — no vnode acquired, nothing to close.
      sys_execve_shim_fail_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;              // -ENOENT
        xor rdx, rdx;
        jmp sys_execve_shim_done;

        // Past phase 4: vnode was acquired; must close on error paths.
      sys_execve_shim_fail_eio_close:
        mov rdi, r13;
        call vfs_close;
        mov rax, 0xFFFFFFFFFFFFFFFB;              // -EIO
        xor rdx, rdx;
        jmp sys_execve_shim_done;

      sys_execve_shim_fail_ebad_close:
        mov rdi, r13;
        call vfs_close;
        mov rax, 0xFFFFFFFFFFFFFFF8;              // -ENOEXEC
        xor rdx, rdx;
        jmp sys_execve_shim_done;

      sys_execve_shim_fail_e2big_close:
        mov rdi, r13;
        call vfs_close;
        mov rax, 0xFFFFFFFFFFFFFFF9;              // -E2BIG
        xor rdx, rdx;

      sys_execve_shim_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
