// src/kernel/core/syscall/handlers/sys_getrusage.pdx — Wave τ (τ-01)
//
// sys_getrusage(who, out) -> 0 | -EINVAL | -EFAULT | -ESRCH.
// SC+ sysno 127.
//
// Ring-3 read of resource-usage counters for the calling task.  The
// current landing supports only who == RUSAGE_SELF (0) and populates a
// 32-byte record laid out as:
//
//   offset  size  field         source
//   ------  ----  -----------   -----------------------------------------
//   +0      8     utime_ns      sched_stats_read(pid) -- cumulative
//                               user+kernel time in ns (Wave κ / κ-04
//                               did not yet split u/s time)
//   +8      8     stime_ns      always 0 -- kernel-time accounting is a
//                               follow-on wave; the slot is reserved so
//                               a caller struct sizeof survives the
//                               eventual split without a record-shape
//                               renegotiation
//   +16     8     maxrss_pages  phys-pool allocated frame count
//                               (1024 - phys_alloc_free_count()) as a
//                               v1 system-wide RSS proxy; a per-aspace
//                               walker is deferred (see §MAXRSS_APPROX)
//   +24     8     reserved      always 0 -- pad for the future 64-byte
//                               widening the POSIX `struct rusage`
//                               naturally grows into
//
// WHY THE STRUCT IS 32 BYTES AND NOT sizeof(POSIX_rusage) == 144
//
// POSIX `struct rusage` carries 16 fields (ru_utime, ru_stime, ru_maxrss,
// ru_ixrss, ru_idrss, ru_isrss, ru_minflt, ru_majflt, ru_nswap, ru_
// inblock, ru_oublock, ru_msgsnd, ru_msgrcv, ru_nsignals, ru_nvcsw, ru_
// nivcsw) totalling 144 bytes on Linux glibc.  Fourteen of those the
// kernel does not track: BSD/Linux both stub them to 0.  Rather than
// wire 144 bytes of scratch + write-back for a wave whose actual
// deliverable is "utime survives a round trip and maxrss_pages is
// non-zero on a live system", the v1 record collapses to four qwords:
// the two time slots (utime split from stime for the eventual κ+1
// widening), maxrss (the one non-time field callers routinely inspect),
// and one reserved.  A future ru_minflt / ru_majflt landing adds them
// as +32 / +40; callers that treat the record as at-least-32-bytes are
// forward-compatible; callers that treat it as exactly-32-bytes bump
// their sizeof at their own site.
//
// The v1 record is documented in design/kernel/wave-tau-resource-
// accounting.md §τ-01 so a userland `getrusage(3)` wrapper knows the
// field ordering without reverse-engineering this file.
//
// MAXRSS_APPROX (system-wide vs per-aspace)
//
// The κ-04 brief for maxrss reads "current aspace's frame_meta
// refcount".  There is no such single scalar: _frame_meta is per-frame
// (indexed by page_index in [0, PHYS_POOL_PAGES-1]), and answering
// "which of those pages does THIS aspace own" requires a PML4/PDPT/PD/
// PT walk over the current task's user_pml4 counting present-bit
// leaves -- deferred.  The v1 substitute is
// (PHYS_POOL_PAGES - phys_alloc_free_count()) = system-wide allocated
// frames, which is an honest upper bound on the current aspace's
// footprint AND non-zero on a live system (matching the acceptance
// criterion that the field reads as something meaningful).  The
// per-aspace walker will replace this call with an aspace_rss_pages
// primitive at that landing without a record-shape change (the +16
// slot IS the maxrss field).
//
// SCRATCH BUFFER
//
// user_write_bytes_via_walk needs a kernel-side source that survives
// the KPTI-safe copy back to the user's out_va.  32 bytes per-syscall
// scratch matches the record size.
//
// Audit: design/kernel/wave-tau-resource-accounting.md §τ-01.

module SysGetrusage = structure {
  // ==========================================================================
  // Constants.
  // ==========================================================================
  pub let RUSAGE_SELF        : u64 = 0
  pub let RUSAGE_CHILDREN    : u64 = 1        // reserved, refused with EINVAL at v1

  pub let RUSAGE_REC_BYTES   : u64 = 32       // 4 x u64 slots
  pub let PHYS_POOL_PAGES    : u64 = 1024     // pinned to phys_alloc.pdx's array bound

  // ==========================================================================
  // Per-syscall scratch buffer.
  // ==========================================================================
  pub let mut _sys_getrusage_out_scratch : [u64; 4] = [0, 0, 0, 0]

  // ==========================================================================
  // sys_getrusage_body(who, out_va) -> u64
  //
  //   rdi = who         -- must be RUSAGE_SELF (0) at v1
  //   rsi = out_va      -- user VA to a 32-byte destination
  //
  //   -> rax = 0        on success
  //      -EINVAL        who != RUSAGE_SELF
  //      -EFAULT        out_va rejected by user_ptr_ok, or writeback fault
  //      -ESRCH         current TCB has no live pid (shouldn't happen; the
  //                     syscall path resolves _current_tcb before entry --
  //                     defensive)
  // ==========================================================================
  pub let sys_getrusage_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (who: u64, out_va: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "Wave τ (τ-01): sys_getrusage body, sysno 127. Entry: rdi=who, rsi=out_va. 2-push callee-save prologue (rbx=out_va, r12=pid) -- entry rsp%16==8, 2 pushes -> 8; nested calls bracket with sub rsp,8/add rsp,8. Sequence: (1) EINVAL gate: who != 0 -> -EINVAL. RUSAGE_CHILDREN is reserved for a follow-on wave that will iterate the child list; refusing it here as EINVAL rather than silently answering RUSAGE_SELF keeps the surface honest. (2) user_ptr_ok(out_va, 32) -> 0 or 1; non-zero -> -EFAULT. Gates on the FULL 32-byte extent so a straddling user VA cannot pass. (3) Read _current_tcb; if NULL -> -ESRCH (pre-init boot path). Extract pid via mov ecx, [rax+0]; if pid == 0 or pid >= 64 -> -ESRCH. r12 = pid. (4) utime_ns: sched_stats_read(pid) -> rax; store at scratch[0]. (5) stime_ns: store 0 at scratch[1] -- kernel-time accounting split deferred (see file header). (6) maxrss_pages: call phys_alloc_free_count -> rax; scratch[2] = PHYS_POOL_PAGES - rax. (7) reserved: store 0 at scratch[3]. (8) user_write_bytes_via_walk(out_va, &scratch, 32) -> 0 or -EFAULT. (9) rax = 0. Effects {mem, sysreg}: mem for scratch/globals/TCB reads; sysreg transitive from user_write_bytes_via_walk's walker. Capability {cap}: matches sys_sched_stats posture (forward-compat annotation for a future per-task RUSAGE_CAP gate). Labels prefixed sgr_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rsi;                          // rbx = out_va
        // rdi = who (still)

        // (1) EINVAL gate.
        cmp rdi, 0;                            // RUSAGE_SELF
        jne sgr_einval;

        // (2) user_ptr_ok(out_va, 32).
        mov rdi, rbx;
        mov rsi, 32;
        sub rsp, 8;
        call user_ptr_ok;
        add rsp, 8;
        cmp rax, 0;
        jne sgr_efault;

        // (3) Resolve current pid.
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je  sgr_esrch;
        mov ecx, [rax + 0];                    // pid (u32 zero-ext)
        cmp rcx, 0;
        je  sgr_esrch;
        cmp rcx, 64;
        jae sgr_esrch;
        mov r12, rcx;                          // r12 = pid (survives calls)

        // (4) utime_ns = sched_stats_read(pid).
        mov rdi, r12;
        sub rsp, 8;
        call sched_stats_read;
        add rsp, 8;
        lea rcx, [rip + _sys_getrusage_out_scratch];
        mov [rcx + 0], rax;                    // scratch[0] = utime_ns

        // (5) stime_ns = 0 (deferred). Use xor+store idiom (no imm form).
        lea rcx, [rip + _sys_getrusage_out_scratch];
        xor rax, rax;
        mov [rcx + 8], rax;                    // scratch[1] = 0

        // (6) maxrss_pages = PHYS_POOL_PAGES - phys_alloc_free_count().
        sub rsp, 8;
        call phys_alloc_free_count;
        add rsp, 8;
        // rcx = 1024 - rax  (allocated frames)
        mov rcx, 1024;
        sub rcx, rax;
        lea rax, [rip + _sys_getrusage_out_scratch];
        mov [rax + 16], rcx;                   // scratch[2] = maxrss_pages

        // (7) reserved = 0.
        lea rcx, [rip + _sys_getrusage_out_scratch];
        xor rax, rax;
        mov [rcx + 24], rax;                   // scratch[3] = 0

        // (8) user_write_bytes_via_walk(out_va, &scratch, 32).
        mov rdi, rbx;
        lea rsi, [rip + _sys_getrusage_out_scratch];
        mov rdx, 32;
        sub rsp, 8;
        call user_write_bytes_via_walk;
        add rsp, 8;
        cmp rax, 0;
        jne sgr_efault;

        // (9) Success.
        xor rax, rax;
        jmp sgr_done;

      sgr_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT
        jmp sgr_done;

      sgr_esrch:
        mov rax, 0xFFFFFFFFFFFFFFFD;           // -ESRCH (-3)
        jmp sgr_done;

      sgr_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;           // -EINVAL (-22)

      sgr_done:
        pop r12;
        pop rbx;
        ret
      }
    }
}
