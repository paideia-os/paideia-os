// src/kernel/core/syscall/handlers/sys_pdxfs_fault_inject.pdx
// R90-XREPO.010.M1-005 (paideia-os #2113): sys_pdxfs_fault_inject body.
//
// The ring-3-facing arm/disarm switchboard for the PdxFS fault-injection
// substrate.  See design/kernel/pdxfs-fault-inject.md for the specification.
//
// Sysno 527 (pre-reserved out-of-band by the mv/rm design docs -- see
// design/user/syscall-table.md §Reserved out-of-band sysnos and
// dispatch.pdx's explicit sysno-527 early check).
//
// Contract (SysV, 1 arg after the dispatch shim's SysV shuffle):
//   rdi = class    -- 0 (disarm) or 1..4 (arm one of the four classes):
//                     1 = WAL_WRITE_FAIL
//                     2 = INODE_ALLOC_FAIL
//                     3 = EXTENT_ALLOC_FAIL
//                     4 = UNDO_APPEND_FAIL
//   -> rax = 0 on success, or a negative-errno u64 on failure:
//        -EPERM   (0xFFFFFFFFFFFFFFF3 = -13) -- boot flag not set (release
//                                                or a pre-enable call)
//        -EINVAL  (0xFFFFFFFFFFFFFFEA = -22) -- class > FAULT_CLASS_MAX (4)
//
// Sequencing:
//   (1) pdxfs_fault_arm(class) -- substrate's own gates handle both the
//       EPERM (enabled == 0) and EINVAL (class > 4) refusals; non-zero
//       return propagates verbatim.
//   (2) On OK, emit `sys pdxfs fault inject armed [legacy: SYS PDXFS
//       FAULT INJECT ARMED] class=<n>` via klog_s1_d1(LEVEL_INFO=3,
//       SUBSYS_FS__, tag_sys_pdxfs_fault_inject_armed, k_class, class).
//       The same tag covers both arm (class 1..4) and disarm (class 0)
//       because the caller can distinguish them by the class value in the
//       fingerprint, and folding them saves one tag declaration.
//   (3) Return 0.
//
// Register plan (1-arg SysV entry; two nested calls -- pdxfs_fault_arm and
// klog_s1_d1):
//   Single callee-save push (rbx) suffices for both alignment and class
//   preservation across the nested calls.  From entry rsp%16 == 8 SysV:
//     push rbx;   // rsp%16: 8 -> 0  (aligned for the nested call)
//     ...call sites...
//     pop rbx;    // rsp%16: 0 -> 8  (matches SysV return contract)
//     ret
//     rbx = class (survives both nested calls).
//
// [unsafe] -- transitively writes _pdxfs_fault_enabled / _pdxfs_fault_armed
// via pdxfs_fault_arm and emits klog; performs no user-VA access (no user
// pointer args on this syscall).
// Audit: design/kernel/pdxfs-fault-inject.md.
//
// Reserved-label discipline: labels prefixed `spfi_`.

module SysPdxfsFaultInject = structure {

  // Sign-extended u64 form of Linux -EPERM (-13) / -EINVAL (-22).  Matches
  // every other sys_* handler's negative-errno u64 shape.
  pub let SYS_PDXFS_FAULT_INJECT_EPERM  : u64 = 0xFFFFFFFFFFFFFFF3
  pub let SYS_PDXFS_FAULT_INJECT_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA

  // ==========================================================================
  // sys_pdxfs_fault_inject_body(class) -> 0 | -EPERM | -EINVAL
  //
  // See file header for the full sequence + error taxonomy.
  // ==========================================================================
  pub let sys_pdxfs_fault_inject_body : (u64) -> u64 !{mem, sysreg} @{} =
    fn (class: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): sys_pdxfs_fault_inject body, SC+ ID 527 (pre-reserved out-of-band per mv/rm design docs -- see design/user/syscall-table.md §Reserved out-of-band sysnos).  Entry: rdi=class in [0, 4].  One callee-save push (rbx) leaves rsp%16 == 0 for the nested pdxfs_fault_arm + klog_s1_d1 calls from entry rsp%16 == 8 SysV.  Sequence: (1) call pdxfs_fault_arm(class) -- substrate's own gates handle EPERM (enabled == 0) + EINVAL (class > 4); non-zero return propagates verbatim so a release-mode caller sees -EPERM and an out-of-range caller sees -EINVAL.  (2) klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_fault_inject_armed, k_class, class) on the OK path only.  Tag covers both arm and disarm (class == 0) since the fingerprint carries the class value verbatim.  (3) xor rax, rax return 0.  Effects {mem, sysreg}: mem transitively from pdxfs_fault_arm's .bss stores + klog ring writes; sysreg transitively from klog_s1_d1's TSC read.  Capability {}: neither the arm gate nor the emit path walks cap_table.  Encoder-conservative: cmp/je/jne/mov/lea/xor/push/pop/call/ret only -- every form already proven in sys_pdxfs_undo_write_body / sys_pdxfs_txn_commit_body.  Reserved labels: spfi_.",
      block: {
        push rbx;                            // rsp%16: 8 -> 0

        mov rbx, rdi;                        // save class

        // ---- Step (1): call the substrate arm helper ----
        mov rdi, rbx;
        call pdxfs_fault_arm;                // rax = 0 | -EPERM | -EINVAL
        cmp rax, 0;
        jne spfi_out;                        // propagate substrate's sentinel

        // ---- Step (2): emit fingerprint on OK ----
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_fault_inject_armed];
        lea rcx, [rip + k_class];
        mov r8,  rbx;                        // v1 = class
        call klog_s1_d1;

        // ---- Step (3): return 0 ----
        xor rax, rax;

      spfi_out:
        pop rbx;
        ret
      }
    }
}
