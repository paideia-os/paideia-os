// src/kernel/core/syscall/handlers/sys_bind.pdx — R72.M1-005 (#1927)
//                                                  R100-PREP-002 (#2008)
//                                                  R96.M4-001  (#2092)
//
// sys_bind(fd, local_port) -> 0 | -errno. SC+ ID 88.
// No sockaddr struct at MVP -- the only address this kernel can bind
// to is its one configured interface (net/ipv4.pdx's _ipv4_my_ip), so
// the ABI collapses "bind to this address:port" to just "bind to this
// port"; local_ip is always stamped from _ipv4_my_ip (TCP path) or is
// implicit (UDP path -- no per-socket local_ip storage, single-
// interface tree).
//
// Dispatch by cap kind (resolved via the generic tcp_socket_resolve,
// which takes an explicit want_kind arg):
//   KIND_TCP_SOCKET   (0x1AB) -> inline TCP body (state=CLOSED then
//                                stamp local_port + local_ip in TCB).
//   KIND_UDP_SOCKET   (0x1A8) -> udp_socket_bind_body (state=CLOSED
//                                then stamp local_port; no local_ip
//                                stored -- single-interface tree).
//   any other / not a socket  -> -EBADF.
//
// -----------------------------------------------------------------------------
// R96.M4-001 (paideia-os #2092): privileged-port gate
// -----------------------------------------------------------------------------
//
// A caller trying to bind local_port < 1024 must present a socket cap
// carrying R_NET_PRIVILEGED_PORT (0x010) in addition to R_SOCKET_LISTEN.
// The default sys_socket mint (TCP_SOCKET_RIGHTS / UDP_SOCKET_RIGHTS =
// 0x00F) does NOT grant this bit, so an ordinary socket refuses -EACCES
// on any port < 1024. A privileged-widened socket (future setsockopt
// or sys_socket variant, not wired at R96) carries 0x01F and passes.
//
// The gate fires BEFORE the R95.M4-001 R_SOCKET_LISTEN check because a
// privileged-port denial is the more specific refusal -- reporting
// "bind requires LISTEN" when the actual objection is "bind requires
// the port-privilege bit" would mislead the caller into adjusting the
// wrong right. Same -EACCES sentinel for both refusals matches the
// R95 posture.
//
// Port >= 1024 skips the gate entirely; the R95.M4-001 LISTEN check
// then applies as before. The two gates compose additively: an
// ordinary socket on port 8080 needs LISTEN; a privileged socket on
// port 80 needs LISTEN + PRIVILEGED_PORT.

module SysBind = structure {

  pub let SYS_BIND_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_BIND_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let SYS_BIND_EACCES : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES (-13)

  pub let sys_bind_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, local_port: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008) + R96.M4-001 (#2092): sys_bind, SC+ ID 88. Resolves fd first as a KIND_TCP_SOCKET; on hit, executes the original TCP bind body inline (state==CLOSED gate, stamp local_port + local_ip from _ipv4_my_ip in the TCB). On TCP miss, resolves as a KIND_UDP_SOCKET and tail-calls udp_socket_bind_body (state==CLOSED gate, stamp local_port; no local_ip stored -- single-interface tree). Both miss -> -EBADF. tcp_socket_resolve is the generic cap-slot-to-target-ptr resolver keyed on want_kind (see net/tcp_socket.pdx module header). The dispatch order (TCP first) minimizes regression risk on the R72 path -- every existing TCP caller resolves in exactly one call, identical to the pre-#2008 shape. R96.M4-001 (#2092): before the R95.M4-001 R_SOCKET_LISTEN check on both arms, if r12 (local_port) < 1024 call sock_cap_check_rights(fd, R_NET_PRIVILEGED_PORT = 0x010); a non-zero return (-EACCES) short-circuits to sys_bind_eaccess. The default sys_socket mint grants 0x00F (LISTEN + READ + WRITE + CONNECT) but NOT the port-privilege bit, so an ordinary socket refuses cleanly on any port < 1024. The privileged-port gate fires FIRST (before LISTEN) because that refusal is more specific -- reporting 'bind requires LISTEN' when the objection is actually 'bind requires PRIVILEGED_PORT' would mislead the caller. Same -EACCES sentinel for both refusals. Port >= 1024 skips the privileged gate entirely; the LISTEN check then applies as before. 2-push callee-save (rbx=fd, r12=local_port); entry rsp%16==8, two pushes (16 bytes) land rsp%16==8, sub rsp,8 aligns to 0 for every nested tcp_socket_resolve / udp_socket_bind_body / sock_cap_check_rights call. Reserved labels: sys_bind_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;                      // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_bind_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;                      // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_bind_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF
        jmp sys_bind_done;

      sys_bind_have_tcp:
        // R96.M4-001 (paideia-os #2092): privileged-port gate. If
        // local_port < 1024, the cap must carry R_NET_PRIVILEGED_PORT
        // (0x010). Default mint (0x00F) drops the bit, so an ordinary
        // socket refuses -EACCES on any low port. Port >= 1024 skips
        // this gate. Fires BEFORE the LISTEN check because the port
        // objection is the more specific refusal.
        cmp r12, 1024;
        jae sys_bind_tcp_listen_check;
        push rax;                            // save tcb_idx
        sub rsp, 8;                          // align for call
        mov rdi, rbx;
        mov rsi, 0x010;                      // R_NET_PRIVILEGED_PORT
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;                             // restore tcb_idx
        cmp rdx, 0;
        jne sys_bind_eaccess;

      sys_bind_tcp_listen_check:
        // R95.M4-001 (paideia-os #2083): bind requires R_SOCKET_LISTEN
        // (server-preparatory path). A caller between socket() and
        // connect() with a mint dropping LISTEN can still connect (that
        // path auto-binds ephemerally). Explicit bind() is treated as
        // server-shape and gated on LISTEN. Default mint (0x00F) has all
        // four bits so every pre-R95 witness passes. rsp%16 == 0 at
        // entry; push rax (save idx) -> 8, sub rsp,8 -> 0 for the call.
        push rax;                            // save tcb_idx
        sub rsp, 8;                          // align for call
        mov rdi, rbx;
        mov rsi, 0x004;                      // R_SOCKET_LISTEN
        call sock_cap_check_rights;
        mov rdx, rax;                        // gate result
        add rsp, 8;
        pop rax;                             // restore tcb_idx
        cmp rdx, 0;
        jne sys_bind_eaccess;
        jmp sys_bind_do_tcp;

      sys_bind_have_udp:
        // R96.M4-001 (paideia-os #2092): privileged-port gate, mirror
        // of the TCP arm above. Same semantics for KIND_UDP_SOCKET;
        // sock_cap_check_rights is kind-agnostic so the check code is
        // byte-identical.
        cmp r12, 1024;
        jae sys_bind_udp_listen_check;
        push rax;                            // save sock_idx
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x010;                      // R_NET_PRIVILEGED_PORT
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_bind_eaccess;

      sys_bind_udp_listen_check:
        push rax;                            // save sock_idx
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x004;                      // R_SOCKET_LISTEN
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;                             // restore sock_idx
        cmp rdx, 0;
        jne sys_bind_eaccess;
        jmp sys_bind_do_udp;

      sys_bind_do_tcp:
        // rax = tcb_idx. Original R72 TCP bind body inlined below.
        mov rcx, rax;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;

        mov rdx, [rcx + 0];
        cmp rdx, 0;
        jne sys_bind_einval;

        mov [rcx + 8], r12;

        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [rcx + 24], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [rcx + 25], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [rcx + 26], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [rcx + 27], rax;

        xor rax, rax;
        jmp sys_bind_done;

      sys_bind_do_udp:
        // rax = sock_idx. Tail-call udp_socket_bind_body(sock_idx, local_port).
        mov rdi, rax;
        mov rsi, r12;
        call udp_socket_bind_body;
        jmp sys_bind_done;

      sys_bind_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        jmp sys_bind_done;

      sys_bind_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;         // -EACCES

      sys_bind_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
