// src/kernel/core/syscall/handlers/sys_bind.pdx — R72.M1-005 (#1927)
//
// sys_bind(fd, local_port) -> 0 | -errno. SC+ ID 88.
// No sockaddr struct at MVP -- the only address this kernel can bind
// to is its one configured interface (net/ipv4.pdx's _ipv4_my_ip), so
// the ABI collapses "bind to this address:port" to just "bind to this
// port"; local_ip is always stamped from _ipv4_my_ip.

module SysBind = structure {

  pub let SYS_BIND_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_BIND_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)

  pub let sys_bind_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, local_port: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_bind, SC+ ID 88. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. Requires the TCB be in TCP_ST_CLOSED (@+0 == 0) -- rebinding an already-bound/connected/listening socket is refused with -EINVAL rather than silently repointing a live connection's local_port. Stamps local_port (@+8) and local_ip (@+24..27, copied byte-for-byte from net/ipv4.pdx's _ipv4_my_ip -- the only address this single-interface kernel can ever bind to at this round). 2-push callee-save (rbx=fd, r12=local_port): entry rsp%16==8, two pushes (16 bytes) land rsp%16==8, so an 8-byte pad is added before the nested tcp_socket_resolve call. Reserved labels: sys_bind_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        mov rsi, 0x1A5;                      // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_bind_ebadf;

        mov rcx, rax;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;

        mov rdx, [rcx + 0];
        cmp rdx, 0;
        jne sys_bind_einval;

        mov [rcx + 8], r12;

        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [rcx + 24], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [rcx + 25], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [rcx + 26], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [rcx + 27], rax;

        xor rax, rax;
        jmp sys_bind_done;

      sys_bind_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_bind_done;

      sys_bind_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      sys_bind_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
