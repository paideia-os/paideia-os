// src/kernel/core/syscall/handlers/sys_bind.pdx — R72.M1-005 (#1927)
//                                                  R100-PREP-002 (#2008)
//
// sys_bind(fd, local_port) -> 0 | -errno. SC+ ID 88.
// No sockaddr struct at MVP -- the only address this kernel can bind
// to is its one configured interface (net/ipv4.pdx's _ipv4_my_ip), so
// the ABI collapses "bind to this address:port" to just "bind to this
// port"; local_ip is always stamped from _ipv4_my_ip (TCP path) or is
// implicit (UDP path -- no per-socket local_ip storage, single-
// interface tree).
//
// Dispatch by cap kind (resolved via the generic tcp_socket_resolve,
// which takes an explicit want_kind arg):
//   KIND_TCP_SOCKET   (0x1AB) -> inline TCP body (state=CLOSED then
//                                stamp local_port + local_ip in TCB).
//   KIND_UDP_SOCKET   (0x1A8) -> udp_socket_bind_body (state=CLOSED
//                                then stamp local_port; no local_ip
//                                stored -- single-interface tree).
//   any other / not a socket  -> -EBADF.

module SysBind = structure {

  pub let SYS_BIND_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_BIND_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let SYS_BIND_EACCES : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES (-13)

  pub let sys_bind_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, local_port: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008): sys_bind, SC+ ID 88. Resolves fd first as a KIND_TCP_SOCKET; on hit, executes the original TCP bind body inline (state==CLOSED gate, stamp local_port + local_ip from _ipv4_my_ip in the TCB). On TCP miss, resolves as a KIND_UDP_SOCKET and tail-calls udp_socket_bind_body (state==CLOSED gate, stamp local_port; no local_ip stored -- single-interface tree). Both miss -> -EBADF. tcp_socket_resolve is the generic cap-slot-to-target-ptr resolver keyed on want_kind (see net/tcp_socket.pdx module header). The dispatch order (TCP first) minimizes regression risk on the R72 path -- every existing TCP caller resolves in exactly one call, identical to the pre-#2008 shape. 2-push callee-save (rbx=fd, r12=local_port); entry rsp%16==8, two pushes (16 bytes) land rsp%16==8, sub rsp,8 aligns to 0 for every nested tcp_socket_resolve / udp_socket_bind_body call. Reserved labels: sys_bind_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;                      // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_bind_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;                      // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_bind_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF
        jmp sys_bind_done;

      sys_bind_have_tcp:
        // R95.M4-001 (paideia-os #2083): bind requires R_SOCKET_LISTEN
        // (server-preparatory path). A caller between socket() and
        // connect() with a mint dropping LISTEN can still connect (that
        // path auto-binds ephemerally). Explicit bind() is treated as
        // server-shape and gated on LISTEN. Default mint (0x00F) has all
        // four bits so every pre-R95 witness passes. rsp%16 == 0 at
        // entry; push rax (save idx) -> 8, sub rsp,8 -> 0 for the call.
        push rax;                            // save tcb_idx
        sub rsp, 8;                          // align for call
        mov rdi, rbx;
        mov rsi, 0x004;                      // R_SOCKET_LISTEN
        call sock_cap_check_rights;
        mov rdx, rax;                        // gate result
        add rsp, 8;
        pop rax;                             // restore tcb_idx
        cmp rdx, 0;
        jne sys_bind_eaccess;
        jmp sys_bind_do_tcp;

      sys_bind_have_udp:
        push rax;                            // save sock_idx
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x004;                      // R_SOCKET_LISTEN
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;                             // restore sock_idx
        cmp rdx, 0;
        jne sys_bind_eaccess;
        jmp sys_bind_do_udp;

      sys_bind_do_tcp:
        // rax = tcb_idx. Original R72 TCP bind body inlined below.
        mov rcx, rax;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;

        mov rdx, [rcx + 0];
        cmp rdx, 0;
        jne sys_bind_einval;

        mov [rcx + 8], r12;

        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [rcx + 24], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [rcx + 25], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [rcx + 26], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [rcx + 27], rax;

        xor rax, rax;
        jmp sys_bind_done;

      sys_bind_do_udp:
        // rax = sock_idx. Tail-call udp_socket_bind_body(sock_idx, local_port).
        mov rdi, rax;
        mov rsi, r12;
        call udp_socket_bind_body;
        jmp sys_bind_done;

      sys_bind_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        jmp sys_bind_done;

      sys_bind_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;         // -EACCES

      sys_bind_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
