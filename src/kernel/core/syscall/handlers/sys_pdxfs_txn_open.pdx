// src/kernel/core/syscall/handlers/sys_pdxfs_txn_open.pdx
// R42-PREP-007 (#1629): sys_pdxfs_txn_open body.
//
// The ring-3-facing constructor for KIND_PDXFS_TXN.  Combines two
// steps that used to be split across the KIND_PDXFS_TXN mint walker
// and a hypothetical userspace helper: (1) allocate a transaction
// row via pdxfs_txn_cap_mint_inner; (2) publish it into a fresh
// cap_table slot via cap_mint_write.  The result the ring-3 caller
// sees is a KIND_PDXFS_TXN cap slot ready to feed into cap_invoke
// with the write-side ops (COMMIT / ABORT / CREATE / RENAME /
// UNLINK) landed alongside this file.
//
// Contract (SysV, 4 args):
//   rdi = parent_slot      -- KIND_MEMORY cap the mount owns
//   rsi = mode             -- PXT_MODE_CREATE / MODIFY / DELETE
//                             (1 / 2 / 3; validated by mint helper)
//   rdx = txn_id           -- FS-assigned id (must be non-zero)
//   rcx = wal_off          -- WAL byte offset where the first record
//                             of this txn lands (may be 0 at
//                             substrate-prep -- the walker will
//                             backfill when the mutating journal is
//                             wired)
//   -> rax = cap_slot in [0, 256) on success; a negative-errno u64
//           on failure (see errno table below).
//
// snap_gen is not exposed on this syscall; it defaults to 0 until
// the CoW snapshot substrate (design/tooling/r49-r50-plan.md §5)
// grows a syscall to sample it.  A future arg-widening (sys_pdxfs_
// txn_open_v2) will surface it once the tools that need it (pkg
// install for signed snapshot boundaries, cp -R for copy-on-write
// clone points) land -- the walker mint helper already accepts the
// slot, so widening does not touch the substrate.
//
// Error taxonomy (mint sentinels propagate verbatim; new syscall-
// side codes for the cap-table free-slot scan):
//   PXT_MINT_BAD_PARENT (0xFFFFEC1D)  -- parent_slot not KIND_MEMORY
//                                        or missing RIGHT_MINT
//   PXT_MINT_BAD_RIGHTS (0xFFFFEC1C)  -- (unused here -- we hard-code
//                                        rights, but propagated if a
//                                        future arg extension surfaces
//                                        the field)
//   PXT_MINT_BAD_ID     (0xFFFFEC1B)  -- txn_id == 0
//   PXT_MINT_BAD_MODE   (0xFFFFEC1A)  -- mode not in [1..3]
//   PXT_MINT_BAD_STATE  (0xFFFFEC19)  -- header pack refused (defensive)
//   PXT_TAIL_ENOSPC     (0xFFFFEC1F)  -- transaction table full (16 rows)
//   PXT_TAIL_BAD_ARG    (0xFFFFEC1E)  -- header pack rejected input
//   -ENFILE             (0xFFFFFFFFFFFFFFDF = -33) -- cap_table full
//
// Rights hard-coded to R_PDXFS_TXN_INVOKE (0x008): this is the
// minimum every write-side op needs (COMMIT / ABORT / CREATE /
// RENAME / UNLINK all gate on 0x008 in cap_handler_pdxfs_txn).
// A future widening (sys_pdxfs_txn_open_v2) can accept a rights
// arg for callers that want OBSERVE (debug trace) or REVOKE
// (supervisor teardown) added on -- the substrate's rights_valid
// gate already accepts any subset of R_PDXFS_TXN_ALL = 0x618.
//
// [unsafe] -- transitively writes cap_table via cap_mint_write and
// _pdxfs_txn_table via pdxfs_txn_cap_mint_inner.
// Audit: design/tooling/r49-r50-plan.md §5.

module SysPdxfsTxnOpen = structure {

  // -EBADF-shaped sentinel: no free cap slot in the 256-slot table.
  // Linux errno -ENFILE == -33.  Uses the same "sign-testable via
  // `cmp rax, 0; jl`" convention as every other syscall body in this
  // directory (matches sys_svc_lookup's -ENOSPC).
  pub let SYS_PDXFS_TXN_OPEN_ENFILE : u64 = 0xFFFFFFFFFFFFFFDF

  // ==========================================================================
  // sys_pdxfs_txn_open_body(parent_slot, mode, txn_id, wal_off) -> cap_slot | errno
  //
  // Sequence:
  //   (1) pdxfs_txn_cap_mint_inner(parent, R_PDXFS_TXN_INVOKE, txn_id,
  //                                mode, wal_off, snap_gen=0)
  //       -> row_id in [0, 16) on success, sentinel >= 0xFFFFEC10 on
  //          failure.  Propagate sentinel verbatim to the caller.
  //   (2) Scan cap_table for a free slot (kind == KIND_NULL == 0).
  //       Free-scan pattern mirrors sys_svc_lookup_body §Step (h)
  //       (cap/verify.pdx L67-71 + cap/mint.pdx L104-108) -- slot*24
  //       via shift-add so no imul.  If no free slot within 256,
  //       return SYS_PDXFS_TXN_OPEN_ENFILE and leak the allocated
  //       row (R50 lands a `pdxfs_txn_cap_revoke_from_open_failure`
  //       cleanup helper).
  //   (3) cap_mint_write(slot, KIND_PDXFS_TXN=0x196, R_PDXFS_TXN_INVOKE
  //                      =0x008, row_id).  target_ptr = row_id in low
  //                      16 bits, per cap_handler_pdxfs_txn's
  //                      "and r13, 0xFFFF" extract of row_id from
  //                      target_ptr.
  //   (4) pdxfs_txn_note(PXT_ST_OPENS=9) -- boot-time visibility of
  //       how many transactions ring-3 opened this session.
  //   (5) Return cap_slot.
  //
  // Register plan (4-arg SysV entry; three nested cross-file calls):
  //   rdi/rsi/rdx/rcx = args (consumed inline; shuffled into mint's
  //                     6-arg SysV positions with r8=wal_off, r9=snap=0)
  //   rbx = row_id (survives cap_mint_write's caller-save clobber)
  //   r12 = free slot idx (survives cap_mint_write + pdxfs_txn_note)
  //   r13 = parent_slot (saved for the mint-inner call)
  //   r14 = mode (saved for the mint-inner call)
  //   r15 = txn_id (saved for the mint-inner call)
  //   rbp = wal_off (saved for the mint-inner call)
  //
  // Alignment: entry rsp %16 == 8 (SysV).  Six-push callee-save
  // prologue (rbx, r12, r13, r14, r15, rbp) = 48 bytes -> rsp %16 == 8.
  // sub rsp, 8 pad brings rsp %16 == 0 for nested calls; add rsp, 8
  // + six pops restores at epilogue.
  // ==========================================================================
  pub let sys_pdxfs_txn_open_body : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (mode: u64) (txn_id: u64) (wal_off: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R42-PREP-007 (#1629): ring-3 KIND_PDXFS_TXN constructor. Compose pdxfs_txn_cap_mint_inner + cap_mint_write into a single syscall body so the R49 tooling wave (pkg / cp / mv / rm / mkdir) has one entry point to open a transaction, matching sys_svc_lookup_body's cap-minting shape (broker row lookup + free-slot scan + cap_mint_write) at R20b.M3-003. Rights hard-coded to R_PDXFS_TXN_INVOKE (0x008) -- the minimum every write-side op needs; future widening (sys_pdxfs_txn_open_v2) surfaces the rights field for callers that want OBSERVE (debug trace) or REVOKE (supervisor teardown) added on. snap_gen hard-coded to 0 -- the CoW snapshot substrate has not landed a syscall to sample it at substrate-prep; the walker mint helper already accepts the slot so widening does not touch the substrate. Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) preserve row_id + free_slot + all four args across the three nested cross-file calls (pdxfs_txn_cap_mint_inner, cap_mint_write, pdxfs_txn_note). Free-slot scan mirrors sys_svc_lookup_body's Step (h) -- cap_table + slot*24 via shift-add (no imul), matching cap/verify.pdx L67-71 + cap/mint.pdx L104-108. KIND constant 0x196 fits in imm32 signed so no r11-staging is needed for the cap_mint_write kind arg (0x196 = 406 << 0x7FFFFFFF). Mint-error sentinels >= 0xFFFFEC10 propagate verbatim; the free-slot exhaustion returns SYS_PDXFS_TXN_OPEN_ENFILE (-33) so a caller checking `jl` for any negative errno branches uniformly. PXT_ST_OPENS (slot 9) bumps only on the success return path -- an operator counting how many transactions ring-3 opened this session sees the successful count, not the attempts. Effects {mem} for the transitive stats + table + cap_table writes; capabilities {cap} matches cap_mint_write's own posture (design/capabilities/*.md) and sys_svc_lookup_body's shape at the parallel cap-minting seam. No user pointers -- all four args are raw u64s via SysV registers -- so no user_ptr_ok gate and no KPTI bounce. Labels prefixed spto_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov r13, rdi;                    // parent_slot
        mov r14, rsi;                    // mode
        mov r15, rdx;                    // txn_id
        mov rbp, rcx;                    // wal_off

        // ---- Step (1): mint the transaction row. ----
        // pdxfs_txn_cap_mint_inner(parent, rights, txn_id, mode, wal_off, snap_gen)
        mov rdi, r13;                    // parent_slot
        mov rsi, 0x008;                  // R_PDXFS_TXN_INVOKE
        mov rdx, r15;                    // txn_id
        mov rcx, r14;                    // mode
        mov r8,  rbp;                    // wal_off
        xor r9,  r9;                     // snap_gen = 0 (substrate-prep default)
        call pdxfs_txn_cap_mint_inner;

        // Mint returns row_id in [0, 16) on success; any sentinel is
        // in the 0xFFFFEC1* band which is >= 16 unsigned.  Propagate
        // the sentinel verbatim so the ring-3 caller sees the same
        // failure taxonomy the mint walker documents in its header.
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae spto_out;                    // mint error -- rax already set

        mov rbx, rax;                    // rbx = row_id (survives cap_mint_write)

        // ---- Step (2): scan cap_table for a free slot. ----
        // slot_pa(i) = cap_table + i*24 = cap_table + i*8 + i*16.
        xor r12, r12;                    // r12 = slot idx
      spto_scan:
        mov r10, 256;                    // CAP_SLAB_CAPACITY
        cmp r12, r10;
        jae spto_no_slot;
        mov r10, r12;
        shl r10, 3;                      // slot * 8
        mov r11, r12;
        shl r11, 4;                      // slot * 16
        add r10, r11;                    // slot * 24
        lea rax, [rip + cap_table];
        add rax, r10;                    // &cap_table[slot]
        mov rcx, [rax + 0];              // kind (u64)
        cmp rcx, 0;                      // KIND_NULL
        je  spto_slot_found;
        add r12, 1;
        jmp spto_scan;

      spto_slot_found:
        // ---- Step (3): cap_mint_write(slot, KIND_PDXFS_TXN, rights, row_id) ----
        // ABI (cap/mint.pdx): rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        mov rdi, r12;                    // slot
        mov rsi, 0x196;                  // KIND_PDXFS_TXN
        mov rdx, 0x008;                  // R_PDXFS_TXN_INVOKE
        mov rcx, rbx;                    // target_ptr = row_id
        call cap_mint_write;             // void return

        // ---- Step (4): bump PXT_ST_OPENS. ----
        mov rdi, 9;                      // PXT_ST_OPENS
        call pdxfs_txn_note;

        // ---- Step (5): return the cap slot. ----
        mov rax, r12;
        jmp spto_out;

      spto_no_slot:
        mov rax, 0xFFFFFFFFFFFFFFDF;     // -ENFILE

      spto_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
