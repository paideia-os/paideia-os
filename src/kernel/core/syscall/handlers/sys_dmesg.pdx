// src/kernel/core/syscall/handlers/sys_dmesg.pdx — logging-m9-002 (#709)
// sys_dmesg(buf, len) — kernel-to-userspace copy of the klog ring tail.
//
// Per design/kernel/kernel-logging-substrate.md §12.10:
//   "sys_dmesg(buf, len) syscall — kernel-to-userspace copy of ring tail."
//
// Contract (SysV inside kernel; dispatch.pdx wraps the KPTI bounce buffer):
//   rdi = kernel_dst_ptr  (kernel scratch buffer — dispatch layer's
//                           _dispatch_dmesg_buf_scratch, already user-ptr-
//                           validated + capped at DISPATCH_IO_MAX)
//   rsi = len             (capped byte count)
//   ->  rax = bytes copied in [0, len]  (short-copy legal, POSIX-style).
//
// The handler is a thin wrapper around klog_ring_read_tail (defined in
// src/kernel/core/klog/ring.pdx). The dispatch layer owns the user↔kernel
// boundary (user_ptr_ok gate + user_write_bytes_via_walk on the return
// path); this body assumes both operands are already kernel-safe.
//
// Access control note (design §12.10 vs current landing):
//   The design mentions "RIGHT_READ on a system-level dmesg cap held by
//   the caller's TCB." R18 has no per-TCB cap-holder machinery yet
//   (deferred to R19+ userspace-daemon substrate), so at this landing
//   sys_dmesg is unrestricted. The KIND_DMESG cap (logging-m9-001 / #708)
//   is minted at boot and available for future gating when the TCB
//   cap-slot table lands. See §12.10 "future observability" note.
//
// [unsafe] — reads ring buffer, writes kernel scratch.
// Audit: design/kernel/kernel-logging-substrate.md §12.10.

module SysDmesg = structure {
  // ==========================================================================
  // sys_dmesg_body — copy up to len ring bytes into caller kernel buffer.
  //
  // Register discipline: leaf-simple tail-call to klog_ring_read_tail.
  //   rdi (kernel_dst_ptr) and rsi (len) are already positioned by SysV;
  //   klog_ring_read_tail takes exactly those.
  //   No callee-save regs used; no frame needed.
  // ==========================================================================
  pub let sys_dmesg_body : (u64, u64) -> u64 !{mem} @{} =
    fn (kernel_dst_ptr: u64) (len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "logging-m9-002 (#709): sys_dmesg body. Leaf wrapper — rdi/rsi already SysV-positioned for klog_ring_read_tail. Body itself does not touch user memory: the dispatch layer's KPTI bounce + walk (dispatch_dmesg case) owns the user↔kernel boundary, symmetric to #738's sys_read pattern (per-syscall scratch buffer + user_ptr_ok gate + user_write_bytes_via_walk writeback). klog_ring_read_tail returns bytes copied in rax — passthrough.",
      block: {
        call klog_ring_read_tail;
        ret;
      }
    }
}
