// src/kernel/core/syscall/handlers/sys_pdxfs_open.pdx -- R42-PREP-008 (#1630)
//
// sys_pdxfs_open body -- mint a KIND_PDXFS_FILE cap (used as a
// directory at this interim landing per pdxfs-kinds.md §3.1) into a
// free cap_table slot and reset its iteration cursor.  Syscall #71.
//
// Contract (SysV, 2 args):
//   rdi = parent_slot      KIND_MEMORY cap w/ RIGHT_MINT (the mount
//                          root the caller is authorised through --
//                          per the KIND_PDXFS_FILE derivation gate at
//                          kind_pdxfs_file.pdx §pdxfs_file_check_parent_memory)
//   rsi = mode_flags       low-16 mode bits (POSIX rwx + PdxFS
//                          file-type nibble at bits [15:12]).  Bits 16+
//                          REFUSED with -EINVAL.  Callers open a
//                          directory by setting nibble bit 0x2000 --
//                          see SYS_PDXFS_DIR_MODE_NIBBLE_DIR in
//                          sys_pdxfs_dir_readnext.pdx.
//   -> rax = cap_slot in [0, 256) on success; a negative-errno u64
//           on failure (see below).
//
// Error taxonomy (identical shape to sys_pdxfs_txn_open at R42-PREP-007
// so the two constructors branch uniformly on `jl`):
//   PFF_MINT_BAD_PARENT (0xFFFFEC2D)  -- parent_slot not KIND_MEMORY
//                                        or missing RIGHT_MINT
//   PFF_MINT_BAD_RIGHTS (0xFFFFEC2C)  -- unreachable here (we hard-code
//                                        rights to R_PDXFS_FILE_ALL for
//                                        the mint gate); propagates
//                                        verbatim if a future
//                                        arg-widening surfaces rights
//   PFF_MINT_BAD_INODE  (0xFFFFEC2B)  -- unreachable (stub inode is
//                                        constant non-zero)
//   PFF_MINT_BAD_LEN    (0xFFFFEC2A)  -- unreachable (stub len is 0)
//   PFF_TAIL_ENOSPC     (0xFFFFEC2F)  -- _pdxfs_file_table full (16 rows)
//   PFF_TAIL_BAD_ARG    (0xFFFFEC2E)  -- header pack rejected input
//                                        (fires if mode_flags has bits
//                                        [55:16] set -- surfaces as
//                                        -EINVAL after the bit-16 gate
//                                        below, so unreachable in
//                                        practice)
//   SYS_PDXFS_OPEN_EINVAL (-22)       -- mode_flags > 0xFFFF
//   SYS_PDXFS_OPEN_ENFILE (-23)       -- cap_table full (no free slot)
//
// STUB IDENTITY
//
// The minted row's identity fields (inode, len, birth, mtime) are
// fixed constants -- the FS layer does not yet allocate real inodes,
// and the caller has no way to name a specific path.  The stub set
// pdxfs_dir_readnext emits is the same regardless of the row.  This
// mirrors the STUB posture pdxfs_dir_iter.pdx §3 documents.
//
//   inode  = 0x1000   (nonsense value that will never collide with a
//                     real PdxFS inode; large enough that a bit-flip
//                     to zero surfaces cleanly at the tail_alloc
//                     inode==0 gate)
//   len    = 0
//   birth  = 0
//   mtime  = 0
//   mode   = mode_flags (low 16 bits validated by pdxfs_file_hdr_pack)
//
// PATH ARGUMENT DEFERRED
//
// The issue text ("takes path Cap + open-mode flags") uses "path Cap"
// synonymously with "the KIND_MEMORY cap the caller holds over the
// mount whose entries they want to enumerate".  For the STUB, that IS
// the parent_slot arg -- no path resolution happens because there is
// no path walker yet.  When the R42.M5+ path walker lands, this ABI
// grows a path_va + path_len pair plumbed through
// user_read_bytes_via_walk into a per-body scratch, and the parent
// slot becomes the mount root rather than the direct parent.  That
// change is a widening (new arg, same success semantics), not a
// re-shape -- the syscall number 71 stays put.
//
// RIGHTS
//
// The minted descriptor carries R_PDXFS_FILE_READ | R_PDXFS_FILE_INVOKE
// (0x009).  Read for the eventual byte-read path once it lands; Invoke
// for the query ops that ls -l uses (mode/mtime/refs).  MINT and
// REVOKE are DELIBERATELY OMITTED -- ls has no business deriving a
// child cap and the caller's own revoke path (once it lands) will use
// a supervisor-scoped MINT-carrying cap, not this one.

module SysPdxfsOpen = structure {

  // -EINVAL: mode bits above 0xFFFF.  Distinct from EBADF (parent gate)
  // and ENFILE (cap_table full) so a shell can surface a specific
  // error to the user.
  pub let SYS_PDXFS_OPEN_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA

  // -ENFILE: no free cap_table slot in 256.  Matches sys_pdxfs_txn_open's
  // errno-taxonomy at R42-PREP-007 (0xFFFFFFFFFFFFFFDF).
  pub let SYS_PDXFS_OPEN_ENFILE : u64 = 0xFFFFFFFFFFFFFFDF

  // Stub identity fields the STUB mint uses.  Values pinned so the
  // witness can round-trip them; a follow-up round replaces the stub
  // with a real path resolver and these become the "unresolved-path"
  // sentinel.
  pub let SYS_PDXFS_OPEN_STUB_INODE : u64 = 0x1000

  // ==========================================================================
  // sys_pdxfs_open_body(parent_slot, mode_flags) -> cap_slot | errno
  //
  // See §Contract above for the full ABI.
  //
  // Sequence:
  //   (1) mode_flags <= 0xFFFF else SYS_PDXFS_OPEN_EINVAL.  Gates BEFORE
  //       any table touch so a caller passing garbage sees -EINVAL
  //       instead of an opaque mint-side sentinel.
  //   (2) pdxfs_file_cap_mint_inner(parent_slot, R_PDXFS_FILE_ALL=0x61B,
  //                                 inode=0x1000, len=0, birth=0, mtime=0)
  //       -> row_id in [0..PFF_MAX) on success; PFF_MINT_* sentinel on
  //       failure.  Propagate the sentinel verbatim so callers see the
  //       same taxonomy the mint walker documents.  Rights = ALL because
  //       the mint walker's rights_valid gate needs a subset match on
  //       the walker's rights arg -- the DESCRIPTOR's rights are
  //       stamped separately at cap_mint_write and never widen.
  //   (3) Scan cap_table for a free slot (kind == KIND_NULL == 0).
  //       Mirrors sys_pdxfs_txn_open §Step (2) -- slot*24 via shift-add.
  //       No free slot -> SYS_PDXFS_OPEN_ENFILE (row leaks; the follow-
  //       up cleanup helper lives with the pdxfs_file_cap_revoke_on_
  //       open_failure work that mirrors R50's txn cleanup pattern).
  //   (4) cap_mint_write(slot, KIND_PDXFS_FILE=0x195, R_PDXFS_FILE_READ|
  //                      R_PDXFS_FILE_INVOKE=0x009, row_id).
  //   (5) pdxfs_dir_cursor_reset(row_id) -- clear the iteration cursor
  //       so a subsequent sys_pdxfs_dir_readnext starts at entry 0
  //       regardless of prior state on this row_id.
  //   (6) Return cap_slot.
  //
  // Register plan (mirrors sys_pdxfs_txn_open's 6-push callee-save
  // prologue for consistency, though we only strictly need 4 regs;
  // extra pushes are harmless and keep the two files' shape symmetric
  // for a future refactor that shares an open-body helper):
  //   rbx = row_id            (survives cap_mint_write's caller-save clobber)
  //   r12 = free slot idx     (survives cap_mint_write + pdxfs_dir_cursor_reset)
  //   r13 = parent_slot       (saved for the mint-inner call)
  //   r14 = mode_flags        (saved for the mint-inner call)
  //   r15 = (unused)          (reserved for a future path arg)
  //   rbp = (unused)          (reserved for a future path arg)
  //
  // Alignment: entry rsp %16 == 8 (SysV).  6-push prologue = 48 bytes
  // -> rsp %16 == 8.  sub rsp, 8 pad brings rsp %16 == 0 for nested
  // calls; add rsp, 8 + 6 pops restores at epilogue.
  // ==========================================================================

  pub let sys_pdxfs_open_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64, mode_flags: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R42-PREP-008 (#1630): ring-3 KIND_PDXFS_FILE constructor. Compose pdxfs_file_cap_mint_inner + cap_mint_write + pdxfs_dir_cursor_reset into one syscall body so ls (and the other R49 tools that consume the directory iterator) has a single entry point to open a directory. Mirrors sys_pdxfs_txn_open's shape at R42-PREP-007 -- mint + free-slot scan + cap_mint_write -- so the two constructors branch uniformly on `cmp rax, 256; jae err`. Rights arg to the mint gate is R_PDXFS_FILE_ALL (0x61B) so the rights_valid subset gate passes; the descriptor's carried rights are stamped by cap_mint_write to R_PDXFS_FILE_READ | R_PDXFS_FILE_INVOKE (0x009) per §RIGHTS -- the narrower set every read-only tool needs. Stub identity (inode=0x1000, len=0, birth=0, mtime=0) matches the pdxfs_dir_iter §3 stub set: since the readnext primitive emits fixed entries, the row's identity fields have no per-open meaning yet -- they will when the R42.M5+ path resolver lands. mode_flags gate at 0xFFFF fits the tightest slot the mint walker's hdr_pack accepts and gives -EINVAL a distinct sentinel from -EBADF (bad parent) and -ENFILE (cap_table full). PFF_MINT_BAD_LEN cannot fire (len=0) and PFF_MINT_BAD_INODE cannot fire (inode=0x1000 non-zero) so the mint-side error path is dominated by PFF_MINT_BAD_PARENT (a real caller-side authority error) and PFF_TAIL_ENOSPC (table exhaustion). PFF_TAIL_ENOSPC and other 0xFFFFEC2* sentinels propagate verbatim so callers see the same taxonomy kind_pdxfs_file.pdx documents. Effects {mem} for stats + table + cap_table + cursor writes; capabilities {cap} matches cap_mint_write's own posture and sys_pdxfs_txn_open's shape. No user pointers -- both args are raw u64s -- so no user_ptr_ok gate and no KPTI bounce. Six callee-save pushes leave rsp%16 == 0 at every nested call after the sub rsp, 8 pad (6*8 + 8 = 56; 8 + 56 = 64; 64 % 16 = 0). Labels prefixed spo_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                          // align rsp%16 == 0 for nested calls

        mov r13, rdi;                        // parent_slot
        mov r14, rsi;                        // mode_flags

        // (1) mode_flags <= 0xFFFF (staged via r10 to keep the imm within cmp/imm bounds).
        mov r10, 0xFFFF;
        cmp r14, r10;
        ja  spo_einval;

        // (2) pdxfs_file_cap_mint_inner(parent, rights, inode, len, birth, mtime).
        //     Rights = ALL for the mint gate; descriptor rights stamped later.
        mov rdi, r13;                        // parent_slot
        mov rsi, 0x61B;                      // R_PDXFS_FILE_ALL
        mov rdx, 0x1000;                     // stub inode
        xor rcx, rcx;                        // len = 0
        xor r8,  r8;                         // birth = 0
        xor r9,  r9;                         // mtime = 0
        call pdxfs_file_cap_mint_inner;

        // Mint returns row_id in [0, 16) on success; any sentinel is
        // in the 0xFFFFEC2* band which is >= 16 unsigned.  Propagate.
        mov r10, 16;                         // PFF_MAX
        cmp rax, r10;
        jae spo_out;                         // mint error -- rax already set

        mov rbx, rax;                        // rbx = row_id

        // (3) Scan cap_table for a free slot (kind == KIND_NULL == 0).
        //     slot_pa(i) = cap_table + i*24 = cap_table + i*8 + i*16.
        //     Mirrors sys_pdxfs_txn_open §Step (2).
        xor r12, r12;                        // slot idx
      spo_scan:
        mov r10, 256;                        // CAP_SLAB_CAPACITY
        cmp r12, r10;
        jae spo_no_slot;
        mov r10, r12;
        shl r10, 3;                          // slot * 8
        mov r11, r12;
        shl r11, 4;                          // slot * 16
        add r10, r11;                        // slot * 24
        lea rax, [rip + cap_table];
        add rax, r10;                        // &cap_table[slot]
        mov rcx, [rax + 0];                  // kind (u64)
        cmp rcx, 0;                          // KIND_NULL
        je  spo_slot_found;
        add r12, 1;
        jmp spo_scan;

      spo_slot_found:
        // (4) cap_mint_write(slot, KIND_PDXFS_FILE, rights, row_id).
        //     ABI (cap/mint.pdx): rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        mov rdi, r12;                        // slot
        mov rsi, 0x195;                      // KIND_PDXFS_FILE
        mov rdx, 0x009;                      // R_PDXFS_FILE_READ | R_PDXFS_FILE_INVOKE
        mov rcx, rbx;                        // target_ptr = row_id
        call cap_mint_write;                 // void return

        // (5) Reset the iteration cursor for this row.  Return value
        //     ignored: rbx came from a successful mint so row_id is in
        //     range and the reset always succeeds.
        mov rdi, rbx;
        call pdxfs_dir_cursor_reset;

        // (6) Return cap slot.
        mov rax, r12;
        jmp spo_out;

      spo_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;         // -EINVAL
        jmp spo_out;

      spo_no_slot:
        mov rax, 0xFFFFFFFFFFFFFFDF;         // -ENFILE

      spo_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
