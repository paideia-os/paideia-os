// src/kernel/core/syscall/handlers/sys_ipc_recv.pdx — R20b.M3-001 (#1558)
// sys_ipc_recv body — blocking receive on an IPC endpoint (sysno 40).
//
// Design context
// --------------
// First sub-issue of the R20b.M3 (server-process model) branch; opens M3
// on top of the M2 primitives that landed in R20b.M2-002 (pending-msg
// helpers) and R20b.M2-003 (KPTI-safe user<->kernel payload bounce).
//
// Per design/ipc/userspace-server-substrate.md §4.3 recv steps 1..6 and
// §5.1 (sysno 40) + §5.2 (blocking-receive scheduler hook):
//
//   1. Cap-lookup + rights-gate (R_IPC_READ | R_IPC_INVOKE) on the caller's
//      endpoint cap slot.
//   2. If endpoint has no pending message: set endpoint.waiter_tcb = current,
//      record wait_endpoint_id on current TCB, sched_block(); on resume retry.
//   3. Otherwise: bounce hdr + payload out to the caller's user VAs via
//      user_bounce_recv (which internally does endpoint_take_pending +
//      user_write_bytes_via_walk); return payload_len.
//
// Layer split
// -----------
// This body implements steps (2)..(6) — the endpoint-level drain-or-block
// logic. Step (1) — cap-lookup + rights-gate — lives in the dispatch shim
// (syscall/dispatch.pdx §dispatch_ipc_recv) so the body stays testable in
// isolation from a boot witness that pre-mints the endpoint kernel-side
// and passes a raw endpoint_id. This mirrors the layering the R16.M3
// KPTI sweep pinned for sys_read / sys_write: dispatch owns the trust
// boundary (user_ptr_ok + cap gate), the body owns the substrate logic
// (fd_get / vfs_read / offset advance | endpoint drain / block / retry).
//
// At R20b.M3-001 the dispatch-side cap-lookup is a SCAFFOLD (see the M3-001
// witness constraint in the sub-issue task: userspace has not yet been
// seeded any endpoint caps — R20b.M4 lands loader_seed_caps). The shim
// currently treats its first arg as a raw endpoint_id; the cap-check gate
// is exercised by a separate syscall-shim smoke once M4 makes real caps
// reachable from ring-3.
//
// Argument shape (SysV)
// ---------------------
//   rdi = endpoint_id      (u64, valid iff < 128 == ENDPOINT_TABLE_SLOTS)
//   rsi = user_hdr_va      (u64 — caller's 8-byte hdr sink)
//   rdx = user_payload_va  (u64 — caller's payload sink)
//   rcx = user_payload_max (u64 — cap on payload bytes copied out)
//   -> rax:
//        [0, 4088]                    == payload_len (bytes available; user's
//                                        copy may have been short if
//                                        user_payload_max < payload_len)
//        0xFFFFFFFFFFFFFFF2 (-EFAULT) == walker rejected a user VA OR endpoint
//                                        id resolved to a freed row mid-flight
//        0xFFFFFFFFFFFFFFF7 (-EBADF)  == endpoint_id out of range / not live
//                                        at initial lookup
//
// The empty-endpoint path takes exactly one sched_block round-trip per
// wake; sub-issues M3-002 (sys_ipc_send) provide the wake source
// (endpoint.waiter_tcb -> sched_wake). At R20b.M3-001 no producer exists,
// so the empty path is present but not driven by the boot witness (the
// witness pre-loads a pending message via endpoint_write_pending so the
// drain path fires on the first try). Documented in the M3-001 sub-issue's
// acceptance criteria as testable by a future send-wakeup fixture.
//
// State discipline
// ----------------
// sched_block (src/kernel/core/sched/wake_block.pdx §sched_block) is the
// wait primitive. It hard-asserts state == STATE_RUNNABLE at entry and
// writes STATE_WAITING (2) at step 2 (see #663 guard). Overwriting the
// state to TASK_STATE_WAITING_IPC (=4, defined in state.pdx) would either
// require bypassing sched_block or extending it to accept a state
// parameter — both out of scope here. During block the state is
// STATE_WAITING (2); the wait_endpoint_id field (TCB +120) plus the
// endpoint's waiter_tcb slot (endpoint row +32) carry the "which IPC
// operation is this task blocked on" metadata. sys_ipc_send finds its
// wake target via endpoint.waiter_tcb — no state discrimination
// required at that layer. See state.pdx §New at R20b.M3-001 for the
// full rationale.
//
// Wait-slot invariants
// --------------------
// Before sched_block:
//   (a) endpoint.waiter_tcb = _current_tcb (endpoint row +32, u64)
//   (b) _current_tcb.wait_endpoint_id = id (TCB +120, u16)
//
// After sched_block returns (on wake):
//   (c) sys_ipc_send has already stashed the message via
//       endpoint_write_pending BEFORE calling sched_wake, so a retry via
//       user_bounce_recv finds a pending msg and drains successfully.
//   (d) BOTH wait slots are cleared here (belt + suspenders — a future
//       sys_ipc_send should clear endpoint.waiter_tcb as part of the wake
//       protocol, but clearing here defensively closes the window where
//       a spurious wake would leave the slot pointing at a dead task).
//
// The retry loop is bounded by the wake-once invariant of the wake path
// (sched_wake is idempotent per #663 guard: "early-exit if target already
// RUNNABLE"), but structurally we loop until user_bounce_recv returns a
// value distinct from PENDING_TAKE_EMPTY (-1) — if the wake was spurious
// (a bug that R20b.M3-002 will not exhibit), we re-block. This matches
// the retry-on-EAGAIN pattern used by every well-formed condition-
// variable wait in POSIX-shaped kernels.
//
// Effects / capabilities
// ----------------------
// !{mem, sysreg} @{cap, sched}:
//   mem     — reads/writes the endpoint row, TCB, and user-mapped pages
//             via the walker (transitively through user_bounce_recv);
//             sched_block mutates the runqueue.
//   sysreg  — sched_block calls sched_switch_r15 which touches CR3 on
//             switching between tasks with distinct user_pml4s (though
//             at R20b.M3-001 no ring-3 caller invokes this yet — the
//             widening matches syscall_dispatch's own widening in
//             dispatch.pdx §syscall_dispatch).
//   cap     — future dispatch-shim cap-lookup (M4).
//   sched   — sched_block requires @{sched} per wake_block.pdx §sched_block.
//
// Cross-references
// ----------------
//   design/ipc/userspace-server-substrate.md §4.3, §5.1, §5.2
//   src/kernel/core/ipc/endpoint_table.pdx (endpoint_lookup, endpoint_is_full)
//   src/kernel/core/ipc/user_bounce.pdx (user_bounce_recv)
//   src/kernel/core/sched/wake_block.pdx (sched_block)
//   src/kernel/core/sched/state.pdx (TASK_STATE_WAITING_IPC, TASK_OFF_WAIT_ENDPOINT_ID)

module SysIpcRecv = structure {

  // ============================================================================
  // Result-code sentinels — mirror the sys_read / sys_write handler taxonomy
  // (Linux-style negative-errno u64s) so a caller can `sar rax, 63` sign-test
  // + branch identically to any other syscall. Kept as literals rather than
  // cross-module refs (paideia-as does not resolve cross-module `let`
  // constants at parse time — see endpoint_table.pdx §PENDING_PAYLOAD_MAX_BYTES).
  // ============================================================================

  pub let SYS_IPC_RECV_ERR_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2   // -14
  pub let SYS_IPC_RECV_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -9

  // Sentinel from endpoint_take_pending (endpoint_table.pdx §PENDING_TAKE_EMPTY)
  // and its user_bounce_recv wrapper (user_bounce.pdx §BOUNCE_RECV_EMPTY).
  pub let SYS_IPC_RECV_EMPTY_MARK : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // sys_ipc_recv_body(id, user_hdr_va, user_payload_va, user_payload_max) -> u64
  //
  // SysV ABI: rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=user_payload_max
  //        -> rax = payload_len [0..4088] OR sentinel per file header.
  //
  // Register plan (5-push callee-save prologue aligns rsp %16 == 0 for
  // nested calls; entry rsp %16 == 8 SysV; 5*8=40; 8+40=48; 48%16=0):
  //   rbx = endpoint id                 (survives every nested call)
  //   r12 = user_hdr_va                 (survives across the retry loop)
  //   r13 = user_payload_va             (survives across the retry loop)
  //   r14 = user_payload_max            (survives across the retry loop)
  //   r15 = scratch (endpoint row PA across the wait-slot install)
  // ==========================================================================

  pub let sys_ipc_recv_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (id: u64) (user_hdr_va: u64) (user_payload_va: u64) (user_payload_max: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, sched},
      justification: "R20b.M3-001 (#1558): sys_ipc_recv body — non-blocking drain via user_bounce_recv OR block + retry when the endpoint is empty. 5-push callee-save prologue (rbx/r12/r13/r14/r15) aligns rsp %16 == 0 for nested calls AND preserves the four SysV args across sched_block's caller-save-clobbering call chain (sched_pick_next_r15 + sched_switch_r15 both clobber rax/rcx/rdx/r8-r11 per their justifications; only the callee-save regs survive). Retry loop (sys_ipc_recv_retry): (a) marshal saved args back into rdi/rsi/rdx/rcx and `call user_bounce_recv`; rax gets payload_len [0..4088] OR BOUNCE_RECV_EMPTY (-1) OR BOUNCE_RECV_ERR_EFAULT (-EFAULT). (b) sign-test path: cmp rax, -1 (empty), cmp rax, -14 (EFAULT). EFAULT propagates immediately (`jmp sys_ipc_recv_done_efault`). Non-empty non-error returns immediately via `jmp sys_ipc_recv_done` (rax already carries payload_len). Empty falls into the block path. Block path (sys_ipc_recv_block): (c) endpoint_lookup(rbx) → rax = row PA or 0. Zero row means the endpoint id is invalid OR the row got freed under us (indistinguishable at this layer); return -EBADF. (d) install endpoint.waiter_tcb = _current_tcb — 8-byte store at [row + 32] (ENDPOINT_OFF_WAITER_TCB per endpoint_table.pdx). (e) install _current_tcb.wait_endpoint_id = id — 2-byte store at [tcb + 120] (TASK_OFF_WAIT_ENDPOINT_ID per state.pdx); mov_w handles the u16 half; the u16 half at +122 stays zero (rep_stosq at task_new zero-inits it). (f) `call sched_block` — flips state RUNNABLE -> WAITING (2), runq_dequeue, sched_pick_next_r15, sched_switch_r15; returns on wake. Callee-save survives (sched_block preserves rbx/r12/r13/r14/r15 per wake_block.pdx §sched_block's register discipline). (g) On wake: clear both wait-slots defensively — endpoint_lookup(rbx) → row, zero [row+32]; zero [_current_tcb+120]. Belt-and-suspenders per file-header 'wait-slot invariants' paragraph — a future sys_ipc_send should clear endpoint.waiter_tcb as part of the wake protocol, but clearing here closes the window where a spurious wake leaves stale state. (h) `jmp sys_ipc_recv_retry` — re-run the drain path. If the wake was authentic (sys_ipc_send published a msg via endpoint_write_pending BEFORE sched_wake), user_bounce_recv finds it and drains successfully. If spurious, we re-enter the block path — bounded by the wake-once invariant of sched_wake (idempotent per #663 guard). Note: mov [r10+32], r11 for the waiter_tcb store uses r10 = row addr AND r11 = _current_tcb; r11 is caller-save but sched_block preserves it (r11 is not in SysV's callee-save set, but we RE-LOAD _current_tcb after the endpoint_lookup call so we don't rely on r11 surviving). ENDPOINT_OFF_WAITER_TCB literal (32) matches endpoint_table.pdx §row-field offsets. Cross-file [rip + _current_tcb] proven at wake_block.pdx §sched_block L41 and at every dispatch handler that reads current TCB.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // rbx = id
        mov r12, rsi;                          // r12 = user_hdr_va
        mov r13, rdx;                          // r13 = user_payload_va
        mov r14, rcx;                          // r14 = user_payload_max

      sys_ipc_recv_retry:
        // ---- Try to drain via the KPTI-safe bounce primitive ----
        mov rdi, rbx;                          // arg0 = id
        mov rsi, r12;                          // arg1 = user_hdr_va
        mov rdx, r13;                          // arg2 = user_payload_va
        mov rcx, r14;                          // arg3 = user_payload_max
        call user_bounce_recv;
        // rax = payload_len [0..4088] OR BOUNCE_RECV_EMPTY (-1) OR
        //       BOUNCE_RECV_ERR_EFAULT (-EFAULT = 0xFFFFFFFFFFFFFFF2).

        // ---- Propagate -EFAULT immediately (walker rejected user VA) ----
        mov r10, 0xFFFFFFFFFFFFFFF2;           // BOUNCE_RECV_ERR_EFAULT
        cmp rax, r10;
        je  sys_ipc_recv_done_efault;

        // ---- Empty? Fall through to the block path ----
        mov r10, 0xFFFFFFFFFFFFFFFF;           // BOUNCE_RECV_EMPTY (-1)
        cmp rax, r10;
        je  sys_ipc_recv_block;

        // ---- Got a message: rax already holds payload_len; return ----
        jmp sys_ipc_recv_done;

      sys_ipc_recv_block:
        // ---- Endpoint lookup (row addr in rax; NULL means bad id) ----
        mov rdi, rbx;                          // arg0 = id
        call endpoint_lookup;                  // rax = row PA or 0
        cmp rax, 0;
        je  sys_ipc_recv_done_ebadf;
        mov r15, rax;                          // r15 = row PA (survives)

        // ---- Install waiter_tcb slot @ row +32 (ENDPOINT_OFF_WAITER_TCB) ----
        // Store _current_tcb into the endpoint's waiter slot. r11 is a
        // scratch register (caller-save; we're not counting on it beyond
        // the next instruction).
        mov r11, [rip + _current_tcb];
        mov [r15 + 32], r11;                   // ENDPOINT_OFF_WAITER_TCB

        // ---- Install wait_endpoint_id @ TCB +120 (TASK_OFF_WAIT_ENDPOINT_ID) ----
        // 2-byte store (u16). rbx holds id in [0..127] so only the low
        // 16 bits are meaningful; mov_w stores the low u16 of rbx. The
        // u16 half at +122 stays zero (task_new's rep_stosq zero-inited it).
        mov_w [r11 + 120], rbx;                // TASK_OFF_WAIT_ENDPOINT_ID

        // ---- Block: sched_block flips state RUNNABLE -> WAITING (2) ----
        // sched_block preserves callee-save regs (rbx/r12/r13/r14/r15)
        // per wake_block.pdx §sched_block's register discipline.
        call sched_block;

        // ---- On wake: clear both wait-slots defensively ----
        // A future sys_ipc_send should clear endpoint.waiter_tcb as part
        // of the wake protocol, but clearing here closes the window where
        // a spurious wake leaves stale state.
        mov rdi, rbx;                          // arg0 = id
        call endpoint_lookup;                  // rax = row PA (may be 0 if freed)
        cmp rax, 0;
        je  sys_ipc_recv_wake_skip_row_clear;
        xor r11, r11;
        mov [rax + 32], r11;                   // clear waiter_tcb
      sys_ipc_recv_wake_skip_row_clear:

        mov r11, [rip + _current_tcb];
        xor rcx, rcx;
        mov_w [r11 + 120], rcx;                // clear wait_endpoint_id (u16)

        // ---- Retry the drain (a sound wake makes this succeed) ----
        jmp sys_ipc_recv_retry;

      sys_ipc_recv_done_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT
        jmp sys_ipc_recv_done;

      sys_ipc_recv_done_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF

      sys_ipc_recv_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame
}
