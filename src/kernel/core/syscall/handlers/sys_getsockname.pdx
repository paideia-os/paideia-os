// src/kernel/core/syscall/handlers/sys_getsockname.pdx --
// R95.M2-002 (paideia-os #2079).
//
// sys_getsockname(fd, sockaddr_out_va) -> 0 | -errno. SC+ ID 101.
//
// Writes the same 8-byte {ip, port} record shape sys_getpeername
// uses, populated from LOCAL fields of the resolved row:
//   TCP: local_ip @+24..+27; local_port @+8. If the socket has
//        never been bound (local_port == 0), the ip fills from
//        _ipv4_my_ip (the tree's single-interface my_ip -- see
//        net/route_table.pdx) and port stays 0.
//   UDP: no local_ip stored on the row (single-interface tree, per
//        udp_socket.pdx module header). Always source the ip from
//        _ipv4_my_ip; port from row @+8 (0 if unbound).
//
// The "unbound -> route my_ip + port 0" contract matches the R95.M2
// design brief; a caller getting a zero port back knows to bind or
// let connect() auto-assign an ephemeral.
//
// Reserved-label discipline: gsn_ prefix.

module SysGetsockname = structure {

  pub let SYS_GETSOCKNAME_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_GETSOCKNAME_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT (-14)

  pub let mut _sys_getsockname_scratch : [u8; 8] = uninit @align(8)

  pub let sys_getsockname_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, sockaddr_out_va: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R95.M2-002 (paideia-os #2079): sys_getsockname, SC+ ID 101. Resolves fd via tcp_socket_resolve for both socket kinds; both miss -> -EBADF. TCP: if state==CLOSED and local_port==0, source ip bytes from _ipv4_my_ip and port from 0 (contract-frozen unbound path); else read local_ip @+24..+27 and local_port @+8 from the TCB. UDP: always source ip bytes from _ipv4_my_ip (single-interface tree, no per-row local_ip stored); read local_port from row @+8 (0 if unbound). Composes the 8-byte {ip[4], port[4]} record in _sys_getsockname_scratch, gate-and-walks 8 bytes out to sockaddr_out_va. Unlike sys_getpeername, does NOT gate on any state -- a fresh unminted-then-unbound socket is a legal callee for getsockname (Linux returns 0.0.0.0:0). 3-push callee-save (rbx=fd, r12=sockaddr_out_va, r13=row_ptr) + sub rsp,8. Reserved labels: gsn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        // Alignment: entry rsp%16==8; 3 pushes (24 bytes) land at
        // rsp%16==0 -- no sub rsp,8 pad needed.

        mov rbx, rdi;
        mov r12, rsi;                          // sockaddr_out_va

        mov rdi, rbx;
        mov rsi, 0x1AB;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gsn_have_tcp;

        mov rdi, rbx;
        mov rsi, 0x1A8;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gsn_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp gsn_done;

      gsn_have_tcp:
        mov r13, rax;
        shl r13, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add r13, rcx;                          // r13 = tcb_ptr

        // If local_port == 0 (unbound), source ip from _ipv4_my_ip.
        mov rax, [r13 + 8];
        cmp rax, 0;
        je gsn_tcp_unbound;

        // Bound: local_ip @+24..+27.
        xor rax, rax; mov_b rax, [r13 + 24]; mov_b [rip + _sys_getsockname_scratch + 0], rax;
        xor rax, rax; mov_b rax, [r13 + 25]; mov_b [rip + _sys_getsockname_scratch + 1], rax;
        xor rax, rax; mov_b rax, [r13 + 26]; mov_b [rip + _sys_getsockname_scratch + 2], rax;
        xor rax, rax; mov_b rax, [r13 + 27]; mov_b [rip + _sys_getsockname_scratch + 3], rax;
        jmp gsn_tcp_stamp_port;

      gsn_tcp_unbound:
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [rip + _sys_getsockname_scratch + 0], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [rip + _sys_getsockname_scratch + 1], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [rip + _sys_getsockname_scratch + 2], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [rip + _sys_getsockname_scratch + 3], rax;

      gsn_tcp_stamp_port:
        mov rax, [r13 + 8];
        mov rcx, rax; and rcx, 0xFF; mov_b [rip + _sys_getsockname_scratch + 4], rcx;
        mov rcx, rax; shr rcx, 8; and rcx, 0xFF; mov_b [rip + _sys_getsockname_scratch + 5], rcx;
        xor rcx, rcx; mov_b [rip + _sys_getsockname_scratch + 6], rcx;
        mov_b [rip + _sys_getsockname_scratch + 7], rcx;
        jmp gsn_write_out;

      gsn_have_udp:
        mov r13, rax;
        shl r13, 7;
        lea rcx, [rip + _udp_socket_table];
        add r13, rcx;                          // r13 = row_ptr

        // UDP: always ip from _ipv4_my_ip (single-interface).
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [rip + _sys_getsockname_scratch + 0], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [rip + _sys_getsockname_scratch + 1], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [rip + _sys_getsockname_scratch + 2], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [rip + _sys_getsockname_scratch + 3], rax;

        // local_port @+8.
        mov rax, [r13 + 8];
        mov rcx, rax; and rcx, 0xFF; mov_b [rip + _sys_getsockname_scratch + 4], rcx;
        mov rcx, rax; shr rcx, 8; and rcx, 0xFF; mov_b [rip + _sys_getsockname_scratch + 5], rcx;
        xor rcx, rcx; mov_b [rip + _sys_getsockname_scratch + 6], rcx;
        mov_b [rip + _sys_getsockname_scratch + 7], rcx;

      gsn_write_out:
        mov rdi, r12;
        mov rsi, 8;
        call user_ptr_ok;
        cmp rax, 0;
        jne gsn_efault;

        mov rdi, r12;
        lea rsi, [rip + _sys_getsockname_scratch];
        mov rdx, 8;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne gsn_efault;

        xor rax, rax;
        jmp gsn_done;

      gsn_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;

      gsn_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
