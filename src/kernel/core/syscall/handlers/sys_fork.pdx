// src/kernel/core/syscall/handlers/sys_fork.pdx — R15-M6-003 (#554)
// fork body: task_new + aspace_clone_cow + fd_table copy.
//
// Issue #554 (R15.M6 subsystem 9 issue 3).
// R17-M0-724-D6 (#724): child materialization + runq_enqueue.  Before this
//   landing, task_new produced an inert slab with regs_save.rsp/rip/rflags
//   all zero, and sys_fork_body returned the child pid to the parent without
//   ever putting the child on the runqueue.  Now sys_fork_body owns the
//   composition: snapshot parent's user context (rip/rsp/rflags) into
//   dedicated slots on the child's slab, wire regs_save to route the first
//   schedule of the child through sys_fork_child_landing (via the uniform
//   sched_switch_r15_continuation trampoline), flip state to STATE_RUNNABLE,
//   and runq_enqueue.  See design/kernel/r17-m0-724-d6-fork-enqueue.md.
// R135.M2 (paideia-os #2627) -- per-jail process spawn mediation.
//   sys_fork_body now consults svc.jail-supervisor BEFORE committing a
//   child task to a jailed parent:
//     (a) At entry, lookup(parent_pid) -> parent_jail_id (held in r13
//         for the body's duration; 0xFF sentinel means "not jailed").
//     (b) After task_new + aspace_clone_cow succeed (so the cheap
//         failures still land before any jail counter is touched),
//         if parent is jailed we call _jail_supervisor_spawn_check +
//         _jail_supervisor_register_child.  spawn_check gates against
//         the parent jail's max_children ceiling (M2 default = 4);
//         register_child inherits the parent's cap_env + syscall_mask
//         into a new jail row keyed by the child's pid.
//     (c) On jail refusal, roll back the child allocation (aspace
//         teardown + pid_free) and return -EACCES.  On register_child
//         failure after a successful spawn_check, additionally call
//         _jail_supervisor_spawn_unbump so the parent's child_count
//         is not permanently inflated.
//   r13's role shifts from "aligner, no semantic use" (pre-M2) to
//   "parent jail id, carried through the entire body".  Still a
//   3-push prologue; stack alignment unchanged.

module SysFork = structure {
  // ==========================================================================
  // Field offsets — pinned by #549 / #557
  // ==========================================================================
  pub let TASK_OFF_PID          : u64 = 0
  pub let TASK_OFF_STATE        : u64 = 8
  pub let TASK_OFF_USER_PML4_PA : u64 = 16
  pub let TASK_OFF_REGS_RSP     : u64 = 32
  pub let TASK_OFF_REGS_RIP     : u64 = 40
  pub let TASK_OFF_REGS_RFLAGS  : u64 = 48
  pub let FD_TABLE_OFFSET       : u64 = 168
  pub let FD_TABLE_MAX          : u64 = 32

  // R17-M0-724-D6 (#724): child fresh-schedule state offsets.  These live
  // inside the 2224-byte slab (task_free's rep-stosq already zeroes them at
  // teardown) and are read exclusively by sys_fork_child_landing on the
  // child's first schedule.
  pub let TASK_OFF_FORK_USER_RIP    : u64 = 1720
  pub let TASK_OFF_FORK_USER_RSP    : u64 = 1728
  pub let TASK_OFF_FORK_USER_RFLAGS : u64 = 1736

  // Landing-stack return-address slot (the top qword of the 2224-byte slab).
  // sched_switch_r15's swap-in pushes rflags at [child+2208] and rip at
  // [child+2200] (both still inside the slab), then continuation's final ret
  // pops &sys_fork_child_landing from [child+2216].  Contract: this offset
  // must equal (SLAB_SIZE - 8) where SLAB_SIZE = 2224 bytes (278 u64s).
  pub let TASK_OFF_LANDING_RA       : u64 = 2216
  pub let LANDING_RSP_OFFSET        : u64 = 2216  // same slot, named for the rsp store

  // Error sentinels (negative-errno convention; sign-extended u64)
  pub let FORK_ERR_EAGAIN       : u64 = 0xFFFFFFFFFFFFFFF5   // -11
  pub let FORK_ERR_ENOMEM       : u64 = 0xFFFFFFFFFFFFFFF4   // -12
  // R135.M2 (paideia-os #2627): -EACCES is returned by sys_fork_body
  // when the parent process is in a WASI jail and the jail-supervisor
  // refuses the spawn (jail's child_count has hit max_children, or
  // register_child could not allocate a jail row for the child).
  pub let FORK_ERR_EACCES       : u64 = 0xFFFFFFFFFFFFFFF3   // -13

  // R135.M2 (paideia-os #2627): JS_ID_NONE mirror for the fork body.
  // Must stay in sync with jail_supervisor.pdx JS_ID_NONE.
  pub let FORK_JS_ID_NONE       : u64 = 0xFF

  // clone_cow OOM sentinel (per aspace_clone.pdx)
  pub let CLONE_COW_OOM         : u64 = 0xFFFFFFFF

  // Task state constants (mirror sys_exit.pdx for local self-containment).
  pub let STATE_RUNNABLE        : u32 = 1

  // Safe "fresh-child" rflags for sched_switch_r15's swap-in popfq: bit 1 is
  // reserved-must-be-one per Intel SDM Vol 1 §3.4.3; IF=0 (bit 9 = 0) is
  // deliberate — it guarantees no interrupt can fire on the one-instruction
  // window between continuation's popfq and sys_fork_child_landing's cli,
  // which would otherwise push a 5-slot iretq frame onto the child's 24-byte
  // in-slab landing stack and overflow into unrelated slab fields.  The
  // user-mode IF=1 comes from fork_user_rflags at the landing's iretq, not
  // from this value.  See design §6.1.
  pub let FRESH_CHILD_RFLAGS    : u64 = 0x2

  // ==========================================================================
  // R15-M6-003 (#554): sys_fork_body — testable via witness
  // ==========================================================================
  pub let sys_fork_body : (u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (current: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, sched},
      justification: "R15-M6-003 (#554) + R16-M3-006 (#592) + R17-M0-724-D6 (#724) + R135.M2 (#2627): sys_fork body — sequential composition of task_new + aspace_clone_cow + fd_table copy + fd_inherit_hold + child materialization + runq_enqueue, with WASI-jail mediation on jailed-parent fork. Entry: rdi = current (*task, non-NULL parent slab). Return via {rax, rdx}: on success rax = child->pid (u32), rdx = 0; on failure rax = -EAGAIN / -ENOMEM / -EACCES. R135.M2 adds the jail mediation: Phase 1.5 reads parent pid and calls _jail_supervisor_lookup; the result (0..7 = parent_jail_id or 0xFF = not-jailed) is held in r13 across the body. r13's role shifts from align-only (pre-M2) to parent_jail_id. task_new + aspace_clone_cow run as before (their failure paths return early without touching the jail counter, so no counter rollback is needed there). Phase 3.5 (M2) runs ONLY if r13 != 0xFF: (a) _jail_supervisor_spawn_check(parent_jail_id) gates against max_children (default 4). On refuse -> jump sys_fork_fail_jail_rollback -> teardown child aspace + pid_free + return -EACCES (NO counter rollback: spawn_check only bumps on OK). (b) _jail_supervisor_register_child(parent_jail_id, child_pid) mints the child's own jail row, inheriting cap_env + syscall_mask + max_children. On failure -> jump sys_fork_fail_jail_register_rollback -> _jail_supervisor_spawn_unbump(parent_jail_id) + teardown child aspace + pid_free + return -EACCES. Capabilities widened @{sched} -> @{cap, sched} to cover _jail_supervisor_* (declared @{cap}); dispatch_fork's declared @{cap, sched} already covers us. Register discipline: 3-push prologue unchanged (rbx = current, r12 = child, r13 = parent_jail_id or 0xFF). rbx dereferenced at [rbx + 16] and [rbx + rcx*8 + 168]; neither task_new, clone_cow nor the jail-supervisor calls mutate parent's slab fields (jail-supervisor only touches its own pool). The initial _jail_supervisor_lookup clobbers rdi, so `mov rdi, rbx` is restored before `call task_new`. All jail-supervisor functions preserve the SysV callee-save set (rbx/rbp/r12-r15). State discipline: child->state written STATE_RUNNABLE @ Phase 4.8, then and only then does the child become schedulable. child->parent_pid was set by task_new to current->pid at Phase 2.",
      block: {
        // ===== phase 1: prologue =====
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                              // rbx = current

        // ===== phase 1.5 (R135.M2 / #2627): jail lookup =====
        //
        // r13 is now the "parent jail id, or 0xFF for not-jailed"
        // register, held through every subsequent phase.  _jail_
        // supervisor_lookup is a pure leaf scan (0 callee-save pushes;
        // uses rax/rcx/r10/r11 as scratch) so our rbx/r12 remain safe
        // across it.  rdi IS clobbered though -- it must be restored
        // before the subsequent call task_new (whose rdi contract is
        // "current", which we hold in rbx).
        mov eax, [rbx + 0];                        // parent pid (u32 zero-ext)
        mov rdi, rax;
        call _jail_supervisor_lookup;              // rax = parent_jail_id | 0xFF
        mov r13, rax;                              // r13 = parent_jail_id or 0xFF

        // ===== phase 2: task_new(current) =====
        //
        // Restore rdi = current for task_new's SysV contract.  The
        // original rdi was consumed by the lookup call above.
        mov rdi, rbx;
        call task_new;                              // rax = child slab or 0
        cmp rax, 0;
        je sys_fork_fail_new;
        mov r12, rax;                              // r12 = child

        // ===== phase 3: aspace_clone_cow(parent_pml4, child_pml4) =====
        mov rdi, [rbx + 16];                       // rdi = parent user_pml4_va
        mov rsi, [r12 + 16];                       // rsi = child user_pml4_va
        call aspace_clone_cow;                      // rax = 0 or 0xFFFFFFFF
        cmp rax, 0;
        jne sys_fork_fail_rollback;

        // ===== phase 3.5 (R135.M2 / #2627): jail mediation =====
        //
        // If parent is jailed (r13 != 0xFF), gate the spawn and mint
        // a child jail row.  We arrive here only after task_new +
        // aspace_clone_cow have both succeeded, so a spawn/register
        // refusal must roll BOTH back (teardown child aspace +
        // pid_free) before returning -EACCES.
        //
        // Both spawn_check and register_child are callee-save-clean
        // (they preserve rbx, r12, r13), so no bracket is needed; the
        // state we care about outlives each call.
        mov r11, 0xFF;                             // FORK_JS_ID_NONE
        cmp r13, r11;
        je sys_fork_skip_jail;

        //   (a) spawn_check — bumps parent's child_count on OK.
        mov rdi, r13;
        call _jail_supervisor_spawn_check;
        cmp rax, 0;
        jne sys_fork_fail_jail_rollback;           // -EACCES

        //   (b) register_child — allocates a jail row for the child,
        //       inheriting parent's cap_env + mask.  On failure, we
        //       also have to unbump (a) because spawn_check bumped
        //       the counter.
        mov rdi, r13;                              // parent_jail_id
        mov eax, [r12 + 0];                        // child pid (u32 zero-ext)
        mov rsi, rax;
        call _jail_supervisor_register_child;
        cmp rax, 0;
        jne sys_fork_fail_jail_register_rollback;  // -EACCES (unbumps first)

      sys_fork_skip_jail:

        // ===== phase 4: fd_table copy loop =====
        mov rcx, 0;
      sys_fork_fd_loop:
        cmp rcx, 32;                               // FD_TABLE_MAX
        jae sys_fork_fd_done;
        mov rax, [rbx + rcx*8 + 168];              // parent.fd[rcx]
        mov [r12 + rcx*8 + 168], rax;              // child.fd[rcx]
        add rcx, 1;
        jmp sys_fork_fd_loop;
      sys_fork_fd_done:

        // ===== phase 4.5 (#592): hold each inherited vnode =====
        mov rdi, r12;
        call fd_inherit_hold;

        // ===== phase 4.7 (#724 D6 + #728 D9): materialize child's fresh-schedule state =====

        // (a) fork_user_rip @ +1720
        //     Source: [parent.kstack_top - 8], where syscall_entry pushed
        //     rcx (the CPU-saved return RIP after `syscall`) as the very
        //     first push after loading the parent's per-task kernel stack.
        //
        //     #728 D9: was `[_syscall_kernel_stack + 16376]` — a fixed
        //     global-stack offset.  With per-task kernel stacks (§6.1 of
        //     the D9 design doc), the parent's user rip lives at the top
        //     of PARENT'S kstack, addressed via TCB.kstack_top @+24.
        //     rbx holds the parent slab (loaded in phase 1 prologue),
        //     which task_new has populated with kstack_top @+24 since
        //     the D9 task_pool.pdx change.
        mov rax, [rbx + 24];                       // rax = parent kstack_top
        mov rcx, [rax - 8];                        // rcx = parent user RIP (1st push)
        mov [r12 + 1720], rcx;                     // child.fork_user_rip

        // (b) fork_user_rflags @ +1736
        //     Source: [parent.kstack_top - 16] (r11 push).  Same rewire.
        mov rcx, [rax - 16];                       // rcx = parent user RFLAGS (IF=1)
        mov [r12 + 1736], rcx;                     // child.fork_user_rflags

        // (c) fork_user_rsp @ +1728
        //     Source: [_saved_user_rsp] (trampoline data slot written by
        //     syscall_entry before the CR3 flip; see trampoline_data.pdx).
        mov rcx, [rip + _saved_user_rsp];
        mov [r12 + 1728], rcx;                     // child.fork_user_rsp

        // (d) regs_save.rip = &sched_switch_r15_continuation
        //     Uniform trampoline convention (switch.pdx §6.2): every fresh
        //     task's rip points at continuation; continuation's popfq +
        //     ret hands off to the pre-placed entry address on the fresh
        //     task's stack.  We use continuation regardless of the child's
        //     landing being sys_fork_child_landing — that's exactly what
        //     the uniform convention enables.
        lea rcx, [rip + sched_switch_r15_continuation];
        mov [r12 + 40], rcx;                       // regs_save.rip

        // (d') regs_save.rflags = 0x2 (IF=0 for the popfq/ret/cli window;
        //      user's IF=1 comes from fork_user_rflags at iretq).
        mov rcx, 0x2;
        mov [r12 + 48], rcx;                       // regs_save.rflags

        // (e) [r12 + 2216] = &sys_fork_child_landing
        //     The top-of-slab landing return-address slot.  Consumed by the
        //     final ret inside sched_switch_r15_continuation.
        lea rcx, [rip + sys_fork_child_landing];
        mov [r12 + 2216], rcx;                     // landing RA

        // (f) regs_save.rsp = r12 + 2216
        //     sched_switch_r15's swap-in loads rsp from here, then pushes
        //     rflags and rip; those pushes land at [r12+2208] and [r12+2200]
        //     respectively — both still inside the 2224-byte slab.
        mov rcx, r12;
        add rcx, 2216;
        mov [r12 + 32], rcx;                       // regs_save.rsp

        // ===== phase 4.8 (#724 D6): publish on runqueue =====
        //
        // Order matters: state first, then enqueue.  runq_enqueue itself
        // doesn't inspect state (it's a pure list op — see runqueue.pdx
        // §runq_enqueue), but the invariant "everything on _runq_head_slot
        // is RUNNABLE" (per pick_next.pdx contract) MUST hold before we
        // splice the child in.  Otherwise sched_pick_next_r15 could observe
        // the child on the runqueue with state=STATE_NEW and trip a
        // future state-vs-list assertion.

        mov ecx, 1;                                // STATE_RUNNABLE (u32)
        mov [r12 + 8], ecx;                        // child.state

        mov rdi, r12;
        call runq_enqueue;                          // insert child at tail

        // ===== phase 5: return child pid =====
        mov eax, [r12 + 0];                        // child->pid (u32 zero-ext)
        xor rdx, rdx;
        jmp sys_fork_return;

      sys_fork_fail_rollback:
        // clone_cow OOM: teardown child's aspace + release pid slot.
        // The child was never enqueued (phase 4.8 hasn't run), so no runq
        // rollback is needed.  Jail counter is also untouched (phase 3.5
        // hasn't run), so no spawn_unbump is needed.
        mov rdi, [r12 + 16];
        call aspace_teardown;
        mov edi, [r12 + 0];                        // child->pid
        call pid_free;
        mov rax, 0xFFFFFFFFFFFFFFF4;               // -ENOMEM
        xor rdx, rdx;
        jmp sys_fork_return;

      sys_fork_fail_jail_register_rollback:
        // R135.M2 (#2627): spawn_check succeeded (parent's child_count
        // was bumped) but register_child failed to mint the child jail
        // row.  Decrement the counter first, then fall through to the
        // common jail-rollback path (aspace teardown + pid_free).
        //
        // _jail_supervisor_spawn_unbump is a pure-leaf no-pushes helper;
        // it preserves rbx/r12/r13 as callee-save-clean so the following
        // teardown sees the same register state.
        mov rdi, r13;
        call _jail_supervisor_spawn_unbump;
        // fallthrough to jail-rollback

      sys_fork_fail_jail_rollback:
        // R135.M2 (#2627): common EACCES rollback after jail refusal.
        // Teardown child aspace, release child pid, return -EACCES.
        // Phase 4.5+ (fd_inherit_hold) has NOT run yet (phase 3.5 sits
        // between phase 3 and phase 4), so no vnode-ref rollback is
        // needed.  Phase 4.8 has NOT run, so no runq rollback is needed.
        mov rdi, [r12 + 16];
        call aspace_teardown;
        mov edi, [r12 + 0];                        // child->pid
        call pid_free;
        mov rax, 0xFFFFFFFFFFFFFFF3;               // -EACCES
        xor rdx, rdx;
        jmp sys_fork_return;

      sys_fork_fail_new:
        mov rax, 0xFFFFFFFFFFFFFFF5;               // -EAGAIN
        xor rdx, rdx;

      sys_fork_return:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
