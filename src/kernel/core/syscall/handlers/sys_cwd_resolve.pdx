// src/kernel/core/syscall/handlers/sys_cwd_resolve.pdx
// R90-XREPO.010.M1-007 (paideia-os #2115): sys_cwd_resolve body.
//
// The ring-3-facing realpath primitive for the mv/rm/cp satellite tools.
// Resolves a caller-supplied path -- absolute OR relative (relative anchors
// against the CALLER's TASK_OFF_CWD per design/user/cwd-semantics.md
// Option A, read fresh at entry) -- to its canonical absolute form and
// writes it back to the caller as a NUL-terminated ASCII string.
//
// Sysno 517 (pre-reserved out-of-band per the mv/rm design docs -- see
// design/user/syscall-table.md §Reserved out-of-band sysnos and dispatch.
// pdx's explicit sysno-517 early check).  Placed at
// src/kernel/core/syscall/handlers/ (matching R90-XREPO.010's sibling
// bodies sys_pdxfs_undo_write.pdx / sys_pdxfs_fault_inject.pdx / sys_pdxfs_
// stat_by_inode.pdx / sys_pdxfs_txn_commit.pdx / sys_pdxfs_txn_abort.pdx),
// not under src/kernel/core/syscall/ alongside sys_chdir.pdx / sys_getcwd.
// pdx: the R86 relative-path pair went to the syscall directory because
// those bodies self-walk user memory (their contract takes user VAs), but
// this body takes KERNEL VAs -- the dispatch shim does the KPTI bounce --
// matching sys_pdxfs_undo_write_body's shape and letting a ring-0 boot
// witness call the body directly with .rodata path strings without a
// synthetic user aspace.
//
// -----------------------------------------------------------------------------
// Contract (SysV, 3 args after the dispatch shim's SysV shuffle)
// -----------------------------------------------------------------------------
//
// sys_cwd_resolve_body(kpath_ptr, kabs_out_ptr, abs_out_cap) -> u64
//   rdi = kpath_ptr     KERNEL VA of a NUL-terminated ASCII path string
//                        (dispatch shim's user_read_str_via_walk delivers
//                        a kernel scratch here; a boot witness passes a
//                        .rodata pointer directly since boot context
//                        bypasses the shim).
//   rsi = kabs_out_ptr  KERNEL VA of the destination buffer (dispatch
//                        shim's own kernel scratch, or a witness-owned
//                        .bss buffer).
//   rdx = abs_out_cap   caller-declared capacity of that buffer in bytes
//                        (must include room for the trailing NUL -- the
//                        body's -ERANGE gate compares content_len+1
//                        against this).
//
//   -> rax = N (>= 0)                       strlen of the composed absolute
//                                            path, EXCLUDING the trailing
//                                            NUL (per the parent-issue's
//                                            "return strlen" ask; the NUL
//                                            is still written to
//                                            kabs_out_ptr[N] so downstream
//                                            `mov_b [dst + strlen]`
//                                            idioms work).
//            0xFFFFFFFFFFFFFFFE (-ENOENT)   path did not resolve OR no
//                                            mounted root (defensive; the
//                                            no-mount arm is unreachable
//                                            once boot completes).
//            0xFFFFFFFFFFFFFFDE (-ERANGE)   composed path (+ NUL) does
//                                            not fit in abs_out_cap, OR
//                                            the parent-chain walk
//                                            exceeded MAX_DEPTH=32, OR
//                                            the composed string would
//                                            overrun the internal 256-B
//                                            scratch.  Nothing is written
//                                            to kabs_out_ptr on this arm.
//
// -----------------------------------------------------------------------------
// Composition (mirrors sys_getcwd_body Phase A/B after a sys_chdir_body
// style path_resolve prelude)
// -----------------------------------------------------------------------------
//
// (1) mount_root_vnode() -> root_idx.  0 -> -ENOENT.
// (2) Read TASK_OFF_CWD (+160) from _current_tcb.  0 -> defensive fallback
//     to root_idx (matches sys_getcwd_body's own posture).
// (3) path_resolve(kpath_ptr, root_idx, cwd_idx) -> vnode_idx or 0.  0 ->
//     -ENOENT.  path_resolve itself picks the anchor: first byte '/' ->
//     absolute against root_idx; otherwise relative against cwd_idx --
//     the shared invariant frozen in design/user/cwd-semantics.md §4.
// (4) Phase A: walk upward via each vnode's parent_idx (+8) until reaching
//     root_idx, pushing every visited vnode idx onto _scr_stack (leaf-to-
//     near-root order).  Bounded at MAX_DEPTH=32; overflow -> -ERANGE.
//     A parent_idx of VNODE_IDX_NONE (0xFFFF) terminates the walk early
//     (matches sys_getcwd_body's defensive-detached posture).
// (5) Phase B: compose the output root-to-leaf into _scr_out: a leading
//     '/', then each stacked component's name (read back from _vnode_
//     name_table which path_resolve's regular_lookup stamps at
//     path.pdx:316 on every successful lookup) in REVERSE stack order,
//     '/'-separated.  depth==0 (target IS root) yields the bare "/".
//     Per-byte bound at 254 leaves room for the final NUL at index 255;
//     overflow -> -ERANGE (defensive -- no realistic nesting reaches it).
// (6) Content length gate: if (content_len + 1) > abs_out_cap -> -ERANGE.
// (7) Byte-copy _scr_out[0..content_len] to kabs_out_ptr; write NUL at
//     kabs_out_ptr[content_len].
// (8) Emit `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=<n>` via
//     klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_cwd_resolve_ok,
//     k_len, content_len) on the OK path only.
// (9) Return content_len (strlen, EXCLUDING the trailing NUL).
//
// -----------------------------------------------------------------------------
// Design ambiguity: dropped `path_len_hint`
// -----------------------------------------------------------------------------
//
// design/user/cwd-semantics.md §5's skeleton suggests a 4-arg shape
// (path_ptr, path_len_hint, abs_out_ptr, abs_out_cap).  This landing
// drops the length hint: path_resolve sizes the path string itself via
// the NUL terminator (path.pdx L92-95 peek + L155-165 skip_slashes) and
// caps at PATH_MAX=256 internally, so a caller-supplied hint would be
// redundant with the walker's own bound.  If a future round needs an
// explicit length (e.g. to admit a non-NUL-terminated caller shape),
// the signature extends to add the parameter without displacing the
// three that stay -- caller code and dispatch shim compile against the
// new signature verbatim.
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// `!{mem, sysreg} @{cap}` -- mem covers path_resolve + the parent-chain
// walk + composed-string writes; sysreg covers klog_s1_d1's TSC read; cap
// is the same forward-compat annotation every R86/R90 fs-syscall body
// carries (no cap check runs at this landing).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `scr_` (Sys Cwd Resolve).  `loop`, `if`, etc. are
// keywords and never used as labels.

module SysCwdResolve = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================
  pub let SYS_CWD_RESOLVE_ERR_ENOENT : u64 = 0xFFFFFFFFFFFFFFFE   // -2
  pub let SYS_CWD_RESOLVE_ERR_ERANGE : u64 = 0xFFFFFFFFFFFFFFDE   // -34

  // Matches PATH_MAX (path.pdx) and SYS_GETCWD_PATH_MAX.
  pub let SYS_CWD_RESOLVE_PATH_MAX  : u64 = 256
  // Matches SYS_GETCWD_MAX_DEPTH's parent-chain bound.  Well beyond any
  // depth this kernel's tmpfs/pdxfs backends can construct at R90.
  pub let SYS_CWD_RESOLVE_MAX_DEPTH : u64 = 32

  // Bounded stack of ancestor vnode indices (leaf-to-near-root order).
  // Sibling of _sys_getcwd_stack; separate storage keeps concurrent
  // sys_getcwd + sys_cwd_resolve callers from stepping on each other's
  // walk state should they ever land in the same call cascade.
  pub let mut _scr_stack : [u64; 32] = uninit @align(8)

  // Composed output string, built root-to-leaf.  Same PATH_MAX sizing as
  // every other per-syscall path scratch in this file group.  Content
  // is copied out to kabs_out_ptr (which the dispatch shim then walks
  // to the user buffer via user_write_bytes_via_walk).
  pub let mut _scr_out : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_cwd_resolve_body(kpath_ptr, kabs_out_ptr, abs_out_cap) -> u64
  //
  // Register plan (6-push callee-save; entry rsp%16==8, minus 48 = %16==8;
  // one `sub rsp, 8` pad brings it to 0 at every nested call site --
  // matches sys_pdxfs_undo_write_body's own 6-push discipline for the
  // "one more callee-save than sys_getcwd_body's 5" case here):
  //   rbx = kpath_ptr           (survives until path_resolve; dead thereafter)
  //   r12 = abs_out_cap          (RAW caller value -- the -ERANGE decision
  //                                compares (content_len+1) against this)
  //   r13 = root_idx             (survives the whole parent-chain walk)
  //   r14 = cur / composed_len   (walks vnode idxs during Phase A; reused
  //                                to hold composed_len from Phase B tail
  //                                through the fingerprint emit)
  //   r15 = depth                (Phase A stack count; also Phase B
  //                                reverse-iteration bound)
  //   rbp = kabs_out_ptr         (survives to the byte-copy tail; the
  //                                sixth push exists solely to hold this
  //                                argument across path_resolve + the
  //                                parent-chain walk without a stack slot)
  // ==========================================================================
  pub let sys_cwd_resolve_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (kpath_ptr: u64) (kabs_out_ptr: u64) (abs_out_cap: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R90-XREPO.010.M1-007 (paideia-os #2115): sys_cwd_resolve body -- ring-3 realpath primitive (sysno 517, out-of-band). Takes KERNEL VAs for both kpath_ptr and kabs_out_ptr, matching sys_pdxfs_undo_write_body's shape (dispatch shim does the KPTI bounce for a ring-3 caller; a boot witness passes .rodata / .bss pointers directly). Body: (1) mount_root_vnode() -> r13=root_idx; 0 -> -ENOENT. (2) Load [_current_tcb + 160] -> cwd_idx; 0 -> defensive fallback to root_idx (matches sys_getcwd_body). (3) path_resolve(kpath_ptr=rbx, root_idx=r13, cwd=rcx) -> vnode_idx or 0. 0 -> -ENOENT. path_resolve picks the anchor per design/user/cwd-semantics.md §4 (first byte '/' -> absolute against root_idx; else relative against cwd_idx). Stashed into r14 as the walk cursor. (4) Phase A: walk r14 upward via each vnode's parent_idx (+8) until reaching r13 (root_idx), pushing every visited idx onto _scr_stack. Bounded at SYS_CWD_RESOLVE_MAX_DEPTH=32; overflow -> -ERANGE. A parent_idx of VNODE_IDX_NONE (0xFFFF) terminates the walk (defensive -- detached vnodes). r15 accumulates depth. (5) Phase B: compose _scr_out root-to-leaf: leading '/', then each stacked idx's name (read from _vnode_name_table at [rip + _vnode_name_table + idx*64]) in REVERSE stack order, '/'-separated. depth==0 -> bare '/'. Per-byte gate at 254 leaves room for the NUL at 255; overflow -> -ERANGE. (6) content_len (r14 now) + 1 vs r12 (abs_out_cap): > -> -ERANGE. Nothing written on this arm since the caller's kabs_out_ptr hasn't been touched yet. (7) Byte-copy _scr_out[0..content_len] to [rbp]; NUL at [rbp + content_len]. (8) klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_cwd_resolve_ok, k_len, content_len). (9) mov rax, r14; jmp scr_done. All failure arms jmp scr_done with rax pre-loaded to the sentinel; the 6-pop epilogue runs unconditionally. 6-push callee-save prologue (rbx, r12, r13, r14, r15, rbp) + `sub rsp, 8` alignment pad lands rsp%16==0 (entry %16==8, minus 48+8 = %16==0), matching sys_pdxfs_undo_write_body's own 6-push discipline (that body uses rbp for the same 'one more callee-save' reason). Every nested call site (mount_root_vnode, path_resolve, vnode_slot inside the Phase A loop, klog_s1_d1) sees %16==0 pre-CALL. Phase A's per-iteration scratch (rax/rcx/r8) is reloaded AFTER `call vnode_slot` rather than held across it, matching sys_getcwd_body's own ABI-safety discipline. Phase B's byte-copy loop runs with no nested call active. mov_b used for the per-byte name-copy load, preceded by `xor rax, rax` (mov_b does not zero-extend on its own -- same discipline as path.pdx's copy_char loop and sys_getcwd_body's Phase B). Encoder-conservative: cmp/je/jne/jae/ja/mov/mov_b/mov_w/lea/xor/push/pop/call/add/sub/shl/ret only -- every form already proven at this exact shape in sys_getcwd_body / sys_pdxfs_undo_write_body. Labels prefixed scr_ -- grep audit 2026-09-01: no scr_ collisions elsewhere in src/kernel/. Effects {mem, sysreg} @{cap} match sys_getcwd_body's own posture.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // 6 pushes leave rsp%16==8; pad
                                         //   to 0 for nested calls.

        mov rbx, rdi;                    // rbx = kpath_ptr
        mov rbp, rsi;                    // rbp = kabs_out_ptr (survives)
        mov r12, rdx;                    // r12 = abs_out_cap (RAW)

        // ---- (1) mount_root_vnode() ----
        call mount_root_vnode;           // rax = root_idx
        cmp rax, 0;
        je  scr_enoent;
        mov r13, rax;                    // r13 = root_idx

        // ---- (2) load CURRENT cwd from the TCB ----
        mov rax, [rip + _current_tcb];
        mov rcx, [rax + 160];            // rcx = cwd (TASK_OFF_CWD)
        cmp rcx, 0;
        jne scr_cwd_ok;
        mov rcx, r13;                    // defensive fallback: treat 0 as root
      scr_cwd_ok:

        // ---- (3) path_resolve(kpath_ptr, root_idx, cwd) ----
        mov rdi, rbx;                    // arg1 = kpath_ptr
        mov rsi, r13;                    // arg2 = root_idx
        mov rdx, rcx;                    // arg3 = cwd
        call path_resolve;               // rax = vnode_idx or 0
        cmp rax, 0;
        je  scr_enoent;
        mov r14, rax;                    // r14 = cur (walk cursor)

        // ---- (4) Phase A: walk upward, pushing ancestors ----
        xor r15, r15;                    // r15 = depth

      scr_walk_top:
        cmp r14, r13;                    // cur == root_idx?
        je  scr_walk_done;

        cmp r15, 32;                     // SYS_CWD_RESOLVE_MAX_DEPTH
        jae scr_erange;

        mov rdi, r14;
        call vnode_slot;                 // rax = &vnode
        xor rcx, rcx;
        mov_w rcx, [rax + 8];            // rcx = parent_idx (VNODE_PARENT_IDX_OFFSET=8)
        cmp rcx, 0xFFFF;                 // VNODE_IDX_NONE -- defensive: detached
        je  scr_walk_done;

        lea r8, [rip + _scr_stack];
        mov [r8 + r15*8], r14;           // stack[depth] = cur
        add r15, 1;
        mov r14, rcx;                    // cur = parent
        jmp scr_walk_top;

      scr_walk_done:
        // r15 = depth (ancestor count, EXCLUDING root itself)

        // ---- (5) Phase B: compose the output string root-to-leaf ----
        lea rdi, [rip + _scr_out];
        mov rax, 0x2F;                   // '/'
        mov_b [rdi + 0], rax;
        mov r9, 1;                       // r9 = out_cursor

        cmp r15, 0;
        je  scr_compose_done;            // depth==0 -> bare "/" already written

        mov r10, r15;
        sub r10, 1;                      // r10 = reverse-iteration index (depth-1 .. 0)

      scr_compose_top:
        lea r8, [rip + _scr_stack];
        mov r11, [r8 + r10*8];           // r11 = vidx (near-root-first order)

        lea r8, [rip + _vnode_name_table];
        mov rax, r11;
        shl rax, 6;                      // idx * VNODE_NAME_SLOT_BYTES (64)
        add r8, rax;                     // r8 = name_ptr

        lea rdi, [rip + _scr_out];
        xor rcx, rcx;                    // rcx = per-component byte index

      scr_namecopy_top:
        cmp rcx, 63;                     // NAME_MAX -- defensive component bound
        jae scr_namecopy_done;
        cmp r9, 254;                     // leave room for NUL at 255
        jae scr_erange;
        xor rax, rax;
        mov_b rax, [r8 + rcx*1];
        cmp rax, 0;
        je  scr_namecopy_done;
        mov_b [rdi + r9*1], rax;
        add r9, 1;
        add rcx, 1;
        jmp scr_namecopy_top;

      scr_namecopy_done:
        cmp r10, 0;
        je  scr_compose_next;            // leaf component -- no trailing '/'
        cmp r9, 254;
        jae scr_erange;
        mov rax, 0x2F;                   // '/'
        mov_b [rdi + r9*1], rax;
        add r9, 1;

      scr_compose_next:
        cmp r10, 0;
        je  scr_compose_done;
        sub r10, 1;
        jmp scr_compose_top;

      scr_compose_done:
        // r9 = content byte count (excludes the trailing NUL written by
        // the byte-copy tail at step (7)).  Move to r14 (callee-save,
        // dead past Phase A -- the walk cursor role is retired now) so
        // it survives the byte-copy and fingerprint calls below.
        mov r14, r9;                     // r14 = content_len (survives)

        // ---- (6) -ERANGE gate against the caller's RAW abs_out_cap ----
        // Compare (content_len + 1) vs abs_out_cap.  The +1 covers the
        // trailing NUL the byte-copy tail writes at kabs_out_ptr[content_len].
        mov rax, r14;
        add rax, 1;
        cmp rax, r12;
        ja  scr_erange;

        // ---- (7) Byte-copy _scr_out[0..content_len] -> kabs_out_ptr ----
        // Move kabs_out_ptr from rbp into rdi (caller-save, free from
        // here on) before the byte-store loop.  x86's SIB-with-base-rbp
        // special case (mod=00 + base=101 encodes disp32-only rather
        // than [rbp + index]) makes `mov_b [rbp + reg*1], al` a form
        // that requires an explicit mod=01 disp8=0 fixup; landing the
        // destination in rdi sidesteps the encoder-gap risk entirely
        // and matches sys_getcwd_body's own `mov_b [rdi + r9*1]` shape.
        mov rdi, rbp;                    // rdi = kabs_out_ptr (destination)
        lea rsi, [rip + _scr_out];       // rsi = &_scr_out (source)
        xor rcx, rcx;                    // rcx = byte index

      scr_copy_top:
        cmp rcx, r14;
        jae scr_copy_done;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + rcx*1], rax;
        add rcx, 1;
        jmp scr_copy_top;

      scr_copy_done:
        // NUL-terminate at kabs_out_ptr[content_len].
        xor rax, rax;
        mov_b [rdi + r14*1], rax;

        // ---- (8) Fingerprint emit ----
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_cwd_resolve_ok];
        lea rcx, [rip + k_len];
        mov r8, r14;                             // v1 = content_len
        call klog_s1_d1;

        // ---- (9) Success return: strlen (EXCLUDING NUL) ----
        mov rax, r14;
        jmp scr_done;

      scr_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp scr_done;

      scr_erange:
        mov rax, 0xFFFFFFFFFFFFFFDE;     // -ERANGE

      scr_done:
        add rsp, 8;                      // undo alignment pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
