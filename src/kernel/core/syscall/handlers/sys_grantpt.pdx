// src/kernel/core/syscall/handlers/sys_grantpt.pdx -- Wave iota (ι-02,
// paideia-os pdxterm real-body wave)
//
// sys_grantpt(master_fd) -> 0 | -EBADF. SC+ ID 123.
//
// POSIX grantpt(3) changes ownership/permissions of the slave device
// node under /dev/pts so the calling (usually unprivileged) process may
// open it. This kernel has no /dev/pts filesystem and no per-fd
// ownership model to grant -- the slave side is reached purely through
// the fd_table entry sys_openpty already wired, not through a path any
// process resolves independently. `grantpt` is therefore an HONEST
// structural-validity check rather than a real permission grant: it
// confirms `master_fd` is a live PTY-tagged fd on the MASTER side (and
// therefore that its paired slave really exists), and no-ops otherwise.
// Any real access-control gap this simplification leaves is: none --
// there is no second path to the slave fd to protect against, since the
// slave fd number is only ever handed to the same task that owns the
// master (see design/kernel/wave-iota-pty.md).
//
// See sys_unlockpt.pdx (SC+ 124) for the companion no-op-with-validation
// call; both exist so a straight-ported POSIX pty-opening sequence
// (openpty is itself already a shortcut over open+grantpt+unlockpt+
// ptsname, but pdxterm's ι-03 landing calls sys_openpty directly and
// these two exist for API completeness / any future direct-slave-path
// consumer).

module SysGrantpt = structure {
  pub let SYS_GRANTPT_ERR_EBADF : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF (-9)

  pub let FD_TABLE_MAX : u64 = 32
  // fd_table PTY tag bits -- duplicated locally per this tree's
  // cross-module-let-does-not-resolve-at-parse-time discipline. Canonical
  // source: kind_pty.pdx.
  pub let PTY_FD_TAG      : u64 = 0x8000
  pub let PTY_FD_SIDE_BIT : u64 = 0x20

  // ==========================================================================
  // sys_grantpt_body — validate master_fd is a live PTY master fd
  //
  // Input:
  //   rdi = current    (task_struct*, must be non-NULL)
  //   rsi = master_fd  (u64)
  //
  // Output:
  //   rax = 0                              on success
  //   rax = 0xFFFFFFFFFFFFFFF7 (-EBADF)    if master_fd >= 32,
  //         fd_table[master_fd] == 0 (not open), the entry is not
  //         PTY-tagged, or its side bit names the SLAVE (not the master)
  // ==========================================================================
  pub let sys_grantpt_body : (u64, u64) -> u64 !{mem} @{} =
    fn (current: u64) (master_fd: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave iota (ι-02): sys_grantpt -- structural validity check only (see file header). Two-push prologue (rbx=current, r12=master_fd) leaves rsp%16==0 for the nested fd_get call (entry rsp%16==8, 2 pushes -> 8+16=24, %16==8; sub rsp,8 -> %16==0). Phase 1: bounds-check master_fd < 32 -> -EBADF. Phase 2: fd_get(current, master_fd) -> entry; 0 -> -EBADF (fd not open). Phase 3: pty_fd_entry_is_pty(entry) -> 0 -> -EBADF (a real vfs fd is not a pty). Phase 4: pty_fd_entry_side(entry) -> 1 (slave) -> -EBADF (grantpt is a master-side operation; POSIX grantpt is called with the master fd returned by posix_openpt/openpty, never the slave). Success: no state mutation of any kind -- there is no ownership model to change (see file header). Labels prefixed sys_grantpt_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                        // current
        mov r12, rsi;                        // master_fd

        cmp r12, 32;
        jae sys_grantpt_ebadf;

        mov rdi, rbx;
        mov rsi, r12;
        call fd_get;
        cmp rax, 0;
        je  sys_grantpt_ebadf;

        mov rdi, rax;
        call pty_fd_entry_is_pty;
        cmp rax, 0;
        je  sys_grantpt_ebadf;

        mov rdi, rbx;
        mov rsi, r12;
        call fd_get;
        mov rdi, rax;
        call pty_fd_entry_side;
        cmp rax, 0;                          // 0 == master
        jne sys_grantpt_ebadf;

        xor rax, rax;
        jmp sys_grantpt_done;

      sys_grantpt_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF

      sys_grantpt_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
