// src/kernel/core/syscall/handlers/sys_framebuffer_map.pdx -- R105.M2-002
//
// sys_framebuffer_map(fb_cap_slot, user_va, len) -> lfb_va | -errno
//
// Sysno 110. Given a KIND_FRAMEBUFFER cap the caller holds, return the
// kernel VA (lfb_va) of the mapped LFB. The `user_va` and `len` args
// are RESERVED for a future round in which the LFB is re-mapped into
// the caller's user PML4 at user_va -- at R105 the LFB already sits at
// its kernel-VA mapping (established by the R101 fb_map / bochs_stdvga
// lfb_map path) and the compositor consumes it from ring-0. A proper
// PML4-shared mapping into ring-3 requires a per-task page-table
// walker not yet available (target R106 with the mmap syscall family).
//
// Rights required: R_FB_MAP (0x001). -EACCES if absent.
// Refuse fb_cap_slot pointing at anything other than KIND_FRAMEBUFFER
// with -EBADF.

module SysFramebufferMap = structure {

  pub let SYSFBM_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYSFBM_ERR_EACCES : u64 = 0xFFFFFFFFFFFFFFF3
  pub let SYSFBM_ERR_EIO    : u64 = 0xFFFFFFFFFFFFFFFB

  pub let sys_framebuffer_map_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (fb_cap_slot: u64) (user_va: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M2-002 (sysno 110): resolve fb_cap_slot -> fb_row_id via cap_table (kind gate + R_FB_MAP rights gate), then read lfb_va from the row via fb_row_lfb_va. user_va and len are accepted for forward-compat (a future R106 mmap wire-in maps the LFB into the caller's PML4 at user_va for len bytes; today the caller consumes lfb_va directly from ring-0). Register plan: rbx=fb_cap_slot, r12=fb_row_id. 2 callee-save pushes + sub rsp,8 pad: rsp%16==0. Labels prefixed sysfbm_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // fb_cap_slot

        cmp rbx, 256;
        jae sysfbm_ebadf;

        // Read cap_table descriptor.
        lea rax, [rip + cap_table];
        mov r10, rbx;
        shl r10, 3;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        add rax, r10;

        // Kind check.
        mov r10, [rax + 0];
        mov r11, 0x1AF;                  // KIND_FRAMEBUFFER
        cmp r10, r11;
        jne sysfbm_ebadf;

        // Rights check: R_FB_MAP (0x001).
        mov r10, [rax + 8];
        mov r11, 0x001;
        and r10, r11;
        cmp r10, r11;
        jne sysfbm_eacces;

        // Target -> fb_row_id.
        mov r10, [rax + 16];
        and r10, 0xFF;
        mov r12, r10;

        // Read lfb_va from the fb row.
        mov rdi, r12;
        call fb_row_lfb_va;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  sysfbm_eio;

        // rax already holds lfb_va.
        jmp sysfbm_out;

      sysfbm_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sysfbm_out;
      sysfbm_eacces:
        mov rax, 0xFFFFFFFFFFFFFFF3;
        jmp sysfbm_out;
      sysfbm_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;

      sysfbm_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
