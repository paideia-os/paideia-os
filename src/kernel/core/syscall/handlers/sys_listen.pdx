// src/kernel/core/syscall/handlers/sys_listen.pdx — R72.M1-005 (#1927)
//
// sys_listen(fd, backlog) -> 0 | -errno. SC+ ID 89. backlog is accepted
// but ignored -- the MVP backlog is exactly one pending connection per
// listener (net/tcp.pdx's backlog_pending_tcb single-slot field); a
// deeper accept queue is future work once a real server workload needs
// one.

module SysListen = structure {

  pub let SYS_LISTEN_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_LISTEN_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)

  pub let sys_listen_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, backlog: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_listen, SC+ ID 89. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. Requires TCP_ST_CLOSED (@+0 == 0, a connected or already-listening socket cannot re-listen) AND a non-zero local_port (@+8 != 0 -- listen() before bind() is refused rather than silently listening on port 0). On success: stamps state = TCP_ST_LISTEN(1) directly (this function owns that transition, not tcp.pdx, since it is purely a local API-driven state change with no segment to send) and calls tcp_socket_retag_listener(fd) to flip the cap_table descriptor's kind from KIND_TCP_SOCKET to KIND_TCP_LISTENER over the same tcb_idx. 1-push callee-save (rbx=fd): entry rsp%16==8, one push lands rsp%16==0 directly, so both nested calls (tcp_socket_resolve, tcp_socket_retag_listener) need no further pad. Reserved labels: sys_listen_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        mov rsi, 0x1AB;                       // KIND_TCP_SOCKET (fix#2005)
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_listen_ebadf;

        mov rcx, rax;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;

        mov rdx, [rcx + 0];
        cmp rdx, 0;
        jne sys_listen_einval;
        mov rdx, [rcx + 8];
        cmp rdx, 0;
        je sys_listen_einval;

        mov rdx, 1;                            // TCP_ST_LISTEN
        mov [rcx + 0], rdx;

        mov rdi, rbx;
        call tcp_socket_retag_listener;

        xor rax, rax;
        jmp sys_listen_done;

      sys_listen_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_listen_done;

      sys_listen_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      sys_listen_done:
        pop rbx;
        ret
      }
    }
}
