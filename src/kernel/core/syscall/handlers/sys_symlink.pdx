// src/kernel/core/syscall/handlers/sys_symlink.pdx -- Wave λ (λ-03)
//
// SYS_SYMLINK -- ring-3 symlink syscall body + dispatch shim (sysno 125).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Wave λ filesystem improvement plan (α-τ), item λ-03:
//
//   "sys_symlink(target: *u8, linkpath: *u8) -> u64.  Sysno 125 (fresh,
//    above the current cmp rdi, 124 bounds gate; Linux convention 88 is
//    already claimed by sys_bind).  Body: path_resolve linkpath's parent
//    + basename, call vfs_symlink op with target string.  Return 0 on
//    success, -EEXIST if linkpath exists, -EACCES if backend refuses."
//
// The Wave λ landing widened dispatch.pdx's bounds check from 124 to 126
// and added two new cmp/je arms (125 -> dispatch_symlink, 126 ->
// dispatch_readlink); the dispatch layer's per-backend routing continues
// to flow through the vops table's new tail slots (VOPS_SYMLINK_OFFSET
// = 104, VOPS_READLINK_OFFSET = 96) which each backend populates in its
// own _*_vops_init.  tmpfs wires real adapters (_tmpfs_symlink_adapter,
// _tmpfs_readlink_adapter with a 65 KiB side pool); pdxfs_lite and
// pdxfs_block wire refusal stubs (VOPS_ERR_NOT_SUPPORTED / MOUNT_BACKEND_
// UNKNOWN) pending their own on-disk symlink data walkers.
//
// -----------------------------------------------------------------------------
// Composition
// -----------------------------------------------------------------------------
//
// sys_symlink_body:
//   (1) Cap both user path lens at SYS_SYMLINK_PATH_MAX-1 = 255; if 0,
//       bump to 1 (walker headroom).  Widen each cap by +1 to include
//       the NUL terminator (walker cap contract, see paideia-os #2435).
//   (2) user_read_str_via_walk(target_va, &_sys_symlink_target_scratch,
//       cap) -> strlen or 0 on fault.  0 -> -EFAULT.  Save strlen.
//   (3) user_read_str_via_walk(linkpath_va, &_sys_symlink_link_scratch,
//       cap) -> strlen or 0 on fault.  0 -> -EFAULT.  Save strlen.
//   (4) Locate the last '/' in the link scratch (backward-tracking mov_b
//       scan).  No slash -> -ENOENT.  NUL-terminate at slash offset.
//       basename_ptr = &link_scratch + slash_off + 1.  basename_len =
//       link_strlen - slash_off - 1.  Empty basename -> -ENOENT.
//   (5) mount_root_vnode() -> root_idx.  0 -> -ENOENT.
//   (6) path_resolve(&link_scratch, root_idx, cwd from TASK_OFF_CWD +160)
//       -> parent_vnode_idx.  0 -> -ENOENT.
//   (7) vnode_slot(parent_vnode_idx) -> &parent_vnode.
//   (8) vops_symlink(&parent_vnode, basename_ptr, basename_len,
//       target_ptr = &target_scratch, target_len) -> 0 on success or a
//       backend errno / VOPS_ERR_NOT_SUPPORTED sentinel.  Non-zero maps
//       to -EACCES for ring-3 (matches the task's own errno taxonomy).
//   (9) Return 0.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
//   0                            -- success
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- walker rejected either user buffer
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- missing '/' in linkpath, empty
//                                    basename, missing mount root, or
//                                    path_resolve returned 0
//   0xFFFFFFFFFFFFFFF3 (-EACCES) -- backend refused (tmpfs collision /
//                                    OOM; pdxfs refusal stub)
//
// The task brief also names -EEXIST as a taxonomy entry, but at this
// landing the backend adapter (tmpfs_symlink) folds collision into its
// 0-return path (via tmpfs_create's own collision refusal) which reaches
// us as VOPS_ERR_NOT_SUPPORTED and lands in the -EACCES bucket.  A
// follow-up wave that widens vops errno propagation splits collision
// out into its own -EEXIST bucket.
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// !{mem, sysreg} @{cap} -- identical shape to sys_mkdir_body / sys_
// unlink_body.  mem covers path_resolve + vops_symlink; sysreg covers
// the two user_read_str_via_walk calls; cap is forward-compat for a
// per-mount VOL_RIGHT gate.
//
// -----------------------------------------------------------------------------
// Reserved-label / mov_b / test discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `syslnk_` (symmetric to sysmk_ / sysrm_ / sysstat_
// convention).  No `test` mnemonic.  mov_b for the last-slash scan and
// NUL-terminate step, proven idioms in sys_mkdir / sys_rmdir / tmpfs
// helpers.

module SysSymlink = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_SYMLINK_OK          : u64 = 0
  pub let SYS_SYMLINK_ERR_ENOENT  : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_SYMLINK_ERR_EFAULT  : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYS_SYMLINK_ERR_EACCES  : u64 = 0xFFFFFFFFFFFFFFF3

  pub let SYS_SYMLINK_PATH_MAX    : u64 = 256

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall path bounce scratches.  Same discipline as
  // _sys_mkdir_path_scratch and _sys_stat_path_scratch: the syscall body
  // walks the user path into these .bss buffers under kernel CR3, then
  // hands the kernel VA to path_resolve / vops_symlink.  Single-flow at
  // Wave λ (no concurrent sys_symlink callers on the smoke path).
  pub let mut _sys_symlink_target_scratch : [u8; 256] = uninit @align(8)
  pub let mut _sys_symlink_link_scratch   : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_symlink_body(target_va, linkpath_va) -> u64
  //
  // SysV: rdi = target_va, rsi = linkpath_va
  //   -> rax = 0 on success, or -EFAULT / -ENOENT / -EACCES sentinel.
  //
  // Register plan (6-push callee-save):
  //   rbx = target strlen               (survives all nested calls;
  //                                       consumed as vops_symlink arg4)
  //   r12 = linkpath_va (raw) → root_idx after step 5
  //   r13 = link strlen                 (dead post step 4)
  //   r14 = basename_ptr
  //   r15 = basename_len
  //   rbp = target_va (raw) → dead post walker step 2 (needed only to
  //                                                     pass through
  //                                                     the read-str walker)
  //
  // Alignment: 6 pushes (48 B) + entry rsp%16==8 → 8+48 = 56, %16==8.
  // Add `sub rsp, 8` for nested-call alignment (%16 → 0).  Symmetric
  // `add rsp, 8` before the 6 pops.  Matches sys_openpty_body / sys_
  // execve_shim discipline for 6+pad prologues.
  // ==========================================================================
  pub let sys_symlink_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (target_va: u64) (linkpath_va: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "Wave λ (λ-03): sys_symlink body -- ring-3 symlink syscall (sysno 125). Walks both user paths (target + linkpath) into distinct kernel .bss scratches via user_read_str_via_walk, splits the linkpath scratch into parent-path + basename in place (last-slash scan + NUL-write), resolves the parent via mount_root_vnode + path_resolve (cwd from TASK_OFF_CWD), dispatches through the Wave λ vops_symlink slot (VOPS_SYMLINK_OFFSET=104) to the per-backend adapter. 6-push callee-save prologue (rbp=target_va, rbx=target_strlen, r12=multi-role linkpath_va→root_idx, r13=link_strlen, r14=basename_ptr, r15=basename_len) + sub rsp,8 lands rsp%16==0 (entry %16==8 + 48 + 8 = 64, %16==0) which is SysV-correct at nested call sites. Body: (1) Cap both path_lens at SYS_SYMLINK_PATH_MAX-1=255; bump 0→1; widen +1 for NUL (walker contract, #2435). (2) user_read_str_via_walk(target_va, &_sys_symlink_target_scratch, cap) -> rax = strlen or 0. 0 -> EFAULT. Save into rbx. (3) user_read_str_via_walk(linkpath_va, &_sys_symlink_link_scratch, cap) -> rax = strlen or 0. 0 -> EFAULT. Save into r13. (4) Backward-tracking last-slash scan in _sys_symlink_link_scratch [0..r13); rcx holds last-seen offset or -1 sentinel. -1 -> ENOENT. mov_b NUL-terminate at slash. basename_ptr = &scratch + rcx + 1 -> r14. basename_len = r13 - rcx - 1 -> r15. r15==0 -> ENOENT. (5) mount_root_vnode -> root_idx; 0 -> ENOENT. Save into r12. (6) path_resolve(&_sys_symlink_link_scratch, r12, cwd) -> parent_vnode_idx; 0 -> ENOENT. (7) vnode_slot -> &parent_vnode. (8) vops_symlink(&parent_vnode, r14=basename_ptr, r15=basename_len, &_sys_symlink_target_scratch=target, rbx=target_len). Non-zero -> EACCES. (9) rax=0; jmp done. Failure arms: syslnk_efault / syslnk_enoent / syslnk_eacces each set rax before jmp done. Labels prefixed syslnk_ (distinct from sysmk_ / sysrm_ / sysstat_). Encoder discipline: no test; no `add reg, [mem]` / `sub reg, [mem]`; all mem-derived values through registers first; mov_b for byte load/store; no 2-op imul; no neg mnemonic; no cmp against imm > 0xFFFFFFFF (uses `cmp rcx, 0xFFFFFFFFFFFFFFFF` which the encoder accepts as sign-extended -1 imm8 form per vnode_alloc.pdx L108's own note).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;
        // 6 pushes (48) + sub 8 = 56, entry rsp%16==8 + 56 = 64, %16==0
        // at nested call sites (SysV requirement).

        mov rbp, rdi;                    // rbp = target_va (raw)
        mov r12, rsi;                    // r12 = linkpath_va (raw)

        // ---- (1) Cap target_va path_len ----
        // For the walker we pass a cap of SYS_SYMLINK_PATH_MAX = 256
        // (cap includes NUL per walker contract, #2435).  Since the
        // caller passes only a pointer (no length hint), we use the
        // full 256 cap for both scratches.
        mov r10, 256;                    // walker cap (PATH_MAX incl. NUL)

        // ---- (2) user_read_str_via_walk(target_va, target_scratch, cap) ----
        mov rdi, rbp;                    // arg0 = user target_va
        lea rsi, [rip + _sys_symlink_target_scratch];
        mov rdx, r10;                    // arg2 = cap
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  syslnk_efault;
        mov rbx, rax;                    // rbx = target_strlen (survives)

        // Refuse zero-length target (a symlink to "" has no meaning).
        cmp rbx, 0;
        je  syslnk_enoent;

        // ---- (3) user_read_str_via_walk(linkpath_va, link_scratch, cap) ----
        mov rdi, r12;                    // arg0 = user linkpath_va
        lea rsi, [rip + _sys_symlink_link_scratch];
        mov rdx, 256;                    // arg2 = cap
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  syslnk_efault;
        mov r13, rax;                    // r13 = link_strlen

        // ---- (4) Locate last '/' in link scratch [0..r13) ----
        //   rcx = last-seen slash offset (sentinel -1 = no slash)
        //   r9  = current scan index
        //   r8  = current byte
        //   r10 = &link_scratch
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        xor r9, r9;
        lea r10, [rip + _sys_symlink_link_scratch];

      syslnk_scan_top:
        cmp r9, r13;
        jae syslnk_scan_done;
        xor r8, r8;
        mov_b r8, [r10 + r9*1];
        cmp r8, 0x2F;                    // '/'
        jne syslnk_scan_next;
        mov rcx, r9;                     // remember last slash offset
      syslnk_scan_next:
        add r9, 1;
        jmp syslnk_scan_top;

      syslnk_scan_done:
        cmp rcx, 0xFFFFFFFFFFFFFFFF;
        je  syslnk_enoent;

        // NUL-terminate the parent-path portion at [scratch + rcx].
        xor r8, r8;
        mov_b [r10 + rcx*1], r8;

        // basename_ptr = &scratch + rcx + 1.
        mov r14, r10;
        add r14, rcx;
        add r14, 1;

        // basename_len = r13 - rcx - 1 (register-only per encoder gap).
        mov r15, r13;
        sub r15, rcx;
        sub r15, 1;
        cmp r15, 0;
        je  syslnk_enoent;

        // ---- (5) mount_root_vnode() ----
        call mount_root_vnode;
        cmp rax, 0;
        je  syslnk_enoent;
        mov r12, rax;                    // r12 = root_idx (linkpath_va dead)

        // ---- (6) path_resolve(kernel_parent_path, root_idx, cwd) ----
        // R86.M1-005 (#1958): cwd from TASK_OFF_CWD (+160).
        lea rdi, [rip + _sys_symlink_link_scratch];
        mov rsi, r12;                    // root_idx
        mov rax, [rip + _current_tcb];
        mov rdx, [rax + 160];            // cwd
        call path_resolve;               // rax = parent_vnode_idx or 0
        cmp rax, 0;
        je  syslnk_enoent;

        // ---- (7) vnode_slot(parent_vnode_idx) -> &parent_vnode ----
        mov rdi, rax;
        call vnode_slot;                 // rax = &parent_vnode

        // ---- (8) vops_symlink(&parent_vnode, name_ptr, name_len,
        //                       target_ptr, target_len) ----
        mov rdi, rax;                    // arg0 = &parent_vnode
        mov rsi, r14;                    // arg1 = basename_ptr
        mov rdx, r15;                    // arg2 = basename_len
        lea rcx, [rip + _sys_symlink_target_scratch]; // arg3 = target_ptr
        mov r8, rbx;                     // arg4 = target_len
        call vops_symlink;               // rax = 0 or backend errno
        cmp rax, 0;
        jne syslnk_eacces;

        // ---- (9) Success return ----
        xor rax, rax;                    // SYS_SYMLINK_OK = 0
        jmp syslnk_done;

      syslnk_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp syslnk_done;

      syslnk_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT
        jmp syslnk_done;

      syslnk_eacces:
        mov rax, 0xFFFFFFFFFFFFFFF3;     // -EACCES

      syslnk_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
