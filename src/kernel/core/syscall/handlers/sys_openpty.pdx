// src/kernel/core/syscall/handlers/sys_openpty.pdx -- Wave iota (ι-02,
// paideia-os pdxterm real-body wave)
//
// sys_openpty(rows, cols) -> packed (master_fd | slave_fd<<8 | cap_slot<<16)
//                            or a negative errno. SC+ ID 122.
//
// Composes kind_pty.pdx's pty_cap_mint (row + cap allocation) with two
// fd_table.pdx fd_alloc/fd_set calls (master then slave) and a final
// pty_row_set_fds to record both fd numbers back into the row -- the
// same "vfs_open + fd_alloc + fd_set" composition shape sys_open.pdx
// (#587) established, generalised to a two-fd allocation with a mint
// step instead of a vfs_open.
//
// fd_table entry encoding for a PTY-tagged fd (see kind_pty.pdx SECTION
// 3 "fd_table PTY tag"):
//   bit 15        PTY_FD_TAG (1 == this is a pty fd, not a vfs vnode_idx)
//   bit 5         side: 0 = master, 1 = slave
//   bits [4:0]    row_id (0..31)
// vnode_idx (a real vfs-backed fd's low-16 field) never reaches bit 15
// since VNODE_MAX = 256 (fs/vnode_pool.pdx), so this tag can never
// collide with a live vfs fd.
//
// Cleanup on partial failure: if pty_cap_mint succeeds but the master
// fd_alloc fails (EMFILE, fd_table full), or the master fd_alloc
// succeeds but the slave fd_alloc fails, this body unwinds everything
// it already committed (the master fd_table slot, the minted cap, and
// the pty row) before returning -EMFILE, so a partial-failure caller
// never observes a live row with an unreachable cap or a claimed fd
// slot with no corresponding pty state -- same "never leak a live
// resource behind a refused allocation" discipline kind_a11y_node.pdx's
// mint uses for its own ENOSPC_SLOT unwind.
//
// See design/kernel/wave-iota-pty.md for the full contract.

module SysOpenpty = structure {
  pub let SYS_OPENPTY_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let SYS_OPENPTY_ERR_EMFILE : u64 = 0xFFFFFFFFFFFFFFE8   // -EMFILE (-24)

  pub let FD_TABLE_MAX : u64 = 32          // matches fd_table.pdx:9

  // fd_table PTY tag bits -- duplicated locally per this tree's
  // cross-module-let-does-not-resolve-at-parse-time discipline (see
  // sys_kill.pdx's TASK_STATE_* duplicates for the precedent). Canonical
  // source: kind_pty.pdx.
  pub let PTY_FD_TAG      : u64 = 0x8000
  pub let PTY_FD_SIDE_BIT : u64 = 0x20

  // ==========================================================================
  // sys_openpty_body — pty_cap_mint + fd_alloc(x2) + fd_set(x2) + row wire
  //
  // Input:
  //   rdi = current  (task_struct*, must be non-NULL)
  //   rsi = rows     (u64, forwarded to pty_cap_mint)
  //   rdx = cols     (u64, forwarded to pty_cap_mint)
  //
  // Output:
  //   rax = master_fd | (slave_fd << 8) | (cap_slot << 16)   on success
  //   rax = 0xFFFFFFFFFFFFFFEA (-EINVAL)  if pty_cap_mint refused (bad
  //         rows/cols, row-pool exhaustion, or cap_table exhaustion --
  //         all three collapse to the same PTY_MINT_FAILED sentinel at
  //         the kind_pty.pdx layer, so this body cannot distinguish
  //         them; EINVAL is the closest single POSIX-shaped code)
  //   rax = 0xFFFFFFFFFFFFFFE8 (-EMFILE) if either fd_alloc call has no
  //         free slot
  //
  // Side effects on success: one pty row claimed and wired with both fd
  //   numbers; one cap_table slot minted as KIND_PTY; current->fd_table
  //   [master_fd] and [dst_fd] populated with PTY-tagged entries.
  // ==========================================================================
  pub let sys_openpty_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (current: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "Wave iota (ι-02): sys_openpty -- pty_cap_mint + fd_alloc(master) + fd_set(master) + fd_alloc(slave) + fd_set(slave) + pty_row_set_fds. 3-arg SysV entry. rdi=current, rsi=rows, rdx=cols. Five-push prologue (rbx=current, r12=row_id, r13=cap_slot, r14=master_fd, r15=slave_fd) -- ODD push count, so entry rsp%16==8 flips directly to rsp%16==0 for every nested call (mirrors cap_handler_seat.pdx's / cap_handler_pty.pdx's identical odd-push-count reasoning); no stack push/pop needed anywhere in the body since every live value across a call has its own callee-save home. Phase 1: pty_cap_mint(rows, cols) -> rax = row_id | (slot << 8), or PTY_MINT_FAILED (0xFFFFFFFFFFFFFFFF, staged via mov r10,imm64 + cmp per this tree's imm64-compare discipline) -> -EINVAL. On success: r12 = rax & 0xFF (row_id), r13 = (rax >> 8) & 0xFF (cap_slot). Phase 2: fd_alloc(current) -> master_fd or -1; cmp rax,32;jae -> -EMFILE, unwinding the mint (cap_mint_write(slot,0,0,0) to scrub the cap descriptor back to KIND_NULL, then pty_tail_free(row_id)) before returning. Phase 3: fd_set(current, master_fd, PTY_FD_TAG | row_id) -- side bit 0 (master). Phase 4: fd_alloc(current) again -> slave_fd (stashed in r15 immediately); on -EMFILE, additionally fd_set(current, master_fd, 0) to release the master slot before the same mint-unwind as Phase 2. Phase 5: fd_set(current, slave_fd, PTY_FD_TAG | PTY_FD_SIDE_BIT | row_id) -- side bit 1 (slave). Phase 6: pty_row_set_fds(row_id, master_fd, slave_fd). Phase 7: pack return = master_fd | (slave_fd << 8) | (cap_slot << 16) -- all three bounded well under their byte-field ceilings (fd < 32, slot < 256), no truncation risk. Register discipline: rbx(current)/r12(row_id)/r13(cap_slot)/r14(master_fd)/r15(slave_fd) callee-save-preserved through every nested call. rax/rcx/rdx/rdi/rsi/r8/r9/r10/r11 caller-save scratch. Effects {mem,sysreg}: mem for every fd_table/cap_table/row write; sysreg transitively from pty_cap_mint's own cap_mint_write path (defensive parity, matching every other syscall body in this tree that calls a mint primitive). Capability {cap}: pty_cap_mint mints a capability.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = current

        // Phase 1: pty_cap_mint(rows, cols)
        mov rdi, rsi;                        // rows
        mov rsi, rdx;                        // cols
        call pty_cap_mint;                   // rax = row_id | (slot<<8) | FAILED

        mov r10, 0xFFFFFFFFFFFFFFFF;         // PTY_MINT_FAILED
        cmp rax, r10;
        je  sys_openpty_einval;

        mov r12, rax;
        and r12, 0xFF;                       // r12 = row_id
        mov r13, rax;
        shr r13, 8;
        and r13, 0xFF;                       // r13 = cap_slot

        // Phase 2: fd_alloc(current) -> master_fd
        mov rdi, rbx;
        call fd_alloc;
        cmp rax, 32;
        jae sys_openpty_unwind_mint;

        mov r14, rax;                        // r14 = master_fd

        // Phase 3: fd_set(current, master_fd, PTY_FD_TAG | row_id)
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, r12;
        mov r10, 0x8000;                     // PTY_FD_TAG
        or  rdx, r10;
        call fd_set;

        // Phase 4: fd_alloc(current) -> slave_fd
        mov rdi, rbx;
        call fd_alloc;
        cmp rax, 32;
        jae sys_openpty_unwind_master;

        mov r15, rax;                        // r15 = slave_fd

        // Phase 5: fd_set(current, slave_fd, PTY_FD_TAG | PTY_FD_SIDE_BIT | row_id)
        mov rdi, rbx;
        mov rsi, r15;
        mov rdx, r12;                         // row_id
        mov r10, 0x8020;                      // PTY_FD_TAG | PTY_FD_SIDE_BIT
        or  rdx, r10;
        call fd_set;

        // Phase 6: pty_row_set_fds(row_id, master_fd, slave_fd)
        mov rdi, r12;
        mov rsi, r14;
        mov rdx, r15;
        call pty_row_set_fds;

        // Phase 7: pack master_fd | (slave_fd << 8) | (cap_slot << 16)
        mov rcx, r15;                        // slave_fd
        shl rcx, 8;
        mov rax, r14;                        // master_fd
        or  rax, rcx;
        mov rcx, r13;                        // cap_slot
        shl rcx, 16;
        or  rax, rcx;
        jmp sys_openpty_done;

      sys_openpty_unwind_master:
        // Slave fd_alloc failed; release the master slot, then fall
        // straight through into the shared mint-unwind below.
        mov rdi, rbx;
        mov rsi, r14;
        xor rdx, rdx;
        call fd_set;

      sys_openpty_unwind_mint:
        // Scrub the minted cap back to KIND_NULL, then free the row.
        mov rdi, r13;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        mov rdi, r12;
        call pty_tail_free;
        mov rax, 0xFFFFFFFFFFFFFFE8;         // -EMFILE
        jmp sys_openpty_done;

      sys_openpty_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;         // -EINVAL

      sys_openpty_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
