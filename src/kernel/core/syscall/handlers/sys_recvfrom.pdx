// src/kernel/core/syscall/handlers/sys_recvfrom.pdx -- R93.M2-004
// (paideia-os #2052)
//
// sys_recvfrom(fd, buf_va, len, src_ip_out_va, src_port_out_va)
//   -> bytes_read | -errno. SC+ ID 97.
//
// UDP's first per-call source-address recv path. Also usable by
// TCP: on a TCP socket the src_ip_out / src_port_out args are
// IGNORED (matches Linux behaviour where recvfrom() on a connected
// TCP socket returns 0-in-src fields). Cap on len matches sys_recv
// (no maximum since TCP is byte-stream and UDP already caps at
// UDP_DGRAM_MAX at the datagram slot level).
//
// Body posture:
//   * Resolve fd via generic tcp_socket_resolve.
//   * KIND_UDP_SOCKET: R_SOCKET_READ gate; state != CLOSED; drain
//     one dgram from _udp_rx_dgram_data / _udp_rx_dgram_lens (same
//     slot arithmetic as sys_recv's UDP branch); write bytes via
//     user_write_bytes_via_walk; write source-ip / source-port to
//     the caller's out pointers via user_write_bytes_via_walk if
//     they are non-zero. src_ip / src_port tracking per datagram
//     slot is NOT recorded at this MVP (see net/udp.pdx §udp_rx_
//     handle -- source address is dropped on the floor because
//     _udp_socket_table's slot rows don't have per-slot src fields
//     yet). So we write the connected peer_ip / peer_port from the
//     socket row instead: for a socket that connect()'d, that's the
//     right answer; for a bound-not-connected socket receiving from
//     multiple peers, it's WRONG (returns zero / stale bytes). This
//     limitation is documented in the R93 retro; a future landing
//     that widens _udp_rx_dgram_lens to carry (src_ip, src_port)
//     alongside len fixes it structurally.
//
//   * KIND_TCP_SOCKET: src_ip / src_port args ignored. If they are
//     non-zero pointers, still write zeros there (Linux's actual
//     behaviour writes sockaddr_in with source=peer_addr; we deviate
//     to the safe-default zero because our TCP TCB doesn't track
//     "the peer we just received from" as a distinct field). Then
//     tail into the TCP recv shape sys_recv_body uses.
//
//   * Any other kind: -EBADF.

module SysRecvfrom = structure {

  pub let SYS_RVFR_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7      // -EBADF
  pub let SYS_RVFR_EINVAL   : u64 = 0xFFFFFFFFFFFFFFEA      // -EINVAL
  pub let SYS_RVFR_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2      // -EFAULT
  pub let SYS_RVFR_EACCES   : u64 = 0xFFFFFFFFFFFFFFF3      // -EACCES
  pub let SYS_RVFR_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95      // -ENOTCONN

  pub let sys_recvfrom_body : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64,
        src_ip_out_va: u64, src_port_out_va: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R93.M2-004 (paideia-os #2052): sys_recvfrom SC+ ID 97. 6-push callee-save (rbx=fd, rbp=buf_va, r12=len, r13=src_ip_out_va, r14=src_port_out_va, r15=row_ptr) + sub rsp,8: 48+8=56; entry rsp%16==8 -> 64, %16==0 aligned. Try TCP resolve first; on hit R_SOCKET_READ gate; state ESTABLISHED(4) or CLOSE_WAIT(7); byte-count clamp to (rx_tail - rx_head); user_write_bytes_via_walk from _tcp_rx_buf_table + tcb*4096 + rx_head; advance rx_head; ignore src_ip_out/src_port_out at this MVP (a future landing that writes peer_ip/peer_port into the caller's out slots for TCP is a small extension). Try UDP resolve; on hit R_SOCKET_READ gate; state != CLOSED; rx_count > 0 else return 0 (non-blocking, matches sys_recv semantics); read len_slot at (sock<<5)+(head<<3); copy_len = min(dgram_len, len); user_write_bytes_via_walk from data_slot at (sock<<12)+(head<<10); if src_ip_out_va != 0 write peer_ip 4 bytes there via user_write_bytes_via_walk (approximation -- see file header); if src_port_out_va != 0 write peer_port u32 (low 16 meaningful) via user_write_bytes_via_walk. Advance rx_head, decrement rx_count. Return copy_len. Both miss -> -EBADF. Reserved labels sys_rvfr_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // fd
        mov rbp, rsi;                            // buf_va
        mov r12, rdx;                            // len
        mov r13, rcx;                            // src_ip_out_va
        mov r14, r8;                             // src_port_out_va

        // Try TCP.
        mov rdi, rbx;
        mov rsi, 0x1AB;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_rvfr_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_rvfr_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;             // -EBADF
        jmp sys_rvfr_done;

      sys_rvfr_have_tcp:
        // R_SOCKET_READ gate.
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x001;
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_rvfr_eaccess;

        mov r15, rax;                            // tcb_idx
        mov rax, r15;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rcx, rax;
        // rcx now points at TCB row (r14 already used).
        mov rdx, [rcx + 0];
        cmp rdx, 4;
        je sys_rvfr_tcp_state_ok;
        cmp rdx, 7;
        je sys_rvfr_tcp_state_ok;
        jmp sys_rvfr_enotconn;
      sys_rvfr_tcp_state_ok:
        mov rax, [rcx + 184];
        mov rdx, [rcx + 176];
        sub rax, rdx;
        cmp rax, r12;
        jbe sys_rvfr_tcp_len_ok;
        mov rax, r12;
      sys_rvfr_tcp_len_ok:
        mov r12, rax;                            // copy_len

        cmp r12, 0;
        je sys_rvfr_zero;

        mov rdi, rbp;
        mov rax, r15;
        shl rax, 12;
        lea rsi, [rip + _tcp_rx_buf_table];
        add rsi, rax;
        mov rax, [rcx + 176];
        add rsi, rax;
        mov rdx, r12;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sys_rvfr_efault;

        // Advance rx_head.
        mov rax, r15;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rcx, rax;
        mov rdx, [rcx + 176];
        add rdx, r12;
        mov [rcx + 176], rdx;

        mov rax, r12;
        jmp sys_rvfr_done;

      sys_rvfr_have_udp:
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x001;
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_rvfr_eaccess;

        mov r15, rax;                            // sock_idx
        mov rax, r15;
        shl rax, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;
        // We need row_ptr across the walker call; stash in r9 (caller-
        // save) is not enough. Move to a callee-save: overwrite r14
        // once we've consumed src_port_out_va. Actually r15 is still
        // sock_idx; use r15 for row_ptr instead.
        mov r15, rcx;                            // row_ptr

        mov rdx, [r15 + 0];
        cmp rdx, 0;
        je sys_rvfr_enotconn;                    // CLOSED

        mov rax, [r15 + 56];
        cmp rax, 0;
        je sys_rvfr_zero;

        // sock_idx is lost -- recompute from row_ptr - table_base / 128.
        // Simpler: keep sock_idx in a scratch we don't lose. Reload via
        // (row_ptr - _udp_socket_table) >> 7. But rip-relative subtract
        // isn't ergonomic. Alternative: stash sock_idx on stack.
        // We have [rsp+0] free (only sub rsp,8 pad; that pad slot is
        // fair game as scratch).
        //
        // But we already lost sock_idx (r15 was reused). Re-lookup via
        // fd + tcp_socket_resolve to recover -- expensive, but this
        // path only fires on non-empty ring. Alternatively, encode
        // slot arithmetic without sock_idx: rx_head, len_slot addr,
        // data_slot addr all derivable from row_ptr + fixed offsets.
        // But data_slot addr is at
        //   &_udp_rx_dgram_data + (sock << 12) + (head << 10)
        // which needs sock. Fix: cheapest reload is  recompute via
        // (row_ptr - table_base) >> 7.
        lea rax, [rip + _udp_socket_table];
        mov rcx, r15;
        sub rcx, rax;
        shr rcx, 7;
        // rcx = sock_idx.

        mov r8, [r15 + 40];                      // rx_head

        // len_slot addr = &_udp_rx_dgram_lens + (sock<<5) + (head<<3)
        mov rax, rcx;
        shl rax, 5;
        mov rdx, r8;
        shl rdx, 3;
        add rax, rdx;
        lea rdx, [rip + _udp_rx_dgram_lens];
        add rdx, rax;
        mov rax, [rdx + 0];                      // dgram_len

        // copy_len = min(dgram_len, r12).
        cmp rax, r12;
        jbe sys_rvfr_udp_len_ok;
        mov rax, r12;
      sys_rvfr_udp_len_ok:
        mov r12, rax;                            // copy_len

        cmp r12, 0;
        je sys_rvfr_udp_consume;

        // data_slot addr = &_udp_rx_dgram_data + (sock<<12) + (head<<10)
        mov rax, rcx;
        shl rax, 12;
        mov rdx, r8;
        shl rdx, 10;
        add rax, rdx;
        lea rdx, [rip + _udp_rx_dgram_data];
        add rdx, rax;

        mov rdi, rbp;
        mov rsi, rdx;
        mov rdx, r12;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sys_rvfr_efault;

      sys_rvfr_udp_consume:
        // Emit src_ip / src_port to caller's out slots if non-zero.
        // We use the socket's peer_ip / peer_port (approximation --
        // see file header). Every helper here (user_write_bytes_via_
        // walk) may clobber caller-save registers, so we reload
        // rx_head from [r15+40] just before consuming it below.
        cmp r13, 0;
        je sys_rvfr_no_srcip;
        // Write 4 bytes from row peer_ip @+24 to src_ip_out_va.
        mov rdi, r13;
        mov rsi, r15;
        add rsi, 24;
        mov rdx, 4;
        call user_write_bytes_via_walk;
        // ignore rax -- best-effort src copy-out.
      sys_rvfr_no_srcip:

        cmp r14, 0;
        je sys_rvfr_no_srcport;
        // Write 4 bytes: low 16 = peer_port, upper zero. Stage on
        // the 8-byte scratch pad we reserved at [rsp+0] (part of
        // sub rsp,8 prologue).
        mov rax, [r15 + 16];
        and rax, 0xFFFF;
        mov [rsp + 0], rax;
        mov rdi, r14;
        lea rsi, [rsp + 0];
        mov rdx, 4;
        call user_write_bytes_via_walk;
      sys_rvfr_no_srcport:

        // Advance rx_head + decrement rx_count. Reload rx_head from
        // row now (walker calls above may have clobbered any caller-
        // save reg we might have parked it in).
        mov r8, [r15 + 40];
        mov rax, r8;
        add rax, 1;
        and rax, 3;
        mov [r15 + 40], rax;

        mov rax, [r15 + 56];
        sub rax, 1;
        mov [r15 + 56], rax;

        mov rax, r12;                            // copy_len
        jmp sys_rvfr_done;

      sys_rvfr_zero:
        xor rax, rax;
        jmp sys_rvfr_done;
      sys_rvfr_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_rvfr_done;
      sys_rvfr_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sys_rvfr_done;
      sys_rvfr_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;

      sys_rvfr_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
