// src/kernel/core/syscall/handlers/clock_read_ns.pdx — #1582 part A
// sys_clock_read_ns body: ring-3 monotonic wall-clock in nanoseconds.
//
// Contract (SysV, no args):
//   ()  -> rax = nanoseconds since boot (u64, monotonic-non-decreasing).
//
// Two callers matter today:
//
//   (1) The dispatch shim (dispatch.pdx §dispatch_clock_read_ns for sysno 66)
//       forwards the ring-3 syscall unchanged; no user pointer touches this
//       body, so no user_ptr_ok gate is needed and the KPTI bounce pattern
//       used by sys_read/sys_write/sys_dmesg does not apply.
//   (2) The R30 witness (tests/kernel/syscall/clock_read_ns_synth.pdx) calls
//       the body directly to assert monotonicity and non-zero on two back-to-
//       back reads.
//
// Implementation: single tail-call to hpet_now_ns (src/kernel/core/time/
// hpet.pdx §hpet_now_ns), which reads MAIN_COUNTER at counter_base+0xF0 and
// multiplies by _hpet_ctx.period_ns (precomputed at hpet_init time). Falls
// back to rax==0 if hpet_init has not run (hpet_now_ns internally guards
// _hpet_ctx.base==0). At R21+ every boot path calls hpet_init before
// boot_continue_after_ring3 (kernel_main.pdx L238), so a real ring-3 call
// never sees the 0 fallback — the guard is defense-in-depth for early
// witness paths.
//
// Precision: hpet_now_ns's period_ns is integer (period_fs / 10^6), yielding
// exact ns on QEMU q35 (period_fs = 10^7) and ~1.2% error on Intel PCH
// 14.31818 MHz silicon. R22+ can widen the fraction if a precision consumer
// arrives; the AML performance budget (#1087) uses this to convert method
// wall-clock in ns to the < 2 ms target, and the fuel/step budget from
// design/acpi/perf-methodology.md §4 remains the primary bound so ~1% drift
// on ns readings is well within the ceiling that already gates the executor.
//
// [unsafe] — MMIO read of HPET MAIN_COUNTER through hpet_now_ns.
// Audit: design/kernel/kernel-logging-substrate.md (no wire fingerprint;
//        the R30 witness carries the acceptance signal).

module ClockReadNs = structure {
  // ==========================================================================
  // sys_clock_read_ns_body — u64 ns since boot.
  //
  // Leaf-simple tail-call to hpet_now_ns. No args to marshal, no callee-save
  // to preserve — hpet_now_ns is itself leaf (single MMIO load + imul) and
  // callee-save clean per its own justification (src/kernel/core/time/
  // hpet.pdx L246).
  //
  // Alignment: entry rsp % 16 == 8 (SysV call from syscall_dispatch). The
  // `call hpet_now_ns` inside the body pushes an 8-byte RA, presenting the
  // callee at rsp % 16 == 0 — mismatched from the SysV contract callees
  // expect. We add the standard `sub rsp, 8` pad before the call and `add
  // rsp, 8` after, matching the discipline every other body in this
  // directory uses (see sys_dmesg_body's rsp bracketing for the same
  // pattern, and sys_open_body §Phase 1 for the trio-push variant).
  // ==========================================================================
  pub let sys_clock_read_ns_body : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "#1582 part A: ring-3 monotonic time source. Wraps hpet_now_ns (src/kernel/core/time/hpet.pdx §hpet_now_ns) — reads HPET MAIN_COUNTER at counter_base+0xF0 and multiplies by _hpet_ctx.period_ns (precomputed at hpet_init to sidestep the missing `mul r64`). Returns u64 nanoseconds in rax; monotonic-non-decreasing across successive calls (guaranteed by the HPET counter's monotonicity plus the imul truncation staying below 2^63 for uptime under 4000 years at Intel PCH tick rates). Returns 0 as a defensive fallback if hpet_init has not yet run (hpet_now_ns's internal _hpet_ctx.base==0 guard); the R21+ boot ordering means production ring-3 calls never see the 0 case. No user pointers on this syscall — no user_ptr_ok gate, no KPTI bounce, no walker call. Leaf function; hpet_now_ns is itself leaf and callee-save clean, so the single nested `call hpet_now_ns` only needs the standard 8-byte alignment pad to satisfy SysV rsp%16==0 at the call boundary. Effects {mem} for the MMIO read (transitively via hpet_now_ns); capabilities empty because the HPET counter is a read-only wall-clock source — no @{boot} needed at the caller layer (hpet_init's own capability was consumed at boot time). The AML performance budget (#1087) will use this to convert method wall-clock in ns to the < 2 ms target; the fuel/step budget from design/acpi/perf-methodology.md §4 remains the primary bound so wall-clock drift on ns readings stays below the executor's own ceiling.",
      block: {
        sub rsp, 8;                                  // SysV alignment pad
        call hpet_now_ns;                            // rax = ns since boot (or 0 pre-init)
        add rsp, 8;
        ret
      }
    }
}
