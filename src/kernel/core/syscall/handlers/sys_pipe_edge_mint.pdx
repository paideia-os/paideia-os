// src/kernel/core/syscall/handlers/sys_pipe_edge_mint.pdx --
//   R121.M5-followup (paideia-os #2501)
//
// sys_pipe_edge_mint body -- the missing userland-reachable primitive that
// installs a fresh KIND_PIPELINE_EDGE row into the shared cap_table so
// downstream sys_pipe_edge_bind / sys_pipe_edge_send / sys_pipe_edge_recv
// callers actually have a cap_slot to resolve. Before this landing the
// R121.M1 mint helper (pipeline_edge_alloc, src/kernel/core/cap/
// pipeline_edge.pdx §12) was reachable ONLY from the boot witness --
// no cap_invoke op exposes MINT and no syscall wrapped it, so every
// R121.M5 canary observed -EBADF against un-minted slots (documented
// as the CAP-MINT GAP in src/user/pdx_produce.pdx / pdx_consume.pdx
// headers).
//
// Contract (matches src/user/syscall_shim.pdx sys_pipe_edge_mint):
//   sys_pipe_edge_mint(schema_id: u32, role: u8, rights: u16)
//     -> cap_slot (0..255) | -ENOMEM (0xFFFFFFFFFFFFFFF4)
//                          | -EINVAL (0xFFFFFFFFFFFFFFEA)
//
// SC+ ID 133. Dispatched from src/kernel/core/syscall/dispatch.pdx at
// dispatch_pipe_edge_mint, added in the same R121.M5-followup landing.
// Bounds gate widened 132 -> 134 in the same edit.
//
// Sequence (three phases):
//   1. pipeline_edge_alloc(schema_id, role, rights) -> row_id (0..31) or
//      one of {PE_MINT_BAD_SCHEMA=0xFFFFEB8C, PE_MINT_BAD_ROLE=0xFFFFEB8D,
//      PE_MINT_BAD_RIGHTS=0xFFFFEB8E, PE_TAIL_ENOSPC=0xFFFFEB8B}. The
//      three BAD_* sentinels are structural (bad caller args) and fold
//      to -EINVAL; ENOSPC (pool exhausted) folds to -ENOMEM.
//   2. Free-slot scan over cap_table[1..255] for the first descriptor
//      with kind==0 (KIND_NULL). Slot 0 is reserved by convention as a
//      null anchor. If the entire table is occupied, the freshly minted
//      row is freed via pipeline_edge_free (leak-free rollback) and
//      -ENOMEM returns to userland.
//   3. cap_mint_write(slot, KIND_PIPELINE_EDGE=0x1F0, rights,
//      target_ptr=row_id). This publishes the row via the shared
//      cap_mint_write ABI -- byte-for-byte the same pattern
//      sys_framebuffer_create.pdx uses at §step 6 (its own free-slot
//      scan). No cap_owner stamp: cap_mint_write clears the owner to
//      CAP_OWNER_NONE unconditionally; a downstream cap_owner_claim is
//      the caller's job if kernel ownership tracking matters here.
//
// Failure taxonomy:
//   -ENOMEM  (0xFFFFFFFFFFFFFFF4)  pipeline_edge_alloc returned
//                                  PE_TAIL_ENOSPC, or the cap_table
//                                  free-scan ran to slot 256 without
//                                  finding kind==0.
//   -EINVAL  (0xFFFFFFFFFFFFFFEA)  pipeline_edge_alloc returned any
//                                  PE_MINT_BAD_* sentinel (bad
//                                  schema_id/role/rights).
//
// Fingerprint (gated on _fd_hygiene_witness_active -- shared with the
// R119 fd-hygiene / sys_pipe witnesses so this milestone reuses the
// same activation gate rather than minting a new one):
//   "pipe edge mint sc ok slot=<n> row=<n>" via klog_s1_d2. The
//   underlying pipeline_edge_alloc body emits its own
//   "pipe edge mint ok kind=<hex> schema_id=<hex> role=<hex>"
//   fingerprint UNCONDITIONALLY (not witness-gated) from inside its
//   klog_s1_x3 emit path; this syscall's ADDITIONAL "sc ok" line is
//   the syscall-surface acceptance anchor that distinguishes the
//   R121.M5-followup wire from the R121.M1 substrate wire.
//
// Register discipline (3-push callee-save prologue delivers rsp%16==0
// at every nested call site: entry rsp%16==8, +24 -> %16==0):
//   rbx = rights (survives pipeline_edge_alloc + cap_mint_write)
//   r12 = row_id (post-alloc; also survives cap_mint_write)
//   r13 = slot cursor (0..255 scan, then holds picked slot)
//
// paideia-as encoder posture (feedback_pdx_encoder_pitfalls):
//   * No `test rN,rN` -- every gate is `cmp reg, 0` / `cmp reg, imm`.
//   * imm64 sentinels (0xFFFFFFFFFFFFFFF4, 0xFFFFFFFFFFFFFFEA) load
//     directly into rax via `mov rax, imm64` -- the encoder emits
//     the 10-byte movabs (same pattern sys_pipe.pdx L324 uses).
//   * PE_TAIL_ENOSPC (0xFFFFEB8B) staged into r10 before cmp so the
//     32-bit imm sign-extension pitfall is avoided (0xFFFFEB8B as
//     imm32 sign-extends to 0xFFFFFFFFFFFFEB8B which is NOT equal
//     to the u64 return value 0x00000000FFFFEB8B).
//   * cap_table free-scan uses the shl-3 + shl-4 idiom for slot*24
//     (avoids 2-op imul r,imm which paideia-as does not accept).
//   * KIND_PIPELINE_EDGE (0x1F0), R_PE_ALL (0x007) both fit imm32.
//   * Reserved-label prefix `spm_` avoids the `loop`/`if`/`top`/`done`
//     collision class (feedback_paideia_as_reserved_labels).
//
// Design: cited by design/terminal/semantic-shell-materialization-plan
// .md §R121.M5 (the CAP-MINT GAP note). Companion paideia-os#2501
// briefing.

module SysPipeEdgeMint = structure {

  // === Error sentinels (Linux errno u64 sign-extensions) ===
  pub let SPM_ERR_ENOMEM : u64 = 0xFFFFFFFFFFFFFFF4   // -12
  pub let SPM_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -22

  // === Kind identifier (mirrors src/kernel/core/cap/pipeline_edge.pdx §0) ===
  pub let SPM_KIND_PIPELINE_EDGE : u64 = 0x1F0

  // === PE_TAIL_ENOSPC sentinel (mirrors pipeline_edge.pdx §Error codes) ===
  pub let SPM_PE_TAIL_ENOSPC : u64 = 0xFFFFEB8B

  // ==========================================================================
  // sys_pipe_edge_mint_body(schema_id, role, rights) -> u64
  //
  // Input:
  //   rdi = schema_id  (u32-in-u64; low 32 bits meaningful)
  //   rsi = role       (u8-in-u64; 0=PROD, 1=CONS)
  //   rdx = rights     (u16-in-u64; subset of R_PE_ALL = 0x007)
  //
  // Output:
  //   rax = cap_slot (0..255)                on success
  //   rax = SPM_ERR_ENOMEM / SPM_ERR_EINVAL  on the failure taxonomy above
  //
  // Side effects on success:
  //   - one KIND_PIPELINE_EDGE row claimed in _pipeline_edge_table
  //     (pipeline_edge_alloc's own mint fingerprint fires from inside
  //     its body irrespective of the witness gate)
  //   - one cap_table slot occupied with {kind=0x1F0, rights=<caller>,
  //     target_ptr=row_id}
  //   - cap_owner[slot] cleared to CAP_OWNER_NONE (unconditional per
  //     cap_mint_write's own contract at src/kernel/core/cap/mint.pdx L114)
  //
  // Side effects on failure: byte-identical to entry. If alloc succeeded
  // but the cap_table scan exhausted, the row is freed via
  // pipeline_edge_free before -ENOMEM returns (leak-free rollback).
  // ==========================================================================
  pub let sys_pipe_edge_mint_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (schema_id: u64) (role: u64) (rights: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R121.M5-followup (paideia-os #2501): CAP-MINT GAP closure -- the missing userland-reachable KIND_PIPELINE_EDGE constructor. Three-phase composition: (1) pipeline_edge_alloc(schema_id, role, rights) -- the R121.M1 substrate mint that owns its own gate order (schema_valid / role_valid / rights_valid / pe_row_alloc) plus its own klog_s1_x3 fingerprint emit. Returns row_id in [0..31] or one of {PE_MINT_BAD_SCHEMA=0xFFFFEB8C, PE_MINT_BAD_ROLE=0xFFFFEB8D, PE_MINT_BAD_RIGHTS=0xFFFFEB8E, PE_TAIL_ENOSPC=0xFFFFEB8B}. (2) Free-slot scan over cap_table[1..255] for the first entry with kind==0 (KIND_NULL). Slot 0 is reserved as the null anchor by convention. Address compute per-iteration uses the shl-3+shl-4 idiom for slot*24 (byte-for-byte the sys_framebuffer_create.pdx §step-6 scan at L138-153, same stride). (3) cap_mint_write(slot, KIND_PIPELINE_EDGE=0x1F0, rights, target_ptr=row_id) -- the shared publishing primitive documented at src/kernel/core/cap/mint.pdx §cap_mint_write with the same ABI (rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr) every KIND_* constructor uses in this tree (nvme/attach.pdx L266, xhci/attach.pdx L430, pdxfs/mount_block.pdx L402). Error fold: PE_TAIL_ENOSPC (pool exhausted) -> -ENOMEM (0xFFFFFFFFFFFFFFF4); any PE_MINT_BAD_* (bad caller args) -> -EINVAL (0xFFFFFFFFFFFFFFEA). Rollback: if alloc succeeded but the cap_table scan exhausted, pipeline_edge_free(row_id) reclaims the row before -ENOMEM returns (leak-free). Witness fingerprint 'pipe edge mint sc ok slot=<n> row=<n>' via klog_s1_d2 emits ONLY when _fd_hygiene_witness_active is set (shared gate with sys_pipe / sys_dup2 / fd-cloexec witnesses -- see src/kernel/boot/witness/fd_hygiene.pdx §gate). klog_s1_d2 caller-push idiom: sub rsp,8 pre-align + push v2 + call + add rsp,16 tail (same shape sys_pipe.pdx L283 uses for its own d2 emit). 3-push callee-save prologue (rbx=rights, r12=row_id post-alloc, r13=slot cursor then picked slot) delivers rsp%16==0 for every nested call (entry rsp%16==8, +24=32, 32%16==0). Encoder posture per feedback_pdx_encoder_pitfalls: no `test rN,rN`; PE_TAIL_ENOSPC (0xFFFFEB8B) staged through r10 to avoid the imm32 sign-extension pitfall (as imm32 it sign-extends to 0xFFFFFFFFFFFFEB8B which is NOT equal to the u64 return 0x00000000FFFFEB8B); imm64 errno sentinels load via `mov rax, imm64` (10-byte movabs, same shape sys_pipe.pdx L324 uses); no 2-op `imul r,imm` (slot*24 via shl 3 + shl 4); no `and reg, imm64` (all masks fit imm32); no `add reg, [mem]` / `cmp reg, [mem]` (every memory operand stages through rax first). Reserved-label prefix `spm_` avoids paideia-as reserved-word collisions (loop/if/top/done). Effects widened to (mem, sysreg) because pipeline_edge_alloc's transitive klog_s1_x3 emit and this body's own witness emit both touch the UART port-IO path; capabilities {cap} matches cap_mint_write's own posture.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Cache rights across the pipeline_edge_alloc call (its internal
        // pe_rights_valid nested call clobbers rdx).
        mov rbx, rdx;

        // -------------------------------------------------------------
        // Phase 1: pipeline_edge_alloc(schema_id, role, rights)
        // -------------------------------------------------------------
        // rdi=schema_id, rsi=role, rdx=rights already positioned by
        // dispatch shuffle. No pre-call sub rsp,8 needed: rsp%16==0
        // per the 3-push arithmetic above.
        call pipeline_edge_alloc;

        // Success: rax in [0..31]. Failure: rax is one of the
        // PE_MINT_BAD_* / PE_TAIL_ENOSPC sentinels (all >= 32).
        mov r10, 32;
        cmp rax, r10;
        jae spm_alloc_fail;

        mov r12, rax;                        // r12 = row_id

        // -------------------------------------------------------------
        // Phase 2: free-slot scan cap_table[1..255] for kind==0.
        // -------------------------------------------------------------
        // Slot 0 is the null anchor by convention (kept out of the
        // scan so a downstream reader distinguishing "unset" from
        // "unused" stays coherent). Address compute per iteration:
        //   base + slot*24 = base + slot*8 + slot*16
        mov r13, 1;                          // slot cursor

      spm_scan:
        mov r10, 256;
        cmp r13, r10;
        jae spm_scan_full;                   // table exhausted -> ENOMEM

        lea rax, [rip + cap_table];
        mov r10, r13;
        shl r10, 3;                          // slot * 8
        mov r11, r13;
        shl r11, 4;                          // slot * 16
        add r10, r11;                        // slot * 24
        add rax, r10;
        mov rcx, [rax + 0];                  // rcx = descriptor.kind
        cmp rcx, 0;
        je  spm_slot_ok;

        add r13, 1;
        jmp spm_scan;

      spm_slot_ok:
        // -----------------------------------------------------------
        // Phase 3: cap_mint_write(slot, KIND_PIPELINE_EDGE, rights, row_id)
        // -----------------------------------------------------------
        // ABI (mirrors src/kernel/core/cap/mint.pdx L116):
        //   rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        mov rdi, r13;
        mov rsi, 0x1F0;                      // KIND_PIPELINE_EDGE
        mov rdx, rbx;                        // rights (cached)
        mov rcx, r12;                        // target_ptr = row_id
        call cap_mint_write;

        // -----------------------------------------------------------
        // Witness emit (gated).
        //   `pipe edge mint sc ok slot=<n> row=<n>`
        // -----------------------------------------------------------
        mov rax, [rip + _fd_hygiene_witness_active];
        cmp rax, 0;
        je  spm_witness_skip;

        // klog_s1_d2 caller-push idiom (7th arg v2 on stack):
        //   sub rsp, 8       pad -> rsp%16==8
        //   push v2          -> rsp%16==0 (aligned for CALL)
        //   call klog_s1_d2
        //   add rsp, 16      pop pad + push
        // Entry to this emit block: rsp%16==0 (3-push prologue + this
        // function's own call/ret aligned frame).
        sub rsp, 8;
        mov rax, r12;                        // v2 = row_id
        push rax;
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_pipe_edge_mint_sc_ok];
        lea rcx, [rip + k_slot];
        mov r8,  r13;                        // v1 = slot
        lea r9,  [rip + k_row];
        call klog_s1_d2;
        add rsp, 16;

      spm_witness_skip:
        mov rax, r13;                        // return cap_slot
        jmp spm_out;

      // ==============================================================
      // Failure funnels.
      // ==============================================================

      spm_scan_full:
        // Row was minted but no cap_table slot free. Free the row so
        // repeated failure paths do not leak _pipeline_edge_table
        // entries. pipeline_edge_free's return is not consulted -- we
        // are already on the error path.
        mov rdi, r12;
        call pipeline_edge_free;

        mov rax, 0xFFFFFFFFFFFFFFF4;         // -ENOMEM
        jmp spm_out;

      spm_alloc_fail:
        // rax carries one of PE_MINT_BAD_SCHEMA (0xFFFFEB8C),
        //                    PE_MINT_BAD_ROLE   (0xFFFFEB8D),
        //                    PE_MINT_BAD_RIGHTS (0xFFFFEB8E),
        //                    PE_TAIL_ENOSPC     (0xFFFFEB8B).
        // Distinguish ENOSPC (pool exhausted) from the three BAD_*
        // (structural refuses on caller args).
        mov r10, 0xFFFFEB8B;                 // SPM_PE_TAIL_ENOSPC
        cmp rax, r10;
        je  spm_enomem;

        mov rax, 0xFFFFFFFFFFFFFFEA;         // -EINVAL
        jmp spm_out;

      spm_enomem:
        mov rax, 0xFFFFFFFFFFFFFFF4;         // -ENOMEM

      spm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
