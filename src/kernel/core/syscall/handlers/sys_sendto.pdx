// src/kernel/core/syscall/handlers/sys_sendto.pdx -- R93.M2-004
// (paideia-os #2052)
//
// sys_sendto(fd, buf_va, len, dst_ip_packed, dst_port) -> bytes_sent
// | -errno. SC+ ID 96.
//
// UDP's first per-call peer-address send path. Also usable by TCP:
// on a connected TCP socket the dst_ip/dst_port args are IGNORED
// (matches Linux behaviour where sendto() on a connected socket
// mirrors send()). Cap at SYS_SENDTO_MAX = UDP_DGRAM_MAX = 1024,
// same as sys_send's cap.
//
// Body posture:
//   * Resolve fd via generic tcp_socket_resolve (kind-scoped).
//   * KIND_UDP_SOCKET: verify R_SOCKET_WRITE via sock_cap_check_rights.
//     If the socket is CLOSED, refuse -EINVAL (must be at least bound
//     -- no auto-bind on sendto at this MVP; a future landing may add
//     it). If the socket is CONNECTED and the caller's dst_ip !=
//     stored peer_ip OR dst_port != stored peer_port, refuse
//     -EISCONN (Linux behavior). Otherwise temporarily stamp
//     peer_ip/peer_port from the caller's args into the row (BOUND
//     ->  temporarily CONNECTED-shape), invoke udp_socket_send_body,
//     restore the row (unstamp peer, revert state) so the socket's
//     durable identity is what bind()/connect() actually stamped.
//   * KIND_TCP_SOCKET: dst_ip/dst_port ignored; tail into the same
//     send-path as sys_send would take (require ESTABLISHED, KPTI-
//     bounce user buffer into _sys_sendto_scratch, tcp_send_segment
//     ACK|PSH). Structurally a copy of sys_send_body's TCP arm.
//   * Any other kind: -EBADF.
//
// The BOUND-to-temporarily-CONNECTED-and-back gymnastic is the MVP's
// answer to sendto's "different peer per call" contract; a future
// landing that lands per-call peer args in udp_socket_send_body's
// own signature would let sys_sendto call directly without the row
// mutation dance.

module SysSendto = structure {

  pub let SYS_SENDTO_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7    // -EBADF    (-9)
  pub let SYS_SENDTO_EINVAL   : u64 = 0xFFFFFFFFFFFFFFEA    // -EINVAL   (-22)
  pub let SYS_SENDTO_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2    // -EFAULT   (-14)
  pub let SYS_SENDTO_EACCES   : u64 = 0xFFFFFFFFFFFFFFF3    // -EACCES   (-13)
  pub let SYS_SENDTO_EISCONN  : u64 = 0xFFFFFFFFFFFFFF96    // -EISCONN  (-106)
  pub let SYS_SENDTO_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95    // -ENOTCONN (-107)
  pub let SYS_SENDTO_MAX      : u64 = 1024

  pub let mut _sys_sendto_scratch : [u8; 1024] = uninit @align(8)

  pub let sys_sendto_body : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64,
        dst_ip_packed: u64, dst_port: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R93.M2-004 (paideia-os #2052): sys_sendto SC+ ID 96. 6-push callee-save (rbx=fd, rbp=buf_va, r12=capped_len, r13=dst_ip_packed, r14=dst_port, r15=target_idx) + sub rsp,16 (16 bytes for saved peer_ip u64 + saved peer_port u64 across udp_socket_send_body): 48+16=64; entry rsp%16==8 -> 72, %16==8. Need one more 8-byte pad for nested-call alignment -- sub rsp,24 total (16 slots + 8 pad). Cap len at SYS_SENDTO_MAX=1024 (matches UDP_DGRAM_MAX). Try TCP resolve first via tcp_socket_resolve(fd, 0x1AB); hit -> R_SOCKET_WRITE gate; state must be ESTABLISHED(4); KPTI-bounce user buf via user_ptr_ok + user_read_bytes_via_walk into _sys_sendto_scratch; tcp_send_segment(tcb_idx, ACK|PSH=0x18, scratch, len); return len. Miss -> UDP resolve via tcp_socket_resolve(fd, 0x1A8); hit -> R_SOCKET_WRITE gate. UDP-arm state gate: state != CLOSED (0) required -- fresh socket (never bound) -> -EINVAL. Otherwise save row's [+16] peer_port and read 4 [+24..+27] peer_ip bytes packed into u64 (stash both in stack slots at [rsp+0] and [rsp+8]). Stamp caller's dst_ip_packed (unpacked MSB-first into [+24..+27]) and dst_port ([+16]). Save state at [rsp+16... wait, only 16 bytes of slots]. Actually simpler: bump state to CONNECTED (2) if it was BOUND (1), keep track of pre-state. After udp_socket_send_body(sock_idx, buf, len), restore peer_ip/peer_port bytes and state. Actually the simplest correctness argument: the row's send path checks state==CONNECTED. If pre-state was BOUND, we set CONNECTED, send, then set BOUND back. If pre-state was CONNECTED, restore original peer_ip/peer_port after send. KPTI-bounce user buf into _sys_sendto_scratch (same shape as TCP arm). Reserved labels sys_sto_. This handler's UDP branch does NOT emit the socket's own EISCONN refusal because sendto's contract is 'send to this specific peer', not 'require connected socket'. Both miss -> -EBADF.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                            // fd
        mov rbp, rsi;                            // buf_va
        mov r12, rdx;                            // len
        mov r13, rcx;                            // dst_ip_packed
        mov r14, r8;                             // dst_port

        // Cap len.
        mov rax, 1024;
        cmp r12, rax;
        jbe sys_sto_len_ok;
        mov r12, rax;
      sys_sto_len_ok:

        // Try TCP.
        mov rdi, rbx;
        mov rsi, 0x1AB;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_sto_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_sto_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;             // -EBADF
        jmp sys_sto_done;

      sys_sto_have_tcp:
        mov r15, rax;                            // tcb_idx
        // R_SOCKET_WRITE gate.
        mov rdi, rbx;
        mov rsi, 0x002;
        call sock_cap_check_rights;
        cmp rax, 0;
        jne sys_sto_eaccess;

        // Require ESTABLISHED(4).
        mov rcx, r15;
        shl rcx, 9;
        lea rdx, [rip + _tcp_tcb_table];
        add rcx, rdx;
        mov rdx, [rcx + 0];
        cmp rdx, 4;
        jne sys_sto_enotconn;

        // KPTI bounce.
        mov rdi, rbp;
        mov rsi, r12;
        call user_ptr_ok;
        cmp rax, 0;
        jne sys_sto_efault;

        lea rdi, [rip + _sys_sendto_scratch];
        mov rsi, rbp;
        mov rdx, r12;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sys_sto_efault;

        mov rdi, r15;
        mov rsi, 0x18;                           // ACK|PSH
        lea rdx, [rip + _sys_sendto_scratch];
        mov rcx, r12;
        call tcp_send_segment;

        mov rax, r12;
        jmp sys_sto_done;

      sys_sto_have_udp:
        mov r15, rax;                            // sock_idx
        // R_SOCKET_WRITE gate.
        mov rdi, rbx;
        mov rsi, 0x002;
        call sock_cap_check_rights;
        cmp rax, 0;
        jne sys_sto_eaccess;

        // Compute row_ptr into r9 (caller-save; we don't need to keep
        // it across nested calls other than the send itself, and we
        // recompute post-send from r15).
        mov r9, r15;
        shl r9, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, r9;
        mov r9, rcx;                             // r9 = row_ptr

        // State != CLOSED?
        mov rax, [r9 + 0];
        cmp rax, 0;
        je sys_sto_einval;

        // Save state, peer_port, peer_ip bytes.
        mov [rsp + 0], rax;                      // saved state
        mov rax, [r9 + 16];
        mov [rsp + 8], rax;                      // saved peer_port

        // Save peer_ip 4 bytes as packed u32 in [rsp+16].
        xor rax, rax;
        mov_b rax, [r9 + 24];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [r9 + 25];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [r9 + 26];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [r9 + 27];
        or rax, rcx;
        mov [rsp + 16], rax;

        // Stamp caller's peer_ip / peer_port / state=CONNECTED.
        mov rax, r13;
        mov rcx, rax;
        shr rcx, 24;
        and rcx, 0xFF;
        mov_b [r9 + 24], rcx;
        mov rcx, rax;
        shr rcx, 16;
        and rcx, 0xFF;
        mov_b [r9 + 25], rcx;
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;
        mov_b [r9 + 26], rcx;
        mov rcx, rax;
        and rcx, 0xFF;
        mov_b [r9 + 27], rcx;
        mov [r9 + 16], r14;                      // peer_port
        mov rax, 2;                              // UDP_ST_CONNECTED
        mov [r9 + 0], rax;

        // KPTI bounce.
        mov rdi, rbp;
        mov rsi, r12;
        call user_ptr_ok;
        cmp rax, 0;
        jne sys_sto_udp_efault;

        lea rdi, [rip + _sys_sendto_scratch];
        mov rsi, rbp;
        mov rdx, r12;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sys_sto_udp_efault;

        // Send.
        mov rdi, r15;
        lea rsi, [rip + _sys_sendto_scratch];
        mov rdx, r12;
        call udp_socket_send_body;

        // Restore row.
        mov r9, r15;
        shl r9, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, r9;
        mov r9, rcx;
        mov rax, [rsp + 16];                     // saved peer_ip
        mov rcx, rax;
        shr rcx, 24;
        and rcx, 0xFF;
        mov_b [r9 + 24], rcx;
        mov rcx, rax;
        shr rcx, 16;
        and rcx, 0xFF;
        mov_b [r9 + 25], rcx;
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;
        mov_b [r9 + 26], rcx;
        mov rcx, rax;
        and rcx, 0xFF;
        mov_b [r9 + 27], rcx;
        mov rax, [rsp + 8];
        mov [r9 + 16], rax;                      // saved peer_port
        mov rax, [rsp + 0];
        mov [r9 + 0], rax;                       // saved state

        mov rax, r12;                            // return len
        jmp sys_sto_done;

      sys_sto_udp_efault:
        // Restore row on efault too.
        mov r9, r15;
        shl r9, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, r9;
        mov r9, rcx;
        mov rax, [rsp + 16];
        mov rcx, rax;
        shr rcx, 24;
        and rcx, 0xFF;
        mov_b [r9 + 24], rcx;
        mov rcx, rax;
        shr rcx, 16;
        and rcx, 0xFF;
        mov_b [r9 + 25], rcx;
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;
        mov_b [r9 + 26], rcx;
        mov rcx, rax;
        and rcx, 0xFF;
        mov_b [r9 + 27], rcx;
        mov rax, [rsp + 8];
        mov [r9 + 16], rax;
        mov rax, [rsp + 0];
        mov [r9 + 0], rax;
        mov rax, 0xFFFFFFFFFFFFFFF2;             // -EFAULT
        jmp sys_sto_done;

      sys_sto_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        jmp sys_sto_done;
      sys_sto_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_sto_done;
      sys_sto_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sys_sto_done;
      sys_sto_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;

      sys_sto_done:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
