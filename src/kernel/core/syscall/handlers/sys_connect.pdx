// src/kernel/core/syscall/handlers/sys_connect.pdx — R72.M1-005 (#1927)
//                                                     R100-PREP-002 (#2008)
//
// sys_connect(fd, remote_ip, remote_port) -> 0 | -errno. SC+ ID 91.
// remote_ip is a packed u32 in normal dotted-quad byte order (bits
// [31:24] = a, [23:16] = b, [15:8] = c, [7:0] = d for a.b.c.d) -- no
// sockaddr_in struct at MVP, matching sys_bind's collapsed ABI.
//
// Dispatch by cap kind (via the generic tcp_socket_resolve):
//   KIND_TCP_SOCKET (0x1AB) -> the original R72 TCP body inlined
//                              below: TCP_ST_CLOSED gate, ephemeral
//                              port auto-assign if never bound, ISS
//                              seed, transition to SYN_SENT, send
//                              SYN. The loopback fast path resolves
//                              the entire handshake synchronously
//                              (per net/tcp.pdx module header), so a
//                              post-call state check (== ESTABLISHED)
//                              reports success immediately; off-box
//                              destinations return -EINPROGRESS.
//   KIND_UDP_SOCKET (0x1A8) -> udp_socket_connect_body: set the
//                              default peer (peer_ip + peer_port),
//                              auto-assign ephemeral local_port if
//                              never bound, transition to CONNECTED.
//                              NO handshake -- UDP is connectionless;
//                              "connect" is purely a local record.
//   any other / not a socket -> -EBADF.

module SysConnect = structure {

  pub let SYS_CONNECT_EBADF      : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF      (-9)
  pub let SYS_CONNECT_EISCONN    : u64 = 0xFFFFFFFFFFFFFF96   // -EISCONN    (-106)
  pub let SYS_CONNECT_EINPROGRESS: u64 = 0xFFFFFFFFFFFFFF8D   // -EINPROGRESS (-115)

  pub let sys_connect_body : (u64, u64, u64) -> u64 !{sysreg, mem} @{cap} =
    fn (fd: u64, remote_ip: u64, remote_port: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008): sys_connect, SC+ ID 91. Resolves fd first as a KIND_TCP_SOCKET; on hit, executes the original R72 TCP connect body inline (TCP_ST_CLOSED gate, ephemeral port auto-assign, ISS seed, SYN send, post-call ESTABLISHED-vs-EINPROGRESS check). On TCP miss, resolves as a KIND_UDP_SOCKET and tail-calls udp_socket_connect_body(sock_idx, remote_ip, remote_port) which sets the default peer + auto-assigns ephemeral local_port if never bound and transitions state=CONNECTED with NO packets transmitted (UDP is connectionless). Both miss -> -EBADF. Dispatch order (TCP first) mirrors sys_bind.pdx and minimizes regression risk on the R72 path. 4-push callee-save (rbx=fd/tcb_idx, r12=remote_ip, r13=remote_port, r14=tcb_ptr) + sub rsp,8: entry rsp%16==8, four pushes (32 bytes) land rsp%16==8, the 8-byte pad brings it to 0 for every nested call (tcp_socket_resolve, udp_socket_connect_body, tcp_next_ephemeral_port, tcp_next_iss, tcp_send_segment). Reserved labels: sys_connect_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_connect_do_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;                        // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_connect_do_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp sys_connect_done;

      sys_connect_do_udp:
        mov rdi, rax;                          // sock_idx
        mov rsi, r12;                          // remote_ip (packed)
        mov rdx, r13;                          // remote_port
        call udp_socket_connect_body;
        jmp sys_connect_done;

      sys_connect_do_tcp:
        // rax = tcb_idx. Original R72 TCP connect body inlined below.
        mov rbx, rax;                          // tcb_idx
        mov rax, rbx;
        shl rax, 9;
        lea r14, [rip + _tcp_tcb_table];
        add r14, rax;                          // r14 = tcb_ptr

        mov rax, [r14 + 0];
        cmp rax, 0;
        jne sys_connect_eisconn;

        mov rax, [r14 + 8];
        cmp rax, 0;
        jne sys_connect_have_port;
        call tcp_next_ephemeral_port;
        mov [r14 + 8], rax;
      sys_connect_have_port:

        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [r14 + 24], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [r14 + 25], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [r14 + 26], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [r14 + 27], rax;

        mov rax, r12; shr rax, 24; and rax, 0xFF; mov_b [r14 + 32], rax;
        mov rax, r12; shr rax, 16; and rax, 0xFF; mov_b [r14 + 33], rax;
        mov rax, r12; shr rax, 8;  and rax, 0xFF; mov_b [r14 + 34], rax;
        mov rax, r12; and rax, 0xFF;              mov_b [r14 + 35], rax;

        mov [r14 + 16], r13;

        call tcp_next_iss;
        mov [r14 + 80], rax;
        mov [r14 + 40], rax;
        mov [r14 + 48], rax;

        mov rax, 2;                             // TCP_ST_SYN_SENT
        mov [r14 + 0], rax;

        mov rdi, rbx;
        mov rsi, 0x02;                          // SYN
        xor rdx, rdx;
        xor rcx, rcx;
        call tcp_send_segment;

        mov rax, [r14 + 0];
        cmp rax, 4;
        jne sys_connect_inprogress;
        xor rax, rax;
        jmp sys_connect_done;

      sys_connect_inprogress:
        mov rax, 0xFFFFFFFFFFFFFF8D;
        jmp sys_connect_done;

      sys_connect_eisconn:
        mov rax, 0xFFFFFFFFFFFFFF96;

      sys_connect_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
