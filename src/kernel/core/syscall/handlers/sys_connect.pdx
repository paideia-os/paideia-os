// src/kernel/core/syscall/handlers/sys_connect.pdx — R72.M1-005 (#1927)
//
// sys_connect(fd, remote_ip, remote_port) -> 0 | -errno. SC+ ID 91.
// remote_ip is a packed u32 in normal dotted-quad byte order (bits
// [31:24] = a, [23:16] = b, [15:8] = c, [7:0] = d for a.b.c.d) -- no
// sockaddr_in struct at MVP, matching sys_bind's collapsed ABI.
//
// Because net/tcp.pdx's loopback fast path resolves an entire 3-way
// handshake synchronously inside tcp_send_segment's first call (see
// that module's header), THIS body can simply check the TCB's state
// after tcp_send_segment(SYN) returns: TCP_ST_ESTABLISHED means the
// loopback handshake already finished and connect() returns 0
// immediately. A real off-box destination cannot complete
// synchronously -- this MVP has no async-connect completion queue, so
// that path returns -EINPROGRESS and the connection is left in
// TCP_ST_SYN_SENT for a future poll/select-style completion mechanism
// this round does not implement.

module SysConnect = structure {

  pub let SYS_CONNECT_EBADF      : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF      (-9)
  pub let SYS_CONNECT_EISCONN    : u64 = 0xFFFFFFFFFFFFFF96   // -EISCONN    (-106)
  pub let SYS_CONNECT_EINPROGRESS: u64 = 0xFFFFFFFFFFFFFF8D   // -EINPROGRESS (-115)

  pub let sys_connect_body : (u64, u64, u64) -> u64 !{sysreg, mem} @{cap} =
    fn (fd: u64, remote_ip: u64, remote_port: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_connect, SC+ ID 91. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. Requires TCP_ST_CLOSED (@+0==0) -- an already-connected or handshaking socket is refused with -EISCONN. Auto-assigns an ephemeral local_port via tcp_next_ephemeral_port() if sys_bind was never called (local_port @+8 == 0); stamps local_ip from _ipv4_my_ip, remote_ip (unpacked MSB-first from the packed u32 arg) and remote_port; draws a fresh ISN via tcp_next_iss() and seeds snd_una=snd_nxt=iss; sets state=TCP_ST_SYN_SENT(2); then calls tcp_send_segment(tcb_idx, SYN, 0, 0). Per net/tcp.pdx's module header, a loopback destination (remote_ip==local_ip) resolves the ENTIRE handshake synchronously inside that one call, so the post-call state check (== TCP_ST_ESTABLISHED(4)) tells this body whether to report success immediately or -EINPROGRESS for an off-box destination this MVP cannot complete asynchronously. 4-push callee-save (rbx=tcb_idx after resolve, r12=remote_ip, r13=remote_port, r14=tcb_ptr) + sub rsp,8: entry rsp%16==8, four pushes (32 bytes) land rsp%16==8, the 8-byte pad brings it to 0 for every nested call (tcp_socket_resolve, tcp_next_ephemeral_port, tcp_next_iss, tcp_send_segment). Reserved labels: sys_connect_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET (fix#2005)
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_connect_ebadf;

        mov rbx, rax;                          // tcb_idx
        mov rax, rbx;
        shl rax, 9;
        lea r14, [rip + _tcp_tcb_table];
        add r14, rax;                          // r14 = tcb_ptr

        mov rax, [r14 + 0];
        cmp rax, 0;
        jne sys_connect_eisconn;

        mov rax, [r14 + 8];
        cmp rax, 0;
        jne sys_connect_have_port;
        call tcp_next_ephemeral_port;
        mov [r14 + 8], rax;
      sys_connect_have_port:

        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 0]; mov_b [r14 + 24], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 1]; mov_b [r14 + 25], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 2]; mov_b [r14 + 26], rax;
        xor rax, rax; mov_b rax, [rip + _ipv4_my_ip + 3]; mov_b [r14 + 27], rax;

        mov rax, r12; shr rax, 24; and rax, 0xFF; mov_b [r14 + 32], rax;
        mov rax, r12; shr rax, 16; and rax, 0xFF; mov_b [r14 + 33], rax;
        mov rax, r12; shr rax, 8;  and rax, 0xFF; mov_b [r14 + 34], rax;
        mov rax, r12; and rax, 0xFF;              mov_b [r14 + 35], rax;

        mov [r14 + 16], r13;

        call tcp_next_iss;
        mov [r14 + 80], rax;
        mov [r14 + 40], rax;
        mov [r14 + 48], rax;

        mov rax, 2;                             // TCP_ST_SYN_SENT
        mov [r14 + 0], rax;

        mov rdi, rbx;
        mov rsi, 0x02;                            // SYN
        xor rdx, rdx;
        xor rcx, rcx;
        call tcp_send_segment;

        mov rax, [r14 + 0];
        cmp rax, 4;
        jne sys_connect_inprogress;
        xor rax, rax;
        jmp sys_connect_done;

      sys_connect_inprogress:
        mov rax, 0xFFFFFFFFFFFFFF8D;
        jmp sys_connect_done;

      sys_connect_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_connect_done;

      sys_connect_eisconn:
        mov rax, 0xFFFFFFFFFFFFFF96;

      sys_connect_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
