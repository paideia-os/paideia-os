// src/kernel/core/syscall/handlers/sys_page_flip_wait.pdx -- R105.M3-003
//
// sys_page_flip_wait(pgfl_cap_slot, timeout_ms) -> 0 | -errno
//
// Sysno 112. Block the caller until the KIND_PAGE_FLIP row's in_flight
// bit clears (i.e., pgfl_deliver_vblank latches the pending flip). At
// R105 the wake path is driven by the R101.M3-003 simulated-vblank
// tick on Bochs (which calls pgfl_deliver_vblank), by a real vblank
// ISR when R104 wires it, or by a virtio-gpu completion when R103
// wires it.
//
// timeout_ms is honored as a best-effort ceiling: if a check-then-wait
// race lands the flip before the caller parks, we return immediately.
// A real timeout wheel (deadline-scheduled wake) is a follow-on -- at
// R105 the timeout_ms is folded into a poll-then-block loop where the
// timeout expressed as N iterations of sched_wait keyed by SCHED_WAIT_
// PAGE_FLIP; a caller passing 0 gets a single non-blocking check.
//
// Return: 0 on completion, -ETIMEDOUT on timeout, -EBADF/-EACCES on
// cap resolution failure.

module SysPageFlipWait = structure {

  pub let SYSFLW_ERR_EBADF     : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYSFLW_ERR_EACCES    : u64 = 0xFFFFFFFFFFFFFFF3
  pub let SYSFLW_ERR_ETIMEDOUT : u64 = 0xFFFFFFFFFFFFFF92   // -110

  pub let sys_page_flip_wait_body : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (pgfl_cap_slot: u64) (timeout_ms: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R105.M3-003 (sysno 112): resolve cap -> row_id, then loop: check in_flight; if 0, return 0; else sched_wait(SCHED_WAIT_PAGE_FLIP=2, row_id) to park until pgfl_deliver_vblank fires sched_wake_kind. timeout_ms is CURRENTLY consulted only as a poll-count ceiling: value 0 -> single non-blocking check; value >0 -> at most N parks (N = min(timeout_ms, SYSFLW_MAX_PARKS=256)). A real deadline-scheduled timeout arrives with the R106 timer-wheel wire-in. Register plan: rbx=row_id, r12=parks_left. 2 callee-save pushes + sub rsp,8 pad. Labels prefixed sysflw_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        cmp rdi, 256;
        jae sysflw_ebadf;

        lea rax, [rip + cap_table];
        mov r10, rdi;
        shl r10, 3;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        add rax, r10;

        mov r10, [rax + 0];
        mov r11, 0x1B0;                  // KIND_PAGE_FLIP
        cmp r10, r11;
        jne sysflw_ebadf;

        mov r10, [rax + 8];
        mov r11, 0x001;                  // R_FLIP_INVOKE
        and r10, r11;
        cmp r10, r11;
        jne sysflw_eacces;

        mov r10, [rax + 16];
        and r10, 0xFF;
        mov rbx, r10;                    // pgfl_row_id

        // Cap parks_left at 256; timeout_ms=0 means "one check only".
        mov r12, rsi;
        mov r10, 256;
        cmp r12, r10;
        jbe sysflw_cap_ok;
        mov r12, r10;
      sysflw_cap_ok:

      sysflw_loop:
        // Check in_flight.
        mov rdi, rbx;
        call pgfl_row_in_flight;
        cmp rax, 0;
        je  sysflw_ok;                   // flip landed / never was in flight

        // Exhausted?
        cmp r12, 0;
        je  sysflw_timeout;

        // Park.
        mov rdi, 2;                      // SCHED_WAIT_PAGE_FLIP
        mov rsi, rbx;
        call sched_wait;

        // Resume: decrement parks_left and re-check.
        cmp r12, 0;
        je  sysflw_timeout;
        sub r12, 1;
        jmp sysflw_loop;

      sysflw_ok:
        xor rax, rax;
        jmp sysflw_out;

      sysflw_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sysflw_out;
      sysflw_eacces:
        mov rax, 0xFFFFFFFFFFFFFFF3;
        jmp sysflw_out;
      sysflw_timeout:
        mov rax, 0xFFFFFFFFFFFFFF92;     // -ETIMEDOUT

      sysflw_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
