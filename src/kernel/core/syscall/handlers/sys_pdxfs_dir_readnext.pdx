// src/kernel/core/syscall/handlers/sys_pdxfs_dir_readnext.pdx
//   -- R42-PREP-008 (#1630)
//
// sys_pdxfs_dir_readnext body -- fetch one directory entry from a held
// dir cap into a caller-provided kernel-side scratch.  Syscall number 71.
// The dispatch shim (dispatch.pdx §dispatch_pdxfs_dir_readnext) walks
// the kernel scratch out to the user's buffer via user_write_bytes_via_walk
// so the body itself never touches user memory.
//
// Contract:
//
//   sys_pdxfs_dir_readnext(dir_cap_slot, kernel_dst_ptr)
//     -> 1                                        one entry written
//     -> 0                                        end of directory
//     -> SYS_PDXFS_DIR_READNEXT_ERR_EBADF (-9)    dir_cap_slot OOR, or
//                                                 not KIND_PDXFS_FILE,
//                                                 or dead row, or not a
//                                                 directory (mode nibble
//                                                 != PdxFS DIR value)
//
// ARGUMENT SHAPE
//
//   rdi = dir_cap_slot         held KIND_PDXFS_FILE cap whose mode
//                              nibble marks it as a directory (see
//                              pdxfs_dir_iter.pdx §0 for the interim
//                              KIND_PDXFS_DIR posture)
//   rsi = kernel_dst_ptr       kernel VA of a PDXFS_DIR_ENTRY_SIZE-byte
//                              scratch owned by the dispatch layer;
//                              body writes 128 bytes here on rc=1.
//
// -EFAULT is NEVER returned by this body -- the trust-boundary walk
// is entirely in the dispatch shim.  Body-level failures are all
// -EBADF because they name a cap-side problem.
//
// DIR-MODE GATE
//
// The mode nibble at bits [15:12] of the row's mode_bits distinguishes
// files from directories (design/user/pdxfs-kinds.md §3.1 interim
// posture).  A cap whose row has file-nibble != DIR is refused with
// -EBADF -- POSIX readdir on a non-directory returns ENOTDIR (-20)
// classically, but at the syscall boundary EBADF is the cap-model
// analog ("this cap does not authorise a dir read") and keeps the
// errno taxonomy tight (three sentinels, disjoint from EFAULT).
//
// STUB NIBBLE
//
// sys_pdxfs_open stamps the row with mode_flags the caller passed.
// The witness passes a DIR nibble (0x2000 -- see the PdxFS mode-bit
// convention below); a caller passing a FILE nibble against this
// syscall gets -EBADF.  This gate matters because a follow-up round
// with KIND_PDXFS_DIR refined will route through the same body but
// with a distinct row_of_slot helper -- keeping the gate here means
// the interim can already refuse file caps.

module SysPdxfsDirReadnext = structure {

  // Error sentinel -- see sys_pdxfs_open.pdx for the parallel discipline.
  pub let SYS_PDXFS_DIR_READNEXT_ERR_EBADF : u64 = 0xFFFFFFFFFFFFFFF7   // -9

  // PdxFS file-type nibble for DIR at bits [15:12] of mode_bits.
  // Kept as an explicit constant (rather than reused from a shared
  // header) because at R42-PREP-008 there is no shared header for the
  // PdxFS mode nibble -- pdxfs-kinds.md §3.1 documents the field as
  // "PdxFS file-type nibble" without a numeric value assignment.  We
  // pin DIR=2 here (matches PDXFS_ENT_KIND_DIR in pdxfs_dir_iter.pdx)
  // so witnesses and sys_pdxfs_open callers agree on the same value.
  // A follow-up round that consolidates the mode-nibble header
  // rewrites this constant and every caller in the same edit.
  pub let SYS_PDXFS_DIR_MODE_NIBBLE_DIR   : u64 = 0x2000

  // ==========================================================================
  // sys_pdxfs_dir_readnext_body(dir_cap_slot, kernel_dst_ptr) -> u64
  //
  // See §Contract above for the full ABI.
  //
  // Register plan (3-push callee-save prologue; entry rsp %16 == 8 SysV;
  // 3*8=24; 8+24=32; 32%16 == 0 for nested calls):
  //   rbx = kernel_dst_ptr    (survives across pdxfs_file_row_of_slot,
  //                            pdxfs_file_row_mode, pdxfs_dir_readnext)
  //   r12 = row_id            (survives from row_of_slot to
  //                            pdxfs_file_row_mode and pdxfs_dir_readnext)
  //   r13 = (unused)          (reserved to keep the SysV alignment
  //                            arithmetic identical if a follow-up
  //                            widens the register live set)
  // ==========================================================================

  pub let sys_pdxfs_dir_readnext_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (dir_cap_slot: u64, kernel_dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): sys_pdxfs_dir_readnext body -- resolve the cap slot to a row, gate on the dir mode nibble, then delegate to pdxfs_dir_readnext for the entry emission + cursor advance. Sequence: (1) dir_cap_slot < 256 else -EBADF (redundant with pdxfs_file_row_of_slot's own bounds gate, but cheaper and keeps the errno taxonomy clean). (2) call pdxfs_file_row_of_slot(dir_cap_slot) -- resolves through the descriptor's kind (must be 0x195) and row liveness (must not be freed). Returns row_id in [0..16) OR PFF_ROW_NONE (0xFF). PFF_ROW_NONE -> -EBADF. (3) call pdxfs_file_row_mode(row_id); if row_mode & 0x2000 == 0 (mode nibble != DIR at bits [15:12]) -> -EBADF ('not a directory'). Comparison against SYS_PDXFS_DIR_MODE_NIBBLE_DIR (0x2000) via `and rax, r10; cmp rax, 0; je err` so any DIR-nibble mode bits set qualifies (a cap opened with a wider mode still passes). (4) call pdxfs_dir_readnext(row_id, kernel_dst_ptr). rax = 1 (entry written), 0 (EOD), or PDXFS_DIR_ERR_ROW (0xFFFF...FFFF). The row_id came from a live descriptor so PDXFS_DIR_ERR_ROW is unreachable here, but we still translate it to -EBADF for defensiveness. (5) return rax verbatim on 1 or 0. Widening rationale: !{mem, sysreg} @{cap} at #2114 (was !{mem} @{cap} at #1630) -- mem for row-table + cursor-table reads/writes; sysreg newly required because pdxfs_dir_readnext now emits the `sys pdxfs readdir ok rows=<n>` fingerprint via klog_s1_d1 on EOD (klog_s1_d1 declares !{sysreg, mem}); cap for pdxfs_file_row_of_slot's own @{cap} posture (transitive). Matches sibling sys_pdxfs_txn_commit_body's !{mem, sysreg} @{cap} shape exactly. No @{sched} because this body never blocks. Labels prefixed spdr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // r12 = dir_cap_slot (temporarily)
        mov rbx, rsi;                        // rbx = kernel_dst_ptr

        // (1) Bounds-check dir_cap_slot.
        cmp r12, 256;
        jae spdr_ebadf;

        // (2) Resolve cap slot -> row_id.
        mov rdi, r12;
        call pdxfs_file_row_of_slot;
        // rax = row_id or PFF_ROW_NONE (0xFF)
        mov r10, 0xFF;                       // PFF_ROW_NONE
        cmp rax, r10;
        je  spdr_ebadf;
        mov r12, rax;                        // r12 = row_id (overwrites cap_slot)

        // (3) Read mode and gate on DIR nibble.
        mov rdi, r12;
        call pdxfs_file_row_mode;
        // rax = mode_bits (low 16) or PFF_DECODE_BAD.  A cap that
        // passed row_of_slot cannot have a dead row, so PFF_DECODE_BAD
        // is unreachable; but we still gate on the nibble.
        mov r10, 0x2000;                     // SYS_PDXFS_DIR_MODE_NIBBLE_DIR
        and rax, r10;
        cmp rax, 0;
        je  spdr_ebadf;                      // not a directory

        // (4) Delegate to pdxfs_dir_readnext.
        mov rdi, r12;                        // row_id
        mov rsi, rbx;                        // kernel_dst_ptr
        call pdxfs_dir_readnext;

        // rax = 1, 0, or PDXFS_DIR_ERR_ROW.  Translate the error path
        // to -EBADF; success codes pass through verbatim.
        cmp rax, 1;
        ja  spdr_ebadf;                      // any u64 > 1 = error (0 and 1 pass)

        jmp spdr_out;

      spdr_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF

      spdr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
