// src/kernel/core/syscall/handlers/sys_display_enumerate.pdx -- R105.M1-001
//
// sys_display_enumerate(out_buf_va, out_buf_cap) -> count | -errno
//
// Sysno 108. Enumerate live KIND_DISPLAY_BACKEND rows. Writes at most
// out_buf_cap/16 records into out_buf_va; each record is 16 bytes:
//
//   [+0]  u64  backend_kind (1..4 per DPYB_KIND_*)
//   [+8]  u64  row_id (index into _dpyb_table)
//
// Returns the TOTAL count of live rows regardless of buffer capacity
// (POSIX-adjacent -- caller can grow the buffer and re-call). Zero rows
// is not an error; count=0 returned. Errno taxonomy:
//
//   -EFAULT (-14) on a bad out_buf_va (user_ptr_ok fault, or walker fault)
//   -EINVAL (-22) on out_buf_cap not a multiple of 16
//
// KPTI bounce: writes assemble into a kernel scratch (up to DISPLAY_MAX
// records = 4 * 16 = 64 bytes), then walker-copies out to user VA.
//
// Body-owned gate posture matches R100-PREP-003's sys_icmp_echo: no
// dispatch-layer KPTI bounce, the body performs its own writes.

module SysDisplayEnumerate = structure {

  pub let SYSD_REC_BYTES  : u64 = 16
  pub let SYSD_MAX_RECS   : u64 = 4          // matches DPYB_MAX
  pub let SYSD_MAX_BYTES  : u64 = 64

  pub let SYSD_ERR_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYSD_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA

  pub let mut _sysd_scratch : [u8; 64] = uninit @align(8)

  pub let sys_display_enumerate_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (out_buf_va: u64) (out_buf_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M1-001 (sysno 108): scan _dpyb_table for live rows; for each live row write {backend_kind, row_id} into the kernel scratch; walker-copy min(count*16, out_buf_cap) bytes out; return total count. Register plan: rbx=out_buf_va, r12=out_buf_cap, r13=count, r14=cursor. 4 callee-save pushes + sub rsp,8 pad: entry rsp%16==8, +32+8=40, rsp%16==0. Labels prefixed sysd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // out_buf_va
        mov r12, rsi;                    // out_buf_cap

        // Cap validation: out_buf_cap must be a multiple of 16.
        mov rax, r12;
        and rax, 0x0F;
        cmp rax, 0;
        jne sysd_einval;

        // Scan _dpyb_table.
        xor r13, r13;                    // count = 0
        xor r14, r14;                    // scratch cursor = 0
        xor rcx, rcx;                    // row idx = 0

      sysd_scan:
        cmp rcx, 4;                      // DPYB_MAX
        jae sysd_scan_done;

        push rcx;
        mov rdi, rcx;
        call dpyb_row_valid;
        mov r10, rax;
        pop rcx;
        cmp r10, 0;
        je  sysd_scan_next;

        // Live row. Read backend_kind.
        push rcx;
        mov rdi, rcx;
        call dpyb_row_backend_kind;
        mov r11, rax;                    // backend_kind
        pop rcx;

        // Write into scratch at [scratch + r14*16].
        lea r10, [rip + _sysd_scratch];
        mov r8, r14;
        shl r8, 4;                       // r14 * 16
        add r10, r8;

        mov [r10 + 0], r11;              // backend_kind
        mov [r10 + 8], rcx;              // row_id

        add r13, 1;                      // count++
        add r14, 1;                      // cursor++

      sysd_scan_next:
        add rcx, 1;
        jmp sysd_scan;

      sysd_scan_done:
        // count in r13; scratch has r13 * 16 bytes of data.
        // Determine copy_len = min(count*16, out_buf_cap).
        mov rax, r13;
        shl rax, 4;                      // total bytes
        cmp rax, r12;
        jbe sysd_copy_len_ok;
        mov rax, r12;
      sysd_copy_len_ok:

        cmp rax, 0;
        je  sysd_return_count;           // nothing to copy

        // out_buf_va = 0 fault-check: refuse a null pointer.
        cmp rbx, 0;
        je  sysd_efault;

        // Walker-copy.
        mov rdi, rbx;                    // user VA
        lea rsi, [rip + _sysd_scratch];
        mov rdx, rax;                    // len
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sysd_efault;

      sysd_return_count:
        mov rax, r13;                    // return total count
        jmp sysd_out;

      sysd_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        jmp sysd_out;
      sysd_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;

      sysd_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
