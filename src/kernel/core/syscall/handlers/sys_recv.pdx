// src/kernel/core/syscall/handlers/sys_recv.pdx — R72.M1-005 (#1927)
//
// sys_recv(fd, buf_va, len) -> bytes_read | -errno. SC+ ID 93.
// Reads directly out of the TCB's own rx ring in net/tcp.pdx's
// _tcp_rx_buf_table -- no intermediate kernel scratch copy is needed
// since that table is already kernel memory, so the KPTI-safe walk
// (user_write_bytes_via_walk) can source from it directly.

module SysRecv = structure {

  pub let SYS_RECV_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let SYS_RECV_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)
  pub let SYS_RECV_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT   (-14)

  pub let sys_recv_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_recv, SC+ ID 93. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. Requires TCP_ST_ESTABLISHED(4) or TCP_ST_CLOSE_WAIT(7) -- the latter so a caller can still drain already-buffered bytes after the peer's FIN has landed but before the local side has called shutdown(); any other state is -ENOTCONN. available = rx_tail(@+184) - rx_head(@+176); to_copy = min(available, len), with NO cap at a fixed max the way sys_send has one, since the source is bounded by TCP_BUF_SIZE (4096) already and every byte is copied in one user_write_bytes_via_walk call rather than assembled in an extra scratch first. to_copy==0 returns 0 immediately (no data pending; this MVP has no blocking-recv wait queue, so an empty buffer looks identical to EOF to a caller -- documented limitation, not silently different from a real recv()'s distinct 'would block' signal). On a successful walk: rx_head advances by to_copy, giving the illusion of a ring even though this MVP never wraps it (a TCB's rx_buf is written once per connection's lifetime up to 4096 bytes total; wraparound is out of scope). 4-push callee-save (rbx=tcb_idx after resolve, r12=buf_va, r13=to_copy, r14=tcb_ptr) + sub rsp,8: entry rsp%16==8, four pushes (32 bytes) land rsp%16==8, the 8-byte pad brings it to 0. tcb_ptr MUST stay in a callee-save register here (unlike sys_send) because rx_head is re-read AND re-written after the nested user_write_bytes_via_walk call -- an earlier draft kept it in a caller-save scratch register and lost it across exactly that call. Reserved labels: sys_recv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        mov rsi, 0x1A5;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_recv_ebadf;

        mov rbx, rax;                          // tcb_idx
        mov rax, rbx;
        shl rax, 9;
        lea r14, [rip + _tcp_tcb_table];
        add r14, rax;                          // r14 = tcb_ptr

        mov rdx, [r14 + 0];
        cmp rdx, 4;
        je sys_recv_state_ok;
        cmp rdx, 7;
        je sys_recv_state_ok;
        jmp sys_recv_enotconn;
      sys_recv_state_ok:

        mov rax, [r14 + 184];
        mov rdx, [r14 + 176];
        sub rax, rdx;
        cmp rax, r13;
        jbe sys_recv_len_ok;
        mov rax, r13;
      sys_recv_len_ok:
        mov r13, rax;

        cmp r13, 0;
        je sys_recv_zero;

        mov rdi, r12;
        mov rax, rbx;
        shl rax, 12;
        lea rsi, [rip + _tcp_rx_buf_table];
        add rsi, rax;
        mov rax, [r14 + 176];
        add rsi, rax;
        mov rdx, r13;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sys_recv_efault;

        mov rdx, [r14 + 176];
        add rdx, r13;
        mov [r14 + 176], rdx;

        mov rax, r13;
        jmp sys_recv_done;

      sys_recv_zero:
        xor rax, rax;
        jmp sys_recv_done;

      sys_recv_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_recv_done;

      sys_recv_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_recv_done;

      sys_recv_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;

      sys_recv_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
