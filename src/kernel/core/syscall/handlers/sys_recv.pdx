// src/kernel/core/syscall/handlers/sys_recv.pdx — R72.M1-005 (#1927)
//                                                  R100-PREP-002 (#2008)
//
// sys_recv(fd, buf_va, len) -> bytes_read | -errno. SC+ ID 93.
//
// Both branches read directly out of a kernel-owned per-socket buffer
// (TCP: _tcp_rx_buf_table; UDP: _udp_rx_dgram_data) via the KPTI-safe
// user_write_bytes_via_walk. No intermediate kernel scratch is needed
// -- both tables are kernel memory.
//
// Dispatch by cap kind (via the generic tcp_socket_resolve):
//   KIND_TCP_SOCKET (0x1AB) -> stream-oriented read from the TCB's rx
//                              ring; available bytes = rx_tail -
//                              rx_head, up to len. Returns 0 on
//                              empty (non-blocking).
//   KIND_UDP_SOCKET (0x1A8) -> exactly ONE datagram dequeued; message
//                              boundary preserved (excess bytes
//                              DISCARDED if len < dgram_len -- Linux
//                              SOCK_DGRAM MSG_TRUNC posture). Returns
//                              0 on empty ring (non-blocking).
//   any other / not a socket -> -EBADF.

module SysRecv = structure {

  pub let SYS_RECV_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let SYS_RECV_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)
  pub let SYS_RECV_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT   (-14)
  pub let SYS_RECV_EACCES   : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES   (-13)

  pub let sys_recv_body : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, buf_va: u64, len: u64) -> unsafe {
      effects: {mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927) + R100-PREP-002 (#2008): sys_recv, SC+ ID 93. Resolves fd first as KIND_TCP_SOCKET; on hit, executes the R72 TCP branch (state must be ESTABLISHED(4) or CLOSE_WAIT(7); reads `min(rx_tail - rx_head, len)` bytes from _tcp_rx_buf_table via user_write_bytes_via_walk; advances rx_head). On TCP miss, resolves as KIND_UDP_SOCKET; on hit, executes the UDP branch: state must be CONNECTED(2); if rx_count==0 return 0 (non-blocking); else read len_slot at (sock<<5)+(head<<3), compute copy_len = min(dgram_len, len), user_write_bytes_via_walk copy_len bytes from data_slot at (sock<<12)+(head<<10), advance rx_head = (rx_head+1)&3, decrement rx_count. Message boundary preserved: one slot consumed per call regardless of copy_len (MSG_TRUNC posture -- excess bytes DISCARDED, not left for the next call). Both miss -> -EBADF. 4-push callee-save (rbx=target_idx after resolve, r12=buf_va, r13=len (also copy_len in UDP branch), r14=row_ptr) + sub rsp,8: entry rsp%16==8, four pushes (32 bytes) land rsp%16==8, the 8-byte pad brings it to 0 for the nested user_write_bytes_via_walk / user_ptr_ok / tcp_socket_resolve calls. row_ptr MUST stay in a callee-save register in both branches because rx_head is re-read AND re-written after the nested user_write_bytes_via_walk call. Reserved labels: sys_recv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_recv_have_tcp;

        // Try UDP.
        mov rdi, rbx;
        mov rsi, 0x1A8;                        // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sys_recv_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp sys_recv_done;

      sys_recv_have_tcp:
        // R95.M4-001 (paideia-os #2083): recv requires R_SOCKET_READ.
        // rsp%16==0 after the 4-push + sub rsp,8 prologue; push rax -> 8,
        // sub rsp,8 -> 0 for the call, then reverse.
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x001;                        // R_SOCKET_READ
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_recv_eaccess;
        jmp sys_recv_do_tcp;

      sys_recv_have_udp:
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x001;                        // R_SOCKET_READ
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_recv_eaccess;
        jmp sys_recv_do_udp;

      sys_recv_do_tcp:
        mov rbx, rax;                          // tcb_idx
        mov rax, rbx;
        shl rax, 9;
        lea r14, [rip + _tcp_tcb_table];
        add r14, rax;                          // r14 = tcb_ptr

        mov rdx, [r14 + 0];
        cmp rdx, 4;
        je sys_recv_tcp_state_ok;
        cmp rdx, 7;
        je sys_recv_tcp_state_ok;
        jmp sys_recv_enotconn;
      sys_recv_tcp_state_ok:

        mov rax, [r14 + 184];
        mov rdx, [r14 + 176];
        sub rax, rdx;
        cmp rax, r13;
        jbe sys_recv_tcp_len_ok;
        mov rax, r13;
      sys_recv_tcp_len_ok:
        mov r13, rax;

        cmp r13, 0;
        je sys_recv_zero;

        mov rdi, r12;
        mov rax, rbx;
        shl rax, 12;
        lea rsi, [rip + _tcp_rx_buf_table];
        add rsi, rax;
        mov rax, [r14 + 176];
        add rsi, rax;
        mov rdx, r13;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sys_recv_efault;

        mov rdx, [r14 + 176];
        add rdx, r13;
        mov [r14 + 176], rdx;

        mov rax, r13;
        jmp sys_recv_done;

      sys_recv_do_udp:
        mov rbx, rax;                          // sock_idx
        mov rax, rbx;
        shl rax, 7;
        lea r14, [rip + _udp_socket_table];
        add r14, rax;                          // r14 = row_ptr

        mov rdx, [r14 + 0];
        cmp rdx, 2;                            // UDP_ST_CONNECTED
        jne sys_recv_enotconn;

        mov rax, [r14 + 56];                   // rx_count
        cmp rax, 0;
        je sys_recv_zero;

        mov r8, [r14 + 40];                    // rx_head

        // Read dgram_len from len_slot @ (sock<<5)+(head<<3).
        mov rax, rbx; shl rax, 5;
        mov rcx, r8;  shl rcx, 3;
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_lens];
        add rcx, rax;
        mov rax, [rcx + 0];                    // dgram_len

        // copy_len = min(dgram_len, r13); overwrite r13.
        cmp rax, r13;
        jbe sys_recv_udp_len_ok;
        mov rax, r13;
      sys_recv_udp_len_ok:
        mov r13, rax;                          // r13 = copy_len

        // Copy if any bytes (empty datagram is legal -- still consumes slot).
        // user_write_bytes_via_walk enforces the KERNEL_VMA_BASE range gate
        // itself (see core/syscall/user_read.pdx §user_write_bytes_via_walk
        // #741 Layer 2), so no separate user_ptr_ok call is needed here --
        // matches the TCP recv branch above.
        cmp r13, 0;
        je sys_recv_udp_consume;

        // Compute data_slot ptr = &_udp_rx_dgram_data + (sock<<12) + (head<<10).
        mov rax, rbx; shl rax, 12;
        mov rcx, r8;  shl rcx, 10;
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_data];
        add rcx, rax;                          // rcx = data slot ptr

        mov rdi, r12;
        mov rsi, rcx;
        mov rdx, r13;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne sys_recv_efault;

      sys_recv_udp_consume:
        // Consume the slot regardless of copy_len (MSG_TRUNC posture).
        mov rax, r8;
        add rax, 1;
        and rax, 3;
        mov [r14 + 40], rax;                   // rx_head advance

        mov rax, [r14 + 56];
        sub rax, 1;
        mov [r14 + 56], rax;                   // rx_count decrement

        mov rax, r13;                          // return copy_len
        jmp sys_recv_done;

      sys_recv_zero:
        xor rax, rax;
        jmp sys_recv_done;

      sys_recv_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp sys_recv_done;

      sys_recv_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp sys_recv_done;

      sys_recv_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;           // -EACCES

      sys_recv_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
