// src/kernel/core/syscall/handlers/sys_framebuffer_create.pdx -- R105.M2-001
//
// sys_framebuffer_create(backend_cap_slot, width, height, fmt) -> fb_cap_slot | -errno
//
// Sysno 109. Mint a KIND_FRAMEBUFFER against a KIND_DISPLAY_BACKEND cap
// the caller holds. Returns a fresh cap_table slot ID containing a
// KIND_FRAMEBUFFER cap for the new fb row (rights = R_FB_MAP only --
// the compositor mints child caps with R_FB_FLIP separately via the
// cap_mint_write API; see design/graphics/authority-boundary.md).
//
// Sequence:
//   (1) Resolve backend_cap_slot -> KIND_DISPLAY_BACKEND row via
//       cap_table lookup. Kind mismatch or free slot -> -EBADF.
//   (2) fmt must be FB_FMT_BGRA8888 (1); reject others as -EINVAL.
//   (3) Read backend row's bar_pa and mmio_base (the LFB PA/VA pair).
//   (4) Call kind_framebuffer_mint_simple with a synthetic KIND_MEMORY
//       parent slot (SYSFB_MEMORY_STAGING_SLOT = 132) that the syscall
//       pre-mints for this call. The staging slot is scrubbed after
//       the mint completes.
//   (5) Free-scan cap_table for an open slot; cap_mint_write there with
//       kind = KIND_FRAMEBUFFER, rights = R_FB_MAP, target_ptr = fb row_id.
//   (6) Return the cap_table slot.
//
// R101 witness precedent: r101_stdvga_checkerboard.pdx uses this exact
// staging-slot pattern (its slot 131 is the sibling KIND_MEMORY parent).

module SysFramebufferCreate = structure {

  pub let SYSFB_STAGING_SLOT : u64 = 132   // free-by-construction, > R66v2 range

  pub let SYSFB_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYSFB_ERR_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA
  pub let SYSFB_ERR_ENOSPC : u64 = 0xFFFFFFFFFFFFFFE4
  pub let SYSFB_ERR_EIO    : u64 = 0xFFFFFFFFFFFFFFFB

  // Kind constants (paideia-as cross-module let resolution -- local copies).
  pub let SYSFB_KIND_DISPLAY_BACKEND : u64 = 0x1AE
  pub let SYSFB_KIND_FRAMEBUFFER     : u64 = 0x1AF
  pub let SYSFB_KIND_MEMORY          : u64 = 4
  pub let SYSFB_R_FB_MAP             : u64 = 0x001
  pub let SYSFB_RIGHT_MINT           : u64 = 0x200

  pub let sys_framebuffer_create_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (backend_cap_slot: u64) (width: u64) (height: u64) (fmt: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M2-001 (sysno 109): mint KIND_FRAMEBUFFER over a caller-held KIND_DISPLAY_BACKEND cap, publish into a fresh cap_table slot. Sequence: (1) backend cap lookup + kind gate; (2) fmt gate; (3) read backend row's bar_pa/mmio_base; (4) mint a transient KIND_MEMORY parent at SYSFB_STAGING_SLOT with target = bar_pa; (5) kind_framebuffer_mint_simple; (6) free-slot scan + cap_mint_write. Register plan: rbx=backend_cap_slot (reused for backend_row_id then fb_row_id), r12=width, r13=height, r14=fmt (reused for slot cursor), r15=bar_pa, rbp=lfb_va (mmio_base). 6 callee-save pushes leave rsp%16==8+48=56, sub rsp,8 -> 64%16==0. Labels prefixed sysfb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                    // backend_cap_slot (a0)
        mov r12, rsi;                    // width            (a1)
        mov r13, rdx;                    // height           (a2)
        mov r14, rcx;                    // fmt              (a3)

        // Gate: fmt == FB_FMT_BGRA8888 (1).
        cmp r14, 1;
        jne sysfb_einval;

        // Gate: backend_cap_slot < 256.
        cmp rbx, 256;
        jae sysfb_ebadf;

        // Read cap_table[backend_cap_slot] descriptor:
        //   [+0] = kind, [+8] = rights, [+16] = target_ptr
        // slot * 24 = slot*8 + slot*16.
        lea rax, [rip + cap_table];
        mov r10, rbx;
        shl r10, 3;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        add rax, r10;                    // rax = &cap_table[backend_cap_slot]

        // Kind check.
        mov r10, [rax + 0];
        mov r11, 0x1AE;                  // KIND_DISPLAY_BACKEND
        cmp r10, r11;
        jne sysfb_ebadf;

        // target_ptr holds the backend row_id (low bits).
        mov r10, [rax + 16];
        and r10, 0xFF;                   // dpyb row_id is < 4
        mov rbx, r10;                    // rbx = backend_row_id

        // Read backend row's bar_pa (row[+8]) and mmio_base (row[+16]).
        lea rax, [rip + _dpyb_table];
        mov r10, rbx;
        shl r10, 5;                      // row * 32
        add rax, r10;
        mov r15, [rax + 8];              // bar_pa
        mov rbp, [rax + 16];             // mmio_base (used as lfb_va)

        // If mmio_base is 0 (unmapped), fall back to bar_pa for lfb_va
        // -- Bochs stdvga case where the driver maps BAR0 into kernel VA.
        cmp rbp, 0;
        jne sysfb_lfb_va_ok;
        mov rbp, r15;
      sysfb_lfb_va_ok:

        // Step (4): mint transient KIND_MEMORY parent at SYSFB_STAGING_SLOT
        // with target = bar_pa, rights = RIGHT_MINT.
        mov rdi, 132;                    // SYSFB_STAGING_SLOT
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, r15;                    // target_ptr = bar_pa
        call cap_mint_write;

        // Step (5): kind_framebuffer_mint_simple(memory_slot=132,
        //   backend_row=rbx, width=r12, height=r13, lfb_pa=r15, lfb_va=rbp)
        mov rdi, 132;
        mov rsi, rbx;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r15;
        mov r9,  rbp;
        call kind_framebuffer_mint_simple;

        mov r10, 4;                      // FB_MAX
        cmp rax, r10;
        jae sysfb_eio;                   // mint refused -> fold to -EIO

        mov rbx, rax;                    // rbx = fb_row_id

        // Scrub the staging slot.
        mov rdi, 132;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // Step (6): free-slot scan of cap_table for kind==0.
        xor r14, r14;                    // r14 = slot cursor
      sysfb_scan:
        cmp r14, 256;
        jae sysfb_enospc;
        lea rax, [rip + cap_table];
        mov r10, r14;
        shl r10, 3;
        mov r11, r14;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov rcx, [rax + 0];
        cmp rcx, 0;
        je  sysfb_slot_ok;
        add r14, 1;
        jmp sysfb_scan;
      sysfb_slot_ok:

        // Mint KIND_FRAMEBUFFER cap: (slot, kind, rights, target=fb_row_id).
        mov rdi, r14;
        mov rsi, 0x1AF;                  // KIND_FRAMEBUFFER
        mov rdx, 0x001;                  // R_FB_MAP only (no R_FB_FLIP)
        mov rcx, rbx;                    // target_ptr = fb_row_id
        call cap_mint_write;

        // Return the cap slot.
        mov rax, r14;
        jmp sysfb_out;

      sysfb_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sysfb_out;
      sysfb_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        jmp sysfb_out;
      sysfb_enospc:
        mov rax, 0xFFFFFFFFFFFFFFE4;
        jmp sysfb_out;
      sysfb_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;

      sysfb_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
