// src/kernel/core/syscall/handlers/sys_setsockopt.pdx --
// R95.M1-001 (paideia-os #2076).
//
// sys_setsockopt(fd, level, optname, optval_va, optlen) -> 0 | -errno.
// SC+ ID 99 (design/user/syscall-table.md; the pre-R95 reservation
// stays intact -- this landing materializes the body).
//
// Scope at R95.M1:
//   level == SOL_SOCKET (1):
//     SO_REUSEADDR (2) -> set/clear bit 0 in the socket row's so_flags
//                         slot. Informational MVP: no bind-collision
//                         check exists at R95 (single-interface tree
//                         never trips it), so the flag is remembered
//                         but does not gate anything today. A future
//                         round that adds SO_REUSEPORT-style semantics
//                         checks the bit at bind time.
//     SO_NONBLOCK  (3) -> set/clear bit 1 in the socket row's so_flags
//                         slot. Informational MVP: recv() already
//                         returns 0 on an empty ring rather than
//                         blocking, so blocking-vs-not is a no-op
//                         difference for UDP today; the flag is
//                         remembered for the R96 sys_poll integration
//                         that reads it as the "return immediately on
//                         empty" hint. This is the paideia-os spelling
//                         of Linux's O_NONBLOCK-equivalent socket-side
//                         semantics.
//   level == IPPROTO_TCP (6):
//     TCP_NODELAY (100) -> accepted-and-remembered in the so_flags
//                          slot's bit 2, but silently no-op today:
//                          the R94 TCP stack does not implement Nagle
//                          yet, so disabling it is a nominal request.
//                          Kept in the handler so a userspace TCP
//                          client that ships with the Nagle-off habit
//                          links without patching.
//
// Any other (level, optname) pair -> -EINVAL. optlen is validated to
// be at least 4 bytes (all supported options are int-valued in the
// standard Linux ABI); optval_va is walked for a single 4-byte int
// via user_read_bytes_via_walk into a stack scratch.
//
// Dispatch by cap kind: KIND_TCP_SOCKET (0x1AB) or KIND_UDP_SOCKET
// (0x1A8) via tcp_socket_resolve. Non-socket fd -> -EBADF. Rights:
// setsockopt does not require any of the R_SOCKET_* bits at this
// landing (a caller who can name the fd can name its options); a
// future round that separates administrative options (e.g. TCP_MD5)
// would gate them here.
//
// Reserved-label discipline: ssopt_ prefix.

module SysSetsockopt = structure {

  pub let SYS_SETSOCKOPT_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_SETSOCKOPT_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let SYS_SETSOCKOPT_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT (-14)

  pub let SOL_SOCKET    : u64 = 1
  pub let IPPROTO_TCP   : u64 = 6

  pub let SO_REUSEADDR  : u64 = 2
  pub let SO_NONBLOCK   : u64 = 3
  pub let SO_ERROR      : u64 = 4
  pub let SO_TYPE       : u64 = 5
  pub let TCP_NODELAY   : u64 = 100

  pub let SO_FLAG_REUSEADDR_BIT : u64 = 0x1
  pub let SO_FLAG_NONBLOCK_BIT  : u64 = 0x2
  pub let SO_FLAG_TCPNODELAY_BIT : u64 = 0x4

  // Row-offset constants (documentation; inlined at use sites per
  // paideia-as cross-module-let non-fold discipline).
  //   UDP row so_flags @+72; TCP row so_flags @+216 (kept out of the
  //   first-half-row-hot-path zone; see net/tcp.pdx TCB layout comment
  //   -- the pre-R95 reserved band starts at +208 with mss occupying
  //   +200, so so_flags at +216 is the first free 8-byte slot).
  pub let UDP_ROW_SO_FLAGS_OFF : u64 = 72
  pub let TCP_ROW_SO_FLAGS_OFF : u64 = 216

  // Per-syscall bounce scratch. 8 bytes suffices for the 4-byte int
  // this landing supports; sized at 8 for u64 alignment and future
  // options that carry a struct linger (8 bytes).
  pub let mut _sys_setsockopt_scratch : [u8; 8] = uninit @align(8)

  pub let sys_setsockopt_body : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, level: u64, optname: u64, optval_va: u64, optlen: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R95.M1-001 (paideia-os #2076): sys_setsockopt, SC+ ID 99. Resolves fd via tcp_socket_resolve for both KIND_TCP_SOCKET (0x1AB) and KIND_UDP_SOCKET (0x1A8); both miss -> -EBADF. Validates optlen >= 4 (all supported options are int-valued); user_ptr_ok + user_read_bytes_via_walk into _sys_setsockopt_scratch for the 4-byte int payload. Dispatches on (level, optname) pair: (SOL_SOCKET, SO_REUSEADDR|SO_NONBLOCK) set/clear the corresponding bit in the row's so_flags slot (UDP @+72, TCP @+216) -- both are informational MVP flags (single-interface tree never trips REUSEADDR; recv is already non-blocking for the UDP path). (IPPROTO_TCP, TCP_NODELAY) same shape, silently no-op today (R94 has no Nagle). Any other pair -> -EINVAL. 5-push callee-save (rbx=fd, r12=level, r13=optname, r14=optval_va, r15=optlen) + sub rsp,8: entry rsp%16==8, 5 pushes (40 bytes) land rsp%16==0, 8-byte pad brings to 8 -- ok, we need 0 for nested calls. Actually 40+8=48, %16==0 for calls -- correct. Reserved labels: ssopt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // Alignment: entry rsp%16==8; 5 pushes (40 bytes) land at
        // rsp%16==0 -- exactly what every nested call needs. No sub
        // rsp,8 pad; adding one would misalign every downstream call.

        mov rbx, rdi;                          // fd
        mov r12, rsi;                          // level
        mov r13, rdx;                          // optname
        mov r14, rcx;                          // optval_va
        mov r15, r8;                           // optlen

        // Length gate: at least 4 bytes for an int payload.
        mov rax, 4;
        cmp r15, rax;
        jb ssopt_einval;

        // Resolve fd. Try TCP then UDP; both miss -> -EBADF.
        // rax carries idx on hit; discarded below since the option
        // dispatch reloads via bit-manipulation on the shared so_flags
        // slot.
        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne ssopt_have_tcp;

        mov rdi, rbx;
        mov rsi, 0x1A8;                        // KIND_UDP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne ssopt_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp ssopt_done;

      ssopt_have_tcp:
        // rax = tcb_idx. Compute row_ptr in r10 (caller-save, ok --
        // no nested call between here and the write). Row stride = 512
        // -> shl 9.
        mov r10, rax;
        shl r10, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add r10, rcx;                          // r10 = row_ptr
        jmp ssopt_have_row_tcp;

      ssopt_have_udp:
        // rax = sock_idx. Row stride = 128 -> shl 7.
        mov r10, rax;
        shl r10, 7;
        lea rcx, [rip + _udp_socket_table];
        add r10, rcx;                          // r10 = row_ptr
        jmp ssopt_have_row_udp;

      ssopt_have_row_tcp:
        // Copy 4 bytes of user int via user_ptr_ok + walker into
        // scratch. r10 stays live across the calls (caller-save r10
        // will NOT survive -- rebuild post-call from rax = tcb_idx).
        // Simpler: save the row_ptr on the stack.
        push r10;                              // save row_ptr (%16 0->8)
        sub rsp, 8;                            // align (%16 8->0)
        mov rdi, r14;                          // buf
        mov rsi, r15;                          // len
        call user_ptr_ok;
        cmp rax, 0;
        jne ssopt_efault_pop2_tcp;

        lea rdi, [rip + _sys_setsockopt_scratch];
        mov rsi, r14;
        mov rdx, 4;                            // only 4 bytes needed
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne ssopt_efault_pop2_tcp;

        add rsp, 8;
        pop r10;                               // restore row_ptr

        // Dispatch by (level, optname). Load int value from scratch.
        xor rax, rax;
        mov_b rax, [rip + _sys_setsockopt_scratch + 0];     // low byte
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 1];
        shl rcx, 8;
        add rax, rcx;
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 2];
        shl rcx, 16;
        add rax, rcx;
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 3];
        shl rcx, 24;
        add rax, rcx;                          // rax = int optval

        // TCP so_flags @+216.
        cmp r12, 1;                            // SOL_SOCKET
        je ssopt_sol_tcp;
        cmp r12, 6;                            // IPPROTO_TCP
        je ssopt_ipproto_tcp;
        jmp ssopt_einval;

      ssopt_sol_tcp:
        cmp r13, 2;                            // SO_REUSEADDR
        je ssopt_tcp_reuseaddr;
        cmp r13, 3;                            // SO_NONBLOCK
        je ssopt_tcp_nonblock;
        jmp ssopt_einval;

      ssopt_tcp_reuseaddr:
        mov rcx, [r10 + 216];
        cmp rax, 0;
        je ssopt_tcp_reuseaddr_clear;
        or rcx, 1;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;
      ssopt_tcp_reuseaddr_clear:
        mov rdx, 0xFFFFFFFFFFFFFFFE;
        and rcx, rdx;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;

      ssopt_tcp_nonblock:
        mov rcx, [r10 + 216];
        cmp rax, 0;
        je ssopt_tcp_nonblock_clear;
        or rcx, 2;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;
      ssopt_tcp_nonblock_clear:
        mov rdx, 0xFFFFFFFFFFFFFFFD;
        and rcx, rdx;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;

      ssopt_ipproto_tcp:
        cmp r13, 100;                          // TCP_NODELAY
        jne ssopt_einval;
        mov rcx, [r10 + 216];
        cmp rax, 0;
        je ssopt_tcp_nodelay_clear;
        or rcx, 4;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;
      ssopt_tcp_nodelay_clear:
        mov rdx, 0xFFFFFFFFFFFFFFFB;
        and rcx, rdx;
        mov [r10 + 216], rcx;
        xor rax, rax;
        jmp ssopt_done;

      ssopt_have_row_udp:
        push r10;
        sub rsp, 8;
        mov rdi, r14;
        mov rsi, r15;
        call user_ptr_ok;
        cmp rax, 0;
        jne ssopt_efault_pop2_udp;

        lea rdi, [rip + _sys_setsockopt_scratch];
        mov rsi, r14;
        mov rdx, 4;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne ssopt_efault_pop2_udp;

        add rsp, 8;
        pop r10;

        xor rax, rax;
        mov_b rax, [rip + _sys_setsockopt_scratch + 0];
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 1];
        shl rcx, 8;
        add rax, rcx;
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 2];
        shl rcx, 16;
        add rax, rcx;
        xor rcx, rcx;
        mov_b rcx, [rip + _sys_setsockopt_scratch + 3];
        shl rcx, 24;
        add rax, rcx;                          // rax = int optval

        // UDP so_flags @+72.
        cmp r12, 1;                            // SOL_SOCKET
        jne ssopt_einval;

        cmp r13, 2;                            // SO_REUSEADDR
        je ssopt_udp_reuseaddr;
        cmp r13, 3;                            // SO_NONBLOCK
        je ssopt_udp_nonblock;
        jmp ssopt_einval;

      ssopt_udp_reuseaddr:
        mov rcx, [r10 + 72];
        cmp rax, 0;
        je ssopt_udp_reuseaddr_clear;
        or rcx, 1;
        mov [r10 + 72], rcx;
        xor rax, rax;
        jmp ssopt_done;
      ssopt_udp_reuseaddr_clear:
        mov rdx, 0xFFFFFFFFFFFFFFFE;
        and rcx, rdx;
        mov [r10 + 72], rcx;
        xor rax, rax;
        jmp ssopt_done;

      ssopt_udp_nonblock:
        mov rcx, [r10 + 72];
        cmp rax, 0;
        je ssopt_udp_nonblock_clear;
        or rcx, 2;
        mov [r10 + 72], rcx;
        xor rax, rax;
        jmp ssopt_done;
      ssopt_udp_nonblock_clear:
        mov rdx, 0xFFFFFFFFFFFFFFFD;
        and rcx, rdx;
        mov [r10 + 72], rcx;
        xor rax, rax;
        jmp ssopt_done;

      ssopt_efault_pop2_tcp:
        add rsp, 8;
        pop r10;
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT
        jmp ssopt_done;

      ssopt_efault_pop2_udp:
        add rsp, 8;
        pop r10;
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp ssopt_done;

      ssopt_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      ssopt_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
