// src/kernel/core/syscall/handlers/sys_getpeername.pdx --
// R95.M2-001 (paideia-os #2078).
//
// sys_getpeername(fd, sockaddr_out_va) -> 0 | -errno. SC+ ID 100.
//
// Writes an 8-byte record at sockaddr_out_va:
//   +0  ip     (u32, packed MSB-first the same way sys_connect
//               accepts remote_ip; bytes at +0..+3 are a.b.c.d)
//   +4  port   (u32, LE; the low 16 bits carry the real port)
//
// This is NOT a Linux sockaddr_in (14 bytes with family/pad); it is
// the paideia-os collapsed ABI matching sys_connect's
// (remote_ip: packed u32, remote_port: u16 in u64) shape. A future
// round that grows a real sockaddr_in gate widens the record here in
// lockstep.
//
// Dispatch by cap kind:
//   KIND_TCP_SOCKET (0x1AB) -> TCB @+32..+35 (remote_ip byte-indexed)
//                              + TCB @+16 (remote_port). Requires
//                              state >= SYN_SENT (i.e. peer known);
//                              CLOSED -> -ENOTCONN.
//   KIND_UDP_SOCKET (0x1A8) -> row @+24..+27 (peer_ip byte-indexed)
//                              + row @+16 (peer_port). Requires
//                              state == CONNECTED (2); anything else
//                              -> -ENOTCONN.
//   any other / not a socket -> -EBADF.
//
// Reserved-label discipline: gspn_ prefix.

module SysGetpeername = structure {

  pub let SYS_GETPEERNAME_EBADF    : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let SYS_GETPEERNAME_ENOTCONN : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)
  pub let SYS_GETPEERNAME_EFAULT   : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT   (-14)

  pub let mut _sys_getpeername_scratch : [u8; 8] = uninit @align(8)

  pub let sys_getpeername_body : (u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, sockaddr_out_va: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R95.M2-001 (paideia-os #2078): sys_getpeername, SC+ ID 100. Resolves fd via tcp_socket_resolve for both socket kinds; both miss -> -EBADF. Reads (peer_ip, peer_port) from the resolved row -- for TCP requires state != CLOSED (0), for UDP requires state == CONNECTED (2); mismatch -> -ENOTCONN. Composes the 8-byte record in _sys_getpeername_scratch (packed u32 IP + u32 port), gate-and-walks the 8 bytes out to sockaddr_out_va. 3-push callee-save (rbx=fd, r12=sockaddr_out_va, r13=row_ptr) + sub rsp,8. Reserved labels: gspn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        // Alignment: entry rsp%16==8; 3 pushes (24 bytes) land at
        // rsp%16==0 -- no sub rsp,8 pad needed.

        mov rbx, rdi;
        mov r12, rsi;                          // sockaddr_out_va

        // Try TCP first.
        mov rdi, rbx;
        mov rsi, 0x1AB;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gspn_have_tcp;

        mov rdi, rbx;
        mov rsi, 0x1A8;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gspn_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp gspn_done;

      gspn_have_tcp:
        // rax = tcb_idx. Row @+32..+35 = remote_ip; @+16 = remote_port.
        mov r13, rax;
        shl r13, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add r13, rcx;                          // r13 = tcb_ptr

        mov rax, [r13 + 0];                    // state
        cmp rax, 0;                            // CLOSED?
        je gspn_enotconn;

        // Compose packed peer_ip in rax: (b0<<24)|(b1<<16)|(b2<<8)|b3.
        xor rax, rax; mov_b rax, [r13 + 32]; shl rax, 24;
        xor rcx, rcx; mov_b rcx, [r13 + 33]; shl rcx, 16; add rax, rcx;
        xor rcx, rcx; mov_b rcx, [r13 + 34]; shl rcx, 8;  add rax, rcx;
        xor rcx, rcx; mov_b rcx, [r13 + 35];              add rax, rcx;
        // Stamp bytes into scratch: +0..+3 (packed LE of the composed u32)
        // MATCH sys_connect's arg convention: the caller sees the SAME
        // u32 bit pattern (bits [31:24]=a, [7:0]=d for a.b.c.d) it would
        // pass to sys_connect. So write it MSB-first at +0..+3 (u32 BE):
        // +0=a, +1=b, +2=c, +3=d.
        mov rcx, rax; shr rcx, 24; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 0], rcx;
        mov rcx, rax; shr rcx, 16; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 1], rcx;
        mov rcx, rax; shr rcx, 8;  and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 2], rcx;
        mov rcx, rax; and rcx, 0xFF;              mov_b [rip + _sys_getpeername_scratch + 3], rcx;

        // Port u32 LE @+4..+7 (only low 16 bits meaningful).
        mov rax, [r13 + 16];
        mov rcx, rax; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 4], rcx;
        mov rcx, rax; shr rcx, 8; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 5], rcx;
        xor rcx, rcx; mov_b [rip + _sys_getpeername_scratch + 6], rcx;
        mov_b [rip + _sys_getpeername_scratch + 7], rcx;
        jmp gspn_write_out;

      gspn_have_udp:
        mov r13, rax;
        shl r13, 7;
        lea rcx, [rip + _udp_socket_table];
        add r13, rcx;                          // r13 = row_ptr

        mov rax, [r13 + 0];
        cmp rax, 2;                            // UDP_ST_CONNECTED
        jne gspn_enotconn;

        // UDP row: peer_ip @+24..+27 (byte-indexed, MSB at +24).
        xor rax, rax; mov_b rax, [r13 + 24]; mov_b [rip + _sys_getpeername_scratch + 0], rax;
        xor rax, rax; mov_b rax, [r13 + 25]; mov_b [rip + _sys_getpeername_scratch + 1], rax;
        xor rax, rax; mov_b rax, [r13 + 26]; mov_b [rip + _sys_getpeername_scratch + 2], rax;
        xor rax, rax; mov_b rax, [r13 + 27]; mov_b [rip + _sys_getpeername_scratch + 3], rax;

        // peer_port @+16.
        mov rax, [r13 + 16];
        mov rcx, rax; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 4], rcx;
        mov rcx, rax; shr rcx, 8; and rcx, 0xFF; mov_b [rip + _sys_getpeername_scratch + 5], rcx;
        xor rcx, rcx; mov_b [rip + _sys_getpeername_scratch + 6], rcx;
        mov_b [rip + _sys_getpeername_scratch + 7], rcx;

      gspn_write_out:
        mov rdi, r12;
        mov rsi, 8;
        call user_ptr_ok;
        cmp rax, 0;
        jne gspn_efault;

        mov rdi, r12;
        lea rsi, [rip + _sys_getpeername_scratch];
        mov rdx, 8;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne gspn_efault;

        xor rax, rax;
        jmp gspn_done;

      gspn_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;
        jmp gspn_done;

      gspn_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;

      gspn_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
