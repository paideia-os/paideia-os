// src/kernel/core/syscall/handlers/sys_shutdown.pdx — R72.M1-005 (#1927)
//                                                      R94.M3-002 (#2066)
//
// sys_shutdown(fd, how) -> 0 | -errno. SC+ ID 94. `how` is now
// differentiated (R94.M3-002):
//   SHUT_RD   (0): local-only mark; subsequent recv() returns 0. No FIN.
//   SHUT_WR   (1): local-only mark AND drive tcp_close (ESTABLISHED ->
//                  FIN_WAIT_1 or CLOSE_WAIT -> LAST_ACK) -- the wire
//                  half of half-close.
//   SHUT_RDWR (2): both of the above.
// Values > 2 are silently ignored (a no-op) rather than -EINVAL,
// matching pre-R94 sys_shutdown's own posture of tolerating out-of-
// range `how`. tcp_shutdown_how in net/tcp.pdx is the typed body.

module SysShutdown = structure {

  pub let SYS_SHUTDOWN_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF (-9)
  pub let SYS_SHUTDOWN_EACCES : u64 = 0xFFFFFFFFFFFFFFF3   // -EACCES (-13)

  pub let sys_shutdown_body : (u64, u64) -> u64 !{sysreg, mem} @{cap} =
    fn (fd: u64, how: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {cap},
      justification: "R72.M1-005 + R94.M3-002 (#1927/#2066): sys_shutdown, SC+ ID 94. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. R94.M3-002 now forwards `how` to tcp_shutdown_how which distinguishes SHUT_RD (local read-shut only, no FIN), SHUT_WR (local write-shut AND tcp_close), SHUT_RDWR (both). Pre-R94 the sys_shutdown always called tcp_close regardless of `how`; the extended body preserves that behavior for SHUT_WR/SHUT_RDWR AND accepts SHUT_RD for the first time. tcp_shutdown_how is idempotent on both the flag store and the wire-close primitive it wraps, so shutdown() twice remains safe. 2-push callee-save (rbx=fd, r12=how): entry rsp%16==8, two pushes 16 bytes land %16==8, sub 8 -> 0 for the call, then reverse.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        mov rsi, 0x1AB;                        // KIND_TCP_SOCKET (fix#2005)
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_shutdown_ebadf;

        // R95.M4-001 (paideia-os #2083): shutdown requires R_SOCKET_WRITE.
        // Even SHUT_RD requires R_SOCKET_WRITE: the local-mark-only path
        // is still a state-mutation on the socket that a read-only cap
        // holder must not be permitted to make (the same rationale
        // sys_close would apply if it existed on this cap kind).
        push rax;
        sub rsp, 8;
        mov rdi, rbx;
        mov rsi, 0x002;                        // R_SOCKET_WRITE
        call sock_cap_check_rights;
        mov rdx, rax;
        add rsp, 8;
        pop rax;
        cmp rdx, 0;
        jne sys_shutdown_eaccess;

        mov rdi, rax;                          // tcb_idx
        mov rsi, r12;                          // how
        call tcp_shutdown_how;

        xor rax, rax;
        jmp sys_shutdown_done;

      sys_shutdown_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;
        jmp sys_shutdown_done;

      sys_shutdown_eaccess:
        mov rax, 0xFFFFFFFFFFFFFFF3;           // -EACCES

      sys_shutdown_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
