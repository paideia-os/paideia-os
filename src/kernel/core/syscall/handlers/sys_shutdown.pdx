// src/kernel/core/syscall/handlers/sys_shutdown.pdx — R72.M1-005 (#1927)
//
// sys_shutdown(fd, how) -> 0 | -errno. SC+ ID 94. `how` (SHUT_RD /
// SHUT_WR / SHUT_RDWR) is accepted but not differentiated -- this MVP
// only implements a full-duplex close via net/tcp.pdx's tcp_close,
// which drives ESTABLISHED -> FIN_WAIT_1 or CLOSE_WAIT -> LAST_ACK.
// Half-close (SHUT_WR while still reading) is deferred.

module SysShutdown = structure {

  pub let SYS_SHUTDOWN_EBADF : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF (-9)

  pub let sys_shutdown_body : (u64, u64) -> u64 !{sysreg, mem} @{cap} =
    fn (fd: u64, how: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_shutdown, SC+ ID 94. Resolves fd via tcp_socket_resolve(fd, KIND_TCP_SOCKET) -- -EBADF on a miss. `how` is intentionally unused: this MVP has one close primitive (tcp_close) that always drives a full-duplex FIN, since SHUT_RD-only / SHUT_WR-only half-close semantics have no distinct TCB representation at this landing. tcp_close itself is idempotent on a non-ESTABLISHED/non-CLOSE_WAIT state (a no-op), so a caller invoking shutdown() twice, or on a socket that never connected, cannot resend a stray FIN. 1-push callee-save (rbx=fd): entry rsp%16==8, one push lands rsp%16==0 for both nested calls.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        mov rsi, 0x1A5;                        // KIND_TCP_SOCKET
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je sys_shutdown_ebadf;

        mov rdi, rax;
        call tcp_close;

        xor rax, rax;
        jmp sys_shutdown_done;

      sys_shutdown_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;

      sys_shutdown_done:
        pop rbx;
        ret
      }
    }
}
