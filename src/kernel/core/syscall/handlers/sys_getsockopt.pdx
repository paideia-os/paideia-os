// src/kernel/core/syscall/handlers/sys_getsockopt.pdx --
// R95.M1-002 (paideia-os #2077).
//
// sys_getsockopt(fd, level, optname, optval_va, optlen_va)
//   -> 0 | -errno. SC+ ID 98.
//
// Scope at R95.M1:
//   level == SOL_SOCKET (1):
//     SO_REUSEADDR (2) -> read bit 0 from row.so_flags into a 4-byte
//                         int at *optval_va (0 or 1); write 4 into
//                         *optlen_va.
//     SO_NONBLOCK  (3) -> read bit 1 into 4-byte int similarly.
//     SO_ERROR     (4) -> read the row.so_error slot's low 32 bits
//                         (signed) into *optval_va; then CLEAR the slot
//                         (POSIX "SO_ERROR consumes the pending
//                         error"). Sockets that never encountered an
//                         async error report 0. R94's TCP path never
//                         populates so_error at R95 (deferred to R96),
//                         so a TCP socket always reads 0 here; the
//                         UDP path likewise -- no async error source
//                         exists in the loopback fast path.
//     SO_TYPE      (5) -> derived from cap kind rather than a stored
//                         field: KIND_TCP_SOCKET -> SOCK_STREAM (1);
//                         KIND_UDP_SOCKET -> SOCK_DGRAM (2). The cap
//                         is authoritative because sys_socket names
//                         type at mint time -- no state field can
//                         diverge.
//   level == IPPROTO_TCP (6):
//     TCP_NODELAY (100) -> read bit 2 of TCP so_flags.
//
// Any other pair -> -EINVAL. Both optval_va and optlen_va are user
// pointers; they get user_ptr_ok + user_write_bytes_via_walk.
//
// Reserved-label discipline: gsopt_ prefix.

module SysGetsockopt = structure {

  pub let SYS_GETSOCKOPT_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF  (-9)
  pub let SYS_GETSOCKOPT_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)
  pub let SYS_GETSOCKOPT_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2   // -EFAULT (-14)

  pub let SOCK_STREAM   : u64 = 1
  pub let SOCK_DGRAM    : u64 = 2

  // Per-syscall bounce scratch. 8 bytes: 4 for the int value + 4 for
  // the length write (or one qword for both).
  pub let mut _sys_getsockopt_val_scratch  : [u8; 8] = uninit @align(8)
  pub let mut _sys_getsockopt_len_scratch  : [u8; 8] = uninit @align(8)

  pub let sys_getsockopt_body : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (fd: u64, level: u64, optname: u64, optval_va: u64, optlen_va: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R95.M1-002 (paideia-os #2077): sys_getsockopt, SC+ ID 98. Resolves fd via tcp_socket_resolve for KIND_TCP_SOCKET (0x1AB) and KIND_UDP_SOCKET (0x1A8); both miss -> -EBADF. Dispatches on (level, optname): SOL_SOCKET/SO_REUSEADDR|SO_NONBLOCK reads the corresponding bit from row.so_flags (UDP @+72, TCP @+216); SOL_SOCKET/SO_ERROR reads (and clears) row.so_error (UDP @+64, TCP @+208 -- new slot); SOL_SOCKET/SO_TYPE derives value from the resolved kind (STREAM=1 for TCP, DGRAM=2 for UDP). IPPROTO_TCP/TCP_NODELAY reads bit 2 of TCP so_flags. Writes the 4-byte int value to *optval_va and length=4 to *optlen_va via user_write_bytes_via_walk. 5-push callee-save (rbx=fd, r12=level, r13=optname, r14=optval_va, r15=optlen_va) + sub rsp,8 for %16 alignment. Reserved labels: gsopt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // Alignment: entry rsp%16==8; 5 pushes (40 bytes) land at
        // rsp%16==0 -- exactly what every nested call needs. No sub
        // rsp,8 pad; adding one would misalign every downstream call.

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;                          // optval_va
        mov r15, r8;                           // optlen_va

        // Resolve TCP first, then UDP.
        mov rdi, rbx;
        mov rsi, 0x1AB;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gsopt_have_tcp;

        mov rdi, rbx;
        mov rsi, 0x1A8;
        call tcp_socket_resolve;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne gsopt_have_udp;

        mov rax, 0xFFFFFFFFFFFFFFF7;           // -EBADF
        jmp gsopt_done;

      gsopt_have_tcp:
        // rax = tcb_idx. row_ptr in r10.
        mov r10, rax;
        shl r10, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add r10, rcx;                          // r10 = tcb_ptr

        // Dispatch on (level, optname). Compute int value into r11.
        cmp r12, 1;                            // SOL_SOCKET
        je gsopt_tcp_sol;
        cmp r12, 6;                            // IPPROTO_TCP
        je gsopt_tcp_ipproto;
        jmp gsopt_einval;

      gsopt_tcp_sol:
        cmp r13, 2;                            // SO_REUSEADDR
        je gsopt_tcp_reuseaddr;
        cmp r13, 3;                            // SO_NONBLOCK
        je gsopt_tcp_nonblock;
        cmp r13, 4;                            // SO_ERROR
        je gsopt_tcp_error;
        cmp r13, 5;                            // SO_TYPE
        je gsopt_tcp_type;
        jmp gsopt_einval;

      gsopt_tcp_reuseaddr:
        mov rax, [r10 + 216];
        and rax, 1;
        mov r11, rax;
        jmp gsopt_write_val_and_len;

      gsopt_tcp_nonblock:
        mov rax, [r10 + 216];
        shr rax, 1;
        and rax, 1;
        mov r11, rax;
        jmp gsopt_write_val_and_len;

      gsopt_tcp_error:
        mov rax, [r10 + 208];                  // so_error (new TCP slot)
        mov r11, rax;
        xor rax, rax;
        mov [r10 + 208], rax;                  // clear on read
        jmp gsopt_write_val_and_len;

      gsopt_tcp_type:
        mov r11, 1;                            // SOCK_STREAM
        jmp gsopt_write_val_and_len;

      gsopt_tcp_ipproto:
        cmp r13, 100;                          // TCP_NODELAY
        jne gsopt_einval;
        mov rax, [r10 + 216];
        shr rax, 2;
        and rax, 1;
        mov r11, rax;
        jmp gsopt_write_val_and_len;

      gsopt_have_udp:
        // rax = sock_idx. row_ptr in r10.
        mov r10, rax;
        shl r10, 7;
        lea rcx, [rip + _udp_socket_table];
        add r10, rcx;                          // r10 = row_ptr

        cmp r12, 1;                            // SOL_SOCKET only for UDP
        jne gsopt_einval;

        cmp r13, 2;                            // SO_REUSEADDR
        je gsopt_udp_reuseaddr;
        cmp r13, 3;                            // SO_NONBLOCK
        je gsopt_udp_nonblock;
        cmp r13, 4;                            // SO_ERROR
        je gsopt_udp_error;
        cmp r13, 5;                            // SO_TYPE
        je gsopt_udp_type;
        jmp gsopt_einval;

      gsopt_udp_reuseaddr:
        mov rax, [r10 + 72];
        and rax, 1;
        mov r11, rax;
        jmp gsopt_write_val_and_len;

      gsopt_udp_nonblock:
        mov rax, [r10 + 72];
        shr rax, 1;
        and rax, 1;
        mov r11, rax;
        jmp gsopt_write_val_and_len;

      gsopt_udp_error:
        mov rax, [r10 + 64];                   // so_error
        mov r11, rax;
        xor rax, rax;
        mov [r10 + 64], rax;                   // clear on read
        jmp gsopt_write_val_and_len;

      gsopt_udp_type:
        mov r11, 2;                            // SOCK_DGRAM
        jmp gsopt_write_val_and_len;

      gsopt_write_val_and_len:
        // Stamp low 4 bytes of r11 into _sys_getsockopt_val_scratch.
        mov rax, r11;
        and rax, 0xFF;
        mov_b [rip + _sys_getsockopt_val_scratch + 0], rax;
        mov rax, r11; shr rax, 8; and rax, 0xFF;
        mov_b [rip + _sys_getsockopt_val_scratch + 1], rax;
        mov rax, r11; shr rax, 16; and rax, 0xFF;
        mov_b [rip + _sys_getsockopt_val_scratch + 2], rax;
        mov rax, r11; shr rax, 24; and rax, 0xFF;
        mov_b [rip + _sys_getsockopt_val_scratch + 3], rax;

        // Stamp 4 as u32 LE into _sys_getsockopt_len_scratch.
        mov rax, 4;
        mov_b [rip + _sys_getsockopt_len_scratch + 0], rax;
        xor rax, rax;
        mov_b [rip + _sys_getsockopt_len_scratch + 1], rax;
        mov_b [rip + _sys_getsockopt_len_scratch + 2], rax;
        mov_b [rip + _sys_getsockopt_len_scratch + 3], rax;

        // Gate + walk-write optval (4 bytes).
        mov rdi, r14;
        mov rsi, 4;
        call user_ptr_ok;
        cmp rax, 0;
        jne gsopt_efault;

        mov rdi, r14;
        lea rsi, [rip + _sys_getsockopt_val_scratch];
        mov rdx, 4;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne gsopt_efault;

        // Gate + walk-write optlen (4 bytes).
        mov rdi, r15;
        mov rsi, 4;
        call user_ptr_ok;
        cmp rax, 0;
        jne gsopt_efault;

        mov rdi, r15;
        lea rsi, [rip + _sys_getsockopt_len_scratch];
        mov rdx, 4;
        call user_write_bytes_via_walk;
        cmp rax, 0;
        jne gsopt_efault;

        xor rax, rax;
        jmp gsopt_done;

      gsopt_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        jmp gsopt_done;

      gsopt_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      gsopt_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
