// src/kernel/core/syscall/handlers/sys_pdxfs_undo_write.pdx
// R90-XREPO.010.M1-004 (paideia-os #2112): sys_pdxfs_undo_write body.
//
// The ring-3-facing UNDO-RECORD persistence primitive.  Complements the
// R42-PREP-007 sys_pdxfs_txn_open (sysno 70) + R90-XREPO.010.M1-003
// sys_pdxfs_txn_{commit,abort} (sysnos 104/105) trio: a caller opens a
// txn, calls sys_pdxfs_undo_write BEFORE each file mutation (staging the
// pre-image bytes into the txn's undo buffer), and either commits (no
// undo replay) or aborts (undo records are replayed in REVERSE order to
// restore each pre-image).  Closes the I5 invariant for cp / mv / rm at
// the syscall layer (design/round-retrospectives/r90-xrepo-wave3-plan.
// md §2).
//
// Contract (SysV, 5 args after the dispatch shim's SysV shuffle):
//   rdi = cap_slot     -- KIND_PDXFS_TXN cap slot returned by sys_
//                         pdxfs_txn_open (must be OPEN)
//   rsi = inode_no     -- target inode (tmpfs idx at M1; low 16 bits)
//   rdx = offset       -- starting byte offset within the file
//   rcx = len          -- snapshot length in bytes (> 0 && <= 4064)
//   r8  = kbuf_ptr     -- KERNEL VA of the pre-image bytes (dispatch
//                         shim's KPTI bounce delivers a kernel scratch
//                         here; a boot witness passes a .rodata pointer
//                         directly since boot context bypasses the shim)
//   -> rax = 0 on success, or a negative-errno u64 on failure:
//        -EBADF   (0xFFFFFFFFFFFFFFF7 = -9)  -- cap_slot does not name
//                                              a live KIND_PDXFS_TXN
//        -EINVAL  (0xFFFFFFFFFFFFFFEA = -22) -- row not OPEN; or the
//                                              undo substrate refused
//                                              (row OOR / len == 0)
//        -ENOSPC  (0xFFFFFFFFFFFFFFE4 = -28) -- per-row undo buffer or
//                                              record cap exhausted
//        <any pdxfs_txn_undo_append sentinel> -- forwarded verbatim
//
// Sequencing (mirrors sys_pdxfs_txn_abort's cap-slot resolution shape):
//   (1) pdxfs_txn_row_of_slot(cap_slot) -> row_id in [0, 16) or
//       PXT_ROW_NONE (0xFF).  PXT_ROW_NONE collapses to -EBADF.
//   (2) pdxfs_txn_row_state(row_id) -- must == PXT_STATE_OPEN (1).
//       Any other state (COMMITTED / ABORTED / EXPIRED) returns
//       -EINVAL so a caller that races an abort with an undo_write
//       sees a clean refusal rather than a silent buffer append into
//       a row whose replay will never run.
//   (3) pdxfs_txn_undo_append(row_id, inode_no, offset, len, kbuf_ptr)
//       -- the substrate's own gates handle the len bounds + row cap
//       + buffer overflow refusals (see undo.pdx §2).  Non-zero
//       return propagates verbatim.
//   (4) Emit `sys pdxfs undo write ok [legacy: SYS PDXFS UNDO WRITE
//       OK] -- txn=<row> len=<n>` via klog_s1_d2(SUBSYS_FS_, tag_sys_
//       pdxfs_undo_write_ok, k_txn, row_id, k_len, len).
//   (5) Return 0.
//
// SCOPE NOTE (durability): undo records live in kernel .bss (see undo.
// pdx §0) at this landing.  A crash between the sys_pdxfs_undo_write
// call and the eventual sys_pdxfs_txn_abort loses every staged
// pre-image -- callers relying on crash-safe undo await the future
// widening that folds these records into the PdxFS journal.  This
// matches design/round-retrospectives/r90-xrepo-wave3-plan.md §2's
// "log format documented in design; readback is deferred to a future
// round" wording.
//
// Register plan (5-arg SysV entry; three nested cross-file calls:
// pdxfs_txn_row_of_slot / pdxfs_txn_row_state / pdxfs_txn_undo_append
// / klog_s1_d2):
//   push rbx / r12 / r13 / r14 / r15 / rbp (6 pushes) + `sub rsp, 8`
//   pad = 56 bytes -> rsp%16 == 0 for every nested call (entry
//   rsp%16 == 8 SysV).
//     rbx = cap_slot (dead after step (1) but saved for symmetry)
//     r12 = row_id            (survives every nested call)
//     r13 = inode_no          (survives to step (3))
//     r14 = offset            (survives to step (3))
//     r15 = len               (survives to step (3) + step (4))
//     rbp = kbuf_ptr          (survives to step (3))
//
// [unsafe] -- transitively writes _pdxfs_txn_undo_state /
// _pdxfs_txn_undo_offsets / _pdxfs_txn_undo_buffers via
// pdxfs_txn_undo_append; performs no user-VA access (the dispatch shim
// has already walked the caller's user-VA snapshot into a kernel
// scratch, so this body only touches kernel VAs).
// Audit: design/round-retrospectives/r90-xrepo-wave3-plan.md §2.
//
// Reserved-label discipline: labels prefixed `spuw_`.  `loop`, `if`
// etc. are keywords and never used as labels.

module SysPdxfsUndoWrite = structure {

  // Sign-extended u64 form of Linux -EBADF (-9), matching every other
  // sys_* handler's "bad handle" sentinel (sys_close / sys_pdxfs_txn_
  // commit / sys_pdxfs_txn_abort) so a caller checking `jl` for any
  // negative errno branches uniformly.
  pub let SYS_PDXFS_UNDO_WRITE_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7
  pub let SYS_PDXFS_UNDO_WRITE_EINVAL : u64 = 0xFFFFFFFFFFFFFFEA

  // ==========================================================================
  // sys_pdxfs_undo_write_body(cap_slot, inode_no, offset, len, kbuf_ptr)
  //   -> 0 | -EBADF | -EINVAL | -ENOSPC | <sentinel>
  //
  // See file header for the full sequence + error taxonomy.
  // ==========================================================================
  pub let sys_pdxfs_undo_write_body : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (inode_no: u64) (offset: u64) (len: u64) (kbuf_ptr: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R90-XREPO.010.M1-004 (paideia-os #2112): sys_pdxfs_undo_write body, SC+ ID 107. Entry: rdi=cap_slot, rsi=inode_no, rdx=offset, rcx=len, r8=kbuf_ptr (kernel VA -- dispatch shim's KPTI bounce delivers a kernel scratch here; boot witnesses pass .rodata directly). Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + `sub rsp,8` pad = 56 bytes -> rsp%16==0 for every nested call from entry rsp%16==8 SysV. Sequence mirrors sys_pdxfs_txn_abort's cap-resolution shape: (1) pdxfs_txn_row_of_slot(cap_slot) -- PXT_ROW_NONE (0xFF) collapses to -EBADF via `jae 16` (any row >= PXT_MAX including 0xFF is a failure). (2) pdxfs_txn_row_state(row_id) -- must == PXT_STATE_OPEN (1); any other state returns -EINVAL so a caller racing an abort sees a clean refusal rather than appending into a doomed buffer. PXT_DECODE_BAD (0xFF...) also fails the equality and returns -EINVAL, which is acceptable (a freed row is not OPEN). (3) pdxfs_txn_undo_append(row_id, inode_no, offset, len, kbuf_ptr) -- substrate's own gates handle len bounds + row cap + buffer overflow (see undo.pdx §2); non-zero return (PDXFS_UNDO_EINVAL/-EINVAL or PDXFS_UNDO_ENOSPC/-ENOSPC) propagates verbatim. (4) klog_s1_d2(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_undo_write_ok, k_txn, row_id, k_len, len) on the OK path only -- matches every other sys_* handler's `OK path only` discipline. klog_s1_d2 wants v2 pushed on stack (7th arg); we `push r15` (== len) after `sub rsp,8` to land the pre-call rsp%16==0. (5) xor rax, rax return 0. Row release is DEFERRED alongside sys_pdxfs_txn_commit/abort's identical deferral, awaiting a future sys_pdxfs_txn_close. Effects {mem, sysreg}: mem transitively from pdxfs_txn_undo_append's .bss writes; sysreg transitively from klog_s1_d2's TSC read (matches sys_pdxfs_txn_commit_body's identical widening rationale). Capability {cap}: pdxfs_txn_row_of_slot walks cap_table via the KIND_PDXFS_TXN kind gate (matches sys_pdxfs_txn_commit_body's identical posture). Encoder-conservative: cmp/je/jne/jae/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in sys_pdxfs_txn_abort_body / sys_pdxfs_txn_commit_body. Reserved labels: spuw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov rbx, rdi;                    // cap_slot  (dead after step (1))
        mov r13, rsi;                    // inode_no  (survives to step (3))
        mov r14, rdx;                    // offset    (survives to step (3))
        mov r15, rcx;                    // len       (survives to step (3) + (4))
        mov rbp, r8;                     // kbuf_ptr  (survives to step (3))

        // ---- Step (1): resolve cap_slot -> row_id ----
        mov rdi, rbx;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae spuw_ebadf;
        mov r12, rax;                    // r12 = row_id (survives every nested call)

        // ---- Step (2): row must be OPEN ----
        mov rdi, r12;
        call pdxfs_txn_row_state;
        cmp rax, 1;                      // PXT_STATE_OPEN
        jne spuw_einval;

        // ---- Step (3): pdxfs_txn_undo_append(row, inode, offset, len, kbuf) ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8,  rbp;
        call pdxfs_txn_undo_append;
        cmp rax, 0;
        jne spuw_out;                    // forward the substrate's sentinel verbatim

        // ---- Step (4): emit fingerprint ----
        //   klog_s1_d2(level, subsys, tag, k1, v1, k2 [, v2 on stack]).
        //   Ambient rsp%16 == 0 after the prologue; sub rsp, 8 -> %16 == 8;
        //   push r15 (len == v2) -> %16 == 0 for the call.  add rsp, 16 undoes
        //   the pad + push post-call.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_undo_write_ok];
        lea rcx, [rip + k_txn];
        mov r8,  r12;                    // v1 = row_id
        lea r9,  [rip + k_len];
        sub rsp, 8;                      // align pad (rsp%16: 0 -> 8)
        push r15;                        // v2 = len (rsp%16: 8 -> 0)
        call klog_s1_d2;
        add rsp, 16;                     // undo push + pad

        // ---- Step (5): return 0 ----
        xor rax, rax;
        jmp spuw_out;

      spuw_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;     // -EBADF (-9)
        jmp spuw_out;

      spuw_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;     // -EINVAL (-22)

      spuw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
