// src/kernel/core/syscall/sys_chdir.pdx -- R86.M1-002 (paideia-os #1955)
//
// SYS_CHDIR -- ring-3 chdir syscall body + dispatch shim (sysno 85).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// R86 (relative-path substrate) gives every task a TASK_OFF_CWD (+160,
// core/sched/task_pool.pdx) vnode-idx field that path_resolve's cwd_
// vnode_idx argument has accepted since R16-M1-004 but which every caller
// hardcoded to 0 until this round. sys_chdir is the syscall that MUTATES
// that field; sys_getcwd (sys_getcwd.pdx, sysno 86) is its read-side
// counterpart.
//
// Placed at src/kernel/core/syscall/ (not under handlers/) following the
// R53+ "one file per syscall at the top of the syscall namespace"
// convention -- see sys_mountinfo.pdx's own header for the split
// rationale (history, not policy).
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
// sys_chdir_body(path_va, path_len) -> u64
//   rdi = path_va   user VA, NUL-terminated (absolute OR relative -- a
//                   relative path resolves against the CALLER's current
//                   TASK_OFF_CWD, read fresh at step (4) below, i.e. before
//                   this call mutates it).
//   rsi = path_len  caller's length hint; used only as an upper bound for
//                   the walker copy (capped at SYS_CHDIR_PATH_MAX-1=255).
//
//   -> rax = 0                             success; TASK_OFF_CWD updated.
//            0xFFFFFFFFFFFFFFF2 (-EFAULT)  path_va refused by the walker.
//            0xFFFFFFFFFFFFFFFE (-ENOENT)  no such path (or no mounted root).
//            0xFFFFFFFFFFFFFFEC (-ENOTDIR) path resolves but is not a
//                                          directory.
//
// -----------------------------------------------------------------------------
// Composition
// -----------------------------------------------------------------------------
//
// Walks the user path into a kernel scratch (user_read_str_via_walk, same
// helper sys_stat/sys_mkdir use), resolves it via mount_root_vnode +
// path_resolve against the CURRENT (pre-mutation) TASK_OFF_CWD, checks the
// resolved vnode's type == VNODE_TYPE_DIR (vfs-layout.md +0), and on success
// overwrites TASK_OFF_CWD with the resolved vnode idx. Emits the R86.M1-002
// fingerprint via klog_s1_x1 (tag_sys_chdir_ok + k_vnode) on the success arm
// only.
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// `!{mem, sysreg} @{cap}` -- matches sys_stat_body/sys_mkdir_body/etc.'s own
// posture: mem covers path_resolve + the TCB read/write, sysreg covers the
// user_read_str_via_walk call, cap is the same forward-compat annotation
// the R56.M3 VFS-metadata bodies already carry (no cap check runs today).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// All labels prefixed `sysch_` -- grep audit 2026-08-25: no `sysch_`
// collisions elsewhere in src/kernel/.

module SysChdir = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================
  pub let SYS_CHDIR_OK          : u64 = 0
  pub let SYS_CHDIR_ERR_EFAULT  : u64 = 0xFFFFFFFFFFFFFFF2   // -14
  pub let SYS_CHDIR_ERR_ENOENT  : u64 = 0xFFFFFFFFFFFFFFFE   // -2
  pub let SYS_CHDIR_ERR_ENOTDIR : u64 = 0xFFFFFFFFFFFFFFEC   // -20

  // Matches SYS_STAT_PATH_MAX / DISPATCH_PATH_MAX / PATH_MAX (path.pdx).
  pub let SYS_CHDIR_PATH_MAX : u64 = 256

  // Per-syscall path bounce scratch -- same single-flow discipline as
  // _sys_stat_path_scratch / _sys_mkdir_path_scratch (no concurrent
  // sys_chdir callers at R86; a future per-TCB scratch migration would
  // apply here identically to those siblings).
  pub let mut _sys_chdir_path_scratch : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_chdir_body(path_va, path_len) -> u64
  //
  // Register plan (3-push callee-save; entry rsp%16==8, minus 24 = %16==0
  // at every nested call site -- matches sys_open_body's own 3-push
  // discipline, sys_open.pdx L46-49):
  //   rbx = path_va         (survives the walker call)
  //   r12 = path_len (capped), later reused to hold the resolved target
  //         vnode idx (path_len is dead after the walker call)
  //   r13 = root_idx (survives path_resolve)
  // ==========================================================================
  pub let sys_chdir_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_va: u64) (path_len: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R86.M1-002 (#1955): sys_chdir body -- ring-3 chdir syscall (sysno 85). Walks the user path into a kernel .bss scratch via user_read_str_via_walk, resolves via mount_root_vnode + path_resolve against the CALLER'S CURRENT TASK_OFF_CWD (read fresh, before this call mutates it -- so `cd ./sub` resolves relative to the OLD cwd, not a half-updated one), verifies the resolved vnode's type == VNODE_TYPE_DIR (vfs-layout.md +0 byte field), and on success overwrites TASK_OFF_CWD (+160) with the resolved vnode idx. Emits the R86.M1-002 fingerprint via klog_s1_x1 (tag_sys_chdir_ok + k_vnode) on the success arm only. 3-push callee-save prologue (rbx=path_va, r12=capped path_len then target vnode idx, r13=root_idx) leaves rsp%16==0 (entry rsp%16==8, minus 24 = %16==0), matching sys_open_body's own 3-push discipline (sys_open.pdx L46-49) -- no alignment pad needed at any of this body's five nested call sites (user_read_str_via_walk, mount_root_vnode, path_resolve, vnode_slot, klog_s1_x1). Body: (1) Cap path_len at SYS_CHDIR_PATH_MAX-1=255; bump 0 to 1 (walker needs at least one byte of headroom, matching sys_stat_body's own cap discipline). (2) user_read_str_via_walk(path_va=rbx, &_sys_chdir_path_scratch, cap=r12) -> rax = strlen or 0 on fault. 0 -> SYS_CHDIR_ERR_EFAULT. (3) mount_root_vnode() -> rax = root_idx. 0 -> SYS_CHDIR_ERR_ENOENT (no mounted root). Save into r13. (4) Load current cwd from [_current_tcb + 160] into rdx (the OLD cwd -- this read happens strictly before the write in step 6, so a relative path resolves against where the task WAS, not where it is about to be). (5) path_resolve(&_sys_chdir_path_scratch, root_idx=r13, cwd=rdx) -> rax = vnode_idx or 0. 0 -> SYS_CHDIR_ERR_ENOENT. Save into r12 (path_len is dead past step 2). (6) vnode_slot(r12) -> rax = &vnode; load type byte at +0 (VNODE_TYPE_OFFSET, vfs-layout.md); != VNODE_TYPE_DIR (2) -> SYS_CHDIR_ERR_ENOTDIR (a task cannot chdir into a regular file, device node, etc.). (7) Commit: [_current_tcb + 160] = r12 (the new cwd). (8) Fingerprint emit: klog_s1_x1(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_chdir_ok, k_vnode, v1=r12). (9) mov rax, 0; jmp sysch_done. All failure arms jmp sysch_done via a distinct label setting rax to the matching sentinel first; the 3-pop epilogue at sysch_done runs unconditionally regardless of which arm was taken (the pushed values are restored verbatim; their logical liveness on a failure path is irrelevant to correctness of the pop sequence). Labels prefixed sysch_ -- grep audit 2026-08-25: no sysch_ collisions elsewhere in src/kernel/. No test instruction; mov_b used only for the single type-byte load, preceded by `xor rcx, rcx` (mov_b does not zero-extend on its own -- same discipline as path.pdx's copy_char loop). Effects {mem, sysreg} @{cap} match sys_stat_body/sys_mkdir_body's own posture.",
      block: {
        push rbx;
        push r12;
        push r13;
        // 3 pushes: entry rsp%16==8, minus 24 => %16==0 -- exactly what
        // SysV requires at each of this body's nested call sites (matches
        // sys_open_body's own 3-push discipline; no pad needed).

        mov rbx, rdi;                    // rbx = path_va
        mov r12, rsi;                    // r12 = path_len (raw)

        // ---- (1) Cap path_len at SYS_CHDIR_PATH_MAX - 1 = 255 ----
        mov r10, 255;
        cmp r12, r10;
        jbe sysch_cap_ok;
        mov r12, r10;
      sysch_cap_ok:
        cmp r12, 0;
        jne sysch_len_ok;
        mov r12, 1;
      sysch_len_ok:

        // ---- (2) user_read_str_via_walk(path_va, scratch, cap) ----
        mov rdi, rbx;
        lea rsi, [rip + _sys_chdir_path_scratch];
        mov rdx, r12;
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  sysch_efault;

        // ---- (3) mount_root_vnode() ----
        call mount_root_vnode;           // rax = root_idx
        cmp rax, 0;
        je  sysch_enoent;
        mov r13, rax;                    // r13 = root_idx

        // ---- (4) load CURRENT (pre-mutation) cwd from the TCB ----
        mov rax, [rip + _current_tcb];
        mov rdx, [rax + 160];            // rdx = cwd (TASK_OFF_CWD)

        // ---- (5) path_resolve(kernel_path, root_idx, cwd) ----
        lea rdi, [rip + _sys_chdir_path_scratch];
        mov rsi, r13;
        call path_resolve;               // rax = vnode_idx or 0
        cmp rax, 0;
        je  sysch_enoent;
        mov r12, rax;                    // r12 = target vnode idx

        // ---- (6) verify target is a directory ----
        mov rdi, r12;
        call vnode_slot;                 // rax = &vnode
        xor rcx, rcx;
        mov_b rcx, [rax + 0];            // type byte (VNODE_TYPE_OFFSET=0)
        cmp rcx, 2;                      // VNODE_TYPE_DIR
        jne sysch_enotdir;

        // ---- (7) commit: current_task->cwd = target ----
        mov rax, [rip + _current_tcb];
        mov [rax + 160], r12;

        // ---- (8) Fingerprint emit ----
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_chdir_ok];
        lea rcx, [rip + k_vnode];
        mov r8, r12;
        call klog_s1_x1;

        // ---- (9) Success return ----
        xor rax, rax;
        jmp sysch_done;

      sysch_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp sysch_done;

      sysch_enotdir:
        mov rax, 0xFFFFFFFFFFFFFFEC;     // -ENOTDIR
        jmp sysch_done;

      sysch_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT

      sysch_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
