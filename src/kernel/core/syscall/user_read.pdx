// src/kernel/core/syscall/user_read.pdx — R17-M0-724-D4 (#724 D4)
// Strict-KPTI user-memory read helper for syscall handlers.
//
// Root cause of #724 D4 (init reaches ring-3 but INIT ENTERED RING3 never
// prints on wire):
//   dispatch_debug_puts passed the user VA directly to uart_puts. Under
//   strict-KPTI the syscall_entry trampoline flips CR3 to _kernel_pml4_pa
//   (= boot PML4, which identity-maps 0-4GB); the per-process user-VA→phys
//   mappings installed by aspace_map into the user PML4 are NOT reflected
//   into the boot PML4. So `mov al, [user_va]` under kernel CR3 reads
//   whatever byte happens to sit at PHYSICAL address user_va — for init's
//   entered_msg at user VA 0x400290, that PA lands inside kernel .bss
//   (which spans PA 0x124000..0x59A000 per link.ld), which is
//   zero-initialised. uart_puts sees NUL at the first byte and returns
//   without emitting anything. Silent failure — INIT ENTERED RING3 never
//   makes it to wire.
//
// Fix (this file):
//   Provide user_puts_via_walk(user_va, len). For each byte in
//   [user_va, user_va+len), walk _current_tcb.user_pml4_va → PDPT → PD →
//   PT → frame, then read the byte via the kernel higher-half identity
//   map (frame_pa + KERNEL_VMA_BASE, mapped by boot PML4[256]'s shared
//   1 GiB huge-page PDPT, U=0 so SMAP-safe). Emit each byte via
//   uart_putc.
//
// Design doc: design/kernel/r17-m0-724-d4-init-post-iretq-gp.md
//
// [unsafe] — page-table walk (direct kernel memory reads) + UART port
// writes.

module UserRead = structure {

  // user_puts_via_walk(user_va, len) — print `len` bytes from `user_va`
  // via per-byte 4-level user-PML4 walk. Silently exits early on unmapped
  // PTE, huge-page (PS=1) mapping (unsupported), NULL _current_tcb, or
  // len exhaustion. Caps len at 4096 as a defensive stop.
  //
  // Contract:
  //   rdi = user_va (any user VA; kernel-half addresses are rejected
  //         structurally because PML4[256+] index lands on the trampoline
  //         PDPT which does not cover the requested VA)
  //   rsi = len
  //
  // Callee-save discipline (SysV): preserves rbx, rbp, r12-r15 via
  // 5-push prologue (rbx, r12, r13, r14, r15). rsp%16 == 8 on entry,
  // 5*8 = 40 bytes of push moves rsp to (rsp-40) which is %16==0 —
  // sufficient for the nested `call uart_putc` (whose entry expects
  // rsp%16==8 after its own return-address push).
  pub let user_puts_via_walk : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (user_va: u64) (len: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R17-M0-724-D4 (#724 D4): strict-KPTI-safe user-memory print. Walks _current_tcb.user_pml4_va per byte to translate user_va→phys, then reads via kernel higher-half identity map (phys + KERNEL_VMA_BASE), calls uart_putc. Necessary because syscall_entry's CR3 flip to _kernel_pml4_pa (= boot PML4) loses the per-process user-VA→phys mappings that aspace_map installed only in the user PML4. Naive `uart_puts(user_va)` therefore lands on kernel .bss (silently zero) at any user VA under 4GB — see design doc §Root Cause. 5-push prologue (rbx, r12, r13, r14, r15) aligns rsp%16==0 for the nested uart_putc call. rbx = user_va base (surviving); r12 = min(len, 4096) (cap defends against a runaway/malicious count); r13 = byte counter (0..r12); r14 = user_pml4_va (loaded once from _current_tcb+16, phys_alloc VA form so directly dereferenceable via boot PML4's higher-half identity). Each iteration: (1) r15 = rbx + r13 (current byte VA); (2) walk PML4[r15>>39 & 0x1FF] → r9 = PDPT_pa | flags; check P bit; mask PTE_FRAME_MASK (0x000FFFFFFFFFF000, movabs into rcx because AND has no imm64 form); add KERNEL_VMA_BASE (movabs into rcx because ADD has no imm64 form) → r9 = PDPT_va; (3) walk PDPT similarly to r9 = PD_va, rejecting PS=1 (1 GiB huge, unsupported — aspace_map only installs 4 KiB leaves); (4) walk PD similarly to r9 = PT_va, rejecting PS=1 (2 MiB huge); (5) walk PT to r9 = frame_pa; (6) add page offset (r15 & 0xFFF) to r9; (7) add KERNEL_VMA_BASE → r9 = byte kernel VA; (8) xor rax, rax; mov_b rax, [r9] (pre-zero required — paideia-as's mov_b does NOT zero-extend, same convention as sys_execve_shim.pdx:110); (9) mov rdi, rax; call uart_putc. On any early exit, epilogue pops all 5 saved regs and returns. No SMAP flip needed: we access the frame via the kernel higher-half identity mapping (U=0 in boot PML4[256]'s shared PDPT), not via the user PML4's U=1 mapping — SMAP only fires on U=1 accesses from ring-0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // rbx = user_va base
        mov r12, rsi;                              // r12 = len

        // Cap len at 4096 (defensive: prevents runaway loop on wild count).
        mov rax, 4096;
        cmp r12, rax;
        jbe user_puts_cap_ok;
        mov r12, rax;
        user_puts_cap_ok:

        xor r13, r13;                              // r13 = byte counter

        // r14 = user_pml4_va (kernel VA, phys_alloc form).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_puts_done;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_puts_done;

        user_puts_loop:
          cmp r13, r12;
          jae user_puts_done;

          // r15 = current byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;                       // PML4 entry not present
          mov rcx, 0x000FFFFFFFFFF000;             // PTE_FRAME_MASK (movabs)
          and r9, rcx;                              // r9 = PDPT phys
          mov rcx, 0xFFFF800000000000;             // KERNEL_VMA_BASE (movabs)
          add r9, rcx;                              // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov r10, r9;
          and r10, 0x80;                            // PS bit (1 GiB huge)
          jnz user_puts_done;                       // unsupported at leaf
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov r10, r9;
          and r10, 0x80;                            // PS bit (2 MiB huge)
          jnz user_puts_done;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                              // r9 = frame phys
          // Add intra-page offset
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                              // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = byte kernel VA

          // Load the byte (pre-zero: mov_b does not zero-extend upper bits)
          xor rax, rax;
          mov_b rax, [r9];

          // Emit via uart_putc
          mov rdi, rax;
          call uart_putc;

          add r13, 1;
          jmp user_puts_loop;

        user_puts_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // R17-M0-730 D10d (#730): strict-KPTI-safe copy of a NUL-terminated user
  // string into a kernel buffer.
  //
  // Same root cause as #724 D4 (silent-NUL on user_va reads under kernel CR3):
  // any syscall handler that copies a user string (path, env, ...) via a raw
  // `mov_b rax, [user_va]` under strict-KPTI reads the wrong physical byte
  // because the boot PML4's low identity map does not carry the user PML4's
  // per-VA→phys frames. sys_execve_shim's Phase 3 path copy was the first
  // real caller to exercise this at runtime (#560 child_hello / #723 AC);
  // sys_open_body's path arg is a latent second instance and should migrate
  // to this helper in a follow-up (D11+).
  //
  // Contract:
  //   rdi = user_va (source, user VA)
  //   rsi = kernel_dst (destination, must be writable under kernel CR3)
  //   rdx = cap (maximum bytes to copy, including the NUL terminator)
  //
  // Return (rax):
  //   > 0 : bytes copied excluding the NUL (i.e. strlen). NUL was found
  //         within `cap` bytes and IS copied to kernel_dst.
  //   0   : failure — either an unmapped user page during walk, or `cap`
  //         bytes copied without seeing a NUL terminator, or NULL
  //         _current_tcb. Kernel_dst content undefined on failure.
  //
  // Register discipline: 5-push prologue (rbx, r12, r13, r14, r15) aligns
  // rsp%16==0 for future nested calls (currently none — walk is inline).
  // rbx = user_va base; r12 = kernel_dst base (advances); r13 = byte
  // counter; r14 = user_pml4_va (loaded once); r15 = current byte VA.
  pub let user_read_str_via_walk : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (user_va: u64) (kernel_dst: u64) (cap: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R17-M0-730 D10d (#730): strict-KPTI-safe path/string copy from user VA to kernel buffer. Structurally mirrors user_puts_via_walk (r17-m0-724-d4-init-post-iretq-gp.md) — per-byte 4-level walk on _current_tcb.user_pml4_va → PDPT → PD → PT → frame; read the byte via the kernel higher-half identity map at frame_pa + KERNEL_VMA_BASE. Instead of `call uart_putc` the copied byte is `mov_b [r12], rax; add r12, 1`. Length semantics: cap counts the NUL terminator, so a return value equal to cap means 'cap-1 chars + NUL' (well-formed but at cap boundary); a return of 0 means either fault or cap exceeded with no NUL. The kernel_dst's byte at strlen offset IS the NUL (helpful for downstream `mov_b [dst + strlen]` idioms). No SMAP flip: the byte is read via the kernel higher-half identity map (U=0 in boot PML4[256]'s shared PDPT), not via the user PML4's U=1 leaf — SMAP only fires on U=1 kernel accesses.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // rbx = user_va base
        mov r12, rsi;                              // r12 = kernel_dst (advancing)

        // Save cap in r10 (caller-save; no calls until epilogue).
        mov r10, rdx;                              // r10 = cap

        xor r13, r13;                              // r13 = bytes copied

        // r14 = user_pml4_va (kernel VA, phys_alloc form).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_read_str_fail;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_read_str_fail;

        user_read_str_loop:
          cmp r13, r10;                            // reached cap without NUL?
          jae user_read_str_fail;

          // r15 = current user byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;                   // PML4 entry not present
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (1 GiB huge) unsupported
          jnz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (2 MiB huge) unsupported
          jnz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                             // r9 = frame phys
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                             // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = byte kernel VA

          // Load the byte (pre-zero: mov_b does not zero-extend).
          xor rax, rax;
          mov_b rax, [r9];

          // Store to kernel_dst[r13].
          mov_b [r12], rax;
          add r12, 1;
          add r13, 1;

          // NUL terminator? If yes, return count-1 (excluding the NUL).
          cmp rax, 0;
          je user_read_str_done;

          jmp user_read_str_loop;

        user_read_str_done:
          // r13 counts through the NUL. Return strlen = r13 - 1.
          mov rax, r13;
          sub rax, 1;
          jmp user_read_str_exit;

        user_read_str_fail:
          xor rax, rax;                            // rax = 0 (failure)

        user_read_str_exit:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
