// src/kernel/core/syscall/user_read.pdx — R17-M0-724-D4 (#724 D4)
// Strict-KPTI user-memory read helper for syscall handlers.
//
// Root cause of #724 D4 (init reaches ring-3 but INIT ENTERED RING3 never
// prints on wire):
//   dispatch_debug_puts passed the user VA directly to uart_puts. Under
//   strict-KPTI the syscall_entry trampoline flips CR3 to _kernel_pml4_pa
//   (= boot PML4, which identity-maps 0-4GB); the per-process user-VA→phys
//   mappings installed by aspace_map into the user PML4 are NOT reflected
//   into the boot PML4. So `mov al, [user_va]` under kernel CR3 reads
//   whatever byte happens to sit at PHYSICAL address user_va — for init's
//   entered_msg at user VA 0x400290, that PA lands inside kernel .bss
//   (which spans PA 0x124000..0x59A000 per link.ld), which is
//   zero-initialised. uart_puts sees NUL at the first byte and returns
//   without emitting anything. Silent failure — INIT ENTERED RING3 never
//   makes it to wire.
//
// Fix (this file):
//   Provide user_puts_via_walk(user_va, len). For each byte in
//   [user_va, user_va+len), walk _current_tcb.user_pml4_va → PDPT → PD →
//   PT → frame, then read the byte via the kernel higher-half identity
//   map (frame_pa + KERNEL_VMA_BASE, mapped by boot PML4[256]'s shared
//   1 GiB huge-page PDPT, U=0 so SMAP-safe). Emit each byte via
//   uart_putc.
//
// Design doc: design/kernel/r17-m0-724-d4-init-post-iretq-gp.md
//
// [unsafe] — page-table walk (direct kernel memory reads) + UART port
// writes.

module UserRead = structure {

  // user_puts_via_walk(user_va, len) — print `len` bytes from `user_va`
  // via per-byte 4-level user-PML4 walk. Silently exits early on unmapped
  // PTE, huge-page (PS=1) mapping (unsupported), NULL _current_tcb, or
  // len exhaustion. Caps len at 4096 as a defensive stop.
  //
  // Contract:
  //   rdi = user_va (any user VA; kernel-half addresses are rejected
  //         structurally because PML4[256+] index lands on the trampoline
  //         PDPT which does not cover the requested VA)
  //   rsi = len
  //
  // Callee-save discipline (SysV): preserves rbx, rbp, r12-r15 via
  // 5-push prologue (rbx, r12, r13, r14, r15). rsp%16 == 8 on entry,
  // 5*8 = 40 bytes of push moves rsp to (rsp-40) which is %16==0 —
  // sufficient for the nested `call uart_putc` (whose entry expects
  // rsp%16==8 after its own return-address push).
  pub let user_puts_via_walk : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (user_va: u64) (len: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R17-M0-724-D4 (#724 D4) + #741 Layer 2 (VA-range hardening): strict-KPTI-safe user-memory print. Walks _current_tcb.user_pml4_va per byte to translate user_va→phys, then reads via kernel higher-half identity map (phys + KERNEL_VMA_BASE), calls uart_putc. Necessary because syscall_entry's CR3 flip to _kernel_pml4_pa (= boot PML4) loses the per-process user-VA→phys mappings that aspace_map installed only in the user PML4. Naive `uart_puts(user_va)` therefore lands on kernel .bss (silently zero) at any user VA under 4GB — see design doc §Root Cause. #741 Layer 2 gate (structural defense-in-depth): reject user_va >= KERNEL_VMA_BASE or user_va + len > KERNEL_VMA_BASE (overflow-safe via jb) at the very entry — a caller that forgot user_ptr_ok cannot still resolve a kernel-half VA through PML4[256] and land on the trampoline data page. Fires before the 5-push prologue so failure is a bare `ret` (void return). 5-push prologue (rbx, r12, r13, r14, r15) aligns rsp%16==0 for the nested uart_putc call. rbx = user_va base (surviving); r12 = min(len, 4096) (cap defends against a runaway/malicious count); r13 = byte counter (0..r12); r14 = user_pml4_va (loaded once from _current_tcb+16, phys_alloc VA form so directly dereferenceable via boot PML4's higher-half identity). Each iteration: (1) r15 = rbx + r13 (current byte VA); (2) walk PML4[r15>>39 & 0x1FF] → r9 = PDPT_pa | flags; check P bit; mask PTE_FRAME_MASK (0x000FFFFFFFFFF000, movabs into rcx because AND has no imm64 form); add KERNEL_VMA_BASE (movabs into rcx because ADD has no imm64 form) → r9 = PDPT_va; (3) walk PDPT similarly to r9 = PD_va, rejecting PS=1 (1 GiB huge, unsupported — aspace_map only installs 4 KiB leaves); (4) walk PD similarly to r9 = PT_va, rejecting PS=1 (2 MiB huge); (5) walk PT to r9 = frame_pa; (6) add page offset (r15 & 0xFFF) to r9; (7) add KERNEL_VMA_BASE → r9 = byte kernel VA; (8) xor rax, rax; mov_b rax, [r9] (pre-zero required — paideia-as's mov_b does NOT zero-extend, same convention as sys_execve_shim.pdx:110); (9) mov rdi, rax; call uart_putc. On any early exit, epilogue pops all 5 saved regs and returns. No SMAP flip needed: we access the frame via the kernel higher-half identity mapping (U=0 in boot PML4[256]'s shared PDPT), not via the user PML4's U=1 mapping — SMAP only fires on U=1 accesses from ring-0.",
      block: {
        // #741 Layer 2: structural VA-range check — reject any user_va in
        // the kernel half (or [user_va, user_va+len) crossing into it via
        // overflow). This is the defense-in-depth that fires when a caller
        // forgot user_ptr_ok — see design/kernel/r16-m3-741-user-ptr-ok-defense-in-depth.md.
        // Pre-prologue: rax/rcx are caller-save scratch; failure is a bare
        // `ret` (void return) that leaves the stack untouched.
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        cmp rdi, rcx;
        jae user_puts_range_fail;                  // user_va >= KERNEL_VMA_BASE
        mov rax, rdi;
        add rax, rsi;                              // rax = user_va + len
        jb  user_puts_range_fail;                  // overflow past u64 max
        cmp rax, rcx;
        ja  user_puts_range_fail;                  // end > KERNEL_VMA_BASE

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // rbx = user_va base
        mov r12, rsi;                              // r12 = len

        // Cap len at 4096 (defensive: prevents runaway loop on wild count).
        mov rax, 4096;
        cmp r12, rax;
        jbe user_puts_cap_ok;
        mov r12, rax;
        user_puts_cap_ok:

        xor r13, r13;                              // r13 = byte counter

        // r14 = user_pml4_va (kernel VA, phys_alloc form).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_puts_done;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_puts_done;

        user_puts_loop:
          cmp r13, r12;
          jae user_puts_done;

          // r15 = current byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;                       // PML4 entry not present
          mov rcx, 0x000FFFFFFFFFF000;             // PTE_FRAME_MASK (movabs)
          and r9, rcx;                              // r9 = PDPT phys
          mov rcx, 0xFFFF800000000000;             // KERNEL_VMA_BASE (movabs)
          add r9, rcx;                              // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov r10, r9;
          and r10, 0x80;                            // PS bit (1 GiB huge)
          jnz user_puts_done;                       // unsupported at leaf
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov r10, r9;
          and r10, 0x80;                            // PS bit (2 MiB huge)
          jnz user_puts_done;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov r10, r9;
          and r10, 1;
          jz user_puts_done;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                              // r9 = frame phys
          // Add intra-page offset
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                              // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                              // r9 = byte kernel VA

          // Load the byte (pre-zero: mov_b does not zero-extend upper bits)
          xor rax, rax;
          mov_b rax, [r9];

          // Emit via uart_putc
          mov rdi, rax;
          call uart_putc;

          add r13, 1;
          jmp user_puts_loop;

        user_puts_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // #741 Layer 2: kernel-half range rejection. Stack untouched
        // (fires before the 5-push prologue), void return.
        user_puts_range_fail:
        ret
      }
    }

  // R17-M0-730 D10d (#730): strict-KPTI-safe copy of a NUL-terminated user
  // string into a kernel buffer.
  //
  // Same root cause as #724 D4 (silent-NUL on user_va reads under kernel CR3):
  // any syscall handler that copies a user string (path, env, ...) via a raw
  // `mov_b rax, [user_va]` under strict-KPTI reads the wrong physical byte
  // because the boot PML4's low identity map does not carry the user PML4's
  // per-VA→phys frames. sys_execve_shim's Phase 3 path copy was the first
  // real caller to exercise this at runtime (#560 child_hello / #723 AC);
  // sys_open_body's path arg is a latent second instance and should migrate
  // to this helper in a follow-up (D11+).
  //
  // Contract:
  //   rdi = user_va (source, user VA)
  //   rsi = kernel_dst (destination, must be writable under kernel CR3)
  //   rdx = cap (maximum bytes to copy, including the NUL terminator)
  //
  // Return (rax):
  //   > 0 : bytes copied excluding the NUL (i.e. strlen). NUL was found
  //         within `cap` bytes and IS copied to kernel_dst.
  //   0   : failure — either an unmapped user page during walk, or `cap`
  //         bytes copied without seeing a NUL terminator, or NULL
  //         _current_tcb. Kernel_dst content undefined on failure.
  //
  // Register discipline: 5-push prologue (rbx, r12, r13, r14, r15) aligns
  // rsp%16==0 for future nested calls (currently none — walk is inline).
  // rbx = user_va base; r12 = kernel_dst base (advances); r13 = byte
  // counter; r14 = user_pml4_va (loaded once); r15 = current byte VA.
  pub let user_read_str_via_walk : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (user_va: u64) (kernel_dst: u64) (cap: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R17-M0-730 D10d (#730) + #741 Layer 2 (VA-range hardening): strict-KPTI-safe path/string copy from user VA to kernel buffer. Structurally mirrors user_puts_via_walk (r17-m0-724-d4-init-post-iretq-gp.md) — per-byte 4-level walk on _current_tcb.user_pml4_va → PDPT → PD → PT → frame; read the byte via the kernel higher-half identity map at frame_pa + KERNEL_VMA_BASE. Instead of `call uart_putc` the copied byte is `mov_b [r12], rax; add r12, 1`. Length semantics: cap counts the NUL terminator, so a return value equal to cap means 'cap-1 chars + NUL' (well-formed but at cap boundary); a return of 0 means either fault or cap exceeded with no NUL. The kernel_dst's byte at strlen offset IS the NUL (helpful for downstream `mov_b [dst + strlen]` idioms). No SMAP flip: the byte is read via the kernel higher-half identity map (U=0 in boot PML4[256]'s shared PDPT), not via the user PML4's U=1 leaf — SMAP only fires on U=1 kernel accesses. #741 Layer 2 gate (structural defense-in-depth): reject user_va >= KERNEL_VMA_BASE or user_va + cap > KERNEL_VMA_BASE (overflow-safe via jb) at entry — a caller that forgot user_ptr_ok cannot still resolve a kernel-half VA through PML4[256]. Fires before the 5-push prologue; failure is `xor rax, rax; ret` (rax=0 = existing failure sentinel — callers already check `cmp rax, 0; je fail`).",
      block: {
        // #741 Layer 2: structural VA-range check — reject kernel-half.
        // Pre-prologue: rax/rcx are caller-save scratch; failure returns 0
        // (existing fault sentinel — callers check `cmp rax, 0; je fail`).
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        cmp rdi, rcx;
        jae user_read_str_range_fail;
        mov rax, rdi;
        add rax, rdx;                              // rax = user_va + cap
        jb  user_read_str_range_fail;              // overflow
        cmp rax, rcx;
        ja  user_read_str_range_fail;              // end > KERNEL_VMA_BASE

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // rbx = user_va base
        mov r12, rsi;                              // r12 = kernel_dst (advancing)

        // Save cap in r10 (caller-save; no calls until epilogue).
        mov r10, rdx;                              // r10 = cap

        xor r13, r13;                              // r13 = bytes copied

        // r14 = user_pml4_va (kernel VA, phys_alloc form).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_read_str_fail;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_read_str_fail;

        user_read_str_loop:
          cmp r13, r10;                            // reached cap without NUL?
          jae user_read_str_fail;

          // r15 = current user byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;                   // PML4 entry not present
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (1 GiB huge) unsupported
          jnz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (2 MiB huge) unsupported
          jnz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_str_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                             // r9 = frame phys
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                             // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = byte kernel VA

          // Load the byte (pre-zero: mov_b does not zero-extend).
          xor rax, rax;
          mov_b rax, [r9];

          // Store to kernel_dst[r13].
          mov_b [r12], rax;
          add r12, 1;
          add r13, 1;

          // NUL terminator? If yes, return count-1 (excluding the NUL).
          cmp rax, 0;
          je user_read_str_done;

          jmp user_read_str_loop;

        user_read_str_done:
          // r13 counts through the NUL. Return strlen = r13 - 1.
          mov rax, r13;
          sub rax, 1;
          jmp user_read_str_exit;

        user_read_str_fail:
          xor rax, rax;                            // rax = 0 (failure)

        user_read_str_exit:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // #741 Layer 2: kernel-half range rejection. Stack untouched
        // (fires before the 5-push prologue). Returns 0 (existing fault sentinel).
        user_read_str_range_fail:
        xor rax, rax;
        ret
      }
    }

  // R17-M0-737 (#737): strict-KPTI-safe u32 write from kernel into a user
  // buffer at `user_va`. Symmetric write counterpart to user_puts_via_walk
  // (#724 D4) / user_read_str_via_walk (#730 D10d).
  //
  // Root cause of #737 (dispatch_wait4 writeback):
  //   `dispatch_wait4_writeback` performed `mov [rsi], edx` under kernel
  //   CR3 (= boot PML4 post-strict-KPTI). rsi held init's user wstatus VA
  //   0x700000. The boot PML4's low identity map covers PA 0..4 GiB but
  //   does NOT reflect the per-process user-VA→phys frames installed by
  //   aspace_map into the user PML4 only — so the write landed on physical
  //   0x700000 (whatever kernel data sits there) instead of the frame the
  //   user PML4 maps VA 0x700000 to (init's own zero-initialised BSS
  //   frame). init's subsequent read of wait_status[0] therefore returned
  //   the ELF loader's zero, not the child's 42. Wire showed
  //   `WAIT: pid=23 status=0`.
  //
  // Fix (this helper):
  //   Provide user_write_u32_via_walk(user_va, val_u32). Walk
  //   _current_tcb.user_pml4_va → PDPT → PD → PT → frame_pa; compute the
  //   kernel higher-half VA at KERNEL_VMA_BASE + frame_pa + intra_page_off
  //   and store the low 32 bits of `val` there.
  //
  // Contract:
  //   rdi = user_va (user VA; caller enforces user-half via user_ptr_ok)
  //   rsi = val    (u64; low 32 bits are the value written)
  //   → rax = 0 on success, 0xFFFFFFFFFFFFFFF2 (-EFAULT) on any failure:
  //     - NULL _current_tcb or NULL user_pml4_va
  //     - unmapped page at any level
  //     - PS=1 huge page at PDPT (1 GiB) or PD (2 MiB) — aspace_map only
  //       installs 4 KiB leaves for user pages, so the huge-page branches
  //       are unreachable for well-formed user aspaces but are checked
  //       defensively
  //     - 4-byte access crosses a page boundary (only occurs when
  //       user_va & 0xFFF > 4092; caller-facing wstatus is @align(8) per
  //       init.pdx so a 4-byte store at an aligned VA never crosses)
  //
  // Register discipline: leaf function (no nested call), so no
  // callee-save prologue is needed. Clobbers only caller-save regs
  // (rax, rcx, rdx, rsi, rdi, r8, r9, r10). rsi is preserved as the
  // value source through the walk (never used as an index). r10 holds
  // the user_va base copy so rdi is free.
  //
  // No SMAP interaction: the store goes through the kernel higher-half
  // identity map at boot PML4[256]'s shared 1 GiB PDPT (U=0), NOT the
  // user PML4's U=1 leaf mapping — SMAP fires only on ring-0 accesses to
  // U=1 pages.
  //
  // Design doc: design/kernel/r16-m3-737-dispatch-wait4-writeback-kpti.md
  //
  // [unsafe] — page-table walk + arbitrary kernel-VA write.
  pub let user_write_u32_via_walk : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (user_va: u64) (val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R17-M0-737 (#737) + #741 Layer 2 (VA-range hardening): strict-KPTI-safe u32 write from kernel into a user buffer. Symmetric write counterpart to user_puts_via_walk (#724 D4) and user_read_str_via_walk (#730 D10d): per-byte 4-level walk of _current_tcb.user_pml4_va → PDPT → PD → PT → frame; compute leaf kernel VA = frame_pa + intra_page_off + KERNEL_VMA_BASE and store the low 32 bits of the value with `mov [r9], esi`. Leaf function (no nested call), so no callee-save prologue is required — only caller-save regs are touched (rax, rcx, rdx, rsi, rdi, r8, r9, r10). rsi is deliberately preserved throughout the walk as the value source; rdi is copied once to r10 so the walk can freely rebuild indexes from r10 without clobbering the input alias. Cross-page 4-byte access rejected via `(user_va & 0xFFF) + 4 > 0x1000` — cheap, honest, and unreachable for wstatus (init.pdx declares `wait_status: [u64; 1] = uninit @align(8)`, so a 4-byte write at an aligned VA can never straddle a page). #741 Layer 2 gate (structural defense-in-depth): the caller's user_ptr_ok(wstatus, 4) is still expected (belt-and-braces) but the walker now ALSO rejects user_va >= KERNEL_VMA_BASE or user_va + 4 > KERNEL_VMA_BASE at entry — a caller that forgot user_ptr_ok cannot still resolve a kernel-half VA through PML4[256] and clobber the trampoline data page's saved_user_rsp / kernel_pml4_pa scratches. All failure paths (kernel-half range, NULL _current_tcb, unmapped PTE, huge-page leaf, cross-page 4-byte) converge on `mov rax, 0xFFFFFFFFFFFFFFF2` (-EFAULT); success returns rax = 0. No SMAP interaction: the store lands on the kernel higher-half identity map (U=0 in boot PML4[256]'s shared PDPT), not the user PML4's U=1 mapping, so SMAP never fires. Root cause: the prior `mov [rsi], edx` under kernel CR3 hit whichever kernel byte sat at PA=user_va via boot PML4's low identity map, not the user PML4's per-VA→phys frame — same defect class as #724 D4 dispatch_debug_puts, #730 D10c dispatch_write_uart, #730 D10d sys_execve_shim path copy. Encoder note: `mov [r9], esi` uses the 32-bit-source-to-memory store class (MOV r/m32, r32, opcode 0x89), byte-identical shape to ioapic.pdx:89 (`mov [rax + 0x10], esi`).",
      block: {
        // #741 Layer 2: structural VA-range check — reject kernel-half or
        // 4-byte range crossing into it via overflow. Leaf function, so
        // failure jumps straight to the -EFAULT return.
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        cmp rdi, rcx;
        jae user_write_u32_fail;                   // user_va >= KERNEL_VMA_BASE
        mov rax, rdi;
        add rax, 4;                                // rax = user_va + 4
        jb  user_write_u32_fail;                   // overflow past u64 max
        cmp rax, rcx;
        ja  user_write_u32_fail;                   // end > KERNEL_VMA_BASE

        // Save user_va (rdi) to r10; rsi (val) is preserved throughout.
        mov r10, rdi;                              // r10 = user_va base

        // r8 = user_pml4_va (via _current_tcb + 16).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_write_u32_fail;
        mov r8, [rax + 16];
        cmp r8, 0;
        je user_write_u32_fail;

        // ============ Level 4: PML4 ============
        mov rax, r10;
        shr rax, 39;
        and rax, 0x1FF;
        lea r9, [r8 + rax * 8];
        mov r9, [r9];                              // r9 = PML4E
        mov rcx, r9;
        and rcx, 1;
        jz user_write_u32_fail;                    // PML4E not present
        mov rcx, 0x000FFFFFFFFFF000;               // PTE_FRAME_MASK (movabs)
        and r9, rcx;                               // r9 = PDPT phys
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        add r9, rcx;                               // r9 = PDPT kernel VA

        // ============ Level 3: PDPT ============
        mov rax, r10;
        shr rax, 30;
        and rax, 0x1FF;
        lea r8, [r9 + rax * 8];
        mov r9, [r8];                              // r9 = PDPTE
        mov rcx, r9;
        and rcx, 1;
        jz user_write_u32_fail;                    // PDPTE not present
        mov rcx, r9;
        and rcx, 0x80;                             // PS (1 GiB) unsupported
        jnz user_write_u32_fail;
        mov rcx, 0x000FFFFFFFFFF000;
        and r9, rcx;
        mov rcx, 0xFFFF800000000000;
        add r9, rcx;                               // r9 = PD kernel VA

        // ============ Level 2: PD ============
        mov rax, r10;
        shr rax, 21;
        and rax, 0x1FF;
        lea r8, [r9 + rax * 8];
        mov r9, [r8];                              // r9 = PDE
        mov rcx, r9;
        and rcx, 1;
        jz user_write_u32_fail;                    // PDE not present
        mov rcx, r9;
        and rcx, 0x80;                             // PS (2 MiB) unsupported
        jnz user_write_u32_fail;
        mov rcx, 0x000FFFFFFFFFF000;
        and r9, rcx;
        mov rcx, 0xFFFF800000000000;
        add r9, rcx;                               // r9 = PT kernel VA

        // ============ Level 1: PT (leaf) ============
        mov rax, r10;
        shr rax, 12;
        and rax, 0x1FF;
        lea r8, [r9 + rax * 8];
        mov r9, [r8];                              // r9 = PTE
        mov rcx, r9;
        and rcx, 1;
        jz user_write_u32_fail;                    // PTE not present
        mov rcx, 0x000FFFFFFFFFF000;
        and r9, rcx;                               // r9 = frame phys

        // Cross-page guard: reject if the 4-byte store would straddle a
        // page boundary. For wstatus this is unreachable (@align(8)); the
        // check exists for future callers passing arbitrary user VAs.
        mov rax, r10;
        and rax, 0xFFF;                            // rax = page offset
        mov rdx, rax;
        add rdx, 4;
        cmp rdx, 0x1000;                           // > 4096 → straddles
        ja user_write_u32_fail;

        add r9, rax;                               // r9 = byte phys
        mov rcx, 0xFFFF800000000000;
        add r9, rcx;                               // r9 = byte kernel VA

        // Store low 32 bits of val (in rsi) to the leaf kernel VA.
        // Encoder shape matches ioapic.pdx:89 (`mov [rax + 0x10], esi`).
        mov [r9], esi;

        xor rax, rax;                              // rax = 0 (OK)
        ret;

        user_write_u32_fail:
        mov rax, 0xFFFFFFFFFFFFFFF2;               // rax = -EFAULT
        ret
      }
    }

  // ==========================================================================
  // R16-M3-733/734/738/739 KPTI-sweep (#733 #734 #738 #739): strict-KPTI-safe
  // arbitrary-length byte-copy helpers.
  //
  // Same defect class as #724 D4 / #730 D10c / #730 D10d / #737: every kernel
  // path that reads OR writes a user VA under kernel CR3 (post-strict-KPTI
  // syscall_entry CR3 flip) lands on whichever kernel byte the boot PML4's
  // low identity map covers PA=user_va with — NOT the frame the user PML4
  // maps user_va to. These helpers translate per byte via a 4-level walk of
  // _current_tcb.user_pml4_va, then complete the copy via the kernel
  // higher-half identity map (frame_pa + KERNEL_VMA_BASE) which is U=0 in
  // boot PML4[256]'s shared PDPT — SMAP-safe, TLB-hot after the CR3 flip.
  //
  // Design doc: design/kernel/r16-m3-kpti-sweep-733-734-738-739.md
  // ==========================================================================

  // user_read_bytes_via_walk(kernel_dst, user_va, len) -> u64 (#734 sweep)
  //   Read exactly `len` bytes from `user_va` into `kernel_dst`.
  //   Unlike user_read_str_via_walk (#730 D10d), no NUL early exit — the
  //   full `len` bytes are copied unless a walk failure interrupts.
  //
  // Contract:
  //   rdi = kernel_dst (kernel VA — must be writable under kernel CR3;
  //                     typically a static .bss scratch or on-stack buffer)
  //   rsi = user_va    (user VA — walked byte-by-byte)
  //   rdx = len        (byte count)
  //
  // Return (rax):
  //   0                            — success (len bytes copied)
  //   0xFFFFFFFFFFFFFFF2 (-EFAULT) — any walk failure OR NULL _current_tcb
  //                                  OR NULL user_pml4_va OR PS=1 huge page
  //                                  at PDPT (1 GiB) or PD (2 MiB). Partial
  //                                  kernel_dst content is UNDEFINED on
  //                                  failure (caller must not consume it).
  //
  // Leaf helper — no nested call. 5-push callee-save prologue mirrors
  // user_read_str_via_walk purely for pattern uniformity (walk is inline).
  pub let user_read_bytes_via_walk : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kernel_dst: u64) (user_va: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R16-M3-KPTI-sweep (#734) + #741 Layer 2 (VA-range hardening): strict-KPTI-safe fixed-length byte-copy from user VA to kernel buffer. Structural mirror of user_read_str_via_walk (#730 D10d) — per-byte 4-level walk of _current_tcb.user_pml4_va → PDPT → PD → PT → frame; read the byte via the kernel higher-half identity map at frame_pa + KERNEL_VMA_BASE; store to kernel_dst[i] via mov_b. Difference vs. user_read_str_via_walk: no NUL early-exit — the loop runs exactly `len` iterations. Difference vs. user_puts_via_walk: no uart_putc emission — the byte is stored to kernel_dst[i] instead. Register plan: rbx = user_va base (survives); r12 = kernel_dst base (advances); r13 = byte counter (0..len); r14 = user_pml4_va (loaded once from _current_tcb+16); r15 = current byte VA (rbx + r13). r10 holds len (caller-save, but leaf function so no preservation needed across calls — there ARE no nested calls). #741 Layer 2 gate (structural defense-in-depth): reject user_va (rsi) >= KERNEL_VMA_BASE or user_va + len > KERNEL_VMA_BASE at entry — a caller that forgot user_ptr_ok cannot still resolve a kernel-half VA through PML4[256]. Fires before the 5-push prologue; failure is -EFAULT with stack untouched. All failure paths (kernel-half range, NULL _current_tcb, NULL user_pml4_va, unmapped page, PS=1 huge) converge on -EFAULT. Success returns 0. No SMAP interaction: the byte is read via the kernel higher-half identity map (U=0 in boot PML4[256]'s shared PDPT), not via the user PML4's U=1 leaf — SMAP fires only on U=1 kernel accesses.",
      block: {
        // #741 Layer 2: structural VA-range check on the USER-VA argument
        // (rsi here — user_read_bytes_via_walk(kernel_dst=rdi, user_va=rsi,
        // len=rdx)). Pre-prologue: rax/rcx are caller-save scratch;
        // failure jumps to the -EFAULT return with stack untouched.
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        cmp rsi, rcx;
        jae user_read_bytes_range_fail;            // user_va >= KERNEL_VMA_BASE
        mov rax, rsi;
        add rax, rdx;                              // rax = user_va + len
        jb  user_read_bytes_range_fail;            // overflow
        cmp rax, rcx;
        ja  user_read_bytes_range_fail;            // end > KERNEL_VMA_BASE

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                              // rbx = user_va base
        mov r12, rdi;                              // r12 = kernel_dst (advancing)
        mov r10, rdx;                              // r10 = len (bound)

        xor r13, r13;                              // r13 = bytes copied

        // r14 = user_pml4_va (kernel VA, phys_alloc form).
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_read_bytes_fail;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_read_bytes_fail;

        user_read_bytes_loop:
          cmp r13, r10;                            // r13 >= len? done.
          jae user_read_bytes_ok;

          // r15 = current user byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_bytes_fail;                 // PML4E not present
          mov rcx, 0x000FFFFFFFFFF000;             // PTE_FRAME_MASK
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;             // KERNEL_VMA_BASE
          add r9, rcx;                             // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_bytes_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (1 GiB) unsupported
          jnz user_read_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_bytes_fail;
          mov rcx, r9;
          and rcx, 0x80;                           // PS (2 MiB) unsupported
          jnz user_read_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_read_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                             // r9 = frame phys
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                             // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = byte kernel VA

          // Load the byte (pre-zero: mov_b does not zero-extend).
          xor rax, rax;
          mov_b rax, [r9];

          // Store to kernel_dst[r13].
          mov_b [r12], rax;
          add r12, 1;
          add r13, 1;

          jmp user_read_bytes_loop;

        user_read_bytes_ok:
          xor rax, rax;                            // rax = 0 (success)
          jmp user_read_bytes_exit;

        user_read_bytes_fail:
          mov rax, 0xFFFFFFFFFFFFFFF2;             // rax = -EFAULT

        user_read_bytes_exit:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // #741 Layer 2: kernel-half range rejection. Stack untouched
        // (fires before the 5-push prologue). Returns -EFAULT.
        user_read_bytes_range_fail:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        ret
      }
    }

  // user_write_bytes_via_walk(user_va, kernel_src, len) -> u64 (#738 #739 sweep)
  //   Write exactly `len` bytes from `kernel_src` into `user_va`. Symmetric
  //   write counterpart to user_read_bytes_via_walk.
  //
  // Contract:
  //   rdi = user_va    (user VA — walked byte-by-byte)
  //   rsi = kernel_src (kernel VA — must be readable under kernel CR3;
  //                     typically a static .bss scratch or on-stack buffer
  //                     that a preceding vfs_read populated)
  //   rdx = len        (byte count)
  //
  // Return (rax):
  //   0                            — success (len bytes copied)
  //   0xFFFFFFFFFFFFFFF2 (-EFAULT) — same failure taxonomy as
  //                                  user_read_bytes_via_walk. Partial
  //                                  user_va content is UNDEFINED on failure.
  //
  // Leaf helper — no nested call. 5-push callee-save prologue mirrors the
  // reader for pattern uniformity.
  pub let user_write_bytes_via_walk : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (user_va: u64) (kernel_src: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R16-M3-KPTI-sweep (#738 #739) + #741 Layer 2 (VA-range hardening): strict-KPTI-safe fixed-length byte-copy from kernel buffer to user VA. Structural mirror of user_read_bytes_via_walk — direction reversed. Per-byte 4-level walk of _current_tcb.user_pml4_va → PDPT → PD → PT → frame; compute leaf kernel VA = frame_pa + intra_page_off + KERNEL_VMA_BASE; store the source byte there via mov_b. Register plan: rbx = user_va base (survives); r12 = kernel_src base (advancing); r13 = byte counter (0..len); r14 = user_pml4_va (loaded once from _current_tcb+16); r15 = current user byte VA (rbx + r13). r10 holds len. #741 Layer 2 gate (structural defense-in-depth) — THIS IS THE EXPLOIT SITE: reject user_va (rdi) >= KERNEL_VMA_BASE or user_va + len > KERNEL_VMA_BASE at entry. Before this landing, `read(fd, 0xFFFF800000105000, N)` reached this helper through an ungated dispatch_read, walked the user PML4's PML4[256] (KPTI mirror) → non-huge chain → trampoline data page, and wrote attacker bytes over saved_user_rsp / saved_user_CR3 / kernel_pml4_pa — full ring-3 → ring-0 corruption primitive. Fires before the 5-push prologue; failure is -EFAULT with stack untouched. All failure paths converge on -EFAULT; success returns 0. No SMAP interaction: the store lands on the kernel higher-half identity map (U=0 in boot PML4[256]'s shared PDPT), not the user PML4's U=1 leaf — SMAP fires only on U=1 kernel accesses. Root cause covered: tmpfs_read's rep_movsb dst = user VA under kernel CR3 (#738); tty_read_try's byte-store loop dst = user VA under kernel CR3 (#739). Both are transitively fixed by routing the sys_read path through this helper at the dispatch layer (dispatch.pdx dispatch_read), keeping tmpfs_read / tty_read_try / vfs_read / vops_read contracts unchanged (they already say kernel VA per their own justifications and are exercised as kernel-VA callees by kernel_main witnesses).",
      block: {
        // #741 Layer 2: structural VA-range check on the USER-VA argument
        // (rdi here — user_write_bytes_via_walk(user_va=rdi, kernel_src=rsi,
        // len=rdx)). THIS IS THE #741 EXPLOIT SITE. Pre-prologue: rax/rcx
        // are caller-save scratch; failure jumps to -EFAULT return with
        // stack untouched.
        mov rcx, 0xFFFF800000000000;               // KERNEL_VMA_BASE (movabs)
        cmp rdi, rcx;
        jae user_write_bytes_range_fail;           // user_va >= KERNEL_VMA_BASE
        mov rax, rdi;
        add rax, rdx;                              // rax = user_va + len
        jb  user_write_bytes_range_fail;           // overflow
        cmp rax, rcx;
        ja  user_write_bytes_range_fail;           // end > KERNEL_VMA_BASE

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // rbx = user_va base
        mov r12, rsi;                              // r12 = kernel_src (advancing)
        mov r10, rdx;                              // r10 = len (bound)

        xor r13, r13;                              // r13 = bytes copied

        // r14 = user_pml4_va.
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je user_write_bytes_fail;
        mov r14, [rax + 16];
        cmp r14, 0;
        je user_write_bytes_fail;

        user_write_bytes_loop:
          cmp r13, r10;
          jae user_write_bytes_ok;

          // r15 = current user byte VA
          mov r15, rbx;
          add r15, r13;

          // ============ Level 4: PML4 ============
          mov rax, r15;
          shr rax, 39;
          and rax, 0x1FF;
          lea r8, [r14 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_write_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PDPT kernel VA

          // ============ Level 3: PDPT ============
          mov rax, r15;
          shr rax, 30;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_write_bytes_fail;
          mov rcx, r9;
          and rcx, 0x80;
          jnz user_write_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PD kernel VA

          // ============ Level 2: PD ============
          mov rax, r15;
          shr rax, 21;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_write_bytes_fail;
          mov rcx, r9;
          and rcx, 0x80;
          jnz user_write_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = PT kernel VA

          // ============ Level 1: PT (leaf) ============
          mov rax, r15;
          shr rax, 12;
          and rax, 0x1FF;
          lea r8, [r9 + rax * 8];
          mov r9, [r8];
          mov rcx, r9;
          and rcx, 1;
          jz user_write_bytes_fail;
          mov rcx, 0x000FFFFFFFFFF000;
          and r9, rcx;                             // r9 = frame phys
          mov rax, r15;
          and rax, 0xFFF;
          add r9, rax;                             // r9 = byte phys
          mov rcx, 0xFFFF800000000000;
          add r9, rcx;                             // r9 = byte kernel VA

          // Load source byte from kernel_src[r13] (direct — no walk needed).
          xor rax, rax;
          mov_b rax, [r12];

          // Store to user VA (via leaf kernel VA).
          mov_b [r9], rax;
          add r12, 1;
          add r13, 1;

          jmp user_write_bytes_loop;

        user_write_bytes_ok:
          xor rax, rax;                            // rax = 0 (success)
          jmp user_write_bytes_exit;

        user_write_bytes_fail:
          mov rax, 0xFFFFFFFFFFFFFFF2;             // rax = -EFAULT

        user_write_bytes_exit:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // #741 Layer 2: kernel-half range rejection. Stack untouched
        // (fires before the 5-push prologue). Returns -EFAULT. This is
        // the walker-side structural block for the #741 exploit.
        user_write_bytes_range_fail:
        mov rax, 0xFFFFFFFFFFFFFFF2;
        ret
      }
    }
}
