// src/kernel/core/syscall/sys_mkdir.pdx -- R56.M3-004 (paideia-os #1793)
//
// SYS_MKDIR -- ring-3 mkdir syscall body + shim (sysno 79).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/kernel/vfs-metadata-syscalls.md and paideia-os R56.M3 milestone
// item R56.M3-004:
//
//   "sys_mkdir(path_ptr, path_len, mode) -> i64. Path resolution then
//    invoke vop_mkdir on the parent vnode with the basename."
//
// The R56.M3-001 sibling (paideia-os #1790) widened dispatch.pdx's
// bounds check from 76 -> 82 and added dispatch_mkdir as an ENOSYS
// forward-declaration stub. This landing rewrites dispatch_mkdir into
// a real shim that calls sys_mkdir_body defined below, and adds the
// vops_mkdir dispatcher wiring in src/kernel/core/fs/vops.pdx (slot
// +72, VOPS_MKDIR_OFFSET) with per-backend adapters landed by the
// same edit.
//
// -----------------------------------------------------------------------------
// Composition
// -----------------------------------------------------------------------------
//
// sys_mkdir_body:
//   (1) Cap path_len at SYS_MKDIR_PATH_MAX - 1 = 255 so
//       user_read_str_via_walk's #741 layer-2 gate accepts a user_va +
//       cap that ends strictly below KERNEL_VMA_BASE.
//   (2) user_read_str_via_walk(path_va, &_sys_mkdir_path_scratch, cap)
//       -> strlen (0 = walker fault, > 0 = success).
//   (3) Locate the last '/' in the kernel scratch; NUL-terminate the
//       scratch there (making the parent-path a valid C-string) and
//       set basename_ptr = scratch + slash_off + 1.  Edge cases:
//         - No slash at all -> ENOENT (relative paths not supported
//           without cwd, which R56 does not thread through this body).
//         - Slash at offset 0 (path == "/foo") -> parent is root;
//           the NUL-terminate step writes NUL over the leading '/',
//           leaving the parent path as the empty string.  path_resolve
//           interprets the empty string as "root" per its own contract
//           (§design/kernel/r16-m1-004-path-resolver.md §3.1
//           "empty-string anchor uses root_vnode_idx directly").
//         - Slash at the very end (trailing '/') -> after the NUL
//           write, basename_ptr points at an empty string.  This maps
//           to ENOENT via the empty-basename gate below (mkdir "/foo/"
//           is spec-lenient in POSIX but we reject to keep the
//           basename contract clean at R56).
//   (4) Compute basename_len via a bounded strlen from basename_ptr
//       (cap at scratch tail; walker cap ensures the scratch is NUL-
//       terminated within [0, cap]).
//   (5) mount_root_vnode() -> root_idx. 0 -> ENOENT.
//   (6) path_resolve(&scratch, root_idx, cwd=0) -> parent_vnode_idx.
//       0 -> ENOENT.
//   (7) vnode_slot(parent_vnode_idx) -> &parent_vnode.
//   (8) vops_mkdir(&parent_vnode, basename_ptr, basename_len, mode)
//       -> 0 on success, VOPS_ERR_NOT_SUPPORTED or backend errno on
//       failure. Non-zero -> EIO (ring-3 sees a uniform errno rather
//       than every backend's own sentinel; a follow-up round can
//       widen the taxonomy once the backend errors have stabilised).
//   (9) klog_s1_x1(LEVEL_INFO, SUBSYS_FS_, tag_sys_mkdir_ok, k_path,
//       &_sys_mkdir_path_scratch) — em-dash DROPPED per R51/R54/R55
//       precedent, single k=v pair (path -> scratch VA as hex).
//   (10) Return 0.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
//   0                            -- success
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- user_ptr_ok / user_read_str_via_walk
//                                    rejected the caller's path buffer
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- no '/' in path, empty basename,
//                                    empty scratch, missing root, or
//                                    path_resolve returned 0
//   0xFFFFFFFFFFFFFFFB (-EIO)    -- vops_mkdir returned a non-zero
//                                    backend errno (target-parent-not-
//                                    dir, collision, OOM, backend has
//                                    no wired mkdir body)
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// !{mem, sysreg} @{cap}. mem covers path_resolve + vops_mkdir; sysreg
// covers user_read_str_via_walk's page-walk register loads and the
// klog UART emit; cap is forward-compat for a R57+ evolution that
// gates mkdir on per-mount VOL_RIGHT (matches the sys_stat / sys_
// getdents precedent this same milestone lands).
//
// -----------------------------------------------------------------------------
// Reserved-label / mov_b / test discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `sysmk_` (mkdir_ is close to but not a paideia-as
// keyword; the sysmk_ prefix follows the sys_mount / sys_stat body's
// smb_ / sysstat_ precedent and is distinct from the pdxfs-block dir
// helpers' dp_/du_/df_/da_/dr_ family). No test mnemonic. mov_b used
// for the basename NUL-scan and the last-slash byte-load — proven
// idioms in tmpfs/init.pdx L52-L112 and pdxfs_lite/vops.pdx L397.

module SysMkdir = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_MKDIR_OK          : u64 = 0
  pub let SYS_MKDIR_ERR_ENOENT  : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_MKDIR_ERR_EFAULT  : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYS_MKDIR_ERR_EIO     : u64 = 0xFFFFFFFFFFFFFFFB

  // Path length cap. Matches DISPATCH_PATH_MAX, SYS_STAT_PATH_MAX, and
  // PATH_MAX (path.pdx) so a POSIX-legal PATH_MAX buffer sees no
  // length-shrink surprise.
  pub let SYS_MKDIR_PATH_MAX    : u64 = 256

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall path bounce scratch. Same discipline as sys_stat.pdx's
  // _sys_stat_path_scratch: the syscall body walks the user path into
  // this .bss buffer under kernel CR3, then walks it to split into
  // parent-path + basename in place before handing the parent-path to
  // path_resolve. Single-flow at R56.M3-004 (no concurrent sys_mkdir
  // callers on the smoke path); the follow-up multi-caller wave moves
  // this into a per-TCB slot alongside the sys_stat + sys_getdents
  // scratches.
  //
  // Sized at PATH_MAX exactly; ec_confine_one polices the single-
  // writer discipline at build time (see tools/build.sh §R56.M3-004
  // confinement below).
  pub let mut _sys_mkdir_path_scratch : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_mkdir_body(path_va, path_len, mode) -> u64
  //
  // SysV: rdi=path_va, rsi=path_len, rdx=mode
  //   -> rax = 0 on success, or -EFAULT / -ENOENT / -EIO sentinel.
  //
  // Register plan (5-push callee-save):
  //   rbx = mode                (survives all nested calls; consumed
  //                              at step 8 as vops_mkdir's rcx arg)
  //   r12 = path_len (capped)   (dead post walker call; kept for
  //                              uniformity with sys_stat_body's shape)
  //   r13 = repurposing register:
  //         - initially path_va (walker arg0)
  //         - post walker: strlen returned from walker (path len in
  //                        scratch, excluding NUL)
  //         - post split:  slash_off (byte offset of last '/' in scratch)
  //         - post resolve: root_vnode_idx / vnode_slot arg
  //   r14 = basename_ptr        (result of split; consumed at step 8)
  //   r15 = basename_len        (result of strlen from basename_ptr)
  //
  // Alignment: 5 pushes (40 B) + entry rsp%16==8 -> rsp%16==0 which is
  // exactly what SysV requires at nested call sites (matches sys_mount_
  // body / sys_stat_body's 5-push discipline).
  // ==========================================================================
  pub let sys_mkdir_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_va: u64) (path_len: u64) (mode: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R56.M3-004 (#1793): sys_mkdir body -- ring-3 mkdir syscall (sysno 79). Walks user path into kernel .bss scratch via user_read_str_via_walk, splits into parent-path + basename in place (last-slash scan + NUL-write), resolves parent via mount_root_vnode + path_resolve, dispatches through the R56 vops_mkdir slot (VOPS_MKDIR_OFFSET=72) to the per-backend adapter, and emits the R56.M3-004 fingerprint via klog_s1_x1 (tag_sys_mkdir_ok + k_path). 5-push callee-save prologue (rbx=mode, r12=capped path_len, r13=multi-role, r14=basename_ptr, r15=basename_len) lands rsp%16==0 (entry %16==8 - 40 = %16==0) which is SysV-correct at nested call sites (matches sys_stat_body's own 5-push discipline). Alignment ledger: entry %16==8; 5 pushes -> %16==0; every nested call site is at %16==0 pre-CALL so callee entry %16==8 per SysV. Body: (1) Cap path_len at SYS_MKDIR_PATH_MAX-1=255; if 0 bump to 1 (walker needs at least one byte). (2) user_read_str_via_walk(r13=path_va, &_sys_mkdir_path_scratch, r12=cap) -> rax = strlen or 0. 0 -> EFAULT. Save strlen back into r13. (3) Split: scan _sys_mkdir_path_scratch [0..strlen) BACKWARD for the last '/'. Track the last-seen slash offset in a spare register (rcx). Post-scan: if rcx == -1 sentinel (no slash) -> ENOENT. NUL-terminate scratch[rcx] via mov_b + xor. basename_ptr = &scratch + rcx + 1 (r14). (4) basename_len = strlen from r14, capped at (strlen - rcx - 1) which is the tail of the scratch. Save into r15. If basename_len == 0 -> ENOENT (mkdir '/foo/' etc.). (5) mount_root_vnode() -> rax = root_idx; 0 -> ENOENT; save into r13. (6) path_resolve(&scratch, r13, 0) -> rax = parent_vnode_idx; 0 -> ENOENT; keep in rax. (7) vnode_slot(rax) -> rax = &parent_vnode. (8) vops_mkdir(rax=&parent_vnode, r14=basename_ptr, r15=basename_len, rbx=mode) -> rax = 0 or backend errno; non-zero -> EIO. (9) Fingerprint emit: klog_s1_x1(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_mkdir_ok, k_path, v1=&_sys_mkdir_path_scratch (as hex u64)). No stack-arg push -- klog_s1_x1 fits entirely in registers (rdi=level, rsi=subsys, rdx=tag, rcx=k1, r8=v1). (10) mov rax, 0; jmp done. Failure arms: sysmk_efault / sysmk_enoent / sysmk_eio each set rax before jmp done. Labels prefixed sysmk_ (distinct from sys_mount's smb_ and sys_stat's sysstat_). No test instruction; mov_b used for the last-slash scan and the NUL-terminate step (proven idiom, pdxfs_lite/vops.pdx L397 _pdxl_vp_strlen). Encoder gap: no `add reg, [mem]` used -- every memory-derived value is staged through a register first.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // 5 pushes leave rsp%16==0 (entry %16==8, minus 40 = %16==0)
        // which is exactly what SysV requires at nested call sites.

        mov rbx, rdx;                    // rbx = mode (survives all calls)
        mov r12, rsi;                    // r12 = path_len (raw)
        mov r13, rdi;                    // r13 = path_va

        // ---- (1) Cap path_len at SYS_MKDIR_PATH_MAX - 1 = 255 ----
        mov r10, 255;
        cmp r12, r10;
        jbe sysmk_cap_ok;
        mov r12, r10;
      sysmk_cap_ok:
        cmp r12, 0;
        jne sysmk_len_ok;
        mov r12, 1;
      sysmk_len_ok:

        // ---- (2) user_read_str_via_walk(path_va, scratch, cap) ----
        mov rdi, r13;                    // arg0 = user path_va
        lea rsi, [rip + _sys_mkdir_path_scratch];   // arg1 = kernel dst
        mov rdx, r12;                    // arg2 = capped cap
        call user_read_str_via_walk;     // rax = strlen or 0 on fault
        cmp rax, 0;
        je  sysmk_efault;
        mov r13, rax;                    // r13 = strlen (path bytes in scratch)

        // ---- (3) Locate last '/' in scratch[0..strlen) ----
        // rcx = last-seen slash offset; initialize to sentinel = -1
        // (u64 all-ones).  r9 = current scan index.  r8 = current byte.
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        xor r9, r9;
        lea r10, [rip + _sys_mkdir_path_scratch];

      sysmk_scan_top:
        cmp r9, r13;
        jae sysmk_scan_done;
        xor r8, r8;
        mov_b r8, [r10 + r9*1];
        cmp r8, 0x2F;                    // '/'
        jne sysmk_scan_next;
        mov rcx, r9;                     // remember last slash offset
      sysmk_scan_next:
        add r9, 1;
        jmp sysmk_scan_top;

      sysmk_scan_done:
        // If no slash found, ENOENT.
        cmp rcx, 0xFFFFFFFFFFFFFFFF;
        je  sysmk_enoent;

        // NUL-terminate scratch at [scratch + rcx] so the parent-path
        // is a valid C-string. Also serves as the boundary between
        // parent-path and basename.
        //
        // For "/foo" case (rcx == 0): the leading '/' is overwritten
        // with NUL, leaving an empty parent-path string which path_
        // resolve interprets as the root anchor.
        xor r8, r8;
        mov_b [r10 + rcx*1], r8;         // NUL-terminate at slash offset

        // basename_ptr = &scratch + rcx + 1.
        mov r14, r10;
        add r14, rcx;
        add r14, 1;

        // ---- (4) basename_len = strlen from r14, bounded by (r13 - rcx - 1) ----
        // The scratch was already NUL-terminated by the walker within
        // [0, cap]; we recompute basename_len as strlen(r14) which is
        // (r13 - rcx - 1) bytes (r13 is the original strlen).
        //
        // Encoder gap: `sub reg, [mem]` unsupported -- fold register-
        // only: r15 = r13 - rcx - 1.
        mov r15, r13;
        sub r15, rcx;
        sub r15, 1;

        // If basename is empty (trailing-slash case), ENOENT.
        cmp r15, 0;
        je  sysmk_enoent;

        // ---- (5) mount_root_vnode() ----
        call mount_root_vnode;           // rax = root_vnode_idx
        cmp rax, 0;
        je  sysmk_enoent;
        mov r13, rax;                    // r13 = root_idx (path_va dead)

        // ---- (6) path_resolve(kernel_path, root_idx, cwd=0) ----
        lea rdi, [rip + _sys_mkdir_path_scratch];   // arg0 = kernel parent-path
        mov rsi, r13;                    // arg1 = root_idx
        xor rdx, rdx;                    // arg2 = cwd = 0
        call path_resolve;               // rax = parent_vnode_idx or 0
        cmp rax, 0;
        je  sysmk_enoent;

        // ---- (7) vnode_slot(parent_vnode_idx) -> &parent_vnode ----
        mov rdi, rax;
        call vnode_slot;                 // rax = &parent_vnode

        // ---- (8) vops_mkdir(&parent_vnode, basename_ptr, basename_len, mode) ----
        mov rdi, rax;                    // arg0 = &parent_vnode
        mov rsi, r14;                    // arg1 = basename_ptr
        mov rdx, r15;                    // arg2 = basename_len
        mov rcx, rbx;                    // arg3 = mode
        call vops_mkdir;                 // rax = 0 or backend errno
        cmp rax, 0;
        jne sysmk_eio;

        // ---- (9) Fingerprint emit ----
        // klog_s1_x1(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_mkdir_ok,
        //            k_path, v1=&_sys_mkdir_path_scratch (as hex u64))
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_mkdir_ok];
        lea rcx, [rip + k_path];                 // k1 = "path"
        lea r8,  [rip + _sys_mkdir_path_scratch]; // v1 = path buf VA
        call klog_s1_x1;

        // ---- (10) Success return ----
        xor rax, rax;                    // SYS_MKDIR_OK = 0
        jmp sysmk_done;

      sysmk_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp sysmk_done;

      sysmk_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT
        jmp sysmk_done;

      sysmk_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;     // -EIO

      sysmk_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
