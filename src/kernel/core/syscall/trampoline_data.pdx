// src/kernel/core/syscall/trampoline_data.pdx — R14b-m4-006b (#645) — SYSCALL trampoline RW scratch slot
// Holds saved user RSP, saved user CR3, and kernel PML4 phys for syscall entry/exit.
// Mapped into user PML4 via PT[261] with U=0 (ring-0 only) and XD=1 (no execute).
// Shared across all user aspaces via the KPTI trampoline-PDPT chain.

module TrampolineData = structure {
  pub let mut _saved_user_rsp : [u64; 1] = uninit @align(8)
  pub let mut _saved_user_pml4 : [u64; 1] = uninit @align(8)
  pub let mut _kernel_pml4_pa : [u64; 1] = uninit @align(8)
  pub let mut _iretq_frame_scratch : [u64; 5] = uninit @align(8)

  // #720 (#656 Phase C): ISR return-path scratch. Both slots live on the
  // trampoline data page (mapped in user_pml4 via PT[261], per #645) so
  // `_isr_return` can save/restore rax and reload user CR3 before iretq.
  // Total data-page usage now 80 B, well within 4 KiB.
  pub let mut _user_cr3_save : [u64; 1] = uninit @align(8)
  pub let mut _isr_scratch_rax : [u64; 1] = uninit @align(8)

  // R17-M0-724-D4 (#724 D4): saved user rax (syscall#) during syscall_entry.
  // Latent bug: syscall_entry clobbered rax with cr3 values (mov rax, cr3 at
  // step 3, then mov rax, [_kernel_pml4_pa] at step 5) BEFORE `push rax` at
  // step 8 which was intended to save the syscall#. Consequently push rax
  // pushed kernel_pml4_pa (0x101000) instead of the sysno, and the dispatch
  // shuffle's `pop rdi` loaded rdi=0x101000 — every init syscall silently
  // routed to dispatch_enosys (since 0x101000 > 61). Fix (in entry.pdx): save
  // rax into this slot BEFORE the cr3-read step, then reload from here into
  // rax just before `push rax`. This slot is on the trampoline data page,
  // accessible under both user CR3 (PT[261] mapping installed by
  // kpti_build_user_pml4) and kernel CR3 (higher-half identity via PML4[256]).
  // Single-slot: safe because IF=0 throughout syscall_entry (SYSCALL clears
  // it via IA32_FMASK) — no nested syscall can concurrently clobber it. SMP
  // will require per-CPU slot (mirror of _iretq_frame_scratch SMP note).
  pub let mut _saved_user_rax : [u64; 1] = uninit @align(8)

  // R17-M0-731 (#731): saved syscall RETURN value (rax) across the epilogue's
  // CR3 flip.  Symmetric with _saved_user_rax above, but on the exit side.
  //
  // The bug (pre-fix, latent since #502 landed the CR3 dance in R14b-m4-006,
  // silently hidden until #724 landed ring-3 syscallers): syscall_entry's
  // epilogue derives user_pml4_pa via three consecutive `mov rax, ...`
  // instructions (rax = _current_tcb; rax = [rax+16]; sub rax, KERNEL_VMA_BASE)
  // BETWEEN the `call syscall_dispatch` (which returned the syscall's u64
  // result in rax per SysV) and the `mov cr3, rax` + `sysret`.  Consequently
  // sysret placed user_pml4_pa (a small positive number ~0x2ea000) into
  // user rax for EVERY syscall from any ring-3 task.  Every negative errno
  // was masked (init's `cmp rax, 0; jl init_shutdown` never fired on wait4
  // returning -EFAULT — see #732), every real return value (pid from fork,
  // bytes-written from write, entry_rip from execve, etc.) was lost.
  //
  // Fix (in entry.pdx): immediately after `call syscall_dispatch` returns,
  // store rax into this slot; immediately before `sysret` (after all CR3
  // manipulation), reload rax from this slot.  Chose a memory slot over a
  // scratch GPR because (a) it survives the CR3 flip trivially (slot is
  // mapped in both PML4s), (b) no register-liveness reasoning across the
  // epilogue is needed (paideia-as's silent-miscompile history makes such
  // reasoning brittle), (c) it mirrors the D4 fix pattern.  Cost: one memory
  // round-trip per syscall (negligible).  Same UP-safety rationale as
  // _saved_user_rax: IF=0 window throughout entry/exit (SYSCALL clears IF via
  // IA32_FMASK; the `swapgs; sysret` epilogue completes atomically-observable
  // from userspace before IF is re-armed).  SMP will require per-CPU slot.
  //
  // Total trampoline-data-page usage after this slot: 96 B, well within 4 KiB.
  pub let mut _saved_syscall_ret_rax : [u64; 1] = uninit @align(8)
}
