// src/kernel/core/syscall/sys_mountinfo.pdx -- R57.M4-004 (paideia-os #1800)
//
// SYS_MOUNTINFO -- ring-3 mount-table introspection syscall body (sysno 84).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// The M4 milestone item R57.M4-004 asks for /bin/mount + the syscall that
// backs its no-args "list mounts" path.  This file lands the SYSCALL BODY
// (the kernel-side function the dispatch shim tail-calls into).  The
// dispatch shim itself lives in src/kernel/core/syscall/dispatch.pdx
// §dispatch_mountinfo (see the sibling dispatch_taskinfo for the byte-
// identical shim shape modulo record size + scratch symbol).
//
// This file is placed at src/kernel/core/syscall/ (NOT under handlers/)
// following the R53.M2-002 sys_mount / R57.M4-003 sys_taskinfo precedent
// -- the "one file per syscall at the top of the syscall namespace"
// convention for new (R51+) syscalls that participate in a broader design
// bundle.  Older handlers (sys_read, sys_write, sys_open) live under
// handlers/ because they predate that convention; the split is history,
// not policy.
//
// -----------------------------------------------------------------------------
// Contract summary
// -----------------------------------------------------------------------------
//
// sys_mountinfo_body(idx, kernel_dst) -> u64
//   Kernel-only entry point (no user pointers; the shim has already
//   validated the user buffer and passed a kernel-side .bss scratch).
//   Called by the dispatch shim AND by any future kernel-side witness
//   that exercises the body directly.
//
//   rdi = idx           in [0, MOUNT_MAX) -- an index into _mount_table
//                       (core/fs/mount.pdx §_mount_table).  MOUNT_MAX == 8
//                       at R53; a caller passing idx == 8 receives -ESRCH
//                       and stops iterating.
//   rsi = kernel_dst    kernel VA of a 32-byte destination buffer
//                       (MOUNT_INFO_RECORD_BYTES == 32).
//   -> rax = 0            success -- 32-byte record written to dst.
//            -ESRCH (-3)  idx >= MOUNT_MAX; iteration should stop.
//            -ENOENT (-2) idx is in-range but the slot is empty
//                        (backend_type == MOUNT_BACKEND_NONE == 0).
//
// -----------------------------------------------------------------------------
// Record layout (32 bytes) -- pinned here; extend by APPENDING only
// -----------------------------------------------------------------------------
//
//   +0   slot                 : u32   -- caller-supplied idx echoed back
//                                        so /bin/mount can format
//                                        "<slot>: ..." without carrying
//                                        the counter through the argv
//                                        parse layer.  Distinct from any
//                                        pool identity semantics -- this
//                                        is just a convenience copy.
//   +4   mountpoint_vnode_idx : u32   -- from _mount_table entry bits [0,16).
//                                        Zero for the pinned root slot
//                                        (bootstrap has no parent vnode);
//                                        non-zero for submounts.
//   +8   root_vnode_idx       : u32   -- from _mount_table entry bits [16,32).
//                                        The mounted fs's own root vnode.
//   +12  backend_type         : u32   -- from _mount_table entry bits [32,40).
//                                        Discriminant in
//                                        core/fs/mount.pdx §MOUNT_BACKEND_*
//                                        {NONE=0, TMPFS=1, DEVFS=2,
//                                        PROCFS=3, TTY=4, PDXFS_BLOCK=5}.
//                                        /bin/mount maps this to a wire
//                                        string ("tmpfs" / "devfs" / ...)
//                                        for the POSIX-style
//                                        `<mp> on <src> type <fs>` render.
//   +16  flags                : u32   -- from _mount_table entry bits [40,48).
//                                        {VALID=0x01, ROOT=0x02,
//                                        PENDING_UNMOUNT=0x04}.  Widen
//                                        room reserved to u32 rather than
//                                        u8 so future POSIX mount options
//                                        (RO/NOSUID/NOEXEC/NODEV/BIND)
//                                        do not need a record re-layout.
//   +20  reserved             : u32   -- zero-filled.  First candidate:
//                                        _mount_table entry's u16
//                                        _reserved field at bits [48,64)
//                                        once the R17+ refcount /
//                                        per-fs data index lands.
//   +24..+31 pad              : 8 B   -- zero-filled.  Room for a per-
//                                        mount source-path hash or a
//                                        mount_id / superblock digest
//                                        without record-size drift.
//
// The record is fixed 32 B so the dispatch shim's writeback slot
// (_dispatch_mountinfo_scratch : [u8; 32]) matches the primitive's
// contract byte-for-byte; grows only through this file plus the shim's
// scratch declaration.  Never write anything past +31.
//
// -----------------------------------------------------------------------------
// Why the body is a self-contained read -- layer discipline
// -----------------------------------------------------------------------------
//
// Unlike sys_taskinfo (R57.M4-003) which forwards to task_get_info
// (src/kernel/core/sched/task_info.pdx), sys_mountinfo reads _mount_table
// directly.  The rationale for the difference:
//
//   (a) The mount table is 8 slots * 8 bytes = 64 bytes total, one L1D
//       cache line.  The read is 6 register operations (load entry,
//       extract 4 fields via shift+mask, zero-fill destination, store
//       fields).  Splitting that into a primitive plus a wrapper adds
//       one CALL / RET pair + one alignment pad -- more overhead than
//       the read itself.
//
//   (b) task_get_info was factored out because a future kernel-side
//       consumer (panic-dump "who was running") needs the same read;
//       the mount-table equivalent (panic-dump "what was mounted")
//       already has an in-place walker in core/fs/mount.pdx
//       (mount_root_vnode + mount_lookup) -- both are field-specific
//       and neither wants a 32-B record.  A future generic
//       mount_get_info would land in core/fs/mount.pdx (module Mount)
//       if a witness needs it; at that point this body compresses to
//       the same thin-forwarder shape sys_taskinfo_body uses.
//
//   (c) Record shape evolution: appending fields (per §Record layout)
//       is a one-file edit here.  The kernel-side read primitive
//       shape is stable across MOUNT_BACKEND_* additions (the
//       discriminant lookup is pure extraction).
//
// -----------------------------------------------------------------------------
// Fingerprint posture -- declaration without emit
// -----------------------------------------------------------------------------
//
// tag_sys_mountinfo_ok is DECLARED in src/kernel/core/klog/keys.pdx
// alongside tag_sys_taskinfo_ok (same landing round, same iterator-
// syscall class) but is NOT emitted from this body.  Rationale:
//
//   (a) /bin/mount calls sys_mountinfo up to MOUNT_MAX times per invocation.
//       Emitting one fingerprint per successful call would produce up
//       to 8 identical `sys mountinfo ok` lines per `mount` run,
//       inflating the ring for no diagnostic gain (the individual row
//       contents are already visible on the caller's stdout).
//
//   (b) The declared-but-unemitted pattern matches tag_sys_taskinfo_ok
//       (keys.pdx L1216) verbatim.  A future one-shot kernel-side
//       witness that exercises the syscall end-to-end (kernel driver
//       calling through dispatch_mountinfo, observing the record on
//       wire) is the natural first consumer and emits the tag exactly
//       once at witness top.
//
//   (c) State-changing syscalls (sys_mkdir, sys_rmdir, sys_stat,
//       sys_rename, sys_unlink) DO emit a per-call fingerprint because
//       each successful call mutates the FS namespace and the emit
//       records the mutation for post-mortem replay.  A read-only
//       iterator does not carry that same accountability need.
//
// -----------------------------------------------------------------------------
// Effect row -- why !{mem} @{} and not {mem, sysreg} @{cap}
// -----------------------------------------------------------------------------
//
// Mirrors sys_taskinfo_body's own posture: the BODY function is a leaf
// (register-to-register + a small number of memory reads/writes), so
// its effect row is honestly !{mem} @{}:
//
//   !{mem}   -- reads _mount_table + writes the 32B record.
//   !{}      -- no MSR / CR touches (the syscall entry did the sysret /
//               CR3 flip before dispatch runs; the body sees a clean
//               SysV call).
//   @{}      -- no capability check inside the body.  A future capability
//               gate (KIND_MOUNTINFO with R_INTROSPECT rights, symmetric
//               to the planned KIND_TASKINFO gate) lives at the dispatch
//               shim BEFORE the body is called; the body itself is
//               unchanged.  This matches sys_taskinfo_body's leaf-read
//               posture (sys_taskinfo.pdx L84-97).
//
// The dispatch shim's declared effect row (dispatch.pdx §syscall_dispatch)
// already unions `sysreg` and @{cap, sched} for exactly this reason.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// paideia-as (phase-3-m2-002) is known to reject some `mov reg, imm`
// forms in no-frame-lambda contexts (per R57 encoder debt, first hit on
// ps.pdx per #1799) and does NOT support `add reg, [mem]` / `sub reg,
// [mem]`.  Every immediate load in this body uses the ordinary
// `mov reg, imm` shape at function scope (not no-frame-lambda), and every
// memory address lands in a register via `lea` + `mov r64, [mem]`
// before arithmetic runs -- no memory-mem operand pairs anywhere.
//
// The u32 field writes use the `mov_d [rsi + k], rcx` sized-store form
// per the G1 workaround documented at src/kernel/core/sched/
// task_info.pdx L250-260 (unsized `mov [mem], ecx` silently widens to
// REX.W in paideia-as's encoder).  The zero-fill's four qword stores
// use unsized `mov [rsi + k], rcx` deliberately -- the width IS 8 B
// for those and REX.W is what we want.
//
// -----------------------------------------------------------------------------
// Cross-references
// -----------------------------------------------------------------------------
//
//   src/kernel/core/fs/mount.pdx            -- _mount_table + bit layout
//   src/kernel/core/syscall/dispatch.pdx    -- dispatch_mountinfo shim
//   src/kernel/core/klog/keys.pdx           -- tag_sys_mountinfo_ok
//   src/user/mount.pdx                      -- /bin/mount M0 caller

module SysMountinfo = structure {

  // Record-size and error-sentinel pins.  Public so a witness that
  // wants to reason about the record shape can pull them from here
  // rather than hard-coding numbers.
  pub let MOUNT_INFO_RECORD_BYTES : u64 = 32
  pub let MOUNT_INFO_ERR_ENOENT   : u64 = 0xFFFFFFFFFFFFFFFE   // -2
  pub let MOUNT_INFO_ERR_ESRCH    : u64 = 0xFFFFFFFFFFFFFFFD   // -3

  // ==========================================================================
  // sys_mountinfo_body(idx, kernel_dst) -> u64 in rax.
  //
  // Alignment: entry rsp %16 == 8 (SysV; the dispatch shim called us with
  // a `call sys_mountinfo_body` after its own #672 pad).  No nested calls
  // in this body -- the entire read is inline -- so no additional
  // alignment discipline is required beyond respecting SysV callee
  // callee-save (rbx / r12-r15) which we do not touch.
  //
  // Register plan (leaf function, no callee-save writes):
  //   rdi = idx           (arg0; consumed for bounds check + table index)
  //   rsi = kernel_dst    (arg1; base for the 32-byte record writeback)
  //   rax = return-value accumulator / entry loader / working register
  //   rcx = field extraction / zero-fill source
  //   r8  = _mount_table base VA (loaded once via lea)
  //   r9  = raw entry u64 saved for successive shift+mask extractions
  // ==========================================================================
  pub let sys_mountinfo_body : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64) (kernel_dst: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R57.M4-004 (#1800): sys_mountinfo syscall body (sysno 84). Self-contained read of _mount_table[idx] -- the mount-table equivalent of R57.M4-003's task_get_info primitive, but inlined here rather than split into a fs/mount.pdx primitive because the read is 6 instructions (load entry, extract 4 fields via shift+mask, zero-fill destination, store fields) and splitting adds a CALL/RET pair with more overhead than the read itself. Refuses idx >= MOUNT_MAX (8) with -ESRCH so an iterating /bin/mount knows when to stop; refuses an in-range idx whose _mount_table entry has backend_type == MOUNT_BACKEND_NONE (0, matching BSS zero-init) with -ENOENT so the caller can skip a dead slot and continue. The distinction is load-bearing: an out-of-range idx cannot be recovered from by advancing, an empty slot can, and folding both into one sentinel would either terminate iteration prematurely or loop past end -- same rationale as task_get_info at task_info.pdx L108-113. On success, zero-fills the 32-byte destination via four qword stores (well below the rep_stosq setup break-even) then overwrites u32 slots at +0/+4/+8/+12/+16 with slot/mountpoint_vnode_idx/root_vnode_idx/backend_type/flags. +20 and +24..+31 stay zero as reserved growth room. Leaf function; no callee-save prologue needed (rbx/r12-r15 untouched). Effect row {mem} @{} matches sys_taskinfo_body's own leaf-read posture (sys_taskinfo.pdx L84-97) rather than the syscall path's {mem, sysreg} @{cap} because the sysret/CR3 flip happened at syscall_entry before dispatch, and the M1+ capability policy (KIND_MOUNTINFO with R_INTROSPECT rights, symmetric to KIND_TASKINFO) will land at the dispatch shim BEFORE the body call. Encoder-safe: field writes use `mov_d [rsi + k], rcx` sized-store form per the G1 workaround at task_info.pdx L250-260 (unsized `mov [mem], ecx` silently widens to REX.W in paideia-as's encoder); the zero-fill's four qword stores use unsized `mov [rsi + k], rcx` deliberately (width IS 8 B for those and REX.W is wanted). No `add/sub reg, [mem]` shape anywhere; the entry ptr lands in r8 via `lea` + `mov rax, [r8 + rdi*8]`. Fingerprint posture: tag_sys_mountinfo_ok is DECLARED in keys.pdx alongside tag_sys_taskinfo_ok but NOT emitted from this body -- an iterator syscall called up to MOUNT_MAX times per /bin/mount invocation would inflate the ring with duplicate 'sys mountinfo ok' lines for no diagnostic gain. A future one-shot kernel-side witness (mirroring the R57.M4-003 taskinfo witness plan) is the natural first emit site. Concurrency at R53 single-CPU cooperative is coherent (mount() step-6 store is the last write to _mount_table[slot]; unmount clears the slot atomically); SMP composes a seqlock at the mount()/umount() ingress and this body stays byte-identical.",
      block: {
        // ---- Gate 1: idx < MOUNT_MAX (8) ----
        // core/fs/mount.pdx §MOUNT_MAX pins _mount_table as [u64; 8]; the
        // `jae` bound (rather than `ja`) refuses idx == 8 rather than
        // reading one qword past the declared array, mirroring task_
        // info.pdx L217-219 and pid_alloc's #740 fix.
        cmp rdi, 8;
        jae smi_esrch;

        // ---- Load _mount_table[idx] into r9 ----
        // Two-step form to sidestep the encoder gap on `add reg, [mem]`:
        // lea the table base into a register first, then use the SIB
        // scale-8 addressing to load the qword entry in one op.
        lea r8, [rip + _mount_table];
        mov r9, [r8 + rdi*8];

        // ---- Gate 2: entry non-empty (backend_type != MOUNT_BACKEND_NONE) ----
        // backend_type lives at bits [32, 40) of the u64 entry (see
        // core/fs/mount.pdx §MOUNT_BACKEND_SHIFT).  Shift + mask to
        // isolate; compare against 0 (MOUNT_BACKEND_NONE, which also
        // matches BSS zero-init for empty slots).
        mov rax, r9;
        shr rax, 32;                     // shift backend byte into low 8
        and rax, 0xFF;                   // mask to u8
        cmp rax, 0;                      // MOUNT_BACKEND_NONE
        je smi_enoent;

        // Save backend_type in rax for the +12 store below.  rax was
        // holding backend_type from the gate above; re-derive it after
        // the zero-fill loop rather than tracking it through the fill
        // (fewer live registers to reason about).

        // ---- Zero-fill the 32-byte destination ----
        // Four qword stores rather than rep_stosq: 32 B is well below
        // the rep_stosq setup break-even, and rep_stosq's rdi/rcx/rax
        // clobber would force a re-load of the entry.  This is the same
        // pattern task_info.pdx §L237-247 and sys_pdxfs_dir_readnext_body
        // both use for their fixed-size record fills.
        xor rcx, rcx;
        mov [rsi + 0], rcx;
        mov [rsi + 8], rcx;
        mov [rsi + 16], rcx;
        mov [rsi + 24], rcx;

        // ---- Copy slot (u32 @ dst+0) ----
        // Echo the caller's idx back into the record so /bin/mount can
        // format "<slot>: ..." without carrying the loop counter through
        // its argv parse layer.  rdi is in [0, 8) at this point (gate 1
        // above), so any zero-extension into u32 is a no-op.
        mov rcx, rdi;
        mov_d [rsi + 0], rcx;             // G1: sized 32-bit store

        // ---- Copy mountpoint_vnode_idx (u32 @ dst+4) ----
        // Extract bits [0, 16) of the entry.  The mask uses the full
        // u16 width even though only 0..VNODE_MAX (511 at R17) are ever
        // written today, so a future VNODE_MAX bump does not silently
        // truncate.
        mov rcx, r9;
        and rcx, 0xFFFF;                  // mount.pdx §MOUNT_U16_MASK
        mov_d [rsi + 4], rcx;             // G1: sized 32-bit store

        // ---- Copy root_vnode_idx (u32 @ dst+8) ----
        // Extract bits [16, 32).  Same u16 width as mountpoint_vnode_idx.
        mov rcx, r9;
        shr rcx, 16;                      // mount.pdx §MOUNT_ROOT_SHIFT
        and rcx, 0xFFFF;
        mov_d [rsi + 8], rcx;             // G1: sized 32-bit store

        // ---- Copy backend_type (u32 @ dst+12) ----
        // Extract bits [32, 40).  The discriminant is currently u8
        // ({NONE=0, TMPFS=1, DEVFS=2, PROCFS=3, TTY=4, PDXFS_BLOCK=5})
        // but the record allocates u32 so a future backend enumeration
        // beyond 255 does not need a record-shape edit.
        mov rcx, r9;
        shr rcx, 32;                      // mount.pdx §MOUNT_BACKEND_SHIFT
        and rcx, 0xFF;                    // mount.pdx §MOUNT_U8_MASK
        mov_d [rsi + 12], rcx;            // G1: sized 32-bit store

        // ---- Copy flags (u32 @ dst+16) ----
        // Extract bits [40, 48).  Flags are u8 today
        // ({VALID=0x01, ROOT=0x02, PENDING_UNMOUNT=0x04}) with room
        // reserved for future POSIX mount options
        // (RO/NOSUID/NOEXEC/NODEV/BIND per mount.pdx §L72), so u32 in
        // the record leaves headroom for them to arrive without a
        // record-layout edit.
        mov rcx, r9;
        shr rcx, 40;                      // mount.pdx §MOUNT_FLAGS_SHIFT
        and rcx, 0xFF;                    // mount.pdx §MOUNT_U8_MASK
        mov_d [rsi + 16], rcx;            // G1: sized 32-bit store

        // ---- +20 reserved and +24..+31 pad stay 0 ----
        // See §"Record layout" in the file header: reserved slot mirrors
        // _mount_table's own u16 _reserved field (bits [48, 64), for
        // R17+ refcount or per-fs data index); +24..+31 pad reserved
        // for a per-mount source-path hash or a mount_id / superblock
        // digest.  Both slots stay zero-filled at M0.

        xor rax, rax;                     // return 0 (success)
        ret;

      smi_esrch:
        mov rax, 0xFFFFFFFFFFFFFFFD;      // -ESRCH
        ret;

      smi_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;      // -ENOENT
        ret
      }
    }

}
