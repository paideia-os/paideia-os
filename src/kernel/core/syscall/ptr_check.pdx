// src/kernel/core/syscall/ptr_check.pdx — R15-M4-007 (#541)
// Helper: user_ptr_ok(va, len) — validate a user-supplied pointer.
//
// Phase 1 (this file): range check only.
//   va < KERNEL_VMA_BASE AND va+len <= KERNEL_VMA_BASE (no overflow into
//   kernel half) → OK (rax = 0). Otherwise fault sentinel (rax = 1).
//   The caller maps that to -EFAULT (0xFFFFFFFFFFFFFFF2 = -14 sign-extended).
//
// Phase 2 (deferred until #679 unblocks real ring-3): walk the current
// task's user_pml4 to confirm each page in [va, va+len) is present + user.
// Pattern is aspace_map's read side or probe_walk_va. When landing, keep
// the public signature (va, len) → u64 unchanged; internally short-circuit
// the range check first, then walk first + last page of the range.
//
// ABI:
//   rdi = va  (byte address, 64-bit user VA)
//   rsi = len (byte count)
//   → rax = 0 (OK) or 1 (fault)
//
// Clobbers: rax only (per softarch's PtrCheck contract).
//
// AC (#541): sys_write(1, 0xFFFFFFFFFFFFFFFF, 4) returns -14. Both
// dispatch.pdx dispatch_write and handlers/sys_write.pdx sys_write_body
// call this helper for defense-in-depth (the fixture hits the UART
// fast-path in dispatch, not the body).

module PtrCheck = structure {
  // -EFAULT as a u64 (sign-extended -14 per Linux errno convention;
  // matches SYS_WRITE_ERR_EBADF's shape at handlers/sys_write.pdx:18).
  pub let EFAULT : u64 = 0xFFFFFFFFFFFFFFF2

  // Kernel virtual-address space starts at KERNEL_VMA_BASE. User VAs must
  // sit strictly below this. Duplicated from mm/aspace_map.pdx / kpti.pdx
  // (a third copy — worth consolidating in a future refactor).
  pub let KERNEL_VMA_BASE : u64 = 0xFFFF800000000000

  // user_ptr_ok(va, len) — Phase 1 range check.
  //
  // Returns 0 if [va, va+len) lies entirely below KERNEL_VMA_BASE with no
  // overflow. Returns 1 otherwise. Leaf function, no callee-save discipline
  // beyond the callee-saved regs (rbx, rbp, r12-r15) which we don't touch.
  pub let user_ptr_ok : (u64, u64) -> u64 !{} @{} =
    fn (va: u64, len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R15-M4-007 (#541) Phase 1: range check. Load KERNEL_VMA_BASE (movabs — no imm64 form for cmp), reject va >= base via cmp+jae. Compute end = va + len (rax + rsi); check for overflow via jc (carry set means addition wrapped past u64 max, definitely into kernel half); reject end > base via cmp+ja. Both checks fall through to `return 0` (OK). Any failure jumps to fault_return which sets rax=1. Leaf function; no prologue/epilogue; clobbers only rax (rcx is scratch during the compare load). Phase 2 (deferred until #679) will add a PT walk here after the range check short-circuits.",
      block: {
        // rcx = KERNEL_VMA_BASE (must movabs — no imm64 form for cmp)
        mov rcx, 0xFFFF800000000000;

        // (1) va < KERNEL_VMA_BASE?
        cmp rdi, rcx;
        jae user_ptr_ok_fault;

        // (2) va + len <= KERNEL_VMA_BASE, checking for overflow first.
        // rax = va + len; carry set → overflowed past 2^64.
        // paideia-as uses `jb` for "jump if below" (same as JC/jump-if-carry).
        mov rax, rdi;
        add rax, rsi;
        jb user_ptr_ok_fault;

        // rax now holds va+len; must be < KERNEL_VMA_BASE (strict — a
        // len-0 write at KERNEL_VMA_BASE itself would already fail the
        // first check; len-nonzero can reach exactly at base which is
        // still user-half-outside, so ja is correct not jae).
        cmp rax, rcx;
        ja user_ptr_ok_fault;

        // OK — return 0.
        xor rax, rax;
        ret;

        user_ptr_ok_fault:
        mov rax, 1;
        ret
      }
    }
}
