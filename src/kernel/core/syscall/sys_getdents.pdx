// src/kernel/core/syscall/sys_getdents.pdx -- R56.M3-003 (#1792)
//
// sys_getdents body -- read directory entries into a user buffer as a
// packed record stream terminated by a zero-name-len record.
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
//   sys_getdents_body(current, fd, buf_ptr, nbytes) -> u64
//
//     rdi = current    (task_struct*, must be non-NULL; dispatch shim loads
//                       _current_tcb into rdi before the call)
//     rsi = fd         (validated in [3, 32) at the trust boundary)
//     rdx = buf_ptr    (user VA, gated via user_ptr_ok + KPTI-walk copy)
//     rcx = nbytes     (byte count; capped at GETDENTS_IO_MAX = 4096)
//
//     rax = bytes-written on success (may be < nbytes if the directory
//           ended; includes the trailing zero-name-len terminator record)
//     rax = -errno on failure:
//             -EBADF   (0xFFFFFFFFFFFFFFF7)  fd >= 32 OR fd_table[fd] == 0
//             -EFAULT  (0xFFFFFFFFFFFFFFF2)  buf_ptr failed user_ptr_ok
//                                              or the KPTI walker failed
//             -EIO     (0xFFFFFFFFFFFFFFFB)  backend vop_readdir returned
//                                              the VOPS_ERR_NOT_SUPPORTED
//                                              sentinel (e.g. pdxfs (block)
//                                              at R55 -- no dentry walker)
//                                              OR returned a byte count
//                                              exceeding the caller's cap
//                                              (defensive)
//
// -----------------------------------------------------------------------------
// Record layout (kernel scratch <-> user buf; frozen for R56.M3)
// -----------------------------------------------------------------------------
//
//   +0   ino:      u64   inode index (low 16 bits carry backend slot)
//   +8   name_len: u16   1..255 for a live entry; 0 marks the terminator
//   +10  type:     u8    VNODE_TYPE_DIR=2, VNODE_TYPE_REG=1 (backend-defined)
//   +11  reserved: u8    always 0 (padding for u64-aligned ino field)
//   +12  name[name_len]  no NUL terminator
//
//   Stream ends with a header whose name_len == 0 (12-byte terminator).
//
// -----------------------------------------------------------------------------
// KPTI bounce discipline
// -----------------------------------------------------------------------------
//
//   The dispatch shim (dispatch.pdx §dispatch_getdents) calls this body
//   directly WITHOUT a bounce buffer -- unlike dispatch_read /
//   dispatch_pdxfs_dir_readnext which bounce through _dispatch_*_scratch.
//   Reason: the sys_getdents record stream has a variable length that
//   only the backend adapter knows, so pre-allocating a fixed scratch in
//   the dispatch shim would either waste a page every call or force a
//   two-pass discipline. The body owns its own kernel scratch
//   (_sys_getdents_scratch) sized at GETDENTS_IO_MAX, fills it via the
//   vop_readdir dispatcher, then bulk-copies the returned prefix to the
//   user buffer via user_write_bytes_via_walk. That helper enforces its
//   own #741 Layer 2 range gate (user_va + len <= KERNEL_VMA_BASE) so a
//   ring-3 caller cannot corrupt the scratch's own address. The body's
//   own user_ptr_ok call is the first-line defence per the #741 pattern.
//
// -----------------------------------------------------------------------------
// Cursor discipline
// -----------------------------------------------------------------------------
//
//   The fd_entry packs {vnode_idx: bits[0,16), offset: bits[16,64)}. The
//   body treats fd_entry.offset as the readdir cursor (opaque to the
//   caller; incremented by the count of live records emitted so a
//   subsequent call resumes at the next unread entry). The backend
//   adapter accepts the cursor and returns bytes_written; the body walks
//   the scratch after the call to count live records (name_len > 0 up
//   to the terminator), advances the cursor by that count, and stores
//   the new entry back via fd_set.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline / effects / capabilities
// -----------------------------------------------------------------------------
//
// Labels prefixed `sgd_`. Effect row !{mem, sysreg} @{cap}: mem covers
// fd_table + vnode + inode reads/writes; sysreg covers klog UART emit;
// cap is forward-compat for R57+ per-task cap_table (fd_get -> cap_get).

module SysGetdents = structure {

  // === Error sentinels (Linux-style negative-errno u64) ===
  pub let SYS_GETDENTS_ERR_EBADF  : u64 = 0xFFFFFFFFFFFFFFF7   // -9
  pub let SYS_GETDENTS_ERR_EFAULT : u64 = 0xFFFFFFFFFFFFFFF2   // -14
  pub let SYS_GETDENTS_ERR_EIO    : u64 = 0xFFFFFFFFFFFFFFFB   // -5

  // === Layout constants ===
  pub let GETDENTS_IO_MAX         : u64 = 4096
  pub let GETDENTS_HEADER_SIZE    : u64 = 12
  pub let FD_TABLE_MAX            : u64 = 32
  pub let VOPS_ERR_NOT_SUPPORTED  : u64 = 0xFFFFFFFFFFFFFFFF

  // Kernel scratch owned by this body. Sized at GETDENTS_IO_MAX (matches
  // the dispatch-layer read/write/dmesg scratches over in dispatch.pdx).
  // Concurrency: single-flow at R56.M3 (matches the sibling scratches);
  // multi-task readdir moves this into a TCB-side scratch alongside the
  // read/write/dmesg counterparts.
  pub let mut _sys_getdents_scratch : [u8; 4096] = uninit @align(8)

  // ==========================================================================
  // sys_getdents_body(current, fd, buf_ptr, nbytes) -> u64
  //
  // Register plan (rbp-based frame + 5-push callee-save prologue + sub rsp, 24
  // for 3 u64 spill slots; alignment invariant %16==0 pre-nested-call):
  //
  //   Prologue instrs:
  //     push rbp        ; entry rsp%16==8; -> %16==0. rbp := prev rsp holder.
  //     mov rbp, rsp    ; rbp = rsp (currently %16==0).
  //     push rbx        ; %16==8. Saved at [rbp-8].
  //     push r12        ; %16==0. Saved at [rbp-16].
  //     push r13        ; %16==8. Saved at [rbp-24].
  //     push r14        ; %16==0. Saved at [rbp-32].
  //     push r15        ; %16==8. Saved at [rbp-40].
  //     sub rsp, 24     ; %16==(8-24) mod 16 == 0. Frame at [rbp-48..rbp-72).
  //
  //   Callee-save regs (post-prologue):
  //     rbx = current
  //     r12 = fd
  //     r13 = buf_ptr (user VA)
  //     r14 = nbytes_capped
  //     r15 = bytes_written (post-vops-readdir)
  //
  //   Frame slots (all u64; below the saved-regs area at [rbp-8..rbp-40)):
  //     [rbp-48] = fd_entry (orig; source of vnode_idx + old_cursor)
  //     [rbp-56] = vnode_ptr (result of vnode_slot)
  //     [rbp-64] = entries_emitted (counted post-vops)
  //
  //   Epilogue: add rsp, 24; pop r15; pop r14; pop r13; pop r12; pop rbx;
  //             pop rbp; ret.
  // ==========================================================================
  pub let sys_getdents_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (current: u64) (fd: u64) (buf_ptr: u64) (nbytes: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R56.M3-003 (#1792): sys_getdents body. Contract in §Contract above; frame layout in the block-level comment. rbp-based frame chosen over pure register-recycling because the body threads three cross-call live values (fd_entry, vnode_ptr, entries_emitted) plus four callee-save args (current/fd/buf/nbytes) plus one post-vops carry (bytes_written) through seven nested calls (user_ptr_ok, fd_get, vnode_slot, vops_readdir, fd_set, user_write_bytes_via_walk, klog_s1_x2) and the register footprint outruns the 5-slot callee-save budget. Alignment ledger: entry rsp%16==8; push rbp (%16==0); mov rbp,rsp; push rbx/r12/r13/r14/r15 (5 x -8 = -40, %16==8); sub rsp,24 (-24, %16==0). Every nested call sees %16==0 pre-CALL so callee entry %16==8 per SysV. Frame slots at [rbp-48], [rbp-56], [rbp-64] — see block comment for exact layout. Phase 1: cap nbytes at 4096; user_ptr_ok(buf, capped_len) -> fault flag; validate fd < 32; fd_get -> entry; check entry != 0. Phase 2: extract vnode_idx (low 16); vnode_slot -> vnode_ptr (spilled to [rbp-56]). Phase 3: vops_readdir(vnode_ptr, scratch, capped_len, cursor=entry>>16); sentinel VOPS_ERR_NOT_SUPPORTED via imm64 movabs + cmp -> -EIO; defensive cmp rax > capped_len -> -EIO. r15 gets bytes_written. Phase 4a: walk scratch to count entries with name_len != 0 up to terminator; store in [rbp-64]. Phase 4b: fd_set(current, fd, vnode_idx | ((old_cursor+entries)<<16)). Phase 4c: user_write_bytes_via_walk(buf, scratch, bytes_written) -> -EFAULT on failure. Phase 4d: klog_s1_x2(LEVEL_INFO=3, SUBSYS_VFS_, tag_sys_getdents_ok, k_path=vnode_idx, k_entries=entries) with `sub rsp,8; push v2; call; add rsp,16` v2 idiom. Phase 5: return bytes_written. Every error path drops through a shared sgd_epilogue that undoes sub rsp,24 and 5 register pops + pop rbp before ret. Reserved labels: sgd_.",
      block: {
        push rbp;
        mov rbp, rsp;
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                        // rbx = current
        mov r12, rsi;                        // r12 = fd
        mov r13, rdx;                        // r13 = buf_ptr (user VA)
        mov r14, rcx;                        // r14 = nbytes (uncapped)

        // ===== Phase 1a: cap nbytes at GETDENTS_IO_MAX =====
        mov rax, 4096;
        cmp r14, rax;
        jbe sgd_len_ok;
        mov r14, rax;
      sgd_len_ok:

        // ===== Phase 1b: user_ptr_ok(buf, capped_len) =====
        mov rdi, r13;
        mov rsi, r14;
        call user_ptr_ok;                    // rax = 0 (OK) or 1 (fault)
        cmp rax, 0;
        jne sgd_efault;

        // ===== Phase 1c: validate fd < 32 =====
        cmp r12, 32;
        jae sgd_ebadf;

        // ===== Phase 1d: fd_get(current, fd) -> entry =====
        mov rdi, rbx;
        mov rsi, r12;
        call fd_get;                         // rax = packed entry (u64)
        cmp rax, 0;
        je  sgd_ebadf;
        mov [rbp - 48], rax;                  // spill orig entry

        // ===== Phase 2a: extract vnode_idx (low 16 bits of entry) =====
        mov rdi, rax;
        and rdi, 0xFFFF;

        // ===== Phase 2b: vnode_slot(vnode_idx) -> vnode_ptr =====
        call vnode_slot;                     // rax = &vnode
        mov [rbp - 56], rax;                 // spill vnode_ptr

        // ===== Phase 3: vops_readdir(vnode_ptr, scratch, capped_len, cursor) =====
        mov rdi, [rbp - 56];                 // arg0 = vnode_ptr
        lea rsi, [rip + _sys_getdents_scratch]; // arg1 = kernel scratch base
        mov rdx, r14;                        // arg2 = capped nbytes
        mov rcx, [rbp - 48];
        shr rcx, 16;                         // arg3 = cursor = orig_entry >> 16
        call vops_readdir;                   // rax = bytes_written or sentinel

        // Sentinel check: VOPS_ERR_NOT_SUPPORTED == 0xFFFFFFFFFFFFFFFF
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rcx;
        je  sgd_eio;

        // Defensive: reject bytes_written > capped_len (backend misbehaviour).
        cmp rax, r14;
        ja  sgd_eio;

        mov r15, rax;                        // r15 = bytes_written

        // ===== Phase 4a: walk scratch to count entries =====
        //   rcx = walk offset; rdi = entries counter; r8 = name_len temp;
        //   rax = scratch base; r9 = per-iter record ptr (= scratch + rcx).
        //   Address form: mov_w on [base + reg + imm] not proven in this
        //   codebase, so we materialise the record ptr in r9 per iteration
        //   and load via mov_w r8, [r9 + 8] (base + imm form, proven).
        lea rax, [rip + _sys_getdents_scratch];
        xor rcx, rcx;
        xor rdi, rdi;
      sgd_count_top:
        cmp rcx, r15;
        jae sgd_count_done;
        // Bounds: header (12 B) must fit.
        mov r8, rcx;
        add r8, 12;
        cmp r8, r15;
        ja  sgd_count_done;
        // Load name_len (u16) at [scratch + rcx + 8].
        mov r9, rax;
        add r9, rcx;                         // r9 = &scratch[rcx]
        xor r8, r8;
        mov_w r8, [r9 + 8];
        cmp r8, 0;
        je  sgd_count_done;                  // terminator hit
        add rdi, 1;
        add rcx, 12;
        add rcx, r8;                         // advance past name bytes
        jmp sgd_count_top;
      sgd_count_done:
        mov [rbp - 64], rdi;                 // spill entries_emitted

        // ===== Phase 4b: fd_set(current, fd, new_entry) =====
        //   new_entry = vnode_idx | ((old_cursor + entries) << 16)
        mov r8, [rbp - 48];                   // r8 = orig entry
        mov r9, r8;
        and r9, 0xFFFF;                      // r9 = vnode_idx
        shr r8, 16;                          // r8 = old_cursor
        add r8, [rbp - 64];                  // r8 = new_cursor = old + entries
        shl r8, 16;
        or  r9, r8;                          // r9 = new_entry

        mov rdi, rbx;                        // arg0 = current
        mov rsi, r12;                        // arg1 = fd
        mov rdx, r9;                         // arg2 = new_entry
        call fd_set;

        // ===== Phase 4c: user_write_bytes_via_walk(buf, scratch, bytes_written) =====
        //   Skip if bytes_written == 0 (unusual but legal).
        cmp r15, 0;
        je  sgd_walk_done;
        mov rdi, r13;                        // arg0 = user buf VA
        lea rsi, [rip + _sys_getdents_scratch]; // arg1 = kernel src
        mov rdx, r15;                        // arg2 = bytes_written
        call user_write_bytes_via_walk;      // rax = 0 (OK) or -EFAULT
        cmp rax, 0;
        jne sgd_efault;

      sgd_walk_done:
        // ===== Phase 4d: emit fingerprint =====
        //   klog_s1_x2(LEVEL_INFO=3, SUBSYS_VFS_, tag_sys_getdents_ok,
        //              k_path=vnode_idx, k_entries=entries).
        //   Recompute vnode_idx from orig entry (fresh load).
        mov r10, [rbp - 48];
        and r10, 0xFFFF;                     // r10 = vnode_idx (path proxy)
        mov r11, [rbp - 64];                 // r11 = entries

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_VFS_];
        lea rdx, [rip + tag_sys_getdents_ok];
        lea rcx, [rip + k_path];
        mov r8, r10;                         // v1 = vnode_idx
        lea r9, [rip + k_entries];
        // v2 push convention (wal.pdx L926-935): `sub rsp,8; push v2;
        // call; add rsp,16`. Frame is at rsp%16==0 post-prologue (see
        // §Alignment ledger in the justification). sub rsp,8 -> %16==8;
        // push r11 -> %16==0 pre-call.
        sub rsp, 8;
        push r11;
        call klog_s1_x2;
        add rsp, 16;

        // ===== Phase 5: return bytes_written =====
        mov rax, r15;
        jmp sgd_epilogue;

      sgd_ebadf:
        mov rax, 0xFFFFFFFFFFFFFFF7;         // -EBADF
        jmp sgd_epilogue;

      sgd_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;         // -EFAULT
        jmp sgd_epilogue;

      sgd_eio:
        mov rax, 0xFFFFFFFFFFFFFFFB;         // -EIO

      sgd_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
