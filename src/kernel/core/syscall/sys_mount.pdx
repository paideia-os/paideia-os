// src/kernel/core/syscall/sys_mount.pdx -- R53.M2-002 (paideia-os #1737)
//
// SYS_MOUNT -- ring-3 mount syscall body + dispatch shim (sysno 73).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/tooling/volume-lifecycle-mechanism.md §5.2 / §5.4, and paideia-os
// R53.M2 milestone item R53.M2-002:
//
//   "New src/kernel/core/syscall/sys_mount.pdx (body + dispatch shim)"
//
// The task's framing: "sys_mount_body(dev_path_ptr, dev_path_len,
// mount_point_ptr, mount_point_len, backend_id) -> u64 -- validates
// arguments; for backend_id=5 (BACKEND_PDXFS_BLOCK) resolves dev_path
// to bdev_cap, calls mount_pdxfs_block; for backend_id in {0..4}
// dispatches to existing backends via backend_registry.pdx; emits
// AUD_MOUNT audit record".  The dispatch shim (sysno 73's entry from
// core/syscall/dispatch.pdx) is a companion function landing here so
// the whole syscall lives in one file, mirroring
// core/syscall/handlers/sys_execve_shim.pdx's shape.
//
// This file is placed at src/kernel/core/syscall/ (NOT under handlers/)
// exactly as the R53.M2-002 task's own path specifies.  The other sysno
// handlers live under handlers/; sys_mount lives one directory up
// because the M2 milestone explicitly puts sys_mount / sys_umount at
// the top of the syscall namespace, aligning with the volume-lifecycle
// design doc's own layout in §5.4.
//
// -----------------------------------------------------------------------------
// Sibling coordination (M2 wave)
// -----------------------------------------------------------------------------
//
//  - R53.M2-001 (#1736): widens dispatch.pdx's bounds check + adds
//    `cmp rdi, 73; je dispatch_mount` -- OWNED BY SIBLING; this file
//    does not touch dispatch.pdx.
//  - R53.M2-003 (#1738): sibling sys_umount.pdx.
//  - R53.M2-004 (#1739): mount.pdx bounds widening 4 -> 5 -- LANDED
//    (see mount.pdx L141: `cmp r14, 5; ja mount_fail`).
//  - R53.M2-006 (#1741): backend_registry.pdx dispatch arm for
//    backend=5 -- LANDED at R52.M5-005 (#1707) already; sibling #1741
//    is a no-op re-audit.
//  - R53.M5-002 (#1755): LANDED HERE.  sys_mount now emits a real
//    audit record on successful mount (post-dispatch, ONLY on
//    success -- a refused arg or a failed mount() records nothing,
//    matching every other audit_emit call site in this codebase per
//    §5 of the audit schema module header).  The emit carries:
//      evt            = AUD_EV_MOUNT (13) -- sibling #1754 landed
//                       this ordinal in audit_schema.pdx along with
//                       an AUD_EV_MAX bump from 12 to 19, so
//                       audit_emit's own aud_ev_valid check accepts
//                       it (a naked 13 without #1754 would trip
//                       AUD_ERR_BAD_EVT and drop the record).
//      slot           = mount_slot returned by mount() (in [0..7])
//      payload_lo     = (op_disc << 28) | (backend_id << 24) | path_hash_24
//      op_disc        = 0 (SYS_MOUNT_OP_DISC_MOUNT) -- redundant for
//                       mount (the evt ordinal alone distinguishes
//                       mount from umount), kept as a 0-valued nibble
//                       so the payload layout is byte-identical to
//                       sys_umount.pdx's own emit (op_disc = 1 for
//                       umount-lazy, 2 for umount-immediate) and a
//                       subscriber's decoder table is one table
//                       rather than two.
//      path_hash_24   = 24-bit djb2 fold of the mount_point path
//                       (mount_point_ptr, mount_point_len).  This is
//                       a NON-CRYPTOGRAPHIC placeholder -- paideia-as
//                       has no blake3_hash32 kernel-callable primitive
//                       yet (RELEASE-NOTES-v0.20.md lists BLAKE3-in-
//                       .pdx as a deferred Class-A blocker; also see
//                       core/fs/pdxfs/sig_verify.pdx §sig_hash_verify_
//                       stub for the same class of gap and the "fail-
//                       closed until real primitive lands" pattern
//                       (#1725 ref)).  When blake3_hash32 lands, the
//                       fold loop is replaced by a single call to it
//                       without touching the payload layout (24-bit
//                       slot stays 24 bits wide -- blake3 output is
//                       simply truncated).
//
// -----------------------------------------------------------------------------
// Scaffolding posture -- what is real, what is a stub
// -----------------------------------------------------------------------------
//
// REAL:
//   (a) All argument gates (backend_id membership, path length ranges).
//   (b) Backend dispatch for backend_id == 0 (BACKEND_TMPFS): forwards
//       mount_point_ptr straight into core/fs/mount.pdx's `mount()`
//       with backend_type=MOUNT_BACKEND_TMPFS (1) and returns its
//       result verbatim (mount_slot in [0..7] on success; 0xFFFF on
//       any mount() failure including "table full", "vnode OOM", or
//       "path_resolve rejected the mountpoint").
//   (c) The AUD_MOUNT audit emit at smb_success (R53.M5-002 / #1755
//       -- see §Sibling coordination above for the payload layout
//       and the fallback event ordinal).  The blake3(path) primitive
//       the payload's path_hash slot ultimately targets is itself
//       still a stub (djb2 fold) until paideia-as ships blake3_hash32
//       -- see §Sibling coordination for that Class-A blocker.
//
// STUB (deferred to a follow-up wave; each stub is a distinct sentinel
// return so a caller distinguishes "not yet wired" from "arg refused"):
//
//   (d) User-pointer walker bounces for the two path buffers.  The
//       body accepts kernel-VA path pointers as-is; the shim below
//       walks user paths into two dedicated .bss bounce scratches.
//       When the body is invoked directly from a kernel witness (per
//       the R42-PREP-007 sibling posture), no bounce is needed.
//   (e) [LANDED at R107.M1 / #2345]  dev_path -> bdev_cap resolution
//       for backend_id == 5.  Devfs is still a §5.2 gap (M2 of the
//       R107 persistent-home wave lands the real devfs backend); the
//       shim landed here parses the syntactic form "/dev/pdxvol<H>"
//       (H = one hex digit 0..f) and routes through the volume
//       registry (kind_volume.pdx / volume_registry.pdx, R52.M5) to
//       reach the KIND_BLKDEV cap the R51 driver family minted at
//       probe time.  The block arm at smb_backend_pdxfs_block now
//       does: (a) 12-byte length + "/dev/pdxvol" prefix + hex-digit
//       parse -> row_id, (b) volume_tail_valid(row_id) live check,
//       (c) volume_row_device_slot(row_id) -> bdev_cap, (d) linear
//       scan cap_table[SM_CAP_POOL_LO..SM_CAP_POOL_HI) = [224..232)
//       for a free (kind==0) slot -> cap_slot, (e) call
//       mount_pdxfs_block(cap_slot, bdev_cap, 0, 0), (f) fold rax
//       >= 8 into SYS_MOUNT_MOUNT_FAIL / rax < 8 through smb_success
//       (uniform audit-emit convergence with the tmpfs arm).  When
//       R107.M2 devfs lands, steps (a)-(b) are swapped for a
//       tmpfs_lookup chain through the mounted /dev subtree that
//       extracts the KIND_BLKDEV cap from the resolved inode's
//       owner_cap slot; steps (c)-(f) stay byte-identical (the M2
//       resolver-swap is the sole diff at that landing).  When
//       cap/slab.pdx's slab_alloc stops being a stub, step (d) is
//       replaced by a single call to it; the [224..232) pool becomes
//       free for reuse at that point.
//
//       Diagnostic taxonomy for this arm ([FFED66/FFED67] are R107.M1
//       additions; see the failure taxonomy block below):
//         SYS_MOUNT_ENODEV (FFED66):    any resolver failure -- bad
//                                       length, bad prefix, non-hex
//                                       index char, or a syntactically
//                                       valid row_id that no probe
//                                       has registered.
//         SYS_MOUNT_ENOMEM_CAP (FFED67):cap-slot pool [224..232)
//                                       exhausted (8 active block
//                                       mounts already).
//         SYS_MOUNT_MOUNT_FAIL (FFED64):mount_pdxfs_block error
//                                       forwarded (its full taxonomy
//                                       -- sb_/vol_/jnl_ codes, table
//                                       full, ambiguous hint -- is
//                                       folded to this uniform code
//                                       so ring-3 sees the same shape
//                                       across both backends).
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- this file's slice of 0xFFFFED60..0xFFFFED67
// -----------------------------------------------------------------------------
//
// Per R53.M2-002 task: "Failure codes in R53 band; use 0xFFFFED60..67
// range".  Note collision-band caveat: several R53.M5 drivers
// (drivers/color/cicp, drivers/text/color_emoji, drivers/vello/
// vello_effects) share the 0xFFFFED60..6F range for their own module-
// internal sentinels.  Since sentinels here compare only within a
// sys_mount caller's rax return (never cross module boundaries), the
// band-level collision is a documentation-only concern -- the sibling
// #1755 audit wire-up may want to disambiguate before ring subscribers
// grow the ability to decode arbitrary sentinels.
//
//   SYS_MOUNT_EINVAL_BACKEND     = 0xFFFFED60   backend_id not in {0, 5}
//   SYS_MOUNT_EINVAL_MP_LEN      = 0xFFFFED61   mount_point_len 0 or > 256
//   SYS_MOUNT_EINVAL_DEV_LEN     = 0xFFFFED62   dev_path_len 0 or > 256
//   SYS_MOUNT_UNIMPL_PDXFS_BLOCK = 0xFFFFED63   backend=5 dev-path
//                                                resolver not landed
//                                                (§Scaffolding posture (e))
//   SYS_MOUNT_MOUNT_FAIL         = 0xFFFFED64   forwarded from mount()
//                                                which returned 0xFFFF
//                                                (table full / vnode OOM /
//                                                 path_resolve rejected)
//   SYS_MOUNT_EFAULT             = 0xFFFFED65   shim's walker rejected
//                                                one of the two user paths
//   SYS_MOUNT_ENODEV             = 0xFFFFED66   R107.M1 (#2345): dev_path
//                                                did not resolve to a live
//                                                KIND_BLKDEV cap.  Covers
//                                                both malformed shape
//                                                (not "/dev/pdxvol<hex>",
//                                                wrong length, non-hex
//                                                index char) AND syntactic-
//                                                ally valid rows that no
//                                                probe registered.
//   SYS_MOUNT_ENOMEM_CAP         = 0xFFFFED67   R107.M1 (#2345): the
//                                                sys_mount block-arm cap-
//                                                slot pool [224..232) is
//                                                exhausted (every slot in
//                                                the pool holds a non-zero
//                                                kind, i.e. eight active
//                                                block mounts already).
//
// R107.M1 (#2345) dev_path convention.  Devfs is not landed at R107.M1
// (M2 landing per design/roadmap/persistent-home-wave.md §R107); the
// syntactic shim this milestone lands is:
//
//   /dev/pdxvol<H>       -- H is one hex digit '0'..'9' or 'a'..'f',
//                            encoding a volume-registry row_id 0..15.
//                            Total length 12 bytes exactly.
//
// The row_id is resolved via volume_tail_valid + volume_row_device_slot
// (kind_volume.pdx / volume_registry.pdx, both landed at R52.M5) to the
// KIND_BLKDEV cap the R51 driver family minted at probe time.  When
// devfs lands at R107.M2, this parser is replaced by a proper devfs
// walker (tmpfs_lookup chain through the /dev subtree, extracting the
// KIND_BLKDEV cap from the resolved inode's owner_cap slot); the
// mount_pdxfs_block invocation stays byte-identical to the block-arm
// tail landed here, so the M2 landing is a resolver-swap at the
// smb_backend_pdxfs_block entry with no downstream churn.
//
// Cap-slot pool: fixed range [224..232) (8 slots, one per MOUNT_MAX
// entry).  This range OVERLAPS with two boot-transient witnesses:
// r30_platform.pdx thermal_policy_witness ([224..231]) and
// tb_route_witness ([216..231]).  Both boot witnesses run and
// scrub-clear their slots long before witness_r107_mount_block_call
// (last item in r30_platform.pdx's trailing witness chain), and
// sys_mount_body itself is a ring-3 syscall that cannot fire until
// init has spawned the shell — well after boot-witness teardown.  The
// pool is therefore safe today, but the overlap is documented as a
// latent hazard: a future change to either witness's exit-scrub, or
// any post-boot re-entry into those witness paths, would corrupt
// state.  R107.M2's landing swaps this fixed pool for slab_alloc
// (cap/slab.pdx) which removes the hazard.  A distinct pool at
// [172..177) was considered but MBOT_ROOT_VOLUME_CAP_SLOT=176 sits
// inside it (used at boot for the founder-home mount) and the [232..)
// band is claimed by post-R107 witnesses.  Linear scan for
// kind==0 (empty descriptor); returns SYS_MOUNT_ENOMEM_CAP on
// exhaustion.  When slab_alloc goes live (currently a stub returning
// CAP_SLAB_CAPACITY per cap/slab.pdx L101 header), the linear scan is
// replaced by a single call to it without touching the block arm's
// tail; the reserved pool then becomes free for reuse by any other
// kernel-side allocator wanting a fixed range.  The absence of a
// slab-based free-slot allocator at R107.M1 is documented as a
// substrate gap in the report at task closure.
//
// Successful returns are in [0..7] (the mount_table slot index) -- far
// below any 0xFFFFED6* sentinel, so a caller uses `cmp rax, 8; jae
// error` to discriminate cleanly (mirroring mount_pdxfs_block's own
// convention).
//
// -----------------------------------------------------------------------------
// Contract summary
// -----------------------------------------------------------------------------
//
// sys_mount_body(dev_path_ptr, dev_path_len, mount_point_ptr,
//                mount_point_len, backend_id) -> u64
//   Kernel-only entry point (no user pointers; caller has already
//   bounced any user paths into kernel scratches).  Called by the
//   shim below AND by witnesses that exercise the body directly.
//
// sys_mount_shim(dev_path_va, dev_path_len, mount_point_va,
//                mount_point_len, backend_id) -> u64
//   The dispatch entry (sysno 73 marshals here from dispatch.pdx).
//   Walks both user paths into kernel scratches via
//   user_read_bytes_via_walk, then invokes sys_mount_body with the
//   kernel-side pointers.  Returns the body's result verbatim, or
//   SYS_MOUNT_EFAULT on walker rejection.
//
// -----------------------------------------------------------------------------
// Static storage -- ec_confine_one discipline
// -----------------------------------------------------------------------------
//
// Both bounce scratches are private to this file; tools/build.sh's
// ec_confine_one gate (see design/tooling/plan.md, ec-check) should
// hold each to its owning .o after link:
//
//   ec_confine_one '_sys_mount_dev_scratch'  'core/syscall/sys_mount.o'
//   ec_confine_one '_sys_mount_mp_scratch'   'core/syscall/sys_mount.o'
//
// A follow-up wave that moves these into per-TCB slots (SMP-safe
// multi-caller mount) will remove the ec_confine_one lines in the
// same edit that introduces the TCB fields.

module SysMount = structure {

  // ==========================================================================
  // R53 band sentinels
  // ==========================================================================

  pub let SYS_MOUNT_EINVAL_BACKEND     : u64 = 0xFFFFED60
  pub let SYS_MOUNT_EINVAL_MP_LEN      : u64 = 0xFFFFED61
  pub let SYS_MOUNT_EINVAL_DEV_LEN     : u64 = 0xFFFFED62
  pub let SYS_MOUNT_UNIMPL_PDXFS_BLOCK : u64 = 0xFFFFED63
  pub let SYS_MOUNT_MOUNT_FAIL         : u64 = 0xFFFFED64
  pub let SYS_MOUNT_EFAULT             : u64 = 0xFFFFED65
  pub let SYS_MOUNT_ENODEV             : u64 = 0xFFFFED66
  pub let SYS_MOUNT_ENOMEM_CAP         : u64 = 0xFFFFED67

  // R107.M1 (#2345) dev_path parser constants.  See file header.
  //   SM_DEV_PATH_LEN = SM_DEV_PREFIX_LEN + 1 hex digit = 12.
  pub let SM_DEV_PREFIX_LEN : u64 = 11
  pub let SM_DEV_PATH_LEN   : u64 = 12
  pub let _sm_dev_prefix    : [u8; 11] = "/dev/pdxvol"

  // R107.M1 (#2345) cap-slot pool for block-arm KIND_VOLUME caps.
  // 8 slots one per MOUNT_MAX; distinct from the witness pool
  // [172..177) and MBOT_ROOT_VOLUME_CAP_SLOT (176).
  pub let SM_CAP_POOL_LO : u64 = 224
  pub let SM_CAP_POOL_HI : u64 = 232

  // User-facing backend_id values (task-pinned per §Scope):
  //   0 = tmpfs, 5 = pdxfs_block.
  // Translation to core/fs/mount.pdx's internal MOUNT_BACKEND_*
  // discriminants happens inside the body's dispatch switch: user 0
  // maps to MOUNT_BACKEND_TMPFS (1) which mount() accepts; user 5
  // maps to MOUNT_BACKEND_PDXFS_BLOCK (5) which routes to
  // mount_pdxfs_block instead of mount() (per mount_block.pdx §Scope).
  pub let SYS_MOUNT_BACKEND_TMPFS       : u64 = 0
  pub let SYS_MOUNT_BACKEND_PDXFS_BLOCK : u64 = 5

  // Path length cap (both dev_path and mount_point).  Matches
  // DISPATCH_PATH_MAX (dispatch.pdx L84) and _vfs_open_parent_scratch
  // (vfs_open.pdx L41) so a caller with a POSIX-legal PATH_MAX buffer
  // sees no length-shrink surprise.
  pub let SYS_MOUNT_PATH_MAX : u64 = 256

  // AUD_MOUNT emit payload layout (R53.M5-002 / #1755).  The audit_emit
  // wrapper's `slot` arg carries mount_slot verbatim; `payload_lo` (32
  // bits) is packed as:
  //
  //   bits [ 0..24)  path_hash_24  -- 24-bit djb2 fold of the mount_
  //                                    point path (placeholder for a
  //                                    real blake3(path) once paideia-
  //                                    as ships blake3_hash32; see
  //                                    §Sibling coordination for the
  //                                    Class-A blocker cross-ref).
  //   bits [24..28)  backend_id    -- 4 bits, values 0 (tmpfs) or 5
  //                                    (pdxfs_block) at this landing.
  //   bits [28..32)  op_disc       -- 4-bit discriminant (0 = mount,
  //                                    1 = umount-lazy, 2 = umount-
  //                                    immediate).  Redundant for
  //                                    telling mount from umount now
  //                                    that #1754 gave each its own
  //                                    evt ordinal (AUD_EV_MOUNT = 13,
  //                                    AUD_EV_UMOUNT = 14); still
  //                                    useful within AUD_EV_UMOUNT for
  //                                    the lazy-vs-immediate signal.
  //                                    Kept 4 bits wide in mount too so
  //                                    the payload layout is byte-
  //                                    identical between the two
  //                                    syscalls (one subscriber decoder
  //                                    table serves both).
  pub let SYS_MOUNT_OP_DISC_MOUNT : u64 = 0

  // Internal MOUNT_BACKEND_TMPFS value (mount.pdx L42).  Kept as a
  // literal here rather than a cross-module `pub let` reference per
  // this codebase's convention (see mkfs.pdx / superblock.pdx headers
  // on why cross-module `let` references have no proven precedent).
  pub let SYS_MOUNT_INTERNAL_TMPFS : u64 = 1

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall bounce scratches -- SYS_MOUNT_PATH_MAX (256) each.
  // Same KPTI-bounce discipline as dispatch.pdx's _dispatch_open_path_
  // scratch and sys_execve_shim.pdx's _execve_path_scratch.  Single-
  // flow at R53.M2 (no concurrent sys_mount callers); SMP-safe when
  // the follow-up TCB-slab landing moves these fields into a per-task
  // slot (see §Static storage note above).
  pub let mut _sys_mount_dev_scratch : [u8; 256] = uninit @align(8)
  pub let mut _sys_mount_mp_scratch  : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_mount_body(dev_path_ptr, dev_path_len, mount_point_ptr,
  //                mount_point_len, backend_id) -> u64
  //
  // SysV: rdi=dev_path_ptr, rsi=dev_path_len, rdx=mount_point_ptr,
  //       rcx=mount_point_len, r8=backend_id
  //   -> rax = mount_slot in [0..7] on success, else 0xFFFFED6* sentinel
  //
  // Sequence:
  //   (1) Bound-check dev_path_len in [1..256] -> SYS_MOUNT_EINVAL_DEV_LEN.
  //   (2) Bound-check mount_point_len in [1..256] -> SYS_MOUNT_EINVAL_MP_LEN.
  //   (3) Membership-check backend_id in {0, 5}
  //         -> SYS_MOUNT_EINVAL_BACKEND on any other value.
  //   (4) Backend dispatch:
  //         backend_id == 0 (tmpfs):  call
  //           mount(mount_point_ptr, MOUNT_BACKEND_TMPFS=1).
  //           mount() returns slot in [0..7] on success or 0xFFFF on
  //           failure; on success jump to (5) with rax = slot; on
  //           failure translate 0xFFFF to SYS_MOUNT_MOUNT_FAIL (so a
  //           caller's `cmp rax, 8; jae error` still branches
  //           correctly) and return via smb_done WITHOUT emitting
  //           any audit record.
  //         backend_id == 5 (pdxfs_block): R107.M1 (#2345) landed --
  //           (a) parse dev_path as "/dev/pdxvol<hex>" (12 bytes),
  //           row_id in [0..16), (b) volume_tail_valid + volume_row_
  //           device_slot (kind_volume.pdx / volume_registry.pdx) to
  //           lift the row_id to the KIND_BLKDEV cap, (c) linear-scan
  //           cap_table[224..232) for a free (kind==0) slot, (d) call
  //           mount_pdxfs_block(cap_slot, bdev_cap, 0, 0), (e) fold
  //           mount_pdxfs_block's error taxonomy into SYS_MOUNT_MOUNT_
  //           FAIL uniformly (any rax >= 8; the caller's `cmp rax, 8;
  //           jae error` discriminates cleanly the same way both
  //           backends' returns do), (f) success (rax < 8) jumps to
  //           step (5) with rax = mount_slot.  Devfs is the R107.M2
  //           landing per design/roadmap/persistent-home-wave.md §R107;
  //           the /dev/pdxvol<hex> shim is the syntactic bridge until
  //           it lands and swaps steps (a)-(b) for a proper devfs
  //           walker without disturbing (c)-(f).
  //   (5) smb_success: compose payload_lo per the §payload layout
  //         note above (path_hash_24 = 24-bit djb2 fold of the
  //         mount_point path; backend_id in [24..28); op_disc = 0
  //         in [28..32)), then audit_emit(kind=0, slot=mount_slot,
  //         evt=AUD_EV_MOUNT (=13; audit_schema.pdx #1754), at=0,
  //         result=0, payload_lo).  Return value discarded -- audit
  //         emission is best-effort and never gates the mount
  //         decision (matches every other audit_emit call site in
  //         this codebase per §5 of the audit schema module header).
  //         Restore mount_slot from rbx into rax and jmp smb_done.
  //
  // Register plan (5-push callee-save prologue lands rsp%16==0 for
  // the two nested calls, entry rsp%16==8 + 40 = 48, %16==0):
  //   rbx = dev_path_ptr       (dead after step 1; REUSED at step (5)
  //                             smb_success to preserve mount_slot
  //                             across the audit_emit call so a
  //                             caller sees the slot verbatim in rax)
  //   r12 = dev_path_len       (used only by step 1's bound check;
  //                             reserved slot for the future
  //                             backend=5 walker's length arg)
  //   r13 = mount_point_ptr    (survives to mount()'s rdi at step 4
  //                             AND to step 5's path_hash fold loop)
  //   r14 = mount_point_len    (upper bound for step 5's path_hash
  //                             fold loop; also reserved for a future
  //                             mount() variant taking an explicit
  //                             len)
  //   r15 = backend_id         (survives to step 4's dispatch AND to
  //                             step 5's payload composition)
  //
  // Alignment: 5 pushes (40 B) leave rsp%16==0 with no pad needed.
  // ==========================================================================
  pub let sys_mount_body : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (dev_path_ptr: u64) (dev_path_len: u64) (mount_point_ptr: u64)
       (mount_point_len: u64) (backend_id: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R53.M2-002 (#1737) + R53.M5-002 (#1755): sys_mount body -- ring-3 mount syscall (sysno 73), with post-success audit emission. 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for the two nested calls (mount + audit_emit), entry rsp%16==8 + 40 = 48, %16==0. Register plan: rbx=dev_path_ptr (dead after step 1, REUSED at smb_success to preserve mount_slot across audit_emit), r12=dev_path_len, r13=mount_point_ptr (survives to mount()'s rdi at step 4 AND to step 5's path_hash fold loop), r14=mount_point_len (upper bound of step 5's hash loop), r15=backend_id (survives to step 4's dispatch AND to step 5's payload composition). Body: (1) rsi==dev_path_len bound check [1..256] (staged via r10 for the upper bound imm since 256 fits imm32 fine but codebase's discipline stages every non-tiny imm through r10) -> SYS_MOUNT_EINVAL_DEV_LEN. (2) rcx==mount_point_len bound check [1..256] -> SYS_MOUNT_EINVAL_MP_LEN. (3) r8==backend_id membership {0, 5} -> SYS_MOUNT_EINVAL_BACKEND (two cmp/je's, fall-through is refuse). (4) Backend dispatch: cmp r15, 0; je smb_backend_tmpfs. cmp r15, 5; je smb_backend_pdxfs_block. Fallthrough here is unreachable (already gated at step 3); a defensive `mov rax, SYS_MOUNT_EINVAL_BACKEND; jmp smb_done` guards. smb_backend_tmpfs: mov rdi, r13 (mount_point_ptr); mov rsi, 1 (MOUNT_BACKEND_TMPFS); call mount. mount() returns slot in [0..7] on success, 0xFFFF on any failure. Translate 0xFFFF -> SYS_MOUNT_MOUNT_FAIL (0xFFFFED64) so a caller's `cmp rax, 8; jae error` branches correctly (0xFFFF sits at 65535, which >= 8 would satisfy jae but conflates 'refused' with any successful slot >= 8 in a future MOUNT_MAX bump; the ED-band translation removes the ambiguity by placing the sentinel far outside the [0..MOUNT_MAX) range for any conceivable MOUNT_MAX widening). cmp rax, 0xFFFF (staged via r10); jne smb_success (fall through to step 5); mov rax, SYS_MOUNT_MOUNT_FAIL; jmp smb_done. smb_backend_pdxfs_block: R107.M1 (#2345) landed body. (a) length gate r12 == SM_DEV_PATH_LEN (12) staged via r10; !=  -> SYS_MOUNT_ENODEV (0xFFFFED66). (b) prefix compare against _sm_dev_prefix (`/dev/pdxvol`) in an rcx-indexed byte loop with mov_b [rbx + rcx * 1] + mov_b [r10 + rcx * 1]; any mismatch -> ENODEV. (c) hex digit parse dev_path[11]: '0'..'9' -> subtract 0x30, 'a'..'f' -> subtract 0x57 (= 0x61 - 10), else ENODEV; row_id in [0..16) saved into rbx (dev_path_ptr dead). (d) volume_tail_valid(row_id): 0 -> ENODEV. (e) volume_row_device_slot(row_id) -> bdev_cap; VOL_DECODE_BAD (0xFFFFFFFFFFFFFFFF staged via r10 per bit-63-imm discipline) -> ENODEV; save bdev_cap into rbx. (f) linear scan cap_table[SM_CAP_POOL_LO..SM_CAP_POOL_HI) = [224..232) for kind == 0; the byte-offset compute avoids the 2-operand imul encoder pitfall (r9 = slot*8 via shl 3; r11 = slot*16 via shl 4; add r9, r11 = slot*24). Pool exhaustion -> SYS_MOUNT_ENOMEM_CAP (0xFFFFED67). (g) mount_pdxfs_block(cap_slot=rcx, bdev_cap=rbx, uuid_hint_lo=0, uuid_hint_hi=0): sequence `mov rdi, rcx` BEFORE `xor rcx, rcx` so the slot survives into rdi while rcx is repurposed as the uuid_hint_hi arg (both are u64 aliases -- rcx is the 4th SysV arg reg). (h) rax < 8 (staged via r10 -- MOUNT_MAX = 8, every failure sentinel is >= 0xFFFF): jmp smb_success (audit_emit + return mount_slot). rax >= 8: fold to SYS_MOUNT_MOUNT_FAIL uniformly so ring-3 sees the same taxonomy on both backends (matches the tmpfs arm's 0xFFFF -> SYS_MOUNT_MOUNT_FAIL translation at step 4; a caller's `cmp rax, 8; jae error` semantics stay identical). Register safety in this arm: r13/r14/r15 (mount_point_ptr / _len / backend_id -- outer register plan) are SysV callee-save and survive volume_tail_valid + volume_row_device_slot + mount_pdxfs_block naturally, so they remain LIVE for smb_success's path_hash fold + payload composition; rbx is also callee-save but is deliberately reused inside this arm (row_id -> bdev_cap) since smb_success's own `mov rbx, rax` overwrite discards whatever it held on arrival. Devfs is not landed at R107.M1 (M2 landing per design/roadmap/persistent-home-wave.md §R107); the /dev/pdxvol<hex> shim above is the syntactic bridge, and the M2 devfs landing swaps steps (a)-(e) for a proper devfs walker (tmpfs_lookup chain through the /dev subtree extracting KIND_BLKDEV from the inode's owner_cap slot) with steps (f)-(h) unchanged. The cap-slot linear scan is replaced by slab_alloc (cap/slab.pdx) when that goes live; the pool [224..232) becomes free at that point. (5) smb_success: preserve mount_slot (rax) in rbx. Compute path_hash_24 = 24-bit djb2 fold of the mount_point path (r13/r14): rax init 5381; loop i in [0..r14): rax = ((rax << 5) + rax) ^ path[i], then and rax, 0xFFFFFF. djb2 is chosen because it needs only shift+add (no imul; paideia-as's encoder shipped imul very late and we prefer instruction-count stability); the 24-bit truncation matches the payload_lo slot allocated at the file's §payload layout note. This is a NON-CRYPTOGRAPHIC placeholder for blake3(path) -- paideia-as has no blake3_hash32 kernel-callable primitive (see core/fs/pdxfs/sig_verify.pdx §sig_hash_verify_stub for the same class of gap; RELEASE-NOTES-v0.20.md lists BLAKE3-in-.pdx as a deferred Class-A blocker; #1725's fail-closed stub pattern applies). When blake3_hash32 lands, the loop is replaced by a single call with the 24-bit truncation preserved. Compose payload_lo = (op_disc << 28) | (backend_id << 24) | path_hash_24 with op_disc = 0 (SYS_MOUNT_OP_DISC_MOUNT; redundant for mount given AUD_EV_MOUNT already distinguishes mount from umount, kept as a 0-valued nibble so the layout stays byte-identical to sys_umount.pdx's own emit -- one subscriber decoder table serves both). Call audit_emit(kind=0, slot=mount_slot=rbx, evt=AUD_EV_MOUNT=13 (audit_schema.pdx #1754), at=0, result=0, payload_lo=r9). Return value discarded -- audit is best-effort and never gates the mount decision (matches every other audit_emit call site per audit_schema.pdx §5). Restore mov rax, rbx (mount_slot) before jmp smb_done so the caller's rax return is the slot verbatim. smb_done: 5-pop epilogue + ret. Effects {mem, sysreg} conservatively cover audit_emit's own posture (which reads _current_tcb transitively through drv_audit_emit) + mount()'s own {mem}. Capabilities {cap} matches mount_pdxfs_block's forward posture (kept even in the M2 stub landing so a witness compiling against sys_mount_body sees the final effects signature and does not need to be re-annotated when the backend=5 arm goes real). Labels prefixed smb_ -- grep audit 2026-08-23: no `smb_` collisions elsewhere in src/kernel/. No test instruction anywhere. mov_b used ONLY for the per-byte path_hash load (`xor rcx,rcx; mov_b rcx, [r13 + r10 * 1]` -- explicit zero-extension per the checksum.pdx precedent, mov_b does not zero-extend on its own).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // dev_path_ptr
        mov r12, rsi;                    // dev_path_len
        mov r13, rdx;                    // mount_point_ptr
        mov r14, rcx;                    // mount_point_len
        mov r15, r8;                     // backend_id

        // ---- (1) dev_path_len in [1..256] ----
        cmp r12, 0;
        je  smb_bad_dev_len;
        mov r10, 256;                    // SYS_MOUNT_PATH_MAX
        cmp r12, r10;
        ja  smb_bad_dev_len;

        // ---- (2) mount_point_len in [1..256] ----
        cmp r14, 0;
        je  smb_bad_mp_len;
        mov r10, 256;
        cmp r14, r10;
        ja  smb_bad_mp_len;

        // ---- (3) backend_id in {0, 5} ----
        cmp r15, 0;
        je  smb_arg_ok;
        cmp r15, 5;
        je  smb_arg_ok;
        jmp smb_bad_backend;

      smb_arg_ok:
        // ---- (4) Backend dispatch ----
        // R53.M5-002 (#1755): audit emit moved OUT of the pre-dispatch
        // arg-gates block to smb_success below, so a refused mount()
        // records nothing (matches audit_schema.pdx §5's every-call-
        // site convention).  The prior STUB_MOUNT_PAYLOAD_MARKER emit
        // is deleted.
        cmp r15, 0;
        je  smb_backend_tmpfs;
        cmp r15, 5;
        je  smb_backend_pdxfs_block;
        // Unreachable (gated at step 3); defensive guard.
        mov rax, 0xFFFFED60;             // SYS_MOUNT_EINVAL_BACKEND
        jmp smb_done;

      smb_backend_tmpfs:
        // Forward to core/fs/mount.pdx's mount() with backend_type=1.
        mov rdi, r13;                    // path_ptr = mount_point_ptr
        mov rsi, 1;                      // MOUNT_BACKEND_TMPFS
        call mount;                      // rax = slot [0..7] or 0xFFFF
        mov r10, 0xFFFF;
        cmp rax, r10;
        jne smb_success;                 // rax = slot -> audit emit + return
        mov rax, 0xFFFFED64;             // SYS_MOUNT_MOUNT_FAIL
        jmp smb_done;

      smb_backend_pdxfs_block:
        // R107.M1 (#2345): real body.  Replaces the R53.M2 stub per
        // §Scaffolding posture (e).  Sequence:
        //   (a) length gate: dev_path_len (r12) == SM_DEV_PATH_LEN (12).
        //   (b) prefix compare: dev_path[0..11] == "/dev/pdxvol".
        //   (c) hex-digit parse: dev_path[11] -> row_id 0..15.
        //   (d) volume_tail_valid(row_id): 0 -> SYS_MOUNT_ENODEV.
        //   (e) volume_row_device_slot(row_id) -> bdev_cap or
        //       VOL_DECODE_BAD -> SYS_MOUNT_ENODEV.
        //   (f) linear scan cap_table[SM_CAP_POOL_LO..SM_CAP_POOL_HI)
        //       for a slot with kind==0; exhausted -> SYS_MOUNT_ENOMEM_CAP.
        //   (g) mount_pdxfs_block(cap_slot, bdev_cap, 0, 0).
        //   (h) rax < 8 -> mount_slot, jmp smb_success (audit emit).
        //       rax >= 8 -> SYS_MOUNT_MOUNT_FAIL (forwarded uniformly
        //       rather than exposing the mount_pdxfs_block internal
        //       taxonomy through ring-3 -- matches the tmpfs arm's
        //       0xFFFF -> SYS_MOUNT_MOUNT_FAIL translation at step 4
        //       so a caller's `cmp rax, 8; jae error` semantics stay
        //       identical across both backends).
        //
        // Register usage inside this arm:
        //   rbx = dev_path_ptr (input) -> row_id after parse ->
        //         bdev_cap after step (e) -> dead at step (g)+ (both
        //         mount_pdxfs_block arg-marshal and smb_success entry
        //         overwrite it).  rbx is callee-save under SysV so it
        //         survives volume_tail_valid + volume_row_device_slot.
        //   r13, r14, r15 = mount_point_ptr, mount_point_len,
        //         backend_id (outer register plan).  Callee-save, so
        //         they naturally survive every nested call in this arm
        //         and remain LIVE for smb_success's path_hash fold +
        //         payload composition.
        //   rcx, r9, r10, r11 = scratch (all SysV caller-save; each
        //         reload before use).

        // ---- (a) length gate ----
        mov r10, 12;                     // SM_DEV_PATH_LEN
        cmp r12, r10;
        jne smb_pb_enodev;

        // ---- (b) prefix compare against "/dev/pdxvol" ----
        lea r10, [rip + _sm_dev_prefix];
        xor rcx, rcx;                    // i = 0
      smb_pb_pfx_loop:
        mov r9, 11;                      // SM_DEV_PREFIX_LEN
        cmp rcx, r9;
        jae smb_pb_pfx_ok;
        xor r11, r11;
        mov_b r11, [rbx + rcx * 1];      // dev_path[i]
        xor r9, r9;
        mov_b r9, [r10 + rcx * 1];       // prefix[i]
        cmp r11, r9;
        jne smb_pb_enodev;
        add rcx, 1;
        jmp smb_pb_pfx_loop;
      smb_pb_pfx_ok:

        // ---- (c) hex-digit parse dev_path[11] -> row_id ----
        xor rax, rax;
        mov_b rax, [rbx + 11];
        // '0'..'9' -> rax - 0x30
        mov r10, 0x30;
        cmp rax, r10;
        jb smb_pb_enodev;
        mov r10, 0x39;
        cmp rax, r10;
        ja smb_pb_maybe_hex;
        mov r10, 0x30;
        sub rax, r10;
        jmp smb_pb_row_ok;
      smb_pb_maybe_hex:
        // 'a'..'f' -> rax - 0x57 (= 0x61 - 10)
        mov r10, 0x61;
        cmp rax, r10;
        jb smb_pb_enodev;
        mov r10, 0x66;
        cmp rax, r10;
        ja smb_pb_enodev;
        mov r10, 0x57;
        sub rax, r10;
      smb_pb_row_ok:
        // rax = row_id in [0..16).  Repurpose rbx (dev_path_ptr dead).
        mov rbx, rax;                    // rbx = row_id

        // ---- (d) volume_tail_valid(row_id) ----
        mov rdi, rbx;
        call volume_tail_valid;          // rax = 1 iff live
        cmp rax, 0;
        je  smb_pb_enodev;

        // ---- (e) volume_row_device_slot(row_id) -> bdev_cap ----
        mov rdi, rbx;
        call volume_row_device_slot;     // rax = bdev_cap or VOL_DECODE_BAD
        mov r10, 0xFFFFFFFFFFFFFFFF;     // VOL_DECODE_BAD (bit-63 imm)
        cmp rax, r10;
        je  smb_pb_enodev;
        mov rbx, rax;                    // rbx = bdev_cap (row_id dead)

        // ---- (f) allocate a free cap slot in [SM_CAP_POOL_LO..HI) ----
        // Linear scan cap_table[slot]; free iff kind field (+0) == 0.
        // Descriptor stride is 24 bytes (cap/table.pdx CAP_DESC_BYTES);
        // compute slot*24 as slot*8 + slot*16 to stay off the 2-operand
        // imul encoder pitfall.
        lea r10, [rip + cap_table];      // base
        mov rcx, 224;                    // SM_CAP_POOL_LO
      smb_pb_alloc_loop:
        mov r9, 232;                     // SM_CAP_POOL_HI
        cmp rcx, r9;
        jae smb_pb_enomem;
        mov r9, rcx;
        shl r9, 3;                       // slot*8
        mov r11, rcx;
        shl r11, 4;                      // slot*16
        add r9, r11;                     // slot*24
        mov r11, [r10 + r9];             // kind at +0
        cmp r11, 0;
        je  smb_pb_alloc_ok;
        add rcx, 1;
        jmp smb_pb_alloc_loop;
      smb_pb_alloc_ok:
        // rcx = free cap slot; rbx = bdev_cap.

        // ---- (g) mount_pdxfs_block(cap_slot, bdev_cap, 0, 0) ----
        // Sequence the register moves so `mov rdi, rcx` runs BEFORE
        // `xor rcx, rcx` overwrites rcx as the uuid_hint_hi arg.
        mov rdi, rcx;                    // cap_slot
        mov rsi, rbx;                    // bdev_cap
        xor rdx, rdx;                    // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                    // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;          // rax = mount_slot or error

        // ---- (h) discriminate mount_slot ([0..8)) vs error (>= 8) ----
        // Per mount_block.pdx: mount_slot ids are 0..7 (MOUNT_MAX=8);
        // every failure sentinel is >= 0xFFFF (0xFFFF, 0xFFFFED22,
        // 0xFFFFED26, sb_/vol_/jnl_ codes in 0xFFFFED00..3F band).  Fold
        // all into SYS_MOUNT_MOUNT_FAIL uniformly so ring-3 sees the
        // same taxonomy on both backends.
        mov r10, 8;
        cmp rax, r10;
        jae smb_pb_mount_fail;
        jmp smb_success;                 // rax = mount_slot -> audit emit

      smb_pb_mount_fail:
        mov rax, 0xFFFFED64;             // SYS_MOUNT_MOUNT_FAIL
        jmp smb_done;

      smb_pb_enodev:
        mov rax, 0xFFFFED66;             // SYS_MOUNT_ENODEV
        jmp smb_done;

      smb_pb_enomem:
        mov rax, 0xFFFFED67;             // SYS_MOUNT_ENOMEM_CAP
        jmp smb_done;

      smb_success:
        // ---- (5) AUD_MOUNT emit (R53.M5-002 / #1755) ----
        // rax = mount_slot [0..7].  Preserve in rbx (dead post-step-1)
        // across the audit_emit call so the caller sees the slot
        // verbatim in rax on return.
        mov rbx, rax;                    // save mount_slot

        // -- path_hash_24: 24-bit djb2 fold of the mount_point path --
        // rax init 5381; for i in [0..r14): rax = ((rax<<5)+rax) ^ path[i];
        // mask to 24 bits per iteration to keep the accumulator in the
        // payload_lo bit-slice regardless of loop length.  NON-CRYPTO
        // placeholder for blake3(path) -- see §Sibling coordination.
        mov rax, 5381;                   // djb2 seed
        xor r10, r10;                    // i = 0
      smb_hash_loop:
        cmp r10, r14;                    // i < mount_point_len ?
        jae smb_hash_done;
        mov rcx, rax;
        shl rcx, 5;
        add rax, rcx;                    // rax *= 33
        xor rcx, rcx;                    // zero-extend for mov_b
        mov_b rcx, [r13 + r10 * 1];      // load mount_point[i]
        xor rax, rcx;                    // rax ^= byte
        mov rcx, 0xFFFFFF;
        and rax, rcx;                    // mask to 24 bits
        add r10, 1;
        jmp smb_hash_loop;

      smb_hash_done:
        // -- compose payload_lo = (op_disc<<28) | (backend<<24) | hash --
        // op_disc = 0 (SYS_MOUNT_OP_DISC_MOUNT).  Redundant given the
        // AUD_EV_MOUNT evt ordinal (#1754) already distinguishes mount
        // from umount, but the nibble is kept 0 so the payload layout
        // stays byte-identical to sys_umount.pdx's own emit -- one
        // subscriber decoder table serves both.
        mov r9, rax;                     // payload_lo = path_hash_24
        mov r10, r15;                    // backend_id
        and r10, 0xF;
        shl r10, 24;
        or  r9, r10;                     // payload_lo |= backend<<24
        // op_disc = 0 -- no OR needed (bits [28..32) already zero).

        // -- audit_emit(kind=0, slot=mount_slot, evt=AUD_EV_MOUNT, --
        //               at=0, result=0, payload_lo).  rax discarded.
        xor rdi, rdi;                    // kind = 0
        mov rsi, rbx;                    // slot = mount_slot
        mov rdx, 13;                     // evt = AUD_EV_MOUNT (audit_schema.pdx #1754)
        xor rcx, rcx;                    // at = 0
        xor r8,  r8;                     // result = 0
        // r9 already holds payload_lo.
        call audit_emit;                 // rax discarded

        // Restore mount_slot into rax for the caller's return.
        mov rax, rbx;
        jmp smb_done;

      smb_bad_dev_len:
        mov rax, 0xFFFFED62;             // SYS_MOUNT_EINVAL_DEV_LEN
        jmp smb_done;

      smb_bad_mp_len:
        mov rax, 0xFFFFED61;             // SYS_MOUNT_EINVAL_MP_LEN
        jmp smb_done;

      smb_bad_backend:
        mov rax, 0xFFFFED60;             // SYS_MOUNT_EINVAL_BACKEND

      smb_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sys_mount_shim(dev_path_va, dev_path_len, mount_point_va,
  //                mount_point_len, backend_id) -> u64
  //
  // Dispatch entry (sysno 73 marshals args here from
  // core/syscall/dispatch.pdx via sibling R53.M2-001 / #1736).
  //
  // SysV:  rdi=dev_path_va, rsi=dev_path_len, rdx=mount_point_va,
  //        rcx=mount_point_len, r8=backend_id
  //     -> rax = sys_mount_body's return, or SYS_MOUNT_EFAULT on
  //        walker rejection of either user path.
  //
  // Bounces both user path buffers into the .bss scratches via
  // user_read_bytes_via_walk (per-byte KPTI-safe walk through
  // _current_tcb's user_pml4_va), then calls sys_mount_body with
  // the kernel-side pointers.  Length pre-gating (0 < len <= 256)
  // is done HERE too, before walker calls, so a caller passing
  // len=100000 gets SYS_MOUNT_EINVAL_*_LEN instead of a walker
  // over-read attempt.  (The body's own gates re-check for defense
  // in depth and for kernel-witness callers that bypass the shim.)
  //
  // Register plan (5-push callee-save prologue + one pad-only sub
  // rsp,8 for the nested calls, mirroring sys_execve_shim's
  // discipline):
  //   rbx = dev_path_va          (arg0 to first walker call)
  //   r12 = dev_path_len         (arg2 to first walker call)
  //   r13 = mount_point_va       (arg0 to second walker call)
  //   r14 = mount_point_len      (arg2 to second walker call;
  //                               also body's rcx arg)
  //   r15 = backend_id           (body's r8 arg)
  //
  // Alignment: entry rsp%16==8, 5 pushes -> %16==0, `sub rsp, 8`
  // pad brings %16==8 which is what SysV requires at a nested call
  // site (callee's own retaddr push takes it to %16==0).
  // ==========================================================================
  pub let sys_mount_shim : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (dev_path_va: u64) (dev_path_len: u64) (mount_point_va: u64)
       (mount_point_len: u64) (backend_id: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R53.M2-002 (#1737): sys_mount dispatch shim -- unmarshal SysV arg registers from sysno-73 dispatch (via sibling #1736), bounce both user path buffers via user_read_bytes_via_walk into two .bss scratches (KPTI-safe -- strict-KPTI has flipped CR3 to _kernel_pml4_pa by the time we run, so any raw ring-3 VA is unresolvable under kernel CR3; same defect class as #724 D4 / #730 D10c/d / #737, symmetric fix to dispatch.pdx's dispatch_open/read/write/dmesg patterns), then invoke sys_mount_body with kernel-side pointers. 5-push callee-save prologue (rbx=dev_path_va, r12=dev_path_len, r13=mount_point_va, r14=mount_point_len, r15=backend_id) plus `sub rsp, 8` pad lands rsp%16==8 at the nested call site (SysV: entry %16==8, 5 pushes -> %16==0, sub rsp,8 -> %16==8 which becomes %16==0 after the callee's own retaddr push). Body: (1) Length pre-gate in [1..256] for both dev_path_len and mount_point_len; either 0 or > 256 -> SYS_MOUNT_EINVAL_DEV_LEN / _MP_LEN respectively. Done BEFORE any walker call so a caller passing len=100000 gets a specific errno instead of a walker over-read attempt. The body's own gates re-check for defense in depth and for kernel-witness callers that bypass this shim. (2) user_read_bytes_via_walk(kernel_dst=&_sys_mount_dev_scratch, user_va=rbx, len=r12) -> rax = 0 (OK) or 0xFFFFFFFFFFFFFFF2 (-EFAULT). On non-zero -> SYS_MOUNT_EFAULT (0xFFFFED65). (3) user_read_bytes_via_walk(kernel_dst=&_sys_mount_mp_scratch, user_va=r13, len=r14) -- same shape. (4) Call sys_mount_body with (dev_kernel_ptr=&scratch, dev_len=r12, mp_kernel_ptr=&scratch, mp_len=r14, backend_id=r15). Return its result verbatim. Effects {mem, sysreg} @{cap} match the body's own posture (widened even for the shim so the two functions have identical effect signatures -- simplifies witness authoring). No test instruction; no mov_b (walker owns byte-granularity access). Labels prefixed sms_ -- grep audit 2026-08-23: no `sms_` collisions elsewhere in src/kernel/.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                      // align rsp%16==8 for nested SysV call

        mov rbx, rdi;                    // dev_path_va
        mov r12, rsi;                    // dev_path_len
        mov r13, rdx;                    // mount_point_va
        mov r14, rcx;                    // mount_point_len
        mov r15, r8;                     // backend_id

        // ---- (1) Length pre-gate ----
        cmp r12, 0;
        je  sms_bad_dev_len;
        mov r10, 256;                    // SYS_MOUNT_PATH_MAX
        cmp r12, r10;
        ja  sms_bad_dev_len;
        cmp r14, 0;
        je  sms_bad_mp_len;
        mov r10, 256;
        cmp r14, r10;
        ja  sms_bad_mp_len;

        // ---- (2) Bounce dev_path via user_read_bytes_via_walk ----
        lea rdi, [rip + _sys_mount_dev_scratch];
        mov rsi, rbx;                    // user_va = dev_path_va
        mov rdx, r12;                    // len
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sms_efault;

        // ---- (3) Bounce mount_point via user_read_bytes_via_walk ----
        lea rdi, [rip + _sys_mount_mp_scratch];
        mov rsi, r13;                    // user_va = mount_point_va
        mov rdx, r14;                    // len
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sms_efault;

        // ---- (4) sys_mount_body(dev_kernel, dev_len, mp_kernel, mp_len, backend) ----
        lea rdi, [rip + _sys_mount_dev_scratch];
        mov rsi, r12;
        lea rdx, [rip + _sys_mount_mp_scratch];
        mov rcx, r14;
        mov r8,  r15;
        call sys_mount_body;
        jmp sms_done;

      sms_bad_dev_len:
        mov rax, 0xFFFFED62;             // SYS_MOUNT_EINVAL_DEV_LEN
        jmp sms_done;

      sms_bad_mp_len:
        mov rax, 0xFFFFED61;             // SYS_MOUNT_EINVAL_MP_LEN
        jmp sms_done;

      sms_efault:
        mov rax, 0xFFFFED65;             // SYS_MOUNT_EFAULT

      sms_done:
        add rsp, 8;                      // undo pad
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
