// src/kernel/core/syscall/dispatch.pdx — R17-M0-668 (#668) SC+ freeze alignment — wire kernel dispatch to real bodies
// R17-M0-671 (#671): sysno 59 (execve) rewired from ENOSYS stub to sys_execve_shim.
// R17-M0-724-D2 (#724): sysno 60 (exit) — replace klog_panic hlt loop with real
//   task-termination path: sys_exit_body → runq_dequeue(current) →
//   sched_pick_next_r15 → sched_switch_r15(next). Never returns to the exiting
//   task's kernel syscall frame; the fallthrough dispatch_exit_halt is now a
//   defensive-only witness for "sched_switch_r15 returned to a ZOMBIE" — which
//   is unreachable in normal ops because the ZOMBIE has been runq_dequeue'd.
// Linear cmp/je chain over 13 syscall IDs per R13 preflight §C, extended with R16-M3 handler bodies.
// R17.M0 alignment (#668):
//   0 (read): load _current_tcb, call sys_read_body
//   1 (write): fd 1,2 → UART fast-path; fd >= 3 → sys_write_body
//   2 (open): load _current_tcb, call sys_open_body
//   3 (close): load _current_tcb, call sys_close_body
//   4 (cap_invoke): tail-call cap_invoke after arg shuffle [UNCHANGED]
//   12 (debug_puts): call uart_puts, echo msg_len [UNCHANGED]
//   32 (dup2): load _current_tcb, call sys_dup2_body
//   39 (getpid): inline from _current_tcb @ TASK_OFF_PID (0)
//   56 (fork): load _current_tcb, call sys_fork_body
//   59 (execve): load _current_tcb, call sys_execve_shim (path→image copy-in; #671)
//   60 (exit): sys_exit_body → runq_dequeue → pick_next → switch_r15 (never returns) [#724 D2]
//   61 (wait4): load _current_tcb, call sys_wait_body; on rax==0 (would-block signal)
//               call sched_block, then read wait_result_{pid,status} from parent slab
//               (@1704, @1708); writeback wstatus. [#724 D5a]
// All others return ENOSYS (-38 as u64 = 0xFFFFFFFFFFFFFFDA).
// [unsafe] — dispatches to sysreg/mem-effecting handlers.
// Audit: design/kernel/r17-m0-668-syscall-dispatch-align.md
// Audit: design/kernel/r17-m0-671-sys-execve-shim.md
// Audit: design/kernel/r17-m0-724-d2-sys-exit-terminate.md
// Audit: design/kernel/r17-m0-724-d5-sys-wait-block.md

module Dispatch = structure {
  // ==========================================================================
  // R16-M3-KPTI-sweep (#733 #734 #738 #739): per-syscall bounce scratches
  //
  // The sys_open/sys_read/sys_write dispatch paths receive user VA pointers
  // (path / buf) from ring-3 via SysV registers. Under strict-KPTI the
  // syscall_entry trampoline has flipped CR3 to _kernel_pml4_pa (= boot PML4,
  // 0..4 GiB low identity map only), so any downstream kernel read/write via
  // that raw user VA lands on whichever kernel byte the boot PML4 covers PA
  // = user_va with — NOT the user-PML4-mapped frame. Same defect class as
  // #724 D4 / #730 D10c / #730 D10d / #737 (already fixed at their own sites).
  //
  // Fix approach (Option B — dispatch-layer once):
  //   Route the user VA copy through a bounce buffer here, before/after the
  //   respective sys_*_body call. The bodies keep their existing "kernel VA"
  //   contracts unchanged — sys_open_witness, sys_read_witness, and
  //   sys_write_witness (kernel_main.pdx L4054+/L4227+/L4335+) all pass
  //   kernel-VA pointers directly, so touching the body would regress them.
  //   The dispatch layer is the natural user↔kernel boundary — same layer
  //   #737 fixed dispatch_wait4 at.
  //
  // Concurrency: at R17.M0 the only user tasks are init + child_hello;
  // neither calls sys_read or fd>=3 sys_write, and only init calls sys_open
  // (once, for /dev/tty0). No two tasks concurrently touch any of these
  // scratches, so the static (rather than per-task) allocation is race-free
  // for this landing. Future work (multi-task sys_read on tty stdin): move
  // the scratches into the TCB slab or use kernel-stack sub rsp allocation.
  //
  // Sizing:
  //   _dispatch_open_path_scratch   : PATH_MAX == 256, aligned with
  //                                   _vfs_open_parent_scratch (vfs_open.pdx)
  //                                   and _execve_path_scratch (sys_execve_shim.pdx)
  //   _dispatch_read_buf_scratch    : 4096 = tmpfs single-page cap
  //                                   (tmpfs/read.pdx §4.7 cross-page reject)
  //   _dispatch_write_buf_scratch   : 4096 = tmpfs single-page cap
  //                                   (tmpfs/write.pdx §4.5 cross-page reject)
  //
  // Design: design/kernel/r16-m3-kpti-sweep-733-734-738-739.md
  // ==========================================================================
  pub let DISPATCH_PATH_MAX  : u64 = 256
  pub let DISPATCH_IO_MAX    : u64 = 4096
  pub let mut _dispatch_open_path_scratch  : [u8; 256]  = uninit @align(8)
  pub let mut _dispatch_read_buf_scratch   : [u8; 4096] = uninit @align(8)
  pub let mut _dispatch_write_buf_scratch  : [u8; 4096] = uninit @align(8)

  // logging-m9-002 (#709): sys_dmesg scratch. Symmetric to the read/write
  // scratches above — dispatch_dmesg copies ring bytes into this kernel
  // buffer via klog_ring_read_tail, then walks them out to the user's buf
  // via user_write_bytes_via_walk. Size matches DISPATCH_IO_MAX so a
  // single sys_dmesg call sees up to a page worth of ring; a caller
  // requesting more issues subsequent calls (POSIX short-read semantics).
  // Same "single reader at R18" concurrency note as the other scratches:
  // future SMP dmesg readers park in a TCB-side scratch (see kernel-
  // logging-substrate.md §14 Q3 per-CPU rings deferral).
  pub let mut _dispatch_dmesg_buf_scratch  : [u8; 4096] = uninit @align(8)

  // syscall_dispatch(rdi=sysno, rsi=a0, rdx=a1, rcx=a2, r8=a3) -> u64 in rax.
  // Widened !{mem, sysreg} @{cap, sched}: reachable handlers touch cap/sched/uart paths.
  pub let syscall_dispatch : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (sysno: u64) (a0: u64) (a1: u64) (a2: u64) (a3: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R17-M0-668 (#668) + R17-M0-671 (#671) + R17-M0-724-D2/D5a (#724): SC+ freeze alignment — wire kernel dispatch to real bodies. Linear cmp/je over IDs per R13 preflight §C. IDs {0,2,3,32,39,56,60,61} wired to sys_*_body handlers or inline dispatch. ID 1 (write) uses fast-path for fd∈{1,2}→UART, else sys_write_body. ID 59 (execve) now dispatches to sys_execve_shim (path→image copy-in per #671) which does user_ptr_ok/copy path/vfs_open/page-loop vfs_read/ELF magic/vfs_close, then calls sys_execve_body. ID 60 (exit) now performs real termination (#724 D2): sys_exit_body (marks ZOMBIE, wakes parent, runq_enqueue's woken parent per D5b) → runq_dequeue(current) → sched_pick_next_r15 → sched_switch_r15(next); never returns to the exiting task. ID 61 (wait4) now performs real blocking (#724 D5a): sys_wait_body returns rax=0 when children exist but none are zombies; dispatcher branches to a sched_block invocation, and on resume reads wait_result_{pid,status} from _current_tcb slab (@1704, @1708). ID 4 (cap_invoke) and ID 12 (debug_puts) unchanged. Effects widened to (mem, sysreg) and capabilities to (cap, sched) to cover the union of reachable handlers (sched_block requires @{sched}).",
      block: {
        // Bounds check
        cmp rdi, 61;
        ja dispatch_enosys;

        cmp rdi, 0;
        je dispatch_read;
        cmp rdi, 1;
        je dispatch_write;
        cmp rdi, 2;
        je dispatch_open;
        cmp rdi, 3;
        je dispatch_close;
        cmp rdi, 4;
        je dispatch_cap_invoke;
        cmp rdi, 12;
        je dispatch_debug_puts;
        // logging-m9-002 (#709): sysno 13 = SYS_DMESG. Kept low so the
        // existing `cmp rdi, 61` bounds check + tools/verify-syscall-
        // dispatch.sh's TOTAL_CHECKS=15 fingerprint stay untouched.
        cmp rdi, 13;
        je dispatch_dmesg;
        // R20b.M3-001 (#1558): sysno 40 = SYS_IPC_RECV. Blocking receive on
        // an IPC endpoint per design/ipc/userspace-server-substrate.md §5.1.
        // Bounds check `cmp rdi, 61` already accepts 40 (40 < 61); no need
        // to widen. Placed between sysno 13 and sysno 32 to preserve the
        // ascending-sysno order the switch-chain follows.
        cmp rdi, 40;
        je dispatch_ipc_recv;
        // R20b.M3-002 (#1559): sysno 41 = SYS_IPC_REPLY, sysno 42 = SYS_IPC_SEND.
        // Placed contiguously with sysno 40 for logical grouping (all three
        // IPC syscalls share the (id, hdr_va, payload_va, len) SysV shape
        // and the identical user_ptr_ok gate pair). Reply's body is a bit-7
        // pre-check + tail into send's body; both live under the same
        // bounds check (41, 42 < 61).
        cmp rdi, 41;
        je dispatch_ipc_reply;
        cmp rdi, 42;
        je dispatch_ipc_send;
        cmp rdi, 32;
        je dispatch_dup2;
        cmp rdi, 39;
        je dispatch_getpid;
        cmp rdi, 56;
        je dispatch_fork;
        cmp rdi, 59;
        je dispatch_execve;
        cmp rdi, 60;
        je dispatch_exit;
        cmp rdi, 61;
        je dispatch_wait4;
        jmp dispatch_enosys;

        // R16-M3-KPTI-sweep (#738 #739): route the sys_read path via a
        // per-syscall bounce buffer so that BOTH tmpfs_read (§4.10 rep_movsb
        // dst = user VA under kernel CR3, #738) and tty_read_try (§copy loop
        // mov_b [r9+0], rax to user VA under kernel CR3, #739) transitively
        // land bytes into a kernel scratch first. The bounce buffer's user
        // copy back happens post sys_read_body via user_write_bytes_via_walk.
        //
        // Prior code passed rdx (raw user buf VA) straight through to
        // sys_read_body → vfs_read → {tmpfs_read | tty_read → tty_read_try}
        // whose byte-stores at dst = user_va executed under kernel CR3. Both
        // sites are latent today (no user program calls sys_read at R17.M0)
        // but would silently corrupt the moment the shell grows an fd-based
        // read call. Same defect class as #724 D4 / #730 D10c / #730 D10d /
        // #737, symmetric to #734 write path.
        //
        // Fix at dispatch (Option B): sys_read_body / vfs_read / tmpfs_read
        // / tty_read_try keep their existing "buf is kernel VA" contracts
        // unchanged (sys_read_witness at kernel_main.pdx:4278 exercises
        // sys_read_body with a KERNEL VA buf, tty_vops_witness at :5589
        // exercises tty_read with a KERNEL VA stack buf — both would break
        // if the bodies started walking user PML4s). This layer bridges.
        //
        // Length cap: DISPATCH_IO_MAX = 4096, matching tmpfs single-page
        // read ceiling and the write path's cap. Short-read semantics are
        // POSIX-legal; sys_read_body's fd-offset-advance uses the returned
        // bytes_read directly so the fd_table offset is correct even if the
        // user requested more.
        //
        // Error taxonomy: sys_read_body returns bytes_read in [0, len] on
        // success (0 = EOF), 0xFFFFFFFFFFFFFFF7 (-EBADF) on invalid fd,
        // 0xFFFFFFFFFFFFFFFB (-EIO) on vfs_read sentinel. We copy back only
        // on rax in [1, DISPATCH_IO_MAX]; rax == 0 means EOF (nothing to
        // copy) and rax > DISPATCH_IO_MAX means an errno (pass through).
        // On walker failure during writeback → -EFAULT.
        //
        // Alignment: entry rsp%16==8. Push r15 (save user buf VA) + push r14
        // (save capped len) = 16 bytes → rsp%16==8. Add `sub rsp, 8` for
        // the sys_read_body call to align.
        dispatch_read:
        push r15;                             // save user buf VA (across body + walk)
        push r14;                             // save capped len (across body + walk)

        // Cap len at DISPATCH_IO_MAX.
        mov rax, 4096;
        cmp rcx, rax;
        jbe dispatch_read_len_ok;
        mov rcx, rax;
      dispatch_read_len_ok:

        mov r15, rdx;                         // r15 = orig user buf VA
        mov r14, rcx;                         // r14 = capped len

        // #741 Layer 1: user_ptr_ok(user_buf, capped_len) — reject any
        // buf in the kernel half BEFORE issuing sys_read_body. Prior to
        // this gate a ring-3 caller could `read(fd, 0xFFFF800000105000,
        // N)`; the walker resolved KPTI-mirror PML4[256] to the trampoline
        // data page and wrote attacker bytes over saved_user_rsp /
        // saved_user_CR3 / kernel_pml4_pa — full ring-3 → ring-0
        // corruption primitive (see design r16-m3-741-user-ptr-ok-defense-in-depth.md).
        // Gating on CAPPED len matches what user_write_bytes_via_walk will
        // actually touch (POSIX short-read semantics allow len > 4096;
        // callers re-issue for the remainder). Alignment: rsp%16 == 8
        // after the two pushes above; single `push rsi` (fd) is both the
        // fd-preserve slot and the alignment pad (rsp%16 → 0 for the
        // nested call).
        push rsi;                             // save fd across user_ptr_ok call
        mov rdi, r15;                         // arg0 = user buf VA
        mov rsi, r14;                         // arg1 = capped len
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        pop rsi;                              // restore fd
        cmp rax, 0;
        jne dispatch_read_efault;

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd restored above by pop
        lea rdx, [rip + _dispatch_read_buf_scratch]; // rdx = kernel scratch (not user buf)
        mov rcx, r14;                         // restore rcx = capped len
                                              //   (was clobbered by user_ptr_ok's KERNEL_VMA_BASE movabs)
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_read_body;
        add rsp, 8;

        // rax = bytes_read [0, cap] or errno (huge unsigned). Skip the
        // writeback if rax == 0 (EOF: nothing to copy) or rax > cap
        // (errno: don't touch user buf).
        cmp rax, 0;
        je dispatch_read_done;                // EOF fast-path
        cmp rax, r14;
        ja dispatch_read_done;                // errno passthrough

        // 1 <= rax <= cap: copy scratch[0..rax] back to user buf via walk.
        // Save bytes_read across the walk call.
        //
        // Alignment: at this point rsp%16==8 (post add rsp,8 above). Single
        // `push rax` → %16==0 which is exactly what the SysV C ABI requires
        // for a nested call (the call itself pushes RA and the callee sees
        // rsp%16==8 at entry). No additional sub rsp,8 pad needed.
        push rax;                             // save bytes_read for return + align
        mov rdi, r15;                         // arg0 = user buf VA
        lea rsi, [rip + _dispatch_read_buf_scratch]; // arg1 = kernel scratch
        mov rdx, rax;                         // arg2 = bytes_read
        call user_write_bytes_via_walk;       // rax = 0 or -EFAULT
        mov r8, rax;                          // stash walk result
        pop rax;                              // restore bytes_read (%16==8 again)

        cmp r8, 0;
        jne dispatch_read_efault;             // walker failed → -EFAULT

        dispatch_read_done:
        pop r14;
        pop r15;
        ret;

        dispatch_read_efault:
        pop r14;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        dispatch_write:
        // #541: user_ptr_ok(buf=rdx, len=rcx) — fault-check before ANY fd
        // path (UART fast-path or sys_write_body). Preserves rsi (fd) and
        // rcx (len) discipline: we need rdx→rdi and rcx→rsi for the call,
        // then restore. Callee (PtrCheck) clobbers only rax; caller regs
        // rsi/rcx/rdx must be re-established before falling through.
        push rsi;
        push rcx;
        push rdx;
        mov rdi, rdx;                         // arg0 = buf
        mov rsi, rcx;                         // arg1 = len
        call user_ptr_ok;
        pop rdx;
        pop rcx;
        pop rsi;
        cmp rax, 0;
        jne dispatch_write_efault;

        // Fast-path: fd 1 or 2 → UART (preserves stdout/stderr until init opens TTY fds)
        cmp rsi, 1;
        je dispatch_write_uart;
        cmp rsi, 2;
        je dispatch_write_uart;

        // R16-M3-KPTI-sweep (#734): real body path for fd >= 3.
        //
        // Prior code passed rdx (raw user buf VA) straight through to
        // sys_write_body → vfs_write → tmpfs_write, whose rep_movsb src =
        // rsi = user_va executed under kernel CR3 — same defect class as
        // #724 D4 / #730 D10c / #730 D10d / #737. Latent because no user
        // code exercises fd>=3 writes at R17.M0 (init uses only fd 1/2 via
        // UART fast path + sys_debug_puts). Would silently corrupt file
        // contents the moment a user program grows a real write() call.
        //
        // Fix: cap len at DISPATCH_IO_MAX (4096 — matches tmpfs single-page
        // ceiling, so no legal write is truncated), walk-copy buf bytes
        // into _dispatch_write_buf_scratch via user_read_bytes_via_walk,
        // then pass the scratch VA (not the user VA) to sys_write_body.
        // sys_write_body → vfs_write → tmpfs_write's rep_movsb src now
        // reads from the kernel scratch (safe under kernel CR3), and its
        // dst = allocated page (kernel VA, safe).
        //
        // Length cap semantics: POSIX permits short writes (write may
        // accept fewer bytes than requested and return the accepted count).
        // sys_write_body's own advance-offset logic uses `rax` (bytes
        // written), so a cap at 4096 correctly advances by up to 4096 —
        // user re-issues write for the remainder. At R17.M0 no caller
        // requests >4096.
        //
        // Alignment: entry rsp%16==8 (SysV call from syscall_entry). We
        // need to preserve rsi (fd) and the capped len across the walk
        // call; user_ptr_ok's push/pop discipline restored them already so
        // we start clean. Push rsi + push rcx pair (16 bytes) keeps
        // rsp%16==8 for the nested walk call — WRONG, walk needs %16==0.
        // Use push rsi + push rcx + sub rsp, 8 = 24 bytes → rsp%16==0. Pop
        // in reverse plus add rsp, 8 to restore.
        push rsi;                             // save fd across walk + body
        push rcx;                             // save orig len (for cap)
        sub rsp, 8;                           // align rsp%16==0 for nested call

        // Cap len at DISPATCH_IO_MAX (4096).
        mov rax, 4096;
        cmp rcx, rax;
        jbe dispatch_write_len_ok;
        mov rcx, rax;
      dispatch_write_len_ok:
        // Overwrite the saved orig-len slot with the capped len so it
        // matches what we pass to sys_write_body.
        mov [rsp + 8], rcx;

        // user_read_bytes_via_walk(dst=_dispatch_write_buf_scratch, user=buf, len=capped)
        lea rdi, [rip + _dispatch_write_buf_scratch];
        mov rsi, rdx;                         // user_va
        mov rdx, rcx;                         // len
        call user_read_bytes_via_walk;        // rax = 0 or -EFAULT

        add rsp, 8;                           // undo alignment pad
        pop rcx;                              // restore capped len
        pop rsi;                              // restore fd

        cmp rax, 0;
        jne dispatch_write_efault;            // walker failed → -EFAULT (matches -EFAULT convention)

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd, rcx=len (capped) already restored
        lea rdx, [rip + _dispatch_write_buf_scratch]; // rdx = buf (kernel scratch)
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_write_body;
        add rsp, 8;
        ret;

        dispatch_write_uart:
        // R17-M0-730 D10c (#730): route through user_puts_via_walk instead
        // of a raw `mov rax, [rdi]` byte loop. Under strict-KPTI the
        // syscall_entry trampoline flips CR3 to _kernel_pml4_pa (boot PML4)
        // before dispatch runs. The boot PML4's low identity map hits
        // WHATEVER byte sits at PHYSICAL address = user_va, which is NOT
        // the frame the user PML4 mapped user_va to. Same root cause as
        // #724 D4 (sys_debug_puts silent-NUL) — see design
        // r17-m0-724-d4-init-post-iretq-gp.md and
        // r17-m0-730-d10-execve-complete.md §D10c.
        //
        // rsi=fd (unused past this point), rdx=buf (user VA), rcx=len.
        // user_puts_via_walk(rdi=user_va, rsi=len) walks _current_tcb's
        // user_pml4_va per byte and reads via the higher-half identity
        // map, then calls uart_putc. Returns void; we echo len as rax.
        //
        // Alignment: entry rsp %16 == 8 (SysV; dispatch was `call`ed and
        // syscall_dispatch's own `call syscall_dispatch` from syscall_entry
        // left it that way). `push rcx` moves to %16 == 0 — correct for
        // the nested call. `pop rax` restores to %16 == 8 for `ret`.
        push rcx;                             // save len for return + align
        mov rdi, rdx;                         // arg0 = user_va (buf)
        mov rsi, rcx;                         // arg1 = len
        call user_puts_via_walk;              // walks user PML4 + emits
        pop rax;                              // rax = len (echoed)
        ret;

        // #541: EFAULT return — user_ptr_ok rejected buf. Same return
        // convention as the SysV syscall path: rax = -EFAULT sign-extended.
        dispatch_write_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT = -14
        ret;

        // R16-M3-KPTI-sweep (#733): route the user path VA through a
        // per-byte 4-level PML4 walk into _dispatch_open_path_scratch, then
        // pass the kernel-side scratch to sys_open_body. Prior code passed
        // rsi (raw user VA) straight through to sys_open_body → vfs_open →
        // path_resolve, whose byte-loads via `mov_b rax, [r12]` (path.pdx
        // §regular_lookup) executed under kernel CR3 — the boot PML4's low
        // identity map hits whatever kernel byte sits at PA = user_va, NOT
        // the frame the user PML4 maps user_va to. init's /dev/tty0 path at
        // user VA 0x400000+ typically read the kernel .bss zero at PA
        // 0x400000+, so byte 0 was NUL and vfs_open failed silently with
        // -ENOENT — init's stdio setup (open + 3× dup2 + close) collapsed
        // silently because init doesn't check the return.
        //
        // Post-fix, the walk-copy translates user VA → phys → higher-half
        // identity via the user PML4 (per byte), lands the NUL-terminated
        // path into _dispatch_open_path_scratch, and sys_open_body sees the
        // kernel VA scratch. Same defect-class fix as #737's dispatch_wait4
        // writeback via user_write_u32_via_walk and #730 D10d's
        // sys_execve_shim path copy via user_read_str_via_walk.
        //
        // On walker failure (unmapped page / kernel-half VA / path exceeds
        // 256 without NUL) → -EFAULT, matching sys_execve_shim's fail_efault
        // shape. sys_open's own -ENOENT is reserved for "path resolvable but
        // no such file" — walker failures are a distinct trust-boundary
        // failure.
        //
        // Alignment: dispatch_open was reached via `call syscall_dispatch`
        // from syscall_entry, so rsp%16==8 at entry. SysV C ABI requires
        // rsp%16==0 at the call instruction (callee sees %16==8 at entry).
        // Two 8-byte pushes leave %16==8, so we add sub rsp,8 to reach
        // %16==0 for the nested call. Symmetric add rsp,8 + two pops
        // restore alignment for the subsequent sys_open_body call.
        dispatch_open:
        // #741 Layer 1: user_ptr_ok(path_va, DISPATCH_PATH_MAX) — reject
        // any path_va in the kernel half BEFORE walking. Prior to this
        // gate a ring-3 caller could pass a kernel-half path_va and the
        // walker would happily resolve KPTI-mirror PML4[256] to real
        // kernel memory (see design r16-m3-741-user-ptr-ok-defense-in-depth.md).
        // Alignment: rsp%16 == 8 at entry; 3 pushes (rsi/rdx/rcx) →
        // rsp%16 == 0 for the nested call (matches dispatch_write's
        // 3-push pattern at #541).
        push rsi;                             // save path_va (%16==0)
        push rdx;                             // save flags     (%16==8)
        push rcx;                             // save mode      (%16==0)
        mov rdi, rsi;                         // arg0 = path_va
        mov rsi, 256;                         // arg1 = DISPATCH_PATH_MAX
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        pop rcx;                              // restore mode   (%16==8)
        pop rdx;                              // restore flags  (%16==0)
        pop rsi;                              // restore path_va(%16==8)
        cmp rax, 0;
        jne dispatch_open_efault;

        push rdx;                             // save flags (%16==0)
        push rcx;                             // save mode (%16==8)
        sub rsp, 8;                           // align for call (%16==0)
        mov rdi, rsi;                         // arg0 = path_va (user VA)
        lea rsi, [rip + _dispatch_open_path_scratch]; // arg1 = kernel scratch
        mov rdx, 256;                         // arg2 = cap = DISPATCH_PATH_MAX
        call user_read_str_via_walk;          // rax = strlen or 0 on fault
        add rsp, 8;                           // undo alignment pad (%16==8)
        pop rcx;                              // restore mode (%16==0)
        pop rdx;                              // restore flags (%16==8)
        cmp rax, 0;
        je dispatch_open_efault;              // walker failed → -EFAULT

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        lea rsi, [rip + _dispatch_open_path_scratch]; // rsi = path (kernel scratch)
        // rdx=flags, rcx=mode already restored
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_open_body;
        add rsp, 8;
        ret;

        dispatch_open_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        dispatch_close:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_close_body;
        add rsp, 8;
        ret;

        dispatch_cap_invoke:
        mov rdi, rsi;
        mov rsi, rdx;
        call cap_invoke;
        ret;

        // #724 D4 fix: dispatch_debug_puts now uses user_puts_via_walk,
        // which does a per-byte 4-level page-table walk on
        // _current_tcb.user_pml4_va to translate user_va→phys and reads
        // the byte via the kernel higher-half identity map before calling
        // uart_putc. The previous `mov rdi, rsi; call uart_puts` passed
        // the user VA directly to uart_puts, which walked memory under
        // kernel CR3 (boot PML4's low identity mapping) — and at user's
        // print buffer PA the kernel .bss zeros were read, so uart_puts
        // saw NUL at byte 0 and returned silently. This is why
        // INIT ENTERED RING3 never made it to wire despite init actually
        // executing the sys_debug_puts syscall (confirmed by QEMU
        // interrupt trace: cpl=3 pc=0x4001fd hit 861 times). See design
        // r17-m0-724-d4-init-post-iretq-gp.md §Root Cause.
        // logging-m9-002 (#709): sys_dmesg(buf, len).
        //
        // SysV args at this point: rsi = user_buf VA, rdx = len. We copy
        // ring bytes into _dispatch_dmesg_buf_scratch via sys_dmesg_body
        // (which delegates to klog_ring_read_tail — a kernel-side ring
        // walker; never touches user memory), then walk them out to the
        // user buffer via user_write_bytes_via_walk. Same
        // KPTI-bounce-buffer pattern as dispatch_read (#738); the ring is
        // kernel .bss so no user_ptr_ok on the source is needed, but the
        // destination buf still requires user_ptr_ok + walker-based
        // writeback so a ring-3 caller cannot corrupt kernel memory (§741
        // defense-in-depth).
        //
        // Length cap: DISPATCH_IO_MAX (4096) — matches sys_read/sys_write
        // and the ring's per-call peek ceiling. Callers requesting more
        // re-issue for the remainder; klog_ring_read_tail is a peek (does
        // NOT advance tail), so successive calls see the same window and
        // may double-report if the user does not track offsets themselves.
        // This matches POSIX dmesg(1) contract: dmesg is idempotent-peek,
        // syslog_read(SYSLOG_ACTION_READ_ALL) semantics.
        //
        // Alignment: entry rsp%16==8 (SysV). Two pushes (r15=user buf,
        // r14=capped len) + push rsi (fd-preserve slot / align pad for
        // user_ptr_ok call) = pattern identical to dispatch_read.
        dispatch_dmesg:
        push r15;                             // save user buf VA
        push r14;                             // save capped len

        // Cap len at DISPATCH_IO_MAX (4096).
        mov rax, 4096;
        cmp rdx, rax;
        jbe dispatch_dmesg_len_ok;
        mov rdx, rax;
      dispatch_dmesg_len_ok:

        mov r15, rsi;                         // r15 = user buf VA (arg0 was buf)
        mov r14, rdx;                         // r14 = capped len

        // #741 Layer 1: user_ptr_ok(user_buf, capped_len).
        sub rsp, 8;                           // align (%16==0 for nested call)
        mov rdi, r15;                         // arg0 = user buf VA
        mov rsi, r14;                         // arg1 = capped len
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        add rsp, 8;                           // undo pad (%16==8)
        cmp rax, 0;
        jne dispatch_dmesg_efault;

        // sys_dmesg_body(kernel_dst_ptr=scratch, len=capped_len)
        //   -> rax = bytes copied in [0, capped_len].
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        lea rdi, [rip + _dispatch_dmesg_buf_scratch]; // arg0 = kernel scratch
        mov rsi, r14;                         // arg1 = capped len
        call sys_dmesg_body;
        add rsp, 8;

        // rax = bytes copied in [0, capped_len]. Short-copy (rax < r14) is
        // legal and expected when the ring holds fewer bytes than
        // requested. rax > r14 is impossible (klog_ring_read_tail caps its
        // return at the requested len). rax == 0 fast-paths out (nothing
        // to walk; the syscall returns 0 to indicate "no more ring bytes"
        // — parallel to sys_read EOF).
        cmp rax, 0;
        je dispatch_dmesg_done;

        // Copy scratch[0..bytes_copied] back to user buf via walker.
        // Alignment: rsp%16==8 now; single `push rax` (save bytes_copied)
        // → %16==0 for nested call. `pop rax` restores %16==8.
        push rax;                             // save bytes_copied for return
        mov rdi, r15;                         // arg0 = user buf VA
        lea rsi, [rip + _dispatch_dmesg_buf_scratch]; // arg1 = kernel scratch
        mov rdx, rax;                         // arg2 = bytes_copied
        call user_write_bytes_via_walk;       // rax = 0 (OK) or -EFAULT
        mov r8, rax;                          // stash walker result
        pop rax;                              // restore bytes_copied

        cmp r8, 0;
        jne dispatch_dmesg_efault;            // walker failed → -EFAULT

        dispatch_dmesg_done:
        pop r14;
        pop r15;
        ret;

        dispatch_dmesg_efault:
        pop r14;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        // R20b.M3-001 (#1558): sysno 40 = sys_ipc_recv(cap_slot, user_hdr_va,
        // user_payload_va, user_payload_max) -> payload_len | -EBADF | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = cap_slot        (treated as raw endpoint_id at R20b.M3-001)
        //   rdx = a1 = user_hdr_va
        //   rcx = a2 = user_payload_va
        //   r8  = a3 = user_payload_max
        //
        // Scaffolding at R20b.M3-001: userspace has not yet been seeded
        // any KIND_IPC_ENDPOINT caps (R20b.M4 lands loader_seed_caps),
        // so no ring-3 caller can name one. The dispatch shim therefore
        // treats a0 as a raw endpoint_id and defers the cap-lookup +
        // rights-gate (R_IPC_READ | R_IPC_INVOKE) to the M3-004
        // syscall-shim wire-up. See src/kernel/core/syscall/handlers/
        // sys_ipc_recv.pdx §Layer split for the full rationale.
        //
        // What this shim DOES gate at R20b.M3-001:
        //   (1) user_ptr_ok(user_hdr_va, 8)                    — reject kernel-half hdr VA
        //   (2) user_ptr_ok(user_payload_va, user_payload_max) — reject kernel-half payload VA
        // Both gates match the #741 defense-in-depth pattern used by
        // dispatch_read / dispatch_write / dispatch_dmesg — the walker's
        // #741 Layer 2 range gate is a last-line-of-defense, not the
        // first. Length 0 is legal (header-only recv); user_ptr_ok's
        // range math handles it correctly (rax=va+0=va, ja check passes
        // iff va < KERNEL_VMA_BASE).
        //
        // Alignment: entry rsp %16 == 8 (SysV). Each pre-body gate uses
        // 4 pushes + `sub rsp, 8` = 40 bytes → %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 4 pops on return. The terminal
        // body call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.
        dispatch_ipc_recv:
        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save cap_slot / id      (%16==0)
        push rdx;                                 // save user_hdr_va        (%16==8)
        push rcx;                                 // save user_payload_va    (%16==0)
        push r8;                                  // save user_payload_max   (%16==8)
        sub rsp, 8;                               // align                    (%16==0)
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = BOUNCE_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;                             // stash fault flag (r10 caller-save, not live)
        add rsp, 8;                               //                          (%16==8)
        pop r8;                                   //                          (%16==0)
        pop rcx;                                  //                          (%16==8)
        pop rdx;                                  //                          (%16==0)
        pop rsi;                                  //                          (%16==8)
        cmp r10, 0;
        jne dispatch_ipc_recv_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, user_payload_max) ----
        push rsi;                                 // save cap_slot / id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save user_payload_max
        sub rsp, 8;                               // align
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = user_payload_max
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_recv_efault;

        // ---- Marshal args for sys_ipc_recv_body(id, hdr_va, payload_va, payload_max) ----
        // Current: rsi=id, rdx=user_hdr_va, rcx=user_payload_va, r8=user_payload_max
        // Body:    rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=user_payload_max
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = user_payload_max (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_recv_body;
        add rsp, 8;
        ret;

        dispatch_ipc_recv_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        // R20b.M3-002 (#1559): sysno 42 = sys_ipc_send(cap_slot, user_hdr_va,
        // user_payload_va, payload_len) -> 0 | 1(EAGAIN) | 2(BAD_ID) |
        // 3(E2BIG) | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = cap_slot        (treated as raw endpoint_id at R20b.M3-002)
        //   rdx = a1 = user_hdr_va
        //   rcx = a2 = user_payload_va
        //   r8  = a3 = payload_len
        //
        // Scaffolding at R20b.M3-002: userspace has not yet been seeded any
        // KIND_IPC_ENDPOINT caps (R20b.M4 lands loader_seed_caps), so no
        // ring-3 caller can name one. The dispatch shim therefore treats
        // a0 as a raw endpoint_id and defers the cap-lookup + rights-gate
        // (R_IPC_WRITE | R_IPC_INVOKE) to the M3-004 syscall-shim wire-up.
        // See src/kernel/core/syscall/handlers/sys_ipc_send.pdx §Layer
        // split — matches the sibling dispatch_ipc_recv (M3-001) discipline.
        //
        // What this shim DOES gate at R20b.M3-002 (per the #741 defense-in-
        // depth pattern used by dispatch_read / dispatch_write /
        // dispatch_dmesg / dispatch_ipc_recv):
        //   (1) user_ptr_ok(user_hdr_va, 8)                — reject kernel-half hdr VA
        //   (2) user_ptr_ok(user_payload_va, payload_len)  — reject kernel-half payload VA
        // Length 0 is legal (header-only send); user_ptr_ok's range math
        // handles it correctly (rax=va+0=va, ja check passes iff
        // va < KERNEL_VMA_BASE).
        //
        // Alignment: entry rsp %16 == 8 (SysV). Each pre-body gate uses
        // 4 pushes + `sub rsp, 8` = 40 bytes → %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 4 pops on return. The terminal
        // body call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket. Identical shape to dispatch_ipc_recv.
        dispatch_ipc_send:
        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save cap_slot / id     (%16==0)
        push rdx;                                 // save user_hdr_va       (%16==8)
        push rcx;                                 // save user_payload_va   (%16==0)
        push r8;                                  // save payload_len       (%16==8)
        sub rsp, 8;                               // align                   (%16==0)
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = FRAME_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;                             // stash fault flag (r10 caller-save, not live)
        add rsp, 8;                               //                         (%16==8)
        pop r8;                                   //                         (%16==0)
        pop rcx;                                  //                         (%16==8)
        pop rdx;                                  //                         (%16==0)
        pop rsi;                                  //                         (%16==8)
        cmp r10, 0;
        jne dispatch_ipc_send_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, payload_len) ----
        push rsi;                                 // save cap_slot / id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save payload_len
        sub rsp, 8;                               // align
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = payload_len
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_send_efault;

        // ---- Marshal args for sys_ipc_send_body(id, hdr_va, payload_va, payload_len) ----
        // Current: rsi=id, rdx=user_hdr_va, rcx=user_payload_va, r8=payload_len
        // Body:    rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=payload_len
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = payload_len (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_send_body;
        add rsp, 8;
        ret;

        dispatch_ipc_send_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        // R20b.M3-002 (#1559): sysno 41 = sys_ipc_reply(cap_slot, user_hdr_va,
        // user_payload_va, payload_len) -> 0 | pass-through send rc |
        // -EFAULT | -EINVAL (bit-7 not set).
        //
        // Body semantics per design/ipc/userspace-server-substrate.md §5.1:
        // "alias of sys_ipc_send with bit-7 op flip" — sys_ipc_reply_body
        // pre-checks hdr.op & FRAME_OP_REPLY_BIT (0x80) and rejects with
        // -EINVAL if unset, else tail-calls sys_ipc_send_body. The user_ptr_ok
        // gates + arg marshalling are identical to dispatch_ipc_send, so the
        // shim shape is duplicated with only the terminal call target
        // changed. Keeping the gate-shim inline (vs. factoring a shared
        // helper) matches the existing dispatch layer's discipline — every
        // sysno has its own shim body per the linear cmp/je switch style.
        dispatch_ipc_reply:
        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save cap_slot / id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save payload_len
        sub rsp, 8;                               // align
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = FRAME_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_reply_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, payload_len) ----
        push rsi;
        push rdx;
        push rcx;
        push r8;
        sub rsp, 8;
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = payload_len
        call user_ptr_ok;
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_reply_efault;

        // ---- Marshal args for sys_ipc_reply_body(id, hdr_va, payload_va, payload_len) ----
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = payload_len (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_reply_body;
        add rsp, 8;
        ret;

        dispatch_ipc_reply_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_debug_puts:
        // #741 Layer 1: user_ptr_ok(user_va, len) — pre-existing gap
        // from #724 D4. Prior to this gate a ring-3 caller could invoke
        // sys_debug_puts(kernel_va, len); the walker would follow
        // KPTI-mirror PML4[256], and although uart_putc is a read
        // (spillage limited to observability rather than corruption) the
        // untrusted-pointer discipline still requires a gate. See
        // design/kernel/r16-m3-741-user-ptr-ok-defense-in-depth.md.
        // Alignment: rsp%16 == 8 at entry; two pushes + sub rsp, 8 →
        // rsp%16 == 0 for the nested call.
        push rsi;                                 // save user_va (%16==0)
        push rdx;                                 // save len     (%16==8)
        sub rsp, 8;                               // align         (%16==0)
        mov rdi, rsi;                             // arg0 = user_va
        mov rsi, rdx;                             // arg1 = len
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r8, rax;                              // stash result (r8 caller-save, not live)
        add rsp, 8;                               //               (%16==8)
        pop rdx;                                  // restore len   (%16==0)
        pop rsi;                                  // restore user_va (%16==8)
        cmp r8, 0;
        jne dispatch_debug_puts_efault;

        push rdx;                                 // save count for return (%16==0)
        mov rdi, rsi;                             // rdi = user_va (buf)
        mov rsi, rdx;                             // rsi = len (count)
        call user_puts_via_walk;                  // walks + prints
        pop rax;                                  // rax = count (echoed)  (%16==8)
        ret;

        dispatch_debug_puts_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_dup2:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=src_fd, rdx=dst_fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_dup2_body;
        add rsp, 8;
        ret;

        dispatch_getpid:
        mov rax, [rip + _current_tcb];
        mov eax, [rax + 0];                   // TASK_OFF_PID = 0, u32 zero-extends into rax
        ret;

        dispatch_fork:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_fork_body;
        add rsp, 8;
        ret;

        // R17-M0-724-D2 (#724): real termination path — see design/kernel/r17-m0-724-d2-sys-exit-terminate.md.
        // Sequence (all invoked with SysV rsp%16==0 after the single sub rsp,8 prelude,
        // which each nested `call` advances by pushing an 8-byte RA to satisfy the
        // callee's SysV rsp%16==8 entry contract):
        //   (1) sys_exit_body(current, status) — marks current ZOMBIE, wakes parent
        //       if WAITING (three-store: wait_result_pid, wait_result_status, state).
        //   (2) runq_dequeue(current) — remove the ZOMBIE from the circular runqueue
        //       so sched_pick_next_r15 will never re-select it. Precondition (per
        //       #563 §5): task must currently be on the runqueue — init and every
        //       child forked from it are enqueued at task_new / kernel_main time.
        //   (3) sched_pick_next_r15() — returns rax = next TCB (a RUNNABLE task
        //       still on the runqueue, or _idle_tcb if the runqueue is empty).
        //   (4) sched_switch_r15(next) — saves the ZOMBIE's stale kernel-stack rsp
        //       into the ZOMBIE's TCB (harmless waste; the TCB will be reaped by
        //       the parent's sys_wait_body → pid_free chain and its saved state
        //       is never read) and switches to next's stack via iretq-like
        //       synthetic-frame trampoline. Never returns to us.
        // The defensive fallthrough jmp dispatch_exit_halt is unreachable in
        // normal ops; it fires only if sched_switch_r15's continuation somehow
        // re-selected this ZOMBIE — which would require a scheduler bug that
        // failed the runq_dequeue precondition. klog_panic tag = tag_exit_returned.
        dispatch_exit:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_exit_body;                   // (1) mark ZOMBIE, wake parent if WAITING

        mov rdi, [rip + _current_tcb];        // (2) runq_dequeue(current)
        call runq_dequeue;

        call sched_pick_next_r15;             // (3) rax = next TCB (or _idle_tcb)

        mov rdi, rax;                         // (4) sched_switch_r15(next) — no return
        call sched_switch_r15;

        // UNREACHABLE — sched_switch_r15 never returns to a ZOMBIE (runq_dequeue'd).
        // Defensive fallthrough: fire klog_panic with tag_exit_returned so a
        // scheduler-bug regression surfaces on the wire rather than silently
        // corrupting whichever task's kernel stack we resumed onto.
        jmp dispatch_exit_halt;

        dispatch_exit_halt:
        lea rdi, [rip + SUBSYS_INT_];
        lea rsi, [rip + tag_exit_returned];
        call klog_panic;
        jmp dispatch_exit_halt;

        // R17-M0-724-D5a (#724): would-block branch — on sys_wait_body's
        // rax==0 signal, invoke sched_block (which performs the state=WAITING
        // flip, runq_dequeue, sched_pick_next_r15, sched_switch_r15). On
        // resume the parent lands back here; read wait_result_{pid,status}
        // from its own slab (populated by sys_exit_body's wake path @1704,
        // @1708) into rax/rdx, then continue with the writeback + ret.
        // See design/kernel/r17-m0-724-d5-sys-wait-block.md §6 for the
        // full round-trip trace.
        dispatch_wait4:
        // #732 fix: syscall_dispatch's SysV C ABI puts arg0 (pid) in rsi
        // and arg1 (wstatus) in rdx (see entry.pdx §shuffle at L92-97:
        // mov rdx, rsi = old-arg1; mov rsi, rdi = old-arg0). Prior code
        // read wstatus from rsi — that's the pid arg (0xFFFFFFFFFFFFFFFF
        // for init's wait-for-any-child), which user_ptr_ok correctly
        // rejected as kernel-half → -EFAULT; pre-#731 the epilogue's
        // rax-clobber masked that failure so init.pdx's `jl init_shutdown`
        // silently absorbed the error and the hardcoded `wait_msg` printed
        // spuriously. Move the real wstatus pointer into rsi so the rest
        // of this handler (which was written against the assumption
        // "wstatus in rsi") operates on the correct value. The pid arg is
        // discarded: sys_wait_body scans all children of `current` (which
        // matches init's pid=-1 wait-for-any-child semantic); full POSIX
        // pid-filtering is out of scope at R17.M0.
        // See design/kernel/r15-m6-732-wait4-arg-marshalling.md.
        mov rsi, rdx;
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        push rsi;                             // save wstatus user ptr across call
        call sys_wait_body;                   // {rax=pid, rdx=status} or {rax=0} or {rax=-ECHILD}
        pop rsi;                              // restore wstatus ptr
        cmp rax, 0;
        jne dispatch_wait4_writeback;         // reap (rax=pid) or -ECHILD → skip block

        // rax == 0 (would-block): sched_block, then read wait_result on resume.
        push rsi;                             // preserve wstatus ptr across sched_block
        call sched_block;                     // blocks; returns when child exit fires runq_enqueue(parent)
        pop rsi;                              // restore wstatus ptr

        // Resume: read parent's wait_result_{pid,status} into rax/rdx.
        // _current_tcb after sched_switch_r15 is us (the parent) again;
        // sys_exit_body's wake path wrote wait_result_pid @ +1704 and
        // wait_result_status @ +1708 before setting our state=RUNNABLE.
        mov rax, [rip + _current_tcb];
        mov ecx, [rax + 1704];                // wait_result_pid (u32 zero-ext)
        mov edx, [rax + 1708];                // wait_result_status (u32 zero-ext)
        mov rax, rcx;                         // rax = zombie pid

        // R17-M5-753 (paideia-os #753): pid_free(zombie_pid) on the
        // sched-block wake path. The reap path (rax != 0 from
        // sys_wait_body) already frees the ZOMBIE slab via
        // sys_wait.pdx L60's pid_free call. The sched-block+wake path
        // previously did NOT — sys_exit_body sets the ZOMBIE state and
        // wakes the parent, but pid_free is the parent's wait-reap
        // responsibility.
        //
        // Symptom pre-fix: every wake-based wait4 leaked the reaped
        // child's slab in _pid_table. A subsequent wait4 found the
        // stale ZOMBIE and reaped it "for real" — producing a duplicate
        // WAIT/REAPED wire artifact plus incorrect pid arithmetic
        // (parent sees the OLD child's pid/status instead of blocking
        // for the NEW child). Surfaced by paideia-os #749's second
        // fork+wait cycle for /bin/sh.
        //
        // Alignment: entry to dispatch_wait4 is rsp%16==8 (SysV). After
        // sched_block returned and pop rsi, we're at %16==8. Three
        // pushes (rax, rdx, rsi) → %16==0 (correct for pid_free's SysV
        // call). pid_free is a leaf-2-instruction primitive (task_pool.pdx
        // §pid_free) that clobbers no callee-save regs; still we save
        // rax/rdx (the live return values) and rsi (the wstatus user
        // pointer that dispatch_wait4_writeback still needs) across the
        // call. Three pops restore %16==8 for the writeback path.
        push rax;                             // save zombie pid (return value)
        push rdx;                             // save exit status
        push rsi;                             // save wstatus user ptr
        mov rdi, rax;                         // arg0 = zombie pid
        call pid_free;                        // _pid_table[pid] = 0
        pop rsi;                              // restore wstatus user ptr
        pop rdx;                              // restore exit status
        pop rax;                              // restore zombie pid

        dispatch_wait4_writeback:
        cmp rsi, 0;
        je dispatch_wait4_done;
        // #724-D5-verify: validate wstatus before writing. Unlike
        // dispatch_write (which calls user_ptr_ok(buf, len) at #541), this
        // writeback wrote through rsi unconditionally — a user program
        // passing an unmapped or kernel-half wstatus pointer would fault
        // the kernel on the raw store. Mirror dispatch_write's pattern:
        // save the live return values (rax=pid, rdx=status) and the
        // pointer itself (rsi, about to be clobbered as the len arg)
        // across the call; user_ptr_ok clobbers rax and rcx (per
        // dispatch_write's save/restore precedent at L85-95), so rax/rdx
        // must be pushed too, not just rsi.
        push rax;                             // save zombie pid (return value)
        push rdx;                             // save status
        push rsi;                             // save wstatus va (about to become len arg)
        mov rdi, rsi;                         // arg0 = wstatus va
        mov rsi, 4;                           // arg1 = len (u32 write width)
        call user_ptr_ok;
        mov r8, rax;                          // stash fault flag (r8 not live here)
        pop rsi;                              // restore wstatus va
        pop rdx;                              // restore status
        pop rax;                              // restore zombie pid
        cmp r8, 0;
        jne dispatch_wait4_efault;
        // #737 fix: route the 4-byte wstatus store through
        // user_write_u32_via_walk so the write lands on init's user
        // PML4-mapped frame instead of PA=user_va via boot PML4's low
        // identity map. Same defect class as #724 D4 dispatch_debug_puts,
        // #730 D10c dispatch_write_uart, #730 D10d sys_execve_shim path
        // copy. Pre-fix wire: `WAIT: pid=23 status=0` (child_hello's
        // sys_exit(42) was silently lost because init's read of
        // wait_status[0] came back as the ELF loader's zero, not the byte
        // the kernel had written under kernel CR3 to the wrong physical
        // page). Post-fix: `WAIT: pid=23 status=42`. See
        // design/kernel/r16-m3-737-dispatch-wait4-writeback-kpti.md.
        //
        // Callee-save discipline: user_write_u32_via_walk is a leaf
        // helper (no nested call inside it) but per its documented
        // contract clobbers all caller-save regs (rax, rcx, rdx, rsi,
        // rdi, r8-r10). rax (zombie pid — our return value) must
        // survive; save/restore it via push/pop across the call. rdx
        // (status) and rsi (wstatus ptr) become the SysV args for the
        // call, so they are consumed rather than preserved. r8 (walk
        // result) is stashed post-call before the pop restores rax, then
        // used to branch on EFAULT.
        //
        // Alignment: dispatch_wait4_writeback was reached from
        // syscall_dispatch's `call` (SysV rsp%16 == 8 at entry to
        // dispatch_wait4). The three prior pushes (rax/rdx/rsi) plus
        // three pops between user_ptr_ok and here restore rsp to its
        // dispatch-entry value (%16 == 8). The single `push rax` below
        // moves rsp to %16 == 0 — correct for the nested
        // `call user_write_u32_via_walk`. `pop rax` restores %16 == 8 for
        // our own `ret`.
        push rax;                             // save zombie pid across the call
        mov rdi, rsi;                         // arg0 = wstatus user VA
        mov rsi, rdx;                         // arg1 = status (u64; low 32 used)
        call user_write_u32_via_walk;         // rax = 0 (OK) or -EFAULT
        mov r8, rax;                          // stash walk result
        pop rax;                              // restore zombie pid
        cmp r8, 0;
        jne dispatch_wait4_efault;            // walk failed → -EFAULT
        dispatch_wait4_done:
        ret;

        // wstatus failed user_ptr_ok — return -EFAULT (same convention as
        // dispatch_write_efault above).
        dispatch_wait4_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT = -14
        ret;

        // R17-M0-671 (#671): sys_execve dispatch shim — bridges SC+ ABI
        // (path, argv, envp) to sys_execve_body(current, image_ptr, image_len).
        // See design/kernel/r17-m0-671-sys-execve-shim.md for full contract.
        // SysV args on entry to dispatch: rsi=path_va, rdx=argv_va, rcx=envp_va.
        // Shim expects: rdi=current, rsi=path_va, rdx=argv_va, rcx=envp_va —
        // exactly matches once we load _current_tcb into rdi.
        dispatch_execve:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current (task_struct*)
        // rsi=path_va, rdx=argv_va, rcx=envp_va already SysV-positioned
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_execve_shim;                 // {rax, rdx} = errno or (0, entry_rip)
        add rsp, 8;
        ret;

        dispatch_enosys:
        mov rax, 0xFFFFFFFFFFFFFFDA;
        ret
      }
    } @no_frame

}
