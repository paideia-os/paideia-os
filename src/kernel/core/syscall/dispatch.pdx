// src/kernel/core/syscall/dispatch.pdx — R17-M0-668 (#668) SC+ freeze alignment — wire kernel dispatch to real bodies
// R56.M3-001 (#1790): bounds check widened 76->82; sysnos 77..82 forward-
//   declared as ENOSYS stubs for the VFS metadata block (sys_stat,
//   sys_getdents, sys_mkdir, sys_rmdir, sys_unlink, sys_rename).  Real
//   bodies land in #1791..#1795 (per-syscall); #1795 owns the boot
//   smoke that exercises them.  Schema:
//   design/kernel/vfs-metadata-syscalls.md.
// R17-M0-671 (#671): sysno 59 (execve) rewired from ENOSYS stub to sys_execve_shim.
// R20b.M3-003 (#1560): sysno 43 (svc_lookup) wired to sys_svc_lookup_body
//   via dispatch_svc_lookup; closes the R20b.M3 (server-process model)
//   milestone alongside the M3-001/002 sysno 40..42 handlers.
// R17-M0-724-D2 (#724): sysno 60 (exit) — replace klog_panic hlt loop with real
//   task-termination path: sys_exit_body → runq_dequeue(current) →
//   sched_pick_next_r15 → sched_switch_r15(next). Never returns to the exiting
//   task's kernel syscall frame; the fallthrough dispatch_exit_halt is now a
//   defensive-only witness for "sched_switch_r15 returned to a ZOMBIE" — which
//   is unreachable in normal ops because the ZOMBIE has been runq_dequeue'd.
// #1582 part A + B: sysnos 66..69 wired for time source + affinity + LP-E
//   reservation. Bounds check widened from 61 to 69 in the same edit so a
//   ring-3 caller passing sysno 66..69 does not fall through to
//   dispatch_enosys. IDs chosen contiguously above the R20b IPC block (43)
//   and the R17.M0 termination block (60/61) with a small gap so paideia-as
//   #1087 (AML executor task) can claim adjacent low-64 slots for a related
//   sysno without a second bounds bump. Bounds change keeps the existing
//   `cmp rdi, 61; je dispatch_wait4` inside the switch — tools/verify-
//   syscall-dispatch.sh's grep for "cmp.*0x3d" still matches that inner
//   cmp, so the fingerprint gate does not need a rewrite.
// Linear cmp/je chain over 13 syscall IDs per R13 preflight §C, extended with R16-M3 handler bodies.
// R17.M0 alignment (#668):
//   0 (read): load _current_tcb, call sys_read_body
//   1 (write): fd 1,2 → UART fast-path; fd >= 3 → sys_write_body
//   2 (open): load _current_tcb, call sys_open_body
//   3 (close): load _current_tcb, call sys_close_body
//   4 (cap_invoke): tail-call cap_invoke after arg shuffle [UNCHANGED]
//   12 (debug_puts): call uart_puts, echo msg_len [UNCHANGED]
//   32 (dup2): load _current_tcb, call sys_dup2_body
//   39 (getpid): inline from _current_tcb @ TASK_OFF_PID (0)
//   56 (fork): load _current_tcb, call sys_fork_body
//   59 (execve): load _current_tcb, call sys_execve_shim (path→image copy-in; #671)
//   60 (exit): sys_exit_body → runq_dequeue → pick_next → switch_r15 (never returns) [#724 D2]
//   61 (wait4): load _current_tcb, call sys_wait_body; on rax==0 (would-block signal)
//               call sched_block, then read wait_result_{pid,status} from parent slab
//               (@1704, @1708); writeback wstatus. [#724 D5a]
// All others return ENOSYS (-38 as u64 = 0xFFFFFFFFFFFFFFDA).
// [unsafe] — dispatches to sysreg/mem-effecting handlers.
// Audit: design/kernel/r17-m0-668-syscall-dispatch-align.md
// Audit: design/kernel/r17-m0-671-sys-execve-shim.md
// Audit: design/kernel/r17-m0-724-d2-sys-exit-terminate.md
// Audit: design/kernel/r17-m0-724-d5-sys-wait-block.md

module Dispatch = structure {
  // ==========================================================================
  // R16-M3-KPTI-sweep (#733 #734 #738 #739): per-syscall bounce scratches
  //
  // The sys_open/sys_read/sys_write dispatch paths receive user VA pointers
  // (path / buf) from ring-3 via SysV registers. Under strict-KPTI the
  // syscall_entry trampoline has flipped CR3 to _kernel_pml4_pa (= boot PML4,
  // 0..4 GiB low identity map only), so any downstream kernel read/write via
  // that raw user VA lands on whichever kernel byte the boot PML4 covers PA
  // = user_va with — NOT the user-PML4-mapped frame. Same defect class as
  // #724 D4 / #730 D10c / #730 D10d / #737 (already fixed at their own sites).
  //
  // Fix approach (Option B — dispatch-layer once):
  //   Route the user VA copy through a bounce buffer here, before/after the
  //   respective sys_*_body call. The bodies keep their existing "kernel VA"
  //   contracts unchanged — sys_open_witness, sys_read_witness, and
  //   sys_write_witness (kernel_main.pdx L4054+/L4227+/L4335+) all pass
  //   kernel-VA pointers directly, so touching the body would regress them.
  //   The dispatch layer is the natural user↔kernel boundary — same layer
  //   #737 fixed dispatch_wait4 at.
  //
  // Concurrency: at R17.M0 the only user tasks are init + child_hello;
  // neither calls sys_read or fd>=3 sys_write, and only init calls sys_open
  // (once, for /dev/tty0). No two tasks concurrently touch any of these
  // scratches, so the static (rather than per-task) allocation is race-free
  // for this landing. Future work (multi-task sys_read on tty stdin): move
  // the scratches into the TCB slab or use kernel-stack sub rsp allocation.
  //
  // Sizing:
  //   _dispatch_open_path_scratch   : PATH_MAX == 256, aligned with
  //                                   _vfs_open_parent_scratch (vfs_open.pdx)
  //                                   and _execve_path_scratch (sys_execve_shim.pdx)
  //   _dispatch_read_buf_scratch    : 4096 = tmpfs single-page cap
  //                                   (tmpfs/read.pdx §4.7 cross-page reject)
  //   _dispatch_write_buf_scratch   : 4096 = tmpfs single-page cap
  //                                   (tmpfs/write.pdx §4.5 cross-page reject)
  //
  // Design: design/kernel/r16-m3-kpti-sweep-733-734-738-739.md
  // ==========================================================================
  pub let DISPATCH_PATH_MAX  : u64 = 256
  pub let DISPATCH_IO_MAX    : u64 = 4096
  pub let mut _dispatch_open_path_scratch  : [u8; 256]  = uninit @align(8)
  pub let mut _dispatch_read_buf_scratch   : [u8; 4096] = uninit @align(8)
  pub let mut _dispatch_write_buf_scratch  : [u8; 4096] = uninit @align(8)

  // logging-m9-002 (#709): sys_dmesg scratch. Symmetric to the read/write
  // scratches above — dispatch_dmesg copies ring bytes into this kernel
  // buffer via klog_ring_read_tail, then walks them out to the user's buf
  // via user_write_bytes_via_walk. Size matches DISPATCH_IO_MAX so a
  // single sys_dmesg call sees up to a page worth of ring; a caller
  // requesting more issues subsequent calls (POSIX short-read semantics).
  // Same "single reader at R18" concurrency note as the other scratches:
  // future SMP dmesg readers park in a TCB-side scratch (see kernel-
  // logging-substrate.md §14 Q3 per-CPU rings deferral).
  pub let mut _dispatch_dmesg_buf_scratch  : [u8; 4096] = uninit @align(8)

  // R42-PREP-008 (#1630): per-syscall bounce scratch for
  // sys_pdxfs_dir_readnext.  The body writes PDXFS_DIR_ENTRY_SIZE
  // (= 128) bytes of stub entry into this kernel-side scratch, then
  // the dispatch shim walk-copies them out to the user's buffer via
  // user_write_bytes_via_walk.  Same KPTI-bounce discipline as the
  // read/write/dmesg scratches above -- keeps the body contract
  // (`kernel_dst_ptr must be a kernel VA`) unchanged and confines the
  // trust-boundary walk to the dispatch layer.
  //
  // Sizing: exactly PDXFS_DIR_ENTRY_SIZE (128).  A per-body scratch
  // rather than a per-cap one so a future multi-fd `getdents`-batch
  // syscall can grow the scratch without touching the underlying
  // primitive (pdxfs_dir_readnext already takes a caller-provided
  // kbuf pointer; batching means passing a wider scratch).
  //
  // Concurrency: single-flow at R42-PREP-008 (matches the sibling
  // scratches above).  Multi-task readdir moves this into a TCB-side
  // scratch alongside the read/write/dmesg counterparts.
  //
  // @align(8) matches the body's u64-store loop discipline; a bare
  // [u8; 128] without the annotation would still occupy 128 B at 8B
  // alignment in paideia-as .bss but the annotation is documentation.
  pub let mut _dispatch_pdxfs_dir_scratch : [u8; 128] = uninit @align(8)

  // R57.M4-003 (paideia-os #1799): per-syscall bounce scratch for
  // sys_taskinfo.  The body writes the 32-byte task-info record into
  // this kernel-side scratch, then the dispatch shim walk-copies the
  // bytes out to the user's buffer via user_write_bytes_via_walk.
  // Same KPTI-bounce discipline as _dispatch_pdxfs_dir_scratch above --
  // keeps sys_taskinfo_body's contract ("kernel_dst is a kernel VA")
  // unchanged and confines the trust-boundary walk to the dispatch
  // layer.
  //
  // Sizing: exactly TASK_INFO_RECORD_BYTES (32).  A dedicated scratch
  // rather than reusing _dispatch_pdxfs_dir_scratch (128 B) because
  // the two syscalls have unrelated concurrency lifetimes; overloading
  // one scratch across syscalls costs one witness read of the wrong
  // shape the moment a second-caller lands.
  //
  // Concurrency: single-flow at R57.M4 (matches the sibling scratches
  // above).  Multi-task ps -- or a service dumping the pool from a
  // background thread while a shell reads it -- moves this into a
  // TCB-side scratch alongside the read/write/dmesg/pdxfs counterparts.
  //
  // @align(8) matches the body's u64-store loop discipline; a bare
  // [u8; 32] without the annotation would still occupy 32 B at 8 B
  // alignment in paideia-as .bss but the annotation is documentation.
  pub let mut _dispatch_taskinfo_scratch : [u8; 32] = uninit @align(8)

  // R57.M4-004 (paideia-os #1800): per-syscall bounce scratch for
  // sys_mountinfo (sysno 84).  The body writes the 32-byte mount-info
  // record (see src/kernel/core/syscall/sys_mountinfo.pdx §Record
  // layout) into this kernel-side scratch, then the dispatch shim
  // walk-copies the bytes out to the user's buffer via
  // user_write_bytes_via_walk.  Same KPTI-bounce discipline as
  // _dispatch_taskinfo_scratch above -- keeps sys_mountinfo_body's
  // contract ("kernel_dst is a kernel VA") unchanged and confines the
  // trust-boundary walk to the dispatch layer.
  //
  // Sizing: exactly MOUNT_INFO_RECORD_BYTES (32).  A dedicated scratch
  // rather than reusing _dispatch_taskinfo_scratch because the two
  // syscalls have unrelated concurrency lifetimes; overloading one
  // scratch across syscalls costs one witness read of the wrong shape
  // the moment a second-caller lands (e.g. a status daemon calling
  // sys_mountinfo while a shell reads sys_taskinfo).
  //
  // Concurrency: single-flow at R57.M4 (matches the sibling scratches
  // above).  Multi-task /bin/mount -- or a service dumping the table
  // from a background thread while an operator reads it -- moves this
  // into a TCB-side scratch alongside the read/write/dmesg/pdxfs/
  // taskinfo counterparts.
  //
  // @align(8) matches the body's u64-store loop discipline; a bare
  // [u8; 32] without the annotation would still occupy 32 B at 8 B
  // alignment in paideia-as .bss but the annotation is documentation.
  pub let mut _dispatch_mountinfo_scratch : [u8; 32] = uninit @align(8)

  // ==========================================================================
  // R20b.M6-002 (#1565): dispatch-layer cap-slot -> endpoint_id translator.
  //
  // The 4 IPC-family dispatch shims (sysnos 40 sys_ipc_recv, 41 sys_ipc_reply,
  // 42 sys_ipc_send) landed at R20b.M3-001..003 as scaffolding — they treated
  // a0 as a raw endpoint_id because userspace had not yet been seeded any
  // KIND_IPC_ENDPOINT caps (R20b.M4 landed loader_seed_caps). Now that real
  // userspace tasks receive endpoint caps via the loader (M4-002 / M6-001)
  // and via sys_svc_lookup (M3-003), a0 arriving in the shim is a CAP SLOT,
  // not an endpoint id. This helper is the shared cap-lookup + rights-gate
  // that translates cap_slot -> endpoint_id (or a negative errno) before the
  // shim falls into user_ptr_ok / body dispatch.
  //
  // Sysno 43 sys_svc_lookup is NOT wired through this helper — that syscall
  // CREATES a cap into a free slot (see sys_svc_lookup.pdx L194 justification
  // "mint a KIND_IPC_ENDPOINT cap in a free cap_table slot"); its a0 arg is
  // a user-VA name pointer, not a cap slot.
  //
  // Naming/layout constants (mirror src/kernel/core/cap/kind_endpoint.pdx and
  // cap/verify.pdx — see cap/table.pdx §Capability struct for the 24-byte
  // descriptor layout that cap_mint_write / cap_verify_read pin):
  //   [cap_table + slot*24 + 0]  = kind (u64)         — must == 5 (KIND_IPC_ENDPOINT)
  //   [cap_table + slot*24 + 8]  = rights (u64)       — (rights & required) == required
  //   [cap_table + slot*24 + 16] = target_ptr (u64)   — low 16 bits = endpoint_id
  //                                                     (KIND_IPC_ENDPOINT tail encoding
  //                                                     per kind_endpoint.pdx §endpoint_tail_encode)
  //
  // Errno sentinels — Linux-style negative-errno u64s so a caller can
  // `cmp rax, 0; jl` to sign-test either error class in one branch (matches
  // the syscall-return convention used by sys_close (EBADF), sys_ipc_recv,
  // etc.).
  //
  //   -EBADF  (0xFFFFFFFFFFFFFFF7 = -9)  — slot out of range OR kind mismatch
  //   -EACCES (0xFFFFFFFFFFFFFFF3 = -13) — kind OK, rights mask failed
  //
  // Per-task cap_tables (R21+): at R20b there is a single global cap_table
  // (cap/table.pdx — [u64; 768] backing 256 x 24 B descriptors; see the
  // "Per-task cap_table caveat" block in loader/seed_caps.pdx L55-63). When
  // per-task cap_tables land (design/capabilities/per-task-cspace.md) this
  // helper grows a `_current_tcb.cap_table` deref up front and every other
  // caller of cap_mint_write / cap_verify_read follows suit — the slot-arith
  // + kind/rights check body stays identical.
  //
  // Concurrency: single-threaded phase-1 (matches svc_broker.pdx and the M2
  // endpoint_table). Reads only — no writes; concurrent minters (sys_svc_lookup
  // body) update slots one at a time in the M3-003 free-scan pattern. SMP-safe
  // rights checking arrives with the same round that adds per-row locking.
  //
  // Constants recorded here for cross-reference; not used as symbols in the
  // helper body (paideia-as pattern per sys_ipc_recv.pdx §Result-code sentinels).
  //
  //   DISPATCH_KIND_IPC_ENDPOINT = 5
  //   DISPATCH_R_IPC_READ        = 0x01
  //   DISPATCH_R_IPC_WRITE       = 0x02
  //   DISPATCH_R_IPC_INVOKE      = 0x08
  //   DISPATCH_R_IPC_ALL         = 0x0B
  //   Required for sys_ipc_recv  = R_IPC_READ  | R_IPC_INVOKE = 0x09
  //   Required for sys_ipc_send  = R_IPC_WRITE | R_IPC_INVOKE = 0x0A
  //   Required for sys_ipc_reply = R_IPC_WRITE | R_IPC_INVOKE = 0x0A
  // ==========================================================================

  pub let DISPATCH_KIND_IPC_ENDPOINT   : u64 = 5
  pub let DISPATCH_R_IPC_READ          : u64 = 0x01
  pub let DISPATCH_R_IPC_WRITE         : u64 = 0x02
  pub let DISPATCH_R_IPC_INVOKE        : u64 = 0x08
  pub let DISPATCH_R_IPC_ALL           : u64 = 0x0B
  pub let DISPATCH_IPC_RECV_REQUIRED   : u64 = 0x09   // R_IPC_READ  | R_IPC_INVOKE
  pub let DISPATCH_IPC_SEND_REQUIRED   : u64 = 0x0A   // R_IPC_WRITE | R_IPC_INVOKE
  pub let DISPATCH_IPC_REPLY_REQUIRED  : u64 = 0x0A   // R_IPC_WRITE | R_IPC_INVOKE
  pub let DISPATCH_ERR_EBADF           : u64 = 0xFFFFFFFFFFFFFFF7
  pub let DISPATCH_ERR_EACCES          : u64 = 0xFFFFFFFFFFFFFFF3

  // ipc_slot_to_endpoint(cap_slot: u64, required_rights: u64) -> u64
  //
  // SysV ABI: rdi = cap_slot, rsi = required_rights
  //        -> rax = endpoint_id (>= 0, < ENDPOINT_ID_MAX == 128)
  //           OR   0xFFFFFFFFFFFFFFF7 (-EBADF)  on slot out-of-range / kind mismatch
  //           OR   0xFFFFFFFFFFFFFFF3 (-EACCES) on rights mask failure
  //
  // Called by dispatch_ipc_recv / dispatch_ipc_send / dispatch_ipc_reply's
  // Gate-0 (cap-slot lookup) block. Bounds-first so a caller with `cap_slot ==
  // 256` (or larger) never dereferences past the [u64; 768] table backing.
  // Kind-check before rights-check so a stale free slot (kind == KIND_NULL == 0)
  // returns -EBADF (matches POSIX "fd not open" semantics for the sibling
  // fd_get / sys_close path). Rights mask uses `(rights & required) == required`
  // so a superset (e.g. R_IPC_ALL for a required R_IPC_READ|R_IPC_INVOKE) still
  // passes.
  //
  // Register plan (leaf function, no nested call):
  //   rdi / rsi = args (consumed inline; no callee-save writes)
  //   rax       = accumulator (descriptor ptr, then reused for return)
  //   rcx       = temp for descriptor field loads
  //   r8, r9    = slot-arithmetic temps (same shift-add pattern as
  //               cap/verify.pdx L67-71 + cap/mint.pdx L104-108 to avoid imul)
  //
  // Effects / capabilities: !{mem} @{cap} — reads cap_table only; @{cap} matches
  // cap_verify_read / cap_mint_write's own posture (design/capabilities/*.md).
  pub let ipc_slot_to_endpoint : (u64, u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) (required_rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R20b.M6-002 (#1565): translate cap_slot -> endpoint_id via cap_table, gate on kind == KIND_IPC_ENDPOINT (5) and (rights & required) == required. Bounds-check slot < 256 (cap_table has 256 slots x 24 B) as the first gate so an out-of-range slot returns -EBADF before any descriptor read. Slot-arithmetic pattern matches cap/verify.pdx §cap_verify_read L67-71 + cap/mint.pdx §cap_mint_write L104-108 (slot*8 + slot*16 = slot*24, no imul). Descriptor field offsets match cap_mint_write's write order: kind@+0, rights@+8, target_ptr@+16. Kind check FIRST so a stale free slot (kind == KIND_NULL == 0) maps to -EBADF (matches POSIX 'fd not open' shape of sys_close's EBADF); rights check second so kind-mismatch and rights-mismatch produce distinct errno classes. endpoint_id extraction masks target_ptr low 16 bits per KIND_IPC_ENDPOINT tail encoding (cap/kind_endpoint.pdx §endpoint_tail_encode — endpoint_id in bits [15:0]). Return codes chosen to be sign-testable (bit 63 set) so callers use `cmp rax, 0; jl err` to branch on any error class in one instruction. Leaf function; no callee-save writes (rax/rcx/r8/r9 all caller-save). Per-task cap_tables (R21+) will grow a _current_tcb.cap_table deref at the head; body stays byte-identical.",
      block: {
        // ---- Gate 1: slot < 256 ----
        cmp rdi, 256;
        jae ipc_slot_ebadf;

        // ---- Descriptor address: cap_table + slot*24 ----
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;                         // r8 = slot * 8
        mov r9, rdi;
        shl r9, 4;                         // r9 = slot * 16
        add r8, r9;                        // r8 = slot * 24
        add rax, r8;                       // rax = &cap_table[slot]

        // ---- Gate 2: kind == KIND_IPC_ENDPOINT (5) ----
        mov rcx, [rax + 0];
        cmp rcx, 5;
        jne ipc_slot_ebadf;

        // ---- Gate 3: (rights & required) == required ----
        mov rcx, [rax + 8];
        and rcx, rsi;
        cmp rcx, rsi;
        jne ipc_slot_eacces;

        // ---- Extract endpoint_id from target_ptr low 16 bits ----
        mov rax, [rax + 16];
        and rax, 0xFFFF;
        ret;

        ipc_slot_ebadf:
          mov rax, 0xFFFFFFFFFFFFFFF7;     // -EBADF
          ret;
        ipc_slot_eacces:
          mov rax, 0xFFFFFFFFFFFFFFF3;     // -EACCES
          ret
      }
    }

  // syscall_dispatch(rdi=sysno, rsi=a0, rdx=a1, rcx=a2, r8=a3) -> u64 in rax.
  // Widened !{mem, sysreg} @{cap, sched}: reachable handlers touch cap/sched/uart paths.
  pub let syscall_dispatch : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (sysno: u64) (a0: u64) (a1: u64) (a2: u64) (a3: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R17-M0-668 (#668) + R17-M0-671 (#671) + R17-M0-724-D2/D5a (#724): SC+ freeze alignment — wire kernel dispatch to real bodies. Linear cmp/je over IDs per R13 preflight §C. IDs {0,2,3,32,39,56,60,61} wired to sys_*_body handlers or inline dispatch. ID 1 (write) uses fast-path for fd∈{1,2}→UART, else sys_write_body. ID 59 (execve) now dispatches to sys_execve_shim (path→image copy-in per #671) which does user_ptr_ok/copy path/vfs_open/page-loop vfs_read/ELF magic/vfs_close, then calls sys_execve_body. ID 60 (exit) now performs real termination (#724 D2): sys_exit_body (marks ZOMBIE, wakes parent, runq_enqueue's woken parent per D5b) → runq_dequeue(current) → sched_pick_next_r15 → sched_switch_r15(next); never returns to the exiting task. ID 61 (wait4) now performs real blocking (#724 D5a): sys_wait_body returns rax=0 when children exist but none are zombies; dispatcher branches to a sched_block invocation, and on resume reads wait_result_{pid,status} from _current_tcb slab (@1704, @1708). ID 4 (cap_invoke) and ID 12 (debug_puts) unchanged. Effects widened to (mem, sysreg) and capabilities to (cap, sched) to cover the union of reachable handlers (sched_block requires @{sched}).",
      block: {
        // Bounds check — widened from 61 to 69 in #1582 for the four new
        // sysnos (66 clock_read_ns, 67 sched_setaffinity, 68 sched_getaffinity,
        // 69 reserve_lpe_class); widened from 69 to 70 in R42-PREP-007
        // (#1629) for sysno 70 (pdxfs_txn_open); widened from 70 to 72 in
        // R42-PREP-008 (#1630) for sysnos 71 (pdxfs_open) and 72
        // (pdxfs_dir_readnext); widened from 72 to 74 in R51.M8-001
        // (#1675) for sysno 74 (blkdev_cap_request) — sysno 73 stays
        // deliberately unclaimed, reserved per #1630's own comment for
        // a future sys_pdxfs_file_close; widened from 74 to 76 in
        // R53.M2-001 (#1736) for sysnos 75 (sys_mount) and 76
        // (sys_umount).  Note: design/tooling/volume-lifecycle-
        // mechanism.md §10.1 originally proposed 73/74 for mount/umount
        // but sysno 74 was claimed by #1675 (blkdev_cap_request) after
        // that design landed; per §10.1's own "IDs are negotiable"
        // clause the pair shifted to 75/76 rather than displacing the
        // existing entry.  Sibling issues #1737 (sys_mount body) and
        // #1738 (sys_umount body) consume these ordinals; softarch
        // tools that hardcoded SYS_MOUNT=73 / SYS_UMOUNT=74 must
        // realign to 75/76.  Widened from 76 to 82 in R56.M3-001
        // (#1790) for the VFS metadata block sysnos 77 (sys_stat),
        // 78 (sys_getdents), 79 (sys_mkdir), 80 (sys_rmdir), 81
        // (sys_unlink), 82 (sys_rename) — see
        // design/kernel/vfs-metadata-syscalls.md §Table-widening
        // posture for the accompanying stubs-first landing plan
        // (bodies land in #1791..#1795, boot smoke in #1795); each
        // new dispatch label returns -ENOSYS as a forward-declaration
        // stub matching the R53.M2-001 mount/umount pattern.  The
        // switch chain below still has `cmp rdi, 61; je dispatch_wait4`
        // for wait4, so tools/verify-syscall-dispatch.sh's grep for
        // "cmp.*0x3d" continues to match without a fingerprint rewrite.
        //   Bounds widened from 82 to 83 in R57.M4-003 (paideia-os
        //   #1799) for sysno 83 (sys_taskinfo).  The R56.M3-001 VFS
        //   metadata block claims 77..82 contiguously; sysno 83 is the
        //   first free slot above that block, so /bin/ps' introspection
        //   syscall lands there without displacing any prior assignment.
        //   Bounds widened from 83 to 84 in R57.M4-004 (paideia-os
        //   #1800) for sysno 84 (sys_mountinfo).  Sits contiguously
        //   above sys_taskinfo (83); /bin/mount's list path lands
        //   here, while its args path (`mount <src> <mnt> <fs>`)
        //   reuses the existing sys_mount (sysno 75 per R53.M2-001).
        cmp rdi, 84;
        ja dispatch_enosys;

        cmp rdi, 0;
        je dispatch_read;
        cmp rdi, 1;
        je dispatch_write;
        cmp rdi, 2;
        je dispatch_open;
        cmp rdi, 3;
        je dispatch_close;
        cmp rdi, 4;
        je dispatch_cap_invoke;
        cmp rdi, 12;
        je dispatch_debug_puts;
        // logging-m9-002 (#709): sysno 13 = SYS_DMESG. Kept low so the
        // existing `cmp rdi, 61` bounds check + tools/verify-syscall-
        // dispatch.sh's TOTAL_CHECKS=15 fingerprint stay untouched.
        cmp rdi, 13;
        je dispatch_dmesg;
        // R20b.M3-001 (#1558): sysno 40 = SYS_IPC_RECV. Blocking receive on
        // an IPC endpoint per design/ipc/userspace-server-substrate.md §5.1.
        // Bounds check `cmp rdi, 61` already accepts 40 (40 < 61); no need
        // to widen. Placed between sysno 13 and sysno 32 to preserve the
        // ascending-sysno order the switch-chain follows.
        cmp rdi, 40;
        je dispatch_ipc_recv;
        // R20b.M3-002 (#1559): sysno 41 = SYS_IPC_REPLY, sysno 42 = SYS_IPC_SEND.
        // Placed contiguously with sysno 40 for logical grouping (all three
        // IPC syscalls share the (id, hdr_va, payload_va, len) SysV shape
        // and the identical user_ptr_ok gate pair). Reply's body is a bit-7
        // pre-check + tail into send's body; both live under the same
        // bounds check (41, 42 < 61).
        cmp rdi, 41;
        je dispatch_ipc_reply;
        cmp rdi, 42;
        je dispatch_ipc_send;
        // R20b.M3-003 (#1560): sysno 43 = SYS_SVC_LOOKUP. Placed
        // contiguously with sysnos 40..42 to complete the IPC syscall
        // block. Body signature is distinct from the send/recv/reply
        // trio ((user_name_va, name_len) vs. (cap_slot, hdr_va,
        // payload_va, len)) so the dispatch shim has its own SysV-arg
        // marshal (rsi=user_name_va, rdx=name_len -> body wants
        // rdi=user_name_va, rsi=name_len). Bounds check `cmp rdi, 61`
        // already accepts 43 (43 < 61); no need to widen.
        cmp rdi, 43;
        je dispatch_svc_lookup;
        cmp rdi, 32;
        je dispatch_dup2;
        cmp rdi, 39;
        je dispatch_getpid;
        cmp rdi, 56;
        je dispatch_fork;
        cmp rdi, 59;
        je dispatch_execve;
        cmp rdi, 60;
        je dispatch_exit;
        cmp rdi, 61;
        je dispatch_wait4;
        // #1582 part A: sysno 66 = SYS_CLOCK_READ_NS. No arguments — the body
        // returns u64 nanoseconds since boot via hpet_now_ns. Placed above the
        // affinity/reserve block so an early caller (e.g. the AML executor
        // wall-clock probe) hits it before any scheduler-mutating sysno in
        // the switch order.
        cmp rdi, 66;
        je dispatch_clock_read_ns;
        // #1582 part B: sysnos 67/68/69 = SYS_SCHED_SETAFFINITY /
        // SYS_SCHED_GETAFFINITY / SYS_RESERVE_LPE_CLASS. Grouped contiguously
        // — the three share one TCB field (TCB_OFF_CPU_MASK) and one global
        // (_reserved_lpe_task_pid) declared in sched_affinity.pdx.
        cmp rdi, 67;
        je dispatch_sched_setaffinity;
        cmp rdi, 68;
        je dispatch_sched_getaffinity;
        cmp rdi, 69;
        je dispatch_reserve_lpe_class;
        // R42-PREP-007 (#1629): sysno 70 = SYS_PDXFS_TXN_OPEN. Positioned
        // contiguously with the #1582 block since the bounds check just
        // widened to accept 70; a future PdxFS syscall (sys_pdxfs_txn_close
        // for revoke, sys_pdxfs_file_open for the file-side counterpart)
        // will claim 71+ adjacently.  4-arg dispatch shim (parent_slot,
        // mode, txn_id, wal_off) -- see sys_pdxfs_txn_open.pdx §Contract.
        cmp rdi, 70;
        je dispatch_pdxfs_txn_open;
        // R42-PREP-008 (#1630): sysnos 71 = SYS_PDXFS_OPEN + 72 =
        // SYS_PDXFS_DIR_READNEXT.  The userspace directory-iterator
        // pair unblocks ls.M2 (and cp -r walk / rm -r walk / shell
        // tab completion) per design/tooling/r49-r50-plan.md §5.
        // Placed contiguously with 70 (the sibling PdxFS constructor)
        // so a future round adding sys_pdxfs_file_close claims 73.
        cmp rdi, 71;
        je dispatch_pdxfs_open;
        cmp rdi, 72;
        je dispatch_pdxfs_dir_readnext;
        // R51.M8-001 (#1675): sysno 74 = SYS_BLKDEV_CAP_REQUEST.  Note
        // 73 is intentionally skipped -- reserved (per #1630's own
        // comment) for a future sys_pdxfs_file_close so that syscall
        // stays adjacent to its sibling pdxfs_open/pdxfs_dir_readnext
        // pair rather than being pushed further down the number line.
        cmp rdi, 74;
        je dispatch_blkdev_cap_request;
        // R53.M2-001 (#1736): sysnos 75 = SYS_MOUNT, 76 = SYS_UMOUNT.
        // Design (design/tooling/volume-lifecycle-mechanism.md §10.1)
        // proposed 73/74 for this pair; sysno 74 was taken by #1675
        // (blkdev_cap_request) in the interval between the design
        // landing and this landing, so per §10.1's own "IDs are
        // negotiable" clause the pair shifted to 75/76 to avoid
        // displacing the existing entry.  Sibling body files land in
        // #1737 (sys_mount) and #1738 (sys_umount); until they do, the
        // dispatch labels below return -ENOSYS as forward-declaration
        // stubs so this bounds-widen can land ahead of the bodies
        // without introducing an undefined-symbol link error against
        // sys_mount_body / sys_umount_body.  When the sibling bodies
        // land they replace the stub bodies with real user_ptr_ok +
        // KPTI-bounce + `call sys_mount_body` / `call sys_umount_body`
        // shims (see dispatch_open / dispatch_blkdev_cap_request for
        // the shim pattern to follow).
        cmp rdi, 75;
        je dispatch_mount;
        cmp rdi, 76;
        je dispatch_umount;
        // R56.M3-001 (#1790): sysnos 77..82 = VFS metadata syscall
        // block — sys_stat (77), sys_getdents (78), sys_mkdir (79),
        // sys_rmdir (80), sys_unlink (81), sys_rename (82).  Placed
        // contiguously above the mount/umount pair since the bounds
        // check widened to accept 82 in the same edit; a future round
        // adding sys_stat64 / sys_symlink / sys_readlink can claim
        // 83+ adjacently.  Table-widening-only landing (schema in
        // design/kernel/vfs-metadata-syscalls.md); real bodies land
        // in #1791..#1795 and #1795 exercises them under boot smoke.
        // Until the bodies land, each dispatch label below returns
        // -ENOSYS as a forward-declaration stub — same discipline
        // used at R53.M2-001 for dispatch_mount / dispatch_umount so
        // this bounds-widen can land ahead of the bodies without
        // introducing an undefined-symbol link error against
        // sys_{stat,getdents,mkdir,rmdir,unlink,rename}_body.
        cmp rdi, 77;
        je dispatch_stat;
        cmp rdi, 78;
        je dispatch_getdents;
        cmp rdi, 79;
        je dispatch_mkdir;
        cmp rdi, 80;
        je dispatch_rmdir;
        cmp rdi, 81;
        je dispatch_unlink;
        cmp rdi, 82;
        je dispatch_rename;
        // R57.M4-003 (paideia-os #1799): sysno 83 = SYS_TASKINFO.
        // Task-pool introspection for /bin/ps.  Placed above the
        // R56.M3-001 VFS metadata block (77..82) at the first free
        // slot; the bounds check above was widened from 82 to 83 in
        // the same edit so a ring-3 caller passing sysno 83 does not
        // fall through to dispatch_enosys via the `ja` guard.
        cmp rdi, 83;
        je dispatch_taskinfo;
        // R57.M4-004 (paideia-os #1800): sysno 84 = SYS_MOUNTINFO.
        // Mount-table introspection for /bin/mount's no-args listing
        // path.  Placed contiguously above sys_taskinfo (83) so the
        // "R57 introspection block" (83, 84) stays adjacent; a future
        // syscall in the same family (e.g. sys_fdinfo for /proc/*/fd
        // shape) claims 85+ without displacing any prior assignment.
        cmp rdi, 84;
        je dispatch_mountinfo;
        jmp dispatch_enosys;

        // R16-M3-KPTI-sweep (#738 #739): route the sys_read path via a
        // per-syscall bounce buffer so that BOTH tmpfs_read (§4.10 rep_movsb
        // dst = user VA under kernel CR3, #738) and tty_read_try (§copy loop
        // mov_b [r9+0], rax to user VA under kernel CR3, #739) transitively
        // land bytes into a kernel scratch first. The bounce buffer's user
        // copy back happens post sys_read_body via user_write_bytes_via_walk.
        //
        // Prior code passed rdx (raw user buf VA) straight through to
        // sys_read_body → vfs_read → {tmpfs_read | tty_read → tty_read_try}
        // whose byte-stores at dst = user_va executed under kernel CR3. Both
        // sites are latent today (no user program calls sys_read at R17.M0)
        // but would silently corrupt the moment the shell grows an fd-based
        // read call. Same defect class as #724 D4 / #730 D10c / #730 D10d /
        // #737, symmetric to #734 write path.
        //
        // Fix at dispatch (Option B): sys_read_body / vfs_read / tmpfs_read
        // / tty_read_try keep their existing "buf is kernel VA" contracts
        // unchanged (sys_read_witness at kernel_main.pdx:4278 exercises
        // sys_read_body with a KERNEL VA buf, tty_vops_witness at :5589
        // exercises tty_read with a KERNEL VA stack buf — both would break
        // if the bodies started walking user PML4s). This layer bridges.
        //
        // Length cap: DISPATCH_IO_MAX = 4096, matching tmpfs single-page
        // read ceiling and the write path's cap. Short-read semantics are
        // POSIX-legal; sys_read_body's fd-offset-advance uses the returned
        // bytes_read directly so the fd_table offset is correct even if the
        // user requested more.
        //
        // Error taxonomy: sys_read_body returns bytes_read in [0, len] on
        // success (0 = EOF), 0xFFFFFFFFFFFFFFF7 (-EBADF) on invalid fd,
        // 0xFFFFFFFFFFFFFFFB (-EIO) on vfs_read sentinel. We copy back only
        // on rax in [1, DISPATCH_IO_MAX]; rax == 0 means EOF (nothing to
        // copy) and rax > DISPATCH_IO_MAX means an errno (pass through).
        // On walker failure during writeback → -EFAULT.
        //
        // Alignment: entry rsp%16==8. Push r15 (save user buf VA) + push r14
        // (save capped len) = 16 bytes → rsp%16==8. Add `sub rsp, 8` for
        // the sys_read_body call to align.
        dispatch_read:
        push r15;                             // save user buf VA (across body + walk)
        push r14;                             // save capped len (across body + walk)

        // Cap len at DISPATCH_IO_MAX.
        mov rax, 4096;
        cmp rcx, rax;
        jbe dispatch_read_len_ok;
        mov rcx, rax;
      dispatch_read_len_ok:

        mov r15, rdx;                         // r15 = orig user buf VA
        mov r14, rcx;                         // r14 = capped len

        // #741 Layer 1: user_ptr_ok(user_buf, capped_len) — reject any
        // buf in the kernel half BEFORE issuing sys_read_body. Prior to
        // this gate a ring-3 caller could `read(fd, 0xFFFF800000105000,
        // N)`; the walker resolved KPTI-mirror PML4[256] to the trampoline
        // data page and wrote attacker bytes over saved_user_rsp /
        // saved_user_CR3 / kernel_pml4_pa — full ring-3 → ring-0
        // corruption primitive (see design r16-m3-741-user-ptr-ok-defense-in-depth.md).
        // Gating on CAPPED len matches what user_write_bytes_via_walk will
        // actually touch (POSIX short-read semantics allow len > 4096;
        // callers re-issue for the remainder). Alignment: rsp%16 == 8
        // after the two pushes above; single `push rsi` (fd) is both the
        // fd-preserve slot and the alignment pad (rsp%16 → 0 for the
        // nested call).
        push rsi;                             // save fd across user_ptr_ok call
        mov rdi, r15;                         // arg0 = user buf VA
        mov rsi, r14;                         // arg1 = capped len
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        pop rsi;                              // restore fd
        cmp rax, 0;
        jne dispatch_read_efault;

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd restored above by pop
        lea rdx, [rip + _dispatch_read_buf_scratch]; // rdx = kernel scratch (not user buf)
        mov rcx, r14;                         // restore rcx = capped len
                                              //   (was clobbered by user_ptr_ok's KERNEL_VMA_BASE movabs)
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_read_body;
        add rsp, 8;

        // rax = bytes_read [0, cap] or errno (huge unsigned). Skip the
        // writeback if rax == 0 (EOF: nothing to copy) or rax > cap
        // (errno: don't touch user buf).
        cmp rax, 0;
        je dispatch_read_done;                // EOF fast-path
        cmp rax, r14;
        ja dispatch_read_done;                // errno passthrough

        // 1 <= rax <= cap: copy scratch[0..rax] back to user buf via walk.
        // Save bytes_read across the walk call.
        //
        // Alignment: at this point rsp%16==8 (post add rsp,8 above). Single
        // `push rax` → %16==0 which is exactly what the SysV C ABI requires
        // for a nested call (the call itself pushes RA and the callee sees
        // rsp%16==8 at entry). No additional sub rsp,8 pad needed.
        push rax;                             // save bytes_read for return + align
        mov rdi, r15;                         // arg0 = user buf VA
        lea rsi, [rip + _dispatch_read_buf_scratch]; // arg1 = kernel scratch
        mov rdx, rax;                         // arg2 = bytes_read
        call user_write_bytes_via_walk;       // rax = 0 or -EFAULT
        mov r8, rax;                          // stash walk result
        pop rax;                              // restore bytes_read (%16==8 again)

        cmp r8, 0;
        jne dispatch_read_efault;             // walker failed → -EFAULT

        dispatch_read_done:
        pop r14;
        pop r15;
        ret;

        dispatch_read_efault:
        pop r14;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        dispatch_write:
        // #541: user_ptr_ok(buf=rdx, len=rcx) — fault-check before ANY fd
        // path (UART fast-path or sys_write_body). Preserves rsi (fd) and
        // rcx (len) discipline: we need rdx→rdi and rcx→rsi for the call,
        // then restore. Callee (PtrCheck) clobbers only rax; caller regs
        // rsi/rcx/rdx must be re-established before falling through.
        push rsi;
        push rcx;
        push rdx;
        mov rdi, rdx;                         // arg0 = buf
        mov rsi, rcx;                         // arg1 = len
        call user_ptr_ok;
        pop rdx;
        pop rcx;
        pop rsi;
        cmp rax, 0;
        jne dispatch_write_efault;

        // Fast-path: fd 1 or 2 → UART (preserves stdout/stderr until init opens TTY fds)
        cmp rsi, 1;
        je dispatch_write_uart;
        cmp rsi, 2;
        je dispatch_write_uart;

        // R16-M3-KPTI-sweep (#734): real body path for fd >= 3.
        //
        // Prior code passed rdx (raw user buf VA) straight through to
        // sys_write_body → vfs_write → tmpfs_write, whose rep_movsb src =
        // rsi = user_va executed under kernel CR3 — same defect class as
        // #724 D4 / #730 D10c / #730 D10d / #737. Latent because no user
        // code exercises fd>=3 writes at R17.M0 (init uses only fd 1/2 via
        // UART fast path + sys_debug_puts). Would silently corrupt file
        // contents the moment a user program grows a real write() call.
        //
        // Fix: cap len at DISPATCH_IO_MAX (4096 — matches tmpfs single-page
        // ceiling, so no legal write is truncated), walk-copy buf bytes
        // into _dispatch_write_buf_scratch via user_read_bytes_via_walk,
        // then pass the scratch VA (not the user VA) to sys_write_body.
        // sys_write_body → vfs_write → tmpfs_write's rep_movsb src now
        // reads from the kernel scratch (safe under kernel CR3), and its
        // dst = allocated page (kernel VA, safe).
        //
        // Length cap semantics: POSIX permits short writes (write may
        // accept fewer bytes than requested and return the accepted count).
        // sys_write_body's own advance-offset logic uses `rax` (bytes
        // written), so a cap at 4096 correctly advances by up to 4096 —
        // user re-issues write for the remainder. At R17.M0 no caller
        // requests >4096.
        //
        // Alignment: entry rsp%16==8 (SysV call from syscall_entry). We
        // need to preserve rsi (fd) and the capped len across the walk
        // call; user_ptr_ok's push/pop discipline restored them already so
        // we start clean. Push rsi + push rcx pair (16 bytes) keeps
        // rsp%16==8 for the nested walk call — WRONG, walk needs %16==0.
        // Use push rsi + push rcx + sub rsp, 8 = 24 bytes → rsp%16==0. Pop
        // in reverse plus add rsp, 8 to restore.
        push rsi;                             // save fd across walk + body
        push rcx;                             // save orig len (for cap)
        sub rsp, 8;                           // align rsp%16==0 for nested call

        // Cap len at DISPATCH_IO_MAX (4096).
        mov rax, 4096;
        cmp rcx, rax;
        jbe dispatch_write_len_ok;
        mov rcx, rax;
      dispatch_write_len_ok:
        // Overwrite the saved orig-len slot with the capped len so it
        // matches what we pass to sys_write_body.
        mov [rsp + 8], rcx;

        // user_read_bytes_via_walk(dst=_dispatch_write_buf_scratch, user=buf, len=capped)
        lea rdi, [rip + _dispatch_write_buf_scratch];
        mov rsi, rdx;                         // user_va
        mov rdx, rcx;                         // len
        call user_read_bytes_via_walk;        // rax = 0 or -EFAULT

        add rsp, 8;                           // undo alignment pad
        pop rcx;                              // restore capped len
        pop rsi;                              // restore fd

        cmp rax, 0;
        jne dispatch_write_efault;            // walker failed → -EFAULT (matches -EFAULT convention)

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd, rcx=len (capped) already restored
        lea rdx, [rip + _dispatch_write_buf_scratch]; // rdx = buf (kernel scratch)
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_write_body;
        add rsp, 8;
        ret;

        dispatch_write_uart:
        // R17-M0-730 D10c (#730): route through user_puts_via_walk instead
        // of a raw `mov rax, [rdi]` byte loop. Under strict-KPTI the
        // syscall_entry trampoline flips CR3 to _kernel_pml4_pa (boot PML4)
        // before dispatch runs. The boot PML4's low identity map hits
        // WHATEVER byte sits at PHYSICAL address = user_va, which is NOT
        // the frame the user PML4 mapped user_va to. Same root cause as
        // #724 D4 (sys_debug_puts silent-NUL) — see design
        // r17-m0-724-d4-init-post-iretq-gp.md and
        // r17-m0-730-d10-execve-complete.md §D10c.
        //
        // rsi=fd (unused past this point), rdx=buf (user VA), rcx=len.
        // user_puts_via_walk(rdi=user_va, rsi=len) walks _current_tcb's
        // user_pml4_va per byte and reads via the higher-half identity
        // map, then calls uart_putc. Returns void; we echo len as rax.
        //
        // Alignment: entry rsp %16 == 8 (SysV; dispatch was `call`ed and
        // syscall_dispatch's own `call syscall_dispatch` from syscall_entry
        // left it that way). `push rcx` moves to %16 == 0 — correct for
        // the nested call. `pop rax` restores to %16 == 8 for `ret`.
        push rcx;                             // save len for return + align
        mov rdi, rdx;                         // arg0 = user_va (buf)
        mov rsi, rcx;                         // arg1 = len
        call user_puts_via_walk;              // walks user PML4 + emits
        pop rax;                              // rax = len (echoed)
        ret;

        // #541: EFAULT return — user_ptr_ok rejected buf. Same return
        // convention as the SysV syscall path: rax = -EFAULT sign-extended.
        dispatch_write_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT = -14
        ret;

        // R16-M3-KPTI-sweep (#733): route the user path VA through a
        // per-byte 4-level PML4 walk into _dispatch_open_path_scratch, then
        // pass the kernel-side scratch to sys_open_body. Prior code passed
        // rsi (raw user VA) straight through to sys_open_body → vfs_open →
        // path_resolve, whose byte-loads via `mov_b rax, [r12]` (path.pdx
        // §regular_lookup) executed under kernel CR3 — the boot PML4's low
        // identity map hits whatever kernel byte sits at PA = user_va, NOT
        // the frame the user PML4 maps user_va to. init's /dev/tty0 path at
        // user VA 0x400000+ typically read the kernel .bss zero at PA
        // 0x400000+, so byte 0 was NUL and vfs_open failed silently with
        // -ENOENT — init's stdio setup (open + 3× dup2 + close) collapsed
        // silently because init doesn't check the return.
        //
        // Post-fix, the walk-copy translates user VA → phys → higher-half
        // identity via the user PML4 (per byte), lands the NUL-terminated
        // path into _dispatch_open_path_scratch, and sys_open_body sees the
        // kernel VA scratch. Same defect-class fix as #737's dispatch_wait4
        // writeback via user_write_u32_via_walk and #730 D10d's
        // sys_execve_shim path copy via user_read_str_via_walk.
        //
        // On walker failure (unmapped page / kernel-half VA / path exceeds
        // 256 without NUL) → -EFAULT, matching sys_execve_shim's fail_efault
        // shape. sys_open's own -ENOENT is reserved for "path resolvable but
        // no such file" — walker failures are a distinct trust-boundary
        // failure.
        //
        // Alignment: dispatch_open was reached via `call syscall_dispatch`
        // from syscall_entry, so rsp%16==8 at entry. SysV C ABI requires
        // rsp%16==0 at the call instruction (callee sees %16==8 at entry).
        // Two 8-byte pushes leave %16==8, so we add sub rsp,8 to reach
        // %16==0 for the nested call. Symmetric add rsp,8 + two pops
        // restore alignment for the subsequent sys_open_body call.
        dispatch_open:
        // #741 Layer 1: user_ptr_ok(path_va, DISPATCH_PATH_MAX) — reject
        // any path_va in the kernel half BEFORE walking. Prior to this
        // gate a ring-3 caller could pass a kernel-half path_va and the
        // walker would happily resolve KPTI-mirror PML4[256] to real
        // kernel memory (see design r16-m3-741-user-ptr-ok-defense-in-depth.md).
        // Alignment: rsp%16 == 8 at entry; 3 pushes (rsi/rdx/rcx) →
        // rsp%16 == 0 for the nested call (matches dispatch_write's
        // 3-push pattern at #541).
        push rsi;                             // save path_va (%16==0)
        push rdx;                             // save flags     (%16==8)
        push rcx;                             // save mode      (%16==0)
        mov rdi, rsi;                         // arg0 = path_va
        mov rsi, 256;                         // arg1 = DISPATCH_PATH_MAX
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        pop rcx;                              // restore mode   (%16==8)
        pop rdx;                              // restore flags  (%16==0)
        pop rsi;                              // restore path_va(%16==8)
        cmp rax, 0;
        jne dispatch_open_efault;

        push rdx;                             // save flags (%16==0)
        push rcx;                             // save mode (%16==8)
        sub rsp, 8;                           // align for call (%16==0)
        mov rdi, rsi;                         // arg0 = path_va (user VA)
        lea rsi, [rip + _dispatch_open_path_scratch]; // arg1 = kernel scratch
        mov rdx, 256;                         // arg2 = cap = DISPATCH_PATH_MAX
        call user_read_str_via_walk;          // rax = strlen or 0 on fault
        add rsp, 8;                           // undo alignment pad (%16==8)
        pop rcx;                              // restore mode (%16==0)
        pop rdx;                              // restore flags (%16==8)
        cmp rax, 0;
        je dispatch_open_efault;              // walker failed → -EFAULT

        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        lea rsi, [rip + _dispatch_open_path_scratch]; // rsi = path (kernel scratch)
        // rdx=flags, rcx=mode already restored
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_open_body;
        add rsp, 8;
        ret;

        dispatch_open_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        dispatch_close:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_close_body;
        add rsp, 8;
        ret;

        dispatch_cap_invoke:
        mov rdi, rsi;
        mov rsi, rdx;
        call cap_invoke;
        ret;

        // #724 D4 fix: dispatch_debug_puts now uses user_puts_via_walk,
        // which does a per-byte 4-level page-table walk on
        // _current_tcb.user_pml4_va to translate user_va→phys and reads
        // the byte via the kernel higher-half identity map before calling
        // uart_putc. The previous `mov rdi, rsi; call uart_puts` passed
        // the user VA directly to uart_puts, which walked memory under
        // kernel CR3 (boot PML4's low identity mapping) — and at user's
        // print buffer PA the kernel .bss zeros were read, so uart_puts
        // saw NUL at byte 0 and returned silently. This is why
        // INIT ENTERED RING3 never made it to wire despite init actually
        // executing the sys_debug_puts syscall (confirmed by QEMU
        // interrupt trace: cpl=3 pc=0x4001fd hit 861 times). See design
        // r17-m0-724-d4-init-post-iretq-gp.md §Root Cause.
        // logging-m9-002 (#709): sys_dmesg(buf, len).
        //
        // SysV args at this point: rsi = user_buf VA, rdx = len. We copy
        // ring bytes into _dispatch_dmesg_buf_scratch via sys_dmesg_body
        // (which delegates to klog_ring_read_tail — a kernel-side ring
        // walker; never touches user memory), then walk them out to the
        // user buffer via user_write_bytes_via_walk. Same
        // KPTI-bounce-buffer pattern as dispatch_read (#738); the ring is
        // kernel .bss so no user_ptr_ok on the source is needed, but the
        // destination buf still requires user_ptr_ok + walker-based
        // writeback so a ring-3 caller cannot corrupt kernel memory (§741
        // defense-in-depth).
        //
        // Length cap: DISPATCH_IO_MAX (4096) — matches sys_read/sys_write
        // and the ring's per-call peek ceiling. Callers requesting more
        // re-issue for the remainder; klog_ring_read_tail is a peek (does
        // NOT advance tail), so successive calls see the same window and
        // may double-report if the user does not track offsets themselves.
        // This matches POSIX dmesg(1) contract: dmesg is idempotent-peek,
        // syslog_read(SYSLOG_ACTION_READ_ALL) semantics.
        //
        // Alignment: entry rsp%16==8 (SysV). Two pushes (r15=user buf,
        // r14=capped len) + push rsi (fd-preserve slot / align pad for
        // user_ptr_ok call) = pattern identical to dispatch_read.
        dispatch_dmesg:
        push r15;                             // save user buf VA
        push r14;                             // save capped len

        // Cap len at DISPATCH_IO_MAX (4096).
        mov rax, 4096;
        cmp rdx, rax;
        jbe dispatch_dmesg_len_ok;
        mov rdx, rax;
      dispatch_dmesg_len_ok:

        mov r15, rsi;                         // r15 = user buf VA (arg0 was buf)
        mov r14, rdx;                         // r14 = capped len

        // #741 Layer 1: user_ptr_ok(user_buf, capped_len).
        sub rsp, 8;                           // align (%16==0 for nested call)
        mov rdi, r15;                         // arg0 = user buf VA
        mov rsi, r14;                         // arg1 = capped len
        call user_ptr_ok;                     // rax = 0 (OK) or 1 (fault)
        add rsp, 8;                           // undo pad (%16==8)
        cmp rax, 0;
        jne dispatch_dmesg_efault;

        // sys_dmesg_body(kernel_dst_ptr=scratch, len=capped_len)
        //   -> rax = bytes copied in [0, capped_len].
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        lea rdi, [rip + _dispatch_dmesg_buf_scratch]; // arg0 = kernel scratch
        mov rsi, r14;                         // arg1 = capped len
        call sys_dmesg_body;
        add rsp, 8;

        // rax = bytes copied in [0, capped_len]. Short-copy (rax < r14) is
        // legal and expected when the ring holds fewer bytes than
        // requested. rax > r14 is impossible (klog_ring_read_tail caps its
        // return at the requested len). rax == 0 fast-paths out (nothing
        // to walk; the syscall returns 0 to indicate "no more ring bytes"
        // — parallel to sys_read EOF).
        cmp rax, 0;
        je dispatch_dmesg_done;

        // Copy scratch[0..bytes_copied] back to user buf via walker.
        // Alignment: rsp%16==8 now; single `push rax` (save bytes_copied)
        // → %16==0 for nested call. `pop rax` restores %16==8.
        push rax;                             // save bytes_copied for return
        mov rdi, r15;                         // arg0 = user buf VA
        lea rsi, [rip + _dispatch_dmesg_buf_scratch]; // arg1 = kernel scratch
        mov rdx, rax;                         // arg2 = bytes_copied
        call user_write_bytes_via_walk;       // rax = 0 (OK) or -EFAULT
        mov r8, rax;                          // stash walker result
        pop rax;                              // restore bytes_copied

        cmp r8, 0;
        jne dispatch_dmesg_efault;            // walker failed → -EFAULT

        dispatch_dmesg_done:
        pop r14;
        pop r15;
        ret;

        dispatch_dmesg_efault:
        pop r14;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT
        ret;

        // R20b.M3-001 (#1558): sysno 40 = sys_ipc_recv(cap_slot, user_hdr_va,
        // user_payload_va, user_payload_max) -> payload_len | -EBADF | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = cap_slot        (treated as raw endpoint_id at R20b.M3-001)
        //   rdx = a1 = user_hdr_va
        //   rcx = a2 = user_payload_va
        //   r8  = a3 = user_payload_max
        //
        // Scaffolding at R20b.M3-001: userspace has not yet been seeded
        // any KIND_IPC_ENDPOINT caps (R20b.M4 lands loader_seed_caps),
        // so no ring-3 caller can name one. The dispatch shim therefore
        // treats a0 as a raw endpoint_id and defers the cap-lookup +
        // rights-gate (R_IPC_READ | R_IPC_INVOKE) to the M3-004
        // syscall-shim wire-up. See src/kernel/core/syscall/handlers/
        // sys_ipc_recv.pdx §Layer split for the full rationale.
        //
        // What this shim DOES gate at R20b.M3-001:
        //   (1) user_ptr_ok(user_hdr_va, 8)                    — reject kernel-half hdr VA
        //   (2) user_ptr_ok(user_payload_va, user_payload_max) — reject kernel-half payload VA
        // Both gates match the #741 defense-in-depth pattern used by
        // dispatch_read / dispatch_write / dispatch_dmesg — the walker's
        // #741 Layer 2 range gate is a last-line-of-defense, not the
        // first. Length 0 is legal (header-only recv); user_ptr_ok's
        // range math handles it correctly (rax=va+0=va, ja check passes
        // iff va < KERNEL_VMA_BASE).
        //
        // Alignment: entry rsp %16 == 8 (SysV). Each pre-body gate uses
        // 4 pushes + `sub rsp, 8` = 40 bytes → %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 4 pops on return. The terminal
        // body call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.
        dispatch_ipc_recv:
        // ---- Gate 0: cap-slot -> endpoint_id (R20b.M6-002 / #1565) ----
        // ipc_slot_to_endpoint(cap_slot=rsi, required=R_IPC_READ | R_IPC_INVOKE = 0x09)
        // rax = endpoint_id on success, or -EBADF (kind mismatch / slot OOR)
        // or -EACCES (rights mask failure). Any negative return (bit 63 set)
        // short-circuits with the errno verbatim — this is the first gate so
        // callers with a bogus cap slot never leak through to user_ptr_ok
        // (matching POSIX: EBADF/EACCES take precedence over EFAULT).
        push rsi;                                 // save cap_slot           (%16==0)
        push rdx;                                 // save user_hdr_va        (%16==8)
        push rcx;                                 // save user_payload_va    (%16==0)
        push r8;                                  // save user_payload_max   (%16==8)
        sub rsp, 8;                               // align                    (%16==0)
        mov rdi, rsi;                             // arg0 = cap_slot
        mov rsi, 0x09;                            // arg1 = R_IPC_READ | R_IPC_INVOKE
        call ipc_slot_to_endpoint;                // rax = endpoint_id or -EBADF/-EACCES
        mov r10, rax;                             // stash result across pops
        add rsp, 8;                               //                          (%16==8)
        pop r8;                                   //                          (%16==0)
        pop rcx;                                  //                          (%16==8)
        pop rdx;                                  //                          (%16==0)
        pop rsi;                                  //                          (%16==8)
        cmp r10, 0;
        jl  dispatch_ipc_recv_cap_err;            // signed<0 = errno
        mov rsi, r10;                             // substitute resolved endpoint_id

        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save endpoint_id        (%16==0)
        push rdx;                                 // save user_hdr_va        (%16==8)
        push rcx;                                 // save user_payload_va    (%16==0)
        push r8;                                  // save user_payload_max   (%16==8)
        sub rsp, 8;                               // align                    (%16==0)
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = BOUNCE_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;                             // stash fault flag (r10 caller-save, not live)
        add rsp, 8;                               //                          (%16==8)
        pop r8;                                   //                          (%16==0)
        pop rcx;                                  //                          (%16==8)
        pop rdx;                                  //                          (%16==0)
        pop rsi;                                  //                          (%16==8)
        cmp r10, 0;
        jne dispatch_ipc_recv_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, user_payload_max) ----
        push rsi;                                 // save cap_slot / id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save user_payload_max
        sub rsp, 8;                               // align
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = user_payload_max
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_recv_efault;

        // ---- Marshal args for sys_ipc_recv_body(id, hdr_va, payload_va, payload_max) ----
        // Current: rsi=id, rdx=user_hdr_va, rcx=user_payload_va, r8=user_payload_max
        // Body:    rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=user_payload_max
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = user_payload_max (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_recv_body;
        add rsp, 8;
        ret;

        dispatch_ipc_recv_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_ipc_recv_cap_err:
        mov rax, r10;                             // propagate -EBADF or -EACCES
        ret;

        // R20b.M3-002 (#1559): sysno 42 = sys_ipc_send(cap_slot, user_hdr_va,
        // user_payload_va, payload_len) -> 0 | 1(EAGAIN) | 2(BAD_ID) |
        // 3(E2BIG) | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = cap_slot        (treated as raw endpoint_id at R20b.M3-002)
        //   rdx = a1 = user_hdr_va
        //   rcx = a2 = user_payload_va
        //   r8  = a3 = payload_len
        //
        // Scaffolding at R20b.M3-002: userspace has not yet been seeded any
        // KIND_IPC_ENDPOINT caps (R20b.M4 lands loader_seed_caps), so no
        // ring-3 caller can name one. The dispatch shim therefore treats
        // a0 as a raw endpoint_id and defers the cap-lookup + rights-gate
        // (R_IPC_WRITE | R_IPC_INVOKE) to the M3-004 syscall-shim wire-up.
        // See src/kernel/core/syscall/handlers/sys_ipc_send.pdx §Layer
        // split — matches the sibling dispatch_ipc_recv (M3-001) discipline.
        //
        // What this shim DOES gate at R20b.M3-002 (per the #741 defense-in-
        // depth pattern used by dispatch_read / dispatch_write /
        // dispatch_dmesg / dispatch_ipc_recv):
        //   (1) user_ptr_ok(user_hdr_va, 8)                — reject kernel-half hdr VA
        //   (2) user_ptr_ok(user_payload_va, payload_len)  — reject kernel-half payload VA
        // Length 0 is legal (header-only send); user_ptr_ok's range math
        // handles it correctly (rax=va+0=va, ja check passes iff
        // va < KERNEL_VMA_BASE).
        //
        // Alignment: entry rsp %16 == 8 (SysV). Each pre-body gate uses
        // 4 pushes + `sub rsp, 8` = 40 bytes → %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 4 pops on return. The terminal
        // body call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket. Identical shape to dispatch_ipc_recv.
        dispatch_ipc_send:
        // ---- Gate 0: cap-slot -> endpoint_id (R20b.M6-002 / #1565) ----
        // ipc_slot_to_endpoint(cap_slot=rsi, required=R_IPC_WRITE | R_IPC_INVOKE = 0x0A)
        // See dispatch_ipc_recv §Gate 0 for the rationale + push/pop discipline.
        push rsi;                                 // save cap_slot           (%16==0)
        push rdx;                                 // save user_hdr_va        (%16==8)
        push rcx;                                 // save user_payload_va    (%16==0)
        push r8;                                  // save payload_len        (%16==8)
        sub rsp, 8;                               // align                    (%16==0)
        mov rdi, rsi;                             // arg0 = cap_slot
        mov rsi, 0x0A;                            // arg1 = R_IPC_WRITE | R_IPC_INVOKE
        call ipc_slot_to_endpoint;                // rax = endpoint_id or -EBADF/-EACCES
        mov r10, rax;                             // stash result across pops
        add rsp, 8;                               //                          (%16==8)
        pop r8;                                   //                          (%16==0)
        pop rcx;                                  //                          (%16==8)
        pop rdx;                                  //                          (%16==0)
        pop rsi;                                  //                          (%16==8)
        cmp r10, 0;
        jl  dispatch_ipc_send_cap_err;            // signed<0 = errno
        mov rsi, r10;                             // substitute resolved endpoint_id

        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save endpoint_id       (%16==0)
        push rdx;                                 // save user_hdr_va       (%16==8)
        push rcx;                                 // save user_payload_va   (%16==0)
        push r8;                                  // save payload_len       (%16==8)
        sub rsp, 8;                               // align                   (%16==0)
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = FRAME_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;                             // stash fault flag (r10 caller-save, not live)
        add rsp, 8;                               //                         (%16==8)
        pop r8;                                   //                         (%16==0)
        pop rcx;                                  //                         (%16==8)
        pop rdx;                                  //                         (%16==0)
        pop rsi;                                  //                         (%16==8)
        cmp r10, 0;
        jne dispatch_ipc_send_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, payload_len) ----
        push rsi;                                 // save cap_slot / id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save payload_len
        sub rsp, 8;                               // align
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = payload_len
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_send_efault;

        // ---- Marshal args for sys_ipc_send_body(id, hdr_va, payload_va, payload_len) ----
        // Current: rsi=id, rdx=user_hdr_va, rcx=user_payload_va, r8=payload_len
        // Body:    rdi=id, rsi=user_hdr_va, rdx=user_payload_va, rcx=payload_len
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = payload_len (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_send_body;
        add rsp, 8;
        ret;

        dispatch_ipc_send_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_ipc_send_cap_err:
        mov rax, r10;                             // propagate -EBADF or -EACCES
        ret;

        // R20b.M3-002 (#1559): sysno 41 = sys_ipc_reply(cap_slot, user_hdr_va,
        // user_payload_va, payload_len) -> 0 | pass-through send rc |
        // -EFAULT | -EINVAL (bit-7 not set).
        //
        // Body semantics per design/ipc/userspace-server-substrate.md §5.1:
        // "alias of sys_ipc_send with bit-7 op flip" — sys_ipc_reply_body
        // pre-checks hdr.op & FRAME_OP_REPLY_BIT (0x80) and rejects with
        // -EINVAL if unset, else tail-calls sys_ipc_send_body. The user_ptr_ok
        // gates + arg marshalling are identical to dispatch_ipc_send, so the
        // shim shape is duplicated with only the terminal call target
        // changed. Keeping the gate-shim inline (vs. factoring a shared
        // helper) matches the existing dispatch layer's discipline — every
        // sysno has its own shim body per the linear cmp/je switch style.
        dispatch_ipc_reply:
        // ---- Gate 0: cap-slot -> endpoint_id (R20b.M6-002 / #1565) ----
        // ipc_slot_to_endpoint(cap_slot=rsi, required=R_IPC_WRITE | R_IPC_INVOKE = 0x0A)
        // Reply's rights requirement matches send (WRITE|INVOKE) — the bit-7
        // FRAME_OP_REPLY_BIT check is a body-side gate, not a cap-side one.
        // See dispatch_ipc_recv §Gate 0 for the shared rationale.
        push rsi;                                 // save cap_slot           (%16==0)
        push rdx;                                 // save user_hdr_va        (%16==8)
        push rcx;                                 // save user_payload_va    (%16==0)
        push r8;                                  // save payload_len        (%16==8)
        sub rsp, 8;                               // align                    (%16==0)
        mov rdi, rsi;                             // arg0 = cap_slot
        mov rsi, 0x0A;                            // arg1 = R_IPC_WRITE | R_IPC_INVOKE
        call ipc_slot_to_endpoint;                // rax = endpoint_id or -EBADF/-EACCES
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jl  dispatch_ipc_reply_cap_err;
        mov rsi, r10;                             // substitute resolved endpoint_id

        // ---- Gate A: user_ptr_ok(user_hdr_va, 8) ----
        push rsi;                                 // save endpoint_id
        push rdx;                                 // save user_hdr_va
        push rcx;                                 // save user_payload_va
        push r8;                                  // save payload_len
        sub rsp, 8;                               // align
        mov rdi, rdx;                             // arg0 = user_hdr_va
        mov rsi, 8;                               // arg1 = FRAME_HEADER_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_reply_efault;

        // ---- Gate B: user_ptr_ok(user_payload_va, payload_len) ----
        push rsi;
        push rdx;
        push rcx;
        push r8;
        sub rsp, 8;
        mov rdi, rcx;                             // arg0 = user_payload_va
        mov rsi, r8;                              // arg1 = payload_len
        call user_ptr_ok;
        mov r10, rax;
        add rsp, 8;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        cmp r10, 0;
        jne dispatch_ipc_reply_efault;

        // ---- Marshal args for sys_ipc_reply_body(id, hdr_va, payload_va, payload_len) ----
        mov rdi, rsi;                             // rdi = id (a0)
        mov rsi, rdx;                             // rsi = user_hdr_va (a1)
        mov rdx, rcx;                             // rdx = user_payload_va (a2)
        mov rcx, r8;                              // rcx = payload_len (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_ipc_reply_body;
        add rsp, 8;
        ret;

        dispatch_ipc_reply_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_ipc_reply_cap_err:
        mov rax, r10;                             // propagate -EBADF or -EACCES
        ret;

        // R20b.M3-003 (#1560): sysno 43 = sys_svc_lookup(user_name_va, name_len)
        // -> slot_id in [0..255] on success, OR one of -EINVAL / -EFAULT /
        // -ENOENT / -ENOSPC (all negative-errno u64s with bit 63 set).
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = user_name_va
        //   rdx = a1 = name_len
        //
        // What this shim gates at R20b.M3-003 (per the #741 defense-in-
        // depth pattern used by every other dispatch handler with a user
        // pointer arg):
        //   (1) user_ptr_ok(user_name_va, name_len) — reject any kernel-half
        //       name VA before the body walks it. The body's own walker
        //       (user_read_bytes_via_walk) has a #741 Layer 2 range gate as
        //       last-line defence, but user_ptr_ok is the first line.
        //
        // Length semantics: the body itself rejects name_len == 0 or > 31
        // with -EINVAL (see sys_svc_lookup.pdx §Gate). The dispatch shim
        // passes name_len through raw so the body sees the caller's actual
        // value and can discriminate -EINVAL (bad length) from -EFAULT
        // (bad pointer). user_ptr_ok with name_len == 0 is well-defined
        // (rax = va + 0 = va; ja check passes iff va < KERNEL_VMA_BASE);
        // user_ptr_ok with name_len > 31 covers a larger range than the
        // body ever reads (body caps at 31), but that's fine — user_ptr_ok
        // just verifies the range stays user-half; the body's -EINVAL
        // rejection fires before any walker call.
        //
        // Alignment: entry rsp %16 == 8 (SysV). The pre-body gate uses
        // 2 pushes + `sub rsp, 8` = 24 bytes → %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 2 pops on return. The terminal
        // body call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.
        dispatch_svc_lookup:
        // ---- Gate: user_ptr_ok(user_name_va, name_len) ----
        push rsi;                                 // save user_name_va    (%16==0)
        push rdx;                                 // save name_len        (%16==8)
        sub rsp, 8;                               // align                 (%16==0)
        mov rdi, rsi;                             // arg0 = user_name_va
        mov rsi, rdx;                             // arg1 = name_len
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r10, rax;                             // stash fault flag (r10 caller-save, not live)
        add rsp, 8;                               //                       (%16==8)
        pop rdx;                                  //                       (%16==0)
        pop rsi;                                  //                       (%16==8)
        cmp r10, 0;
        jne dispatch_svc_lookup_efault;

        // ---- Marshal args for sys_svc_lookup_body(user_name_va, name_len) ----
        // Current: rsi=user_name_va, rdx=name_len
        // Body:    rdi=user_name_va, rsi=name_len
        mov rdi, rsi;                             // rdi = user_name_va (a0)
        mov rsi, rdx;                             // rsi = name_len (a1)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_svc_lookup_body;
        add rsp, 8;
        ret;

        dispatch_svc_lookup_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_debug_puts:
        // #741 Layer 1: user_ptr_ok(user_va, len) — pre-existing gap
        // from #724 D4. Prior to this gate a ring-3 caller could invoke
        // sys_debug_puts(kernel_va, len); the walker would follow
        // KPTI-mirror PML4[256], and although uart_putc is a read
        // (spillage limited to observability rather than corruption) the
        // untrusted-pointer discipline still requires a gate. See
        // design/kernel/r16-m3-741-user-ptr-ok-defense-in-depth.md.
        // Alignment: rsp%16 == 8 at entry; two pushes + sub rsp, 8 →
        // rsp%16 == 0 for the nested call.
        push rsi;                                 // save user_va (%16==0)
        push rdx;                                 // save len     (%16==8)
        sub rsp, 8;                               // align         (%16==0)
        mov rdi, rsi;                             // arg0 = user_va
        mov rsi, rdx;                             // arg1 = len
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        mov r8, rax;                              // stash result (r8 caller-save, not live)
        add rsp, 8;                               //               (%16==8)
        pop rdx;                                  // restore len   (%16==0)
        pop rsi;                                  // restore user_va (%16==8)
        cmp r8, 0;
        jne dispatch_debug_puts_efault;

        push rdx;                                 // save count for return (%16==0)
        mov rdi, rsi;                             // rdi = user_va (buf)
        mov rsi, rdx;                             // rsi = len (count)
        call user_puts_via_walk;                  // walks + prints
        pop rax;                                  // rax = count (echoed)  (%16==8)
        ret;

        dispatch_debug_puts_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_dup2:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=src_fd, rdx=dst_fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_dup2_body;
        add rsp, 8;
        ret;

        dispatch_getpid:
        mov rax, [rip + _current_tcb];
        mov eax, [rax + 0];                   // TASK_OFF_PID = 0, u32 zero-extends into rax
        ret;

        dispatch_fork:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_fork_body;
        add rsp, 8;
        ret;

        // R17-M0-724-D2 (#724): real termination path — see design/kernel/r17-m0-724-d2-sys-exit-terminate.md.
        // Sequence (all invoked with SysV rsp%16==0 after the single sub rsp,8 prelude,
        // which each nested `call` advances by pushing an 8-byte RA to satisfy the
        // callee's SysV rsp%16==8 entry contract):
        //   (1) sys_exit_body(current, status) — marks current ZOMBIE, wakes parent
        //       if WAITING (three-store: wait_result_pid, wait_result_status, state).
        //   (2) runq_dequeue(current) — remove the ZOMBIE from the circular runqueue
        //       so sched_pick_next_r15 will never re-select it. Precondition (per
        //       #563 §5): task must currently be on the runqueue — init and every
        //       child forked from it are enqueued at task_new / kernel_main time.
        //   (3) sched_pick_next_r15() — returns rax = next TCB (a RUNNABLE task
        //       still on the runqueue, or _idle_tcb if the runqueue is empty).
        //   (4) sched_switch_r15(next) — saves the ZOMBIE's stale kernel-stack rsp
        //       into the ZOMBIE's TCB (harmless waste; the TCB will be reaped by
        //       the parent's sys_wait_body → pid_free chain and its saved state
        //       is never read) and switches to next's stack via iretq-like
        //       synthetic-frame trampoline. Never returns to us.
        // The defensive fallthrough jmp dispatch_exit_halt is unreachable in
        // normal ops; it fires only if sched_switch_r15's continuation somehow
        // re-selected this ZOMBIE — which would require a scheduler bug that
        // failed the runq_dequeue precondition. klog_panic tag = tag_exit_returned.
        dispatch_exit:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_exit_body;                   // (1) mark ZOMBIE, wake parent if WAITING

        mov rdi, [rip + _current_tcb];        // (2) runq_dequeue(current)
        call runq_dequeue;

        call sched_pick_next_r15;             // (3) rax = next TCB (or _idle_tcb)

        mov rdi, rax;                         // (4) sched_switch_r15(next) — no return
        call sched_switch_r15;

        // UNREACHABLE — sched_switch_r15 never returns to a ZOMBIE (runq_dequeue'd).
        // Defensive fallthrough: fire klog_panic with tag_exit_returned so a
        // scheduler-bug regression surfaces on the wire rather than silently
        // corrupting whichever task's kernel stack we resumed onto.
        jmp dispatch_exit_halt;

        dispatch_exit_halt:
        // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7): in-place
        // rewrite via memo §5.1 option-B bracketed legacy suffix.  No
        // golden asserts `EXIT RETURNED` (grep tests/ returns zero hits)
        // and the marker carries no OK token, so the rewrite is
        // coverage-neutral and golden-neutral.  klog_panic emits the
        // tag string as the message body; the bracketed marker keeps
        // operator grep parity with the pre-R51 wire.  Old
        // tag_exit_returned deleted from keys.pdx (sole consumer).
        lea rdi, [rip + SUBSYS_INT_];
        lea rsi, [rip + tag_exit_returned_narrative];
        call klog_panic;
        jmp dispatch_exit_halt;

        // R17-M0-724-D5a (#724): would-block branch — on sys_wait_body's
        // rax==0 signal, invoke sched_block (which performs the state=WAITING
        // flip, runq_dequeue, sched_pick_next_r15, sched_switch_r15). On
        // resume the parent lands back here; read wait_result_{pid,status}
        // from its own slab (populated by sys_exit_body's wake path @1704,
        // @1708) into rax/rdx, then continue with the writeback + ret.
        // See design/kernel/r17-m0-724-d5-sys-wait-block.md §6 for the
        // full round-trip trace.
        dispatch_wait4:
        // #732 fix: syscall_dispatch's SysV C ABI puts arg0 (pid) in rsi
        // and arg1 (wstatus) in rdx (see entry.pdx §shuffle at L92-97:
        // mov rdx, rsi = old-arg1; mov rsi, rdi = old-arg0). Prior code
        // read wstatus from rsi — that's the pid arg (0xFFFFFFFFFFFFFFFF
        // for init's wait-for-any-child), which user_ptr_ok correctly
        // rejected as kernel-half → -EFAULT; pre-#731 the epilogue's
        // rax-clobber masked that failure so init.pdx's `jl init_shutdown`
        // silently absorbed the error and the hardcoded `wait_msg` printed
        // spuriously. Move the real wstatus pointer into rsi so the rest
        // of this handler (which was written against the assumption
        // "wstatus in rsi") operates on the correct value. The pid arg is
        // discarded: sys_wait_body scans all children of `current` (which
        // matches init's pid=-1 wait-for-any-child semantic); full POSIX
        // pid-filtering is out of scope at R17.M0.
        // See design/kernel/r15-m6-732-wait4-arg-marshalling.md.
        mov rsi, rdx;
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        push rsi;                             // save wstatus user ptr across call
        call sys_wait_body;                   // {rax=pid, rdx=status} or {rax=0} or {rax=-ECHILD}
        pop rsi;                              // restore wstatus ptr
        cmp rax, 0;
        jne dispatch_wait4_writeback;         // reap (rax=pid) or -ECHILD → skip block

        // rax == 0 (would-block): sched_block, then read wait_result on resume.
        push rsi;                             // preserve wstatus ptr across sched_block
        call sched_block;                     // blocks; returns when child exit fires runq_enqueue(parent)
        pop rsi;                              // restore wstatus ptr

        // Resume: read parent's wait_result_{pid,status} into rax/rdx.
        // _current_tcb after sched_switch_r15 is us (the parent) again;
        // sys_exit_body's wake path wrote wait_result_pid @ +1704 and
        // wait_result_status @ +1708 before setting our state=RUNNABLE.
        mov rax, [rip + _current_tcb];
        mov ecx, [rax + 1704];                // wait_result_pid (u32 zero-ext)
        mov edx, [rax + 1708];                // wait_result_status (u32 zero-ext)
        mov rax, rcx;                         // rax = zombie pid

        // R17-M5-753 (paideia-os #753): pid_free(zombie_pid) on the
        // sched-block wake path. The reap path (rax != 0 from
        // sys_wait_body) already frees the ZOMBIE slab via
        // sys_wait.pdx L60's pid_free call. The sched-block+wake path
        // previously did NOT — sys_exit_body sets the ZOMBIE state and
        // wakes the parent, but pid_free is the parent's wait-reap
        // responsibility.
        //
        // Symptom pre-fix: every wake-based wait4 leaked the reaped
        // child's slab in _pid_table. A subsequent wait4 found the
        // stale ZOMBIE and reaped it "for real" — producing a duplicate
        // WAIT/REAPED wire artifact plus incorrect pid arithmetic
        // (parent sees the OLD child's pid/status instead of blocking
        // for the NEW child). Surfaced by paideia-os #749's second
        // fork+wait cycle for /bin/sh.
        //
        // Alignment: entry to dispatch_wait4 is rsp%16==8 (SysV). After
        // sched_block returned and pop rsi, we're at %16==8. Three
        // pushes (rax, rdx, rsi) → %16==0 (correct for pid_free's SysV
        // call). pid_free is a leaf-2-instruction primitive (task_pool.pdx
        // §pid_free) that clobbers no callee-save regs; still we save
        // rax/rdx (the live return values) and rsi (the wstatus user
        // pointer that dispatch_wait4_writeback still needs) across the
        // call. Three pops restore %16==8 for the writeback path.
        push rax;                             // save zombie pid (return value)
        push rdx;                             // save exit status
        push rsi;                             // save wstatus user ptr
        mov rdi, rax;                         // arg0 = zombie pid
        call pid_free;                        // _pid_table[pid] = 0
        pop rsi;                              // restore wstatus user ptr
        pop rdx;                              // restore exit status
        pop rax;                              // restore zombie pid

        dispatch_wait4_writeback:
        cmp rsi, 0;
        je dispatch_wait4_done;
        // #724-D5-verify: validate wstatus before writing. Unlike
        // dispatch_write (which calls user_ptr_ok(buf, len) at #541), this
        // writeback wrote through rsi unconditionally — a user program
        // passing an unmapped or kernel-half wstatus pointer would fault
        // the kernel on the raw store. Mirror dispatch_write's pattern:
        // save the live return values (rax=pid, rdx=status) and the
        // pointer itself (rsi, about to be clobbered as the len arg)
        // across the call; user_ptr_ok clobbers rax and rcx (per
        // dispatch_write's save/restore precedent at L85-95), so rax/rdx
        // must be pushed too, not just rsi.
        push rax;                             // save zombie pid (return value)
        push rdx;                             // save status
        push rsi;                             // save wstatus va (about to become len arg)
        mov rdi, rsi;                         // arg0 = wstatus va
        mov rsi, 4;                           // arg1 = len (u32 write width)
        call user_ptr_ok;
        mov r8, rax;                          // stash fault flag (r8 not live here)
        pop rsi;                              // restore wstatus va
        pop rdx;                              // restore status
        pop rax;                              // restore zombie pid
        cmp r8, 0;
        jne dispatch_wait4_efault;
        // #737 fix: route the 4-byte wstatus store through
        // user_write_u32_via_walk so the write lands on init's user
        // PML4-mapped frame instead of PA=user_va via boot PML4's low
        // identity map. Same defect class as #724 D4 dispatch_debug_puts,
        // #730 D10c dispatch_write_uart, #730 D10d sys_execve_shim path
        // copy. Pre-fix wire: `WAIT: pid=23 status=0` (child_hello's
        // sys_exit(42) was silently lost because init's read of
        // wait_status[0] came back as the ELF loader's zero, not the byte
        // the kernel had written under kernel CR3 to the wrong physical
        // page). Post-fix: `WAIT: pid=23 status=42`. See
        // design/kernel/r16-m3-737-dispatch-wait4-writeback-kpti.md.
        //
        // Callee-save discipline: user_write_u32_via_walk is a leaf
        // helper (no nested call inside it) but per its documented
        // contract clobbers all caller-save regs (rax, rcx, rdx, rsi,
        // rdi, r8-r10). rax (zombie pid — our return value) must
        // survive; save/restore it via push/pop across the call. rdx
        // (status) and rsi (wstatus ptr) become the SysV args for the
        // call, so they are consumed rather than preserved. r8 (walk
        // result) is stashed post-call before the pop restores rax, then
        // used to branch on EFAULT.
        //
        // Alignment: dispatch_wait4_writeback was reached from
        // syscall_dispatch's `call` (SysV rsp%16 == 8 at entry to
        // dispatch_wait4). The three prior pushes (rax/rdx/rsi) plus
        // three pops between user_ptr_ok and here restore rsp to its
        // dispatch-entry value (%16 == 8). The single `push rax` below
        // moves rsp to %16 == 0 — correct for the nested
        // `call user_write_u32_via_walk`. `pop rax` restores %16 == 8 for
        // our own `ret`.
        push rax;                             // save zombie pid across the call
        mov rdi, rsi;                         // arg0 = wstatus user VA
        mov rsi, rdx;                         // arg1 = status (u64; low 32 used)
        call user_write_u32_via_walk;         // rax = 0 (OK) or -EFAULT
        mov r8, rax;                          // stash walk result
        pop rax;                              // restore zombie pid
        cmp r8, 0;
        jne dispatch_wait4_efault;            // walk failed → -EFAULT
        dispatch_wait4_done:
        ret;

        // wstatus failed user_ptr_ok — return -EFAULT (same convention as
        // dispatch_write_efault above).
        dispatch_wait4_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT = -14
        ret;

        // R17-M0-671 (#671): sys_execve dispatch shim — bridges SC+ ABI
        // (path, argv, envp) to sys_execve_body(current, image_ptr, image_len).
        // See design/kernel/r17-m0-671-sys-execve-shim.md for full contract.
        // SysV args on entry to dispatch: rsi=path_va, rdx=argv_va, rcx=envp_va.
        // Shim expects: rdi=current, rsi=path_va, rdx=argv_va, rcx=envp_va —
        // exactly matches once we load _current_tcb into rdi.
        dispatch_execve:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current (task_struct*)
        // rsi=path_va, rdx=argv_va, rcx=envp_va already SysV-positioned
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_execve_shim;                 // {rax, rdx} = errno or (0, entry_rip)
        add rsp, 8;
        ret;

        // ============================================================
        // #1582 part A: sysno 66 = sys_clock_read_ns() -> u64 ns.
        //
        // No arguments. Body is a leaf tail-call to hpet_now_ns wrapped in
        // a standard #672 alignment bracket. Nothing to marshal; nothing
        // to bounce (no user pointer). See src/kernel/core/syscall/handlers/
        // clock_read_ns.pdx for the body contract.
        // ============================================================
        dispatch_clock_read_ns:
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_clock_read_ns_body;              // rax = ns since boot
        add rsp, 8;
        ret;

        // ============================================================
        // #1582 part B: sysno 67 = sys_sched_setaffinity(cpu_mask) -> i64.
        //
        // SysV positioning: rsi = a0 = cpu_mask. Body wants
        // (rdi=current, rsi=cpu_mask); load _current_tcb into rdi and
        // pass rsi through.
        //
        // No user pointer on this arg (raw u64), so no user_ptr_ok gate
        // and no KPTI bounce. The body's own two-gate validation (0-mask
        // -> EINVAL, mask beyond MAX_CPUS -> EINVAL) is where user-value
        // sanity lives.
        // ============================================================
        dispatch_sched_setaffinity:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                             // rdi = current TCB
        // rsi = cpu_mask already SysV-positioned
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_sched_setaffinity_body;          // rax = 0 or -EINVAL
        add rsp, 8;
        ret;

        // ============================================================
        // #1582 part B: sysno 68 = sys_sched_getaffinity() -> u64.
        //
        // No user arguments (getpid-shaped). Load _current_tcb into rdi
        // and call the body. Return value is the u64 cpu_mask (or
        // ~0u64 if the stored value is 0-wildcard) — never negative,
        // so no errno translation.
        // ============================================================
        dispatch_sched_getaffinity:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                             // rdi = current TCB
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_sched_getaffinity_body;          // rax = mask or ~0
        add rsp, 8;
        ret;

        // ============================================================
        // #1582 part B: sysno 69 = sys_reserve_lpe_class(pid) -> i64.
        //
        // SysV positioning: rsi = a0 = pid. Body wants (rdi=pid) —
        // shuffle rsi -> rdi. Body handles all three refusals
        // (pid=0, EEXIST, idempotent same-pid) internally.
        //
        // AML executor task (#1087) reserves LP-E via this syscall to
        // sidestep P-core scheduling jitter — see sched_affinity.pdx
        // §sys_reserve_lpe_class_body for the full rationale.
        // ============================================================
        dispatch_reserve_lpe_class:
        mov rdi, rsi;                             // rdi = pid (a0)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_reserve_lpe_class_body;          // rax = 0 or -EINVAL/-EEXIST
        add rsp, 8;
        ret;

        // ============================================================
        // R42-PREP-007 (#1629): sysno 70 = sys_pdxfs_txn_open(
        //     parent_slot, mode, txn_id, wal_off) -> cap_slot | errno.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = parent_slot   (KIND_MEMORY cap the mount owns)
        //   rdx = a1 = mode          (PXT_MODE_CREATE / MODIFY / DELETE)
        //   rcx = a2 = txn_id        (FS-assigned, non-zero)
        //   r8  = a3 = wal_off       (WAL byte offset for first record)
        //
        // Body wants: rdi=parent_slot, rsi=mode, rdx=txn_id, rcx=wal_off.
        // No user pointers on this arg quartet -- all raw u64s -- so no
        // user_ptr_ok gate and no KPTI bounce (matches dispatch_reserve_
        // lpe_class shape).  The body's own gates (parent kind ==
        // KIND_MEMORY carrying RIGHT_MINT, mode in [1..3], txn_id non-
        // zero) live in pdxfs_txn_cap_mint_inner and its helpers.
        //
        // Return codes propagate mint sentinels verbatim (0xFFFFEC1x
        // band) so the ring-3 caller sees the same failure taxonomy
        // kind_pdxfs_txn.pdx documents; -ENFILE (-33) for cap_table
        // exhaustion is the only new code introduced by the syscall
        // layer.
        // ============================================================
        dispatch_pdxfs_txn_open:
        mov rdi, rsi;                             // rdi = parent_slot (a0)
        mov rsi, rdx;                             // rsi = mode (a1)
        mov rdx, rcx;                             // rdx = txn_id (a2)
        mov rcx, r8;                              // rcx = wal_off (a3)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_pdxfs_txn_open_body;             // rax = cap_slot or errno
        add rsp, 8;
        ret;

        // ============================================================
        // R42-PREP-008 (#1630): sysno 71 = sys_pdxfs_open(parent_slot,
        //     mode_flags) -> cap_slot | errno.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = parent_slot  (KIND_MEMORY cap w/ RIGHT_MINT)
        //   rdx = a1 = mode_flags   (low-16 PdxFS mode bits, DIR nibble
        //                            bit 0x2000 for a dir open)
        //
        // Body wants: rdi=parent_slot, rsi=mode_flags -- a two-move
        // shuffle.  No user pointers, so no user_ptr_ok gate and no
        // KPTI bounce (matches dispatch_pdxfs_txn_open shape).
        //
        // The body's own gates (parent kind == KIND_MEMORY carrying
        // RIGHT_MINT, mode_flags <= 0xFFFF) live in
        // sys_pdxfs_open.pdx §Contract.
        // ============================================================
        dispatch_pdxfs_open:
        mov rdi, rsi;                             // rdi = parent_slot (a0)
        mov rsi, rdx;                             // rsi = mode_flags (a1)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_pdxfs_open_body;                 // rax = cap_slot or errno
        add rsp, 8;
        ret;

        // ============================================================
        // R42-PREP-008 (#1630): sysno 72 = sys_pdxfs_dir_readnext(
        //     dir_cap_slot, user_entry_buf_va) -> 1 | 0 | -errno.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = dir_cap_slot        (held KIND_PDXFS_FILE cap
        //                                   whose mode nibble = DIR)
        //   rdx = a1 = user_entry_buf_va   (user VA of >= 128-byte buf)
        //
        // Layered discipline:
        //   Layer 1 (this shim, #741 pattern):
        //     (a) user_ptr_ok(user_entry_buf_va, 128) -> -EFAULT on
        //         any kernel-half VA (defence-in-depth before the
        //         walker; matches dispatch_read at #741).
        //     (b) Marshal args for the body (rdi=dir_cap_slot,
        //         rsi=_dispatch_pdxfs_dir_scratch).
        //     (c) sys_pdxfs_dir_readnext_body writes 128 bytes into
        //         the scratch on rc=1, or nothing on rc=0/-EBADF.
        //     (d) On rc=1, user_write_bytes_via_walk copies the
        //         128-byte scratch out to the user buffer via the
        //         current TCB's user PML4 (KPTI-safe).
        //     (e) Return the body's rc verbatim on rc<1; return 1 on
        //         successful walker copy; return -EFAULT on walker fail.
        //
        //   Layer 2 (body): dir_cap_slot gate + row mode gate + call
        //     into pdxfs_dir_readnext (see sys_pdxfs_dir_readnext.pdx).
        //
        // Alignment: entry rsp %16 == 8 (SysV).  The pre-body gate uses
        // 2 pushes + `sub rsp, 8` = 24 bytes -> %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 2 pops on return.  The body
        // call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.  The post-body walk-copy uses the two live-preserved
        // regs (r13=body rc, r15=user buf VA) + a single push of the rc
        // to align %16 == 0.
        // ============================================================
        dispatch_pdxfs_dir_readnext:
        push r15;                                 // save user buf VA across body + walker
        push r13;                                 // save capped-len sibling / align slot

        mov r15, rdx;                             // r15 = user_entry_buf_va

        // ---- Layer 1 (a): user_ptr_ok(user_buf, 128) ----
        //   Preserve rsi (dir_cap_slot) across the call: push it (rsp%16
        //   was 8 after the two pushes above, so `push rsi` -> %16 ==0).
        push rsi;
        mov rdi, r15;                             // arg0 = user buf VA
        mov rsi, 128;                             // arg1 = PDXFS_DIR_ENTRY_SIZE
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        pop rsi;                                  // restore dir_cap_slot   (%16==8)
        cmp rax, 0;
        jne dispatch_pdxfs_dir_readnext_efault;

        // ---- Layer 1 (b) + (c): call body with kernel scratch ----
        //   Body wants: rdi=dir_cap_slot, rsi=kernel_dst_ptr.
        mov rdi, rsi;                             // rdi = dir_cap_slot (a0)
        lea rsi, [rip + _dispatch_pdxfs_dir_scratch]; // rsi = kernel scratch
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_pdxfs_dir_readnext_body;         // rax = 1 | 0 | -EBADF
        add rsp, 8;

        // rax = 1 (entry) | 0 (EOD) | 0xFFFFFFFFFFFFFFF7 (-EBADF).
        // Skip the walker on 0 (EOD -- nothing to copy) and on any
        // errno (huge unsigned).  Only rax == 1 walks the writeback.
        cmp rax, 1;
        jne dispatch_pdxfs_dir_readnext_done;     // 0 or errno passthrough

        // ---- Layer 1 (d): walker-copy scratch[0..128] -> user buf ----
        //   user_write_bytes_via_walk(user_va, kernel_src, len).
        //   Alignment: rsp%16 == 8 after the add rsp, 8 above.  Single
        //   `push rax` (save body rc = 1) -> %16 == 0 for nested call.
        //   `pop rax` restores %16 == 8.
        push rax;                                 // save body rc for return
        mov rdi, r15;                             // arg0 = user buf VA
        lea rsi, [rip + _dispatch_pdxfs_dir_scratch]; // arg1 = kernel scratch
        mov rdx, 128;                             // arg2 = len (PDXFS_DIR_ENTRY_SIZE)
        call user_write_bytes_via_walk;           // rax = 0 (OK) or -EFAULT
        mov r8, rax;                              // stash walker result
        pop rax;                                  // restore body rc

        cmp r8, 0;
        jne dispatch_pdxfs_dir_readnext_efault;   // walker failed -> -EFAULT

        dispatch_pdxfs_dir_readnext_done:
        pop r13;
        pop r15;
        ret;

        dispatch_pdxfs_dir_readnext_efault:
        pop r13;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        // ============================================================
        // R51.M8-001 (#1675): sysno 74 = sys_blkdev_cap_request(
        //     bdev_id) -> cap_slot | MOUNTW_* | -ENFILE.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = bdev_id   (opaque u64 key; R52 owns the shape,
        //                         design/hardware/nvme-ahci-tail-
        //                         milestones.md §2.M8 #1675)
        //
        // Body wants: rdi=bdev_id -- a one-move shuffle. No user
        // pointers on this arg (raw u64), so no user_ptr_ok gate and
        // no KPTI bounce (matches dispatch_reserve_lpe_class /
        // dispatch_pdxfs_txn_open shape).
        //
        // The body's own gates (index-table lookup, attestation
        // check, cap_table free-slot scan) live in
        // cap/blkdev_cap_request.pdx's blkdev_cap_request.
        // ============================================================
        dispatch_blkdev_cap_request:
        mov rdi, rsi;                             // rdi = bdev_id (a0)
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call blkdev_cap_request;                  // rax = cap_slot or MOUNTW_*/-ENFILE
        add rsp, 8;
        ret;

        // ============================================================
        // R53.M2-001 (#1736): forward-declaration stubs for sys_mount
        // (sysno 75) and sys_umount (sysno 76).
        //
        // The bounds check above accepts these ordinals so a userspace
        // caller reaches this dispatch label instead of falling into
        // dispatch_enosys via the `ja` guard.  The sibling bodies land
        // in #1737 (sys_mount) and #1738 (sys_umount); until they do,
        // both labels return -ENOSYS (0xFFFFFFFFFFFFFFDA) so the
        // dispatch link edge remains buildable without an undefined-
        // symbol reference to sys_mount_body / sys_umount_body.
        //
        // Shim contract siblings must implement (see dispatch_open at
        // L664 and dispatch_blkdev_cap_request at L1712 for the two
        // canonical patterns):
        //
        //   sys_mount (sysno 75):
        //     rsi = a0 = volume_cap_slot     (KIND_VOLUME cap)
        //     rdx = a1 = mountpoint_path_va  (user VA, NUL-term, PATH_MAX)
        //     rcx = a2 = flags               (u64)
        //     r8  = a3 = fstype              (u64 backend id)
        //     -> rax = mount_id | -EBADF | -EACCES | -EFAULT | -ENOENT
        //   Gates: cap_slot -> KIND_VOLUME lookup + VOL_RIGHT_MOUNT
        //   rights check (parallels ipc_slot_to_endpoint at L222);
        //   user_ptr_ok(mountpoint_path_va, PATH_MAX);
        //   user_read_str_via_walk into _dispatch_open_path_scratch (or
        //   a dedicated _dispatch_mount_path_scratch if a concurrent
        //   sys_open is a concern); tail into sys_mount_body.
        //
        //   sys_umount (sysno 76):
        //     rsi = a0 = mount_id  (u64, returned by prior sys_mount)
        //     rdx = a1 = flags     (u64; MNT_FORCE etc.)
        //     -> rax = 0 | -EBUSY | -EINVAL | -EACCES
        //   Gates: no user pointers -- direct tail into sys_umount_body
        //   after a one-move register shuffle (rsi->rdi, rdx->rsi).
        //   Rights model per design/tooling/volume-lifecycle-
        //   mechanism.md §6.4: sys_umount checks the mount_table
        //   entry's originating cap for VOL_RIGHT_UMOUNT rather than
        //   the caller's cap slot, so no cap-slot arg here.
        // ============================================================
        dispatch_mount:
        mov rax, 0xFFFFFFFFFFFFFFDA;              // -ENOSYS (stub; body lands in #1737)
        ret;

        dispatch_umount:
        mov rax, 0xFFFFFFFFFFFFFFDA;              // -ENOSYS (stub; body lands in #1738)
        ret;

        // ============================================================
        // R56.M3-001 (#1790): forward-declaration stubs for the VFS
        // metadata block — sysnos 77..82.
        //
        // Same discipline as dispatch_mount / dispatch_umount above:
        // each label returns -ENOSYS (0xFFFFFFFFFFFFFFDA) so this
        // dispatch-table widen can land ahead of the sibling bodies
        // (#1791..#1795) without introducing an undefined-symbol link
        // error against sys_{stat,getdents,mkdir,rmdir,unlink,rename}_body.
        // When each body lands its dispatch label is rewritten in-place
        // to the shim shape appropriate for the argument mix — see
        // dispatch_open (path-copy via KPTI bounce + user_read_str_via_walk)
        // for the single-path-arg pattern and dispatch_pdxfs_dir_readnext
        // (scratch-buf writeback via user_write_bytes_via_walk) for the
        // out-buf pattern.
        //
        // Register/arg conventions per design/kernel/vfs-metadata-
        // syscalls.md §Schema table (all six use SysV positioning
        // rdi=sysno / rsi=a0 / rdx=a1 / rcx=a2 at the dispatch
        // boundary):
        //
        //   sysno 77 sys_stat     (rsi=path_ptr, rdx=stat_buf_ptr)
        //                         -> 0 | -errno
        //   sysno 78 sys_getdents (rsi=fd, rdx=buf, rcx=nbytes)
        //                         -> bytes_read | -errno
        //   sysno 79 sys_mkdir    (rsi=path_ptr, rdx=mode)
        //                         -> 0 | -errno
        //   sysno 80 sys_rmdir    (rsi=path_ptr)
        //                         -> 0 | -errno
        //   sysno 81 sys_unlink   (rsi=path_ptr)
        //                         -> 0 | -errno
        //   sysno 82 sys_rename   (rsi=old_path_ptr, rdx=new_path_ptr)
        //                         -> 0 | -errno
        //
        // Labels use the plain `dispatch_<name>` naming (matching the
        // R53.M2-001 dispatch_mount / dispatch_umount siblings) — none
        // of {stat, getdents, mkdir, rmdir, unlink, rename} is a
        // reserved word in the paideia-as grammar (feedback
        // reference_paideia_as_reserved_labels.md lists loop/if/etc.),
        // so no name-prefixing is required.
        // ============================================================
        // R56.M3-002 (#1791): sys_stat wired.  Body lives at
        // src/kernel/core/syscall/sys_stat.pdx (sys_stat_body).
        //
        // SysV shuffle: dispatch enters with rsi=a0=path_va,
        // rdx=a1=path_len, rcx=a2=stat_buf_va; sys_stat_body wants
        // rdi=path_va, rsi=path_len, rdx=stat_buf_va.  Three-move
        // reg-shuffle is the same shape dispatch_cap_invoke uses at
        // sysno 4.
        //
        // Alignment: entry rsp%16==8 (SysV; syscall_dispatch was
        // called from syscall_entry).  `sub rsp, 8` -> %16==0 pre-call
        // so the callee's own retaddr push delivers rsp%16==8 at body
        // entry.  Symmetric `add rsp, 8` before ret.  Body handles its
        // own KPTI bounces (user_read_str_via_walk on path,
        // user_write_bytes_via_walk on stat_buf) plus the walker's
        // #741 Layer 2 gate, so no dispatch-layer bounce is needed
        // here -- matches the sys_execve_shim / sys_mount_shim
        // precedent where the body owns both the walker call and its
        // KPTI-bounce scratch.
        dispatch_stat:
        mov rdi, rsi;                             // path_va
        mov rsi, rdx;                             // path_len
        mov rdx, rcx;                             // stat_buf_va
        sub rsp, 8;                               // SysV alignment pad
        call sys_stat_body;                       // rax = 0 | -EFAULT | -ENOENT
        add rsp, 8;
        ret;

        // R56.M3-003 (#1792): sysno 78 = sys_getdents(fd, buf, nbytes).
        // Body owns its own kernel scratch + KPTI-safe writeback via
        // user_write_bytes_via_walk (see sys_getdents.pdx §KPTI bounce
        // discipline for why the shim does NOT bounce a scratch here).
        // Load _current_tcb into rdi; rsi=fd, rdx=buf, rcx=nbytes already
        // SysV-positioned by syscall_dispatch.
        dispatch_getdents:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                             // rdi = current
        sub rsp, 8;                               // #672 MEDIUM: SysV alignment pad
        call sys_getdents_body;                   // rax = bytes-written or -errno
        add rsp, 8;
        ret;

        // R56.M3-004 (#1793): sys_mkdir wired.  Body lives at
        // src/kernel/core/syscall/sys_mkdir.pdx (sys_mkdir_body).
        //
        // SysV shuffle: dispatch enters with rsi=a0=path_va,
        // rdx=a1=path_len, rcx=a2=mode; sys_mkdir_body wants
        // rdi=path_va, rsi=path_len, rdx=mode.  Three-move reg-shuffle
        // is the same shape dispatch_stat / dispatch_cap_invoke use.
        //
        // Alignment: entry rsp%16==8 (SysV; syscall_dispatch was
        // called from syscall_entry).  `sub rsp, 8` -> %16==0 pre-
        // call so the callee's own retaddr push delivers rsp%16==8
        // at body entry.  Symmetric `add rsp, 8` before ret.  Body
        // owns its own KPTI bounce (user_read_str_via_walk on path)
        // plus the walker's #741 Layer 2 gate, so no dispatch-layer
        // bounce is needed -- matches the sys_stat / sys_execve_shim
        // precedent.
        dispatch_mkdir:
        mov rdi, rsi;                             // path_va
        mov rsi, rdx;                             // path_len
        mov rdx, rcx;                             // mode
        sub rsp, 8;                               // SysV alignment pad
        call sys_mkdir_body;                      // rax = 0 | -EFAULT | -ENOENT | -EIO
        add rsp, 8;
        ret;

        // R56.M3-004 (#1793): sys_rmdir wired.  Body lives at
        // src/kernel/core/syscall/sys_rmdir.pdx (sys_rmdir_body).
        //
        // SysV shuffle: dispatch enters with rsi=a0=path_va,
        // rdx=a1=path_len; sys_rmdir_body wants rdi=path_va,
        // rsi=path_len.
        dispatch_rmdir:
        mov rdi, rsi;                             // path_va
        mov rsi, rdx;                             // path_len
        sub rsp, 8;                               // SysV alignment pad
        call sys_rmdir_body;                      // rax = 0 | -EFAULT | -ENOENT | -EIO
        add rsp, 8;
        ret;

        // R56.M3-005 (#1794): sysno 81 = sys_unlink(path_va, path_len).
        // Body: src/kernel/core/syscall/sys_unlink.pdx (sys_unlink_body).
        //
        // SysV shuffle: dispatch enters with rsi=a0=path_va,
        // rdx=a1=path_len; sys_unlink_body wants rdi=path_va,
        // rsi=path_len.  Two-move reg-shuffle matches dispatch_stat.
        //
        // Body owns its own KPTI bounce (user_read_str_via_walk into
        // _sys_unlink_path_scratch / _sys_unlink_parent_scratch); no
        // dispatch-layer scratch needed, matches the sys_stat / sys_umount
        // shim shape.  The body's own user_read_str_via_walk carries the
        // #741 layer-2 range gate; user_ptr_ok is not repeated here.
        dispatch_unlink:
        mov rdi, rsi;                             // path_va
        mov rsi, rdx;                             // path_len
        sub rsp, 8;                               // SysV alignment pad
        call sys_unlink_body;                     // rax = 0 | -EFAULT | -EINVAL | -ENOENT
        add rsp, 8;
        ret;

        // R56.M3-005 (#1794): sysno 82 = sys_rename(old_va, old_len, new_va, new_len).
        // Body: src/kernel/core/syscall/sys_rename.pdx (sys_rename_body).
        //
        // SysV shuffle: dispatch enters with rsi=a0=old_va, rdx=a1=old_len,
        // rcx=a2=new_va, r8=a3=new_len; sys_rename_body wants
        // rdi=old_va, rsi=old_len, rdx=new_va, rcx=new_len.  Four-move
        // shuffle.  Same pattern as dispatch_pdxfs_txn_open at sysno 70.
        //
        // Body owns its own KPTI bounces (two user_read_str_via_walk
        // calls into _sys_rename_old_scratch / _new_scratch) plus a
        // derived _sys_rename_parent_scratch for the same-parent gate.
        // Cross-directory rename is refused with -EXDEV pending R57 (see
        // sys_rename.pdx §Cross-directory posture).
        dispatch_rename:
        mov rdi, rsi;                             // old_va
        mov rsi, rdx;                             // old_len
        mov rdx, rcx;                             // new_va
        mov rcx, r8;                              // new_len
        sub rsp, 8;                               // SysV alignment pad
        call sys_rename_body;                     // rax = 0 | -errno
        add rsp, 8;
        ret;

        // ============================================================
        // R57.M4-003 (paideia-os #1799): sysno 83 = sys_taskinfo(
        //     idx, user_buf_va) -> 0 | -ENOENT | -ESRCH | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = idx             (task-pool index in [0, 64))
        //   rdx = a1 = user_buf_va     (user VA of a 32-byte buffer)
        //
        // Layered discipline (mirrors dispatch_pdxfs_dir_readnext -- the
        // sibling shim that also walks a fixed-size record from a
        // kernel scratch out to a user buffer):
        //
        //   Layer 1 (this shim, #741 pattern):
        //     (a) user_ptr_ok(user_buf_va, 32) -> -EFAULT on any
        //         kernel-half VA (defence-in-depth before the walker;
        //         matches dispatch_read at #741).
        //     (b) Marshal args for the body (rdi=idx,
        //         rsi=_dispatch_taskinfo_scratch).
        //     (c) sys_taskinfo_body writes 32 bytes into the scratch on
        //         rc=0, or nothing on rc<0 (-ENOENT / -ESRCH).
        //     (d) On rc=0, user_write_bytes_via_walk copies the 32-byte
        //         scratch out to the user buffer via the current TCB's
        //         user PML4 (KPTI-safe).
        //     (e) Return the body's rc verbatim on rc!=0; return 0 on
        //         successful walker copy; return -EFAULT on walker fail.
        //
        //   Layer 2 (body): idx range gate + pid_table probe + field
        //     copies (see src/kernel/core/sched/task_info.pdx).
        //
        // Alignment: entry rsp %16 == 8 (SysV).  The pre-body gate uses
        // 2 pushes + `sub rsp, 8` = 24 bytes -> %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 2 pops on return.  The body
        // call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.  The post-body walk-copy uses the live-preserved
        // reg (r15=user buf VA) + a single push of the body rc to
        // align %16 == 0.
        // ============================================================
        dispatch_taskinfo:
        push r15;                                 // save user buf VA across body + walker
        push r13;                                 // align sibling / save idx (unused past body)

        mov r15, rdx;                             // r15 = user_buf_va

        // ---- Layer 1 (a): user_ptr_ok(user_buf, 32) ----
        //   Preserve rsi (idx) across the call: push it (rsp%16 was 8
        //   after the two pushes above, so `push rsi` -> %16 == 0).
        push rsi;
        mov rdi, r15;                             // arg0 = user buf VA
        mov rsi, 32;                              // arg1 = TASK_INFO_RECORD_BYTES
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        pop rsi;                                  // restore idx           (%16 == 8)
        cmp rax, 0;
        jne dispatch_taskinfo_efault;

        // ---- Layer 1 (b) + (c): call body with kernel scratch ----
        //   Body wants: rdi=idx, rsi=kernel_dst_ptr.
        mov rdi, rsi;                             // rdi = idx (a0)
        lea rsi, [rip + _dispatch_taskinfo_scratch]; // rsi = kernel scratch
        sub rsp, 8;                               // #672 alignment pad
        call sys_taskinfo_body;                   // rax = 0 | -ENOENT | -ESRCH
        add rsp, 8;

        // rax = 0 (success) | 0xFFFFFFFFFFFFFFFE (-ENOENT) |
        // 0xFFFFFFFFFFFFFFFD (-ESRCH).  Skip the walker on any non-zero
        // return -- an errno passthrough writes nothing to the user
        // buffer (the caller sees the errno and does not touch the
        // buffer contents).  Only rax == 0 walks the writeback.
        cmp rax, 0;
        jne dispatch_taskinfo_done;               // -ENOENT / -ESRCH passthrough

        // ---- Layer 1 (d): walker-copy scratch[0..32] -> user buf ----
        //   user_write_bytes_via_walk(user_va, kernel_src, len).
        //   Alignment: rsp %16 == 8 after the add rsp, 8 above.  Single
        //   `push rax` (save body rc = 0) -> %16 == 0 for nested call.
        //   `pop rax` restores %16 == 8.
        push rax;                                 // save body rc for return (= 0)
        mov rdi, r15;                             // arg0 = user buf VA
        lea rsi, [rip + _dispatch_taskinfo_scratch]; // arg1 = kernel scratch
        mov rdx, 32;                              // arg2 = len (TASK_INFO_RECORD_BYTES)
        call user_write_bytes_via_walk;           // rax = 0 (OK) or -EFAULT
        mov r8, rax;                              // stash walker result
        pop rax;                                  // restore body rc (= 0)

        cmp r8, 0;
        jne dispatch_taskinfo_efault;             // walker failed -> -EFAULT

        dispatch_taskinfo_done:
        pop r13;
        pop r15;
        ret;

        dispatch_taskinfo_efault:
        pop r13;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        // ============================================================
        // R57.M4-004 (paideia-os #1800): sysno 84 = sys_mountinfo(
        //     idx, user_buf_va) -> 0 | -ENOENT | -ESRCH | -EFAULT.
        //
        // SysV positioning at this label (per entry.pdx §shuffle):
        //   rsi = a0 = idx             (mount-table index in [0, 8))
        //   rdx = a1 = user_buf_va     (user VA of a 32-byte buffer)
        //
        // Layered discipline mirrors dispatch_taskinfo (immediately
        // above) byte-for-byte modulo the scratch symbol and the body
        // label -- the two syscalls have identical shapes (an idx,
        // a user 32-B buffer, an iterator errno taxonomy).  Keeping
        // the shims aligned means a single audit of the taskinfo
        // pattern covers both, and a future encoder-gap workaround
        // (or KPTI-bounce evolution) applied to one is trivially
        // portable to the other:
        //
        //   Layer 1 (this shim, #741 pattern):
        //     (a) user_ptr_ok(user_buf_va, 32) -> -EFAULT on any
        //         kernel-half VA (defence-in-depth before the walker;
        //         matches dispatch_read at #741).
        //     (b) Marshal args for the body (rdi=idx,
        //         rsi=_dispatch_mountinfo_scratch).
        //     (c) sys_mountinfo_body writes 32 bytes into the scratch
        //         on rc=0, or nothing on rc<0 (-ENOENT / -ESRCH).
        //     (d) On rc=0, user_write_bytes_via_walk copies the 32-byte
        //         scratch out to the user buffer via the current TCB's
        //         user PML4 (KPTI-safe).
        //     (e) Return the body's rc verbatim on rc!=0; return 0 on
        //         successful walker copy; return -EFAULT on walker fail.
        //
        //   Layer 2 (body): idx range gate + _mount_table probe + field
        //     extraction (see src/kernel/core/syscall/sys_mountinfo.pdx).
        //
        // Alignment: entry rsp %16 == 8 (SysV).  The pre-body gate uses
        // 2 pushes + `sub rsp, 8` = 24 bytes -> %16 == 0 for the nested
        // call, mirrored by `add rsp, 8` + 2 pops on return.  The body
        // call uses the standard #672 `sub rsp, 8` + `add rsp, 8`
        // bracket.  The post-body walk-copy uses the live-preserved
        // reg (r15=user buf VA) + a single push of the body rc to
        // align %16 == 0.  Identical layout to dispatch_taskinfo
        // (r13 doubles as the alignment-pad push slot since idx is
        // consumed post-body).
        // ============================================================
        dispatch_mountinfo:
        push r15;                                 // save user buf VA across body + walker
        push r13;                                 // align sibling / save idx (unused past body)

        mov r15, rdx;                             // r15 = user_buf_va

        // ---- Layer 1 (a): user_ptr_ok(user_buf, 32) ----
        //   Preserve rsi (idx) across the call: push it (rsp%16 was 8
        //   after the two pushes above, so `push rsi` -> %16 == 0).
        push rsi;
        mov rdi, r15;                             // arg0 = user buf VA
        mov rsi, 32;                              // arg1 = MOUNT_INFO_RECORD_BYTES
        call user_ptr_ok;                         // rax = 0 (OK) or 1 (fault)
        pop rsi;                                  // restore idx           (%16 == 8)
        cmp rax, 0;
        jne dispatch_mountinfo_efault;

        // ---- Layer 1 (b) + (c): call body with kernel scratch ----
        //   Body wants: rdi=idx, rsi=kernel_dst_ptr.
        mov rdi, rsi;                             // rdi = idx (a0)
        lea rsi, [rip + _dispatch_mountinfo_scratch]; // rsi = kernel scratch
        sub rsp, 8;                               // #672 alignment pad
        call sys_mountinfo_body;                  // rax = 0 | -ENOENT | -ESRCH
        add rsp, 8;

        // rax = 0 (success) | 0xFFFFFFFFFFFFFFFE (-ENOENT) |
        // 0xFFFFFFFFFFFFFFFD (-ESRCH).  Skip the walker on any non-zero
        // return -- an errno passthrough writes nothing to the user
        // buffer (the caller sees the errno and does not touch the
        // buffer contents).  Only rax == 0 walks the writeback.
        cmp rax, 0;
        jne dispatch_mountinfo_done;              // -ENOENT / -ESRCH passthrough

        // ---- Layer 1 (d): walker-copy scratch[0..32] -> user buf ----
        //   user_write_bytes_via_walk(user_va, kernel_src, len).
        //   Alignment: rsp %16 == 8 after the add rsp, 8 above.  Single
        //   `push rax` (save body rc = 0) -> %16 == 0 for nested call.
        //   `pop rax` restores %16 == 8.
        push rax;                                 // save body rc for return (= 0)
        mov rdi, r15;                             // arg0 = user buf VA
        lea rsi, [rip + _dispatch_mountinfo_scratch]; // arg1 = kernel scratch
        mov rdx, 32;                              // arg2 = len (MOUNT_INFO_RECORD_BYTES)
        call user_write_bytes_via_walk;           // rax = 0 (OK) or -EFAULT
        mov r8, rax;                              // stash walker result
        pop rax;                                  // restore body rc (= 0)

        cmp r8, 0;
        jne dispatch_mountinfo_efault;            // walker failed -> -EFAULT

        dispatch_mountinfo_done:
        pop r13;
        pop r15;
        ret;

        dispatch_mountinfo_efault:
        pop r13;
        pop r15;
        mov rax, 0xFFFFFFFFFFFFFFF2;              // -EFAULT
        ret;

        dispatch_enosys:
        mov rax, 0xFFFFFFFFFFFFFFDA;
        ret
      }
    }

}
