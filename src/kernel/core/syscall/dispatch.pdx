// src/kernel/core/syscall/dispatch.pdx — R17-M0-668 (#668) SC+ freeze alignment — wire kernel dispatch to real bodies
// R17-M0-671 (#671): sysno 59 (execve) rewired from ENOSYS stub to sys_execve_shim.
// R17-M0-724-D2 (#724): sysno 60 (exit) — replace klog_panic hlt loop with real
//   task-termination path: sys_exit_body → runq_dequeue(current) →
//   sched_pick_next_r15 → sched_switch_r15(next). Never returns to the exiting
//   task's kernel syscall frame; the fallthrough dispatch_exit_halt is now a
//   defensive-only witness for "sched_switch_r15 returned to a ZOMBIE" — which
//   is unreachable in normal ops because the ZOMBIE has been runq_dequeue'd.
// Linear cmp/je chain over 13 syscall IDs per R13 preflight §C, extended with R16-M3 handler bodies.
// R17.M0 alignment (#668):
//   0 (read): load _current_tcb, call sys_read_body
//   1 (write): fd 1,2 → UART fast-path; fd >= 3 → sys_write_body
//   2 (open): load _current_tcb, call sys_open_body
//   3 (close): load _current_tcb, call sys_close_body
//   4 (cap_invoke): tail-call cap_invoke after arg shuffle [UNCHANGED]
//   12 (debug_puts): call uart_puts, echo msg_len [UNCHANGED]
//   32 (dup2): load _current_tcb, call sys_dup2_body
//   39 (getpid): inline from _current_tcb @ TASK_OFF_PID (0)
//   56 (fork): load _current_tcb, call sys_fork_body
//   59 (execve): load _current_tcb, call sys_execve_shim (path→image copy-in; #671)
//   60 (exit): sys_exit_body → runq_dequeue → pick_next → switch_r15 (never returns) [#724 D2]
//   61 (wait4): load _current_tcb, call sys_wait_body; on rax==0 (would-block signal)
//               call sched_block, then read wait_result_{pid,status} from parent slab
//               (@1704, @1708); writeback wstatus. [#724 D5a]
// All others return ENOSYS (-38 as u64 = 0xFFFFFFFFFFFFFFDA).
// [unsafe] — dispatches to sysreg/mem-effecting handlers.
// Audit: design/kernel/r17-m0-668-syscall-dispatch-align.md
// Audit: design/kernel/r17-m0-671-sys-execve-shim.md
// Audit: design/kernel/r17-m0-724-d2-sys-exit-terminate.md
// Audit: design/kernel/r17-m0-724-d5-sys-wait-block.md

module Dispatch = structure {
  // syscall_dispatch(rdi=sysno, rsi=a0, rdx=a1, rcx=a2, r8=a3) -> u64 in rax.
  // Widened !{mem, sysreg} @{cap, sched}: reachable handlers touch cap/sched/uart paths.
  pub let syscall_dispatch : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (sysno: u64) (a0: u64) (a1: u64) (a2: u64) (a3: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R17-M0-668 (#668) + R17-M0-671 (#671) + R17-M0-724-D2/D5a (#724): SC+ freeze alignment — wire kernel dispatch to real bodies. Linear cmp/je over IDs per R13 preflight §C. IDs {0,2,3,32,39,56,60,61} wired to sys_*_body handlers or inline dispatch. ID 1 (write) uses fast-path for fd∈{1,2}→UART, else sys_write_body. ID 59 (execve) now dispatches to sys_execve_shim (path→image copy-in per #671) which does user_ptr_ok/copy path/vfs_open/page-loop vfs_read/ELF magic/vfs_close, then calls sys_execve_body. ID 60 (exit) now performs real termination (#724 D2): sys_exit_body (marks ZOMBIE, wakes parent, runq_enqueue's woken parent per D5b) → runq_dequeue(current) → sched_pick_next_r15 → sched_switch_r15(next); never returns to the exiting task. ID 61 (wait4) now performs real blocking (#724 D5a): sys_wait_body returns rax=0 when children exist but none are zombies; dispatcher branches to a sched_block invocation, and on resume reads wait_result_{pid,status} from _current_tcb slab (@1704, @1708). ID 4 (cap_invoke) and ID 12 (debug_puts) unchanged. Effects widened to (mem, sysreg) and capabilities to (cap, sched) to cover the union of reachable handlers (sched_block requires @{sched}).",
      block: {
        // Bounds check
        cmp rdi, 61;
        ja dispatch_enosys;

        cmp rdi, 0;
        je dispatch_read;
        cmp rdi, 1;
        je dispatch_write;
        cmp rdi, 2;
        je dispatch_open;
        cmp rdi, 3;
        je dispatch_close;
        cmp rdi, 4;
        je dispatch_cap_invoke;
        cmp rdi, 12;
        je dispatch_debug_puts;
        cmp rdi, 32;
        je dispatch_dup2;
        cmp rdi, 39;
        je dispatch_getpid;
        cmp rdi, 56;
        je dispatch_fork;
        cmp rdi, 59;
        je dispatch_execve;
        cmp rdi, 60;
        je dispatch_exit;
        cmp rdi, 61;
        je dispatch_wait4;
        jmp dispatch_enosys;

        dispatch_read:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd, rdx=buf, rcx=len already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_read_body;
        add rsp, 8;
        ret;

        dispatch_write:
        // #541: user_ptr_ok(buf=rdx, len=rcx) — fault-check before ANY fd
        // path (UART fast-path or sys_write_body). Preserves rsi (fd) and
        // rcx (len) discipline: we need rdx→rdi and rcx→rsi for the call,
        // then restore. Callee (PtrCheck) clobbers only rax; caller regs
        // rsi/rcx/rdx must be re-established before falling through.
        push rsi;
        push rcx;
        push rdx;
        mov rdi, rdx;                         // arg0 = buf
        mov rsi, rcx;                         // arg1 = len
        call user_ptr_ok;
        pop rdx;
        pop rcx;
        pop rsi;
        cmp rax, 0;
        jne dispatch_write_efault;

        // Fast-path: fd 1 or 2 → UART (preserves stdout/stderr until init opens TTY fds)
        cmp rsi, 1;
        je dispatch_write_uart;
        cmp rsi, 2;
        je dispatch_write_uart;
        // Real body for fd >= 3
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd, rdx=buf, rcx=len already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_write_body;
        add rsp, 8;
        ret;

        dispatch_write_uart:
        // R17-M0-730 D10c (#730): route through user_puts_via_walk instead
        // of a raw `mov rax, [rdi]` byte loop. Under strict-KPTI the
        // syscall_entry trampoline flips CR3 to _kernel_pml4_pa (boot PML4)
        // before dispatch runs. The boot PML4's low identity map hits
        // WHATEVER byte sits at PHYSICAL address = user_va, which is NOT
        // the frame the user PML4 mapped user_va to. Same root cause as
        // #724 D4 (sys_debug_puts silent-NUL) — see design
        // r17-m0-724-d4-init-post-iretq-gp.md and
        // r17-m0-730-d10-execve-complete.md §D10c.
        //
        // rsi=fd (unused past this point), rdx=buf (user VA), rcx=len.
        // user_puts_via_walk(rdi=user_va, rsi=len) walks _current_tcb's
        // user_pml4_va per byte and reads via the higher-half identity
        // map, then calls uart_putc. Returns void; we echo len as rax.
        //
        // Alignment: entry rsp %16 == 8 (SysV; dispatch was `call`ed and
        // syscall_dispatch's own `call syscall_dispatch` from syscall_entry
        // left it that way). `push rcx` moves to %16 == 0 — correct for
        // the nested call. `pop rax` restores to %16 == 8 for `ret`.
        push rcx;                             // save len for return + align
        mov rdi, rdx;                         // arg0 = user_va (buf)
        mov rsi, rcx;                         // arg1 = len
        call user_puts_via_walk;              // walks user PML4 + emits
        pop rax;                              // rax = len (echoed)
        ret;

        // #541: EFAULT return — user_ptr_ok rejected buf. Same return
        // convention as the SysV syscall path: rax = -EFAULT sign-extended.
        dispatch_write_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;           // -EFAULT = -14
        ret;

        dispatch_open:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=path, rdx=flags, rcx=mode already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_open_body;
        add rsp, 8;
        ret;

        dispatch_close:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_close_body;
        add rsp, 8;
        ret;

        dispatch_cap_invoke:
        mov rdi, rsi;
        mov rsi, rdx;
        call cap_invoke;
        ret;

        // #724 D4 fix: dispatch_debug_puts now uses user_puts_via_walk,
        // which does a per-byte 4-level page-table walk on
        // _current_tcb.user_pml4_va to translate user_va→phys and reads
        // the byte via the kernel higher-half identity map before calling
        // uart_putc. The previous `mov rdi, rsi; call uart_puts` passed
        // the user VA directly to uart_puts, which walked memory under
        // kernel CR3 (boot PML4's low identity mapping) — and at user's
        // print buffer PA the kernel .bss zeros were read, so uart_puts
        // saw NUL at byte 0 and returned silently. This is why
        // INIT ENTERED RING3 never made it to wire despite init actually
        // executing the sys_debug_puts syscall (confirmed by QEMU
        // interrupt trace: cpl=3 pc=0x4001fd hit 861 times). See design
        // r17-m0-724-d4-init-post-iretq-gp.md §Root Cause.
        dispatch_debug_puts:
        push rdx;                                 // save count for return
        mov rdi, rsi;                             // rdi = user_va (buf)
        mov rsi, rdx;                             // rsi = len (count)
        call user_puts_via_walk;                  // walks + prints
        pop rax;                                  // rax = count (echoed)
        ret;

        dispatch_dup2:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        // rsi=src_fd, rdx=dst_fd already positioned by SysV
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_dup2_body;
        add rsp, 8;
        ret;

        dispatch_getpid:
        mov rax, [rip + _current_tcb];
        mov eax, [rax + 0];                   // TASK_OFF_PID = 0, u32 zero-extends into rax
        ret;

        dispatch_fork:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_fork_body;
        add rsp, 8;
        ret;

        // R17-M0-724-D2 (#724): real termination path — see design/kernel/r17-m0-724-d2-sys-exit-terminate.md.
        // Sequence (all invoked with SysV rsp%16==0 after the single sub rsp,8 prelude,
        // which each nested `call` advances by pushing an 8-byte RA to satisfy the
        // callee's SysV rsp%16==8 entry contract):
        //   (1) sys_exit_body(current, status) — marks current ZOMBIE, wakes parent
        //       if WAITING (three-store: wait_result_pid, wait_result_status, state).
        //   (2) runq_dequeue(current) — remove the ZOMBIE from the circular runqueue
        //       so sched_pick_next_r15 will never re-select it. Precondition (per
        //       #563 §5): task must currently be on the runqueue — init and every
        //       child forked from it are enqueued at task_new / kernel_main time.
        //   (3) sched_pick_next_r15() — returns rax = next TCB (a RUNNABLE task
        //       still on the runqueue, or _idle_tcb if the runqueue is empty).
        //   (4) sched_switch_r15(next) — saves the ZOMBIE's stale kernel-stack rsp
        //       into the ZOMBIE's TCB (harmless waste; the TCB will be reaped by
        //       the parent's sys_wait_body → pid_free chain and its saved state
        //       is never read) and switches to next's stack via iretq-like
        //       synthetic-frame trampoline. Never returns to us.
        // The defensive fallthrough jmp dispatch_exit_halt is unreachable in
        // normal ops; it fires only if sched_switch_r15's continuation somehow
        // re-selected this ZOMBIE — which would require a scheduler bug that
        // failed the runq_dequeue precondition. klog_panic tag = tag_exit_returned.
        dispatch_exit:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_exit_body;                   // (1) mark ZOMBIE, wake parent if WAITING

        mov rdi, [rip + _current_tcb];        // (2) runq_dequeue(current)
        call runq_dequeue;

        call sched_pick_next_r15;             // (3) rax = next TCB (or _idle_tcb)

        mov rdi, rax;                         // (4) sched_switch_r15(next) — no return
        call sched_switch_r15;

        // UNREACHABLE — sched_switch_r15 never returns to a ZOMBIE (runq_dequeue'd).
        // Defensive fallthrough: fire klog_panic with tag_exit_returned so a
        // scheduler-bug regression surfaces on the wire rather than silently
        // corrupting whichever task's kernel stack we resumed onto.
        jmp dispatch_exit_halt;

        dispatch_exit_halt:
        lea rdi, [rip + SUBSYS_INT_];
        lea rsi, [rip + tag_exit_returned];
        call klog_panic;
        jmp dispatch_exit_halt;

        // R17-M0-724-D5a (#724): would-block branch — on sys_wait_body's
        // rax==0 signal, invoke sched_block (which performs the state=WAITING
        // flip, runq_dequeue, sched_pick_next_r15, sched_switch_r15). On
        // resume the parent lands back here; read wait_result_{pid,status}
        // from its own slab (populated by sys_exit_body's wake path @1704,
        // @1708) into rax/rdx, then continue with the writeback + ret.
        // See design/kernel/r17-m0-724-d5-sys-wait-block.md §6 for the
        // full round-trip trace.
        dispatch_wait4:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current
        push rsi;                             // save wstatus user ptr across call
        call sys_wait_body;                   // {rax=pid, rdx=status} or {rax=0} or {rax=-ECHILD}
        pop rsi;                              // restore wstatus ptr
        cmp rax, 0;
        jne dispatch_wait4_writeback;         // reap (rax=pid) or -ECHILD → skip block

        // rax == 0 (would-block): sched_block, then read wait_result on resume.
        push rsi;                             // preserve wstatus ptr across sched_block
        call sched_block;                     // blocks; returns when child exit fires runq_enqueue(parent)
        pop rsi;                              // restore wstatus ptr

        // Resume: read parent's wait_result_{pid,status} into rax/rdx.
        // _current_tcb after sched_switch_r15 is us (the parent) again;
        // sys_exit_body's wake path wrote wait_result_pid @ +1704 and
        // wait_result_status @ +1708 before setting our state=RUNNABLE.
        mov rax, [rip + _current_tcb];
        mov ecx, [rax + 1704];                // wait_result_pid (u32 zero-ext)
        mov edx, [rax + 1708];                // wait_result_status (u32 zero-ext)
        mov rax, rcx;                         // rax = zombie pid

        dispatch_wait4_writeback:
        cmp rsi, 0;
        je dispatch_wait4_done;
        // #724-D5-verify: validate wstatus before writing. Unlike
        // dispatch_write (which calls user_ptr_ok(buf, len) at #541), this
        // writeback wrote through rsi unconditionally — a user program
        // passing an unmapped or kernel-half wstatus pointer would fault
        // the kernel on the raw store. Mirror dispatch_write's pattern:
        // save the live return values (rax=pid, rdx=status) and the
        // pointer itself (rsi, about to be clobbered as the len arg)
        // across the call; user_ptr_ok clobbers rax and rcx (per
        // dispatch_write's save/restore precedent at L85-95), so rax/rdx
        // must be pushed too, not just rsi.
        push rax;                             // save zombie pid (return value)
        push rdx;                             // save status
        push rsi;                             // save wstatus va (about to become len arg)
        mov rdi, rsi;                         // arg0 = wstatus va
        mov rsi, 4;                           // arg1 = len (u32 write width)
        call user_ptr_ok;
        mov r8, rax;                          // stash fault flag (r8 not live here)
        pop rsi;                              // restore wstatus va
        pop rdx;                              // restore status
        pop rax;                              // restore zombie pid
        cmp r8, 0;
        jne dispatch_wait4_efault;
        mov [rsi], edx;                       // write 4-byte status; validated above
        dispatch_wait4_done:
        ret;

        // wstatus failed user_ptr_ok — return -EFAULT (same convention as
        // dispatch_write_efault above).
        dispatch_wait4_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;          // -EFAULT = -14
        ret;

        // R17-M0-671 (#671): sys_execve dispatch shim — bridges SC+ ABI
        // (path, argv, envp) to sys_execve_body(current, image_ptr, image_len).
        // See design/kernel/r17-m0-671-sys-execve-shim.md for full contract.
        // SysV args on entry to dispatch: rsi=path_va, rdx=argv_va, rcx=envp_va.
        // Shim expects: rdi=current, rsi=path_va, rdx=argv_va, rcx=envp_va —
        // exactly matches once we load _current_tcb into rdi.
        dispatch_execve:
        mov rax, [rip + _current_tcb];
        mov rdi, rax;                         // rdi = current (task_struct*)
        // rsi=path_va, rdx=argv_va, rcx=envp_va already SysV-positioned
        sub rsp, 8;                           // #672 MEDIUM: SysV alignment pad
        call sys_execve_shim;                 // {rax, rdx} = errno or (0, entry_rip)
        add rsp, 8;
        ret;

        dispatch_enosys:
        mov rax, 0xFFFFFFFFFFFFFFDA;
        ret
      }
    }

}
