// src/kernel/core/syscall/sys_vol_mint_body.pdx -- PFS-09 (paideia-os#2576)
//
// SYS_VOL_MINT -- hot-plug KIND_VOLUME mint syscall (sysno 135).
//
// -----------------------------------------------------------------------------
// Scope (PFS-09, Wave PFS-W6)
// -----------------------------------------------------------------------------
//
// Hot-plug volume minting: a ring-3 caller (typically `mount.pdxfs` on a
// device that was not seeded at boot via _init_caps) presents a 64-byte
// VolumeDescriptor over a probed KIND_BLKDEV cap and gets back a fresh
// KIND_VOLUME cap_handle it can hand to sys_mount's PdxFS-block arm
// (backend_id=5).
//
// This is a PFS-wave SIBLING to the earlier `sys_volume_mint`
// (sysno 114, R90-XREPO.LV11.M2-003 / paideia-os#2225) landed at
// `handlers/sys_volume_mint.pdx`.  Both syscalls ultimately route
// through the same substrate (volume_cap_mint_inner + cap_mint_write),
// but their ABIs differ at the surface:
//
//                       sys_volume_mint (114)       sys_vol_mint (135, HERE)
//   magic field         u64 "PDXVDSC1"              u32 "PDXV" (0x56584450)
//   descriptor size     40..256 bytes               exactly 64 bytes
//   return discipline   errno (-EFAULT, -EINVAL,    packed u64:
//                       -ENOSPC, -EIO) or slot        (cap_handle<<2) | status
//                                                   status ∈ {0=OK, 1=INVALID,
//                                                             2=OUT_OF_ROWS,
//                                                             3=DENIED}
//   UUID source         explicit uuid_lo/uuid_hi    synthesized from
//                       in descriptor               device_cap + superblock_lba
//
// The task brief (paideia-os#2576) specified `(cap_handle << 1) | status`,
// but a 2-bit status field (values 0..3) needs `<< 2` to avoid
// ambiguity between (cap_handle=1, status=0) and (cap_handle=0,
// status=2).  This file uses `<< 2` and the design doc at
// design/pdxfs/sys-vol-mint-abi.md calls out the deviation.
//
// -----------------------------------------------------------------------------
// Why a sibling syscall and not a reuse of sysno 114
// -----------------------------------------------------------------------------
//
// 1. The task brief froze a specific wire layout (u32 "PDXV" magic,
//    exact 64-byte descriptor, packed return) BEFORE the PFS-09
//    softarch sweep discovered sysno 114 was already in the tree.
// 2. The two ABIs cannot be unified in a single body without breaking
//    one of {sysno 114 callers, sysno 135 wire contract}.  A future
//    consolidation wave (filed in design/pdxfs/sys-vol-mint-abi.md
//    §Future work) deprecates sysno 114 in favour of sysno 135 once
//    the one existing caller (libpdx-volume vol_kind_mint_elevate,
//    v1.1.0 STUB) is rewired.
// 3. Both bodies share THE SAME substrate (volume_cap_mint_inner +
//    cap_mint_write), so there is no logic duplication at the
//    semantics layer -- only two ABI surfaces hitting one engine.
//
// -----------------------------------------------------------------------------
// Contract summary
// -----------------------------------------------------------------------------
//
// sys_vol_mint_body(desc_ptr, desc_len) -> u64
//   Kernel-only entry (no user pointers -- the caller has already
//   bounced the descriptor into a kernel scratch).  Called by the shim
//   below AND by witnesses that exercise the body directly.
//
// sys_vol_mint_shim(desc_va, desc_len) -> u64
//   The dispatch entry (sysno 135 marshals here from dispatch.pdx via
//   dispatch_vol_mint).  Walks the user descriptor into
//   `_sys_vol_mint_desc_scratch` via user_read_bytes_via_walk, then
//   invokes sys_vol_mint_body with the kernel pointer.  Returns the
//   body's result verbatim, or (0<<2)|1 (INVALID) on walker rejection.
//
// -----------------------------------------------------------------------------
// VolumeDescriptor wire format (exactly 64 bytes)
// -----------------------------------------------------------------------------
//
//   offset  size  field
//   +0      4     magic         (u32, LE, = 0x56584450 = "PDXV")
//   +4      4     version       (u32, = SVM_DESC_VERSION = 1)
//   +8      8     device_cap    (u64, cap_slot for a live KIND_BLKDEV)
//   +16     8     block_count   (u64, informational -- stored in uuid_hi
//                                synth for row liveness)
//   +24     8     superblock_lba(u64, informational -- stored in uuid_lo
//                                synth for row liveness)
//   +32     8     flags         (u64, reserved for future use)
//   +40     24    reserved      (zero-filled)
//   -----
//   total   64
//
// NOTE on 64 vs 72 bytes: the task brief listed `reserved: [u8;32]`
// which would push the total to 72.  The brief also stated the
// descriptor is "64 bytes".  The 64-byte total is load-bearing (it is
// the only descriptor size this body accepts); `reserved` is therefore
// 24 bytes.  Design doc §2.1 pins this.
//
// -----------------------------------------------------------------------------
// UUID synthesis -- why block_count/superblock_lba double as uuid
// -----------------------------------------------------------------------------
//
// `volume_tail_alloc` (kind_volume.pdx §tail_alloc) refuses an all-zero
// UUID pair (`uuid_lo == uuid_hi == 0 -> VOL_TAIL_BAD_ARG`).  The
// hot-plug mint path has NOT yet read the superblock, so it has no
// real UUID to supply.  Rather than:
//   (a) widening the descriptor with explicit uuid_lo/uuid_hi (would
//       break the frozen task-spec layout), or
//   (b) relaxing volume_tail_alloc's all-zero check (would weaken an
//       invariant other sites depend on, see sys_volume_mint(114) which
//       takes real uuids),
// this body SYNTHESIZES a non-zero placeholder UUID from the fields
// the descriptor DOES carry:
//
//   uuid_lo_synth = (device_cap << 56) | superblock_lba
//   uuid_hi_synth = (block_count << 1) | 1
//
// `| 1` on uuid_hi_synth guarantees the pair is never all-zero (even
// when the caller passes zero for block_count/superblock_lba), so the
// tail_alloc gate always passes.  When the real probe lands at a
// later wave (currently blocked on PdxFS-block superblock-read
// substrate), `volume_row_mount_gen_set` + a new `volume_row_uuid_set`
// overwrite the synthetic pair with the real on-disk values.  The
// synthetic form is deterministic (same device_cap + superblock_lba
// always synthesizes the same uuid pair) so a caller re-minting after
// a transient tail_alloc failure does not accidentally mint two
// distinct volume rows for the same device.
//
// -----------------------------------------------------------------------------
// Rights gate (R_VOLUME_MINT) -- PFS-09 stub
// -----------------------------------------------------------------------------
//
// The task brief notes "Deny if caller lacks R_VOLUME_MINT right (stub:
// for M1 any caller passes; real rights check in R125)".  This body
// implements the stub: no caller-rights check at this landing.  Every
// successful descriptor validation + volume_cap_mint_inner success
// returns a live cap_handle, regardless of the caller's cap-env state.
// R125 (the capability-rights wave) will insert a rights check at the
// head of this body between (1) descriptor parse and (2) cap_table
// device_cap verification; the signature and failure taxonomy stay
// byte-identical so a caller compiled against this landing does not
// need to re-link when the rights check goes real.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 2-bit `status` field in the packed return
// -----------------------------------------------------------------------------
//
//   SVM_STATUS_OK                = 0  on success; cap_handle is live
//   SVM_STATUS_INVALID_DESCRIPTOR= 1  descriptor_len != 64, bad magic,
//                                      bad version, device_cap >= 256,
//                                      device_cap's cap_table slot is
//                                      NOT a live KIND_BLKDEV, OR the
//                                      shim's walker rejected the user
//                                      pointer (shim synthesizes INVALID
//                                      rather than a separate -EFAULT so
//                                      the caller has one error class to
//                                      handle for "bad input" cases)
//   SVM_STATUS_OUT_OF_ROWS       = 2  volume_cap_mint_inner returned
//                                      VOL_REGISTRY_FULL / VOL_TAIL_
//                                      BAD_ARG, OR cap-slot pool
//                                      [SVM_CAP_POOL_LO..HI) exhausted
//   SVM_STATUS_DENIED            = 3  R125 rights check refused (stub
//                                      path is unreachable at PFS-09)
//
// On any error, cap_handle in the packed return is 0.  On success,
// cap_handle is a cap_slot in [SVM_CAP_POOL_LO, SVM_CAP_POOL_HI).
//
// -----------------------------------------------------------------------------
// Cap-slot pool
// -----------------------------------------------------------------------------
//
// Fixed range [SVM_CAP_POOL_LO .. SVM_CAP_POOL_HI) = [240, 256).  16
// slots -- one per VOL_MAX ceiling (kind_volume.pdx L217).  Disjoint
// from every other claimed pool in the kernel today:
//
//   sys_mount block-arm           [224, 232)  -- 8 slots
//   sys_volume_mint(114)          whole table (first-fit; see §cap-slot
//                                              overlap below)
//   mount_table_root_volume       {176}       -- MBOT_ROOT_VOLUME_CAP_SLOT
//   r30 thermal / tb_route witns  [216, 232)  -- boot-transient
//   sys_framebuffer_create stage  {132}
//   iris_xe_vblank_isr stage      {133}
//   sys_volume_mint(114) stage    {134}
//   pdxfs_pkg_install witness     {136}
//   r104_iris_xe_flip witness     {137}
//
// Slot 134 is specifically consumed by sys_volume_mint(114)'s staging
// slot (handlers/sys_volume_mint.pdx L120 SYSVM_STAGING_SLOT), so this
// body's pool starts cleanly at 240.
//
// Overlap with sys_volume_mint(114): sysno 114's body scans the WHOLE
// table (0..256) for a free slot and could land inside [240..256).  At
// PFS-09 this is a theoretical overlap -- no caller invokes BOTH
// syscalls -- but the design doc flags it as a hazard to resolve in
// the consolidation wave.
//
// -----------------------------------------------------------------------------
// Dispatch wiring
// -----------------------------------------------------------------------------
//
//   src/kernel/core/syscall/dispatch.pdx
//     Bounds check widened 134 -> 135 at the top of the switch.
//     New arm:  cmp rdi, 135; je dispatch_vol_mint;
//     New label: dispatch_vol_mint (register shuffle + call sys_vol_mint_shim).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-pitfall discipline
// -----------------------------------------------------------------------------
//
// - KIND_VOLUME (0x1A0) and KIND_BLKDEV (0x42) both stage through r11
//   where cmp against them matters.
// - PDXV magic (0x56584450) fits imm32 sign-extend (bit 31 is 0), used
//   directly as `cmp eax, 0x56584450` would be legal but this file
//   stages through r11 for uniformity and to keep the 32-bit compare
//   above the fold without a mov_d.
// - No `add reg, [mem]`.
// - No byte loads except the single `mov eax, [mem]` for the magic
//   u32 read -- staged via `mov rax, [+0]; and rax, 0xFFFFFFFF` to
//   extract the low 32 bits without a `mov_d` encoder round-trip.
// - No `test`; every zero-check is `cmp reg, 0`.
// - No `imul`; slot*24 is slot*8 + slot*16 via two shifts.
// - Labels prefixed `svm_` (sys-vol-mint).  Grep-audit 2026-10-11:
//   sys_volume_mint(114) uses `svm_` too (handlers/sys_volume_mint.pdx
//   L188); the two bodies live in different modules
//   (`SysVolumeMint` vs `SysVolMint`), so paideia-as's module-qualified
//   label-name resolution makes the sharing safe -- each body sees
//   only its own `svm_*` labels.
//
// -----------------------------------------------------------------------------
// klog slot v2 posture (`[rsp+0]`)
// -----------------------------------------------------------------------------
//
// The task brief names "klog slot v2 at [rsp+0]" as the fingerprint-
// emit convention.  PFS-09 does NOT emit a fingerprint from this body
// (no new tag added to klog/keys.pdx at this landing -- deferred to a
// later wave to keep the registration churn small).  The slot-v2
// stack-pass pattern is called out in the sibling sys_volume_mint(114)
// body (`push r13;  call klog_s1_d2`) for reference when the
// fingerprint lands here.

module SysVolMintBody = structure {

  // ============================================================================
  // Wire-level constants (§VolumeDescriptor wire format)
  // ============================================================================

  // "PDXV" in little-endian u32 ASCII:
  //   byte 0 = 'P' = 0x50
  //   byte 1 = 'D' = 0x44
  //   byte 2 = 'X' = 0x58
  //   byte 3 = 'V' = 0x56
  //   -> u32 = 0x56584450.
  pub let SVM_DESC_MAGIC   : u64 = 0x56584450

  // Descriptor version. Bumps when the wire layout changes
  // incompatibly; a body reading v1 refuses v2+ with INVALID and vice
  // versa.
  pub let SVM_DESC_VERSION : u64 = 1

  // Exact descriptor size -- any other length -> INVALID.
  pub let SVM_DESC_BYTES   : u64 = 64

  // Scratch is sized to exactly SVM_DESC_BYTES; a caller sending more
  // or less bytes is refused by the length gate before any walker call
  // reaches this buffer.
  pub let mut _sys_vol_mint_desc_scratch : [u8; 64] = uninit @align(8)

  // ============================================================================
  // Status field (bits [1:0] of the packed return)
  // ============================================================================

  pub let SVM_STATUS_OK                 : u64 = 0
  pub let SVM_STATUS_INVALID_DESCRIPTOR : u64 = 1
  pub let SVM_STATUS_OUT_OF_ROWS        : u64 = 2
  pub let SVM_STATUS_DENIED             : u64 = 3

  // Shift count for cap_handle in the packed return. The brief said
  // `<< 1`; we use `<< 2` to accommodate the 2-bit status field without
  // collision (see file header deviation note). Design doc §3.2 pins.
  pub let SVM_STATUS_BITS : u64 = 2

  // ============================================================================
  // Cap-slot pool (§Cap-slot pool)
  // ============================================================================

  pub let SVM_CAP_POOL_LO : u64 = 240
  pub let SVM_CAP_POOL_HI : u64 = 256

  // ============================================================================
  // Substrate constants duplicated locally (per-module convention --
  // paideia-as has no cross-module `let` import; see sys_mount.pdx
  // L349 and handlers/sys_volume_mint.pdx L131 for the same pattern)
  // ============================================================================

  pub let SVM_KIND_VOLUME     : u64 = 0x1A0
  pub let SVM_KIND_BLKDEV     : u64 = 0x42
  pub let SVM_KIND_MEMORY     : u64 = 4
  pub let SVM_RIGHT_MINT      : u64 = 0x200
  // R_VOL_READ (0x001) | R_VOL_INVOKE (0x008) | R_VOL_OBSERVE (0x400)
  // = 0x409. Legal subset of R_VOL_ALL (0x43B).
  pub let SVM_R_VOL_PUBLISH   : u64 = 0x409
  // At publish time only INVOKE | OBSERVE are granted to the caller;
  // READ is reserved for mount-table operations that this cap does
  // not directly expose.
  pub let SVM_R_VOL_HANDLE    : u64 = 0x408
  pub let SVM_CAP_SLOT_MAX    : u64 = 256
  pub let SVM_VOL_MAX         : u64 = 16

  // Transient KIND_MEMORY parent staging slot. Matches
  // handlers/sys_volume_mint.pdx L120 SYSVM_STAGING_SLOT (134); using
  // the same slot is safe because sysno 114 and sysno 135 cannot be
  // issued simultaneously by a single ring-3 caller (both are
  // synchronous syscalls on the current task), and the staging slot is
  // scrubbed within each body before return. The slot is still a
  // design-doc-tracked single-writer resource (grep for 134 in
  // src/kernel/core/syscall/).
  pub let SVM_STAGING_SLOT : u64 = 134

  // ============================================================================
  // sys_vol_mint_body(desc_ptr, desc_len) -> u64
  //
  // SysV: rdi=desc_ptr (kernel VA of a 64-byte descriptor),
  //       rsi=desc_len
  //   -> rax = (cap_handle << 2) | status  (status in bits [1:0])
  //
  // Sequence:
  //   (1) desc_len == SVM_DESC_BYTES else INVALID.
  //   (2) Parse magic (@+0, u32), version (@+4, u32); any mismatch
  //       -> INVALID.
  //   (3) Parse device_cap (@+8, u64); device_cap >= 256 -> INVALID.
  //   (4) Verify cap_table[device_cap].kind == KIND_BLKDEV else
  //       INVALID.  (Hot-plug mint requires the caller already holds
  //       a probe-minted KIND_BLKDEV cap; a synthetic cap or a cap
  //       for a different kind is a programming error, mapped to
  //       INVALID rather than DENIED since the DENIED path is
  //       reserved for the R125 rights check.)
  //   (5) Parse block_count (@+16), superblock_lba (@+24), flags
  //       (@+32).  Reserved bytes (@+40..64) are not checked -- the
  //       spec says "zero-filled" but a nonzero reserved byte is not
  //       a protocol error (forward-compat).
  //   (6) Synthesize uuid pair:
  //         uuid_lo = (device_cap << 56) | superblock_lba
  //         uuid_hi = (block_count << 1) | 1
  //       `| 1` guarantees uuid_hi != 0, so the pair is never
  //       all-zero.
  //   (7) Build volume_hdr via inline compute (device_slot in [39:24],
  //       mount_slot = 0xFFFF in [55:40]).
  //   (8) Stage transient KIND_MEMORY parent at SVM_STAGING_SLOT via
  //       cap_mint_write(134, KIND_MEMORY, RIGHT_MINT, 0).
  //   (9) volume_cap_mint_inner(134, SVM_R_VOL_PUBLISH, hdr, uuid_lo,
  //       uuid_hi) -> row_id in [0, 16) or VOL_MINT_* sentinel.
  //       Any sentinel >= 16 -> OUT_OF_ROWS (fold VOL_REGISTRY_FULL,
  //       VOL_TAIL_BAD_ARG, VOL_MINT_BAD_PARENT, VOL_MINT_BAD_RIGHTS
  //       into one surface code).
  //   (10) Scrub the staging slot via cap_mint_write(134, 0, 0, 0).
  //   (11) Scan cap_table[SVM_CAP_POOL_LO..SVM_CAP_POOL_HI) for a
  //        kind==0 slot.  Exhausted -> OUT_OF_ROWS.
  //   (12) cap_mint_write(cap_slot, KIND_VOLUME, SVM_R_VOL_HANDLE,
  //        row_id).
  //   (13) Pack return: rax = (cap_slot << 2) | 0.
  //
  // Register plan (6-push callee-save prologue + sub rsp,8 pad lands
  // rsp%16==0 at every nested call from entry rsp%16==8):
  //   rbx = desc_ptr               (dead after step 5)
  //   r12 = device_cap             (survives to step 8+ for uuid synth)
  //   r13 = hdr -> row_id          (hdr at step 7; row_id at step 9+)
  //   r14 = uuid_lo synth -> cap_slot (uuid_lo at step 6..9; cap_slot
  //                                    at step 11+)
  //   r15 = uuid_hi synth
  //   rbp = reserved for a future block_count-scoped sanity gate
  //
  // Alignment: 6 pushes (48 B) + sub rsp,8 (8 B) = 56 B. From entry
  // %16==8, +56 -> %16==0 for every nested call site.
  // ============================================================================

  pub let sys_vol_mint_body : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (desc_ptr: u64) (desc_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PFS-09 (paideia-os#2576): sys_vol_mint body, SC+ ID 135. Entry: rdi=desc_ptr (kernel VA of a 64-byte descriptor; shim has already walked user bytes into _sys_vol_mint_desc_scratch), rsi=desc_len. Sequence: (1) desc_len == 64 else pack INVALID; (2) magic @+0 u32 == 0x56584450 (PDXV LE) else INVALID -- read via mov eax,[+0] which zero-extends under paideia-as's eax semantics, no mov_d needed; (3) version @+4 u32 == 1 else INVALID -- same zero-extend eax load; (4) device_cap @+8 u64 bounds-checked < 256 (staged via r11 since 256 is a well-formed imm32 but staging keeps the pattern uniform with KIND-tag compares) else INVALID; (5) cap_table[device_cap].kind == KIND_BLKDEV (0x42) else INVALID -- slot*24 computed via slot*8 + slot*16 shift-pair to stay off the 2-op imul encoder pitfall (sys_mount.pdx L598-611 precedent); (6) parse block_count @+16, superblock_lba @+24, flags @+32 (flags unused this landing, reserved for future); (7) synthesize uuid_lo = (device_cap << 56) | superblock_lba, uuid_hi = (block_count << 1) | 1 so the pair is never all-zero regardless of block_count/superblock_lba (bypasses volume_tail_alloc's uuid-zero gate; see file header §UUID synthesis for rationale); (8) pack hdr inline: device_slot in [39:24] | mount_slot 0xFFFF in [55:40]; (9) stage KIND_MEMORY parent at SVM_STAGING_SLOT=134 via cap_mint_write(134, KIND_MEMORY, RIGHT_MINT, 0) -- same transient-staging pattern as sys_volume_mint(114) L258-264; (10) volume_cap_mint_inner(134, SVM_R_VOL_PUBLISH=0x409, hdr, uuid_lo, uuid_hi) -> row_id in [0,16) or sentinel (>= 16 means VOL_REGISTRY_FULL / VOL_TAIL_BAD_ARG / VOL_MINT_BAD_PARENT / VOL_MINT_BAD_RIGHTS; fold all into OUT_OF_ROWS at the surface -- the DENIED path is reserved for the R125 rights check which is a stub pass at PFS-09); (11) scrub the staging slot via cap_mint_write(134, 0, 0, 0) so transient KIND_MEMORY authority does not leak past the mint; (12) linear scan cap_table[SVM_CAP_POOL_LO..SVM_CAP_POOL_HI) = [240..256) for kind==0; exhaustion -> OUT_OF_ROWS; (13) cap_mint_write(cap_slot, KIND_VOLUME=0x1A0, SVM_R_VOL_HANDLE=0x408 (INVOKE|OBSERVE), target_ptr=row_id); (14) pack rax = (cap_slot << 2) | SVM_STATUS_OK. Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + sub rsp,8 pad = 56 bytes; from entry rsp%16==8, +56 -> %16==0 for every nested call. Failure funnels: svm_invalid / svm_out_of_rows set rax to the packed status code (cap_handle=0, status in bits [1:0]) and jmp svm_out. The DENIED code (status=3) is wired as an unreachable label at PFS-09 so a future R125 rights-check landing can route to it without touching the funnel scaffolding. Effects {mem, sysreg}: mem for scratch read + volume row writes + cap_table writes; sysreg transitively inherited from volume_cap_mint_inner's own posture (and from any future klog_s1_d2 fingerprint when it lands). Capabilities {cap}: transitively via cap_mint_write + volume_cap_mint_inner. Encoder-conservative: no add reg,[mem]; no mov_bzx / mov_wzx; no test; magic 0x56584450 is a plain imm32 (bit 31 clear, sign-extends to 0x0000000056584450 under paideia-as); KIND-tag 0x1A0 and 0x42 stage through r11. Labels prefixed svm_ -- grep audit 2026-10-11: handlers/sys_volume_mint.pdx uses svm_ too but lives in module SysVolumeMint; this file's module is SysVolMint, so paideia-as's module-scoped label resolution keeps them disjoint.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // desc_ptr (dead after step 5)

        // ---- (1) Length gate ----
        mov r10, 64;                     // SVM_DESC_BYTES
        cmp rsi, r10;
        jne svm_invalid;

        // ---- (2) Magic @+0 (u32 LE = 0x56584450) ----
        // Load full qword then mask low 32 bits to compare against the
        // u32 magic; this avoids a mov_d encoder round-trip while
        // reading only the lane the descriptor defines as `magic`.
        mov rax, [rbx + 0];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r11, 0x56584450;             // SVM_DESC_MAGIC
        cmp rax, r11;
        jne svm_invalid;

        // ---- (3) Version @+4 (u32 LE = 1) ----
        // Same low-32-bit extract: load qword @+0 (magic+version), shift
        // right 32 to put version in low 32 bits, mask low 32 (defensive
        // in case upper bits ever carry garbage from a future layout
        // bump).
        mov rax, [rbx + 0];
        shr rax, 32;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r11, 1;                      // SVM_DESC_VERSION
        cmp rax, r11;
        jne svm_invalid;

        // ---- (4) device_cap @+8 (u64) bounds ----
        mov r12, [rbx + 8];              // r12 = device_cap
        mov r11, 256;                    // SVM_CAP_SLOT_MAX
        cmp r12, r11;
        jae svm_invalid;

        // ---- (5) cap_table[device_cap].kind == KIND_BLKDEV ----
        //   descriptor stride = 24 (cap/table.pdx CAP_DESC_BYTES);
        //   compute slot*24 as slot*8 + slot*16 (two shifts) to stay
        //   off the 2-op imul encoder pitfall (sys_mount.pdx L598-611
        //   precedent).
        lea rax, [rip + cap_table];
        mov r10, r12;
        shl r10, 3;                      // slot*8
        mov r11, r12;
        shl r11, 4;                      // slot*16
        add r10, r11;                    // slot*24
        add rax, r10;
        mov rcx, [rax + 0];              // kind field @+0
        mov r11, 0x42;                   // SVM_KIND_BLKDEV
        cmp rcx, r11;
        jne svm_invalid;

        // ---- (6/7) Read descriptor payload fields ----
        mov r13, [rbx + 16];             // r13 = block_count (temp)
        mov r14, [rbx + 24];             // r14 = superblock_lba (temp)
        // flags @+32 is reserved for future use at this landing;
        // read-and-discard to document the layout but not gate on it.
        mov rax, [rbx + 32];
        // (flags intentionally unused; keep load so future gates can
        //  wire in without needing to re-touch this prologue.)

        // ---- (6) Synthesize uuid pair ----
        //   uuid_lo = (device_cap << 56) | superblock_lba
        //   uuid_hi = (block_count << 1) | 1
        mov rax, r12;                    // device_cap
        shl rax, 56;                     // device_cap << 56
        or  rax, r14;                    // | superblock_lba
        mov r14, rax;                    // r14 = uuid_lo synth

        mov rax, r13;                    // block_count
        shl rax, 1;                      // block_count << 1
        or  rax, 1;                      // | 1 -- guarantees non-zero
        mov r15, rax;                    // r15 = uuid_hi synth

        // ---- (7) Pack hdr inline ----
        //   device_slot in [39:24] | mount_slot 0xFFFF in [55:40].
        //   Bits [63:56] left zero (volume_tail_alloc writes in_use
        //   itself).
        mov rax, r12;                    // device_cap (<= 0xFFFF)
        shl rax, 24;                     // device_slot in [39:24]
        mov r11, 0xFFFF;
        shl r11, 40;                     // mount_slot 0xFFFF in [55:40]
        or  rax, r11;
        mov r13, rax;                    // r13 = hdr

        // ---- (8) Stage KIND_MEMORY parent at SVM_STAGING_SLOT ----
        //   cap_mint_write(134, KIND_MEMORY=4, RIGHT_MINT=0x200, 0).
        mov rdi, 134;                    // SVM_STAGING_SLOT
        mov rsi, 4;                      // SVM_KIND_MEMORY
        mov rdx, 0x200;                  // SVM_RIGHT_MINT
        xor rcx, rcx;                    // target_ptr = 0 (opaque)
        call cap_mint_write;

        // ---- (9) volume_cap_mint_inner(parent=134, rights=0x409,
        //          hdr, uuid_lo, uuid_hi) ----
        mov rdi, 134;                    // parent_slot
        mov rsi, 0x409;                  // SVM_R_VOL_PUBLISH
        mov rdx, r13;                    // hdr
        mov rcx, r14;                    // uuid_lo synth
        mov r8,  r15;                    // uuid_hi synth
        call volume_cap_mint_inner;
        // rax = row_id in [0,16) or sentinel >= 16.
        mov r10, 16;                     // SVM_VOL_MAX
        cmp rax, r10;
        jae svm_out_of_rows;
        mov r13, rax;                    // r13 = row_id (survives)

        // ---- (10) Scrub the staging slot ----
        mov rdi, 134;                    // SVM_STAGING_SLOT
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // ---- (11) Free-slot scan in [SVM_CAP_POOL_LO .. HI) ----
        //   r14 (uuid_lo synth) dead post step 9; reused as cursor.
        mov r14, 240;                    // SVM_CAP_POOL_LO
      svm_scan:
        mov r10, 256;                    // SVM_CAP_POOL_HI
        cmp r14, r10;
        jae svm_out_of_rows;

        lea rax, [rip + cap_table];
        mov r10, r14;
        shl r10, 3;                      // slot*8
        mov r11, r14;
        shl r11, 4;                      // slot*16
        add r10, r11;                    // slot*24
        add rax, r10;
        mov rcx, [rax + 0];              // kind @+0
        cmp rcx, 0;
        je  svm_slot_ok;

        add r14, 1;
        jmp svm_scan;

      svm_slot_ok:
        // ---- (12) Publish KIND_VOLUME cap at r14 ----
        //   cap_mint_write(cap_slot, KIND_VOLUME=0x1A0,
        //                  SVM_R_VOL_HANDLE=0x408, target=row_id).
        mov rdi, r14;                    // cap_slot
        mov rsi, 0x1A0;                  // SVM_KIND_VOLUME
        mov rdx, 0x408;                  // SVM_R_VOL_HANDLE
        mov rcx, r13;                    // target = row_id
        call cap_mint_write;

        // ---- (13) Pack return: (cap_slot << 2) | OK ----
        mov rax, r14;                    // cap_slot
        shl rax, 2;                      // << SVM_STATUS_BITS
        or  rax, 0;                      // | SVM_STATUS_OK (no-op; keeps
                                         //   the ABI pattern visible)
        jmp svm_out;

      svm_invalid:
        // (0 << 2) | 1 = 1.
        mov rax, 1;                      // SVM_STATUS_INVALID_DESCRIPTOR
        jmp svm_out;

      svm_out_of_rows:
        // (0 << 2) | 2 = 2.
        mov rax, 2;                      // SVM_STATUS_OUT_OF_ROWS
        jmp svm_out;

      svm_denied:
        // (0 << 2) | 3 = 3.  Unreachable at PFS-09 -- reserved for the
        // R125 rights-check landing (file header §Rights gate).
        mov rax, 3;                      // SVM_STATUS_DENIED

      svm_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sys_vol_mint_shim(desc_va, desc_len) -> u64
  //
  // Dispatch entry (sysno 135 marshals here from dispatch.pdx via
  // dispatch_vol_mint).
  //
  // SysV: rdi=desc_va, rsi=desc_len
  //   -> rax = sys_vol_mint_body's return, OR (0 << 2) | 1 = 1
  //      (SVM_STATUS_INVALID_DESCRIPTOR) on walker rejection.
  //
  // Bounces the user descriptor into _sys_vol_mint_desc_scratch via
  // user_read_bytes_via_walk (per-byte KPTI-safe walk through
  // _current_tcb's user_pml4_va), then calls sys_vol_mint_body with
  // the kernel pointer.  Length pre-gating (desc_len == SVM_DESC_BYTES)
  // happens HERE too, before any walker call, so a caller passing
  // len=1_000_000 gets INVALID immediately rather than a walker
  // over-read attempt.  (The body's own gate re-checks for defense in
  // depth and for kernel witnesses that bypass the shim.)
  //
  // Register plan (3-push callee-save prologue + sub rsp,8 pad lands
  // rsp%16==0 at every nested call from entry rsp%16==8):
  //   rbx = desc_va           (arg0 to user_ptr_ok + user_read_bytes_via_walk)
  //   r12 = desc_len          (arg1 to user_ptr_ok + user_read_bytes_via_walk)
  //   r13 = unused            (push for 16-byte alignment; 3 pushes +
  //                            sub rsp,8 = 32 B = %16 == 0)
  //
  // Alignment: entry %16==8, 3 pushes -> %16==8, sub rsp,8 -> %16==0.
  // ============================================================================

  pub let sys_vol_mint_shim : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (desc_va: u64) (desc_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PFS-09 (paideia-os#2576): sys_vol_mint dispatch shim. Walks the user descriptor into _sys_vol_mint_desc_scratch via user_ptr_ok + user_read_bytes_via_walk (same KPTI-bounce discipline as sys_mount.pdx L764-841), then calls sys_vol_mint_body with the kernel pointer. Length pre-gate (desc_len == 64) runs BEFORE any walker call so a caller passing len=10_000 is refused with INVALID immediately rather than a walker over-read attempt. Walker rejection folds to INVALID (packed status=1 with cap_handle=0 -> rax=1) so the caller has one error class to handle for 'bad input'; the body's own gate re-checks for defense in depth and for kernel-witness callers that bypass this shim. 3-push callee-save prologue (rbx=desc_va, r12=desc_len, r13 pushed for 16-byte alignment only) + sub rsp,8 pad lands rsp%16==0 at every nested call from entry rsp%16==8. Encoder-conservative: no add reg,[mem]; no test; immediate 64 is small, used directly. Labels prefixed svs_ (sys-vol-mint-shim; distinct from svm_ to keep the body's and shim's label namespaces disjoint).",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                    // desc_va
        mov r12, rsi;                    // desc_len

        // ---- Length pre-gate ----
        mov r10, 64;                     // SVM_DESC_BYTES
        cmp r12, r10;
        jne svs_invalid;

        // ---- user_ptr_ok(desc_va, 64) ----
        mov rdi, rbx;
        mov rsi, r12;
        call user_ptr_ok;
        cmp rax, 0;
        jne svs_invalid;

        // ---- user_read_bytes_via_walk(scratch, desc_va, 64) ----
        lea rdi, [rip + _sys_vol_mint_desc_scratch];
        mov rsi, rbx;
        mov rdx, r12;
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne svs_invalid;

        // ---- Body call ----
        lea rdi, [rip + _sys_vol_mint_desc_scratch];
        mov rsi, r12;
        call sys_vol_mint_body;
        jmp svs_done;

      svs_invalid:
        mov rax, 1;                      // (0 << 2) | SVM_STATUS_INVALID_DESCRIPTOR

      svs_done:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
