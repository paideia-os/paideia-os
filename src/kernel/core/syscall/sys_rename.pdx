// src/kernel/core/syscall/sys_rename.pdx -- R56.M3-005 (paideia-os #1794)
//
// SYS_RENAME -- ring-3 rename syscall body (sysno 82).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/kernel/vfs-metadata-syscalls.md and paideia-os R56.M3 milestone
// item R56.M3-005:
//
//   "New src/kernel/core/syscall/sys_rename.pdx (body).
//    rdi=old_va, rsi=old_len, rdx=new_va, rcx=new_len.
//    Split each path into (parent, leaf).  Same-parent case:
//    dispatch through the new R56 vops_rename slot with
//    (parent_vn, old_leaf, old_len, new_leaf, new_len).
//    Cross-parent case: refuse with -EXDEV at R56.M3 (WAL-atomic
//    cross-directory rename lands with the R57 lifecycle round)."
//
// The R56.M3-001 sibling (paideia-os #1790) widened dispatch.pdx's bounds
// check from 76 -> 82 and added six ENOSYS forward-declaration stubs.
// This landing rewrites dispatch_rename from that stub into a real shim
// that calls sys_rename_body defined below.
//
// -----------------------------------------------------------------------------
// Cross-directory posture
// -----------------------------------------------------------------------------
//
// A same-directory rename is one WAL record: overwrite one dentry slot
// with the (inode_id, new_name) tuple.  A cross-directory rename is TWO
// operations (remove-from-old + add-to-new) that must be atomic (a
// crash between them leaves an orphaned inode with two refs OR none).
// The WAL substrate (src/kernel/core/fs/pdxfs/wal.pdx) can serialize a
// two-op record and replay both halves on recovery, but the on-disk
// dentry directory format needed to append a new record on the target
// parent is a follow-up (pdxfs_lite has no dir_append; pdxfs_block's
// dir walker is the R52.M6 kind_pdxfs_txn.pdx PXT_OP_* wire).  Rather
// than land a half-working cross-dir path that a real userspace tool
// would trip over, this landing:
//
//   (a) validates same-parent up front (byte-compare the parent
//       prefixes of old_path and new_path);
//   (b) returns -EXDEV on mismatch (matches Linux's "cross-device"
//       errno, appropriately overloaded here for "cross-directory" --
//       POSIX allows this discrimination since the ring-3 tool's next
//       action -- fall back to copy-then-unlink -- is the same);
//   (c) delegates same-parent rename to the per-backend vops_rename
//       adapter (tmpfs: in-place inode name rewrite; pdxfs_lite: wraps
//       existing pdxfs_lite_rename which stages the new dirent record
//       in scratch and returns EROFS pending nvme_write_blocking;
//       pdxfs_block: MOUNT_BACKEND_UNKNOWN stub pending R52.M6).
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
//   0                            -- success
//   0xFFFFFFFFFFFFFFF2 (-EFAULT) -- either user pointer refused or
//                                    walker fault mid-copy
//   0xFFFFFFFFFFFFFFEA (-EINVAL) -- old or new path lacks a '/', is the
//                                    root itself, or ends with a trailing
//                                    slash
//   0xFFFFFFFFFFFFFFEE (-EXDEV)  -- parents of old and new differ (cross
//                                    -directory rename deferred to R57;
//                                    see §Cross-directory posture)
//   0xFFFFFFFFFFFFFFFE (-ENOENT) -- parent path did not resolve OR the
//                                    backend adapter returned an error
//
// -----------------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------------
//
// Per the R56.M3-005 task pin:
//   `!{mem, sysreg} @{cap}`
//
// mem: path_resolve + vops_rename field reads; three scratch copies.
// sysreg: two user_read_str_via_walk calls + klog wire emit.
// cap: forward-compat placeholder for a R57+ per-mount VOL_RIGHT_RENAME
//      gate.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `sysren_`.

module SysRename = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================

  pub let SYS_RENAME_OK               : u64 = 0
  pub let SYS_RENAME_ERR_ENOENT       : u64 = 0xFFFFFFFFFFFFFFFE
  pub let SYS_RENAME_ERR_EFAULT       : u64 = 0xFFFFFFFFFFFFFFF2
  pub let SYS_RENAME_ERR_EINVAL       : u64 = 0xFFFFFFFFFFFFFFEA
  pub let SYS_RENAME_ERR_EXDEV        : u64 = 0xFFFFFFFFFFFFFFEE

  pub let SYS_RENAME_PATH_MAX         : u64 = 256

  // ==========================================================================
  // Static storage
  // ==========================================================================

  // Per-syscall bounce scratches.  Three of them because a rename walks
  // TWO user paths and derives ONE parent prefix from them.  Single-flow
  // at R56.M3 (matches the sibling sys_stat / sys_unlink scratches).
  pub let mut _sys_rename_old_scratch    : [u8; 256] = uninit @align(8)
  pub let mut _sys_rename_new_scratch    : [u8; 256] = uninit @align(8)
  pub let mut _sys_rename_parent_scratch : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // sys_rename_body(old_va, old_len, new_va, new_len) -> u64
  //
  // SysV: rdi=old_va (user), rsi=old_len (hint), rdx=new_va (user),
  //       rcx=new_len (hint).
  //   -> rax = 0 on success, or -errno on failure.
  //
  // Sequence:
  //   (1) Cap old_len, new_len at SYS_RENAME_PATH_MAX-1 = 255.  Widen
  //       zero-length to cap=1 so the walker sees at least one byte.
  //   (2) user_read_str_via_walk(old_va, &old_scratch, cap) -> strlen.
  //       0 -> -EFAULT.  Save strlen in a frame slot.
  //   (3) user_read_str_via_walk(new_va, &new_scratch, cap) -> strlen.
  //       0 -> -EFAULT.  Save strlen in a frame slot.
  //   (4) Find last '/' in each scratch (call it old_ls, new_ls).  If
  //       either miss, or either == 0 with strlen == 1 (path == "/"),
  //       or basename length == 0 (trailing slash), fail -EINVAL.
  //   (5) Same-parent check: old_ls == new_ls AND memcmp(old[0..old_ls),
  //       new[0..new_ls)) == 0.  Fail -EXDEV on mismatch.
  //   (6) Copy old_scratch[0..old_ls) into _sys_rename_parent_scratch
  //       and NUL-terminate; if old_ls == 0 use "/\0".
  //   (7) mount_root_vnode() -> root_idx.  0 -> -ENOENT.
  //   (8) path_resolve(&parent_scratch, root_idx, 0) -> parent_idx.
  //       0 -> -ENOENT.
  //   (9) vnode_slot(parent_idx) -> &parent_vnode.
  //  (10) vops_rename(&parent_vn, old_leaf_ptr, old_leaf_len,
  //                   new_leaf_ptr, new_leaf_len) -> 0 or errno.
  //       Non-zero -> -ENOENT (uniform ring-3 taxonomy).
  //  (11) Fingerprint emit: klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS_,
  //       tag_sys_rename_ok, k_from, &old_scratch, k_to, &new_scratch).
  //  (12) Return 0.
  //
  // Register plan (rbp-based frame + 5-push callee-save prologue + sub
  // rsp, 32 for 4 u64 spill slots; alignment invariant %16==0 pre-nested
  // call):
  //
  //   Prologue instrs:
  //     push rbp        ; entry rsp%16==8; -> %16==0. rbp := prev rsp
  //     mov rbp, rsp    ; rbp = rsp (currently %16==0).
  //     push rbx        ; %16==8. Saved at [rbp-8].
  //     push r12        ; %16==0. Saved at [rbp-16].
  //     push r13        ; %16==8. Saved at [rbp-24].
  //     push r14        ; %16==0. Saved at [rbp-32].
  //     push r15        ; %16==8. Saved at [rbp-40].
  //     sub rsp, 32     ; %16==(8-32) mod 16 == 8, WRONG.  Use 40 -> %16==0.
  //   Actual: sub rsp, 40 (5 u64 slots + 1 pad).
  //
  //   Callee-save regs (post-prologue):
  //     rbx = old_va             (unused post-walker; kept for prologue-uniformity)
  //     r12 = new_va             (unused post-walker)
  //     r13 = &parent_vnode      (from step 9; consumed at step 10)
  //     r14 = old_last_slash     (from step 4; consumed at steps 6/10)
  //     r15 = new_last_slash     (from step 4; consumed at step 10)
  //
  //   Frame slots (all u64; below the saved-regs area at [rbp-40..)):
  //     [rbp-48] = old_strlen
  //     [rbp-56] = new_strlen
  //     [rbp-64] = old_cap (post cap+widen)
  //     [rbp-72] = new_cap (post cap+widen)
  //     [rbp-80] = pad (alignment)
  //
  // ==========================================================================
  pub let sys_rename_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (old_va: u64) (old_len: u64) (new_va: u64) (new_len: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R56.M3-005 (#1794): sys_rename body -- ring-3 rename syscall (sysno 82). Walks two user paths into two kernel .bss scratches via user_read_str_via_walk, byte-compares their parent prefixes to enforce same-directory (-EXDEV on mismatch pending R57 cross-dir round), copies the shared parent prefix into a third scratch, resolves parent via mount_root_vnode + path_resolve, dispatches through the new R56 vops_rename slot (VOPS_RENAME_OFFSET=88, slot 11) against the parent's ops table (adapters: _tmpfs_rename_adapter in-place inode name rewrite, _pdxfs_lite_rename_adapter wraps existing pdxfs_lite_rename, _pdxfs_block_rename_stub returns MOUNT_BACKEND_UNKNOWN pending R52.M6). Emits R56.M3-005 fingerprint via klog_s1_x2 (tag_sys_rename_ok + k_from + k_to). rbp-based frame with 5-push callee-save prologue + sub rsp,40 (5 u64 spill slots + 1 pad byte-worth) lands rsp%16==0 for nested calls (entry rsp%16==8; push rbp -> %16==0; 5 more pushes -> %16==8; sub rsp,40 -> %16==0). Every nested call site (2x user_read_str_via_walk, mount_root_vnode, path_resolve, vnode_slot, vops_rename, klog_s1_x2) sees %16==0 pre-CALL so callee entry %16==8 per SysV. Frame: [rbp-48]=old_strlen, [rbp-56]=new_strlen, [rbp-64]=old_cap, [rbp-72]=new_cap. Body: (1) Cap both lens at 255; widen 0 -> 1. (2)(3) Walk both user paths -> strlen; 0 -> EFAULT. (4) Byte-scan each scratch for LAST '/'; track via r14/r15 with sentinel = strlen. Miss -> EINVAL. root '/' AND trailing-slash rejections (see sys_unlink §step 3). (5) same-parent gate: cmp r14, r15 (parent lengths differ -> EXDEV); byte-compare scratch[0..r14) prefixes. (6) Materialize parent scratch (special-case r14==0 -> '/'). (7)(8)(9) resolve parent; failures -> ENOENT. (10) vops_rename(&parent, &old[ls+1], old_leaf_len, &new[ls+1], new_leaf_len); non-zero -> ENOENT. (11) klog_s1_x2 with v2 (new_scratch VA) pushed as 7th arg per wrappers.pdx convention (`sub rsp,8; push v2; call; add rsp,16`). (12) Return 0. All failure arms jmp sysren_done via distinct labels. Labels prefixed sysren_. No test; no memory-operand arithmetic (encoder gap). Effects {mem, sysreg} @{cap} match the R56.M3-005 task pin.",
      block: {
        push rbp;
        mov rbp, rsp;
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        mov rbx, rdi;                    // rbx = old_va
        mov r12, rdx;                    // r12 = new_va
        // rsi = old_len; rcx = new_len (still live)

        // ---- (1) Cap old_len at SYS_RENAME_PATH_MAX-1 = 255 ----
        mov r10, 255;
        cmp rsi, r10;
        jbe sysren_old_cap_ok;
        mov rsi, r10;
      sysren_old_cap_ok:
        cmp rsi, 0;
        jne sysren_old_len_ok;
        mov rsi, 1;
      sysren_old_len_ok:
        mov [rbp - 64], rsi;             // spill old_cap

        // Cap new_len at 255.
        mov r10, 255;
        cmp rcx, r10;
        jbe sysren_new_cap_ok;
        mov rcx, r10;
      sysren_new_cap_ok:
        cmp rcx, 0;
        jne sysren_new_len_ok;
        mov rcx, 1;
      sysren_new_len_ok:
        mov [rbp - 72], rcx;             // spill new_cap

        // ---- (2) user_read_str_via_walk(old_va, &old_scratch, old_cap) ----
        mov rdi, rbx;                    // arg0 = old_va
        lea rsi, [rip + _sys_rename_old_scratch];
        mov rdx, [rbp - 64];             // arg2 = old_cap
        call user_read_str_via_walk;
        cmp rax, 0;
        je  sysren_efault;
        mov [rbp - 48], rax;             // spill old_strlen

        // ---- (3) user_read_str_via_walk(new_va, &new_scratch, new_cap) ----
        mov rdi, r12;                    // arg0 = new_va
        lea rsi, [rip + _sys_rename_new_scratch];
        mov rdx, [rbp - 72];             // arg2 = new_cap
        call user_read_str_via_walk;
        cmp rax, 0;
        je  sysren_efault;
        mov [rbp - 56], rax;             // spill new_strlen

        // ---- (4a) Scan old_scratch for LAST '/' ----
        //   r14 = old_last_slash; sentinel = old_strlen (not-found).
        mov r14, [rbp - 48];             // r14 = old_strlen (== sentinel)
        lea r9, [rip + _sys_rename_old_scratch];
        mov r11, [rbp - 48];             // r11 = old_strlen (loop limit)
        xor rcx, rcx;
      sysren_scan_old:
        cmp rcx, r11;
        jae sysren_scan_old_done;
        xor r10, r10;
        mov_b r10, [r9 + rcx*1];
        cmp r10, 0x2F;
        jne sysren_scan_old_next;
        mov r14, rcx;
      sysren_scan_old_next:
        add rcx, 1;
        jmp sysren_scan_old;
      sysren_scan_old_done:
        cmp r14, r11;
        je  sysren_einval;               // no '/'
        // Root and trailing-slash rejections
        cmp r11, 1;
        jne sysren_old_leaf_check;
        cmp r14, 0;
        je  sysren_einval;
      sysren_old_leaf_check:
        mov r10, r14;
        add r10, 1;
        cmp r10, r11;
        je  sysren_einval;               // trailing slash

        // ---- (4b) Scan new_scratch for LAST '/' ----
        mov r15, [rbp - 56];             // r15 = new_strlen (== sentinel)
        lea r9, [rip + _sys_rename_new_scratch];
        mov r11, [rbp - 56];             // r11 = new_strlen
        xor rcx, rcx;
      sysren_scan_new:
        cmp rcx, r11;
        jae sysren_scan_new_done;
        xor r10, r10;
        mov_b r10, [r9 + rcx*1];
        cmp r10, 0x2F;
        jne sysren_scan_new_next;
        mov r15, rcx;
      sysren_scan_new_next:
        add rcx, 1;
        jmp sysren_scan_new;
      sysren_scan_new_done:
        cmp r15, r11;
        je  sysren_einval;
        cmp r11, 1;
        jne sysren_new_leaf_check;
        cmp r15, 0;
        je  sysren_einval;
      sysren_new_leaf_check:
        mov r10, r15;
        add r10, 1;
        cmp r10, r11;
        je  sysren_einval;

        // ---- (5) Same-parent check: r14 == r15 AND byte-compare prefixes ----
        cmp r14, r15;
        jne sysren_exdev;
        // Byte-compare old[0..r14) vs new[0..r14).
        lea r8, [rip + _sys_rename_old_scratch];
        lea r9, [rip + _sys_rename_new_scratch];
        xor rcx, rcx;
      sysren_cmp_top:
        cmp rcx, r14;
        jae sysren_cmp_done;
        xor r10, r10;
        mov_b r10, [r8 + rcx*1];
        xor r11, r11;
        mov_b r11, [r9 + rcx*1];
        cmp r10, r11;
        jne sysren_exdev;
        add rcx, 1;
        jmp sysren_cmp_top;
      sysren_cmp_done:

        // ---- (6) Materialize parent scratch ----
        cmp r14, 0;
        jne sysren_parent_copy;
        lea rdi, [rip + _sys_rename_parent_scratch];
        mov r10, 0x2F;
        mov_b [rdi + 0], r10;
        xor r10, r10;
        mov_b [rdi + 1], r10;
        jmp sysren_parent_ready;
      sysren_parent_copy:
        lea r8, [rip + _sys_rename_old_scratch];
        lea r9, [rip + _sys_rename_parent_scratch];
        xor rcx, rcx;
      sysren_parent_top:
        cmp rcx, r14;
        jae sysren_parent_done;
        xor r10, r10;
        mov_b r10, [r8 + rcx*1];
        mov_b [r9 + rcx*1], r10;
        add rcx, 1;
        jmp sysren_parent_top;
      sysren_parent_done:
        xor r10, r10;
        mov_b [r9 + r14*1], r10;         // NUL-terminate
      sysren_parent_ready:

        // ---- (7) mount_root_vnode() ----
        call mount_root_vnode;
        cmp rax, 0;
        je  sysren_enoent;
        mov r10, rax;                    // stash root_idx

        // ---- (8) path_resolve(&parent, root, cwd) ----
        // R86.M1-005 (#1958): cwd from TASK_OFF_CWD (+160), not hardcoded 0.
        lea rdi, [rip + _sys_rename_parent_scratch];
        mov rsi, r10;
        mov rax, [rip + _current_tcb];
        mov rdx, [rax + 160];            // cwd (TASK_OFF_CWD)
        call path_resolve;
        cmp rax, 0;
        je  sysren_enoent;

        // ---- (9) vnode_slot(parent_idx) ----
        mov rdi, rax;
        call vnode_slot;
        mov r13, rax;                    // r13 = &parent_vn

        // ---- (10) vops_rename(&parent_vn, old_leaf, old_leaf_len,
        //                       new_leaf, new_leaf_len) ----
        //   old_leaf     = &old_scratch[old_last_slash + 1]
        //   old_leaf_len = old_strlen - (old_last_slash + 1)
        //   new_leaf     = &new_scratch[new_last_slash + 1]
        //   new_leaf_len = new_strlen - (new_last_slash + 1)
        mov rdi, r13;                    // arg0 = &parent_vn
        // arg1 = &old_scratch + old_ls + 1
        lea r10, [rip + _sys_rename_old_scratch];
        add r10, r14;
        add r10, 1;
        mov rsi, r10;
        // arg2 = old_strlen - (old_ls + 1).  Encoder gap: no sub reg,[mem].
        mov r11, [rbp - 48];             // r11 = old_strlen
        mov r10, r14;
        add r10, 1;                      // r10 = old_ls + 1
        sub r11, r10;                    // r11 = old_leaf_len
        mov rdx, r11;
        // arg3 = &new_scratch + new_ls + 1
        lea r10, [rip + _sys_rename_new_scratch];
        add r10, r15;
        add r10, 1;
        mov rcx, r10;
        // arg4 = new_strlen - (new_ls + 1)
        mov r11, [rbp - 56];             // r11 = new_strlen
        mov r10, r15;
        add r10, 1;
        sub r11, r10;
        mov r8, r11;                     // arg4 = new_leaf_len
        call vops_rename;                // rax = 0 or errno
        cmp rax, 0;
        jne sysren_enoent;

        // ---- (11) Fingerprint emit ----
        //   klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS_, tag_sys_rename_ok,
        //              k_from, v1=&old_scratch,
        //              k_to,   v2=&new_scratch)
        //
        // Alignment: post-prologue rsp%16==0.  klog_s1_x2 expects a
        // v2 push (7th arg) landing rsp%16==0 pre-call.  sub rsp,8 -> %16==8;
        // push r10 -> %16==0.  Undo with add rsp,16 post-call.
        lea r10, [rip + _sys_rename_new_scratch];    // stash v2 (new_scratch VA)
        sub rsp, 8;                                  // alignment pad (%16==8)
        push r10;                                    // v2 on stack (%16==0)
        mov rdi, 3;                                  // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_rename_ok];
        lea rcx, [rip + k_from];                     // k1 = "from"
        lea r8,  [rip + _sys_rename_old_scratch];    // v1 = old_scratch VA
        lea r9,  [rip + k_to];                       // k2 = "to"
        call klog_s1_x2;
        add rsp, 16;                                 // drop v2 + pad

        // ---- (12) Success return ----
        xor rax, rax;
        jmp sysren_done;

      sysren_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        jmp sysren_done;

      sysren_exdev:
        mov rax, 0xFFFFFFFFFFFFFFEE;     // -EXDEV
        jmp sysren_done;

      sysren_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;     // -EINVAL
        jmp sysren_done;

      sysren_efault:
        mov rax, 0xFFFFFFFFFFFFFFF2;     // -EFAULT

      sysren_done:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
