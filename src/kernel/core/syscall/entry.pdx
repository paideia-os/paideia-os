// src/kernel/core/syscall/entry.pdx — R13-m5-003 (#429) — SYSCALL entry trampoline
// LSTAR target: save user rsp, switch to kernel stack, dispatch, restore, sysret.
// [unsafe] — SYSCALL entry path. Privileged instructions + raw memory writes.
// Audit: design/audit/entries/r13-m5-003-syscall-table.md
//
// R13 SIMPLIFICATIONS (documented; each has an R13-m6+ follow-up):
//   - No KPTI CR3 switch (R13-m3 has not wired runtime CR3 flip).
//   - Kernel stack is a single BSS array, not per-CPU.
//   - No user rsp validation.
//
// Register discipline on entry (SDM Vol 3A §6.15):
//   rax = syscall#, rdi = arg0 (C-abi), rsi = arg1, rdx = arg2, r10 = arg3, r8 = arg4?
//   Actually preflight §C pins: rdi=arg0, rsi=arg1, rdx=arg2, r10=arg3 (per Linux SYSCALL ABI).
//   rcx = return RIP, r11 = user RFLAGS, rsp = user stack, CS=0x08, SS=0x10, IF=0.
//
// ABI shuffle to SysV C ABI for syscall_dispatch(sysno, a1, a2, a3, a4):
//   rdi <- rax (sysno), rsi <- rdi (a1), rdx <- rsi (a2), rcx <- rdx (a3), r8 <- r10 (a4).
//   Written in reverse-dependency order so each source is read before its destination clobbers.

module Entry = structure {
  pub let syscall_entry : () -> () !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R13-m5-003 (#429) + R14b-m4-006/007 (#502/#503) + R17-M0-724-D4 (#724 D4) + R17-M0-728 (#728 D9) + R17-M0-731 (#731): SYSCALL entry trampoline. Sequence: (1) swapgs — kernel GS_BASE. (2) Save user rax (syscall#) to trampoline slot _saved_user_rax BEFORE the CR3-dance clobbers rax (D4 fix; latent bug caused every init syscall to route to dispatch_enosys). (3) Save user rsp to trampoline slot _saved_user_rsp; save user cr3 to _saved_user_pml4. (4) Flip cr3 to _kernel_pml4_pa. (5) (#728 D9) Load per-task kernel stack: rax = _current_tcb; rsp = [rax + 24] (TCB.kstack_top). Was `lea rsp, [rip + _syscall_kernel_stack + 16384]` — single global stack, corrupted when task_A blocks (sched_block from wait4) and task_B's subsequent syscalls reset rsp to the same base and overwrite task_A's saved call chain (specifically the return address of `call sched_switch_r15` inside sched_block). Per-task kstack, addressed via TCB[+24] populated at task_new time, makes each task's kernel call chain private. (6) (#728 D9) Copy per-task saved user rsp: [rax + 104] = _saved_user_rsp (global). This survives across another task's syscalls because the other task writes only its own [rax'+104] slot. (7) Push rcx (user RIP), r11 (user rflags), and rax (syscall#, reloaded from _saved_user_rax per D4) onto per-task kernel stack. (8) Shuffle SYSCALL ABI → SysV C ABI via `pop rdi` (rdi = sysno) + reg-reg moves. (9) call syscall_dispatch. Return in rax. Epilogue: (10) (#731) Save the dispatch return value (rax) into trampoline slot _saved_syscall_ret_rax BEFORE any subsequent instruction clobbers rax — mirrors D4's entry-side pattern, and closes the exit-side rax-clobber that silently overwrote every syscall's return with user_pml4_pa. (11) pop r11 (user rflags), pop rcx (user RIP). (12) (#728 D9) Reload rsp from per-task slot: rax = _current_tcb; rsp = [rax + 104] (per-task saved_user_rsp). Was `mov rsp, [rip + _saved_user_rsp]` (global — same clobber hazard as the entry-side stack). (13) (#728 D9) Derive user PML4 PA from TCB.user_pml4_va @+16 (VA-form per #658 boundary) instead of reading global _saved_user_pml4: rax = [_current_tcb + 16]; sub KERNEL_VMA_BASE → rax = user_pml4_pa. Same trampoline-clobber hazard as (12); TCB-derivation neutralises it. (14) mov cr3, rax. (15) swapgs. (16) (#731) Reload the saved return value from _saved_syscall_ret_rax into rax — memory slot survives the CR3 flip because trampoline data is mapped in both PML4s (PT[261] under user CR3 + higher-half identity under kernel CR3). (17) sysret. Effects widened to (mem, sysreg); capabilities widened to (cap, sched) to cover union of reachable handlers.",
      block: {
        swapgs;

        // #724 D4 fix: save user rax (syscall#) into trampoline data BEFORE
        // any CR3-read/write clobbers it. Prior code did `mov rax, cr3;
        // mov [_saved_user_pml4], rax; mov rax, [_kernel_pml4_pa]; mov cr3, rax`
        // BEFORE the intended `push rax` (step 8), so push rax pushed the
        // kernel PML4 phys, not the syscall#. The dispatch shuffle's
        // `pop rdi` then produced rdi = 0x101000 (kernel_pml4_pa), so every
        // init syscall silently routed to dispatch_enosys (which returns
        // -ENOSYS). Silent because init doesn't check most return values.
        // Confirmed via probe: UART-write of low byte of rdi at
        // syscall_dispatch entry showed '@0' 11 times (0x101000 & 0xFF =
        // 0x00, +0x30 = 0x30 = '0') — never any real sysno like 12
        // (sys_debug_puts) or 32 (sys_dup2). See design r17-m0-724-d4-init-
        // post-iretq-gp.md §Root Cause.  _saved_user_rax lives on trampoline
        // data page (accessible under both user CR3 via PT[261] and kernel
        // CR3 via PML4[256] higher-half identity).
        mov [rip + _saved_user_rax], rax;

        // Switch stack: save user rsp + user cr3, flip to kernel cr3
        mov [rip + _saved_user_rsp], rsp;
        mov rax, cr3;
        mov [rip + _saved_user_pml4], rax;
        mov rax, [rip + _kernel_pml4_pa];
        mov cr3, rax;

        // #728 D9 fix: load PER-TASK kernel stack from _current_tcb.  Was
        // `lea rsp, [rip + _syscall_kernel_stack + 16384]`, a single global
        // shared across all tasks — see the file-level justification and
        // design/kernel/r17-m0-728-d9-sys-exit-sched-switch-ud.md §4 for
        // why that broke cooperative blocking (init blocks in wait4; child's
        // subsequent syscalls stomp init's saved kernel-call chain).
        //
        // _current_tcb lives in kernel .bss; the [+24] TCB slot lives in
        // task_pool .bss.  Both are accessible now (kernel CR3 is loaded).
        // The per-task kstack is populated by task_new at slab allocation
        // time so it's always present by the time a task's first syscall
        // fires (init: populated in init_bootstrap_witness's task_new call;
        // fork'd children: populated in sys_fork_body's task_new call).
        mov rax, [rip + _current_tcb];
        mov rsp, [rax + 24];                      // TCB.kstack_top

        // Preserve SYSCALL-clobbered ring-transition state + syscall#.
        // ORDERING NOTE: these three pushes MUST run before the #728 D9
        // saved_user_rsp copy below.  The copy uses rcx as scratch, and
        // rcx here still holds user RIP (SYSCALL puts return-RIP in rcx)
        // — pushing it first preserves it on the per-task kernel stack.
        //
        // #724 D4 fix: rax was clobbered by the CR3 dance above; reload
        // the true syscall# from _saved_user_rax so `push rax` saves the
        // correct value for the shuffle's `pop rdi` to consume as sysno.
        push rcx;
        push r11;
        mov rax, [rip + _saved_user_rax];
        push rax;

        // #728 D9: copy the just-saved global _saved_user_rsp into the
        // per-task TCB slot so the epilogue can recover it even after
        // another task's syscall has clobbered the global.  Runs AFTER
        // push rcx above — rcx is now dead (user RIP is safely on the
        // per-task kstack) and available as scratch for the load.  rax
        // was clobbered by the syscall# reload; reload it from _current_tcb.
        mov rax, [rip + _current_tcb];            // rax = current TCB
        mov rcx, [rip + _saved_user_rsp];         // rcx = user rsp
        mov [rax + 104], rcx;                     // TCB.saved_user_rsp @+104

        // Shuffle SYSCALL ABI -> SysV C ABI (rax->rdi restored via pop below)
        mov r8, r10;
        mov rcx, rdx;
        mov rdx, rsi;
        mov rsi, rdi;
        pop rdi;

        // Dispatch (result in rax)
        call syscall_dispatch;

        // #731 fix: preserve the syscall's return value across the epilogue's
        // CR3 flip.  Pre-fix, the epilogue's three consecutive `mov rax, ...`
        // instructions (mov rax, [_current_tcb]; mov rax, [rax+16]; sub) plus
        // `mov cr3, rax` unconditionally overwrote rax with user_pml4_pa
        // between here and sysret — every syscall's real result (negative
        // errnos, pid from fork, entry_rip from execve, bytes-written, ...)
        // was silently replaced with a small positive number in user rax.
        // See design/kernel/r15-m6-731-syscall-entry-rax-clobber.md for the
        // full wire evidence and why this hid for the entire #724 D1..D10
        // chain.  _saved_syscall_ret_rax lives on the trampoline data page
        // and is accessible both here (kernel CR3, higher-half identity) and
        // at the reload site below (post-CR3-flip, user CR3 via PT[261]) —
        // same accessibility pattern as _saved_user_rax on the entry side.
        // UP-single-slot safety: identical to _saved_user_rax (IF=0 window;
        // no nested syscall can concurrently clobber).
        mov [rip + _saved_syscall_ret_rax], rax;

        // Restore ring-transition state
        pop r11;
        pop rcx;

        // #728 D9: restore user rsp and user CR3 from the current task's
        // TCB, not from globals.  Globals were clobbered by whatever task
        // was last-current before we resumed (child's exit path if the
        // caller was a WAITING parent woken by sys_exit_body).  Rsp is
        // pulled from the per-task copy at [+104]; user PML4 PA is derived
        // from TCB.user_pml4_va @+16 (VA-form, per aspace_map.pdx #658
        // boundary) minus KERNEL_VMA_BASE — same subtract as
        // sys_fork_child_landing (enter_user.pdx §7) and the shell/init
        // boot path (kernel_main.pdx:7026-7028).
        mov rax, [rip + _current_tcb];
        mov rsp, [rax + 104];                     // per-task saved_user_rsp
        mov rax, [rax + 16];                      // user_pml4_va (phys_alloc form)
        mov r10, 0xFFFF800000000000;              // KERNEL_VMA_BASE
        sub rax, r10;                             // rax = genuine user_pml4_pa
        mov cr3, rax;

        swapgs;

        // #731 fix: reload the syscall's return value into rax immediately
        // before sysret.  The slot was populated right after `call
        // syscall_dispatch` returned and survives the CR3 flip because the
        // trampoline data page is mapped in the user PML4 via PT[261]
        // (kpti_build_user_pml4) with U=0/XD=1 — same accessibility as
        // _iretq_frame_scratch and _saved_user_rax.  Placement AFTER swapgs
        // is deliberate: swapgs is state-only (GS_BASE swap) and does not
        // touch general-purpose registers, so it cannot re-clobber rax.
        // Placement BEFORE sysret is required: sysret loads rcx→RIP and
        // r11→RFLAGS but leaves rax untouched; whatever rax holds at this
        // exact instant is what userspace observes on return.
        mov rax, [rip + _saved_syscall_ret_rax];

        // #743 fix: zero SysV caller-save scratch regs (rdi, rsi, rdx, r8,
        // r9, r10) immediately before sysret.  These registers hold
        // whatever the last kernel operation left in them — typically
        // kernel VAs, phys addresses, or internal pointers — and would
        // otherwise leak to userspace across the ring transition.  Not
        // exploitable today (no KASLR), but closes the info-leak hardening
        // gap flagged as D13-tail after #741 closed the ring-3 → ring-0
        // corruption primitive.
        //   - rax  NOT zeroed: syscall return value (per #731).
        //   - rcx  NOT zeroed: user RIP (sysret target).
        //   - r11  NOT zeroed: user RFLAGS (restored by sysret).
        //   - rbx, rbp, r12-r15  NOT touched: callee-save (preserved by
        //     syscall_dispatch and any nested handlers per SysV ABI).
        //   - rsp  NOT touched: about to be replaced by sysret's implicit
        //     restore of the user stack pointer from the per-task TCB copy
        //     loaded at step (12) above.
        // Userland ABI compatibility: SysV syscall convention returns only
        // in rax; init.pdx / child_hello.pdx treat rdi/rsi/rdx/r8/r9/r10
        // as caller-save scratch (see init.pdx u64_to_dec Clobbers line).
        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        xor r8, r8;
        xor r9, r9;
        xor r10, r10;

        // sysret: encoded 48 0F 07 (sysretq in 64-bit mode).
        // RIP <- rcx, RFLAGS <- r11 with reserved bits, ring 0 -> 3.
        sysret
      }
    }
}
