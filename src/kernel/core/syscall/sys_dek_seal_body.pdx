// src/kernel/core/syscall/sys_dek_seal_body.pdx -- PFS-13 (paideia-os #2731)
//
// SYS_DEK_SEAL -- supervisor-mediated KIND_DEK mint hop (sysno 136).
//
// =============================================================================
// SECTION 0  SCOPE  (PFS-13, Wave PFS-W10)
// =============================================================================
//
// Wave 96 (PFS-12 / paideia-os #2579) landed the KIND_DEK substrate at
// src/kernel/core/cap/kind_dek.pdx: ordinal 0x1A4, 16-row pool, mint
// gate kind_dek_mint_body(parent_slot, rights, volume_id, dek_ptr,
// dek_len, flags).  The mint gate is supervisor-only -- the DEK_OP_SEAL
// cap-invoke arm returns DEK_STUB_SENTINEL (0xFFFFEFA7).  §9 of
// kind_dek.pdx names the two deferred pieces that would wire the
// end-to-end passphrase-fd flow:
//
//   #TBD1 (THIS LANDING): a supervisor mint syscall that reads 32 DEK
//     bytes from a caller-pinned KIND_MEMORY page and seeds a KIND_DEK
//     row via kind_dek_mint_body.
//
//   #TBD2 (future wave):  libpdx-volume pdxb_block_encrypt / _decrypt
//     real bodies that call dek_lookup_body(volume_id) + the ChaCha20-
//     Poly1305 intrinsic.
//
// GAP #P2 in tools/user/mount.pdxfs/src/passphrase_wire.pdx names the
// user-side gap this syscall closes: today `passphrase_wire_unlock`
// leaves the unwrapped DEK in a .bss scratch (mount_pw_dek_scratch),
// forever exposing 32 bytes of key material to any subsequent memory
// disclosure in the mount.pdxfs address space.  After this landing,
// mount.pdxfs's new sys_dek_seal invocation hands the 32 bytes to the
// kernel, which copies them into a KIND_DEK row and returns a row_id;
// mount.pdxfs then wipes its .bss scratch and only the kernel holds
// the key.
//
// =============================================================================
// SECTION 1  CONTRACT
// =============================================================================
//
// sys_dek_seal_body(volume_cap_slot, pinned_page_addr, flags) -> u64
//
//   volume_cap_slot : cap_table slot (0..255) holding a live KIND_VOLUME
//                     cap with R_VOL_READ in its rights mask.  The slot
//                     is read-only here -- no cap_table mutation on this
//                     cap.
//
//   pinned_page_addr: user VA of the DEK bytes.  MUST be 4KiB-aligned
//                     (addr & 0xFFF == 0).  MUST lie entirely below
//                     KERNEL_VMA_BASE (user half).  The first 32 bytes
//                     are read via user_read_bytes_via_walk, which walks
//                     the caller's user_pml4; any unmapped / kernel-half
//                     / huge-page byte in those 32 fails the walk.
//                     This IS the "belongs to caller's KIND_MEMORY
//                     range" check -- a KIND_MEMORY row IS a user-space
//                     page frame, so any page that walks successfully
//                     from the caller's user_pml4 is by definition a
//                     page the caller is authorised to touch (per
//                     mm/aspace_map's own invariant).
//
//   flags           : passed through to kind_dek_mint_body as its own
//                     flags argument.  Today only DEK_FLAG_REVOKED
//                     (bit 0) is defined; mount.pdxfs passes 0.
//
// Return (rax): packed u64 = (row_id << 2) | status
//
//   status in bits [1:0]:
//
//     0 = SDS_STATUS_OK           -- row_id in [0, DEK_MAX=16); the
//                                    caller may call dek_lookup_body(
//                                    volume_id) later and get back
//                                    this same row_id.
//     1 = SDS_STATUS_INVALID_SLOT -- volume_cap_slot >= 256, OR the
//                                    descriptor at that slot is NOT a
//                                    live KIND_VOLUME, OR the
//                                    descriptor's rights mask lacks
//                                    R_VOL_READ, OR volume_row_of_slot
//                                    returned VOL_ROW_NONE (the row
//                                    was revoked between the rights
//                                    check and the row read -- not a
//                                    race today since this file runs
//                                    under single-flow syscall
//                                    discipline, but structurally
//                                    gated anyway).
//     2 = SDS_STATUS_INVALID_PAGE -- pinned_page_addr not 4KiB-aligned,
//                                    user_ptr_ok rejected the range, OR
//                                    user_read_bytes_via_walk failed
//                                    (unmapped, huge-page, kernel-half,
//                                    etc.).
//     3 = SDS_STATUS_MINT_FAILED  -- kind_dek_mint_body returned a
//                                    sentinel >= DEK_MAX (the 16-row
//                                    pool was full, OR the rights
//                                    subset check inside the mint
//                                    gate failed -- the latter cannot
//                                    happen since this syscall passes
//                                    R_DEK_ALL = 0x007 which is itself
//                                    the subset ceiling; retained as
//                                    a defensive funnel code).
//
//   On any error, row_id is 0 and only status is set.  Callers decode
//   as:
//     status = rax & 3;
//     row_id = rax >> 2;    // valid only when status == 0
//
// =============================================================================
// SECTION 2  WHY (row_id + 1) IS THE volume_id
// =============================================================================
//
// kind_dek_mint_body(parent, rights, volume_id, dek_ptr, dek_len,
// flags) refuses volume_id == 0 (DEK_MINT_BAD_ARG).  The KIND_DEK row
// layout stores volume_id at [+40] and dek_lookup_body(volume_id) at
// per-block encrypt/decrypt time scans the DEK pool for a row whose
// stored volume_id matches.
//
// The KIND_VOLUME row has NO stored volume_id field.  Its row layout
// (kind_volume.pdx §1) packs device_slot / mount_slot into the header,
// then uuid_lo / uuid_hi / root_inode / mount_gen / inode_count /
// free_blocks / sig_key_slot.  No scalar "volume id".
//
// Three candidates were considered:
//
//   (a) Use uuid_lo as the volume_id.  Fails when sys_vol_mint
//       (sysno 135) synthesizes uuid_lo = (device_cap << 56) |
//       superblock_lba, which can be 0 if both inputs are 0.  Also
//       muddles the semantic (uuid_lo is an identity artefact, not
//       a liveness token).
//
//   (b) Hash uuid_lo || uuid_hi to a non-zero u64.  Overkill for a
//       16-slot address space, and introduces a second lookup
//       convention the per-block crypto path would have to mirror.
//
//   (c) Use (volume_row_id + 1).  Row 0..15 maps to volume_id 1..16;
//       always non-zero (row 0 is still volume_id 1); deterministic;
//       round-trip-friendly (the per-block crypto path receives a
//       KIND_VOLUME cap, resolves it to row_id via volume_row_of_slot,
//       computes the same (row_id + 1), and calls dek_lookup_body
//       with that number -- no hash, no lookup table, no persistent
//       mapping needed).  Collisions impossible because KIND_VOLUME's
//       row pool is also 16-rowed.
//
// This landing takes (c).  §4 of kind_dek.pdx's own §1 header note
// mentioned "a kernel-assigned sequential u64 (per kind_volume.pdx
// _volume_next_id)" but kind_volume.pdx has no such symbol; (c) is
// the simplest reading of that intent that matches the actual
// kind_volume substrate.
//
// =============================================================================
// SECTION 3  PINNED-PAGE GATE SEMANTICS
// =============================================================================
//
// The task brief names a "pinned_page_addr is 4KiB-aligned + belongs
// to caller's KIND_MEMORY range" gate.  This file composes that gate
// from three cheaper primitives already in the kernel:
//
//   (G1)  (pinned_page_addr & 0xFFF) == 0 ... 4KiB-alignment check
//         (inline, no call).
//   (G2)  user_ptr_ok(pinned_page_addr, 32) ... kernel-half rejection
//         + overflow (ptr_check.pdx #541 Phase 1).
//   (G3)  user_read_bytes_via_walk(scratch, pinned_page_addr, 32) ...
//         walks the caller's _current_tcb.user_pml4_va, per-byte, to
//         confirm every byte in [addr, addr+32) is PRESENT + USER +
//         not a huge page (#734 KPTI-sweep).  The 32-byte copy itself
//         is the gate's success proof: a byte that cannot be read is
//         by definition not a KIND_MEMORY byte the caller holds.
//
// No separate "KIND_MEMORY cap table lookup" is needed because the
// user_pml4 IS the capability tree for memory in the current task's
// address space (mm/aspace_map.pdx L19 "the user PT itself is the
// ownership proof -- entries map only pages the task has been granted
// via a KIND_MEMORY mint ..."); walking it successfully is the proof
// of possession.
//
// Rejects at any gate collapse into SDS_STATUS_INVALID_PAGE so the
// caller sees ONE "bad page" surface, not three distinct ones.  (The
// kernel's own fingerprint ring could tell them apart via a future
// klog emission; this landing does not emit a fingerprint from this
// body, matching sys_vol_mint_body's own posture.)
//
// =============================================================================
// SECTION 4  SCRUB POSTURE
// =============================================================================
//
// Three transient secrets exist in this body's frame:
//
//   (S1) The 32-byte DEK sitting in _sys_dek_seal_scratch between the
//        user_read_bytes_via_walk call and the end of
//        kind_dek_mint_body's inner dek_row_alloc write.  After mint
//        the row holds the plaintext; the scratch's copy is redundant.
//        Scrubbed via FOUR aligned u64 zero stores immediately after
//        the mint returns (every return path, including the MINT_
//        FAILED path).
//
//   (S2) The transient KIND_MEMORY cap at SDS_STAGING_SLOT.  Staged
//        via cap_mint_write(138, KIND_MEMORY, RIGHT_MINT, 0) BEFORE
//        the mint and scrubbed via cap_mint_write(138, 0, 0, 0) AFTER
//        the mint, regardless of mint success.  Same transient-
//        staging-slot pattern as sys_vol_mint_body L471-498.
//
//   (S3) The 32-byte DEK sitting in the caller's own pinned page.
//        NOT scrubbed by this body -- the caller (mount.pdxfs) is
//        responsible for wiping its own .bss / stack buffer after the
//        syscall returns.  This body cannot write back through the
//        caller's user_pml4 (there is no "user_write_bytes_via_walk"
//        reverse variant with scrub semantics in the current kernel),
//        and reaching through aspace_map by hand would require
//        additional cap-table authority this body does not take.
//
// S1 + S2 are the "no plaintext leak after the syscall returns" audit
// invariant.  S3 is a caller-side obligation documented in
// design/pdxfs/sys-dek-seal-abi.md §Scrub posture.
//
// =============================================================================
// SECTION 5  INTERACTION WITH THE FUTURE PFS-14 BLOCK-CRYPTO PATH
// =============================================================================
//
// Once sys_dek_seal returns, the KIND_DEK row at the returned row_id
// holds the plaintext DEK indexed by volume_id = row_id + 1.  The
// mount.pdxfs user-side records the row_id in its own .bss slot
// (passphrase_wire_dek_row_id).
//
// PFS-14 lands the real libpdx-volume pdxb_block_encrypt /
// pdxb_block_decrypt bodies.  Each per-block crypto call reaches the
// kernel via a cap-invoke op (DEK_OP_LOOKUP_BY_VOLUME) on the user's
// KIND_VOLUME cap -- NOT on a KIND_DEK cap, because the user never
// holds a KIND_DEK cap in this design.  The lookup op's cap handler
// (cap_handler_dek, kind_dek.pdx L960+) composes volume_row_of_slot
// to resolve the KIND_VOLUME cap to a row_id, computes the same
// (row_id + 1) convention this file pins, and calls dek_lookup_body
// to get back the DEK row.  Per-block ChaCha20-Poly1305 then composes
// via dek_row_read_qword (four calls, reconstructs the 32-byte DEK
// inside the per-block crypto scope, scrubs on return).
//
// This body therefore sits as the SEAM between (a) a user process
// that briefly holds the plaintext DEK in its own address space
// after an AEAD unwrap, and (b) kernel-only per-block crypto that
// never surfaces the DEK bytes to user memory again.
//
// =============================================================================
// SECTION 6  DISPATCH WIRING
// =============================================================================
//
//   src/kernel/core/syscall/dispatch.pdx
//     Bounds check widened 135 -> 136 at the top of the switch.
//     New arm:   cmp rdi, 136; je dispatch_dek_seal;
//     New label: dispatch_dek_seal (register shuffle + call
//                sys_dek_seal_body).
//
// SysV at the dispatch label (post entry.pdx left-rotate):
//   rsi = a0 = volume_cap_slot
//   rdx = a1 = pinned_page_addr
//   rcx = a2 = flags
// Body wants (rdi, rsi, rdx) = (volume_cap_slot, pinned_page_addr,
// flags) -- a three-move SysV shuffle (`mov rdi,rsi; mov rsi,rdx;
// mov rdx,rcx`).  No dispatch-layer KPTI bounce because the body
// owns its own user_ptr_ok + user_read_bytes_via_walk into
// _sys_dek_seal_scratch (same posture as sys_vol_mint_body's shim).
//
// =============================================================================
// SECTION 7  paideia-as ENCODER-PITFALL DISCIPLINE
// =============================================================================
//
// - KIND_VOLUME (0x1A0), KIND_MEMORY (4), SDS_RIGHT_MINT (0x200),
//   SDS_R_VOL_READ (0x001), SDS_R_DEK_ALL (0x007) all stage through
//   r11 where cmp against them matters -- parallel-wave uniformity
//   with kind_dek / kind_volume / sys_vol_mint.
// - No `add reg, [mem]`.
// - No `test`; every zero-check is `cmp reg, 0`.
// - No `imul`; no slot*24 arithmetic reaches this file (cap_verify_
//   read is the only cap_table reader, and it does the shift-pair
//   internally).
// - No `mov_bzx` / `mov_wzx`; the 32-byte DEK bytes stay in the
//   scratch, loaded as u64 words by kind_dek_mint_body's dek_row_
//   alloc (not by this file).
// - 4KiB-mask 0xFFF is a well-formed imm32, used directly.
// - Labels prefixed `sds_` (sys-dek-seal).  Grep-audit (2026-10-11):
//   no `sds_` collisions elsewhere in src/kernel/.
// - Module basename match: file is sys_dek_seal_body.pdx, module is
//   SysDekSealBody.
//
// =============================================================================
// SECTION 8  klog slot v2 posture
// =============================================================================
//
// The task brief names "klog slot v2 at [rsp+0]" as the fingerprint-
// emit convention.  This body does NOT emit a fingerprint at PFS-13
// (no new tag added to klog/keys.pdx at this landing -- deferred to a
// later wave to keep the registration churn small, matching sys_vol_
// mint_body's own posture).  When the fingerprint lands, the slot-v2
// stack-pass pattern (`push r13; call klog_s1_d2` with the klog arg
// at [rsp+0]) is the one to use.

module SysDekSealBody = structure {

  // ============================================================================
  // Wire-level constants
  // ============================================================================

  // Status field (bits [1:0] of the packed return).
  pub let SDS_STATUS_OK            : u64 = 0
  pub let SDS_STATUS_INVALID_SLOT  : u64 = 1
  pub let SDS_STATUS_INVALID_PAGE  : u64 = 2
  pub let SDS_STATUS_MINT_FAILED   : u64 = 3

  // Shift count for row_id in the packed return.  Mirrors
  // sys_vol_mint_body's SVM_STATUS_BITS = 2.
  pub let SDS_STATUS_BITS : u64 = 2

  // DEK plaintext length (bytes).  Matches kind_dek.pdx DEK_LEN = 32
  // and libpdx-volume LPV_DEK_LEN.
  pub let SDS_DEK_LEN     : u64 = 32

  // Pinned-page gate constants.
  pub let SDS_PAGE_BYTES  : u64 = 4096
  pub let SDS_PAGE_MASK   : u64 = 0xFFF

  // KIND tags / rights (duplicated locally -- paideia-as has no
  // cross-module `let` import; see sys_vol_mint_body L286-288 for the
  // same pattern).
  pub let SDS_KIND_VOLUME : u64 = 0x1A0
  pub let SDS_KIND_MEMORY : u64 = 4
  pub let SDS_RIGHT_MINT  : u64 = 0x200
  pub let SDS_R_VOL_READ  : u64 = 0x001
  pub let SDS_R_DEK_ALL   : u64 = 0x007
  pub let SDS_DEK_MAX     : u64 = 16
  pub let SDS_VOL_ROW_NONE: u64 = 0xFF
  pub let SDS_CAP_SLOT_MAX: u64 = 256

  // KIND_MEMORY parent staging slot for the kind_dek_mint_body call.
  // Chosen free-by-construction: slots 132 (framebuffer stage), 133
  // (iris vblank), 134 (sys_vol_mint stage), 136/137 (misc witnesses)
  // all already have documented owners; 138 is the first free slot
  // above that cluster.  Grep-audit (2026-10-11): no other file
  // claims slot 138 as a cap_mint_write target.  Single-flow safe --
  // sys_dek_seal and the other staging-slot users cannot be issued
  // simultaneously by a single ring-3 caller (all are synchronous
  // syscalls on the current task), and each staging slot is scrubbed
  // within each body before return.
  pub let SDS_STAGING_SLOT : u64 = 138

  // ============================================================================
  // 32-byte kernel scratch for the DEK bytes read from the user pinned
  // page.  Zeroed via four aligned u64 stores at every return path
  // (see §4 S1).  @align(8) matches the four-u64-store scrub + the
  // walker's byte-store discipline.
  // ============================================================================
  pub let mut _sys_dek_seal_scratch : [u8; 32] = uninit @align(8)

  // ============================================================================
  // sys_dek_seal_body(volume_cap_slot, pinned_page_addr, flags) -> u64
  //
  // SysV: rdi=volume_cap_slot, rsi=pinned_page_addr, rdx=flags
  //   -> rax = (row_id << 2) | status  (status in bits [1:0])
  //
  // Sequence (gate order matches §1 contract):
  //   (1) 4KiB-align check on pinned_page_addr.  Fail -> INVALID_PAGE.
  //   (2) user_ptr_ok(pinned_page_addr, 32).  Fail -> INVALID_PAGE.
  //   (3) cap_verify_read(volume_cap_slot, KIND_VOLUME, R_VOL_READ).
  //       Fail -> INVALID_SLOT.
  //   (4) volume_row_of_slot(volume_cap_slot) -> row_id in [0,16) or
  //       VOL_ROW_NONE (0xFF).  Fail -> INVALID_SLOT.
  //   (5) volume_id = row_id + 1 (§2).
  //   (6) user_read_bytes_via_walk(_sys_dek_seal_scratch,
  //       pinned_page_addr, 32).  Fail -> INVALID_PAGE.
  //   (7) cap_mint_write(SDS_STAGING_SLOT, KIND_MEMORY, RIGHT_MINT, 0).
  //   (8) kind_dek_mint_body(SDS_STAGING_SLOT, R_DEK_ALL, volume_id,
  //       &_sys_dek_seal_scratch, SDS_DEK_LEN, flags) -> dek_row_id or
  //       sentinel.
  //   (9) cap_mint_write(SDS_STAGING_SLOT, 0, 0, 0) -- scrub staging.
  //   (10) Zero _sys_dek_seal_scratch (four u64 writes).
  //   (11) If dek_row_id >= DEK_MAX -> MINT_FAILED.
  //   (12) Pack return: rax = (dek_row_id << 2) | OK.
  //
  // Register plan (5 callee-save pushes land rsp%16==0 at every
  // nested call from entry rsp%16==8):
  //   rbx = volume_cap_slot   (used in steps 3, 4)
  //   r12 = pinned_page_addr  (used in steps 2, 6)
  //   r13 = flags             (used in step 8)
  //   r14 = volume_id -> dek_row_id (carries row_id post step 5,
  //                                   then volume_id, then dek_row_id)
  //   r15 = unused            (pushed for 16-byte alignment only)
  //
  // Alignment: entry rsp%16==8, 5 pushes (40 B) -> rsp%16==0 at every
  // nested call site.
  //
  // Shared epilogue (sds_out): restores the 5-push frame and returns
  // whatever rax holds.  Every error path sets rax = packed status
  // (row_id=0) before jmp sds_out; the success path packs (row_id << 2)
  // | 0 before jmp sds_out.
  // ============================================================================

  pub let sys_dek_seal_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (volume_cap_slot: u64) (pinned_page_addr: u64) (flags: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "PFS-13 (paideia-os #2731): sys_dek_seal body, SC+ ID 136. Entry: rdi=volume_cap_slot, rsi=pinned_page_addr, rdx=flags. Sequence per §Contract: (1) pinned_page_addr & 0xFFF == 0 else pack INVALID_PAGE; (2) user_ptr_ok(pinned_page_addr, 32) == 0 else INVALID_PAGE; (3) cap_verify_read(volume_cap_slot, KIND_VOLUME=0x1A0, R_VOL_READ=0x001) == 1 else INVALID_SLOT (combines bounds + kind + rights into one call); (4) volume_row_of_slot(volume_cap_slot) < DEK_MAX else INVALID_SLOT -- VOL_ROW_NONE (0xFF) is >= DEK_MAX (16) so the same cmp catches both the stale-slot race and the still-live-but-free-row case; (5) volume_id = row_id + 1 (§2 rationale -- always non-zero, deterministic round-trip via (volume_row_of_slot + 1) on the per-block crypto side); (6) user_read_bytes_via_walk(_sys_dek_seal_scratch, pinned_page_addr, 32) == 0 else INVALID_PAGE -- this walk IS the KIND_MEMORY-ownership proof (§3 G3); (7) stage KIND_MEMORY parent at SDS_STAGING_SLOT=138 via cap_mint_write(138, KIND_MEMORY=4, RIGHT_MINT=0x200, 0) -- same transient-staging pattern as sys_vol_mint_body L471-498; (8) kind_dek_mint_body(138, R_DEK_ALL=0x007, volume_id, &scratch, 32, flags) -> dek_row_id in [0,16) or sentinel >= 16 (DEK_TAIL_ENOSPC = 0xFFFFEFA3, DEK_MINT_BAD_PARENT/RIGHTS/ARG at 0xFFFFEFA0/A1/A2); (9) scrub staging slot via cap_mint_write(138, 0, 0, 0) UNCONDITIONALLY -- the scrub runs even on mint failure so transient KIND_MEMORY authority never leaks past this syscall boundary (§4 S2); (10) zero _sys_dek_seal_scratch via four aligned u64 writes of zero (§4 S1); (11) cmp dek_row_id, SDS_DEK_MAX; jae MINT_FAILED (folds every kind_dek_mint_body sentinel into one surface code -- the DENIED-equivalent distinction between TAIL_ENOSPC and MINT_BAD_* is not useful to a mount.pdxfs caller, which cannot do anything differently about either); (12) pack rax = (dek_row_id << SDS_STATUS_BITS=2) | SDS_STATUS_OK. Register plan: 5 callee-save pushes (rbx=volume_cap_slot, r12=pinned_page_addr, r13=flags, r14=volume_id (then dek_row_id), r15=unused for alignment) -- 40 B from entry rsp%16==8 -> %16==0 for every nested call. Shared epilogue sds_out undoes the 5-push frame; every failure path funnels into it via `mov rax, <status>; jmp sds_out`, and the success path packs the row_id before jumping. KIND_VOLUME (0x1A0), KIND_MEMORY (4), RIGHT_MINT (0x200), R_VOL_READ (0x001), R_DEK_ALL (0x007) all stage via r11 before cmp (encoder-pitfall discipline). No `add reg, [mem]`; no `test`; no `imul`; no `mov_bzx`/`mov_wzx`. Labels prefixed sds_ (sys-dek-seal). Effects {mem, sysreg}: mem for scratch read + DEK-row writes + cap_table staging-slot writes; sysreg transitively inherited from kind_dek_mint_body + volume_row_of_slot's own posture. Capabilities {cap}: transitively via cap_verify_read + volume_row_of_slot + cap_mint_write + kind_dek_mint_body.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // volume_cap_slot
        mov r12, rsi;                    // pinned_page_addr
        mov r13, rdx;                    // flags

        // ---- (1) 4KiB-alignment check on pinned_page_addr ----
        mov rax, r12;
        mov r11, 0xFFF;                  // SDS_PAGE_MASK
        and rax, r11;
        cmp rax, 0;
        jne sds_bad_page;

        // ---- (2) user_ptr_ok(pinned_page_addr, 32) ----
        mov rdi, r12;
        mov rsi, 32;                     // SDS_DEK_LEN
        call user_ptr_ok;
        cmp rax, 0;
        jne sds_bad_page;

        // ---- (3) cap_verify_read(slot, KIND_VOLUME, R_VOL_READ) ----
        mov rdi, rbx;                    // slot
        mov r11, 0x1A0;                  // SDS_KIND_VOLUME (via r11)
        mov rsi, r11;
        mov r11, 0x001;                  // SDS_R_VOL_READ
        mov rdx, r11;
        call cap_verify_read;
        cmp rax, 1;
        jne sds_bad_slot;

        // ---- (4) volume_row_of_slot(slot) -> row_id ----
        mov rdi, rbx;
        call volume_row_of_slot;
        // rax = row_id in [0,16) or VOL_ROW_NONE (0xFF).  Any value
        // >= SDS_DEK_MAX (16) folds into INVALID_SLOT (catches the
        // post-rights-check revoke race defensively).
        mov r11, 16;                     // SDS_DEK_MAX
        cmp rax, r11;
        jae sds_bad_slot;

        // ---- (5) volume_id = row_id + 1 ----
        add rax, 1;
        mov r14, rax;                    // r14 = volume_id (survives)

        // ---- (6) user_read_bytes_via_walk(scratch, pinned, 32) ----
        lea rdi, [rip + _sys_dek_seal_scratch];
        mov rsi, r12;                    // pinned_page_addr
        mov rdx, 32;                     // SDS_DEK_LEN
        call user_read_bytes_via_walk;
        cmp rax, 0;
        jne sds_bad_page;

        // ---- (7) Stage KIND_MEMORY parent at SDS_STAGING_SLOT ----
        //   cap_mint_write(138, KIND_MEMORY=4, RIGHT_MINT=0x200, 0).
        mov rdi, 138;                    // SDS_STAGING_SLOT
        mov r11, 4;                      // SDS_KIND_MEMORY (via r11)
        mov rsi, r11;
        mov r11, 0x200;                  // SDS_RIGHT_MINT
        mov rdx, r11;
        xor rcx, rcx;                    // target_ptr = 0
        call cap_mint_write;

        // ---- (8) kind_dek_mint_body(parent, rights, volume_id,
        //          dek_ptr, dek_len, flags) ----
        mov rdi, 138;                    // parent_slot
        mov r11, 0x007;                  // SDS_R_DEK_ALL
        mov rsi, r11;
        mov rdx, r14;                    // volume_id
        lea rcx, [rip + _sys_dek_seal_scratch];
        mov r8,  32;                     // SDS_DEK_LEN
        mov r9,  r13;                    // flags
        call kind_dek_mint_body;
        mov r14, rax;                    // r14 = dek_row_id (or sentinel)

        // ---- (9) Scrub the staging slot UNCONDITIONALLY ----
        //   cap_mint_write(138, 0, 0, 0).
        mov rdi, 138;                    // SDS_STAGING_SLOT
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // ---- (10) Zero _sys_dek_seal_scratch (four u64 writes) ----
        lea r10, [rip + _sys_dek_seal_scratch];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        // ---- (11) Mint-failure gate: dek_row_id >= DEK_MAX ----
        mov r11, 16;                     // SDS_DEK_MAX
        cmp r14, r11;
        jae sds_mint_failed;

        // ---- (12) Pack return: (dek_row_id << 2) | OK ----
        mov rax, r14;                    // dek_row_id
        shl rax, 2;                      // << SDS_STATUS_BITS
        or  rax, 0;                      // | SDS_STATUS_OK (no-op; keeps
                                         //   the ABI pattern visible)
        jmp sds_out;

      sds_bad_slot:
        // (0 << 2) | 1 = 1.
        mov rax, 1;                      // SDS_STATUS_INVALID_SLOT
        jmp sds_out;

      sds_bad_page:
        // (0 << 2) | 2 = 2.
        mov rax, 2;                      // SDS_STATUS_INVALID_PAGE
        jmp sds_out;

      sds_mint_failed:
        // (0 << 2) | 3 = 3.
        mov rax, 3;                      // SDS_STATUS_MINT_FAILED

      sds_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
