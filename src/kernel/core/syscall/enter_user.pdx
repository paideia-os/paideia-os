module EnterUser = structure {
  pub let enter_userland_initial : (u64, u64, u64) -> () !{mem, sysreg} @{boot} =
    fn (entry_rip: u64) (initial_rsp: u64) (user_pml4_pa: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "r15-m2-005-followup (#651) + R15-M7-746 (#746): first ring-3 entry with CR3 flip. Preserves arguments in r12/r13/r14 (entry_rip, initial_rsp, user_pml4_pa). Builds iretq frame into _iretq_frame_scratch using RIP-relative stores (5 slots: RIP, CS, RFLAGS, RSP, SS). Executes swapgs (GS_BASE kernel->user), cli (gate interrupt window), TSS.RSP0 ← _current_tcb.kstack_top (#746: mirrors #744 sched_switch_r15 step 2.5 for the initial-entry path — enter_userland_initial iretqs directly to init and never traverses sched_switch_r15, so without this write TSS.RSP0 stays at tss_install's boot default until init's first sys_wait4 → sched_block → sched_switch_r15 fires; latent under UP because the boot default happens to be a safe kernel stack, but wrong-by-design once cross-task preempt or a mid-syscall ring-3 → ring-0 vector fires before the first switch), mov cr3, r14 (switch to user PML4), lea rsp to frame, iretq (ring-0->ring-3, IF=1 from RFLAGS pop). ud2 sentinel on fall-through (should never execute). The TSS.RSP0 write is guarded on _current_tcb != 0 and kstack_top != 0 so the pre-init ring-3 witness path (kernel_main.pdx #652 kpti_done stanza — _current_tcb is still .bss zero at that point) and any synthetic TCB caller preserves tss_install's boot default rather than zeroing TSS.RSP0; symmetric with sched_switch_r15's #744 skip clause.",
      block: {
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        lea r15, [rip + _iretq_frame_scratch];
        mov [r15 + 0],  r12;
        mov rax, 0x2B;
        mov [r15 + 8],  rax;
        mov rax, 0x202;
        mov [r15 + 16], rax;
        mov [r15 + 24], r13;
        mov rax, 0x23;
        mov [r15 + 32], rax;
        swapgs;
        cli;
        // ==============================================================
        // R15-M7-746 (#746): TSS.RSP0 ← _current_tcb.kstack_top
        // ==============================================================
        // Mirrors sched_switch_r15's #744 step 2.5 for the initial-entry
        // path.  enter_userland_initial iretqs directly to its target
        // ring-3 task and never traverses sched_switch_r15; without this
        // write TSS.RSP0 stays at tss_install's boot default (top of
        // _kernel_stack) until the first cooperative or preemptive
        // switch fires.  Under UP that stack happens to be safe, so the
        // bug is latent — but a ring-3 → ring-0 transition (interrupt,
        // exception, or SYSCALL's own IST=0 path) that hits before the
        // first switch would push its iretq frame on _kernel_stack
        // instead of the incoming task's own kstack, corrupting whatever
        // was there.  Sitting inside the cli/iretq window means the
        // TSS.RSP0 write is atomic w.r.t. interrupts: no ISR can fire
        // between the store and the iretq that arms the ring transition.
        // Placed before `mov cr3, rax` so the TCB read (which lives in
        // kernel .bss, unmapped in user PML4) executes under kernel CR3.
        // _tss itself is mapped in every user PML4 via kpti #744 Part B,
        // so writing it after the CR3 flip would also work — but reading
        // the TCB there would #PF.
        //
        // Guard: _current_tcb == 0 OR kstack_top == 0 skips the write to
        // preserve tss_install's boot default.  The zero-tcb case covers
        // the pre-init ring-3 witness path (kernel_main.pdx :1709,
        // #652 kpti_done stanza) which fires before init publishes
        // _current_tcb.  The zero-kstack_top case is defense-in-depth
        // against synthetic TCBs (task_new populates kstack_top @+24 for
        // every real task per #728 D9, so init — created via task_new
        // in init_bootstrap_witness — has a non-zero value; the guard
        // matches sched_switch_r15's symmetric skip clause).
        //
        // Register discipline: rax scratch (TCB pointer, then kstack_top),
        // rcx scratch (_tss address).  Both are caller-save in SysV and
        // are re-loaded by the `mov rax, r14` a few lines below before
        // the mov cr3 sequence — no cross-use hazard.
        mov rax, [rip + _current_tcb];
        cmp rax, 0;
        je eui_skip_tss_rsp0;
        mov rax, [rax + 24];                    // TCB.kstack_top @ +24 (#728 D9)
        cmp rax, 0;
        je eui_skip_tss_rsp0;
        lea rcx, [rip + _tss];
        mov [rcx + 4], rax;                     // TSS.RSP0 @ +4 (Intel SDM 64-bit TSS layout)
      eui_skip_tss_rsp0:
        // #652 fix: paideia-as's `mov crN, rXX` encoder omits REX.B for
        // extended source registers (R8-R15), so `mov cr3, r14` silently
        // assembled as `mov rsi, cr3` (0F 22 DE, no REX prefix) — CR3 was
        // loaded from RSI (= initial_rsp, the user stack VA) instead of R14
        // (user_pml4_pa). Route through RAX (proven-safe encoding target;
        // every other `mov cr3, ...` site in this codebase uses RAX/RDI)
        // until the paideia-as encoder gap is fixed upstream.
        mov rax, r14;
        mov cr3, rax;
        lea rsp, [rip + _iretq_frame_scratch];
        iretq;
        ud2
      }
    }

  // ==========================================================================
  // R17-M0-724-D6 (#724): sys_fork_child_landing — fresh-child ring-3 entry
  // ==========================================================================
  // Called only via sched_switch_r15's swap-in of a forked child on its FIRST
  // schedule.  Arrival path:
  //   sched_switch_r15 (loads child.regs_save.rip = &sched_switch_r15_continuation
  //                     onto child's landing stack, rets) →
  //   sched_switch_r15_continuation (popfq the child's rflags = 0x2 (IF=0),
  //                                  rets to [child + 2216] = &sys_fork_child_landing) →
  //   sys_fork_child_landing (this function).
  //
  // Preconditions on entry (all satisfied by sys_fork_body's fork-child
  // materialization phase):
  //   - _current_tcb points at the child (updated by sched_switch_r15 before
  //     loading the child's stack, per switch.pdx §2 "Update _current_tcb ← next").
  //   - child @ +1720 holds the parent's user RIP (snapshotted from
  //     _syscall_kernel_stack + 16384 - 8, where syscall_entry pushed rcx).
  //   - child @ +1728 holds the parent's user RSP (from _saved_user_rsp).
  //   - child @ +1736 holds the parent's user RFLAGS (from
  //     _syscall_kernel_stack + 16384 - 16, where syscall_entry pushed r11).
  //   - child @ +16 holds the child's user_pml4_pa (phys_alloc VA form; must
  //     be VA→PA converted before mov cr3 per aspace_map.pdx #652 boundary).
  //   - IF=0 (from continuation's popfq of child.regs_save.rflags = 0x2).
  //
  // On exit: control leaves the kernel via iretq into ring-3, at the same
  // user RIP the parent's syscall was about to sysret to, with:
  //   rax = 0     (fork's return value in the child)
  //   rdx = 0     (companion slot, matches sys_fork_body's parent-side rdx=0)
  //   rsp = parent's user rsp (inherited via COW aspace — same VA, same bytes)
  //   rflags = parent's user rflags (IF=1)
  //   CR3 = child's user PML4 (COW-flipped from parent's per aspace_clone_cow)
  //
  // Placement: this function lives in enter_user.pdx precisely because
  // link.ld:52-53 packs core/syscall/entry.o + core/syscall/enter_user.o into
  // .text.syscall_trampoline, a 4 KiB page mapped in every user PML4 (via
  // kpti_build_user_pml4's PT[260]).  That mapping is essential for the
  // instruction fetches AFTER the mov cr3 to succeed — see design
  // r17-m0-724-d6-fork-enqueue.md §10 for the fetch-safety argument.
  pub let sys_fork_child_landing : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R17-M0-724-D6 (#724): child-side fresh entry to ring-3 on first schedule of a forked task.  Twelve-step body: (1) cli — belt-and-braces IF-off (already IF=0 from continuation's popfq of child.regs_save.rflags=0x2, but redundant-safe against any future rflags-default change). (2) rax = _current_tcb (child TCB); reads kernel .bss, valid because CR3 is still kernel's. (3-6) load fork_user_rip @ +1720 → rcx, fork_user_rsp @ +1728 → rdx, fork_user_rflags @ +1736 → r8, user_pml4_va @ +16 → r9. (7) r9 = r9 - KERNEL_VMA_BASE (0xFFFF800000000000): convert phys_alloc VA form to genuine PA for mov cr3 per aspace_map.pdx #652 boundary discipline. (8) Build 5-slot iretq frame in _iretq_frame_scratch (trampoline data page, mapped in BOTH kernel and user PML4 via kpti PT[261]): [+0]=RIP, [+8]=0x2B (user CS), [+16]=RFLAGS, [+24]=RSP, [+32]=0x23 (user SS). Uses r11 as scratch base pointer (RIP-relative lea). (9) swapgs — kernel GS_BASE → user GS_BASE, mirrors enter_userland_initial ordering. (10) mov cr3, rax with rax=r9 — flip to child user PML4; routed through rax because paideia-as `mov crN, rXX` encoder omits REX.B for R8-R15 (see enter_userland_initial's #652 note). Next instruction fetch (lea rsp, ...) uses new CR3 and succeeds because this function lives in .text.syscall_trampoline, mapped in user PML4. (11) lea rsp = &_iretq_frame_scratch (trampoline data, mapped user); xor rax rax + xor rdx rdx — fork()'s child-side return values; deliberately after CR3 flip so we don't waste the rax slot which was needed as CR3 conduit. (12) iretq — consumes the pre-built frame, transitions CPL 0→3, restores user RIP/RSP/RFLAGS. ud2 sentinel on fall-through (unreachable if iretq's frame is well-formed). Reuses _iretq_frame_scratch safely: single-writer at any moment because IF=0 window from cli through iretq eliminates preemption on this UP CPU; SMP will require a per-CPU scratch (§14 of design doc). Register discipline: no callee-save use, no prologue/epilogue — this function is a control-flow terminator (never returns; iretq is the exit).",
      block: {
        cli;

        // (2) rax = _current_tcb (child)
        mov rax, [rip + _current_tcb];

        // (3-6) Snapshot child's saved user-context + user_pml4 into regs
        //       BEFORE the CR3 flip (TCB slab is not mapped in user PML4).
        mov rcx, [rax + 1720];              // fork_user_rip
        mov rdx, [rax + 1728];              // fork_user_rsp
        mov r8,  [rax + 1736];              // fork_user_rflags (IF=1)
        mov r9,  [rax + 16];                // user_pml4_va (phys_alloc form)

        // (7) VA → PA for CR3 load
        mov r10, 0xFFFF800000000000;        // KERNEL_VMA_BASE
        sub r9, r10;                        // r9 = genuine user_pml4_pa

        // (8) Build iretq frame in trampoline-data scratch
        lea r11, [rip + _iretq_frame_scratch];
        mov [r11 + 0],  rcx;                // RIP  (parent's user rip)
        mov rcx, 0x2B;
        mov [r11 + 8],  rcx;                // CS   (user code, RPL=3)
        mov [r11 + 16], r8;                 // RFLAGS (parent's user rflags, IF=1)
        mov [r11 + 24], rdx;                // RSP  (parent's user rsp, COW-shared)
        mov rcx, 0x23;
        mov [r11 + 32], rcx;                // SS   (user data, RPL=3)

        // (9) swapgs BEFORE mov cr3 — mirrors enter_userland_initial ordering
        swapgs;

        // (10) Flip CR3 to child's user PML4. Route through rax per the
        //      REX.B encoder gap noted in enter_userland_initial.
        mov rax, r9;
        mov cr3, rax;

        // Post-flip: only trampoline pages (text + data) are reachable.
        // sys_fork_child_landing itself lives in .text.syscall_trampoline
        // per link.ld; _iretq_frame_scratch lives in .data.syscall_trampoline.
        lea rsp, [rip + _iretq_frame_scratch];

        // (11) Zero return regs — child sees fork() == 0.
        xor rax, rax;
        xor rdx, rdx;

        // (12) Enter ring-3.
        iretq;
        ud2
      }
    }
}
