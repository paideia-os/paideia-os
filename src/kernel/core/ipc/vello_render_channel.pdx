// src/kernel/core/ipc/vello_render_channel.pdx -- G4.M1-004 (#1478)
//
// Session-type schema for the vello_render channel. Three RPCs
// following the Vello compute-render conversation:
//
//     encode_scene(scene_slot, encoded_bytes, path_count,
//                  sample_count, flags)           -> ok | err
//     submit_render(renderer_slot, scene_slot,
//                   target_bo_slot)               -> submit_id | err
//     await_completion(submit_id, timeout_ns)     -> ok | err
//
// All three are ONE-SHOT RPCs (request -> response). The scene is
// named by KIND_VELLO_SCENE cap slot; the renderer is KIND_VELLO_
// RENDERER. Same posture as vk_surface_channel.pdx / vrr_channel.pdx.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the render conversation: event ordinals,
// argument-shape validators, and small pack/unpack primitives.
//
// It is NOT an endpoint (no queue), NOT a transport, NOT the driver
// (the encode/submit seams live in drivers/vello/vello_scene_encoder.pdx
// and drivers/vello/vello_pipeline.pdx and ARE called from here
// through vrc_apply_*). Effect row on submit_render is !{gpu_submit,
// gpu_wait}.
//
// =============================================================================
// SECTION 1  EVENT ORDINALS 0xD0..0xD2
// =============================================================================
//
//   VRC_EV_ENCODE_SCENE      0xD0
//   VRC_EV_SUBMIT_RENDER     0xD1
//   VRC_EV_AWAIT_COMPLETION  0xD2
//
// Ordinals live in the 0xD0 band -- distinct from modeset (0x90),
// display_sync (0xA0), vrr (0xB0), vk_surface (0xC0), so a
// dispatcher switching on ordinal cannot cross wires.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDE0..0xFFFFEDEF
// =============================================================================

module VelloRenderChannel = structure {

  pub let VRC_EV_ENCODE_SCENE     : u64 = 0xD0
  pub let VRC_EV_SUBMIT_RENDER    : u64 = 0xD1
  pub let VRC_EV_AWAIT_COMPLETION : u64 = 0xD2
  pub let VRC_EV_MAX              : u64 = 0xD2

  pub let VRC_OK             : u64 = 0
  pub let VRC_BAD_EV         : u64 = 0xFFFFEDEF
  pub let VRC_BAD_SLOT       : u64 = 0xFFFFEDEE
  pub let VRC_BAD_BYTES      : u64 = 0xFFFFEDED
  pub let VRC_BAD_PATHS      : u64 = 0xFFFFEDEC
  pub let VRC_BAD_SAMPLES    : u64 = 0xFFFFEDEB
  pub let VRC_BAD_FLAGS      : u64 = 0xFFFFEDEA
  pub let VRC_NO_SCENE       : u64 = 0xFFFFEDE9
  pub let VRC_NO_RENDERER    : u64 = 0xFFFFEDE8
  pub let VRC_NO_BO          : u64 = 0xFFFFEDE7
  pub let VRC_APPLY_FAILED   : u64 = 0xFFFFEDE6
  pub let VRC_TIMEOUT        : u64 = 0xFFFFEDE5

  pub let VRC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _vrenc_stats : [u64; 4] = uninit @align(64)

  pub let VRC_ST_ENCODES  : u64 = 0
  pub let VRC_ST_SUBMITS  : u64 = 1
  pub let VRC_ST_AWAITS   : u64 = 2
  pub let VRC_ST_REFUSED  : u64 = 3

  pub let vrc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-004 (#1478): clear schema counters.",
      block: {
        lea r10, [rip + _vrenc_stats];
        xor rax, rax;
        xor rcx, rcx;
      vrc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vrc_rs_loop;
        ret
      }
    }

  pub let vrc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-004 (#1478): counter bump.",
      block: {
        cmp rdi, 4;
        jae vrc_nt_out;
        lea r10, [rip + _vrenc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vrc_nt_out:
        ret
      }
    }

  pub let vrc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-004 (#1478): counter read.",
      block: {
        cmp rdi, 4;
        jae vrc_st_zero;
        lea r10, [rip + _vrenc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vrc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vrc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-004 (#1478): 1 iff ev in [0xD0, 0xD2].",
      block: {
        mov r10, 0xD0;
        cmp rdi, r10;
        jb  vrc_ev_no;
        mov r10, 0xD2;
        cmp rdi, r10;
        ja  vrc_ev_no;
        mov rax, 1;
        ret;
      vrc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-004 (#1478): 1 iff s < 256.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vrc_sl_no;
        mov rax, 1;
        ret;
      vrc_sl_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vrc_apply_encode(scene_slot, encoded_bytes, path_count,
  //                  sample_count, flags) -> ok | err
  //
  // Resolve the KIND_VELLO_SCENE cap slot to a row, then delegate
  // to vse_encode in drivers/vello/vello_scene_encoder.pdx.
  // =========================================================================
  pub let vrc_apply_encode : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (scene_slot: u64) (encoded_bytes: u64) (paths: u64) (samps: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G4.M1-004 (#1478): resolve scene cap, validate args, delegate to vse_encode.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbx, r8;

        mov rdi, r12;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrc_ae_bad_slot;

        mov rdi, r13;
        call vs_bytes_valid;
        cmp rax, 0;
        je  vrc_ae_bad_bytes;

        mov rdi, r14;
        call vs_paths_valid;
        cmp rax, 0;
        je  vrc_ae_bad_paths;

        mov rdi, r15;
        call vs_samples_valid;
        cmp rax, 0;
        je  vrc_ae_bad_samps;

        mov rdi, rbx;
        call vs_flags_valid;
        cmp rax, 0;
        je  vrc_ae_bad_flags;

        mov rdi, r12;
        call vs_row_of_slot;
        cmp rax, 0xFF;
        je  vrc_ae_no_scene;

        mov rdi, 0;
        call vrc_note;

        mov rdi, rax;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8,  rbx;
        call vse_encode;
        jmp vrc_ae_out;

      vrc_ae_bad_slot:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDEE;
        jmp vrc_ae_out;
      vrc_ae_bad_bytes:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDED;
        jmp vrc_ae_out;
      vrc_ae_bad_paths:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDEC;
        jmp vrc_ae_out;
      vrc_ae_bad_samps:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDEB;
        jmp vrc_ae_out;
      vrc_ae_bad_flags:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDEA;
        jmp vrc_ae_out;
      vrc_ae_no_scene:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDE9;

      vrc_ae_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vrc_apply_submit(renderer_slot, scene_slot, target_bo_slot)
  //     -> submit_id | err
  //
  // Effect row on this RPC is !{gpu_submit, gpu_wait} per §2 issue
  // spec. Delegates to vp_submit which drives the compute pipelines.
  // =========================================================================
  pub let vrc_apply_submit : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (renderer_slot: u64) (scene_slot: u64) (target_bo_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G4.M1-004 (#1478): resolve renderer + scene, delegate to vp_submit. Effect row !{gpu_submit, gpu_wait} captured by the callee's driver seams.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrc_as_bad_slot;

        mov rdi, r13;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrc_as_bad_slot;

        mov rdi, r14;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrc_as_bad_slot;

        mov rdi, r12;
        call vr_row_of_slot;
        cmp rax, 0xFF;
        je  vrc_as_no_rend;
        mov rbx, rax;                     // renderer row

        mov rdi, r13;
        call vs_row_of_slot;
        cmp rax, 0xFF;
        je  vrc_as_no_scene;
        mov r15, rax;                     // scene row

        mov rdi, 1;
        call vrc_note;

        mov rdi, rbx;
        mov rsi, r15;
        mov rdx, r14;
        call vp_submit;
        jmp vrc_as_out;

      vrc_as_bad_slot:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDEE;
        jmp vrc_as_out;
      vrc_as_no_rend:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDE8;
        jmp vrc_as_out;
      vrc_as_no_scene:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFEDE9;

      vrc_as_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vrc_apply_await(submit_id, timeout_ns) -> ok | err
  // =========================================================================
  pub let vrc_apply_await : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (submit_id: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "G4.M1-004 (#1478): delegate to vp_await; effect row !{gpu_wait}.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, 2;
        call vrc_note;

        mov rdi, r12;
        mov rsi, r13;
        call vp_await;
        jmp vrc_aw_out;

      vrc_aw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
