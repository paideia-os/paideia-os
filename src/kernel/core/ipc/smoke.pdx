// PaideiaOS IPC Phase-1 Smoke Test (B6 MVP)
// B6-004: Producer-consumer fixture for enqueue/dequeue
//
// Smoke fixture that:
// 1. Enqueue 0xDEAD
// 2. Enqueue 0xBEEF
// 3. Dequeue → assert 0xDEAD
// 4. Dequeue → assert 0xBEEF
// 5. Print "IPC OK\n" if all pass

module Smoke = structure {

  pub let ipc_smoke : () -> () !{sysreg, mem} @{ipc} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { ipc },
    justification: "B6-004: MVP smoke test that exercises IPC by enqueuing two messages (0xDEAD, 0xBEEF) and dequeuing them to verify FIFO ordering. R51 Phase C (SUBSYS_IPC shard, design/kernel/boot-transcript.md §7): message body rewritten from `IPC OK` to `ipc endpoints ready [legacy: IPC OK]` via the new tag_ipc_narrative. Bracketed legacy suffix (memo §5.1 option B) preserves the `IPC OK` substring so the six goldens that assert it (tests/r{8,9,10,11,12}/expected-boot-*.txt) still match under tools/run-smoke.sh's ordered-substring rule. Coverage relationship is unchanged: the OK-token still lives inside the emitted string literal, so verify-fingerprint-coverage.sh's OK_TOK regex still fires on it, and the same golden lines still cover it. Old tag_ipc_smoke_ok deleted from keys.pdx — sole consumer was this file.",
    block: {
      // Enqueue 0xDEAD
      mov rdi, 0xDEAD;
      call ipc_enqueue;
      cmp rax, 1;                         // check if enqueue succeeded
      jne ipc_smoke_end;

      // Enqueue 0xBEEF
      mov rdi, 0xBEEF;
      call ipc_enqueue;
      cmp rax, 1;                         // check if enqueue succeeded
      jne ipc_smoke_end;

      // Dequeue → should get 0xDEAD
      call ipc_dequeue;
      cmp rax, 0xDEAD;                    // verify first message
      jne ipc_smoke_end;

      // Dequeue → should get 0xBEEF
      call ipc_dequeue;
      cmp rax, 0xBEEF;                    // verify second message
      jne ipc_smoke_end;

      // All 3 pass: emit a two-line record — narrative followed by the
      // byte-identical `IPC OK` fingerprint the six goldens (r8..r12)
      // and the fingerprint-coverage gate both anchor on. Two-line
      // (not bracketed suffix) mirrors the UD/RING3_HELLO/BLOB_SIG
      // pattern in this same shard.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_IPC_];
      lea rdx, [rip + tag_ipc_narrative];
      call klog_s1;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_IPC_];
      lea rdx, [rip + tag_ipc_smoke_ok];
      call klog_s1;

      ipc_smoke_end:
        ret
    }
  }

}
