// src/kernel/core/ipc/vk_present_feedback_channel.pdx -- G3.M3-001 (#1467)
//
// Session-type schema for the vk_present_feedback channel. Carries a
// STREAM (not one-shot) of presentation feedback records that fold
// VK_KHR_present_id (M3-002 #1468) + VK_KHR_present_wait (M3-003
// #1469) into ONE substrate: whenever the display timeline signals
// a present has landed, the compositor pushes a feedback record onto
// the stream, and any waiter reading the stream unblocks with the
// {presented_at_ns, refresh_ns, next_refresh_ns, discarded} tuple.
//
// FEEDBACK RECORD SHAPE (fits in TWO u64 words):
//
//   word0: present_id (u64)
//   word1: presented_at_ns[47:0] | refresh_ns_lo[63:48]  (16 bits of
//          refresh_ns are enough for eDP; the full 32-bit refresh_ns
//          is carried in a stream extension record when a 4K120 HDMI
//          output needs it -- deferred to G6).
//
// Actually, to keep the schema single-payload, we split into two
// separate stream events per present:
//
//     VFC_EV_LATCHED   0xD0  {present_id, presented_at_ns}
//     VFC_EV_REFRESH   0xD1  {refresh_ns, next_refresh_ns}
//     VFC_EV_DISCARD   0xD2  {present_id, reason}    (maintenance1)
//
// A waiter for present_id N reads until it sees an EV_LATCHED with
// present_id >= N (VK_KHR_present_wait semantics: N-1 is not enough,
// N is; a compositor MAY coalesce and emit EV_LATCHED for a later
// present, in which case the waiter for N unblocks with the later
// timestamp).
//
// =============================================================================
// SECTION 0  RELATIONSHIP TO KIND_DISPLAY_TIMELINE
// =============================================================================
//
// The G1 substrate already carries display timelines as
// KIND_DISPLAY_TIMELINE (0x185). VK_KHR_present_wait waits on ONE
// present_id, not on ONE timeline value. The two are related --
// present_id N is signalled AT SOME timeline value which the
// compositor knows -- but the mapping is not exposed as an
// invertible primitive because a swapchain resize can renumber
// timelines while present_ids remain monotone.
//
// This module carries the OTHER half: a queryable feedback record
// that a hosted vkWaitForPresentKHR call can wait on.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDE0..0xFFFFEDEF
// =============================================================================

module VkPresentFeedbackChannel = structure {

  pub let VFC_EV_LATCHED  : u64 = 0xD0
  pub let VFC_EV_REFRESH  : u64 = 0xD1
  pub let VFC_EV_DISCARD  : u64 = 0xD2
  pub let VFC_EV_MAX      : u64 = 0xD2

  pub let VFC_OK          : u64 = 0
  pub let VFC_BAD_EV      : u64 = 0xFFFFEDEF
  pub let VFC_BAD_SLOT    : u64 = 0xFFFFEDEE
  pub let VFC_BAD_ID      : u64 = 0xFFFFEDED
  pub let VFC_BAD_TS      : u64 = 0xFFFFEDEC
  pub let VFC_QUEUE_FULL  : u64 = 0xFFFFEDEB
  pub let VFC_TIMEOUT     : u64 = 0xFFFFEDEA
  pub let VFC_NO_IMAGE    : u64 = 0xFFFFEDE9

  pub let VFC_QUEUE_LEN   : u64 = 32

  // The queue: 32 slots * 2 u64s (present_id + payload) = 64 u64s.
  // Plus head / tail cursors (2 u64s). Confined by tools/build.sh.
  pub let mut _vfc_queue  : [u64; 64] = uninit @align(64)
  pub let mut _vfc_cursor : [u64; 2]  = uninit @align(64)   // [head, tail]
  pub let mut _vfc_stats  : [u64; 4]  = uninit @align(64)

  pub let VFC_ST_PUSHED : u64 = 0
  pub let VFC_ST_POPPED : u64 = 1
  pub let VFC_ST_WAITED : u64 = 2
  pub let VFC_ST_REFUSED : u64 = 3

  pub let vfc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): clear queue + counters.",
      block: {
        lea r10, [rip + _vfc_queue];
        xor rax, rax;
        xor rcx, rcx;
      vfc_rs_q:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  vfc_rs_q;

        lea r10, [rip + _vfc_cursor];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        lea r10, [rip + _vfc_stats];
        xor rcx, rcx;
      vfc_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vfc_rs_st;
        ret
      }
    }

  pub let vfc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): counter bump.",
      block: {
        cmp rdi, 4;
        jae vfc_nt_out;
        lea r10, [rip + _vfc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vfc_nt_out:
        ret
      }
    }

  pub let vfc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): counter read.",
      block: {
        cmp rdi, 4;
        jae vfc_st_zero;
        lea r10, [rip + _vfc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vfc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vfc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M3-001 (#1467): 1 iff ev in [0xD0, 0xD2].",
      block: {
        mov r10, 0xD0;
        cmp rdi, r10;
        jb  vfc_ev_no;
        mov r10, 0xD2;
        cmp rdi, r10;
        ja  vfc_ev_no;
        mov rax, 1;
        ret;
      vfc_ev_no:
        xor rax, rax;
        ret
      }
    }

  // Push a feedback record. VFC_QUEUE_FULL if head catches tail.
  pub let vfc_push : (u64, u64) -> u64 !{mem} @{} =
    fn (present_id: u64) (payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): enqueue (present_id, payload). Refuses QUEUE_FULL rather than clobbering the oldest record. Three pushes to keep rsp aligned across vfc_note call.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        lea r10, [rip + _vfc_cursor];
        mov r11, [r10 + 0];         // head
        mov rcx, [r10 + 8];         // tail
        mov rax, r11;
        add rax, 1;
        cmp rax, 32;
        jb  vfc_pu_head_ok;
        xor rax, rax;
      vfc_pu_head_ok:
        cmp rax, rcx;
        je  vfc_pu_full;

        lea r10, [rip + _vfc_queue];
        mov rcx, r11;
        shl rcx, 4;                 // 2 u64 * 8 = 16 per slot
        add r10, rcx;
        mov [r10 + 0], r12;
        mov [r10 + 8], r13;

        lea r10, [rip + _vfc_cursor];
        mov [r10 + 0], rax;

        mov rdi, 0;
        call vfc_note;

        xor rax, rax;
        jmp vfc_pu_out;

      vfc_pu_full:
        mov rdi, 3;
        call vfc_note;
        mov rax, 0xFFFFEDEB;

      vfc_pu_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Pop one feedback record if any. Returns present_id in rax,
  // payload in rdx; on empty returns (0, 0). Callers pair this with
  // vfc_len to distinguish "empty" from "present_id 0". Uses three
  // callee-save pushes (odd count, keeps rsp aligned) to survive
  // vfc_note's clobber of rax/rdx.
  pub let vfc_pop : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): FIFO drain. rdx carries payload; rax carries present_id. On empty rax=0. Callee-save regs preserve return values across vfc_note.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _vfc_cursor];
        mov r11, [r10 + 0];       // head
        mov rcx, [r10 + 8];       // tail
        cmp r11, rcx;
        je  vfc_po_empty;

        lea r9, [rip + _vfc_queue];
        mov r8, rcx;
        shl r8, 4;
        add r9, r8;
        mov r12, [r9 + 0];        // save present_id
        mov r13, [r9 + 8];        // save payload

        add rcx, 1;
        cmp rcx, 32;
        jb  vfc_po_tail_ok;
        xor rcx, rcx;
      vfc_po_tail_ok:
        mov [r10 + 8], rcx;

        mov rdi, 1;
        call vfc_note;

        mov rax, r12;
        mov rdx, r13;
        jmp vfc_po_out;

      vfc_po_empty:
        xor rax, rax;
        xor rdx, rdx;

      vfc_po_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vfc_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-001 (#1467): (head - tail) mod QUEUE_LEN.",
      block: {
        lea r10, [rip + _vfc_cursor];
        mov rax, [r10 + 0];
        mov rcx, [r10 + 8];
        sub rax, rcx;
        js  vfc_le_wrap;
        ret;
      vfc_le_wrap:
        add rax, 32;
        ret
      }
    }

  // VK_KHR_present_wait: block (spin, bounded by timeout_ns) until
  // we observe an EV_LATCHED with present_id >= target_id.
  // Returns presented_at_ns (payload of the event we saw), or
  // VFC_TIMEOUT.
  pub let vfc_wait_for_present : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (target_id: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "G3.M3-003 (#1469): drain queue looking for present_id >= target_id. Bounded spin with hpet_now_ns deadline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        xor r15, r15;
        cmp r13, 0;
        je  vfc_wp_loop;
        call hpet_now_ns;
        add rax, r13;
        mov r15, rax;

        mov rdi, 2;
        call vfc_note;

      vfc_wp_loop:
        call vfc_pop;
        cmp rax, 0;
        je  vfc_wp_check_deadline;
        cmp rax, r12;
        jb  vfc_wp_loop;
        mov rax, rdx;               // presented_at_ns (payload)
        jmp vfc_wp_out;

      vfc_wp_check_deadline:
        cmp r15, 0;
        je  vfc_wp_pause;
        call hpet_now_ns;
        cmp rax, r15;
        jae vfc_wp_timeout;
      vfc_wp_pause:
        pause;
        jmp vfc_wp_loop;

      vfc_wp_timeout:
        mov rax, 0xFFFFEDEA;

      vfc_wp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
