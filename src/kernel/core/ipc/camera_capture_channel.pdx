// src/kernel/core/ipc/camera_capture_channel.pdx — R40.M3-003 (#1357)
//
// The SCHEMA of the camera_capture_channel session.  Companion to
// KIND_IPU6_STREAM (cap/kind_ipu6_stream.pdx) -- this module packs
// and unpacks the u64 frame ordinals a ring-3 camera supervisor
// sends and receives, and stages the session FSM.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session the IPU6 pipeline driver and the
// ring-3 camera supervisor share over ONE endpoint.  It is NOT an
// endpoint, NOT a transport, and NOT a driver.  The session type is:
//
//   camera_capture : Channel {
//     open( stream_slot ); configure( fmt, w, h, fps );
//     begin_stream;
//     ( frame -> { bo_slot } )*;
//     end_stream;
//     close
//   }
//
// Every frame is one u64.  Requests carry an op ordinal in the low
// byte; frame delivery replies carry a KIND_GPU_BO slot ordinal in
// the high bits (zero-copy: the buffer is a pre-imported GPU BO the
// pipeline hands back on completion).
//
// =============================================================================
// §1  ONE u64 FRAMES + SESSION FSM
// =============================================================================
//
// State machine (guarded by ccc_state_*):
//
//   CCC_STATE_CLOSED     ---open()--> CCC_STATE_OPENED
//   CCC_STATE_OPENED     ---configure(...)--> CCC_STATE_CONFIGURED
//   CCC_STATE_CONFIGURED ---begin_stream--> CCC_STATE_STREAMING
//   CCC_STATE_STREAMING  ---frame*--> CCC_STATE_STREAMING
//   CCC_STATE_STREAMING  ---end_stream--> CCC_STATE_CONFIGURED
//   CCC_STATE_CONFIGURED ---close--> CCC_STATE_CLOSED
//   CCC_STATE_OPENED     ---close--> CCC_STATE_CLOSED
//
// Ordinals occupy 0x60..0x66.  Reserved bits on every op are REFUSED,
// not masked, for the reason every schema in this tree states.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF1D0..0xFFFFF1DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time.

module CameraCaptureChannel = structure {

  // Op ordinals (0x60..0x66).
  pub let CCC_OP_OPEN         : u64 = 0x60
  pub let CCC_OP_CONFIGURE    : u64 = 0x61
  pub let CCC_OP_BEGIN_STREAM : u64 = 0x62
  pub let CCC_OP_FRAME        : u64 = 0x63
  pub let CCC_OP_END_STREAM   : u64 = 0x64
  pub let CCC_OP_CLOSE        : u64 = 0x65
  pub let CCC_OP_MAX          : u64 = 0x65

  // Session states.
  pub let CCC_STATE_CLOSED     : u64 = 0
  pub let CCC_STATE_OPENED     : u64 = 1
  pub let CCC_STATE_CONFIGURED : u64 = 2
  pub let CCC_STATE_STREAMING  : u64 = 3
  pub let CCC_STATE_MAX        : u64 = 3

  // Output format ordinals (must match KIND_IPU6_STREAM's).
  pub let CCC_FMT_NV12  : u64 = 1
  pub let CCC_FMT_YUYV  : u64 = 2
  pub let CCC_FMT_RAW10 : u64 = 3

  // Failure taxonomy 0xFFFFF1D0..DF.
  pub let CCC_OK           : u64 = 0
  pub let CCC_BAD_OP       : u64 = 0xFFFFF1DF
  pub let CCC_BAD_STATE    : u64 = 0xFFFFF1DE
  pub let CCC_BAD_FORMAT   : u64 = 0xFFFFF1DD
  pub let CCC_BAD_DIM      : u64 = 0xFFFFF1DC
  pub let CCC_BAD_FPS      : u64 = 0xFFFFF1DB
  pub let CCC_BAD_STREAM   : u64 = 0xFFFFF1DA
  pub let CCC_BAD_BO       : u64 = 0xFFFFF1D9
  pub let CCC_BAD_RESERVED : u64 = 0xFFFFF1D8
  pub let CCC_NOT_STREAMING : u64 = 0xFFFFF1D7

  pub let CCC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Session state cell (one active session in this scaffold; a live
  // supervisor would key on subscriber endpoint id).
  pub let mut _ccc_state : [u64; 4] = uninit @align(64)

  pub let CCC_ST_STREAM_SLOT : u64 = 0
  pub let CCC_ST_FSM         : u64 = 1
  pub let CCC_ST_FRAMES      : u64 = 2
  pub let CCC_ST_LAST_BO     : u64 = 3

  pub let mut _ccc_stats : [u64; 8] = uninit @align(64)
  pub let CCC_STAT_OPENS       : u64 = 0
  pub let CCC_STAT_CONFIGS     : u64 = 1
  pub let CCC_STAT_BEGINS      : u64 = 2
  pub let CCC_STAT_FRAMES      : u64 = 3
  pub let CCC_STAT_ENDS        : u64 = 4
  pub let CCC_STAT_CLOSES      : u64 = 5
  pub let CCC_STAT_REFUSED     : u64 = 6

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ccc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): clear session cell + stats. Boot + teardown. Labels prefixed ccc_rs_.",
      block: {
        lea r10, [rip + _ccc_state];
        xor rax, rax;
        xor rcx, rcx;
      ccc_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ccc_rs_state;

        lea r10, [rip + _ccc_stats];
        xor rcx, rcx;
      ccc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ccc_rs_stats;
        ret
      }
    } @no_frame

  pub let ccc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): counter bump. Labels prefixed ccc_nt_.",
      block: {
        cmp rdi, 8;
        jae ccc_nt_out;
        lea r10, [rip + _ccc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ccc_nt_out:
        ret
      }
    } @no_frame

  pub let ccc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): counter read. Labels prefixed ccc_st_.",
      block: {
        cmp rdi, 8;
        jae ccc_st_zero;
        lea r10, [rip + _ccc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ccc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // FSM accessors.
  // ==========================================================================

  pub let ccc_fsm_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): current FSM state. Labels prefixed ccc_fg_.",
      block: {
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let ccc_stream_slot_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): stream_slot bound at open. Labels prefixed ccc_ssg_.",
      block: {
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ccc_frames_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): frames delivered since begin_stream. Labels prefixed ccc_fmg_.",
      block: {
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let ccc_last_bo_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): last KIND_GPU_BO slot delivered. Labels prefixed ccc_lbg_.",
      block: {
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Op validators.
  // ==========================================================================

  pub let ccc_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-003 (#1357): 1 iff op in [0x60, 0x65]. Labels prefixed ccc_ov_.",
      block: {
        cmp rdi, 0x60;
        jb  ccc_ov_no;
        cmp rdi, 0x65;
        ja  ccc_ov_no;
        mov rax, 1;
        ret;
      ccc_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ccc_format_valid : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-003 (#1357): 1 iff fmt in {NV12, YUYV, RAW10}. Labels prefixed ccc_fv_.",
      block: {
        cmp rdi, 1;
        je  ccc_fv_yes;
        cmp rdi, 2;
        je  ccc_fv_yes;
        cmp rdi, 3;
        je  ccc_fv_yes;
        xor rax, rax;
        ret;
      ccc_fv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // FSM ops.
  // ==========================================================================

  pub let ccc_open : (u64) -> u64 !{mem} @{} =
    fn (stream_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): open session bound to KIND_IPU6_STREAM slot. Refuses BAD_STATE if already open, BAD_STREAM if stream_slot == 0. Does NOT gate on cap_table -- that gate belongs to the ring-3 supervisor holding the cap. Labels prefixed ccc_op_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;

        // Must be CLOSED.
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne ccc_op_bad_state;

        cmp rbx, 0;
        je  ccc_op_bad_stream;

        lea r10, [rip + _ccc_state];
        mov [r10 + 0], rbx;              // STREAM_SLOT
        mov rax, 1;                      // OPENED
        mov [r10 + 8], rax;
        xor rax, rax;
        mov [r10 + 16], rax;             // FRAMES = 0
        mov [r10 + 24], rax;             // LAST_BO = 0

        mov rdi, 0;                      // OPENS
        call ccc_note;

        xor rax, rax;
        jmp ccc_op_out;

      ccc_op_bad_state:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DE;
        jmp ccc_op_out;
      ccc_op_bad_stream:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DA;

      ccc_op_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ccc_configure : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fmt: u64) (width: u64) (height: u64) (fps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): configure the session. Requires OPENED. Refuses BAD_FORMAT / BAD_DIM / BAD_FPS. Labels prefixed ccc_cf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // fmt
        mov r12, rsi;                    // width
        mov r13, rdx;                    // height
        mov r14, rcx;                    // fps

        // Must be OPENED.
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 1;
        jne ccc_cf_bad_state;

        mov rdi, rbx;
        call ccc_format_valid;
        cmp rax, 0;
        je  ccc_cf_bad_format;

        cmp r12, 0;
        je  ccc_cf_bad_dim;
        mov r10, 8192;
        cmp r12, r10;
        ja  ccc_cf_bad_dim;
        cmp r13, 0;
        je  ccc_cf_bad_dim;
        cmp r13, r10;
        ja  ccc_cf_bad_dim;

        cmp r14, 0;
        je  ccc_cf_bad_fps;
        mov r10, 120;
        cmp r14, r10;
        ja  ccc_cf_bad_fps;

        // Advance to CONFIGURED.
        lea r10, [rip + _ccc_state];
        mov rax, 2;
        mov [r10 + 8], rax;

        mov rdi, 1;                      // CONFIGS
        call ccc_note;

        xor rax, rax;
        jmp ccc_cf_out;

      ccc_cf_bad_state:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DE;
        jmp ccc_cf_out;
      ccc_cf_bad_format:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DD;
        jmp ccc_cf_out;
      ccc_cf_bad_dim:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DC;
        jmp ccc_cf_out;
      ccc_cf_bad_fps:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DB;

      ccc_cf_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ccc_begin_stream : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): begin_stream. Requires CONFIGURED. Labels prefixed ccc_bs_.",
      block: {
        push rbx;

        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 2;
        jne ccc_bs_bad_state;

        mov rax, 3;                      // STREAMING
        mov [r10 + 8], rax;

        mov rdi, 2;                      // BEGINS
        call ccc_note;

        xor rax, rax;
        jmp ccc_bs_out;

      ccc_bs_bad_state:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DE;

      ccc_bs_out:
        pop rbx;
        ret
      }
    }

  pub let ccc_frame : (u64) -> u64 !{mem} @{} =
    fn (bo_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): frame delivery -- bo_slot names a KIND_GPU_BO the pipeline hands back on completion. Requires STREAMING. Refuses BAD_BO if bo_slot == 0. Labels prefixed ccc_fr_.",
      block: {
        push rbx;

        mov rbx, rdi;

        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 3;
        jne ccc_fr_not_streaming;

        cmp rbx, 0;
        je  ccc_fr_bad_bo;

        // Bump frames + stamp last_bo.
        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov [r10 + 24], rbx;

        mov rdi, 3;                      // FRAMES
        call ccc_note;

        xor rax, rax;
        jmp ccc_fr_out;

      ccc_fr_not_streaming:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1D7;
        jmp ccc_fr_out;
      ccc_fr_bad_bo:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1D9;

      ccc_fr_out:
        pop rbx;
        ret
      }
    }

  pub let ccc_end_stream : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): end_stream. Requires STREAMING. Advances to CONFIGURED so a supervisor can re-begin without re-configuring. Labels prefixed ccc_es_.",
      block: {
        push rbx;

        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 3;
        jne ccc_es_bad_state;

        mov rax, 2;                      // CONFIGURED
        mov [r10 + 8], rax;

        mov rdi, 4;                      // ENDS
        call ccc_note;

        xor rax, rax;
        jmp ccc_es_out;

      ccc_es_bad_state:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DE;

      ccc_es_out:
        pop rbx;
        ret
      }
    }

  pub let ccc_close : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-003 (#1357): close. Requires OPENED or CONFIGURED (a STREAMING session must end_stream first). Scrubs stream_slot, resets FSM to CLOSED. Labels prefixed ccc_cl_.",
      block: {
        push rbx;

        lea r10, [rip + _ccc_state];
        mov rax, [r10 + 8];
        cmp rax, 1;
        je  ccc_cl_ok;
        cmp rax, 2;
        je  ccc_cl_ok;
        jmp ccc_cl_bad_state;

      ccc_cl_ok:
        lea r10, [rip + _ccc_state];
        xor rax, rax;
        mov [r10 + 0], rax;              // STREAM_SLOT
        mov [r10 + 8], rax;              // FSM = CLOSED
        mov [r10 + 16], rax;             // FRAMES = 0
        mov [r10 + 24], rax;             // LAST_BO = 0

        mov rdi, 5;                      // CLOSES
        call ccc_note;

        xor rax, rax;
        jmp ccc_cl_out;

      ccc_cl_bad_state:
        mov rdi, 6;
        call ccc_note;
        mov rax, 0xFFFFF1DE;

      ccc_cl_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Packers / unpackers.
  //
  // FRAME reply pack:  op 0x63 | bo_slot[63:32].
  // ==========================================================================

  pub let ccc_pack_frame_reply : (u64) -> u64 !{} @{} =
    fn (bo_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-003 (#1357): FRAME reply -- op 0x63 | bo_slot[63:32]. Refuses bo_slot == 0 or > u32. Labels prefixed ccc_pf_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  ccc_pf_bad;
        cmp rdi, 0;
        je  ccc_pf_bad;
        mov rax, 0x63;
        mov r10, rdi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      ccc_pf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ccc_op_of : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-003 (#1357): op ordinal from low byte.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let ccc_bo_slot_of : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-003 (#1357): bo_slot from bits [63:32]. Gates op == 0x63. Labels prefixed ccc_bo_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x63;
        jne ccc_bo_bad;
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret;
      ccc_bo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
