// src/kernel/core/ipc/endpoint_table.pdx — R20b.M1-002 (#1553)
//                                          + R20b.M2-002 (#1556)
// 128-slot static endpoint table + endpoint_alloc / endpoint_free /
// endpoint_lookup primitives (M1-002).
// Single-in-flight pending-msg primitives — endpoint_write_pending /
// endpoint_take_pending / endpoint_is_full (M2-002).
//
// Design context
// --------------
// This is the storage layer for KIND_IPC_ENDPOINT (base kind 5). Every
// downstream R20b piece (broker M1-002b, framing M2, syscalls M3, loader-
// seed M4) reads/writes this table through the primitives below. The
// tail-encoding module (kind_endpoint.pdx, landed in R20b.M1-001) packs
// (endpoint_id, direction) into the descriptor's target_ptr slot; the
// endpoint_id it names is exactly the index into this table.
//
// Per design/ipc/userspace-server-substrate.md §3.1:
//
//   Endpoint (48 bytes, cache-line-aligned)
//     +0    u16 endpoint_id           (redundant; helps audit)
//     +2    u8  in_use                (1 = live, 0 = free)
//     +3    u8  flags                 (bit 0 = has_pending_msg,
//                                      bit 1 = has_pending_reply)
//     +4    u32 reserved
//     +8    u64 owner_tcb             (pointer to receiver's TCB, NULL until bound)
//     +16   u64 payload_buf_pa        (4 KiB page holding in-flight message)
//     +24   u64 pending_hdr           (8-byte header of the message)
//     +32   u64 waiter_tcb            (TCB blocked on this endpoint's recv)
//     +40   u64 reserved              (future: session_state pointer)
//
// 128 rows × 48 bytes = 6144 B total. No dynamic allocation at R20b:
// the entire table lives in .bss, zero-initialized by zero_bss.pdx
// (which means every row starts as free — u64 at [row+0] == 0).
//
// Alloc discipline
// ----------------
// endpoint_alloc scans rows low-to-high; the first row whose first
// u64 is zero is claimed. Claim writes ((1 << 16) | id) into [row+0]
// — setting in_use=1 at byte 2, endpoint_id at bytes 0..1, and
// leaving flags (byte 3) + reserved (bytes 4..7) at zero. This
// keeps the field-level free/live discipline atomic against a
// single u64 load in endpoint_lookup: zero-init at .bss reset AND
// zero-init at endpoint_free both leave the "is free" test as a
// simple `cmp [row+0], 0`.
//
// The payload buffer (payload_arena.pdx) is bound to the endpoint by
// convention (1:1 by id), NOT written into the row by endpoint_alloc.
// R20b.M2 wire-up populates payload_buf_pa (offset +16) via a separate
// bind step so the storage-layer primitive stays free of cross-module
// dependencies; endpoint_alloc / endpoint_free / endpoint_lookup all
// operate purely on the endpoint_table.
//
// Free discipline
// ---------------
// endpoint_free zeroes all six u64s of the row (48 bytes). Zeroing
// [row+0] alone would be sufficient for the free/live discipline, but
// full-row zeroing prevents stale owner_tcb / waiter_tcb / payload_buf_pa
// pointers from leaking into a subsequent alloc's row-read.
//
// Concurrency / ABA
// -----------------
// No handle-generation or ABA guard at R20b: the substrate's single-flow
// phase-1 discipline does not admit concurrent alloc/free on the same
// endpoint (see design §4.2 — single in-flight message per endpoint).
// SMP-safe alloc arrives in a later round when the substrate grows a
// generation counter or a per-row spinlock (design §14 Q3).
//
// M2-002 pending-msg semantics (design §4.3)
// ------------------------------------------
// The M2 wire-up fuses the endpoint row (this file) with the payload
// arena page (payload_arena.pdx) at every send/recv boundary — one
// endpoint row + one 4 KiB payload page carry a single in-flight message.
// endpoint_write_pending / endpoint_take_pending are the kernel-side
// primitives sys_ipc_send / sys_ipc_recv (M3-001, M3-002) build on.
//
// Discriminator: the row's pending_hdr slot at +24 doubles as the "is
// there a message?" bit. Zero == empty, non-zero == a valid encoded
// header sits there. This is safe because every valid header (per
// frame.pdx / acpi-supervisor-schema.md §3) has ver >= 1 in bits 8..15,
// so the packed u64 is never zero for a live message. Choosing the hdr
// slot as the discriminator collapses "is the endpoint full?" into a
// single u64 read/write per state change; the flags byte at +3 stays
// available for the M3 reply-path bit and the (future) waiter-count
// accounting.
//
// Publish barrier — endpoint_write_pending writes the payload BEFORE
// stamping pending_hdr. Under R20b's single-flow discipline there are
// no concurrent readers, but ordering the writes as (payload then hdr)
// preserves the invariant "pending_hdr non-zero ⇒ payload fully
// published in payload_arena[id]" that R21+ SMP receivers will assume.
// endpoint_take_pending mirrors this: (read hdr, copy payload out, then
// zero hdr) — clearing the hdr LAST means a concurrent writer can never
// see "hdr zero, payload half-consumed".
//
// Sentinel discipline. endpoint_write_pending returns:
//   PENDING_WRITE_OK              (0) — hdr + payload published.
//   PENDING_WRITE_ERR_EAGAIN      (1) — endpoint has a pending message
//                                        (single-slot at R20b; EAGAIN per
//                                        design §4.3 step 3).
//   PENDING_WRITE_ERR_BAD_ID      (2) — id >= 128 or endpoint not live.
//   PENDING_WRITE_ERR_PAYLOAD_LEN (3) — payload_len > FRAME_MAX_PAYLOAD
//                                        (E2BIG per design §4.3 step 2).
// endpoint_take_pending returns:
//   PENDING_TAKE_EMPTY (0xFFFFFFFFFFFFFFFF) — no pending message; caller
//                                              blocks/retries per §4.3
//                                              recv step 2.
//   otherwise           — the u32 payload_len that was in the packed
//                         header. payload_len can be 0 (a header-only
//                         message), distinct from the -1 empty sentinel.
// endpoint_is_full returns 1 iff pending_hdr != 0, else 0. Bounds-check
// off-range ids returns 0 (matches the "no pending message on an
// invalid id" reading — the id could never have received a message).

module EndpointTable = structure {

  // ============================================================================
  // Table geometry (pinned by design/ipc/userspace-server-substrate.md §3.1)
  // ============================================================================

  pub let ENDPOINT_ROW_BYTES     : u64 = 48
  pub let ENDPOINT_TABLE_SLOTS   : u64 = 128
  pub let ENDPOINT_TABLE_BYTES   : u64 = 6144        // 128 * 48

  // ============================================================================
  // Sentinels
  // ============================================================================

  pub let ENDPOINT_ALLOC_NONE    : u64 = 0xFFFFFFFFFFFFFFFF   // -1 on exhaustion
  pub let ENDPOINT_LOOKUP_NONE   : u64 = 0                    // NULL on miss

  // ============================================================================
  // R20b.M2-002 (#1556): pending-msg primitive result codes.
  //
  // endpoint_write_pending returns a small u64 rc; 0 = success, non-zero
  // = distinct error category (mirrors FRAME_ENCODE_* / SVC_REGISTER_*
  // discipline: success == 0, each error gets its own code).
  //
  // endpoint_take_pending returns either the payload_len (u32) that was
  // in the pending header, or PENDING_TAKE_EMPTY when the endpoint has
  // no pending message. Valid payload_len ∈ [0, FRAME_MAX_PAYLOAD=4088];
  // 0xFFFFFFFFFFFFFFFF sits far outside that range so a caller can
  // discriminate the two return kinds with a single `cmp rax, -1`.
  // ============================================================================

  pub let PENDING_WRITE_OK              : u64 = 0
  pub let PENDING_WRITE_ERR_EAGAIN      : u64 = 1
  pub let PENDING_WRITE_ERR_BAD_ID      : u64 = 2
  pub let PENDING_WRITE_ERR_PAYLOAD_LEN : u64 = 3

  pub let PENDING_TAKE_EMPTY            : u64 = 0xFFFFFFFFFFFFFFFF

  // FRAME_MAX_PAYLOAD sourced from design/ipc/userspace-server-substrate.md
  // §4.1 (matches PayloadArena.PAYLOAD_MAX_BYTES / Frame.FRAME_MAX_PAYLOAD;
  // frozen here so the length gate reads locally without cross-module
  // constant lookups that paideia-as does not (yet) resolve at parse time).
  pub let PENDING_PAYLOAD_MAX_BYTES     : u64 = 4088

  // ============================================================================
  // Row-field offsets (bytes, from row base)
  // ============================================================================

  pub let ENDPOINT_OFF_ID            : u64 = 0
  pub let ENDPOINT_OFF_IN_USE        : u64 = 2
  pub let ENDPOINT_OFF_FLAGS         : u64 = 3
  pub let ENDPOINT_OFF_OWNER_TCB     : u64 = 8
  pub let ENDPOINT_OFF_PAYLOAD_BUF   : u64 = 16
  pub let ENDPOINT_OFF_PENDING_HDR   : u64 = 24
  pub let ENDPOINT_OFF_WAITER_TCB    : u64 = 32
  pub let ENDPOINT_OFF_BINDING       : u64 = 40

  // ============================================================================
  // R29.M7-005 (#1048): driver binding word at [+40]
  //
  //   bits [4:0]   driver_slot   (_driver_table slot serving this endpoint)
  //   bit  [5]     bound
  //   bit  [6]     dead          (ChannelDead latched — never cleared)
  //   bits [15:8]  incarnation   (the driver incarnation this endpoint serves)
  //   bits [63:16] reserved
  //
  // Why the endpoint records an incarnation, not just a slot
  // -------------------------------------------------------
  // A driver slot is reused across restarts by design — the descriptor
  // survives, the driver's life does not (driver_table.pdx
  // §rearm_incarnation). If the endpoint recorded only the slot, an
  // endpoint bound to the driver that died would be indistinguishable
  // from one bound to the driver that came back, and a capability
  // minted against the dead incarnation would silently address the live
  // one. The incarnation is what makes "the same slot" and "the same
  // driver" different questions, which is the whole content of the
  // stale-capability refusal in design/drivers/cascade-restart.md §6.5.
  //
  // Why `dead` is a latch with no clear operation
  // ---------------------------------------------
  // There is deliberately no endpoint_mark_alive. The only exit from
  // the dead state is endpoint_free, which zeroes the row — and after a
  // free, a stale capability naming that id resolves through
  // endpoint_lookup to a row that is not live, so every syscall on it
  // returns -EBADF. Making revival impossible rather than merely
  // discouraged is what lets the restarted driver's fresh endpoint be
  // the ONLY path back to it: a client must re-cross sys_svc_lookup and
  // be minted a new capability. A clearable flag would have re-opened
  // exactly the authority-laundering window the latch closes.
  //
  // Free rows are fully zeroed by endpoint_free (and by .bss init), so
  // a freshly allocated endpoint is unbound and alive by construction —
  // endpoint_alloc need not touch this word.
  // ============================================================================

  pub let ENDPOINT_BIND_DRIVER_MASK  : u64 = 0x1F       // bits [4:0]
  pub let ENDPOINT_BIND_PRESENT      : u64 = 0x20       // bit 5
  pub let ENDPOINT_BIND_DEAD         : u64 = 0x40       // bit 6
  pub let ENDPOINT_BIND_INCARN_SHIFT : u64 = 8          // bits [15:8]

  pub let EP_BIND_OK                 : u64 = 0
  pub let EP_BIND_ERR_BAD_ID         : u64 = 1
  pub let EP_BIND_ERR_BAD_ARG        : u64 = 2
  pub let EP_BIND_ERR_DEAD           : u64 = 3

  // ============================================================================
  // Storage — 128 rows x 48 bytes = 6144 B = 768 u64s, @align(64).
  //
  // @align(64): puts the table start on a cache-line boundary. Rows are
  // 48 B each and therefore do NOT individually land on cache-line starts
  // (only rows 0, 4, 8, ... — every fourth — do; row size and cache-line
  // size are coprime after 48/16). A per-row @align(64) would waste 16 B
  // per row (~2 KiB total) with no observable benefit at R20b (single-
  // flow substrate, no per-endpoint contention). When R20b grows an SMP
  // fast-path (design §14 Q3), the row-padding tradeoff revisits.
  // ============================================================================

  pub let mut _ipc_endpoint_table : [u64; 768] = uninit @align(64)

  // ==========================================================================
  // endpoint_alloc() -> u64
  //
  // SysV ABI: no args -> rax = endpoint_id in [0..127] on success,
  // or ENDPOINT_ALLOC_NONE (0xFFFFFFFFFFFFFFFF) on exhaustion.
  //
  // Scans _ipc_endpoint_table low-to-high (r8 = row cursor, rcx = id).
  // A row is "free" iff its first u64 ([r8+0]) is zero — on fresh .bss
  // every row satisfies this; after endpoint_free the six-u64 zero
  // preserves it. Claim writes ((1<<16) | id) into [r8+0], which
  // sets in_use=1 at byte 2 and endpoint_id at bytes 0..1.
  // ==========================================================================

  // ==========================================================================
  // endpoint_alloc_at(id) -> rc      R31.M2-1590 (#1590)
  //
  // SysV ABI: rdi = requested endpoint_id -> rax = EP_ALLOC_AT_OK (0),
  // EP_ALLOC_AT_BAD_ID (1) if id >= 128, or EP_ALLOC_AT_IN_USE (2) if the
  // row is already claimed.
  //
  // Why a second allocator
  // ----------------------
  // endpoint_alloc hands out "the lowest free id", which is exactly right
  // for an anonymous channel and exactly wrong for a WELL-KNOWN service
  // endpoint. A boot-spawned server's `_init_caps` sidecar names its
  // endpoint by NUMBER at build time (echo_server.pdx seeds endpoint_id=1;
  // echo_client.pdx seeds 1 and 2), so the boot spawner must be able to
  // claim those specific rows rather than hope the free-list cursor lands
  // on them. Depending on endpoint_alloc's return values to come out as
  // 1 and 2 would make the spawn path silently order-dependent on every
  // preceding witness's alloc/free arithmetic — the class of coupling that
  // produces a green boot today and a mis-routed RPC after an unrelated
  // witness is added.
  //
  // Claim shape is byte-identical to endpoint_alloc's: ((1 << 16) | id)
  // into [row+0], i.e. in_use=1 at byte 2, endpoint_id at bytes 0..1. The
  // free predicate is likewise identical ([row+0] == 0), so the two
  // allocators cannot disagree about whether a row is taken.
  // ==========================================================================

  pub let EP_ALLOC_AT_OK     : u64 = 0
  pub let EP_ALLOC_AT_BAD_ID : u64 = 1
  pub let EP_ALLOC_AT_IN_USE : u64 = 2

  pub let endpoint_alloc_at : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M2-1590 (#1590): claim a SPECIFIC endpoint row so a boot-spawned server can own the well-known id its _init_caps sidecar names at build time. Bounds-gate id < 128 (ENDPOINT_TABLE_SLOTS) -> EP_ALLOC_AT_BAD_ID; row_pa = &_ipc_endpoint_table + id*48 computed as (id*32 + id*16) to stay inside the shl-only address idiom the rest of this module uses; refuse a non-zero header -> EP_ALLOC_AT_IN_USE; otherwise write ((1<<16) | id), the byte-identical claim endpoint_alloc performs. Leaf, no nested calls, callee-save clean (rax/rcx/rdx/r8 scratch only). Effects !{mem} for the header store; no capabilities — the row is kernel bookkeeping, not an authority.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae endpoint_alloc_at_bad_id;

        // row_pa = table + id*48 = table + (id<<5) + (id<<4)
        mov rcx, rdi;
        shl rcx, 5;                         // id * 32
        mov rdx, rdi;
        shl rdx, 4;                         // id * 16
        add rcx, rdx;                       // id * 48
        lea r8, [rip + _ipc_endpoint_table];
        add r8, rcx;                        // r8 = &row[id]

        mov rax, [r8];
        cmp rax, 0;
        jne endpoint_alloc_at_in_use;

        mov rax, 1;
        shl rax, 16;                        // in_use << 16
        or  rax, rdi;                       // | id
        mov [r8], rax;

        xor rax, rax;                       // EP_ALLOC_AT_OK
        ret;

      endpoint_alloc_at_bad_id:
        mov rax, 1;                         // EP_ALLOC_AT_BAD_ID
        ret;

      endpoint_alloc_at_in_use:
        mov rax, 2;                         // EP_ALLOC_AT_IN_USE
        ret
      }
    }

  pub let endpoint_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R20b.M1-002 (#1553): low-first row scan over _ipc_endpoint_table. r8 = row cursor (starts at table base, advances by 48 = ENDPOINT_ROW_BYTES each iteration); rcx = id (0..127). Row is free iff [r8+0] u64 is zero — invariant preserved by .bss zero-init AND by endpoint_free's full-row zero. Claim: ((1<<16) | id) into [r8+0] — sets in_use=1 at byte 2 (bit 16..23 of the u64), endpoint_id at bytes 0..1 (bit 0..15), leaves flags (byte 3) + reserved (bytes 4..7) at zero. Exhaustion returns 0xFFFFFFFFFFFFFFFF (ENDPOINT_ALLOC_NONE = -1). Return id in rax. Leaf function; no callee-save writes.",
      block: {
        lea r8, [rip + _ipc_endpoint_table];
        xor rcx, rcx;

      endpoint_alloc_scan:
        cmp rcx, 128;                       // ENDPOINT_TABLE_SLOTS
        jae endpoint_alloc_none;
        mov rax, [r8];                      // u64 at row+0 (id + in_use + flags + reserved32)
        cmp rax, 0;
        je  endpoint_alloc_found;
        add r8, 48;                         // ENDPOINT_ROW_BYTES
        add rcx, 1;
        jmp endpoint_alloc_scan;

      endpoint_alloc_found:
        // Pack in_use=1 at byte 2 (bit 16), id at bytes 0..1 (bits 0..15).
        mov rax, 1;
        shl rax, 16;                        // rax = 0x10000 = (in_use << 16)
        or  rax, rcx;                       // rax |= id
        mov [r8], rax;                      // write row header
        mov rax, rcx;                       // return id
        ret;

      endpoint_alloc_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;        // ENDPOINT_ALLOC_NONE (-1)
        ret
      }
    }

  // ==========================================================================
  // endpoint_free(id: u64) -> ()
  //
  // SysV ABI: rdi = id.
  //
  // No-op if id >= 128 (out of range). Otherwise zeroes all six u64s of
  // the row (48 bytes at offsets +0/+8/+16/+24/+32/+40). Zeroing [row+0]
  // clears in_use (byte 2) and reopens the slot for endpoint_alloc's
  // low-first scan. Full-row zeroing prevents stale owner_tcb /
  // waiter_tcb / payload_buf_pa pointers from leaking into a subsequent
  // alloc's row read.
  // ==========================================================================

  pub let endpoint_free : (u64) -> () !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R20b.M1-002 (#1553): id >= 128 -> silent no-op (out of range). Otherwise compute row = &_ipc_endpoint_table + id*48 via id*16 + id*32 (shl 4 + shl 5 + add) — no imul required, matches the multiply-by-24 pattern in cap/verify.pdx L67-71. Then zero all six u64s of the row via `xor rax,rax; mov [r8+off],rax` for off in {0,8,16,24,32,40}. Zeroing [row+0] alone would suffice for the free/live discipline (endpoint_alloc's scan gates on [row+0]==0) but full-row zero prevents stale pointer state from leaking into a subsequent alloc. No handle-generation or ABA guard at R20b — single-flow phase-1 substrate does not admit concurrent alloc/free (design §14 Q3). Leaf function; no callee-save writes.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae endpoint_free_done;

        // Compute row = &_ipc_endpoint_table + id * 48.
        mov r8, rdi;
        shl r8, 4;                          // r8 = id * 16
        mov r9, rdi;
        shl r9, 5;                          // r9 = id * 32
        add r8, r9;                         // r8 = id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        // Zero the 48-byte row (six u64 stores).
        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
        mov [r8 + 32], rax;
        mov [r8 + 40], rax;

      endpoint_free_done:
        ret
      }
    }

  // ==========================================================================
  // endpoint_lookup(id: u64) -> u64
  //
  // SysV ABI: rdi = id -> rax = row PA if live, else 0 (NULL).
  //
  // Returns &_ipc_endpoint_table[id * 48] iff id in [0..127] AND the row's
  // in_use byte (byte 2 of the first u64) is non-zero; else returns
  // ENDPOINT_LOOKUP_NONE (0). Kernel-VA == PA in the R20b low-half
  // .bss identity-map, so the returned address is both VA and PA.
  // ==========================================================================

  pub let endpoint_lookup : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R20b.M1-002 (#1553): id >= 128 -> return 0 (ENDPOINT_LOOKUP_NONE, invalid id sentinel). Otherwise compute row = &_ipc_endpoint_table + id*48 (same shl-4 + shl-5 + add sequence as endpoint_free). Load [row+0] u64; extract in_use byte via `shr 16` + `and 0xFF`. in_use == 0 -> row is free -> return 0. Otherwise return row address (both VA and PA in the R20b low-half identity-map). Pure read; no writes to memory or registers other than caller-save rax/r8/r9/r10. Leaf function.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae endpoint_lookup_none;

        // Compute row = &_ipc_endpoint_table + id * 48.
        mov r8, rdi;
        shl r8, 4;                          // id * 16
        mov r9, rdi;
        shl r9, 5;                          // id * 32
        add r8, r9;                         // id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        // Extract in_use = ([row+0] >> 16) & 0xFF.
        mov rax, [r8];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  endpoint_lookup_none;

        mov rax, r8;                        // return row PA
        ret;

      endpoint_lookup_none:
        xor rax, rax;                       // ENDPOINT_LOOKUP_NONE
        ret
      }
    }

  // ==========================================================================
  // endpoint_is_full(id: u64) -> u64
  //
  // SysV ABI: rdi = id -> rax = 1 if endpoint has a pending message, 0 if
  // empty (or id out of range).
  //
  // Reads the row's pending_hdr slot at +24. Non-zero == a valid encoded
  // header sits there (see file header: ver >= 1 invariant ensures no
  // valid header packs to 0), so the endpoint is "full" per the single-
  // slot semantics. Zero == empty. Out-of-range ids read as empty (an
  // id that could never have received a message trivially has none
  // pending).
  //
  // Pure read; no writes. Leaf function.
  // ==========================================================================

  pub let endpoint_is_full : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R20b.M2-002 (#1556): pending-msg fullness probe. id >= 128 -> return 0 (out-of-range ids can hold no pending message; matches endpoint_lookup's off-range NULL discipline). Otherwise compute row = &_ipc_endpoint_table + id*48 via the same shl-4 + shl-5 + add sequence as endpoint_free / endpoint_lookup. Load u64 at [row+24] (ENDPOINT_OFF_PENDING_HDR); non-zero -> full (return 1), zero -> empty (return 0). The pending_hdr == 0 <-> empty invariant is safe because every valid header per acpi-supervisor-schema §3 has ver in bits 8..15 with ver >= 1 (per frame.pdx doc), so no live header packs to 0 — see file-header 'Discriminator' paragraph. Pure read; no writes; no callee-save writes. Leaf function.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae endpoint_is_full_no;

        // Compute row = &_ipc_endpoint_table + id * 48.
        mov r8, rdi;
        shl r8, 4;                          // id * 16
        mov r9, rdi;
        shl r9, 5;                          // id * 32
        add r8, r9;                         // id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        mov rax, [r8 + 24];                 // ENDPOINT_OFF_PENDING_HDR
        cmp rax, 0;
        je  endpoint_is_full_no;

        mov rax, 1;
        ret;

      endpoint_is_full_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // endpoint_write_pending(id: u64, hdr: u64, payload_ptr: u64,
  //                        payload_len: u64) -> u64
  //
  // SysV ABI: rdi=id, rsi=hdr, rdx=payload_ptr, rcx=payload_len -> rax=rc.
  //
  // Publishes a single in-flight message on endpoint `id`:
  //   1. Reject id >= 128 or row-not-live -> PENDING_WRITE_ERR_BAD_ID (2).
  //   2. Reject payload_len > 4088 -> PENDING_WRITE_ERR_PAYLOAD_LEN (3).
  //   3. Reject pending_hdr already non-zero -> PENDING_WRITE_ERR_EAGAIN (1)
  //      (endpoint busy — single-slot at R20b, per design §4.3 step 3).
  //   4. rep_movsb payload_len bytes from payload_ptr into payload_arena[id]
  //      (4 KiB page at _ipc_payload_arena + id * 4096).
  //   5. Store hdr into row +24 (pending_hdr) as the publish barrier —
  //      makes the endpoint "full" for concurrent readers.
  //   Return PENDING_WRITE_OK (0).
  //
  // Publish order (payload BEFORE hdr) preserves the invariant
  // "pending_hdr != 0 ⇒ payload_arena[id] fully published"; see file
  // header 'Publish barrier' paragraph.
  //
  // payload_len == 0 is legal (header-only message). rep_movsb with rcx=0
  // is architecturally a no-op (SDM Vol 2A REP: pre-decrement rcx == 0
  // fast-exit), so the zero-payload path stores hdr with no memcpy.
  //
  // Cross-module reach: this primitive is the M2 wire-up boundary where
  // the storage-layer independence of M1's endpoint_alloc/free/lookup
  // (deliberately free of payload_arena references) is fused with the
  // arena. Direct `lea [rip + _ipc_payload_arena]` inlines the arena
  // base address; the id*4096 arithmetic replicates payload_buf_pa_for's
  // formula, avoiding a call + register-save/restore across it (proof
  // parity: same alignment invariant, same bounds discipline).
  // ==========================================================================

  pub let endpoint_write_pending : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, hdr: u64, payload_ptr: u64, payload_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R20b.M2-002 (#1556): publish an in-flight message on endpoint id. Register plan: rdi=id, rsi=hdr (saved to r11 across rep_movsb since rsi becomes rep_movsb src), rdx=payload_ptr (moved into rsi for rep_movsb), rcx=payload_len (kept as rep_movsb count). r8=row addr (survives across rep_movsb; rep_movsb touches only rdi/rsi/rcx). r9=temp for id*32 during row-addr math, reused as scratch for the in_use mask. r10=payload_pa (rep_movsb dst; moved into rdi for the copy). r11=saved hdr (survives across rep_movsb -> stored into [row+24] after copy). Gate order: (a) `cmp rdi,128; jae bad_id` — out-of-range. (b) `cmp rcx,4088; ja bad_len` — over-limit (matches Frame.FRAME_MAX_PAYLOAD; ja for unsigned compare). (c) Compute row via shl-4 + shl-5 + add (matches endpoint_free/lookup). (d) Liveness gate: `mov rax,[r8]; shr rax,16; and rax,0xFF; cmp rax,0; je bad_id` — treats not-live as bad_id (an alloc'd endpoint that got freed underfoot is indistinguishable to the caller from an invalid id). (e) Full gate: `mov rax,[r8+24]; cmp rax,0; jne eagain` — pending_hdr slot non-zero means a prior message is still in flight (single-slot at R20b). (f) Compute payload_pa: `mov r10,rdi; shl r10,12; lea r9,[rip+_ipc_payload_arena]; add r10,r9` — same id*4096 arithmetic as payload_buf_pa_for; base is @align(4096) so alignment holds by construction. (g) Save hdr: `mov r11,rsi`. (h) rep_movsb setup: `mov rdi,r10; mov rsi,rdx; cld; rep_movsb` — rcx already holds payload_len; cld ensures forward direction (SysV requires DF=0 at call boundary but re-issuing is a proven safety pattern per libc_test.pdx L137, pdxfs_lite/read.pdx). rcx=0 fast-exits per SDM Vol 2A REP semantics. (i) Publish barrier: `mov [r8+24],r11` stores hdr LAST — payload-then-hdr order preserves 'hdr!=0 ⇒ payload fully published' for R21+ SMP readers. (j) `xor rax,rax; ret` returns PENDING_WRITE_OK. Error paths use single `mov rax,imm; ret`. Leaf function; no callee-save writes; no stack frame. cross-file `[rip + _ipc_payload_arena]` reference proven in kernel_main.pdx's cross-file RIP-relative refs (e.g. [rip + _boot_env_pa] at L146).",
      block: {
        // ---- Gate A: id in range ----
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_wp_bad_id;

        // ---- Gate B: payload_len <= FRAME_MAX_PAYLOAD ----
        cmp rcx, 4088;                      // PENDING_PAYLOAD_MAX_BYTES
        ja  ep_wp_bad_len;

        // ---- Compute row addr in r8 ----
        mov r8, rdi;
        shl r8, 4;                          // id * 16
        mov r9, rdi;
        shl r9, 5;                          // id * 32
        add r8, r9;                         // id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        // ---- Gate C: row must be live (in_use byte at +2 non-zero) ----
        mov rax, [r8];
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 0;
        je  ep_wp_bad_id;

        // ---- Gate D: pending_hdr slot must be empty (== 0) ----
        mov rax, [r8 + 24];                 // ENDPOINT_OFF_PENDING_HDR
        cmp rax, 0;
        jne ep_wp_eagain;

        // ---- Compute payload_pa in r10 ----
        mov r10, rdi;
        shl r10, 12;                        // id * 4096
        lea r9,  [rip + _ipc_payload_arena];
        add r10, r9;                        // r10 = payload_pa

        // ---- Save hdr across rep_movsb (which clobbers rsi) ----
        mov r11, rsi;                       // r11 = hdr

        // ---- rep_movsb: dst=payload_pa, src=payload_ptr, count=payload_len ----
        mov rdi, r10;                       // dst
        mov rsi, rdx;                       // src
        // rcx already = payload_len
        cld;
        rep_movsb;

        // ---- Publish barrier: store hdr LAST into pending_hdr slot ----
        mov [r8 + 24], r11;

        xor rax, rax;                       // PENDING_WRITE_OK
        ret;

      ep_wp_bad_id:
        mov rax, 2;                         // PENDING_WRITE_ERR_BAD_ID
        ret;

      ep_wp_bad_len:
        mov rax, 3;                         // PENDING_WRITE_ERR_PAYLOAD_LEN
        ret;

      ep_wp_eagain:
        mov rax, 1;                         // PENDING_WRITE_ERR_EAGAIN
        ret
      }
    }

  // ==========================================================================
  // endpoint_take_pending(id: u64, dst_hdr_ptr: u64,
  //                       dst_payload_ptr: u64) -> u64
  //
  // SysV ABI: rdi=id, rsi=dst_hdr_ptr, rdx=dst_payload_ptr
  //        -> rax = payload_len (u32 zero-extended, in [0..4088])
  //                 OR PENDING_TAKE_EMPTY (0xFFFFFFFFFFFFFFFF) when the
  //                 endpoint has no pending message.
  //
  // Consumes the single in-flight message on endpoint `id`:
  //   1. id >= 128 -> return PENDING_TAKE_EMPTY.
  //   2. Load pending_hdr from row +24; if 0 -> return PENDING_TAKE_EMPTY.
  //   3. Extract payload_len = hdr >> 32 (bits 32..63 of the packed hdr;
  //      see frame_hdr_payload_len).
  //   4. Store hdr into *dst_hdr_ptr (single 8-byte store).
  //   5. rep_movsb payload_len bytes from payload_arena[id] into
  //      *dst_payload_ptr.
  //   6. Zero pending_hdr slot (release the endpoint for the next msg).
  //   Return payload_len.
  //
  // Take order (read hdr, copy payload out, THEN zero hdr) is the mirror
  // of write's (payload then hdr) publish order — clearing pending_hdr
  // LAST means a concurrent writer (R21+ SMP) never sees "hdr zero,
  // payload half-consumed". At R20b there are no concurrent readers or
  // writers, but the ordering discipline is baked in.
  //
  // Note: payload_len == 0 is a valid return distinct from
  // PENDING_TAKE_EMPTY (-1) — a header-only message consumes correctly
  // and returns 0. Callers use `cmp rax, -1` (or equivalent) to detect
  // the empty case.
  // ==========================================================================

  pub let endpoint_take_pending : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, dst_hdr_ptr: u64, dst_payload_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R20b.M2-002 (#1556): consume an in-flight message from endpoint id. Register plan: rdi=id (consumed for row-addr math, then overwritten as rep_movsb dst), rsi=dst_hdr_ptr (used for the single 8-byte hdr store, then overwritten as rep_movsb src), rdx=dst_payload_ptr (moved into rdi as rep_movsb dst). r8=row addr (survives rep_movsb). r9=temp for id*32, then arena base. r10=payload_pa (rep_movsb src staging). r11=none needed here (payload_len lives in r9 across rep_movsb since r9 is caller-save but rep_movsb touches only rdi/rsi/rcx). Actually r9 is needed as scratch mid-flow; use r10 for payload_len persistence and recompute payload_pa into r11: cleaner: r11=payload_pa (rep_movsb src), r9=payload_len (survives). Gate order: (a) `cmp rdi,128; jae empty` — out-of-range treated as empty (a nonexistent endpoint can hold no msg). (b) Compute row addr via shl-4 + shl-5 + add (matches endpoint_free/lookup/is_full). (c) Load pending_hdr: `mov rax,[r8+24]; cmp rax,0; je empty` — zero hdr means empty per file-header discriminator invariant. (d) Publish hdr to caller: `mov [rsi],rax` — single 8-byte store; rsi is still the original dst_hdr_ptr (not clobbered yet). (e) Extract payload_len: `mov r9,rax; shr r9,32` — matches frame_hdr_payload_len's shift (no mask needed; shr 32 zero-extends per SDM). Save this in r9 for the eventual return and for the rep_movsb count. (f) Compute payload_pa in r11: `mov r11,rdi; shl r11,12; lea rax,[rip+_ipc_payload_arena]; add r11,rax`. (g) rep_movsb setup: `mov rdi,rdx; mov rsi,r11; mov rcx,r9; cld; rep_movsb`. Payload_len=0 is a no-op per SDM. (h) Clear pending_hdr slot (release barrier): `xor rax,rax; mov [r8+24],rax` — hdr cleared AFTER payload fully consumed, so a concurrent writer (R21+) never sees stale state mid-flight. (i) Return payload_len: `mov rax,r9; ret`. Empty path: `mov rax,-1; ret`. Leaf function; no callee-save writes; no stack frame.",
      block: {
        // ---- Bounds ----
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_tp_empty;

        // ---- Compute row addr in r8 ----
        mov r8, rdi;
        shl r8, 4;                          // id * 16
        mov r9, rdi;
        shl r9, 5;                          // id * 32
        add r8, r9;                         // id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        // ---- Load pending_hdr; empty if 0 ----
        mov rax, [r8 + 24];                 // ENDPOINT_OFF_PENDING_HDR
        cmp rax, 0;
        je  ep_tp_empty;

        // ---- Publish hdr to caller (rsi still holds original dst_hdr_ptr) ----
        mov [rsi], rax;

        // ---- Extract payload_len into r9 (survives rep_movsb) ----
        mov r9, rax;
        shr r9, 32;                         // payload_len (u32 zero-extended)

        // ---- Compute payload_pa in r11 ----
        mov r11, rdi;
        shl r11, 12;                        // id * 4096
        lea rax, [rip + _ipc_payload_arena];
        add r11, rax;                       // r11 = payload_pa

        // ---- rep_movsb: dst=dst_payload_ptr, src=payload_pa, count=payload_len ----
        mov rdi, rdx;                       // dst
        mov rsi, r11;                       // src
        mov rcx, r9;                        // count
        cld;
        rep_movsb;

        // ---- Release barrier: zero pending_hdr LAST ----
        xor rax, rax;
        mov [r8 + 24], rax;

        // ---- Return payload_len ----
        mov rax, r9;
        ret;

      ep_tp_empty:
        mov rax, 0xFFFFFFFFFFFFFFFF;        // PENDING_TAKE_EMPTY
        ret
      }
    }

  // ==========================================================================
  // R29.M7-005 (#1048): driver binding + ChannelDead primitives
  //
  //   endpoint_bind_driver(id, driver_slot, incarnation) -> rc
  //   endpoint_binding_word(id)                          -> word | 0
  //   endpoint_is_dead(id)                               -> 1 | 0
  //   endpoint_mark_dead(id)                             -> waiter_tcb | 0
  //   endpoint_attach_ok(id, driver_slot, incarnation)   -> 1 | 0
  //
  // R31.M2-1609 (#1609): endpoint_dead_clear(id) -> rc pairs with
  //   endpoint_mark_dead as the RESURRECTION primitive. #1048 documented
  //   the dead latch as "never cleared" on the reasoning that the only
  //   exit was endpoint_free; #1609 revised that once process-level
  //   respawn (#1600) landed. The latch is now cleared exactly when the
  //   respawn arm rebinds a fresh incarnation onto the same row (see
  //   driver_restart_revive_endpoints), so the sidecar hard-coded-id
  //   contract (e.g. acpi_supervisor.pdx:151's endpoint_id=3) survives a
  //   crash. Stale-capability laundering stays closed by the incarnation
  //   half of endpoint_attach_ok: the revive does NOT rewrite the
  //   incarnation, so a capability minted against the dead one is still
  //   refused there — only the ChannelDead recv gate is unwedged.
  //
  // All six gate on id < ENDPOINT_TABLE_SLOTS AND row liveness, so a
  // binding can never name a row that holds no endpoint.
  // ==========================================================================

  // ==========================================================================
  // endpoint_bind_driver(id, driver_slot, incarnation) -> u64
  //
  // SysV ABI: rdi=id, rsi=driver_slot, rdx=incarnation -> rax = rc.
  //
  //   EP_BIND_OK        (0) — binding word written.
  //   EP_BIND_ERR_BAD_ID(1) — id >= 128 or the row is not live.
  //   EP_BIND_ERR_BAD_ARG(2)— driver_slot >= 32 or incarnation >= 256.
  //   EP_BIND_ERR_DEAD  (3) — the row's dead latch is set. THE refusal
  //                           this issue exists for: a dead endpoint is
  //                           never revived, so a restarted driver
  //                           cannot re-attach the channel its previous
  //                           incarnation served, and a client holding a
  //                           capability to that id cannot be handed the
  //                           new incarnation's authority by accident.
  //
  // Re-binding a LIVE endpoint to a different driver or incarnation is
  // permitted: the supervisor owns the table, and an endpoint that was
  // never killed was never a stale-authority hazard.
  // ==========================================================================

  pub let endpoint_bind_driver : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (id: u64) (driver_slot: u64) (incarnation: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-005 (#1048): stamp the driver binding word at row[+40]. Gate order: (a) id >= ENDPOINT_TABLE_SLOTS (128) -> EP_BIND_ERR_BAD_ID. (b) driver_slot >= 32 (DRIVER_TABLE_SLOTS) or incarnation >= 256 -> EP_BIND_ERR_BAD_ARG; argument validation precedes any state read so a malformed call is never reported as a policy refusal, matching driver_table_set_domain's gate order. (c) row addr via the shl-4 + shl-5 + add multiply-by-48 used by every accessor here; in_use byte at [+0] bits 16..23 zero -> EP_BIND_ERR_BAD_ID (a freed row is indistinguishable from a bad id to the caller). (d) [+40] bit 6 (dead latch) set -> EP_BIND_ERR_DEAD, returning WITHOUT touching the word: a dead endpoint is never revived, which is what forces a restarted driver onto a fresh endpoint id. Commit: single u64 store of (driver_slot & 0x1F) | ENDPOINT_BIND_PRESENT | ((incarnation & 0xFF) << 8), which also zeroes the reserved high bits and leaves the dead bit clear (it was proven clear by gate d). Leaf; no calls; no callee-save writes.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_bind_bad_id;

        cmp rsi, 32;                        // DRIVER_TABLE_SLOTS
        jae ep_bind_bad_arg;

        cmp rdx, 256;
        jae ep_bind_bad_arg;

        mov r8, rdi;
        shl r8, 4;                          // id * 16
        mov r9, rdi;
        shl r9, 5;                          // id * 32
        add r8, r9;                         // id * 48
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;                         // r8 = &row

        // Liveness gate.
        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_bind_bad_id;

        // Dead latch — refuse without mutating.
        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING
        mov r10, rax;
        shr r10, 6;                         // ENDPOINT_BIND_DEAD -> bit 0
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        jne ep_bind_dead;

        // Commit.
        mov rax, rsi;
        mov r10, 0x1F;                      // ENDPOINT_BIND_DRIVER_MASK
        and rax, r10;
        mov r10, 0x20;                      // ENDPOINT_BIND_PRESENT
        or  rax, r10;

        mov r11, rdx;
        mov r10, 0xFF;
        and r11, r10;
        shl r11, 8;                         // ENDPOINT_BIND_INCARN_SHIFT
        or  rax, r11;

        mov [r8 + 40], rax;

        xor rax, rax;                       // EP_BIND_OK
        ret;

      ep_bind_bad_id:
        mov rax, 1;                         // EP_BIND_ERR_BAD_ID
        ret;

      ep_bind_bad_arg:
        mov rax, 2;                         // EP_BIND_ERR_BAD_ARG
        ret;

      ep_bind_dead:
        mov rax, 3;                         // EP_BIND_ERR_DEAD
        ret
      }
    }

  // ==========================================================================
  // endpoint_binding_word(id) -> u64
  //
  // SysV ABI: rdi = id -> rax = the raw [+40] word, or 0 when id >= 128
  // or the row is not live. Zero decodes to "unbound, alive", which is
  // the correct reading for a row that holds no endpoint, so callers
  // need no separate error path — same discipline as
  // driver_table_read_sup.
  // ==========================================================================

  pub let endpoint_binding_word : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-005 (#1048): return the raw driver binding word at row[+40], or 0 when id >= ENDPOINT_TABLE_SLOTS or the row's in_use byte is clear. Zero rather than a sentinel because zero decodes to 'unbound, alive', the correct reading for a row holding no endpoint; the restart scan in restart.pdx then rejects it on the bound-bit test with no extra branch. Row addr via shl-4 + shl-5 + add. Pure read; leaf function.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_bind_word_zero;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_bind_word_zero;

        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING
        ret;

      ep_bind_word_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // endpoint_is_dead(id) -> u64
  //
  // SysV ABI: rdi = id -> rax = 1 iff the row is live AND its dead latch
  // is set; 0 otherwise.
  //
  // An id that is out of range or names a freed row reports 0, NOT 1:
  // "dead" is a statement about a live endpoint whose server went away,
  // and a freed row is a different condition that the -EBADF path in
  // sys_ipc_recv_body already reports. Conflating them would make a
  // client unable to tell "reconnect to the restarted server" from
  // "your handle is garbage".
  // ==========================================================================

  pub let endpoint_is_dead : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-005 (#1048): ChannelDead probe. id >= ENDPOINT_TABLE_SLOTS or row not live -> 0 (a freed row is reported by the -EBADF path, not by this predicate — conflating the two would leave a client unable to distinguish 'reconnect' from 'bad handle'). Otherwise load [+40], shift the dead latch (bit 6) to bit 0 and mask 1. Pure read; leaf function. Called from the top of sys_ipc_recv_body's retry loop and from sys_ipc_send_body's entry gate.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_is_dead_no;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_is_dead_no;

        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING
        shr rax, 6;                         // ENDPOINT_BIND_DEAD -> bit 0
        mov r10, 1;
        and rax, r10;
        ret;

      ep_is_dead_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // endpoint_mark_dead(id) -> u64
  //
  // SysV ABI: rdi = id -> rax = the waiter_tcb that WAS parked on this
  // endpoint (0 if none, or if id is out of range / the row is not live).
  //
  // Latches the dead bit, then detaches and returns the waiter so the
  // caller can wake it. The caller — driver_restart_reap_endpoints — is
  // the only thing that should issue the wake, because it is the only
  // thing that knows the wake is an error delivery rather than a message
  // delivery.
  //
  // ORDERING IS LOAD-BEARING: the dead bit is published BEFORE the
  // waiter slot is read and cleared. A woken waiter re-examines the
  // endpoint on its retry path, and it must never find it alive — that
  // would send it straight back into sched_block with no remaining wake
  // source, which is the exact hang this issue closes. This mirrors the
  // clear-before-wake discipline in sys_ipc_send_body step 4 and
  // uart_rx_notify_wake_if_waiter §3.4.
  //
  // Idempotent: calling it on an already-dead endpoint re-sets a bit
  // that is already set and returns 0 (the waiter was detached by the
  // first call), so a double cascade cannot double-wake.
  // ==========================================================================

  pub let endpoint_mark_dead : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-005 (#1048): latch the dead bit and detach the parked waiter. id >= ENDPOINT_TABLE_SLOTS or row not live -> return 0 (nothing to kill, nothing to wake). Otherwise: (a) load [+40], OR in ENDPOINT_BIND_DEAD (0x40), store it back — the dead bit is published FIRST so a waiter woken by the caller can never re-read the endpoint as alive and re-block with no wake source remaining; (b) load [+32] (ENDPOINT_OFF_WAITER_TCB) into rax as the return value; (c) zero [+32]. Idempotent: a second call re-sets an already-set bit and returns 0 because step (c) already detached the waiter, so a double cascade cannot double-wake. Row addr via shl-4 + shl-5 + add. Leaf; no calls; no callee-save writes.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_mark_dead_none;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_mark_dead_none;

        // (a) publish the dead latch FIRST.
        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING
        mov r10, 0x40;                      // ENDPOINT_BIND_DEAD
        or  rax, r10;
        mov [r8 + 40], rax;

        // (b) take the waiter, (c) detach it.
        mov rax, [r8 + 32];                 // ENDPOINT_OFF_WAITER_TCB
        xor r10, r10;
        mov [r8 + 32], r10;
        ret;

      ep_mark_dead_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // endpoint_dead_clear(id) -> u64                    R31.M2-1609 (#1609)
  //
  // SysV ABI: rdi = id -> rax = EP_DEAD_CLEAR_OK (0) on success,
  // EP_DEAD_CLEAR_BAD_ID (1) if id >= ENDPOINT_TABLE_SLOTS or the row is
  // not live.
  //
  // The inverse of endpoint_mark_dead: clears bit 6 (dead latch) at
  // [row+40] and touches nothing else. Slot, incarnation, present bit,
  // waiter_tcb and every other row field survive the call, so a hard-coded
  // endpoint_id contract (acpi_supervisor.pdx:151 pins endpoint_id=3, and
  // any post-#1600 sidecar spawned into the same slot expects the same id
  // back on respawn) is preserved verbatim.
  //
  // The dead latch was documented as "never cleared" pre-#1609 on the
  // reasoning that endpoint_free was the only exit. #1600 introduced
  // process-level respawn, which meant the row's serving driver came back
  // WITHOUT the endpoint row being freed and re-alloc'd; without a clear
  // path the respawned driver's first sys_ipc_recv would trip
  // sys_ipc_recv_body's ChannelDead gate and return -ECONNRESET on an
  // endpoint whose server is very much alive. This helper is what the
  // respawn arm calls (via driver_restart_revive_endpoints in
  // driver/restart.pdx) to unwedge the recv gate.
  //
  // Deliberately does NOT rewrite the incarnation field. A stale
  // capability minted against the dead incarnation must still be refused
  // by endpoint_attach_ok, whose incarnation clause is the surviving
  // stale-cap defence (design/drivers/cascade-restart.md §6.5). Clearing
  // the dead bit alone unblocks the send/recv path, which is the only
  // question this issue is answering; incarnation rewrite would launder
  // exactly the authority the incarnation clause exists to refuse.
  // ==========================================================================

  pub let EP_DEAD_CLEAR_OK     : u64 = 0
  pub let EP_DEAD_CLEAR_BAD_ID : u64 = 1

  pub let endpoint_dead_clear : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-1609 (#1609): clear the dead latch (bit 6) at row[+40]. id >= ENDPOINT_TABLE_SLOTS or row not live -> EP_DEAD_CLEAR_BAD_ID (a freed row is indistinguishable from a bad id to the caller, and a caller sweeping by driver slot has no need to distinguish them — the driver_restart_revive_endpoints scan skips both via its own liveness/bound-bit gates before it gets here). Otherwise: load [+40], mask off bit 6 with `and rax, ~0x40` (implemented as mov r10,0x40; not r10; and rax,r10 to keep the mask a register operand — paideia-as's `and imm64` path is not used elsewhere in this file), store back. The dead bit is the ONLY field touched: slot bits [4:0], present bit [5], incarnation bits [15:8], waiter_tcb, payload_buf, pending_hdr and every other row field survive verbatim, preserving both the sidecar's hard-coded endpoint_id contract (post-#1600 respawn reuses the same id) and endpoint_attach_ok's stale-capability defence (the incarnation half still refuses a cap minted against the dead incarnation). Row addr via shl-4 + shl-5 + add — same idiom as every other accessor in this module. Leaf; no calls; no callee-save writes.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_dead_clear_bad_id;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;

        // Liveness gate — a freed row and a bad id collapse to the same
        // sentinel here (the caller has no policy that distinguishes them).
        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_dead_clear_bad_id;

        // Clear bit 6 (ENDPOINT_BIND_DEAD) at [+40]. Every other bit of
        // the binding word survives — this is the whole difference between
        // resurrection and rebind.
        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING
        mov r10, 0x40;                      // ENDPOINT_BIND_DEAD
        not r10;
        and rax, r10;
        mov [r8 + 40], rax;

        xor rax, rax;                       // EP_DEAD_CLEAR_OK
        ret;

      ep_dead_clear_bad_id:
        mov rax, 1;                         // EP_DEAD_CLEAR_BAD_ID
        ret
      }
    }

  // ==========================================================================
  // endpoint_attach_ok(id, driver_slot, incarnation) -> u64
  //
  // SysV ABI: rdi=id, rsi=driver_slot, rdx=incarnation -> rax = 1 | 0.
  //
  // The stale-capability predicate. Returns 1 only when EVERY clause
  // holds: the row is live, it is bound, it is not dead, it is bound to
  // THIS driver slot, and it carries THIS incarnation. Fails closed on
  // every other input.
  //
  // The incarnation clause is the one that does the security work. A
  // driver slot is reused across restarts; an incarnation is not. A
  // capability minted while incarnation N served this endpoint must not
  // address incarnation N+1, because the client never re-crossed the
  // boundary that would have justified the new grant — see
  // design/drivers/cascade-restart.md §6.5. The dead clause makes this
  // unreachable in practice today; the incarnation clause makes it
  // unreachable even if some future attach path forgets the dead rule.
  // ==========================================================================

  pub let endpoint_attach_ok : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (id: u64) (driver_slot: u64) (incarnation: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-005 (#1048): stale-capability predicate. Returns 1 iff id < ENDPOINT_TABLE_SLOTS AND the row is live AND [+40] bit 5 (bound) is set AND bit 6 (dead) is clear AND bits [4:0] == driver_slot AND bits [15:8] == incarnation. Every clause fails closed to 0. The incarnation clause is the security-relevant one: a driver slot is reused across restarts but an incarnation is not, so a capability minted against a dead incarnation cannot address the live one. Clauses are evaluated cheapest-first (bounds, liveness, two single-bit tests, two field compares) so the common refusal costs a handful of instructions. Pure read; leaf function.",
      block: {
        cmp rdi, 128;                       // ENDPOINT_TABLE_SLOTS
        jae ep_attach_no;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _ipc_endpoint_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  ep_attach_no;

        mov rax, [r8 + 40];                 // ENDPOINT_OFF_BINDING

        // bound?
        mov r10, rax;
        shr r10, 5;                         // ENDPOINT_BIND_PRESENT
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  ep_attach_no;

        // not dead?
        mov r10, rax;
        shr r10, 6;                         // ENDPOINT_BIND_DEAD
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        jne ep_attach_no;

        // same driver slot?
        mov r10, rax;
        mov r11, 0x1F;                      // ENDPOINT_BIND_DRIVER_MASK
        and r10, r11;
        cmp r10, rsi;
        jne ep_attach_no;

        // same incarnation?
        mov r10, rax;
        shr r10, 8;                         // ENDPOINT_BIND_INCARN_SHIFT
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, rdx;
        jne ep_attach_no;

        mov rax, 1;
        ret;

      ep_attach_no:
        xor rax, rax;
        ret
      }
    }
}
