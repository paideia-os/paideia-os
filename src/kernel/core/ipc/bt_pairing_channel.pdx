// src/kernel/core/ipc/bt_pairing_channel.pdx — R39.M4-003 (#1337)
//
// Schema of the Bluetooth LE Secure Connections pairing RPC channel:
// three verbs (begin_pairing, confirm_passkey, complete) plus the
// user-consent broker stub.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the pairing RPC surface and the small session
// table backing it.  It is NOT the LE SC state machine (that lives in
// drivers/bt/le_sc.pdx) and it is NOT the crypto server -- SEALED LTK
// bytes never cross this channel; consumers receive a sealed_key_slot
// naming a KIND_BT_PAIRING capability.
//
// The three verbs are:
//
//   begin_pairing   {peer_lo, peer_hi}    -> pair_slot
//   confirm_passkey {pair_slot, passkey}  -> ok
//   complete        {pair_slot}           -> sealed_key_slot
//
// A subscriber that unpacks a field the packer never produced silently
// reads a value from the wrong bit range; tools/build.sh confines the
// packer signatures so a fifth parameter cannot smuggle a caller-
// supplied field.
//
// =============================================================================
// §1  USER-CONSENT BROKER (STUB)
// =============================================================================
//
// A pairing request MUST elicit user consent before the LTK is bonded.
// The broker stub `bpc_broker_request` returns 1 unconditionally in
// this scaffold; the compositor replaces this with a real consent
// dialog when the R32 compositor tree lands.  A design that ships the
// stub as the shipping consent path would fail the "no silent trust
// pairing" gate; documenting the stub here is how the replacement
// stays visible.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF2D0..0xFFFFF2DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: le_sc driver
// 0xFFFFF2E0..0x2EF; adjacent free band below: R39.M4-004 candidate
// 0xFFFFF2C0..0x2CF).

module BtPairingChannel = structure {

  // Verb ordinals.  HIGH half of the eight-bit domain to keep dispatch
  // signals grep-able and un-mixed with reply half.
  pub let BPC_VERB_BEGIN_PAIRING   : u64 = 0x90
  pub let BPC_VERB_CONFIRM_PASSKEY : u64 = 0x91
  pub let BPC_VERB_COMPLETE        : u64 = 0x92
  pub let BPC_VERB_MAX             : u64 = 0x92

  // Session-row column ordinals (u64 word index within a row).
  pub let BPC_COL_PAIR_SLOT_ID    : u64 = 0
  pub let BPC_COL_PEER_LO         : u64 = 1
  pub let BPC_COL_PEER_HI         : u64 = 2
  pub let BPC_COL_PASSKEY         : u64 = 3
  pub let BPC_COL_STATE           : u64 = 4
  pub let BPC_COL_SEALED_KEY_SLOT : u64 = 5
  pub let BPC_COL_CONSENT_FLAG    : u64 = 6
  pub let BPC_COL_RESERVED        : u64 = 7

  // Session states.
  pub let BPC_STATE_IDLE            : u64 = 0
  pub let BPC_STATE_AWAITING_PASSKEY: u64 = 1
  pub let BPC_STATE_PASSKEY_OK      : u64 = 2
  pub let BPC_STATE_COMPLETE        : u64 = 3
  pub let BPC_STATE_FAILED          : u64 = 4

  pub let BPC_SESSION_MAX : u64 = 4

  // §2 failure taxonomy 0xFFFFF2D0..0xFFFFF2DF.
  pub let BPC_OK                     : u64 = 0
  pub let BPC_BAD_ARG                : u64 = 0xFFFFF2DF
  pub let BPC_BAD_PEER               : u64 = 0xFFFFF2DE
  pub let BPC_NO_SLOT                : u64 = 0xFFFFF2DD
  pub let BPC_IN_USE                 : u64 = 0xFFFFF2DC
  pub let BPC_NOT_ACTIVE             : u64 = 0xFFFFF2DB
  pub let BPC_BAD_STATE              : u64 = 0xFFFFF2DA
  pub let BPC_CONSENT_DENIED         : u64 = 0xFFFFF2D9
  pub let BPC_CONSENT_TIMEOUT        : u64 = 0xFFFFF2D8
  pub let BPC_PASSKEY_INVALID        : u64 = 0xFFFFF2D7
  pub let BPC_ENOSPC                 : u64 = 0xFFFFF2D6
  pub let BPC_ALREADY_COMPLETE       : u64 = 0xFFFFF2D5
  pub let BPC_BAD_PAIR_SLOT          : u64 = 0xFFFFF2D4
  pub let BPC_NO_KEY_SLOT            : u64 = 0xFFFFF2D3
  pub let BPC_CONSENT_PENDING        : u64 = 0xFFFFF2D2
  pub let BPC_BROKER_UNAVAILABLE     : u64 = 0xFFFFF2D1
  pub let BPC_OP_UNSUPPORTED         : u64 = 0xFFFFF2D0

  pub let BPC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Passkey range per BT §3.5.6.4: 6 decimal digits, 0..999999.
  pub let BPC_PASSKEY_MAX : u64 = 999999

  // 4 rows x 8 u64 words = 32 u64s.
  pub let mut _bpc_sessions : [u64; 32] = uninit @align(64)
  pub let mut _bpc_stats    : [u64; 4]  = uninit @align(64)

  // ==========================================================================
  // Verb validator.
  // ==========================================================================

  pub let bpc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-003 (#1337): 1 iff v is one of the three known verbs (0x90..0x92). Labels prefixed bpc_vv_.",
      block: {
        cmp rdi, 0x90;
        jb  bpc_vv_no;
        cmp rdi, 0x92;
        ja  bpc_vv_no;
        mov rax, 1;
        ret;
      bpc_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bpc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): clear session table + counters. Labels prefixed bpc_rs_.",
      block: {
        lea r10, [rip + _bpc_sessions];
        xor rax, rax;
        xor rcx, rcx;
      bpc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  bpc_rs_rows;

        lea r10, [rip + _bpc_stats];
        xor rcx, rcx;
      bpc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  bpc_rs_stats;
        ret
      }
    }

  // Row pointer or 0.
  pub let bpc_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): row pointer or 0. Labels prefixed bpc_ra_.",
      block: {
        cmp rdi, 4;
        jae bpc_ra_no;
        lea r10, [rip + _bpc_sessions];
        mov r11, rdi;
        shl r11, 6;                       // 8 u64 * 8 = 64
        add r10, r11;
        mov rax, r10;
        ret;
      bpc_ra_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // User-consent broker STUB.  Compositor replaces this.
  // ==========================================================================

  pub let bpc_broker_request : (u64) -> u64 !{} @{} =
    fn (pair_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-003 (#1337): STUB CONSENT BROKER -- returns 1 (accept) unconditionally.  The compositor replaces this with a real consent dialog when the R32 compositor tree lands.  A design that ships the stub as the shipping consent path would fail the 'no silent trust pairing' gate; the stub is deliberately conspicuous so replacement stays visible.  Labels prefixed bpc_br_.",
      block: {
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // begin_pairing(peer_lo, peer_hi) -> pair_slot | failure code
  // ==========================================================================

  pub let bpc_begin_pairing : (u64, u64) -> u64 !{mem} @{} =
    fn (peer_lo: u64) (peer_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): allocate a session row, stash peer, request consent, advance to AWAITING_PASSKEY.  Refuse (0,0) as BAD_PEER (BT reserves all-zero BD_ADDR).  Refuse if broker denies (CONSENT_DENIED).  Returns pair_slot ordinal (0..3) on success.  Labels prefixed bpc_bp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // (0,0) is not a valid BD_ADDR.
        mov rax, r12;
        or  rax, r13;
        cmp rax, 0;
        je  bpc_bp_bad_peer;

        // Allocate a session row (pair_slot_id == 0).
        xor rbx, rbx;
      bpc_bp_scan:
        cmp rbx, 4;
        jae bpc_bp_enospc;
        lea r10, [rip + _bpc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // pair_slot_id
        cmp rax, 0;
        je  bpc_bp_claim;
        add rbx, 1;
        jmp bpc_bp_scan;

      bpc_bp_claim:
        // Ask the consent broker.
        mov rdi, rbx;
        call bpc_broker_request;
        cmp rax, 1;
        jne bpc_bp_denied;

        // Re-materialise row pointer (rax clobbered).
        lea r10, [rip + _bpc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        // Stash.  pair_slot_id = rbx + 1 (so 0 stays "empty" sentinel).
        mov rax, rbx;
        add rax, 1;
        mov [r10 + 0],  rax;             // pair_slot_id
        mov [r10 + 8],  r12;             // peer_lo
        mov [r10 + 16], r13;             // peer_hi
        xor rax, rax;
        mov [r10 + 24], rax;             // passkey (unset)
        mov rax, 1;
        mov [r10 + 32], rax;             // state = AWAITING_PASSKEY
        xor rax, rax;
        mov [r10 + 40], rax;             // sealed_key_slot (unset)
        mov rax, 1;
        mov [r10 + 48], rax;             // consent_flag
        xor rax, rax;
        mov [r10 + 56], rax;             // reserved

        // Return pair_slot (row ordinal).
        mov rax, rbx;
        jmp bpc_bp_out;

      bpc_bp_denied:
        mov rax, 0xFFFFF2D9;             // CONSENT_DENIED
        jmp bpc_bp_out;
      bpc_bp_bad_peer:
        mov rax, 0xFFFFF2DE;
        jmp bpc_bp_out;
      bpc_bp_enospc:
        mov rax, 0xFFFFF2D6;

      bpc_bp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // confirm_passkey(pair_slot, passkey) -> OK | failure
  // ==========================================================================

  pub let bpc_confirm_passkey : (u64, u64) -> u64 !{mem} @{} =
    fn (pair_slot: u64) (passkey: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): validate passkey range (0..999999 per BT §3.5.6.4), require state == AWAITING_PASSKEY, advance to PASSKEY_OK.  Refuse out-of-range passkey (PASSKEY_INVALID).  Labels prefixed bpc_cp_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 4;
        jae bpc_cp_bad_slot;

        mov r10, 999999;
        cmp r13, r10;
        ja  bpc_cp_bad_pass;

        lea r10, [rip + _bpc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // pair_slot_id
        cmp rax, 0;
        je  bpc_cp_not_active;

        mov rax, [r10 + 32];             // state
        cmp rax, 1;                      // AWAITING_PASSKEY
        jne bpc_cp_bad_state;

        mov [r10 + 24], r13;             // passkey
        mov rax, 2;
        mov [r10 + 32], rax;             // state -> PASSKEY_OK

        xor rax, rax;
        jmp bpc_cp_out;

      bpc_cp_bad_slot:
        mov rax, 0xFFFFF2D4;
        jmp bpc_cp_out;
      bpc_cp_bad_pass:
        mov rax, 0xFFFFF2D7;
        jmp bpc_cp_out;
      bpc_cp_not_active:
        mov rax, 0xFFFFF2DB;
        jmp bpc_cp_out;
      bpc_cp_bad_state:
        mov rax, 0xFFFFF2DA;

      bpc_cp_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // complete(pair_slot) -> sealed_key_slot | failure
  //
  // Emits a synthetic sealed_key_slot (a synthetic KIND_BT_PAIRING
  // ordinal); a real implementation mints an actual KIND_BT_PAIRING
  // capability here.
  // ==========================================================================

  pub let bpc_complete : (u64) -> u64 !{mem} @{} =
    fn (pair_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): require state == PASSKEY_OK, mint sealed_key_slot (SYNTHETIC in this scaffold), advance to COMPLETE.  Refuse repeated complete (ALREADY_COMPLETE) or wrong state (BAD_STATE).  Labels prefixed bpc_c_.",
      block: {
        push r12;

        mov r12, rdi;
        cmp r12, 4;
        jae bpc_c_bad_slot;

        lea r10, [rip + _bpc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // pair_slot_id
        cmp rax, 0;
        je  bpc_c_not_active;

        mov rax, [r10 + 32];             // state
        cmp rax, 3;                      // already COMPLETE
        je  bpc_c_already;
        cmp rax, 2;                      // must be PASSKEY_OK
        jne bpc_c_bad_state;

        // Synth sealed_key_slot = 0x8000_0000 | pair_slot_id.
        mov rax, [r10 + 0];
        or  rax, 0x80000000;
        mov [r10 + 40], rax;             // sealed_key_slot

        mov r11, 3;
        mov [r10 + 32], r11;             // state -> COMPLETE
        // rax already holds sealed_key_slot -- return it.
        jmp bpc_c_out;

      bpc_c_bad_slot:
        mov rax, 0xFFFFF2D4;
        jmp bpc_c_out;
      bpc_c_not_active:
        mov rax, 0xFFFFF2DB;
        jmp bpc_c_out;
      bpc_c_bad_state:
        mov rax, 0xFFFFF2DA;
        jmp bpc_c_out;
      bpc_c_already:
        mov rax, 0xFFFFF2D5;

      bpc_c_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Query helpers.
  // ==========================================================================

  pub let bpc_state_of : (u64) -> u64 !{mem} @{} =
    fn (pair_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): pair_slot -> state ordinal or BAD_ARG. Labels prefixed bpc_so_.",
      block: {
        cmp rdi, 4;
        jae bpc_so_bad;
        lea r10, [rip + _bpc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bpc_so_notact;
        mov rax, [r10 + 32];
        ret;
      bpc_so_notact:
        mov rax, 0xFFFFF2DB;
        ret;
      bpc_so_bad:
        mov rax, 0xFFFFF2DF;
        ret
      }
    }

  pub let bpc_consent_of : (u64) -> u64 !{mem} @{} =
    fn (pair_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-003 (#1337): pair_slot -> consent_flag (0/1) or BAD_ARG. Labels prefixed bpc_co_.",
      block: {
        cmp rdi, 4;
        jae bpc_co_bad;
        lea r10, [rip + _bpc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bpc_co_notact;
        mov rax, [r10 + 48];
        ret;
      bpc_co_notact:
        mov rax, 0xFFFFF2DB;
        ret;
      bpc_co_bad:
        mov rax, 0xFFFFF2DF;
        ret
      }
    }
}
