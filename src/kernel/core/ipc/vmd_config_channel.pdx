// src/kernel/core/ipc/vmd_config_channel.pdx — R47.M2-001 (#1415)
//
// Schema of the VMD virtual root-complex config-space channel.  A
// ring-3 supervisor holding a KIND_VMD_ENDPOINT can open a session
// against the endpoint's owning VMD controller and issue CONFIG_READ
// / CONFIG_WRITE requests through this channel.  The controller-side
// consumer decodes the (vbdf, cfg_off) pair against the aperture
// vmd_root_complex.pdx computes and issues the actual MMIO through a
// KIND_OP_REGION it holds separately.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCHEMA + FSM of the config-channel RPC surface, and the
// small session table backing it.  It is NOT the virtual root-complex
// (that lives in drivers/vmd/root_complex.pdx) and NOT the endpoint
// capability (kind_vmd_endpoint.pdx).  Consumers hold an endpoint
// cap and drive this schema against a channel to that endpoint's
// VMD controller.
//
// =============================================================================
// §1  SESSION TABLE
// =============================================================================
//
// _vcc_sessions holds four rows of four u64s (endpoint_slot,
// last_verb, state, seq).
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFFD78..0xFFFFFD7F (SHARED BAND with
//    vmd_hotplug 0xFFFFFD72..0xFFFFFD77).
// =============================================================================

module VmdConfigChannel = structure {

  // §0 verbs -- HIGH half of the eight-bit domain to keep dispatch
  // signals grep-able.
  pub let VCC_VERB_OPEN         : u64 = 0xB0
  pub let VCC_VERB_CONFIG_READ  : u64 = 0xB1
  pub let VCC_VERB_CONFIG_WRITE : u64 = 0xB2
  pub let VCC_VERB_CLOSE        : u64 = 0xB3
  pub let VCC_VERB_MAX          : u64 = 0xB3

  // Session states.
  pub let VCC_STATE_INIT   : u64 = 0
  pub let VCC_STATE_OPEN   : u64 = 1
  pub let VCC_STATE_CLOSED : u64 = 2
  pub let VCC_STATE_MAX    : u64 = 2

  pub let VCC_SESSION_MAX : u64 = 4

  // Column ordinals.
  pub let VCC_COL_ENDPOINT_SLOT : u64 = 0
  pub let VCC_COL_LAST_VERB     : u64 = 1
  pub let VCC_COL_STATE         : u64 = 2
  pub let VCC_COL_SEQ           : u64 = 3

  pub let VCC_OK              : u64 = 0
  pub let VCC_BAD_ARG         : u64 = 0xFFFFFD7F
  pub let VCC_BAD_VERB        : u64 = 0xFFFFFD7E
  pub let VCC_NO_SLOT         : u64 = 0xFFFFFD7D
  pub let VCC_ALREADY_OPEN    : u64 = 0xFFFFFD7C
  pub let VCC_NOT_OPEN        : u64 = 0xFFFFFD7B
  pub let VCC_BAD_ENDPOINT    : u64 = 0xFFFFFD7A
  pub let VCC_BAD_STATE       : u64 = 0xFFFFFD79
  pub let VCC_ENOSPC          : u64 = 0xFFFFFD78

  // 4 rows x 4 u64 = 16.
  pub let mut _vcc_sessions : [u64; 16] = uninit @align(64)
  pub let mut _vcc_stats    : [u64; 4]  = uninit @align(64)

  pub let VCC_ST_OPENS  : u64 = 0
  pub let VCC_ST_READS  : u64 = 1
  pub let VCC_ST_WRITES : u64 = 2
  pub let VCC_ST_CLOSES : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_config_channel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): clear sessions + stats. Labels prefixed vcc_rs_.",
      block: {
        lea r10, [rip + _vcc_sessions];
        xor rax, rax;
        xor rcx, rcx;
      vcc_rs_ses:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  vcc_rs_ses;

        lea r10, [rip + _vcc_stats];
        xor rcx, rcx;
      vcc_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vcc_rs_st;
        ret
      }
    }

  // ==========================================================================
  // Verb validator.
  // ==========================================================================

  pub let vcc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M2-001 (#1415): 1 iff v in {OPEN, READ, WRITE, CLOSE}. Labels prefixed vcc_vv_.",
      block: {
        cmp rdi, 0xB0;
        jb  vcc_vv_no;
        cmp rdi, 0xB3;
        ja  vcc_vv_no;
        mov rax, 1;
        ret;
      vcc_vv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_config_channel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): counter read.",
      block: {
        cmp rdi, 4;
        jae vcc_st_zero;
        lea r10, [rip + _vcc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vcc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_config_channel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): counter bump. Labels prefixed vcc_nt_.",
      block: {
        cmp rdi, 4;
        jae vcc_nt_out;
        lea r10, [rip + _vcc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vcc_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Session helpers.
  // ==========================================================================

  // vcc_open(endpoint_slot) -> session_id / err
  pub let vcc_open : (u64) -> u64 !{mem} @{} =
    fn (endpoint_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): open a session on endpoint_slot. Refuses duplicate (ALREADY_OPEN) and table full (ENOSPC). Labels prefixed vcc_op_.",
      block: {
        push rbx;
        mov rbx, rdi;

        // Duplicate scan.
        xor rcx, rcx;
      vcc_op_dup_scan:
        cmp rcx, 4;
        jae vcc_op_alloc;
        lea r10, [rip + _vcc_sessions];
        mov r11, rcx;
        shl r11, 5;                      // 4 u64 = 32 bytes/row
        add r10, r11;
        mov rax, [r10 + 16];             // state
        cmp rax, 1;                      // OPEN
        jne vcc_op_dup_next;
        mov rax, [r10 + 0];              // endpoint_slot
        cmp rax, rbx;
        je  vcc_op_dup;
      vcc_op_dup_next:
        add rcx, 1;
        jmp vcc_op_dup_scan;

      vcc_op_alloc:
        xor rcx, rcx;
      vcc_op_alloc_scan:
        cmp rcx, 4;
        jae vcc_op_full;
        lea r10, [rip + _vcc_sessions];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        cmp rax, 1;                      // OPEN => taken
        jne vcc_op_claim;
        add rcx, 1;
        jmp vcc_op_alloc_scan;

      vcc_op_claim:
        mov [r10 + 0], rbx;              // endpoint_slot
        xor rax, rax;
        mov [r10 + 8], rax;              // last_verb
        mov rax, 1;
        mov [r10 + 16], rax;             // state = OPEN
        xor rax, rax;
        mov [r10 + 24], rax;             // seq

        push rcx;
        mov rdi, 0;
        call vmd_config_channel_note;
        pop rax;
        jmp vcc_op_out;

      vcc_op_dup:
        mov rax, 0xFFFFFD7C;
        jmp vcc_op_out;
      vcc_op_full:
        mov rax, 0xFFFFFD78;

      vcc_op_out:
        pop rbx;
        ret
      }
    }

  // vcc_step(session_id, verb) -> 0 / err
  pub let vcc_step : (u64, u64) -> u64 !{mem} @{} =
    fn (session_id: u64) (verb: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): advance a session. OPEN->READ/WRITE (increments seq), OPEN->CLOSE. Labels prefixed vcc_sp_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 4;
        jae vcc_sp_bad_arg;

        mov rdi, r12;
        call vcc_verb_valid;
        cmp rax, 0;
        je  vcc_sp_bad_verb;

        lea r10, [rip + _vcc_sessions];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 16];             // state
        cmp rax, 1;
        jne vcc_sp_not_open;

        cmp r12, 0xB3;                   // CLOSE
        je  vcc_sp_close;
        cmp r12, 0xB1;                   // READ
        je  vcc_sp_read;
        cmp r12, 0xB2;                   // WRITE
        je  vcc_sp_write;
        // OPEN sent on an already-OPEN session is ALREADY_OPEN.
        mov rax, 0xFFFFFD7C;
        pop r12;
        pop rbx;
        ret;

      vcc_sp_read:
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov [r10 + 8], r12;
        mov rdi, 1;
        call vmd_config_channel_note;
        xor rax, rax;
        jmp vcc_sp_out;
      vcc_sp_write:
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov [r10 + 8], r12;
        mov rdi, 2;
        call vmd_config_channel_note;
        xor rax, rax;
        jmp vcc_sp_out;
      vcc_sp_close:
        mov rax, 2;
        mov [r10 + 16], rax;             // state = CLOSED
        mov [r10 + 8], r12;
        mov rdi, 3;
        call vmd_config_channel_note;
        xor rax, rax;
        jmp vcc_sp_out;

      vcc_sp_bad_arg:
        mov rax, 0xFFFFFD7F;
        jmp vcc_sp_out;
      vcc_sp_bad_verb:
        mov rax, 0xFFFFFD7E;
        jmp vcc_sp_out;
      vcc_sp_not_open:
        mov rax, 0xFFFFFD7B;

      vcc_sp_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vcc_row_state : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): read state field.",
      block: {
        cmp rdi, 4;
        jae vcc_rs2_bad;
        lea r10, [rip + _vcc_sessions];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        ret;
      vcc_rs2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vcc_row_seq : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): read seq field.",
      block: {
        cmp rdi, 4;
        jae vcc_rq_bad;
        lea r10, [rip + _vcc_sessions];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        ret;
      vcc_rq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
