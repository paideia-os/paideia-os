// src/kernel/core/ipc/elevate_channel.pdx — R48.M7-001 (#1549)
//
// Elevate protocol — per-op request / approve / expire.  Replaces
// setuid/sudo with a cap-delegation flow per model.md §5.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA + packers for the elevate wire protocol between a
// requester (any user process running `elevate`) and the approver
// (founder's session in interactive mode; the `elevate` policy daemon
// in unattended mode).  Same posture as user_lifecycle_channel.
//
// There is NO shell-as-root — the request grants a NARROW,
// TIME-BOUNDED delegation of specific caps for a specific operation,
// which is the load-bearing distinction from sudo (§5.3 of model.md).
//
// =============================================================================
// §1  WIRE FRAMES
// =============================================================================
//
// The channel carries three frame kinds:
//
//   REQ   requester -> approver
//     op = 0x01
//     body word 0: caps_bitmask (§2 encoding)
//     body word 1: duration_ns
//     body word 2: reserved  (0)
//
//   APR   approver -> requester
//     op = 0x02
//     body word 0: caps_granted_bitmask (must be subset of REQ.caps)
//     body word 1: expire_ns            (absolute)
//     body word 2: reserved  (0)
//
//   EXP   internal broadcast on expiry (kernel timer)
//     op = 0x03
//     body word 0: request_id
//     body word 1: reason (0=timeout, 1=explicit_revoke)
//     body word 2: reserved  (0)
//
// =============================================================================
// §2  CAP BITMASK LAYOUT
// =============================================================================
//
// Sixteen bits, each naming a base-cap request class:
//
//   bit 0  PDXFS_WRITE_PKGS    /pkgs write
//   bit 1  NETWORK_FETCH_PKGS  outbound to pkgs.paideia-os
//   bit 2  SIG_VERIFY_ROOT     verify against paideia_root_pk
//   bit 3  PDXFS_WRITE_SYSTEM  /system write (dangerous — approver-side
//                              policy should refuse by default)
//   bit 4  USER_CREATE         run user_supervisor's CREATE verb
//   bit 5  USER_REVOKE         run user_supervisor's REVOKE verb
//   bit 6  HW_MINT             mint any downstream KIND_HW cap
//   bit 7  DRIVER_MINT         mint any downstream KIND_DRIVER cap
//   bits 8..15  reserved       MUST be zero
//
// A REQ that sets a reserved bit is refused by the packer.
//
// =============================================================================
// §3  ERROR BAND 0xFFFFE5E0..0xFFFFE5EF
// =============================================================================

module ElevateChannel = structure {

  pub let ELV_OP_REQ    : u64 = 0x01
  pub let ELV_OP_APR    : u64 = 0x02
  pub let ELV_OP_EXP    : u64 = 0x03
  pub let ELV_OP_MAX    : u64 = 0x03

  pub let ELV_CAP_MASK_VALID : u64 = 0x00FF   // bits 0..7

  pub let ELV_DUR_MIN_NS : u64 = 1000000000            // 1 sec
  pub let ELV_DUR_MAX_NS : u64 = 3600000000000         // 1 hour

  pub let ELV_OK             : u64 = 0
  pub let ELV_ERR_BAD_OP     : u64 = 0xFFFFE5EF
  pub let ELV_ERR_BAD_MASK   : u64 = 0xFFFFE5EE
  pub let ELV_ERR_BAD_DUR    : u64 = 0xFFFFE5ED
  pub let ELV_ERR_BAD_RSV    : u64 = 0xFFFFE5EC
  pub let ELV_ERR_BAD_GRANT  : u64 = 0xFFFFE5EB

  // ==========================================================================
  // elv_op_valid(op) -> 1 | 0
  // ==========================================================================

  pub let elv_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M7-001 (#1549): 1 iff op in [1, 3]. Labels prefixed elv_ov_.",
      block: {
        cmp rdi, 1;
        jb  elv_ov_no;
        mov r10, 3;
        cmp rdi, r10;
        ja  elv_ov_no;
        mov rax, 1;
        ret;
      elv_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elv_mask_valid(mask) -> 1 | 0
  //
  // 1 iff no reserved bits (8..63) are set AND mask != 0 (an empty
  // request is not honored — nothing to grant).
  // ==========================================================================

  pub let elv_mask_valid : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M7-001 (#1549): 1 iff mask != 0 AND mask & ~ELV_CAP_MASK_VALID == 0. Uses `mov r10, 0xFF00...00; and mask, r10` to detect reserved bits without NOT. Labels prefixed elv_mv_.",
      block: {
        cmp rdi, 0;
        je  elv_mv_no;
        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, rdi;                    // requires rdi to have no bits above 8
        jne elv_mv_no;
        mov rax, 1;
        ret;
      elv_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elv_dur_valid(dur) -> 1 | 0
  //
  // Duration must fit in [ELV_DUR_MIN_NS, ELV_DUR_MAX_NS].  Neither
  // endpoint fits imm32; stage in r10/r11.
  // ==========================================================================

  pub let elv_dur_valid : (u64) -> u64 !{} @{} =
    fn (dur: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M7-001 (#1549): 1 iff dur in [ELV_DUR_MIN_NS, ELV_DUR_MAX_NS]. Both endpoints are in the 0xFFFFxxxx band, so staged in r10/r11 per the paideia-as compliance discipline. Labels prefixed elv_dv_.",
      block: {
        mov r10, 1000000000;             // ELV_DUR_MIN_NS
        cmp rdi, r10;
        jb  elv_dv_no;
        mov r11, 3600000000000;          // ELV_DUR_MAX_NS
        cmp rdi, r11;
        ja  elv_dv_no;
        mov rax, 1;
        ret;
      elv_dv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elv_pack_req(caps, dur) -> op_word | ELV_ERR_*
  //
  // Op-word encoding:
  //   [7:0]  op = ELV_OP_REQ
  //   [23:8] caps_bitmask (16 bits)
  //   [63:24] reserved 0
  //
  // Body words are the caller's — this packer only produces the op word.
  // ==========================================================================

  pub let elv_pack_req : (u64, u64) -> u64 !{} @{} =
    fn (caps: u64) (dur: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M7-001 (#1549): pack REQ op word. Gates: (1) elv_mask_valid -> BAD_MASK. (2) elv_dur_valid -> BAD_DUR. Two pushes leave rsp%16==0. Labels prefixed elv_pr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call elv_mask_valid;
        cmp rax, 0;
        je  elv_pr_bad_mask;

        mov rdi, r13;
        call elv_dur_valid;
        cmp rax, 0;
        je  elv_pr_bad_dur;

        mov rax, 1;                      // ELV_OP_REQ
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        pop r13;
        pop r12;
        ret;

      elv_pr_bad_mask:
        mov rax, 0xFFFFE5EE;
        pop r13;
        pop r12;
        ret;
      elv_pr_bad_dur:
        mov rax, 0xFFFFE5ED;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elv_check_grant(requested, granted) -> 1 iff granted ⊆ requested
  //
  // The approver's subset invariant.  A granted mask that contains a
  // bit the requester never asked for is a grant of unrequested
  // authority — refused rather than shipped.
  // ==========================================================================

  pub let elv_check_grant : (u64, u64) -> u64 !{} @{} =
    fn (requested: u64) (granted: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M7-001 (#1549): (granted & requested) == granted. Labels prefixed elv_cg_.",
      block: {
        mov rax, rsi;
        and rax, rdi;
        cmp rax, rsi;
        jne elv_cg_no;
        mov rax, 1;
        ret;
      elv_cg_no:
        xor rax, rax;
        ret
      }
    }
}
