// src/kernel/core/ipc/vrr_channel.pdx -- G1.M2-003 (#1434)
//
// Session-type schema for the VRR channel. Carries three RPCs:
//
//     get_range(vrr_slot)              -> (min_mhz, max_mhz) | err
//     enable(vrr_slot, ddi)            -> ok | err
//     disable(vrr_slot, ddi)           -> ok | err
//
// The VRR range is named by KIND_VRR_RANGE cap slot; the DDI is
// the plane identifier (u8, 0..15). Same posture as
// display_sync_channel.pdx / modeset_channel.pdx.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the VRR-control conversation: event
// ordinals, argument-shape validators, small pack/unpack
// primitives, and the seams that call the driver.
//
// It is NOT an endpoint (no queue), NOT the driver (no bit
// mutated here -- disarm/arm delegate to dpy_vrr_arm / dpy_vrr_
// disarm), and NOT the range prober (that lives in drivers/dpy/
// vrr.pdx).
//
// =============================================================================
// SECTION 1  EVENT ORDINALS
// =============================================================================
//
//   VRC_EV_GET_RANGE   0xB0  {vrr_slot}
//   VRC_EV_ENABLE      0xB1  {vrr_slot, ddi}
//   VRC_EV_DISABLE     0xB2  {vrr_slot, ddi}
//
// Ordinals live in the 0xB0 band -- distinct from display_sync
// (0xA0) and modeset (0x90) so a dispatcher switching on ordinal
// cannot cross wires.
//
// =============================================================================
// SECTION 2  PER-OUTPUT BINDING
// =============================================================================
//
// A VRR channel is bound to ONE output at a time. The binding is
// implicit in the (vrr_slot, ddi) pair: multiple channels sharing
// a VRR cap is legal (the compositor may hand a VRR cap to a
// diagnostic tool alongside the compositor's own channel), but the
// arming bit lives per-DDI in the driver and multiple channels
// arming the same DDI is refused ALREADY_ARMED by dpy_vrr_arm.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFF650..0xFFFFF65F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band. Adjacent free band above: driver vrr
// 0xFFFFF660..6F.

module VrrChannel = structure {

  pub let VRC_EV_GET_RANGE  : u64 = 0xB0
  pub let VRC_EV_ENABLE     : u64 = 0xB1
  pub let VRC_EV_DISABLE    : u64 = 0xB2
  pub let VRC_EV_MAX        : u64 = 0xB2

  pub let VRC_OK             : u64 = 0
  pub let VRC_BAD_EV         : u64 = 0xFFFFF65F
  pub let VRC_BAD_SLOT       : u64 = 0xFFFFF65E
  pub let VRC_BAD_DDI        : u64 = 0xFFFFF65D
  pub let VRC_BAD_RESERVED   : u64 = 0xFFFFF65C
  pub let VRC_NO_RANGE       : u64 = 0xFFFFF65B
  pub let VRC_APPLY_FAILED   : u64 = 0xFFFFF65A

  pub let VRC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _vrc_stats : [u64; 4] = uninit @align(64)

  pub let VRC_ST_GETS    : u64 = 0
  pub let VRC_ST_ENABLES : u64 = 1
  pub let VRC_ST_DISABLE : u64 = 2
  pub let VRC_ST_REFUSED : u64 = 3

  pub let vrc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-003 (#1434): clear schema counters. Labels prefixed vrcs_rs_.",
      block: {
        lea r10, [rip + _vrc_stats];
        xor rax, rax;
        xor rcx, rcx;
      vrcs_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vrcs_rs_loop;
        ret
      }
    }

  pub let vrc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-003 (#1434): counter bump. Labels prefixed vrcn_.",
      block: {
        cmp rdi, 4;
        jae vrcn_out;
        lea r10, [rip + _vrc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vrcn_out:
        ret
      }
    }

  pub let vrc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-003 (#1434): counter read.",
      block: {
        cmp rdi, 4;
        jae vrcs_zero;
        lea r10, [rip + _vrc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vrcs_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vrc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-003 (#1434): 1 iff ev in {0xB0, 0xB1, 0xB2}. Labels prefixed vrcev_.",
      block: {
        mov r10, 0xB0;
        cmp rdi, r10;
        jb  vrcev_no;
        mov r10, 0xB2;
        cmp rdi, r10;
        ja  vrcev_no;
        mov rax, 1;
        ret;
      vrcev_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-003 (#1434): 1 iff s < 256. Labels prefixed vrcsl_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vrcsl_no;
        mov rax, 1;
        ret;
      vrcsl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // vrc_apply_get(vrr_slot) -> packed(min_mhz | (max_mhz << 32)) | err
  //
  // Resolves the cap to a live KIND_VRR_RANGE and returns the
  // range packed into one u64 (min_mhz in low 32 bits, max_mhz in
  // high 32 bits). The packing is a wire economy: a single u64
  // return sidesteps the two-value return problem for the RPC
  // schema.
  // ==========================================================================
  pub let vrc_apply_get : (u64) -> u64 !{mem} @{cap} =
    fn (vrr_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-003 (#1434): resolve VRR cap to row_id, read (min, max) mHz, pack low32 | high32. Labels prefixed vrcag_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov rdi, r12;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrcag_bad_slot;

        mov rdi, r12;
        call vrr_row_of_slot;
        cmp rax, 0xFF;
        je  vrcag_no_range;
        mov rbx, rax;                    // row_id

        mov rdi, 0;                      // VRC_ST_GETS
        call vrc_note;

        mov rdi, rbx;
        call vrr_row_min_mhz;
        mov r13, rax;                    // min

        mov rdi, rbx;
        call vrr_row_max_mhz;
        shl rax, 32;
        or  rax, r13;
        jmp vrcag_out;

      vrcag_bad_slot:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65E;
        jmp vrcag_out;
      vrcag_no_range:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65B;

      vrcag_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // vrc_apply_enable(vrr_slot, ddi) -> OK | err
  //
  // Enable adaptive-sync on one DDI. Delegates to dpy_vrr_arm.
  // ==========================================================================
  pub let vrc_apply_enable : (u64, u64) -> u64 !{mem} @{cap} =
    fn (vrr_slot: u64) (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-003 (#1434): validate slot names a live KIND_VRR_RANGE; delegate to dpy_vrr_arm(ddi). Labels prefixed vrcae_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrcae_bad_slot;

        mov rdi, r12;
        call vrr_row_of_slot;
        cmp rax, 0xFF;
        je  vrcae_no_range;

        mov rdi, 1;                      // VRC_ST_ENABLES
        call vrc_note;

        mov rdi, r13;
        call dpy_vrr_arm;
        cmp rax, 0;
        jne vrcae_failed;

        xor rax, rax;
        jmp vrcae_out;

      vrcae_bad_slot:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65E;
        jmp vrcae_out;
      vrcae_no_range:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65B;
        jmp vrcae_out;
      vrcae_failed:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65A;

      vrcae_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vrc_apply_disable : (u64, u64) -> u64 !{mem} @{cap} =
    fn (vrr_slot: u64) (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-003 (#1434): validate slot names a live KIND_VRR_RANGE; delegate to dpy_vrr_disarm(ddi). Labels prefixed vrcad_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call vrc_slot_valid;
        cmp rax, 0;
        je  vrcad_bad_slot;

        mov rdi, r12;
        call vrr_row_of_slot;
        cmp rax, 0xFF;
        je  vrcad_no_range;

        mov rdi, 2;                      // VRC_ST_DISABLE
        call vrc_note;

        mov rdi, r13;
        call dpy_vrr_disarm;
        cmp rax, 0;
        jne vrcad_failed;

        xor rax, rax;
        jmp vrcad_out;

      vrcad_bad_slot:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65E;
        jmp vrcad_out;
      vrcad_no_range:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65B;
        jmp vrcad_out;
      vrcad_failed:
        mov rdi, 3;
        call vrc_note;
        mov rax, 0xFFFFF65A;

      vrcad_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
