// src/kernel/core/ipc/hub_topology_channel.pdx -- R34.M1-004 (#1170)
//
// The SCHEMA of the hub_topology_channel session. See
// design/ipc/hub-topology-channel-schema.md for the full argument.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session the USB class driver and its
// subscribers share over ONE endpoint. It is NOT an endpoint, NOT a
// transport, and NOT a driver. The session type is:
//
//   hub_topology : Channel {
//     !{ hub_status_recv }
//     { device_attached(hub_slot, port, speed)
//     | device_detached(hub_slot, port)
//     | port_status_change(hub_slot, port, event_kind) }*
//   }
//
// The three EVENT frames stream device attach/detach and per-port
// status changes to subscribers. Every frame is one u64.
//
// =============================================================================
// §1  ONE u64 FRAMES
// =============================================================================
//
//   DEVICE_ATTACHED  op = 0x40  { hub_slot[15:8], port[23:16], speed[31:24] }
//   DEVICE_DETACHED  op = 0x41  { hub_slot[15:8], port[23:16] }
//   PORT_STATUS_CHG  op = 0x42  { hub_slot[15:8], port[23:16], event[31:24] }
//
// Ordinals occupy 0x40..0x42. All three are one-way EVENT frames —
// there is no reply for a topology event, because the events
// describe things that already happened.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Same argument as codec_query_channel §2, audio_routing_channel §5,
// pcm_ring_channel §2.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFCA0..0xFFFFFCAF (SHARED WITH audio_routing_channel)
//
// Bump if disjointness ever matters -- for now, the two schemas'
// error bands are read only through the packer/unpacker return path,
// and callers can distinguish which schema they invoked.
//
// Actually — bumped to 0xFFFFFC90..0xFFFFFC9F to keep disjoint.
// =============================================================================

module HubTopologyChannel = structure {

  pub let HUB_TOPO_OP_ATTACHED   : u64 = 0x40
  pub let HUB_TOPO_OP_DETACHED   : u64 = 0x41
  pub let HUB_TOPO_OP_STATUS_CHG : u64 = 0x42
  pub let HUB_TOPO_OP_MAX_REQ    : u64 = 0x42

  // Speed enum copies KIND_USB_DEVICE §4 for wire orthogonality.
  pub let HUB_TOPO_SPEED_LOW   : u64 = 1
  pub let HUB_TOPO_SPEED_FULL  : u64 = 2
  pub let HUB_TOPO_SPEED_HIGH  : u64 = 3
  pub let HUB_TOPO_SPEED_SUPER : u64 = 4
  pub let HUB_TOPO_SPEED_MAX   : u64 = 4

  // Event kind enum (mirrors hub_fsm.pdx events).
  pub let HUB_TOPO_EV_CONNECT     : u64 = 1
  pub let HUB_TOPO_EV_RESET_START : u64 = 2
  pub let HUB_TOPO_EV_ADDRESSED   : u64 = 3
  pub let HUB_TOPO_EV_CONFIGURED  : u64 = 4
  pub let HUB_TOPO_EV_DISCONNECT  : u64 = 5
  pub let HUB_TOPO_EV_MAX         : u64 = 5

  pub let HUB_TOPO_OK           : u64 = 0
  pub let HUB_TOPO_BAD_OP       : u64 = 0xFFFFFC9F
  pub let HUB_TOPO_BAD_SLOT     : u64 = 0xFFFFFC9E
  pub let HUB_TOPO_BAD_PORT     : u64 = 0xFFFFFC9D
  pub let HUB_TOPO_BAD_SPEED    : u64 = 0xFFFFFC9C
  pub let HUB_TOPO_BAD_EVENT    : u64 = 0xFFFFFC9B
  pub let HUB_TOPO_BAD_RESERVED : u64 = 0xFFFFFC9A

  pub let HUB_TOPO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let hub_topo_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): 1 iff op in [0x40, 0x42]. Labels prefixed htp_ov_.",
      block: {
        cmp rdi, 0x40;
        jb  htp_ov_no;
        cmp rdi, 0x42;
        ja  htp_ov_no;
        mov rax, 1;
        ret;
      htp_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_topo_speed_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): 1 iff s in [LOW, SUPER]. Labels prefixed htp_sv_.",
      block: {
        cmp rdi, 1;
        jb  htp_sv_no;
        cmp rdi, 4;
        ja  htp_sv_no;
        mov rax, 1;
        ret;
      htp_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_topo_ev_valid : (u64) -> u64 !{} @{} =
    fn (e: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): 1 iff e in [CONNECT, DISCONNECT]. Labels prefixed htp_ev_.",
      block: {
        cmp rdi, 1;
        jb  htp_ev_no;
        cmp rdi, 5;
        ja  htp_ev_no;
        mov rax, 1;
        ret;
      htp_ev_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packers.
  // ==========================================================================

  pub let hub_topo_pack_attached : (u64, u64, u64) -> u64 !{} @{} =
    fn (hub_slot: u64, port: u64, speed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): DEVICE_ATTACHED. Gates: hub_slot<256, port<16, speed valid. Labels prefixed htp_pa_.",
      block: {
        cmp rdi, 256;
        jae htp_pa_bad;
        cmp rsi, 16;
        jae htp_pa_bad;
        cmp rdx, 1;
        jb  htp_pa_bad;
        cmp rdx, 4;
        ja  htp_pa_bad;

        mov rax, 0x40;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      htp_pa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hub_topo_pack_detached : (u64, u64) -> u64 !{} @{} =
    fn (hub_slot: u64, port: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): DEVICE_DETACHED. Labels prefixed htp_pd_.",
      block: {
        cmp rdi, 256;
        jae htp_pd_bad;
        cmp rsi, 16;
        jae htp_pd_bad;

        mov rax, 0x41;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      htp_pd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hub_topo_pack_status_chg : (u64, u64, u64) -> u64 !{} @{} =
    fn (hub_slot: u64, port: u64, event: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): PORT_STATUS_CHG. Labels prefixed htp_ps_.",
      block: {
        cmp rdi, 256;
        jae htp_ps_bad;
        cmp rsi, 16;
        jae htp_ps_bad;
        cmp rdx, 1;
        jb  htp_ps_bad;
        cmp rdx, 5;
        ja  htp_ps_bad;

        mov rax, 0x42;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      htp_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Unpackers. Each gates on the op byte.
  // ==========================================================================

  pub let hub_topo_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): op ordinal from low byte.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_topo_hub_slot : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): hub_slot from bits [15:8]. Gates op in [0x40, 0x42]. Labels prefixed htp_uhs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x40;
        jb  htp_uhs_bad;
        cmp rax, 0x42;
        ja  htp_uhs_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      htp_uhs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hub_topo_port : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): port from bits [23:16]. Labels prefixed htp_up_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x40;
        jb  htp_up_bad;
        cmp rax, 0x42;
        ja  htp_up_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret;
      htp_up_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hub_topo_speed : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): speed from bits [31:24]. Gates op == 0x40. Labels prefixed htp_us_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x40;
        jne htp_us_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret;
      htp_us_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hub_topo_event : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-004 (#1170): event from bits [31:24]. Gates op == 0x42. Labels prefixed htp_ue_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x42;
        jne htp_ue_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret;
      htp_ue_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
