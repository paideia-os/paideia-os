// src/kernel/core/ipc/color_management_channel.pdx -- G6.M1-004 (#1512)
//
// Session-type schema for the color_management channel. Carries three
// RPCs the display-supervisor exposes:
//
//     query_output_gamut(output_slot)
//         -> primaries_ord + max_luminance_cd_m2 | err
//     get_tonemap_lut(source_prim, target_prim, size)
//         -> Cap<KIND_MEMORY> (LUT buffer) | err
//     set_reference_display(prim_ord, max_lum, min_lum)
//         -> ok | err
//
// Effect row: !{color_convert, tonemap_apply} -- the two authorities
// the server exposes on the channel.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the color-management conversation: event
// ordinals, argument validators, and small pack/unpack primitives.
//
// It is NOT an endpoint, NOT a transport, NOT the mint gate.
//
// =============================================================================
// SECTION 1  EVENT ORDINALS 0xE0..0xE2
// =============================================================================
//
//   CMC_EV_QUERY_GAMUT   0xE0
//   CMC_EV_GET_TONEMAP   0xE1
//   CMC_EV_SET_REF_DPY   0xE2
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDF0..0xFFFFEDFF
// =============================================================================

module ColorManagementChannel = structure {

  pub let CMC_EV_QUERY_GAMUT : u64 = 0xE0
  pub let CMC_EV_GET_TONEMAP : u64 = 0xE1
  pub let CMC_EV_SET_REF_DPY : u64 = 0xE2
  pub let CMC_EV_MAX         : u64 = 0xE2

  pub let CMC_OK          : u64 = 0
  pub let CMC_BAD_EV      : u64 = 0xFFFFEDFF
  pub let CMC_BAD_OUTPUT  : u64 = 0xFFFFEDFE
  pub let CMC_BAD_PRIM    : u64 = 0xFFFFEDFD
  pub let CMC_BAD_SIZE    : u64 = 0xFFFFEDFC
  pub let CMC_BAD_LUM     : u64 = 0xFFFFEDFB
  pub let CMC_NO_OUTPUT   : u64 = 0xFFFFEDFA
  pub let CMC_APPLY_FAIL  : u64 = 0xFFFFEDF9

  pub let CMC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // LUT size ceiling. 64^3 * 4 bytes = 1 MiB is the standard target
  // for a 3D LUT the compositor can upload to a GPU cache; a caller
  // asking beyond that gets CMC_BAD_SIZE.
  pub let CMC_LUT_SIZE_MAX : u64 = 64

  // Luminance ceiling in cd/m^2 (nits). 10000 is the PQ ST 2084
  // peak; a caller asking beyond that gets CMC_BAD_LUM. Minimum is
  // stored in the same units, must be > 0 and < max.
  pub let CMC_LUM_MAX      : u64 = 10000

  pub let mut _cmc_stats : [u64; 4] = uninit @align(64)

  pub let CMC_ST_QUERIES  : u64 = 0
  pub let CMC_ST_TONEMAPS : u64 = 1
  pub let CMC_ST_REF_SETS : u64 = 2
  pub let CMC_ST_REFUSED  : u64 = 3

  pub let cmc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-004 (#1512): clear schema counters.",
      block: {
        lea r10, [rip + _cmc_stats];
        xor rax, rax;
        xor rcx, rcx;
      cmc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  cmc_rs_loop;
        ret
      }
    }

  pub let cmc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-004 (#1512): counter bump.",
      block: {
        cmp rdi, 4;
        jae cmc_nt_out;
        lea r10, [rip + _cmc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cmc_nt_out:
        ret
      }
    }

  pub let cmc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-004 (#1512): counter read.",
      block: {
        cmp rdi, 4;
        jae cmc_st_zero;
        lea r10, [rip + _cmc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cmc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let cmc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-004 (#1512): 1 iff ev in [0xE0, 0xE2].",
      block: {
        mov r10, 0xE0;
        cmp rdi, r10;
        jb  cmc_ev_no;
        mov r10, 0xE2;
        cmp rdi, r10;
        ja  cmc_ev_no;
        mov rax, 1;
        ret;
      cmc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let cmc_prim_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-004 (#1512): 1 iff p in [1, 4].",
      block: {
        cmp rdi, 0;
        je  cmc_pv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  cmc_pv_no;
        mov rax, 1;
        ret;
      cmc_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cmc_size_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-004 (#1512): 1 iff 0 < s <= 64.",
      block: {
        cmp rdi, 0;
        je  cmc_sv_no;
        mov r10, 64;
        cmp rdi, r10;
        ja  cmc_sv_no;
        mov rax, 1;
        ret;
      cmc_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cmc_lum_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-004 (#1512): 1 iff 0 < l <= CMC_LUM_MAX=10000.",
      block: {
        cmp rdi, 0;
        je  cmc_lv_no;
        mov r10, 10000;
        cmp rdi, r10;
        ja  cmc_lv_no;
        mov rax, 1;
        ret;
      cmc_lv_no:
        xor rax, rax;
        ret
      }
    }

  // cmc_apply_query_gamut(output_slot) -> primaries | err
  pub let cmc_apply_query_gamut : (u64) -> u64 !{mem} @{cap} =
    fn (output_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G6.M1-004 (#1512): query_output_gamut -- output_slot must be < 256; synthetic reply reports PRIM_SRGB for even slots, PRIM_REC2020 for odd (the display supervisor supplies the real mapping at wire-up).",
      block: {
        push r12;
        mov r12, rdi;

        mov r11, 256;
        cmp r12, r11;
        jae cmc_qg_bad_out;

        mov rdi, 0;
        call cmc_note;

        mov rax, r12;
        and rax, 1;
        cmp rax, 0;
        je  cmc_qg_srgb;
        mov rax, 4;                         // PRIM_REC2020
        jmp cmc_qg_out;
      cmc_qg_srgb:
        mov rax, 1;                         // PRIM_SRGB
        jmp cmc_qg_out;

      cmc_qg_bad_out:
        mov rdi, 3;
        call cmc_note;
        mov rax, 0xFFFFEDFE;

      cmc_qg_out:
        pop r12;
        ret
      }
    }

  // cmc_apply_get_tonemap(src, dst, size) -> ok | err
  pub let cmc_apply_get_tonemap : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (src: u64) (dst: u64) (size: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G6.M1-004 (#1512): get_tonemap_lut -- validate + count; the tonemap LUT itself is built by drivers/color/gpu_convert.pdx behind this seam.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call cmc_prim_valid;
        cmp rax, 0;
        je  cmc_gt_bad_p;
        mov rdi, r13;
        call cmc_prim_valid;
        cmp rax, 0;
        je  cmc_gt_bad_p;
        mov rdi, r14;
        call cmc_size_valid;
        cmp rax, 0;
        je  cmc_gt_bad_s;

        mov rdi, 1;
        call cmc_note;
        xor rax, rax;
        jmp cmc_gt_out;

      cmc_gt_bad_p:
        mov rdi, 3;
        call cmc_note;
        mov rax, 0xFFFFEDFD;
        jmp cmc_gt_out;
      cmc_gt_bad_s:
        mov rdi, 3;
        call cmc_note;
        mov rax, 0xFFFFEDFC;

      cmc_gt_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // cmc_apply_set_ref_dpy(prim, max_lum, min_lum) -> ok | err
  pub let cmc_apply_set_ref_dpy : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (prim: u64) (max_lum: u64) (min_lum: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G6.M1-004 (#1512): set_reference_display -- validate primary ord + luminance bounds; the actual reference-display state stays in the display supervisor.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call cmc_prim_valid;
        cmp rax, 0;
        je  cmc_sr_bad_p;
        mov rdi, r13;
        call cmc_lum_valid;
        cmp rax, 0;
        je  cmc_sr_bad_l;
        mov rdi, r14;
        call cmc_lum_valid;
        cmp rax, 0;
        je  cmc_sr_bad_l;

        // min < max.
        cmp r14, r13;
        jae cmc_sr_bad_l;

        mov rdi, 2;
        call cmc_note;
        xor rax, rax;
        jmp cmc_sr_out;

      cmc_sr_bad_p:
        mov rdi, 3;
        call cmc_note;
        mov rax, 0xFFFFEDFD;
        jmp cmc_sr_out;
      cmc_sr_bad_l:
        mov rdi, 3;
        call cmc_note;
        mov rax, 0xFFFFEDFB;

      cmc_sr_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
