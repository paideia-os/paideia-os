// src/kernel/core/ipc/font_load_channel.pdx -- G5.M1-003 (#1493)
//
// Session-type schema for the font_load channel. Carries three
// RPCs the font-load server exposes:
//
//     load_font(font_key, atlas_extent_w, atlas_extent_h, format)
//         -> Cap<KIND_FONT_ATLAS> | err
//     subset_atlas(parent_atlas_slot, glyph_count)
//         -> Cap<KIND_FONT_ATLAS> | err
//     evict(atlas_slot)
//         -> ok | err
//
// Effect row: !{font_load, font_evict} -- the two authorities the
// server exposes on the channel. In this milestone both are
// mediated by fa_tail_alloc / fa_tail_free through the schema's
// fl_apply_* seams.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the font-load conversation: event ordinals,
// argument-shape validators, and small pack/unpack primitives.
//
// It is NOT an endpoint (no queue), NOT a transport, NOT the mint
// gate (the mint lives in cap/kind_font_atlas.pdx and is called
// from HERE through fl_apply_*).
//
// =============================================================================
// SECTION 1  EVENT ORDINALS 0xD0..0xD2
// =============================================================================
//
//   FLC_EV_LOAD_FONT      0xD0
//   FLC_EV_SUBSET_ATLAS   0xD1
//   FLC_EV_EVICT          0xD2
//
// Ordinals live in the 0xD0 band -- distinct from vk_surface
// (0xC0), display_sync (0xA0), vrr (0xB0), modeset (0x90) so a
// dispatcher switching on ordinal cannot cross wires.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDE0..0xFFFFEDEF
// =============================================================================

module FontLoadChannel = structure {

  pub let FLC_EV_LOAD_FONT    : u64 = 0xD0
  pub let FLC_EV_SUBSET_ATLAS : u64 = 0xD1
  pub let FLC_EV_EVICT        : u64 = 0xD2
  pub let FLC_EV_MAX          : u64 = 0xD2

  pub let FLC_OK              : u64 = 0
  pub let FLC_BAD_EV          : u64 = 0xFFFFEDEF
  pub let FLC_BAD_SLOT        : u64 = 0xFFFFEDEE
  pub let FLC_BAD_EXTENT      : u64 = 0xFFFFEDED
  pub let FLC_BAD_FORMAT      : u64 = 0xFFFFEDEC
  pub let FLC_BAD_KEY         : u64 = 0xFFFFEDEB
  pub let FLC_BAD_COUNT       : u64 = 0xFFFFEDEA
  pub let FLC_NO_ATLAS        : u64 = 0xFFFFEDE9
  pub let FLC_APPLY_FAILED    : u64 = 0xFFFFEDE8
  pub let FLC_KEY_IN_USE      : u64 = 0xFFFFEDE7

  pub let FLC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _flc_stats : [u64; 4] = uninit @align(64)

  pub let FLC_ST_LOADS   : u64 = 0
  pub let FLC_ST_SUBSETS : u64 = 1
  pub let FLC_ST_EVICTS  : u64 = 2
  pub let FLC_ST_REFUSED : u64 = 3

  pub let flc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-003 (#1493): clear schema counters.",
      block: {
        lea r10, [rip + _flc_stats];
        xor rax, rax;
        xor rcx, rcx;
      flc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  flc_rs_loop;
        ret
      }
    }

  pub let flc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-003 (#1493): counter bump.",
      block: {
        cmp rdi, 4;
        jae flc_nt_out;
        lea r10, [rip + _flc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      flc_nt_out:
        ret
      }
    }

  pub let flc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-003 (#1493): counter read.",
      block: {
        cmp rdi, 4;
        jae flc_st_zero;
        lea r10, [rip + _flc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      flc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let flc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-003 (#1493): 1 iff ev in [0xD0, 0xD2].",
      block: {
        mov r10, 0xD0;
        cmp rdi, r10;
        jb  flc_ev_no;
        mov r10, 0xD2;
        cmp rdi, r10;
        ja  flc_ev_no;
        mov rax, 1;
        ret;
      flc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let flc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-003 (#1493): 1 iff s < 256.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae flc_sl_no;
        mov rax, 1;
        ret;
      flc_sl_no:
        xor rax, rax;
        ret
      }
    }

  // ========================================================================
  // flc_apply_load(font_key, extent_w, extent_h, format)
  //     -> atlas_row_id | err
  //
  // Validate args + delegate to fa_tail_alloc. The font-load server
  // wraps its own bo_slot allocation (from the driver-supplied BO
  // pool) around this call before minting the cap. Here we exercise
  // the alloc path with a synthetic bo_slot derived from font_key.
  // ========================================================================
  pub let flc_apply_load : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (font_key: u64) (w: u64) (h: u64) (fmt: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-003 (#1493): validate load_font args, then invoke fa_tail_alloc via the standard pack helpers. Five callee-save pushes (rbx, r12-r15) + sub rsp, 16 keep the SysV alignment discipline: entry rsp%16 == 8, five pushes give rsp%16 == 0, sub rsp, 16 keeps it at 0 which SysV requires at every inner call. Scratch cells [rsp+0]=hdr, [rsp+8]=body1 survive the ts_body*_pack calls that would clobber caller-save registers.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                        // scratch: hdr@0, body1@8

        mov r12, rdi;                       // key
        mov r13, rsi;                       // w
        mov r14, rdx;                       // h
        mov r15, rcx;                       // fmt

        // extent.
        mov rdi, r13;
        mov rsi, r14;
        call fa_extent_valid;
        cmp rax, 0;
        je  flc_al_bad_ext;

        // format.
        mov rdi, r15;
        call fa_format_valid;
        cmp rax, 0;
        je  flc_al_bad_fmt;

        // key non-zero.
        cmp r12, 0;
        je  flc_al_bad_key;

        // Uniqueness across live rows.
        mov rdi, r12;
        call fa_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne flc_al_key_in_use;

        // Synthetic bo_slot from key low 16.
        mov rbx, r12;
        and rbx, 0xFFFF;
        cmp rbx, 0;
        jne flc_al_go;
        mov rbx, 1;
      flc_al_go:
        // Pack header -> [rsp+0].
        mov rdi, 0;
        call fa_hdr_pack;
        mov [rsp + 0], rax;

        // Pack body1 -> [rsp+8].
        mov rdi, rbx;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call fa_body1_pack;
        mov [rsp + 8], rax;

        // Pack body2 in rax.
        mov rdi, 0;
        mov rsi, 0;
        call fa_body2_pack;

        // fa_tail_alloc(hdr, key, body1, body2).
        mov rcx, rax;                       // body2
        mov rdi, [rsp + 0];                 // hdr
        mov rsi, r12;                       // key
        mov rdx, [rsp + 8];                 // body1
        call fa_tail_alloc;

        mov r10, 0xFF;
        cmp rax, r10;
        ja  flc_al_alloc_err;
        mov [rsp + 0], rax;
        mov rdi, 0;                         // FLC_ST_LOADS
        call flc_note;
        mov rax, [rsp + 0];
        jmp flc_al_out;

      flc_al_alloc_err:
        mov [rsp + 0], rax;
        mov rdi, 3;
        call flc_note;
        mov rax, [rsp + 0];
        jmp flc_al_out;

      flc_al_bad_ext:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDED;
        jmp flc_al_out;
      flc_al_bad_fmt:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDEC;
        jmp flc_al_out;
      flc_al_bad_key:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDEB;
        jmp flc_al_out;
      flc_al_key_in_use:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDE7;

      flc_al_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // flc_apply_subset(parent_slot, glyph_count) -> row_id | err
  pub let flc_apply_subset : (u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (glyph_count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-003 (#1493): subset_atlas -- derive a smaller atlas from a parent one. Validates parent + count; delegates.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call flc_slot_valid;
        cmp rax, 0;
        je  flc_as_bad_slot;

        mov rdi, r13;
        call fa_glyphs_valid;
        cmp rax, 0;
        je  flc_as_bad_count;

        mov rdi, r12;
        call fa_row_of_slot;
        mov r10, 0xFF;
        cmp rax, r10;
        je  flc_as_no_atlas;

        mov rdi, 1;                         // FLC_ST_SUBSETS
        call flc_note;
        xor rax, rax;
        jmp flc_as_out;

      flc_as_bad_slot:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDEE;
        jmp flc_as_out;
      flc_as_bad_count:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDEA;
        jmp flc_as_out;
      flc_as_no_atlas:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDE9;

      flc_as_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // flc_apply_evict(atlas_slot) -> ok | err
  pub let flc_apply_evict : (u64) -> u64 !{mem} @{cap} =
    fn (atlas_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-003 (#1493): evict -- refuse a bad slot then delegate to fa_tail_free through the row lookup.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call flc_slot_valid;
        cmp rax, 0;
        je  flc_ae_bad_slot;

        mov rdi, r12;
        call fa_row_of_slot;
        mov r10, 0xFF;
        cmp rax, r10;
        je  flc_ae_no_atlas;

        mov rdi, rax;
        call fa_tail_free;

        mov rdi, 2;                         // FLC_ST_EVICTS
        call flc_note;
        xor rax, rax;
        jmp flc_ae_out;

      flc_ae_bad_slot:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDEE;
        jmp flc_ae_out;
      flc_ae_no_atlas:
        mov rdi, 3;
        call flc_note;
        mov rax, 0xFFFFEDE9;

      flc_ae_out:
        pop r12;
        ret
      }
    }
}
