// src/kernel/core/ipc/pcm_ring_channel.pdx -- R33.M3-004 (#1150)
//
// The SCHEMA of the pcm_ring_channel session: a session-typed contract
// for producers and consumers exchanging PCM periods on a ring, PLUS
// the session's carrier — one KIND_AUDIO_CLOCK capability so consumers
// can compute presentation time.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session an audio producer and consumer share
// over one KIND_PCM_STREAM. It is NOT an endpoint, NOT a transport,
// and NOT the audio server itself. The session type is:
//
//   pcm_ring : Channel {
//     ! { audio_clock_read }         -- effect: carries a KIND_AUDIO_CLOCK
//     { fill_next_period(buf_id, period_frames),
//       drain_current_period,
//       xrun_notify(period),
//       seek(sample_index) }*
//   }
//
// The `!{audio_clock_read}` effect row names the ONE capability the
// session CARRIES so a consumer can turn a sample index into wall time.
// A session type that could carry two clocks would let a consumer see
// two presentation-time answers for one sample and have no principled
// way to choose between them. §3 states the discipline.
//
// The four RPCs cycle: a producer fills the next period, the consumer
// drains the current period, an xrun notification announces missed
// deadlines, and seek repositions the stream. Each is one u64
// request; three carry one u64 reply.
//
// =============================================================================
// §1  ONE u64 REQUESTS AND ONE u64 REPLIES
// =============================================================================
//
//   Requests (op in bits [7:0]):
//     FILL_NEXT       op = 0x10 { buf_id[23:8], period_frames[47:24] }
//     DRAIN_CURRENT   op = 0x11 (no payload)
//     XRUN_NOTIFY     op = 0x12 { period[47:8] }
//     SEEK            op = 0x13 { sample_index[63:8] }
//
//   Replies:
//     FILL_ACK        op = 0xE0 { status[63:8] }
//     DRAIN_ACK       op = 0xE1 { period_id[47:8], frames[63:48] }
//     XRUN_ACK        op = 0xE2 { status[63:8] }
//     SEEK_ACK        op = 0xE3 { status[63:8] }
//
// Op ordinals for requests occupy 0x10..0x13; replies 0xE0..0xE3 so a
// dispatcher switching on the byte cannot route a reply as a request.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Every packed frame has RESERVED bit ranges. The packers refuse a
// payload with any set. Same argument as codec_query_channel §2.
//
// =============================================================================
// §3  THE SESSION CARRIES ONE AUDIO_CLOCK CAP
// =============================================================================
//
// A session's establishment MUST hand the consumer a KIND_AUDIO_CLOCK
// capability (one, not two — see §0). This module does not mint or
// pass the cap; the audio server does, and this schema is what
// records the FIELD in a session establishment frame. The frame
// layout is documented in design/ipc/pcm-ring-channel-schema.md §5.
//
// =============================================================================
// §4  REFUSE, NEVER CLAMP
// =============================================================================
//
// buf_id not in [1, 65535] -> BAD_BUF.
// period_frames not in [1, PCM_RING_PERIOD_FRAMES_MAX] -> BAD_FRAMES.
// period ordinal not in [1, PCM_RING_PERIOD_ID_MAX] -> BAD_PERIOD.
// sample_index above 2^56 -> BAD_SAMPLE.
// Unknown op -> BAD_OP.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCB0..0xFFFFFCBF
// =============================================================================

module PcmRingChannel = structure {

  // ==========================================================================
  // §1 ordinals.
  // ==========================================================================

  pub let PCM_RING_OP_FILL_NEXT     : u64 = 0x10
  pub let PCM_RING_OP_DRAIN_CURRENT : u64 = 0x11
  pub let PCM_RING_OP_XRUN_NOTIFY   : u64 = 0x12
  pub let PCM_RING_OP_SEEK          : u64 = 0x13
  pub let PCM_RING_OP_MAX_REQ       : u64 = 0x13

  pub let PCM_RING_OP_FILL_ACK      : u64 = 0xE0
  pub let PCM_RING_OP_DRAIN_ACK     : u64 = 0xE1
  pub let PCM_RING_OP_XRUN_ACK      : u64 = 0xE2
  pub let PCM_RING_OP_SEEK_ACK      : u64 = 0xE3

  pub let PCM_RING_BUF_MAX          : u64 = 65536       // buf_id < 2^16
  pub let PCM_RING_PERIOD_FRAMES_MAX : u64 = 16777216   // < 2^24
  pub let PCM_RING_PERIOD_ID_MAX    : u64 = 1099511627776  // < 2^40
  pub let PCM_RING_SAMPLE_MAX       : u64 = 72057594037927936  // < 2^56

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let PCM_RING_OK           : u64 = 0
  pub let PCM_RING_BAD_OP       : u64 = 0xFFFFFCBF
  pub let PCM_RING_BAD_BUF      : u64 = 0xFFFFFCBE
  pub let PCM_RING_BAD_FRAMES   : u64 = 0xFFFFFCBD
  pub let PCM_RING_BAD_PERIOD   : u64 = 0xFFFFFCBC
  pub let PCM_RING_BAD_SAMPLE   : u64 = 0xFFFFFCBB
  pub let PCM_RING_BAD_RESERVED : u64 = 0xFFFFFCBA

  pub let PCM_RING_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pcm_ring_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): 1 iff op is a REQUEST ordinal (0x10..0x13). Zero refused (bss default). Reply ordinals 0xE0..0xE3 refused (dispatcher must not route reply as request). Labels prefixed pcmr_ov_.",
      block: {
        cmp rdi, 0x10;
        jb  pcmr_ov_no;
        cmp rdi, 0x13;
        ja  pcmr_ov_no;
        mov rax, 1;
        ret;
      pcmr_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Request packers.
  // ==========================================================================

  pub let pcm_ring_pack_fill_next_req : (u64, u64) -> u64 !{} @{} =
    fn (buf_id: u64, period_frames: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack FILL_NEXT. Layout: op=0x10, buf_id[23:8], period_frames[47:24]. Gates: buf_id in [1, 65535] and period_frames in [1, PCM_RING_PERIOD_FRAMES_MAX]. Refuses reserved combinations. Labels prefixed pcmr_pfn_.",
      block: {
        cmp rdi, 0;
        je  pcmr_pfn_bad;
        mov r10, 65535;
        cmp rdi, r10;
        ja  pcmr_pfn_bad;

        cmp rsi, 0;
        je  pcmr_pfn_bad;
        mov r10, 16777216;
        cmp rsi, r10;
        ja  pcmr_pfn_bad;

        mov rax, 0x10;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 24;
        or  rax, r10;
        ret;
      pcmr_pfn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_drain_current_req : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack DRAIN_CURRENT (op only, reserved zero). Pure leaf. Labels: none.",
      block: {
        mov rax, 0x11;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_xrun_notify_req : (u64) -> u64 !{} @{} =
    fn (period: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack XRUN_NOTIFY. Layout: op=0x12, period[47:8]. Gate: period in [1, PCM_RING_PERIOD_ID_MAX]. Labels prefixed pcmr_pxn_.",
      block: {
        cmp rdi, 0;
        je  pcmr_pxn_bad;
        mov r10, 1;
        shl r10, 40;                     // 2^40
        cmp rdi, r10;
        jae pcmr_pxn_bad;

        mov rax, 0x12;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        ret;
      pcmr_pxn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_seek_req : (u64) -> u64 !{} @{} =
    fn (sample_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack SEEK. Layout: op=0x13, sample_index[63:8]. Gate: sample_index < PCM_RING_SAMPLE_MAX (2^56). Labels prefixed pcmr_psk_.",
      block: {
        mov r10, 1;
        shl r10, 56;
        cmp rdi, r10;
        jae pcmr_psk_bad;

        mov rax, 0x13;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        ret;
      pcmr_psk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Reply packers.
  // ==========================================================================

  pub let pcm_ring_pack_fill_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack FILL_ACK. Layout: op=0xE0, status[63:8]. Labels: none.",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xE0;
        or  rax, r10;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_drain_ack : (u64, u64) -> u64 !{} @{} =
    fn (period_id: u64, frames: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack DRAIN_ACK. Layout: op=0xE1, period_id[47:8], frames[63:48]. Gates: period_id < 2^40, frames < 2^16 (period frames capped to 65535 in a single ack -- larger periods split). Labels prefixed pcmr_pda_.",
      block: {
        mov r10, 1;
        shl r10, 40;
        cmp rdi, r10;
        jae pcmr_pda_bad;
        mov r10, 65536;
        cmp rsi, r10;
        jae pcmr_pda_bad;

        mov rax, 0xE1;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 48;
        or  rax, r10;
        ret;
      pcmr_pda_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_xrun_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack XRUN_ACK. Layout: op=0xE2, status[63:8]. Labels: none.",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xE2;
        or  rax, r10;
        ret
      }
    } @no_frame

  pub let pcm_ring_pack_seek_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): pack SEEK_ACK. Layout: op=0xE3, status[63:8]. Labels: none.",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xE3;
        or  rax, r10;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Unpackers.
  // ==========================================================================

  pub let pcm_ring_req_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): op ordinal. Labels: none.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_fill_next_req_buf : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): buf_id from FILL_NEXT. Gate op == 0x10. Labels prefixed pcmr_ufb_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x10;
        jne pcmr_ufb_bad;
        mov rax, rdi;
        shr rax, 8;
        mov r10, 0xFFFF;
        and rax, r10;
        ret;
      pcmr_ufb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_fill_next_req_frames : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): period_frames from FILL_NEXT. Gate op == 0x10. Labels prefixed pcmr_uff_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x10;
        jne pcmr_uff_bad;
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFFFF;
        and rax, r10;
        ret;
      pcmr_uff_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_xrun_notify_req_period : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): period from XRUN_NOTIFY. Gate op == 0x12. Labels prefixed pcmr_uxp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x12;
        jne pcmr_uxp_bad;
        mov rax, rdi;
        shr rax, 8;
        mov r10, 1;
        shl r10, 40;
        sub r10, 1;
        and rax, r10;
        ret;
      pcmr_uxp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_seek_req_sample : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): sample_index from SEEK. Gate op == 0x13. Labels prefixed pcmr_uss_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x13;
        jne pcmr_uss_bad;
        mov rax, rdi;
        shr rax, 8;
        ret;
      pcmr_uss_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_fill_ack_status : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): status from FILL_ACK. Gate op == 0xE0. Labels prefixed pcmr_ufs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xE0;
        jne pcmr_ufs_bad;
        mov rax, rdi;
        shr rax, 8;
        ret;
      pcmr_ufs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_drain_ack_period : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): period_id from DRAIN_ACK. Gate op == 0xE1. Labels prefixed pcmr_udp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xE1;
        jne pcmr_udp_bad;
        mov rax, rdi;
        shr rax, 8;
        mov r10, 1;
        shl r10, 40;
        sub r10, 1;
        and rax, r10;
        ret;
      pcmr_udp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_ring_drain_ack_frames : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-004 (#1150): frames from DRAIN_ACK. Gate op == 0xE1. Labels prefixed pcmr_udf_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xE1;
        jne pcmr_udf_bad;
        mov rax, rdi;
        shr rax, 48;
        ret;
      pcmr_udf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
