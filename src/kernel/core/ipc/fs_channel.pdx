// src/kernel/core/ipc/fs_channel.pdx -- R42.M4-004 (#1395)
//
// The SCHEMA of the fs_channel: the RPC surface between a caller and
// the PdxFS supervisor. Nine one-way requests + their reply packers,
// one validator, the pack/unpack primitives that turn a request or a
// reply into ONE u64 the transport can move without a struct.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCHEMA of a channel, and the packers/unpackers that
// discharge that schema. It is NOT an endpoint, NOT a transport, and
// NOT a server: no queue lives here, no capability is minted here, and
// NO CALL sends a byte across a process boundary. The pdxfs supervisor
// (a widening the R42 wave hands to R43) will bind this schema to a
// KIND_FS_CHANNEL row; today the schema lives as code so a subscriber
// that unpacks a field the packer never produced fails at build time
// rather than silently reading a value from the wrong bit range.
//
// The schema lives as code (rather than as a document only) because
// the packer is the LOAD-BEARING artefact: an fs_channel reply that
// hands back an fd from a bit slice the packer never populated is a
// caller that will (on the next call) read/write a slot the supervisor
// never issued. tools/build.sh confines the pack/unpack signatures so
// a fifth parameter cannot smuggle a caller-supplied ceiling or a
// pointer past the schema gate.
//
// It does NOT model buffer transfer. The read / write RPCs describe
// {fd, len} pairs; the actual buffer bytes cross via KIND_MEMORY
// windows minted separately, as with pcm_ring_channel and camera_
// capture_channel. Encoding a buffer pointer in the reply would let
// the sender name a supervisor-side address the receiver never
// derived.
//
// It does NOT persist. The schema is stateless; state lives in the
// pdxfs volume the supervisor mounts.
//
// =============================================================================
// §1  ONE u64 REQUESTS AND REPLIES
// =============================================================================
//
// Every request the fs_channel names fits one u64 that the transport
// moves as a single word; every reply likewise. Multi-word payloads
// would introduce an ordering across the words a subscriber must
// preserve, and a fixed-width field domain (§3) keeps every request
// atomic against every reader that reads it as a word.
//
// The nine RPC ops (LOW half of the eight-bit domain) are:
//
//   OP_OPEN     0x01   open(path, flags) -> fd
//   OP_READ     0x02   read(fd, len)
//   OP_WRITE    0x03   write(fd, len)
//   OP_STAT     0x04   stat(path) -> {kind, size}
//   OP_MKDIR    0x05   mkdir(path)
//   OP_SYMLINK  0x06   symlink(target, linkpath)
//   OP_UNLINK   0x07   unlink(path)
//   OP_RENAME   0x08   rename(from, to)
//   OP_CLOSE    0x09   close(fd)
//   OP_SYNC     0x0A   sync(fd)
//   OP_MAX      0x0A
//
// The high half of the ordinal domain (>= 0x80) is reserved so a
// future event addition (e.g. a MOUNT_LOST asynchronous notification)
// cannot be mistaken for an RPC and vice versa. There are no events
// today; the ev_valid validator refuses everything.
//
// =============================================================================
// §2  KIND ENUM (STAT REPLY)
// =============================================================================
//
// KIND_REG  = 1   regular file
// KIND_DIR  = 2   directory
// KIND_LNK  = 3   symlink
// KIND_MAX  = 3
//
// The value 0 is reserved for "unset" and is refused by the packer;
// a widening that discovers a fourth kind (device, socket, ...)
// bumps KIND_MAX and adds one arm, one packer never silently masks a
// value it doesn't recognise.
//
// =============================================================================
// §3  FIELD DOMAINS
// =============================================================================
//
// FD          16 bits [0..65535]. A wider fd is a caller that has held
//                     open more slots than the supervisor can bookkeep;
//                     the packer refuses rather than truncates.
// LEN         32 bits [0..0xFFFFFFFF]. A read/write of >= 4 GiB is a
//                     wide field the transport does not carry today;
//                     splitting is the caller's responsibility.
// FLAGS       8 bits  [0..0xFF]. The open flags currently number a
//                     handful; the reserved band above bit 7 is
//                     refused so a widening that adds O_TMPFILE et al
//                     is a visible change to this width.
// PATH_ID     32 bits. The schema does NOT carry raw path strings on
//                     the wire; a path is presented as a supervisor-
//                     side interned id resolved by a preceding
//                     PATH_RESOLVE call (R43). Encoding a raw pointer
//                     would let the caller point at supervisor memory
//                     the derivation lattice never blessed.
// KIND        8 bits [1..KIND_MAX] (stat reply).
// SIZE        32 bits (stat reply). A file larger than 4 GiB
//                     saturates and sets the STAT_TRUNCATED sentinel
//                     bit -- a widening will widen the field, not
//                     silently truncate.
//
// =============================================================================
// §4  REFUSE, NEVER CLAMP
// =============================================================================
//
// Same discipline as backlight_channel §3, hub_topology_channel §2,
// camera_capture_channel §2: every packer's reserved-bit gate refuses
// with BAD_RESERVED and every width gate refuses with the
// field-specific code; DECODE_BAD is the sentinel a caller stringing a
// code through several packers can recognise as "no legal payload to
// name".
//
// =============================================================================
// §5  ERROR CODES 0xFFFFEF10..0xFFFFEF1F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: lite_reader 0xFFFFEF20..2F (R42.M4-003). Adjacent free
// band below: nvme_write 0xFFFFEF00..0F (R42.M5-001, sibling).
//
//   FSC_OK              = 0
//   FSC_ERR_BAD_OP      = 0xFFFFEF1F   op ordinal out of {1..OP_MAX}
//   FSC_ERR_BAD_EV      = 0xFFFFEF1E   ev ordinal (no events today)
//   FSC_ERR_BAD_FD      = 0xFFFFEF1D   fd > 16-bit domain
//   FSC_ERR_BAD_LEN     = 0xFFFFEF1C   len > 32-bit domain
//   FSC_ERR_BAD_FLAGS   = 0xFFFFEF1B   flags > 8-bit domain
//   FSC_ERR_BAD_KIND    = 0xFFFFEF1A   stat reply kind == 0 or > KIND_MAX
//   FSC_ERR_BAD_RESERVED= 0xFFFFEF19   reserved bits set on a payload
//   FSC_ERR_INTERNAL    = 0xFFFFEF18   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `fsc_`.

module FsChannel = structure {

  // ============================================================================
  // §1's op ordinals.
  // ============================================================================

  pub let FSC_OP_OPEN     : u64 = 0x01
  pub let FSC_OP_READ     : u64 = 0x02
  pub let FSC_OP_WRITE    : u64 = 0x03
  pub let FSC_OP_STAT     : u64 = 0x04
  pub let FSC_OP_MKDIR    : u64 = 0x05
  pub let FSC_OP_SYMLINK  : u64 = 0x06
  pub let FSC_OP_UNLINK   : u64 = 0x07
  pub let FSC_OP_RENAME   : u64 = 0x08
  pub let FSC_OP_CLOSE    : u64 = 0x09
  pub let FSC_OP_SYNC     : u64 = 0x0A
  pub let FSC_OP_MAX      : u64 = 0x0A

  // §2's kind enum.
  pub let FSC_KIND_REG    : u64 = 1
  pub let FSC_KIND_DIR    : u64 = 2
  pub let FSC_KIND_LNK    : u64 = 3
  pub let FSC_KIND_MAX    : u64 = 3

  // §5's failure taxonomy.
  pub let FSC_OK              : u64 = 0
  pub let FSC_ERR_BAD_OP      : u64 = 0xFFFFEF1F
  pub let FSC_ERR_BAD_EV      : u64 = 0xFFFFEF1E
  pub let FSC_ERR_BAD_FD      : u64 = 0xFFFFEF1D
  pub let FSC_ERR_BAD_LEN     : u64 = 0xFFFFEF1C
  pub let FSC_ERR_BAD_FLAGS   : u64 = 0xFFFFEF1B
  pub let FSC_ERR_BAD_KIND    : u64 = 0xFFFFEF1A
  pub let FSC_ERR_BAD_RESERVED: u64 = 0xFFFFEF19
  pub let FSC_ERR_INTERNAL    : u64 = 0xFFFFEF18

  // Positional "there is no legal reply to describe". Distinct from
  // every gate-level refusal so a caller threading a code up through
  // the RPC gate and the packer can still name which one produced it.
  pub let FSC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // fsc_op_valid(op) -> 1 | 0
  //
  // 1 iff op is in [OP_OPEN .. OP_MAX]. Refuses 0: the .bss default
  // for an unset Frame opcode; admitting it would let an uninitialised
  // frame reach the dispatch table. Refuses anything >= 0x80: the
  // high half is reserved for events, and a request routed as an event
  // would produce a reply for a slot the sender never named.
  // ==========================================================================

  pub let fsc_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): 1 iff op is in the RPC ordinal set {OPEN (1), READ (2), WRITE (3), STAT (4), MKDIR (5), SYMLINK (6), UNLINK (7), RENAME (8), CLOSE (9), SYNC (10)}. Zero is refused because it is the .bss default for an unset Frame opcode. The high half of the ordinal domain (>= 0x80) is reserved for events so a dispatcher that switched on ordinal cannot route the event as a request without crossing that line. Pure leaf. Labels prefixed fsc_ov_.",
      block: {
        cmp rdi, 1;
        jb  fsc_ov_no;
        cmp rdi, 10;
        ja  fsc_ov_no;
        mov rax, 1;
        ret;
      fsc_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // fsc_ev_valid(ev) -> 1 | 0
  //
  // No events today. Every ev is invalid. Symmetric shape with the
  // op_valid validator so a subscriber that switches on ordinal
  // cannot route a request as an event or the reverse.
  // ==========================================================================

  pub let fsc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): 0 for every ev. The fs_channel has no event ordinals today; a MOUNT_LOST or similar addition adds one arm here and one packer below and no other change. Pure leaf. Labels prefixed fsc_ev_ (no colliding sibling in this file's scope).",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // fsc_kind_valid(kind) -> 1 | 0
  //
  // 1 iff kind is in [KIND_REG .. KIND_MAX]. Refuses 0 for the same
  // reason op_valid does.
  // ==========================================================================

  pub let fsc_kind_valid : (u64) -> u64 !{} @{} =
    fn (kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): 1 iff kind is in {REG, DIR, LNK}. Zero is refused (.bss default for an unset kind field on a stat reply). Pure leaf. Labels prefixed fsc_kv_.",
      block: {
        cmp rdi, 1;
        jb  fsc_kv_no;
        cmp rdi, 3;
        ja  fsc_kv_no;
        mov rax, 1;
        ret;
      fsc_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_open_request(path_id, flags) -> u64
  //
  // Schema §3. Pack an OPEN request. Gates:
  //   (1) path_id fits 32 bits
  //   (2) flags fits 8 bits
  // Layout: path_id in [31:0], flags in [39:32]. Reserved [63:40] left
  // zero by construction; any refusal returns FSC_DECODE_BAD.
  //
  // Path is presented as a supervisor-side id (see §3), NOT a raw
  // pointer. Encoding a pointer would let the caller name supervisor
  // memory the derivation lattice never blessed.
  //
  // ARITY TWO, PINNED. A third parameter is how a mode / uid / ceiling
  // would smuggle in; those fields (when the widening adds them) are
  // separate ops with their own packers.
  // ==========================================================================

  pub let fsc_pack_open_request : (u64, u64) -> u64 !{} @{} =
    fn (path_id: u64, flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack OPEN request {path_id[31:0], flags[39:32]}. Refuses on width violation with FSC_DECODE_BAD -- refuse-not-clamp so a caller with a 33-bit path_id sees the refusal rather than silently landing at the truncated id. The path_id is a supervisor-side interned identifier resolved by a preceding path-resolve step; encoding a pointer here would let the caller name supervisor memory the derivation lattice never blessed. Pure leaf. Labels prefixed fsc_por_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fsc_por_bad;
        mov r10, 0xFF;
        cmp rsi, r10;
        ja  fsc_por_bad;

        mov rax, rdi;                    // path_id in [31:0]
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;                    // flags in [39:32]
        ret;

      fsc_por_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_open_request_path_id : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract path_id from an OPEN request. rax = req & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_orp_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  pub let fsc_open_request_flags : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract flags from an OPEN request. rax = (req >> 32) & 0xFF. Pure leaf. Labels prefixed fsc_orf_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_open_reply(fd) -> u64
  //
  // OPEN reply carries a fresh fd (32-bit domain to allow the
  // supervisor to hand out well past the 16-bit per-caller ceiling
  // in aggregate). Refuses fd > 32 bits.
  // ==========================================================================

  pub let fsc_pack_open_reply : (u64) -> u64 !{} @{} =
    fn (fd: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack OPEN reply {fd[31:0]}. Refuses fd > 32 bits. Reserved [63:32] left zero. Pure leaf. Labels prefixed fsc_pop_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fsc_pop_bad;
        mov rax, rdi;
        ret;
      fsc_pop_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_open_reply_fd : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract fd from OPEN reply. rax = reply & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_ord_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_fd_len(fd, len) -> u64
  //
  // Header used by READ, WRITE, CLOSE, and SYNC requests (CLOSE / SYNC
  // ignore len; the field is zero by convention there). Layout:
  //   fd  in [15:0], 16 bits
  //   len in [47:16], 32 bits
  // Reserved [63:48] left zero. Refuses:
  //   (1) fd > 16 bits    -> BAD_FD (surfaced as DECODE_BAD sentinel)
  //   (2) len > 32 bits   -> BAD_LEN (surfaced as DECODE_BAD sentinel)
  //
  // ARITY TWO. A third `flags` parameter is how mode bits on read or
  // write (like O_NONBLOCK-per-call) would smuggle in; those become
  // additional ops with their own packers when the widening needs
  // them, not a variadic third field on a shared header.
  // ==========================================================================

  pub let fsc_pack_fd_len : (u64, u64) -> u64 !{} @{} =
    fn (fd: u64, len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack {fd[15:0], len[47:16]} for READ/WRITE/CLOSE/SYNC. Refuses width violations with FSC_DECODE_BAD -- refuse-not-clamp so a 17-bit fd (a caller holding more slots than the supervisor bookkeeps) is a visible refusal rather than a 16-bit prefix that names the wrong open slot. Pure leaf. Labels prefixed fsc_pfl_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  fsc_pfl_bad;
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  fsc_pfl_bad;

        mov rax, rdi;                    // fd in [15:0]
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;                    // len in [47:16]
        ret;

      fsc_pfl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_fd_len_fd : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract fd from a packed {fd, len} header. rax = payload & 0xFFFF. Pure leaf. Labels prefixed fsc_flf_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let fsc_fd_len_len : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract len from a packed {fd, len} header. rax = (payload >> 16) & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_fll_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_path(path_id) -> u64
  //
  // Header used by STAT, MKDIR, UNLINK requests (single path_id).
  // Refuses path_id > 32 bits.
  // ==========================================================================

  pub let fsc_pack_path : (u64) -> u64 !{} @{} =
    fn (path_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack {path_id[31:0]} request for STAT / MKDIR / UNLINK. Refuses path_id > 32 bits with FSC_DECODE_BAD. Reserved [63:32] left zero. Pure leaf. Labels prefixed fsc_pp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fsc_pp_bad;
        mov rax, rdi;
        ret;
      fsc_pp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_path_id : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract path_id from a single-path request. rax = req & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_pip_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_two_paths(from_id, to_id) -> u64
  //
  // Header used by SYMLINK (target, linkpath) and RENAME (from, to)
  // requests. Both operands are supervisor-side interned path ids.
  // Layout: from in [31:0], to in [63:32]. Refuses either > 32 bits.
  //
  // ARITY TWO. A third `flags` parameter is how RENAME_EXCHANGE or
  // similar would smuggle in; those become distinct ops when the
  // widening needs them.
  // ==========================================================================

  pub let fsc_pack_two_paths : (u64, u64) -> u64 !{} @{} =
    fn (from_id: u64, to_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack {from_id[31:0], to_id[63:32]} for SYMLINK / RENAME. Refuses either operand > 32 bits with FSC_DECODE_BAD -- a truncated to_id would have RENAME clobber a wrong destination or SYMLINK point at a wrong target. Pure leaf. Labels prefixed fsc_ptp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fsc_ptp_bad;
        cmp rsi, r10;
        ja  fsc_ptp_bad;

        mov rax, rdi;                    // from in [31:0]
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;                    // to in [63:32]
        ret;

      fsc_ptp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_two_paths_from : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract from_id from a two-path request. rax = req & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_tpf_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  pub let fsc_two_paths_to : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract to_id from a two-path request. rax = (req >> 32) & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_tpt_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fsc_pack_stat_reply(kind, size) -> u64
  //
  // Schema §3. Pack STAT reply. Gates:
  //   (1) kind in [1..KIND_MAX]        -> BAD_KIND (via DECODE_BAD)
  //   (2) size fits 32 bits            -> BAD_LEN (via DECODE_BAD)
  // Layout: kind in [7:0], size in [39:8]. Reserved [63:40] left zero.
  // ==========================================================================

  pub let fsc_pack_stat_reply : (u64, u64) -> u64 !{} @{} =
    fn (kind: u64, size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): pack STAT reply {kind[7:0], size[39:8]}. Gates: (1) kind in [1..KIND_MAX] -- zero is refused because it is the .bss default for an unset kind; (2) size fits 32 bits. Reserved [63:40] left zero. Any refusal -> FSC_DECODE_BAD. A future >4GiB size uses a distinct STAT2 op with a wider size field; silently truncating here would let a compositor size a preview buffer for a video file that is actually terabytes long. Pure leaf. Labels prefixed fsc_psr_.",
      block: {
        // kind in [1..3]
        cmp rdi, 1;
        jb  fsc_psr_bad;
        cmp rdi, 3;
        ja  fsc_psr_bad;

        // size fits 32 bits
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  fsc_psr_bad;

        mov rax, rdi;                    // kind in [7:0]
        mov r10, rsi;
        shl r10, 8;
        or  rax, r10;                    // size in [39:8]
        ret;

      fsc_psr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fsc_stat_reply_kind : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract kind from a packed STAT reply. rax = reply & 0xFF. Pure leaf. Labels prefixed fsc_srk_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let fsc_stat_reply_size : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-004 (#1395): extract size from a packed STAT reply. rax = (reply >> 8) & 0xFFFFFFFF. Pure leaf. Labels prefixed fsc_srs_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }
}
