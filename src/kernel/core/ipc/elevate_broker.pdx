// src/kernel/core/ipc/elevate_broker.pdx -- R48b substrate-prep (#1627)
//
// svc.elevate-broker registration seam.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This module lands the KERNEL-SIDE SEAM only:
//
//   * Declares the canonical name string "svc.elevate-broker".
//   * Exposes elevate_broker_register(endpoint_id) which allocates a
//     fresh entry in the R20b service registry (_svc_broker_table via
//     svc_register) so that any process holding svc_lookup authority
//     can resolve the broker's endpoint id from the well-known name.
//   * Exposes a stub RPC dispatch entry elevate_broker_dispatch that
//     recognises the wire ops defined in ipc/elevate_channel.pdx
//     (ELV_OP_REQ / ELV_OP_APR / ELV_OP_EXP) and, at substrate-prep
//     time, returns ELVB_DISPATCH_STUB for every op.  A future round
//     (libpdx-elevate.M2, per design/tooling/r49-r50-plan.md §5) lands
//     the userspace daemon body that consumes these ops.
//   * Maintains _elevate_broker_stats so the boot witness + a future
//     supervisor can count register attempts, dispatch invocations,
//     and stub returns without a second writer of the counter table.
//
// It DOES NOT land the full daemon body (queue management, approver
// selection, timer-driven expiry, cascade revoke of granted rows).
// That is the libpdx-elevate.M2 milestone.
//
// The seam is what unblocks libpdx-elevate.M1: the name lookup path
// must resolve to a live endpoint before any client library can be
// coded against it.
//
// =============================================================================
// RATIONALE FOR A DISTINCT MODULE
// =============================================================================
//
// One could argue the register call should live inline in a broader
// "svc-name-reservation" module.  It does not, for the same reason the
// per-channel schema modules (elevate_channel.pdx, user_lifecycle_
// channel.pdx) sit as siblings rather than concatenated: the counter
// table + stub dispatch belong with the name registration, and
// tools/build.sh confines _elevate_broker_stats to this .o file so no
// stray writer of the counters can drift the record of what the broker
// has done.

module ElevateBroker = structure {

  // The canonical name.  20 bytes = "svc.elevate-broker" + NUL + pad.
  pub let elevate_broker_name : [u8; 20] = "svc.elevate-broker\0\0"
  pub let ELEVATE_BROKER_NAME_LEN : u64 = 18   // strlen of "svc.elevate-broker"

  // R48-PREP-005.M1 (design/services/svc-elevate-broker-registration.md
  // §3.1): the well-known endpoint id band. 16 sits above every
  // currently-declared supervisor id (echo_server=1, acpi_supervisor=3,
  // audio_supervisor=5) and well within ENDPOINT_TABLE_SLOTS=128. 17 is
  // reserved adjacent for the #1628 svc.audit-journal twin fix (not
  // landed by this module).
  pub let ELEVATE_BROKER_ENDPOINT_ID       : u64 = 16
  pub let AUDIT_JOURNAL_BROKER_ENDPOINT_ID : u64 = 17

  // Return codes for the seam.
  pub let ELVB_OK                : u64 = 0
  pub let ELVB_REGISTER_BAD_ID   : u64 = 0xFFFFEBFF
  pub let ELVB_REGISTER_DUP      : u64 = 0xFFFFEBFE
  pub let ELVB_REGISTER_FULL     : u64 = 0xFFFFEBFD
  pub let ELVB_REGISTER_BAD_NAME : u64 = 0xFFFFEBFC
  pub let ELVB_DISPATCH_STUB     : u64 = 0xFFFFEBFB   // op recognised, body TBD
  pub let ELVB_DISPATCH_BAD_OP   : u64 = 0xFFFFEBFA
  pub let ELVB_BRINGUP_EP_FAIL   : u64 = 0xFFFFEBF9   // endpoint_alloc_at refused

  pub let mut _elevate_broker_stats : [u64; 8] = uninit @align(64)

  pub let ELVB_ST_REGISTERS : u64 = 0    // successful registrations
  pub let ELVB_ST_REG_FAIL  : u64 = 1    // refused registrations
  pub let ELVB_ST_DISPATCH  : u64 = 2    // recognised-op dispatches (stub returns)
  pub let ELVB_ST_BAD_OP    : u64 = 3    // dispatch on unknown op
  pub let ELVB_ST_MAX       : u64 = 8

  pub let elevate_broker_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1627): clear the eight-word counter table. Boot and teardown only. Labels prefixed elvb_rs_.",
      block: {
        lea r10, [rip + _elevate_broker_stats];
        xor rax, rax;
        xor rcx, rcx;
      elvb_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  elvb_rs_loop;
        ret
      }
    }

  pub let elevate_broker_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1627): bounded increment; out-of-range no-op. Labels prefixed elvb_nt_.",
      block: {
        cmp rdi, 8;
        jae elvb_nt_out;
        lea r10, [rip + _elevate_broker_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      elvb_nt_out:
        ret
      }
    }

  pub let elevate_broker_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1627): bounded read; out-of-range returns 0. Labels prefixed elvb_st_.",
      block: {
        cmp rdi, 8;
        jae elvb_st_zero;
        lea r10, [rip + _elevate_broker_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      elvb_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_broker_register(endpoint_id) -> ELVB_OK | ELVB_REGISTER_*
  //
  // Wraps svc_register with the canonical name.  The wrap exists so
  // no other file needs to know the string literal -- and if the name
  // ever changes, exactly one edit here suffices.
  // ==========================================================================

  pub let elevate_broker_register : (u64) -> u64 !{mem} @{} =
    fn (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1627): call svc_register with the canonical (name_ptr, name_len, endpoint_id) triple for the elevate broker.  Translates svc_register's small-int return codes into the ELVB_* band so a caller can distinguish 'the broker slot in the registry is taken' from 'the endpoint id is bad' by inspecting the return alone.  Bumps ELVB_ST_REGISTERS or ELVB_ST_REG_FAIL depending on outcome.  Two callee-save pushes leave rsp%16 == 0 for the nested call.  Labels prefixed elvb_reg_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // endpoint_id
        // Trivial arg-bound check: endpoint_id must fit u16 or be 0
        // (id 0 is a live id and legal; caller supplies the id from
        // endpoint_alloc).
        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  elvb_reg_bad_id;

        lea rdi, [rip + elevate_broker_name];
        mov rsi, 18;                     // ELEVATE_BROKER_NAME_LEN
        mov rdx, r12;
        call svc_register;
        mov r13, rax;

        // Translate svc_register codes: 0 OK, 1 NAME_LEN, 2 DUP, 3 FULL.
        cmp r13, 0;
        je  elvb_reg_ok;
        cmp r13, 1;
        je  elvb_reg_bad_name;
        cmp r13, 2;
        je  elvb_reg_dup;
        cmp r13, 3;
        je  elvb_reg_full;
        // Unknown code -- treat as a fail; do not bucket into OK.
        jmp elvb_reg_bad_name;

      elvb_reg_ok:
        mov rdi, 0;                      // ELVB_ST_REGISTERS
        call elevate_broker_note;
        xor rax, rax;                    // ELVB_OK
        jmp elvb_reg_out;

      elvb_reg_bad_id:
        mov rax, 0xFFFFEBFF;
        jmp elvb_reg_fail;
      elvb_reg_dup:
        mov rax, 0xFFFFEBFE;
        jmp elvb_reg_fail;
      elvb_reg_full:
        mov rax, 0xFFFFEBFD;
        jmp elvb_reg_fail;
      elvb_reg_bad_name:
        mov rax, 0xFFFFEBFC;

      elvb_reg_fail:
        push rax;
        mov rdi, 1;                      // ELVB_ST_REG_FAIL
        call elevate_broker_note;
        pop rax;

      elvb_reg_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_broker_bringup() -> ELVB_OK | ELVB_REGISTER_* | ELVB_BRINGUP_EP_FAIL
  //                                              R48-PREP-005.M1
  //
  // Composes endpoint_alloc_at(ELEVATE_BROKER_ENDPOINT_ID) with
  // elevate_broker_register(ELEVATE_BROKER_ENDPOINT_ID): claims the
  // well-known endpoint row first, and only calls elevate_broker_register
  // if the claim succeeds. Called once from kernel_main, before the R30
  // platform witness block runs elevate_broker_witness_call, so the
  // registry row is live before any witness or (future) userspace lookup.
  // ==========================================================================

  pub let elevate_broker_bringup : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48-PREP-005.M1 (design/services/svc-elevate-broker-registration.md): kernel-side bringup for the svc.elevate-broker seam. Claims ENDPOINT_ID=16 via endpoint_alloc_at first; on refusal (EP_ALLOC_AT_BAD_ID or EP_ALLOC_AT_IN_USE, both non-zero) bails with ELVB_BRINGUP_EP_FAIL WITHOUT calling elevate_broker_register, so the registry table never publishes a name against an endpoint id this bringup did not actually claim (mirrors the 'do not partially install the row' requirement in the design doc's M1 scope). On a successful claim, calls elevate_broker_register(16) and returns its ELVB_* translation directly. One callee-save push (r12): both callees take their single argument in rdi and return in rax, so no value needs to survive across the call boundary -- the push exists purely to correct entry parity rsp%16==8 down to 0 for the two sibling (non-nested) calls, the same single-push idiom elevate_broker_dispatch below uses ahead of its own nested call. Labels prefixed elvbb_.",
      block: {
        push r12;

        mov rdi, 16;                     // ELEVATE_BROKER_ENDPOINT_ID
        call endpoint_alloc_at;
        cmp rax, 0;                      // EP_ALLOC_AT_OK
        jne elvbb_ep_fail;

        mov rdi, 16;                     // ELEVATE_BROKER_ENDPOINT_ID
        call elevate_broker_register;
        jmp elvbb_out;

      elvbb_ep_fail:
        mov rax, 0xFFFFEBF9;             // ELVB_BRINGUP_EP_FAIL

      elvbb_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_broker_dispatch(op, arg) -> ELVB_DISPATCH_STUB | ELVB_DISPATCH_BAD_OP
  //
  // Stub RPC entry.  op is one of the three ELV_OP_* values from
  // ipc/elevate_channel.pdx (REQ=1, APR=2, EXP=3).  For substrate-prep
  // every recognised op returns ELVB_DISPATCH_STUB.  The daemon body
  // arrives at libpdx-elevate.M2.
  // ==========================================================================

  pub let elevate_broker_dispatch : (u64, u64) -> u64 !{mem} @{} =
    fn (op: u64) (arg: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1627): stub dispatch.  Recognises ELV_OP_REQ / ELV_OP_APR / ELV_OP_EXP (values 1..3 per ipc/elevate_channel.pdx §1) and returns ELVB_DISPATCH_STUB; every other op returns ELVB_DISPATCH_BAD_OP.  ELVB_ST_DISPATCH bumps on a recognised op, ELVB_ST_BAD_OP on an unrecognised one.  The two counters staying separate is what lets the boot witness prove the seam wires up without the daemon needing to exist.  R90-XREPO.011.M1-003 (#2122) note: this stub stays byte-for-byte unchanged so tests/kernel/ipc/elevate_broker_synth.pdx and tests/kernel/ipc/elevate_broker_roundtrip_synth.pdx (both explicitly assert ELVB_DISPATCH_STUB as the return value) keep working; the real policy-consulting body lands as the SIBLING entrypoint elevate_broker_serve_one below.  Labels prefixed elvb_dp_.",
      block: {
        push r12;

        mov r12, rdi;                    // op
        cmp r12, 1;
        jb  elvb_dp_bad_op;
        mov r10, 3;
        cmp r12, r10;
        ja  elvb_dp_bad_op;

        mov rdi, 2;                      // ELVB_ST_DISPATCH
        call elevate_broker_note;
        mov rax, 0xFFFFEBFB;             // ELVB_DISPATCH_STUB
        jmp elvb_dp_out;

      elvb_dp_bad_op:
        mov rdi, 3;                      // ELVB_ST_BAD_OP
        call elevate_broker_note;
        mov rax, 0xFFFFEBFA;             // ELVB_DISPATCH_BAD_OP

      elvb_dp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // R90-XREPO.011.M1-003 (paideia-os #2122): the REAL broker dispatch body.
  // ==========================================================================
  //
  // Consumes a single KIND_ELEVATE_CHANNEL row (already minted by the
  // requester -- state == ELVC_STATE_REQUESTED -- via cap_handler_elevate_
  // channel's mint path), resolves the requester's role from the row's
  // requester_pid, opens /system/policy from tmpfs, evaluates the seeded
  // rule table top-to-bottom / first-match-wins, stamps a
  // ELVB_DEFAULT_EXPIRE_NS deadline on the row so the client can
  // distinguish a broker verdict from a request that never got serviced,
  // rewrites the row's state byte to ELVC_STATE_APPROVED (2) or
  // ELVC_STATE_DENIED (3), and emits an `elevate broker allow|deny ok`
  // fingerprint carrying pid + row for the boot log / audit consumer.
  //
  // No `sched_wait` here.
  //   The parent-issue text names sched_wait(SCHED_WAIT_ELEVATE_CHANNEL_
  //   RX=1, channel_ptr) as the block-on-request step of a full daemon
  //   loop, but this landing keeps serve_one an unconditional-work leaf:
  //   the boot witness synthesises a request row and calls serve_one
  //   directly, and calling sched_wait under -smp 1 with no other task
  //   able to publish sched_wake_kind(1, ...) would deadlock the witness
  //   (see design/security/elevate-broker.md §3 for the composed daemon
  //   shape that adds the wait back in ahead of every serve_one call).
  //
  // Fail-closed I/O.
  //   Every path that fails to read /system/policy (missing /system
  //   directory, missing policy file, tmpfs_read sentinel) short-circuits
  //   to ELVC_STATE_DENIED per design/security/elevate-policy-format.md
  //   §3 -- an unreadable policy file MUST default-deny rather than
  //   quietly waive the seeded posture.
  //
  // Target-path handling.
  //   v1 does NOT carry a target path in the KIND_ELEVATE_CHANNEL row
  //   layout (kind_elevate_channel.pdx §1 lists only request_id, pid,
  //   target_cap_rights, expire_ns, broker_endpoint_id in +8..+40).
  //   Every request is therefore evaluated as if its target lay under
  //   "/system/" for the policy-match's prefix arm -- the sole prefix
  //   that discriminates INIT-allow from *-deny under the seeded default
  //   (rules for /home/, /tmp/, /var/ never fire because "/system/" is
  //   not a byte-prefix of those). Widening the row to carry a real
  //   target-path handle is a v2 concern tracked in design/security/
  //   elevate-broker.md §4.
  //
  // Role-class handling (v1).
  //   INIT -> row's requester_pid == 1. * -> matches any pid. ADMIN and
  //   OWNER are lexed successfully but never match (documented as no-op
  //   under design/security/elevate-policy-format.md §2.2 until the
  //   corresponding users milestone lands). DENY_UNLESS_ROLE is a
  //   lexed-and-skipped no-op per that same spec §2.3.
  //
  // Register discipline.
  //   6-push callee-save prologue (rbx, r12, r13, r14, r15, rbp) + sub
  //   rsp, 8 lands rsp%16==0 for every nested call. Entry rsp%16==8; 6
  //   pushes = 48 bytes, (8+48)%16 == 8; sub 8 -> 0. rbx/r12/r13/r15/rbp
  //   all live across the parse loop; r14 is repurposed twice (Phase 1:
  //   inode-idx scratch; Phase 2: parser byte cursor 0..len). Not reused:
  //   r15 for len during parse and for decision after parse (Phase 3);
  //   the parse loop's last read of r15==len is before the decision is
  //   stamped so no aliasing.
  //
  //   Phase 1: r12=row_id, r13=pid (once loaded), r14=inode-idx scratch,
  //            r15=bytes_read (from tmpfs_read).
  //   Phase 2: rbx=&_elvb_policy_buf, r12=row_id (untouched), r13=pid,
  //            r14=pos (0..len), r15=len, rbp=field_start.
  //   Phase 3: r12=row_id, r13=pid, r15=decision (overwrites len,
  //            len no longer needed).
  //
  // Encoder discipline.
  //   Every constant fits either imm32 (0, 1, 2, 3, 4, 5, 8, 16, 32, 256,
  //   0x20/0x09/0x0A/0x23/0x2A/'/'/etc byte codes) OR imm64-into-r10/r11
  //   (0xFFFFFFFFFFFFFFFF sentinel, 60000000000 default-expire). No add
  //   reg,[mem]. mov_b for every byte load, xor-clear-then-mov_b for
  //   zero-extended loads matching tmpfs_lookup.pdx §75's own pattern.
  //   `not r11` (kind_bt_adapter.pdx §783 precedent) unused here since
  //   elevate_channel_row_set_state owns the state-slice write.
  //
  // Effects/capabilities.
  //   {mem, sysreg} @{fs}: mem covers every _elvb_policy_buf write, every
  //   TCB / row field read/write; sysreg is transitive from klog_s1_d2's
  //   TSC read; @{fs} is the tmpfs_read / tmpfs_lookup capability domain
  //   (they themselves declare @{}, so this is a coarser upward-declaration
  //   at the broker seam so a future audit that widens tmpfs_lookup /
  //   tmpfs_read to require @{fs} lands without changing this signature).
  //   Actually kept as @{} since the two callees stay @{} today; upgrade
  //   in lockstep if that changes.

  // Small scratch buffer sized to hold /system/policy verbatim plus slop.
  // The v1 seeded default is 173 bytes (rootfs_seed_policy.pdx §5), a
  // future v2 header + a couple of extra rules will still fit under 256.
  // A single tmpfs_read pass suffices (design constraint per
  // /system/policy grammar §4: the file must stay within one tmpfs page,
  // which is 4 KiB -- our 256-byte buffer is a much tighter cap).
  pub let mut _elvb_policy_buf : [u8; 256] = uninit @align(64)

  // Fixed lookups: the "system" directory under root and the "policy"
  // file under "system". NUL-terminated for tmpfs_lookup (see
  // rootfs_seed_policy.pdx §policy_name_system / _policy).
  pub let elvb_name_system : [u8; 7] = "system\0"
  pub let elvb_name_policy : [u8; 7] = "policy\0"

  // v1 target-path proxy: every elevation request is evaluated as if its
  // target lay under "/system/" (see §Target-path handling above). 8
  // bytes on the wire, no NUL because prefix compare is length-bound.
  pub let elvb_target_default : [u8; 8] = "/system/"
  pub let ELVB_TARGET_DEFAULT_LEN : u64 = 8

  // Role-class literals. Byte-compared against a rule's role field.
  //   INIT matches when pid == 1; * matches any pid. ADMIN/OWNER lex
  //   successfully but no v1 code path returns match=true for them --
  //   documented in design/security/elevate-policy-format.md §2.2.
  pub let elvb_role_init : [u8; 4] = "INIT"

  // Action literals. ALLOW -> APPROVED, DENY -> DENIED,
  // DENY_UNLESS_ROLE -> no-op (skipped, continue). The v1 lexer accepts
  // all three; unknown-action lines are also skipped (defensive: a
  // policy file with a future v2 action degrades to no-op rather than
  // fail-closed at parse time).
  pub let elvb_act_allow      : [u8; 5]  = "ALLOW"
  pub let elvb_act_deny       : [u8; 4]  = "DENY"
  pub let ELVB_POLICY_BUF_CAP : u64 = 256

  // Default expiry deadline stamped on every serviced row (60 s in ns).
  // Chosen to match ipc/elevate_channel.pdx §75 ELV_DUR_MIN_NS (1 s) /
  // ELV_DUR_MAX_NS (1 h) range with a comfortable midpoint. The reaper
  // that treats expire_ns as authoritative is #2118's future consumer;
  // v1 broker simply stamps the value so the client can distinguish a
  // real verdict from a timeout.
  pub let ELVB_DEFAULT_EXPIRE_NS : u64 = 60000000000

  // Decision constants alias ELVC_STATE_APPROVED/DENIED from
  // kind_elevate_channel.pdx §Section 1 (2 / 3). Named at this seam so a
  // caller can read `mov rax, ELVB_DECISION_ALLOW` without pulling in
  // the whole KindElevateChannel module.
  pub let ELVB_DECISION_ALLOW : u64 = 2
  pub let ELVB_DECISION_DENY  : u64 = 3

  pub let elevate_broker_serve_one : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R90-XREPO.011.M1-003 (paideia-os #2122): the real broker dispatch body. Consumes one KIND_ELEVATE_CHANNEL row already in state ELVC_STATE_REQUESTED, resolves the requester's role from its requester_pid (v1: INIT iff pid==1, else *; ADMIN/OWNER never match -- see design/security/elevate-policy-format.md §2.2), reads /system/policy from tmpfs via tmpfs_lookup(1,'system') -> tmpfs_lookup(system,'policy') -> tmpfs_read(policy,buf,256,0), parses the file line-by-line first-match-wins per §2 grammar (comment, blank, rule with three space/tab-separated fields path-prefix/role-class/action), stamps ELVB_DEFAULT_EXPIRE_NS (60 s) onto the row via elevate_channel_row_set_expire, rewrites the state slice via elevate_channel_row_set_state to APPROVED (2) or DENIED (3), and emits `elevate broker allow ok` / `elevate broker deny ok` via klog_s1_d2 with k_pid + k_row so an audit consumer can pin the verdict against the requester. Any I/O failure (missing /system, missing policy, tmpfs_read sentinel) short-circuits to ELVC_STATE_DENIED per §3 fail-closed. Target-path handling: v1 treats every request as if its target lay under `/system/` (the KIND_ELEVATE_CHANNEL row layout §1 carries no target path today; widening to a real handle is v2, see design/security/elevate-broker.md §4) -- this makes the seeded `/system/  INIT  ALLOW` and `/system/  *  DENY` rules the discriminating pair, and /home /tmp /var never match because `/system/` is not a byte-prefix of any of them. Role-class semantics: buf[role_start..role_end] byte-compared against 'INIT' (require pid==1) or '*' (match any); anything else falls through to the next line (harmless). Action semantics: 'ALLOW' (5 bytes) -> APPROVED, 'DENY' (4 bytes) -> DENIED, 'DENY_UNLESS_ROLE' (16 bytes) and any unknown token -> skipped (no-op). No sched_wait here -- the parent-issue text names sched_wait(SCHED_WAIT_ELEVATE_CHANNEL_RX=1, channel_ptr) as the block-on-request step of a full daemon loop, but under -smp 1 with no other task publishing sched_wake_kind(1, ...) the witness would deadlock; design/security/elevate-broker.md §3 documents the composed daemon shape that puts the wait ahead of every serve_one call. Register discipline: 6-push callee-save prologue (rbx, r12, r13, r14, r15, rbp) + sub rsp, 8 lands rsp%16==0 for every nested call (entry %16==8; 6 pushes = 48, (8+48)%16 == 8; sub 8 -> 0). Phase 1: r12=row_id, r13=pid, r14=inode-idx scratch, r15=bytes_read. Phase 2: rbx=&_elvb_policy_buf, r12=row_id (untouched), r13=pid, r14=pos, r15=len, rbp=field_start. Phase 3: r12=row_id, r13=pid, r15=decision (overwrites len, len dead after parse exit). Encoder-conservative: every immediate fits imm32 except 0xFFFFFFFFFFFFFFFF (staged in r11) and ELVB_DEFAULT_EXPIRE_NS=60000000000 (staged in rsi via imm64 mov). Every byte load via xor-clear + mov_b. No add reg,[mem]. Effects {mem, sysreg} @{}: mem for every _elvb_policy_buf/row/TCB touch; sysreg transitive from klog_s1_d2's TSC read; @{} matches tmpfs_lookup/tmpfs_read/elevate_channel_row_set_expire/elevate_channel_row_set_state and Klog wrappers today. Labels prefixed elvb_svc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                          // r12 = row_id (invariant across all phases)

        // ==================================================================
        // Phase 1: fetch pid and load /system/policy into _elvb_policy_buf.
        // ==================================================================

        mov rdi, r12;
        call elevate_channel_row_pid;
        // 0xFFFFFFFFFFFFFFFF on bad slot; any other value is a valid pid.
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  elvb_svc_deny_io;
        mov r13, rax;                          // r13 = pid (invariant across parse)

        // tmpfs_lookup(1, "system") -> system_inode_idx.
        mov rdi, 1;
        lea rsi, [rip + elvb_name_system];
        call tmpfs_lookup;
        cmp rax, 0;
        je  elvb_svc_deny_io;
        mov r14, rax;                          // r14 = system_inode_idx

        // tmpfs_lookup(system_inode_idx, "policy") -> policy_inode_idx.
        mov rdi, r14;
        lea rsi, [rip + elvb_name_policy];
        call tmpfs_lookup;
        cmp rax, 0;
        je  elvb_svc_deny_io;
        mov r14, rax;                          // r14 = policy_inode_idx

        // tmpfs_read(policy_inode_idx, &_elvb_policy_buf, 256, 0).
        mov rdi, r14;
        lea rsi, [rip + _elvb_policy_buf];
        mov rdx, 256;                          // ELVB_POLICY_BUF_CAP
        xor rcx, rcx;                          // offset = 0
        call tmpfs_read;
        mov r11, 0xFFFFFFFFFFFFFFFF;           // VOPS_ERR_SENTINEL
        cmp rax, r11;
        je  elvb_svc_deny_io;
        mov r15, rax;                          // r15 = bytes_read (len for Phase 2)

        // ==================================================================
        // Phase 2: line-by-line parse, first-match wins.
        // ==================================================================

        lea rbx, [rip + _elvb_policy_buf];     // rbx = buf base (invariant)
        xor r14, r14;                          // r14 = pos = 0

      elvb_svc_line:
        cmp r14, r15;
        jae elvb_svc_fall_deny;                // end of buffer -> DENY fall-through

        // Skip leading WS.
      elvb_svc_ws1:
        cmp r14, r15;
        jae elvb_svc_fall_deny;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;                         // ' '
        je  elvb_svc_ws1_bump;
        cmp rax, 0x09;                         // '\t'
        je  elvb_svc_ws1_bump;
        jmp elvb_svc_check_first;
      elvb_svc_ws1_bump:
        add r14, 1;
        jmp elvb_svc_ws1;

      elvb_svc_check_first:
        cmp rax, 0x23;                         // '#'
        je  elvb_svc_skip_nl;
        cmp rax, 0x0A;                         // '\n'
        je  elvb_svc_advance_nl;

        // === Field 1: path-prefix. Start position saved in rbp. ===
        mov rbp, r14;
      elvb_svc_f1:
        cmp r14, r15;
        jae elvb_svc_f1_end;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;
        je  elvb_svc_f1_end;
        cmp rax, 0x09;
        je  elvb_svc_f1_end;
        cmp rax, 0x0A;
        je  elvb_svc_f1_end;
        add r14, 1;
        jmp elvb_svc_f1;
      elvb_svc_f1_end:
        // Does target "/system/" start with buf[rbp..r14]? Compute
        // prefix_len; refuse if > 8. Then per-byte compare.
        mov rcx, r14;
        sub rcx, rbp;                          // rcx = prefix_len
        cmp rcx, 8;                            // ELVB_TARGET_DEFAULT_LEN
        ja  elvb_svc_skip_nl;                  // longer than target -> cannot be a prefix

        xor r10, r10;                          // r10 = i
      elvb_svc_pf_cmp:
        cmp r10, rcx;
        jae elvb_svc_pf_match;
        // target[i]
        xor rax, rax;
        lea r11, [rip + elvb_target_default];
        add r11, r10;
        mov_b rax, [r11 + 0];
        // buf[rbp + i]
        xor rdx, rdx;
        mov r11, rbx;
        add r11, rbp;
        add r11, r10;
        mov_b rdx, [r11 + 0];
        cmp rax, rdx;
        jne elvb_svc_skip_nl;
        add r10, 1;
        jmp elvb_svc_pf_cmp;

      elvb_svc_pf_match:
        // === Field 2: role-class. ===
        // Skip WS after prefix.
      elvb_svc_ws2:
        cmp r14, r15;
        jae elvb_svc_skip_nl;                  // malformed rule -> skip
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;
        je  elvb_svc_ws2_bump;
        cmp rax, 0x09;
        je  elvb_svc_ws2_bump;
        cmp rax, 0x0A;                         // newline before role -> malformed
        je  elvb_svc_advance_nl;
        jmp elvb_svc_role_start;
      elvb_svc_ws2_bump:
        add r14, 1;
        jmp elvb_svc_ws2;

      elvb_svc_role_start:
        mov rbp, r14;                          // rbp = role_start (rewrites prefix_start)
      elvb_svc_f2:
        cmp r14, r15;
        jae elvb_svc_f2_end;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;
        je  elvb_svc_f2_end;
        cmp rax, 0x09;
        je  elvb_svc_f2_end;
        cmp rax, 0x0A;
        je  elvb_svc_f2_end;
        add r14, 1;
        jmp elvb_svc_f2;
      elvb_svc_f2_end:
        mov rcx, r14;
        sub rcx, rbp;                          // rcx = role_len

        // Role "*" (1 byte, buf[rbp] == '*') matches any pid.
        cmp rcx, 1;
        jne elvb_svc_role_try_init;
        xor rax, rax;
        mov r11, rbx;
        add r11, rbp;
        mov_b rax, [r11 + 0];
        cmp rax, 0x2A;                         // '*'
        jne elvb_svc_skip_nl;
        jmp elvb_svc_role_match;

      elvb_svc_role_try_init:
        // Role "INIT" (4 bytes) requires pid == 1.
        cmp rcx, 4;
        jne elvb_svc_skip_nl;
        xor r10, r10;
      elvb_svc_role_init_cmp:
        cmp r10, 4;
        jae elvb_svc_role_init_ok;
        xor rax, rax;
        lea r11, [rip + elvb_role_init];
        add r11, r10;
        mov_b rax, [r11 + 0];
        xor rdx, rdx;
        mov r11, rbx;
        add r11, rbp;
        add r11, r10;
        mov_b rdx, [r11 + 0];
        cmp rax, rdx;
        jne elvb_svc_skip_nl;
        add r10, 1;
        jmp elvb_svc_role_init_cmp;
      elvb_svc_role_init_ok:
        cmp r13, 1;
        jne elvb_svc_skip_nl;
        // Fall through to role_match.

      elvb_svc_role_match:
        // === Field 3: action. ===
      elvb_svc_ws3:
        cmp r14, r15;
        jae elvb_svc_skip_nl;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;
        je  elvb_svc_ws3_bump;
        cmp rax, 0x09;
        je  elvb_svc_ws3_bump;
        cmp rax, 0x0A;
        je  elvb_svc_advance_nl;
        jmp elvb_svc_act_start;
      elvb_svc_ws3_bump:
        add r14, 1;
        jmp elvb_svc_ws3;

      elvb_svc_act_start:
        mov rbp, r14;                          // rbp = action_start
      elvb_svc_f3:
        cmp r14, r15;
        jae elvb_svc_f3_end;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        cmp rax, 0x20;
        je  elvb_svc_f3_end;
        cmp rax, 0x09;
        je  elvb_svc_f3_end;
        cmp rax, 0x0A;
        je  elvb_svc_f3_end;
        add r14, 1;
        jmp elvb_svc_f3;
      elvb_svc_f3_end:
        mov rcx, r14;
        sub rcx, rbp;                          // rcx = action_len

        // ALLOW: 5 bytes.
        cmp rcx, 5;
        jne elvb_svc_act_try_deny;
        xor r10, r10;
      elvb_svc_act_allow_cmp:
        cmp r10, 5;
        jae elvb_svc_finalize_allow;
        xor rax, rax;
        lea r11, [rip + elvb_act_allow];
        add r11, r10;
        mov_b rax, [r11 + 0];
        xor rdx, rdx;
        mov r11, rbx;
        add r11, rbp;
        add r11, r10;
        mov_b rdx, [r11 + 0];
        cmp rax, rdx;
        jne elvb_svc_skip_nl;
        add r10, 1;
        jmp elvb_svc_act_allow_cmp;

      elvb_svc_act_try_deny:
        // DENY: 4 bytes.
        cmp rcx, 4;
        jne elvb_svc_skip_nl;                  // not ALLOW, not DENY (may be DENY_UNLESS_ROLE etc) -> skip
        xor r10, r10;
      elvb_svc_act_deny_cmp:
        cmp r10, 4;
        jae elvb_svc_finalize_deny;
        xor rax, rax;
        lea r11, [rip + elvb_act_deny];
        add r11, r10;
        mov_b rax, [r11 + 0];
        xor rdx, rdx;
        mov r11, rbx;
        add r11, rbp;
        add r11, r10;
        mov_b rdx, [r11 + 0];
        cmp rax, rdx;
        jne elvb_svc_skip_nl;
        add r10, 1;
        jmp elvb_svc_act_deny_cmp;

        // Line-terminator handling.
      elvb_svc_skip_nl:
        cmp r14, r15;
        jae elvb_svc_fall_deny;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b rax, [r10 + 0];
        add r14, 1;
        cmp rax, 0x0A;
        jne elvb_svc_skip_nl;
        jmp elvb_svc_line;

      elvb_svc_advance_nl:
        add r14, 1;
        jmp elvb_svc_line;

      elvb_svc_deny_io:
      elvb_svc_fall_deny:
        mov r15, 3;                            // ELVB_DECISION_DENY
        jmp elvb_svc_finalize;

      elvb_svc_finalize_allow:
        mov r15, 2;                            // ELVB_DECISION_ALLOW
        jmp elvb_svc_finalize;

      elvb_svc_finalize_deny:
        mov r15, 3;                            // ELVB_DECISION_DENY

        // ==================================================================
        // Phase 3: stamp expire_ns, rewrite state, emit fingerprint.
        // ==================================================================

      elvb_svc_finalize:
        // elevate_channel_row_set_expire(row_id, ELVB_DEFAULT_EXPIRE_NS).
        // ELVB_DEFAULT_EXPIRE_NS = 60_000_000_000 does not fit imm32;
        // stage via imm64 mov (paideia-as supports mov reg, imm64).
        mov rdi, r12;
        mov rsi, 60000000000;
        call elevate_channel_row_set_expire;
        // Return value ignored: a stale-row race would return
        // ELVC_BAD_SLOT, and the state-set below is what surfaces the
        // race to the caller.

        // elevate_channel_row_set_state(row_id, decision).
        mov rdi, r12;
        mov rsi, r15;
        call elevate_channel_row_set_state;
        // Return value ignored (same rationale).

        // Fingerprint: allow -> tag_elvb_allow_ok, deny -> tag_elvb_deny_ok.
        // klog_s1_d2(LEVEL_INFO=3, SUBSYS_IPC_, tag, k_pid, pid, k_row, row_id).
        cmp r15, 2;
        jne elvb_svc_emit_deny;

        // ALLOW emit.
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IPC_];
        lea rdx, [rip + tag_elvb_allow_ok];
        lea rcx, [rip + k_pid];
        mov r8,  r13;                          // pid
        lea r9,  [rip + k_row];
        sub rsp, 8;                            // alignment pad for the 7th arg push
        push r12;                              // 7th arg = row_id
        call klog_s1_d2;
        add rsp, 16;
        jmp elvb_svc_after_emit;

      elvb_svc_emit_deny:
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_IPC_];
        lea rdx, [rip + tag_elvb_deny_ok];
        lea rcx, [rip + k_pid];
        mov r8,  r13;
        lea r9,  [rip + k_row];
        sub rsp, 8;
        push r12;
        call klog_s1_d2;
        add rsp, 16;

      elvb_svc_after_emit:
        // Counter bump: reuse ELVB_ST_DISPATCH slot as the real-dispatch
        // count (mirrors the stub's own bump so the boot witness can
        // distinguish stub calls from real-dispatch calls only via the
        // fingerprint text, not the counter).
        mov rdi, 2;                            // ELVB_ST_DISPATCH
        call elevate_broker_note;

        mov rax, r15;                          // return decision

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
