// src/kernel/core/ipc/wifi_control_channel.pdx — R38.M3-004 (#1301)
//
// Schema of the WiFi control channel: five RPC verbs plus the
// pack/unpack primitives that turn each verb's arguments into one
// u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of an RPC surface, and the packers/unpackers that
// discharge that schema.  It is NOT an endpoint, NOT a transport, and
// NOT a server: no queue lives here, no capability is minted here,
// and NO CALL sends a byte across a process boundary.  Same posture
// as gpu_bo_alloc_channel.pdx.
//
// The five verbs are:
//
//   scan       {vif_slot}                             -> scan_txn_slot
//   connect    {vif_slot, ssid_ref, bss_ref}          -> ok
//   disconnect {vif_slot}                             -> ok
//   set_key    {vif_slot, key_slot}                   -> ok
//   get_stats  {vif_slot}                             -> stats_row
//
// A subscriber that unpacks a field the packer never produced silently
// reads a value from the wrong bit range; tools/build.sh confines the
// packer signatures so a fifth parameter cannot smuggle a caller-
// supplied field.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF VERBS
// =============================================================================
//
// Verb ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x80). A dispatcher that switches on verb cannot accidentally
// route the request as a reply or a reply as the request without
// crossing the 0x80 line.
//
//   WCC_VERB_SCAN       0x80  {vif_slot}
//   WCC_VERB_CONNECT    0x81  {vif_slot, ssid_ref, bss_ref}
//   WCC_VERB_DISCONNECT 0x82  {vif_slot}
//   WCC_VERB_SET_KEY    0x83  {vif_slot, key_slot}
//   WCC_VERB_GET_STATS  0x84  {vif_slot}
//
// CONNECT's ssid and bss are opaque REFERENCES (8-bit tag + 24-bit
// arena offset each) rather than inline strings: SSIDs are up to 32
// bytes and cannot fit alongside a bss and a vif_slot in one u64.
// Real string payloads land in R38.M4 via a payload arena; today the
// packer records only the reference tuple.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// Each payload has reserved upper bits; the packers set them to zero
// and refuse a payload that arrives with them set.  A reserved field
// silently masked is a field a later revision cannot use.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// vif_slot fits in 16 bits (non-zero); key_slot fits in 16 bits
// (non-zero); ssid_ref and bss_ref are u32 arena references (non-zero).
// Anything outside these widths is refused as DECODE_BAD.
//
// vif_slot must be non-zero: 0 is the .bss default for an unset slot
// id and admitting it would let an uninitialised RPC reach the wire.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF440..0xFFFFF44F
// =============================================================================
//
// Sixteen-wide, disjoint from every in-tree band; adjacent used band
// above: KIND_WIFI_SCAN_TXN 0xFFFFF450..5F; adjacent free band below:
// wifi_data_channel 0xFFFFF430..3F.

module WifiControlChannel = structure {

  // §1's verb ordinals.
  pub let WCC_VERB_SCAN       : u64 = 0x80
  pub let WCC_VERB_CONNECT    : u64 = 0x81
  pub let WCC_VERB_DISCONNECT : u64 = 0x82
  pub let WCC_VERB_SET_KEY    : u64 = 0x83
  pub let WCC_VERB_GET_STATS  : u64 = 0x84
  pub let WCC_VERB_MAX        : u64 = 0x84

  // §4's failure taxonomy.
  pub let WCC_OK           : u64 = 0
  pub let WCC_BAD_VERB     : u64 = 0xFFFFF44F
  pub let WCC_BAD_VIF      : u64 = 0xFFFFF44E
  pub let WCC_BAD_SSID     : u64 = 0xFFFFF44D
  pub let WCC_BAD_BSS      : u64 = 0xFFFFF44C
  pub let WCC_BAD_KEY      : u64 = 0xFFFFF44B
  pub let WCC_BAD_RESERVED : u64 = 0xFFFFF44A
  pub let WCC_UNUSED_A     : u64 = 0xFFFFF449
  pub let WCC_UNUSED_B     : u64 = 0xFFFFF448
  pub let WCC_UNUSED_C     : u64 = 0xFFFFF447
  pub let WCC_UNUSED_D     : u64 = 0xFFFFF446
  pub let WCC_UNUSED_E     : u64 = 0xFFFFF445
  pub let WCC_UNUSED_F     : u64 = 0xFFFFF444
  pub let WCC_UNUSED_G     : u64 = 0xFFFFF443
  pub let WCC_UNUSED_H     : u64 = 0xFFFFF442
  pub let WCC_UNUSED_I     : u64 = 0xFFFFF441
  pub let WCC_UNUSED_J     : u64 = 0xFFFFF440

  pub let WCC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // wcc_verb_valid(v) -> 1 | 0
  // ==========================================================================

  pub let wcc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): 1 iff v is one of the five known verbs (0x80..0x84). Constrained to the high half so a dispatcher that switched on ordinal cannot route a verb as a reply. Labels prefixed wcc_vv_.",
      block: {
        cmp rdi, 0x80;
        jb  wcc_vv_no;
        cmp rdi, 0x84;
        ja  wcc_vv_no;
        mov rax, 1;
        ret;
      wcc_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // wcc_pack_scan(vif_slot) -> u64
  //   [15:0]  vif_slot (non-zero)
  //   [63:16] reserved (0)
  // Same shape as DISCONNECT / GET_STATS.
  // ==========================================================================

  pub let wcc_pack_scan : (u64) -> u64 !{} @{} =
    fn (vif_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): pack SCAN request. Gates: vif_slot fits 16 bits and non-zero (BAD_VIF). Labels prefixed wcc_ps_.",
      block: {
        cmp rdi, 0;
        je  wcc_ps_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wcc_ps_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      wcc_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wcc_scan_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract vif_slot from SCAN payload. Labels prefixed wcc_sv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // wcc_pack_connect(vif_slot, ssid_ref, bss_ref) -> u64
  //   [15:0]  vif_slot (non-zero)
  //   [39:16] ssid_ref (24-bit non-zero arena reference)
  //   [63:40] bss_ref  (24-bit non-zero arena reference)
  //
  // Both refs are u24 rather than u32 to fit alongside vif_slot; a
  // future revision may widen the arena but a caller that supplied a
  // ref above 24 bits is refused (BAD_SSID / BAD_BSS) rather than
  // silently truncated.
  // ==========================================================================

  pub let wcc_pack_connect : (u64, u64, u64) -> u64 !{} @{} =
    fn (vif_slot: u64) (ssid_ref: u64) (bss_ref: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): pack CONNECT request. Gates: vif_slot fits 16 bits and non-zero (BAD_VIF); ssid_ref in (0, 2^24) (BAD_SSID); bss_ref in (0, 2^24) (BAD_BSS). Labels prefixed wcc_pc_.",
      block: {
        cmp rdi, 0;
        je  wcc_pc_bad_vif;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wcc_pc_bad_vif;

        cmp rsi, 0;
        je  wcc_pc_bad_ssid;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  wcc_pc_bad_ssid;

        cmp rdx, 0;
        je  wcc_pc_bad_bss;
        mov r10, 0xFFFFFF;
        cmp rdx, r10;
        ja  wcc_pc_bad_bss;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      wcc_pc_bad_vif:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wcc_pc_bad_ssid:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret;
      wcc_pc_bad_bss:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        ret
      }
    }

  pub let wcc_connect_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract vif_slot from CONNECT payload. Labels prefixed wcc_cvif_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let wcc_connect_ssid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract ssid_ref from CONNECT payload. Labels prefixed wcc_cs_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFFFF;
        ret
      }
    }

  pub let wcc_connect_bss : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract bss_ref from CONNECT payload. Labels prefixed wcc_cb_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // wcc_pack_disconnect(vif_slot) -> u64
  // Same shape as SCAN.
  // ==========================================================================

  pub let wcc_pack_disconnect : (u64) -> u64 !{} @{} =
    fn (vif_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): pack DISCONNECT request. Same shape as SCAN. Labels prefixed wcc_pd_.",
      block: {
        cmp rdi, 0;
        je  wcc_pd_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wcc_pd_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      wcc_pd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wcc_disconnect_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract vif_slot from DISCONNECT payload. Labels prefixed wcc_dv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // wcc_pack_set_key(vif_slot, key_slot) -> u64
  //   [15:0]  vif_slot (non-zero)
  //   [31:16] key_slot (non-zero)
  //   [63:32] reserved (0)
  // ==========================================================================

  pub let wcc_pack_set_key : (u64, u64) -> u64 !{} @{} =
    fn (vif_slot: u64) (key_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): pack SET_KEY request. Gates: vif_slot fits 16 bits and non-zero (BAD_VIF); key_slot fits 16 bits and non-zero (BAD_KEY). Labels prefixed wcc_pk_.",
      block: {
        cmp rdi, 0;
        je  wcc_pk_bad_vif;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wcc_pk_bad_vif;

        cmp rsi, 0;
        je  wcc_pk_bad_key;
        cmp rsi, r10;
        ja  wcc_pk_bad_key;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      wcc_pk_bad_vif:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wcc_pk_bad_key:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret
      }
    }

  pub let wcc_set_key_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract vif_slot from SET_KEY payload. Labels prefixed wcc_kvif_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let wcc_set_key_key : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract key_slot from SET_KEY payload. Labels prefixed wcc_kk_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // wcc_pack_get_stats(vif_slot) -> u64
  // Same shape as SCAN / DISCONNECT.
  // ==========================================================================

  pub let wcc_pack_get_stats : (u64) -> u64 !{} @{} =
    fn (vif_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): pack GET_STATS request. Same shape as SCAN. Labels prefixed wcc_pg_.",
      block: {
        cmp rdi, 0;
        je  wcc_pg_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wcc_pg_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      wcc_pg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wcc_get_stats_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-004 (#1301): extract vif_slot from GET_STATS payload. Labels prefixed wcc_gv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }
}
