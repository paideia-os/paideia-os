// src/kernel/core/ipc/bt_hci_channel.pdx — R39.M1-004 (#1326)
//
// Schema of the Bluetooth HCI RPC channel: the session type over which a
// host driver talks to a controller, plus HCI command encoding for the
// canonical M1 command corpus (RESET / READ_LOCAL_VERSION /
// LE_SET_SCAN_ENABLE per BT §7.3, §7.4, §7.8).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCHEMA + FSM of the HCI RPC surface, and the small session
// table backing it.  It is NOT the CNVi transport (that lives in
// drivers/bt/hci_cnvi.pdx) and it is NOT the KIND_BT_HCI_CHANNEL
// capability (kind_bt_hci_channel.pdx).  Consumers hold a chan_slot
// naming a KIND_BT_HCI_CHANNEL and drive this schema against it; the
// schema converts the abstract RPC verbs into HCI packet words and
// hands them to the transport.
//
// The session type (BT §4 + BT §7):
//
//   open  ->  send_cmd*     (host -> controller, opcode + params)
//         ->  recv_evt*     (controller -> host, evt_code + params)
//         ->  close
//
// Legal edges:
//
//   INIT -> OPEN                        (bhc_open)
//   OPEN -> AWAITING_EVT                (bhc_send_cmd)
//   AWAITING_EVT -> OPEN                (bhc_recv_evt)
//   OPEN, AWAITING_EVT -> CLOSED        (bhc_close)
//
// A subscriber that carries a session at AWAITING_EVT MUST NOT be able
// to issue another send_cmd -- the controller has ONE outstanding
// command slot per BT §4.4.  The FSM enforces that at packet time.
//
// =============================================================================
// §1  HCI OPCODE FORMAT (BT §5.4.1)
// =============================================================================
//
// An HCI OpCode is a 16-bit field:
//   OGF (Opcode Group Field) : 6 bits, [15:10]
//   OCF (Opcode Command Field) : 10 bits, [9:0]
//
// Canonical M1 opcodes (BT §7.3, §7.4, §7.8):
//
//   RESET               OGF=0x03 OCF=0x003 -> 0x0C03  (Controller Baseband)
//   READ_LOCAL_VERSION  OGF=0x04 OCF=0x001 -> 0x1001  (Informational)
//   LE_SET_SCAN_ENABLE  OGF=0x08 OCF=0x00C -> 0x200C  (LE Controller)
//
// =============================================================================
// §2  SESSION TABLE
// =============================================================================
//
// _bhc_sessions holds four rows of eight u64s (chan_slot_id, opcode,
// last_evt_code, state, param_word, cmd_count, evt_count, reserved).
// A second bookkeeping site would let one path advance the FSM while
// another read the old state.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF110..0xFFFFF11F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: hci_cnvi transport
// 0xFFFFF120..2F; adjacent free band below: unassigned 0xFFFFF100..0F).

module BtHciChannel = structure {

  // §0 verbs -- HIGH half of the eight-bit domain to keep dispatch
  // signals grep-able.
  pub let BHC_VERB_OPEN     : u64 = 0xA0
  pub let BHC_VERB_SEND_CMD : u64 = 0xA1
  pub let BHC_VERB_RECV_EVT : u64 = 0xA2
  pub let BHC_VERB_CLOSE    : u64 = 0xA3
  pub let BHC_VERB_MAX      : u64 = 0xA3

  // §2 column ordinals.
  pub let BHC_COL_CHAN_SLOT_ID : u64 = 0
  pub let BHC_COL_OPCODE       : u64 = 1
  pub let BHC_COL_LAST_EVT     : u64 = 2
  pub let BHC_COL_STATE        : u64 = 3
  pub let BHC_COL_PARAM_WORD   : u64 = 4
  pub let BHC_COL_CMD_COUNT    : u64 = 5
  pub let BHC_COL_EVT_COUNT    : u64 = 6
  pub let BHC_COL_RESERVED     : u64 = 7

  // §0 session states.
  pub let BHC_STATE_INIT         : u64 = 0
  pub let BHC_STATE_OPEN         : u64 = 1
  pub let BHC_STATE_AWAITING_EVT : u64 = 2
  pub let BHC_STATE_CLOSED       : u64 = 3
  pub let BHC_STATE_MAX          : u64 = 3

  pub let BHC_SESSION_MAX : u64 = 4

  // §1 canonical opcodes.
  pub let BHC_OP_RESET              : u64 = 0x0C03
  pub let BHC_OP_READ_LOCAL_VERSION : u64 = 0x1001
  pub let BHC_OP_LE_SET_SCAN_ENABLE : u64 = 0x200C

  // §3 failure taxonomy 0xFFFFF110..0xFFFFF11F.
  pub let BHC_OK                : u64 = 0
  pub let BHC_BAD_ARG           : u64 = 0xFFFFF11F
  pub let BHC_BAD_VERB          : u64 = 0xFFFFF11E
  pub let BHC_NO_SLOT           : u64 = 0xFFFFF11D
  pub let BHC_IN_USE            : u64 = 0xFFFFF11C
  pub let BHC_NOT_ACTIVE        : u64 = 0xFFFFF11B
  pub let BHC_BAD_STATE         : u64 = 0xFFFFF11A
  pub let BHC_BAD_OPCODE        : u64 = 0xFFFFF119
  pub let BHC_BAD_EVT_CODE      : u64 = 0xFFFFF118
  pub let BHC_ENOSPC            : u64 = 0xFFFFF117
  pub let BHC_BAD_SESSION_SLOT  : u64 = 0xFFFFF116
  pub let BHC_OP_UNSUPPORTED    : u64 = 0xFFFFF115
  pub let BHC_ALREADY_CLOSED    : u64 = 0xFFFFF114
  pub let BHC_BAD_RESERVED      : u64 = 0xFFFFF113
  pub let BHC_UNUSED_A          : u64 = 0xFFFFF112
  pub let BHC_UNUSED_B          : u64 = 0xFFFFF111
  pub let BHC_UNUSED_C          : u64 = 0xFFFFF110

  pub let BHC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // 4 rows x 8 u64 = 32.
  pub let mut _bhc_sessions : [u64; 32] = uninit @align(64)
  pub let mut _bhc_stats    : [u64; 4]  = uninit @align(64)

  // ==========================================================================
  // Verb validator.
  // ==========================================================================

  pub let bhc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-004 (#1326): 1 iff v in {OPEN, SEND_CMD, RECV_EVT, CLOSE}. Labels prefixed bhc_vv_.",
      block: {
        cmp rdi, 0xA0;
        jb  bhc_vv_no;
        cmp rdi, 0xA3;
        ja  bhc_vv_no;
        mov rax, 1;
        ret;
      bhc_vv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bhc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): clear session table + counters. Labels prefixed bhc_rs_.",
      block: {
        lea r10, [rip + _bhc_sessions];
        xor rax, rax;
        xor rcx, rcx;
      bhc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  bhc_rs_rows;

        lea r10, [rip + _bhc_stats];
        xor rcx, rcx;
      bhc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  bhc_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Opcode packer -- (OGF, OCF) -> 16-bit opcode.
  // ==========================================================================

  pub let bhc_opcode_pack : (u64, u64) -> u64 !{} @{} =
    fn (ogf: u64) (ocf: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-004 (#1326): pack OGF (6b) | OCF (10b) into a 16-bit opcode per BT §5.4.1. Refuses OGF > 63 (BAD_OPCODE) or OCF > 1023 (BAD_OPCODE). Labels prefixed bhc_op_.",
      block: {
        cmp rdi, 63;
        ja  bhc_op_bad;
        cmp rsi, 1023;
        ja  bhc_op_bad;

        mov rax, rdi;
        and rax, 0x3F;
        shl rax, 10;
        mov r10, rsi;
        and r10, 0x3FF;
        or  rax, r10;
        ret;
      bhc_op_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let bhc_opcode_ogf : (u64) -> u64 !{} @{} =
    fn (opcode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-004 (#1326): extract OGF (6-bit) from a 16-bit opcode. Labels prefixed bhc_oo_.",
      block: {
        mov rax, rdi;
        shr rax, 10;
        and rax, 0x3F;
        ret
      }
    } @no_frame

  pub let bhc_opcode_ocf : (u64) -> u64 !{} @{} =
    fn (opcode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-004 (#1326): extract OCF (10-bit) from a 16-bit opcode. Labels prefixed bhc_oc_.",
      block: {
        mov rax, rdi;
        and rax, 0x3FF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row pointer.
  // ==========================================================================

  pub let bhc_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): row pointer or 0. Labels prefixed bhc_ra_.",
      block: {
        cmp rdi, 4;
        jae bhc_ra_no;
        lea r10, [rip + _bhc_sessions];
        mov r11, rdi;
        shl r11, 6;                       // 8 u64 * 8 = 64
        add r10, r11;
        mov rax, r10;
        ret;
      bhc_ra_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let bhc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): counter bump. Labels prefixed bhc_nt_.",
      block: {
        cmp rdi, 4;
        jae bhc_nt_out;
        lea r10, [rip + _bhc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bhc_nt_out:
        ret
      }
    } @no_frame

  pub let bhc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): counter read. Labels prefixed bhc_stt_.",
      block: {
        cmp rdi, 4;
        jae bhc_stt_zero;
        lea r10, [rip + _bhc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bhc_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // bhc_open(chan_slot) -> session_id | failure
  // ==========================================================================

  pub let bhc_open : (u64) -> u64 !{mem} @{} =
    fn (chan_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): allocate a session row and stash chan_slot. Refuses chan_slot 0 (BAD_ARG) or table full (ENOSPC). Labels prefixed bhc_o_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;
        cmp r12, 0;
        je  bhc_o_bad;

        xor rbx, rbx;
      bhc_o_scan:
        cmp rbx, 4;
        jae bhc_o_full;
        lea r10, [rip + _bhc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // chan_slot_id column
        cmp rax, 0;
        je  bhc_o_claim;
        add rbx, 1;
        jmp bhc_o_scan;

      bhc_o_claim:
        // chan_slot_id = r12 (non-zero by construction).
        mov [r10 + 0], r12;              // chan_slot_id
        xor rax, rax;
        mov [r10 + 8], rax;              // opcode
        mov [r10 + 16], rax;             // last_evt
        mov rax, 1;                      // state = OPEN
        mov [r10 + 24], rax;
        xor rax, rax;
        mov [r10 + 32], rax;             // param_word
        mov [r10 + 40], rax;             // cmd_count
        mov [r10 + 48], rax;             // evt_count
        mov [r10 + 56], rax;             // reserved

        mov rdi, 0;
        call bhc_note;

        mov rax, rbx;
        jmp bhc_o_out;

      bhc_o_bad:
        mov rax, 0xFFFFF11F;
        jmp bhc_o_out;
      bhc_o_full:
        mov rax, 0xFFFFF117;

      bhc_o_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bhc_send_cmd(session_id, opcode, param_word) -> OK | failure
  //
  // FSM: OPEN -> AWAITING_EVT.
  // ==========================================================================

  pub let bhc_send_cmd : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sid: u64) (opcode: u64) (param_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): validate opcode as u16, require state == OPEN, advance to AWAITING_EVT. Refuses out-of-range opcode (BAD_OPCODE) or wrong-state issue (BAD_STATE). Labels prefixed bhc_s_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 4;
        jae bhc_s_bad_sid;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  bhc_s_bad_op;

        lea r10, [rip + _bhc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bhc_s_notact;

        mov rax, [r10 + 24];             // state
        cmp rax, 1;                      // must be OPEN
        jne bhc_s_bad_state;

        mov [r10 + 8], r13;              // opcode
        mov [r10 + 32], r14;             // param_word
        mov rax, 2;
        mov [r10 + 24], rax;             // state -> AWAITING_EVT

        mov rax, [r10 + 40];             // cmd_count
        add rax, 1;
        mov [r10 + 40], rax;

        mov rdi, 1;
        call bhc_note;

        xor rax, rax;
        jmp bhc_s_out;

      bhc_s_bad_sid:
        mov rax, 0xFFFFF116;
        jmp bhc_s_out;
      bhc_s_bad_op:
        mov rax, 0xFFFFF119;
        jmp bhc_s_out;
      bhc_s_notact:
        mov rax, 0xFFFFF11B;
        jmp bhc_s_out;
      bhc_s_bad_state:
        mov rax, 0xFFFFF11A;

      bhc_s_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bhc_recv_evt(session_id, evt_code) -> OK | failure
  //
  // FSM: AWAITING_EVT -> OPEN.
  // ==========================================================================

  pub let bhc_recv_evt : (u64, u64) -> u64 !{mem} @{} =
    fn (sid: u64) (evt_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): validate evt_code as u8, require state == AWAITING_EVT, advance to OPEN. Refuses out-of-range evt_code (BAD_EVT_CODE) or wrong-state accept (BAD_STATE). Labels prefixed bhc_r_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 4;
        jae bhc_r_bad_sid;

        cmp r13, 255;
        ja  bhc_r_bad_evt;

        lea r10, [rip + _bhc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bhc_r_notact;

        mov rax, [r10 + 24];             // state
        cmp rax, 2;                      // must be AWAITING_EVT
        jne bhc_r_bad_state;

        mov [r10 + 16], r13;             // last_evt
        mov rax, 1;
        mov [r10 + 24], rax;             // state -> OPEN

        mov rax, [r10 + 48];             // evt_count
        add rax, 1;
        mov [r10 + 48], rax;

        mov rdi, 2;
        call bhc_note;

        xor rax, rax;
        jmp bhc_r_out;

      bhc_r_bad_sid:
        mov rax, 0xFFFFF116;
        jmp bhc_r_out;
      bhc_r_bad_evt:
        mov rax, 0xFFFFF118;
        jmp bhc_r_out;
      bhc_r_notact:
        mov rax, 0xFFFFF11B;
        jmp bhc_r_out;
      bhc_r_bad_state:
        mov rax, 0xFFFFF11A;

      bhc_r_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bhc_close(session_id) -> OK | failure
  //
  // FSM: OPEN or AWAITING_EVT -> CLOSED.
  // ==========================================================================

  pub let bhc_close : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): require state in {OPEN, AWAITING_EVT}, advance to CLOSED, zero the session row so the ordinal frees. Refuses repeat close (ALREADY_CLOSED). Labels prefixed bhc_c_.",
      block: {
        push r12;

        mov r12, rdi;
        cmp r12, 4;
        jae bhc_c_bad_sid;

        lea r10, [rip + _bhc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bhc_c_notact;

        mov rax, [r10 + 24];             // state
        cmp rax, 3;                      // already CLOSED
        je  bhc_c_already;
        cmp rax, 1;
        je  bhc_c_apply;
        cmp rax, 2;
        je  bhc_c_apply;
        jmp bhc_c_bad_state;

      bhc_c_apply:
        // Scrub the row so its ordinal frees.
        xor rax, rax;
        mov [r10 + 0], rax;               // chan_slot_id = 0 (empty sentinel)
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov rcx, 3;
        mov [r10 + 24], rcx;              // preserve CLOSED marker briefly
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 3;
        call bhc_note;

        xor rax, rax;
        jmp bhc_c_out;

      bhc_c_bad_sid:
        mov rax, 0xFFFFF116;
        jmp bhc_c_out;
      bhc_c_notact:
        mov rax, 0xFFFFF11B;
        jmp bhc_c_out;
      bhc_c_bad_state:
        mov rax, 0xFFFFF11A;
        jmp bhc_c_out;
      bhc_c_already:
        mov rax, 0xFFFFF114;

      bhc_c_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Query helpers.
  // ==========================================================================

  pub let bhc_state_of : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): sid -> state ordinal or BAD_ARG. Labels prefixed bhc_so_.",
      block: {
        cmp rdi, 4;
        jae bhc_so_bad;
        lea r10, [rip + _bhc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bhc_so_notact;
        mov rax, [r10 + 24];
        ret;
      bhc_so_notact:
        mov rax, 0xFFFFF11B;
        ret;
      bhc_so_bad:
        mov rax, 0xFFFFF11F;
        ret
      }
    } @no_frame

  pub let bhc_opcode_of : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): sid -> last opcode issued or BAD_ARG. Labels prefixed bhc_oq_.",
      block: {
        cmp rdi, 4;
        jae bhc_oq_bad;
        lea r10, [rip + _bhc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bhc_oq_notact;
        mov rax, [r10 + 8];
        ret;
      bhc_oq_notact:
        mov rax, 0xFFFFF11B;
        ret;
      bhc_oq_bad:
        mov rax, 0xFFFFF11F;
        ret
      }
    } @no_frame

  pub let bhc_last_evt : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-004 (#1326): sid -> last evt_code received or BAD_ARG. Labels prefixed bhc_le_.",
      block: {
        cmp rdi, 4;
        jae bhc_le_bad;
        lea r10, [rip + _bhc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bhc_le_notact;
        mov rax, [r10 + 16];
        ret;
      bhc_le_notact:
        mov rax, 0xFFFFF11B;
        ret;
      bhc_le_bad:
        mov rax, 0xFFFFF11F;
        ret
      }
    } @no_frame
}
