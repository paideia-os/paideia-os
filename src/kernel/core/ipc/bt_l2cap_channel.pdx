// src/kernel/core/ipc/bt_l2cap_channel.pdx — R39.M2-004 (#1330)
//
// Schema of the Bluetooth L2CAP RPC channel: the session type over which
// a profile subscriber talks to a live L2CAP dynamic channel, plus the
// small session table backing it.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCHEMA + FSM of the L2CAP RPC surface, and the small session
// table backing it.  It is NOT the L2CAP dynamic channel machinery
// (drivers/bt/l2cap_dyn.pdx) and it is NOT the KIND_BT_L2CAP_CHANNEL
// capability (cap/kind_bt_l2cap_channel.pdx).  A subscriber holds a
// chan_slot naming a KIND_BT_L2CAP_CHANNEL and drives this schema
// against it; the schema converts the abstract RPC verbs into
// per-channel state advances against the dynamic machinery.
//
// The session type (BT §3.4):
//
//   connect(psm, mtu) ->  send(len)*      (host -> peer, one K-frame per credit)
//                     ->  recv(len)*      (peer -> host)
//                     ->  disconnect
//
// Legal edges:
//
//   INIT -> OPEN                            (bl2c_connect)
//   OPEN -> OPEN                            (bl2c_send / bl2c_recv)
//   OPEN -> CLOSED                          (bl2c_disconnect)
//
// A subscriber that carries a session at CLOSED MUST NOT be able to
// issue another send/recv -- the disconnect drops the credits and any
// further RX would deliver to a phantom binding.
//
// =============================================================================
// §1  SESSION TABLE
// =============================================================================
//
// _bl2c_sessions holds four rows of eight u64s (chan_slot_id, psm, mtu,
// last_len, state, tx_bytes, rx_bytes, reserved).  A second bookkeeping
// site would let one path advance the FSM while another read the old
// state.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF0D0..0xFFFFF0DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: l2cap_dyn
// 0xFFFFF0E0..EF; adjacent free band below: unassigned 0xFFFFF0C0..CF).

module BtL2capChannel = structure {

  // §0 verbs -- HIGH half of the eight-bit domain to keep dispatch
  // signals grep-able.
  pub let BL2C_VERB_CONNECT    : u64 = 0xB0
  pub let BL2C_VERB_SEND       : u64 = 0xB1
  pub let BL2C_VERB_RECV       : u64 = 0xB2
  pub let BL2C_VERB_DISCONNECT : u64 = 0xB3
  pub let BL2C_VERB_MAX        : u64 = 0xB3

  // §1 column ordinals.
  pub let BL2C_COL_CHAN_SLOT_ID : u64 = 0
  pub let BL2C_COL_PSM          : u64 = 1
  pub let BL2C_COL_MTU          : u64 = 2
  pub let BL2C_COL_LAST_LEN     : u64 = 3
  pub let BL2C_COL_STATE        : u64 = 4
  pub let BL2C_COL_TX_BYTES     : u64 = 5
  pub let BL2C_COL_RX_BYTES     : u64 = 6
  pub let BL2C_COL_RESERVED     : u64 = 7

  // §0 session states.
  pub let BL2C_STATE_INIT   : u64 = 0
  pub let BL2C_STATE_OPEN   : u64 = 1
  pub let BL2C_STATE_CLOSED : u64 = 2
  pub let BL2C_STATE_MAX    : u64 = 2

  pub let BL2C_SESSION_MAX : u64 = 4

  // MTU bounds (BT §3.2.2 LE minimum ATT MTU).
  pub let BL2C_MTU_MIN : u64 = 23

  // §2 failure taxonomy 0xFFFFF0D0..0xFFFFF0DF.
  pub let BL2C_OK                : u64 = 0
  pub let BL2C_BAD_ARG           : u64 = 0xFFFFF0DF
  pub let BL2C_BAD_VERB          : u64 = 0xFFFFF0DE
  pub let BL2C_NO_SLOT           : u64 = 0xFFFFF0DD
  pub let BL2C_IN_USE            : u64 = 0xFFFFF0DC
  pub let BL2C_NOT_ACTIVE        : u64 = 0xFFFFF0DB
  pub let BL2C_BAD_STATE         : u64 = 0xFFFFF0DA
  pub let BL2C_BAD_PSM           : u64 = 0xFFFFF0D9
  pub let BL2C_BAD_MTU           : u64 = 0xFFFFF0D8
  pub let BL2C_ENOSPC            : u64 = 0xFFFFF0D7
  pub let BL2C_BAD_SESSION_SLOT  : u64 = 0xFFFFF0D6
  pub let BL2C_OP_UNSUPPORTED    : u64 = 0xFFFFF0D5
  pub let BL2C_ALREADY_CLOSED    : u64 = 0xFFFFF0D4
  pub let BL2C_BAD_LEN           : u64 = 0xFFFFF0D3
  pub let BL2C_UNUSED_A          : u64 = 0xFFFFF0D2
  pub let BL2C_UNUSED_B          : u64 = 0xFFFFF0D1
  pub let BL2C_UNUSED_C          : u64 = 0xFFFFF0D0

  pub let BL2C_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // 4 rows x 8 u64 = 32.
  pub let mut _bl2c_sessions : [u64; 32] = uninit @align(64)
  pub let mut _bl2c_stats    : [u64; 4]  = uninit @align(64)

  // ==========================================================================
  // Verb validator.
  // ==========================================================================

  pub let bl2c_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-004 (#1330): 1 iff v in {CONNECT, SEND, RECV, DISCONNECT}. Labels prefixed bl2c_vv_.",
      block: {
        cmp rdi, 0xB0;
        jb  bl2c_vv_no;
        cmp rdi, 0xB3;
        ja  bl2c_vv_no;
        mov rax, 1;
        ret;
      bl2c_vv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bl2c_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): clear session table + counters. Labels prefixed bl2c_rs_.",
      block: {
        lea r10, [rip + _bl2c_sessions];
        xor rax, rax;
        xor rcx, rcx;
      bl2c_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  bl2c_rs_rows;

        lea r10, [rip + _bl2c_stats];
        xor rcx, rcx;
      bl2c_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  bl2c_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row pointer.
  // ==========================================================================

  pub let bl2c_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): row pointer or 0. Labels prefixed bl2c_ra_.",
      block: {
        cmp rdi, 4;
        jae bl2c_ra_no;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rdi;
        shl r11, 6;                       // 8 u64 * 8 = 64
        add r10, r11;
        mov rax, r10;
        ret;
      bl2c_ra_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let bl2c_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): counter bump. Labels prefixed bl2c_nt_.",
      block: {
        cmp rdi, 4;
        jae bl2c_nt_out;
        lea r10, [rip + _bl2c_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bl2c_nt_out:
        ret
      }
    } @no_frame

  pub let bl2c_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): counter read. Labels prefixed bl2c_stt_.",
      block: {
        cmp rdi, 4;
        jae bl2c_stt_zero;
        lea r10, [rip + _bl2c_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bl2c_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // bl2c_connect(chan_slot, psm, mtu) -> session_id | failure
  //
  // FSM: INIT -> OPEN.
  // ==========================================================================

  pub let bl2c_connect : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (chan_slot: u64) (psm: u64) (mtu: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): allocate a session row and stash chan_slot + psm + mtu. Refuses chan_slot 0 (BAD_ARG), psm 0 or > 0xFFFF (BAD_PSM), mtu < 23 or > 0xFFFF (BAD_MTU), or table full (ENOSPC). Labels prefixed bl2c_c_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // chan_slot
        mov r13, rsi;                    // psm
        mov r14, rdx;                    // mtu

        cmp r12, 0;
        je  bl2c_c_bad;

        cmp r13, 0;
        je  bl2c_c_bad_psm;
        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  bl2c_c_bad_psm;

        cmp r14, 23;
        jb  bl2c_c_bad_mtu;
        mov r10, 0xFFFF;
        cmp r14, r10;
        ja  bl2c_c_bad_mtu;

        xor rbx, rbx;
      bl2c_c_scan:
        cmp rbx, 4;
        jae bl2c_c_full;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // chan_slot_id column
        cmp rax, 0;
        je  bl2c_c_claim;
        add rbx, 1;
        jmp bl2c_c_scan;

      bl2c_c_claim:
        mov [r10 + 0],  r12;             // chan_slot_id
        mov [r10 + 8],  r13;             // psm
        mov [r10 + 16], r14;             // mtu
        xor rax, rax;
        mov [r10 + 24], rax;             // last_len
        mov rax, 1;                      // state = OPEN
        mov [r10 + 32], rax;
        xor rax, rax;
        mov [r10 + 40], rax;             // tx_bytes
        mov [r10 + 48], rax;             // rx_bytes
        mov [r10 + 56], rax;             // reserved

        mov rdi, 0;
        call bl2c_note;

        mov rax, rbx;
        jmp bl2c_c_out;

      bl2c_c_bad:
        mov rax, 0xFFFFF0DF;
        jmp bl2c_c_out;
      bl2c_c_bad_psm:
        mov rax, 0xFFFFF0D9;
        jmp bl2c_c_out;
      bl2c_c_bad_mtu:
        mov rax, 0xFFFFF0D8;
        jmp bl2c_c_out;
      bl2c_c_full:
        mov rax, 0xFFFFF0D7;

      bl2c_c_out:
        pop r14;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bl2c_send(session_id, len) -> OK | failure
  //
  // FSM: OPEN -> OPEN.  len must be > 0 and <= session's MTU.
  // ==========================================================================

  pub let bl2c_send : (u64, u64) -> u64 !{mem} @{} =
    fn (sid: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): validate len, require state == OPEN, bump tx_bytes. Refuses wrong-state issue (BAD_STATE) or len==0 / len > mtu (BAD_LEN). Labels prefixed bl2c_s_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 4;
        jae bl2c_s_bad_sid;

        lea r10, [rip + _bl2c_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bl2c_s_notact;

        mov rax, [r10 + 32];             // state
        cmp rax, 1;                      // must be OPEN
        jne bl2c_s_bad_state;

        cmp r13, 0;
        je  bl2c_s_bad_len;
        mov rax, [r10 + 16];             // mtu
        cmp r13, rax;
        ja  bl2c_s_bad_len;

        mov [r10 + 24], r13;             // last_len
        mov rax, [r10 + 40];             // tx_bytes
        add rax, r13;
        mov [r10 + 40], rax;

        mov rdi, 1;
        call bl2c_note;

        xor rax, rax;
        jmp bl2c_s_out;

      bl2c_s_bad_sid:
        mov rax, 0xFFFFF0D6;
        jmp bl2c_s_out;
      bl2c_s_notact:
        mov rax, 0xFFFFF0DB;
        jmp bl2c_s_out;
      bl2c_s_bad_state:
        mov rax, 0xFFFFF0DA;
        jmp bl2c_s_out;
      bl2c_s_bad_len:
        mov rax, 0xFFFFF0D3;

      bl2c_s_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bl2c_recv(session_id, len) -> OK | failure
  //
  // FSM: OPEN -> OPEN.  len must be > 0 and <= session's MTU.
  // ==========================================================================

  pub let bl2c_recv : (u64, u64) -> u64 !{mem} @{} =
    fn (sid: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): validate len, require state == OPEN, bump rx_bytes. Refuses wrong-state accept (BAD_STATE) or len==0 / len > mtu (BAD_LEN). Labels prefixed bl2c_r_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 4;
        jae bl2c_r_bad_sid;

        lea r10, [rip + _bl2c_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bl2c_r_notact;

        mov rax, [r10 + 32];             // state
        cmp rax, 1;                      // must be OPEN
        jne bl2c_r_bad_state;

        cmp r13, 0;
        je  bl2c_r_bad_len;
        mov rax, [r10 + 16];             // mtu
        cmp r13, rax;
        ja  bl2c_r_bad_len;

        mov [r10 + 24], r13;             // last_len
        mov rax, [r10 + 48];             // rx_bytes
        add rax, r13;
        mov [r10 + 48], rax;

        mov rdi, 2;
        call bl2c_note;

        xor rax, rax;
        jmp bl2c_r_out;

      bl2c_r_bad_sid:
        mov rax, 0xFFFFF0D6;
        jmp bl2c_r_out;
      bl2c_r_notact:
        mov rax, 0xFFFFF0DB;
        jmp bl2c_r_out;
      bl2c_r_bad_state:
        mov rax, 0xFFFFF0DA;
        jmp bl2c_r_out;
      bl2c_r_bad_len:
        mov rax, 0xFFFFF0D3;

      bl2c_r_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bl2c_disconnect(session_id) -> OK | failure
  //
  // FSM: OPEN -> CLOSED.
  // ==========================================================================

  pub let bl2c_disconnect : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): require state == OPEN, advance to CLOSED, zero the session row so the ordinal frees. Refuses repeat disconnect (ALREADY_CLOSED). Labels prefixed bl2c_d_.",
      block: {
        push r12;

        mov r12, rdi;
        cmp r12, 4;
        jae bl2c_d_bad_sid;

        lea r10, [rip + _bl2c_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // chan_slot_id
        cmp rax, 0;
        je  bl2c_d_notact;

        mov rax, [r10 + 32];             // state
        cmp rax, 2;                      // already CLOSED
        je  bl2c_d_already;
        cmp rax, 1;                      // must be OPEN
        jne bl2c_d_bad_state;

        // Scrub the row so its ordinal frees.
        xor rax, rax;
        mov [r10 + 0],  rax;              // chan_slot_id = 0
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rcx, 2;
        mov [r10 + 32], rcx;              // preserve CLOSED marker briefly
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 3;
        call bl2c_note;

        xor rax, rax;
        jmp bl2c_d_out;

      bl2c_d_bad_sid:
        mov rax, 0xFFFFF0D6;
        jmp bl2c_d_out;
      bl2c_d_notact:
        mov rax, 0xFFFFF0DB;
        jmp bl2c_d_out;
      bl2c_d_bad_state:
        mov rax, 0xFFFFF0DA;
        jmp bl2c_d_out;
      bl2c_d_already:
        mov rax, 0xFFFFF0D4;

      bl2c_d_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Query helpers.
  // ==========================================================================

  pub let bl2c_state_of : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): sid -> state ordinal or BAD_ARG. Labels prefixed bl2c_so_.",
      block: {
        cmp rdi, 4;
        jae bl2c_so_bad;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bl2c_so_notact;
        mov rax, [r10 + 32];
        ret;
      bl2c_so_notact:
        mov rax, 0xFFFFF0DB;
        ret;
      bl2c_so_bad:
        mov rax, 0xFFFFF0DF;
        ret
      }
    } @no_frame

  pub let bl2c_mtu_of : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): sid -> session mtu or BAD_ARG. Labels prefixed bl2c_mo_.",
      block: {
        cmp rdi, 4;
        jae bl2c_mo_bad;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bl2c_mo_notact;
        mov rax, [r10 + 16];
        ret;
      bl2c_mo_notact:
        mov rax, 0xFFFFF0DB;
        ret;
      bl2c_mo_bad:
        mov rax, 0xFFFFF0DF;
        ret
      }
    } @no_frame

  pub let bl2c_tx_bytes : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): sid -> tx_bytes or BAD_ARG. Labels prefixed bl2c_tb_.",
      block: {
        cmp rdi, 4;
        jae bl2c_tb_bad;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bl2c_tb_notact;
        mov rax, [r10 + 40];
        ret;
      bl2c_tb_notact:
        mov rax, 0xFFFFF0DB;
        ret;
      bl2c_tb_bad:
        mov rax, 0xFFFFF0DF;
        ret
      }
    } @no_frame

  pub let bl2c_rx_bytes : (u64) -> u64 !{mem} @{} =
    fn (sid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-004 (#1330): sid -> rx_bytes or BAD_ARG. Labels prefixed bl2c_xb_.",
      block: {
        cmp rdi, 4;
        jae bl2c_xb_bad;
        lea r10, [rip + _bl2c_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  bl2c_xb_notact;
        mov rax, [r10 + 48];
        ret;
      bl2c_xb_notact:
        mov rax, 0xFFFFF0DB;
        ret;
      bl2c_xb_bad:
        mov rax, 0xFFFFF0DF;
        ret
      }
    } @no_frame
}
