// src/kernel/core/ipc/display_sync_channel.pdx -- G1.M1-002 (#1428)
//
// Session-type schema for the display-sync channel. Carries two
// RPCs:
//
//     wait_scanout(timeline_slot, value, timeout_ns)
//                                     -> presented_at_ns | timeout
//     present_flush(timeline_slot, value)
//                                     -> ok | bad_arg
//
// Both are ONE-SHOT RPCs (request -> response, no streaming), and
// both name the timeline by KIND_DISPLAY_TIMELINE slot rather than
// by (engine_id, output_id): a cap slot carries authority, an
// (engine, output) pair does not, and the P1 invariant of the whole
// G-round rests on that distinction (G1.M1-005 #1431).
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the display-sync conversation: the event
// ordinals, the argument-shape validators, and the small pack/
// unpack primitives. Same posture as modeset_channel.pdx /
// display_topology_channel.pdx.
//
// It is NOT an endpoint (no queue lives here), NOT a transport (no
// register is programmed here), and NOT the wait primitive (which
// lives in drivers/dpy/timeline.pdx and IS called from here through
// dsc_apply_wait).
//
// =============================================================================
// SECTION 1  ONE u64 PAYLOADS, EVENT ORDINALS
// =============================================================================
//
//   DSC_EV_WAIT_SCANOUT   0xA0  {timeline_slot, value, timeout_ns}
//   DSC_EV_PRESENT_FLUSH  0xA1  {timeline_slot, value}
//
// Event ordinals live in the top of the eight-bit domain. A
// dispatcher switching on ordinal cannot route a display-sync event
// as a modeset one or vice versa without crossing the 0x80 line
// AND the 0xA0 sub-line.
//
// =============================================================================
// SECTION 2  NS-PRECISION TIMESTAMPS
// =============================================================================
//
// timeout_ns and the presented_at_ns response are both nanoseconds
// via hpet_now_ns, matching R30.M4's clock discipline. The T14's
// HPET ticks at 24 MHz (~42 ns granularity) so the response is
// truncated to that quantum; the schema does not lie about that
// (nanosecond bits below 42 ns can drift by one tick).
//
// =============================================================================
// SECTION 3  REFUSE, NEVER CLAMP
// =============================================================================
//
// timeline_slot fits u16 (KIND_DISPLAY_TIMELINE row_id fits u16
// per kind_display_timeline.pdx §2). timeout_ns is u64 -- zero
// means "poll forever". A timeline_slot >= 256 is refused
// DSC_BAD_SLOT (cap_table row indexes fit u8 in the current sizing,
// but the field is validated to the u16 tail width for
// forward-compatibility).
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFF690..0xFFFFF69F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: KIND_DISPLAY_
// TIMELINE 0xFFFFF6A0..AF; adjacent free band below: driver
// timeline 0xFFFFF680..8F).

module DisplaySyncChannel = structure {

  pub let DSC_EV_WAIT_SCANOUT   : u64 = 0xA0
  pub let DSC_EV_PRESENT_FLUSH  : u64 = 0xA1
  pub let DSC_EV_MAX            : u64 = 0xA1

  // Failure taxonomy.
  pub let DSC_OK             : u64 = 0
  pub let DSC_BAD_EV         : u64 = 0xFFFFF69F
  pub let DSC_BAD_SLOT       : u64 = 0xFFFFF69E
  pub let DSC_BAD_TIMEOUT    : u64 = 0xFFFFF69D
  pub let DSC_BAD_RESERVED   : u64 = 0xFFFFF69C
  pub let DSC_NO_TIMELINE    : u64 = 0xFFFFF69B
  pub let DSC_APPLY_FAILED   : u64 = 0xFFFFF69A

  pub let DSC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Per-schema stats. Confined to this object.
  pub let mut _dsc_stats : [u64; 4] = uninit @align(64)

  pub let DSC_ST_WAITS   : u64 = 0
  pub let DSC_ST_FLUSHES : u64 = 1
  pub let DSC_ST_REFUSED : u64 = 2
  pub let DSC_ST_TIMEOUT : u64 = 3

  pub let dsc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-002 (#1428): clear schema counters. Labels prefixed dscs_rs_.",
      block: {
        lea r10, [rip + _dsc_stats];
        xor rax, rax;
        xor rcx, rcx;
      dscs_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dscs_rs_loop;
        ret
      }
    }

  pub let dsc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-002 (#1428): counter bump. Labels prefixed dscn_.",
      block: {
        cmp rdi, 4;
        jae dscn_out;
        lea r10, [rip + _dsc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dscn_out:
        ret
      }
    }

  pub let dsc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-002 (#1428): counter read.",
      block: {
        cmp rdi, 4;
        jae dscst_zero;
        lea r10, [rip + _dsc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dscst_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dsc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-002 (#1428): 1 iff ev in {0xA0, 0xA1}. Labels prefixed dscev_.",
      block: {
        mov r10, 0xA0;
        cmp rdi, r10;
        je  dscev_yes;
        mov r10, 0xA1;
        cmp rdi, r10;
        je  dscev_yes;
        xor rax, rax;
        ret;
      dscev_yes:
        mov rax, 1;
        ret
      }
    }

  pub let dsc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-002 (#1428): 1 iff s < 256 (cap slot bound). Zero admitted -- kernel slot 0 is a valid slot elsewhere in the tree. Labels prefixed dscsl_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dscsl_no;
        mov rax, 1;
        ret;
      dscsl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dsc_apply_wait(timeline_slot, value, timeout_ns) -> presented_at_ns | err
  //
  // Resolve the KIND_DISPLAY_TIMELINE cap slot to a row_id and
  // delegate to dpy_timeline_wait_le. This is the ONE PATH through
  // which the wait_scanout RPC touches the driver seam; no other
  // module in the tree calls dpy_timeline_wait_le with a caller-
  // supplied row_id (the row_id is derived from the cap here, not
  // from the RPC arguments).
  //
  // A cap slot that names a live KIND_DISPLAY_TIMELINE returns
  // presented_at_ns on reach or DSC_APPLY_FAILED wrapping the
  // driver error. A cap slot that names anything else returns
  // DSC_NO_TIMELINE.
  // ==========================================================================
  pub let dsc_apply_wait : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (timeline_slot: u64) (value: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G1.M1-002 (#1428) + G1.M1-004 (#1430): resolve the cap slot to a live KIND_DISPLAY_TIMELINE row, then delegate to dpy_timeline_wait_le. Bumps DSC_ST_WAITS on entry and DSC_ST_TIMEOUT on timeout. Labels prefixed dscaw_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // timeline_slot
        mov r13, rsi;                    // value
        mov rbx, rdx;                    // timeout_ns

        mov rdi, r12;
        call dsc_slot_valid;
        cmp rax, 0;
        je  dscaw_bad_slot;

        mov rdi, r12;
        call dpt_row_of_slot;
        cmp rax, 0xFF;
        je  dscaw_no_timeline;
        mov r12, rax;                    // row_id

        mov rdi, 0;                      // DSC_ST_WAITS
        call dsc_note;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rbx;
        call dpy_timeline_wait_le;

        mov r10, 0xFFFFF68E;             // DPY_TL_TIMEOUT
        cmp rax, r10;
        jne dscaw_out;
        mov rdi, 3;                      // DSC_ST_TIMEOUT
        call dsc_note;
        mov rax, 0xFFFFF69A;             // DSC_APPLY_FAILED
        jmp dscaw_out;

      dscaw_bad_slot:
        mov rdi, 2;
        call dsc_note;
        mov rax, 0xFFFFF69E;
        jmp dscaw_out;
      dscaw_no_timeline:
        mov rdi, 2;
        call dsc_note;
        mov rax, 0xFFFFF69B;

      dscaw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dsc_apply_flush(timeline_slot, value) -> OK | err
  //
  // Compose a present operation onto the display: the caller
  // commits to advancing the timeline to `value` when the flush
  // completes. In this milestone the flush is a schema-only
  // primitive (records the intent + bumps counter); the wire-up
  // to atomic_commit lives in G3 (compositor + swapchain).
  // ==========================================================================
  pub let dsc_apply_flush : (u64, u64) -> u64 !{mem} @{cap} =
    fn (timeline_slot: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M1-002 (#1428): record present_flush intent. Kernel-side: validate timeline_slot names a live KIND_DISPLAY_TIMELINE and bump DSC_ST_FLUSHES. The value is stashed inside the row via dpt_row_signal so a subsequent wait_scanout can observe the frame boundary. Labels prefixed dscaf_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // timeline_slot
        mov r13, rsi;                    // value

        mov rdi, r12;
        call dsc_slot_valid;
        cmp rax, 0;
        je  dscaf_bad_slot;

        mov rdi, r12;
        call dpt_row_of_slot;
        cmp rax, 0xFF;
        je  dscaf_no_timeline;
        mov rbx, rax;                    // row_id

        mov rdi, 1;                      // DSC_ST_FLUSHES
        call dsc_note;

        mov rdi, rbx;
        mov rsi, r13;
        call dpt_row_signal;
        cmp rax, 0;
        jne dscaf_failed;

        xor rax, rax;
        jmp dscaf_out;

      dscaf_bad_slot:
        mov rdi, 2;
        call dsc_note;
        mov rax, 0xFFFFF69E;
        jmp dscaf_out;
      dscaf_no_timeline:
        mov rdi, 2;
        call dsc_note;
        mov rax, 0xFFFFF69B;
        jmp dscaf_out;
      dscaf_failed:
        mov rdi, 2;
        call dsc_note;
        mov rax, 0xFFFFF69A;

      dscaf_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
