// src/kernel/core/ipc/wifi_data_channel.pdx — R38.M3-005 (#1302)
//
// Schema of the WiFi data channel: the two high-rate stream verbs
// (TX_FRAME / RX_FRAME) plus the pack/unpack primitives that turn
// each verb's arguments into one u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a stream surface, and the packers/unpackers that
// discharge it.  It is NOT an endpoint, NOT a transport, and NOT a
// driver: no queue lives here, no MMIO doorbell is written, and NO
// CALL sends a byte across a process boundary.  Same posture as
// wifi_control_channel.pdx.
//
// The data channel carries L2 frames to and from a vif at line rate.
// A future KIND_NET_L2_FRAME (R40/R41) will type the frame payload;
// today the payload is an untyped byte buffer, referenced by a
// {byte_ptr, byte_len} pair carried in the packed u64.  The frame
// wire lives in a payload arena or in a caller-owned page; this
// schema neither allocates nor dereferences it.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF VERBS
// =============================================================================
//
// Verb ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x80). A dispatcher that switches on verb cannot accidentally
// route the request as a reply or a reply as the request without
// crossing the 0x80 line.
//
//   WDC_VERB_TX_FRAME 0x80  {vif_slot, buf_ref, buf_len}
//   WDC_VERB_RX_FRAME 0x81  {vif_slot, buf_ref, buf_len}
//
// The two verbs share the exact same payload shape -- one for the
// producer side (TX from userspace to driver) and one for the consumer
// side (RX from driver to userspace).  Keeping them separate ordinals
// rather than a single "FRAME" with a direction bit is what lets a
// bounded queue at the transport layer maintain independent depth
// counters for the two directions without decoding the payload.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// The payload leaves no reserved bits (vif_slot + buf_ref + buf_len
// consume the full 64 bits below).  A future revision that wants to
// grow the payload adds a distinct verb rather than repurposing a bit
// on an existing one.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// vif_slot fits in 12 bits (non-zero); buf_ref is a 24-bit arena
// reference (non-zero); buf_len fits in 28 bits (< 2^28 = 256 MiB,
// far above any single 802.11 MPDU including AMPDU aggregation).
// vif_slot must be non-zero; buf_len == 0 is refused (BAD_LEN) --
// an empty frame is not a valid L2 frame and admitting it would
// let a submit path count an "enqueued" frame that carries no
// bytes.
//
// KIND_NET_L2_FRAME does not exist yet.  When R40/R41 introduces it,
// buf_ref becomes a slot for a live KIND_NET_L2_FRAME capability and
// buf_len becomes an inherited field on that row rather than an
// argument.  Until then, buf_ref is an opaque arena tag that the
// driver-side dequeuer resolves through its own payload arena, and
// the R38 witness only exercises the pack/unpack round-trip.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF430..0xFFFFF43F
// =============================================================================
//
// Sixteen-wide, disjoint from every in-tree band; adjacent used band
// above: wifi_control_channel 0xFFFFF440..4F; adjacent free band
// below: (currently unused, first free below is per repo scan).

module WifiDataChannel = structure {

  // §1's verb ordinals.
  pub let WDC_VERB_TX_FRAME : u64 = 0x80
  pub let WDC_VERB_RX_FRAME : u64 = 0x81
  pub let WDC_VERB_MAX      : u64 = 0x81

  // Field caps.  vif_slot in [1, 2^12); buf_ref in [1, 2^24); buf_len
  // in (0, 2^28).
  pub let WDC_VIF_MAX     : u64 = 0xFFF
  pub let WDC_BUF_REF_MAX : u64 = 0xFFFFFF
  pub let WDC_BUF_LEN_MAX : u64 = 0x0FFFFFFF

  // §4's failure taxonomy.
  pub let WDC_OK           : u64 = 0
  pub let WDC_BAD_VERB     : u64 = 0xFFFFF43F
  pub let WDC_BAD_VIF      : u64 = 0xFFFFF43E
  pub let WDC_BAD_BUF_REF  : u64 = 0xFFFFF43D
  pub let WDC_BAD_LEN      : u64 = 0xFFFFF43C
  pub let WDC_BAD_RESERVED : u64 = 0xFFFFF43B
  pub let WDC_UNUSED_A     : u64 = 0xFFFFF43A
  pub let WDC_UNUSED_B     : u64 = 0xFFFFF439
  pub let WDC_UNUSED_C     : u64 = 0xFFFFF438
  pub let WDC_UNUSED_D     : u64 = 0xFFFFF437
  pub let WDC_UNUSED_E     : u64 = 0xFFFFF436
  pub let WDC_UNUSED_F     : u64 = 0xFFFFF435
  pub let WDC_UNUSED_G     : u64 = 0xFFFFF434
  pub let WDC_UNUSED_H     : u64 = 0xFFFFF433
  pub let WDC_UNUSED_I     : u64 = 0xFFFFF432
  pub let WDC_UNUSED_J     : u64 = 0xFFFFF431
  pub let WDC_UNUSED_K     : u64 = 0xFFFFF430

  pub let WDC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // wdc_verb_valid(v) -> 1 | 0
  // ==========================================================================

  pub let wdc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-005 (#1302): 1 iff v is one of the two known verbs (0x80 TX_FRAME / 0x81 RX_FRAME). Labels prefixed wdc_vv_.",
      block: {
        cmp rdi, 0x80;
        jb  wdc_vv_no;
        cmp rdi, 0x81;
        ja  wdc_vv_no;
        mov rax, 1;
        ret;
      wdc_vv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wdc_pack_frame(vif_slot, buf_ref, buf_len) -> u64
  //
  // Layout:
  //   [11:0]   vif_slot (non-zero)
  //   [35:12]  buf_ref  (24-bit non-zero arena reference)
  //   [63:36]  buf_len  (28-bit non-zero payload length in bytes)
  //
  // Same shape for TX_FRAME and RX_FRAME.
  // ==========================================================================

  pub let wdc_pack_frame : (u64, u64, u64) -> u64 !{} @{} =
    fn (vif_slot: u64) (buf_ref: u64) (buf_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-005 (#1302): pack TX_FRAME / RX_FRAME request. Gates: vif_slot in (0, WDC_VIF_MAX] (BAD_VIF); buf_ref in (0, WDC_BUF_REF_MAX] (BAD_BUF_REF); buf_len in (0, WDC_BUF_LEN_MAX] (BAD_LEN). Labels prefixed wdc_pf_.",
      block: {
        cmp rdi, 0;
        je  wdc_pf_bad_vif;
        mov r10, 0xFFF;
        cmp rdi, r10;
        ja  wdc_pf_bad_vif;

        cmp rsi, 0;
        je  wdc_pf_bad_ref;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  wdc_pf_bad_ref;

        cmp rdx, 0;
        je  wdc_pf_bad_len;
        mov r10, 0x0FFFFFFF;
        cmp rdx, r10;
        ja  wdc_pf_bad_len;

        mov rax, rdi;
        and rax, 0xFFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 12;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0x0FFFFFFF;
        shl r10, 36;
        or  rax, r10;
        ret;
      wdc_pf_bad_vif:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wdc_pf_bad_ref:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret;
      wdc_pf_bad_len:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        ret
      }
    } @no_frame

  pub let wdc_frame_vif : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-005 (#1302): extract vif_slot from TX/RX_FRAME payload. Labels prefixed wdc_fv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFF;
        ret
      }
    } @no_frame

  pub let wdc_frame_buf_ref : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-005 (#1302): extract buf_ref from TX/RX_FRAME payload. Labels prefixed wdc_fr_.",
      block: {
        mov rax, rdi;
        shr rax, 12;
        and rax, 0xFFFFFF;
        ret
      }
    } @no_frame

  pub let wdc_frame_buf_len : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-005 (#1302): extract buf_len from TX/RX_FRAME payload. Labels prefixed wdc_fl_.",
      block: {
        mov rax, rdi;
        shr rax, 36;
        and rax, 0x0FFFFFFF;
        ret
      }
    } @no_frame
}
