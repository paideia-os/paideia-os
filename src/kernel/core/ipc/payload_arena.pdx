// src/kernel/core/ipc/payload_arena.pdx — R20b.M1-002 (#1553)
// 128 × 4 KiB static payload arena + payload_buf_pa_for(id) accessor.
//
// Design context
// --------------
// Per design/ipc/userspace-server-substrate.md §4.2:
//
//   Each endpoint owns exactly one 4 KiB page (allocated at kernel boot
//   in _ipc_payload_arena, static .bss). The page is layout as
//   [hdr:8 | payload:payload_len | pad]. The kernel copies request bytes
//   into the page on sys_ipc_send; the receiver reads them out on
//   sys_ipc_recv; reply bytes overwrite the page on sys_ipc_reply.
//
// Arena size: 128 × 4 KiB = 512 KiB. The arena and the endpoint table
// (endpoint_table.pdx) are the same size along the id axis (128 slots);
// the 1:1 binding is by index — endpoint id N owns arena page N.
//
// Alignment
// ---------
// @align(4096) on the arena base is REQUIRED by the AC:
//     `payload_buf_pa_for(0..127)` returns a 4 KiB-aligned PA.
// Since the base is 4 KiB-aligned AND id*4096 is always a multiple of
// 4096, every returned PA is 4 KiB-aligned by construction. No runtime
// alignment check is needed — the invariant is proved statically at
// build-time by the @align(4096) placement.
//
// Contiguity
// ----------
// `payload_buf_pa_for(id+1) - payload_buf_pa_for(id) == 4096` for every
// adjacent id pair in [0..127]. This holds because the accessor is pure
// arithmetic (base + id*4096); no permutation or interleave. Downstream
// M2 code depends on this: hdr and payload of a single in-flight message
// fit in one page (§4.2: `[hdr:8 | payload:payload_len | pad]` with
// payload_len ≤ 4088).
//
// Binding to endpoint_table
// -------------------------
// The endpoint_table row's `payload_buf_pa` field (offset +16) is NOT
// populated by endpoint_alloc — the storage-layer primitive stays free
// of cross-module dependencies. R20b.M2 wire-up calls
// `payload_buf_pa_for(id)` and writes the result into the row at that
// point. That said, the binding is deterministic: for any live endpoint
// with id N, its paired page is always _ipc_payload_arena + N*4096.

module PayloadArena = structure {

  // ============================================================================
  // Arena geometry (pinned by design/ipc/userspace-server-substrate.md §4.2)
  // ============================================================================

  pub let PAYLOAD_PAGE_BYTES     : u64 = 4096
  pub let PAYLOAD_ARENA_SLOTS    : u64 = 128
  pub let PAYLOAD_ARENA_BYTES    : u64 = 524288      // 128 * 4096

  // ============================================================================
  // Header + max-payload constants (used by M2 framing; frozen here so
  // downstream modules can read the arena's carry-capacity without
  // hard-coding the numeric split).
  // ============================================================================

  pub let PAYLOAD_HEADER_BYTES   : u64 = 8           // acpi-supervisor-schema §3
  pub let PAYLOAD_MAX_BYTES      : u64 = 4088        // 4096 - 8

  // ============================================================================
  // Sentinel for invalid id (structural safety net; symmetric with
  // EndpointTable.ENDPOINT_LOOKUP_NONE).
  // ============================================================================

  pub let PAYLOAD_BUF_NONE       : u64 = 0

  // ============================================================================
  // Storage — 128 × 4 KiB = 524288 B = 65536 u64s, @align(4096).
  //
  // @align(4096) is REQUIRED (see file header). Every payload_buf_pa_for
  // return value is 4 KiB-aligned by construction. The @align(4096)
  // placement also guarantees that no arena page straddles a physical
  // frame boundary in the low-half identity-mapped kernel .bss window
  // (each 4 KiB page maps to one 4 KiB physical frame), which is a
  // prerequisite for the M2 send-path's future user_read_bytes_via_walk
  // bounce copy per §4.3.
  // ============================================================================

  pub let mut _ipc_payload_arena : [u64; 65536] = uninit @align(4096)

  // ==========================================================================
  // payload_buf_pa_for(id: u64) -> u64
  //
  // SysV ABI: rdi = id -> rax = &_ipc_payload_arena + id * 4096, or
  // PAYLOAD_BUF_NONE (0) if id >= 128.
  //
  // Pure arithmetic accessor. Returns the PA of the 4 KiB page bound to
  // endpoint id N. The alignment + contiguity properties hold by
  // construction (see file header): every valid return is 4 KiB-aligned;
  // pa(id+1) - pa(id) == 4096 for every adjacent id pair.
  //
  // The out-of-range guard returns 0 as a structural safety net so
  // callers that miss an upstream bounds check don't compute a PA
  // outside the arena. Downstream M2 code that has already gated on
  // endpoint_lookup(id) != 0 (which implies id < 128) can safely skip
  // its own bounds check.
  // ==========================================================================

  pub let payload_buf_pa_for : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R20b.M1-002 (#1553): pa = &_ipc_payload_arena + id*4096. shl-by-12 encodes id*4096 (2^12 = 4096); matches the per-task xsave slot accessor in cpu/xsave.pdx L423. Base is @align(4096); id*4096 is a multiple of 4096 for every id; therefore every returned PA is 4 KiB-aligned by construction — the AC's alignment gate holds without a runtime mask/check. Contiguity: pa(id+1) - pa(id) == 4096 for adjacent ids by the same arithmetic. Out-of-range id -> return 0 (PAYLOAD_BUF_NONE) as a structural safety net symmetric with EndpointTable.endpoint_lookup's NULL sentinel; callers with a live endpoint id (already gated by endpoint_lookup) can skip their own bounds check. Kernel-VA == PA in the R20b low-half .bss identity-map. Leaf function; pure read (no writes).",
      block: {
        cmp rdi, 128;                       // PAYLOAD_ARENA_SLOTS
        jae payload_buf_none;

        mov rax, rdi;
        shl rax, 12;                        // id * 4096
        lea r8, [rip + _ipc_payload_arena];
        add rax, r8;
        ret;

      payload_buf_none:
        xor rax, rax;                       // PAYLOAD_BUF_NONE
        ret
      }
    }
}
