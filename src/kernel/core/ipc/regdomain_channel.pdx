// src/kernel/core/ipc/regdomain_channel.pdx — R38.M6-002 (#1315)
//
// Schema of the regdomain hint stream: a periodic wire message that
// carries {country_code, source, timestamp} from a ring-3 supervisor
// (regdom_loader / geo_hint) to the net80211 class driver.  A live
// consumer subscribes and re-binds nrd on each hint whose (source,
// confidence) beats the currently bound regime.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA + packers of the PERIODIC regdomain_hint stream.
// Same posture as wifi_control_channel.pdx / wpa_supplicant_channel.pdx:
// schema + pack/unpack primitives, no endpoint here.
//
// The one verb is a HINT, not a request -- the class driver decides
// on its own arbitration policy whether to consume it.  Each hint
// carries three fields packed into one u64.
//
// KIND_WIFI_KEY IS NOT INVOLVED.  A regdomain hint carries no
// secret material; the country code + source label are public per
// D7 (a client that can send a country-IE frame can send a
// regdomain hint) and no capability is minted for the wire.
//
// =============================================================================
// §1  ONE u64 PAYLOAD
// =============================================================================
//
//   [15:0]  country_code   (2-byte ASCII pair, ISO 3166-1 alpha-2;
//                           non-zero -- zero is refused as ZERO_CC)
//   [23:16] source         (RDC_SRC_EEPROM=1, RDC_SRC_GNSS=2,
//                           RDC_SRC_DEFAULT=3)
//   [63:24] timestamp      (40-bit monotonic tick, non-zero)
//
// Reserved bits are ZERO; a payload that arrives with the source
// byte outside [1, 3] is refused, and a timestamp that does not
// fit 40 bits is refused.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// A hint with source=0 is not a "no source" record; it is a
// malformed hint that the packer refuses.  A country code of zero is
// refused rather than mapped to WW: WW is 0x5757, not zero, and the
// difference matters for the audit ring the consumer builds from
// this stream.
//
// =============================================================================
// §3  SOURCE NUMBERING WITH RESPECT TO regdom_loader
// =============================================================================
//
// This module numbers sources 1/2/3 (EEPROM / GNSS / DEFAULT).
// src/kernel/core/drivers/wifi/regdom_loader.pdx numbers its OWN
// sources 0/1/2 (NONE / EEPROM / DEFAULT).  The numeric mismatch is
// deliberate: the two enums live at different layers and a caller
// that pastes one into the other's slot fails the validator at the
// wire boundary rather than silently mislabelling a hint.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF380..0xFFFFF38F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: regdom_loader
// 0xFFFFF390..9F; adjacent free band below: geo_hint
// 0xFFFFF370..7F).

module RegdomainChannel = structure {

  // §1: source ordinals (aligned with geo_hint.pdx GH_SRC_*).
  pub let RDC_SRC_EEPROM   : u64 = 1
  pub let RDC_SRC_GNSS     : u64 = 2
  pub let RDC_SRC_DEFAULT  : u64 = 3
  pub let RDC_SRC_MAX      : u64 = 3

  // §4: failure taxonomy 0xFFFFF380..0xFFFFF38F.
  pub let RDC_OK           : u64 = 0
  pub let RDC_BAD_CC       : u64 = 0xFFFFF38F   // cc outside 16-bit range
  pub let RDC_BAD_SOURCE   : u64 = 0xFFFFF38E
  pub let RDC_BAD_TS       : u64 = 0xFFFFF38D   // ts doesn't fit 40 bits
  pub let RDC_ZERO_CC      : u64 = 0xFFFFF38C   // cc == 0
  pub let RDC_ZERO_TS      : u64 = 0xFFFFF38B   // ts == 0
  pub let RDC_BAD_RESERVED : u64 = 0xFFFFF38A

  // Packer sentinels (distinct u64 values in the top of the space,
  // used only as return-code discriminators for failed packs).
  pub let RDC_PACK_BAD_CC     : u64 = 0xFFFFFFFFFFFFFFFF
  pub let RDC_PACK_BAD_SOURCE : u64 = 0xFFFFFFFFFFFFFFFE
  pub let RDC_PACK_BAD_TS     : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // rdc_source_valid(v) -> 1 iff v in {1, 2, 3}.
  // ==========================================================================

  pub let rdc_source_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): recognise the three source ordinals in §1. Labels prefixed rdc_sv_.",
      block: {
        cmp rdi, 1;
        jb  rdc_sv_no;
        cmp rdi, 3;
        ja  rdc_sv_no;
        mov rax, 1;
        ret;
      rdc_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // rdc_cc_valid(cc) -> 1 iff cc non-zero and fits 16 bits.
  //
  // Structural gate only -- the schema does not enforce the ISO
  // subset (regdom_loader's rdl_cc_valid does that at the consumer
  // side).  A hint carrying a made-up country code passes the
  // schema check; the consumer will refuse the bind against
  // net80211_regdom.
  // ==========================================================================

  pub let rdc_cc_valid : (u64) -> u64 !{} @{} =
    fn (cc: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): structural range check. Labels prefixed rdc_cv_.",
      block: {
        cmp rdi, 0;
        je  rdc_cv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  rdc_cv_no;
        mov rax, 1;
        ret;
      rdc_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // rdc_pack_hint(cc, source, ts) -> u64
  //   [15:0]  cc      (non-zero, 16-bit)
  //   [23:16] source  (1, 2, 3)
  //   [63:24] ts      (non-zero, 40-bit)
  //
  // On refusal, returns one of the three RDC_PACK_BAD_* sentinels.
  // Callers that need to distinguish successful "all-ones" payload
  // from the sentinel are protected: a valid payload has source in
  // [1, 3], so bits [23:16] are 0x01/0x02/0x03 -- never 0xFF as the
  // sentinels' second byte is.
  // ==========================================================================

  pub let rdc_pack_hint : (u64, u64, u64) -> u64 !{} @{} =
    fn (cc: u64) (source: u64) (ts: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): pack {cc, source, ts} into one u64. Gates: cc in (0, 2^16); source in [1, 3]; ts in (0, 2^40). Labels prefixed rdc_ph_.",
      block: {
        // cc: non-zero, 16-bit.
        cmp rdi, 0;
        je  rdc_ph_bad_cc;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  rdc_ph_bad_cc;

        // source: 1..3.
        cmp rsi, 1;
        jb  rdc_ph_bad_src;
        cmp rsi, 3;
        ja  rdc_ph_bad_src;

        // ts: non-zero, 40-bit.
        cmp rdx, 0;
        je  rdc_ph_bad_ts;
        mov r10, 0xFFFFFFFFFF;
        cmp rdx, r10;
        ja  rdc_ph_bad_ts;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        mov r11, 0xFFFFFFFFFF;
        and r10, r11;
        shl r10, 24;
        or  rax, r10;
        ret;

      rdc_ph_bad_cc:
        mov rax, 0xFFFFFFFFFFFFFFFF;      // RDC_PACK_BAD_CC
        ret;
      rdc_ph_bad_src:
        mov rax, 0xFFFFFFFFFFFFFFFE;      // RDC_PACK_BAD_SOURCE
        ret;
      rdc_ph_bad_ts:
        mov rax, 0xFFFFFFFFFFFFFFFD;      // RDC_PACK_BAD_TS
        ret
      }
    }

  pub let rdc_hint_cc : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): extract country_code. Labels prefixed rdc_hc_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let rdc_hint_source : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): extract source. Labels prefixed rdc_hs_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    }

  pub let rdc_hint_ts : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-002 (#1315): extract timestamp. Labels prefixed rdc_ht_.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        ret
      }
    }
}
