// src/kernel/core/ipc/gpu_bo_alloc_channel.pdx — R37.M3-005 (#1266)
//
// Schema of the GPU BO allocation channel: six RPC verbs plus the
// pack/unpack primitives that turn each verb's arguments into one
// u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of an RPC surface, and the packers/unpackers that
// discharge that schema. It is NOT an endpoint, NOT a transport, and
// NOT a server: no queue lives here, no capability is minted here,
// and NO CALL sends a byte across a process boundary. Same posture
// as display_topology_channel.pdx / battery_channel.pdx.
//
// The six verbs are:
//
//   alloc     {size, tiling, cache}                -> bo_slot
//   free      {bo_slot}                            -> ok
//   export_fd {bo_slot}                            -> fd
//   import_fd {fd}                                 -> bo_slot
//   cpu_map   {bo_slot}                            -> vaddr
//   cpu_unmap {vaddr}                              -> ok
//
// A subscriber that unpacks a field the packer never produced silently
// reads a value from the wrong bit range; tools/build.sh confines the
// packer signatures so a fifth parameter cannot smuggle a caller-
// supplied field.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF VERBS
// =============================================================================
//
// A verb whose payload spans multiple words has an ordering across
// the words a consumer must preserve; a one-word payload is atomic
// against every reader that reads it as a word.
//
// Verb ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x80). A dispatcher that switches on verb cannot accidentally
// route the request as a reply or a reply as the request without
// crossing the 0x80 line.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// Each payload has reserved upper bits; the packers set them to zero
// and refuse a payload that arrives with them set. A reserved field
// silently masked is a field a later revision cannot use.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// size fits in u32 (bo_alloc caps at 4 MiB anyway); tiling fits in 8
// bits (0..4); cache fits in 8 bits (0..3); bo_slot fits in 16 bits;
// fd fits in 32 bits; vaddr is a 64-bit value passed through as-is.
// Anything outside these widths is refused as DECODE_BAD.
//
// bo_slot must be non-zero: 0 is the .bss default for an unset slot
// id and admitting it would let an uninitialised RPC reach the wire.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF600..0xFFFFF60F
// =============================================================================
//
// Disjoint from every in-tree band; adjacent used band above:
// cache_policy 0xFFFFF610..1F.

module GpuBoAllocChannel = structure {

  // §1's verb ordinals.
  pub let BOC_VERB_ALLOC     : u64 = 0x80
  pub let BOC_VERB_FREE      : u64 = 0x81
  pub let BOC_VERB_EXPORT_FD : u64 = 0x82
  pub let BOC_VERB_IMPORT_FD : u64 = 0x83
  pub let BOC_VERB_CPU_MAP   : u64 = 0x84
  pub let BOC_VERB_CPU_UNMAP : u64 = 0x85
  pub let BOC_VERB_MAX       : u64 = 0x85

  // Field caps (mirror tiling / cache-policy MAX).
  pub let BOC_TILING_MAX : u64 = 4
  pub let BOC_CACHE_MAX  : u64 = 3

  // §4's failure taxonomy.
  pub let BOC_OK           : u64 = 0
  pub let BOC_BAD_VERB     : u64 = 0xFFFFF60F
  pub let BOC_BAD_SIZE     : u64 = 0xFFFFF60E
  pub let BOC_BAD_TILING   : u64 = 0xFFFFF60D
  pub let BOC_BAD_CACHE    : u64 = 0xFFFFF60C
  pub let BOC_BAD_SLOT     : u64 = 0xFFFFF60B
  pub let BOC_BAD_FD       : u64 = 0xFFFFF60A
  pub let BOC_BAD_VADDR    : u64 = 0xFFFFF609
  pub let BOC_BAD_RESERVED : u64 = 0xFFFFF608

  pub let BOC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // boc_verb_valid(v) -> 1 | 0
  // ==========================================================================

  pub let boc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): 1 iff v is one of the six known verbs (0x80..0x85). Constrained to the high half so a dispatcher that switched on ordinal cannot route a verb as a reply. Labels prefixed boc_vv_.",
      block: {
        cmp rdi, 0x80;
        jb  boc_vv_no;
        cmp rdi, 0x85;
        ja  boc_vv_no;
        mov rax, 1;
        ret;
      boc_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_alloc(size, tiling, cache) -> u64
  //
  // Layout:
  //   [31:0]  size (u32, non-zero)
  //   [39:32] tiling (0..4)
  //   [47:40] cache  (0..3)
  //   [63:48] reserved (0)
  // ==========================================================================

  pub let boc_pack_alloc : (u64, u64, u64) -> u64 !{} @{} =
    fn (size: u64) (tiling: u64) (cache: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack ALLOC request. Gates: size in (0, u32 max] (BAD_SIZE, 0xFFFFF60E); tiling <= TILING_MAX (BAD_TILING, 0xFFFFF60D); cache <= CACHE_MAX (BAD_CACHE, 0xFFFFF60C). Each refusal returns its SPECIFIC band code rather than a generic sentinel — the declared BOC_BAD_* constants exist so a caller can tell which field the packer refused, and returning the same -1 for all three collapses that back into a single 'something was bad' answer the constants were introduced to disambiguate. Labels prefixed boc_pa_.",
      block: {
        cmp rdi, 0;
        je  boc_pa_bad_size;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  boc_pa_bad_size;
        cmp rsi, 4;
        ja  boc_pa_bad_tiling;
        cmp rdx, 3;
        ja  boc_pa_bad_cache;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      boc_pa_bad_size:
        mov rax, 0xFFFFF60E;             // BOC_BAD_SIZE
        ret;
      boc_pa_bad_tiling:
        mov rax, 0xFFFFF60D;             // BOC_BAD_TILING
        ret;
      boc_pa_bad_cache:
        mov rax, 0xFFFFF60C;             // BOC_BAD_CACHE
        ret
      }
    }

  pub let boc_alloc_size : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract size from ALLOC payload. Labels prefixed boc_as_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let boc_alloc_tiling : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract tiling from ALLOC payload. Labels prefixed boc_at_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  pub let boc_alloc_cache : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract cache from ALLOC payload. Labels prefixed boc_ac_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_free(bo_slot) -> u64
  //   [15:0]  bo_slot (non-zero)
  //   [63:16] reserved (0)
  // ==========================================================================

  pub let boc_pack_free : (u64) -> u64 !{} @{} =
    fn (bo_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack FREE request. Gates: bo_slot fits 16 bits and non-zero (BAD_SLOT, 0xFFFFF60B). Refusal returns the SPECIFIC band code rather than a generic sentinel — see boc_pack_alloc for the reasoning. Labels prefixed boc_pf_.",
      block: {
        cmp rdi, 0;
        je  boc_pf_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  boc_pf_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      boc_pf_bad:
        mov rax, 0xFFFFF60B;             // BOC_BAD_SLOT
        ret
      }
    }

  pub let boc_free_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract bo_slot from FREE payload. Labels prefixed boc_fs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_export_fd(bo_slot) -> u64
  // Same shape as FREE.
  // ==========================================================================

  pub let boc_pack_export_fd : (u64) -> u64 !{} @{} =
    fn (bo_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack EXPORT_FD request. Same shape as FREE; refusal returns BOC_BAD_SLOT (0xFFFFF60B). Labels prefixed boc_pe_.",
      block: {
        cmp rdi, 0;
        je  boc_pe_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  boc_pe_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      boc_pe_bad:
        mov rax, 0xFFFFF60B;             // BOC_BAD_SLOT
        ret
      }
    }

  pub let boc_export_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract bo_slot from EXPORT_FD payload. Labels prefixed boc_es_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_import_fd(fd) -> u64
  //   [31:0]  fd (non-zero)
  //   [63:32] reserved (0)
  // ==========================================================================

  pub let boc_pack_import_fd : (u64) -> u64 !{} @{} =
    fn (fd: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack IMPORT_FD request. Gates: fd fits 32 bits and non-zero (BAD_FD, 0xFFFFF60A). Refusal returns the SPECIFIC band code. Labels prefixed boc_pi_.",
      block: {
        cmp rdi, 0;
        je  boc_pi_bad;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  boc_pi_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret;
      boc_pi_bad:
        mov rax, 0xFFFFF60A;             // BOC_BAD_FD
        ret
      }
    }

  pub let boc_import_fd : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract fd from IMPORT_FD payload. Labels prefixed boc_if_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_cpu_map(bo_slot) -> u64
  // Same shape as FREE / EXPORT_FD.
  // ==========================================================================

  pub let boc_pack_cpu_map : (u64) -> u64 !{} @{} =
    fn (bo_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack CPU_MAP request. Same shape as FREE; refusal returns BOC_BAD_SLOT (0xFFFFF60B). Labels prefixed boc_pm_.",
      block: {
        cmp rdi, 0;
        je  boc_pm_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  boc_pm_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      boc_pm_bad:
        mov rax, 0xFFFFF60B;             // BOC_BAD_SLOT
        ret
      }
    }

  pub let boc_map_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract bo_slot from CPU_MAP payload. Labels prefixed boc_ms_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // boc_pack_cpu_unmap(vaddr) -> u64
  //
  // vaddr is a 64-bit canonical address; the entire word is the
  // payload. Refuses vaddr == 0 (the .bss default) and vaddr with the
  // low 12 bits set (unmap targets a page-aligned address).
  // ==========================================================================

  pub let boc_pack_cpu_unmap : (u64) -> u64 !{} @{} =
    fn (vaddr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266) + #1613: pack CPU_UNMAP request. Gates: vaddr non-zero and 4KiB-aligned (BAD_VADDR, 0xFFFFF609). Refusal returns the SPECIFIC band code rather than a generic sentinel. Labels prefixed boc_pu_.",
      block: {
        cmp rdi, 0;
        je  boc_pu_bad;
        mov r10, rdi;
        and r10, 0xFFF;
        cmp r10, 0;
        jne boc_pu_bad;
        mov rax, rdi;
        ret;
      boc_pu_bad:
        mov rax, 0xFFFFF609;             // BOC_BAD_VADDR
        ret
      }
    }

  pub let boc_unmap_vaddr : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-005 (#1266): extract vaddr from CPU_UNMAP payload. Labels prefixed boc_uv_.",
      block: {
        mov rax, rdi;
        ret
      }
    }
}
