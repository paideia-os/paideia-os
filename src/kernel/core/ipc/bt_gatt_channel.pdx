// src/kernel/core/ipc/bt_gatt_channel.pdx — R39.M3-004 (#1334)
//
// Schema of the Bluetooth GATT RPC channel: four verbs plus the
// pack/unpack primitives that turn each verb's arguments into one u64
// and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of an RPC surface, and the packers/unpackers that
// discharge that schema.  It is NOT an endpoint, NOT a transport, and
// NOT a server: no queue lives here, no capability is minted here, and
// NO CALL sends a byte across a process boundary.  Same posture as
// gpu_bo_alloc_channel.pdx / wifi_control_channel.pdx.
//
// The four verbs are:
//
//   read_char   {conn_slot, handle}          -> value
//   write_char  {conn_slot, handle, value}   -> ok
//   subscribe   {conn_slot, handle}          -> ok
//   notify      {conn_slot, handle, value}   -> ok
//
// A subscriber that unpacks a field the packer never produced silently
// reads a value from the wrong bit range; tools/build.sh confines the
// packer signatures so a fifth parameter cannot smuggle a caller-
// supplied field.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF VERBS
// =============================================================================
//
// A verb whose payload spans multiple words has an ordering across the
// words a consumer must preserve; a one-word payload is atomic against
// every reader that reads it as a word.
//
// Verb ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x80).  A dispatcher that switches on verb cannot accidentally
// route the request as a reply or a reply as the request without
// crossing the 0x80 line.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// Each payload has reserved upper bits; the packers set them to zero
// and refuse a payload that arrives with them set.  A reserved field
// silently masked is a field a later revision cannot use.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// conn_slot fits in 16 bits and must be non-zero (0 is the .bss
// default for an unset slot id).  handle fits in 16 bits and must be
// non-zero (0 is the reserved handle per BT §3.2.1).  value fits in
// the payload budget for its verb (40 bits for write / notify, up to
// 56 bits for read response).  Anything outside these widths is
// refused as DECODE_BAD.
//
// =============================================================================
// §4  SESSION-TYPED SHAPE + EFFECT ROW
// =============================================================================
//
// Per the issue's session-typed schema note: read_char and write_char
// are REQ / RSP pairs (the caller sends REQ, awaits RSP); subscribe is
// a one-shot REQ / OK; notify is a UNILATERAL server -> client push
// (the server sends notify; no reply expected).  The effect row this
// channel exports for the paideia-as elaborator is:
//
//   !{bt_gatt_read, bt_gatt_write}
//
// A subscriber that carries a value at rest but no read/write effect
// on its arrow is not able to CALL read_char / write_char at all --
// which is the point: the effect row is the paideia-as-enforced record
// of "who touched a GATT attribute" independent of what any of the
// packers below computed.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFF300..0xFFFFF30F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: gatt driver
// 0xFFFFF310..0xFFFFF31F; below is the free R39.M2 candidate range).

module BtGattChannel = structure {

  // §1's verb ordinals.
  pub let BTGC_VERB_READ_CHAR  : u64 = 0x80
  pub let BTGC_VERB_WRITE_CHAR : u64 = 0x81
  pub let BTGC_VERB_SUBSCRIBE  : u64 = 0x82
  pub let BTGC_VERB_NOTIFY     : u64 = 0x83
  pub let BTGC_VERB_MAX        : u64 = 0x83

  // §5's failure taxonomy.
  pub let BTGC_OK           : u64 = 0
  pub let BTGC_BAD_VERB     : u64 = 0xFFFFF30F
  pub let BTGC_BAD_SLOT     : u64 = 0xFFFFF30E    // conn_slot 0 or > 16-bit
  pub let BTGC_BAD_HANDLE   : u64 = 0xFFFFF30D    // handle 0 or > 16-bit
  pub let BTGC_BAD_VALUE    : u64 = 0xFFFFF30C    // value outside payload width
  pub let BTGC_BAD_RESERVED : u64 = 0xFFFFF30B    // reserved bit set

  pub let BTGC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // btgc_verb_valid(v) -> 1 | 0
  // ==========================================================================

  pub let btgc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): 1 iff v is one of the four known verbs (0x80..0x83). Constrained to the high half so a dispatcher that switched on ordinal cannot route a verb as a reply. Labels prefixed btgc_vv_.",
      block: {
        cmp rdi, 0x80;
        jb  btgc_vv_no;
        cmp rdi, 0x83;
        ja  btgc_vv_no;
        mov rax, 1;
        ret;
      btgc_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // btgc_pack_read_char(conn_slot, handle) -> u64
  //
  //   [15:0]  conn_slot (non-zero)
  //   [31:16] handle (non-zero)
  //   [63:32] reserved (0)
  // ==========================================================================

  pub let btgc_pack_read_char : (u64, u64) -> u64 !{} @{} =
    fn (conn_slot: u64) (handle: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334) + #1614: pack READ_CHAR request. Gates: conn_slot non-zero and fits 16 bits (BTGC_BAD_SLOT, 0xFFFFF30E); handle non-zero and fits 16 bits (BTGC_BAD_HANDLE, 0xFFFFF30D). Each refusal returns its SPECIFIC band code rather than a generic sentinel — the declared BTGC_BAD_* constants exist so a caller can tell which field the packer refused, and collapsing both into a single -1 would erase that distinction. Labels prefixed btgc_pr_.",
      block: {
        cmp rdi, 0;
        je  btgc_pr_bad_slot;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  btgc_pr_bad_slot;
        cmp rsi, 0;
        je  btgc_pr_bad_handle;
        cmp rsi, r10;
        ja  btgc_pr_bad_handle;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      btgc_pr_bad_slot:
        mov rax, 0xFFFFF30E;             // BTGC_BAD_SLOT
        ret;
      btgc_pr_bad_handle:
        mov rax, 0xFFFFF30D;             // BTGC_BAD_HANDLE
        ret
      }
    }

  pub let btgc_read_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract conn_slot from READ_CHAR payload. Labels prefixed btgc_rs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_read_handle : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract handle from READ_CHAR payload. Labels prefixed btgc_rh_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // btgc_pack_write_char(conn_slot, handle, value) -> u64
  //
  //   [15:0]  conn_slot (non-zero)
  //   [31:16] handle (non-zero)
  //   [63:32] value_lo (32-bit payload)
  // ==========================================================================

  pub let btgc_pack_write_char : (u64, u64, u64) -> u64 !{} @{} =
    fn (conn_slot: u64) (handle: u64) (value: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334) + #1614: pack WRITE_CHAR request. Gates: conn_slot non-zero and 16 bits (BTGC_BAD_SLOT, 0xFFFFF30E); handle non-zero and 16 bits (BTGC_BAD_HANDLE, 0xFFFFF30D); value fits 32 bits (BTGC_BAD_VALUE, 0xFFFFF30C). Each refusal returns its SPECIFIC band code; see btgc_pack_read_char for the reasoning. Labels prefixed btgc_pw_.",
      block: {
        cmp rdi, 0;
        je  btgc_pw_bad_slot;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  btgc_pw_bad_slot;
        cmp rsi, 0;
        je  btgc_pw_bad_handle;
        cmp rsi, r10;
        ja  btgc_pw_bad_handle;
        mov r10, 0xFFFFFFFF;
        cmp rdx, r10;
        ja  btgc_pw_bad_value;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      btgc_pw_bad_slot:
        mov rax, 0xFFFFF30E;             // BTGC_BAD_SLOT
        ret;
      btgc_pw_bad_handle:
        mov rax, 0xFFFFF30D;             // BTGC_BAD_HANDLE
        ret;
      btgc_pw_bad_value:
        mov rax, 0xFFFFF30C;             // BTGC_BAD_VALUE
        ret
      }
    }

  pub let btgc_write_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract conn_slot from WRITE_CHAR payload. Labels prefixed btgc_ws_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_write_handle : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract handle from WRITE_CHAR payload. Labels prefixed btgc_wh_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_write_value : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract value from WRITE_CHAR payload. Labels prefixed btgc_wv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // btgc_pack_subscribe(conn_slot, handle) -> u64
  // Same shape as READ_CHAR.
  // ==========================================================================

  pub let btgc_pack_subscribe : (u64, u64) -> u64 !{} @{} =
    fn (conn_slot: u64) (handle: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334) + #1614: pack SUBSCRIBE request. Same shape as READ_CHAR; refusals return the specific band codes BTGC_BAD_SLOT (0xFFFFF30E) or BTGC_BAD_HANDLE (0xFFFFF30D). Labels prefixed btgc_ps_.",
      block: {
        cmp rdi, 0;
        je  btgc_ps_bad_slot;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  btgc_ps_bad_slot;
        cmp rsi, 0;
        je  btgc_ps_bad_handle;
        cmp rsi, r10;
        ja  btgc_ps_bad_handle;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      btgc_ps_bad_slot:
        mov rax, 0xFFFFF30E;             // BTGC_BAD_SLOT
        ret;
      btgc_ps_bad_handle:
        mov rax, 0xFFFFF30D;             // BTGC_BAD_HANDLE
        ret
      }
    }

  pub let btgc_sub_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract conn_slot from SUBSCRIBE payload. Labels prefixed btgc_ss_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_sub_handle : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract handle from SUBSCRIBE payload. Labels prefixed btgc_sh_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // btgc_pack_notify(conn_slot, handle, value) -> u64
  // Same shape as WRITE_CHAR (server -> client push, no reply expected).
  // ==========================================================================

  pub let btgc_pack_notify : (u64, u64, u64) -> u64 !{} @{} =
    fn (conn_slot: u64) (handle: u64) (value: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334) + #1614: pack NOTIFY payload. Same shape as WRITE_CHAR; refusals return the specific band codes BTGC_BAD_SLOT (0xFFFFF30E), BTGC_BAD_HANDLE (0xFFFFF30D), or BTGC_BAD_VALUE (0xFFFFF30C). Labels prefixed btgc_pn_.",
      block: {
        cmp rdi, 0;
        je  btgc_pn_bad_slot;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  btgc_pn_bad_slot;
        cmp rsi, 0;
        je  btgc_pn_bad_handle;
        cmp rsi, r10;
        ja  btgc_pn_bad_handle;
        mov r10, 0xFFFFFFFF;
        cmp rdx, r10;
        ja  btgc_pn_bad_value;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      btgc_pn_bad_slot:
        mov rax, 0xFFFFF30E;             // BTGC_BAD_SLOT
        ret;
      btgc_pn_bad_handle:
        mov rax, 0xFFFFF30D;             // BTGC_BAD_HANDLE
        ret;
      btgc_pn_bad_value:
        mov rax, 0xFFFFF30C;             // BTGC_BAD_VALUE
        ret
      }
    }

  pub let btgc_notify_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract conn_slot from NOTIFY payload. Labels prefixed btgc_ns_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_notify_handle : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract handle from NOTIFY payload. Labels prefixed btgc_nh_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let btgc_notify_value : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-004 (#1334): extract value from NOTIFY payload. Labels prefixed btgc_nv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret
      }
    }
}
