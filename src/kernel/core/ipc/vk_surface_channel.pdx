// src/kernel/core/ipc/vk_surface_channel.pdx -- G3.M1-004 (#1460)
//
// Session-type schema for the vk_surface channel. Carries four RPCs
// following VK WSI conventions:
//
//     create_swapchain(surface_slot, extent_w, extent_h,
//                      present_mode, image_count)     -> swapchain_key | err
//     acquire_image(surface_slot, timeout_ns)         -> image_slot | err
//     present_image(surface_slot, image_slot,
//                   present_id, target_pts)           -> ok | err
//     destroy_swapchain(surface_slot)                 -> ok | err
//
// All four are ONE-SHOT RPCs (request -> response). The surface is
// named by KIND_VK_SURFACE cap slot; image_slot is a
// KIND_VK_SWAPCHAIN_IMAGE. Same posture as display_sync_channel.pdx /
// vrr_channel.pdx.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the surface conversation: event ordinals,
// argument-shape validators, and small pack/unpack primitives.
//
// It is NOT an endpoint (no queue), NOT a transport, NOT the driver
// (the acquire/present seams live in drivers/vk/swapchain.pdx and
// ARE called from here through vsc_apply_*). See drivers/vk/
// swapchain.pdx for the acquire/present state machine.
//
// =============================================================================
// SECTION 1  EVENT ORDINALS 0xC0..0xC3
// =============================================================================
//
//   VSC_EV_CREATE_SWAPCHAIN   0xC0
//   VSC_EV_ACQUIRE_IMAGE      0xC1
//   VSC_EV_PRESENT_IMAGE      0xC2
//   VSC_EV_DESTROY_SWAPCHAIN  0xC3
//
// Ordinals live in the 0xC0 band -- distinct from display_sync
// (0xA0), vrr (0xB0), modeset (0x90) so a dispatcher switching on
// ordinal cannot cross wires.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDF0..0xFFFFEDFF
// =============================================================================

module VkSurfaceChannel = structure {

  pub let VSC_EV_CREATE_SWAPCHAIN  : u64 = 0xC0
  pub let VSC_EV_ACQUIRE_IMAGE     : u64 = 0xC1
  pub let VSC_EV_PRESENT_IMAGE     : u64 = 0xC2
  pub let VSC_EV_DESTROY_SWAPCHAIN : u64 = 0xC3
  pub let VSC_EV_MAX               : u64 = 0xC3

  pub let VSC_OK             : u64 = 0
  pub let VSC_BAD_EV         : u64 = 0xFFFFEDFF
  pub let VSC_BAD_SLOT       : u64 = 0xFFFFEDFE
  pub let VSC_BAD_EXTENT     : u64 = 0xFFFFEDFD
  pub let VSC_BAD_MODE       : u64 = 0xFFFFEDFC
  pub let VSC_BAD_COUNT      : u64 = 0xFFFFEDFB
  pub let VSC_BAD_RESERVED   : u64 = 0xFFFFEDFA
  pub let VSC_NO_SURFACE     : u64 = 0xFFFFEDF9
  pub let VSC_NO_IMAGE       : u64 = 0xFFFFEDF8
  pub let VSC_APPLY_FAILED   : u64 = 0xFFFFEDF7

  pub let VSC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _vsc_stats : [u64; 4] = uninit @align(64)

  pub let VSC_ST_CREATES  : u64 = 0
  pub let VSC_ST_ACQUIRES : u64 = 1
  pub let VSC_ST_PRESENTS : u64 = 2
  pub let VSC_ST_REFUSED  : u64 = 3

  pub let vsc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-004 (#1460): clear schema counters.",
      block: {
        lea r10, [rip + _vsc_stats];
        xor rax, rax;
        xor rcx, rcx;
      vsc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vsc_rs_loop;
        ret
      }
    }

  pub let vsc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-004 (#1460): counter bump.",
      block: {
        cmp rdi, 4;
        jae vsc_nt_out;
        lea r10, [rip + _vsc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vsc_nt_out:
        ret
      }
    }

  pub let vsc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-004 (#1460): counter read.",
      block: {
        cmp rdi, 4;
        jae vsc_st_zero;
        lea r10, [rip + _vsc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vsc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vsc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-004 (#1460): 1 iff ev in [0xC0, 0xC3].",
      block: {
        mov r10, 0xC0;
        cmp rdi, r10;
        jb  vsc_ev_no;
        mov r10, 0xC3;
        cmp rdi, r10;
        ja  vsc_ev_no;
        mov rax, 1;
        ret;
      vsc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let vsc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-004 (#1460): 1 iff s < 256.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vsc_sl_no;
        mov rax, 1;
        ret;
      vsc_sl_no:
        xor rax, rax;
        ret
      }
    }

  pub let vsc_extent_valid : (u64, u64) -> u64 !{} @{} =
    fn (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-004 (#1460): 1 iff 0 < w, h <= 16384.",
      block: {
        cmp rdi, 0;
        je  vsc_ext_no;
        mov r10, 16384;
        cmp rdi, r10;
        ja  vsc_ext_no;
        cmp rsi, 0;
        je  vsc_ext_no;
        cmp rsi, r10;
        ja  vsc_ext_no;
        mov rax, 1;
        ret;
      vsc_ext_no:
        xor rax, rax;
        ret
      }
    }

  pub let vsc_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-004 (#1465): 1 iff mode <= 3 (FIFO/MAILBOX/IMMEDIATE/FIFO_RELAXED).",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  vsc_mv_no;
        mov rax, 1;
        ret;
      vsc_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vsc_count_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-004 (#1460): 1 iff 2 <= n <= 4 (VK swapchain image count).",
      block: {
        mov r10, 2;
        cmp rdi, r10;
        jb  vsc_cv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  vsc_cv_no;
        mov rax, 1;
        ret;
      vsc_cv_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vsc_apply_create(surface_slot, extent_w, extent_h, mode, count)
  //     -> swapchain_key | err
  //
  // Resolve the KIND_VK_SURFACE cap slot to a row, then delegate to
  // vswc_create in drivers/vk/swapchain.pdx.
  // =========================================================================
  pub let vsc_apply_create : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (surface_slot: u64) (w: u64) (h: u64) (mode: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G3.M1-004 (#1460): resolve surface cap, validate args, delegate to vswc_create.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbx, r8;

        mov rdi, r12;
        call vsc_slot_valid;
        cmp rax, 0;
        je  vsc_ac_bad_slot;

        mov rdi, r13;
        mov rsi, r14;
        call vsc_extent_valid;
        cmp rax, 0;
        je  vsc_ac_bad_ext;

        mov rdi, r15;
        call vsc_mode_valid;
        cmp rax, 0;
        je  vsc_ac_bad_mode;

        mov rdi, rbx;
        call vsc_count_valid;
        cmp rax, 0;
        je  vsc_ac_bad_count;

        mov rdi, r12;
        call vks_row_of_slot;
        cmp rax, 0xFF;
        je  vsc_ac_no_surf;

        mov rdi, 0;
        call vsc_note;

        mov rdi, rax;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        mov r8,  rbx;
        call vswc_create;
        jmp vsc_ac_out;

      vsc_ac_bad_slot:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFE;
        jmp vsc_ac_out;
      vsc_ac_bad_ext:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFD;
        jmp vsc_ac_out;
      vsc_ac_bad_mode:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFC;
        jmp vsc_ac_out;
      vsc_ac_bad_count:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFB;
        jmp vsc_ac_out;
      vsc_ac_no_surf:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDF9;

      vsc_ac_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vsc_apply_acquire(surface_slot, timeout_ns) -> image_row | err
  // =========================================================================
  pub let vsc_apply_acquire : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G3.M2-002 (#1463): resolve surface + delegate to vswc_acquire.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call vsc_slot_valid;
        cmp rax, 0;
        je  vsc_aa_bad_slot;

        mov rdi, r12;
        call vks_row_of_slot;
        cmp rax, 0xFF;
        je  vsc_aa_no_surf;
        mov rbx, rax;

        mov rdi, 1;
        call vsc_note;

        mov rdi, rbx;
        mov rsi, r13;
        call vswc_acquire;
        jmp vsc_aa_out;

      vsc_aa_bad_slot:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFE;
        jmp vsc_aa_out;
      vsc_aa_no_surf:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDF9;

      vsc_aa_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vsc_apply_present(surface_slot, image_slot, present_id, target_pts)
  //     -> OK | err
  //
  // Delegates the display-timeline signal (via KIND_DISPLAY_TIMELINE +
  // dpt_row_signal) to vswc_present. See design/roadmap/next-wave-
  // synthesis.md §4 P1: this is a commit_frame/present_flush path so
  // the file itself references KIND_DISPLAY_TIMELINE / dpy_timeline_
  // wait_le / dpt_row_signal on the paired driver call.
  // =========================================================================
  pub let vsc_apply_present : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (image_slot: u64) (present_id: u64) (target_pts: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G3.M2-003 (#1464): resolve surface+image, delegate to vswc_present which advances KIND_DISPLAY_TIMELINE via dpt_row_signal.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rdi, r12;
        call vsc_slot_valid;
        cmp rax, 0;
        je  vsc_ap_bad_slot;

        mov rdi, r13;
        call vsc_slot_valid;
        cmp rax, 0;
        je  vsc_ap_bad_slot;

        mov rdi, r12;
        call vks_row_of_slot;
        cmp rax, 0xFF;
        je  vsc_ap_no_surf;

        mov rdi, r13;
        call vksi_row_of_slot;
        cmp rax, 0xFF;
        je  vsc_ap_no_img;
        mov rbx, rax;

        mov rdi, 2;
        call vsc_note;

        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, r15;
        call vswc_present;
        jmp vsc_ap_out;

      vsc_ap_bad_slot:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFE;
        jmp vsc_ap_out;
      vsc_ap_no_surf:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDF9;
        jmp vsc_ap_out;
      vsc_ap_no_img:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDF8;

      vsc_ap_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vsc_apply_destroy(surface_slot) -> OK | err
  // =========================================================================
  pub let vsc_apply_destroy : (u64) -> u64 !{mem} @{cap} =
    fn (surface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G3.M1-004 (#1460): resolve + delegate to vswc_destroy.",
      block: {
        push r12;

        mov r12, rdi;

        mov rdi, r12;
        call vsc_slot_valid;
        cmp rax, 0;
        je  vsc_ad_bad_slot;

        mov rdi, r12;
        call vks_row_of_slot;
        cmp rax, 0xFF;
        je  vsc_ad_no_surf;

        mov rdi, rax;
        call vswc_destroy;
        jmp vsc_ad_out;

      vsc_ad_bad_slot:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDFE;
        jmp vsc_ad_out;
      vsc_ad_no_surf:
        mov rdi, 3;
        call vsc_note;
        mov rax, 0xFFFFEDF9;

      vsc_ad_out:
        pop r12;
        ret
      }
    }
}
