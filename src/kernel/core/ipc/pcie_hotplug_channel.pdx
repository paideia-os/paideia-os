// src/kernel/core/ipc/pcie_hotplug_channel.pdx — R35.M1-003 (#1197)
//
// The SCHEMA of the pcie_hotplug channel — a one-way (kernel ->
// subscriber) stream of event records delivered on ONE endpoint per
// subscriber. Companion to the PCIe root-port ISR (hotplug_isr.pdx)
// and to the KIND_PCIE_HOTPLUG_EVENT capability (§1 of
// kind_pcie_hotplug_event.pdx).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the WIRE SCHEMA of the pcie_hotplug session. It packs and
// unpacks the two u64 words that make one event record, and it holds
// the per-endpoint fanout list a subscriber router consults when
// pcie_hotplug_channel_enqueue is called. It is NOT an endpoint, NOT a
// transport, and NOT a driver.
//
// The session type is:
//
//   pcie_hotplug : Channel {
//     ( event { root_port_bdf, event_type, port_status, timestamp } )*
//   }
//
// Event records flow one way — the kernel writes them; subscribers
// only read. There is no request/reply structure; a subscriber that
// wants to correlate with a request (e.g. an initiated DPC clear)
// does so through the capability system it derives from.
//
// =============================================================================
// §1  TWO u64 EVENT RECORDS
// =============================================================================
//
// Word 0: event_type[7:0] | root_port_bdf[23:8] | port_status[39:24]
//         | reserved[63:40]
// Word 1: timestamp (monotonic u64; source is R29 KIND_HW_TIMELINE
//         when wired; today the caller supplies a synthetic value the
//         schema round-trips)
//
// Reserved bits ([63:40] on word 0) are REFUSED, not masked, for the
// same reason hub_topology_channel §2 and every other schema in this
// tree state.
//
// =============================================================================
// §2  ROUTING
// =============================================================================
//
// pcie_hotplug_channel_enqueue(bdf, event_type, port_status) is the
// entry the ISR calls. It walks a fixed-capacity subscriber table
// keyed by (bdf, subscriber_endpoint) — a table small enough (16
// rows) that the walk is O(subscribers) and there is no per-event
// heap allocation. Multiple subscribers per root port is legal: two
// subscribers on the same bdf receive independent copies.
//
// _pcie_hotplug_channel_subs is written only by helpers in this
// module. tools/build.sh confines relocations against the symbol to
// `core/ipc/pcie_hotplug_channel.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFA10..0xFFFFFA1F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: pcie_hotplug_isr
// 0xFFFFFA20..2F, pcie_link_retrain 0xFFFFFA00..0F).

module PcieHotplugChannel = structure {

  // Event ordinal bounds (§1).
  pub let PHC_EVT_TYPE_MAX : u64 = 3

  // Fixed subscriber capacity. Sixteen rows covers a hotplug
  // supervisor plus a security service plus a diagnostics tap plus
  // room to spare.
  pub let PHC_SUBS_MAX      : u64 = 16
  pub let PHC_SUB_ROW_BYTES : u64 = 32
  //   [+0]  header (in_use[63:56] | reserved)
  //   [+8]  bdf (u16 in low bits; 0 = wildcard, matches every port)
  //   [+16] subscriber_endpoint (u64)
  //   [+24] events_delivered (u64)

  pub let mut _pcie_hotplug_channel_subs  : [u64; 64] = uninit @align(64)
  pub let mut _pcie_hotplug_channel_stats : [u64; 4]  = uninit @align(64)

  pub let PHC_ST_ENQUEUES : u64 = 0
  pub let PHC_ST_DELIVERS : u64 = 1
  pub let PHC_ST_REJECTS  : u64 = 2
  pub let PHC_ST_DROPS    : u64 = 3

  // Failure taxonomy — 0xFFFFFA10..0xFFFFFA1F.
  pub let PHC_OK               : u64 = 0
  pub let PHC_BAD_ARG          : u64 = 0xFFFFFA1F
  pub let PHC_BAD_BDF          : u64 = 0xFFFFFA1E
  pub let PHC_BAD_EVENT        : u64 = 0xFFFFFA1D
  pub let PHC_BAD_STATUS       : u64 = 0xFFFFFA1C
  pub let PHC_BAD_RESERVED     : u64 = 0xFFFFFA1B
  pub let PHC_SUB_ENOSPC       : u64 = 0xFFFFFA1A
  pub let PHC_SUB_NOT_FOUND    : u64 = 0xFFFFFA19
  pub let PHC_SUB_IN_USE       : u64 = 0xFFFFFA18

  pub let PHC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PHC_ROW_NONE   : u64 = 0xFF

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let pcie_hotplug_channel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): clear the subscriber table and stats. Boot and teardown only. Labels prefixed phc_rs_.",
      block: {
        lea r10, [rip + _pcie_hotplug_channel_subs];
        xor rax, rax;
        xor rcx, rcx;
      phc_rs_subs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  phc_rs_subs;

        lea r10, [rip + _pcie_hotplug_channel_stats];
        xor rcx, rcx;
      phc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  phc_rs_stats;
        ret
      }
    } @no_frame

  pub let pcie_hotplug_channel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): honesty pin. Returns 0 until a later round wires the ISR against a real MSI-X vector and delivery against a live endpoint.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let phc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): counter bump. Labels prefixed phc_nt_.",
      block: {
        cmp rdi, 4;
        jae phc_nt_out;
        lea r10, [rip + _pcie_hotplug_channel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      phc_nt_out:
        ret
      }
    } @no_frame

  pub let phc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): counter read.",
      block: {
        cmp rdi, 4;
        jae phc_st_zero;
        lea r10, [rip + _pcie_hotplug_channel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      phc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let phc_event_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): 1 iff t in [0, 3].",
      block: {
        cmp rdi, 3;
        ja  phc_ev_no;
        mov rax, 1;
        ret;
      phc_ev_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let phc_bdf_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): 1 iff b fits in u16.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  phc_bv_no;
        mov rax, 1;
        ret;
      phc_bv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let phc_status_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): 1 iff s fits in u16.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  phc_sv_no;
        mov rax, 1;
        ret;
      phc_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packers / unpackers for the two-word event record (§1).
  // ==========================================================================

  pub let phc_pack_word0 : (u64, u64, u64) -> u64 !{} @{} =
    fn (event_type: u64) (bdf: u64) (port_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): pack event_type[7:0] | bdf[23:8] | port_status[39:24]. Refuses out-of-range fields. Labels prefixed phc_pw0_.",
      block: {
        cmp rdi, 3;
        ja  phc_pw0_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  phc_pw0_bad;
        cmp rdx, r10;
        ja  phc_pw0_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      phc_pw0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let phc_word0_event : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): event_type from word0[7:0]. Refuses reserved bits [63:40] non-zero. Labels prefixed phc_we_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        cmp rax, 0;
        jne phc_we_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      phc_we_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let phc_word0_bdf : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): bdf from word0[23:8].",
      block: {
        mov rax, rdi;
        shr rax, 40;
        cmp rax, 0;
        jne phc_wb_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFF;
        ret;
      phc_wb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let phc_word0_status : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-003 (#1197): port_status from word0[39:24].",
      block: {
        mov rax, rdi;
        shr rax, 40;
        cmp rax, 0;
        jne phc_ws_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFFFF;
        ret;
      phc_ws_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Subscriber table.
  //
  // THE ONE WRITER of _pcie_hotplug_channel_subs. tools/build.sh
  // confines relocations against `_pcie_hotplug_channel_subs` to this
  // object.
  // ==========================================================================

  pub let phc_sub_add : (u64, u64) -> u64 !{mem} @{} =
    fn (bdf: u64) (subscriber_endpoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): register a subscriber at (bdf, endpoint). bdf=0 is the wildcard, matches every port. Refuses subscriber_endpoint == 0 (BAD_ARG). Refuses duplicate (bdf, endpoint) with SUB_IN_USE. Returns row_id or error. Labels prefixed phc_sa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // bdf
        mov r13, rsi;                    // subscriber_endpoint

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  phc_sa_bad;
        cmp r13, 0;
        je  phc_sa_bad;

        // Uniqueness check.
        xor rbx, rbx;
      phc_sa_dup_scan:
        cmp rbx, 16;
        jae phc_sa_dup_done;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_sa_dup_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne phc_sa_dup_next;
        mov rax, [r10 + 16];
        cmp rax, r13;
        jne phc_sa_dup_next;
        jmp phc_sa_dup;
      phc_sa_dup_next:
        add rbx, 1;
        jmp phc_sa_dup_scan;
      phc_sa_dup_done:

        // Free scan.
        xor rbx, rbx;
      phc_sa_scan:
        cmp rbx, 16;
        jae phc_sa_full;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_sa_claim;
        add rbx, 1;
        jmp phc_sa_scan;
      phc_sa_claim:
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;
        mov [r10 + 16], r13;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp phc_sa_out;

      phc_sa_full:
        mov rax, 0xFFFFFA1A;
        jmp phc_sa_out;
      phc_sa_dup:
        mov rax, 0xFFFFFA18;
        jmp phc_sa_out;
      phc_sa_bad:
        mov rax, 0xFFFFFA1F;

      phc_sa_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let phc_sub_remove : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): unregister subscriber row. Labels prefixed phc_sr_.",
      block: {
        cmp rdi, 16;
        jae phc_sr_bad;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_sr_bad;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;
      phc_sr_bad:
        mov rax, 0xFFFFFA19;
        ret
      }
    } @no_frame

  pub let phc_sub_row_bdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): row bdf, or DECODE_BAD.",
      block: {
        cmp rdi, 16;
        jae phc_srb_bad;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_srb_bad;
        mov rax, [r10 + 8];
        ret;
      phc_srb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let phc_sub_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): row endpoint, or DECODE_BAD.",
      block: {
        cmp rdi, 16;
        jae phc_sre_bad;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_sre_bad;
        mov rax, [r10 + 16];
        ret;
      phc_sre_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let phc_sub_row_delivered : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): row delivered counter, or DECODE_BAD.",
      block: {
        cmp rdi, 16;
        jae phc_srd_bad;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_srd_bad;
        mov rax, [r10 + 24];
        ret;
      phc_srd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcie_hotplug_channel_enqueue(bdf, event_type, port_status) -> OK|err
  //
  // Fanout entry point called by the ISR (or a test). Walks the
  // subscriber table and, for every row whose bdf matches (row bdf ==
  // 0 wildcard OR row bdf == bdf), bumps its delivered counter. The
  // actual per-endpoint IPC send is deferred to a later round when
  // the router lands; today the schema records the delivery intent
  // via the counter, which is what the operator observes.
  // ==========================================================================

  pub let pcie_hotplug_channel_enqueue : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bdf: u64) (event_type: u64) (port_status: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-003 (#1197): enqueue one event; fanout by bdf match. Refuses malformed fields. Labels prefixed phc_eq_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // bdf
        mov r13, rsi;                    // event_type
        mov r14, rdx;                    // port_status

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  phc_eq_bad_bdf;
        cmp r13, 3;
        ja  phc_eq_bad_evt;
        cmp r14, r10;
        ja  phc_eq_bad_sts;

        mov rdi, 0;                      // ENQUEUES
        call phc_note;

        // Fanout scan.
        xor rbx, rbx;
      phc_eq_scan:
        cmp rbx, 16;
        jae phc_eq_done;
        lea r10, [rip + _pcie_hotplug_channel_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phc_eq_next;
        // bdf match: row bdf == 0 wildcard OR row bdf == bdf
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  phc_eq_hit;
        cmp rax, r12;
        jne phc_eq_next;
      phc_eq_hit:
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rdi, 1;                      // DELIVERS
        call phc_note;
      phc_eq_next:
        add rbx, 1;
        jmp phc_eq_scan;

      phc_eq_done:
        xor rax, rax;
        jmp phc_eq_out;

      phc_eq_bad_bdf:
        mov rdi, 2;                      // REJECTS
        call phc_note;
        mov rax, 0xFFFFFA1E;
        jmp phc_eq_out;
      phc_eq_bad_evt:
        mov rdi, 2;
        call phc_note;
        mov rax, 0xFFFFFA1D;
        jmp phc_eq_out;
      phc_eq_bad_sts:
        mov rdi, 2;
        call phc_note;
        mov rax, 0xFFFFFA1C;

      phc_eq_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
