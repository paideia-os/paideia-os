// src/kernel/core/ipc/modeset_channel.pdx — R36.M3-002 (#1245)
//
// Session-type FSM for the modeset channel. The channel carries a
// caller through the four legal transitions of an atomic modeset:
//
//     BEGIN_TXN  →  SET_MODE  →  SET_PLANE*  →  (COMMIT | ABORT)
//
// and REFUSES every other move, using KIND_MODESET_TXN's state field
// as the state variable. This module owns the transition table, the
// event ordinal set, and the small pack/unpack primitives; it neither
// mints capabilities nor runs a transport.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SESSION-TYPE FSM for a modeset conversation. It is NOT an
// endpoint, NOT a transport, and NOT the atomic commit driver: no
// queue lives here, no register is programmed here. Same posture as
// display_topology_channel.pdx / battery_channel.pdx.
//
// The state variable is the `state` field of one KIND_MODESET_TXN
// row (target_ptr -> row_id -> mtx_row_state). Every transition
// helper here:
//   (1) reads the current row state,
//   (2) refuses the event if the transition is not in the table,
//   (3) writes the new state through mtx_row_transition.
//
// A caller that arrives with SET_PLANE at an OPEN transaction is
// refused MCH_BAD_TRANSITION; one that reaches COMMIT before SET_MODE
// is refused the same way. The state machine is enforced STRUCTURALLY
// in the tests (§5) and STRUCTURALLY at runtime by mch_event_apply
// consulting the transition table below.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, EVENT ORDINALS
// =============================================================================
//
//   MCH_EV_BEGIN_TXN   0x90  {txn_slot}
//   MCH_EV_SET_MODE    0x91  {txn_slot, mode_slot}
//   MCH_EV_SET_PLANE   0x92  {txn_slot, plane_id}
//   MCH_EV_COMMIT      0x93  {txn_slot}
//   MCH_EV_ABORT       0x94  {txn_slot}
//
// Event ordinals live in the high half of the eight-bit domain
// (>= 0x80). A dispatcher that switches on ordinal cannot route a
// modeset event as a topology one or vice versa without crossing the
// 0x80 line.
//
// =============================================================================
// §2  THE TRANSITION TABLE
// =============================================================================
//
// A 5-state x 5-event table. Entries are the target state; UNREACHABLE
// is encoded as 0xFF and turns into MCH_BAD_TRANSITION.
//
//     event \\ state       OPEN    MODE_SET  PLANE_SET  COMMITTING  ABORTED
//     BEGIN_TXN            OPEN    UNREACH   UNREACH    UNREACH     UNREACH
//     SET_MODE             MODE    UNREACH   UNREACH    UNREACH     UNREACH
//     SET_PLANE            UNREACH PLANE     PLANE      UNREACH     UNREACH
//     COMMIT               UNREACH UNREACH   COMMITTING UNREACH     UNREACH
//     ABORT                ABORT   ABORT     ABORT      UNREACH     UNREACH
//
// BEGIN_TXN is legal only from OPEN — it is a no-op at the FSM level
// but a caller cannot skip the event without also having skipped the
// mint (which stamps OPEN). SET_MODE requires OPEN. SET_PLANE requires
// MODE_SET or PLANE_SET — the star in the protocol. COMMIT requires
// PLANE_SET (at least one plane set). ABORT is legal from any pre-
// terminal state.
//
// The table is ROW-MAJOR indexed as [event_idx * MTX_STATE_COUNT +
// state], where event_idx = ev - MCH_EV_BEGIN_TXN.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// txn_slot fits in 16 bits; mode_slot fits 16 (it names a
// KIND_DISPLAY_MODE cap slot, u8 < 256 in practice); plane_id fits 8
// bits and admits DTC_DDI_MAX-equivalent (0..15). Anything outside
// those widths is refused DECODE_BAD.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF710..0xFFFFF71F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: kind_display_mode
// 0xFFFFF720..2F; adjacent free bands below: atomic_commit
// 0xFFFFF700..0F).

module ModesetChannel = structure {

  // §1's event ordinals.
  pub let MCH_EV_BEGIN_TXN : u64 = 0x90
  pub let MCH_EV_SET_MODE  : u64 = 0x91
  pub let MCH_EV_SET_PLANE : u64 = 0x92
  pub let MCH_EV_COMMIT    : u64 = 0x93
  pub let MCH_EV_ABORT     : u64 = 0x94
  pub let MCH_EV_MAX       : u64 = 0x94

  // State ordinals (mirror KindModesetTxn.MTX_STATE_*).
  pub let MCH_STATE_OPEN       : u64 = 0
  pub let MCH_STATE_MODE_SET   : u64 = 1
  pub let MCH_STATE_PLANE_SET  : u64 = 2
  pub let MCH_STATE_COMMITTING : u64 = 3
  pub let MCH_STATE_ABORTED    : u64 = 4
  pub let MCH_STATE_COUNT      : u64 = 5
  pub let MCH_STATE_UNREACH    : u64 = 0xFF

  // Plane id cap.
  pub let MCH_PLANE_MAX : u64 = 15

  // §4's failure taxonomy.
  pub let MCH_OK              : u64 = 0
  pub let MCH_BAD_EV          : u64 = 0xFFFFF71F
  pub let MCH_BAD_SLOT        : u64 = 0xFFFFF71E
  pub let MCH_BAD_MODE_SLOT   : u64 = 0xFFFFF71D
  pub let MCH_BAD_PLANE       : u64 = 0xFFFFF71C
  pub let MCH_BAD_TRANSITION  : u64 = 0xFFFFF71B
  pub let MCH_BAD_RESERVED    : u64 = 0xFFFFF71A
  pub let MCH_NO_TXN          : u64 = 0xFFFFF719
  pub let MCH_APPLY_FAILED    : u64 = 0xFFFFF718

  pub let MCH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // §2's transition table. 5 events x 5 states = 25 bytes; stored as
  // [u64; 25] because paideia-as arrays are u64 rows and the space is
  // negligible. Row index = event - MCH_EV_BEGIN_TXN.
  //
  //   row 0 (BEGIN_TXN): [OPEN, UNR, UNR, UNR, UNR]
  //   row 1 (SET_MODE):  [MODE_SET, UNR, UNR, UNR, UNR]
  //   row 2 (SET_PLANE): [UNR, PLANE_SET, PLANE_SET, UNR, UNR]
  //   row 3 (COMMIT):    [UNR, UNR, COMMITTING, UNR, UNR]
  //   row 4 (ABORT):     [ABORTED, ABORTED, ABORTED, UNR, UNR]
  pub let mch_transition_table : [u64; 25] = [
    0,    0xFF, 0xFF, 0xFF, 0xFF,
    1,    0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 2,    2,    0xFF, 0xFF,
    0xFF, 0xFF, 3,    0xFF, 0xFF,
    4,    4,    4,    0xFF, 0xFF
  ]

  // ==========================================================================
  // mch_ev_valid(ev) -> 1 | 0
  // ==========================================================================

  pub let mch_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): 1 iff ev in {BEGIN_TXN, SET_MODE, SET_PLANE, COMMIT, ABORT}. Labels prefixed mch_ev_.",
      block: {
        cmp rdi, 0x90;
        jb  mch_ev_no;
        cmp rdi, 0x94;
        ja  mch_ev_no;
        mov rax, 1;
        ret;
      mch_ev_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // mch_transition(state, ev) -> new_state | UNREACH
  //
  // Reads the transition table and returns the target state or 0xFF
  // (UNREACH). Callers translate UNREACH to MCH_BAD_TRANSITION.
  // ==========================================================================

  pub let mch_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (state: u64) (ev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-002 (#1245): consult the 5x5 transition table. Refuses out-of-range state / event with UNREACH so callers translate to BAD_TRANSITION uniformly. Labels prefixed mch_tr_.",
      block: {
        cmp rdi, 4;                      // MCH_STATE_MAX
        ja  mch_tr_unreach;
        cmp rsi, 0x90;
        jb  mch_tr_unreach;
        cmp rsi, 0x94;
        ja  mch_tr_unreach;

        mov rax, rsi;
        sub rax, 0x90;                   // event_idx (0..4)
        mov r10, 5;
        imul rax, r10;                   // rax = event_idx * 5
        add rax, rdi;                    // + state
        lea r10, [rip + mch_transition_table];
        mov rax, [r10 + rax * 8];
        ret;

      mch_tr_unreach:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // Payload packers.
  //
  //   pack_txn(txn_slot)                 { [15:0] txn_slot (non-zero) }
  //   pack_mode(txn_slot, mode_slot)     { [15:0] txn_slot, [31:16] mode_slot }
  //   pack_plane(txn_slot, plane_id)     { [15:0] txn_slot, [23:16] plane_id }
  // ==========================================================================

  pub let mch_pack_txn : (u64) -> u64 !{} @{} =
    fn (txn_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): pack BEGIN/COMMIT/ABORT payload. Gates: txn_slot fits 16 bits and non-zero. Labels prefixed mch_pt_.",
      block: {
        cmp rdi, 0;
        je  mch_pt_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  mch_pt_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      mch_pt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let mch_pack_mode : (u64, u64) -> u64 !{} @{} =
    fn (txn_slot: u64) (mode_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): pack SET_MODE payload. Gates: txn_slot fits 16 bits and non-zero; mode_slot fits 16 bits and non-zero. Labels prefixed mch_pm_.",
      block: {
        cmp rdi, 0;
        je  mch_pm_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  mch_pm_bad;
        cmp rsi, 0;
        je  mch_pm_bad;
        cmp rsi, r10;
        ja  mch_pm_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      mch_pm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let mch_pack_plane : (u64, u64) -> u64 !{} @{} =
    fn (txn_slot: u64) (plane_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): pack SET_PLANE payload. Gates: txn_slot fits 16 bits and non-zero; plane_id <= MCH_PLANE_MAX (15). Labels prefixed mch_pp_.",
      block: {
        cmp rdi, 0;
        je  mch_pp_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  mch_pp_bad;
        cmp rsi, 15;
        ja  mch_pp_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      mch_pp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let mch_unpack_txn : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): extract txn_slot. Labels prefixed mch_ut_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let mch_unpack_mode : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): extract mode_slot. Labels prefixed mch_um_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let mch_unpack_plane : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-002 (#1245): extract plane_id. Labels prefixed mch_up_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // mch_event_apply(txn_slot, ev, aux) -> u64
  //
  // Given a KIND_MODESET_TXN cap slot, an event, and an event-specific
  // aux payload (mode_slot for SET_MODE, plane_id for SET_PLANE, ignored
  // otherwise), consult the transition table and update the row's state
  // through mtx_row_transition. Refuses illegal transitions
  // BAD_TRANSITION, aux out of range BAD_MODE_SLOT / BAD_PLANE, unknown
  // event BAD_EV, unknown slot NO_TXN.
  //
  // This is the ONE PATH through which modeset_channel writes the row
  // state; every witness and every future ring-3 supervisor calls it
  // rather than mtx_row_transition directly, because the transition
  // table is the FSM.
  // ==========================================================================

  pub let mch_event_apply : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (txn_slot: u64) (ev: u64) (aux: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-002 (#1245): apply one FSM event to one KIND_MODESET_TXN row. Gates: ev valid; txn_slot names a live KIND_MODESET_TXN (mtx_row_of_slot); aux in range per event (mode_slot [1..65535] for SET_MODE, plane_id [0..15] for SET_PLANE); transition legal per §2 table; mtx_row_transition succeeds. Labels prefixed mch_ea_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // txn_slot
        mov r13, rsi;                    // ev
        mov r14, rdx;                    // aux

        mov rdi, r13;
        call mch_ev_valid;
        cmp rax, 0;
        je  mch_ea_bad_ev;

        mov rdi, r12;
        call mtx_row_of_slot;
        cmp rax, 0xFF;
        je  mch_ea_no_txn;
        mov r15, rax;                    // row_id

        mov rdi, r15;
        call mtx_row_state;
        mov rbx, rax;                    // current state

        // Per-event aux check.
        cmp r13, 0x91;                   // SET_MODE
        je  mch_ea_check_mode;
        cmp r13, 0x92;                   // SET_PLANE
        je  mch_ea_check_plane;
        // BEGIN, COMMIT, ABORT ignore aux — refuse if non-zero to keep
        // a future field from being smuggled in.
        cmp r14, 0;
        jne mch_ea_bad_reserved;
        jmp mch_ea_do_transition;

      mch_ea_check_mode:
        cmp r14, 0;
        je  mch_ea_bad_mode;
        mov r10, 0xFFFF;
        cmp r14, r10;
        ja  mch_ea_bad_mode;
        jmp mch_ea_do_transition;

      mch_ea_check_plane:
        cmp r14, 15;
        ja  mch_ea_bad_plane;

      mch_ea_do_transition:
        mov rdi, rbx;
        mov rsi, r13;
        call mch_transition;
        cmp rax, 0xFF;
        je  mch_ea_bad_transition;
        mov rbx, rax;                    // new state

        // Compute the new mode_slot: SET_MODE writes aux; every other
        // event preserves the existing value read from the row.
        cmp r13, 0x91;
        je  mch_ea_write_mode;
        mov rdi, r15;
        call mtx_row_mode;
        mov r14, rax;                    // preserved mode_slot
        jmp mch_ea_write_row;

      mch_ea_write_mode:
        // r14 already holds aux == mode_slot

      mch_ea_write_row:
        mov rdi, r15;
        mov rsi, rbx;
        mov rdx, r14;
        call mtx_row_transition;
        cmp rax, 0;
        jne mch_ea_apply_failed;

        xor rax, rax;
        jmp mch_ea_out;

      mch_ea_bad_ev:
        mov rax, 0xFFFFF71F;
        jmp mch_ea_out;
      mch_ea_no_txn:
        mov rax, 0xFFFFF719;
        jmp mch_ea_out;
      mch_ea_bad_mode:
        mov rax, 0xFFFFF71D;
        jmp mch_ea_out;
      mch_ea_bad_plane:
        mov rax, 0xFFFFF71C;
        jmp mch_ea_out;
      mch_ea_bad_transition:
        mov rax, 0xFFFFF71B;
        jmp mch_ea_out;
      mch_ea_bad_reserved:
        mov rax, 0xFFFFF71A;
        jmp mch_ea_out;
      mch_ea_apply_failed:
        mov rax, 0xFFFFF718;

      mch_ea_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
