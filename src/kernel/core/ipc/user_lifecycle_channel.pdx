// src/kernel/core/ipc/user_lifecycle_channel.pdx — R48.M5-003 (#1539)
//
// Schema + packers for the user_lifecycle_channel — the RPC surface
// through which any KIND_SUPERVISOR-holding client asks user_supervisor
// to create, remove, delegate, or revoke users.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// Same posture as wpa_supplicant_channel.pdx / regdomain_channel.pdx:
// schema + pack/unpack primitives, no endpoint here.  The endpoint
// (KIND_IPC_ENDPOINT holding svc.user_lifecycle, endpoint_id=6) lives
// in user_supervisor.pdx's _init_caps sidecar.
//
// The four verbs are:
//
//   USL_OP_CREATE   {pk_fp_lo, quota, mfa, login_len} -> row_id | err
//   USL_OP_REMOVE   {row_id}                          -> ok | err
//   USL_OP_DELEGATE {parent_row, child_fp_lo, quota}  -> child_row | err
//   USL_OP_REVOKE   {row_id, cascade_flag}            -> revoked_count | err
//
// Each verb encodes a request in one u64 op-arg + a two-word body
// stream on the channel; replies encode the return code in the reply
// hdr's payload.
//
// =============================================================================
// §1  ONE u64 OP CODE + PAYLOAD BAND
// =============================================================================
//
//   [7:0]   op          0x01..0x04
//   [63:8]  reserved    MUST be zero
//
// The reserved band is REFUSED (not masked) so a caller cannot smuggle
// a "cascade override" bit into a CREATE by setting one of the top
// fifty-six bits of op.
//
// =============================================================================
// §2  ERROR BAND 0xFFFFE570..0xFFFFE57F
// =============================================================================

module UserLifecycleChannel = structure {

  pub let USL_OP_CREATE    : u64 = 0x01
  pub let USL_OP_REMOVE    : u64 = 0x02
  pub let USL_OP_DELEGATE  : u64 = 0x03
  pub let USL_OP_REVOKE    : u64 = 0x04
  pub let USL_OP_MAX       : u64 = 0x04

  pub let USL_OK             : u64 = 0
  pub let USL_ERR_BAD_OP     : u64 = 0xFFFFE57F
  pub let USL_ERR_BAD_RSV    : u64 = 0xFFFFE57E
  pub let USL_ERR_BAD_LEN    : u64 = 0xFFFFE57D
  pub let USL_ERR_BAD_FP     : u64 = 0xFFFFE57C
  pub let USL_ERR_BAD_QUOTA  : u64 = 0xFFFFE57B
  pub let USL_ERR_BAD_MFA    : u64 = 0xFFFFE57A
  pub let USL_ERR_BAD_ROW    : u64 = 0xFFFFE579

  pub let USL_PACK_BAD_OP    : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USL_PACK_BAD_RSV   : u64 = 0xFFFFFFFFFFFFFFFE

  // ==========================================================================
  // usl_op_valid(v) -> 1 iff v in [1, 4]
  // ==========================================================================

  pub let usl_op_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-003 (#1539): recognise the four verbs. Labels prefixed usl_ov_.",
      block: {
        cmp rdi, 1;
        jb  usl_ov_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  usl_ov_no;
        mov rax, 1;
        ret;
      usl_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // usl_pack_op(op) -> u64
  //
  // Straight pack of `op` into byte 0; upper fifty-six bits are zero
  // by construction.  A caller that wants to smuggle extra data in
  // the reserved region should be REFUSED at the unpack site, not
  // here — usl_unpack_op is the enforcement primitive.
  // ==========================================================================

  pub let usl_pack_op : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-003 (#1539): pack the verb. Refuses op outside [1, 4] with USL_PACK_BAD_OP. Labels prefixed usl_pop_.",
      block: {
        mov rdi, rdi;
        cmp rdi, 1;
        jb  usl_pop_bad;
        mov r10, 4;
        cmp rdi, r10;
        ja  usl_pop_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      usl_pop_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // usl_unpack_op(word) -> op | USL_ERR_BAD_OP | USL_ERR_BAD_RSV
  //
  // Refuses if reserved bits are set; refuses if op byte is outside
  // the small closed set.
  // ==========================================================================

  pub let usl_unpack_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-003 (#1539): the enforcement primitive. Rejects any word with non-zero bits above byte 0 (BAD_RSV) — that is where a second op or a cascade override would be smuggled. Rejects op outside [1, 4] (BAD_OP). Labels prefixed usl_uop_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        cmp rax, 0;
        jne usl_uop_rsv;
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 1;
        jb  usl_uop_bad;
        mov r10, 4;
        cmp rax, r10;
        ja  usl_uop_bad;
        ret;
      usl_uop_bad:
        mov rax, 0xFFFFE57F;
        ret;
      usl_uop_rsv:
        mov rax, 0xFFFFE57E;
        ret
      }
    }

  // ==========================================================================
  // Body-word encoders — deliberately independent per verb so a caller
  // that mispacks a CREATE cannot silently produce a valid DELEGATE.
  //
  //   CREATE body word 0:  [15:0] mfa | [31:16] login_len | [63:32] rsv=0
  //   CREATE body word 1:  quota_bytes
  //   CREATE body word 2:  pk_fp_lo
  //
  //   REMOVE body word 0:  row_id
  //
  //   DELEGATE body word 0: parent_row (low 8 bits) | [63:8] rsv=0
  //   DELEGATE body word 1: quota
  //   DELEGATE body word 2: child_fp_lo
  //
  //   REVOKE body word 0:  row_id | [63:8] cascade bit @ bit 8
  // ==========================================================================

  pub let usl_create_hdr : (u64, u64) -> u64 !{} @{} =
    fn (mfa: u64) (login_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-003 (#1539): pack CREATE header. Refuses mfa == 0 (BAD_MFA), login_len outside [1, 31] (BAD_LEN). Labels prefixed usl_ch_.",
      block: {
        cmp rdi, 0;
        je  usl_ch_bad_mfa;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  usl_ch_bad_mfa;
        cmp rsi, 1;
        jb  usl_ch_bad_len;
        mov r10, 31;
        cmp rsi, r10;
        ja  usl_ch_bad_len;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      usl_ch_bad_mfa:
        mov rax, 0xFFFFE57A;
        ret;
      usl_ch_bad_len:
        mov rax, 0xFFFFE57D;
        ret
      }
    }

  pub let usl_revoke_word : (u64, u64) -> u64 !{} @{} =
    fn (row_id: u64) (cascade: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M5-003 (#1539): pack REVOKE body word. Refuses row_id >= 64 (BAD_ROW). cascade is a boolean; any non-zero maps to 1. Labels prefixed usl_rw_.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae usl_rw_bad;
        mov rax, rdi;
        and rax, 0xFF;
        cmp rsi, 0;
        je  usl_rw_out;
        mov r10, 1;
        shl r10, 8;
        or  rax, r10;
      usl_rw_out:
        ret;
      usl_rw_bad:
        mov rax, 0xFFFFE579;
        ret
      }
    }
}
