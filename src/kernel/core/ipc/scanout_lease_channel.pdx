// src/kernel/core/ipc/scanout_lease_channel.pdx -- G2.M1-002 (#1444)
//
// Session-type schema for the direct-scanout LEASE channel:
//
//     request_lease(plane_slot, output_slot, timeline_slot,
//                   expiry_ns) -> granted(lease_slot) | denied
//     present(lease_slot, bo_slot, target_scanout_value) -> ok | err
//     release(lease_slot)                                 -> ok | err
//
// The session-type FSM: {request_lease -> (granted | denied) ->
// present* -> release}. The FSM is enforced by the substructural
// type system in paideia-as (v0.27); at kernel level we track it via
// per-channel counters (mints/presents/releases) so a witness can
// assert a channel that presents WITHOUT prior grant is refused.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the lease-control conversation: event ordinals,
// argument-shape validators, small pack/unpack primitives, and the
// seams that call the driver. Same posture as vrr_channel.pdx and
// modeset_channel.pdx.
//
// It is NOT an endpoint (no queue), NOT the driver (no plane cell
// mutated here -- present/revoke delegate to the scanout driver),
// and NOT the mint gate (that lives in kind_scanout_lease.pdx).
//
// =============================================================================
// SECTION 1  EVENT ORDINALS
// =============================================================================
//
//   SLC_EV_REQUEST_LEASE 0xC0  {plane_slot, output_slot,
//                               timeline_slot, expiry_ns}
//   SLC_EV_PRESENT       0xC1  {lease_slot, bo_slot, target_value}
//   SLC_EV_RELEASE       0xC2  {lease_slot}
//
// Ordinals live in the 0xC0 band -- distinct from vrr_channel (0xB0),
// display_sync (0xA0), modeset (0x90) so a dispatcher switching on
// ordinal cannot cross wires.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFF621..0xFFFFF62B (SHARED SUB-BAND)
// =============================================================================
//
// Shared with tiling.pdx (which owns 0xFFFFF62C..0xFFFFF62F band-
// declaration constants); scanout_lease_channel takes the interior
// sub-band 0xFFFFF621..0xFFFFF62B. See kind_scanout_lease.pdx §4 for
// the shared-band pattern and design/architecture/next-wave-derived-
// kinds.md for the ownership note.

module ScanoutLeaseChannel = structure {

  pub let SLC_EV_REQUEST_LEASE : u64 = 0xC0
  pub let SLC_EV_PRESENT       : u64 = 0xC1
  pub let SLC_EV_RELEASE       : u64 = 0xC2
  pub let SLC_EV_MAX           : u64 = 0xC2

  pub let SLC_OK              : u64 = 0
  pub let SLC_BAD_EV          : u64 = 0xFFFFF62B
  pub let SLC_BAD_SLOT        : u64 = 0xFFFFF62A
  pub let SLC_BAD_RESERVED    : u64 = 0xFFFFF629
  pub let SLC_NO_LEASE        : u64 = 0xFFFFF628
  pub let SLC_NOT_GRANTED     : u64 = 0xFFFFF627
  pub let SLC_APPLY_FAILED    : u64 = 0xFFFFF626
  pub let SLC_DENIED          : u64 = 0xFFFFF625
  pub let SLC_BAD_BO          : u64 = 0xFFFFF624
  pub let SLC_BAD_TARGET      : u64 = 0xFFFFF623
  pub let SLC_BAD_EXPIRY      : u64 = 0xFFFFF622
  pub let SLC_RESERVED_PLANE  : u64 = 0xFFFFF621

  pub let SLC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _slc_stats : [u64; 4] = uninit @align(64)

  pub let SLC_ST_REQUESTS  : u64 = 0
  pub let SLC_ST_PRESENTS  : u64 = 1
  pub let SLC_ST_RELEASES  : u64 = 2
  pub let SLC_ST_REFUSED   : u64 = 3

  pub let slc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-002 (#1444): clear schema counters. Labels prefixed slcs_rs_.",
      block: {
        lea r10, [rip + _slc_stats];
        xor rax, rax;
        xor rcx, rcx;
      slcs_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  slcs_rs_loop;
        ret
      }
    }

  pub let slc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-002 (#1444): counter bump. Labels prefixed slcn_.",
      block: {
        cmp rdi, 4;
        jae slcn_out;
        lea r10, [rip + _slc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      slcn_out:
        ret
      }
    }

  pub let slc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-002 (#1444): counter read.",
      block: {
        cmp rdi, 4;
        jae slcs_zero;
        lea r10, [rip + _slc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      slcs_zero:
        xor rax, rax;
        ret
      }
    }

  pub let slc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-002 (#1444): 1 iff ev in {0xC0, 0xC1, 0xC2}. Labels prefixed slcev_.",
      block: {
        mov r10, 0xC0;
        cmp rdi, r10;
        jb  slcev_no;
        mov r10, 0xC2;
        cmp rdi, r10;
        ja  slcev_no;
        mov rax, 1;
        ret;
      slcev_no:
        xor rax, rax;
        ret
      }
    }

  pub let slc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-002 (#1444): 1 iff s < 256. Labels prefixed slcsl_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae slcsl_no;
        mov rax, 1;
        ret;
      slcsl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // slc_apply_request_lease(plane_slot, output_slot, timeline_slot,
  //                         expiry_ns) -> lease_slot | err
  //
  // The compositor-side grant path (G2.M1-003 #1445). Reads the
  // scanout driver's grant seam which:
  //   (1) refuses if plane_slot is reserved (P8, G2.M1-005),
  //   (2) refuses if plane_slot is already leased,
  //   (3) mints a KIND_SCANOUT_LEASE at the next free cap slot,
  //   (4) audits the grant.
  // ==========================================================================
  pub let slc_apply_request_lease : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (plane_slot: u64) (output_slot: u64) (timeline_slot: u64) (expiry_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-002..003 (#1444, #1445): validate args + delegate to scanout driver's grant seam. Bumps REQUESTS on entry; REFUSED on any failure. Labels prefixed slcar_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rdi, r12;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcar_bad_slot;
        mov rdi, r13;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcar_bad_slot;
        mov rdi, r14;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcar_bad_slot;
        cmp r15, 0;
        je  slcar_bad_expiry;

        mov rdi, 0;                      // SLC_ST_REQUESTS
        call slc_note;

        // Delegate. Driver returns lease_slot on success, or
        // 0xFFFFF6xx on failure; propagate as-is.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call scanout_grant;
        cmp rax, 0xFFFFF600;
        jb  slcar_out;
        // Any high error code counts as REFUSED.
        push rax;
        mov rdi, 3;
        call slc_note;
        pop rax;
        jmp slcar_out;

      slcar_bad_slot:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF62A;
        jmp slcar_out;
      slcar_bad_expiry:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF622;

      slcar_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // slc_apply_present(lease_slot, bo_slot, target_value) -> OK | err
  //
  // Direct-scanout present. Refuses if the lease is not GRANTED
  // (revoked or expired). Delegates to scanout_present which programs
  // the display plane's next-buffer register and arms the frame-latch
  // to the target_value (VRR frame-latch, G2.M2-001 #1448).
  // ==========================================================================
  pub let slc_apply_present : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (lease_slot: u64) (bo_slot: u64) (target_value: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-002 (#1444) + G2.M2-001 (#1448): validate slots + delegate to scanout_present. Bumps PRESENTS on success; REFUSED on any failure. Labels prefixed slcap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcap_bad_slot;
        mov rdi, r13;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcap_bad_bo;

        mov rdi, r12;
        call sl_row_of_slot;
        cmp rax, 0xFF;
        je  slcap_no_lease;
        mov rbx, rax;                    // row_id

        // Enforce FSM: only GRANTED (1) may present.
        mov rdi, rbx;
        call sl_row_state;
        cmp rax, 1;
        jne slcap_not_granted;

        mov rdi, 1;                      // SLC_ST_PRESENTS
        call slc_note;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call scanout_present;
        cmp rax, 0;
        jne slcap_failed;

        xor rax, rax;
        jmp slcap_out;

      slcap_bad_slot:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF62A;
        jmp slcap_out;
      slcap_bad_bo:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF624;
        jmp slcap_out;
      slcap_no_lease:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF628;
        jmp slcap_out;
      slcap_not_granted:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF627;
        jmp slcap_out;
      slcap_failed:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF626;

      slcap_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let slc_apply_release : (u64) -> u64 !{mem} @{cap} =
    fn (lease_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-002 (#1444) + G2.M1-004 (#1446): validate slot + delegate to scanout_revoke. Bumps RELEASES on success; REFUSED on failure. Labels prefixed slcax_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call slc_slot_valid;
        cmp rax, 0;
        je  slcax_bad_slot;

        mov rdi, r12;
        call sl_row_of_slot;
        cmp rax, 0xFF;
        je  slcax_no_lease;

        mov rdi, 2;                      // SLC_ST_RELEASES
        call slc_note;

        mov rdi, r12;
        call scanout_revoke;
        cmp rax, 0;
        jne slcax_failed;
        xor rax, rax;
        jmp slcax_out;

      slcax_bad_slot:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF62A;
        jmp slcax_out;
      slcax_no_lease:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF628;
        jmp slcax_out;
      slcax_failed:
        mov rdi, 3;
        call slc_note;
        mov rax, 0xFFFFF626;

      slcax_out:
        pop r12;
        ret
      }
    }
}
