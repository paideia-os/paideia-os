// src/kernel/core/ipc/codec_query_channel.pdx -- R33.M2-005 (#1146)
//
// The SCHEMA of the codec_query_channel session: five RPCs that
// interrogate or configure an Intel HDA codec's widgets and pins.
// Packers and unpackers pinned by arity. NO ENDPOINT. NO TRANSPORT.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session an audio server holds to inspect and
// configure ONE codec. It is NOT an endpoint, NOT a transport, and NOT
// the audio server itself: no queue lives here, no capability is
// minted here, and NO CALL sends a byte across a process boundary.
// `design/ipc/codec-query-channel-schema.md` §7 lists the deferrals.
//
// The session type is:
//
//   codec_query : Channel {
//     ! { codec_read, codec_write }
//     rpc get_widgets(codec_addr) -> get_widgets_reply(count)
//     rpc get_pins   (codec_addr) -> get_pins_reply   (count)
//     rpc set_pin_ctl(codec_addr, node_id, ctl_byte)   -> ack(status)
//     rpc set_gain   (codec_addr, node_id, gain, side) -> ack(status)
//     rpc set_mute   (codec_addr, node_id, mute, side) -> ack(status)
//   }
//
// The effect row `!{codec_read, codec_write}` names the two authorities
// the SESSION carries. The three SET operations require codec_write;
// the two GET operations require only codec_read. A subscriber whose
// capability names codec_read only sees SET requests refused at the
// server, not at this schema -- the schema encodes what the wire
// carries; the authority check is where an audio server holds it.
//
// The schema lives as code -- rather than as a document only -- because
// the packer is the load-bearing artefact: a caller that packed a
// set_pin_ctl payload with the ctl byte in bits [23:16] and a server
// that unpacked it from bits [31:24] disagree on which byte reaches
// the codec, and the wrong ctl byte reaches an amplifier that either
// hushes it or opens a mic path that carries no consent to.
//
// =============================================================================
// §1  ONE u64 REQUESTS AND ONE u64 REPLIES
// =============================================================================
//
// Every request and every reply is one u64. A multi-word frame carries
// an ordering across words a consumer must preserve; a one-word frame
// is atomic against every reader that reads it as a word. The five
// operations fit in one word:
//
//   Requests (RPC op ordinal in bits [7:0], LOW half of the byte
//   domain per hid_event_stream_channel §2 -- events would occupy
//   the HIGH half, and this channel has none):
//
//     GET_WIDGETS   op = 0x01 { codec_addr[15:8] }
//     GET_PINS      op = 0x02 { codec_addr[15:8] }
//     SET_PIN_CTL   op = 0x03 { codec_addr[15:8], node[23:16], ctl[31:24] }
//     SET_GAIN      op = 0x04 { codec_addr[15:8], node[23:16], gain[47:32],
//                               side[63:48] }
//     SET_MUTE      op = 0x05 { codec_addr[15:8], node[23:16], mute_bit[24],
//                               side[31:25] }
//
//   Replies (op ordinal echoed in bits [7:0] so a reply misrouted to
//   the wrong request is caught at the type byte, distinguishing the
//   two GET_ replies from each other and from the SET_ ack):
//
//     GET_WIDGETS_R op = 0x01 { count[31:8]  }
//     GET_PINS_R    op = 0x02 { count[31:8]  }
//     SET_ACK       op = 0xF0 { status[63:8] } (three SET_* ops share one
//                              ack shape; the ack's op byte does NOT echo
//                              the request's op because the request's op
//                              is already part of the RPC round-trip and
//                              a receiver holds both halves in the same
//                              frame -- an echoed op byte would double-
//                              encode the request without adding any
//                              disambiguation the round-trip does not
//                              already give.)
//
// The op ordinal for SET_ACK sits at 0xF0 rather than in the 0x01..0x05
// request block so a dispatcher that switched on the byte cannot route
// a reply as a fresh request: request ops are 0x01..0x05, replies to
// the GET forms echo them back, and 0xF0 is the standalone ack shape.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Every packed frame has RESERVED bit ranges. The packers set them to
// zero; the unpackers refuse a payload that arrives with any of them
// set. Same argument as sensor_read_channel §2: a reserved field that
// a receiver silently masks is a field a later revision cannot use,
// and a set_pin_ctl frame with 32 free bits in the upper half is
// where a caller-supplied VRef override or an amplifier bit would be
// smuggled without a schema version bump.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr not in [0, 15] -> BAD_ADDR (refused, not masked).
// node_id not in [0, 255] -> BAD_NODE.
// ctl_byte not in [0, 255] -> BAD_PAYLOAD.
// gain not in [0, 127] (7-bit HDA field per §7.3.3.7) -> BAD_PAYLOAD.
// side not in {0, 1} -> BAD_PAYLOAD.
// mute_bit not in {0, 1} -> BAD_PAYLOAD.
// Op ordinal not in the request set -> BAD_OP.
//
// The packers refuse. Silent truncation would substitute a prefix
// for the caller's value, and the wrong prefix of a gain byte is an
// amplifier that hushes an output the user expected loud (bit 7 of
// gain would silently drop to zero at 128) or the reverse.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFCC0..0xFFFFFCCF
// =============================================================================
//
// Disjoint from every other in-tree band. Nested inside the HDA
// cluster (0xFFFFFC40..CF) deliberately -- this schema narrates
// codec state, and a code threaded up through the RPC path can name
// which HDA subsystem produced it.
//
// =============================================================================

module CodecQueryChannel = structure {

  // ==========================================================================
  // §1 request / reply ordinals.
  //
  // Request ops occupy the LOW 0x01..0x05 block; the SET_ACK reply
  // sits at 0xF0. A dispatcher switching on the byte cannot mix them.
  // ==========================================================================

  pub let CODEC_Q_OP_GET_WIDGETS : u64 = 0x01
  pub let CODEC_Q_OP_GET_PINS    : u64 = 0x02
  pub let CODEC_Q_OP_SET_PIN_CTL : u64 = 0x03
  pub let CODEC_Q_OP_SET_GAIN    : u64 = 0x04
  pub let CODEC_Q_OP_SET_MUTE    : u64 = 0x05
  pub let CODEC_Q_OP_MAX         : u64 = 0x05

  pub let CODEC_Q_OP_SET_ACK     : u64 = 0xF0

  // Field widths.
  pub let CODEC_Q_ADDR_MAX  : u64 = 16       // codec_addr < 16
  pub let CODEC_Q_NODE_MAX  : u64 = 256      // node_id < 256
  pub let CODEC_Q_CTL_MAX   : u64 = 256      // ctl_byte < 256
  pub let CODEC_Q_GAIN_MAX  : u64 = 128      // gain < 128 (7-bit)
  pub let CODEC_Q_SIDE_MAX  : u64 = 2        // side in {0, 1}
  pub let CODEC_Q_MUTE_MAX  : u64 = 2        // mute in {0, 1}
  pub let CODEC_Q_COUNT_MAX : u64 = 16777216 // count < 2^24

  // ==========================================================================
  // §4 return codes.
  // ==========================================================================

  pub let CODEC_Q_OK           : u64 = 0
  pub let CODEC_Q_BAD_OP       : u64 = 0xFFFFFCCF
  pub let CODEC_Q_BAD_ADDR     : u64 = 0xFFFFFCCE
  pub let CODEC_Q_BAD_NODE     : u64 = 0xFFFFFCCD
  pub let CODEC_Q_BAD_PAYLOAD  : u64 = 0xFFFFFCCC
  pub let CODEC_Q_BAD_RESERVED : u64 = 0xFFFFFCCB
  pub let CODEC_Q_BAD_COUNT    : u64 = 0xFFFFFCCA

  pub let CODEC_Q_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // codec_q_op_valid(op) -> 1 | 0
  //
  // 1 iff op in {GET_WIDGETS, GET_PINS, SET_PIN_CTL, SET_GAIN, SET_MUTE}.
  // Refuses zero and refuses the ack ordinal (0xF0) -- the ack is a
  // REPLY shape; a caller submitting op = 0xF0 as a REQUEST would be
  // asking the server to service its own reply frame.
  // ==========================================================================

  pub let codec_q_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): 1 iff op is in the RPC request set {1..5}. Zero is refused because it is the .bss default for an unset Frame opcode; admitting it would let an uninitialised frame reach a packer. 0xF0 is refused because it is the SET_ACK reply ordinal; a caller submitting it as a request would be asking the server to service its own reply frame. Pure leaf. Labels prefixed cqch_ov_ per reserved-label discipline.",
      block: {
        cmp rdi, 1;
        jb  cqch_ov_no;
        cmp rdi, 5;
        ja  cqch_ov_no;
        mov rax, 1;
        ret;
      cqch_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // codec_q_pack_get_widgets_req(codec_addr) -> u64 | DECODE_BAD
  //
  // Layout: op[7:0]=0x01, codec_addr[15:8], reserved[63:16]=0.
  // ==========================================================================

  pub let codec_q_pack_get_widgets_req : (u64) -> u64 !{} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a GET_WIDGETS request. Gate: codec_addr < 16 else DECODE_BAD (BAD_ADDR class). ARITY ONE pinned by tools/build.sh -- a widened signature would let a caller supply a 'function_group' pre-filter that would let one holder of codec_read see a subset of another's widgets, and the schema-level authority is 'whose codec you may read', not 'which widgets thereof'. Pack: 0x01 | (codec_addr << 8). Pure leaf. Labels prefixed cqch_pgw_.",
      block: {
        cmp rdi, 16;
        jae cqch_pgw_bad;
        mov rax, rdi;
        shl rax, 8;
        or  rax, 0x01;
        ret;
      cqch_pgw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_pack_get_pins_req : (u64) -> u64 !{} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a GET_PINS request. Gate: codec_addr < 16 else DECODE_BAD. ARITY ONE pinned. Same shape as GET_WIDGETS with op = 0x02. Pure leaf. Labels prefixed cqch_pgp_.",
      block: {
        cmp rdi, 16;
        jae cqch_pgp_bad;
        mov rax, rdi;
        shl rax, 8;
        or  rax, 0x02;
        ret;
      cqch_pgp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // codec_q_pack_set_pin_ctl_req(codec_addr, node, ctl) -> u64 | DECODE_BAD
  //
  // Layout: op[7:0]=0x03, codec_addr[15:8], node[23:16], ctl[31:24],
  //         reserved[63:32]=0.
  // ==========================================================================

  pub let codec_q_pack_set_pin_ctl_req : (u64, u64, u64) -> u64 !{} @{} =
    fn (codec_addr: u64, node: u64, ctl: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a SET_PIN_CTL request. Gates in order: (1) codec_addr < 16 else DECODE_BAD (BAD_ADDR). (2) node < 256 else DECODE_BAD (BAD_NODE). (3) ctl < 256 else DECODE_BAD (BAD_PAYLOAD -- the pin control register field is 8 bits per HDA §7.3.3.13). ORDER MATTERS: the addr gate fires before the node gate so a wildly wide addr gets 'that address is out of range' rather than the (also true) 'and the node you named does not fit'. Pack: 0x03 | (addr << 8) | (node << 16) | (ctl << 24). Reserved [63:32] zero by construction. Pure leaf. Labels prefixed cqch_pspc_.",
      block: {
        cmp rdi, 16;
        jae cqch_pspc_bad;
        mov r10, 256;
        cmp rsi, r10;
        jae cqch_pspc_bad;
        cmp rdx, r10;
        jae cqch_pspc_bad;

        mov rax, 0x03;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 24;
        or  rax, r10;
        ret;

      cqch_pspc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // codec_q_pack_set_gain_req(codec_addr, node, gain, side) -> u64 | DECODE_BAD
  //
  // Layout: op[7:0]=0x04, codec_addr[15:8], node[23:16], gain[30:24]
  //         (7-bit), side[31] (1 bit), reserved[63:32]=0.
  // ==========================================================================

  pub let codec_q_pack_set_gain_req : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (codec_addr: u64, node: u64, gain: u64, side: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a SET_GAIN request. Gates: (1) codec_addr < 16, (2) node < 256, (3) gain < 128 (7-bit HDA field), (4) side in {0, 1}. Any refusal -> DECODE_BAD. Pack: 0x04 | (addr << 8) | (node << 16) | (gain << 24) | (side << 31). ARITY FOUR pinned -- a caller-supplied 'group index' or 'ramp' would widen a session-authority decision the receiving audio server holds, not the wire. Pure leaf. Labels prefixed cqch_psg_.",
      block: {
        cmp rdi, 16;
        jae cqch_psg_bad;
        mov r10, 256;
        cmp rsi, r10;
        jae cqch_psg_bad;
        mov r10, 128;
        cmp rdx, r10;
        jae cqch_psg_bad;
        cmp rcx, 2;
        jae cqch_psg_bad;

        mov rax, 0x04;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 24;
        or  rax, r10;
        mov r10, rcx;
        shl r10, 31;
        or  rax, r10;
        ret;

      cqch_psg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // codec_q_pack_set_mute_req(codec_addr, node, mute, side) -> u64 | DECODE_BAD
  //
  // Layout: op[7:0]=0x05, codec_addr[15:8], node[23:16], mute[24],
  //         side[25], reserved[63:26]=0.
  // ==========================================================================

  pub let codec_q_pack_set_mute_req : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (codec_addr: u64, node: u64, mute: u64, side: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a SET_MUTE request. Gates: (1) codec_addr < 16, (2) node < 256, (3) mute in {0, 1}, (4) side in {0, 1}. Pack: 0x05 | (addr << 8) | (node << 16) | (mute << 24) | (side << 25). Pure leaf. Labels prefixed cqch_psm_.",
      block: {
        cmp rdi, 16;
        jae cqch_psm_bad;
        mov r10, 256;
        cmp rsi, r10;
        jae cqch_psm_bad;
        cmp rdx, 2;
        jae cqch_psm_bad;
        cmp rcx, 2;
        jae cqch_psm_bad;

        mov rax, 0x05;
        mov r10, rdi;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 24;
        or  rax, r10;
        mov r10, rcx;
        shl r10, 25;
        or  rax, r10;
        ret;

      cqch_psm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Reply packers.
  //
  // GET_WIDGETS_R / GET_PINS_R carry a widget-or-pin COUNT in [31:8],
  // op echoed in [7:0]. Count bounded at 2^24 so an overflow into
  // reserved [63:32] is refused rather than truncated.
  // ==========================================================================

  pub let codec_q_pack_get_widgets_reply : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a GET_WIDGETS reply. Gate: count < 2^24 else DECODE_BAD (BAD_COUNT). Pack: 0x01 | (count << 8). ARITY ONE pinned. Pure leaf. Labels prefixed cqch_rgw_.",
      block: {
        mov r10, 16777216;
        cmp rdi, r10;
        jae cqch_rgw_bad;
        mov rax, rdi;
        shl rax, 8;
        or  rax, 0x01;
        ret;
      cqch_rgw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_pack_get_pins_reply : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a GET_PINS reply. Gate: count < 2^24 else DECODE_BAD. Pack: 0x02 | (count << 8). Pure leaf. Labels prefixed cqch_rgp_.",
      block: {
        mov r10, 16777216;
        cmp rdi, r10;
        jae cqch_rgp_bad;
        mov rax, rdi;
        shl rax, 8;
        or  rax, 0x02;
        ret;
      cqch_rgp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_pack_set_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): pack a SET_ACK reply. Layout: op = 0xF0 in [7:0], status in [63:8]. No gate on status -- any 56-bit code is legal (SET calls return one of the module's own codes, or the underlying verbs.pdx or KIND_AUDIO_CONTROLLER band). Pack: 0xF0 | (status << 8). Pure leaf. Labels prefixed cqch_ra_.",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xF0;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // Unpackers. Each gates the OP byte before returning a field so a
  // reader that fed the wrong frame in gets DECODE_BAD.
  // ==========================================================================

  pub let codec_q_req_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract op ordinal from a request word. Pure. Labels prefixed cqch_ro_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let codec_q_get_widgets_req_addr : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract codec_addr from a GET_WIDGETS request. Gate: op == 0x01 else DECODE_BAD. Refusing a non-GET_WIDGETS word is what stops a reader from reading a SET_PIN_CTL's node byte as an address. Labels prefixed cqch_gwa_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x01;
        jne cqch_gwa_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, 16;
        jae cqch_gwa_bad;
        ret;
      cqch_gwa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_get_pins_req_addr : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract codec_addr from a GET_PINS request. Gate: op == 0x02. Labels prefixed cqch_gpa_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x02;
        jne cqch_gpa_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, 16;
        jae cqch_gpa_bad;
        ret;
      cqch_gpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_pin_ctl_req_addr : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract codec_addr from a SET_PIN_CTL request. Gate: op == 0x03. Also refuses if reserved [63:32] != 0. Labels prefixed cqch_spca_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x03;
        jne cqch_spca_bad;
        // reserved [63:32]
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne cqch_spca_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      cqch_spca_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_pin_ctl_req_node : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract node from a SET_PIN_CTL request. Gate: op == 0x03. Labels prefixed cqch_spcn_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x03;
        jne cqch_spcn_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret;
      cqch_spcn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_pin_ctl_req_ctl : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract ctl byte from a SET_PIN_CTL request. Gate: op == 0x03. Labels prefixed cqch_spcc_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x03;
        jne cqch_spcc_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret;
      cqch_spcc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_gain_req_gain : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract gain from a SET_GAIN request. Gate: op == 0x04. Gain is a 7-bit field at [30:24]. Labels prefixed cqch_sgg_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x04;
        jne cqch_sgg_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0x7F;
        ret;
      cqch_sgg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_gain_req_side : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract side from a SET_GAIN request. Gate: op == 0x04. Side is bit [31]. Labels prefixed cqch_sgs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x04;
        jne cqch_sgs_bad;
        mov rax, rdi;
        shr rax, 31;
        and rax, 0x1;
        ret;
      cqch_sgs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let codec_q_set_mute_req_mute : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-005 (#1146): extract mute bit from a SET_MUTE request. Gate: op == 0x05. Mute is bit [24]. Labels prefixed cqch_smm_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x05;
        jne cqch_smm_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0x1;
        ret;
