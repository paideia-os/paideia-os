// src/kernel/core/ipc/sensor_read_channel.pdx — R32.M5-003 (#1135)
//
// The SCHEMA of the sensor_read_channel session: one subscribe
// request, one unsubscribe request, and one three-axis sample_stream
// event per subscription. Packers and unpackers pinned by arity.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the read side of the sensor subscription
// pipeline. It is NOT an endpoint, NOT a transport, and NOT the fanout
// itself: no queue lives here, no capability is minted here, and NO
// CALL sends a byte across a process boundary. The companion doc
// `design/ipc/sensor-read-channel-schema.md` §7 lists the deferrals.
//
// The session type is:
//
//   subscribe(sensor_type, rate_hz) ->
//     stream(sample_stream(ts, x, y, z))*
//     unsubscribe
//
// A subscriber sends ONE subscribe request naming the sensor type and
// desired rate, then RECEIVES a stream of sample_stream events until
// it sends one unsubscribe request. There is no reply to subscribe
// (the KIND_SENSOR_CHANNEL mint that a supervisor performs on the
// subscriber's behalf is the acknowledgement) and no reply to
// unsubscribe (the KIND_SENSOR_CHANNEL revoke is the acknowledgement).
//
// The schema lives as code -- rather than as a document only -- because
// the packer is the load-bearing artefact: a subscriber that unpacks
// z from bits [47:32] when the packer wrote it into bits [63:48] reads
// a value from the wrong bit range, and the wrong bit range for an
// angular rate is a gyroscope that reports zero on every axis a
// stabilisation controller was going to correct.
//
// =============================================================================
// §1  TWO-WORD SAMPLE PAYLOAD, EVENT TYPE IN THE HIGH BYTE
// =============================================================================
//
// A three-axis sample does not fit one u64. Each axis is a signed
// 16-bit value (§2), and a timestamp is a 32-bit value in the same
// domain the driver publishes -- so the natural packing is TWO u64
// words per sample_stream event:
//
//   word 0: [63:56] type = 0x91
//           [55:32] reserved zero
//           [31:0]  timestamp (u32 monotonic ticks)
//   word 1: [63:56] type = 0x91 (repeated so a receiver reading only
//                   one word can dispatch on it)
//           [55:48] reserved zero
//           [47:32] z (int16, sign-extended into the field)
//           [31:16] y (int16)
//           [15:0]  x (int16)
//
// A publish over the stream lands as ONE match count from a fanout, so
// the two words travel together and are packed / unpacked as a pair by
// this schema's own functions. The receiver reads both or neither.
//
// The HIGH byte is 0x91 (rather than 0x81..0x84 used by
// hid_event_stream_channel) so a dispatcher switching on the type byte
// cannot route a sensor sample as a keyboard press without noticing.
// Both live above the 0x80 line for the same reason
// hid_event_stream_channel picked the high half.
//
// The three request/response ordinals are separate:
//
//   SUBSCRIBE_REQ    = 0x90    { type, rate_hz }
//   SAMPLE_STREAM    = 0x91    { ts, x, y, z }  (two words)
//   UNSUBSCRIBE_REQ  = 0x92    (no payload)
//
// The three ordinals occupy adjacent codes in the 0x9x block for the
// sensor session; a fifth request (rate-change, calibration) takes the
// next ordinal and adds itself to SENSOR_RC_OP_MAX in the same commit
// that adds a handler for it.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Every packed payload has RESERVED bit ranges. The packers set them
// to zero; the unpackers refuse a payload that arrives with any of
// them set. Same argument as hid_event_stream_channel §2: a reserved
// field that a receiver silently masks is a field a later revision
// cannot use, and a payload with free bits between the axes is where
// a caller-supplied unit tag would be smuggled.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// The packers enforce the width of every field EXACTLY. A sensor type
// not in {ALS, ACCEL, GYRO} is BAD_TYPE (matches kind_sensor_channel
// §4). A rate outside [1, SENSOR_RATE_MAX] is BAD_RATE. An axis
// outside int16's range is BAD_AXIS. Silently truncating any of them
// would substitute a prefix for the caller's value, and the wrong
// prefix of a signed axis is an accelerometer that jumps sign every
// time the wearer walks past the acceleration ceiling.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEF0..0xFFFFFEFF
//
// Sixteen-wide, disjoint from every other in-tree band:
// sensor_hub 0xFFFFFED0..DF, hid_event_stream_channel 0xFFFFFEC0..CF,
// hid_event_stream 0xFFFFFEB0..BF, KIND_SENSOR_CHANNEL 0xFFFFFEA0..AF.
// =============================================================================

module SensorReadChannel = structure {

  // ==========================================================================
  // §1 event / request ordinals (HIGH BYTE, all >= 0x90).
  // ==========================================================================

  pub let SENSOR_RC_EV_SUBSCRIBE_REQ   : u64 = 0x90
  pub let SENSOR_RC_EV_SAMPLE_STREAM   : u64 = 0x91
  pub let SENSOR_RC_EV_UNSUBSCRIBE_REQ : u64 = 0x92
  pub let SENSOR_RC_EV_MIN             : u64 = 0x90
  pub let SENSOR_RC_EV_MAX             : u64 = 0x92

  // Sensor types (mirrored from kind_sensor_channel.pdx §4 to keep
  // the schema self-contained). Same values.
  pub let SENSOR_RC_TYPE_ALS   : u64 = 1
  pub let SENSOR_RC_TYPE_ACCEL : u64 = 2
  pub let SENSOR_RC_TYPE_GYRO  : u64 = 3
  pub let SENSOR_RC_TYPE_MAX   : u64 = 3

  // Rate ceiling mirrored from kind_sensor_channel.pdx §1. A rate that
  // fits here but not in the kind's own bound would be admitted by the
  // schema and refused by the mint -- the same discipline applies.
  pub let SENSOR_RC_RATE_MAX : u64 = 1000

  // ==========================================================================
  // §4 return codes.
  // ==========================================================================

  pub let SENSOR_RC_OK           : u64 = 0
  pub let SENSOR_RC_BAD_EV       : u64 = 0xFFFFFEFF
  pub let SENSOR_RC_BAD_TYPE     : u64 = 0xFFFFFEFE
  pub let SENSOR_RC_BAD_RATE     : u64 = 0xFFFFFEFD
  pub let SENSOR_RC_BAD_AXIS     : u64 = 0xFFFFFEFC
  pub let SENSOR_RC_BAD_TS       : u64 = 0xFFFFFEFB
  pub let SENSOR_RC_BAD_RESERVED : u64 = 0xFFFFFEFA

  pub let SENSOR_RC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // sensor_read_ch_ev_valid(ev) -> 1 | 0
  // ==========================================================================

  pub let sensor_read_ch_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): 1 iff ev is a known ordinal (0x90/0x91/0x92). Three members today. Constrained to the 0x9x half so a dispatcher that switches on the type byte cannot route a sensor payload as an HID event (0x8x) or the reverse. A fourth ordinal added tomorrow adds one arm here and one packer below. Pure leaf. Labels prefixed srch_ev_.",
      block: {
        cmp rdi, 0x90;
        je  srch_ev_yes;
        cmp rdi, 0x91;
        je  srch_ev_yes;
        cmp rdi, 0x92;
        je  srch_ev_yes;
        xor rax, rax;
        ret;
      srch_ev_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // sensor_read_ch_type(word) -> event ordinal
  // ==========================================================================

  pub let sensor_read_ch_type : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): read the event type byte from bits [63:56]. Pure leaf. rax = word >> 56.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        ret
      }
    }

  // ==========================================================================
  // sensor_read_ch_pack_subscribe(type, rate_hz) -> word | DECODE_BAD
  //
  // Layout: [63:56]=0x90, [7:0]=type, [23:8]=rate_hz, [55:24]=reserved.
  //
  // ARITY TWO. A third parameter would be a subscription option
  // (batching, low-power) that reads as a convenience and is a way
  // for a caller to widen its share of the sample budget after the
  // mint gate looked at the rate alone.
  // ==========================================================================

  pub let sensor_read_ch_pack_subscribe : (u64, u64) -> u64 !{} @{} =
    fn (t: u64) (rate_hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): pack a SUBSCRIBE_REQ. Gates: (1) type in [1, SENSOR_RC_TYPE_MAX] else DECODE_BAD (BAD_TYPE class per §3). (2) rate_hz in [1, SENSOR_RC_RATE_MAX] else DECODE_BAD (BAD_RATE class per §3). Pack: type in [7:0], rate in [23:8], ordinal 0x90 in [63:56]. Reserved [55:24] left zero by construction. ARITY TWO pinned by tools/build.sh. Pure leaf. Labels prefixed srch_ps_.",
      block: {
        // type in [1, 3]
        cmp rdi, 1;
        jb  srch_ps_bad;
        cmp rdi, 3;
        ja  srch_ps_bad;

        // rate in [1, 1000]
        cmp rsi, 1;
        jb  srch_ps_bad;
        mov r10, 1000;
        cmp rsi, r10;
        ja  srch_ps_bad;

        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;                    // type [7:0]
        mov r11, rsi;
        mov r10, 0xFFFF;
        and r11, r10;
        shl r11, 8;                      // rate [23:8]
        or  rax, r11;
        mov r10, 0x90;
        shl r10, 56;                     // type ordinal [63:56]
        or  rax, r10;
        ret;

      srch_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sensor_read_ch_sub_type : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract sensor type from a SUBSCRIBE_REQ. Gate: [63:56] == 0x90 else DECODE_BAD. Refusing a non-SUBSCRIBE word is what stops a reader reading a sample_stream x-axis low byte as a sensor type. Pure leaf. Labels prefixed srch_st_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x90;
        je  srch_st_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      srch_st_ok:
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let sensor_read_ch_sub_rate : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract rate_hz from a SUBSCRIBE_REQ. Gate: [63:56] == 0x90 else DECODE_BAD. Pure leaf. Labels prefixed srch_sr_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x90;
        je  srch_sr_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      srch_sr_ok:
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // sensor_read_ch_pack_unsubscribe() -> word
  //
  // Layout: [63:56]=0x92, [55:0]=reserved (zero). ARITY ZERO.
  // ==========================================================================

  pub let sensor_read_ch_pack_unsubscribe : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): pack an UNSUBSCRIBE_REQ. ARITY ZERO -- there is nothing to say beyond 'I'm done'. A parameter here would be a REASON or a MODE, and both are subscriber-side state the receiver would then need a schema branch for; the receiver's response is the same in every case (revoke the KIND_SENSOR_CHANNEL row), so a parameter that never affected the outcome would be a lie in the wire format. rax = 0x92 << 56. Pure leaf. Labels prefixed srch_pu_.",
      block: {
        mov rax, 0x92;
        shl rax, 56;
        ret
      }
    }

  // ==========================================================================
  // sensor_read_ch_pack_sample_word0(ts) -> word | DECODE_BAD
  // sensor_read_ch_pack_sample_word1(x, y, z) -> word | DECODE_BAD
  //
  // Two-word sample_stream event. Both must be packed and both must
  // be unpacked. Packed as two separate calls because the packer
  // signatures stay under SysV six-register limit and the shape of
  // "two words, each self-typed" matches how the stream will deliver
  // them.
  //
  // Layout:
  //   word 0: [63:56]=0x91  [55:32]=reserved  [31:0]=ts
  //   word 1: [63:56]=0x91  [55:48]=reserved
  //           [47:32]=z int16  [31:16]=y int16  [15:0]=x int16
  // ==========================================================================

  pub let sensor_read_ch_pack_sample_word0 : (u64) -> u64 !{} @{} =
    fn (ts: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): pack the FIRST word of a SAMPLE_STREAM event: timestamp in [31:0], ordinal 0x91 in [63:56], reserved [55:32] zero. Gate: ts fits 32 bits else DECODE_BAD (BAD_TS class per §3). A timestamp that overflows u32 is a caller who thought a field was wider than it is. Pure leaf. Labels prefixed srch_p0_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  srch_p0_bad;
        mov rax, rdi;
        mov r10, 0x91;
        shl r10, 56;
        or  rax, r10;
        ret;
      srch_p0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // Helper: 1 iff v is a valid sign-extended int16 in a u64 register.
  pub let sensor_read_ch_int16_ok : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): 1 iff (v & 0xFFFFFFFFFFFF8000) == 0 (positive fits) OR == 0xFFFFFFFFFFFF8000 (negative sign-extended). Same idiom as hid_event_stream_channel's mouse_move axis validator. Pure leaf. Labels prefixed srch_iv_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFFFFFF8000;
        and rax, r10;
        cmp rax, 0;
        je  srch_iv_yes;
        cmp rax, r10;
        je  srch_iv_yes;
        xor rax, rax;
        ret;
      srch_iv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let sensor_read_ch_pack_sample_word1 : (u64, u64, u64) -> u64 !{} @{} =
    fn (x: u64) (y: u64) (z: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): pack the SECOND word of a SAMPLE_STREAM event: x [15:0], y [31:16], z [47:32], ordinal 0x91 in [63:56], reserved [55:48] zero. Each axis validated as a sign-extended int16 (helper). Any axis out of range -> DECODE_BAD (BAD_AXIS class per §3). Refusing rather than truncating is what stops an accelerometer from reporting sign-flipped values when the wearer walks past the range ceiling. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed srch_p1_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // x
        mov r13, rsi;                    // y
        mov r14, rdx;                    // z

        mov rdi, r12;
        call sensor_read_ch_int16_ok;
        cmp rax, 0;
        je  srch_p1_bad;
        mov rdi, r13;
        call sensor_read_ch_int16_ok;
        cmp rax, 0;
        je  srch_p1_bad;
        mov rdi, r14;
        call sensor_read_ch_int16_ok;
        cmp rax, 0;
        je  srch_p1_bad;

        mov rax, r12;
        mov r10, 0xFFFF;
        and rax, r10;                    // x [15:0]
        mov r11, r13;
        and r11, r10;
        shl r11, 16;                     // y [31:16]
        or  rax, r11;
        mov r11, r14;
        and r11, r10;
        shl r11, 32;                     // z [47:32]
        or  rax, r11;
        mov r10, 0x91;
        shl r10, 56;                     // type [63:56]
        or  rax, r10;
        jmp srch_p1_out;

      srch_p1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      srch_p1_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sensor_read_ch_sample_ts(word0) -> ts | DECODE_BAD
  // sensor_read_ch_sample_x(word1)  -> x sign-extended
  // sensor_read_ch_sample_y(word1)  -> y sign-extended
  // sensor_read_ch_sample_z(word1)  -> z sign-extended
  // ==========================================================================

  pub let sensor_read_ch_sample_ts : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract timestamp from a SAMPLE_STREAM word0. Gate: [63:56] == 0x91 else DECODE_BAD. Reserved [55:32] must be zero else DECODE_BAD (BAD_RESERVED). rax = word0 & 0xFFFFFFFF. Pure leaf. Labels prefixed srch_ts_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x91;
        jne srch_ts_bad;
        mov rax, rdi;
        shr rax, 32;
        mov r10, 0xFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne srch_ts_bad;
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;
      srch_ts_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // sign-extend low 16 bits of rax
  pub let sensor_read_ch_sample_x : (u64) -> u64 !{} @{} =
    fn (word1: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract x-axis from a SAMPLE_STREAM word1. Gate: [63:56] == 0x91 else DECODE_BAD. Result is the sign-extended int16 in [15:0]. Pure leaf. Labels prefixed srch_sx_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x91;
        jne srch_sx_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  srch_sx_out;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      srch_sx_out:
        ret;
      srch_sx_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sensor_read_ch_sample_y : (u64) -> u64 !{} @{} =
    fn (word1: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract y-axis from a SAMPLE_STREAM word1. Same shape as sample_x, bits [31:16]. Pure leaf. Labels prefixed srch_sy_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x91;
        jne srch_sy_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  srch_sy_out;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      srch_sy_out:
        ret;
      srch_sy_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sensor_read_ch_sample_z : (u64) -> u64 !{} @{} =
    fn (word1: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-003 (#1135): extract z-axis from a SAMPLE_STREAM word1. Same shape as sample_x, bits [47:32]. Reserved [55:48] must be zero else DECODE_BAD. Pure leaf. Labels prefixed srch_sz_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x91;
        jne srch_sz_bad;
        // reserved [55:48]
        mov rax, rdi;
        shr rax, 48;
        and rax, 0xFF;
        cmp rax, 0;
        jne srch_sz_bad;
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFF;
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  srch_sz_out;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      srch_sz_out:
        ret;
      srch_sz_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
