// src/kernel/core/ipc/tb_topology_channel.pdx — R35.M2-004 (#1204)
//
// The SCHEMA of the tb_topology channel — a one-way (kernel ->
// subscriber) stream of topology events delivered on ONE endpoint
// per subscriber. Companion to the CM router walker
// (router_walk.pdx) and to the KIND_TB_DOMAIN capability
// (§0 of kind_tb_domain.pdx).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the WIRE SCHEMA of the tb_topology session. It packs and
// unpacks the two u64 words that make each event record and holds
// the per-endpoint fanout list a subscriber router consults when a
// helper is called. It is NOT an endpoint, NOT a transport, and NOT
// a driver.
//
// The session type is:
//
//   tb_topology : Channel {
//     ( router_appeared      { route_id, parent_route_id, adapter_count }
//     | router_departed      { route_id }
//     | tunnel_established   { tunnel_type, source_adapter, sink_adapter }
//     | tunnel_torn          { tunnel_type, source_adapter, sink_adapter }
//     )*
//   }
//
// Event records flow one way — the kernel writes them; subscribers
// only read. There is no request/reply structure; a subscriber that
// wants to correlate with a request (e.g. an initiated bandwidth
// negotiation) does so through the capability system it derives
// from.
//
// =============================================================================
// §1  TWO u64 EVENT RECORDS
// =============================================================================
//
// All four event kinds share a common two-word layout:
//
//   Word 0: kind[7:0] | field_a[31:8] | field_b[55:32] | reserved[63:56]
//   Word 1: field_c[23:0] | reserved[63:24]
//
// Per event kind:
//
//   router_appeared      k=0  field_a=route_id (24) field_b=parent_route_id (24) field_c=adapter_count (8)
//   router_departed      k=1  field_a=route_id (24) field_b=0                    field_c=0
//   tunnel_established   k=2  field_a=source_adapter (24) field_b=sink_adapter (24) field_c=tunnel_type (8)
//   tunnel_torn          k=3  field_a=source_adapter (24) field_b=sink_adapter (24) field_c=tunnel_type (8)
//
// Reserved bits (word0[63:56], word1[63:24]) are REFUSED, not masked,
// for the same reason hub_topology_channel §2 and every other schema
// in this tree state.
//
// =============================================================================
// §2  ROUTING
// =============================================================================
//
// tb_topology_router_appeared / _departed / _tunnel_established /
// _tunnel_torn are entry points the walker calls. Each walks a
// fixed-capacity subscriber table (16 rows) — small enough that the
// walk is O(subscribers) and there is no per-event heap allocation.
//
// _tb_topology_subs is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/ipc/tb_topology_channel.o`.
//
// =============================================================================
// §3  TUNNEL TYPE ORDINALS (USB4 §11.5)
// =============================================================================
//
//   0 PCIE_UP
//   1 PCIE_DOWN
//   2 DP
//   3 USB3
//   4 HOST_INTERFACE
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF9B0..0xFFFFF9BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: tb_domain 0xFFFFF9F0..FF,
// tb_nhi_probe 0xFFFFF9E0..EF, tb_cm_rings 0xFFFFF9D0..DF,
// tb_router_walk 0xFFFFF9C0..CF).

module TbTopologyChannel = structure {

  // Event kind ordinals (§1).
  pub let TB_TC_KIND_ROUTER_APPEARED    : u64 = 0
  pub let TB_TC_KIND_ROUTER_DEPARTED    : u64 = 1
  pub let TB_TC_KIND_TUNNEL_ESTABLISHED : u64 = 2
  pub let TB_TC_KIND_TUNNEL_TORN        : u64 = 3
  pub let TB_TC_KIND_MAX                : u64 = 3

  // Tunnel type ordinals (§3).
  pub let TB_TUNNEL_PCIE_UP     : u64 = 0
  pub let TB_TUNNEL_PCIE_DOWN   : u64 = 1
  pub let TB_TUNNEL_DP          : u64 = 2
  pub let TB_TUNNEL_USB3        : u64 = 3
  pub let TB_TUNNEL_HOSTIF      : u64 = 4
  pub let TB_TUNNEL_TYPE_MAX    : u64 = 4

  // Field bounds. 24-bit route and adapter.
  pub let TB_TC_FIELD24_MAX : u64 = 0xFFFFFF
  pub let TB_TC_FIELD8_MAX  : u64 = 0xFF

  // Subscriber table.
  pub let TB_TC_SUBS_MAX      : u64 = 16
  pub let TB_TC_SUB_ROW_BYTES : u64 = 32
  //   [+0]  header (in_use[63:56] | reserved)
  //   [+8]  route_id filter (24 bits; 0 = wildcard, matches every event)
  //   [+16] subscriber_endpoint (u64)
  //   [+24] events_delivered (u64)

  pub let mut _tb_topology_subs  : [u64; 64] = uninit @align(64)
  pub let mut _tb_topology_stats : [u64; 8]  = uninit @align(64)

  pub let TB_TC_ST_APPEARED    : u64 = 0
  pub let TB_TC_ST_DEPARTED    : u64 = 1
  pub let TB_TC_ST_ESTABLISHED : u64 = 2
  pub let TB_TC_ST_TORN        : u64 = 3
  pub let TB_TC_ST_DELIVERS    : u64 = 4
  pub let TB_TC_ST_REJECTS     : u64 = 5

  // Failure taxonomy — 0xFFFFF9B0..0xFFFFF9BF.
  pub let TB_TC_OK              : u64 = 0
  pub let TB_TC_BAD_ARG         : u64 = 0xFFFFF9BF
  pub let TB_TC_BAD_KIND        : u64 = 0xFFFFF9BE
  pub let TB_TC_BAD_ROUTE       : u64 = 0xFFFFF9BD
  pub let TB_TC_BAD_ADAPTER     : u64 = 0xFFFFF9BC
  pub let TB_TC_BAD_TUNNEL      : u64 = 0xFFFFF9BB
  pub let TB_TC_BAD_RESERVED    : u64 = 0xFFFFF9BA
  pub let TB_TC_SUB_ENOSPC      : u64 = 0xFFFFF9B9
  pub let TB_TC_SUB_NOT_FOUND   : u64 = 0xFFFFF9B8
  pub let TB_TC_SUB_IN_USE      : u64 = 0xFFFFF9B7

  pub let TB_TC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TB_TC_ROW_NONE   : u64 = 0xFF

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let tb_topology_channel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): clear subscriber table + stats. Labels prefixed ttc_rs_.",
      block: {
        lea r10, [rip + _tb_topology_subs];
        xor rax, rax;
        xor rcx, rcx;
      ttc_rs_subs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  ttc_rs_subs;

        lea r10, [rip + _tb_topology_stats];
        xor rcx, rcx;
      ttc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ttc_rs_stats;
        ret
      }
    } @no_frame

  pub let tb_topology_channel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): honesty pin. Returns 0 until wired to real subscriber endpoints.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ttc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): counter bump. Labels prefixed ttc_nt_.",
      block: {
        cmp rdi, 8;
        jae ttc_nt_out;
        lea r10, [rip + _tb_topology_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ttc_nt_out:
        ret
      }
    } @no_frame

  pub let ttc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): counter read.",
      block: {
        cmp rdi, 8;
        jae ttc_st_zero;
        lea r10, [rip + _tb_topology_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ttc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ttc_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): 1 iff k in [0, 3].",
      block: {
        cmp rdi, 3;
        ja  ttc_kv_no;
        mov rax, 1;
        ret;
      ttc_kv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ttc_route_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): 1 iff r fits in 24 bits.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  ttc_rv_no;
        mov rax, 1;
        ret;
      ttc_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ttc_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): 1 iff a fits in 24 bits (adapter id).",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  ttc_av_no;
        mov rax, 1;
        ret;
      ttc_av_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ttc_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): 1 iff t in [0, 4].",
      block: {
        cmp rdi, 4;
        ja  ttc_tv_no;
        mov rax, 1;
        ret;
      ttc_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packers / unpackers for the two-word event record (§1).
  // ==========================================================================

  pub let ttc_pack_word0 : (u64, u64, u64) -> u64 !{} @{} =
    fn (kind: u64) (field_a: u64) (field_b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): pack kind[7:0] | field_a[31:8] | field_b[55:32]. Refuses out-of-range fields. Labels prefixed ttc_pw0_.",
      block: {
        cmp rdi, 3;
        ja  ttc_pw0_bad;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  ttc_pw0_bad;
        cmp rdx, r10;
        ja  ttc_pw0_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      ttc_pw0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ttc_pack_word1 : (u64) -> u64 !{} @{} =
    fn (field_c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): pack field_c[23:0]. Reserved [63:24] left zero. Refuses field_c > 0xFFFFFF. Labels prefixed ttc_pw1_.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  ttc_pw1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFF;
        ret;
      ttc_pw1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ttc_word0_kind : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): kind from word0[7:0]. Refuses reserved bits [63:56] non-zero. Labels prefixed ttc_wk_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne ttc_wk_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      ttc_wk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ttc_word0_field_a : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): field_a from word0[31:8].",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne ttc_wa_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFFFF;
        ret;
      ttc_wa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ttc_word0_field_b : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): field_b from word0[55:32].",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne ttc_wb_bad;
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFF;
        ret;
      ttc_wb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ttc_word1_field_c : (u64) -> u64 !{} @{} =
    fn (word1: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-004 (#1204): field_c from word1[23:0]. Refuses reserved bits [63:24] non-zero.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        cmp rax, 0;
        jne ttc_wc_bad;
        mov rax, rdi;
        and rax, 0xFFFFFF;
        ret;
      ttc_wc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Subscriber table.
  //
  // THE ONE WRITER of _tb_topology_subs. tools/build.sh confines
  // relocations against `_tb_topology_subs` to this object.
  // ==========================================================================

  pub let ttc_sub_add : (u64, u64) -> u64 !{mem} @{} =
    fn (route_filter: u64) (subscriber_endpoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): register a subscriber at (route_filter, endpoint). route_filter=0 is the wildcard, matches every event. Refuses subscriber_endpoint == 0 (BAD_ARG). Refuses duplicate (filter, endpoint) with SUB_IN_USE. Returns row_id or error. Labels prefixed ttc_sa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // filter
        mov r13, rsi;                    // endpoint

        mov r10, 0xFFFFFF;
        cmp r12, r10;
        ja  ttc_sa_bad;
        cmp r13, 0;
        je  ttc_sa_bad;

        // Uniqueness check.
        xor rbx, rbx;
      ttc_sa_dup_scan:
        cmp rbx, 16;
        jae ttc_sa_dup_done;
        lea r10, [rip + _tb_topology_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ttc_sa_dup_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne ttc_sa_dup_next;
        mov rax, [r10 + 16];
        cmp rax, r13;
        jne ttc_sa_dup_next;
        jmp ttc_sa_dup;
      ttc_sa_dup_next:
        add rbx, 1;
        jmp ttc_sa_dup_scan;
      ttc_sa_dup_done:

        // Free scan.
        xor rbx, rbx;
      ttc_sa_scan:
        cmp rbx, 16;
        jae ttc_sa_full;
        lea r10, [rip + _tb_topology_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ttc_sa_claim;
        add rbx, 1;
        jmp ttc_sa_scan;
      ttc_sa_claim:
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;
        mov [r10 + 16], r13;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp ttc_sa_out;

      ttc_sa_full:
        mov rax, 0xFFFFF9B9;
        jmp ttc_sa_out;
      ttc_sa_dup:
        mov rax, 0xFFFFF9B7;
        jmp ttc_sa_out;
      ttc_sa_bad:
        mov rax, 0xFFFFF9BF;

      ttc_sa_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ttc_sub_remove : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): unregister subscriber row. Labels prefixed ttc_sr_.",
      block: {
        cmp rdi, 16;
        jae ttc_sr_bad;
        lea r10, [rip + _tb_topology_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ttc_sr_bad;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;
      ttc_sr_bad:
        mov rax, 0xFFFFF9B8;
        ret
      }
    } @no_frame

  pub let ttc_sub_row_delivered : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): row delivered counter, or DECODE_BAD.",
      block: {
        cmp rdi, 16;
        jae ttc_srd_bad;
        lea r10, [rip + _tb_topology_subs];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ttc_srd_bad;
        mov rax, [r10 + 24];
        ret;
      ttc_srd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Fanout helper (private).
  //
  // Walks the subscriber table and bumps the delivered counter of
  // every row whose filter matches the event's field_a (route_id
  // for router_*; source_adapter for tunnel_*). filter=0 is the
  // wildcard.
  // ==========================================================================

  pub let ttc_fanout : (u64) -> () !{mem} @{} =
    fn (match_field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): fanout by row-filter match against match_field. Labels prefixed ttc_fn_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;
        xor rbx, rbx;
      ttc_fn_scan:
        cmp rbx, 16;
        jae ttc_fn_done;
        lea r10, [rip + _tb_topology_subs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ttc_fn_next;
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  ttc_fn_hit;
        cmp rax, r12;
        jne ttc_fn_next;
      ttc_fn_hit:
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rdi, 4;                      // DELIVERS
        call ttc_note;
      ttc_fn_next:
        add rbx, 1;
        jmp ttc_fn_scan;

      ttc_fn_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Event entry points — called by router_walk / a future tunnel
  // manager.
  // ==========================================================================

  pub let tb_topology_router_appeared : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (parent_route_id: u64) (adapter_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): router_appeared. Refuses malformed. Fanout by route_id. Labels prefixed ttc_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  ttc_ra_bad_route;
        cmp r12, r10;
        ja  ttc_ra_bad_route;
        cmp r13, 0xFF;
        ja  ttc_ra_bad_arg;

        mov rdi, 0;                      // APPEARED
        call ttc_note;
        mov rdi, rbx;
        call ttc_fanout;
        xor rax, rax;
        jmp ttc_ra_out;

      ttc_ra_bad_route:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BD;
        jmp ttc_ra_out;
      ttc_ra_bad_arg:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BF;

      ttc_ra_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_topology_router_departed : (u64) -> u64 !{mem} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): router_departed. Refuses malformed. Fanout by route_id. Labels prefixed ttc_rd_.",
      block: {
        push rbx;

        mov rbx, rdi;
        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  ttc_rd_bad;

        mov rdi, 1;                      // DEPARTED
        call ttc_note;
        mov rdi, rbx;
        call ttc_fanout;
        xor rax, rax;
        jmp ttc_rd_out;

      ttc_rd_bad:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BD;

      ttc_rd_out:
        pop rbx;
        ret
      }
    }

  pub let tb_topology_tunnel_established : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-004 (#1204): tunnel_established. Fanout by source_adapter (row filter treats adapter ids as 24-bit route-equivalents for the purpose of the wildcard). Labels prefixed ttc_te_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp rbx, 4;                      // TB_TUNNEL_TYPE_MAX
        ja  ttc_te_bad_tunnel;
        mov r10, 0xFFFFFF;
        cmp r12, r10;
        ja  ttc_te_bad_adapter;
        cmp r13, r10;
        ja  ttc_te_bad_adapter;

        mov rdi, 2;                      // ESTABLISHED
        call ttc_note;
        mov rdi, r12;
        call ttc_fanout;
        xor rax, rax;
        jmp ttc_te_out;

      ttc_te_bad_tunnel:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BB;
        jmp ttc_te_out;
      ttc_te_bad_adapter:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BC;

      ttc_te_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_topology_tunnel_torn : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
