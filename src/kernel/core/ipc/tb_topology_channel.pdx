        mov rdi, 3;                      // TORN
        call ttc_note;
        mov rdi, r12;
        call ttc_fanout;
        xor rax, rax;
        jmp ttc_tt_out;

      ttc_tt_bad_tunnel:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BB;
        jmp ttc_tt_out;
      ttc_tt_bad_adapter:
        mov rdi, 5;
        call ttc_note;
        mov rax, 0xFFFFF9BC;

      ttc_tt_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
