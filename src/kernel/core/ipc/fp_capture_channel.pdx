// src/kernel/core/ipc/fp_capture_channel.pdx — R34.M6-002 (#1191)
//
// The SCHEMA of the fp_capture_channel session. Companion to the
// fp_class scaffold (drivers/usb/fp/fp_class.pdx) — this module packs
// and unpacks the u64 frame ordinals a ring-3 authenticator sends and
// receives.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session the class driver and the ring-3
// authenticator share over ONE endpoint. It is NOT an endpoint, NOT a
// transport, and NOT a driver. The session type is:
//
//   fp_capture : Channel {
//     enroll_start; ( enroll_add_frame )*; enroll_commit(-> template_id);
//     ( verify( template_id ) -> { match | no_match | timeout } )*;
//     ( delete_template( template_id ) )*
//   }
//
// Every frame is one u64. Requests carry an op ordinal in the low
// byte; replies carry an outcome ordinal and (when relevant) a
// template_id.
//
// =============================================================================
// §1  ONE u64 FRAMES
// =============================================================================
//
//   ENROLL_START      op = 0x50   { }
//   ENROLL_ADD_FRAME  op = 0x51   { }
//   ENROLL_COMMIT     op = 0x52   { }             -> template_id[63:32] | 0
//   VERIFY            op = 0x53   { tid[63:32] }  -> outcome[15:8]
//   DELETE_TEMPLATE   op = 0x54   { tid[63:32] }
//
// Ordinals occupy 0x50..0x54. Reserved bits ([31:8] on request words,
// [63:16] on the verify reply's outcome half) are REFUSED, not
// masked, for the same reason hub_topology_channel §2 and every other
// schema in this tree state.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFA60..0xFFFFFA6F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time.

module FpCaptureChannel = structure {

  pub let FP_CAP_OP_ENROLL_START     : u64 = 0x50
  pub let FP_CAP_OP_ENROLL_ADD_FRAME : u64 = 0x51
  pub let FP_CAP_OP_ENROLL_COMMIT    : u64 = 0x52
  pub let FP_CAP_OP_VERIFY           : u64 = 0x53
  pub let FP_CAP_OP_DELETE_TEMPLATE  : u64 = 0x54
  pub let FP_CAP_OP_MAX              : u64 = 0x54

  // Verify outcomes (wire-orthogonal to fp_class.pdx FP_VERIFY_*).
  pub let FP_CAP_OUT_MATCH    : u64 = 0
  pub let FP_CAP_OUT_NO_MATCH : u64 = 1
  pub let FP_CAP_OUT_TIMEOUT  : u64 = 2
  pub let FP_CAP_OUT_MAX      : u64 = 2

  pub let FP_CAP_OK           : u64 = 0
  pub let FP_CAP_BAD_OP       : u64 = 0xFFFFFA6F
  pub let FP_CAP_BAD_TEMPLATE : u64 = 0xFFFFFA6E
  pub let FP_CAP_BAD_OUTCOME  : u64 = 0xFFFFFA6D
  pub let FP_CAP_BAD_RESERVED : u64 = 0xFFFFFA6C

  pub let FP_CAP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let fp_cap_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): 1 iff op in [0x50, 0x54]. Labels prefixed fpc_ov_.",
      block: {
        cmp rdi, 0x50;
        jb  fpc_ov_no;
        cmp rdi, 0x54;
        ja  fpc_ov_no;
        mov rax, 1;
        ret;
      fpc_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let fp_cap_outcome_valid : (u64) -> u64 !{} @{} =
    fn (o: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): 1 iff o in {MATCH, NO_MATCH, TIMEOUT}. Labels prefixed fpc_uv_.",
      block: {
        cmp rdi, 2;
        ja  fpc_uv_no;
        mov rax, 1;
        ret;
      fpc_uv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packers.
  // ==========================================================================

  pub let fp_cap_pack_enroll_start : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): ENROLL_START (op only).",
      block: {
        mov rax, 0x50;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_enroll_add_frame : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): ENROLL_ADD_FRAME (op only).",
      block: {
        mov rax, 0x51;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_enroll_commit : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): ENROLL_COMMIT request (op only). Reply carries template_id.",
      block: {
        mov rax, 0x52;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_enroll_commit_reply : (u64) -> u64 !{} @{} =
    fn (template_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): ENROLL_COMMIT reply — op 0x52 | template_id[63:32]. Refuses template_id > 0xFFFFFFFF (must fit in the u32 field). Labels prefixed fpc_pec_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fpc_pec_bad;
        mov rax, 0x52;
        mov r10, rdi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      fpc_pec_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_verify : (u64) -> u64 !{} @{} =
    fn (template_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): VERIFY request — op 0x53 | tid[63:32]. Labels prefixed fpc_pv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fpc_pv_bad;
        cmp rdi, 0;
        je  fpc_pv_bad;
        mov rax, 0x53;
        mov r10, rdi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      fpc_pv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_verify_reply : (u64) -> u64 !{} @{} =
    fn (outcome: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): VERIFY reply — op 0x53 | outcome[15:8]. Refuses outcome > 2. Labels prefixed fpc_pvr_.",
      block: {
        cmp rdi, 2;
        ja  fpc_pvr_bad;
        mov rax, 0x53;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      fpc_pvr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_cap_pack_delete_template : (u64) -> u64 !{} @{} =
    fn (template_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): DELETE_TEMPLATE — op 0x54 | tid[63:32]. Refuses tid == 0 or > u32. Labels prefixed fpc_pdt_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fpc_pdt_bad;
        cmp rdi, 0;
        je  fpc_pdt_bad;
        mov rax, 0x54;
        mov r10, rdi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      fpc_pdt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Unpackers.
  // ==========================================================================

  pub let fp_cap_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): op ordinal from low byte.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let fp_cap_template_id : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): template_id from bits [63:32]. Gates op in {0x52 (commit reply), 0x53 (verify req), 0x54 (delete)}. Labels prefixed fpc_utid_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x52;
        je  fpc_utid_ok;
        cmp rax, 0x53;
        je  fpc_utid_ok;
        cmp rax, 0x54;
        je  fpc_utid_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      fpc_utid_ok:
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_cap_outcome : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): outcome ordinal from bits [15:8]. Gates op == 0x53. Labels prefixed fpc_uo_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x53;
        jne fpc_uo_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      fpc_uo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
