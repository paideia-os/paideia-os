// src/kernel/core/ipc/hid_event_stream_channel.pdx — R32.M3-004 (#1128)
//
// The SCHEMA of the hid_event_stream channel: four stream events
// (KBD_PRESS, KBD_RELEASE, MOUSE_MOVE, MOUSE_CLICK) packed into one
// u64 each, with the event type in the HIGH byte and the payload in
// the low bits. The packers and unpackers that discharge that schema.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the fanout stream `event_stream.pdx` (#1127)
// carries. It is NOT an endpoint, NOT a transport, and NOT the fanout
// itself: no queue lives here, no capability is minted here, and NO
// CALL sends a byte across a process boundary. The companion
// `design/ipc/hid-event-stream-session.md` §7 lists the deferrals in
// the same shape kind_hid_event.pdx §3 lists its own.
//
// The schema lives as code -- rather than as a document only -- because
// the packer is the load-bearing artefact: a subscriber that unpacks
// scancode from bits [23:8] when the packer wrote it into bits [15:0]
// reads a value from the wrong bit range, and the wrong bit range for
// a scancode is a keymap that translates a shifted 'A' into an
// unrelated key. tools/build.sh confines the pack/unpack signatures so
// a fifth parameter cannot smuggle a caller-supplied ceiling or a
// third coordinate.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, EVENT TYPE IN THE HIGH BYTE
// =============================================================================
//
// A payload that spans multiple words has an ordering across the words
// a consumer must preserve; a payload that is one word is atomic
// against every reader that reads it as a word. The design chooses
// one word for all four events -- KBD_PRESS, KBD_RELEASE, MOUSE_MOVE,
// MOUSE_CLICK -- and pins the event type in bits [63:56] so that a
// single-byte read at offset 7 of the packed word yields the event
// discriminant without decoding the payload.
//
// The HIGH byte was chosen (rather than the low) for the same reason
// battery_channel and backlight_channel put their event ordinals
// >= 0x80: a dispatcher switching on a byte-field cannot accidentally
// route a scancode as an event type without crossing the 0x80 line.
// The event ordinals are 0x81..0x84 (see §2) so a payload whose type
// byte is < 0x80 is refused by the packer's own gate.
//
// A growth pressure -- a wider payload for a multi-touch event, say,
// or an additional axis for a scroll -- is a visible change to §3's
// layout rather than a silent widening of a field that used to be
// one width.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Every packed payload has RESERVED bit ranges: the byte(s) between
// the event type and the low payload fields, and any high bits above
// the type byte itself. The packers set them to zero; the unpackers
// refuse a payload that arrives with any of them set.
//
// This mirrors kind_backlight.pdx's REPORT op refusing its own
// reserved upper bits: a reserved field that a receiver silently masks
// is a field a later revision cannot use, and a payload with sixteen
// free bits between the scancode and the type byte is where a
// caller-supplied modifier state would be smuggled.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// The packers enforce the width of every field EXACTLY: a scancode
// that does not fit 16 bits is BAD_SCANCODE; a mouse-move axis whose
// signed 16-bit range overflows is BAD_DELTA; a button number that
// does not fit 8 bits is BAD_BUTTON; an edge value other than 0 or 1
// is BAD_EDGE. Silently truncating any of them would substitute a
// prefix for the caller's value, and the wrong prefix of a signed
// axis is a mouse pointer that jumps to the opposite corner of the
// screen when the user gently moves right.
//
// MOUSE_MOVE takes (dx, dy) as INT16 -- range [-32768, 32767]. Callers
// pass them as u64 with the sign extended; the packer refuses any
// value outside int16's range. That refusal treats INT16_MIN
// (-32768 = 0xFFFF8000 in sign-extended u64) and INT16_MAX (32767)
// as INCLUSIVE bounds -- a mouse that reports its extreme deltas is
// not lying; a mouse that reports beyond them is.
//
// MOUSE_CLICK's `edge` is 0 (release) or 1 (press). The packer
// refuses any other value; a caller passing 2 might mean "double" or
// "hover", and admitting either would let a receiver treat one meaning
// as another. No enum widening happens silently.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEC0..0xFFFFFECF
//
// Disjoint from every other in-tree band: hid_event_stream (#1127)
// owns 0xFFFFFEB0..BF, DPAUX backlight 0xFFFFFEA0..AF, PWM backlight
// 0xFFFFFE90..9F, HID_EVENT 0xFFFFFE90..9F (moved), HID_DEVICE
// 0xFFFFFE80..8F, backlight_channel 0xFFFFFE80..8F.
//
// The DECODE_BAD sentinel is 0xFFFFFFFFFFFFFFFF as everywhere else --
// distinct from every gate-level refusal so a caller threading a code
// up through the packer and its consumer can still name which one
// produced it.
// =============================================================================

module HidEventStreamChannel = structure {

  // ==========================================================================
  // §2 event ordinals -- HIGH BYTE. All >= 0x80.
  // ==========================================================================

  pub let HID_EVT_STREAM_CH_EV_KBD_PRESS   : u64 = 0x81
  pub let HID_EVT_STREAM_CH_EV_KBD_RELEASE : u64 = 0x82
  pub let HID_EVT_STREAM_CH_EV_MOUSE_MOVE  : u64 = 0x83
  pub let HID_EVT_STREAM_CH_EV_MOUSE_CLICK : u64 = 0x84
  pub let HID_EVT_STREAM_CH_EV_MIN         : u64 = 0x81
  pub let HID_EVT_STREAM_CH_EV_MAX         : u64 = 0x84

  // ==========================================================================
  // §4 return codes.
  // ==========================================================================

  pub let HID_EVT_STREAM_CH_OK            : u64 = 0
  pub let HID_EVT_STREAM_CH_BAD_EV        : u64 = 0xFFFFFECF
  pub let HID_EVT_STREAM_CH_BAD_SCANCODE  : u64 = 0xFFFFFECE
  pub let HID_EVT_STREAM_CH_BAD_DELTA     : u64 = 0xFFFFFECD
  pub let HID_EVT_STREAM_CH_BAD_BUTTON    : u64 = 0xFFFFFECC
  pub let HID_EVT_STREAM_CH_BAD_EDGE      : u64 = 0xFFFFFECB
  pub let HID_EVT_STREAM_CH_BAD_RESERVED  : u64 = 0xFFFFFECA

  pub let HID_EVT_STREAM_CH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // hid_event_stream_ch_ev_valid(ev) -> 1 | 0
  //
  // 1 iff ev is one of the four defined event ordinals. Constrained
  // to the high half of the byte domain (>= 0x80) so a dispatcher
  // that switches on the type byte cannot route a payload byte as an
  // event or the reverse without crossing 0x80.
  // ==========================================================================

  pub let hid_event_stream_ch_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): 1 iff ev is a known event ordinal. Four members today: KBD_PRESS (0x81), KBD_RELEASE (0x82), MOUSE_MOVE (0x83), MOUSE_CLICK (0x84). Constrained to the high half (>= 0x80) so a dispatcher that switches on the type byte cannot route a payload byte as an event or the reverse. A fifth event ordinal added tomorrow (SCROLL, TOUCH_CONTACT) adds one arm here and one packer below and no other change. Pure leaf. Labels prefixed hesch_ev_.",
      block: {
        cmp rdi, 0x81;
        je  hesch_ev_yes;
        cmp rdi, 0x82;
        je  hesch_ev_yes;
        cmp rdi, 0x83;
        je  hesch_ev_yes;
        cmp rdi, 0x84;
        je  hesch_ev_yes;
        xor rax, rax;
        ret;
      hesch_ev_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_type(word) -> event ordinal
  //
  // Extracts the type byte from a packed word. Pure shift; the
  // reserved-bits gate is a separate function so a caller can decide
  // to read the type first (to dispatch on it) and check reserved bits
  // second.
  // ==========================================================================

  pub let hid_event_stream_ch_type : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): read the event type byte from bits [63:56]. Pure leaf. rax = word >> 56.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_payload_reserved_ok(word) -> 1 | 0
  //
  // 1 iff the reserved bit ranges in the word are all zero, GIVEN the
  // event type (byte [63:56]) that the word carries. Not a bare mask
  // check: KBD_PRESS's reserved range is [55:16], MOUSE_MOVE's is
  // [55:32], MOUSE_CLICK's is [55:9]. Delegated per-event so a growth
  // (a fifth mouse button, a modifier-mask field) is a change to ONE
  // arm of this function -- and to nothing else outside the schema.
  //
  // The event_stream module (#1127) calls this from publish() as its
  // schema-agnostic reserved-bits gate; a payload it refuses is a
  // payload no producer should have packed.
  // ==========================================================================

  pub let hid_event_stream_ch_payload_reserved_ok : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): 1 iff the reserved bit ranges are zero for the event type carried in [63:56]. Per-event dispatch: KBD_PRESS / KBD_RELEASE reserve [55:16] (scancode is [15:0]); MOUSE_MOVE reserves [55:32] (dx [15:0], dy [31:16]); MOUSE_CLICK reserves [55:9] (button [7:0], edge [8]). An unknown type byte returns 0 (a payload whose type this schema does not know can carry no legal reserved-bits layout). PURE leaf. Labels prefixed hesch_pr_ per reserved-label discipline.",
      block: {
        // type = word >> 56
        mov rax, rdi;
        shr rax, 56;

        cmp rax, 0x81;                   // KBD_PRESS
        je  hesch_pr_kbd;
        cmp rax, 0x82;                   // KBD_RELEASE
        je  hesch_pr_kbd;
        cmp rax, 0x83;                   // MOUSE_MOVE
        je  hesch_pr_mv;
        cmp rax, 0x84;                   // MOUSE_CLICK
        je  hesch_pr_cl;
        xor rax, rax;
        ret;

      hesch_pr_kbd:
        // reserved = word[55:16], i.e. (word >> 16) & 0x00FF_FFFF_FFFF.
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits
        and rax, r10;
        cmp rax, 0;
        jne hesch_pr_no;
        mov rax, 1;
        ret;

      hesch_pr_mv:
        // reserved = word[55:32], i.e. (word >> 32) & 0x00FF_FFFF.
        mov rax, rdi;
        shr rax, 32;
        mov r10, 0xFFFFFF;               // 24 bits
        and rax, r10;
        cmp rax, 0;
        jne hesch_pr_no;
        mov rax, 1;
        ret;

      hesch_pr_cl:
        // reserved = word[55:9], i.e. (word >> 9) & 0x007F_FFFF_FFFF_FFFF.
        mov rax, rdi;
        shr rax, 9;
        mov r10, 0x7FFFFFFFFFFFFF;       // 47 bits
        and rax, r10;
        cmp rax, 0;
        jne hesch_pr_no;
        mov rax, 1;
        ret;

      hesch_pr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_pack_kbd_press(scancode) -> word | DECODE_BAD
  //
  // Layout: [63:56]=0x81, [15:0]=scancode, [55:16]=reserved (zero).
  //
  // ARITY ONE. A second parameter would be a modifier bitmap or a
  // repeat count -- both are subscription decisions the receiver makes,
  // not fields the producer smuggles into the wire. A modifier state
  // that arrived in the packed word would let a producer force a
  // KBD_PRESS to be interpreted as a shifted key with no receiver-side
  // modifier tracking involved.
  // ==========================================================================

  pub let hid_event_stream_ch_pack_kbd_press : (u64) -> u64 !{} @{} =
    fn (scancode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): pack a KBD_PRESS event. Gate: scancode fits 16 bits, else DECODE_BAD (BAD_SCANCODE class per §3). Pack: rax = (0x81 << 56) | (scancode & 0xFFFF). Reserved [55:16] left zero by construction. ARITY ONE, pinned by tools/build.sh: a modifier-mask second parameter is how a producer would smuggle receiver-side state into the wire, and modifier tracking is the receiver's -- see §3. Pure leaf. Labels prefixed hesch_pkp_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  hesch_pkp_bad;
        mov rax, rdi;
        and rax, r10;
        mov r10, 0x81;
        shl r10, 56;
        or  rax, r10;
        ret;
      hesch_pkp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_pack_kbd_release(scancode) -> word | DECODE_BAD
  //
  // Same layout as KBD_PRESS, type byte 0x82.
  // ==========================================================================

  pub let hid_event_stream_ch_pack_kbd_release : (u64) -> u64 !{} @{} =
    fn (scancode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): pack a KBD_RELEASE event. Same layout as KBD_PRESS with type byte 0x82. A KBD_RELEASE with no matching prior KBD_PRESS is a receiver-side observation (missed frame, subscriber joined mid-stream) that the schema does not encode into the payload -- the honest observable is the seq gap. Pure leaf. Labels prefixed hesch_pkr_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  hesch_pkr_bad;
        mov rax, rdi;
        and rax, r10;
        mov r10, 0x82;
        shl r10, 56;
        or  rax, r10;
        ret;
      hesch_pkr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_kbd_scancode(word) -> scancode | DECODE_BAD
  //
  // Shared unpacker for KBD_PRESS / KBD_RELEASE. Refuses a word whose
  // type byte is neither 0x81 nor 0x82.
  // ==========================================================================

  pub let hid_event_stream_ch_kbd_scancode : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): extract scancode from a KBD_PRESS/RELEASE payload. Gates: type byte is 0x81 or 0x82; else DECODE_BAD. Reading a scancode out of a MOUSE_MOVE payload would silently return the dx field, which is why the gate refuses. rax = word & 0xFFFF. Pure leaf. Labels prefixed hesch_ks_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x81;
        je  hesch_ks_ok;
        cmp rax, 0x82;
        je  hesch_ks_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hesch_ks_ok:
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_pack_mouse_move(dx, dy) -> word | DECODE_BAD
  //
  // Layout: [63:56]=0x83, [15:0]=dx (int16), [31:16]=dy (int16),
  //         [55:32]=reserved (zero).
  //
  // ARITY TWO, pinned. A third axis (dz) would be a scroll delta and
  // is a separate event type (SCROLL) if it is added at all.
  // ==========================================================================

  pub let hid_event_stream_ch_pack_mouse_move : (u64, u64) -> u64 !{} @{} =
    fn (dx: u64) (dy: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): pack a MOUSE_MOVE event. Gates, for each axis: value is a valid sign-extended int16. Two accepted cases per axis: (a) 0 <= v <= 32767, i.e. v & 0xFFFF8000 == 0. (b) v is a negative int16 sign-extended into u64, i.e. (v & 0xFFFFFFFFFFFF8000) == 0xFFFFFFFFFFFF8000 -- the top 49 bits are all 1, with the sign bit at position 15. Any other value is out of int16's range and refused as DECODE_BAD (BAD_DELTA class per §3). Truncation is not silent -- see §3 for the alternative and its consequence. Pack: mask each axis to 16 bits, place dx in [15:0], dy in [31:16], type in [63:56]. Reserved [55:32] left zero by construction. ARITY TWO pinned by tools/build.sh. Pure leaf. Labels prefixed hesch_pmm_.",
      block: {
        // Validate dx.
        mov rax, rdi;
        mov r10, 0xFFFFFFFFFFFF8000;
        and rax, r10;
        cmp rax, 0;                      // positive fits?
        je  hesch_pmm_dx_ok;
        cmp rax, r10;                    // negative sign-extended?
        jne hesch_pmm_bad;
      hesch_pmm_dx_ok:

        // Validate dy.
        mov rax, rsi;
        mov r10, 0xFFFFFFFFFFFF8000;
        and rax, r10;
        cmp rax, 0;
        je  hesch_pmm_dy_ok;
        cmp rax, r10;
        jne hesch_pmm_bad;
      hesch_pmm_dy_ok:

        // Pack.
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;                    // dx [15:0]
        mov r11, rsi;
        and r11, r10;
        shl r11, 16;                     // dy [31:16]
        or  rax, r11;
        mov r10, 0x83;
        shl r10, 56;                     // type [63:56]
        or  rax, r10;
        ret;

      hesch_pmm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_mouse_dx(word) -> dx (int16, sign-extended to u64)
  // hid_event_stream_ch_mouse_dy(word) -> dy
  //
  // Both refuse a word whose type is not MOUSE_MOVE.
  // ==========================================================================

  pub let hid_event_stream_ch_mouse_dx : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): extract dx from a MOUSE_MOVE payload. Gate: type byte is 0x83; else DECODE_BAD. rax = sign-extend((word & 0xFFFF), 16). Sign extension: if bit 15 is set, OR in 0xFFFFFFFFFFFF0000 to fill the upper bits. This makes the result a valid two's-complement int16 in a u64 register -- a caller who computes `rax + rbx` against another sign-extended int16 gets the right answer. Refusing to unpack from a non-MOUSE_MOVE word is what stops a reader reading a KBD scancode as a mouse dx. Pure leaf. Labels prefixed hesch_dx_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x83;
        je  hesch_dx_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hesch_dx_ok:
        mov rax, rdi;
        and rax, 0xFFFF;
        // Sign-extend from bit 15.
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  hesch_dx_done;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      hesch_dx_done:
        ret
      }
    } @no_frame

  pub let hid_event_stream_ch_mouse_dy : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): extract dy from a MOUSE_MOVE payload. Same shape as dx, taking bits [31:16] and sign-extending from bit 15 of that field. Pure leaf. Labels prefixed hesch_dy_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x83;
        je  hesch_dy_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hesch_dy_ok:
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  hesch_dy_done;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      hesch_dy_done:
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_ch_pack_mouse_click(button, edge) -> word | DECODE_BAD
  //
  // Layout: [63:56]=0x84, [7:0]=button, [8]=edge, [55:9]=reserved (zero).
  //
  // ARITY TWO, pinned. A third parameter -- click count, modifier
  // state -- would let a producer force the receiver's double-click
  // heuristic; that logic is receiver-side.
  // ==========================================================================

  pub let hid_event_stream_ch_pack_mouse_click : (u64, u64) -> u64 !{} @{} =
    fn (button: u64) (edge: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): pack a MOUSE_CLICK event. Gates: (1) button fits 8 bits else DECODE_BAD (BAD_BUTTON class per §3) -- eight bits covers left/right/middle and every side-button vendor number a T14 G4 mouse advertises; a value that does not fit is the caller feeding raw bytes from something else. (2) edge is 0 (release) or 1 (press) else DECODE_BAD (BAD_EDGE class) -- accepting 2 or higher would let a receiver treat 'double-click' or 'hover' as either a press or a release depending on which arm it fell through, and there is no correct answer to that. Pack: type in [63:56], button in [7:0], edge in [8]. Reserved [55:9] left zero. ARITY TWO pinned. Pure leaf. Labels prefixed hesch_pmc_.",
      block: {
        // button fits 8 bits.
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  hesch_pmc_bad;

        // edge is 0 or 1.
        cmp rsi, 1;
        ja  hesch_pmc_bad;

        // Pack.
        mov rax, rdi;
        and rax, r10;                    // button [7:0]
        mov r11, rsi;
        and r11, 1;
        shl r11, 8;                      // edge [8]
        or  rax, r11;
        mov r10, 0x84;
        shl r10, 56;                     // type [63:56]
        or  rax, r10;
        ret;

      hesch_pmc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hid_event_stream_ch_click_button : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): extract button from a MOUSE_CLICK payload. Gate: type byte is 0x84; else DECODE_BAD. rax = word & 0xFF. Refusing a non-CLICK word is what stops a reader reading a MOUSE_MOVE dx's low byte as a button number. Pure leaf. Labels prefixed hesch_cb_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x84;
        je  hesch_cb_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hesch_cb_ok:
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hid_event_stream_ch_click_edge : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-004 (#1128): extract edge from a MOUSE_CLICK payload. Gate: type byte is 0x84; else DECODE_BAD. rax = (word >> 8) & 1. Pure leaf. Labels prefixed hesch_ce_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0x84;
        je  hesch_ce_ok;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hesch_ce_ok:
        mov rax, rdi;
        shr rax, 8;
        and rax, 1;
        ret
      }
    } @no_frame
}
