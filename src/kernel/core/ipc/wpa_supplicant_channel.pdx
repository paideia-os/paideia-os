// src/kernel/core/ipc/wpa_supplicant_channel.pdx — R38.M5-005 (#1313)
//
// Schema of the wpa_supplicant channel: three RPC verbs plus the
// pack/unpack primitives that turn each verb's arguments into one
// u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the RPC surface between a ring-3 wpa
// supervisor (holds KIND_WIFI_KEY sealer authority) and the R32
// crypto server (unseals + programs hardware).  Same posture as
// wifi_control_channel.pdx: schema + packers, no endpoint here.
//
// The three verbs are:
//
//   derive_ptk   {pmk_key_slot, anonce_ref, snonce_ref}  -> ptk_key_slot
//   install_gtk  {gtk_material_ref, key_id}              -> gtk_key_slot
//   install_ptk  {ptk_slot, key_id}                      -> ok
//
// KIND_WIFI_KEY SEALED DISCIPLINE.  Every RPC that carries a key
// carries the SLOT NUMBER of a KIND_WIFI_KEY, not raw material.  The
// receiving side resolves the slot to a row (kind_wifi_key.pdx
// wkey_row_of_slot); the material never crosses the boundary.
//
// A payload arena carries the two nonces and the sealed GTK
// material -- they do not fit in a u64 alongside a slot number, and
// inlining them would defeat the whole point.  Here the packer
// records only the ARENA REFERENCE (24-bit non-zero); the material
// itself is delivered out-of-band via the sealed capability path.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF VERBS
// =============================================================================
//
// Verb ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x90 to avoid overlap with wifi_control_channel's 0x80..0x84).
// A dispatcher that switches on verb cannot accidentally route the
// request as a reply without crossing the 0x90 line.
//
//   WSC_VERB_DERIVE_PTK   0x90  {pmk_key_slot, anonce_ref, snonce_ref}
//   WSC_VERB_INSTALL_GTK  0x91  {gtk_material_ref, key_id}
//   WSC_VERB_INSTALL_PTK  0x92  {ptk_slot, key_id}
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// Each payload has reserved upper bits; the packers set them to zero
// and refuse a payload that arrives with them set.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// key slots fit in 16 bits (non-zero, since slot 0 is .bss default);
// arena refs fit in 24 bits (non-zero); key_id fits in 8 bits, in
// [0, 7] per 802.11-2020 §12.7.6.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF3A0..0xFFFFF3AF
// =============================================================================
//
// Sixteen-wide, disjoint from every in-tree band; adjacent used
// band above: replay_counter 0xFFFFF3B0..BF; adjacent free band
// below: available for future R38.M5+ modules.

module WpaSupplicantChannel = structure {

  // §1 verb ordinals.
  pub let WSC_VERB_DERIVE_PTK  : u64 = 0x90
  pub let WSC_VERB_INSTALL_GTK : u64 = 0x91
  pub let WSC_VERB_INSTALL_PTK : u64 = 0x92
  pub let WSC_VERB_MAX         : u64 = 0x92

  // §3 key_id range.
  pub let WSC_KEY_ID_MAX       : u64 = 7

  // §4 failure taxonomy.
  pub let WSC_OK           : u64 = 0
  pub let WSC_BAD_VERB     : u64 = 0xFFFFF3AF
  pub let WSC_BAD_PMK      : u64 = 0xFFFFF3AE
  pub let WSC_BAD_ANONCE   : u64 = 0xFFFFF3AD
  pub let WSC_BAD_SNONCE   : u64 = 0xFFFFF3AC
  pub let WSC_BAD_GTK_REF  : u64 = 0xFFFFF3AB
  pub let WSC_BAD_KEY_ID   : u64 = 0xFFFFF3AA
  pub let WSC_BAD_PTK      : u64 = 0xFFFFF3A9
  pub let WSC_BAD_RESERVED : u64 = 0xFFFFF3A8
  pub let WSC_UNUSED_A     : u64 = 0xFFFFF3A7
  pub let WSC_UNUSED_B     : u64 = 0xFFFFF3A6
  pub let WSC_UNUSED_C     : u64 = 0xFFFFF3A5
  pub let WSC_UNUSED_D     : u64 = 0xFFFFF3A4
  pub let WSC_UNUSED_E     : u64 = 0xFFFFF3A3
  pub let WSC_UNUSED_F     : u64 = 0xFFFFF3A2
  pub let WSC_UNUSED_G     : u64 = 0xFFFFF3A1
  pub let WSC_UNUSED_H     : u64 = 0xFFFFF3A0

  pub let WSC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // wsc_verb_valid(v) -> 1 | 0
  // ==========================================================================

  pub let wsc_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): 1 iff v is one of the three known verbs (0x90..0x92). Labels prefixed wsc_vv_.",
      block: {
        cmp rdi, 0x90;
        jb  wsc_vv_no;
        cmp rdi, 0x92;
        ja  wsc_vv_no;
        mov rax, 1;
        ret;
      wsc_vv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wsc_pack_derive_ptk(pmk_key_slot, anonce_ref, snonce_ref) -> u64
  //   [15:0]  pmk_key_slot   (non-zero, KIND_WIFI_KEY slot)
  //   [39:16] anonce_ref     (24-bit non-zero arena reference)
  //   [63:40] snonce_ref     (24-bit non-zero arena reference)
  // ==========================================================================

  pub let wsc_pack_derive_ptk : (u64, u64, u64) -> u64 !{} @{} =
    fn (pmk_key_slot: u64) (anonce_ref: u64) (snonce_ref: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): pack DERIVE_PTK request.  Gates: pmk_key_slot fits 16 bits, non-zero (BAD_PMK); anonce_ref in (0, 2^24) (BAD_ANONCE); snonce_ref in (0, 2^24) (BAD_SNONCE). Labels prefixed wsc_pd_.",
      block: {
        cmp rdi, 0;
        je  wsc_pd_bad_pmk;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wsc_pd_bad_pmk;

        cmp rsi, 0;
        je  wsc_pd_bad_a;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  wsc_pd_bad_a;

        cmp rdx, 0;
        je  wsc_pd_bad_s;
        mov r10, 0xFFFFFF;
        cmp rdx, r10;
        ja  wsc_pd_bad_s;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      wsc_pd_bad_pmk:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wsc_pd_bad_a:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret;
      wsc_pd_bad_s:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        ret
      }
    } @no_frame

  pub let wsc_derive_pmk : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract pmk_key_slot. Labels prefixed wsc_dp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let wsc_derive_anonce : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract anonce_ref. Labels prefixed wsc_da_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFFFF;
        ret
      }
    } @no_frame

  pub let wsc_derive_snonce : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract snonce_ref. Labels prefixed wsc_ds_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wsc_pack_install_gtk(gtk_material_ref, key_id) -> u64
  //   [23:0]  gtk_material_ref (24-bit non-zero arena reference)
  //   [31:24] key_id           (0..7)
  //   [63:32] reserved (0)
  // ==========================================================================

  pub let wsc_pack_install_gtk : (u64, u64) -> u64 !{} @{} =
    fn (gtk_material_ref: u64) (key_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): pack INSTALL_GTK. Gates: gtk_material_ref in (0, 2^24); key_id in [0, 7]. Labels prefixed wsc_pig_.",
      block: {
        cmp rdi, 0;
        je  wsc_pig_bad_ref;
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  wsc_pig_bad_ref;

        cmp rsi, 7;
        ja  wsc_pig_bad_kid;

        mov rax, rdi;
        and rax, 0xFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      wsc_pig_bad_ref:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wsc_pig_bad_kid:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret
      }
    } @no_frame

  pub let wsc_install_gtk_ref : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract gtk_material_ref. Labels prefixed wsc_igr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFF;
        ret
      }
    } @no_frame

  pub let wsc_install_gtk_kid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract key_id. Labels prefixed wsc_igk_.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wsc_pack_install_ptk(ptk_slot, key_id) -> u64
  //   [15:0]  ptk_slot (non-zero, KIND_WIFI_KEY slot)
  //   [23:16] key_id   (0..7)
  //   [63:24] reserved (0)
  // ==========================================================================

  pub let wsc_pack_install_ptk : (u64, u64) -> u64 !{} @{} =
    fn (ptk_slot: u64) (key_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): pack INSTALL_PTK. Gates: ptk_slot fits 16 bits, non-zero (BAD_PTK); key_id in [0, 7] (BAD_KEY_ID). Labels prefixed wsc_pip_.",
      block: {
        cmp rdi, 0;
        je  wsc_pip_bad_ptk;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wsc_pip_bad_ptk;

        cmp rsi, 7;
        ja  wsc_pip_bad_kid;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      wsc_pip_bad_ptk:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      wsc_pip_bad_kid:
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret
      }
    } @no_frame

  pub let wsc_install_ptk_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract ptk_slot. Labels prefixed wsc_ips_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let wsc_install_ptk_kid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-005 (#1313): extract key_id. Labels prefixed wsc_ipk_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame
}
