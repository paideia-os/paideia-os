// src/kernel/core/ipc/text_shape_channel.pdx -- G5.M2-003 (#1498)
//
// Session-type schema for the text_shape channel. Carries one
// primary RPC and two support ops:
//
//     shape(runs, script, direction, atlas_slot, features, snum, sden)
//         -> Cap<KIND_TEXT_SHAPE> | err
//     invalidate(shape_slot)
//         -> ok | err   (fired on scale change; IME re-drives)
//     features_hash(features)
//         -> u32 | err  (client reproduces before mint)
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of the shape conversation, called from the
// compositor / semantic-terminal / IME. The client asks for a
// shape; the server runs the shaper, mints one KIND_TEXT_SHAPE, and
// hands the client the cap. On scale change the client can call
// invalidate to drop the sub-pixel cache for that shape.
//
// IME PLUG-IN: the same RPC serves IME preedit -- an IME asks for a
// shape of the preedit run at the current scale, then the display
// server draws it under the caret without the IME needing to touch
// atlas or shaper directly.
//
// =============================================================================
// SECTION 1  EVENT ORDINALS 0xD3..0xD5
// =============================================================================
//
//   TSC_EV_SHAPE          0xD3
//   TSC_EV_INVALIDATE     0xD4
//   TSC_EV_FEATURES_HASH  0xD5
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDD0..0xFFFFEDDF
// =============================================================================

module TextShapeChannel = structure {

  pub let TSC_EV_SHAPE         : u64 = 0xD3
  pub let TSC_EV_INVALIDATE    : u64 = 0xD4
  pub let TSC_EV_FEATURES_HASH : u64 = 0xD5
  pub let TSC_EV_MAX           : u64 = 0xD5

  pub let TSC_OK           : u64 = 0
  pub let TSC_BAD_EV       : u64 = 0xFFFFEDDF
  pub let TSC_BAD_SLOT     : u64 = 0xFFFFEDDE
  pub let TSC_BAD_SCRIPT   : u64 = 0xFFFFEDDD
  pub let TSC_BAD_DIR      : u64 = 0xFFFFEDDC
  pub let TSC_BAD_ATLAS    : u64 = 0xFFFFEDDB
  pub let TSC_BAD_FEATURE  : u64 = 0xFFFFEDDA
  pub let TSC_BAD_LEN      : u64 = 0xFFFFEDD9
  pub let TSC_BAD_SCALE    : u64 = 0xFFFFEDD8
  pub let TSC_NO_SHAPE     : u64 = 0xFFFFEDD7
  pub let TSC_APPLY_FAILED : u64 = 0xFFFFEDD6

  pub let TSC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _tsc_stats : [u64; 4] = uninit @align(64)

  pub let TSC_ST_SHAPES      : u64 = 0
  pub let TSC_ST_INVALIDATES : u64 = 1
  pub let TSC_ST_HASHES      : u64 = 2
  pub let TSC_ST_REFUSED     : u64 = 3

  pub let tsc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-003 (#1498): clear schema counters.",
      block: {
        lea r10, [rip + _tsc_stats];
        xor rax, rax;
        xor rcx, rcx;
      tsc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  tsc_rs_loop;
        ret
      }
    }

  pub let tsc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-003 (#1498): counter bump.",
      block: {
        cmp rdi, 4;
        jae tsc_nt_out;
        lea r10, [rip + _tsc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tsc_nt_out:
        ret
      }
    }

  pub let tsc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-003 (#1498): counter read.",
      block: {
        cmp rdi, 4;
        jae tsc_st_zero;
        lea r10, [rip + _tsc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tsc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let tsc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-003 (#1498): 1 iff ev in [0xD3, 0xD5].",
      block: {
        mov r10, 0xD3;
        cmp rdi, r10;
        jb  tsc_ev_no;
        mov r10, 0xD5;
        cmp rdi, r10;
        ja  tsc_ev_no;
        mov rax, 1;
        ret;
      tsc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let tsc_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-003 (#1498): 1 iff s < 256.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae tsc_sl_no;
        mov rax, 1;
        ret;
      tsc_sl_no:
        xor rax, rax;
        ret
      }
    }

  // ========================================================================
  // tsc_apply_shape(shape_key, script, direction, atlas_slot,
  //                 features_mask, snum, sden, glyph_count,
  //                 extent_w, extent_h) -> row_id | err
  //
  // The one RPC the compositor / IME / semantic-terminal calls. All
  // inputs validated; shaper.pdx computes the features_hash and BiDi
  // split before the mint is attempted; the mint refuses duplicates
  // through ts_find_by_key_scale.
  //
  // Because SysV passes only 6 args in registers and this call takes
  // 10, the schema packs (glyph_count, ext_w, ext_h) into one u64
  // its caller assembles via tsc_pack_geom below.
  // ========================================================================

  // tsc_pack_geom(glyph_count, ext_w, ext_h) -> u64
  //   [15: 0]  glyph_count
  //   [31:16]  ext_w
  //   [47:32]  ext_h
  //   [63:48]  reserved
  pub let tsc_pack_geom : (u64, u64, u64) -> u64 !{} @{} =
    fn (gcount: u64) (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-003 (#1498): pack (glyph_count, ext_w, ext_h) into one u64 so tsc_apply_shape fits in six SysV registers.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  tsc_pg_bad;
        cmp rsi, r10;
        ja  tsc_pg_bad;
        cmp rdx, r10;
        ja  tsc_pg_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      tsc_pg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let tsc_pack_scale : (u64, u64) -> u64 !{} @{} =
    fn (snum: u64) (sden: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-003 (#1498): pack (snum, sden) into one u64 slot.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  tsc_ps_bad;
        cmp rsi, r10;
        ja  tsc_ps_bad;
        cmp rsi, 0;
        je  tsc_ps_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      tsc_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // Six-arg wrapper: tsc_apply_shape(key, script_dir, atlas_slot,
  // features_mask, geom, scale)
  //   script_dir: script[15:0] | direction[23:16]
  //   geom:       glyph_count[15:0] | ext_w[31:16] | ext_h[47:32]
  //   scale:      snum[15:0] | sden[31:16]
  pub let tsc_apply_shape : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (shape_key: u64) (script_dir: u64) (atlas_slot: u64)
       (features_mask: u64) (geom: u64) (scale: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M2-003 (#1498): the shape RPC's kernel-side apply. Validates every field, computes features_hash, then delegates to ts_tail_alloc after refusing duplicates via ts_find_by_key_scale. Six callee-save pushes (rbx, r12-r15, rbp) + sub rsp, 24 keep the SysV alignment discipline: entry rsp%16 == 8, six pushes give rsp%16 == 8, sub rsp, 24 makes it 0 which SysV requires at every inner call. Stack scratch at [rsp+0]=body1, [rsp+8]=body2, [rsp+16]=body3 holds intermediates across pack calls; rbp carries `geom`, rbx carries `scale`, r12-r15 carry the other four args in callee-save.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 24;                        // scratch: body1@0, body2@8, body3@16

        mov r12, rdi;                       // key
        mov r13, rsi;                       // script_dir
        mov r14, rdx;                       // atlas_slot
        mov r15, rcx;                       // features_mask
        mov rbp, r8;                        // geom
        mov rbx, r9;                        // scale

        // key non-zero.
        cmp r12, 0;
        je  tsc_as_bad_key;

        // Unpack script + direction. r13 is callee-save; no push
        // needed to preserve script/dir across ts_script_valid / ts_dir_valid.
        mov rdi, r13;
        and rdi, 0xFFFF;
        call ts_script_valid;
        cmp rax, 0;
        je  tsc_as_bad_script;

        mov rdi, r13;
        shr rdi, 16;
        and rdi, 0xFF;
        call ts_dir_valid;
        cmp rax, 0;
        je  tsc_as_bad_dir;

        // Atlas slot valid + names a live KIND_FONT_ATLAS.
        mov rdi, r14;
        call tsc_slot_valid;
        cmp rax, 0;
        je  tsc_as_bad_slot;
        mov rdi, r14;
        call fa_row_of_slot;
        mov r10, 0xFF;
        cmp rax, r10;
        je  tsc_as_no_atlas;

        // Features mask valid.
        mov rdi, r15;
        call shp_features_valid;
        cmp rax, 0;
        je  tsc_as_bad_feat;

        // Unpack scale.
        mov rax, rbx;
        mov r10, rax;
        and r10, 0xFFFF;
        mov rdi, r10;
        shr rax, 16;
        and rax, 0xFFFF;
        mov rsi, rax;
        call ts_scale_valid;
        cmp rax, 0;
        je  tsc_as_bad_scale;

        // Unpack geom.
        mov rax, rbp;
        and rax, 0xFFFF;
        mov rdi, rax;
        call ts_glyphs_valid;
        cmp rax, 0;
        je  tsc_as_bad_geom;
        mov rax, rbp;
        shr rax, 16;
        and rax, 0xFFFF;
        mov rdi, rax;
        mov rax, rbp;
        shr rax, 32;
        and rax, 0xFFFF;
        mov rsi, rax;
        call ts_extent_valid;
        cmp rax, 0;
        je  tsc_as_bad_geom;

        // Uniqueness: refuse if (key, snum, sden) already exists.
        mov rax, rbx;
        mov r10, rax;
        and r10, 0xFFFF;
        mov rsi, r10;
        shr rax, 16;
        and rax, 0xFFFF;
        mov rdx, rax;
        mov rdi, r12;
        call ts_find_by_key_scale;
        mov r10, 0xFF;
        cmp rax, r10;
        jne tsc_as_dup;

        // Fold features into hash.
        mov rdi, r15;
        call shp_apply_features;
        mov r10, rax;
        // Pack body1 -> [rsp + 0].
        mov rdi, r13;
        and rdi, 0xFFFF;                    // script
        mov rsi, r13;
        shr rsi, 16;
        and rsi, 0xFF;                      // direction
        mov rdx, r10;
        call ts_body1_pack;
        mov [rsp + 0], rax;

        // Pack body2 -> [rsp + 8].
        mov rdi, r14;                       // atlas_slot
        mov rax, rbp;
        and rax, 0xFFFF;
        mov rsi, rax;                       // glyph_count
        mov rax, rbp;
        shr rax, 16;
        and rax, 0xFFFF;
        mov rdx, rax;                       // ext_w
        mov rax, rbp;
        shr rax, 32;
        and rax, 0xFFFF;
        mov rcx, rax;                       // ext_h
        call ts_body2_pack;
        mov [rsp + 8], rax;

        // Pack body3 -> [rsp + 16].
        mov rax, rbx;
        and rax, 0xFFFF;
        mov rdi, rax;                       // snum
        mov rax, rbx;
        shr rax, 16;
        and rax, 0xFFFF;
        mov rsi, rax;                       // sden
        mov rdx, 0;                         // flags
        call ts_body3_pack;
        mov [rsp + 16], rax;

        // Pack header.
        mov rdi, 0;                         // parent_slot
        call ts_hdr_pack;

        // ts_tail_alloc(hdr, key, body1, body2, body3)
        mov rdi, rax;                       // hdr
        mov rsi, r12;                       // key
        mov rdx, [rsp + 0];                 // body1
        mov rcx, [rsp + 8];                 // body2
        mov r8,  [rsp + 16];                // body3
        call ts_tail_alloc;

        mov r10, 0xFF;
        cmp rax, r10;
        ja  tsc_as_alloc_err;
        mov [rsp + 0], rax;                 // reuse scratch (body1 no longer needed)
        mov rdi, 0;                         // TSC_ST_SHAPES
        call tsc_note;
        mov rax, [rsp + 0];
        jmp tsc_as_out;

      tsc_as_alloc_err:
        mov [rsp + 0], rax;
        mov rdi, 3;
        call tsc_note;
        mov rax, [rsp + 0];
        jmp tsc_as_out;

      tsc_as_bad_key:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDB;
        jmp tsc_as_out;
      tsc_as_bad_script:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDD;
        jmp tsc_as_out;
      tsc_as_bad_dir:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDC;
        jmp tsc_as_out;
      tsc_as_bad_slot:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDE;
        jmp tsc_as_out;
      tsc_as_no_atlas:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDB;
        jmp tsc_as_out;
      tsc_as_bad_feat:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDA;
        jmp tsc_as_out;
      tsc_as_bad_scale:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDD8;
        jmp tsc_as_out;
      tsc_as_bad_geom:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDD9;
        jmp tsc_as_out;
      tsc_as_dup:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDD6;

      tsc_as_out:
        add rsp, 24;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tsc_apply_invalidate(shape_slot) -> ok | err
  pub let tsc_apply_invalidate : (u64) -> u64 !{mem} @{cap} =
    fn (shape_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M2-003 (#1498) + G5.M3-002 (#1502): invalidate the sub-pixel cache for the row named by shape_slot.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call tsc_slot_valid;
        cmp rax, 0;
        je  tsc_ai_bad_slot;

        mov rdi, r12;
        call ts_row_of_slot;
        mov r10, 0xFF;
        cmp rax, r10;
        je  tsc_ai_no_shape;

        mov rdi, rax;
        call subpx_cache_invalidate;

        mov rdi, 1;                         // TSC_ST_INVALIDATES
        call tsc_note;
        xor rax, rax;
        jmp tsc_ai_out;

      tsc_ai_bad_slot:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDE;
        jmp tsc_ai_out;
      tsc_ai_no_shape:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDD7;

      tsc_ai_out:
        pop r12;
        ret
      }
    }

  // tsc_apply_features_hash(mask) -> hash | err
  pub let tsc_apply_features_hash : (u64) -> u64 !{mem} @{cap} =
    fn (mask: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M2-003 (#1498) + G5.M2-004 (#1499): expose the shaper's hash to clients so they can reproduce features_hash before mint. One callee-save push (r12) + one push r13 preserve mask and hash across the tsc_note call while keeping rsp aligned.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rdi, r12;
        call shp_features_valid;
        cmp rax, 0;
        je  tsc_afh_bad;
        mov rdi, r12;
        call shp_features_hash;
        mov r13, rax;                       // stash hash
        mov rdi, 2;                         // TSC_ST_HASHES
        call tsc_note;
        mov rax, r13;
        jmp tsc_afh_out;

      tsc_afh_bad:
        mov rdi, 3;
        call tsc_note;
        mov rax, 0xFFFFEDDA;

      tsc_afh_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
