// src/kernel/core/ipc/display_topology_channel.pdx — R36.M2-004 (#1242)
//
// Schema of the display-topology channel: three stream events plus
// the pack/unpack primitives that turn a KIND_DISPLAY_OUTPUT row's
// cached fields (or an HPD driver's detected change) into one u64
// and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a stream, and the packers/unpackers that
// discharge that schema. It is NOT an endpoint, NOT a transport, and
// NOT a server: no queue lives here, no capability is minted here,
// and NO CALL sends a byte across a process boundary. Same posture
// as backlight_channel.pdx / battery_channel.pdx.
//
// The three events are:
//
//   output_connected     {output_slot, engine_slot, ddi_index, type}
//   output_disconnected  {output_slot}
//   mode_list_changed    {output_slot, mode_count}
//
// A subscriber that unpacks a field the packer never produced silently
// reads a value from the wrong bit range; tools/build.sh confines the
// packer signatures so a fifth parameter cannot smuggle a caller-
// supplied field.
//
// =============================================================================
// §1  ONE u64 PAYLOADS, HIGH-HALF ORDINALS
// =============================================================================
//
// A stream event whose payload spans multiple words has an ordering
// across the words a consumer must preserve; a one-word payload is
// atomic against every reader that reads it as a word.
//
// Event ordinals occupy the HIGH half of the eight-bit domain
// (>= 0x80). A dispatcher that switches on ordinal cannot accidentally
// route the event as a request or a request as the event without
// crossing the 0x80 line.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// Each payload has reserved upper bits; the packers set them to zero
// and refuse a payload that arrives with them set. A reserved field
// silently masked is a field a later revision cannot use.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// output_slot fits in 16 bits; ddi_index fits in 8 (with DTC_DDI_MAX
// = 7 the actual cap); type fits in 8 (0..3); engine_slot fits in
// 16; mode_count fits in 16. Anything outside these widths is refused
// as DECODE_BAD.
//
// output_slot must be non-zero: 0 is the .bss default for an unset
// slot id and admitting it would let an uninitialised event reach the
// wire.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF750..0xFFFFF75F
// =============================================================================
//
// Disjoint from every in-tree band; adjacent used bands above: edid
// 0xFFFFF760..6F; adjacent free band below: hpd_isr 0xFFFFF740..4F.

module DisplayTopologyChannel = structure {

  // §1's event ordinals.
  pub let DTC_EV_OUTPUT_CONNECTED    : u64 = 0x80
  pub let DTC_EV_OUTPUT_DISCONNECTED : u64 = 0x81
  pub let DTC_EV_MODE_LIST_CHANGED   : u64 = 0x82
  pub let DTC_EV_MAX                 : u64 = 0x82

  // Type ordinals (mirror KindDisplayOutput.DPO_TYPE_*).
  pub let DTC_TYPE_MAX : u64 = 3

  // DDI cap (mirror KindDisplayOutput.DPO_DDI_MAX).
  pub let DTC_DDI_MAX : u64 = 7

  // §4's failure taxonomy.
  pub let DTC_OK           : u64 = 0
  pub let DTC_BAD_EV       : u64 = 0xFFFFF75F
  pub let DTC_BAD_SLOT     : u64 = 0xFFFFF75E
  pub let DTC_BAD_ENGINE   : u64 = 0xFFFFF75D
  pub let DTC_BAD_DDI      : u64 = 0xFFFFF75C
  pub let DTC_BAD_TYPE     : u64 = 0xFFFFF75B
  pub let DTC_BAD_COUNT    : u64 = 0xFFFFF75A
  pub let DTC_BAD_RESERVED : u64 = 0xFFFFF759

  pub let DTC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // dtc_ev_valid(ev) -> 1 | 0
  // ==========================================================================

  pub let dtc_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): 1 iff ev is a known event ordinal in {0x80, 0x81, 0x82}. Constrained to the high half so a dispatcher that switched on ordinal cannot route an event as a request. Labels prefixed dtc_ev_.",
      block: {
        cmp rdi, 0x80;
        je  dtc_ev_yes;
        cmp rdi, 0x81;
        je  dtc_ev_yes;
        cmp rdi, 0x82;
        je  dtc_ev_yes;
        xor rax, rax;
        ret;
      dtc_ev_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // dtc_pack_connected(output_slot, engine_slot, ddi_index, type) -> u64
  //
  // Layout:
  //   [15:0]  output_slot (non-zero)
  //   [31:16] engine_slot
  //   [39:32] ddi_index   (0..7)
  //   [47:40] type        (0..3)
  //   [63:48] reserved (0)
  // ==========================================================================

  pub let dtc_pack_connected : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (output_slot: u64) (engine_slot: u64) (ddi_index: u64) (typ: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): pack OUTPUT_CONNECTED payload. Gates: output_slot fits 16 bits and non-zero (BAD_SLOT — a slot of 0 is the .bss default for an unset id); engine_slot fits 16; ddi_index <= DDI_MAX (7); type <= TYPE_MAX (3). Any refusal -> DECODE_BAD. Labels prefixed dtc_pc_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, 0;
        je  dtc_pc_bad;
        cmp rdi, r10;
        ja  dtc_pc_bad;
        cmp rsi, r10;
        ja  dtc_pc_bad;
        cmp rdx, 7;
        ja  dtc_pc_bad;
        cmp rcx, 3;
        ja  dtc_pc_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        ret;

      dtc_pc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dtc_conn_output_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract output_slot. Labels prefixed dtc_cs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let dtc_conn_engine_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract engine_slot. Labels prefixed dtc_ce_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let dtc_conn_ddi : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract ddi_index. Labels prefixed dtc_cd_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  pub let dtc_conn_type : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract type. Labels prefixed dtc_ct_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // dtc_pack_disconnected(output_slot) -> u64
  //
  // Layout:
  //   [15:0]  output_slot (non-zero)
  //   [63:16] reserved (0)
  // ==========================================================================

  pub let dtc_pack_disconnected : (u64) -> u64 !{} @{} =
    fn (output_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): pack OUTPUT_DISCONNECTED payload. Gates: output_slot fits 16 bits and non-zero (BAD_SLOT). Labels prefixed dtc_pd_.",
      block: {
        cmp rdi, 0;
        je  dtc_pd_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dtc_pd_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      dtc_pd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dtc_disc_output_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract output_slot from disconnected payload. Labels prefixed dtc_ds_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // dtc_pack_mode_list_changed(output_slot, mode_count) -> u64
  //
  // Layout:
  //   [15:0]  output_slot (non-zero)
  //   [31:16] mode_count  (0 is allowed — a hot-unplugged panel has
  //                        zero modes and the transition is worth
  //                        emitting)
  //   [63:32] reserved (0)
  // ==========================================================================

  pub let dtc_pack_mode_list_changed : (u64, u64) -> u64 !{} @{} =
    fn (output_slot: u64) (mode_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): pack MODE_LIST_CHANGED payload. Gates: output_slot fits 16 bits and non-zero; mode_count fits 16 bits. Zero mode_count IS legal (a disconnect race can drop the last mode). Labels prefixed dtc_pm_.",
      block: {
        cmp rdi, 0;
        je  dtc_pm_bad;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dtc_pm_bad;
        cmp rsi, r10;
        ja  dtc_pm_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      dtc_pm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dtc_mlc_output_slot : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract output_slot from mode_list_changed payload. Labels prefixed dtc_ms_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let dtc_mlc_mode_count : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-004 (#1242): extract mode_count from mode_list_changed payload. Labels prefixed dtc_mc_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }
}
