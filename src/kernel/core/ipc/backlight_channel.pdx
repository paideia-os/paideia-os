// src/kernel/core/ipc/backlight_channel.pdx — R31.M5-002 (#1107)
//
// The schema of the backlight_channel: three RPCs (GET, SET, GET_RANGE),
// one stream event (BRIGHTNESS_CHANGED), and the pack/unpack primitives
// that turn a row's cached fields (or a compositor's proposed level)
// into one u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a channel, and the packers/unpackers that discharge
// that schema. It is NOT an endpoint, NOT a transport, and NOT a server:
// no queue lives here, no capability is minted here, and NO CALL sends a
// byte across a process boundary. `design/ipc/backlight-channel-schema.md`
// §7 lists the deferrals in the same shape kind_backlight.pdx §4 lists
// its own.
//
// The schema lives as code -- rather than as a document only -- because
// the packer is the load-bearing artefact: a subscriber that unpacks a
// field the packer never produced silently reads a value from the wrong
// bit range, and the wrong bit range for a brightness ordinal is a
// compositor that renders a fade-out as a fade-in. tools/build.sh
// confines the pack/unpack signatures so a fifth parameter cannot
// smuggle a caller-supplied ceiling.
//
// =============================================================================
// §1  ONE u64 REPLIES, ONE u64 EVENT PAYLOADS
// =============================================================================
//
// A reply that spans multiple words has an ordering across the words a
// consumer must preserve; a reply that is one word is atomic against
// every reader that reads it as a word. The design chooses one word for
// GET / SET / GET_RANGE replies and for BRIGHTNESS_CHANGED payloads,
// and pins the field bounds at 16 bits per level (kind_backlight's
// LEVEL_UPPER = 65535, one 16-bit PWM covering every panel).
//
// A growth pressure -- a 24-bit level for a controller that advertises
// deci-percent-per-mille, say -- is a visible change to §3's layout
// rather than a silent widening of a field that used to be one width.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// The SET request, GET reply, GET_RANGE reply and BRIGHTNESS_CHANGED
// payload all carry reserved bit-ranges. The packers set them to zero;
// the packers refuse a payload that arrives with them set. This mirrors
// kind_backlight.pdx's REPORT op refusing its own reserved upper bits:
// a reserved field that a receiver silently masks is a field a later
// revision cannot use, and a payload with forty-eight free bits on a
// SET is where a caller-supplied ceiling would be smuggled.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP (SET IS THE MOST LOAD-BEARING CASE)
// =============================================================================
//
// SET carries a proposed 16-bit level. The packer refuses:
//   * anything that does not fit 16 bits -> BAD_LEVEL,
//   * reserved bits set                  -> BAD_RESERVED.
// The packer DOES NOT compare against brightness_min / brightness_max;
// that gate is in backlight_report_install (kind_backlight.pdx §3), and
// clamping here would let the packer bless a level the row would refuse.
// The REFUSE-OR-INSTALLED discipline the schema doc §3.2 names is what
// makes an out-of-range SET a visible refusal on the wire rather than a
// silent pin at the top.
//
// GET_RANGE refuses max <= min (a degenerate range is an unusable control
// surface, and manufacturing one would let a receiver compute intensities
// in a one-value domain).
//
// BRIGHTNESS_CHANGED refuses prev == new (a "changed" payload that did
// not change is a lie a subscriber would count as a transition), and
// refuses either level out of 16 bits.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFE80..0xFFFFFE8F
// =============================================================================
//
// Disjoint from every other in-tree band: KIND_BACKLIGHT owns
// 0xFFFFFE70..7F, BatteryMonitor owns 0xFFFFFE60..6F, BatteryChannel
// owns 0xFFFFFE50..5F, and the two backlight backend drivers (#1108,
// #1109) claim 0xFFFFFE90..9F and 0xFFFFFEA0..AF. 0xFFFFFE80..8F was
// free.
//
// =============================================================================

module BacklightChannel = structure {

  // ==========================================================================
  // §1's op and event ordinals.
  //
  // RPC ops occupy the LOW half of the eight-bit domain, the event the
  // HIGH half. A dispatcher that switches on the ordinal cannot
  // accidentally route the event as a request or a request as the event
  // without crossing the 0x80 line, which is what the two validators
  // enforce.
  // ==========================================================================

  pub let BACKLIGHT_CH_OP_GET       : u64 = 0x01
  pub let BACKLIGHT_CH_OP_SET       : u64 = 0x02
  pub let BACKLIGHT_CH_OP_GET_RANGE : u64 = 0x03
  pub let BACKLIGHT_CH_OP_MAX       : u64 = 0x03

  pub let BACKLIGHT_CH_EV_BRIGHTNESS_CHANGED : u64 = 0x80
  pub let BACKLIGHT_CH_EV_MAX                : u64 = 0x80

  // ==========================================================================
  // §4's failure taxonomy.
  // ==========================================================================

  pub let BACKLIGHT_CH_OK           : u64 = 0
  pub let BACKLIGHT_CH_BAD_OP       : u64 = 0xFFFFFE8F
  pub let BACKLIGHT_CH_BAD_EV       : u64 = 0xFFFFFE8E
  pub let BACKLIGHT_CH_BAD_LEVEL    : u64 = 0xFFFFFE8D
  pub let BACKLIGHT_CH_BAD_RANGE    : u64 = 0xFFFFFE8C
  pub let BACKLIGHT_CH_BAD_RESERVED : u64 = 0xFFFFFE8B

  // Positional "there is no legal reply to describe". Distinct from every
  // gate-level refusal so a caller threading a code up through the RPC
  // gate and the packer can still name which one produced the sentinel.
  pub let BACKLIGHT_CH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // backlight_channel_op_valid(op) -> 1 | 0
  //
  // 1 iff op in {GET, SET, GET_RANGE}. Refuses zero: zero is the .bss
  // default for an unset opcode field in a Frame header, and admitting
  // it here would let an uninitialised frame reach the packer.
  // ==========================================================================

  pub let backlight_channel_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): 1 iff op is in the RPC ordinal set {GET (1), SET (2), GET_RANGE (3)}. Zero is refused because it is the .bss default for an unset Frame opcode; admitting it would let an uninitialised frame reach the packer and produce a reply for a slot the sender never named. Event ordinals live in the high half (>= 0x80) so a dispatcher that switched on ordinal cannot route the event as a request without crossing the line. Pure leaf. Labels prefixed bchl_ov_ per reserved-label discipline (bch_* is battery_channel's namespace).",
      block: {
        cmp rdi, 1;                      // BACKLIGHT_CH_OP_GET
        je  bchl_ov_yes;
        cmp rdi, 2;                      // BACKLIGHT_CH_OP_SET
        je  bchl_ov_yes;
        cmp rdi, 3;                      // BACKLIGHT_CH_OP_GET_RANGE
        je  bchl_ov_yes;
        xor rax, rax;
        ret;
      bchl_ov_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // backlight_channel_ev_valid(ev) -> 1 | 0
  //
  // 1 iff ev == BRIGHTNESS_CHANGED. One event today, gated in the same
  // shape as battery_channel_ev_valid so a subscriber that switches on
  // ordinal cannot route a request as an event or the reverse.
  // ==========================================================================

  pub let backlight_channel_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): 1 iff ev is a known event ordinal. One member today: BRIGHTNESS_CHANGED (0x80). Constrained to the high half of the ordinal domain (§1) so a subscriber that switches on ordinal cannot route a request as an event or the reverse without crossing the 0x80 line. A second event added tomorrow adds one arm here and one packer below and no other change. Pure leaf. Labels prefixed bchl_ev_.",
      block: {
        mov r10, 0x80;                   // BACKLIGHT_CH_EV_BRIGHTNESS_CHANGED
        cmp rdi, r10;
        je  bchl_ev_yes;
        xor rax, rax;
        ret;
      bchl_ev_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // backlight_channel_pack_get_reply(current, reports) -> u64
  //
  // Schema §3.1. Pack the two GET fields into one u64. No clamping and
  // no silent masking; a field out of its declared width is refused, the
  // reply is the DECODE_BAD sentinel. Refuse-not-clamp is the whole
  // point (§3): a 24-bit `current` silently truncated would render as a
  // panel sitting at level 0xFFFF when the row's cached level was
  // actually 0x100000.
  //
  // ARITY TWO, PINNED. A third parameter -- any third parameter -- is
  // how a caller-supplied ceiling or index would reach the reply, and
  // both are set-once fields the row already knows about. Neither is
  // expressible against the pinned signature.
  // ==========================================================================

  pub let backlight_channel_pack_get_reply : (u64, u64) -> u64 !{} @{} =
    fn (current: u64) (reports: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): pack a GET reply. Two gates: (1) current fits 16 bits (0..0xFFFF); anything wider is refused rather than masked -- masking would silently substitute a 16-bit prefix of a wider value, and the compositor would then act on a level that was never cached. (2) reports fits 32 bits; a lifetime count near 4G is a supervisor that has been running for months, and the width saturation the schema documents is visible rather than silent. Pack: rax = current | ((reports & 0xFFFFFFFF) << 16). Reserved [63:48] is left zero by construction. Pure leaf. Labels prefixed bchl_pg_ per reserved-label discipline.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bchl_pg_bad;

        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  bchl_pg_bad;

        mov rax, rdi;                    // current in [15:0]
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;                    // reports in [47:16]
        ret;

      bchl_pg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let backlight_channel_get_reply_current : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract current from a packed GET reply. rax = reply & 0xFFFF. Pure leaf. Labels prefixed bchl_grc_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let backlight_channel_get_reply_reports : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract reports from a packed GET reply. rax = (reply >> 16) & 0xFFFFFFFF. Pure leaf. Labels prefixed bchl_grr_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // backlight_channel_pack_range_reply(min, max) -> u64
  //
  // Schema §3.3. Refuses max <= min (a degenerate range is unusable and
  // a receiver acting on it computes intensities in a one-value domain),
  // refuses either endpoint out of 16 bits, refuses reserved bits set.
  // ==========================================================================

  pub let backlight_channel_pack_range_reply : (u64, u64) -> u64 !{} @{} =
    fn (min: u64) (max: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): pack a GET_RANGE reply. Gates, in order: (1) min fits 16 bits, (2) max fits 16 bits, (3) max > min. Any refusal -> BACKLIGHT_CH_DECODE_BAD. THE ORDER MATTERS: width refusals fire before the ordering refusal so a caller with a nonsense value gets 'that value has too many bits' rather than the (also true) 'and so it does not compare to min the way you meant'. Pack: rax = min | (max << 16). Reserved [63:32] is left zero. Pure leaf. Labels prefixed bchl_pr_ per reserved-label discipline.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bchl_pr_bad;
        cmp rsi, r10;
        ja  bchl_pr_bad;

        cmp rsi, rdi;
        jbe bchl_pr_bad;                 // max <= min refused

        mov rax, rdi;                    // min in [15:0]
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;                    // max in [31:16]
        ret;

      bchl_pr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let backlight_channel_range_reply_min : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract min from a packed GET_RANGE reply. rax = reply & 0xFFFF. Pure leaf. Labels prefixed bchl_rrn_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let backlight_channel_range_reply_max : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract max from a packed GET_RANGE reply. rax = (reply >> 16) & 0xFFFF. Pure leaf. Labels prefixed bchl_rrx_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // backlight_channel_pack_set_request(level) -> u64
  //
  // Schema §3.2. REFUSE-OR-INSTALLED: refuses a level that does not fit
  // 16 bits (BAD_LEVEL) and refuses reserved bits set (BAD_RESERVED via
  // the same DECODE_BAD sentinel). DOES NOT compare against
  // brightness_min/max -- that gate lives in backlight_report_install
  // (kind_backlight.pdx §3), and clamping here would let the packer
  // bless a level the row would refuse.
  //
  // ARITY ONE. A second parameter is how a caller-supplied ceiling
  // reaches the wire: `pack_set_request(level, ceiling)` reads as a
  // convenience and is a way to smuggle a range assertion into a payload
  // whose semantics the row alone defines.
  // ==========================================================================

  pub let backlight_channel_pack_set_request : (u64) -> u64 !{} @{} =
    fn (level: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): pack a SET request. One argument, and one gate: level fits 16 bits, else BACKLIGHT_CH_DECODE_BAD (the same positional 'no legal payload' sentinel used elsewhere). Since the only field IS the 16-bit level, a value with any bit set at or above position 16 is a reserved-bits-set payload and BAD_LEVEL by construction -- there is no separate reserved argument to be non-zero. The packer does NOT compare against brightness_min or brightness_max: that comparison is backlight_report_install's job, and clamping here would silently substitute the top or floor level for a level the row would have refused, defeating the whole REFUSE-OR-INSTALLED discipline the schema documents in §3.2. Pack: rax = level & 0xFFFF (redundant with the gate; explicit for symmetry with the reply packers). Pure leaf. Labels prefixed bchl_ps_ per reserved-label discipline.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bchl_ps_bad;
        mov rax, rdi;
        ret;
      bchl_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let backlight_channel_set_request_level : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract level from a SET request payload. rax = req & 0xFFFF. Pure leaf. Labels prefixed bchl_srl_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // backlight_channel_pack_brightness_changed(prev, new) -> u64
  //
  // Schema §4.1. Refuses prev == new (a "changed" payload that did not
  // change is a lie the receiver would count as a transition), refuses
  // either level out of 16 bits.
  // ==========================================================================

  pub let backlight_channel_pack_brightness_changed : (u64, u64) -> u64 !{} @{} =
    fn (prev: u64) (new: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): pack a BRIGHTNESS_CHANGED event payload. Gates: (1) prev fits 16 bits, (2) new fits 16 bits, (3) prev != new -- a 'changed' payload that did not change is a lie a subscriber would count as a transition, exactly the class of nonsense §2 refuses. Any refusal -> BACKLIGHT_CH_DECODE_BAD. Pack: rax = prev | (new << 16). Reserved [63:32] left zero. Pure leaf. Labels prefixed bchl_pb_ per reserved-label discipline.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bchl_pb_bad;
        cmp rsi, r10;
        ja  bchl_pb_bad;

        cmp rdi, rsi;
        je  bchl_pb_bad;                 // no-op transition refused

        mov rax, rdi;                    // prev in [15:0]
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;                    // new in [31:16]
        ret;

      bchl_pb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let backlight_channel_bc_prev : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract prev from a BRIGHTNESS_CHANGED payload. rax = payload & 0xFFFF. Pure leaf. Labels prefixed bchl_bcp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let backlight_channel_bc_new : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-002 (#1107): extract new from a BRIGHTNESS_CHANGED payload. rax = (payload >> 16) & 0xFFFF. Pure leaf. Labels prefixed bchl_bcn_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }
}
