// src/kernel/core/ipc/dma_consent_channel.pdx — R35.M4-002 (#1211)
//
// The SCHEMA of the dma_consent channel — a two-way RPC between the
// kernel's dock supervisor (caller) and the compositor's consent
// dialog handler (callee). Companion to KIND_DMA_ATTESTATION
// (kind_dma_attestation.pdx) and to consent_dialog.pdx.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the WIRE SCHEMA of the dma_consent RPC session. It packs and
// unpacks the two u64 words of each request and each response, and it
// holds the per-caller pending-request table so a reply can be routed
// back to the exact caller that issued the request. It is NOT an
// endpoint, NOT a transport, and NOT a UI.
//
// Unlike tb_topology_channel (a ONE-WAY stream), this channel is
// REQUEST/REPLY, because a dock supervisor waiting on a consent
// decision must block until the dialog either succeeds or times out.
// The kernel does not itself paint the dialog; consent_dialog.pdx
// stubs the ring-3 path this schema wraps.
//
// The session type is:
//
//   dma_consent : Channel {
//     ( request_consent  { dock_id, device_desc }
//         -> { granted, denied, pending }
//     | revoke_consent   { dock_id }
//         -> { revoked, not_granted }
//     )*
//   }
//
// device_desc is an opaque u64 that names the device the consent is
// about — the driver-facing bookkeeping resolves it to a real device
// descriptor pointer; this schema treats it as opaque.
//
// =============================================================================
// §1  TWO-WORD REQUEST + TWO-WORD REPLY
// =============================================================================
//
// Both directions share a common two-word layout:
//
//   Word 0: op[7:0] | field_a[31:8] | field_b[55:32] | reserved[63:56]
//   Word 1: field_c[63:0]
//
// Per op:
//
//   REQ_CONSENT       op=0 field_a=dock_id(24) field_b=0             field_c=device_desc(64)
//   REQ_REVOKE        op=1 field_a=dock_id(24) field_b=0             field_c=0
//   RESP_GRANTED      op=2 field_a=dock_id(24) field_b=req_seq(24)   field_c=0
//   RESP_DENIED       op=3 field_a=dock_id(24) field_b=req_seq(24)   field_c=0
//   RESP_PENDING      op=4 field_a=dock_id(24) field_b=req_seq(24)   field_c=0
//   RESP_REVOKED      op=5 field_a=dock_id(24) field_b=req_seq(24)   field_c=0
//   RESP_NOT_GRANTED  op=6 field_a=dock_id(24) field_b=req_seq(24)   field_c=0
//
// req_seq is the sequence number stamped on the pending-request row so
// the reply carries proof of which request produced it — a subscriber
// that received a REPLY for a request it never issued is refused
// SEQ_MISMATCH by the reply-matching helper.
//
// Reserved bits (word0[63:56]) are REFUSED, not masked, for the same
// reason every schema in this tree states.
//
// =============================================================================
// §2  PENDING-REQUEST TABLE (BLOCKING SEMANTICS)
// =============================================================================
//
// dma_consent_req_add stamps one pending row (req_seq, dock_id,
// caller_endpoint) and returns the seq. dma_consent_reply_match
// consumes it when a reply arrives, returning the caller_endpoint so
// the caller can be woken. If the seq does not match a live row, the
// reply is dropped (SEQ_MISMATCH); if a second request arrives for
// the same (dock_id, caller_endpoint) while the first is still
// pending, it is refused (REQ_IN_FLIGHT) — a dock supervisor cannot
// have two overlapping consent requests against the same dock.
//
// _dma_consent_reqs is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/ipc/dma_consent_channel.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF940..0xFFFFF94F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: kind_dma_attestation
// 0xFFFFF950..5F, consent_dialog 0xFFFFF930..3F, iommu_domain
// 0xFFFFF920..2F, consent_revoke 0xFFFFF910..1F).

module DmaConsentChannel = structure {

  // Op ordinals (§1).
  pub let DMA_CC_OP_REQ_CONSENT      : u64 = 0
  pub let DMA_CC_OP_REQ_REVOKE       : u64 = 1
  pub let DMA_CC_OP_RESP_GRANTED     : u64 = 2
  pub let DMA_CC_OP_RESP_DENIED      : u64 = 3
  pub let DMA_CC_OP_RESP_PENDING     : u64 = 4
  pub let DMA_CC_OP_RESP_REVOKED     : u64 = 5
  pub let DMA_CC_OP_RESP_NOT_GRANTED : u64 = 6
  pub let DMA_CC_OP_MAX              : u64 = 6

  // Field bounds. 24-bit dock and req_seq.
  pub let DMA_CC_FIELD24_MAX : u64 = 0xFFFFFF

  // Pending-request table.
  pub let DMA_CC_REQS_MAX       : u64 = 16
  pub let DMA_CC_REQ_ROW_BYTES  : u64 = 32
  //   [+0]  header (in_use[63:56] | reserved)
  //   [+8]  req_seq (u64; monotonic)
  //   [+16] dock_id (24 bits) | caller_endpoint (40 bits at [63:24])
  //   [+24] issued_at (opaque u64; caller-supplied timestamp / ttl)

  pub let mut _dma_consent_reqs  : [u64; 64] = uninit @align(64)
  pub let mut _dma_consent_stats : [u64; 8]  = uninit @align(64)
  pub let mut _dma_consent_seq   : u64       = 0

  pub let DMA_CC_ST_REQUESTS  : u64 = 0
  pub let DMA_CC_ST_REPLIES   : u64 = 1
  pub let DMA_CC_ST_TIMEOUTS  : u64 = 2
  pub let DMA_CC_ST_MISMATCH  : u64 = 3
  pub let DMA_CC_ST_IN_FLIGHT : u64 = 4
  pub let DMA_CC_ST_REJECTS   : u64 = 5

  // Failure taxonomy — 0xFFFFF940..0xFFFFF94F.
  pub let DMA_CC_OK              : u64 = 0
  pub let DMA_CC_BAD_ARG         : u64 = 0xFFFFF94F
  pub let DMA_CC_BAD_OP          : u64 = 0xFFFFF94E
  pub let DMA_CC_BAD_DOCK        : u64 = 0xFFFFF94D
  pub let DMA_CC_BAD_SEQ         : u64 = 0xFFFFF94C
  pub let DMA_CC_BAD_ENDPOINT    : u64 = 0xFFFFF94B
  pub let DMA_CC_BAD_RESERVED    : u64 = 0xFFFFF94A
  pub let DMA_CC_REQ_ENOSPC      : u64 = 0xFFFFF949
  pub let DMA_CC_REQ_IN_FLIGHT   : u64 = 0xFFFFF948
  pub let DMA_CC_SEQ_MISMATCH    : u64 = 0xFFFFF947
  pub let DMA_CC_REQ_NOT_FOUND   : u64 = 0xFFFFF946

  pub let DMA_CC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DMA_CC_ROW_NONE   : u64 = 0xFF

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dma_consent_channel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): clear pending-request table + stats + seq. Labels prefixed dcc_rs_.",
      block: {
        lea r10, [rip + _dma_consent_reqs];
        xor rax, rax;
        xor rcx, rcx;
      dcc_rs_reqs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  dcc_rs_reqs;

        lea r10, [rip + _dma_consent_stats];
        xor rcx, rcx;
      dcc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dcc_rs_stats;

        lea r10, [rip + _dma_consent_seq];
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let dma_consent_channel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): honesty pin. Returns 0 until wired to a real dialog handler.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dcc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): counter bump. Labels prefixed dcc_nt_.",
      block: {
        cmp rdi, 8;
        jae dcc_nt_out;
        lea r10, [rip + _dma_consent_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dcc_nt_out:
        ret
      }
    } @no_frame

  pub let dcc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): counter read.",
      block: {
        cmp rdi, 8;
        jae dcc_st_zero;
        lea r10, [rip + _dma_consent_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dcc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dcc_op_valid : (u64) -> u64 !{} @{} =
    fn (o: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): 1 iff o in [0, 6].",
      block: {
        cmp rdi, 6;
        ja  dcc_ov_no;
        mov rax, 1;
        ret;
      dcc_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dcc_dock_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): 1 iff d non-zero and fits in 24 bits.",
      block: {
        cmp rdi, 0;
        je  dcc_dv_no;
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  dcc_dv_no;
        mov rax, 1;
        ret;
      dcc_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dcc_seq_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): 1 iff s non-zero and fits in 24 bits. seq=0 is reserved as sentinel.",
      block: {
        cmp rdi, 0;
        je  dcc_sv_no;
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  dcc_sv_no;
        mov rax, 1;
        ret;
      dcc_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packers / unpackers for the two-word request/reply record (§1).
  // ==========================================================================

  pub let dcc_pack_word0 : (u64, u64, u64) -> u64 !{} @{} =
    fn (op: u64) (dock_id: u64) (req_seq: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): pack op[7:0] | dock_id[31:8] | req_seq[55:32]. Refuses out-of-range fields. Labels prefixed dcc_pw0_.",
      block: {
        cmp rdi, 6;
        ja  dcc_pw0_bad;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  dcc_pw0_bad;
        cmp rdx, r10;
        ja  dcc_pw0_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dcc_pw0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dcc_pack_word1 : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): pack payload[63:0] (device_desc for REQ_CONSENT; 0 for the others). Labels prefixed dcc_pw1_.",
      block: {
        mov rax, rdi;
        ret
      }
    } @no_frame

  pub let dcc_word0_op : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): op from word0[7:0]. Refuses reserved bits [63:56] non-zero. Labels prefixed dcc_wo_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne dcc_wo_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      dcc_wo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dcc_word0_dock : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): dock_id from word0[31:8].",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne dcc_wd_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFFFF;
        ret;
      dcc_wd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dcc_word0_seq : (u64) -> u64 !{} @{} =
    fn (word0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-002 (#1211): req_seq from word0[55:32].",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne dcc_ws_bad;
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFFFF;
        ret;
      dcc_ws_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Pending-request table.
  //
  // THE ONE WRITER of _dma_consent_reqs. tools/build.sh confines
  // relocations against `_dma_consent_reqs` to this object.
  // ==========================================================================

  pub let dma_consent_next_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): monotonic seq allocator. Wraps at 0x1000000 (24 bits) back to 1 — seq=0 is reserved sentinel. Labels prefixed dcc_ns_.",
      block: {
        lea r10, [rip + _dma_consent_seq];
        mov rax, [r10];
        add rax, 1;
        mov r11, 0xFFFFFF;
        cmp rax, r11;
        jbe dcc_ns_store;
        mov rax, 1;
      dcc_ns_store:
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let dma_consent_req_add : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) (caller_endpoint: u64) (issued_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): register a pending request. Refuses caller_endpoint=0 (BAD_ENDPOINT). Refuses in-flight duplicate (REQ_IN_FLIGHT). Returns req_seq or error. Labels prefixed dcc_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // dock_id
        mov r13, rsi;                    // caller_endpoint
        mov r14, rdx;                    // issued_at

        mov rdi, r12;
        call dcc_dock_valid;
        cmp rax, 0;
        je  dcc_ra_bad_dock;

        cmp r13, 0;
        je  dcc_ra_bad_endpoint;

        // Duplicate scan.
        xor rbx, rbx;
      dcc_ra_dup_scan:
        cmp rbx, 16;
        jae dcc_ra_dup_done;
        lea r10, [rip + _dma_consent_reqs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dcc_ra_dup_next;
        mov rax, [r10 + 16];
        mov r11, rax;
        and r11, 0xFFFFFF;
        cmp r11, r12;
        jne dcc_ra_dup_next;
        mov r11, rax;
        shr r11, 24;
        cmp r11, r13;
        jne dcc_ra_dup_next;
        jmp dcc_ra_in_flight;
      dcc_ra_dup_next:
        add rbx, 1;
        jmp dcc_ra_dup_scan;
      dcc_ra_dup_done:

        // Free scan.
        xor rbx, rbx;
      dcc_ra_scan:
        cmp rbx, 16;
        jae dcc_ra_full;
        lea r10, [rip + _dma_consent_reqs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dcc_ra_claim;
        add rbx, 1;
        jmp dcc_ra_scan;

      dcc_ra_claim:
        call dma_consent_next_seq;
        mov r15, rax;                    // seq
        lea r10, [rip + _dma_consent_reqs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r15;

        // Pack dock_id[23:0] | caller_endpoint[63:24].
        mov rax, r12;
        and rax, 0xFFFFFF;
        mov r11, r13;
        shl r11, 24;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov [r10 + 24], r14;

        mov rdi, 0;                      // REQUESTS
        call dcc_note;

        mov rax, r15;
        jmp dcc_ra_out;

      dcc_ra_full:
        mov rdi, 5;
        call dcc_note;
        mov rax, 0xFFFFF949;
        jmp dcc_ra_out;
      dcc_ra_in_flight:
        mov rdi, 4;                      // IN_FLIGHT
        call dcc_note;
        mov rax, 0xFFFFF948;
        jmp dcc_ra_out;
      dcc_ra_bad_dock:
        mov rdi, 5;
        call dcc_note;
        mov rax, 0xFFFFF94D;
        jmp dcc_ra_out;
      dcc_ra_bad_endpoint:
        mov rdi, 5;
        call dcc_note;
        mov rax, 0xFFFFF94B;

      dcc_ra_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_consent_reply_match : (u64) -> u64 !{mem} @{} =
    fn (req_seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): find and consume the pending row for req_seq. Returns caller_endpoint on success (row cleared), SEQ_MISMATCH otherwise. Labels prefixed dcc_rm_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;                    // seq

        mov rdi, r12;
        call dcc_seq_valid;
        cmp rax, 0;
        je  dcc_rm_bad;

        xor rbx, rbx;
      dcc_rm_scan:
        cmp rbx, 16;
        jae dcc_rm_miss;
        lea r10, [rip + _dma_consent_reqs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dcc_rm_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        je  dcc_rm_hit;
      dcc_rm_next:
        add rbx, 1;
        jmp dcc_rm_scan;

      dcc_rm_hit:
        // caller_endpoint = row[16][63:24].
        mov rax, [r10 + 16];
        shr rax, 24;
        // Clear the row.
        xor r11, r11;
        mov [r10 + 0],  r11;
        mov [r10 + 8],  r11;
        mov [r10 + 16], r11;
        mov [r10 + 24], r11;
        mov rdi, 1;                      // REPLIES
        call dcc_note;
        jmp dcc_rm_out;

      dcc_rm_miss:
        mov rdi, 3;                      // MISMATCH
        call dcc_note;
        mov rax, 0xFFFFF947;
        jmp dcc_rm_out;
      dcc_rm_bad:
        mov rax, 0xFFFFF94C;

      dcc_rm_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_consent_req_pending_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): count of live pending rows. Labels prefixed dcc_pc_.",
      block: {
        push rbx;
        push r12;

        xor r12, r12;
        xor rbx, rbx;
      dcc_pc_scan:
        cmp rbx, 16;
        jae dcc_pc_done;
        lea r10, [rip + _dma_consent_reqs];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dcc_pc_next;
        add r12, 1;
      dcc_pc_next:
        add rbx, 1;
        jmp dcc_pc_scan;

      dcc_pc_done:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // RPC entry points. request_consent / revoke_consent produce the wire
  // words; reply is the callback the compositor drives once the user
  // answered.
  // ==========================================================================

  pub let dma_consent_request : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) (caller_endpoint: u64) (device_desc: u64) (issued_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): request_consent RPC. Registers the pending request, returns req_seq on success. Labels prefixed dcc_rq_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // dock_id
        mov r12, rsi;                    // caller_endpoint
        mov r13, rcx;                    // issued_at

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call dma_consent_req_add;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_consent_revoke : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) (caller_endpoint: u64) (issued_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): revoke_consent RPC. Registers the pending request, returns req_seq. The reply is either RESP_REVOKED or RESP_NOT_GRANTED. Labels prefixed dcc_rv_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call dma_consent_req_add;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_consent_reply : (u64, u64) -> u64 !{mem} @{} =
    fn (reply_op: u64) (req_seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-002 (#1211): reply callback. Refuses reply_op outside [2, 6]. Matches the seq against the pending table. Labels prefixed dcc_rp_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // op
        mov r12, rsi;                    // seq

        cmp rbx, 2;
        jb  dcc_rp_bad_op;
        cmp rbx, 6;
        ja  dcc_rp_bad_op;

        mov rdi, r12;
        call dma_consent_reply_match;
        jmp dcc_rp_out;

      dcc_rp_bad_op:
        mov rax, 0xFFFFF94E;

      dcc_rp_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
