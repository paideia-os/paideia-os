// src/kernel/core/ipc/usb_transfer_channel.pdx — R34.M3-004 (#1179)
//
// The SCHEMA of the usb_transfer_channel session, per-endpoint RPC.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session a class driver and the xHCI-side
// transfer engine share over ONE endpoint. It is NOT an endpoint,
// NOT a transport, and NOT a driver.
//
// The session type is:
//
//   usb_transfer : Channel {
//     mu X.
//       & { submit_urb(endpoint_slot, buffer_addr, length, direction, timeout)
//                                       -> URB ;
//           cancel_urb(urb_slot)        -> STATUS ;
//           poll_status(urb_slot)       -> STATUS ;
//         }; X
//   }
//
// STATUS values: pending, complete, error, cancelled.
//
// =============================================================================
// §1  ONE-u64 REQUEST/RESPONSE FRAMES
// =============================================================================
//
// SUBMIT_URB request  op = 0x60  { endpoint_slot[15:8], direction[23:16],
//                                  length[39:24], timeout_ms[55:40] }
//   Buffer address is a follow-up field carried out-of-band on the
//   session's data channel; the schema itself packs only the small
//   parameters into one word (buffer_addr is 64 bits and cannot fit
//   alongside anything).
//
// CANCEL_URB  request  op = 0x61  { urb_slot[15:8] }
// POLL_STATUS request  op = 0x62  { urb_slot[15:8] }
// STATUS      response op = 0x63  { status[15:8], residue[47:16] }
//
// =============================================================================
// §2  IOMMU-MAPPED BIT
// =============================================================================
//
// Per the issue #1179 spec — usb_transfer_channel CARRIES the
// Cap<KIND_MEMORY> IOMMU-mapped bit. That bit is carried as bit 24
// of the SUBMIT_URB word (direction was two bits max; bit [24] is
// the highest bit of the direction byte, deliberately co-located
// with direction because IOMMU-mapping status is a property of the
// buffer's physical reach and direction is which way that reach
// goes).
//
// A submit request whose iommu_mapped bit is set means the driver
// has already asserted the buffer is behind a KIND_DMA_DOMAIN mapping
// covering the requested length; the xHCI side does not re-check.
// The kernel's role in that check is done at KIND_USB_URB mint time
// and at the driver's DMA-domain mint gate; the schema field is the
// wire-level record of the earlier decision.
//
// =============================================================================
// §3  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Same argument as hub_topology_channel §2, codec_query_channel §2,
// audio_routing_channel §5, pcm_ring_channel §2.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFB20..0xFFFFFB2F
// =============================================================================

module UsbTransferChannel = structure {

  pub let USB_XFER_OP_SUBMIT   : u64 = 0x60
  pub let USB_XFER_OP_CANCEL   : u64 = 0x61
  pub let USB_XFER_OP_POLL     : u64 = 0x62
  pub let USB_XFER_OP_STATUS   : u64 = 0x63
  pub let USB_XFER_OP_MAX_REQ  : u64 = 0x62
  pub let USB_XFER_OP_MAX      : u64 = 0x63

  pub let USB_XFER_DIR_OUT : u64 = 0
  pub let USB_XFER_DIR_IN  : u64 = 1

  pub let USB_XFER_STATUS_PENDING   : u64 = 0
  pub let USB_XFER_STATUS_COMPLETE  : u64 = 1
  pub let USB_XFER_STATUS_ERROR     : u64 = 2
  pub let USB_XFER_STATUS_CANCELLED : u64 = 3
  pub let USB_XFER_STATUS_MAX       : u64 = 3

  pub let USB_XFER_LEN_MAX     : u64 = 0xFFFF
  pub let USB_XFER_TIMEOUT_MAX : u64 = 60000

  pub let USB_XFER_OK              : u64 = 0
  pub let USB_XFER_BAD_OP          : u64 = 0xFFFFFB2F
  pub let USB_XFER_BAD_SLOT        : u64 = 0xFFFFFB2E
  pub let USB_XFER_BAD_DIR         : u64 = 0xFFFFFB2D
  pub let USB_XFER_BAD_LEN         : u64 = 0xFFFFFB2C
  pub let USB_XFER_BAD_TIMEOUT     : u64 = 0xFFFFFB2B
  pub let USB_XFER_BAD_STATUS      : u64 = 0xFFFFFB2A
  pub let USB_XFER_BAD_RESERVED    : u64 = 0xFFFFFB29

  pub let USB_XFER_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_xfer_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff op in [0x60, 0x63]. Labels prefixed uxc_ov_.",
      block: {
        cmp rdi, 0x60;
        jb  uxc_ov_no;
        cmp rdi, 0x63;
        ja  uxc_ov_no;
        mov rax, 1;
        ret;
      uxc_ov_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_xfer_status_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff s <= 3. Labels prefixed uxc_sv_.",
      block: {
        cmp rdi, 3;
        ja  uxc_sv_no;
        mov rax, 1;
        ret;
      uxc_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  //   SUBMIT_URB  op = 0x60
  //     { endpoint_slot[15:8], direction[23:16], iommu_mapped[24],
  //       length[39:25], timeout_ms[55:40] }
  //   Note: direction is one bit at [16] and iommu_mapped is one bit at [24],
  //   which leaves the remaining seven bits of the direction byte reserved.
  //   Length is 15 bits (up to 32767 bytes per URB in schema; the class
  //   driver may fragment longer transfers).
  pub let usb_xfer_pack_submit : (u64, u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (direction: u64) (iommu_mapped: u64) (length: u64) (timeout_ms: u64) (reserved: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): SUBMIT_URB packer. Six args (SysV limit). reserved must be zero. Labels prefixed uxc_ps_.",
      block: {
        cmp rdi, 256;
        jae uxc_ps_bad;
        cmp rsi, 1;
        ja  uxc_ps_bad;
        cmp rdx, 1;
        ja  uxc_ps_bad;
        cmp rcx, 0x7FFF;
        ja  uxc_ps_bad;
        cmp r8, 60000;
        ja  uxc_ps_bad;
        cmp r9, 0;
        jne uxc_ps_bad;

        mov rax, 0x60;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 1;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 1;
        shl r10, 24;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0x7FFF;
        shl r10, 25;
        or  rax, r10;
        mov r10, r8;
        and r10, 0xFFFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      uxc_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_pack_cancel : (u64) -> u64 !{} @{} =
    fn (urb_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): CANCEL_URB packer. Labels prefixed uxc_pc_.",
      block: {
        cmp rdi, 256;
        jae uxc_pc_bad;
        mov rax, 0x61;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      uxc_pc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_pack_poll : (u64) -> u64 !{} @{} =
    fn (urb_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): POLL_STATUS packer. Labels prefixed uxc_pp_.",
      block: {
        cmp rdi, 256;
        jae uxc_pp_bad;
        mov rax, 0x62;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      uxc_pp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_pack_status : (u64, u64) -> u64 !{} @{} =
    fn (status: u64) (residue: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): STATUS response packer. status in [0,3]; residue in [0, u32]. Labels prefixed uxc_prs_.",
      block: {
        cmp rdi, 3;
        ja  uxc_prs_bad;
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  uxc_prs_bad;
        mov rax, 0x63;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      uxc_prs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Unpackers. Each gates on the op byte.
  // ==========================================================================

  pub let usb_xfer_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): op ordinal from low byte.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let usb_xfer_slot : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): slot from [15:8] (endpoint_slot or urb_slot). Gates op in [0x60, 0x62]. Labels prefixed uxc_us_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x60;
        jb  uxc_us_bad;
        cmp rax, 0x62;
        ja  uxc_us_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      uxc_us_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_direction : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): direction bit from [16]. Gates op == 0x60. Labels prefixed uxc_ud_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x60;
        jne uxc_ud_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 1;
        ret;
      uxc_ud_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_iommu : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): iommu_mapped bit from [24]. Gates op == 0x60. Labels prefixed uxc_ui_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x60;
        jne uxc_ui_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 1;
        ret;
      uxc_ui_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_length : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): length from [39:25]. Gates op == 0x60. Labels prefixed uxc_ul_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x60;
        jne uxc_ul_bad;
        mov rax, rdi;
        shr rax, 25;
        and rax, 0x7FFF;
        ret;
      uxc_ul_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_timeout : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): timeout from [55:40]. Gates op == 0x60. Labels prefixed uxc_ut_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x60;
        jne uxc_ut_bad;
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFFFF;
        ret;
      uxc_ut_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_status : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): status from [15:8]. Gates op == 0x63. Labels prefixed uxc_ust_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x63;
        jne uxc_ust_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      uxc_ust_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_xfer_residue : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): residue from [47:16]. Gates op == 0x63. Labels prefixed uxc_ur_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x63;
        jne uxc_ur_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFFFFFF;
        ret;
      uxc_ur_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
