// src/kernel/core/ipc/audit_journal_broker.pdx -- R48b substrate-prep (#1628)
//
// svc.audit-journal registration seam + UEJ_KIND_TOOL_* event constants.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This module lands the KERNEL-SIDE SEAM only:
//
//   * Declares the canonical name string "svc.audit-journal".
//   * Exposes audit_journal_broker_register(endpoint_id) which reserves
//     the well-known service name in the R20b registry so any process
//     with svc_lookup authority can resolve the journal daemon's endpoint.
//   * Defines the four UEJ_KIND_TOOL_* event-type constants that R49/R50
//     tools MUST emit for install / remove / invoke / error events
//     (design/tooling/r49-r50-plan.md §5 audit contract).  Defining them
//     here means every tool consumer refers to the same numeric values,
//     and a future daemon body cannot drift them.
//   * Exposes a stub RPC dispatch entry audit_journal_broker_dispatch
//     that accepts one of the four UEJ_KIND_TOOL_* values and, at
//     substrate-prep time, returns AJB_DISPATCH_STUB.
//   * Maintains _audit_journal_broker_stats so the boot witness + a
//     future supervisor can count register attempts, dispatch invocations,
//     and stub returns without a second writer of the counter table.
//
// It DOES NOT land the full daemon body (event ring writer, on-disk
// journal file layout, ring-drain policy, per-user event filtering).
// That is a later milestone.
//
// The seam is what unblocks libpdx-audit.M2: the tool-side library
// needs (a) a well-known name to resolve, (b) the numeric event-type
// constants to emit, and (c) a broker that recognises those event
// types even before the daemon body exists.
//
// =============================================================================
// WHY THE UEJ_KIND_TOOL_* CONSTANTS LIVE HERE
// =============================================================================
//
// core/audit/audit_schema.pdx defines the AUD_EV_* base event union
// (§audit_schema.pdx §1); the tool-event constants are a userspace-
// journal extension of that union.  Placing them in the broker seam
// (rather than the audit schema) keeps the KERNEL audit schema closed
// -- an event type the kernel never emits should not sit in the base
// schema -- while still giving every tool consumer exactly one file
// to import to name them.  The numeric values are chosen to be
// disjoint from the semterm-session-log range (SLOG 100..127 per
// core/semterm/session_log.pdx) and above the kernel schema's own
// active band (AUD_EV_MINT..12, up to R47).

module AuditJournalBroker = structure {

  pub let audit_journal_broker_name : [u8; 20] = "svc.audit-journal\0\0\0"
  pub let AUDIT_JOURNAL_BROKER_NAME_LEN : u64 = 17    // strlen

  // The tool-event constants.  Range 128..131 is above every current
  // kernel schema event (AUD_EV_*) and above the semterm SLOG range
  // (100..127); a future user-event region [128..255] is reserved by
  // this allocation.
  pub let UEJ_KIND_TOOL_INSTALL : u64 = 128    // pkg install landed
  pub let UEJ_KIND_TOOL_REMOVE  : u64 = 129    // pkg remove landed
  pub let UEJ_KIND_TOOL_INVOKE  : u64 = 130    // any tool invocation entered
  pub let UEJ_KIND_TOOL_ERROR   : u64 = 131    // tool exited with error
  pub let UEJ_KIND_TOOL_MIN     : u64 = 128
  pub let UEJ_KIND_TOOL_MAX     : u64 = 131

  pub let AJB_OK                : u64 = 0
  pub let AJB_REGISTER_BAD_ID   : u64 = 0xFFFFEBEF
  pub let AJB_REGISTER_DUP      : u64 = 0xFFFFEBEE
  pub let AJB_REGISTER_FULL     : u64 = 0xFFFFEBED
  pub let AJB_REGISTER_BAD_NAME : u64 = 0xFFFFEBEC
  pub let AJB_DISPATCH_STUB     : u64 = 0xFFFFEBEB
  pub let AJB_DISPATCH_BAD_KIND : u64 = 0xFFFFEBEA

  pub let mut _audit_journal_broker_stats : [u64; 8] = uninit @align(64)

  pub let AJB_ST_REGISTERS : u64 = 0
  pub let AJB_ST_REG_FAIL  : u64 = 1
  pub let AJB_ST_DISPATCH  : u64 = 2
  pub let AJB_ST_BAD_KIND  : u64 = 3
  pub let AJB_ST_MAX       : u64 = 8

  pub let audit_journal_broker_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1628): clear the eight-word counter table. Labels prefixed ajb_rs_.",
      block: {
        lea r10, [rip + _audit_journal_broker_stats];
        xor rax, rax;
        xor rcx, rcx;
      ajb_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ajb_rs_loop;
        ret
      }
    }

  pub let audit_journal_broker_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1628): bounded increment. Labels prefixed ajb_nt_.",
      block: {
        cmp rdi, 8;
        jae ajb_nt_out;
        lea r10, [rip + _audit_journal_broker_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ajb_nt_out:
        ret
      }
    }

  pub let audit_journal_broker_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1628): bounded read; out-of-range returns 0. Labels prefixed ajb_st_.",
      block: {
        cmp rdi, 8;
        jae ajb_st_zero;
        lea r10, [rip + _audit_journal_broker_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ajb_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ajb_kind_valid(k) -> 1 iff k in [UEJ_KIND_TOOL_MIN..UEJ_KIND_TOOL_MAX]
  // ==========================================================================

  pub let ajb_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1628): 1 iff k in [128, 131]. Every tool that emits a user-event journal record calls this first so a smuggled event-type outside the reserved band is refused rather than silently accepted. Labels prefixed uej_kv_.",
      block: {
        cmp rdi, 128;
        jb  uej_kv_no;
        mov r10, 131;
        cmp rdi, r10;
        ja  uej_kv_no;
        mov rax, 1;
        ret;
      uej_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // audit_journal_broker_register(endpoint_id) -> AJB_OK | AJB_REGISTER_*
  // ==========================================================================

  pub let audit_journal_broker_register : (u64) -> u64 !{mem} @{} =
    fn (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1628): call svc_register with the canonical name for the audit journal.  Translates svc_register's small-int codes into the AJB_* band.  Same shape as elevate_broker_register.  Labels prefixed ajb_reg_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  ajb_reg_bad_id;

        lea rdi, [rip + audit_journal_broker_name];
        mov rsi, 17;                     // AUDIT_JOURNAL_BROKER_NAME_LEN
        mov rdx, r12;
        call svc_register;
        mov r13, rax;

        cmp r13, 0;
        je  ajb_reg_ok;
        cmp r13, 1;
        je  ajb_reg_bad_name;
        cmp r13, 2;
        je  ajb_reg_dup;
        cmp r13, 3;
        je  ajb_reg_full;
        jmp ajb_reg_bad_name;

      ajb_reg_ok:
        mov rdi, 0;
        call audit_journal_broker_note;
        xor rax, rax;
        jmp ajb_reg_out;

      ajb_reg_bad_id:
        mov rax, 0xFFFFEBEF;
        jmp ajb_reg_fail;
      ajb_reg_dup:
        mov rax, 0xFFFFEBEE;
        jmp ajb_reg_fail;
      ajb_reg_full:
        mov rax, 0xFFFFEBED;
        jmp ajb_reg_fail;
      ajb_reg_bad_name:
        mov rax, 0xFFFFEBEC;

      ajb_reg_fail:
        push rax;
        mov rdi, 1;
        call audit_journal_broker_note;
        pop rax;

      ajb_reg_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // audit_journal_broker_dispatch(event_kind, payload_ptr) ->
  //   AJB_DISPATCH_STUB | AJB_DISPATCH_BAD_KIND
  //
  // Stub RPC entry.  event_kind must be one of UEJ_KIND_TOOL_*.  At
  // substrate-prep time every recognised kind returns AJB_DISPATCH_STUB.
  // The daemon body arrives at a later milestone.
  // ==========================================================================

  pub let audit_journal_broker_dispatch : (u64, u64) -> u64 !{mem} @{} =
    fn (event_kind: u64) (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1628): stub dispatch.  Uses ajb_kind_valid to gate the event_kind and returns AJB_DISPATCH_STUB on recognised, AJB_DISPATCH_BAD_KIND on unknown.  ELVB pattern mirrored.  Labels prefixed ajb_dp_.",
      block: {
        push r12;

        mov r12, rdi;
        mov rdi, r12;
        call ajb_kind_valid;
        cmp rax, 0;
        je  ajb_dp_bad_kind;

        mov rdi, 2;
        call audit_journal_broker_note;
        mov rax, 0xFFFFEBEB;
        jmp ajb_dp_out;

      ajb_dp_bad_kind:
        mov rdi, 3;
        call audit_journal_broker_note;
        mov rax, 0xFFFFEBEA;

      ajb_dp_out:
        pop r12;
        ret
      }
    }
}
