// src/kernel/core/ipc/battery_channel.pdx — R31.M3-002 (#1100)
//
// The schema of the battery_channel: one RPC (READ_STATE), two stream
// events (STATE_CHANGED, LOW_WARNING), and the pack/unpack primitives
// that turn a row's cached fields into one u64 and back.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a channel, and the packers/unpackers that discharge
// that schema. It is NOT an endpoint, NOT a transport, and NOT a server:
// no queue lives here, no capability is minted here, and NO CALL sends a
// byte across a process boundary. `design/ipc/battery-channel-schema.md`
// §7 lists the deferrals in the same shape kind_battery.pdx §4 lists
// its own.
//
// The schema lives as code — rather than as a document only — because
// the packer is the load-bearing artefact: a subscriber that unpacks a
// field the packer never produced silently reads a value from the wrong
// bit range, and the wrong bit range is a supervisor that acts on a
// "percent" that was actually the voltage byte. tools/build.sh confines
// the pack/unpack signatures so a fifth parameter cannot smuggle a
// caller-supplied scale.
//
// =============================================================================
// §1  ONE u64 REPLIES, ONE u64 EVENT PAYLOADS
// =============================================================================
//
// A reply that spans multiple words has an ordering across the words a
// consumer must preserve; a reply that is one word is atomic against
// every reader that reads it as a word. The design chooses one word for
// both READ_STATE replies and for STATE_CHANGED / LOW_WARNING payloads,
// and pins the field bounds so a growth pressure — a 12-bit percent for
// deci-percent, say — is a visible change to §3's layout rather than a
// silent widening of a byte that used to be a percent.
//
// The layout is documented in schema §3 and §4 and is the sole
// authority: every packer here builds bits according to those tables,
// and every unpacker extracts them from the same. A single unpacker or
// a single packer that drifted from the table would be a wire mismatch
// with no compilation symptom, which is why the two halves live in the
// same file.
//
// =============================================================================
// §2  A RESERVED FIELD IS REFUSED, NOT MASKED
// =============================================================================
//
// The two event payloads carry reserved bit-ranges. The packers set them
// to zero; the validators refuse a payload that arrives with them set,
// with BATTERY_CH_BAD_RESERVED. This mirrors kind_battery.pdx's REPORT
// op refusing its own reserved upper bits: a reserved field that a
// receiver silently masks is a field a later revision cannot use, and a
// payload with sixteen free bits on an event that names a state
// transition is where a second reading could be smuggled.
//
// The two positional refusals — DECODE_BAD in the reply, BAD_RESERVED
// in the validators — are distinct from every operational refusal
// (BAD_OP, BAD_EV, BAD_PERCENT, BAD_STATE, BAD_VOLTAGE). Collapsing
// either into a shared code would lose the ability to distinguish a
// dead slot from a corrupt payload.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFE50..0xFFFFFE5F
// =============================================================================
//
// Disjoint from every other in-tree band: KIND_BATTERY owns 0..4F,
// thermal_zone owns 30..3F, thermal_policy owns 20..2A, owner column
// owns 2B..2F. 0xFFFFFE50..5F was free.
//
// =============================================================================

module BatteryChannel = structure {

  // ==========================================================================
  // §1's op and event ordinals.
  //
  // RPC ops occupy the LOW half of the eight-bit domain, events the
  // HIGH half. A dispatcher that switches on the ordinal cannot
  // accidentally route an event as a request or a request as an event
  // without crossing the 0x80 line, which is what the two validators
  // enforce.
  // ==========================================================================

  pub let BATTERY_CH_OP_READ_STATE : u64 = 0x01
  pub let BATTERY_CH_OP_MAX        : u64 = 0x01

  pub let BATTERY_CH_EV_STATE_CHANGED : u64 = 0x80
  pub let BATTERY_CH_EV_LOW_WARNING   : u64 = 0x81
  pub let BATTERY_CH_EV_MAX           : u64 = 0x81

  // ==========================================================================
  // §3's failure taxonomy.
  // ==========================================================================

  pub let BATTERY_CH_OK           : u64 = 0
  pub let BATTERY_CH_BAD_OP       : u64 = 0xFFFFFE5F
  pub let BATTERY_CH_BAD_EV       : u64 = 0xFFFFFE5E
  pub let BATTERY_CH_BAD_PERCENT  : u64 = 0xFFFFFE5D
  pub let BATTERY_CH_BAD_STATE    : u64 = 0xFFFFFE5C
  pub let BATTERY_CH_BAD_VOLTAGE  : u64 = 0xFFFFFE5B
  pub let BATTERY_CH_BAD_RESERVED : u64 = 0xFFFFFE5A

  // Positional "there is no legal reply to describe". Not a refusal:
  // this is the packer's answer for a slot that names no live row, and
  // it is DISTINCT from BATTERY_DECODE_BAD (kind_battery.pdx) so that
  // a caller threading a code up through the RPC gate and the packer
  // can still name which one produced the sentinel.
  pub let BATTERY_CH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // The bit widths from schema §3 and §4. Local constants so a re-pack
  // is a change in ONE file: a widened percent field alters the shift,
  // the mask AND the validator in the same commit.
  // ==========================================================================

  pub let BATTERY_CH_PCT_SHIFT   : u64 = 0
  pub let BATTERY_CH_PCT_MASK    : u64 = 0xFF
  pub let BATTERY_CH_STATE_SHIFT : u64 = 8
  pub let BATTERY_CH_STATE_MASK  : u64 = 0xFF
  pub let BATTERY_CH_MV_SHIFT    : u64 = 16
  pub let BATTERY_CH_MV_MASK     : u64 = 0xFFFF
  pub let BATTERY_CH_REPORTS_SHIFT : u64 = 32
  pub let BATTERY_CH_REPORTS_MASK  : u64 = 0xFFFFFFFF

  // STATE_CHANGED — {prev_state[7:0], new_state[15:8], pct[23:16],
  // mv[47:24], reserved[63:48]}.
  pub let BATTERY_CH_SC_PREV_SHIFT : u64 = 0
  pub let BATTERY_CH_SC_PREV_MASK  : u64 = 0xFF
  pub let BATTERY_CH_SC_NEW_SHIFT  : u64 = 8
  pub let BATTERY_CH_SC_NEW_MASK   : u64 = 0xFF
  pub let BATTERY_CH_SC_PCT_SHIFT  : u64 = 16
  pub let BATTERY_CH_SC_PCT_MASK   : u64 = 0xFF
  pub let BATTERY_CH_SC_MV_SHIFT   : u64 = 24
  pub let BATTERY_CH_SC_MV_MASK    : u64 = 0xFFFFFF

  // LOW_WARNING — {pct[7:0], threshold[15:8], mv[31:16], reserved[63:32]}.
  pub let BATTERY_CH_LW_PCT_SHIFT   : u64 = 0
  pub let BATTERY_CH_LW_PCT_MASK    : u64 = 0xFF
  pub let BATTERY_CH_LW_THR_SHIFT   : u64 = 8
  pub let BATTERY_CH_LW_THR_MASK    : u64 = 0xFF
  pub let BATTERY_CH_LW_MV_SHIFT    : u64 = 16
  pub let BATTERY_CH_LW_MV_MASK     : u64 = 0xFFFF

  // ==========================================================================
  // battery_channel_op_valid(op) -> 1 | 0
  //
  // 1 iff op ∈ {READ_STATE}. Refuses zero: zero is the .bss default
  // for an unset opcode field in a Frame header, and admitting it here
  // would let an uninitialised frame reach the packer.
  // ==========================================================================

  pub let battery_channel_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): 1 iff op is in the RPC ordinal set. THE ONE OPERATION IS READ_STATE. Zero is refused because it is the .bss default for an unset Frame opcode; admitting it would let an uninitialised frame reach the packer and produce a reply for a slot the sender never named. The refusal is not silently mapped to BAD_OP by callers -- callers get 0/1 and decide -- because a validator that also names its own refusal code duplicates a decision the dispatcher already has to make and the two can drift. Pure leaf. Labels prefixed bch_ov_ per reserved-label discipline.",
      block: {
        mov r10, 1;                      // BATTERY_CH_OP_READ_STATE
        cmp rdi, r10;
        jne bch_ov_no;
        mov rax, 1;
        ret;
      bch_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_ev_valid(ev) -> 1 | 0
  //
  // 1 iff ev ∈ {STATE_CHANGED, LOW_WARNING}. Events live in the high
  // half of the ordinal domain (0x80..0xFF) so a dispatcher cannot mix
  // a request in.
  // ==========================================================================

  pub let battery_channel_ev_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): 1 iff ev is a known event ordinal. Two members today: STATE_CHANGED (0x80), LOW_WARNING (0x81). Constrained to the high half of the ordinal domain (§1) so a subscriber that switches on ordinal cannot route a request as an event or the reverse without crossing the 0x80 line. A third event added tomorrow adds one arm here and one packer below and no other change. Pure leaf. Labels prefixed bch_ev_ per reserved-label discipline.",
      block: {
        mov r10, 0x80;                   // BATTERY_CH_EV_STATE_CHANGED
        cmp rdi, r10;
        je  bch_ev_yes;
        mov r10, 0x81;                   // BATTERY_CH_EV_LOW_WARNING
        cmp rdi, r10;
        je  bch_ev_yes;
        xor rax, rax;
        ret;
      bch_ev_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_pack_reply(pct, state, mv, reports) -> u64
  //
  // Schema §3. Pack the four READ_STATE fields into one u64. NO
  // CLAMPING and NO SILENT MASKING: an out-of-range field is refused,
  // the reply is the DECODE_BAD sentinel. A clamped 255 percent
  // silently reads as 0xFF (BATTERY_PCT_NONE) and a subscriber acts
  // on "no report" for a battery that reported a corrupt value; a
  // masked voltage silently loses the high bits and reports a 12 V
  // pack as 3.5 V.
  //
  // ARITY FOUR, PINNED. A fifth parameter would be a caller-supplied
  // scale, and both directions of that mistake are load-bearing:
  // scaling percent to per-mille turns 85% into 0x353 and the top byte
  // is silently truncated; scaling voltage from mV to cV turns 12042
  // into 1204 and reads as an unpowered pack.
  //
  // BATTERY_PCT_NONE (0xFF) is a legitimate first argument: a row
  // without a report yet is a legal state to describe, and the packer
  // admits 0xFF specifically (in addition to 0..100) and forbids
  // everything else in that field.
  // ==========================================================================

  pub let battery_channel_pack_reply : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (pct: u64) (state: u64) (mv: u64) (reports: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): pack the READ_STATE reply. Four gates in order: (1) pct in [0, 100] or pct == BATTERY_PCT_NONE (0xFF); anything else -> BATTERY_CH_DECODE_BAD. Zero is a legitimate answer (a flat pack), 0xFF is the row's 'no report yet' sentinel, 101..0xFE is refused rather than clamped because a byte that is neither a percent nor the sentinel is a byte that came from somewhere the packer cannot see. (2) state <= BATTERY_STATE_MAX (5); anything else -> DECODE_BAD, not the sentinel-friendly 0xFF. (3) mv <= BATTERY_VOLTAGE_MV_MAX (25000); zero is admitted (row's 'never reported' voltage). (4) reports fits 32 bits; a lifetime count near 4G is a supervisor that has been running for months on this pack and the width truncation is a visible saturation the schema documents rather than a silent overflow. Pack: rax = pct | (state<<8) | ((mv&0xFFFF)<<16) | ((reports&0xFFFFFFFF)<<32). Pure leaf, no nested calls; five caller-save clobbers, no callee-save writes. Labels prefixed bch_pr_ per reserved-label discipline.",
      block: {
        // (1) percent.
        mov r10, 100;                    // BATTERY_PCT_MAX
        cmp rdi, r10;
        jbe bch_pr_pct_ok;
        mov r10, 0xFF;                   // BATTERY_PCT_NONE
        cmp rdi, r10;
        jne bch_pr_bad;
      bch_pr_pct_ok:

        // (2) state.
        mov r10, 5;                      // BATTERY_STATE_MAX
        cmp rsi, r10;
        ja  bch_pr_bad;

        // (3) mv.
        mov r10, 25000;                  // BATTERY_VOLTAGE_MV_MAX
        cmp rdx, r10;
        ja  bch_pr_bad;

        // (4) reports.
        mov r10, 0xFFFFFFFF;
        cmp rcx, r10;
        ja  bch_pr_bad;

        // Pack.
        mov rax, rdi;                    // pct in [7:0]
        mov r10, rsi;
        shl r10, 8;
        or  rax, r10;                    // state in [15:8]
        mov r10, rdx;
        shl r10, 16;
        or  rax, r10;                    // mv in [31:16]
        mov r10, rcx;
        shl r10, 32;
        or  rax, r10;                    // reports in [63:32]
        ret;

      bch_pr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // BATTERY_CH_DECODE_BAD
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_reply_percent(reply) -> u64
  // battery_channel_reply_state(reply)   -> u64
  // battery_channel_reply_voltage(reply) -> u64
  // battery_channel_reply_reports(reply) -> u64
  //
  // Schema §3. The ONLY route from a packed reply back to a field. A
  // caller extracting bits by hand is a caller whose extraction can
  // drift from the packer's meaning.
  // ==========================================================================

  pub let battery_channel_reply_percent : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract percent from a packed reply. rax = reply & 0xFF. Pure leaf. Labels prefixed bch_rp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_reply_state : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract state ordinal from a packed reply. rax = (reply >> 8) & 0xFF. Pure leaf. Labels prefixed bch_rs_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_reply_voltage : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract voltage_mv from a packed reply. rax = (reply >> 16) & 0xFFFF. Pure leaf. Labels prefixed bch_rv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let battery_channel_reply_reports : (u64) -> u64 !{} @{} =
    fn (reply: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract lifetime report count from a packed reply. rax = (reply >> 32) & 0xFFFFFFFF. Pure leaf. Labels prefixed bch_rr_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_pack_state_changed(prev, new, pct, mv) -> u64
  //
  // Schema §4.1. Pack a state transition event. Refuses BOTH states
  // equal (a change payload with no change is a lie a subscriber
  // would count as a transition), refuses either state out of enum,
  // refuses percent out of 0..100 (0xFF has no meaning in a
  // transition event -- an unreported percent cannot participate in
  // a transition of the state it was never assigned), and refuses mv
  // past 24-bit domain / MAX_MV.
  // ==========================================================================

  pub let battery_channel_pack_state_changed : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (prev: u64) (new: u64) (pct: u64) (mv: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): pack a STATE_CHANGED event payload. Gates in order: (1) prev <= BATTERY_STATE_MAX (5), (2) new <= BATTERY_STATE_MAX, (3) prev != new -- an event whose payload says the state did not change is an event that would be counted as a transition by every downstream reader, exactly the class of nonsense §2 refuses. (4) pct in [0, 100]; 0xFF is REJECTED here, unlike the READ_STATE reply, because a row with no report cannot participate in a transition of the state it never held. (5) mv <= BATTERY_VOLTAGE_MV_MAX and mv fits in the 24-bit payload field (25000 fits). Any refusal -> BATTERY_CH_DECODE_BAD. Pack: rax = prev | (new<<8) | (pct<<16) | (mv<<24), reserved [63:48] left zero by construction. Pure leaf. Labels prefixed bch_ps_ per reserved-label discipline.",
      block: {
        mov r10, 5;                      // BATTERY_STATE_MAX
        cmp rdi, r10;
        ja  bch_ps_bad;
        cmp rsi, r10;
        ja  bch_ps_bad;
        cmp rdi, rsi;
        je  bch_ps_bad;                  // no-op transition refused

        mov r10, 100;                    // BATTERY_PCT_MAX
        cmp rdx, r10;
        ja  bch_ps_bad;

        mov r10, 25000;                  // BATTERY_VOLTAGE_MV_MAX
        cmp rcx, r10;
        ja  bch_ps_bad;

        mov rax, rdi;                    // prev in [7:0]
        mov r10, rsi;
        shl r10, 8;
        or  rax, r10;                    // new in [15:8]
        mov r10, rdx;
        shl r10, 16;
        or  rax, r10;                    // pct in [23:16]
        mov r10, rcx;
        shl r10, 24;
        or  rax, r10;                    // mv in [47:24]
        ret;

      bch_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // BATTERY_CH_DECODE_BAD
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_pack_low_warning(pct, threshold, mv) -> u64
  //
  // Schema §4.2. Refuses percent above threshold (a LOW warning at
  // higher than the threshold is a lie), percent or threshold out of
  // 0..100, mv out of the 16-bit / MAX_MV domain.
  // ==========================================================================

  pub let battery_channel_pack_low_warning : (u64, u64, u64) -> u64 !{} @{} =
    fn (pct: u64) (threshold: u64) (mv: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): pack a LOW_WARNING event payload. Gates: (1) pct <= BATTERY_PCT_MAX (100); refused above, including 0xFF -- a LOW warning for a pack that has no report is a claim about a percent that was never sampled. (2) threshold <= BATTERY_PCT_MAX; refused above. (3) pct <= threshold -- a LOW warning at a percent above the threshold that produced it is a claim that would let a subscriber trust either the threshold or the percent but not both, which is worse than trusting neither. (4) mv fits in [0, BATTERY_VOLTAGE_MV_MAX] and in 16 bits (25000 < 65536). Any refusal -> BATTERY_CH_DECODE_BAD. Pack: rax = pct | (threshold<<8) | (mv<<16), reserved [63:32] left zero. Pure leaf. Labels prefixed bch_pl_ per reserved-label discipline.",
      block: {
        mov r10, 100;                    // BATTERY_PCT_MAX
        cmp rdi, r10;
        ja  bch_pl_bad;
        cmp rsi, r10;
        ja  bch_pl_bad;
        cmp rdi, rsi;
        ja  bch_pl_bad;                  // pct > threshold refused

        mov r10, 25000;
        cmp rdx, r10;
        ja  bch_pl_bad;

        mov rax, rdi;                    // pct in [7:0]
        mov r10, rsi;
        shl r10, 8;
        or  rax, r10;                    // threshold in [15:8]
        mov r10, rdx;
        shl r10, 16;
        or  rax, r10;                    // mv in [31:16]
        ret;

      bch_pl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // BATTERY_CH_DECODE_BAD
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_sc_prev(payload) -> u64
  // battery_channel_sc_new(payload)  -> u64
  // battery_channel_sc_pct(payload)  -> u64
  // battery_channel_sc_mv(payload)   -> u64
  //
  // Extractors for STATE_CHANGED payload fields.
  // ==========================================================================

  pub let battery_channel_sc_prev : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract prev_state from a STATE_CHANGED payload. rax = payload & 0xFF. Pure leaf. Labels prefixed bch_sp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_sc_new : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract new_state from a STATE_CHANGED payload. rax = (payload >> 8) & 0xFF. Pure leaf. Labels prefixed bch_sn_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_sc_pct : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract pct from a STATE_CHANGED payload. rax = (payload >> 16) & 0xFF. Pure leaf. Labels prefixed bch_spc_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_sc_mv : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract mv from a STATE_CHANGED payload. rax = (payload >> 24) & 0xFFFFFF. Pure leaf. Labels prefixed bch_smv_.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFFFF;
        and rax, r10;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_channel_lw_pct(payload) -> u64
  // battery_channel_lw_threshold(payload) -> u64
  // battery_channel_lw_mv(payload) -> u64
  //
  // Extractors for LOW_WARNING payload fields.
  // ==========================================================================

  pub let battery_channel_lw_pct : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract pct from a LOW_WARNING payload. rax = payload & 0xFF. Pure leaf. Labels prefixed bch_lpct_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_lw_threshold : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract threshold from a LOW_WARNING payload. rax = (payload >> 8) & 0xFF. Pure leaf. Labels prefixed bch_lthr_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let battery_channel_lw_mv : (u64) -> u64 !{} @{} =
    fn (payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-002 (#1100): extract mv from a LOW_WARNING payload. rax = (payload >> 16) & 0xFFFF. Pure leaf. Labels prefixed bch_lmv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame
}
