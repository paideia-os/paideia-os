// src/kernel/core/ipc/audio_routing_channel.pdx -- R33.M5-001 (#1157)
//
// The SCHEMA of the audio_routing_channel session. See
// design/ipc/audio-routing-channel-schema.md for the full argument.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SCHEMA of a session an audio-graph client and the audio
// supervisor share over ONE endpoint. It is NOT an endpoint, NOT a
// transport, and NOT the supervisor itself. The session type is:
//
//   audio_routing : Channel {
//     !{ audio_route_mint, audio_route_report }
//     { create_route(src, dst, gain, mute),
//       destroy_route(route),
//       set_gain(route, gain),
//       set_mute(route, mute) }*
//   }
//
// The four RPCs cycle: a client asks for a route, modulates it, and
// eventually destroys it. Each is one u64 request; each carries one
// u64 reply.
//
// =============================================================================
// §1  ONE u64 REQUESTS AND ONE u64 REPLIES
// =============================================================================
//
//   Requests (op in bits [7:0]):
//     CREATE_ROUTE   op = 0x20 { source_slot[15:8], dest_slot[23:16],
//                                mute[24], gain_q15[47:32] }
//     DESTROY_ROUTE  op = 0x21 { route_slot[15:8] }
//     SET_GAIN       op = 0x22 { route_slot[15:8], gain_q15[31:16] }
//     SET_MUTE       op = 0x23 { route_slot[15:8], mute[16] }
//
//   Replies:
//     CREATE_ACK   op = 0xF0 { route_slot[15:8], status[63:16] }
//     DESTROY_ACK  op = 0xF1 { status[63:8] }
//     SET_GAIN_ACK op = 0xF2 { status[63:8] }
//     SET_MUTE_ACK op = 0xF3 { status[63:8] }
//
// Op ordinals for requests occupy 0x20..0x23; replies 0xF0..0xF3 so a
// dispatcher switching on the byte cannot route a reply as a request.
//
// =============================================================================
// §2  RESERVED BITS ARE REFUSED, NOT MASKED
// =============================================================================
//
// Every packed frame has RESERVED bit ranges. The packers refuse a
// payload with any set. Same argument as codec_query_channel §2 and
// pcm_ring_channel §2.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFCA0..0xFFFFFCAF
// =============================================================================

module AudioRoutingChannel = structure {

  // ==========================================================================
  // §1 ordinals.
  // ==========================================================================

  pub let AUDIO_ROUTING_OP_CREATE_ROUTE  : u64 = 0x20
  pub let AUDIO_ROUTING_OP_DESTROY_ROUTE : u64 = 0x21
  pub let AUDIO_ROUTING_OP_SET_GAIN      : u64 = 0x22
  pub let AUDIO_ROUTING_OP_SET_MUTE      : u64 = 0x23
  pub let AUDIO_ROUTING_OP_MAX_REQ       : u64 = 0x23

  pub let AUDIO_ROUTING_OP_CREATE_ACK    : u64 = 0xF0
  pub let AUDIO_ROUTING_OP_DESTROY_ACK   : u64 = 0xF1
  pub let AUDIO_ROUTING_OP_SET_GAIN_ACK  : u64 = 0xF2
  pub let AUDIO_ROUTING_OP_SET_MUTE_ACK  : u64 = 0xF3

  // ==========================================================================
  // §3 return codes.
  // ==========================================================================

  pub let AUDIO_ROUTING_OK           : u64 = 0
  pub let AUDIO_ROUTING_BAD_OP       : u64 = 0xFFFFFCAF
  pub let AUDIO_ROUTING_BAD_SLOT     : u64 = 0xFFFFFCAE
  pub let AUDIO_ROUTING_BAD_GAIN     : u64 = 0xFFFFFCAD
  pub let AUDIO_ROUTING_BAD_MUTE     : u64 = 0xFFFFFCAC
  pub let AUDIO_ROUTING_BAD_RESERVED : u64 = 0xFFFFFCAB

  pub let AUDIO_ROUTING_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let audio_routing_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): 1 iff op is a REQUEST ordinal (0x20..0x23). Labels prefixed arc_ov_.",
      block: {
        cmp rdi, 0x20;
        jb  arc_ov_no;
        cmp rdi, 0x23;
        ja  arc_ov_no;
        mov rax, 1;
        ret;
      arc_ov_no:
        xor rax, rax;
        ret
      }
    }

  // Gain in the sign-extended Q15 shape [-32768, +32767].
  pub let audio_routing_gain_valid : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): 1 iff g decodes as valid Q15 signed 16-bit ([-32768, +32767]). Sign-extended in u64: reconstruct from low16 and compare with input -- otherwise +32768 (0x8000, top48=0, bit15=1) would slip through as a shape-legal positive when it is positive out-of-range. Labels prefixed arc_gv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;                 // low 16
        mov r10, rax;
        shr r10, 15;                     // sign bit
        cmp r10, 0;
        je  arc_gv_pos;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;                    // sign-extend negative
      arc_gv_pos:
        cmp rax, rdi;
        jne arc_gv_no;
        mov rax, 1;
        ret;
      arc_gv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Request packers.
  // ==========================================================================

  pub let audio_routing_pack_create_req : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (source_slot: u64, dest_slot: u64, mute: u64, gain_q15: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack CREATE_ROUTE. Layout: op=0x20, source_slot[15:8], dest_slot[23:16], mute[24], gain_q15[47:32]. Gates: source_slot < 256, dest_slot < 256, mute in {0,1}, gain_q15 valid Q15 (strict range [-32768, +32767], not just sign-extended shape). Labels prefixed arc_pcr_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae arc_pcr_bad;
        cmp rsi, r10;
        jae arc_pcr_bad;
        cmp rdx, 1;
        ja  arc_pcr_bad;

        // Validate gain: strict Q15 range via sign-extension round-trip.
        mov rax, rcx;
        and rax, 0xFFFF;
        mov r10, rax;
        shr r10, 15;
        cmp r10, 0;
        je  arc_pcr_gain_check;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;
      arc_pcr_gain_check:
        cmp rax, rcx;
        jne arc_pcr_bad;

      arc_pcr_gain_ok:
        mov rax, 0x20;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 1;
        shl r10, 24;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      arc_pcr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_pack_destroy_req : (u64) -> u64 !{} @{} =
    fn (route_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack DESTROY_ROUTE. Layout: op=0x21, route_slot[15:8]. Gate: route_slot < 256. Labels prefixed arc_pdr_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae arc_pdr_bad;

        mov rax, 0x21;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      arc_pdr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_pack_set_gain_req : (u64, u64) -> u64 !{} @{} =
    fn (route_slot: u64, gain_q15: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack SET_GAIN. Layout: op=0x22, route_slot[15:8], gain_q15[31:16]. Gates: route_slot < 256, gain valid Q15 (strict range [-32768, +32767]). Labels prefixed arc_psg_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae arc_psg_bad;

        // Validate gain: strict Q15 range via sign-extension round-trip.
        mov rax, rsi;
        and rax, 0xFFFF;
        mov r10, rax;
        shr r10, 15;
        cmp r10, 0;
        je  arc_psg_gain_check;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;
      arc_psg_gain_check:
        cmp rax, rsi;
        jne arc_psg_bad;

      arc_psg_gain_ok:
        mov rax, 0x22;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      arc_psg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_pack_set_mute_req : (u64, u64) -> u64 !{} @{} =
    fn (route_slot: u64, mute: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack SET_MUTE. Layout: op=0x23, route_slot[15:8], mute[16]. Gates: route_slot < 256, mute in {0,1}. Labels prefixed arc_psm_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae arc_psm_bad;
        cmp rsi, 1;
        ja  arc_psm_bad;

        mov rax, 0x23;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 1;
        shl r10, 16;
        or  rax, r10;
        ret;
      arc_psm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Reply packers.
  // ==========================================================================

  pub let audio_routing_pack_create_ack : (u64, u64) -> u64 !{} @{} =
    fn (route_slot: u64, status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack CREATE_ACK. Layout: op=0xF0, route_slot[15:8], status[63:16]. Labels prefixed arc_pca_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae arc_pca_bad;

        mov rax, 0xF0;
        mov r10, rdi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        ret;
      arc_pca_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_pack_destroy_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack DESTROY_ACK. Layout: op=0xF1, status[63:8]. Labels: none.",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xF1;
        or  rax, r10;
        ret
      }
    }

  pub let audio_routing_pack_set_gain_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack SET_GAIN_ACK. Layout: op=0xF2, status[63:8].",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xF2;
        or  rax, r10;
        ret
      }
    }

  pub let audio_routing_pack_set_mute_ack : (u64) -> u64 !{} @{} =
    fn (status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): pack SET_MUTE_ACK. Layout: op=0xF3, status[63:8].",
      block: {
        mov rax, rdi;
        shl rax, 8;
        mov r10, 0xF3;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // Unpackers.
  // ==========================================================================

  pub let audio_routing_req_op : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): op ordinal from low byte. Labels: none.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let audio_routing_create_req_source : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): source_slot from CREATE_ROUTE. Gate op == 0x20. Labels prefixed arc_ucs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x20;
        jne arc_ucs_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      arc_ucs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_create_req_dest : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): dest_slot from CREATE_ROUTE. Gate op == 0x20. Labels prefixed arc_ucd_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x20;
        jne arc_ucd_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret;
      arc_ucd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_create_req_mute : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): mute from CREATE_ROUTE. Gate op == 0x20. Labels prefixed arc_ucm_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x20;
        jne arc_ucm_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 1;
        ret;
      arc_ucm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_create_req_gain : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): gain_q15 from CREATE_ROUTE, sign-extended. Gate op == 0x20. Labels prefixed arc_ucg_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x20;
        jne arc_ucg_bad;
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFF;
        // Sign-extend from 16 bits.
        mov r11, rax;
        shr r11, 15;
        cmp r11, 0;
        je  arc_ucg_out;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;
      arc_ucg_out:
        ret;
      arc_ucg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_destroy_req_route : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): route_slot from DESTROY_ROUTE. Gate op == 0x21. Labels prefixed arc_udr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x21;
        jne arc_udr_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      arc_udr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_set_gain_req_route : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): route_slot from SET_GAIN. Gate op == 0x22. Labels prefixed arc_usgr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x22;
        jne arc_usgr_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      arc_usgr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_set_gain_req_gain : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): gain_q15 from SET_GAIN, sign-extended. Gate op == 0x22. Labels prefixed arc_usgg_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x22;
        jne arc_usgg_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        mov r11, rax;
        shr r11, 15;
        cmp r11, 0;
        je  arc_usgg_out;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;
      arc_usgg_out:
        ret;
      arc_usgg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_set_mute_req_route : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): route_slot from SET_MUTE. Gate op == 0x23. Labels prefixed arc_usmr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x23;
        jne arc_usmr_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      arc_usmr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_set_mute_req_mute : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): mute from SET_MUTE. Gate op == 0x23. Labels prefixed arc_usmm_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x23;
        jne arc_usmm_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 1;
        ret;
      arc_usmm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_create_ack_route : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): route_slot from CREATE_ACK. Gate op == 0xF0. Labels prefixed arc_ucar_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xF0;
        jne arc_ucar_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      arc_ucar_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_routing_ack_status : (u64) -> u64 !{} @{} =
    fn (word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-001 (#1157): status from any ACK. Refuses non-ACK op (0xF0..0xF3). Labels prefixed arc_uas_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xF0;
        jb  arc_uas_bad;
        cmp rax, 0xF3;
        ja  arc_uas_bad;
        // For CREATE_ACK, status is at [63:16]; for others at [63:8].
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0xF0;
        je  arc_uas_create;
        mov rax, rdi;
        shr rax, 8;
        ret;
      arc_uas_create:
        mov rax, rdi;
        shr rax, 16;
        ret;
      arc_uas_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
