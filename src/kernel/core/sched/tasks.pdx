// src/kernel/core/sched/tasks.pdx — Phase 7 / R10-m4-002
// Task A and Task B entry points
// Issue: R10-m4-002 (#381)
//
// Per .plans §3.2 R10-m4-002:
//   Task A and Task B are the 2-task MVP for the cooperative scheduler.
//   Each task has an entry point that prints a message and halts.
//   Entry: via sched_switch_regs returning to (Task A|Task B)_entry.
//   Message output: uart_puts with pointer to _task_a_msg / _task_b_msg (boot_stub.S).
//   Halt: infinite hlt loop (m5 will add yield logic to enable task switching).
//
// HONEST SCOPE (paideia-as 0.11.0): Task bodies are simple: load message
// address and call uart_puts, then halt loop. Cross-module call to uart_puts
// is available in the kernel namespace (defined in Uart module, exported as pub).
// Messages are linked from boot_stub.S (.rodata section).

module Tasks = structure {
  // ============================================================================
  // Task A: cooperative yield loop (R10)
  // ============================================================================

  pub let task_a_entry : () -> () !{mem, sched} @{boot, sched} = fn() -> unsafe {
    effects: { mem, sched },
    capabilities: { boot, sched },
    justification: "R10 m5-002 / M7-D (#701): Task A entry point. Loop: log 'TASK A TICK' (via klog_s1(LEVEL_INFO, SUBSYS_SCHD, tag_sched_task_a_tick) with tag from keys.pdx), then yield to Task B via sched_switch_regs(task_a_tcb, task_b_tcb). When Task B yields back, resume the loop. Per x86-64 ABI, sched_switch_regs uses RDI and RSI for arguments; klog_s1 clobbers RDI/RSI/RDX but preserves all callee-save registers; after returning from sched_switch_regs, control continues at the next instruction (jmp loop).",
    block: {
      task_a_loop:
        mov rdi, 3;                    // LEVEL_INFO
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_sched_task_a_tick];
        call klog_s1;
        // Yield to Task B: sched_switch_regs(current=task_a_tcb, incoming=task_b_tcb)
        lea rdi, [rip + _task_a_tcb];
        lea rsi, [rip + _task_b_tcb];
        call sched_switch_regs;
        // When we come back (Task B yielded to us), loop and print again.
        jmp task_a_loop
    }
  }

  // ============================================================================
  // Task B: cooperative yield loop (R10)
  // ============================================================================

  pub let task_b_entry : () -> () !{mem, sched} @{boot, sched} = fn() -> unsafe {
    effects: { mem, sched },
    capabilities: { boot, sched },
    justification: "R10 m5-002 / M7-D (#701): Task B entry point. Loop: log 'TASK B TICK' (via klog_s1(LEVEL_INFO, SUBSYS_SCHD, tag_sched_task_b_tick) with tag from keys.pdx), then yield to Task A via sched_switch_regs(task_b_tcb, task_a_tcb). When Task A yields back, resume the loop. Symmetric to Task A.",
    block: {
      task_b_loop:
        mov rdi, 3;                    // LEVEL_INFO
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_sched_task_b_tick];
        call klog_s1;
        // Yield to Task A: sched_switch_regs(current=task_b_tcb, incoming=task_a_tcb)
        lea rdi, [rip + _task_b_tcb];
        lea rsi, [rip + _task_a_tcb];
        call sched_switch_regs;
        // When we come back (Task A yielded to us), loop and print again.
        jmp task_b_loop
    }
  }

  // ===========================================================================
  // R15-M7-003 (#564): Sched-switch witness storage and entry points
  // ===========================================================================

  // Fake TCB representing "kernel_main / boot context" — sched_switch_r15
  // saves the boot context here on the outbound leg. Full 2224-byte slab
  // for shape uniformity with real task_pool slots.
  pub let mut _sched_witness_boot_tcb   : [u64; 278] = uninit @align(4096)

  // Two witness tasks. Full 2224-byte slabs.
  pub let mut _sched_witness_task_a_tcb : [u64; 278] = uninit @align(4096)
  pub let mut _sched_witness_task_b_tcb : [u64; 278] = uninit @align(4096)

  // Kernel stacks: 4 KiB each. Task bodies below never recurse deeply.
  pub let mut _sched_witness_task_a_stack : [u64; 512] = uninit @align(16)
  pub let mut _sched_witness_task_b_stack : [u64; 512] = uninit @align(16)

  // Visit counters — u32 each, but stored in u64 slots for alignment.
  // Task A's body increments _sched_witness_a_visits on each entry.
  // Task B's body increments _sched_witness_b_visits similarly.
  pub let mut _sched_witness_a_visits : u64 = 0
  pub let mut _sched_witness_b_visits : u64 = 0

  // Task A body: increment visit counter, verify callee-save witness
  // values, switch to task B (up to 2 times), then switch back to boot.
  pub let _sched_witness_task_a_entry : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R15-M7-003 (#564) witness task A body. Runs on _sched_witness_task_a_stack after a first-time switch from boot context. Sequence: (1) load a distinctive value into r12 (callee-save; must survive the round-trip to task B and back). (2) atomically increment _sched_witness_a_visits (single-CPU, no atomic needed). (3) if visits == 2, fall through to the exit path (switch back to boot). (4) otherwise: sched_switch_r15(task_b_tcb); when we resume here (task_b switched back to us), verify r12 still holds our distinctive value (proves callee-save preservation across two switches); loop back to (2). (5) Exit path: sched_switch_r15(boot_tcb) — never returns from here (control resumes in kernel_main after the boot's first sched_switch_r15 call). ud2 as safety trap if it does return. Register discipline: r12 (witness value, callee-save); rax/rcx/rdi (scratch). This body itself uses no rbx/rbp/r13/r14/r15, so those are trivially preserved.",
      block: {
        mov r12, 0xAAAAAAAAAAAAAAAA;             // witness value in callee-save r12

      witness_task_a_loop:
        // Increment visits (u32 at [_sched_witness_a_visits+0])
        lea rax, [rip + _sched_witness_a_visits];
        mov ecx, [rax];
        add ecx, 1;
        mov [rax], ecx;

        // If visits == 2, exit
        cmp ecx, 2;
        jae witness_task_a_exit;

        // Switch to task B
        lea rdi, [rip + _sched_witness_task_b_tcb];
        call sched_switch_r15;

        // Resumed. Verify r12 is intact.
        mov rax, 0xAAAAAAAAAAAAAAAA;
        cmp r12, rax;
        jne witness_task_a_callee_save_fail;

        jmp witness_task_a_loop;

      witness_task_a_exit:
        // Switch back to boot context — never returns from here.
        lea rdi, [rip + _sched_witness_boot_tcb];
        call sched_switch_r15;
        ud2;                                     // unreachable — trap if we get here

      witness_task_a_callee_save_fail:
        // Callee-save was clobbered — write a distinctive value and hang.
        // (The boot side will time out; the witness marker will not appear.)
        lea rax, [rip + _sched_witness_a_visits];
        mov rcx, 0xDEADBEEF;
        mov [rax], rcx;
        ud2
      }
    }

  // Task B body: single visit, verify callee-save witness, switch back to A.
  pub let _sched_witness_task_b_entry : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R15-M7-003 (#564) witness task B body. Runs on _sched_witness_task_b_stack after a first-time switch from task A. Sequence: (1) load a distinctive DIFFERENT value into r13 (callee-save; must survive round-trip to task A and back). (2) atomically increment _sched_witness_b_visits. (3) sched_switch_r15(task_a_tcb) — control returns to task A's loop body. (4) When resumed (task A's second iteration switches back to us — actually, in our design task A exits after 2 visits, so task B never actually resumes after step 3; the resume-verify path is dead code that we keep for structural parity). Register discipline: r13 (witness value, callee-save); rax/rcx/rdi (scratch).",
      block: {
        mov r13, 0xBBBBBBBBBBBBBBBB;             // witness value in callee-save r13

      witness_task_b_loop:
        // Increment visits
        lea rax, [rip + _sched_witness_b_visits];
        mov ecx, [rax];
        add ecx, 1;
        mov [rax], ecx;

        // Switch to task A
        lea rdi, [rip + _sched_witness_task_a_tcb];
        call sched_switch_r15;

        // Resumed (dead code in our 3-switch design, but structurally
        // symmetric with task A's body). Verify r13 intact.
        mov rax, 0xBBBBBBBBBBBBBBBB;
        cmp r13, rax;
        jne witness_task_b_callee_save_fail;

        jmp witness_task_b_loop;

      witness_task_b_callee_save_fail:
        lea rax, [rip + _sched_witness_b_visits];
        mov rcx, 0xDEADBEEF;
        mov [rax], rcx;
        ud2
      }
    }

  // ===========================================================================
  // R15-M7-566 (#566) + R15-M7-745 (#745): Timer-preemption witness — two
  // ring-0 kernel tasks whose interleaving on the wire proves real preempt
  // ===========================================================================
  //
  // Design: two witness tasks W_A and W_B, each with its own 4 KiB kernel
  // stack and dedicated 2224-byte TCB slab.  Bodies loop:
  //
  //   klog "PA TICK" (or "PB TICK") → check target → reset own budget=1
  //     → sti → hlt → (timer preempt fires) → jmp loop.
  //
  // Both tasks start with sched_budget = SCHED_BUDGET_DEFAULT (1M —
  // initialized by kernel_main), enqueued in the runqueue.  Boot calls
  // sched_switch_r15(W_A) with sti in effect.
  //
  // Per-body budget reset (#745): the body writes budget=1 to its OWN TCB
  // (via [_current_tcb + 112]) immediately BEFORE `sti; hlt`.  This
  // bypasses handle_timer's reset-to-SCHED_BUDGET_DEFAULT-on-zero: after
  // handle_timer preempts the task, it resets budget back to 1M, which
  // would make the next slice ~10 000 s long at 100 Hz.  By re-writing
  // budget=1 in the loop body, the NEXT tick after `hlt` fires the
  // preempt.  Placing the reset AFTER klog_s1 (not before) avoids a race
  // window during klog's re-entrancy gate: if budget hit 0 inside
  // klog_emit_core's popfq-then-clear-gate window, the incoming task's
  // klog would observe gate=1 and silently skip its own PA/PB TICK.  With
  // reset-after-klog, budget stays at 1M-N during the entire klog call
  // (N = ticks that fire during klog, always << 1M) so preempt cannot
  // fire until the reset instruction executes.  See §5 of design/kernel/
  // r15-m7-745-preempt-witness-runtime.md.
  //
  // Termination: each body increments a shared visits counter; on reaching
  // PREEMPT_WITNESS_TARGET (3), the body calls sched_switch_r15(boot_tcb)
  // and boot resumes to dequeue + emit "R15 PREEMPT OK".
  //
  // Why ring-0 (kernel tasks) and not ring-3: preemption from ring-3
  // requires per-task TSS.RSP0 + kpti-mapped kstacks (delivered by #744,
  // 3b51985).  Ring-0 preemption pushes the iretq frame on the CURRENT
  // kernel stack (no TSS.RSP0 lookup), so each task's ISR-entry context
  // lands on its own kstack and no cross-task corruption is possible.
  // This keeps the witness self-contained: it exercises pick_next +
  // sched_switch_r15's ring-0 → ring-0 preempt path independently of the
  // ring-3 TSS.RSP0 machinery.
  //
  // Storage: reuses _sched_witness_boot_tcb (already allocated for #564).
  // NEW: _preempt_witness_task_a_tcb, _preempt_witness_task_b_tcb (2224-
  // byte slabs, .bss zero-init; kstack_top left 0 so sched_switch_r15's
  // TSS.RSP0 guard skips — irrelevant here since these tasks are ring-0-
  // only).  NEW: 4 KiB kernel stacks each.  NEW: shared visits counters.

  pub let mut _preempt_witness_task_a_tcb : [u64; 278] = uninit @align(4096)
  pub let mut _preempt_witness_task_b_tcb : [u64; 278] = uninit @align(4096)
  pub let mut _preempt_witness_task_a_stack : [u64; 512] = uninit @align(16)
  pub let mut _preempt_witness_task_b_stack : [u64; 512] = uninit @align(16)
  pub let mut _preempt_witness_a_visits : u64 = 0
  pub let mut _preempt_witness_b_visits : u64 = 0

  // Termination target: total visits per task before switching back to
  // boot.  With target=3 the deterministic interleaving is (task_a exits
  // on its 3rd visit before task_b's 3rd can fire):
  //   PA (a=1) → PB (b=1) → PA (a=2) → PB (b=2) → PA (a=3, exit).
  // Wire fingerprint checks a subset of this ordering (PA TICK / PB TICK
  // / PA TICK) after "R15 BLOCK WAKE OK" — proves task_a ran, preempt
  // switched to task_b, task_b ran, preempt switched back.  See
  // design/kernel/r15-m7-745-preempt-witness-runtime.md §7.
  //
  // paideia-as note: this value is documentation-only — the witness
  // bodies embed the literal `3` directly (paideia-as lacks compile-
  // time constant substitution in immediates).  Keep in sync with the
  // `cmp rcx, 3;` sites below and the `cmp rcx, 3` / `cmp rcx, 2`
  // verification in kernel_main.pdx preempt_witness.
  pub let PREEMPT_WITNESS_TARGET : u64 = 3

  pub let _preempt_witness_task_a_entry : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R15-M7-566 (#566) + R15-M7-745 (#745) preempt witness task A body — ring-0 hlt loop that logs 'PA TICK' each iteration and yields to the timer.  Sequence per iteration: (1) increment _preempt_witness_a_visits.  (2) klog_s1(LEVEL_INFO, SUBSYS_SCHD, tag_preempt_pa) — reaches wire via COM1.  (3) reload visits (klog_s1 clobbers caller-save), cmp vs PREEMPT_WITNESS_TARGET (=3); jae to exit path.  (4) #745 KEY: reset OWN TCB.sched_budget @+112 to 1 via [_current_tcb + 112].  Bypasses handle_timer's reset-to-1M-on-zero which would otherwise stretch the next slice to 10000 s (dead-clock symptom debugger diagnosed at #566 verify).  Placed AFTER klog to avoid a klog re-entrancy race: budget stays at 1M-N (N≤a-few) throughout klog, so preempt cannot fire in klog's popfq→clear-gate window, so the incoming task's klog never observes gate=1.  (5) sti+hlt — waits for the next timer tick.  (6) Timer preempts: handle_timer decrements 1→0, resets to 1M, sets _preempt_needed; trampoline_vec32 preempt tail rotates the runqueue and sched_switch_r15's to task_b.  (7) When task_b later preempts back, control returns via sched_switch_r15's continuation → trampoline post-call → 15-pop → iretq → instruction after hlt (= jmp loop below). Register discipline: rax/rcx/rdx/rdi/rsi scratch across klog_s1 + budget reset (all caller-save per klog contract; budget-reset uses rax/rcx clobbered scratch after klog returns).  IF stays enabled between iterations (sti issued before hlt each pass; timer ISR gate clears IF on entry, iretq restores IF=1 on resume).  Exit: switches back to boot via sched_switch_r15(_sched_witness_boot_tcb); ud2 sentinel unreachable.  See design/kernel/r15-m7-745-preempt-witness-runtime.md §5.",
      block: {
      preempt_witness_a_loop:
        // (1) Increment shared visits counter
        lea rax, [rip + _preempt_witness_a_visits];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;

        // (2) Emit PA TICK via klog_s1(LEVEL_INFO, SUBSYS_SCHD, tag_preempt_pa)
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_preempt_pa];
        call klog_s1;

        // (3) Reload visits and check target (klog_s1 clobbers caller-save)
        lea rax, [rip + _preempt_witness_a_visits];
        mov rcx, [rax];
        cmp rcx, 3;                        // PREEMPT_WITNESS_TARGET (tasks.pdx L213)
        jae preempt_witness_a_exit;

        // (4) #745: reset own TCB.sched_budget @+112 to 1 so the NEXT
        //     timer tick after `hlt` preempts.  Must happen after klog
        //     to avoid klog re-entrancy race (see §5 design doc).
        lea rax, [rip + _current_tcb];
        mov rax, [rax];                    // rax = &task_a's TCB
        mov rcx, 1;
        mov_d [rax + 112], rcx;            // TCB.sched_budget = 1

        // (5) Yield to timer.  sti is defensive (IF should already be 1
        //     from the prior iteration or boot's sti before switch-in).
        //     hlt halts until the next interrupt; timer at ~100 Hz fires
        //     within ~10 ms.  Preempt tail rotates to task_b.
        sti;
        hlt;
        jmp preempt_witness_a_loop;

      preempt_witness_a_exit:
        // Switch back to boot — never returns from here
        lea rdi, [rip + _sched_witness_boot_tcb];
        call sched_switch_r15;
        ud2
      }
    }

  pub let _preempt_witness_task_b_entry : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R15-M7-566 (#566) + R15-M7-745 (#745) preempt witness task B body — symmetric to task A but logs 'PB TICK' and uses _preempt_witness_b_visits.  Same per-iteration sequence: visits++ → klog PB TICK → cmp target → reset own budget to 1 → sti+hlt → preempt fires → jump back to loop start.  See task_a's justification for the full contract and design/kernel/r15-m7-745-preempt-witness-runtime.md §5 for the klog-race rationale behind reset-after-klog ordering.",
      block: {
      preempt_witness_b_loop:
        // (1) Increment shared visits counter
        lea rax, [rip + _preempt_witness_b_visits];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;

        // (2) Emit PB TICK via klog_s1
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_preempt_pb];
        call klog_s1;

        // (3) Reload visits and check target
        lea rax, [rip + _preempt_witness_b_visits];
        mov rcx, [rax];
        cmp rcx, 3;                        // PREEMPT_WITNESS_TARGET (tasks.pdx L213)
        jae preempt_witness_b_exit;

        // (4) #745: reset own TCB.sched_budget @+112 to 1
        lea rax, [rip + _current_tcb];
        mov rax, [rax];
        mov rcx, 1;
        mov_d [rax + 112], rcx;

        // (5) Yield to timer
        sti;
        hlt;
        jmp preempt_witness_b_loop;

      preempt_witness_b_exit:
        lea rdi, [rip + _sched_witness_boot_tcb];
        call sched_switch_r15;
        ud2
      }
    }
}
