// src/kernel/core/sched/task_pool.pdx — R15-M5-006 / R15-M5-008 / R15-M5-009
// Task pool slab storage, PID allocator/deallocator, and task constructor.
//
// Issues:
//   #544 (task_pool slab — 64 × 4KiB slots in .bss @align(4096))
//   #545 (pid_alloc — linear dense-low scan; returns pid ∈ [1,64] or 0)
//   #548 (task_new real — 7-step construction with aspace integration)

module TaskPool = structure {
  // ==========================================================================
  // R15-M5-044 / R15-M5-045: Task pool slab and PID allocation table
  // ==========================================================================
  // _task_pool: 64 task_struct slots, each 2224 bytes (278 u64s), 4 KiB-aligned
  // per #544. Layout: task_pool[i] = &_task_pool + i*4096 for i ∈ [0, 63],
  // hosting task struct indices [1, 64] (pid 0 is reserved sentinel).
  pub let mut _task_pool : [u64; 17792] = uninit @align(4096)

  // _pid_table: 64-entry PID allocation array. Index [pid] holds slab address
  // if allocated, or 0 if free. Compact mapping (§3.9 of #548):
  //   pid_table[pid] == &_task_pool[pid-1]  for allocated pid ∈ [1, 64]
  pub let mut _pid_table : [u64; 64] = uninit

  // ==========================================================================
  // R17-M0-728 (#728 D9): Per-task kernel stacks — one 16 KiB stack per pid
  // ==========================================================================
  //
  // Fixes the shared-`_syscall_kernel_stack` corruption that faults
  // sched_switch_r15's continuation ret with rip=0x2d.  When any task blocks
  // mid-syscall (via sched_block from wait4), its call chain — including the
  // return address of `call sched_switch_r15` inside sched_block — lives on
  // the kernel stack.  If that stack is shared with other tasks whose
  // syscalls run while the first task is blocked, those other tasks reset
  // rsp to the same base and push over the blocked task's saved data.
  // Per-task kernel stacks make that chain private to each task.
  //
  // Storage: 65 × 16 KiB in .bss (1040 KiB total).  Region for pid p is
  // [base + (p-1)*16384, base + p*16384) — i.e. pid 1 occupies the FIRST
  // 16 KiB block (array index 0), pid 64 occupies the LAST used block
  // (array index 63); the 65th block (array index 64, bytes
  // [base+64*16384, base+65*16384)) is the one that's actually unused —
  // it exists only so kstack_top(64) = base + 64*16384 lands one-past-end
  // of pid 64's own region while still being in-bounds for the array.
  // kstack_top(pid) = base + pid*16384 is the TOP (highest address,
  // initial RSP value) of pid's region, which is exactly what a
  // downward-growing x86-64 stack expects. Verified against the array's
  // .bss placement immediately after _pid_table (no aliasing) — see
  // r17-m0-728-d9-sys-exit-sched-switch-ud.md §6.1.
  //
  // Consumed by syscall_entry via [_current_tcb + 24] AFTER the CR3 flip to
  // kernel PML4.  Not mapped in user PML4 — inaccessible under user CR3 by
  // design (interrupts from ring-3 land on TSS.RSP0 / IST stacks, not on
  // this pool).
  //
  // See design/kernel/r17-m0-728-d9-sys-exit-sched-switch-ud.md §6.1.
  pub let KSTACK_QWORDS_PER_TASK : u64 = 2048    // 16 KiB / 8
  pub let KSTACK_BYTES_PER_TASK  : u64 = 16384
  pub let mut _task_kernel_stacks : [u64; 133120] = uninit @align(16)  // 65 * 2048

  // TCB byte-offset for kernel_stack_top.  Was previously an unused gap
  // between user_pml4_pa @+16 and regs_save.rsp @+32.  Verified not written
  // by any other task_struct-facing code via grep of '\[.*\+ 24\]' — all
  // other +24 users touch vnode / capability / stack-frame slabs, not
  // task_struct slabs.
  pub let TASK_OFF_KSTACK_TOP     : u64 = 24
  pub let TASK_OFF_SAVED_USER_RSP : u64 = 104

  // ==========================================================================
  // R15-M5-045 (#545): pid_alloc — scan _pid_table for first free slot
  // ==========================================================================
  pub let pid_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-045 (#545): Dense-low-first linear scan of _pid_table[1..64] for first NULL slot. Does NOT modify _pid_table (task_new writes the slab pointer in step 7). At R15.M5 single-CPU with no preemption inside task_new, the non-reservation is race-free. Return: pid ∈ [1, 64] on success; 0 on -EAGAIN (no free slot). Registers: callee-save clean (rbx, r12-r15 preserved). Contract pinned by #548 §2.3.",
      block: {
        mov rcx, 1;                            // scan start at index 1 (pid 1)
      pid_alloc_loop:
        cmp rcx, 64;                           // MAX_PIDS = 64 (array bound)
        jae pid_alloc_none;                    // #740 fix: was `ja` (allowed
                                               // rcx=64 to fall through and
                                               // read _pid_table[64], one
                                               // qword past the declared
                                               // [u64; 64] array at line 21).
                                               // `jae` correctly rejects at
                                               // rcx=64.  Reachability required
                                               // 63 consecutive live allocs
                                               // (indices 1–63 all occupied)
                                               // — genuinely latent at R17.M0
                                               // (~21 witnesses), but closes
                                               // the fencepost so it doesn't
                                               // become an OOB read primitive
                                               // as concurrency grows.
        lea rax, [rip + _pid_table];
        mov rax, [rax + rcx*8];                // load _pid_table[rcx]
        cmp rax, 0;
        je pid_alloc_found;                    // NULL → free slot
        add rcx, 1;
        jmp pid_alloc_loop;
      pid_alloc_found:
        mov rax, rcx;                          // return pid
        ret;
      pid_alloc_none:
        xor eax, eax;                          // return 0 (EAGAIN)
        ret
      }
    }

  // ==========================================================================
  // R15-M5-045 (#545): pid_free — release a PID slot (write NULL to table)
  // ==========================================================================
  // Trusted to be called only by task_new on rollback path, or by task_free
  // after cleanup. Contract: write _pid_table[pid] = 0 unconditionally.
  pub let pid_free : (u64) -> () !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-045 (#545): Two-instruction primitive called by task_new (#548 §3.4 rollback) and task_free (#550). Unconditionally writes _pid_table[pid] = 0. Safe on task_new's rollback path even though no write to pid_table has happened yet (pid_alloc contract §2.3: pid_alloc doesn't modify pid_table, so _pid_table[pid] was NULL before, stays NULL after pid_free). Registers: callee-save clean.",
      block: {
        lea rax, [rip + _pid_table];
        mov [rax + rdi*8], 0;                  // rdi = pid; store 0
        ret
      }
    }

  // ==========================================================================
  // R15-M5-006 (#548): task_new — construct a task_struct with aspace
  // ==========================================================================
  pub let task_new : (u64) -> u64 !{mem} @{} =
    fn (parent: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-006 (#548) + R17-M0-728 (#728 D9): task_struct construction. Entry: rdi = parent (*task, NULL for init). Return: rax = slab_addr on success, 0 on OOM. Sequence: (1) 3-push callee-save prologue. (2) Capture parent into rbx. (3) pid_alloc → r12 = pid; 0 → return 0. (4) slab_addr = &_task_pool + (pid-1)*4096 into r13 (shl 12). (5) aspace_create_user → 0xFFFFFFFF triggers rollback. (6) rep stosq 278 qwords zeroes the slab (folds fd_table zero). (7) Populate user_pml4_pa @+16, pid @+0, parent_pid @+4. (6.5 #728 D9) NEW: populate TCB.kstack_top @+24 = &_task_kernel_stacks + pid*16384 (shl 14). This is the per-task kernel-stack top consumed by syscall_entry — fixes the shared-`_syscall_kernel_stack` corruption where init's saved kernel-call chain (RA for `call sched_switch_r15` inside sched_block) was clobbered by child's syscalls resetting rsp to the same base. Slot 0 is unused (pids start at 1); the pid*16384 formula keeps arithmetic uniform. (8) Publish pid_table[pid] = slab_addr. (9) Return slab_addr. Register discipline: rbx/r12/r13 preserved via 3-push prologue; rax/rcx scratch across steps 6.5+7+8 (all caller-save, rcx re-loaded before pid_table write). Stack alignment: rsp ≡ 0 mod 16 at every nested call site.",
      block: {
        // ===== prologue: 3-push, capture parent =====
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                          // rbx = parent (u64; 0 sentinel for init)

        // ===== step 2: pid_alloc =====
        call pid_alloc;                        // rax = pid or 0
        cmp rax, 0;
        je task_new_fail_return;
        mov r12, rax;                          // r12 = pid

        // ===== step 3: slab_addr = &_task_pool + (pid-1)*4096 =====
        lea r13, [rip + _task_pool];
        mov rcx, r12;
        sub rcx, 1;
        shl rcx, 12;                           // *4096
        add r13, rcx;                          // r13 = slab_addr

        // ===== step 4: aspace_create_user =====
        call aspace_create_user;               // rax = pml4_pa or 0xFFFFFFFF
        mov rcx, 4294967295;                   // 0xFFFFFFFF (ASPACE_CREATE_OOM)
        cmp rax, rcx;
        je task_new_fail_rollback;

        // ===== step 5: rep stosq — zero 2224 bytes =====
        push rax;                              // stash pml4_pa (rep_stosq clobbers rax)
        mov rdi, r13;                          // dst = slab
        mov rcx, 278;                          // 2224/8 qwords
        xor eax, eax;                          // fill = 0
        rep_stosq;
        pop rcx;                               // rcx = pml4_pa

        // ===== step 6: populate fields =====
        // #658-BOUNDARY: user_pml4_pa is aspace_create_user's return, in
        // phys_alloc-VA form (see phys_alloc.pdx / aspace_create.pdx #658
        // CONTRACT). Field name says "_pa" but stored value is VA. Every
        // real `mov cr3` derived from [r13+16] MUST subtract KERNEL_VMA_BASE
        // at the boundary — see kernel_main.pdx enter_userland_initial call
        // sites (:889 R15 witness, :6052 shell boot) for the pattern.
        mov [r13 + 16], rcx;                   // user_pml4_pa
        mov [r13 + 0], r12d;                   // pid (u32)
        xor eax, eax;                          // default parent_pid = 0
        cmp rbx, 0;                            // NULL parent?
        je task_new_skip_parent_load;
        mov eax, [rbx + 0];                    // parent->pid (u32)
      task_new_skip_parent_load:
        mov [r13 + 4], eax;                    // parent_pid (u32)
        // state @ 8 stays at rep-stosq zero == STATE_NEW

        // ===== step 6.5 (#728 D9): per-task kernel stack top =====
        // kstack_top(pid) = &_task_kernel_stacks + pid * 16384.  Consumed
        // by syscall_entry via [_current_tcb + 24] after the CR3 flip.
        // rcx clobbered; safe (pml4_pa write above is done).  rax stays
        // scratch; the pid_table write below re-loads rcx.
        lea rax, [rip + _task_kernel_stacks];
        mov rcx, r12;                          // rcx = pid
        shl rcx, 14;                           // rcx = pid * 16384
        add rax, rcx;                          // rax = kstack_top for this pid
        mov [r13 + 24], rax;                   // TCB.kstack_top @ +24

        // ===== step 7: pid_table[pid] = slab_addr =====
        lea rcx, [rip + _pid_table];
        mov [rcx + r12*8], r13;

        // ===== epilogue: return slab_addr =====
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // ===== OOM rollback: release pid, then return 0 =====
      task_new_fail_rollback:
        mov edi, r12d;                         // rdi = pid
        call pid_free;
        // fall through

      task_new_fail_return:
        xor eax, eax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // R15-M5-008 (#550): task_free — destroy a task_struct with aspace/pid cleanup
  // ==========================================================================
  pub let task_free : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (t: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R15.M5-008 (#550): task_free real body — extract pid + pml4, aspace_teardown, rep stosq slab-zero (folds fd_table zero), pid_free LAST for R15.M6 reuse-safety. 3-push callee-save prologue (rbx/r12/r13). Uses rep stosq at 278 qwords to zero the 2224-byte task_struct slab. rcx MUST be explicitly set before rep stosq (backtrack H5).",
      block: {
        push rbx;                            // SysV: entry rsp = 8 mod 16
        push r12;
        push r13;                            // 3 pushes → rsp = 0 mod 16 (aligned for nested calls)

        mov rbx, rdi;                        // rbx = task base (preserved across teardown)
        mov r12d, [rbx + 0];                 // r12 = pid (u32 zero-ext) — TASK_OFF_PID
        mov r13, [rbx + 16];                 // r13 = user_pml4_pa — TASK_OFF_USER_PML4

        // step 3: aspace_teardown(pml4) — releases PML4 + all leaves + PTs
        mov rdi, r13;
        call aspace_teardown;                // returns 0 at R15.M5; discard rax

        // step 4: rep stosq — zero 2224-byte slab (folds fd_table[0..32] zero as side effect)
        mov rdi, rbx;                        // dst = task base
        mov rcx, 278;                        // 2224 / 8 qwords — MUST be set explicitly
        xor rax, rax;                        // fill value
        rep_stosq;                           // F3 48 AB

        // step 5: pid_free(pid) LAST — slab must be fully zero before pid becomes reusable
        mov edi, r12d;
        call pid_free;

        xor rax, rax;                        // return 0
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
