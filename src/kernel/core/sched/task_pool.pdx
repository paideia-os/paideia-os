// src/kernel/core/sched/task_pool.pdx — R15-M5-006 / R15-M5-008 / R15-M5-009
// Task pool slab storage, PID allocator/deallocator, and task constructor.
//
// Issues:
//   #544 (task_pool slab — 64 × 4KiB slots in .bss @align(4096))
//   #545 (pid_alloc — linear dense-low scan; returns pid ∈ [1,64] or 0)
//   #548 (task_new real — 7-step construction with aspace integration)

module TaskPool = structure {
  // ==========================================================================
  // R31.M2-1594 (#1594): THE POOL GEOMETRY, DERIVED ONCE
  // ==========================================================================
  //
  // Until #1594 the pool's size and the pid ceiling were independent literals
  // that disagreed, and the disagreement was silent:
  //
  //     _task_pool : [u64; 17792]      = 142336 bytes = 64 * 2224
  //     task_new   : slab = base + (pid-1) * 4096
  //     pid_alloc  : hands out pid up to 63
  //
  // 17792 was computed from the STRUCT size (64 slots x 278 qwords). The
  // addressing was computed from the SLOT stride (4096). Those are different
  // numbers, so the array held 142336/4096 = 34.75 slots while the allocator
  // addressed 63 of them. pid 35 was the last whose 2224-byte construction
  // landed fully inside the array; pid 36 began 1024 bytes PAST the end and
  // every pid from 36 to 63 wrote its entire task_struct into whatever the
  // linker had placed next — which, at 12768dc, was `_task_kernel_stacks`.
  // A task_struct aliased onto another task's kernel stack is not a
  // corrupted buffer; it is two writers with different ideas about what the
  // bytes mean, one of them a return-address chain.
  //
  // The sibling array got this right and shows the shape the fix takes:
  // Xsave._task_xsave_areas is `[u64; 33280]` with the comment "65 * 512",
  // i.e. sized from the SLOT (65 * 4096 / 8). Sizing from the slot is the
  // only correct rule when the addressing strides by the slot.
  //
  // Nothing reached pid 36 because the boot path uses four pids, which is
  // exactly why this survived ~53 iterations of witnesses. It was also
  // getting closer: 12768dc moved init's children from pid 2 to pid 4.
  //
  // THE CONSTANTS BELOW ARE THE SINGLE SOURCE. paideia-as (4d0e7b3) requires
  // an array length to be an integer LITERAL — `[u64; MAX_PIDS * 512]` does
  // not parse as a length and silently degrades to an 8-byte .bss object via
  // cmd_build/layout.rs `compute_bss_size_from_type`, which returns 8 for any
  // non-`ExprLiteral` length. So TASK_POOL_QWORDS cannot literally BE the
  // array bound in the source. tools/verify-task-pool-bounds.sh closes that
  // gap: it recomputes MAX_PIDS * TASK_SLOT_BYTES / 8 from these constants
  // and refuses the build unless the declared literal matches. Two numbers
  // that must agree are made to agree by something that checks, rather than
  // by a comment asking the next reader to.
  //
  // See design/kernel/r31-m2-1594-task-pool-sizing.md.

  // MAX_PIDS is the ENTRY COUNT of the pid-indexed tables, not the number of
  // live tasks. _pid_table and _pid_gen are indexed BY PID with pid 0 as a
  // reserved sentinel, so the allocatable range is [1, MAX_PIDS-1] and the
  // concurrent-task ceiling is 63, not 64.
  //
  // The ceiling was reviewed as part of #1594 rather than raised to make the
  // assertion pass. 63 is kept, deliberately:
  //
  //   * It is what the tables can express. `pid_alloc`'s `cmp rcx, 64 / jae`
  //     is the ARRAY BOUND of _pid_table, not a policy number — #740 fixed it
  //     from `ja` to `jae` precisely because pid 64 reads one qword past the
  //     declared [u64; 64]. Raising the ceiling to a true 64 concurrent tasks
  //     means 65-entry tables and moving three bounds, two of which live in
  //     the sys_exit / sys_wait scanners that still use `ja` and are #1585's
  //     territory. Widening the ceiling here would edit those under a
  //     different issue's argument.
  //   * Nothing is near it. Boot reaches pid 4. 63 is ~16x headroom, and the
  //     structure that would actually bind first is the 65-slot kernel-stack
  //     and XSAVE arrays, which are gated below against this same constant.
  //
  // The old comments on these declarations claimed "64 slots" and
  // "pid ∈ [1, 64]". That claim is the origin of this defect — it describes a
  // 64-task limit the tables cannot express, and 64 * 2224 is what someone
  // computed from it. They are corrected to 63 here.
  pub let MAX_PIDS           : u64 = 64        // _pid_table / _pid_gen entries
  pub let PID_MAX            : u64 = 63        // highest allocatable pid
  pub let TASK_SLOT_SHIFT    : u64 = 12        // log2(TASK_SLOT_BYTES)
  pub let TASK_SLOT_BYTES    : u64 = 4096      // pool stride: 1 << 12
  pub let TASK_STRUCT_QWORDS : u64 = 278       // live footprint, in qwords
  pub let TASK_STRUCT_BYTES  : u64 = 2224      // live footprint: 278 * 8
  pub let TASK_POOL_QWORDS   : u64 = 32768     // MAX_PIDS * TASK_SLOT_BYTES / 8

  // ==========================================================================
  // R15-M5-044 / R15-M5-045: Task pool slab and PID allocation table
  // ==========================================================================
  // _task_pool: MAX_PIDS slots of TASK_SLOT_BYTES each, 4 KiB-aligned per
  // #544. Layout: slab(pid) = &_task_pool + (pid-1)*TASK_SLOT_BYTES for
  // pid ∈ [1, PID_MAX]; pid 0 is a reserved sentinel and gets no slot.
  //
  // WHY THE SLOT IS 4096 AND THE STRUCT IS 2224, and why the 1872-byte
  // difference is padding rather than a leak:
  //
  //   * 2224 is the struct, and it is FULL. sys_fork.pdx pins
  //     TASK_OFF_LANDING_RA at +2216 — the last qword of the slab. There is
  //     no field above it, so no code reads a byte of the padding, so a
  //     recycled slot cannot hand a fresh task a dead task's bytes through
  //     it. verify-task-pool-bounds.sh asserts max(TASK_OFF_*) + 8 <=
  //     TASK_STRUCT_BYTES so that a new field at +2224 fails the build
  //     instead of quietly extending the struct past what task_new zeroes.
  //   * 4096 is the stride, and it is deliberate: it makes pid -> slab a
  //     single `shl 12` instead of an imul by a non-power-of-two. The same
  //     trade is made and named for the AP idle TCBs — see ap_bringup.pdx
  //     §"Storage layout", which spends the identical 1872 bytes per slot for
  //     the identical reason.
  //   * The zero-fill therefore covers the STRUCT (278 qwords), not the SLOT.
  //     Widening it to 512 qwords would look tidier and would be a bug:
  //     task_free takes an arbitrary task pointer, and the tree holds 18
  //     standalone `[u64; 278]` slabs (idle, the sched/preempt witnesses, the
  //     chaos fake TCB, the syscall witness tasks) that are exactly 2224
  //     bytes with no padding to spare. A 4096-byte fill through any of them
  //     overruns. The gate pins those 18 to TASK_STRUCT_QWORDS for the same
  //     reason.
  //
  // Before #1594 the padding was NOT inside the array — the array ended at
  // 64*2224, so slot 34's tail ran past it and the linker had laid
  // _pid_table and _pid_gen inside that tail. They were spared only because
  // nothing addresses a slab above +2224. Sizing from the slot puts all the
  // padding back inside the object it belongs to.
  pub let mut _task_pool : [u64; 32768] = uninit @align(4096)

  // _pid_table: MAX_PIDS-entry PID allocation array. Index [pid] holds slab
  // address if allocated, or 0 if free. Compact mapping (§3.9 of #548):
  //   pid_table[pid] == slab(pid)  for allocated pid ∈ [1, PID_MAX]
  pub let mut _pid_table : [u64; 64] = uninit

  // ==========================================================================
  // R31.M0-1583 (#1583): _pid_gen — the incarnation counter that makes a pid
  // a usable identity across reuse
  // ==========================================================================
  //
  // `pid_alloc` is a dense-low-first scan and `pid_free` unconditionally
  // zeroes the slot, so a reaped pid is handed back to the very next
  // `task_new`. That is fine for a pid used as a transient handle and fatal
  // for a pid used as a *correlation key* — which is exactly what #1583 needs
  // it to be, to match a dying task against the driver row it owned.
  //
  // Without a generation, the failure is not "we miss a revocation"; it is
  // the strictly worse "we revoke the wrong process's capabilities". A driver
  // row still naming pid 7 from a previous occupant, plus a fresh unrelated
  // task that happened to be handed pid 7, is enough to tear down a live
  // process's authority on the strength of a number collision.
  //
  // `_pid_gen[p]` is bumped by `task_new` at the moment the slot acquires a
  // new occupant, so the pair (pid, gen) names a *task incarnation* rather
  // than a table index. Two properties follow and both are load-bearing:
  //
  //   * It is never zero for a live task. First allocation of any pid yields
  //     generation 1, so zero is available as an "unbound" sentinel in the
  //     driver row's pid field (driver_table.pdx §pid-generation) without
  //     colliding with a real incarnation.
  //   * It is per-pid, not global. Aliasing requires 65536 reuses *of the
  //     same pid* between a bind and the death that consumes it, since the
  //     driver row carries the low 16 bits. That residual is named in
  //     design/drivers/process-death.md §5 rather than hidden; it is second-
  //     line defence in any case, because the binding is also explicitly
  //     invalidated on teardown, restart and death.
  //
  // The array is indexed by pid exactly like _pid_table, and index 0 is the
  // same reserved sentinel (pid 0 is never allocated).
  pub let mut _pid_gen : [u64; 64] = uninit

  // ==========================================================================
  // R17-M0-728 (#728 D9): Per-task kernel stacks — one 16 KiB stack per pid
  // ==========================================================================
  //
  // Fixes the shared-`_syscall_kernel_stack` corruption that faults
  // sched_switch_r15's continuation ret with rip=0x2d.  When any task blocks
  // mid-syscall (via sched_block from wait4), its call chain — including the
  // return address of `call sched_switch_r15` inside sched_block — lives on
  // the kernel stack.  If that stack is shared with other tasks whose
  // syscalls run while the first task is blocked, those other tasks reset
  // rsp to the same base and push over the blocked task's saved data.
  // Per-task kernel stacks make that chain private to each task.
  //
  // Storage: 65 × 16 KiB in .bss (1040 KiB total).  Region for pid p is
  // [base + (p-1)*16384, base + p*16384) — i.e. pid 1 occupies the FIRST
  // 16 KiB block (array index 0), pid PID_MAX (63) occupies the LAST block
  // an allocatable pid can reach (array index 62); kstack_top(63) =
  // base + 63*16384 lands one-past-end of pid 63's own region while still
  // being in-bounds for the array.  #1594 note: this array was sized for a
  // 64-block ceiling that pid_alloc's `jae 64` never reaches, so it has two
  // spare blocks rather than one.  That headroom is why the #1594 overflow
  // (every pid from 36 up wrote its task_struct into THIS array) did not
  // also run off the end of it — the corruption stayed inside the kernel
  // stacks of pids 1..7 rather than reaching whatever follows.
  // verify-task-pool-bounds.sh now pins this array against MAX_PIDS too.
  // kstack_top(pid) = base + pid*16384 is the TOP (highest address,
  // initial RSP value) of pid's region, which is exactly what a
  // downward-growing x86-64 stack expects. Verified against the array's
  // .bss placement immediately after _pid_table (no aliasing) — see
  // r17-m0-728-d9-sys-exit-sched-switch-ud.md §6.1.
  //
  // Consumed by syscall_entry via [_current_tcb + 24] AFTER the CR3 flip to
  // kernel PML4.  Not mapped in user PML4 — inaccessible under user CR3 by
  // design (interrupts from ring-3 land on TSS.RSP0 / IST stacks, not on
  // this pool).
  //
  // See design/kernel/r17-m0-728-d9-sys-exit-sched-switch-ud.md §6.1.
  pub let KSTACK_QWORDS_PER_TASK : u64 = 2048    // 16 KiB / 8
  pub let KSTACK_BYTES_PER_TASK  : u64 = 16384
  pub let mut _task_kernel_stacks : [u64; 133120] = uninit @align(16)  // 65 * 2048

  // TCB byte-offset for kernel_stack_top.  Was previously an unused gap
  // between user_pml4_pa @+16 and regs_save.rsp @+32.  Verified not written
  // by any other task_struct-facing code via grep of '\[.*\+ 24\]' — all
  // other +24 users touch vnode / capability / stack-frame slabs, not
  // task_struct slabs.
  pub let TASK_OFF_KSTACK_TOP     : u64 = 24
  pub let TASK_OFF_SAVED_USER_RSP : u64 = 104

  // ==========================================================================
  // R15-M7-566 (#566): sched_budget field — timer-tick preemption budget
  // ==========================================================================
  //
  // u32 field at TCB byte offset +112. Decremented by the timer ISR
  // (core/int/exceptions.pdx handle_timer) on every 100 Hz tick for the
  // running TCB. When it reaches zero the ISR resets it to
  // SCHED_BUDGET_DEFAULT and raises _preempt_needed; trampoline_vec32
  // (core/int/idt.pdx) then consults the runqueue for a different runnable
  // task and switches to it via sched_switch_r15.
  //
  // Slot rationale: +104 is saved_user_rsp (#728 D9); +168 is FD_TABLE start.
  // The 56-byte gap +112..+167 was R11-era callee-save spill space that R15
  // task_struct never wrote — verified clean via grep for +112/+120/+128/
  // +136/+144/+152 memops across the R15 sched/syscall paths.
  //
  // Adopted slots (each one erodes the "clean" claim above by exactly one
  // qword-sized region; keep this list in sync when adding fields):
  //   +112..+115  TASK_OFF_SCHED_BUDGET       (u32) — this file, #566
  //   +120..+121  TASK_OFF_WAIT_ENDPOINT_ID   (u16) — state.pdx, R20b.M3-001
  //   +128..+135  TASK_OFF_CPU_MASK           (u64) — syscall/handlers/
  //                                                   sched_affinity.pdx,
  //                                                   #1582 part B
  // Remaining free: +122..+127 (6 B after the u16 endpoint id) and
  // +136..+167 (32 B).  Any new field goes into the free region above
  // TCB_OFF_CPU_MASK first; a field that must be at a fixed offset lower
  // than +128 belongs in the +122..+127 gap only if it is <= 6 bytes.
  //
  // Default = 10 ticks × 10 ms/tick = 100 ms slice. Chosen to comfortably
  // exceed the AC completion window (fork→exec→wait→exit finishes in tens
  // of milliseconds), so preemption never fires during the AC and the guard
  // "next == current, skip switch" in trampoline_vec32 keeps AC single-task
  // semantics intact.
  //
  // See design/kernel/r15-m7-566-timer-preempt.md.
  pub let TASK_OFF_SCHED_BUDGET  : u64 = 112
  pub let SCHED_BUDGET_DEFAULT   : u32 = 1000000

  // ==========================================================================
  // R15-M5-045 (#545): pid_alloc — scan _pid_table for first free slot
  // ==========================================================================
  pub let pid_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-045 (#545): Dense-low-first linear scan of _pid_table[1..64] for first NULL slot. Does NOT modify _pid_table (task_new writes the slab pointer in step 7). At R15.M5 single-CPU with no preemption inside task_new, the non-reservation is race-free. Return: pid ∈ [1, 64] on success; 0 on -EAGAIN (no free slot). Registers: callee-save clean (rbx, r12-r15 preserved). Contract pinned by #548 §2.3.",
      block: {
        mov rcx, 1;                            // scan start at index 1 (pid 1)
      pid_alloc_loop:
        cmp rcx, 64;                           // MAX_PIDS = 64 (array bound)
        jae pid_alloc_none;                    // #740 fix: was `ja` (allowed
                                               // rcx=64 to fall through and
                                               // read _pid_table[64], one
                                               // qword past the declared
                                               // [u64; 64] array at line 21).
                                               // `jae` correctly rejects at
                                               // rcx=64.  Reachability required
                                               // 63 consecutive live allocs
                                               // (indices 1–63 all occupied)
                                               // — genuinely latent at R17.M0
                                               // (~21 witnesses), but closes
                                               // the fencepost so it doesn't
                                               // become an OOB read primitive
                                               // as concurrency grows.
        lea rax, [rip + _pid_table];
        mov rax, [rax + rcx*8];                // load _pid_table[rcx]
        cmp rax, 0;
        je pid_alloc_found;                    // NULL → free slot
        add rcx, 1;
        jmp pid_alloc_loop;
      pid_alloc_found:
        mov rax, rcx;                          // return pid
        ret;
      pid_alloc_none:
        xor eax, eax;                          // return 0 (EAGAIN)
        ret
      }
    }

  // ==========================================================================
  // R15-M5-045 (#545): pid_free — release a PID slot (write NULL to table)
  // ==========================================================================
  // Trusted to be called only by task_new on rollback path, or by task_free
  // after cleanup. Contract: write _pid_table[pid] = 0 unconditionally.
  pub let pid_free : (u64) -> () !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-045 (#545): Two-instruction primitive called by task_new (#548 §3.4 rollback) and task_free (#550). Unconditionally writes _pid_table[pid] = 0. Safe on task_new's rollback path even though no write to pid_table has happened yet (pid_alloc contract §2.3: pid_alloc doesn't modify pid_table, so _pid_table[pid] was NULL before, stays NULL after pid_free). Registers: callee-save clean.",
      block: {
        lea rax, [rip + _pid_table];
        mov [rax + rdi*8], 0;                  // rdi = pid; store 0
        ret
      }
    }

  // ==========================================================================
  // R31.M2-1594 (#1594): task_slab_of_pid — the ONE place pid becomes an address
  // ==========================================================================
  //
  // This existed only as five inline instructions inside task_new. That was
  // the other half of #1594: the arithmetic that could walk off the array had
  // no name, so it had no bound, no caller other than itself, and nothing a
  // witness could aim at without re-deriving it and drifting.
  //
  // Giving it a name buys three things:
  //
  //   * A BOUND. It refuses pid 0 and any pid >= MAX_PIDS and answers 0,
  //     which task_new treats as an allocation failure. Even if the array
  //     literal and the ceiling disagree again, the refusal is at the point
  //     of address formation rather than at the point of the store.
  //   * ONE DERIVATION. task_new and the bounds witness compute the slab the
  //     same way because they call the same function. A witness that
  //     re-implemented `base + (pid-1) << 12` would pass while task_new did
  //     something else.
  //   * A GATE TARGET. verify-task-pool-bounds.sh pins this function's
  //     ceiling literal to MAX_PIDS and its shift to TASK_SLOT_SHIFT, so a
  //     stride change that does not resize the array fails the build.
  //
  // The refusal at pid 0 is not defensive noise: pid 0 is the reserved
  // sentinel, and `(0-1) << 12` is 0xFFFFFFFFFFFFF000, which added to the
  // pool base is a wild pointer 4096 bytes BELOW it. `jae MAX_PIDS` alone
  // would let that through.
  //
  // Mirrors Xsave.xsave_area_for, which does the same job for the parallel
  // per-pid XSAVE storage — with the bound this one has and that one lacks.
  pub let task_slab_of_pid : (u64) -> u64 !{} @{} =
    fn (pid: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R31.M2-1594 (#1594): pid -> task_struct slab VA, bounds-checked. Returns &_task_pool + (pid-1)*TASK_SLOT_BYTES for pid in [1, MAX_PIDS-1], and 0 for pid 0 (reserved sentinel) or pid >= MAX_PIDS. Pure arithmetic over a .bss base — no effects, no capabilities, leaf, callee-save clean; rax and rcx are the only registers written and both are caller-save, which is what lets task_new call it between pid_alloc and aspace_create_user without spilling. The two-sided check is required, not decorative: `jae MAX_PIDS` alone admits pid 0, and (0-1) << 12 = 0xFFFFFFFFFFFFF000 lands the slab one slot BELOW the pool base. Answering 0 for both out-of-range ends collapses 'no such pid' into one value that task_new already has a rollback path for. The shift is TASK_SLOT_SHIFT (12) and the ceiling is MAX_PIDS (64); tools/verify-task-pool-bounds.sh pins both against the declared _task_pool length so that a stride or ceiling change that outgrows the array fails the build rather than producing addresses past its end — the defect this function was extracted to close.",
      block: {
        cmp rdi, 0;                            // pid 0 = reserved sentinel
        je task_slab_of_pid_none;
        cmp rdi, 64;                           // MAX_PIDS (table bound)
        jae task_slab_of_pid_none;
        lea rax, [rip + _task_pool];
        mov rcx, rdi;
        sub rcx, 1;                            // slot index = pid - 1
        shl rcx, 12;                           // TASK_SLOT_SHIFT
        add rax, rcx;
        ret;
      task_slab_of_pid_none:
        xor eax, eax;
        ret
      }
    }

  // ==========================================================================
  // R31.M0-1583 (#1583): pid_gen_read / pid_gen_bump
  // ==========================================================================
  //
  // Both are bounds-checked at 64 and answer 0 for an out-of-range pid, which
  // is the same answer they give for "never allocated". A caller cannot
  // distinguish the two and does not need to: both mean "there is no live
  // task incarnation here", and every consumer treats 0 as "do not correlate".
  // The bound is `jae 64` rather than `ja`, matching the #740 fix in
  // pid_alloc — the two sibling scanners in sys_exit/sys_wait still use `ja`
  // and read one qword past their arrays, which is #1585's territory, not
  // this array's.

  pub let pid_gen_read : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M0-1583 (#1583): read the incarnation counter for pid. Leaf, no nested calls, callee-save clean; rax is the only register written. Bound check is `cmp rdi, 64 / jae` so pid 64 is refused rather than reading one qword past the declared [u64; 64] array — the same fencepost #740 closed in pid_alloc. Answers 0 for both out-of-range and never-allocated, deliberately: every consumer treats 0 as 'no live incarnation to correlate against', so collapsing the two costs no information and removes a sentinel. Never returns 0 for a pid that currently hosts a task, because pid_gen_bump runs before task_new publishes the slab pointer and only ever increments.",
      block: {
        cmp rdi, 64;                           // MAX_PIDS (array bound)
        jae pid_gen_read_none;
        lea rax, [rip + _pid_gen];
        mov rax, [rax + rdi*8];
        ret;
      pid_gen_read_none:
        xor eax, eax;
        ret
      }
    }

  // ==========================================================================
  // #1598: pid_alive — LIVENESS, not identity
  // ==========================================================================
  //
  // Returns 1 iff _pid_table[pid] currently holds a task slab pointer, 0
  // otherwise (unallocated, reaped, or out-of-range). This is the answer
  // driver_death_bind actually needs: pid_gen_read stays non-zero after
  // pid_free (pid_free zeroes _pid_table but leaves _pid_gen alone, so a
  // reaped pid's generation persists as the record of its previous
  // incarnation — that persistence is the whole reason (pid, gen) works as
  // a correlation key), so a bind gated on "generation != 0" would admit
  // a reaped pid and install a key pointing at a task that no longer
  // exists. This function is the liveness half that was missing.
  //
  // Same bound as pid_gen_read: `jae 64` refuses pid 64 rather than
  // reading one qword past the declared [u64; 64] array.
  pub let pid_alive : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "#1598: 1 iff _pid_table[pid] names a live task slab. Distinct from pid_gen_read(pid) != 0 because pid_free zeroes _pid_table but not _pid_gen — a reaped pid retains its non-zero generation, so gating a bind on the generation alone would admit dead pids. Leaf, callee-save clean; rax scratch only. Same jae 64 bound as pid_gen_read.",
      block: {
        cmp rdi, 64;                           // MAX_PIDS (array bound)
        jae pid_alive_no;
        lea rax, [rip + _pid_table];
        mov rax, [rax + rdi*8];
        cmp rax, 0;
        je  pid_alive_no;
        mov rax, 1;
        ret;
      pid_alive_no:
        xor eax, eax;
        ret
      }
    }

  pub let pid_gen_bump : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R31.M0-1583 (#1583): retire the previous occupant of a pid slot and name the new one. Called by task_new (step 6.6) BEFORE the _pid_table publish, so the ordering invariant is that no task is ever observable at a generation lower than the one stamped for it. Leaf, callee-save clean; rax/rcx scratch only, which task_new's step 7 tolerates because it re-loads rcx for the pid_table write. Returns the NEW generation so a caller that needs the identity does not have to re-read. Monotonic and never zero after the first call for a given pid: the first bump of a .bss-zero slot yields 1, which is what lets zero serve as the driver row's 'unbound' sentinel. Wrap is at 2^64 here; the driver row truncates to 16 bits and names that residual itself.",
      block: {
        cmp rdi, 64;                           // MAX_PIDS (array bound)
        jae pid_gen_bump_none;
        lea rax, [rip + _pid_gen];
        mov rcx, [rax + rdi*8];
        add rcx, 1;
        mov [rax + rdi*8], rcx;
        mov rax, rcx;
        ret;
      pid_gen_bump_none:
        xor eax, eax;
        ret
      }
    }

  // ==========================================================================
  // R15-M5-006 (#548): task_new — construct a task_struct with aspace
  // ==========================================================================
  pub let task_new : (u64) -> u64 !{mem} @{} =
    fn (parent: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R15-M5-006 (#548) + R17-M0-728 (#728 D9) + R15-M7-566 (#566): task_struct construction. Entry: rdi = parent (*task, NULL for init). Return: rax = slab_addr on success, 0 on OOM. Sequence: (1) 3-push callee-save prologue. (2) Capture parent into rbx. (3) pid_alloc → r12 = pid; 0 → return 0. (4 #1594) slab_addr = task_slab_of_pid(pid) into r13; the five inline instructions this replaces had no bound, and with a 142336-byte array and a 4096-byte stride every pid from 36 up formed an address past its end. A 0 answer means the pool and the pid ceiling have diverged and takes the existing rollback (pid_free, return 0) rather than being stored through. task_slab_of_pid clobbers only rax/rcx, both caller-save, so rbx/r12 survive without a spill. (5) aspace_create_user → 0xFFFFFFFF triggers rollback. (6) rep stosq 278 qwords zeroes the slab (folds fd_table zero). (7) Populate user_pml4_pa @+16, pid @+0, parent_pid @+4. (6.5 #728 D9) populate TCB.kstack_top @+24 = &_task_kernel_stacks + pid*16384 (shl 14). This is the per-task kernel-stack top consumed by syscall_entry — fixes the shared-`_syscall_kernel_stack` corruption where init's saved kernel-call chain (RA for `call sched_switch_r15` inside sched_block) was clobbered by child's syscalls resetting rsp to the same base. Slot 0 is unused (pids start at 1); the pid*16384 formula keeps arithmetic uniform. (6.5b #566) NEW: populate TCB.sched_budget @+112 = SCHED_BUDGET_DEFAULT (10 ticks). This is the timer-tick preemption budget consumed by handle_timer at 100 Hz — every task starts with a fresh 100 ms slice, which comfortably exceeds the AC fork→exec→wait→exit window so no preemption fires during the AC even though the plumbing is live. See design/kernel/r15-m7-566-timer-preempt.md §3.1. Uses mov_d to write exactly 4 bytes at +112; the 4 bytes at +116..+119 remain zero (reserved for a future sched_priority companion). (6.6 #1583) NEW: call pid_gen_bump(pid) to retire the previous occupant of this pid slot and stamp this task's incarnation, BEFORE the step-7 publish. That ordering is the invariant #1583 relies on: a reader that resolves a pid through _pid_table and then reads _pid_gen can never straddle two incarnations, because the generation is always stamped first. Bumping here rather than in pid_free is deliberate — pid_free also runs on this function's own OOM rollback and on the boot-time bulk reset, where 'a new occupant appeared' is false. (8) Publish pid_table[pid] = slab_addr. (9) Return slab_addr. Register discipline: rbx/r12/r13 preserved via 3-push prologue; rax/rcx scratch across steps 6.5+6.5b+6.6+7+8 (all caller-save, rcx re-loaded before pid_table write). Stack alignment: rsp ≡ 0 mod 16 at every nested call site.",
      block: {
        // ===== prologue: 3-push, capture parent =====
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                          // rbx = parent (u64; 0 sentinel for init)

        // ===== step 2: pid_alloc =====
        call pid_alloc;                        // rax = pid or 0
        cmp rax, 0;
        je task_new_fail_return;
        mov r12, rax;                          // r12 = pid

        // ===== step 3: slab_addr = task_slab_of_pid(pid) =====
        // #1594: was five inline instructions with no bound. The bound now
        // lives with the arithmetic, and a refusal (rax == 0) takes the same
        // rollback the OOM path takes — pid_free then return 0. Reaching it
        // means the pool and the ceiling have diverged, which the build gate
        // is supposed to have caught; if it ever fires at runtime the
        // allocation is refused rather than aimed past the array.
        mov rdi, r12;                          // rdi = pid
        call task_slab_of_pid;                 // rax = slab VA or 0
        cmp rax, 0;
        je task_new_fail_rollback;
        mov r13, rax;                          // r13 = slab_addr

        // ===== step 4: aspace_create_user =====
        call aspace_create_user;               // rax = pml4_pa or 0xFFFFFFFF
        mov rcx, 4294967295;                   // 0xFFFFFFFF (ASPACE_CREATE_OOM)
        cmp rax, rcx;
        je task_new_fail_rollback;

        // ===== step 5: rep stosq — zero 2224 bytes =====
        push rax;                              // stash pml4_pa (rep_stosq clobbers rax)
        mov rdi, r13;                          // dst = slab
        mov rcx, 278;                          // 2224/8 qwords
        xor eax, eax;                          // fill = 0
        rep_stosq;
        pop rcx;                               // rcx = pml4_pa

        // ===== step 6: populate fields =====
        // #658-BOUNDARY: user_pml4_pa is aspace_create_user's return, in
        // phys_alloc-VA form (see phys_alloc.pdx / aspace_create.pdx #658
        // CONTRACT). Field name says "_pa" but stored value is VA. Every
        // real `mov cr3` derived from [r13+16] MUST subtract KERNEL_VMA_BASE
        // at the boundary — see kernel_main.pdx enter_userland_initial call
        // sites (:889 R15 witness, :6052 shell boot) for the pattern.
        mov [r13 + 16], rcx;                   // user_pml4_pa
        mov [r13 + 0], r12d;                   // pid (u32)
        xor eax, eax;                          // default parent_pid = 0
        cmp rbx, 0;                            // NULL parent?
        je task_new_skip_parent_load;
        mov eax, [rbx + 0];                    // parent->pid (u32)
      task_new_skip_parent_load:
        mov [r13 + 4], eax;                    // parent_pid (u32)
        // state @ 8 stays at rep-stosq zero == STATE_NEW

        // ===== step 6.5 (#728 D9): per-task kernel stack top =====
        // kstack_top(pid) = &_task_kernel_stacks + pid * 16384.  Consumed
        // by syscall_entry via [_current_tcb + 24] after the CR3 flip.
        // rcx clobbered; safe (pml4_pa write above is done).  rax stays
        // scratch; the pid_table write below re-loads rcx.
        lea rax, [rip + _task_kernel_stacks];
        mov rcx, r12;                          // rcx = pid
        shl rcx, 14;                           // rcx = pid * 16384
        add rax, rcx;                          // rax = kstack_top for this pid
        mov [r13 + 24], rax;                   // TCB.kstack_top @ +24

        // ===== step 6.5b (#566): sched_budget = SCHED_BUDGET_DEFAULT =====
        // Timer ISR (core/int/exceptions.pdx handle_timer) decrements this
        // u32 every 100 Hz tick; on 0 it sets _preempt_needed and resets to
        // 10, triggering a runqueue rotate in trampoline_vec32.  See design/
        // kernel/r15-m7-566-timer-preempt.md §3.1.  rep-stosq already zeroed
        // this field, but writing the default explicitly makes the initial
        // 100 ms slice contract self-documenting at task_new.  mov_d writes
        // exactly 4 bytes at [r13+112] — the field is u32 and the 4 bytes
        // above it at +116..+119 are reserved padding kept at zero.
        mov rcx, 1000000;                      // SCHED_BUDGET_DEFAULT (u32) — AC-safe
        mov_d [r13 + 112], rcx;                // TCB.sched_budget @ +112

        // ===== step 6.5c (#829): xsave_area_init_for_pid — zero XSTATE_BV =====
        // Per-task XSAVE area at Xsave._task_xsave_areas + pid*4096 is
        // shared across pid_alloc/pid_free cycles.  On task_new after a
        // task_free, the prior task's xsaveopt may have set XSTATE_BV bits;
        // clearing them guarantees the first xrstor into this task loads
        // the *architectural init* values (mxcsr=0x1F80, x87 FCW=0x37F,
        // YMM zero) per SDM Vol 1 §13.6.  On first-ever task_new, .bss
        // zero-init already satisfies this, but calling unconditionally
        // makes the invariant local to task_new rather than distributed
        // across the boot-time zero-fill assumption.  rdi = pid, all other
        // scratch (rax/rcx/rdi post-shift) restored to safe state before
        // step 7.  Callee is no-frame + leaf; ~10 insts including a
        // rep_stosq — fits inside our nested-call rsp %16 == 0 budget.
        mov rdi, r12;                          // rdi = pid
        call xsave_area_init_for_pid;

        // ===== step 6.6 (#1583): stamp this task's incarnation =====
        // The pid slot is about to acquire a new occupant. Bumping HERE —
        // before the step-7 publish — is what makes (pid, generation) a
        // task identity rather than a table index: no task is ever
        // observable through _pid_table at a generation lower than the one
        // stamped for it, so a reader that resolves a pid and then reads
        // its generation cannot straddle two incarnations.
        //
        // Bumping on allocation rather than on pid_free is deliberate. Both
        // change exactly once per occupancy, but pid_free also runs on
        // task_new's own OOM rollback and on the boot-time bulk reset, where
        // "a new occupant appeared" is false. Stamping at the point the
        // occupant appears keeps the counter's meaning exact.
        //
        // rax/rcx are scratch across this call and step 7 re-loads rcx.
        mov rdi, r12;                          // rdi = pid
        call pid_gen_bump;

        // ===== step 7: pid_table[pid] = slab_addr =====
        lea rcx, [rip + _pid_table];
        mov [rcx + r12*8], r13;

        // ===== epilogue: return slab_addr =====
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // ===== OOM rollback: release pid, then return 0 =====
      task_new_fail_rollback:
        mov edi, r12d;                         // rdi = pid
        call pid_free;
        // fall through

      task_new_fail_return:
        xor eax, eax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // R15-M5-008 (#550): task_free — destroy a task_struct with aspace/pid cleanup
  // ==========================================================================
  //
  // R31.M2-1599 (#1599): TASK_FREE IS A DEATH. IT SWEEPS THE OWNER COLUMN.
  //
  // Every real process death reaches cap_owner_sweep_revoke through
  // driver_death_notify (sys_exit_body step 2.6, fault_kill). task_free is
  // the OTHER way a task stops existing — it is what boot_spawn_user_task's
  // bspawn_fail_free_task path runs when a spawn fails after its
  // capabilities were already claimed, and what a kernel-side witness runs
  // to dispose of a synthetic task — and it never touched the column.
  //
  // WHY THAT WAS NOT MERELY UNTIDY. pid_gen_bump happens in task_new, at
  // ALLOCATION, not at death. So after task_free the pid slot is free but
  // _pid_gen[pid] still names the incarnation that just died, and a stale
  // owner key therefore still reads as LIVE through cap_owner_live_key
  // until that exact pid is reused. Composed with #1596's ownership
  // pre-pass — which refuses to seed a slot a live key claims — a spawn
  // that fails for any reason permanently poisons the slots it had already
  // claimed, and the LOADER_SEED_SLOT_TAKEN lands on the NEXT spawn rather
  // than the one that failed. A recoverable, well-reported failure turned
  // into a permanent, misattributed one.
  //
  // WHY THE FIX IS A SWEEP HERE AND NOT A GENERATION BUMP AT DEATH.
  // Bumping _pid_gen in pid_free/task_free would also make the stale key
  // read dead, and it is the wrong fix in three independent ways:
  //
  //   * It would make the leak UNSWEEPABLE rather than swept. The column
  //     would still carry the dead task's key, and cap_owner_sweep_revoke
  //     keyed on (pid, gen) could never match it again — a descriptor left
  //     live, held by nobody, unreachable by any teardown. That trades a
  //     loud refusal for a silent retention, which is the direction
  //     cap_owner_live_key's own header argues against.
  //   * pid_free runs on task_new's OOM rollback and on sys_fork's
  //     fail_rollback, where no occupant ever appeared. Bumping there makes
  //     the counter stop meaning "incarnations of this pid", which is the
  //     property #1583 stamps it at allocation to preserve.
  //   * driver_death_notify reads pid_gen_read(pid) at death and relies on
  //     it still naming the DYING task. Moving the bump to death makes that
  //     read order-dependent across sys_exit and sys_wait4 — a sweep that
  //     runs after the bump matches nothing and reports success, which is
  //     the exact failure #1590 closed.
  //
  // So the generation stays stamped at allocation, and the death path that
  // was missing its sweep gets one.
  //
  // ORDERING. The sweep runs FIRST, before aspace_teardown, mirroring the
  // real death path (driver_death_notify revokes authority before the reap
  // releases memory) and ensuring no per-kind revoke beneath the sweep ever
  // reaches through a descriptor into an address space already torn down.
  // The generation must be read while the incarnation is still live, which
  // it is anywhere before pid_free — but reading it here keeps the whole
  // (read, sweep) pair local rather than split across the teardown.
  //
  // IDEMPOTENCE. A second arrival — a real death that already swept, then
  // this, or two task_frees racing a witness — is clean by construction:
  // cap_owner_sweep_revoke clears the column on every slot it matches
  // (cap_own_rv_unown runs even for a refused per-kind revoke), so the
  // second sweep matches zero slots, revokes nothing and, because its audit
  // record is suppressed at count 0, leaves no trace in the ring either.
  // Nothing here needs a "did I already do this" flag.
  pub let task_free : (u64) -> u64 !{mem, sysreg} @{cap, fs} =
    fn (t: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, fs},
      justification: "R15.M5-008 (#550) + R31.M2-1599 (#1599): task_free real body — extract pid + pml4, sweep the capability owner column for this (pid, generation), aspace_teardown, rep stosq slab-zero (folds fd_table zero), pid_free LAST for R15.M6 reuse-safety. 3-push callee-save prologue (rbx/r12/r13); rsp %16 == 0 at every nested call site, and all three survive cap_owner_sweep_revoke's own five-push prologue. Uses rep stosq at 278 qwords to zero the 2224-byte task_struct slab. rcx MUST be explicitly set before rep stosq (backtrack H5). The #1599 step is the whole point of the widened capability set: task_free is a DEATH, and every other death sweeps. It is reached from boot_spawn_user_task's bspawn_fail_free_task after elf_lite_load has already claimed the image's seeded capabilities for this task, and because pid_gen_bump stamps at ALLOCATION rather than at death, a key left behind by a freed task still reads live through cap_owner_live_key until the pid is reused — so #1596's ownership pre-pass refuses the next spawn that names those slots, attributing the failure to the wrong spawn. The generation is read here rather than passed in because the caller of a teardown primitive should not have to know that ownership has an incarnation axis. Sweeping BEFORE aspace_teardown mirrors driver_death_notify (revoke authority, then release memory) and keeps every per-kind revoke beneath the sweep running against an address space that still exists. Idempotent without a flag: the sweep clears each column it matches, so a second arrival matches zero, revokes nothing and emits no audit record. Capabilities widen from {fs} to {cap, fs}; effects are unchanged because cap_owner_sweep_revoke's {mem, sysreg} is already a subset of this function's.",
      block: {
        push rbx;                            // SysV: entry rsp = 8 mod 16
        push r12;
        push r13;                            // 3 pushes → rsp = 0 mod 16 (aligned for nested calls)

        mov rbx, rdi;                        // rbx = task base (preserved across teardown)
        mov r12d, [rbx + 0];                 // r12 = pid (u32 zero-ext) — TASK_OFF_PID
        mov r13, [rbx + 16];                 // r13 = user_pml4_pa — TASK_OFF_USER_PML4

        // step 2.5 (#1599): cap_owner_sweep_revoke(pid, pid_gen_read(pid)).
        // Unconditional: cap_owner_pack refuses pid 0, pid >= MAX_PIDS and a
        // zero generation, so the sweep returns 0 before reading a slot for
        // every case where there is nothing to sweep. Gating it here would
        // duplicate that decision in a second place with no new information.
        // The count is discarded — task_free's return value is a teardown
        // outcome, and folding a capability count into it would give 0 two
        // meanings.
        mov edi, r12d;                       // rdi = pid
        call pid_gen_read;                   // rax = generation (0 if none)
        mov rsi, rax;                        // rsi = generation
        mov edi, r12d;                       // rdi = pid
        call cap_owner_sweep_revoke;         // count discarded

        // step 3: aspace_teardown(pml4) — releases PML4 + all leaves + PTs
        mov rdi, r13;
        call aspace_teardown;                // returns 0 at R15.M5; discard rax

        // step 4: rep stosq — zero 2224-byte slab (folds fd_table[0..32] zero as side effect)
        mov rdi, rbx;                        // dst = task base
        mov rcx, 278;                        // 2224 / 8 qwords — MUST be set explicitly
        xor rax, rax;                        // fill value
        rep_stosq;                           // F3 48 AB

        // step 5: pid_free(pid) LAST — slab must be fully zero before pid becomes reusable
        mov edi, r12d;
        call pid_free;

        xor rax, rax;                        // return 0
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
