// src/kernel/core/sched/wake_block.pdx — Phase 4 → R15-M7-006
// Thread Wake and Block Operations
// Issue: #105 → #567 (R15-M7-006)
//
// R15-M7-006 (#567): Rewrite — replace R4 stubs with real sched_block() and sched_wake(t)
// state-transition primitives. sched_block is a self-suspend (current task → WAITING,
// dequeue, pick next, switch away). sched_wake is a wake-without-switch (target task
// WAITING → RUNNABLE, enqueue). No reason field at R15.M7 (deferred to R15.M8).

module WakeBlock = structure {
  // ============================================================================
  // Wake/Block Status Codes (kept for R15.M8 compatibility)
  // ============================================================================

  let WAKE_OK : u64 = 0
  let WAKE_FAIL : u64 = 4294967295
  let BLOCK_OK : u64 = 0
  let BLOCK_FAIL : u64 = 4294967295

  // ============================================================================
  // Block Timeout Values (kept for R15.M8 compatibility)
  // ============================================================================

  // Special timeout: block forever (no timeout)
  let BLOCK_TIMEOUT_INFINITE : u64 = 18446744073709551615  // -1 as i64

  // Special timeout: return immediately if not ready
  let BLOCK_TIMEOUT_ZERO : u64 = 0

  // ============================================================================
  // R15-M7-006 (#567): sched_block() — self-suspend of the current task
  // ============================================================================

  pub let sched_block : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R15-M7-006 (#567): self-suspend of the current task. Sequence: (1) load _current_tcb into rax. (1.5) Guard: check _current_tcb.state == STATE_RUNNABLE via cmp+je-past-call+kassert_fail (M6-002 #697 — actual state passed as arg5 to the panic dump; halts via klog_panic on violation). (2) write STATE_WAITING=2 into rax.state (u32 at +8). (3) runq_dequeue(rax) — remove current from the runqueue so sched_pick_next_r15 will skip it. (4) sched_pick_next_r15() — returns rax = next TCB (or _idle_tcb if runqueue empty). (5) sched_switch_r15(next) — switch away; control returns here when some other task calls sched_wake on this task. Register discipline: rax scratch (holds current TCB then next TCB), rcx scratch (state constant), rdi scratch (arg to runq_dequeue and sched_switch_r15). All caller-save. Nested calls preserve rbx/rbp/r12-r15 per their own justifications (runq_dequeue §6 of #563, sched_pick_next_r15 §7 of #562, sched_switch_r15 §5 of #564). No cli/sti here — the atomicity boundary is inside sched_switch_r15's cli/popfq window (§5.4 of #564); the state-write + dequeue happen with interrupts on. At R15.M7 this is safe because no timer preemption exists yet (#565 blocked on #662); the preemption-safety fix is a narrow cli around steps (2)-(4) — deferred to #565's landing (§7.2 of #567 design doc). Not a leaf — three nested calls. Standard call-clobbered prologue; no callee-save spills needed because sched_block itself uses no callee-save registers. #663 guard: kassert_fail if not RUNNABLE (M6-002 #697) — prevents resurrection of ZOMBIE or dequeuing of off-runq task.",
      block: {
        // (1) rax = current TCB
        mov rax, [rip + _current_tcb];

        // (1.5) Guard: precondition check — must be RUNNABLE
        mov ecx, [rax + 8];
        cmp ecx, 1;                     // STATE_RUNNABLE?
        je sched_block_pass_46;
        mov r8, rcx;                    // actual = state value
        lea rdi, [rip + SUBSYS_SCHD];
        mov rsi, FILE_ID_core_sched_wake_block; // #1605: symbolic, drift-proof
        mov rdx, 46;
        mov rcx, 1;                     // expected: STATE_RUNNABLE
        call kassert_fail;
      sched_block_pass_46:

        // (2) rax.state = STATE_WAITING (u32 = 2)
        mov ecx, 2;
        mov [rax + 8], ecx;

        // (3) runq_dequeue(current) — rdi is the arg
        mov rdi, rax;
        call runq_dequeue;

        // (4) next = sched_pick_next_r15() — returns rax
        call sched_pick_next_r15;

        // (5) sched_switch_r15(next) — rdi is the arg
        mov rdi, rax;
        call sched_switch_r15;

        // Resumed. Some other task called sched_wake on us; we are now
        // _current_tcb again and control returns to sched_block's caller.
        ret
      }
    }

  // ============================================================================
  // R15-M7-006 (#567): sched_wake(t) — mark target task RUNNABLE and enqueue
  // ============================================================================

  pub let sched_wake : (u64) -> () !{mem, sysreg} @{sched, boot} =
    fn (target: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched, boot },
      justification: "R15-M7-006 (#567) + R69.M1-002 (#1883): mark target task RUNNABLE and enqueue it — cross-CPU-affine when target's cpu_mask names a different CPU. Sequence: (0.5) Non-null-target guard: kassert_fail if rdi==0 (M6-002 #697 — sched_wake(NULL) is always a caller bug), unchanged. (1) Guard: if target.state==RUNNABLE, early-exit (idempotent, unchanged, #663). (2) target.state=RUNNABLE (u32 @+8), unchanged. (3) #1883 affinity dispatch: 3-push callee-save prologue (rbx=target, r12=N once found, r13=this_cpu once read) — all three must outlive the nested calls in the cross-CPU branch, which per SysV are only guaranteed to preserve rbx/rbp/r12-r15, not a caller-save scratch register. Entry rsp%16==8; 3 pushes (odd) land at rsp%16==0, exactly what every nested call below requires — no sub/add pad needed (unlike a prologue with an even push count). Load rcx = target.cpu_mask (@+128). cpu_mask==0 (wildcard, the default for every task that never called sys_sched_setaffinity) -> local path (runq_enqueue(target), unchanged pre-#1883 behavior). Else: manual 4-iteration bit scan finds the lowest set bit N (r12=candidate, r10=1<<candidate test mask — r10 is caller-save but safe here because no nested call happens inside the scan loop) — mirrors apic/vector_pool.pdx's manual-scan idiom rather than assuming a bsf encoder form for this narrow 4-CPU-wide mask; falls back to local if no bit is found (defensive/unreachable, since the cpu_mask==0 gate above already routed the true-wildcard case away). rdmsr IA32_GS_BASE -> rax=this CPU's CB VA; r13d=[rax+0]=this_cpu (u32 zero-ext) — stored in the callee-save r13 specifically because it must still be valid several calls later, at the fingerprint emit. cmp r12,r13: target cpu IS this CPU -> local path (same-CPU affinity is not 'cross-CPU', so it enqueues locally exactly like the wildcard case). Else (genuine cross-CPU): call runq_enqueue_remote(N=r12, target=rbx) to link target onto CPU N's own runqueue (NOT this CPU's) — this is the behavioral change from pre-#1883, where every wake unconditionally enqueued onto the WAKING cpu's runqueue regardless of the target's declared affinity. Then call percpu_cb_for(N) -> rax=target CB VA; edi=[rax+4]=target's apic_id (u32 zero-ext, populated by percpu_init at that CPU's bring-up); call lapic_send_reschedule_ipi(apic_id) — reuses the R18-M4-002 (#772) vector-0xF1 IPI substrate verbatim (no new vector minted; see reschedule_ipi.pdx). Then call sched_wake_emit_cross_cpu(from_cpu=r13, to_cpu=r12, pid=[rbx+0]) — the R69.M1-002 `sched cross-cpu wake ok` fingerprint. r12/r13/rbx all still valid at this point because every intervening call preserves the SysV callee-save set. Effects widened mem->mem+sysreg (the inline rdmsr; done inline rather than via a nested gs_base_read_cpu_idx call to avoid another push/call for a 3-instruction sequence already proven at this exact shape in sched_pick_next_r15's prelude); capabilities widened sched->sched+boot (lapic_send_reschedule_ipi requires @{boot}; percpu_cb_for and runq_enqueue_remote require @{sched}/@{} so they add nothing new). IRQ-safe: no cli, no unbounded loop; the manual bit-scan is bounded at 4 iterations. #663 guard (already-RUNNABLE early exit) unchanged and still precedes all of this.",
      block: {
        // Precondition: rdi (target TCB) must be non-null
        cmp rdi, 0;
        jne sched_wake_pass_88;
        mov r8, rdi;                    // actual = 0 (rdi is null)
        lea rdi, [rip + SUBSYS_SCHD];
        mov rsi, FILE_ID_core_sched_wake_block; // #1605: symbolic, drift-proof
        mov rdx, 88;
        mov rcx, 1;                     // expected: nonzero
        call kassert_fail;
      sched_wake_pass_88:
        // Guard: if target.state == RUNNABLE, exit early (idempotent)
        mov ecx, [rdi + 8];        // ecx = target.state (u32 at +8)
        cmp ecx, 1;                // STATE_RUNNABLE?
        je sched_wake_noop;

        // (2) target.state = STATE_RUNNABLE (u32 = 1)
        mov ecx, 1;
        mov [rdi + 8], ecx;

        // ---- R69.M1-002 (#1883): affinity-aware dispatch ----
        // 3-push callee-save prologue (rbx=target, r12=N, r13=this_cpu) —
        // all three must outlive the nested calls below (runq_enqueue_
        // remote / percpu_cb_for / lapic_send_reschedule_ipi / sched_
        // wake_emit_cross_cpu are only guaranteed to preserve the SysV
        // callee-save set rbx/rbp/r12-r15 — a caller-save scratch reg
        // like r10 would NOT survive them). Entry rsp%16==8; 3 pushes
        // (odd count) land exactly at rsp%16==0, the state every nested
        // call below requires — no extra sub/add pad needed.
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                    // rbx = target (survives every nested call below)

        mov rcx, [rbx + 128];             // rcx = target.cpu_mask (TCB_OFF_CPU_MASK)
        cmp rcx, 0;
        je  sched_wake_local;             // wildcard -> local enqueue (pre-#1883 behavior)

        // Find lowest set bit N in [0,4) — manual scan, no bsf dependency.
        // r10 (caller-save) is fine here: no nested call happens inside
        // this loop, so nothing can clobber it between iterations.
        xor r12, r12;                     // r12 = candidate N
        mov r10, 1;                       // r10 = 1 << N (test mask)
      sched_wake_findbit:
        mov rax, rcx;
        and rax, r10;
        cmp rax, 0;
        jne sched_wake_findbit_done;
        shl r10, 1;
        add r12, 1;
        cmp r12, 4;
        jae sched_wake_local;             // no bit found (unreachable given gate above)
        jmp sched_wake_findbit;
      sched_wake_findbit_done:
        // r12 = N (target's declared cpu_idx)

        // this_cpu = CB[+0] via rdmsr IA32_GS_BASE. Stored in r13
        // (callee-save) because it must survive the nested calls below.
        mov rcx, 0xC0000101;
        rdmsr;
        shl rdx, 32;
        or  rax, rdx;
        mov r13d, [rax + 0];               // r13 = this_cpu (u32 zero-ext)

        cmp r12, r13;
        je  sched_wake_local;              // target names THIS cpu -> local enqueue

        // ---- Cross-CPU path ----
        mov rdi, r12;                      // cpu_idx = N
        mov rsi, rbx;                      // task = target
        call runq_enqueue_remote;

        mov rdi, r12;                      // percpu_cb_for(N)
        call percpu_cb_for;                 // rax = target CB VA
        mov edi, [rax + 4];                  // rdi = target apic_id (u32 zero-ext)
        call lapic_send_reschedule_ipi;

        // Fingerprint: sched cross-cpu wake ok -- from=<this_cpu> to=<N> pid=<pid>
        // sched_wake_emit_cross_cpu(from_cpu, to_cpu, pid) via SysV
        // rdi/rsi/rdx.
        mov edx, [rbx + 0];                  // rdx = target.pid (u32 zero-ext, TASK_OFF_PID)
        mov rsi, r12;                        // rsi = to_cpu = N
        mov rdi, r13;                        // rdi = from_cpu = this_cpu
        call sched_wake_emit_cross_cpu;

        pop r13;
        pop r12;
        pop rbx;
        ret;

      sched_wake_local:
        mov rdi, rbx;
        call runq_enqueue;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sched_wake_noop:
        ret
      }
    }

  // ============================================================================
  // R69.M1-002 (#1883): sched_wake_emit_cross_cpu(from, to, pid) — fingerprint
  // ============================================================================
  //
  // Split out of sched_wake's cross-CPU branch as its own tiny function so
  // the klog_s1_d3 6-param-ABI stack-argument marshalling (v2/k3/v3 pushed
  // by the CALLER per that wrapper's documented convention) doesn't have
  // to interleave with sched_wake's own already-dense register plan
  // (rbx=target, r12=N live across the whole cross-CPU branch). Called
  // ONLY from sched_wake's cross-CPU path, immediately after the IPI send.
  pub let sched_wake_emit_cross_cpu : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (from_cpu: u64) (to_cpu: u64) (pid: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R69.M1-002 (#1883): emit `sched cross-cpu wake ok -- from=<N> to=<M> pid=<P>` via klog_s1_d3(LEVEL_INFO=3, SUBSYS_SCHD, tag_sched_cross_cpu_wake_ok, k_from, from_cpu, k_to, [stack]=to_cpu, k_pid, [stack]=pid). Entry (SysV): rdi=from_cpu, rsi=to_cpu, rdx=pid, entry rsp%16==8 (no callee-save prologue — this function is a leaf wrapper with no frame). r8=rdi captures from_cpu FIRST, before rdi is repurposed for the level constant. Then 3 plain pushes stage the stack args per klog_s1_d3's contract, in the same v3/k3/v2 order as every other d3/x3 call site in this tree: push rdx (v3=pid), push &k_pid (k3), push rsi (v2=to_cpu) — after these 3 pushes the stack reads, from klog_s1_d3's post-return-address view, [rsp+8]=v2=to_cpu, [rsp+16]=k3=k_pid, [rsp+24]=v3=pid, exactly its documented contract. Unlike klog_s1_x3's call sites elsewhere (e.g. drivers/nvme/identify_ns.pdx), which pad with an extra `sub rsp,8` before their 3 pushes, THIS call site omits that pad: those call sites reach their x3/d3 call site already at rsp%16==0 (typically after an odd-count callee-save prologue), so the 3-push (odd) sequence would flip them to 8 mod16 without the compensating sub. This function instead enters at rsp%16==8 (no prologue at all), and a bare 3-push (odd count) sequence flips 8 -> 0 -> 8 -> 0, landing at exactly the 0-mod-16 state `call` requires — no pad needed, and adding one here would MISALIGN rather than fix it. Register args set after staging: rdi=3 (LEVEL_INFO, inlined per the cross-module-let-does-not-resolve-at-parse-time discipline), rsi=&SUBSYS_SCHD, rdx=&tag_sched_cross_cpu_wake_ok, rcx=&k_from, r9=&k_to (r8 already holds from_cpu from the top of the function). Cleanup: `add rsp, 24` pops the 3 staged args, restoring rsp to this function's own entry value (rsp%16==8) for its own `ret` — matches the SysV invariant a caller expects unwound. Leaf from the caller's perspective (one nested call).",
      block: {
        // Entry: rdi=from_cpu, rsi=to_cpu, rdx=pid (SysV args, entry rsp%16==8).
        mov r8, rdi;                            // r8 = v1 = from_cpu (capture before rdi is reused)

        push rdx;                               // v3 = pid;     rsp%16: 8 -> 0
        lea rax, [rip + k_pid];
        push rax;                               // k3 = k_pid;   rsp%16: 0 -> 8
        push rsi;                               // v2 = to_cpu;  rsp%16: 8 -> 0 (correct pre-call state)

        mov rdi, 3;                             // level = LEVEL_INFO
        lea rsi, [rip + SUBSYS_SCHD];
        lea rdx, [rip + tag_sched_cross_cpu_wake_ok];
        lea rcx, [rip + k_from];
        lea r9, [rip + k_to];
        call klog_s1_d3;

        add rsp, 24;                             // pop v3/k3/v2 (3 x 8) -> back to rsp%16==8
        ret
      }
    }
}
