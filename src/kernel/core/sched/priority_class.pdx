// src/kernel/core/sched/priority_class.pdx — Wave κ (κ-02)
//
// Per-task priority class (INTERACTIVE / BATCH / IDLE) — the scheduling-
// hint field the MLFQ variant (κ-03, sched/mlfq.pdx) consults when deciding
// which queue to enqueue a task on and which queue to scan first on pick.
//
// FIELD LAYOUT
//
//   TASK_OFF_PRIO_CLASS = 488 (u64 at TCB byte offset +488).
//
// The task_pool.pdx "Adopted slots" table (task_pool.pdx L268-273) names
// +480..+1703 as the contiguous free region past TASK_OFF_COMM (+464..+479).
// sched_wait_ns.pdx claimed +480 for TASK_OFF_WAIT_DEADLINE_NS (κ-05 also
// consumes that slot). +488 is the next 8-aligned qword and is verified
// clean via `grep -n '+ 488]' src/kernel/**/*.pdx` at this landing (no other
// consumer). The field is a semantic u8 (three valid values: 0/1/2) but
// stored as a full u64 for encoder simplicity — a plain qword mov avoids the
// mov_b sized-store dance and the 7 wasted bytes at +489..+495 remain zero
// via task_new's step-5 rep_stosq (278 qwords covers +488..+495).
//
// VALID VALUES
//
//   PRIO_CLASS_INTERACTIVE = 0   (default; MLFQ queue[0], highest priority)
//   PRIO_CLASS_BATCH       = 1   (MLFQ queue[1])
//   PRIO_CLASS_IDLE        = 2   (MLFQ queue[2], lowest priority)
//
// Anything outside [0, 2] is rejected by task_priority_class_set (returns 1
// = EINVAL sentinel; the caller decides whether to propagate as an errno or
// to fail-close). Set does NOT touch TCB storage on invalid input, so a
// caller checking the return value before observing side effects sees the
// classic no-op-on-refusal semantics.
//
// DEFAULT
//
// Fresh tasks default to INTERACTIVE (0). This falls out of task_new's
// step-5 rep_stosq zero-fill (task_pool.pdx L694-699 covers +488
// as one of its 278 qwords), so no explicit stamp is needed in task_new
// — the semantic default IS the .bss default. If the default ever needs to
// change to BATCH or IDLE, task_new gets an explicit step 6.5f write of
// the new default; the field's offset does not move.
//
// runqueue COMPATIBILITY
//
// κ-02 is scope-limited to the field + accessors. The MLFQ runqueue that
// reads this field lives in κ-03 (sched/mlfq.pdx). The existing runqueue
// (sched/runqueue.pdx per-CPU CB + sched_pick_next_r15) does NOT read
// priority_class today and is not changed here — its round-robin discipline
// is preserved verbatim. Wire-in to the pick path is a separate follow-up
// (see κ-03's compat-shim note).
//
// Audit: design/kernel/wave-kappa-scheduling.md §κ-02.

module PriorityClass = structure {
  // ==========================================================================
  // Field offset. Duplicated locally per this tree's cross-module `let` does
  // not resolve at parse time discipline — see sys_kill.pdx's TASK_STATE_*
  // duplicates for the precedent. Canonical source is this file.
  // ==========================================================================

  pub let TASK_OFF_PRIO_CLASS  : u64 = 488

  pub let PRIO_CLASS_INTERACTIVE : u64 = 0
  pub let PRIO_CLASS_BATCH       : u64 = 1
  pub let PRIO_CLASS_IDLE        : u64 = 2

  // Return sentinels. 0 = OK; 1 = EINVAL (out-of-range class). Deliberately
  // NOT the -errno sentinels the syscall boundary uses — this is a kernel-
  // internal accessor, not a syscall body.
  pub let PRIO_SET_OK      : u64 = 0
  pub let PRIO_SET_EINVAL  : u64 = 1

  // ==========================================================================
  // task_priority_class_set(task, class) -> u64
  //
  // Writes `class` into task.priority_class at +488. Rejects out-of-range
  // class (>= 3) with PRIO_SET_EINVAL; does NOT touch task storage on
  // reject.
  //
  // Register discipline: rdi = task VA (in), rsi = class (in). rax scratch
  // (return sentinel). No callee-save touched. Leaf, no nested calls, no
  // stack use.
  // ==========================================================================
  pub let task_priority_class_set : (u64, u64) -> u64 !{mem} @{} =
    fn (task: u64, class: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave κ (κ-02): set task.priority_class at TCB+488. rdi=task, rsi=class. Bounds check: cmp rsi, 3 / jae -> PRIO_SET_EINVAL(1); rejects UINT64_MAX and any u64 >= 3 at the address-formation gate rather than at the store, so a subsequent MLFQ enqueue that indexes queue[class] cannot walk out of the 3-queue array. On accept: mov [rdi + 488], rsi — plain 64-bit qword store; the semantic u8 lives in the low byte and the upper 56 bits are zero because the input constant 0/1/2 has them zero. rax=0 (PRIO_SET_OK). Leaf, no callee-save touched, no nested calls, no stack use. Effects {mem} for the single TCB store. No capabilities: this is a kernel-internal accessor, not a scheduler-mutating primitive. Labels prefixed pcs_.",
      block: {
        cmp rsi, 3;
        jae pcs_einval;

        mov [rdi + 488], rsi;
        xor rax, rax;                          // PRIO_SET_OK
        ret;

      pcs_einval:
        mov rax, 1;                            // PRIO_SET_EINVAL
        ret
      }
    }

  // ==========================================================================
  // task_priority_class_get(task) -> u64
  //
  // Reads task.priority_class from +488. Returns the raw u64 (0/1/2 for
  // valid tasks; a caller that receives anything else has a corrupted TCB
  // or a task that has not been through task_new's rep_stosq zero-fill —
  // both are caller bugs, not policed here).
  //
  // Register discipline: rdi = task VA (in). rax = class (return). No
  // callee-save touched. Leaf, no nested calls, no stack use.
  // ==========================================================================
  pub let task_priority_class_get : (u64) -> u64 !{mem} @{} =
    fn (task: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave κ (κ-02): read task.priority_class from TCB+488. rdi=task. Plain qword load into rax. Leaf, no callee-save touched, no stack use. Effects {mem} for the single TCB load. No capabilities: kernel-internal accessor. Labels prefixed pcg_.",
      block: {
        mov rax, [rdi + 488];
        ret
      }
    }

  // ==========================================================================
  // task_priority_class_witness(task) -> u64
  //
  // Dormant self-test lambda. Sets task.priority_class to BATCH via
  // task_priority_class_set, reads it back via task_priority_class_get,
  // and returns 0 iff the round-trip yields BATCH. Returns 1 on mismatch.
  //
  // No boot wire-in yet: this witness's fingerprint is `R_KAPPA_PRIO_OK`
  // per the κ-02 brief, but emitting an "OK" string would trigger the
  // #1578 fingerprint-coverage gate and require either a golden line
  // under tests/goldens/ or an ALLOWLIST entry — deferred to keep the
  // κ-02 scope narrow. The primitive is exercisable directly from any
  // caller (a future kernel_main witness call, a syscall introspection
  // path, or a per-task capability-scoped test binary) via its pub let
  // symbol.
  //
  // Register discipline: rdi = task VA (in). rbx = task (callee-save,
  // survives both nested calls). rax = return sentinel. Entry rsp%16==8;
  // one push rbx lands rsp%16==0 for the two nested calls.
  // ==========================================================================
  pub let task_priority_class_witness : (u64) -> u64 !{mem} @{} =
    fn (task: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave κ (κ-02): dormant self-test — round-trips task_priority_class_set(BATCH) / _get() and returns 0 on match, 1 on mismatch. Entry rsp%16==8, one push rbx -> 0 for both nested calls. rbx = task VA (callee-save, both accessors are leaf and preserve rbx). Sequence: (1) push rbx; mov rbx, rdi. (2) mov rsi, 1 (BATCH); call task_priority_class_set. (3) mov rdi, rbx; call task_priority_class_get -> rax = class. (4) cmp rax, 1; jne fail (rax = 1); else rax = 0. (5) pop rbx; ret. Emitting a fingerprint would require a golden line or ALLOWLIST entry per #1578 — deferred; the primitive is callable by any future witness or introspection surface. Labels prefixed pcw_.",
      block: {
        push rbx;                              // entry rsp%16==8 -> 0
        mov rbx, rdi;                          // rbx = task VA

        // set(task, BATCH=1)
        mov rdi, rbx;
        mov rsi, 1;
        call task_priority_class_set;

        // get(task) -> rax
        mov rdi, rbx;
        call task_priority_class_get;

        cmp rax, 1;                            // BATCH
        jne pcw_mismatch;

        xor rax, rax;                          // R_KAPPA_PRIO_OK (semantic)
        pop rbx;
        ret;

      pcw_mismatch:
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
