// src/kernel/core/sched/runqueue.pdx — Phase 6 / R9-m3-001, Phase 7 / R10-m4-001
//                                       R18-M4-003 / #773 (per-CPU runqueue)
// Runqueue: global array of 2 TCBs for R9-narrow cooperative scheduler
// Issue: R9-m3-001 (#360), R10-m4-001 (#380), R18-M4-003 (#773)
//
// Per .plans §R9-m3 and softarch §"R9-narrow recommendation":
//   Declare a 2-TCB runqueue in .bss (global mutable array).
//   R9-narrow MVP: no actual runqueue manipulation — just audit notes
//   deferring full runqueue logic to R10.
//
// R10-m4-001: Initialize the 2-task runqueue with TCBs and kernel stacks.
//   Task A and Task B each get: a 184-byte TCB + 8 KiB kernel stack.
//   sched_init_runqueue_r10: setup function that initializes both TCBs and
//   stacks, setting RSP to stack top and initial entry points for task entry.
//
// HONEST SCOPE (paideia-as 0.11.0): The TCB struct and memory layout are
// defined in sched/tcb.pdx. Here we reserve space in .bss for 2 TCB slots.
// The R9-narrow MVP treats this as a stub: the array is declared but not
// populated or manipulated. Full queue insertion/removal/pick-next logic
// is deferred to R10 (Phase 7).
// Audit entry: design/audit/entries/r9-m3-001.md notes explicit deferral.
// R10-m4-001: Added raw TCB slots and stacks; init function deferred until
// sched_init_runqueue_r10 can be wired into kernel_main (m5).
//
// R18-M4-003 (#773): retire the BSP-only single-global sentinel
// (`_runq_head_slot`) in favor of a per-CPU head/tail pointer pair
// stored inside each CPU's Percpu control block at fixed offsets
// PERCPU_OFF_RUNQUEUE_HEAD (+32) and PERCPU_OFF_RUNQUEUE_TAIL (+40).
// Empty runqueue: head == tail == 0.  Doubly-linked list threaded
// through TCB.runq_next (+432) and TCB.runq_prev (+440).  The
// primitives below reach their own CPU's head/tail via the GS-base
// indirection idiom (rdmsr IA32_GS_BASE → deref) — matches the
// reschedule-IPI handler pattern landed in #772
// (core/ipi/vectors.pdx L82-96).  Once paideia-as gains the
// [gs:disp32]-only encoding (PA-R14-001), the rdmsr triplet collapses
// to a single `mov [gs:32], rdi` at each site.  APIs (runq_init,
// runq_enqueue, runq_dequeue, sched_pick_next_r15) preserve their
// signatures — only the sentinel algorithm is retired.

module Runqueue = structure {
  // TCB size: defined in tcb.pdx. Real size is 184 bytes.
  let TCB_SIZE : u64 = 184

  // Kernel stack size per task: 8 KiB.
  let KERNEL_STACK_SIZE : u64 = 8192

  // Global runqueue: 2-slot array of TCBs.
  // Layout: .bss section, aligned to 64-byte cache line.
  pub let mut runqueue : [u64; 2] = [0; 2]

  // ============================================================================
  // R15-M7-002 (#563) + R18-M4-003 (#773): Real runqueue — per-CPU doubly-
  // linked list.  Head/tail pointer pair lives in each CPU's Percpu control
  // block at PERCPU_OFF_RUNQUEUE_HEAD (+32) / PERCPU_OFF_RUNQUEUE_TAIL (+40).
  // Empty state: head == tail == 0.  Runqueue.pdx no longer owns any global
  // sentinel storage — the sentinel-node algorithm from #563 is retired.
  // ============================================================================

  // Witness task storage (5 dedicated 448-byte bss blobs).
  // These are witness-only — never touched by production code.  Their layout
  // matches a task_struct slab (56 u64s = 448 bytes) so that runq_enqueue's
  // writes to task.runq_next (+432) and task.runq_prev (+440) land in-slab.
  // Dedicated stubs keep the runqueue witness self-contained (no pollution
  // of real _task_pool[i] slots).
  pub let mut _runq_witness_task_1 : [u64; 56] = uninit @align(8)
  pub let mut _runq_witness_task_2 : [u64; 56] = uninit @align(8)
  pub let mut _runq_witness_task_3 : [u64; 56] = uninit @align(8)
  pub let mut _runq_witness_task_4 : [u64; 56] = uninit @align(8)
  pub let mut _runq_witness_task_5 : [u64; 56] = uninit @align(8)

  // R15-M7-006 (#567): sched_block/sched_wake witness — single fake TCB.
  // Only three fields are referenced by the witness:
  //   +8    state         (u32)
  //   +432  runq_next     (u64)
  //   +440  runq_prev     (u64)
  // 448 bytes (56 u64s) matches the runq witness slabs (§8.1 of #563) —
  // minimal size that keeps +440 in-slab. Placed here (not in tasks.pdx)
  // for symbol locality with the runqueue primitives and other sched
  // witness slabs.
  pub let mut _block_witness_task_x : [u64; 56] = uninit @align(8)

  // Runqueue length (number of valid TCBs).
  // R9-narrow: not used; deferred to R10.
  pub let mut runqueue_len : u64 = 0

  // Current runqueue index (for round-robin). Deferred to R10.
  pub let mut runqueue_current : u64 = 0

  // Current running TCB base address (R10 m3-001).
  // Shared global used by sched_switch_regs and sched_yield to track
  // which TCB is currently executing. Updated by sched_switch when
  // transitioning to a new TCB.
  pub let mut _current_tcb : u64 = 0

  // R11-m2-001: Preemption flag, set by handle_timer when current TCB budget
  // reaches 0. Checked by Task bodies to trigger cooperative yield.
  pub let mut _preempt_needed : u64 = 0

  // ============================================================================
  // R10-m4-001: Task A and Task B raw storage (184-byte TCBs + 8 KiB stacks each)
  // ============================================================================

  // Task A TCB: 184 bytes, uninitialized. Will be populated by sched_init_runqueue_r10.
  pub let mut _task_a_tcb : [u64; 23] = uninit  // 23 * 8 = 184 bytes

  // Task A kernel stack: 8 KiB = 1024 u64s
  pub let mut _task_a_stack : [u64; 1024] = uninit

  // Task B TCB: 184 bytes, uninitialized.
  pub let mut _task_b_tcb : [u64; 23] = uninit

  // Task B kernel stack: 8 KiB = 1024 u64s
  pub let mut _task_b_stack : [u64; 1024] = uninit

  // ============================================================================
  // sched_init_runqueue_r10 — Initialize both TCBs with stacks and entry points
  // ============================================================================

  // R10-m4-001: Initialize Task A and Task B TCBs.
  // Bootstrap: Task A is entered via direct call (kernel_main calls task_a_entry).
  //            Task B is entered via sched_switch_regs ret (when task_a yields).
  // Stack layout:
  //   Task A: RSP = &stack[1023] (top), call pushes return address to &stack[1022]
  //   Task B: RSP = &stack[1023], but stack[1023] must contain task_b_entry for
  //           sched_switch_regs ret to jump to it.
  // R11-m2-002: Initialize budget for each TCB to TCB_BUDGET_R11 (8 cycles).
  pub let sched_init_runqueue_r10 : () -> () !{mem} @{sched} = fn() -> unsafe {
    effects: { mem },
    capabilities: { sched },
    justification: "R10 m4-001 + R11 m2-002 + R11 m4-001: Initialize 2-TCB runqueue. Task A: direct call from kernel_main. Task B: sched_switch_regs ret from task_a. Set RSP at offset 120. R11 m2-002: Set budget (u32 at offset 172) to TCB_BUDGET_R11=8 for both tasks. R11 m4-001: Enqueue both tasks into PickNext.level_heads[0] for preemption picking.",
    block: {
      // Initialize Task A: RSP points to top of stack for direct call
      lea rax, [rip + _task_a_stack]
      add rax, 8184;           // rax = address of stack[1023] (1023 * 8 bytes)
      lea rdi, [rip + _task_a_tcb]
      mov [rdi + 120], rax;    // TCB.regs[15] (RSP) at offset 120 = &stack[1023]
      // R11-m2-002: Set initial budget to TCB_BUDGET_R11 = 8
      mov ecx, 8
      mov [rdi + 172], ecx     // TCB.budget (u32) at offset 172 = 8

      // Initialize Task B: put entry address on stack and set RSP to it
      // When sched_switch_regs restores and does ret, it will pop task_b_entry
      // and jump to it.
      lea rax, [rip + _task_b_stack]
      add rax, 8184;           // rax = address of stack[1023]
      lea rcx, [rip + task_b_entry]
      mov [rax], rcx;          // stack[1023] = task_b_entry

      lea rdi, [rip + _task_b_tcb]
      mov [rdi + 120], rax;    // TCB.regs[15] (RSP) at offset 120 = &stack[1023]
      // R11-m3-001: Set initial RIP to task_b_entry_r11 (for preemption)
      lea rcx, [rip + task_b_entry_r11]
      mov [rdi + 128], rcx;    // TCB.RIP (offset 128) = task_b_entry_r11
      // R11-m2-002: Set initial budget to TCB_BUDGET_R11 = 8
      mov ecx, 8
      mov [rdi + 172], ecx     // TCB.budget (u32) at offset 172 = 8

      // R11-m4-001: Enqueue both tasks into PickNext.level_heads for round-robin preemption.
      // Put Task A at priority level 0, Task B at priority level 1.
      // sched_pick_next_r11 will find the other task (alternating).
      lea rsi, [rip + level_heads]

      // level_heads[0] = &_task_a_tcb
      lea rax, [rip + _task_a_tcb]
      mov [rsi + 0], rax;

      // level_heads[1] = &_task_b_tcb
      lea rax, [rip + _task_b_tcb]
      mov [rsi + 8], rax;       // offset 8 = next array element (8 bytes)

      ret
    }
  }

  // ============================================================================
  // runq_init() — reset current CPU's runqueue to empty
  // ============================================================================
  //
  // R18-M4-003 (#773): rewritten from single-global sentinel bootstrap to a
  // per-CPU head/tail zero.  Reads the current CPU's Percpu control block VA
  // via rdmsr IA32_GS_BASE (0xC0000101) and zeros PERCPU_OFF_RUNQUEUE_HEAD
  // (+32) and PERCPU_OFF_RUNQUEUE_TAIL (+40).  Empty runqueue invariant:
  // head == tail == 0.
  //
  // Precondition: gs_base_init_bsp (BSP) or gs_base_init_ap (AP) has
  // programmed IA32_GS_BASE to point at this CPU's Percpu CB.  On BSP this
  // must run before any other runq_* call; the early gs_base_init_bsp call
  // at the top of boot_continue_after_ring3 (kernel_main.pdx) ensures the
  // ordering.
  //
  // Idempotent: repeated calls just re-zero head/tail (orphaning any
  // dangling linked tasks — same semantics as the pre-#773 sentinel reset).
  // ============================================================================

  pub let runq_init : () -> () !{mem, sysreg} @{boot} = fn () -> unsafe {
    effects: { mem, sysreg },
    capabilities: { boot },
    justification: "R18-M4-003 (#773): reset current CPU's runqueue to empty by zeroing PERCPU_OFF_RUNQUEUE_HEAD (+32) and PERCPU_OFF_RUNQUEUE_TAIL (+40) in this CPU's Percpu CB.  Reads GS_BASE MSR (0xC0000101) via rdmsr — matches the CB-access idiom in ipi/vectors.pdx L82-96 (_ipi_handler_f1).  Collapses to two `mov qword [gs:32], 0`-style stores once paideia-as gains the [gs:disp32] encoding (PA-R14-001).  Effects: {mem} for the two CB stores; {sysreg} for rdmsr.  {boot} capability restricts to boot / witness paths (production wake/block hits runq_enqueue/dequeue directly, not runq_init).  rdmsr writes rax/rdx (caller-save); rcx = MSR index (caller-save). Leaf.",
    block: {
      // rax = &Percpu CB[this CPU] via rdmsr IA32_GS_BASE
      mov rcx, 0xC0000101;
      rdmsr;
      shl rdx, 32;
      or  rax, rdx;

      xor rcx, rcx;
      mov [rax + 32], rcx;                // CB.runqueue_head = NULL
      mov [rax + 40], rcx;                // CB.runqueue_tail = NULL
      ret
    }
  }

  // ============================================================================
  // runq_enqueue(task) — O(1) tail insertion on current CPU's runqueue
  // ============================================================================
  //
  // R18-M4-003 (#773): reworked from single-sentinel algorithm to per-CPU
  // head/tail-pointer-pair with NULL sentinel semantics (empty <=> head == 0).
  //
  // Doubly-linked list:  CB.head -> T0 <-> T1 <-> ... <-> Tn <- CB.tail
  //   T0.prev  == 0 (head marker); Tn.next == 0 (tail marker).
  //
  // Algorithm:
  //   task.next = 0                                 (task is the new tail)
  //   task.prev = CB.tail                           (link back to old tail)
  //   if CB.tail == 0: CB.head = task               (empty-list case)
  //   else:            CB.tail.next = task          (non-empty case)
  //   CB.tail = task
  //
  // Register discipline: rdi = task (preserved); rax = CB VA; rcx = MSR
  // index / scratch; rdx = old tail / rdmsr high half; r8 = 0 scratch.
  // All caller-save.  Callee-save clean.  Leaf (rdmsr only).
  //
  // Precondition: gs_base_init_bsp/gs_base_init_ap has programmed
  // IA32_GS_BASE for the calling CPU; runq_init has been called (else
  // head/tail are .bss-zero which is legally "empty" — enqueue still
  // works, but any orphan linked-list state left from a prior CPU's use
  // of the same CB VA would be visible via a stale head.next).
  // ============================================================================

  pub let runq_enqueue : (u64) -> () !{mem, sysreg} @{sched} = fn (task: u64) -> unsafe {
    effects: { mem, sysreg },
    capabilities: { sched },
    justification: "R18-M4-003 (#773): insert `task` at the tail of the calling CPU's per-CPU runqueue.  RDI = task (preserved through the body).  Sequence: (1) task.next = 0.  (2) rdmsr IA32_GS_BASE → rax = &Percpu CB (recombining EDX:EAX per SDM §5.2.9).  (3) rdx = CB.tail; task.prev = rdx.  (4) if rdx != 0 (list non-empty): rdx.next = task, else: CB.head = task.  (5) CB.tail = task.  Correctness (empty list): CB.head/tail both 0 initially; (4)'s else-branch sets CB.head = task, (5) sets CB.tail = task, task.next = task.prev = 0 — canonical single-element state.  Correctness (non-empty): rdx = old tail, (4)'s then-branch links old-tail.next to task, (5) publishes new tail — canonical N+1-element state.  Correctness of runq_dequeue post-invariant: dequeue leaves task.next/prev = 0 for off-runq tasks, so re-enqueue starts from a clean slot.  Effects: {mem} for CB and TCB writes, {sysreg} for rdmsr.  Reg clobber: rax (CB VA), rcx (MSR index), rdx (old tail / rdmsr high half).  All caller-save per SysV.  rdi (task) preserved through the sequence — the two rdmsr-clobbered regs are rax/rdx, and this fn never spills rdi.  Encoder: `mov [rdi + disp32], reg` — landed idiom (uses no new encoder gap vs pre-#773 body).  Once paideia-as PA-R14-001 lands, the three-instruction rdmsr triplet collapses to `mov rax, [gs:8]` (or a direct `mov [gs:40], rdi` if we split the store).  Callee-save clean.  Leaf (rdmsr is not a call).",
    block: {
      // (1) task.next = 0
      xor rcx, rcx;
      mov [rdi + 432], rcx;

      // (2) rax = &Percpu CB[this CPU] via rdmsr IA32_GS_BASE.
      //     rdmsr clobbers rax/rdx; rcx already re-loaded below.
      mov rcx, 0xC0000101;
      rdmsr;
      shl rdx, 32;
      or  rax, rdx;

      // (3) rdx = CB.tail (may be 0 if list empty).  task.prev = rdx.
      mov rdx, [rax + 40];
      mov [rdi + 440], rdx;

      // (4) if empty: CB.head = task, else: old_tail.next = task.
      cmp rdx, 0;
      je  runq_enq_empty;
        mov [rdx + 432], rdi;               // old_tail.next = task
        jmp runq_enq_set_tail;
      runq_enq_empty:
        mov [rax + 32], rdi;                // CB.head = task
      runq_enq_set_tail:
      // (5) CB.tail = task (always).
        mov [rax + 40], rdi;
        ret
    }
  }

  // ============================================================================
  // runq_dequeue(task) — O(1) unlink from current CPU's runqueue
  // ============================================================================
  //
  // R18-M4-003 (#773): reworked to patch CB.head / CB.tail directly when
  // the dequeued task is at either endpoint of the list (NULL-marker
  // discipline).
  //
  // Algorithm (with r8 = task.next, r9 = task.prev, rax = &CB):
  //   if r9 == 0: CB.head = r8            (task was head)
  //   else:       r9.next = r8            (patch predecessor's forward link)
  //   if r8 == 0: CB.tail = r9            (task was tail)
  //   else:       r8.prev = r9            (patch successor's back-pointer)
  //   task.next = task.prev = 0           (off-runq witness invariant)
  //
  // Register discipline: rdi = task (preserved); rax = CB VA; rcx = MSR
  // index / zero scratch; rdx = rdmsr high half; r8 = task.next; r9 =
  // task.prev.  All caller-save.  Callee-save clean.  Leaf.
  // ============================================================================

  pub let runq_dequeue : (u64) -> () !{mem, sysreg} @{sched} = fn (task: u64) -> unsafe {
    effects: { mem, sysreg },
    capabilities: { sched },
    justification: "R18-M4-003 (#773): unlink `task` from calling CPU's per-CPU runqueue.  RDI = task (preserved).  Reads task.next → r8, task.prev → r9, then obtains CB VA via rdmsr IA32_GS_BASE (same idiom as runq_enqueue / _ipi_handler_f1).  Two-branch patch: if r9 == 0 the task was CB.head, so CB.head ← r8; otherwise the predecessor's forward pointer (r9.next @ +432) is patched to r8.  Symmetrically: if r8 == 0 the task was CB.tail, so CB.tail ← r9; otherwise the successor's back-pointer (r8.prev @ +440) is patched to r9.  Post: task.next/prev NULLed for the off-runqueue invariant that sched_wake's #663 guard and the runq witness assertions (kernel_main runq_witness sub-test C) rely on.  Correctness (single-element): r8 == r9 == 0; both branches take the else-null paths, so CB.head ← 0 and CB.tail ← 0 — canonical empty state.  Correctness (head removal, N ≥ 2): r9 == 0, r8 = successor; CB.head ← successor, successor.prev ← 0.  Correctness (tail removal, N ≥ 2): r8 == 0, r9 = predecessor; CB.tail ← predecessor, predecessor.next ← 0.  Correctness (middle removal, N ≥ 3): both branches take the then-path, patching neighbouring links.  Effects: {mem} for CB and TCB writes; {sysreg} for rdmsr.  Reg clobber: rax (CB VA), rcx (MSR index / zero), rdx (rdmsr high half), r8/r9 (task.next/prev cached).  All caller-save per SysV.  Callee-save clean.  Leaf.  Encoder: no new form vs pre-#773 (adds cmp/je branches that were absent in the sentinel-algorithm no-branch version — the trade is O(1) still, but doubly-linked pointer-pair semantics demand endpoint tests).",
    block: {
      // Cache task.next and task.prev before touching the CB.
      mov r8, [rdi + 432];                  // r8 = task.next
      mov r9, [rdi + 440];                  // r9 = task.prev

      // rax = &Percpu CB[this CPU]
      mov rcx, 0xC0000101;
      rdmsr;
      shl rdx, 32;
      or  rax, rdx;

      // If task was head (task.prev == 0): CB.head = task.next.
      // Else:                              task.prev.next = task.next.
      cmp r9, 0;
      je  runq_deq_no_prev;
        mov [r9 + 432], r8;
        jmp runq_deq_check_next;
      runq_deq_no_prev:
        mov [rax + 32], r8;                 // CB.head = task.next
      runq_deq_check_next:

      // If task was tail (task.next == 0): CB.tail = task.prev.
      // Else:                              task.next.prev = task.prev.
      cmp r8, 0;
      je  runq_deq_no_next;
        mov [r8 + 440], r9;
        jmp runq_deq_clear;
      runq_deq_no_next:
        mov [rax + 40], r9;                 // CB.tail = task.prev
      runq_deq_clear:

      // Off-runq invariant: task.next = task.prev = 0.
      xor rcx, rcx;
      mov [rdi + 432], rcx;
      mov [rdi + 440], rcx;
      ret
    }
  }
}
