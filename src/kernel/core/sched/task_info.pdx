// src/kernel/core/sched/task_info.pdx — R57.M4-003 (paideia-os #1799) +
// R60.M7-002 (paideia-os #1817)
//
// Read-only iterator surface over the task pool.  One function
// (task_get_info) that a syscall body — or a future kernel-side
// introspection witness — asks: "give me a 64-byte snapshot of the
// task in slot N" (widened from 32 bytes by #1817 — see §R60.M7-002
// EXTENSION below).
//
// -----------------------------------------------------------------------------
// Why this file exists — layering rather than inlining
// -----------------------------------------------------------------------------
//
// sys_taskinfo could reach into _pid_table + _task_pool directly out
// of sys_taskinfo.pdx; nothing about the arithmetic would change.
// Splitting it out buys two things that matter as introspection grows:
//
//   (1) A NAMED READ SURFACE.  Every mutating primitive that touches
//       the task pool (task_new / task_free / pid_alloc / pid_free /
//       pid_gen_bump) lives in src/kernel/core/sched/task_pool.pdx and
//       is deliberately not `pub` beyond what its callers need.
//       task_get_info is the FIRST read-only consumer that publishes a
//       slot in a shape a caller from another subsystem is meant to
//       observe.  Future ones (a /proc-style handler, a kernel-side
//       "who's running" panic dump, an audit-log record source)
//       compose against the same primitive rather than each
//       re-deriving the pid → slab pointer walk.  Every re-derivation
//       is a chance to disagree with task_slab_of_pid's bound, which
//       is exactly the class of drift #1594 documented.
//
//   (2) A STABLE 32-BYTE RECORD LAYOUT.  The syscall body is not the
//       right place to pin a record shape; the shape is a data-model
//       decision that a driver-side notify path, a snapshot dumper and
//       an audit emitter will all want the same layout for, and the
//       one file to reach for is this one.  When comm[16] lands in the
//       task_struct at M1 (see §Name field below), task_get_info's
//       write into the +16..+31 slot flips from "zero-fill" to
//       "memcpy from task_struct.comm" WITHOUT touching sys_taskinfo,
//       ps, or the dispatch shim — the record layout absorbs the
//       change locally.
//
// -----------------------------------------------------------------------------
// Record layout — 32 bytes, three u32 slots + a 16-byte name
// -----------------------------------------------------------------------------
//
//   +0..+3    pid    (u32)     copied from task_struct[+0]  (TASK_OFF_PID)
//   +4..+7    ppid   (u32)     copied from task_struct[+4]  (parent_pid)
//   +8..+11   state  (u32)     copied from task_struct[+8]  (TASK_OFF_STATE)
//                              — legal values in {0..4} per sched/state.pdx,
//                              so the meaningful information is a single byte
//                              and the M0 spec calls it "state-byte";
//                              we keep the field u32-wide because the source
//                              is a u32 and a two-cycle zero-extend is cheaper
//                              than a byte load + narrow store.
//   +12..+15  reserved (u32)   zero.  Reserved for a future field — the
//                              obvious candidates are pid_gen (u16) +
//                              cpu_affinity_mask (u16 low bits) so the whole
//                              (pid, gen, cpu_mask) tuple a driver row would
//                              need in one shot lives in a fixed 32-byte
//                              record.  Keeping the slot at 0 rather than
//                              packing it now means M1 grows meaning into
//                              existing padding without renumbering downstream
//                              fields.
//   +16..+31  name   [u8;16]   NUL-padded task name.  M0 zero-fill.
//
// Total (M0, R57.M4-003) = 32 bytes.  The M0 task-issue text (paideia-os
// #1799) says both "32-B record" and lists fields whose plain u64 sum is 40;
// the u32 layout above is the ONE reading that resolves the two, matches how
// the kernel actually stores pid/ppid/state (u32 per src/kernel/core/sched/
// {task_pool, state}.pdx), and leaves 16 aligned bytes for the name field the
// spec insists on.  See also design notes at the top of sys_taskinfo.pdx.
//
// -----------------------------------------------------------------------------
// R60.M7-002 (#1817) EXTENSION — 64 bytes, three new u64 fields appended
// -----------------------------------------------------------------------------
//
// FROZEN RECORD LAYOUT, updated: the +0..+31 shape above is UNCHANGED (pid /
// ppid / state / reserved / name — every existing reader, including ps.pdx's
// M0 parse, keeps working byte-for-byte). #1817 appends three u64 fields plus
// one pad qword, doubling the record to 64 bytes so `/bin/ps` can surface
// per-task CPU time and residency:
//
//   +32..+39  cpu_ticks   (u64)   copied from task_struct[+136]
//                                 (TASK_OFF_CPU_TICKS). Cumulative count of
//                                 100 Hz LAPIC ticks during which this task
//                                 was _current_tcb, incremented by
//                                 int/exceptions.pdx handle_timer.
//   +40..+47  rss_pages   (u64)   HARD-CODED 0 at R60.M7-002.  See
//                                 §rss_pages below for why this ships as a
//                                 documented placeholder rather than a real
//                                 aspace walk.  TASK_OFF_RSS_PAGES (+144) is
//                                 reserved in task_pool.pdx so a future PML4
//                                 walker slots in without another record
//                                 resize.
//   +48..+55  start_tick  (u64)   copied from task_struct[+152]
//                                 (TASK_OFF_START_TICK). Snapshot of
//                                 int/exceptions.pdx's _tick_count at
//                                 task_new time (task_pool.pdx step 6.5b2).
//   +56..+63  pad1        (u64)   zero.  Rounds the record to a clean
//                                 power-of-two size and leaves one spare
//                                 qword for the next field this record
//                                 grows.
//
// Total (R60.M7-002) = 64 bytes.  TASK_INFO_RECORD_BYTES below is the single
// source for this width; dispatch.pdx's _dispatch_taskinfo_scratch, the
// user_ptr_ok / user_write_bytes_via_walk length args in dispatch_taskinfo,
// and ps.pdx's kernel-dst scratch all derive from it (copied, per the usual
// paideia-as cross-module-`let`-literal discipline, rather than referenced).
//
// -----------------------------------------------------------------------------
// rss_pages — why a walk was not attempted at R60.M7-002
// -----------------------------------------------------------------------------
//
// Computing a real per-task resident-page count means walking the target
// task's aspace_root PML4 (task_struct.user_pml4_pa @+16) across all four
// levels, counting present leaf PTEs. Three things made that walk a separate
// piece of work rather than a same-issue add-on:
//
//   (a) No existing primitive does this. frame_meta.pdx's _frame_meta array
//       is refcounts indexed BY PHYSICAL FRAME across the WHOLE 1024-frame
//       pool — global, not per-aspace — so it cannot answer "how many of
//       these frames a given task's aspace claims" without a
//       PTE-level walk first. No aspace_stat / rss_count / walk_pml4 helper
//       exists anywhere in src/kernel/core/mm/.
//   (b) The walk runs INSIDE a syscall body reached from kernel context with
//       the CALLER's CR3 loaded, not the TARGET task's — sys_taskinfo can be
//       asked about any idx, not just _current_tcb. Reading another task's
//       page-table pages safely means resolving each level's PA through the
//       kernel physmap (the `0xFFFF800000000000 + PA` idiom frame_meta.pdx
//       and phys_free.pdx already use), at four levels, with correct
//       present-bit and huge-page-bit gating at every one. Getting that
//       wrong reads (at best) garbage into the count and (at worst) walks
//       off a not-actually-mapped physical address.
//   (c) This is exactly the kind of primitive a wrong first cut is expensive
//       to have shipped: a syscall-time page-table walk that mis-handles one
//       level does not fail loudly, it returns a plausible-looking wrong
//       number, and the bug surfaces later as "ps reports impossible RSS"
//       rather than as a build or boot failure.
//
// Given the record's own field is reserved (TASK_OFF_RSS_PAGES @+144, zeroed
// by task_new's existing rep_stosq) and every OTHER column (pid/state/
// cpu_ticks/start_tick) is real, rss_pages ships as an honestly-documented 0
// rather than a hand-wavy approximation. A follow-up issue owns the PML4
// walker as its own reviewed unit; task_get_info's write into +40..+47 is
// the ONLY line that changes when it lands.
//
// -----------------------------------------------------------------------------
// Name field — why zero-fill at M0, and what changes at M1
// -----------------------------------------------------------------------------
//
// The task_struct slab (src/kernel/core/sched/task_pool.pdx) has NO comm[]
// field today.  sys_execve_shim resolves a path and loads an image but never
// stashes the exec'd path — nothing between fork+exec and the reaper is
// keyed on the task's original argv[0].  Rather than fabricate a name in
// this file's write (which would either (a) invent state the kernel does
// not have or (b) hard-code a well-known-pid table that goes stale the
// moment init's third fork+exec cycle lands), we zero-fill the 16-byte
// slot and let the userspace consumer (/bin/ps) render a synthetic name
// (`task<pid>`) when the record's byte 0 is NUL.
//
// M1 wiring (deferred, out of scope for #1799):
//   (a) task_pool.pdx grows TASK_OFF_COMM = 168 (+16 bytes) — the +168
//       slot is CURRENTLY fd_table's start (see the task_pool.pdx §566
//       adopted-slots table), so this needs an fd_table shift.  UPDATE
//       (R60.M7-002 #1817): the "claim the +136..+167 free region
//       instead" alternative this note originally offered is no longer
//       available — #1817 claimed +136..+159 of it for cpu_ticks /
//       rss_pages / start_tick, leaving only +160..+167 (8 bytes) free,
//       which is not enough for a 16-byte comm[]. The fd_table-shift
//       path is now the only option for TASK_OFF_COMM.
//   (b) sys_execve_shim (src/kernel/core/syscall/handlers/sys_execve_shim.pdx)
//       memcpys basename(path) into TCB.comm at path-resolve time.
//   (c) task_get_info's zero-fill loop below is replaced with a
//       `rep movsb` from slab+168 to dst+16 for 16 bytes.  No caller
//       changes; the syscall shim keeps its 64-byte contract (#1817);
//       /bin/ps drops the `task<pid>` fallback.
//
// -----------------------------------------------------------------------------
// Error semantics
// -----------------------------------------------------------------------------
//
// task_get_info returns 0 on success and one of two sign-negative sentinels
// otherwise, so a caller uses `cmp rax, 0; jl err` to branch on either
// error class in one instruction (same convention as
// src/kernel/core/syscall/dispatch.pdx §ipc_slot_to_endpoint).
//
//   0  (OK)          — record written; caller may propagate to userspace.
//   -ENOENT (-2)     — idx is in-range but the pid slot is empty (dead or
//                      never-allocated).  The caller (/bin/ps) skips this
//                      idx and continues iterating — a sparse pid space
//                      (e.g. init at 1 + shell at 3 with pid 2 already
//                      reaped) is the normal case, not an error.
//   -ESRCH  (-3)     — idx >= MAX_PIDS (64).  Signals "past end of pool";
//                      the caller terminates iteration.
//
// The two are distinct so /bin/ps knows when to stop.  An out-of-range
// index cannot be recovered from by advancing; an empty slot can.
//
// A pid == 0 idx maps naturally to -ENOENT: pid 0 is the reserved sentinel
// (task_pool.pdx §MAX_PIDS: "pid 0 is a reserved sentinel and gets no
// slot"), so _pid_table[0] is invariantly 0 and the same "table entry is
// zero" path fires.  No special-case for idx==0 required.
//
// -----------------------------------------------------------------------------
// Concurrency
// -----------------------------------------------------------------------------
//
// task_get_info reads _pid_table[idx] and, if non-zero, reads three u32
// fields at the slab base.  Both reads race against task_new (which writes
// _pid_table[pid] LAST — see task_pool.pdx §task_new step 7) and against
// task_free (which zeroes the slab BEFORE calling pid_free).  Two failure
// modes at R57 single-CPU cooperative:
//
//   (i)  Concurrent task_new completing between the two reads.  We would
//        observe _pid_table[idx] as 0 (return -ENOENT) or as non-zero
//        with a freshly-published slab whose pid/ppid/state fields are
//        already valid (task_new sets them in step 6, before the step-7
//        publish).  Either observation is coherent for a single caller.
//
//   (ii) Concurrent task_free between the two reads.  We would observe
//        _pid_table[idx] as non-zero, then read a slab that task_free
//        has just zeroed.  The record would report pid=0 ppid=0 state=0
//        — the state field would read as TASK_STATE_RUNNING (0), which
//        is misleading, but at R57 single-CPU cooperative no such race
//        exists (task_free runs synchronously inside a reap; no other
//        task can be observing task_get_info at the same instant).  SMP
//        or preemptive R58+ that changes this composes a per-slot
//        seqlock or a snapshot-lock at task_new/task_free ingress; the
//        primitive here does not have to change shape, only wrap.
//
// See design/kernel/r15-m5-006-task-new.md §concurrency (task_new step
// ordering) and src/kernel/core/sched/task_pool.pdx §task_free §1599 for
// the ordering the read side assumes.

module TaskInfo = structure {

  // ==========================================================================
  // Record size + error sentinels — the ONE place these are named.
  //
  // Declared as `let` (not `def`) so paideia-as places them in the
  // referencing module's local namespace without a cross-module `.` lookup;
  // callers still copy the numeric literal into their own emits (paideia-as
  // does not resolve cross-module `let` at parse time — same discipline as
  // Dispatch's DISPATCH_ERR_EBADF / DISPATCH_ERR_EACCES at dispatch.pdx L194).
  // The symbols exist for documentation and for a future
  // tools/verify-task-info-record.sh gate that pins the u64 literal in the
  // helper below against the declared constants.
  // ==========================================================================

  pub let TASK_INFO_RECORD_BYTES : u64 = 64   // R60.M7-002 (#1817): 32 -> 64
  pub let TASK_INFO_ERR_ENOENT   : u64 = 0xFFFFFFFFFFFFFFFE   // -2
  pub let TASK_INFO_ERR_ESRCH    : u64 = 0xFFFFFFFFFFFFFFFD   // -3

  // ==========================================================================
  // task_get_info(idx, kernel_dst) — read a task-pool slot into a 64B record
  // (R60.M7-002 #1817: widened from 32B)
  //
  // Contract (SysV):
  //   rdi = idx           (0 .. MAX_PIDS-1 = 0..63)
  //   rsi = kernel_dst    (kernel VA of a 64-byte destination buffer;
  //                        the dispatch shim in sys_taskinfo.pdx passes a
  //                        .bss scratch here, then walks the result out to
  //                        the user's own buffer via user_write_bytes_via_walk)
  //
  //   rax = 0            on success (record written into dst[0..64])
  //         -ESRCH (-3)  if idx >= MAX_PIDS (past end of pool)
  //         -ENOENT (-2) if idx is in-range but _pid_table[idx] == 0
  //
  // Leaf function.  No callee-save writes (rax/rcx/r8 are the only regs
  // touched, all caller-save).  Contract mirrors task_slab_of_pid's own
  // "answers 0 for out-of-range" collapsing convention (task_pool.pdx
  // §task_slab_of_pid) but distinguishes past-end (-ESRCH) from empty-slot
  // (-ENOENT) so a userspace iterator knows when to stop.
  //
  // Alignment: leaf function with no nested call; no rsp bracketing needed.
  //
  // Encoder discipline (paideia-as R57 + R60.M7-002):
  //   - `mov [rsi], ecx` and `mov ecx, [r8]` for the u32 field copies —
  //     both are standard mov-r32-to/from-memory forms used across
  //     src/kernel (task_pool.pdx step 6 writes pid via `mov [r13+0], r12d`
  //     and task_free reads pid via `mov r12d, [rbx+0]`).
  //   - The new (#1817) u64 field copies (cpu_ticks, start_tick) use plain
  //     `mov rcx, [r8+k]` / `mov [rsi+k], rcx` — full-width, no G1 sized-
  //     store annotation needed since both are whole qwords with no
  //     narrower neighbour sharing their alignment.
  //   - Zero-fill uses eight `mov [rsi + k], rcx` qword stores (widened
  //     from four by #1817) rather than rep_stosq — rep_stosq clobbers
  //     rdi/rcx/rax and the setup cost dominates a 64-byte fill (matches
  //     sys_pdxfs_dir_readnext_body's inline zero-fill discipline for the
  //     same record-size class).
  //   - No `add/sub reg, [mem]` shape (encoder gap awareness per R57 memo).
  //     Every load lands in a register first, then any arithmetic runs
  //     register-to-register.
  // ==========================================================================
  pub let task_get_info : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64) (kernel_dst: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R57.M4-003 (#1799) + R60.M7-002 (#1817): read-only iterator surface over the task pool. Refuses idx >= MAX_PIDS (64) with -ESRCH so an iterating caller (/bin/ps) knows when to stop; refuses an in-range idx whose _pid_table[idx] is 0 with -ENOENT so the same caller can skip a dead or never-allocated slot and continue. The distinction is load-bearing: an out-of-range idx cannot be recovered from by advancing, an empty slot can, and folding both into one sentinel would either terminate iteration prematurely (past first hole) or loop past end. On success, zero-fills the 64-byte destination first (#1817: widened from 32 -- eight qword stores, not four), then overwrites the +0/+4/+8 u32 slots with pid/ppid/state pulled from the task_struct (offsets +0/+4/+8, canonical per task_pool.pdx §TASK_OFF_PID and state.pdx §TASK_OFF_STATE), then (#1817) the +32/+48 u64 slots with cpu_ticks/start_tick pulled from task_struct+136/+152 (TASK_OFF_CPU_TICKS / TASK_OFF_START_TICK). The zero-fill covers the +12 reserved slot, the +16..+31 name field, +40..+47 rss_pages (deferred -- see file-header §rss_pages) and +56..+63 pad1. Name field: the task_struct has no comm[] field at M0 (design/kernel/r57-m4-003-sys-taskinfo.md defers this to M1 when sys_execve_shim gains a TCB.comm write), so the name field ships as NUL-padded and userspace synthesizes 'task<pid>' when it observes a leading NUL. Leaf function; no callee-save prologue needed. r8 is used as the slab-pointer holder so rax remains free as the return-value accumulator. Encoder-safe: `mov [rsi + k], rcx` qword zero-stores rather than rep_stosq (64 bytes still fits inside the rep_stosq setup cost, and rep_stosq clobbers rdi/rcx/rax which would force a re-load); u32 field copies use the `mov ecx, [r8+k]` / `mov_d [rsi+k], rcx` G1-safe shape used across task_pool.pdx step 6/task_free step 2; the new u64 field copies (#1817) use a plain `mov rcx, [r8+k]` / `mov [rsi+k], rcx` since cpu_ticks/start_tick are full qwords with no narrower neighbour to protect. No `add/sub reg, [mem]` shape anywhere; both slab-pointer and pid-table addresses land in a register via `lea` + `mov r64, [mem]` first. Concurrency at R57 single-CPU cooperative is coherent (task_new step-7 publish is the last write to _pid_table[pid]; task_free zeroes the slab before pid_free). SMP / preemptive R58+ that changes this composes a seqlock at the task_new / task_free ingress; task_get_info stays byte-identical.",
      block: {
        // ---- Gate 1: idx < MAX_PIDS (64) ----
        // task_pool.pdx §MAX_PIDS pins _pid_table as [u64; 64]; the `jae`
        // bound (rather than `ja`) matches the #740 fix in pid_alloc so
        // idx == 64 is refused rather than reading one qword past the
        // declared array.
        cmp rdi, 64;
        jae tgi_esrch;

        // ---- Load _pid_table[idx] ----
        // If it is 0, either idx == 0 (reserved sentinel — pid 0 is never
        // allocated) or the slot is dead / never-allocated.  Either way
        // the caller sees -ENOENT and can advance.
        lea rax, [rip + _pid_table];
        mov rax, [rax + rdi*8];
        cmp rax, 0;
        je tgi_enoent;

        // rax now holds the slab VA.  Save it to r8 because the zero-fill
        // loop below writes 0 through rcx and rax is about to become the
        // return-value accumulator.
        mov r8, rax;

        // ---- Zero-fill the 64-byte destination ----
        // Eight qword stores rather than rep_stosq: 64 B is well below the
        // rep_stosq setup break-even, and rep_stosq's rdi/rcx/rax clobber
        // would force us to re-load the slab pointer.  This is the same
        // pattern sys_pdxfs_dir_readnext_body uses for its 128 B scratch
        // fill of the entry record.  R60.M7-002 (#1817): widened from four
        // stores (32 B) to eight (64 B) for the cpu_ticks/rss_pages/
        // start_tick/pad1 extension.
        xor rcx, rcx;
        mov [rsi + 0], rcx;
        mov [rsi + 8], rcx;
        mov [rsi + 16], rcx;
        mov [rsi + 24], rcx;
        mov [rsi + 32], rcx;
        mov [rsi + 40], rcx;
        mov [rsi + 48], rcx;
        mov [rsi + 56], rcx;

        // ---- Copy pid (u32 @ slab+0) into dst+0 ----
        // G1 workaround (design note in src/kernel/acpi/madt.pdx §77 +
        // src/kernel/acpi/mcfg.pdx §65): `mov [mem], reg32` silently widens
        // to REX.W under paideia-as, so a bare `mov [rsi+0], ecx` would
        // write 8 bytes.  The zero-fill above + ascending-offset write
        // order below MAKES this specific sequence robust either way
        // (each write's stray upper bytes land on the next write's slot
        // or on already-zero padding), but `mov_d` documents the width
        // explicitly and stays correct if a future field arrives at
        // +12 that must not be zeroed by the state store.
        mov ecx, [r8 + 0];               // 32-bit load zero-extends into rcx
        mov_d [rsi + 0], rcx;            // G1: sized 32-bit store

        // ---- Copy ppid (u32 @ slab+4) into dst+4 ----
        // parent_pid is written by task_new step 6 (task_pool.pdx L510)
        // right after pid, using the same u32 mov shape.  Same G1
        // workaround as pid above.
        mov ecx, [r8 + 4];
        mov_d [rsi + 4], rcx;            // G1: sized 32-bit store

        // ---- Copy state (u32 @ slab+8) into dst+8 ----
        // TASK_OFF_STATE = 8, canonical per sched/state.pdx §101.
        // Values are in {0..4}: RUNNING, RUNNABLE, WAITING, ZOMBIE,
        // WAITING_IPC.  A caller wanting only the byte reads dst[8]
        // via mov_b — the upper bytes are zero because the source is u32
        // and the zero-fill above cleared bytes +9..+11.  Same G1
        // workaround.
        mov ecx, [r8 + 8];
        mov_d [rsi + 8], rcx;            // G1: sized 32-bit store

        // ---- +12 reserved slot and +16..+31 name field stay 0 ----
        // See §"Name field" in the file header: the task_struct has no
        // comm[] field at M0, so /bin/ps observes a leading NUL and
        // synthesizes 'task<pid>'.  M1 replaces the zero-fill for
        // +16..+31 with a copy from TCB.comm.

        // ---- R60.M7-002 (#1817): copy cpu_ticks (u64 @ slab+136) into dst+32 ----
        // TASK_OFF_CPU_TICKS, incremented once per 100 Hz tick by
        // int/exceptions.pdx handle_timer whenever this task is
        // _current_tcb. Full 64-bit field -- no G1 sized-store workaround
        // needed (contrast the u32 pid/ppid/state copies above).
        mov rcx, [r8 + 136];
        mov [rsi + 32], rcx;

        // ---- +40..+47 rss_pages stays 0 ----
        // TASK_OFF_RSS_PAGES is reserved but not read here: R60.M7-002
        // defers the aspace-walk that would populate it honestly rather
        // than approximate it. See the file-header §rss_pages section for
        // the reasoning. The zero-fill above already covers +40..+47; a
        // follow-up issue adds a `mov rcx, [r8 + 144]; mov [rsi + 40], rcx`
        // pair here (and nothing else) once a PML4 walker exists.

        // ---- R60.M7-002 (#1817): copy start_tick (u64 @ slab+152) into dst+48 ----
        // TASK_OFF_START_TICK, stamped once at task_new time (task_pool.pdx
        // step 6.5b2) from int/exceptions.pdx's _tick_count.
        mov rcx, [r8 + 152];
        mov [rsi + 48], rcx;

        // ---- +56..+63 pad1 stays 0 (zero-fill above) ----

        xor rax, rax;                    // return 0
        ret;

      tgi_esrch:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // -ESRCH
        ret;

      tgi_enoent:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // -ENOENT
        ret
      }
    }

}
