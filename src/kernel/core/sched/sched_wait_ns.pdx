// src/kernel/core/sched/sched_wait_ns.pdx — COMP-IMPL-07 (Wave UUU)
//
// Kernel-side nanosecond-duration sleep primitive backing SC+ sysno 116
// (sys_sched_wait_ns). Replaces a ring-3 busy-wait (svc-compositor's
// render_loop spinning on sys_clock_read_ns before this landing) with a
// real WAIT-state suspend + timer-wheel wake.
//
// Design authority: this file. Composes primitives already proven at
// R15-M7-006 (#567, sched_block/sched_wake — wake_block.pdx) and #1582
// part A (hpet_now_ns — core/time/hpet.pdx) rather than inventing new
// scheduler mechanics.
//
// =============================================================================
// WHY A NEW WAIT-KIND RATHER THAN REUSING SchedWait.sched_wait
// =============================================================================
//
// sched/sched_wait.pdx's sched_wait(kind, obj) already parks the caller
// on a (kind, obj) key inside the same TASK_OFF_WAIT_KIND(+448) /
// TASK_OFF_WAIT_OBJECT(+456) TCB fields this file reuses, and its sibling
// sched_wake_kind(kind, obj) already scans + wakes matching waiters. That
// pair is NOT reused verbatim here because a time-based wait needs a
// THIRD piece of per-task state — the deadline itself — that the (kind,
// obj) shape has nowhere to carry (obj is a single opaque u64 already
// spoken for by every other wait_kind's own identity). This file
// therefore adds one more TCB field (TASK_OFF_WAIT_DEADLINE_NS, +480 —
// see below for why that offset) and hand-rolls its own wait/wake pair
// (sched_wait_ns / sched_wait_ns_sweep) directly against sched_block /
// sched_wake, using a dedicated wait_kind tag (SCHED_WAIT_TIMER_NS) so
// this family never cross-matches sched_wake_kind's generic scan or any
// other wait_kind consumer's own targeted wake.
//
// =============================================================================
// WAIT_KIND VALUE — SCHED_WAIT_TIMER_NS = 3
// =============================================================================
//
// sched/sched_wait.pdx's own enum reserves 0 (SCHED_WAIT_NONE) and 1
// (SCHED_WAIT_ELEVATE_CHANNEL_RX), with a header comment "grow this table
// when a new consumer arrives" — but a second consumer, KindPageFlip
// (src/kernel/core/cap/kind_page_flip.pdx), already claimed value 2 as
// SCHED_WAIT_PAGE_FLIP without updating sched_wait.pdx's own table (its
// sys_page_flip_wait / pgfl_deliver_vblank call sites use the SAME
// TASK_OFF_WAIT_KIND(+448)/TASK_OFF_WAIT_OBJECT(+456) fields via the
// generic sched_wait/sched_wake_kind primitives this file's header above
// declines to reuse). Verified via grep for `SCHED_WAIT_` across
// src/kernel at landing: 0, 1, and 2 are taken. This file claims 3.
//
// =============================================================================
// TCB FIELD — TASK_OFF_WAIT_DEADLINE_NS = 480
// =============================================================================
//
// task_pool.pdx documents the free region as +464..+1703, but +464..+479
// is already consumed by TASK_OFF_COMM (paideia-os#2431, 16 bytes). The
// next unclaimed 8-aligned qword is +480 — verified clean via grep for
// `+ 480]` / `+480]` against src/kernel/**/*.pdx at landing (no other
// consumer). Covered by task_new's existing 278-qword `rep stosq`
// zero-fill (task_pool.pdx step 5), so every fresh task starts at
// deadline==0 (harmless: wait_kind is also 0 == SCHED_WAIT_NONE for a
// fresh task, so the sweep's wait_kind filter already excludes it before
// the deadline is ever read).
//
// =============================================================================
// TIMER-WHEEL GRANULARITY
// =============================================================================
//
// paideia-os has a real periodic LAPIC tick (100 Hz, ~10 ms period —
// int/exceptions.pdx handle_timer) driving preemption, TCP retransmit
// polling (tcp_poll_retransmits, sampled every 10th tick), and the
// simulated 60 Hz vblank sources (sim_vblank_tick / virtio_gpu_isr_tick,
// sampled every tick). sched_wait_ns_sweep is wired into that SAME tick
// (see int/exceptions.pdx handle_timer's step 0.8), sampled every tick
// like the vblank sources rather than every-10th like the TCP sweep —
// the compositor render_loop this primitive was built for wants ~16 ms
// (60 fps) or better wake latency, and a 64-slab linear scan every 10 ms
// is cheap (same iteration bound and cost class as sched_wake_kind's own
// per-notify scan). Sleep requests therefore resolve with a worst-case
// +1 tick (~10 ms) of jitter past their requested ns — acceptable for a
// render pacing primitive, not a hard-real-time guarantee. A future
// per-CPU real timer-wheel (sorted by nearest deadline, armed via
// tsc_deadline_arm_first) would tighten this without changing either
// call site's contract; this landing takes the tick-sampled MVP because
// the periodic LAPIC tick already exists and a sorted wheel does not.
//
// =============================================================================
// RACE POSTURE
// =============================================================================
//
// Matches sched_wait.pdx's own posture verbatim: no timer preemption
// existed when that file landed and none has been added since outside
// the periodic tick this file now also samples. sched_wait_ns's (store
// deadline, block) sequence and sched_wait_ns_sweep's (scan, match, wake)
// sequence run under -smp 1 with no concurrent observer of the
// intermediate state; the classic wakeup race is structurally impossible
// today. sched_wait_ns_sweep additionally runs with IF=0 (inside the
// timer ISR), so it cannot itself be preempted mid-scan.

module SchedWaitNs = structure {
  // ==========================================================================
  // Shared TCB fields (duplicated locally per this tree's established
  // cross-module-let-does-not-resolve-at-parse-time discipline — see
  // sys_kill.pdx's own TASK_STATE_* duplicates for the precedent).
  // Canonical source for +448/+456: sched/sched_wait.pdx.
  // ==========================================================================

  pub let TASK_OFF_WAIT_KIND        : u64 = 448
  pub let TASK_OFF_WAIT_OBJECT      : u64 = 456
  pub let TASK_OFF_WAIT_DEADLINE_NS : u64 = 480

  // wait_kind tag for this family. Distinct from SchedWait's
  // SCHED_WAIT_NONE(0) / SCHED_WAIT_ELEVATE_CHANNEL_RX(1) AND from
  // KindPageFlip's SCHED_WAIT_PAGE_FLIP(2) — see this file's header
  // §WAIT_KIND VALUE for why 2 is taken and 3 is the first free tag.
  pub let SCHED_WAIT_TIMER_NS : u64 = 3

  pub let TASK_STATE_WAITING : u32 = 2

  // MAX_PIDS bound (sched/task_pool.pdx), duplicated locally.
  pub let SWN_MAX_PIDS : u64 = 64

  // ==========================================================================
  // sched_wait_ns(ns) — self-suspend the caller for at least `ns`
  // nanoseconds.
  // ==========================================================================
  //
  // Sequence:
  //   (0) ns == 0 -> return immediately without blocking (a zero-length
  //       sleep is a no-op, not an infinite one — guards against a
  //       caller race where hpet_now_ns + 0 could otherwise appear
  //       "already expired" before the first sweep even runs, which is
  //       harmless but wastes a full block/wake round trip for nothing).
  //   (1) deadline = hpet_now_ns() + ns.
  //   (2) store (SCHED_WAIT_TIMER_NS, 0, deadline) into the caller's TCB
  //       at +448 / +456 / +480 BEFORE calling sched_block, mirroring
  //       sched_wait's own ordering rationale: a sweep that fires between
  //       this store and sched_block's state-flip still finds the TCB,
  //       but the sweep's own state==WAITING filter (see below) skips it
  //       harmlessly until sched_block completes the flip.
  //   (3) call sched_block. Returns here when sched_wait_ns_sweep matches
  //       this task's expired deadline and calls sched_wake on it.
  //   (4) on resume, zero all three fields defensively (same
  //       belt-and-braces posture as sched_wait step 4).
  //
  // Register discipline: entry rsp%16==8 (dispatch shim's `sub rsp,8`
  // pad before `call`). Single push (rbx=ns) lands rsp%16==0 — exactly
  // what both nested calls (hpet_now_ns, sched_block) require; no
  // additional alignment pad needed since one push is enough (odd count
  // flips 8->0). rbx must survive the hpet_now_ns call (which clobbers
  // only caller-save rax/rcx per its own justification) and is dead
  // after step (1) computes the deadline.
  //
  // Effects mem+sysreg, capabilities {sched, boot}: mem for the TCB
  // writes, sysreg transitive from sched_block's pick_next.gs_base rdmsr;
  // {boot} is required directly by hpet_now_ns, {sched} transitive from
  // sched_block.
  pub let sched_wait_ns : (u64) -> u64 !{mem, sysreg} @{sched, boot} =
    fn (ns: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {sched, boot},
      justification: "COMP-IMPL-07 (Wave UUU): self-suspend the caller for at least `ns` nanoseconds via a timer-wheel entry, replacing a ring-3 busy-wait. (0) ns==0 -> return 0 immediately, no block (zero-length sleep is a no-op). (1) push rbx (entry rsp%16==8 -> 0, exactly the alignment the two nested calls below need, no extra pad); rbx=ns. (2) call hpet_now_ns -> rax=now (time/hpet.pdx §hpet_now_ns, leaf, callee-save clean, clobbers only caller-save rax/rcx so rbx survives). (3) add rax, rbx -> rax=deadline=now+ns. (4) Load current TCB via [rip+_current_tcb]; store SCHED_WAIT_TIMER_NS(3) at +448 (TASK_OFF_WAIT_KIND), 0 at +456 (TASK_OFF_WAIT_OBJECT, unused by this wait_kind), and deadline at +480 (TASK_OFF_WAIT_DEADLINE_NS) — all via register-then-store (never `mov [mem], imm`, per this tree's encoder-conservative discipline). SCHED_WAIT_TIMER_NS is 3, not 2, because KindPageFlip (cap/kind_page_flip.pdx) already claimed 2 as SCHED_WAIT_PAGE_FLIP against these same TCB fields via the generic SchedWait.sched_wait primitive (see this file's header §WAIT_KIND VALUE) — colliding on 2 would make sched_wait_ns_sweep spuriously match a page-flip waiter's stale (never-written-by-that-path) +480 deadline slot. Stores happen BEFORE sched_block so a sched_wait_ns_sweep tick that lands between this store and sched_block's state-flip still finds the TCB; the sweep's own state==TASK_STATE_WAITING(2) filter skips it harmlessly until sched_block's own state-flip completes (mirrors sched_wait.pdx's identical race posture, §RACE POSTURE header). (5) call sched_block (sched/wake_block.pdx §567) — flips state RUNNABLE->WAITING, runq_dequeue, sched_pick_next_r15, sched_switch_r15; returns here once sched_wait_ns_sweep (this file) finds this task's deadline elapsed and calls sched_wake on it. (6) on resume, reload current TCB and zero all three fields (+448/+456/+480) defensively so a stale re-sweep before the caller's next sched_wait_ns call cannot spuriously re-fire (belt-and-braces, mirrors sched_wait step 4). (7) rax=0, pop rbx, ret. Register discipline: single-push (rbx) callee-save prologue; entry rsp%16==8, one push (odd) lands rsp%16==0 for both nested calls (hpet_now_ns, sched_block) with no additional alignment pad needed. rbx=ns survives hpet_now_ns (caller-save clobber only) and is dead by the time sched_block is called. rax/rcx/rdx caller-save scratch throughout. Effects {mem,sysreg}: mem for the TCB field writes, sysreg transitive from sched_block's underlying pick_next.gs_base rdmsr. Capabilities {sched,boot}: {boot} required directly by hpet_now_ns, {sched} transitive from sched_block. Labels prefixed swn_.",
      block: {
        cmp rdi, 0;
        je swn_wait_zero;

        push rbx;
        mov rbx, rdi;                         // rbx = ns (survives hpet_now_ns)

        call hpet_now_ns;                     // rax = now
        add rax, rbx;                         // rax = deadline = now + ns

        mov rcx, [rip + _current_tcb];
        mov rdx, 3;                           // SCHED_WAIT_TIMER_NS
        mov [rcx + 448], rdx;                 // TASK_OFF_WAIT_KIND
        xor rdx, rdx;
        mov [rcx + 456], rdx;                 // TASK_OFF_WAIT_OBJECT (unused)
        mov [rcx + 480], rax;                 // TASK_OFF_WAIT_DEADLINE_NS

        call sched_block;

        // On resume: zero all three fields defensively.
        mov rcx, [rip + _current_tcb];
        xor rdx, rdx;
        mov [rcx + 448], rdx;
        mov [rcx + 456], rdx;
        mov [rcx + 480], rdx;

        xor rax, rax;
        pop rbx;
        ret;

      swn_wait_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sched_wait_ns_sweep() — timer-wheel expiry scan; wakes every task
  // whose SCHED_WAIT_TIMER_NS deadline has elapsed.
  // ==========================================================================
  //
  // Called once per LAPIC tick from int/exceptions.pdx handle_timer (see
  // this file's §TIMER-WHEEL GRANULARITY header for why every-tick rather
  // than every-10th-tick). Scans pid in [1, 63] via task_slab_of_pid
  // (bounds-checked; 0 for unallocated), filters on
  // state==TASK_STATE_WAITING(2) && wait_kind==SCHED_WAIT_TIMER_NS(3) &&
  // deadline<=now, clears the three wait fields, and calls sched_wake.
  //
  // Register discipline: entry rsp%16==8 (called directly from
  // handle_timer with no preceding pad, matching the sim_vblank_tick /
  // virtio_gpu_isr_tick call sites immediately above it). 3-push
  // callee-save prologue (rbx=scan idx, r12=now, r13=matched slab) —
  // odd count lands rsp%16==0 for every nested call (hpet_now_ns,
  // task_slab_of_pid, sched_wake).
  //
  // Effects mem+sysreg, capabilities {sched, boot}: mem for the TCB
  // field reads/writes, sysreg transitive from sched_wake's runq_enqueue
  // rdmsr; {boot} required directly by hpet_now_ns and transitively by
  // sched_wake's cross-CPU IPI branch (dormant under -smp 1, matching
  // sched_wake_kind's own capability rationale).
  pub let sched_wait_ns_sweep : () -> () !{mem, sysreg} @{sched, boot} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {sched, boot},
      justification: "COMP-IMPL-07 (Wave UUU): per-tick timer-wheel expiry sweep, called from int/exceptions.pdx handle_timer once per ~10 ms LAPIC tick (see this file's §TIMER-WHEEL GRANULARITY for the every-tick-not-every-10th rationale). (1) 3-push callee-save prologue (rbx=scan idx, r12=now, r13=matched slab); entry rsp%16==8, 3 (odd) pushes land rsp%16==0 for every nested call below. (2) call hpet_now_ns -> r12=now, read once per sweep rather than per-candidate (all candidates are compared against the same instant; re-reading per-row would only let a slow scan wake a later row against a slightly newer `now`, which is not a correctness requirement here). (3) scan pid in [1,63] via task_slab_of_pid (task_pool.pdx §1594, bounds-checked, 0 for unallocated -> skip). For each live slab: filter (a) [slab+8]==TASK_STATE_WAITING(2) (u32 load, matches state.pdx's canonical field width — same shape as sched_wake_kind's own filter (a)); (b) [slab+448]==SCHED_WAIT_TIMER_NS(3) — excludes every other wait_kind in play (SCHED_WAIT_NONE=0, SCHED_WAIT_ELEVATE_CHANNEL_RX=1, KindPageFlip's SCHED_WAIT_PAGE_FLIP=2 — see this file's header §WAIT_KIND VALUE for why this family claims 3, not 2) so this sweep never touches a task parked via SchedWait.sched_wait or sys_page_flip_wait; (c) [slab+480] (deadline) <= r12 (now) via `cmp rcx, r12; ja swns_next` (deadline > now -> not yet expired, skip). On triple-match: zero all three wait fields (+448/+456/+480) BEFORE waking (clear-before-wake ordering, mirrors sched_wake_kind's identical discipline and uart_rx_notify_wake_if_waiter §3.4), then `mov rdi, r13; call sched_wake` (sched/wake_block.pdx §567/#1883 — flips WAITING->RUNNABLE, affinity-aware local/cross-CPU enqueue). No counter/fingerprint emit — this runs every ~10 ms tick regardless of match count, and per handle_timer's own established posture (sim_vblank_tick / virtio_gpu_isr_tick, called unconditionally every tick just above this sweep's call site) a per-tick klog emission on every expiry would be no noisier than those siblings already are, but is deliberately omitted here since a busy render_loop issuing sub-tick sys_sched_wait_ns calls would otherwise flood the ring at up to 100 Hz — matches sched_wake_kind's own 'no emit on the common path' caution taken one step further. Iteration bound: SWN_MAX_PIDS=64 scan (task_pool.pdx MAX_PIDS), same O(64) cost class as sched_wake_kind's own per-notify scan; runs at 100 Hz so the amortized cost is one more 64-row linear scan per tick alongside the existing TCP retransmit sweep (every 10th tick) and the vblank sources (every tick). Register discipline: rbx (scan idx, callee-save, live across every nested call), r12 (now, callee-save, live end-to-end — read once, compared per row), r13 (matched slab, callee-save, live from task_slab_of_pid's return through sched_wake's call). rax/rcx/rdi caller-save scratch throughout. Effects {mem,sysreg}: mem for the TCB field reads/writes, sysreg transitive from sched_wake's underlying runq_enqueue.gs_base rdmsr and hpet_now_ns's MMIO read path. Capabilities {sched,boot}: {boot} required directly by hpet_now_ns and transitively by sched_wake's dormant cross-CPU IPI branch (matches sched_wake_kind's own {sched} claim, widened here to {sched,boot} because THIS sweep — unlike sched_wake_kind — also calls hpet_now_ns directly). Labels prefixed swns_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call hpet_now_ns;
        mov r12, rax;                         // r12 = now

        mov rbx, 1;                           // pid scan starts at 1

      swns_scan:
        cmp rbx, 64;
        jae swns_done;

        mov rdi, rbx;
        call task_slab_of_pid;                // rax = slab VA or 0
        cmp rax, 0;
        je swns_next;

        mov r13, rax;                         // r13 = live slab

        // Filter (a): state == TASK_STATE_WAITING (2).
        mov ecx, [r13 + 8];
        cmp ecx, 2;
        jne swns_next;

        // Filter (b): wait_kind == SCHED_WAIT_TIMER_NS (3).
        mov rcx, [r13 + 448];
        cmp rcx, 3;
        jne swns_next;

        // Filter (c): deadline <= now (i.e. NOT (deadline > now)).
        mov rcx, [r13 + 480];
        cmp rcx, r12;
        ja swns_next;

        // Match. Clear wait fields BEFORE waking.
        xor rcx, rcx;
        mov [r13 + 448], rcx;
        mov [r13 + 456], rcx;
        mov [r13 + 480], rcx;

        mov rdi, r13;
        call sched_wake;

      swns_next:
        add rbx, 1;
        jmp swns_scan;

      swns_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
