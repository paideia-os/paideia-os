// src/kernel/core/sched/state.pdx — R20b.M3-001 (#1558)
// Canonical task-state enum + scheduler-metadata field offsets.
//
// Design context
// --------------
// Pre-R20b.M3, task-state constants were duplicated across at least four
// files: sched/tcb.pdx (TCB_STATE_RUNNING/RUNNABLE/BLOCKED — R11-era
// idle-task shape), sched/yield.pdx + sched/budget.pdx (STATE_RUNNING /
// STATE_RUNNABLE — R11 preempt bodies), syscall/handlers/sys_exit.pdx
// (STATE_RUNNABLE/WAITING/ZOMBIE — R15.M6 termination path), and
// syscall/handlers/sys_fork.pdx (STATE_RUNNABLE — R15.M6 fork path).
// Every consumer inlines the numeric literal at the write site (paideia-as
// does not resolve cross-module `let` constants at parse time — see the
// same frozen-constant discipline in endpoint_table.pdx §PENDING_PAYLOAD
// _MAX_BYTES).
//
// This module is the CANONICAL place the constants live. It does not
// deprecate the sister definitions (which remain valid for local
// clarity); it adds the R20b.M3 additions in one place so the IPC-recv
// wait-state and the wait_endpoint_id field offset are not re-invented
// at every consumer.
//
// New at R20b.M3-001 (#1558)
// --------------------------
//   TASK_STATE_WAITING_IPC (=4) — scaffolding constant for the design's
//     differentiated wait-state model per design/ipc/userspace-server-
//     substrate.md §5.2 ("WAITING_IPC is a new state value; the runqueue
//     path already skips non-RUNNABLE tasks"). At R20b.M3-001 the actual
//     runtime state during an ipc_recv block is STATE_WAITING (2) because
//     sched_block (src/kernel/core/sched/wake_block.pdx §sched_block)
//     hard-asserts state == STATE_RUNNABLE at entry (kassert_fail path
//     #663) and unconditionally writes STATE_WAITING (2) at step 2.
//     Overwriting the state to WAITING_IPC would require either bypassing
//     sched_block (duplicating its runq_dequeue + pick_next + switch
//     sequence with a different state write) or extending sched_block
//     to accept a state parameter — both are out of scope for this
//     sub-issue. The distinguishing per-task metadata used at wake time
//     is instead the wait_endpoint_id field below plus the
//     endpoint_table row's waiter_tcb slot (endpoint_table.pdx +32);
//     sys_ipc_send (R20b.M3-002) uses the endpoint's waiter_tcb to find
//     the target task and calls sched_wake — no state discrimination
//     required at that layer. WAITING_IPC stays defined here so future
//     work (queued waiters, wait-timeout, priority-inheritance) can adopt
//     the differentiated state without a naming drift.
//
//   TASK_OFF_WAIT_ENDPOINT_ID (=120) — u16 field in the task_struct slab.
//     Placement rationale: +112..+119 is sched_budget (u32 @ +112) + a
//     4-byte reserved-padding gap at +116..+119 (documented in
//     task_pool.pdx §TASK_OFF_SCHED_BUDGET); +168 is fd_table start.
//     +120..+167 is a documented-clean gap (task_pool.pdx §566: "56-byte
//     gap +112..+167 was R11-era callee-save spill space that R15
//     task_struct never wrote — verified clean via grep for +112/+120/
//     +128/+136/+144/+152 memops across the R15 sched/syscall paths").
//     Placing wait_endpoint_id at +120 (u16) leaves +122..+167 free for
//     future related metadata (wait_deadline, wait_reason enum, wait
//     queue link). task_new (task_pool.pdx §548) rep-stosq zeroes the
//     full 2224-byte slab so the field starts at 0 (== ENDPOINT_ID sentinel
//     "no endpoint waited on") on every freshly-constructed task — no
//     explicit task_new update required to land the field.
//
// Cross-references
// ----------------
//   design/ipc/userspace-server-substrate.md §5.2 (blocking-receive hook)
//   src/kernel/core/sched/wake_block.pdx (sched_block / sched_wake)
//   src/kernel/core/ipc/endpoint_table.pdx §M2-002 (pending-msg primitives)
//   src/kernel/core/syscall/handlers/sys_exit.pdx §TASK_OFF_STATE (=8)
//   src/kernel/core/sched/task_pool.pdx §TASK_OFF_SCHED_BUDGET (=112)

module State = structure {

  // ============================================================================
  // Canonical task-state enum (u32 field at TCB offset +8)
  //
  // These values are the ONLY legal contents of the state field. Every
  // scheduler primitive (sched_block, sched_wake, sched_pick_next_r15,
  // runq_dequeue, runq_enqueue) reads or writes the field with one of
  // these constants. Adding a new state value requires updating every
  // consumer to know what runqueue treatment the new state implies.
  // ============================================================================

  pub let TASK_STATE_RUNNING     : u32 = 0
  pub let TASK_STATE_RUNNABLE    : u32 = 1
  pub let TASK_STATE_WAITING     : u32 = 2      // generic wait — sched_block target
  pub let TASK_STATE_ZOMBIE      : u32 = 3

  // R20b.M3-001 (#1558): differentiated IPC wait-state. See the file-header
  // "New at R20b.M3-001" paragraph for the scaffolding-only rationale.
  pub let TASK_STATE_WAITING_IPC : u32 = 4

  // ============================================================================
  // Field offsets (bytes, from task_struct base)
  //
  // Only the state field + the R20b.M3-001 addition are canonicalised here;
  // the full slab layout is documented across task_pool.pdx and sys_exit.pdx
  // (see cross-references above). Consumers of these constants inline the
  // literal offsets at their memops (paideia-as does not resolve cross-
  // module `let` at parse time); the symbols are for documentation +
  // consumer-side test fixtures.
  // ============================================================================

  pub let TASK_OFF_STATE              : u64 = 8
  pub let TASK_OFF_WAIT_ENDPOINT_ID   : u64 = 120

}
