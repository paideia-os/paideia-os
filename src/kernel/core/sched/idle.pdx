// src/kernel/core/sched/idle.pdx — R15-M7-001 (#562)
// Idle task: single, always-runnable task with hlt-loop body
// Issue: #562
//
// The idle task provides a well-defined fallback when the runqueue is empty.
// At R15.M7 (single-CPU), one idle task suffices; #566 extends to per-CPU.
// See design/kernel/r15-m7-001-idle-task.md for full rationale and layout.

module Idle = structure {
  // ============================================================================
  // R15-M7-001 (#562): Idle task storage
  // ============================================================================

  // Backing storage: 2224-byte slab, same shape as _task_pool slots.
  // Aligned to 4 KiB for cache-line symmetry with _task_pool.
  // Layout matches task_struct offsets (all fields init to .bss zero):
  //   +0:   pid (u32) — frozen at 0 (idle has no PID)
  //   +4:   parent_pid (u32) — frozen at 0 (idle predates init)
  //   +8:   state (u32) — written to STATE_RUNNABLE (1) by idle_init
  //   +12:  pad (u32)
  //   +16:  user_pml4_pa (u64) — frozen at 0 (idle uses kernel higher-half)
  //   +32:  regs_save.rsp (u64) — written by idle_init
  //   +40:  regs_save.rip (u64) — written by idle_init to &idle_code
  //   +48..+152: regs_save.rflags + callee-saves (frozen at 0)
  //   +168: fd_table[0..32] (frozen at 0 — idle has no file descriptors)
  pub let mut _idle_task_slot : [u64; 278] = uninit @align(4096)

  // Idle's kernel stack: 4 KiB (one page, 512 u64s).
  // Idle never grows a call chain — its whole body is 3 bytes hlt/jmp — so a
  // smaller stack than the 8 KiB real tasks get is defensible. Kept at 4 KiB
  // (one page) for TLB-count parity and to match the design.
  pub let mut _idle_kernel_stack : [u64; 512] = uninit @align(16)

  // Dedicated pointer to _idle_task_slot, published at idle_init and read by
  // sched_pick_next_r15 as its "runqueue empty" fallback. RIP-relative via
  // lea + mov [rip + _idle_tcb], _idle_task_slot at init time.
  pub let mut _idle_tcb : u64 = uninit

  // ============================================================================
  // R15-M7-001 (#562) + R17-M5-758 (paideia-os #758): idle_code — sti/hlt/jmp
  // ============================================================================

  pub let idle_code : () -> () !{sysreg} @{boot} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "R15-M7-001 (#562) + R17-M5-758 (paideia-os #758): idle-task body — sti+hlt loop. Executes at CPL=0 with kernel CS/SS. sti (0xFB) enables IF so hlt (0xF4) actually waits for a maskable interrupt; on IRQ, ISR runs (interrupt-gate entry clears IF, iretq restores RFLAGS with IF=1) and control resumes at the jmp (0xEB 0xFC, short backward jump -4) which loops back to sti. Never returns (no ret). The kernel context this runs under is whatever CR3 was loaded when sched_switch (#564) picked idle — idle does not manipulate CR3. Safe: sti/hlt in ring-0 are privileged, but that's the ring idle runs in; jmp is trivially safe. No stack push, no register clobber beyond RIP itself. Encoding: sti=0xFB (1 byte), hlt=0xF4 (1 byte), jmp rel8=0xEB,disp8 (2 bytes). Backward jump from jmp end (offset 4) to sti start (offset 0): disp8 = 0 - 4 = -4 = 0xFC. #758 rationale: idle_init leaves regs_save.rflags = 0 (.bss) and regs_save.rip = &idle_code, so on the first schedule of idle sched_switch_r15's push-idle.rflags-then-push-idle.rip-then-ret sequence lands directly at idle_code (bypassing sched_switch_r15_continuation, which is the site that popfq's a saved rflags into IF). The `cli` at line 122 of switch.pdx therefore propagates through the ret into idle_code with IF=0, so a bare `hlt` halted the CPU forever — the LAPIC delivered vec 0x24 (UART RX) into the IRR but the CPU stayed halted (IF=0 masks all maskable IRQs even from hlt state per Intel SDM Vol 2A §HLT). Manifests only when idle is actually reached: pre-#748 no ring-3 task blocked (init just spun in wait4 → child → exit → init resume, never landing on idle), and boot_r17_init's assertion halts at SHELL START before the shell's sys_read → tty_read → sched_block → sched_switch_r15(idle) fires. boot_r17_shell_interactive is the first mode that requires post-idle IRQ delivery, exposing the deadlock as issue #758. sti-then-hlt is the classic idiom (Intel SDM Vol 2A §STI: 'STI does not enable interrupts until the following instruction is executed') so no pending-IRQ-lost race between sti and hlt: an IRQ that becomes pending before sti is delivered inside hlt. Re-sti on every iteration is defensive (iretq should restore IF=1 from the saved frame) but zero-cost given hlt dominates the loop's runtime. Mirrors the sti+hlt idiom in the preempt witness tasks (tasks.pdx L280).",
    block: {
      idle_loop:
        sti;
        hlt;
        jmp idle_loop
    }
  }

  // ============================================================================
  // R15-M7-001 (#562): idle_init — bootstrap the idle task
  // ============================================================================

  pub let idle_init : () -> () !{mem, sysreg} @{boot} = fn () -> unsafe {
    effects: { mem, sysreg },
    capabilities: { boot },
    justification: "R15-M7-001 (#562) + R18-M4-004 (#774): idle-task bootstrap. Called once from kernel_main, before any code path that can invoke sched_pick_next. Sequence: (1) publish _idle_tcb = &_idle_task_slot. (2) Populate the two fields sched_switch (#564) will read: regs_save.rsp = _idle_kernel_stack + 4096 (top-of-stack for pre-decrement push semantics), regs_save.rip = &idle_code. (3) Set state = STATE_RUNNABLE (u32 at +8) — idle is always eligible. (4) [#774] Publish CB[PERCPU_OFF_IDLE_TCB] = &_idle_task_slot on the calling CPU so sched_pick_next_r15's empty-runq fallback reads THIS CPU's idle from GS (rather than the module-global _idle_tcb which is BSP-only under SMP). Precondition: gs_base_init_bsp has programmed IA32_GS_BASE for the BSP (kernel_main.pdx L1892 well before this call at L7189). Symmetric AP-side wire-in lives in ap_bringup.pdx.ap_sched_init. Uses the same rdmsr IA32_GS_BASE + [rax+80] store idiom as runq_init / _ipi_handler_f1. Leave every other field at .bss zero: pid=0 (sentinel — idle has no PID visible to sys_wait, sys_fork, or pid_alloc), parent_pid=0, exit_status=0, user_pml4_pa=0 (idle uses whatever CR3 is loaded when picked — kernel higher-half addresses are always mapped), kernel_stack=0 (deferred; #564 reads regs_save.rsp not kernel_stack). Register discipline: rax/rcx/rdx/rdi (all caller-save per SysV) — rdi holds the idle-slot VA across rdmsr's rax/rdx clobber. Idempotent: safe to call multiple times. Effects: {mem} for the CB and idle-slot writes, {sysreg} for rdmsr.",
    block: {
      // (1) Publish _idle_tcb.
      lea rax, [rip + _idle_task_slot];
      lea rcx, [rip + _idle_tcb];
      mov [rcx], rax;

      // (2) regs_save.rsp = &_idle_kernel_stack + 4096 (top-of-stack).
      //     Stack grows down; the "top" is the highest addressable u64.
      //     _idle_kernel_stack is 512 u64s = 4096 bytes; top = base + 4096.
      lea rcx, [rip + _idle_kernel_stack];
      add rcx, 4096;
      mov [rax + 32], rcx;                 // regs_save.rsp @ +32

      // (3) regs_save.rip = &idle_code.
      lea rcx, [rip + idle_code];
      mov [rax + 40], rcx;                 // regs_save.rip @ +40

      // (4) state = STATE_RUNNABLE (1).
      mov ecx, 1;
      mov [rax + 8], ecx;                  // state @ +8 (u32)

      // ============================================================
      // #774 R18-M4-004: publish CB[PERCPU_OFF_IDLE_TCB] = &_idle_task_slot
      // on the calling CPU (BSP here — AP-side twin is in ap_bringup.pdx).
      // sched_pick_next_r15's empty-runq fallback now reads [gs:80]
      // instead of [rip + _idle_tcb] so each CPU gets its own idle when
      // its runqueue is empty.
      // ============================================================
      mov rdi, rax;                        // rdi = &_idle_task_slot (save across rdmsr)
      mov rcx, 0xC0000101;                 // IA32_GS_BASE
      rdmsr;
      shl rdx, 32;
      or  rax, rdx;                        // rax = CB VA (this CPU)
      mov [rax + 80], rdi;                 // CB.idle_tcb = &_idle_task_slot

      ret
    }
  }
}
