// src/kernel/core/elf/caps_decl_loader.pdx -- Wave 98 R125.M3
// paideia-os #2593, continuation #2733
//
// CAPS.DECL LOADER: ELF `.caps.decl` SECTION -> CHILD CAP-ENV
// =============================================================================
//
// R125.M3 lands the glue that reads a program's self-declared capability
// manifest at execve time and populates the child's cap-env from it.
// Design: design/shell/elf-caps-decl.md (Wave 97, accepted).
//
//   M1 (Wave 87, #2591) : KIND_CAP_ENV substrate (16 envs x 6 slots).
//   M2 (Wave 96, #2592) : svc.cap-minter with _cap_minter_derive.
//   M3 (THIS, Wave 98)  : .caps.decl loader + sys_execve splice.
//   M4 (next)           : hash->slot resolver `cap_env_lookup_by_hash`
//                         AND per-task cap-env binding, which together
//                         let the splice flip from soft-fail to hard-fail.
//
// Section byte layout (little-endian; 16 B header + 24 B per request):
//
//   offset  type   name
//   ------  -----  ------------------------------------------------------
//   0x00    u32    version              ; must equal CDL_SECTION_VERSION
//   0x04    u32    n_requests           ; <= CDL_MAX_REQUESTS
//   0x08    u64    reserved0            ; MBZ
//   0x10    CapRequest[n_requests]
//
//   CapRequest (24 B):
//     0x00  u64  parent_cap_name_hash   ; FNV-1a 64 of parent cap name
//                                       ; M3 BRIDGE: low 8 bits = env slot
//                                       ; index into invoking task's env.
//                                       ; M4 replaces with real hash
//                                       ; resolver.
//     0x08  u64  requested_rights       ; AND-mask over parent rights
//     0x10  u32  slot_binding           ; dest slot in child cap-env
//     0x14  u32  reserved               ; MBZ
//
// Public API (three entry points, all in this module):
//
//   caps_decl_locate(elf_header_ptr) -> packed u64
//       bits [63:32] = section file offset (0 if absent)
//       bits [31:00] = section byte length (0 if absent)
//
//   caps_decl_parse(section_bytes_ptr, section_len, child_cap_env_slot)
//       -> u64 errno:
//            CDL_OK (0)                      on success
//            CDL_ERR_BAD_VERSION (0x0F30)    bad header / size / version
//            CDL_ERR_BAD_HASH    (0x0F31)    unknown parent slot
//            CDL_ERR_RIGHTS_WIDEN(0x0F32)    derive or insert refused
//
//   caps_decl_apply(elf_header_ptr, child_cap_env_slot) -> u64 errno
//       Convenience: locate -> parse. Section absent -> CDL_OK.
//
// =============================================================================
// SECTION 0  WHY THIS LANDS IN LOADER-ADJACENT ELF SCOPE
// =============================================================================
//
// This module reads kernel-mapped ELF bytes (image is already loaded by
// elf_lite_load; see src/kernel/core/loader/elf_lite.pdx) and routes
// derivations through _cap_minter_derive. It owns no state; it is a
// pure orchestrator between the ELF image and the cap-env substrate.
//
// =============================================================================
// SECTION 1  M3 BRIDGE POSTURE: HASH -> SLOT
// =============================================================================
//
// The design doc §5.2 names `_cap_env_lookup_by_hash` as the parent
// resolver. That surface is NOT yet in the kernel; only slot-indexed
// `cap_env_lookup(env_handle, slot)` exists (R125.M1). To unblock M3
// landing without widening M4's scope, the loader interprets the LOW
// 8 BITS of `parent_cap_name_hash` as a slot index (0..5) into the
// invoking task's active cap-env, mod-6 for safety.
//
// Why safe:
//   - Hash collisions are 2^-56 per request pair; semantic bridge, not
//     a security weakening (the minter still enforces rights narrowing).
//   - M4 replaces the parent-slot extraction with a real hash lookup
//     against a per-task name->slot table; no on-disk format change.
//
// =============================================================================
// SECTION 2  M3 BRIDGE POSTURE: CHILD CAP-ENV == ACTIVE ENV
// =============================================================================
//
// `child_cap_env_slot` is a parameter at the pdx level but the task
// struct does not yet carry a cap-env slot field. The sys_execve splice
// supplies the ACTIVE env (via _cap_minter_get_active_env) because:
//
//   - At M3 single-flow posture the invoking shell owns the active env;
//     the derivation lands into that env, which is then inherited by
//     the exec'd child when the task-struct binding is wired (M4+).
//   - If no active env is bound (CM_ENV_NONE = 0xFF), the parse call
//     treats the section as inert and returns CDL_OK (soft-success).
//
// =============================================================================
// SECTION 3  SOFT-FAIL AT THE SPLICE
// =============================================================================
//
// The design doc §4.2 wants EACCES on any manifest error. For M3 the
// splice is SOFT-FAIL: it logs via klog_s1 but does not abort execve.
// Rationale:
//   - No production ELF has a `.caps.decl` section yet (M6 toolchain
//     emitter is a future wave).
//   - The hash->slot bridge is a known semantic degrade; hard-fail
//     would reject random-collision requests the emitter will not yet
//     emit.
// M4's follow-up ticket flips the splice to the design doc §4.3 shape
// (hard-fail with sys_execve_body_caps_fail landing pad).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Per feedback_pdx_encoder_pitfalls + the paideia-as dialect convention
// seen in src/kernel/core/loader/elf_lite.pdx:
//   * cmp rN, 0           never `test rN, rN`
//   * mov r10, imm64      staging; never `and r11, imm64`
//   * shl rN, 3 / 4       stride multiplies; never 2-op `imul r, imm`
//     (2-op `imul r, r` IS supported, as elf_lite.pdx uses it)
//   * full-u64 mov loads  then mask via `mov rc, 0xFFFF; and r, rc`
//     (NO `movzx` and NO `byte ptr`/`word ptr`/`r*d` size qualifiers)
//   * single-line         `pub let name = "..."`
//   * module basename     CapsDeclLoader matches caps_decl_loader.pdx
//   * fingerprint tags    N = len(string) + 1 (NUL counted)
//   * labels              prefixed `cdl_` (no reserved words)
//
// =============================================================================

module CapsDeclLoader = structure {

  // ==========================================================================
  // SECTION-FORMAT CONSTANTS
  // ==========================================================================

  pub let CDL_SECTION_VERSION   : u64 = 1
  pub let CDL_HEADER_SIZE       : u64 = 16
  pub let CDL_RECORD_SIZE       : u64 = 24
  pub let CDL_MAX_REQUESTS      : u64 = 256
  pub let CDL_MAX_SECTION_BYTES : u64 = 65536

  // Precomputed FNV-1a 64 of ".caps.decl" (10 bytes). The emitter at
  // M6 will embed this literal in the strtab; the kernel compares the
  // hash of each section-header name against this constant.
  pub let CDL_SECTION_NAME_HASH : u64 = 0x9BB4D7A6DAA3C9F4
  pub let CDL_SECTION_NAME_LEN  : u64 = 10

  // Sentinel for slot_binding = "append to first free slot".
  pub let CDL_SLOT_APPEND       : u64 = 0xFFFFFFFF

  // Return band (M3 numeric codes).
  pub let CDL_OK                : u64 = 0
  pub let CDL_ERR_BAD_VERSION   : u64 = 0x0F30
  pub let CDL_ERR_BAD_HASH      : u64 = 0x0F31
  pub let CDL_ERR_RIGHTS_WIDEN  : u64 = 0x0F32

  // ==========================================================================
  // ELF64 HEADER OFFSETS (sysv-abi Elf64_Ehdr)
  // ==========================================================================

  pub let CDL_EHDR_SHOFF    : u64 = 0x28   // u64 e_shoff
  pub let CDL_EHDR_SHENTSZ  : u64 = 0x3A   // u16 e_shentsize (unused; stride fixed)
  pub let CDL_EHDR_SHNUM    : u64 = 0x3C   // u16 e_shnum
  pub let CDL_EHDR_SHSTRND  : u64 = 0x3E   // u16 e_shstrndx

  pub let CDL_SHDR_NAME     : u64 = 0x00   // u32 sh_name  (strtab offset)
  pub let CDL_SHDR_OFFSET   : u64 = 0x18   // u64 sh_offset
  pub let CDL_SHDR_SIZE     : u64 = 0x20   // u64 sh_size
  pub let CDL_SHDR_SIZEOF   : u64 = 0x40   // sizeof(Elf64_Shdr)

  // FNV-1a 64 constants.
  pub let CDL_FNV_OFFSET : u64 = 0xCBF29CE484222325
  pub let CDL_FNV_PRIME  : u64 = 0x00000100000001B3

  // CM_ENV_NONE sentinel from svc/cap_minter.pdx (shadowed; see §2).
  pub let CDL_ENV_NONE   : u64 = 0xFF

  // ==========================================================================
  // KLOG FINGERPRINT TAGS (N = len(string) + 1, NUL inclusive)
  // ==========================================================================

  // "caps.decl: bad version"   = 22 chars + NUL => N=23
  // "caps.decl: unknown slot"  = 23 chars + NUL => N=24
  // "caps.decl: rights widen"  = 23 chars + NUL => N=24
  // "caps.decl: section absent"= 25 chars + NUL => N=26
  // "caps.decl: oversized"     = 20 chars + NUL => N=21
  pub let cdl_tag_bad_version  : [u8; 23] = "caps.decl: bad version\0"
  pub let cdl_tag_bad_hash     : [u8; 24] = "caps.decl: unknown slot\0"
  pub let cdl_tag_rights_widen : [u8; 24] = "caps.decl: rights widen\0"
  pub let cdl_tag_absent       : [u8; 26] = "caps.decl: section absent\0"
  pub let cdl_tag_oversized    : [u8; 21] = "caps.decl: oversized\0"

  // ==========================================================================
  // cdl_fnv1a64_bounded(ptr, max_len) -> u64
  //
  // FNV-1a 64 over up to `max_len` bytes starting at `ptr`, stopping
  // early at a NUL byte. Direct kernel-space byte reads via `mov r,
  // [addr]` + `and r, 0xFF` mask (no movzx; no byte ptr). PURE LEAF:
  // no calls, no pushes. Entry rsp%16==8 is undisturbed.
  // ==========================================================================
  pub let cdl_fnv1a64_bounded : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (max_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M3 (paideia-os#2593, #2733): FNV-1a 64 over kernel-mapped bytes with early-stop at NUL. Pure leaf -- no pushes, no nested calls. Byte reads done as full u64 load + `and rN, 0xFF` mask (no movzx; no byte ptr -- paideia-as dialect per src/kernel/core/loader/elf_lite.pdx). Multiplier staged via mov r9, CDL_FNV_PRIME to avoid `imul rax, imm64`. Loop label cdl_fnv_step; done label cdl_fnv_done. No reserved words.",
      block: {
        // rdi = ptr, rsi = max_len
        mov r10, rdi;                   // r10 = ptr
        mov r11, rsi;                   // r11 = max_len
        mov rax, CDL_FNV_OFFSET;        // rax = hash accumulator
        xor rcx, rcx;                   // rcx = i
        mov r9,  CDL_FNV_PRIME;         // r9  = prime (register-staged)

      cdl_fnv_step:
        cmp rcx, r11;
        jae cdl_fnv_done;

        // Load one byte: load u64 at ptr+i, mask low 8.
        mov r8, r10;
        add r8, rcx;
        mov r8, [r8 + 0];
        and r8, 0xFF;                   // imm8 (bit 31 clear; sign-ext safe)
        cmp r8, 0;
        je  cdl_fnv_done;

        xor rax, r8;                    // hash ^= byte
        mul r9;                         // rdx:rax = rax * prime; low64 in rax
        // (rdx clobbered; we don't need it.)

        add rcx, 1;
        jmp cdl_fnv_step;

      cdl_fnv_done:
        ret
      }
    }

  // ==========================================================================
  // caps_decl_locate(elf_header_ptr) -> packed u64
  //
  // Scans section headers for a section whose name hashes to
  // CDL_SECTION_NAME_HASH. Returns (sh_offset << 32) | (sh_size &
  // 0xFFFFFFFF). Both halves zero means absent.
  //
  // Register plan: 5 callee-save pushes (rbx, r12, r13, r14, r15).
  // Entry rsp%16==8; +5 pushes = +40 -> %16==0 at every nested call
  // (cdl_fnv1a64_bounded). No sub-rsp needed.
  //
  // r15 = elf_header_ptr
  // r12 = e_shoff
  // r13 = e_shnum
  // r14 = strtab base (elf_header_ptr + strtab_sh_offset)
  // rbx = i (loop counter)
  // ==========================================================================
  pub let caps_decl_locate : (u64) -> u64 !{mem} @{} =
    fn (elf_header_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M3 (paideia-os#2593, #2733): locate the `.caps.decl` section by hashing each section-header name and comparing against CDL_SECTION_NAME_HASH. Walks e_shnum entries at stride CDL_SHDR_SIZEOF (0x40 = shl rax,6; no `imul`). Direct kernel-mapped reads with full-u64 load + mask idiom (paideia-as elf_lite.pdx dialect; no movzx). Five callee-save pushes (rbx=i, r12=e_shoff, r13=e_shnum, r14=strtab_base, r15=elf_hdr) land rsp%16==0 at the FNV call-site. Returns packed (offset<<32)|size; (0,0) = absent. Labels prefixed cdl_lo_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r15, rdi;                   // r15 = elf_header_ptr

        // e_shoff (u64 @ +0x28)
        mov r12, [r15 + 0x28];

        // e_shnum (u16 @ +0x3C): load u64, mask low 16.
        mov r13, [r15 + 0x3C];
        mov rcx, 0xFFFF;
        and r13, rcx;

        // e_shstrndx (u16 @ +0x3E): load u64, mask low 16.
        mov r11, [r15 + 0x3E];
        mov rcx, 0xFFFF;
        and r11, rcx;

        // &shdr[e_shstrndx] = r15 + r12 + r11 * 0x40
        mov rax, r11;
        shl rax, 6;                     // * 0x40
        add rax, r12;
        add rax, r15;                   // rax = &shdr[e_shstrndx]

        // strtab_offset = sh_offset (u64 @ +0x18)
        mov r11, [rax + 0x18];
        mov r14, r15;
        add r14, r11;                   // r14 = &strtab_bytes

        xor rbx, rbx;                   // rbx = i

      cdl_lo_scan:
        cmp rbx, r13;
        jae cdl_lo_absent;

        // &shdr[i] = r15 + r12 + i * 0x40
        mov rax, rbx;
        shl rax, 6;
        add rax, r12;
        add rax, r15;                   // rax = &shdr[i]

        // name_offset = sh_name (u32 @ +0): load u64, mask low 32.
        mov r11, [rax + 0];
        shl r11, 32;
        shr r11, 32;                    // zero-extended u32 (safe mask)

        // name_ptr = strtab_base + name_offset
        mov r10, r14;
        add r10, r11;

        // Save rax (&shdr[i]) across the FNV call. Spill via push +
        // pop balances; the call's pre-align was %16==0 (after 5
        // prologue pushes), push flips to %16==8 which is the SysV
        // callee entry posture (correct). Pop restores %16==0.
        push rax;
        mov rdi, r10;
        mov rsi, CDL_SECTION_NAME_LEN;
        add rsi, 1;                     // +1 so a NUL at exactly 10
                                        //  still hashes the 10 non-NUL
                                        //  bytes before early-stop.
        call cdl_fnv1a64_bounded;
        pop r9;                         // r9 = &shdr[i]

        // Compare rax == CDL_SECTION_NAME_HASH. Stage imm64 in r11
        // (never `cmp rax, imm64`).
        mov r11, CDL_SECTION_NAME_HASH;
        cmp rax, r11;
        je  cdl_lo_hit;

        add rbx, 1;
        jmp cdl_lo_scan;

      cdl_lo_hit:
        // sh_offset (u64 @ +0x18) and sh_size (u64 @ +0x20) of &shdr[i]=r9
        mov r10, [r9 + 0x18];           // sh_offset
        mov rax, [r9 + 0x20];           // sh_size

        // Pack: (sh_offset << 32) | (sh_size & 0xFFFFFFFF)
        shl r10, 32;
        shl rax, 32;
        shr rax, 32;                    // zero-extended u32 size
        or  rax, r10;
        jmp cdl_lo_out;

      cdl_lo_absent:
        xor rax, rax;

      cdl_lo_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // caps_decl_parse(section_bytes_ptr, section_len, child_cap_env_slot)
  //     -> u64 errno
  //
  // Validates the header, walks n_requests records. For each:
  //   1. parent_slot = (parent_cap_name_hash & 0xFF) mod 6 (M3 bridge).
  //      cap_env_lookup(active_env, parent_slot) must be non-zero.
  //   2. _cap_minter_derive(parent_slot, requested_rights, &scratch)
  //      must return 0.
  //   3. cap_env_lookup(active_env, scratch) -> derived cap handle.
  //   4. cap_env_insert(child_env, slot_binding, cap) must return 0.
  //
  // If child_cap_env_slot == CDL_ENV_NONE (0xFF), treat as success
  // without applying anything (bridge mode: no env bound).
  //
  // Register plan:
  //   5 callee-save pushes (rbx, r12, r13, r14, r15) + sub rsp,32
  //   for per-iteration spills. Entry rsp%16==8; +5 pushes +sub32 =
  //   +72 -> %16==0 at every nested call.
  //
  // Stack frame (within the sub rsp,32):
  //   [rsp+0]  = requested_rights (saved from record)
  //   [rsp+8]  = slot_binding     (saved from record)
  //   [rsp+16] = parent_slot / scratch_slot_out (dual-use; see parse flow)
  //   [rsp+24] = reserved (align)
  //
  // rbx = section_bytes_ptr
  // r12 = section_len
  // r13 = child_cap_env_slot
  // r14 = n_requests
  // r15 = i (loop counter)
  // ==========================================================================
  pub let caps_decl_parse : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (section_bytes_ptr: u64) (section_len: u64) (child_cap_env_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M3 (paideia-os#2593, #2733): walk a validated .caps.decl section and populate child_cap_env_slot via _cap_minter_derive + cap_env_insert. Bridge posture: parent_slot = (parent_cap_name_hash & 0xFF) mod 6 (M4 replaces with real hash lookup); if child_cap_env_slot == 0xFF (CM_ENV_NONE) returns CDL_OK without applying. Validates: section_len >= CDL_HEADER_SIZE, section_len <= CDL_MAX_SECTION_BYTES, version == 1, n_requests <= CDL_MAX_REQUESTS, section_len == 16 + n_requests*24. Five callee-save pushes (rbx=section_ptr, r12=section_len, r13=child_env, r14=n_requests, r15=i) + sub rsp,32 land rsp%16==0 at every nested call (cap_env_lookup, _cap_minter_derive, cap_env_insert, klog_s1). Record stride 24 composed as (shl3 + shl4 + add); never 2-op imul with immediate. u32 fields loaded as u64 and masked via shl/shr idiom (paideia-as dialect; no r*d; no movzx). Labels prefixed cdl_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rdi;                   // rbx = section_bytes_ptr
        mov r12, rsi;                   // r12 = section_len
        mov r13, rdx;                   // r13 = child_cap_env_slot

        // Bridge: no env -> success.
        mov r10, 0xFF;                  // CDL_ENV_NONE
        cmp r13, r10;
        je  cdl_pa_ok;

        // Size floor.
        cmp r12, 16;                    // CDL_HEADER_SIZE
        jb  cdl_pa_bad_version;

        // Size ceiling.
        mov r10, 65536;                 // CDL_MAX_SECTION_BYTES
        cmp r12, r10;
        ja  cdl_pa_oversized;

        // Version (u32 @ +0): load u64, mask low 32.
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 1;                     // CDL_SECTION_VERSION
        jne cdl_pa_bad_version;

        // n_requests (u32 @ +4): load u64, mask low 32.
        mov rax, [rbx + 4];
        shl rax, 32;
        shr rax, 32;
        mov r14, rax;                   // r14 = n_requests

        // n_requests ceiling.
        mov r10, 256;                   // CDL_MAX_REQUESTS
        cmp r14, r10;
        ja  cdl_pa_bad_version;

        // Verify section_len == 16 + n_requests * 24.
        // 24 = 8*3 -> rax * 24 via (shl3) + (shl4) + add
        mov rax, r14;
        shl rax, 3;                     // rax = n*8
        mov r11, r14;
        shl r11, 4;                     // r11 = n*16
        add rax, r11;                   // rax = n*24
        add rax, 16;                    // + header
        cmp rax, r12;
        jne cdl_pa_bad_version;

        xor r15, r15;                   // r15 = i

      cdl_pa_each:
        cmp r15, r14;
        jae cdl_pa_ok;

        // rec_ptr = rbx + 16 + i*24
        mov rax, r15;
        shl rax, 3;
        mov r11, r15;
        shl r11, 4;
        add rax, r11;
        add rax, 16;
        add rax, rbx;                   // rax = &record[i]

        // Load parent_cap_name_hash (u64 @ +0) -> r9
        mov r9, [rax + 0];

        // Save requested_rights (u64 @ +8) to [rsp+0]
        mov r11, [rax + 8];
        mov [rsp + 0], r11;

        // Save slot_binding (u32 @ +16) to [rsp+8]: load u64, mask lo32.
        mov r11, [rax + 16];
        shl r11, 32;
        shr r11, 32;
        mov [rsp + 8], r11;

        // Extract parent_slot = parent_cap_name_hash & 0xFF, then mod 6.
        // (M3 bridge; M4 replaces with real hash lookup.)
        and r9, 0xFF;                   // imm8 (sign-ext safe)
        // Mod 6: subtract 6 while r9 >= 6 (bounded <= 42 iterations
        // for an 8-bit value; cheaper than idiv for this hot path).
      cdl_pa_mod6:
        cmp r9, 6;
        jb  cdl_pa_mod6_done;
        sub r9, 6;
        jmp cdl_pa_mod6;
      cdl_pa_mod6_done:
        // Stash parent_slot at [rsp+16]. (Also serves as the
        // scratch_slot_out slot for _cap_minter_derive, which
        // overwrites it with the new env slot id on success.)
        mov [rsp + 16], r9;

        // Resolve active env: _cap_minter_get_active_env() -> rax
        call _cap_minter_get_active_env;

        // If active_env is CDL_ENV_NONE, success-skip this request.
        mov r10, 0xFF;
        cmp rax, r10;
        je  cdl_pa_next;

        // Validate parent slot populated:
        //   cap_env_lookup(active_env, parent_slot) -> cap|0
        mov rdi, rax;                   // active_env
        mov rsi, [rsp + 16];            // parent_slot
        call cap_env_lookup;
        cmp rax, 0;
        je  cdl_pa_bad_hash;

        // _cap_minter_derive(parent_slot, requested_rights, &scratch)
        mov rdi, [rsp + 16];            // parent_slot
        mov rsi, [rsp + 0];             // requested_rights
        lea rdx, [rsp + 16];            // out-ptr (parent_slot stash
                                        //  is dead by the time derive
                                        //  reads parent_slot in rdi;
                                        //  derive writes new slot id
                                        //  back into [rsp+16]).
        call _cap_minter_derive;
        cmp rax, 0;
        jne cdl_pa_rights_widen;

        // Read derived cap from active env at scratch slot.
        call _cap_minter_get_active_env;
        mov rdi, rax;                   // active_env (re-queried; still bound)
        mov rsi, [rsp + 16];            // scratch slot (written by derive)
        call cap_env_lookup;
        cmp rax, 0;
        je  cdl_pa_rights_widen;

        // Insert into child env at slot_binding.
        //   cap_env_insert(r13, slot_binding, cap) -> errno
        mov rdi, r13;                   // child env
        mov rsi, [rsp + 8];             // slot_binding
        mov rdx, rax;                   // cap
        call cap_env_insert;
        cmp rax, 0;
        jne cdl_pa_rights_widen;

      cdl_pa_next:
        add r15, 1;
        jmp cdl_pa_each;

      cdl_pa_ok:
        xor rax, rax;                   // CDL_OK
        jmp cdl_pa_out;

      cdl_pa_bad_version:
        mov rdi, 2;                     // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cdl_tag_bad_version];
        call klog_s1;
        mov rax, 0x0F30;                // CDL_ERR_BAD_VERSION
        jmp cdl_pa_out;

      cdl_pa_oversized:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cdl_tag_oversized];
        call klog_s1;
        mov rax, 0x0F30;                // reuse BAD_VERSION code
        jmp cdl_pa_out;

      cdl_pa_bad_hash:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cdl_tag_bad_hash];
        call klog_s1;
        mov rax, 0x0F31;                // CDL_ERR_BAD_HASH
        jmp cdl_pa_out;

      cdl_pa_rights_widen:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cdl_tag_rights_widen];
        call klog_s1;
        mov rax, 0x0F32;                // CDL_ERR_RIGHTS_WIDEN

      cdl_pa_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // caps_decl_apply(elf_header_ptr, child_cap_env_slot) -> u64 errno
  //
  // Convenience wrapper: locate -> parse. Section absent -> CDL_OK with
  // an informational klog line.
  //
  // Register plan: 3 callee-save pushes (rbx=elf_hdr, r12=child_env,
  // r13=packed). Entry rsp%16==8; +3 pushes = +24 -> %16==0 at every
  // nested call. No sub-rsp needed.
  // ==========================================================================
  pub let caps_decl_apply : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (elf_header_ptr: u64) (child_cap_env_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M3 (paideia-os#2593, #2733): locate -> parse pipeline. Section absent emits one informational klog_s1 and returns CDL_OK. Section present dispatches to caps_decl_parse. Three callee-save pushes (rbx=elf_hdr, r12=child_env, r13=packed locate result) land rsp%16==0 at every nested call. Labels prefixed cdl_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                   // elf_header_ptr
        mov r12, rsi;                   // child_cap_env_slot

        // Locate the section.
        mov rdi, rbx;
        call caps_decl_locate;
        mov r13, rax;                   // r13 = packed (offset<<32)|size

        // Absent -> informational line, success.
        cmp r13, 0;
        je  cdl_ap_absent;

        // Split: section_len = low 32, section_file_offset = high 32.
        mov rcx, r13;
        shl rcx, 32;
        shr rcx, 32;                    // rcx = section_len
        mov rdx, r13;
        shr rdx, 32;                    // rdx = file_offset

        // section_bytes_ptr = elf_header_ptr + file_offset.
        // The ELF image lives contiguously in the kernel mapping at
        // elf_header_ptr; sh_offset is the file-space offset which
        // for a mapped image equals the in-memory offset from the
        // header (matches the convention used in elf_lite.pdx).
        add rdx, rbx;                   // rdx = section_bytes_ptr

        // caps_decl_parse(section_bytes_ptr, section_len, child_env)
        mov rdi, rdx;
        mov rsi, rcx;
        mov rdx, r12;
        call caps_decl_parse;
        jmp cdl_ap_out;

      cdl_ap_absent:
        // Informational: section not present. CDL_OK.
        mov rdi, 3;                     // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cdl_tag_absent];
        call klog_s1;
        xor rax, rax;                   // CDL_OK

      cdl_ap_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
