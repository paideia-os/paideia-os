// src/kernel/core/audit/audit_schema.pdx — R40.M5-001 (#1363)
//
// The CANONICAL audit-event ROW SHAPE + a small set of packers and
// validators that discharge it.  This module is the R29-R40 audit
// unification: every KIND_*_channel that today emits audit-adjacent
// events through core/driver/audit_channel.pdx (drv_audit_emit) SHOULD
// pack its (actor, target, payload) tuple through the helpers defined
// here rather than choosing its own bit layout in the ring's `principal`
// field.  When a caller uses aud_pack_at + aud_pack_payload + audit_emit
// two different subsystems can be decoded by the same reader without
// the reader needing to know which subsystem produced the record.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the CANONICAL SCHEMA of the audit event row.  Same posture as
// regdomain_channel.pdx and backlight_channel.pdx: schema + pack/unpack
// primitives, plus one thin wrapper (audit_emit) that forwards to the
// existing seal-chained ring in core/driver/audit_channel.pdx.  No ring
// lives here, no seal chain, no cap_table read; the underlying ring is
// still audit_channel's _drv_audit_ring, and the seal + gap discipline
// documented in that file's §4 remains the authoritative property.
//
// The schema exists as CODE (rather than as a document only) for the
// reason every schema in this tree does: a subscriber that unpacks a
// field the packer never produced silently reads a value from the wrong
// bit range, and the wrong bit range for an actor slot is an audit
// record that blames a different process.  tools/build.sh confines the
// pack/unpack signatures so a fifth parameter cannot smuggle a caller-
// supplied ceiling.
//
// =============================================================================
// §1  CANONICAL ROW SHAPE
// =============================================================================
//
// The unified row has NINE conceptual fields:
//
//   [0]  timestamp     u64   monotonic tick (TSC on x86_64), carried as
//                            field 6 of drv_audit_channel's record
//   [1]  cap_kind      u64   the KIND_* derived-kind tag (0x140..0x181),
//                            or 0 for non-capability events (handoff,
//                            restart, ec_xact, sof, dma_consent, wifi
//                            supplicant, bt_pairing, mbim)
//   [2]  cap_slot      u64   cap_table slot for capability events;
//                            driver_table slot for handoff/restart;
//                            subsystem-defined subject for the other
//                            events -- carried as field 3 (subject) of
//                            drv_audit_channel's record
//   [3]  event_type    u64   one of AUD_EV_* below -- carried as field 1
//                            (event) of drv_audit_channel's record
//   [4]  actor_slot    u16   the process/session doing the action
//   [5]  target_slot   u16   the process/session being acted upon
//   [6]  result_code   u64   0 on success, else the primitive's verbatim
//                            error code -- carried as field 5 (outcome)
//                            of drv_audit_channel's record
//   [7]  payload_lo    u64   32 low bits of an extended payload
//   [8]  payload_hi    u64   32 high bits (reserved for future widening)
//
// Fields [4], [5], [7], [8] together compose the 128-bit "principal +
// payload" run.  The current underlying ring carries a SINGLE u64 in
// its `principal` field (drv_audit_channel field 4).  The audit_emit
// helper packs (actor, target, payload_lo) into that qword per §2:
//
//   principal[63:48]  actor_slot   (16-bit)
//   principal[47:32]  target_slot  (16-bit)
//   principal[31: 0]  payload_lo   (32-bit)
//
// payload_hi is DEFERRED.  A later round will widen the ring's record
// (or attach a side-band) to carry the full 16-byte payload; until then
// audit_emit accepts payload_hi and discards it, and the schema
// documents which callers today need the full width -- see §5.  A
// caller that needs the full 16 bytes RIGHT NOW must use drv_audit_emit
// directly and encode its own layout, which is exactly what the
// unification argument asks such a caller to STOP doing without also
// removing the wire the caller depends on.
//
// =============================================================================
// §2  PACKING
// =============================================================================
//
// aud_pack_at(actor, target) -> u64
//   [31:16]  actor    (u16 -- LOW 16 bits masked)
//   [15: 0]  target   (u16 -- LOW 16 bits masked)
//   Higher bits ZERO.  Overflow refused via masking rather than truncation
//   sentinels: the ring's principal field is one qword, and a caller that
//   passes an actor id above 2^16 is packing an id the current 16-slot
//   process table cannot express in the first place.  When the process
//   table grows, THIS PACKER changes and audit_emit's principal layout
//   changes with it -- one place, one edit.
//
// aud_pack_payload(lo, hi) -> u64
//   [31: 0]  lo       (LOW 32 bits masked)
//   [63:32]  hi discarded for the current ring; carried in a future
//            side-band without changing this packer's arity.
//
// The unpackers return zero-extended values, so a caller that reads a
// field it never packed reads zero rather than junk.
//
// =============================================================================
// §3  EVENT-TYPE UNION
// =============================================================================
//
// The union mirrors driver/audit_channel.pdx's DRV_AUDIT_EV_* namespace
// so the event bytes on the wire keep their meaning across the rename.
// Each event carries CAP_KIND == 0 unless it is a mint/revoke of a
// derived kind:
//
//   AUD_EV_MINT      = 1  capability minted
//   AUD_EV_REVOKE    = 2  capability revoked
//   AUD_EV_HANDOFF   = 3  driver process handoff (kind = 0)
//   AUD_EV_RESTART   = 4  driver node restarted (kind = 0)
//   AUD_EV_ESCALATE  = 5  driver node escalated to perm-failed (kind = 0)
//   AUD_EV_CHANDEAD  = 6  channel torn down on restart (kind = 0)
//   AUD_EV_EC_XACT   = 7  R31 embedded-controller transaction
//   AUD_EV_SOF       = 8  R33 SOF-derived audio timeline event
//   AUD_EV_DMA_CNSNT = 9  R35 DMA consent grant/refuse
//   AUD_EV_WPA_STEP  = 10 R38 WiFi WPA supplicant step
//   AUD_EV_BT_PAIR   = 11 R39 BT LE SC pairing step
//   AUD_EV_MBIM      = 12 R40 MBIM control/session step
//
// aud_ev_valid(e) -> 1 iff e in [1..12].
// aud_ev_is_cap(e) -> 1 iff e in {MINT, REVOKE}.
//
// A caller that wants to add a new event type MUST extend the union
// here first, so a subscriber that has not yet learned the new value
// gets a validator refusal (AUD_ERR_BAD_EVT) rather than a silent
// misclassification.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF180..0xFFFFF18F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band -- adjacent used band above: mbim 0xFFFFF190..9F;
// adjacent free band below: unassigned 0xFFFFF170..7F (reserved for
// R41).  The band matches the schema's own refusals (validator + packer
// arg checks); the drv_audit_channel taxonomy at 0xFFFFFFC0..CF stays
// unchanged.
//
//   AUD_OK              = 0
//   AUD_ERR_BAD_EVT     = 0xFFFFF18F   evt outside AUD_EV_* union
//   AUD_ERR_BAD_FIELD   = 0xFFFFF18E   field ordinal > 8
//   AUD_ERR_BAD_ACTOR   = 0xFFFFF18D   actor >= 2^16
//   AUD_ERR_BAD_TARGET  = 0xFFFFF18C   target >= 2^16
//   AUD_ERR_BAD_PAYLOAD = 0xFFFFF18B   payload_lo >= 2^32
//   AUD_ERR_BAD_KIND    = 0xFFFFF18A   cap_kind neither 0 nor in
//                                      [0x140, 0x181]
//
// =============================================================================
// §5  DEFERRED
// =============================================================================
//
// 1. payload_hi is accepted and discarded until a subsequent round widens
//    the ring; no subsystem in the tree today uses payload_hi.
// 2. The subsystems that emit audit-adjacent events (R31 EC, R33 SOF,
//    R35 DMA, R38 WPA, R39 BT pairing, R40 MBIM) still call
//    drv_audit_emit directly with their own principal layout; migrating
//    each to audit_emit is a per-round refactor rather than a single-
//    landing change, and its landing gate is that the corresponding
//    consumer subscribes through this schema's unpackers.  See
//    design/architecture/next-wave-derived-kinds.md §"R40.M5 closure"
//    for the migration table.

module AuditSchema = structure {

  // §1: field ordinals.
  pub let AUD_F_TIMESTAMP   : u64 = 0
  pub let AUD_F_CAP_KIND    : u64 = 1
  pub let AUD_F_CAP_SLOT    : u64 = 2
  pub let AUD_F_EVENT_TYPE  : u64 = 3
  pub let AUD_F_ACTOR_SLOT  : u64 = 4
  pub let AUD_F_TARGET_SLOT : u64 = 5
  pub let AUD_F_RESULT_CODE : u64 = 6
  pub let AUD_F_PAYLOAD_LO  : u64 = 7
  pub let AUD_F_PAYLOAD_HI  : u64 = 8
  pub let AUD_F_MAX         : u64 = 8

  // §3: event union.
  pub let AUD_EV_MIN         : u64 = 1
  pub let AUD_EV_MINT        : u64 = 1
  pub let AUD_EV_REVOKE      : u64 = 2
  pub let AUD_EV_HANDOFF     : u64 = 3
  pub let AUD_EV_RESTART     : u64 = 4
  pub let AUD_EV_ESCALATE    : u64 = 5
  pub let AUD_EV_CHANDEAD    : u64 = 6
  pub let AUD_EV_EC_XACT     : u64 = 7
  pub let AUD_EV_SOF         : u64 = 8
  pub let AUD_EV_DMA_CNSNT   : u64 = 9
  pub let AUD_EV_WPA_STEP    : u64 = 10
  pub let AUD_EV_BT_PAIR     : u64 = 11
  pub let AUD_EV_MBIM        : u64 = 12
  pub let AUD_EV_MAX         : u64 = 12

  // §1: cap_kind acceptable range (0 for non-cap events; 0x140..0x181
  // for derived kinds since R29).
  pub let AUD_KIND_DERIVED_LO : u64 = 0x140
  pub let AUD_KIND_DERIVED_HI : u64 = 0x181

  // §4: failure taxonomy 0xFFFFF180..0xFFFFF18F.
  pub let AUD_OK              : u64 = 0
  pub let AUD_ERR_BAD_EVT     : u64 = 0xFFFFF18F
  pub let AUD_ERR_BAD_FIELD   : u64 = 0xFFFFF18E
  pub let AUD_ERR_BAD_ACTOR   : u64 = 0xFFFFF18D
  pub let AUD_ERR_BAD_TARGET  : u64 = 0xFFFFF18C
  pub let AUD_ERR_BAD_PAYLOAD : u64 = 0xFFFFF18B
  pub let AUD_ERR_BAD_KIND    : u64 = 0xFFFFF18A

  // ==========================================================================
  // aud_ev_valid(evt) -> 1 iff evt in [AUD_EV_MIN .. AUD_EV_MAX].
  // ==========================================================================

  pub let aud_ev_valid : (u64) -> u64 !{} @{} =
    fn (evt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): recognise the AUD_EV_* union. Labels prefixed aud_ev_.",
      block: {
        cmp rdi, 1;
        jb  aud_ev_no;
        cmp rdi, 12;
        ja  aud_ev_no;
        mov rax, 1;
        ret;
      aud_ev_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // aud_ev_is_cap(evt) -> 1 iff evt is MINT (1) or REVOKE (2).
  // Used to decide whether cap_kind is expected to be non-zero.
  // ==========================================================================

  pub let aud_ev_is_cap : (u64) -> u64 !{} @{} =
    fn (evt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): capability-event predicate. Labels prefixed aud_evc_.",
      block: {
        cmp rdi, 1;
        je  aud_evc_yes;
        cmp rdi, 2;
        je  aud_evc_yes;
        xor rax, rax;
        ret;
      aud_evc_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // aud_field_valid(field) -> 1 iff field in [0..8].
  // ==========================================================================

  pub let aud_field_valid : (u64) -> u64 !{} @{} =
    fn (field: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): field ordinal in [0..8]. Labels prefixed aud_fv_.",
      block: {
        cmp rdi, 8;
        ja  aud_fv_no;
        mov rax, 1;
        ret;
      aud_fv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // aud_kind_valid(k) -> 1 iff k == 0 OR k in [0x140..0x188].
  // Non-capability events carry cap_kind == 0; capability events carry
  // a derived-kind tag in the R29..R47/G2 range.  Upper bound bumped
  // from 0x181 to 0x187 (R47.M1-003 #1414) to admit KIND_BT_*
  // (0x182..0x184, R39.M1..M2), KIND_DISPLAY_TIMELINE (0x185, G1.M1),
  // KIND_VRR_RANGE (0x186, G1.M2), KIND_VMD_ENDPOINT (0x187), then
  // 0x187 -> 0x188 (G2.M1-001 #1443) for KIND_SCANOUT_LEASE.  Any new
  // derived kind must reset this bound together with itself so audit
  // continues to accept its events.
  // ==========================================================================

  pub let aud_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363), bumped R47.M1-003 (#1414) and G2.M1-001 (#1443): cap_kind is 0 or a derived-kind tag in [0x140, 0x188]. Labels prefixed aud_kv_.",
      block: {
        cmp rdi, 0;
        je  aud_kv_yes;
        mov r10, 0x140;
        cmp rdi, r10;
        jb  aud_kv_no;
        mov r10, 0x188;
        cmp rdi, r10;
        ja  aud_kv_no;
      aud_kv_yes:
        mov rax, 1;
        ret;
      aud_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // aud_pack_at(actor, target) -> u64
  //   [31:16]  actor  (u16 -- low 16 masked)
  //   [15: 0]  target (u16 -- low 16 masked)
  //
  // §2: no widening -- an id above 2^16 is truncated by the mask, because
  // the current process/session tables cannot express one, and a caller
  // that passes one has already made a different mistake we cannot fix
  // silently here.  The witness asserts round-trip for the boundary case
  // (0xFFFF, 0xFFFF).
  // ==========================================================================

  pub let aud_pack_at : (u64, u64) -> u64 !{} @{} =
    fn (actor: u64, target: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): pack {actor, target} into one u64. Labels prefixed aud_pat_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        shl rax, 16;
        mov r10, rsi;
        and r10, 0xFFFF;
        or  rax, r10;
        ret
      }
    }

  pub let aud_unpack_actor : (u64) -> u64 !{} @{} =
    fn (at: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract actor from packed pair. Labels prefixed aud_ua_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let aud_unpack_target : (u64) -> u64 !{} @{} =
    fn (at: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract target from packed pair. Labels prefixed aud_ut_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    }

  // ==========================================================================
  // aud_pack_payload(lo, hi) -> u64
  //   [31: 0]  lo (LOW 32 bits masked)
  //   [63:32]  0  (hi discarded -- see §5)
  //
  // The signature preserves a slot for `hi` even though the current
  // implementation discards it, so a future widening does not change
  // any call site.
  // ==========================================================================

  pub let aud_pack_payload : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64, hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): pack payload into one u64 (lo half; hi reserved). Labels prefixed aud_pp_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  pub let aud_unpack_payload_lo : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract payload_lo. Labels prefixed aud_upl_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // aud_pack_principal(at, payload_lo) -> u64
  //   [63:48]  at[31:16]  == actor
  //   [47:32]  at[15: 0]  == target
  //   [31: 0]  payload_lo
  //
  // The layout the ring's `principal` field carries when a caller emits
  // through audit_emit.  A subscriber decodes with aud_prin_actor /
  // aud_prin_target / aud_prin_payload_lo.
  // ==========================================================================

  pub let aud_pack_principal : (u64, u64) -> u64 !{} @{} =
    fn (at: u64, payload_lo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): compose the ring's principal field from (actor, target) and payload_lo. Labels prefixed aud_pk_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        shl rax, 32;
        mov r10, rsi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        or  rax, r10;
        ret
      }
    }

  pub let aud_prin_actor : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract actor from principal. Labels prefixed aud_pra_.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let aud_prin_target : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract target from principal. Labels prefixed aud_prt_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFF;
        ret
      }
    }

  pub let aud_prin_payload_lo : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M5-001 (#1363): extract payload_lo from principal. Labels prefixed aud_prp_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // audit_emit(kind, slot, evt, at, result, payload) -> u64
  //
  //   rdi = cap_kind          (0 for non-capability events)
  //   rsi = cap_slot          (cap_table slot / driver_table slot / subject)
  //   rdx = event_type        (AUD_EV_*)
  //   rcx = at                (aud_pack_at(actor, target))
  //   r8  = result_code       (0 on success, else primitive error code)
  //   r9  = payload_lo        (32 bits into ring principal; hi deferred)
  //
  //   -> rax = AUD_OK (0) if the record was emitted, else AUD_ERR_BAD_*
  //            (validated arg refused BEFORE calling drv_audit_emit)
  //
  // Six args -- the task's seventh (payload_hi) is DEFERRED per §5, and
  // aud_pack_payload's arity preserves the slot on the caller side so a
  // widening does not change any call site.  The helper is otherwise the
  // canonical bridge: every KIND_*_channel that emits audit-adjacent
  // events SHOULD reach the ring through here, so that principal decodes
  // uniformly for every subscriber.
  // ==========================================================================

  pub let audit_emit : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (kind: u64, slot: u64, evt: u64, at: u64, result: u64,
        payload_lo: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R40.M5-001 (#1363): canonical audit-event emission. Validates evt/kind/payload bounds, composes principal inline as (at << 32) | (payload_lo & 0xFFFFFFFF), forwards to drv_audit_emit. Five callee-saves (rbx, r12-r15) plus a 16-byte stack scratch: entry rsp%16 == 8, five pushes bring it to 0, `sub rsp, 16` keeps it at 0, which SysV requires at the drv_audit_emit call site. rbx=kind, r12=slot, r13=evt, r14=at (packed actor|target from aud_pack_at), r15=result; the scratch cell [rsp+0] holds payload_lo across the two validator calls because it does not survive them in r9 (caller-save). Refusals are checked BEFORE calling drv_audit_emit so an invalid arg records no record. Labels prefixed aud_em_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                         // scratch [rsp+0] = payload_lo

        // Spill payload_lo (r9) to scratch before any call clobbers it.
        mov [rsp + 0], r9;

        mov rbx, rdi;                        // kind
        mov r12, rsi;                        // slot
        mov r13, rdx;                        // evt
        mov r14, rcx;                        // at (packed actor|target)
        mov r15, r8;                         // result

        // ---- payload_lo bound check (< 2^32) ----
        mov r10, [rsp + 0];
        mov r11, 0xFFFFFFFF;
        cmp r10, r11;
        ja  aud_em_bad_payload;

        // ---- evt validator ----
        mov rdi, r13;
        call aud_ev_valid;
        cmp rax, 1;
        jne aud_em_bad_evt;

        // ---- kind validator (0 or in [0x140, 0x181]) ----
        mov rdi, rbx;
        call aud_kind_valid;
        cmp rax, 1;
        jne aud_em_bad_kind;

        // ---- Compose principal = (at << 32) | (payload_lo & 0xFFFFFFFF) ----
        mov r10, r14;                        // at
        shl r10, 32;
        mov r11, [rsp + 0];                  // payload_lo
        mov r9,  0xFFFFFFFF;
        and r11, r9;
        or  r10, r11;                        // r10 = principal

        // ---- Forward to drv_audit_emit(evt, kind, slot, principal, result) ----
        mov rdi, r13;                        // event
        mov rsi, rbx;                        // kind
        mov rdx, r12;                        // subject = slot
        mov rcx, r10;                        // principal
        mov r8,  r15;                        // outcome = result
        call drv_audit_emit;

        xor rax, rax;                        // AUD_OK
        jmp aud_em_out;

      aud_em_bad_evt:
        mov rax, 0xFFFFF18F;                 // AUD_ERR_BAD_EVT
        jmp aud_em_out;

      aud_em_bad_kind:
        mov rax, 0xFFFFF18A;                 // AUD_ERR_BAD_KIND
        jmp aud_em_out;

      aud_em_bad_payload:
        mov rax, 0xFFFFF18B;                 // AUD_ERR_BAD_PAYLOAD

      aud_em_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
