// src/kernel/core/net/ethernet.pdx — R27-M3-001 (#981)
//
// Ethernet II frame header struct + parse/build helpers.
//
// -----------------------------------------------------------------------------
// Ethernet II frame layout (IEEE 802.3 §3.1.1)
// -----------------------------------------------------------------------------
//
// The Ethernet II framing consumed by the paideia-os L2 substrate is the
// classic 14-byte header:
//
//   +0    u8[6]  dst_mac        destination MAC address (wire order)
//   +6    u8[6]  src_mac        source MAC address (wire order)
//   +12   u16    ethertype      protocol demux (big-endian on the wire)
//
// The header is followed by the payload (46..1500 bytes for classic
// Ethernet; up to 9000 bytes for jumbo frames — R31+). The 4-byte FCS
// (CRC-32) is appended by the NIC on TX (IFCS cmd bit) and stripped
// on RX by the e1000e MAC before the descriptor's `length` field is
// written back, so the L2 layer never observes it.
//
// -----------------------------------------------------------------------------
// Ethertype demux table
// -----------------------------------------------------------------------------
//
//   0x0800  ETH_TYPE_IPV4      IPv4                           (R27.M5)
//   0x0806  ETH_TYPE_ARP       Address Resolution Protocol    (R27.M4)
//   0x86DD  ETH_TYPE_IPV6      IPv6                           (deferred R30+)
//   0x8100  ETH_TYPE_VLAN      802.1Q VLAN-tagged             (deferred R31+)
//
// R27.M3 recognises only the first two; unknown ethertypes fall through
// to a drop-and-count path in l2_rx.pdx.
//
// -----------------------------------------------------------------------------
// Byte-order discipline
// -----------------------------------------------------------------------------
//
// Ethernet is a big-endian wire protocol. paideia-os runs little-endian
// (x86_64), so all multi-byte fields crossing the L2 boundary pass
// through htons/htonl. This module exposes `htons` for the ethertype
// slot; ARP and IPv4 modules extend the family (htonl, ntohs, ntohl)
// as needed at their respective milestones.
//
// -----------------------------------------------------------------------------
// R27.M3 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// eth_parse / eth_build / htons are callable symbols at M3 but are NOT
// wired into kernel_main.pdx. They are invoked by l2_rx_handle (this
// milestone) and l2_tx_send (this milestone), which themselves land as
// dormant helpers pending the ARP / IPv4 stack wiring in R27.M4+.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: byte MAC / ethertype stores route via mov_b / mov_w.
//   G6: bswap_d is proven (PA-R15-001) but manual shl/shr/and/or is
//       equivalent for a 2-byte swap and avoids a per-htons prologue
//       for the 32-bit register form.
//
// Reserved-label discipline: labels prefixed `ethp_` (parse) and
// `ethb_` (build) to avoid paideia-as reserved names.

module Ethernet = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let ETH_HDR_LEN               : u64 = 14
  pub let ETH_ADDR_LEN              : u64 = 6

  pub let ETH_TYPE_IPV4             : u64 = 0x0800
  pub let ETH_TYPE_ARP              : u64 = 0x0806
  pub let ETH_TYPE_IPV6             : u64 = 0x86DD    // deferred R30+
  pub let ETH_TYPE_VLAN             : u64 = 0x8100    // deferred R31+

  // ============================================================================
  // htons(val) -> u64  — host-to-network 16-bit byte swap
  // ============================================================================
  //
  // SysV: (val: u64) -> u64
  //   rdi = value (low 16 bits meaningful)
  //
  // Returns rax = byte-swapped u16 in low 16 bits; upper bits zero.
  //
  // Leaf function. No callee-save prologue.

  pub let htons : (u64) -> u64 !{} @{} =
    fn (val: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R27-M3-001 (#981). Host-to-network byte swap for a u16. paideia-as v0.22 encodes bswap_d (PA-R15-001 / #956) and bswap r64 (PA-R13-014 / #943), but a 2-byte swap via shl/shr/and/or requires no prologue register moves and no operand-width prefix — it is 6 fixed instructions on caller-save registers (rax, rcx) that survive without a frame. Body: (1) mov rax, rdi — stage the input u16 in rax. (2) mov rcx, rax — copy for the high-byte extraction. (3) and rax, 0xFF — isolate low byte in rax. (4) shl rax, 8 — low byte now occupies bits [15:8]. (5) shr rcx, 8 — high byte now in bits [7:0] of rcx (upper bits still contain caller garbage but the next and drops them). (6) and rcx, 0xFF — isolate original high byte. (7) or rax, rcx — combined byte-swapped u16 in bits [15:0], upper bits zero. (8) ret. No callee-save. rax return per SysV.",
      block: {
        mov rax, rdi;
        mov rcx, rax;
        and rax, 0xFF;
        shl rax, 8;
        shr rcx, 8;
        and rcx, 0xFF;
        or rax, rcx;
        ret
      }
    } @no_frame

  // ============================================================================
  // eth_parse(frame_pa, out_ptr) -> u64
  // ============================================================================
  //
  // SysV: (frame_pa: u64, out_ptr: u64) -> u64
  //   rdi = physical address of the received Ethernet frame
  //         (identity-mapped under the M14+ higher-half alias, so the
  //         PA doubles as a directly-loadable VA under KERNEL_VMA_BASE)
  //   rsi = pointer to a 14-byte destination buffer (typically the
  //         module-static _l2_rx_hdr in l2_rx.pdx)
  //
  // Copies the first 14 bytes of the frame into out_ptr and returns 1
  // when at least one byte is non-zero (a legitimate Ethernet frame),
  // 0 when the header is entirely zero (a spurious IRQ walking a
  // never-populated descriptor slot).
  //
  // Register plan (1-push callee-save):
  //   rbx = out_ptr (survives across the rep_movsb clobber of rdi)
  //
  //   1 push = 8 B; entry rsp%16==8 -> 16, %16==0 (leaf beyond rep_movsb,
  //   no nested call so no extra pad needed).

  pub let eth_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (frame_pa: u64, out_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M3-001 (#981). Copy 14 bytes from frame_pa to out_ptr and validate not-all-zero. Body: (1) 1-push callee-save (rbx = out_ptr) — 8 B; entry rsp%16==8 -> 16, %16==0 (leaf beyond rep_movsb; no nested call, no extra pad). (2) rbx = out_ptr (rsi arg) so we can walk the destination during validation after rep_movsb clobbers rdi. (3) rep_movsb 14 bytes: swap the entry-form (rdi=frame_pa, rsi=out_ptr) into the string-move form (rdi=dest, rsi=src) via `mov rax, rdi; mov rdi, rsi; mov rsi, rax`. rcx=14, cld, rep_movsb. rep_movsb consumes rdi/rsi/rcx which are caller-save, so rbx survives. (4) Validate: OR all 14 bytes at [rbx+0..13] into rax. Walk via `xor rax,rax; xor rcx,rcx; ethp_val_loop: cmp rcx,14; jae ethp_val_done; xor r10,r10; mov_b r10,[rbx+rcx]; or rax,r10; add rcx,1; jmp ethp_val_loop`. (5) At loop exit: if rax==0 -> return 0 (all-zero header, invalid); else return 1. Reserved labels: `ethp_`.",
      block: {
        push rbx;

        mov rbx, rsi;                            // rbx = out_ptr

        // rep_movsb requires rdi=dest, rsi=src. Swap from entry-form.
        mov rax, rdi;                            // rax = frame_pa
        mov rdi, rsi;                            // rdi = out_ptr (dest)
        mov rsi, rax;                            // rsi = frame_pa (src)
        mov rcx, 14;
        cld;
        rep_movsb;

        // Validate: OR all 14 bytes together.  paideia-as v0.22 accepts
        // only [reg+imm] addressing (no [base+index] SIB form yet — G6),
        // so we walk a moving base pointer via `add r10, 1` per iter.
        xor rax, rax;
        mov r10, rbx;                            // ptr = out_ptr
        mov rcx, 14;                             // count

      ethp_val_loop:
        cmp rcx, 0;
        je ethp_val_done;
        xor r11, r11;
        mov_b r11, [r10 + 0];
        or rax, r11;
        add r10, 1;
        sub rcx, 1;
        jmp ethp_val_loop;

      ethp_val_done:
        // rax == 0 iff header is all-zero.
        cmp rax, 0;
        je ethp_bad;
        mov rax, 1;
        jmp ethp_ret;

      ethp_bad:
        xor rax, rax;

      ethp_ret:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // eth_build(out_pa, dst_ptr, src_ptr, ethertype, payload_pa, payload_len)
  //   -> u64
  // ============================================================================
  //
  // SysV: (out_pa: u64, dst_ptr: u64, src_ptr: u64, ethertype: u64,
  //        payload_pa: u64, payload_len: u64) -> u64
  //   rdi = out_pa       — destination frame buffer (>= 14 + payload_len)
  //   rsi = dst_ptr      — pointer to 6-byte destination MAC
  //   rdx = src_ptr      — pointer to 6-byte source MAC
  //   rcx = ethertype    — u16 host-byte-order (htons applied inline)
  //   r8  = payload_pa   — payload source (may be 0 iff payload_len==0)
  //   r9  = payload_len  — payload byte count (0 permitted for empty
  //                        L2 test frames)
  //
  // Returns rax = total frame length = 14 + payload_len.
  //
  // Frame layout at completion:
  //   out_pa[0..5]    = dst_mac
  //   out_pa[6..11]   = src_mac
  //   out_pa[12..13]  = ethertype (big-endian)
  //   out_pa[14..]    = payload
  //
  // Register plan (6-push callee-save):
  //   rbx = out_pa
  //   rbp = src_ptr
  //   r12 = ethertype
  //   r13 = payload_pa
  //   r14 = payload_len
  //   r15 = dst_ptr
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0
  //   (aligned for the nested htons call — leaf, but discipline
  //   preserves alignment for any future callees added on this path).

  pub let eth_build : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_pa: u64, dst_ptr: u64, src_ptr: u64, ethertype: u64,
        payload_pa: u64, payload_len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M3-001 (#981). Build an Ethernet II frame: dst_mac[6] + src_mac[6] + ethertype_be[2] + payload[payload_len]. Body: (1) 6-push callee-save prologue (rbx=out_pa, rbp=src_ptr, r12=ethertype, r13=payload_pa, r14=payload_len, r15=dst_ptr) + `sub rsp,8` — 48 + 8 = 56; entry rsp%16==8 -> 64, %16==0 (aligned for nested htons call, and for any future callees added to this path). Caller-save (rsi/rdx/rcx/r8/r9) migrate to callee-save inside the prologue so they survive the rep_movsb and htons clobbers. (2) memcpy dst_mac[6] to out_pa[0..5] via rep_movsb (rdi=rbx, rsi=r15, rcx=6, cld). (3) memcpy src_mac[6] to out_pa[6..11] via rep_movsb (rdi=rbx+6, rsi=rbp, rcx=6, cld). (4) htons(ethertype): mov rdi, r12; call htons -> rax = byte-swapped u16 in low 16 bits. Store at out_pa[12..13] via `mov_w [rbx+12], rax` (G1 sized-16-bit store; bare `mov [mem], rax` widens to 8 bytes and corrupts the payload's leading bytes). (5) If payload_len==0 skip payload copy (used by ARP-request-with-no-payload edge case at R27.M4 for encoder-verification fixtures). Otherwise rep_movsb payload_len bytes from payload_pa to out_pa+14 (rdi=rbx+14, rsi=r13, rcx=r14). (6) Return total = 14 + payload_len in rax. rep_movsb clobbers rdi/rsi/rcx per SysV; all frame data is in callee-save registers so the state survives. Reserved labels: `ethb_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = out_pa
        mov r15, rsi;                            // r15 = dst_ptr
        mov rbp, rdx;                            // rbp = src_ptr
        mov r12, rcx;                            // r12 = ethertype
        mov r13, r8;                             // r13 = payload_pa
        mov r14, r9;                             // r14 = payload_len

        // ============================================================
        // (2) Copy dst_mac[6] -> out_pa[0..5].
        // ============================================================
        mov rdi, rbx;
        mov rsi, r15;
        mov rcx, 6;
        cld;
        rep_movsb;

        // ============================================================
        // (3) Copy src_mac[6] -> out_pa[6..11].
        // ============================================================
        mov rdi, rbx;
        add rdi, 6;
        mov rsi, rbp;
        mov rcx, 6;
        cld;
        rep_movsb;

        // ============================================================
        // (4) Ethertype (u16 BE) @ out_pa[12..13].
        // ============================================================
        mov rdi, r12;
        call htons;
        mov_w [rbx + 12], rax;

        // ============================================================
        // (5) Payload copy (skip if length == 0).
        // ============================================================
        cmp r14, 0;
        je ethb_no_payload;

        mov rdi, rbx;
        add rdi, 14;
        mov rsi, r13;
        mov rcx, r14;
        cld;
        rep_movsb;

      ethb_no_payload:
        // ============================================================
        // (6) Return total frame length = 14 + payload_len.
        // ============================================================
        mov rax, 14;
        add rax, r14;

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
