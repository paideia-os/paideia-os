// src/kernel/core/net/l2_tx.pdx — R27-M3-003 (#983)
//
// L2 transmit path: bump-alloc a TX buffer from the module-static
// pool, build an Ethernet frame into it, and hand the fully-built
// frame off to the NIC dispatch layer (nic_dispatch_tx) which
// routes it to the per-driver TX adapter for the currently-active
// NIC. The descriptor publish + TDT bump that used to live here
// migrate into the per-NIC adapter under this cutover.
//
// -----------------------------------------------------------------------------
// R91.M1-003 cutover (paideia-os #2013): route through nic_dispatch
// -----------------------------------------------------------------------------
//
// Before this landing, l2_tx_send:
//   (a) read _e1000e_tx_head / _e1000e_tx_tail for the ring-full guard;
//   (b) wrote the legacy TX descriptor into &_e1000e_tx_ring[tail*16];
//   (c) bumped _e1000e_tx_tail and MMIO-wrote TDT (0x3818) via
//       e1000e_reg_write_u32(bar0, 0x3818, new_tail).
//
// That coupling made L2 transmit e1000e-specific at exactly the layer
// (Ethernet framing) that R91's generic-NIC plan wants to abstract.
// After this landing, l2_tx_send:
//   (a) size-gates the payload (unchanged);
//   (b) bump-allocs a scratch buffer (unchanged);
//   (c) calls eth_build to synthesize the 14-byte Ethernet header +
//       payload into that buffer (unchanged);
//   (d) hands (packet_ptr = buf_pa, packet_len = 14 + payload_len) to
//       nic_dispatch_tx(_active_nic_kind, buf_pa, total_len).
//
// The ring-full guard, descriptor publish, and TDT bump are now the
// per-NIC adapter's responsibility -- nd_tx_e1000e (for the e1000e
// arm), nd_tx_virtio (virtio-net), nd_tx_rtl8139 (rtl8139). Those arms
// return NIC_ENOSYS at this landing (see net/nic_dispatch.pdx §1 for
// why); a future R91.M2 issue wires the e1000e adapter to the ring
// primitives that used to live in this file, R91.M3-004 wires virtio,
// R91.M4-003 wires rtl8139. Until that wiring lands, wire-side L2 TX
// surfaces NIC_ENOSYS via rax to every caller (l2tx_ret path). The
// R72 loopback fast path bypasses l2_tx_send entirely, so the TCP
// echo witness is unaffected; the ICMP / UDP / off-box ARP paths
// observe NIC_ENOSYS-as-non-zero-return, which their existing failure-
// path bookkeeping (bump _<subsys>_tx_arp_pending / return without
// counter-bump) treats identically to any other l2 send failure.
//
// -----------------------------------------------------------------------------
// TX buffer pool
// -----------------------------------------------------------------------------
//
// Sixteen 2 KiB buffers (16 * 2048 = 32 KiB, 4 KiB-aligned) form a
// round-robin scratch pool addressed by `_l2_tx_buf_next`. 16 slots
// covers a burst of 16 in-flight frames, comfortably above the
// worst-case ARP-request + IPv4-fragment burst pattern the R27 stack
// generates. The pool is a bring-up convenience: a phys_alloc-derived
// SKB substrate replaces it at R28+ when the send path grows a
// completion-observing free-list. The pool stays owned by this module
// even under the R91.M1-003 cutover -- the built frame's lifetime is
// still "until the per-NIC adapter has copied / DMA-scheduled it",
// which for legacy-descriptor NICs like e1000e means "until the TXDW
// IRQ reclaims the descriptor slot". Moving the pool into per-NIC
// adapters would duplicate the buffer arithmetic across three drivers
// and re-fragment the completion-tracking substrate; keeping it here
// preserves single-writer discipline on _l2_tx_buf_next.
//
// -----------------------------------------------------------------------------
// Legacy descriptor programming (migrated to nd_tx_e1000e)
// -----------------------------------------------------------------------------
//
// The 16-byte legacy TX descriptor layout (buffer_addr / length / cso /
// cmd=EOP|IFCS|RS=0x0B / sta_rsv / css / special) that used to be
// programmed here now belongs to the e1000e-side adapter. The
// L2_TX_CMD_EOP_IFCS_RS constant is retained below as the shared
// source-of-truth for what those flags compose to, so the adapter
// can pull the same value without a magic literal.
//
// -----------------------------------------------------------------------------
// Return-code stability
// -----------------------------------------------------------------------------
//
// Before R91.M1-003: rax ∈ {0=OK, 1=PAYLOAD_TOO_BIG, 2=RING_FULL}.
// After R91.M1-003:  rax ∈ {0=OK, 1=PAYLOAD_TOO_BIG, dispatch_return},
// where dispatch_return is NIC_ENOSYS (0xFFFFFFFFFFFFFFDA) until the
// per-NIC arm wires up, at which point it becomes the arm's own
// return code (0=OK, per-NIC error codes for ring-full / hw-fault).
// L2_TX_ERR_RING_FULL (2) is retained as a public constant for the
// per-NIC adapter to emit uniformly once wired, and for the ARP /
// IPv4 caller-side documentation that references it -- l2_tx_send
// itself no longer emits it.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: (retired here) sub-8B descriptor stores migrated with the
//       descriptor-publish path into nd_tx_e1000e.
//
// Reserved-label discipline: labels prefixed `l2tx_`.

module L2Tx = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let L2_TX_BUF_COUNT           : u64 = 16
  pub let L2_TX_BUF_SIZE            : u64 = 2048
  pub let L2_TX_BUF_POOL_BYTES      : u64 = 32768        // 16 * 2048
  pub let L2_TX_RING_DESCS          : u64 = 128

  // Return codes.
  pub let L2_TX_OK                  : u64 = 0
  pub let L2_TX_ERR_PAYLOAD_TOO_BIG : u64 = 1
  pub let L2_TX_ERR_RING_FULL       : u64 = 2

  // TX descriptor CMD-byte composition (mirror of tx_ring.pdx constants
  // to avoid a cross-module CMD-byte value drift under refactor).
  //   EOP  (bit 0) = 0x01
  //   IFCS (bit 1) = 0x02
  //   RS   (bit 3) = 0x08
  pub let L2_TX_CMD_EOP_IFCS_RS     : u64 = 0x0B

  // ============================================================================
  // Canonical .bss slots
  // ============================================================================
  //
  //   _l2_tx_buffers : 16 * 2048 B = 32 KiB TX scratch pool
  //                    (u64 count = 32768 / 8 = 4096)
  //   _l2_tx_buf_next: round-robin bump-alloc cursor (0..15)
  //   _l2_tx_pkts    : cumulative transmitted-frame count

  pub let mut _l2_tx_buffers        : [u64; 4096] = uninit @align(4096)
  pub let mut _l2_tx_buf_next       : u64          = 0
  pub let mut _l2_tx_pkts           : u64          = 0

  // ============================================================================
  // l2_tx_send(bar0, tx_ring_pa, dst_mac, ethertype, payload_pa,
  //            payload_len) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, tx_ring_pa: u64, dst_mac: u64, ethertype: u64,
  //        payload_pa: u64, payload_len: u64) -> u64
  //   rdi = bar0        (accepted for signature-compat; ignored under
  //                      R91.M1-003 -- see file header. Callers will
  //                      be re-pointed by a later issue that drops
  //                      the hardcoded _e1000e_devices[0]+8 load
  //                      from every ipv4_tx_send / arp_send_request
  //                      / arp_reply call site.)
  //   rsi = tx_ring_pa  (same disposition as bar0 -- accepted for
  //                      compat, ignored here; the per-NIC adapter
  //                      inside nic_dispatch owns ring geometry).
  //   rdx = pointer to 6-byte destination MAC
  //   rcx = ethertype (u16 host-byte-order)
  //   r8  = payload_pa (may be 0 iff payload_len == 0)
  //   r9  = payload_len (bytes; must satisfy 14 + payload_len <= 2048)
  //
  // The source MAC is drawn from _e1000e_devices[0].mac (record +24;
  // populated by e1000e_read_mac during driver-attach in R27.M2+).
  // paideia-as v0.22 caps callable-fn arity at 6, so the 7-parameter
  // shape from the R27.M3 design brief collapses src_mac into a
  // device-slot lookup — the T14 G4 / QEMU target ships a single
  // e1000e NIC at slot 0, and multi-NIC dispatch is deferred to R28+
  // when the send path grows a device-context substrate. Post-R91.M1-003
  // this src_mac lookup remains e1000e-hardcoded here as a KNOWN
  // deferred sub-scope: nic_dispatch_mac(kind, out) is the adapter
  // that will replace it once its arms wire up (R91.M2 wave for
  // e1000e, R91.M3-006 for virtio, R91.M4-004 for rtl8139). Wiring
  // that adapter today would trip a chicken-and-egg since its arms
  // still return NIC_ENOSYS.
  //
  // Returns rax:
  //   0                                = L2_TX_OK
  //   1                                = L2_TX_ERR_PAYLOAD_TOO_BIG
  //                                      (14 + payload_len > 2048)
  //   NIC_ENOSYS (0xFFFFFFFFFFFFFFDA) = per-NIC adapter unwired
  //                                      (transitional; see file
  //                                      header §"R91.M1-003 cutover")
  //   other                            = per-NIC adapter's own error
  //                                      code once wired (e.g. its
  //                                      own ring-full sentinel)
  //
  // Register plan (4-push callee-save + 24-byte scratch):
  //   rbx = bar0        (accepted, unused post-cutover; still saved so
  //                      a future rewiring can restore it as HW state)
  //   rbp = tx_ring_pa  (same disposition)
  //   r12 = tx_buf_pa (allocated buffer)
  //   r13 = total_len (14 + payload_len, from eth_build)
  //
  //   4 pushes = 32 B; entry rsp%16==8 -> 40, sub rsp,24 -> 64, %16==0
  //   (aligned for eth_build (rep_movsb + htons) + nic_dispatch_tx).

  pub let l2_tx_send : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, tx_ring_pa: u64, dst_mac: u64, ethertype: u64,
        payload_pa: u64, payload_len: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R91.M1-003 (paideia-os #2013). L2 transmit re-pointed through the nic_dispatch layer: build the Ethernet frame in a pool buffer, then hand (buf_pa, total_len) to nic_dispatch_tx(_active_nic_kind, ...) instead of programming the e1000e legacy TX descriptor + bumping TDT inline. The descriptor publish + TDT MMIO write that used to close out this function migrated to the per-NIC nd_tx_e1000e adapter (see net/nic_dispatch.pdx §1 for the transitional NIC_ENOSYS return posture; adapter wiring lands in the R91.M2 wave). Body: (1) 4-push callee-save (rbx=bar0 stashed for signature-compat; rbp=tx_ring_pa likewise; r12=tx_buf_pa; r13=total_len) + `sub rsp,24` -- 32 + 24 = 56; entry rsp%16==8 -> 64, %16==0 (aligned for eth_build (nested rep_movsb + htons) + nic_dispatch_tx). Args rdx (dst_mac), rcx (ethertype), r8 (payload_pa) are caller-save and get stashed at [rsp+0..16] because eth_build's arg-shuffle and the bump-alloc rax/rcx traffic both clobber them before the eth_build call site; r9 (payload_len) stays live in r9 across the size gate (which only touches rax) and the bump-alloc (rax/rcx only), so it does not need a stack slot. (2) Size gate: mov rax, r9; add rax, 14; cmp rax, 2048; ja l2tx_too_big. (3) Bump-alloc buffer from _l2_tx_buffers: idx=_l2_tx_buf_next; new_idx=(idx+1)&15; store back; tx_buf_pa=&_l2_tx_buffers + idx*2048; r12=tx_buf_pa. (4) eth_build(tx_buf, dst_mac=[rsp+0], src_mac=&_e1000e_devices+24 [see docstring on this KNOWN deferred sub-scope], ethertype=[rsp+8], payload_pa=[rsp+16], payload_len=r9). rax returns total_len; r13 captures it. (5) nic_dispatch_tx(_active_nic_kind [rip-relative load], tx_buf_pa=r12, total_len=r13). rax carries dispatch's return: 0 on success (once nd_tx_e1000e / nd_tx_virtio / nd_tx_rtl8139 wire up), NIC_ENOSYS today, or the per-NIC adapter's own error code post-wiring. (6) On rax==0 bump _l2_tx_pkts + return 0; on rax!=0 propagate the code untouched (l2tx_ret path). Error path: l2tx_too_big -> mov rax, 1. Reserved labels: `l2tx_`. The former l2tx_full path is deleted with the ring-full guard -- the guard's substrate (_e1000e_tx_head / _e1000e_tx_tail) is a per-NIC concern that migrated into nd_tx_e1000e alongside the descriptor publish; nic_dispatch_tx's return code carries any adapter-side ring-full observation. Every nested callee preserves rbx/rbp/r12/r13 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 24;                             // 3 scratch slots -> aligned

        // Scratch layout (survives across eth_build):
        //   [rsp+0]  = dst_mac ptr (was rdx)
        //   [rsp+8]  = ethertype   (was rcx)
        //   [rsp+16] = payload_pa  (was r8)
        // payload_len stays in r9 through the middle chain (size gate
        // touches only rax; bump-alloc only rax/rcx).
        mov [rsp + 0], rdx;
        mov [rsp + 8], rcx;
        mov [rsp + 16], r8;

        // rbx = bar0, rbp = tx_ring_pa. Both accepted for signature
        // compat and ignored under R91.M1-003 (see file header). Held
        // in callee-save regs so a future rewiring can restore their
        // hardware role without a caller-side edit.
        mov rbx, rdi;
        mov rbp, rsi;

        // ============================================================
        // (2) Size gate: 14 + payload_len <= 2048
        // ============================================================
        mov rax, r9;
        add rax, 14;
        cmp rax, 2048;
        ja l2tx_too_big;

        // ============================================================
        // (3) Bump-alloc buffer from _l2_tx_buffers pool.
        // ============================================================
        mov rax, [rip + _l2_tx_buf_next];        // idx
        mov rcx, rax;                            // save idx
        add rax, 1;
        and rax, 15;                             // new_idx = (idx+1)&15
        mov [rip + _l2_tx_buf_next], rax;

        // tx_buf_pa = &_l2_tx_buffers + idx*2048
        mov rax, rcx;
        shl rax, 11;                             // idx * 2048
        lea r12, [rip + _l2_tx_buffers];
        add r12, rax;

        // ============================================================
        // (4) eth_build(tx_buf, dst_mac, src_mac, ethertype, payload_pa,
        //               payload_len)
        //
        // src_mac_ptr = &_e1000e_devices[0].mac = _e1000e_devices + 24.
        // (Record +24; probe.pdx L66 comment. Populated by
        // e1000e_read_mac during driver-attach.) This direct read is a
        // KNOWN deferred sub-scope of R91.M1-003 -- see docstring on
        // l2_tx_send above; nic_dispatch_mac(kind, out) will replace
        // it once its arms wire up in R91.M2 / R91.M3-006 / R91.M4-004.
        // ============================================================
        mov rdi, r12;                            // out_pa
        mov rsi, [rsp + 0];                      // dst_mac
        lea rdx, [rip + _e1000e_devices];
        add rdx, 24;                             // src_mac ptr
        mov rcx, [rsp + 8];                      // ethertype
        mov r8, [rsp + 16];                      // payload_pa
        // r9 already holds payload_len (see scratch-layout comment).
        call eth_build;
        mov r13, rax;                            // r13 = total_len

        // ============================================================
        // (5) nic_dispatch_tx(_active_nic_kind, buf_pa, total_len).
        //     Replaces the pre-R91.M1-003 descriptor publish + TDT
        //     bump path. See file header §"R91.M1-003 cutover" for
        //     the transitional NIC_ENOSYS return posture.
        // ============================================================
        mov rdi, [rip + _active_nic_kind];       // nic_kind selector
        mov rsi, r12;                            // packet_ptr = tx_buf_pa
        mov rdx, r13;                            // packet_len = total_len
        call nic_dispatch_tx;

        // ============================================================
        // (6) On dispatch success bump _l2_tx_pkts. On any non-zero
        //     return propagate rax untouched -- callers see 0 on OK
        //     and the dispatch return (NIC_ENOSYS today; the adapter's
        //     own code once wired) on failure.
        // ============================================================
        cmp rax, 0;
        jne l2tx_ret;

        mov rcx, [rip + _l2_tx_pkts];
        add rcx, 1;
        mov [rip + _l2_tx_pkts], rcx;

        xor rax, rax;                            // L2_TX_OK
        jmp l2tx_ret;

      l2tx_too_big:
        mov rax, 1;                              // L2_TX_ERR_PAYLOAD_TOO_BIG

      l2tx_ret:
        add rsp, 24;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
