// src/kernel/core/net/udp.pdx — R27-M6-001 / R27-M6-004 (#993 / #996)
//
// UDP header (8 B) + parse/build/checksum + rx_handle (port 7 echo).
//
// -----------------------------------------------------------------------------
// Wire layout (8 bytes)
// -----------------------------------------------------------------------------
//
//   +0    u16   src_port         BE
//   +2    u16   dst_port         BE
//   +4    u16   length           BE; header + payload bytes (>= 8)
//   +6    u16   checksum         BE; ones-complement over pseudo-header +
//                                UDP header + UDP payload (0 = "not
//                                computed", legal under IPv4 per RFC 768)
//
// -----------------------------------------------------------------------------
// Checksum discipline
// -----------------------------------------------------------------------------
//
// udp_checksum takes (src_ip, dst_ip, udp_pkt_pa, udp_len) and returns
// the 16-bit ones-complement of the pseudo-header + UDP packet. The
// pseudo-header is (src_ip[4] + dst_ip[4] + 0 + protocol=17 + udp_len).
//
// The R27.M6 build path writes checksum = 0 (RFC 768 "no checksum")
// because the R27 wire is a QEMU virtual link with no bit-flip surface,
// and IPv4 lets us skip the field. The udp_checksum symbol exists for
// symmetry with ipv4_checksum and for the R27+ TCP round which will
// reuse the pseudo-header sum shape.
//
// -----------------------------------------------------------------------------
// udp_rx_handle port-7 echo demo (#996)
// -----------------------------------------------------------------------------
//
// The M6 receive engine intercepts port 7 (Echo Protocol, RFC 862) and
// reflects the payload back to the sender. All other destination ports
// fall through to a "no socket bound" drop that bumps a counter. Real
// port -> KIND_UDP_SOCKET dispatch is deferred to #1015 (userspace-
// server substrate).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: byte / word stores route via mov_b / mov_w.
//   G6: [reg+imm] addressing only.
//
// Reserved-label discipline: labels prefixed `udpp_` (parse),
// `udpb_` (build), `udpc_` (checksum), `udprh_` (rx_handle).

module Udp = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let UDP_HDR_LEN         : u64 = 8
  pub let UDP_PORT_ECHO       : u64 = 7          // RFC 862
  pub let UDP_PROTO           : u64 = 17         // IPv4 protocol number

  // Return codes for udp_rx_handle (mirrors ipv4_rx_handle discipline):
  //   0 = accepted-and-dispatched (echo replied OR socket delivered)
  //   1 = malformed (length gate)
  //   2 = no socket bound (port not 7 and #1015 not landed)
  pub let UDP_RX_OK               : u64 = 0
  pub let UDP_RX_ERR_MALFORMED    : u64 = 1
  pub let UDP_RX_DROP_NO_SOCKET   : u64 = 2

  // ============================================================================
  // Canonical .bss slots
  // ============================================================================
  //
  //   _udp_rx_scratch       : 8-byte header parse buffer (16 B for u64 stride)
  //   _udp_tx_scratch       : 2048-byte reply build buffer (UDP hdr + payload)
  //
  //   Counters (all u64 wraparound):
  //     _udp_rx_pkts             accepted-and-dispatched
  //     _udp_rx_bad_hdr          short header
  //     _udp_rx_no_socket        port != 7 (deferred to #1015 delivery)
  //     _udp_rx_echoed           port 7 replies sent

  pub let mut _udp_rx_scratch     : [u8;   16] = uninit @align(8)
  pub let mut _udp_tx_scratch     : [u8; 2048] = uninit @align(8)
  pub let mut _udp_rx_pkts        : u64        = 0
  pub let mut _udp_rx_bad_hdr     : u64        = 0
  pub let mut _udp_rx_no_socket   : u64        = 0
  pub let mut _udp_rx_echoed      : u64        = 0

  // ============================================================================
  // udp_parse(pkt_pa, out) -> u64  — #993
  // ============================================================================
  //
  // SysV: (pkt_pa: u64, out: u64) -> u64
  //   rdi = physical address of the UDP header
  //   rsi = pointer to an 8-byte destination buffer (typically
  //         _udp_rx_scratch)
  //
  // Copies 8 header bytes and returns 1. UDP has no self-validating
  // fields at the header level (checksum can be 0 and length is only
  // guaranteed >= 8); the caller supplies pkt_len bound. The `-> bool`
  // in the issue text is encoded as {0, 1} in u64.
  //
  // Register plan: 1 push (rbx = out) — leaf beyond rep_movsb.

  pub let udp_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (pkt_pa: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M6-001 (#993). Copy 8 UDP-header bytes to out and return 1. Body: (1) 1-push callee-save (rbx=out) — 8 B; entry rsp%16==8 -> 16, %16==0 (leaf beyond rep_movsb; no nested call). (2) rep_movsb 8 bytes: swap entry-form (rdi=pkt_pa, rsi=out) into string-form (rdi=dest, rsi=src) via `mov rax,rdi; mov rdi,rsi; mov rsi,rax; mov rcx,8; cld; rep_movsb`. rbx (callee-save) survives. (3) rax = 1 (UDP has no self-validating header fields beyond size — caller supplies pkt_len bound). Reserved labels: `udpp_` (none currently emitted — no branches).",
      block: {
        push rbx;

        mov rbx, rsi;                            // rbx = out (unused for now)

        // rep_movsb: swap entry-form to (rdi=dest, rsi=src).
        mov rax, rdi;
        mov rdi, rsi;
        mov rsi, rax;
        mov rcx, 8;
        cld;
        rep_movsb;

        mov rax, 1;

        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_build(out_pa, src_port, dst_port, payload_len) -> u64  — #993
  // ============================================================================
  //
  // SysV: (out_pa: u64, src_port: u64, dst_port: u64,
  //        payload_len: u64) -> u64
  //   rdi = out_pa       — destination header buffer (>= 8 bytes)
  //   rsi = src_port     — u16 host-order
  //   rdx = dst_port     — u16 host-order
  //   rcx = payload_len  — u16 host-order (bytes of UDP payload)
  //
  // Writes 8 bytes: src_port (BE), dst_port (BE), length = 8 +
  // payload_len (BE), checksum = 0 (RFC 768 "no checksum"; the R27
  // MVP does not compute UDP checksums on TX). Returns rax = 8
  // (UDP_HDR_LEN).
  //
  // Register plan: 5-push callee-save (rbx=out_pa, rbp=src_port,
  // r12=dst_port, r13=payload_len, r14=length_field). Leaf.
  // 5 pushes = 40; entry rsp%16==8 -> 48, %16==0.

  pub let udp_build : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_pa: u64, src_port: u64, dst_port: u64,
        payload_len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M6-001 (#993). Build an 8-byte UDP header. Body: (1) 5-push callee-save (rbx=out_pa, rbp=src_port, r12=dst_port, r13=payload_len, r14=length_field) — 40; entry rsp%16==8 -> 48, %16==0 (leaf). (2) src_port (u16 BE @+0..+1): byte[0] = (src>>8)&0xFF; byte[1] = src&0xFF. (3) dst_port (u16 BE @+2..+3): byte[2] = (dst>>8)&0xFF; byte[3] = dst&0xFF. (4) length (u16 BE @+4..+5) = 8 + payload_len: byte[4] = (len>>8)&0xFF; byte[5] = len&0xFF. (5) checksum @+6..+7 = 0 (RFC 768 'no checksum'; MVP skips because IPv4 lets us and the QEMU virtual link has no bit-flip surface). (6) rax = 8. Reserved labels: `udpb_` (none currently emitted — no branches).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // out_pa
        mov rbp, rsi;                            // src_port
        mov r12, rdx;                            // dst_port
        mov r13, rcx;                            // payload_len

        // (2) src_port BE @+0..+1
        mov rax, rbp;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rbx + 0], rax;
        mov rax, rbp;
        and rax, 0xFF;
        mov_b [rbx + 1], rax;

        // (3) dst_port BE @+2..+3
        mov rax, r12;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rbx + 2], rax;
        mov rax, r12;
        and rax, 0xFF;
        mov_b [rbx + 3], rax;

        // (4) length BE @+4..+5 = 8 + payload_len
        mov r14, 8;
        add r14, r13;
        mov rax, r14;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rbx + 4], rax;
        mov rax, r14;
        and rax, 0xFF;
        mov_b [rbx + 5], rax;

        // (5) checksum @+6..+7 = 0
        xor rax, rax;
        mov_b [rbx + 6], rax;
        mov_b [rbx + 7], rax;

        // (6) rax = 8
        mov rax, 8;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_checksum(src_ip, dst_ip, udp_pkt_pa, udp_len) -> u64  — #993
  // ============================================================================
  //
  // SysV: (src_ip: u64, dst_ip: u64, udp_pkt_pa: u64, udp_len: u64) -> u64
  //   rdi = pointer to 4-byte source IPv4 address
  //   rsi = pointer to 4-byte destination IPv4 address
  //   rdx = physical address of the UDP packet (header + payload)
  //   rcx = udp_len in bytes (>= 8; must equal header.length field)
  //
  // Sums the pseudo-header (src_ip[4] + dst_ip[4] + 0 + 17 + udp_len)
  // plus the UDP packet as 16-bit big-endian words into a u32
  // accumulator, folds carries into the low 16 bits, returns
  // ~sum & 0xFFFF. Return is HOST-order; the caller stores as BE via
  // two mov_b writes (byte[6] = hi, byte[7] = lo) if the checksum
  // field is populated.
  //
  // Register plan: 5-push callee-save (rbx=src_ip, rbp=dst_ip,
  // r12=udp_pkt_pa, r13=udp_len, r14=u32 sum accumulator). Leaf.
  // 5 pushes = 40; entry rsp%16==8 -> 48, %16==0.

  pub let udp_checksum : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src_ip: u64, dst_ip: u64, udp_pkt_pa: u64, udp_len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M6-001 (#993). Ones-complement 16-bit sum over IPv4 pseudo-header (src_ip[4] + dst_ip[4] + zero + proto=17 + udp_len) + UDP packet. Body: (1) 5-push callee-save (rbx=src_ip, rbp=dst_ip, r12=udp_pkt_pa, r13=udp_len, r14=u32 sum accumulator) — 40; entry rsp%16==8 -> 48, %16==0 (leaf). (2) Sum pseudo-header words as 6x BE u16: word0=(src_ip[0]<<8)|src_ip[1]; word1=(src_ip[2]<<8)|src_ip[3]; word2=(dst_ip[0]<<8)|dst_ip[1]; word3=(dst_ip[2]<<8)|dst_ip[3]; word4=(0<<8)|17=17; word5=udp_len (BE u16). (3) Loop udpc_pair: while (udp_len - off) >= 2, add (byte[off]<<8)|byte[off+1] to r14; off+=2. (4) Tail udpc_tail: if 1 byte left, add (byte<<8) to r14. (5) Fold udpc_fold: while (r14 >> 16) != 0: r14 = (r14 & 0xFFFF) + (r14 >> 16). (6) rax = r14 XOR 0xFFFF — after fold r14 <= 0xFFFF so XOR is equivalent to ones-complement of the low 16 bits (paideia-as v0.22 has no `not` mnemonic). Reserved labels: `udpc_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // src_ip ptr
        mov rbp, rsi;                            // dst_ip ptr
        mov r12, rdx;                            // udp_pkt_pa
        mov r13, rcx;                            // udp_len
        xor r14, r14;                            // sum

        // ============================================================
        // Pseudo-header word 0: (src_ip[0]<<8) | src_ip[1]
        // ============================================================
        xor rax, rax;
        mov_b rax, [rbx + 0];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rbx + 1];
        or rax, r10;
        add r14, rax;

        // Pseudo-header word 1: (src_ip[2]<<8) | src_ip[3]
        xor rax, rax;
        mov_b rax, [rbx + 2];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rbx + 3];
        or rax, r10;
        add r14, rax;

        // Pseudo-header word 2: (dst_ip[0]<<8) | dst_ip[1]
        xor rax, rax;
        mov_b rax, [rbp + 0];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rbp + 1];
        or rax, r10;
        add r14, rax;

        // Pseudo-header word 3: (dst_ip[2]<<8) | dst_ip[3]
        xor rax, rax;
        mov_b rax, [rbp + 2];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rbp + 3];
        or rax, r10;
        add r14, rax;

        // Pseudo-header word 4: (0<<8) | 17 = 17
        mov rax, 17;
        add r14, rax;

        // Pseudo-header word 5: udp_len (BE u16 — already host-order,
        // so add directly; the "BE" is only about wire representation).
        mov rax, r13;
        and rax, 0xFFFF;
        add r14, rax;

        // ============================================================
        // Sum the UDP packet as BE u16 words.
        // ============================================================
        xor rcx, rcx;                            // offset

      udpc_pair:
        mov rax, r13;
        sub rax, rcx;
        cmp rax, 2;
        jb udpc_tail;

        mov rdx, r12;
        add rdx, rcx;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rdx + 1];
        or rax, r10;

        add r14, rax;
        add rcx, 2;
        jmp udpc_pair;

      udpc_tail:
        mov rax, r13;
        sub rax, rcx;
        cmp rax, 0;
        je udpc_fold;

        mov rdx, r12;
        add rdx, rcx;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        shl rax, 8;
        add r14, rax;

      udpc_fold:
        mov rax, r14;
        shr rax, 16;
        cmp rax, 0;
        je udpc_done;
        mov rcx, r14;
        and rcx, 0xFFFF;
        add rcx, rax;
        mov r14, rcx;
        jmp udpc_fold;

      udpc_done:
        mov rax, r14;
        xor rax, 0xFFFF;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_rx_handle(pkt_pa, pkt_len, src_ip, dst_ip) -> u64  — #996
  // ============================================================================
  //
  // SysV: (pkt_pa: u64, pkt_len: u64, src_ip: u64, dst_ip: u64) -> u64
  //   rdi = physical address of the UDP header (frame_pa + 14 + 20)
  //   rsi = UDP payload length as reported by IPv4 (total_length - 20)
  //   rdx = pointer to the received src_ip[4] (into _ipv4_rx_scratch+12)
  //   rcx = pointer to the received dst_ip[4] (into _ipv4_rx_scratch+16)
  //
  // Behaviour:
  //   - Emit "L3 RX UDP" fingerprint (kept for parity with the M5 stub).
  //   - Length gate: pkt_len >= 8 (UDP header size).
  //   - Extract dst_port (BE u16 @+2..+3), src_port (BE u16 @+0..+1),
  //     udp_length (BE u16 @+4..+5).
  //   - If dst_port != UDP_PORT_ECHO (7): bump _udp_rx_no_socket and
  //     return UDP_RX_DROP_NO_SOCKET. Userspace socket delivery via
  //     KIND_UDP_SOCKET lands with #1015.
  //   - Otherwise build an 8-byte header into _udp_tx_scratch with
  //     ports swapped (src=7, dst=original src_port) and length =
  //     received udp_length; rep_movsb the payload (udp_length - 8
  //     bytes) from pkt_pa+8 to _udp_tx_scratch+8; hand to
  //     ipv4_tx_send(protocol=17, dst_ip=src_ip).
  //   - Bump _udp_rx_echoed and _udp_rx_pkts on success. Return 0.
  //
  // Register plan (6-push callee-save + 8-byte pad):
  //   rbx = pkt_pa            (survives across nested calls)
  //   rbp = pkt_len
  //   r12 = src_ip ptr
  //   r13 = dst_ip ptr
  //   r14 = src_port (extracted; used to build reply)
  //   r15 = udp_length (extracted; used for total reply length)
  //   6 pushes = 48; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0
  //   (aligned for klog_s1 + udp_build + rep_movsb + ipv4_tx_send).

  pub let udp_rx_handle : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (pkt_pa: u64, pkt_len: u64, src_ip: u64, dst_ip: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R93.M2-003 (paideia-os #2051): real per-port UDP RX dispatch. The R27.M6 port-7-hardcoded echo demo is retired -- port 7 now claims an ordinary bound KIND_UDP_SOCKET like any other port. Body: (1) 6-push callee-save (rbx=pkt_pa, rbp=pkt_len, r12=src_ip ptr, r13=dst_ip ptr, r14=dst_port, r15=payload_len) + `sub rsp,8` -- 48 + 8 = 56; entry rsp%16==8 -> 64, %16==0 (aligned for klog_s1 + udp_socket_find_by_local_port + udp_socket_deliver_dgram). (2) klog_s1(INFO, NET_, tag_l3_udp) L4 dispatch fingerprint (parity with the R27.M6 stub). (3) Length gate: cmp rbp, 8; jb udprh_malformed. (4) Extract dst_port (BE u16 @+2..+3) -> r14. (5) Extract udp_length (BE u16 @+4..+5), compute payload_len = udp_length - 8 -> r15. Zero-length payload (udp_length == 8) is legal per RFC 768 -- we still dispatch. (6) udp_socket_find_by_local_port(r14) -> sock_idx. UDP_NONE (0xFFFF...FFFF) -> udprh_no_socket (bump _udp_rx_no_socket, return UDP_RX_DROP_NO_SOCKET). (7) On hit: udp_socket_deliver_dgram(sock_idx, pkt_pa+8, payload_len). Return value ignored -- ring-full drop is silent per the UDP-unreliable contract. (8) Bump _udp_rx_pkts, return 0. Error paths bump counter + return non-zero. src_ip / dst_ip pointers are accepted for signature-compat with the pre-R93 shape (ipv4_rx_handle's dispatch site is unchanged); at this MVP the source-address tracking that sys_recvfrom would need is dropped on the floor -- a future landing that records (src_ip, src_port) per-datagram-slot in _udp_socket_table plumbs that back to userspace. The _udp_tx_scratch/_udp_rx_echoed .bss slots are retained (dead but harmless -- deletion is a separate sweep). Reserved labels: udprh_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // pkt_pa
        mov rbp, rsi;                            // pkt_len
        mov r12, rdx;                            // src_ip ptr (unused today)
        mov r13, rcx;                            // dst_ip ptr (unused today)

        // ============================================================
        // (1) klog fingerprint.
        // ============================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_l3_udp];
        call klog_s1;

        // ============================================================
        // (2) Length gate: pkt_len >= 8.
        // ============================================================
        cmp rbp, 8;
        jb udprh_malformed;

        // ============================================================
        // (3) Extract dst_port (BE u16 @+2..+3) -> r14.
        // ============================================================
        xor rax, rax;
        mov_b rax, [rbx + 2];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rbx + 3];
        or rax, rcx;
        mov r14, rax;

        // ============================================================
        // (4) Extract udp_length (BE u16 @+4..+5), compute payload_len.
        // ============================================================
        xor rax, rax;
        mov_b rax, [rbx + 4];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rbx + 5];
        or rax, rcx;
        // payload_len = max(udp_length - 8, 0).  A malformed short
        // udp_length below 8 also lands here; clamp to 0.
        cmp rax, 8;
        jae udprh_len_ok;
        xor rax, rax;
        jmp udprh_len_done;
      udprh_len_ok:
        sub rax, 8;
      udprh_len_done:
        mov r15, rax;                            // payload_len

        // ============================================================
        // (5) udp_socket_find_by_local_port(dst_port).
        // ============================================================
        mov rdi, r14;
        call udp_socket_find_by_local_port;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je udprh_no_socket;

        // ============================================================
        // (6) udp_socket_deliver_dgram(sock_idx, pkt_pa+8, payload_len).
        // ============================================================
        mov rdi, rax;                            // dst_sock_idx
        mov rsi, rbx;
        add rsi, 8;                              // payload source ptr
        mov rdx, r15;                            // payload_len
        call udp_socket_deliver_dgram;
        // Return value ignored -- silent ring-full drop per UDP contract.

        // ============================================================
        // (7) Bump _udp_rx_pkts + return 0.
        // ============================================================
        mov rax, [rip + _udp_rx_pkts];
        add rax, 1;
        mov [rip + _udp_rx_pkts], rax;

        xor rax, rax;
        jmp udprh_ret;

      udprh_no_socket:
        mov rax, [rip + _udp_rx_no_socket];
        add rax, 1;
        mov [rip + _udp_rx_no_socket], rax;
        mov rax, 2;                              // UDP_RX_DROP_NO_SOCKET
        jmp udprh_ret;

      udprh_malformed:
        mov rax, [rip + _udp_rx_bad_hdr];
        add rax, 1;
        mov [rip + _udp_rx_bad_hdr], rax;
        mov rax, 1;                              // UDP_RX_ERR_MALFORMED

      udprh_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
