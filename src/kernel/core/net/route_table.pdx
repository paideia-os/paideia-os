// src/kernel/core/net/route_table.pdx -- R92.M1-001..003 (paideia-os
// #2034 / #2035 / #2036)
//
// The single-source-of-truth mutable route record. Owns the four IPv4
// routing fields (my_ip, gw_ip, netmask, mtu) previously scattered as
// rodata across net/ipv4.pdx and net/arp.pdx.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// R27 landed net/ipv4.pdx with two rodata constants:
//
//     pub let _ipv4_my_ip : [u8; 4] = [ 10, 0, 0, 2 ]
//     pub let _ipv4_gw_ip : [u8; 4] = [ 10, 0, 0, 1 ]
//
// plus a private duplicate `_arp_my_ip` in net/arp.pdx. Because they
// were rodata, the R93 DHCP client (deferred; not landed) had no place
// to write the acquired lease -- every reader in the tree read fixed
// bytes at link time. This file replaces that with ONE mutable .bss
// record so DHCP (when it lands) has a single-store target and every
// existing byte-level reader keeps working against the same symbol
// names.
//
// =============================================================================
// SECTION 1  RECORD LAYOUT
// =============================================================================
//
// The record is FOUR distinct .bss symbols laid out consecutively for
// natural u64/u32 alignment; they are jointly one "route table row"
// but each addressable individually so a caller wanting only my_ip
// still does a rip-relative byte load, not a field-id lookup.
//
//   _ipv4_my_ip     [u8; 4] @align(4)   canonical wire order (b0..b3)
//   _ipv4_gw_ip     [u8; 4] @align(4)   canonical wire order (b0..b3)
//   _ipv4_netmask   [u8; 4] @align(4)   canonical wire order (b0..b3)
//   _ipv4_mtu       u64                 native host order (MTU bytes)
//
// Total .bss footprint: 4 + 4 + 4 + 8 = 20 bytes; padding + reserved
// space is intentionally omitted -- future fields (dns_ip, lease
// expiry, iface_kind) each add a NAMED symbol rather than growing a
// blob at fixed byte offsets. Named-symbol growth is what keeps a
// second reader from crystallising against a byte offset a later
// field-order change breaks.
//
// =============================================================================
// SECTION 2  FIELD ID SELECTORS (for route_table_set / route_table_get)
// =============================================================================
//
// The accessor pair takes an integer field_id rather than a symbol name
// because paideia-as at v0.24.x does not support symbol-by-value dispatch.
// Callers that already know which field they want at compile time SHOULD
// use the symbol directly (`[rip + _ipv4_my_ip + N]`) -- the accessor
// pair exists for the callers (DHCP client, boot-witness state
// manipulator) that carry the field id as a runtime value.
//
//   RT_FIELD_MY_IP    = 0
//   RT_FIELD_GW_IP    = 1
//   RT_FIELD_NETMASK  = 2
//   RT_FIELD_MTU      = 3
//
// Value marshalling:
//
//   * IP fields (0..2) treat `value` as the canonical wire-order
//     host-word u32: (b0<<24)|(b1<<16)|(b2<<8)|b3. So my_ip=10.0.0.2
//     is 0x0A000002. The accessor pair stores the four bytes in
//     wire order at [b0, b1, b2, b3]. This matches the packing
//     ipv4_tx_send / arp_rx_handle already use when assembling a
//     host-word for arp_cache_lookup.
//
//   * MTU (3) stores as native u64 (upper 32 bits reserved zero).
//
// =============================================================================
// SECTION 3  BOUNDS-CHECK-THEN-SINGLE-STORE DISCIPLINE
// =============================================================================
//
// route_table_set follows the same discipline as driver_table.pdx's
// driver_table_register (bounds-check-then-single-store): the field_id
// is validated at entry (>= RT_FIELD_COUNT -> RT_E_BAD_FIELD); on the
// happy path the four wire-order bytes (or the single u64 for MTU) are
// written and RT_OK returns. There is no read-modify-write of a shared
// header word because each field lives in its own symbol -- writes are
// naturally single-store per addressable slot.
//
// route_table_get mirrors: bounds-check at entry, single-load of the
// requested field, return the packed host-word (or the u64 for MTU).
//
// =============================================================================
// SECTION 4  DEFAULT INITIALISATION
// =============================================================================
//
// paideia-as .bss decls with `uninit` do not carry static initialisers,
// so the defaults are written by `rt_init` at boot time. kernel_main.pdx
// calls `rt_init` immediately before the R91 NIC-dispatch probe -- that
// ordering ensures any ipv4_tx_send / arp_send_request reader downstream
// of the probe sees the seeded 10.0.0.2 / 10.0.0.1 / 255.255.255.0 /
// 1500 defaults.
//
// Defaults match the pre-R92 rodata values byte-for-byte -- R92 alone
// changes nothing observable at boot. R93's DHCP client is the first
// caller that mutates the record post-init.
//
// =============================================================================
// SECTION 5  paideia-as encoder-gap posture (v0.24.x)
// =============================================================================
//
//   G1: byte / word stores route via mov_b / mov_w.
//   G4: zero-extend loads use xor+mov_b, never mov_bzx.
//   G6: [reg+imm] addressing only.
//
// Reserved-label discipline: labels prefixed `rt_` (route table).
// [legacy: RT ROUTE TABLE OK]

module RouteTable = structure {

  // ============================================================================
  // Field id selectors (route_table_set / route_table_get)
  // ============================================================================

  pub let RT_FIELD_MY_IP    : u64 = 0
  pub let RT_FIELD_GW_IP    : u64 = 1
  pub let RT_FIELD_NETMASK  : u64 = 2
  pub let RT_FIELD_MTU      : u64 = 3
  // R93.M1-004 (paideia-os #2046): DNS server slot. Populated by DHCP
  // ACK option 6 (DNS server list -- first address only at MVP); read
  // by net/dns.pdx's dns_resolve for the resolver's server target.
  // Default 0.0.0.0 (uninit-ish) until the first lease lands; a
  // caller that reads dns_ip before DHCP settles observes 0 and can
  // decide to defer resolution or fail closed.
  pub let RT_FIELD_DNS_IP   : u64 = 4
  pub let RT_FIELD_COUNT    : u64 = 5

  // Return codes.
  pub let RT_OK             : u64 = 0
  // Sentinel band matches the NIC_ENOSYS / driver_table style:
  // negative-when-interpreted-as-signed. 0xFFFFFFFFFFFFFFDF = -33.
  pub let RT_E_BAD_FIELD    : u64 = 0xFFFFFFFFFFFFFFDF

  // Default values written by rt_init.
  //   my_ip   = 10.0.0.2 = 0x0A000002
  //   gw_ip   = 10.0.0.1 = 0x0A000001
  //   netmask = 255.255.255.0 = 0xFFFFFF00 (/24, matches QEMU SLIRP's
  //            10.0.2.0/24 topology in principle -- the R92 defaults
  //            keep the pre-R92 10.0.0.x prefix for boot compat; DHCP
  //            (R93) is what actually installs a QEMU SLIRP lease).
  //   mtu     = 1500
  pub let RT_DEFAULT_MY_IP_B0   : u64 = 10
  pub let RT_DEFAULT_MY_IP_B1   : u64 = 0
  pub let RT_DEFAULT_MY_IP_B2   : u64 = 0
  pub let RT_DEFAULT_MY_IP_B3   : u64 = 2
  pub let RT_DEFAULT_GW_IP_B0   : u64 = 10
  pub let RT_DEFAULT_GW_IP_B1   : u64 = 0
  pub let RT_DEFAULT_GW_IP_B2   : u64 = 0
  pub let RT_DEFAULT_GW_IP_B3   : u64 = 1
  pub let RT_DEFAULT_NETMASK_B0 : u64 = 255
  pub let RT_DEFAULT_NETMASK_B1 : u64 = 255
  pub let RT_DEFAULT_NETMASK_B2 : u64 = 255
  pub let RT_DEFAULT_NETMASK_B3 : u64 = 0
  pub let RT_DEFAULT_MTU        : u64 = 1500
  // R93.M1-004 (paideia-os #2046): DNS default = 0.0.0.0 (i.e. "no
  // resolver configured yet"). dns_resolve returns cleanly-refused
  // on a zero dns_ip so a caller running before DHCP settles gets a
  // deterministic failure rather than a random target read.
  pub let RT_DEFAULT_DNS_IP_B0  : u64 = 0
  pub let RT_DEFAULT_DNS_IP_B1  : u64 = 0
  pub let RT_DEFAULT_DNS_IP_B2  : u64 = 0
  pub let RT_DEFAULT_DNS_IP_B3  : u64 = 0

  // ============================================================================
  // Route record (four .bss symbols; jointly one row)
  // ============================================================================
  //
  // Migration note: these four symbols HOLD storage that pre-R92 lived
  // in two rodata declarations in net/ipv4.pdx (_ipv4_my_ip,
  // _ipv4_gw_ip). The symbols keep their names so every existing byte-
  // level reader in arp.pdx / ipv4.pdx / icmp.pdx / udp_socket.pdx
  // continues to load them via `[rip + _ipv4_my_ip + N]` unchanged --
  // the change is that they are now `pub let mut` .bss (writable by
  // rt_init at boot and by route_table_set at runtime) rather than
  // link-time rodata. The prior rodata declarations in ipv4.pdx are
  // deleted with this landing.

  pub let mut _ipv4_my_ip    : [u8; 4] = uninit @align(4)
  pub let mut _ipv4_gw_ip    : [u8; 4] = uninit @align(4)
  pub let mut _ipv4_netmask  : [u8; 4] = uninit @align(4)
  pub let mut _ipv4_mtu      : u64     = 0
  // R93.M1-004 (paideia-os #2046): DNS server slot. Named symbol
  // rather than a byte offset into a shared blob so a future R94+
  // multi-resolver structure can widen this without every reader
  // reprocessing a fixed-offset table (see file header §1).
  pub let mut _ipv4_dns_ip   : [u8; 4] = uninit @align(4)

  // Bump counter -- number of route_table_set calls observed. Not on
  // any hot path; exists so a future audit can prove DHCP wrote to the
  // record (R93.M1-004 wire-in cross-check).
  pub let mut _rt_set_count  : u64     = 0

  // ============================================================================
  // rt_init() -> ()
  // ============================================================================
  //
  // SysV: () -> ()
  //
  // Seed the four route fields with the pre-R92 rodata defaults so any
  // reader that runs before route_table_set / DHCP sees stable bytes.
  // Called from kernel_main.pdx immediately before nic_dispatch_probe.
  //
  // Register plan: leaf; no callee-save pushes. Every byte store is
  // an unconditional immediate move; no branches.

  pub let rt_init : () -> () !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R92.M1-001 (paideia-os #2034). Seed the route record's four fields with the pre-R92 rodata defaults so every existing reader (arp.pdx, ipv4.pdx, icmp.pdx, udp_socket.pdx) sees stable bytes on first read. Twelve mov_b immediate stores for the three IP fields (my_ip=10.0.0.2, gw_ip=10.0.0.1, netmask=255.255.255.0) plus one u64 store for mtu=1500. No branches, no calls. Cap set {boot} matches the surrounding kernel_main pre-scheduler call chain. Reserved labels: rt_.",
      block: {
        // my_ip = 10.0.0.2
        mov rax, 10;
        mov_b [rip + _ipv4_my_ip + 0], rax;
        xor rax, rax;
        mov_b [rip + _ipv4_my_ip + 1], rax;
        mov_b [rip + _ipv4_my_ip + 2], rax;
        mov rax, 2;
        mov_b [rip + _ipv4_my_ip + 3], rax;

        // gw_ip = 10.0.0.1
        mov rax, 10;
        mov_b [rip + _ipv4_gw_ip + 0], rax;
        xor rax, rax;
        mov_b [rip + _ipv4_gw_ip + 1], rax;
        mov_b [rip + _ipv4_gw_ip + 2], rax;
        mov rax, 1;
        mov_b [rip + _ipv4_gw_ip + 3], rax;

        // netmask = 255.255.255.0
        mov rax, 255;
        mov_b [rip + _ipv4_netmask + 0], rax;
        mov_b [rip + _ipv4_netmask + 1], rax;
        mov_b [rip + _ipv4_netmask + 2], rax;
        xor rax, rax;
        mov_b [rip + _ipv4_netmask + 3], rax;

        // mtu = 1500
        mov rax, 1500;
        mov [rip + _ipv4_mtu], rax;

        // R93.M1-004 (paideia-os #2046): dns_ip = 0.0.0.0 (unconfigured).
        xor rax, rax;
        mov_b [rip + _ipv4_dns_ip + 0], rax;
        mov_b [rip + _ipv4_dns_ip + 1], rax;
        mov_b [rip + _ipv4_dns_ip + 2], rax;
        mov_b [rip + _ipv4_dns_ip + 3], rax;

        ret
      }
    }

  // ============================================================================
  // route_table_set(field_id, value) -> u64
  // ============================================================================
  //
  // SysV: (field_id: u64, value: u64) -> u64
  //   rdi = field_id (0..RT_FIELD_COUNT-1)
  //   rsi = value    (packed u32 host-word for IP fields; native u64
  //                   for MTU)
  //
  // Returns rax:
  //   RT_OK           (0)                 on success.
  //   RT_E_BAD_FIELD  (0xFFFF...DF)       when field_id >= RT_FIELD_COUNT.
  //
  // Bounds-check-then-single-store discipline (mirrors driver_table.pdx's
  // driver_table_register): the field_id is validated at entry; on the
  // happy path the four wire-order bytes (or the single u64 for MTU)
  // are written and RT_OK returns. On the sad path no write happens.
  //
  // Register plan: leaf; no callee-save pushes. rax stashes bytes during
  // the wire-order shuffle. rdi/rsi survive through the dispatch (they
  // are caller-save but not clobbered before the jump-back).

  pub let route_table_set : (u64, u64) -> u64 !{mem} @{} =
    fn (field_id: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R92.M1-002 (paideia-os #2035). Route-table setter with bounds-check-then-single-store discipline. Body: (1) bounds-check field_id >= RT_FIELD_COUNT (4) -> RT_E_BAD_FIELD. (2) cmp/je dispatch over the four field ids. (3) IP arms (0/1/2): extract four wire-order bytes from `value` via shr/and pairs and mov_b store at [rip + <field> + N]. (4) MTU arm (3): single u64 store at [rip + _ipv4_mtu]. (5) Bump _rt_set_count for audit visibility. (6) Return RT_OK. Every arm converges at rt_ok_ret. No callee-save pushes needed -- rax carries the current byte across shr/and, no nested calls. Labels prefixed rt_ (rt_bad_field, rt_do_my_ip, rt_do_gw_ip, rt_do_netmask, rt_do_mtu, rt_ok_ret). Encoder-conservative: xor+mov_b sequence for byte loads is unused here (we only STORE), mov_b for byte stores, [reg+imm] addressing.",
      block: {
        // (1) Bounds check. R93.M1-004 (paideia-os #2046): widened from
        // 4 to 5 for RT_FIELD_DNS_IP (id=4).
        cmp rdi, 5;                               // RT_FIELD_COUNT
        jae rt_bad_field;

        // (2) Dispatch on field_id.
        cmp rdi, 0;                               // RT_FIELD_MY_IP
        je  rt_do_my_ip;
        cmp rdi, 1;                               // RT_FIELD_GW_IP
        je  rt_do_gw_ip;
        cmp rdi, 2;                               // RT_FIELD_NETMASK
        je  rt_do_netmask;
        cmp rdi, 3;                               // RT_FIELD_MTU
        je  rt_do_mtu;
        cmp rdi, 4;                               // RT_FIELD_DNS_IP
        je  rt_do_dns_ip;
        jmp rt_bad_field;                         // unreachable (bounds gate above)

        // ----------------------------------------------------------------
        // MY_IP: value packed as (b0<<24)|(b1<<16)|(b2<<8)|b3.
        // ----------------------------------------------------------------
      rt_do_my_ip:
        mov rax, rsi;
        shr rax, 24;
        and rax, 0xFF;
        mov_b [rip + _ipv4_my_ip + 0], rax;
        mov rax, rsi;
        shr rax, 16;
        and rax, 0xFF;
        mov_b [rip + _ipv4_my_ip + 1], rax;
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rip + _ipv4_my_ip + 2], rax;
        mov rax, rsi;
        and rax, 0xFF;
        mov_b [rip + _ipv4_my_ip + 3], rax;
        jmp rt_ok_ret;

        // ----------------------------------------------------------------
        // GW_IP: same packing.
        // ----------------------------------------------------------------
      rt_do_gw_ip:
        mov rax, rsi;
        shr rax, 24;
        and rax, 0xFF;
        mov_b [rip + _ipv4_gw_ip + 0], rax;
        mov rax, rsi;
        shr rax, 16;
        and rax, 0xFF;
        mov_b [rip + _ipv4_gw_ip + 1], rax;
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rip + _ipv4_gw_ip + 2], rax;
        mov rax, rsi;
        and rax, 0xFF;
        mov_b [rip + _ipv4_gw_ip + 3], rax;
        jmp rt_ok_ret;

        // ----------------------------------------------------------------
        // NETMASK: same packing.
        // ----------------------------------------------------------------
      rt_do_netmask:
        mov rax, rsi;
        shr rax, 24;
        and rax, 0xFF;
        mov_b [rip + _ipv4_netmask + 0], rax;
        mov rax, rsi;
        shr rax, 16;
        and rax, 0xFF;
        mov_b [rip + _ipv4_netmask + 1], rax;
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rip + _ipv4_netmask + 2], rax;
        mov rax, rsi;
        and rax, 0xFF;
        mov_b [rip + _ipv4_netmask + 3], rax;
        jmp rt_ok_ret;

        // ----------------------------------------------------------------
        // MTU: native u64 store.
        // ----------------------------------------------------------------
      rt_do_mtu:
        mov [rip + _ipv4_mtu], rsi;
        jmp rt_ok_ret;

        // ----------------------------------------------------------------
        // DNS_IP: same packing as MY_IP / GW_IP / NETMASK.
        // R93.M1-004 (paideia-os #2046).
        // ----------------------------------------------------------------
      rt_do_dns_ip:
        mov rax, rsi;
        shr rax, 24;
        and rax, 0xFF;
        mov_b [rip + _ipv4_dns_ip + 0], rax;
        mov rax, rsi;
        shr rax, 16;
        and rax, 0xFF;
        mov_b [rip + _ipv4_dns_ip + 1], rax;
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rip + _ipv4_dns_ip + 2], rax;
        mov rax, rsi;
        and rax, 0xFF;
        mov_b [rip + _ipv4_dns_ip + 3], rax;
        jmp rt_ok_ret;

      rt_ok_ret:
        // Bump audit counter and return RT_OK.
        mov rax, [rip + _rt_set_count];
        add rax, 1;
        mov [rip + _rt_set_count], rax;
        xor rax, rax;                             // RT_OK
        ret;

      rt_bad_field:
        mov rax, 0xFFFFFFFFFFFFFFDF;              // RT_E_BAD_FIELD
        ret
      }
    }

  // ============================================================================
  // route_table_get(field_id) -> u64
  // ============================================================================
  //
  // SysV: (field_id: u64) -> u64
  //   rdi = field_id (0..RT_FIELD_COUNT-1)
  //
  // Returns rax:
  //   IP fields:  packed u32 host-word (b0<<24)|(b1<<16)|(b2<<8)|b3
  //   MTU field:  the native u64
  //   Bad field:  RT_E_BAD_FIELD (0xFFFF...DF)
  //
  // Register plan: leaf; no callee-save pushes. rax accumulates the
  // packed host-word via four xor+mov_b/shl/or sequences (canonical
  // ipv4_tx_send / arp_rx_handle shape).

  pub let route_table_get : (u64) -> u64 !{mem} @{} =
    fn (field_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R92.M1-002 (paideia-os #2035). Route-table getter with same bounds-check discipline as the setter. Body: (1) bounds-check field_id >= RT_FIELD_COUNT (4) -> RT_E_BAD_FIELD. (2) cmp/je dispatch over the four field ids. (3) IP arms (0/1/2): assemble host-word from four wire-order bytes via xor+mov_b/shl/or (canonical ipv4_tx_send / arp_rx_handle idiom). (4) MTU arm (3): single u64 load from [rip + _ipv4_mtu]. Every arm returns via rt_get_ret. No callee-save pushes needed. Labels prefixed rt_get_. Encoder-conservative: xor+mov_b for byte loads (avoids mov_bzx), [reg+imm] addressing.",
      block: {
        // (1) Bounds check. R93.M1-004 widened from 4 to 5 for DNS_IP.
        cmp rdi, 5;                               // RT_FIELD_COUNT
        jae rt_get_bad_field;

        // (2) Dispatch.
        cmp rdi, 0;
        je  rt_get_my_ip;
        cmp rdi, 1;
        je  rt_get_gw_ip;
        cmp rdi, 2;
        je  rt_get_netmask;
        cmp rdi, 3;
        je  rt_get_mtu;
        cmp rdi, 4;
        je  rt_get_dns_ip;
        jmp rt_get_bad_field;

        // ----------------------------------------------------------------
        // MY_IP: canonical wire-order host-word.
        // ----------------------------------------------------------------
      rt_get_my_ip:
        xor rax, rax;
        mov_b rax, [rip + _ipv4_my_ip + 0];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_my_ip + 1];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_my_ip + 2];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_my_ip + 3];
        or  rax, rcx;
        ret;

      rt_get_gw_ip:
        xor rax, rax;
        mov_b rax, [rip + _ipv4_gw_ip + 0];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_gw_ip + 1];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_gw_ip + 2];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_gw_ip + 3];
        or  rax, rcx;
        ret;

      rt_get_netmask:
        xor rax, rax;
        mov_b rax, [rip + _ipv4_netmask + 0];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_netmask + 1];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_netmask + 2];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_netmask + 3];
        or  rax, rcx;
        ret;

      rt_get_mtu:
        mov rax, [rip + _ipv4_mtu];
        ret;

      rt_get_dns_ip:
        xor rax, rax;
        mov_b rax, [rip + _ipv4_dns_ip + 0];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_dns_ip + 1];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_dns_ip + 2];
        or  rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _ipv4_dns_ip + 3];
        or  rax, rcx;
        ret;

      rt_get_bad_field:
        mov rax, 0xFFFFFFFFFFFFFFDF;              // RT_E_BAD_FIELD
        ret
      }
    }
}
