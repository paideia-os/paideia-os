// src/kernel/core/net/l2_rx.pdx — R27-M3-002 / R27-M3-004 (#982 / #984)
//
// L2 receive dispatch: length + destination-address filter + ethertype
// demux. #984 adds the broadcast-accept / non-broadcast-multicast-drop
// filter shape (unicast is admitted unconditionally at M3; the MAC
// filter proper is enforced in HW via the RAR[0] entry programmed by
// e1000e_program_rar (R27.M1 mac.pdx), so software-side unicast
// admission is a no-op).
//
// -----------------------------------------------------------------------------
// Dispatch table (R27.M3 shape; entries wired in through R27.M5)
// -----------------------------------------------------------------------------
//
//   ethertype = 0x0800 (IPv4)     -> ipv4_rx_handle (real handler, R27.M5)
//   ethertype = 0x0806 (ARP)      -> arp_rx_handle  (real handler, R27.M4)
//   ethertype = other             -> drop, bump _l2_rx_unknown_cnt
//
// The stubs are callable symbols with the (frame_pa, frame_len) shape
// the real handlers will consume. They emit a `L2 RX IPV4/ARP`
// fingerprint and return 0 so an M3 fixture that injects synthetic
// frames observes the dispatch decision without an active protocol
// engine.
//
// -----------------------------------------------------------------------------
// Address filter shape (#984)
// -----------------------------------------------------------------------------
//
//   dst == FF:FF:FF:FF:FF:FF     -> accept (broadcast; required for ARP)
//   dst[0] & 0x01, non-broadcast -> drop  (multicast; deferred R31+)
//   otherwise                    -> accept (unicast; RAR-filtered by HW)
//
// The multicast-drop path exists so that ARP-boot fixtures which stress
// the L2 filter with mDNS / SSDP background chatter don't spend cycles
// dispatching multicast frames the M3 stack has no handler for. The
// counter `_l2_rx_mcast_drops` is observable across boots for the
// R31 multicast-table sizing exercise.
//
// -----------------------------------------------------------------------------
// R27.M3 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// l2_rx_handle is called from e1000e_irq_handler (irq.pdx) on every
// descriptor with STA.DD=1. That handler is itself a callable symbol
// pending R23+ IDT-vector wiring — at M3 the entire dispatch path is
// symbol-only.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: byte MAC field loads route via mov_b.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `l2rx_`, `mbc_` (mac_is
// _broadcast), and `mmc_` (mac_is_multicast).

module L2Rx = structure {

  // ============================================================================
  // Canonical .bss slots
  // ============================================================================
  //
  // _l2_rx_hdr             : 14-byte Ethernet header scratch (16 B stored
  //                          for u64-alignment / natural stride)
  // _l2_rx_pkts            : cumulative accepted-and-dispatched frame count
  // _l2_rx_unknown_cnt     : ethertypes outside the M3 table (#982 §Goal)
  // _l2_rx_mcast_drops     : non-broadcast multicast drops (#984 §AC)

  pub let mut _l2_rx_hdr             : [u64; 2] = uninit @align(8)
  pub let mut _l2_rx_pkts            : u64      = 0
  pub let mut _l2_rx_unknown_cnt     : u64      = 0
  pub let mut _l2_rx_mcast_drops     : u64      = 0

  // ============================================================================
  // mac_is_broadcast(mac_ptr) -> u64  — #984
  // ============================================================================
  //
  // SysV: (mac_ptr: u64) -> u64
  //   rdi = pointer to a 6-byte MAC
  //
  // Returns rax = 1 if all six bytes are 0xFF, 0 otherwise.
  //
  // Leaf function; no callee-save.

  pub let mac_is_broadcast : (u64) -> u64 !{mem} @{} =
    fn (mac_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M3-004 (#984). Ethernet broadcast test: return 1 iff mac[0..5] == 0xFF. Body: (1) rax = 1 optimistic. (2) Walk a moving base pointer (rdx = rdi) with a count-down in rcx (paideia-as v0.22 accepts only [reg+imm], no [base+index] SIB form yet — G6). Loop `mbc_loop`: cmp rcx, 0; je mbc_done; load byte via `xor r10,r10; mov_b r10,[rdx+0]`; if r10 != 0xFF -> mbc_no; add rdx,1; sub rcx,1; loop. (3) mbc_done: rax already 1, ret. (4) mbc_no: xor rax,rax; ret. Leaf; no callee-save. Reserved labels: `mbc_`.",
      block: {
        mov rax, 1;
        mov rdx, rdi;                            // walking ptr
        mov rcx, 6;                              // count

      mbc_loop:
        cmp rcx, 0;
        je mbc_done;
        xor r10, r10;
        mov_b r10, [rdx + 0];
        cmp r10, 0xFF;
        jne mbc_no;
        add rdx, 1;
        sub rcx, 1;
        jmp mbc_loop;

      mbc_no:
        xor rax, rax;
        ret;

      mbc_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // mac_is_multicast(mac_ptr) -> u64  — #984
  // ============================================================================
  //
  // SysV: (mac_ptr: u64) -> u64
  //   rdi = pointer to a 6-byte MAC
  //
  // Returns rax = 1 if the multicast bit (LSB of MAC byte 0) is set,
  // 0 otherwise. Note: broadcast is a special case of multicast (all
  // six bytes 0xFF -> byte[0] & 0x01 == 1). Callers must check
  // `mac_is_broadcast` first when they need to distinguish.
  //
  // Leaf function; no callee-save.

  pub let mac_is_multicast : (u64) -> u64 !{mem} @{} =
    fn (mac_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M3-004 (#984). Ethernet multicast test: return 1 iff mac[0] & 0x01. Body: (1) xor rax,rax to clear upper bits. (2) mov_b rax, [rdi+0] — load byte 0. (3) and rax, 1 — isolate the I/G (Individual/Group) bit. (4) Return rax (0 or 1). Leaf; no callee-save. No labels required. Reserved labels: `mmc_` (defensive; not currently emitted).",
      block: {
        xor rax, rax;
        mov_b rax, [rdi + 0];
        and rax, 1;
        ret
      }
    } @no_frame

  // ============================================================================
  // ipv4_rx_stub — retired at R27.M5
  // ============================================================================
  //
  // The M3-era ipv4_rx_stub was a klog-fingerprint-only sentinel that
  // reserved the ethertype=0x0800 dispatch slot until the real IPv4
  // engine landed. R27.M5 (#989..#992) replaces it with the full
  // ipv4_rx_handle (src/kernel/core/net/ipv4.pdx), which retains the
  // same (frame_pa, frame_len) shape and emits a new "L3 RX IPV4"
  // fingerprint before parsing the header, verifying the checksum,
  // filtering by dst_ip, and demuxing by protocol into icmp_rx_stub
  // / udp_rx_stub (real handlers R27.M6).

  // ============================================================================
  // arp_rx_stub — retired at R27.M4
  // ============================================================================
  //
  // The M3-era arp_rx_stub was a klog-fingerprint-only sentinel that
  // reserved the ethertype=0x0806 dispatch slot until the real ARP
  // engine landed. R27.M4 (#985..#988) replaces it with the full
  // arp_rx_handle (src/kernel/core/net/arp.pdx), which retains the
  // same (frame_pa, frame_len) shape and emits the same "L2 RX ARP"
  // fingerprint before parsing the ARP body, caching the sender_ip
  // -> sender_mac binding, and (for ARP requests targeting our IP)
  // unicasting a reply back via l2_tx_send.

  // ============================================================================
  // l2_rx_handle(frame_pa, frame_len) -> u64  — #982 / #984
  // ============================================================================
  //
  // SysV: (frame_pa: u64, frame_len: u64) -> u64
  //   rdi = physical address of the received Ethernet frame
  //         (identity-mapped under KERNEL_VMA_BASE)
  //   rsi = frame length in bytes (as reported by the RX descriptor's
  //         length field; excludes the HW-stripped 4-byte FCS)
  //
  // Returns rax = 0 on accepted-and-dispatched frame, 1 on parse /
  // length failure.
  //
  // Dispatch:
  //   frame_len < 14              -> return 1 (short frame)
  //   parse fails                 -> return 1 (all-zero header)
  //   dst == broadcast            -> accept
  //   dst multicast (non-bcast)   -> drop, bump _l2_rx_mcast_drops, return 0
  //   dst unicast                 -> accept (RAR-filtered by HW)
  //   ethertype = IPv4            -> ipv4_rx_handle, bump _l2_rx_pkts
  //   ethertype = ARP             -> arp_rx_handle,  bump _l2_rx_pkts
  //   ethertype = other           -> drop, bump _l2_rx_unknown_cnt
  //
  // Register plan (4-push callee-save + 8-byte pad):
  //   rbx = frame_pa (survives across nested calls)
  //   rbp = frame_len
  //   r12 = ethertype (host order)
  //
  //   4 pushes = 32 B; entry rsp%16==8 -> 40, sub rsp,8 -> 48, %16==0
  //   (aligned for eth_parse / mac_is_broadcast / mac_is_multicast /
  //   ipv4_rx_stub / arp_rx_handle / klog nested calls without extra pad).

  pub let l2_rx_handle : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (frame_pa: u64, frame_len: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R27-M3-002 (#982) + R27-M3-004 (#984). L2 receive dispatch. Body: (1) 4-push callee-save (rbx=frame_pa, rbp=frame_len, r12=ethertype scratch, r13=unused reservation) + `sub rsp,8` — 32 + 8 = 40; entry rsp%16==8 -> 48, %16==0 (aligned for every nested call). (2) Length check: cmp rbp, 14; jb l2rx_bad — an Ethernet II frame is at least 14 header bytes; RX descriptors reporting less are truncated / spurious. (3) Parse: eth_parse(frame_pa, &_l2_rx_hdr). If rax == 0 -> l2rx_bad (all-zero header, invalid). (4) Broadcast filter: mac_is_broadcast(&_l2_rx_hdr) — dst_mac is at offset +0 so the header base is the dst pointer. If rax==1 -> l2rx_accept. (5) Multicast filter: mac_is_multicast(&_l2_rx_hdr). If rax==0 (unicast, not broadcast — HW RAR already gated it) -> l2rx_accept. Otherwise multicast: bump _l2_rx_mcast_drops, return 0. (6) l2rx_accept: load ethertype (big-endian u16 @ hdr+12) as `high<<8 | low` — no bswap needed because we're constructing the host-order value byte-by-byte. (7) Dispatch: cmp/je against 0x0800 -> l2rx_ipv4, 0x0806 -> l2rx_arp. Fall-through: bump _l2_rx_unknown_cnt, return 0. (8) l2rx_ipv4: ipv4_rx_stub(rbx, rbp); bump _l2_rx_pkts; return 0. (9) l2rx_arp: arp_rx_handle(rbx, rbp); bump _l2_rx_pkts; return 0 (R27.M4 replaced the M3 arp_rx_stub with the full arp_rx_handle engine in core/net/arp.pdx). (10) l2rx_bad: mov rax, 1. All exits go through l2rx_ret which restores the frame. Reserved labels: `l2rx_`. Every nested callee preserves rbx/rbp/r12 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = frame_pa
        mov rbp, rsi;                            // rbp = frame_len

        // ============================================================
        // (2) Length gate.
        // ============================================================
        cmp rbp, 14;
        jb l2rx_bad;

        // ============================================================
        // (3) Parse into module-static scratch buffer.
        // ============================================================
        mov rdi, rbx;
        lea rsi, [rip + _l2_rx_hdr];
        call eth_parse;
        cmp rax, 0;
        je l2rx_bad;

        // ============================================================
        // (4) Broadcast?  (dst_mac is at hdr+0)
        // ============================================================
        lea rdi, [rip + _l2_rx_hdr];
        call mac_is_broadcast;
        cmp rax, 1;
        je l2rx_accept;

        // ============================================================
        // (5) Multicast (non-broadcast)?  Drop.
        // ============================================================
        lea rdi, [rip + _l2_rx_hdr];
        call mac_is_multicast;
        cmp rax, 0;
        je l2rx_accept;                          // unicast — HW-gated, accept

        // Multicast (non-broadcast): drop + count.
        mov rax, [rip + _l2_rx_mcast_drops];
        add rax, 1;
        mov [rip + _l2_rx_mcast_drops], rax;
        xor rax, rax;
        jmp l2rx_ret;

      l2rx_accept:
        // ============================================================
        // (6) Load ethertype (big-endian u16 @ hdr+12) into host order.
        // ============================================================
        xor rax, rax;
        mov_b rax, [rip + _l2_rx_hdr + 12];      // BE high byte
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _l2_rx_hdr + 13];      // BE low byte
        or rax, rcx;
        mov r12, rax;                            // r12 = ethertype (host order)

        // ============================================================
        // (7) Dispatch.
        // ============================================================
        cmp r12, 0x0800;                         // ETH_TYPE_IPV4
        je l2rx_ipv4;
        cmp r12, 0x0806;                         // ETH_TYPE_ARP
        je l2rx_arp;

        // Unknown ethertype: drop + count.
        mov rax, [rip + _l2_rx_unknown_cnt];
        add rax, 1;
        mov [rip + _l2_rx_unknown_cnt], rax;
        xor rax, rax;
        jmp l2rx_ret;

      l2rx_ipv4:
        mov rdi, rbx;
        mov rsi, rbp;
        call ipv4_rx_handle;
        mov rax, [rip + _l2_rx_pkts];
        add rax, 1;
        mov [rip + _l2_rx_pkts], rax;
        xor rax, rax;
        jmp l2rx_ret;

      l2rx_arp:
        mov rdi, rbx;
        mov rsi, rbp;
        call arp_rx_handle;
        mov rax, [rip + _l2_rx_pkts];
        add rax, 1;
        mov [rip + _l2_rx_pkts], rax;
        xor rax, rax;
        jmp l2rx_ret;

      l2rx_bad:
        mov rax, 1;

      l2rx_ret:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
