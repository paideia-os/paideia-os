// src/kernel/core/net/udp_socket.pdx -- R100-PREP-002 (#2008)
//
// Connected-UDP socket substrate: the cap-table <-> UDP session bridge
// behind sys_socket(AF_INET, SOCK_DGRAM, 0) + sys_{bind,connect,send,
// recv} on a UDP socket. Structural sibling of net/tcp_socket.pdx +
// net/tcp.pdx, deliberately DIFFERENT from the pre-R30-numbering-scheme
// KIND_UDP_SOCKET=0x50 posture in cap/udp_socket_cap.pdx (R27.M6 #994)
// -- that value is retired, not reused; a stale reference must fail
// loudly, not silently alias this new meaning.
//
// -----------------------------------------------------------------------------
// Scope discipline (R100-PREP-002 #2008)
// -----------------------------------------------------------------------------
//
// This landing implements CONNECTED-UDP semantics ONLY:
//   - sys_socket(AF_INET=2, SOCK_DGRAM=2, 0) mints a KIND_UDP_SOCKET
//     via udp_socket_new (state = UDP_ST_CLOSED).
//   - sys_bind(fd, local_port) transitions CLOSED -> BOUND without
//     issuing a UDP packet (no wire event -- claim of a local port).
//     Rebinding an already-bound/connected socket is refused (-EINVAL).
//   - sys_connect(fd, remote_ip, remote_port) sets a default peer with
//     no handshake. If the socket has never bound, an ephemeral local
//     port is auto-assigned first (matches TCP's sys_connect behavior).
//     Reconnecting an already-connected socket is refused (-EISCONN).
//   - sys_send(fd, buf, len) transmits one datagram to the default
//     peer. Message boundaries preserved: exactly one datagram per
//     call, no coalescing.
//   - sys_recv(fd, buf, len) dequeues one datagram from the rx ring.
//     Message boundaries preserved: exactly one datagram per call,
//     even if the user buffer is smaller than the pending datagram
//     (truncation, not blocking or coalescing). Non-blocking:
//     empty ring returns 0 rather than waiting.
//
// EXPLICITLY OUT OF SCOPE at this round (per issue #2008):
//   - sys_sendto / sys_recvfrom with per-call peer address (deferred).
//   - Off-box wire path via ipv4_tx_send (kernel-native wire never
//     exercised at this round; a comment marker is left where the
//     dispatch would land, per the udp_rx_handle port-7-only posture
//     R27.M6 shipped).
//   - Real per-port UDP RX dispatch (udp_rx_handle stays port-7-echo-
//     only per R27.M6 #996; the boot witness exercises loopback via
//     udp_socket_send's own local-delivery fast path, mirroring TCP's
//     tcp_send_segment loopback fast path).
//   - Any userspace-IPC-RPC delivery path (the R27.M6 KIND_UDP_SOCKET=
//     0x50 posture is retired).
//   - sys_close on a UDP socket (no teardown syscall this round; the
//     minted cap and socket row persist for the boot; boot witness
//     leaves both allocated, matching r72_tcp_echo's identical
//     posture).
//
// -----------------------------------------------------------------------------
// KIND assignment
// -----------------------------------------------------------------------------
//
//   KIND_UDP_SOCKET   (0x1A8) -- root-minted over KIND_IPC_ENDPOINT
//                       (base=5), matching KIND_TCP_SOCKET's own
//                       posture. Rights are fixed at UDP_SOCKET_RIGHTS
//                       = R_SOCKET_READ|R_SOCKET_WRITE|R_SOCKET_LISTEN|
//                         R_SOCKET_CONNECT = 0x00F for every mint (R95.
//                       M4-002 update -- see below; pre-R95 the value
//                       was 0x00B for READ|WRITE|INVOKE). Identical
//                       bits + numeric value to TCP_SOCKET_RIGHTS at
//                       both rounds.
//
// The R91.M1 KIND_NIC reservation at 0x1A7 was displaced by
// R100-PREP-001 landing KIND_TLS_TRUST at that ordinal (#2007);
// 0x1A8 was reserved for KIND_UDP_SOCKET by R93.M2-001 per
// `design/architecture/next-wave-derived-kinds.md`'s R91-R99 block
// and remains free -- this landing takes it. Full landed-form entry
// is backfilled into that document alongside this file.
//
// -----------------------------------------------------------------------------
// UDP socket row layout (128 bytes, _udp_socket_table[16])
// -----------------------------------------------------------------------------
//
//   +0    state              (u64) 0=CLOSED, 1=BOUND, 2=CONNECTED
//   +8    local_port         (u64, low 16 bits meaningful; 0 = unbound)
//   +16   peer_port          (u64, low 16 bits meaningful)
//   +24   peer_ip            (4 bytes byte-indexed @+24..+27, rest 0;
//                             same shape as tcp_tcb_table's remote_ip
//                             field, so ipv4-cmp/copy code paths are
//                             byte-identical between the two)
//   +32   in_use             (u64) 0 = free row, 1 = allocated
//   +40   rx_head            (u64) next dgram slot to READ (0..QDEPTH-1)
//   +48   rx_tail            (u64) next dgram slot to WRITE (0..QDEPTH-1)
//   +56   rx_count           (u64) pending dgrams (0..QDEPTH)
//   +64   so_error           (u64) SO_ERROR slot: last async error
//                             (Linux errno as signed 32b in low half;
//                             sys_getsockopt SO_ERROR reads then
//                             clears). R95.M1-002 (#2077).
//   +72   so_flags           (u64) bit 0 = SO_REUSEADDR (informational
//                             MVP -- no bind-collision check today);
//                             bit 1 = SO_NONBLOCK (informational MVP
//                             -- recv already returns 0 on empty ring,
//                             so blocking-vs-not is a no-op difference
//                             for UDP today). R95.M1-001 (#2076).
//   +80..127 reserved        (spare for R101+ options / peer_credentials)
//
// -----------------------------------------------------------------------------
// RX ring layout
// -----------------------------------------------------------------------------
//
// Per-socket rx ring is a bounded circular queue of at most
// UDP_QUEUE_DEPTH=4 pending datagrams. Two parallel tables keep the
// slot-address arithmetic pure power-of-two shifts (no imul) and
// separate the metadata (length) from the payload:
//
//   _udp_rx_dgram_data[16][4][1024]  = 65536 bytes -- one 1024-byte
//                                       payload slot per (socket, dgram)
//                                       pair. Slot address:
//                                         &data + (sock_idx << 12)
//                                                + (slot_idx << 10)
//                                       (i.e. sock*4*1024 + slot*1024).
//   _udp_rx_dgram_lens[16][4]        = 128 bytes -- one u64 per slot
//                                       holding the actual datagram
//                                       length (0..UDP_DGRAM_MAX=1024).
//                                       Slot address:
//                                         &lens + ((sock<<2)+slot)*8
//                                             i.e. (sock<<5)+(slot<<3).
//
// Message boundary preservation: recv() consumes exactly one dgram
// slot regardless of how many payload bytes the caller's buffer can
// hold. If the caller's len < dgram_len, the excess bytes are
// discarded rather than left for the next recv() -- matches Linux
// SOCK_DGRAM semantics (MSG_TRUNC posture).
//
// Ring overflow (send lands on a receiver whose rx ring already holds
// UDP_QUEUE_DEPTH dgrams) drops the incoming datagram silently -- UDP
// is unreliable by contract, and any user-visible "queue full" signal
// would let a slow reader deny service to the sender. The sender's
// send() still returns len (the bytes it handed to the stack), matching
// Linux behavior on a lossy path.
//
// -----------------------------------------------------------------------------
// Loopback fast path
// -----------------------------------------------------------------------------
//
// udp_socket_send_body compares the connected peer_ip against
// _ipv4_my_ip. On a match (the ONLY case boot_r100_udp_socket
// exercises -- same posture r72_tcp_echo takes for TCP), it looks up
// the destination socket by peer_port via udp_socket_find_by_local_
// port and enqueues the datagram directly into that socket's rx ring
// via udp_socket_deliver_dgram, bypassing udp_build / ipv4_tx_send /
// the e1000e ring entirely. Recursion depth is bounded at 1 by the
// enqueue itself.
//
// Off-box (peer_ip != local_ip) currently falls through to a silent
// success return -- the wire path (udp_build over a socket-owned
// scratch + ipv4_tx_send) is DEFERRED to R93.M2. This matches r72_
// tcp_echo's stance: the loopback path is the only exercised path
// this round, and honestly stubbing the wire path is preferable to
// pretending it works. The dispatch marker is left in the body so
// R93.M2 knows where to graft the real call.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline: `usock_` prefix throughout (mirrors
// tcp_socket.pdx's `sock_` prefix, prefixed differently to avoid
// collisions in the shared translation unit).
//
// paideia-as encoder-gap posture: G1 (byte stores route via mov_b),
// G6 ([reg+imm] addressing only). Frame prologue implicit. All row-offset
// arithmetic uses shl (not imul); all row sizes are powers of two.

module UdpSocket = structure {

  // ============================================================================
  // Kind + rights
  // ============================================================================

  // Landed KIND_UDP_SOCKET ordinal. Distinct-value coexistence with the
  // retired UdpSocketCap.KIND_UDP_SOCKET = 0x50 (pre-R30 numbering,
  // R27.M6 #994) is safe because paideia-as isolates constants by
  // module; the literal 0x1A8 is inlined at every use site (matching
  // sys_bind.pdx / sys_connect.pdx / sys_send.pdx / sys_recv.pdx's
  // pattern for KIND_TCP_SOCKET=0x1AB), so no cross-module symbol
  // resolution routes through this constant.
  pub let KIND_UDP_SOCKET   : u64 = 0x1A8

  // R95.M4-001 (paideia-os #2083): socket rights bits. The pre-R95 name
  // for these three bits was READ/WRITE/INVOKE (0x1/0x2/0x8). R95 renames
  // bit 3 CONNECT (same value, more precise semantics for connect()) and
  // adds bit 2 LISTEN so listen()/accept() can be gated distinctly from
  // send()/recv(). Every existing socket handler (bind/connect/listen/
  // accept/send/recv/shutdown) checks the corresponding bit via
  // sock_cap_check_rights before proceeding; the default mint below now
  // grants all four bits (0x00F = additive superset of the pre-R95 0x00B
  // triad + the new LISTEN bit), so every pre-R95 test path continues to
  // observe cap-permitted behavior. R96 will introduce the privileged-
  // port gate that refines this default mint.
  pub let R_SOCKET_READ    : u64 = 0x001
  pub let R_SOCKET_WRITE   : u64 = 0x002
  pub let R_SOCKET_LISTEN  : u64 = 0x004
  pub let R_SOCKET_CONNECT : u64 = 0x008

  // R96.M4-001 (paideia-os #2092): R_NET_PRIVILEGED_PORT bit. Mirror
  // of TcpSocket.R_NET_PRIVILEGED_PORT (see net/tcp_socket.pdx for the
  // full rationale). Byte-identical value because sock_cap_check_rights
  // is kind-agnostic and consults a single rights mask across both
  // KIND_TCP_SOCKET and KIND_UDP_SOCKET. Default UDP_SOCKET_RIGHTS
  // below stays at 0x00F -- the privileged-port bit is NOT granted at
  // default mint, so a UDP caller wanting to bind a port < 1024 must
  // explicitly request the widened rights (deferred surface).
  pub let R_NET_PRIVILEGED_PORT : u64 = 0x010

  // Default mint at sys_socket(AF_INET, SOCK_DGRAM, 0). All four bits so
  // the R95 rights gates transition additively: existing R72/R100-PREP
  // witnesses observe the same permitted-op set they always had, and R96
  // is free to whittle bits off at mint time for a privileged-port gate.
  pub let UDP_SOCKET_RIGHTS : u64 = 0x00F   // READ | WRITE | LISTEN | CONNECT

  // ============================================================================
  // Sizes + limits
  // ============================================================================

  pub let UDP_SOCKET_MAX    : u64 = 16
  pub let UDP_SOCKET_ROW    : u64 = 128
  pub let UDP_QUEUE_DEPTH   : u64 = 4
  pub let UDP_DGRAM_MAX     : u64 = 1024

  // ============================================================================
  // State machine
  // ============================================================================

  pub let UDP_ST_CLOSED     : u64 = 0
  pub let UDP_ST_BOUND      : u64 = 1
  pub let UDP_ST_CONNECTED  : u64 = 2

  pub let UDP_NONE          : u64 = 0xFFFFFFFFFFFFFFFF

  // Negative-errno sentinels (u64 two's-complement, matching Linux
  // errno signs per the rest of this tree's syscall bodies + the
  // TcpSocket SOCK_ERR_* set).
  pub let UDP_ERR_ENOBUFS   : u64 = 0xFFFFFFFFFFFFFF97   // -ENOBUFS  (-105)
  pub let UDP_ERR_ENFILE    : u64 = 0xFFFFFFFFFFFFFFE9   // -ENFILE   (-23)
  pub let UDP_ERR_EBADF     : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF    (-9)
  pub let UDP_ERR_EINVAL    : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL   (-22)
  pub let UDP_ERR_EISCONN   : u64 = 0xFFFFFFFFFFFFFF96   // -EISCONN  (-106)
  pub let UDP_ERR_ENOTCONN  : u64 = 0xFFFFFFFFFFFFFF95   // -ENOTCONN (-107)

  // ============================================================================
  // .bss -- socket pool + per-socket rx dgram rings
  // ============================================================================

  pub let mut _udp_socket_table       : [u8; 2048]  = uninit @align(8)   // 16 * 128
  pub let mut _udp_rx_dgram_data      : [u8; 65536] = uninit @align(8)   // 16 * 4 * 1024
  pub let mut _udp_rx_dgram_lens      : [u8; 128]   = uninit @align(8)   // 16 * 4 * 8

  pub let mut _udp_next_ephemeral_port : u64 = 45000

  // ============================================================================
  // udp_next_ephemeral_port() -> u64
  // ============================================================================
  //
  // Sibling of tcp_next_ephemeral_port. Distinct starting value (45000
  // vs TCP's 40000) so a mixed-workload boot cannot accidentally alias
  // ports between the two families in a debug trace.

  pub let udp_next_ephemeral_port : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): monotonic ephemeral local-port counter for sys_connect callers that did not sys_bind first. Starts at 45000; no wraparound handling or reuse check at MVP (a boot exhausting 20000+ ephemeral ports is out of scope). Distinct starting value from tcp_next_ephemeral_port (40000) so a mixed-workload debug trace cannot accidentally alias between families. Leaf.",
      block: {
        mov rax, [rip + _udp_next_ephemeral_port];
        mov rcx, rax;
        add rcx, 1;
        mov [rip + _udp_next_ephemeral_port], rcx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_alloc() -> sock_idx | UDP_NONE
  // ============================================================================
  //
  // Linear scan of the 16-entry pool for in_use==0 (offset +32). On a
  // hit, zeroes the full 128-byte row before stamping defaults, so no
  // field from a prior connection can leak into a fresh mint.

  pub let udp_socket_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): linear scan of the 16-entry UDP socket pool for in_use==0 (offset +32). Row size 128, so slot offset = idx << 7 (no imul). On a hit, zero the full 128-byte row (16 x 8-byte stores) before stamping in_use=1 -- the same 'zero before reuse' posture tcp_alloc_tcb takes for its own row. Leaf: no nested calls, rax/rcx/rdx/r8/r9/r10 caller-save scratch only, no prologue. Labels prefixed usock_alloc_.",
      block: {
        xor rcx, rcx;
        lea rax, [rip + _udp_socket_table];

      usock_alloc_scan:
        cmp rcx, 16;
        jae usock_alloc_none;
        mov rdx, rcx;
        shl rdx, 7;                            // slot offset = idx * 128
        mov r8, [rax + rdx + 32];              // in_use
        cmp r8, 0;
        je usock_alloc_found;
        add rcx, 1;
        jmp usock_alloc_scan;

      usock_alloc_found:
        mov r9, rax;
        add r9, rdx;                           // r9 = row base

        xor rax, rax;
        xor r10, r10;
      usock_alloc_zero:
        cmp r10, 128;
        jae usock_alloc_zero_done;
        mov [r9 + r10], rax;
        add r10, 8;
        jmp usock_alloc_zero;

      usock_alloc_zero_done:
        mov rax, 1;
        mov [r9 + 32], rax;                    // in_use = 1
        mov rax, rcx;                          // return idx
        ret;

      usock_alloc_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // udp_socket_free(sock_idx) -> ()
  // ============================================================================

  pub let udp_socket_free : (u64) -> () !{mem} @{} =
    fn (sock_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): clear in_use (@+32) and state (@+0) for sock_idx, returning the row to udp_socket_alloc's free scan. Does not zero the full row here (udp_socket_alloc zeroes on (re)allocation instead) -- avoids a double zero-pass on the common close-then-reuse path. Leaf.",
      block: {
        mov rax, rdi;
        shl rax, 7;                            // slot offset
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;
        xor rax, rax;
        mov [rcx + 32], rax;                   // in_use = 0
        mov [rcx + 0], rax;                    // state = CLOSED
        ret
      }
    }

  // ============================================================================
  // udp_socket_find_by_local_port(local_port) -> sock_idx | UDP_NONE
  // ============================================================================
  //
  // Linear scan for an in-use socket whose local_port (@+8) matches.
  // State must be non-CLOSED (i.e. BOUND or CONNECTED) since a CLOSED
  // socket does not own any port yet.

  pub let udp_socket_find_by_local_port : (u64) -> u64 !{mem} @{} =
    fn (local_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): linear scan for an in-use non-CLOSED UDP socket whose local_port (@+8) matches. Used by udp_socket_send_body's loopback fast path to route a datagram to the receiver bound on peer_port. 1-push callee-save (rbx=query port). Row size 128 -> slot offset = idx << 7 (no imul). Leaf; rax/rcx/rdx/r8/r9 caller-save scratch. Labels prefixed usock_flp_.",
      block: {
        push rbx;
        mov rbx, rdi;                          // rbx = query port
        xor rcx, rcx;
        lea rax, [rip + _udp_socket_table];

      usock_flp_scan:
        cmp rcx, 16;
        jae usock_flp_none;
        mov rdx, rcx;
        shl rdx, 7;
        mov r8, rax;
        add r8, rdx;                           // row ptr
        mov r9, [r8 + 32];                     // in_use
        cmp r9, 0;
        je usock_flp_next;
        mov r9, [r8 + 0];                      // state
        cmp r9, 0;                             // CLOSED?
        je usock_flp_next;
        mov r9, [r8 + 8];                      // local_port
        cmp r9, rbx;
        jne usock_flp_next;
        mov rax, rcx;
        jmp usock_flp_done;

      usock_flp_next:
        add rcx, 1;
        jmp usock_flp_scan;

      usock_flp_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      usock_flp_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_new() -> cap_slot | -errno
  // ============================================================================
  //
  // Allocates a fresh UDP socket row (CLOSED) and a fresh cap_table
  // slot minted as KIND_UDP_SOCKET over it. This is sys_socket_body's
  // AF_INET+SOCK_DGRAM branch's entire job -- direct parallel of
  // tcp_socket_new.

  pub let udp_socket_new : () -> u64 !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R100-PREP-002 (#2008): sys_socket(AF_INET, SOCK_DGRAM, 0)'s constructor. Structural parallel of tcp_socket_new (net/tcp_socket.pdx). udp_socket_alloc() first (pool exhaustion -> UDP_ERR_ENOBUFS, nothing minted). Then scan cap_table (stride 24: kind@+0/rights@+8/target_ptr@+16, same shape every derived-kind file in this tree uses) for a free slot (kind==0); table exhaustion -> free the socket row back (udp_socket_free) and return UDP_ERR_ENFILE, so a failed socket() never leaks a row. On a free slot: cap_mint_write(slot, KIND_UDP_SOCKET=0x1A8, UDP_SOCKET_RIGHTS=0x00F, sock_idx). Root mint -- no parent-capability argument, matching sys_open/sys_socket's own no-authority-required posture. 3-push callee-save (rbx=sock_idx, r12=slot idx, r13=unused pad register kept for symmetry with tcp_socket_new): entry rsp%16==8, three pushes (24 bytes) land rsp%16==0 -- no further pad needed. Labels prefixed usock_new_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call udp_socket_alloc;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne usock_new_have_row;
        mov rax, 0xFFFFFFFFFFFFFF97;           // -ENOBUFS
        jmp usock_new_ret;

      usock_new_have_row:
        mov rbx, rax;                          // sock_idx

        xor r12, r12;
        lea r13, [rip + cap_table];
      usock_new_scan:
        cmp r12, 256;
        jae usock_new_no_slot;
        mov rax, r12; shl rax, 3;
        mov rcx, r12; shl rcx, 4;
        add rax, rcx;                          // slot * 24
        mov rcx, [r13 + rax + 0];              // kind
        cmp rcx, 0;
        je usock_new_slot_found;
        add r12, 1;
        jmp usock_new_scan;

      usock_new_slot_found:
        mov rdi, r12;
        mov rsi, 0x1A8;                        // KIND_UDP_SOCKET
        mov rdx, 0x00F;                        // UDP_SOCKET_RIGHTS (R95.M4-002)
        mov rcx, rbx;                          // target_ptr = sock_idx
        call cap_mint_write;

        mov rax, r12;
        jmp usock_new_ret;

      usock_new_no_slot:
        mov rdi, rbx;
        call udp_socket_free;
        mov rax, 0xFFFFFFFFFFFFFFE9;           // -ENFILE

      usock_new_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_bind_body(sock_idx, local_port) -> 0 | -errno
  // ============================================================================
  //
  // sys_bind_body's UDP branch: stamp local_port + transition CLOSED
  // -> BOUND. Rejects port 0 (RFC 768 reserved / "assign ephemeral"
  // meaning; ephemeral assignment happens via sys_connect's auto-bind,
  // not via bind(0)). Rejects rebinding a BOUND or CONNECTED socket.

  pub let udp_socket_bind_body : (u64, u64) -> u64 !{mem} @{} =
    fn (sock_idx: u64, local_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): the udp_socket_bind body syscall handlers/sys_bind.pdx dispatches to on a KIND_UDP_SOCKET fd. Requires state==CLOSED (@+0 == 0); rebinding a BOUND or CONNECTED socket is refused with -EINVAL rather than silently repointing a live local_port. Rejects local_port==0 -- ephemeral auto-assignment happens via sys_connect's own path, not via bind(0). No duplicate-port check across sockets at MVP (real UDP would need SO_REUSEPORT / SO_REUSEADDR semantics before allowing that; single-client-single-server witness never trips this). On success: stamps local_port (@+8), transitions state=BOUND(1). 2-push callee-save (rbx=sock_idx, r12=local_port); leaf. Labels prefixed usock_bind_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                          // sock_idx
        mov r12, rsi;                          // local_port

        cmp r12, 0;
        je usock_bind_einval;

        mov rax, rbx;
        shl rax, 7;                            // slot offset
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;                          // row ptr

        mov rdx, [rcx + 0];                    // state
        cmp rdx, 0;
        jne usock_bind_einval;

        mov [rcx + 8], r12;                    // local_port
        mov rax, 1;                            // UDP_ST_BOUND
        mov [rcx + 0], rax;

        xor rax, rax;
        jmp usock_bind_done;

      usock_bind_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;

      usock_bind_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_connect_body(sock_idx, remote_ip_packed, remote_port)
  //     -> 0 | -errno
  // ============================================================================
  //
  // remote_ip_packed is a u32 in normal dotted-quad byte order (bits
  // [31:24]=a, [23:16]=b, [15:8]=c, [7:0]=d for a.b.c.d) -- same shape
  // as sys_connect's TCP arg. Auto-assigns an ephemeral local_port
  // if the socket has never been bound. NO handshake (this is UDP);
  // the "connect" is purely a local record of the default peer.

  pub let udp_socket_connect_body : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sock_idx: u64, remote_ip_packed: u64, remote_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): the udp_socket_connect body syscall handlers/sys_connect.pdx dispatches to on a KIND_UDP_SOCKET fd. Requires state != CONNECTED (@+0 != 2) -- an already-connected socket is refused with -EISCONN (matches TCP's sys_connect refusal shape). If state==CLOSED (never bound), auto-assign an ephemeral local_port via udp_next_ephemeral_port and transition to BOUND-first (transient -- overwritten immediately by CONNECTED below). Then stamp peer_ip (unpacked MSB-first from the packed u32 arg) + peer_port and transition state=CONNECTED. No packets are transmitted -- UDP is connectionless; 'connect' is purely a record of the default send peer + a receive filter target. 3-push callee-save (rbx=sock_idx, r12=remote_ip_packed, r13=remote_port) + sub rsp,8: entry rsp%16==8, three pushes (24 bytes) land rsp%16==0, 8-byte pad brings to 0 for the nested udp_next_ephemeral_port call. Labels prefixed usock_conn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                          // sock_idx
        mov r12, rsi;                          // remote_ip_packed
        mov r13, rdx;                          // remote_port

        mov rax, rbx;
        shl rax, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;                          // row ptr

        mov rdx, [rcx + 0];                    // state
        cmp rdx, 2;
        je usock_conn_eisconn;

        // If CLOSED, auto-assign ephemeral local_port.
        cmp rdx, 0;
        jne usock_conn_have_port;
        call udp_next_ephemeral_port;
        // Reload row ptr (call clobbered rcx).
        mov rdx, rbx;
        shl rdx, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rdx;
        mov [rcx + 8], rax;                    // local_port

      usock_conn_have_port:
        // Unpack remote_ip (MSB-first).
        mov rax, r12; shr rax, 24; and rax, 0xFF; mov_b [rcx + 24], rax;
        mov rax, r12; shr rax, 16; and rax, 0xFF; mov_b [rcx + 25], rax;
        mov rax, r12; shr rax, 8;  and rax, 0xFF; mov_b [rcx + 26], rax;
        mov rax, r12; and rax, 0xFF;              mov_b [rcx + 27], rax;

        mov [rcx + 16], r13;                   // peer_port

        mov rax, 2;                            // UDP_ST_CONNECTED
        mov [rcx + 0], rax;

        xor rax, rax;
        jmp usock_conn_done;

      usock_conn_eisconn:
        mov rax, 0xFFFFFFFFFFFFFF96;

      usock_conn_done:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_deliver_dgram(dst_sock_idx, src_ptr, len) -> 0 | UDP_NONE
  // ============================================================================
  //
  // Enqueue one datagram into the destination socket's rx ring. Called
  // by udp_socket_send_body's loopback fast path. Silently drops (returns
  // UDP_NONE) if the ring is full -- UDP is unreliable, and a queue-
  // full signal to the sender would let a slow reader deny service to
  // the sender. len is expected to be already capped at UDP_DGRAM_MAX
  // by the caller; this helper does NOT recheck.
  //
  // Slot arithmetic (all power-of-two shifts, no imul):
  //   data_slot_addr = &_udp_rx_dgram_data + (dst << 12) + (tail << 10)
  //   len_slot_addr  = &_udp_rx_dgram_lens + (dst << 5)  + (tail << 3)

  pub let udp_socket_deliver_dgram : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst_sock_idx: u64, src_ptr: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): enqueue one datagram at the destination socket's rx_tail slot. Reads rx_head/rx_tail/rx_count from row @+40/+48/+56; if rx_count >= UDP_QUEUE_DEPTH (4), drop silently (UDP-unreliable-contract) and return UDP_NONE so the caller can bump a drop counter if wanted. Otherwise: stamp len at len-slot @ +0, byte-copy len bytes from src_ptr to data-slot, advance rx_tail = (rx_tail + 1) & 3 (power-of-2 QDEPTH lets us use `and 3` instead of divmod), bump rx_count. 4-push callee-save (rbx=dst_sock_idx, r12=src_ptr, r13=len, r14=row_ptr): entry rsp%16==8, four pushes (32 bytes) land rsp%16==8, sub rsp,8 for alignment (though nothing nested here -- kept for the rep_movsb pattern's flag-safety consistency with sibling helpers). rep_movsb is intra-frame, does not clobber callee-save. Labels prefixed usock_dd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                          // dst_sock_idx
        mov r12, rsi;                          // src_ptr
        mov r13, rdx;                          // len

        mov rax, rbx;
        shl rax, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;
        mov r14, rcx;                          // r14 = row_ptr

        // Bounds: rx_count >= UDP_QUEUE_DEPTH -> drop.
        mov rax, [r14 + 56];                   // rx_count
        cmp rax, 4;                            // UDP_QUEUE_DEPTH
        jae usock_dd_drop;

        mov r9, [r14 + 48];                    // rx_tail

        // Stamp length at len_slot.
        mov rax, rbx;
        shl rax, 5;                            // dst << 5 = dst*32
        mov rcx, r9;
        shl rcx, 3;                            // tail << 3 = tail*8
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_lens];
        add rcx, rax;
        mov [rcx + 0], r13;                    // len_slot = len

        // Byte-copy payload into data_slot via rep_movsb.
        mov rax, rbx;
        shl rax, 12;                           // dst << 12 = dst*4096
        mov rcx, r9;
        shl rcx, 10;                           // tail << 10 = tail*1024
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_data];
        add rcx, rax;                          // rcx = dst data slot ptr

        // Zero-length is legal (empty UDP dgram); guard rep_movsb.
        cmp r13, 0;
        je usock_dd_no_copy;

        mov rdi, rcx;                          // dest = data slot
        mov rsi, r12;                          // src  = caller's buf
        mov rcx, r13;                          // count = len
        cld;
        rep_movsb;

      usock_dd_no_copy:
        // Advance rx_tail = (rx_tail + 1) & 3.
        mov rax, r9;
        add rax, 1;
        and rax, 3;
        mov [r14 + 48], rax;                   // rx_tail

        // rx_count += 1.
        mov rax, [r14 + 56];
        add rax, 1;
        mov [r14 + 56], rax;

        // R95.M3-002 (paideia-os #2081): wake any sys_poll waiter blocked on
        // socket readability. poll_wake_check_and_clear is a no-op if no
        // waiter is registered (single global slot at MVP). Called after
        // the row's rx_count has been bumped so a raced poll_readiness_scan
        // on the woken side observes the delivered dgram. Register plan:
        // rax caller-save is fine (we return 0 below).
        call poll_wake_check_and_clear;

        xor rax, rax;
        jmp usock_dd_done;

      usock_dd_drop:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      usock_dd_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_send_body(sock_idx, buf_ptr, len) -> bytes_sent | -errno
  // ============================================================================
  //
  // len is expected to be already capped by the caller (sys_send caps
  // at SYS_SEND_MAX=1024, which matches UDP_DGRAM_MAX); this helper
  // asserts len <= UDP_DGRAM_MAX defensively via a min-cap fold.
  //
  // Semantics: exactly one datagram is transmitted per call
  // (message-boundary preservation). Loopback (peer_ip ==
  // _ipv4_my_ip): find destination socket by peer_port and enqueue via
  // udp_socket_deliver_dgram. No destination -> silently drop (no ICMP
  // Port Unreachable emit at this MVP; sender still sees success). Off-
  // box: wire path DEFERRED to R93.M2 -- return len as a fake success
  // so R100-round test infrastructure that never actually goes off-box
  // is not misled by an "off-box send returned an error" line.

  pub let udp_socket_send_body : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sock_idx: u64, buf_ptr: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): the udp_socket_send body sys_send.pdx dispatches to on a KIND_UDP_SOCKET fd. Requires state==CONNECTED(@+0==2) -- otherwise -ENOTCONN. Cap len at UDP_DGRAM_MAX (1024) defensively. Compare peer_ip (@+24..+27) against _ipv4_my_ip byte-for-byte via mov_b; on match take the LOOPBACK FAST PATH: udp_socket_find_by_local_port(peer_port); on a hit call udp_socket_deliver_dgram(dst_idx, buf_ptr, len); on a miss silently drop (real UDP would emit ICMP Port Unreachable -- deferred to R93.M2). On non-match (off-box) the WIRE PATH is DEFERRED: return len as fake success rather than -ENETUNREACH, matching r72_tcp_echo's stance that the wire path is not exercised at this round and honestly stubbing it is preferable. Returns len on any success path; -ENOTCONN if state wrong. 5-push callee-save (rbx=sock_idx, r12=buf_ptr, r13=len, r14=row_ptr, r15=peer_port) + sub rsp,8: entry rsp%16==8, five pushes (40 bytes) land rsp%16==0, 8-byte pad brings to 8 for the nested udp_socket_find_by_local_port + udp_socket_deliver_dgram calls (both need rsp%16==0 at call site -> aligned via the pad). Labels prefixed usock_send_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // sock_idx
        mov r12, rsi;                          // buf_ptr
        mov r13, rdx;                          // len

        // Cap len at UDP_DGRAM_MAX (defensive; caller should have capped).
        mov rax, 1024;                         // UDP_DGRAM_MAX
        cmp r13, rax;
        jbe usock_send_len_ok;
        mov r13, rax;
      usock_send_len_ok:

        mov rax, rbx;
        shl rax, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;
        mov r14, rcx;                          // r14 = row_ptr

        mov rdx, [r14 + 0];                    // state
        cmp rdx, 2;                            // UDP_ST_CONNECTED
        jne usock_send_enotconn;

        mov r15, [r14 + 16];                   // peer_port

        // Loopback check: peer_ip (@+24..+27) == _ipv4_my_ip (@+0..+3)?
        xor rax, rax; mov_b rax, [r14 + 24]; xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 0]; cmp rax, rcx; jne usock_send_wire;
        xor rax, rax; mov_b rax, [r14 + 25]; xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 1]; cmp rax, rcx; jne usock_send_wire;
        xor rax, rax; mov_b rax, [r14 + 26]; xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 2]; cmp rax, rcx; jne usock_send_wire;
        xor rax, rax; mov_b rax, [r14 + 27]; xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 3]; cmp rax, rcx; jne usock_send_wire;

        // Loopback fast path: find receiver by peer_port.
        mov rdi, r15;
        call udp_socket_find_by_local_port;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je usock_send_no_dst;                  // no receiver bound: drop silently

        mov rdi, rax;                          // dst_sock_idx
        mov rsi, r12;                          // src_ptr
        mov rdx, r13;                          // len
        call udp_socket_deliver_dgram;
        // Ignore udp_socket_deliver_dgram's return -- ring-full drop is
        // silent per UDP-unreliable contract; sender still sees success.

      usock_send_no_dst:
        mov rax, r13;                          // return len
        jmp usock_send_done;

      usock_send_wire:
        // WIRE PATH DEFERRED to R93.M2 (see module header). Return len
        // as fake success so test infrastructure not exercising the
        // wire path is not misled by an error.
        mov rax, r13;
        jmp usock_send_done;

      usock_send_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;           // -ENOTCONN

      usock_send_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // udp_socket_recv_body(sock_idx, buf_ptr, len) -> bytes_read | -errno
  // ============================================================================
  //
  // Dequeues exactly ONE datagram from the socket's rx ring. Message
  // boundary is preserved: if the caller's len is smaller than the
  // pending datagram, the excess bytes are DISCARDED rather than left
  // for a follow-up recv() (Linux SOCK_DGRAM MSG_TRUNC posture). Empty
  // ring returns 0 (non-blocking; no wait queue at this MVP).
  //
  // Slot arithmetic mirrors udp_socket_deliver_dgram's:
  //   data_slot_addr = &_udp_rx_dgram_data + (sock << 12) + (head << 10)
  //   len_slot_addr  = &_udp_rx_dgram_lens + (sock << 5)  + (head << 3)
  //
  // The syscall handler (sys_recv.pdx) does the KPTI-safe copy into
  // user memory itself via user_write_bytes_via_walk; this body works
  // with a KERNEL-SPACE buf_ptr (which for the syscall path is
  // meaningless -- the handler computes the slot addr inline). Wait,
  // that's not what this body does: this body IS called from the
  // syscall handler AFTER the handler resolves the fd. To keep the
  // slot-layout knowledge in ONE place, this body copies to a
  // caller-supplied KERNEL buffer directly, and the syscall handler
  // then does the user_write_bytes_via_walk to move it to user space.
  // But that requires a second copy pass. Simpler alternative: the
  // syscall handler inlines the slot arithmetic itself and calls
  // user_write_bytes_via_walk directly on the slot address (source is
  // kernel memory -- safe). That is what sys_recv.pdx's UDP branch
  // will do. This body remains the KERNEL-CALLER helper (boot witness
  // path), taking a kernel-space destination buffer.

  pub let udp_socket_recv_body : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sock_idx: u64, buf_ptr: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-002 (#2008): the kernel-side udp_socket_recv helper for boot-witness callers (sys_recv.pdx's UDP branch inlines the slot arithmetic + user_write_bytes_via_walk directly, avoiding a double copy). Requires state==CONNECTED(@+0==2) -- -ENOTCONN otherwise. Empty ring (rx_count==0) returns 0. Otherwise reads len_slot at (sock<<5)+(head<<3) into r10, computes copy_len = min(dgram_len, len) (MSG_TRUNC posture: excess bytes DISCARDED, not left for the next recv). rep_movsb copy_len bytes from data_slot ((sock<<12)+(head<<10)) to buf_ptr. Advances rx_head = (rx_head + 1) & 3, decrements rx_count. Returns copy_len. 5-push callee-save (rbx=sock_idx, r12=buf_ptr, r13=len, r14=row_ptr, r15=copy_len) + sub rsp,8: entry rsp%16==8, five pushes (40 bytes) + 8-byte pad land rsp%16==0 (rep_movsb intra-frame). Labels prefixed usock_recv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // sock_idx
        mov r12, rsi;                          // buf_ptr (kernel)
        mov r13, rdx;                          // len

        mov rax, rbx;
        shl rax, 7;
        lea rcx, [rip + _udp_socket_table];
        add rcx, rax;
        mov r14, rcx;                          // r14 = row_ptr

        mov rdx, [r14 + 0];                    // state
        cmp rdx, 2;                            // UDP_ST_CONNECTED
        jne usock_recv_enotconn;

        mov rax, [r14 + 56];                   // rx_count
        cmp rax, 0;
        je usock_recv_empty;

        mov r9, [r14 + 40];                    // rx_head

        // len_slot addr = &_udp_rx_dgram_lens + (sock<<5) + (head<<3)
        mov rax, rbx; shl rax, 5;
        mov rcx, r9;  shl rcx, 3;
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_lens];
        add rcx, rax;
        mov r10, [rcx + 0];                    // r10 = dgram_len

        // copy_len = min(dgram_len, len)
        mov r15, r10;
        cmp r15, r13;
        jbe usock_recv_cap_ok;
        mov r15, r13;
      usock_recv_cap_ok:

        // Copy from data_slot to buf_ptr, if any bytes.
        cmp r15, 0;
        je usock_recv_no_copy;

        // data_slot addr = &_udp_rx_dgram_data + (sock<<12) + (head<<10)
        mov rax, rbx; shl rax, 12;
        mov rcx, r9;  shl rcx, 10;
        add rax, rcx;
        lea rcx, [rip + _udp_rx_dgram_data];
        add rcx, rax;                          // rcx = data slot ptr

        mov rdi, r12;                          // dest = caller buf
        mov rsi, rcx;                          // src  = data slot
        mov rcx, r15;                          // count = copy_len
        cld;
        rep_movsb;

      usock_recv_no_copy:
        // Consume the slot regardless of copy_len (MSG_TRUNC posture).
        mov rax, r9;
        add rax, 1;
        and rax, 3;
        mov [r14 + 40], rax;                   // rx_head advance

        mov rax, [r14 + 56];
        sub rax, 1;
        mov [r14 + 56], rax;                   // rx_count decrement

        mov rax, r15;                          // return copy_len
        jmp usock_recv_done;

      usock_recv_empty:
        xor rax, rax;                          // no pending dgram
        jmp usock_recv_done;

      usock_recv_enotconn:
        mov rax, 0xFFFFFFFFFFFFFF95;           // -ENOTCONN

      usock_recv_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
