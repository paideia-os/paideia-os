// src/kernel/core/net/arp.pdx — R27-M4-001..004 (#985 / #986 / #987 / #988)
//
// Address Resolution Protocol (RFC 826, IPv4-over-Ethernet).
//
// -----------------------------------------------------------------------------
// Wire layout (28 bytes, big-endian on the wire)
// -----------------------------------------------------------------------------
//
//   +0    u16   htype        1        (Ethernet)
//   +2    u16   ptype        0x0800   (IPv4)
//   +4    u8    hlen         6        (Ethernet MAC length)
//   +5    u8    plen         4        (IPv4 address length)
//   +6    u16   op           1=request / 2=reply
//   +8    u8[6] sender_mac
//   +14   u8[4] sender_ip
//   +18   u8[6] target_mac
//   +24   u8[4] target_ip
//
// The paideia-os R27.M4 stack implements the Ethernet + IPv4 profile
// only. The 28-byte fixed size is exposed as ARP_PKT_LEN; larger ARPs
// (RFC 5227 conflict detection, RARP, InARP) are out of scope until
// R30+ address-management substrates.
//
// -----------------------------------------------------------------------------
// Cache (16 entries, direct table, tick-driven expiry)
// -----------------------------------------------------------------------------
//
// The cache is a flat 16-slot table addressed by linear scan. Each
// slot is a 16-byte record laid out for u64-friendly access:
//
//   +0    u32   ip                  (host-word: (b0<<24)|(b1<<16)|(b2<<8)|b3)
//   +4    u32   expiry              (tick counter; 0 = slot is empty)
//   +8    u8[6] mac
//   +14   u8[2] pad                 (zero; reserved for VLAN / IPv6 mux)
//
// The `ip` and `expiry` fields co-reside in a single u64 at +0 so an
// add or evict rewrites both atomically (from the point of view of a
// single-threaded R27.M4 caller) with a single `mov [entry+0], rax`
// where `rax = (expiry<<32) | ip`. The `mac` payload is 6 bytes and is
// written via rep_movsb from a caller-supplied 6-byte source; the
// trailing 2-byte pad is explicitly zeroed to guarantee no stale
// bytes leak into a future memcmp of the qword @+8.
//
// Cache-fill discipline:
//   arp_cache_add(ip, mac):
//     (1) scan for matching ip -> update-in-place (reset expiry).
//     (2) scan for expiry==0 (empty slot) -> use it.
//     (3) round-robin evict via _arp_cache_next cursor.
//
// Cache-hit discipline:
//   arp_cache_lookup(ip, out_mac): return 1 iff a slot has
//   ip == query AND expiry > 0. Otherwise return 0 (out_mac
//   is left untouched — the caller must not rely on a partial
//   copy on lookup failure).
//
// Cache-expiry discipline:
//   arp_cache_expire_tick(): decrement expiry on every slot with
//   expiry > 0. When expiry reaches 0 the slot is available for
//   reuse by arp_cache_add's empty-slot scan. Expired entries are
//   not scrubbed; a stale mac lives on until arp_cache_add overwrites
//   it, but arp_cache_lookup gates on expiry > 0 so no stale
//   resolution is ever returned to a caller.
//
// The initial expiry is ARP_CACHE_INIT_EXPIRY (60). The caller's tick
// cadence for arp_cache_expire_tick is unspecified at M4; a future
// timer-driven wire-up (R23+ IDT + PIT/HPET) will drive expiry from a
// jiffies substrate. At M4 the tick fn is a callable symbol only.
//
// -----------------------------------------------------------------------------
// Local address discipline
// -----------------------------------------------------------------------------
//
// _arp_my_ip is hardcoded to 10.0.0.2 for the MVP. Proper address
// configuration lands with DHCP (deferred to R27+ per the R18+
// roadmap). Every reply and every request emits from the same u8[4]
// buffer so a later DHCP mutation refactors to `pub let mut` without
// a caller-site churn.
//
// -----------------------------------------------------------------------------
// TX path integration
// -----------------------------------------------------------------------------
//
// arp_send_request / arp_reply both flow through l2_tx_send with
// ethertype = 0x0806. The 28-byte ARP body is built into the module-
// static _arp_scratch_pkt buffer; l2_tx_send.eth_build then memcpys
// that scratch into the per-frame TX-pool slot it bump-allocates.
// The scratch buffer is single-shot per call — no reentrancy at M4
// (paideia-os is single-threaded pre-R23). A future IRQ-nesting
// substrate will migrate the scratch to a per-CPU slab.
//
// arp_rx_handle draws bar0 from _e1000e_devices[0].bar0_pa (record
// +8) and tx_ring from the canonical .bss ring symbol
// _e1000e_tx_ring. Multi-NIC dispatch is deferred to R28+ when the
// receive path grows a device-context substrate.
//
// -----------------------------------------------------------------------------
// R27.M4 posture: symbol-only at boot
// -----------------------------------------------------------------------------
//
// arp_rx_handle is called from l2_rx_handle (l2_rx.pdx) when the L2
// dispatch table matches ethertype 0x0806. That path is dormant at
// M4 pending the R23+ IDT-vector wiring — the ARP engine is a
// callable symbol only, exercised by fixture-injected frames.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: byte / word stores route via mov_b / mov_w.
//   G4: full-register compares.
//   G6: [reg+imm] addressing only — pointer walks use `add reg, 1`
//       per iteration rather than [base+index] SIB.
//
// Reserved-label discipline: labels prefixed `arpp_` (parse),
// `arpb_` (build), `arpca_` (cache_add), `arpcl_` (cache_lookup),
// `arpce_` (cache_expire_tick), `arpsr_` (send_request),
// `arprp_` (reply), `arprh_` (rx_handle).

module Arp = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let ARP_HTYPE_ETH             : u64 = 1
  pub let ARP_PTYPE_IPV4            : u64 = 0x0800
  pub let ARP_HLEN_ETH              : u64 = 6
  pub let ARP_PLEN_IPV4             : u64 = 4
  pub let ARP_OP_REQUEST            : u64 = 1
  pub let ARP_OP_REPLY              : u64 = 2
  pub let ARP_PKT_LEN               : u64 = 28
  pub let ARP_ETHERTYPE             : u64 = 0x0806

  pub let ARP_CACHE_ENTRIES         : u64 = 16
  pub let ARP_CACHE_ENTRY_SIZE      : u64 = 16
  pub let ARP_CACHE_BYTES           : u64 = 256
  pub let ARP_CACHE_INIT_EXPIRY     : u64 = 60

  // ============================================================================
  // Rodata: broadcast MAC, zero MAC, local IPv4 (MVP hardcode)
  // ============================================================================

  pub let _arp_bcast_mac : [u8; 6] = [
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8
  ]

  pub let _arp_zero_mac  : [u8; 6] = [
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  //   10.0.0.2 : written in canonical wire order [10, 0, 0, 2].
  //   When packed into a u32 host-word via the (b0<<24)|(b1<<16)|
  //   (b2<<8)|b3 build recipe, this is 0x0A000002.
  pub let _arp_my_ip     : [u8; 4] = [
    10u8, 0u8, 0u8, 2u8
  ]

  // ============================================================================
  // Canonical .bss slots
  // ============================================================================
  //
  //   _arp_cache          : 16 x 16-byte cache entries (see layout above)
  //   _arp_scratch_pkt    : 28-byte ARP-packet build buffer (32 B for
  //                         u64 alignment / natural stride)
  //   _arp_rx_scratch     : 28-byte ARP-packet parse buffer (32 B for
  //                         u64 alignment)
  //   _arp_cache_next     : round-robin eviction cursor (0..15)
  //   _arp_requests_sent  : cumulative arp_send_request success count
  //   _arp_replies_sent   : cumulative arp_reply     success count

  pub let mut _arp_cache            : [u8; 256] = uninit @align(8)
  pub let mut _arp_scratch_pkt      : [u8; 32]  = uninit @align(8)
  pub let mut _arp_rx_scratch       : [u8; 32]  = uninit @align(8)
  pub let mut _arp_cache_next       : u64        = 0
  pub let mut _arp_requests_sent    : u64        = 0
  pub let mut _arp_replies_sent     : u64        = 0

  // ============================================================================
  // arp_parse(pkt_pa, out) -> u64
  // ============================================================================
  //
  // SysV: (pkt_pa: u64, out: u64) -> u64
  //   rdi = physical address of the ARP body (i.e. frame_pa + 14 for
  //         frames arriving through l2_rx_handle; identity-mapped
  //         under KERNEL_VMA_BASE)
  //   rsi = pointer to a 28-byte destination buffer (typically the
  //         module-static _arp_rx_scratch)
  //
  // Copies the first 28 bytes of the ARP body into out and returns 1
  // iff htype=1 (Ethernet), ptype=0x0800 (IPv4), hlen=6, plen=4.
  // Returns 0 on any header-field mismatch (unsupported ARP variant
  // — RARP, InARP, non-Ethernet H/W).
  //
  // Register plan: 1 push (rbx = out) — leaf beyond rep_movsb; no
  // nested call, no extra pad needed.

  pub let arp_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (pkt_pa: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M4-001 (#985). Copy 28 ARP bytes from pkt_pa to out and validate htype=1, ptype=0x0800, hlen=6, plen=4. Body: (1) 1-push callee-save (rbx = out). Entry rsp%16==8 -> 16, %16==0 (leaf beyond rep_movsb; no CALL). (2) rbx = out. rep_movsb 28 bytes: swap entry-form (rdi=pkt_pa, rsi=out) into string-form (rdi=dest, rsi=src) via `mov rax,rdi; mov rdi,rsi; mov rsi,rax; mov rcx,28; cld; rep_movsb`. rbx (callee-save) survives. (3) Validate the 6 fixed-value bytes: htype hi @+0 == 0; htype lo @+1 == 1; ptype hi @+2 == 0x08; ptype lo @+3 == 0; hlen @+4 == 6; plen @+5 == 4. Any mismatch -> arpp_bad. Byte loads via `xor rax,rax; mov_b rax,[rbx+N]`. (4) On success return 1; on failure return 0. Reserved labels: `arpp_`.",
      block: {
        push rbx;

        mov rbx, rsi;                            // rbx = out

        // rep_movsb requires rdi=dest, rsi=src. Swap from entry-form.
        mov rax, rdi;                            // rax = pkt_pa
        mov rdi, rsi;                            // rdi = out
        mov rsi, rax;                            // rsi = pkt_pa
        mov rcx, 28;
        cld;
        rep_movsb;

        // Validate htype (u16 BE @+0) == 0x0001
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0;
        jne arpp_bad;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 1;
        jne arpp_bad;

        // Validate ptype (u16 BE @+2) == 0x0800
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x08;
        jne arpp_bad;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0;
        jne arpp_bad;

        // Validate hlen (u8 @+4) == 6
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 6;
        jne arpp_bad;

        // Validate plen (u8 @+5) == 4
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 4;
        jne arpp_bad;

        mov rax, 1;
        jmp arpp_ret;

      arpp_bad:
        xor rax, rax;

      arpp_ret:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_build(out_pa, op, sender_mac, sender_ip, target_mac, target_ip) -> u64
  // ============================================================================
  //
  // SysV: (out_pa: u64, op: u64, sender_mac: u64, sender_ip: u64,
  //        target_mac: u64, target_ip: u64) -> u64
  //   rdi = out_pa       — destination buffer (>= 28 bytes)
  //   rsi = op           — u16 host-order (1=request, 2=reply)
  //   rdx = sender_mac   — pointer to 6-byte source MAC
  //   rcx = sender_ip    — pointer to 4-byte source IPv4
  //   r8  = target_mac   — pointer to 6-byte target MAC (zero for request)
  //   r9  = target_ip    — pointer to 4-byte target IPv4
  //
  // Returns rax = 28 (ARP_PKT_LEN).
  //
  // Register plan: 6-push callee-save + 8-byte pad. 6 pushes = 48 B;
  // entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0 (aligned for the
  // rep_movsb runs; no CALL emitted, but the pad matches the
  // R27-M3-003 l2_tx_send prologue idiom for downstream readers).

  pub let arp_build : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_pa: u64, op: u64, sender_mac: u64, sender_ip: u64,
        target_mac: u64, target_ip: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M4-001 (#985). Build a 28-byte ARP body: fixed [1,0x0800,6,4] header + op (u16 BE) + sender_mac[6] + sender_ip[4] + target_mac[6] + target_ip[4]. Body: (1) 6-push callee-save prologue (rbx=out_pa, r15=op, rbp=sender_mac, r12=sender_ip, r13=target_mac, r14=target_ip) + `sub rsp,8` — 48 + 8 = 56; entry rsp%16==8 -> 64, %16==0. (2) Fixed header: 6 mov_b writes for htype hi=0, htype lo=1, ptype hi=0x08, ptype lo=0, hlen=6, plen=4. (3) Op (u16 BE @+6..+7): high byte = (op>>8)&0xFF; low byte = op&0xFF. (4) Four rep_movsb runs: sender_mac[6] -> +8; sender_ip[4] -> +14; target_mac[6] -> +18; target_ip[4] -> +24. Each restages rdi = rbx+offset, rsi = source ptr, rcx = count. rep_movsb clobbers only rdi/rsi/rcx (all caller-save), so callee-save state survives. (5) rax = 28; epilogue. Reserved labels: `arpb_` (none currently emitted — no branches).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = out_pa
        mov r15, rsi;                            // r15 = op
        mov rbp, rdx;                            // rbp = sender_mac
        mov r12, rcx;                            // r12 = sender_ip
        mov r13, r8;                             // r13 = target_mac
        mov r14, r9;                             // r14 = target_ip

        // ============================================================
        // Fixed header @+0..+5
        // ============================================================
        // htype (u16 BE @+0) = 0x0001
        xor rax, rax;
        mov_b [rbx + 0], rax;
        mov rax, 1;
        mov_b [rbx + 1], rax;

        // ptype (u16 BE @+2) = 0x0800
        mov rax, 0x08;
        mov_b [rbx + 2], rax;
        xor rax, rax;
        mov_b [rbx + 3], rax;

        // hlen (u8 @+4) = 6
        mov rax, 6;
        mov_b [rbx + 4], rax;

        // plen (u8 @+5) = 4
        mov rax, 4;
        mov_b [rbx + 5], rax;

        // ============================================================
        // Op (u16 BE @+6..+7)
        // ============================================================
        mov rax, r15;
        shr rax, 8;
        and rax, 0xFF;
        mov_b [rbx + 6], rax;
        mov rax, r15;
        and rax, 0xFF;
        mov_b [rbx + 7], rax;

        // ============================================================
        // sender_mac[6] -> +8..+13
        // ============================================================
        mov rdi, rbx;
        add rdi, 8;
        mov rsi, rbp;
        mov rcx, 6;
        cld;
        rep_movsb;

        // ============================================================
        // sender_ip[4] -> +14..+17
        // ============================================================
        mov rdi, rbx;
        add rdi, 14;
        mov rsi, r12;
        mov rcx, 4;
        cld;
        rep_movsb;

        // ============================================================
        // target_mac[6] -> +18..+23
        // ============================================================
        mov rdi, rbx;
        add rdi, 18;
        mov rsi, r13;
        mov rcx, 6;
        cld;
        rep_movsb;

        // ============================================================
        // target_ip[4] -> +24..+27
        // ============================================================
        mov rdi, rbx;
        add rdi, 24;
        mov rsi, r14;
        mov rcx, 4;
        cld;
        rep_movsb;

        // ============================================================
        // rax = ARP_PKT_LEN = 28
        // ============================================================
        mov rax, 28;

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_cache_add(ip, mac)
  // ============================================================================
  //
  // SysV: (ip: u64, mac: u64) -> u64
  //   rdi = ip u32 (canonical wire-order host-word — see file preamble)
  //   rsi = pointer to a 6-byte MAC to associate with ip
  //
  // Fill discipline: (1) matching-ip -> update-in-place (reset
  // expiry); (2) empty-slot (expiry==0) -> first-fit; (3) round-robin
  // evict via _arp_cache_next.
  //
  // Returns rax = 0 (success; the cache is unbounded from the
  // caller's perspective — an eviction still writes a valid entry).
  //
  // Register plan: 5-push callee-save + 8-byte pad. 5 pushes = 40 B;
  // entry rsp%16==8 -> 48, sub rsp,8 -> 56, %16==0. Leaf-ish (only
  // rep_movsb; no CALL) — the pad matches the shape of siblings
  // and reserves for a future klog fingerprint if cache instrumentation
  // is added.

  pub let arp_cache_add : (u64, u64) -> u64 !{mem} @{} =
    fn (ip: u64, mac: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M4-002 (#986). Cache-fill: matching-ip update-in-place / empty-slot first-fit / round-robin evict. Body: (1) 5-push callee-save (rbx=ip, rbp=mac, r12=cache_base, r13=idx, r14=entry_ptr) + `sub rsp,8` — 40 + 8 = 48; entry rsp%16==8 -> 56, %16==0. (2) rbx = ip & 0xFFFFFFFF (mask to u32 to defend against caller passing a dirty upper half). (3) Pass 1 (arpca_p1): scan idx 0..15; entry = base + idx*16; compare (entry_qw & 0xFFFFFFFF) to rbx; on match jump to arpca_write with r14 = entry ptr. (4) Pass 2 (arpca_p2/arpca_p2_loop): scan idx 0..15; extract expiry = entry_qw >> 32; if 0, use this slot -> arpca_write. (5) Pass 3 (arpca_p3): idx = _arp_cache_next & 15; bump _arp_cache_next; use that slot. (6) arpca_write: pack (INIT_EXPIRY << 32) | ip into u64 and store at entry+0 — this simultaneously commits ip and resets expiry. Then rep_movsb 6 bytes mac to entry+8; explicitly zero the trailing 2-byte pad @+14 via mov_w. (7) Return 0. Reserved labels: `arpca_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        and rbx, 0xFFFFFFFF;                     // rbx = ip u32
        mov rbp, rsi;                            // rbp = mac ptr
        lea r12, [rip + _arp_cache];             // r12 = cache base

        // ============================================================
        // Pass 1: matching ip -> update in place.
        // ============================================================
        mov r13, 0;

      arpca_p1:
        cmp r13, 16;
        jae arpca_p2;
        mov rax, r13;
        shl rax, 4;                              // idx * 16
        mov r14, r12;
        add r14, rax;                            // r14 = entry ptr
        mov rax, [r14 + 0];
        and rax, 0xFFFFFFFF;                     // extract ip
        cmp rax, rbx;
        je arpca_write;
        add r13, 1;
        jmp arpca_p1;

        // ============================================================
        // Pass 2: empty slot (expiry == 0).
        // ============================================================
      arpca_p2:
        mov r13, 0;

      arpca_p2_loop:
        cmp r13, 16;
        jae arpca_p3;
        mov rax, r13;
        shl rax, 4;
        mov r14, r12;
        add r14, rax;
        mov rax, [r14 + 0];
        shr rax, 32;                             // extract expiry
        cmp rax, 0;
        je arpca_write;
        add r13, 1;
        jmp arpca_p2_loop;

        // ============================================================
        // Pass 3: round-robin eviction via _arp_cache_next.
        // ============================================================
      arpca_p3:
        mov r13, [rip + _arp_cache_next];
        and r13, 15;
        mov rax, r13;
        shl rax, 4;
        mov r14, r12;
        add r14, rax;
        mov rax, r13;
        add rax, 1;
        and rax, 15;
        mov [rip + _arp_cache_next], rax;

        // ============================================================
        // Write path: r14 = entry ptr.
        // ============================================================
      arpca_write:
        // entry_qw @+0 = (INIT_EXPIRY << 32) | ip
        mov rax, 60;                             // ARP_CACHE_INIT_EXPIRY
        shl rax, 32;
        or rax, rbx;
        mov [r14 + 0], rax;

        // mac[6] -> entry+8..+13
        mov rdi, r14;
        add rdi, 8;
        mov rsi, rbp;
        mov rcx, 6;
        cld;
        rep_movsb;

        // pad[2] @+14..+15 = 0
        xor rax, rax;
        mov_w [r14 + 14], rax;

        xor rax, rax;                            // success

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_cache_lookup(ip, out_mac) -> u64
  // ============================================================================
  //
  // SysV: (ip: u64, out_mac: u64) -> u64
  //   rdi = ip u32 (canonical wire-order host-word)
  //   rsi = pointer to a 6-byte destination buffer for the mac
  //
  // Returns rax = 1 iff a slot has ip == query AND expiry > 0.
  // Otherwise returns 0 and does NOT touch out_mac.
  //
  // Register plan: 5-push callee-save + 8-byte pad. Same shape as
  // arp_cache_add (leaf beyond rep_movsb).

  pub let arp_cache_lookup : (u64, u64) -> u64 !{mem} @{} =
    fn (ip: u64, out_mac: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M4-002 (#986). Cache lookup: return 1 iff matching-ip slot has expiry > 0. Body: (1) 5-push callee-save (rbx=ip, rbp=out_mac, r12=cache_base, r13=idx, r14=entry_ptr) + `sub rsp,8` — 40 + 8 = 48; %16==0. (2) rbx = ip & 0xFFFFFFFF. (3) Scan idx 0..15 (arpcl_loop): entry_qw @+0; ip = qw & 0xFFFFFFFF; if != rbx -> next. Then expiry = qw >> 32; if 0 -> next (matching-ip but expired). Otherwise rep_movsb 6 bytes from entry+8 to out_mac; return 1. (4) On loop exhaustion return 0. Reserved labels: `arpcl_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        and rbx, 0xFFFFFFFF;                     // rbx = ip u32
        mov rbp, rsi;                            // rbp = out_mac
        lea r12, [rip + _arp_cache];
        mov r13, 0;

      arpcl_loop:
        cmp r13, 16;
        jae arpcl_notfound;
        mov rax, r13;
        shl rax, 4;
        mov r14, r12;
        add r14, rax;
        mov rax, [r14 + 0];
        and rax, 0xFFFFFFFF;
        cmp rax, rbx;
        jne arpcl_next;
        // ip matches; check expiry > 0
        mov rax, [r14 + 0];
        shr rax, 32;
        cmp rax, 0;
        je arpcl_next;
        // Found; copy mac to out_mac.
        mov rdi, rbp;
        mov rsi, r14;
        add rsi, 8;
        mov rcx, 6;
        cld;
        rep_movsb;
        mov rax, 1;
        jmp arpcl_ret;

      arpcl_next:
        add r13, 1;
        jmp arpcl_loop;

      arpcl_notfound:
        xor rax, rax;

      arpcl_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_cache_expire_tick()
  // ============================================================================
  //
  // SysV: () -> u64
  //
  // Decrements the expiry counter of every slot with expiry > 0.
  // Slots that reach 0 are NOT scrubbed — arp_cache_lookup gates on
  // expiry > 0, so a stale mac never leaks. arp_cache_add's empty-
  // slot scan reclaims the slot on the next fill.
  //
  // Returns rax = 0.
  //
  // Register plan: 4-push callee-save (rbx=packed qw scratch,
  // r12=cache_base, r13=idx, r14=entry_ptr) + 8-byte pad. Leaf.

  pub let arp_cache_expire_tick : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R27-M4-002 (#986). Decrement every non-zero expiry counter. Body: (1) 4-push callee-save (rbx=qw scratch, r12=cache_base, r13=idx, r14=entry_ptr) + `sub rsp,8` — 32 + 8 = 40; entry rsp%16==8 -> 48, %16==0. (2) Scan idx 0..15 (arpce_loop): load entry_qw @+0 into rbx; extract expiry = rbx >> 32; if 0 -> next (arpce_next). Otherwise expiry -= 1; re-pack qw as (expiry << 32) | (rbx & 0xFFFFFFFF) and store back. (3) On loop exhaustion return 0. Reserved labels: `arpce_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        lea r12, [rip + _arp_cache];
        mov r13, 0;

      arpce_loop:
        cmp r13, 16;
        jae arpce_done;
        mov rax, r13;
        shl rax, 4;
        mov r14, r12;
        add r14, rax;
        mov rbx, [r14 + 0];                      // rbx = entry_qw
        mov rax, rbx;
        shr rax, 32;                             // expiry
        cmp rax, 0;
        je arpce_next;
        sub rax, 1;                              // decremented expiry
        shl rax, 32;
        mov rcx, rbx;
        and rcx, 0xFFFFFFFF;                     // ip
        or rax, rcx;
        mov [r14 + 0], rax;

      arpce_next:
        add r13, 1;
        jmp arpce_loop;

      arpce_done:
        xor rax, rax;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_send_request(bar0, tx_ring_pa, target_ip) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, tx_ring_pa: u64, target_ip: u64) -> u64
  //   rdi = BAR0 base of the transmitting NIC
  //   rsi = physical address of the e1000e TX descriptor ring
  //   rdx = pointer to a 4-byte target IPv4 address
  //
  // Builds an ARP request:
  //   op          = 1 (request)
  //   sender_mac  = _e1000e_devices[0].mac (record +24)
  //   sender_ip   = _arp_my_ip
  //   target_mac  = _arp_zero_mac
  //   target_ip   = *rdx
  //
  // ...and hands it to l2_tx_send with dst_mac = _arp_bcast_mac and
  // ethertype = 0x0806.
  //
  // Returns rax = l2_tx_send's return code (0 on success; 2 on
  // ring-full; 1 on payload-too-big — should never trip for 28 B).
  //
  // Register plan: 3-push callee-save (rbx=bar0, rbp=tx_ring_pa,
  // r12=target_ip). 3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0
  // (aligned for arp_build + l2_tx_send).

  pub let arp_send_request : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, tx_ring_pa: u64, target_ip: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R27-M4-003 (#987). Broadcast an ARP request for target_ip. Body: (1) 3-push callee-save (rbx=bar0, rbp=tx_ring_pa, r12=target_ip). 3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for arp_build (rep_movsb runs only) and the nested l2_tx_send call which internally aligns for eth_build + e1000e_reg_write_u32). (2) arp_build(&_arp_scratch_pkt, 1, &_e1000e_devices+24, &_arp_my_ip, &_arp_zero_mac, target_ip). (3) l2_tx_send(bar0, tx_ring_pa, &_arp_bcast_mac, 0x0806, &_arp_scratch_pkt, 28). (4) Bump _arp_requests_sent (unconditionally — the guard against ring-full lives in l2_tx_send; a caller-observable non-zero rax is the caller's cue to retry). (5) rax carries l2_tx_send's return code. Reserved labels: `arpsr_` (none currently emitted — no branches).",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // tx_ring_pa
        mov r12, rdx;                            // target_ip

        // ============================================================
        // arp_build(out=_arp_scratch_pkt, op=1,
        //           sender_mac=_e1000e_devices+24,
        //           sender_ip=_arp_my_ip,
        //           target_mac=_arp_zero_mac,
        //           target_ip=r12)
        // ============================================================
        lea rdi, [rip + _arp_scratch_pkt];
        mov rsi, 1;                              // ARP_OP_REQUEST
        lea rdx, [rip + _e1000e_devices];
        add rdx, 24;                             // sender_mac ptr
        lea rcx, [rip + _arp_my_ip];
        lea r8, [rip + _arp_zero_mac];
        mov r9, r12;                             // target_ip
        call arp_build;

        // ============================================================
        // l2_tx_send(bar0, tx_ring_pa, dst=_arp_bcast_mac,
        //            ethertype=0x0806, payload=_arp_scratch_pkt, 28)
        // ============================================================
        mov rdi, rbx;                            // bar0
        mov rsi, rbp;                            // tx_ring_pa
        lea rdx, [rip + _arp_bcast_mac];
        mov rcx, 0x0806;                         // ARP ethertype
        lea r8, [rip + _arp_scratch_pkt];
        mov r9, 28;                              // ARP_PKT_LEN
        call l2_tx_send;

        // ============================================================
        // Bump _arp_requests_sent.
        // ============================================================
        mov rcx, [rip + _arp_requests_sent];
        add rcx, 1;
        mov [rip + _arp_requests_sent], rcx;

        // rax carries l2_tx_send's return code.
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_reply(bar0, tx_ring_pa, target_mac, target_ip) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, tx_ring_pa: u64, target_mac: u64,
  //        target_ip: u64) -> u64
  //   rdi = BAR0 base of the transmitting NIC
  //   rsi = physical address of the e1000e TX descriptor ring
  //   rdx = pointer to a 6-byte target MAC (typically the sender_mac
  //         copied out of the ARP request that triggered this reply)
  //   rcx = pointer to a 4-byte target IPv4 (the sender_ip of that
  //         request)
  //
  // Builds an ARP reply:
  //   op          = 2 (reply)
  //   sender_mac  = _e1000e_devices[0].mac
  //   sender_ip   = _arp_my_ip
  //   target_mac  = *rdx
  //   target_ip   = *rcx
  //
  // ...and hands it to l2_tx_send with dst_mac = target_mac
  // (unicast) and ethertype = 0x0806.
  //
  // Returns rax = l2_tx_send's return code.
  //
  // Register plan: 4-push callee-save (rbx=bar0, rbp=tx_ring_pa,
  // r12=target_mac, r13=target_ip) + 8-byte pad. 4 pushes = 32 B;
  // entry rsp%16==8 -> 40, sub rsp,8 -> 48, %16==0 (aligned for
  // arp_build + l2_tx_send).

  pub let arp_reply : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, tx_ring_pa: u64, target_mac: u64,
        target_ip: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R27-M4-004 (#988). Unicast an ARP reply to (target_mac, target_ip). Body: (1) 4-push callee-save (rbx=bar0, rbp=tx_ring_pa, r12=target_mac, r13=target_ip) + `sub rsp,8` — 32 + 8 = 40; entry rsp%16==8 -> 48, %16==0. (2) arp_build(&_arp_scratch_pkt, 2, &_e1000e_devices+24, &_arp_my_ip, r12, r13). (3) l2_tx_send(bar0, tx_ring_pa, r12 (dst = target_mac unicast), 0x0806, &_arp_scratch_pkt, 28). (4) Bump _arp_replies_sent. (5) rax carries l2_tx_send's return code. Reserved labels: `arprp_` (none currently emitted — no branches).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // tx_ring_pa
        mov r12, rdx;                            // target_mac
        mov r13, rcx;                            // target_ip

        // ============================================================
        // arp_build(out=_arp_scratch_pkt, op=2,
        //           sender_mac=_e1000e_devices+24,
        //           sender_ip=_arp_my_ip,
        //           target_mac=r12,
        //           target_ip=r13)
        // ============================================================
        lea rdi, [rip + _arp_scratch_pkt];
        mov rsi, 2;                              // ARP_OP_REPLY
        lea rdx, [rip + _e1000e_devices];
        add rdx, 24;                             // sender_mac ptr
        lea rcx, [rip + _arp_my_ip];
        mov r8, r12;                             // target_mac
        mov r9, r13;                             // target_ip
        call arp_build;

        // ============================================================
        // l2_tx_send(bar0, tx_ring_pa, dst=target_mac (unicast),
        //            ethertype=0x0806, payload=_arp_scratch_pkt, 28)
        // ============================================================
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;                            // unicast dst
        mov rcx, 0x0806;
        lea r8, [rip + _arp_scratch_pkt];
        mov r9, 28;
        call l2_tx_send;

        // ============================================================
        // Bump _arp_replies_sent.
        // ============================================================
        mov rcx, [rip + _arp_replies_sent];
        add rcx, 1;
        mov [rip + _arp_replies_sent], rcx;

        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // arp_rx_handle(pkt_pa, pkt_len) -> u64
  // ============================================================================
  //
  // SysV: (pkt_pa: u64, pkt_len: u64) -> u64
  //   rdi = physical address of the whole received Ethernet frame
  //         (l2_rx_handle hands us the frame_pa — we skip the 14-byte
  //         Ethernet header internally)
  //   rsi = frame length in bytes (as reported by the RX descriptor)
  //
  // Behaviour:
  //   - Emit an "L2 RX ARP" klog fingerprint (parity with the M3 stub).
  //   - Reject frames shorter than ETH_HDR_LEN + ARP_PKT_LEN = 42.
  //   - Parse the ARP body into _arp_rx_scratch.
  //   - Cache sender_ip -> sender_mac (unconditional learning).
  //   - If op == request AND target_ip == _arp_my_ip AND
  //     sender_ip != target_ip (i.e. not a gratuitous announcement),
  //     unicast an ARP reply back to the sender via arp_reply.
  //   - Gratuitous ARPs (op == request AND sender_ip == target_ip)
  //     land in the cache-update path only.
  //
  // Returns rax = 0 on a well-formed ARP (cached, possibly replied
  // to), or 1 on a short / malformed / non-Ethernet-IPv4 ARP frame.
  //
  // Register plan: 4-push callee-save (rbx=pkt_pa, rbp=pkt_len,
  // r13=sender_ip u32, r14=op) + 8-byte pad. 4 pushes = 32 B;
  // entry rsp%16==8 -> 40, sub rsp,8 -> 48, %16==0 (aligned for
  // klog_s1 + arp_parse + arp_cache_add + arp_reply).

  pub let arp_rx_handle : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (pkt_pa: u64, pkt_len: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R27-M4-004 (#988). ARP receive engine: parse + unconditional sender-mac learning + optional reply. Body: (1) 4-push callee-save (rbx=pkt_pa, rbp=pkt_len, r13=sender_ip u32, r14=op) + `sub rsp,8` — 32 + 8 = 40; entry rsp%16==8 -> 48, %16==0. (2) klog_s1(INFO, NET_, tag_l2_arp) — L2 dispatch fingerprint (parity with the R27-M3-002 arp_rx_stub). (3) Length gate: cmp rbp, 42; jb arprh_bad — smallest valid Ethernet+ARP frame is 14 + 28 = 42 bytes. (4) arp_parse(pkt_pa+14, &_arp_rx_scratch); if rax == 0 -> arprh_bad (unsupported ARP variant). (5) Assemble sender_ip u32 from 4 bytes at scratch+14..17 in canonical wire order via 4 mov_b/shl/or steps; stash in r13. (6) arp_cache_add(r13, scratch+8) — unconditional sender learning (both requests and replies contribute). (7) Assemble op u16 from bytes at scratch+6..7; stash in r14. (8) If op != 1 (not a request) -> arprh_ok (reply-path caching already done). (9) target_ip == _arp_my_ip? Byte-compare 4 bytes at scratch+24 against _arp_my_ip; on any byte mismatch -> arprh_ok (frame is not for us). (10) Gratuitous check: assemble target_ip u32 from scratch+24..27; compare with r13 (sender_ip); on equality -> arprh_ok (announcement, no reply). (11) arp_reply(bar0=_e1000e_devices[0].bar0_pa (u64 @+8), tx_ring=&_e1000e_tx_ring, target_mac=scratch+8, target_ip=scratch+14). rax carries l2_tx_send return; we ignore it and return 0. (12) Reserved labels: `arprh_`.",
      block: {
        push rbx;
        push rbp;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                            // pkt_pa
        mov rbp, rsi;                            // pkt_len

        // ============================================================
        // (1) klog fingerprint (parity with M3 arp_rx_stub).
        // ============================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_l2_arp];
        call klog_s1;

        // ============================================================
        // (2) Length gate: 14 + 28 = 42 minimum
        // ============================================================
        cmp rbp, 42;
        jb arprh_bad;

        // ============================================================
        // (3) arp_parse(pkt_pa + 14, &_arp_rx_scratch)
        // ============================================================
        mov rdi, rbx;
        add rdi, 14;
        lea rsi, [rip + _arp_rx_scratch];
        call arp_parse;
        cmp rax, 0;
        je arprh_bad;

        // ============================================================
        // (4) Assemble sender_ip u32 (bytes @+14..+17) in canonical
        //     wire-order host-word.
        // ============================================================
        xor rax, rax;
        mov_b rax, [rip + _arp_rx_scratch + 14];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 15];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 16];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 17];
        or rax, rcx;
        mov r13, rax;                            // sender_ip u32

        // ============================================================
        // (5) arp_cache_add(sender_ip, sender_mac ptr @ scratch+8)
        //     — unconditional learning.
        // ============================================================
        mov rdi, r13;
        lea rsi, [rip + _arp_rx_scratch + 8];
        call arp_cache_add;

        // ============================================================
        // (6) Assemble op (u16 BE @+6..+7).
        // ============================================================
        xor rax, rax;
        mov_b rax, [rip + _arp_rx_scratch + 6];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 7];
        or rax, rcx;
        mov r14, rax;

        // ============================================================
        // (7) If not a request, we're done (op==reply already cached).
        // ============================================================
        cmp r14, 1;
        jne arprh_ok;

        // ============================================================
        // (8) target_ip == _arp_my_ip?  Byte-compare 4 bytes.
        // ============================================================
        lea rdi, [rip + _arp_rx_scratch + 24];
        lea rsi, [rip + _arp_my_ip];
        mov rcx, 4;

      arprh_ip_cmp:
        cmp rcx, 0;
        je arprh_ip_match;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        xor rdx, rdx;
        mov_b rdx, [rsi + 0];
        cmp rax, rdx;
        jne arprh_ok;                            // not for us — silent drop
        add rdi, 1;
        add rsi, 1;
        sub rcx, 1;
        jmp arprh_ip_cmp;

      arprh_ip_match:
        // ============================================================
        // (9) Gratuitous check: sender_ip u32 (r13) == target_ip u32?
        // ============================================================
        xor rax, rax;
        mov_b rax, [rip + _arp_rx_scratch + 24];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 25];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 26];
        or rax, rcx;
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rip + _arp_rx_scratch + 27];
        or rax, rcx;
        cmp rax, r13;
        je arprh_ok;                             // gratuitous — no reply

        // ============================================================
        // (10) arp_reply(bar0, tx_ring, target_mac=sender_mac,
        //                target_ip=sender_ip_bytes)
        //      bar0 = _e1000e_devices[0].bar0_pa @ record +8.
        // ============================================================
        mov rdi, [rip + _e1000e_devices + 8];
        lea rsi, [rip + _e1000e_tx_ring];
        lea rdx, [rip + _arp_rx_scratch + 8];    // target_mac
        lea rcx, [rip + _arp_rx_scratch + 14];   // target_ip bytes
        call arp_reply;

      arprh_ok:
        xor rax, rax;
        jmp arprh_ret;

      arprh_bad:
        mov rax, 1;

      arprh_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
