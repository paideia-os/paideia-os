// src/kernel/core/net/tcp_socket.pdx — R72.M1-005/006 (#1927/#1928)
//
// The cap-table <-> TCB bridge layer behind the socket API. Each of the
// 8 syscall handlers under syscall/handlers/sys_{socket,bind,listen,
// accept,connect,send,recv,shutdown}.pdx calls into this file to do the
// actual "resolve a cap_table slot to a live TCB" / "mint a fresh
// KIND_TCP_SOCKET" work, keeping the per-syscall handler bodies thin
// ABI-marshalling shims — the same split fd_get/fd_set/vfs_close give
// sys_close_body, or vfs_open gives sys_open_body.
//
// -----------------------------------------------------------------------------
// Cap kind mapping (see cap/kind.pdx for the full derivation writeup)
// -----------------------------------------------------------------------------
//
//   KIND_TCP_SOCKET   (0x1A5) — an active or not-yet-connected socket:
//                       send/recv/connect/shutdown all require this kind.
//   KIND_TCP_LISTENER (0x1A4) — a socket that has called listen(): only
//                       accept() operates on this kind. sys_listen
//                       RETAGS an existing KIND_TCP_SOCKET slot in place
//                       (same slot, same tcb_idx target_ptr) rather than
//                       minting a second capability over the same row.
//
// Both derive over KIND_IPC_ENDPOINT for documentation symmetry with
// the rest of cap/kind.pdx's derived-kind family, but are ROOT-minted —
// sys_socket takes no parent-capability argument (matches sys_open's
// own no-authority-required posture at this round). Rights are fixed at
// R_TCP_READ|R_TCP_WRITE|R_TCP_INVOKE = 0x00B for every mint; there is
// no rights-widening path in this MVP.
//
// Reserved-label discipline: `sock_` prefix.

module TcpSocket = structure {

  pub let KIND_TCP_LISTENER : u64 = 0x1A4
  pub let KIND_TCP_SOCKET   : u64 = 0x1A5
  pub let TCP_SOCKET_RIGHTS : u64 = 0x00B   // READ | WRITE | INVOKE

  // Negative-errno sentinels (u64 two's-complement, matching Linux
  // errno signs per the rest of this tree's syscall bodies).
  pub let SOCK_ERR_ENOBUFS : u64 = 0xFFFFFFFFFFFFFF97   // -ENOBUFS (-105)
  pub let SOCK_ERR_ENFILE  : u64 = 0xFFFFFFFFFFFFFFE9   // -ENFILE  (-23)
  pub let SOCK_ERR_EBADF   : u64 = 0xFFFFFFFFFFFFFFF7   // -EBADF   (-9)
  pub let SOCK_ERR_ENOTSOCK: u64 = 0xFFFFFFFFFFFFFFA8   // -ENOTSOCK (-88)

  // ============================================================================
  // tcp_socket_new() -> cap_slot | SOCK_ERR_*
  // ============================================================================
  //
  // Allocates a fresh TCB (CLOSED) and a fresh cap_table slot minted as
  // KIND_TCP_SOCKET over it. This is sys_socket_body's entire job.

  pub let tcp_socket_new : () -> u64 !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R72.M1-005/006 (#1927/#1928): sys_socket's constructor. tcp_alloc_tcb() first (pool exhaustion -> SOCK_ERR_ENOBUFS, nothing minted). Then scan cap_table (stride 24: kind@+0/rights@+8/target_ptr@+16, same layout every other kind file in this tree uses) for a free slot (kind==0); table exhaustion -> free the TCB back (tcp_free_tcb) and return SOCK_ERR_ENFILE, so a failed socket() never leaks a TCB. On a free slot: cap_mint_write(slot, KIND_TCP_SOCKET, TCP_SOCKET_RIGHTS, tcb_idx). Root mint -- no parent-capability argument, matching sys_open's own no-authority-required posture. 3-push callee-save (rbx=tcb_idx, r12=slot idx, r13=unused pad register kept for symmetry with the sibling constructor): entry rsp%16==8, three pushes (24 bytes) land rsp%16==0 directly -- no further pad needed. Reserved labels: sock_new_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call tcp_alloc_tcb;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        jne sock_new_have_tcb;
        mov rax, 0xFFFFFFFFFFFFFF97;          // -ENOBUFS
        jmp sock_new_ret;

      sock_new_have_tcb:
        mov rbx, rax;                          // tcb_idx

        xor r12, r12;
        lea r13, [rip + cap_table];
      sock_new_scan:
        cmp r12, 256;
        jae sock_new_no_slot;
        mov rax, r12; shl rax, 3;
        mov rcx, r12; shl rcx, 4;
        add rax, rcx;                          // slot * 24
        mov rcx, [r13 + rax + 0];              // kind
        cmp rcx, 0;
        je sock_new_slot_found;
        add r12, 1;
        jmp sock_new_scan;

      sock_new_slot_found:
        mov rdi, r12;
        mov rsi, 0x1A5;                         // KIND_TCP_SOCKET
        mov rdx, 0x00B;                         // TCP_SOCKET_RIGHTS
        mov rcx, rbx;                           // target_ptr = tcb_idx
        call cap_mint_write;

        mov rax, r12;
        jmp sock_new_ret;

      sock_new_no_slot:
        mov rdi, rbx;
        call tcp_free_tcb;
        mov rax, 0xFFFFFFFFFFFFFFE9;            // -ENFILE

      sock_new_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // tcp_socket_mint_child(child_tcb_idx) -> cap_slot | SOCK_ERR_ENFILE
  // ============================================================================
  //
  // Same free-slot scan as tcp_socket_new, but over an ALREADY-allocated
  // TCB (a listener's accepted child) rather than allocating a new one.
  // Used by sys_accept_body once tcp_accept_pending hands back a claimed
  // child index.

  pub let tcp_socket_mint_child : (u64) -> u64 !{mem} @{cap} =
    fn (child_tcb_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R72.M1-005 (#1927): sys_accept's cap-minting half. Scans cap_table for a free slot exactly as tcp_socket_new does, but stamps target_ptr = the CALLER-SUPPLIED tcb_idx (already claimed by tcp_accept_pending) rather than allocating a fresh TCB. Table exhaustion here does NOT free the child TCB -- the connection is still live and ESTABLISHED; the caller (sys_accept_body) is left to decide whether to retry or to drive an active close via tcp_close, since silently freeing a live, peer-visible connection out from under a full cap_table would leave the peer believing it has an open socket the kernel has already discarded. 2-push callee-save (rbx=child_tcb_idx, r12=slot idx) + sub rsp,8: entry rsp%16==8, two pushes (16 bytes) land rsp%16==8, the 8-byte pad brings it to 0 for the nested cap_mint_write call.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        xor r12, r12;
        lea rax, [rip + cap_table];

      sock_mc_scan:
        cmp r12, 256;
        jae sock_mc_no_slot;
        mov rcx, r12; shl rcx, 3;
        mov rdx, r12; shl rdx, 4;
        add rcx, rdx;
        mov rdx, [rax + rcx + 0];
        cmp rdx, 0;
        je sock_mc_found;
        add r12, 1;
        jmp sock_mc_scan;

      sock_mc_found:
        mov rdi, r12;
        mov rsi, 0x1A5;
        mov rdx, 0x00B;
        mov rcx, rbx;
        call cap_mint_write;

        mov rax, r12;
        jmp sock_mc_ret;

      sock_mc_no_slot:
        mov rax, 0xFFFFFFFFFFFFFFE9;

      sock_mc_ret:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // tcp_socket_resolve(cap_slot, want_kind) -> tcb_idx | TCP_NONE
  // ============================================================================
  //
  // Bounds-checks cap_slot, loads the descriptor, and requires kind ==
  // want_kind exactly (callers pass KIND_TCP_SOCKET for bind/connect/
  // send/recv/shutdown, KIND_TCP_LISTENER for accept). Returns
  // target_ptr (the tcb_idx) verbatim on a match.

  pub let tcp_socket_resolve : (u64, u64) -> u64 !{mem} @{} =
    fn (cap_slot: u64, want_kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R72.M1-005 (#1927): the one gate every socket syscall body calls through. cap_slot >= 256 -> TCP_NONE (bounds). Descriptor kind (@+0) must equal want_kind exactly -- a KIND_TCP_LISTENER slot handed to send()/recv() and vice versa are both rejected here rather than by convention at each call site. Returns target_ptr (@+16) verbatim; callers do not need to mask it further since tcb_idx is the entire 64-bit field for this kind (no packed sub-fields, unlike several derived kinds elsewhere in cap/kind.pdx). Leaf.",
      block: {
        cmp rdi, 256;
        jae sock_res_none;

        mov rax, rdi; shl rax, 3;
        mov rcx, rdi; shl rcx, 4;
        add rax, rcx;
        lea rcx, [rip + cap_table];
        add rcx, rax;

        mov rax, [rcx + 0];
        cmp rax, rsi;
        jne sock_res_none;

        mov rax, [rcx + 16];
        ret;

      sock_res_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // tcp_socket_retag_listener(cap_slot) -> ()
  // ============================================================================
  //
  // sys_listen's cap-layer half: rewrites an existing KIND_TCP_SOCKET
  // slot's kind field to KIND_TCP_LISTENER in place, over the SAME
  // tcb_idx target_ptr. Caller (sys_listen_body) is responsible for
  // having already validated the slot and moved the TCB itself to
  // TCP_ST_LISTEN.

  pub let tcp_socket_retag_listener : (u64) -> () !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R72.M1-005/006 (#1927/#1928): retags cap_slot's descriptor from KIND_TCP_SOCKET to KIND_TCP_LISTENER over the SAME target_ptr (tcb_idx) -- listen() does not mint a second capability over the same TCB row, it changes what the existing one may be used for (send/recv/connect/shutdown vs. accept). Reads the current target_ptr before the cap_mint_write call so the retag cannot accidentally repoint the descriptor at tcb_idx=0. 1-push callee-save (rbx=cap_slot).",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rax, rbx; shl rax, 3;
        mov rcx, rbx; shl rcx, 4;
        add rax, rcx;
        lea rcx, [rip + cap_table];
        add rcx, rax;
        mov rdx, [rcx + 16];                    // existing target_ptr

        mov rdi, rbx;
        mov rsi, 0x1A4;                          // KIND_TCP_LISTENER
        mov rcx, rdx;
        mov rdx, 0x00B;
        call cap_mint_write;

        pop rbx;
        ret
      }
    }
}
