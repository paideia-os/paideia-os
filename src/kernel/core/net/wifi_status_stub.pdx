// src/kernel/core/net/wifi_status_stub.pdx -- R113.M6-028 (paideia-os #2408)
//
// MINIMAL, INTENTIONALLY INERT placeholder for a future wifi
// signal-strength + SSID query. Follow-up work, tracked here rather than
// guessed at:
//
//   1. Allocate a KIND_NET_WIRELESS derived kind in
//      src/kernel/core/cap/kind.pdx (next free derived-kind tag past the
//      existing 0x178..0x184 wifi/bluetooth block), deriving over
//      KIND_WIFI_VIF (0x179, kind_wifi_vif.pdx) the same way
//      KIND_HW_MSIX_VECTOR layers atop KIND_HW_INTERRUPT.
//   2. Add its mint gate + row table + rights bitmask alongside the
//      existing KIND_WIFI_* family (kind_wifi_phy.pdx / kind_wifi_vif.pdx
//      neighbors).
//   3. Add the `cmp rcx, <tag>; je call_kind_net_wireless` dispatch arm
//      to cap_invoke_dispatch (src/kernel/core/cap/invoke.pdx), following
//      every existing derived-kind arm's "full u64 kind field, not the
//      4-bit LAM slot" pattern.
//
// NONE OF THAT IS DONE HERE. This wave (R113.M6, postui-desktop) is
// explicitly scoped to the desktop-shell UI layer, not driver or
// capability-substrate work (see the wave dispatch note: "Do NOT overload
// this wave with battery/wifi driver work"). Building the real derived
// kind touches three load-bearing, heavily cross-referenced files
// (kind.pdx and invoke.pdx are each 1500+ lines with a strict closed-enum
// / full-u64-compare discipline every existing entry follows) and is a
// correctness-sensitive change that deserves its own dedicated landing
// and review, not a drive-by addition alongside five UI-shell issues.
//
// WHY THIS FUNCTION IS UNREACHABLE TODAY, AND WHY THAT IS FINE. src/user/
// postui-desktop/status_bar.pdx's wifi widget does NOT call this function
// -- it cannot: src/user/**/*.pdx and src/kernel/**/*.pdx are compiled
// and linked into separate binaries (tools/build-user.sh vs.
// tools/build.sh), and a ring-3 process can only reach ring-0 code
// through a syscall, never a direct symbol call. Until step 3 above wires
// a real sysno + dispatch.pdx branch, this function is exactly what its
// name says: a stub with no caller, sitting in the kernel image inert.
// status_bar.pdx's wifi widget instead carries its OWN local placeholder
// (status_bar_wifi_signal_pct / status_bar_wifi_ssid_str) returning the
// SAME two values with no syscall involved, and says so plainly in its
// own header rather than pretending a capability call is happening.
//
// Encoding, matching the two values status_bar.pdx's placeholder mirrors:
//   bits [7:0]   = signal_pct (0..100), fixed at 60.
//   bits [15:8]  = ssid_len, fixed at 4 ("WEAK", matching this wave's own
//                  stub example -- not a real network name).
//   bits [63:16] = reserved, always 0.

module WifiStatusStub = structure {

  pub let WIFI_STATUS_STUB_SIGNAL_PCT : u64 = 60
  pub let WIFI_STATUS_STUB_SSID_LEN   : u64 = 4

  // wifi_status_stub_query() -> packed (ssid_len[15:8] | signal_pct[7:0]).
  // Fixed placeholder; touches no hardware, no MMIO, no row table.
  pub let wifi_status_stub_query : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): fixed placeholder return, no hardware access. signal_pct (60) in bits [7:0], ssid_len (4) in bits [15:8]. Not reachable from ring 3 today -- see file header. Labels prefixed wss_.",
      block: {
        mov rax, 60;                      // WIFI_STATUS_STUB_SIGNAL_PCT
        mov r10, 4;                       // WIFI_STATUS_STUB_SSID_LEN
        shl r10, 8;
        add rax, r10;
        ret
      }
    }

  // wifi_status_stub_ssid_str -- placeholder SSID text, "WEAK\0".
  pub let wifi_status_stub_ssid_str : [u8; 5] = "WEAK\0"
}
