// src/kernel/core/entry.pdx — kernel-side anchor for opcode-canary C6 (#655).
//
// Contains a single `entry_gt` function using `>` on two register-form u64
// operands. Its .text bytes are asserted by tools/opcode-canary.sh to contain
// cmp reg,reg (`4[89c-d] 39`), setg (`0f 9f`), and movzbq (`48 0f b6`), and
// to NOT contain shl reg,cl (`48 d3`) — the signature of paideia-as #1230's
// silent `>` → `<<` miscompile.
//
// The function is unreferenced from any real code path (dead code from the
// kernel link graph); it exists purely so opcode-canary can assert its
// .text bytes. Var>Var form (not literals) is deliberate — literals fold
// to a constant and defeat the byte-pattern test. See design spec:
// design/paideia-as/non-milestone-issue-1230-silent-fallthrough-hardening.md §4.4 C6.

module Entry = structure {
  pub let entry_gt : (u64, u64) -> u64 !{} @{} = fn(a: u64, b: u64) -> {
    let r : u64 = a > b
    r
  }
}
