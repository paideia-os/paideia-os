// src/kernel/core/input/hotkey_dispatch.pdx — R31.M6-001/002/003
// (#1111 / #1112 / #1113)
//
// The map from an embedded-controller query byte to a HOT-KEY SEMANTIC
// (which sink is meant, which action within that sink), and the ONE
// composed helper that binds a backlight hot-key to
// backlight_report_install.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is a TABLE keyed by query byte, one qword per byte, saying "this
// byte, on this platform, means (sink, action)". The three sinks are
// VOLUME, BACKLIGHT and MEDIA -- the surface area R31.M6-001/002/003
// asks for. The routing decision is the whole of it: this module owns
// no keyboard, drives no PWM, mints no capability and is not on any
// ISR path. It sits BETWEEN core/acpi/ec_event.pdx (which labels a
// query byte with an EC_EVT_CLASS_HOTKEY) and the three eventual
// sinks, and it does what ec_event does not: name the HOTKEY-class
// event's INTENT.
//
// -----------------------------------------------------------------------------
// §0.1  BACKLIGHT IS LIVE. VOLUME AND MEDIA ARE HONEST DEFERRALS.
// -----------------------------------------------------------------------------
//
// KIND_BACKLIGHT (0x15a, kind_backlight.pdx) is LANDED and its
// backlight_report_install seam accepts a level and a slot -- so
// hotkey_dispatch_backlight_step calls it. The path is real, and the
// witness in tests/kernel/input/hotkey_synth.pdx composes the two:
// decode Fn+F5 -> HK_SINK_BACKLIGHT, compute new = base - step,
// backlight_report_install(slot, new), read backlight_current_of_slot
// back and assert it moved.
//
// KIND_HID_EVENT does NOT exist in this tree (R32 owns it). The volume
// and media sinks have no actuator this side of that milestone, so
// hotkey_dispatch_route returns the sink code and BUMPS THE PER-SINK
// COUNTER -- an honest scaffold for the routing decision, no more.
// When KIND_HID_EVENT lands, the two counters become the input for the
// HID synthesis path and this module gains a hotkey_dispatch_hid seam
// with the same shape hotkey_dispatch_backlight_step has now. Nothing
// in this module has to move for that to happen.
//
// The counters exist for the same reason ec_route's do: a hot-key that
// arrived but was NOT routed and a hot-key that arrived and WAS routed
// but had no actuator behind it are different observations, and an
// operator chasing "the mute key does nothing" needs them apart.
//
// =============================================================================
// §1  THE MAP IS INSTALLED, NOT COMPILED IN
// =============================================================================
//
// Same discipline as core/acpi/ec_event.pdx §2 and, for the same
// reason: query-byte numbering is chosen by each vendor's firmware.
// The T14 G4 might report Fn+F4 as _Q0A on one BIOS revision and _Q1B
// on the next, and design/acpi/no-aml-in-kernel.md forbids ring 0
// learning either from bytecode evaluation. So the kernel holds a
// table of small integers and never learns them by itself:
// hotkey_dispatch_install is the installer, and its intended caller is
// the ring-3 supervisor that already walks the EC's methods.
// Hardcoding a T14 G4 numbering here would produce a kernel that
// silently misroutes every other laptop.
//
// =============================================================================
// §2  THE MAP STARTS EMPTY, ONLY FILLS, AND A FILLED ENTRY CANNOT
//     CHANGE
// =============================================================================
//
// Same monotonicity ec_event_map_set holds and for the same reason:
// every downstream decision -- which sink counter moves, which
// actuator is called -- is taken from the (sink, action) pair, so a
// byte silently remapped from BACKLIGHT_UP to VOLUME_MUTE inverts a
// physical action with no symptom until an operator presses the
// brightness key and the machine goes mute. Re-installing the SAME
// (sink, action) returns OK because a caller that installs the map
// twice has achieved what it asked for; installing a DIFFERENT one
// returns HOTKEY_MAP_ALREADY. Wholesale clearing exists only in
// hotkey_dispatch_reset, which is a boot/teardown operation and not a
// per-entry one.
//
// tools/build.sh greps for the absence of the natural names such a
// demotion primitive would carry, for the same reason it does on
// ec_event.
//
// =============================================================================
// §3  ENCODING: ONE QWORD PER BYTE, sink | (action << 8)
// =============================================================================
//
// A packed representation (four entries per qword) would let installing
// one byte become a read-modify-write over three neighbours. On a table
// where one neighbour is Fn+F5 (brightness down) and another is Fn+F4
// (mute), a mask bug corrupts a DIFFERENT byte's meaning, which is the
// class of bug §2 exists to prevent and the hardest kind to see.
//
// Unpacked, an index is `byte << 3` and an entry is a whole qword
// nothing else shares. Two kilobytes of .bss is not a quantity this
// kernel needs to argue about, for the same reason ec_event §5 does not.
//
// Byte 0 is REFUSED a meaning, mirroring ec_event_map_set: QR_EC
// returning 0 means no query is pending, and admitting it as a
// hot-key would make this module the one place in the path that
// treats "nothing happened" as an event with semantics.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFDB0..0xFFFFFDB9
// =============================================================================
//
// A ten-wide band disjoint from every other in tree: ec_event owns
// 0xFFFFFDBA..BF, ec_access owns 0xFFFFFDCx, ec_route owns 0xFFFFFDEx,
// blob_load owns 0xFFFFFDAx (through 0xFFFFFDAD). 0xFFFFFDB0..B9 was
// free. Disjointness is what lets a caller that threads a code up
// through the composed helper still name the gate that refused it.
//
// =============================================================================

module HotkeyDispatch = structure {

  // ==========================================================================
  // §3's three sinks and their sink-local action ordinals.
  //
  // NONE is 0 and means "no meaning installed for this byte", which
  // hotkey_dispatch_route reports as HOTKEY_UNMAPPED to a caller.
  // ==========================================================================

  pub let HK_SINK_NONE      : u64 = 0
  pub let HK_SINK_VOLUME    : u64 = 1  // #1111
  pub let HK_SINK_BACKLIGHT : u64 = 2  // #1112
  pub let HK_SINK_MEDIA     : u64 = 3  // #1113
  pub let HK_SINK_MAX       : u64 = 3

  // Volume actions. Three, because ACPI EC-hotkey typology on the T14
  // G4 (and every laptop this decade) exposes three keys: mute, down,
  // up. Volume-mute-microphone belongs to MEDIA, not here -- it is
  // reachable via Fn+F11/F12 on the same target and its actuator is
  // the microphone controller rather than the audio output.
  pub let HK_VOL_MUTE : u64 = 0
  pub let HK_VOL_DOWN : u64 = 1
  pub let HK_VOL_UP   : u64 = 2
  pub let HK_VOL_MAX  : u64 = 2

  // Backlight actions. Two, because a hot-key can only step in one of
  // two directions; the amount comes from the caller as `step`, not
  // from the table, because a system-wide fixed step would be a
  // policy imposed by the kernel.
  pub let HK_BL_DOWN : u64 = 0
  pub let HK_BL_UP   : u64 = 1
  pub let HK_BL_MAX  : u64 = 1

  // Media actions. Two placeholder ordinals for the R32 KIND_HID_EVENT
  // synthesis path; the T14 G4 maps Fn+F11 to mic-mute and Fn+F12 to
  // play/pause on the shipping BIOS, and the exact byte-to-action
  // binding is a ring-3 install rather than a kernel decision.
  pub let HK_MEDIA_MIC_MUTE : u64 = 0
  pub let HK_MEDIA_PLAY     : u64 = 1
  pub let HK_MEDIA_MAX      : u64 = 1

  // ==========================================================================
  // §4's failure taxonomy — 0xFFFFFDB0..0xFFFFFDB9.
  // ==========================================================================

  pub let HOTKEY_OK          : u64 = 0
  pub let HOTKEY_BAD_BYTE    : u64 = 0xFFFFFDB9
  pub let HOTKEY_BAD_SINK    : u64 = 0xFFFFFDB8
  pub let HOTKEY_BAD_ACTION  : u64 = 0xFFFFFDB7
  pub let HOTKEY_MAP_ALREADY : u64 = 0xFFFFFDB6
  pub let HOTKEY_UNMAPPED    : u64 = 0xFFFFFDB5
  pub let HOTKEY_BAD_STEP    : u64 = 0xFFFFFDB4
  pub let HOTKEY_BL_FAILED   : u64 = 0xFFFFFDB3

  // The lookup sentinel for a byte with no meaning. Distinct from
  // HOTKEY_UNMAPPED so a positional decoder answer and an operation
  // refusal do not collide the way ec_event's CLASS_NONE and
  // EC_EVT_MAP_UNBOUND would if they shared a value.
  pub let HOTKEY_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ACPI 6.5 §12.2 -- the query byte domain is the 256 values of the
  // EmbeddedControl space, and byte 0 is not one of them (§12.9).
  pub let HOTKEY_BYTE_MAX : u64 = 256

  // ==========================================================================
  // Storage.
  //
  //   _hotkey_dispatch_table  256 entries, one qword per byte:
  //                             bits [7:0]   sink
  //                             bits [15:8]  action
  //                             bits [63:16] reserved, MUST be zero
  //
  //   _hotkey_dispatch_stats  8-wide counter block:
  //                             +0  routed_volume     bytes dispatched
  //                             +8  routed_backlight  and delivered
  //                             +16 routed_media      to a sink
  //                             +24 unmapped          bytes with no meaning
  //                             +32 refused           installs rejected
  //                             +40 bl_failed         backlight helper
  //                                                   report refused
  //
  // tools/build.sh confines relocations against both symbols to
  // core/input/hotkey_dispatch.o, so no second object can widen a
  // meaning without going through hotkey_dispatch_install's gates.
  // ==========================================================================

  pub let mut _hotkey_dispatch_table : [u64; 256] = uninit @align(64)
  pub let mut _hotkey_dispatch_stats : [u64; 8]   = uninit @align(64)

  pub let HK_ST_ROUTED_VOLUME    : u64 = 0
  pub let HK_ST_ROUTED_BACKLIGHT : u64 = 1
  pub let HK_ST_ROUTED_MEDIA     : u64 = 2
  pub let HK_ST_UNMAPPED         : u64 = 3
  pub let HK_ST_REFUSED          : u64 = 4
  pub let HK_ST_BL_FAILED        : u64 = 5
  pub let HK_ST_MAX              : u64 = 8

  // ==========================================================================
  // hotkey_dispatch_reset() -> ()
  // ==========================================================================

  pub let hotkey_dispatch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001 (#1111): clear every entry and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring the discipline in ec_event_reset and backlight_table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares. Leaf. Labels prefixed hk_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _hotkey_dispatch_table];
        xor rax, rax;
        xor rcx, rcx;
      hk_rs_map:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  hk_rs_map;

        lea r10, [rip + _hotkey_dispatch_stats];
        xor rcx, rcx;
      hk_rs_stat:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hk_rs_stat;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hotkey_dispatch_note(which) -> ()
  // hotkey_dispatch_stat(which) -> count
  // ==========================================================================

  pub let hotkey_dispatch_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001 (#1111): increment one counter; silent no-op on out-of-range. Every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true -- same shape as ec_event_note and backlight_note. Leaf. Labels prefixed hk_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HK_ST_MAX
        jae hk_nt_out;
        lea r10, [rip + _hotkey_dispatch_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hk_nt_out:
        ret
      }
    } @no_frame

  pub let hotkey_dispatch_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001 (#1111): bounds-checked read of one counter; out of range returns 0. Same shape as ec_event_stat and backlight_stat. Leaf. Labels prefixed hk_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HK_ST_MAX
        jae hk_st_zero;
        lea r10, [rip + _hotkey_dispatch_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hk_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hotkey_dispatch_action_max(sink) -> max | HOTKEY_DECODE_BAD
  //
  // The action bound for a sink. Named accessor rather than a compile-
  // time table lookup in the install gate so a future sink can be
  // added without touching the gate's structure.
  // ==========================================================================

  pub let hotkey_dispatch_action_max : (u64) -> u64 !{} @{} =
    fn (sink: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M6-001 (#1111): the maximum legal action ordinal for a sink, or HOTKEY_DECODE_BAD for a sink outside the enumeration. Pure computation over the three sinks -- three equality tests, no ordering. Same review property ec_event_shed_policy has: a fourth sink cannot be admitted by falling off the end of a compare chain, it must be added by name. Leaf. Labels prefixed hk_am_ per reserved-label discipline.",
      block: {
        cmp rdi, 1;                      // HK_SINK_VOLUME
        je  hk_am_vol;
        cmp rdi, 2;                      // HK_SINK_BACKLIGHT
        je  hk_am_bl;
        cmp rdi, 3;                      // HK_SINK_MEDIA
        je  hk_am_med;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      hk_am_vol:
        mov rax, 2;                      // HK_VOL_MAX
        ret;
      hk_am_bl:
        mov rax, 1;                      // HK_BL_MAX
        ret;
      hk_am_med:
        mov rax, 1;                      // HK_MEDIA_MAX
        ret
      }
    } @no_frame

  // ==========================================================================
  // hotkey_dispatch_install(query_byte, sink, action) -> HOTKEY_*
  //
  // §2's monotone installer. Gates in order.
  // ==========================================================================

  pub let hotkey_dispatch_install : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (query_byte: u64) (sink: u64) (act_ord: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001/002/003 (#1111/#1112/#1113): give one query byte one (sink, action) meaning. Gates, in order: (1) query_byte in 1..255 -> HOTKEY_BAD_BYTE. Byte 0 is refused because QR_EC returning 0 means no query is pending -- §3 states this at length and ec_event_map_set makes the same refusal for the same reason. (2) sink in 1..HK_SINK_MAX -> HOTKEY_BAD_SINK. HK_SINK_NONE (0) is refused: storing NONE would produce an entry that reads as unmapped at lookup, which is a way to un-install a byte without the reset that lets a reader see it. (3) action within the sink's own range via hotkey_dispatch_action_max -> HOTKEY_BAD_ACTION. This is per-sink, because a global action range would let (BACKLIGHT, 2) install successfully and later read as an out-of-range action every dispatch has to guard against. (4) MONOTONICITY GATE: if the entry already holds a non-NONE sink, a request naming the SAME (sink, action) returns OK (a caller that installs the map twice has achieved what it asked for) and a request naming a DIFFERENT (sink, action) returns HOTKEY_MAP_ALREADY and is counted in HK_ST_REFUSED. That is §2's invariant and the most load-bearing refusal in this file. Encoding is sink | (action << 8) with bits [63:16] reserved-zero, so the reserved band cannot be smuggled a value through this path. Two pushes (rbx = query_byte, r12 = sink, r13 = action) leave rsp%16 == 0 at the nested call. Labels prefixed hk_mi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // query_byte
        mov r12, rsi;                    // sink
        mov r13, rdx;                    // action

        // (1) byte.
        cmp rbx, 0;
        je  hk_mi_bad_byte;
        mov r11, 256;
        cmp rbx, r11;
        jae hk_mi_bad_byte;

        // (2) sink in 1..3.
        cmp r12, 0;
        je  hk_mi_bad_sink;
        mov r11, 3;                      // HK_SINK_MAX
        cmp r12, r11;
        ja  hk_mi_bad_sink;

        // (3) action within sink range.
        mov rdi, r12;
        call hotkey_dispatch_action_max;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  hk_mi_bad_sink;
        cmp r13, rax;
        ja  hk_mi_bad_action;

        // (4) read existing entry.
        mov r8, rbx;
        shl r8, 3;
        lea r9, [rip + _hotkey_dispatch_table];
        add r8, r9;
        mov rax, [r8 + 0];
        cmp rax, 0;
        je  hk_mi_store;                 // unset: fill it

        // Pack the proposed entry the same way as storage.
        mov r10, r13;
        shl r10, 8;
        or  r10, r12;
        cmp rax, r10;
        je  hk_mi_same;                  // idempotent OK
        jmp hk_mi_already;

      hk_mi_store:
        mov r10, r13;
        shl r10, 8;
        or  r10, r12;
        mov [r8 + 0], r10;
      hk_mi_same:
        xor rax, rax;                    // HOTKEY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hk_mi_bad_byte:
        mov rax, 0xFFFFFDB9;             // HOTKEY_BAD_BYTE
        jmp hk_mi_refused;
      hk_mi_bad_sink:
        mov rax, 0xFFFFFDB8;             // HOTKEY_BAD_SINK
        jmp hk_mi_refused;
      hk_mi_bad_action:
        mov rax, 0xFFFFFDB7;             // HOTKEY_BAD_ACTION
        jmp hk_mi_refused;
      hk_mi_already:
        mov rax, 0xFFFFFDB6;             // HOTKEY_MAP_ALREADY

      hk_mi_refused:
        push rax;
        lea r10, [rip + _hotkey_dispatch_stats];
        mov r11, [r10 + 32];             // HK_ST_REFUSED
        add r11, 1;
        mov [r10 + 32], r11;
        pop rax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hotkey_dispatch_sink_of(query_byte) -> sink | HK_SINK_NONE
  // hotkey_dispatch_action_of(query_byte) -> action | HOTKEY_DECODE_BAD
  //
  // Pure lookups. Sink returns HK_SINK_NONE (not HOTKEY_DECODE_BAD) so
  // that "no meaning" is a value INSIDE the sink enumeration, which
  // means a caller can dispatch on the answer without a separate
  // sentinel test. Action returns HOTKEY_DECODE_BAD for a byte with
  // no meaning, because 0 is a legitimate action ordinal for every
  // sink and collapsing the two would let an unmapped byte read as
  // (WHATEVER_SINK, 0) -- exactly the misfire §2 exists to prevent.
  // ==========================================================================

  pub let hotkey_dispatch_sink_of : (u64) -> u64 !{mem} @{} =
    fn (query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001 (#1111): the sink this kernel believes query_byte is bound to, HK_SINK_NONE for OOB or byte 0 or an unset entry. Returns a VALUE IN THE SINK ENUMERATION for a missing meaning, so a routing caller can switch on the answer without a separate is-unmapped test. Same rationale ec_event_class_of uses for EC_EVT_CLASS_NONE-on-refusal. Index is query_byte << 3 into a table of whole qwords. Leaf. Labels prefixed hk_so_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  hk_so_none;
        mov r11, 256;
        cmp rdi, r11;
        jae hk_so_none;
        mov r8, rdi;
        shl r8, 3;
        lea r9, [rip + _hotkey_dispatch_table];
        add r8, r9;
        mov rax, [r8 + 0];
        and rax, 0xFF;
        ret;
      hk_so_none:
        xor rax, rax;                    // HK_SINK_NONE
        ret
      }
    } @no_frame

  pub let hotkey_dispatch_action_of : (u64) -> u64 !{mem} @{} =
    fn (query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001 (#1111): the action ordinal for query_byte, HOTKEY_DECODE_BAD for a byte with no meaning. Distinct sentinel from hotkey_dispatch_sink_of's HK_SINK_NONE because a valid action can be 0 (HK_VOL_MUTE, HK_BL_DOWN, HK_MEDIA_MIC_MUTE) and collapsing the two would let an unmapped byte read as action-0 of whichever sink a downstream reader assumed. Leaf. Labels prefixed hk_ao_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  hk_ao_bad;
        mov r11, 256;
        cmp rdi, r11;
        jae hk_ao_bad;
        mov r8, rdi;
        shl r8, 3;
        lea r9, [rip + _hotkey_dispatch_table];
        add r8, r9;
        mov rax, [r8 + 0];
        cmp rax, 0;
        je  hk_ao_bad;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      hk_ao_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hotkey_dispatch_route(query_byte) -> sink | HOTKEY_UNMAPPED
  //
  // Volume-and-media path. Reads the sink and BUMPS the per-sink
  // counter; returns the sink so the caller can name the intent even
  // if no HID actuator exists yet.
  //
  // BACKLIGHT bytes ROUTE HERE TOO -- the routed_backlight counter
  // moves and the sink is returned -- but the actuator side of a
  // backlight hot-key is hotkey_dispatch_backlight_step, and a caller
  // that stops at this function has decoded the intent without acting
  // on it. That is the shape §0.1 argues for: the routing decision is
  // separable from the actuator, so a caller can prove the decoder
  // ran before it wires the actuator in.
  //
  // ARITY ONE. A "target endpoint" or "target slot" parameter would
  // conflate the routing decision (property of the byte) with the
  // actuator wiring (property of the machine at this instant), and
  // the whole point of a scaffold that predates KIND_HID_EVENT is
  // keeping the two apart.
  // ==========================================================================

  pub let hotkey_dispatch_route : (u64) -> u64 !{mem} @{} =
    fn (query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-001/002/003 (#1111/#1112/#1113): decode the hot-key intent for query_byte and count the routing. Reads the sink; if HK_SINK_NONE, bumps HK_ST_UNMAPPED and returns HOTKEY_UNMAPPED -- a distinct code from HK_SINK_NONE so the caller distinguishes 'no meaning' from 'meaning was NONE'. If VOLUME/BACKLIGHT/MEDIA, bumps the corresponding routed counter and returns the sink. THE COUNTER IS THE POINT: no HID actuator exists yet (KIND_HID_EVENT is R32), and no backlight actuator is invoked here (that is hotkey_dispatch_backlight_step's job), so the routed counter is the only in-tree evidence that the decoder was reached at all. When the sinks land, the counters become the routing side of the accounting identity 'seen == routed + unmapped' the caller will assert. Two pushes (rbx = query_byte carried across the nested lookup) leave rsp%16 == 0 at every one of the four nested calls. Labels prefixed hk_ro_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov rdi, rbx;
        call hotkey_dispatch_sink_of;
        mov r12, rax;                    // sink

        cmp r12, 0;                      // HK_SINK_NONE
        je  hk_ro_unmapped;
        cmp r12, 1;                      // HK_SINK_VOLUME
        je  hk_ro_vol;
        cmp r12, 2;                      // HK_SINK_BACKLIGHT
        je  hk_ro_bl;
        cmp r12, 3;                      // HK_SINK_MEDIA
        je  hk_ro_med;
        jmp hk_ro_unmapped;              // defensive: unknown sink

      hk_ro_vol:
        mov rdi, 0;                      // HK_ST_ROUTED_VOLUME
        call hotkey_dispatch_note;
        mov rax, 1;                      // HK_SINK_VOLUME
        jmp hk_ro_out;
      hk_ro_bl:
        mov rdi, 1;                      // HK_ST_ROUTED_BACKLIGHT
        call hotkey_dispatch_note;
        mov rax, 2;                      // HK_SINK_BACKLIGHT
        jmp hk_ro_out;
      hk_ro_med:
        mov rdi, 2;                      // HK_ST_ROUTED_MEDIA
        call hotkey_dispatch_note;
        mov rax, 3;                      // HK_SINK_MEDIA
        jmp hk_ro_out;

      hk_ro_unmapped:
        mov rdi, 3;                      // HK_ST_UNMAPPED
        call hotkey_dispatch_note;
        mov rax, 0xFFFFFDB5;             // HOTKEY_UNMAPPED

      hk_ro_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hotkey_dispatch_backlight_step(query_byte, backlight_slot,
  //                                base, step) -> HOTKEY_OK | ...
  //
  // The ONE COMPOSED HELPER in this module. Decodes the byte's action
  // (must be HK_BL_UP or HK_BL_DOWN) and calls
  // backlight_report_install(slot, base +/- step).
  //
  // FOUR ARGUMENTS AND NO MORE. `base` is passed in rather than read
  // from backlight_current_of_slot because §0.1's split places
  // decoding here and actuator state elsewhere: a compositor knows
  // what brightness it last showed the user, and reading the row's
  // cached current would either duplicate that knowledge or overwrite
  // it with a value the compositor has not agreed to. `step` is
  // supplied for the same reason -- a system-wide fixed step would be
  // a policy imposed by the kernel.
  // ==========================================================================

  pub let hotkey_dispatch_backlight_step : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (query_byte: u64) (backlight_slot: u64) (base: u64) (step: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M6-002 (#1112): compute the new brightness for one backlight hot-key press and install it through KIND_BACKLIGHT's own reporting seam. Gates, in order: (1) decode the byte's sink; must be HK_SINK_BACKLIGHT else HOTKEY_BAD_SINK (a HOTKEY_UNMAPPED byte reads as HK_SINK_NONE, which is also not HK_SINK_BACKLIGHT, and both refusals share the code because the caller's next action is the same -- the byte is not for this sink). (2) decode the action; must be HK_BL_UP or HK_BL_DOWN, else HOTKEY_BAD_ACTION (defensive: a well-formed backlight install cannot violate this, but the check is here so the arithmetic below cannot see anything else). (3) step non-zero else HOTKEY_BAD_STEP -- a step of zero is a no-op call whose success would misleadingly claim brightness moved. (4) compute new = base +/- step depending on direction. NO CLAMPING: if base + step overflows past brightness_max or base - step underflows past brightness_min, backlight_report_install refuses with BACKLIGHT_IMPLAUSIBLE_LEVEL and this function propagates HOTKEY_BL_FAILED (counted in HK_ST_BL_FAILED). Clamping here would silently substitute the range endpoint for the caller's computed level, which is exactly the failure kind_backlight.pdx §3 refuses to make. (5) backlight_report_install(slot, new). Its own gates (dead slot, wrong kind, implausible level) are reused as-is; a REPORT that lands returns BACKLIGHT_OK, is counted in HK_ST_ROUTED_BACKLIGHT, and returns HOTKEY_OK. Underflow on DOWN (base < step) is caught before the subtract, so the value passed to backlight_report_install is always a plausible u64 -- refusing with HOTKEY_BL_FAILED at the boundary rather than reaching backlight_report_install with an underflowed value that happens to be in-range keeps the failure ATTRIBUTABLE to the step logic rather than to the panel range. Four pushes (rbx = byte, r12 = slot, r13 = base, r14 = step) leave rsp%16 == 0 at every nested call. Labels prefixed hk_bs_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // query_byte
        mov r12, rsi;                    // backlight_slot
        mov r13, rdx;                    // base
        mov r14, rcx;                    // step

        // (1) sink.
        mov rdi, rbx;
        call hotkey_dispatch_sink_of;
        cmp rax, 2;                      // HK_SINK_BACKLIGHT
        jne hk_bs_bad_sink;

        // (2) action.
        mov rdi, rbx;
        call hotkey_dispatch_action_of;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  hk_bs_bad_action;
        cmp rax, 1;                      // HK_BL_MAX
        ja  hk_bs_bad_action;

        // (3) step != 0.
        cmp r14, 0;
        je  hk_bs_bad_step;

        // (4) compute new. rax still holds the action. rsi carries
        // the new brightness into the install call, computed in place
        // so no callee-save register beyond the four already pushed
        // has to hold it across a call.
        cmp rax, 1;                      // HK_BL_UP?
        je  hk_bs_up;

        // HK_BL_DOWN: refuse underflow before the subtract.
        cmp r13, r14;
        jb  hk_bs_bl_failed;
        mov rsi, r13;
        sub rsi, r14;
        jmp hk_bs_install;

      hk_bs_up:
        mov rsi, r13;
        add rsi, r14;
        // Overflow past u64 is not physically representable for any
        // realistic brightness range; backlight_report_install rejects
        // the value against brightness_max and we treat that as
        // HOTKEY_BL_FAILED.

      hk_bs_install:
        // (5) install.
        mov rdi, r12;
        call backlight_report_install;
        cmp rax, 0;                      // BACKLIGHT_OK
        jne hk_bs_bl_failed;

        // OK: count and return.
        mov rdi, 1;                      // HK_ST_ROUTED_BACKLIGHT
        call hotkey_dispatch_note;
        xor rax, rax;                    // HOTKEY_OK
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hk_bs_bad_sink:
        mov rax, 0xFFFFFDB8;             // HOTKEY_BAD_SINK
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hk_bs_bad_action:
        mov rax, 0xFFFFFDB7;             // HOTKEY_BAD_ACTION
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hk_bs_bad_step:
        mov rax, 0xFFFFFDB4;             // HOTKEY_BAD_STEP
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hk_bs_bl_failed:
        mov rdi, 5;                      // HK_ST_BL_FAILED
        call hotkey_dispatch_note;
        mov rax, 0xFFFFFDB3;             // HOTKEY_BL_FAILED
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
