// src/kernel/core/tui/canvas_present.pdx — R89.M1-003 (#1990)
//
// KIND_TUI_CANVAS TUI_OP_PRESENT real body: back/front buffer cell
// diff + SGR/cursor-position ANSI sequence builder + byte emission.
// Design authority: design/kernel/kind-tui-canvas.md §"Ops" (op 0),
// §"Backing buffer layout", §"Cell wire format". Wired from the
// PRESENT arm of cap_handler_tui_canvas.pdx (R89.M1-002, #1989),
// which already validates the row and the R_TUI_PRESENT right before
// reaching this file — every function here trusts its row_id/pointer
// arguments were pre-validated by that single upstream gate.
//
// R89.M1-004 (#1991) adds ONE line to tui_present_body's success
// tail: a call to kind_tui_canvas.pdx's tui_stats_bump_presents,
// bumping the kernel-wide _tui_stats[TUI_ST_PRESENTS] counter. This
// file never touches _tui_stats directly — that symbol's one-writer
// confinement (tools/build.sh) is to kind_tui_canvas.o, so every
// bump here goes through the exported helper. This is separate from,
// and additional to, the pre-existing per-row `presents` field at row
// +48 that tui_present_body already bumped at R89.M1-003: that field
// counts PRESENTs for ONE canvas row; _tui_stats.presents is the
// kernel-wide total across every row.
//
// =============================================================================
// WHERE THE CELL DATA ACTUALLY LIVES (why kind_tui_canvas.pdx's row
// needed NO new fields for this landing)
// =============================================================================
//
// The design doc's "Backing buffer layout" section is unambiguous: the
// back buffer (client-writable, offset [0,N)) and front buffer
// (kernel-owned "last emitted" snapshot, offset [N,2N)) both live
// INSIDE THE MEMORY_SLOT'S BYTE RANGE — a KIND_MEMORY(4) capability
// the canvas row already names at +16, sized 2*rows*cols*CELL_BYTES
// at mint (kind_tui_canvas.pdx's tui_size_valid gate). The 64-byte
// canvas row (kind_tui_canvas.pdx) is pure METADATA (canvas_id,
// memory_slot, tty_slot, rows|cols, cell_bytes, presents, reserved) —
// it was never meant to hold cell bytes, and does not need to: no
// back_buffer/front_buffer field, no dirty-bookkeeping field, no row
// layout change of any kind. This resolves the task's own contingency
// ("if back+front don't fit in 64B/row... describe the delta and
// STOP") by observing the premise doesn't apply — they were never
// meant to fit there.
//
// To reach the actual bytes from kernel context, this file resolves
// memory_slot (a cap_table SLOT INDEX, per kind_tui_canvas.pdx's own
// tui_check_memory gate) into cap_table[memory_slot].target_ptr — the
// same 24-byte-stride descriptor layout (kind@+0, rights@+8,
// target_ptr@+16) documented in cap/invoke.pdx and cap/mint.pdx and
// already dereferenced directly by the one existing real memory
// handler in this tree, cap_handler_page (core/cap/kind_page.pdx):
// target_ptr is a kernel-dereferenceable pointer, not an opaque
// user-space-only handle. buf_base = that target_ptr; back buffer =
// [buf_base, buf_base+N); front buffer = [buf_base+N, buf_base+2N).
//
// CELL_WRITE is NOT a kernel op and needed NO wiring here: per the
// design doc's own "Why cap_invoke is control-plane-only, not
// per-cell" section, a client with a mapped memory_slot writes cell
// bytes directly into the back buffer via ordinary stores — cap_invoke
// (and therefore this file) is reserved for the handful of *control*
// transitions (PRESENT/RESIZE/CLEAR/query/revoke). This landing does
// not touch that path because there is no kernel-side path to touch.
//
// =============================================================================
// TTY_OP_WRITE FIDELITY (why uart_putc + tty_row_bytes_bump, not
// cap_invoke(TTY_OP_WRITE) or tty_write)
// =============================================================================
//
// kind_tty.pdx's own header is explicit: at this landing TTY_OP_WRITE
// "records the acknowledgement (bytes_written++)... and does not touch
// a physical device" — cap_handler_tty's tty_hn_write arm (kind_tty.
// pdx) calls tty_row_bytes_bump(row_id) once per invocation and
// nothing else. There is no live (buf,len) payload wire yet (R49.M1
// follow-up, per that file's own scope note), so going through
// cap_invoke(TTY_OP_WRITE) would silently swallow every ANSI byte this
// file builds — the bytes would never reach a terminal, only a
// counter. tty_write (core/tty/write.pdx) DOES touch real hardware
// (uart_putc, with \n->\r\n translation) but its signature is a VFS
// vops write(vn, buf, len, off) keyed on a VNODE POINTER; there is no
// mapping from a KIND_TTY row id (tty_slot) to a vnode anywhere in the
// tree, so it cannot be reached from a bare tty_slot without inventing
// that mapping — out of scope for a canvas-side change, and forbidden
// anyway (kind_tty.pdx / cap_handler_tty.pdx are frozen post-#1986).
//
// This file instead calls the SAME primitive TTY_OP_WRITE itself calls
// (tty_row_bytes_bump(tty_slot), directly, once per emitted byte — the
// "direct call into the TTY row's write-byte helper" the issue asks
// for) for accounting fidelity with the existing wire, AND calls
// uart_putc directly for the actual physical emission, since that is
// the only real byte-sink primitive reachable from a bare tty_slot in
// the tree today. Both calls live in tui_emit_byte, the single choke
// point every ANSI byte in this file passes through. See kind_tty.pdx
// tty_row_bytes_bump's own doc ("bump bytes_written by 1 on a live
// row") — it is a per-BYTE accounting call, matching our per-byte loop
// exactly, unlike TTY_OP_WRITE's own per-INVOCATION (not per-byte)
// bump.
//
// =============================================================================
// SGR MODIFIER BIT ASSIGNMENT (new at this landing — flagged for main)
// =============================================================================
//
// The design doc's cell wire format lists the eight `mods` flags in
// prose order only ("BOLD|ITALIC|UNDERLINE|DIM|CROSSED_OUT|SLOW_BLINK|
// RAPID_BLINK|REVERSED") with NO bit-position table, and postui's own
// docs/design.md (paideia-os/postui, a separate repo) was unreachable
// from this environment. This file assigns bit0..bit7 to that prose
// order verbatim (bit0=BOLD .. bit7=REVERSED) and maps each to its
// standard ANSI SGR code (BOLD=1, DIM=2, ITALIC=3, UNDERLINE=4,
// SLOW_BLINK=5, RAPID_BLINK=6, REVERSED=7, CROSSED_OUT=9 — SGR 8 is
// CONCEALED, not one of the eight named flags, hence the gap). THIS IS
// A NEW ASSIGNMENT THIS LANDING INTRODUCES, not a re-derivation of an
// existing one — main should confirm it against postui's actual
// CELL_WRITE encoder before postui ships a client that sets these
// bits, or the two sides will disagree about which bit means BOLD.
//
// =============================================================================
// EMPTY-CELL GLYPH CONVENTION
// =============================================================================
//
// A cell whose 4-byte symbol field is all-zero (never written by a
// client — CLEAR's blank-sentinel semantics are R89.M1-004's, out of
// scope here) renders as a literal space (0x20) rather than emitting
// zero glyph bytes, so a dirty run with an untouched cell still
// advances the terminal cursor correctly. Symbol bytes are otherwise
// emitted up to the first zero byte (design doc: "zero-padded if
// shorter", i.e. padding is a contiguous zero suffix).
//
// =============================================================================
// SGR COALESCING SCOPE
// =============================================================================
//
// `_tui_last_attr` (this file) tracks the most recently EMITTED cell's
// packed (fg|bg|mods) attribute across the ENTIRE PRESENT call, not
// just within one row — ANSI SGR state is a terminal-wide property
// independent of cursor position, so carrying it across a dirty row
// boundary is correct and strictly reduces bytes emitted. It is reset
// to "invalid" (bit 63 clear) at the top of every tui_present_body
// call rather than assumed to persist across PRESENT calls, since
// nothing here can observe the real terminal's SGR state at the start
// of a fresh call (a prior PRESENT, a user typing at a raw terminal, a
// reset sequence from another program, etc. could all have changed
// it) — the first dirty cell of every frame always re-asserts its SGR
// explicitly rather than trusting stale in-kernel state.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No frameless-function annotations anywhere (#1606). No `add reg, [mem]`. Every byte
// load uses `xor reg, reg; mov_b reg, [ptr]` (proven in write.pdx /
// hex.pdx / format.pdx); byte STORES (tui_emit_dec's digit staging
// only) use the `mov_b [ptr], reg8` idiom format.pdx's u64_to_dec_rpad
// already proves. No `cmp reg, [mem]` anywhere — mount_block.pdx's own
// header notes "no proven precedent for that operand form exists
// anywhere else in this codebase's .pdx sources"; every comparison
// here loads to a register first, then `cmp reg, reg`. No `test`;
// every branch is `cmp reg, imm`/`cmp reg, reg` + `je`/`jne`/`jae`/
// `jb`/`jge`. Every label in this file is prefixed `tui_present_`,
// `tui_diff_`, or `tui_emit_` per function family (reserved-word
// discipline — `loop`/`if` etc. are keywords).
//
// =============================================================================
// FUNCTION INVENTORY (5, not the 2-3 hinted at in the issue — see
// note below)
// =============================================================================
//
//   tui_present_body(row_id) -> bytes_total      — orchestrator; called
//     from cap_handler_tui_canvas's PRESENT arm
//   tui_diff_row(back_row_ptr, front_row_ptr, cols) -> packed(min,max)
//     | ALL_ONES (clean)                          — per-row diff scan
//   tui_emit_row(back_row_ptr, front_row_ptr, tty_slot, row_idx,
//     min_col, max_col) -> ()                     — cursor-position +
//     SGR-coalesced cell emission + back->front copy for one dirty row
//   tui_emit_dec(tty_slot, value) -> ()           — decimal ASCII emit
//   tui_emit_byte(tty_slot, byte) -> ()           — the single byte
//     sink every other function funnels through (uart_putc +
//     tty_row_bytes_bump + _tui_present_bytes accounting)
//
// A correct implementation of "diff + cursor-position + SGR-coalesced
// truecolor+mods ANSI builder + byte sink" does not compress into 2-3
// functions without either duplicating the divide-by-10 itoa loop
// ~10x inline (row, col, 6 RGB components, up to 8 mod codes, 3 fixed
// numbers) or folding unrelated concerns (diff scan vs. byte emission)
// into one oversized function. Five small, single-concern functions
// were chosen over three tangled ones; each is documented individually
// below.
//
// =============================================================================
// SCRATCH STATE
// =============================================================================
//
//   _tui_last_attr    — bit63: valid; bits[55:0]: last-emitted packed
//                        (fg[3]|bg[3]|mods[1]) attribute. Reset to 0
//                        (invalid) at the top of every PRESENT call.
//   _tui_present_bytes — running ANSI byte count for the CURRENT
//                        PRESENT call. Reset to 0 at the top of every
//                        call; read back for the `bytes=` fingerprint
//                        KV and as this file's return value.
//
// Neither is re-entrant-safe across concurrent PRESENT calls; the
// substrate has no concurrency story yet (single-flow, matching every
// other R89.M1 file), so this is not a new gap.

module CanvasPresent = structure {

  pub let mut _tui_last_attr     : u64 = uninit @align(8)
  pub let mut _tui_present_bytes : u64 = uninit @align(8)

  // Fingerprint (design doc §"Fingerprint golden": "tui canvas present
  // ok"). KV suffix (canvas=/rows_dirty=/bytes=) is this file's own
  // addition — the design doc names only the fixed tag text.
  pub let tui_present_tag_ok        : [u8; 54] = "tui canvas present ok [legacy: TUI CANVAS PRESENT OK]\0"
  pub let tui_present_k_canvas      : [u8; 7]  = "canvas\0"
  pub let tui_present_k_rows_dirty  : [u8; 11] = "rows_dirty\0"
  pub let tui_present_k_bytes       : [u8; 6]  = "bytes\0"

  // ==========================================================================
  // tui_emit_byte(tty_slot, byte) -> ()
  // ==========================================================================
  // The one byte sink every other function in this file funnels
  // through. Emits `byte` to the real UART (uart_putc — the only
  // reachable physical byte-sink primitive from a bare tty_slot; see
  // file header) AND bumps the row's bytes_written accounting via the
  // same primitive TTY_OP_WRITE itself calls (tty_row_bytes_bump),
  // once per byte rather than once per invocation — then bumps this
  // PRESENT call's running `_tui_present_bytes` counter.
  pub let tui_emit_byte : (u64, u64) -> () !{mem, sysreg, PortIo} @{paideia.port_io} =
    fn (tty_slot: u64) (byte: u64) -> unsafe {
      effects: { mem, sysreg, PortIo },
      capabilities: { paideia.port_io },
      justification: "R89.M1-003 (#1990): single byte-sink choke point. 2 pushes (rbx=tty_slot, r12=byte) + sub rsp,8 land every nested call (uart_putc, tty_row_bytes_bump) at rsp%16==0 (entry rsp%16==8, +24 -> 0). uart_putc(byte) is the real physical emit (only reachable primitive from a bare tty_slot — kind_tty.pdx/cap_handler_tty.pdx TTY_OP_WRITE is an ack-only stub per that file's own header, and tty_write's vn-keyed VFS signature has no tty_slot->vnode mapping anywhere in the tree). tty_row_bytes_bump(tty_slot) mirrors TTY_OP_WRITE's own accounting call, once per byte (that primitive's own contract is 'bump bytes_written by 1 on a live row', matching a per-byte loop exactly). _tui_present_bytes increments last, a plain rip-relative counter read-add-write with no ordering hazard against the two preceding calls. Effects/capabilities widened to a strict superset of uart_putc's own row (!{sysreg,PortIo}@{paideia.port_io}) per this tree's effect-widening discipline (see e.g. kind_tui_canvas.pdx's own klog_s1_x1 callers). Labels: none (straight-line, no branches).",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // tty_slot
        mov r12, rsi;                    // byte

        mov rdi, r12;
        call uart_putc;

        mov rdi, rbx;
        call tty_row_bytes_bump;

        lea r10, [rip + _tui_present_bytes];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tui_emit_dec(tty_slot, value) -> ()
  // ==========================================================================
  // Decimal-ASCII emit of `value` (row/col coordinates <= 4096, RGB
  // components <= 255, SGR codes <= 48 — a handful of digits at most).
  // Divide-by-10 staging shape mirrors klog/format.pdx's proven
  // u64_to_dec_rpad exactly (same `xor rdx,rdx; mov rcx,10; div rcx;
  // add dl,0x30` idiom), but emits each digit through tui_emit_byte
  // instead of writing into a caller-supplied buffer.
  pub let tui_emit_dec : (u64, u64) -> () !{mem, sysreg, PortIo} @{paideia.port_io} =
    fn (tty_slot: u64) (value: u64) -> unsafe {
      effects: { mem, sysreg, PortIo },
      capabilities: { paideia.port_io },
      justification: "R89.M1-003 (#1990): decimal ASCII emitter. 5 pushes (rbx=tty_slot, r12=value/quotient during divide, r13=final digit_count, r14=first-digit staging ptr, r15=emit-loop index) + sub rsp,16 (16-byte staging buffer, tail at rsp+15 -- values here never exceed 5 digits, 16 bytes is generous headroom) land rsp%16==0 at every nested tui_emit_byte call (entry rsp%16==8, +40+16=56 -> 0). r14/r15 are callee-save specifically so the staging-ptr and loop-index survive tui_emit_byte's own clobber of every caller-save register (r11, the natural scratch choice, is NOT callee-save and would not survive). Zero special-case emits '0' directly (digit_count=1, first-digit ptr = tail). Non-zero: divide-loop writes digits least-significant-first into the staging buffer via `mov_b [r10+0], dl` (format.pdx's own proven store idiom), decrementing r10 (the divide loop's OWN transient staging cursor, distinct from r14) until the quotient reaches 0; digit_count = (buffer end) - (final r10). Emit loop then walks r14[0..digit_count) forward (highest-order digit first) via `xor rdx,rdx; mov_b rdx,[ptr]` loads, one tui_emit_byte call per digit. Labels prefixed tui_emit_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                    // tty_slot
        mov r12, rsi;                    // value (mutated by divide loop)

        mov r10, rsp;
        add r10, 15;                      // tail byte of the 16-byte staging buffer

        cmp r12, 0;
        jne tui_emit_dec_divloop;

        mov al, 0x30;
        mov_b [r10 + 0], al;
        mov r13, 1;                        // digit_count = 1
        mov r14, r10;                       // first-digit ptr
        jmp tui_emit_dec_after;

      tui_emit_dec_divloop:
        mov rax, r12;
        mov rcx, 10;
        xor rdx, rdx;
        div rcx;                            // rax = quot, rdx = rem
        add rdx, 0x30;
        mov_b [r10 + 0], dl;
        mov r12, rax;
        cmp r12, 0;
        je tui_emit_dec_divdone;
        sub r10, 1;
        jmp tui_emit_dec_divloop;

      tui_emit_dec_divdone:
        mov rax, rsp;
        add rax, 16;                         // one-past-end of staging buffer
        mov r14, r10;                         // first (highest-order) digit ptr
        mov r13, rax;
        sub r13, r14;                          // digit_count

      tui_emit_dec_after:
        xor r15, r15;                           // emit-loop index i = 0
      tui_emit_dec_emit_loop:
        cmp r15, r13;
        jge tui_emit_dec_emit_done;
        mov rax, r14;
        add rax, r15;
        xor rdx, rdx;
        mov_b rdx, [rax + 0];
        mov rdi, rbx;
        mov rsi, rdx;
        call tui_emit_byte;
        add r15, 1;
        jmp tui_emit_dec_emit_loop;
      tui_emit_dec_emit_done:

        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tui_diff_row(back_row_ptr, front_row_ptr, cols) -> packed(min,max) | ALL_ONES
  // ==========================================================================
  // One pass over `cols` 16-byte cells, comparing back vs. front as two
  // 8-byte words each (no `cmp reg, [mem]` — every compared word is
  // loaded to a register first, per this tree's established
  // discipline; see file header). Returns `(min_col << 32) | max_col`
  // for the first-differing..last-differing column range, or
  // 0xFFFFFFFFFFFFFFFF (ALL_ONES) if every cell matched — safe as a
  // sentinel because both halves of a real packed result are bounded
  // by TUI_DIM_MAX (4096), so a real result can never read all-ones in
  // its top 32 bits.
  pub let tui_diff_row : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (back_row_ptr: u64) (front_row_ptr: u64) (cols: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R89.M1-003 (#1990): per-row cell diff scan. Leaf (no nested calls) -- 2 pushes (r12=front cell ptr, r13=loaded front word, both needed only to avoid `cmp reg,[mem]`) are pure convenience, not alignment-driven. rcx=c (loop cursor), r8=min_col (init=cols, an out-of-range sentinel meaning 'not found yet'), r9=max_col (init=0, meaningful only if r11 says any diff was found), r11=any_diff flag. Per cell: offset=c*16 (shl 4); back cell ptr = back_row_ptr+offset (r10); front cell ptr = front_row_ptr+offset (r12); compare [r10+0] vs [r12+0] then [r10+8] vs [r12+8], both via load-to-register-then-cmp-reg-reg (rax vs r13) -- any mismatch marks the cell dirty. On a dirty cell: any_diff=1; min_col updated only while c < current min_col (first hit wins, monotonically increasing c means later hits never lower it further); max_col unconditionally set to c on every dirty hit, so the FINAL write standing after the loop is exactly the rightmost (highest) differing column, no separate max-tracking branch needed. Done: any_diff==0 -> ALL_ONES; else pack (min_col<<32)|max_col. Labels prefixed tui_diff_.",
      block: {
        push r12;
        push r13;

        xor rcx, rcx;                      // c = 0
        mov r8, rdx;                        // min_col sentinel = cols
        xor r9, r9;                          // max_col = 0
        xor r11, r11;                         // any_diff = 0

      tui_diff_loop:
        cmp rcx, rdx;
        jae tui_diff_done;

        mov rax, rcx;
        shl rax, 4;                          // offset = c * 16
        mov r10, rdi;
        add r10, rax;                         // back cell ptr
        mov r12, rsi;
        add r12, rax;                          // front cell ptr

        mov rax, [r10 + 0];
        mov r13, [r12 + 0];
        cmp rax, r13;
        jne tui_diff_mark;
        mov rax, [r10 + 8];
        mov r13, [r12 + 8];
        cmp rax, r13;
        jne tui_diff_mark;
        jmp tui_diff_next;

      tui_diff_mark:
        mov r11, 1;
        cmp rcx, r8;
        jae tui_diff_skipmin;
        mov r8, rcx;                          // first (lowest) differing column
      tui_diff_skipmin:
        mov r9, rcx;                           // last (rightmost) differing column so far

      tui_diff_next:
        add rcx, 1;
        jmp tui_diff_loop;

      tui_diff_done:
        cmp r11, 0;
        jne tui_diff_found;
        mov rax, 0xFFFFFFFFFFFFFFFF;             // clean row
        jmp tui_diff_out;
      tui_diff_found:
        mov rax, r8;
        shl rax, 32;
        or rax, r9;

      tui_diff_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // tui_emit_row(back_row_ptr, front_row_ptr, tty_slot, row_idx, min_col, max_col) -> ()
  // ==========================================================================
  // Emits the cursor-position sequence once, then walks cells
  // min_col..=max_col as a raw pointer sweep (no per-cell index
  // register needed: the loop bound is an END POINTER, not a count),
  // coalescing SGR against `_tui_last_attr` (this file's cross-call
  // scratch — see file header "SGR coalescing scope"), then copies the
  // whole [min_col,max_col] byte range back->front in one contiguous
  // block once the emit loop completes (cells outside that range are
  // provably already equal, by construction of tui_diff_row's min/max,
  // so nothing outside the range needs copying).
  pub let tui_emit_row : (u64, u64, u64, u64, u64, u64) -> () !{mem, sysreg, PortIo} @{cap, paideia.port_io} =
    fn (back_row_ptr: u64) (front_row_ptr: u64) (tty_slot: u64) (row_idx: u64) (min_col: u64) (max_col: u64) -> unsafe {
      effects: { mem, sysreg, PortIo },
      capabilities: { cap, paideia.port_io },
      justification: "R89.M1-003 (#1990): one dirty row's cursor-position + SGR-coalesced cell emission + back->front copy. 6 pushes (rbx=tty_slot, r12=cur_back cell ptr (mutates each loop iter), r13=diff=front_row_ptr-back_row_ptr (constant; cur_front is always cur_back+diff, so only ONE pointer needs to advance), r14=row_idx+1 early / repurposed to start_back after the cursor-position emit, r15=min_col+1, rbp=end_back=back_row_ptr+(max_col+1)*16, the loop's exclusive pointer bound) + sub rsp,8 land every nested call at rsp%16==0 (entry rsp%16==8, +48+8=56 -> 0). row_idx+1/min_col+1 are captured into callee-save r14/r15 BEFORE the first call (tui_emit_byte for ESC), since the original rcx/r8 param registers are caller-save and would not survive it. Cursor position: ESC(0x1B) '[' <row+1> ';' <col+1> 'H'. r14 is then repurposed (dead as row_idx+1 after the position emit) to hold start_back = initial cur_back, needed by the trailing copy step. Loop: while r12 < rbp -- load current cell's packed attr7 (fg[3]|bg[3]|mods[1], the 7 bytes at [r12+4..+10]) via `mov rax,[r12+4]; and rax,MASK56`; compare against _tui_last_attr's valid bit (bit63) and, if valid, its own masked attr7 -- both via load-then-cmp-reg-reg, never `cmp reg,[mem]`. Invalid or differing -> tui_emit_row_sgr: store new _tui_last_attr (valid bit set), emit 'ESC[0' + one ';<code>' per set mods bit (bit0..7 -> SGR 1/3/4/2/9/5/6/7, this landing's own new bit assignment -- see file header) + ';38;2;<fr>;<fg>;<fb>;48;2;<br>;<bg>;<bb>m' (mods/RGB bytes reloaded fresh via `xor reg,reg; mov_b reg,[r12+N]` each time -- r12 is stable across the whole cell, no need to cache them in a register that would only get clobbered by the next tui_emit_byte/tui_emit_dec call anyway). Same -> skip straight to tui_emit_row_glyph. Glyph: up to 4 symbol bytes at [r12+0..3], stopping at the first zero (design doc: padding is a contiguous zero suffix); an all-zero (never-written) cell emits a single space (0x20) instead of zero bytes, so the cursor still advances one column -- see file header 'empty-cell glyph convention'. Advance r12 by 16, loop. Post-loop: contiguous copy of [start_back(r14), end_back(rbp)) to start_back+diff(r13), two 8-byte word stores per 16-byte cell -- correct because tui_diff_row's own min/max already guarantee every cell OUTSIDE this range is already identical between back and front. Capability widened to {cap, paideia.port_io}: 'cap' because this function (transitively, via tui_emit_byte) is part of the KIND_TUI_CANVAS PRESENT op's capability-gated call chain per this tree's discipline of tagging any function reachable only through a capability-checked op with 'cap' (mirrors kind_tui_canvas.pdx's own tui_check_memory); 'paideia.port_io' is uart_putc's own requirement, propagated up. Labels prefixed tui_emit_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdx;                       // tty_slot

        mov r15, r8;                          // min_col + 1 (captured before any call clobbers r8)
        add r15, 1;

        mov r14, rcx;                          // row_idx + 1 (captured before any call clobbers rcx)
        add r14, 1;

        mov rax, r8;                            // min_col
        shl rax, 4;
        mov r12, rdi;
        add r12, rax;                             // cur_back = back_row_ptr + min_col*16

        mov r13, rsi;
        sub r13, rdi;                              // diff = front_row_ptr - back_row_ptr

        mov rax, r9;                                 // max_col
        add rax, 1;
        shl rax, 4;
        mov rbp, rdi;
        add rbp, rax;                                  // end_back (exclusive)

        mov rdi, rbx;
        mov rsi, 0x1B;
        call tui_emit_byte;                              // ESC
        mov rdi, rbx;
        mov rsi, 0x5B;
        call tui_emit_byte;                               // '['
        mov rdi, rbx;
        mov rsi, r14;
        call tui_emit_dec;                                  // row + 1
        mov rdi, rbx;
        mov rsi, 0x3B;
        call tui_emit_byte;                                  // ';'
        mov rdi, rbx;
        mov rsi, r15;
        call tui_emit_dec;                                    // col + 1
        mov rdi, rbx;
        mov rsi, 0x48;
        call tui_emit_byte;                                    // 'H'

        mov r14, r12;                                            // start_back (row_idx+1 now dead)

      tui_emit_row_loop:
        cmp r12, rbp;
        jae tui_emit_row_done;

        mov rax, [r12 + 4];
        mov r11, 0x00FFFFFFFFFFFFFF;
        and rax, r11;                                              // current attr7

        lea r10, [rip + _tui_last_attr];
        mov r9, [r10 + 0];
        mov rdx, r9;
        shr rdx, 63;
        cmp rdx, 0;
        je tui_emit_row_sgr;                                        // invalid -> always emit SGR

        mov rdx, r9;
        mov r11, 0x00FFFFFFFFFFFFFF;
        and rdx, r11;
        cmp rax, rdx;
        je tui_emit_row_glyph;                                       // unchanged -> skip SGR

      tui_emit_row_sgr:
        mov rdx, rax;
        mov r11, 0x8000000000000000;
        or rdx, r11;
        lea r10, [rip + _tui_last_attr];
        mov [r10 + 0], rdx;

        mov rdi, rbx;
        mov rsi, 0x1B;
        call tui_emit_byte;
        mov rdi, rbx;
        mov rsi, 0x5B;
        call tui_emit_byte;
        mov rdi, rbx;
        mov rsi, 0;
        call tui_emit_dec;                                            // reset

        // mods bit0 (BOLD) -> SGR 1
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod0_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 1; call tui_emit_dec;
      tui_emit_row_mod0_skip:

        // mods bit1 (ITALIC) -> SGR 3
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 1;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod1_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 3; call tui_emit_dec;
      tui_emit_row_mod1_skip:

        // mods bit2 (UNDERLINE) -> SGR 4
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 2;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod2_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 4; call tui_emit_dec;
      tui_emit_row_mod2_skip:

        // mods bit3 (DIM) -> SGR 2
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 3;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod3_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 2; call tui_emit_dec;
      tui_emit_row_mod3_skip:

        // mods bit4 (CROSSED_OUT) -> SGR 9
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 4;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod4_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 9; call tui_emit_dec;
      tui_emit_row_mod4_skip:

        // mods bit5 (SLOW_BLINK) -> SGR 5
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 5;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod5_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 5; call tui_emit_dec;
      tui_emit_row_mod5_skip:

        // mods bit6 (RAPID_BLINK) -> SGR 6
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 6;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod6_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 6; call tui_emit_dec;
      tui_emit_row_mod6_skip:

        // mods bit7 (REVERSED) -> SGR 7
        xor rax, rax;
        mov_b rax, [r12 + 10];
        mov r10, rax;
        shr r10, 7;
        and r10, 1;
        cmp r10, 0;
        je tui_emit_row_mod7_skip;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 7; call tui_emit_dec;
      tui_emit_row_mod7_skip:

        // foreground: ';38;2;fr;fg;fb'
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 38; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 2; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 4]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 5]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 6]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;

        // background: ';48;2;br;bg;bb'
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 48; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        mov rdi, rbx; mov rsi, 2; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 7]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 8]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;
        mov rdi, rbx; mov rsi, 0x3B; call tui_emit_byte;
        xor rax, rax; mov_b rax, [r12 + 9]; mov rdi, rbx; mov rsi, rax; call tui_emit_dec;

        mov rdi, rbx;
        mov rsi, 0x6D;
        call tui_emit_byte;                                            // 'm'

      tui_emit_row_glyph:
        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 0;
        jne tui_emit_row_glyph_b0;
        mov rdi, rbx;
        mov rsi, 0x20;
        call tui_emit_byte;                                             // blank cell -> space
        jmp tui_emit_row_glyph_done;

      tui_emit_row_glyph_b0:
        mov rdi, rbx;
        mov rsi, rax;
        call tui_emit_byte;
        xor rax, rax;
        mov_b rax, [r12 + 1];
        cmp rax, 0;
        je tui_emit_row_glyph_done;
        mov rdi, rbx;
        mov rsi, rax;
        call tui_emit_byte;
        xor rax, rax;
        mov_b rax, [r12 + 2];
        cmp rax, 0;
        je tui_emit_row_glyph_done;
        mov rdi, rbx;
        mov rsi, rax;
        call tui_emit_byte;
        xor rax, rax;
        mov_b rax, [r12 + 3];
        cmp rax, 0;
        je tui_emit_row_glyph_done;
        mov rdi, rbx;
        mov rsi, rax;
        call tui_emit_byte;

      tui_emit_row_glyph_done:
        add r12, 16;
        jmp tui_emit_row_loop;

      tui_emit_row_done:
        mov rax, r14;                                                    // copy cursor = start_back
      tui_emit_row_copy_loop:
        cmp rax, rbp;
        jae tui_emit_row_copy_done;
        mov r10, rax;
        add r10, r13;                                                      // dst = src + diff
        mov r9, [rax + 0];
        mov [r10 + 0], r9;
        mov r9, [rax + 8];
        mov [r10 + 8], r9;
        add rax, 16;
        jmp tui_emit_row_copy_loop;
      tui_emit_row_copy_done:

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tui_present_body(row_id) -> bytes_total
  // ==========================================================================
  // Orchestrator called from cap_handler_tui_canvas's PRESENT arm
  // (row_id is already rights- and validity-checked by that caller —
  // see this file's header). Resolves the canvas row's metadata,
  // resolves memory_slot into a real buffer pointer via cap_table,
  // walks every row calling tui_diff_row + (when dirty) tui_emit_row,
  // bumps the row's `presents` counter, and emits the fingerprint.
  pub let tui_present_body : (u64) -> u64 !{mem, sysreg, PortIo} @{cap, paideia.port_io} =
    fn (row_id: u64) -> unsafe {
      effects: { mem, sysreg, PortIo },
      capabilities: { cap, paideia.port_io },
      justification: "R89.M1-003 (#1990) + R89.M1-004 (#1991): PRESENT orchestrator. 3 pushes (r12=cur_back cell ptr, r13=row cursor r, r14=rows_dirty accumulator) + sub rsp,64 (8 local qwords: [+0]cols [+8]N [+16]rows [+24]tty_slot [+32]canvas_id [+40]buf_base [+48]row_id [+56]pad) land every nested call at rsp%16==0 (entry rsp%16==8, +24+64=88 -> 0); locals are spilled to this fixed-offset stack frame (not registers) because the loop body's own two calls (tui_diff_row, tui_emit_row) are caller-save-clobbering, and there are more live cross-call constants (cols, N, rows, tty_slot, canvas_id, buf_base, row_id) than callee-save registers remain after r12-r14 are spent on the three values that actually MUTATE per iteration. row_id is saved to the stack (not kept live in a register) purely so it can be handed BACK to tui_canvas_slot a second time after the loop, to re-derive row_ptr for the presents-bump -- cheaper than keeping row_ptr itself alive across the whole loop for one write at the very end. memory_slot resolution: cap_table[memory_slot].target_ptr, using the identical slot*24 addressing kind_tui_canvas.pdx's own tui_check_memory uses (shl 3 + shl 4 + add == *24) -- see file header for why this is the correct, kernel-dereferenceable pointer. N = rows*cols*16 (imul then shl 4). Both _tui_last_attr and _tui_present_bytes are reset to 0 before the loop (see file header 'SGR coalescing scope'). Loop: while r13 < rows -- front_row_ptr = cur_back+N; call tui_diff_row(cur_back, front_row_ptr, cols); ALL_ONES (0xFFFFFFFFFFFFFFFF) means clean, skip; otherwise rows_dirty++ (r14), unpack min_col/max_col from the result into r8/r9 and call tui_emit_row(cur_back, front_row_ptr [recomputed -- rax was clobbered unpacking min/max], tty_slot, r13, min_col, max_col); either way advance cur_back by cols*16 and r13 by 1. Post-loop: re-derive row_ptr via tui_canvas_slot(row_id) and bump [row_ptr+48] (presents) by 1, then call tui_stats_bump_presents (R89.M1-004, #1991) to bump the kernel-wide _tui_stats[TUI_ST_PRESENTS] counter (kind_tui_canvas.pdx) -- a cross-module call rather than a direct write, preserving that file's one-writer confinement over _tui_stats; safe at this point since rsp%16==0 per this function's own frame and nothing needed afterward is held in a caller-save register across the call. Fingerprint: klog_s1_d3(LEVEL_INFO=3, SUBSYS_CAP_, tui_present_tag_ok, k_canvas, canvas_id[captured into r8 BEFORE the stack shifts below -- r8 is untouched by push/sub/lea/mov-immediate, so it survives], k_rows_dirty, [stack]=rows_dirty(r14), k_bytes, [stack]=bytes_total) -- 3-stack-arg convention proven at sched/runqueue.pdx's sched_try_steal call site: `sub rsp,8` pad + push v3 + push k3 + push v2 (4 units, even, preserves the already-0-mod16 alignment), symmetric `add rsp,24; add rsp,8` unwind after the call. Returns bytes_total (re-read from _tui_present_bytes after the fingerprint call, since that call's own args clobbered rax). Labels prefixed tui_present_.",
      block: {
        push r12;
        push r13;
        push r14;
        sub rsp, 64;

        mov [rsp + 48], rdi;                  // row_id

        call tui_canvas_slot;                   // rax = row_ptr
        mov r10, rax;

        mov rax, [r10 + 8];
        mov [rsp + 32], rax;                      // canvas_id

        mov r11, [r10 + 16];                        // memory_slot (transient)

        mov rax, [r10 + 24];
        mov [rsp + 24], rax;                          // tty_slot

        mov rax, [r10 + 32];                            // rows|cols
        mov rcx, rax;
        shr rcx, 32;
        mov [rsp + 16], rcx;                              // rows
        mov rdx, rax;
        mov r9, 0xFFFFFFFF;
        and rdx, r9;
        mov [rsp + 0], rdx;                                 // cols

        lea rax, [rip + cap_table];
        mov r8, r11;
        shl r8, 3;
        mov r9, r11;
        shl r9, 4;
        add r8, r9;
        add rax, r8;                                          // &cap_table[memory_slot]
        mov rax, [rax + 16];                                    // target_ptr
        mov [rsp + 40], rax;                                      // buf_base

        mov rax, [rsp + 16];                                        // rows
        mov rcx, [rsp + 0];                                            // cols
        imul rax, rcx;
        shl rax, 4;
        mov [rsp + 8], rax;                                              // N

        xor rax, rax;
        lea r10, [rip + _tui_last_attr];
        mov [r10 + 0], rax;
        lea r10, [rip + _tui_present_bytes];
        mov [r10 + 0], rax;

        mov r12, [rsp + 40];                                               // cur_back = buf_base
        xor r13, r13;                                                        // r = 0
        xor r14, r14;                                                         // rows_dirty = 0

      tui_present_loop:
        mov rax, [rsp + 16];                                                    // rows
        cmp r13, rax;
        jae tui_present_loop_done;

        mov rax, r12;
        mov rcx, [rsp + 8];                                                        // N
        add rax, rcx;                                                               // front_row_ptr

        mov rdi, r12;
        mov rsi, rax;
        mov rdx, [rsp + 0];                                                            // cols
        call tui_diff_row;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je tui_present_row_clean;

        add r14, 1;                                                                        // rows_dirty++

        mov r8, rax;
        shr r8, 32;                                                                           // min_col
        mov r9, rax;
        mov r10, 0xFFFFFFFF;
        and r9, r10;                                                                            // max_col

        mov rdi, r12;
        mov rsi, r12;
        mov r10, [rsp + 8];                                                                       // N
        add rsi, r10;                                                                              // front_row_ptr (recomputed)
        mov rdx, [rsp + 24];                                                                         // tty_slot
        mov rcx, r13;                                                                                 // row_idx
        call tui_emit_row;

      tui_present_row_clean:
        mov rax, [rsp + 0];                                                                             // cols
        shl rax, 4;
        add r12, rax;
        add r13, 1;
        jmp tui_present_loop;

      tui_present_loop_done:
        mov rdi, [rsp + 48];                                                                               // row_id
        call tui_canvas_slot;
        mov r10, rax;
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;                                                                                  // presents++ (per-row, row+48)

        call tui_stats_bump_presents;                                                                            // R89.M1-004 (#1991): kernel-wide _tui_stats[TUI_ST_PRESENTS] (kind_tui_canvas.pdx). Cross-module call, not a direct write -- canvas_present.pdx never touches _tui_stats itself, preserving kind_tui_canvas.o's one-writer confinement. Safe here: rsp%16==0 per this function's own header (entry rsp%16==8, +24+64=88 -> 0), and every value still needed below (r14=rows_dirty, canvas_id/bytes read fresh from [rsp+32]/_tui_present_bytes after this call) is either callee-save or reloaded, not held in a caller-save register across this call.

        mov r8, [rsp + 32];                                                                                     // canvas_id (v1) -- captured before the stack shifts below

        sub rsp, 8;                                                                                              // pad
        lea r10, [rip + _tui_present_bytes];
        mov rax, [r10 + 0];
        push rax;                                                                                                 // v3 = bytes_total
        lea rax, [rip + tui_present_k_bytes];
        push rax;                                                                                                  // k3 = &k_bytes
        push r14;                                                                                                   // v2 = rows_dirty

        mov rdi, 3;                                                                                                   // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tui_present_tag_ok];
        lea rcx, [rip + tui_present_k_canvas];
        lea r9, [rip + tui_present_k_rows_dirty];
        call klog_s1_d3;

        add rsp, 24;
        add rsp, 8;

        lea r10, [rip + _tui_present_bytes];
        mov rax, [r10 + 0];

        add rsp, 64;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
