// src/kernel/core/ipi/vectors.pdx — IPI trampolines and handlers (R14b-m5-006 #511)
// IDT entry points for vectors 0xF0 (TLB shootdown) and 0xF1 (reschedule)
// Each trampoline: 15-push + vector push + apic_eoi + handler call + 15-pop + iretq
// Handlers: stubs that increment counters as smoke witness (Path A extends to mailbox drain)
//
// Issue: R14b-m5-006 (#511)
// Audit: design/audit/entries/ipi-trampolines-001.md (future)

module Vectors = structure {
  pub let IPI_VECTOR_F0 : u64 = 240
  pub let IPI_VECTOR_F1 : u64 = 241
  pub let IPI_VECTOR_F2 : u64 = 242    // #775 R18-M5-001: TLB shootdown

  pub let mut _ipi_f0_count : u64 = 0
  pub let mut _ipi_f1_count : u64 = 0
  pub let mut _ipi_f2_count : u64 = 0  // #775: TLB shootdown witness counter

  // Trampoline for vec 0xF0 (TLB shootdown). Same 15-GPR pattern as trampoline_vec32.
  pub let _ipi_trampoline_f0 : () -> () !{sysreg} @{} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "R14b-m5-006 (#511): IPI vec 0xF0 trampoline. Save 15 GPRs, apic_eoi (AC-a), call _ipi_handler_f0 with frame ptr in RDI (AC-b), restore, iretq. #661-followup rax-clobber audit (2026-08-06): `mov rax, 240; push rax` clobbered rax with the vector constant right before the GPR-save chain's first `push rax` — same defect class as the pre-fix trampoline_vec14 (paideia-os#661). Fix: reload rax from _isr_scratch_rax (populated by _isr_stub_240 pre-jmp) between the vector push and the GPR-save chain.",
      block: {
        // #657-SWAPGS-TODO: entry from CPL=3 needs swapgs; check [rsp+144] after pushes
        mov rax, 0;   push rax;             // errcode placeholder
        mov rax, 240; push rax;             // vector number
        mov rax, [rip + _isr_scratch_rax];  // #661-followup: reload caller's rax (clobbered above)
        push rax; push rcx; push rdx; push rbx; push rbp
        push rsi; push rdi; push r8;  push r9;  push r10
        push r11; push r12; push r13; push r14; push r15
        call apic_eoi
        mov rdi, rsp
        call _ipi_handler_f0
        pop r15; pop r14; pop r13; pop r12; pop r11
        pop r10; pop r9;  pop r8;  pop rdi; pop rsi
        pop rbp; pop rbx; pop rdx; pop rcx; pop rax
        add rsp, 16
        jmp _isr_return
      }
    }

  // Trampoline for vec 0xF1 (reschedule) — identical except push 241 and call _ipi_handler_f1
  pub let _ipi_trampoline_f1 : () -> () !{sysreg} @{} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "R14b-m5-006 (#511): IPI vec 0xF1 reschedule trampoline. Path A wires resched-needed flag. #661-followup rax-clobber audit (2026-08-06): `mov rax, 241; push rax` clobbered rax with the vector constant right before the GPR-save chain's first `push rax` — same defect class as the pre-fix trampoline_vec14 (paideia-os#661). Fix: reload rax from _isr_scratch_rax (populated by _isr_stub_241 pre-jmp) between the vector push and the GPR-save chain.",
      block: {
        // #657-SWAPGS-TODO: entry from CPL=3 needs swapgs; check [rsp+144] after pushes
        mov rax, 0;   push rax
        mov rax, 241; push rax
        mov rax, [rip + _isr_scratch_rax];  // #661-followup: reload caller's rax (clobbered above)
        push rax; push rcx; push rdx; push rbx; push rbp
        push rsi; push rdi; push r8;  push r9;  push r10
        push r11; push r12; push r13; push r14; push r15
        call apic_eoi
        mov rdi, rsp
        call _ipi_handler_f1
        pop r15; pop r14; pop r13; pop r12; pop r11
        pop r10; pop r9;  pop r8;  pop rdi; pop rsi
        pop rbp; pop rbx; pop rdx; pop rcx; pop rax
        add rsp, 16
        jmp _isr_return
      }
    }

  pub let _ipi_handler_f0 : (u64) -> () !{sysreg, mem} @{boot} =
    fn (frame: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R14b-m5-006 stub: TLB shootdown IPI handler on single CPU. Increments _ipi_f0_count as smoke witness. Path A extends this to drain the per-CPU tlb_mailbox_va[] ring.",
      block: {
        lea rax, [rip + _ipi_f0_count]
        mov rcx, [rax]
        add rcx, 1
        mov [rax], rcx
        ret
      }
    }

  pub let _ipi_handler_f1 : (u64) -> () !{sysreg, mem} @{boot} =
    fn (frame: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R18-M4-002 (#772) — upgraded from R14b-m5-006 (#511) counter stub to real cross-CPU reschedule handler. Trampoline (_ipi_trampoline_f1) already apic_eoi'd on the way in, so this body's job is only to record intent: set the receiving CPU's per-CPU preempt_needed flag so its next IRQ-tail preempt check (currently the trampoline_vec32 tail in int/idt.pdx; syscall-return and #PF-return tail checks land alongside R18.M4) evaluates the runqueue and reschedules. (a) Increment _ipi_f1_count as a boot-time witness — kernel_main.pdx L7799-L7807's IPI structural probe reads the counter to verify the trampoline is linked, and future runtime-delivery tests (R18.M4-006 fixture per issue #772) will read it to prove delivery. (b) Set [gs:PERCPU_OFF_PREEMPT_NEEDED] = 1 via the rdmsr IA32_GS_BASE + indirect-store idiom (paideia-as `[gs:disp32]` no-base encoding is not yet supported per gs_base.pdx L221-228 note; PA-R14-001 followup will collapse this to `mov qword [gs:48], 1`). rdmsr places bits [63:32] in EDX and [31:0] in EAX; shl rdx, 32; or rax, rdx reconstructs the full CB VA that percpu_init seeded via WRMSR IA32_GS_BASE (BSP: gs_base_init_bsp, AP: gs_base_init_ap per #766). Store is a full 64-bit `mov [rax+48], rcx` because PERCPU_OFF_PREEMPT_NEEDED is declared u64 in Percpu.pdx L82 — no mov_d hazard here since the field width matches the REX.W store width (contrast the cpu_idx/apic_id u32 fields where mov_d is mandatory). Idempotent: repeated sets before the receiving CPU consumes the flag collapse into one preempt; the trampoline_vec32 tail clears the flag BEFORE calling sched_pick_next_r15, so a fresh IPI arriving during the reschedule pipeline resets need_resched for the following tick — no lost-wakeup class here because the tick period bounds latency. RDI (frame ptr) is unused today but preserved in the signature so future preempt-tail extensions (e.g., stashing the IPI-source apic_id from a per-CPU IPI mailbox in the frame) can reach the interrupted-context state without another signature bump. Callee-save discipline: rax/rcx/rdx are all SysV caller-save, no push/pop needed. Testability: BSP-self reschedule IPI (via lapic_send_ipi_self from self_ipi.pdx or lapic_send_reschedule_ipi with BSP's own APIC ID) works today because BSP has IDT + GS_BASE + LAPIC SVR/TPR all programmed; AP-target reschedule IPIs are gated on AP-side IDT install (deferred by #762/#766 to R18.M3+) — until then, an inbound reschedule IPI on an AP would #GP (no IDT) before this handler is reached.",
      block: {
        // (a) Witness counter — kernel_main.pdx's IPI structural probe consumes it.
        lea rax, [rip + _ipi_f1_count]
        mov rcx, [rax]
        add rcx, 1
        mov [rax], rcx

        // (b) [gs:PERCPU_OFF_PREEMPT_NEEDED] = 1 via rdmsr IA32_GS_BASE + [rax+48].
        //     PA followup PA-R14-001 collapses this to `mov qword [gs:48], 1`.
        //     #776 R18-M5-002 — NO mfence: preempt_needed is written and read
        //     by this CPU only (IRQ-tail preempt check runs on the receiver
        //     side of the IPI on the same CPU). Same-CPU store → load pairs
        //     are TSO-ordered with store-buffer forwarding (SDM Vol 3A §8.2.2,
        //     §8.2.3.5). See design/multicore/mfence-audit.md §Site 4.
        mov rcx, 0xC0000101;             // IA32_GS_BASE MSR index
        rdmsr;                            // EDX:EAX = current per-CPU CB VA
        shl rdx, 32;
        or rax, rdx;                      // rax = gs_base = &Percpu CB[this_cpu]
        mov rcx, 1;
        mov [rax + 48], rcx;              // CB.preempt_needed (PERCPU_OFF_PREEMPT_NEEDED) = 1
        ret
      }
    }

  // Trampoline for vec 0xF2 (TLB shootdown). Same 15-GPR pattern as f0/f1.
  pub let _ipi_trampoline_f2 : () -> () !{sysreg} @{} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "R18-M5-001 (#775): IPI vec 0xF2 (TLB shootdown) trampoline. Save 15 GPRs, apic_eoi, call _ipi_handler_f2 with frame ptr in RDI, restore, iretq. Modelled on _ipi_trampoline_f1 (#772); vector byte is 242. #661-followup rax-clobber pattern: `mov rax, 242; push rax` clobbers rax right before the GPR-save chain's first `push rax` — reload rax from _isr_scratch_rax (populated by _isr_stub_242 pre-jmp) between the vector push and the GPR-save chain.",
      block: {
        // #657-SWAPGS-TODO: entry from CPL=3 needs swapgs; check [rsp+144] after pushes
        mov rax, 0;   push rax
        mov rax, 242; push rax
        mov rax, [rip + _isr_scratch_rax]
        push rax; push rcx; push rdx; push rbx; push rbp
        push rsi; push rdi; push r8;  push r9;  push r10
        push r11; push r12; push r13; push r14; push r15
        call apic_eoi
        mov rdi, rsp
        call _ipi_handler_f2
        pop r15; pop r14; pop r13; pop r12; pop r11
        pop r10; pop r9;  pop r8;  pop rdi; pop rsi
        pop rbp; pop rbx; pop rdx; pop rcx; pop rax
        add rsp, 16
        jmp _isr_return
      }
    }

  // TLB shootdown IPI handler (vec 0xF2).
  //
  // Per-CPU CB layout (populated by tlb_shootdown_range on the initiator):
  //   +88  shootdown_start  (u64) — VA range start, page-aligned
  //   +96  shootdown_end    (u64) — VA range end (exclusive), page-aligned
  //   +104 shootdown_epoch  (u64) — request sequence number
  //   +112 shootdown_ack    (u64) — receiver-published: last processed epoch
  //
  // Body:
  //   1. rdmsr IA32_GS_BASE → rax = &CB[this_cpu].
  //   2. rsi = CB[+88] (start); rdi = CB[+96] (end).
  //   3. Bounded INVLPG loop: while (rsi < rdi) { invlpg [rsi]; rsi += 4096; }
  //      Range-based; a full-flush caller sets start = 0, end = ~0 (bounded
  //      by a 65536-page ceiling here — MVP guard against runaway iteration
  //      when the encoder can't yet express `mov cr3, cr3` as an alternative
  //      full-flush primitive).
  //   4. Publish ack = epoch: CB[+112] = CB[+104].
  //   5. Witness counter _ipi_f2_count += 1.
  //   6. Return (trampoline already apic_eoi'd on entry).
  //
  // Not INVPCID: paideia-as encoder lacks `invpcid` today (verified via grep;
  // only `invlpg` and `wbinvd` are wired in tools/paideia-as/crates/paideia-
  // as-runtime/src/instruction.rs). MVP path is INVLPG-only; INVPCID upgrade
  // deferred to a follow-up paired with a paideia-as encoder issue.
  //
  // Testability: BSP-self dispatch works today (BSP has IDT + GS_BASE + LAPIC
  // programmed); AP-target dispatch is gated on AP-side IDT install (R18.M3+
  // peer work) — until then, an inbound IPI on an AP would #GP (no IDT).
  pub let _ipi_handler_f2 : (u64) -> () !{sysreg, mem} @{boot} =
    fn (frame: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "#775 R18-M5-001: TLB shootdown IPI handler. Reads this CPU's per-CPU CB shootdown request (start at +88, end at +96), invalidates each 4 KiB page in [start, end) via `invlpg [rsi]`, publishes ack (CB[+112]) equal to epoch (CB[+104]) so the initiator's poll loop can observe completion, and increments _ipi_f2_count as a boot / test witness. Trampoline (_ipi_trampoline_f2) already apic_eoi'd on entry so the body only does the flush + ack work. CB VA is derived via rdmsr IA32_GS_BASE (same idiom as _ipi_handler_f1 and sched_pick_next_r15) — collapses to a direct `mov rax, [gs:0]` once paideia-as PA-R14-001 lands the [gs:disp32] no-base encoding. INVLPG loop is bounded by a 65536-iteration ceiling as an MVP defence against a runaway full-flush request (start=0, end=~0); a caller that wants a true full-flush should reload CR3 instead (encoder gap for cr3 read/write in this exact loop shape is a follow-up). No INVPCID: paideia-as encoder support verified missing via grep of tools/paideia-as/crates/paideia-as-runtime/src/instruction.rs (only invlpg + wbinvd wired). Register discipline: rax (CB VA / epoch scratch), rcx (MSR index / budget), rdx (rdmsr high half), rsi (walking VA), rdi (end VA) — all SysV caller-save, no push/pop needed. RDI on entry is the frame pointer supplied by the trampoline (unused here — preserved in the signature for future frame-inspection extensions). Effects: {sysreg} for rdmsr + invlpg, {mem} for the CB read/writes and witness counter. Capability {boot} restricts to boot / IPI paths. Not a leaf (calls nothing) — no callee-save touch needed beyond SysV.",
      block: {
        // (a) Derive this CPU's CB VA from IA32_GS_BASE.
        mov rcx, 0xC0000101;                    // IA32_GS_BASE MSR index
        rdmsr;                                   // EDX:EAX = CB VA
        shl rdx, 32;
        or rax, rdx;                             // rax = &CB[this_cpu]

        // (b) Load range: rsi = start, rdi = end (exclusive).
        mov rsi, [rax + 88];                     // CB.shootdown_start
        mov rdi, [rax + 96];                     // CB.shootdown_end

        // (c) INVLPG loop, bounded by 65536 iterations (MVP full-flush guard).
        mov rcx, 65536;
        f2_invlpg_loop:
          cmp rsi, rdi;
          jae f2_invlpg_done;
          invlpg [rsi];
          add rsi, 4096;
          sub rcx, 1;
          jnz f2_invlpg_loop;
        f2_invlpg_done:

        // (c') #776 R18-M5-002 — INVLPG/ACK ordering rationale (NO mfence needed):
        // INVLPG is NOT listed among x86 serializing instructions (SDM Vol 3A
        // §8.3), but SDM Vol 3A §4.10.4.1 guarantees INVLPG's local TLB effect
        // is complete before the next instruction executes on THIS CPU. The
        // ack store below is program-order after the INVLPG loop; under x86
        // TSO (SDM Vol 3A §8.2.2) stores from this CPU become globally
        // visible in program order, so no other CPU can observe the ack
        // BEFORE the TLB entries are gone on this CPU. The initiator's
        // subsequent frame-free is therefore safe: this CPU cannot access
        // the freed range without a page-walk that sees the caller's PTE
        // teardown (also fenced by the initiator-side mfence in
        // tlb_shootdown_range step (b')). Full audit: design/multicore/
        // mfence-audit.md §Site 3.

        // (d) Publish ack = epoch so the initiator's poll can observe done.
        mov rcx, [rax + 104];                    // CB.shootdown_epoch
        mov [rax + 112], rcx;                    // CB.shootdown_ack = epoch

        // (e) Witness counter — for boot-time structural + runtime probes.
        lea rax, [rip + _ipi_f2_count];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;

        ret
      }
    }
}
