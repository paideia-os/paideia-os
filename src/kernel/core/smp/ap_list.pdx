// src/kernel/core/smp/ap_list.pdx — R18-M1-004 / #763
// Hard-coded AP APIC-ID list for R18 bring-up.
//
// Issue: paideia-os/paideia-os#763
//
// Exports:
//   _ap_apic_ids : [u32; 3] @align(4)
//     Statically-initialised list of AP APIC IDs, one u32 per AP,
//     stored in kernel .rodata under the kernel higher-half VMA
//     (0xFFFF8000_00000000 per src/kernel/link.ld). The list contains
//     the three APIC IDs a standard QEMU `-smp 4` topology exposes to
//     APs (BSP is 0; APs are 1, 2, 3). The consumer (ap_bring_up_all
//     in ap_launch.pdx, #762) reads entries u32-stride via
//     `mov ecx, [r12]` + `add r12, 4`, so the array element type
//     must be u32 and the storage 4-byte aligned. u32 arrays are
//     laid out flat in kernel .rodata; a `lea rdi, [rip + _ap_apic_ids]`
//     in the eventual #764 wiring in kernel_main.pdx yields a
//     canonical VA that satisfies the id_list_ptr contract.
//
//   _ap_count : u64 = 3
//     Number of APs to bring up — the `count` argument to
//     ap_bring_up_all. Kept as u64 to match ap_bring_up_all's second
//     parameter (loaded into RSI as a u64 remaining-count register
//     R13 in the loop). Value 3 == N_APS - 1 (ApStacks.N_APS = 4 is
//     the *total* CPU ceiling including BSP; APs occupy dense
//     cpu_idx slots [0, 3), so per-AP stack slots
//     _ap_kernel_stacks[cpu_idx=0..2] cover the three APs).
//
// R20 succession (MADT-driven enumeration):
//   #813 (r20-m2-005: MADT-driven AP init — retire hard-coded N from
//   R18) replaces this static list with a dynamic count + array
//   derived from ACPI MADT LAPIC entries (Type 0, parsed in #809; +
//   x2APIC Type 9 entries parsed in #812). At that point this module
//   collapses to a compat shim or is deleted outright and the
//   kernel_main.pdx bring-up wiring reads the runtime-populated
//   MADT-derived arrays instead of these constants.
//
// Not-a-witness note: like the rest of R18.M1, this module lands
// storage only. No runtime call reads _ap_apic_ids or _ap_count
// yet — the wiring lives in #764 (boot_smp smoke), which will
// pass (&_ap_apic_ids, _ap_count) to ap_bring_up_all from
// kernel_main and observe the per-AP CPU_ID_XX_HELLO fingerprint
// emitted by _ap_entry.
//
// Encoder: paideia-as v0.20.1+. No opcode work — this module is
// data only, no function bodies.

module ApList = structure {
  // Hard-coded AP APIC-ID list. QEMU `-smp 4` default topology assigns
  // BSP = APIC 0 and APs = APIC 1..3. Sparse-ID topologies (e.g.
  // 4-socket 0/4/8/12) are out of R18 scope; ap_bring_up_all already
  // handles sparse IDs (dense cpu_idx decoupled from apic_id), so
  // adding sparse hard-coded lists is a config change here — no
  // orchestrator work.
  pub let _ap_apic_ids : [u32; 3] = [1, 2, 3] @align(4)

  // Number of entries in _ap_apic_ids. Passed as `count` to
  // ap_bring_up_all (RSI, u64). Sized as u64 to match the ABI slot
  // without an implicit widening at the call site.
  pub let _ap_count : u64 = 3
}
