// src/kernel/core/smp/percpu.pdx — R18-M2-001 / #765
// Per-CPU control block (PerCpu) — layout + storage + init helper.
//
// Issue: paideia-os/paideia-os#765
//
// Purpose:
//   Declare the per-CPU control block that every CPU (BSP + APs) will reach
//   via the GS segment base once #766 (R18-M2-002) WRMSRs IA32_GS_BASE per
//   core. This module lands the storage + layout offsets + a bare-metal
//   `percpu_init(cpu_idx, apic_id)` seed; no call site is wired here.
//
// Design reference:
//   design/multicore/per-cpu-layout.md (R14b-era `cpu_local_t` layout —
//   superseded by this R18 revision, which widens the CB to 2 cache lines
//   and adds the hot-path fields the scheduler / preemption / TSC-deadline
//   arming will consume in M2–M5).
//
// Layout (128 B = 2 x 64 B cache lines, @align(64)):
//
//   Line 0 — hot (touched on every task switch, IRQ, and syscall):
//     +0   u32  cpu_idx              // dense logical CPU index [0, MAX_CPUS)
//     +4   u32  apic_id              // hardware xAPIC/x2APIC ID
//     +8   u64  self_ptr             // VA of this CB — enables `mov rax,[gs:0x08]`
//     +16  u64  current_tcb          // per-CPU currently-scheduled TCB (M4)
//     +24  u64  kernel_stack_top     // per-CPU TSS.RSP0 backing (M2-004)
//     +32  u64  runqueue_head        // per-CPU runqueue head (M4)
//     +40  u64  runqueue_tail        // per-CPU runqueue tail (M4)
//     +48  u64  preempt_needed       // per-CPU preempt flag (M4/M5)
//     +56  u64  lapic_timer_deadline // per-CPU TSC-deadline arming (#777, M5)
//
//   Line 1 — cold (populated once at bring-up):
//     +64  u64  tss_ptr              // per-CPU TSS VA (M2-004)
//     +72  u64  xsave_area_ptr       // per-CPU XSAVE region VA (R21)
//     +80  ...  reserved (48 B, zero-init via .bss)
//
// Offset stability discipline:
//   The PERCPU_OFF_* constants below are load-bearing — future GS-relative
//   accessors (`mov rax, [gs:PERCPU_OFF_CURRENT_TCB]`) hard-code them. Any
//   change to the layout must be paired with an audit sweep of every
//   `[gs:N]` immediate in the tree. The 2-cache-line ceiling (PERCPU_SIZE
//   = 128) is a design invariant, not merely a current size — the M4/M5
//   hot-path expects at most two L1D lines per CPU.
//
// Storage (`_percpu_cbs`):
//   [u64; MAX_CPUS * (PERCPU_SIZE / 8)] = [u64; 4 * 16] = [u64; 64] = 512 B
//   in .bss @align(64). Zero-init by .bss placement satisfies the
//   "cleared runqueue / null current_tcb / zero preempt-needed" invariant
//   at BSP boot before any percpu_init call.
//
// MAX_CPUS:
//   Set to 4 to match ApStacks.N_APS (the R18.M1 static AP-count ceiling in
//   src/kernel/core/smp/ap_stacks.pdx). R20's MADT-driven enumeration
//   (#813) will replace both constants with a dynamic value; both this
//   module and ApStacks migrate together. Callers must pass cpu_idx in
//   [0, MAX_CPUS) — no runtime bound check (see percpu_cb_for).
//
// Not-a-witness note:
//   Like the rest of R18.M1/M2, this module lands the mechanism only. No
//   call to percpu_init or percpu_cb_for exists yet; #766 (M2-002) wires
//   the BSP-side call and WRMSR IA32_GS_BASE, and updates the AP entry
//   in src/kernel/core/smp/ap_entry.pdx to call percpu_init before the
//   halt loop. Boot smoke witness (`PERCPU OK N=4`) lands with #767
//   (M2-003 gs-relative accessors) which is the first observable path.
//
// Encoder: paideia-as v0.20.1+ (mov / mov_d / lea / shl / add / ret + `uninit
// @align(64)`). No new encoder gaps expected.

module Percpu = structure {
  // === Layout constants (load-bearing — see header block) ===
  pub let PERCPU_SIZE  : u64 = 128       // sizeof(PerCpu) — 2 cache lines
  pub let PERCPU_ALIGN : u64 = 64        // L1D cache line
  pub let MAX_CPUS     : u64 = 4         // matches ApStacks.N_APS (R18.M1 ceiling)

  // === Field offsets (hot line — line 0) ===
  pub let PERCPU_OFF_CPU_IDX              : u64 = 0    // u32
  pub let PERCPU_OFF_APIC_ID              : u64 = 4    // u32
  pub let PERCPU_OFF_SELF_PTR             : u64 = 8    // u64 — GS-self-reference
  pub let PERCPU_OFF_CURRENT_TCB          : u64 = 16   // u64
  pub let PERCPU_OFF_KERNEL_STACK_TOP     : u64 = 24   // u64
  pub let PERCPU_OFF_RUNQUEUE_HEAD        : u64 = 32   // u64
  pub let PERCPU_OFF_RUNQUEUE_TAIL        : u64 = 40   // u64
  pub let PERCPU_OFF_PREEMPT_NEEDED       : u64 = 48   // u64
  pub let PERCPU_OFF_LAPIC_TIMER_DEADLINE : u64 = 56   // u64

  // === Field offsets (cold line — line 1) ===
  pub let PERCPU_OFF_TSS_PTR              : u64 = 64   // u64
  pub let PERCPU_OFF_XSAVE_AREA_PTR       : u64 = 72   // u64
  // [80..128) = reserved padding; zero via .bss.

  // === Storage ===
  // MAX_CPUS (4) * PERCPU_SIZE (128) / 8 = 64 u64 slots = 512 B.
  // @align(64) puts every CB on its own cache-line boundary, matching the
  // hot-half discipline in tmpfs inode.pdx (@align(64), R16-M2-001).
  pub let mut _percpu_cbs : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // percpu_cb_for(cpu_idx: u64) -> u64
  //   Returns &_percpu_cbs + cpu_idx * PERCPU_SIZE.
  //   Leaf function, no frame. No range check on cpu_idx: caller enumerates
  //   0..MAX_CPUS-1 by construction (mirrors ap_stack_top's contract in
  //   ap_stacks.pdx). Passing cpu_idx >= MAX_CPUS computes an out-of-pool
  //   VA and any subsequent write corrupts the next .bss neighbour — a
  //   caller bug this early in boot triple-faults before any diagnostic
  //   can print, matching the discipline in ap_trampoline_relocate.pdx.
  // ==========================================================================
  pub let percpu_cb_for : (u64) -> u64 !{} @{} =
    fn (cpu_idx: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "#765 R18-M2-001: compute the VA of per-CPU control block for cpu_idx (RDI). Body: rax = cpu_idx << 7 (multiply by PERCPU_SIZE=128 via shift-by-7; shl chosen over imul because the multiplier is a power of two and paideia-as encodes shl-imm compactly, matching ap_stack_top's shl 14 pattern in ap_stacks.pdx). rax += &_percpu_cbs via rip-relative lea into rcx (higher-half kernel VA under kernel VMA base 0xFFFF8000_00000000 per src/kernel/link.ld). Result in rax per SysV. Leaf function, no callee-save clobber, no frame. No range check on cpu_idx — caller enumerates 0..MAX_CPUS-1 by construction (contract mirrors ap_stack_top in ap_stacks.pdx).",
      block: {
        // rax = cpu_idx * PERCPU_SIZE = cpu_idx << 7
        mov rax, rdi;
        shl rax, 7;

        // rax += &_percpu_cbs
        lea rcx, [rip + _percpu_cbs];
        add rax, rcx;
        ret
      }
    } @no_frame

  // ==========================================================================
  // percpu_init(cpu_idx: u64, apic_id: u64) -> ()
  //   Seed CB[cpu_idx] with:
  //     +0  (u32) cpu_idx     — low 32 bits of RDI
  //     +4  (u32) apic_id     — low 32 bits of RSI (xAPIC 8-bit ID fits;
  //                             x2APIC 32-bit ID also fits)
  //     +8  (u64) self_ptr    — VA of this CB (enables `mov rax, [gs:0x08]`
  //                             self-lookup once #766 WRMSRs IA32_GS_BASE)
  //   All other fields (current_tcb, runqueue_*, preempt_needed,
  //   lapic_timer_deadline, tss_ptr, xsave_area_ptr, reserved) are left at
  //   their .bss zero-init values — subsequent M2/M4 wiring stamps them
  //   as it lands each subsystem.
  //
  //   Leaf function, no callee-save clobber. Inlines the CB address
  //   computation (does not `call percpu_cb_for`) to avoid a 3-push
  //   alignment prologue for a two-instruction helper.
  // ==========================================================================
  pub let percpu_init : (u64, u64) -> () !{mem} @{boot} =
    fn (cpu_idx: u64, apic_id: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "#765 R18-M2-001: seed CB[cpu_idx] with the three identity fields that make the GS-based self-lookup work: (a) cpu_idx (u32) at +0, (b) apic_id (u32) at +4, (c) self_ptr (u64) at +8. RDI = cpu_idx (u64), RSI = apic_id (u64 with the LAPIC ID in the low 32 bits — xAPIC's 8-bit ID and x2APIC's 32-bit ID both fit; caller passes zero-extended). Inlines the CB address computation instead of `call percpu_cb_for` so the leaf discipline (no prologue, no rsp adjust) matches ap_stack_top / kernel_stack_top / tmpfs_inode_slot. Storage discipline: mov_d (32-bit sized) for the two u32 stores follows the established idiom (ap_launch.pdx patch slots, lapic_timer.pdx MMIO writes) — bare `mov [r10 + N], rdi` would emit REX.W and store 8 bytes, silently corrupting the u64 field at +8 for the cpu_idx write. mov [r10 + 8], r10 stores the CB's own VA for self-ptr; the value in r10 is the freshly-computed &_percpu_cbs + cpu_idx*128, which is exactly what a GS-relative `mov rax, [gs:0x08]` will return once IA32_GS_BASE is programmed to r10 per-CPU (#766). Effects declare {mem} because we write to shared .bss storage; {boot} capability restricts this to the boot / AP-bring-up path — the CB layout is architectural, not runtime-mutable. Leaf, no frame, no callee-save touch — r10/rax/rcx are all caller-saved per SysV.",
      block: {
        // r10 = &CB[cpu_idx] = &_percpu_cbs + cpu_idx * 128
        lea r10, [rip + _percpu_cbs];
        mov rax, rdi;
        shl rax, 7;                              // cpu_idx * PERCPU_SIZE
        add r10, rax;

        // +0  (u32) cpu_idx  — low 32 bits of rdi via mov_d
        mov_d [r10 + 0], rdi;

        // +4  (u32) apic_id  — low 32 bits of rsi via mov_d
        mov_d [r10 + 4], rsi;

        // +8  (u64) self_ptr = r10 (CB base VA)
        mov [r10 + 8], r10;

        ret
      }
    } @no_frame
}
