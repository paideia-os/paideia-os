// src/kernel/core/smp/ap_entry.pdx — R18-M1-003 / #762 (rewired by #766)
//
// Real AP long-mode entry point. Called via the trampoline blob's
// `mov ap_entry_slot(%rip), %rax; jmp *%rax` after transitioning
// real -> protected -> long mode and loading:
//   * CR3 = kernel PML4 (from trampoline pml4 slot)
//   * RSP = per-AP kernel stack top (from trampoline stack slot,
//           populated by ap_launch.pdx / ap_stack_top from
//           core/smp/ap_stacks.pdx)
//   * CS  = trampoline's own code64 selector (0x18 in trampoline GDT)
//   * IF  = 0 (real-mode `cli` still in effect)
//
// R18-M1-003 responsibility (#762): emit `CPU_ID_XX_HELLO\n` per-AP
// fingerprint on COM1 to feed the boot_smp smoke witness (#764), then
// park in a cli/hlt loop.
//
// R18-M2-002 addition (#766): before the hello emit, call
// GsBase.gs_base_init_ap(apic_id) which (a) linear-searches
// _ap_apic_ids to derive the dense cpu_idx (BSP=0 reserved, APs occupy
// slots 1..N), (b) percpu_init(cpu_idx, apic_id) seeds this AP's CB,
// and (c) WRMSRs IA32_GS_BASE + IA32_KERNEL_GS_BASE to the CB VA. After
// the hello emit we then emit a second `GS_OK_XX\n` fingerprint whose
// XX is the cpu_idx byte read back from `[gs:0]` (via
// gs_base_read_cpu_idx's rdmsr indirection) — this line is the
// end-to-end witness that (i) the MSR was set correctly, (ii)
// percpu_init wrote cpu_idx to CB+0, and (iii) the GS-relative read
// path resolves to the right storage.
//
// R18-M4-004 addition (#774): after the GS_OK emit, call
// ApBringup.ap_sched_init which populates this AP's per-AP idle TCB
// slab (Idle body reused — sti/hlt/jmp is position-independent),
// publishes its VA into CB[PERCPU_OFF_IDLE_TCB=80] so
// sched_pick_next_r15's empty-runq fallback returns THIS AP's idle,
// and runq_init's the per-CPU runqueue head/tail to empty (defensive
// re-zero on top of .bss zero-init). The AP then retains its cli/hlt
// loop as an idle stand-in because idle_code itself uses sti+hlt and
// this AP has no IDT (per §"IDT install" above), so a genuine
// sched_switch(idle) is blocked pending AP-side IDT install. The
// structural artifact ap_sched_init leaves behind is what M4-005+
// (task migration + AP preempt tail) will consume.
//
// Explicitly OUT of scope for R18-M1-003 (still true at R18-M2-002):
//   * Kernel GDT reload (`lgdt _gdt_ptr`) — the AP continues to run
//     under the trampoline's own low-memory GDT, which is a valid
//     code64/data64 descriptor set for as long as the AP does not
//     reload segment registers on its own. The trampoline GDT lives
//     at physical 0x8000+ (identity-mapped in the kernel PML4), so
//     GDTR still resolves cleanly.
//   * IDT install (`lidt _idt_ptr`) — no per-CPU or shared IDT is
//     loaded on the AP; any exception would triple-fault. We accept
//     that risk by keeping interrupts masked (cli in the halt loop):
//     the AP's LAPIC is unconfigured (no SVR, no TPR, no vectors),
//     so no maskable IRQ can arrive, and no code below fires an
//     exception. NMI/SMI can still bypass CLI and would triple-fault
//     — accepted risk for M1; M3-M5 land the real GDT/IDT reload.
//   * TSS load (`ltr`) — the BSP TSS is a single-CPU singleton
//     (core/int/tss.pdx `_tss`), unsafe to share as RSP0 source
//     across CPUs. Per-CPU TSS is M2-004 (#768). With IF=0 throughout
//     the halt loop, no ring transition (and thus no RSP0 read) can
//     occur, so skipping ltr is safe here.
//   * LAPIC config on the AP — deferred to M3+. Since the AP
//     never signals ready and never accepts interrupts here, the
//     omission is inert.
//
// Fingerprint format:
//   `CPU_ID_XX_HELLO\n`      (existing #762)
//   `GS_OK_XX\n`             (added by #766; XX == cpu_idx byte from gs:[0])
//   XX = 2 lowercase hex nibbles.
//   For QEMU's default `-smp N` topology (BSP=0, APs=1..N-1) the two XX
//   values match — the hello XX is the raw xAPIC ID, the GS_OK XX is
//   the cpu_idx derived from _ap_apic_ids search which yields
//   apic_id-position + 1 = apic_id for that topology.
//
// Concurrency note on COM1:
//   uart_puts / uart_putc write COM1 THR polled — no locking. Multiple
//   APs writing concurrently could interleave characters mid-line. For
//   M1/M2 this is accepted: the smoke witness (#764) grep-scans for the
//   whole `CPU_ID_XX_HELLO\n` substring, so a torn line simply fails
//   to match and the smoke retries. Real per-line serialization arrives
//   with the klog substrate's AP-side wire-in (post-M2).
//
// Encoder: paideia-as v0.20.1+. Uses lea (rip-relative), 32-bit MMIO
// load (mov ecx, [rax]), shr/and/cmp/jb, add-imm8, call/ret, cli/hlt/jmp,
// wrmsr, rdmsr. All primitives in-tree; no encoder work.

module ApEntry = structure {
  // Fingerprint prefix ("CPU_ID_") and suffix ("_HELLO\n"), both NUL-
  // terminated for uart_puts (which walks bytes until zero).
  pub let msg_ap_cpu_prefix : [u8; 8] = "CPU_ID_\0"
  pub let msg_ap_hello_suffix : [u8; 8] = "_HELLO\n\0"
  // #766: GS-witness prefix ("GS_OK_") and suffix ("\n"), same NUL
  // discipline. Two separate strings so the hex-nibble emit sequence
  // that composes the two fingerprints can be reused verbatim.
  pub let msg_ap_gs_prefix : [u8; 7] = "GS_OK_\0"
  pub let msg_ap_nl_suffix : [u8; 2] = "\n\0"

  pub let _ap_entry : () -> () !{sysreg, mem} @{boot, sched} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot, sched },
      justification: "#762 R18-M1-003 (rewired by #766 R18-M2-002 and extended by #774 R18-M4-004; boot-mmio-mapping step 7): real AP long-mode entry. Called from trampoline blob (tools/ap_trampoline.S) via `mov ap_entry_slot(%rip), %rax; jmp *%rax` after CR3 = kernel PML4, RSP = per-AP stack top, CS = trampoline code64 selector 0x18, IF = 0. Body: (1) Read xAPIC LAPIC_ID register at MMIO base+0x20 via the platform-mapped xAPIC window (boot-mmio-mapping step 7, design/kernel/boot-mmio-mapping.md): load _xapic_mmio_va into rax, add 0x20 (LAPIC_ID offset), 32-bit load into ECX; shift right 24, and 0xff to isolate the 8-bit APIC ID. Ordering: _xapic_mmio_va is populated by platform_map_early_mmio on the BSP during pat_init_this_cpu ordering slot in kernel_main.pdx, and ap_bring_up_all does not launch APs until every BSP-side substrate (including the MMIO map) has completed — so the AP sees a valid VA on every path (identity fallback on PVH -kernel where the low-4GiB huge pages already cover 0xFEE00000; higher-half PML4[321] on UEFI/T14). No CR3 flip needed: kernel PML4 is loaded from the trampoline before this code executes. (2) Save APIC ID in R12 (SysV callee-save) across the gs_base_init_ap + three uart calls that follow. (3) [#766] call gs_base_init_ap(apic_id in rdi) — derives cpu_idx via linear search of _ap_apic_ids, seeds this AP's Percpu CB, WRMSRs IA32_GS_BASE + IA32_KERNEL_GS_BASE. Must run BEFORE any [gs:off] access on this AP; the hello emit uses only rip-relative loads (uart_puts walks a byte buffer at rdi) so it is GS-agnostic, but placing the wire-in here means M3+ handlers added below will find GS_BASE already programmed. (4) uart_puts(msg_ap_cpu_prefix) — writes 'CPU_ID_'. (5) Emit the high nibble of APIC ID: shr 4, and 0x0f, cmp 10, add 0x30 (digit) or 0x57 (letter), uart_putc. (6) Same for the low nibble. (7) uart_puts(msg_ap_hello_suffix) — writes '_HELLO\\n'. (8) [#766] uart_puts(msg_ap_gs_prefix) then read cpu_idx back from [gs:0] via gs_base_read_cpu_idx (rdmsr + u32 load) and emit both nibbles as hex; uart_puts(msg_ap_nl_suffix) closes the line. This is the end-to-end witness: the observed cpu_idx byte proves the WRMSR + percpu_init landed. R13 holds the u32 across nibble-emit uart_putc calls (r12 is still the APIC ID). (9.5) [#774] call ap_sched_init — populate this AP's per-AP idle TCB slab (ApBringup._ap_idle_tcbs[cpu_idx]), publish its VA into CB[PERCPU_OFF_IDLE_TCB=80] so sched_pick_next_r15's empty-runq fallback returns THIS AP's idle rather than BSP's _idle_tcb, and call runq_init to zero the per-CPU runqueue head/tail. Precondition: gs_base_init_ap already programmed IA32_GS_BASE. AP retains cli/hlt loop below as idle stand-in because idle_code uses sti+hlt and this AP has no IDT — genuine sched_switch(idle) is blocked pending AP-side IDT install (#762 header §'IDT install'). (10) Halt loop: cli; hlt; jmp back. Rationale for cli vs sti: no IDT is loaded on the AP (per-CPU IDT install is M3+). LAPIC on this AP is unconfigured (no SVR / TPR / vectors), so no maskable IRQ can fire; keeping IF=0 also masks any inbound IPI. NMI/SMI still bypass CLI and would triple-fault (no IDT) — accepted risk for M1/M2. Stack discipline: 2 callee-save pushes (r12, r13 — r13 now used for the #766 witness cpu_idx spill) land rsp % 16 == 0 for the uart/gs_base calls' internal call chain. Not restored at halt-loop entry: the loop never returns, so leaving r12/r13 saved on the stack is inert (kernel stack is per-AP, permanent for the AP's lifetime). Fingerprint format 'CPU_ID_XX_HELLO\\n' + 'GS_OK_XX\\n' matches issue #762 AC + #766 witness. COM1 access is unlocked; concurrent AP writes can interleave chars — accepted for M1/M2 (witness grep tolerates torn lines by retry).",
      block: {
        // ---- Read xAPIC ID via LAPIC MMIO base+0x20 ----
        // boot-mmio-mapping step 7 (design/kernel/boot-mmio-mapping.md):
        // load _xapic_mmio_va (populated by platform_map_early_mmio on the
        // BSP before ap_bring_up_all fires) rather than the hard-coded PA
        // 0xFEE00020. On PVH -kernel boots the VA equals the identity VA;
        // on UEFI/T14 it lives in PML4[321]. Either way this AP reaches
        // valid mapped memory without the boot-huge-page coincidence.
        mov rax, [rip + _xapic_mmio_va];
        add rax, 0x20;                       // LAPIC_ID register offset
        mov ecx, [rax];                      // 32-bit MMIO load
        shr rcx, 24;                         // ID in bits [31:24]
        and rcx, 0xff;                       // mask to 8 bits

        // ---- Save APIC ID across the following calls ----
        push r12;
        push r13;
        mov r12, rcx;                        // r12 = APIC ID (0..255)

        // ---- #766: seed per-CPU CB + program GS_BASE / KERNEL_GS_BASE ----
        // MUST precede any [gs:off] access on this AP. The two uart_puts
        // below are rip-relative (GS-agnostic) so ordering is defensive
        // rather than load-bearing, but the M3+ additions to _ap_entry
        // (real IDT install, LAPIC config, per-CPU TSS load) will start
        // relying on [gs:off] and expect GS_BASE already programmed.
        mov rdi, r12;                        // apic_id
        call gs_base_init_ap;

        // ---- (1) uart_puts("CPU_ID_") ----
        lea rdi, [rip + msg_ap_cpu_prefix];
        call uart_puts;

        // ---- (2) Emit high nibble of APIC ID as hex ASCII ----
        mov rax, r12;
        shr rax, 4;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_hi_digit;
        add rax, 0x57;                       // 10..15 -> 'a'..'f'
        jmp ap_hi_emit;
        ap_hi_digit:
          add rax, 0x30;                     // 0..9   -> '0'..'9'
        ap_hi_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (3) Emit low nibble of APIC ID as hex ASCII ----
        mov rax, r12;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_lo_digit;
        add rax, 0x57;
        jmp ap_lo_emit;
        ap_lo_digit:
          add rax, 0x30;
        ap_lo_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (4) uart_puts("_HELLO\n") ----
        lea rdi, [rip + msg_ap_hello_suffix];
        call uart_puts;

        // =====================================================
        // #766 GS-witness line: `GS_OK_XX\n` where XX = cpu_idx
        // read back from _percpu_cbs[current] via gs_base MSR.
        // Proves end-to-end that gs_base_init_ap did its job.
        // =====================================================

        // ---- (5) uart_puts("GS_OK_") ----
        lea rdi, [rip + msg_ap_gs_prefix];
        call uart_puts;

        // ---- (6) rax = cpu_idx (u32 zero-extended) via gs:[0] indirection ----
        call gs_base_read_cpu_idx;
        mov r13, rax;                        // stash cpu_idx across nibble calls

        // ---- (7) Emit high nibble of cpu_idx ----
        mov rax, r13;
        shr rax, 4;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_gs_hi_digit;
        add rax, 0x57;
        jmp ap_gs_hi_emit;
        ap_gs_hi_digit:
          add rax, 0x30;
        ap_gs_hi_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (8) Emit low nibble of cpu_idx ----
        mov rax, r13;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_gs_lo_digit;
        add rax, 0x57;
        jmp ap_gs_lo_emit;
        ap_gs_lo_digit:
          add rax, 0x30;
        ap_gs_lo_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (9) uart_puts("\n") ----
        lea rdi, [rip + msg_ap_nl_suffix];
        call uart_puts;

        // =====================================================
        // #774 R18-M4-004: AP-side scheduler bring-up.
        // Populates this AP's per-AP idle TCB slab (@ ap_bringup.pdx
        // _ap_idle_tcbs[cpu_idx]), publishes its VA into
        // CB[PERCPU_OFF_IDLE_TCB=80] so sched_pick_next_r15's
        // empty-runq fallback returns THIS AP's idle rather than the
        // BSP's _idle_tcb, and calls runq_init to make the per-CPU
        // runqueue's empty state explicit.  Precondition:
        // gs_base_init_ap has programmed IA32_GS_BASE (satisfied by
        // the call above at step (5) equivalent — call to
        // gs_base_init_ap before the CPU_ID hello emit).  Placed
        // after the GS_OK witness so any fault inside ap_sched_init
        // does not swallow the earlier witness lines.  Preserves the
        // boot_smp fingerprint order (CPU_ID_XX_HELLO already emitted
        // above; SMP BRINGUP DONE emits on BSP after ap_bring_up_all
        // returns which happens after this AP has finished
        // ap_sched_init OR is still in flight — the smoke tolerates
        // both because the AP HELLOs are presence-only).
        // =====================================================
        call ap_sched_init;

        // =====================================================
        // R21-M1 (#826): XSAVE enable on this AP.  BSP already ran
        // xsave_probe_bsp; APs only need to enable — read the shared
        // _xsave_xcr0_target and program CR4.OSXSAVE + XCR0 for this
        // logical CPU.  Must run BEFORE any task_switch to a task with a
        // populated xsave area (xrstor #GPs on an OSXSAVE=0 CPU).  Skips
        // silently if BSP probe found no support.  No fingerprint from
        // the AP path (that's BSP-only).
        // =====================================================
        call xsave_enable_this_cpu;

        // =====================================================
        // R23-M1-002 (#876): IA32_PAT programming on this AP.
        // Silent variant (pat_init_ap): writes the same
        // (RCX=0x277, EAX=0x00070406, EDX=0x00070401) MSR triple
        // as pat_init_this_cpu on the BSP, no fingerprint emit.
        // Order: after xsave_enable_this_cpu for symmetry with
        // the BSP wire in kernel_main. Cross-CPU coherence
        // depends on every logical CPU seeing IA32_PAT[slot4]=WC
        // so future WC-mapped PTEs (framebuffer, DMA windows)
        // decode uniformly across all CPUs.
        // =====================================================
        call pat_init_ap;

        // =====================================================
        // R22-M1 (#845): x2APIC enable on this AP. Gated on
        // _x2apic_supported (BSP populates this via x2apic_probe_bsp
        // before any AP wake). On QEMU-TCG the probe returned 0 and
        // this is a no-op — the AP continues in xAPIC MMIO mode
        // matching BSP. On real hardware / KVM the probe returned 1;
        // this AP switches to x2APIC MSR mode. Must run BEFORE any
        // LAPIC access by this AP (currently: none until the AP
        // starts servicing timer/IPI in a future round, so the exact
        // order within ap_entry is tolerant — but placing it right
        // after xsave_enable_this_cpu keeps it symmetric with the
        // BSP wire in kernel_main which runs enable_bsp right after
        // x2apic_probe_bsp).
        // =====================================================
        call x2apic_enable_ap;

        // =====================================================
        // #779 R18-M6-001 + #780 R18-M6-002: per-AP CPUID topology
        // sweep. Reads CPUID 0x1A (hybrid class) and walks CPUID
        // 0x1F / 0x0B (package / core / thread) into this AP's CB
        // at offsets [120..128). Runs after ap_sched_init so the
        // CPU is in its normal "post-bring-up" configuration; runs
        // before the halt loop so future preempt-tails on this AP
        // see valid topology fields. Precondition: gs_base_init_ap
        // programmed IA32_GS_BASE (satisfied above). Idempotent.
        // =====================================================
        call topology_init;

        // =====================================================
        // R69.M1-003 (#1888): idle-CPU work-steal check before parking.
        // gs_base_read_cpu_idx returns this AP's cpu_idx (rax); passed
        // straight to Runqueue.sched_try_steal as dst_cpu_idx.
        //
        // HONEST SCOPE: at this point in the boot sequence (called from
        // ap_bring_up_all, itself called from kernel_main.pdx BEFORE the
        // r31_spawn witness or any other task_new call), every per-CPU
        // runqueue — this AP's own and every sibling's — is guaranteed
        // empty (runq_init/ap_sched_init above just zeroed this one, and
        // no application task exists yet on any CPU). sched_try_steal is
        // therefore a guaranteed no-op (returns 0) on every real boot
        // today. It is wired here anyway, at the exact site the R69.M1
        // brief specifies ("before hlt, check own runqueue... steal half
        // from the fullest"), because (a) the mechanism itself is real
        // and does not depend on AP-side IDT install — unlike genuine
        // task *execution* on an AP, moving TCB pointers between two
        // per-CPU linked lists needs no interrupts, and (b) a future
        // round that either re-orders bring-up after task spawn, or adds
        // a periodic re-check once AP-IDT lands, gets a real effect from
        // this call for free. The mechanism is proven directly (not via
        // this dead call site) by the boot_r69_smp_dispatch witness,
        // which populates multiple per-CPU runqueues via sched_wake's
        // cross-CPU path (#1883) and then calls sched_try_steal exactly
        // as a real idle balancer would. See runqueue.pdx's
        // sched_try_steal header for the full algorithm.
        // =====================================================
        call gs_base_read_cpu_idx;
        mov rdi, rax;
        call sched_try_steal;

        // ---- (10) Halt loop. cli guarantees IF=0 across hlt so no
        // maskable IRQ can wake us; jmp re-arms after wake-from-hlt
        // (NMI/SMI would return here but such delivery on an AP with
        // no IDT triple-faults, which is accepted M1/M2 risk per header
        // block). r12/r13 remain on the stack — inert; the halt loop
        // never returns and the AP's kernel stack is permanent for
        // its lifetime.
        ap_entry_halt:
          cli;
          hlt;
          jmp ap_entry_halt
      }
    }
}
