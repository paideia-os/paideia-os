// src/kernel/core/smp/ap_entry.pdx — R18-M1-003 / #762 (was #761 stub)
//
// Real AP long-mode entry point. Called via the trampoline blob's
// `mov ap_entry_slot(%rip), %rax; jmp *%rax` after transitioning
// real -> protected -> long mode and loading:
//   * CR3 = kernel PML4 (from trampoline pml4 slot)
//   * RSP = per-AP kernel stack top (from trampoline stack slot,
//           populated by ap_launch.pdx / ap_stack_top from
//           core/smp/ap_stacks.pdx)
//   * CS  = trampoline's own code64 selector (0x18 in trampoline GDT)
//   * IF  = 0 (real-mode `cli` still in effect)
//
// R18-M1-003 responsibility (#762): emit `CPU_ID_XX_HELLO\n` per-AP
// fingerprint on COM1 to feed the boot_smp smoke witness (#764), then
// park in a cli/hlt loop.
//
// Explicitly OUT of scope for R18-M1-003:
//   * Kernel GDT reload (`lgdt _gdt_ptr`) — the AP continues to run
//     under the trampoline's own low-memory GDT, which is a valid
//     code64/data64 descriptor set for as long as the AP does not
//     reload segment registers on its own. The trampoline GDT lives
//     at physical 0x8000+ (identity-mapped in the kernel PML4), so
//     GDTR still resolves cleanly.
//   * IDT install (`lidt _idt_ptr`) — no per-CPU or shared IDT is
//     loaded on the AP; any exception would triple-fault. We accept
//     that risk by keeping interrupts masked (cli in the halt loop):
//     the AP's LAPIC is unconfigured (no SVR, no TPR, no vectors),
//     so no maskable IRQ can arrive, and no code below fires an
//     exception. NMI/SMI can still bypass CLI and would triple-fault
//     — accepted risk for M1; #766 (M2 per-CPU state) lands the
//     real GDT/IDT reload.
//   * TSS load (`ltr`) — the BSP TSS is a single-CPU singleton
//     (core/int/tss.pdx `_tss`), unsafe to share as RSP0 source
//     across CPUs. Per-CPU TSS is #766/M2. With IF=0 throughout the
//     halt loop, no ring transition (and thus no RSP0 read) can
//     occur, so skipping ltr is safe here.
//   * IA32_GS_BASE setup — depends on per-CPU control-block frame
//     assignment which is #765/#766. Any `[gs:off]` access would
//     read the BSP's cpu_locals[0]; the code below does not touch
//     gs so the omission is inert.
//   * LAPIC config on the AP — deferred to M2/M3. Since the AP
//     never signals ready and never accepts interrupts here, the
//     omission is inert.
//
// Fingerprint format:
//   `CPU_ID_XX_HELLO\n`
//   XX = 2 lowercase hex nibbles of the xAPIC ID (LAPIC MMIO 0xFEE00020
//   bits [31:24]). For x2APIC (32-bit IDs), the low 8 bits are still
//   what the trampoline vector matches on; the full 32-bit ID printout
//   is R20 scope.
//
// Concurrency note on COM1:
//   uart_puts / uart_putc write COM1 THR polled — no locking. Multiple
//   APs writing concurrently could interleave characters mid-line. For
//   M1 this is accepted: the smoke witness (#764) grep-scans for the
//   whole `CPU_ID_XX_HELLO\n` substring, so a torn line simply fails
//   to match and the smoke retries. Real per-line serialization arrives
//   with the klog substrate's AP-side wire-in (post-M2).
//
// Encoder: paideia-as v0.20.1+. Uses lea (rip-relative), 32-bit MMIO
// load (mov ecx, [rax]), shr/and/cmp/jb, add-imm8, call/ret, cli/hlt/jmp.
// All primitives in-tree; no encoder work.

module ApEntry = structure {
  // Fingerprint prefix ("CPU_ID_") and suffix ("_HELLO\n"), both NUL-
  // terminated for uart_puts (which walks bytes until zero).
  pub let msg_ap_cpu_prefix : [u8; 8] = "CPU_ID_\0"
  pub let msg_ap_hello_suffix : [u8; 8] = "_HELLO\n\0"

  pub let _ap_entry : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#762 R18-M1-003: real AP long-mode entry. Called from trampoline blob (tools/ap_trampoline.S) via `mov ap_entry_slot(%rip), %rax; jmp *%rax` after CR3 = kernel PML4, RSP = per-AP stack top, CS = trampoline code64 selector 0x18, IF = 0. Body: (1) Read xAPIC LAPIC_ID register at MMIO 0xFEE00020 (32-bit load into ECX); shift right 24, and 0xff to isolate the 8-bit APIC ID (identity map covers 0xFEE00000 via kernel PML4 low-4GiB 1-GiB pages from boot_stub.S, so VA == PA). (2) Save APIC ID in R12 (SysV callee-save) across the three uart calls that follow. (3) uart_puts(msg_ap_cpu_prefix) — writes 'CPU_ID_'. (4) Emit the high nibble of APIC ID: shr 4, and 0x0f, cmp 10, add 0x30 (digit) or 0x57 (letter), uart_putc. (5) Same for the low nibble. (6) uart_puts(msg_ap_hello_suffix) — writes '_HELLO\\n'. (7) Halt loop: cli; hlt; jmp back. Rationale for cli vs sti: no IDT is loaded on the AP (per-CPU IDT install is #766/M2). LAPIC on this AP is unconfigured (no SVR / TPR / vectors), so no maskable IRQ can fire; keeping IF=0 also masks any inbound IPI. NMI/SMI still bypass CLI and would triple-fault (no IDT) — accepted risk for M1. Stack discipline: 2 callee-save pushes (r12, r13 — r13 reserved for symmetry / future per-CPU control-block spill) land rsp % 16 == 0 for the uart calls' internal call chain. Not restored at halt-loop entry: the loop never returns, so leaving r12/r13 saved on the stack is inert (kernel stack is per-AP, permanent for the AP's lifetime). Fingerprint format 'CPU_ID_XX_HELLO\\n' matches issue #762 AC and feeds #764 boot_smp witness. COM1 access is unlocked; concurrent AP writes can interleave chars — accepted for M1 (witness grep tolerates torn lines by retry). Kernel GDT / IDT / TSS reload + LAPIC config + GS_BASE setup all deferred to #766/M2 per header block rationale.",
      block: {
        // ---- Read xAPIC ID from LAPIC MMIO 0xFEE00020 ----
        mov rax, 0xFEE00020;
        mov ecx, [rax];                      // 32-bit MMIO load
        shr rcx, 24;                         // ID in bits [31:24]
        and rcx, 0xff;                       // mask to 8 bits

        // ---- Save APIC ID across uart calls ----
        push r12;
        push r13;
        mov r12, rcx;                        // r12 = APIC ID (0..255)

        // ---- (1) uart_puts("CPU_ID_") ----
        lea rdi, [rip + msg_ap_cpu_prefix];
        call uart_puts;

        // ---- (2) Emit high nibble of APIC ID as hex ASCII ----
        mov rax, r12;
        shr rax, 4;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_hi_digit;
        add rax, 0x57;                       // 10..15 -> 'a'..'f'
        jmp ap_hi_emit;
        ap_hi_digit:
          add rax, 0x30;                     // 0..9   -> '0'..'9'
        ap_hi_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (3) Emit low nibble of APIC ID as hex ASCII ----
        mov rax, r12;
        and rax, 0x0f;
        cmp rax, 10;
        jb ap_lo_digit;
        add rax, 0x57;
        jmp ap_lo_emit;
        ap_lo_digit:
          add rax, 0x30;
        ap_lo_emit:
          mov rdi, rax;
          call uart_putc;

        // ---- (4) uart_puts("_HELLO\n") ----
        lea rdi, [rip + msg_ap_hello_suffix];
        call uart_puts;

        // ---- (5) Halt loop. cli guarantees IF=0 across hlt so no
        // maskable IRQ can wake us; jmp re-arms after wake-from-hlt
        // (NMI/SMI would return here but such delivery on an AP with
        // no IDT triple-faults, which is accepted M1 risk per header
        // block). r12/r13 remain on the stack — inert; the halt loop
        // never returns and the AP's kernel stack is permanent for
        // its lifetime.
        ap_entry_halt:
          cli;
          hlt;
          jmp ap_entry_halt
      }
    }
}
