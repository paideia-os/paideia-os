// src/kernel/core/smp/ap_stacks.pdx — R18-M1-003 / #762
// Per-AP kernel-mode stack pool.
//
// Issue: paideia-os/paideia-os#762
//
// Exports:
//   AP_STACK_BYTES : u64 = 16384
//     Per-AP kernel-stack size. Matches the BSP kernel stack in
//     core/int/tss.pdx (_kernel_stack, 16 KiB) and the per-task kernel
//     stacks in core/sched/task_pool.pdx (KSTACK_BYTES_PER_TASK). One
//     canonical size keeps stack-overflow guards, IST layout, and
//     backtrace heuristics consistent across BSP + APs + tasks.
//
//   N_APS : u64 = 4
//     Static AP-count placeholder for R18.M1. Real MADT-driven AP
//     enumeration is R20 scope; until then the trampoline+launcher
//     path is exercised with a hard-coded 4-CPU ceiling. Bumping this
//     requires resizing _ap_kernel_stacks below (u64 count = N * 2048).
//
//   ap_stack_top(cpu_idx: u64) -> u64
//     Returns the top-of-stack (high address) for AP #cpu_idx. Stacks
//     grow down from the returned VA; the usable range for cpu_idx is
//     [return - AP_STACK_BYTES, return). Caller (ap_launch.pdx) writes
//     this value into the trampoline's stack slot before SIPI so the
//     AP's long-mode entry sets RSP to it verbatim.
//
// Storage discipline:
//   _ap_kernel_stacks : [u64; N_APS * 2048] in .bss @align(16).
//   .bss zero-init satisfies the "clean kernel stack" invariant; no
//   runtime init is required. 16-byte alignment matches the SysV
//   AMD64 RSP alignment contract at function-call boundaries.
//
//   Placement: static — chosen over phys_alloc() because (a) N_APS is
//   fixed at compile time for M1, (b) BSP allocator state at the point
//   ap_bring_up_all is called is stable (post-#649 refcount discipline
//   applies but there is no need to exercise it here), (c) the stacks
//   are permanent — an AP never returns them.
//
// Kernel-view/address discipline:
//   _ap_kernel_stacks lives in the kernel higher-half (.bss under the
//   kernel VMA base 0xFFFF8000_00000000 per src/kernel/link.ld). The
//   trampoline copies this address into its `ap_stack_slot` (u64) and
//   the AP's .code64 preamble does `mov ap_stack_slot(%rip), %rsp` —
//   which lands a canonical higher-half kernel VA in RSP. Long-mode
//   RSP tolerates any canonical VA; the stack backing is mapped in
//   the kernel PML4 (identity-loaded into CR3 via the trampoline's
//   pml4 slot), so the very first push (or ret) inside _ap_entry
//   dereferences into valid kernel memory.
//
// Not-a-witness note: like the rest of R18.M1, this module lands the
// mechanism only; no runtime call is wired from kernel_main.pdx. The
// AP-side witness (`CPU_ID_XX_HELLO`) is emitted by _ap_entry
// (rewritten in this same issue) and observed by the boot_smp smoke
// (#764) once ap_bring_up_all is called from kernel_main.

module ApStacks = structure {
  // Per-AP kernel-stack size in bytes. Kept in sync with tss.pdx
  // KERNEL_STACK_BYTES and task_pool.pdx KSTACK_BYTES_PER_TASK.
  pub let AP_STACK_BYTES : u64 = 16384

  // Static AP-count ceiling for R18.M1. R20 (MADT integration) will
  // replace this with a dynamic count derived from the ACPI MADT.
  pub let N_APS : u64 = 4

  // 4 APs * 2048 u64 slots = 4 * 16384 bytes = 64 KiB in .bss.
  // 16-byte aligned per SysV RSP-alignment contract at call boundaries.
  pub let mut _ap_kernel_stacks : [u64; 8192] = uninit @align(16)

  // ap_stack_top(cpu_idx) -> u64
  //   Returns &_ap_kernel_stacks + (cpu_idx + 1) * AP_STACK_BYTES.
  //   Downward-growing stack: the returned address is the TOP (initial
  //   RSP value for AP #cpu_idx), which is one-past-end of that AP's
  //   16 KiB slice. The final +16384 for cpu_idx = N_APS-1 lands
  //   exactly at &_ap_kernel_stacks + N_APS*16384 — the end of the
  //   pool, which is one-past-end of the array (in-bounds by C-array
  //   convention; the pool is not read at that VA, only used as an
  //   initial RSP that decrements on push).
  //
  //   No range check on cpu_idx: caller (ap_launch.pdx) iterates
  //   0..N_APS-1 by construction; passing cpu_idx >= N_APS would
  //   compute an out-of-pool VA and the AP would push into the next
  //   .bss neighbour (a caller bug this early in boot cannot be
  //   diagnostically recovered before the smoke fingerprint prints,
  //   matching the discipline in ap_trampoline_relocate.pdx).
  pub let ap_stack_top : (u64) -> u64 !{} @{} =
    fn (cpu_idx: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "#762 R18-M1-003: return top-of-stack VA for AP #cpu_idx (RDI). Computes &_ap_kernel_stacks + (cpu_idx + 1) * 16384 = &_ap_kernel_stacks + (cpu_idx + 1) << 14. Uses shl by 14 instead of a multiply so no imul encoder is required. rip-relative LEA of _ap_kernel_stacks (higher-half kernel VA under kernel VMA base) produces a canonical RSP the AP consumes verbatim after the trampoline's `mov ap_stack_slot(%rip), %rsp`. No range check on cpu_idx: caller enumerates 0..N_APS-1 by construction (ap_launch.pdx). Leaf function, no frame, no callee-save clobber. Returns in RAX per SysV.",
      block: {
        // rax = (cpu_idx + 1) * AP_STACK_BYTES = (rdi + 1) << 14
        mov rax, rdi;
        add rax, 1;
        shl rax, 14;

        // rax += &_ap_kernel_stacks
        lea rcx, [rip + _ap_kernel_stacks];
        add rax, rcx;
        ret
      }
    }
}
