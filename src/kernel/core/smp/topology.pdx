// src/kernel/core/smp/topology.pdx — R18-M6-001 / #779 + R18-M6-002 / #780
// Per-CPU hybrid-class tagging (#779) and (package, core, thread) topology
// walk (#780).
//
// Issues:
//   paideia-os/paideia-os#779 (CPUID 0x1A hybrid tagging)
//   paideia-os/paideia-os#780 (CPUID 0x1F / 0x0B extended topology walk)
//
// Purpose:
//   Each CPU (BSP + APs), once IA32_GS_BASE is programmed at its per-CPU
//   Percpu CB (via gs_base_init_bsp / gs_base_init_ap from #766), calls
//   topology_init to:
//     (a) Read CPUID leaf 0x1A EAX[31:24] (native model ID) and map it to
//         a compact hybrid_class code:
//           0 = Unknown  (leaf unsupported, or non-hybrid CPU, e.g. QEMU
//                         with -cpu qemu64 / most -cpu host on non-Alder-
//                         Lake+ hardware where CPUID.0:EAX < 0x1A)
//           1 = P-core    (Intel Core, native model 0x40)
//           2 = E-core    (Intel Atom / E-core, native model 0x20)
//           3 = LP-E-core (LP Efficient core, Meteor Lake+, native 0x30)
//     (b) Walk CPUID leaf 0x1F (extended v2 topology, Sapphire Rapids+)
//         or fall back to 0x0B (extended topology, Nehalem+) to derive
//         (package_id, core_id, thread_id) from this CPU's x2APIC ID,
//         using the per-level shift widths advertised in EAX[4:0].
//
//   All four values are stored as u16 in the per-CPU CB at offsets
//   [120..128) (see percpu.pdx PERCPU_OFF_HYBRID_CLASS / PACKAGE_ID /
//   CORE_ID / THREAD_ID). Populated exactly once per CPU during
//   bring-up; readable thereafter as a cheap `[gs:120]..[gs:126]` load
//   by future NUMA / hybrid-aware scheduler placement paths.
//
// Encoder-gap posture (v0.21 CPUID typed leaf-record intrinsic):
//   The v0.21 milestone will provide a typed
//   `cpuid_leaf(leaf, subleaf) -> {eax, ebx, ecx, edx}` intrinsic + stdlib
//   decoders (paideia-as issue #1283). That intrinsic is a *convenience*
//   over the raw `cpuid` mnemonic — the same raw idiom used since #447
//   (smep.pdx), #448 (smap.pdx), #449 (nx.pdx), and most recently #777
//   (tsc_deadline.pdx L98-110) is sufficient here. This module lands
//   the mechanism using the raw idiom so #779/#780 do not block on
//   v0.21; a future PR can collapse the manual EAX/EBX/ECX/EDX unpacks
//   into the typed helpers once they arrive.
//
// Per-CPU discipline:
//   topology_init reaches its target CB via rdmsr IA32_GS_BASE +
//   EDX:EAX reconstruct — the same idiom as tsc_deadline_arm_first
//   (apic/tsc_deadline.pdx L149-153), _ipi_handler_f1 (ipi/vectors.pdx
//   L82), sched_pick_next_r15 (sched/pick_next.pdx L119), and
//   ap_sched_init (sched/ap_bringup.pdx L153). Every CPU walks its
//   own CPUID and writes its own CB; no shared state.
//
// Wire-in points (per Not-a-witness note discipline):
//   BSP: kernel_main.pdx boot_continue_after_ring3 tail, immediately
//        after the early gs_base_init_bsp call at ~L1892 (so BSP's CB
//        carries topology from the earliest downstream witness onward).
//   AP:  ap_entry.pdx _ap_entry, after ap_sched_init and before the
//        halt loop (matches the "after GS_BASE + after per-AP scheduler
//        artefact" ordering all AP-side bring-up shares).
//
// CPUID reference (Intel SDM Vol 2A §CPUID + Vol 3A §11.11.3):
//
//   Leaf 0x00 (basic identification):
//     Input:  EAX=0
//     Output: EAX = max_std_leaf (used to gate 0x1A / 0x1F / 0x0B checks)
//
//   Leaf 0x1A (Hybrid Information Enumeration, Alder Lake+):
//     Input:  EAX=0x1A, ECX=0 (sub-leaf 0)
//     Output: EAX[31:24] = Native Model ID (Core Type):
//               0x20 = Intel Atom             → E-core   (code 2)
//               0x30 = Intel Atom (LP E-core) → LP-E     (code 3)
//               0x40 = Intel Core             → P-core   (code 1)
//               (other / 0) → Unknown (code 0)
//             EAX[23:0]  = Native Model ID information (model-specific;
//                          ignored here — a follow-up can surface it as
//                          a diagnostic string in the classifier witness).
//     Availability: gated on max_std_leaf >= 0x1A AND the hybrid CPU
//       indicator CPUID.07H:EDX[15] = 1. We omit the CPUID.07 secondary
//       gate: on non-hybrid CPUs the CPUID.1A response is architecturally
//       all-zero, which the classifier already maps to Unknown. Adds a
//       four-byte CPUID instead of a check-then-CPUID pair — trivial cost
//       for a one-time bring-up path, and matches the tsc_deadline_available
//       shape (single CPUID, gate on result).
//
//   Leaf 0x1F (V2 Extended Topology Enumeration, Sapphire Rapids+):
//   Leaf 0x0B (Extended Topology Enumeration, Nehalem+):
//     Input:  EAX=leaf, ECX=sub-leaf (level index, walked upward)
//     Output: EAX[4:0]  = shift value that produces the NEXT level's
//                         x2APIC-ID from this CPU's x2APIC-ID.
//             EBX[15:0] = number of logical processors at this level
//                         (informational — not consumed here).
//             ECX[15:8] = level type: 0=Invalid, 1=SMT, 2=Core,
//                         3=Module, 4=Tile, 5=Die, 6=DieGrp (0x1F only)
//             ECX[7:0]  = level number (mirrors input sub-leaf).
//             EDX       = this CPU's full 32-bit x2APIC ID.
//     Termination: sub-leaf whose ECX[15:8] == 0 marks the end of the
//                  advertised topology (all further sub-leaves are 0).
//
//     Extraction (this module walks sub-leaves 0 and 1 only — SMT + Core;
//     Module/Tile/Die levels above Core roll into package_id):
//       smt_shift  = CPUID(leaf, 0).EAX[4:0]
//       core_shift = CPUID(leaf, 1).EAX[4:0]
//       x2apic_id  = CPUID(leaf, 0).EDX
//       thread_id  = x2apic_id & ((1 << smt_shift) - 1)
//       core_id    = (x2apic_id >> smt_shift) &
//                    ((1 << (core_shift - smt_shift)) - 1)
//       package_id = x2apic_id >> core_shift
//
//     Availability: gated on max_std_leaf >= 0x1F for 0x1F; else on
//       >= 0x0B for 0x0B. On QEMU with -cpu qemu64 both may be absent —
//       we fall through leaving the (package, core, thread) triple at
//       the CB's .bss zero-init default (all zeros, treated as "single
//       thread of a single core of package 0"). On QEMU with
//       -smp 8,threads=2 (AC #2 of #780) -cpu host or -cpu max exposes
//       leaf 0x0B, giving 4 core_ids × 2 threads.
//
// Register / call discipline:
//   topology_init is a leaf (no nested calls — CPUID / RDMSR are
//   instructions, not calls). It clobbers rax/rcx/rdx (caller-save per
//   SysV) plus rbx (callee-save — spilled/restored) via CPUID's forced
//   EBX write. r8/r9/r10/r11/r12/r13/r14 are used as scratch across
//   CPUID sequences; r12/r13/r14 are callee-save (2 pushes: r12+r13
//   land rsp % 16 == 0 at entry; r14 spilled inside the block via a
//   deferred push covered by the same 16-byte alignment tail). To keep
//   the alignment invariant trivially verifiable we do 4 callee-save
//   pushes at prologue (rbx, r12, r13, r14) and 4 pops at epilogue
//   (4 * 8 = 32 = 2 * 16, rsp stays at %16 == 0 across the whole body).
//
// Encoder: paideia-as v0.20.1+ (cpuid, rdmsr, mov, mov_w, lea, shr, shl,
// and, sub, add, or, cmp, je/jne/jae/jb/jmp, push/pop, ret + `shl r64, cl`
// and `shr r64, cl` — all pre-existing per phys_alloc.pdx L85 and
// phys_free.pdx L70 usage). No new encoder work.

module Topology = structure {
  // ============================================================================
  // Constants
  // ============================================================================

  // Hybrid class encoding (u16 stored at CB[+120]):
  let HYBRID_UNKNOWN : u64 = 0
  let HYBRID_P       : u64 = 1
  let HYBRID_E       : u64 = 2
  let HYBRID_LP_E    : u64 = 3

  // CPUID 0x1A EAX[31:24] native model IDs (Intel SDM Vol 2A CPUID §):
  let NATIVE_MODEL_P    : u64 = 0x40
  let NATIVE_MODEL_E    : u64 = 0x20
  let NATIVE_MODEL_LP_E : u64 = 0x30

  // Per-CPU CB field offsets. Duplicated as immediates here because
  // paideia-as inlines constants at build time and cross-module constant
  // references are not encoded as immediates (same rationale as
  // apic/tsc_deadline.pdx L70 CB_OFF_DEADLINE).
  let CB_OFF_HYBRID_CLASS : u64 = 120
  let CB_OFF_PACKAGE_ID   : u64 = 122
  let CB_OFF_CORE_ID      : u64 = 124
  let CB_OFF_THREAD_ID    : u64 = 126

  // IA32_GS_BASE MSR — same MSR used across the codebase for per-CPU CB
  // access (see gs_base.pdx / tsc_deadline.pdx / ipi/vectors.pdx).
  let IA32_GS_BASE_MSR : u64 = 0xC0000101

  // ============================================================================
  // topology_init() -> ()
  // ============================================================================
  //
  // One-shot per-CPU: read CPUID leaves 0x00 / 0x1A / 0x1F / 0x0B and
  // publish (hybrid_class, package_id, core_id, thread_id) into the
  // caller's Percpu CB at offsets [120..128).
  //
  // Precondition:
  //   IA32_GS_BASE points at the caller's CB (satisfied by
  //   gs_base_init_bsp on BSP or gs_base_init_ap on APs; both write the
  //   MSR before any code that could call this).
  //
  // Idempotent: repeated calls re-stamp the same four fields.
  // Non-blocking on QEMU (all four fields land as 0 = Unknown / package 0
  // / core 0 / thread 0 if CPUID.1A and CPUID.1F/0B are both absent).
  //
  // Register discipline (SysV AMD64):
  //   Callee-save: rbx, r12, r13, r14 — spilled at prologue (4 pushes
  //     land rsp % 16 == 0 since entry rsp % 16 == 8 after the return-
  //     address push; +4 * 8 = +32 = +2 * 16 keeps alignment).
  //   Caller-save: rax, rcx, rdx, r8, r9, r10, r11, rdi, rsi — free.
  //
  //   Layout inside the body:
  //     rbx = CB VA (survives all CPUID clobbers)
  //     r12 = max_std_leaf (from CPUID.0)
  //     r13 = x2APIC ID (from CPUID(leaf, 0).EDX)
  //     r14 = smt_shift (from CPUID(leaf, 0).EAX[4:0])
  //
  // Leaf (no nested calls). Effects: {sysreg} for rdmsr, {mem} for the
  // four u16 stores into CB.
  pub let topology_init : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "#779 R18-M6-001 + #780 R18-M6-002: per-CPU CPUID sweep for hybrid class and (package, core, thread). Runs once per CPU during bring-up (BSP: after early gs_base_init_bsp in boot_continue_after_ring3; APs: after ap_sched_init in _ap_entry, so IA32_GS_BASE resolves to this CPU's CB before we write the four u16 fields at CB[+120..+128)). Body sequence: (P0) Prologue — 4 callee-save pushes (rbx, r12, r13, r14) land rsp % 16 == 0 (entry rsp % 16 == 8 after return-addr push; +32 keeps invariant; this module is leaf but the discipline matches non-leaf neighbours ap_sched_init and gs_base_init_ap for consistency). (P1) Fetch CB VA via rdmsr IA32_GS_BASE (0xC0000101) + shl rdx, 32 + or rax, rdx (SDM Vol 2C §5.2.9 reconstruction, same idiom as apic/tsc_deadline.pdx L149-153, ipi/vectors.pdx L82, sched/pick_next.pdx L119, sched/ap_bringup.pdx L153); stash in rbx. Defensive zero of all four u16 fields via `xor rcx, rcx; mov_w [rbx + N], rcx` — a defensive re-zero on top of .bss (percpu.pdx L111 `uninit @align(64)` places _percpu_cbs in .bss which the loader zero-fills), matches the runq_init 'explicit call documents intent' pattern in ap_bringup.pdx L109. (P2) CPUID.0 → max_std_leaf in r12 (EAX). (P3) Hybrid class: `cmp r12, 0x1A; jb topology_no_hybrid`. If in range, `mov rax, 0x1A; xor rcx, rcx; cpuid` — the sub-leaf ECX=0 is architecturally required per Intel SDM Vol 2A §CPUID (even though sub-leaf is currently ignored for 0x1A). Extract native model ID: `shr rax, 24; and rax, 0xFF`. Classify: 0x40 → 1 (P), 0x20 → 2 (E), 0x30 → 3 (LP-E), else 0 (Unknown). Write via `mov_w [rbx + 120], rcx` — 16-bit sized store (bare `mov [rbx+120], rcx` would emit REX.W and stomp package_id / core_id / thread_id at [rbx+122..128) with the high 48 bits of rcx, which are zero here but discipline matches fs/vfs_close.pdx L83/L91 and fs/fd_inherit.pdx L65/L67). (P4) Topology walk gating: `cmp r12, 0x1F; jae topology_walk_1f; cmp r12, 0x0B; jae topology_walk_0b; jmp topology_done`. Both walks share body via `mov rax, LEAF; xor rcx, rcx; cpuid` pattern; the LEAF immediate differs (0x1F vs 0x0B) — split into two entry stubs that load the leaf into a scratch and jump to the shared body would save 8 bytes but hurt readability, and this is a one-time bring-up path where size does not matter. (P5) Sub-leaf 0 (SMT level): `cpuid` returns EDX = x2APIC ID (32-bit — spec-limited but paideia-as's `mov rax, rdx` implicit-zero-extend behaviour keeps upper 32 clean); stash in r13. Check level valid: `mov rcx, r8; shr r8, 8; and r8, 0xFF; cmp r8, 0; je topology_done` — the level-type byte at ECX[15:8] == 0 means the leaf is not populated on this CPU (some hypervisors expose the leaf but return zero-level entries). Extract smt_shift = EAX[4:0] via `and rax, 0x1F`; stash in r14. Compute thread mask (1 << smt_shift) - 1 via `mov rcx, r14; mov r11, 1; shl r11, cl; sub r11, 1` — `shl r64, cl` per phys_alloc.pdx L85 / phys_free.pdx L70 (pre-existing encoder support). thread_id = x2apic & mask; store via mov_w to CB[+126]. (P6) Sub-leaf 1 (Core level): `mov rax, LEAF; mov rcx, 1; cpuid`. Check level valid — if not, treat (core=0, package=x2apic>>smt_shift). If valid: core_shift = EAX[4:0]; core_id = (x2apic >> smt_shift) & ((1 << (core_shift - smt_shift)) - 1); package_id = x2apic >> core_shift. Both use `shr r64, cl`. (P7) Epilogue — pop r14/r13/r12/rbx. Return. Register discipline: rbx (CB VA), r12 (max_leaf), r13 (x2APIC), r14 (smt_shift) all callee-save per SysV — the 4-push prologue preserves caller state and satisfies the 16-byte alignment invariant (leaf function; no nested calls; rsp %16 need not stay at 0 across the body since we call nothing, but keeping it there simplifies review). Effects: {sysreg} for rdmsr + the 4 cpuid instructions, {mem} for the 4 u16 stores. Capability {boot} restricts to bring-up. Encoder: cpuid (0F A2), rdmsr (0F 32), shl r64,cl (48 D3 E0), shr r64,cl (48 D3 E8), mov_w [mem], reg, xor / and / or / sub / add / cmp / mov / mov_w / lea / push / pop / je / jne / jae / jb / jmp / ret — all pre-existing per the smep/smap/nx/tsc_deadline CPUID sites and the phys_alloc/phys_free variable-shift sites.",
      block: {
        // ---- (P0) Prologue: 4 callee-save pushes (rbx / r12 / r13 / r14).
        // Entry rsp % 16 == 8 after return-addr push; +4*8 = +32 keeps
        // rsp % 16 == 0 across the body (leaf; alignment is not
        // load-bearing for correctness, only for review symmetry with
        // ap_sched_init / gs_base_init_ap).
        push rbx;
        push r12;
        push r13;
        push r14;

        // ---- (P1) rbx = CB VA (via rdmsr IA32_GS_BASE + EDX:EAX combine).
        // Same idiom as apic/tsc_deadline.pdx L149-153.
        mov rcx, 0xC0000101;                  // IA32_GS_BASE
        rdmsr;
        shl rdx, 32;
        or  rax, rdx;
        mov rbx, rax;                         // rbx = &CB[current_cpu]

        // ---- Defensive zero of the four u16 fields at CB[+120..+128).
        // .bss zero-init already satisfies this — the explicit stores
        // document intent + guard against a future non-bss allocator.
        xor rcx, rcx;
        mov_w [rbx + 120], rcx;               // hybrid_class = 0
        mov_w [rbx + 122], rcx;               // package_id   = 0
        mov_w [rbx + 124], rcx;               // core_id      = 0
        mov_w [rbx + 126], rcx;               // thread_id    = 0

        // ---- (P2) CPUID.0 → max_std_leaf in r12.
        // Intel SDM Vol 2A: EAX=0 returns EAX = highest supported basic
        // input value for CPUID (i.e. max standard leaf). EBX/ECX/EDX
        // return the vendor-string bytes — ignored here.
        xor rax, rax;
        cpuid;
        mov r12, rax;                         // r12 = max_std_leaf

        // ==============================================================
        // (P3) HYBRID CLASS (#779) — CPUID 0x1A if max_std_leaf >= 0x1A.
        // On non-hybrid CPUs the leaf is either unsupported (max < 0x1A,
        // e.g. QEMU -cpu qemu64) or returns all-zero (non-hybrid but
        // Alder-Lake-era Xeon SP variants) — both land as HYBRID_UNKNOWN
        // via the "else → 0" branch below, matching #779 AC #3 "QEMU
        // reports all cores as Unknown".
        // ==============================================================
        cmp r12, 0x1A;
        jb topology_no_hybrid;

        mov rax, 0x1A;
        xor rcx, rcx;                         // sub-leaf 0 (spec-required)
        cpuid;

        // Native Model ID lives at EAX[31:24]:
        shr rax, 24;
        and rax, 0xFF;

        // Classify: 0x40 → P (1), 0x20 → E (2), 0x30 → LP-E (3), else 0.
        cmp rax, 0x40;
        jne hybrid_check_e;
        mov rcx, 1;
        jmp hybrid_write;

      hybrid_check_e:
        cmp rax, 0x20;
        jne hybrid_check_lpe;
        mov rcx, 2;
        jmp hybrid_write;

      hybrid_check_lpe:
        cmp rax, 0x30;
        jne hybrid_unknown;
        mov rcx, 3;
        jmp hybrid_write;

      hybrid_unknown:
        xor rcx, rcx;                         // Unknown (0)

      hybrid_write:
        // 16-bit sized store — see justification for the mov_w rationale.
        mov_w [rbx + 120], rcx;
        jmp topology_gate;

      topology_no_hybrid:
        // hybrid_class already zero from the defensive pre-store above.

      topology_gate:
        // ==============================================================
        // (P4) TOPOLOGY WALK (#780) — prefer 0x1F, fall back to 0x0B.
        // On QEMU with -cpu qemu64 neither may be present → leave (pkg,
        // core, thread) = (0, 0, 0), which is the correct answer for a
        // single-thread-of-single-core-of-package-0 machine. On QEMU
        // -cpu max / -cpu host + -smp 8,threads=2 (AC #2), 0x0B is
        // exposed and yields 4 core_ids × 2 threads across the 8 CPUs.
        // ==============================================================
        cmp r12, 0x1F;
        jae topology_walk_1f;
        cmp r12, 0x0B;
        jae topology_walk_0b;
        jmp topology_done;

      topology_walk_1f:
        mov r10, 0x1F;                        // r10 = leaf
        jmp topology_do_walk;

      topology_walk_0b:
        mov r10, 0x0B;

      topology_do_walk:
        // -------- Sub-leaf 0: SMT level --------
        mov rax, r10;
        xor rcx, rcx;
        cpuid;

        // Level type at ECX[15:8] — 0 means "level not populated", bail.
        mov r8, rcx;
        shr r8, 8;
        and r8, 0xFF;
        cmp r8, 0;
        je topology_done;

        // x2APIC ID = EDX; stash in r13 for reuse across sub-leaf 1.
        mov r13, rdx;

        // smt_shift = EAX[4:0]; stash in r14.
        and rax, 0x1F;
        mov r14, rax;

        // thread_id = x2apic & ((1 << smt_shift) - 1)
        mov rcx, r14;                         // cl = smt_shift
        mov r11, 1;
        shl r11, cl;                          // r11 = 1 << smt_shift
        sub r11, 1;                           // r11 = smt_mask
        mov r9, r13;
        and r9, r11;                          // r9 = thread_id
        mov_w [rbx + 126], r9;

        // -------- Sub-leaf 1: Core level --------
        mov rax, r10;
        mov rcx, 1;
        cpuid;

        // If level 1 not populated, treat as core-in-package unshifted.
        mov r8, rcx;
        shr r8, 8;
        and r8, 0xFF;
        cmp r8, 0;
        je topology_no_core_level;

        // core_shift = EAX[4:0]
        and rax, 0x1F;
        mov r9, rax;                          // r9 = core_shift

        // core_id = (x2apic >> smt_shift) & ((1 << (core_shift - smt_shift)) - 1)
        mov r11, r13;                         // r11 = x2apic (working copy)
        mov rcx, r14;                         // cl = smt_shift
        shr r11, cl;                          // r11 = x2apic >> smt_shift

        // Compute core-field mask: (1 << (core_shift - smt_shift)) - 1.
        mov r8, r9;
        sub r8, r14;                          // r8 = core_shift - smt_shift
        mov rcx, r8;                          // cl = width
        mov rdx, 1;
        shl rdx, cl;
        sub rdx, 1;                           // rdx = core_mask
        and r11, rdx;                         // r11 = core_id
        mov_w [rbx + 124], r11;

        // package_id = x2apic >> core_shift
        mov r11, r13;
        mov rcx, r9;                          // cl = core_shift
        shr r11, cl;                          // r11 = package_id
        mov_w [rbx + 122], r11;
        jmp topology_done;

      topology_no_core_level:
        // Sub-leaf 1 absent: package_id = x2apic >> smt_shift; core_id = 0.
        // (core_id already zero from the P1 defensive stores.)
        mov r11, r13;
        mov rcx, r14;                         // cl = smt_shift
        shr r11, cl;
        mov_w [rbx + 122], r11;

      topology_done:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
