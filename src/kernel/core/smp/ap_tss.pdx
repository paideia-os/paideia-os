// src/kernel/core/smp/ap_tss.pdx — R87.M1 (#1965/#1966)
// Per-AP TSS + IST stacks + GDT descriptor + CS/SS reload + AP-side
// descriptor-table bring-up (lgdt / ltr / lidt).
//
// Issues: R87.M1-002 (#1965), R87.M1-003 (#1966)
// Design: design/kernel/ap-idt-strategy.md
//
// Storage discipline (mirrors core/int/tss.pdx and core/int/ist.pdx,
// core/smp/ap_stacks.pdx's static-allocation rationale — N_APS is fixed
// at 3 for R87's ceiling, same as ApStacks.N_APS / Percpu.MAX_CPUS-1):
//
//   _ap_tss              : 3 × 13 u64 (104 B) TSS blocks, indexed by
//                           ap_idx = dense_cpu_idx - 1 (0..2).
//   _ap_ist1/2/3_stacks   : 3 × 16 KiB each (DF / NMI / MC+PF), NOT
//                           shared with the BSP's Ist._ist1/2/3_stack —
//                           sharing would reopen the exact concurrent-
//                           NMI stack race per-CPU IST stacks exist to
//                           avoid (see design doc §"per-CPU IST stacks
//                           are not optional").
//   _ap_gdt_reload_frame  : 3 × 5 u64 per-AP CS/SS-reload iretq frames —
//                           per-AP because ap_launch.pdx does not wait
//                           for one AP to finish _ap_entry before
//                           SIPI-ing the next, so two APs can run
//                           ap_gdt_cs_reload concurrently.
//
// Bring-up ordering (ap_desc_tables_install, called once from
// _ap_entry): lgdt -> CS/SS reload -> ap_tss_install (zero + RSP0 +
// IST1..3 + IOMAP + GDT descriptor + ltr) -> lidt -> fingerprint.
// ltr MUST precede lidt: the shared IDT already carries nonzero IST
// indices for vec 2/8/14/18 (Idt.idt_apply_ist_fields), and a nonzero
// IST field is an unconditional instruction to switch RSP to that
// index of the CURRENTLY LOADED TSS — if lidt took effect before this
// AP's TR named a TSS with valid (non-null) IST1..3, the very next
// NMI (non-maskable, bypasses cli) would push onto address 0 and
// triple-fault. See the design doc for the full argument.
//
// GDT descriptor placement: Gdt._gdt_new slots 8-13 (byte offsets
// 64/80/96), selectors 0x40/0x50/0x60 — one per AP, extended by
// Gdt.gdt_install (R87, #1965) from the original 8-slot/0x3F-limit
// table to 14 slots/0x6F limit. Zero/non-present until this module's
// ap_tss_install populates the owning AP's slot.
//
// Encoder: paideia-as (current tree). lgdt [mem] / lidt [mem] / ltr r16
// / iretq+same-privilege-reload-frame all already proven (gdt.pdx,
// idt.pdx, tss.pdx); rdmsr/wrmsr, imul r64,r64 (r69_smp_dispatch.pdx),
// shl r64,imm — all pre-existing. No new encoder gap.

module ApTss = structure {
  // Ceiling: 3 APs (cpu_idx 1..3), matching ApStacks.N_APS-1 and
  // Percpu.MAX_CPUS-1.
  let AP_TSS_COUNT : u64 = 3

  // ============================================================================
  // Storage
  // ============================================================================

  // 3 × 13 u64 (104 B) TSS blocks. Same field layout as core/int/tss.pdx
  // Tss._tss: +4 RSP0, +36 IST1, +44 IST2, +52 IST3, +96..102 IOMAP.
  pub let mut _ap_tss : [u64; 39] = uninit @align(16)

  // 3 × 2048 u64 (16 KiB) IST stacks, one set per AP.
  pub let mut _ap_ist1_stacks : [u64; 6144] = uninit @align(16)   // #DF
  pub let mut _ap_ist2_stacks : [u64; 6144] = uninit @align(16)   // #NMI
  pub let mut _ap_ist3_stacks : [u64; 6144] = uninit @align(16)   // #MC/#PF

  // 3 × 5 u64 per-AP CS/SS-reload iretq frames (RIP/CS/RFLAGS/RSP/SS).
  pub let mut _ap_gdt_reload_frame : [u64; 15] = uninit @align(16)

  // ============================================================================
  // Per-AP IST stack-top accessors (ap_idx: 0..2) — same shl-14 pattern
  // as ApStacks.ap_stack_top.
  // ============================================================================

  pub let ap_ist1_top : (u64) -> u64 = fn (ap_idx: u64) -> unsafe {
    effects: {}, capabilities: {},
    justification: "R87.M1-002 (#1965): top-of-stack VA for AP #ap_idx's IST1 (#DF) stack. rax = (ap_idx+1) * 16384 via shl 14 (matches ApStacks.ap_stack_top's idiom); + &_ap_ist1_stacks. Leaf, no frame, no callee-save clobber.",
    block: {
      mov rax, rdi;
      add rax, 1;
      shl rax, 14;
      lea rcx, [rip + _ap_ist1_stacks];
      add rax, rcx;
      ret
    }
  }

  pub let ap_ist2_top : (u64) -> u64 = fn (ap_idx: u64) -> unsafe {
    effects: {}, capabilities: {},
    justification: "R87.M1-002 (#1965): top-of-stack VA for AP #ap_idx's IST2 (#NMI) stack. Same shape as ap_ist1_top, backed by _ap_ist2_stacks.",
    block: {
      mov rax, rdi;
      add rax, 1;
      shl rax, 14;
      lea rcx, [rip + _ap_ist2_stacks];
      add rax, rcx;
      ret
    }
  }

  pub let ap_ist3_top : (u64) -> u64 = fn (ap_idx: u64) -> unsafe {
    effects: {}, capabilities: {},
    justification: "R87.M1-002 (#1965): top-of-stack VA for AP #ap_idx's IST3 (#MC/#PF) stack. Same shape as ap_ist1_top, backed by _ap_ist3_stacks.",
    block: {
      mov rax, rdi;
      add rax, 1;
      shl rax, 14;
      lea rcx, [rip + _ap_ist3_stacks];
      add rax, rcx;
      ret
    }
  }

  // ============================================================================
  // ap_tss_install(cpu_idx) — populate + ltr this AP's own TSS
  // ============================================================================
  // RDI = dense cpu_idx (1..3 on an AP; gs_base_read_cpu_idx's return
  // value). Converts to ap_idx = cpu_idx - 1 for indexing _ap_tss /
  // _ap_ist*_stacks / the GDT descriptor slot.
  pub let ap_tss_install : (u64) -> () !{sysreg, mem} @{boot} =
    fn (cpu_idx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R87.M1-002 (#1965): populate this AP's 104-byte TSS block (RSP0 = this AP's own ap_stack_top, IST1..3 = this AP's own dedicated stacks, IOMAP_DISABLED), publish this CPU's TSS VA into its own Percpu CB[+64] (PERCPU_OFF_TSS_PTR — forward-compatible wiring for a future per-CPU-aware sched_switch_r15, unconsumed today; see design/kernel/ap-idt-strategy.md), build the TSS descriptor into Gdt._gdt_new slot (8 + ap_idx*2), and ltr the corresponding selector (0x40 + ap_idx*0x10). Mirrors Tss.tss_install's packing arithmetic exactly (limit=0x67, access=0x89), parameterized per-AP. rbx=cpu_idx (pushed, callee-save) then overwritten with ap_idx; r12=tss_addr (pushed, callee-save) computed once via imul (ap_idx*104) and reused across every field write plus the descriptor-base packing. Register discipline: rax/rcx/rdx caller-save scratch throughout (rdmsr's EDX:EAX + MSR-index-in-RCX idiom reused verbatim from ipi/vectors.pdx's _ipi_handler_f1 for the CB[+64] publish). Stack: entry rsp%16==8 (standard SysV call-site convention); 2 pushes (rbx, r12) land at rsp%16==8 again (even push count from an odd-8 start), which is WRONG for the several nested calls below (ap_stack_top/ap_ist1_top/ap_ist2_top/ap_ist3_top each need rsp%16==0 at their own `call` site) — a compensating `sub rsp,8` after the 2 pushes corrects to rsp%16==0, held constant (no further pushes) across every nested call in this body, then `add rsp,8` before the 2 pops restores the exact entry-relative depth for a clean `pop r12; pop rbx; ret`.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;
        mov rbx, rdi;
        sub rbx, 1;                          // rbx = ap_idx (0..2)

        // tss_addr = &_ap_tss + ap_idx * 104
        mov rax, rbx;
        mov rcx, 104;
        imul rax, rcx;
        lea rcx, [rip + _ap_tss];
        add rax, rcx;
        mov r12, rax;                         // r12 = tss_addr

        // Zero 13 u64s.
        xor rcx, rcx;
        xor rdx, rdx;
        ap_tss_zero_loop:
          cmp rcx, 13;
          jge ap_tss_zero_done;
          mov [r12 + rcx * 8], rdx;
          add rcx, 1;
          jmp ap_tss_zero_loop;
        ap_tss_zero_done:

        // RSP0 @ +4
        mov rdi, rbx;
        call ap_stack_top;
        mov [r12 + 4], rax;

        // IST1 @ +36
        mov rdi, rbx;
        call ap_ist1_top;
        mov [r12 + 36], rax;

        // IST2 @ +44
        mov rdi, rbx;
        call ap_ist2_top;
        mov [r12 + 44], rax;

        // IST3 @ +52
        mov rdi, rbx;
        call ap_ist3_top;
        mov [r12 + 52], rax;

        // IOMAP_BASE @ +102 (packed into bits 48-63 of qword @+96).
        mov rcx, [r12 + 96];
        mov rdx, 0x0000FFFFFFFFFFFF;
        and rcx, rdx;
        mov rdx, 0x0068000000000000;
        or  rcx, rdx;
        mov [r12 + 96], rcx;

        // Publish this CPU's own TSS VA into CB[+64] (PERCPU_OFF_TSS_PTR).
        // Forward-compatible only — nothing reads this slot yet.
        mov rcx, 0xC0000101;                  // IA32_GS_BASE MSR index
        rdmsr;
        shl rdx, 32;
        or  rax, rdx;
        mov [rax + 64], r12;

        // ---- GDT TSS descriptor: byte offset = 64 + ap_idx*16 ----
        mov rax, rbx;
        mov rcx, 16;
        imul rax, rcx;
        add rax, 64;
        lea rcx, [rip + _gdt_new];
        add rax, rcx;                         // rax = &gdt_slot_lo (this AP's)

        // low qword = limit(0x67) | base[23:0]<<16 | 0x89<<40 | base[31:24]<<56
        mov rcx, r12;
        and rcx, 0xFFFFFF;
        shl rcx, 16;
        or  rcx, 0x67;
        mov rdx, 0x89;
        shl rdx, 40;
        or  rcx, rdx;
        mov rdx, r12;
        shr rdx, 24;
        and rdx, 0xFF;
        shl rdx, 56;
        or  rcx, rdx;
        mov [rax + 0], rcx;

        // high qword = base[63:32]
        mov rcx, r12;
        shr rcx, 32;
        mov [rax + 8], rcx;

        // ---- ltr: selector = 0x40 + ap_idx*0x10 ----
        mov rax, rbx;
        mov rcx, 0x10;
        imul rax, rcx;
        add rax, 0x40;
        ltr ax;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ap_gdt_cs_reload(cpu_idx) — same-privilege iretq CS/SS reload
  // ============================================================================
  // Reuses Gdt._gdt_reload_land (stateless `ret`) as the landing pad —
  // safe for concurrent APs because it touches no memory. Only the
  // iretq FRAME needs to be per-AP (indexed by ap_idx = cpu_idx - 1 in
  // _ap_gdt_reload_frame), since two APs could be mid-reload
  // simultaneously.
  //
  // Behaves, from the caller's perspective, exactly like an ordinary
  // call/ret: the frame's RIP/RSP are captured from THIS call's own
  // entry state, so Gdt._gdt_reload_land's `ret` resumes the caller
  // (ap_desc_tables_install) at the instruction after `call
  // ap_gdt_cs_reload`, with CS=0x08/SS=0x10 freshly validated against
  // whatever GDT is current (the shared, extended kernel GDT, since
  // the caller's own lgdt already ran).
  pub let ap_gdt_cs_reload : (u64) -> () !{sysreg, mem} @{boot} =
    fn (cpu_idx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R87.M1-003 (#1966): CS/SS reload after this AP's own lgdt, mirroring Gdt.gdt_install's #661-followup same-privilege iretq trick. This AP entered _ap_entry with CS = the trampoline's own code64 selector (0x18 there); after lgdt repoints this AP's GDTR at the shared kernel GDT, selector 0x18 in THAT table is slot 3 (reserved, zero) — the first iretq this AP ever takes (a future round's timer preempt, once sti is enabled) would #GP re-validating CS against the new GDT. Fix: build a 5-slot iretq frame (RIP = &Gdt._gdt_reload_land, CS=0x08, RFLAGS=current via pushfq/pop, RSP=current entry rsp, SS=0x10) in this AP's slice of _ap_gdt_reload_frame (index = (cpu_idx-1)*5, computed via imul — matches the mod/index arithmetic idiom in sched/runqueue.pdx's sched_try_steal), point RSP at the frame, iretq. CPU atomically reloads CS/SS/RFLAGS/RIP/RSP and jumps to _gdt_reload_land, whose bare `ret` pops the return address this function's OWN entry rsp still has on top (no push has happened between function entry and the `mov [frame+24], rsp` capture — only the net-zero pushfq/pop pair — so the captured rsp is identical to entry rsp), resuming the caller exactly as an ordinary `ret` would. Per-AP frame slice avoids a race with a sibling AP concurrently mid-bring-up on the same code path (ap_launch.pdx does not serialize _ap_entry completion across APs). Register discipline: rax/rcx/rdx caller-save scratch for the index arithmetic and frame-field packing; no callee-save touched. Effects {sysreg, mem}: sysreg for iretq's privileged state reload, mem for the frame writes.",
      block: {
        // frame = &_ap_gdt_reload_frame + (cpu_idx - 1) * 5 * 8
        mov rax, rdi;
        sub rax, 1;
        mov rcx, 5;
        imul rax, rcx;
        lea rdi, [rip + _ap_gdt_reload_frame];
        lea rdi, [rdi + rax * 8];

        lea rax, [rip + _gdt_reload_land];
        mov [rdi + 0], rax;                   // RIP
        mov rax, 0x8;
        mov [rdi + 8], rax;                    // CS = kernel code64
        pushfq;
        pop rax;
        mov [rdi + 16], rax;                   // RFLAGS
        mov [rdi + 24], rsp;                   // RSP = this call's entry rsp
        mov rax, 0x10;
        mov [rdi + 32], rax;                   // SS = kernel data

        mov rsp, rdi;
        iretq
      }
    }

  // ============================================================================
  // ap_desc_tables_install() — top-level AP descriptor-table bring-up
  // ============================================================================
  // Called once from _ap_entry, after gs_base_init_ap / ap_sched_init /
  // xsave_enable_this_cpu / pat_init_ap / x2apic_enable_ap / topology_init
  // / sched_try_steal (R69) have all run, and before the (unchanged)
  // cli;hlt;jmp park loop. Order: read this CPU's dense cpu_idx -> lgdt
  // (shared, already-extended kernel GDT) -> CS/SS reload -> ap_tss_install
  // (must precede lidt — see this file's header) -> lidt (shared kernel
  // IDT) -> `ap idt ok` fingerprint.
  pub let ap_desc_tables_install : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R87.M1-003 (#1966): AP-side descriptor-table bring-up, called once from _ap_entry. (1) gs_base_read_cpu_idx -> rbx (dense cpu_idx, 1..3 on an AP; callee-save, survives every nested call below). (2) lgdt [rip+_gdt_ptr] — this AP's own GDTR now names the shared kernel GDT (already extended to 14 slots / limit 0x6F by Gdt.gdt_install on the BSP, long before any AP is woken). (3) ap_gdt_cs_reload(rbx) — CS/SS reload (see that function's own justification); behaves as an ordinary call/ret to this caller. (4) ap_tss_install(rbx) — populate + ltr this AP's own TSS; MUST precede lidt (nonzero IST gates in the shared IDT require a valid, non-null-IST TSS already loaded before lidt makes that IDT reachable — an NMI in the gap would push onto address 0). (5) idt_lidt(&_idt_descriptor) — this AP's own IDTR now names the shared, already-built 256-entry IDT. (6) klog_s1_d1(LEVEL_INFO, SUBSYS_APIC, tag_ap_idt_ok, k_cpu, rbx) — the `ap idt ok -- cpu=<N>` fingerprint (#1966 AC). Interrupts remain masked (no sti here — that is a deliberate, documented ceiling: see design/kernel/ap-idt-strategy.md's blocking-finding section on why enabling sti/timer preemption on an AP today would corrupt the BSP's single global _current_tcb/_tss state). Register discipline: rbx (cpu_idx, one push, callee-save, read by every nested call as its rdi argument). Effects {sysreg, mem}: sysreg for lgdt/lidt, mem transitively via the nested calls.",
      block: {
        push rbx;

        call gs_base_read_cpu_idx;
        mov rbx, rax;                          // rbx = dense cpu_idx (1..3)

        lea rdi, [rip + _gdt_ptr];
        lgdt [rdi];

        mov rdi, rbx;
        call ap_gdt_cs_reload;

        mov rdi, rbx;
        call ap_tss_install;

        lea rdi, [rip + _idt_descriptor];
        call idt_lidt;

        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_APIC];
        lea rdx, [rip + tag_ap_idt_ok];
        lea rcx, [rip + k_cpu];
        mov r8, rbx;
        call klog_s1_d1;

        pop rbx;
        ret
      }
    }
}
