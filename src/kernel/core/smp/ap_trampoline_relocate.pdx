// src/kernel/core/smp/ap_trampoline_relocate.pdx — R18-M1-002 / #761
// AP boot trampoline installer.
//
// The trampoline itself is authored as GNU-as (paideia-as emits 64-bit
// long-mode code only; the trampoline needs .code16 + .code32 + .code64
// mixed-mode). See tools/ap_trampoline.S for the blob source,
// tools/ap_trampoline.ld for the standalone-link discipline that pins
// its VMA at 0x8000, and tools/ap_trampoline_embed.S for the .incbin
// wrapper that places the flat blob in kernel .rodata.ap_trampoline
// under the symbols _ap_trampoline_blob_start / _ap_trampoline_blob_end.
//
// Exports:
//   ap_trampoline_install(dst_phys: u64) -> u64
//     Copies the blob to `dst_phys` via rep_movsb. Returns the number
//     of bytes copied. Prerequisites on `dst_phys`:
//       * Page-aligned (SIPI vector is dst_phys >> 12; low 12 bits
//         are lost). Enforced by convention, not by the installer.
//       * In the low 1 MiB (SIPI vector is 8 bits — max physical
//         address is 0xFF000). Convention today is hard-coded 0x8000.
//       * Equals the VMA the blob was linked for. The blob is
//         position-DEPENDENT (intra-blob absolute references were
//         resolved at ap_trampoline.elf link time with VMA=0x8000);
//         copying to any other page requires re-linking tools/
//         ap_trampoline.ld and rebuilding. Callers that want a
//         different base must update the linker script in lockstep.
//
//     Slot patching is a SEPARATE step and NOT this function's
//     responsibility. After install, the caller must patch three
//     slots at these byte offsets from dst_phys:
//       _ap_trampoline_pml4_offset   — 4 bytes, kernel PML4 phys
//       _ap_trampoline_stack_offset  — 8 bytes, per-AP kernel stack top
//       _ap_trampoline_entry_offset  — 8 bytes, _ap_entry VA
//     These offset constants are ELF symbols exported by
//     ap_trampoline.o (`.set` directives; consumed via `lea rax,
//     [rip + _ap_trampoline_pml4_offset]` in the caller).
//
//     Follow-up #762 (per-CPU stack + real AP entry) wires the
//     patching + call site in kernel_main. #761 lands the blob +
//     installer only, keeping the review focused on the
//     mixed-mode trampoline mechanics.
//
// Address-space discipline:
//   dst_phys is used as both the destination address for the memcpy
//   and later as the SIPI vector (>> 12). Kernel PML4 identity-maps
//   the low 4 GiB via PDPT[0..3] (see boot_stub.S), so VA=phys for
//   any low-memory frame accessed from ring 0 in the kernel view.
//   No VA/PA conversion is needed here (unlike aspace_map / kpti_*
//   which handle phys_alloc-form kernel VAs).
//
// Encoder: paideia-as v0.20.1+. Uses lea (rip-relative), sub, mov,
// cld, rep_movsb, ret. All primitives are in-tree; no encoder work.

module ApTrampolineRelocate = structure {

  pub let ap_trampoline_install : (u64) -> u64 !{mem} @{boot} =
    fn (dst_phys: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "#761 R18-M1-002: memcpy the AP boot trampoline blob (embedded in kernel .rodata.ap_trampoline via tools/ap_trampoline_embed.S) to caller-supplied physical page dst_phys. rep_movsb copies [_ap_trampoline_blob_start, _ap_trampoline_blob_end) bytes; both are extern kernel symbols emitted by ap_trampoline_embed.o. rsi = source (rip-relative lea of blob start). rcx = byte count computed as (end - start). rdi = destination (dst_phys, identity-mapped VA=phys via kernel PML4[0..3] 1-GiB pages from boot_stub.S). r12 saves the count across rep_movsb (which clobbers rcx) so it can be returned in rax. Two-push prologue (r12, callee-save filler) keeps rsp%16 == 0 across the rep_movsb. cld before rep_movsb to guarantee DF=0 explicitly — SysV mandates DF=0 across function boundaries but boot-path paranoia is cheap and mirrors tmpfs_write's #583 pattern. Does NOT patch parameter slots (pml4 / stack / entry); that responsibility lives with the caller (#762 wires it via _ap_trampoline_pml4_offset etc.). Does NOT enforce dst_phys page-alignment or low-1MiB bound: the blob was linked at VMA=0x8000, so any other dst_phys would emit valid bytes at the wrong runtime address and the AP would take an unpredictable path — a caller bug this early in boot triple-faults before the smoke fingerprint can even print. Emits no witness line — that lives in #764's boot_smp smoke, which wires ap_trampoline_install alongside the real ap_wake_all call.",
      block: {
        push rbx;
        push r12;

        // rbx = destination (survives rep_movsb which touches rdi).
        mov rbx, rdi;

        // rsi = source (kernel VA of blob start; RIP-relative).
        lea rsi, [rip + _ap_trampoline_blob_start];

        // Compute count = end - start.
        lea rax, [rip + _ap_trampoline_blob_end];
        sub rax, rsi;

        // r12 = count (SysV callee-save; survives rep_movsb for the return).
        mov r12, rax;
        mov rcx, rax;

        // rdi = destination.
        mov rdi, rbx;

        cld;
        rep_movsb;

        // Return byte count.
        mov rax, r12;

        pop r12;
        pop rbx;
        ret
      }
    }
}
