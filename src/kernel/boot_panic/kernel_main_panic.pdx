// src/kernel/boot_panic/kernel_main_panic.pdx — M8-001 (#706): panic kernel entry point
//
// kernel_main_panic_64: minimal 64-bit entry point that immediately triggers
// an assertion failure via kassert_fail. Used to test the panic subsystem and
// klog_panic halt path.
//
// Calls kassert_fail(SUBSYS_PANC, FILE_ID_kernel_main_panic, 1, 0, 1)
// to emit assertion-failed panic event stream and halt.

module KernelMainPanic = structure {
  pub let kernel_main_panic_64 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "M8-001 (#706): Boot panic ELF entry point. Calls kassert_fail with subsys PANC, file_id kernel_main_panic, line 1, expected 0, actual 1 (always fires: 0 != 1). The call trips the assertion, emits panic logs via klog_s1_x2 (expected vs actual) + klog_s1_x1_d1 (file + line), then klog_panic which rings the bell (dump + isa-debug-exit port 0xf4 value 0x11), halts on return (unreachable).",
    block: {
      lea rdi, [rip + SUBSYS_PANC];           // rdi = subsys_ptr (arg 1)
      mov rsi, FILE_ID_boot_panic_kernel_main_panic;
      mov rdx, 1;                              // rdx = line (arg 3)
      mov rcx, 0;                              // rcx = expected (arg 4)
      mov r8, 1;                               // r8 = actual (arg 5)
      call kassert_fail;                       // noreturn
      ud2;                                     // unreachable sentinel
    }
  }
}
