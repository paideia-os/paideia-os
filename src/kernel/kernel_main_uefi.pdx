// src/kernel/kernel_main_uefi.pdx — R19-M4-003 (#799) + R111-M1-002 (#2354)
//
// UEFI kernel-side entry point. The UEFI stub (src/boot/uefi_stub.pdx
// efi_finalize_and_handoff) transfers control here after ExitBootServices
// returns EFI_SUCCESS. This is the FIRST paideia code that runs with
// firmware quiescent — no BS pointers, no console primitives, no interrupts
// (LAPIC not yet enabled), no GDT/IDT of our own (firmware's still loaded
// but likely partially invalidated), no scheduler, no aspace.
//
// -----------------------------------------------------------------------------
// R111.M1-002 (paideia-os #2354): kernel_main_uefi → kernel_main_64 bridge
// -----------------------------------------------------------------------------
//
// Prior to R111 this file's last act was `cli; hlt; jmp` — it printed the
// UEFI banner, seeded the phys bitmap, ran verify_self, and then wedged.
// The whole tail of kernel bring-up (IDT install, TSS, SMEP/SMAP/NX,
// APIC, LAPIC timer, scheduler, PCI enum, NVMe attach, xHCI attach, VFS
// mount, INIT spawn) lives in `kernel_main_64` (src/kernel/boot/
// kernel_main.pdx) and had never been reachable under the UEFI path —
// only the PVH `-kernel` boot path (via boot_stub.S + entry.pdx `_start`)
// ever reached it.
//
// R111.M1-002 lands the bridge: after `verify_self` returns, we (a) emit
// a single fingerprint line `"UEFI BRIDGE OK rsdp=0x<..> gop=0x<..>
// phys=0x<..>"` so the pre-push smoke matrix can assert the transition
// took place, and (b) `call kernel_main_64` directly.
//
// Handoff-record inventory (nothing new is allocated; every producer/
// consumer wire already exists — the bridge just makes the call site):
//
//   RSDP handoff  — boot_env_t.rsdp_pa (u64 @ +48, populated by
//                   src/boot/uefi_stub.pdx efi_find_rsdp (#794)).
//                   Consumed by kernel_main_64's Mcfg wiring
//                   (`phase1_acpi_gather(rdi=[rip+_boot_env_pa], ...)`
//                   at kernel_main.pdx L314) — the *_boot_env_pa
//                   pointer, latched here in Phase 1, IS the R20
//                   handoff record.  No EBDA scan.
//
//   GOP FB handoff — boot_env_t.fb (fb_desc_t @ +16, populated by
//                    src/boot/uefi_stub.pdx efi_gop_capture (#793)).
//                    Consumed by kernel_main_64's fb-console block
//                    (fb_map_lfb + fb_console_init at kernel_main.pdx
//                    L174..L211).  Same *_boot_env_pa carries it.
//
//   Physmap handoff — _uefi_phys_bitmap (128 KiB, 4 GiB coverage at 4 KiB
//                     granularity) + _uefi_phys_free_pages (popcnt tally),
//                     both populated by uefi_physmap_seed_alloc (Phase 4b
//                     below).  Consumed by the future R14+ mm/ subsystem
//                     via the uefi_phys_seed_free_pages accessor (see
//                     src/kernel/mm/uefi_phys_seed.pdx §uefi_phys_seed_
//                     free_pages).  The bridge emits the tally in the
//                     fingerprint so smoke can gate on it.
//
//   Measurement-chain handoff — verify_self (R28-M1-004, #1001) emits
//                               "EFI SIGNATURE OK" or "EFI UNSIGNED
//                               (enforcement off)" on COM1 BEFORE the
//                               bridge fingerprint prints, so the two
//                               lines land on the wire in that order.
//                               R32 lands real ML-DSA-65 verify; R33
//                               flips enforcement (see verify_self.pdx
//                               file preamble).
//
// Execution-context caveat: this bridge assumes higher-half paging is
// already in effect when it runs — because kernel_main_uefi's own body,
// verify_self's body, u64_to_hex's body, and kernel_main_64's body are
// all linked at higher-half VMA (link.ld: `.text` section at VMA
// KERNEL_VMA_BASE + LMA).  R111.M1-003 (co-lands) installs the bootstrap
// PML4 mapping VMA→LMA before we get here.  Under the M4/M5 placeholder
// wiring where `_kernel_main_uefi_pa = 0x100000`, the bridge cannot
// execute end-to-end because RIP-relative addressing is broken pre-
// loader (see the "Execution-context caveat" block further down); the
// wiring itself is the M1-002 acceptance witness.
//
// -----------------------------------------------------------------------------
// Handoff contract
// -----------------------------------------------------------------------------
//
// SysV first arg (RDI) = physical address of boot_env_t (256 B struct laid
// out per src/boot/uefi_env.pdx). The finalizer set this and jumped here via
// `push _kernel_main_uefi_pa; ret`. The kernel_main_uefi entry:
//
//   1. Verifies env->magic (u64 @ +0) matches BOOT_ENV_MAGIC = 0x564E454244494150
//      ("PAIDBENV" LE). On mismatch: halt (cli/hlt spin) — the wrong entry
//      was reached, or memory is corrupted, or the finalizer never ran.
//   2. Latches the env pointer into _boot_env_pa for downstream consumers.
//   3. Initialises COM1 16550 (0x3F8) directly — no dependency on the
//      Uart module (which is linked at higher-half VMA and would fault if
//      called before the R19.M5 loader stages higher-half paging).
//   4. Prints "UEFI kernel_main entered\r\n" via raw port writes to 0x3F8.
//   5. Calls uefi_build_physmap(env) to count and record the reusable
//      physical extents from env->efi_memmap_pa. Return value ignored at
//      this milestone — future R19.M5+ work will consume the derived
//      bitmap for the paideia phys_alloc bootstrap.
//   6. Enters an unreachable cli/hlt spin. Under the current M4 wiring the
//      UEFI stub's _kernel_main_uefi_pa is a placeholder (0x100000, see
//      src/boot/uefi_stub.pdx), so this function's code is not actually
//      executed from a jump end-to-end until R19.M5 lands the ELF loader
//      that patches the real entry PA. Until then, `objdump -t kernel.elf`
//      showing kernel_main_uefi as a GLOBAL FUNC is the M4 acceptance
//      witness for the kernel side.
//
// -----------------------------------------------------------------------------
// Execution-context caveat (M4 → M5)
// -----------------------------------------------------------------------------
//
// This function is emitted into kernel.elf's .text section, which link.ld
// places at higher-half VMA (0xFFFF800000...). All RIP-relative addressing
// inside the body assumes execution AT that VMA. When the R19.M5 ELF loader
// runs, it will (a) allocate physical pages, (b) copy .text/.rodata/.data
// per LMA, (c) install a page table that maps the higher-half VMA to the
// chosen physical LMA, and (d) THEN branch here. Executing this function
// before that paging is in place will silently corrupt every RIP-relative
// data reference.
//
// The MVP direct-jump (M4) is therefore expected to fail on real hardware —
// but the wiring is what M4 validates: kernel_main_uefi exists as a GLOBAL
// FUNC symbol in kernel.elf, addressable by the loader.
//
// -----------------------------------------------------------------------------
// UART init sequence (16550 canonical, from src/kernel/boot/uart.pdx)
// -----------------------------------------------------------------------------
//
// Standard 16550D §3.3 init: 7 port writes to 0x3F8..0x3FF programming the
// divisor latch, baud divisor (3 = 115200 from 1.8432 MHz), 8N1 framing,
// FIFO enable, modem control, and IER off. Inlined here (rather than
// calling Uart.uart_init) because that function's RIP-relative addressing
// is broken pre-loader (see caveat above), whereas a self-contained inline
// sequence uses only immediate ports and register moves.

module KernelMainUefi = structure {

  // ==========================================================================
  // .data slots — post-handoff latches
  // ==========================================================================

  // Physical address of the boot_env_t struct handed by the UEFI stub.
  // Latched from RDI on entry so downstream consumers (uefi_build_physmap,
  // future kernel bring-up steps) can retrieve it without threading the
  // pointer through every call site.
  pub let mut _boot_env_pa : u64 = 0

  // ==========================================================================
  // Message string — "UEFI kernel_main entered\r\n" (26 bytes)
  // ==========================================================================
  //
  // Raw ASCII bytes, NOT CHAR16 (post-EBS we no longer have OutputString;
  // we're driving the 16550 THR one byte at a time). Length 26 hard-coded
  // in the print loop below.
  //
  //   U   E   F   I   sp  k   e   r   n   e   l   _   m
  //   0x55 0x45 0x46 0x49 0x20 0x6B 0x65 0x72 0x6E 0x65 0x6C 0x5F 0x6D
  //   a   i   n   sp  e   n   t   e   r   e   d   \r  \n
  //   0x61 0x69 0x6E 0x20 0x65 0x6E 0x74 0x65 0x72 0x65 0x64 0x0D 0x0A

  pub let _msg_kernel_uefi : [u8; 26] = [
    0x55u8, 0x45u8, 0x46u8, 0x49u8, 0x20u8, 0x6Bu8, 0x65u8, 0x72u8,
    0x6Eu8, 0x65u8, 0x6Cu8, 0x5Fu8, 0x6Du8, 0x61u8, 0x69u8, 0x6Eu8,
    0x20u8, 0x65u8, 0x6Eu8, 0x74u8, 0x65u8, 0x72u8, 0x65u8, 0x64u8,
    0x0Du8, 0x0Au8
  ]

  // ==========================================================================
  // R111.M1-002 (paideia-os #2354) bridge fingerprint slots
  // ==========================================================================
  //
  // Assembled on the wire as one line:
  //
  //   "UEFI BRIDGE OK rsdp=0x<16hex> gop=0x<16hex> phys=0x<16hex>\r\n"
  //
  // Emitted in four verify_self_puts calls interleaved with three
  // u64_to_hex calls (each hex chunk is exactly 18 bytes = "0x" + 16
  // nibbles per hex.pdx u64_to_hex contract).  Broken into four
  // constant fragments so the OK-token that trips the fingerprint-
  // coverage gate lands cleanly in _bridge_tag_hdr — the other three
  // separators do not contain "OK" and therefore do not trip the gate.
  // The allowlist entry for the OK marker lives in
  // tools/verify-fingerprint-coverage.sh (Section A, next to
  // "EFI SIGNATURE OK") — retires when R111.M2 opens an OVMF smoke
  // mode that asserts against a live golden.
  //
  // The 20-byte scratch buffer is oversized by 2 (u64_to_hex writes
  // exactly 18 bytes; the trailing 2 are padding for the 8-byte @align).

  //   "UEFI BRIDGE OK"  (14 bytes; contains the OK fingerprint token)
  pub let _bridge_tag_hdr : [u8; 14] = [
    0x55u8, 0x45u8, 0x46u8, 0x49u8, 0x20u8,             // "UEFI "
    0x42u8, 0x52u8, 0x49u8, 0x44u8, 0x47u8, 0x45u8,     // "BRIDGE"
    0x20u8, 0x4Fu8, 0x4Bu8                              // " OK"
  ]

  //   " rsdp="  (6 bytes)
  pub let _bridge_tag_rsdp : [u8; 6] = [
    0x20u8, 0x72u8, 0x73u8, 0x64u8, 0x70u8, 0x3Du8
  ]

  //   " gop="  (5 bytes)
  pub let _bridge_tag_gop : [u8; 5] = [
    0x20u8, 0x67u8, 0x6Fu8, 0x70u8, 0x3Du8
  ]

  //   " phys="  (6 bytes)
  pub let _bridge_tag_phys : [u8; 6] = [
    0x20u8, 0x70u8, 0x68u8, 0x79u8, 0x73u8, 0x3Du8
  ]

  //   CRLF  (2 bytes)
  pub let _bridge_tag_crlf : [u8; 2] = [
    0x0Du8, 0x0Au8
  ]

  // Scratch buffer for u64_to_hex output (18 bytes "0x" + 16 nibbles;
  // 20 rounds to the next 8-byte @align).  Reused across all three
  // hex-emit sites since verify_self_puts consumes the buffer bytes
  // synchronously before we call u64_to_hex again.
  pub let mut _bridge_hex_scratch : [u8; 20] = uninit @align(8)

  // ==========================================================================
  // kernel_main_uefi — the UEFI-path entry point
  // ==========================================================================

  pub let kernel_main_uefi : (u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (env: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {boot, paideia.port_io},
      justification: "R19-M4-003 (#799) + R111-M1-002 (paideia-os #2354). UEFI-path kernel entry. Called with RDI = &boot_env_t (SysV arg 0) by src/boot/uefi_stub.pdx efi_finalize_and_handoff via `push _kernel_main_uefi_pa; ret` after ExitBootServices returns EFI_SUCCESS. Verifies env->magic (BOOT_ENV_MAGIC = 0x564E454244494150, 'PAIDBENV' LE — see src/boot/uefi_env.pdx) via a u64 compare; on mismatch halts in a cli/hlt spin (wrong caller or memory corruption). On match: latches the env pointer into _boot_env_pa, then inlines the canonical NS PC16550D §3.3 COM1 init sequence (7 port writes at 0x3F8..0x3FF) — inlined rather than calling Uart.uart_init because that symbol is linked at higher-half VMA and RIP-relative addressing there is undefined pre-loader (R19.M5). Then walks _msg_kernel_uefi (26 bytes), polling LSR@0x3FD bit 5 (THRE) before each THR@0x3F8 write. Then calls uefi_build_physmap(env) which iterates env->efi_memmap_pa and counts reusable physical extents (result stored in _uefi_physmap_avail_bytes; consumed by R19.M5+). Then calls uefi_physmap_seed_alloc(env) which builds the 128 KiB 4-GiB-coverage phys bitmap (_uefi_phys_bitmap) with a popcnt tally in _uefi_phys_free_pages. Then calls verify_self(env) which reads the .pdxsgn / .pdxsig sections and emits 'EFI SIGNATURE OK' or 'EFI UNSIGNED (enforcement off)' — the R28 measurement-chain witness. R111.M1-002 bridge (previously halted here): emits one 'UEFI BRIDGE OK rsdp=0x<..> gop=0x<..> phys=0x<..>' fingerprint line via four verify_self_puts calls interleaved with three u64_to_hex conversions (rsdp = boot_env+48, gop = boot_env.fb.base_pa = boot_env+16, phys = _uefi_phys_free_pages), then `call kernel_main_64` (KernelMain module, src/kernel/boot/kernel_main.pdx). kernel_main_64 does not return on the nominal path (it enters the scheduler via task_a_entry). If it ever does return, we fall through to the defensive kernel_main_uefi_halt cli/hlt spin. Register discipline: RBX is clobbered across the Phase 3 print loop without a save (the function never returns on the nominal path). Phase 4/4b/4c reload env from _boot_env_pa (avoids RDI ordering hazards across the print loop). The R111 bridge reloads _boot_env_pa on every hex-emit and gates on _boot_env_pa != 0 (defensive — the finalizer always sets it, but a zero read means the field was never latched and we emit hex(0) rather than derefing null). Non-volatile hazard note: rbp is left untouched — no stack frame is set up. Handoff records: (1) _boot_env_pa IS the R20 handoff record — the u64 slot carries the boot_env_t PA and every downstream consumer (Mcfg phase1_acpi_gather, fb_map_lfb, fb_console_init, drivers) reads through it; (2) _uefi_phys_bitmap + _uefi_phys_free_pages are the physmap handoff the R14+ mm/ subsystem consumes via the uefi_phys_seed_free_pages accessor; (3) the ML-DSA-65 measurement chain is preserved by keeping verify_self's log emit ordered BEFORE the bridge fingerprint on the wire.",
      block: {
        // ================================================================
        // Phase 1: magic verification.
        // ================================================================

        mov rax, [rdi + 0];
        mov rcx, 0x564E454244494150;
        cmp rax, rcx;
        jne kernel_main_uefi_halt;

        // Latch env pointer for downstream consumers.
        mov [rip + _boot_env_pa], rdi;

        // ================================================================
        // Phase 2: COM1 16550 init (7 port writes, NS PC16550D §3.3).
        // ================================================================

        mov dx, 0x3F9; mov al, 0x00; out_al al;   // IER off
        mov dx, 0x3FB; mov al, 0x80; out_al al;   // LCR DLAB=1
        mov dx, 0x3F8; mov al, 0x03; out_al al;   // DLL=3 → 115200 baud
        mov dx, 0x3F9; mov al, 0x00; out_al al;   // DLM=0
        mov dx, 0x3FB; mov al, 0x03; out_al al;   // LCR 8N1 (DLAB=0)
        mov dx, 0x3FA; mov al, 0xC7; out_al al;   // FCR enable+clear FIFO
        mov dx, 0x3FC; mov al, 0x0B; out_al al;   // MCR DTR+RTS+OUT2

        // ================================================================
        // Phase 3: emit "UEFI kernel_main entered\r\n" (26 bytes).
        // ================================================================
        //
        // Loop invariants:
        //   rbx  = byte pointer into _msg_kernel_uefi
        //   rcx  = bytes remaining
        //
        // rbx is SysV callee-saved — we're clobbering it, but we haven't
        // pushed it since no-frame is set and we don't return. If a
        // future refactor makes this function return, add push rbx / pop
        // rbx around the loop.

        lea rbx, [rip + _msg_kernel_uefi];
        mov rcx, 26;

      kernel_main_uefi_tx_loop:
        cmp rcx, 0;
        je  kernel_main_uefi_tx_done;

      kernel_main_uefi_tx_poll:
        mov dx, 0x3FD;
        in_al al;
        and rax, 0x20;
        jz  kernel_main_uefi_tx_poll;

        mov al, [rbx];
        mov dx, 0x3F8;
        out_al al;

        add rbx, 1;
        sub rcx, 1;
        jmp kernel_main_uefi_tx_loop;

      kernel_main_uefi_tx_done:

        // ================================================================
        // Phase 4: build physmap from the EFI memory map.
        // ================================================================
        //
        // Reload env from _boot_env_pa (rdi was clobbered during the
        // print loop via the mov dx, imm and mov al, [rbx] chain).

        mov rdi, [rip + _boot_env_pa];
        call uefi_build_physmap;

        // ================================================================
        // Phase 4b (R19.M5, M4-deferred #2): seed the UEFI phys bitmap.
        // ================================================================
        //
        // Companion to uefi_build_physmap — walks the same EFI memmap
        // and sets/clears bits in _uefi_phys_bitmap (128 KiB, 4 GiB
        // coverage) per src/kernel/mm/uefi_phys_seed.pdx. Return value
        // (_uefi_phys_free_pages tally) ignored here; the R20 allocator
        // consumer will read it directly from the .data slot. env reload
        // matches Phase 4's pattern for the same rdi-clobber reason.

        mov rdi, [rip + _boot_env_pa];
        call uefi_physmap_seed_alloc;

        // ================================================================
        // Phase 4c (R28-M1-004 #1001): self-verify the loaded UEFI image.
        // ================================================================
        //
        // verify_self reads image_base/image_size from boot_env_t at
        // env_pa + {56, 64}, walks the .pdxsgn/.pdxpk/.pdxsig sections
        // that tools/sign-efi.sh appended at fixed RVAs, and emits one
        // of two log lines on COM1:
        //
        //   "EFI SIGNATURE OK\r\n"       — .pdxsgn magic present +
        //                                  sig field bytewise zero
        //                                  (R25.M5 dev-bypass rule)
        //   "EFI UNSIGNED (enforcement off)\r\n"
        //                                — sections absent, magic
        //                                  mismatch, or sig non-zero
        //
        // Return value is ignored at R28 (log-only, per
        // VERIFY_SELF_ENFORCE=0 in verify_self.pdx). R33 will halt on
        // fail here when the KEK-enrollment ceremony lands.

        mov rdi, [rip + _boot_env_pa];
        call verify_self;

        // ================================================================
        // Phase 5 (R111-M1-002, paideia-os #2354): kernel_main_64 bridge.
        // ================================================================
        //
        // Emit one fingerprint line, then chain into the R11+ orchestrator.
        // The four verify_self_puts calls and three u64_to_hex calls
        // together lay down:
        //
        //   "UEFI BRIDGE OK rsdp=0x<16hex> gop=0x<16hex> phys=0x<16hex>\r\n"
        //
        // The OK-bearing tag "UEFI BRIDGE OK" is what the fingerprint-
        // coverage gate sees; it is allowlisted alongside "EFI SIGNATURE
        // OK" in tools/verify-fingerprint-coverage.sh (Section A) until
        // R111.M2 opens an OVMF smoke mode with a live golden.
        //
        // Register discipline for the bridge block: every call site
        // reloads its inputs from RIP-relative .data slots, matching the
        // Phase 4/4b/4c convention above.  RDI/RSI/RCX/RDX are clobbered
        // by every callee (verify_self_puts uses rdi/rsi as args plus
        // rax/rcx/rdx for port I/O; u64_to_hex clobbers rax/rcx/rdx/rsi/
        // rdi/r8-r11) — no live register value survives across a call in
        // this block by design.  _bridge_hex_scratch is reused across
        // the three hex-emit sites because verify_self_puts consumes the
        // bytes synchronously before the next u64_to_hex call rewrites
        // the buffer.

        // "UEFI BRIDGE OK"
        lea rdi, [rip + _bridge_tag_hdr];
        mov rsi, 14;
        call verify_self_puts;

        // " rsdp="
        lea rdi, [rip + _bridge_tag_rsdp];
        mov rsi, 6;
        call verify_self_puts;

        // hex(boot_env.rsdp_pa).  Defensive null-guard on _boot_env_pa
        // (the finalizer always latches it in Phase 1; a zero read here
        // means Phase 1 was bypassed and we emit hex(0) rather than
        // dereferencing a null pointer at [0 + 48]).
        mov rdi, [rip + _boot_env_pa];
        cmp rdi, 0;
        je kmu_br_rsdp_zero;
        mov rdi, [rdi + 48];             // BOOT_ENV_OFFSET_RSDP_PA
        jmp kmu_br_rsdp_emit;
      kmu_br_rsdp_zero:
        xor rdi, rdi;
      kmu_br_rsdp_emit:
        lea rsi, [rip + _bridge_hex_scratch];
        call u64_to_hex;
        lea rdi, [rip + _bridge_hex_scratch];
        mov rsi, 18;
        call verify_self_puts;

        // " gop="
        lea rdi, [rip + _bridge_tag_gop];
        mov rsi, 5;
        call verify_self_puts;

        // hex(boot_env.fb.base_pa).  fb sub-struct at BOOT_ENV_OFFSET_FB
        // (=16); fb.base_pa is the first u64 of fb_desc_t (FB_DESC_OFFSET
        // _BASE=0), so absolute offset == 16.  Same null-guard shape.
        mov rdi, [rip + _boot_env_pa];
        cmp rdi, 0;
        je kmu_br_gop_zero;
        mov rdi, [rdi + 16];             // BOOT_ENV_OFFSET_FB + FB_DESC_OFFSET_BASE
        jmp kmu_br_gop_emit;
      kmu_br_gop_zero:
        xor rdi, rdi;
      kmu_br_gop_emit:
        lea rsi, [rip + _bridge_hex_scratch];
        call u64_to_hex;
        lea rdi, [rip + _bridge_hex_scratch];
        mov rsi, 18;
        call verify_self_puts;

        // " phys="
        lea rdi, [rip + _bridge_tag_phys];
        mov rsi, 6;
        call verify_self_puts;

        // hex(_uefi_phys_free_pages).  Populated by uefi_physmap_seed_
        // alloc in Phase 4b above.  Cross-module load — UefiPhysSeed
        // module owns the slot; RIP-relative resolution matches the same
        // cross-module reference discipline this file already uses for
        // uefi_build_physmap and verify_self.
        mov rdi, [rip + _uefi_phys_free_pages];
        lea rsi, [rip + _bridge_hex_scratch];
        call u64_to_hex;
        lea rdi, [rip + _bridge_hex_scratch];
        mov rsi, 18;
        call verify_self_puts;

        // Terminating CRLF for the fingerprint line.
        lea rdi, [rip + _bridge_tag_crlf];
        mov rsi, 2;
        call verify_self_puts;

        // Chain into kernel_main_64 (KernelMain module, src/kernel/boot/
        // kernel_main.pdx).  kernel_main_64 is the R11+ boot orchestrator
        // that installs IDT/TSS/SMEP/SMAP/NX, brings up APIC + LAPIC
        // timer, enumerates PCI, attaches NVMe/xHCI, mounts VFS, and
        // spawns INIT.  Under the PVH boot path it is reached from
        // src/kernel/boot/entry.pdx `_start`; under UEFI this is the
        // first (and now only) call site.  Does not return on the
        // nominal path (enters the scheduler via task_a_entry).
        call kernel_main_64;

        // ================================================================
        // Phase 6: defensive halt (unreachable on the nominal path — the
        // scheduler above never returns; retained so a future refactor
        // that DID return would wedge here rather than fall off the end
        // of the function into whatever pattern the following .text bytes
        // happen to decode as).
        // ================================================================

      kernel_main_uefi_halt:
        cli;
        hlt;
        jmp kernel_main_uefi_halt
      }
    }
}
