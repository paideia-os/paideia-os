// src/kernel/acpi/rsdp.pdx — R20-M1-001 (#805)
//
// RSDP (Root System Description Pointer) discovery — the first step in
// every ACPI bring-up path. paideia-os supports two producers:
//
//   1. UEFI-handoff fast path — the UEFI stub (src/boot/uefi_stub.pdx)
//      walked EFI_SYSTEM_TABLE.ConfigurationTable at pre-EBS time
//      (efi_find_rsdp, #794) and latched the ACPI 2.0 GUID's VendorTable
//      into boot_env_t.rsdp_pa at offset +48 (see src/boot/uefi_env.pdx).
//      The kernel-side walk simply trusts that value when env->magic
//      verifies and env->rsdp_pa is non-zero.
//
//   2. Legacy BIOS fallback — the RSDP was historically anchored in the
//      Extended BIOS Data Area (1 KiB starting at the paragraph pointed
//      to by the u16 at 0x40E) or the 128 KiB BIOS region [0xE0000,
//      0x100000). A 16-byte-aligned scan for the 8-byte "RSD PTR "
//      signature covers both regions (ACPI 6.5 §5.2.5.1). This path is
//      dead under UEFI (env carries the pointer) but retained so a
//      future legacy-BIOS or multiboot-1 boot path can share the same
//      discovery API.
//
// -----------------------------------------------------------------------------
// RSDP layout (ACPI 6.5 §5.2.5.3, RSDP v2 form — 36 bytes)
// -----------------------------------------------------------------------------
//
//   offset  size  name                producer
//   -----------------------------------------------------------------
//   +0x00     8   signature "RSD PTR " (with trailing space)
//   +0x08     1   checksum            firmware — bytes 0..19 sum to 0
//   +0x09     6   OEMID
//   +0x0F     1   revision            0 = ACPI 1.0, 2 = ACPI 2.0+
//   +0x10     4   rsdt_address        legacy 32-bit RSDT pointer
//   +0x14     4   length              full RSDP struct length (v2 only)
//   +0x18     8   xsdt_address        64-bit XSDT pointer (v2 only)
//   +0x20     1   extended_checksum   bytes 0..length-1 sum to 0
//   +0x21     3   reserved
//
// Signature as a little-endian u64: byte[0]='R'=0x52 → bit 7..0,
// byte[7]=' '=0x20 → bit 63..56, yielding 0x2052545020445352 for a
// single u64 compare against the leading 8 bytes.
//
// -----------------------------------------------------------------------------
// Validation
// -----------------------------------------------------------------------------
//
// A candidate that matches the signature must further satisfy:
//   (1) revision >= 2                    — reject ACPI 1.0 (no XSDT)
//   (2) v1 checksum (bytes 0..19 sum-mod-256 == 0)
//   (3) length >= 36                     — malformed if smaller
//   (4) v2 checksum (bytes 0..length-1 sum-mod-256 == 0)
//
// Any failed check causes the scanner to advance to the next 16-byte
// slot rather than returning the candidate — firmware bugs and stray
// "RSD PTR " strings in loader / EBDA scratch space are rare but
// well-documented on real hardware.
//
// -----------------------------------------------------------------------------
// Runtime discipline (M1 scope)
// -----------------------------------------------------------------------------
//
// R20.M1 does NOT wire acpi_find_rsdp into kernel_main / kernel_main_uefi;
// the link-side existence of the symbol is the M1 acceptance witness. Live
// invocation lands with R20.M2+ when MADT parsing arrives and needs a real
// RSDP → XSDT → MADT chain to walk.

module Rsdp = structure {

  // ==========================================================================
  // acpi_rsdp_scan_range — scan [start, start+len) for a valid RSDP v2
  // ==========================================================================
  //
  // SysV: (start: u64, len: u64) -> u64
  //
  //   rdi = start (physical / VA — caller ensures the region is readable)
  //   rsi = byte length of the region
  //
  // Returns rax = address of the first valid RSDP v2 in the region, or 0
  // if no match. "Valid" per §Validation above — sig + revision + both
  // checksums. Stride = 16 bytes (§5.2.5.1 alignment requirement).
  //
  // Kept as a standalone helper so tests and the fallback path in
  // acpi_find_rsdp share the same scanner implementation. Also lets a
  // future consumer (e.g. paravirt vendor extension that anchors the
  // RSDP outside the two legacy regions) reuse the validator without
  // duplicating the sig + checksum logic.
  //
  // Register plan (@no_frame, 3-push callee-save prologue):
  //   r12 = cursor (walks start..end in 16-byte steps)
  //   r13 = end pointer (start + len - 8, last valid signature position)
  //   r14 = "RSD PTR " signature constant (loaded once, compared each iter)
  //   rax = scratch / return value / call return
  //   rdi, rsi = arg-pass to acpi_checksum_ok (clobbered per call)
  //
  // Stack alignment: entry rsp % 16 == 8 (SysV). 3 pushes = 24 B, giving
  // rsp % 16 == 0 pre-call, so the CPU's `call` push lands the callee at
  // rsp % 16 == 8 as SysV requires. No sub rsp,8 pad needed for the
  // nested acpi_checksum_ok calls.

  pub let acpi_rsdp_scan_range : (u64, u64) -> u64 !{mem} @{} =
    fn (start: u64, len: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M1-001 (#805). Bounded RSDP v2 scanner over an arbitrary [start, start+len) memory region. Iterates in 16-byte strides (ACPI 6.5 §5.2.5.1 mandated alignment), compares the 8-byte signature at cursor+0 against 'RSD PTR ' (LE u64 0x2052545020445352), then validates every candidate: (1) revision byte at cursor+15 >= 2 (rejects ACPI 1.0 RSDPs which lack an XSDT — R20 requires XSDT); (2) v1 checksum via acpi_checksum_ok(cursor, 20); (3) length field at cursor+20 (u32) >= 36 (malformed if smaller); (4) v2 extended checksum via acpi_checksum_ok(cursor, length). Any failure jumps to `scan_next`, advancing the cursor by 16. First fully-validated candidate returned in rax. Not-found path returns 0 (caller decides whether that's fatal). Stack discipline: 3-push callee-save prologue (r12=cursor, r13=end, r14=sig-constant) yields rsp%16==0 pre-nested-call, so the two acpi_checksum_ok invocations land the callee at the SysV-required rsp%16==8 without needing a sub rsp,8 pad. Length-underflow guard (`cmp rsi, 8; jb scan_notfound`) short-circuits pathological zero/tiny regions; the end computation `end = start + len - 8` is then safe. u32 length load uses `mov eax, [r12+20]` inside `xor rax, rax` for explicit zero-extension into the 64-bit compare (defensive against future paideia-as encoder churn around implicit-zero-extension of 32-bit destinations — matches libc_test.pdx idiom). Leaf callee reg-usage: acpi_checksum_ok is documented as touching only rax/rcx/rdi/rsi — r12/r13/r14 survive across it without our own re-loading.",
      block: {
        push r12;
        push r13;
        push r14;

        // Guard: len < 8 → no possible signature match.
        cmp rsi, 8;
        jb  acpi_rsdp_scan_range_notfound;

        // end = start + len - 8 (last valid signature start position)
        mov r13, rdi;
        add r13, rsi;
        sub r13, 8;

        mov r12, rdi;                        // cursor = start
        mov r14, 0x2052545020445352;         // "RSD PTR " LE

      acpi_rsdp_scan_range_loop:
        cmp r12, r13;
        ja  acpi_rsdp_scan_range_notfound;

        // Signature compare.
        mov rax, [r12];
        cmp rax, r14;
        jne acpi_rsdp_scan_range_next;

        // (1) revision >= 2
        xor rax, rax;
        mov_b rax, [r12 + 15];
        cmp rax, 2;
        jb  acpi_rsdp_scan_range_next;

        // (2) v1 checksum (bytes 0..19)
        mov rdi, r12;
        mov rsi, 20;
        call acpi_checksum_ok;
        cmp rax, 1;
        jne acpi_rsdp_scan_range_next;

        // (3) length >= 36
        xor rax, rax;
        mov eax, [r12 + 20];
        cmp rax, 36;
        jb  acpi_rsdp_scan_range_next;

        // (4) v2 extended checksum (bytes 0..length-1)
        mov rdi, r12;
        xor rsi, rsi;
        mov esi, [r12 + 20];
        call acpi_checksum_ok;
        cmp rax, 1;
        jne acpi_rsdp_scan_range_next;

        // All checks passed — return the candidate.
        mov rax, r12;
        jmp acpi_rsdp_scan_range_return;

      acpi_rsdp_scan_range_next:
        add r12, 16;
        jmp acpi_rsdp_scan_range_loop;

      acpi_rsdp_scan_range_notfound:
        xor rax, rax;

      acpi_rsdp_scan_range_return:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // acpi_find_rsdp — dispatch: UEFI fast path → legacy EBDA → legacy BIOS
  // ==========================================================================
  //
  // SysV: (env: u64) -> u64
  //
  //   rdi = pointer to a boot_env_t (may be 0 if caller has no boot env,
  //         e.g. legacy BIOS boot or test harness invoking the scanner
  //         directly).
  //
  // Returns rax = RSDP physical address, or 0 if none found.
  //
  // Fast path:
  //   env != 0 && env->magic == BOOT_ENV_MAGIC && env->rsdp_pa != 0
  //     → return env->rsdp_pa (trust UEFI's efi_find_rsdp result)
  //
  // Legacy path (fallback if the fast path bails at any check):
  //   1. Read EBDA base = *(u16*)0x40E << 4 (paragraph → byte).
  //      If non-zero, scan [ebda_base, ebda_base+1024) via acpi_rsdp_scan_range.
  //   2. If still 0, scan [0xE0000, 0x100000) via acpi_rsdp_scan_range.
  //
  // Nested-call alignment: no callee-save pushes, so we sit at rsp%16==8
  // at every internal point. Each `call acpi_rsdp_scan_range` is bracketed
  // with `sub rsp, 8` / `add rsp, 8` to land the callee at rsp%16==8 per
  // SysV.
  //
  // The BOOT_ENV_MAGIC literal (0x564E454244494150 = "PAIDBENV" LE) is
  // duplicated from src/boot/uefi_env.pdx and kernel_main_uefi.pdx rather
  // than symbolically referenced — same idiom as the existing verifier in
  // kernel_main_uefi.pdx L113; centralising the magic into a cross-module
  // symbol needs a paideia-as let-inlining pass that isn't landed yet.

  pub let acpi_find_rsdp : (u64) -> u64 !{mem} @{} =
    fn (env: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M1-001 (#805). Top-level RSDP discovery entry. Two-stage dispatch: (Fast) if env non-null AND env->magic == BOOT_ENV_MAGIC (0x564E454244494150, 'PAIDBENV' LE, matches src/boot/uefi_env.pdx L120 + kernel_main_uefi.pdx L113 verifier) AND env->rsdp_pa (u64 @ +48) != 0, return env->rsdp_pa verbatim. This is the UEFI path — the RSDP was located pre-EBS by efi_find_rsdp (#794) walking EFI_SYSTEM_TABLE.ConfigurationTable for the ACPI 2.0 GUID (see src/boot/uefi_acpi.pdx). (Legacy) any fast-path check fails → scan the two BIOS-reserved regions: (a) EBDA — u16 paragraph pointer at 0x40E, shifted left 4 to get byte address, scan 1 KiB starting there (only if the paragraph is non-zero — a zero at 0x40E means firmware never populated it, e.g. UEFI-CSM disabled); (b) if EBDA scan comes back 0, scan [0xE0000, 0x100000) (128 KiB) — the ACPI 6.5 §5.2.5.1-defined BIOS extended region. Both scans dispatch to acpi_rsdp_scan_range which implements the sig + revision + dual-checksum validator. Under UEFI at R19 close the legacy path is unreachable (env always non-null, magic verified, rsdp_pa always populated by #794); the legacy path exists for future BIOS / multiboot-1 boot flows and matches existing r20 kernel-side design (see design/roadmap/r18-plus-bare-metal.md §R20). Stack: @no_frame — no callee-save reg touched, both nested calls bracketed with sub/add rsp,8 pad. EBDA u16 read uses xor rax,rax + mov_w rax,[rcx] idiom (same as kernel/mm zero-extend pattern) to avoid mov_w partial-register hazard. Legacy fallback runs sequentially — first hit wins; the second scan is skipped if EBDA scan returns non-zero.",
      block: {
        // ================================================================
        // Fast path: UEFI-latched pointer.
        // ================================================================

        cmp rdi, 0;
        je  acpi_find_rsdp_legacy_ebda;

        mov rax, [rdi + 0];                  // env->magic
        mov rcx, 0x564E454244494150;         // BOOT_ENV_MAGIC ("PAIDBENV" LE)
        cmp rax, rcx;
        jne acpi_find_rsdp_legacy_ebda;

        mov rax, [rdi + 48];                 // env->rsdp_pa
        cmp rax, 0;
        je  acpi_find_rsdp_legacy_ebda;

        // Fast-path success — return env->rsdp_pa (already in rax).
        ret;

        // ================================================================
        // Legacy path 1: EBDA at *(u16*)0x40E << 4, length 1 KiB.
        // ================================================================

      acpi_find_rsdp_legacy_ebda:
        mov rcx, 0x40E;
        xor rax, rax;
        mov_w rax, [rcx];                    // rax = EBDA paragraph
        shl rax, 4;                          // convert to byte address
        cmp rax, 0;
        je  acpi_find_rsdp_legacy_bios;

        mov rdi, rax;
        mov rsi, 1024;
        sub rsp, 8;                          // align to 16 pre-call
        call acpi_rsdp_scan_range;
        add rsp, 8;
        cmp rax, 0;
        jne acpi_find_rsdp_done;

        // ================================================================
        // Legacy path 2: BIOS [0xE0000, 0x100000).
        // ================================================================

      acpi_find_rsdp_legacy_bios:
        mov rdi, 0xE0000;
        mov rsi, 0x20000;                    // 128 KiB
        sub rsp, 8;
        call acpi_rsdp_scan_range;
        add rsp, 8;

      acpi_find_rsdp_done:
        ret
      }
    } @no_frame
}
