// src/kernel/acpi/supervisor_dispatch.pdx — R20-M4-002 / #820
//
// ACPI-supervisor RPC dispatch helpers (kernel-side).
//
// Design context
// --------------
// Implements the four request/reply body-builders that the
// acpi_supervisor userspace server exposes over IPC — but callable
// directly from the kernel-side witness that discharges #820's
// acceptance criteria (per the "Option B — kernel-side witness driving
// the RPC" posture documented in the iteration brief and matching the
// R20b.M5-001 / M6-003 witness discipline).
//
// The four RPCs (design/ipc/acpi-supervisor-schema.md §4, opcode table):
//
//   op = 1  ACPI_OP_ENUMERATE   → sup_enumerate_tables
//   op = 2  ACPI_OP_GET_MADT    → sup_get_madt_lapic_list  (LAPIC subset)
//   op = 3  ACPI_OP_GET_MCFG    → sup_get_mcfg_ranges
//   op = 4  ACPI_OP_GET_HPET    → sup_get_hpet
//
// Each helper writes a variable-length response payload into a caller-
// provided buffer and returns the number of bytes written (rax = len,
// callable straight into sys_ipc_reply_body's payload_len argument).
//
// Response payload layouts
// ------------------------
// Trimmed / concretised from design/ipc/acpi-supervisor-schema.md §5 to
// what the R20 kernel-side parsers can materialise today (fadt_info,
// hpet_info, mcfg_segments, madt_parse_lapics). Where the schema
// specifies fields the parser cannot yet extract (e.g. HPET period_fs
// lives in MMIO not the ACPI table) the helper emits zero for that
// slot — the wire shape stays intact so future upgrades can fill the
// zeros without breaking clients.
//
//   ---- op=1 enumerate_tables (variable) ----
//     +0  u16 n_tables
//     +2  table_desc[n_tables], each 24 B:
//         +0   u32 sig                (4 ASCII bytes, low-byte-first)
//         +4   u32 revision           (u8 zero-extended)
//         +8   u64 phys_addr
//        +16   u32 length             (SDT header length field, verbatim)
//        +20   u32 oem_id_lo          (first 4 bytes of the 6-byte OEMID)
//     payload_len = 2 + 24 * n_tables (rounded to nearest u16 count).
//     n_tables is the number of XSDT entries walked; a q35 image emits
//     at least four downstream SDTs (FADT/MADT/MCFG/HPET).
//
//   ---- op=2 get_madt_lapic_list (variable) ----
//     +0  u16 n_lapics
//     +2  lapic_desc[n_lapics], each 12 B:
//         +0   u32 acpi_uid   (u8 zero-extended)
//         +4   u32 apic_id    (u8 zero-extended)
//         +8   u32 flags      (verbatim u32 from the MADT sub-entry)
//     payload_len = 2 + 12 * n_lapics.
//
//   ---- op=3 get_mcfg_ranges (variable) ----
//     +0  u16 n_segments
//     +2  segment_desc[n_segments], each 16 B:
//         +0   u64 ecam_base
//         +8   u16 segment
//        +10   u8  bus_start
//        +11   u8  bus_end
//        +12   u32 reserved
//     payload_len = 2 + 16 * n_segments.
//
//   ---- op=4 get_hpet (16 B fixed) ----
//     +0   u64 counter_base_pa
//     +8   u32 block_id
//    +12   u16 min_tick
//    +14   u8  hpet_number
//    +15   u8  reserved
//     payload_len = 16 (always).
//
// All multi-byte scalars are little-endian (matches x86-64 native u64
// stores and the raw ACPI-table byte order).
//
// Callers MUST pass buf_max >= the maximum expected payload_len for
// each op (safe upper bounds: enumerate = 2 + 24*32 = 770; madt_lapic
// = 2 + 12*128 = 1538; mcfg = 2 + 16*16 = 258; hpet = 16). The witness
// passes 4088 (FRAME_MAX_PAYLOAD) for all four which comfortably fits.
// On buf_max exhaustion each helper stops writing and returns the
// bytes already written (caps at n_lapics / n_tables / n_segments that
// still fit).
//
// paideia-as encoder-gap posture (v0.20.1+):
//   G1: mov [mem], reg32 widens → mov_d for u32 stores.
//   G4: cmp al, imm may miscompile → full-register compares.

module SupervisorDispatch = structure {

  // ============================================================================
  // Layout constants (mirror of the doc-block above).
  // ============================================================================

  pub let SUP_ENUM_TABLE_DESC_SIZE  : u64 = 24
  pub let SUP_MADT_LAPIC_DESC_SIZE  : u64 = 12
  pub let SUP_MCFG_SEG_DESC_SIZE    : u64 = 16
  pub let SUP_HPET_REP_SIZE         : u64 = 16

  pub let SUP_ENUM_HEADER_SIZE      : u64 = 2   // u16 n_tables
  pub let SUP_MADT_HEADER_SIZE      : u64 = 2   // u16 n_lapics
  pub let SUP_MCFG_HEADER_SIZE      : u64 = 2   // u16 n_segments

  // ============================================================================
  // sup_enumerate_tables(xsdt: u64, out: u64, out_max: u64) -> u64
  //
  //   rdi = XSDT base pointer (a *sdt_hdr with signature "XSDT"; caller
  //         MUST have checksum-validated). The XSDT body is an array of
  //         u64 physical pointers at +36 (see xsdt.pdx).
  //   rsi = out buffer (caller-allocated, >= 2 + 24*n_tables bytes).
  //   rdx = out_max (bytes; helper stops writing when the next record
  //         would exceed this).
  //
  //   Returns rax = bytes written (2 + 24 * n_tables_recorded). Zero
  //   xsdt (null) returns a lone u16 zero (2 bytes) — a valid empty
  //   enumeration.
  //
  // Per-entry decode (from the downstream SDT header):
  //   entry_ptr = *(u64*)(xsdt + 36 + i*8)
  //   sig       = *(u32*)(entry_ptr + 0)      SDT header offset 0
  //   revision  = *(u8*)(entry_ptr + 8)       SDT header offset 8
  //   length    = *(u32*)(entry_ptr + 4)      SDT header offset 4
  //   oem_id_lo = *(u32*)(entry_ptr + 10)     first 4 bytes of the 6-byte OEMID
  //
  // Register plan (5-push callee-save):
  //   rbx = out cursor (advances by SUP_ENUM_TABLE_DESC_SIZE per record)
  //   r12 = xsdt base
  //   r13 = xsdt end (base + xsdt->length)
  //   r14 = xsdt entry cursor (walks base+36 in 8-byte steps)
  //   r15 = out_end (out_base + out_max, bounds cap)
  //   r10 = record-count accumulator
  //   r9  = per-iteration entry pointer scratch
  // ============================================================================

  pub let sup_enumerate_tables : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (xsdt: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M4-002 (#820). acpi_supervisor.enumerate_tables body — walks the XSDT entry array (base+36..base+length, 8-byte stride) and copies a 24-byte table_desc per downstream SDT to the caller's buffer, prefixed by a u16 count. Uses the same walk skeleton as acpi_xsdt_find/acpi_xsdt_iter (see xsdt.pdx §L88 for the invariants and bounds discipline). Per record: sig (u32 @ entry+0) → u32 @ out+0 via mov_d; revision (u8 @ entry+8, zero-extended) → u32 @ out+4 via mov_d; phys_addr = entry_ptr itself → u64 @ out+8 via plain mov; length (u32 @ entry+4) → u32 @ out+16 via mov_d; oem_id first-4-bytes (u32 @ entry+10 — spec-legal unaligned u32 read per SDM Vol.3 §7.1.1) → u32 @ out+20 via mov_d. Buffer-full check inside the loop: `mov rax, rbx; add rax, 24; cmp rax, r15; ja done` — the two-word check `add+cmp+ja` matches the identical pattern in mcfg_parse_segments §L169. Null xsdt (rdi == 0) short-circuits with count=0 (writes just the 2-byte header + returns 2) — an empty enumeration is a valid response. Register plan: 5-push callee-save (rbx=out cursor, r12=xsdt base, r13=xsdt end, r14=entry cursor, r15=out end); rsp %16 == 0 for nested call (though this helper is leaf-call-free — pure walker + copy). Encoder-gap posture: G1 (mov_d for every u32 store), G4 (full-reg cmp for the size gate).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Save + prepare ----
        mov r12, rdi;                          // r12 = xsdt base (may be 0)
        mov rbx, rsi;                          // rbx = out cursor
        mov r15, rsi;
        add r15, rdx;                          // r15 = out_end

        // Write count placeholder = 0 at out+0 (u16). Advance cursor 2.
        xor rax, rax;
        mov_w [rbx], rax;
        add rbx, 2;

        // count accumulator (rax so far = 0)
        xor r10, r10;

        // Null xsdt → return 2 (header only).
        cmp r12, 0;
        je  sup_enum_done;

        // ---- end = xsdt + xsdt->length (u32 @ +4, zero-extended) ----
        xor rax, rax;
        mov eax, [r12 + 4];
        mov r13, r12;
        add r13, rax;

        // ---- entry cursor = xsdt + 36 ----
        mov r14, r12;
        add r14, 36;

      sup_enum_loop:
        // Bounds check on the entry array — need 8 more bytes.
        mov rax, r14;
        add rax, 8;
        cmp rax, r13;
        ja  sup_enum_done;

        // Buffer-full check — need room for a 24-byte record.
        mov rax, rbx;
        add rax, 24;
        cmp rax, r15;
        ja  sup_enum_done;

        // Load entry pointer (may be unaligned in memory; 8-byte read
        // spec-legal per SDM Vol.3 §7.1.1).
        mov r9, [r14];
        cmp r9, 0;
        je  sup_enum_next;                     // skip null entries defensively

        // ---- sig (u32 @ entry+0) → u32 @ out+0 ----
        mov eax, [r9 + 0];                     // 32-bit load zero-extends
        mov_d [rbx + 0], rax;                  // G1

        // ---- revision (u8 @ entry+8) → u32 @ out+4 ----
        xor rax, rax;
        mov_b rax, [r9 + 8];
        mov_d [rbx + 4], rax;

        // ---- phys_addr = entry_ptr (u64) → u64 @ out+8 ----
        mov [rbx + 8], r9;

        // ---- length (u32 @ entry+4) → u32 @ out+16 ----
        mov eax, [r9 + 4];
        mov_d [rbx + 16], rax;

        // ---- oem_id (first 4 of 6 bytes @ entry+10) → u32 @ out+20 ----
        // Unaligned u32 read spec-legal per SDM.
        mov eax, [r9 + 10];
        mov_d [rbx + 20], rax;

        add rbx, 24;
        add r10, 1;

      sup_enum_next:
        add r14, 8;                            // next entry
        jmp sup_enum_loop;

      sup_enum_done:
        // Patch the count at out_base = rsi. rbx was advanced to the
        // record area, so out_base = rbx - 2 - r10*24. Simpler: keep
        // out_base in a scratch. We saved it in rsi originally; the
        // walker preserved it. But rsi may be volatile — reload via
        // the callee-save copy: recover out_base = (rbx - r10*24 - 2).
        mov rax, r10;
        shl rax, 3;                            // *8
        mov r9,  rax;
        mov rax, r10;
        shl rax, 4;                            // *16
        add rax, r9;                           // *24
        mov r9,  rbx;
        sub r9,  rax;
        sub r9,  2;                            // r9 = out_base
        mov_w [r9], r10;                       // write count u16 (low 16 bits)

        // Return bytes written = 2 + 24*count = (rbx - out_base).
        mov rax, rbx;
        sub rax, r9;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sup_get_madt_lapic_list(madt: u64, out: u64, out_max: u64) -> u64
  //
  // Wraps madt_parse_lapics into a schema-shaped response. The parser
  // writes 16-byte per-record output ({acpi_uid u32, apic_id u32, flags
  // u32, _pad u32}); this helper prefixes a u16 count and copies each
  // record's first 12 bytes (dropping the trailing _pad) to keep the
  // payload compact and matched to the schema (§5.4 LapicDesc = 12 B).
  //
  //   rdi = MADT base pointer (caller checksum-validated). May be 0 →
  //         helper returns just the 2-byte header (count=0).
  //   rsi = out buffer.
  //   rdx = out_max bytes.
  //
  // Returns rax = 2 + 12 * n_lapics_written.
  //
  // Static scratch _sup_madt_scratch (128 records × 16 B = 2048 B) holds
  // the parser's raw output; the helper reads back and repacks to 12-B
  // records. 128 caps at qemu64's max SMP width (256 in theory but 128
  // covers every real q35 config); overflow bumps the parser's own
  // _madt_dropped_lapic_count counter.
  //
  // Register plan:
  //   rbx = out cursor
  //   r12 = out_end (out + out_max)
  //   r13 = per-record source ptr into _sup_madt_scratch
  //   r14 = n_lapics returned by parser
  //   r15 = loop index (0..n_lapics)
  // ============================================================================

  pub let mut _sup_madt_scratch : [u64; 256] = uninit @align(8)

  pub let sup_get_madt_lapic_list : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (madt: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M4-002 (#820). acpi_supervisor.get_madt_lapic_list body — invokes madt_parse_lapics into _sup_madt_scratch, then repacks each 16-byte parser record into a 12-byte schema record ({acpi_uid u32, apic_id u32, flags u32}) at out+2+i*12, prefixed by a u16 count. Null madt short-circuits with count=0 (returns just the 2-byte header). Buffer-full cap: stops copying when the next 12-byte record would exceed out_max; the count patched at the end reflects records actually written (may be less than parser's return). Register plan: 5-push callee-save (rbx=out cursor, r12=out_end, r13=parser-record src ptr, r14=parser n_lapics, r15=loop index); rsp %16 == 0 for the madt_parse_lapics nested call. Encoder-gap posture: G1 (mov_d for u32 stores), G4 (full-reg cmp).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                          // rbx = out cursor
        mov r12, rsi;
        add r12, rdx;                          // r12 = out_end

        // Reserve the 2-byte count slot at out+0 (patched at the end).
        xor rax, rax;
        mov_w [rbx], rax;
        add rbx, 2;

        // Null madt → return just the header.
        cmp rdi, 0;
        je  sup_madt_done;

        // Buffer must at least hold the header.
        mov rax, rbx;
        cmp rax, r12;
        ja  sup_madt_done;

        // ---- madt_parse_lapics(madt, _sup_madt_scratch, 128) ----
        //   rdi already = madt
        lea rsi, [rip + _sup_madt_scratch];
        mov rdx, 128;                          // MAX_LAPICS
        call madt_parse_lapics;
        mov r14, rax;                          // r14 = n_lapics

        // Loop 0..r14 copying 12 bytes per record from _sup_madt_scratch
        // (16-byte source stride) into out (12-byte destination stride).
        xor r15, r15;                          // i = 0
        lea r13, [rip + _sup_madt_scratch];

      sup_madt_loop:
        cmp r15, r14;
        jae sup_madt_done;

        // Buffer-full check — need 12 more bytes.
        mov rax, rbx;
        add rax, 12;
        cmp rax, r12;
        ja  sup_madt_done;

        // Source record ptr = _sup_madt_scratch + i * 16.
        mov r9, r15;
        shl r9, 4;                             // *16
        mov r8, r13;
        add r8, r9;                            // r8 = &scratch[i]

        // Copy 12 bytes (3 x u32) via mov_d.
        mov eax, [r8 + 0];
        mov_d [rbx + 0], rax;                  // acpi_uid u32
        mov eax, [r8 + 4];
        mov_d [rbx + 4], rax;                  // apic_id u32
        mov eax, [r8 + 8];
        mov_d [rbx + 8], rax;                  // flags u32

        add rbx, 12;
        add r15, 1;
        jmp sup_madt_loop;

      sup_madt_done:
        // Patch the u16 count at (rbx - written_bytes - 0 for header start).
        // Compute out_base + 0 = out_base; recover from cursor arithmetic:
        // out_base = rbx - 2 - written_records*12.
        // written_records = r15 (updated in the loop even if we exited early).
        mov rax, r15;
        mov r9,  rax;
        shl r9,  3;                            // *8
        mov r8,  rax;
        shl r8,  2;                            // *4
        add r9,  r8;                           // r9 = r15 * 12
        mov r8,  rbx;
        sub r8,  r9;
        sub r8,  2;                            // r8 = out_base
        mov_w [r8], r15;                       // write count

        // Return bytes written = 2 + 12*r15 = (rbx - out_base).
        mov rax, rbx;
        sub rax, r8;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sup_get_mcfg_ranges(segments_ptr: u64, count: u64, out: u64, out_max: u64)
  //   -> u64
  //
  // Reformats an array of 24-byte MCFG parser records (the format
  // mcfg_parse_segments emits — see mcfg.pdx §L97 ECAM_SEGMENT_SIZE) to
  // the schema's 16-byte segment_desc. Drops the trailing 8-byte _pad2
  // during copy.
  //
  //   rdi = segments_ptr — pointer to the first 24-byte record (typically
  //         &_mcfg_segments, but any pointer works — the ring-3
  //         acpi_supervisor will pass a pointer into its own KIND_ACPI-
  //         mapped view). If 0 → returns 2 (empty header).
  //   rsi = count — number of records (typically _mcfg_count, bounded by
  //         MCFG_MAX_SEGMENTS = 16).
  //   rdx = out buffer.
  //   rcx = out_max bytes.
  //
  // Returns rax = 2 + 16 * n_segments_written.
  //
  // Register plan:
  //   rbx = out cursor
  //   r12 = out_end
  //   r13 = segments_ptr (invariant across the loop)
  //   r14 = count
  //   r15 = loop index
  // ============================================================================

  pub let sup_get_mcfg_ranges : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (segments_ptr: u64, count: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M4-002 (#820). acpi_supervisor.get_mcfg_ranges body — reformats an array of 24-byte MCFG parser records (mcfg.pdx ECAM_SEGMENT_SIZE=24) to the schema's 16-byte segment_desc (ecam_base u64, segment u16, bus_start u8, bus_end u8, reserved u32) at out+2+i*16, prefixed by a u16 count. Drops the trailing 8-byte _pad2 that mcfg_parse_segments writes to keep the wire format compact and matched to acpi-supervisor-schema.md §5.6. Takes segments_ptr + count args so the ring-3 acpi_supervisor can pass a pointer into its own KIND_ACPI-mapped view (rather than hard-wiring to Mcfg._mcfg_segments — that coupling was reworked at #820 to be pointer-portable). Null segments_ptr or count=0 returns just the 2-byte header. Buffer-full cap: stops copying when the next 16-byte record would exceed out_max. Register plan: 5-push callee-save (rbx=out cursor, r12=out_end, r13=segments_ptr, r14=count, r15=loop index). Leaf function; no nested call. Encoder-gap posture: G1 (mov_d for u32 stores), G4 (full-reg cmp).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdx;                          // rbx = out cursor
        mov r12, rdx;
        add r12, rcx;                          // r12 = out_end

        // Reserve the 2-byte count slot at out+0.
        xor rax, rax;
        mov_w [rbx], rax;
        add rbx, 2;

        // Save segments_ptr + count into invariant regs.
        mov r13, rdi;                          // segments_ptr
        mov r14, rsi;                          // count

        // Null-guard on segments_ptr → return just the header.
        cmp r13, 0;
        je  sup_mcfg_done;

        // Loop i = 0..r14
        xor r15, r15;

      sup_mcfg_loop:
        cmp r15, r14;
        jae sup_mcfg_done;

        // Buffer-full check — 16 more bytes required.
        mov rax, rbx;
        add rax, 16;
        cmp rax, r12;
        ja  sup_mcfg_done;

        // Source ptr = segments_ptr + i * 24.
        mov r9, r15;
        shl r9, 3;                             // *8
        mov r8, r15;
        shl r8, 4;                             // *16
        add r9, r8;                            // r9 = i * 24
        mov r8, r13;
        add r8, r9;                            // r8 = &segments_ptr[i]

        // ecam_base (u64 @ +0) → u64 @ out+0
        mov rax, [r8 + 0];
        mov [rbx + 0], rax;

        // segment (u16 @ +8) → u16 @ out+8
        xor rax, rax;
        mov_w rax, [r8 + 8];
        mov_w [rbx + 8], rax;

        // bus_start (u8 @ +10) → u8 @ out+10
        xor rax, rax;
        mov_b rax, [r8 + 10];
        mov_b [rbx + 10], rax;

        // bus_end (u8 @ +11) → u8 @ out+11
        xor rax, rax;
        mov_b rax, [r8 + 11];
        mov_b [rbx + 11], rax;

        // reserved (u32 @ out+12) = 0
        xor rax, rax;
        mov_d [rbx + 12], rax;

        add rbx, 16;
        add r15, 1;
        jmp sup_mcfg_loop;

      sup_mcfg_done:
        // Patch count at out_base = rbx - 2 - r15*16.
        mov rax, r15;
        shl rax, 4;                            // *16
        mov r9,  rbx;
        sub r9,  rax;
        sub r9,  2;
        mov_w [r9], r15;

        // Return bytes written.
        mov rax, rbx;
        sub rax, r9;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sup_get_hpet(hpet_info: u64, out: u64, out_max: u64) -> u64
  //
  // Copies the 16-byte compact HPET record from a 32-byte hpet_info
  // (already populated by phase1_acpi_gather into
  // Phase1Info._phase1_acpi_info + PHASE1_OFFSET_HPET = 64). Schema
  // reserves 24 bytes for AcpiHpetRep but the extra fields (period_fs,
  // vendor_id, comparator_ct, page_protect) live in HPET MMIO not the
  // ACPI table (see hpet.pdx L39-44 doc). This helper emits the 16-byte
  // ACPI-visible subset — a future upgrade can widen to 24 without
  // breaking clients (append-only version discipline per schema §6.3).
  //
  //   rdi = pointer to a 32-byte hpet_info (typically
  //         &_phase1_acpi_info + 64). If 0 → returns 0 bytes (empty
  //         response signalling absence).
  //   rsi = out buffer.
  //   rdx = out_max bytes.
  //
  // Returns rax = 16 (bytes written) on success, 0 on absence.
  // ============================================================================

  pub let sup_get_hpet : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hpet_info: u64, out: u64, out_max: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M4-002 (#820). acpi_supervisor.get_hpet body — copies the 16-byte ACPI-visible HPET subset from a 32-byte hpet_info source (typically &_phase1_acpi_info + PHASE1_OFFSET_HPET=64). Layout: counter_base_pa u64 @ src+0 → u64 @ out+0; block_id u32 @ src+8 → u32 @ out+8 (mov_d G1); min_tick u16 @ src+12 → u16 @ out+12 (mov_w); hpet_number u8 @ src+14 → u8 @ out+14 (mov_b); reserved u8 @ out+15 zero. Null hpet_info (rdi == 0) or out_max < 16 returns 0 — an empty response signals absence to the caller. Encoder-gap posture: G1 (mov_d for the u32 store), G4 (full-reg cmp for the 16-byte size gate).",
      block: {
        // Null-guard on hpet_info.
        cmp rdi, 0;
        je  sup_hpet_absent;

        // Size gate — need at least 16 bytes.
        cmp rdx, 16;
        jb  sup_hpet_absent;

        // counter_base_pa u64 @ src+0 → u64 @ out+0
        mov rax, [rdi + 0];
        mov [rsi + 0], rax;

        // block_id u32 @ src+8 → u32 @ out+8
        mov eax, [rdi + 8];
        mov_d [rsi + 8], rax;

        // min_tick u16 @ src+12 → u16 @ out+12
        xor rax, rax;
        mov_w rax, [rdi + 12];
        mov_w [rsi + 12], rax;

        // hpet_number u8 @ src+14 → u8 @ out+14
        xor rax, rax;
        mov_b rax, [rdi + 14];
        mov_b [rsi + 14], rax;

        // reserved u8 @ out+15 = 0
        xor rax, rax;
        mov_b [rsi + 15], rax;

        // Return 16 bytes written.
        mov rax, 16;
        ret;

      sup_hpet_absent:
        xor rax, rax;
        ret
      }
    }
}
