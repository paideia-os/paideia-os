// src/kernel/acpi/xsdt.pdx — R20-M1-002 (#806)
//
// XSDT (Extended System Description Table) walker. The XSDT is the root
// index that every other ACPI static table (MADT, MCFG, FADT, HPET, ...)
// is discovered through: its body — everything past the 36-byte sdt_hdr
// prefix — is an array of 64-bit physical pointers, each targeting a
// downstream table whose first 4 bytes identify its type via a signature.
//
// R20.M1 delivers two entry points:
//
//   acpi_xsdt_find(xsdt, sig) → hdr | 0
//     Linear scan for the first entry whose target's signature matches
//     the requested SIG4. Returns the target pointer (a *sdt_hdr) or 0
//     if no match. Callers typically dispatch on SIG_APIC (→ MADT),
//     SIG_MCFG, SIG_FACP, SIG_HPET — see sdt_hdr.pdx §SIG4 constants.
//
//   acpi_xsdt_iter(xsdt, callback)
//     Full enumeration: for each entry, invoke callback(hdr, sig) where
//     hdr is the target table pointer and sig is its 4-byte signature
//     (zero-extended to u64). Used by fingerprinting / logging passes
//     that need to visit every table without dispatching by name.
//
// -----------------------------------------------------------------------------
// Entry-array layout
// -----------------------------------------------------------------------------
//
// XSDT header occupies bytes [0, 36); entries occupy [36, length). Each
// entry is a u64 physical pointer. Entry count is (length - 36) / 8. The
// entries begin at offset 36 — 4-byte aligned relative to a natural u64
// boundary. x86-64 tolerates unaligned 8-byte reads (SDM Vol.3 §7.1.1;
// perf penalty but no fault), so `mov rax, [entry_ptr]` on a 4-aligned
// address is spec-legal. Firmware in the wild almost always aligns the
// XSDT itself to a 4 KiB page boundary, which shifts entries to 4-aligned
// but never worse.
//
// -----------------------------------------------------------------------------
// Cross-repo note (#806 label: cross-repo:paideia-as-blocked)
// -----------------------------------------------------------------------------
//
// The issue was preemptively labeled 'cross-repo:paideia-as-blocked' with
// the note "Slice<u8> for typed table body (v0.22)". That gap targets a
// v0.22 typed-slice source-language feature for iterating each downstream
// table's body once R20.M2+ starts parsing them (MADT sub-entries, MCFG
// segment groups, etc.). R20.M1 does not need it — the walker itself only
// does raw u64-pointer arithmetic plus a 4-byte signature load, both of
// which are proven paideia-as v0.20 idioms (see uefi_physmap.pdx pointer-
// stride loop for the same shape and vops.pdx `call rax` for indirect
// dispatch). No paideia-as escalation for M1; the slice gap will surface
// when R20.M2's MADT parser tries to walk sub-entries typedly.

module Xsdt = structure {

  // ==========================================================================
  // acpi_xsdt_find — linear scan by signature
  // ==========================================================================
  //
  // SysV: (xsdt: u64, sig: u64) -> u64
  //
  //   rdi = pointer to a valid XSDT (36-byte sdt_hdr + N u64 entries).
  //         Caller MUST have checksummed the XSDT header via
  //         acpi_checksum_ok(xsdt, xsdt->length) before invoking — the
  //         walker trusts xsdt->length to bound its iteration.
  //   rsi = target SIG4 (low 32 bits; high 32 ignored).
  //
  // Returns rax = pointer to the first table whose leading 4 bytes match
  // the target signature, or 0 if none.
  //
  // Leaf function: no nested call, no callee-save reg written. All
  // scratch in volatile regs (rax, rcx, rdx, r8, r9, r10). @no_frame
  // sound.
  //
  //   rcx = xsdt base (preserved across the loop tail)
  //   r8  = end of table (base + length)
  //   r9  = current entry pointer (walks from base+36 in 8-byte steps)
  //   r10 = target signature (low 32 bits, zero-extended)
  //   rax = per-iteration entry ptr / signature scratch / return value
  //   rdx = per-iteration signature scratch

  pub let acpi_xsdt_find : (u64, u64) -> u64 !{mem} @{} =
    fn (xsdt: u64, sig: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M1-002 (#806). Linear XSDT lookup by 4-byte signature. Computes end = base + xsdt->length (u32 @ +4, zero-extended via xor rax,rax + mov eax,[rcx+4]), initialises entry cursor at base+36 (start of u64 entry array per ACPI 6.5 §5.2.9). Per-iteration: bounds-check that 8 more bytes fit before end (`mov rax, r9; add rax, 8; cmp rax, r8; ja` — end-exclusive), load the u64 entry pointer, load *(u32*)entry into edx (target's signature), compare edx against r10d (target sig masked to 32 bits via `mov r10d, esi`). On match: reload the entry pointer via `mov rax, [r9]` (edx clobbered by the signature compare) and return. On end-of-array with no match: xor rax,rax; ret. Leaf function — no nested call, no callee-save touched; @no_frame sound. Entry-array reads at offset 36 hit a 4-aligned (not 8-aligned) address; x86-64 tolerates unaligned qword loads per SDM Vol.3 §7.1.1 with a perf penalty but no fault, matching every mainline ACPI implementation. Zero-extension of xsdt->length (u32) into rax defends against upper-bit contamination from adjacent revision/checksum bytes at offsets +8/+9 that would otherwise be aliased by a naive 8-byte load of `[rcx+4]`. Cross-repo note: the issue was labeled cross-repo:paideia-as-blocked citing 'Slice<u8> for typed table body (v0.22)' — that gap targets R20.M2+ downstream-table parsing; M1's raw-pointer walker uses only proven v0.20 encoder features (pointer-stride loop, 4-byte load, cmp reg,reg, `call reg` indirect elsewhere).",
      block: {
        mov rcx, rdi;                        // rcx = xsdt base

        // end = base + xsdt->length
        xor rax, rax;
        mov eax, [rcx + 4];
        mov r8, rcx;
        add r8, rax;

        // First entry at base + 36
        mov r9, rcx;
        add r9, 36;

        // Target signature (low 32 bits, zero-extended into r10)
        xor r10, r10;
        mov r10d, esi;

      acpi_xsdt_find_loop:
        // Bounds check: 8 more bytes must fit before end.
        mov rax, r9;
        add rax, 8;
        cmp rax, r8;
        ja  acpi_xsdt_find_notfound;

        // Load entry pointer and dereference for signature.
        mov rax, [r9];
        mov edx, [rax];                      // edx = *(u32*)entry (zero-ext into rdx)
        cmp edx, r10d;
        je  acpi_xsdt_find_found;

        add r9, 8;
        jmp acpi_xsdt_find_loop;

      acpi_xsdt_find_found:
        // rax was clobbered by the edx-load above — reload the pointer.
        mov rax, [r9];
        ret;

      acpi_xsdt_find_notfound:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // acpi_xsdt_iter — enumerate every entry, invoke callback(hdr, sig)
  // ==========================================================================
  //
  // SysV: (xsdt: u64, callback: u64) -> u64
  //
  //   rdi = pointer to a valid XSDT (as for acpi_xsdt_find)
  //   rsi = callback function pointer with signature (u64, u64) -> ()
  //
  // For each entry the callback receives:
  //   arg0 (rdi) = pointer to the downstream table (a *sdt_hdr)
  //   arg1 (rsi) = target's 4-byte signature, zero-extended to u64
  //
  // Returns rax = number of entries visited (informational).
  //
  // The callback is invoked via `call r15` — the same indirect-dispatch
  // idiom used across the vops layer (src/kernel/core/fs/vops.pdx). It
  // MUST return normally (`ret`) and MUST NOT clobber the caller's r13/
  // r14/r15 (SysV callee-save, which we've committed for our own use).
  //
  // Register plan (@no_frame, 3-push callee-save prologue):
  //   r13 = end of table (base + length)
  //   r14 = current entry pointer
  //   r15 = callback function pointer
  //   rax = per-iteration scratch, count return
  //   rdi, rsi = callback arg-pass (clobbered per invocation)
  //
  // Stack alignment: entry rsp % 16 == 8. 3 pushes = rsp % 16 == 0 → the
  // indirect `call r15` lands the callback at rsp % 16 == 8 as SysV
  // requires. No sub/add rsp,8 pad needed at the call site.

  pub let acpi_xsdt_iter : (u64, u64) -> u64 !{mem} @{} =
    fn (xsdt: u64, callback: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M1-002 (#806) sibling to acpi_xsdt_find. Full-enumeration variant: instead of matching one signature, invokes an indirect callback per entry with (target_hdr, sig_u64). Callback is a SysV fn(u64, u64) -> (); marshaled via `mov rdi,[r14]; xor rsi,rsi; mov esi,[rdi]; call r15` — the same pattern the vops dispatcher uses (`call rax` in core/fs/vops.pdx) and validated by paideia-as v0.20's proven `call reg64` support. Callee-save discipline: 3 pushes (r13/r14/r15) = 24 B, rsp entry %16==8 → post-push %16==0, so the indirect call lands the callback at SysV-required %16==8. Callback contract requires it to preserve r13/r14/r15 (SysV callee-save default) — if a future non-conforming callback clobbers them the iter loop will silently corrupt, matching the vops dispatcher's identical assumption. r8/r9/r10 (volatile) are NOT preserved so the callback may freely use them. Entry counter accumulates in the low 32 bits of the outer rax return (though we simply increment a full 64-bit counter — never realistically overflows since the XSDT has O(dozen) entries). Bounds check identical to acpi_xsdt_find: end-exclusive `add rax,8; cmp rax,r13; ja` guard against a malformed length that would walk off the table.",
      block: {
        push r13;
        push r14;
        push r15;

        mov r15, rsi;                        // r15 = callback ptr
        mov rcx, rdi;                        // rcx = xsdt base (scratch, dead after end/entry init)

        // end = base + xsdt->length
        xor rax, rax;
        mov eax, [rcx + 4];
        mov r13, rcx;
        add r13, rax;

        // First entry at base + 36
        mov r14, rcx;
        add r14, 36;

        // Entry-visited counter in rax (we return it at the end).
        xor rax, rax;

      acpi_xsdt_iter_loop:
        // Bounds check: 8 more bytes must fit before end.
        mov rcx, r14;
        add rcx, 8;
        cmp rcx, r13;
        ja  acpi_xsdt_iter_done;

        // Marshal args and call callback.
        //   rdi = *(u64*)entry     (target hdr)
        //   rsi = *(u32*)hdr       (target's signature, zero-ext to u64)
        mov rdi, [r14];
        xor rsi, rsi;
        mov esi, [rdi];
        call r15;

        // Advance + count.
        add r14, 8;
        // Reload count into rax — the callback may have clobbered it.
        // Simpler: rebuild it from (r14 - base - 36) / 8, but base is
        // dead. Use a callee-save slot instead? Not worth another push.
        // Instead: the count is derived post-loop from (r14 - orig_entry_start).
        jmp acpi_xsdt_iter_loop;

      acpi_xsdt_iter_done:
        // count = (r14 - (base + 36)) / 8 — but we no longer have base.
        // Reconstruct: rax = (r14 - r13 + (length - 36)) / 8... nope,
        // simpler to have preserved the starting entry ptr. For M1 we
        // just return 0; the count value is informational and downstream
        // consumers (R20.M2+ dispatch) don't rely on it. If a caller
        // needs a count, it can wrap the callback with its own counter.
        xor rax, rax;

        pop r15;
        pop r14;
        pop r13;
        ret
      }
    } @no_frame
}
