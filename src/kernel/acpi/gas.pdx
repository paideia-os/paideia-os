// src/kernel/acpi/gas.pdx — R20-M3-004 (#817)
//
// GAS = Generic Address Structure — the ACPI-wide 12-byte descriptor
// firmware uses to name a resource (register, port, MMIO location) in
// a producer/consumer-independent way. GAS shows up embedded inside
// FADT (RESET_REG, X_PM1a_CNT_BLK, X_PM_TMR_BLK, ...) and HPET
// (address of the counter block), and later in ACPI 6.5 §5.2 tables
// (SBST, DBGP, DBG2, etc.). Reading and validating GAS at the
// R20.M3 layer means the R20.M3 parsers (fadt.pdx, hpet.pdx) can
// stay tiny — they call one helper per embedded GAS instead of
// duplicating the 12-byte decode inline.
//
// -----------------------------------------------------------------------------
// On-wire GAS layout (ACPI 6.5 §5.2.3.2, Table 5-2 "Generic Address Structure")
// -----------------------------------------------------------------------------
//
//   +0  u8  address_space_id
//   +1  u8  register_bit_width
//   +2  u8  register_bit_offset
//   +3  u8  access_size          (0=undefined, 1=byte, 2=word, 3=dword, 4=qword)
//   +4  u64 address              (I/O port # if IO-space, phys addr if memory)
//
// address_space_id values in practical use:
//   0x00  SystemMemory              (MMIO)
//   0x01  SystemIO                  (x86 in/out ports)
//   0x02  PCI Configuration Space
//   0x03  EmbeddedController
//   0x04  SMBus
//   0x05..0x7E  Reserved
//   0x7F  FunctionalFixedHardware
//   0x80..0xBF  OEM-defined
//
// The R20.M3 consumers only care about {0, 1} — memory or IO. Everything
// else is unimplemented ("valid" but flagged as unsupported by our
// gas_is_valid check).
//
// -----------------------------------------------------------------------------
// gas_info decoded layout (16 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0  u64 address        (verbatim from GAS+4 — unaligned 8-byte read spec-legal)
//   +8  u8  address_space
//   +9  u8  bit_width
//   +10 u8  bit_offset
//   +11 u8  access_size
//   +12 u32 _pad           (zero — reserved for future flag word)
//
// The struct's 16-byte size + 8-byte alignment matches the FADT/HPET
// consumers' embed budget (fadt_info holds one for reset_port + one
// for X_PM_TMR; hpet_info holds one for counter_base) without forcing
// them to align their layout to 12.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.20.1+)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow-store widens → the u32 _pad zero-init
//       uses mov_d.
//   G4: `cmp al, imm` may miscompile → gas_is_valid stays in full-reg
//       compares after xor+mov_b zero-extension.
//
// -----------------------------------------------------------------------------
// Alignment note — the u64 at GAS+4
// -----------------------------------------------------------------------------
//
// GAS is a 12-byte struct with a u64 at offset +4. This means the u64
// is at best 4-aligned when the parent struct is 8-aligned. x86-64
// tolerates unaligned qword reads per SDM Vol.3 §7.1.1 (perf penalty,
// no fault), which is the same posture xsdt.pdx L109 uses for its u64
// entry-pointer loads. We take the perf hit — GAS reads are one-shot
// per boot and the alternative (two 32-bit reads + shift-combine) is
// no faster on modern hardware.

module Gas = structure {

  // ============================================================================
  // Layout constants
  // ============================================================================

  pub let GAS_SIZE_BYTES              : u64 = 12
  pub let GAS_OFFSET_ADDRESS_SPACE    : u64 = 0
  pub let GAS_OFFSET_BIT_WIDTH        : u64 = 1
  pub let GAS_OFFSET_BIT_OFFSET       : u64 = 2
  pub let GAS_OFFSET_ACCESS_SIZE      : u64 = 3
  pub let GAS_OFFSET_ADDRESS          : u64 = 4

  pub let GAS_INFO_SIZE_BYTES         : u64 = 16
  pub let GAS_INFO_OFFSET_ADDRESS     : u64 = 0
  pub let GAS_INFO_OFFSET_ASPACE      : u64 = 8
  pub let GAS_INFO_OFFSET_BIT_WIDTH   : u64 = 9
  pub let GAS_INFO_OFFSET_BIT_OFFSET  : u64 = 10
  pub let GAS_INFO_OFFSET_ACCESS_SIZE : u64 = 11
  pub let GAS_INFO_OFFSET_PAD         : u64 = 12

  pub let ACPI_ASPACE_MEMORY          : u64 = 0
  pub let ACPI_ASPACE_IO              : u64 = 1

  // ============================================================================
  // gas_read — decode a 12-byte on-wire GAS into a 16-byte gas_info
  // ============================================================================
  //
  // SysV: (gas_ptr: u64, out: u64) -> u64
  //
  //   rdi = pointer to a 12-byte on-wire GAS (any alignment; the u64 at
  //         +4 is loaded unaligned).
  //   rsi = pointer to a caller-owned 16-byte gas_info (@align(8) preferred).
  //
  // Returns rax = 1 if gas_ptr is non-null AND the GAS is "meaningful"
  // (address non-zero and address_space in {SystemMemory=0, SystemIO=1}),
  // else 0. The out struct is ALWAYS populated when gas_ptr != 0, even
  // for a zero/unsupported GAS — callers that only care about presence
  // can check the returned bool; callers that want the raw decode
  // regardless can populate out and ignore rax.
  //
  // Null-guard: gas_ptr == 0 → return 0 and DO NOT touch out.
  //
  // Register plan (@no_frame, leaf, no callee-save):
  //   rdi = gas_ptr (arg)
  //   rsi = out ptr (arg)
  //   rax = per-field scratch / return
  //   rcx = per-field scratch
  //   rdx = address-space scratch (kept for the validity check)

  pub let gas_read : (u64, u64) -> u64 !{mem} @{} =
    fn (gas_ptr: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M3-004 (#817). Generic Address Structure decoder. Copies the 12-byte on-wire GAS at rdi into the 16-byte gas_info at rsi and returns a validity signal. Null-guard on gas_ptr: rdi==0 → return 0 without dereferencing (defensive for the FADT path where an X_* field may be absent because the FADT length cut short before that offset — the caller shortens by not calling us, but the guard makes the primitive callable directly from paths that haven't done that check yet). Field decode: address_space (u8 @ +0), bit_width (u8 @ +1), bit_offset (u8 @ +2), access_size (u8 @ +3) — all loaded via `xor rN,rN; mov_b rN,[rdi+off]` for explicit zero-extension (G4 posture, matches acpi/checksum.pdx and acpi/madt.pdx). address (u64 @ +4) loaded via `mov rax, [rdi+4]` — spec-legal unaligned 8-byte read per SDM Vol.3 §7.1.1 (same posture as xsdt.pdx L109 entry-pointer loads and madt.pdx Type 5 override load). Writes into the 16-byte out struct: address (u64) @ +0 via plain mov, address_space (u8) @ +8 via mov_b, bit_width (u8) @ +9 via mov_b, bit_offset (u8) @ +10 via mov_b, access_size (u8) @ +11 via mov_b, _pad (u32) zeroed @ +12 via mov_d (G1: sized 32-bit store to prevent silent REX.W widening that would clobber the following gas_info in an array-of-gas layout). Validity computed from the just-decoded fields: valid iff address != 0 AND address_space in {ACPI_ASPACE_MEMORY=0, ACPI_ASPACE_IO=1}. Both conditions evaluated on full 64-bit registers (rax=address, rdx=address_space) so no `cmp al, imm` hazard (G4). Leaf function; no nested call; @no_frame sound.",
      block: {
        // ---- Null-guard on gas_ptr ----
        cmp rdi, 0;
        je  gas_read_fail;

        // ---- Load and store address_space (u8 @ +0 → u8 @ out+8) ----
        xor rdx, rdx;
        mov_b rdx, [rdi + 0];
        mov_b [rsi + 8], rdx;

        // ---- Load and store bit_width (u8 @ +1 → u8 @ out+9) ----
        xor rcx, rcx;
        mov_b rcx, [rdi + 1];
        mov_b [rsi + 9], rcx;

        // ---- Load and store bit_offset (u8 @ +2 → u8 @ out+10) ----
        xor rcx, rcx;
        mov_b rcx, [rdi + 2];
        mov_b [rsi + 10], rcx;

        // ---- Load and store access_size (u8 @ +3 → u8 @ out+11) ----
        xor rcx, rcx;
        mov_b rcx, [rdi + 3];
        mov_b [rsi + 11], rcx;

        // ---- _pad = 0 (u32 @ out+12), G1: mov_d ----
        xor rcx, rcx;
        mov_d [rsi + 12], rcx;

        // ---- Load and store address (u64 @ +4 → u64 @ out+0, unaligned) ----
        mov rax, [rdi + 4];
        mov [rsi + 0], rax;

        // ---- Validity: address != 0 AND address_space in {0,1} ----
        // rax = address, rdx = address_space (still live from above).
        cmp rax, 0;
        je  gas_read_fail;

        // address_space ∈ {0, 1} — reject anything > 1.
        cmp rdx, 1;
        ja  gas_read_fail;

        mov rax, 1;
        ret;

      gas_read_fail:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // gas_is_valid — cheap validity probe without populating an out struct
  // ============================================================================
  //
  // SysV: (gas_ptr: u64) -> u64
  //
  //   rdi = pointer to a 12-byte on-wire GAS (any alignment).
  //
  // Returns rax = 1 iff address (u64 @ +4) is non-zero AND
  // address_space (u8 @ +0) is in {0, 1}. Null-guard on rdi returns 0.
  //
  // This is a subset of gas_read's decode logic — kept as a separate
  // helper so callers that want to check presence without allocating
  // a gas_info can `if (gas_is_valid(gas)) { ... }`. fadt_parse uses
  // it to decide between the legacy 32-bit PM_TMR_BLK port and the
  // GAS-encoded X_PM_TMR_BLK — if X_PM_TMR_BLK is valid, prefer it.

  pub let gas_is_valid : (u64) -> u64 !{mem} @{} =
    fn (gas_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20-M3-004 (#817). Validity probe over a GAS without populating an out struct. Same field-fetch shape as gas_read minus the writes: xor+mov_b for the u8 address_space at +0, unaligned mov r64,[rdi+4] for the u64 address, then full-register compares (address != 0 AND address_space <= 1). Returns 1 iff both conditions hold, else 0. Null-guard on rdi returns 0 without dereferencing. Leaf function; no nested call; @no_frame sound.",
      block: {
        cmp rdi, 0;
        je  gas_is_valid_no;

        xor rdx, rdx;
        mov_b rdx, [rdi + 0];       // address_space
        mov rax, [rdi + 4];         // address (unaligned)

        cmp rax, 0;
        je  gas_is_valid_no;

        cmp rdx, 1;
        ja  gas_is_valid_no;

        mov rax, 1;
        ret;

      gas_is_valid_no:
        xor rax, rax;
        ret
      }
    } @no_frame
}
