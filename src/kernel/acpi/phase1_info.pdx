// src/kernel/acpi/phase1_info.pdx — R20-M3-005 (#818)
//
// Typed phase-1 ACPI handoff record. Aggregates the outputs of the
// R20.M1..M3 parsers (rsdp → xsdt → madt/mcfg/fadt/hpet) into a
// single 512-byte struct that R20.M4's acpi_supervisor userspace
// process consumes as its bootstrap seed. The struct's fields are
// laid out for cache-line-friendly access (fadt_info + hpet_info
// share a 96-byte prefix, hot summary counts follow, and 300+ bytes
// of reserved tail leaves room for R21/R22 additions without an
// ABI break).
//
// -----------------------------------------------------------------------------
// phase1_acpi_info layout (512 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    fadt_info                (64 B — embedded, see fadt.pdx)
//   +64   hpet_info                (32 B — embedded, see hpet.pdx)
//   +96   u64 lapic_base_pa        MADT-resolved LAPIC MMIO base (Type-5-overridden if present)
//   +104  u64 mcfg_seg0_base_pa    First MCFG segment's ECAM base (99% of systems: seg=0)
//   +112  u64 ap_count             _madt_ap_count — BSP-filtered AP APIC-ID array length
//   +120  u64 x2apic_count         _madt_n_x2apics — raw Type-9 count including BSP
//   +128  u64 iso_count            _madt_n_isos — Type-2 interrupt source override count
//   +136  u64 ioapic_count         _madt_n_ioapics — Type-1 I/O APIC count
//   +144  u8  has_hpet             1 iff hpet_parse succeeded
//   +145  u8  has_mcfg             1 iff mcfg_parse_segments returned >= 1
//   +146  u8  has_fadt             1 iff fadt_parse succeeded
//   +147  u8  has_dmar             1 iff DMAR was found + checksum-validated (R22.M4 substrate; unpopulated at boot until R22.M5 wires it)
//   +148  u32 _pad1
//   +152  u64 _reserved[45]        Reserved for R21+ (PSCI/PPTT/SRAT/IORT/etc.)
//   ...
//   +511  end
//
// Total: 152 + 45*8 = 152 + 360 = 512 bytes.
//
// -----------------------------------------------------------------------------
// The gathering pipeline
// -----------------------------------------------------------------------------
//
// phase1_acpi_gather(env, out) walks:
//
//   1. rsdp = acpi_find_rsdp(env)                         [rsdp.pdx]
//   2. If rsdp == 0 or rsdp->revision < 2 → early bail (return 0)
//   3. xsdt = *(u64*)(rsdp+24)                            [rsdp v2 offset]
//   4. Zero the entire out buffer (defensive).
//   5. Look up FADT: acpi_xsdt_find(xsdt, SIG_FACP)       [xsdt.pdx]
//        → checksum → fadt_parse into out+0 → set has_fadt
//   6. Look up HPET: acpi_xsdt_find(xsdt, SIG_HPET)
//        → checksum → hpet_parse into out+64 → set has_hpet
//   7. Look up MCFG: acpi_xsdt_find(xsdt, SIG_MCFG)
//        → checksum → mcfg_parse_segments into _mcfg_segments →
//          if count >= 1: set has_mcfg + copy _mcfg_segments[0].base_pa to out+104
//   8. Merge topology (from madt_topology.pdx's already-populated .bss slots):
//        out+96  = _madt_lapic_base
//        out+112 = _madt_ap_count
//        out+120 = _madt_n_x2apics
//        out+128 = _madt_n_isos
//        out+136 = _madt_n_ioapics
//   9. Return has_fadt (u8, zero-extended in rax) — the FADT is the
//      minimum requirement to boot (no reset, no PM timer, no S-state
//      support without it).
//
// Steps 5..7 are best-effort: a missing HPET or MCFG is entirely
// normal (older platforms, minimal virtualisation configurations),
// but a missing/broken FADT means the platform has no ACPI PM at
// all. Callers that need only the topology counts can ignore the
// return value and read the .u64 fields directly — those are always
// zero-initialised.
//
// -----------------------------------------------------------------------------
// R20.M3 wiring policy — NOT invoked from kernel_main
// -----------------------------------------------------------------------------
//
// The R20.M3 mandate is explicit: phase1_acpi_gather is DEFINED and
// LINKED but NOT called from kernel_main. R20.M4 will wire it into
// the userspace acpi_supervisor bring-up path. The link-side
// existence of the symbol is the M3 acceptance witness — nm should
// show phase1_acpi_gather as a global symbol post-build.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.20.1+)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 stores.
//   G3: add [mem], reg not encoded → no counter bumps here.
//   G4: cmp al, imm may miscompile → full-register compares.

module Phase1Info = structure {

  // ============================================================================
  // Layout constants
  // ============================================================================

  pub let PHASE1_ACPI_INFO_SIZE_BYTES     : u64 = 512

  pub let PHASE1_OFFSET_FADT              : u64 = 0     // 64 B fadt_info
  pub let PHASE1_OFFSET_HPET              : u64 = 64    // 32 B hpet_info
  pub let PHASE1_OFFSET_LAPIC_BASE_PA     : u64 = 96
  pub let PHASE1_OFFSET_MCFG_SEG0_BASE_PA : u64 = 104
  pub let PHASE1_OFFSET_AP_COUNT          : u64 = 112
  pub let PHASE1_OFFSET_X2APIC_COUNT      : u64 = 120
  pub let PHASE1_OFFSET_ISO_COUNT         : u64 = 128
  pub let PHASE1_OFFSET_IOAPIC_COUNT      : u64 = 136
  pub let PHASE1_OFFSET_HAS_HPET          : u64 = 144
  pub let PHASE1_OFFSET_HAS_MCFG          : u64 = 145
  pub let PHASE1_OFFSET_HAS_FADT          : u64 = 146
  pub let PHASE1_OFFSET_HAS_DMAR          : u64 = 147

  // ============================================================================
  // Canonical static slot — R20.M4 acpi_supervisor consumes this.
  // ============================================================================
  //
  // 512 B = 64 × u64. .bss zero-init means every reader sees the
  // "no ACPI discovered" state until phase1_acpi_gather has run.

  pub let mut _phase1_acpi_info : [u64; 64] = uninit @align(8)

  // ============================================================================
  // phase1_acpi_gather — orchestrate rsdp→xsdt→(fadt+hpet+mcfg+topology)
  // ============================================================================
  //
  // SysV: (env: u64, out: u64) -> u64
  //
  //   rdi = pointer to a boot_env_t (may be 0 if BIOS boot; acpi_find_rsdp
  //         handles that by falling back to the legacy EBDA scan).
  //   rsi = pointer to a 512-byte phase1_acpi_info (caller-allocated,
  //         @align(8) preferred). Typically &_phase1_acpi_info.
  //
  // Returns rax = 1 iff FADT was successfully parsed (minimum requirement
  // to boot); 0 otherwise.
  //
  // Register plan (5-push callee-save prologue, no local scratch):
  //   Prologue: push rbx, r12, r13, r14, r15 (+40) → rsp%16==0 pre-call.
  //   rbx = out ptr
  //   r12 = xsdt ptr
  //   r13 = per-lookup table ptr (fadt / hpet / mcfg)
  //   r14 = has_fadt result (0/1, kept for return-value + has_fadt store)
  //   r15 = reserved (unused; kept in prologue for review-symmetry)

  pub let phase1_acpi_gather : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (env: u64, out: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "R20-M3-005 (#818). Orchestrator for the R20 ACPI static-table pipeline. Nested-call sequence: (1) acpi_find_rsdp(env) — 0 means no ACPI at all, immediate bail with out fully zeroed. (2) revision check via mov_b of rsdp+15 — < 2 means ACPI 1.0 with no XSDT, bail. (3) xsdt = *(u64*)(rsdp+24) — the ACPI 2.0+ XSDT pointer. If 0, bail. (4) Zero the full 512-byte out buffer (64× u64 stores) — defensive so partial-fill on error leaves recognisable zero state. (5) FADT lookup: acpi_xsdt_find(xsdt, SIG_FACP=0x50434146) — if hit, acpi_checksum_ok validates, then fadt_parse into out+0 (which is the fadt_info embedded slot). Success (fadt_parse rax==1) sets r14=1 and writes has_fadt=1 to out+146. Failure leaves has_fadt=0 and out+0..64 zeroed. (6) HPET lookup: acpi_xsdt_find(xsdt, SIG_HPET=0x54455048) — same shape; hpet_parse into out+64 (embedded hpet_info); success sets has_hpet=1 to out+144. (7) MCFG lookup: acpi_xsdt_find(xsdt, SIG_MCFG=0x4746434D) — same; mcfg_parse_segments into module's canonical _mcfg_segments (with cap 16). If return >= 1, sets has_mcfg=1 to out+145 and copies _mcfg_segments[0].base_pa (u64 @ .bss offset 0) to out+104. (8) Topology merge — direct reads from madt_topology.pdx's .bss slots (populated by topology_seed_from_madt during R20.M2 wire-up): _madt_lapic_base → out+96, _madt_ap_count → out+112, _madt_n_x2apics → out+120, _madt_n_isos → out+128, _madt_n_ioapics → out+136. These reads are safe regardless of whether topology_seed_from_madt has actually run — .bss zero-init means an unpopulated slot reads 0 which is a valid 'no data' state. (9) Return r14 (has_fadt) in rax. Stack: 5-push callee-save (rbx=out, r12=xsdt, r13=per-table, r14=has_fadt, r15=reserved) = 40 B → rsp%16==0 at every nested call. All nested calls use standard SysV — no additional stack pad needed. G1 (mov_d for u32-side stores like _pad1), G4 (full-reg compares).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                          // rbx = out
        xor r14, r14;                          // r14 = has_fadt = 0

        // Null-guard on out.
        cmp rbx, 0;
        je  phase1_gather_return;

        // ---- Zero out[0..512) upfront (64 u64 stores) ----
        // Loop for compactness.
        xor rcx, rcx;
        xor rax, rax;
      phase1_zero_loop:
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  phase1_zero_loop;

        // ---- (1) rsdp = acpi_find_rsdp(env) ----
        // rdi already = env (caller arg)
        call acpi_find_rsdp;
        cmp rax, 0;
        je  phase1_gather_return;

        // Save rsdp in r13 (temporary).
        mov r13, rax;

        // ---- (2) rsdp->revision (u8 @ +15) >= 2 ----
        xor rax, rax;
        mov_b rax, [r13 + 15];
        cmp rax, 2;
        jb  phase1_gather_return;

        // ---- (3) xsdt = *(u64*)(rsdp+24) ----
        mov r12, [r13 + 24];
        cmp r12, 0;
        je  phase1_gather_return;

        // ================================================================
        // (5) FADT: xsdt_find → checksum → fadt_parse
        // ================================================================

        mov rdi, r12;
        mov rsi, 0x50434146;                   // SIG_FACP
        call acpi_xsdt_find;
        cmp rax, 0;
        je  phase1_skip_fadt;

        mov r13, rax;                          // r13 = fadt ptr

        // Length for checksum.
        xor rsi, rsi;
        mov esi, [r13 + 4];                    // u32 length
        mov rdi, r13;
        call acpi_checksum_ok;
        cmp rax, 1;
        jne phase1_skip_fadt;

        // fadt_parse(fadt, out + PHASE1_OFFSET_FADT=0)
        mov rdi, r13;
        mov rsi, rbx;                          // out + 0
        call fadt_parse;
        cmp rax, 1;
        jne phase1_skip_fadt;

        mov r14, 1;                            // has_fadt = 1
        mov rax, 1;
        mov_b [rbx + 146], rax;                // has_fadt slot

      phase1_skip_fadt:

        // ================================================================
        // (6) HPET: xsdt_find → checksum → hpet_parse
        // ================================================================

        mov rdi, r12;
        mov rsi, 0x54455048;                   // SIG_HPET
        call acpi_xsdt_find;
        cmp rax, 0;
        je  phase1_skip_hpet;

        mov r13, rax;                          // r13 = hpet ptr

        xor rsi, rsi;
        mov esi, [r13 + 4];
        mov rdi, r13;
        call acpi_checksum_ok;
        cmp rax, 1;
        jne phase1_skip_hpet;

        // hpet_parse(hpet, out + PHASE1_OFFSET_HPET=64)
        mov rdi, r13;
        mov rsi, rbx;
        add rsi, 64;
        call hpet_parse;
        cmp rax, 1;
        jne phase1_skip_hpet;

        mov rax, 1;
        mov_b [rbx + 144], rax;                // has_hpet slot

      phase1_skip_hpet:

        // ================================================================
        // (7) MCFG: xsdt_find → checksum → mcfg_parse_segments
        // ================================================================

        mov rdi, r12;
        mov rsi, 0x4746434D;                   // SIG_MCFG
        call acpi_xsdt_find;
        cmp rax, 0;
        je  phase1_skip_mcfg;

        mov r13, rax;                          // r13 = mcfg ptr

        xor rsi, rsi;
        mov esi, [r13 + 4];
        mov rdi, r13;
        call acpi_checksum_ok;
        cmp rax, 1;
        jne phase1_skip_mcfg;

        // mcfg_parse_segments(mcfg, _mcfg_segments, 16)
        mov rdi, r13;
        lea rsi, [rip + _mcfg_segments];
        mov rdx, 16;                           // MCFG_MAX_SEGMENTS
        call mcfg_parse_segments;
        mov [rip + _mcfg_count], rax;
        cmp rax, 0;
        je  phase1_skip_mcfg;

        // has_mcfg = 1
        mov rax, 1;
        mov_b [rbx + 145], rax;

        // mcfg_seg0_base_pa = _mcfg_segments[0].base_pa (u64 @ offset 0)
        lea rcx, [rip + _mcfg_segments];
        mov rax, [rcx + 0];
        mov [rbx + 104], rax;

      phase1_skip_mcfg:

        // ================================================================
        // (7b) DMAR: xsdt_find → checksum → dmar_parse_drhds
        // ================================================================
        //
        // R111.M2-007 (paideia-os #2359) wire-in: previously DEFERRED
        // per this file's header ("R22.M5 will (a) add a DMAR branch to
        // phase1_acpi_gather that sets has_dmar = 1 on checksum
        // success"). The MSI-X + VT-d IR real-HW baseline needs the
        // DRHD register-base list (populated into Dmar._dmar_drhds)
        // before msix_ir_bringup_all can run vtd_ir_init. On QEMU-TCG
        // -machine q35 (without intel-iommu=on) acpi_xsdt_find returns
        // 0 for SIG_DMAR — the branch is a no-op, has_dmar stays 0,
        // and downstream msix_ir_bringup_all lands on its `MSIX IR OFF`
        // fallback. On T14 G4 / Raptor Lake the branch populates the
        // list and downstream flips _msix_ir_active=1.
        mov rdi, r12;
        mov rsi, 0x52414D44;                   // SIG_DMAR ("DMAR")
        call acpi_xsdt_find;
        cmp rax, 0;
        je  phase1_skip_dmar;

        mov r13, rax;                          // r13 = dmar ptr

        xor rsi, rsi;
        mov esi, [r13 + 4];                    // u32 length
        mov rdi, r13;
        call acpi_checksum_ok;
        cmp rax, 1;
        jne phase1_skip_dmar;

        // dmar_parse_drhds(dmar, _dmar_drhds, DMAR_MAX_DRHDS=8) writes
        // into the canonical static slot and returns the count in rax.
        // Zero DRHDs is a legal outcome (a DMAR table can name RMRR /
        // ATSR / RHSA sub-structures only); has_dmar still latches to
        // 1 because the table itself validated — the bringup layer
        // makes the "no DRHDs → IR OFF" decision from _dmar_drhd_count.
        mov rdi, r13;
        lea rsi, [rip + _dmar_drhds];
        mov rdx, 8;                            // DMAR_MAX_DRHDS
        call dmar_parse_drhds;
        mov [rip + _dmar_drhd_count], rax;

        // has_dmar = 1 (checksum passed; DRHDs may still be zero).
        mov rax, 1;
        mov_b [rbx + 147], rax;                // PHASE1_OFFSET_HAS_DMAR

      phase1_skip_dmar:

        // ================================================================
        // (8) Topology merge — direct reads of madt_topology.pdx .bss
        // ================================================================

        // out+96 = _madt_lapic_base
        mov rax, [rip + _madt_lapic_base];
        mov [rbx + 96], rax;

        // out+112 = _madt_ap_count
        mov rax, [rip + _madt_ap_count];
        mov [rbx + 112], rax;

        // out+120 = _madt_n_x2apics
        mov rax, [rip + _madt_n_x2apics];
        mov [rbx + 120], rax;

        // out+128 = _madt_n_isos
        mov rax, [rip + _madt_n_isos];
        mov [rbx + 128], rax;

        // out+136 = _madt_n_ioapics
        mov rax, [rip + _madt_n_ioapics];
        mov [rbx + 136], rax;

      phase1_gather_return:
        mov rax, r14;                          // return has_fadt (0 or 1)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // phase1_emit_rsdp_fingerprint(env_pa) — R111.M1-004 (paideia-os#2356)
  // ============================================================================
  //
  // SysV: (env_pa: u64) -> ()
  //
  //   rdi = boot_env_t physical address (0 iff PVH / legacy BIOS boot)
  //
  // Emit the R20 ACPI witness line seeded from the REAL firmware handoff
  // (boot_env_t.rsdp_pa @ +48) rather than the synth-witness fixture in
  // tests/kernel/acpi/rsdp_synth.pdx.  Renders the template
  //
  //   ACPI RSDP @0x<pa> XSDT[<n>] MADT MCFG FADT HPET
  //
  // across two klog lines because our widest wrapper carries four KVs:
  //
  //   Line 1 (klog_s1_x1_d1):
  //     boot  <ts>  <cpu>  ACPI RSDP HANDOFF OK pa=0x<rsdp_pa> xsdt=<n>
  //   Line 2 (klog_s1_d4):
  //     boot  <ts>  <cpu>  ACPI TABLES SUMMARY OK madt=<n> mcfg=<n>
  //                        fadt=<n> hpet=<n>
  //
  // XSDT entry count computed inline: rsdp_pa + 24 = xsdt_pa (0 iff
  // ACPI 1.0 or RSDP absent), then xsdt_pa + 4 = u32 length, then
  // (length - 36) / 8 = entry count (SDT-header size 36, 8-byte
  // entries per ACPI 6.5 §5.2.9).
  //
  // Presence bits:
  //   madt  1 iff _madt_lapic_base != 0 (topology_seed_from_madt ran
  //         and found a MADT — the LAPIC MMIO base is the single
  //         readable proof-of-parse).  0 if no MADT in the XSDT or if
  //         topology_seed_from_madt has not been invoked yet at the
  //         emit point.
  //   mcfg  u8 at _phase1_acpi_info + PHASE1_OFFSET_HAS_MCFG=145.
  //   fadt  u8 at _phase1_acpi_info + PHASE1_OFFSET_HAS_FADT=146.
  //   hpet  u8 at _phase1_acpi_info + PHASE1_OFFSET_HAS_HPET=144.
  //
  // Under UEFI at the emit point (kernel_main_64 post-phase1_acpi_gather)
  // rsdp_pa is authoritative from boot_env_t (post R111.M1-004 the
  // acpi_find_rsdp EBDA-scan fallback for UEFI has been deleted); a
  // zero pa means firmware failed to publish an RSDP.  Under PVH
  // (`qemu -kernel`) env_pa == 0, the null-guard returns pa=0x0 on the
  // wire, and the presence bits still capture whatever
  // acpi_find_rsdp's legacy EBDA scan discovered (the counts and
  // has_* flags come from _phase1_acpi_info, which phase1_acpi_gather
  // populated using acpi_find_rsdp itself).
  //
  // Register plan (leaf-shape, no callee-save prologue, no rbp frame):
  //   r8   = rsdp_pa (loaded from env+48 with null-guard; survives to
  //          the klog_s1_x1_d1 register-arg setup because no
  //          intermediate call clobbers it).
  //   r10  = xsdt_pa scratch during count computation, then reused
  //          post-Line-1 as the madt presence bit.
  //   r11  = mcfg presence bit (staged before the push loop).
  //   rax  = general scratch (count, address bases, u8 zero-extends).
  //
  // Alignment (SysV: rsp%16==0 pre-call, ==8 at callee entry):
  //   Entry rsp%16==8.  Line 1 uses ONE stack arg (vd = xsdt count),
  //   so a single `push rax` before the call brings rsp%16 to 0 for
  //   klog_s1_x1_d1's entry contract.  `add rsp, 8` restores to
  //   %16==8.  Line 2 uses FIVE stack args (v2/k3/v3/k4/v4); five
  //   pushes from %16==8 land at %16==0 (mirrors the r69_emit_
  //   dispatch_ok pattern in src/kernel/boot/witness/r69_smp_
  //   dispatch.pdx §281).  `add rsp, 40` restores to %16==8, and the
  //   final `ret` pops 8 back to the caller's original rsp.
  //
  // Encoder posture (paideia-as v0.36+ baseline):
  //   push/pop, mov reg,reg, mov reg,imm32, mov reg,imm64, mov r64,
  //   [reg+imm8], mov eax,[reg+imm8] (zero-extend), mov_b r64,
  //   [rip + sym + imm8] (zero-extend — proven in src/kernel/core/
  //   drivers/nvme/mdts.pdx L136), lea r64,[rip+sym], mov r64,
  //   [rip+sym], xor / sub / add / shr r64,imm8, cmp / je / jmp,
  //   call rel32, ret.  Every operation is on full 64-bit registers
  //   (G4).  No test rN,rN.  No and r*,imm64.  No 2-op imul r,imm.
  //   Every mov_b load is preceded by xor r,r for explicit zero-
  //   extension (defensive against paideia-as encoder churn around
  //   implicit-zero-extension of 8-bit destinations).
  //
  // Reserved-label prefix: `phase1_ers_` (Phase1 Emit RSDP fingerprint,
  // per feedback_pdx_encoder_pitfalls reserved-label discipline;
  // avoids clashes with sibling functions' `phase1_...` labels which
  // stay under phase1_zero_/phase1_skip_/phase1_gather_).

  pub let phase1_emit_rsdp_fingerprint : (u64) -> () !{sysreg, mem} @{} =
    fn (env_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R111.M1-004 (paideia-os#2356). Emit the R20 ACPI witness line 'ACPI RSDP @0x<pa> XSDT[<n>] MADT MCFG FADT HPET' seeded from the real firmware handoff (boot_env_t.rsdp_pa @ +48, populated pre-EBS by src/boot/uefi_stub.pdx efi_finalize_and_handoff via efi_find_rsdp #794). Rendered as two klog lines because our widest wrapper is klog_s1_d4 / klog_s1_x1_d1 (4 KVs / 1 hex + 1 decimal): Line 1 via klog_s1_x1_d1 = 'ACPI RSDP HANDOFF OK pa=0x<rsdp_pa> xsdt=<count>'; Line 2 via klog_s1_d4 = 'ACPI TABLES SUMMARY OK madt=<0|1> mcfg=<0|1> fadt=<0|1> hpet=<0|1>'. Null-guard on env_pa (rdi==0 under PVH) yields pa=0x0 rather than a null-pointer dereference. XSDT entry count computed inline from rsdp_pa + 24 (rsdp->xsdt_address, ACPI 6.5 §5.2.5.3 Table 5-25) then xsdt_pa + 4 (u32 length, SDT-header §5.2.6 Table 5-27) via (length - 36) / 8 — zero if either pa is null or the RSDP is ACPI 1.0 (no XSDT). Presence bits: madt = (_madt_lapic_base != 0), the LAPIC MMIO base topology_seed_from_madt caches at parse success (madt_topology.pdx L202); mcfg/fadt/hpet = u8 at _phase1_acpi_info + PHASE1_OFFSET_HAS_MCFG/HAS_FADT/HAS_HPET (145/146/144) populated by phase1_acpi_gather. Register plan: leaf-shape, no callee-save prologue. r8 holds rsdp_pa across Line 1 setup (survives `mov r10, [r8+24]; mov eax, [r10+4]` because rax and r10 are the only clobbers). r10 used first as xsdt_pa scratch (clobbered by klog_s1_x1_d1 which is caller-save r8-r11 discipline), then re-set post-Line-1 as the madt presence flag. r11 staged as mcfg presence bit before the push chain (also caller-save; not needed after klog_s1_d4). Alignment: entry rsp%16==8, Line 1 uses ONE stack arg (push rax = count) yielding %16==0 pre-call; add rsp, 8 restores %16==8. Line 2 uses FIVE stack args (v4/k4/v3/k3/v2 pushed in that order) yielding %16==0 pre-call — mirrors r69_emit_dispatch_ok's identical 5-push discipline (src/kernel/boot/witness/r69_smp_dispatch.pdx §281). add rsp, 40 restores %16==8. Encoder posture (v0.36+): push/pop, mov reg,reg, mov reg,imm8/32/64, mov r64/eax,[reg+imm8], mov_b r64,[rip+sym+imm8] (proven in nvme/mdts.pdx L136), lea r64,[rip+sym], mov r64,[rip+sym], xor / sub / add / shr r64,imm8, cmp / je / jmp, call rel32, ret. Every mov_b load bracketed by xor r,r for explicit zero-extension. No test rN,rN. No and r*,imm64. No 2-op imul r,imm. Reserved label prefix `phase1_ers_` to avoid clashes with sibling phase1_zero_/phase1_skip_/phase1_gather_ labels in phase1_acpi_gather. Distinct tag_acpi_rsdp_handoff_ok / tag_acpi_tables_summary_ok tags (keys.pdx) — the 'HANDOFF' token separates this real-firmware fingerprint from rsdp_synth_witness_call's 'ACPI RSDP OK' at tests/kernel/acpi/rsdp_synth.pdx L56, so tests/r17/shell-shutdown.golden's ordered-substring match on 'ACPI RSDP OK' stays green (unrelated hit) and operator grep can distinguish the two.",
      block: {
        // ================================================================
        // Load rsdp_pa into r8 (null-guarded on env_pa).
        // ================================================================
        //
        // Under UEFI: rdi = _boot_env_pa (non-zero, magic-verified by
        // kernel_main_uefi's Phase 1); rdi + 48 = env->rsdp_pa =
        // authoritative firmware-published RSDP.
        //
        // Under PVH: rdi = 0; r8 stays 0 and the wire shows pa=0x0
        // — the presence bits (from _phase1_acpi_info) still tell the
        // operator what phase1_acpi_gather + acpi_find_rsdp's EBDA
        // scan discovered.

        xor r8, r8;
        cmp rdi, 0;
        je  phase1_ers_rsdp_zero;
        mov r8, [rdi + 48];                    // BOOT_ENV_OFFSET_RSDP_PA
      phase1_ers_rsdp_zero:

        // ================================================================
        // Compute XSDT entry count into rax.
        // ================================================================
        //
        // xsdt_pa = *(u64*)(rsdp_pa + 24)  (ACPI 6.5 §5.2.5.3, Table 5-25)
        // length  = *(u32*)(xsdt_pa +  4)  (SDT header, §5.2.6 Table 5-27)
        // count   = (length - 36) / 8      (SDT-header size + 8-byte entries)
        //
        // Zero if rsdp_pa == 0 (no ACPI at all), xsdt_pa == 0 (ACPI 1.0
        // — no XSDT slot), or, mathematically, if length < 36 (invalid;
        // sub underflow would produce a huge count but that is caught
        // downstream by any consumer of the count).

        xor rax, rax;                          // count = 0
        cmp r8, 0;
        je  phase1_ers_xsdt_done;
        mov r10, [r8 + 24];                    // xsdt_pa
        cmp r10, 0;
        je  phase1_ers_xsdt_done;
        mov eax, [r10 + 4];                    // u32 length (zero-ext to rax)
        sub rax, 36;                           // subtract SDT header size
        shr rax, 3;                            // divide by 8-byte entry stride
      phase1_ers_xsdt_done:

        // ================================================================
        // Line 1: klog_s1_x1_d1(INFO, BOOT, tag, k_pa, rsdp_pa,
        //                      k_xsdt, count)
        // ================================================================
        //
        // klog_s1_x1_d1 signature (wrappers.pdx L305):
        //   rdi=level, rsi=subsys, rdx=tag, rcx=kx, r8=vx, r9=kd,
        //   [rsp+8]=vd.
        //
        // Push the decimal value (xsdt count) first — that alone brings
        // rsp%16 from 8 to 0 for the call.

        push rax;                              // vd = xsdt count
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_acpi_rsdp_handoff_ok];
        lea rcx, [rip + k_pa];                 // kx = k_pa
        // r8 = rsdp_pa (already set, survives above ops)
        lea r9, [rip + k_xsdt];                // kd = k_xsdt
        call klog_s1_x1_d1;
        add rsp, 8;

        // ================================================================
        // Line 2: klog_s1_d4(INFO, BOOT, tag, k_madt, madt,
        //                    k_mcfg, [rsp+8]=mcfg, [rsp+16]=k_fadt,
        //                    [rsp+24]=fadt, [rsp+32]=k_hpet, [rsp+40]=hpet)
        // ================================================================
        //
        // Compute the four presence bits AFTER Line 1 emits, so the
        // caller-save regs (r10/r11) that get clobbered by
        // klog_s1_x1_d1 do not need to survive.
        //
        // klog_s1_d4 stack contract (wrappers.pdx L168):
        //   [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3, [rsp+32]=k4, [rsp+40]=v4.
        // Push in REVERSE order (v4, k4, v3, k3, v2) so that after five
        // 8-byte pushes the stack lays out correctly for the wrapper.

        // r10 = madt (1 iff _madt_lapic_base != 0)
        xor r10, r10;
        mov rax, [rip + _madt_lapic_base];
        cmp rax, 0;
        je  phase1_ers_madt_done;
        mov r10, 1;
      phase1_ers_madt_done:

        // r11 = mcfg = u8 at _phase1_acpi_info + 145
        xor r11, r11;
        mov_b r11, [rip + _phase1_acpi_info + 145];

        // v4 = hpet = u8 at _phase1_acpi_info + 144
        xor rax, rax;
        mov_b rax, [rip + _phase1_acpi_info + 144];
        push rax;                              // v4

        // k4 = k_hpet
        lea rax, [rip + k_hpet];
        push rax;                              // k4

        // v3 = fadt = u8 at _phase1_acpi_info + 146
        xor rax, rax;
        mov_b rax, [rip + _phase1_acpi_info + 146];
        push rax;                              // v3

        // k3 = k_fadt
        lea rax, [rip + k_fadt];
        push rax;                              // k3

        // v2 = mcfg (already in r11)
        push r11;                              // v2

        // Register args for klog_s1_d4:
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_acpi_tables_summary_ok];
        lea rcx, [rip + k_madt];               // k1
        mov r8, r10;                           // v1 = madt
        lea r9, [rip + k_mcfg];                // k2

        call klog_s1_d4;
        add rsp, 40;                           // pop the five stack args

        ret
      }
    }
}
