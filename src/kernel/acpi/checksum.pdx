// src/kernel/acpi/checksum.pdx — R20-M1-003 (#807)
//
// ACPI 8-bit sum-to-zero checksum validator. Every ACPI table (RSDP v1
// scope, RSDP v2 extended scope, RSDT/XSDT, MADT, MCFG, FADT, HPET, ...)
// is defined to be well-formed iff the unsigned 8-bit sum of every byte
// in the checksummed region evaluates to zero (ACPI 6.5 §5.2.7). The
// producer picks the value of the `checksum` byte(s) exactly so that
// this identity holds, so a valid RSDP or SDT always sums to zero over
// its self-declared length.
//
// The R20 pipeline invokes this helper twice on every RSDP candidate
// (v1 20-byte scope at RSDP+0..RSDP+19, v2 full length at RSDP+0..RSDP+
// length-1) and once per XSDT-linked table before dispatching to its
// parser. Skipping the checksum on a table that later turns out to be
// firmware garbage would let the parser walk arbitrary memory looking
// for structures that never existed.
//
// -----------------------------------------------------------------------------
// Algorithm
// -----------------------------------------------------------------------------
//
//   u8 sum = 0;
//   for (u64 i = 0; i < len; i++) sum += table[i];  // 8-bit wraparound
//   return sum == 0;
//
// Implementation accumulates into a 64-bit register (`rax`) and masks
// to 8 bits at the end — mathematically identical to an 8-bit rolling
// accumulator since (a + b) mod 256 == ((a mod 256) + (b mod 256)) mod 256,
// but avoids repeated 8-bit narrow arithmetic that would hit the paideia-as
// #1248 `cmp al, imm` miscompile hazard (see src/kernel/core/libc_test.pdx
// L142 for the same-shape workaround).
//
// -----------------------------------------------------------------------------
// Return convention
// -----------------------------------------------------------------------------
//
//   rax = 1  iff checksum is valid (sum-mod-256 == 0)
//   rax = 0  otherwise (including len == 0, which trivially sums to 0 —
//            treated as VALID since sum-of-empty-region is 0)

module Checksum = structure {

  // ==========================================================================
  // acpi_checksum_ok — 8-bit sum-to-zero validator over [base, base+len)
  // ==========================================================================
  //
  // SysV: (base: u64, len: u64) -> u64
  //
  //   rdi = base pointer (bytes to sum)
  //   rsi = byte count
  //
  // Returns rax = 1 iff sum mod 256 == 0, else 0.
  //
  // Register discipline: only rax/rcx/rdi/rsi (all caller-save) touched.
  // No callee-save reg written, no nested call, @no_frame sound.
  //
  //   rax = running sum (64-bit; masked to 8 bits at end)
  //   rcx = per-iteration byte scratch (zero-extended before mov_b)
  //   rdi = cursor (advanced by 1 each iteration)
  //   rsi = bytes remaining (decremented each iteration)

  pub let acpi_checksum_ok : (u64, u64) -> u64 !{mem} @{} =
    fn (base: u64, len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R20-M1-003 (#807). ACPI 8-bit sum-to-zero checksum per ACPI 6.5 §5.2.7. Accumulates into rax as a 64-bit running total; per-iteration byte load uses xor rcx,rcx; mov_b rcx,[rdi] to zero-extend explicitly (the mov_b primitive does not zero-extend on its own; see path.pdx and libc_test.pdx which follow the same pattern). Bytes-remaining underflow guard via `cmp rsi, 0; je` before the loop and at the loop tail — len==0 falls through to the check with rax==0, which passes (sum-of-empty-region is trivially 0, matches producer expectation for zero-length tables). Post-loop `and rax, 0xFF` masks to the 8-bit result; final `cmp rax, 0; jne` returns 1-if-zero, 0-otherwise. #1248 workaround (avoid `cmp al, imm`) is applied by staying in the 64-bit-with-mask idiom throughout — the byte-level compare is done post-mask against the full rax register. Leaf function: no nested call, no callee-save reg written; @no_frame sound.",
      block: {
        xor rax, rax;                    // sum = 0
        cmp rsi, 0;
        je  acpi_checksum_ok_check;

      acpi_checksum_ok_loop:
        xor rcx, rcx;                    // scratch = 0 (needed for mov_b zero-ext)
        mov_b rcx, [rdi];                // scratch = *(u8*)cursor
        add rax, rcx;                    // sum += scratch (64-bit; wraps at 2^64 which is far beyond 4 GiB tables)
        add rdi, 1;
        sub rsi, 1;
        cmp rsi, 0;
        jne acpi_checksum_ok_loop;

      acpi_checksum_ok_check:
        and rax, 0xFF;                   // reduce to 8-bit sum
        cmp rax, 0;
        jne acpi_checksum_ok_fail;
        mov rax, 1;                      // valid
        ret;

      acpi_checksum_ok_fail:
        mov rax, 0;                      // invalid
        ret
      }
    } @no_frame
}
