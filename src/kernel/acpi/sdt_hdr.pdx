// src/kernel/acpi/sdt_hdr.pdx — R20-M1-004 (#808)
//
// The 36-byte ACPI System Description Table header shared by every ACPI
// static table (RSDT, XSDT, MADT/APIC, MCFG, FADT/FACP, HPET, ...). Every
// table pointer that the XSDT walker (#806) enumerates targets a memory
// region whose first 36 bytes conform to this layout; the R20.M1 pipeline
// (RSDP scanner #805 → XSDT walker #806) uses the u32 `signature` field at
// offset 0 to dispatch, and the u32 `length` field at offset 4 to bound
// the checksum + parser scope (see checksum.pdx / xsdt.pdx).
//
// -----------------------------------------------------------------------------
// Layout (ACPI 6.5 §5.2.6, Table 5-33 "DESCRIPTION_HEADER Fields")
// -----------------------------------------------------------------------------
//
// struct sdt_hdr {
//   u8   signature[4];           // +0    4-byte ASCII (e.g. "APIC", "XSDT")
//   u32  length;                 // +4    total table size in bytes, header included
//   u8   revision;               // +8    per-table revision (usually 1..3)
//   u8   checksum;               // +9    8-bit sum-to-zero over `length` bytes
//   u8   oem_id[6];              // +10   OEM identifier (ASCII, space-padded)
//   u8   oem_table_id[8];        // +16   OEM table identifier (ASCII)
//   u32  oem_revision;           // +24   OEM-specific revision
//   u32  creator_id[1];          // +28   4-byte creator identifier
//   u32  creator_revision;       // +32   creator-specific revision
// };                             // sizeof = 36
//
// -----------------------------------------------------------------------------
// SIG4 constants — little-endian u32 with the ASCII bytes laid out so that
// `mov eax, [table]; cmp eax, SIG_APIC` (32-bit load + 32-bit compare) is
// a byte-for-byte match against the header signature field. Byte order in
// the u32 constant follows x86 LE convention: byte[0] ends up in bits 0-7
// of the loaded register, so SIG_APIC's low byte is 'A' (0x41) and its
// high byte is 'C' (0x43), giving the constant 0x43495041.
//
// Callers routinely inline these literals at their cmp sites (paideia-as
// `let` bindings emit .rodata slots rather than compile-time literals);
// the constants below are the source of truth for that inlining and the
// documentation anchor for the walker's dispatch table.
// -----------------------------------------------------------------------------

module SdtHdr = structure {

  // ==========================================================================
  // Field offsets (bytes into the 36-byte header)
  // ==========================================================================

  pub let SDT_HDR_OFFSET_SIGNATURE        : u64 = 0
  pub let SDT_HDR_OFFSET_LENGTH           : u64 = 4
  pub let SDT_HDR_OFFSET_REVISION         : u64 = 8
  pub let SDT_HDR_OFFSET_CHECKSUM         : u64 = 9
  pub let SDT_HDR_OFFSET_OEM_ID           : u64 = 10
  pub let SDT_HDR_OFFSET_OEM_TABLE_ID     : u64 = 16
  pub let SDT_HDR_OFFSET_OEM_REVISION     : u64 = 24
  pub let SDT_HDR_OFFSET_CREATOR_ID       : u64 = 28
  pub let SDT_HDR_OFFSET_CREATOR_REVISION : u64 = 32

  pub let SDT_HDR_SIZE_BYTES              : u64 = 36

  // ==========================================================================
  // 4-byte signature constants — u32 little-endian
  // ==========================================================================
  //
  // Each constant encodes the four ASCII signature bytes such that a raw
  // `mov eax, [table]` load produces the same u32 value. The mapping is
  // byte[0] → bits 0-7, byte[1] → bits 8-15, byte[2] → bits 16-23,
  // byte[3] → bits 24-31. Kept as u32 so the constant folds naturally
  // into the `cmp eax, imm32` encoding at every call site.

  pub let SIG_XSDT : u32 = 0x54445358    // "XSDT"
  pub let SIG_APIC : u32 = 0x43495041    // "APIC" (MADT)
  pub let SIG_MCFG : u32 = 0x4746434D    // "MCFG"
  pub let SIG_FACP : u32 = 0x50434146    // "FACP" (FADT)
  pub let SIG_HPET : u32 = 0x54455048    // "HPET"
  pub let SIG_DMAR : u32 = 0x52414D44    // "DMAR" (Intel VT-d IOMMU)

  // ==========================================================================
  // acpi_sig4_matches — compare a table's first 4 bytes against a SIG4
  // ==========================================================================
  //
  // SysV: (hdr: u64, sig: u64) -> u64
  //
  //   rdi = pointer to a table with a leading 4-byte signature field
  //   rsi = expected SIG4 (low 32 bits, high 32 ignored)
  //
  // Returns 1 in rax if the low 32 bits of *(u32*)rdi equal (rsi & 0xFFFFFFFF),
  // 0 otherwise. The load is a plain 32-bit fetch which zero-extends into
  // rax under x86-64 (SDM Vol.1 §3.4.1.1), so the compare against esi
  // sees only the four signature bytes without any tail contamination.
  //
  // No prologue: leaf function, only rax/rcx (both caller-save) touched.

  pub let acpi_sig4_matches : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64, sig: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R20-M1-004 (#808). Leaf 4-byte signature comparator shared by every ACPI walker (XSDT dispatch loop, RSDP validation, per-table parser fast path). Reads the 4-byte signature at hdr+0 via a 32-bit load (`mov eax, [rdi]`) which zero-extends into rax per x86-64 SDM Vol.1 §3.4.1.1; masks the argument sig to its low 32 bits via `mov ecx, esi` (also zero-extends into rcx). The 32-bit compare (`cmp eax, ecx`) checks all four signature bytes byte-for-byte. Returns 1 on match, 0 otherwise. No callee-save regs touched, leaf function (no nested call), no-frame sound.",
      block: {
        mov eax, [rdi];              // eax = *(u32*)hdr, high 32 of rax = 0
        mov ecx, esi;                // ecx = sig & 0xFFFFFFFF, high 32 of rcx = 0
        cmp eax, ecx;
        jne acpi_sig4_matches_no;
        mov rax, 1;
        ret;
      acpi_sig4_matches_no:
        mov rax, 0;
        ret
      }
    }
}
