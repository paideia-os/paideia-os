// src/kernel/acpi/fadt.pdx — R20-M3-002 (#815)
//
// FADT (Fixed ACPI Description Table, signature "FACP" —
// SIG_FACP=0x50434146 LE) parser. Extracts the platform's power-
// management port block addresses, the ACPI System Control Interrupt
// (SCI) GSI, the PM timer port + width, and the reset register
// (used by R21+ shutdown / warm-reboot code paths).
//
// -----------------------------------------------------------------------------
// FADT relevant on-wire fields (ACPI 6.5 §5.2.9 Table 5-33)
// -----------------------------------------------------------------------------
//
//   +0..35     sdt_hdr                    signature "FACP" (36 B header)
//   +36 (0x24) u32 FIRMWARE_CTRL          32-bit FACS pointer (legacy)
//   +40 (0x28) u32 DSDT                   32-bit differentiated-table pointer
//   +46 (0x2E) u16 SCI_INT                ACPI SCI GSI
//   +56 (0x38) u32 PM1a_EVT_BLK           legacy I/O port (16-bit port # in low 16b)
//   +60 (0x3C) u32 PM1b_EVT_BLK
//   +64 (0x40) u32 PM1a_CNT_BLK           power-mgmt control register (SLP_TYP, SLP_EN)
//   +68 (0x44) u32 PM1b_CNT_BLK
//   +72 (0x48) u32 PM2_CNT_BLK
//   +76 (0x4C) u32 PM_TMR_BLK             ACPI PM timer (3.579545 MHz counter)
//   +80 (0x50) u32 GPE0_BLK               GPE0 status+enable block, I/O port
//   +84 (0x54) u32 GPE1_BLK               GPE1 status+enable block, I/O port
//   +91 (0x5B) u8  PM_TMR_LEN             timer width — must be 4 for 24/32-bit
//   +92 (0x5C) u8  GPE0_BLK_LEN           WHOLE block width; halves are STS then EN
//   +93 (0x5D) u8  GPE1_BLK_LEN           likewise
//   +94 (0x5E) u8  GPE1_BASE              first flat GPE index GPE1 owns
//   +108 (0x6C) u8 CENTURY                CMOS RTC century register index (0 if none)
//   +116 (0x74) GAS RESET_REG (12 B)      how to write RESET_VALUE for reset
//   +128 (0x80) u8  RESET_VALUE           byte to write to RESET_REG
//   +172 (0xAC) GAS X_PM1a_CNT_BLK (12 B) 64-bit-capable form of PM1a_CNT_BLK
//   +208 (0xD0) GAS X_PM_TMR_BLK  (12 B)  64-bit-capable form of PM_TMR_BLK
//   +220 (0xDC) GAS X_GPE0_BLK    (12 B)  64-bit-capable form of GPE0_BLK
//   +232 (0xE8) GAS X_GPE1_BLK    (12 B)  64-bit-capable form of GPE1_BLK
//
// -----------------------------------------------------------------------------
// R30.M4-001 (#1066): field-offset correction
// -----------------------------------------------------------------------------
//
// The offsets above are ACPI 6.5 Table 5-33 verbatim. The table this
// parser shipped with from R20.M3 counted the SDT header as 40 bytes
// rather than 36 and placed FIRMWARE_CTRL at +40, which displaced
// SCI_INT and the whole PM_*_BLK run by 8..10 bytes and put both X_*
// GAS reads inside the wrong structures (X_PM1a_CNT_BLK is at +172,
// not +148; X_PM_TMR_BLK is at +208, not +176). The R20 synthetic
// fixture was fabricated to the same displaced layout, so the two
// agreed with each other and with nothing else; the real-firmware
// fixture that would have caught it (tests/kernel/acpi/fixtures/t14g4)
// has not been captured yet. R30.M4 needs SCI_INT to be the actual
// SCI, so the offsets are corrected here and the fixture in
// tests/kernel/acpi/fadt_synth.pdx is moved with them.
//
// Field-offset variance across FADT revisions: FADT rev 1 (ACPI 1.0)
// is 116 bytes and lacks reset support + X_* fields. Rev 3+ (ACPI 2.0+)
// pads out to ≥244 bytes with the extended GAS forms. R20 preboot
// firmware on our target hardware ships FADT rev 6 (ACPI 6.x), but
// we defensively length-gate every field beyond +100 so a rev-1 or
// truncated FADT does not walk off the table.
//
// -----------------------------------------------------------------------------
// Preferred-form policy (X_* vs legacy)
// -----------------------------------------------------------------------------
//
// ACPI 2.0+ introduced the GAS-encoded X_* fields specifically to
// support platforms whose PM registers live in memory-mapped space
// (address_space=0) or above the low-64K I/O window; on legacy PCs
// these X_* fields duplicate the u32 legacy port for the same
// resource, and OSPMs are directed to prefer X_* when non-zero.
// fadt_parse implements the ACPI 6.5 §4.1.3 rule:
//   effective_pm1a_cnt = gas_is_valid(X_PM1a_CNT_BLK) ? X_.address : PM1a_CNT_BLK
//   effective_pm_tmr   = gas_is_valid(X_PM_TMR_BLK)   ? X_.address : PM_TMR_BLK
// Only the low 16 bits of the resolved address are used — ACPI PM
// registers on x86 are I/O-space with 16-bit port numbers.
//
// -----------------------------------------------------------------------------
// fadt_info decoded layout (64 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0   u64 reset_port           — GAS.address of RESET_REG (u64 for MMIO capacity)
//   +8   u16 pm1a_cnt_port        — resolved (X_ preferred), truncated to u16
//   +10  u16 pm1b_cnt_port        — legacy PM1b_CNT_BLK truncated to u16
//   +12  u16 pm_tmr_port          — resolved (X_ preferred), truncated to u16
//   +14  u16 sci_int              — SCI GSI (typically 9)
//   +16  u8  pm_tmr_len           — bytes wide (4 = 32-bit counter)
//   +17  u8  reset_value          — byte to write to reset_port
//   +18  u8  century              — CMOS index of century byte (0 if none)
//   +19  u8  _pad0
//   +20  u32 _pad1
//   +24  u16 gpe0_blk_port       — resolved (X_ preferred), truncated to u16
//   +26  u16 gpe1_blk_port       — resolved (X_ preferred), truncated to u16
//   +28  u8  gpe0_blk_len        — WHOLE block width in bytes (STS half + EN half)
//   +29  u8  gpe1_blk_len        — likewise
//   +30  u8  gpe1_base           — first flat GPE index GPE1 owns
//   +31  u8  _pad2
//   +32  u64 facs_addr           — R31.M6-#1580: resolved (X_ preferred) FACS host VA
//                                  (Global Lock word lives at +0x10; FACS Flags at +0x14)
//   +40  u16 pm1a_evt_port       — R31.M6-#1580: PM1a_EVT_BLK (STS half); PM1_STS bit 5 = GBL_STS
//   +42  u16 pm1b_evt_port       — R31.M6-#1580: PM1b_EVT_BLK, 0 when absent
//   +44  u8  pm1_evt_len         — R31.M6-#1580: WHOLE block width; halves are STS then EN
//   +45  u8  _pad3
//   +46  u16 _pad4
//   +48..63  u64 _reserved[2]    — reserved for R21 (S5 SLP_TYPx/SLP_EN cache)
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.20.1+)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 zero-init at _pad1.
//   G4: cmp al, imm may miscompile → full-register compares throughout.
//
// -----------------------------------------------------------------------------
// Register plan (3-push + 16 B gas scratch = 40 B, rsp%16==0 at gas_read calls)
// -----------------------------------------------------------------------------
//
//   rbx = out ptr (arg2)
//   r12 = fadt ptr (arg1)
//   r13 = &gas_info scratch (rsp+0 after the sub)

module Fadt = structure {

  // ============================================================================
  // Layout constants — FADT source offsets
  // ============================================================================

  pub let FADT_OFFSET_FIRMWARE_CTRL   : u64 = 36
  pub let FADT_OFFSET_DSDT            : u64 = 40
  pub let FADT_OFFSET_SCI_INT         : u64 = 46
  pub let FADT_OFFSET_PM1A_EVT_BLK    : u64 = 56
  pub let FADT_OFFSET_PM1B_EVT_BLK    : u64 = 60
  pub let FADT_OFFSET_PM1A_CNT_BLK    : u64 = 64
  pub let FADT_OFFSET_PM1B_CNT_BLK    : u64 = 68
  pub let FADT_OFFSET_PM2_CNT_BLK     : u64 = 72
  pub let FADT_OFFSET_PM_TMR_BLK      : u64 = 76
  pub let FADT_OFFSET_GPE0_BLK        : u64 = 80
  pub let FADT_OFFSET_GPE1_BLK        : u64 = 84
  pub let FADT_OFFSET_PM1_EVT_LEN     : u64 = 88
  pub let FADT_OFFSET_PM_TMR_LEN      : u64 = 91
  pub let FADT_OFFSET_GPE0_BLK_LEN    : u64 = 92
  pub let FADT_OFFSET_GPE1_BLK_LEN    : u64 = 93
  pub let FADT_OFFSET_GPE1_BASE       : u64 = 94
  pub let FADT_OFFSET_CENTURY         : u64 = 108
  pub let FADT_OFFSET_RESET_REG       : u64 = 116
  pub let FADT_OFFSET_RESET_VALUE     : u64 = 128
  pub let FADT_OFFSET_X_FIRMWARE_CTRL : u64 = 132
  pub let FADT_OFFSET_X_PM1A_CNT_BLK  : u64 = 172
  pub let FADT_OFFSET_X_PM_TMR_BLK    : u64 = 208
  pub let FADT_OFFSET_X_GPE0_BLK      : u64 = 220
  pub let FADT_OFFSET_X_GPE1_BLK      : u64 = 232

  // Length gates — earliest table byte AFTER each field.
  pub let FADT_MIN_LENGTH_LEGACY      : u64 = 116   // through CENTURY inclusive rev 1
  pub let FADT_MIN_LENGTH_RESET       : u64 = 129   // through RESET_VALUE
  pub let FADT_MIN_LENGTH_X_FW_CTRL   : u64 = 140   // 132 + 8
  pub let FADT_MIN_LENGTH_X_PM1A_CNT  : u64 = 184   // 172 + 12
  pub let FADT_MIN_LENGTH_X_PM_TMR    : u64 = 220   // 208 + 12
  pub let FADT_MIN_LENGTH_X_GPE0      : u64 = 232   // 220 + 12
  pub let FADT_MIN_LENGTH_X_GPE1      : u64 = 244   // 232 + 12

  // fadt_info offsets.
  pub let FADT_INFO_SIZE_BYTES        : u64 = 64
  pub let FADT_INFO_OFFSET_RESET_PORT : u64 = 0
  pub let FADT_INFO_OFFSET_PM1A_CNT   : u64 = 8
  pub let FADT_INFO_OFFSET_PM1B_CNT   : u64 = 10
  pub let FADT_INFO_OFFSET_PM_TMR     : u64 = 12
  pub let FADT_INFO_OFFSET_SCI_INT    : u64 = 14
  pub let FADT_INFO_OFFSET_PM_TMR_LEN : u64 = 16
  pub let FADT_INFO_OFFSET_RESET_VAL  : u64 = 17
  pub let FADT_INFO_OFFSET_CENTURY    : u64 = 18
  pub let FADT_INFO_OFFSET_GPE0_PORT  : u64 = 24
  pub let FADT_INFO_OFFSET_GPE1_PORT  : u64 = 26
  pub let FADT_INFO_OFFSET_GPE0_LEN   : u64 = 28
  pub let FADT_INFO_OFFSET_GPE1_LEN   : u64 = 29
  pub let FADT_INFO_OFFSET_GPE1_BASE  : u64 = 30
  // R31.M6-#1580: the addresses the Global Lock protocol needs. facs_addr
  // is the u64 the ring-3 aml_glk binding runs its 32-bit compare-exchange
  // at +0x10 of; pm1a_evt_port is the u16 whose STS half carries GBL_STS
  // (bit 5) — the release signal firmware raises after dropping a lock we
  // marked Pending. All three came out of the FADT and were parsed and
  // then dropped before this milestone; the pin the lack of them held is
  // in src/kernel/core/drivers/ec/ec_access.pdx as ec_access_arbitrated().
  pub let FADT_INFO_OFFSET_FACS_ADDR  : u64 = 32
  pub let FADT_INFO_OFFSET_PM1A_EVT   : u64 = 40
  pub let FADT_INFO_OFFSET_PM1B_EVT   : u64 = 42
  pub let FADT_INFO_OFFSET_PM1_EVT_LEN : u64 = 44

  // ============================================================================
  // fadt_parse — decode FADT into a 64-byte fadt_info
  // ============================================================================
  //
  // SysV: (fadt: u64, out: u64) -> u64
  //
  //   rdi = FADT base (a valid *sdt_hdr signature "FACP"; caller MUST
  //         checksum-validate via acpi_checksum_ok).
  //   rsi = pointer to a 64-byte fadt_info (caller-allocated, @align(8) preferred).
  //
  // Returns rax = 1 if parse succeeded (out fully populated with at
  // least PM_TMR resolvable), else 0.
  //
  // Failure modes:
  //   - fadt == 0 or out == 0                                → 0
  //   - fadt->length < FADT_MIN_LENGTH_LEGACY (116)          → 0
  //   - resolved pm_tmr_port == 0                            → 0
  //     (no PM timer means no basic wall-clock — the parse
  //     is useless to R21+ callers.)
  //
  // Length-gated extension fields (each gated independently, absent
  // fields leave zero in the corresponding out slot):
  //   RESET_REG + RESET_VALUE: only if length >= FADT_MIN_LENGTH_RESET.
  //   X_PM1A_CNT_BLK:          only if length >= FADT_MIN_LENGTH_X_PM1A_CNT.
  //   X_PM_TMR_BLK:            only if length >= FADT_MIN_LENGTH_X_PM_TMR.
  //   X_GPE0_BLK / X_GPE1_BLK: only if length >= FADT_MIN_LENGTH_X_GPE0 / _X_GPE1,
  //                            and only when the GAS address is non-zero.
  //
  // Field-truncation policy: the legacy u32 PM_*_BLK fields are
  // masked to their low 16 bits (`and rax, 0xFFFF`) before being
  // stored as u16 into out — ACPI x86 PM registers live in the
  // 16-bit I/O port space. GAS-resolved addresses are similarly
  // truncated at the store site: X_ forms may in principle be
  // MMIO (address_space=0), but the first R20.M3 consumer (R21.M5
  // ACPI PM timer) only knows how to do IN/OUT so we drop the
  // upper bits. R22+ will re-parse from the raw GAS when MMIO
  // PM registers become a real concern.

  pub let fadt_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (fadt: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R31.M6-#1580 ADDENDUM: reads FIRMWARE_CTRL (u32 @ +36, zero-extended) and, when length >= 140 and non-zero, X_FIRMWARE_CTRL (u64 @ +132) into out+32 as facs_addr; reads PM1a_EVT_BLK (u32 @ +56 masked to u16) into out+40, PM1b_EVT_BLK (u32 @ +60 masked to u16) into out+42, and PM1_EVT_LEN (u8 @ +88) into out+44. These are the three addresses the ACPI Global Lock protocol needs: the FACS holds the 32-bit lock word at +0x10, PM1_CNT carries the GBL_RLS doorbell, and PM1_EVT (STS half) carries the GBL_STS release signal. The parser reading them here is what makes ec_access_arbitrated() switchable from 0 to 1 by ec_access_bind_arbitration; before this milestone the fields were declared and never dereferenced, so the whole aml_glk protocol was inert in a real boot even though thoroughly witnessed in the corpus. Zero-extension for the u32 and the X_-absent-means-zero guard mirror the identical treatment of X_GPE0/GPE1 below. R20-M3-002 (#815). Parse ACPI FADT into a 64-byte fadt_info. Null-guards on both pointers. Length guard: fadt->length (u32 @ +4, zero-extended) must be >= FADT_MIN_LENGTH_LEGACY (116) — the ACPI 1.0 minimum, below which even the SCI_INT/PM_TMR_BLK fields are not spec-guaranteed present. Extraction path: (1) Zero the 64-byte out buffer upfront (8× plain u64 stores) so length-gated absent fields read as 0 for callers. (2) Legacy always-present fields (offsets < 116): SCI_INT (u16 @ +46 → u16 @ out+14 via mov_w after xor+mov_w zero-extension), PM1A_CNT_BLK (u32 @ +64 masked to u16 → u16 @ out+8), PM1B_CNT_BLK (u32 @ +68 masked to u16 → u16 @ out+10), PM_TMR_BLK (u32 @ +76 masked to u16 → u16 @ out+12), GPE0_BLK (u32 @ +80 masked to u16 → u16 @ out+24), GPE1_BLK (u32 @ +84 masked to u16 → u16 @ out+26), PM_TMR_LEN (u8 @ +91 → u8 @ out+16), GPE0_BLK_LEN (u8 @ +92 → u8 @ out+28), GPE1_BLK_LEN (u8 @ +93 → u8 @ out+29), GPE1_BASE (u8 @ +94 → u8 @ out+30), CENTURY (u8 @ +108 → u8 @ out+18). R30.M4-001 (#1066) corrected every one of these offsets: the R20.M3 table counted the 36-byte SDT header as 40 bytes and displaced the whole PM run, and the synthetic fixture was fabricated to match, so the two agreed with each other and with no real firmware. (3) If length >= FADT_MIN_LENGTH_RESET (129): gas_read(fadt+116, &scratch) — if valid, reset_port (u64 @ out+0) = scratch.address; RESET_VALUE (u8 @ +128) → u8 @ out+17. If gas_read fails, leave reset_port zero — the caller (R21 shutdown path) will fall back to the 0xCF9 PCI reset port. (4) If length >= FADT_MIN_LENGTH_X_PM1A_CNT (184): gas_read(fadt+172, &scratch) — if valid, overwrite pm1a_cnt_port with scratch.address masked to 16 bits (X_ form preferred per ACPI 6.5 §4.1.3). (5) If length >= FADT_MIN_LENGTH_X_PM_TMR (220): same for X_PM_TMR_BLK at +208 overwriting pm_tmr_port. (5b) If length >= 232 / 244: the same preferred-form rule for X_GPE0_BLK at +220 and X_GPE1_BLK at +232, with one added guard -- a GAS whose address is 0 is treated as ABSENT rather than as an override to port 0, because firmware routinely leaves the X_ form of a block it does not implement zeroed and honouring that literally would replace a valid legacy port with 0. (6) Final sanity: pm_tmr_port must be non-zero — if the resolved value is 0 (rare firmware bug where both legacy PM_TMR_BLK and X_PM_TMR_BLK are 0), return 0 to signal 'FADT present but PM subsystem unusable'. Stack: 3-push callee-save (rbx=out, r12=fadt, r13=&gas_scratch) + sub rsp, 16 = 40B on top of entry rsp%16==8 → rsp%16==0 pre-call to gas_read, SysV-conformant. Encoder-gap workarounds: G1 (mov_d for u32 zero at out+20), G4 (full-reg compares).",
      block: {
        // Null-guards before any spill.
        cmp rdi, 0;
        je  fadt_parse_fail_early;
        cmp rsi, 0;
        je  fadt_parse_fail_early;

        push rbx;
        push r12;
        push r13;
        sub rsp, 16;                           // 16-byte gas_info scratch

        mov r12, rdi;                          // r12 = fadt base
        mov rbx, rsi;                          // rbx = out base
        mov r13, rsp;                          // r13 = &gas_scratch

        // ---- Length guard: fadt->length >= 116 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 116;
        jb  fadt_parse_fail;

        // ---- Zero out[0..64) ----
        xor rax, rax;
        mov [rbx + 0], rax;
        mov [rbx + 8], rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;
        mov [rbx + 32], rax;
        mov [rbx + 40], rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        // ---- SCI_INT (u16 @ +46) → u16 @ out+14 ----
        xor rax, rax;
        mov_w rax, [r12 + 46];
        mov_w [rbx + 14], rax;

        // ---- PM1A_CNT_BLK (u32 @ +64, low 16b) → u16 @ out+8 ----
        mov eax, [r12 + 64];                   // 32-bit load zero-extends
        and rax, 0xFFFF;
        mov_w [rbx + 8], rax;

        // ---- PM1B_CNT_BLK (u32 @ +68, low 16b) → u16 @ out+10 ----
        mov eax, [r12 + 68];
        and rax, 0xFFFF;
        mov_w [rbx + 10], rax;

        // ---- PM_TMR_BLK (u32 @ +76, low 16b) → u16 @ out+12 ----
        mov eax, [r12 + 76];
        and rax, 0xFFFF;
        mov_w [rbx + 12], rax;

        // ---- GPE0_BLK (u32 @ +80, low 16b) → u16 @ out+24 ----
        mov eax, [r12 + 80];
        and rax, 0xFFFF;
        mov_w [rbx + 24], rax;

        // ---- GPE1_BLK (u32 @ +84, low 16b) → u16 @ out+26 ----
        mov eax, [r12 + 84];
        and rax, 0xFFFF;
        mov_w [rbx + 26], rax;

        // ---- PM_TMR_LEN (u8 @ +91) → u8 @ out+16 ----
        xor rax, rax;
        mov_b rax, [r12 + 91];
        mov_b [rbx + 16], rax;

        // ---- GPE0_BLK_LEN (u8 @ +92) → u8 @ out+28 ----
        xor rax, rax;
        mov_b rax, [r12 + 92];
        mov_b [rbx + 28], rax;

        // ---- GPE1_BLK_LEN (u8 @ +93) → u8 @ out+29 ----
        xor rax, rax;
        mov_b rax, [r12 + 93];
        mov_b [rbx + 29], rax;

        // ---- GPE1_BASE (u8 @ +94) → u8 @ out+30 ----
        xor rax, rax;
        mov_b rax, [r12 + 94];
        mov_b [rbx + 30], rax;

        // ---- CENTURY (u8 @ +108) → u8 @ out+18 ----
        xor rax, rax;
        mov_b rax, [r12 + 108];
        mov_b [rbx + 18], rax;

        // ---- R31.M6-#1580: FIRMWARE_CTRL (u32 @ +36, zero-extended) → u64 @ out+32
        //      This is the 32-bit legacy FACS pointer. If X_FIRMWARE_CTRL
        //      (below) is present and non-zero it will supersede this per
        //      ACPI 6.5 §5.2.9. The store is a full u64 so a later X_
        //      overwrite (also u64) leaves the whole slot in a defined
        //      state whether X_ was 32-bit-fitting or wider.
        xor rax, rax;
        mov eax, [r12 + 36];
        mov [rbx + 32], rax;

        // ---- R31.M6-#1580: PM1a_EVT_BLK (u32 @ +56, low 16b) → u16 @ out+40
        //      PM1_STS bit 5 (GBL_STS = 0x0020) is the release signal firmware
        //      raises when it drops a lock we marked Pending. The STS half is
        //      the low half of the block; the EN half is the high half at
        //      (port + pm1_evt_len/2). aml_glk_signalled reads it as a u16.
        mov eax, [r12 + 56];
        and rax, 0xFFFF;
        mov_w [rbx + 40], rax;

        // ---- PM1b_EVT_BLK (u32 @ +60, low 16b) → u16 @ out+42 ----
        mov eax, [r12 + 60];
        and rax, 0xFFFF;
        mov_w [rbx + 42], rax;

        // ---- PM1_EVT_LEN (u8 @ +88) → u8 @ out+44 ----
        xor rax, rax;
        mov_b rax, [r12 + 88];
        mov_b [rbx + 44], rax;

        // ---- Reset support gate: length >= 129 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 129;
        jb  fadt_skip_reset;

        // gas_read(fadt+116, &scratch)
        mov rdi, r12;
        add rdi, 116;
        mov rsi, r13;
        call gas_read;
        cmp rax, 1;
        jne fadt_skip_reset;                   // GAS invalid — leave reset_port=0

        // reset_port (u64 @ out+0) = scratch.address (u64 @ scratch+0)
        mov rax, [r13 + 0];
        mov [rbx + 0], rax;

        // RESET_VALUE (u8 @ +128) → u8 @ out+17
        xor rax, rax;
        mov_b rax, [r12 + 128];
        mov_b [rbx + 17], rax;

      fadt_skip_reset:

        // ---- R31.M6-#1580: X_FIRMWARE_CTRL gate: length >= 140 ----
        //      X_FIRMWARE_CTRL is the 64-bit superseding pointer for FACS
        //      on parts whose FACS lives above the low 4 GiB. ACPI 6.5
        //      §5.2.9 rules: X_FIRMWARE_CTRL is preferred whenever it is
        //      non-zero. A zero X_ is "absent, use legacy", NOT "override
        //      to null" — the same guard the X_GPE0/GPE1 blocks below use.
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 140;
        jb  fadt_skip_x_fw_ctrl;

        mov rax, [r12 + 132];
        cmp rax, 0;
        je  fadt_skip_x_fw_ctrl;               // zero X_ form: keep legacy
        mov [rbx + 32], rax;                   // overwrite facs_addr

      fadt_skip_x_fw_ctrl:

        // ---- X_PM1A_CNT_BLK gate: length >= 184 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 184;
        jb  fadt_skip_x_pm1a;

        mov rdi, r12;
        add rdi, 172;
        mov rsi, r13;
        call gas_read;
        cmp rax, 1;
        jne fadt_skip_x_pm1a;

        // Overwrite pm1a_cnt_port with X_ form (low 16b of scratch.address).
        mov rax, [r13 + 0];
        and rax, 0xFFFF;
        mov_w [rbx + 8], rax;

      fadt_skip_x_pm1a:

        // ---- X_PM_TMR_BLK gate: length >= 220 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 220;
        jb  fadt_skip_x_pm_tmr;

        mov rdi, r12;
        add rdi, 208;
        mov rsi, r13;
        call gas_read;
        cmp rax, 1;
        jne fadt_skip_x_pm_tmr;

        mov rax, [r13 + 0];
        and rax, 0xFFFF;
        mov_w [rbx + 12], rax;

      fadt_skip_x_pm_tmr:

        // ---- X_GPE0_BLK gate: length >= 232 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 232;
        jb  fadt_skip_x_gpe0;

        mov rdi, r12;
        add rdi, 220;
        mov rsi, r13;
        call gas_read;
        cmp rax, 1;
        jne fadt_skip_x_gpe0;

        mov rax, [r13 + 0];
        cmp rax, 0;
        je  fadt_skip_x_gpe0;                  // zero X_ form is "absent", not an override
        and rax, 0xFFFF;
        mov_w [rbx + 24], rax;

      fadt_skip_x_gpe0:

        // ---- X_GPE1_BLK gate: length >= 244 ----
        xor rax, rax;
        mov eax, [r12 + 4];
        cmp rax, 244;
        jb  fadt_skip_x_gpe1;

        mov rdi, r12;
        add rdi, 232;
        mov rsi, r13;
        call gas_read;
        cmp rax, 1;
        jne fadt_skip_x_gpe1;

        mov rax, [r13 + 0];
        cmp rax, 0;
        je  fadt_skip_x_gpe1;
        and rax, 0xFFFF;
        mov_w [rbx + 26], rax;

      fadt_skip_x_gpe1:

        // ---- Final: pm_tmr_port must be non-zero ----
        xor rax, rax;
        mov_w rax, [rbx + 12];
        cmp rax, 0;
        je  fadt_parse_fail;

        // ---- _pad1 (u32 @ out+20) = 0 explicitly via mov_d (G1) ----
        xor rax, rax;
        mov_d [rbx + 20], rax;

        // Success.
        mov rax, 1;
        add rsp, 16;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fadt_parse_fail:
        xor rax, rax;
        add rsp, 16;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fadt_parse_fail_early:
        xor rax, rax;
        ret
      }
    }
}
