// src/kernel/devices/display/gop_fb_console.pdx — R111.M4-015 (#2367)
//
// Minimal GOP-framebuffer console for the T14 boot wave (M4).  Provides
// the assertable wire-fingerprint that says "the UEFI GOP handoff arrived
// and the LFB was mapped WC into the higher-half MMIO window", plus a
// public gop_fb_console_puts entry point that any future boot-side
// mirror hook can hand bytes to.  Distinct from src/kernel/core/drivers/
// fb_console.pdx (R23) — that subsystem owns the ANSI-capable, scrolling,
// klog-mirroring terminal; this one is a stub-font blitter whose sole
// production consumer at this landing is its own init fingerprint.
//
// Round: R111.M4 — T14 G4 boot wave, M4-015
// Roadmap: design/roadmap/r111-t14-boot-wave.md (task #2367)
// Encoder floor: paideia-as v0.36+.
//
// -----------------------------------------------------------------------------
// Handoff contract
// -----------------------------------------------------------------------------
//
// gop_fb_console_init reads _boot_env_pa (owned by src/kernel/kernel_main_
// uefi.pdx KernelMainUefi module, latched from the RDI arg on the UEFI
// entry).  Under UEFI the finalizer at src/boot/uefi_stub.pdx populates
// _boot_env_pa with the PA of a boot_env_t whose fb sub-struct
// (src/boot/uefi_env.pdx fb_desc_t at boot_env + 16) carries the GOP-
// reported LFB geometry:
//
//   fb_desc_t {                       // offset within boot_env
//     u64 base_pa;                    //  +16   (fb + 0)
//     u64 size;                       //  +24   (fb + 8)
//     u32 pitch;                      //  +32   (fb + 16)  -- bytes/scanline
//     u32 width;                      //  +36   (fb + 20)  -- pixels
//     u32 height;                     //  +40   (fb + 24)  -- pixels
//     u32 format;                     //  +44   (fb + 28)  -- EFI_PIXEL_*
//   };
//
// Under the PVH `-kernel` boot path _boot_env_pa stays 0 and this module
// takes the OFF arm: emit "FB CONSOLE OFF" and return.  Every downstream
// caller of gop_fb_console_puts gates on _gop_fb_console_active, so the
// module stays dormant end-to-end under PVH with zero visible behavior
// change.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
// Success (UEFI + GOP + platform_mmio_map succeeds):
//   Line 1 (klog_s1_d3):
//     "FB CONSOLE OK width=<n> height=<n> bpp=<n>"
//   Line 2 (klog_s1_x1):
//     "fb console base base=0x<...>"
//
// Skip (PVH, or GOP absent, or LFB map failure):
//   "FB CONSOLE OFF"
//
// Only the tag "FB CONSOLE OK" carries the OK token that
// tools/verify-fingerprint-coverage.sh flags — see the sibling
// allowlist entry at that file for this landing's live-verified reason
// (no OVMF smoke mode boots past ExitBootServices yet).
//
// -----------------------------------------------------------------------------
// Font
// -----------------------------------------------------------------------------
//
// M4-015 lands a 2 KiB stub font (128 glyphs × 16 bytes/glyph = ASCII
// 0x20..0x9F range if extended, or 0x00..0x7F literally).  The blob is
// declared `mut` so it lands in .bss (zero-initialized at load) rather
// than requiring 2 048 explicit hex bytes in the source; consumers will
// observe an all-clear font (every glyph renders as background = no
// visible pixels) until the real font blob lands in a follow-up under
// R111.M4-016 (or by consuming src/kernel/core/drivers/fb_font.pdx's
// already-embedded vga8x16.bin blob directly).  The stub font landing
// keeps gop_fb_console_puts's address-arithmetic path exercised
// end-to-end so the real font swap is a data-only change.
//
// -----------------------------------------------------------------------------
// Encoder-pitfall discipline (feedback_pdx_encoder_pitfalls)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` — use `cmp rN, 0` (jz/jnz on the flag).
//   * No 2-op `imul r, imm` — use `mov r, imm; imul r, r`.
//   * No `and reg, imm64` — mask via `mov rax, imm64; and rN, rax`.
//   * No `cmp reg, [mem]` — load into a register first.
//   * Byte-load-zero pattern: `xor rax, rax; mov_b rax, [mem]`.
//
// Reserved label prefix: `gop_fb_` to avoid clashes with the R23 fb_console
// module's `fb_console_*` and fb_glyph module's `draw_glyph_*` labels.

module GopFbConsole = structure {

  // ==========================================================================
  // .rodata strings — tags + keys for this module's fingerprint lines
  // ==========================================================================
  //
  // Locally scoped (per the bochs_stdvga module's precedent — see
  // src/kernel/core/drivers/gfx/bochs_stdvga/modeset.pdx bochs_k_width /
  // bochs_k_height) rather than promoted to klog/keys.pdx: this module is
  // the sole consumer today, and the fingerprint-coverage gate matches on
  // string content, not on symbol identity.

  pub let gop_fb_ok_msg   : [u8; 14] = "FB CONSOLE OK\0"
  pub let gop_fb_off_msg  : [u8; 15] = "FB CONSOLE OFF\0"
  pub let gop_fb_base_msg : [u8; 16] = "fb console base\0"

  pub let gop_fb_k_width  : [u8; 6] = "width\0"
  pub let gop_fb_k_height : [u8; 7] = "height\0"
  pub let gop_fb_k_bpp    : [u8; 4] = "bpp\0"
  pub let gop_fb_k_base   : [u8; 5] = "base\0"

  // ==========================================================================
  // Runtime state (.bss)
  // ==========================================================================
  //
  // Every slot zero-initialized at load; latched by gop_fb_console_init on
  // the OK arm and consumed by gop_fb_console_puts.
  //
  // _gop_fb_console_active is the gate every consumer reads before touching
  // any other slot — an OFF-arm boot leaves every field at zero and puts()
  // takes the load+compare early-out.

  pub let mut _gop_fb_console_active : u64 = 0

  // Framebuffer geometry, latched from boot_env->fb.
  pub let mut _gop_fb_base_pa     : u64 = 0
  pub let mut _gop_fb_ptr         : u64 = 0     // higher-half kernel VA
  pub let mut _gop_fb_stride      : u64 = 0     // bytes per scanline
  pub let mut _gop_fb_width       : u64 = 0     // pixels
  pub let mut _gop_fb_height      : u64 = 0     // pixels
  pub let mut _gop_fb_pixel_bytes : u64 = 0     // 4 for 32-bpp
  pub let mut _gop_fb_bpp         : u64 = 0     // 32 for BGR_8888 / RGB_8888

  // Cursor grid (in glyph coordinates, one 8x16 cell per position).
  pub let mut _gop_fb_cursor_x    : u64 = 0
  pub let mut _gop_fb_cursor_y    : u64 = 0
  pub let mut _gop_fb_cols        : u64 = 0     // width  / 8
  pub let mut _gop_fb_rows        : u64 = 0     // height / 16

  // ==========================================================================
  // Stub 8x16 bitmap font — 2 KiB (128 glyphs × 16 bytes)
  // ==========================================================================
  //
  // Row-major, glyph-major.  Byte at offset (glyph_idx * 16 + row_idx) holds
  // the 8-pixel bitmap for row row_idx (bit 7 = leftmost pixel).  Declared
  // `mut` + uninit so it lands in .bss (zero-initialized at load, same
  // wire semantics as a `.rodata` blob of 2 048 zero bytes) — the real
  // vga8x16 blob lands in a follow-up (see file preamble §Font).
  //
  // @align(64) matches the R23 fb_font.pdx precedent so a 64-byte
  // cacheline holds exactly one glyph's 16 rows (padded up).

  pub let mut _gop_fb_font : [u8; 2048] = uninit @align(64)

  // ==========================================================================
  // gop_fb_console_init() -> ()
  // ==========================================================================
  //
  // 1. Read _boot_env_pa; if 0 (PVH), emit "FB CONSOLE OFF" and return.
  // 2. Read fb.base_pa (env+16); if 0, emit "FB CONSOLE OFF" and return.
  // 3. Read fb.size (env+24); if 0, emit "FB CONSOLE OFF" and return.
  // 4. Load geometry: pitch (u32 @ env+32), width (u32 @ env+36),
  //    height (u32 @ env+40), format (u32 @ env+44).
  // 5. Derive bpp: format 0 (RGB_8888) or 1 (BGR_8888) -> 32; else 32
  //    fallback (paideia's target platforms all publish 32-bpp today).
  // 6. Call platform_mmio_map(base_pa, size, MMIO_WC=1) to acquire a
  //    higher-half VA at PML4[321].  Failure (rax == 0) takes the OFF arm.
  // 7. Latch state slots; emit the two-line success fingerprint.
  //
  // Register discipline: leaf-shape, no callee-save prologue.  Rax/rcx/
  // rdx/rsi/rdi/r8-r11 are all clobber-safe across the body's own calls
  // (platform_mmio_map / klog_s1_* wrappers).  Every value survives across
  // a call by re-loading from the .bss slot.  Stack alignment matches the
  // phase1_emit_rsdp_fingerprint precedent: entry rsp%16==8, single-push
  // pattern for klog_s1_x1_d1 / klog_s1_x1 emits, 3-push pattern for
  // klog_s1_d3.

  pub let gop_fb_console_init : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M4-015 (paideia-os #2367): Read _boot_env_pa (owned by KernelMainUefi module, PA of boot_env_t under UEFI, 0 under PVH). Under PVH short-circuit to OFF-arm: klog_s1(INFO, BOOT, gop_fb_off_msg) then ret. Under UEFI load fb.base_pa from env+16, fb.size from env+24; each 0-check joins the OFF arm. Load 32-bit geometry (pitch, width, height, format) via `xor r,r; mov e*, [env+off]` idiom which zero-extends per SDM Vol.1 §3.4.1.1 — no mov_bzx equivalent needed for u32 loads. Derive bpp from format (EFI_PIXEL_RGB_8888=0 / EFI_PIXEL_BGR_8888=1 -> 32; other values -> 32 fallback since UEFI's remaining formats EFI_PIXEL_BITMASK=2 and EFI_PIXEL_BLT_ONLY=3 are impractical on paideia's target platforms). Compute pixel_bytes = bpp / 8, cols = width / 8, rows = height / 16 via shr (8-bit divisors are all powers of 2). Map LFB via platform_mmio_map(base_pa, size, MMIO_WC=1) — same WC selector fb_map_lfb / bochs_stdvga_lfb_map use, so PAT slot 4=WC applies uniformly across the display substrate. platform_mmio_map returns 0 on hard failure (MAP_OOM / MAP_OVERLAP), pa_base on the MAP_HUGE identity-VA fallback (boot huge-page identity map covers < 4 GiB), or a fresh higher-half VA at PML4[321] otherwise. 0-return joins the OFF arm; any non-zero return is treated as success. Latch _gop_fb_ptr, _gop_fb_base_pa, _gop_fb_stride, _gop_fb_width, _gop_fb_height, _gop_fb_pixel_bytes, _gop_fb_bpp, _gop_fb_cols, _gop_fb_rows; set _gop_fb_console_active=1 last (barrier: readers gate on _gop_fb_console_active, so latching it after the geometry slots keeps puts()'s read of the state from racing with init's writes even though there is no interrupt to preempt boot-time init). Emit two fingerprint lines: Line 1 klog_s1_d3(INFO, BOOT, gop_fb_ok_msg, k_width, width, k_height, [stack: height, k_bpp, bpp]) — the OK-token line that satisfies the fingerprint-coverage gate; Line 2 klog_s1_x1(INFO, BOOT, gop_fb_base_msg, k_base, base_pa) — the hex physical-address companion (base_msg contains no OK token so it does not trip the gate independently). Stack alignment: entry rsp%16==8. platform_mmio_map has no stack args (3 register args); pre-call `sub rsp, 8` -> rsp%16==0; post-call `add rsp, 8` -> rsp%16==8. klog_s1_d3 pushes 3 stack args (v3=bpp, k3=k_bpp, v2=height in reverse order so [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3): rsp%16 8->0->8->0 pre-call. Post-call add rsp,24 -> rsp%16==8. klog_s1_x1 needs no stack args; pre-call sub rsp,8 -> rsp%16==0. klog_s1 (OFF arm) needs no stack args; pre-call sub rsp,8 -> rsp%16==0. Encoder posture (v0.36+): push/pop / mov reg,reg / mov reg,imm32/imm64 / mov r64,[rip+sym] / lea r64,[rip+sym] / xor r,r / shr r64,imm8 / cmp r64,imm8/imm32 / je/jne/jmp / call rel32 / ret. No test rN,rN. No 2-op imul r,imm. No and reg,imm64. No cmp reg,[mem]. Reserved label prefix: gop_fb_.",
      block: {
        // ================================================================
        // Phase 1: read _boot_env_pa; OFF short-circuit under PVH.
        // ================================================================

        mov rax, [rip + _boot_env_pa];
        cmp rax, 0;
        je  gop_fb_emit_off;

        // ================================================================
        // Phase 2: load fb.base_pa (env+16) and fb.size (env+24).
        // ================================================================
        //
        // Both are u64.  A zero base_pa or size joins the OFF arm — GOP
        // was absent, malformed, or capture failed.

        mov r10, [rax + 16];                    // r10 = fb.base_pa
        cmp r10, 0;
        je  gop_fb_emit_off;

        mov r11, [rax + 24];                    // r11 = fb.size
        cmp r11, 0;
        je  gop_fb_emit_off;

        // Latch base_pa (survives platform_mmio_map's caller-save clobber
        // via the .bss slot; every consumer reads the slot, not the reg).
        mov [rip + _gop_fb_base_pa], r10;

        // ================================================================
        // Phase 3: load u32 geometry into u64 slots.
        // ================================================================
        //
        // fb_desc_t offsets within boot_env:
        //   pitch   u32 @ env + 32
        //   width   u32 @ env + 36
        //   height  u32 @ env + 40
        //   format  u32 @ env + 44
        //
        // The `mov eXX, [mem]` form auto-zero-extends into the full r64
        // (x86-64 SDM Vol.1 §3.4.1.1).  We use `xor r,r; mov er, [mem]`
        // to make the zero-extension unambiguous in the encoder.

        xor rcx, rcx;
        mov ecx, [rax + 32];                    // rcx = pitch
        mov [rip + _gop_fb_stride], rcx;

        xor rcx, rcx;
        mov ecx, [rax + 36];                    // rcx = width
        mov [rip + _gop_fb_width], rcx;

        // cols = width / 8 = width >> 3
        shr rcx, 3;
        mov [rip + _gop_fb_cols], rcx;

        // Reload rax = _boot_env_pa (was clobbered? no — rax still holds
        // env_pa since we've only touched rcx / r10 / r11.  Reload
        // defensively so any future insertion between reads doesn't
        // silently break addressing.)
        mov rax, [rip + _boot_env_pa];

        xor rcx, rcx;
        mov ecx, [rax + 40];                    // rcx = height
        mov [rip + _gop_fb_height], rcx;

        // rows = height / 16 = height >> 4
        shr rcx, 4;
        mov [rip + _gop_fb_rows], rcx;

        // Format-derived bpp: today's target formats (RGB_8888=0,
        // BGR_8888=1) are both 32-bpp; the bitmask (2) / blt-only (3)
        // paths would land here with the same 32 fallback.  The format
        // u32 at env+44 is not consulted until a future format lands
        // that dispatches to a different bpp — at that point this
        // block grows a cmp / je table keyed on format.  Left as a
        // constant assignment for the M4-015 stub scope.
        mov rcx, 32;
        mov [rip + _gop_fb_bpp], rcx;
        mov rcx, 4;
        mov [rip + _gop_fb_pixel_bytes], rcx;

        // ================================================================
        // Phase 4: map the LFB into the higher-half MMIO window (WC).
        // ================================================================
        //
        // platform_mmio_map(base_pa, size, MMIO_WC=1) -> kernel_va.
        // Returns 0 on hard failure, pa_base on MAP_HUGE identity-VA
        // fallback, or a fresh PML4[321] VA otherwise.
        //
        // Reload inputs from .bss so the sub-block does not depend on
        // register survival across intervening compute.

        mov rdi, [rip + _gop_fb_base_pa];
        mov rsi, r11;                           // fb.size (still live)
        mov rdx, 1;                             // MMIO_WC
        sub rsp, 8;                             // align rsp%16 -> 0
        call platform_mmio_map;
        add rsp, 8;                             // restore rsp%16 -> 8

        cmp rax, 0;
        je  gop_fb_emit_off;

        mov [rip + _gop_fb_ptr], rax;

        // ================================================================
        // Phase 5: latch console-active last (write-barrier semantics).
        // ================================================================

        mov rax, 1;
        mov [rip + _gop_fb_console_active], rax;

        // ================================================================
        // Phase 6: emit success fingerprint (two lines).
        // ================================================================
        //
        // Line 1 (klog_s1_d3): "FB CONSOLE OK width=<n> height=<n> bpp=<n>"
        //   rdi=level, rsi=subsys, rdx=tag, rcx=k1(k_width), r8=v1(width),
        //   r9=k2(k_height); stack: [rsp+8]=v2(height),
        //   [rsp+16]=k3(k_bpp), [rsp+24]=v3(bpp).
        //   Push order: v3, k3, v2 (last pushed lands at [rsp+8]).

        mov rax, [rip + _gop_fb_bpp];
        push rax;                               // v3 = bpp -> [rsp+24]
        lea rax, [rip + gop_fb_k_bpp];
        push rax;                               // k3       -> [rsp+16]
        mov rax, [rip + _gop_fb_height];
        push rax;                               // v2 = height -> [rsp+8]

        mov rdi, 3;                             // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gop_fb_ok_msg];
        lea rcx, [rip + gop_fb_k_width];
        mov r8,  [rip + _gop_fb_width];
        lea r9,  [rip + gop_fb_k_height];
        call klog_s1_d3;
        add rsp, 24;

        // Line 2 (klog_s1_x1): "fb console base base=0x<...>"
        //   rdi=level, rsi=subsys, rdx=tag, rcx=k, r8=v.
        //   No stack args; sub rsp,8 aligns rsp%16 -> 0 for call.

        mov rdi, 3;                             // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gop_fb_base_msg];
        lea rcx, [rip + gop_fb_k_base];
        mov r8,  [rip + _gop_fb_base_pa];
        sub rsp, 8;
        call klog_s1_x1;
        add rsp, 8;

        ret;

      gop_fb_emit_off:
        // ================================================================
        // OFF arm — PVH boot, missing GOP, or LFB map failure.
        // ================================================================
        //
        // Leave every state slot at its .bss zero; _gop_fb_console_active
        // stays 0 so downstream puts() consumers early-exit.

        xor rax, rax;
        mov [rip + _gop_fb_console_active], rax;

        mov rdi, 3;                             // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gop_fb_off_msg];
        sub rsp, 8;                             // align rsp%16 -> 0
        call klog_s1;
        add rsp, 8;

        ret
      }
    }

  // ==========================================================================
  // gop_fb_console_puts(str, len) -> ()
  // ==========================================================================
  //
  // Public byte-slice write entry point.  Advances the (cursor_x, cursor_y)
  // grid position by one cell per printable byte, wrapping at cols and
  // resetting to (0, 0) after the last row (no scroll on this substrate —
  // M4-015 scope is fingerprint + wire-up; real scrolling / SGR / cell
  // buffer lives in the R23 fb_console module).
  //
  // Handles '\n' (0x0A) by setting cursor_x=0 and advancing cursor_y.
  // Every other byte increments cursor_x; wrap on cursor_x >= cols.
  //
  // Actual pixel blitting is deferred: the M4-015 stub font is all-zeros
  // so blit would render invisible glyphs, and the address-arithmetic
  // path lives in gop_fb_draw_glyph_at (private helper below) which
  // callers can invoke directly when the real font blob lands.  Keeping
  // puts as cursor-state-only avoids exercising the imul/mov_d hot path
  // against a stub font and shortens the M4-015 diff to the fingerprint
  // and its dependencies.
  //
  // Callers gate on _gop_fb_console_active themselves is unnecessary —
  // the load+compare here is the single choke point.

  pub let gop_fb_console_puts : (u64, u64) -> () !{mem} @{} =
    fn (str_ptr: u64) (len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M4-015 (paideia-os #2367): iterate str[0..len], updating _gop_fb_cursor_x/_gop_fb_cursor_y with wrap on cols/rows. Gate on _gop_fb_console_active == 0 (PVH or LFB-map-fail path) -- early return without touching any state. For each byte: (a) 0x0A -> cursor_x=0, cursor_y++; (b) other -> cursor_x++, then wrap-check. cursor_y wrap resets to 0 (no scroll at M4-015; scrolling lives in the R23 fb_console module). Actual pixel blit deferred (stub font is all-zeros anyway; keeping puts as cursor-state-only avoids exercising the imul / mov_d hot path against an invisible font). Register discipline: 3-push callee-save (rbx=str, r12=len, r13=idx) -- entry rsp%16==8, +24 = rsp%16==0 (no nested calls in body, but the aligned stack keeps a future call-site landable). Byte load via canonical `xor rax, rax; mov_b rax, [rbx + r13*1]` (indexed-byte-load form with explicit *1 scale per vfs_open.pdx L127 / pdxfs_lite/rename.pdx precedent — paideia-as encoder gap: mov_b does not zero-extend, so the pre-xor makes the zero-extension explicit). Encoder posture (v0.36+): push/pop / mov reg,reg / mov reg,imm8/imm32 / mov r64,[rip+sym] / mov [rip+sym],r64 / mov_b r64,[reg+reg] (indexed byte load, proven in the fb_console module's byte-slice paths) / xor r,r / add r,imm8 / cmp r,imm/reg / je/jne/jae/jmp / ret. No test rN,rN. No 2-op imul r,imm. No and reg,imm64. Reserved label prefix: gop_fb_puts_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Gate: not active -> early return.
        mov rax, [rip + _gop_fb_console_active];
        cmp rax, 0;
        je  gop_fb_puts_done;

        mov rbx, rdi;                           // str_ptr
        mov r12, rsi;                           // len
        xor r13, r13;                           // idx = 0

      gop_fb_puts_loop:
        cmp r13, r12;
        jae gop_fb_puts_done;

        // Byte load: xor rax, rax; mov_b rax, [rbx + r13*1] (indexed
        // byte load, explicit *1 scale per vfs_open.pdx L127 precedent).
        xor rax, rax;
        mov_b rax, [rbx + r13*1];

        // Newline handling: cursor_x = 0; cursor_y++
        cmp rax, 10;                            // '\n' == 0x0A
        jne gop_fb_puts_regular;

        xor rax, rax;
        mov [rip + _gop_fb_cursor_x], rax;

        mov rax, [rip + _gop_fb_cursor_y];
        add rax, 1;
        mov [rip + _gop_fb_cursor_y], rax;
        jmp gop_fb_puts_wrap_check;

      gop_fb_puts_regular:
        // Regular char: cursor_x++
        mov rax, [rip + _gop_fb_cursor_x];
        add rax, 1;
        mov [rip + _gop_fb_cursor_x], rax;

        // Column wrap: if cursor_x >= cols, cursor_x=0, cursor_y++
        mov rcx, [rip + _gop_fb_cols];
        cmp rax, rcx;
        jb  gop_fb_puts_wrap_check;

        xor rax, rax;
        mov [rip + _gop_fb_cursor_x], rax;

        mov rax, [rip + _gop_fb_cursor_y];
        add rax, 1;
        mov [rip + _gop_fb_cursor_y], rax;

      gop_fb_puts_wrap_check:
        // Row wrap: if cursor_y >= rows, cursor_y=0 (no scroll)
        mov rax, [rip + _gop_fb_cursor_y];
        mov rcx, [rip + _gop_fb_rows];
        cmp rax, rcx;
        jb  gop_fb_puts_advance;

        xor rax, rax;
        mov [rip + _gop_fb_cursor_y], rax;

      gop_fb_puts_advance:
        add r13, 1;
        jmp gop_fb_puts_loop;

      gop_fb_puts_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
