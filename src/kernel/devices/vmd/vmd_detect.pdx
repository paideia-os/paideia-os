// src/kernel/devices/vmd/vmd_detect.pdx -- R111.M2-009 (paideia-os #2361)
//
// Intel VMD (Volume Management Device) boot-refuse witness.
//
// =============================================================================
// SECTION 0  WHY THIS EXISTS
// =============================================================================
//
// T14 G4 (and every consumer/workstation Raptor Lake board shipping since
// 2022) may power up with Intel Volume Management Device enabled in BIOS.
// When VMD is enabled the on-die PCIe controllers for the NVMe storage
// lanes are hidden behind a synthetic Intel-owned root complex (vid=0x8086,
// class 0x01/0x04/0x00) and the downstream NVMe controllers are no longer
// visible at their native BDFs -- the VMD bridge owns the ECAM window and
// mediates configuration + MSI-X translation for the endpoints inside it.
//
// R111 does NOT implement the VMD bridge protocol.  Any NVMe device sitting
// behind an enabled VMD is unreachable from our config-space walker, our
// MSI-X programmer, and our BAR mapper -- silently.  A user booting the
// image on a stock T14 G4 with default BIOS settings would see the boot
// wave complete PCI enumeration cleanly (VMD itself enumerates fine as a
// class-0x010400 device) and then observe no storage backends.  The
// failure mode is invisible until the pdxfs probe finds no KIND_BLKDEV
// caps, at which point the user has no signal telling them the storage
// silicon is even there, just hidden.
//
// This module fires the OPPOSITE signal.  Immediately after the PCI enum
// cascade publishes _pci_devices, we walk the table once for every known
// Intel VMD device-id and, on ANY match, emit an unmissable error-level
// fingerprint + halt boot.  The user sees a plain-text "VMD DETECTED" +
// "VMD BOOT REFUSED" pair, disables VMD in BIOS, reboots.  Without this
// witness the failure mode teaches nothing; with it the failure mode
// self-documents.
//
// =============================================================================
// SECTION 1  KNOWN VMD DEVICE IDs (all vid=0x8086)
// =============================================================================
//
//   0xA77F  Raptor Lake VMD (client)               -- primary T14 G4 target
//                                                    (per R47 probe.pdx L42-44)
//   0x9A0B  Alder Lake-N / Tiger Lake VMD          -- secondary client SKU
//   0x9A09  Alder Lake VMD                         -- 12th-gen desktop/mobile
//   0x9A08  Alder Lake-P VMD                       -- P-series mobile
//   0x467F  Rocket Lake VMD                        -- 11th-gen desktop
//   0x28C0  Ice Lake / Tiger Lake server VMD       -- Xeon Ice Lake SP
//   0x09AB  Sapphire Rapids VMD                    -- 4th-gen Xeon Scalable
//   0x201D  Skylake-SP VMD                         -- oldest generation
//                                                    that ships VMD silicon
//
// The R47 VMD probe (src/kernel/core/drivers/vmd/probe.pdx) matches VMD
// by the (class, subclass, prog_if) triple 0x010400 + Intel vendor gate,
// which is the RIGHT filter for a driver that wants to bring the bridge
// up.  This witness deliberately uses the (vid, did) shape instead: R47's
// class walk depends on class_code being populated correctly by the PCI
// enumerator, and a device-id allowlist is the more precise "we know this
// silicon" statement for a REFUSE policy.  The two filters coexist without
// conflict -- R47 is scaffolding for a hypothetical future VMD driver;
// this witness is the current-round refusal that keeps us out of the
// half-supported state R47 would otherwise imply.
//
// =============================================================================
// SECTION 2  RECORD LAYOUT (from src/kernel/core/pci/enum.pdx §Header)
// =============================================================================
//
// Record stride = 32 bytes (Enum.PCI_DEV_RECORD_SIZE).  Only the fields
// this witness reads are annotated:
//
//   +0   u16 seg
//   +2   u8  bus
//   +3   u8  dev
//   +4   u8  fn
//   +8   u16 vendor_id
//   +10  u16 device_id
//
// packed_bdf = (seg << 32) | (bus << 16) | (dev << 8) | fn
//
// This matches the PCIe BDF pack used by pci_enumerate_segment_range
// (src/kernel/core/pci/enum.pdx §L749) so the "VMD DETECTED bdf=<hex>"
// value reads positionally as <seg>:<bus>:<dev>.<fn> alongside every
// other post-R111 PCI fingerprint.
//
// =============================================================================
// SECTION 3  FINGERPRINTS
// =============================================================================
//
// All emits go through SUBSYS_BOOT; the witness is a boot-policy gate,
// not a PCI-subsystem event.  Level ERROR (1) so operators see the line
// through any level filter shy of PANIC.  None of the three tags carry
// an " OK" token, so tools/verify-fingerprint-coverage.sh does not require
// an allowlist entry (the gate only polices "... OK" strings).
//
//   Per-instance emit  klog_s1_x2(LEVEL_ERROR, SUBSYS_BOOT, tag_vmd_detected,
//                                 k_did, did, k_bdf, packed_bdf)
//                      "VMD DETECTED -- did=<hex> bdf=<packed>"
//
//   Final refusal      klog_s1(LEVEL_ERROR, SUBSYS_BOOT, tag_vmd_boot_refused)
//                      "VMD BOOT REFUSED"
//                      then: cli / hlt / jmp $ (defensive HLT loop; never
//                      returns to kernel_main_64)
//
//   All-clear          klog_s1(LEVEL_INFO,  SUBSYS_BOOT, tag_vmd_clear)
//                      "VMD CLEAR"
//                      then: return normally, kernel_main_64 continues.
//
// =============================================================================
// SECTION 4  ENCODER FLOOR (paideia-as v0.36+)
// =============================================================================
//
// Follows the pdx encoder pitfalls listed in the R111 dispatch memo:
//
//   - no `test rN, rN`               -- use `cmp rN, 0` throughout.
//   - no 2-op `imul r, imm`          -- shift/or replaces multiply.
//   - no `and r64, imm64`            -- imm32-sign-extended only.
//   - no `cmp reg, [mem]`            -- always `xor+mov_{b,w}` then
//                                       `cmp reg, reg`.
//   - reserved labels avoided        -- all internal labels prefixed
//                                       `vmd_` (loop -> vmd_scan, next
//                                       -> vmd_next, hit -> vmd_hit,
//                                       done -> vmd_done_absent, etc.).
//   - PascalCase module basename     -- `VmdDetect` matches vmd_detect.pdx.
//
// Every nested callee (klog_s1, klog_s1_x2) preserves rbx/r12..r15 per
// the SysV callee-save discipline the klog wrappers document at
// src/kernel/core/klog/wrappers.pdx §M1-004.

module VmdDetect = structure {

  // -------------------------------------------------------------------------
  // Constants
  // -------------------------------------------------------------------------

  pub let VMD_VENDOR_INTEL : u64 = 0x8086
  pub let VMD_ID_COUNT     : u64 = 8

  // Known Intel VMD device IDs (all vid=0x8086).  u64 stride keeps the
  // table lookup as a plain `mov rax, [base + j*8]` -- no sized load,
  // no zero-extension gymnastics.  0xA77F + 0x09AB added per R47
  // probe.pdx L42-44 which sourced from live Linux drivers/pci
  // /controller/vmd.c ID table.
  pub let VMD_DIDS : [u64; 8] = [
    0xA77F,
    0x9A0B,
    0x9A09,
    0x9A08,
    0x467F,
    0x28C0,
    0x09AB,
    0x201D
  ]

  // -------------------------------------------------------------------------
  // Fingerprint tags (module-local, following the t14_g4_detect precedent
  // at src/kernel/boot/t14_g4_detect.pdx §L88).  Byte counts NUL-inclusive
  // per the #699 discipline enforced by keys.pdx.
  // -------------------------------------------------------------------------

  pub let tag_vmd_detected     : [u8; 13] = "VMD DETECTED\0"
  pub let tag_vmd_boot_refused : [u8; 17] = "VMD BOOT REFUSED\0"
  pub let tag_vmd_clear        : [u8; 10] = "VMD CLEAR\0"

  // =========================================================================
  // vmd_detect_and_refuse() -> ()
  //
  // Walks _pci_devices[0.._pci_device_count) once.  For every record whose
  // vendor_id == 0x8086 AND device_id matches an entry in VMD_DIDS, emits
  // "VMD DETECTED did=<hex> bdf=<packed>" and sets a found flag.  On loop
  // exit, if the flag is set, emits "VMD BOOT REFUSED" and enters a
  // cli/hlt/jmp$ loop that never returns.  Otherwise emits "VMD CLEAR"
  // and returns normally so kernel_main_64 can continue.
  //
  // The scan does NOT short-circuit on first match: every VMD instance
  // gets its own fingerprint line so a multi-VMD board (rare but
  // possible on server SKUs) tells the operator exactly which BDFs are
  // implicated.
  //
  // Register plan
  // -------------
  //   rbx = outer loop cursor  (0 .. capped _pci_device_count)
  //   r12 = capped _pci_device_count (loaded once)
  //   r13 = record base pointer (recomputed per iteration)
  //   r14 = found flag (0 = no match, 1 = at least one match)
  //   r15 = current device_id (loaded once per candidate iter)
  //
  // Stack frame
  // -----------
  //   5 callee-save pushes (rbx, r12, r13, r14, r15) = 40 B.
  //   Entry rsp%16 == 8 (SysV: caller pre-call aligned, call pushed 8B).
  //   After 5 pushes: (8 + 40) mod 16 = 48 mod 16 = 0.
  //   Pre-call rsp%16 == 0 required for both klog_s1 and klog_s1_x2.
  //
  //   klog_s1_x2 takes v2 as a 7th arg on the stack at [rsp+8]-post-call:
  //   we pre-align with `sub rsp, 8`, push v2, then call.  The callee's
  //   own `push rbp; mov rbp, rsp` puts v2 at [rbp+16] inside the wrapper
  //   (see src/kernel/core/klog/wrappers.pdx §L94).
  // =========================================================================

  pub let vmd_detect_and_refuse : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R111.M2-009 (paideia-os #2361). Intel VMD boot-refuse witness. Body: (1) 5-push callee-save prologue (rbx, r12, r13, r14, r15) = 40B; entry rsp%16==8 -> post-prologue rsp%16==0 for the nested klog calls (both klog_s1 and klog_s1_x2 are SysV-aligned at this rsp). (2) r14 = found flag = 0. (3) Load _pci_device_count into r12; if zero, jump straight to the check-found tail (emit CLEAR). Defensive cap at 256 (Enum.PCI_MAX_DEVICES). (4) Outer scan rbx = 0..r12: compute record ptr = _pci_devices + (rbx<<5) into r13 via `lea r13, [rip + _pci_devices]; mov rax, rbx; shl rax, 5; add r13, rax`. (5) Load vendor_id (u16 @+8) into rax via `xor rax, rax; mov_w rax, [r13+8]` (dst-zero idiom); cmp against 0x8086 (via `mov r10, 0x8086; cmp rax, r10` -- avoids the cmp-reg-imm32 sign-extension hazard for values that happen to fit in imm16 but not imm8); if not match, next. (6) Load device_id (u16 @+10) into r15 via xor+mov_w. (7) Inner scan r11 = 0..VMD_ID_COUNT (=6): load VMD_DIDS[r11] into rax via `lea rax, [rip + VMD_DIDS]; mov rcx, r11; shl rcx, 3; add rax, rcx; mov rax, [rax]`; cmp rax, r15; on match, jump to hit; else advance. (8) On hit: compute packed_bdf = (seg<<32)|(bus<<16)|(dev<<8)|fn from record fields into r10. seg u16@+0 -> `xor rax,rax; mov_w rax, [r13+0]; shl rax, 32; mov r10, rax`. bus u8@+2 -> `xor rax,rax; mov_b rax, [r13+2]; shl rax, 16; or r10, rax`. dev u8@+3 -> `xor rax,rax; mov_b rax, [r13+3]; shl rax, 8; or r10, rax`. fn u8@+4 -> `xor rax,rax; mov_b rax, [r13+4]; or r10, rax`. No AND masks needed -- mov_b already zero-extends. (9) Emit klog_s1_x2(LEVEL_ERROR, SUBSYS_BOOT, tag_vmd_detected, k_did, r15, k_bdf, r10) via the standard 1-stack-arg pattern: `sub rsp, 8; push r10; mov rdi, 1; lea rsi, [rip+SUBSYS_BOOT]; lea rdx, [rip+tag_vmd_detected]; lea rcx, [rip+k_did]; mov r8, r15; lea r9, [rip+k_bdf]; call klog_s1_x2; add rsp, 8; add rsp, 8`. Alignment: post-prologue rsp%16==0; sub 8 -> 8; push r10 -> 0 (aligned for call); post-call add 16 restores to 0. (10) Mark r14=1 and fall through to next (continue enumerating). (11) Tail vmd_check_found: cmp r14, 0; if 0 -> emit klog_s1(LEVEL_INFO, SUBSYS_BOOT, tag_vmd_clear), pop callee-saves, ret. Else -> emit klog_s1(LEVEL_ERROR, SUBSYS_BOOT, tag_vmd_boot_refused), enter vmd_hlt_loop: cli; hlt; jmp vmd_hlt_loop (never returns; interrupts disabled so no ISR can fire past cli -- an NMI would wake the CPU at hlt but the jmp brings it right back). Encoder posture: G1 sized loads via xor+mov_{b,w} dst-zero idiom; G4 full-register compares (cmp reg,reg / cmp reg,imm -- never cmp reg,[mem]); no test reg,reg (cmp reg,0 throughout); no 2-op imul r,imm; no and reg,imm64. Reserved-label discipline: all labels prefixed `vmd_` (vmd_bound_ok, vmd_scan, vmd_did_scan, vmd_hit, vmd_next, vmd_check_found, vmd_refuse, vmd_hlt_loop). Every nested callee (klog_s1, klog_s1_x2) preserves rbx/r12..r15 per SysV (verified against src/kernel/core/klog/wrappers.pdx).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Initialize found flag = 0.
        xor r14, r14;

        // Load _pci_device_count once.  A zero count means the PCI enum
        // cascade skipped (no MCFG on the PVH `-kernel` boot path) --
        // there is nothing to scan and we take the CLEAR arm.
        mov r12, [rip + _pci_device_count];
        cmp r12, 0;
        je vmd_check_found;

        // Defensive cap at 256 (Enum.PCI_MAX_DEVICES).  The enumerator
        // caps itself but this witness reads the count on its own; a
        // corrupt count could otherwise walk arbitrary memory.
        cmp r12, 256;
        jbe vmd_bound_ok;
        mov r12, 256;
      vmd_bound_ok:

        xor rbx, rbx;

      vmd_scan:
        cmp rbx, r12;
        jae vmd_check_found;

        // record_ptr = &_pci_devices + rbx * 32.
        lea r13, [rip + _pci_devices];
        mov rax, rbx;
        shl rax, 5;
        add r13, rax;

        // vendor_id at [+8] (u16); must == 0x8086.
        xor rax, rax;
        mov_w rax, [r13 + 8];
        mov r10, 0x8086;
        cmp rax, r10;
        jne vmd_next;

        // device_id at [+10] (u16) into r15.
        xor r15, r15;
        mov_w r15, [r13 + 10];

        // Inner scan through VMD_DIDS[0..6].
        xor r11, r11;
      vmd_did_scan:
        cmp r11, 6;
        jae vmd_next;

        lea rax, [rip + VMD_DIDS];
        mov rcx, r11;
        shl rcx, 3;
        add rax, rcx;
        mov rax, [rax];
        cmp rax, r15;
        je vmd_hit;

        add r11, 1;
        jmp vmd_did_scan;

      vmd_hit:
        // Compute packed_bdf = (seg<<32)|(bus<<16)|(dev<<8)|fn into r10.
        xor rax, rax;
        mov_w rax, [r13 + 0];
        shl rax, 32;
        mov r10, rax;

        xor rax, rax;
        mov_b rax, [r13 + 2];
        shl rax, 16;
        or r10, rax;

        xor rax, rax;
        mov_b rax, [r13 + 3];
        shl rax, 8;
        or r10, rax;

        xor rax, rax;
        mov_b rax, [r13 + 4];
        or r10, rax;

        // Emit klog_s1_x2(LEVEL_ERROR, SUBSYS_BOOT, tag_vmd_detected,
        //                 k_did, did, k_bdf, packed_bdf)
        // v2 (packed_bdf) is the 7th arg -- goes on stack at [rsp+8]
        // post-call.  Pre-align sub 8 + push v2 lands rsp%16==0 at call.
        sub rsp, 8;
        push r10;
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_vmd_detected];
        lea rcx, [rip + k_did];
        mov r8, r15;
        lea r9, [rip + k_bdf];
        call klog_s1_x2;
        add rsp, 8;
        add rsp, 8;

        // Mark found and continue scanning so every instance is witnessed.
        mov r14, 1;

      vmd_next:
        add rbx, 1;
        jmp vmd_scan;

      vmd_check_found:
        cmp r14, 0;
        jne vmd_refuse;

        // No VMD detected -- emit clear line and return normally.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_vmd_clear];
        call klog_s1;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      vmd_refuse:
        // At least one VMD detected -- emit refusal and halt.  Do NOT
        // restore callee-saves: this path never returns and preserving
        // rsp integrity for a caller that will never regain control is
        // pointless.  The frame remains intact for a debugger to walk.
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_vmd_boot_refused];
        call klog_s1;

      vmd_hlt_loop:
        cli;
        hlt;
        jmp vmd_hlt_loop
      }
    }
}
