// src/kernel/mm/uefi_physmap.pdx — R19-M4-005 (#800)
//
// UEFI EFI memory-map → paideia physmap-count pass. Iterates the memory
// map that the UEFI stub (efi_finalize_and_handoff in
// src/boot/uefi_stub.pdx) captured immediately before ExitBootServices,
// classifies each descriptor by EFI_MEMORY_TYPE, and sums the total bytes
// of "reusable" physical memory. This is the first paideia code that
// consumes the UEFI-shape boot environment.
//
// -----------------------------------------------------------------------------
// EFI_MEMORY_DESCRIPTOR layout (UEFI 2.10 §7.2.3)
// -----------------------------------------------------------------------------
//
// struct EFI_MEMORY_DESCRIPTOR {
//   UINT32  Type;              // +0    EFI_MEMORY_TYPE enum
//   UINT32  _Pad;              // +4    (natural alignment fill for u64)
//   EFI_PHYSICAL_ADDRESS  PhysicalStart;  // +8   base physical address
//   EFI_VIRTUAL_ADDRESS   VirtualStart;   // +16  populated by SetVirtualAddressMap; 0 pre-EBS
//   UINT64  NumberOfPages;     // +24   in 4 KiB units
//   UINT64  Attribute;         // +32   EFI_MEMORY_* attribute bitfield
// };  // sizeof = 40 nominal, but firmware advertises the actual stride via
//     // boot_env_t.efi_memmap_desc_size — do NOT hard-code 40, spec allows
//     // firmware to grow the descriptor with trailing fields between
//     // revisions and callers must always stride by desc_size.
//
// -----------------------------------------------------------------------------
// EFI_MEMORY_TYPE classification (UEFI 2.10 §7.2.1 table)
// -----------------------------------------------------------------------------
//
// Type | Name                        | Post-EBS disposition
// -----|-----------------------------|---------------------
//  0   | EfiReservedMemoryType       | reserved
//  1   | EfiLoaderCode               | REUSABLE (loader code — we're past it)
//  2   | EfiLoaderData               | REUSABLE (loader data — we're past it)
//  3   | EfiBootServicesCode         | REUSABLE (BS code — invalidated post-EBS)
//  4   | EfiBootServicesData         | REUSABLE (BS data — invalidated post-EBS)
//  5   | EfiRuntimeServicesCode      | reserved (RS still running)
//  6   | EfiRuntimeServicesData      | reserved (RS still running)
//  7   | EfiConventionalMemory       | REUSABLE (unallocated at hand-off)
//  8   | EfiUnusableMemory           | reserved
//  9   | EfiACPIReclaimMemory        | reserved-until-ACPI-parsed
// 10   | EfiACPIMemoryNVS            | reserved (must not touch)
// 11   | EfiMemoryMappedIO           | reserved (device MMIO)
// 12   | EfiMemoryMappedIOPortSpace  | reserved
// 13   | EfiPalCode                  | reserved
// 14+  | (future)                    | reserved
//
// R19.M4 conservatively treats {1,2,3,4,7} as REUSABLE and everything else
// as reserved. EfiACPIReclaimMemory (9) is intentionally excluded from
// REUSABLE until an ACPI parser has copied the tables out — that lands in
// R20+ when the paideia ACPI subsystem materialises. Under-approximating
// available memory is always safe; over-approximating produces silent
// corruption when the kernel later overwrites live firmware data.
//
// -----------------------------------------------------------------------------
// Image carve-out
// -----------------------------------------------------------------------------
//
// The loaded kernel image (base = env->image_base, size = env->image_size)
// lives inside a REUSABLE range (typically EfiLoaderCode/EfiLoaderData that
// LoadImage populated). We must not hand its pages back to the phys
// allocator. The R19.M4 MVP subtracts env->image_size from the total —
// this is approximate (assumes the whole image lives in a reusable range,
// which is true under OVMF but not spec-guaranteed) but sound for the
// build-out audit trail. R19.M5 will replace this with a per-descriptor
// overlap subtraction driven by the actual phys_alloc bitmap.
//
// -----------------------------------------------------------------------------
// Milestone scope (honest scope)
// -----------------------------------------------------------------------------
//
// R19.M4 delivers the traversal + counting pass. It does NOT integrate
// with the paideia phys_alloc bitmap (src/kernel/core/mm/phys_alloc.pdx),
// which today manages a fixed 1024-page static pool at _phys_page_pool
// with a 16-word bitmap keyed off kernel-VA — mapping arbitrary
// firmware-reported PA extents into that structure requires a substantive
// redesign that belongs in R19.M5 (bootstrap the phys allocator from the
// UEFI memmap instead of from a static pool). The counting results land
// in _uefi_physmap_avail_bytes and _uefi_physmap_resv_bytes so the R19.M5
// integration has a witness / regression baseline to test against.

module UefiPhysmap = structure {

  // ==========================================================================
  // Result slots — populated by uefi_build_physmap.
  // ==========================================================================

  // Sum of NumberOfPages*4096 across descriptors with Type ∈ {1,2,3,4,7},
  // MINUS the kernel image size (image_base/image_size carve-out). Bytes.
  pub let mut _uefi_physmap_avail_bytes : u64 = 0

  // Sum of NumberOfPages*4096 across all other descriptor types. Bytes.
  pub let mut _uefi_physmap_resv_bytes  : u64 = 0

  // Total descriptors visited (for diagnostics).
  pub let mut _uefi_physmap_desc_count  : u64 = 0

  // ==========================================================================
  // uefi_build_physmap — iterate the EFI memory map, classify, sum.
  // ==========================================================================
  //
  // SysV: (env: u64) -> u64
  //
  //   env = physical address of the boot_env_t (256 B struct, layout in
  //         src/boot/uefi_env.pdx).
  //
  //   Reads:  env->efi_memmap_pa    (u64 @ +72)
  //           env->efi_memmap_size  (u64 @ +80)  — total bytes in the map
  //           env->efi_memmap_desc_size (u32 @ +88) — per-descriptor stride
  //           env->image_size       (u64 @ +64)  — kernel carve-out
  //
  //   Writes: _uefi_physmap_avail_bytes
  //           _uefi_physmap_resv_bytes
  //           _uefi_physmap_desc_count
  //
  //   Returns: _uefi_physmap_avail_bytes (RAX).
  //
  // Register discipline: uses only volatile GPRs (rax/rcx/rdx/rsi/rdi/r8-r11).
  // No SysV non-volatiles touched, no-frame sound.
  //
  //   rsi  = current descriptor pointer (walks env->efi_memmap_pa)
  //   rcx  = bytes remaining in the map (walks env->efi_memmap_size)
  //   r8   = descriptor stride (env->efi_memmap_desc_size, zero-ext to u64)
  //   r9   = accumulator: available bytes
  //   r10  = accumulator: reserved bytes
  //   r11  = accumulator: descriptor count

  pub let uefi_build_physmap : (u64) -> u64 !{mem} @{} =
    fn (env: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R19-M4-005 (#800). Iterate the EFI memory map (env->efi_memmap_pa..+efi_memmap_size, strided by env->efi_memmap_desc_size — u32 read via 32-bit load, zero-extended into r8), classify each descriptor's Type (u32 @ +0) by the M4 reusability rule (Type ∈ {1,2,3,4,7} = REUSABLE per UEFI 2.10 §7.2.1 table), accumulate available vs reserved bytes as NumberOfPages*4096 (NumberOfPages @ +24, u64, left-shifted by 12), tally descriptor count. After the walk, subtract env->image_size from the available total (kernel-image carve-out — approximate at this milestone; per-descriptor overlap subtraction lands in R19.M5). Writes the three tallies to _uefi_physmap_avail_bytes/_resv_bytes/_desc_count and returns the available total in RAX. Does NOT integrate with the existing phys_alloc bitmap (src/kernel/core/mm/phys_alloc.pdx) — that pool is keyed off kernel-VA over a fixed 1024-page static region and cannot represent arbitrary firmware-reported PA extents; the bootstrap-from-UEFI-memmap redesign lands in R19.M5. The counting pass is the M4 audit witness / R19.M5 regression baseline. Loop termination: bytes-remaining underflow guard (`cmp rcx, r8; jl loop_done`) since firmware sometimes pads the tail of the map buffer with garbage past efi_memmap_size — we only trust the size field. Type classification uses a linear jump chain rather than a table lookup since paideia-as v0.20.1 doesn't yet expose a jump-table primitive; 5 cmp/je pairs are readable and cover the small enum.",
      block: {
        // Load boot_env fields.
        mov rsi, [rdi + 72];             // efi_memmap_pa (base of buffer)
        mov rcx, [rdi + 80];             // efi_memmap_size (bytes)
        mov r8, [rdi + 88];              // efi_memmap_desc_size (low 32 bits live; high 32 = padding)
        // Mask r8 to 32 bits — desc_size is a u32 field at offset +88 with
        // desc_ver (u32) at offset +92. A u64 load reads both concatenated;
        // desc_ver contents in high 32 must not corrupt the stride.
        mov rax, 0xFFFFFFFF;
        and r8, rax;

        // Zero accumulators.
        xor r9, r9;
        xor r10, r10;
        xor r11, r11;

        // Guard: empty map or bogus stride → skip loop.
        cmp r8, 0;
        je  uefi_build_physmap_done;
        cmp rcx, 0;
        je  uefi_build_physmap_done;

      uefi_build_physmap_loop:
        // Terminate when fewer bytes remain than a full descriptor.
        cmp rcx, r8;
        jl  uefi_build_physmap_carve;

        // Load Type (u32 @ +0) into eax (zero-extends into rax).
        mov eax, [rsi + 0];

        // Load NumberOfPages (u64 @ +24) into rdx.
        mov rdx, [rsi + 24];
        shl rdx, 12;                     // × 4096 = bytes

        // Classify: is Type in {1,2,3,4,7}?
        cmp rax, 7;                      // EfiConventionalMemory
        je  uefi_build_physmap_avail;
        cmp rax, 1;                      // EfiLoaderCode
        je  uefi_build_physmap_avail;
        cmp rax, 2;                      // EfiLoaderData
        je  uefi_build_physmap_avail;
        cmp rax, 3;                      // EfiBootServicesCode
        je  uefi_build_physmap_avail;
        cmp rax, 4;                      // EfiBootServicesData
        je  uefi_build_physmap_avail;

        // Not reusable — accumulate into reserved.
        add r10, rdx;
        jmp uefi_build_physmap_next;

      uefi_build_physmap_avail:
        add r9, rdx;

      uefi_build_physmap_next:
        add r11, 1;                      // descriptor count
        add rsi, r8;                     // advance pointer by stride
        sub rcx, r8;                     // decrement bytes remaining
        jmp uefi_build_physmap_loop;

      uefi_build_physmap_carve:
        // Image carve-out: subtract env->image_size from available total.
        // Approximate at this milestone (see file preamble § "Image carve-out").
        // Guard against underflow (defensive — image_size should always
        // fit within accumulated avail for a well-formed EFI map).
        mov rax, [rdi + 64];             // image_size
        cmp r9, rax;
        jl  uefi_build_physmap_no_carve;
        sub r9, rax;

      uefi_build_physmap_no_carve:

      uefi_build_physmap_done:
        // Store tallies.
        mov [rip + _uefi_physmap_avail_bytes], r9;
        mov [rip + _uefi_physmap_resv_bytes], r10;
        mov [rip + _uefi_physmap_desc_count], r11;

        // Return available bytes in rax.
        mov rax, r9;
        ret
      }
    }
}
