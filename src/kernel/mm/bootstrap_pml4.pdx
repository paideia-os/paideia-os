// src/kernel/mm/bootstrap_pml4.pdx — R111.M1-003 (paideia-os #2355)
//
// UEFI-path bootstrap PML4 installer. The PVH boot path (tools/boot_stub.S,
// .code32 _pvh_entry) initialises the R14+ mm subsystem's baseline paging
// structure directly — a bootstrap PML4 with PML4[0] identity-mapping
// 0..4 GiB via a PDPT of four 1 GiB huge pages, aliased into PML4[256] so
// the higher-half kernel VMA range 0xFFFF_8000_0000_0000+ resolves to the
// same low physical frames. That layout is what makes kernel_main_64 (linked
// at higher-half VMA per src/kernel/link.ld) executable straight out of
// boot, and it is the ONE PML4 shape every downstream R14+ mm consumer
// assumes:
//
//   src/kernel/core/mm/kpti.pdx  kpti_switch_to_kernel loads CR3 from
//     _kernel_pml4_pa — the singleton pml4 phys addr the R14+ subsystem
//     uses to CR3-flip on every ring-3 -> ring-0 entry.
//   src/kernel/core/mm/pf_handler.pdx  branches on the CR3 value against
//     _kernel_pml4_pa when disambiguating ring-0 vs ring-3 CoW faults.
//   src/kernel/core/mm/aspace_teardown.pdx  frees only PML4[0..255], never
//     PML4[256]+ — the trampoline PDPT singleton and higher-half kernel
//     aliases must survive teardown.
//   src/kernel/core/mm/mmio_map.pdx  reads _kernel_pml4_pa to route
//     platform_mmio_map walks into the correct root.
//
// Under the PVH boot path, kernel_main.pdx line 69-70 latches
// _kernel_pml4_pa = _pml4_addr (i.e. the runtime VA of pml4, which under
// identity mapping equals its PA). The UEFI boot path (kernel_main_uefi.pdx
// #2354) chains straight from the UEFI stub's efi_finalize_and_handoff into
// kernel_main_uefi and then into kernel_main_64, WITHOUT running boot_stub.S
// (the PVH stub is unreachable when firmware loaded us via LoadImage rather
// than a hypervisor PVH bootloader). If we let kernel_main_uefi call
// kernel_main_64 without first installing this bootstrap PML4:
//
//   1. pml4 and pdpt (the .bss.boot symbols boot_stub.S provides) are
//      zero-filled by the loader — every PML4 entry present bit is clear.
//   2. kernel_main_64 line 69 latches _kernel_pml4_pa = _pml4_addr — a
//      pointer to an empty PML4 page.
//   3. kernel_main_64's higher-half .text is mapped by whatever page-table
//      state firmware left us with (typically UEFI's identity map of the
//      full physical range, which does NOT cover the higher-half VMA), so
//      RIP-relative addressing inside kernel_main_64 either faults or
//      resolves through unrelated firmware pages.
//   4. The first R14+ mm subsystem call (aspace_map for the boot MMIO
//      windows in platform_map_early_mmio) reads _kernel_pml4_pa, walks a
//      zero-filled root, and writes leaf PTEs into what look like empty
//      slots but are actually the fresh PML4 root itself — silent
//      corruption.
//
// This module installs the same PVH-shape bootstrap PML4 into pml4/pdpt
// BEFORE the Phase 5 bridge in kernel_main_uefi. After the install:
//
//   - pml4[0]   = pdpt_pa | RW | P             (identity 0..4 GiB)
//   - pml4[256] = pdpt_pa | RW | P             (higher-half alias)
//   - pdpt[0..3] populated with 1 GiB huge-page entries at 0/1/2/3 GiB
//     with PS | RW | P (huge-page bit + RW + present, matching
//     boot_stub.S lines 26-33)
//   - CR3 loaded with pml4 phys address (4 KiB aligned, .align 4096 in
//     .bss.boot places both pml4 and pdpt with low 12 bits zero, so no
//     PCID field crosstalk)
//   - _kernel_pml4_pa latched to pml4 phys addr — the R14+ mm subsystem's
//     ownership contract begins here.
//
// -----------------------------------------------------------------------------
// R14+ mm ownership handoff contract
// -----------------------------------------------------------------------------
//
// AFTER uefi_bootstrap_pml4_install returns, the R14+ mm subsystem OWNS
// this bootstrap PML4 in the sense that:
//
//   * _kernel_pml4_pa is the sole address every mm consumer reads for the
//     current kernel-side PML4 root (kpti_switch_to_kernel, pf_handler,
//     aspace_teardown, mmio_map, and every future R14+ walker). All four
//     already depend on this slot's value; the UEFI path now populates it
//     with the same discipline the PVH path does.
//
//   * PML4[0]'s identity map of 0..4 GiB is the initial "everything is
//     directly reachable" scaffolding. mm consumers may replace or clear
//     PML4[0] once user aspaces are up and no code below 4 GiB needs
//     kernel-VA identity access. aspace_teardown.pdx already refuses to
//     walk PML4[256..511] (line 56 justification), preserving the
//     higher-half alias PML4[256] carries.
//
//   * The 4 KiB pml4 page and the 4 KiB pdpt page live in .bss.boot at the
//     low identity range (VMA == PA); the aspace_teardown walker touches
//     neither because it iterates only PML4[0..255]'s child chain, not
//     the boot PML4 root itself. Reclaiming pml4/pdpt frames themselves
//     is a distinct future work item (R14b+ mm subsystem's boot-frame
//     compaction pass); this module deliberately does not deliver it.
//
// The idempotency contract with kernel_main_64's own line 69-70 latch is:
// both write the same value (pml4's PA) into _kernel_pml4_pa. Under the
// PVH path, uefi_bootstrap_pml4_install never runs and kernel_main_64
// performs the sole latch. Under the UEFI path, uefi_bootstrap_pml4_install
// latches first, then kernel_main_64 re-latches with the identical value.
// The redundant write is not a bug — it keeps the PVH-path invariant intact
// and lets both bring-up paths share the same downstream reader contract.
//
// -----------------------------------------------------------------------------
// Execution-context contract
// -----------------------------------------------------------------------------
//
// This function is called from kernel_main_uefi Phase 4d, whose body is
// linked at higher-half VMA per src/kernel/link.ld. The same "higher-half
// paging is already in effect when we run" assumption kernel_main_uefi's
// verify_self_puts / u64_to_hex Phase 5 callers depend on applies here:
// the RIP-relative loads of _pml4_addr / _pdpt_addr / _kernel_pml4_pa all
// resolve through the higher-half .rodata / .bss mapping that must already
// exist for kernel_main_uefi's own body to fetch. The one place we cross
// the VA/PA boundary is the absolute-deref writes to *pml4 and *pdpt, which
// use the low-identity VA (== PA) values loaded through the .rodata slots.
//
// After `mov cr3, rax`, the next instruction fetch (via higher-half RIP)
// must resolve through OUR new PML4[256] alias. It does: PML4[256] points
// at the pdpt we just populated, whose PDPT[0..3] identity-cover 0..4 GiB,
// and every kernel .text byte lives at LMA < 4 GiB (link.ld places .text
// at LMA continuing from KERNEL_PHYS_BASE = 0x100000). So the fetch lands
// on the same physical frame it always did, this time under our own
// paging.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
// Emits one line on COM1 immediately after the CR3 load succeeds:
//
//   "UEFI PML4 OK cr3=0x<16hex>\r\n"
//
// The "UEFI PML4 OK" prefix carries the fingerprint OK token; the cr3
// hex chunk carries the pml4 phys addr (also readable via `mov rax, cr3`,
// but we emit from _kernel_pml4_pa for symmetry with the R14+ mm ownership
// slot). Allowlisted in tools/verify-fingerprint-coverage.sh Section A
// alongside "UEFI BRIDGE OK" / "EFI SIGNATURE OK" — the 14-mode default
// matrix boots via `-kernel` and never takes the UEFI path; the
// PAIDEIA_UEFI_OVMF opt-in stops at the pre-EBS hello banner today.
// Retires from that allowlist when R111.M2 lands an OVMF smoke mode that
// boots past ExitBootServices and pins this line against a live golden.

module BootstrapPml4 = structure {

  // ==========================================================================
  // Fingerprint tag slots — assembled on the wire as one line via three
  // verify_self_puts calls interleaved with one u64_to_hex call.
  // ==========================================================================
  //
  // "UEFI PML4 OK" (12 bytes; carries the OK fingerprint token).
  //
  //   U   E   F   I   sp  P   M   L   4   sp  O   K
  //   0x55 0x45 0x46 0x49 0x20 0x50 0x4D 0x4C 0x34 0x20 0x4F 0x4B

  pub let _bootpml4_tag_hdr : [u8; 12] = [
    0x55u8, 0x45u8, 0x46u8, 0x49u8, 0x20u8,
    0x50u8, 0x4Du8, 0x4Cu8, 0x34u8, 0x20u8,
    0x4Fu8, 0x4Bu8
  ]

  // " cr3=" (5 bytes; separator, no OK token — the R111 fingerprint-
  // coverage allowlist only asserts on the header fragment above).
  //
  //   sp  c   r   3   =
  //   0x20 0x63 0x72 0x33 0x3D

  pub let _bootpml4_tag_cr3 : [u8; 5] = [
    0x20u8, 0x63u8, 0x72u8, 0x33u8, 0x3Du8
  ]

  // CRLF terminator (2 bytes).

  pub let _bootpml4_tag_crlf : [u8; 2] = [
    0x0Du8, 0x0Au8
  ]

  // Scratch buffer for u64_to_hex output. u64_to_hex writes exactly
  // 18 bytes ("0x" + 16 nibbles) per its Hex module contract; the
  // extra 2 bytes are @align(8) padding. verify_self_puts consumes
  // the 18 bytes synchronously in this function so no reuse race
  // arises inside the block.

  pub let mut _bootpml4_hex_scratch : [u8; 20] = uninit @align(8)

  // ==========================================================================
  // uefi_bootstrap_pml4_install — populate pml4/pdpt, load CR3, latch
  // _kernel_pml4_pa, emit fingerprint.
  // ==========================================================================
  //
  // SysV: () -> ()
  //
  //   Reads:  _pml4_addr           (VA of pml4  in .bss.boot, R_X86_64_64
  //                                 slot in .rodata; VA == PA under
  //                                 identity)
  //           _pdpt_addr           (VA of pdpt  in .bss.boot, sibling
  //                                 R_X86_64_64 slot added by
  //                                 R111.M1-003 in tools/boot_stub.S)
  //   Writes: pml4[0], pml4[256]   (PDPT phys | RW | P — 0x03)
  //           pdpt[0..3]           (0/1/2/3 GiB | PS | RW | P — 0x83)
  //           CR3                  (pml4 phys)
  //           _kernel_pml4_pa      (pml4 phys — R14+ mm ownership handoff)
  //           _bootpml4_hex_scratch (u64_to_hex output for the emit)
  //
  //   Clobbers rax/rcx/rdx/rdi/rsi/r8-r11 across the fingerprint emit
  //   (verify_self_puts and u64_to_hex own those per their justifications).
  //   Does NOT touch rbx/rbp/r12-r15 — no callee-save discipline needed;
  //   frame-elision is sound because rbp is never touched and rsp is only
  //   perturbed by the four nested `call`s (each pushing/popping their
  //   own return addresses; the outer entry-time rsp is restored on
  //   return here).

  pub let uefi_bootstrap_pml4_install : () -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn () -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {boot, paideia.port_io},
      justification: "R111.M1-003 (paideia-os #2355). Install the UEFI-path bootstrap PML4 with the same PVH-shape layout tools/boot_stub.S installs in its .code32 prologue: PML4[0] identity-maps 0..4 GiB and PML4[256] aliases the same PDPT into the higher-half kernel VMA range, so kernel_main_64 (linked at higher-half VMA per src/kernel/link.ld) executes at its linked VMA. Called from kernel_main_uefi Phase 4d, immediately after verify_self and immediately before the Phase 5 UEFI BRIDGE OK emit + `call kernel_main_64`. Reads _pml4_addr (existing R_X86_64_64 slot in boot_stub.S .rodata) and _pdpt_addr (sibling R_X86_64_64 slot added by R111.M1-003) to reach the pml4 and pdpt symbols in .bss.boot; those pages are 4 KiB aligned by boot_stub.S's `.align 4096` and live in the low identity range (link.ld places .bss.boot inside the text_low PT_LOAD segment). Writes are absolute-deref (mov [reg], reg) through the VA==PA identity that holds for the low range under both UEFI firmware's initial paging and our own new PML4 after `mov cr3, rax`. Byte-for-byte matches boot_stub.S lines 22-33 (PML4 entries = pdpt_pa | 0x03; PDPT entries = 1GiB_base | 0x83 with PS bit set) so the R14+ mm subsystem's downstream assumptions (kpti_switch_to_kernel, pf_handler, aspace_teardown, mmio_map — all reading _kernel_pml4_pa) hold identically under both boot paths. Latches _kernel_pml4_pa = pml4 phys addr — the R14+ mm ownership handoff. kernel_main_64's own line 69-70 latch re-writes the same value redundantly under both paths (idempotent by construction: pml4's PA is a fixed link-time symbol). Emits one 'UEFI PML4 OK cr3=0x<16hex>\\r\\n' fingerprint line via three verify_self_puts calls interleaved with one u64_to_hex call, mirroring the R111.M1-002 UEFI BRIDGE OK emit shape immediately downstream. The 'UEFI PML4 OK' header is allowlisted in tools/verify-fingerprint-coverage.sh Section A (UEFI-only reachability posture, same as the 'UEFI BRIDGE OK' / 'EFI SIGNATURE OK' entries) — retires when R111.M2 opens an OVMF smoke mode that boots past ExitBootServices with a live golden. Execution-context: this function's own body is linked at higher-half VMA; the RIP-relative loads of _pml4_addr, _pdpt_addr, _kernel_pml4_pa, and every fingerprint tag/scratch slot resolve through the higher-half mapping that must already be in effect for kernel_main_uefi's own verify_self_puts / u64_to_hex Phase 5 callers to fetch (per kernel_main_uefi.pdx's execution-context caveat block). After mov cr3, rax the next instruction fetch resolves through our new PML4[256] alias, which identity-aliases 0..4 GiB — every kernel .text byte lives at LMA < 4 GiB so the fetch lands on the same physical frame under our paging as it did under firmware's. Register discipline: uses rax/rcx/rdx as scratch throughout; loads all page-table entries into rdx from immediates for the PDPT huge-page rows (avoids the paideia-as `or reg, imm64` encoder gap by using imm8 masks for the small 0x03 / 0x83 flag additions and full imm64 mov loads for the 1 GiB stride bases). No callee-save register touched — frame-elision is sound and rbp is untouched, matching kernel_main_uefi's own frame-elision discipline for the same reason (no scheduler / no stack unwind context here).",
      block: {
        // ================================================================
        // Phase 1: load bootstrap PML4 + PDPT base VAs (== PAs under
        // identity).
        // ================================================================

        mov rax, [rip + _pml4_addr];
        mov rcx, [rip + _pdpt_addr];

        // ================================================================
        // Phase 2: populate PML4[0] and PML4[256] with pdpt_pa | RW | P.
        // ================================================================
        //
        // Low 12 bits of pdpt_pa are zero (pdpt is 4 KiB aligned by
        // boot_stub.S's `.align 4096` in .bss.boot), so `or rdx, 3`
        // adds the RW (bit 1) and P (bit 0) flags without corrupting
        // the PA field.
        //
        // PML4[256] at byte offset 256*8 = 2048 aliases PML4[0] into
        // the higher-half VMA range 0xFFFF_8000_0000_0000+ so higher-
        // half kernel VMAs resolve to the same low physical frames
        // PML4[0]'s identity map already covers.

        mov rdx, rcx;
        or  rdx, 3;
        mov [rax + 0], rdx;
        mov [rax + 2048], rdx;

        // ================================================================
        // Phase 3: populate PDPT[0..3] with 1 GiB huge pages at 0/1/2/3
        // GiB, flags PS | RW | P (0x83 = bit 7 huge-page + bit 1 RW +
        // bit 0 present).
        // ================================================================
        //
        // Byte-identical to boot_stub.S lines 26-33 (.code32 prologue).
        // Full imm64 mov's for the 1 GiB stride bases sidestep the
        // paideia-as encoder's `or reg, imm64` gap; every entry is
        // a single mov of a pre-composed 64-bit value.

        mov rdx, 0x0000000000000083;
        mov [rcx + 0], rdx;
        mov rdx, 0x0000000040000083;
        mov [rcx + 8], rdx;
        mov rdx, 0x0000000080000083;
        mov [rcx + 16], rdx;
        mov rdx, 0x00000000C0000083;
        mov [rcx + 24], rdx;

        // ================================================================
        // Phase 4: load CR3 with pml4 phys addr. R14+ mm ownership
        // handoff begins here.
        // ================================================================
        //
        // rax still = pml4 VA == pml4 PA under identity. pml4 is 4 KiB
        // aligned so low 12 bits are zero (no PCID field crosstalk
        // even if CR4.PCIDE were set; today it is not).
        //
        // After this instruction the TLB is fully flushed (non-global
        // entries), and the next instruction fetch resolves through
        // our new PML4[256] alias — see execution-context contract in
        // this file's preamble.

        mov cr3, rax;

        // ================================================================
        // Phase 5: latch _kernel_pml4_pa — the R14+ mm subsystem's
        // ownership contract slot. kpti_switch_to_kernel, pf_handler,
        // aspace_teardown, mmio_map all read this slot; kernel_main_64
        // line 69-70 re-writes the same value idempotently under both
        // boot paths.
        // ================================================================

        mov [rip + _kernel_pml4_pa], rax;

        // ================================================================
        // Phase 6: emit "UEFI PML4 OK cr3=0x<16hex>\r\n" fingerprint.
        // ================================================================
        //
        // Four calls (three verify_self_puts + one u64_to_hex),
        // clobbering rax/rcx/rdx/rdi/rsi/r8-r11. No live register
        // survives across a call; every argument is a fresh RIP-
        // relative load from the corresponding .rodata / .bss slot.

        lea rdi, [rip + _bootpml4_tag_hdr];
        mov rsi, 12;
        call verify_self_puts;

        lea rdi, [rip + _bootpml4_tag_cr3];
        mov rsi, 5;
        call verify_self_puts;

        // hex(_kernel_pml4_pa) — the pml4 phys addr we just loaded
        // into CR3. Reading from the latched slot rather than a
        // second `mov rax, cr3` matches the R111.M1-002 bridge's
        // convention (every hex-emit reloads its input from a
        // RIP-relative .data slot).
        mov rdi, [rip + _kernel_pml4_pa];
        lea rsi, [rip + _bootpml4_hex_scratch];
        call u64_to_hex;
        lea rdi, [rip + _bootpml4_hex_scratch];
        mov rsi, 18;
        call verify_self_puts;

        lea rdi, [rip + _bootpml4_tag_crlf];
        mov rsi, 2;
        call verify_self_puts;

        ret
      }
    }
}
