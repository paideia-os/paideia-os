// src/kernel/boot_exc3/kernel_main_exc3.pdx — M3-002 followup (#715): int3 runtime witness entry

module KernelMainExc3 = structure {
  pub let kernel_main_exc3_64 : () -> () !{sysreg, mem} @{} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "M3-002 followup (#715): Boot exception ELF entry point. Calls uart_init, then gdt_install (replaces the boot-stub 32-bit CS at selector 0x08 with a 64-bit descriptor — without this the IDT gate for vec 3 transfers to a stale 32-bit CS and triple-faults; documented gotcha, see src/kernel/boot/gdt.pdx), then idt_install (routes int3 → _typed_handler_3 → klog_dump_trap_frame → exc_handle → klog_panic → isa-debug-exit 0x11). fire_int3 is a bare int3 opcode in tools/boot_stub.S. Entry never returns.",
    block: {
      call uart_init;                      // Initialize UART for logging output
      call gdt_install;                    // Replace boot-stub 32-bit CS at 0x08 with 64-bit descriptor (else int3 gate triple-faults)
      call idt_install;                    // Install IDT so int3 vector 3 routes to _typed_handler_3
      call fire_int3;                      // Dispatch int3 → _typed_handler_3 → klog_dump_trap_frame → exc_handle → klog_panic → isa-debug-exit 0x11
      ud2;                                 // unreachable sentinel
    }
  }
}
