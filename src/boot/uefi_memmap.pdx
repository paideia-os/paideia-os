// src/boot/uefi_memmap.pdx — R19-M2-003 (#789)
//
// Typed wrapper over EFI_BOOT_SERVICES.GetMemoryMap (UEFI 2.10 §7.2.3).
// Called from paideia-os side using the paideia default (SysV) argument
// convention; internally marshals to the Microsoft x64 calling convention
// firmware expects (UEFI 2.10 §II-2.3.4) and dispatches via indirect call
// through the Boot Services vtable slot (`FF /2` mem-form encoding,
// pattern established in #787/uefi_alloc.pdx and #788/uefi_locate.pdx and
// verified in paideia-as/crates/paideia-as-encoder/src/encode_instruction.rs::encode_call).
//
// -----------------------------------------------------------------------------
// Milestone scope (R19.M2, per design/round-retrospectives/r19-preflight.md)
// -----------------------------------------------------------------------------
//
// #789 (M2-003) primary wrapper delivers:
//   - `efi_get_memory_map(map_size_ptr, map_ptr, map_key_ptr, desc_size_ptr,
//                         desc_ver_ptr) -> status`
//     — 5-argument dispatch into BS->GetMemoryMap. All five out-slots are
//     caller-supplied pointers (no .data latch is needed here — unlike the
//     AllocatePages/LocateProtocol wrappers whose UEFI-side out-parameters
//     are single OUT-pointer fields that we materialise into a global).
//
// EFI_BUFFER_TOO_SMALL retry loop (#789 acceptance-criteria follow-up):
// deferred. Discovery-driver callers (#791) will pattern the loop —
// call once with map_size=0, retry with (returned_size + slack) — around
// this primary wrapper. Splitting the loop out of the marshalling wrapper
// keeps the ABI-boundary code minimal and the retry policy (slack size,
// max iterations) visible to the caller.
//
// -----------------------------------------------------------------------------
// EFI_BOOT_SERVICES.GetMemoryMap vtable slot
// -----------------------------------------------------------------------------
//
// UEFI 2.10 §4.4.1 fixes the EFI_BOOT_SERVICES layout: 24-byte EFI_TABLE_HEADER
// followed by function pointers at monotonic +8 offsets. GetMemoryMap sits
// between FreePages and AllocatePool in the Memory Services block:
//
//   +0    Hdr (EFI_TABLE_HEADER, 24 B)
//   +24   RaiseTPL / +32 RestoreTPL      (Task Priority)
//   +40   AllocatePages                                        ← #787
//   +48   FreePages                                            ← #787
//   +56   GetMemoryMap                                         ← THIS wrapper (0x38)
//   +64   AllocatePool
//   +72   FreePool
//   ...
//
// The 0x38 = 56 constant is cross-checked against edk2-stable202408
// MdePkg/Include/Uefi/UefiSpec.h (EFI_BOOT_SERVICES struct field ordering)
// and against the offset table maintained in src/boot/uefi_types.pdx.
//
// -----------------------------------------------------------------------------
// Cross-ABI (paideia default / SysV → MS x64) marshalling — 5 args
// -----------------------------------------------------------------------------
//
// paideia-as-ir::abi::ARG_REGS      = [RDI, RSI, RDX, RCX, R8, R9]  (SysV)
// paideia-as-ir::abi::MS_ARG_REGS   = [RCX, RDX, R8,  R9]  in-regs; args 5+
// spill to caller-owned stack slots at [RSP+0x20], [RSP+0x28], ... — reserved
// AFTER the 32-byte shadow area that MS x64 requires for arg-1..arg-4 spills
// (UEFI 2.10 §II-2.3.4).
//
// Layout after `sub rsp, 40` (from the wrapper's SysV-entry RSP ≡ 8 mod 16
// — SysV callers CALL leaves RSP that way):
//
//   [rsp + 0x00 .. rsp + 0x1F]   32-byte MS-x64 shadow (RCX/RDX/R8/R9 spill)
//   [rsp + 0x20 .. rsp + 0x27]   arg 5 (desc_ver_ptr) slot
//   [rsp + 0x28 ..]              return-address slot (populated by CALL)
//
// Alignment: (RSP≡8) - 40 = ≡ -32 ≡ 0 (mod 16) — MS-x64 requires RSP ≡ 0
// mod 16 immediately before CALL; the CALL itself pushes 8 bytes so the
// firmware callee sees RSP ≡ 8 mod 16 on entry, exactly its ABI expectation.
// `add rsp, 40` symmetrically restores the SysV entry value on return.
//
// Dependency-safe register reshuffle (SysV inputs → MS outputs):
//
//   SysV                        MS
//   ────                        ──
//   rdi = map_size_ptr    →     rcx           (arg 1)
//   rsi = map_ptr         →     rdx           (arg 2)
//   rdx = map_key_ptr     →     r8            (arg 3)     — SysV rdx is read
//   rcx = desc_size_ptr   →     r9            (arg 4)     — SysV rcx is read
//   r8  = desc_ver_ptr    →     [rsp+0x20]    (arg 5)     — SysV r8  is read
//
// Two hazards: (a) SysV r8 is the source for the stack slot but also the
// destination MS r8 register (would be clobbered by `mov r8, rdx`); (b)
// SysV rdx / rcx are sources but also overwritten as MS rdx / rcx. The
// wrapper stores r8 to the stack slot FIRST (before any register write),
// then walks the register moves in reverse arg order (r9 ← rcx, r8 ← rdx,
// rdx ← rsi, rcx ← rdi) so each source is consumed before its destination
// is written.
//
// Note that the stack-slot store must follow `sub rsp, 40` — the [rsp+0x20]
// address is only meaningful after the frame is opened. Placing the sub as
// the first executable operation also ensures that if a fault ever occurred
// on the [rip + _efi_system_table] load, the RSP state matches the
// documented frame layout for any future stack-unwinder / diagnostics
// consumer.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// SysV non-volatiles (RBX, RBP, R12-R15, RSP): the wrapper does NOT touch
// any of these — only RAX, RCX, RDX, R8, R9, R10, R11 are clobbered, all
// of which are volatile in both SysV and MS x64. Therefore @no_frame is
// sound (no prologue push/pop needed) and the wrapper is safe to call
// from any SysV-convention paideia-os caller without save discipline.
//
// -----------------------------------------------------------------------------
// Provisional `_efi_system_table` shadow
// -----------------------------------------------------------------------------
//
// paideia-as v0.21 `build --target uefi-x86_64` compiles one .pdx
// translation unit at a time (tools/build-uefi-stub.sh preamble). Following
// the discipline in uefi_alloc.pdx / uefi_locate.pdx we redeclare
// `_efi_system_table` locally so this file remains a well-formed standalone
// .pdx module. When R19.M2 grows the stub into a multi-file build
// (paideia-as enhancement `pa-r19-multi-file-link`, tracked in the R19
// preflight retrospective), the duplicate resolves to the single .data
// global defined in `uefi_stub.pdx` under a no-op rename.

module UefiMemmap = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================
  //
  // Standalone-compile shadow of the entry-point latch (see file preamble).
  // Overridden by the definition in uefi_stub.pdx when the M2 multi-file
  // build lands.

  pub let mut _efi_system_table : u64 = 0

  // ==========================================================================
  // efi_get_memory_map — wraps EFI_BOOT_SERVICES.GetMemoryMap
  // ==========================================================================
  //
  // UEFI 2.10 §7.2.3:
  //   EFI_STATUS GetMemoryMap (
  //     IN OUT UINTN                 *MemoryMapSize,      // arg0
  //     OUT    EFI_MEMORY_DESCRIPTOR *MemoryMap,          // arg1
  //     OUT    UINTN                 *MapKey,             // arg2
  //     OUT    UINTN                 *DescriptorSize,     // arg3
  //     OUT    UINT32                *DescriptorVersion   // arg4
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI/RDX/RCX/R8;   status → RAX.
  // MS x64 target:                 args in RCX/RDX/R8/R9 + [RSP+0x20]; RAX.
  //
  // Emitted body (unsafe, @no_frame):
  //   sub  rsp, 40                            ; open 32B shadow + 8B arg5 slot
  //   mov  [rsp + 32], r8                     ; MS arg5 = desc_ver_ptr (from SysV r8)
  //   mov  rax, [rip + _efi_system_table]     ; SystemTable*
  //   mov  rax, [rax + 96]                    ; BootServices*
  //   mov  r9,  rcx                           ; MS arg4 = desc_size_ptr (from SysV rcx)
  //   mov  r8,  rdx                           ; MS arg3 = map_key_ptr   (from SysV rdx)
  //   mov  rdx, rsi                           ; MS arg2 = map_ptr       (from SysV rsi)
  //   mov  rcx, rdi                           ; MS arg1 = map_size_ptr  (from SysV rdi)
  //   call [rax + 56]                         ; EFI_BS_OFFSET_GET_MEMORY_MAP (0x38)
  //   add  rsp, 40                            ; unwind shadow + arg5 slot
  //   ret

  pub let efi_get_memory_map : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (map_size_ptr: u64, map_ptr: u64, map_key_ptr: u64, desc_size_ptr: u64, desc_ver_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-003 (#789). Typed wrapper for EFI_BOOT_SERVICES.GetMemoryMap (UEFI 2.10 §7.2.3). 5-argument MS x64 dispatch: opens a 40-byte stack frame (32-byte shadow + 8-byte slot for the 5th argument, which MS x64 spills to [rsp+0x20]); RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL. Marshals paideia-default (SysV) args RDI/RSI/RDX/RCX/R8 into MS x64 targets RCX/RDX/R8/R9/[rsp+0x20] in dependency-safe order — SysV r8 stored to the stack slot first (before r8 is overwritten as MS r8), then register moves walk in reverse arg order (r9<-rcx, r8<-rdx, rdx<-rsi, rcx<-rdi) so each source is consumed before its destination is written. Loads BootServices* from _efi_system_table (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES) and issues indirect call via `FF /2 [rax + EFI_BS_OFFSET_GET_MEMORY_MAP=56]` into the vtable slot; symmetric `add rsp, 40` unwind on return. Returns EFI_STATUS in RAX per firmware ABI (typically EFI_SUCCESS or EFI_BUFFER_TOO_SMALL — the retry loop is a follow-up in the discovery driver #791, not the marshalling wrapper). Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs clobbered so @no_frame is sound. Indirect-call-via-memory encoding (`FF /2` mem-form) verified in paideia-as encoder tests under #787.",
      block: {
        sub rsp, 40;
        mov [rsp + 32], r8;
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        call [rax + 56];
        add rsp, 40;
        ret
      }
    } @no_frame
}
