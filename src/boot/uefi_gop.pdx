// src/boot/uefi_gop.pdx — R19-M3-001 (#792) + R19-M3-002 (#793)
//
// Graphics Output Protocol discovery + framebuffer descriptor capture. Two
// wrappers that together deliver the pre-ExitBootServices display bring-up
// path the R19.M4 kernel-handoff will consume:
//
//   efi_gop_discover()          — LocateProtocol GOP; latch gop_this
//                                 (#792, R19.M3-001).
//   efi_gop_capture()           — read Mode / Mode->Info via gop_this; write
//                                 the six fields the kernel needs into
//                                 _efi_fb_desc (#793, R19.M3-002).
//
// -----------------------------------------------------------------------------
// EFI_GRAPHICS_OUTPUT_PROTOCOL layout (UEFI 2.10 §12.9)
// -----------------------------------------------------------------------------
//
// struct EFI_GRAPHICS_OUTPUT_PROTOCOL {
//   EFI_GRAPHICS_OUTPUT_PROTOCOL_QUERY_MODE  QueryMode;  // +0    (fn ptr)
//   EFI_GRAPHICS_OUTPUT_PROTOCOL_SET_MODE    SetMode;    // +8    (fn ptr)
//   EFI_GRAPHICS_OUTPUT_PROTOCOL_BLT         Blt;        // +16   (fn ptr)
//   EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE       *Mode;       // +24   (mode ptr)
// };
//
// struct EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE {
//   UINT32  MaxMode;                                    // +0
//   UINT32  Mode;                                       // +4
//   EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info;         // +8
//   UINTN   SizeOfInfo;                                 // +16
//   EFI_PHYSICAL_ADDRESS  FrameBufferBase;              // +24
//   UINTN   FrameBufferSize;                            // +32
// };  // sizeof = 40
//
// struct EFI_GRAPHICS_OUTPUT_MODE_INFORMATION {
//   UINT32  Version;                                    // +0
//   UINT32  HorizontalResolution;                       // +4
//   UINT32  VerticalResolution;                         // +8
//   EFI_GRAPHICS_PIXEL_FORMAT  PixelFormat;             // +12 (enum u32)
//   EFI_PIXEL_BITMASK  PixelInformation;                // +16 (16 B struct)
//   UINT32  PixelsPerScanLine;                          // +32
// };
//
// Cross-checked against edk2-stable202408 MdePkg/Include/Protocol/GraphicsOutput.h.
//
// -----------------------------------------------------------------------------
// MVP mode-selection policy
// -----------------------------------------------------------------------------
//
// The full-fidelity path in #792 walks Mode->MaxMode with QueryMode(this,
// mode_num, &size, &info) at each index, ranks by (width*height, BGRA_8888
// preferred over RGB_8888, non-BltOnly required), and calls SetMode(this,
// best_index). Under OVMF (the R19 verification target) the firmware
// initializes GOP with a reasonable default (typically 800x600 or 1024x768
// BGRA_8888) so the current mode is already viable for early console
// rendering. This file's MVP wrappers accept the current mode without
// walking the mode list; the mode-walk follow-up is tracked in
// design/round-retrospectives/r19-preflight.md under
// "gop-mode-walk-follow-up" and lands when the R20 tick brings the kernel's
// framebuffer console beyond the "print at whatever resolution firmware
// gave us" level.
//
// -----------------------------------------------------------------------------
// Standalone-compile discipline
// -----------------------------------------------------------------------------
//
// paideia-as v0.20.1 build --target uefi-x86_64 compiles one .pdx translation
// unit at a time; this file therefore includes minimal local stubs for the
// M2 wrappers it calls (efi_locate_protocol, efi_panic_on_fatal) plus a
// local shadow of _efi_system_table so the file compiles standalone as
// documentation. The real M3 build is a single merged uefi_stub.pdx (see
// tools/build-uefi-stub.sh) where these stubs resolve to the real wrappers.

module UefiGop = structure {

  // ==========================================================================
  // GOP protocol offsets (UEFI 2.10 §12.9)
  // ==========================================================================

  pub let EFI_GOP_OFFSET_QUERY_MODE   : u64 = 0
  pub let EFI_GOP_OFFSET_SET_MODE     : u64 = 8
  pub let EFI_GOP_OFFSET_BLT          : u64 = 16
  pub let EFI_GOP_OFFSET_MODE         : u64 = 24

  pub let EFI_GOP_MODE_OFFSET_MAX_MODE           : u64 = 0
  pub let EFI_GOP_MODE_OFFSET_MODE               : u64 = 4
  pub let EFI_GOP_MODE_OFFSET_INFO               : u64 = 8
  pub let EFI_GOP_MODE_OFFSET_SIZE_OF_INFO       : u64 = 16
  pub let EFI_GOP_MODE_OFFSET_FRAMEBUFFER_BASE   : u64 = 24
  pub let EFI_GOP_MODE_OFFSET_FRAMEBUFFER_SIZE   : u64 = 32

  pub let EFI_GOP_INFO_OFFSET_VERSION            : u64 = 0
  pub let EFI_GOP_INFO_OFFSET_HRES               : u64 = 4
  pub let EFI_GOP_INFO_OFFSET_VRES               : u64 = 8
  pub let EFI_GOP_INFO_OFFSET_PIXEL_FORMAT       : u64 = 12
  pub let EFI_GOP_INFO_OFFSET_PIXELS_PER_SCANLINE: u64 = 32

  // ==========================================================================
  // Storage
  // ==========================================================================
  //
  // gop_this receives the located GOP protocol pointer; downstream capture
  // reads Mode / Mode->Info through it. Single global slot — one framebuffer
  // per boot in the R19 model.

  pub let mut _efi_gop_this : u64 = 0

  // Standalone-compile shadows / stubs (see file preamble).
  pub let mut _efi_system_table : u64 = 0
  pub let mut _efi_last_located_interface : u64 = 0
  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)
  pub let _efi_graphics_output_protocol_guid : [u8; 16] = [
    0xDEu8, 0xA9u8, 0x42u8, 0x90u8,
    0xDCu8, 0x23u8, 0x38u8, 0x4Au8,
    0x96u8, 0xFBu8, 0x7Au8, 0xDEu8,
    0xD0u8, 0x80u8, 0x51u8, 0x6Au8
  ]
  pub let _panic_gop_locate_msg : [u16; 12] = [
    71, 79, 80, 32, 108, 111, 99, 97, 116, 101, 10, 0
  ]

  pub let efi_locate_protocol : (u64, u64) -> u64 !{} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "standalone-compile stub for uefi_gop.pdx; the real wrapper lives in the merged uefi_stub.pdx build",
      block: { mov rax, 0; ret }
    } @no_frame

  pub let efi_panic_on_fatal : (u64, u64, u64) -> () !{} @{} =
    fn (status: u64, message_ptr: u64, message_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "standalone-compile stub for uefi_gop.pdx; the real wrapper lives in the merged uefi_stub.pdx build",
      block: { ret }
    } @no_frame

  // ==========================================================================
  // efi_gop_discover — LocateProtocol GOP + latch gop_this
  // ==========================================================================
  //
  // MVP: accept firmware's current mode without walking. Full mode walk is
  // filed as a follow-up (see file preamble). Panics via efi_panic_on_fatal
  // if LocateProtocol returns a non-success status — GOP is mandatory for
  // the R19 handoff (the kernel needs a framebuffer for its console).
  //
  // Emitted body (unsafe, no frame):
  //   lea  rdi, [rip + _efi_graphics_output_protocol_guid] ; arg0 = Protocol
  //   mov  rsi, 0                                          ; arg1 = Registration (NULL)
  //   call efi_locate_protocol                             ; -> status in rax
  //   ; panic if error (bit 63 set)
  //   mov  rdi, rax                                        ; arg0 = status
  //   lea  rsi, [rip + _panic_gop_locate_msg]              ; arg1 = message
  //   mov  rdx, 0                                          ; arg2 = length (reserved)
  //   call efi_panic_on_fatal                              ; returns iff status OK
  //   ; latch gop_this
  //   mov  rax, [rip + _efi_last_located_interface]
  //   mov  [rip + _efi_gop_this], rax
  //   mov  rax, 0
  //   ret
  //
  // Return: 0 on success (panics on error, so 0 is the only observable value).

  pub let efi_gop_discover : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M3-001 (#792). LocateProtocol EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, latch the located interface pointer into _efi_gop_this for the subsequent capture pass. MVP path: accept firmware's current mode without walking Mode->MaxMode (see file preamble for the mode-walk follow-up rationale). Panics via efi_panic_on_fatal if LocateProtocol fails — GOP is mandatory for the R19 kernel handoff since the early console renders directly into the framebuffer.",
      block: {
        lea rdi, [rip + _efi_graphics_output_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_gop_locate_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_gop_this], rax;
        mov rax, 0;
        ret
      }
    } @no_frame

  // ==========================================================================
  // efi_gop_capture — populate _efi_fb_desc from gop_this
  // ==========================================================================
  //
  // Reads Mode* at offset 24 of gop_this, then reads Info*/FrameBufferBase/
  // FrameBufferSize from Mode and PixelsPerScanLine/H/V/PixelFormat from
  // Mode->Info. Writes the six fields into the _efi_fb_desc slot (fb_desc_t
  // layout — see src/boot/uefi_env.pdx).
  //
  // Pitch is derived as PixelsPerScanLine * 4 (all UEFI 32bpp modes are
  // 4 bytes per pixel; PixelFormat 0/1 = RGBA/BGRA, PixelFormat 2 uses the
  // PixelInformation bitmask but still emits 4-byte pixels in practice on
  // every conformant OVMF/AMI firmware surveyed for R19).
  //
  // Encoder discipline note: paideia-as v0.20.1's PE emitter promotes
  // `mov [rip + sym], r32` to a 64-bit store (the R19.M2 encoder gap
  // mirroring #1251 — RIP-relative stores don't respect narrow-store
  // width). To land 32-bit writes into the packed u32 fields of
  // _efi_fb_desc without clobbering neighbouring fields, we load the
  // descriptor base into a register (`lea rdi, [rip + _efi_fb_desc]`)
  // and issue the stores via the SIB-form addressing
  // (`mov [rdi + offset], edx`), which the encoder emits correctly with
  // the 32-bit prefix. The 64-bit base/size stores go through the
  // same base register for symmetry.
  //
  // Emitted body (unsafe, no frame):
  //   mov  rax, [rip + _efi_gop_this]              ; rax = gop*
  //   mov  rcx, [rax + 24]                         ; rcx = Mode*
  //   lea  rdi, [rip + _efi_fb_desc]               ; rdi = &fb_desc
  //   mov  rdx, [rcx + 24]                         ; rdx = FrameBufferBase (u64)
  //   mov  [rdi + 0], rdx                          ; base
  //   mov  rdx, [rcx + 32]                         ; rdx = FrameBufferSize (u64)
  //   mov  [rdi + 8], rdx                          ; size
  //   mov  r8, [rcx + 8]                           ; r8  = Info*
  //   mov  edx, [r8 + 32]                          ; edx = PixelsPerScanLine (u32)
  //   shl  edx, 2                                  ; pitch = PPSL * 4
  //   mov  [rdi + 16], edx                         ; pitch
  //   mov  edx, [r8 + 4]                           ; edx = HRes
  //   mov  [rdi + 20], edx                         ; width
  //   mov  edx, [r8 + 8]                           ; edx = VRes
  //   mov  [rdi + 24], edx                         ; height
  //   mov  edx, [r8 + 12]                          ; edx = PixelFormat
  //   mov  [rdi + 28], edx                         ; format
  //   ret

  pub let efi_gop_capture : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R19-M3-002 (#793). Read Mode* / Mode->Info fields via the gop_this pointer latched by efi_gop_discover, write the framebuffer descriptor into _efi_fb_desc (fb_desc_t layout, uefi_env.pdx). Pitch = PixelsPerScanLine * 4 (all UEFI 32bpp modes are 4 bytes per pixel per UEFI 2.10 §12.9). Non-volatiles untouched; only volatile GPRs (rax/rcx/rdx/r8) written so @no_frame is sound.",
      block: {
        mov rax, [rip + _efi_gop_this];
        mov rcx, [rax + 24];
        lea rdi, [rip + _efi_fb_desc];
        mov rdx, [rcx + 24];
        mov [rdi + 0], rdx;
        mov rdx, [rcx + 32];
        mov [rdi + 8], rdx;
        mov r8, [rcx + 8];
        mov edx, [r8 + 32];
        shl edx, 2;
        mov [rdi + 16], edx;
        mov edx, [r8 + 4];
        mov [rdi + 20], edx;
        mov edx, [r8 + 8];
        mov [rdi + 24], edx;
        mov edx, [r8 + 12];
        mov [rdi + 28], edx;
        ret
      }
    } @no_frame
}
