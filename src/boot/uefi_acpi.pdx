// src/boot/uefi_acpi.pdx — R19-M3-003 (#794)
//
// RSDP (ACPI Root System Description Pointer) discovery via the UEFI
// EFI_SYSTEM_TABLE.ConfigurationTable array. The ACPI 2.0+ RSDP is anchored
// by the EFI_ACPI_20_TABLE_GUID entry in the firmware-provided config-table
// list (UEFI 2.10 §4.6); the walk below matches on that GUID and latches
// the VendorTable pointer as _efi_rsdp_addr for the R19.M4 kernel handoff.
//
// -----------------------------------------------------------------------------
// EFI_CONFIGURATION_TABLE layout (UEFI 2.10 §4.6.1)
// -----------------------------------------------------------------------------
//
// struct EFI_CONFIGURATION_TABLE {
//   EFI_GUID  VendorGuid;   // +0    (16 B)
//   VOID*     VendorTable;  // +16   (8 B on x86_64)
// };  // sizeof = 24, alignment = 8
//
// SystemTable +104 (EFI_ST_OFFSET_CONFIG_TABLE_NR) holds UINTN
// NumberOfTableEntries (8 B); SystemTable +112 (EFI_ST_OFFSET_CONFIG_TABLE)
// holds the pointer to the entry array. The walk visits each 24-byte entry,
// performs a 16-byte GUID comparison (four u32 chunks or two u64 chunks —
// this MVP uses the u64 form), and stops at the first ACPI 2.0 match.
//
// Prefer ACPI 2.0 (XSDT-anchored) over ACPI 1.0 (RSDT-anchored) per the ACPI
// 2.0+ conformance requirement — 2.0 RSDPs contain both a legacy RsdtAddress
// and a modern XsdtAddress plus a v2 checksum, so a 2.0 hit supersedes any
// 1.0 hit that might also be present in the table. Firmware that publishes
// both puts them in either order; the walk therefore reads the whole table
// and prefers a 2.0 match even if a 1.0 match appears first. This MVP looks
// for the 2.0 GUID only (EFI_ACPI_20_TABLE_GUID); the ACPI 1.0 fallback
// (EFI_ACPI_TABLE_GUID = eb9d2d30-...) lands under R20 when a firmware
// image in the CI matrix ships pre-ACPI-2.0.
//
// -----------------------------------------------------------------------------
// Standalone-compile discipline
// -----------------------------------------------------------------------------
//
// Same pattern as uefi_gop.pdx — local shadow of _efi_system_table + a
// dummy GUID literal so this file compiles standalone as documentation.
// The real build merges this into uefi_stub.pdx (see tools/build-uefi-stub.sh).

module UefiAcpi = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let EFI_CONFIG_TABLE_ENTRY_SIZE : u64 = 24
  pub let EFI_CONFIG_TABLE_VENDOR_TABLE_OFFSET : u64 = 16

  // ==========================================================================
  // Storage
  // ==========================================================================

  pub let mut _efi_rsdp_addr : u64 = 0

  // Standalone-compile shadows.
  pub let mut _efi_system_table : u64 = 0
  pub let _efi_acpi_20_table_guid : [u8; 16] = [
    0x71u8, 0xE8u8, 0x68u8, 0x88u8,
    0xF1u8, 0xE4u8, 0xD3u8, 0x11u8,
    0xBCu8, 0x22u8, 0x00u8, 0x80u8,
    0xC7u8, 0x3Cu8, 0x88u8, 0x81u8
  ]

  // ==========================================================================
  // efi_find_rsdp — walk ConfigurationTable, match ACPI 2.0 GUID
  // ==========================================================================
  //
  // Returns the RSDP pointer in RAX (0 if not found — non-fatal, the caller
  // decides whether to panic; ACPI-absent boot is a valid degraded mode for
  // the R19.M3 discovery flow, e.g. under emulators that skip ACPI init).
  //
  // GUID comparison uses two u64 loads per entry:
  //   guid_lo = *(u64*)&entry.VendorGuid[0]
  //   guid_hi = *(u64*)&entry.VendorGuid[8]
  //   target_lo = *(u64*)&_efi_acpi_20_table_guid[0]
  //   target_hi = *(u64*)&_efi_acpi_20_table_guid[8]
  //   match  iff (guid_lo == target_lo) && (guid_hi == target_hi)
  //
  // This is spec-legal because EFI_GUID has natural 4-byte alignment (u32
  // Data1 leads) and 24 B ConfigurationTable entries are 8-byte aligned in
  // the array (VendorTable is a u64 pointer that anchors the trailing 8 B),
  // so the leading 16 B of each entry lives at an 8-byte-aligned address
  // when the array itself is 8-byte aligned — which UEFI guarantees for
  // EFI_CONFIGURATION_TABLE* per §4.6.1.
  //
  // Emitted body (unsafe, no frame):
  //   mov  rax, [rip + _efi_system_table]    ; rax = SystemTable*
  //   mov  rcx, [rax + 104]                  ; rcx = NumberOfTableEntries (UINTN)
  //   mov  rdx, [rax + 112]                  ; rdx = ConfigurationTable*
  //   lea  rsi, [rip + _efi_acpi_20_table_guid]
  //   mov  r8, [rsi + 0]                     ; r8 = target_lo
  //   mov  r9, [rsi + 8]                     ; r9 = target_hi
  //   mov  rax, 0                            ; rax = result (default: not found)
  //   cmp  rcx, 0
  //   je   efi_find_rsdp_done
  // efi_find_rsdp_loop:
  //   mov  r10, [rdx + 0]                    ; r10 = entry.guid_lo
  //   cmp  r10, r8
  //   jne  efi_find_rsdp_skip
  //   mov  r10, [rdx + 8]                    ; r10 = entry.guid_hi
  //   cmp  r10, r9
  //   jne  efi_find_rsdp_skip
  //   mov  rax, [rdx + 16]                   ; VendorTable = RSDP
  //   jmp  efi_find_rsdp_done
  // efi_find_rsdp_skip:
  //   add  rdx, 24                           ; advance entry pointer
  //   dec  rcx
  //   jne  efi_find_rsdp_loop
  // efi_find_rsdp_done:
  //   mov  [rip + _efi_rsdp_addr], rax
  //   ret

  pub let efi_find_rsdp : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R19-M3-003 (#794). Walks EFI_SYSTEM_TABLE.ConfigurationTable[] (UEFI 2.10 §4.6.1); for each 24-byte entry compares the 16-byte VendorGuid against EFI_ACPI_20_TABLE_GUID using two u64 loads per side; on first match returns entry.VendorTable in RAX (the RSDP address) and latches it into _efi_rsdp_addr, else returns 0. GUID compare uses u64 chunks — spec-legal because EFI_CONFIGURATION_TABLE entries are 8-byte aligned in the firmware-owned array (UEFI 2.10 §4.6.1). Non-fatal on absent ACPI — caller decides whether to escalate. Non-volatiles (RBX/RBP/R12-R15) untouched; only volatile GPRs (RAX/RCX/RDX/RSI/R8-R10) written so @no_frame is sound.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 104];
        mov rdx, [rax + 112];
        lea rsi, [rip + _efi_acpi_20_table_guid];
        mov r8, [rsi + 0];
        mov r9, [rsi + 8];
        mov rax, 0;
        cmp rcx, 0;
        je efi_find_rsdp_done;
      efi_find_rsdp_loop:
        mov r10, [rdx + 0];
        cmp r10, r8;
        jne efi_find_rsdp_skip;
        mov r10, [rdx + 8];
        cmp r10, r9;
        jne efi_find_rsdp_skip;
        mov rax, [rdx + 16];
        jmp efi_find_rsdp_done;
      efi_find_rsdp_skip:
        add rdx, 24;
        dec rcx;
        jne efi_find_rsdp_loop;
      efi_find_rsdp_done:
        mov [rip + _efi_rsdp_addr], rax;
        ret
      }
    } @no_frame
}
