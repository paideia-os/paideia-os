// src/boot/uefi_env.pdx — R19-M3-002 (#793) + R19-M4-001 (#797)
//
// boot_env_t layout constants + the framebuffer descriptor slot the R19.M3
// GOP capture path (#793) writes into. R19.M4-001 (#797) extends this file
// with the full boot_env_t layout that the UEFI stub hands to
// kernel_main_uefi as its sole SysV argument after ExitBootServices returns.
//
// -----------------------------------------------------------------------------
// R19.M3 (#793) fb_desc_t contribution — unchanged
// -----------------------------------------------------------------------------
//
// The 32-byte fb_desc_t (base/size/pitch/width/height/format/_pad) landed at
// #793 as a standalone slot (_efi_fb_desc). It is now the interior sub-struct
// at boot_env_t + 16; the R19.M4 finalizer copies the M3-populated
// _efi_fb_desc into that slot verbatim before ExitBootServices.
//
// -----------------------------------------------------------------------------
// R19.M4-001 (#797) boot_env_t — the kernel handoff contract
// -----------------------------------------------------------------------------
//
// The struct is 256 bytes, 32-byte aligned. The kernel_main_uefi entry
// receives its physical address in RDI (SysV first arg); it verifies
// env->magic first, then consumes the sub-fields in whatever order the
// early bring-up sequence requires. The reserved tail is deliberately
// large — R20+ additions (SMBIOS pointer, TPM log length, boot-time
// microarch capability snapshot) land in the tail without breaking layout.
//
// struct boot_env_t {              //  size  offset  producer
//   u64  magic;                    //   8    +0      const (this file)
//   u32  version;                  //   4    +8      const (this file)
//   u32  _pad;                     //   4    +12     const (this file)
//   fb_desc_t fb;                  //  32    +16     #793  efi_gop_capture
//   u64  rsdp_pa;                  //   8    +48     #794  efi_find_rsdp
//   u64  image_base;               //   8    +56     #796  efi_get_loaded_image
//   u64  image_size;               //   8    +64     #796  efi_get_loaded_image
//   u64  efi_memmap_pa;            //   8    +72     #798  finalizer (buffer VA=PA)
//   u64  efi_memmap_size;          //   8    +80     #789  efi_get_memory_map
//   u32  efi_memmap_desc_size;     //   4    +88     #789  efi_get_memory_map
//   u32  efi_memmap_desc_ver;      //   4    +92     #789  efi_get_memory_map
//   u64  runtime_services_pa;      //   8    +96     #797  finalizer (ST+88)
//   u8   _reserved[152];           // 152   +104
// };                               // 256
//
// -----------------------------------------------------------------------------
// Magic derivation
// -----------------------------------------------------------------------------
//
// ASCII "PAIDBENV" (8 bytes) laid out little-endian in the u64 slot:
//
//   byte[0] = 'P' = 0x50    byte[4] = 'B' = 0x42
//   byte[1] = 'A' = 0x41    byte[5] = 'E' = 0x45
//   byte[2] = 'I' = 0x49    byte[6] = 'N' = 0x4E
//   byte[3] = 'D' = 0x44    byte[7] = 'V' = 0x56
//
// u64 value (byte[7]<<56 | ... | byte[0]) = 0x564E454244494150.
//
// The kernel-side verifier compares to this literal before consuming any
// field. A mismatch signifies either wrong-caller wiring (something jumped
// to kernel_main_uefi without going through the UEFI stub) or memory
// corruption between the finalizer's stores and the kernel's loads.
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// _efi_fb_desc remains as the M3-populated intermediate slot — the M4
// finalizer copies it into boot_env_t.fb rather than having the M3 wrappers
// write into the boot_env slot directly. This preserves the M3 wrappers as
// pure "populate my sibling slot" units, keeps the boot_env layout under
// the finalizer's sole authority, and localises any future layout drift to
// exactly one copy path.
//
// _boot_env is the authoritative slot. It lives in .bss (32-byte aligned,
// 256 bytes). UEFI marks the loaded image's .bss region as EfiLoaderData,
// which survives ExitBootServices, so the buffer is still readable when
// kernel_main_uefi runs.

module UefiEnv = structure {

  // ==========================================================================
  // fb_desc_t field offsets (bytes into the descriptor) — R19.M3 (#793)
  // ==========================================================================

  pub let FB_DESC_OFFSET_BASE   : u64 = 0    // u64
  pub let FB_DESC_OFFSET_SIZE   : u64 = 8    // u64
  pub let FB_DESC_OFFSET_PITCH  : u64 = 16   // u32
  pub let FB_DESC_OFFSET_WIDTH  : u64 = 20   // u32
  pub let FB_DESC_OFFSET_HEIGHT : u64 = 24   // u32
  pub let FB_DESC_OFFSET_FORMAT : u64 = 28   // u32

  pub let FB_DESC_SIZE_BYTES    : u64 = 32

  // EFI_GRAPHICS_PIXEL_FORMAT enum values (UEFI 2.10 §12.9)
  pub let EFI_PIXEL_RGB_8888    : u64 = 0
  pub let EFI_PIXEL_BGR_8888    : u64 = 1
  pub let EFI_PIXEL_BITMASK     : u64 = 2
  pub let EFI_PIXEL_BLT_ONLY    : u64 = 3

  // ==========================================================================
  // boot_env_t field offsets — R19.M4-001 (#797)
  // ==========================================================================

  pub let BOOT_ENV_OFFSET_MAGIC            : u64 = 0
  pub let BOOT_ENV_OFFSET_VERSION          : u64 = 8
  pub let BOOT_ENV_OFFSET_PAD              : u64 = 12
  pub let BOOT_ENV_OFFSET_FB               : u64 = 16
  pub let BOOT_ENV_OFFSET_RSDP_PA          : u64 = 48
  pub let BOOT_ENV_OFFSET_IMAGE_BASE       : u64 = 56
  pub let BOOT_ENV_OFFSET_IMAGE_SIZE       : u64 = 64
  pub let BOOT_ENV_OFFSET_EFI_MEMMAP_PA    : u64 = 72
  pub let BOOT_ENV_OFFSET_EFI_MEMMAP_SIZE  : u64 = 80
  pub let BOOT_ENV_OFFSET_EFI_MEMMAP_DSIZE : u64 = 88
  pub let BOOT_ENV_OFFSET_EFI_MEMMAP_DVER  : u64 = 92
  pub let BOOT_ENV_OFFSET_RUNTIME_SVC_PA   : u64 = 96

  pub let BOOT_ENV_SIZE_BYTES              : u64 = 256
  pub let BOOT_ENV_VERSION                 : u64 = 1

  // Magic constant — see file preamble for derivation.
  pub let BOOT_ENV_MAGIC                   : u64 = 0x564E454244494150

  // ==========================================================================
  // _efi_fb_desc — framebuffer descriptor storage (M3 target)
  // ==========================================================================
  //
  // 32 bytes = 4 x u64. Zero-initialized at .bss-load; efi_gop_capture
  // (#793) fills it with the values read from Mode / Mode->Info once
  // efi_gop_discover has latched gop_this. Copied verbatim into
  // _boot_env + BOOT_ENV_OFFSET_FB by the R19.M4 finalizer.

  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)

  // ==========================================================================
  // _boot_env — the kernel-handoff struct
  // ==========================================================================
  //
  // 256 bytes = 32 x u64. Populated by the R19.M4 finalizer immediately
  // before ExitBootServices; consumed by kernel_main_uefi post-EBS via
  // RDI = &_boot_env. .bss (EfiLoaderData) — survives ExitBootServices.

  pub let mut _boot_env : [u64; 32] = uninit @align(32)
}
