// src/boot/uefi_env.pdx — R19-M3-002 (#793) / R19-M4 seed
//
// boot_env_t layout constants + the framebuffer descriptor slot the R19.M3
// GOP capture path (#793) writes into. This file establishes the ABI-fixed
// layout of the boot_env_t struct that R19.M4 will finalize (ExitBootServices
// + kernel handoff) and hands the M3 wrappers the offsets they need to store
// their discovery results into the shared bring-up state.
//
// -----------------------------------------------------------------------------
// R19.M3 scope
// -----------------------------------------------------------------------------
//
// #793 (M3-002) landing:
//   - fb_desc_t offset table (base/size/pitch/width/height/format/_pad).
//   - _efi_fb_desc storage slot (single [u64; 4] = 32 B, 8-byte aligned) that
//     efi_gop_capture writes into once efi_gop_discover has latched gop_this.
//
// R19.M4 will grow boot_env_t to also carry:
//   - rsdp_addr    (from #794 efi_find_rsdp)
//   - image_base   (from #796 efi_get_loaded_image)
//   - image_size   (from #796 efi_get_loaded_image)
//   - memmap_desc  (buffer + size + key + desc_size — from #789 GetMemoryMap)
//   - tcg2_log_present (u8 flag from #795)
//
// The M3 wrappers write to individual .data slots at this milestone; the M4
// finalization pass copies them into a single contiguous boot_env_t buffer
// that the kernel_main_uefi handoff hands to the kernel as its first argument.
//
// -----------------------------------------------------------------------------
// fb_desc_t layout (32 bytes, 8-byte aligned)
// -----------------------------------------------------------------------------
//
// struct fb_desc_t {
//   u64  base;      // +0   Physical address of framebuffer
//   u64  size;      // +8   Byte size of framebuffer memory region
//   u32  pitch;     // +16  Bytes per scanline (== PixelsPerScanLine * bpp)
//   u32  width;     // +20  Horizontal resolution in pixels
//   u32  height;    // +24  Vertical resolution in pixels
//   u32  format;    // +28  UEFI EFI_GRAPHICS_PIXEL_FORMAT enum
//                   //        0 = RGBA_8888, 1 = BGRA_8888, 2 = BitMask,
//                   //        3 = BltOnly (invalid for direct-fb rendering)
// };  // sizeof = 32
//
// The kernel's early console driver consumes this via the boot_env_t
// snapshot it receives at handoff. All fields are u32/u64 aligned to their
// natural boundary; the struct as a whole is 8-byte aligned (natural u64
// alignment) so a `mov [rip+_efi_fb_desc], rax` store of the base field
// takes the fast-path aligned-qword encoding.
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// A single global slot suffices — the R19.M3 discovery flow is strictly
// serialised pre-ExitBootServices, and there is exactly one framebuffer
// per boot. If R19.M4+ needs to expose multiple GOP handles simultaneously
// (multi-head setup), this becomes an [fb_desc_t; N] array + a count field.

module UefiEnv = structure {

  // ==========================================================================
  // fb_desc_t field offsets (bytes into the descriptor)
  // ==========================================================================

  pub let FB_DESC_OFFSET_BASE   : u64 = 0    // u64
  pub let FB_DESC_OFFSET_SIZE   : u64 = 8    // u64
  pub let FB_DESC_OFFSET_PITCH  : u64 = 16   // u32
  pub let FB_DESC_OFFSET_WIDTH  : u64 = 20   // u32
  pub let FB_DESC_OFFSET_HEIGHT : u64 = 24   // u32
  pub let FB_DESC_OFFSET_FORMAT : u64 = 28   // u32

  pub let FB_DESC_SIZE_BYTES    : u64 = 32

  // EFI_GRAPHICS_PIXEL_FORMAT enum values (UEFI 2.10 §12.9)
  pub let EFI_PIXEL_RGB_8888    : u64 = 0
  pub let EFI_PIXEL_BGR_8888    : u64 = 1
  pub let EFI_PIXEL_BITMASK     : u64 = 2
  pub let EFI_PIXEL_BLT_ONLY    : u64 = 3

  // ==========================================================================
  // _efi_fb_desc — framebuffer descriptor storage
  // ==========================================================================
  //
  // 32 bytes = 4 x u64. Zero-initialized at .data-load; efi_gop_capture
  // (#793) fills it with the values read from Mode / Mode->Info once
  // efi_gop_discover has latched gop_this. Read by the R19.M4 handoff
  // path when it builds the boot_env_t snapshot for the kernel.

  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)
}
