// src/boot/uefi_exit.pdx — R19-M4-002 (#798)
//
// Typed wrapper over EFI_BOOT_SERVICES.ExitBootServices (UEFI 2.10 §7.4.6).
// This is the boundary call — the last firmware invocation before all Boot
// Services pointers become invalid. After ExitBootServices returns EFI_SUCCESS,
// the paideia kernel owns the machine: only Runtime Services survive, and the
// UEFI stub must not touch the console, the loaded-image protocols, or any
// BS-issued allocation.
//
// -----------------------------------------------------------------------------
// EFI_BOOT_SERVICES.ExitBootServices vtable slot (UEFI 2.10 §4.4.1)
// -----------------------------------------------------------------------------
//
// EFI_BOOT_SERVICES.ExitBootServices sits at offset +232 (0xE8) — the last
// slot in the Image Services block, immediately following UnloadImage (+224).
// Cross-checked against edk2-stable202408 MdePkg/Include/Uefi/UefiSpec.h and
// against the vtable table maintained in src/boot/uefi_types.pdx (comment
// tier — this milestone lifts EFI_BS_OFFSET_EXIT_BOOT_SERVICES = 232 into
// the exported constant table).
//
// Function signature (UEFI 2.10 §7.4.6):
//   EFI_STATUS ExitBootServices (
//     IN EFI_HANDLE  ImageHandle,    // arg 0 — the handle firmware issued at LoadImage
//     IN UINTN       MapKey          // arg 1 — the map key returned by the latest GetMemoryMap
//   );
//
// Semantics:
//   - EFI_SUCCESS: firmware releases the machine, all BS pointers now invalid.
//   - EFI_INVALID_PARAMETER: the caller's MapKey does not match firmware's
//     current memory map serial. Standard remedy: call GetMemoryMap again to
//     refresh the key (which may have moved because firmware allocated during
//     some intervening event — e.g. a driver's event callback), then retry.
//     Any allocation, protocol call, or console write between the refresh
//     and the retry will invalidate the key again — so the refresh + retry
//     loop must be tight.
//
// -----------------------------------------------------------------------------
// Cross-ABI (paideia default / SysV → MS x64) marshalling — 2 args
// -----------------------------------------------------------------------------
//
// paideia-as ARG_REGS  = [RDI, RSI, RDX, RCX, R8, R9]  (SysV)
// paideia-as MS_ARG_REGS = [RCX, RDX, R8, R9]           (MS x64)
//
// Two-arg dispatch: RDI → RCX, RSI → RDX; no reshuffle hazards (destinations
// are non-overlapping with sources). Same 32B shadow + 8B alignment fix
// pattern established at #787 (uefi_alloc.pdx AllocatePages wrapper):
// `sub rsp, 40` transitions RSP from 8 → 0 mod 16, `call [rax + 232]`,
// `add rsp, 40` unwinds.
//
// -----------------------------------------------------------------------------
// Retry policy (caller-side)
// -----------------------------------------------------------------------------
//
// This wrapper is the primitive single-shot dispatch. The retry loop lives
// in the finalizer (efi_finalize_and_handoff in uefi_stub.pdx):
//
//   retries = 3
//   loop:
//     efi_get_memory_map(&size, buf, &key, &desc_size, &desc_ver)
//     status = efi_exit_boot_services(image_handle, key)
//     if status == EFI_SUCCESS -> break
//     retries -= 1
//     if retries == 0 -> efi_panic_on_fatal
//
// CRITICAL: between the final `efi_get_memory_map` (which populates `key`)
// and `efi_exit_boot_services` (which consumes `key`), the finalizer MUST
// NOT invoke any Boot Service, allocate memory, or write to the console.
// Any such call may trigger firmware to update its internal memory map,
// invalidating the just-latched key. The finalizer is written to make this
// invariant visually obvious: no other calls appear between the get_memory_map
// site and the exit_boot_services site in the retry loop body.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// SysV non-volatiles (RBX, RBP, R12-R15, RSP): unchanged. Only RAX/RCX/RDX
// are written; all volatile in both SysV and MS x64. Therefore @no_frame
// is sound.
//
// -----------------------------------------------------------------------------
// Provisional `_efi_system_table` shadow
// -----------------------------------------------------------------------------
//
// Same standalone-compile discipline as the M2 wrappers — local .data slot
// so this file compiles individually under `paideia-as build --target
// uefi-x86_64`. When multi-file link lands the local slot resolves to the
// single global in uefi_stub.pdx.

module UefiExit = structure {

  // ==========================================================================
  // .data slots — standalone-compile shadows
  // ==========================================================================

  pub let mut _efi_system_table : u64 = 0

  // ==========================================================================
  // efi_exit_boot_services — wraps EFI_BOOT_SERVICES.ExitBootServices
  // ==========================================================================
  //
  // Emitted body (unsafe, @no_frame):
  //   mov  rax, [rip + _efi_system_table]     ; SystemTable*
  //   mov  rax, [rax + 96]                    ; BootServices* (EFI_ST_OFFSET_BOOT_SERVICES)
  //   mov  rcx, rdi                           ; MS arg 0 = ImageHandle (from SysV RDI)
  //   mov  rdx, rsi                           ; MS arg 1 = MapKey (from SysV RSI)
  //   sub  rsp, 40                            ; 32B shadow + 8B align (8→0 mod 16)
  //   call [rax + 232]                        ; EFI_BS_OFFSET_EXIT_BOOT_SERVICES
  //   add  rsp, 40                            ; symmetric unwind
  //   ret                                     ; RAX = EFI_STATUS

  pub let efi_exit_boot_services : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, map_key: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M4-002 (#798). Typed wrapper for EFI_BOOT_SERVICES.ExitBootServices (UEFI 2.10 §7.4.6, vtable +232). 2-argument MS x64 dispatch: loads BootServices* via _efi_system_table indirection (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES), marshals SysV RDI/RSI into MS RCX/RDX (no hazard — destinations non-overlapping with sources), reserves 32-byte shadow plus 8-byte alignment fixup (RSP transitions 8→0 mod 16 as MS x64 requires immediately before CALL), issues indirect call via `FF /2 [rax + 232]`, symmetric unwind. Returns EFI_STATUS in RAX (EFI_SUCCESS = 0 on machine release, EFI_INVALID_PARAMETER = 0x8000000000000002 on stale MapKey — caller-side retry loop lives in the finalizer). Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs written so @no_frame is sound. CRITICAL: on EFI_SUCCESS, all Boot Services pointers become firmware-invalidated; only Runtime Services survive. Callers must therefore latch RuntimeServices* into boot_env_t BEFORE invoking this wrapper.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        sub rsp, 40;
        call [rax + 232];
        add rsp, 40;
        ret
      }
    } @no_frame
}
