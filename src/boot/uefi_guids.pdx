// src/boot/uefi_guids.pdx — R19-M1-004 (#786)
//
// UEFI GUID type layout + typed GUID constants for the four protocol /
// configuration-table identifiers the paideia-native EFI stub consumes at
// R19.M2/M3. Cited spec: UEFI 2.10 §II-4 (EFI_GUID definition) and
// RFC 4122 §4.1 (variant/layout). Cross-checked against edk2
// MdePkg/Include/Uefi/UefiBaseType.h + protocol-specific headers at
// edk2-stable202408 (r19-preflight lock).
//
// -----------------------------------------------------------------------------
// EFI_GUID layout (UEFI 2.10 §II-4 "Common UEFI Data Types" / RFC 4122 §4.1)
// -----------------------------------------------------------------------------
//
// struct EFI_GUID {
//   UINT32  Data1;      // +0   (little-endian on the wire)
//   UINT16  Data2;      // +4   (little-endian on the wire)
//   UINT16  Data3;      // +6   (little-endian on the wire)
//   UINT8   Data4[8];   // +8   (opaque byte sequence, no endianness swap)
// };  // sizeof = 16, alignment = 4 (natural u32)
//
// The first three fields are integer-typed and therefore serialize in host
// (little-endian on x86_64) byte order — the on-disk / on-wire representation
// of the GUID reverses the printed nibble order for those three groups.
// Data4 is a byte array and prints/serializes in source order verbatim.
//
// Canonical printed form (RFC 4122 §3):  XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
//                                        [ Data1 ]-[D2]-[D3]-[D4[0..2]]-[D4[2..8]]
//
// paideia-as v0.21 lacks aggregate `struct` syntax that could bind field
// names to offsets; per the discipline established in `uefi_types.pdx` we
// export the layout as offset constants + a size anchor, and materialise each
// GUID as a [u8; 16] literal already in on-wire (little-endian for Data1/2/3,
// verbatim for Data4) order. LocateProtocol / config-table walk sites hand
// the address of one of these arrays to firmware; firmware performs a
// byte-for-byte 16-byte compare against its own GUID table (UEFI 2.10
// §7.3.11 EFI_BOOT_SERVICES.LocateProtocol pseudocode), so as long as our
// encoding matches the spec byte pattern, the compare succeeds.
//
// -----------------------------------------------------------------------------
// GUID string → byte-array conversion recipe
// -----------------------------------------------------------------------------
//
// Given a printed GUID  AAAAAAAA-BBBB-CCCC-DDEE-FFGGHHIIJJKK  the on-wire
// 16-byte layout is:
//
//   [ Data1 LE ][ Data2 LE ][ Data3 LE ][ Data4 verbatim ]
//   AA AA AA AA  BB BB CC CC  DD EE FF GG HH II JJ KK
//     reverse     reverse       (source order preserved)
//    to:            to:
//   AA AA AA AA    BB BB
//    ->             ->
//   {byte3,byte2,byte1,byte0}  {byte1,byte0}  {byte1,byte0}  {b0..b7}
//
// Worked example — EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID = 9042A9DE-23DC-4A38-96FB-7ADED080516A
//   Data1 = 0x9042A9DE  -> bytes  DE A9 42 90
//   Data2 = 0x23DC      -> bytes  DC 23
//   Data3 = 0x4A38      -> bytes  38 4A
//   Data4 = 96 FB 7A DE D0 80 51 6A  (unchanged)
//   Full  =             DE A9 42 90  DC 23  38 4A  96 FB 7A DE D0 80 51 6A
//
// -----------------------------------------------------------------------------
// R19.M1 scope + downstream consumers
// -----------------------------------------------------------------------------
//
// #786 (M1-004) delivers:
//   - EFI_GUID_SIZE_BYTES + EFI_GUID_OFFSET_{DATA1,DATA2,DATA3,DATA4} anchors.
//   - Four typed [u8; 16] constants for the GUIDs M2/M3 consume:
//       _efi_graphics_output_protocol_guid   -> #788 (LocateProtocol), #792/#793 (GOP mode + framebuffer)
//       _efi_acpi_20_table_guid              -> #788 (config-table walk), #794 (RSDP)
//       _efi_tcg2_protocol_guid              -> #788 (LocateProtocol), #795 (TPM log)
//       _efi_loaded_image_protocol_guid      -> #796 (OpenProtocol on ImageHandle)
//
// Not yet linked into build/uefi/uefi_stub.efi — tools/build-uefi-stub.sh
// compiles a single translation unit (uefi_stub.pdx) at R19.M1 per its
// preamble. Same disposition as uefi_types.pdx and uefi_strings.pdx. #788
// (LocateProtocol wrapper) is the first consumer and will either fold the
// arrays into uefi_stub.pdx via a paideia-as `use` directive or trigger the
// M2 multi-file build fan-out. Until then this file compiles standalone as
// a well-formed .pdx module and serves as the authoritative GUID reference
// for R19.M2+.
//
// -----------------------------------------------------------------------------
// Byte-fixture cross-reference (edk2-stable202408)
// -----------------------------------------------------------------------------
//
//   Constant                                edk2 header                                      Ref DEFINE
//   --------------------------------------  ------------------------------------------------ ----------
//   EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID       MdePkg/Include/Protocol/GraphicsOutput.h         L.19
//   EFI_ACPI_20_TABLE_GUID                  MdePkg/Include/Guid/Acpi.h                       L.22
//   EFI_TCG2_PROTOCOL_GUID                  MdePkg/Include/Protocol/Tcg2Protocol.h           L.21
//   EFI_LOADED_IMAGE_PROTOCOL_GUID          MdePkg/Include/Protocol/LoadedImage.h            L.23
//
// The AC-required "byte-for-byte fixture" test is nominally #786's own scope;
// it becomes a live comparison the moment #788 uses one of these constants
// against a real OVMF LocateProtocol call (fixture #802-style boot check).

module UefiGuids = structure {

  // ==========================================================================
  // EFI_GUID layout anchors
  // ==========================================================================
  //
  // Exported so downstream wrappers (#788 LocateProtocol, #796 OpenProtocol)
  // can index into a GUID buffer field-by-field without hard-coding the
  // magic constants at each callsite.

  pub let EFI_GUID_SIZE_BYTES     : u64 = 16
  pub let EFI_GUID_OFFSET_DATA1   : u64 = 0    // u32 LE
  pub let EFI_GUID_OFFSET_DATA2   : u64 = 4    // u16 LE
  pub let EFI_GUID_OFFSET_DATA3   : u64 = 6    // u16 LE
  pub let EFI_GUID_OFFSET_DATA4   : u64 = 8    // [u8; 8]

  // ==========================================================================
  // EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID
  //   printed:  9042A9DE-23DC-4A38-96FB-7ADED080516A
  //   spec:     UEFI 2.10 §12.9 (EFI_GRAPHICS_OUTPUT_PROTOCOL)
  //   consumer: #788 (LocateProtocol), #792 (GOP mode query), #793 (framebuffer latch)
  // ==========================================================================
  //
  // Data1 = 0x9042A9DE  -> DE A9 42 90
  // Data2 = 0x23DC      -> DC 23
  // Data3 = 0x4A38      -> 38 4A
  // Data4 = 96 FB 7A DE D0 80 51 6A
  pub let _efi_graphics_output_protocol_guid : [u8; 16] = [
    0xDEu8, 0xA9u8, 0x42u8, 0x90u8,   // Data1 LE  (0x9042A9DE)
    0xDCu8, 0x23u8,                    // Data2 LE  (0x23DC)
    0x38u8, 0x4Au8,                    // Data3 LE  (0x4A38)
    0x96u8, 0xFBu8, 0x7Au8, 0xDEu8,   // Data4[0..4]
    0xD0u8, 0x80u8, 0x51u8, 0x6Au8    // Data4[4..8]
  ]

  // ==========================================================================
  // EFI_ACPI_20_TABLE_GUID
  //   printed:  8868E871-E4F1-11D3-BC22-0080C73C8881
  //   spec:     UEFI 2.10 §4.6 (Configuration Table) — ACPI 2.0+ RSDP anchor
  //   consumer: #788 (config-table walk), #794 (RSDP latch)
  // ==========================================================================
  //
  // Data1 = 0x8868E871  -> 71 E8 68 88
  // Data2 = 0xE4F1      -> F1 E4
  // Data3 = 0x11D3      -> D3 11
  // Data4 = BC 22 00 80 C7 3C 88 81
  pub let _efi_acpi_20_table_guid : [u8; 16] = [
    0x71u8, 0xE8u8, 0x68u8, 0x88u8,   // Data1 LE  (0x8868E871)
    0xF1u8, 0xE4u8,                    // Data2 LE  (0xE4F1)
    0xD3u8, 0x11u8,                    // Data3 LE  (0x11D3)
    0xBCu8, 0x22u8, 0x00u8, 0x80u8,   // Data4[0..4]
    0xC7u8, 0x3Cu8, 0x88u8, 0x81u8    // Data4[4..8]
  ]

  // ==========================================================================
  // EFI_TCG2_PROTOCOL_GUID
  //   printed:  607F766C-7455-42BE-930B-E4D76DB2720F
  //   spec:     TCG EFI Protocol Specification, Family 2.0, Rev. 00.13 §6.1
  //             (referenced from UEFI 2.10 §32.1 measured-boot integration)
  //   consumer: #788 (LocateProtocol), #795 (TPM event log)
  // ==========================================================================
  //
  // Data1 = 0x607F766C  -> 6C 76 7F 60
  // Data2 = 0x7455      -> 55 74
  // Data3 = 0x42BE      -> BE 42
  // Data4 = 93 0B E4 D7 6D B2 72 0F
  pub let _efi_tcg2_protocol_guid : [u8; 16] = [
    0x6Cu8, 0x76u8, 0x7Fu8, 0x60u8,   // Data1 LE  (0x607F766C)
    0x55u8, 0x74u8,                    // Data2 LE  (0x7455)
    0xBEu8, 0x42u8,                    // Data3 LE  (0x42BE)
    0x93u8, 0x0Bu8, 0xE4u8, 0xD7u8,   // Data4[0..4]
    0x6Du8, 0xB2u8, 0x72u8, 0x0Fu8    // Data4[4..8]
  ]

  // ==========================================================================
  // EFI_LOADED_IMAGE_PROTOCOL_GUID
  //   printed:  5B1B31A1-9562-11D2-8E3F-00A0C969723B
  //   spec:     UEFI 2.10 §9.1 (EFI_LOADED_IMAGE_PROTOCOL)
  //   consumer: #796 (OpenProtocol on ImageHandle — surfaces LoadOptions /
  //             DeviceHandle / FilePath for the stub-side self-descriptor)
  // ==========================================================================
  //
  // Data1 = 0x5B1B31A1  -> A1 31 1B 5B
  // Data2 = 0x9562      -> 62 95
  // Data3 = 0x11D2      -> D2 11
  // Data4 = 8E 3F 00 A0 C9 69 72 3B
  pub let _efi_loaded_image_protocol_guid : [u8; 16] = [
    0xA1u8, 0x31u8, 0x1Bu8, 0x5Bu8,   // Data1 LE  (0x5B1B31A1)
    0x62u8, 0x95u8,                    // Data2 LE  (0x9562)
    0xD2u8, 0x11u8,                    // Data3 LE  (0x11D2)
    0x8Eu8, 0x3Fu8, 0x00u8, 0xA0u8,   // Data4[0..4]
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8    // Data4[4..8]
  ]
}
