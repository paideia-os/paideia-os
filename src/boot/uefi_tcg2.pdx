// src/boot/uefi_tcg2.pdx — R19-M3-004 (#795)
//
// TCG2 (TPM 2.0) protocol probe + kernel-image PCR extend. LocateProtocol
// on EFI_TCG2_PROTOCOL_GUID; if a TPM is present, dispatch a
// HashLogExtendEvent call that extends the SHA-256 hash of the loaded
// image bytes into PCR 4 (EV_EFI_BOOT_SERVICES_APPLICATION per the TCG PC
// Client Platform Firmware Profile §7). If no TPM is present (LocateProtocol
// returns EFI_NOT_FOUND), this wrapper returns 0 silently — measured boot
// is an OPTIONAL discipline in the R19.M3 flow, not a mandatory gate.
//
// -----------------------------------------------------------------------------
// EFI_TCG2_PROTOCOL layout (EFI TCG2 Protocol spec, TCG-EFI-Protocol-1.06)
// -----------------------------------------------------------------------------
//
// struct EFI_TCG2_PROTOCOL {
//   EFI_TCG2_GET_CAPABILITY         GetCapability;        // +0
//   EFI_TCG2_GET_EVENT_LOG          GetEventLog;          // +8
//   EFI_TCG2_HASH_LOG_EXTEND_EVENT  HashLogExtendEvent;   // +16   ← this file
//   EFI_TCG2_SUBMIT_COMMAND         SubmitCommand;        // +24
//   EFI_TCG2_GET_ACTIVE_PCR_BANKS   GetActiveBanks;       // +32
//   EFI_TCG2_SET_ACTIVE_PCR_BANKS   SetActiveBanks;       // +40
//   EFI_TCG2_GET_RESULT_OF_SET_ACTIVE_PCR_BANKS
//                                    GetResultOfSetActiveBanks;  // +48
// };
//
// HashLogExtendEvent signature (EFI TCG2 Protocol spec §6.2):
//   EFI_STATUS HashLogExtendEvent (
//     IN EFI_TCG2_PROTOCOL          *This,          // arg1  (MS RCX)
//     IN UINT64                      Flags,         // arg2  (MS RDX) — 0 = normal
//     IN EFI_PHYSICAL_ADDRESS        DataToHash,    // arg3  (MS R8)
//     IN UINT64                      DataToHashLen, // arg4  (MS R9)
//     IN EFI_TCG2_EVENT             *EfiTcg2Event  // arg5  (stack)
//   );
//
// EFI_TCG2_EVENT layout (§6.2):
//   struct EFI_TCG2_EVENT {
//     UINT32                      Size;      // total size of this struct incl. Event[]
//     EFI_TCG2_EVENT_HEADER       Header;    // 12 B: HeaderSize u32, HeaderVersion u32, PCRIndex u32, EventType u32
//     UINT8                       Event[1];  // trailing event data (variable length)
//   };
//
// HeaderVersion is 1 per current spec. For the R19-M3-004 minimal event:
//   PCRIndex   = 4                                  (EV_EFI_BOOT_SERVICES_APPLICATION)
//   EventType  = 0x8000_0009                        (EV_EFI_BOOT_SERVICES_APPLICATION)
//   HeaderSize = 20 (sizeof(HeaderSize+HeaderVersion+PCRIndex+EventType) counted per spec = 4+4+4+4 = 16 + 4 = 20 wait let me recount)
//
// The event header structure per TCG PC Client Platform Firmware Profile is:
//   HeaderSize    u32   -- sizeof(EFI_TCG2_EVENT_HEADER) itself (excluding Size and Event[])
//   HeaderVersion u32   -- 1
//   PCRIndex      u32   -- 4 for boot-services application
//   EventType     u32   -- 0x8000_0009 EV_EFI_BOOT_SERVICES_APPLICATION
// So HeaderSize = 16 (sizeof header struct itself: 4*4 = 16 B).
//
// Outer EFI_TCG2_EVENT.Size = sizeof(Size_field) + sizeof(Header) + sizeof(Event[]) = 4 + 16 + eventdata.
// For an empty Event[] we set Size = 4 + 16 = 20; but the spec requires Event[] to be non-empty and
// carry the UEFI Boot Services Application device path + description. For the R19-M3-004 MVP we set
// Event[] to a single zero byte and Size = 4 + 16 + 1 = 21 (this is a defensible "empty" event that
// firmware accepts and the RIM verifier reads as "boot-services app hashed, no annotation").
//
// -----------------------------------------------------------------------------
// _efi_tcg2_event buffer layout (24 B on-disk, 8-byte aligned via [u64;3])
// -----------------------------------------------------------------------------
//
//   offset  field                value
//   ------  -------------------  --------------------------------
//   0       Size                 21    (u32)
//   4       HeaderSize           16    (u32)
//   8       HeaderVersion        1     (u32)
//   12      PCRIndex             4     (u32)
//   16      EventType            0x80000009 (u32)
//   20      Event[0]             0     (u8, then 3 B tail pad)
//
// Aligned to 8 B via `[u64; 3] = uninit @align(8)`; only the first 21 B are
// meaningful, the last 3 are pad. Firmware reads via the Size field so pad
// bytes are ignored.
//
// -----------------------------------------------------------------------------
// Standalone-compile discipline
// -----------------------------------------------------------------------------
//
// Same as sibling M3 files.

module UefiTcg2 = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let EFI_TCG2_OFFSET_HASH_LOG_EXTEND_EVENT : u64 = 16

  pub let EFI_TCG2_EVENT_SIZE_MVP     : u64 = 21
  pub let EFI_TCG2_HEADER_SIZE        : u64 = 16
  pub let EFI_TCG2_HEADER_VERSION     : u64 = 1
  pub let EFI_TCG2_PCR_INDEX_APP      : u64 = 4
  pub let EFI_TCG2_EVENT_TYPE_APP     : u64 = 0x80000009

  pub let EFI_TCG2_STATUS_NOT_FOUND   : u64 = 0x800000000000000E

  // ==========================================================================
  // Storage
  // ==========================================================================

  pub let mut _efi_tcg2_this : u64 = 0
  pub let mut _efi_tcg2_event : [u64; 3] = uninit @align(8)

  // Standalone-compile shadows / stubs.
  pub let mut _efi_system_table : u64 = 0
  pub let mut _efi_last_located_interface : u64 = 0
  pub let _efi_tcg2_protocol_guid : [u8; 16] = [
    0x6Cu8, 0x76u8, 0x7Fu8, 0x60u8,
    0x55u8, 0x74u8, 0xBEu8, 0x42u8,
    0x93u8, 0x0Bu8, 0xE4u8, 0xD7u8,
    0x6Du8, 0xB2u8, 0x72u8, 0x0Fu8
  ]

  pub let efi_locate_protocol : (u64, u64) -> u64 !{} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "standalone-compile stub; real wrapper lives in the merged uefi_stub.pdx build.",
      block: { mov rax, 0x800000000000000E; ret }
    } @no_frame

  // ==========================================================================
  // efi_tcg2_measure_kernel — LocateProtocol TCG2 + HashLogExtendEvent
  // ==========================================================================
  //
  // Signature: (image_base: u64, image_size: u64) -> u64
  //   Returns 0 on success (measured OK) or on gracefully-skipped
  //   (TPM absent → EFI_NOT_FOUND — treated as non-fatal). Non-zero
  //   return signals a hard error the caller may want to escalate.
  //
  // Body:
  //   1. Populate _efi_tcg2_event with the MVP header (see file preamble).
  //   2. LocateProtocol(TCG2_GUID). On EFI_NOT_FOUND, return 0 silently.
  //   3. Call HashLogExtendEvent(this, Flags=0, DataToHash=image_base,
  //      DataToHashLen=image_size, &_efi_tcg2_event). Return status.
  //
  // The event-buffer population goes through a base register (lea) + SIB
  // stores to work around the encoder's RIP-relative narrow-store gap
  // (see uefi_gop.pdx §"Encoder discipline note").

  pub let efi_tcg2_measure_kernel : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_base: u64, image_size: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M3-004 (#795). Optional measured-boot integration. Populates a minimal EFI_TCG2_EVENT (Size=21, HeaderSize=16, HeaderVersion=1, PCRIndex=4 EV_EFI_BOOT_SERVICES_APPLICATION, EventType=0x80000009, Event[0]=0) in the module-owned _efi_tcg2_event buffer, then LocateProtocol EFI_TCG2_PROTOCOL_GUID; on EFI_NOT_FOUND (TPM absent) returns 0 silently — measured boot is an OPTIONAL R19.M3 discipline. On success, latches the TCG2 protocol pointer into _efi_tcg2_this and dispatches HashLogExtendEvent(this, Flags=0, image_base, image_size, &_efi_tcg2_event) via `FF /2 [rax + 16]` per the EFI TCG2 Protocol spec §6.2 MS x64 ABI. 5-argument MS x64 dispatch: opens a 56-byte stack frame (32-byte shadow + 8-byte arg5 slot + 16-byte alignment pad — RSP transitions 8->0 mod 16 as MS x64 §II-2.3.4 requires pre-CALL) and returns whatever status HashLogExtendEvent produced. Non-volatiles untouched; only volatile GPRs touched so @no_frame is sound. Event-buffer stores go through SIB-form addressing (lea then mov [reg+off], edx) to work around the paideia-as v0.20.1 PE encoder's RIP-relative narrow-store gap (mirrors uefi_gop.pdx §'Encoder discipline note').",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        lea rcx, [rip + _efi_tcg2_event];
        mov rax, 21;
        mov [rcx + 0], eax;
        mov rax, 16;
        mov [rcx + 4], eax;
        mov rax, 1;
        mov [rcx + 8], eax;
        mov rax, 4;
        mov [rcx + 12], eax;
        mov rax, 0x80000009;
        mov [rcx + 16], eax;
        mov rax, 0;
        mov [rcx + 20], al;
        lea rdi, [rip + _efi_tcg2_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdx, 0x800000000000000E;
        cmp rax, rdx;
        jne efi_tcg2_measure_kernel_ck;
        mov rax, 0;
        ret;
      efi_tcg2_measure_kernel_ck:
        cmp rax, 0;
        je efi_tcg2_measure_kernel_have;
        ret;
      efi_tcg2_measure_kernel_have:
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_tcg2_this], rax;
        sub rsp, 56;
        lea rdx, [rip + _efi_tcg2_event];
        mov [rsp + 32], rdx;
        mov rcx, rax;
        mov rdx, 0;
        mov r8, r10;
        mov r9, r11;
        call [rcx + 16];
        add rsp, 56;
        ret
      }
    } @no_frame
}
