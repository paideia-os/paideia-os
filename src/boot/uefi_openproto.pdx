// src/boot/uefi_openproto.pdx — R19-M2-004 (#790)
//
// Typed wrappers over EFI_BOOT_SERVICES.OpenProtocol / CloseProtocol
// (UEFI 2.10 §7.3.9 / §7.3.10). Together with the LocateProtocol wrapper
// in uefi_locate.pdx (#788), these two wrappers form the complete
// per-handle protocol-acquisition surface consumed by the R19.M2
// GOP (#792) and TCG2 (#795) discovery paths: LocateHandleBuffer +
// LocateProtocol return a candidate handle, OpenProtocol takes an
// ownership reference on it under the loaded-image agent, the caller
// uses the interface, and CloseProtocol releases the reference before
// ExitBootServices (UEFI 2.10 §7.3.9 "Unless prior to ExitBootServices,
// every OpenProtocol must be paired with a CloseProtocol"). Firmware
// bookkeeping — the Protocols Per Handle registry — leaks and refuses
// subsequent BY_DRIVER opens if this pairing is skipped, so the wrapper
// pair is landed together.
//
// Called from the paideia-os side using the paideia default (SysV)
// argument convention; internally marshal to the Microsoft x64 calling
// convention firmware expects (UEFI 2.10 §II-2.3.4) and dispatch via
// indirect call through the Boot Services vtable slot (`FF /2` mem-form
// encoding, pattern established in #787/uefi_alloc.pdx and #788/uefi_locate.pdx
// and #789/uefi_memmap.pdx, verified in
// paideia-as/crates/paideia-as-encoder/src/encode_instruction.rs::encode_call).
//
// -----------------------------------------------------------------------------
// Milestone scope (R19.M2, per design/round-retrospectives/r19-preflight.md)
// -----------------------------------------------------------------------------
//
// #790 (M2-004) delivers:
//   - `efi_open_protocol(handle, protocol_guid_ptr, agent_handle,
//                        controller_handle, attributes) -> status`
//     — 6-argument dispatch into BS->OpenProtocol. The out-Interface
//     pointer is latched into `_efi_last_opened_interface` (single global
//     slot — OpenProtocol calls are strictly serialised pre-EBS in the
//     R19.M2 discovery flow; same argument as #787/#788 for their
//     out-slot latches).
//   - `efi_close_protocol(handle, protocol_guid_ptr, agent_handle,
//                         controller_handle) -> status`
//     — 4-argument dispatch into BS->CloseProtocol; no out-parameters.
//   - `_efi_last_opened_interface` .data slot for the OpenProtocol
//     out-Interface pointer.
//
// The 6-argument OpenProtocol call is the first wrapper in the R19.M2
// series to spill *two* arguments to the caller-owned stack area above
// the 32-byte MS x64 shadow region. #789/uefi_memmap.pdx demonstrated
// the 1-spill pattern; this file extends it to the 2-spill layout. See
// the "Cross-ABI marshalling — 6 args" note below for the exact frame
// map and dependency-safe reshuffle order.
//
// -----------------------------------------------------------------------------
// EFI_BOOT_SERVICES.OpenProtocol / CloseProtocol vtable slots
// -----------------------------------------------------------------------------
//
// UEFI 2.10 §4.4.1 fixes the EFI_BOOT_SERVICES layout: 24-byte
// EFI_TABLE_HEADER followed by function pointers at monotonic +8
// offsets. The Open/Close Protocol pair sits in the Driver Support
// block just after ConnectController / DisconnectController:
//
//   +0    Hdr (EFI_TABLE_HEADER, 24 B)
//   ...
//   +264  ConnectController            (Driver Support)
//   +272  DisconnectController
//   +280  OpenProtocol                 ← THIS wrapper (0x118)
//   +288  CloseProtocol                ← THIS wrapper (0x120)
//   +296  OpenProtocolInformation
//   ...
//   +320  LocateProtocol               ← #788
//
// The 0x118 = 280 and 0x120 = 288 constants are cross-checked against
// edk2-stable202408 MdePkg/Include/Uefi/UefiSpec.h (EFI_BOOT_SERVICES
// struct field ordering) and against the offset table maintained in
// src/boot/uefi_types.pdx.
//
// -----------------------------------------------------------------------------
// Cross-ABI (paideia default / SysV → MS x64) marshalling — 6 args (OpenProtocol)
// -----------------------------------------------------------------------------
//
// paideia-as-ir::abi::ARG_REGS      = [RDI, RSI, RDX, RCX, R8, R9]  (SysV)
// paideia-as-ir::abi::MS_ARG_REGS   = [RCX, RDX, R8,  R9]           (MS x64 in-regs)
// MS x64 args 5.. spill to caller-owned stack slots at [RSP+0x20],
// [RSP+0x28], ... reserved AFTER the 32-byte shadow area (UEFI 2.10 §II-2.3.4).
//
// Alignment: SysV callers CALL leaves RSP ≡ 8 mod 16 at wrapper entry.
// MS x64 requires RSP ≡ 0 mod 16 immediately before CALL (the CALL
// itself pushes 8 bytes so the firmware callee sees RSP ≡ 8 mod 16 on
// entry). We need:
//   - 32 B shadow (mandatory)
//   - 16 B for 2 stack args (args 5 & 6)
// A naive `sub rsp, 0x30` (48 B) yields RSP ≡ (8-48) mod 16 = 8 mod 16 —
// still misaligned. `sub rsp, 0x38` (56 B) yields (8-56) mod 16 = 0 mod 16 ✓.
// The extra 8 B is an alignment pad above the arg slots.
//
// Layout after `sub rsp, 0x38`:
//
//   [rsp + 0x00 .. rsp + 0x1F]   32-byte MS-x64 shadow (RCX/RDX/R8/R9 spill)
//   [rsp + 0x20 .. rsp + 0x27]   arg 5 (ControllerHandle) slot
//   [rsp + 0x28 .. rsp + 0x2F]   arg 6 (Attributes) slot
//   [rsp + 0x30 .. rsp + 0x37]   alignment pad (8 B, unused by callee)
//   [rsp + 0x38 ..]              return-address slot (populated by CALL)
//
// `add rsp, 0x38` symmetrically restores the SysV entry value on return.
//
// Dependency-safe register reshuffle (SysV inputs → MS outputs):
//
//   SysV                        MS
//   ────                        ──
//   rdi = handle           →    rcx           (arg 1)
//   rsi = protocol_guid    →    rdx           (arg 2)
//   rdx = agent_handle     →    r8            (arg 3)      — SysV rdx is read
//   rcx = controller       →    r9            (arg 4)      — SysV rcx is read
//   r8  = attributes       →    [rsp+0x20]    (arg 5)      — SysV r8  is read
//   r9  = <unused input>        [rsp+0x28]    (arg 6)      — SysV r9  is read
//
// Wait — the *paideia-side* argument order for `efi_open_protocol` is
// deliberately chosen to make this reshuffle collision-free. The
// caller-visible signature is:
//
//   efi_open_protocol(handle, protocol_guid_ptr, agent_handle,
//                     controller_handle, attributes) -> status
//
// which maps SysV rdi/rsi/rdx/rcx/r8 to the five paideia arguments; the
// **Interface out-param is implicit (the `_efi_last_opened_interface`
// .data latch, MS r8 in the firmware ABI). The wrapper synthesises MS
// arg 3 (**Interface) from `lea r8, [rip + _efi_last_opened_interface]`
// AFTER using SysV rdx (agent_handle) — the SysV rdx source is consumed
// into a stack slot, not into MS r8. This eliminates one hazard.
//
// Correct dependency-safe reshuffle (matches emitted body below):
//
//   SysV                                  MS
//   ────                                  ──
//   rdi = handle                     →    rcx              (arg 1)
//   rsi = protocol_guid              →    rdx              (arg 2)
//   (implicit .data latch)           →    r8               (arg 3, **Interface)
//   rdx = agent_handle               →    r9               (arg 4)  — SysV rdx read
//   rcx = controller_handle          →    [rsp+0x20]       (arg 5)  — SysV rcx read
//   r8  = attributes                 →    [rsp+0x28]       (arg 6)  — SysV r8  read
//
// Emitted order (each source consumed before its destination is written):
//   1. sub rsp, 0x38                                  ; open frame
//   2. mov [rsp+0x28], r8                             ; SysV r8 → arg 6 slot
//   3. mov [rsp+0x20], rcx                            ; SysV rcx → arg 5 slot
//   4. mov r9, rdx                                    ; SysV rdx → MS r9  (arg 4)
//   5. mov rdx, rsi                                   ; SysV rsi → MS rdx (arg 2)
//   6. mov rcx, rdi                                   ; SysV rdi → MS rcx (arg 1)
//   7. lea r8, [rip + _efi_last_opened_interface]     ; MS r8 = &out_iface (arg 3)
//   8. mov rax, [rip + _efi_system_table]             ; SystemTable*
//   9. mov rax, [rax + 96]                            ; BootServices*
//  10. call [rax + 280]                               ; EFI_BS_OFFSET_OPEN_PROTOCOL
//  11. add rsp, 0x38                                  ; unwind
//  12. ret
//
// Note that the stack-slot stores must follow `sub rsp, 0x38` — the
// [rsp+0x20] / [rsp+0x28] addresses are only meaningful after the frame
// is opened. Placing the sub as the first executable operation also
// ensures that if a fault ever occurred on the [rip + _efi_system_table]
// load, the RSP state matches the documented frame layout for any
// future stack-unwinder / diagnostics consumer.
//
// -----------------------------------------------------------------------------
// Cross-ABI marshalling — 4 args (CloseProtocol)
// -----------------------------------------------------------------------------
//
// CloseProtocol takes exactly the four register-slot MS x64 args, no
// stack spills. 32-byte shadow + 8-byte alignment fix = `sub rsp, 40`
// (RSP transitions 8→0 mod 16). Reshuffle in reverse-arg order so each
// SysV source is consumed before its destination is written:
//
//   SysV                        MS
//   ────                        ──
//   rdi = handle           →    rcx           (arg 1)
//   rsi = protocol_guid    →    rdx           (arg 2)
//   rdx = agent_handle     →    r8            (arg 3)   — SysV rdx read
//   rcx = controller       →    r9            (arg 4)   — SysV rcx read
//
// Emitted order:
//   1. mov rax, [rip + _efi_system_table]     ; SystemTable*
//   2. mov rax, [rax + 96]                    ; BootServices*
//   3. mov r9,  rcx                           ; SysV rcx → MS r9
//   4. mov r8,  rdx                           ; SysV rdx → MS r8
//   5. mov rdx, rsi                           ; SysV rsi → MS rdx
//   6. mov rcx, rdi                           ; SysV rdi → MS rcx
//   7. sub rsp, 40                            ; 32B shadow + 8B align
//   8. call [rax + 288]                       ; EFI_BS_OFFSET_CLOSE_PROTOCOL
//   9. add rsp, 40                            ; unwind
//  10. ret
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// SysV non-volatiles (RBX, RBP, R12-R15, RSP): neither wrapper touches
// any of these — only RAX, RCX, RDX, R8, R9, R10, R11 are clobbered,
// all volatile in both SysV and MS x64. Therefore @no_frame is sound
// (no prologue push/pop needed) and the wrappers are safe to call from
// any SysV-convention paideia-os caller without further save discipline.
//
// -----------------------------------------------------------------------------
// OpenProtocol attributes reference (UEFI 2.10 §7.3.9)
// -----------------------------------------------------------------------------
//
// The `attributes` argument is a 32-bit bitmask (widened to u64 at the
// paideia-side boundary for MS x64 register-fit) selected from:
//
//   BY_HANDLE_PROTOCOL            = 0x00000001
//   GET_PROTOCOL                  = 0x00000002    ← informational read
//   TEST_PROTOCOL                 = 0x00000004
//   BY_CHILD_CONTROLLER           = 0x00000008
//   BY_DRIVER                     = 0x00000010    ← managed ownership
//   EXCLUSIVE                     = 0x00000020
//   BY_DRIVER | EXCLUSIVE         = 0x00000030    ← common driver mode
//
// The R19.M2 GOP (#792) and TCG2 (#795) discovery paths use
// GET_PROTOCOL (0x02) since they only need to *read* the interface
// pre-ExitBootServices; the OpenProtocol/CloseProtocol pair is required
// for spec-compliance (protocol registry bookkeeping) even in that
// read-only mode. The controller_handle is NULL / 0 for direct
// LoadedImage-agent consumers with no intermediate controller.
//
// -----------------------------------------------------------------------------
// Provisional `_efi_system_table` shadow
// -----------------------------------------------------------------------------
//
// paideia-as v0.21 `build --target uefi-x86_64` compiles one .pdx
// translation unit at a time (tools/build-uefi-stub.sh preamble).
// Following the discipline in uefi_alloc.pdx / uefi_locate.pdx /
// uefi_memmap.pdx we redeclare `_efi_system_table` locally so this file
// remains a well-formed standalone .pdx module. When R19.M2 grows the
// stub into a multi-file build (paideia-as enhancement
// `pa-r19-multi-file-link`, tracked in the R19 preflight retrospective),
// the duplicate resolves to the single .data global defined in
// `uefi_stub.pdx` under a no-op rename.

module UefiOpenproto = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================
  //
  // `_efi_last_opened_interface` receives the out-Interface pointer that
  // EFI_BOOT_SERVICES.OpenProtocol writes at *R8 (MS x64 arg 3, **Interface)
  // per UEFI 2.10 §7.3.9. Consumers read this slot immediately after
  // `efi_open_protocol` returns EFI_SUCCESS. A single global slot is
  // sufficient for R19.M2's serialised pre-ExitBootServices discovery
  // flow (GOP → ACPI walk → TCG2, no interleaved OpenProtocol callers).
  // If M4+ needs concurrent protocol acquisition, this becomes a
  // caller-supplied out-pointer argument
  // (`efi_open_protocol(..., iface_out: u64*) -> status`) — mechanical
  // signature widening, no re-encoding of the MS x64 marshalling.

  pub let mut _efi_last_opened_interface : u64 = 0

  // Standalone-compile shadow of the entry-point latch (see file preamble).
  // Overridden by the definition in uefi_stub.pdx when the M2 multi-file
  // build lands.
  pub let mut _efi_system_table : u64 = 0

  // ==========================================================================
  // efi_open_protocol — wraps EFI_BOOT_SERVICES.OpenProtocol
  // ==========================================================================
  //
  // UEFI 2.10 §7.3.9:
  //   EFI_STATUS OpenProtocol (
  //     IN  EFI_HANDLE   Handle,             // arg1
  //     IN  EFI_GUID    *Protocol,           // arg2
  //     OUT VOID       **Interface OPTIONAL, // arg3 (out — .data latch)
  //     IN  EFI_HANDLE   AgentHandle,        // arg4
  //     IN  EFI_HANDLE   ControllerHandle,   // arg5 (stack)
  //     IN  UINT32       Attributes          // arg6 (stack)
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI/RDX/RCX/R8; status → RAX.
  //   rdi = Handle, rsi = Protocol, rdx = AgentHandle,
  //   rcx = ControllerHandle, r8 = Attributes
  // MS x64 target: RCX/RDX/R8/R9 + [RSP+0x20] + [RSP+0x28]; status → RAX.
  //   rcx = Handle, rdx = Protocol, r8 = **Interface (.data latch),
  //   r9 = AgentHandle, [rsp+0x20] = ControllerHandle, [rsp+0x28] = Attributes
  // Out-Interface latched into `_efi_last_opened_interface` via MS r8.

  pub let efi_open_protocol : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64, attributes: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-004 (#790). Typed wrapper for EFI_BOOT_SERVICES.OpenProtocol (UEFI 2.10 §7.3.9). 6-argument MS x64 dispatch: opens a 56-byte stack frame (32-byte shadow + 8-byte slot for arg 5 ControllerHandle at [rsp+0x20] + 8-byte slot for arg 6 Attributes at [rsp+0x28] + 8-byte alignment pad); RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL. Marshals paideia-default (SysV) args RDI/RSI/RDX/RCX/R8 (Handle/Protocol/AgentHandle/ControllerHandle/Attributes) into MS x64 targets RCX/RDX/R9/[rsp+0x20]/[rsp+0x28] in dependency-safe order — SysV r8 (Attributes) stored to [rsp+0x28] first, SysV rcx (ControllerHandle) stored to [rsp+0x20] second, then register moves consume sources before destinations are overwritten (r9<-rdx, rdx<-rsi, rcx<-rdi). Synthesises MS arg 3 (**Interface) via `lea r8, [rip + _efi_last_opened_interface]` pointing at the .data out-slot; SysV r8 (Attributes) is separately stored to the arg-6 stack slot so there is no r8 source/destination collision. Loads BootServices* from _efi_system_table (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES) and issues indirect call via `FF /2 [rax + EFI_BS_OFFSET_OPEN_PROTOCOL=280]` into the vtable slot; symmetric `add rsp, 0x38` unwind on return. Returns EFI_STATUS in RAX per firmware ABI; on EFI_SUCCESS the acquired interface pointer lives in _efi_last_opened_interface, and the caller MUST pair the call with efi_close_protocol before ExitBootServices (spec-mandated protocol-registry bookkeeping, UEFI 2.10 §7.3.9). Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs clobbered so @no_frame is sound. Indirect-call-via-memory encoding (`FF /2` mem-form) verified in paideia-as encoder tests under #787.",
      block: {
        sub rsp, 56;
        mov [rsp + 40], r8;
        mov [rsp + 32], rcx;
        mov r9, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        lea r8, [rip + _efi_last_opened_interface];
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        call [rax + 280];
        add rsp, 56;
        ret
      }
    } @no_frame

  // ==========================================================================
  // efi_close_protocol — wraps EFI_BOOT_SERVICES.CloseProtocol
  // ==========================================================================
  //
  // UEFI 2.10 §7.3.10:
  //   EFI_STATUS CloseProtocol (
  //     IN EFI_HANDLE   Handle,             // arg1
  //     IN EFI_GUID    *Protocol,           // arg2
  //     IN EFI_HANDLE   AgentHandle,        // arg3
  //     IN EFI_HANDLE   ControllerHandle    // arg4
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI/RDX/RCX; status → RAX.
  //   rdi = Handle, rsi = Protocol, rdx = AgentHandle, rcx = ControllerHandle
  // MS x64 target: RCX/RDX/R8/R9; status → RAX.
  //   rcx = Handle, rdx = Protocol, r8 = AgentHandle, r9 = ControllerHandle
  //
  // Emitted body (unsafe, @no_frame):
  //   mov  rax, [rip + _efi_system_table]     ; SystemTable*
  //   mov  rax, [rax + 96]                    ; BootServices*
  //   mov  r9,  rcx                           ; MS arg4 = ControllerHandle (SysV rcx)
  //   mov  r8,  rdx                           ; MS arg3 = AgentHandle      (SysV rdx)
  //   mov  rdx, rsi                           ; MS arg2 = Protocol
  //   mov  rcx, rdi                           ; MS arg1 = Handle
  //   sub  rsp, 40                            ; 32B shadow + 8B align (8→0 mod 16)
  //   call [rax + 288]                        ; EFI_BS_OFFSET_CLOSE_PROTOCOL
  //   add  rsp, 40                            ; unwind
  //   ret

  pub let efi_close_protocol : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-004 (#790). Typed wrapper for EFI_BOOT_SERVICES.CloseProtocol (UEFI 2.10 §7.3.10). 4-argument MS x64 dispatch — all args fit MS in-registers (no stack spill). Loads BootServices* from _efi_system_table (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES); marshals paideia-default (SysV) args RDI/RSI/RDX/RCX into MS x64 targets RCX/RDX/R8/R9 in reverse-arg (dependency-safe) order — r9<-rcx, r8<-rdx, rdx<-rsi, rcx<-rdi — so each SysV source is consumed before its destination is written. Reserves 32-byte shadow space plus 8-byte alignment fix (RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL); makes indirect call via `FF /2 [rax + EFI_BS_OFFSET_CLOSE_PROTOCOL=288]` into the vtable slot; symmetric `add rsp, 40` unwind. Returns EFI_STATUS in RAX per firmware ABI. This wrapper is the mandatory pair for efi_open_protocol — every OpenProtocol taken pre-ExitBootServices MUST be closed pre-EBS (UEFI 2.10 §7.3.9/§7.3.10 protocol-registry bookkeeping). Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs clobbered so @no_frame is sound. Indirect-call-via-memory encoding (`FF /2` mem-form) verified in paideia-as encoder tests under #787.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        sub rsp, 40;
        call [rax + 288];
        add rsp, 40;
        ret
      }
    } @no_frame
}
