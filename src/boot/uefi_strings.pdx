// src/boot/uefi_strings.pdx — R19-M1-003 (#785)
//
// UEFI CHAR16 string literal helpers for the paideia-native EFI stub.
// UEFI 2.10 §II-4 (Common UEFI Data Types) defines CHAR16 as a 2-byte
// unsigned integer in little-endian format, storing UCS-2 code points
// (BMP subset of Unicode). All UEFI protocol calls that take strings —
// most importantly EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL.OutputString
// (UEFI 2.10 §12.4.3) — require null-terminated CHAR16* buffers.
//
// paideia-as v0.21 supports [u16; N] arrays with numeric initializers;
// this file uses that primitive to hand-encode ASCII source strings as
// zero-padded UTF-16 LE. That is *safe* only because every character used
// here is 7-bit ASCII (U+0000..U+007F), which coincides with the low byte
// of its UTF-16 representation.
//
// -----------------------------------------------------------------------------
// Encoding note (ASCII → CHAR16)
// -----------------------------------------------------------------------------
//
// For any 7-bit ASCII byte c, the UTF-16 LE encoding is exactly (c as u16)
// stored little-endian — i.e., byte pattern [c, 0x00]. This holds for the
// entire ASCII range because BMP code points below U+0080 map 1:1 to their
// scalar value. paideia-as writes [u16; N] initializers in native x86_64
// little-endian order (verified against `objdump -s -j .rdata` on a scratch
// PE32+ probe during #785 landing: `[72]` → bytes `48 00`, `[0x1234]` →
// bytes `34 12`), so an array literal like `[112, 97, ...]` lands on disk as
// `70 00 61 00 ...`, satisfying the UEFI CHAR16* contract directly.
//
// Multi-byte code points (accented Latin, CJK, etc.) or supplementary
// characters (U+10000+, which require UTF-16 surrogate pairs) MUST NOT be
// encoded via this pattern — they need real UTF-16 encoding. All strings
// declared below are drawn from the ASCII repertoire and stay within it by
// convention; a future non-ASCII string added to this file must ship with
// an explicit UTF-16 encoder pass rather than the trivial `[c, 0x00]` map.
//
// -----------------------------------------------------------------------------
// Ergonomics follow-up (paideia-as v0.24 candidate)
// -----------------------------------------------------------------------------
//
// Long-term, paideia-as should gain a native `u"..."` (or `L"..."`) literal
// that emits a UTF-16 LE array in .rdata directly, matching C11's `u""`
// prefix (ISO/IEC 9899:2011 §6.4.5) and C++11's `u"..."` string literal
// syntax. That would replace every array below with a one-line source form
// and remove the manual byte-counting / decimal-code-point discipline.
//
// Tracked as a paideia-as v0.24 enhancement (`pa-r19-char16-literal`) in
// the R19 preflight retrospective. Not a blocker for R19.M1 — the encoder's
// existing [u16; N] primitive covers this milestone in full — and not
// filed as a hard cross-repo dependency because the workaround is
// mechanical. When the literal syntax lands, this file collapses to:
//
//   pub let _hello_char16 : [u16; _] = u"paideia boot: entry ok\r\n\0"
//
// and every entry in the "byte count / hand-encoded table" preamble below
// can be deleted.
//
// -----------------------------------------------------------------------------
// R19.M1 scope
// -----------------------------------------------------------------------------
//
// #785 (M1-003) delivers the encoding pattern + one worked example
// (_hello_char16) matching the string that #802 (OVMF fixture) prints
// via ConOut->OutputString. #802 consumes _hello_char16 by loading its
// address rip-relative into RDX and calling the OutputString slot at
// offset EFI_STO_OFFSET_OUTPUT_STRING (+8) of the CoOut* pointer at
// offset EFI_ST_OFFSET_CON_OUT (+64) of the SystemTable:
//
//   mov  rcx, [rip + _efi_system_table]         ; RCX = SystemTable*
//   mov  rcx, [rcx + 64]                        ; RCX = ConOut* (STO)
//   lea  rdx, [rip + _hello_char16]             ; RDX = CHAR16* (arg1)
//   mov  rax, [rcx + 8]                         ; RAX = OutputString fnptr
//   sub  rsp, 0x28                              ; 32B shadow + 8B align
//   call rax
//   add  rsp, 0x28
//
// Additional CHAR16 strings (per-protocol GUID display names, error banners,
// GOP mode dumps, ExitBootServices status messages) grow this file as later
// R19 milestones need them. Each addition follows the same pattern: a
// header table mapping index → ASCII → u16 code point, then the [u16; N]
// literal with N == char count + 1 (for the trailing NUL). The NUL is
// mandatory — OutputString and every other UEFI CHAR16* API walks until it
// sees U+0000 (UEFI 2.10 §II-4 "CHAR16" definition).
//
// -----------------------------------------------------------------------------
// Build discipline
// -----------------------------------------------------------------------------
//
// This file is NOT yet linked into build/uefi/uefi_stub.efi — tools/build-
// uefi-stub.sh compiles a single translation unit (uefi_stub.pdx) at R19.M1
// per its own preamble ("When R19.M2 grows the stub across multiple .pdx
// files, this loop will fan out over BOOT_SRC/*.pdx and link the resulting
// objects"). Same disposition as uefi_types.pdx. #802 (OVMF fixture) is
// the first consumer and will either (a) inline the string into
// uefi_stub.pdx directly, or (b) trigger the M2 multi-file build fan-out.
// Until then this file compiles standalone as a well-formed .pdx module
// (verified during #785 landing) and serves as the authoritative encoding
// reference for the R19.M2+ CHAR16 string set.

module UefiStrings = structure {

  // ==========================================================================
  // _hello_char16 — "paideia boot: entry ok\r\n\0" as CHAR16*
  // ==========================================================================
  //
  // Consumed by #802 (OVMF fingerprint) as the OutputString argument that
  // proves the entry-point path reached ConOut. The exact wording tracks
  // #785's acceptance criterion line-for-line.
  //
  //   idx | ASCII | dec | note
  //   --- | ----- | --- | ---------------------------------------------
  //     0 | 'p'   | 112 |
  //     1 | 'a'   |  97 |
  //     2 | 'i'   | 105 |
  //     3 | 'd'   | 100 |
  //     4 | 'e'   | 101 |
  //     5 | 'i'   | 105 |
  //     6 | 'a'   |  97 |
  //     7 | ' '   |  32 |
  //     8 | 'b'   |  98 |
  //     9 | 'o'   | 111 |
  //    10 | 'o'   | 111 |
  //    11 | 't'   | 116 |
  //    12 | ':'   |  58 |
  //    13 | ' '   |  32 |
  //    14 | 'e'   | 101 |
  //    15 | 'n'   | 110 |
  //    16 | 't'   | 116 |
  //    17 | 'r'   | 114 |
  //    18 | 'y'   | 121 |
  //    19 | ' '   |  32 |
  //    20 | 'o'   | 111 |
  //    21 | 'k'   | 107 |
  //    22 | '\r'  |  13 | CR, matches UEFI ConOut line-ending convention
  //    23 | '\n'  |  10 | LF
  //    24 | '\0'  |   0 | NUL terminator (mandatory — see file preamble)
  //
  // On-disk byte pattern in .rdata (verified via
  // `objdump -s -j .rdata /tmp/UefiStrings.efi` during #785 landing):
  //
  //   70 00 61 00 69 00 64 00 65 00 69 00 61 00 20 00
  //   62 00 6f 00 6f 00 74 00 3a 00 20 00 65 00 6e 00
  //   74 00 72 00 79 00 20 00 6f 00 6b 00 0d 00 0a 00
  //   00 00
  //
  // Total size: 25 × 2 = 50 bytes. Alignment: paideia-as defaults u16
  // arrays to natural (2-byte) alignment; OutputString does not require a
  // stronger alignment than the CHAR16 boundary (UEFI 2.10 §II-4 imposes
  // no alignment requirement on CHAR16*; the 2-byte natural boundary is
  // sufficient for the aligned-word loads any conformant firmware uses).
  pub let _hello_char16 : [u16; 25] = [
    112,  97, 105, 100, 101, 105,  97,  32,   //  "paideia "
     98, 111, 111, 116,  58,  32,               //  "boot: "
    101, 110, 116, 114, 121,  32,               //  "entry "
    111, 107,  13,  10,   0                     //  "ok\r\n\0"
  ]
}
