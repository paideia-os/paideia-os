// src/boot/uefi_types.pdx — R19-M1-001 (#783)
//
// UEFI type/offset constants consumed by the paideia-native EFI stub.
// PaideiaOS-native language does not yet carry aggregate struct/typedef
// syntax that maps to UEFI's opaque handles, so all UEFI structures are
// modeled at this preflight milestone as u64 register-carriers plus a
// disciplined offset table that names each field.
//
// Provenance: UEFI 2.10 §4.3 (EFI_SYSTEM_TABLE), §12.4 (SIMPLE_TEXT_OUTPUT)
// and §II-2.1.1 (PE32+ image loader). Layout is the on-wire ABI shape
// firmware exposes — offsets must not drift.
//
// R19.M1 scope (per design/round-retrospectives/r19-preflight.md):
//   - This file provides only what M1-001 (efi_main entry) requires:
//     the *handle* type width, EFI_STATUS success code, and the
//     ConOut offset the OutputString fingerprint (#802) will chase.
//   - M2 (BootServices wrappers) grows the BS/RT offset table.
//   - M3 (GOP + ACPI + TPM) grows the protocol-GUID table.

module UefiTypes = structure {

  // ==========================================================================
  // Widths (paideia-as u64 is the ABI-native pointer/handle carrier).
  // ==========================================================================
  //
  // EFI_HANDLE          = VOID*   (8B on x86_64)
  // EFI_STATUS          = UINTN   (8B on x86_64; high bit set => error)
  // EFI_SYSTEM_TABLE*   = VOID*   (8B)
  // All UEFI pointer/status types collapse to u64 at this layer.

  // ==========================================================================
  // EFI_STATUS canonical values (UEFI 2.10 Appendix D).
  // ==========================================================================
  //
  // EFI_SUCCESS = 0. Error codes set the high bit of UINTN:
  //   EFI_LOAD_ERROR       = 0x8000000000000001
  //   EFI_INVALID_PARAMETER= 0x8000000000000002
  //   EFI_UNSUPPORTED      = 0x8000000000000003
  // R19.M1 only needs SUCCESS; the error table grows with M2 wrappers.
  pub let EFI_SUCCESS : u64 = 0x0000000000000000

  // ==========================================================================
  // EFI_SYSTEM_TABLE field offsets (UEFI 2.10 §4.3.1, x86_64 layout).
  // ==========================================================================
  //
  // struct EFI_SYSTEM_TABLE {
  //   EFI_TABLE_HEADER  Hdr;                    // +0   (24 B)
  //   CHAR16*           FirmwareVendor;         // +24
  //   UINT32            FirmwareRevision;       // +32  (+4 pad to 8)
  //   EFI_HANDLE        ConsoleInHandle;        // +40
  //   EFI_SIMPLE_TEXT_INPUT_PROTOCOL* ConIn;    // +48
  //   EFI_HANDLE        ConsoleOutHandle;       // +56
  //   EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL* ConOut;  // +64
  //   EFI_HANDLE        StandardErrorHandle;    // +72
  //   EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL* StdErr;  // +80
  //   EFI_RUNTIME_SERVICES* RuntimeServices;    // +88
  //   EFI_BOOT_SERVICES*    BootServices;       // +96
  //   UINTN                 NumberOfTableEntries;// +104
  //   EFI_CONFIGURATION_TABLE* ConfigurationTable; // +112
  // };
  //
  // Verified against edk2 MdePkg/Include/Uefi/UefiSpec.h.
  pub let EFI_ST_OFFSET_CON_OUT           : u64 = 64   // ConOut* — #802 fingerprint
  pub let EFI_ST_OFFSET_STD_ERR           : u64 = 80
  pub let EFI_ST_OFFSET_RUNTIME_SERVICES  : u64 = 88
  pub let EFI_ST_OFFSET_BOOT_SERVICES     : u64 = 96
  pub let EFI_ST_OFFSET_CONFIG_TABLE_NR   : u64 = 104
  pub let EFI_ST_OFFSET_CONFIG_TABLE      : u64 = 112

  // ==========================================================================
  // EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL offsets (UEFI 2.10 §12.4).
  // ==========================================================================
  //
  // struct EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL {
  //   EFI_TEXT_RESET               Reset;         // +0
  //   EFI_TEXT_STRING              OutputString;  // +8  — #802 fingerprint
  //   EFI_TEXT_TEST_STRING         TestString;    // +16
  //   ...
  // };
  //
  // OutputString has signature:
  //   EFI_STATUS (EFIAPI*) (This*, CHAR16* String)
  // MS x64: RCX = This, RDX = String. Called via a `call [rax + 8]` after
  // loading the ConOut pointer at `[SystemTable + 64]`. Wired at #802.
  pub let EFI_STO_OFFSET_OUTPUT_STRING : u64 = 8
}
