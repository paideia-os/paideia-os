// src/boot/uefi_types.pdx — R19-M1-001 (#783) + R19-M1-002 (#784)
//
// UEFI type/offset constants consumed by the paideia-native EFI stub.
// PaideiaOS-native language does not yet carry aggregate struct/typedef
// syntax that maps to UEFI's opaque handles, so all UEFI structures are
// modeled at this preflight milestone as u64 register-carriers plus a
// disciplined offset table that names each field.
//
// Provenance: UEFI 2.10 §4.3 (EFI_SYSTEM_TABLE), §4.4 (EFI_BOOT_SERVICES),
// §4.5 (EFI_RUNTIME_SERVICES), §12.4 (SIMPLE_TEXT_OUTPUT), §II-2.1.1
// (PE32+ image loader). Layout is the on-wire ABI shape firmware exposes —
// offsets must not drift. Cross-checked against edk2
// MdePkg/Include/Uefi/UefiSpec.h at edk2-stable202408 (r19-preflight lock).
//
// R19.M1 scope (per design/round-retrospectives/r19-preflight.md):
//   - #783 (M1-001) landed: HANDLE/STATUS widths, EFI_SUCCESS, the
//     SYSTEM_TABLE offsets needed by the entry-point latch, and the
//     STO OutputString offset the #802 fingerprint chases.
//   - #784 (M1-002) extends this file with the full SYSTEM_TABLE field
//     table, the full BOOT_SERVICES vtable layout (spec transcription
//     in comments, `pub let` exports narrowed to the slots M2/M3 issues
//     #787-#796 will consume), and the RUNTIME_SERVICES vtable layout
//     (comments only; M2/M3 does not invoke runtime services).
//   - M2 (BootServices wrappers) will export additional BS slots as they
//     land — the comment table below is authoritative for their offsets.
//   - M3 (GOP + ACPI + TPM) grows the protocol-GUID table in its own
//     files (uefi_gop.pdx / uefi_acpi.pdx / uefi_measured.pdx).
//   - M4 (ExitBootServices) will export EFI_BS_OFFSET_EXIT_BOOT_SERVICES
//     from the comment table below and add SetVirtualAddressMap to the
//     RT export set.
//
// -----------------------------------------------------------------------------
// Compile-time size assertions (#784 AC)
// -----------------------------------------------------------------------------
//
// paideia-as v0.21 does not yet carry a `static_assert` / const-eval-comparison
// primitive, so size witnesses live as comments cross-referenced against edk2
// (see EFI_TABLE_HEADER = 24B, EFI_SYSTEM_TABLE = 120B, EFI_BOOT_SERVICES =
// 376B, EFI_RUNTIME_SERVICES = 136B, EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL = 80B).
// When the encoder gains a compile-time size operator (tracked as paideia-as
// enhancement `pa-r19-size-assert`), the SIZE anchor constants below become
// the LHS of `static_assert(sizeof(EFI_X) == EFI_X_SIZE_BYTES)`.

module UefiTypes = structure {

  // ==========================================================================
  // Widths (paideia-as u64 is the ABI-native pointer/handle carrier).
  // ==========================================================================
  //
  // EFI_HANDLE          = VOID*   (8B on x86_64)
  // EFI_STATUS          = UINTN   (8B on x86_64; high bit set => error)
  // EFI_SYSTEM_TABLE*   = VOID*   (8B)
  // All UEFI pointer/status types collapse to u64 at this layer.

  // ==========================================================================
  // EFI_STATUS canonical values (UEFI 2.10 Appendix D).
  // ==========================================================================
  //
  // EFI_SUCCESS = 0. Error codes set the high bit of UINTN:
  //   EFI_LOAD_ERROR       = 0x8000000000000001
  //   EFI_INVALID_PARAMETER= 0x8000000000000002
  //   EFI_UNSUPPORTED      = 0x8000000000000003
  //   EFI_BUFFER_TOO_SMALL = 0x8000000000000005
  //   EFI_NOT_FOUND        = 0x800000000000000E
  //   EFI_OUT_OF_RESOURCES = 0x8000000000000009
  //
  // #784 does not export the error codes — they live in `src/boot/uefi_status.pdx`
  // per #791 (M2-005 decode helper). BS wrappers test the high bit directly
  // (`status & 0x8000000000000000`) so they do not need per-code constants.
  pub let EFI_SUCCESS : u64 = 0x0000000000000000

  // ==========================================================================
  // EFI_TABLE_HEADER (UEFI 2.10 §4.2, prefix of ST/BS/RT).
  // ==========================================================================
  //
  // struct EFI_TABLE_HEADER {
  //   UINT64  Signature;   // +0   (per-table magic — ST=0x5453595320494249)
  //   UINT32  Revision;    // +8   (spec-level packed as (major<<16)|minor)
  //   UINT32  HeaderSize;  // +12  (size of the full table incl. this header)
  //   UINT32  CRC32;       // +16  (over HeaderSize bytes with CRC32 field=0)
  //   UINT32  Reserved;    // +20
  // };  // sizeof = 24
  //
  // #784 documents these offsets for provenance; header-integrity validation
  // (signature match + CRC32 verify) is not consumed by M2/M3, so no `pub let`
  // exports at this milestone. R19.M2-hardening (post-first-light) will lift
  // these into the exported table if the hwman OEM firmware audit requires
  // CRC32 gating before any BS callsite.
  //
  // Anchor for the future static_assert:
  pub let EFI_TABLE_HEADER_SIZE_BYTES : u64 = 24

  // ==========================================================================
  // EFI_SYSTEM_TABLE field offsets (UEFI 2.10 §4.3.1, x86_64 layout).
  // ==========================================================================
  //
  // struct EFI_SYSTEM_TABLE {
  //   EFI_TABLE_HEADER  Hdr;                             // +0    (24 B)
  //   CHAR16*           FirmwareVendor;                  // +24
  //   UINT32            FirmwareRevision;                // +32   (+4 tail pad)
  //   EFI_HANDLE        ConsoleInHandle;                 // +40
  //   EFI_SIMPLE_TEXT_INPUT_PROTOCOL*  ConIn;            // +48
  //   EFI_HANDLE        ConsoleOutHandle;                // +56
  //   EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL* ConOut;           // +64
  //   EFI_HANDLE        StandardErrorHandle;             // +72
  //   EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL* StdErr;           // +80
  //   EFI_RUNTIME_SERVICES*     RuntimeServices;         // +88
  //   EFI_BOOT_SERVICES*        BootServices;            // +96
  //   UINTN                     NumberOfTableEntries;    // +104
  //   EFI_CONFIGURATION_TABLE*  ConfigurationTable;      // +112
  // };  // sizeof = 120
  //
  // Verified against edk2 MdePkg/Include/Uefi/UefiSpec.h. The 4-byte pad
  // between FirmwareRevision (UINT32 @ +32) and ConsoleInHandle (VOID* @ +40)
  // is the standard natural-alignment fill for u64 following u32 on x86_64.
  pub let EFI_ST_OFFSET_HDR               : u64 = 0
  pub let EFI_ST_OFFSET_FIRMWARE_VENDOR   : u64 = 24
  pub let EFI_ST_OFFSET_FIRMWARE_REVISION : u64 = 32
  pub let EFI_ST_OFFSET_CONSOLE_IN_HANDLE : u64 = 40
  pub let EFI_ST_OFFSET_CON_IN            : u64 = 48
  pub let EFI_ST_OFFSET_CONSOLE_OUT_HANDLE: u64 = 56
  pub let EFI_ST_OFFSET_CON_OUT           : u64 = 64   // ConOut* — #802 fingerprint
  pub let EFI_ST_OFFSET_STANDARD_ERR_HDL  : u64 = 72
  pub let EFI_ST_OFFSET_STD_ERR           : u64 = 80
  pub let EFI_ST_OFFSET_RUNTIME_SERVICES  : u64 = 88
  pub let EFI_ST_OFFSET_BOOT_SERVICES     : u64 = 96
  pub let EFI_ST_OFFSET_CONFIG_TABLE_NR   : u64 = 104
  pub let EFI_ST_OFFSET_CONFIG_TABLE      : u64 = 112

  pub let EFI_SYSTEM_TABLE_SIZE_BYTES     : u64 = 120

  // ==========================================================================
  // EFI_BOOT_SERVICES vtable offsets (UEFI 2.10 §4.4.1, x86_64 layout).
  // ==========================================================================
  //
  // struct EFI_BOOT_SERVICES {
  //   EFI_TABLE_HEADER  Hdr;                                                    // +0    (24 B)
  //   // ---- Task Priority Services (§7.1) ----
  //   EFI_RAISE_TPL     RaiseTPL;                                               // +24
  //   EFI_RESTORE_TPL   RestoreTPL;                                             // +32
  //   // ---- Memory Services (§7.2) ----
  //   EFI_ALLOCATE_PAGES AllocatePages;                                         // +40   * M2 (#787)
  //   EFI_FREE_PAGES     FreePages;                                             // +48   * M2 (#787)
  //   EFI_GET_MEMORY_MAP GetMemoryMap;                                          // +56   * M2 (#789)
  //   EFI_ALLOCATE_POOL  AllocatePool;                                          // +64   * M2 (implicit — LocateProtocol buffers)
  //   EFI_FREE_POOL      FreePool;                                              // +72   * M2 (implicit — buffer teardown)
  //   // ---- Event & Timer Services (§7.1) ----
  //   EFI_CREATE_EVENT   CreateEvent;                                           // +80
  //   EFI_SET_TIMER      SetTimer;                                              // +88
  //   EFI_WAIT_FOR_EVENT WaitForEvent;                                          // +96
  //   EFI_SIGNAL_EVENT   SignalEvent;                                           // +104
  //   EFI_CLOSE_EVENT    CloseEvent;                                            // +112
  //   EFI_CHECK_EVENT    CheckEvent;                                            // +120
  //   // ---- Protocol Handler Services (§7.3) ----
  //   EFI_INSTALL_PROTOCOL_INTERFACE   InstallProtocolInterface;                // +128
  //   EFI_REINSTALL_PROTOCOL_INTERFACE ReinstallProtocolInterface;              // +136
  //   EFI_UNINSTALL_PROTOCOL_INTERFACE UninstallProtocolInterface;              // +144
  //   EFI_HANDLE_PROTOCOL              HandleProtocol;                          // +152
  //   VOID*                            Reserved;                                // +160
  //   EFI_REGISTER_PROTOCOL_NOTIFY     RegisterProtocolNotify;                  // +168
  //   EFI_LOCATE_HANDLE                LocateHandle;                            // +176
  //   EFI_LOCATE_DEVICE_PATH           LocateDevicePath;                        // +184
  //   EFI_INSTALL_CONFIGURATION_TABLE  InstallConfigurationTable;               // +192
  //   // ---- Image Services (§7.4) ----
  //   EFI_IMAGE_LOAD                   LoadImage;                               // +200
  //   EFI_IMAGE_START                  StartImage;                              // +208
  //   EFI_EXIT                         Exit;                                    // +216
  //   EFI_IMAGE_UNLOAD                 UnloadImage;                             // +224
  //   EFI_EXIT_BOOT_SERVICES           ExitBootServices;                        // +232  * M4 (deferred; #797+)
  //   // ---- Miscellaneous Services (§7.5) ----
  //   EFI_GET_NEXT_MONOTONIC_COUNT     GetNextMonotonicCount;                   // +240
  //   EFI_STALL                        Stall;                                   // +248
  //   EFI_SET_WATCHDOG_TIMER           SetWatchdogTimer;                        // +256
  //   // ---- DriverSupport Services (§7.4) ----
  //   EFI_CONNECT_CONTROLLER           ConnectController;                       // +264
  //   EFI_DISCONNECT_CONTROLLER        DisconnectController;                    // +272
  //   // ---- Open and Close Protocol Services (§7.3) ----
  //   EFI_OPEN_PROTOCOL                OpenProtocol;                            // +280  * M2/M3 (#790, #796)
  //   EFI_CLOSE_PROTOCOL               CloseProtocol;                           // +288  * M2 (#790)
  //   EFI_OPEN_PROTOCOL_INFORMATION    OpenProtocolInformation;                 // +296
  //   // ---- Library Services (§7.3) ----
  //   EFI_PROTOCOLS_PER_HANDLE         ProtocolsPerHandle;                      // +304
  //   EFI_LOCATE_HANDLE_BUFFER         LocateHandleBuffer;                      // +312
  //   EFI_LOCATE_PROTOCOL              LocateProtocol;                          // +320  * M2 (#788)
  //   EFI_INSTALL_MULTIPLE_PROTOCOL_INTERFACES   InstallMultipleProtocolInterfaces;    // +328
  //   EFI_UNINSTALL_MULTIPLE_PROTOCOL_INTERFACES UninstallMultipleProtocolInterfaces;  // +336
  //   // ---- 32-bit CRC Services (§7.5) ----
  //   EFI_CALCULATE_CRC32              CalculateCrc32;                          // +344
  //   // ---- Miscellaneous Services, cont. (§7.5) ----
  //   EFI_COPY_MEM                     CopyMem;                                 // +352
  //   EFI_SET_MEM                      SetMem;                                  // +360
  //   EFI_CREATE_EVENT_EX              CreateEventEx;                           // +368
  // };  // sizeof = 376
  //
  // Legend: `* M2 (#N)` means the slot is exported below because paideia-os
  // issue #N consumes it. Un-annotated slots stay comment-only until the
  // milestone that consumes them lifts them into the export table — this
  // narrows the API surface without losing spec provenance.
  //
  // Invocation shape (MS x64 ABI, UEFI 2.10 §II-2.3.4):
  //   mov rax, [rip + _efi_system_table]     ; RAX = SystemTable*
  //   mov rax, [rax + EFI_ST_OFFSET_BOOT_SERVICES]  ; RAX = BootServices*
  //   ; set RCX/RDX/R8/R9 = args per Boot Services fn signature
  //   sub rsp, 0x28                          ; 32B shadow + 8B align to 16
  //   call [rax + EFI_BS_OFFSET_ALLOCATE_PAGES]
  //   add rsp, 0x28

  pub let EFI_BS_OFFSET_ALLOCATE_PAGES     : u64 = 40    // #787
  pub let EFI_BS_OFFSET_FREE_PAGES         : u64 = 48    // #787
  pub let EFI_BS_OFFSET_GET_MEMORY_MAP     : u64 = 56    // #789
  pub let EFI_BS_OFFSET_ALLOCATE_POOL      : u64 = 64    // M2 buffers
  pub let EFI_BS_OFFSET_FREE_POOL          : u64 = 72    // M2 buffers
  pub let EFI_BS_OFFSET_OPEN_PROTOCOL      : u64 = 280   // #790, #796
  pub let EFI_BS_OFFSET_CLOSE_PROTOCOL     : u64 = 288   // #790
  pub let EFI_BS_OFFSET_LOCATE_PROTOCOL    : u64 = 320   // #788

  pub let EFI_BOOT_SERVICES_SIZE_BYTES     : u64 = 376

  // ==========================================================================
  // EFI_RUNTIME_SERVICES vtable offsets (UEFI 2.10 §4.5.1, x86_64 layout).
  // ==========================================================================
  //
  // struct EFI_RUNTIME_SERVICES {
  //   EFI_TABLE_HEADER  Hdr;                                          // +0    (24 B)
  //   // ---- Time Services (§8.3) ----
  //   EFI_GET_TIME                    GetTime;                        // +24
  //   EFI_SET_TIME                    SetTime;                        // +32
  //   EFI_GET_WAKEUP_TIME             GetWakeupTime;                  // +40
  //   EFI_SET_WAKEUP_TIME             SetWakeupTime;                  // +48
  //   // ---- Virtual Memory Services (§8.4) ----
  //   EFI_SET_VIRTUAL_ADDRESS_MAP     SetVirtualAddressMap;           // +56   (M4 candidate — deferred)
  //   EFI_CONVERT_POINTER             ConvertPointer;                 // +64
  //   // ---- Variable Services (§8.2) ----
  //   EFI_GET_VARIABLE                GetVariable;                    // +72
  //   EFI_GET_NEXT_VARIABLE_NAME      GetNextVariableName;            // +80
  //   EFI_SET_VARIABLE                SetVariable;                    // +88
  //   // ---- Miscellaneous Services (§8.5) ----
  //   EFI_GET_NEXT_HIGH_MONO_COUNT    GetNextHighMonotonicCount;      // +96
  //   EFI_RESET_SYSTEM                ResetSystem;                    // +104
  //   // ---- UEFI 2.0 Capsule Services (§8.5) ----
  //   EFI_UPDATE_CAPSULE              UpdateCapsule;                  // +112
  //   EFI_QUERY_CAPSULE_CAPABILITIES  QueryCapsuleCapabilities;       // +120
  //   // ---- Miscellaneous UEFI 2.0 Services (§8.5) ----
  //   EFI_QUERY_VARIABLE_INFO         QueryVariableInfo;              // +128
  // };  // sizeof = 136
  //
  // R19.M2/M3 does not invoke any runtime service — the pre-ExitBootServices
  // path talks to firmware exclusively through EFI_BOOT_SERVICES. Runtime
  // services matter after ExitBootServices returns (R19.M4 for
  // SetVirtualAddressMap; R25+ for GetTime/ResetSystem/GetVariable). No
  // `pub let` exports at this milestone: the comment table above is the
  // authoritative source for M4+ to promote slots from.
  //
  // NOTE: Once ExitBootServices completes, ONLY the RuntimeServices table
  // (accessible via SystemTable+88 or a snapshot latched pre-exit) remains
  // valid — BootServices pointers are firmware-invalidated.

  pub let EFI_RUNTIME_SERVICES_SIZE_BYTES  : u64 = 136

  // ==========================================================================
  // EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL offsets (UEFI 2.10 §12.4).
  // ==========================================================================
  //
  // struct EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL {
  //   EFI_TEXT_RESET               Reset;              // +0
  //   EFI_TEXT_STRING              OutputString;       // +8   — #802 fingerprint
  //   EFI_TEXT_TEST_STRING         TestString;         // +16
  //   EFI_TEXT_QUERY_MODE          QueryMode;          // +24
  //   EFI_TEXT_SET_MODE            SetMode;            // +32
  //   EFI_TEXT_SET_ATTRIBUTE       SetAttribute;       // +40
  //   EFI_TEXT_CLEAR_SCREEN        ClearScreen;        // +48
  //   EFI_TEXT_SET_CURSOR_POSITION SetCursorPosition;  // +56
  //   EFI_TEXT_ENABLE_CURSOR       EnableCursor;       // +64
  //   SIMPLE_TEXT_OUTPUT_MODE*     Mode;               // +72
  // };  // sizeof = 80
  //
  // OutputString has signature:
  //   EFI_STATUS (EFIAPI*) (This*, CHAR16* String)
  // MS x64: RCX = This, RDX = String. Called via a `call [rax + 8]` after
  // loading the ConOut pointer at `[SystemTable + EFI_ST_OFFSET_CON_OUT]`.
  // Wired at #802. Additional STO slots (SetAttribute for coloured error
  // output, ClearScreen for pre-handoff screen wipe) remain comment-only
  // until a milestone consumes them.
  pub let EFI_STO_OFFSET_OUTPUT_STRING : u64 = 8

  pub let EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL_SIZE_BYTES : u64 = 80
}
