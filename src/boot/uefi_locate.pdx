// src/boot/uefi_locate.pdx — R19-M2-002 (#788)
//
// Typed wrapper over EFI_BOOT_SERVICES.LocateProtocol (UEFI 2.10 §7.3.11).
// Called from paideia-os side using the paideia default (SysV) argument
// convention; internally marshals to the Microsoft x64 calling convention
// firmware expects (UEFI 2.10 §II-2.3.4) and dispatches via indirect call
// through the Boot Services vtable slot (`FF /2` mem-form encoding,
// pattern established in #787/uefi_alloc.pdx and verified in
// paideia-as/crates/paideia-as-encoder/src/encode_instruction.rs::encode_call).
//
// -----------------------------------------------------------------------------
// Milestone scope (R19.M2, per design/round-retrospectives/r19-preflight.md)
// -----------------------------------------------------------------------------
//
// #788 (M2-002) delivers:
//   - `efi_locate_protocol(guid_ptr, registration) -> status`
//     with the out-interface pointer latched into `_efi_last_located_interface`
//     (single global slot — LocateProtocol calls are strictly serialised
//     pre-EBS in the R19.M2 discovery flow, same argument as #787's
//     `_efi_last_allocated_addr`).
//   - `_efi_last_located_interface` .data slot for the out-param.
//
// ACPI 2.0 RSDP discovery is intentionally NOT a LocateProtocol call — the
// ACPI table anchor lives in EFI_SYSTEM_TABLE.ConfigurationTable[] (UEFI 2.10
// §4.6) and is resolved by a linear walk in #794. The `_efi_acpi_20_table_guid`
// constant is consumed there, not here.
//
// The optional GOP/TCG2 convenience wrappers the #788 acceptance criteria
// list as "may" surface are deferred to the sibling issue that lands multi-
// file link support in paideia-as (`pa-r19-multi-file-link`, tracked in the
// R19 preflight retrospective). Rationale: those wrappers would need an
// intra-module direct `call efi_locate_protocol` which the paideia-as v0.21
// PE emitter currently encodes as `E8 00 00 00 00` (rel32=0 → call the very
// next instruction) — direct-call relocations are not yet resolved for
// `--target uefi-x86_64`. Rather than ship a wrapper that quietly branches
// to itself, callsites (#792 GOP mode, #795 TCG2 log) invoke
// `efi_locate_protocol` directly with the GUID address inlined; the
// convenience layer lands with multi-file link when the relocation gap
// closes. The primary `efi_locate_protocol` wrapper uses only indirect
// call-via-memory (`FF /2 [rax+320]`), which the encoder already handles
// (verified by disassembly, see #787).
//
// -----------------------------------------------------------------------------
// EFI_BOOT_SERVICES.LocateProtocol vtable slot
// -----------------------------------------------------------------------------
//
// UEFI 2.10 §4.4.1 fixes the EFI_BOOT_SERVICES layout: 24-byte EFI_TABLE_HEADER
// followed by function pointers at monotonic +8 offsets. Counting through the
// spec order:
//
//   +0    Hdr (EFI_TABLE_HEADER, 24 B)
//   +24   RaiseTPL                     (Task Priority)
//   +32   RestoreTPL
//   +40   AllocatePages                (Memory)              ← #787
//   +48   FreePages                                          ← #787
//   +56   GetMemoryMap
//   +64   AllocatePool
//   +72   FreePool
//   +80   CreateEvent                  (Event & Timer)
//   +88   SetTimer
//   +96   WaitForEvent
//   +104  SignalEvent
//   +112  CloseEvent
//   +120  CheckEvent
//   +128  InstallProtocolInterface     (Protocol Handler)
//   +136  ReinstallProtocolInterface
//   +144  UninstallProtocolInterface
//   +152  HandleProtocol
//   +160  Reserved
//   +168  RegisterProtocolNotify
//   +176  LocateHandle
//   +184  LocateDevicePath
//   +192  InstallConfigurationTable
//   +200  LoadImage                    (Image Services)
//   +208  StartImage
//   +216  Exit
//   +224  UnloadImage
//   +232  ExitBootServices
//   +240  GetNextMonotonicCount        (Misc)
//   +248  Stall
//   +256  SetWatchdogTimer
//   +264  ConnectController            (Driver Support)
//   +272  DisconnectController
//   +280  OpenProtocol                 (Open/Close Protocol)
//   +288  CloseProtocol
//   +296  OpenProtocolInformation
//   +304  ProtocolsPerHandle           (Library Services)
//   +312  LocateHandleBuffer
//   +320  LocateProtocol               ← THIS wrapper (0x140)
//   +328  InstallMultipleProtocolInterfaces
//   +336  UninstallMultipleProtocolInterfaces
//   ...
//
// The 0x140 = 320 constant is cross-checked against edk2-stable202408
// MdePkg/Include/Uefi/UefiSpec.h (EFI_BOOT_SERVICES struct field ordering).
//
// -----------------------------------------------------------------------------
// Cross-ABI (paideia default / SysV → MS x64) marshalling
// -----------------------------------------------------------------------------
//
// Same discipline as #787: SysV args in RDI/RSI are copied into MS x64 slots
// RCX/RDX in a dependency-safe order. R8 is loaded via `lea` from the .data
// out-slot address. The wrapper reserves 32-byte shadow space + 8-byte
// alignment fixup (RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL),
// issues `FF /2 [rax + 320]`, and unwinds symmetrically. Non-volatiles
// (RBX/RBP/R12-R15) are untouched → @no_frame is sound.
//
// -----------------------------------------------------------------------------
// Provisional `_efi_system_table` shadow
// -----------------------------------------------------------------------------
//
// paideia-as v0.21 `build --target uefi-x86_64` compiles one .pdx translation
// unit at a time (tools/build-uefi-stub.sh preamble). Following the discipline
// in uefi_alloc.pdx we redeclare `_efi_system_table` locally so this file
// remains a well-formed standalone .pdx module. When R19.M2 grows the stub
// into a multi-file build (paideia-as enhancement `pa-r19-multi-file-link`,
// tracked in the R19 preflight retrospective), the duplicate resolves to the
// single .data global defined in `uefi_stub.pdx` under a no-op rename.

module UefiLocate = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================
  //
  // `_efi_last_located_interface` receives the out-interface pointer that
  // EFI_BOOT_SERVICES.LocateProtocol writes at *R8 per UEFI 2.10 §7.3.11.
  // Consumers read this slot immediately after `efi_locate_protocol` returns
  // EFI_SUCCESS. A single global slot is sufficient for R19.M2's serialised
  // pre-ExitBootServices discovery flow (GOP → ACPI walk → TCG2, no
  // interleaved LocateProtocol callers). If M4+ needs concurrent protocol
  // discovery, this becomes a caller-supplied out-pointer argument
  // (`efi_locate_protocol(..., iface_out: u64*) -> status`) — mechanical
  // signature widening, no re-encoding of the MS x64 marshalling.

  pub let mut _efi_last_located_interface : u64 = 0

  // Standalone-compile shadow of the entry-point latch (see file preamble).
  // Overridden by the definition in uefi_stub.pdx when the M2 multi-file
  // build lands.
  pub let mut _efi_system_table : u64 = 0

  // ==========================================================================
  // efi_locate_protocol — wraps EFI_BOOT_SERVICES.LocateProtocol
  // ==========================================================================
  //
  // UEFI 2.10 §7.3.11:
  //   EFI_STATUS LocateProtocol (
  //     IN  EFI_GUID *Protocol,       // arg0
  //     IN  VOID     *Registration,   // arg1 (usually NULL / 0)
  //     OUT VOID    **Interface       // arg2 (out)
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI; status returned in RAX.
  // MS x64 target:                 args in RCX/RDX/R8; status returned in RAX.
  // Out-interface latched into `_efi_last_located_interface` via R8.
  //
  // Emitted body (unsafe, @no_frame):
  //   mov  rax, [rip + _efi_system_table]              ; SystemTable*
  //   mov  rax, [rax + 96]                             ; BootServices*
  //   mov  rcx, rdi                                    ; MS arg0 = Protocol
  //   mov  rdx, rsi                                    ; MS arg1 = Registration
  //   lea  r8,  [rip + _efi_last_located_interface]    ; MS arg2 = &out_iface
  //   sub  rsp, 40                                     ; 32B shadow + 8B align
  //   call [rax + 320]                                 ; EFI_BS_OFFSET_LOCATE_PROTOCOL (0x140)
  //   add  rsp, 40
  //   ret

  pub let efi_locate_protocol : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-002 (#788). Typed wrapper for EFI_BOOT_SERVICES.LocateProtocol (UEFI 2.10 §7.3.11). Loads BootServices* from _efi_system_table (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES), marshals paideia-default (SysV) args RDI/RSI into MS x64 args RCX/RDX, points R8 at .data slot _efi_last_located_interface for the out-param, reserves 32-byte shadow space plus 8-byte alignment fix (RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL), makes indirect call via `FF /2 [rax + EFI_BS_OFFSET_LOCATE_PROTOCOL=320]` into the vtable slot, unwinds. Returns EFI_STATUS in RAX per firmware ABI; on EFI_SUCCESS the located interface pointer lives in _efi_last_located_interface. Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs clobbered so @no_frame is sound. Indirect-call-via-memory encoding (`FF /2` mem-form) verified in paideia-as encoder tests under #787.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        lea r8, [rip + _efi_last_located_interface];
        sub rsp, 40;
        call [rax + 320];
        add rsp, 40;
        ret
      }
    } @no_frame
}
