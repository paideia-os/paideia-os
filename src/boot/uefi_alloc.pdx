// src/boot/uefi_alloc.pdx — R19-M2-001 (#787)
//
// Typed wrappers over EFI_BOOT_SERVICES.AllocatePages / FreePages
// (UEFI 2.10 §7.2.1 / §7.2.2). Called from paideia-os side using the
// paideia default (SysV) argument convention; internally marshal to the
// Microsoft x64 calling convention firmware expects (UEFI 2.10 §II-2.3.4)
// and dispatch via indirect call through the Boot Services vtable slot
// (`FF /2` mem-form encoding, verified in
// paideia-as/crates/paideia-as-encoder/src/encode_instruction.rs::encode_call).
//
// -----------------------------------------------------------------------------
// Milestone scope (R19.M2, per design/round-retrospectives/r19-preflight.md)
// -----------------------------------------------------------------------------
//
// #787 (M2-001) delivers:
//   - `efi_allocate_pages(alloc_type, mem_type, num_pages) -> status`
//     with the out-address latched into `_efi_last_allocated_addr`
//     (single global slot is sufficient for the R19.M2 memmap discovery
//     flow — AllocatePages calls are strictly serialised pre-EBS).
//   - `efi_free_pages(addr, num_pages) -> status`.
//   - `_efi_last_allocated_addr` .data slot for the AllocatePages out-param.
//
// -----------------------------------------------------------------------------
// Cross-ABI (paideia default / SysV → MS x64) marshalling
// -----------------------------------------------------------------------------
//
// paideia-as-ir::abi::ARG_REGS = [RDI, RSI, RDX, RCX, R8, R9] — the paideia
// default calling convention places integer arguments in SysV order.
// paideia-as-ir::abi::MS_ARG_REGS = [RCX, RDX, R8, R9] — UEFI firmware
// consumes arguments in that order. The wrapper body is a raw unsafe block
// (@no_frame) that reshuffles the source registers into MS x64 order in
// dependency-safe sequence (write R8 from RDX before RDX is overwritten).
//
// UEFI 2.10 §II-2.3.4 further requires callers to reserve 32 B of "shadow
// space" above the return address (RCX/RDX/R8/R9 spill slots the callee
// may use freely) and to keep RSP aligned to 16 B *before* the CALL
// instruction pushes the return address. Our wrapper enters with RSP ≡
// 8 mod 16 (the SysV-default caller's CALL leaves it that way); a single
// `sub rsp, 0x28` (40 B = 32 shadow + 8 alignment fixup) restores RSP to
// 0 mod 16 pre-CALL. Symmetric `add rsp, 0x28` on return. See
// `uefi_stub.pdx` header for the identical discipline projected onto the
// entry-point path.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// SysV non-volatiles (RBX, RBP, R12-R15, RSP): the wrapper does NOT touch
// any of these — only RAX, RCX, RDX, R8, R9, R10, R11 are clobbered, all
// of which are volatile in both SysV and MS x64 calling conventions.
// Therefore @no_frame is sound (no prologue push/pop needed) and the
// wrapper is safe to call from any SysV-convention paideia-os caller
// without further save discipline.
//
// -----------------------------------------------------------------------------
// Provisional `_efi_system_table` shadow
// -----------------------------------------------------------------------------
//
// paideia-as v0.21 `build --target uefi-x86_64` compiles one .pdx
// translation unit at a time (see tools/build-uefi-stub.sh preamble,
// mirrored on uefi_types.pdx / uefi_strings.pdx / uefi_guids.pdx). To
// keep this file well-formed as a standalone compile — matching the
// discipline the other R19.M1 files established — we redeclare
// `_efi_system_table` locally. When R19.M2 grows the stub into a
// multi-file build (paideia-as enhancement `pa-r19-multi-file-link`,
// tracked in the R19 preflight retrospective), the duplicate resolves to
// the single .data global defined in `uefi_stub.pdx`; until then the
// local shadow keeps the standalone-compile invariant intact. The
// symbol name is deliberately identical so the link fan-out is a no-op
// rename rather than a substitution.

module UefiAlloc = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================
  //
  // `_efi_last_allocated_addr` receives the out-address that
  // EFI_BOOT_SERVICES.AllocatePages writes at *R9 per UEFI 2.10 §7.2.1
  // "Memory" argument. Consumers read this slot immediately after
  // `efi_allocate_pages` returns EFI_SUCCESS. A single global slot is
  // sufficient for R19.M2's serialised pre-ExitBootServices flow (no
  // interleaved AllocatePages callers). If M4+ needs re-entrant page
  // allocation, this becomes a caller-supplied out-pointer argument
  // (`efi_allocate_pages(..., addr_out: u64*) -> status`) — mechanical
  // signature widening, no re-encoding of the MS x64 marshalling.

  pub let mut _efi_last_allocated_addr : u64 = 0

  // Standalone-compile shadow of the entry-point latch (see file preamble).
  // Overridden by the definition in uefi_stub.pdx when the M2 multi-file
  // build lands.
  pub let mut _efi_system_table : u64 = 0

  // ==========================================================================
  // efi_allocate_pages — wraps EFI_BOOT_SERVICES.AllocatePages
  // ==========================================================================
  //
  // UEFI 2.10 §7.2.1:
  //   EFI_STATUS AllocatePages (
  //     IN     EFI_ALLOCATE_TYPE       Type,          // arg0
  //     IN     EFI_MEMORY_TYPE         MemoryType,    // arg1
  //     IN     UINTN                   Pages,         // arg2
  //     IN OUT EFI_PHYSICAL_ADDRESS   *Memory        // arg3 (in/out)
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI/RDX; status returned in RAX.
  // MS x64 target:                 args in RCX/RDX/R8/R9;   status returned in RAX.
  // Out-address latched into `_efi_last_allocated_addr` via R9.
  //
  // Emitted body (unsafe, @no_frame):
  //   mov  rax, [rip + _efi_system_table]     ; SystemTable*
  //   mov  rax, [rax + 96]                    ; BootServices* (EFI_ST_OFFSET_BOOT_SERVICES)
  //   mov  r8, rdx                            ; MS arg2 = Pages (before RDX is clobbered)
  //   mov  rdx, rsi                           ; MS arg1 = MemoryType
  //   mov  rcx, rdi                           ; MS arg0 = Type
  //   lea  r9,  [rip + _efi_last_allocated_addr] ; MS arg3 = &out_addr
  //   sub  rsp, 40                            ; 32B shadow + 8B align (8→0 mod 16)
  //   call [rax + 40]                         ; EFI_BS_OFFSET_ALLOCATE_PAGES
  //   add  rsp, 40                            ; unwind shadow + fixup
  //   ret

  pub let efi_allocate_pages : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (alloc_type: u64, mem_type: u64, num_pages: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-001 (#787). Typed wrapper for EFI_BOOT_SERVICES.AllocatePages (UEFI 2.10 §7.2.1). Loads BootServices* from _efi_system_table (offset +96 = EFI_ST_OFFSET_BOOT_SERVICES), marshals paideia-default (SysV) args RDI/RSI/RDX into MS x64 args RCX/RDX/R8 in dependency-safe order, points R9 at .data slot _efi_last_allocated_addr for the in/out address, reserves 32-byte shadow space plus 8-byte alignment fix (RSP transitions 8→0 mod 16 as MS x64 requires pre-CALL), makes indirect call via `FF /2 [rax + EFI_BS_OFFSET_ALLOCATE_PAGES=40]` into the vtable slot, unwinds. Returns EFI_STATUS in RAX per firmware ABI; on EFI_SUCCESS the allocated physical address lives in _efi_last_allocated_addr. Non-volatiles (RBX/RBP/R12-R15) untouched — only volatile GPRs clobbered so @no_frame is sound.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        lea r9, [rip + _efi_last_allocated_addr];
        sub rsp, 40;
        call [rax + 40];
        add rsp, 40;
        ret
      }
    } @no_frame

  // ==========================================================================
  // efi_free_pages — wraps EFI_BOOT_SERVICES.FreePages
  // ==========================================================================
  //
  // UEFI 2.10 §7.2.2:
  //   EFI_STATUS FreePages (
  //     IN EFI_PHYSICAL_ADDRESS   Memory,       // arg0
  //     IN UINTN                  Pages          // arg1
  //   );
  //
  // paideia-side signature (SysV): args in RDI/RSI; status returned in RAX.
  // MS x64 target:                 args in RCX/RDX;   status returned in RAX.
  //
  // Emitted body (unsafe, @no_frame):
  //   mov  rax, [rip + _efi_system_table]     ; SystemTable*
  //   mov  rax, [rax + 96]                    ; BootServices*
  //   mov  rcx, rdi                           ; MS arg0 = Memory
  //   mov  rdx, rsi                           ; MS arg1 = Pages
  //   sub  rsp, 40                            ; 32B shadow + 8B align
  //   call [rax + 48]                         ; EFI_BS_OFFSET_FREE_PAGES
  //   add  rsp, 40
  //   ret

  pub let efi_free_pages : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (addr: u64, num_pages: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M2-001 (#787). Typed wrapper for EFI_BOOT_SERVICES.FreePages (UEFI 2.10 §7.2.2). Same discipline as efi_allocate_pages: BootServices* fetched via _efi_system_table indirection at offset +96, SysV RDI/RSI marshalled to MS x64 RCX/RDX, 32-byte shadow + 8-byte alignment fix pre-CALL, indirect call `FF /2 [rax + EFI_BS_OFFSET_FREE_PAGES=48]`, symmetric unwind. Returns EFI_STATUS in RAX. Non-volatiles preserved (only RAX/RCX/RDX touched) → @no_frame sound.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        sub rsp, 40;
        call [rax + 48];
        add rsp, 40;
        ret
      }
    } @no_frame
}
