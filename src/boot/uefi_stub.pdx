// src/boot/uefi_stub.pdx — R19-M1/M2/M3 merged translation unit
//
// PaideiaOS-native UEFI EFI application. UEFI firmware invokes efi_main
// per the PE32+ Optional Header AddressOfEntryPoint field, under the
// Microsoft x64 calling convention (UEFI 2.10 §II-2.3.4 / §II-2.4.1).
//
// -----------------------------------------------------------------------------
// Milestone-round layering
// -----------------------------------------------------------------------------
//
// This single file is the working translation unit for the R19 pre-EBS
// boot path — paideia-as v0.20.1 build --target uefi-x86_64 accepts one
// .pdx input and does not yet fan out multi-file link (paideia-as
// enhancement pa-r19-multi-file-link, tracked in the R19 preflight
// retrospective), so the individual milestone artefacts live in sibling
// .pdx files as standalone-compilable documentation companions and this
// file INLINES their code for the actual PE emit. When the multi-file
// link mechanism lands, the sibling files become the authoritative
// definitions and this file collapses to just efi_main + the shared
// .data globals.
//
// R19.M1 (#783/#784/#785/#786) — entry-point skeleton, EFI type / offset
//   table, CHAR16 hello string, GUID literals. All landed in this file's
//   .data globals + efi_main prologue/epilogue.
//
// R19.M2 (#787-#791) — Boot Services wrappers (LocateProtocol,
//   OpenProtocol / CloseProtocol, AllocatePages, GetMemoryMap) + EFI_STATUS
//   decode + panic-on-fatal helper. Companion files under src/boot/uefi_*.pdx
//   are the spec-heavy documentation; the wrappers inlined here are byte-
//   equivalent to those docs (verified against the disassembly in each
//   companion file's preamble).
//
// R19.M3 (#792-#796) — Firmware probes: GOP framebuffer discovery /
//   capture, ACPI 2.0 RSDP walk, LoadedImage lookup, optional TCG2
//   measurement. Sibling files under src/boot/uefi_gop.pdx, uefi_acpi.pdx,
//   uefi_loaded_image.pdx, uefi_tcg2.pdx, uefi_env.pdx are the standalone-
//   compilable documentation companions; the M3 wrappers inlined below
//   are byte-equivalent to those docs.
//
// R19.M4 (#797+) — ExitBootServices + kernel handoff. Not landed here yet;
//   efi_main returns EFI_SUCCESS after the M3 probes so the current .efi
//   is a "measure and print, then hand control back to firmware" artefact
//   suitable for OVMF integration.
//
// -----------------------------------------------------------------------------
// Entry-point ordering
// -----------------------------------------------------------------------------
//
// The paideia-as PE emitter (tools/paideia-as/crates/paideia-as/src/
// cmd_build/pe.rs:279) sets AddressOfEntryPoint to the RVA of the first
// function in the first .text section. efi_main MUST therefore be the
// first `pub let` binding whose RHS is a Lambda in this module. All
// wrappers and helpers are defined after efi_main; the paideia-as PE
// emitter fixes forward text->text call relocations correctly (fix
// b0cb6f3 = paideia-as #1292/#1293), so efi_main can call functions that
// appear later in source order.
//
// -----------------------------------------------------------------------------
// MS x64 ABI discipline (recap; see companion files for the full audit)
// -----------------------------------------------------------------------------
//
// - UEFI 2.10 §II-2.3.4: MS x64 args in RCX/RDX/R8/R9, 5+ on stack
//   above 32-byte shadow; return in RAX; RSP ≡ 0 mod 16 immediately
//   before CALL. Non-volatile GPRs: RBX/RBP/RDI/RSI/RSP/R12-R15,
//   XMM6-XMM15.
// - Paideia (SysV): args in RDI/RSI/RDX/RCX/R8/R9. Wrappers reshuffle
//   SysV -> MS in dependency-safe order before dispatching to firmware.
// - efi_main is @abi("ms") — its caller (firmware) uses MS x64. All
//   other functions in this file are default SysV; the wrappers marshal
//   at the boundary.

module UefiStub = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================

  // Latched by efi_main from firmware-provided arguments.
  pub let mut _efi_image_handle  : u64 = 0
  pub let mut _efi_system_table  : u64 = 0

  // Out-parameter latches for the Boot Services wrappers.
  pub let mut _efi_last_located_interface : u64 = 0
  pub let mut _efi_last_opened_interface  : u64 = 0

  // R19.M3 discovery result slots.
  pub let mut _efi_gop_this   : u64 = 0
  pub let mut _efi_tcg2_this  : u64 = 0
  pub let mut _efi_rsdp_addr  : u64 = 0
  pub let mut _efi_image_base : u64 = 0
  pub let mut _efi_image_size : u64 = 0

  // Framebuffer descriptor — 32 B (fb_desc_t, uefi_env.pdx layout).
  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)

  // TCG2 event scratch — 24 B (only first 21 used; see uefi_tcg2.pdx).
  pub let mut _efi_tcg2_event : [u64; 3] = uninit @align(8)

  // ==========================================================================
  // CHAR16 message literals (UTF-16 LE via [u16; N] with trailing NUL)
  // ==========================================================================
  //
  // Encoded ASCII -> CHAR16 per src/boot/uefi_strings.pdx recipe: each byte
  // c in 0..0x7F maps to the u16 c which lands on disk as [c, 0x00] on
  // little-endian x86_64. All messages are NUL-terminated (OutputString
  // walks until U+0000 per UEFI 2.10 §II-4).

  //   "paideia boot: entry ok\r\n\0"  (24 chars + NUL = 25 u16)
  pub let _hello_char16 : [u16; 25] = [
    112,  97, 105, 100, 101, 105,  97,  32,
     98, 111, 111, 116,  58,  32,
    101, 110, 116, 114, 121,  32,
    111, 107,  13,  10,   0
  ]

  //   "GOP locate fail\r\n\0"  (17 + NUL = 18)
  pub let _panic_gop_locate_msg : [u16; 18] = [
     71,  79,  80,  32, 108, 111,  99,  97, 116, 101,
     32, 102,  97, 105, 108,  13,  10,   0
  ]

  //   "LoadedImage open fail\r\n\0"  (23 + NUL = 24)
  pub let _panic_li_open_msg : [u16; 24] = [
     76, 111,  97, 100, 101, 100,  73, 109,  97, 103,
    101,  32, 111, 112, 101, 110,  32, 102,  97, 105,
    108,  13,  10,   0
  ]

  // ==========================================================================
  // Protocol / configuration-table GUIDs
  // ==========================================================================
  //
  // See src/boot/uefi_guids.pdx for the byte-encoding derivation from the
  // printed GUID forms. Byte-for-byte identical to that reference file.

  //   9042A9DE-23DC-4A38-96FB-7ADED080516A
  pub let _efi_graphics_output_protocol_guid : [u8; 16] = [
    0xDEu8, 0xA9u8, 0x42u8, 0x90u8,
    0xDCu8, 0x23u8, 0x38u8, 0x4Au8,
    0x96u8, 0xFBu8, 0x7Au8, 0xDEu8,
    0xD0u8, 0x80u8, 0x51u8, 0x6Au8
  ]

  //   8868E871-E4F1-11D3-BC22-0080C73C8881
  pub let _efi_acpi_20_table_guid : [u8; 16] = [
    0x71u8, 0xE8u8, 0x68u8, 0x88u8,
    0xF1u8, 0xE4u8, 0xD3u8, 0x11u8,
    0xBCu8, 0x22u8, 0x00u8, 0x80u8,
    0xC7u8, 0x3Cu8, 0x88u8, 0x81u8
  ]

  //   607F766C-7455-42BE-930B-E4D76DB2720F
  pub let _efi_tcg2_protocol_guid : [u8; 16] = [
    0x6Cu8, 0x76u8, 0x7Fu8, 0x60u8,
    0x55u8, 0x74u8, 0xBEu8, 0x42u8,
    0x93u8, 0x0Bu8, 0xE4u8, 0xD7u8,
    0x6Du8, 0xB2u8, 0x72u8, 0x0Fu8
  ]

  //   5B1B31A1-9562-11D2-8E3F-00A0C969723B
  pub let _efi_loaded_image_protocol_guid : [u8; 16] = [
    0xA1u8, 0x31u8, 0x1Bu8, 0x5Bu8,
    0x62u8, 0x95u8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x3Fu8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  // ==========================================================================
  // efi_main — PE32+ AddressOfEntryPoint (MS x64 ABI)
  // ==========================================================================
  //
  // MUST be the first function-typed `pub let` in this module (see file
  // preamble under "Entry-point ordering"). Orchestrates the R19.M1+M2+M3
  // pre-ExitBootServices flow:
  //
  //   1. Save MS x64 non-volatile GPRs.
  //   2. Latch ImageHandle (RCX) and SystemTable* (RDX) into .data slots.
  //   3. Print the R19.M1 hello fingerprint via ConOut->OutputString.
  //   4. Run the R19.M3 discovery sequence in strict order:
  //        efi_gop_discover -> efi_gop_capture -> efi_find_rsdp
  //        -> efi_get_loaded_image -> efi_tcg2_measure_kernel
  //   5. Restore non-volatiles and return EFI_SUCCESS.
  //
  // R19.M4 (ExitBootServices + kernel handoff) will replace step 5 with a
  // handoff sequence; the current .efi is a "print and probe" artefact
  // that returns to firmware so operators can inspect the console banner
  // + inspect the discovery-result .data slots post-return.

  pub let efi_main : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, system_table: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19.M1+M2+M3 (#783/#784/#785/#786/#787-#791/#792-#796). UEFI PE32+ entry per UEFI 2.10 §II-2.3.4 MS x64 calling convention: RCX=ImageHandle, RDX=SystemTable*. Saves the eight MS x64 non-volatile GPRs on entry, latches both arguments into .data slots (_efi_image_handle/_efi_system_table), emits the R19.M1 hello banner via ConOut->OutputString (UEFI 2.10 §12.4.3), then dispatches the R19.M3 discovery sequence in strict order: efi_gop_discover -> efi_gop_capture -> efi_find_rsdp -> efi_get_loaded_image -> efi_tcg2_measure_kernel. Restores non-volatiles in LIFO order and returns EFI_SUCCESS (RAX=0). Non-fatal probes (efi_find_rsdp, efi_tcg2_measure_kernel) do not gate the return; fatal probes (efi_gop_discover, efi_get_loaded_image) invoke efi_panic_on_fatal internally and never return to us. Stack discipline: entry with RSP ≡ 8 mod 16 (UEFI 2.10 §II-2.3.4); 8 pushes leave RSP ≡ 8 mod 16; every downstream call is either a SysV-default helper (which manages its own stack) or an MS-x64 wrapper (which manages its own shadow + alignment fixup), so no additional sub rsp is needed in this outer function; the pushes/pops balance across the whole body.",
      block: {
        push rbx;
        push rbp;
        push rdi;
        push rsi;
        push r12;
        push r13;
        push r14;
        push r15;

        mov [rip + _efi_image_handle], rcx;
        mov [rip + _efi_system_table], rdx;

        // Hello banner: ConOut->OutputString(ConOut, _hello_char16)
        //   rax = SystemTable*
        //   rcx = ConOut* (SystemTable + 64)
        //   rdx = &_hello_char16
        //   call [rcx + 8] (OutputString slot)
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        lea rdx, [rip + _hello_char16];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

        // R19.M3 discovery sequence.
        call efi_gop_discover;
        call efi_gop_capture;
        call efi_find_rsdp;

        // efi_get_loaded_image takes the ImageHandle in SysV rdi.
        mov rdi, [rip + _efi_image_handle];
        call efi_get_loaded_image;

        // efi_tcg2_measure_kernel(image_base, image_size).
        mov rdi, [rip + _efi_image_base];
        mov rsi, [rip + _efi_image_size];
        call efi_tcg2_measure_kernel;

        // Return EFI_SUCCESS.
        mov rax, 0;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rsi;
        pop rdi;
        pop rbp;
        pop rbx;
        ret
      }
    } @abi("ms") @no_frame

  // ==========================================================================
  // R19.M2 wrappers (see src/boot/uefi_locate.pdx / uefi_openproto.pdx /
  // uefi_status.pdx for the spec-heavy documentation companions).
  // ==========================================================================

  // -- efi_locate_protocol (wraps BS->LocateProtocol at BS+320) ---------------
  //
  // SysV: (guid_ptr, registration) -> status
  // MS:   RCX=Protocol, RDX=Registration, R8=&out_iface  (32B shadow + 8B align)
  pub let efi_locate_protocol : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-002 (#788). Wraps EFI_BOOT_SERVICES.LocateProtocol (UEFI 2.10 §7.3.11). Loads BS* via _efi_system_table[+96], marshals SysV RDI/RSI into MS RCX/RDX, points R8 at _efi_last_located_interface, reserves 32B shadow + 8B alignment, indirect-calls via `FF /2 [rax + 320]`. Byte-identical to src/boot/uefi_locate.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        lea r8, [rip + _efi_last_located_interface];
        sub rsp, 40;
        call [rax + 320];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_open_protocol (wraps BS->OpenProtocol at BS+280) -------------------
  //
  // SysV: (handle, guid, agent, controller, attributes) -> status
  // MS:   RCX=Handle, RDX=Protocol, R8=&out_iface, R9=AgentHandle,
  //       [rsp+0x20]=ControllerHandle, [rsp+0x28]=Attributes
  pub let efi_open_protocol : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64, attributes: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.OpenProtocol (UEFI 2.10 §7.3.9). 6-arg MS x64 dispatch (2 args spill to stack); RSP transitions 8→0 mod 16 via `sub rsp, 56`. Marshals SysV RDI/RSI/RDX/RCX/R8 into MS RCX/RDX/R9/[rsp+0x20]/[rsp+0x28] in dependency-safe order; synthesises MS R8 (&out_iface) via lea. Byte-identical to src/boot/uefi_openproto.pdx efi_open_protocol.",
      block: {
        sub rsp, 56;
        mov [rsp + 40], r8;
        mov [rsp + 32], rcx;
        mov r9, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        lea r8, [rip + _efi_last_opened_interface];
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        call [rax + 280];
        add rsp, 56;
        ret
      }
    } @no_frame

  // -- efi_close_protocol (wraps BS->CloseProtocol at BS+288) -----------------
  pub let efi_close_protocol : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.CloseProtocol (UEFI 2.10 §7.3.10). 4-arg MS x64 dispatch (all args in-registers); 32B shadow + 8B align. Byte-identical to src/boot/uefi_openproto.pdx efi_close_protocol.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        sub rsp, 40;
        call [rax + 288];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_panic_on_fatal ----------------------------------------------------
  //
  // If (status & 1<<63) set: OutputString(ConOut, message), then cli/hlt spin.
  // Else: return normally.
  pub let efi_panic_on_fatal : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (status: u64, message_ptr: u64, message_len: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-005 (#791). Conditional abort helper: on EFI error (bit 63 set), emits the caller-supplied CHAR16 banner via ConOut->OutputString (UEFI 2.10 §12.4.3) and cli/hlt spins; otherwise returns. Byte-identical to src/boot/uefi_status.pdx.",
      block: {
        mov rax, rdi;
        shr rax, 63;
        cmp rax, 0;
        je efi_panic_on_fatal_ok;

        mov rdx, rsi;
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

      efi_panic_on_fatal_spin:
        cli;
        hlt;
        jmp efi_panic_on_fatal_spin;

      efi_panic_on_fatal_ok:
        ret
      }
    } @no_frame

  // ==========================================================================
  // R19.M3 wrappers (see src/boot/uefi_gop.pdx / uefi_acpi.pdx /
  // uefi_loaded_image.pdx / uefi_tcg2.pdx for the documentation companions).
  // ==========================================================================

  // -- efi_gop_discover — LocateProtocol GOP, latch gop_this -----------------
  pub let efi_gop_discover : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-001 (#792). LocateProtocol EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, latch located interface into _efi_gop_this. Panics via efi_panic_on_fatal if LocateProtocol fails (GOP is mandatory for R19 kernel handoff). MVP: accept firmware's current mode without walking Mode->MaxMode. Byte-identical to src/boot/uefi_gop.pdx efi_gop_discover.",
      block: {
        lea rdi, [rip + _efi_graphics_output_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_gop_locate_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_gop_this], rax;
        mov rax, 0;
        ret
      }
    } @no_frame

  // -- efi_gop_capture — populate _efi_fb_desc from Mode / Mode->Info --------
  pub let efi_gop_capture : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-002 (#793). Read Mode* + Mode->Info via _efi_gop_this and write the fb_desc_t fields (base/size/pitch/width/height/format) into _efi_fb_desc. Pitch = PixelsPerScanLine * 4 (UEFI 2.10 §12.9). Stores go through SIB-form addressing (lea rdi, then mov [rdi+off], edx) to work around the paideia-as v0.20.1 encoder's RIP-relative narrow-store gap. Byte-identical to src/boot/uefi_gop.pdx efi_gop_capture.",
      block: {
        mov rax, [rip + _efi_gop_this];
        mov rcx, [rax + 24];
        lea rdi, [rip + _efi_fb_desc];
        mov rdx, [rcx + 24];
        mov [rdi + 0], rdx;
        mov rdx, [rcx + 32];
        mov [rdi + 8], rdx;
        mov r8, [rcx + 8];
        mov edx, [r8 + 32];
        shl edx, 2;
        mov [rdi + 16], edx;
        mov edx, [r8 + 4];
        mov [rdi + 20], edx;
        mov edx, [r8 + 8];
        mov [rdi + 24], edx;
        mov edx, [r8 + 12];
        mov [rdi + 28], edx;
        ret
      }
    } @no_frame

  // -- efi_find_rsdp — walk ConfigurationTable, match ACPI 2.0 GUID ---------
  pub let efi_find_rsdp : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-003 (#794). Walk EFI_SYSTEM_TABLE.ConfigurationTable[] (UEFI 2.10 §4.6.1) comparing 16-byte VendorGuid against EFI_ACPI_20_TABLE_GUID via two u64 chunks per entry; on first match return VendorTable (RSDP address) in RAX and latch to _efi_rsdp_addr, else return 0 (ACPI-absent is a valid degraded mode). Byte-identical to src/boot/uefi_acpi.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 104];
        mov rdx, [rax + 112];
        lea rsi, [rip + _efi_acpi_20_table_guid];
        mov r8, [rsi + 0];
        mov r9, [rsi + 8];
        mov rax, 0;
        cmp rcx, 0;
        je efi_find_rsdp_done;
      efi_find_rsdp_loop:
        mov r10, [rdx + 0];
        cmp r10, r8;
        jne efi_find_rsdp_skip;
        mov r10, [rdx + 8];
        cmp r10, r9;
        jne efi_find_rsdp_skip;
        mov rax, [rdx + 16];
        jmp efi_find_rsdp_done;
      efi_find_rsdp_skip:
        add rdx, 24;
        dec rcx;
        jne efi_find_rsdp_loop;
      efi_find_rsdp_done:
        mov [rip + _efi_rsdp_addr], rax;
        ret
      }
    } @no_frame

  // -- efi_get_loaded_image — OpenProtocol LoadedImage; latch base/size -----
  pub let efi_get_loaded_image : (u64) -> () !{sysreg, mem} @{} =
    fn (image_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-005 (#796). OpenProtocol on ImageHandle with EFI_LOADED_IMAGE_PROTOCOL_GUID and BY_HANDLE_PROTOCOL attribute (UEFI 2.10 §7.3.9 — no CloseProtocol pair required for BY_HANDLE_PROTOCOL applications); read ImageBase (+64) and ImageSize (+72) from the returned interface (UEFI 2.10 §9.1) and latch into _efi_image_base / _efi_image_size. Panics via efi_panic_on_fatal if OpenProtocol fails. Byte-identical to src/boot/uefi_loaded_image.pdx.",
      block: {
        mov rdx, rdi;
        lea rsi, [rip + _efi_loaded_image_protocol_guid];
        mov rcx, 0;
        mov r8, 1;
        call efi_open_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_li_open_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_opened_interface];
        mov rcx, [rax + 64];
        mov [rip + _efi_image_base], rcx;
        mov rcx, [rax + 72];
        mov [rip + _efi_image_size], rcx;
        ret
      }
    } @no_frame

  // -- efi_tcg2_measure_kernel — optional TPM measurement -------------------
  pub let efi_tcg2_measure_kernel : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_base: u64, image_size: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-004 (#795). Optional measured-boot integration. Populates a minimal EFI_TCG2_EVENT header (PCRIndex=4 EV_EFI_BOOT_SERVICES_APPLICATION, EventType=0x80000009), LocateProtocol EFI_TCG2_PROTOCOL_GUID; on EFI_NOT_FOUND (TPM absent) returns 0 silently. On success, latches _efi_tcg2_this and dispatches HashLogExtendEvent(this, 0, image_base, image_size, &_efi_tcg2_event) via `FF /2 [rax + 16]` per EFI TCG2 Protocol spec §6.2. 5-arg MS x64 dispatch — 32B shadow + 1-arg stack slot + alignment pad = sub rsp, 56. Byte-identical to src/boot/uefi_tcg2.pdx.",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        lea rcx, [rip + _efi_tcg2_event];
        mov rax, 21;
        mov [rcx + 0], eax;
        mov rax, 16;
        mov [rcx + 4], eax;
        mov rax, 1;
