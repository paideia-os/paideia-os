// src/boot/uefi_stub.pdx — R19-M1/M2/M3/M4 merged translation unit
//
// PaideiaOS-native UEFI EFI application. UEFI firmware invokes efi_main
// per the PE32+ Optional Header AddressOfEntryPoint field, under the
// Microsoft x64 calling convention (UEFI 2.10 §II-2.3.4 / §II-2.4.1).
//
// -----------------------------------------------------------------------------
// Milestone-round layering
// -----------------------------------------------------------------------------
//
// This single file is the working translation unit for the R19 pre-EBS
// boot path — paideia-as v0.20.1 build --target uefi-x86_64 accepts one
// .pdx input and does not yet fan out multi-file link (paideia-as
// enhancement pa-r19-multi-file-link, tracked in the R19 preflight
// retrospective), so the individual milestone artefacts live in sibling
// .pdx files as standalone-compilable documentation companions and this
// file INLINES their code for the actual PE emit. When the multi-file
// link mechanism lands, the sibling files become the authoritative
// definitions and this file collapses to just efi_main + the shared
// .data globals.
//
// R19.M1 (#783/#784/#785/#786) — entry-point skeleton, EFI type / offset
//   table, CHAR16 hello string, GUID literals. All landed in this file's
//   .data globals + efi_main prologue/epilogue.
//
// R19.M2 (#787-#791) — Boot Services wrappers (LocateProtocol,
//   OpenProtocol / CloseProtocol, AllocatePages, GetMemoryMap) + EFI_STATUS
//   decode + panic-on-fatal helper. Companion files under src/boot/uefi_*.pdx
//   are the spec-heavy documentation; the wrappers inlined here are byte-
//   equivalent to those docs (verified against the disassembly in each
//   companion file's preamble).
//
// R19.M3 (#792-#796) — Firmware probes: GOP framebuffer discovery /
//   capture, ACPI 2.0 RSDP walk, LoadedImage lookup, optional TCG2
//   measurement. Sibling files under src/boot/uefi_gop.pdx, uefi_acpi.pdx,
//   uefi_loaded_image.pdx, uefi_tcg2.pdx, uefi_env.pdx are the standalone-
//   compilable documentation companions; the M3 wrappers inlined below
//   are byte-equivalent to those docs.
//
// R19.M4 (#797/#798/#799/#800) — ExitBootServices + kernel handoff.
//   Extends this file with:
//     - boot_env_t slot (_boot_env, 256 B, 32B aligned; layout in
//       src/boot/uefi_env.pdx) and the efi_finalize_and_handoff pass that
//       populates it from the M1/M2/M3-latched slots plus the freshly
//       taken memory map.
//     - Static memory-map buffer (_efi_memmap_buffer, 32 KB in .bss) and
//       the four u64 out-slots (size / key / desc_size / desc_ver) that
//       efi_get_memory_map writes into.
//     - efi_get_memory_map wrapper — inlined from src/boot/uefi_memmap.pdx
//       (still authoritative documentation companion for #789).
//     - efi_exit_boot_services wrapper — inlined from src/boot/uefi_exit.pdx
//       (authoritative documentation companion for #798).
//     - efi_finalize_and_handoff — the retry-loop finalizer that owns the
//       get_memory_map ↔ exit_boot_services critical section (no console
//       output, no allocations between the two calls; MapKey refresh via
//       re-invocation of get_memory_map on EFI_INVALID_PARAMETER; capped
//       at 3 attempts, then efi_panic_on_fatal).
//     - _kernel_main_uefi_pa placeholder — the physical address of the
//       kernel_main_uefi entry (defined in src/kernel/kernel_main_uefi.pdx,
//       linked into kernel.elf). For M4 this is a hard-coded literal
//       (KERNEL_PHYS_BASE = 0x100000) that the R19.M5 ELF loader will
//       overwrite once it has parsed kernel.elf and located the entry.
//   Post-EBS: firmware quiescent, Boot Services pointers all invalidated.
//   Only the pre-latched RuntimeServices* (boot_env_t.runtime_services_pa)
//   remains callable. The finalizer's last act is `push rax; ret` — an
//   indirect jump via the stack — with RDI already set to &_boot_env
//   (SysV arg 0) so kernel_main_uefi receives the handoff struct.
//
// -----------------------------------------------------------------------------
// Entry-point ordering
// -----------------------------------------------------------------------------
//
// The paideia-as PE emitter (tools/paideia-as/crates/paideia-as/src/
// cmd_build/pe.rs:279) sets AddressOfEntryPoint to the RVA of the first
// function in the first .text section. efi_main MUST therefore be the
// first `pub let` binding whose RHS is a Lambda in this module. All
// wrappers and helpers are defined after efi_main; the paideia-as PE
// emitter fixes forward text->text call relocations correctly (fix
// b0cb6f3 = paideia-as #1292/#1293), so efi_main can call functions that
// appear later in source order.
//
// -----------------------------------------------------------------------------
// MS x64 ABI discipline (recap; see companion files for the full audit)
// -----------------------------------------------------------------------------
//
// - UEFI 2.10 §II-2.3.4: MS x64 args in RCX/RDX/R8/R9, 5+ on stack
//   above 32-byte shadow; return in RAX; RSP ≡ 0 mod 16 immediately
//   before CALL. Non-volatile GPRs: RBX/RBP/RDI/RSI/RSP/R12-R15,
//   XMM6-XMM15.
// - Paideia (SysV): args in RDI/RSI/RDX/RCX/R8/R9. Wrappers reshuffle
//   SysV -> MS in dependency-safe order before dispatching to firmware.
// - efi_main is @abi("ms") — its caller (firmware) uses MS x64. All
//   other functions in this file are default SysV; the wrappers marshal
//   at the boundary.

module UefiStub = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================

  // Latched by efi_main from firmware-provided arguments.
  pub let mut _efi_image_handle  : u64 = 0
  pub let mut _efi_system_table  : u64 = 0

  // Out-parameter latches for the Boot Services wrappers.
  pub let mut _efi_last_located_interface : u64 = 0
  pub let mut _efi_last_opened_interface  : u64 = 0

  // R19.M3 discovery result slots.
  pub let mut _efi_gop_this   : u64 = 0
  pub let mut _efi_tcg2_this  : u64 = 0
  pub let mut _efi_rsdp_addr  : u64 = 0
  pub let mut _efi_image_base : u64 = 0
  pub let mut _efi_image_size : u64 = 0

  // Framebuffer descriptor — 32 B (fb_desc_t, uefi_env.pdx layout).
  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)

  // TCG2 event scratch — 24 B (only first 21 used; see uefi_tcg2.pdx).
  pub let mut _efi_tcg2_event : [u64; 3] = uninit @align(8)

  // R19.M4 (#797/#798/#800) slots.

  // boot_env_t — 256 B, 32-byte aligned. Layout in src/boot/uefi_env.pdx.
  // Populated by efi_finalize_and_handoff and passed to kernel_main_uefi
  // in RDI (SysV arg 0) after ExitBootServices returns EFI_SUCCESS.
  pub let mut _boot_env : [u64; 32] = uninit @align(32)

  // Memory-map buffer (#798). Fixed 32 KB in .bss (EfiLoaderData —
  // survives ExitBootServices). Big enough for OVMF's typical ~200
  // descriptor × 48 B ≈ 10 KB output with headroom for the +2 descriptors
  // firmware may add between the probe call and the exit call. If a real
  // firmware overflows this, ExitBootServices will fail 3× with a stale
  // key and the finalizer will panic — the check surfaces as a build-time
  // hazard for that firmware, tracked as follow-up "uefi-memmap-dynalloc"
  // in the R19.M4 retrospective (pre-EBS AllocatePages instead of static).
  pub let mut _efi_memmap_buffer : [u64; 4096] = uninit @align(4096)

  // efi_get_memory_map out-slot latches (5 args, all OUT). Values consumed
  // by the finalizer + copied into boot_env_t.
  pub let mut _efi_memmap_size      : u64 = 0
  pub let mut _efi_memmap_key       : u64 = 0
  pub let mut _efi_memmap_desc_size : u64 = 0
  pub let mut _efi_memmap_desc_ver  : u64 = 0

  // R19.M4 (#799) — kernel_main_uefi entry point (physical address).
  //
  // For M4 this is a hard-coded placeholder (KERNEL_PHYS_BASE = 0x100000).
  // The R19.M5 ELF loader will:
  //   (a) parse kernel.elf's symbol table for kernel_main_uefi's VMA
  //   (b) compute its LMA via the link.ld VMA/LMA rule
  //   (c) rewrite this .data slot with the real PA
  // Until then, the .efi's jmp is symbolic — running it will land on
  // whatever occupies 0x100000 in the loaded firmware's memory (typically
  // firmware code or the loaded kernel image if OVMF has already staged
  // it via LoadImage). The wiring is correct; the target is placeholder.
  pub let mut _kernel_main_uefi_pa : u64 = 0x100000

  //   "EBS fail retries exhausted\r\n\0"  (28 + NUL = 29)
  pub let _panic_ebs_msg : [u16; 29] = [
     69,  66,  83,  32, 102,  97, 105, 108,  32, 114,
    101, 116, 114, 105, 101, 115,  32, 101, 120, 104,
     97, 117, 115, 116, 101, 100,  13,  10,   0
  ]

  // ==========================================================================
  // CHAR16 message literals (UTF-16 LE via [u16; N] with trailing NUL)
  // ==========================================================================
  //
  // Encoded ASCII -> CHAR16 per src/boot/uefi_strings.pdx recipe: each byte
  // c in 0..0x7F maps to the u16 c which lands on disk as [c, 0x00] on
  // little-endian x86_64. All messages are NUL-terminated (OutputString
  // walks until U+0000 per UEFI 2.10 §II-4).

  //   "paideia boot: entry ok\r\n\0"  (24 chars + NUL = 25 u16)
  pub let _hello_char16 : [u16; 25] = [
    112,  97, 105, 100, 101, 105,  97,  32,
     98, 111, 111, 116,  58,  32,
    101, 110, 116, 114, 121,  32,
    111, 107,  13,  10,   0
  ]

  //   "GOP locate fail\r\n\0"  (17 + NUL = 18)
  pub let _panic_gop_locate_msg : [u16; 18] = [
     71,  79,  80,  32, 108, 111,  99,  97, 116, 101,
     32, 102,  97, 105, 108,  13,  10,   0
  ]

  //   "LoadedImage open fail\r\n\0"  (23 + NUL = 24)
  pub let _panic_li_open_msg : [u16; 24] = [
     76, 111,  97, 100, 101, 100,  73, 109,  97, 103,
    101,  32, 111, 112, 101, 110,  32, 102,  97, 105,
    108,  13,  10,   0
  ]

  // ==========================================================================
  // Protocol / configuration-table GUIDs
  // ==========================================================================
  //
  // See src/boot/uefi_guids.pdx for the byte-encoding derivation from the
  // printed GUID forms. Byte-for-byte identical to that reference file.

  //   9042A9DE-23DC-4A38-96FB-7ADED080516A
  pub let _efi_graphics_output_protocol_guid : [u8; 16] = [
    0xDEu8, 0xA9u8, 0x42u8, 0x90u8,
    0xDCu8, 0x23u8, 0x38u8, 0x4Au8,
    0x96u8, 0xFBu8, 0x7Au8, 0xDEu8,
    0xD0u8, 0x80u8, 0x51u8, 0x6Au8
  ]

  //   8868E871-E4F1-11D3-BC22-0080C73C8881
  pub let _efi_acpi_20_table_guid : [u8; 16] = [
    0x71u8, 0xE8u8, 0x68u8, 0x88u8,
    0xF1u8, 0xE4u8, 0xD3u8, 0x11u8,
    0xBCu8, 0x22u8, 0x00u8, 0x80u8,
    0xC7u8, 0x3Cu8, 0x88u8, 0x81u8
  ]

  //   607F766C-7455-42BE-930B-E4D76DB2720F
  pub let _efi_tcg2_protocol_guid : [u8; 16] = [
    0x6Cu8, 0x76u8, 0x7Fu8, 0x60u8,
    0x55u8, 0x74u8, 0xBEu8, 0x42u8,
    0x93u8, 0x0Bu8, 0xE4u8, 0xD7u8,
    0x6Du8, 0xB2u8, 0x72u8, 0x0Fu8
  ]

  //   5B1B31A1-9562-11D2-8E3F-00A0C969723B
  pub let _efi_loaded_image_protocol_guid : [u8; 16] = [
    0xA1u8, 0x31u8, 0x1Bu8, 0x5Bu8,
    0x62u8, 0x95u8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x3Fu8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  // ==========================================================================
  // efi_main — PE32+ AddressOfEntryPoint (MS x64 ABI)
  // ==========================================================================
  //
  // MUST be the first function-typed `pub let` in this module (see file
  // preamble under "Entry-point ordering"). Orchestrates the R19.M1+M2+M3
  // pre-ExitBootServices flow:
  //
  //   1. Save MS x64 non-volatile GPRs.
  //   2. Latch ImageHandle (RCX) and SystemTable* (RDX) into .data slots.
  //   3. Print the R19.M1 hello fingerprint via ConOut->OutputString.
  //   4. Run the R19.M3 discovery sequence in strict order:
  //        efi_gop_discover -> efi_gop_capture -> efi_find_rsdp
  //        -> efi_get_loaded_image -> efi_tcg2_measure_kernel
  //   5. Restore non-volatiles and return EFI_SUCCESS.
  //
  // R19.M4 (ExitBootServices + kernel handoff) will replace step 5 with a
  // handoff sequence; the current .efi is a "print and probe" artefact
  // that returns to firmware so operators can inspect the console banner
  // + inspect the discovery-result .data slots post-return.

  pub let efi_main : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, system_table: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19.M1+M2+M3 (#783/#784/#785/#786/#787-#791/#792-#796). UEFI PE32+ entry per UEFI 2.10 §II-2.3.4 MS x64 calling convention: RCX=ImageHandle, RDX=SystemTable*. Saves the eight MS x64 non-volatile GPRs on entry, latches both arguments into .data slots (_efi_image_handle/_efi_system_table), emits the R19.M1 hello banner via ConOut->OutputString (UEFI 2.10 §12.4.3), then dispatches the R19.M3 discovery sequence in strict order: efi_gop_discover -> efi_gop_capture -> efi_find_rsdp -> efi_get_loaded_image -> efi_tcg2_measure_kernel. Restores non-volatiles in LIFO order and returns EFI_SUCCESS (RAX=0). Non-fatal probes (efi_find_rsdp, efi_tcg2_measure_kernel) do not gate the return; fatal probes (efi_gop_discover, efi_get_loaded_image) invoke efi_panic_on_fatal internally and never return to us. Stack discipline: entry with RSP ≡ 8 mod 16 (UEFI 2.10 §II-2.3.4); 8 pushes leave RSP ≡ 8 mod 16; every downstream call is either a SysV-default helper (which manages its own stack) or an MS-x64 wrapper (which manages its own shadow + alignment fixup), so no additional sub rsp is needed in this outer function; the pushes/pops balance across the whole body.",
      block: {
        push rbx;
        push rbp;
        push rdi;
        push rsi;
        push r12;
        push r13;
        push r14;
        push r15;

        mov [rip + _efi_image_handle], rcx;
        mov [rip + _efi_system_table], rdx;

        // Hello banner: ConOut->OutputString(ConOut, _hello_char16)
        //   rax = SystemTable*
        //   rcx = ConOut* (SystemTable + 64)
        //   rdx = &_hello_char16
        //   call [rcx + 8] (OutputString slot)
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        lea rdx, [rip + _hello_char16];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

        // R19.M3 discovery sequence.
        call efi_gop_discover;
        call efi_gop_capture;
        call efi_find_rsdp;

        // efi_get_loaded_image takes the ImageHandle in SysV rdi.
        mov rdi, [rip + _efi_image_handle];
        call efi_get_loaded_image;

        // efi_tcg2_measure_kernel(image_base, image_size).
        mov rdi, [rip + _efi_image_base];
        mov rsi, [rip + _efi_image_size];
        call efi_tcg2_measure_kernel;

        // R19.M4 (#797/#798/#799): finalize boot_env, ExitBootServices,
        // jmp kernel_main_uefi. Does not return on success — the finalizer
        // ends with a `push rax; ret` indirect jump to _kernel_main_uefi_pa
        // with RDI = &_boot_env. On failure (retries exhausted) it panics
        // via efi_panic_on_fatal. The epilogue below is unreachable on the
        // nominal path; it is retained purely as a defensive tail (if a
        // future refactor makes the finalizer return, we still restore
        // non-volatiles and hand EFI_SUCCESS back to firmware — a strictly
        // better failure mode than falling off the end of the function).
        call efi_finalize_and_handoff;

        // Defensive: return EFI_SUCCESS if finalizer ever returns.
        mov rax, 0;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rsi;
        pop rdi;
        pop rbp;
        pop rbx;
        ret
      }
    } @abi("ms") @no_frame

  // ==========================================================================
  // R19.M2 wrappers (see src/boot/uefi_locate.pdx / uefi_openproto.pdx /
  // uefi_status.pdx for the spec-heavy documentation companions).
  // ==========================================================================

  // -- efi_locate_protocol (wraps BS->LocateProtocol at BS+320) ---------------
  //
  // SysV: (guid_ptr, registration) -> status
  // MS:   RCX=Protocol, RDX=Registration, R8=&out_iface  (32B shadow + 8B align)
  pub let efi_locate_protocol : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-002 (#788). Wraps EFI_BOOT_SERVICES.LocateProtocol (UEFI 2.10 §7.3.11). Loads BS* via _efi_system_table[+96], marshals SysV RDI/RSI into MS RCX/RDX, points R8 at _efi_last_located_interface, reserves 32B shadow + 8B alignment, indirect-calls via `FF /2 [rax + 320]`. Byte-identical to src/boot/uefi_locate.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        lea r8, [rip + _efi_last_located_interface];
        sub rsp, 40;
        call [rax + 320];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_open_protocol (wraps BS->OpenProtocol at BS+280) -------------------
  //
  // SysV: (handle, guid, agent, controller, attributes) -> status
  // MS:   RCX=Handle, RDX=Protocol, R8=&out_iface, R9=AgentHandle,
  //       [rsp+0x20]=ControllerHandle, [rsp+0x28]=Attributes
  pub let efi_open_protocol : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64, attributes: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.OpenProtocol (UEFI 2.10 §7.3.9). 6-arg MS x64 dispatch (2 args spill to stack); RSP transitions 8→0 mod 16 via `sub rsp, 56`. Marshals SysV RDI/RSI/RDX/RCX/R8 into MS RCX/RDX/R9/[rsp+0x20]/[rsp+0x28] in dependency-safe order; synthesises MS R8 (&out_iface) via lea. Byte-identical to src/boot/uefi_openproto.pdx efi_open_protocol.",
      block: {
        sub rsp, 56;
        mov [rsp + 40], r8;
        mov [rsp + 32], rcx;
        mov r9, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        lea r8, [rip + _efi_last_opened_interface];
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        call [rax + 280];
        add rsp, 56;
        ret
      }
    } @no_frame

  // -- efi_close_protocol (wraps BS->CloseProtocol at BS+288) -----------------
  pub let efi_close_protocol : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.CloseProtocol (UEFI 2.10 §7.3.10). 4-arg MS x64 dispatch (all args in-registers); 32B shadow + 8B align. Byte-identical to src/boot/uefi_openproto.pdx efi_close_protocol.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        sub rsp, 40;
        call [rax + 288];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_panic_on_fatal ----------------------------------------------------
  //
  // If (status & 1<<63) set: OutputString(ConOut, message), then cli/hlt spin.
  // Else: return normally.
  pub let efi_panic_on_fatal : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (status: u64, message_ptr: u64, message_len: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-005 (#791). Conditional abort helper: on EFI error (bit 63 set), emits the caller-supplied CHAR16 banner via ConOut->OutputString (UEFI 2.10 §12.4.3) and cli/hlt spins; otherwise returns. Byte-identical to src/boot/uefi_status.pdx.",
      block: {
        mov rax, rdi;
        shr rax, 63;
        cmp rax, 0;
        je efi_panic_on_fatal_ok;

        mov rdx, rsi;
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

      efi_panic_on_fatal_spin:
        cli;
        hlt;
        jmp efi_panic_on_fatal_spin;

      efi_panic_on_fatal_ok:
        ret
      }
    } @no_frame

  // ==========================================================================
  // R19.M3 wrappers (see src/boot/uefi_gop.pdx / uefi_acpi.pdx /
  // uefi_loaded_image.pdx / uefi_tcg2.pdx for the documentation companions).
  // ==========================================================================

  // -- efi_gop_discover — LocateProtocol GOP, latch gop_this -----------------
  pub let efi_gop_discover : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-001 (#792). LocateProtocol EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, latch located interface into _efi_gop_this. Panics via efi_panic_on_fatal if LocateProtocol fails (GOP is mandatory for R19 kernel handoff). MVP: accept firmware's current mode without walking Mode->MaxMode. Byte-identical to src/boot/uefi_gop.pdx efi_gop_discover.",
      block: {
        lea rdi, [rip + _efi_graphics_output_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_gop_locate_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_gop_this], rax;
        mov rax, 0;
        ret
      }
    } @no_frame

  // -- efi_gop_capture — populate _efi_fb_desc from Mode / Mode->Info --------
  pub let efi_gop_capture : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-002 (#793). Read Mode* + Mode->Info via _efi_gop_this and write the fb_desc_t fields (base/size/pitch/width/height/format) into _efi_fb_desc. Pitch = PixelsPerScanLine * 4 (UEFI 2.10 §12.9). Stores go through SIB-form addressing (lea rdi, then mov [rdi+off], edx) to work around the paideia-as v0.20.1 encoder's RIP-relative narrow-store gap. Byte-identical to src/boot/uefi_gop.pdx efi_gop_capture.",
      block: {
        mov rax, [rip + _efi_gop_this];
        mov rcx, [rax + 24];
        lea rdi, [rip + _efi_fb_desc];
        mov rdx, [rcx + 24];
        mov [rdi + 0], rdx;
        mov rdx, [rcx + 32];
        mov [rdi + 8], rdx;
        mov r8, [rcx + 8];
        mov edx, [r8 + 32];
        shl edx, 2;
        mov [rdi + 16], edx;
        mov edx, [r8 + 4];
        mov [rdi + 20], edx;
        mov edx, [r8 + 8];
        mov [rdi + 24], edx;
        mov edx, [r8 + 12];
        mov [rdi + 28], edx;
        ret
      }
    } @no_frame

  // -- efi_find_rsdp — walk ConfigurationTable, match ACPI 2.0 GUID ---------
  pub let efi_find_rsdp : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-003 (#794). Walk EFI_SYSTEM_TABLE.ConfigurationTable[] (UEFI 2.10 §4.6.1) comparing 16-byte VendorGuid against EFI_ACPI_20_TABLE_GUID via two u64 chunks per entry; on first match return VendorTable (RSDP address) in RAX and latch to _efi_rsdp_addr, else return 0 (ACPI-absent is a valid degraded mode). Byte-identical to src/boot/uefi_acpi.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 104];
        mov rdx, [rax + 112];
        lea rsi, [rip + _efi_acpi_20_table_guid];
        mov r8, [rsi + 0];
        mov r9, [rsi + 8];
        mov rax, 0;
        cmp rcx, 0;
        je efi_find_rsdp_done;
      efi_find_rsdp_loop:
        mov r10, [rdx + 0];
        cmp r10, r8;
        jne efi_find_rsdp_skip;
        mov r10, [rdx + 8];
        cmp r10, r9;
        jne efi_find_rsdp_skip;
        mov rax, [rdx + 16];
        jmp efi_find_rsdp_done;
      efi_find_rsdp_skip:
        add rdx, 24;
        dec rcx;
        jne efi_find_rsdp_loop;
      efi_find_rsdp_done:
        mov [rip + _efi_rsdp_addr], rax;
        ret
      }
    } @no_frame

  // -- efi_get_loaded_image — OpenProtocol LoadedImage; latch base/size -----
  pub let efi_get_loaded_image : (u64) -> () !{sysreg, mem} @{} =
    fn (image_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-005 (#796). OpenProtocol on ImageHandle with EFI_LOADED_IMAGE_PROTOCOL_GUID and BY_HANDLE_PROTOCOL attribute (UEFI 2.10 §7.3.9 — no CloseProtocol pair required for BY_HANDLE_PROTOCOL applications); read ImageBase (+64) and ImageSize (+72) from the returned interface (UEFI 2.10 §9.1) and latch into _efi_image_base / _efi_image_size. Panics via efi_panic_on_fatal if OpenProtocol fails. Byte-identical to src/boot/uefi_loaded_image.pdx.",
      block: {
        mov rdx, rdi;
        lea rsi, [rip + _efi_loaded_image_protocol_guid];
        mov rcx, 0;
        mov r8, 1;
        call efi_open_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_li_open_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_opened_interface];
        mov rcx, [rax + 64];
        mov [rip + _efi_image_base], rcx;
        mov rcx, [rax + 72];
        mov [rip + _efi_image_size], rcx;
        ret
      }
    } @no_frame

  // -- efi_tcg2_measure_kernel — optional TPM measurement -------------------
  pub let efi_tcg2_measure_kernel : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_base: u64, image_size: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-004 (#795). Optional measured-boot integration. Populates a minimal EFI_TCG2_EVENT header (PCRIndex=4 EV_EFI_BOOT_SERVICES_APPLICATION, EventType=0x80000009), LocateProtocol EFI_TCG2_PROTOCOL_GUID; on EFI_NOT_FOUND (TPM absent) returns 0 silently. On success, latches _efi_tcg2_this and dispatches HashLogExtendEvent(this, 0, image_base, image_size, &_efi_tcg2_event) via `FF /2 [rax + 16]` per EFI TCG2 Protocol spec §6.2. 5-arg MS x64 dispatch — 32B shadow + 1-arg stack slot + alignment pad = sub rsp, 56. Byte-identical to src/boot/uefi_tcg2.pdx.",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        lea rcx, [rip + _efi_tcg2_event];
        mov rax, 21;
        mov [rcx + 0], eax;
        mov rax, 16;
        mov [rcx + 4], eax;
        mov rax, 1;
        mov [rcx + 8], eax;
        mov rax, 4;
        mov [rcx + 12], eax;
        mov rax, 0x80000009;
        mov [rcx + 16], eax;
        mov rax, 0;
        mov [rcx + 20], al;
        lea rdi, [rip + _efi_tcg2_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdx, 0x800000000000000E;
        cmp rax, rdx;
        jne efi_tcg2_measure_kernel_ck;
        mov rax, 0;
        ret;
      efi_tcg2_measure_kernel_ck:
        cmp rax, 0;
        je efi_tcg2_measure_kernel_have;
        ret;
      efi_tcg2_measure_kernel_have:
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_tcg2_this], rax;
        sub rsp, 56;
        lea rdx, [rip + _efi_tcg2_event];
        mov [rsp + 32], rdx;
        mov rcx, rax;
        mov rdx, 0;
        mov r8, r10;
        mov r9, r11;
        call [rcx + 16];
        add rsp, 56;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R19.M4 wrappers (see src/boot/uefi_memmap.pdx / uefi_exit.pdx / uefi_env.pdx
  // for the documentation companions).
  // ==========================================================================

  // -- efi_get_memory_map (wraps BS->GetMemoryMap at BS+56) ------------------
  //
  // 5-arg SysV → MS dispatch. Inlined from src/boot/uefi_memmap.pdx (which
  // is the authoritative documentation companion for #789). See that file
  // for the full ABI derivation.
  pub let efi_get_memory_map : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (map_size_ptr: u64, map_ptr: u64, map_key_ptr: u64, desc_size_ptr: u64, desc_ver_ptr: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-003 (#789). Wraps EFI_BOOT_SERVICES.GetMemoryMap (UEFI 2.10 §7.2.3, vtable +56). 5-argument MS x64 dispatch: 32B shadow + 8B slot for 5th arg + 8B alignment ⇒ sub rsp, 40. SysV RDI/RSI/RDX/RCX/R8 → MS RCX/RDX/R8/R9/[rsp+0x20] in dependency-safe order — SysV r8 stored to the stack slot FIRST (before r8 is overwritten as MS r8), then register moves walk in reverse arg order (r9←rcx, r8←rdx, rdx←rsi, rcx←rdi). Byte-identical to src/boot/uefi_memmap.pdx.",
      block: {
        sub rsp, 40;
        mov [rsp + 32], r8;
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        call [rax + 56];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_exit_boot_services (wraps BS->ExitBootServices at BS+232) ---------
  //
  // 2-arg SysV → MS dispatch. Byte-identical to src/boot/uefi_exit.pdx.
  pub let efi_exit_boot_services : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, map_key: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M4-002 (#798). Wraps EFI_BOOT_SERVICES.ExitBootServices (UEFI 2.10 §7.4.6, vtable +232). 2-arg MS x64 dispatch: no reshuffle hazards (RDI→RCX, RSI→RDX are non-overlapping). Loads BS* via [rip+_efi_system_table] + [rax+96], 32B shadow + 8B align (sub rsp, 40), indirect call `FF /2 [rax+232]`. Returns EFI_STATUS in RAX (EFI_SUCCESS = 0 on release; EFI_INVALID_PARAMETER = 0x8000000000000002 on stale MapKey — retry from the finalizer). CRITICAL: on EFI_SUCCESS all BS pointers become invalidated. Callers must latch RuntimeServices* into boot_env BEFORE this call. Byte-identical to src/boot/uefi_exit.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        sub rsp, 40;
        call [rax + 232];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_finalize_and_handoff — populate boot_env, EBS retry loop, jmp ----
  //
  // Called from efi_main after all M3 probes complete. Owns the last-mile
  // sequence:
  //   1. Copy magic / version / fb / rsdp / image_{base,size} / RS* into
  //      _boot_env from the M1/M2/M3-latched slots.
  //   2. Retry loop (max 3): get_memory_map into _efi_memmap_buffer,
  //      populate _boot_env's memmap fields, exit_boot_services(map_key).
  //      On EFI_SUCCESS: firmware quiescent. On any other status: refresh
  //      the map and retry.
  //   3. On exhaustion: efi_panic_on_fatal (firmware still alive — ConOut
  //      still valid, so the message reaches the screen). Non-returning.
  //   4. On success: RDI = &_boot_env; indirect jump via `push rax; ret` to
  //      the address in _kernel_main_uefi_pa. Non-returning.
  //
  // CRITICAL invariant (UEFI 2.10 §7.4.6): between the get_memory_map call
  // and the exit_boot_services call in each retry iteration, NO other
  // firmware entry may be invoked and NO allocation may occur — either
  // would advance firmware's internal map serial and invalidate the just-
  // latched MapKey. The body is written to make the invariant visually
  // obvious: only pure-memory boot_env stores appear between the two
  // firmware calls.
  //
  // Register discipline: no non-volatile saves — the finalizer does not
  // return on the nominal path, and the panic path routes through
  // efi_panic_on_fatal which halts via cli/hlt without unwinding. R15 is
  // used as the retry counter (volatile in both ABIs at this point since
  // efi_main already saved its own R15 in the entry-point prologue).
  pub let efi_finalize_and_handoff : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem }, capabilities: { boot },
      justification: "R19-M4-004 (#797/#798/#799). Populate boot_env_t (magic/version/fb/rsdp/image_base+size/runtime_services), then enter the get_memory_map ↔ exit_boot_services retry loop with the fixed 32KB _efi_memmap_buffer. On EFI_SUCCESS: firmware is quiescent, then `push _kernel_main_uefi_pa; ret` transfers control to kernel_main_uefi with RDI = &_boot_env (SysV arg 0). On EFI failure after 3 retries: efi_panic_on_fatal (fatal error status forced via bit-63-set literal, ConOut still valid pre-EBS). CRITICAL invariant: between the get_memory_map call site and the exit_boot_services call site in each iteration, no Boot Service is invoked and no allocation occurs — either would advance firmware's internal map serial and invalidate the just-latched MapKey. The body encodes this invariant structurally: only pure-memory boot_env stores appear between the two firmware calls. All narrow (32-bit) stores into _boot_env use the SIB `[rdi + off]` form to sidestep the paideia-as v0.20.1 encoder's RIP-relative narrow-store gap (established at #793 for efi_gop_capture). u32 magic-only stores are avoided by combining version(+8) and _pad(+12) into a single u64 store at offset +8.",
      block: {
        // ==================================================================
        // Phase 1: populate the boot_env_t fixed fields.
        // ==================================================================

        lea rdi, [rip + _boot_env];

        // magic (u64 @ +0) — 0x564E454244494150 = "PAIDBENV" LE (see uefi_env.pdx).
        mov rax, 0x564E454244494150;
        mov [rdi + 0], rax;

        // version (u32 @ +8) | _pad (u32 @ +12) — combined u64 store.
        // version = 1, _pad = 0 ⇒ 0x0000000000000001.
        mov rax, 1;
        mov [rdi + 8], rax;

        // fb (fb_desc_t 32 B @ +16) — copy from _efi_fb_desc via 4x u64 loads.
        lea rsi, [rip + _efi_fb_desc];
        mov rax, [rsi + 0];
        mov [rdi + 16], rax;
        mov rax, [rsi + 8];
        mov [rdi + 24], rax;
        mov rax, [rsi + 16];
        mov [rdi + 32], rax;
        mov rax, [rsi + 24];
        mov [rdi + 40], rax;

        // rsdp_pa (u64 @ +48) — from _efi_rsdp_addr (#794).
        mov rax, [rip + _efi_rsdp_addr];
        mov [rdi + 48], rax;

        // image_base (u64 @ +56) / image_size (u64 @ +64) — from #796.
        mov rax, [rip + _efi_image_base];
        mov [rdi + 56], rax;
        mov rax, [rip + _efi_image_size];
        mov [rdi + 64], rax;

        // efi_memmap_pa (u64 @ +72) — VA of the static buffer. UEFI runs
        // with identity-mapped low memory during Boot Services, so the
        // pointer to a .bss array equals its physical address at this
        // point in the boot flow. Post-EBS the kernel treats it as a PA.
        lea rax, [rip + _efi_memmap_buffer];
        mov [rdi + 72], rax;

        // runtime_services_pa (u64 @ +96) — [SystemTable + 88] before EBS
        // invalidates the ST pointer walk. Latched HERE (not in Phase 2)
        // so we don't touch the ST after the get_memory_map call.
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 88];
        mov [rdi + 96], rax;

        // ==================================================================
        // Phase 2: get_memory_map + exit_boot_services retry loop.
        // ==================================================================

        mov r15, 3;

      finalize_ebs_loop:
        // Set memmap size slot to buffer capacity (32 KB). GetMemoryMap
        // uses this as the buffer size on entry and overwrites it with the
        // actual map size on exit — so it must be reset each retry.
        lea rax, [rip + _efi_memmap_size];
        mov rdx, 32768;
        mov [rax], rdx;

        // efi_get_memory_map(&size, buffer, &key, &desc_size, &desc_ver).
        lea rdi, [rip + _efi_memmap_size];
        lea rsi, [rip + _efi_memmap_buffer];
        lea rdx, [rip + _efi_memmap_key];
        lea rcx, [rip + _efi_memmap_desc_size];
        lea r8,  [rip + _efi_memmap_desc_ver];
        call efi_get_memory_map;

        // Copy memmap-derived fields into boot_env_t. Pure-memory work —
        // does NOT invalidate the map key.
        lea rdi, [rip + _boot_env];
        mov rax, [rip + _efi_memmap_size];
        mov [rdi + 80], rax;
        // desc_size (u32 @ +88) — SIB form for narrow store.
        mov rax, [rip + _efi_memmap_desc_size];
        mov [rdi + 88], eax;
        // desc_ver (u32 @ +92) — SIB form for narrow store.
        mov rax, [rip + _efi_memmap_desc_ver];
        mov [rdi + 92], eax;

        // efi_exit_boot_services(image_handle, map_key). No calls between
        // this and the get_memory_map above; no allocation, no console.
        mov rdi, [rip + _efi_image_handle];
        mov rsi, [rip + _efi_memmap_key];
        call efi_exit_boot_services;

        cmp rax, 0;
        je  finalize_ebs_ok;

        // Retry on EFI_INVALID_PARAMETER (or any error): the MapKey has
        // been invalidated (firmware allocated between our get + exit).
        // Re-take the map and try again — capped at 3 attempts.
        dec r15;
        jne finalize_ebs_loop;

        // Retries exhausted — firmware still alive, so ConOut is still
        // valid. Panic via efi_panic_on_fatal (force bit 63 set).
        mov rdi, 0x8000000000000000;
        lea rsi, [rip + _panic_ebs_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        // efi_panic_on_fatal never returns on a set-bit-63 status —
        // it enters a cli/hlt spin. This ret is defensive.
        ret;

      finalize_ebs_ok:
        // Firmware quiescent. Only Runtime Services (via boot_env's
        // runtime_services_pa) survive. Transfer control to the kernel.
        //
        // RDI = &_boot_env (SysV arg 0 to kernel_main_uefi).
        // Indirect jump via push+ret since paideia-as v0.20.1 has no
        // `jmp r/m64` mnemonic (the encoder supports `call [mem]` for
        // firmware vtable dispatch but not `jmp reg` / `jmp [mem]`).
        // `push rax; ret` is the canonical x86_64 idiom for this and
        // costs one extra push slot (unwinds via the ret itself).
        lea rdi, [rip + _boot_env];
        mov rax, [rip + _kernel_main_uefi_pa];
        push rax;
        ret
      }
    } @no_frame
}
