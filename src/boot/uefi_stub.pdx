// src/boot/uefi_stub.pdx — R19-M1-001 (#783)
//
// PaideiaOS-native UEFI EFI application entry point. UEFI firmware invokes
// this function per the PE32+ Optional Header AddressOfEntryPoint field,
// under the Microsoft x64 calling convention (UEFI 2.10 §II-2.3.4 / §II-2.4.1).
//
// This is the *first* paideia-as-emitted PE32+ artifact in the tree —
// paideia-native from day 1, no GRUB/Multiboot2 stopgap (constitutional
// lock, design/roadmap/r18-plus-bare-metal.md §0.2 + §R19).
//
// -----------------------------------------------------------------------------
// Milestone scope (R19.M1, per design/round-retrospectives/r19-preflight.md)
// -----------------------------------------------------------------------------
//
// M1 delivers the entry-point skeleton only:
//   - Save every MS x64 non-volatile register on entry (RBX/RBP/RDI/RSI/R12-R15).
//   - Latch ImageHandle (RCX) into `_efi_image_handle`.
//   - Latch SystemTable* (RDX) into `_efi_system_table`.
//   - Restore non-volatiles and return EFI_SUCCESS (RAX=0).
//
// M1 explicitly does NOT touch:
//   - Boot Services (GetMemoryMap / AllocatePages / LocateProtocol) — M2.
//   - ConOut->OutputString "hello" fingerprint — deferred to #802 (OVMF fixture).
//   - GOP / ACPI / TPM discovery — M3.
//   - ExitBootServices + kernel_main_uefi handoff — M4.
//
// -----------------------------------------------------------------------------
// MS x64 ABI non-volatile discipline
// -----------------------------------------------------------------------------
//
// The Microsoft x64 calling convention (docs.microsoft.com "x64 calling
// convention", also UEFI 2.10 §II-2.3.4) designates the following as
// non-volatile (callee-saved):
//
//   RBX, RBP, RDI, RSI, RSP, R12, R13, R14, R15, XMM6–XMM15
//
// RSP is preserved by the epilogue's pop-symmetry. XMM6–XMM15 are not touched
// by this stub (no floating-point / vector work in the entry path). Every
// other GPR non-volatile is saved on entry and restored on exit, even though
// the M1 body only clobbers RAX + writes memory — this bakes the discipline
// in from the very first PE32+ artifact so M2+ wrappers inherit the pattern.
//
// LIFO pairing (push order = reverse of pop order):
//   push rbx; push rbp; push rdi; push rsi;
//   push r12; push r13; push r14; push r15;   ← 8 pushes × 8 B = 64 B
// ... body ...
//   pop  r15; pop  r14; pop  r13; pop  r12;
//   pop  rsi; pop  rdi; pop  rbp; pop  rbx
//
// Stack alignment: UEFI guarantees RSP ≡ 0 mod 16 at entry, +8 for the return
// address = RSP ≡ 8 mod 16 on entry to our body. 8 pushes → RSP unchanged mod 16
// (8 mod 16). This function does not CALL anything downstream (yet), so the
// 16-byte pre-CALL alignment gate is inert; M2 wrappers that CALL Boot Services
// will bump RSP by 8 before the CALL to restore 0 mod 16.
//
// -----------------------------------------------------------------------------
// @abi + @no_frame rationale
// -----------------------------------------------------------------------------
//
// @abi("ms") declares the parameter register mapping paideia-as should use
// when *this* function is called: RCX = arg0, RDX = arg1, R8 = arg2, R9 = arg3.
// The AC on #783 calls this "@naked"; the paideia-as-equivalent attribute is
// @no_frame — same semantic (no compiler-emitted prologue/epilogue, the unsafe
// block is the entire body). Nomenclature note logged for the paideia-as
// v0.21+ CHANGELOG.

module UefiStub = structure {

  // ==========================================================================
  // Global handoff slots (.data)
  // ==========================================================================
  //
  // Latched by efi_main on entry so the M2+ Boot Services wrappers can
  // recover the SystemTable pointer without dragging it through every
  // callsite as an argument. UEFI firmware guarantees these values remain
  // valid until ExitBootServices returns; after that, only the runtime-
  // services slice of SystemTable (offset +88) is still legal to touch.
  //
  // R19.M4 (ExitBootServices) will re-latch `_efi_system_table` to point
  // at the SystemTable snapshot post-transition; up to that point the
  // firmware-provided pointer is authoritative.

  pub let mut _efi_image_handle  : u64 = 0
  pub let mut _efi_system_table  : u64 = 0

  // ==========================================================================
  // efi_main — PE32+ AddressOfEntryPoint
  // ==========================================================================
  //
  // paideia-as PE emitter sets the Optional Header AddressOfEntryPoint to the
  // RVA of the first function in the first .text section (see
  // tools/paideia-as/crates/paideia-as/src/cmd_build/pe.rs:279). This module
  // defines exactly one function; it therefore lands at the entry RVA.
  // When R19.M2+ grow the stub into multiple functions, the entry-point
  // selection contract will need to be revisited (either via section
  // ordering discipline or via a paideia-as directive to pin an entry
  // symbol by name).

  pub let efi_main : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, system_table: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M1-001 (#783). UEFI PE32+ entry per UEFI 2.10 §II-2.3.4 MS x64 calling convention: RCX=ImageHandle, RDX=SystemTable*. Saves the eight MS x64 non-volatile GPRs (RBX/RBP/RDI/RSI/R12-R15) on entry per Microsoft x64 ABI contract, latches both arguments into the .data slots `_efi_image_handle`/`_efi_system_table` via rip-relative stores so M2+ wrappers can recover them, restores the non-volatiles in LIFO order, and returns EFI_SUCCESS (RAX=0). No Boot Services calls at M1; ConOut fingerprint is #802.",
      block: {
        // ---- Prologue: save all MS x64 non-volatile GPRs ----
        push rbx;
        push rbp;
        push rdi;
        push rsi;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Body: latch ImageHandle + SystemTable* into .data slots ----
        // RCX = ImageHandle (MS x64 arg0)
        // RDX = SystemTable* (MS x64 arg1)
        mov [rip + _efi_image_handle], rcx;
        mov [rip + _efi_system_table], rdx;

        // ---- Return EFI_SUCCESS ----
        mov rax, 0;

        // ---- Epilogue: restore non-volatiles in reverse order ----
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rsi;
        pop rdi;
        pop rbp;
        pop rbx;
        ret
      }
    } @abi("ms") @no_frame
}
