// src/boot/uefi_stub.pdx — R19-M1/M2/M3/M4 merged translation unit
//
// PaideiaOS-native UEFI EFI application. UEFI firmware invokes efi_main
// per the PE32+ Optional Header AddressOfEntryPoint field, under the
// Microsoft x64 calling convention (UEFI 2.10 §II-2.3.4 / §II-2.4.1).
//
// -----------------------------------------------------------------------------
// Milestone-round layering
// -----------------------------------------------------------------------------
//
// This single file is the working translation unit for the R19 pre-EBS
// boot path — paideia-as v0.20.1 build --target uefi-x86_64 accepts one
// .pdx input and does not yet fan out multi-file link (paideia-as
// enhancement pa-r19-multi-file-link, tracked in the R19 preflight
// retrospective), so the individual milestone artefacts live in sibling
// .pdx files as standalone-compilable documentation companions and this
// file INLINES their code for the actual PE emit. When the multi-file
// link mechanism lands, the sibling files become the authoritative
// definitions and this file collapses to just efi_main + the shared
// .data globals.
//
// R19.M1 (#783/#784/#785/#786) — entry-point skeleton, EFI type / offset
//   table, CHAR16 hello string, GUID literals. All landed in this file's
//   .data globals + efi_main prologue/epilogue.
//
// R19.M2 (#787-#791) — Boot Services wrappers (LocateProtocol,
//   OpenProtocol / CloseProtocol, AllocatePages, GetMemoryMap) + EFI_STATUS
//   decode + panic-on-fatal helper. Companion files under src/boot/uefi_*.pdx
//   are the spec-heavy documentation; the wrappers inlined here are byte-
//   equivalent to those docs (verified against the disassembly in each
//   companion file's preamble).
//
// R19.M3 (#792-#796) — Firmware probes: GOP framebuffer discovery /
//   capture, ACPI 2.0 RSDP walk, LoadedImage lookup, optional TCG2
//   measurement. Sibling files under src/boot/uefi_gop.pdx, uefi_acpi.pdx,
//   uefi_loaded_image.pdx, uefi_tcg2.pdx, uefi_env.pdx are the standalone-
//   compilable documentation companions; the M3 wrappers inlined below
//   are byte-equivalent to those docs.
//
// R19.M4 (#797/#798/#799/#800) — ExitBootServices + kernel handoff.
//   Extends this file with:
//     - boot_env_t slot (_boot_env, 256 B, 32B aligned; layout in
//       src/boot/uefi_env.pdx) and the efi_finalize_and_handoff pass that
//       populates it from the M1/M2/M3-latched slots plus the freshly
//       taken memory map.
//     - Static memory-map buffer (_efi_memmap_buffer, 32 KB in .bss) and
//       the four u64 out-slots (size / key / desc_size / desc_ver) that
//       efi_get_memory_map writes into.
//     - efi_get_memory_map wrapper — inlined from src/boot/uefi_memmap.pdx
//       (still authoritative documentation companion for #789).
//     - efi_exit_boot_services wrapper — inlined from src/boot/uefi_exit.pdx
//       (authoritative documentation companion for #798).
//     - efi_finalize_and_handoff — the retry-loop finalizer that owns the
//       get_memory_map ↔ exit_boot_services critical section (no console
//       output, no allocations between the two calls; MapKey refresh via
//       re-invocation of get_memory_map on EFI_INVALID_PARAMETER; capped
//       at 4 attempts per R111.M2-010 hardening — was 3, and pre-R111
//       retried on ANY non-zero status; R111.M2-010 restricts retry to
//       EFI_INVALID_PARAMETER only and bails on any other status via
//       the pre-existing efi_panic_on_fatal path).  Both terminal
//       branches (OK + 4-attempt exhaustion) emit a COM1 fingerprint
//       ("UEFI EBS OK attempts=<n>" or "UEFI EBS FAIL exhausted=4
//       last_status=0x<hex>") via the stub_com1_* / stub_u64_to_hex
//       helpers before proceeding.
//     - _kernel_main_uefi_pa placeholder — the physical address of the
//       kernel_main_uefi entry (defined in src/kernel/kernel_main_uefi.pdx,
//       linked into kernel.elf). For M4 this is a hard-coded literal
//       (KERNEL_PHYS_BASE = 0x100000) that the R19.M5 ELF loader will
//       overwrite once it has parsed kernel.elf and located the entry.
//   Post-EBS: firmware quiescent, Boot Services pointers all invalidated.
//   Only the pre-latched RuntimeServices* (boot_env_t.runtime_services_pa)
//   remains callable. The finalizer's last act is `push rax; ret` — an
//   indirect jump via the stack — with RDI already set to &_boot_env
//   (SysV arg 0) so kernel_main_uefi receives the handoff struct.
//
// -----------------------------------------------------------------------------
// Entry-point ordering
// -----------------------------------------------------------------------------
//
// The paideia-as PE emitter (tools/paideia-as/crates/paideia-as/src/
// cmd_build/pe.rs:279) sets AddressOfEntryPoint to the RVA of the first
// function in the first .text section. efi_main MUST therefore be the
// first `pub let` binding whose RHS is a Lambda in this module. All
// wrappers and helpers are defined after efi_main; the paideia-as PE
// emitter fixes forward text->text call relocations correctly (fix
// b0cb6f3 = paideia-as #1292/#1293), so efi_main can call functions that
// appear later in source order.
//
// -----------------------------------------------------------------------------
// MS x64 ABI discipline (recap; see companion files for the full audit)
// -----------------------------------------------------------------------------
//
// - UEFI 2.10 §II-2.3.4: MS x64 args in RCX/RDX/R8/R9, 5+ on stack
//   above 32-byte shadow; return in RAX; RSP ≡ 0 mod 16 immediately
//   before CALL. Non-volatile GPRs: RBX/RBP/RDI/RSI/RSP/R12-R15,
//   XMM6-XMM15.
// - Paideia (SysV): args in RDI/RSI/RDX/RCX/R8/R9. Wrappers reshuffle
//   SysV -> MS in dependency-safe order before dispatching to firmware.
// - efi_main is @abi("ms") — its caller (firmware) uses MS x64. All
//   other functions in this file are default SysV; the wrappers marshal
//   at the boundary.

module UefiStub = structure {

  // ==========================================================================
  // .data slots
  // ==========================================================================

  // Latched by efi_main from firmware-provided arguments.
  pub let mut _efi_image_handle  : u64 = 0
  pub let mut _efi_system_table  : u64 = 0

  // Out-parameter latches for the Boot Services wrappers.
  pub let mut _efi_last_located_interface : u64 = 0
  pub let mut _efi_last_opened_interface  : u64 = 0

  // R19.M3 discovery result slots.
  pub let mut _efi_gop_this   : u64 = 0
  pub let mut _efi_tcg2_this  : u64 = 0
  pub let mut _efi_rsdp_addr  : u64 = 0
  pub let mut _efi_image_base : u64 = 0
  pub let mut _efi_image_size : u64 = 0

  // Framebuffer descriptor — 32 B (fb_desc_t, uefi_env.pdx layout).
  pub let mut _efi_fb_desc : [u64; 4] = uninit @align(8)

  // TCG2 event scratch — 24 B (only first 21 used; see uefi_tcg2.pdx).
  pub let mut _efi_tcg2_event : [u64; 3] = uninit @align(8)

  // R19.M4 (#797/#798/#800) slots.

  // boot_env_t — 256 B, 32-byte aligned. Layout in src/boot/uefi_env.pdx.
  // Populated by efi_finalize_and_handoff and passed to kernel_main_uefi
  // in RDI (SysV arg 0) after ExitBootServices returns EFI_SUCCESS.
  pub let mut _boot_env : [u64; 32] = uninit @align(32)

  // Memory-map buffer (#798). Fixed 32 KB in .bss (EfiLoaderData —
  // survives ExitBootServices). Big enough for OVMF's typical ~200
  // descriptor × 48 B ≈ 10 KB output with headroom for the +2 descriptors
  // firmware may add between the probe call and the exit call. If a real
  // firmware overflows this, ExitBootServices will fail 3× with a stale
  // key and the finalizer will panic — the check surfaces as a build-time
  // hazard for that firmware, tracked as follow-up "uefi-memmap-dynalloc"
  // in the R19.M4 retrospective (pre-EBS AllocatePages instead of static).
  pub let mut _efi_memmap_buffer : [u64; 4096] = uninit @align(4096)

  // efi_get_memory_map out-slot latches (5 args, all OUT). Values consumed
  // by the finalizer + copied into boot_env_t.
  pub let mut _efi_memmap_size      : u64 = 0
  pub let mut _efi_memmap_key       : u64 = 0
  pub let mut _efi_memmap_desc_size : u64 = 0
  pub let mut _efi_memmap_desc_ver  : u64 = 0

  // R19.M4 (#799) — kernel_main_uefi entry point (physical address).
  //
  // For M4 this is a hard-coded placeholder (KERNEL_PHYS_BASE = 0x100000).
  // The R19.M5 ELF loader will:
  //   (a) parse kernel.elf's symbol table for kernel_main_uefi's VMA
  //   (b) compute its LMA via the link.ld VMA/LMA rule
  //   (c) rewrite this .data slot with the real PA
  // Until then, the .efi's jmp is symbolic — running it will land on
  // whatever occupies 0x100000 in the loaded firmware's memory (typically
  // firmware code or the loaded kernel image if OVMF has already staged
  // it via LoadImage). The wiring is correct; the target is placeholder.
  pub let mut _kernel_main_uefi_pa : u64 = 0x100000

  //   "EBS fail retries exhausted\r\n\0"  (28 + NUL = 29)
  //
  // R111.M2-010 (paideia-os #2362) semantic note: with the harden landed,
  // the retry loop retries ONLY on EFI_INVALID_PARAMETER (stale MapKey);
  // any OTHER non-zero EFI_STATUS bails immediately through
  // efi_panic_on_fatal via this message.  The wording is retained
  // verbatim (kept as ConOut CHAR16 pre-EBS log; no fingerprint gate
  // consumes it) so as not to disturb any operator-facing log baselines;
  // the R111.M2-010 fingerprint path is a separate COM1 emit
  // ("UEFI EBS FAIL exhausted=4 last_status=0x<..>") triggered only on
  // the 4-attempt exhaustion path.
  pub let _panic_ebs_msg : [u16; 29] = [
     69,  66,  83,  32, 102,  97, 105, 108,  32, 114,
    101, 116, 114, 105, 101, 115,  32, 101, 120, 104,
     97, 117, 115, 116, 101, 100,  13,  10,   0
  ]

  // ==========================================================================
  // R111.M2-010 (paideia-os #2362) — EBS retry-hardening fingerprint tags.
  // ==========================================================================
  //
  // Insyde H2O firmware on the T14 G4 has been observed to return
  // EFI_INVALID_PARAMETER (0x8000000000000002) from ExitBootServices when
  // the MapKey we hold has been invalidated by an intervening
  // AllocatePages that firmware itself performed between our
  // GetMemoryMap probe and our ExitBootServices call.  The UEFI 2.10 §7.4.6
  // canonical workaround is a bounded retry loop that re-invokes
  // GetMemoryMap to refresh the key.  Original implementation capped at
  // 3 attempts and retried on ANY non-zero status; R111.M2-010 tightens
  // both bounds:
  //
  //   * Max 4 attempts (up from 3) — matches the empirical Insyde retry
  //     depth observed on H2O firmware batches that stress-alloc between
  //     our probe + exit.
  //   * Retry ONLY on EFI_INVALID_PARAMETER — any other status is
  //     non-retriable (per UEFI 2.10 §7.4.6 error table) and bailing
  //     immediately through the existing efi_panic_on_fatal path is
  //     correct.
  //
  // Both terminal paths emit a COM1 fingerprint before proceeding:
  //
  //   Success: "UEFI EBS OK attempts=<n>\r\n"       (n in 1..4)
  //   Failure: "UEFI EBS FAIL exhausted=4 last_status=0x<16hex>\r\n"
  //
  // Emit path is direct-to-COM1 (stub_com1_init + stub_com1_puts +
  // stub_u64_to_hex, all local to this module) because on the OK path
  // firmware is quiescent (Boot Services pointers invalidated) and on
  // the FAIL path the fingerprint gate scans the COM1 wire — ConOut
  // is not captured by tools/verify-fingerprint-coverage.sh.
  //
  // Allowlisted in tools/verify-fingerprint-coverage.sh alongside
  // "UEFI BRIDGE OK" / "UEFI PML4 OK" until the R111.M2 OVMF smoke mode
  // opens a fixture that asserts these against a live golden.

  //   "UEFI EBS OK"  (11 bytes; carries the OK fingerprint token)
  //
  // Broken out from the " attempts=" separator so the OK-bearing header
  // lands in a dedicated byte-array declaration — matching the
  // "UEFI BRIDGE OK" / "UEFI PML4 OK" convention that
  // tools/verify-fingerprint-coverage.sh's ALLOWLIST keys shadow
  // exactly.  The " attempts=" separator does NOT contain the OK token
  // and is therefore invisible to the fingerprint-coverage extractor.
  pub let _ebs_ok_hdr : [u8; 11] = [
    0x55u8, 0x45u8, 0x46u8, 0x49u8, 0x20u8,             // "UEFI "
    0x45u8, 0x42u8, 0x53u8, 0x20u8,                     // "EBS "
    0x4Fu8, 0x4Bu8                                      // "OK"
  ]

  //   " attempts="  (10 bytes; separator, no OK token)
  pub let _ebs_ok_attempts_tag : [u8; 10] = [
    0x20u8, 0x61u8, 0x74u8, 0x74u8, 0x65u8,             // " atte"
    0x6Du8, 0x70u8, 0x74u8, 0x73u8, 0x3Du8              // "mpts="
  ]

  //   "UEFI EBS FAIL exhausted=4 last_status="  (38 bytes)
  //
  // Contains no OK token — the fingerprint-coverage extractor will not
  // pick it up, so no ALLOWLIST entry is required (and adding one
  // would trigger the stale-allowlist gate).  The line is nevertheless
  // greppable by future OVMF / real-HW smoke fixtures that assert on
  // the exact prefix.
  pub let _ebs_fail_prefix : [u8; 38] = [
    0x55u8, 0x45u8, 0x46u8, 0x49u8, 0x20u8,             // "UEFI "
    0x45u8, 0x42u8, 0x53u8, 0x20u8,                     // "EBS "
    0x46u8, 0x41u8, 0x49u8, 0x4Cu8, 0x20u8,             // "FAIL "
    0x65u8, 0x78u8, 0x68u8, 0x61u8, 0x75u8,             // "exhau"
    0x73u8, 0x74u8, 0x65u8, 0x64u8, 0x3Du8,             // "sted="
    0x34u8, 0x20u8,                                     // "4 "
    0x6Cu8, 0x61u8, 0x73u8, 0x74u8, 0x5Fu8,             // "last_"
    0x73u8, 0x74u8, 0x61u8, 0x74u8, 0x75u8,             // "statu"
    0x73u8, 0x3Du8                                      // "s="
  ]

  //   CRLF terminator (2 bytes)
  pub let _ebs_crlf : [u8; 2] = [
    0x0Du8, 0x0Au8
  ]

  // Scratch buffers.  _ebs_hex_scratch is oversized by 6 (u64_to_hex
  // writes exactly 18 bytes; 24 rounds to the next 8-byte @align).
  // _ebs_digit_scratch holds the single ASCII digit ('1'..'4') for the
  // OK path, 8-byte aligned for @align uniformity.
  pub let mut _ebs_hex_scratch   : [u8; 24] = uninit @align(8)
  pub let mut _ebs_digit_scratch : [u8; 8]  = uninit @align(8)

  // Latched EFI_STATUS from the most recent non-zero ExitBootServices
  // return.  Only meaningful on the failure paths (exhaustion + generic
  // panic); reset implicitly per boot by .bss zero-init and overwritten
  // on the first failing attempt in a given retry loop invocation.
  pub let mut _ebs_last_status   : u64 = 0

  // ==========================================================================
  // CHAR16 message literals (UTF-16 LE via [u16; N] with trailing NUL)
  // ==========================================================================
  //
  // Encoded ASCII -> CHAR16 per src/boot/uefi_strings.pdx recipe: each byte
  // c in 0..0x7F maps to the u16 c which lands on disk as [c, 0x00] on
  // little-endian x86_64. All messages are NUL-terminated (OutputString
  // walks until U+0000 per UEFI 2.10 §II-4).

  //   "paideia boot: entry ok\r\n\0"  (24 chars + NUL = 25 u16)
  pub let _hello_char16 : [u16; 25] = [
    112,  97, 105, 100, 101, 105,  97,  32,
     98, 111, 111, 116,  58,  32,
    101, 110, 116, 114, 121,  32,
    111, 107,  13,  10,   0
  ]

  //   "GOP locate fail\r\n\0"  (17 + NUL = 18)
  pub let _panic_gop_locate_msg : [u16; 18] = [
     71,  79,  80,  32, 108, 111,  99,  97, 116, 101,
     32, 102,  97, 105, 108,  13,  10,   0
  ]

  //   "LoadedImage open fail\r\n\0"  (23 + NUL = 24)
  pub let _panic_li_open_msg : [u16; 24] = [
     76, 111,  97, 100, 101, 100,  73, 109,  97, 103,
    101,  32, 111, 112, 101, 110,  32, 102,  97, 105,
    108,  13,  10,   0
  ]

  // ==========================================================================
  // Protocol / configuration-table GUIDs
  // ==========================================================================
  //
  // See src/boot/uefi_guids.pdx for the byte-encoding derivation from the
  // printed GUID forms. Byte-for-byte identical to that reference file.

  //   9042A9DE-23DC-4A38-96FB-7ADED080516A
  pub let _efi_graphics_output_protocol_guid : [u8; 16] = [
    0xDEu8, 0xA9u8, 0x42u8, 0x90u8,
    0xDCu8, 0x23u8, 0x38u8, 0x4Au8,
    0x96u8, 0xFBu8, 0x7Au8, 0xDEu8,
    0xD0u8, 0x80u8, 0x51u8, 0x6Au8
  ]

  //   8868E871-E4F1-11D3-BC22-0080C73C8881
  pub let _efi_acpi_20_table_guid : [u8; 16] = [
    0x71u8, 0xE8u8, 0x68u8, 0x88u8,
    0xF1u8, 0xE4u8, 0xD3u8, 0x11u8,
    0xBCu8, 0x22u8, 0x00u8, 0x80u8,
    0xC7u8, 0x3Cu8, 0x88u8, 0x81u8
  ]

  //   607F766C-7455-42BE-930B-E4D76DB2720F
  pub let _efi_tcg2_protocol_guid : [u8; 16] = [
    0x6Cu8, 0x76u8, 0x7Fu8, 0x60u8,
    0x55u8, 0x74u8, 0xBEu8, 0x42u8,
    0x93u8, 0x0Bu8, 0xE4u8, 0xD7u8,
    0x6Du8, 0xB2u8, 0x72u8, 0x0Fu8
  ]

  //   5B1B31A1-9562-11D2-8E3F-00A0C969723B
  pub let _efi_loaded_image_protocol_guid : [u8; 16] = [
    0xA1u8, 0x31u8, 0x1Bu8, 0x5Bu8,
    0x62u8, 0x95u8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x3Fu8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  // ==========================================================================
  // R111.M3-013 (paideia-os #2365) — initrd load GUIDs + storage
  // ==========================================================================
  //
  // The initrd load path (efi_load_initrd, below) needs two GUIDs the
  // R19.M2/M3 wave never landed:
  //
  //   * EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_GUID  (UEFI 2.10 §13.4)
  //     964E5B22-6459-11D2-8E39-00A0C969723B
  //     OpenProtocol on LoadedImage->DeviceHandle returns the volume
  //     protocol; SFS.OpenVolume returns the root EFI_FILE handle.
  //
  //   * EFI_FILE_INFO_ID_GUID                (UEFI 2.10 §13.5.16)
  //     09576E92-6D3F-11D2-8E39-00A0C969723B
  //     Passed to EFI_FILE.GetInfo as the InfoType selector so the
  //     out-buffer receives an EFI_FILE_INFO struct (with FileSize
  //     at +8) rather than any of the other typed-info variants.
  //
  // Byte-encoding rules per src/boot/uefi_guids.pdx: first three
  // fields (u32, u16, u16) are little-endian in memory; the last
  // eight bytes are printed in big-endian order.

  //   964E5B22-6459-11D2-8E39-00A0C969723B
  pub let _efi_simple_fs_protocol_guid : [u8; 16] = [
    0x22u8, 0x5Bu8, 0x4Eu8, 0x96u8,
    0x59u8, 0x64u8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x39u8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  //   09576E92-6D3F-11D2-8E39-00A0C969723B
  pub let _efi_file_info_id_guid : [u8; 16] = [
    0x92u8, 0x6Eu8, 0x57u8, 0x09u8,
    0x3Fu8, 0x6Du8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x39u8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  // Fixed path L"\EFI\PAIDEIA\rootfs.pdxfs\0" — CHAR16, NUL-terminated
  // per UEFI 2.10 §13.5.2 (Open walks until U+0000).  25 chars + NUL =
  // 26 u16 entries.  The leading '\' is the UEFI path separator
  // (§13.5); path is rooted at the volume the SFS OpenVolume returned.
  //
  //  \  E  F  I  \  P  A  I  D  E   I   A   \   r   o   o   t   f   s   .   p   d   x   f   s  NUL
  //  92 69 70 73 92 80 65 73 68 69 73 65 92 114 111 111 116 102 115  46 112 100 120 102 115  0
  pub let _efi_initrd_path : [u16; 26] = [
     92u16, 69u16, 70u16, 73u16, 92u16,
     80u16, 65u16, 73u16, 68u16, 69u16,
     73u16, 65u16, 92u16,
    114u16, 111u16, 111u16, 116u16, 102u16, 115u16,
     46u16, 112u16, 100u16, 120u16, 102u16, 115u16,
      0u16
  ]

  // Latches populated by efi_load_initrd on the OK path; left at
  // .bss zero on any failure along the load chain.  Copied verbatim
  // into _boot_env at BOOT_ENV_OFFSET_INITRD_PA / _SIZE (+104 / +112)
  // by efi_finalize_and_handoff's Phase 1 (see file header + uefi_env.
  // pdx for the layout narrative).
  pub let mut _efi_initrd_pa   : u64 = 0
  pub let mut _efi_initrd_size : u64 = 0

  // Out-slots for the three per-file-op protocol calls this pass makes.
  // All three are 8-byte scalars firmware writes on OpenVolume / Open
  // success; kept in .bss so RIP-relative &out addressing is trivial
  // for the MS x64 marshalling below.  Reused across attempts (a fresh
  // efi_load_initrd invocation overwrites them; there is only ever one
  // invocation per boot).
  pub let mut _efi_initrd_root_handle : u64 = 0
  pub let mut _efi_initrd_file_handle : u64 = 0
  pub let mut _efi_initrd_pool_buf    : u64 = 0

  // GetInfo scratch: EFI_FILE_INFO fixed header is 80 bytes (Size,
  // FileSize, PhysicalSize, three EFI_TIME @ 16 B each, Attribute) and
  // the FileName that follows is variable-length CHAR16.  512 bytes
  // covers header + up to ~200-char filename — more than enough for
  // our fixed 25-char path.  If firmware asks for more via
  // EFI_BUFFER_TOO_SMALL (5), we treat that as a load failure and bail.
  // _efi_initrd_info_size is the IN/OUT byte count: reset to 512 before
  // each GetInfo call, then updated by firmware with the actual size.
  pub let mut _efi_initrd_info_scratch : [u8; 512] = uninit @align(8)
  pub let mut _efi_initrd_info_size    : u64 = 512

  // Read IN/OUT byte count: set to FileSize before EFI_FILE.Read, then
  // updated by firmware with the actual bytes read.  Kept as a
  // dedicated slot rather than reusing _efi_initrd_info_size because
  // the two calls are sequential but the value discipline (info_size
  // must remain valid across GetInfo, then Read overwrites its own
  // slot) is clearer with separate storage.
  pub let mut _efi_initrd_read_size : u64 = 0

  // ==========================================================================
  // efi_main — PE32+ AddressOfEntryPoint (MS x64 ABI)
  // ==========================================================================
  //
  // MUST be the first function-typed `pub let` in this module (see file
  // preamble under "Entry-point ordering"). Orchestrates the R19.M1+M2+M3
  // pre-ExitBootServices flow:
  //
  //   1. Save MS x64 non-volatile GPRs.
  //   2. Latch ImageHandle (RCX) and SystemTable* (RDX) into .data slots.
  //   3. Print the R19.M1 hello fingerprint via ConOut->OutputString.
  //   4. Run the R19.M3 discovery sequence in strict order:
  //        efi_gop_discover -> efi_gop_capture -> efi_find_rsdp
  //        -> efi_get_loaded_image -> efi_tcg2_measure_kernel
  //   5. Restore non-volatiles and return EFI_SUCCESS.
  //
  // R19.M4 (ExitBootServices + kernel handoff) will replace step 5 with a
  // handoff sequence; the current .efi is a "print and probe" artefact
  // that returns to firmware so operators can inspect the console banner
  // + inspect the discovery-result .data slots post-return.

  pub let efi_main : (u64, u64) -> u64 !{sysreg, mem, PortIo} @{} =
    fn (image_handle: u64, system_table: u64) -> unsafe {
      effects: { sysreg, mem, PortIo },
      capabilities: { paideia.port_io },
      justification: "R19.M1+M2+M3 (#783/#784/#785/#786/#787-#791/#792-#796) + R111.M2-010 (paideia-os #2362) — effect/capability set extended to {sysreg, mem, PortIo} / {paideia.port_io} so the PortIo effect + paideia.port_io capability transitively demanded by efi_finalize_and_handoff (which now drives COM1 directly for the OK / FAIL fingerprint emit paths via stub_com1_init / stub_com1_puts / stub_u64_to_hex) can flow through this outer call site.  UEFI PE32+ entry per UEFI 2.10 §II-2.3.4 MS x64 calling convention: RCX=ImageHandle, RDX=SystemTable*. Saves the eight MS x64 non-volatile GPRs on entry, latches both arguments into .data slots (_efi_image_handle/_efi_system_table), emits the R19.M1 hello banner via ConOut->OutputString (UEFI 2.10 §12.4.3), then dispatches the R19.M3 discovery sequence in strict order: efi_gop_discover -> efi_gop_capture -> efi_find_rsdp -> efi_get_loaded_image -> efi_tcg2_measure_kernel. Restores non-volatiles in LIFO order and returns EFI_SUCCESS (RAX=0). Non-fatal probes (efi_find_rsdp, efi_tcg2_measure_kernel) do not gate the return; fatal probes (efi_gop_discover, efi_get_loaded_image) invoke efi_panic_on_fatal internally and never return to us. Stack discipline: entry with RSP ≡ 8 mod 16 (UEFI 2.10 §II-2.3.4); 8 pushes leave RSP ≡ 8 mod 16; every downstream call is either a SysV-default helper (which manages its own stack) or an MS-x64 wrapper (which manages its own shadow + alignment fixup), so no additional sub rsp is needed in this outer function; the pushes/pops balance across the whole body.",
      block: {
        push rbx;
        push rbp;
        push rdi;
        push rsi;
        push r12;
        push r13;
        push r14;
        push r15;

        mov [rip + _efi_image_handle], rcx;
        mov [rip + _efi_system_table], rdx;

        // Hello banner: ConOut->OutputString(ConOut, _hello_char16)
        //   rax = SystemTable*
        //   rcx = ConOut* (SystemTable + 64)
        //   rdx = &_hello_char16
        //   call [rcx + 8] (OutputString slot)
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        lea rdx, [rip + _hello_char16];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

        // R19.M3 discovery sequence.
        call efi_gop_discover;
        call efi_gop_capture;
        call efi_find_rsdp;

        // efi_get_loaded_image takes the ImageHandle in SysV rdi.
        mov rdi, [rip + _efi_image_handle];
        call efi_get_loaded_image;

        // R111.M3-013 (paideia-os #2365): after LoadedImage returns,
        // try to load L"\EFI\PAIDEIA\rootfs.pdxfs" from the boot
        // volume via EFI_SIMPLE_FILE_SYSTEM_PROTOCOL on the LoadedImage
        // DeviceHandle (@+24 in the interface struct per UEFI 2.10
        // §9.1).  On success, latches (buffer_pa, file_size) into
        // _efi_initrd_pa / _efi_initrd_size which efi_finalize_and_
        // handoff copies into _boot_env at +104 / +112.  On any
        // failure along the SFS/Open/GetInfo/AllocatePool/Read chain,
        // the latches stay .bss-zero and the kernel-side witness
        // (rootfs_mount_witness) emits ROOTFS MOUNT NONE — preserving
        // the pre-R111 tmpfs-root behavior on every non-blob boot.
        //
        // DeviceHandle is at offset +24 in EFI_LOADED_IMAGE_PROTOCOL
        // (Revision, ParentHandle, SystemTable, DeviceHandle — see the
        // UEFI 2.10 §9.1 struct); efi_get_loaded_image latched the
        // interface pointer into _efi_last_opened_interface.
        mov rax, [rip + _efi_last_opened_interface];
        mov rdi, [rax + 24];
        call efi_load_initrd;

        // efi_tcg2_measure_kernel(image_base, image_size).
        mov rdi, [rip + _efi_image_base];
        mov rsi, [rip + _efi_image_size];
        call efi_tcg2_measure_kernel;

        // R19.M4 (#797/#798/#799): finalize boot_env, ExitBootServices,
        // jmp kernel_main_uefi. Does not return on success — the finalizer
        // ends with a `push rax; ret` indirect jump to _kernel_main_uefi_pa
        // with RDI = &_boot_env. On failure (retries exhausted) it panics
        // via efi_panic_on_fatal. The epilogue below is unreachable on the
        // nominal path; it is retained purely as a defensive tail (if a
        // future refactor makes the finalizer return, we still restore
        // non-volatiles and hand EFI_SUCCESS back to firmware — a strictly
        // better failure mode than falling off the end of the function).
        call efi_finalize_and_handoff;

        // Defensive: return EFI_SUCCESS if finalizer ever returns.
        mov rax, 0;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rsi;
        pop rdi;
        pop rbp;
        pop rbx;
        ret
      }
    } @abi("ms") @no_frame

  // ==========================================================================
  // R19.M2 wrappers (see src/boot/uefi_locate.pdx / uefi_openproto.pdx /
  // uefi_status.pdx for the spec-heavy documentation companions).
  // ==========================================================================

  // -- efi_locate_protocol (wraps BS->LocateProtocol at BS+320) ---------------
  //
  // SysV: (guid_ptr, registration) -> status
  // MS:   RCX=Protocol, RDX=Registration, R8=&out_iface  (32B shadow + 8B align)
  pub let efi_locate_protocol : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (guid_ptr: u64, registration: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-002 (#788). Wraps EFI_BOOT_SERVICES.LocateProtocol (UEFI 2.10 §7.3.11). Loads BS* via _efi_system_table[+96], marshals SysV RDI/RSI into MS RCX/RDX, points R8 at _efi_last_located_interface, reserves 32B shadow + 8B alignment, indirect-calls via `FF /2 [rax + 320]`. Byte-identical to src/boot/uefi_locate.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        lea r8, [rip + _efi_last_located_interface];
        sub rsp, 40;
        call [rax + 320];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_open_protocol (wraps BS->OpenProtocol at BS+280) -------------------
  //
  // SysV: (handle, guid, agent, controller, attributes) -> status
  // MS:   RCX=Handle, RDX=Protocol, R8=&out_iface, R9=AgentHandle,
  //       [rsp+0x20]=ControllerHandle, [rsp+0x28]=Attributes
  pub let efi_open_protocol : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64, attributes: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.OpenProtocol (UEFI 2.10 §7.3.9). 6-arg MS x64 dispatch (2 args spill to stack); RSP transitions 8→0 mod 16 via `sub rsp, 56`. Marshals SysV RDI/RSI/RDX/RCX/R8 into MS RCX/RDX/R9/[rsp+0x20]/[rsp+0x28] in dependency-safe order; synthesises MS R8 (&out_iface) via lea. Byte-identical to src/boot/uefi_openproto.pdx efi_open_protocol.",
      block: {
        sub rsp, 56;
        mov [rsp + 40], r8;
        mov [rsp + 32], rcx;
        mov r9, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        lea r8, [rip + _efi_last_opened_interface];
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        call [rax + 280];
        add rsp, 56;
        ret
      }
    } @no_frame

  // -- efi_close_protocol (wraps BS->CloseProtocol at BS+288) -----------------
  pub let efi_close_protocol : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-004 (#790). Wraps EFI_BOOT_SERVICES.CloseProtocol (UEFI 2.10 §7.3.10). 4-arg MS x64 dispatch (all args in-registers); 32B shadow + 8B align. Byte-identical to src/boot/uefi_openproto.pdx efi_close_protocol.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        sub rsp, 40;
        call [rax + 288];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_panic_on_fatal ----------------------------------------------------
  //
  // If (status & 1<<63) set: OutputString(ConOut, message), then cli/hlt spin.
  // Else: return normally.
  pub let efi_panic_on_fatal : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (status: u64, message_ptr: u64, message_len: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-005 (#791). Conditional abort helper: on EFI error (bit 63 set), emits the caller-supplied CHAR16 banner via ConOut->OutputString (UEFI 2.10 §12.4.3) and cli/hlt spins; otherwise returns. Byte-identical to src/boot/uefi_status.pdx.",
      block: {
        mov rax, rdi;
        shr rax, 63;
        cmp rax, 0;
        je efi_panic_on_fatal_ok;

        mov rdx, rsi;
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 64];
        sub rsp, 40;
        call [rcx + 8];
        add rsp, 40;

      efi_panic_on_fatal_spin:
        cli;
        hlt;
        jmp efi_panic_on_fatal_spin;

      efi_panic_on_fatal_ok:
        ret
      }
    } @no_frame

  // ==========================================================================
  // R19.M3 wrappers (see src/boot/uefi_gop.pdx / uefi_acpi.pdx /
  // uefi_loaded_image.pdx / uefi_tcg2.pdx for the documentation companions).
  // ==========================================================================

  // -- efi_gop_discover — LocateProtocol GOP, latch gop_this -----------------
  pub let efi_gop_discover : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-001 (#792). LocateProtocol EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, latch located interface into _efi_gop_this. Panics via efi_panic_on_fatal if LocateProtocol fails (GOP is mandatory for R19 kernel handoff). MVP: accept firmware's current mode without walking Mode->MaxMode. Byte-identical to src/boot/uefi_gop.pdx efi_gop_discover.",
      block: {
        lea rdi, [rip + _efi_graphics_output_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_gop_locate_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_gop_this], rax;
        mov rax, 0;
        ret
      }
    } @no_frame

  // -- efi_gop_capture — populate _efi_fb_desc from Mode / Mode->Info --------
  pub let efi_gop_capture : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-002 (#793). Read Mode* + Mode->Info via _efi_gop_this and write the fb_desc_t fields (base/size/pitch/width/height/format) into _efi_fb_desc. Pitch = PixelsPerScanLine * 4 (UEFI 2.10 §12.9). Stores go through SIB-form addressing (lea rdi, then mov [rdi+off], edx) to work around the paideia-as v0.20.1 encoder's RIP-relative narrow-store gap. Byte-identical to src/boot/uefi_gop.pdx efi_gop_capture.",
      block: {
        mov rax, [rip + _efi_gop_this];
        mov rcx, [rax + 24];
        lea rdi, [rip + _efi_fb_desc];
        mov rdx, [rcx + 24];
        mov [rdi + 0], rdx;
        mov rdx, [rcx + 32];
        mov [rdi + 8], rdx;
        mov r8, [rcx + 8];
        mov edx, [r8 + 32];
        shl edx, 2;
        mov [rdi + 16], edx;
        mov edx, [r8 + 4];
        mov [rdi + 20], edx;
        mov edx, [r8 + 8];
        mov [rdi + 24], edx;
        mov edx, [r8 + 12];
        mov [rdi + 28], edx;
        ret
      }
    } @no_frame

  // -- efi_find_rsdp — walk ConfigurationTable, match ACPI 2.0 GUID ---------
  pub let efi_find_rsdp : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R19-M3-003 (#794). Walk EFI_SYSTEM_TABLE.ConfigurationTable[] (UEFI 2.10 §4.6.1) comparing 16-byte VendorGuid against EFI_ACPI_20_TABLE_GUID via two u64 chunks per entry; on first match return VendorTable (RSDP address) in RAX and latch to _efi_rsdp_addr, else return 0 (ACPI-absent is a valid degraded mode). Byte-identical to src/boot/uefi_acpi.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rcx, [rax + 104];
        mov rdx, [rax + 112];
        lea rsi, [rip + _efi_acpi_20_table_guid];
        mov r8, [rsi + 0];
        mov r9, [rsi + 8];
        mov rax, 0;
        cmp rcx, 0;
        je efi_find_rsdp_done;
      efi_find_rsdp_loop:
        mov r10, [rdx + 0];
        cmp r10, r8;
        jne efi_find_rsdp_skip;
        mov r10, [rdx + 8];
        cmp r10, r9;
        jne efi_find_rsdp_skip;
        mov rax, [rdx + 16];
        jmp efi_find_rsdp_done;
      efi_find_rsdp_skip:
        add rdx, 24;
        dec rcx;
        jne efi_find_rsdp_loop;
      efi_find_rsdp_done:
        mov [rip + _efi_rsdp_addr], rax;
        ret
      }
    } @no_frame

  // -- efi_get_loaded_image — OpenProtocol LoadedImage; latch base/size -----
  pub let efi_get_loaded_image : (u64) -> () !{sysreg, mem} @{} =
    fn (image_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-005 (#796). OpenProtocol on ImageHandle with EFI_LOADED_IMAGE_PROTOCOL_GUID and BY_HANDLE_PROTOCOL attribute (UEFI 2.10 §7.3.9 — no CloseProtocol pair required for BY_HANDLE_PROTOCOL applications); read ImageBase (+64) and ImageSize (+72) from the returned interface (UEFI 2.10 §9.1) and latch into _efi_image_base / _efi_image_size. Panics via efi_panic_on_fatal if OpenProtocol fails. Byte-identical to src/boot/uefi_loaded_image.pdx.",
      block: {
        mov rdx, rdi;
        lea rsi, [rip + _efi_loaded_image_protocol_guid];
        mov rcx, 0;
        mov r8, 1;
        call efi_open_protocol;
        mov rdi, rax;
        lea rsi, [rip + _panic_li_open_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        mov rax, [rip + _efi_last_opened_interface];
        mov rcx, [rax + 64];
        mov [rip + _efi_image_base], rcx;
        mov rcx, [rax + 72];
        mov [rip + _efi_image_size], rcx;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R111.M3-013 (paideia-os #2365) — efi_load_initrd
  // ==========================================================================
  //
  // Best-effort loader for the ESP-embedded PdxFS-lite root blob at the
  // fixed path L"\EFI\PAIDEIA\rootfs.pdxfs".  On success, latches
  // (allocated_pool_pa, file_size) into _efi_initrd_pa / _efi_initrd_size
  // (Phase 1 of efi_finalize_and_handoff then copies both into
  // _boot_env at +104 / +112 per src/boot/uefi_env.pdx).  On ANY failure
  // along the load chain — no SFS protocol on DeviceHandle, path
  // missing, permission-denied, GetInfo/Read/AllocatePool refused,
  // short read — the latches stay .bss-zero, the finalizer stores
  // zeros into boot_env, and the kernel-side witness
  // (src/kernel/boot/witness/rootfs_mount_witness.pdx) emits
  // ROOTFS MOUNT NONE, preserving the pre-R111 tmpfs-root behavior.
  //
  // Load chain (each step MS x64 → SysV marshalling per the file
  // preamble):
  //
  //   1. OpenProtocol(DeviceHandle, SFS_GUID, 0, 0, BY_HANDLE_PROTOCOL=1)
  //      via the existing efi_open_protocol SysV wrapper.  On success
  //      latches the SFS interface into _efi_last_opened_interface.
  //   2. sfs->OpenVolume(sfs, &_efi_initrd_root_handle)  — vtable +8
  //   3. root->Open(root, &_efi_initrd_file_handle, path, MODE_READ=1,
  //                 attributes=0)  — vtable +8
  //   4. file->GetInfo(file, &FILE_INFO_ID_GUID, &_efi_initrd_info_size,
  //                    _efi_initrd_info_scratch)  — vtable +64
  //      Reads FileSize @+8 within EFI_FILE_INFO.
  //   5. BS->AllocatePool(EfiLoaderData=2, size, &_efi_initrd_pool_buf)
  //      — vtable +64 on the BS table.
  //   6. file->Read(file, &_efi_initrd_read_size, pool_buf)  — vtable +32
  //   7. Verify bytes-read == file_size (short-read defensive gate).
  //
  // No explicit cleanup: firmware handles + pool alloc are all
  // survived by ExitBootServices in Phase 2 of the finalizer — the
  // pool buffer is marked EfiLoaderData so it survives EBS; firmware
  // handles are invalidated en masse by EBS itself.  A defensive
  // xor-and-store to both latches on the bail path preserves the
  // "zero-means-none" invariant even after a partial-success (Steps 1..5
  // that wrote _efi_initrd_pool_buf before Step 6 failed do NOT taint
  // the boot_env slots).
  //
  // Register discipline (SysV callee):
  //   r12 = SFS interface (post-Step 1)
  //   r13 = root file handle (post-Step 2)
  //   r14 = file handle (post-Step 3)
  //   r15 = FileSize (post-Step 4, consumed at Step 5/6/7)
  // 4 callee-save pushes + sub rsp,8 pad = 40 bytes, entry rsp%16==8
  // + 40 = %16==0 baseline for the direct-dispatch firmware calls
  // below.
  //
  // Alignment ledger per firmware direct-dispatch call:
  //   * 3-4 arg MS x64: sub rsp, 32 (shadow only; %16==0 → %16==0).
  //   * 5-arg MS x64:   sub rsp, 48 (32 shadow + 8 arg + 8 pad;
  //                     %16==0 → %16==0, [rsp+32]=arg5, [rsp+40]=pad).
  //
  // Label discipline: all local labels prefixed `eli_` (grep audit
  // 2026-09-07: no `eli_` hits anywhere else in src/).
  //
  // Effects/capabilities: {sysreg, mem} matches efi_open_protocol's row
  // union of firmware indirect-dispatch (writes to memory via OUT
  // params, no port I/O directly — the firmware may internally do
  // storage I/O but that is opaque to this call site).
  pub let efi_load_initrd : (u64) -> () !{sysreg, mem} @{} =
    fn (device_handle: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R111.M3-013 (paideia-os #2365). Best-effort loader for L\"\\EFI\\PAIDEIA\\rootfs.pdxfs\" via EFI_SIMPLE_FILE_SYSTEM_PROTOCOL on LoadedImage->DeviceHandle. On success, latches (pool_buf_pa, file_size) into _efi_initrd_pa / _efi_initrd_size so efi_finalize_and_handoff Phase 1 can copy them into _boot_env at +104 / +112. On any failure (no SFS, path missing, GetInfo/AllocatePool/Read refused, short read) leaves both latches at .bss zero — the kernel-side witness rootfs_mount_witness then emits ROOTFS MOUNT NONE and the pre-R111 tmpfs-root fallback stays in effect. 4-push callee-save prologue (r12=sfs, r13=root, r14=file, r15=file_size) + sub rsp, 8 pad lands rsp%16==0 for the firmware direct-dispatch calls below (entry rsp%16==8 + 32 push + 8 pad = 48). Alignment ledger for each firmware call: 3-4 arg MS x64 uses sub rsp, 32 (shadow only; from %16==0 → %16==0); 5-arg MS x64 uses sub rsp, 48 (32 shadow + 8 stack arg + 8 pad). Step 1: efi_open_protocol(DeviceHandle, SFS_GUID, 0, 0, 1) — SysV wrapper, latches SFS interface into _efi_last_opened_interface; cmp rax, 0; jne eli_bail. Step 2: sfs->OpenVolume(sfs, &root_out) via `mov rax, [r12+8]; call rax`; cmp rax, 0; jne. Step 3: root->Open(root, &file_out, path, MODE_READ=1, attr=0) — 5 args, MS x64 [rsp+32]=attributes; vtable +8; cmp/jne. Step 4: file->GetInfo(file, &FILE_INFO_GUID, &info_size, buffer) — vtable +64; reset _efi_initrd_info_size to 512 before call (IN/OUT capacity); on success read FileSize from _efi_initrd_info_scratch+8 into r15. Guard against zero-length file (cmp r15, 0; je eli_bail). Step 5: BS->AllocatePool(EfiLoaderData=2, size, &pool_buf) — BS from [_efi_system_table+96], AllocatePool at BS+64. Step 6: file->Read(file, &read_size, pool_buf) — vtable +32; _efi_initrd_read_size preloaded to r15 (expected FileSize). Step 7: cmp read_size, r15; jne eli_bail (short read = corrupt-tail-in-EfiLoaderData risk). Success path: latch _efi_initrd_pa = _efi_initrd_pool_buf, _efi_initrd_size = r15. All stores use rax intermediary rather than direct r15 write to avoid any REX.B narrow-store encoder pitfall. Bail path: xor+store zero to both latches (defensive against partial success writing _efi_initrd_pool_buf before Step 6 failed). No cleanup: firmware handles + pool alloc are all handled by ExitBootServices in Phase 2 of the finalizer (pool_buf is EfiLoaderData and survives EBS by design; firmware handles are torn down en masse by EBS). Labels prefixed eli_ — grep audit 2026-09-07: no eli_ hits anywhere else in src/. Encoder posture: no test rN,rN (all cmp reg,imm form), no 2-op imul r,imm, no and reg,imm64 (all constants imm32 or via rax intermediary), no cmp reg,[mem] (loads staged through rax first). call reg form validated by src/kernel/acpi/xsdt.pdx §acpi_xsdt_foreach's identical usage pattern.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // Step 1: OpenProtocol on the LoadedImage DeviceHandle for
        // EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_GUID with attributes =
        // BY_HANDLE_PROTOCOL (1).  device_handle arrives in rdi per
        // SysV and stays in rdi as the wrapper's own first arg (no
        // marshalling needed — SysV in, SysV in).
        lea rsi, [rip + _efi_simple_fs_protocol_guid];
        mov rdx, 0;                              // agent = 0
        mov rcx, 0;                              // controller = 0
        mov r8, 1;                               // BY_HANDLE_PROTOCOL
        call efi_open_protocol;
        cmp rax, 0;
        jne eli_bail;

        // Latch SFS interface pointer into r12.
        mov r12, [rip + _efi_last_opened_interface];

        // Step 2: sfs->OpenVolume(sfs, &_efi_initrd_root_handle).
        // MS x64: rcx=this, rdx=out.  3-arg-equiv (2 args) → sub 32.
        mov rcx, r12;
        lea rdx, [rip + _efi_initrd_root_handle];
        mov rax, [r12 + 8];                     // OpenVolume vtable slot
        sub rsp, 32;
        call rax;
        add rsp, 32;
        cmp rax, 0;
        jne eli_bail;

        // Load root file handle into r13.
        mov r13, [rip + _efi_initrd_root_handle];

        // Step 3: root->Open(root, &file_out, path, MODE_READ=1, attr=0).
        // MS x64: rcx=this, rdx=&out, r8=filename, r9=mode,
        //         [rsp+0x20]=attributes.  5 args → sub 48.
        sub rsp, 48;
        xor rax, rax;
        mov [rsp + 32], rax;                    // attributes = 0
        mov rcx, r13;
        lea rdx, [rip + _efi_initrd_file_handle];
        lea r8, [rip + _efi_initrd_path];
        mov r9, 1;                              // EFI_FILE_MODE_READ
        mov rax, [r13 + 8];                     // Open vtable slot
        call rax;
        add rsp, 48;
        cmp rax, 0;
        jne eli_bail;

        // Load file handle into r14.
        mov r14, [rip + _efi_initrd_file_handle];

        // Step 4: file->GetInfo(file, &FILE_INFO_GUID, &info_size,
        //                       buffer).  Reset info_size to buffer
        //         capacity (512) before the call — GetInfo uses it as
        //         IN buffer size and overwrites with actual size on
        //         return.  MS x64: rcx/rdx/r8/r9 → 4 args, sub 32.
        lea rax, [rip + _efi_initrd_info_size];
        mov rcx, 512;
        mov [rax], rcx;

        mov rcx, r14;
        lea rdx, [rip + _efi_file_info_id_guid];
        lea r8, [rip + _efi_initrd_info_size];
        lea r9, [rip + _efi_initrd_info_scratch];
        mov rax, [r14 + 64];                    // GetInfo vtable slot
        sub rsp, 32;
        call rax;
        add rsp, 32;
        cmp rax, 0;
        jne eli_bail;

        // Extract FileSize (u64 @ +8 of EFI_FILE_INFO) into r15.
        lea rax, [rip + _efi_initrd_info_scratch];
        mov r15, [rax + 8];

        // Zero-length blob → treat as "no rootfs available".
        cmp r15, 0;
        je eli_bail;

        // Step 5: BS->AllocatePool(EfiLoaderData=2, size, &pool_buf).
        // BS pointer at [_efi_system_table + 96]; AllocatePool slot
        // at BS + 64 per UEFI 2.10 §4.4 vtable layout.
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];                    // rax = BS*
        mov r10, [rax + 64];                    // AllocatePool slot
        mov rcx, 2;                             // EfiLoaderData
        mov rdx, r15;                           // size = FileSize
        lea r8, [rip + _efi_initrd_pool_buf];
        sub rsp, 32;
        call r10;
        add rsp, 32;
        cmp rax, 0;
        jne eli_bail;

        // Preload IN/OUT read-size slot with expected FileSize.
        // firmware overwrites with actual bytes-read on return.
        // Stage through rcx (volatile, dead here) rather than store
        // r15 directly to memory — [rax] rM store form is well-worn
        // for rcx elsewhere in this file, and this keeps the encoder
        // paths uniform across the two later `mov [rip+..], rax`
        // success-latch stores below.
        lea rax, [rip + _efi_initrd_read_size];
        mov rcx, r15;
        mov [rax], rcx;

        // Step 6: file->Read(file, &read_size, pool_buf).
        // MS x64: rcx=this, rdx=&size, r8=buffer.  3 args → sub 32.
        mov rcx, r14;
        lea rdx, [rip + _efi_initrd_read_size];
        mov r8, [rip + _efi_initrd_pool_buf];
        mov rax, [r14 + 32];                    // Read vtable slot
        sub rsp, 32;
        call rax;
        add rsp, 32;
        cmp rax, 0;
        jne eli_bail;

        // Step 7: short-read guard.  A read that returned EFI_SUCCESS
        // with bytes-read < FileSize would leave the tail as raw
        // firmware-allocated pool bytes (opaque; not necessarily zero
        // — AllocatePool does not zero-init per UEFI 2.10 §7.2.4), so
        // any downstream PdxFS mount attempt could crash on
        // garbage-tail interpretation.  Force the NONE path.
        mov rax, [rip + _efi_initrd_read_size];
        cmp rax, r15;
        jne eli_bail;

        // Success: latch pool buffer PA and file size into the two
        // boot_env-feeder slots.  Stage both stores through rax to
        // avoid any REX.B narrow-store encoder pitfall on r15.
        mov rax, [rip + _efi_initrd_pool_buf];
        mov [rip + _efi_initrd_pa], rax;
        mov rax, r15;
        mov [rip + _efi_initrd_size], rax;

        jmp eli_done;

      eli_bail:
        // Any failure: force both latches to zero.  Handles the
        // partial-success case (Step 5 wrote _efi_initrd_pool_buf
        // before Step 6 or 7 failed) by resetting the feeder slots
        // rather than the intermediate pool-buf latch (leaving a
        // "leaked" but never-referenced pool allocation).
        xor rax, rax;
        mov [rip + _efi_initrd_pa], rax;
        mov [rip + _efi_initrd_size], rax;

      eli_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // -- efi_tcg2_measure_kernel — optional TPM measurement -------------------
  pub let efi_tcg2_measure_kernel : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_base: u64, image_size: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M3-004 (#795). Optional measured-boot integration. Populates a minimal EFI_TCG2_EVENT header (PCRIndex=4 EV_EFI_BOOT_SERVICES_APPLICATION, EventType=0x80000009), LocateProtocol EFI_TCG2_PROTOCOL_GUID; on EFI_NOT_FOUND (TPM absent) returns 0 silently. On success, latches _efi_tcg2_this and dispatches HashLogExtendEvent(this, 0, image_base, image_size, &_efi_tcg2_event) via `FF /2 [rax + 16]` per EFI TCG2 Protocol spec §6.2. 5-arg MS x64 dispatch — 32B shadow + 1-arg stack slot + alignment pad = sub rsp, 56. Byte-identical to src/boot/uefi_tcg2.pdx.",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        lea rcx, [rip + _efi_tcg2_event];
        mov rax, 21;
        mov [rcx + 0], eax;
        mov rax, 16;
        mov [rcx + 4], eax;
        mov rax, 1;
        mov [rcx + 8], eax;
        mov rax, 4;
        mov [rcx + 12], eax;
        mov rax, 0x80000009;
        mov [rcx + 16], eax;
        mov rax, 0;
        mov [rcx + 20], al;
        lea rdi, [rip + _efi_tcg2_protocol_guid];
        mov rsi, 0;
        call efi_locate_protocol;
        mov rdx, 0x800000000000000E;
        cmp rax, rdx;
        jne efi_tcg2_measure_kernel_ck;
        mov rax, 0;
        ret;
      efi_tcg2_measure_kernel_ck:
        cmp rax, 0;
        je efi_tcg2_measure_kernel_have;
        ret;
      efi_tcg2_measure_kernel_have:
        mov rax, [rip + _efi_last_located_interface];
        mov [rip + _efi_tcg2_this], rax;
        sub rsp, 56;
        lea rdx, [rip + _efi_tcg2_event];
        mov [rsp + 32], rdx;
        mov rcx, rax;
        mov rdx, 0;
        mov r8, r10;
        mov r9, r11;
        call [rcx + 16];
        add rsp, 56;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R19.M4 wrappers (see src/boot/uefi_memmap.pdx / uefi_exit.pdx / uefi_env.pdx
  // for the documentation companions).
  // ==========================================================================

  // -- efi_get_memory_map (wraps BS->GetMemoryMap at BS+56) ------------------
  //
  // 5-arg SysV → MS dispatch. Inlined from src/boot/uefi_memmap.pdx (which
  // is the authoritative documentation companion for #789). See that file
  // for the full ABI derivation.
  pub let efi_get_memory_map : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (map_size_ptr: u64, map_ptr: u64, map_key_ptr: u64, desc_size_ptr: u64, desc_ver_ptr: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M2-003 (#789). Wraps EFI_BOOT_SERVICES.GetMemoryMap (UEFI 2.10 §7.2.3, vtable +56). 5-argument MS x64 dispatch: 32B shadow + 8B slot for 5th arg + 8B alignment ⇒ sub rsp, 40. SysV RDI/RSI/RDX/RCX/R8 → MS RCX/RDX/R8/R9/[rsp+0x20] in dependency-safe order — SysV r8 stored to the stack slot FIRST (before r8 is overwritten as MS r8), then register moves walk in reverse arg order (r9←rcx, r8←rdx, rdx←rsi, rcx←rdi). Byte-identical to src/boot/uefi_memmap.pdx.",
      block: {
        sub rsp, 40;
        mov [rsp + 32], r8;
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov r9, rcx;
        mov r8, rdx;
        mov rdx, rsi;
        mov rcx, rdi;
        call [rax + 56];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_exit_boot_services (wraps BS->ExitBootServices at BS+232) ---------
  //
  // 2-arg SysV → MS dispatch. Byte-identical to src/boot/uefi_exit.pdx.
  pub let efi_exit_boot_services : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (image_handle: u64, map_key: u64) -> unsafe {
      effects: { sysreg, mem }, capabilities: {},
      justification: "R19-M4-002 (#798). Wraps EFI_BOOT_SERVICES.ExitBootServices (UEFI 2.10 §7.4.6, vtable +232). 2-arg MS x64 dispatch: no reshuffle hazards (RDI→RCX, RSI→RDX are non-overlapping). Loads BS* via [rip+_efi_system_table] + [rax+96], 32B shadow + 8B align (sub rsp, 40), indirect call `FF /2 [rax+232]`. Returns EFI_STATUS in RAX (EFI_SUCCESS = 0 on release; EFI_INVALID_PARAMETER = 0x8000000000000002 on stale MapKey — retry from the finalizer). CRITICAL: on EFI_SUCCESS all BS pointers become invalidated. Callers must latch RuntimeServices* into boot_env BEFORE this call. Byte-identical to src/boot/uefi_exit.pdx.",
      block: {
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 96];
        mov rcx, rdi;
        mov rdx, rsi;
        sub rsp, 40;
        call [rax + 232];
        add rsp, 40;
        ret
      }
    } @no_frame

  // -- efi_finalize_and_handoff — populate boot_env, EBS retry loop, jmp ----
  //
  // Called from efi_main after all M3 probes complete. Owns the last-mile
  // sequence:
  //   1. Copy magic / version / fb / rsdp / image_{base,size} / RS* into
  //      _boot_env from the M1/M2/M3-latched slots.
  //   2. Retry loop (R111.M2-010 #2362: max 4, up from 3):
  //      get_memory_map into _efi_memmap_buffer, populate _boot_env's
  //      memmap fields, exit_boot_services(map_key).
  //      On EFI_SUCCESS: firmware quiescent — jump to the OK emit path.
  //      On EFI_INVALID_PARAMETER (0x8000000000000002): the MapKey has
  //        been invalidated by a firmware-internal AllocatePages
  //        between our probe and our exit; refresh the map and retry
  //        (up to attempt #4).
  //      On any OTHER non-zero status: bail via efi_panic_on_fatal (the
  //        existing pre-R111 error handling — non-retriable per UEFI
  //        2.10 §7.4.6 error table).
  //   3. On success: emit "UEFI EBS OK attempts=<n>\r\n" to COM1 via
  //      stub_com1_init + stub_com1_puts, then RDI = &_boot_env;
  //      indirect jump via `push rax; ret` to the address in
  //      _kernel_main_uefi_pa. Non-returning.
  //   4. On 4-attempt EFI_INVALID_PARAMETER exhaustion: emit
  //      "UEFI EBS FAIL exhausted=4 last_status=0x<hex>\r\n" to COM1,
  //      then cli/hlt spin. Non-returning.
  //   5. On any non-retriable status: efi_panic_on_fatal (firmware
  //      still alive — ConOut still valid, so the message reaches the
  //      screen). Non-returning.
  //
  // CRITICAL invariant (UEFI 2.10 §7.4.6): between the get_memory_map call
  // and the exit_boot_services call in each retry iteration, NO other
  // firmware entry may be invoked and NO allocation may occur — either
  // would advance firmware's internal map serial and invalidate the just-
  // latched MapKey. The body is written to make the invariant visually
  // obvious: only pure-memory boot_env stores appear between the two
  // firmware calls.  The COM1 emit paths run AFTER the loop terminates
  // (on OK: after EFI_SUCCESS; on FAIL: after the 4th EFI_INVALID_
  // PARAMETER), so they never sit inside the get_memory_map ↔
  // exit_boot_services critical section.
  //
  // Register discipline: no non-volatile saves — the finalizer does not
  // return on the nominal path, and every terminal branch either halts
  // (cli/hlt) or hands off via `push rax; ret` without unwinding. R15
  // holds the attempt counter (1..4); volatile in both ABIs at this
  // point since efi_main already saved its own R15 in the entry-point
  // prologue.  The stub_com1_init / stub_com1_puts / stub_u64_to_hex
  // helpers use only volatile scratch (r10/r11/rax/rcx/rdx/rsi/rdi/r8/r9),
  // so R15 survives the OK-path emit sequence to source the '0'+r15
  // digit for the "attempts=<n>" field.
  pub let efi_finalize_and_handoff : () -> () !{sysreg, mem, PortIo} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem, PortIo }, capabilities: { boot, paideia.port_io },
      justification: "R19-M4-004 (#797/#798/#799) + R111.M2-010 (paideia-os #2362). Populate boot_env_t (magic/version/fb/rsdp/image_base+size/runtime_services), then enter the get_memory_map ↔ exit_boot_services retry loop with the fixed 32KB _efi_memmap_buffer.  R111.M2-010 hardening: capped at 4 attempts (up from 3), and retry gate is now EFI_INVALID_PARAMETER (0x8000000000000002) alone — any other non-zero EFI_STATUS bails immediately via efi_panic_on_fatal (per UEFI 2.10 §7.4.6 error table; only stale-MapKey is retriable).  On EFI_SUCCESS: firmware is quiescent, then emits 'UEFI EBS OK attempts=<n>\\r\\n' to COM1 (stub_com1_init + stub_com1_puts) and `push _kernel_main_uefi_pa; ret` transfers control to kernel_main_uefi with RDI = &_boot_env (SysV arg 0).  On 4-attempt EFI_INVALID_PARAMETER exhaustion: emits 'UEFI EBS FAIL exhausted=4 last_status=0x<16hex>\\r\\n' to COM1 (stub_u64_to_hex over _ebs_last_status) and cli/hlt-spins.  On any other status: efi_panic_on_fatal (fatal error status forced via bit-63-set literal, ConOut still valid pre-EBS).  CRITICAL invariant: between the get_memory_map call site and the exit_boot_services call site in each iteration, no Boot Service is invoked and no allocation occurs — either would advance firmware's internal map serial and invalidate the just-latched MapKey. The body encodes this invariant structurally: only pure-memory boot_env stores appear between the two firmware calls; COM1 emits happen AFTER the loop exits so they never sit inside the critical section. All narrow (32-bit) stores into _boot_env use the SIB `[rdi + off]` form to sidestep the paideia-as v0.20.1 encoder's RIP-relative narrow-store gap (established at #793 for efi_gop_capture). u32 magic-only stores are avoided by combining version(+8) and _pad(+12) into a single u64 store at offset +8.  R15 holds the 1-based attempt counter (survives across stub_com1_init/puts/hex since those touch only volatile scratch).",
      block: {
        // ==================================================================
        // Phase 1: populate the boot_env_t fixed fields.
        // ==================================================================

        lea rdi, [rip + _boot_env];

        // magic (u64 @ +0) — 0x564E454244494150 = "PAIDBENV" LE (see uefi_env.pdx).
        mov rax, 0x564E454244494150;
        mov [rdi + 0], rax;

        // version (u32 @ +8) | _pad (u32 @ +12) — combined u64 store.
        // version = 1, _pad = 0 ⇒ 0x0000000000000001.
        mov rax, 1;
        mov [rdi + 8], rax;

        // fb (fb_desc_t 32 B @ +16) — copy from _efi_fb_desc via 4x u64 loads.
        lea rsi, [rip + _efi_fb_desc];
        mov rax, [rsi + 0];
        mov [rdi + 16], rax;
        mov rax, [rsi + 8];
        mov [rdi + 24], rax;
        mov rax, [rsi + 16];
        mov [rdi + 32], rax;
        mov rax, [rsi + 24];
        mov [rdi + 40], rax;

        // rsdp_pa (u64 @ +48) — from _efi_rsdp_addr (#794).
        mov rax, [rip + _efi_rsdp_addr];
        mov [rdi + 48], rax;

        // image_base (u64 @ +56) / image_size (u64 @ +64) — from #796.
        mov rax, [rip + _efi_image_base];
        mov [rdi + 56], rax;
        mov rax, [rip + _efi_image_size];
        mov [rdi + 64], rax;

        // efi_memmap_pa (u64 @ +72) — VA of the static buffer. UEFI runs
        // with identity-mapped low memory during Boot Services, so the
        // pointer to a .bss array equals its physical address at this
        // point in the boot flow. Post-EBS the kernel treats it as a PA.
        lea rax, [rip + _efi_memmap_buffer];
        mov [rdi + 72], rax;

        // runtime_services_pa (u64 @ +96) — [SystemTable + 88] before EBS
        // invalidates the ST pointer walk. Latched HERE (not in Phase 2)
        // so we don't touch the ST after the get_memory_map call.
        mov rax, [rip + _efi_system_table];
        mov rax, [rax + 88];
        mov [rdi + 96], rax;

        // R111.M3-013 (paideia-os #2365): initrd_pa (u64 @ +104) and
        // initrd_size (u64 @ +112) — populated by efi_load_initrd (see
        // efi_main call site).  Both latches are pure memory reads
        // that do NOT invoke Boot Services, so they are safe to run
        // here in Phase 1 alongside the other fixed-field stores; the
        // get_memory_map ↔ exit_boot_services critical section in
        // Phase 2 remains free of allocations by construction.  Zero
        // in either latch on a boot where the ESP does not carry the
        // blob (or SFS/Open/Read failed) is intentional and gates the
        // kernel-side witness to ROOTFS MOUNT NONE.
        mov rax, [rip + _efi_initrd_pa];
        mov [rdi + 104], rax;
        mov rax, [rip + _efi_initrd_size];
        mov [rdi + 112], rax;

        // ==================================================================
        // Phase 2: get_memory_map + exit_boot_services retry loop.
        //
        // R111.M2-010 (paideia-os #2362): capped at 4 attempts (up from 3);
        // retry gate is EFI_INVALID_PARAMETER only; success + exhaustion
        // paths emit a COM1 fingerprint before proceeding.
        // ==================================================================

        // R15 = 1-based attempt counter (0 before first increment; 1..4
        // through the loop; consumed by the OK path to emit the digit).
        mov r15, 0;

      finalize_ebs_loop:
        add r15, 1;

        // Set memmap size slot to buffer capacity (32 KB). GetMemoryMap
        // uses this as the buffer size on entry and overwrites it with the
        // actual map size on exit — so it must be reset each retry.
        lea rax, [rip + _efi_memmap_size];
        mov rdx, 32768;
        mov [rax], rdx;

        // efi_get_memory_map(&size, buffer, &key, &desc_size, &desc_ver).
        lea rdi, [rip + _efi_memmap_size];
        lea rsi, [rip + _efi_memmap_buffer];
        lea rdx, [rip + _efi_memmap_key];
        lea rcx, [rip + _efi_memmap_desc_size];
        lea r8,  [rip + _efi_memmap_desc_ver];
        call efi_get_memory_map;

        // Copy memmap-derived fields into boot_env_t. Pure-memory work —
        // does NOT invalidate the map key.
        lea rdi, [rip + _boot_env];
        mov rax, [rip + _efi_memmap_size];
        mov [rdi + 80], rax;
        // desc_size (u32 @ +88) — SIB form for narrow store.
        mov rax, [rip + _efi_memmap_desc_size];
        mov [rdi + 88], eax;
        // desc_ver (u32 @ +92) — SIB form for narrow store.
        mov rax, [rip + _efi_memmap_desc_ver];
        mov [rdi + 92], eax;

        // efi_exit_boot_services(image_handle, map_key). No calls between
        // this and the get_memory_map above; no allocation, no console.
        mov rdi, [rip + _efi_image_handle];
        mov rsi, [rip + _efi_memmap_key];
        call efi_exit_boot_services;

        cmp rax, 0;
        je  finalize_ebs_ok;

        // Latch last status for the FAIL fingerprint (and defensively for
        // the generic panic path — that path already carries its own
        // ConOut wording but a future observer of _ebs_last_status
        // benefits from having the raw status recorded).
        mov [rip + _ebs_last_status], rax;

        // Retry gate: EFI_INVALID_PARAMETER (0x8000000000000002) is the
        // canonical "stale MapKey" indicator (UEFI 2.10 §7.4.6 error
        // table).  Any OTHER status is non-retriable and bails to the
        // existing efi_panic_on_fatal path.  We materialise the 64-bit
        // constant via rcx because the paideia-as encoder does not
        // support cmp reg,imm64 (only cmp reg,imm32 sign-extended).
        mov rcx, 0x8000000000000002;
        cmp rax, rcx;
        jne finalize_ebs_panic_generic;

        // EFI_INVALID_PARAMETER — retry if attempts remain (r15 < 4).
        cmp r15, 4;
        jl  finalize_ebs_loop;
        // 4th attempt just failed with EFI_INVALID_PARAMETER — fall
        // through to the exhaustion emit path.

      finalize_ebs_exhausted:
        // R111.M2-010 FAIL fingerprint: emit
        // "UEFI EBS FAIL exhausted=4 last_status=0x<16hex>\r\n" to COM1.
        //
        // COM1 init here is idempotent — no earlier stub code drives COM1
        // directly (all stub-side messaging so far has been ConOut via
        // OutputString), so this is the first COM1 init on the wire when
        // we reach here.  On real firmware, Boot Services may still be
        // valid at this point (ExitBootServices only invalidates BS on
        // EFI_SUCCESS return — a failing call leaves BS pointers intact
        // per UEFI 2.10 §7.4.6), but we deliberately choose COM1 for
        // the fingerprint so tools/verify-fingerprint-coverage.sh (which
        // scans the COM1 wire, not ConOut) can gate on it.
        call stub_com1_init;

        // Prefix
        lea rdi, [rip + _ebs_fail_prefix];
        mov rsi, 38;
        call stub_com1_puts;

        // Hex-encode _ebs_last_status into _ebs_hex_scratch (18 bytes:
        // "0x" + 16 lowercase nibbles, MSB-first, zero-padded).
        mov rdi, [rip + _ebs_last_status];
        lea rsi, [rip + _ebs_hex_scratch];
        call stub_u64_to_hex;

        // Emit the 18 hex bytes.
        lea rdi, [rip + _ebs_hex_scratch];
        mov rsi, 18;
        call stub_com1_puts;

        // CRLF terminator.
        lea rdi, [rip + _ebs_crlf];
        mov rsi, 2;
        call stub_com1_puts;

      finalize_ebs_hang:
        cli;
        hlt;
        jmp finalize_ebs_hang;

      finalize_ebs_panic_generic:
        // Existing pre-R111 error handling: firmware still alive on any
        // non-SUCCESS status per UEFI 2.10 §7.4.6, so ConOut is still
        // valid.  Panic via efi_panic_on_fatal (force bit 63 set).
        mov rdi, 0x8000000000000000;
        lea rsi, [rip + _panic_ebs_msg];
        mov rdx, 0;
        call efi_panic_on_fatal;
        // efi_panic_on_fatal never returns on a set-bit-63 status —
        // it enters a cli/hlt spin. This ret is defensive.
        ret;

      finalize_ebs_ok:
        // R111.M2-010 OK fingerprint: emit
        // "UEFI EBS OK attempts=<n>\r\n" to COM1.
        //
        // Firmware is quiescent (Boot Services pointers invalidated by
        // EFI_SUCCESS return).  Only Runtime Services (via boot_env's
        // runtime_services_pa) survive.  Direct-COM1 writes are safe —
        // ports are hardware, not firmware.  Idempotent double-init note:
        // kernel_main_uefi's Phase 2 will re-init COM1 with the same
        // 7-port canonical NS PC16550D §3.3 sequence; running it twice
        // is harmless.
        //
        // R15 (the attempt counter) survives this block because
        // stub_com1_init / stub_com1_puts / stub_u64_to_hex touch only
        // volatile scratch (r10/r11/rax/rcx/rdx/rsi/rdi/r8/r9); R15 is
        // callee-saved in both SysV and MS x64, and none of the helpers
        // save+clobber+restore it either (they simply do not touch it).
        call stub_com1_init;

        // Header: "UEFI EBS OK" (11 bytes; OK-fingerprint token).
        lea rdi, [rip + _ebs_ok_hdr];
        mov rsi, 11;
        call stub_com1_puts;

        // Separator: " attempts=" (10 bytes).
        lea rdi, [rip + _ebs_ok_attempts_tag];
        mov rsi, 10;
        call stub_com1_puts;

        // Single-digit '0' + r15 (r15 in 1..4 by loop invariant).
        // Compute in rax, byte-store to _ebs_digit_scratch, emit 1 byte.
        mov rax, r15;
        add rax, 0x30;
        lea rdi, [rip + _ebs_digit_scratch];
        mov [rdi], al;
        mov rsi, 1;
        call stub_com1_puts;

        // CRLF terminator.
        lea rdi, [rip + _ebs_crlf];
        mov rsi, 2;
        call stub_com1_puts;

        // Handoff.  RDI = &_boot_env (SysV arg 0 to kernel_main_uefi).
        // Indirect jump via push+ret since paideia-as v0.20.1 has no
        // `jmp r/m64` mnemonic (the encoder supports `call [mem]` for
        // firmware vtable dispatch but not `jmp reg` / `jmp [mem]`).
        // `push rax; ret` is the canonical x86_64 idiom for this and
        // costs one extra push slot (unwinds via the ret itself).
        lea rdi, [rip + _boot_env];
        mov rax, [rip + _kernel_main_uefi_pa];
        push rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R111.M2-010 (paideia-os #2362) — direct-to-COM1 helpers used by the
  // EBS retry-hardening OK / FAIL fingerprint emit paths.
  // ==========================================================================
  //
  // These are the ONLY direct-port-I/O sites in the pre-EBS stub — all
  // other stub messaging routes through firmware ConOut->OutputString.
  // Kept isolated (three small SysV @no_frame leaves) so that the effect
  // + capability escalation to {PortIo} / {paideia.port_io} is contained
  // to the retry-hardening emit sites and their callees.
  //
  // Byte-for-byte alignment with the kernel-side substrate:
  //   * stub_com1_init      == src/kernel/kernel_main_uefi.pdx Phase 2
  //                            (NS PC16550D §3.3, 7 port writes)
  //   * stub_com1_puts      == src/kernel/kernel_main_uefi.pdx Phase 3
  //                            (poll LSR THRE @ 0x3FD bit 5, then write
  //                             THR @ 0x3F8), generalised over (buf, len).
  //   * stub_u64_to_hex     == src/kernel/core/klog/hex.pdx §u64_to_hex
  //                            (writes exactly 18 bytes = "0x" + 16
  //                             lowercase nibbles, MSB-first, zero-padded).
  //
  // Duplicated here rather than linked because the stub is a separate
  // PE translation unit that cannot resolve kernel-side ELF symbols
  // (see the file preamble under "Milestone-round layering" — paideia-as
  // v0.20.1's `build --target uefi-x86_64` accepts one .pdx input).
  // When the paideia-as multi-file-link mechanism lands, these three
  // functions can be linked directly from their respective canonical
  // sites and this block collapses.

  // -- stub_com1_init — NS PC16550D §3.3 seven-port init of COM1 ------------
  pub let stub_com1_init : () -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn () -> unsafe {
      effects: { sysreg, PortIo }, capabilities: { paideia.port_io },
      justification: "R111.M2-010 (paideia-os #2362). Canonical NS PC16550D §3.3 seven-port init of COM1 (ports 0x3F8..0x3FF): IER off, LCR DLAB=1, DLL=3 (115200 baud from 1.8432 MHz), DLM=0, LCR 8N1 (DLAB=0), FCR enable+clear FIFO, MCR DTR+RTS+OUT2. Byte-identical to the src/kernel/kernel_main_uefi.pdx Phase 2 sequence; idempotent so the OK path's double-init (stub emits fingerprint, kernel_main_uefi re-inits on entry) is harmless. Touches only volatile scratch (dx/al); no non-volatile GPR written, safe as @no_frame SysV leaf.",
      block: {
        mov dx, 0x3F9; mov al, 0x00; out_al al;   // IER off
        mov dx, 0x3FB; mov al, 0x80; out_al al;   // LCR DLAB=1
        mov dx, 0x3F8; mov al, 0x03; out_al al;   // DLL=3 → 115200 baud
        mov dx, 0x3F9; mov al, 0x00; out_al al;   // DLM=0
        mov dx, 0x3FB; mov al, 0x03; out_al al;   // LCR 8N1 (DLAB=0)
        mov dx, 0x3FA; mov al, 0xC7; out_al al;   // FCR enable+clear FIFO
        mov dx, 0x3FC; mov al, 0x0B; out_al al;   // MCR DTR+RTS+OUT2
        ret
      }
    } @no_frame

  // -- stub_com1_puts — write rsi bytes from rdi to COM1 (0x3F8) ------------
  pub let stub_com1_puts : (u64, u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (buf: u64, len: u64) -> unsafe {
      effects: { sysreg, mem, PortIo }, capabilities: { paideia.port_io },
      justification: "R111.M2-010 (paideia-os #2362). Poll-and-write COM1 substrate: for each byte in [buf, buf+len), poll LSR (0x3FD) bit 5 (THRE) until set, then write THR (0x3F8). rdi=buf, rsi=len. Uses r10 as the buf cursor and r11 as the remaining count — both volatile in SysV, so no callee-save discipline needed; SysV non-volatiles (rbx/rbp/r12-r15) are untouched. Safe pre- or post-EBS (COM1 is direct hardware, not a firmware service).",
      block: {
        mov r10, rdi;
        mov r11, rsi;

      stub_com1_puts_loop:
        cmp r11, 0;
        je  stub_com1_puts_done;

      stub_com1_puts_poll:
        mov dx, 0x3FD;
        in_al al;
        and rax, 0x20;
        jz  stub_com1_puts_poll;

        mov al, [r10];
        mov dx, 0x3F8;
        out_al al;

        add r10, 1;
        sub r11, 1;
        jmp stub_com1_puts_loop;

      stub_com1_puts_done:
        ret
      }
    } @no_frame

  // -- stub_u64_to_hex — write "0x<16hex>" (18 bytes) into buf --------------
  pub let stub_u64_to_hex : (u64, u64) -> () !{mem} @{} =
    fn (value: u64, buf: u64) -> unsafe {
      effects: { mem }, capabilities: {},
      justification: "R111.M2-010 (paideia-os #2362). Byte-identical to src/kernel/core/klog/hex.pdx §u64_to_hex — inlined here because the stub is a separate PE translation unit that cannot resolve kernel-side ELF symbols. rdi=value, rsi=buf. Writes exactly 18 bytes ('0x' followed by 16 lowercase hex nibbles, MSB-first, zero-padded). Single-pass shift-and-extract loop: rotate 4 bits per nibble, convert to ASCII via arithmetic (0..9 → 0x30..0x39, 10..15 → 0x61..0x66). Uses only volatile scratch (r8/r9/r10, rax/rcx/rdx). Caller supplies buffer ≥18 bytes; no NUL termination.",
      block: {
        mov r8, rsi;                                 // r8 = buf
        mov r9, rdi;                                 // r9 = value
        mov r10, 16;                                 // r10 = loop counter (16 nibbles)

        // Prefix: "0x"
        mov al, 0x30;                                // '0'
        mov [r8], al;
        mov al, 0x78;                                // 'x'
        mov [r8 + 1], al;

      stub_hex_loop:
        // Extract top 4 bits via shift
        mov rax, r9;
        shr rax, 60;                                 // top 4 bits in rax[3:0]
        and rax, 0xF;                                // mask to 4 bits

        // Convert nibble to ASCII: 0..9 → 0x30..0x39, 10..15 → 0x61..0x66
        cmp rax, 10;
        jb  stub_hex_digit_0_9;
        add rax, 0x57;                               // 10+0x57=0x61='a'
        jmp stub_hex_digit_done;
      stub_hex_digit_0_9:
        add rax, 0x30;                               // 0+0x30='0'
      stub_hex_digit_done:

        // Compute position: 2 + (16 - counter) = buf + 18 - r10
        mov rdx, 16;
        sub rdx, r10;
        add rdx, 2;
        add rdx, r8;                                 // rdx = buf + position

        // Store byte at buf[position]
        mov [rdx], al;

        // Shift value left 4 bits for next iteration
        shl r9, 4;

        // Decrement counter, loop
        dec r10;
        cmp r10, 0;
        jne stub_hex_loop;

        ret
      }
    } @no_frame
}
