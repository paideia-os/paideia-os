// src/boot/uefi_loaded_image.pdx — R19-M3-005 (#796)
//
// EFI_LOADED_IMAGE_PROTOCOL lookup — OpenProtocol on the stub's own
// ImageHandle to recover the LoadedImage descriptor firmware built when
// it invoked our efi_main entry point. Consumed by the TCG2 measurement
// path (#795) which hashes [ImageBase, ImageBase+ImageSize) into PCR 4,
// and by the R19.M4 handoff which forwards ImageBase / ImageSize into the
// boot_env_t snapshot for the kernel's post-EBS self-inspection path.
//
// -----------------------------------------------------------------------------
// EFI_LOADED_IMAGE_PROTOCOL layout (UEFI 2.10 §9.1)
// -----------------------------------------------------------------------------
//
// struct EFI_LOADED_IMAGE_PROTOCOL {
//   UINT32                     Revision;         // +0     (u32, +4 pad)
//   EFI_HANDLE                 ParentHandle;     // +8
//   EFI_SYSTEM_TABLE*          SystemTable;      // +16
//   EFI_HANDLE                 DeviceHandle;     // +24
//   EFI_DEVICE_PATH_PROTOCOL*  FilePath;         // +32
//   VOID*                      Reserved;         // +40
//   UINT32                     LoadOptionsSize;  // +48    (u32, +4 pad)
//   VOID*                      LoadOptions;      // +56
//   VOID*                      ImageBase;        // +64
//   UINT64                     ImageSize;        // +72
//   EFI_MEMORY_TYPE            ImageCodeType;    // +80    (u32, +4 pad)
//   EFI_MEMORY_TYPE            ImageDataType;    // +88    (u32, +4 pad; edk2 layout)
//   EFI_IMAGE_UNLOAD           Unload;           // +96
// };  // sizeof = 104 on x86_64
//
// NOTE: the task brief cited offsets +48/+64 for LoadOptions/ImageBase but
// cross-checking against edk2-stable202408 MdePkg/Include/Protocol/
// LoadedImage.h and the paired UEFI 2.10 §9.1 §"EFI_LOADED_IMAGE_PROTOCOL
// Structure" gives the layout above (Revision u32 is the FIRST field with
// +4 tail pad, then five 8-byte pointer/handle slots, then LoadOptionsSize
// at +48). ImageBase lands at +64 and ImageSize at +72. #796 latches those
// two.
//
// -----------------------------------------------------------------------------
// OpenProtocol attributes
// -----------------------------------------------------------------------------
//
// EFI_OPEN_PROTOCOL_BY_HANDLE_PROTOCOL (0x1) is the read-only convenience
// mode — firmware returns the interface pointer without tracking a
// per-driver reference; no matching CloseProtocol is required. This is the
// canonical way to look up a protocol on a handle from a non-driver
// consumer (§7.3.9 "OpenProtocol()" — "This attribute is used by
// applications to get a protocol interface from a handle. Applications
// are not required to call CloseProtocol()."). The stub is such an
// application; BY_HANDLE_PROTOCOL saves the CloseProtocol pair.
//
// -----------------------------------------------------------------------------
// Standalone-compile discipline
// -----------------------------------------------------------------------------
//
// Same as sibling M3 files — local shadows for _efi_system_table,
// _efi_last_opened_interface, the GUID literal, and a stub
// efi_open_protocol. The real build merges everything into uefi_stub.pdx.

module UefiLoadedImage = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let EFI_LI_OFFSET_LOAD_OPTIONS_SIZE : u64 = 48
  pub let EFI_LI_OFFSET_LOAD_OPTIONS      : u64 = 56
  pub let EFI_LI_OFFSET_IMAGE_BASE        : u64 = 64
  pub let EFI_LI_OFFSET_IMAGE_SIZE        : u64 = 72

  pub let EFI_OPEN_PROTOCOL_BY_HANDLE_PROTOCOL : u64 = 0x1

  // ==========================================================================
  // Storage
  // ==========================================================================

  pub let mut _efi_image_base : u64 = 0
  pub let mut _efi_image_size : u64 = 0

  // Standalone-compile shadows / stubs.
  pub let mut _efi_system_table : u64 = 0
  pub let mut _efi_image_handle : u64 = 0
  pub let mut _efi_last_opened_interface : u64 = 0
  pub let _efi_loaded_image_protocol_guid : [u8; 16] = [
    0xA1u8, 0x31u8, 0x1Bu8, 0x5Bu8,
    0x62u8, 0x95u8, 0xD2u8, 0x11u8,
    0x8Eu8, 0x3Fu8, 0x00u8, 0xA0u8,
    0xC9u8, 0x69u8, 0x72u8, 0x3Bu8
  ]

  pub let efi_open_protocol : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (handle: u64, protocol_guid_ptr: u64, agent_handle: u64,
        controller_handle: u64, attributes: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "standalone-compile stub; real wrapper lives in the merged uefi_stub.pdx build.",
      block: { mov rax, 0; ret }
    } @no_frame

  // ==========================================================================
  // efi_get_loaded_image — OpenProtocol on ImageHandle, latch base+size
  // ==========================================================================
  //
  // Caller-provided image_handle in SysV rdi (the same handle firmware
  // passed to efi_main in MS rcx — the stub latches it into
  // _efi_image_handle at entry, so callers can either forward it or read
  // it from the latch). OpenProtocol(handle, LoadedImageProtocolGuid,
  // agent_handle=image_handle, controller=NULL, BY_HANDLE_PROTOCOL) writes
  // the interface pointer into _efi_last_opened_interface; we then read
  // ImageBase (+64) and ImageSize (+72) from the interface and store into
  // the module-owned latches.
  //
  // Emitted body (unsafe, no frame):
  //   ; Set up 5-arg efi_open_protocol call:
  //   ;   arg0 handle             = rdi (already there — pass-through)
  //   ;   arg1 protocol_guid_ptr  = &_efi_loaded_image_protocol_guid
  //   ;   arg2 agent_handle       = rdi (same as handle)
  //   ;   arg3 controller_handle  = 0
  //   ;   arg4 attributes         = BY_HANDLE_PROTOCOL (1)
  //   mov  rdx, rdi                              ; SysV arg2 (agent_handle) = handle
  //   lea  rsi, [rip + _efi_loaded_image_protocol_guid]
  //   mov  rcx, 0
  //   mov  r8, 1
  //   call efi_open_protocol
  //   ; RAX = status (unused — BY_HANDLE_PROTOCOL is fire-and-forget for
  //   ; the stub's own image; a fatal here would already have panicked
  //   ; upstream, but for robustness the caller in uefi_stub.pdx wraps this
  //   ; call in an efi_panic_on_fatal check)
  //   mov  rax, [rip + _efi_last_opened_interface]
  //   mov  rcx, [rax + 64]                       ; ImageBase
  //   mov  [rip + _efi_image_base], rcx
  //   mov  rcx, [rax + 72]                       ; ImageSize
  //   mov  [rip + _efi_image_size], rcx
  //   ret

  pub let efi_get_loaded_image : (u64) -> () !{sysreg, mem} @{} =
    fn (image_handle: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R19-M3-005 (#796). Calls efi_open_protocol on the stub's own ImageHandle with the EFI_LOADED_IMAGE_PROTOCOL_GUID and BY_HANDLE_PROTOCOL attributes (UEFI 2.10 §7.3.9 — 'Applications are not required to call CloseProtocol()' for BY_HANDLE_PROTOCOL), then reads ImageBase (+64) and ImageSize (+72) from the returned EFI_LOADED_IMAGE_PROTOCOL interface (UEFI 2.10 §9.1) and latches them into _efi_image_base / _efi_image_size. Consumed by the R19-M3-004 TCG2 measurement path (image hash extend into PCR 4) and by the R19.M4 handoff (boot_env_t snapshot). Non-volatiles untouched; only volatile GPRs written so @no_frame is sound.",
      block: {
        mov rdx, rdi;
        lea rsi, [rip + _efi_loaded_image_protocol_guid];
        mov rcx, 0;
        mov r8, 1;
        call efi_open_protocol;
        mov rax, [rip + _efi_last_opened_interface];
        mov rcx, [rax + 64];
        mov [rip + _efi_image_base], rcx;
        mov rcx, [rax + 72];
        mov [rip + _efi_image_size], rcx;
        ret
      }
    } @no_frame
}
