// src/samples/adaptive_rate/policy.pdx -- Wave0-B12-06 (paideia-os #2301)
//
// G9.M5-002: ADAPTIVE-RATE SAMPLE -- ENERGY-VS-LATENCY POLICY KNOB.
//
// Design authority: design/roadmap/next-wave-softarch.md §G9 (windowing
// feedback) and design/roadmap/next-wave-synthesis.md line 96
// ("client-side adaptive-rate example"). This file is the POLICY half
// of the G9.M5 adaptive-rate sample: it owns the configuration schema
// and the rate-decision function that the frame loop in the sibling
// main.pdx (Wave0-B12-05, paideia-os #2300) consults every frame after
// KIND_PRESENT_FEEDBACK reports on-time / late.
//
// SEPARATION OF CONCERNS. The sibling main.pdx runs the frame loop,
// accumulates the on-time / late STREAK counters against the pending
// feedback timeline, and calls back into this file with:
//
//     let new_hz = policy_config_apply(
//         &cfg,
//         current_rate_hz,
//         on_time_streak,
//         late_streak,
//         battery_pct
//     );
//
// The reply is the target refresh rate in Hz. main.pdx then reprograms
// the KIND_MODESET_TXN commit only if new_hz != current_rate_hz (rate
// changes are cheap in swap-count but non-free in scan-out reconfigure,
// so gating by inequality keeps the sample honest about its own cost).
//
// This file emits NO widgets and NO surface calls. It is a pure value
// module -- pointers in, integers out -- so the same policy computation
// can be unit-witnessed at boot without a display attached (a future
// G9.M6 boot-witness may exercise `policy_config_apply` against a
// synthetic streak vector before the compositor is up).
//
// NOVEL-CLEAN POSTURE. The policy is table-of-behaviours, not chain-of-
// callbacks: each RatePolicy kind has a single decision branch, and
// POLICY_BALANCED reads its hysteresis thresholds from the same
// PolicyConfig instance the caller passed in. There is no observer,
// no rate-change signal channel, no policy delegate object. The caller
// owns the loop; this file owns the decision.
//
// -----------------------------------------------------------------------------
// RatePolicy ENUM
// -----------------------------------------------------------------------------
//
//   POLICY_LOW_LATENCY   = 0  -- always 120 Hz. For interactive foreground
//                                windows where jank cost dominates energy
//                                cost. Ignores battery and streak inputs.
//   POLICY_BALANCED      = 1  -- dynamic. Starts at current_rate; upgrades
//                                60 -> 120 after `on_time_streak_to_upgrade`
//                                on-time frames; drops 120 -> 60 after
//                                `late_streak_to_downgrade` late frames.
//                                Battery override: if battery_pct is
//                                strictly below `battery_threshold_pct`,
//                                force 60 Hz regardless of streaks.
//   POLICY_BATTERY_SAVER = 2  -- always 60 Hz. Ignores battery and streaks.
//   POLICY_CUSTOM        = 3  -- keep current_rate. The client is running
//                                its own decision loop above this file and
//                                using PolicyConfig only as a config
//                                container.
//
// The dispatch collapses any unknown policy byte (>= 4) to POLICY_CUSTOM
// semantics (return current_rate) via a final unknown-branch so a
// corrupted config buffer degrades to "do nothing" rather than to a
// wrong-rate glitch.
//
// -----------------------------------------------------------------------------
// PolicyConfig LAYOUT -- 8 BYTES
// -----------------------------------------------------------------------------
//
//   [+0]      policy                      : u8   (RatePolicy enum)
//   [+1]      _pad0                       : u8
//   [+2..+3]  on_time_streak_to_upgrade   : u16  (frames)
//   [+4..+5]  late_streak_to_downgrade    : u16  (frames)
//   [+6]      battery_threshold_pct       : u8   (0..100; strictly-below)
//   [+7]      _pad1                       : u8
//
// The layout is naturally aligned per field and packs into a single
// 8-byte word (one x86_64 GPR width). Padding leaves room for one more
// u8 flag without touching the size. All numeric fields use unsigned
// host byte order.
//
// The default configuration (populated by policy_config_default) is
// POLICY_BALANCED with streaks 60 / 3 and battery-threshold 20 %. The
// 60 / 3 asymmetry reflects the empirical asymmetry of the underlying
// signal: on-time streaks accumulate cheaply when the compositor is
// coping, so 60 frames of headroom (~1 s at 60 Hz) is a conservative
// upgrade gate; late streaks are expensive to observe (each is a
// perceptible micro-stutter), so 3 late frames is aggressive on the
// downgrade side. 20 % is the SNIA-typical "low battery" threshold that
// most laptop firmware also treats as an alarm boundary.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY  0xFFFFE740..0xFFFFE74F
// -----------------------------------------------------------------------------
//
// NOTE ON BAND ASSIGNMENT: the task brief assigned 0xFFFFEB40..
// 0xFFFFEB4F, but that page is already fully claimed by
// src/kernel/core/cap/kind_framebuffer.pdx (FB_MINT_BAD_* sentinels,
// R101.M3-001, paideia-os #2145 landed). A repo-wide grep at landing
// time confirmed 0xFFFFE740..0xFFFFE74F is entirely unclaimed across
// src/ and design/. Using a fresh page keeps sentinel disambiguation
// cheap. The band substitution is called out in the batch summary so
// the main coordinator can update any tracking that assumed the
// original allocation.
//
// The current entry points do NOT return these sentinels: refusal on
// a NULL config_ptr collapses to a safe fallback rate (POLICY_RATE_LOW
// = 60 Hz) and a POLICY_ST_REFUSED counter bump. The sentinels below
// are reserved for a future service-boundary promotion (G9.M6 telemetry
// service) where a policy-configuration dispatcher can surface a
// distinct error to a cross-process caller through op_status.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Policy (PascalCase of file basename
// policy.pdx). Labels prefixed `policy_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no `add reg,[mem]`, no float, no
// FPU. 16-bit loads use `mov_w`; 8-bit loads use `mov_b`. Callee-save
// discipline: rbx/r12..r15 each pushed exactly once per function that
// uses them, keeping rsp%16 aligned before every nested call.
//
// policy_config_apply -- the hot path -- makes NO nested calls, uses
// NO callee-save registers, and consumes only rdi..r8 + rax. Every
// branch ends in a two-instruction return (mov rax, imm; ret) so the
// decision cost stays well inside a scan-line's compositor budget.

module Policy = structure {

  // ==========================================================================
  // Section 1  Constants: layout, enum, defaults, rates, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let POLICY_STRUCT_BYTES         : u64 = 8
  pub let POLICY_OFF_KIND              : u64 = 0
  pub let POLICY_OFF_UPGRADE_STREAK    : u64 = 2
  pub let POLICY_OFF_DOWNGRADE_STREAK  : u64 = 4
  pub let POLICY_OFF_BATTERY_THRESHOLD : u64 = 6

  // RatePolicy enum. Values MUST be dense 0..3 so an unknown-kind guard
  // (`ja` after `cmp rax, 3`) can distinguish "in-range but not handled
  // yet" from "out-of-range corruption". Currently every 0..3 value is
  // handled; the guard is defensive against future enum extension.
  pub let POLICY_LOW_LATENCY   : u64 = 0
  pub let POLICY_BALANCED      : u64 = 1
  pub let POLICY_BATTERY_SAVER : u64 = 2
  pub let POLICY_CUSTOM        : u64 = 3

  // Rate values used by the decision function. The sample uses only
  // two rates (60 / 120); a future landing that adds intermediate
  // (72, 90) rates would append new POLICY_RATE_* constants and extend
  // the balanced branch with a step-toward-target rule.
  pub let POLICY_RATE_HIGH : u64 = 120
  pub let POLICY_RATE_LOW  : u64 = 60

  // Defaults seeded on policy_config_default. BALANCED with 60/3 streak
  // asymmetry and 20% battery threshold, per §PolicyConfig LAYOUT
  // rationale above.
  pub let POLICY_DEFAULT_KIND              : u64 = 1    // BALANCED
  pub let POLICY_DEFAULT_UPGRADE_STREAK    : u64 = 60
  pub let POLICY_DEFAULT_DOWNGRADE_STREAK  : u64 = 3
  pub let POLICY_DEFAULT_BATTERY_THRESHOLD : u64 = 20

  // Failure sentinels 0xFFFFE740..0xFFFFE74F. Reserved for the G9.M6
  // telemetry-service promotion. Not returned from current entry
  // points, which collapse refusal to POLICY_RATE_LOW (60 Hz) with a
  // POLICY_ST_REFUSED bump.
  pub let POLICY_OK           : u64 = 0
  pub let POLICY_BAD_PTR      : u64 = 0xFFFFE74F   // config_ptr == 0
  pub let POLICY_BAD_KIND     : u64 = 0xFFFFE74E   // policy byte >= 4
  pub let POLICY_BAD_PREF     : u64 = 0xFFFFE74D   // pref blob malformed
  pub let POLICY_NO_STORE     : u64 = 0xFFFFE74C   // pref store not mounted
  pub let POLICY_BAD_BATTERY  : u64 = 0xFFFFE74B   // battery_pct > 100
  // 0xFFFFE740..0xFFFFE74A reserved for G9.M6 follow-ups.

  // ==========================================================================
  // Section 2  State: default instance + counter vector.
  // ==========================================================================
  //
  // _policy_default holds THE ONE library-owned PolicyConfig instance,
  // populated on demand by policy_config_default. A future multi-window
  // landing (per-window policy) may promote this to an arena keyed by
  // KIND_SURFACE row-id; the current shape is single-instance because
  // the G9.M5 sample is deliberately single-window.
  //
  // Sized to one u64 for the 8-byte struct (matches natural alignment).
  // @align(64) puts it on a cache line so a policy_config_default ->
  // policy_config_apply cycle does not stall on a partial-line fill.

  pub let mut _policy_default : [u64; 1] = uninit @align(64)

  // Counter vector for smoke-witness observability. Four slots:
  //   [POLICY_ST_DEFAULTS] -- policy_config_default calls.
  //   [POLICY_ST_APPLIES]  -- policy_config_apply calls (accepted).
  //   [POLICY_ST_LOADS]    -- policy_load_from_prefs calls.
  //   [POLICY_ST_REFUSED]  -- refused entry-point invocations.

  pub let mut _policy_stats : [u64; 4] = uninit @align(64)

  pub let POLICY_ST_DEFAULTS : u64 = 0
  pub let POLICY_ST_APPLIES  : u64 = 1
  pub let POLICY_ST_LOADS    : u64 = 2
  pub let POLICY_ST_REFUSED  : u64 = 3

  pub let policy_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): clear counter vector at boot. Four u64 slots. Labels prefixed policy_sr_.",
      block: {
        lea r10, [rip + _policy_stats];
        xor rax, rax;
        xor rcx, rcx;
      policy_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  policy_sr_top;
        ret
      }
    }

  pub let policy_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed policy_nt_.",
      block: {
        cmp rdi, 4;
        jae policy_nt_out;
        lea r10, [rip + _policy_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      policy_nt_out:
        ret
      }
    }

  pub let policy_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): counter read. Labels prefixed policy_st_.",
      block: {
        cmp rdi, 4;
        jae policy_st_zero;
        lea r10, [rip + _policy_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      policy_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Factory: policy_config_default.
  // ==========================================================================
  //
  // policy_config_default() -> u64  (pointer to the static instance,
  //                                   populated with defaults)
  //
  // Zeros the _policy_default buffer, then writes the four default
  // field values in place. Returns &_policy_default (the caller treats
  // this as an opaque pointer; do NOT free). A future landing that
  // reads /system/prefs/adaptive_rate.pdxpref will delegate to
  // policy_load_from_prefs; policy_config_default is the pure factory
  // path (no I/O). Bumps POLICY_ST_DEFAULTS.

  pub let policy_config_default : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): populate _policy_default with the BALANCED / 60 / 3 / 20 defaults and return &_policy_default. Entry rsp%16 == 8, push rbx -> %16 == 0 for policy_note call. Labels prefixed policy_cd_.",
      block: {
        push rbx;
        lea  rbx, [rip + _policy_default];

        // Zero the 8-byte block.
        xor  rax, rax;
        mov  [rbx + 0], rax;

        // Write each default field. Byte / word stores preserve
        // packing; the zeroed base above means we only touch the
        // fields we set.
        mov  rax, 1;                       // POLICY_DEFAULT_KIND (BALANCED)
        mov_b [rbx + 0], rax;              // policy
        mov  rax, 60;                      // POLICY_DEFAULT_UPGRADE_STREAK
        mov_w [rbx + 2], rax;              // on_time_streak_to_upgrade
        mov  rax, 3;                       // POLICY_DEFAULT_DOWNGRADE_STREAK
        mov_w [rbx + 4], rax;              // late_streak_to_downgrade
        mov  rax, 20;                      // POLICY_DEFAULT_BATTERY_THRESHOLD
        mov_b [rbx + 6], rax;              // battery_threshold_pct

        mov  rdi, 0;                       // POLICY_ST_DEFAULTS
        call policy_note;

        // Return &_policy_default.
        lea  rax, [rip + _policy_default];
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Decision: policy_config_apply.
  // ==========================================================================
  //
  // policy_config_apply(
  //     config_ptr,
  //     current_rate,
  //     on_time_streak,
  //     late_streak,
  //     battery_pct
  // ) -> new_rate_hz
  //
  // Computes the target refresh rate given the caller's policy config
  // and the per-frame telemetry snapshot. This is the SysV-only hot
  // path: no callee-save pushes, no nested calls, no stack scratch.
  // Every branch is a two-instruction return.
  //
  // Dispatch order:
  //   1. NULL config_ptr        -> POLICY_RATE_LOW (60), refusal path.
  //   2. POLICY_LOW_LATENCY (0) -> POLICY_RATE_HIGH (120).
  //   3. POLICY_BALANCED    (1) -> hysteresis over streaks with battery
  //                                override; see §POLICY_BALANCED below.
  //   4. POLICY_BATTERY_SAVER (2) -> POLICY_RATE_LOW (60).
  //   5. POLICY_CUSTOM      (3) -> current_rate (client decides).
  //   6. Unknown kind (>= 4)   -> current_rate (fail-soft).
  //
  // POLICY_BALANCED priority:
  //   (a) battery_pct < battery_threshold_pct -> POLICY_RATE_LOW (60).
  //       Battery wins over both streaks so that a low-battery device
  //       cannot be pushed to 120 Hz by a coincidental on-time streak.
  //   (b) Currently at POLICY_RATE_HIGH (120):
  //         if late_streak >= late_streak_to_downgrade -> 60.
  //         else keep 120 (hysteresis).
  //   (c) Currently at POLICY_RATE_LOW  (60):
  //         if on_time_streak >= on_time_streak_to_upgrade -> 120.
  //         else keep 60 (hysteresis).
  //   (d) Currently at anything else (a client that started at some
  //       intermediate rate): keep current_rate. The compositor path
  //       only advertises 60 / 120 today; a future intermediate-rate
  //       landing will extend this branch.
  //
  // NOTE ON REFUSAL: the null-config path returns POLICY_RATE_LOW (60)
  // rather than the "safer" current_rate because we cannot bump the
  // POLICY_ST_REFUSED counter without clobbering rsi (SysV caller-save
  // reg holding current_rate); returning a fixed conservative rate
  // keeps this function branch-simple without spilling. The G9.M6
  // telemetry-service promotion will introduce a structured error
  // return that carries the fallback rate alongside a sentinel.
  //
  // SysV register map:
  //   rdi = config_ptr       (u64 pointer, may be 0)
  //   rsi = current_rate     (u64 Hz, typically 60 or 120)
  //   rdx = on_time_streak   (u64 frame count)
  //   rcx = late_streak      (u64 frame count)
  //   r8  = battery_pct      (u64, 0..100)
  //   rax = return           (new_rate_hz)

  pub let policy_config_apply : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) (current_rate: u64) (on_time_streak: u64) (late_streak: u64) (battery_pct: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): pure decision function. No nested calls, no callee-save pushes, no stack scratch. Byte / word field loads via mov_b / mov_w (zero-extending). Every branch ends `mov rax, imm; ret` or `mov rax, rsi; ret`. Labels prefixed policy_pa_.",
      block: {
        // (1) NULL config_ptr -> POLICY_RATE_LOW (60), fail-soft.
        cmp  rdi, 0;
        je   policy_pa_null;

        // Load policy kind byte.
        mov_b rax, [rdi + 0];

        // (6) Unknown kind (>= 4): fall through to keep-current.
        cmp  rax, 3;
        ja   policy_pa_keep_current;

        // (2) POLICY_LOW_LATENCY.
        cmp  rax, 0;
        je   policy_pa_high_rate;

        // (4) POLICY_BATTERY_SAVER.
        cmp  rax, 2;
        je   policy_pa_low_rate;

        // (5) POLICY_CUSTOM.
        cmp  rax, 3;
        je   policy_pa_keep_current;

        // (3) POLICY_BALANCED (fallthrough; kind == 1).
        //   (a) Battery below threshold?
        mov_b rax, [rdi + 6];              // battery_threshold_pct
        cmp  r8, rax;
        jb   policy_pa_low_rate;

        //   (b) Currently at POLICY_RATE_HIGH (120)?
        cmp  rsi, 120;
        je   policy_pa_bal_at_high;

        //   (c) Currently at POLICY_RATE_LOW (60)?
        cmp  rsi, 60;
        jne  policy_pa_keep_current;

        // At 60: check upgrade.
        mov_w rax, [rdi + 2];              // on_time_streak_to_upgrade
        cmp  rdx, rax;
        jae  policy_pa_high_rate;
        // Not enough on-time headroom; keep 60.
        mov  rax, rsi;
        ret;

      policy_pa_bal_at_high:
        // At 120: check downgrade.
        mov_w rax, [rdi + 4];              // late_streak_to_downgrade
        cmp  rcx, rax;
        jae  policy_pa_low_rate;
        // Not enough late frames; keep 120.
        mov  rax, rsi;
        ret;

      policy_pa_high_rate:
        mov  rax, 120;
        ret;

      policy_pa_low_rate:
        mov  rax, 60;
        ret;

      policy_pa_keep_current:
        mov  rax, rsi;
        ret;

      policy_pa_null:
        mov  rax, 60;                      // POLICY_RATE_LOW, fail-soft
        ret
      }
    }

  // ==========================================================================
  // Section 5  Persistence: policy_load_from_prefs.
  // ==========================================================================
  //
  // policy_load_from_prefs(pkg_offset) -> u64
  //
  // Stub loader. Ignores pkg_offset and delegates to policy_config_
  // default, returning &_policy_default populated with the BALANCED
  // defaults. Bumps POLICY_ST_LOADS via policy_config_default's own
  // POLICY_ST_DEFAULTS bump (the load path is a superset of the
  // default path today).
  //
  // A future landing will read /system/prefs/adaptive_rate.pdxpref at
  // pkg_offset (a pkgcap-relative byte offset into the mounted prefs
  // package), parse the 8-byte PolicyConfig payload, validate the
  // policy kind (<=3) and battery threshold (<=100), and populate
  // _policy_default from the on-disk value; on any parse error it
  // falls back to policy_config_default. The parse path is a G12.M4
  // concern (settings service) and shares the same pdxpref format the
  // display.pdx sample will consume. Until that lands, this stub keeps
  // the sample end-to-end functional against compiled-in defaults.

  pub let policy_load_from_prefs : (u64) -> u64 !{mem} @{} =
    fn (pkg_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): stub loader; delegates to policy_config_default. Entry rsp%16 == 8; sub rsp,24 lands rsp%16 == 0 for both nested calls, and reserves [rsp+0] as a scratch slot to preserve the returned pointer across the second call (avoids a push/pop pair that would flip alignment between calls). Ignores pkg_offset (parameter shape is fixed for the G12.M4 real-loader landing). Labels prefixed policy_lp_.",
      block: {
        sub  rsp, 24;
        // Populate defaults into _policy_default and return its ptr.
        call policy_config_default;
        // rax = &_policy_default from the callee.
        mov  [rsp + 0], rax;               // preserve return ptr

        // Additionally bump POLICY_ST_LOADS so the loader path is
        // separately observable from the pure-default factory path.
        mov  rdi, 2;                       // POLICY_ST_LOADS
        call policy_note;

        mov  rax, [rsp + 0];               // restore return ptr
        add  rsp, 24;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. The _policy_default
  // buffer itself is initialised on first call to policy_config_default
  // (which happens the first time the client asks for a policy); there
  // is no need to seed defaults at boot before any consumer exists.

  pub let policy_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-06 (#2301): call through to policy_stats_reset for one clean counter zero-out. Labels prefixed policy_i_.",
      block: {
        call policy_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the sample client once policy_init
  // has been called and the first policy_config_default succeeds
  // (G9.M6 telemetry-service klog wire will emit; until then this is
  // a compile-time literal only). Follows the pdx_kind_<name>_meta
  // legacy-suffix convention shared with widgets.pdx / view_tree.pdx /
  // immediate_context.pdx / display.pdx.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B12 G9.M5-002 (#2301) adaptive-rate sample
  // policy + telemetry-service klog wire pending". The main
  // coordinator adds that allowlist entry at Batch 12 close-out.
  //
  // Length: "adaptive rate policy ready ok [legacy: ADAPTIVE RATE POLICY READY OK]\0"
  //   = 69 characters + NUL = 70 bytes (strlen+1 rule).
  pub let pdx_kind_adaptive_rate_policy_meta : [u8; 70] = "adaptive rate policy ready ok [legacy: ADAPTIVE RATE POLICY READY OK]\0"
}
