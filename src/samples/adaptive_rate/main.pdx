// src/samples/adaptive_rate/main.pdx -- Wave0-B12-05 (paideia-os #2300)
//
// G9.M5-001: SAMPLE APP -- ADAPTIVE-RATE CLIENT (60 <-> 120 Hz).
//
// Design authority: design/roadmap/next-wave-softarch.md §G9 (surface
// protocol, damage tracking, presentation-time feedback + client-side
// adaptive-rate) and design/compositor/pwp-spec-vocabulary.md §2.12
// (KIND_PRESENT_FEEDBACK). Row depends on G9.M4-001 (LANDED B9-07,
// KIND_PRESENT_FEEDBACK = 0x1DA at
// src/user/compositor/present_feedback_kind.pdx).
//
// This sample is the FIRST first-party demonstration of the adaptive-
// rate pattern the surface protocol was designed to support: a client
// mints a KIND_PRESENT_FEEDBACK subscription against its own
// KIND_SURFACE, renders one frame per vblank, polls the feedback row's
// last_classification after each render, and shifts its render cadence
// between 60 Hz and 120 Hz based on whether the compositor is reporting
// consistent on-time presents or a run of late presents.
//
// NOVEL-CLEAN POSTURE. The adaptive-rate policy is a pure function of
// three struct fields (current_rate_hz, on_time_streak, late_streak)
// plus the incoming classification: no view model, no callback chain,
// no scheduler-thread. The client's frame loop is a straight-line
//
//     for _ in 0..N:
//         render_frame(&app)
//         class = present_feedback_row_classification(app.feedback_sub_id)
//         adaptive_rate_on_feedback(&mut app, class)
//
// This is deliberately the same "state-in-a-struct + pure transition
// function" shape that src/samples/settings/display.pdx (G12.M3-001,
// Wave0-B11-10, LANDED) established for the settings-panel first-party
// sample. New sample apps landing on G9/G10/G11/G12 pick their pattern
// from these two, so keeping the two identical in shape (module name
// `Main`, single-file, .bss-owned singleton struct, stats counter
// quartet + reset/note/stat helpers, fingerprint tag ending
// `[legacy: ... OK]`) is the coordinator-side scaling lever.
//
// =============================================================================
// AdaptiveRateApp LAYOUT -- 24 BYTES (three u64 words)
// =============================================================================
//
//   [+0..+3]   surface_kind_id       : u32   (the KIND_SURFACE this
//                                             app renders into)
//   [+4..+7]   feedback_sub_id       : u32   (row_id returned by
//                                             present_feedback_mint --
//                                             names the subscription
//                                             row this app polls)
//   [+8..+9]   current_rate_hz       : u16   (60 or 120; the target
//                                             cadence in Hz)
//   [+10..+11] on_time_streak        : u16   (count of consecutive
//                                             ON-TIME classifications
//                                             observed since the last
//                                             non-ON-TIME)
//   [+12..+13] late_streak           : u16   (count of consecutive
//                                             LATE / DROPPED
//                                             classifications observed
//                                             since the last ON-TIME)
//   [+14..+15] _pad                  : u16
//   [+16..+23] total_frames          : u64   (monotone frame counter,
//                                             one bump per
//                                             adaptive_rate_render_frame
//                                             call)
//
// The layout is naturally aligned per field and packs into a single
// 24-byte block that fits in one x86_64 SSE line + one 8-byte slot.
// The two padding bytes at [+14..+15] leave headroom for one
// additional u16 field (e.g., a dropped-frame counter, or a
// vrr_min_rate_hz slot for a future VRR extension) without changing
// struct size. All numeric fields are unsigned host byte order.
//
// Field-width choice notes:
//   - surface_kind_id + feedback_sub_id are u32 because the row_id
//     tail from present_feedback_mint fits in u32 (PF_MAX = 16) and
//     the caller-supplied surface_kind_id is validated <= u32 by
//     present_feedback_surface_valid.
//   - current_rate_hz is u16 because the two supported values (60,
//     120) fit trivially and u16 keeps struct alignment cheap.
//   - on_time_streak / late_streak are u16 because the ON-TIME
//     threshold is 60 (one bump per frame at 60Hz -> saturates at
//     1 sec) and the LATE threshold is 3 (fires on the third
//     consecutive late frame, i.e. within ~50ms of a real drop),
//     both well under u16::MAX. Overflow is treated as saturation
//     (a streak of 65535 is still "long enough" -- the policy fires
//     on threshold, not on exact count).
//   - total_frames is u64 for the same overflow-defence-in-depth
//     reason present_feedback_kind.pdx uses u64 for frame_count.
//
// =============================================================================
// ADAPTIVE-RATE POLICY
// =============================================================================
//
// The policy is a two-arm state machine with hysteresis to keep the
// client from oscillating between 60Hz and 120Hz on borderline
// frames:
//
//   UP arm  (60 -> 120): fires when on_time_streak >= 60 AND
//                        current_rate_hz == 60. Interpretation: the
//                        compositor has met the 60Hz budget for a
//                        full second of consecutive frames, so the
//                        client can safely double its cadence without
//                        worrying about missing the next vblank.
//                        Streaks reset to zero on switch.
//
//   DOWN arm (120 -> 60): fires when late_streak >= 3 AND
//                         current_rate_hz == 120. Interpretation:
//                         three consecutive frames past the target
//                         vblank at 120Hz means the compositor cannot
//                         keep up at that cadence; drop back to 60Hz
//                         where the budget is 2x wider. Streaks
//                         reset to zero on switch.
//
// The asymmetry between UP (60 consecutive on-times) and DOWN (3
// consecutive lates) is intentional: the cost of dropping too fast is
// jankier motion for one second, while the cost of ramping up too fast
// is a stall + immediate fallback. We optimise for the latter cost.
//
// PRESENT_VBLANK classifications (a vblank tick with no pending client
// present) are ignored by the policy -- they carry no signal about
// whether the client's target cadence is being met (there was nothing
// to be on-time or late about).
//
// =============================================================================
// FAILURE TAXONOMY 0xFFFFEB30..0xFFFFEB3F
// =============================================================================
//
// The Wave-0 B12-05 dispatch brief allocates 0xFFFFEB30..0xFFFFEB3F.
// Repo-wide grep at landing time shows this page unclaimed:
//   0xFFFFEB30..3F  FREE  <-- claimed here
// Adjacent claimed pages: 0xFFFFEB70..7F (kind_input_server), no
// live claim in the 0xFFFFEB30..0xFFFFEB6F stretch (the 0xFFFFEB40..5F
// / 0xFFFFEB60..6F windows are also free for future sample-app
// allocations).
//
// The entry points either succeed (returning 0 or a widget-style
// enum value) or refuse silently by bumping _adaptive_rate_stats[
// ADAPT_ST_REFUSED] and returning 0. The ADAPT_* sentinels below
// are reserved for a future service-boundary promotion where a
// sample-driver wrapper wants to surface a distinct error to a
// cross-process caller. Reserved: 0xFFFFEB30..0xFFFFEB3A for future
// arm.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as M0305 module = Main (PascalCase of file basename
// main.pdx). Labels prefixed `adaptive_rate_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no `add reg,[mem]`, no float, no
// FPU. 32-bit loads use `mov_d` (zero-extending); 16-bit loads use
// `mov_w`; 8-bit loads use `mov_b`. Callee-save discipline: rbx/
// r12..r15 each pushed exactly once per function that uses them,
// keeping rsp%16 aligned before every nested call.
//
// =============================================================================
// FUTURE WORK (not this landing)
// =============================================================================
//
// - Replace the bounded FRAME_LIMIT loop with a real vblank-event
//   subscription so the client wakes on the compositor's vblank
//   notification rather than polling. This needs the vk_present_
//   feedback_channel notification wire (G9.M5-002 or later) to land
//   first.
// - Replace the placeholder render_frame body with a real blit into
//   the surface's front buffer via the surface's compositor cap.
//   That needs KIND_SURFACE_BLIT (G9.M2-*) to land.
// - Wire the client's KIND_PROCESS cap into the mint's subscriber_
//   kind_id slot (today we pass 0 -- legal per the mint semantics,
//   "no subscriber, terminal state"). A future sample that owns a
//   real process cap can substitute its own kind_id and receive
//   directed notifications rather than polling.
// - Add a real color-cycle inside render_frame (three .rodata colour
//   constants indexed by total_frames % 3). Today the placeholder
//   only bumps total_frames; the visible effect is a future landing.

module Main = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, thresholds, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let ADAPT_STRUCT_BYTES         : u64 = 24
  pub let ADAPT_OFF_SURFACE_KIND     : u64 = 0
  pub let ADAPT_OFF_FEEDBACK_SUB     : u64 = 4
  pub let ADAPT_OFF_CURRENT_RATE     : u64 = 8
  pub let ADAPT_OFF_ON_TIME_STREAK   : u64 = 10
  pub let ADAPT_OFF_LATE_STREAK      : u64 = 12
  pub let ADAPT_OFF_TOTAL_FRAMES     : u64 = 16

  // Cadence values.
  pub let ADAPT_RATE_60              : u64 = 60
  pub let ADAPT_RATE_120             : u64 = 120

  // Policy thresholds (documented in the AT-A-GLANCE preamble).
  pub let ADAPT_ON_TIME_THRESH       : u64 = 60
  pub let ADAPT_LATE_THRESH          : u64 = 3

  // Bounded sample-loop iteration count. The real client wakes on a
  // vblank event source; this bound keeps the sample function well-
  // defined and returnable so a smoke witness can invoke it and check
  // its outputs. 240 frames = 4 seconds at 60Hz nominal, long enough
  // for an on-time-streak to trip the UP arm at least once.
  pub let ADAPT_FRAME_LIMIT          : u64 = 240

  // PresentClassification enum values (mirrored from
  // present_feedback_kind.pdx §Section 4; values MUST match).
  pub let ADAPT_CLASS_ON_TIME        : u64 = 0
  pub let ADAPT_CLASS_LATE           : u64 = 1
  pub let ADAPT_CLASS_DROPPED        : u64 = 2
  pub let ADAPT_CLASS_VBLANK         : u64 = 3
  pub let ADAPT_CLASS_MAX            : u64 = 3

  // Sentinel returned by present_feedback_row_classification on a
  // dead row. Same value the mint-body packer emits as its bad-arg
  // marker; documented in present_feedback_kind.pdx §Section 10.
  pub let ADAPT_CLASS_BAD_SENTINEL   : u64 = 0xFFFFFFFFFFFFFFFF

  // Failure sentinels 0xFFFFEB30..0xFFFFEB3F. Reserved for a future
  // service-boundary promotion; today the entry points collapse
  // refusal to a silent stat bump.
  pub let ADAPT_OK                   : u64 = 0
  pub let ADAPT_BAD_SURFACE          : u64 = 0xFFFFEB3F  // surface_kind_id refused
  pub let ADAPT_BAD_APP_PTR          : u64 = 0xFFFFEB3E  // app_ptr == 0
  pub let ADAPT_MINT_FAIL            : u64 = 0xFFFFEB3D  // present_feedback_mint returned sentinel
  pub let ADAPT_BAD_CLASS            : u64 = 0xFFFFEB3C  // classification > 3
  pub let ADAPT_QUERY_FAIL           : u64 = 0xFFFFEB3B  // classification query returned sentinel
  // 0xFFFFEB30..0xFFFFEB3A reserved for future arms.

  // ==========================================================================
  // Section 2  State: struct instance + stats quartet.
  // ==========================================================================
  //
  // _adaptive_rate_app holds THE ONE panel-owned AdaptiveRateApp
  // instance. Sample apps run one-shot per invocation of
  // adaptive_rate_main; a future landing that supports multiple
  // concurrent adaptive-rate clients (each with its own surface
  // + subscription) would promote this to an arena keyed by client
  // process cap. Sized to three u64 for the 24-byte struct;
  // @align(64) puts it on a cache line so the per-frame policy update
  // does not stall on a partial-line fill.

  pub let mut _adaptive_rate_app : [u64; 3] = uninit @align(64)

  // Counter quartet for smoke-witness observability. Four slots:
  //   [ADAPT_ST_STARTS]        -- adaptive_rate_main invocations that
  //                               reached the render loop.
  //   [ADAPT_ST_FRAMES]        -- adaptive_rate_render_frame calls.
  //   [ADAPT_ST_UP_SWITCHES]   -- 60->120 cadence promotions.
  //   [ADAPT_ST_DOWN_SWITCHES] -- 120->60 cadence demotions.

  pub let mut _adaptive_rate_stats : [u64; 4] = uninit @align(64)

  pub let ADAPT_ST_STARTS        : u64 = 0
  pub let ADAPT_ST_FRAMES        : u64 = 1
  pub let ADAPT_ST_UP_SWITCHES   : u64 = 2
  pub let ADAPT_ST_DOWN_SWITCHES : u64 = 3

  pub let adaptive_rate_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): clear counter quartet at boot. Four u64 slots. Labels prefixed adaptive_rate_sr_.",
      block: {
        lea r10, [rip + _adaptive_rate_stats];
        xor rax, rax;
        xor rcx, rcx;
      adaptive_rate_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  adaptive_rate_sr_top;
        ret
      }
    }

  pub let adaptive_rate_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed adaptive_rate_nt_.",
      block: {
        cmp rdi, 4;
        jae adaptive_rate_nt_out;
        lea r10, [rip + _adaptive_rate_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      adaptive_rate_nt_out:
        ret
      }
    }

  pub let adaptive_rate_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): counter read. Labels prefixed adaptive_rate_st_.",
      block: {
        cmp rdi, 4;
        jae adaptive_rate_st_zero;
        lea r10, [rip + _adaptive_rate_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      adaptive_rate_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  App-struct initialiser (zero + seed defaults).
  // ==========================================================================
  //
  // adaptive_rate_app_init(surface_kind_id) -> u64 (&_adaptive_rate_app).
  //
  // Zeros the 24-byte struct then seeds surface_kind_id at offset 0
  // and current_rate_hz = 60 at offset 8. Returns &_adaptive_rate_app
  // (the caller treats this as an opaque pointer; do NOT free).
  // Callers that want to reset the app between test runs invoke this
  // again -- it is idempotent (repeat calls re-seed to defaults).

  pub let adaptive_rate_app_init : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): zero the 24-byte app struct (three u64 stores), then write surface_kind_id at [+0] as u32 and current_rate_hz = 60 at [+8] as u16. Returns &_adaptive_rate_app. Single callee-save push (rbx = struct base) leaves rsp%16 == 0 -- no nested calls, no sub rsp,8 needed. Labels prefixed adaptive_rate_ai_.",
      block: {
        push rbx;
        lea  rbx, [rip + _adaptive_rate_app];

        // Zero the 24-byte block.
        xor  rax, rax;
        mov  [rbx + 0],  rax;
        mov  [rbx + 8],  rax;
        mov  [rbx + 16], rax;

        // Seed surface_kind_id (low 32 bits of rdi).
        mov  rax, rdi;
        mov_d [rbx + 0], rax;

        // Seed current_rate_hz = 60.
        mov  rax, 60;
        mov_w [rbx + 8], rax;

        // Return &_adaptive_rate_app.
        mov  rax, rbx;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  adaptive_rate_render_frame -- per-vblank placeholder.
  // ==========================================================================
  //
  // adaptive_rate_render_frame(app_ptr) -> ().
  //
  // Placeholder body: bumps total_frames at [app+16] and ADAPT_ST_
  // FRAMES in the stats quartet. A future landing wires this to a
  // real blit into the surface's front buffer via the compositor's
  // KIND_SURFACE_BLIT op; today the sample only needs the counter
  // bumps so the smoke witness can observe frame progression.
  //
  // Refuses app_ptr == 0 silently (bumps NO stat; the caller passed
  // a bad pointer, which is a caller-side bug the sample refuses to
  // paper over). No sentinel returned because the function's return
  // type is unit -- the caller cannot distinguish a refused call
  // from a successful one, so returning a sentinel would only add
  // confusion.

  pub let adaptive_rate_render_frame : (u64) -> () !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): per-vblank placeholder. Push rbx (=app_ptr) leaves rsp%16 == 0 for the nested adaptive_rate_note call. Refuses NULL app_ptr silently. total_frames at [app+16] bumped via load-add-store (encoder-conservative). Labels prefixed adaptive_rate_rf_.",
      block: {
        push rbx;

        cmp  rdi, 0;
        je   adaptive_rate_rf_out;

        mov  rbx, rdi;                    // app_ptr

        // total_frames += 1.
        mov  rax, [rbx + 16];
        add  rax, 1;
        mov  [rbx + 16], rax;

        // Bump ADAPT_ST_FRAMES.
        mov  rdi, 1;                      // ADAPT_ST_FRAMES
        call adaptive_rate_note;

      adaptive_rate_rf_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 5  adaptive_rate_on_feedback -- policy transition.
  // ==========================================================================
  //
  // adaptive_rate_on_feedback(app_ptr, classification) -> ().
  //
  // Applies the two-arm state machine documented in the preamble
  // §ADAPTIVE-RATE POLICY. Reads current_rate_hz / on_time_streak /
  // late_streak from the app struct, updates streaks according to the
  // incoming classification, then checks the UP and DOWN arm
  // conditions in sequence. Only one arm can fire per call because
  // the streaks that gate the UP and DOWN arms are mutually exclusive
  // (a streak is either ON-TIME or LATE, never both above threshold
  // simultaneously).
  //
  // Refuses:
  //   - app_ptr == 0 silently (no stat bumped; caller-side bug).
  //   - classification > ADAPT_CLASS_MAX silently (no stat bumped;
  //     caller-side bug -- the classification enum is 0..3).
  //   - ADAPT_CLASS_VBLANK (=3) -- returns without mutating state.
  //     A vblank without a pending present is signal-free for cadence
  //     policy.

  pub let adaptive_rate_on_feedback : (u64, u64) -> () !{mem} @{} =
    fn (app_ptr: u64) (classification: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): policy transition. Two callee-save pushes (rbx = app_ptr, r12 = classification) leave rsp%16 == 8; sub rsp,8 aligns for nested adaptive_rate_note calls (%16 == 0). Field width discipline: current_rate_hz / on_time_streak / late_streak all u16 -> mov_w loads and stores preserve neighbouring bytes. Streak counters saturate at u16::MAX via post-inc range check (defence-in-depth; threshold=60 is well below saturation). Labels prefixed adaptive_rate_of_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        cmp  rdi, 0;
        je   adaptive_rate_of_out;
        cmp  rsi, 3;
        ja   adaptive_rate_of_out;

        mov  rbx, rdi;                    // app_ptr
        mov  r12, rsi;                    // classification

        // VBLANK (=3) is signal-free; return without state mutation.
        cmp  r12, 3;
        je   adaptive_rate_of_out;

        // Load current streaks (u16 each).
        mov_w rcx, [rbx + 10];            // on_time_streak
        mov_w rdx, [rbx + 12];            // late_streak

        // Update streaks per classification. u16::MAX saturation via
        // r11 (r10 reserved for the >127 immediate load pattern below).
        cmp  r12, 0;
        je   adaptive_rate_of_on_time;
        // LATE (=1) or DROPPED (=2): bump late_streak, reset on_time.
        add  rdx, 1;
        mov  r11, 0xFFFF;
        cmp  rdx, r11;
        jbe  adaptive_rate_of_late_ok;
        mov  rdx, r11;                    // saturate
      adaptive_rate_of_late_ok:
        xor  rcx, rcx;
        jmp  adaptive_rate_of_write_streaks;

      adaptive_rate_of_on_time:
        // ON_TIME (=0): bump on_time_streak, reset late.
        add  rcx, 1;
        mov  r11, 0xFFFF;
        cmp  rcx, r11;
        jbe  adaptive_rate_of_ontime_ok;
        mov  rcx, r11;                    // saturate
      adaptive_rate_of_ontime_ok:
        xor  rdx, rdx;

      adaptive_rate_of_write_streaks:
        mov_w [rbx + 10], rcx;            // on_time_streak
        mov_w [rbx + 12], rdx;            // late_streak

        // ---- Policy arm evaluation.
        // Load current_rate_hz (u16).
        mov_w rax, [rbx + 8];

        // UP arm: on_time_streak >= 60 AND current_rate_hz == 60.
        cmp  rcx, 60;
        jb   adaptive_rate_of_check_down;
        cmp  rax, 60;
        jne  adaptive_rate_of_check_down;
        // Fire UP arm.
        mov  rax, 120;
        mov_w [rbx + 8], rax;
        xor  rax, rax;
        mov_w [rbx + 10], rax;            // reset on_time_streak
        mov_w [rbx + 12], rax;            // reset late_streak
        mov  rdi, 2;                      // ADAPT_ST_UP_SWITCHES
        call adaptive_rate_note;
        jmp  adaptive_rate_of_out;

      adaptive_rate_of_check_down:
        // DOWN arm: late_streak >= 3 AND current_rate_hz == 120.
        cmp  rdx, 3;
        jb   adaptive_rate_of_out;
        cmp  rax, 120;
        jne  adaptive_rate_of_out;
        // Fire DOWN arm.
        mov  rax, 60;
        mov_w [rbx + 8], rax;
        xor  rax, rax;
        mov_w [rbx + 10], rax;
        mov_w [rbx + 12], rax;
        mov  rdi, 3;                      // ADAPT_ST_DOWN_SWITCHES
        call adaptive_rate_note;

      adaptive_rate_of_out:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  adaptive_rate_main -- entry point.
  // ==========================================================================
  //
  // adaptive_rate_main(surface_kind_id) -> ().
  //
  // Sample-app entry point. Sequence:
  //   (1) adaptive_rate_app_init(surface_kind_id) seeds the struct.
  //   (2) present_feedback_mint(surface_kind_id, 0) allocates the
  //       KIND_PRESENT_FEEDBACK row this app polls. subscriber_kind_id
  //       is 0 today (the sample does not own a real client process
  //       cap; the "no subscriber, terminal state" is legal per the
  //       mint semantics). Row_id (< PF_MAX = 16) stored at [+4].
  //   (3) ADAPT_ST_STARTS bumped once the render loop is entered.
  //   (4) FRAME_LIMIT iterations of:
  //         adaptive_rate_render_frame(&app)
  //         class = present_feedback_row_classification(feedback_sub_id)
  //         adaptive_rate_on_feedback(&app, class)  -- unless
  //             class == ADAPT_CLASS_BAD_SENTINEL, in which case skip
  //             the policy update (the row was revoked mid-loop, a
  //             refusable scenario).
  //   (5) Cleanup: present_feedback_unsubscribe(feedback_sub_id) so
  //       the row's subscriber slot returns to the "no subscriber"
  //       terminal state. The row remains queryable (history preserved).
  //
  // Refuses:
  //   - surface_kind_id == 0 or > u32::MAX: bail before mint (silent;
  //     no stat bumped, no row minted -- caller-side bug).
  //   - Mint sentinel (>= PF_MAX): bail without entering the loop
  //     (silent -- the surface may already have a feedback row).

  pub let adaptive_rate_main : (u64) -> () !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): sample entry. Four callee-save pushes (rbx=surface_kind_id, r12=app_ptr, r13=feedback_sub_id, r14=frame_counter) = 32 bytes: entry rsp%16==8, +32=%16==8, sub rsp,8 aligns to %16==0 for every nested call (present_feedback_mint / present_feedback_row_classification / adaptive_rate_render_frame / adaptive_rate_on_feedback / present_feedback_unsubscribe / adaptive_rate_note). Loop bound FRAME_LIMIT=240 keeps the sample terminating; a future landing with real vblank events replaces the bound with a wake-on-signal. Labels prefixed adaptive_rate_m_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov  rbx, rdi;                    // surface_kind_id

        // (1) Validate + init.
        cmp  rbx, 0;
        je   adaptive_rate_m_out;
        mov  r10, 0xFFFFFFFF;
        cmp  rbx, r10;
        ja   adaptive_rate_m_out;

        mov  rdi, rbx;
        call adaptive_rate_app_init;
        mov  r12, rax;                    // app_ptr

        // (2) Mint the feedback subscription.
        mov  rdi, rbx;                    // surface_kind_id
        xor  rsi, rsi;                    // subscriber_kind_id = 0
        call present_feedback_mint;
        // Sentinel: any value >= PF_MAX (16) is a refusal from mint.
        mov  r10, 16;
        cmp  rax, r10;
        jae  adaptive_rate_m_out;
        mov  r13, rax;                    // feedback_sub_id = row_id

        // Persist feedback_sub_id into the app struct at [+4] (u32).
        mov_d [r12 + 4], r13;

        // (3) Note the start.
        mov  rdi, 0;                      // ADAPT_ST_STARTS
        call adaptive_rate_note;

        // (4) Render loop, bounded by FRAME_LIMIT.
        xor  r14, r14;                    // frame_counter = 0
      adaptive_rate_m_loop:
        mov  r10, 240;                    // ADAPT_FRAME_LIMIT (>127 -> via r10)
        cmp  r14, r10;
        jae  adaptive_rate_m_cleanup;

        mov  rdi, r12;                    // &app
        call adaptive_rate_render_frame;

        mov  rdi, r13;                    // feedback_sub_id
        call present_feedback_row_classification;
        // Skip on-feedback if the row is dead.
        mov  r10, 0xFFFFFFFFFFFFFFFF;
        cmp  rax, r10;
        je   adaptive_rate_m_step;

        mov  rdi, r12;                    // &app
        mov  rsi, rax;                    // classification (0..3)
        call adaptive_rate_on_feedback;

      adaptive_rate_m_step:
        add  r14, 1;
        jmp  adaptive_rate_m_loop;

        // (5) Cleanup.
      adaptive_rate_m_cleanup:
        mov  rdi, r13;                    // feedback_sub_id
        call present_feedback_unsubscribe;

      adaptive_rate_m_out:
        add  rsp, 8;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Boot init.
  // ==========================================================================
  //
  // Zero the stats quartet once at library init. The app struct is
  // initialised by the first adaptive_rate_main call (which happens
  // when a real client entry point invokes the sample); there is no
  // need to seed defaults at boot before any consumer exists.

  pub let adaptive_rate_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-05 (#2300): call through to adaptive_rate_stats_reset for one clean counter zero-out. Labels prefixed adaptive_rate_i_.",
      block: {
        call adaptive_rate_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the client on adaptive_rate_main
  // entry once the smoke-witness wire lands (a future landing that
  // routes a klog_s1 through the sample process); until then this is
  // a compile-time literal.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B12 G9.M5-001 (#2300) adaptive-rate sample
  // client + smoke-witness klog wire pending". The main coordinator
  // adds that allowlist entry at Batch 12 close-out (mirroring the
  // B11-10 settings-display sample's allowlist landing at Batch 11
  // close).
  //
  // Length: "adaptive rate main ok [legacy: ADAPTIVE RATE MAIN OK]\0"
  //   = 53 characters + NUL = 54 bytes (strlen+1 rule).
  pub let pdx_kind_adaptive_rate_main_meta : [u8; 54] = "adaptive rate main ok [legacy: ADAPTIVE RATE MAIN OK]\0"
}
