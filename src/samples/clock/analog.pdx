// src/samples/clock/analog.pdx -- Wave0-B13-10 (paideia-os #2335)
//
// G12.M4-001: SAMPLE APP -- ANALOG CLOCK (Vello face + sweep-second tick).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// stack (developer APIs + first-party toolkit) and next-wave-synthesis.md
// line 99 (paideia-ui sample sweep). Sits on top of two established
// substrates:
//
//   - G12.M1-002 widgets.pdx (Wave0-B10-09, LANDED) supplies the
//     placeholder painter `widget_paint_rect(row_id, rect_ptr, color)`
//     over the KIND_UI_CONTEXT row (0x1D5). The analog clock uses this
//     as its sole "put pixels on the surface" primitive; the real
//     Vello vector face + hand geometry lands with G12.M2 kind_
//     framebuffer draw wire, at which point every `widget_paint_rect`
//     call site here is replaced by a real vector-primitive emit
//     without touching the app-struct shape or the tick semantics.
//
//   - G9.M4-001 present_feedback_kind.pdx (Wave0-B9-07, LANDED,
//     KIND_PRESENT_FEEDBACK = 0x1DA at
//     src/user/compositor/present_feedback_kind.pdx) supplies the
//     monotonic-ns present timestamps that drive the tick clock.
//     `analog_clock_tick(&mut c, nsec)` accepts the monotonic ns
//     value the compositor latched at the last vblank; from that
//     one field the clock derives hour, minute, second, and
//     subsecond_ms fields.
//
// NOVEL-CLEAN POSTURE. The clock is a pure function of its 32-byte
// state block and the monotonic ns timestamp latched at each vblank:
// no view model, no animation controller, no separate render thread.
// The client's frame loop is a straight-line pipeline
//
//     nsec = present_feedback_row_last_present(sub_id)
//     analog_clock_tick(&clock, nsec)
//     analog_clock_render_frame(&clock, ui_ctx_row_id)
//
// which mirrors the same shape both sibling sample apps landed on top
// of the paideia-ui toolkit (src/samples/adaptive_rate/main.pdx and
// src/samples/settings/display.pdx). Keeping every new G12 sample in
// the same file-shape / label-prefix / stats-quartet mold is the
// coordinator-side scaling lever: a fourth sample landing tomorrow
// costs a file-drop and no new pattern.
//
// -----------------------------------------------------------------------------
// AnalogClock LAYOUT -- 32 BYTES (four u64 words)
// -----------------------------------------------------------------------------
//
//   [+0..+3]   surface_kind_id : u32   (KIND_SURFACE the clock renders
//                                        into; supplied at factory time
//                                        + retained for the surface-
//                                        commit wire that lands with
//                                        G12.M2)
//   [+4..+7]   center_x        : i32   (surface-relative x of the face
//                                        center, in surface DPI units;
//                                        signed so a face can be drawn
//                                        against a coordinate system
//                                        with a negative-origin overlay
//                                        overlay convention -- rare but
//                                        legal)
//   [+8..+11]  center_y        : i32   (surface-relative y; same reason)
//   [+12..+13] radius_px       : u16   (face outer radius; 0 refused
//                                        at factory time as ANALOG_
//                                        BAD_RADIUS -- a zero-radius
//                                        clock is a degenerate render
//                                        the placeholder painter would
//                                        exercise without visible effect)
//   [+14]      current_hour    : u8    (0..23; wall clock hour derived
//                                        from monotonic ns)
//   [+15]      current_minute  : u8    (0..59)
//   [+16]      current_second  : u8    (0..59)
//   [+17]      _pad0           : u8
//   [+18..+19] subsecond_ms    : u16   (0..999; drives the smooth
//                                        second-hand sweep by combining
//                                        with current_second into the
//                                        (second*1000 + subsecond_ms)
//                                        pair that compute_hand_angle
//                                        takes as a numerator against
//                                        the 60000 denominator)
//   [+20..+23] _pad1           : u32
//   [+24..+31] frame_count     : u64   (monotone render_frame counter;
//                                        one bump per render_frame call.
//                                        u64 for the same defence-in-
//                                        depth reason present_feedback_
//                                        kind.pdx uses u64 for its own
//                                        frame_count -- 5e11 years at
//                                        60Hz to overflow)
//
// The layout is naturally aligned per field. surface_kind_id + center_x
// + center_y sit in the first two u64 words (naturally aligned as three
// i32/u32 slots plus one u16); the derived time state sits in the third
// u64 word (three u8s + one u16 with one byte + four bytes of padding);
// frame_count occupies the fourth u64 word all to itself. The layout
// leaves 5 bytes of padding for one additional u8 flag + one u32
// numeric future field (e.g., a `dial_style` selector, or a
// `hand_color_argb` slot) without changing struct size.
//
// -----------------------------------------------------------------------------
// TIME DERIVATION -- MONOTONIC NS -> (H, M, S, SUBSECOND_MS)
// -----------------------------------------------------------------------------
//
// The compositor's present-feedback row supplies a monotonic-ns u64
// count of nanoseconds since the compositor's clock epoch. This is
// NOT wall-clock time -- a real system-time clock (KIND_WALL_CLOCK,
// unallocated at this landing) would supply an (epoch_sec, subsec_ns)
// tuple; here we derive an "elapsed since boot" display which is what
// the sample needs to demonstrate motion. A future landing that adds
// KIND_WALL_CLOCK + a tz-aware timezone cap swaps the derivation in
// analog_clock_tick without touching the struct layout or the render
// path.
//
// Chain of five unsigned divides in analog_clock_tick:
//
//     ms_total       = nsec        / 1_000_000     (nsec -> ms, drop sub-ms)
//     subsecond_ms   = ms_total    % 1000          (0..999)
//     sec_total      = ms_total    / 1000          (elapsed seconds)
//     current_second = sec_total   % 60            (0..59)
//     min_total      = sec_total   / 60            (elapsed minutes)
//     current_minute = min_total   % 60            (0..59)
//     hour_total     = min_total   / 60            (elapsed hours)
//     current_hour   = hour_total  % 24            (0..23)
//
// Each divide uses the x86 `div rN` form (unsigned 128-bit / 64-bit ->
// 64-bit quotient in rax, 64-bit remainder in rdx). rdx is zeroed
// before every divide so the dividend is exactly rax (u64 in, u64 out;
// no overflow #DE possible since the quotient always fits in u64 --
// dividing a u64 by 60 or 24 cannot produce a value larger than the
// input).
//
// -----------------------------------------------------------------------------
// HAND-ANGLE HELPER
// -----------------------------------------------------------------------------
//
// analog_clock_compute_hand_angle(unit, max_val) -> angle_deg
//
// Returns (unit * 360) / max_val as a u64 (0..359 for well-formed
// inputs). The multiplication happens FIRST so the integer division
// preserves precision without a float. Callers supply the (unit,
// max_val) numerator/denominator pair for whichever hand they want:
//
//   Hour hand:    unit = (hour % 12) * 60 + minute,       max_val = 720
//                 (12-hour face; one degree per 2 minutes of wall time)
//
//   Minute hand:  unit = minute * 60 + second,            max_val = 3600
//                 (one degree per 10 seconds of wall time)
//
//   Second hand:  unit = second * 1000 + subsecond_ms,    max_val = 60000
//                 (one degree per ~167 ms -- the subsecond_ms field is
//                  what makes this smooth rather than stepped; the
//                  compositor latches present timestamps at monotonic-
//                  ns precision, so a 60Hz render loop lands one
//                  subsecond_ms bucket every frame)
//
// Refuses max_val == 0 by returning 0 and bumping ANALOG_ST_REFUSED
// (defence-in-depth belt; all three call sites pass a non-zero literal
// so the refusal is a caller-side bug). Uses `imul r,r,imm` (three-
// operand form, which paideia-as supports for `imul rN, rN, imm32`)
// to multiply by 360 -- see ENCODER DISCIPLINE below for why the
// widgets/display sample avoids this instruction and this file needs it.
//
// -----------------------------------------------------------------------------
// RENDER FRAME -- 16 PLACEHOLDER PAINT CALLS PER FRAME
// -----------------------------------------------------------------------------
//
// analog_clock_render_frame(app_ptr, ui_ctx_row_id) issues sixteen
// widget_paint_rect calls per invocation:
//
//   1  face circle                (placeholder rect at center - radius)
//   12 hour ticks                 (30 degrees apart; placeholder rects
//                                  at (center_x + i, center_y, 2, 8) --
//                                  linear layout stands in for the
//                                  radial-arm computation the real
//                                  Vello face lands with G12.M2)
//   1  hour hand                  (compute_hand_angle result used as
//                                  the rect's h field for placeholder
//                                  visibility)
//   1  minute hand                (same shape as hour hand)
//   1  second hand                (uses subsecond_ms in the numerator
//                                  for smooth sweep-second motion)
//
// The paint calls all go through widget_paint_rect, which today only
// bumps a counter (widgets_stats[WIDGETS_ST_PAINTS]) without touching
// real pixels. The smoke-witness observation is that widget_paint_rect
// runs sixteen times per analog_clock_render_frame call: one face + 12
// ticks + 3 hands. When G12.M2 wires the real draw path, each of these
// call sites emits a real vector primitive without further code
// motion.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY 0xFFFFE920..0xFFFFE92F
// -----------------------------------------------------------------------------
//
// Repo-wide grep at landing time shows 0xFFFFE920..0xFFFFE92F entirely
// unclaimed across src/ and design/. 16 slots give headroom past the
// immediate refusal cases; the unused low half is reserved for the
// G12.M2 draw-wire follow-ups (ANALOG_SURFACE_UNBOUND, ANALOG_
// COLOR_INVALID, ...).
//
// Entry points return either a well-defined value (u64 pointer for
// analog_clock_new, u64 angle for compute_hand_angle) or unit for
// analog_clock_tick / analog_clock_render_frame. On refusal the entry
// point (a) bumps _analog_stats[ANALOG_ST_REFUSED] once, then
// (b) collapses the return to 0 (either as a NULL-ish pointer for
// new or a zero angle for compute_hand_angle). The ANALOG_* sentinels
// below are constants used internally for reasoning parity with
// sibling sample modules; external observers read the refused counter,
// not a returned sentinel.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Analog (PascalCase of the file basename
// analog.pdx). Labels prefixed `analog_`. No float, no FPU (see
// design/kernel/no-fpu.md); no `add reg,[mem]` (encoder-conservative
// load-inc-store). 32-bit loads use `mov_d` (zero-extending); 16-bit
// loads use `mov_w`; 8-bit loads use `mov_b`. Byte / word stores go
// through rax (the encoder's byte-store form takes only the low bits
// of the source register; sibling files consistently marshal through
// rax to keep the pattern uniform, so we do too).
//
// DIVERGENCE FROM SIBLING SAMPLES:
//
//   - `imul r,r,imm` IS used here (three-operand form, e.g.
//     `imul rax, rax, 360`). widgets.pdx / display.pdx / adaptive_
//     rate.pdx avoid this because their arithmetic is either a
//     power-of-two multiply (handled by `shl r, imm`) or a
//     precomputed offset. The analog clock cannot avoid it: the
//     hand-angle formula `unit * 360 / max_val` needs a multiply by
//     360, which is not a power of two. paideia-as supports the
//     three-op `imul rN, rN, imm32` form (present_feedback_kind.pdx
//     uses `imul r11, r11, 48` in its row-stride math, and
//     kind_tui_canvas.pdx / kind_pdxfs_file.pdx do likewise), so
//     this file emits it directly rather than synthesising a
//     multiply from a chain of shifts + adds.
//
//   - `div rcx` IS used here (for the time-derivation divide chain
//     and the hand-angle divide). Sibling sample apps have no
//     divide requirement so they never emit it. mkfs.pdx /
//     canvas_present.pdx / hpet.pdx / tsc.pdx all use the same
//     `xor rdx, rdx; div rN` pattern this file adopts.

module Analog = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, ranges, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let ANALOG_STRUCT_BYTES        : u64 = 32
  pub let ANALOG_OFF_SURFACE_KIND    : u64 = 0
  pub let ANALOG_OFF_CENTER_X        : u64 = 4
  pub let ANALOG_OFF_CENTER_Y        : u64 = 8
  pub let ANALOG_OFF_RADIUS          : u64 = 12
  pub let ANALOG_OFF_HOUR            : u64 = 14
  pub let ANALOG_OFF_MINUTE          : u64 = 15
  pub let ANALOG_OFF_SECOND          : u64 = 16
  pub let ANALOG_OFF_SUBSECOND_MS    : u64 = 18
  pub let ANALOG_OFF_FRAME_COUNT     : u64 = 24

  // Rect layout offsets (mirrored from widgets.pdx §Section 1; values
  // MUST match).
  pub let ANALOG_RECT_BYTES          : u64 = 16
  pub let ANALOG_RECT_OFF_X          : u64 = 0
  pub let ANALOG_RECT_OFF_Y          : u64 = 4
  pub let ANALOG_RECT_OFF_W          : u64 = 8
  pub let ANALOG_RECT_OFF_H          : u64 = 12

  // Face + tick + hand render constants.
  pub let ANALOG_TICK_COUNT          : u64 = 12
  pub let ANALOG_TICK_W              : u64 = 2
  pub let ANALOG_TICK_H              : u64 = 8
  pub let ANALOG_HAND_W              : u64 = 4

  // Time-derivation divisor constants.
  pub let ANALOG_NS_PER_MS           : u64 = 1000000
  pub let ANALOG_MS_PER_SEC          : u64 = 1000
  pub let ANALOG_SEC_PER_MIN         : u64 = 60
  pub let ANALOG_MIN_PER_HOUR        : u64 = 60
  pub let ANALOG_HOURS_PER_DAY       : u64 = 24
  pub let ANALOG_HOURS_ON_FACE       : u64 = 12
  pub let ANALOG_DEGREES_PER_TURN    : u64 = 360

  // Hand-angle max-value constants.
  //   HOUR:   (hour % 12) * 60 + minute, max = 12 * 60         = 720
  //   MINUTE: minute * 60 + second,      max = 60 * 60         = 3600
  //   SECOND: second * 1000 + submm,     max = 60 * 1000       = 60000
  pub let ANALOG_MAX_HOUR_UNIT       : u64 = 720
  pub let ANALOG_MAX_MINUTE_UNIT     : u64 = 3600
  pub let ANALOG_MAX_SECOND_UNIT     : u64 = 60000

  // u32 mask for i32/u32 field marshalling.
  pub let ANALOG_U32_MASK            : u64 = 0xFFFFFFFF

  // Failure sentinels 0xFFFFE920..0xFFFFE92F. Reserved for the future
  // G12.M2 draw-wire service-boundary promotion where a dispatcher
  // wants a distinct error surface; the current entry points collapse
  // refusal to a 0-shaped return + ANALOG_ST_REFUSED bump.
  pub let ANALOG_OK                  : u64 = 0
  pub let ANALOG_BAD_SURFACE         : u64 = 0xFFFFE92F   // surface_kind_id refused
  pub let ANALOG_BAD_APP_PTR         : u64 = 0xFFFFE92E   // app_ptr == 0
  pub let ANALOG_BAD_RADIUS          : u64 = 0xFFFFE92D   // radius_px == 0
  pub let ANALOG_BAD_HAND_MAX        : u64 = 0xFFFFE92C   // compute_hand_angle max_val == 0
  pub let ANALOG_BAD_CTX             : u64 = 0xFFFFE92B   // ctx_row_id invalid
  // 0xFFFFE920..0xFFFFE92A reserved for G12.M2 follow-ups.

  // ==========================================================================
  // Section 2  State: struct instance + stats quartet.
  // ==========================================================================
  //
  // _analog_clock holds THE ONE sample-owned AnalogClock instance.
  // A future landing that supports multiple concurrent clock samples
  // (each with its own surface) would promote this to an arena keyed
  // by client process cap; the current shape is single-instance
  // because the sample-app pattern this file follows (adaptive_rate/
  // main.pdx, settings/display.pdx) is one-shot per invocation.
  //
  // Sized to four u64 for the 32-byte struct; @align(64) puts it on
  // a cache line so the per-frame tick + render pipeline does not
  // stall on a partial-line fill.

  pub let mut _analog_clock : [u64; 4] = uninit @align(64)

  // Counter quartet for smoke-witness observability. Four slots:
  //   [ANALOG_ST_NEWS]      -- analog_clock_new invocations.
  //   [ANALOG_ST_TICKS]     -- analog_clock_tick calls that reached
  //                            the divide chain (bumped after the
  //                            gate, so counts only well-formed calls).
  //   [ANALOG_ST_RENDERS]   -- analog_clock_render_frame invocations
  //                            that reached the paint loop.
  //   [ANALOG_ST_REFUSED]   -- refused entry-point invocations across
  //                            all four public entry points.

  pub let mut _analog_stats : [u64; 4] = uninit @align(64)

  pub let ANALOG_ST_NEWS     : u64 = 0
  pub let ANALOG_ST_TICKS    : u64 = 1
  pub let ANALOG_ST_RENDERS  : u64 = 2
  pub let ANALOG_ST_REFUSED  : u64 = 3

  pub let analog_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): clear counter quartet at boot. Four u64 slots. Labels prefixed analog_sr_.",
      block: {
        lea r10, [rip + _analog_stats];
        xor rax, rax;
        xor rcx, rcx;
      analog_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  analog_sr_top;
        ret
      }
    }

  pub let analog_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed analog_nt_.",
      block: {
        cmp rdi, 4;
        jae analog_nt_out;
        lea r10, [rip + _analog_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      analog_nt_out:
        ret
      }
    }

  pub let analog_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): counter read. Labels prefixed analog_st_.",
      block: {
        cmp rdi, 4;
        jae analog_st_zero;
        lea r10, [rip + _analog_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      analog_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  analog_clock_compute_hand_angle -- pure hand-angle helper.
  // ==========================================================================
  //
  // analog_clock_compute_hand_angle(unit, max_val) -> u64
  //
  // Returns (unit * 360) / max_val. Multiplies FIRST so the integer
  // division preserves precision (small inputs stay small: unit=1,
  // max=720 -> (1*360)/720 = 0; unit=1, max=60 -> (1*360)/60 = 6).
  //
  // Refuses max_val == 0 by returning 0 (silent -- all three known
  // call sites pass a non-zero literal, so refusal is a caller-side
  // bug the sample refuses to paper over). No callee-save pushes
  // needed (no nested calls; rax/rcx/rdx are caller-save).
  //
  // Uses the three-operand `imul rax, rax, 360` form. This is a
  // deliberate divergence from the sibling sample apps -- see the
  // module header's DIVERGENCE FROM SIBLING SAMPLES note.

  pub let analog_clock_compute_hand_angle : (u64, u64) -> u64 !{} @{} =
    fn (unit: u64) (max_val: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): angle = (unit * 360) / max_val. `imul rax, rax, 360` (three-op form paideia-as supports). `xor rdx, rdx; div rcx` for the unsigned 64-bit quotient. Refuses max_val == 0 by returning 0. No nested calls -> no push discipline. Labels prefixed analog_ha_.",
      block: {
        cmp rsi, 0;
        je  analog_ha_zero;
        mov rax, rdi;
        imul rax, rax, 360;
        xor rdx, rdx;
        mov rcx, rsi;
        div rcx;
        ret;
      analog_ha_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 4  analog_clock_new -- factory.
  // ==========================================================================
  //
  // analog_clock_new(surface_kind_id, center_x, center_y, radius_px)
  //     -> u64  (pointer to _analog_clock, or 0 on refusal)
  //
  // Zeros the 32-byte struct, then writes the four factory fields:
  //   [+0]  surface_kind_id (u32, low 32 bits of rdi)
  //   [+4]  center_x        (i32, low 32 bits of rsi)
  //   [+8]  center_y        (i32, low 32 bits of rdx)
  //   [+12] radius_px       (u16, low 16 bits of rcx)
  //
  // Refuses:
  //   - surface_kind_id == 0                 -> ANALOG_BAD_SURFACE
  //   - surface_kind_id > u32::MAX           -> ANALOG_BAD_SURFACE
  //   - radius_px == 0                       -> ANALOG_BAD_RADIUS
  //
  // On any refusal, bumps ANALOG_ST_REFUSED and returns 0 (a NULL-ish
  // pointer the caller treats as "factory failed, do not proceed").
  // Bumps ANALOG_ST_NEWS on success.

  pub let analog_clock_new : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) (center_x: u64) (center_y: u64) (radius_px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): factory. Five callee-save pushes (rbx=struct base, r12=surface_kind_id, r13=center_x, r14=center_y, r15=radius_px) = 40 bytes: entry rsp%16 == 8, +40 = %16 == 0 for the analog_note call. No stack scratch needed. Refuses: surface == 0 or > u32::MAX, radius == 0. Byte-store discipline: all field stores marshalled through rax to match the sibling display.pdx / adaptive_rate.pdx pattern. Labels prefixed analog_nw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  r12, rdi;                    // surface_kind_id
        mov  r13, rsi;                    // center_x
        mov  r14, rdx;                    // center_y
        mov  r15, rcx;                    // radius_px

        // Gate: surface_kind_id nonzero + fits in u32.
        cmp  r12, 0;
        je   analog_nw_refused;
        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        ja   analog_nw_refused;

        // Gate: radius_px nonzero.
        cmp  r15, 0;
        je   analog_nw_refused;

        // Zero the 32-byte struct.
        lea  rbx, [rip + _analog_clock];
        xor  rax, rax;
        mov  [rbx + 0],  rax;
        mov  [rbx + 8],  rax;
        mov  [rbx + 16], rax;
        mov  [rbx + 24], rax;

        // Seed surface_kind_id (low 32 bits) at [+0].
        mov  rax, r12;
        mov_d [rbx + 0], rax;

        // Seed center_x (low 32 bits) at [+4].
        mov  rax, r13;
        mov_d [rbx + 4], rax;

        // Seed center_y (low 32 bits) at [+8].
        mov  rax, r14;
        mov_d [rbx + 8], rax;

        // Seed radius_px (low 16 bits) at [+12].
        mov  rax, r15;
        mov_w [rbx + 12], rax;

        // Bump ANALOG_ST_NEWS and return the struct base pointer.
        mov  rdi, 0;                      // ANALOG_ST_NEWS
        call analog_note;

        lea  rax, [rip + _analog_clock];
        jmp  analog_nw_out;

      analog_nw_refused:
        mov  rdi, 3;                      // ANALOG_ST_REFUSED
        call analog_note;
        xor  rax, rax;

      analog_nw_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 5  analog_clock_tick -- derive (H, M, S, subsecond_ms) from ns.
  // ==========================================================================
  //
  // analog_clock_tick(app_ptr, nsec) -> ()
  //
  // Walks the divide chain documented in the module header
  // §TIME DERIVATION and writes the four derived fields back into
  // the struct at [+14..+19]:
  //
  //   nsec ->/1e6 ms_total
  //   ms_total ->/1000 sec_total, rem -> subsecond_ms (u16) @ [+18]
  //   sec_total ->/60  min_total, rem -> current_second (u8) @ [+16]
  //   min_total ->/60  hour_total, rem -> current_minute (u8) @ [+15]
  //   hour_total ->/24 (discarded), rem -> current_hour (u8) @ [+14]
  //
  // frame_count at [+24] is NOT touched by tick (that is the render
  // pipeline's counter). Bumps ANALOG_ST_TICKS.
  //
  // Refuses app_ptr == 0 silently (bumps ANALOG_ST_REFUSED; the caller
  // passed a bad pointer, a caller-side bug the sample refuses to
  // paper over). No sentinel returned -- the function is unit-typed.

  pub let analog_clock_tick : (u64, u64) -> () !{mem} @{} =
    fn (app_ptr: u64) (nsec: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): five-stage divide chain. Two callee-save pushes (rbx=app_ptr, r12=scratch across the note call at the end) = 16 bytes: entry rsp%16 == 8, +16 = %16 == 8; no aligned nested call happens during the divide chain (divides do not need alignment), so we only pad before the final note call. The rem-then-store pattern marshals each remainder through rax before mov_b/mov_w (sibling files consistently store byte / word values from rax). Labels prefixed analog_tk_.",
      block: {
        push rbx;
        push r12;

        cmp  rdi, 0;
        je   analog_tk_refused;

        mov  rbx, rdi;                    // app_ptr

        // ----- Stage 1: nsec / 1_000_000 -> ms_total (rax).
        mov  rax, rsi;
        xor  rdx, rdx;
        mov  rcx, 1000000;                // ANALOG_NS_PER_MS
        div  rcx;                         // rax = ms_total (rdx = sub-ms rem, discarded)

        // ----- Stage 2: ms_total / 1000 -> sec_total (rax), rem -> subsecond_ms.
        xor  rdx, rdx;
        mov  rcx, 1000;                   // ANALOG_MS_PER_SEC
        div  rcx;                         // rax = sec_total, rdx = subsecond_ms (0..999)
        mov  r12, rax;                    // stash sec_total (rax about to be reused)
        mov  rax, rdx;                    // subsecond_ms -> rax for mov_w store
        mov_w [rbx + 18], rax;            // subsecond_ms (u16) at [+18]

        // ----- Stage 3: sec_total / 60 -> min_total (rax), rem -> current_second.
        mov  rax, r12;                    // reload sec_total
        xor  rdx, rdx;
        mov  rcx, 60;                     // ANALOG_SEC_PER_MIN
        div  rcx;                         // rax = min_total, rdx = current_second (0..59)
        mov  r12, rax;                    // stash min_total
        mov  rax, rdx;                    // current_second -> rax
        mov_b [rbx + 16], rax;            // current_second (u8) at [+16]

        // ----- Stage 4: min_total / 60 -> hour_total (rax), rem -> current_minute.
        mov  rax, r12;                    // reload min_total
        xor  rdx, rdx;
        mov  rcx, 60;                     // ANALOG_MIN_PER_HOUR
        div  rcx;                         // rax = hour_total, rdx = current_minute (0..59)
        mov  r12, rax;                    // stash hour_total
        mov  rax, rdx;                    // current_minute -> rax
        mov_b [rbx + 15], rax;            // current_minute (u8) at [+15]

        // ----- Stage 5: hour_total / 24 -> discarded, rem -> current_hour.
        mov  rax, r12;                    // reload hour_total
        xor  rdx, rdx;
        mov  rcx, 24;                     // ANALOG_HOURS_PER_DAY
        div  rcx;                         // rax discarded, rdx = current_hour (0..23)
        mov  rax, rdx;                    // current_hour -> rax
        mov_b [rbx + 14], rax;            // current_hour (u8) at [+14]

        // Bump ANALOG_ST_TICKS. rsp%16 == 8 currently (2 pushes) so pad.
        sub  rsp, 8;
        mov  rdi, 1;                      // ANALOG_ST_TICKS
        call analog_note;
        add  rsp, 8;
        jmp  analog_tk_out;

      analog_tk_refused:
        sub  rsp, 8;
        mov  rdi, 3;                      // ANALOG_ST_REFUSED
        call analog_note;
        add  rsp, 8;

      analog_tk_out:
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  analog_clock_render_frame -- 16-call placeholder render.
  // ==========================================================================
  //
  // analog_clock_render_frame(app_ptr, ui_ctx_row_id) -> ()
  //
  // Emits sixteen widget_paint_rect calls per the §RENDER FRAME plan
  // in the module header. Bumps frame_count at [+24] and ANALOG_ST_
  // RENDERS.
  //
  // Refuses app_ptr == 0 silently (bumps ANALOG_ST_REFUSED). The
  // ui_ctx_row_id argument is passed straight to widget_paint_rect;
  // widget_paint_rect is NULL-tolerant on its rect and self-gates on
  // rect validity, so a bad ctx_row_id surfaces as "no widget
  // interaction" at the widget layer without adding a gate here.
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+15]  WidgetRect scratch (x/y/w/h as four i32).
  //   Callee-save pushes: rbx=app_ptr, r12=ui_ctx_row_id,
  //   r13=loop-scratch (tick iterator; hand angles across calls),
  //   r14=center_x, r15=center_y.
  //   Entry rsp%16 == 8; five pushes (%16 == 0) + sub rsp,16 (%16 == 0).

  pub let analog_clock_render_frame : (u64, u64) -> () !{mem} @{} =
    fn (app_ptr: u64) (ui_ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): 16-call placeholder render. Five callee-save pushes + sub rsp,16 lands rsp%16 == 0 (entry %16 == 8; +40 push + 16 sub = %16 == 0). Rect scratch at [rsp+0..+15]. r14/r15 hold center_x/center_y (loaded once, referenced across all 16 paint calls). r13 doubles as the tick loop iterator (0..12) and as the hand-angle stash across the 3 hand paint calls. Labels prefixed analog_rf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 16;

        cmp  rdi, 0;
        je   analog_rf_refused;

        mov  rbx, rdi;                    // app_ptr
        mov  r12, rsi;                    // ui_ctx_row_id

        // Bump ANALOG_ST_RENDERS.
        mov  rdi, 2;                      // ANALOG_ST_RENDERS
        call analog_note;

        // frame_count at [+24] += 1.
        mov  rax, [rbx + 24];
        add  rax, 1;
        mov  [rbx + 24], rax;

        // Load center_x (i32, zero-extended) and center_y into r14/r15.
        mov_d r14, [rbx + 4];             // center_x
        mov_d r15, [rbx + 8];             // center_y

        // ---------------------------------------------------------------------
        // (1) Face: rect at (center_x, center_y, 2*radius, 2*radius).
        //     Placeholder -- the real face is a Vello vector circle
        //     landing with G12.M2.
        // ---------------------------------------------------------------------
        mov_d [rsp + 0], r14;             // rect.x = center_x
        mov_d [rsp + 4], r15;             // rect.y = center_y
        mov_w rax, [rbx + 12];            // radius_px (zero-extended)
        add  rax, rax;                    // 2 * radius
        mov_d [rsp + 8], rax;             // rect.w
        mov_d [rsp + 12], rax;            // rect.h

        mov  rdi, r12;                    // ctx_row
        lea  rsi, [rsp + 0];              // rect_ptr
        xor  rdx, rdx;                    // color (placeholder 0)
        call widget_paint_rect;

        // ---------------------------------------------------------------------
        // (2..13) Twelve hour ticks. Placeholder linear layout:
        //     rect_i at (center_x + i, center_y, ANALOG_TICK_W, ANALOG_TICK_H)
        // The real 30-degree-apart radial layout lands with G12.M2 once
        // the vector-primitive draw path exists.
        // ---------------------------------------------------------------------
        xor  r13, r13;                    // i = 0
      analog_rf_tick_top:
        cmp  r13, 12;                     // ANALOG_TICK_COUNT
        jae  analog_rf_ticks_done;

        mov  rax, r14;                    // center_x
        add  rax, r13;                    // + i
        mov_d [rsp + 0], rax;             // rect.x
        mov_d [rsp + 4], r15;             // rect.y = center_y
        mov  rax, 2;                      // ANALOG_TICK_W
        mov_d [rsp + 8], rax;
        mov  rax, 8;                      // ANALOG_TICK_H
        mov_d [rsp + 12], rax;

        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        call widget_paint_rect;

        add  r13, 1;
        jmp  analog_rf_tick_top;
      analog_rf_ticks_done:

        // ---------------------------------------------------------------------
        // (14) Hour hand.
        //     unit = (hour % 12) * 60 + minute, max = 720.
        //     Placeholder rect: x=center_x, y=center_y, w=4,
        //                       h=angle_deg (visible variation).
        // ---------------------------------------------------------------------
        mov_b rax, [rbx + 14];            // current_hour
        xor  rdx, rdx;
        mov  rcx, 12;                     // ANALOG_HOURS_ON_FACE
        div  rcx;                         // rax = hour/12, rdx = hour%12
        mov  rax, rdx;                    // rax = hour%12
        imul rax, rax, 60;                // (hour%12) * 60
        mov_b rcx, [rbx + 15];            // current_minute
        add  rax, rcx;                    // unit
        mov  rdi, rax;
        mov  rsi, 720;                    // ANALOG_MAX_HOUR_UNIT
        call analog_clock_compute_hand_angle;
        mov  r13, rax;                    // stash angle_deg for the rect emit

        mov_d [rsp + 0], r14;             // rect.x = center_x
        mov_d [rsp + 4], r15;             // rect.y = center_y
        mov  rax, 4;                      // ANALOG_HAND_W
        mov_d [rsp + 8], rax;
        mov_d [rsp + 12], r13;            // rect.h = angle_deg

        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        call widget_paint_rect;

        // ---------------------------------------------------------------------
        // (15) Minute hand.
        //     unit = minute * 60 + second, max = 3600.
        // ---------------------------------------------------------------------
        mov_b rax, [rbx + 15];            // current_minute
        imul rax, rax, 60;
        mov_b rcx, [rbx + 16];            // current_second
        add  rax, rcx;
        mov  rdi, rax;
        mov  rsi, 3600;                   // ANALOG_MAX_MINUTE_UNIT
        call analog_clock_compute_hand_angle;
        mov  r13, rax;

        mov_d [rsp + 0], r14;
        mov_d [rsp + 4], r15;
        mov  rax, 4;
        mov_d [rsp + 8], rax;
        mov_d [rsp + 12], r13;

        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        call widget_paint_rect;

        // ---------------------------------------------------------------------
        // (16) Second hand with subsecond interpolation.
        //     unit = second * 1000 + subsecond_ms, max = 60000.
        //     The subsecond_ms field is what makes this smooth --
        //     the compositor's monotonic-ns present timestamps produce
        //     a distinct subsecond_ms per frame at any refresh rate
        //     >= 1kHz (well above 60/120/240 Hz targets).
        // ---------------------------------------------------------------------
        mov_b rax, [rbx + 16];            // current_second
        imul rax, rax, 1000;
        mov_w rcx, [rbx + 18];            // subsecond_ms
        add  rax, rcx;
        mov  rdi, rax;
        mov  rsi, 60000;                  // ANALOG_MAX_SECOND_UNIT
        call analog_clock_compute_hand_angle;
        mov  r13, rax;

        mov_d [rsp + 0], r14;
        mov_d [rsp + 4], r15;
        mov  rax, 4;
        mov_d [rsp + 8], rax;
        mov_d [rsp + 12], r13;

        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        call widget_paint_rect;

        jmp  analog_rf_out;

      analog_rf_refused:
        mov  rdi, 3;                      // ANALOG_ST_REFUSED
        call analog_note;

      analog_rf_out:
        add  rsp, 16;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Boot init.
  // ==========================================================================
  //
  // Zero the stats quartet once at library init. The struct instance
  // itself is initialised by the first analog_clock_new call (which
  // happens when a real client opens the clock sample); there is no
  // need to seed defaults at boot before any consumer exists.

  pub let analog_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-10 (#2335): call through to analog_stats_reset for one clean counter zero-out. Labels prefixed analog_i_.",
      block: {
        call analog_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the client once analog_init has
  // been called and the first analog_clock_new succeeds (G12.M2 klog
  // wire will emit; until then this is a compile-time literal). Follows
  // the pdx_kind_<name>_meta legacy-suffix convention shared with
  // widgets.pdx / display.pdx / adaptive_rate.pdx.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B13 G12.M4-001 (#2335) analog clock sample +
  // G12.M2 draw-wire klog emission pending". The main coordinator
  // adds that allowlist entry at Batch 13 close-out, mirroring the
  // adaptive_rate / display sample allowlist landings at B11 / B12
  // close.
  //
  // Length: "clock analog ready ok [legacy: CLOCK ANALOG READY OK]\0"
  //   = 53 characters + NUL = 54 bytes (strlen+1 rule).
  pub let pdx_kind_clock_analog_meta : [u8; 54] = "clock analog ready ok [legacy: CLOCK ANALOG READY OK]\0"
}
