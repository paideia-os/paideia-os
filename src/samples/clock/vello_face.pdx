// src/samples/clock/vello_face.pdx -- Wave0-B15 G12-M3-002 (paideia-os #2335)
//
// SAMPLE APP -- VELLO-STYLE ANALOG CLOCK FACE (path-command stream).
//
// Design authority: design/roadmap/next-wave-softarch.md sect G12 toolkit
// stack and design/roadmap/next-wave-synthesis.md line 91 (G4 = `g4-vello-
// 2d`, compute-based 2D rasterization in the Vello sort-middle lineage --
// path IR + Bezier flattening + per-tile scanline blend -- landing as
// `KIND_VELLO_SCENE` / `KIND_VELLO_RENDERER`, both still unallocated).
//
// SIBLING, NOT REPLACEMENT. clock/analog.pdx (Wave0-B13-10, #2335) paints
// the same twelve-tick, three-hand analog face through libpaideia_ui's
// widgets.pdx immediate-mode RECT painter -- a software-raster
// placeholder. This file paints the identical face through a DIFFERENT
// substrate: a Vello-shape PATH-COMMAND STREAM (move/line/curve/close +
// fill/stroke + an affine transform, captured into a fixed-size ring
// rather than rasterized inline). The user picks the face at boot via a
// KIND_UI_CONTEXT toggle (a future settings-panel concern, out of scope
// here); both faces coexist as independent modules sharing nothing but
// the KIND_UI_CONTEXT substrate they both mint against.
//
// NOVEL-CLEAN POSTURE. Real Vello (Levien, piet-gpu/Vello, 2020-2024)
// sorts path-fill commands into per-tile GPU compute passes. This
// landing does not submit to a GPU -- there is no `KIND_GPU_CONTEXT`
// consumer yet (`KIND_VELLO_RENDERER` derives over it per next-wave-
// synthesis.md line 183). What IS novel-clean here is the COMMAND
// STREAM SHAPE: a flat, fixed-stride, GPU-friendly encoding (opcode +
// up to three f64 payload words per record) a future R37 GPU-context
// consumer can drain byte-for-byte without a re-encode. `vello_face_
// main` emits that stream through libpaideia_ui immediate-mode
// conventions (mint KIND_UI_CONTEXT, bracket one frame with begin/
// end_frame) and returns -- no pixel is ever touched this landing,
// exactly as analog.pdx's own placeholder painter touches none either.
//
// PAINT-ONCE SCOPE. `vello_face_main` builds and "renders" exactly ONE
// frame at a fixed demo time (10:10:30 -- the classic watch-catalog
// "ten-ten" pose, extended with :30 so the second hand shows a third
// distinct direction) and returns. Full 60Hz animation on a real time
// source is future work -- see the two RESERVED sentinels below.
//
// -----------------------------------------------------------------------------
// COMMAND BUFFER SCHEMA -- FIXED 4KiB RING, 32 BYTES/RECORD
// -----------------------------------------------------------------------------
//
// `_vello_cmd_buf` is a flat `[u64; 512]` blob (4096 bytes). Each record
// is four consecutive u64 words: [+0] opcode, [+8] arg0, [+16] arg1,
// [+24] arg2. VELLO_CMD_MAX = 4096/32 = 128 records. "Ring" names the
// fixed-capacity, GPU-drainable SHAPE a future streaming consumer wants;
// this paint-once frame writes 46 records (1 transform + 12*3 ticks +
// 3*3 hands), well under the cap, so no wraparound exists yet --
// `cmd_append` REFUSES (VFF_CMD_BUFFER_FULL) rather than overwrite.
//
// Payload meaning per opcode (all "f64" fields are literal IEEE-754
// double bit patterns moved with plain integer `mov` -- see ENCODER
// DISCIPLINE for why no float instruction ever executes here):
//
//   MOVETO/LINETO   arg0=x, arg1=y, arg2=0
//   STROKE          arg0=width (f64), arg1=ARGB color (u64, not f64)
//   FILL            arg0=ARGB color -- declared, NOT emitted (ticks and
//                   hands are open strokes, not filled shapes)
//   SET_TRANSFORM   arg0=uniform scale, arg1=tx, arg2=ty (f64s) -- a
//                   full 2x3 affine needs six numbers (rotate/shear +
//                   translate); this face needs neither rotation nor
//                   shear, only scale+recenter, so three numbers fit
//                   ONE record with no schema widening. A future tilted
//                   face would need a two-record SET_TRANSFORM_FULL.
//   CURVETO         declared (opcode 2), NOT emitted -- a cubic/
//                   quadratic Bezier needs 6-8 numbers, more than this
//                   record's 3-word payload holds; ticks/hands are
//                   straight segments so none is needed here. A real
//                   emission would span two records, mirroring SET_
//                   TRANSFORM's "one opcode, whatever width it needs".
//   CLOSE           declared (opcode 3), NOT emitted -- ticks/hands are
//                   open segments, never closed subpaths.
//
// -----------------------------------------------------------------------------
// GEOMETRY -- 30-DEGREE LOOKUP TABLES, NO RUNTIME TRIG, NO FPU
// -----------------------------------------------------------------------------
//
// paideia-as has no FP intrinsics yet (no sin/cos; this file also avoids
// the newly-landed f32/f64 SSE encoder entirely -- see ENCODER
// DISCIPLINE). Every coordinate is a compile-time IEEE-754 double BIT
// PATTERN, stored as a plain u64 and moved with integer `mov` -- never
// an xmm register or float opcode. The twelve clock positions (0, 30,
// ..., 330 deg) collapse to four magnitudes under symmetry (0, 1/2,
// sqrt(3)/2, 1), derived once offline (Python `struct.pack("<d", v)`),
// never approximated by a runtime sin/cos.
//
// CLOCK-POSITION CONVENTION. Index i (0..11) IS "i o'clock": screen-Y
// grows downward, so index 0 (12 o'clock) is (x=0, y=-1), stepping 30
// degrees clockwise per index: x[i]=sin(30i deg), y[i]=-cos(30i deg).
// This lets the tick loop (i=0..11 directly) and the three hands (see
// DEMO TIME) share one indexing scheme: the hour hand's index IS its
// clock hour (mod 12); minute/second hands use value/5 (12 slots are
// 5 units apart, since 60/12=5).
//
// FOUR RADIUS TABLES. Ticks need two radii (inner base, outer rim); the
// three hands each need a different length (spec: hour 0.5, minute
// 0.85, second 0.92). The tick's inner radius is deliberately CHOSEN as
// 0.85 -- identical to the minute hand -- so one table serves both,
// cutting the geometry surface from a naive 5 tables to 4:
//
//   VELLO_RADIUS_100 (1.00)  tick outer rim
//   VELLO_RADIUS_085 (0.85)  tick inner base  AND  minute-hand tip
//   VELLO_RADIUS_050 (0.50)  hour-hand tip
//   VELLO_RADIUS_092 (0.92)  second-hand tip
//
// Each radius contributes an X and Y array (eight `[u64; 12]` `pub let`
// constants total -- immutable, data-only, no init-time computation).
// `vello_face_dir_xy_bits` dispatches on `radius_id` (0..3) and copies
// both words to a caller-supplied 16-byte scratch slot in one call, so
// emit_tick/emit_hand hold only two or three values across nested calls.
//
// -----------------------------------------------------------------------------
// DEMO TIME -- FIXED 10:10:30, PAINT-ONCE (no KIND_WALL_CLOCK yet)
// -----------------------------------------------------------------------------
//
// Same gap analog.pdx's and timezone.pdx's own headers document: no
// KIND_WALL_CLOCK cap exists yet. A single static frame has no elapsed
// time to derive from, so this sample just embeds a fixed demo time
// (VFF_DEMO_HOUR=10, _MINUTE=10, _SECOND=30) and computes exact indices:
//
//     hour_index = demo_hour % 12        minute_index = demo_minute / 5
//     second_index = demo_second / 5
//
// giving (10, 2, 6) for 10:10:30. `VFF_TIME_UNAVAILABLE` is reserved for
// a future KIND_WALL_CLOCK refusal (not returned this landing, mirroring
// timezone.pdx's `CTZ_TIME_UNAVAILABLE`). `VFF_REFUSED_DENSE` is
// reserved for a future 60Hz per-tick re-render whose ring might still
// hold a prior frame's undrained records; this single paint-once call
// never re-enters render_frame, so it is never returned either.
//
// -----------------------------------------------------------------------------
// KIND_UI_CONTEXT MINT -- PLACEHOLDER WINDOW/SURFACE
// -----------------------------------------------------------------------------
//
// `ui_context_new(window, surface)` (immediate_context.pdx, Wave0-B8-05,
// KIND_UI_CONTEXT=0x1D5) demands a live KIND_WINDOW + KIND_SURFACE pair.
// No window manager wires a real pair through to sample-app launch yet
// -- the identical gap timezone.pdx's header documents. This file mints
// against the same placeholder convention (window=surface=1) that file
// established; a future landing that threads a real pair through swaps
// two literals without touching anything else here.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY 0xFFFFE8E0..0xFFFFE8EF
// -----------------------------------------------------------------------------
//
// Repo-wide grep at landing time shows the page entirely unclaimed.
//
//   VFF_OK                (0x00000000) success.
//   VFF_NOT_INIT          (0xFFFFE8EF) render_frame before main seeded
//                                      ready_flag.
//   VFF_NULL              (0xFFFFE8EE) app_ptr == 0.
//   VFF_UI_CTX_MINT_FAIL  (0xFFFFE8ED) ui_context_new refused.
//   VFF_CMD_BUFFER_FULL   (0xFFFFE8EC) cmd_count >= VELLO_CMD_MAX (128).
//   VFF_TICK_OUT_OF_RANGE (0xFFFFE8EB) bad radius_id or index >= 12.
//   VFF_TIME_UNAVAILABLE  (0xFFFFE8EA) RESERVED, not returned.
//   VFF_REFUSED_DENSE     (0xFFFFE8E9) RESERVED, not returned.
//   0xFFFFE8E0..0xFFFFE8E8 reserved for follow-ups.
//
// Every refusing entry point bumps VFF_ST_REFUSED once and returns the
// sentinel above, or propagates a callee's sentinel verbatim via `cmp
// rax, 0; jne <out>` -- the callee already placed its precise code in
// rax, so no re-encoding is needed at the caller.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = VelloFace (basename PascalCase). Labels
// prefixed `vello_face_<fn-abbrev>_`. No float/FPU/xmm anywhere -- every
// "f64" is a u64 bit pattern moved with integer `mov`. No `test rN,rN`
// (uses `cmp rN,0`). No `and r11,imm64`. No 2-op `imul` (byte offsets
// use `shl r10,5` for the *32 stride -- no non-power-of-two multiply
// exists in this file). No `neg`/`cqo`/`idiv` (both divides -- hour%12,
// minute-or-second/5 -- are unsigned `xor rdx,rdx; div rcx`, never
// negative). No `add reg,[mem]` (load-add-store throughout). Every
// unsafe lambda takes at most five args (cmd_append, emit_hand), under
// the six-arg SysV budget. No label named a reserved keyword.
//
// BYTE/WORD LOAD ZERO-EXTENSION GOTCHA. `mov_b`/`mov_w` do NOT auto
// zero-extend on LOAD the way `mov_d` (32-bit) architecturally does on
// amd64 -- `mov_b rax, [mem]` is the literal `mov al, [mem]`, leaving
// bits 8..63 of rax unchanged (see kernel/acpi/checksum.pdx and madt.pdx,
// which document this explicitly). Every byte-field LOAD here is
// preceded by an explicit `xor reg,reg`. Stores have no such hazard.
//
// SysV: rsp%16==0 immediately before every CALL; entry is always
// rsp%16==8, so an odd push count (or an explicit `sub rsp,N` pad)
// reaches 0 before any nested call -- each function states its own
// push/pad arithmetic.

module VelloFace = structure {

  // ==========================================================================
  // Section 1  Constants: opcodes, command-buffer schema, radii, struct
  // layout, demo time, geometry bit patterns, colors, failure taxonomy.
  // ==========================================================================

  // ---- Path primitives (data-only opcode decls; see COMMAND BUFFER
  // SCHEMA above for which are actually emitted this landing). ----
  pub let VELLO_CMD_MOVETO        : u64 = 0
  pub let VELLO_CMD_LINETO        : u64 = 1
  pub let VELLO_CMD_CURVETO       : u64 = 2   // declared, not emitted
  pub let VELLO_CMD_CLOSE         : u64 = 3   // declared, not emitted
  pub let VELLO_CMD_FILL          : u64 = 4   // declared, not emitted
  pub let VELLO_CMD_STROKE        : u64 = 5
  pub let VELLO_CMD_SET_TRANSFORM : u64 = 6

  // ---- Command-buffer schema. ----
  pub let VELLO_CMD_BYTES         : u64 = 32
  pub let VELLO_CMD_BUF_BYTES     : u64 = 4096
  pub let VELLO_CMD_MAX           : u64 = 128        // 4096 / 32
  pub let VELLO_CMD_OFF_OPCODE    : u64 = 0
  pub let VELLO_CMD_OFF_ARG0      : u64 = 8
  pub let VELLO_CMD_OFF_ARG1      : u64 = 16
  pub let VELLO_CMD_OFF_ARG2      : u64 = 24

  // ---- Radius-table selectors (see GEOMETRY above). ----
  pub let VELLO_RADIUS_100        : u64 = 0
  pub let VELLO_RADIUS_085        : u64 = 1
  pub let VELLO_RADIUS_050        : u64 = 2
  pub let VELLO_RADIUS_092        : u64 = 3
  pub let VELLO_DIR_COUNT         : u64 = 12

  // ---- _vello_face_app struct layout -- 32 BYTES (four u64 words). ----
  //   [+0..+3]  ui_ctx_row_id      : u32   KIND_UI_CONTEXT row this app
  //                                        renders into.
  //   [+4]      demo_hour          : u8    fixed demo wall-clock hour.
  //   [+5]      demo_minute        : u8
  //   [+6]      demo_second        : u8
  //   [+7]      ready_flag         : u8    0 until vello_face_main seeds
  //                                        the struct; render_frame
  //                                        refuses VFF_NOT_INIT if 0.
  //   [+8..+15] cmd_write_offset   : u64   bytes written into the ring
  //                                        so far (observability only;
  //                                        cmd_count is authoritative).
  //   [+16..+23] cmd_count         : u64   records written this frame.
  //   [+24..+31] frame_count       : u64   monotone render_frame counter
  //                                        (settles at 1 for this
  //                                        paint-once sample).
  pub let VFF_STRUCT_BYTES         : u64 = 32
  pub let VFF_OFF_UI_CTX           : u64 = 0
  pub let VFF_OFF_DEMO_HOUR        : u64 = 4
  pub let VFF_OFF_DEMO_MINUTE      : u64 = 5
  pub let VFF_OFF_DEMO_SECOND      : u64 = 6
  pub let VFF_OFF_READY            : u64 = 7
  pub let VFF_OFF_CMD_WRITE_OFFSET : u64 = 8
  pub let VFF_OFF_CMD_COUNT        : u64 = 16
  pub let VFF_OFF_FRAME_COUNT      : u64 = 24

  // ---- Demo time + index-derivation constants (see DEMO TIME above). ----
  pub let VFF_DEMO_HOUR            : u64 = 10
  pub let VFF_DEMO_MINUTE          : u64 = 10
  pub let VFF_DEMO_SECOND          : u64 = 30
  pub let VFF_HOUR_MOD             : u64 = 12
  pub let VFF_MINSEC_STEP          : u64 = 5

  // ---- KIND_UI_CONTEXT mint placeholders + row-sentinel floor. ----
  pub let VFF_PLACEHOLDER_WINDOW   : u64 = 1
  pub let VFF_PLACEHOLDER_SURFACE  : u64 = 1
  pub let VFF_UI_ROW_SENTINEL_MIN  : u64 = 8         // UI_MAX (immediate_context.pdx)

  // ---- Transform + stroke + color bit-pattern constants (IEEE-754
  // doubles as raw u64, per GEOMETRY above; colors are plain ARGB u64s,
  // never floats). ----
  pub let VELLO_ZERO_BITS          : u64 = 0x0000000000000000
  pub let VELLO_SCALE_BITS         : u64 = 0x4059000000000000   // 100.0
  pub let VELLO_CENTER_X_BITS      : u64 = 0x4064000000000000   // 160.0
  pub let VELLO_CENTER_Y_BITS      : u64 = 0x405E000000000000   // 120.0
  pub let VELLO_TICK_STROKE_BITS   : u64 = 0x3F947AE147AE147B   // 0.02
  pub let VELLO_HOUR_STROKE_BITS   : u64 = 0x3FA999999999999A   // 0.05
  pub let VELLO_MINUTE_STROKE_BITS : u64 = 0x3FA1EB851EB851EC   // 0.035
  pub let VELLO_SECOND_STROKE_BITS : u64 = 0x3F947AE147AE147B   // 0.02 (== tick)
  pub let VELLO_COLOR_BLACK        : u64 = 0xFF000000
  pub let VELLO_COLOR_RED          : u64 = 0xFFFF0000

  // ---- Failure taxonomy 0xFFFFE8E0..0xFFFFE8EF (see above). ----
  pub let VFF_OK                   : u64 = 0
  pub let VFF_NOT_INIT             : u64 = 0xFFFFE8EF
  pub let VFF_NULL                 : u64 = 0xFFFFE8EE
  pub let VFF_UI_CTX_MINT_FAIL     : u64 = 0xFFFFE8ED
  pub let VFF_CMD_BUFFER_FULL      : u64 = 0xFFFFE8EC
  pub let VFF_TICK_OUT_OF_RANGE    : u64 = 0xFFFFE8EB
  pub let VFF_TIME_UNAVAILABLE     : u64 = 0xFFFFE8EA   // reserved
  pub let VFF_REFUSED_DENSE        : u64 = 0xFFFFE8E9   // reserved
  // 0xFFFFE8E0..0xFFFFE8E8 reserved for follow-ups.

  // ==========================================================================
  // Section 2  Geometry: four radius tables, 12 clock positions each.
  // ==========================================================================
  //
  // Each array is `x[i] = radius * sin(30*i deg)` or `y[i] = radius *
  // -cos(30*i deg)`, stored as the IEEE-754 double bit pattern of the
  // EXACT product (computed offline against the symbolic values 0,
  // 1/2, sqrt(3)/2, 1 -- never against a runtime-imprecise sin/cos
  // call). Index i is the clock position (0=12 o'clock, clockwise);
  // see CLOCK-POSITION CONVENTION above. All eight arrays are `pub let`
  // (immutable, data-only) -- no init-time computation, no mutable
  // state, no runtime float multiply anywhere in this section.

  pub let VELLO_DIR_R100_X : [u64; 12] = [
    0x0000000000000000, 0x3FE0000000000000, 0x3FEBB67AE8584CAA, 0x3FF0000000000000,
    0x3FEBB67AE8584CAA, 0x3FE0000000000000, 0x0000000000000000, 0xBFE0000000000000,
    0xBFEBB67AE8584CAA, 0xBFF0000000000000, 0xBFEBB67AE8584CAA, 0xBFE0000000000000
  ]
  pub let VELLO_DIR_R100_Y : [u64; 12] = [
    0xBFF0000000000000, 0xBFEBB67AE8584CAA, 0xBFE0000000000000, 0x0000000000000000,
    0x3FE0000000000000, 0x3FEBB67AE8584CAA, 0x3FF0000000000000, 0x3FEBB67AE8584CAA,
    0x3FE0000000000000, 0x0000000000000000, 0xBFE0000000000000, 0xBFEBB67AE8584CAA
  ]

  pub let VELLO_DIR_R085_X : [u64; 12] = [
    0x0000000000000000, 0x3FDB333333333333, 0x3FE78E4EDF17DAC4, 0x3FEB333333333333,
    0x3FE78E4EDF17DAC4, 0x3FDB333333333333, 0x0000000000000000, 0xBFDB333333333333,
    0xBFE78E4EDF17DAC4, 0xBFEB333333333333, 0xBFE78E4EDF17DAC4, 0xBFDB333333333333
  ]
  pub let VELLO_DIR_R085_Y : [u64; 12] = [
    0xBFEB333333333333, 0xBFE78E4EDF17DAC4, 0xBFDB333333333333, 0x0000000000000000,
    0x3FDB333333333333, 0x3FE78E4EDF17DAC4, 0x3FEB333333333333, 0x3FE78E4EDF17DAC4,
    0x3FDB333333333333, 0x0000000000000000, 0xBFDB333333333333, 0xBFE78E4EDF17DAC4
  ]

  pub let VELLO_DIR_R050_X : [u64; 12] = [
    0x0000000000000000, 0x3FD0000000000000, 0x3FDBB67AE8584CAA, 0x3FE0000000000000,
    0x3FDBB67AE8584CAA, 0x3FD0000000000000, 0x0000000000000000, 0xBFD0000000000000,
    0xBFDBB67AE8584CAA, 0xBFE0000000000000, 0xBFDBB67AE8584CAA, 0xBFD0000000000000
  ]
  pub let VELLO_DIR_R050_Y : [u64; 12] = [
    0xBFE0000000000000, 0xBFDBB67AE8584CAA, 0xBFD0000000000000, 0x0000000000000000,
    0x3FD0000000000000, 0x3FDBB67AE8584CAA, 0x3FE0000000000000, 0x3FDBB67AE8584CAA,
    0x3FD0000000000000, 0x0000000000000000, 0xBFD0000000000000, 0xBFDBB67AE8584CAA
  ]

  pub let VELLO_DIR_R092_X : [u64; 12] = [
    0x0000000000000000, 0x3FDD70A3D70A3D71, 0x3FE97EEBF47A320D, 0x3FED70A3D70A3D71,
    0x3FE97EEBF47A320D, 0x3FDD70A3D70A3D71, 0x0000000000000000, 0xBFDD70A3D70A3D71,
    0xBFE97EEBF47A320D, 0xBFED70A3D70A3D71, 0xBFE97EEBF47A320D, 0xBFDD70A3D70A3D71
  ]
  pub let VELLO_DIR_R092_Y : [u64; 12] = [
    0xBFED70A3D70A3D71, 0xBFE97EEBF47A320D, 0xBFDD70A3D70A3D71, 0x0000000000000000,
    0x3FDD70A3D70A3D71, 0x3FE97EEBF47A320D, 0x3FED70A3D70A3D71, 0x3FE97EEBF47A320D,
    0x3FDD70A3D70A3D71, 0x0000000000000000, 0xBFDD70A3D70A3D71, 0xBFE97EEBF47A320D
  ]

  // vello_face_dir_xy_bits(radius_id, index, out_ptr) -> VFF_OK |
  // VFF_TICK_OUT_OF_RANGE. Pure leaf (no nested call, no push/pop
  // needed): writes x_bits to [out_ptr+0] and y_bits to [out_ptr+8].
  // r10/r11 are scratch (caller-saved, nothing to preserve). Gates
  // index < 12 first, then dispatches radius_id via a 4-way cmp/je
  // chain to the matching array pair.

  pub let vello_face_dir_xy_bits : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (radius_id: u64) (index: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): 12-entry lookup dispatch over one of four radius tables. Pure leaf -- no nested call, no callee-save push needed. r10/r11 hold the chosen X/Y array base; rsi (index) used directly as a scaled-index operand `[r10 + rsi*8]`. Labels prefixed vello_face_dxy_.",
      block: {
        cmp rsi, 12;
        jae vello_face_dxy_bad;

        cmp rdi, 0;
        je  vello_face_dxy_r100;
        cmp rdi, 1;
        je  vello_face_dxy_r085;
        cmp rdi, 2;
        je  vello_face_dxy_r050;
        cmp rdi, 3;
        je  vello_face_dxy_r092;
        jmp vello_face_dxy_bad;

      vello_face_dxy_r100:
        lea r10, [rip + VELLO_DIR_R100_X];
        lea r11, [rip + VELLO_DIR_R100_Y];
        jmp vello_face_dxy_load;
      vello_face_dxy_r085:
        lea r10, [rip + VELLO_DIR_R085_X];
        lea r11, [rip + VELLO_DIR_R085_Y];
        jmp vello_face_dxy_load;
      vello_face_dxy_r050:
        lea r10, [rip + VELLO_DIR_R050_X];
        lea r11, [rip + VELLO_DIR_R050_Y];
        jmp vello_face_dxy_load;
      vello_face_dxy_r092:
        lea r10, [rip + VELLO_DIR_R092_X];
        lea r11, [rip + VELLO_DIR_R092_Y];

      vello_face_dxy_load:
        mov rax, [r10 + rsi * 8];
        mov [rdx + 0], rax;
        mov rax, [r11 + rsi * 8];
        mov [rdx + 8], rax;
        xor rax, rax;
        ret;

      vello_face_dxy_bad:
        mov rax, 0xFFFFE8EB;             // VFF_TICK_OUT_OF_RANGE
        ret
      }
    }

  // ==========================================================================
  // Section 3  Hand-index helpers (see DEMO TIME above).
  // ==========================================================================

  pub let vello_face_hand_index_hour : (u64) -> u64 !{} @{} =
    fn (hour: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): hour_index = hour mod 12 via unsigned div. Pure leaf. Labels prefixed vello_face_hih_.",
      block: {
        mov rax, rdi;
        xor rdx, rdx;
        mov rcx, 12;                     // VFF_HOUR_MOD
        div rcx;
        mov rax, rdx;
        ret
      }
    }

  pub let vello_face_hand_index_minsec : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): minute/second index = v / 5 via unsigned div (the table's 12 slots are 5 units apart). Pure leaf. Labels prefixed vello_face_him_.",
      block: {
        mov rax, rdi;
        xor rdx, rdx;
        mov rcx, 5;                      // VFF_MINSEC_STEP
        div rcx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  State: app struct, command ring, stats quartet.
  // ==========================================================================

  pub let mut _vello_face_app   : [u64; 4]   = uninit @align(64)
  pub let mut _vello_cmd_buf    : [u64; 512] = uninit @align(64)
  pub let mut _vello_face_stats : [u64; 4]   = uninit @align(64)

  // Counter quartet for smoke-witness observability:
  //   [STARTS]   vello_face_main invocations that reach the render call.
  //   [CMDS]     successful vello_face_cmd_append calls (records
  //              written into the ring).
  //   [RENDERS]  successful vello_face_render_frame passes.
  //   [REFUSED]  refused entry-point invocations, any public entry.
  pub let VFF_ST_STARTS  : u64 = 0
  pub let VFF_ST_CMDS    : u64 = 1
  pub let VFF_ST_RENDERS : u64 = 2
  pub let VFF_ST_REFUSED : u64 = 3

  pub let vello_face_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): clear counter quartet at boot. Four u64 slots. Labels prefixed vello_face_sr_.",
      block: {
        lea r10, [rip + _vello_face_stats];
        xor rax, rax;
        xor rcx, rcx;
      vello_face_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vello_face_sr_top;
        ret
      }
    }

  pub let vello_face_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): counter bump; load-inc-store, no `add reg,[mem]`. Labels prefixed vello_face_nt_.",
      block: {
        cmp rdi, 4;
        jae vello_face_nt_out;
        lea r10, [rip + _vello_face_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vello_face_nt_out:
        ret
      }
    }

  pub let vello_face_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): counter read. Labels prefixed vello_face_st_.",
      block: {
        cmp rdi, 4;
        jae vello_face_st_zero;
        lea r10, [rip + _vello_face_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vello_face_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  vello_face_cmd_append -- ring-buffer writer.
  // ==========================================================================
  //
  // vello_face_cmd_append(app_ptr, opcode, a0, a1, a2) -> VFF_OK |
  // VFF_NULL | VFF_CMD_BUFFER_FULL.
  //
  // Refuses app_ptr == 0 (VFF_NULL) and cmd_count >= VELLO_CMD_MAX
  // (VFF_CMD_BUFFER_FULL, defense-in-depth -- this landing's single
  // 46-record frame never approaches the 128-record cap). On success:
  // writes the four-word record at byte_offset = cmd_count*32 (`shl
  // r10,5`, power-of-two stride, no imul needed), bumps cmd_count and
  // cmd_write_offset, bumps VFF_ST_CMDS, returns VFF_OK.

  pub let vello_face_cmd_append : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) (opcode: u64) (a0: u64) (a1: u64) (a2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): ring-buffer record writer. Five callee-save pushes (rbx=app_ptr, r12=opcode, r13=a0, r14=a1, r15=a2) = 40 bytes: entry rsp%16==8, +40 = %16==0 for the note() calls (odd push count needs no pad). Refusal funnel through vello_face_ca_refused bumps VFF_ST_REFUSED once. Labels prefixed vello_face_ca_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        cmp rdi, 0;
        je  vello_face_ca_null;

        mov rbx, rdi;                    // app_ptr
        mov r12, rsi;                    // opcode
        mov r13, rdx;                    // a0
        mov r14, rcx;                    // a1
        mov r15, r8;                     // a2

        mov rax, [rbx + 16];             // cmd_count
        cmp rax, 128;                    // VELLO_CMD_MAX
        jae vello_face_ca_full;

        mov r10, rax;
        shl r10, 5;                      // byte_offset = cmd_count * 32
        lea r11, [rip + _vello_cmd_buf];
        add r11, r10;

        mov [r11 + 0],  r12;             // opcode
        mov [r11 + 8],  r13;             // a0
        mov [r11 + 16], r14;             // a1
        mov [r11 + 24], r15;             // a2

        add rax, 1;
        mov [rbx + 16], rax;             // cmd_count += 1
        mov r10, rax;
        shl r10, 5;
        mov [rbx + 8], r10;              // cmd_write_offset = cmd_count * 32

        mov rdi, 1;                      // VFF_ST_CMDS
        call vello_face_note;
        xor rax, rax;                    // VFF_OK
        jmp vello_face_ca_out;

      vello_face_ca_null:
        mov rax, 0xFFFFE8EE;             // VFF_NULL
        jmp vello_face_ca_refused;
      vello_face_ca_full:
        mov rax, 0xFFFFE8EC;             // VFF_CMD_BUFFER_FULL

      vello_face_ca_refused:
        mov rbx, rax;
        mov rdi, 3;                      // VFF_ST_REFUSED
        call vello_face_note;
        mov rax, rbx;

      vello_face_ca_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Emit functions: transform, ticks, hands.
  // ==========================================================================

  // vello_face_emit_transform(app_ptr) -> VFF_OK | VFF_CMD_BUFFER_FULL |
  // VFF_NULL. One SET_TRANSFORM record (scale=100.0, tx=160.0,
  // ty=120.0 -- see SIMPLIFIED TRANSFORM above). rdi (app_ptr) is
  // untouched and flows straight into the tail call; only a `sub
  // rsp,8` pad is needed (zero pushes -> entry rsp%16==8 needs +8 to
  // reach 0).

  pub let vello_face_emit_transform : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): single SET_TRANSFORM(scale=100.0, tx=160.0, ty=120.0) record. app_ptr (rdi) passed straight through untouched. `sub rsp,8` pad (zero pushes, entry rsp%16==8) for the one nested call. Labels prefixed vello_face_et_.",
      block: {
        sub rsp, 8;
        mov rsi, 6;                      // VELLO_CMD_SET_TRANSFORM
        mov rdx, 0x4059000000000000;     // VELLO_SCALE_BITS = 100.0
        mov rcx, 0x4064000000000000;     // VELLO_CENTER_X_BITS = 160.0
        mov r8,  0x405E000000000000;     // VELLO_CENTER_Y_BITS = 120.0
        call vello_face_cmd_append;
        add rsp, 8;
        ret
      }
    }

  // vello_face_emit_tick(app_ptr, index) -> VFF_OK | VFF_CMD_BUFFER_FULL
  // | VFF_TICK_OUT_OF_RANGE | VFF_NULL.
  //
  // MOVETO(inner @ radius 0.85) -> LINETO(outer @ radius 1.00) ->
  // STROKE(width=0.02, color=black). 16-byte scratch at [rsp+0..+15]
  // holds one xy pair at a time (reused for inner then outer). Two
  // callee-save pushes (rbx=app_ptr, r12=index) = 16 bytes; entry
  // rsp%16==8, +16=%16==8, +24 sub (16 scratch + 8 pad) = %16==0.

  pub let vello_face_emit_tick : (u64, u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): one radial tick mark = MOVETO(inner)+LINETO(outer)+STROKE. Two callee-save pushes (rbx=app_ptr, r12=index) + `sub rsp,24` (16-byte xy scratch + 8-byte pad) lands rsp%16==0 for every nested call. Every nested-call refusal propagates verbatim via `cmp rax,0; jne out`. Labels prefixed vello_face_etk_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 24;

        mov rbx, rdi;                    // app_ptr
        mov r12, rsi;                    // index

        // Inner point (tick base, radius 0.85).
        mov rdi, 1;                      // VELLO_RADIUS_085
        mov rsi, r12;
        lea rdx, [rsp + 0];
        call vello_face_dir_xy_bits;
        cmp rax, 0;
        jne vello_face_etk_out;

        mov rdx, [rsp + 0];              // inner x
        mov rcx, [rsp + 8];              // inner y
        mov rdi, rbx;
        mov rsi, 0;                      // VELLO_CMD_MOVETO
        xor r8, r8;
        call vello_face_cmd_append;
        cmp rax, 0;
        jne vello_face_etk_out;

        // Outer point (tick rim, radius 1.00).
        mov rdi, 0;                      // VELLO_RADIUS_100
        mov rsi, r12;
        lea rdx, [rsp + 0];
        call vello_face_dir_xy_bits;
        cmp rax, 0;
        jne vello_face_etk_out;

        mov rdx, [rsp + 0];              // outer x
        mov rcx, [rsp + 8];              // outer y
        mov rdi, rbx;
        mov rsi, 1;                      // VELLO_CMD_LINETO
        xor r8, r8;
        call vello_face_cmd_append;
        cmp rax, 0;
        jne vello_face_etk_out;

        mov rdi, rbx;
        mov rsi, 5;                      // VELLO_CMD_STROKE
        mov rdx, 0x3F947AE147AE147B;     // VELLO_TICK_STROKE_BITS = 0.02
        mov rcx, 0xFF000000;             // VELLO_COLOR_BLACK
        xor r8, r8;
        call vello_face_cmd_append;

      vello_face_etk_out:
        add rsp, 24;
        pop r12;
        pop rbx;
        ret
      }
    }

  // vello_face_emit_ticks(app_ptr) -> VFF_OK | (first tick's refusal).
  // Loops i = 0..11 calling vello_face_emit_tick. Two callee-save
  // pushes (rbx=app_ptr, r12=i) = 16 bytes; entry rsp%16==8, +16=8,
  // `sub rsp,8` pad reaches 0.

  pub let vello_face_emit_ticks : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): loop i=0..11 over vello_face_emit_tick. Two callee-save pushes + `sub rsp,8` pad lands rsp%16==0. First refusal stops the loop and propagates verbatim. Labels prefixed vello_face_etks_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov rbx, rdi;                    // app_ptr
        xor r12, r12;                    // i = 0

      vello_face_etks_loop:
        cmp r12, 12;                     // VELLO_DIR_COUNT
        jae vello_face_etks_done;

        mov rdi, rbx;
        mov rsi, r12;
        call vello_face_emit_tick;
        cmp rax, 0;
        jne vello_face_etks_out;

        add r12, 1;
        jmp vello_face_etks_loop;

      vello_face_etks_done:
        xor rax, rax;                    // VFF_OK

      vello_face_etks_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // vello_face_emit_hand(app_ptr, radius_id, index, stroke_bits, color)
  // -> VFF_OK | VFF_CMD_BUFFER_FULL | VFF_TICK_OUT_OF_RANGE | VFF_NULL.
  //
  // MOVETO(0,0) -> LINETO(tip @ radius_id/index) -> STROKE(stroke_bits,
  // color). Five callee-save pushes (all five args, since every one
  // survives past the first nested call) + `sub rsp,16` (xy scratch)
  // lands rsp%16==0: entry rsp%16==8, +40=%16==0, +16=%16==0.

  pub let vello_face_emit_hand : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) (radius_id: u64) (index: u64) (stroke_bits: u64) (color: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): one clock hand = MOVETO(0,0)+LINETO(tip)+STROKE. Five callee-save pushes (rbx=app_ptr, r12=radius_id, r13=index, r14=stroke_bits, r15=color) + `sub rsp,16` (16-byte xy scratch) lands rsp%16==0 for every nested call. Every nested-call refusal propagates verbatim via `cmp rax,0; jne out`. Labels prefixed vello_face_eh_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 16;

        mov rbx, rdi;                    // app_ptr
        mov r12, rsi;                    // radius_id
        mov r13, rdx;                    // index
        mov r14, rcx;                    // stroke_bits
        mov r15, r8;                     // color

        // MOVETO(0,0) -- hands originate at the unit-space center.
        mov rdi, rbx;
        mov rsi, 0;                      // VELLO_CMD_MOVETO
        xor rdx, rdx;
        xor rcx, rcx;
        xor r8, r8;
        call vello_face_cmd_append;
        cmp rax, 0;
        jne vello_face_eh_out;

        // Look up the tip point at (radius_id, index).
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rsp + 0];
        call vello_face_dir_xy_bits;
        cmp rax, 0;
        jne vello_face_eh_out;

        // LINETO(tip).
        mov rdx, [rsp + 0];
        mov rcx, [rsp + 8];
        mov rdi, rbx;
        mov rsi, 1;                      // VELLO_CMD_LINETO
        xor r8, r8;
        call vello_face_cmd_append;
        cmp rax, 0;
        jne vello_face_eh_out;

        // STROKE(width, color).
        mov rdi, rbx;
        mov rsi, 5;                      // VELLO_CMD_STROKE
        mov rdx, r14;
        mov rcx, r15;
        xor r8, r8;
        call vello_face_cmd_append;

      vello_face_eh_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  vello_face_render_frame -- one full frame.
  // ==========================================================================
  //
  // vello_face_render_frame(app_ptr) -> VFF_OK | VFF_NULL |
  // VFF_NOT_INIT | (first emit's refusal).
  //
  // SET_TRANSFORM -> 12 ticks -> hour hand -> minute hand -> second
  // hand, using the demo-time fields the caller (vello_face_main)
  // already seeded. One callee-save push (rbx=app_ptr) suffices --
  // every other value is read fresh from the struct or from a nested
  // call's own rax immediately before use, so nothing else needs to
  // survive across a call boundary. Entry rsp%16==8, +8=%16==0.

  pub let vello_face_render_frame : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): SET_TRANSFORM + 12 ticks + 3 hands, one call each, gated app_ptr!=0 and ready_flag!=0. Single callee-save push (rbx=app_ptr) leaves rsp%16==0 for every nested call. Byte-field loads (ready_flag, demo_hour/minute/second) are each preceded by an explicit `xor reg,reg` -- mov_b does NOT auto zero-extend on load (see ENCODER DISCIPLINE). Every nested-call refusal propagates verbatim. Labels prefixed vello_face_rf_.",
      block: {
        push rbx;

        cmp rdi, 0;
        je  vello_face_rf_null;
        mov rbx, rdi;                    // app_ptr

        xor rax, rax;
        mov_b rax, [rbx + 7];            // ready_flag
        cmp rax, 0;
        je  vello_face_rf_not_init;

        mov rdi, rbx;
        call vello_face_emit_transform;
        cmp rax, 0;
        jne vello_face_rf_out;

        mov rdi, rbx;
        call vello_face_emit_ticks;
        cmp rax, 0;
        jne vello_face_rf_out;

        // Hour hand: radius 0.50, index = demo_hour mod 12, black.
        xor rdi, rdi;
        mov_b rdi, [rbx + 4];            // demo_hour
        call vello_face_hand_index_hour;
        mov rdi, rbx;
        mov rsi, 2;                      // VELLO_RADIUS_050
        mov rdx, rax;                    // hour index
        mov rcx, 0x3FA999999999999A;     // VELLO_HOUR_STROKE_BITS = 0.05
        mov r8,  0xFF000000;             // VELLO_COLOR_BLACK
        call vello_face_emit_hand;
        cmp rax, 0;
        jne vello_face_rf_out;

        // Minute hand: radius 0.85, index = demo_minute / 5, black.
        xor rdi, rdi;
        mov_b rdi, [rbx + 5];            // demo_minute
        call vello_face_hand_index_minsec;
        mov rdi, rbx;
        mov rsi, 1;                      // VELLO_RADIUS_085
        mov rdx, rax;                    // minute index
        mov rcx, 0x3FA1EB851EB851EC;     // VELLO_MINUTE_STROKE_BITS = 0.035
        mov r8,  0xFF000000;             // VELLO_COLOR_BLACK
        call vello_face_emit_hand;
        cmp rax, 0;
        jne vello_face_rf_out;

        // Second hand: radius 0.92, index = demo_second / 5, red.
        xor rdi, rdi;
        mov_b rdi, [rbx + 6];            // demo_second
        call vello_face_hand_index_minsec;
        mov rdi, rbx;
        mov rsi, 3;                      // VELLO_RADIUS_092
        mov rdx, rax;                    // second index
        mov rcx, 0x3F947AE147AE147B;     // VELLO_SECOND_STROKE_BITS = 0.02
        mov r8,  0xFFFF0000;             // VELLO_COLOR_RED
        call vello_face_emit_hand;
        cmp rax, 0;
        jne vello_face_rf_out;

        // frame_count += 1.
        mov rax, [rbx + 24];
        add rax, 1;
        mov [rbx + 24], rax;

        mov rdi, 2;                      // VFF_ST_RENDERS
        call vello_face_note;
        xor rax, rax;                    // VFF_OK
        jmp vello_face_rf_out;

      vello_face_rf_null:
        mov rax, 0xFFFFE8EE;             // VFF_NULL
        jmp vello_face_rf_refused;
      vello_face_rf_not_init:
        mov rax, 0xFFFFE8EF;             // VFF_NOT_INIT

      vello_face_rf_refused:
        mov rbx, rax;
        mov rdi, 3;                      // VFF_ST_REFUSED
        call vello_face_note;
        mov rax, rbx;

      vello_face_rf_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  vello_face_main -- entry point.
  // ==========================================================================
  //
  // vello_face_main() -> VFF_OK | VFF_UI_CTX_MINT_FAIL | (render_frame's
  // refusal).
  //
  //   (1) Zero the 32-byte app struct.
  //   (2) ui_context_new(placeholder window=1, surface=1) mints the
  //       KIND_UI_CONTEXT row (see KIND_UI_CONTEXT MINT above).
  //   (3) Seed ui_ctx_row_id + the fixed demo time (10:10:30) +
  //       ready_flag=1.
  //   (4) Bracket one frame: begin_frame -> render_frame -> end_frame
  //       (paint-once -- see PAINT-ONCE SCOPE above).

  pub let vello_face_main : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): sample entry point. Two callee-save pushes (rbx=app_ptr base, r12=ctx_row_id) + `sub rsp,8` pad lands rsp%16==0 for every nested call. On render_frame failure, end_frame still runs (close the frame we opened) before propagating the sentinel. Labels prefixed vello_face_m_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        lea rbx, [rip + _vello_face_app];

        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;

        // Mint KIND_UI_CONTEXT (placeholder window/surface -- see
        // KIND_UI_CONTEXT MINT above).
        mov rdi, 1;                      // VFF_PLACEHOLDER_WINDOW
        mov rsi, 1;                      // VFF_PLACEHOLDER_SURFACE
        call ui_context_new;
        mov r10, 8;                      // VFF_UI_ROW_SENTINEL_MIN
        cmp rax, r10;
        jae vello_face_m_ctx_fail;
        mov r12, rax;                    // ctx_row_id

        mov rax, r12;
        mov_d [rbx + 0], rax;            // ui_ctx_row_id (u32)
        mov rax, 10;                     // VFF_DEMO_HOUR
        mov_b [rbx + 4], rax;
        mov rax, 10;                     // VFF_DEMO_MINUTE
        mov_b [rbx + 5], rax;
        mov rax, 30;                     // VFF_DEMO_SECOND
        mov_b [rbx + 6], rax;
        mov rax, 1;
        mov_b [rbx + 7], rax;            // ready_flag = 1

        mov rdi, r12;
        call ui_context_begin_frame;

        mov rdi, rbx;
        call vello_face_render_frame;
        cmp rax, 0;
        jne vello_face_m_render_fail;

        mov rdi, r12;
        call ui_context_end_frame;

        mov rdi, 0;                      // VFF_ST_STARTS
        call vello_face_note;

        xor rax, rax;                    // VFF_OK
        jmp vello_face_m_out;

      vello_face_m_ctx_fail:
        mov rdi, 3;                      // VFF_ST_REFUSED
        call vello_face_note;
        mov rax, 0xFFFFE8ED;             // VFF_UI_CTX_MINT_FAIL
        jmp vello_face_m_out;

      vello_face_m_render_fail:
        mov rbx, rax;                    // stash render_frame's sentinel
        mov rdi, r12;
        call ui_context_end_frame;       // close the frame we opened
        mov rdi, 3;                      // VFF_ST_REFUSED
        call vello_face_note;
        mov rax, rbx;

      vello_face_m_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Boot init + fingerprint tag.
  // ==========================================================================
  //
  // vello_face_init zeroes the stats quartet at boot; the app struct
  // itself is seeded by vello_face_main. The command ring is left
  // uninit -- cmd_count is the authoritative bound on legitimate data,
  // so unwritten slots beyond it are never read by a conformant
  // consumer and need no boot-time zero pass.
  //
  // pdx_kind_vello_face_meta follows the pdx_kind_<name>_meta legacy-
  // suffix convention shared with widgets.pdx / clock/analog.pdx /
  // clock/timezone.pdx. Needs the tools/verify-fingerprint-coverage.sh
  // allowlist entry this landing adds ("Wave0-B15 G12-M3-002 (#2335)
  // Vello-style command-stream clock face sample + R37 GPU-context
  // consumer pending").
  //
  // Length: "vello face ready ok [legacy: VELLO FACE READY OK]\0" =
  //   49 characters + NUL = 50 bytes (strlen+1 rule).

  pub let vello_face_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G12-M3-002 (#2335): call through to vello_face_stats_reset for one clean counter zero-out. Labels prefixed vello_face_i_.",
      block: {
        call vello_face_stats_reset;
        ret
      }
    }

  pub let pdx_kind_vello_face_meta : [u8; 50] = "vello face ready ok [legacy: VELLO FACE READY OK]\0"
}
