// src/samples/clock/timezone.pdx -- Wave0-B14 G12-M3-002alt (paideia-os #2336)
//
// SAMPLE APP -- WORLD CLOCK (retained-mode timezone list).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// stack. Unlike clock/analog.pdx (Wave0-B13-10, #2335, IMMEDIATE-mode
// via widgets.pdx), this sample demonstrates the RETAINED half of the
// toolkit, consuming immediate_context.pdx (KIND_UI_CONTEXT=0x1D5,
// mint + begin/end frame), view_tree.pdx (Wave0-B10-10, #2329, reset/
// diff/reconcile) and retained_widgets.pdx (Wave0-B11-09, #2330,
// retained_list_new / retained_list_add_item -- the ONLY factories
// this file uses; no direct view_tree_append_node calls here).
//
// NOVEL-CLEAN POSTURE. The clock is a pure function of one struct (12
// rows, one placeholder "elapsed since boot" clock), rebuilt every
// tick via the exact pipeline view_tree.pdx's own header documents as
// the retained/immediate paradigm meeting point:
//
//     view_tree_reset(tree)
//     retained_list_new + retained_list_add_item * 12   (rebuild)
//     view_tree_diff(tree, prev_hashes)
//     ui_context_begin_frame(ctx) -> view_tree_reconcile(tree, ctx)
//         -> ui_context_end_frame(ctx)
//
// File shape matches every prior G12 sample: module `Timezone`,
// single file, .bss-owned singleton struct, stats quartet +
// reset/note/stat, fingerprint tag ending `[legacy: ... OK]`.
//
// TIMEZONE TABLE -- 12 fixed IANA zones (no picker; a future KIND_
// SETTINGS landing owns that). idx / city / IANA / UTC offset / biased
// (offset_minutes + 1440, so every stored value is positive):
//
//    0 Los Angeles America/Los_Angeles -08:00  960   6 Athens  +02:00 1560
//    1 Denver      America/Denver      -07:00 1020   7 Moscow  +03:00 1620
//    2 Chicago     America/Chicago     -06:00 1080   8 Kolkata +05:30 1770
//    3 New York    America/New_York    -05:00 1140   9 Bangkok +07:00 1860
//    4 London      Europe/London        00:00 1440  10 Tokyo   +09:00 1980
//    5 Berlin      Europe/Berlin       +01:00 1500  11 Sydney  +10:00 2040
//
// Standard-time only, NO DST (a future KIND_TZ_DATABASE is the right
// place for seasonal rules). Each city is one combined "<City>
// [<IANA>]\0" label (CLOCKTZ_LABEL_0..11), addressable via
// clock_timezone_zone_label_ptr for whatever future text-arena / font
// wire wants a real pointer.
//
// BIAS TRICK: paideia-as forbids neg/cqo/idiv (signed division), so
// negative UTC offsets are never represented as negative numbers --
// CLOCKTZ_OFFSETS_BIASED stores offset_minutes + 1440 instead. Since
// ((X + offset + 1440) mod 1440) == ((X + offset) mod 1440), adding
// the biased offset and taking mod 1440 recovers the correct local
// minute-of-day using ONLY unsigned add + unsigned div.
//
// TIME DERIVATION -- u64 unix seconds -> (zone) -> HH:MM. No KIND_
// WALL_CLOCK cap exists yet (same gap clock/analog.pdx's header
// documents), so clock_timezone_app_init seeds a placeholder unix-
// seconds counter (CLOCKTZ_EPOCH_SEED) that clock_timezone_advance_
// clock steps by CLOCKTZ_SEC_PER_TICK (30) once per loop iteration --
// a stand-in a future KIND_WALL_CLOCK subscription swaps in without
// touching clock_timezone_local_minute_of_day's signature:
//
//     unix_minutes  = unix_seconds / 60
//     minute_of_day = (unix_minutes + offset_biased[zone]) mod 1440
//     hour          = minute_of_day / 60      minute = minute_of_day mod 60
//
// Seconds are dropped by design (task scope is HH:MM, no seconds, no
// DST).
//
// PROP-HASH PACKING. retained_list_add_item(tree, list, label_offset)
// stores label_offset VERBATIM as the node's prop_hash, and view_
// tree_diff fires on prop_hash CHANGE, not on referenced bytes
// changing under a stable pointer -- a real text-arena offset would
// stay constant every tick even as the displayed minute advances. So
// (mirroring settings/display.pdx's own "font arena TBD" placeholder)
// this file packs the value that must actually change:
//
//     prop_hash = (zone_index << 16) | (hour << 8) | minute
//
// A minute rollover on any row flips that row's prop_hash and view_
// tree_diff marks exactly that row dirty -- exercising the real diff-
// and-patch path before a text-arena payload exists.
//
// RETAINED-TREE LIFECYCLE. view_tree_diff compares prop_hashes
// against a caller-owned array but does NOT write new values back
// (confirmed by reading its body -- it only ever LOADS prev_hashes_
// ptr[idx]). clock_timezone_snapshot_hashes owns that write-back,
// reading each node's word3 (prop_hash, offset +24 -- the same offset
// retained_widgets.pdx's own set_text mutator touches directly). Safe
// ONLY because view_tree_reset's bump-pool reset is GLOBAL and this
// sample is the sole tree consumer: rebuilding in the same order every
// tick (list container at idx 0, then 12 items at idx 1..12) keeps
// pool indices identical tick over tick, so index-wise comparison
// stays meaningful. The tree is built ONCE (clock_timezone_build_
// tree, frame_num == 0 so the first diff marks every row dirty) and
// REBUILT every tick after (clock_timezone_rebuild_tree) because
// retained_widgets.pdx exposes a set_text mutator only for VNK_
// TEXTFIELD, not list items -- reset-and-rebuild is the substrate-
// sanctioned way to drive a live list with today's factory catalogue.
//
// "SCROLLABLE" HONESTY NOTE: view_tree_reconcile is, per its own
// header, a DISPATCH SKELETON today -- it counts dirty nodes it WOULD
// emit but does not yet call a scroll-viewport primitive. This file
// builds the VNK_LIST substrate a future G12.M2-003 wire paints as an
// actually-scrolling viewport.
//
// FAILURE TAXONOMY 0xFFFFE890..0xFFFFE89F (pre-assigned by #2336;
// repo-wide grep at landing shows the page unclaimed):
//
//   CTZ_OK                (0x00000000) success.
//   CTZ_NOT_INIT          (0xFFFFE89F) app.ready_flag == 0.
//   CTZ_NULL              (0xFFFFE89E) app_ptr == 0.
//   CTZ_UI_CTX_MINT_FAIL  (0xFFFFE89D) ui_context_new refused.
//   CTZ_TIME_UNAVAILABLE  (0xFFFFE89C) reserved for a future KIND_
//                                      WALL_CLOCK refusal; not
//                                      returned this landing.
//   CTZ_ROW_LAYOUT_FAIL   (0xFFFFE89B) the ONE-TIME initial build
//                                      refused.
//   CTZ_ZONE_OUT_OF_RANGE (0xFFFFE89A) zone_index >= 12 at a helper.
//   CTZ_REFUSED_DENSE     (0xFFFFE899) a LATER per-tick rebuild
//                                      refused after the pool was
//                                      already packed by the first
//                                      successful build.
//   0xFFFFE890..0xFFFFE898 reserved for follow-ups.
//
// ENCODER DISCIPLINE. paideia-as M0305 module = Timezone (basename
// timezone.pdx). Labels prefixed `clock_timezone_` per function. No
// float/FPU. No `test rN,rN` (uses `cmp rN,0`). No `and r11,imm64`
// (packed fields are <=16 bits, shifted with `shl reg,imm8` -- a
// shift-COUNT immediate, always safe unlike a data-width one). No
// 2-op `imul`. No neg/cqo/idiv (the BIAS TRICK covers every case). No
// `add reg,[mem]` (every accumulate is load-add-store through a
// register). Every wide sentinel (0xFFFFE89x, the u64::MAX build-fail
// marker, the 128 / 8 pool thresholds) is staged into r10 before a
// `cmp`, matching retained_widgets.pdx / view_tree.pdx precedent.
// Callee-save rbx/r12..r15 each pushed once per function that uses
// them; a `sub rsp,N` pad is added only when the push count is even
// (leaves rsp%16==8 at entry, needing one 8-byte pad to reach 16-
// aligned before any nested CALL).
//
// FUTURE WORK (not this landing): swap the placeholder clock for a
// real KIND_WALL_CLOCK subscription (wire CTZ_TIME_UNAVAILABLE to its
// refusal path); replace CLOCKTZ_PLACEHOLDER_WINDOW/SURFACE with a
// real KIND_WINDOW/KIND_SURFACE pair once a window manager threads one
// through to sample-app launch; once G12.M2-003's widget-call fanout
// lands, VNK_LIST rows actually paint and scroll; replace the packed
// (zone,hour,minute) prop_hash with a real text-arena offset once one
// exists.

module Timezone = structure {

  // ==========================================================================
  // Section 1  Constants: table shape, time math, thresholds, sentinels.
  // ==========================================================================

  pub let CLOCKTZ_ZONE_COUNT          : u64 = 12
  pub let CLOCKTZ_MIN_PER_HOUR        : u64 = 60
  pub let CLOCKTZ_MIN_PER_DAY         : u64 = 1440
  pub let CLOCKTZ_SEC_PER_MIN         : u64 = 60
  pub let CLOCKTZ_OFFSET_BIAS         : u64 = 1440

  // prop_hash packing shifts (see §PROP-HASH PACKING above).
  pub let CLOCKTZ_PACK_ZONE_SHIFT     : u64 = 16
  pub let CLOCKTZ_PACK_HOUR_SHIFT     : u64 = 8

  // Placeholder time source (see §TIME DERIVATION above).
  pub let CLOCKTZ_EPOCH_SEED          : u64 = 1700000000
  pub let CLOCKTZ_SEC_PER_TICK        : u64 = 30
  pub let CLOCKTZ_TICK_LIMIT          : u64 = 60

  // Placeholder KIND_UI_CONTEXT parent refs (see §FUTURE WORK above).
  pub let CLOCKTZ_PLACEHOLDER_WINDOW  : u64 = 1
  pub let CLOCKTZ_PLACEHOLDER_SURFACE : u64 = 1

  // Success/fail thresholds mirrored from the substrate this file
  // consumes: row_id < 8 for ui_context_new/view_tree_new (UI_MAX /
  // VT_MAX); node_id < 128 for retained_list_new/add_item (VT_NODE_
  // MAX / RW_NODE_MAX).
  pub let CLOCKTZ_ROW_SENTINEL_MIN    : u64 = 8
  pub let CLOCKTZ_NODE_SENTINEL_MIN   : u64 = 128

  // Nodes touched per rebuild: 1 list container + 12 label children.
  pub let CLOCKTZ_SNAPSHOT_COUNT      : u64 = 13

  // Internal-only marker distinct from a legitimate row count (0..12)
  // AND the public CTZ_* page below (matches the ADAPT_CLASS_BAD_
  // SENTINEL / u64::MAX convention adaptive_rate/main.pdx already
  // established for this exact purpose).
  pub let CLOCKTZ_BUILD_FAIL_MARKER   : u64 = 0xFFFFFFFFFFFFFFFF

  // Any u64 result >= this floor is unambiguously a 0xFFFFxxxx-page
  // sentinel, not a legitimate count/id/prop_hash -- the largest
  // packed prop_hash this file computes is (11<<16)|(23<<8)|59 ==
  // 726843, comfortably under 2^32.
  pub let CLOCKTZ_SENTINEL_FLOOR      : u64 = 0x100000000

  // Failure sentinels 0xFFFFE890..0xFFFFE89F. See §FAILURE TAXONOMY.
  pub let CTZ_OK                  : u64 = 0
  pub let CTZ_NOT_INIT            : u64 = 0xFFFFE89F
  pub let CTZ_NULL                : u64 = 0xFFFFE89E
  pub let CTZ_UI_CTX_MINT_FAIL    : u64 = 0xFFFFE89D
  pub let CTZ_TIME_UNAVAILABLE    : u64 = 0xFFFFE89C
  pub let CTZ_ROW_LAYOUT_FAIL     : u64 = 0xFFFFE89B
  pub let CTZ_ZONE_OUT_OF_RANGE   : u64 = 0xFFFFE89A
  pub let CTZ_REFUSED_DENSE       : u64 = 0xFFFFE899
  // 0xFFFFE890..0xFFFFE898 reserved for follow-ups.

  // ==========================================================================
  // Section 2  Zone table: 12 "<City> [<IANA>]\0" labels + biased
  // UTC-offset array (see §TIMEZONE TABLE above).
  // ==========================================================================

  pub let CLOCKTZ_LABEL_0  : [u8; 34] = "Los Angeles [America/Los_Angeles]\0"
  pub let CLOCKTZ_LABEL_1  : [u8; 24] = "Denver [America/Denver]\0"
  pub let CLOCKTZ_LABEL_2  : [u8; 26] = "Chicago [America/Chicago]\0"
  pub let CLOCKTZ_LABEL_3  : [u8; 28] = "New York [America/New_York]\0"
  pub let CLOCKTZ_LABEL_4  : [u8; 23] = "London [Europe/London]\0"
  pub let CLOCKTZ_LABEL_5  : [u8; 23] = "Berlin [Europe/Berlin]\0"
  pub let CLOCKTZ_LABEL_6  : [u8; 23] = "Athens [Europe/Athens]\0"
  pub let CLOCKTZ_LABEL_7  : [u8; 23] = "Moscow [Europe/Moscow]\0"
  pub let CLOCKTZ_LABEL_8  : [u8; 23] = "Kolkata [Asia/Kolkata]\0"
  pub let CLOCKTZ_LABEL_9  : [u8; 23] = "Bangkok [Asia/Bangkok]\0"
  pub let CLOCKTZ_LABEL_10 : [u8; 19] = "Tokyo [Asia/Tokyo]\0"
  pub let CLOCKTZ_LABEL_11 : [u8; 26] = "Sydney [Australia/Sydney]\0"

  // Index-parallel with the labels above: offset_minutes + 1440.
  pub let CLOCKTZ_OFFSETS_BIASED : [u64; 12] = [
    960, 1020, 1080, 1140,
    1440, 1500, 1560, 1620,
    1770, 1860, 1980, 2040
  ]

  // ==========================================================================
  // Section 3  State: app-struct singleton, prev-hash snapshot, stats.
  //
  // _clock_timezone_app LAYOUT -- 56 BYTES (seven u64 words):
  //   [+0]  ctx_row_id    KIND_UI_CONTEXT row (immediate_context.pdx)
  //   [+8]  tree_id       retained ViewTree id (view_tree.pdx)
  //   [+16] list_node_id  VNK_LIST container node id within tree_id
  //   [+24] unix_seconds  placeholder wall-clock counter
  //   [+32] ticks_done    monotone loop-iteration counter
  //   [+40] rows_built    rows appended on the most recent (re)build
  //   [+48] ready_flag    0 until clock_timezone_app_init runs
  // ==========================================================================

  pub let mut _clock_timezone_app : [u64; 7] = uninit @align(64)

  // Caller-owned diff snapshot (see §RETAINED-TREE LIFECYCLE above).
  // Sized 16 (13 used: list container + 12 rows; 3 headroom slots).
  pub let mut _clock_timezone_prev_hashes : [u64; 16] = uninit @align(64)

  // Counter quartet for smoke-witness observability:
  //   [STARTS]   clock_timezone_main invocations reaching the loop.
  //   [TICKS]    clock_timezone_advance_clock calls.
  //   [REBUILDS] successful clock_timezone_rebuild_tree passes.
  //   [REFUSED]  refused entry-point invocations, any public entry.
  pub let mut _clock_timezone_stats : [u64; 4] = uninit @align(64)

  pub let CLOCKTZ_ST_STARTS   : u64 = 0
  pub let CLOCKTZ_ST_TICKS    : u64 = 1
  pub let CLOCKTZ_ST_REBUILDS : u64 = 2
  pub let CLOCKTZ_ST_REFUSED  : u64 = 3

  pub let clock_timezone_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): clear counter quartet at boot. Four u64 slots. Labels prefixed clock_timezone_sr_.",
      block: {
        lea r10, [rip + _clock_timezone_stats];
        xor rax, rax;
        xor rcx, rcx;
      clock_timezone_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  clock_timezone_sr_top;
        ret
      }
    }

  pub let clock_timezone_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): counter bump; load-inc-store, no `add reg,[mem]`. Labels prefixed clock_timezone_nt_.",
      block: {
        cmp rdi, 4;
        jae clock_timezone_nt_out;
        lea r10, [rip + _clock_timezone_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      clock_timezone_nt_out:
        ret
      }
    }

  pub let clock_timezone_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): counter read. Labels prefixed clock_timezone_st_.",
      block: {
        cmp rdi, 4;
        jae clock_timezone_st_zero;
        lea r10, [rip + _clock_timezone_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      clock_timezone_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Time-formatting helpers (see §TIME DERIVATION above).
  // ==========================================================================

  // clock_timezone_zone_offset_biased(zone_index) -> offset | err.
  pub let clock_timezone_zone_offset_biased : (u64) -> u64 !{} @{} =
    fn (zone_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 (#2336): CLOCKTZ_OFFSETS_BIASED[zone_index], gated zone_index < 12 (fits imm8, direct cmp). Pure leaf. Labels prefixed clock_timezone_zob_.",
      block: {
        cmp rdi, 12;
        jae clock_timezone_zob_bad;
        lea r10, [rip + CLOCKTZ_OFFSETS_BIASED];
        mov rax, [r10 + rdi * 8];
        ret;
      clock_timezone_zob_bad:
        mov rax, 0xFFFFE89A;             // CTZ_ZONE_OUT_OF_RANGE
        ret
      }
    }

  // clock_timezone_zone_label_ptr(zone_index) -> &CLOCKTZ_LABEL_N |
  // err. 12-way branch (no jump-table primitive in this toolchain).
  // Forward-compatible text source for a future rendering wire.
  pub let clock_timezone_zone_label_ptr : (u64) -> u64 !{} @{} =
    fn (zone_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 (#2336): 12-way dispatch to &CLOCKTZ_LABEL_N; all compared immediates (0..11) fit imm8. Pure leaf. Labels prefixed clock_timezone_zlp_.",
      block: {
        cmp rdi, 0;  je clock_timezone_zlp_0;
        cmp rdi, 1;  je clock_timezone_zlp_1;
        cmp rdi, 2;  je clock_timezone_zlp_2;
        cmp rdi, 3;  je clock_timezone_zlp_3;
        cmp rdi, 4;  je clock_timezone_zlp_4;
        cmp rdi, 5;  je clock_timezone_zlp_5;
        cmp rdi, 6;  je clock_timezone_zlp_6;
        cmp rdi, 7;  je clock_timezone_zlp_7;
        cmp rdi, 8;  je clock_timezone_zlp_8;
        cmp rdi, 9;  je clock_timezone_zlp_9;
        cmp rdi, 10; je clock_timezone_zlp_10;
        cmp rdi, 11; je clock_timezone_zlp_11;
        mov rax, 0xFFFFE89A;             // CTZ_ZONE_OUT_OF_RANGE
        ret;
      clock_timezone_zlp_0:  lea rax, [rip + CLOCKTZ_LABEL_0];  ret;
      clock_timezone_zlp_1:  lea rax, [rip + CLOCKTZ_LABEL_1];  ret;
      clock_timezone_zlp_2:  lea rax, [rip + CLOCKTZ_LABEL_2];  ret;
      clock_timezone_zlp_3:  lea rax, [rip + CLOCKTZ_LABEL_3];  ret;
      clock_timezone_zlp_4:  lea rax, [rip + CLOCKTZ_LABEL_4];  ret;
      clock_timezone_zlp_5:  lea rax, [rip + CLOCKTZ_LABEL_5];  ret;
      clock_timezone_zlp_6:  lea rax, [rip + CLOCKTZ_LABEL_6];  ret;
      clock_timezone_zlp_7:  lea rax, [rip + CLOCKTZ_LABEL_7];  ret;
      clock_timezone_zlp_8:  lea rax, [rip + CLOCKTZ_LABEL_8];  ret;
      clock_timezone_zlp_9:  lea rax, [rip + CLOCKTZ_LABEL_9];  ret;
      clock_timezone_zlp_10: lea rax, [rip + CLOCKTZ_LABEL_10]; ret;
      clock_timezone_zlp_11: lea rax, [rip + CLOCKTZ_LABEL_11]; ret
      }
    }

  // clock_timezone_hour_of_minute(minute_of_day) -> hour (0..23).
  pub let clock_timezone_hour_of_minute : (u64) -> u64 !{} @{} =
    fn (minute_of_day: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 (#2336): minute_of_day / 60 via unsigned div (xor rdx,rdx before div). Pure leaf. Labels prefixed clock_timezone_hom_.",
      block: {
        mov rax, rdi;
        xor rdx, rdx;
        mov rcx, 60;
        div rcx;
        ret
      }
    }

  // clock_timezone_minute_component(minute_of_day) -> minute (0..59).
  pub let clock_timezone_minute_component : (u64) -> u64 !{} @{} =
    fn (minute_of_day: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 (#2336): minute_of_day mod 60 via unsigned div, remainder in rdx. Pure leaf. Labels prefixed clock_timezone_mc_.",
      block: {
        mov rax, rdi;
        xor rdx, rdx;
        mov rcx, 60;
        div rcx;
        mov rax, rdx;
        ret
      }
    }

  // clock_timezone_local_minute_of_day(unix_seconds, zone_index) ->
  // minute_of_day (0..1439) | CTZ_ZONE_OUT_OF_RANGE. See §TIME
  // DERIVATION above. One nested call.
  pub let clock_timezone_local_minute_of_day : (u64, u64) -> u64 !{mem} @{} =
    fn (unix_seconds: u64) (zone_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): unix_minutes = unix_seconds/60; total = unix_minutes + offset_biased; minute_of_day = total mod 1440. Single callee-save push (rbx=unix_seconds) leaves rsp%16==0 for the nested zone_offset_biased call; r11 stashes offset_biased (dead after, no further calls). Labels prefixed clock_timezone_lmod_.",
      block: {
        push rbx;
        mov  rbx, rdi;                    // unix_seconds

        mov  rdi, rsi;                    // zone_index
        call clock_timezone_zone_offset_biased;

        mov  r10, 0xFFFFE89A;             // CTZ_ZONE_OUT_OF_RANGE
        cmp  rax, r10;
        je   clock_timezone_lmod_out;     // propagate sentinel

        mov  r11, rax;                    // offset_biased
        mov  rax, rbx;                    // unix_seconds
        xor  rdx, rdx;
        mov  rcx, 60;
        div  rcx;                         // rax = unix_minutes
        add  rax, r11;                    // total
        xor  rdx, rdx;
        mov  rcx, 1440;
        div  rcx;                         // rdx = minute_of_day

        mov  rax, rdx;
      clock_timezone_lmod_out:
        pop  rbx;
        ret
      }
    }

  // clock_timezone_pack_row_hash(zone_index, minute_of_day) ->
  // prop_hash | CTZ_ZONE_OUT_OF_RANGE. See §PROP-HASH PACKING above.
  // Derives (hour, minute) from minute_of_day with its own single div
  // -- clock_timezone_hour_of_minute / minute_component above stay
  // independent public HH:MM accessors and are not called from here.
  pub let clock_timezone_pack_row_hash : (u64, u64) -> u64 !{} @{} =
    fn (zone_index: u64) (minute_of_day: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 (#2336): prop_hash = (zone_index<<16)|(hour<<8)|minute, hour/minute derived from one unsigned div (quotient=hour, remainder=minute). Shift-count immediates (16, 8) are shift-width, not data-width -- always safe. Pure leaf. Labels prefixed clock_timezone_prh_.",
      block: {
        cmp rdi, 12;
        jae clock_timezone_prh_bad;
        mov r10, rdi;
        shl r10, 16;                      // zone_index << 16
        mov rax, rsi;                     // minute_of_day
        xor rdx, rdx;
        mov rcx, 60;
        div rcx;                          // rax = hour, rdx = minute
        shl rax, 8;                       // hour << 8
        or  r10, rax;
        or  r10, rdx;                     // + minute
        mov rax, r10;
        ret;
      clock_timezone_prh_bad:
        mov rax, 0xFFFFE89A;              // CTZ_ZONE_OUT_OF_RANGE
        ret
      }
    }

  // ==========================================================================
  // Section 5  App-struct initialiser + placeholder clock advance.
  // ==========================================================================

  // clock_timezone_app_init() -> &_clock_timezone_app. Zeros the
  // struct, seeds unix_seconds/ready_flag. No nested calls.
  pub let clock_timezone_app_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): zero the 7-word app struct, seed unix_seconds + ready_flag, return &_clock_timezone_app. Single callee-save push (rbx=struct base); no nested calls. Labels prefixed clock_timezone_ai_.",
      block: {
        push rbx;
        lea  rbx, [rip + _clock_timezone_app];

        xor  rax, rax;
        mov  [rbx + 0],  rax;
        mov  [rbx + 8],  rax;
        mov  [rbx + 16], rax;
        mov  [rbx + 24], rax;
        mov  [rbx + 32], rax;
        mov  [rbx + 40], rax;
        mov  [rbx + 48], rax;

        mov  rax, 1700000000;             // CLOCKTZ_EPOCH_SEED
        mov  [rbx + 24], rax;             // unix_seconds

        mov  rax, 1;
        mov  [rbx + 48], rax;             // ready_flag = 1

        mov  rax, rbx;
        pop  rbx;
        ret
      }
    }

  // clock_timezone_advance_clock(app_ptr) -> new unix_seconds | err.
  // app.unix_seconds += CLOCKTZ_SEC_PER_TICK. No nested calls.
  pub let clock_timezone_advance_clock : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): app.unix_seconds += 30 (CLOCKTZ_SEC_PER_TICK); load-add-store, no `add reg,[mem]`. Gated app_ptr != 0 and ready_flag != 0. No pushes. Labels prefixed clock_timezone_adv_.",
      block: {
        cmp rdi, 0;
        je  clock_timezone_adv_null;
        mov rax, [rdi + 48];              // ready_flag
        cmp rax, 0;
        je  clock_timezone_adv_not_init;
        mov rax, [rdi + 24];              // unix_seconds
        mov rcx, 30;                      // CLOCKTZ_SEC_PER_TICK
        add rax, rcx;
        mov [rdi + 24], rax;
        ret;
      clock_timezone_adv_null:
        mov rax, 0xFFFFE89E;              // CTZ_NULL
        ret;
      clock_timezone_adv_not_init:
        mov rax, 0xFFFFE89F;              // CTZ_NOT_INIT
        ret
      }
    }

  // ==========================================================================
  // Section 6  Row builder + prop-hash snapshot.
  // ==========================================================================

  // clock_timezone_build_rows(tree_id, list_node, unix_seconds) ->
  // rows_built (== 12 on full success) | CLOCKTZ_BUILD_FAIL_MARKER.
  // Shared by the one-time build and every per-tick rebuild (§Section
  // 7); the caller alone decides which public CTZ_* sentinel a
  // CLOCKTZ_BUILD_FAIL_MARKER maps to.
  pub let clock_timezone_build_rows : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (list_node: u64) (unix_seconds: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): append 12 VNK_LABEL rows under list_node via retained_list_add_item, one per zone. Five callee-save pushes (rbx/r12/r13/r14/r15) leave rsp%16==0 for every nested call (odd push count, no pad needed). All three failure sites (local_minute_of_day sentinel, pack_row_hash sentinel, retained_list_add_item ENOSPC) funnel through ctz_br_fail, collapsing to one CLOCKTZ_BUILD_FAIL_MARKER regardless of cause. Labels prefixed clock_timezone_br_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                    // tree_id
        mov  r12, rsi;                    // list_node
        mov  r13, rdx;                    // unix_seconds
        xor  r14, r14;                    // zone_index = 0

      clock_timezone_br_loop:
        cmp  r14, 12;                     // CLOCKTZ_ZONE_COUNT
        jae  clock_timezone_br_done;

        mov  rdi, r13;                    // unix_seconds
        mov  rsi, r14;                    // zone_index
        call clock_timezone_local_minute_of_day;
        mov  r10, 0xFFFFE89A;             // CTZ_ZONE_OUT_OF_RANGE
        cmp  rax, r10;
        je   clock_timezone_br_fail;
        mov  r15, rax;                    // minute_of_day

        mov  rdi, r14;                    // zone_index
        mov  rsi, r15;                    // minute_of_day
        call clock_timezone_pack_row_hash;
        mov  r10, 0xFFFFE89A;             // CTZ_ZONE_OUT_OF_RANGE
        cmp  rax, r10;
        je   clock_timezone_br_fail;
        mov  r15, rax;                    // packed prop_hash

        mov  rdi, rbx;                    // tree_id
        mov  rsi, r12;                    // list_node
        mov  rdx, r15;                    // packed prop_hash
        call retained_list_add_item;
        mov  r10, 128;                    // CLOCKTZ_NODE_SENTINEL_MIN
        cmp  rax, r10;
        jae  clock_timezone_br_fail;

        add  r14, 1;
        jmp  clock_timezone_br_loop;

      clock_timezone_br_done:
        mov  rax, 12;                     // CLOCKTZ_ZONE_COUNT rows built
        jmp  clock_timezone_br_out;

      clock_timezone_br_fail:
        mov  rax, 0xFFFFFFFFFFFFFFFF;     // CLOCKTZ_BUILD_FAIL_MARKER

      clock_timezone_br_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // clock_timezone_snapshot_hashes(count) -> (). Copies each in-range
  // node's prop_hash (word3, offset +24) into _clock_timezone_prev_
  // hashes[idx] for the NEXT view_tree_diff call (§RETAINED-TREE
  // LIFECYCLE above).
  pub let clock_timezone_snapshot_hashes : (u64) -> () !{mem} @{} =
    fn (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): for idx in [0,count): prev_hashes[idx] = view_tree_node_base(idx)[+24]. Two callee-save pushes (rbx=idx, r12=count) leave rsp%16==8; sub rsp,8 pads to 0 for the nested view_tree_node_base call. Labels prefixed clock_timezone_sh_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov  r12, rdi;                    // count
        xor  rbx, rbx;                    // idx

      clock_timezone_sh_loop:
        cmp  rbx, r12;
        jae  clock_timezone_sh_done;

        mov  rdi, rbx;
        call view_tree_node_base;
        mov  r10, [rax + 24];             // prop_hash (word3)
        lea  r11, [rip + _clock_timezone_prev_hashes];
        mov  [r11 + rbx * 8], r10;

        add  rbx, 1;
        jmp  clock_timezone_sh_loop;

      clock_timezone_sh_done:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Initial tree build + per-tick rebuild.
  // ==========================================================================

  // clock_timezone_build_tree(app_ptr) -> CTZ_OK | CTZ_NULL |
  // CTZ_NOT_INIT | CTZ_ROW_LAYOUT_FAIL. ONE-TIME build: view_tree_new
  // (fresh tree, frame_num == 0 so the first diff marks every row
  // dirty) -> retained_list_new -> build_rows -> persist into the app
  // struct -> snapshot for the next tick's diff.
  pub let clock_timezone_build_tree : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): one-time tree build. Four callee-save pushes + sub rsp,8 land rsp%16==0 for every nested call. Reads app.unix_seconds directly ([rbx+24]) rather than via an accessor since ready_flag was just gated inline. Labels prefixed clock_timezone_bt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov  rbx, rdi;                    // app_ptr
        cmp  rbx, 0;
        je   clock_timezone_bt_null;

        mov  rax, [rbx + 48];             // ready_flag
        cmp  rax, 0;
        je   clock_timezone_bt_not_init;

        mov  r14, [rbx + 24];             // unix_seconds

        call view_tree_new;
        mov  r10, 8;                      // CLOCKTZ_ROW_SENTINEL_MIN
        cmp  rax, r10;
        jae  clock_timezone_bt_layout_fail;
        mov  r12, rax;                    // tree_id

        mov  rdi, r12;                    // tree_id
        xor  rsi, rsi;                    // parent = 0
        mov  rdx, 12;                     // CLOCKTZ_ZONE_COUNT
        call retained_list_new;
        mov  r10, 128;                    // CLOCKTZ_NODE_SENTINEL_MIN
        cmp  rax, r10;
        jae  clock_timezone_bt_layout_fail;
        mov  r13, rax;                    // list_node

        mov  rdi, r12;                    // tree_id
        mov  rsi, r13;                    // list_node
        mov  rdx, r14;                    // unix_seconds
        call clock_timezone_build_rows;
        mov  r10, 0xFFFFFFFFFFFFFFFF;     // CLOCKTZ_BUILD_FAIL_MARKER
        cmp  rax, r10;
        je   clock_timezone_bt_layout_fail;

        mov  [rbx + 8],  r12;             // tree_id
        mov  [rbx + 16], r13;             // list_node_id
        mov  [rbx + 40], rax;             // rows_built

        mov  rdi, 13;                     // CLOCKTZ_SNAPSHOT_COUNT
        call clock_timezone_snapshot_hashes;

        xor  rax, rax;                    // CTZ_OK
        jmp  clock_timezone_bt_out;

      clock_timezone_bt_null:
        mov  rax, 0xFFFFE89E;             // CTZ_NULL
        jmp  clock_timezone_bt_out;
      clock_timezone_bt_not_init:
        mov  rax, 0xFFFFE89F;             // CTZ_NOT_INIT
        jmp  clock_timezone_bt_out;
      clock_timezone_bt_layout_fail:
        mov  rax, 0xFFFFE89B;             // CTZ_ROW_LAYOUT_FAIL

      clock_timezone_bt_out:
        add  rsp, 8;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // clock_timezone_rebuild_tree(app_ptr) -> CTZ_OK | CTZ_NULL |
  // CTZ_NOT_INIT | CTZ_REFUSED_DENSE. PER-TICK: reset -> retained_
  // list_new -> build_rows -> diff (vs. the prior snapshot) -> begin_
  // frame -> reconcile -> end_frame -> snapshot for the NEXT tick.
  pub let clock_timezone_rebuild_tree : (u64) -> u64 !{mem} @{} =
    fn (app_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): per-tick reset+rebuild+diff+reconcile pass. Three callee-save pushes (rbx=app_ptr, r12=tree_id, r13=list_node) land rsp%16==0 for every nested call (a balanced CALL/RET pair never changes the caller's rsp). Every reset/list-new/build_rows/diff refusal funnels to CTZ_REFUSED_DENSE, distinct from build_tree's own CTZ_ROW_LAYOUT_FAIL. begin_frame/reconcile/end_frame results are not separately gated -- each self-gates per its own contract. Labels prefixed clock_timezone_rb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                    // app_ptr
        cmp  rbx, 0;
        je   clock_timezone_rb_null;

        mov  rax, [rbx + 48];             // ready_flag
        cmp  rax, 0;
        je   clock_timezone_rb_not_init;

        mov  r12, [rbx + 8];              // tree_id

        mov  rdi, r12;
        call view_tree_reset;
        cmp  rax, 0;
        jne  clock_timezone_rb_dense;

        mov  rdi, r12;                    // tree_id
        xor  rsi, rsi;                    // parent = 0
        mov  rdx, 12;                     // CLOCKTZ_ZONE_COUNT
        call retained_list_new;
        mov  r10, 128;                    // CLOCKTZ_NODE_SENTINEL_MIN
        cmp  rax, r10;
        jae  clock_timezone_rb_dense;
        mov  r13, rax;                    // list_node

        mov  rdi, r12;                    // tree_id
        mov  rsi, r13;                    // list_node
        mov  rdx, [rbx + 24];             // unix_seconds
        call clock_timezone_build_rows;
        mov  r10, 0xFFFFFFFFFFFFFFFF;     // CLOCKTZ_BUILD_FAIL_MARKER
        cmp  rax, r10;
        je   clock_timezone_rb_dense;

        mov  [rbx + 16], r13;             // list_node_id
        mov  [rbx + 40], rax;             // rows_built

        mov  rdi, r12;                    // tree_id
        lea  rsi, [rip + _clock_timezone_prev_hashes];
        call view_tree_diff;
        mov  r10, 0x100000000;            // CLOCKTZ_SENTINEL_FLOOR
        cmp  rax, r10;
        jae  clock_timezone_rb_dense;

        mov  rdi, [rbx + 0];              // ctx_row_id
        call ui_context_begin_frame;

        mov  rdi, r12;                    // tree_id
        mov  rsi, [rbx + 0];              // ctx_row_id
        call view_tree_reconcile;

        mov  rdi, [rbx + 0];              // ctx_row_id
        call ui_context_end_frame;

        mov  rdi, 13;                     // CLOCKTZ_SNAPSHOT_COUNT
        call clock_timezone_snapshot_hashes;

        mov  rdi, 2;                      // CLOCKTZ_ST_REBUILDS
        call clock_timezone_note;

        xor  rax, rax;                    // CTZ_OK
        jmp  clock_timezone_rb_out;

      clock_timezone_rb_null:
        mov  rax, 0xFFFFE89E;             // CTZ_NULL
        jmp  clock_timezone_rb_out;
      clock_timezone_rb_not_init:
        mov  rax, 0xFFFFE89F;             // CTZ_NOT_INIT
        jmp  clock_timezone_rb_out;
      clock_timezone_rb_dense:
        mov  rax, 0xFFFFE899;             // CTZ_REFUSED_DENSE

      clock_timezone_rb_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  clock_timezone_main -- entry point.
  // ==========================================================================
  //
  // clock_timezone_main() -> CTZ_OK | CTZ_UI_CTX_MINT_FAIL | CTZ_NULL
  // | CTZ_NOT_INIT | CTZ_ROW_LAYOUT_FAIL | CTZ_REFUSED_DENSE.
  //
  //   (1) clock_timezone_app_init seeds the app struct.
  //   (2) ui_context_new(placeholder window, placeholder surface)
  //       mints the KIND_UI_CONTEXT row (see §FUTURE WORK).
  //   (3) clock_timezone_build_tree builds the retained view once.
  //   (4) CLOCKTZ_TICK_LIMIT (60) iterations of: advance the
  //       placeholder clock, then reset+rebuild+diff+reconcile. A
  //       mid-loop refusal stops the loop and propagates that tick's
  //       sentinel.

  pub let clock_timezone_main : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): sample entry point. Four callee-save pushes + sub rsp,8 land rsp%16==0 for every nested call. Loop bound CLOCKTZ_TICK_LIMIT=60 keeps the sample terminating, matching adaptive_rate/main.pdx's own bounded-loop precedent pending a real event-source wake-up. Labels prefixed clock_timezone_m_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        call clock_timezone_app_init;
        mov  rbx, rax;                    // app_ptr

        mov  rdi, 1;                      // CLOCKTZ_PLACEHOLDER_WINDOW
        mov  rsi, 1;                      // CLOCKTZ_PLACEHOLDER_SURFACE
        call ui_context_new;
        mov  r10, 8;                      // CLOCKTZ_ROW_SENTINEL_MIN
        cmp  rax, r10;
        jae  clock_timezone_m_ctx_fail;
        mov  r12, rax;                    // ctx_row_id
        mov  [rbx + 0], r12;

        mov  rdi, rbx;
        call clock_timezone_build_tree;
        cmp  rax, 0;
        jne  clock_timezone_m_build_fail;

        mov  rdi, 0;                      // CLOCKTZ_ST_STARTS
        call clock_timezone_note;

        xor  r14, r14;                    // tick = 0
        xor  r13, r13;                    // final_status = CTZ_OK

      clock_timezone_m_loop:
        cmp  r14, 60;                     // CLOCKTZ_TICK_LIMIT
        jae  clock_timezone_m_done;

        mov  rdi, rbx;
        call clock_timezone_advance_clock;

        mov  rdi, 1;                      // CLOCKTZ_ST_TICKS
        call clock_timezone_note;

        mov  rdi, rbx;
        call clock_timezone_rebuild_tree;
        cmp  rax, 0;
        je   clock_timezone_m_step;

        mov  r13, rax;                    // stash the refusal sentinel
        mov  rdi, 3;                      // CLOCKTZ_ST_REFUSED
        call clock_timezone_note;
        jmp  clock_timezone_m_done;

      clock_timezone_m_step:
        add  r14, 1;
        mov  [rbx + 32], r14;             // ticks_done
        jmp  clock_timezone_m_loop;

      clock_timezone_m_done:
        mov  rax, r13;
        jmp  clock_timezone_m_out;

      clock_timezone_m_ctx_fail:
        mov  rdi, 3;                      // CLOCKTZ_ST_REFUSED
        call clock_timezone_note;
        mov  rax, 0xFFFFE89D;             // CTZ_UI_CTX_MINT_FAIL
        jmp  clock_timezone_m_out;

      clock_timezone_m_build_fail:
        mov  r13, rax;                    // stash build_tree's sentinel
        mov  rdi, 3;                      // CLOCKTZ_ST_REFUSED
        call clock_timezone_note;
        mov  rax, r13;

      clock_timezone_m_out:
        add  rsp, 8;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Boot init + fingerprint tag.
  // ==========================================================================
  //
  // clock_timezone_init zeroes the stats quartet at boot; the app
  // struct itself is seeded by the first clock_timezone_main call.
  //
  // pdx_kind_clock_timezone_meta is a data-only fingerprint (emitted
  // once a future smoke-witness klog wire lands; until then a compile
  // -time literal), following the pdx_kind_<name>_meta legacy-suffix
  // convention shared with widgets.pdx / view_tree.pdx / retained_
  // widgets.pdx / clock/analog.pdx. Needs the tools/verify-fingerprint
  // -coverage.sh allowlist entry this landing adds ("Wave0-B14 G12-M3
  // -002alt (#2336) world-clock retained-list sample + smoke-witness
  // klog wire pending").
  //
  // Length: "clock timezone ready ok [legacy: CLOCK TIMEZONE READY OK]\0"
  //   = 57 characters + NUL = 58 bytes (strlen+1 rule).

  pub let clock_timezone_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 (#2336): call through to clock_timezone_stats_reset for one clean counter zero-out. Labels prefixed clock_timezone_i_.",
      block: {
        call clock_timezone_stats_reset;
        ret
      }
    }

  pub let pdx_kind_clock_timezone_meta : [u8; 58] = "clock timezone ready ok [legacy: CLOCK TIMEZONE READY OK]\0"
}
