// src/samples/editor/render.pdx -- Wave0-B15 G12-M4-002 (paideia-os #2338)
//
// SAMPLE APP -- TEXT EDITOR: SYNTAX-HIGHLIGHT RENDER LOOP + BIDI CARET NAV.
//
// Design authority: design/roadmap/next-wave-softarch.md SS G12 toolkit.
// Third leg of the text-editor sample (buffer primitives landed B14
// #2337 as src/samples/editor/buffer.pdx; BiDi caret substrate landed
// B13 #2324 as src/user/ime/bidi_caret.pdx). THIS FILE OWNS the
// per-frame render loop and the syntax-highlight tokenizer; it
// CONSUMES buffer.pdx's KIND_EDITOR_BUFFER (0x1E5) read/len API and
// bidi_caret.pdx's caret cell API, and it PAINTS through the same
// placeholder sink every other G12 sample uses: widgets.pdx's
// widget_paint_rect (src/user/libpaideia_ui/widgets.pdx), exactly as
// samples/clock/analog.pdx and samples/settings/color.pdx already do
// -- see analog_clock_render_frame's own header note that its ctx_row_
// id argument "is passed straight to widget_paint_rect". No new
// KIND_ slot is claimed here (this file is a pure function library
// over three existing capabilities, the same posture widgets.pdx
// itself takes over KIND_UI_CONTEXT).
//
// =============================================================================
// NOVEL-CLEAN DESIGN: STREAMING TOKENIZER, NO AST
// =============================================================================
//
// Real-editor syntax highlighters fall into two lineages: an
// incremental-parse AST (tree-sitter and kin) that stays correct
// under arbitrary edits but carries real memory + invalidation-
// tracking cost, and a regex/state-machine line scanner (classic
// vim/emacs highlighting, most terminal editors) that re-tokenizes
// whatever is visible every frame and throws the result away. This
// file takes the second lineage on purpose: `editor_render_tokenize_
// range` is a ONE-PASS byte classifier over exactly the buffer range
// the current frame is about to paint -- no persistent token list, no
// incremental re-parse bookkeeping, no AST. Every frame re-derives its
// own coloring from raw bytes. This fits the kernel's fixed-pool, no-
// malloc discipline (the classification output lives in one static
// scratch array, sized to one frame's worst case) and sidesteps the
// AST lineage's hardest problem -- keeping a tree in sync with
// concurrent gap-list mutation -- for the price of doing bounded,
// cheap-per-byte work every frame instead of amortizing it. The
// keyword table is a FIXED single-language (.pdx) table, not a
// dynamic language-plugin registry: per this project's novel-clean
// design bias, a general plugin API is exactly the kind of speculative
// extensibility this kernel's samples avoid until a second concrete
// language actually needs it.
//
// =============================================================================
// ERROR-BOUNDARY TRANSLATION
// =============================================================================
//
// Every public function in this file returns exactly one error
// namespace -- EREN_* -- never an EBUF_* (buffer.pdx) or BDC_*
// (bidi_caret.pdx) sentinel directly. A Buffer-module refusal
// (EBUF_NOT_INIT, an ebuf_is_valid_head()==0 handle) collapses to
// EREN_NOT_INIT / EREN_BUFFER_INVALID; any BidiCaret refusal
// (BDC_CARET_NULL, BDC_NOT_INIT, BDC_BAD_OFFSET, BDC_BAD_VISUAL,
// BDC_BAD_DIRECTION_HINT, BDC_PARAGRAPH_NULL, BDC_ALREADY_INIT)
// collapses to EREN_CARET_INVALID. Callers of this file's public API
// therefore only ever need to recognize ONE band of sentinels.
//
// Discriminating a BidiCaret return value is NOT the "upper 32 bits
// set" test bidi_caret.pdx's own SECTION 1.3 header describes --
// numerically, every literal sentinel it declares (e.g.
// BDC_CARET_NULL = 0xFFFFE81F) fits in 32 bits, so its OWN upper half
// is zero, and that file's `helper_refused` defensive branches (which
// do check upper-32-bits-set) are consequently unreachable dead code
// against its own literals. This file does not rely on that test:
// every place it needs to know whether a BidiCaret call refused, it
// loads the reserved band's low edge (`mov r10, 0xFFFFE810`) and
// compares the return value against it (`cmp rax, r10; jae ...`) --
// safe because no legitimate logical offset or visual column in an
// interactively-edited document reaches anywhere near 2^32-748,911
// (0xFFFFE810's decimal distance below 2^32). The same style of
// threshold compare (`mov r10, 0xFFFFE8A0; cmp rax, r10; jae ...`)
// discriminates a Buffer-module sentinel from a genuine byte count.
//
// =============================================================================
// SYNTAX HIGHLIGHTER
// =============================================================================
//
// editor_render_tokenize_range classifies every byte in a caller-
// supplied range into one of seven classes (TOKEN_KEYWORD, _LITERAL,
// _COMMENT, _ID, _PUNCT, _STRING, _DEFAULT), writing one class byte
// per source byte into a parallel output array. Recognized shapes:
// `//` to end of line (TOKEN_COMMENT); `"..."` with backslash-escape
// skipping, terminated by the closing quote, a bare newline, or end of
// input (TOKEN_STRING); an identifier run classified against the
// fixed keyword table below, or TOKEN_ID if it matches nothing;
// `pub let` / `pub fn` as TWO-WORD compound keywords (the identifier
// "pub" followed by exactly one space and then "let" or "fn" spans
// the WHOLE compound as one TOKEN_KEYWORD run; a bare "pub" not
// followed by one of those is TOKEN_ID, since the fixed table has no
// standalone "pub" entry); a digit-leading run continuing through
// digits/`.`/`_`/`x`/`X`/hex-letters as TOKEN_LITERAL (permissive by
// design -- this is a display-only highlighter, not a literal
// validator: a malformed number still highlights as one run, which is
// the same behavior every mainstream regex-based highlighter gives);
// whitespace as TOKEN_DEFAULT (never painted -- see below); anything
// else as a single-byte TOKEN_PUNCT run.
//
// Fixed keyword table (24 single-word entries, exact per this issue's
// spec): fn, let, mut, unsafe, if, else, match, loop, for, while,
// return, break, continue, struct, enum, mod, impl, trait, where, as,
// in, ref, static, const -- plus the two compound entries pub-let and
// pub-fn recognized structurally in the tokenizer rather than as
// table rows (each reuses the standalone "let" / "fn" string constant
// below for its second-word comparison).
//
// =============================================================================
// RENDER LOOP + PAINT SINK
// =============================================================================
//
// editor_render_frame reads a caller-chosen [range_offset, range_offset
// +range_len) byte window from the buffer (bounded by the fixed 4096-
// byte scratch, one gap-list node's worth -- see buffer.pdx's own
// EBUF_NODE_DATA_BYTES), tokenizes it, then walks the (byte, class)
// pair stream ONE CELL AT A TIME, tracking a monospace (row, col)
// grid position (row increments on '\n', col resets to 0), and issues
// one widget_paint_rect call per non-whitespace byte via this file's
// own editor_render_paint_run helper -- no run-length coalescing.
// This is a deliberate placeholder-era simplification: widget_paint_
// rect is ITSELF still a placeholder (widgets.pdx's own header:
// "Real KIND_SURFACE draw ops land with G12.M2"; today it only bumps
// a counter), so a real per-token-run batching optimization has no
// payoff to collect yet and is deferred to the landing that wires an
// actual GPU/framebuffer draw path. If the caret's logical_offset
// falls inside the visible range, the same walk paints one extra
// marker cell via editor_render_paint_caret at the matching (row,col).
//
// The view geometry is a caller-owned 40-byte cell (ViewGeom, laid out
// below) rather than an argument list, keeping every public entry
// point at or under the 6-argument SysV/unsafe-lambda ceiling.
//
// =============================================================================
// BIDI CARET NAVIGATION
// =============================================================================
//
// Left/right delegate one bidi_caret_move_left/move_right call per
// keypress (visual-adjacent movement, per that file's own LTR-stub
// semantics). Home/End/Up/Down are LOGICAL-UNIT compositions this
// file builds ON TOP of bidi_caret's single-step primitives, since
// that substrate exports no "jump to offset" call: each finds a
// target logical offset via a bounded (512-byte window)
// forward/backward newline scan over the buffer, then issues that
// many single-step bidi_caret_move_left/right calls in a loop
// (editor_render_repeat_move). Up/Down preserve the caret's column
// (distance from its own line's start) against the target line's
// length, clamping short lines -- the standard "sticky column"
// behavior of every mainstream editor.
//
// =============================================================================
// FAILURE TAXONOMY -- 0xFFFFE8C0..0xFFFFE8DF (issue pre-assigned)
// =============================================================================
//
// Grep-verified free at landing time. Seven sentinels numbered from
// the TOP of the band downward, per this tree's convention (buffer.pdx,
// bidi_caret.pdx, kind_tui_canvas.pdx all do the same):
//
//   EREN_NULL              0xFFFFE8DF  required pointer arg == 0
//                                      (view_geom_ptr)
//   EREN_BUFFER_INVALID    0xFFFFE8DE  buffer_id fails ebuf_is_valid_head
//   EREN_CARET_INVALID     0xFFFFE8DD  non-null caret_ptr that is not
//                                      initialized, or any BidiCaret
//                                      refusal surfaced through this
//                                      file's public API
//   EREN_TOKEN_OVERFLOW    0xFFFFE8DC  range_len exceeds the fixed
//                                      4096-byte tokenizer scratch
//   EREN_VIEW_EMPTY        0xFFFFE8DB  range_len == 0, or the
//                                      requested window starts at/past
//                                      end of buffer
//   EREN_REFUSED_DENSE     0xFFFFE8DA  RESERVED, unused this landing --
//                                      this file owns no bounded
//                                      resource pool of its own (unlike
//                                      buffer.pdx's node pool); held for
//                                      a future bounded paint-command
//                                      queue, symmetric with buffer.pdx's
//                                      EBUF_REFUSED_DENSE precedent
//   EREN_NOT_INIT          0xFFFFE8D9  the underlying KIND_EDITOR_BUFFER
//                                      substrate itself was never
//                                      initialized (ebuf_init never ran)
//   0xFFFFE8C0..0xFFFFE8D8 (25 slots) reserved for future growth.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as M0305 module name = Render (PascalCase of file basename
// render.pdx). Every label carries a short per-function tag (ers_,
// ern_, erst_, ecca_, eccd_, eccic_, eccw_, ecclc_, ekc_, ecid_, etr_,
// efls_, efle_, eprn_, epc_, erf_, erm_, ecl_, ecr_, ech_, ece_, ecu_,
// ecd_, eri_) so none collides with a reserved keyword (`loop`, `if`,
// `for`, `match`, `while`, `let`, `mut`, `pub`, `fn`, ...) or a label
// in a sibling module.
//
// No `test rN,rN` (`cmp rN,0` throughout). No `and reg,imm64`. No
// 2-op `imul r,imm` (every multiply here is register-times-register,
// e.g. `imul r9, rdi` computing run_len*cell_w -- proven at
// src/kernel/core/time/tsc.pdx and a dozen other sites). No `neg`/
// `cqo`/`idiv` (no signed division anywhere in this file). No
// `add reg,[mem]` (every accumulate loads to a register first). Every
// unsafe lambda takes at most 6 arguments -- editor_render_paint_run
// sits exactly at that ceiling. Sized byte loads/stores through a
// TWO-REGISTER address ALWAYS carry an explicit `* 1` scale
// (`mov_b rax, [rbx + r14 * 1]`, never `[rbx + r14]`) -- the bare two-
// register form trips a documented paideia-as encoder gap ("G1", see
// design/hardware/nvme-oncs-reliability.md SS8.3 and nvme_admin_events.pdx's
// own file-header note); every OTHER two-register-shaped byte access
// in this file instead pre-adds the index into a scratch register and
// dereferences that single register (`add r10, r14; mov_b rax,
// [r10 + 0]`), the same gap's other documented workaround. The
// fingerprint constant below is a single-line `pub let`. SysV
// alignment: every function's push-count (or push-count-plus-
// `sub rsp,N`) is chosen so rsp%16==0 at every `call` site; no value
// that must survive a nested call is ever left in a caller-saved
// register (rax/rcx/rdx/rsi/rdi/r8/r9/r10/r11) across that call --
// only in a callee-saved register (rbx/rbp/r12-r15) or a fixed stack
// slot, per SysV's own preservation contract (a caller-saved register
// is NOT guaranteed to survive a call regardless of what a specific
// callee happens to touch internally).
//
// MECE SCOPE. This file only. Touches:
//   * NEW: src/samples/editor/render.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (allowlist entry for
//           the data-only "editor render init ok" fingerprint)
// No other .pdx file is modified. Calls into editor_buffer_read_range/
// editor_buffer_len_bytes/ebuf_is_valid_head (buffer.pdx), into
// bidi_caret_get_*/bidi_caret_move_left/bidi_caret_move_right
// (bidi_caret.pdx), and into widget_paint_rect (widgets.pdx) as an
// established cross-module paint sink -- exactly the same three-module
// shape samples/clock/analog.pdx already uses (buffer-shaped state +
// widgets.pdx's paint placeholder), none of which this file edits.
//
// =============================================================================

module Render = structure {

  // ==========================================================================
  // Section 1  Token classes.
  // ==========================================================================

  pub let TOKEN_KEYWORD : u64 = 0
  pub let TOKEN_LITERAL : u64 = 1
  pub let TOKEN_COMMENT : u64 = 2
  pub let TOKEN_ID      : u64 = 3
  pub let TOKEN_PUNCT   : u64 = 4
  pub let TOKEN_STRING  : u64 = 5
  pub let TOKEN_DEFAULT : u64 = 6   // whitespace / newline -- never painted

  // ==========================================================================
  // Section 2  Failure taxonomy -- 0xFFFFE8C0..0xFFFFE8DF. See header.
  // ==========================================================================

  pub let EREN_OK               : u64 = 0
  pub let EREN_NULL             : u64 = 0xFFFFE8DF
  pub let EREN_BUFFER_INVALID   : u64 = 0xFFFFE8DE
  pub let EREN_CARET_INVALID    : u64 = 0xFFFFE8DD
  pub let EREN_TOKEN_OVERFLOW   : u64 = 0xFFFFE8DC
  pub let EREN_VIEW_EMPTY       : u64 = 0xFFFFE8DB
  pub let EREN_REFUSED_DENSE    : u64 = 0xFFFFE8DA  // reserved, unused
  pub let EREN_NOT_INIT         : u64 = 0xFFFFE8D9
  // 0xFFFFE8C0..0xFFFFE8D8 reserved for future growth.

  // ==========================================================================
  // Section 3  ViewGeom -- caller-owned 40-byte cell.
  // ==========================================================================
  //
  //   [+0]  range_offset  u64   byte offset into the buffer where this
  //                             frame's tokenizer window starts
  //   [+8]  range_len     u64   bytes to read+tokenize+paint this frame
  //                             (bounded by EREN_TOKEN_SCRATCH_BYTES)
  //   [+16] origin_x[31:0] | origin_y[63:32]   pixel origin of the text
  //                             area's top-left corner
  //   [+24] cell_w[31:0]   | cell_h[63:32]     pixel size of one
  //                             monospace glyph cell
  //   [+32] cols[31:0]     | rows[63:32]       visible character-grid
  //                             dimensions -- declared for a future
  //                             clipping/line-wrap landing; unused by
  //                             this file's own render loop today
  //                             (matches widget_label's own "text_
  //                             offset/text_len unused in this
  //                             landing" precedent for a field kept
  //                             for ABI shape parity)

  pub let EREN_VG_BYTES            : u64 = 40
  pub let EREN_VG_OFF_RANGE_OFFSET : u64 = 0
  pub let EREN_VG_OFF_RANGE_LEN    : u64 = 8
  pub let EREN_VG_OFF_ORIGIN       : u64 = 16
  pub let EREN_VG_OFF_CELL         : u64 = 24
  pub let EREN_VG_OFF_GRID         : u64 = 32

  pub let EREN_TOKEN_SCRATCH_BYTES : u64 = 4096
  pub let EREN_LINE_SCAN_MAX       : u64 = 512

  // ==========================================================================
  // Section 4  Stats counter slots.
  // ==========================================================================

  pub let EREN_ST_FRAMES       : u64 = 0
  pub let EREN_ST_CARET_MOVES  : u64 = 1   // bumped only by the direct
                                            // single-step ecl_/ecr_
                                            // handlers -- the compound
                                            // ech_/ece_/ecu_/ecd_
                                            // handlers decompose into a
                                            // variable count of
                                            // underlying bidi_caret_
                                            // move_left/right calls,
                                            // already counted at that
                                            // layer's own BDC_ST_MOVES;
                                            // double-counting a single
                                            // Home/End/Up/Down keypress
                                            // as some line-length-
                                            // dependent number of
                                            // "moves" at THIS layer
                                            // would not be a meaningful
                                            // metric.
  pub let EREN_ST_REFUSED      : u64 = 2
  pub let EREN_ST_MAX          : u64 = 8

  // ==========================================================================
  // Section 5  Fixed keyword table (24 single-word entries).
  // ==========================================================================
  //
  // Each entry is NUL-terminated for readability parity with every
  // other short string constant in this tree, but every call site
  // passes an EXPLICIT length immediate (not strlen) since the
  // classifier already knows an identifier run's length from its own
  // scan. "let" and "fn" also double as the second-word comparison
  // target for the pub-let / pub-fn compound check in the tokenizer.

  pub let EREN_KW_PUB      : [u8; 4] = "pub\0"
  pub let EREN_KW_FN       : [u8; 3] = "fn\0"
  pub let EREN_KW_LET      : [u8; 4] = "let\0"
  pub let EREN_KW_MUT      : [u8; 4] = "mut\0"
  pub let EREN_KW_UNSAFE   : [u8; 7] = "unsafe\0"
  pub let EREN_KW_IF       : [u8; 3] = "if\0"
  pub let EREN_KW_ELSE     : [u8; 5] = "else\0"
  pub let EREN_KW_MATCH    : [u8; 6] = "match\0"
  pub let EREN_KW_LOOP     : [u8; 5] = "loop\0"
  pub let EREN_KW_FOR      : [u8; 4] = "for\0"
  pub let EREN_KW_WHILE    : [u8; 6] = "while\0"
  pub let EREN_KW_RETURN   : [u8; 7] = "return\0"
  pub let EREN_KW_BREAK    : [u8; 6] = "break\0"
  pub let EREN_KW_CONTINUE : [u8; 9] = "continue\0"
  pub let EREN_KW_STRUCT   : [u8; 7] = "struct\0"
  pub let EREN_KW_ENUM     : [u8; 5] = "enum\0"
  pub let EREN_KW_MOD      : [u8; 4] = "mod\0"
  pub let EREN_KW_IMPL     : [u8; 5] = "impl\0"
  pub let EREN_KW_TRAIT    : [u8; 6] = "trait\0"
  pub let EREN_KW_WHERE    : [u8; 6] = "where\0"
  pub let EREN_KW_AS       : [u8; 3] = "as\0"
  pub let EREN_KW_IN       : [u8; 3] = "in\0"
  pub let EREN_KW_REF      : [u8; 4] = "ref\0"
  pub let EREN_KW_STATIC   : [u8; 7] = "static\0"
  pub let EREN_KW_CONST    : [u8; 6] = "const\0"

  // ==========================================================================
  // Section 6  State.
  // ==========================================================================

  // One frame's worth of tokenizer input/output, sized to one gap-
  // list node's data region (buffer.pdx EBUF_NODE_DATA_BYTES = 4064,
  // rounded up to a clean 4096 for this file's own bound).
  pub let mut _eren_src_scratch   : [u8; 4096] = uninit @align(64)
  pub let mut _eren_class_scratch : [u8; 4096] = uninit @align(64)

  // Bounded line-boundary scan window (Home/End/Up/Down).
  pub let mut _eren_scan_scratch  : [u8; 512] = uninit @align(64)

  pub let mut _eren_stats : [u64; 8] = uninit @align(64)

  // Placeholder token-class palette (0x00RRGGBB), ABI shape parity
  // with the future real color wire per widget_paint_rect's own
  // header note ("row_id / color unused in this landing"). Indexed by
  // token class 0..5 (TOKEN_DEFAULT=6 is never painted, so slot 6 is
  // unused padding).
  pub let _eren_palette : [u64; 8] = [
    0x00C678DD,   // 0 TOKEN_KEYWORD -- purple
    0x00D19A66,   // 1 TOKEN_LITERAL -- orange
    0x005C6370,   // 2 TOKEN_COMMENT -- gray
    0x00ABB2BF,   // 3 TOKEN_ID      -- default foreground
    0x00ABB2BF,   // 4 TOKEN_PUNCT   -- default foreground
    0x0098C379,   // 5 TOKEN_STRING  -- green
    0x00000000,   // 6 TOKEN_DEFAULT -- unused (never painted)
    0x00000000    // 7 reserved
  ] @align(64)

  pub let EREN_COLOR_CARET : u64 = 0x00FFCC00   // amber caret marker

  // ==========================================================================
  // Section 7  Fingerprint (single-line pub let, legacy-suffixed).
  // ==========================================================================
  //
  // Data-only at this landing, same posture as buffer.pdx's sibling
  // pdx_kind_editor_buffer_meta: real, self-contained bodies exist,
  // but no sample-app dispatcher calls editor_render_init yet, so the
  // marker never reaches a boot log. Allowlisted in tools/verify-
  // fingerprint-coverage.sh.
  //
  // Length: 53 content chars + 1 NUL = 54.
  pub let pdx_kind_editor_render_meta : [u8; 54] = "editor render init ok [legacy: EDITOR RENDER INIT OK]\0"

  // ==========================================================================
  // Section 8  Stats bookkeeping.
  // ==========================================================================

  pub let editor_render_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): clear per-module counters at boot. Load-store zero loop over 8 u64 slots. Leaf. Labels prefixed ers_.",
      block: {
        lea r10, [rip + _eren_stats]
        xor rax, rax
        xor rcx, rcx
      ers_loop:
        mov [r10 + rcx * 8], rax
        add rcx, 1
        cmp rcx, 8
        jb ers_loop
        ret
      }
    }

  pub let editor_render_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): counter bump. Load-inc-store idiom, no `add reg,[mem]`. OOB is a silent no-op. Leaf. Labels prefixed ern_.",
      block: {
        cmp rdi, 8
        jae ern_out
        lea r10, [rip + _eren_stats]
        mov rax, [r10 + rdi * 8]
        add rax, 1
        mov [r10 + rdi * 8], rax
      ern_out:
        ret
      }
    }

  pub let editor_render_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): counter read; OOB -> 0. Leaf. Labels prefixed erst_.",
      block: {
        cmp rdi, 8
        jae erst_zero
        lea r10, [rip + _eren_stats]
        mov rax, [r10 + rdi * 8]
        ret
      erst_zero:
        xor rax, rax
        ret
      }
    }

  // ==========================================================================
  // Section 9  Byte-class predicates (pure leaves).
  // ==========================================================================

  pub let editor_render_cc_alpha_us : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G12-M4-002 (#2338): 1 iff c is 'a'-'z', 'A'-'Z', or '_'. Range-check chain, no test/and. Leaf. Labels prefixed ecca_.",
      block: {
        mov r10, 97
        cmp rdi, r10
        jb ecca_upper
        mov r10, 122
        cmp rdi, r10
        jbe ecca_yes
      ecca_upper:
        mov r10, 65
        cmp rdi, r10
        jb ecca_us
        mov r10, 90
        cmp rdi, r10
        jbe ecca_yes
      ecca_us:
        mov r10, 95
        cmp rdi, r10
        jne ecca_no
      ecca_yes:
        mov rax, 1
        ret
      ecca_no:
        xor rax, rax
        ret
      }
    }

  pub let editor_render_cc_digit : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G12-M4-002 (#2338): 1 iff c is '0'-'9'. Leaf. Labels prefixed eccd_.",
      block: {
        mov r10, 48
        cmp rdi, r10
        jb eccd_no
        mov r10, 57
        cmp rdi, r10
        ja eccd_no
        mov rax, 1
        ret
      eccd_no:
        xor rax, rax
        ret
      }
    }

  pub let editor_render_cc_ident_cont : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G12-M4-002 (#2338): 1 iff c continues an identifier (alpha, digit, or underscore). One callee-save push (rbx=c) reaches rsp%16==0 across both nested calls (entry rsp%16==8, +8=0). Labels prefixed eccic_.",
      block: {
        push rbx
        mov rbx, rdi
        call editor_render_cc_alpha_us
        cmp rax, 0
        jne eccic_yes
        mov rdi, rbx
        call editor_render_cc_digit
        cmp rax, 0
        je eccic_no
      eccic_yes:
        mov rax, 1
        pop rbx
        ret
      eccic_no:
        xor rax, rax
        pop rbx
        ret
      }
    }

  pub let editor_render_cc_ws : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G12-M4-002 (#2338): 1 iff c is space, tab, LF, or CR. Leaf. Labels prefixed eccw_.",
      block: {
        mov r10, 32
        cmp rdi, r10
        je eccw_yes
        mov r10, 9
        cmp rdi, r10
        je eccw_yes
        mov r10, 10
        cmp rdi, r10
        je eccw_yes
        mov r10, 13
        cmp rdi, r10
        jne eccw_no
      eccw_yes:
        mov rax, 1
        ret
      eccw_no:
        xor rax, rax
        ret
      }
    }

  pub let editor_render_cc_literal_cont : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G12-M4-002 (#2338): 1 iff c continues a numeric literal run: digit, '.', '_', 'x'/'X', or 'a'-'f'/'A'-'F'. Permissive on purpose -- display-only highlighter, not a literal validator. One callee-save push (rbx=c) for the nested cc_digit call. Labels prefixed ecclc_.",
      block: {
        push rbx
        mov rbx, rdi
        call editor_render_cc_digit
        cmp rax, 0
        jne ecclc_yes
        mov r10, 46
        cmp rbx, r10
        je ecclc_yes
        mov r10, 95
        cmp rbx, r10
        je ecclc_yes
        mov r10, 120
        cmp rbx, r10
        je ecclc_yes
        mov r10, 88
        cmp rbx, r10
        je ecclc_yes
        mov r10, 97
        cmp rbx, r10
        jb ecclc_upper_hex
        mov r10, 102
        cmp rbx, r10
        jbe ecclc_yes
      ecclc_upper_hex:
        mov r10, 65
        cmp rbx, r10
        jb ecclc_no
        mov r10, 70
        cmp rbx, r10
        ja ecclc_no
      ecclc_yes:
        mov rax, 1
        pop rbx
        ret
      ecclc_no:
        xor rax, rax
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 10  Keyword-table matcher.
  // ==========================================================================

  // editor_render_kw_check(ident_ptr, ident_len, kw_ptr, kw_len) -> 1|0.
  // Length-gated exact byte compare. Only touches rax/r8/r9 internally
  // (never r10/r11) so a caller that needs r10/r11 to survive this
  // call may rely on that -- documented here rather than depended on
  // silently anywhere in this file (every actual call site below still
  // uses a callee-saved register or a stack slot for anything that
  // must outlive the call, per this file's own stated discipline).
  pub let editor_render_kw_check : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) (kw_ptr: u64) (kw_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): bounded exact byte compare, length-gated. mov_b loads use explicit `* 1` scale (two-register form otherwise trips the G1 encoder gap -- see file header). Leaf. Labels prefixed ekc_.",
      block: {
        cmp rsi, rcx
        jne ekc_no
        xor r8, r8
      ekc_loop:
        cmp r8, rsi
        jae ekc_yes
        xor r9, r9
        mov_b r9, [rdi + r8 * 1]
        xor rax, rax
        mov_b rax, [rdx + r8 * 1]
        cmp r9, rax
        jne ekc_no
        add r8, 1
        jmp ekc_loop
      ekc_yes:
        mov rax, 1
        ret
      ekc_no:
        xor rax, rax
        ret
      }
    }

  // editor_render_classify_ident(ident_ptr, ident_len) -> TOKEN_KEYWORD
  // | TOKEN_ID. Tries all 24 single-word table entries in sequence;
  // falls through to TOKEN_ID. Two callee-save pushes + sub rsp,8
  // (rbx=ident_ptr, r12=ident_len) reach rsp%16==0 across every kw_
  // check call (entry rsp%16==8, +16+8=32).
  pub let editor_render_classify_ident : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): try each of the 24 fixed single-word keywords against the identifier run via editor_render_kw_check; TOKEN_ID (3) on no match. Two callee-save pushes + sub rsp,8 land rsp%16==0 across every nested call (entry rsp%16==8, +16+8=32). Straight-line unrolled dispatch (no jump table anywhere in this tree). Labels prefixed ecid_.",
      block: {
        push rbx
        push r12
        sub rsp, 8

        mov rbx, rdi
        mov r12, rsi

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_FN]
        mov rcx, 2
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_LET]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_MUT]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_UNSAFE]
        mov rcx, 6
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_IF]
        mov rcx, 2
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_ELSE]
        mov rcx, 4
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_MATCH]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_LOOP]
        mov rcx, 4
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_FOR]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_WHILE]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_RETURN]
        mov rcx, 6
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_BREAK]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_CONTINUE]
        mov rcx, 8
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_STRUCT]
        mov rcx, 6
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_ENUM]
        mov rcx, 4
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_MOD]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_IMPL]
        mov rcx, 4
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_TRAIT]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_WHERE]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_AS]
        mov rcx, 2
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_IN]
        mov rcx, 2
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_REF]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_STATIC]
        mov rcx, 6
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rdi, rbx
        mov rsi, r12
        lea rdx, [rip + EREN_KW_CONST]
        mov rcx, 5
        call editor_render_kw_check
        cmp rax, 0
        jne ecid_kw

        mov rax, 3               // TOKEN_ID -- no keyword matched
        jmp ecid_out

      ecid_kw:
        xor rax, rax              // TOKEN_KEYWORD

      ecid_out:
        add rsp, 8
        pop r12
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 11  Streaming tokenizer.
  // ==========================================================================

  // editor_render_tokenize_range(src_ptr, src_len, out_class_ptr,
  // max_len) -> src_len | EREN_TOKEN_OVERFLOW. One-pass byte
  // classifier; see file header for the recognized shapes. Five
  // callee-save pushes + sub rsp,16 (rbx=src_ptr, r12=src_len,
  // r13=out_class_ptr, r14=cursor `i`, r15=current-run `start`; the
  // 16-byte local frame holds the pub-let/pub-fn compound check's
  // word2-start/word2-end spill at [rsp+0]/[rsp+8], needed because
  // that check makes up to two editor_render_kw_check calls and the
  // second attempt needs both values recomputed from a stack-resident
  // source, not a caller-saved register, across the first call).
  // Entry rsp%16==8; 5 pushes (odd count) -> 0; +16 stays 0.
  pub let editor_render_tokenize_range : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) (out_class_ptr: u64) (max_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): one-pass byte classifier over [src_ptr, src_ptr+src_len). Recognizes `//` comments, `\"...\"` strings, identifier runs (fixed keyword table + pub-let/pub-fn compounds), digit-leading literal runs, whitespace runs, and single-byte punctuation, filling out_class[i] for every i via the shared etr_fill_common tail (all seven branches converge there, differing only in the (r15=start, r14=end, r9=class) triple they set before the jump -- avoiding six copies of the fill loop). Five callee-save pushes + sub rsp,16 land rsp%16==0 (entry rsp%16==8, +40+16=64). Every two-register mov_b uses an explicit `* 1` scale (G1 gap, see file header). Labels prefixed etr_.",
      block: {
        push rbx
        push r12
        push r13
        push r14
        push r15
        sub rsp, 16

        cmp rsi, rcx
        ja etr_overflow

        mov rbx, rdi
        mov r12, rsi
        mov r13, rdx
        xor r14, r14

      etr_loop:
        cmp r14, r12
        jae etr_done

        xor rax, rax
        mov_b rax, [rbx + r14 * 1]

        // ---- comment: "//" ----
        mov r10, 47
        cmp rax, r10
        jne etr_try_string

        mov r10, r14
        add r10, 1
        cmp r10, r12
        jae etr_try_string
        xor r9, r9
        mov_b r9, [rbx + r10 * 1]
        mov r10, 47
        cmp r9, r10
        jne etr_try_string

        mov r15, r14
      etr_cmt_scan:
        cmp r14, r12
        jae etr_cmt_fill
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov r10, 10
        cmp rax, r10
        je etr_cmt_fill
        add r14, 1
        jmp etr_cmt_scan
      etr_cmt_fill:
        mov r9, 2                       // TOKEN_COMMENT
        jmp etr_fill_common

      etr_try_string:
        mov r10, 34                       // '"'
        cmp rax, r10
        jne etr_try_ident

        mov r15, r14
        add r14, 1
      etr_str_scan:
        cmp r14, r12
        jae etr_str_fill
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov r10, 34
        cmp rax, r10
        je etr_str_close
        mov r10, 10
        cmp rax, r10
        je etr_str_fill
        mov r10, 92                        // '\'
        cmp rax, r10
        jne etr_str_advance
        mov r10, r14
        add r10, 1
        cmp r10, r12
        jae etr_str_advance
        add r14, 1
      etr_str_advance:
        add r14, 1
        jmp etr_str_scan
      etr_str_close:
        add r14, 1
      etr_str_fill:
        mov r9, 5                          // TOKEN_STRING
        jmp etr_fill_common

      etr_try_ident:
        mov rdi, rax
        call editor_render_cc_alpha_us
        cmp rax, 0
        je etr_try_digit

        mov r15, r14
      etr_ident_scan:
        cmp r14, r12
        jae etr_ident_end
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov rdi, rax
        call editor_render_cc_ident_cont
        cmp rax, 0
        je etr_ident_end
        add r14, 1
        jmp etr_ident_scan
      etr_ident_end:

        mov rax, r14
        sub rax, r15
        mov r10, 3
        cmp rax, r10
        jne etr_ident_classify

        mov rdi, rbx
        add rdi, r15
        mov rsi, 3
        lea rdx, [rip + EREN_KW_PUB]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        je etr_ident_classify

        // ---- pub-let / pub-fn compound: exactly one space, then an
        // identifier matching "let" or "fn" ----
        cmp r14, r12
        jae etr_pub_alone
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov r10, 32
        cmp rax, r10
        jne etr_pub_alone

        mov rax, r14
        add rax, 1
        cmp rax, r12
        jae etr_pub_alone
        mov [rsp + 0], rax                    // w2s

        xor rdi, rdi
        mov_b rdi, [rbx + rax * 1]
        call editor_render_cc_alpha_us
        cmp rax, 0
        je etr_pub_alone

        mov r8, [rsp + 0]
      etr_pub_w2_scan:
        // Inlined is_ident_cont check (rather than calling
        // editor_render_cc_ident_cont) so r8, the scan cursor, never
        // has to survive a nested call while living in a caller-saved
        // register -- r8/r9/r10/r11 are NOT guaranteed to survive any
        // `call` regardless of what a specific callee happens to
        // touch (see file header's error-boundary/register-discipline
        // note); every OTHER loop in this file keeps its cursor in a
        // callee-saved register instead; this is the one spot where
        // none of rbx/r12/r13/r14/r15 is free (all five are already
        // committed to src_ptr/src_len/out_class_ptr/pub_end/pub_
        // start), so inlining the predicate is the correct fix rather
        // than the call.
        cmp r8, r12
        jae etr_pub_w2_done
        xor rax, rax
        mov_b rax, [rbx + r8 * 1]
        mov r10, 97
        cmp rax, r10
        jb etr_pub_w2c_upper
        mov r10, 122
        cmp rax, r10
        jbe etr_pub_w2c_yes
      etr_pub_w2c_upper:
        mov r10, 65
        cmp rax, r10
        jb etr_pub_w2c_digit
        mov r10, 90
        cmp rax, r10
        jbe etr_pub_w2c_yes
      etr_pub_w2c_digit:
        mov r10, 48
        cmp rax, r10
        jb etr_pub_w2c_us
        mov r10, 57
        cmp rax, r10
        jbe etr_pub_w2c_yes
      etr_pub_w2c_us:
        mov r10, 95
        cmp rax, r10
        jne etr_pub_w2_done
      etr_pub_w2c_yes:
        add r8, 1
        jmp etr_pub_w2_scan
      etr_pub_w2_done:
        mov [rsp + 8], r8                       // w2_end

        mov rax, r8
        mov r9, [rsp + 0]
        sub rax, r9                                // w2len

        mov rdi, rbx
        add rdi, r9
        mov rsi, rax
        lea rdx, [rip + EREN_KW_LET]
        mov rcx, 3
        call editor_render_kw_check
        cmp rax, 0
        jne etr_pub_found

        mov rax, [rsp + 8]
        mov r9, [rsp + 0]
        sub rax, r9
        mov r10, 2
        cmp rax, r10
        jne etr_pub_alone

        mov rdi, rbx
        add rdi, r9
        mov rsi, rax
        lea rdx, [rip + EREN_KW_FN]
        mov rcx, 2
        call editor_render_kw_check
        cmp rax, 0
        je etr_pub_alone

      etr_pub_found:
        mov r14, [rsp + 8]
        mov r9, 0                                    // TOKEN_KEYWORD
        jmp etr_fill_common

      etr_pub_alone:
        mov r9, 3                                      // TOKEN_ID
        jmp etr_fill_common

      etr_ident_classify:
        mov rdi, rbx
        add rdi, r15
        mov rsi, r14
        sub rsi, r15
        call editor_render_classify_ident
        mov r9, rax
        jmp etr_fill_common

      etr_try_digit:
        mov rdi, rax
        call editor_render_cc_digit
        cmp rax, 0
        je etr_try_ws

        mov r15, r14
      etr_lit_scan:
        cmp r14, r12
        jae etr_lit_fill
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov rdi, rax
        call editor_render_cc_literal_cont
        cmp rax, 0
        je etr_lit_fill
        add r14, 1
        jmp etr_lit_scan
      etr_lit_fill:
        mov r9, 1                                        // TOKEN_LITERAL
        jmp etr_fill_common

      etr_try_ws:
        mov rdi, rax
        call editor_render_cc_ws
        cmp rax, 0
        je etr_punct

        mov r15, r14
      etr_ws_scan:
        cmp r14, r12
        jae etr_ws_fill
        xor rax, rax
        mov_b rax, [rbx + r14 * 1]
        mov rdi, rax
        call editor_render_cc_ws
        cmp rax, 0
        je etr_ws_fill
        add r14, 1
        jmp etr_ws_scan
      etr_ws_fill:
        mov r9, 6                                          // TOKEN_DEFAULT
        jmp etr_fill_common

      etr_punct:
        mov r15, r14
        add r14, 1
        mov r9, 4                                            // TOKEN_PUNCT
        jmp etr_fill_common

      etr_fill_common:
        cmp r15, r14
        jae etr_loop
        mov r10, r15
      etr_fill_loop:
        cmp r10, r14
        jae etr_loop
        mov_b [r13 + r10 * 1], r9
        add r10, 1
        jmp etr_fill_loop

      etr_done:
        mov rax, r12
        jmp etr_out

      etr_overflow:
        mov rax, 0xFFFFE8DC                                    // EREN_TOKEN_OVERFLOW

      etr_out:
        add rsp, 16
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 12  Line-boundary helpers (Home/End/Up/Down).
  // ==========================================================================

  // editor_render_find_line_start(buffer_id, from_offset) -> line_start
  // offset. Reads a single up-to-512-byte window ending at from_offset
  // and scans it backward for the last '\n'; clamps to the window's
  // own start if none is found (a line longer than 512 bytes is a
  // known, documented bound on this heuristic). Three callee-save
  // pushes (rbx=buffer_id, r12=from_offset, r13=window_len) reach
  // rsp%16==0 across the one nested call (entry rsp%16==8, +24=32).
  pub let editor_render_find_line_start : (u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (from_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): bounded backward newline scan. window_len = min(from_offset, 512); window_start recomputed on demand as from_offset-window_len (both callee-saved, safe across the read call) rather than cached in a caller-saved register. Three pushes reach rsp%16==0 (entry rsp%16==8, +24=32). Labels prefixed efls_.",
      block: {
        push rbx
        push r12
        push r13

        cmp rsi, 0
        je efls_at_zero

        mov rbx, rdi
        mov r12, rsi

        mov rax, 512
        cmp r12, rax
        jae efls_use_cap
        mov rax, r12
      efls_use_cap:
        mov r13, rax

        mov rdi, rbx
        mov rsi, r12
        sub rsi, r13
        mov rdx, r13
        lea rcx, [rip + _eren_scan_scratch]
        call editor_buffer_read_range

        mov r10, 0xFFFFE8A0
        cmp rax, r10
        jae efls_clamp

        cmp r13, 0
        je efls_clamp

        mov r10, r13
        sub r10, 1
      efls_scan_loop:
        lea r11, [rip + _eren_scan_scratch]
        add r11, r10
        xor rax, rax
        mov_b rax, [r11 + 0]
        mov r9, 10
        cmp rax, r9
        je efls_found
        cmp r10, 0
        je efls_clamp
        sub r10, 1
        jmp efls_scan_loop

      efls_found:
        mov rax, r12
        sub rax, r13
        add rax, r10
        add rax, 1
        jmp efls_out

      efls_clamp:
        mov rax, r12
        sub rax, r13
        jmp efls_out

      efls_at_zero:
        xor rax, rax
        jmp efls_out

      efls_out:
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // editor_render_find_line_end(buffer_id, from_offset, total_len) ->
  // line_end offset (position of the terminating '\n', or total_len
  // if none is found within the bounded forward window, or if
  // from_offset is already at/past total_len). Three callee-save
  // pushes reach rsp%16==0 across the one nested call.
  pub let editor_render_find_line_end : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (from_offset: u64) (total_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): bounded forward newline scan. window_len = min(total_len-from_offset, 512), reusing r13 (total_len is dead after this point on every reachable path). Three pushes reach rsp%16==0 (entry rsp%16==8, +24=32). Labels prefixed efle_.",
      block: {
        push rbx
        push r12
        push r13

        mov rbx, rdi
        mov r12, rsi
        mov r13, rdx

        cmp r12, r13
        jae efle_at_end

        mov rax, r13
        sub rax, r12
        mov r10, 512
        cmp rax, r10
        jbe efle_window_ready
        mov rax, r10
      efle_window_ready:
        mov r13, rax

        mov rdi, rbx
        mov rsi, r12
        mov rdx, r13
        lea rcx, [rip + _eren_scan_scratch]
        call editor_buffer_read_range

        mov r10, 0xFFFFE8A0
        cmp rax, r10
        jae efle_clamp

        cmp r13, 0
        je efle_clamp

        xor r10, r10
      efle_scan_loop:
        cmp r10, r13
        jae efle_clamp
        lea r11, [rip + _eren_scan_scratch]
        add r11, r10
        xor rax, rax
        mov_b rax, [r11 + 0]
        mov r9, 10
        cmp rax, r9
        je efle_found
        add r10, 1
        jmp efle_scan_loop

      efle_found:
        mov rax, r12
        add rax, r10
        jmp efle_out

      efle_clamp:
        mov rax, r12
        add rax, r13
        jmp efle_out

      efle_at_end:
        mov rax, r13
        jmp efle_out

      efle_out:
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 13  Paint helpers.
  // ==========================================================================

  // editor_render_paint_run(view_geom_ptr, ctx_row_id, klass, row,
  // col_start, run_len) -> (). Sits at the 6-argument ceiling. Skips
  // TOKEN_DEFAULT (whitespace) and any out-of-range class silently.
  // No callee-saved register is needed: the only call in this function
  // is the tail call to widget_paint_rect, so every intermediate value
  // may live in a caller-saved register for its whole (short) life --
  // nothing needs to survive that call, since nothing is read from a
  // register after it. `sub rsp,24` (16-byte rect scratch + 8 padding)
  // lands rsp%16==0 (entry rsp%16==8, 8-24 = -16 == 0 mod 16).
  pub let editor_render_paint_run : (u64, u64, u64, u64, u64, u64) -> () !{mem} @{} =
    fn (view_geom_ptr: u64) (ctx_row_id: u64) (klass: u64) (row: u64) (col_start: u64) (run_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): paint one token-class run as one widget_paint_rect call. Skips klass>=6 (TOKEN_DEFAULT and out-of-range). rect.x=origin_x+col_start*cell_w, rect.y=origin_y+row*cell_h, rect.w=run_len*cell_w, rect.h=cell_h; every multiply is register-register `imul` (never the banned 2-op imm form). Zero callee-save pushes needed -- the single call at the tail means nothing must survive it. `sub rsp,24` lands rsp%16==0 (entry 8, 8-24=-16==0 mod16). Labels prefixed eprn_.",
      block: {
        sub rsp, 24

        cmp rdi, 0
        je eprn_out
        mov r10, 6
        cmp rdx, r10
        jae eprn_out

        mov r10, rsi                    // r10 = ctx_row_id
        mov r11, rdx                      // r11 = klass

        mov rax, [rdi + 16]
        mov rsi, rax
        shl rsi, 32
        shr rsi, 32                          // rsi = origin_x
        shr rax, 32                            // rax = origin_y

        mov rdx, [rdi + 24]
        mov rdi, rdx
        shl rdi, 32
        shr rdi, 32                              // rdi = cell_w
        shr rdx, 32                                // rdx = cell_h

        imul r9, rdi                                 // r9 = run_len * cell_w = rect.w
        imul r8, rdi                                   // r8 = col_start * cell_w
        add r8, rsi                                      // r8 = rect.x

        imul rcx, rdx                                      // rcx = row * cell_h
        add rcx, rax                                         // rcx = rect.y

        mov_d [rsp + 0], r8                                    // rect.x
        mov_d [rsp + 4], rcx                                     // rect.y
        mov_d [rsp + 8], r9                                        // rect.w
        mov_d [rsp + 12], rdx                                        // rect.h

        lea r9, [rip + _eren_palette]
        mov rax, [r9 + r11 * 8]                                        // color

        mov rdi, r10
        lea rsi, [rsp + 0]
        mov rdx, rax
        call widget_paint_rect

      eprn_out:
        add rsp, 24
        ret
      }
    }

  // editor_render_paint_caret(view_geom_ptr, ctx_row_id, row, col) ->
  // (). Unconditional (no class gate); fixed EREN_COLOR_CARET. Zero
  // callee-saved pushes needed for the same reason as paint_run:
  // the single widget_paint_rect call is this function's last act.
  pub let editor_render_paint_caret : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (view_geom_ptr: u64) (ctx_row_id: u64) (row: u64) (col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): paint a one-cell caret marker. Same rect math as editor_render_paint_run without the class gate/palette lookup (fixed EREN_COLOR_CARET). `sub rsp,24` lands rsp%16==0 (entry 8, 8-24=-16==0 mod16). Labels prefixed epc_.",
      block: {
        sub rsp, 24

        cmp rdi, 0
        je epc_out

        mov r10, rsi                // ctx_row_id
        mov r11, rdx                  // row
        mov r9, rcx                     // col

        mov rax, [rdi + 16]
        mov r8, rax
        shl r8, 32
        shr r8, 32                         // r8 = origin_x
        shr rax, 32                          // rax = origin_y

        mov rdx, [rdi + 24]
        mov rdi, rdx
        shl rdi, 32
        shr rdi, 32                            // rdi = cell_w
        shr rdx, 32                               // rdx = cell_h

        imul r9, rdi                                // r9 = col * cell_w
        add r9, r8                                    // r9 = rect.x

        imul r11, rdx                                   // r11 = row * cell_h
        add r11, rax                                      // r11 = rect.y

        mov_d [rsp + 0], r9
        mov_d [rsp + 4], r11
        mov_d [rsp + 8], rdi
        mov_d [rsp + 12], rdx

        mov rdi, r10
        lea rsi, [rsp + 0]
        mov rdx, 0x00FFCC00              // EREN_COLOR_CARET
        call widget_paint_rect

      epc_out:
        add rsp, 24
        ret
      }
    }

  // ==========================================================================
  // Section 14  Render-frame entrypoint.
  // ==========================================================================

  // editor_render_frame(buffer_id, caret_ptr, view_geom_ptr,
  // ctx_row_id) -> EREN_OK | EREN_NULL | EREN_BUFFER_INVALID |
  // EREN_CARET_INVALID | EREN_TOKEN_OVERFLOW | EREN_VIEW_EMPTY |
  // EREN_NOT_INIT. Reads + tokenizes the requested view range, then
  // paints one cell at a time. caret_ptr may be 0 (no caret marker
  // painted); a non-null caret_ptr that fails BidiCaret's own
  // initialized check is a hard refusal.
  //
  // Six callee-save pushes + sub rsp,24 (rbx, rbp, r12, r13, r14, r15;
  // entry rsp%16==8, +48+24=80). Two DISTINCT register-role phases
  // share the same six slots: SETUP (r14=buffer_id, rbx=caret_ptr,
  // r12=view_geom_ptr, r13=ctx_row_id, r15=range_len; buffer_id and
  // caret_ptr are dead once their last respective use -- the read_
  // range call, and the caret-target-index block -- completes) and
  // PAINT LOOP (r14=idx, rbx=row, rbp=col, r12/r13/r15 unchanged).
  // [rsp+0] holds the caret's target index within the scratch buffer
  // (0xFFFFFFFF sentinel = no caret to mark); [rsp+8] holds
  // range_offset, needed again inside the caret-setup block after an
  // intervening editor_buffer_len_bytes call.
  pub let editor_render_frame : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (caret_ptr: u64) (view_geom_ptr: u64) (ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): main render-frame entrypoint. Validates view_geom_ptr + buffer_id, loads+clamps the requested byte range against the buffer's total_len, reads it into _eren_src_scratch, tokenizes it into _eren_class_scratch, resolves the caret's target index (if any) relative to that range, then walks the range one byte at a time tracking (row,col), painting a caret marker at the matching index and a token-class run for every non-newline byte. Six callee-save pushes + sub rsp,24 land rsp%16==0 (entry rsp%16==8, +48+24=80). Register roles are reused across the sequential setup/paint-loop phases (see the section-header comment above) -- never across a SINGLE value's own live range, which is always either callee-saved or spilled to [rsp+0]/[rsp+8] wherever it must survive a nested call. Labels prefixed erf_.",
      block: {
        push rbx
        push rbp
        push r12
        push r13
        push r14
        push r15
        sub rsp, 24

        mov r14, rdi                 // buffer_id (setup phase)
        mov rbx, rsi                   // caret_ptr (setup phase)
        mov r12, rdx                     // view_geom_ptr (whole function)
        mov r13, rcx                       // ctx_row_id (whole function)

        cmp r12, 0
        je erf_null

        mov rdi, r14
        call ebuf_is_valid_head
        cmp rax, 0
        je erf_buffer_invalid

        mov rax, [r12 + 0]
        mov [rsp + 8], rax              // range_offset
        mov r15, [r12 + 8]                // range_len

        cmp r15, 0
        je erf_view_empty

        mov r10, 4096
        cmp r15, r10
        ja erf_token_overflow

        mov rdi, r14
        call editor_buffer_len_bytes
        mov r10, 0xFFFFE8A0
        cmp rax, r10
        jae erf_not_init

        mov r11, [rsp + 8]
        cmp r11, rax
        jae erf_view_empty

        mov r10, rax
        sub r10, r11
        cmp r15, r10
        jbe erf_range_ok
        mov r15, r10
      erf_range_ok:

        mov rdi, r14
        mov rsi, r11
        mov rdx, r15
        lea rcx, [rip + _eren_src_scratch]
        call editor_buffer_read_range

        lea rdi, [rip + _eren_src_scratch]
        mov rsi, r15
        lea rdx, [rip + _eren_class_scratch]
        mov rcx, 4096
        call editor_render_tokenize_range
        mov r10, 0xFFFFE8DC
        cmp rax, r10
        je erf_token_overflow

        mov rax, 0xFFFFFFFF
        mov [rsp + 0], rax                 // caret target index: none yet

        cmp rbx, 0
        je erf_caret_setup_done

        mov rdi, rbx
        call bidi_caret_get_paragraph_ptr
        cmp rax, 0
        je erf_caret_invalid

        mov rdi, rbx
        call bidi_caret_get_logical_offset

        mov r10, [rsp + 8]                  // range_offset
        cmp rax, r10
        jb erf_caret_setup_done

        mov r11, r10
        add r11, r15
        cmp rax, r11
        jae erf_caret_setup_done

        sub rax, r10
        mov [rsp + 0], rax

      erf_caret_setup_done:
        xor r14, r14                          // idx (paint-loop phase)
        xor rbx, rbx                            // row (paint-loop phase)
        xor rbp, rbp                              // col (paint-loop phase)

      erf_loop:
        cmp r14, r15
        jae erf_loop_done

        mov r10, [rsp + 0]
        cmp r14, r10
        jne erf_no_caret

        mov rdi, r12
        mov rsi, r13
        mov rdx, rbx
        mov rcx, rbp
        call editor_render_paint_caret

      erf_no_caret:
        // Reload src/class bytes AFTER the optional caret-paint call
        // above -- that call is free to clobber any caller-saved
        // register, so nothing computed before it may be relied on
        // here.
        lea r10, [rip + _eren_src_scratch]
        add r10, r14
        xor rax, rax
        mov_b rax, [r10 + 0]

        lea r10, [rip + _eren_class_scratch]
        add r10, r14
        xor r11, r11
        mov_b r11, [r10 + 0]

        mov r10, 10
        cmp rax, r10
        je erf_newline

        mov rdi, r12
        mov rsi, r13
        mov rdx, r11
        mov rcx, rbx
        mov r8, rbp
        mov r9, 1
        call editor_render_paint_run

        add rbp, 1
        add r14, 1
        jmp erf_loop

      erf_newline:
        add rbx, 1
        xor rbp, rbp
        add r14, 1
        jmp erf_loop

      erf_loop_done:
        mov rdi, 0                            // EREN_ST_FRAMES
        call editor_render_note
        xor rax, rax                            // EREN_OK
        jmp erf_out

      erf_null:
        mov rax, 0xFFFFE8DF
        jmp erf_refused
      erf_buffer_invalid:
        mov rax, 0xFFFFE8DE
        jmp erf_refused
      erf_caret_invalid:
        mov rax, 0xFFFFE8DD
        jmp erf_refused
      erf_token_overflow:
        mov rax, 0xFFFFE8DC
        jmp erf_refused
      erf_view_empty:
        mov rax, 0xFFFFE8DB
        jmp erf_refused
      erf_not_init:
        mov rax, 0xFFFFE8D9

      erf_refused:
        mov r10, rax
        mov rdi, 2                              // EREN_ST_REFUSED
        call editor_render_note
        mov rax, r10

      erf_out:
        add rsp, 24
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbp
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 15  Caret movement.
  // ==========================================================================

  // editor_render_repeat_move(caret_ptr, count, direction) -> visual_x
  // | EREN_CARET_INVALID. direction 0=left, 1=right. Issues `count`
  // single-step bidi_caret_move_left/right calls, stopping early on
  // the first refusal (threshold-compared against BidiCaret's
  // reserved band per the file header's discrimination note). Three
  // callee-save pushes reach rsp%16==0 (entry rsp%16==8, +24=32).
  pub let editor_render_repeat_move : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) (count: u64) (direction: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): repeat a single-step bidi_caret_move_left/right call `count` times, stopping early on refusal. Three callee-save pushes (rbx=caret_ptr, r12=remaining, r13=direction) reach rsp%16==0 (entry rsp%16==8, +24=32). Internal helper -- does not itself null/init-check caret_ptr; every public caller in this file validates first. Labels prefixed erm_.",
      block: {
        push rbx
        push r12
        push r13

        mov rbx, rdi
        mov r12, rsi
        mov r13, rdx

      erm_loop:
        cmp r12, 0
        je erm_success

        cmp r13, 0
        jne erm_do_right

        mov rdi, rbx
        call bidi_caret_move_left
        jmp erm_check

      erm_do_right:
        mov rdi, rbx
        call bidi_caret_move_right

      erm_check:
        mov r10, 0xFFFFE810
        cmp rax, r10
        jae erm_refused

        sub r12, 1
        jmp erm_loop

      erm_success:
        mov rdi, rbx
        call bidi_caret_get_visual_x
        jmp erm_out

      erm_refused:
        mov rax, 0xFFFFE8DD             // EREN_CARET_INVALID

      erm_out:
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // editor_render_caret_left(caret_ptr) -> visual_x | EREN_NULL |
  // EREN_CARET_INVALID. One callee-save push (rbx) reaches rsp%16==0
  // across both nested calls (entry rsp%16==8, +8=0).
  pub let editor_render_caret_left : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): single left-arrow step via bidi_caret_move_left. One callee-save push (rbx=result stash) reaches rsp%16==0 across both nested calls (entry rsp%16==8, +8=0). Labels prefixed ecl_.",
      block: {
        cmp rdi, 0
        je ecl_null

        push rbx
        call bidi_caret_move_left

        mov r10, 0xFFFFE810
        cmp rax, r10
        jae ecl_invalid

        mov rbx, rax
        mov rdi, 1                     // EREN_ST_CARET_MOVES
        call editor_render_note
        mov rax, rbx
        pop rbx
        ret

      ecl_invalid:
        pop rbx
        mov rax, 0xFFFFE8DD
        ret

      ecl_null:
        mov rax, 0xFFFFE8DF
        ret
      }
    }

  // editor_render_caret_right(caret_ptr) -> visual_x | EREN_NULL |
  // EREN_CARET_INVALID. Mirror of caret_left.
  pub let editor_render_caret_right : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): single right-arrow step via bidi_caret_move_right. Mirror of editor_render_caret_left. Labels prefixed ecr_.",
      block: {
        cmp rdi, 0
        je ecr_null

        push rbx
        call bidi_caret_move_right

        mov r10, 0xFFFFE810
        cmp rax, r10
        jae ecr_invalid

        mov rbx, rax
        mov rdi, 1
        call editor_render_note
        mov rax, rbx
        pop rbx
        ret

      ecr_invalid:
        pop rbx
        mov rax, 0xFFFFE8DD
        ret

      ecr_null:
        mov rax, 0xFFFFE8DF
        ret
      }
    }

  // editor_render_caret_home(buffer_id, caret_ptr) -> visual_x |
  // EREN_NULL | EREN_CARET_INVALID. Moves left to the start of the
  // caret's current line. Three callee-save pushes reach rsp%16==0
  // (entry rsp%16==8, +24=32).
  pub let editor_render_caret_home : (u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): Home -- move to the current line's start via editor_render_find_line_start, then editor_render_repeat_move left by (cur-target) steps. Three callee-save pushes (rbx=buffer_id, r12=caret_ptr, r13=cur) reach rsp%16==0 (entry rsp%16==8, +24=32). Labels prefixed ech_.",
      block: {
        push rbx
        push r12
        push r13

        cmp rsi, 0
        je ech_caret_null

        mov rbx, rdi
        mov r12, rsi

        mov rdi, r12
        call bidi_caret_get_paragraph_ptr
        cmp rax, 0
        je ech_caret_invalid

        mov rdi, r12
        call bidi_caret_get_logical_offset
        mov r13, rax

        mov rdi, rbx
        mov rsi, r13
        call editor_render_find_line_start

        mov r10, r13
        sub r10, rax

        mov rdi, r12
        mov rsi, r10
        xor rdx, rdx
        call editor_render_repeat_move
        jmp ech_out

      ech_caret_null:
        mov rax, 0xFFFFE8DF
        jmp ech_out
      ech_caret_invalid:
        mov rax, 0xFFFFE8DD
        jmp ech_out

      ech_out:
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // editor_render_caret_end(buffer_id, caret_ptr) -> visual_x |
  // EREN_NULL | EREN_CARET_INVALID. Moves right to the end of the
  // caret's current line.
  pub let editor_render_caret_end : (u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): End -- move to the current line's end via editor_buffer_len_bytes + editor_render_find_line_end, then editor_render_repeat_move right by (target-cur) steps. Three callee-save pushes (rbx=buffer_id, r12=caret_ptr, r13=cur) reach rsp%16==0 (entry rsp%16==8, +24=32). Labels prefixed ece_.",
      block: {
        push rbx
        push r12
        push r13

        cmp rsi, 0
        je ece_caret_null

        mov rbx, rdi
        mov r12, rsi

        mov rdi, r12
        call bidi_caret_get_paragraph_ptr
        cmp rax, 0
        je ece_caret_invalid

        mov rdi, r12
        call bidi_caret_get_logical_offset
        mov r13, rax

        mov rdi, rbx
        call editor_buffer_len_bytes

        mov rdi, rbx
        mov rsi, r13
        mov rdx, rax
        call editor_render_find_line_end

        mov r10, rax
        sub r10, r13

        mov rdi, r12
        mov rsi, r10
        mov rdx, 1
        call editor_render_repeat_move
        jmp ece_out

      ece_caret_null:
        mov rax, 0xFFFFE8DF
        jmp ece_out
      ece_caret_invalid:
        mov rax, 0xFFFFE8DD
        jmp ece_out

      ece_out:
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // editor_render_caret_up(buffer_id, caret_ptr) -> visual_x |
  // EREN_NULL | EREN_CARET_INVALID. Sticky-column move to the previous
  // line: column = cur - line_start; clamps to the previous line's own
  // length. A no-op clamp (current visual_x, unchanged) when already
  // on the first line. Five callee-save pushes reach rsp%16==0 (entry
  // rsp%16==8, +40=48).
  pub let editor_render_caret_up : (u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): Up -- sticky-column move to the previous line. line_start = find_line_start(cur); column = cur-line_start; prev_line_start = find_line_start(line_start-1); prev_line_len = (line_start-1)-prev_line_start; target = prev_line_start + min(column, prev_line_len); delta = cur-target (always >=0 since the previous line precedes the current one). Five callee-save pushes (rbx=buffer_id, r12=caret_ptr, r13=cur, r14=line_start, r15=column) reach rsp%16==0 (entry rsp%16==8, +40=48). Labels prefixed ecu_.",
      block: {
        push rbx
        push r12
        push r13
        push r14
        push r15

        cmp rsi, 0
        je ecu_caret_null

        mov rbx, rdi
        mov r12, rsi

        mov rdi, r12
        call bidi_caret_get_paragraph_ptr
        cmp rax, 0
        je ecu_caret_invalid

        mov rdi, r12
        call bidi_caret_get_logical_offset
        mov r13, rax

        mov rdi, rbx
        mov rsi, r13
        call editor_render_find_line_start
        mov r14, rax

        mov r15, r13
        sub r15, r14

        cmp r14, 0
        je ecu_clamped

        mov r10, r14
        sub r10, 1

        mov rdi, rbx
        mov rsi, r10
        call editor_render_find_line_start

        mov r10, r14
        sub r10, 1
        sub r10, rax

        cmp r15, r10
        jbe ecu_col_ready
        mov r15, r10
      ecu_col_ready:

        add rax, r15

        mov r10, r13
        sub r10, rax

        mov rdi, r12
        mov rsi, r10
        xor rdx, rdx
        call editor_render_repeat_move
        jmp ecu_out

      ecu_clamped:
        mov rdi, r12
        call bidi_caret_get_visual_x
        jmp ecu_out

      ecu_caret_null:
        mov rax, 0xFFFFE8DF
        jmp ecu_out
      ecu_caret_invalid:
        mov rax, 0xFFFFE8DD
        jmp ecu_out

      ecu_out:
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        ret
      }
    }

  // editor_render_caret_down(buffer_id, caret_ptr) -> visual_x |
  // EREN_NULL | EREN_CARET_INVALID. Mirror of caret_up, but needs a
  // sixth persistent value (total_len, for the two find_line_end
  // calls) so it spends rbp too. Six callee-save pushes + sub rsp,8
  // reach rsp%16==0 (entry rsp%16==8, +48=56, +8=64).
  pub let editor_render_caret_down : (u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): Down -- sticky-column move to the next line. line_start = find_line_start(cur); column = cur-line_start; total_len = editor_buffer_len_bytes; line_end = find_line_end(cur,total_len); if line_end>=total_len, no next line (clamp). Else next_line_start=line_end+1, next_line_end=find_line_end(next_line_start,total_len), next_line_len=next_line_end-next_line_start, target=next_line_start+min(column,next_line_len), delta=target-cur. Six callee-save pushes + sub rsp,8 (rbx=buffer_id, rbp=next_line_start, r12=caret_ptr, r13=cur, r14=total_len, r15=column) land rsp%16==0 (entry rsp%16==8, +48=56, +8=64). Labels prefixed ecd_.",
      block: {
        push rbx
        push rbp
        push r12
        push r13
        push r14
        push r15
        sub rsp, 8

        cmp rsi, 0
        je ecd_caret_null

        mov rbx, rdi
        mov r12, rsi

        mov rdi, r12
        call bidi_caret_get_paragraph_ptr
        cmp rax, 0
        je ecd_caret_invalid

        mov rdi, r12
        call bidi_caret_get_logical_offset
        mov r13, rax

        mov rdi, rbx
        mov rsi, r13
        call editor_render_find_line_start

        mov r15, r13
        sub r15, rax

        mov rdi, rbx
        call editor_buffer_len_bytes
        mov r14, rax

        mov rdi, rbx
        mov rsi, r13
        mov rdx, r14
        call editor_render_find_line_end

        cmp rax, r14
        jae ecd_clamped

        mov rbp, rax
        add rbp, 1

        mov rdi, rbx
        mov rsi, rbp
        mov rdx, r14
        call editor_render_find_line_end

        mov r10, rax
        sub r10, rbp

        cmp r15, r10
        jbe ecd_col_ready
        mov r15, r10
      ecd_col_ready:

        mov r10, rbp
        add r10, r15
        sub r10, r13

        mov rdi, r12
        mov rsi, r10
        mov rdx, 1
        call editor_render_repeat_move
        jmp ecd_out

      ecd_clamped:
        mov rdi, r12
        call bidi_caret_get_visual_x
        jmp ecd_out

      ecd_caret_null:
        mov rax, 0xFFFFE8DF
        jmp ecd_out
      ecd_caret_invalid:
        mov rax, 0xFFFFE8DD
        jmp ecd_out

      ecd_out:
        add rsp, 8
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbp
        pop rbx
        ret
      }
    }

  // ==========================================================================
  // Section 16  Init.
  // ==========================================================================

  // editor_render_init() -> (). Boot-time counter reset, mirroring
  // widgets_init's own lightweight posture (no module-wide "inited"
  // gate -- every public function here validates its own arguments
  // directly rather than a global flag; the underlying buffer.pdx
  // substrate carries that gate instead, and this file's EREN_NOT_INIT
  // surfaces it by translation, per the file header's error-boundary
  // design note).
  pub let editor_render_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G12-M4-002 (#2338): call through to editor_render_stats_reset for one clean counter zero-out. Mirrors widgets_init. Labels prefixed eri_.",
      block: {
        call editor_render_stats_reset
        ret
      }
    }
}
