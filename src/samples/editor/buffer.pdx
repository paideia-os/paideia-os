// src/samples/editor/buffer.pdx -- Wave0-B14 G12-M4-001 (paideia-os #2337)
//
// SAMPLE APP -- TEXT EDITOR: GAP-LIST BUFFER PRIMITIVES.
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// (Developer APIs + first-party toolkit), which lists "text editor" as
// the third G12 sample application alongside settings (color/input/
// display, landed Wave0-B13) and clock (landed Wave0-B13). THIS FILE
// IS BUFFER PRIMITIVES ONLY: mint/insert/delete/read/len over a
// gap-list edit structure. Syntax highlighting and BiDi caret
// navigation on top of this substrate land in #2338 -- neither is
// touched here.
//
// =============================================================================
// NOVEL-CLEAN DESIGN: THE GAP-LIST
// =============================================================================
//
// Two classic text-buffer data structures dominate real editors:
//
//   PIECE TABLE (VS Code, Word since 2010s): every edit appends an
//   immutable span reference; the visible text is an ordered list of
//   (source, offset, length) spans. O(1) amortized insert/delete, but
//   reading a byte range means walking a span list with NO fixed
//   record size -- poor cache locality, and span-list growth is
//   unbounded without periodic compaction.
//
//   GAP BUFFER (Emacs, many toy editors): one contiguous array with a
//   moveable "hole" (the gap) sitting at the cursor; inserting at the
//   gap is a plain bounded write, no shifting, until the gap empties.
//   Excellent cache locality (one array), but the WHOLE buffer is one
//   allocation -- growing it past its current capacity means
//   reallocating and copying the entire live content, and a single
//   pool-exhaustion failure loses the whole document's headroom at
//   once.
//
// THE GAP-LIST fuses both lineages' strong half: a LINKED LIST of
// FIXED-SIZE GAP-BUFFER NODES (4 KiB each). Each node is cache-line-
// friendly like a gap buffer (one array, one gap, bounded scan), but
// the buffer as a whole grows by SPLIT-AND-LINK -- allocating one more
// fixed-size node from a shared pool -- rather than by reallocating
// and copying an ever-growing monolith. This is the piece table's
// amortized-growth property without its unbounded-span-list cache
// hostility, and the gap buffer's cache locality without its
// whole-document reallocation hazard. Per project directive (novel +
// clean design bias): this is not an inherited POSIX/Emacs shape
// frozen in place, but a deliberate synthesis chosen for this kernel's
// fixed-pool, no-malloc discipline (every mutable array in this file
// is a static .bss allocation sized at compile time, matching every
// other kind_*.pdx / samples/*.pdx file in this tree).
//
// Insertion at cursor: writes into the current node's gap; when that
// gap empties before the request is satisfied, a fresh node is
// allocated from the shared pool and spliced in immediately after
// (ebuf_node_alloc + ebuf_link_after), and writing continues into its
// full-width gap. Deletion: the gap is grown to absorb the deleted
// bytes (gap_end += del_len); when a non-head node's gap widens to
// cover its ENTIRE 4064-byte data region, that node is unlinked
// (ebuf_unlink_node) and returned to the pool.
//
// THE HEAD NODE IS NEVER UNLINKED. A buffer's external handle (the u64
// editor_buffer_mint returns) IS its head node's pool index -- there is
// no separate control-block table indirecting to it. If the head's own
// content is deleted down to nothing, it simply carries a full-width
// gap and stays linked in as the chain's stable anchor; only interior/
// tail nodes are ever freed back to the pool. This is what lets the
// buffer identity given out at mint time remain valid for the entire
// life of the buffer, through any number of inserts and deletes.
//
// =============================================================================
// NODE SCHEMA -- 4096 BYTES (one node = one gap-buffer)
// =============================================================================
//
//   [+0]  prev_id     u32   node pool index of the previous node in the
//                            chain, or EBUF_NODE_NONE (0xFFFFFFFF) if
//                            this node is the head (prev_id == NONE is
//                            the definition of "is a head" this file
//                            uses throughout -- see ebuf_is_valid_head).
//   [+4]  next_id     u32   node pool index of the next node, or
//                            EBUF_NODE_NONE if this is the tail.
//   [+8]  gap_start   u16   offset into the 4064-byte data region where
//                            the gap begins (bytes [0, gap_start) are
//                            live content).
//   [+10] gap_end     u16   offset where the gap ends, exclusive
//                            (bytes [gap_end, 4064) are live content).
//                            gap_start <= gap_end always; the gap SIZE
//                            (gap_end - gap_start) is invariant under a
//                            seek (ebuf_seek_gap moves the gap's
//                            POSITION, never its size) -- this is what
//                            lets editor_buffer_insert_at's pre-flight
//                            capacity check read a node's available
//                            room without first moving anything.
//   [+12] in_use      u8    1 iff this pool slot is a live node; 0 iff
//                            free. Scanned by ebuf_node_alloc.
//   [+13..+15]        --    reserved (3 bytes, padding to the u64 at +16)
//   [+16] total_len   u64   AUTHORITATIVE ONLY WHEN prev_id == NONE
//                            (i.e. only on a head node): the buffer's
//                            total live byte count across every node in
//                            its chain. Every non-head node's copy of
//                            this field is unused/reserved -- the schema
//                            stays uniform across every node (per this
//                            issue's spec) even though only one node's
//                            copy is ever read or written.
//   [+24] reserved2   u64   headroom for a future field (e.g. a
//                            line-index cache for #2338's caret work)
//                            without a node-shape break.
//   [+32..+4095]      --    DATA REGION, 4064 bytes. Live content lives
//                            in [0, gap_start) and [gap_end, 4064); the
//                            gap itself is uninitialized/stale bytes.
//
// 32-byte header + 4064-byte data region = 4096 bytes exactly, per the
// issue's fixed node-size spec.
//
// =============================================================================
// KIND_EDITOR_BUFFER SLOT -- 0x1E5
// =============================================================================
//
// The issue's primary band (0x1B8..0x1DE) is FULLY CLAIMED end to end
// by the Wave0 G7 compositor batch: 0x1B8 KIND_SURFACE .. 0x1BA
// KIND_SUBSURFACE (Batch 6/7), 0x1BC..0x1C0 explicitly reserved by
// window_kind.pdx for KIND_LAYER_TREE (landed at 0x1C2), 0x1C1
// KIND_WINDOW, 0x1C2 KIND_LAYER_TREE, 0x1C4..0x1C9 the G7 popup/DnD/
// clipboard/selection/recovery-plane family, 0x1C0..0x1CF explicitly
// allocated en bloc by xdg_shell_states.pdx's "Wave-0 Batch-6
// dispatcher allocates 0x1C0..0x1CF" note, and 0x1D0..0x1DE the G8-G12
// input-server/workspace/a11y/IME family through KIND_IME_ROUTER.
// Grep at landing time (`grep -rn "KIND_[A-Z_]*.*: u64 = 0x1[B-D]"
// src --include=*.pdx`) confirms every slot in 0x1B8..0x1DE is either
// assigned or explicitly reserved in a sibling file's own header
// comment -- there is no free slot in the primary band.
//
// Per the issue's own fallback clause, this file opens the second band
// 0x1E0..0x1FF instead. A grep re-run at landing time (`grep -rhoE
// ": u64 = 0x1[E-F][0-9A-Fa-f]\b" --include=*.pdx src/`) found this
// band already busier than the file's first draft expected: 0x1E0
// (KIND_TTS_ENGINE, screen_reader_tts.pdx) and 0x1E1 (KIND_BRAILLE_
// DEVICE, screen_reader_braille.pdx) are the two known "forward-
// reserved" a11y satellite kinds from Wave0-B10/B11, but 0x1E2 turned
// out to be an ACTIVE, ACKNOWLEDGED COLLISION between two other
// concurrent Wave0-B14 landings -- src/user/a11y/kind_a11y_node.pdx
// (KIND_A11Y_NODE, #2303) and src/user/a11y/elaboration_gate.pdx
// (KIND_A11Y_ELABORATION_GATE, #2307) both landed with `: u64 = 0x1E2`,
// neither able to see the other's still-unwritten file when each ran
// its own "next free slot" grep. A third sibling, src/user/a11y/
// mutation_log.pdx (#2304), found that same collision, explicitly
// declined to touch it ("left for main to reconcile at batch close"),
// and claimed 0x1E4 instead (honoring elaboration_gate.pdx's own
// advisory forward-reservation note for that slot). This file follows
// mutation_log.pdx's precedent of the same discipline but goes one
// slot further still: 0x1E3 is narratively entangled in the same
// collision (elaboration_gate.pdx's ordinal-choice comment names it as
// kind_a11y_node.pdx's *predicted* landing slot, even though that file
// actually diverged to 0x1E2) and is a plausible candidate for
// whatever resolution main picks when reconciling 0x1E2 -- claiming it
// now would risk manufacturing a SECOND collision on top of the first.
// 0x1E5 carries no such narrative and is grep-confirmed free of any
// `: u64 =` claim anywhere under src/ as of this landing; it is what
// this file claims. Per this wave's own established protocol (see
// mutation_log.pdx §SLOT ALLOCATION), the 0x1E2 collision between
// kind_a11y_node.pdx and elaboration_gate.pdx is NOT touched here --
// out of this file's scope, left for main to reconcile at batch close.
//
// Derivation base: KIND_MEMORY (slot 4). A text buffer is a memory-
// shaped resource (bytes a process can read/write), the same
// derivation base KIND_SCHEMA_HANDLE / KIND_KEK / KIND_FRAMEBUFFER
// take -- see kind.pdx's own KIND_MEMORY binding note. No dispatcher
// or cap_table mint gate is wired at this landing (matching the "data-
// only decl" posture every G8-G12 Wave0 sample/kind file has taken
// since Batch 6): editor_buffer_mint below hands back a raw node-pool
// index, not a cap_table slot. A future landing that promotes this
// into a real KIND_EDITOR_BUFFER capability (cap_handler_editor_buffer,
// a cap_invoke_dispatch branch on 0x1E5) would wrap that index in the
// standard descriptor tail, exactly as kind_schema_handle.pdx wraps
// its own row id.
//
// =============================================================================
// FAILURE TAXONOMY -- 0xFFFFE8A0..0xFFFFE8BF (issue pre-assigned)
// =============================================================================
//
// Grep-verified free at landing time (`grep -rn "0xFFFFE8[9A-Cc]"
// src --include=*.pdx` returns nothing). Seven sentinels assigned from
// the TOP of the 32-slot band downward, per this tree's convention
// (kind_tui_canvas.pdx, bidi_uba.pdx, bidi_caret.pdx all number their
// taxonomy high-to-low); 0xFFFFE8A0..0xFFFFE8B8 (25 slots) stay
// reserved for future growth (e.g. a future syntax-highlight or caret
// error class from #2338 that wants to share this file's band).
//
//   EBUF_NULL                  0xFFFFE8BF  required pointer arg == 0
//                                          (src_ptr / dst_ptr)
//   EBUF_NOT_INIT               0xFFFFE8BE  called before ebuf_init ran
//   EBUF_RANGE_INVALID           0xFFFFE8BD  buffer_id does not name a
//                                          live head node
//   EBUF_OOB                     0xFFFFE8BC  offset (+len) falls outside
//                                          [0, total_len]
//   EBUF_NODE_POOL_EXHAUSTED     0xFFFFE8BB  ebuf_node_alloc found no
//                                          free pool slot
//   EBUF_GAP_OVERFLOW            0xFFFFE8BA  defensive: a gap seek
//                                          computed a position outside
//                                          the node's data region --
//                                          structurally unreachable
//                                          given the invariants every
//                                          caller upholds, checked
//                                          anyway per this file's
//                                          reserved taxonomy slot (the
//                                          same "impossible but
//                                          checked" posture kind_gpu_bo
//                                          .pdx's kgb_size_valid takes)
//   EBUF_REFUSED_DENSE            0xFFFFE8B9  insert_at's pre-flight
//                                          capacity check found the
//                                          shared node pool too densely
//                                          packed (too few free nodes)
//                                          to cover the request's
//                                          worst-case node count --
//                                          refused ATOMICALLY, before
//                                          any byte is written, so an
//                                          insert never leaves a buffer
//                                          half-mutated under pool
//                                          pressure. Distinct from
//                                          EBUF_NODE_POOL_EXHAUSTED,
//                                          which is the (should-be-
//                                          unreachable, given a sound
//                                          pre-flight) failure of the
//                                          actual mid-loop allocation.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as M0305 module name = Buffer (PascalCase of file basename
// buffer.pdx). Every label is prefixed with its owning function's
// short tag (ebna_, ebnf_, ebnl_, ebcf_, ebcpf_, ebcpr_, ebsg_, ebwo_,
// ebvh_, ebun_, ebla_, ebnb_, ebsb_, ebst_, ebm_, eblb_, ebrr_, ebia_,
// ebdr_, ebi_) so none can collide with the reserved keywords `loop`/
// `if`/`for`/`match` or with any label in a sibling module.
//
// No `test rN,rN` (cmp rN,0 throughout). No `and r11,imm64` (the one
// spot that would need it -- masking the low 32 bits of a packed
// node-id|local-offset return value -- instead uses `shl r14,32; shr
// r14,32`, the documented workaround). No 2-op `imul r,imm` (this file
// has no multiply at all; node-base address compute uses `shl ,12`
// since 4096 is a power of two). No `neg`/`cqo`/`idiv` -- the one
// division (insert_at's ceil((len-first_gap_room)/4064) node-count
// estimate) is UNSIGNED via `xor rdx,rdx; div rcx`, mirroring
// fs/pdxfs/mkfs.pdx's proven xor-then-div idiom. No `add reg,[mem]`
// anywhere (every accumulate loads to a register first). Every unsafe
// lambda takes at most 4 arguments. The fingerprint constant below is
// a single-line `pub let`. Sized loads always `xor reg,reg` immediately
// before `mov_b`/`mov_w`, matching fs/tmpfs/write.pdx and
// cap/pdxfs_dir_iter.pdx precedent. SysV alignment: every function's
// push-count (or push-count-plus-`sub rsp,8`) is chosen so rsp%16==0
// at every `call` site; because r12/r13/r14/r15/rbx are callee-saved,
// a value stashed in one of them at function entry survives EVERY
// nested call automatically with no per-call push/pop -- this file
// leans on that instead of the more fragile "push a caller-saved
// scratch register around one call" pattern wherever a free callee-
// saved slot is available (see editor_buffer_insert_at's register-
// plan note for the one case, node-alloc-then-link, that needed care
// ordering the reassignment around the two calls).
//
// =============================================================================
// NODE POOL SIZING
// =============================================================================
//
// EBUF_NODE_POOL_MAX = 32 nodes * 4096 bytes = 131072 bytes (128 KiB)
// static .bss pool, shared across every minted buffer (there is no
// per-buffer sub-allocation ceiling other than the shared pool itself
// running out, which editor_buffer_mint / editor_buffer_insert_at both
// surface honestly rather than silently truncating).

module Buffer = structure {

  // ==========================================================================
  // Section 1  Constants.
  // ==========================================================================

  pub let KIND_EDITOR_BUFFER      : u64 = 0x1E5
  pub let KIND_EDITOR_BUFFER_BASE : u64 = 4          // = KIND_MEMORY

  pub let EBUF_NODE_BYTES       : u64 = 4096
  pub let EBUF_NODE_HDR_BYTES   : u64 = 32
  pub let EBUF_NODE_DATA_BYTES  : u64 = 4064
  pub let EBUF_NODE_POOL_MAX    : u64 = 32
  pub let EBUF_NODE_NONE        : u64 = 0xFFFFFFFF   // u32 max = "no such node"

  // Failure taxonomy -- 0xFFFFE8A0..0xFFFFE8BF. See file header.
  pub let EBUF_OK                  : u64 = 0
  pub let EBUF_NULL                : u64 = 0xFFFFE8BF
  pub let EBUF_NOT_INIT            : u64 = 0xFFFFE8BE
  pub let EBUF_RANGE_INVALID       : u64 = 0xFFFFE8BD
  pub let EBUF_OOB                 : u64 = 0xFFFFE8BC
  pub let EBUF_NODE_POOL_EXHAUSTED : u64 = 0xFFFFE8BB
  pub let EBUF_GAP_OVERFLOW        : u64 = 0xFFFFE8BA
  pub let EBUF_REFUSED_DENSE       : u64 = 0xFFFFE8B9
  // 0xFFFFE8A0..0xFFFFE8B8 reserved for future growth.

  // Stats vector indices (observability parity with samples/settings/
  // color.pdx's own counter convention).
  pub let EBUF_ST_MINTS        : u64 = 0
  pub let EBUF_ST_INSERTS      : u64 = 1
  pub let EBUF_ST_DELETES      : u64 = 2
  pub let EBUF_ST_READS        : u64 = 3
  pub let EBUF_ST_NODE_SPLITS  : u64 = 4
  pub let EBUF_ST_NODE_UNLINKS : u64 = 5
  pub let EBUF_ST_REFUSED      : u64 = 6
  pub let EBUF_ST_MAX          : u64 = 8

  // ==========================================================================
  // Section 2  State.
  // ==========================================================================

  // 32 nodes * 4096 bytes = 131072 bytes (128 KiB). Every node's
  // header + data lives inline in this one flat array; ebuf_node_base
  // computes &pool[node_id*4096].
  pub let mut _ebuf_node_pool : [u8; 131072] = uninit @align(4096)

  pub let mut _ebuf_stats  : [u64; 8] = uninit @align(64)
  pub let mut _ebuf_inited : u64      = uninit @align(8)

  // ==========================================================================
  // Section 3  Stats bookkeeping.
  // ==========================================================================

  pub let ebuf_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): counter bump. Load-inc-store idiom, no `add reg,[mem]`. Labels prefixed ebsb_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae ebsb_out;
        lea r10, [rip + _ebuf_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ebsb_out:
        ret
      }
    }

  pub let ebuf_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): counter read. Labels prefixed ebst_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae ebst_zero;
        lea r10, [rip + _ebuf_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ebst_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Node pool primitives.
  // ==========================================================================

  // ebuf_node_base(node_id) -> &_ebuf_node_pool[node_id*4096]. No
  // bounds check by policy -- every caller in this file validates
  // node_id first (mirrors kind_tui_canvas.pdx tui_canvas_slot /
  // layer_tree.pdx's row-address helpers). Pure leaf.
  pub let ebuf_node_base : (u64) -> u64 !{} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): &_ebuf_node_pool[node_id*4096]. 4096 is a power of two so the multiply is shl 12. No bounds check by policy. Labels prefixed ebnb_ (none needed, straight-line).",
      block: {
        lea rax, [rip + _ebuf_node_pool];
        shl rdi, 12;
        add rax, rdi;
        ret
      }
    }

  // ebuf_node_alloc() -> node_id | EBUF_NODE_POOL_EXHAUSTED. Low-first
  // free scan (in_use byte at +12), mirroring layer_tree.pdx
  // lt_row_alloc / kind_tui_canvas.pdx tui_canvas_tail_alloc. THE ONLY
  // WRITER that claims a slot: initializes prev/next to NONE, gap to
  // the full 4064-byte data region, total_len/reserved2 to 0.
  pub let ebuf_node_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): claim one free node. Low-first scan over 32 slots of 4096 bytes (idx*4096 via shl 12). On claim, publishes prev=next=EBUF_NODE_NONE, gap_start=0, gap_end=4064 (full-width gap), in_use=1, total_len=0, reserved2=0 -- the fresh-node invariant every other function in this file relies on. Pure leaf (no nested calls). Labels prefixed ebna_.",
      block: {
        xor rcx, rcx;
      ebna_scan:
        mov r10, 32;
        cmp rcx, r10;
        jae ebna_exhausted;

        lea r10, [rip + _ebuf_node_pool];
        mov r11, rcx;
        shl r11, 12;
        add r10, r11;

        xor rax, rax;
        mov_b rax, [r10 + 12];
        cmp rax, 0;
        je  ebna_claim;

        add rcx, 1;
        jmp ebna_scan;

      ebna_claim:
        mov rax, 0xFFFFFFFF;
        mov_d [r10 + 0], rax;        // prev = NONE
        mov_d [r10 + 4], rax;        // next = NONE
        xor rax, rax;
        mov_w [r10 + 8], rax;        // gap_start = 0
        mov rax, 4064;
        mov_w [r10 + 10], rax;       // gap_end = 4064
        mov rax, 1;
        mov_b [r10 + 12], rax;       // in_use = 1
        xor rax, rax;
        mov [r10 + 16], rax;         // total_len = 0
        mov [r10 + 24], rax;         // reserved2 = 0
        mov rax, rcx;
        ret;

      ebna_exhausted:
        mov rax, 0xFFFFE8BB;         // EBUF_NODE_POOL_EXHAUSTED
        ret
      }
    }

  // ebuf_node_free(node_id) -> (). Scrub the whole 4096-byte node
  // (512 qword stores) so in_use reads back 0 along with every other
  // field. Bounds-checked (silently ignores an out-of-range id).
  pub let ebuf_node_free : (u64) -> () !{mem} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): zero an entire node (512 qwords = 4096 bytes), clearing in_use along with header and data. Pure leaf. Labels prefixed ebnf_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae ebnf_out;
        lea r10, [rip + _ebuf_node_pool];
        mov r11, rdi;
        shl r11, 12;
        add r10, r11;
        xor rax, rax;
        xor rcx, rcx;
      ebnf_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r9, 512;
        cmp rcx, r9;
        jb  ebnf_loop;
      ebnf_out:
        ret
      }
    }

  // ebuf_count_free_nodes() -> count of in_use==0 slots. Pure leaf,
  // used only by editor_buffer_insert_at's pre-flight capacity check.
  pub let ebuf_count_free_nodes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): scan-count free pool slots for the insert_at pre-flight gate. Pure leaf. Labels prefixed ebcf_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      ebcf_loop:
        mov r10, 32;
        cmp rcx, r10;
        jae ebcf_out;
        lea r10, [rip + _ebuf_node_pool];
        mov r11, rcx;
        shl r11, 12;
        add r10, r11;
        xor r9, r9;
        mov_b r9, [r10 + 12];
        cmp r9, 0;
        jne ebcf_skip;
        add rax, 1;
      ebcf_skip:
        add rcx, 1;
        jmp ebcf_loop;
      ebcf_out:
        ret
      }
    }

  // ebuf_node_live_len(node_id) -> gap_start + (4064 - gap_end): the
  // node's live (non-gap) byte count. sub rsp,8 pads for the one
  // nested call (entry rsp%16==8, +8 = 0); node_id is not needed after
  // the call, so no register-preservation is required around it.
  pub let ebuf_node_live_len : (u64) -> u64 !{mem} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): live_len = gap_start + (4064-gap_end). sub rsp,8 aligns the one nested ebuf_node_base call (entry rsp%16==8, +8=0); node_id is dead after the call so nothing needs preserving across it. Labels prefixed ebnl_.",
      block: {
        sub rsp, 8;
        call ebuf_node_base;
        add rsp, 8;

        mov r10, rax;
        xor rax, rax;
        mov_w rax, [r10 + 8];
        mov r11, rax;
        xor rax, rax;
        mov_w rax, [r10 + 10];
        mov r9, 4064;
        sub r9, rax;
        add r11, r9;
        mov rax, r11;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Byte-copy primitives.
  // ==========================================================================

  // ebuf_bcopy_fwd(dst_ptr, src_ptr, count) -> (). Forward (ascending
  // index) byte copy, matching vfs_open.pdx's vfs_open_creat_copy_loop
  // shape. Safe whenever dst <= src or the regions are disjoint (every
  // call site in this file satisfies one of those).
  pub let ebuf_bcopy_fwd : (u64, u64, u64) -> () !{mem} @{} =
    fn (dst_ptr: u64) (src_ptr: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): forward byte-by-byte copy. Mirrors src/kernel/core/fs/vfs_open.pdx vfs_open_creat_copy_loop (moving-cursor + counter shape, no rep-prefix). Pure leaf. Labels prefixed ebcpf_.",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        xor r8, r8;
      ebcpf_loop:
        cmp r8, rdx;
        jae ebcpf_out;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        mov_b [r10 + 0], rax;
        add r10, 1;
        add r11, 1;
        add r8, 1;
        jmp ebcpf_loop;
      ebcpf_out:
        ret
      }
    }

  // ebuf_bcopy_rev(dst_ptr, src_ptr, count) -> (). Backward
  // (descending index) byte copy -- the ONLY safe direction when
  // dst > src and the two regions overlap, since a forward copy would
  // clobber source bytes before they are read. src/user/string.pdx's
  // memcpy explicitly leaves the overlapping case undefined ("use
  // memmove; deferred") because rep_movsb has no reverse mode without
  // `std`, which no file in this tree uses (DF is always assumed
  // clear). This is that first in-tree memmove-shaped helper,
  // hand-rolled rather than via `std` for exactly that reason.
  pub let ebuf_bcopy_rev : (u64, u64, u64) -> () !{mem} @{} =
    fn (dst_ptr: u64) (src_ptr: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): backward byte-by-byte copy (descending index), safe when dst > src and the regions overlap. First in-tree memmove-shaped helper (see file's own note: no `std` usage anywhere in this tree, so a manual descending loop is used instead of a reverse rep_movsb). Pure leaf. No `test rN,rN` (cmp rN,0 throughout). Labels prefixed ebcpr_.",
      block: {
        cmp rdx, 0;
        je ebcpr_out;
        mov r9, rdx;
        sub r9, 1;
      ebcpr_loop:
        mov r10, rdi;
        add r10, r9;
        mov r11, rsi;
        add r11, r9;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        mov_b [r10 + 0], rax;
        cmp r9, 0;
        je ebcpr_out;
        sub r9, 1;
        jmp ebcpr_loop;
      ebcpr_out:
        ret
      }
    }

  // ==========================================================================
  // Section 6  Gap positioning + chain walk.
  // ==========================================================================

  // ebuf_seek_gap(node_id, local_offset) -> EBUF_OK | EBUF_GAP_OVERFLOW.
  // Moves node_id's gap so gap_start == local_offset, preserving live
  // content on both sides. Gap SIZE (gap_end-gap_start) never changes
  // -- only its position -- which is what lets the insert_at pre-flight
  // treat available capacity as independent of where the gap currently
  // sits. Four callee-save pushes + sub rsp,8 land rsp%16==0 for the
  // two candidate nested calls (entry rsp%16==8, +32 push +8 sub = 48).
  pub let ebuf_seek_gap : (u64, u64) -> u64 !{mem} @{} =
    fn (node_id: u64) (local_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): move node's gap to local_offset. local_offset > gap_start (shift right): bytes [gap_end,gap_end+count) move to [gap_start,gap_start+count) -- dst < src always, so ebuf_bcopy_fwd (forward) is safe. local_offset < gap_start (shift left): bytes [local_offset,gap_start) move to [gap_end-count,gap_end) -- dst > src, the overlapping case, so ebuf_bcopy_rev (backward) is required. Register plan: rbx=node_base, r12=local_offset (constant), r13=gap_start, r14=gap_end (both recomputed into the new position before the defensive bound check and publish). Four pushes + sub rsp,8 (entry rsp%16==8, +32+8=48, %16==0). Labels prefixed ebsg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rsi;

        call ebuf_node_base;
        mov rbx, rax;

        xor r13, r13;
        mov_w r13, [rbx + 8];
        xor r14, r14;
        mov_w r14, [rbx + 10];

        cmp r12, r13;
        je  ebsg_ok;
        jb  ebsg_left;

        // shift right: local_offset > gap_start
        mov rax, r12;
        sub rax, r13;
        lea rdi, [rbx + 32];
        add rdi, r13;
        lea rsi, [rbx + 32];
        add rsi, r14;
        mov rdx, rax;
        call ebuf_bcopy_fwd;

        mov rax, r12;
        sub rax, r13;
        add r14, rax;
        mov r13, r12;
        jmp ebsg_store;

      ebsg_left:
        // shift left: local_offset < gap_start
        mov rax, r13;
        sub rax, r12;
        lea rdi, [rbx + 32];
        mov r10, r14;
        sub r10, rax;
        add rdi, r10;
        lea rsi, [rbx + 32];
        add rsi, r12;
        mov rdx, rax;
        call ebuf_bcopy_rev;

        mov rax, r13;
        sub rax, r12;
        sub r14, rax;
        mov r13, r12;

      ebsg_store:
        mov r10, 4064;
        cmp r13, r14;
        ja  ebsg_overflow;
        cmp r14, r10;
        ja  ebsg_overflow;
        mov_w [rbx + 8], r13;
        mov_w [rbx + 10], r14;

      ebsg_ok:
        xor rax, rax;
        jmp ebsg_out;

      ebsg_overflow:
        mov rax, 0xFFFFE8BA;         // EBUF_GAP_OVERFLOW

      ebsg_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ebuf_walk_to_offset(head_id, target_offset) -> packed
  // (node_id<<32)|local_offset, or (EBUF_NODE_NONE<<32)|0 if the walk
  // falls off the chain (defensive; every caller validates
  // target_offset <= total_len first). Accumulates each node's live
  // length until target_offset falls within it. TIE-BREAK: when
  // target_offset lands EXACTLY on a node boundary (remaining==live)
  // and a next sibling exists, resolves to (next_id, 0) rather than
  // (this_id, live) -- this avoids seeking into a node whose gap is
  // already flush against its own tail when the following node may
  // have free room at its head, sidestepping a needless split.
  pub let ebuf_walk_to_offset : (u64, u64) -> u64 !{mem} @{} =
    fn (head_id: u64) (target_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): walk the chain accumulating live length until target_offset resolves to a (node,local_offset) pair; packs the result as (node_id<<32)|local_offset (kind_tui_canvas.pdx tui_pack_rowcols packing idiom). Bounded to EBUF_NODE_POOL_MAX(32) iterations -- a well-formed chain has no cycles, so the r13 guard is purely defensive. Register plan: rbx=cur_node, r12=remaining, r13=iteration guard, r14=live (this node's live length, transient per iteration). Three pushes + sub rsp,8 (entry rsp%16==8, +24+8=32, %16==0). Labels prefixed ebwo_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        xor r13, r13;

      ebwo_loop:
        mov r10, 32;
        cmp r13, r10;
        jae ebwo_fail;

        mov rdi, rbx;
        call ebuf_node_live_len;

        cmp r12, rax;
        ja  ebwo_advance;
        jb  ebwo_found;

        // remaining == live: boundary tie-break, peek next_id.
        mov rdi, rbx;
        call ebuf_node_base;
        xor r10, r10;
        mov_d r10, [rax + 4];
        mov r11, 0xFFFFFFFF;
        cmp r10, r11;
        je  ebwo_found;
        mov rbx, r10;
        xor r12, r12;
        add r13, 1;
        jmp ebwo_loop;

      ebwo_advance:
        sub r12, rax;
        mov rdi, rbx;
        call ebuf_node_base;
        xor r10, r10;
        mov_d r10, [rax + 4];
        mov r11, 0xFFFFFFFF;
        cmp r10, r11;
        je  ebwo_fail;
        mov rbx, r10;
        add r13, 1;
        jmp ebwo_loop;

      ebwo_found:
        mov rax, rbx;
        shl rax, 32;
        or  rax, r12;
        jmp ebwo_out;

      ebwo_fail:
        mov rax, 0xFFFFFFFF;
        shl rax, 32;

      ebwo_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ebuf_is_valid_head(buffer_id) -> 1 iff buffer_id < 32, in_use==1,
  // and prev_id == EBUF_NODE_NONE (the definition of "is a head" this
  // file uses). Pure leaf; no bounds-unsafe reads.
  pub let ebuf_is_valid_head : (u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): 1 iff buffer_id names a live head node. Every public API entry point gates on this before touching a chain. Pure leaf. Labels prefixed ebvh_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae ebvh_no;
        lea r10, [rip + _ebuf_node_pool];
        mov r11, rdi;
        shl r11, 12;
        add r10, r11;
        xor rax, rax;
        mov_b rax, [r10 + 12];
        cmp rax, 0;
        je  ebvh_no;
        xor rax, rax;
        mov_d rax, [r10 + 0];
        mov r9, 0xFFFFFFFF;
        cmp rax, r9;
        jne ebvh_no;
        mov rax, 1;
        ret;
      ebvh_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Chain splice helpers.
  // ==========================================================================

  // ebuf_unlink_node(node_id) -> (). Splice node_id out of its chain
  // and free it. CALLER CONTRACT: node_id must NOT be a head (prev !=
  // EBUF_NODE_NONE) -- unlinking a head would orphan the external
  // buffer handle, so this function does not re-check (every call site
  // in this file already gates on "not the head" before calling it).
  pub let ebuf_unlink_node : (u64) -> () !{mem} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): splice node_id out (prev.next=next; next.prev=prev if next exists) then ebuf_node_free it. CALLER CONTRACT: node_id is never a head (see file header). Three pushes (rbx=prev_id, r12=next_id, r13=node_id) reach rsp%16==0 (entry rsp%16==8, +24=32, %16==0). Bumps EBUF_ST_NODE_UNLINKS. Labels prefixed ebun_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r13, rdi;

        call ebuf_node_base;
        xor rbx, rbx;
        mov_d rbx, [rax + 0];
        xor r12, r12;
        mov_d r12, [rax + 4];

        mov rdi, rbx;
        call ebuf_node_base;
        mov_d [rax + 4], r12;

        mov r10, 0xFFFFFFFF;
        cmp r12, r10;
        je  ebun_free;

        mov rdi, r12;
        call ebuf_node_base;
        mov_d [rax + 0], rbx;

      ebun_free:
        mov rdi, r13;
        call ebuf_node_free;

        mov rdi, 5;                  // EBUF_ST_NODE_UNLINKS
        call ebuf_stats_bump;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ebuf_link_after(cur_node, new_node) -> (). Splice new_node into the
  // chain immediately after cur_node.
  pub let ebuf_link_after : (u64, u64) -> () !{mem} @{} =
    fn (cur_node: u64) (new_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): new_node.prev=cur_node; new_node.next=cur_node.next (old); cur_node.next=new_node; and old_next.prev=new_node if old_next exists. Three pushes (rbx=cur_node, r12=new_node, r13=old_next) reach rsp%16==0 (entry rsp%16==8, +24=32, %16==0). Labels prefixed ebla_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call ebuf_node_base;
        xor r13, r13;
        mov_d r13, [rax + 4];
        mov_d [rax + 4], r12;

        mov rdi, r12;
        call ebuf_node_base;
        mov_d [rax + 0], rbx;
        mov_d [rax + 4], r13;

        mov r10, 0xFFFFFFFF;
        cmp r13, r10;
        je  ebla_out;

        mov rdi, r13;
        call ebuf_node_base;
        mov_d [rax + 0], r12;

      ebla_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Public API.
  // ==========================================================================

  // editor_buffer_mint() -> buffer_id | EBUF_NODE_POOL_EXHAUSTED |
  // EBUF_NOT_INIT. Allocates a single node from the shared pool and
  // hands back its pool index as the buffer's external handle -- there
  // is no separate control-block table; the head node IS the buffer.
  pub let editor_buffer_mint : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): gate on _ebuf_inited, then ebuf_node_alloc (a fresh node's prev/next are already EBUF_NODE_NONE/EBUF_NONE, satisfying ebuf_is_valid_head's head test immediately). One callee-save push (rbx=node_id/sentinel, survives the stats_bump call) reaches rsp%16==0 at function entry (rsp%16==8, +8=0); the ebuf_node_alloc call needs its own sub rsp,8 bracket since nothing has been pushed yet at that point. Labels prefixed ebm_.",
      block: {
        lea r10, [rip + _ebuf_inited];
        xor rax, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je ebm_not_init;

        sub rsp, 8;
        call ebuf_node_alloc;
        add rsp, 8;

        push rbx;
        mov rbx, rax;

        mov r10, 32;
        cmp rbx, r10;
        jae ebm_exhausted;

        mov rdi, 0;                   // EBUF_ST_MINTS
        call ebuf_stats_bump;
        mov rax, rbx;
        pop rbx;
        ret;

      ebm_exhausted:
        mov rdi, 6;                   // EBUF_ST_REFUSED
        call ebuf_stats_bump;
        mov rax, rbx;
        pop rbx;
        ret;

      ebm_not_init:
        mov rax, 0xFFFFE8BE;          // EBUF_NOT_INIT
        ret
      }
    }

  // editor_buffer_len_bytes(buffer_id) -> total_len | EBUF_RANGE_INVALID
  // | EBUF_NOT_INIT.
  pub let editor_buffer_len_bytes : (u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): read the head node's authoritative total_len field. One push (rbx=buffer_id) reaches rsp%16==0 at entry (rsp%16==8, +8=0); both nested calls fire at that same baseline (no stack change between them). Labels prefixed eblb_.",
      block: {
        lea r10, [rip + _ebuf_inited];
        xor rax, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je eblb_not_init;

        push rbx;
        mov rbx, rdi;
        call ebuf_is_valid_head;
        cmp rax, 0;
        je eblb_bad;

        mov rdi, rbx;
        call ebuf_node_base;
        mov rax, [rax + 16];
        pop rbx;
        ret;

      eblb_bad:
        pop rbx;
        mov rax, 0xFFFFE8BD;          // EBUF_RANGE_INVALID
        ret;

      eblb_not_init:
        mov rax, 0xFFFFE8BE;          // EBUF_NOT_INIT
        ret
      }
    }

  // editor_buffer_read_range(buffer_id, offset, len, dst_ptr) ->
  // bytes_copied | EBUF_NULL | EBUF_NOT_INIT | EBUF_RANGE_INVALID |
  // EBUF_OOB. Read-only: no gap moves, no node is allocated or freed.
  pub let editor_buffer_read_range : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (offset: u64) (len: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): copy len live bytes from offset into dst_ptr. Each node's live content is up to two runs either side of its gap -- a live-index li < gap_start maps to raw offset li; li >= gap_start maps to gap_end+(li-gap_start) -- and the loop below copies one run per iteration via ebuf_bcopy_fwd (always non-overlapping: dst_ptr is the caller's own buffer, never inside the node pool), crossing into the next node's li=0 when the current node's content is exhausted. Register plan (rbx phase-reused across the pre-walk/in-loop boundary, matching kind_tui_canvas_mint_body's hdr/row_id precedent): rbx=len before the walk, doubles as the seed for `remaining` and (minus final remaining) the success return value; r14=buffer_id before the walk, repurposed as li during the loop; r12=offset before the walk, repurposed as remaining during the loop; r13=cur_node during the loop; r15=dst_cursor throughout. All bookkeeping around ebuf_bcopy_fwd happens BEFORE that call so nothing needing to survive it sits in a caller-saved register. Five pushes land rsp%16==0 (entry rsp%16==8, +40=48). Labels prefixed ebrr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r10, [rip + _ebuf_inited];
        xor rax, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je ebrr_not_init;

        cmp rcx, 0;
        je ebrr_null;

        mov rbx, rdx;
        mov r15, rcx;
        mov r14, rdi;
        mov r12, rsi;

        cmp rbx, 0;
        je ebrr_ok0;

        mov rdi, r14;
        call ebuf_is_valid_head;
        cmp rax, 0;
        je ebrr_bad_handle;

        mov rdi, r14;
        call ebuf_node_base;
        mov r10, [rax + 16];

        mov rax, r12;
        add rax, rbx;
        cmp rax, r10;
        ja  ebrr_oob;

        mov rdi, r14;
        mov rsi, r12;
        call ebuf_walk_to_offset;

        mov r13, rax;
        shr r13, 32;
        mov r9, rax;
        shl r9, 32;
        shr r9, 32;

        mov r10, 0xFFFFFFFF;
        cmp r13, r10;
        je  ebrr_oob;

        mov r12, rbx;
        mov r14, r9;

      ebrr_loop:
        cmp r12, 0;
        je ebrr_done;

        mov rdi, r13;
        call ebuf_node_base;
        mov r9, rax;

        xor r10, r10;
        mov_w r10, [r9 + 8];
        xor r11, r11;
        mov_w r11, [r9 + 10];

        cmp r14, r10;
        jae ebrr_post_gap;

        mov rax, r10;
        sub rax, r14;
        lea rdx, [r9 + 32];
        add rdx, r14;
        jmp ebrr_have_seg;

      ebrr_post_gap:
        mov r8, r14;
        sub r8, r10;
        add r8, r11;
        mov rax, 4064;
        sub rax, r8;
        lea rdx, [r9 + 32];
        add rdx, r8;

      ebrr_have_seg:
        // chunk = min(seg_avail=rax, remaining=r12).
