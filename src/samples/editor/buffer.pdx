        jbe ebrr_seg_ready;
        mov rax, r12;
      ebrr_seg_ready:
        cmp rax, 0;
        je  ebrr_advance;

        mov rdi, r15;
        mov rsi, rdx;
        add r15, rax;
        add r14, rax;
        sub r12, rax;
        mov rdx, rax;
        call ebuf_bcopy_fwd;
        jmp ebrr_loop;

      ebrr_advance:
        xor r10, r10;
        mov_d r10, [r9 + 4];
        mov r11, 0xFFFFFFFF;
        cmp r10, r11;
        je  ebrr_done;
        mov r13, r10;
        xor r14, r14;
        jmp ebrr_loop;

      ebrr_done:
        mov rdi, 3;                   // EBUF_ST_READS
        call ebuf_stats_bump;
        mov rax, rbx;
        sub rax, r12;
        jmp ebrr_out;

      ebrr_oob:
        mov rax, 0xFFFFE8BC;          // EBUF_OOB
        jmp ebrr_out;

      ebrr_bad_handle:
        mov rax, 0xFFFFE8BD;          // EBUF_RANGE_INVALID
        jmp ebrr_out;

      ebrr_ok0:
        xor rax, rax;
        jmp ebrr_out;

      ebrr_null:
        mov rax, 0xFFFFE8BF;          // EBUF_NULL
        jmp ebrr_out;

      ebrr_not_init:
        mov rax, 0xFFFFE8BE;          // EBUF_NOT_INIT

      ebrr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // editor_buffer_insert_at(buffer_id, offset, src_ptr, len) -> EBUF_OK
  // | EBUF_NULL | EBUF_NOT_INIT | EBUF_RANGE_INVALID | EBUF_OOB |
  // EBUF_GAP_OVERFLOW | EBUF_REFUSED_DENSE | EBUF_NODE_POOL_EXHAUSTED.
  pub let editor_buffer_insert_at : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (offset: u64) (src_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): insert len bytes from src_ptr at the given live offset. Seeks the target node's gap to the insertion point (a position-only move -- gap SIZE is invariant under a seek, which is what makes the pre-flight sound), then writes into successive gaps, allocating + splicing a fresh node (ebuf_node_alloc + ebuf_link_after) whenever a gap fills before the request is satisfied -- the issue's 'split-and-link' mechanic. PRE-FLIGHT ATOMICITY: before any byte is written, the worst-case count of BRAND-NEW nodes this insert could need (ceil((len - first_gap_room)/4064), floored at 0 when the whole insert fits in the existing gap) is compared against ebuf_count_free_nodes; if the pool cannot cover it, the call refuses with EBUF_REFUSED_DENSE untouched -- insert_at is all-or-nothing under pool pressure. Register plan: rbx=head_id (constant); r15=original len (constant, added to head.total_len at the tail); r12=offset before the walk / remaining during the loop; r13=cur_node during the loop; r14=src_ptr before the loop / moving src_cursor during it. The one place two calls happen back-to-back with a value needing to survive both (ebuf_node_alloc's new_node id, then ebuf_link_after) snapshots the OLD cur_node into rdi and reassigns r13=new_node BEFORE issuing ebuf_link_after, since r13's old value is no longer needed once captured in rdi -- avoiding any push/pop, all five callee-saved slots being already committed elsewhere. Five pushes land rsp%16==0 (entry rsp%16==8, +40=48). Labels prefixed ebia_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r10, [rip + _ebuf_inited];
        xor rax, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je ebia_not_init;

        cmp rdx, 0;
        je ebia_null;

        mov rbx, rdi;
        mov r15, rcx;
        mov r12, rsi;
        mov r14, rdx;

        cmp r15, 0;
        je ebia_ok;

        mov rdi, rbx;
        call ebuf_is_valid_head;
        cmp rax, 0;
        je ebia_bad_handle;

        mov rdi, rbx;
        call ebuf_node_base;
        mov r10, [rax + 16];
        cmp r12, r10;
        ja  ebia_oob;

        mov rdi, rbx;
        mov rsi, r12;
        call ebuf_walk_to_offset;

        mov r13, rax;
        shr r13, 32;
        mov r9, rax;
        shl r9, 32;
        shr r9, 32;

        mov r10, 0xFFFFFFFF;
        cmp r13, r10;
        je  ebia_oob;

        // Seek the gap to the insertion point FIRST, before the
        // pre-flight capacity check below -- r9 (local_offset) is
        // caller-saved and would not survive the pre-flight's own
        // nested ebuf_count_free_nodes call, so it is consumed here
        // while still fresh. This ordering does not weaken the
        // pre-flight's atomicity guarantee: a seek only repositions
        // the gap (content-preserving, total_len unchanged, no live
        // byte moves in or out of existence -- see ebuf_seek_gap's own
        // header note that gap SIZE is seek-invariant), so refusing
        // AFTER a seek is observationally identical, to every public
        // API caller, to refusing before one.
        mov rdi, r13;
        mov rsi, r9;
        call ebuf_seek_gap;
        cmp rax, 0;
        jne ebia_out;

        // ---- Pre-flight: how many brand-new nodes could this need? ----
        mov rdi, r13;
        call ebuf_node_base;
        xor r10, r10;
        mov_w r10, [rax + 8];
        xor r11, r11;
        mov_w r11, [rax + 10];
        mov rax, r11;
        sub rax, r10;                 // gap_size of the found node (seek-invariant)

        cmp r15, rax;
        jbe ebia_preflight_ok;

        mov r10, r15;
        sub r10, rax;                 // remainder past the existing gap

        xor rdx, rdx;
        mov rax, r10;
        mov rcx, 4064;
        div rcx;
        cmp rdx, 0;
        je  ebia_nodes_needed;
        add rax, 1;
      ebia_nodes_needed:
        // r12 (the "offset" role is done -- its next use is the
        // post-preflight `mov r12, r15` remaining-seed) stashes
        // nodes_needed across ebuf_count_free_nodes, which clobbers
        // every caller-saved register including r10/r11.
        mov r12, rax;

        call ebuf_count_free_nodes;
        cmp rax, r12;
        jae ebia_preflight_ok;

        mov rdi, 6;                   // EBUF_ST_REFUSED
        call ebuf_stats_bump;
        mov rax, 0xFFFFE8B9;          // EBUF_REFUSED_DENSE
        jmp ebia_out;

      ebia_preflight_ok:
        mov r12, r15;

      ebia_loop:
        cmp r12, 0;
        je ebia_finish;

        mov rdi, r13;
        call ebuf_node_base;
        mov r9, rax;

        xor r10, r10;
        mov_w r10, [r9 + 8];
        xor r11, r11;
        mov_w r11, [r9 + 10];
        mov rax, r11;
        sub rax, r10;                 // gap_size

        // chunk = min(gap_size=rax, remaining=r12).
        cmp rax, r12;
        jbe ebia_chunk_ready;
        mov rax, r12;
      ebia_chunk_ready:
        cmp rax, 0;
        je ebia_need_node;

        lea rdi, [r9 + 32];
        add rdi, r10;

        add r10, rax;
        mov_w [r9 + 8], r10;

        mov rsi, r14;
        add r14, rax;
        sub r12, rax;

        mov rdx, rax;
        call ebuf_bcopy_fwd;

        cmp r12, 0;
        je ebia_finish;
        jmp ebia_loop;

      ebia_need_node:
        call ebuf_node_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae ebia_pool_exhausted;

        mov rsi, rax;
        mov rdi, r13;
        mov r13, rsi;
        call ebuf_link_after;

        mov rdi, 4;                   // EBUF_ST_NODE_SPLITS
        call ebuf_stats_bump;

        jmp ebia_loop;

      ebia_finish:
        mov rdi, rbx;
        call ebuf_node_base;
        mov r10, [rax + 16];
        add r10, r15;
        mov [rax + 16], r10;

        mov rdi, 1;                   // EBUF_ST_INSERTS
        call ebuf_stats_bump;

        xor rax, rax;
        jmp ebia_out;

      ebia_pool_exhausted:
        mov rdi, 6;                   // EBUF_ST_REFUSED
        call ebuf_stats_bump;
        mov rax, 0xFFFFE8BB;          // EBUF_NODE_POOL_EXHAUSTED
        jmp ebia_out;

      ebia_oob:
        mov rax, 0xFFFFE8BC;          // EBUF_OOB
        jmp ebia_out;

      ebia_bad_handle:
        mov rax, 0xFFFFE8BD;          // EBUF_RANGE_INVALID
        jmp ebia_out;

      ebia_ok:
        xor rax, rax;
        jmp ebia_out;

      ebia_null:
        mov rax, 0xFFFFE8BF;          // EBUF_NULL
        jmp ebia_out;

      ebia_not_init:
        mov rax, 0xFFFFE8BE;          // EBUF_NOT_INIT

      ebia_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // editor_buffer_delete_range(buffer_id, offset, del_len) -> EBUF_OK |
  // EBUF_NOT_INIT | EBUF_RANGE_INVALID | EBUF_OOB | EBUF_GAP_OVERFLOW.
  pub let editor_buffer_delete_range : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_id: u64) (offset: u64) (del_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): delete del_len live bytes from offset. Grows the current node's gap_end to absorb deleted bytes; on crossing into a following node, unlinks the JUST-EXHAUSTED node once its gap widens to the full 4064-byte data region -- EXCEPT the head, whose pool slot is the buffer's external identity and so is never unlinked even when fully emptied (an emptied head simply carries a full-width gap and stays the chain's anchor). A final empty-check runs once more after the loop for the last node touched, since the loop's own check only fires on the 'more to delete, must advance' path. Register plan: rbx=head_id (constant), r15=original del_len (constant, applied to head.total_len once at the tail), r12=offset before the walk / remaining during the loop, r13=cur_node during the loop, r14=scratch (total_len during the OOB check; local_offset for the initial seek). Five pushes land rsp%16==0 (entry rsp%16==8, +40=48). Labels prefixed ebdr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r10, [rip + _ebuf_inited];
        xor rax, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je ebdr_not_init;

        mov rbx, rdi;
        mov r15, rdx;
        mov r12, rsi;

        cmp r15, 0;
        je ebdr_ok;

        mov rdi, rbx;
        call ebuf_is_valid_head;
        cmp rax, 0;
        je ebdr_bad_handle;

        mov rdi, rbx;
        call ebuf_node_base;
        mov r14, [rax + 16];

        mov rax, r12;
        add rax, r15;
        cmp rax, r14;
        ja  ebdr_oob;

        mov rdi, rbx;
        mov rsi, r12;
        call ebuf_walk_to_offset;

        mov r13, rax;
        shr r13, 32;
        mov r14, rax;
        shl r14, 32;
        shr r14, 32;

        mov r10, 0xFFFFFFFF;
        cmp r13, r10;
        je  ebdr_oob;

        mov rdi, r13;
        mov rsi, r14;
        call ebuf_seek_gap;
        cmp rax, 0;
        jne ebdr_out;

        mov r12, r15;

      ebdr_loop:
        cmp r12, 0;
        je ebdr_finish;

        mov rdi, r13;
        call ebuf_node_base;
        mov r9, rax;

        xor r10, r10;
        mov_w r10, [r9 + 10];
        mov rax, 4064;
        sub rax, r10;

        mov r11, r12;
        cmp r11, rax;
        jbe ebdr_chunk_ready;
        mov r11, rax;
      ebdr_chunk_ready:
        mov rax, r10;
        add rax, r11;
        mov_w [r9 + 10], rax;
        sub r12, r11;

        cmp r12, 0;
        je ebdr_finish;

        xor r10, r10;
        mov_d r10, [r9 + 4];

        cmp r13, rbx;
        je  ebdr_advance;

        xor rax, rax;
        mov_w rax, [r9 + 8];
        cmp rax, 0;
        jne ebdr_advance;
        xor rax, rax;
        mov_w rax, [r9 + 10];
        mov rdx, 4064;
        cmp rax, rdx;
        jne ebdr_advance;

        mov rdi, r13;
        mov r13, r10;
        call ebuf_unlink_node;
        jmp ebdr_seek_new;

      ebdr_advance:
        mov r13, r10;

      ebdr_seek_new:
        mov r10, 0xFFFFFFFF;
        cmp r13, r10;
        je  ebdr_finish;

        mov rdi, r13;
        mov rsi, 0;
        call ebuf_seek_gap;
        cmp rax, 0;
        jne ebdr_out;
        jmp ebdr_loop;

      ebdr_finish:
        cmp r13, rbx;
        je ebdr_update_len;

        mov rdi, r13;
        call ebuf_node_base;
        mov r9, rax;

        xor rax, rax;
        mov_w rax, [r9 + 8];
        cmp rax, 0;
        jne ebdr_update_len;
        xor rax, rax;
        mov_w rax, [r9 + 10];
        mov rdx, 4064;
        cmp rax, rdx;
        jne ebdr_update_len;

        mov rdi, r13;
        call ebuf_unlink_node;

      ebdr_update_len:
        mov rdi, rbx;
        call ebuf_node_base;
        mov r10, [rax + 16];
        sub r10, r15;
        mov [rax + 16], r10;

        mov rdi, 2;                   // EBUF_ST_DELETES
        call ebuf_stats_bump;

        xor rax, rax;
        jmp ebdr_out;

      ebdr_oob:
        mov rax, 0xFFFFE8BC;          // EBUF_OOB
        jmp ebdr_out;

      ebdr_bad_handle:
        mov rax, 0xFFFFE8BD;          // EBUF_RANGE_INVALID
        jmp ebdr_out;

      ebdr_ok:
        xor rax, rax;
        jmp ebdr_out;

      ebdr_not_init:
        mov rax, 0xFFFFE8BE;          // EBUF_NOT_INIT

      ebdr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Boot init.
  // ==========================================================================

  // ebuf_init() -> (). Defensive re-scrub (.bss is already zero at
  // real boot): frees every pool slot via ebuf_node_free (reusing the
  // single writer of the zero-node shape rather than duplicating its
  // loop), zeroes the stats vector, and sets _ebuf_inited=1. One push
  // (rbx=loop index) reaches rsp%16==0 across the nested ebuf_node_free
  // call (entry rsp%16==8, +8=0).
  pub let ebuf_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G12-M4-001 (#2337): boot-time defensive re-scrub, mirrors kind_tui_canvas.pdx kind_tui_canvas_init / layer_tree.pdx precedent. Calls ebuf_node_free once per pool slot rather than duplicating its zero-loop, then clears _ebuf_stats and sets _ebuf_inited. Labels prefixed ebi_.",
      block: {
        push rbx;
        xor rbx, rbx;
      ebi_loop:
        mov r10, 32;
        cmp rbx, r10;
        jae ebi_stats;
        mov rdi, rbx;
        call ebuf_node_free;
        add rbx, 1;
        jmp ebi_loop;

      ebi_stats:
        lea r10, [rip + _ebuf_stats];
        xor rax, rax;
        xor rcx, rcx;
      ebi_sloop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r9, 8;
        cmp rcx, r9;
        jb ebi_sloop;

        lea r10, [rip + _ebuf_inited];
        mov rax, 1;
        mov [r10 + 0], rax;

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant, matching the "Wave0-B14" sample posture every
  // G8-G12 kind/sample file has taken since Batch 6: emission wiring
  // (a klog call from ebuf_init, or a future dispatcher) is deferred to
  // a follow-up landing. Needs an allowlist entry in tools/verify-
  // fingerprint-coverage.sh; added alongside this file per this
  // landing's own scope.
  //
  // Length: "editor buffer init ok [legacy: EDITOR BUFFER INIT OK]\0"
  //   = 53 characters + NUL = 54 bytes (strlen+1 rule).
  pub let pdx_kind_editor_buffer_meta : [u8; 54] = "editor buffer init ok [legacy: EDITOR BUFFER INIT OK]\0"
}
