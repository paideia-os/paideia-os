// src/samples/settings/display.pdx -- Wave0-B11-10 (paideia-os #2332)
//
// G12.M3-001: SAMPLE APP -- SETTINGS -> DISPLAY + A11Y PANEL.
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// (Developer APIs + first-party toolkit) and next-wave-synthesis.md
// line 99. This is the FIRST first-party sample application landed on
// top of the paideia-ui immediate-mode toolkit (widgets.pdx, Wave0-
// B10-09, KIND_UI_CONTEXT=0x1D5).
//
// The sample stands in for a real system-preferences applet: it owns a
// DisplaySettings struct held in .bss, seeds it with defaults on load,
// paints an interactive panel via egui-shape widget calls every frame,
// and writes the (post-edit) struct back to /system/prefs/display.
// pdxpref on save. Both persistence sides are STUBS in this landing:
// the file-backed store is a G12.M4 concern (settings service). What
// this file establishes is the WIDGET-COMPOSITION SHAPE that every
// subsequent settings panel (input, network, sound, ...) will follow.
//
// NOVEL-CLEAN POSTURE. The panel is stateless: it is a pure function
// of the current DisplaySettings buffer plus the ui_context row's
// per-frame hover/click routing. There is no view model, no observer,
// no callback chain -- the client's frame loop is:
//
//     ui_context_begin_frame(ctx);
//     let r = display_settings_render(&settings, ctx);
//     ui_context_end_frame(ctx);
//     if r == WR_CHANGED { display_settings_save(&settings); }
//
// Widget-return aggregation is a straight OR across the individual
// widget results: if ANY widget returned WR_CHANGED this frame, the
// panel's aggregate return is WR_CHANGED. Otherwise it is WR_HOVERED
// if any widget was hovered, else WR_NONE.
//
// -----------------------------------------------------------------------------
// DisplaySettings LAYOUT -- 16 BYTES
// -----------------------------------------------------------------------------
//
//   [+0..+3]  active_output_kind_id  : u32
//   [+4]      resolution_index       : u8    (index into KIND_MODESET_TXN)
//   [+5]      refresh_rate_hz        : u8    (60/120/144/165/240/max)
//   [+6]      hdr_enabled            : u8    (0 or 1)
//   [+7]      tonemap_mode           : u8    (0..8 KIND_TONEMAP_LUT ref)
//   [+8..+9]  night_light_temp       : u16   (Kelvin, 2700..6500)
//   [+10]     a11y_high_contrast     : u8    (0 or 1)
//   [+11]     _pad0                  : u8
//   [+12..+13] a11y_font_scale_num   : u16   (percent, 50..300)
//   [+14..+15] _pad1                 : u16
//
// The layout is naturally aligned per field and packs into a single
// 16-byte block (one x86_64 SSE line). The two padding slots leave
// headroom for one additional u8 flag + one u16 numeric future field
// without changing struct size. All numeric fields use unsigned host
// byte order; there is no explicit endianness marker because paideia-
// os is a single-endianness (little-endian x86_64) target and no
// settings blob ever crosses an ISA boundary.
//
// -----------------------------------------------------------------------------
// WIDGET COMPOSITION
// -----------------------------------------------------------------------------
//
// The panel emits seven widgets in a vertical stack at x=10, w=200,
// h=24, starting y=20 and stepping y+=28 per row. Rects are stack-
// allocated in display_settings_render's frame (16 bytes) and reused
// across widgets (each widget call reads x/y/w/h synchronously before
// the next update).
//
//   Row 0  y= 20  resolution      -> widget_slider(index 0..255)
//                                     (placeholder for a future
//                                      dropdown widget landing in
//                                      G12.M2-004; this landing uses
//                                      a slider stand-in so the
//                                      panel is functional end-to-
//                                      end today)
//   Row 1  y= 48  refresh_rate    -> widget_slider (raw Hz, 60..240)
//   Row 2  y= 76  HDR on/off      -> widget_checkbox
//   Row 3  y=104  tonemap_mode    -> widget_slider (0..8)
//   Row 4  y=132  night-light     -> widget_slider (2700..6500)
//   Row 5  y=160  high-contrast   -> widget_checkbox
//   Row 6  y=188  font-scale      -> widget_slider (50..300)
//
// Since widget_slider works on a u32-shaped value_ptr and widget_
// checkbox on a u64-shaped state_ptr, and the DisplaySettings fields
// are u8/u16, we MARSHAL each field to a stack scratch slot before
// the widget call and marshal back after. The marshal helpers
// (display_slider_u8 / display_slider_u16 / display_checkbox_u8) live
// in §Section 3 and mask the low N bits back into the struct byte on
// return; they do NOT touch bits above the field width, so the
// packing above stays intact even if a future field lands in the
// padding.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY  0xFFFFE900..0xFFFFE90F
// -----------------------------------------------------------------------------
//
// NOTE ON BAND ASSIGNMENT: the task brief assigned 0xFFFFEDF0..
// 0xFFFFEDFF, but that page is already claimed by both
// src/kernel/core/ipc/vk_surface_channel.pdx (VSC_* sentinels) and
// src/kernel/core/ipc/color_management_channel.pdx (CMC_* sentinels).
// A repo-wide grep at landing time confirmed 0xFFFFE900..0xFFFFE90F
// is entirely unclaimed across src/ and design/. Using a fresh page
// keeps sentinel disambiguation cheap (a caller reading a u64 error
// value can grep it to exactly one module). The band substitution is
// called out in the batch summary so the main coordinator can update
// any tracking that assumed the original allocation.
//
// The DisplaySettings entry points either succeed (returning a
// WidgetResult, WR_NONE..WR_CHANGED, or 0 for save) or refuse
// silently by bumping _display_stats[DISPLAY_ST_REFUSED] and
// collapsing the return to WR_NONE / 0. The DISPLAY_* sentinels
// below are reserved for the future service-boundary promotion
// (G12.M4) where a settings-service dispatcher can surface a
// distinct error to a cross-process caller through op_status.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Display (PascalCase of file basename
// display.pdx). Labels prefixed `display_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no `add reg,[mem]`, no float, no
// FPU. 32-bit loads use `mov_d` (zero-extending); 16-bit loads use
// `mov_w`; 8-bit loads use `mov_b`. Callee-save discipline: rbx/
// r12..r15 each pushed exactly once per function that uses them,
// keeping rsp%16 aligned before every nested call.

module Display = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, ranges, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let DISPLAY_STRUCT_BYTES        : u64 = 16
  pub let DISPLAY_OFF_OUTPUT_KIND     : u64 = 0
  pub let DISPLAY_OFF_RES_INDEX       : u64 = 4
  pub let DISPLAY_OFF_REFRESH_HZ      : u64 = 5
  pub let DISPLAY_OFF_HDR             : u64 = 6
  pub let DISPLAY_OFF_TONEMAP         : u64 = 7
  pub let DISPLAY_OFF_NIGHT_TEMP      : u64 = 8
  pub let DISPLAY_OFF_HIGH_CONTRAST   : u64 = 10
  pub let DISPLAY_OFF_FONT_SCALE      : u64 = 12

  // Defaults seeded on display_settings_load. Kelvin default 6500 is
  // the daylight neutral (sRGB D65 correlated temperature); font-
  // scale 100 is unity; refresh 60 Hz is the LCM-safe fallback the
  // KIND_DISPLAY_OUTPUT probes advertise as guaranteed.
  pub let DISPLAY_DEFAULT_OUTPUT      : u64 = 0
  pub let DISPLAY_DEFAULT_RES_INDEX   : u64 = 0
  pub let DISPLAY_DEFAULT_REFRESH_HZ  : u64 = 60
  pub let DISPLAY_DEFAULT_HDR         : u64 = 0
  pub let DISPLAY_DEFAULT_TONEMAP     : u64 = 0
  pub let DISPLAY_DEFAULT_NIGHT_TEMP  : u64 = 6500
  pub let DISPLAY_DEFAULT_CONTRAST    : u64 = 0
  pub let DISPLAY_DEFAULT_FONT_SCALE  : u64 = 100

  // Slider ranges (min inclusive, max inclusive). Widget clamp is
  // applied per call. Refresh-rate slider covers 60..240 as a raw Hz
  // range; a future dropdown will bind to the mode-list enumeration.
  pub let DISPLAY_RES_MIN             : u64 = 0
  pub let DISPLAY_RES_MAX             : u64 = 255
  pub let DISPLAY_REFRESH_MIN         : u64 = 60
  pub let DISPLAY_REFRESH_MAX         : u64 = 240
  pub let DISPLAY_TONEMAP_MIN         : u64 = 0
  pub let DISPLAY_TONEMAP_MAX         : u64 = 8
  pub let DISPLAY_NIGHT_MIN           : u64 = 2700
  pub let DISPLAY_NIGHT_MAX           : u64 = 6500
  pub let DISPLAY_FONT_MIN            : u64 = 50
  pub let DISPLAY_FONT_MAX            : u64 = 300

  // Panel layout constants (widget rects).
  pub let DISPLAY_PANEL_X             : u64 = 10
  pub let DISPLAY_PANEL_W             : u64 = 200
  pub let DISPLAY_PANEL_H             : u64 = 24
  pub let DISPLAY_ROW_Y0              : u64 = 20
  pub let DISPLAY_ROW_STEP            : u64 = 28

  // WidgetResult enum (mirrored from widgets.pdx §Section 1). Values
  // MUST match; caller aggregation depends on numeric ordering
  // (CHANGED > ACTIVE > CLICKED > HOVERED > NONE).
  pub let DISPLAY_WR_NONE             : u64 = 0
  pub let DISPLAY_WR_HOVERED          : u64 = 1
  pub let DISPLAY_WR_CLICKED          : u64 = 2
  pub let DISPLAY_WR_ACTIVE           : u64 = 3
  pub let DISPLAY_WR_CHANGED          : u64 = 4

  // Failure sentinels 0xFFFFE900..0xFFFFE90F. Reserved for a future
  // service-boundary promotion (G12.M4 settings service). Not
  // returned from the current entry points, which collapse refusal
  // to WR_NONE / 0 with a DISPLAY_ST_REFUSED bump.
  pub let DISPLAY_OK                  : u64 = 0
  pub let DISPLAY_BAD_PTR             : u64 = 0xFFFFE90F   // settings_ptr == 0
  pub let DISPLAY_BAD_CTX             : u64 = 0xFFFFE90E   // ctx_row_id invalid
  pub let DISPLAY_BAD_PREF            : u64 = 0xFFFFE90D   // /system/prefs/display.pdxpref malformed
  pub let DISPLAY_NO_STORE            : u64 = 0xFFFFE90C   // preferences store not yet mounted
  pub let DISPLAY_WRITE_FAIL          : u64 = 0xFFFFE90B   // save write returned nonzero
  // 0xFFFFE900..0xFFFFE90A reserved for G12.M4 follow-ups.

  // ==========================================================================
  // Section 2  State: struct instance + counters.
  // ==========================================================================
  //
  // _display_settings holds THE ONE panel-owned DisplaySettings
  // instance. A future multi-monitor / multi-user landing may promote
  // this to an arena keyed by user session; the current shape is
  // single-instance because there is one panel per client process
  // and per-user preferences are a separate concern (KIND_USER_PROFILE
  // has not yet been allocated).
  //
  // Sized to two u64 for the 16-byte struct (matches the natural
  // alignment on x86_64). @align(64) puts it on a cache line so a
  // save-then-reload cycle does not stall on a partial-line fill.

  pub let mut _display_settings : [u64; 2] = uninit @align(64)

  // Counter vector for smoke-witness observability. Four slots:
  //   [DISPLAY_ST_LOADS]    -- display_settings_load calls.
  //   [DISPLAY_ST_SAVES]    -- display_settings_save calls.
  //   [DISPLAY_ST_RENDERS]  -- display_settings_render calls.
  //   [DISPLAY_ST_REFUSED]  -- refused entry-point invocations.

  pub let mut _display_stats : [u64; 4] = uninit @align(64)

  pub let DISPLAY_ST_LOADS    : u64 = 0
  pub let DISPLAY_ST_SAVES    : u64 = 1
  pub let DISPLAY_ST_RENDERS  : u64 = 2
  pub let DISPLAY_ST_REFUSED  : u64 = 3

  pub let display_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): clear counter vector at boot. Four u64 slots. Labels prefixed display_sr_.",
      block: {
        lea r10, [rip + _display_stats];
        xor rax, rax;
        xor rcx, rcx;
      display_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  display_sr_top;
        ret
      }
    }

  pub let display_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed display_nt_.",
      block: {
        cmp rdi, 4;
        jae display_nt_out;
        lea r10, [rip + _display_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      display_nt_out:
        ret
      }
    }

  pub let display_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): counter read. Labels prefixed display_st_.",
      block: {
        cmp rdi, 4;
        jae display_st_zero;
        lea r10, [rip + _display_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      display_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Marshal helpers: struct byte <-> widget scratch slot.
  // ==========================================================================
  //
  // widget_slider reads/writes a u32 at [value_ptr+0]; widget_checkbox
  // reads/writes a u64 at [state_ptr+0]. The DisplaySettings fields
  // are u8/u16. These helpers marshal a field byte-range into a
  // caller-provided stack scratch slot (a u32/u64), invoke the widget,
  // and marshal the CLAMPED result back into the field byte-range,
  // preserving neighbouring bytes.

  // display_slider_u8(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u32 in a stack scratch slot,
  // invokes widget_slider on the scratch, writes the low 8 bits back
  // to *field_ptr. Padding bytes above the field are preserved via
  // byte-granular store.
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+3]  scratch u32 (widget_slider value_ptr)
  //   [rsp + 4..+7]  pad
  //   Callee-save pushes: rbx=field_ptr (needs to survive widget_slider).
  //   Entry rsp%16 == 8; push rbx (%16 == 0) then sub rsp,8 (%16 == 8);
  //   sub rsp,16 instead lands rsp%16 == 8 for the nested call --
  //   correct because widget_slider itself pushes further, restoring
  //   its own alignment. We use sub rsp,8 + one push to reach %16 == 0.

  pub let display_slider_u8 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): u8-field slider marshal. Pushes rbx (=field_ptr) then sub rsp,8 for the u32 scratch at [rsp+0]. Entry rsp%16 == 8, +8 push + 8 sub = %16 == 0 for the widget_slider call. Loads *field_ptr as byte via mov_b (zero-extending), stores into scratch as u32, calls widget_slider, then stores low 8 bits of scratch back to *field_ptr via mov_b (preserves neighbouring struct bytes). Labels prefixed display_su_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u8 -> scratch u32.
        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        // rdi = ctx_row already; rsi = rect_ptr already; rdx = &scratch.
        lea  rdx, [rsp + 0];
        // rcx = min_val, r8 = max_val already in place per SysV.
        call widget_slider;
        // rax = WidgetResult.

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;                    // preserve widget result
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // display_slider_u16(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Same shape as display_slider_u8 but with a u16 field. mov_w is
  // used for the byte-range load/store. Scratch stays u32 (widget
  // slider ABI).

  pub let display_slider_u16 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): u16-field slider marshal. Identical alignment shape to display_slider_u8. mov_w load/store preserves neighbouring bytes. Labels prefixed display_sw_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u16 -> scratch u32.
        mov_w rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        lea  rdx, [rsp + 0];
        call widget_slider;

        // Marshal back: low 16 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov_d rax, [rsp + 0];
        mov_w [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // display_checkbox_u8(ctx_row, rect_ptr, label_offset, field_ptr)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u64 in a stack scratch slot,
  // invokes widget_checkbox (which XORs bit 0 on click), stores low
  // 8 bits (0 or 1) back. widget_checkbox is tolerant of higher bits
  // in the scratch, so the promoted u8 value is loaded as-is.

  pub let display_checkbox_u8 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (label_offset: u64) (field_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): u8-field checkbox marshal. Push rbx (=field_ptr) then sub rsp,8 for u64 scratch at [rsp+0]. Load byte via mov_b, store u64, call widget_checkbox, store low 8 bits back via mov_b. Labels prefixed display_cb_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rcx;                    // field_ptr (arg 4 -> rcx)

        // Load *field_ptr as u8 -> scratch u64.
        mov_b rax, [rbx + 0];
        mov  [rsp + 0], rax;

        // widget_checkbox(ctx_row, rect_ptr, label_offset, &scratch).
        // rdi/rsi/rdx already in place.
        lea  rcx, [rsp + 0];
        call widget_checkbox;

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov  rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Factory + persistence: load / save.
  // ==========================================================================
  //
  // display_settings_load() -> u64  (pointer to the static instance,
  //                                   populated with defaults)
  //
  // Zeros the _display_settings buffer, then writes the eight default
  // field values in place. Returns &_display_settings (the caller
  // treats this as an opaque pointer; do NOT free). A future landing
  // that reads /system/prefs/display.pdxpref will hook here to
  // override defaults with persisted values; the read path is a
  // G12.M4 concern (settings service). Bumps DISPLAY_ST_LOADS.

  pub let display_settings_load : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): populate _display_settings with defaults and return &_display_settings. Stub for the real persisted-load path (G12.M4). Two callee-save pushes (rbx=struct_base, r12 unused here but reserved for symmetry with save) would inflate the frame; we use only rbx. Entry rsp%16 == 8, push rbx -> %16 == 0 for display_note call. Labels prefixed display_ld_.",
      block: {
        push rbx;
        lea  rbx, [rip + _display_settings];

        // Zero the 16-byte block.
        xor  rax, rax;
        mov  [rbx + 0], rax;
        mov  [rbx + 8], rax;

        // Write each default field. Byte / word stores preserve
        // packing; the zeroed base above means we only touch the
        // fields we set.
        mov  rax, 0;                      // DISPLAY_DEFAULT_OUTPUT
        mov_d [rbx + 0], rax;             // active_output_kind_id
        mov  rax, 0;                      // DISPLAY_DEFAULT_RES_INDEX
        mov_b [rbx + 4], rax;
        mov  rax, 60;                     // DISPLAY_DEFAULT_REFRESH_HZ
        mov_b [rbx + 5], rax;
        mov  rax, 0;                      // DISPLAY_DEFAULT_HDR
        mov_b [rbx + 6], rax;
        mov  rax, 0;                      // DISPLAY_DEFAULT_TONEMAP
        mov_b [rbx + 7], rax;
        mov  rax, 6500;                   // DISPLAY_DEFAULT_NIGHT_TEMP
        mov_w [rbx + 8], rax;
        mov  rax, 0;                      // DISPLAY_DEFAULT_CONTRAST
        mov_b [rbx + 10], rax;
        mov  rax, 100;                    // DISPLAY_DEFAULT_FONT_SCALE
        mov_w [rbx + 12], rax;

        mov  rdi, 0;                      // DISPLAY_ST_LOADS
        call display_note;

        // Return &_display_settings.
        lea  rax, [rip + _display_settings];
        pop  rbx;
        ret
      }
    }

  // display_settings_save(settings_ptr: u64) -> u64
  //
  // Stub write-back. Returns 0 (success) after bumping DISPLAY_ST_
  // SAVES. Refuses settings_ptr == 0 by bumping DISPLAY_ST_REFUSED
  // and returning 0 (a future service-boundary landing may promote
  // this to DISPLAY_BAD_PTR). No actual disk write occurs -- the
  // /system/prefs/display.pdxpref path is a G12.M4 concern.

  pub let display_settings_save : (u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): stub save. Argument validated (non-null), then DISPLAY_ST_SAVES bumped; returns 0. Zero callee-save pushes needed (single nested call, entry rsp%16 == 8; sub rsp,8 aligns for the call). Labels prefixed display_sv_.",
      block: {
        cmp  rdi, 0;
        je   display_sv_refused;

        sub  rsp, 8;
        mov  rdi, 1;                      // DISPLAY_ST_SAVES
        call display_note;
        add  rsp, 8;

        xor  rax, rax;
        ret;

      display_sv_refused:
        sub  rsp, 8;
        mov  rdi, 3;                      // DISPLAY_ST_REFUSED
        call display_note;
        add  rsp, 8;
        xor  rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Panel: display_settings_render.
  // ==========================================================================
  //
  // display_settings_render(settings_ptr, ctx_row_id) -> WidgetResult
  //
  // Emits seven widgets in a vertical stack per §WIDGET COMPOSITION
  // above. Returns the maximum WidgetResult across all widget calls
  // this frame (numerically: WR_CHANGED > WR_ACTIVE > WR_CLICKED >
  // WR_HOVERED > WR_NONE). If ANY widget returned WR_CHANGED, the
  // panel's aggregate is WR_CHANGED and the caller should invoke
  // display_settings_save.
  //
  // Refuses settings_ptr == 0 (silent, WR_NONE, DISPLAY_ST_REFUSED
  // bumped). Refuses ctx_row_id >= UI_MAX by relying on each widget's
  // own gate (widgets collapse their internal refusal to WR_NONE and
  // bump widgets_st_REFUSED, which surfaces as "no widget interaction"
  // at the panel level).
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+15]  WidgetRect scratch (x/y/w/h as four i32).
  //   Callee-save pushes: rbx=settings_ptr, r12=ctx_row_id,
  //   r13=aggregate_result, r14=unused (reserved for future
  //   focus-tracking).
  //   Entry rsp%16 == 8; four pushes (%16 == 8) + sub rsp,16 (%16 == 8).
  //   To reach %16 == 0 for nested calls we sub rsp,24 (16 for the
  //   rect + 8 pad).

  pub let display_settings_render : (u64, u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) (ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): render panel. Four callee-save pushes + sub rsp,24 lands rsp%16 == 0 (entry %16 == 8; +32 push + 24 sub = %16 == 0). Rect scratch at [rsp+0..+15]. r13 holds the aggregate WidgetResult running max across all widget calls; individual widget returns are compared via unsigned cmp because WR_* values are 0..4. Aggregate 4 (WR_CHANGED) is the caller's cue to invoke save. Labels prefixed display_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 24;

        mov  rbx, rdi;                    // settings_ptr
        mov  r12, rsi;                    // ctx_row_id

        // Refuse NULL settings_ptr.
        cmp  rbx, 0;
        je   display_rd_refused;

        mov  rdi, 2;                      // DISPLAY_ST_RENDERS
        call display_note;

        xor  r13, r13;                    // aggregate = WR_NONE

        // Preload common rect fields (x/w/h are shared across rows).
        mov  rax, 10;                     // DISPLAY_PANEL_X
        mov_d [rsp + 0], rax;             // rect.x
        mov  rax, 200;                    // DISPLAY_PANEL_W
        mov_d [rsp + 8], rax;             // rect.w
        mov  rax, 24;                     // DISPLAY_PANEL_H
        mov_d [rsp + 12], rax;            // rect.h

        // ----- Row 0: resolution_index (slider stand-in for dropdown).
        mov  rax, 20;                     // y0
        mov_d [rsp + 4], rax;
        mov  rdi, r12;                    // ctx_row
        lea  rsi, [rsp + 0];              // rect_ptr
        lea  rdx, [rbx + 4];              // &settings.resolution_index
        mov  rcx, 0;                      // DISPLAY_RES_MIN
        mov  r8, 255;                     // DISPLAY_RES_MAX
        call display_slider_u8;
        cmp  rax, r13;
        jbe  display_rd_row0_done;
        mov  r13, rax;
      display_rd_row0_done:

        // ----- Row 1: refresh_rate_hz (slider 60..240).
        mov  rax, 48;                     // y0 + step
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 5];              // &settings.refresh_rate_hz
        mov  rcx, 60;                     // DISPLAY_REFRESH_MIN
        mov  r8, 240;                     // DISPLAY_REFRESH_MAX
        call display_slider_u8;
        cmp  rax, r13;
        jbe  display_rd_row1_done;
        mov  r13, rax;
      display_rd_row1_done:

        // ----- Row 2: hdr_enabled (checkbox).
        mov  rax, 76;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;                    // label_offset = 0 (font arena TBD)
        lea  rcx, [rbx + 6];              // &settings.hdr_enabled
        call display_checkbox_u8;
        cmp  rax, r13;
        jbe  display_rd_row2_done;
        mov  r13, rax;
      display_rd_row2_done:

        // ----- Row 3: tonemap_mode (slider 0..8).
        mov  rax, 104;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 7];              // &settings.tonemap_mode
        mov  rcx, 0;                      // DISPLAY_TONEMAP_MIN
        mov  r8, 8;                       // DISPLAY_TONEMAP_MAX
        call display_slider_u8;
        cmp  rax, r13;
        jbe  display_rd_row3_done;
        mov  r13, rax;
      display_rd_row3_done:

        // ----- Row 4: night_light_temp (slider 2700..6500).
        mov  rax, 132;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 8];              // &settings.night_light_temp
        mov  rcx, 2700;                   // DISPLAY_NIGHT_MIN
        mov  r8, 6500;                    // DISPLAY_NIGHT_MAX
        call display_slider_u16;
        cmp  rax, r13;
        jbe  display_rd_row4_done;
        mov  r13, rax;
      display_rd_row4_done:

        // ----- Row 5: a11y_high_contrast (checkbox).
        mov  rax, 160;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        lea  rcx, [rbx + 10];             // &settings.a11y_high_contrast
        call display_checkbox_u8;
        cmp  rax, r13;
        jbe  display_rd_row5_done;
        mov  r13, rax;
      display_rd_row5_done:

        // ----- Row 6: a11y_font_scale_num (slider 50..300).
        mov  rax, 188;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 12];             // &settings.a11y_font_scale_num
        mov  rcx, 50;                     // DISPLAY_FONT_MIN
        mov  r8, 300;                     // DISPLAY_FONT_MAX
        call display_slider_u16;
        cmp  rax, r13;
        jbe  display_rd_row6_done;
        mov  r13, rax;
      display_rd_row6_done:

        mov  rax, r13;                    // aggregate WidgetResult
        jmp  display_rd_out;

      display_rd_refused:
        mov  rdi, 3;                      // DISPLAY_ST_REFUSED
        call display_note;
        xor  rax, rax;                    // WR_NONE

      display_rd_out:
        add  rsp, 24;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. The struct
  // instance itself is initialised by the first display_settings_load
  // call (which happens the first time the client opens the panel);
  // there is no need to seed defaults at boot before any consumer
  // exists.

  pub let display_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-10 (#2332): call through to display_stats_reset for one clean counter zero-out. Labels prefixed display_i_.",
      block: {
        call display_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the client once display_init has
  // been called and the first display_settings_load succeeds (G12.M4
  // klog wire will emit; until then this is a compile-time literal).
  // Follows the pdx_kind_<name>_meta legacy-suffix convention shared
  // with widgets.pdx / view_tree.pdx / immediate_context.pdx.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B11 G12.M3-001 (#2332) settings display panel
  // + settings-service klog wire pending". The main coordinator adds
  // that allowlist entry at Batch 11 close-out.
  //
  // Length: "settings display ready ok [legacy: SETTINGS DISPLAY READY OK]\0"
  //   = 61 characters + NUL = 62 bytes (strlen+1 rule).
  pub let pdx_kind_settings_display_meta : [u8; 62] = "settings display ready ok [legacy: SETTINGS DISPLAY READY OK]\0"
}
