// src/samples/settings/input.pdx -- Wave0-B13-08 (paideia-os #2333)
//
// G12.M3-002: SAMPLE APP -- SETTINGS -> INPUT + IME PANEL.
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// (Developer APIs + first-party toolkit) and next-wave-synthesis.md
// line 99. This is the SECOND first-party sample application landed on
// top of the paideia-ui immediate-mode toolkit (widgets.pdx, Wave0-
// B10-09, KIND_UI_CONTEXT=0x1D5) and follows the widget-composition
// shape established by src/samples/settings/display.pdx (Wave0-B11-10,
// #2332). The two panels are deliberately siblings: same struct-in-.bss
// pattern, same load/save/render triple, same widget marshal helpers,
// same aggregate WidgetResult contract. A future settings-service
// (G12.M4) dispatcher fans out to both from a single tab-list.
//
// The panel owns an InputSettings struct held in .bss, seeds it with
// defaults on load, paints an interactive panel via egui-shape widget
// calls every frame, and writes the (post-edit) struct back to
// /system/prefs/input.pdxpref on save. Both persistence sides are
// STUBS in this landing: the file-backed store is a G12.M4 concern
// (settings service).
//
// NOVEL-CLEAN POSTURE. Same as display.pdx: pure function of the
// current InputSettings buffer plus the ui_context row's per-frame
// hover/click routing. No view model, no observer, no callback chain.
// Client's frame loop:
//
//     ui_context_begin_frame(ctx);
//     let r = input_settings_render(&settings, ctx);
//     ui_context_end_frame(ctx);
//     if r == WR_CHANGED { input_settings_save(&settings); }
//
// -----------------------------------------------------------------------------
// InputSettings LAYOUT -- 16 BYTES
// -----------------------------------------------------------------------------
//
//   [+0..+3]   default_ime_provider     : u32   (KIND_IME_PROVIDER cap;
//                                                 0 = system default)
//   [+4..+7]   keyboard_layout_offset   : u32   (interned "us"/"jp"/"in"/...)
//   [+8..+9]   pointer_accel_num        : u16   (rational numerator, 1..1000)
//   [+10..+11] pointer_accel_den        : u16   (rational denominator, 1..1000)
//   [+12]      pointer_natural_scroll   : u8    (0 or 1)
//   [+13]      trackpad_tap_to_click    : u8    (0 or 1)
//   [+14]      trackpad_palm_reject     : u8    (0 or 1)
//   [+15]      stylus_pressure_curve    : u8    (0=linear, 1=soft, 2=firm)
//
// The layout is naturally aligned per field and packs into a single
// 16-byte block (one x86_64 SSE line). No padding slots -- the four
// trailing u8 flags saturate the last quadword. All numeric fields
// use unsigned host byte order; there is no explicit endianness marker
// because paideia-os is a single-endianness (little-endian x86_64)
// target and no settings blob ever crosses an ISA boundary.
//
// The pointer sensitivity is stored as a rational num/den so the
// caller can normalise the ratio at read time (a 25/100 slider snap
// reads out as "0.25x", a 200/100 as "2.00x"); the panel exposes only
// the numerator via a slider in 1..1000 with a fixed den of 100. A
// future landing that surfaces the denominator (curve-editor style)
// adds a second slider bound to accel_den without disturbing the
// struct layout.
//
// -----------------------------------------------------------------------------
// WIDGET COMPOSITION
// -----------------------------------------------------------------------------
//
// The panel emits seven widgets in a vertical stack at x=10, w=200,
// h=24, starting y=20 and stepping y+=28 per row. Rects are stack-
// allocated in input_settings_render's frame (16 bytes) and reused
// across widgets.
//
//   Row 0  y= 20  keyboard layout      -> widget_slider (u32 offset 0..255)
//                                          (placeholder for the future
//                                           dropdown widget landing in
//                                           G12.M2-004; slider stand-in
//                                           so the panel is functional
//                                           end-to-end today. Values
//                                           beyond 255 are supported by
//                                           the u32 field but the panel
//                                           slider caps at 255 to match
//                                           the display panel's row-0
//                                           choice.)
//   Row 1  y= 48  IME provider         -> widget_slider (u32 cap 0..255)
//   Row 2  y= 76  pointer sensitivity  -> widget_slider (u16 num 1..1000)
//   Row 3  y=104  natural scroll       -> widget_checkbox
//   Row 4  y=132  tap to click         -> widget_checkbox
//   Row 5  y=160  palm reject          -> widget_checkbox
//   Row 6  y=188  stylus curve         -> widget_slider (u8 0..2)
//
// widget_slider works on a u32-shaped value_ptr and widget_checkbox on
// a u64-shaped state_ptr. The u8 and u16 InputSettings fields are
// marshalled through stack scratch slots by input_slider_u8 /
// input_slider_u16 / input_checkbox_u8 (§Section 3), mirroring the
// display panel's helpers byte-for-byte. u32 fields (rows 0 and 1)
// are passed directly to widget_slider without a marshal step -- the
// slider's read/write is the field's natural width.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY  0xFFFFE920..0xFFFFE92F
// -----------------------------------------------------------------------------
//
// NOTE ON BAND ASSIGNMENT: the task brief assigned 0xFFFFE900..
// 0xFFFFE90F, but that page is already claimed by src/samples/settings/
// display.pdx (DISPLAY_* sentinels, Wave0-B11-10 #2332). The very next
// page 0xFFFFE910..0xFFFFE91F is claimed by src/user/compositor/
// tiling_gaps.pdx (TG_ERR_* sentinels). A repo-wide grep at landing
// time confirmed 0xFFFFE920..0xFFFFE92F is entirely unclaimed across
// src/. Using this page keeps sentinel disambiguation cheap (a caller
// reading a u64 error value can grep it to exactly one module). The
// band substitution is called out in the batch summary so the main
// coordinator can update any tracking that assumed the original
// allocation.
//
// The InputSettings entry points either succeed (returning a
// WidgetResult, WR_NONE..WR_CHANGED, or 0 for save) or refuse
// silently by bumping _input_stats[INPUT_ST_REFUSED] and collapsing
// the return to WR_NONE / 0. The INPUT_* sentinels below are reserved
// for the future service-boundary promotion (G12.M4) where a settings-
// service dispatcher can surface a distinct error to a cross-process
// caller through op_status.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Input (PascalCase of file basename
// input.pdx). Labels prefixed `input_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no `add reg,[mem]`, no float, no
// FPU. 32-bit loads use `mov_d` (zero-extending); 16-bit loads use
// `mov_w`; 8-bit loads use `mov_b`. Callee-save discipline: rbx/
// r12..r15 each pushed exactly once per function that uses them,
// keeping rsp%16 aligned before every nested call.

module Input = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, ranges, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let INPUT_STRUCT_BYTES         : u64 = 16
  pub let INPUT_OFF_IME_PROVIDER     : u64 = 0
  pub let INPUT_OFF_KBD_LAYOUT       : u64 = 4
  pub let INPUT_OFF_ACCEL_NUM        : u64 = 8
  pub let INPUT_OFF_ACCEL_DEN        : u64 = 10
  pub let INPUT_OFF_NATURAL_SCROLL   : u64 = 12
  pub let INPUT_OFF_TAP_TO_CLICK     : u64 = 13
  pub let INPUT_OFF_PALM_REJECT      : u64 = 14
  pub let INPUT_OFF_STYLUS_CURVE     : u64 = 15

  // Defaults seeded on input_settings_load. IME provider 0 = system
  // default (no explicit selection); keyboard layout offset 0 = the
  // string table's canonical "us" entry; pointer sensitivity 100/100
  // = 1.0x unity; natural-scroll off (matches most desktop defaults);
  // tap-to-click on, palm-reject on (both improve touch ergonomics
  // out of the box); stylus curve linear (0) is the conservative
  // baseline until per-device calibration lands.
  pub let INPUT_DEFAULT_IME_PROVIDER : u64 = 0
  pub let INPUT_DEFAULT_KBD_LAYOUT   : u64 = 0
  pub let INPUT_DEFAULT_ACCEL_NUM    : u64 = 100
  pub let INPUT_DEFAULT_ACCEL_DEN    : u64 = 100
  pub let INPUT_DEFAULT_NATURAL_SCR  : u64 = 0
  pub let INPUT_DEFAULT_TAP_CLICK    : u64 = 1
  pub let INPUT_DEFAULT_PALM_REJECT  : u64 = 1
  pub let INPUT_DEFAULT_STYLUS_CURVE : u64 = 0

  // Slider ranges (min inclusive, max inclusive). Widget clamp is
  // applied per call. u32 fields (rows 0 and 1) are capped at 255 in
  // this landing to match the display panel's row-0 slider stand-in;
  // when the dropdown widget lands (G12.M2-004) the full u32 range
  // becomes navigable via an enumerated dropdown rather than a slider.
  pub let INPUT_KBD_MIN              : u64 = 0
  pub let INPUT_KBD_MAX              : u64 = 255
  pub let INPUT_IME_MIN              : u64 = 0
  pub let INPUT_IME_MAX              : u64 = 255
  pub let INPUT_ACCEL_MIN            : u64 = 1
  pub let INPUT_ACCEL_MAX            : u64 = 1000
  pub let INPUT_STYLUS_MIN           : u64 = 0
  pub let INPUT_STYLUS_MAX           : u64 = 2

  // Panel layout constants (widget rects).
  pub let INPUT_PANEL_X              : u64 = 10
  pub let INPUT_PANEL_W              : u64 = 200
  pub let INPUT_PANEL_H              : u64 = 24
  pub let INPUT_ROW_Y0               : u64 = 20
  pub let INPUT_ROW_STEP             : u64 = 28

  // WidgetResult enum (mirrored from widgets.pdx §Section 1). Values
  // MUST match; caller aggregation depends on numeric ordering
  // (CHANGED > ACTIVE > CLICKED > HOVERED > NONE).
  pub let INPUT_WR_NONE              : u64 = 0
  pub let INPUT_WR_HOVERED           : u64 = 1
  pub let INPUT_WR_CLICKED           : u64 = 2
  pub let INPUT_WR_ACTIVE            : u64 = 3
  pub let INPUT_WR_CHANGED           : u64 = 4

  // Failure sentinels 0xFFFFE920..0xFFFFE92F. Reserved for a future
  // service-boundary promotion (G12.M4 settings service). Not returned
  // from the current entry points, which collapse refusal to WR_NONE /
  // 0 with an INPUT_ST_REFUSED bump.
  pub let INPUT_OK                   : u64 = 0
  pub let INPUT_BAD_PTR              : u64 = 0xFFFFE92F   // settings_ptr == 0
  pub let INPUT_BAD_CTX              : u64 = 0xFFFFE92E   // ctx_row_id invalid
  pub let INPUT_BAD_PREF             : u64 = 0xFFFFE92D   // /system/prefs/input.pdxpref malformed
  pub let INPUT_NO_STORE             : u64 = 0xFFFFE92C   // preferences store not yet mounted
  pub let INPUT_WRITE_FAIL           : u64 = 0xFFFFE92B   // save write returned nonzero
  pub let INPUT_BAD_IME              : u64 = 0xFFFFE92A   // default_ime_provider cap not present
  pub let INPUT_BAD_ACCEL            : u64 = 0xFFFFE929   // accel_den == 0 or ratio out of range
  // 0xFFFFE920..0xFFFFE928 reserved for G12.M4 follow-ups.

  // ==========================================================================
  // Section 2  State: struct instance + counters.
  // ==========================================================================
  //
  // _input_settings holds THE ONE panel-owned InputSettings instance.
  // A future multi-seat / multi-user landing may promote this to an
  // arena keyed by user session; the current shape is single-instance
  // because there is one panel per client process and per-user
  // preferences are a separate concern (KIND_USER_PROFILE has not yet
  // been allocated).
  //
  // Sized to two u64 for the 16-byte struct (matches the natural
  // alignment on x86_64). @align(64) puts it on a cache line so a
  // save-then-reload cycle does not stall on a partial-line fill.

  pub let mut _input_settings : [u64; 2] = uninit @align(64)

  // Counter vector for smoke-witness observability. Four slots:
  //   [INPUT_ST_LOADS]    -- input_settings_load calls.
  //   [INPUT_ST_SAVES]    -- input_settings_save calls.
  //   [INPUT_ST_RENDERS]  -- input_settings_render calls.
  //   [INPUT_ST_REFUSED]  -- refused entry-point invocations.

  pub let mut _input_stats : [u64; 4] = uninit @align(64)

  pub let INPUT_ST_LOADS    : u64 = 0
  pub let INPUT_ST_SAVES    : u64 = 1
  pub let INPUT_ST_RENDERS  : u64 = 2
  pub let INPUT_ST_REFUSED  : u64 = 3

  pub let input_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): clear counter vector at boot. Four u64 slots. Labels prefixed input_sr_.",
      block: {
        lea r10, [rip + _input_stats];
        xor rax, rax;
        xor rcx, rcx;
      input_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  input_sr_top;
        ret
      }
    }

  pub let input_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed input_nt_.",
      block: {
        cmp rdi, 4;
        jae input_nt_out;
        lea r10, [rip + _input_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      input_nt_out:
        ret
      }
    }

  pub let input_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): counter read. Labels prefixed input_st_.",
      block: {
        cmp rdi, 4;
        jae input_st_zero;
        lea r10, [rip + _input_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      input_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Marshal helpers: struct byte <-> widget scratch slot.
  // ==========================================================================
  //
  // widget_slider reads/writes a u32 at [value_ptr+0]; widget_checkbox
  // reads/writes a u64 at [state_ptr+0]. The InputSettings u8 and u16
  // fields go through the marshal helpers below. The u32 fields
  // (default_ime_provider, keyboard_layout_offset) are passed directly
  // to widget_slider from input_settings_render -- the slider's u32
  // read/write matches the field's natural width, so no scratch slot
  // is needed for them.
  //
  // The helper shapes below are structurally identical to their
  // display.pdx counterparts (display_slider_u8 / display_slider_u16
  // / display_checkbox_u8). Kept as separate labels here so the
  // module-name prefix stays coherent and so a future divergence
  // (e.g. an input-specific clamp that snaps the pointer accel to a
  // curve) does not have to propagate back through display.pdx.

  // input_slider_u8(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u32 in a stack scratch slot,
  // invokes widget_slider on the scratch, writes the low 8 bits back
  // to *field_ptr. Padding bytes above the field are preserved via
  // byte-granular store.

  pub let input_slider_u8 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): u8-field slider marshal. Pushes rbx (=field_ptr) then sub rsp,8 for the u32 scratch at [rsp+0]. Entry rsp%16 == 8, +8 push + 8 sub = %16 == 0 for the widget_slider call. Loads *field_ptr as byte via mov_b (zero-extending), stores into scratch as u32, calls widget_slider, then stores low 8 bits of scratch back to *field_ptr via mov_b (preserves neighbouring struct bytes). Labels prefixed input_su_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u8 -> scratch u32.
        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        // rdi = ctx_row already; rsi = rect_ptr already; rdx = &scratch.
        lea  rdx, [rsp + 0];
        // rcx = min_val, r8 = max_val already in place per SysV.
        call widget_slider;
        // rax = WidgetResult.

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;                    // preserve widget result
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // input_slider_u16(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Same shape as input_slider_u8 but with a u16 field. mov_w is used
  // for the byte-range load/store. Scratch stays u32 (widget slider
  // ABI).

  pub let input_slider_u16 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): u16-field slider marshal. Identical alignment shape to input_slider_u8. mov_w load/store preserves neighbouring bytes. Labels prefixed input_sw_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u16 -> scratch u32.
        mov_w rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        lea  rdx, [rsp + 0];
        call widget_slider;

        // Marshal back: low 16 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov_d rax, [rsp + 0];
        mov_w [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // input_checkbox_u8(ctx_row, rect_ptr, label_offset, field_ptr)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u64 in a stack scratch slot,
  // invokes widget_checkbox (which XORs bit 0 on click), stores low
  // 8 bits (0 or 1) back. widget_checkbox is tolerant of higher bits
  // in the scratch, so the promoted u8 value is loaded as-is.

  pub let input_checkbox_u8 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (label_offset: u64) (field_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): u8-field checkbox marshal. Push rbx (=field_ptr) then sub rsp,8 for u64 scratch at [rsp+0]. Load byte via mov_b, store u64, call widget_checkbox, store low 8 bits back via mov_b. Labels prefixed input_cb_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rcx;                    // field_ptr (arg 4 -> rcx)

        // Load *field_ptr as u8 -> scratch u64.
        mov_b rax, [rbx + 0];
        mov  [rsp + 0], rax;

        // widget_checkbox(ctx_row, rect_ptr, label_offset, &scratch).
        // rdi/rsi/rdx already in place.
        lea  rcx, [rsp + 0];
        call widget_checkbox;

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov  rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Factory + persistence: load / save.
  // ==========================================================================
  //
  // input_settings_load() -> u64  (pointer to the static instance,
  //                                 populated with defaults)
  //
  // Zeros the _input_settings buffer, then writes the eight default
  // field values in place. Returns &_input_settings (the caller treats
  // this as an opaque pointer; do NOT free). A future landing that
  // reads /system/prefs/input.pdxpref will hook here to override
  // defaults with persisted values; the read path is a G12.M4 concern
  // (settings service). Bumps INPUT_ST_LOADS.

  pub let input_settings_load : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): populate _input_settings with defaults and return &_input_settings. Stub for the real persisted-load path (G12.M4). One callee-save push (rbx=struct_base). Entry rsp%16 == 8, push rbx -> %16 == 0 for input_note call. Labels prefixed input_ld_.",
      block: {
        push rbx;
        lea  rbx, [rip + _input_settings];

        // Zero the 16-byte block.
        xor  rax, rax;
        mov  [rbx + 0], rax;
        mov  [rbx + 8], rax;

        // Write each default field. Byte / word / dword stores preserve
        // packing; the zeroed base above means we only touch the fields
        // we set.
        mov  rax, 0;                      // INPUT_DEFAULT_IME_PROVIDER
        mov_d [rbx + 0], rax;             // default_ime_provider
        mov  rax, 0;                      // INPUT_DEFAULT_KBD_LAYOUT
        mov_d [rbx + 4], rax;             // keyboard_layout_offset
        mov  rax, 100;                    // INPUT_DEFAULT_ACCEL_NUM
        mov_w [rbx + 8], rax;             // pointer_accel_num
        mov  rax, 100;                    // INPUT_DEFAULT_ACCEL_DEN
        mov_w [rbx + 10], rax;            // pointer_accel_den
        mov  rax, 0;                      // INPUT_DEFAULT_NATURAL_SCR
        mov_b [rbx + 12], rax;            // pointer_natural_scroll
        mov  rax, 1;                      // INPUT_DEFAULT_TAP_CLICK
        mov_b [rbx + 13], rax;            // trackpad_tap_to_click
        mov  rax, 1;                      // INPUT_DEFAULT_PALM_REJECT
        mov_b [rbx + 14], rax;            // trackpad_palm_reject
        mov  rax, 0;                      // INPUT_DEFAULT_STYLUS_CURVE
        mov_b [rbx + 15], rax;            // stylus_pressure_curve

        mov  rdi, 0;                      // INPUT_ST_LOADS
        call input_note;

        // Return &_input_settings.
        lea  rax, [rip + _input_settings];
        pop  rbx;
        ret
      }
    }

  // input_settings_save(settings_ptr: u64) -> u64
  //
  // Stub write-back. Returns 0 (success) after bumping INPUT_ST_SAVES.
  // Refuses settings_ptr == 0 by bumping INPUT_ST_REFUSED and returning
  // 0 (a future service-boundary landing may promote this to
  // INPUT_BAD_PTR). No actual disk write occurs -- the
  // /system/prefs/input.pdxpref path is a G12.M4 concern.

  pub let input_settings_save : (u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): stub save. Argument validated (non-null), then INPUT_ST_SAVES bumped; returns 0. Zero callee-save pushes needed (single nested call, entry rsp%16 == 8; sub rsp,8 aligns for the call). Labels prefixed input_sv_.",
      block: {
        cmp  rdi, 0;
        je   input_sv_refused;

        sub  rsp, 8;
        mov  rdi, 1;                      // INPUT_ST_SAVES
        call input_note;
        add  rsp, 8;

        xor  rax, rax;
        ret;

      input_sv_refused:
        sub  rsp, 8;
        mov  rdi, 3;                      // INPUT_ST_REFUSED
        call input_note;
        add  rsp, 8;
        xor  rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Panel: input_settings_render.
  // ==========================================================================
  //
  // input_settings_render(settings_ptr, ctx_row_id) -> WidgetResult
  //
  // Emits seven widgets in a vertical stack per §WIDGET COMPOSITION
  // above. Returns the maximum WidgetResult across all widget calls
  // this frame (numerically: WR_CHANGED > WR_ACTIVE > WR_CLICKED >
  // WR_HOVERED > WR_NONE). If ANY widget returned WR_CHANGED, the
  // panel's aggregate is WR_CHANGED and the caller should invoke
  // input_settings_save.
  //
  // Refuses settings_ptr == 0 (silent, WR_NONE, INPUT_ST_REFUSED
  // bumped). Refuses ctx_row_id >= UI_MAX by relying on each widget's
  // own gate (widgets collapse their internal refusal to WR_NONE and
  // bump widgets_st_REFUSED, which surfaces as "no widget interaction"
  // at the panel level).
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+15]  WidgetRect scratch (x/y/w/h as four i32).
  //   Callee-save pushes: rbx=settings_ptr, r12=ctx_row_id,
  //   r13=aggregate_result, r14=unused (reserved for future
  //   focus-tracking).
  //   Entry rsp%16 == 8; four pushes (%16 == 8) + sub rsp,24 (%16 == 0
  //   after +32+24 with entry offset) -- see display.pdx §Section 5
  //   for the identical arithmetic.

  pub let input_settings_render : (u64, u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) (ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): render panel. Four callee-save pushes + sub rsp,24 lands rsp%16 == 0 (entry %16 == 8; +32 push + 24 sub = %16 == 0). Rect scratch at [rsp+0..+15]. r13 holds the aggregate WidgetResult running max across all widget calls; individual widget returns are compared via unsigned cmp because WR_* values are 0..4. Aggregate 4 (WR_CHANGED) is the caller's cue to invoke save. Rows 0 and 1 call widget_slider directly (u32 fields at natural width); rows 2 and 6 go through input_slider_u16 / input_slider_u8; rows 3..5 through input_checkbox_u8. Labels prefixed input_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 24;

        mov  rbx, rdi;                    // settings_ptr
        mov  r12, rsi;                    // ctx_row_id

        // Refuse NULL settings_ptr.
        cmp  rbx, 0;
        je   input_rd_refused;

        mov  rdi, 2;                      // INPUT_ST_RENDERS
        call input_note;

        xor  r13, r13;                    // aggregate = WR_NONE

        // Preload common rect fields (x/w/h are shared across rows).
        mov  rax, 10;                     // INPUT_PANEL_X
        mov_d [rsp + 0], rax;             // rect.x
        mov  rax, 200;                    // INPUT_PANEL_W
        mov_d [rsp + 8], rax;             // rect.w
        mov  rax, 24;                     // INPUT_PANEL_H
        mov_d [rsp + 12], rax;            // rect.h

        // ----- Row 0: keyboard_layout_offset (u32 slider stand-in).
        // widget_slider reads/writes u32 at value_ptr -- pass field addr
        // directly (natural width, no marshal).
        mov  rax, 20;                     // y0
        mov_d [rsp + 4], rax;
        mov  rdi, r12;                    // ctx_row
        lea  rsi, [rsp + 0];              // rect_ptr
        lea  rdx, [rbx + 4];              // &settings.keyboard_layout_offset
        mov  rcx, 0;                      // INPUT_KBD_MIN
        mov  r8, 255;                     // INPUT_KBD_MAX
        call widget_slider;
        cmp  rax, r13;
        jbe  input_rd_row0_done;
        mov  r13, rax;
      input_rd_row0_done:

        // ----- Row 1: default_ime_provider (u32 slider stand-in).
        mov  rax, 48;                     // y0 + step
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 0];              // &settings.default_ime_provider
        mov  rcx, 0;                      // INPUT_IME_MIN
        mov  r8, 255;                     // INPUT_IME_MAX
        call widget_slider;
        cmp  rax, r13;
        jbe  input_rd_row1_done;
        mov  r13, rax;
      input_rd_row1_done:

        // ----- Row 2: pointer_accel_num (u16 slider 1..1000).
        mov  rax, 76;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 8];              // &settings.pointer_accel_num
        mov  rcx, 1;                      // INPUT_ACCEL_MIN
        mov  r8, 1000;                    // INPUT_ACCEL_MAX
        call input_slider_u16;
        cmp  rax, r13;
        jbe  input_rd_row2_done;
        mov  r13, rax;
      input_rd_row2_done:

        // ----- Row 3: pointer_natural_scroll (checkbox).
        mov  rax, 104;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;                    // label_offset = 0 (font arena TBD)
        lea  rcx, [rbx + 12];             // &settings.pointer_natural_scroll
        call input_checkbox_u8;
        cmp  rax, r13;
        jbe  input_rd_row3_done;
        mov  r13, rax;
      input_rd_row3_done:

        // ----- Row 4: trackpad_tap_to_click (checkbox).
        mov  rax, 132;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        lea  rcx, [rbx + 13];             // &settings.trackpad_tap_to_click
        call input_checkbox_u8;
        cmp  rax, r13;
        jbe  input_rd_row4_done;
        mov  r13, rax;
      input_rd_row4_done:

        // ----- Row 5: trackpad_palm_reject (checkbox).
        mov  rax, 160;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;
        lea  rcx, [rbx + 14];             // &settings.trackpad_palm_reject
        call input_checkbox_u8;
        cmp  rax, r13;
        jbe  input_rd_row5_done;
        mov  r13, rax;
      input_rd_row5_done:

        // ----- Row 6: stylus_pressure_curve (u8 slider 0..2).
        mov  rax, 188;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 15];             // &settings.stylus_pressure_curve
        mov  rcx, 0;                      // INPUT_STYLUS_MIN
        mov  r8, 2;                       // INPUT_STYLUS_MAX
        call input_slider_u8;
        cmp  rax, r13;
        jbe  input_rd_row6_done;
        mov  r13, rax;
      input_rd_row6_done:

        mov  rax, r13;                    // aggregate WidgetResult
        jmp  input_rd_out;

      input_rd_refused:
        mov  rdi, 3;                      // INPUT_ST_REFUSED
        call input_note;
        xor  rax, rax;                    // WR_NONE

      input_rd_out:
        add  rsp, 24;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. The struct
  // instance itself is initialised by the first input_settings_load
  // call (which happens the first time the client opens the panel);
  // there is no need to seed defaults at boot before any consumer
  // exists.

  pub let input_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-08 (#2333): call through to input_stats_reset for one clean counter zero-out. Labels prefixed input_i_.",
      block: {
        call input_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the client once input_init has
  // been called and the first input_settings_load succeeds (G12.M4
  // klog wire will emit; until then this is a compile-time literal).
  // Follows the pdx_kind_<name>_meta legacy-suffix convention shared
  // with widgets.pdx / view_tree.pdx / immediate_context.pdx /
  // display.pdx.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B13 G12-M3-002 (#2333) settings input sample
  // panel; settings-service klog wire pending G12.M4". The main
  // coordinator adds that allowlist entry at Batch 13 close-out.
  //
  // Length: "settings input ready ok [legacy: SETTINGS INPUT READY OK]\0"
  //   = 57 characters + NUL = 58 bytes (strlen+1 rule).
  pub let pdx_kind_settings_input_meta : [u8; 58] = "settings input ready ok [legacy: SETTINGS INPUT READY OK]\0"
}
