// src/samples/settings/ime.pdx -- Wave0-B15 (paideia-os #2333)
//
// G12.M3-002: SAMPLE APP -- SETTINGS -> IME PANEL (fine-grained slice).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit.
// src/samples/settings/input.pdx (Wave0-B13-08, #2331) ships a single
// IME-provider slider inside its 7-row INPUT panel as a stand-in; this
// file is the dedicated fine-grained IME sub-panel that slice deserved
// -- 9 widgets covering provider, candidate-window style, learning
// policy + history depth, hotkey mode + display, dictionary languages
// and a reset action. Sibling of input.pdx/display.pdx/color.pdx: same
// struct-in-.bss + load/save/render triple + WidgetResult aggregation,
// but DECOMPOSED into one named builder function per row (rather than
// inlined in render) so a future settings-service tab dispatcher can
// unit-test or swap a single row without touching the other eight.
//
// NOVEL-CLEAN POSTURE. Pure function of an IMESettings buffer plus the
// ui_context row's per-frame hover/click routing; no view model, no
// callback chain. Client's frame loop (settings_ime_main runs exactly
// this, bounded to 60 ticks as a sample):
//
//     ui_context_begin_frame(ctx);
//     let r = ime_settings_render(&settings, ctx);
//     ui_context_end_frame(ctx);
//     if r == WR_CHANGED { ime_settings_save(&settings); }
//
// IMESettings LAYOUT -- 16 BYTES:
//   [+0] ime_enabled u8 (0/1)  [+1] provider u8 (0..5, IME_PROVIDER_
//   TABLE index)  [+2] candidate_window_style u8 (0=inline,1=floating,
//   2=docked-bottom)  [+3] learning_enabled u8 (0/1)  [+4] learning_
//   history_depth_idx u8 (0..3, IME_HISTORY_DEPTH_TABLE index)  [+5]
//   hotkey_mode u8 (0=toggle-key,1=hold-key,2=dual-key)  [+6..+7] pad
//   [+8..+11] hotkey_label_cached_len u32 (byte length of the CURRENT
//   hotkey label; refreshed by ime_widget_hotkey_mode on every mode
//   change so ime_widget_hotkey_label never recomputes it)  [+12..+15]
//   dict_lang_bitmask u32 (bit i = IME_LANG_TABLE[i] enabled). RESET_
//   DEFAULTS (widget 9) has no field -- it resets the WHOLE struct via
//   ime_settings_apply_defaults.
//
// WIDGET COMPOSITION -- 9 rows, vertical stack x=10 w=200 h=24:
//   0 y= 20 IME_ENABLED            -> ime_widget_enabled          (checkbox)
//   1 y= 48 PROVIDER_SELECTOR      -> ime_widget_provider         (slider 0..5)
//   2 y= 76 CANDIDATE_WINDOW_STYLE -> ime_widget_window_style     (slider 0..2)
//   3 y=104 LEARNING_TOGGLE        -> ime_widget_learning_toggle  (checkbox)
//   4 y=132 LEARNING_HISTORY_DEPTH -> ime_widget_history_depth    (slider 0..3, index)
//   5 y=160 HOTKEY_MODE            -> ime_widget_hotkey_mode      (slider 0..2)
//   6 y=188 HOTKEY_LABEL           -> ime_widget_hotkey_label     (read-only label)
//   7 y=216 DICT_LANG_LIST         -> ime_widget_dict_lang_chips  (slider 0..255, bitmask)
//   8 y=244 RESET_DEFAULTS         -> ime_widget_reset_defaults   (button)
// Rows 1/2/4/5/7 are slider STAND-INS over an enumerated index or raw
// bitmask -- widgets.pdx has neither a dropdown nor a multi-select
// chip primitive yet (G12.M2-004), same posture as input.pdx's row 0/1.
//
// PANEL-LEVEL LINEAR DISCIPLINE. Before any row paints in a given
// frame, ime_settings_render calls ime_settings_layout_precheck, which
// validates ALL 9 row rects via widgets_rect_valid up front. If ANY
// rect fails, NONE of the 9 widgets are called that frame -- the panel
// mints its layout atomically, all-or-nothing, matching a LINEAR
// resource's all-or-nothing consumption discipline.
//
// FAILURE TAXONOMY 0xFFFFE940..0xFFFFE94F. BAND SUBSTITUTION (TWICE
// OVER): the task brief pre-assigned 0xFFFFE910..91F, but that page is
// ALREADY double-claimed (color.pdx's COLOR_BAD_* AND tiling_gaps.
// pdx's TG_ERR_*); the neighbouring 0xFFFFE920..92F is ALSO double-
// claimed (input.pdx and clock/analog.pdx); the NEXT candidate,
// 0xFFFFE930..93F, was free at this landing's first grep but was
// claimed out from under it mid-session by a concurrent Batch-15
// landing (src/user/tokenizer.pdx's TTA_* sentinels, #2342). A re-grep
// at write time shows 0xFFFFE940..94F entirely free; this file claims
// that page instead.
//   SIM_OK(0) success. SIM_NULL(..94F) settings_ptr==0. SIM_UI_CTX_
//   MINT_FAIL(..94E) ui_context_new refused. SIM_ROW_LAYOUT_FAIL
//   (..94D) the FIRST-EVER render's layout precheck refused (IME_ST_
//   RENDERS==0). SIM_PROVIDER_ENUM_INVALID(..94C) / SIM_HOTKEY_MODE_
//   INVALID(..94B) / SIM_HISTORY_DEPTH_INVALID(..94A) defensive out-
//   of-range records from the matching widget builder (the slider
//   clamp already prevents these via the UI path; the record exists
//   for a future prefs-load path). SIM_REFUSED_DENSE(..949) a LATER
//   render's precheck refused after a prior render already succeeded
//   -- distinct from ROW_LAYOUT_FAIL so a debugger can tell "never
//   worked" from "broke after working." SIM_NOT_INIT(..948) reserved
//   for a future service-boundary landing; not returned this landing.
//   0xFFFFE940..947 reserved. The three ENUM_INVALID values are
//   recorded (not returned) via _ime_last_error, pollable via
//   ime_last_error().
//
// ENCODER DISCIPLINE. paideia-as M0305 module = Ime (PascalCase of
// ime.pdx). Labels prefixed `ime_` (the sample entry keeps its task-
// given name `settings_ime_main`, block-labelled `settings_ime_m_`).
// Encoder-conservative: no `test rN,rN` (use `cmp rN,0`), no `and
// r11,imm64` (register-register `and` only), no 2-op `imul r,imm` (no
// multiplication needed anywhere -- every rect uses a hardcoded y
// immediate), no neg/cqo/idiv, no `add reg,[mem]`, no float/FPU.
// Every nested-call-bearing function mirrors an already-landed,
// structurally-identical shape from input.pdx / widgets.pdx / clock/
// timezone.pdx / adaptive_rate/main.pdx rather than a novel push/sub
// skeleton, staying inside the proven rsp%16==0 pre-CALL discipline:
// never a bare `push reg; call foo; pop reg` with nothing between.

module Ime = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, ranges, enum tables, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let IME_STRUCT_BYTES           : u64 = 16
  pub let IME_OFF_ENABLED            : u64 = 0
  pub let IME_OFF_PROVIDER           : u64 = 1
  pub let IME_OFF_WINDOW_STYLE       : u64 = 2
  pub let IME_OFF_LEARNING_ENABLED   : u64 = 3
  pub let IME_OFF_HISTORY_DEPTH_IDX  : u64 = 4
  pub let IME_OFF_HOTKEY_MODE        : u64 = 5
  pub let IME_OFF_HOTKEY_LABEL_LEN   : u64 = 8
  pub let IME_OFF_LANG_BITMASK       : u64 = 12

  // Defaults seeded by ime_settings_apply_defaults: IME off until a
  // locale needs it; provider=Latin-autocomplete; window=inline;
  // learning ON; history idx=1 (128 rows); hotkey=toggle-key (Ctrl+
  // Space convention) with its matching cached label length; English-
  // only dictionary bitmask.
  pub let IME_DEFAULT_ENABLED        : u64 = 0
  pub let IME_DEFAULT_PROVIDER       : u64 = 0
  pub let IME_DEFAULT_WINDOW_STYLE   : u64 = 0
  pub let IME_DEFAULT_LEARNING_ON    : u64 = 1
  pub let IME_DEFAULT_HISTORY_IDX    : u64 = 1
  pub let IME_DEFAULT_HOTKEY_MODE    : u64 = 0
  pub let IME_DEFAULT_HOTKEY_LEN     : u64 = 10   // "Toggle Key"
  pub let IME_DEFAULT_LANG_BITMASK   : u64 = 1    // IME_LANG_TABLE[0] (English) only

  // Slider ranges (min inclusive, max inclusive).
  pub let IME_PROVIDER_MIN           : u64 = 0
  pub let IME_PROVIDER_MAX           : u64 = 5
  pub let IME_WINDOW_STYLE_MIN       : u64 = 0
  pub let IME_WINDOW_STYLE_MAX       : u64 = 2
  pub let IME_HISTORY_DEPTH_MIN      : u64 = 0
  pub let IME_HISTORY_DEPTH_MAX      : u64 = 3
  pub let IME_HOTKEY_MODE_MIN        : u64 = 0
  pub let IME_HOTKEY_MODE_MAX        : u64 = 2
  pub let IME_LANG_BITMASK_MIN       : u64 = 0
  pub let IME_LANG_BITMASK_MAX       : u64 = 255

  // Enum-value tables, one per dropdown/list-shaped widget. Each
  // field stores an INDEX into its table (or, for IME_LANG_TABLE, a
  // per-bit membership test), never the table's contents directly.
  pub let IME_PROVIDER_TABLE      : [u64; 6] = [0, 1, 2, 3, 4, 5]
  // 0=Latin-autocomplete 1=Latin-deadkey 2=CJK-Pinyin 3=CJK-Kana
  // 4=Indic-shaping 5=Indic-inscript
  pub let IME_WINDOW_STYLE_TABLE  : [u64; 3] = [0, 1, 2]
  // 0=inline 1=floating 2=docked-bottom
  pub let IME_HOTKEY_MODE_TABLE   : [u64; 3] = [0, 1, 2]
  // 0=toggle-key 1=hold-key 2=dual-key
  pub let IME_HISTORY_DEPTH_TABLE : [u64; 4] = [32, 128, 512, 2048]
  // index -> retained completion-history row count
  pub let IME_LANG_TABLE          : [u64; 8] =
    [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80]
  // bit i -> {en,es,fr,de,zh,ja,ko,hi} dictionary membership

  pub let IME_PROVIDER_COUNT         : u64 = 6
  pub let IME_WINDOW_STYLE_COUNT     : u64 = 3
  pub let IME_HOTKEY_MODE_COUNT      : u64 = 3
  pub let IME_HISTORY_DEPTH_COUNT    : u64 = 4
  pub let IME_LANG_COUNT             : u64 = 8

  // Panel layout constants (widget rects; see §WIDGET COMPOSITION).
  pub let IME_PANEL_X                : u64 = 10
  pub let IME_PANEL_W                : u64 = 200
  pub let IME_PANEL_H                : u64 = 24
  pub let IME_ROW_Y0                 : u64 = 20
  pub let IME_ROW_STEP               : u64 = 28
  pub let IME_ROW_Y_TABLE : [u64; 9] = [20, 48, 76, 104, 132, 160, 188, 216, 244]

  // WidgetResult enum (mirrored from widgets.pdx §Section 1). Values
  // MUST match; caller aggregation depends on numeric ordering
  // (CHANGED > ACTIVE > CLICKED > HOVERED > NONE).
  pub let IME_WR_NONE                : u64 = 0
  pub let IME_WR_HOVERED             : u64 = 1
  pub let IME_WR_CLICKED             : u64 = 2
  pub let IME_WR_ACTIVE              : u64 = 3
  pub let IME_WR_CHANGED             : u64 = 4

  // settings_ime_main placeholder mint args + loop bound. No real
  // KIND_WINDOW/KIND_SURFACE cap exists for a standalone settings
  // panel yet -- same placeholder posture as clock/timezone.pdx.
  pub let IME_PLACEHOLDER_WINDOW     : u64 = 1
  pub let IME_PLACEHOLDER_SURFACE    : u64 = 1
  pub let IME_TICK_LIMIT             : u64 = 60

  // Failure sentinels 0xFFFFE940..0xFFFFE94F (see §FAILURE TAXONOMY
  // above for the band-substitution rationale and per-sentinel
  // meaning).
  pub let SIM_OK                     : u64 = 0
  pub let SIM_NULL                   : u64 = 0xFFFFE94F
  pub let SIM_UI_CTX_MINT_FAIL       : u64 = 0xFFFFE94E
  pub let SIM_ROW_LAYOUT_FAIL        : u64 = 0xFFFFE94D
  pub let SIM_PROVIDER_ENUM_INVALID  : u64 = 0xFFFFE94C
  pub let SIM_HOTKEY_MODE_INVALID    : u64 = 0xFFFFE94B
  pub let SIM_HISTORY_DEPTH_INVALID  : u64 = 0xFFFFE94A
  pub let SIM_REFUSED_DENSE          : u64 = 0xFFFFE949
  pub let SIM_NOT_INIT               : u64 = 0xFFFFE948
  // 0xFFFFE940..0xFFFFE947 reserved for follow-ups.

  // ==========================================================================
  // Section 2  State: struct instance + shared rect scratch + counters.
  // ==========================================================================
  //
  // _ime_settings holds THE ONE panel-owned IMESettings instance (same
  // single-instance posture as every settings-panel sibling). _ime_
  // row_rect is a SHARED STATIC 16-byte WidgetRect scratch, RIP-
  // relative addressed -- every row write re-derives its own pointer
  // via `lea r10,[rip+_ime_row_rect]` immediately before use rather
  // than caching it across a nested call (a caller-saved register is
  // NOT guaranteed to survive a CALL). Static (not stack) memory means
  // render's own prologue needs no `sub rsp` for row data.

  pub let mut _ime_settings : [u64; 2] = uninit @align(64)
  pub let mut _ime_row_rect : [u64; 2] = uninit @align(64)

  // Counter vector, mirroring every settings-panel sibling: LOADS/
  // SAVES/RENDERS (renders that PASSED the layout precheck -- used to
  // distinguish SIM_ROW_LAYOUT_FAIL from SIM_REFUSED_DENSE)/REFUSED.

  pub let mut _ime_stats : [u64; 4] = uninit @align(64)

  pub let IME_ST_LOADS    : u64 = 0
  pub let IME_ST_SAVES    : u64 = 1
  pub let IME_ST_RENDERS  : u64 = 2
  pub let IME_ST_REFUSED  : u64 = 3

  // Last-recorded SIM_* enum-range sentinel (§FAILURE TAXONOMY). A
  // single observability cell, not a counter -- overwritten each time
  // a defensive range check trips, polled via ime_last_error().

  pub let mut _ime_last_error : [u64; 1] = uninit @align(64)

  pub let ime_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): clear counter vector + last-error cell at boot. Labels prefixed ime_sr_.",
      block: {
        lea r10, [rip + _ime_stats];
        xor rax, rax;
        xor rcx, rcx;
      ime_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ime_sr_top;

        lea r10, [rip + _ime_last_error];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let ime_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed ime_nt_.",
      block: {
        cmp rdi, 4;
        jae ime_nt_out;
        lea r10, [rip + _ime_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ime_nt_out:
        ret
      }
    }

  pub let ime_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): counter read. Labels prefixed ime_st_.",
      block: {
        cmp rdi, 4;
        jae ime_st_zero;
        lea r10, [rip + _ime_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ime_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ime_last_error : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): read the last-recorded SIM_* enum-range sentinel (0 if none has ever tripped). Pure leaf, no nested calls. Labels prefixed ime_le_.",
      block: {
        lea r10, [rip + _ime_last_error];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // Section 3  Enum resolver: history-depth index -> real row count.
  // ==========================================================================
  //
  // ime_history_depth_value(idx) -> row_count | SIM_HISTORY_DEPTH_INVALID.
  //
  // Resolves a learning_history_depth_idx (0..3) to its real retained-
  // history row count via IME_HISTORY_DEPTH_TABLE. Pure leaf, 4-way
  // immediate dispatch (idx values fit imm8, mirroring clock_timezone_
  // zone_label_ptr's dispatch shape). Out-of-range returns SIM_
  // HISTORY_DEPTH_INVALID so a caller can distinguish a corrupted
  // index from a legitimate 32-row table entry.

  pub let ime_history_depth_value : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 (#2333): 4-way dispatch over IME_HISTORY_DEPTH_TABLE. Pure leaf, no nested calls. Labels prefixed ime_hdv_.",
      block: {
        cmp rdi, 0; je ime_hdv_0;
        cmp rdi, 1; je ime_hdv_1;
        cmp rdi, 2; je ime_hdv_2;
        cmp rdi, 3; je ime_hdv_3;
        mov rax, 0xFFFFE94A;               // SIM_HISTORY_DEPTH_INVALID
        ret;
      ime_hdv_0: mov rax, 32;   ret;
      ime_hdv_1: mov rax, 128;  ret;
      ime_hdv_2: mov rax, 512;  ret;
      ime_hdv_3: mov rax, 2048; ret
      }
    }

  // ==========================================================================
  // Section 4  Factory + persistence: apply_defaults / load / save.
  // ==========================================================================

  // ime_settings_apply_defaults(settings_ptr) -> (). Shared by ime_
  // settings_load (fresh instance) AND ime_widget_reset_defaults (in-
  // place reset of the LIVE instance) so the two paths never drift.

  pub let ime_settings_apply_defaults : (u64) -> () !{mem} @{} =
    fn (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): zero the struct then write all 8 default IMESettings fields in place. Pure leaf (zero nested calls), refuses settings_ptr==0 as a silent no-op. Labels prefixed ime_ad_.",
      block: {
        cmp  rdi, 0;
        je   ime_ad_out;

        xor  rax, rax;
        mov  [rdi + 0], rax;
        mov  [rdi + 8], rax;

        mov  rax, 0;                       // IME_DEFAULT_ENABLED
        mov_b [rdi + 0], rax;
        mov  rax, 0;                       // IME_DEFAULT_PROVIDER
        mov_b [rdi + 1], rax;
        mov  rax, 0;                       // IME_DEFAULT_WINDOW_STYLE
        mov_b [rdi + 2], rax;
        mov  rax, 1;                       // IME_DEFAULT_LEARNING_ON
        mov_b [rdi + 3], rax;
        mov  rax, 1;                       // IME_DEFAULT_HISTORY_IDX (-> 128 rows)
        mov_b [rdi + 4], rax;
        mov  rax, 0;                       // IME_DEFAULT_HOTKEY_MODE (toggle-key)
        mov_b [rdi + 5], rax;
        mov  rax, 10;                      // IME_DEFAULT_HOTKEY_LEN ("Toggle Key")
        mov_d [rdi + 8], rax;
        mov  rax, 1;                       // IME_DEFAULT_LANG_BITMASK (English only)
        mov_d [rdi + 12], rax;

      ime_ad_out:
        ret
      }
    }

  // ime_settings_load() -> u64 (&_ime_settings, defaults populated).

  pub let ime_settings_load : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): populate _ime_settings via ime_settings_apply_defaults, bump IME_ST_LOADS, return &_ime_settings. One callee-save push (rbx=struct base) survives BOTH nested calls at the same fixed depth -- sequential calls at one depth are self-balancing, the same multi-call shape clock_timezone_main/widget_button establish. Labels prefixed ime_ld_.",
      block: {
        push rbx;
        lea  rbx, [rip + _ime_settings];

        mov  rdi, rbx;
        call ime_settings_apply_defaults;

        mov  rdi, 0;                       // IME_ST_LOADS
        call ime_note;

        mov  rax, rbx;                     // return &_ime_settings
        pop  rbx;
        ret
      }
    }

  // ime_settings_save(settings_ptr) -> u64. Stub write-back; /system/
  // prefs/ime.pdxpref is a G12.M4 settings-service concern.

  pub let ime_settings_save : (u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): bumps IME_ST_SAVES and returns 0; refuses settings_ptr==0 by bumping IME_ST_REFUSED. Same zero-push, sub-rsp-8-per-branch shape as input_settings_save. Labels prefixed ime_sv_.",
      block: {
        cmp  rdi, 0;
        je   ime_sv_refused;

        sub  rsp, 8;
        mov  rdi, 1;                       // IME_ST_SAVES
        call ime_note;
        add  rsp, 8;

        xor  rax, rax;
        ret;

      ime_sv_refused:
        sub  rsp, 8;
        mov  rdi, 3;                       // IME_ST_REFUSED
        call ime_note;
        add  rsp, 8;
        xor  rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Layout precheck: panel-level LINEAR atomic-mint gate.
  // ==========================================================================
  //
  // ime_settings_layout_precheck() -> 1 (all 9 rows valid) | 0 (any invalid).
  //
  // Validates all 9 row rects via widgets_rect_valid BEFORE render
  // paints anything this frame -- see §WIDGET COMPOSITION's LINEAR-
  // discipline note. Loops over IME_ROW_Y_TABLE (Section 1); x/w/h are
  // shared and written once, the y field and the _ime_row_rect pointer
  // are both re-derived fresh every iteration (never cached across the
  // widgets_rect_valid call). Three callee-save pushes (rbx=running
  // AND accumulator seeded 1, r12=loop index, r13=table-pointer
  // scratch) -- odd count, no sub needed -- matches widget_button's /
  // clock_timezone_build_rows' proven push-only loop-with-calls shape.

  pub let ime_settings_layout_precheck : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): validate all 9 row rects atomically before any paint. Labels prefixed ime_lp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, 1;                       // accumulator: 1 = all valid so far
        xor  r12, r12;                     // row index

        lea  r10, [rip + _ime_row_rect];
        mov  rax, 10;                      // IME_PANEL_X
        mov_d [r10 + 0], rax;
        mov  rax, 200;                     // IME_PANEL_W
        mov_d [r10 + 8], rax;
        mov  rax, 24;                      // IME_PANEL_H
        mov_d [r10 + 12], rax;

      ime_lp_loop:
        cmp  r12, 9;
        jae  ime_lp_done;

        lea  r13, [rip + IME_ROW_Y_TABLE];
        mov  rax, [r13 + r12 * 8];         // this row's y

        lea  r10, [rip + _ime_row_rect];
        mov_d [r10 + 4], rax;
        mov  rdi, r10;
        call widgets_rect_valid;
        and  rbx, rax;

        add  r12, 1;
        jmp  ime_lp_loop;

      ime_lp_done:
        mov  rax, rbx;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Per-widget builders (9). Each takes (ctx_row, rect_ptr,
  // settings_ptr) and returns a WidgetResult.
  // ==========================================================================

  // Row 0: IME_ENABLED checkbox.

  pub let ime_widget_enabled : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): Row 0 IME_ENABLED checkbox marshal -- push-rbx+sub-rsp,8 u8 shape mirroring input_checkbox_u8 exactly. Labels prefixed ime_we_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 0];               // field_ptr = &settings.ime_enabled

        mov_b rax, [rbx + 0];
        mov  [rsp + 0], rax;

        xor  rdx, rdx;                     // label_offset = 0
        lea  rcx, [rsp + 0];
        call widget_checkbox;

        mov  r10, rax;
        mov  rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 1: PROVIDER_SELECTOR slider stand-in (0..5) over IME_PROVIDER_TABLE.

  pub let ime_widget_provider : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): push-rbx+sub-rsp,8 u8 slider marshal (input_slider_u8 shape) + defensive SIM_PROVIDER_ENUM_INVALID record if the clamped result is somehow still out of range. Labels prefixed ime_wp_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 1];               // field_ptr = &settings.provider

        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        lea  rdx, [rsp + 0];
        mov  rcx, 0;                       // IME_PROVIDER_MIN
        mov  r8, 5;                        // IME_PROVIDER_MAX
        call widget_slider;

        mov  r10, rax;                     // preserve WR result
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;

        mov  r11, 6;                       // IME_PROVIDER_COUNT
        cmp  rax, r11;
        jb   ime_wp_ok;
        lea  r11, [rip + _ime_last_error];
        mov  r9, 0xFFFFE94C;               // SIM_PROVIDER_ENUM_INVALID
        mov  [r11 + 0], r9;
      ime_wp_ok:
        mov  rax, r10;                     // restore WR result

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 2: CANDIDATE_WINDOW_STYLE slider stand-in (0..2).

  pub let ime_widget_window_style : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): same u8 slider marshal shape as ime_widget_provider; no reserved SIM_* sentinel for this row, the widget_slider clamp is the only gate. Labels prefixed ime_wws_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 2];               // field_ptr = &settings.candidate_window_style

        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        lea  rdx, [rsp + 0];
        mov  rcx, 0;                       // IME_WINDOW_STYLE_MIN
        mov  r8, 2;                        // IME_WINDOW_STYLE_MAX
        call widget_slider;

        mov  r10, rax;
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 3: LEARNING_TOGGLE checkbox (per-user completion learning).

  pub let ime_widget_learning_toggle : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): identical checkbox marshal shape to ime_widget_enabled. Labels prefixed ime_wlt_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 3];               // field_ptr = &settings.learning_enabled

        mov_b rax, [rbx + 0];
        mov  [rsp + 0], rax;

        xor  rdx, rdx;                     // label_offset = 0
        lea  rcx, [rsp + 0];
        call widget_checkbox;

        mov  r10, rax;
        mov  rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 4: LEARNING_HISTORY_DEPTH slider stand-in over an INDEX (0..3)
  // into IME_HISTORY_DEPTH_TABLE -- ime_history_depth_value resolves
  // the index to the real row count for any consumer that needs it.

  pub let ime_widget_history_depth : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): u8 index slider marshal + defensive SIM_HISTORY_DEPTH_INVALID record, mirroring ime_widget_provider's pattern. Labels prefixed ime_whd_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 4];               // field_ptr = &settings.learning_history_depth_idx

        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        lea  rdx, [rsp + 0];
        mov  rcx, 0;                       // IME_HISTORY_DEPTH_MIN (index)
        mov  r8, 3;                        // IME_HISTORY_DEPTH_MAX (index)
        call widget_slider;

        mov  r10, rax;
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;

        mov  r11, 4;                       // IME_HISTORY_DEPTH_COUNT
        cmp  rax, r11;
        jb   ime_whd_ok;
        lea  r11, [rip + _ime_last_error];
        mov  r9, 0xFFFFE94A;               // SIM_HISTORY_DEPTH_INVALID
        mov  [r11 + 0], r9;
      ime_whd_ok:
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 5: HOTKEY_MODE slider stand-in (0..2). After marshal-back,
  // ALSO refreshes hotkey_label_cached_len at [settings+8] so ime_
  // widget_hotkey_label's next paint reflects the new mode.

  pub let ime_widget_hotkey_mode : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): u8 slider marshal + cached-label-length refresh + defensive SIM_HOTKEY_MODE_INVALID record. field_ptr (rbx) is callee-saved and survives the widget_slider call; settings_ptr is recovered post-call as `rbx - 5` rather than preserved in a second push, keeping the same push-rbx+sub-rsp,8 shape as every other u8 slider marshal helper here. Labels prefixed ime_whm_.",
      block: {
        push rbx;
        sub  rsp, 8;
        lea  rbx, [rdx + 5];               // field_ptr = &settings.hotkey_mode

        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        lea  rdx, [rsp + 0];
        mov  rcx, 0;                       // IME_HOTKEY_MODE_MIN
        mov  r8, 2;                        // IME_HOTKEY_MODE_MAX
        call widget_slider;

        mov  r10, rax;                     // preserve WR result
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;

        mov  r11, 3;                       // IME_HOTKEY_MODE_COUNT
        cmp  rax, r11;
        jb   ime_whm_len;
        lea  r11, [rip + _ime_last_error];
        mov  r9, 0xFFFFE94B;               // SIM_HOTKEY_MODE_INVALID
        mov  [r11 + 0], r9;

      ime_whm_len:
        // Refresh cached label length at [settings+8] (u32) from the
        // new mode: "Toggle Key"=10, "Hold Key"/"Dual Key"=8.
        lea  r9, [rbx - 5];                // recovered settings_ptr
        cmp  rax, 0;
        jne  ime_whm_len_short;
        mov  r11, 10;
        jmp  ime_whm_len_store;
      ime_whm_len_short:
        mov  r11, 8;
      ime_whm_len_store:
        mov_d [r9 + 8], r11;

        mov  rax, r10;                     // restore WR result

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // Row 6: HOTKEY_LABEL read-only display.

  pub let ime_widget_hotkey_label : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): rdi/rsi already hold widget_label's row_id/rect_ptr positionally; text_offset/text_len are read from [settings+5]/[settings+8] BEFORE rdx is overwritten with text_offset for the call. Zero callee-save pushes (nothing survives past the single call); sub rsp,8/add rsp,8 bracket it, matching ime_settings_save's zero-push shape. widget_label returns unit, so this row always reports WR_NONE. Labels prefixed ime_whl_.",
      block: {
        sub  rsp, 8;

        mov_b r10, [rdx + 5];              // hotkey_mode
        mov_d r11, [rdx + 8];              // cached label length
        mov  rdx, r10;                     // text_offset
        mov  rcx, r11;                     // text_len
        call widget_label;

        add  rsp, 8;
        xor  rax, rax;                     // WR_NONE (label is non-interactive)
        ret
      }
    }

  // Row 7: DICT_LANG_LIST chip-row placeholder over the raw bitmask
  // (each of the low 8 bits names one IME_LANG_TABLE entry) -- no
  // multi-select chip primitive exists in widgets.pdx yet.

  pub let ime_widget_dict_lang_chips : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): dict_lang_bitmask at [settings+12] is u32-natural-width, passed DIRECTLY to widget_slider (no marshal step), same direct-pass posture as input.pdx's row0/row1 u32 fields. Zero callee-save pushes; sub rsp,8/add rsp,8 bracket the one call. Labels prefixed ime_wdl_.",
      block: {
        sub  rsp, 8;

        lea  rdx, [rdx + 12];              // &settings.dict_lang_bitmask
        mov  rcx, 0;                       // IME_LANG_BITMASK_MIN
        mov  r8, 255;                      // IME_LANG_BITMASK_MAX
        call widget_slider;

        add  rsp, 8;
        ret
      }
    }

  // Row 8: RESET_DEFAULTS button. On WR_CLICKED, resets the whole
  // struct and upgrades the return to WR_CHANGED so the caller's
  // `if r == WR_CHANGED { save }` contract fires -- a reset IS a change.

  pub let ime_widget_reset_defaults : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): settings_ptr preserved across the widget_button call in callee-saved rbx (adaptive_rate_render_frame's push-then-real-work-then-call shape); rdi/rsi already hold widget_button's row_id/rect_ptr positionally. Labels prefixed ime_wrd_.",
      block: {
        push rbx;
        mov  rbx, rdx;                     // settings_ptr survives the call

        xor  rdx, rdx;                     // label_offset = 0
        call widget_button;

        mov  r10, 2;                       // WR_CLICKED
        cmp  rax, r10;
        jne  ime_wrd_out;

        mov  rdi, rbx;                     // settings_ptr
        call ime_settings_apply_defaults;
        mov  rax, 4;                       // WR_CHANGED

      ime_wrd_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Panel: ime_settings_render.
  // ==========================================================================
  //
  // ime_settings_render(settings_ptr, ctx_row_id) -> WidgetResult.
  //
  // Refuses settings_ptr == 0 (silent, WR_NONE, IME_ST_REFUSED
  // bumped). Otherwise gates the WHOLE frame on ime_settings_layout_
  // precheck: if any of the 9 rows fails, NO widget paints this frame,
  // and the last-error cell records SIM_ROW_LAYOUT_FAIL (first render
  // ever, IME_ST_RENDERS==0) or SIM_REFUSED_DENSE (a later render,
  // after a prior success). On a pass, calls each of the 9 builders in
  // turn, tracking the running max WidgetResult as the aggregate.
  // Three callee-save pushes (rbx=settings_ptr, r12=ctx_row_id,
  // r13=aggregate) -- odd count, no sub needed -- matches widget_
  // button's proven push-only shape; row rects live in the shared
  // static _ime_row_rect, so no stack scratch is needed here either.

  pub let ime_settings_render : (u64, u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) (ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): render all 9 rows behind the atomic layout gate. Labels prefixed ime_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                     // settings_ptr
        mov  r12, rsi;                     // ctx_row_id

        cmp  rbx, 0;
        je   ime_rd_null;

        call ime_settings_layout_precheck;
        cmp  rax, 0;
        jne  ime_rd_layout_ok;

        // Atomic layout-gate failure: distinguish "never worked"
        // (ROW_LAYOUT_FAIL) from "broke after working" (REFUSED_
        // DENSE) using the CURRENT (pre-bump) IME_ST_RENDERS count.
        mov  rdi, 2;                       // IME_ST_RENDERS
        call ime_stat;
        cmp  rax, 0;
        jne  ime_rd_dense;

        lea  r10, [rip + _ime_last_error];
        mov  r11, 0xFFFFE94D;              // SIM_ROW_LAYOUT_FAIL
        mov  [r10 + 0], r11;
        jmp  ime_rd_gate_fail;

      ime_rd_dense:
        lea  r10, [rip + _ime_last_error];
        mov  r11, 0xFFFFE949;              // SIM_REFUSED_DENSE
        mov  [r10 + 0], r11;

      ime_rd_gate_fail:
        mov  rdi, 3;                       // IME_ST_REFUSED
        call ime_note;
        xor  rax, rax;                     // WR_NONE
        jmp  ime_rd_out;

      ime_rd_null:
        jmp  ime_rd_gate_fail;

      ime_rd_layout_ok:
        mov  rdi, 2;                       // IME_ST_RENDERS
        call ime_note;

        xor  r13, r13;                     // aggregate = WR_NONE

        // ----- Row 0: IME_ENABLED.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 20;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_enabled;
        cmp  rax, r13;
        jbe  ime_rd_row0_done;
        mov  r13, rax;
      ime_rd_row0_done:

        // ----- Row 1: PROVIDER_SELECTOR.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 48;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_provider;
        cmp  rax, r13;
        jbe  ime_rd_row1_done;
        mov  r13, rax;
      ime_rd_row1_done:

        // ----- Row 2: CANDIDATE_WINDOW_STYLE.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 76;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_window_style;
        cmp  rax, r13;
        jbe  ime_rd_row2_done;
        mov  r13, rax;
      ime_rd_row2_done:

        // ----- Row 3: LEARNING_TOGGLE.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 104;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_learning_toggle;
        cmp  rax, r13;
        jbe  ime_rd_row3_done;
        mov  r13, rax;
      ime_rd_row3_done:

        // ----- Row 4: LEARNING_HISTORY_DEPTH.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 132;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_history_depth;
        cmp  rax, r13;
        jbe  ime_rd_row4_done;
        mov  r13, rax;
      ime_rd_row4_done:

        // ----- Row 5: HOTKEY_MODE.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 160;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_hotkey_mode;
        cmp  rax, r13;
        jbe  ime_rd_row5_done;
        mov  r13, rax;
      ime_rd_row5_done:

        // ----- Row 6: HOTKEY_LABEL (read-only; never changes aggregate).
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 188;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_hotkey_label;

        // ----- Row 7: DICT_LANG_LIST.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 216;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_dict_lang_chips;
        cmp  rax, r13;
        jbe  ime_rd_row7_done;
        mov  r13, rax;
      ime_rd_row7_done:

        // ----- Row 8: RESET_DEFAULTS.
        lea  r10, [rip + _ime_row_rect];
        mov  rax, 244;
        mov_d [r10 + 4], rax;
        mov  rdi, r12;
        mov  rsi, r10;
        mov  rdx, rbx;
        call ime_widget_reset_defaults;
        cmp  rax, r13;
        jbe  ime_rd_row8_done;
        mov  r13, rax;
      ime_rd_row8_done:

        mov  rax, r13;                     // aggregate WidgetResult

      ime_rd_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Sample entry point: settings_ime_main.
  // ==========================================================================
  //
  // settings_ime_main() -> SIM_OK | SIM_NULL | SIM_UI_CTX_MINT_FAIL.
  // (1) ime_settings_load seeds the instance. (2) ui_context_new
  // (placeholder window=1, surface=1 -- no real KIND_WINDOW/SURFACE
  // cap exists yet, same posture as clock/timezone.pdx) mints the
  // context row. (3) IME_TICK_LIMIT (60) ticks of begin_frame/render/
  // save-if-changed/end_frame; a begin_frame refusal mid-loop just
  // stops the loop early (still SIM_OK -- render's own refusals
  // already collapse to WR_NONE). Three callee-save pushes (rbx=
  // settings_ptr, r12=ctx_row_id, r13=tick_counter) -- odd count, no
  // sub needed -- matches widget_button's proven push-only shape.

  pub let settings_ime_main : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): sample entry point -- load, mint, 60-tick render/save loop. Labels prefixed settings_ime_m_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call ime_settings_load;
        mov  rbx, rax;                     // settings_ptr
        cmp  rbx, 0;
        je   settings_ime_m_null;

        mov  rdi, 1;                       // IME_PLACEHOLDER_WINDOW
        mov  rsi, 1;                       // IME_PLACEHOLDER_SURFACE
        call ui_context_new;
        mov  r10, 8;                       // UI_MAX
        cmp  rax, r10;
        jae  settings_ime_m_ctx_fail;
        mov  r12, rax;                     // ctx_row_id

        xor  r13, r13;                     // tick = 0

      settings_ime_m_loop:
        cmp  r13, 60;                      // IME_TICK_LIMIT
        jae  settings_ime_m_done;

        mov  rdi, r12;
        call ui_context_begin_frame;
        cmp  rax, 0;
        jne  settings_ime_m_done;

        mov  rdi, rbx;                     // settings_ptr
        mov  rsi, r12;                     // ctx_row_id
        call ime_settings_render;

        mov  r10, 4;                       // WR_CHANGED
        cmp  rax, r10;
        jne  settings_ime_m_step;

        mov  rdi, rbx;
        call ime_settings_save;

      settings_ime_m_step:
        mov  rdi, r12;
        call ui_context_end_frame;

        add  r13, 1;
        jmp  settings_ime_m_loop;

      settings_ime_m_done:
        xor  rax, rax;                     // SIM_OK
        jmp  settings_ime_m_out;

      settings_ime_m_null:
        mov  rax, 0xFFFFE94F;              // SIM_NULL
        jmp  settings_ime_m_out;

      settings_ime_m_ctx_fail:
        mov  rdi, 3;                       // IME_ST_REFUSED
        call ime_note;
        mov  rax, 0xFFFFE94E;              // SIM_UI_CTX_MINT_FAIL

      settings_ime_m_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Boot init + fingerprint tag.
  // ==========================================================================
  //
  // Zeroes the stats vector + last-error cell at boot. The struct
  // instance itself is initialised by the first ime_settings_load call
  // (the first time the client opens the panel).

  pub let ime_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 (#2333): call through to ime_stats_reset for one clean counter zero-out. Labels prefixed ime_i_.",
      block: {
        call ime_stats_reset;
        ret
      }
    }

  // Data-only constant. Follows the pdx_kind_<name>_meta legacy-suffix
  // convention shared with widgets.pdx / input.pdx / display.pdx /
  // color.pdx. Needs a tools/verify-fingerprint-coverage.sh allowlist
  // entry with reason "Wave0-B15 G12-M3-002 (#2333) settings ime
  // sample panel; settings-service klog wire pending G12.M4" -- added
  // by this same landing.
  //
  // Length: "settings ime ready ok [legacy: SETTINGS IME READY OK]\0"
  //   = 53 characters + NUL = 54 bytes (strlen+1 rule).
  pub let pdx_kind_settings_ime_meta : [u8; 54] = "settings ime ready ok [legacy: SETTINGS IME READY OK]\0"
}
