// src/samples/settings/color.pdx -- Wave0-B13-09 (paideia-os #2334)
//
// G12.M3-003: SAMPLE APP -- SETTINGS -> COLOR + HDR PANEL.
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// (Developer APIs + first-party toolkit) and next-wave-synthesis.md
// line 99. This is the THIRD first-party sample settings panel landed
// on the paideia-ui immediate-mode toolkit (widgets.pdx, Wave0-B10-09,
// KIND_UI_CONTEXT=0x1D5). The first was Display+A11y (Wave0-B11-10,
// #2332); the second was Input+Keyboard (Wave0-B12, #2333). This
// third panel exposes color-management and HDR knobs bound to the
// KIND_REFERENCE_DISPLAY / KIND_HDR_METADATA / KIND_TONEMAP_LUT
// substrate landed in earlier waves.
//
// The panel owns a ColorSettings struct held in .bss, seeds it with
// defaults on load, paints an interactive panel via egui-shape widget
// calls every frame, and writes the (post-edit) struct back to
// /system/prefs/color.pdxpref on save. Both persistence sides remain
// STUBS in this landing: the file-backed store is a G12.M4 concern
// (settings service). What this file establishes is the same
// WIDGET-COMPOSITION SHAPE that display.pdx / input.pdx follow, so
// a future settings-service refactor can hoist all three panels onto
// one dispatch without touching per-panel code.
//
// NOVEL-CLEAN POSTURE. Same pattern as display.pdx: the panel is
// stateless, a pure function of the ColorSettings buffer plus the
// ui_context row's per-frame hover/click routing. Client frame loop:
//
//     ui_context_begin_frame(ctx);
//     let r = color_settings_render(&settings, ctx);
//     ui_context_end_frame(ctx);
//     if r == WR_CHANGED { color_settings_save(&settings); }
//
// Widget-return aggregation is a straight max across the individual
// widget results: if ANY widget returned WR_CHANGED this frame, the
// panel's aggregate return is WR_CHANGED. Otherwise WR_ACTIVE >
// WR_CLICKED > WR_HOVERED > WR_NONE by numeric ordering.
//
// -----------------------------------------------------------------------------
// ColorSettings LAYOUT -- 16 BYTES
// -----------------------------------------------------------------------------
//
//   [+0..+3]   color_profile_kind_id      : u32   (KIND_REFERENCE_DISPLAY cap;
//                                                  0 = system default)
//   [+4..+5]   hdr_peak_nits              : u16   (100..10000)
//   [+6..+7]   hdr_avg_nits               : u16   (100..1000)
//   [+8]       hdr_tonemap_mode           : u8    (0=BT.2408 Hable,
//                                                  1=Reinhard, 2=ACES, 3=None)
//   [+9]       night_light_enabled        : u8    (0 or 1)
//   [+10..+11] night_light_temp_k         : u16   (Kelvin, 2700..6500)
//   [+12]      night_light_start_hour     : u8    (0..23, wall-clock hour)
//   [+13]      night_light_end_hour       : u8    (0..23, wall-clock hour)
//   [+14]      blue_light_filter_strength : u8    (0..100 percent)
//   [+15]      _pad0                      : u8
//
// Naturally aligned per field, packs into a single 16-byte block
// (one x86_64 SSE line). The trailing padding byte leaves headroom
// for one additional u8 flag without changing struct size. All
// numeric fields use unsigned host byte order; there is no
// endianness marker because paideia-os is single-endianness
// (little-endian x86_64) and no settings blob crosses an ISA
// boundary.
//
// -----------------------------------------------------------------------------
// WIDGET COMPOSITION
// -----------------------------------------------------------------------------
//
// The panel emits nine widgets in a vertical stack at x=10, w=200,
// h=24, starting y=20 and stepping y+=28 per row. Rects are stack-
// allocated in color_settings_render's frame (16 bytes) and reused
// across widgets (each widget call reads x/y/w/h synchronously
// before the next update).
//
//   Row 0  y= 20  color_profile      -> widget_slider on the u32 field
//                                       (0..255 index stand-in for a
//                                       future dropdown widget landing
//                                       in G12.M2-004; the profile-id
//                                       is a KIND_REFERENCE_DISPLAY cap
//                                       resolved by the settings
//                                       service at save-time -- the
//                                       raw index is opaque to the
//                                       panel)
//   Row 1  y= 48  hdr_peak_nits      -> widget_slider (100..10000)
//   Row 2  y= 76  hdr_avg_nits       -> widget_slider (100..1000)
//   Row 3  y=104  hdr_tonemap_mode   -> widget_slider (0..3, stand-in
//                                       for a future dropdown)
//   Row 4  y=132  night_light_on     -> widget_checkbox
//   Row 5  y=160  night_light_temp   -> widget_slider (2700..6500)
//   Row 6  y=188  night_light_start  -> widget_slider (0..23)
//   Row 7  y=216  night_light_end    -> widget_slider (0..23)
//   Row 8  y=244  blue_light_filter  -> widget_slider (0..100)
//
// widget_slider works on a u32-shaped value_ptr and widget_checkbox
// on a u64-shaped state_ptr, while the ColorSettings fields are
// u32/u16/u8. Row 0 (u32 field) points widget_slider directly at
// the struct byte-range; the other rows MARSHAL each field to a
// stack scratch slot before the widget call and marshal back after.
// The marshal helpers (color_slider_u8 / color_slider_u16 /
// color_checkbox_u8) live in §Section 3 and mask the low N bits
// back into the struct byte on return; they do NOT touch bits
// above the field width, so the packing above stays intact even
// if a future field lands in the padding.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY  0xFFFFE910..0xFFFFE91F
// -----------------------------------------------------------------------------
//
// Band assignment per the batch brief. Grep at landing time confirms
// 0xFFFFE910..0xFFFFE91F is unclaimed across src/ and design/, sitting
// adjacent to display.pdx's 0xFFFFE900..0xFFFFE90F page for locality.
//
// The ColorSettings entry points either succeed (returning a
// WidgetResult, WR_NONE..WR_CHANGED, or 0 for save) or refuse
// silently by bumping _color_stats[COLOR_ST_REFUSED] and collapsing
// the return to WR_NONE / 0. The COLOR_* sentinels below are
// reserved for the future service-boundary promotion (G12.M4) where
// a settings-service dispatcher can surface a distinct error to a
// cross-process caller through op_status.
//
// -----------------------------------------------------------------------------
// ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Color (PascalCase of file basename
// color.pdx). Labels prefixed `color_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no `add reg,[mem]`, no float, no
// FPU. 32-bit loads use `mov_d` (zero-extending); 16-bit loads use
// `mov_w`; 8-bit loads use `mov_b`. Callee-save discipline: rbx/
// r12..r15 each pushed exactly once per function that uses them,
// keeping rsp%16 aligned before every nested call.

module Color = structure {

  // ==========================================================================
  // Section 1  Constants: layout, defaults, ranges, sentinels.
  // ==========================================================================

  // Struct layout offsets.
  pub let COLOR_STRUCT_BYTES         : u64 = 16
  pub let COLOR_OFF_PROFILE_KIND     : u64 = 0
  pub let COLOR_OFF_HDR_PEAK         : u64 = 4
  pub let COLOR_OFF_HDR_AVG          : u64 = 6
  pub let COLOR_OFF_HDR_TONEMAP      : u64 = 8
  pub let COLOR_OFF_NIGHT_ENABLED    : u64 = 9
  pub let COLOR_OFF_NIGHT_TEMP       : u64 = 10
  pub let COLOR_OFF_NIGHT_START      : u64 = 12
  pub let COLOR_OFF_NIGHT_END        : u64 = 13
  pub let COLOR_OFF_BLUE_STRENGTH    : u64 = 14

  // Defaults seeded on color_settings_load. 0 for profile means
  // "system default" and the settings service resolves it at save
  // time. HDR peak/avg defaults (1000/250) are the SDR-equivalent
  // reference-monitor floor advertised by KIND_HDR_METADATA. Tonemap
  // 0 = BT.2408 Hable, the ITU-recommended default. Night-light
  // window 21..06 is the astronomical-twilight-safe fallback the
  // KIND_CLOCK service advertises when a geolocation cap is
  // unavailable. Blue-light filter default 0 (off) is the
  // don't-surprise-the-user posture.
  pub let COLOR_DEFAULT_PROFILE      : u64 = 0
  pub let COLOR_DEFAULT_HDR_PEAK     : u64 = 1000
  pub let COLOR_DEFAULT_HDR_AVG      : u64 = 250
  pub let COLOR_DEFAULT_HDR_TONEMAP  : u64 = 0
  pub let COLOR_DEFAULT_NIGHT_ON     : u64 = 0
  pub let COLOR_DEFAULT_NIGHT_TEMP   : u64 = 4500
  pub let COLOR_DEFAULT_NIGHT_START  : u64 = 21
  pub let COLOR_DEFAULT_NIGHT_END    : u64 = 6
  pub let COLOR_DEFAULT_BLUE_STRENGTH: u64 = 0

  // Slider ranges (min inclusive, max inclusive). Widget clamp is
  // applied per call.
  pub let COLOR_PROFILE_MIN          : u64 = 0
  pub let COLOR_PROFILE_MAX          : u64 = 255
  pub let COLOR_HDR_PEAK_MIN         : u64 = 100
  pub let COLOR_HDR_PEAK_MAX         : u64 = 10000
  pub let COLOR_HDR_AVG_MIN          : u64 = 100
  pub let COLOR_HDR_AVG_MAX          : u64 = 1000
  pub let COLOR_TONEMAP_MIN          : u64 = 0
  pub let COLOR_TONEMAP_MAX          : u64 = 3
  pub let COLOR_NIGHT_TEMP_MIN       : u64 = 2700
  pub let COLOR_NIGHT_TEMP_MAX       : u64 = 6500
  pub let COLOR_NIGHT_HOUR_MIN       : u64 = 0
  pub let COLOR_NIGHT_HOUR_MAX       : u64 = 23
  pub let COLOR_BLUE_STRENGTH_MIN    : u64 = 0
  pub let COLOR_BLUE_STRENGTH_MAX    : u64 = 100

  // Panel layout constants (widget rects).
  pub let COLOR_PANEL_X              : u64 = 10
  pub let COLOR_PANEL_W              : u64 = 200
  pub let COLOR_PANEL_H              : u64 = 24
  pub let COLOR_ROW_Y0               : u64 = 20
  pub let COLOR_ROW_STEP             : u64 = 28

  // WidgetResult enum (mirrored from widgets.pdx §Section 1). Values
  // MUST match; caller aggregation depends on numeric ordering
  // (CHANGED > ACTIVE > CLICKED > HOVERED > NONE).
  pub let COLOR_WR_NONE              : u64 = 0
  pub let COLOR_WR_HOVERED           : u64 = 1
  pub let COLOR_WR_CLICKED           : u64 = 2
  pub let COLOR_WR_ACTIVE            : u64 = 3
  pub let COLOR_WR_CHANGED           : u64 = 4

  // Failure sentinels 0xFFFFE910..0xFFFFE91F. Reserved for a future
  // service-boundary promotion (G12.M4 settings service). Not
  // returned from the current entry points, which collapse refusal
  // to WR_NONE / 0 with a COLOR_ST_REFUSED bump.
  pub let COLOR_OK                   : u64 = 0
  pub let COLOR_BAD_PTR              : u64 = 0xFFFFE91F   // settings_ptr == 0
  pub let COLOR_BAD_CTX              : u64 = 0xFFFFE91E   // ctx_row_id invalid
  pub let COLOR_BAD_PREF             : u64 = 0xFFFFE91D   // /system/prefs/color.pdxpref malformed
  pub let COLOR_NO_STORE             : u64 = 0xFFFFE91C   // preferences store not yet mounted
  pub let COLOR_WRITE_FAIL           : u64 = 0xFFFFE91B   // save write returned nonzero
  pub let COLOR_BAD_PROFILE          : u64 = 0xFFFFE91A   // KIND_REFERENCE_DISPLAY cap resolve failed
  pub let COLOR_BAD_TONEMAP          : u64 = 0xFFFFE919   // KIND_TONEMAP_LUT cap resolve failed
  // 0xFFFFE910..0xFFFFE918 reserved for G12.M4 follow-ups.

  // ==========================================================================
  // Section 2  State: struct instance + counters.
  // ==========================================================================
  //
  // _color_settings holds THE ONE panel-owned ColorSettings instance.
  // A future multi-monitor / multi-user landing may promote this to
  // an arena keyed by user session; the current shape is single-
  // instance because there is one panel per client process and per-
  // user preferences are a separate concern (KIND_USER_PROFILE has
  // not yet been allocated).
  //
  // Sized to two u64 for the 16-byte struct (matches the natural
  // alignment on x86_64). @align(64) puts it on a cache line so a
  // save-then-reload cycle does not stall on a partial-line fill.

  pub let mut _color_settings : [u64; 2] = uninit @align(64)

  // Counter vector for smoke-witness observability. Four slots:
  //   [COLOR_ST_LOADS]    -- color_settings_load calls.
  //   [COLOR_ST_SAVES]    -- color_settings_save calls.
  //   [COLOR_ST_RENDERS]  -- color_settings_render calls.
  //   [COLOR_ST_REFUSED]  -- refused entry-point invocations.

  pub let mut _color_stats : [u64; 4] = uninit @align(64)

  pub let COLOR_ST_LOADS    : u64 = 0
  pub let COLOR_ST_SAVES    : u64 = 1
  pub let COLOR_ST_RENDERS  : u64 = 2
  pub let COLOR_ST_REFUSED  : u64 = 3

  pub let color_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): clear counter vector at boot. Four u64 slots. Labels prefixed color_sr_.",
      block: {
        lea r10, [rip + _color_stats];
        xor rax, rax;
        xor rcx, rcx;
      color_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  color_sr_top;
        ret
      }
    }

  pub let color_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed color_nt_.",
      block: {
        cmp rdi, 4;
        jae color_nt_out;
        lea r10, [rip + _color_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      color_nt_out:
        ret
      }
    }

  pub let color_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): counter read. Labels prefixed color_st_.",
      block: {
        cmp rdi, 4;
        jae color_st_zero;
        lea r10, [rip + _color_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      color_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Marshal helpers: struct byte <-> widget scratch slot.
  // ==========================================================================
  //
  // widget_slider reads/writes a u32 at [value_ptr+0]; widget_checkbox
  // reads/writes a u64 at [state_ptr+0]. The ColorSettings u8/u16
  // fields need marshalling through a stack scratch slot. The u32
  // profile field can be pointed at directly (no marshal helper
  // needed).

  // color_slider_u8(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u32 in a stack scratch slot,
  // invokes widget_slider on the scratch, writes the low 8 bits back
  // to *field_ptr. Padding bytes above the field are preserved via
  // byte-granular store.
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+3]  scratch u32 (widget_slider value_ptr)
  //   [rsp + 4..+7]  pad
  //   Callee-save pushes: rbx=field_ptr (needs to survive widget_slider).
  //   Entry rsp%16 == 8; push rbx (%16 == 0) then sub rsp,8 (%16 == 8);
  //   sub rsp,16 instead lands rsp%16 == 8 for the nested call --
  //   correct because widget_slider itself pushes further, restoring
  //   its own alignment. We use sub rsp,8 + one push to reach %16 == 0.

  pub let color_slider_u8 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): u8-field slider marshal. Pushes rbx (=field_ptr) then sub rsp,8 for the u32 scratch at [rsp+0]. Entry rsp%16 == 8, +8 push + 8 sub = %16 == 0 for the widget_slider call. Loads *field_ptr as byte via mov_b (zero-extending), stores into scratch as u32, calls widget_slider, then stores low 8 bits of scratch back to *field_ptr via mov_b (preserves neighbouring struct bytes). Labels prefixed color_su_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u8 -> scratch u32.
        mov_b rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        // rdi = ctx_row already; rsi = rect_ptr already; rdx = &scratch.
        lea  rdx, [rsp + 0];
        // rcx = min_val, r8 = max_val already in place per SysV.
        call widget_slider;
        // rax = WidgetResult.

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;                    // preserve widget result
        mov_d rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // color_slider_u16(ctx_row, rect_ptr, field_ptr, min_val, max_val)
  //   -> WidgetResult
  //
  // Same shape as color_slider_u8 but with a u16 field. mov_w is
  // used for the byte-range load/store. Scratch stays u32 (widget
  // slider ABI).

  pub let color_slider_u16 : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (field_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): u16-field slider marshal. Identical alignment shape to color_slider_u8. mov_w load/store preserves neighbouring bytes. Labels prefixed color_sw_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rdx;                    // field_ptr

        // Load *field_ptr as u16 -> scratch u32.
        mov_w rax, [rbx + 0];
        mov_d [rsp + 0], rax;

        // widget_slider(ctx_row, rect_ptr, &scratch, min, max).
        lea  rdx, [rsp + 0];
        call widget_slider;

        // Marshal back: low 16 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov_d rax, [rsp + 0];
        mov_w [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // color_checkbox_u8(ctx_row, rect_ptr, label_offset, field_ptr)
  //   -> WidgetResult
  //
  // Reads *field_ptr as u8, promotes to u64 in a stack scratch slot,
  // invokes widget_checkbox (which XORs bit 0 on click), stores low
  // 8 bits (0 or 1) back. widget_checkbox is tolerant of higher bits
  // in the scratch, so the promoted u8 value is loaded as-is.

  pub let color_checkbox_u8 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row: u64) (rect_ptr: u64) (label_offset: u64) (field_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): u8-field checkbox marshal. Push rbx (=field_ptr) then sub rsp,8 for u64 scratch at [rsp+0]. Load byte via mov_b, store u64, call widget_checkbox, store low 8 bits back via mov_b. Labels prefixed color_cb_.",
      block: {
        push rbx;
        sub  rsp, 8;
        mov  rbx, rcx;                    // field_ptr (arg 4 -> rcx)

        // Load *field_ptr as u8 -> scratch u64.
        mov_b rax, [rbx + 0];
        mov  [rsp + 0], rax;

        // widget_checkbox(ctx_row, rect_ptr, label_offset, &scratch).
        // rdi/rsi/rdx already in place.
        lea  rcx, [rsp + 0];
        call widget_checkbox;

        // Marshal back: low 8 bits of scratch -> *field_ptr.
        mov  r10, rax;
        mov  rax, [rsp + 0];
        mov_b [rbx + 0], rax;
        mov  rax, r10;

        add  rsp, 8;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Factory + persistence: load / save.
  // ==========================================================================
  //
  // color_settings_load() -> u64  (pointer to the static instance,
  //                                 populated with defaults)
  //
  // Zeros the _color_settings buffer, then writes the nine default
  // field values in place. Returns &_color_settings (the caller
  // treats this as an opaque pointer; do NOT free). A future landing
  // that reads /system/prefs/color.pdxpref will hook here to
  // override defaults with persisted values; the read path is a
  // G12.M4 concern (settings service). Bumps COLOR_ST_LOADS.

  pub let color_settings_load : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): populate _color_settings with defaults and return &_color_settings. Stub for the real persisted-load path (G12.M4). Single callee-save push (rbx=struct base) reaches rsp%16 == 0 for the color_note call. Labels prefixed color_ld_.",
      block: {
        push rbx;
        lea  rbx, [rip + _color_settings];

        // Zero the 16-byte block.
        xor  rax, rax;
        mov  [rbx + 0], rax;
        mov  [rbx + 8], rax;

        // Write each default field. Byte / word / dword stores
        // preserve packing; the zeroed base above means we only
        // touch the fields we set.
        mov  rax, 0;                      // COLOR_DEFAULT_PROFILE
        mov_d [rbx + 0], rax;             // color_profile_kind_id (u32)
        mov  rax, 1000;                   // COLOR_DEFAULT_HDR_PEAK
        mov_w [rbx + 4], rax;             // hdr_peak_nits (u16)
        mov  rax, 250;                    // COLOR_DEFAULT_HDR_AVG
        mov_w [rbx + 6], rax;             // hdr_avg_nits (u16)
        mov  rax, 0;                      // COLOR_DEFAULT_HDR_TONEMAP
        mov_b [rbx + 8], rax;             // hdr_tonemap_mode (u8)
        mov  rax, 0;                      // COLOR_DEFAULT_NIGHT_ON
        mov_b [rbx + 9], rax;             // night_light_enabled (u8)
        mov  rax, 4500;                   // COLOR_DEFAULT_NIGHT_TEMP
        mov_w [rbx + 10], rax;            // night_light_temp_k (u16)
        mov  rax, 21;                     // COLOR_DEFAULT_NIGHT_START
        mov_b [rbx + 12], rax;            // night_light_start_hour (u8)
        mov  rax, 6;                      // COLOR_DEFAULT_NIGHT_END
        mov_b [rbx + 13], rax;            // night_light_end_hour (u8)
        mov  rax, 0;                      // COLOR_DEFAULT_BLUE_STRENGTH
        mov_b [rbx + 14], rax;            // blue_light_filter_strength (u8)

        mov  rdi, 0;                      // COLOR_ST_LOADS
        call color_note;

        // Return &_color_settings.
        lea  rax, [rip + _color_settings];
        pop  rbx;
        ret
      }
    }

  // color_settings_save(settings_ptr: u64) -> u64
  //
  // Stub write-back. Returns 0 (success) after bumping COLOR_ST_
  // SAVES. Refuses settings_ptr == 0 by bumping COLOR_ST_REFUSED
  // and returning 0 (a future service-boundary landing may promote
  // this to COLOR_BAD_PTR). No actual disk write occurs -- the
  // /system/prefs/color.pdxpref path is a G12.M4 concern.

  pub let color_settings_save : (u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): stub save. Argument validated (non-null), then COLOR_ST_SAVES bumped; returns 0. Zero callee-save pushes needed (single nested call, entry rsp%16 == 8; sub rsp,8 aligns for the call). Labels prefixed color_sv_.",
      block: {
        cmp  rdi, 0;
        je   color_sv_refused;

        sub  rsp, 8;
        mov  rdi, 1;                      // COLOR_ST_SAVES
        call color_note;
        add  rsp, 8;

        xor  rax, rax;
        ret;

      color_sv_refused:
        sub  rsp, 8;
        mov  rdi, 3;                      // COLOR_ST_REFUSED
        call color_note;
        add  rsp, 8;
        xor  rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Panel: color_settings_render.
  // ==========================================================================
  //
  // color_settings_render(settings_ptr, ctx_row_id) -> WidgetResult
  //
  // Emits nine widgets in a vertical stack per §WIDGET COMPOSITION
  // above. Returns the maximum WidgetResult across all widget calls
  // this frame (numerically: WR_CHANGED > WR_ACTIVE > WR_CLICKED >
  // WR_HOVERED > WR_NONE). If ANY widget returned WR_CHANGED, the
  // panel's aggregate is WR_CHANGED and the caller should invoke
  // color_settings_save.
  //
  // Refuses settings_ptr == 0 (silent, WR_NONE, COLOR_ST_REFUSED
  // bumped). Refuses ctx_row_id >= UI_MAX by relying on each widget's
  // own gate (widgets collapse their internal refusal to WR_NONE and
  // bump widgets_st_REFUSED, which surfaces as "no widget interaction"
  // at the panel level).
  //
  // Stack layout after prologue (rsp%16 == 0):
  //   [rsp + 0..+15]  WidgetRect scratch (x/y/w/h as four i32).
  //   Callee-save pushes: rbx=settings_ptr, r12=ctx_row_id,
  //   r13=aggregate_result, r14=unused (reserved for future
  //   focus-tracking).
  //   Entry rsp%16 == 8; four pushes (%16 == 8) + sub rsp,16 (%16 == 8).
  //   To reach %16 == 0 for nested calls we sub rsp,24 (16 for the
  //   rect + 8 pad).

  pub let color_settings_render : (u64, u64) -> u64 !{mem} @{} =
    fn (settings_ptr: u64) (ctx_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): render panel. Four callee-save pushes + sub rsp,24 lands rsp%16 == 0 (entry %16 == 8; +32 push + 24 sub = %16 == 0). Rect scratch at [rsp+0..+15]. r13 holds the aggregate WidgetResult running max across all widget calls; individual widget returns are compared via unsigned cmp because WR_* values are 0..4. Aggregate 4 (WR_CHANGED) is the caller's cue to invoke save. Labels prefixed color_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 24;

        mov  rbx, rdi;                    // settings_ptr
        mov  r12, rsi;                    // ctx_row_id

        // Refuse NULL settings_ptr.
        cmp  rbx, 0;
        je   color_rd_refused;

        mov  rdi, 2;                      // COLOR_ST_RENDERS
        call color_note;

        xor  r13, r13;                    // aggregate = WR_NONE

        // Preload common rect fields (x/w/h are shared across rows).
        mov  rax, 10;                     // COLOR_PANEL_X
        mov_d [rsp + 0], rax;             // rect.x
        mov  rax, 200;                    // COLOR_PANEL_W
        mov_d [rsp + 8], rax;             // rect.w
        mov  rax, 24;                     // COLOR_PANEL_H
        mov_d [rsp + 12], rax;            // rect.h

        // ----- Row 0: color_profile_kind_id (u32 direct slider, no marshal).
        mov  rax, 20;                     // y0
        mov_d [rsp + 4], rax;
        mov  rdi, r12;                    // ctx_row
        lea  rsi, [rsp + 0];              // rect_ptr
        lea  rdx, [rbx + 0];              // &settings.color_profile_kind_id (u32)
        mov  rcx, 0;                      // COLOR_PROFILE_MIN
        mov  r8, 255;                     // COLOR_PROFILE_MAX
        call widget_slider;
        cmp  rax, r13;
        jbe  color_rd_row0_done;
        mov  r13, rax;
      color_rd_row0_done:

        // ----- Row 1: hdr_peak_nits (slider 100..10000).
        mov  rax, 48;                     // y0 + step
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 4];              // &settings.hdr_peak_nits (u16)
        mov  rcx, 100;                    // COLOR_HDR_PEAK_MIN
        mov  r8, 10000;                   // COLOR_HDR_PEAK_MAX
        call color_slider_u16;
        cmp  rax, r13;
        jbe  color_rd_row1_done;
        mov  r13, rax;
      color_rd_row1_done:

        // ----- Row 2: hdr_avg_nits (slider 100..1000).
        mov  rax, 76;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 6];              // &settings.hdr_avg_nits (u16)
        mov  rcx, 100;                    // COLOR_HDR_AVG_MIN
        mov  r8, 1000;                    // COLOR_HDR_AVG_MAX
        call color_slider_u16;
        cmp  rax, r13;
        jbe  color_rd_row2_done;
        mov  r13, rax;
      color_rd_row2_done:

        // ----- Row 3: hdr_tonemap_mode (slider 0..3).
        mov  rax, 104;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 8];              // &settings.hdr_tonemap_mode (u8)
        mov  rcx, 0;                      // COLOR_TONEMAP_MIN
        mov  r8, 3;                       // COLOR_TONEMAP_MAX
        call color_slider_u8;
        cmp  rax, r13;
        jbe  color_rd_row3_done;
        mov  r13, rax;
      color_rd_row3_done:

        // ----- Row 4: night_light_enabled (checkbox).
        mov  rax, 132;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        xor  rdx, rdx;                    // label_offset = 0 (font arena TBD)
        lea  rcx, [rbx + 9];              // &settings.night_light_enabled (u8)
        call color_checkbox_u8;
        cmp  rax, r13;
        jbe  color_rd_row4_done;
        mov  r13, rax;
      color_rd_row4_done:

        // ----- Row 5: night_light_temp_k (slider 2700..6500).
        mov  rax, 160;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 10];             // &settings.night_light_temp_k (u16)
        mov  rcx, 2700;                   // COLOR_NIGHT_TEMP_MIN
        mov  r8, 6500;                    // COLOR_NIGHT_TEMP_MAX
        call color_slider_u16;
        cmp  rax, r13;
        jbe  color_rd_row5_done;
        mov  r13, rax;
      color_rd_row5_done:

        // ----- Row 6: night_light_start_hour (slider 0..23).
        mov  rax, 188;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 12];             // &settings.night_light_start_hour (u8)
        mov  rcx, 0;                      // COLOR_NIGHT_HOUR_MIN
        mov  r8, 23;                      // COLOR_NIGHT_HOUR_MAX
        call color_slider_u8;
        cmp  rax, r13;
        jbe  color_rd_row6_done;
        mov  r13, rax;
      color_rd_row6_done:

        // ----- Row 7: night_light_end_hour (slider 0..23).
        mov  rax, 216;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 13];             // &settings.night_light_end_hour (u8)
        mov  rcx, 0;                      // COLOR_NIGHT_HOUR_MIN
        mov  r8, 23;                      // COLOR_NIGHT_HOUR_MAX
        call color_slider_u8;
        cmp  rax, r13;
        jbe  color_rd_row7_done;
        mov  r13, rax;
      color_rd_row7_done:

        // ----- Row 8: blue_light_filter_strength (slider 0..100).
        mov  rax, 244;
        mov_d [rsp + 4], rax;
        mov  rdi, r12;
        lea  rsi, [rsp + 0];
        lea  rdx, [rbx + 14];             // &settings.blue_light_filter_strength (u8)
        mov  rcx, 0;                      // COLOR_BLUE_STRENGTH_MIN
        mov  r8, 100;                     // COLOR_BLUE_STRENGTH_MAX
        call color_slider_u8;
        cmp  rax, r13;
        jbe  color_rd_row8_done;
        mov  r13, rax;
      color_rd_row8_done:

        mov  rax, r13;                    // aggregate WidgetResult
        jmp  color_rd_out;

      color_rd_refused:
        mov  rdi, 3;                      // COLOR_ST_REFUSED
        call color_note;
        xor  rax, rax;                    // WR_NONE

      color_rd_out:
        add  rsp, 24;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. The struct
  // instance itself is initialised by the first color_settings_load
  // call (which happens the first time the client opens the panel);
  // there is no need to seed defaults at boot before any consumer
  // exists.

  pub let color_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B13-09 (#2334): call through to color_stats_reset for one clean counter zero-out. Labels prefixed color_i_.",
      block: {
        call color_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the client once color_init has
  // been called and the first color_settings_load succeeds (G12.M4
  // klog wire will emit; until then this is a compile-time literal).
  // Follows the pdx_kind_<name>_meta legacy-suffix convention shared
  // with widgets.pdx / view_tree.pdx / immediate_context.pdx /
  // display.pdx.
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B13 G12.M3-003 (#2334) settings color + HDR
  // panel; settings-service klog wire pending G12.M4". The main
  // coordinator adds that allowlist entry at Batch 13 close-out.
  //
  // Length: "settings color ready ok [legacy: SETTINGS COLOR READY OK]\0"
  //   = 57 characters + NUL = 58 bytes (strlen+1 rule).
  pub let pdx_kind_settings_color_meta : [u8; 58] = "settings color ready ok [legacy: SETTINGS COLOR READY OK]\0"
}
