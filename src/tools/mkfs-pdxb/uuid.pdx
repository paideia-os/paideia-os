// src/tools/mkfs-pdxb/uuid.pdx -- R53.M1-005 (paideia-os #1734)
//
// PDXB VOLUME LIFECYCLE / mkfs-pdxb HOST BINARY -- DETERMINISTIC UUID
// DERIVATION MODULE.
//
// Design authority: design/tooling/volume-lifecycle-mechanism.md
//   §3.1  Path A host pre-format (recommended primary for R53) --
//         "the image is byte-identical for a given (size, uuid, key)
//         triple"; deterministic UUID is one leg of that triple.
//   §M1   milestone breakdown, item R53.M1-005: "Deterministic UUID
//         scheme: derive from --uuid or blake3(HEAD_hash)".
//
// -----------------------------------------------------------------------------
// SCOPE / SPLIT
// -----------------------------------------------------------------------------
//
// #1734 owns the UUID *scheme* only.  The mkfs-pdxb main body -- CLI
// argv walk, file open, superblock write, sig-key hash embed -- lives
// in sibling issues:
//
//   #1730  src/tools/mkfs-pdxb/main.pdx       (writes PDXB superblock
//                                               + regions; imports us)
//   #1731  tools/mkfs-pdxb.sh                 (dev-host wrapper)
//   #1732  tests/qemu/keys/pdxb-dev.mldsa65.* (dev signing key)  LANDED
//   #1733  main.pdx sig_key_hash embed        (--sig-key -> BLAKE3(pub))
//   #1734  THIS FILE                          (deterministic UUID)
//   #1735  host-side unit test                (python struct.unpack)
//
// The module surface below is intentionally the entire coupling
// point between this issue and #1730's main.pdx: everything else
// (Linux open/read/write/exit syscalls, argv marshalling, superblock
// layout) is main.pdx's problem.  A pure-computation split like this
// keeps the coordinated file (main.pdx) free of #1734 conflicts and
// makes the UUID scheme host-side unit-testable in isolation (#1735).
//
// -----------------------------------------------------------------------------
// WIRE FORMAT
// -----------------------------------------------------------------------------
//
// A PDXB volume UUID is a 16-byte binary value stored at
//   superblock.uuid[0..16]
// per design/filesystem/volume-fs-substrate.md §2.1 -- superblock
// layout, UUID field at PDXB_SB_UUID_OFFSET = 8 (16 bytes wide);
// see src/kernel/core/fs/pdxfs/superblock_fmt.pdx L118 for the
// canonical offset constant that main.pdx uses when it stamps the
// 16 bytes produced by this module.  Two textual encodings are
// accepted on the mkfs CLI:
//
//   (a) BARE HEX -- 32 lowercase or uppercase hex chars, no separators.
//                    e.g.  "0123456789abcdef0123456789abcdef".
//                    Bytes 0..16 are the pairs left-to-right; byte 0 is
//                    the leftmost hex pair.
//
//   (b) DASHED   -- RFC 4122 canonical 36-char form
//                    "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx".
//                    Dashes at fixed positions 8, 13, 18, 23; the
//                    remaining 32 chars decode left-to-right the same
//                    way as (a).  The variant / version nibbles are
//                    NOT enforced -- this scheme accepts any 128-bit
//                    value; strict RFC 4122 v4 enforcement is a
//                    softarch policy call, not a wire requirement.
//
// The 36-char dashed form is what most humans copy from `uuidgen(1)`
// output and what mkfs-pdxb echoes back on stdout (§ CLI-echo below).
// The 32-char bare form is what CI produces from
// `openssl rand -hex 16` and what scripts prefer.
//
// -----------------------------------------------------------------------------
// DERIVATION MODES
// -----------------------------------------------------------------------------
//
// mkfs-pdxb picks the volume UUID in this precedence order (main.pdx
// implements the argv walk; this module implements the primitives):
//
//   1. `--uuid <text>` PRESENT   -- parse_uuid_arg() decodes it into
//                                    16 bytes.  Parse error -> exit(2)
//                                    with a UUID PARSE ERROR line on
//                                    stderr.  Absent optional value ->
//                                    treated as parse error (main).
//
//   2. `--uuid` ABSENT + git HEAD sha available (main.pdx reads
//      .git/HEAD -> refs/heads/<branch> -> refs/heads/<branch> content,
//      or invokes `git rev-parse HEAD` via a Linux execve; the wrapper
//      #1731 mkfs-pdxb.sh will typically pre-resolve this and pass
//      --head-sha <40hex> so the mkfs binary itself needs no fork/exec)
//      -> derive_uuid_from_head_sha() runs BLAKE3 over the ASCII SHA
//         and truncates the first 16 bytes of the 32-byte digest.
//
//   3. `--uuid` ABSENT + no HEAD sha available (detached-tree, tarball
//      build, missing .git) -> derive_uuid_from_head_sha() is called
//      with sha_len==0 and takes the same STUB path as (4) below, so
//      main.pdx does not need a separate branch.
//
//   4. BLAKE3 primitive UNAVAILABLE (current state -- confirmed gap in
//      paideia-as v0.20 per src/kernel/core/fs/pdxfs/sig_verify.pdx
//      §"HARD BLOCKER" and paideia-as RELEASE-NOTES-v0.20 PA-R20-008)
//      -> uuid_stub_fill_zero() writes 16 zero bytes and the caller
//         is expected to emit a "PDXB UUID STUB" warning line to
//         stderr; return value of derive_uuid_from_head_sha() encodes
//         this (rax == 1) so main.pdx can gate the warning without
//         re-deciding blake3 availability itself.
//
// -----------------------------------------------------------------------------
// BLAKE3 PRIMITIVE
// -----------------------------------------------------------------------------
//
// The real derivation intended for post-v0.21-paideia-as:
//
//   blake3_hash32(msg_ptr : *u8, msg_len : u64, out_ptr : *u8) -> ()
//
// with out_ptr writing exactly 32 bytes (the full 256-bit digest).
// The UUID takes bytes [0..16); the remaining 16 bytes are discarded.
// Truncation is safe: BLAKE3 is a wide-pipe hash and any 128-bit
// prefix retains cryptographic collision resistance to the birthday
// bound on 2^64 messages -- vastly more than the number of git
// commit SHAs across the project's lifetime.
//
// This module OCCUPIES the derivation entry point with a stub that
// always takes the zero-fill path.  When paideia-as ships
// blake3_hash32, only derive_uuid_from_head_sha's body changes; the
// symbol name, arity, effect set, and return-value contract stay
// identical.  Main.pdx's dispatch does not have to know.  This
// mirrors the pattern src/kernel/core/fs/pdxfs/sig_verify.pdx used
// for sig_hash_verify_stub -- fail-visible, symbol-stable.
//
// -----------------------------------------------------------------------------
// CLI-ECHO (main.pdx contract)
// -----------------------------------------------------------------------------
//
// After the UUID is decided, main.pdx echoes it to stdout in the
// 36-char dashed form on its own line, prefixed with a stable tag
// so wrapper scripts can grep it:
//
//   PDXB UUID: <xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx>\n
//
// This module exposes uuid_format_dashed() to render those 36 bytes;
// main.pdx handles the "PDXB UUID: " prefix, the trailing newline,
// and the sys_write(1, ...) call.  The wrapper (#1731) captures this
// line and stashes it in the smoke log for later replay diagnostics
// (comparing "which UUID did we mkfs with" against the boot-time
// probe's "PDXB VOLUME MOUNTED uuid=<hex>" fingerprint from §4).
//
// -----------------------------------------------------------------------------
// REGISTER DISCIPLINE
// -----------------------------------------------------------------------------
//
// This binary is a HOST-SIDE (Linux) tool per §3.1.  All entry points
// obey the SysV AMD64 calling convention as consumed by main.pdx:
//   args   : rdi, rsi, rdx, rcx, r8, r9
//   return : rax
//   preserved: rbx, rbp, r12..r15, rsp
//   clobbered: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
// Callee-saved regs (rbx, r12..r15) are pushed/popped where used --
// same shape as init.pdx print_u64_dec (r12/r13 hold buf/sz across
// syscalls) and shell.pdx shell_read_line.

module MkfsPdxbUuid = structure {

  // -------------------------------------------------------------------
  // CONSTANTS
  // -------------------------------------------------------------------

  // 16 bytes on the wire in the superblock (design/filesystem/
  // volume-fs-substrate.md §2.1).
  pub let UUID_BYTES : u64 = 16

  // 32-char accepted CLI form (bare hex).
  pub let UUID_HEX32_LEN : u64 = 32

  // 36-char accepted CLI form (dashed).  Also the width of the
  // uuid_format_dashed() output buffer.
  pub let UUID_DASHED_LEN : u64 = 36

  // Return codes from parse / derive entry points.
  //   0  -- success (parsed / derived real 16 bytes)
  //   1  -- STUB path (zero-fill; blake3 unavailable OR sha_len == 0)
  //  -1  -- parse error (wrong length, non-hex char, misplaced dash)
  //
  // Encoded as sign-preserving 64-bit values in rax.  Main.pdx uses
  // `cmp rax, 0` / `jl` for the error branch and `cmp rax, 0` / `jg`
  // for the stub-warning branch.
  pub let UUID_OK         : u64 = 0
  pub let UUID_STUB       : u64 = 1
  pub let UUID_PARSE_FAIL : u64 = 0xFFFFFFFFFFFFFFFF   // (i64) -1

  // Positions where a well-formed dashed UUID must have '-'.
  // Consumed only by parse_dashed.  Encoded as a length-4 byte array
  // so the loop can index it with r10 rather than four cmp arms.
  pub let dash_positions : [u8; 4] = [8u8, 13u8, 18u8, 23u8]

  // Lookup table for the low nibble of a 4-bit value -> lowercase
  // ASCII hex digit ('0'..'9', 'a'..'f').  Used by uuid_format_dashed.
  // 16 bytes; index by nibble (0..15).
  pub let hex_lut : [u8; 16] = "0123456789abcdef"

  // "PDXB UUID STUB (blake3 unavailable, HEAD sha not hashed)\n"
  // Emitted to stderr by main.pdx when derive_uuid_from_head_sha
  // returns UUID_STUB.  Kept as a module rodata literal so both
  // main.pdx and the #1735 host-side unit test can reference the
  // same symbol (grep-anchor discipline: golden files match a stable
  // literal, never a rebuilt string).
  //
  // 56 wire bytes + 1 NUL = 57 bytes rodata.  sys_write(2, ptr, 56)
  // is the intended shape.
  pub let uuid_stub_warn_msg : [u8; 57] =
    "PDXB UUID STUB (blake3 unavailable, HEAD sha not hashed)\n\0"
  pub let uuid_stub_warn_len : u64 = 56

  // "PDXB UUID PARSE ERROR\n" -- emitted to stderr by main.pdx when
  // parse_uuid_arg returns UUID_PARSE_FAIL.  22 wire bytes.
  pub let uuid_parse_err_msg : [u8; 23] = "PDXB UUID PARSE ERROR\n\0"
  pub let uuid_parse_err_len : u64 = 22

  // -------------------------------------------------------------------
  // hex_char_to_nibble : (u8) -> i32
  //
  // rdi = char (low byte).  rax = 0..15 on hit, or -1 (0xFFFF...FFFF)
  // on non-hex.  Accepts '0'..'9', 'a'..'f', 'A'..'F'.
  //
  // Branchless-ish structure: three range compares + three subtracts.
  // Leaf, no memory, no syscalls -- @no_frame.
  //
  // STRICTER-THAN-SYSV CLOBBER CONTRACT: this function reads rdi
  // (low byte only) and writes ONLY rax.  It does not touch any
  // other GPR -- SysV caller-save registers (rcx, rdx, rsi, r8, r9,
  // r10, r11) are preserved de facto by the body's shape (three
  // cmp+sub arms and a fall-through -1 arm, no aux state).
  //
  // parse_dashed RELIES on this stricter contract to hold r10 (half-
  // byte state) and r11 (hi-nibble accumulator) across its per-char
  // decode call: those regs are caller-save under baseline SysV, so
  // a future edit to hex_char_to_nibble that starts using r10 or
  // r11 (e.g. adding a lookup-table load into r10) would silently
  // corrupt parse_dashed's FSM.  If this leaf gains any auxiliary
  // register use, parse_dashed's r10/r11 must migrate to callee-save
  // regs (add push rbp + stack-slot spill for hi-nibble) in the same
  // edit.  Same rule for any other future caller.
  // -------------------------------------------------------------------
  pub let hex_char_to_nibble : (u8) -> u64 !{} @{} =
    fn (c : u8) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R53.M1-005 (#1734): decode one ASCII hex digit. Pure, leaf, no memory: rdi (low byte) -> rax in 0..15 or -1 on non-hex. Ordered as digits-first because a well-formed input is hex-digit-dominated (each dashed UUID has 32 hex + 4 dashes; each bare has 32 hex + 0 dashes). Range compares use unsigned semantics -- '0'..'9' = 0x30..0x39; 'A'..'F' = 0x41..0x46; 'a'..'f' = 0x61..0x66; each range is non-overlapping so an early hit can return without checking the other two. Writes only rax; see the header block above for the stricter-than-SysV clobber contract parse_dashed depends on.",
      block: {
        // Isolate the low byte via and-mask (matches G4-posture idiom
        // in kernel/acpi/gas.pdx: xor rN, rN + mov_b rN, [mem] for
        // memory; and rN, 0xFF for a caller-supplied register).
        mov rax, rdi;
        and rax, 0xFF;

        // Digit '0'..'9' -> return al - 0x30.
        cmp rax, 0x30;
        jl hcn_not_digit;
        cmp rax, 0x39;
        jg hcn_not_digit;
        sub rax, 0x30;
        ret;

      hcn_not_digit:
        // Lowercase 'a'..'f' -> return al - 0x61 + 10.
        cmp rax, 0x61;
        jl hcn_not_lower;
        cmp rax, 0x66;
        jg hcn_not_lower;
        sub rax, 0x57;                  // 0x61 - 10 = 0x57
        ret;

      hcn_not_lower:
        // Uppercase 'A'..'F' -> return al - 0x41 + 10.
        cmp rax, 0x41;
        jl hcn_fail;
        cmp rax, 0x46;
        jg hcn_fail;
        sub rax, 0x37;                  // 0x41 - 10 = 0x37
        ret;

      hcn_fail:
        // Sign-extend -1 into rax.
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // -------------------------------------------------------------------
  // parse_hex32 : (*u8, *u8) -> u64
  //
  // Decode 32 hex chars starting at rdi into 16 bytes at rsi.  Returns
  // UUID_OK (0) on success, UUID_PARSE_FAIL (-1) if any of the 32
  // chars is non-hex.  Byte order: chars [0..2) -> byte 0, [2..4) ->
  // byte 1, ... [30..32) -> byte 15.  High nibble first inside each
  // pair (standard hex).
  //
  // r12 = in_ptr cursor (callee-save; hex_char_to_nibble may clobber).
  // r13 = out_ptr cursor (same).
  // r14 = pair-index counter 0..16 (same).
  // -------------------------------------------------------------------
  pub let parse_hex32 : (*u8, *u8) -> u64 !{mem} @{} =
    fn (in_ptr : *u8) (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): decode 32 hex chars at rdi into 16 bytes at rsi. Pair-loop: 16 iterations, each reads two chars via hex_char_to_nibble, checks both for -1, composes (hi << 4) | lo, stores at [r13]. Early exit on non-hex (rax = UUID_PARSE_FAIL). {mem} for the 32 in-bytes read and the 16 out-bytes written. Four callee-save regs, all pushed once at prologue: r12 = in cursor, r13 = out cursor, r14 = pair counter, r15 = hi-nibble stash across the low-nibble hex_char_to_nibble call (that call clobbers rax, rcx, rdx, rsi, rdi, r8..r11 per SysV; r15 survives).",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        // SysV alignment: entry rsp % 16 == 8; 4 pushes = 32 bytes so
        // rsp % 16 == 8 still.  hex_char_to_nibble call requires
        // rsp % 16 == 0 at the call site; sub rsp, 8 brings us to 0.
        // Epilogue restores with add rsp, 8 before pops.
        sub rsp, 8;

        mov r12, rdi;                   // in cursor
        mov r13, rsi;                   // out cursor
        xor r14, r14;                   // pair index (0..16)

      ph32_top:
        cmp r14, 16;
        jge ph32_ok;

        // High nibble: xor + mov_b idiom (G4 posture, matches
        // kernel/acpi/gas.pdx and kernel/core/pci/publish.pdx).
        xor rdi, rdi;
        mov_b rdi, [r12];
        call hex_char_to_nibble;
        cmp rax, 0;
        jl ph32_fail;
        shl rax, 4;
        mov r15, rax;                   // r15 = hi << 4

        // Low nibble.
        xor rdi, rdi;
        mov_b rdi, [r12 + 1];
        call hex_char_to_nibble;
        cmp rax, 0;
        jl ph32_fail;
        or  rax, r15;                   // rax = (hi << 4) | lo

        // Byte store: mov_b [mem], reg (G1 sized-store posture; the
        // qword-sized `mov [r13], al` bare form is not portable to
        // paideia-as v0.20's encoder).
        mov_b [r13], rax;
        add r12, 2;
        add r13, 1;
        add r14, 1;
        jmp ph32_top;

      ph32_ok:
        xor rax, rax;                   // UUID_OK
        add rsp, 8;                     // undo alignment slot
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      ph32_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;    // UUID_PARSE_FAIL
        add rsp, 8;                     // undo alignment slot
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // -------------------------------------------------------------------
  // parse_dashed : (*u8, *u8) -> u64
  //
  // Decode 36 dashed-form chars at rdi into 16 bytes at rsi.  Dashes
  // must be at positions 8, 13, 18, 23; every other position must be
  // hex.  Returns UUID_OK (0) or UUID_PARSE_FAIL (-1).
  //
  // Strategy: walk 36 input positions with a counter (r14), track the
  // 16-byte output byte index (r15), track a "next expected dash
  // position" cursor (r10 -> byte in dash_positions[]).  At each
  // input position, if r14 matches the next dash pos, require '-' and
  // advance the dash cursor; otherwise consume a hex-nibble pair.
  //
  // Note: nibble-pair consumption inside the loop reads TWO input
  // bytes at once but only advances r14 by 1 per iteration -- we
  // accumulate the half-byte state in r9 (0 = expect high nibble,
  // 1 = expect low nibble).  This keeps the loop counter aligned
  // with the "next dash pos" check while still packing bytes right.
  // -------------------------------------------------------------------
  pub let parse_dashed : (*u8, *u8) -> u64 !{mem} @{} =
    fn (in_ptr : *u8) (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): decode 36-char dashed UUID at rdi into 16 bytes at rsi. Single loop over 36 input positions. State: r12 = in_ptr cursor, r13 = out_ptr cursor, r14 = input pos 0..36, r15 = output pos 0..16, rbx = dash-array index 0..4, r10 = half-byte state (0 hi / 1 lo), r11 = accumulator for the high nibble across the two-call span. On dash-position hit, verifies '-' and advances rbx; on hex-position hit, decodes via hex_char_to_nibble and either stashes hi (r10 flips 0->1) or composes byte and stores (r10 flips 1->0, r15 advances). Fail on any non-'-' at dash pos, any '-' at hex pos, any non-hex char, or wrong terminal count. r10/r11 are held across the hex_char_to_nibble call under that function's STRICTER-THAN-SYSV clobber contract (see its header block: writes only rax); any future edit to hex_char_to_nibble that starts using r10/r11 MUST migrate this FSM's state to callee-save regs (add push rbp + stack spill for the hi-nibble) in the same edit. {mem} for the 36 in-bytes read + 16 out-bytes written. All 5 available callee-save regs pushed.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                   // in_ptr
        mov r13, rsi;                   // out_ptr
        xor r14, r14;                   // input pos = 0
        xor r15, r15;                   // output pos = 0
        xor rbx, rbx;                   // dash-array index = 0
        xor r10, r10;                   // half-byte state = hi
        xor r11, r11;                   // hi-nibble accumulator

      pd_top:
        cmp r14, 36;
        jge pd_check_done;

        // Is the current input position a scheduled dash position?
        // If dash_positions[rbx] == r14b, this is a dash slot.
        cmp rbx, 4;
        jge pd_hex_slot;                // no more scheduled dashes

        lea r8, [rip + dash_positions];
        xor r9, r9;
        mov_b r9, [r8 + rbx];
        cmp r9, r14;
        jne pd_hex_slot;

        // Dash slot: require '-' (0x2D) at [r12], advance both.
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x2D;
        jne pd_fail;
        add rbx, 1;
        add r12, 1;
        add r14, 1;
        jmp pd_top;

      pd_hex_slot:
        // Hex slot: decode one nibble.
        xor rdi, rdi;
        mov_b rdi, [r12];
        call hex_char_to_nibble;
        cmp rax, 0;
        jl pd_fail;

        cmp r10, 0;
        jne pd_low_nibble;

        // High-nibble branch: stash and flip state.
        shl rax, 4;
        mov r11, rax;
        mov r10, 1;
        jmp pd_advance;

      pd_low_nibble:
        // Low-nibble branch: compose (r11 | rax) -> byte, store, flip
        // state, advance out cursor.
        or  rax, r11;
        mov_b [r13], rax;
        add r13, 1;
        add r15, 1;
        xor r10, r10;                   // state -> hi

      pd_advance:
        add r12, 1;
        add r14, 1;
        jmp pd_top;

      pd_check_done:
        // Well-formed terminal state: exactly 16 bytes written, 4
        // dashes consumed, half-byte state back to hi.
        cmp r15, 16;
        jne pd_fail;
        cmp rbx, 4;
        jne pd_fail;
        cmp r10, 0;
        jne pd_fail;

        xor rax, rax;                   // UUID_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pd_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;    // UUID_PARSE_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // -------------------------------------------------------------------
  // parse_uuid_arg : (*u8, u64, *u8) -> u64
  //
  // Dispatch entry consumed by main.pdx.  rdi = ptr to argv value
  // (the raw text after --uuid), rsi = length of that text, rdx =
  // output 16-byte buffer.  Length dispatch:
  //   32 -> parse_hex32
  //   36 -> parse_dashed
  //   *  -> UUID_PARSE_FAIL
  //
  // Returns UUID_OK (0) or UUID_PARSE_FAIL (-1).  Never returns
  // UUID_STUB (that is only a derive-side outcome).
  // -------------------------------------------------------------------
  pub let parse_uuid_arg : (*u8, u64, *u8) -> u64 !{mem} @{} =
    fn (arg_ptr : *u8) (arg_len : u64) (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): --uuid argv dispatcher. Length-based branch to parse_hex32 (32) or parse_dashed (36); reject other lengths as UUID_PARSE_FAIL. Both parsers take (in_ptr, out_ptr) in (rdi, rsi) -- reorder: out_ptr is rdx here but rsi at the callees, so mov rsi, rdx before jmp. Tail-jumped (jmp not call) so the callee's ret returns straight to main.pdx; no stack frame needed.",
      block: {
        // Fast paths.
        cmp rsi, 32;
        je pua_hex32;
        cmp rsi, 36;
        je pua_dashed;

        // Reject any other length.
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;

      pua_hex32:
        mov rsi, rdx;                   // out_ptr -> rsi (parse_hex32 arg 2)
        jmp parse_hex32;

      pua_dashed:
        mov rsi, rdx;                   // out_ptr -> rsi (parse_dashed arg 2)
        jmp parse_dashed
      }
    } @no_frame

  // -------------------------------------------------------------------
  // uuid_stub_fill_zero : (*u8) -> ()
  //
  // Write 16 zero bytes to rdi.  Used both from
  // derive_uuid_from_head_sha's STUB tail and from main.pdx if it
  // wants to pre-clear the superblock UUID field before either arm
  // populates it.
  //
  // Two 8-byte stores; unrolled -- no loop needed for a fixed 16-byte
  // sink.  Leaf, @no_frame.
  // -------------------------------------------------------------------
  pub let uuid_stub_fill_zero : (*u8) -> () !{mem} @{} =
    fn (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): zero-fill 16-byte UUID output. Two 8-byte stores at [rdi] and [rdi+8]. Leaf, no callee-save touched, no frame.",
      block: {
        xor rax, rax;
        mov [rdi], rax;
        mov [rdi + 8], rax;
        ret
      }
    } @no_frame

  // -------------------------------------------------------------------
  // derive_uuid_from_head_sha : (*u8, u64, *u8) -> u64
  //
  // rdi = ptr to ASCII SHA (typically 40 hex chars from `git rev-parse
  // HEAD`), rsi = length (accepts any length >= 0; the primitive is
  // length-agnostic), rdx = output 16-byte buffer.
  //
  // Returns:
  //   UUID_OK   (0) -- BLAKE3 primitive ran; first 16 bytes of the
  //                    32-byte digest are at [rdx..rdx+16).
  //   UUID_STUB (1) -- BLAKE3 primitive unavailable OR sha_len == 0;
  //                    [rdx..rdx+16) is zero-filled.  Caller emits
  //                    the "PDXB UUID STUB" warning line to stderr.
  //
  // Current implementation: STUB path unconditionally, per the gap
  // analysis in this module's header.  When paideia-as ships
  // blake3_hash32, the body's block-scope is edited to (a) allocate
  // a 32-byte stack scratch, (b) call blake3_hash32(sha_ptr, sha_len,
  // scratch_ptr), (c) memcpy the first 16 bytes to rdx, (d) return
  // UUID_OK.  No signature change.
  // -------------------------------------------------------------------
  pub let derive_uuid_from_head_sha : (*u8, u64, *u8) -> u64 !{mem} @{} =
    fn (sha_ptr : *u8) (sha_len : u64) (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): derive 16-byte UUID from BLAKE3(HEAD sha). STUB path: paideia-as v0.20 does not ship blake3_hash32 (confirmed gap; see this module's header and src/kernel/core/fs/pdxfs/sig_verify.pdx §HARD BLOCKER). Behavior until v0.21 ships: zero-fill the 16 output bytes and return UUID_STUB (1) so main.pdx can emit the visible warning line. When blake3_hash32 lands, this body swaps to allocate a 32-byte stack buffer, call blake3_hash32(rdi, rsi, buf), memcpy 16 bytes to [rdx], return UUID_OK -- no signature change. Sig_len == 0 path (no HEAD sha available: detached tree, tarball build) folds into the same stub tail so main.pdx does not need a second branch. {mem} declared conservatively for the eventual scratch buffer + copy. sub rsp, 8 aligns for the uuid_stub_fill_zero call site (entry rsp % 16 == 8; no pushes above the call; the sub brings rsp to 0 mod 16 so callee entry lands at 8 mod 16 per SysV).",
      block: {
        sub rsp, 8;                     // SysV alignment for the call

        // Zero the output (delegates the two stores to uuid_stub_fill_zero
        // to keep the store shape in one place -- if the field ever grows
        // beyond 16 bytes, both call sites move together).
        mov rdi, rdx;                   // arg 1 = out_ptr
        call uuid_stub_fill_zero;

        add rsp, 8;                     // undo alignment slot

        // Report STUB outcome to caller.
        mov rax, 1;                     // UUID_STUB
        ret
      }
    }

  // -------------------------------------------------------------------
  // uuid_format_dashed : (*u8, *u8) -> ()
  //
  // Render the 16-byte UUID at rdi into 36 dashed-form ASCII bytes
  // at rsi.  Dashes placed at output positions 8, 13, 18, 23; hex
  // digits are lowercase.  Output buffer MUST have room for 36 bytes;
  // no trailing NUL is written (the caller composes the "PDXB UUID: "
  // prefix + newline + sys_write frame around it).
  //
  // Implementation: walk the 16 input bytes; for each, look up
  // hi_nibble and lo_nibble via hex_lut; interleave dash emissions
  // by consulting dash_positions[] against the running output
  // cursor.  Fewer branches than a "byte i -> output j+dashes"
  // arithmetic formula and keeps the dash-position source-of-truth
  // in one place (dash_positions).
  // -------------------------------------------------------------------
  pub let uuid_format_dashed : (*u8, *u8) -> () !{mem} @{} =
    fn (uuid_ptr : *u8) (out_ptr : *u8) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M1-005 (#1734): render 16-byte UUID to 36 dashed ASCII bytes. Loop over 16 input bytes; per byte, emit hi-nibble hex, lo-nibble hex, then consult dash_positions[] to insert a '-' if the running output cursor matches. Two-pass structure inside the loop: (a) always emit two nibbles (advances r13 by 2); (b) check if (r13 - r15) now matches dash_positions[rbx] and emit '-' if so. Terminates after byte 15 with output cursor at 36 (dashes at 8, 13, 18, 23 give 16*2 + 4 = 36 bytes; dashes fall AFTER the 4th, 6th, 8th, 10th nibble slots which correspond exactly to those output positions). Five callee-save regs pushed at prologue: rbx = dash-array index, r12 = in cursor, r13 = out cursor, r14 = input byte index, r15 = out base (survives across any future call insertion; SysV rsi/rdi are caller-save so a base held in a callee-save reg is future-proof against edits that add helper calls in the loop body).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                   // in cursor (16 bytes)
        mov r13, rsi;                   // out cursor
        mov r15, rsi;                   // out base (for offset calc)
        xor r14, r14;                   // input byte index (0..16)
        xor rbx, rbx;                   // dash-array index (0..4)

      fd_top:
        cmp r14, 16;
        jge fd_done;

        // Load byte via xor + mov_b, split hi/lo, look up via hex_lut.
        xor rax, rax;
        mov_b rax, [r12];               // rax = byte (zero-extended)

        mov  r8, rax;
        shr  r8, 4;                     // r8 = hi nibble
        and  rax, 0x0F;                 // rax = lo nibble

        lea  r9, [rip + hex_lut];

        xor  r10, r10;
        mov_b r10, [r9 + r8];
        mov_b [r13], r10;               // emit hi hex
        add  r13, 1;

        xor  r10, r10;
        mov_b r10, [r9 + rax];
        mov_b [r13], r10;               // emit lo hex
        add  r13, 1;

        add  r12, 1;
        add  r14, 1;

        // Current output length relative to out base.
        mov  rax, r13;
        sub  rax, r15;

        cmp  rbx, 4;
        jge  fd_top;                    // no more dashes scheduled

        lea  r9, [rip + dash_positions];
        xor  r10, r10;
        mov_b r10, [r9 + rbx];
        cmp  r10, rax;
        jne  fd_top;                    // not a dash slot yet

        // Emit '-' at [r13], advance.
        mov  rax, 0x2D;
        mov_b [r13], rax;
        add  r13, 1;
        add  rbx, 1;
        jmp  fd_top;

      fd_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
