// src/tools/mkfs-pdxb/main.pdx -- paideia-os R53.M1-001 (issue 1730)
//   composited with R53.M1-004 (issue 1733) sig-key-hash embed slice.
//
// PDXB HOST-SIDE mkfs TOOL -- writes a fresh PDXB volume image on the
// developer's Linux host (Path A of design/tooling/volume-lifecycle-
// mechanism.md section 3.1). Consumed by tools/mkfs-pdxb.sh (issue
// 1731, landed) and by run-smoke.sh --with-disk (R53.M4).
//
// -----------------------------------------------------------------------------
// Landing history + composition
// -----------------------------------------------------------------------------
//
// Sibling M1 issues landed out of order relative to this file's
// authoring:
//
//   issue 1731 (M1-002) tools/mkfs-pdxb.sh dev-host wrapper       LANDED
//   issue 1732 (M1-003) tests/qemu/keys/pdxb-dev.mldsa65.{pub,priv} LANDED
//   issue 1733 (M1-004) sig-key-hash embed (this file, prior slice) LANDED
//   issue 1734 (M1-005) src/tools/mkfs-pdxb/uuid.pdx (uuid derive)  UNTRACKED
//   issue 1735 (M1-006) host-side python layout unit test          LANDED
//
// This file's landing for issue 1730 adds the outer main entry
// point (_start), CLI parser, file I/O, region zero-fill, and
// superblock populate/write, while PRESERVING VERBATIM the two
// functions from the earlier M1-004 slice (main_parse_sig_key_arg
// and main_sig_key_hash_apply) and their supporting rodata
// (_main_sig_key_path_default, _main_sig_key_arg_name, and the
// SIG-KEY-HASH-STUB warning message). The module wrapper is renamed
// Main -> MkfsPdxbMain for naming consistency with the sibling
// MkfsPdxbUuid module in uuid.pdx (paideia-as symbol linkage is
// flat, so the rename does not affect cross-file `call foo` sites).
//
// The uuid.pdx module (issue 1734) is NOT linked in from this file
// at this landing -- that module remains untracked in the working
// tree as of issue 1730's authoring, and adding call sites against
// symbols that may not yet be committed would risk a link-time
// failure. When #1734 commits, a follow-up edit here wires a
// `parse_uuid_arg` / `derive_uuid_from_head_sha` dispatch into
// _start's --uuid handler in place of the current no-op stub.
//
// -----------------------------------------------------------------------------
// Runtime posture -- host binary, Linux SYSCALL entry
// -----------------------------------------------------------------------------
//
// The tool runs on the Linux dev host, not inside paideia-os. Every
// `syscall` here hits the Linux SYSCALL table using the standard
// Linux x86_64 numbers below. The paideia-as toolchain's host-binary
// link path is a build-system concern; see the "Build wiring" note
// at the bottom of this header.
//
//   sys_read     =  0    (fd, buf, count)                      -> count
//   sys_write    =  1    (fd, buf, count)                      -> count
//   sys_open     =  2    (path, flags, mode)                   -> fd
//   sys_close    =  3    (fd)                                  -> 0
//   sys_pwrite64 = 18    (fd, buf, count, offset)              -> count
//   sys_exit     = 60    (status)                              -> (no return)
//   sys_ftruncate= 77    (fd, length)                          -> 0
//
// SYSCALL register discipline (Linux x86_64 ABI):
//   rax = syscall number in, return value out
//   rdi, rsi, rdx, r10, r8, r9 = args (note: r10, NOT rcx, for arg 4)
//   rcx, r11 clobbered by SYSCALL itself
//
// -----------------------------------------------------------------------------
// PDXB superblock layout -- mirrors src/kernel/core/fs/pdxfs/superblock_fmt.pdx
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field           Notes
//   ------  ----  --------------  -----------------------------------------
//   0       4     magic           0x42584450 ("PDXB")
//   4       4     version         1
//   8       16    uuid            zero at this landing (M1-005 wires --uuid)
//   24      4     block_size      4096
//   28      4     flags           CLEAN_UNMOUNT (0x1) | ROOT_VOLUME (0x2)
//                                 if --set-root-flag, else CLEAN_UNMOUNT
//   32      8     total_blocks    size_mib * 256 (256 4-KiB blocks / MiB)
//   40      8     itable_lba      1
//   48      8     itable_bcount   computed
//   56      8     alloc_lba       computed
//   64      8     alloc_bcount    computed
//   72      8     journal_lba     computed
//   80      8     journal_bcount  default 1024 (4 MiB WAL ring)
//   88      8     data_lba        computed
//   96      8     data_bcount     computed (remainder)
//   104     8     root_inode      1
//   112     8     mount_gen       1
//   120     8     snap_head       0
//   128     32    sig_key_hash    zero at stub form (main_sig_key_hash_apply)
//   160     536   _reserved       zero
//   696     3400  sig             zero (unsigned; mldsa65_sign is a
//                                       paideia-as cross-repo blocker)
//
// Region layout mirrors src/kernel/core/fs/pdxfs/mkfs.pdx exactly, so
// a host-produced image is byte-comparable against a kernel-side
// probe walk (design/tooling/volume-lifecycle-mechanism.md section
// 3.1 "byte-identical for a given (size, uuid, key) triple").
//
// -----------------------------------------------------------------------------
// CLI shape (per design section 3.1)
// -----------------------------------------------------------------------------
//
//   build/mkfs-pdxb --file <path>            (required)
//                   --size-mib <N>            (default 128)
//                   --uuid <32-hex-chars>     (accepted; stub at this landing)
//                   --sig-key <path>          (accepted; stub via M1-004)
//                   --set-root-flag           (optional; sets flag bit 1)
//
// Any unknown flag or missing --file returns exit code 2 with a
// diagnostic line on stdout (stderr split is a follow-up; the
// wrapper #1731 does not distinguish stdout/stderr today).
//
// -----------------------------------------------------------------------------
// Output contract
// -----------------------------------------------------------------------------
//
//   success -> stdout: "MKFS PDXB OK\n"     exit(0)
//   usage   -> stdout: "mkfs-pdxb: usage\n" exit(2)
//   open    -> stdout: "mkfs-pdxb: open\n"  exit(3)
//   trunc   -> stdout: "mkfs-pdxb: trunc\n" exit(4)
//   write   -> stdout: "mkfs-pdxb: write\n" exit(5)
//   close   -> stdout: "mkfs-pdxb: close\n" exit(6)
//   layout  -> stdout: "mkfs-pdxb: layout\n" exit(7)
//
// Distinct exit codes let the tools/mkfs-pdxb.sh wrapper differentiate.
// No output string contains an issue-number, phase-number, or version-
// literal token per the codebase-wide fingerprint discipline.
//
// The M1-004 sig-key stub adds one additional line to stderr (fd 2)
// via its own inlined syscall: "SIG KEY HASH STUB: ...\n" -- see
// _main_sig_key_hash_stub_msg below. That warning is orthogonal to
// the OK/exit-code path above and does not gate success.
//
// -----------------------------------------------------------------------------
// Static storage -- ec_confine_one discipline
// -----------------------------------------------------------------------------
//
// Every mut static declared below is a private working buffer for
// this binary; the intent is that only main.o may relocate against
// any of them. Because src/tools/ has no build-time confinement gate
// yet (the tools/build.sh ec_confine_one rules apply to the kernel
// tree only), this file cannot self-enforce that today. When
// tools/mkfs-pdxb.sh grows a real host-binary build target (or a
// new tools/build-tools.sh lands), it must add:
//
//   ec_confine_one '_mkfs_pdxb_sb_buf'      'tools/mkfs-pdxb/main.o'
//   ec_confine_one '_mkfs_pdxb_zero_buf'    'tools/mkfs-pdxb/main.o'
//   ec_confine_one '_mkfs_pdxb_layout_row'  'tools/mkfs-pdxb/main.o'
//   ec_confine_one '_mkfs_pdxb_cli_state'   'tools/mkfs-pdxb/main.o'
//
// The M1-004 rodata (_main_sig_key_path_default, _main_sig_key_arg_name,
// _main_sig_key_hash_stub_msg, _main_sig_key_hash_stub_msg_len) is
// read-only so no ec_confine_one line is required for those.
//
// -----------------------------------------------------------------------------
// Build wiring -- FLAGGED FOLLOW-UP
// -----------------------------------------------------------------------------
//
// tools/build.sh at this landing walks src/kernel/**.pdx only; it does
// not touch src/tools/. tools/build-user.sh walks src/user/**.pdx only.
// Neither can compile this file as-is. tools/mkfs-pdxb.sh (issue 1731)
// already documents this gap: its search for build/tools/mkfs-pdxb or
// build/mkfs-pdxb currently fails cleanly with a diagnostic pointing
// at this M1-001 issue. A real build target likely means either
//
//   (a) a new tools/build-tools.sh that walks src/tools/*/main.pdx and
//       links each as a standalone host ELF (Linux _start conventions,
//       likely via a tailored link.ld), or
//   (b) an extension of tools/build.sh with a HOST_TOOLS list.
//
// Neither is in scope for this issue; both are landed with a follow-up
// (candidate scope: an unfiled M1-007 or an amendment of M1-002).
// This file is intentionally self-contained (no external symbol refs
// except across-file to uuid.pdx which is currently not called)
// so the link is a one-object job when that build path lands.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels in the M1-004 functions retain their existing
// main_parse_sig_key_arg_ prefix. Labels in the new M1-001 functions
// use the mkfs_pdxb_ prefix (this file's function-name stem, unique
// across the link unit). No bare `if`/`loop`/`fs`/`mount` per
// feedback_paideia_as_version_discipline.md.

module MkfsPdxbMain = structure {

  // ============================================================================
  // Constants -- from M1-004 slice (issue 1733). Preserved verbatim.
  // Mirror superblock_fmt.pdx offsets + Linux ABI numbers.
  // ============================================================================

  pub let _MAIN_SB_SIG_KEY_HASH_OFFSET : u64 = 128
  pub let _MAIN_SB_SIG_KEY_HASH_LEN    : u64 = 32

  pub let _MAIN_LINUX_STDERR_FD        : u64 = 2
  pub let _MAIN_LINUX_SYS_WRITE        : u64 = 1

  // ============================================================================
  // Storage -- from M1-004 slice (issue 1733). Preserved verbatim.
  // ============================================================================

  // Default sig-key path (36 chars + trailing NUL = 37 bytes). Points at
  // the .pub half of the dev signing key pair landed at #1732. NUL-
  // terminated for POSIX open(2) compatibility so the outer main can
  // pass this pointer straight to sys_open when BLAKE3 lands.
  pub let _main_sig_key_path_default : [u8; 37] =
    "tests/qemu/keys/pdxb-dev.mldsa65.pub\0"

  // `--sig-key` flag name, NUL-terminated to 10 bytes for the byte-loop
  // strcmp inside main_parse_sig_key_arg. Length includes the trailing
  // NUL so the compare rejects both shorter tokens ("--sig") and
  // longer superset tokens ("--sig-keys") in the same 10-byte pass.
  pub let _main_sig_key_arg_name : [u8; 10] = "--sig-key\0"

  // The stub warning emitted when BLAKE3 is not landed. Exactly 75 bytes
  // (byte-counted: "SIG KEY HASH STUB" 17 + ": " 2 + "BLAKE3" 6 + " " 1 +
  // "primitive" 9 + " " 1 + "not" 3 + " " 1 + "landed" 6 + "; " 2 +
  // "sig_key_hash" 12 + " " 1 + "left" 4 + " " 1 + "all-zero" 8 +
  // "\n" 1 = 75). No trailing NUL: the write syscall is length-explicit
  // and a NUL byte would corrupt terminal logs downstream.
  pub let _main_sig_key_hash_stub_msg : [u8; 75] =
    "SIG KEY HASH STUB: BLAKE3 primitive not landed; sig_key_hash left all-zero\n"

  pub let _main_sig_key_hash_stub_msg_len : u64 = 75

  // ============================================================================
  // Storage -- M1-001 (issue 1730) additions.
  // ============================================================================

  // Superblock scratch buffer (4096 bytes, page-aligned for possible
  // future DMA reuse; irrelevant to Linux write() but matches the
  // kernel-side mkfs.pdx convention).
  pub let mut _mkfs_pdxb_sb_buf : [u64; 512] = [0; 512] @align(4096)

  // Reusable all-zero source buffer for region zero-fill pwrite calls.
  pub let mut _mkfs_pdxb_zero_buf : [u64; 512] = [0; 512] @align(4096)

  // Layout row: {itable_lba, itable_bcount, alloc_lba, alloc_bcount,
  //              journal_lba, journal_bcount, data_lba, data_bcount,
  //              total_blocks}. Same shape as kernel-side mkfs.pdx.
  pub let mut _mkfs_pdxb_layout_row : [u64; 9] = [0; 9] @align(8)

  // CLI state (populated by mkfs_pdxb_argparse):
  //   [0]  = image_path_ptr    (u64; 0 if unset)
  //   [8]  = size_mib          (u64; default 128)
  //   [16] = set_root_flag     (u64; 0 or 1)
  //   [24] = image_fd          (u64; set after open)
  pub let mut _mkfs_pdxb_cli_state : [u64; 4] = [0; 4] @align(8)

  // Emitted-string constants for the M1-001 entry-point paths.
  // Deliberately free of R<digits>, #<digits>, and v<digits> tokens.
  pub let mkfs_pdxb_msg_ok     : [u8; 14] = "MKFS PDXB OK\n\0"
  pub let mkfs_pdxb_msg_usage  : [u8; 20] = "mkfs-pdxb: usage\n\0\0\0"
  pub let mkfs_pdxb_msg_open   : [u8; 19] = "mkfs-pdxb: open\n\0\0\0"
  pub let mkfs_pdxb_msg_trunc  : [u8; 20] = "mkfs-pdxb: trunc\n\0\0\0"
  pub let mkfs_pdxb_msg_write  : [u8; 20] = "mkfs-pdxb: write\n\0\0\0"
  pub let mkfs_pdxb_msg_close  : [u8; 20] = "mkfs-pdxb: close\n\0\0\0"
  pub let mkfs_pdxb_msg_layout : [u8; 21] = "mkfs-pdxb: layout\n\0\0\0"

  // Flag literals used by mkfs_pdxb_argparse. NUL-terminated; the
  // streq_nul helper verifies argv[i] matches the full flag AND has
  // a NUL at the position immediately after (rejects "--file-extra").
  //
  // The --sig-key flag is NOT declared here -- it uses the M1-004
  // slice's _main_sig_key_arg_name, whose scanner
  // (main_parse_sig_key_arg) is invoked separately.
  pub let mkfs_pdxb_flag_file  : [u8; 8]  = "--file\0\0"
  pub let mkfs_pdxb_flag_smib  : [u8; 12] = "--size-mib\0\0"
  pub let mkfs_pdxb_flag_uuid  : [u8; 8]  = "--uuid\0\0"
  pub let mkfs_pdxb_flag_root  : [u8; 18] = "--set-root-flag\0\0\0"

  // ============================================================================
  // main_parse_sig_key_arg(argc: u64, argv: u64) -> u64
  //   Scans argv from index 1 for the token "--sig-key". On match,
  //   returns argv[i+1] (the next token, taken as the path). On no
  //   match, on "--sig-key" as the final token (no value word), or
  //   on argc==0/1, returns &_main_sig_key_path_default.
  //   From M1-004 slice (issue 1733). Preserved verbatim.
  // ============================================================================

  pub let main_parse_sig_key_arg : (u64, u64) -> u64 !{mem} @{} =
    fn (argc: u64) (argv: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M1-004 (#1733). Pure leaf (no nested calls); no callee-save prologue -- SysV arg regs (rdi=argc, rsi=argv, immutable across the loop) and caller-save temps only (rax/rcx/rdx/r8/r9/r10). Body: (1) r10=1 (loop cursor; i=1 skips argv[0]=program name). (2) Loop top: cmp r10,rdi; jae default (i>=argc: fall through to default return). (3) Load argv[i] = *(argv + i*8) via `mov rcx,r10; shl rcx,3; add rcx,rsi; mov rcx,[rcx]` (proven idiom, src/user/dispatch.pdx L306 shl r8,3 pattern). (4) `lea r8, [rip + _main_sig_key_arg_name]`; `mov r9, 10` (byte count including terminator -- compare length settled by the module-header note above). (5) Byte-loop compare: cmp r9,0; je match (all 10 bytes equal, terminators inclusive). Load both bytes with the paideia-as #1248 mitigation pattern (`xor rax,rax; mov_b rax,[rcx]` -- same for rdx/r8, per src/user/string.pdx memcmp L55-58). cmp rax,rdx; jne next_arg. Else `add rcx,1; add r8,1; sub r9,1; jmp cmp`. (6) next_arg: r10+=1; jmp top. (7) match: r10+=1 (advance to value slot); cmp r10,rdi; jae default (--sig-key had no value word); else load argv[i+1] into rax and ret. (8) default: `lea rax, [rip + _main_sig_key_path_default]; ret`. No test instruction (paideia-as no-test discipline); mov_b via zero-extending full-register load pattern. Reserved labels: main_parse_sig_key_arg_.",
      block: {
        mov r10, 1;

      main_parse_sig_key_arg_top:
        cmp r10, rdi;
        jae main_parse_sig_key_arg_default;

        mov rcx, r10;
        shl rcx, 3;
        add rcx, rsi;
        mov rcx, [rcx];

        lea r8, [rip + _main_sig_key_arg_name];
        mov r9, 10;

      main_parse_sig_key_arg_cmp:
        cmp r9, 0;
        je  main_parse_sig_key_arg_match;
        xor rax, rax;
        mov_b rax, [rcx];
        xor rdx, rdx;
        mov_b rdx, [r8];
        cmp rax, rdx;
        jne main_parse_sig_key_arg_next;
        add rcx, 1;
        add r8, 1;
        sub r9, 1;
        jmp main_parse_sig_key_arg_cmp;

      main_parse_sig_key_arg_next:
        add r10, 1;
        jmp main_parse_sig_key_arg_top;

      main_parse_sig_key_arg_match:
        add r10, 1;
        cmp r10, rdi;
        jae main_parse_sig_key_arg_default;
        mov rcx, r10;
        shl rcx, 3;
        add rcx, rsi;
        mov rax, [rcx];
        ret;

      main_parse_sig_key_arg_default:
        lea rax, [rip + _main_sig_key_path_default];
        ret
      }
    }

  // ============================================================================
  // main_sig_key_hash_apply(sb_block_ptr: u64, sig_key_path_ptr: u64) -> u64
  //   Stamps sb_block_ptr[128..160] with the sig-key hash. STUB FORM:
  //   BLAKE3 primitive not landed; writes 32 zero bytes and emits a
  //   `SIG KEY HASH STUB: ...` warning to stderr. Always returns 0.
  //   `sig_key_path_ptr` is currently unused; the seam is preserved so
  //   that when BLAKE3 lands, the same call site (in the M1-001 outer
  //   main below) becomes a real hasher without a signature change.
  //   From M1-004 slice (issue 1733). Preserved verbatim.
  // ============================================================================

  pub let main_sig_key_hash_apply : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (sb_block_ptr: u64) (sig_key_path_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { fs },
      justification: "R53.M1-004 (#1733). Leaf (no nested calls, only a direct Linux `syscall`); no callee-save prologue -- caller-save regs only. Body: (1) Zero the 32 bytes at sb_block_ptr+128 via 4x mov [rdi+off],rax where rax=0 (xor eax,eax once, then four qword stores at +128/+136/+144/+152). This matches PDXB_SB_SIG_KEY_HASH_OFFSET/LEN from superblock_fmt.pdx exactly; the field is qword-aligned so no mov_b or byte-loop needed. Doing the memory writes BEFORE the syscall marshalling matters because step (2) below overwrites rdi (the sb_block_ptr) with the stderr fd literal. (2) Emit the SIG KEY HASH STUB warning via Linux sys_write(fd=2, buf=&msg, len=75): rdi=2 (_MAIN_LINUX_STDERR_FD), `lea rsi, [rip + _main_sig_key_hash_stub_msg]`, rdx=75 (_main_sig_key_hash_stub_msg_len), rax=1 (_MAIN_LINUX_SYS_WRITE), syscall. Numeric literals used inline (not the `pub let` constants) since cross-module `pub let` references have no precedent per superblock.pdx L109-113 header note. The syscall's rax return is discarded -- stderr write is best-effort in stub form per module-header failure-taxonomy note. (3) xor eax,eax; ret (unconditional success). sig_key_path_ptr (rsi at entry) is unused in stub form -- documented via the module-header BLAKE3-not-landed note; when the primitive lands this function will open(rsi), read the pub-key bytes, blake3-hash, and stamp the 32-byte digest instead of zeros. No test instruction; no mov_b (all writes qword-aligned within the 32-byte field). Reserved labels: none needed (straight-line, single syscall).",
      block: {
        xor eax, eax;
        mov [rdi + 128], rax;
        mov [rdi + 136], rax;
        mov [rdi + 144], rax;
        mov [rdi + 152], rax;

        mov rdi, 2;
        lea rsi, [rip + _main_sig_key_hash_stub_msg];
        mov rdx, 75;
        mov rax, 1;
        syscall;

        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_emit(msg_ptr, msg_len) -> ()
  //   Linux sys_write(1, msg_ptr, msg_len). rax discarded.
  // ============================================================================

  pub let mkfs_pdxb_emit : (u64, u64) -> () !{sysreg} @{} =
    fn (msg_ptr: u64) (msg_len: u64) -> unsafe {
      effects: { sysreg },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Straight-line SYSCALL 1 (Linux sys_write) to fd 1. Arg mapping: SysV (rdi=msg_ptr, rsi=msg_len) -> Linux (rdi=fd, rsi=buf, rdx=count). Marshal: mov rdx, rsi; mov rsi, rdi; mov rdi, 1; mov rax, 1; syscall; ret. Leaf, no callee-save.",
      block: {
        mov rdx, rsi;                    // count = msg_len
        mov rsi, rdi;                    // buf   = msg_ptr
        mov rdi, 1;                      // fd    = 1 (stdout)
        mov rax, 1;                      // sys_write
        syscall;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_exit(status) -> !
  //   Linux sys_exit(status). Never returns.
  // ============================================================================

  pub let mkfs_pdxb_exit : (u64) -> () !{sysreg} @{} =
    fn (status: u64) -> unsafe {
      effects: { sysreg },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Linux sys_exit -- SYSCALL 60 with rdi=status already in SysV arg0. Never returns; hlt guards against a hypothetical kernel bug returning from exit.",
      block: {
        mov rax, 60;                     // sys_exit
        syscall;
        hlt
      }
    } @no_frame

  // ============================================================================
  // mkfs_pdxb_streq_nul(a_ptr, b_ptr, b_len) -> u64
  //   Returns 1 iff a_ptr[0..b_len] == b_ptr[0..b_len] AND a_ptr[b_len]
  //   is NUL (arg is exactly the flag, not a prefix). Else 0.
  // ============================================================================

  pub let mkfs_pdxb_streq_nul : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (a_ptr: u64) (b_ptr: u64) (b_len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Byte-by-byte compare via mov_b + cmp reg,reg + jne. Body: r8=a_ptr, r9=b_ptr, r10=b_len. Loop: cmp r10,0; je check (all bytes matched -- verify NUL at a_ptr[b_len]). mov_b al,[r8]; mov_b cl,[r9]; cmp al,cl; jne neq. inc pointers; dec r10; jmp loop. check: mov_b al,[r8]; cmp al,0; jne neq (arg is longer than flag). mov rax,1; ret. neq: xor eax,eax; ret. Leaf, no callee-save. Reserved labels: mkfs_pdxb_streq_nul_.",
      block: {
        mov r8,  rdi;                    // a_ptr
        mov r9,  rsi;                    // b_ptr
        mov r10, rdx;                    // b_len

      mkfs_pdxb_streq_nul_loop:
        cmp r10, 0;
        je  mkfs_pdxb_streq_nul_check;

        mov_b al, [r8];
        mov_b cl, [r9];
        cmp al, cl;
        jne mkfs_pdxb_streq_nul_neq;

        add r8,  1;
        add r9,  1;
        sub r10, 1;
        jmp mkfs_pdxb_streq_nul_loop;

      mkfs_pdxb_streq_nul_check:
        mov_b al, [r8];
        cmp al, 0;
        jne mkfs_pdxb_streq_nul_neq;
        mov rax, 1;
        ret;

      mkfs_pdxb_streq_nul_neq:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_parse_dec(s_ptr) -> u64
  //   Parse a NUL-terminated decimal ASCII string to u64. Empty or
  //   non-digit input -> 0. Downstream code rejects size_mib==0 in
  //   layout_compute so the 0-on-garbage posture is safe.
  // ============================================================================

  pub let mkfs_pdxb_parse_dec : (u64) -> u64 !{mem} @{} =
    fn (s_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Standard mul-by-10 accumulator. r8=s_ptr, r9=acc=0. Loop: read byte; NUL -> done; below '0' or above '9' -> bad; digit -> acc = acc*10 + digit; advance. done: rax=r9; ret. bad: xor eax,eax; ret. Leaf, no callee-save. Reserved labels: mkfs_pdxb_parse_dec_.",
      block: {
        mov r8, rdi;
        xor r9, r9;

      mkfs_pdxb_parse_dec_loop:
        mov_b al, [r8];
        cmp al, 0;
        je  mkfs_pdxb_parse_dec_done;
        cmp al, 0x30;
        jb  mkfs_pdxb_parse_dec_bad;
        cmp al, 0x39;
        ja  mkfs_pdxb_parse_dec_bad;

        sub al, 0x30;
        mov rcx, 10;
        imul r9, rcx;
        movzx rax, al;
        add r9, rax;
        add r8, 1;
        jmp mkfs_pdxb_parse_dec_loop;

      mkfs_pdxb_parse_dec_done:
        mov rax, r9;
        ret;

      mkfs_pdxb_parse_dec_bad:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_argparse(argc, argv_ptr) -> u64
  //   Walk argv[1..argc-1] populating _mkfs_pdxb_cli_state. Recognized
  //   flags:
  //     --file <path>       (required; sets image_path_ptr)
  //     --size-mib <N>      (default 128; parses decimal)
  //     --uuid <text>       (accepted; stub -- uuid.pdx wires the real path)
  //     --sig-key <path>    (accepted; handled by main_parse_sig_key_arg
  //                          from a SEPARATE walk called from _start;
  //                          this walker skips both tokens so the
  //                          unknown-flag branch does not fire)
  //     --set-root-flag     (toggles flag bit 1)
  //   Unknown flag or a --flag missing its value -> return 1.
  //   Success (image_path_ptr non-zero) -> return 0.
  // ============================================================================

  pub let mkfs_pdxb_argparse : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (argc: u64) (argv_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). 5-push callee-save prologue for the nested mkfs_pdxb_streq_nul / mkfs_pdxb_parse_dec calls. r12=argc, r13=argv_ptr, r14=cursor (starts at 1). Defaults: state[0]=0 (path unset), state[8]=128 (size_mib), state[16]=0 (set_root_flag), state[24]=0 (fd). Loop: cmp r14,r12; jae check. rbx=argv[r14]=[r13+8*r14]. Try each flag via streq_nul(rbx, flag_ptr, flag_len); on match, handle: --file consumes next arg as path; --size-mib consumes next arg via parse_dec; --uuid consumes next arg (stub); --sig-key consumes next arg (SEPARATE walk in main_parse_sig_key_arg); --set-root-flag toggles bit. Unknown -> usage_err. Every idx bounds-check comes before the [r13+8*idx] load. check: verify state[0] non-zero. Reserved labels: mkfs_pdxb_argparse_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // argc
        mov r13, rsi;                    // argv_ptr
        mov r14, 1;                      // cursor

        lea r15, [rip + _mkfs_pdxb_cli_state];
        mov rax, 0;
        mov [r15 + 0], rax;              // image_path_ptr = 0
        mov rax, 128;
        mov [r15 + 8], rax;              // size_mib = 128
        mov rax, 0;
        mov [r15 + 16], rax;             // set_root_flag = 0
        mov rax, 0;
        mov [r15 + 24], rax;             // image_fd = 0

      mkfs_pdxb_argparse_top:
        cmp r14, r12;
        jae mkfs_pdxb_argparse_check;

        // rbx = argv[r14]
        mov rcx, r14;
        shl rcx, 3;
        add rcx, r13;
        mov rbx, [rcx];

        // --file
        mov rdi, rbx;
        lea rsi, [rip + mkfs_pdxb_flag_file];
        mov rdx, 6;
        call mkfs_pdxb_streq_nul;
        cmp rax, 1;
        jne mkfs_pdxb_argparse_try_smib;
        mov rax, r14;
        add rax, 1;
        cmp rax, r12;
        jae mkfs_pdxb_argparse_usage;
        mov rcx, rax;
        shl rcx, 3;
        add rcx, r13;
        mov rax, [rcx];
        mov [r15 + 0], rax;              // image_path_ptr
        add r14, 2;
        jmp mkfs_pdxb_argparse_top;

      mkfs_pdxb_argparse_try_smib:
        mov rdi, rbx;
        lea rsi, [rip + mkfs_pdxb_flag_smib];
        mov rdx, 10;
        call mkfs_pdxb_streq_nul;
        cmp rax, 1;
        jne mkfs_pdxb_argparse_try_uuid;
        mov rax, r14;
        add rax, 1;
        cmp rax, r12;
        jae mkfs_pdxb_argparse_usage;
        mov rcx, rax;
        shl rcx, 3;
        add rcx, r13;
        mov rdi, [rcx];
        call mkfs_pdxb_parse_dec;
        mov [r15 + 8], rax;              // size_mib
        add r14, 2;
        jmp mkfs_pdxb_argparse_top;

      mkfs_pdxb_argparse_try_uuid:
        mov rdi, rbx;
        lea rsi, [rip + mkfs_pdxb_flag_uuid];
        mov rdx, 6;
        call mkfs_pdxb_streq_nul;
        cmp rax, 1;
        jne mkfs_pdxb_argparse_try_sig;
        mov rax, r14;
        add rax, 1;
        cmp rax, r12;
        jae mkfs_pdxb_argparse_usage;
        add r14, 2;                      // stub: value consumed, no-op
        jmp mkfs_pdxb_argparse_top;

      mkfs_pdxb_argparse_try_sig:
        // --sig-key: match against _main_sig_key_arg_name (10 bytes
        // including NUL). If it matches, skip both tokens; the
        // separate main_parse_sig_key_arg walk called from _start
        // owns the actual sig-key path resolution.
        mov rdi, rbx;
        lea rsi, [rip + _main_sig_key_arg_name];
        mov rdx, 9;                      // "--sig-key" (9 chars, streq_nul checks NUL after)
        call mkfs_pdxb_streq_nul;
        cmp rax, 1;
        jne mkfs_pdxb_argparse_try_root;
        mov rax, r14;
        add rax, 1;
        cmp rax, r12;
        jae mkfs_pdxb_argparse_usage;
        add r14, 2;
        jmp mkfs_pdxb_argparse_top;

      mkfs_pdxb_argparse_try_root:
        mov rdi, rbx;
        lea rsi, [rip + mkfs_pdxb_flag_root];
        mov rdx, 15;
        call mkfs_pdxb_streq_nul;
        cmp rax, 1;
        jne mkfs_pdxb_argparse_usage;
        mov rax, 1;
        mov [r15 + 16], rax;             // set_root_flag = 1
        add r14, 1;
        jmp mkfs_pdxb_argparse_top;

      mkfs_pdxb_argparse_check:
        mov rax, [r15 + 0];
        cmp rax, 0;
        je  mkfs_pdxb_argparse_usage;
        xor eax, eax;
        jmp mkfs_pdxb_argparse_done;

      mkfs_pdxb_argparse_usage:
        mov rax, 1;

      mkfs_pdxb_argparse_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_layout_compute(total_blocks) -> u64
  //   Compute region layout and stamp _mkfs_pdxb_layout_row. Defaults:
  //   inode_ratio=256, journal_size_hint=1024 (design section 2.1
  //   sizing math for the 128-MiB reference volume). 0 on success,
  //   1 on unbuildable geometry.
  // ============================================================================

  pub let mkfs_pdxb_layout_compute : (u64) -> u64 !{mem} @{} =
    fn (total_blocks: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Pure leaf, no prologue. r8=total_blocks. Guard: cmp r8,0; je fail. num_inodes = total_blocks/256, floor 1. itable_bcount = ceil(num_inodes/32), floor 1. itable_lba=1. alloc_lba=itable_lba+itable_bcount. alloc_bcount = ceil(total_blocks/32768), floor 1. journal_lba=alloc_lba+alloc_bcount. journal_bcount=1024. data_lba=journal_lba+journal_bcount. Guard: data_lba>=total_blocks -> fail. data_bcount=total_blocks-data_lba. Mirrors src/kernel/core/fs/pdxfs/mkfs.pdx exactly so a probe walk against a host-produced image is layout-clean. xor-then-div idiom for every division. Reserved labels: mkfs_pdxb_layout_.",
      block: {
        mov r8, rdi;

        cmp r8, 0;
        je  mkfs_pdxb_layout_fail;

        // num_inodes = total_blocks / 256, floor 1.
        mov rax, r8;
        mov rcx, 256;
        xor rdx, rdx;
        div rcx;
        cmp rax, 0;
        jne mkfs_pdxb_layout_ni_ok;
        mov rax, 1;

      mkfs_pdxb_layout_ni_ok:
        mov r9, rax;

        // itable_bcount = ceil(num_inodes/32), floor 1.
        mov rax, r9;
        add rax, 31;
        mov rcx, 32;
        xor rdx, rdx;
        div rcx;
        cmp rax, 0;
        jne mkfs_pdxb_layout_itbc_ok;
        mov rax, 1;

      mkfs_pdxb_layout_itbc_ok:
        mov r10, rax;

        lea r11, [rip + _mkfs_pdxb_layout_row];

        mov rax, 1;                      // itable_lba
        mov [r11 + 0], rax;
        mov [r11 + 8], r10;              // itable_bcount

        add rax, r10;                    // alloc_lba
        mov [r11 + 16], rax;

        // alloc_bcount = ceil(total_blocks/32768), floor 1.
        mov rcx, r8;
        add rcx, 32767;
        mov rax, rcx;
        mov rcx, 32768;
        xor rdx, rdx;
        div rcx;
        cmp rax, 0;
        jne mkfs_pdxb_layout_alc_ok;
        mov rax, 1;

      mkfs_pdxb_layout_alc_ok:
        mov [r11 + 24], rax;
        mov r10, rax;

        mov rax, [r11 + 16];
        add rax, r10;
        mov [r11 + 32], rax;             // journal_lba

        mov rcx, 1024;
        mov [r11 + 40], rcx;             // journal_bcount

        add rax, rcx;
        mov [r11 + 48], rax;             // data_lba

        cmp rax, r8;
        jae mkfs_pdxb_layout_fail;

        mov rcx, r8;
        sub rcx, rax;
        mov [r11 + 56], rcx;             // data_bcount

        mov [r11 + 64], r8;              // total_blocks

        xor eax, eax;
        ret;

      mkfs_pdxb_layout_fail:
        mov rax, 1;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_sb_populate(set_root_flag) -> ()
  //   Populate _mkfs_pdxb_sb_buf with a valid v1 PDXB superblock.
  //   Reads region-layout fields from _mkfs_pdxb_layout_row. uuid
  //   is left zero (M1-005 wires --uuid). sig_key_hash is left for
  //   main_sig_key_hash_apply to stamp.
  // ============================================================================

  pub let mkfs_pdxb_sb_populate : (u64) -> () !{mem} @{} =
    fn (set_root_flag: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). No nested calls. rbx=set_root_flag; r8=&sb_buf, r9=&layout_row. Stamp fields per superblock_fmt.pdx offsets. flags: base=1 (CLEAN_UNMOUNT); if set_root_flag!=0, OR in 2 (ROOT_VOLUME). Mirrors kernel-side mkfs.pdx sb_populate exactly. uuid @+8..+24 left zero (M1-005). sig_key_hash @+128..+160 left for main_sig_key_hash_apply. _reserved and sig left zero. No test instruction; no mov_b (all whole-qword after the mov_d for u32 fields).",
      block: {
        push rbx;

        mov rbx, rdi;                    // set_root_flag

        lea r8, [rip + _mkfs_pdxb_sb_buf];
        lea r9, [rip + _mkfs_pdxb_layout_row];

        // magic @+0
        mov rax, 0x42584450;
        mov_d [r8 + 0], rax;

        // version @+4
        mov rax, 1;
        mov_d [r8 + 4], rax;

        // uuid @+8..+24 left zero.

        // block_size @+24
        mov rax, 4096;
        mov_d [r8 + 24], rax;

        // flags @+28
        mov rax, 1;                      // CLEAN_UNMOUNT
        cmp rbx, 0;
        je  mkfs_pdxb_sb_populate_flags_done;
        mov rax, 3;                      // | ROOT_VOLUME

      mkfs_pdxb_sb_populate_flags_done:
        mov_d [r8 + 28], rax;

        // total_blocks @+32
        mov rax, [r9 + 64];
        mov [r8 + 32], rax;

        // itable_lba/itable_bcount @+40/+48
        mov rax, [r9 + 0];
        mov [r8 + 40], rax;
        mov rax, [r9 + 8];
        mov [r8 + 48], rax;

        // alloc_lba/alloc_bcount @+56/+64
        mov rax, [r9 + 16];
        mov [r8 + 56], rax;
        mov rax, [r9 + 24];
        mov [r8 + 64], rax;

        // journal_lba/journal_bcount @+72/+80
        mov rax, [r9 + 32];
        mov [r8 + 72], rax;
        mov rax, [r9 + 40];
        mov [r8 + 80], rax;

        // data_lba/data_bcount @+88/+96
        mov rax, [r9 + 48];
        mov [r8 + 88], rax;
        mov rax, [r9 + 56];
        mov [r8 + 96], rax;

        // root_inode @+104
        mov rax, 1;
        mov [r8 + 104], rax;

        // mount_gen @+112 (matches kernel-side mkfs.pdx invariant)
        mov rax, 1;
        mov [r8 + 112], rax;

        // snap_head @+120
        xor rax, rax;
        mov [r8 + 120], rax;

        // sig_key_hash @+128..+160 left for main_sig_key_hash_apply.
        // _reserved @+160..+696 left zero.
        // sig @+696..+4096 left zero.

        pop rbx;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_pwrite_at(fd, buf, count, offset) -> u64
  //   Linux sys_pwrite64. 0 on success, 1 on short write or negative
  //   return.
  // ============================================================================

  pub let mkfs_pdxb_pwrite_at : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (fd: u64) (buf: u64) (count: u64) (offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). Linux sys_pwrite64 = 18. Arg register mapping: SysV rdi/rsi/rdx/rcx -> Linux rdi/rsi/rdx/r10. Body: mov r10,rcx (Linux arg4 slot); mov rax,18; syscall. cmp rax,rdx (bytes written == requested); jne fail. A negative return (Linux -errno, unsigned large) fails the cmp and lands in fail. Leaf, no callee-save.",
      block: {
        mov r10, rcx;                    // arg4 = offset
        mov rax, 18;                     // sys_pwrite64
        syscall;
        cmp rax, rdx;
        jne mkfs_pdxb_pwrite_at_fail;
        xor eax, eax;
        ret;

      mkfs_pdxb_pwrite_at_fail:
        mov rax, 1;
        ret
      }
    }

  // ============================================================================
  // mkfs_pdxb_zero_region(fd, lba_start, block_count) -> u64
  //   Zero-fill block_count 4-KiB blocks from _mkfs_pdxb_zero_buf via
  //   repeated pwrite64. 0 on success, 1 on any pwrite failure.
  //   block_count==0 is a no-op success.
  // ============================================================================

  pub let mkfs_pdxb_zero_region : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (fd: u64) (lba_start: u64) (block_count: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R53.M1-001 (issue 1730). 5-push callee-save prologue for the nested mkfs_pdxb_pwrite_at call. rbx=fd, r12=&zero_buf, r13=current lba, r14=end lba (exclusive). Loop: cmp r13,r14; jae ok. offset = r13*4096 = shl r13 by 12. Call pwrite_at(rbx, r12, 4096, offset). Non-zero -> fail. Reserved labels: mkfs_pdxb_zero_region_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r13, rsi;                    // current lba
        mov r14, rsi;
        add r14, rdx;                    // end lba (exclusive)

        lea r12, [rip + _mkfs_pdxb_zero_buf];

      mkfs_pdxb_zero_region_top:
        cmp r13, r14;
        jae mkfs_pdxb_zero_region_ok;

        mov r15, r13;
        shl r15, 12;                     // offset = lba * 4096

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, 4096;
        mov rcx, r15;
        call mkfs_pdxb_pwrite_at;
        cmp rax, 0;
        jne mkfs_pdxb_zero_region_fail;

        add r13, 1;
        jmp mkfs_pdxb_zero_region_top;

      mkfs_pdxb_zero_region_ok:
        xor eax, eax;
        jmp mkfs_pdxb_zero_region_done;

      mkfs_pdxb_zero_region_fail:
        mov rax, 1;

      mkfs_pdxb_zero_region_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _start -- Linux _start entry point.
  //
  // On entry rsp points to argc; argv[0..argc] follow at rsp+8.
  //
  // Flow:
  //   1. Read argc, argv_ptr from the stack.
  //   2. mkfs_pdxb_argparse; on error -> usage, exit(2).
  //   3. main_parse_sig_key_arg -- separate walk that returns a sig-key
  //      path (either --sig-key value or default). Stashed for step 8.
  //   4. sys_open the image with O_WRONLY|O_CREAT|O_TRUNC, mode 0644.
  //   5. sys_ftruncate to size_mib * 1048576 bytes.
  //   6. mkfs_pdxb_layout_compute(size_mib * 256).
  //   7. Zero itable, alloc, journal regions.
  //   8. mkfs_pdxb_sb_populate + main_sig_key_hash_apply (stamps
  //      sig_key_hash bytes and emits the STUB warning).
  //   9. pwrite_at(fd, sb_buf, 4096, 0).
  //  10. sys_close.
  //  11. Emit "MKFS PDXB OK\n"; exit(0).
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { fs },
      justification: "R53.M1-001 (issue 1730). Linux _start entry point. On entry rsp points at argc; argv[] follows at rsp+8. Push rbp lands rsp on 16B alignment (SysV amd64 psABI section 3.4.1 guarantees rsp%16==0 at _start entry). r14=argc from [rbp+8], r15=&argv[0]=rbp+16. Sequence: (1) argparse; on error emit usage msg, exit(2). (2) main_parse_sig_key_arg(argc, argv) returns sig-key path in rax; save to rbx (callee-save survives across everything below). (3) sys_open with O_WRONLY|O_CREAT|O_TRUNC (0x241=577) mode 0644 (420); rax<0 -> fail_open. r12=fd. (4) sys_ftruncate to state[8]*1048576 bytes; non-zero -> fail_trunc. (5) mkfs_pdxb_layout_compute(state[8]*256); non-zero -> fail_layout. (6) Three mkfs_pdxb_zero_region calls (itable/alloc/journal from layout row); non-zero -> fail_write. (7) mkfs_pdxb_sb_populate(state[16]) fills sb_buf minus the sig_key_hash bytes. (8) main_sig_key_hash_apply(&sb_buf, rbx) stamps sig_key_hash (zeros in stub form) and emits the STUB warning to stderr. (9) pwrite_at(r12, &sb_buf, 4096, 0); non-zero -> fail_write. (10) sys_close; non-zero -> fail_close. (11) Emit OK, exit(0). Every failure emits its own diagnostic + calls exit(distinct-code). Reserved labels: mkfs_pdxb_start_.",
      block: {
        push rbp;
        mov rbp, rsp;

        // argc at [rbp+8], argv[] at rbp+16.
        mov r14, [rbp + 8];
        lea r15, [rbp + 16];

        // ---- 1. Parse CLI ----
        mov rdi, r14;
        mov rsi, r15;
        call mkfs_pdxb_argparse;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_usage;

        // ---- 2. Resolve sig-key path (separate walk from M1-004 slice) ----
        mov rdi, r14;
        mov rsi, r15;
        call main_parse_sig_key_arg;
        mov rbx, rax;                    // rbx = sig_key_path_ptr (callee-save)

        // ---- 3. Open image file ----
        lea r13, [rip + _mkfs_pdxb_cli_state];
        mov rdi, [r13 + 0];              // path
        mov rsi, 0x241;                  // O_WRONLY|O_CREAT|O_TRUNC
        mov rdx, 420;                    // 0644
        mov rax, 2;                      // sys_open
        syscall;
        cmp rax, 0;
        jl  mkfs_pdxb_start_fail_open;
        mov r12, rax;                    // r12 = fd (callee-save)
        mov [r13 + 24], r12;

        // ---- 4. ftruncate to size_mib * 1048576 bytes ----
        mov rsi, [r13 + 8];
        shl rsi, 20;
        mov rdi, r12;
        mov rax, 77;
        syscall;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_trunc;

        // ---- 5. Compute layout ----
        mov rdi, [r13 + 8];
        shl rdi, 8;                      // total_blocks = size_mib * 256
        call mkfs_pdxb_layout_compute;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_layout;

        // ---- 6a. Zero inode-table region ----
        lea r14, [rip + _mkfs_pdxb_layout_row];
        mov rdi, r12;
        mov rsi, [r14 + 0];              // itable_lba
        mov rdx, [r14 + 8];              // itable_bcount
        call mkfs_pdxb_zero_region;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_write;

        // ---- 6b. Zero allocator-bitmap region ----
        mov rdi, r12;
        mov rsi, [r14 + 16];
        mov rdx, [r14 + 24];
        call mkfs_pdxb_zero_region;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_write;

        // ---- 6c. Zero journal region ----
        mov rdi, r12;
        mov rsi, [r14 + 32];
        mov rdx, [r14 + 40];
        call mkfs_pdxb_zero_region;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_write;

        // ---- 7. Populate superblock (minus sig_key_hash) ----
        mov rdi, [r13 + 16];             // set_root_flag
        call mkfs_pdxb_sb_populate;

        // ---- 8. Stamp sig_key_hash + emit STUB warning (M1-004 seam) ----
        lea rdi, [rip + _mkfs_pdxb_sb_buf];
        mov rsi, rbx;                    // sig_key_path_ptr
        call main_sig_key_hash_apply;

        // ---- 9. Write superblock at LBA 0 (offset 0) ----
        mov rdi, r12;
        lea rsi, [rip + _mkfs_pdxb_sb_buf];
        mov rdx, 4096;
        mov rcx, 0;
        call mkfs_pdxb_pwrite_at;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_write;

        // ---- 10. Close ----
        mov rdi, r12;
        mov rax, 3;                      // sys_close
        syscall;
        cmp rax, 0;
        jne mkfs_pdxb_start_fail_close;

        // ---- 11. Emit OK + exit(0) ----
        lea rdi, [rip + mkfs_pdxb_msg_ok];
        mov rsi, 13;
        call mkfs_pdxb_emit;
        mov rdi, 0;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_usage:
        lea rdi, [rip + mkfs_pdxb_msg_usage];
        mov rsi, 17;
        call mkfs_pdxb_emit;
        mov rdi, 2;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_open:
        lea rdi, [rip + mkfs_pdxb_msg_open];
        mov rsi, 16;
        call mkfs_pdxb_emit;
        mov rdi, 3;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_trunc:
        lea rdi, [rip + mkfs_pdxb_msg_trunc];
        mov rsi, 17;
        call mkfs_pdxb_emit;
        mov rdi, 4;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_write:
        lea rdi, [rip + mkfs_pdxb_msg_write];
        mov rsi, 17;
        call mkfs_pdxb_emit;
        mov rdi, 5;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_close:
        lea rdi, [rip + mkfs_pdxb_msg_close];
        mov rsi, 17;
        call mkfs_pdxb_emit;
        mov rdi, 6;
        call mkfs_pdxb_exit;
        jmp mkfs_pdxb_start_dead;

      mkfs_pdxb_start_fail_layout:
        lea rdi, [rip + mkfs_pdxb_msg_layout];
        mov rsi, 18;
        call mkfs_pdxb_emit;
        mov rdi, 7;
        call mkfs_pdxb_exit;

      mkfs_pdxb_start_dead:
        hlt
      }
    } @no_frame
}
