# on a codepath still stabilizing.  Promotes to the default matrix after
# 5/5 consecutive passes.  Set PAIDEIA_R20B_ECHO=1 before `git push` to
# opt in.
if [[ "${PAIDEIA_R20B_ECHO:-0}" == "1" ]]; then
    echo "[pre-push] Testing boot_r20b_echo (PAIDEIA_R20B_ECHO=1)..."
    if ! run_smoke_with_retry "boot_r20b_echo"; then
        echo "ERROR: boot_r20b_echo failed twice (regression detected)" >&2
        exit 1
