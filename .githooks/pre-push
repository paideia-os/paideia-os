# R68.M1-005 (#1873): PAIDEIA_R68_DISK=1 pre-push gate running ALL
# THREE disk-path composite smokes (R54 bdev round-trip, R55 pdxfs-
# block write-e2e, R56 VFS-metadata composite) behind one opt-in flag.
#
# R54/R55 legs mirror the standalone PAIDEIA_R54_DISK / PAIDEIA_R55_
# DISK gates above exactly (same mkfs-pdxb preflight-and-skip
# posture), sharing one probe since both gate on the identical host-
# tool dependency.
#
# KNOWN GAP as of this gate's introduction (R68 disk-path debt audit):
# tools/build.sh has NO host-tools build target for the mkfs-pdxb
# binary (paideia-as #1730 -- see tools/verify-fingerprint-coverage.sh's
# "MKFS PDXB OK" allowlist entry, which documents "no host-tools build
# target is wired yet", and design/round-retrospectives/r54-closure.md
# + r55-closure.md, which both carry this forward as debt that
# "discharges automatically when #1730 lands. No R54/R55 code change
# needed."). Confirmed empirically at R68 landing: `bash tools/
# mkfs-pdxb.sh <img>` returns rc=3 at HEAD. Until #1730 lands, the R54
# and R55 legs of this gate ALWAYS take the SKIP branch below -- this
# is a known, accepted, self-documenting gap, not a regression caused
# by this gate. Re-run PAIDEIA_R68_DISK=1 after #1730 lands to get the
# first real disk-path coverage from this composite gate.
#
# R56 leg: boot_r56_meta is a dormant SKIP-echo scaffold (the R56.M3-006
# witness is not wired into kernel_main -- see design/round-
# retrospectives/r56-closure.md "Composite smoke live exercise" debt
# item; live exercise is deferred to a ring-3 VFS-metadata userland
# harness, same posture as the R57 boot_r57_shell_a / R58 boot_r58_
# shell_b composite smokes, both still deferred per their own closure
# docs). No mkfs dependency -- the mode exits before ever reaching the
# build/QEMU launch path, so it runs unconditionally here. Diffed
# against tests/expected-r56-meta.golden (ASCII substrings of the SKIP
# message, contains-in-order, same check shape as run-smoke.sh's own
# FINGERPRINT_MODE) so a silent behavior change -- e.g. someone wires
# the witness live and the message changes shape without a matching
# golden update -- fails the push instead of drifting unnoticed.
if [[ "${PAIDEIA_R68_DISK:-0}" == "1" ]]; then
    echo "[pre-push] R68 disk-path composite gate (PAIDEIA_R68_DISK=1)..."

    _r68_probe="$(mktemp -t pdxb-probe-XXXXXX.img)"
    bash tools/mkfs-pdxb.sh "${_r68_probe}" >/dev/null 2>&1
    _r68_probe_rc=$?
    rm -f "${_r68_probe}"
    if [[ "${_r68_probe_rc}" -eq 3 ]]; then
        echo "[pre-push] R68-DISK R54/R55 legs SKIP: mkfs-pdxb binary not built yet"
        echo "           (land paideia-as #1730 then rerun with PAIDEIA_R68_DISK=1)"
    else
        echo "[R68-DISK] running R54 bdev round-trip smoke"
        bash tools/run-smoke.sh boot_r54_bdev_round_trip || exit $?
        echo "[R68-DISK] running R55 pdxfs-block write-e2e smoke"
        bash tools/run-smoke.sh boot_r55_write_e2e || exit $?
    fi

    echo "[R68-DISK] running R56 VFS-metadata composite smoke (dormant scaffold)"
    _r68_r56_out="$(bash tools/run-smoke.sh boot_r56_meta 2>&1)"
    _r68_r56_rc=$?
    if [[ ${_r68_r56_rc} -ne 0 ]]; then
        echo "ERROR: boot_r56_meta failed (rc=${_r68_r56_rc}) -- expected a clean SKIP echo" >&2
        echo "${_r68_r56_out}" >&2
        exit 1
    fi
    while IFS= read -r _r68_line; do
        [[ -z "${_r68_line}" ]] && continue
        if [[ "${_r68_r56_out}" != *"${_r68_line}"* ]]; then
            echo "ERROR: boot_r56_meta output missing expected fragment: ${_r68_line}" >&2
            echo "${_r68_r56_out}" >&2
            exit 1
        fi
    done < "${REPO_ROOT}/tests/expected-r56-meta.golden"
    echo "[pre-push] R68 disk-path composite gate PASS"
fi

