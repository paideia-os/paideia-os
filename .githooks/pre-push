#
#   1. the release fingerprint (banner + copyright + system-ready line)
#      appears in order,
#   2. the total line count fits within RELEASE_LINE_BUDGET (default 40),
#   3. no line contains a round or milestone identifier (R__ / M__-___),
#   4. no line contains a raw hex TSC timestamp (klog drain unmuted?).
#
# Follows the R20b substrate-witness promotion convention: starts as an
# opt-in landing here, promotes to the default matrix after 5/5
# consecutive passes. See design/kernel/boot-presentation.md §6 for
# the mechanism + §7 for a non-vacuousness demonstration.
#
# The boot_release mode ALWAYS rebuilds in release mode before running;
# a subsequent `bash tools/build.sh` (with no env-var) restores the
# tree to test mode by regenerating build_mode.pdx with 0, so this gate
# leaves the working tree in the same effective state as the pre-R49
# default (build_mode.pdx is .gitignored — see the file's header).
if [[ "${PAIDEIA_R49_RELEASE:-0}" == "1" ]]; then
