# R28-M4 #1010: opt-in real-hardware smoke, gated by PAIDEIA_HW_SMOKE=1.
# When set, invokes tools/run-smoke-hw.sh boot_r28_hw_smoke (the R28.M4
# #1008 composite per-subsystem fingerprint). Not in the default matrix
# because the harness requires a physical USB-serial adapter attached to
# a T14 G4 booting the paideia-mvp.img USB; running it unconditionally
# from every push would either time out (no bytes) or misread bytes from
# an unrelated tty device. See tools/hw-smoke-fingerprints.md for the
# per-subsystem catalogue and design/testing/mvp-demo-script.md for the
# operator recipe.
#
# Exit codes we treat as "do not block the push":
#   0    — fingerprint matched
#   2    — serial adapter not present (operator didn't attach one)
#   3    — PAIDEIA_HW_SMOKE gate cleared (defensive; we set it above)
#   77   — fingerprint file not seeded yet (SKIP posture — matches the
#          R22/R24/R25 opt-in-smoke SKIP convention)
#  124   — capture window elapsed with no bytes (T14 never booted)
#
# The only hard-fail path is rc=1 (fingerprint mismatch on captured
# bytes) — a real regression on real HW.
if [[ "${PAIDEIA_HW_SMOKE:-0}" == "1" ]]; then
    echo "[pre-push] R28-M4 real-HW composite smoke (PAIDEIA_HW_SMOKE=1)..."
    bash tools/run-smoke-hw.sh boot_r28_hw_smoke
    rc=$?
    case "${rc}" in
        0)
            echo "[pre-push] R28-M4 HW smoke PASS"
            ;;
        2|3|77|124)
            echo "[pre-push] R28-M4 HW smoke SKIP (rc=${rc}) — not blocking push"
            ;;
        *)
            echo "ERROR: R28-M4 HW smoke fingerprint mismatch (rc=${rc})" >&2
            exit 1
            ;;
    esac
fi

echo "[pre-push] All checks passed. Safe to push."
exit 0
