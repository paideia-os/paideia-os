# R53.M1-006 (#1735): opt-in host-side mkfs-pdxb layout test, gated by
# PAIDEIA_R53_MKFS_TEST=1. Zero QEMU cycle. Runs tools/mkfs-pdxb.sh
# against a mktemp scratch file and struct.unpacks the emitted PDXB
# superblock, asserting every offset frozen in
# design/filesystem/volume-fs-substrate.md §2.1: magic, version, uuid,
# block_size, flags, region descriptors (itable/alloc/journal/data),
# root_inode, sig_key_hash, reserved-zero band, and the flags↔sig
# consistency gate that catches an unsigned mkfs that forgot to set the
# SIG_UNSIGNED flag (or a signed mkfs that forgot to actually sign).
#
# Opt-in rather than default because the sibling wrapper (#1731) landed
# ahead of the paideia-as `mkfs-pdxb` binary (#1730 — not yet built into
# build/tools/); the test itself detects that state and skips with an
# INFO line rather than failing, but a default-on gate would still add
# a subprocess spawn per push for zero coverage until the binary lands.
# Promotes to the default matrix after 5/5 consecutive passes on green
# tree post-#1730. Set PAIDEIA_R53_MKFS_TEST=1 before `git push` to opt
# in.
if [[ "${PAIDEIA_R53_MKFS_TEST:-0}" == "1" ]]; then
    echo "[pre-push] host-side mkfs-pdxb layout test (PAIDEIA_R53_MKFS_TEST=1)..."
    if ! python3 tests/tools/test-mkfs-pdxb.py; then
        echo "ERROR: host-side mkfs-pdxb layout test failed -- a superblock" >&2
        echo "       field drifted from design/filesystem/volume-fs-substrate.md §2.1." >&2
        exit 1
    fi
    echo "[pre-push] host-side mkfs-pdxb layout test PASS"
fi

# R53.M4-006 (#1753): opt-in two-phase disk round-trip smoke, gated by
# PAIDEIA_R53_DISK=1. Runs boot_r53_round_trip end-to-end -- mkfs a PDXB
# image, boot the kernel to mount + write, unmount, boot again to mount +
# read-back, asserting the payload survives the reboot. Same opt-in
# posture as the PAIDEIA_R53_MKFS_TEST gate above (which exercises the
# host-side layout only, no QEMU cycle).
#
# Preflight: probe tools/mkfs-pdxb.sh against a scratch image. If the
# wrapper reports rc=3 (paideia-as mkfs-pdxb binary from #1730 not built
# into build/tools/ yet), print a guidance line and skip rather than
# block the push -- the round-trip smoke cannot even reach the boot
# phase without a real image, and a hard failure here would gate every
# push on a state that only clears when #1730 lands. Any other rc is
# treated as "binary is present" -- the wrapper may still fail on the
# scratch image (e.g. size/flag config), and that surfaces during the
# actual smoke below rather than being swallowed here.
if [[ "${PAIDEIA_R53_DISK:-0}" == "1" ]]; then
    _r53_probe="$(mktemp -t pdxb-probe-XXXXXX.img)"
    bash tools/mkfs-pdxb.sh "${_r53_probe}" >/dev/null 2>&1
    _r53_probe_rc=$?
    rm -f "${_r53_probe}"
    if [[ "${_r53_probe_rc}" -eq 3 ]]; then
        echo "[pre-push] R53-DISK skip: mkfs-pdxb binary not built yet"
        echo "           (land paideia-as #1730 then rerun with PAIDEIA_R53_DISK=1)"
    else
        echo "[R53-DISK] running two-phase round-trip smoke"
        bash tools/run-smoke.sh boot_r53_round_trip || exit $?
    fi
fi

