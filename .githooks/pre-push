#!/usr/bin/env bash
# PaideiaOS pre-push hook — prevent force-push, deletion of main, and run smoke tests.
# Per design/02-development-environment.md §6.5 branch-protection-equivalent.
# R9-m4-002: Smoke test invocation (boot_tick fingerprint).
# R15+: Expanded to a 10-mode regression matrix.
# #659: Each smoke gets one automatic retry after a 1s cooldown to absorb
#       host-load timing flakes; a real regression fails both attempts.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            # Block deletion (local_sha all-zero means we're deleting the remote ref)
            if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
                echo "✗ Refusing to delete remote main." >&2
                exit 1
            fi
            # Block force-push: the new ref must descend from the old
            if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
                if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                    echo "✗ Refusing non-fast-forward push to main (force-push blocked)." >&2
                    echo "  remote: $remote_sha" >&2
                    echo "  local:  $local_sha" >&2
                    exit 1
                fi
            fi
            ;;
    esac
done

cd "${REPO_ROOT}"

# #659: run one smoke mode with a single automatic retry on flake.
run_smoke_with_retry() {
    local mode="$1"
    if bash tools/run-smoke.sh "${mode}" >/dev/null 2>&1; then
        return 0
    fi
    echo "[pre-push] ${mode} tripped, retrying once after 1s cooldown..." >&2
    sleep 1
    if bash tools/run-smoke.sh "${mode}" >/dev/null 2>&1; then
        echo "[pre-push] ${mode} PASS on retry (first attempt was a flake)"
        return 0
    fi
    return 1
}

echo "[pre-push] Running regression matrix..."

echo "[pre-push] no-AML kernel guardrail (#822)..."
if ! bash tools/lint-no-kernel-aml.sh; then
    echo "ERROR: no-AML kernel guardrail failed — see design/acpi/no-aml-in-kernel.md" >&2
    exit 1
fi
echo "[pre-push] no-AML kernel guardrail PASS"

echo "[pre-push] opcode-canary (operator byte-pattern audit)..."
if ! bash tools/opcode-canary.sh; then
    echo "ERROR: opcode-canary failed (BinOp miscompile detected)" >&2
    exit 1
fi
echo "[pre-push] opcode-canary PASS"

for MODE in boot_r8_only boot_r10 boot_r11 boot_r12 boot_r12_denial \
            boot_r14b_hivma boot_r14b_kpti boot_r14b_ipi boot_r14b_loader \
            boot_r17_shell_echo_hello \
            boot_r17_shell_multi_command \
            boot_r17_shell_shutdown \
            boot_r17_shell_child_process \
            boot_smp; do
    echo "[pre-push] Testing ${MODE}..."
    if ! run_smoke_with_retry "${MODE}"; then
        echo "ERROR: ${MODE} failed twice (regression detected)" >&2
        exit 1
    fi
    echo "[pre-push] ${MODE} PASS"
done

# R19.M5 opt-in: UEFI + OVMF boot fixture (#802). Not in the default
# matrix because R19 is still in-progress (M5 boots to the pre-EBS
# hello banner and #UDs at the placeholder LMA — see
# design/roadmap/r19-t14-g4-boot-guide.md §4). Enable per-push with
# `PAIDEIA_UEFI_OVMF=1 git push`.
if [[ "${PAIDEIA_UEFI_OVMF:-0}" == "1" ]]; then
    echo "[pre-push] R19.M5 OVMF boot fixture (opt-in)..."
    if ! bash tools/run-uefi-ovmf.sh >/dev/null 2>&1; then
        # 77 = SKIP (OVMF absent on this host) — do not gate the push
        rc=$?
        if [[ "${rc}" -eq 77 ]]; then
            echo "[pre-push] R19.M5 OVMF SKIPPED (firmware not installed)"
        else
            echo "ERROR: R19.M5 OVMF fixture failed (rc=${rc})" >&2
            exit 1
        fi
    else
        echo "[pre-push] R19.M5 OVMF PASS"
    fi
fi

# R20b.M5-001 (#1563): opt-in echo-server end-to-end closure witness,
# gated by PAIDEIA_R20B_ECHO=1.  Kernel-driven roundtrip proving the R20b
# userspace-server substrate composes (svc_register + sys_svc_lookup +
# sys_ipc_send + sys_ipc_recv + sys_ipc_reply, with byte-exact hdr +
# payload verify per hop).  Emits "R20b ECHO ROUNDTRIP OK" in EVERY boot
# log (unconditionally wired), but only this mode asserts its presence
# alongside the ordered chain of prior R20b M1..M4 witness markers.
# Closes R20b.M5 + the R20b round + the #1015 userspace-server-substrate
# blocker (unblocks #820 acpi_supervisor + #860 pci_enumerator).
#
# Not in the default matrix at initial landing because the M5 witness
# adds ~250 lines of kernel-side orchestration with 4 syscall body calls
# per hop — running it every push doubles the R20b substrate-witness cost
# on a codepath still stabilizing.  Promotes to the default matrix after
# 5/5 consecutive passes.  Set PAIDEIA_R20B_ECHO=1 before `git push` to
# opt in.
if [[ "${PAIDEIA_R20B_ECHO:-0}" == "1" ]]; then
    echo "[pre-push] Testing boot_r20b_echo (PAIDEIA_R20B_ECHO=1)..."
    if ! run_smoke_with_retry "boot_r20b_echo"; then
        echo "ERROR: boot_r20b_echo failed twice (regression detected)" >&2
        exit 1
    fi
    echo "[pre-push] boot_r20b_echo PASS"
fi

# R20b.M6-003 (#1566): opt-in dual-endpoint RPC roundtrip witness,
# gated by PAIDEIA_R20B_RPC=1.  Kernel-driven dual-endpoint roundtrip
# proving the substrate hardening fix documented in
# design/ipc/userspace-server-substrate.md §4.4 (Option A compact
# variant — v1 flags field repurposed as reply_endpoint_id;
# sys_ipc_reply_body reads it and routes the reply to the client's
# reply endpoint instead of the server's own, closing the
# same-endpoint request/reply race).  Emits "R20b RPC ROUNDTRIP OK"
# in EVERY boot log (unconditionally wired after m5_echo_witness_done),
# but only this mode asserts its presence as a narrow slice; the
# fuller boot_r20b_echo fingerprint also carries the M6-003 line.
# Closes R20b.M6 (substrate hardening; unblocks #820 acpi_supervisor
# + #860 pci_enumerator as real userspace tasks).
#
# Not in the default matrix at initial landing because the M6-003
# witness adds ~350 lines of kernel-side orchestration on top of M5.
# Promotes to the default matrix after 5/5 consecutive passes.  Set
# PAIDEIA_R20B_RPC=1 before `git push` to opt in.
if [[ "${PAIDEIA_R20B_RPC:-0}" == "1" ]]; then
    echo "[pre-push] Testing boot_r20b_rpc (PAIDEIA_R20B_RPC=1)..."
    if ! run_smoke_with_retry "boot_r20b_rpc"; then
        echo "ERROR: boot_r20b_rpc failed twice (regression detected)" >&2
        exit 1
    fi
    echo "[pre-push] boot_r20b_rpc PASS"
fi

