#!/usr/bin/env bash
# PaideiaOS pre-push hook — prevent force-push, deletion of main, and run smoke tests.
# Per design/02-development-environment.md §6.5 branch-protection-equivalent.
# R9-m4-002: Smoke test invocation (boot_tick fingerprint).
# R15+: Expanded to a 10-mode regression matrix.
# #659: Each smoke gets one automatic retry after a 1s cooldown to absorb
#       host-load timing flakes; a real regression fails both attempts.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            # Block deletion (local_sha all-zero means we're deleting the remote ref)
            if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
                echo "✗ Refusing to delete remote main." >&2
                exit 1
            fi
            # Block force-push: the new ref must descend from the old
            if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
                if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                    echo "✗ Refusing non-fast-forward push to main (force-push blocked)." >&2
                    echo "  remote: $remote_sha" >&2
                    echo "  local:  $local_sha" >&2
                    exit 1
                fi
            fi
            ;;
    esac
done

cd "${REPO_ROOT}"

# #659: run one smoke mode with a single automatic retry on flake.
run_smoke_with_retry() {
    local mode="$1"
    if bash tools/run-smoke.sh "${mode}" >/dev/null 2>&1; then
        return 0
    fi
    echo "[pre-push] ${mode} tripped, retrying once after 1s cooldown..." >&2
    sleep 1
    if bash tools/run-smoke.sh "${mode}" >/dev/null 2>&1; then
        echo "[pre-push] ${mode} PASS on retry (first attempt was a flake)"
        return 0
    fi
    return 1
}

echo "[pre-push] Running regression matrix..."

echo "[pre-push] no-AML kernel guardrail (#822)..."
if ! bash tools/lint-no-kernel-aml.sh; then
    echo "ERROR: no-AML kernel guardrail failed — see design/acpi/no-aml-in-kernel.md" >&2
    exit 1
fi
echo "[pre-push] no-AML kernel guardrail PASS"

echo "[pre-push] opcode-canary (operator byte-pattern audit)..."
if ! bash tools/opcode-canary.sh; then
    echo "ERROR: opcode-canary failed (BinOp miscompile detected)" >&2
    exit 1
fi
echo "[pre-push] opcode-canary PASS"

# R29.M2-002 (#1024): elaborator negative-and-positive fixture pair
# for the effect-row → cap-set coupling walker (paideia-as#1307).
# Asserts the misdeclaring driver fixture (tests/kernel/drivers/
# elaborator/mmio_effect_without_cap.pdx) fails elaboration with
# C1301 AND its matched-cap companion elaborates clean. Fast enough
# to run in-line with other build-time guardrails (opcode-canary, no-
# AML lint) — no QEMU required.
echo "[pre-push] elaborator-negatives (R29.M2-002 #1024)..."
if ! bash tools/verify-elaborator-negatives.sh; then
    echo "ERROR: elaborator-negatives failed — see tools/verify-elaborator-negatives.sh" >&2
    exit 1
fi
echo "[pre-push] elaborator-negatives PASS"

# R31.M2-1595 (#1595): user-image PT_LOAD extent gate. Rebuilds nothing --
# it reads build/user/*.elf, which tools/build-user.sh has already produced
# by the time any smoke mode runs -- plus a source lint over src/user/*.ld
# that catches the LATENT form of the defect (a hole whose .data is still
# empty, which no ELF-level check can see). Cheap, no QEMU.
echo "[pre-push] user-image-extent (R31.M2-1595 #1595)..."
if ! bash tools/verify-user-image-extent.sh; then
    echo "ERROR: user-image-extent failed -- a user image's PT_LOAD describes a hole," >&2
    echo "       exceeds its page budget, or a linker script jumps the location" >&2
    echo "       counter between two sections sharing one PHDR. See #1595." >&2
    exit 1
fi
echo "[pre-push] user-image-extent PASS"

# R31.M2-1596/1597 (#1596, #1597): _init_caps sidecar gate. Asserts every
# kind a shipped image declares is loader-seedable, and that no two images
# collide on an absolute cap slot in the one global cap_table. Cheap, no QEMU.
echo "[pre-push] cap-sidecars (R31.M2-1596/1597 #1596/#1597)..."
if ! bash tools/verify-user-cap-sidecars.sh; then
    echo "ERROR: cap-sidecars failed -- a user image declares a kind that is not" >&2
    echo "       loader-seedable, or two images name the same absolute cap slot." >&2
    echo "       See #1596/#1597 and design/capabilities/loader-seeded-slot-allocation.md." >&2
    exit 1
fi
echo "[pre-push] cap-sidecars PASS"

# R31.M2 (#1604): init's ring-3 handoff must stay confined to its two
# access sites in kernel_main.pdx, and r12/r13/r14 must stay poisoned
# across the six witness calls that sit between them. Source-only, no
# QEMU. tools/build.sh runs this too; it is repeated here so a push
# cannot land the regression on the strength of a stale build tree.
echo "[pre-push] init-handoff (R31.M2 #1604)..."
if ! bash tools/verify-init-handoff.sh; then
    echo "ERROR: init-handoff failed -- init's ring-3 handoff gained a third" >&2
    echo "       access site, left its span, or the register path came back." >&2
    echo "       See #1604 and the header of tools/verify-init-handoff.sh." >&2
    exit 1
fi
echo "[pre-push] init-handoff PASS"

# R30.M1-001 (#1049) / R30.M1-002 (#1050): userspace AML tokenizer and
# namespace parser. Three things are asserted: that no AML source has
# drifted under src/kernel/** (files, where lint-no-kernel-aml.sh polices
# identifiers); that each module's private storage is relocated against
# only from its own object, which is what keeps the lexer's
# bounds-check invariant enforceable; and that the byte-fixture corpus in
# tests/user/aml/aml_harness.c passes, with every fixture loaded against a
# PROT_NONE guard page so an out-of-bounds read on malformed firmware
# input is a hard failure rather than a silent over-read.
#
# Build-time rather than a QEMU witness by design: at R30.M1 no runtime
# path feeds this code a DSDT, so a boot witness could only prove linkage
# while the corpus proves behaviour. See the header of
# tools/verify-aml-parser.sh.
echo "[pre-push] aml-parser (R30.M1 #1049-#1053, R30.M2 #1054-#1060, R30.M3 #1062-#1065)..."
if ! bash tools/verify-aml-parser.sh; then
    echo "ERROR: aml-parser failed — see tools/verify-aml-parser.sh" >&2
    exit 1
fi
echo "[pre-push] aml-parser PASS"

# R30.M9-001 (#1085) / R30.M9-003 (#1087): the AML fuzz regression corpus
# and the deterministic cost budget.
#
# THREE THINGS RUN AND EACH ANSWERS A DIFFERENT QUESTION. (1) Replay
# re-runs every entry in tests/fuzz/aml/corpus/ and asserts its full
# recorded outcome vector EXACTLY — every entry is an input that once
# reached a verdict no other entry reached, so this is a regression test
# forever. (2) The budget gate asserts the baseline fixtures still cost
# what they cost, in fuel steps and peak depth/frames rather than in
# milliseconds; design/acpi/perf-methodology.md §1 records why the
# wall-clock form of #1087's budget cannot honestly be measured yet.
# (3) A short fixed-seed soak runs the structured mutators for real
# against a SCRATCH copy of the corpus, so promotion cannot dirty the
# working tree — without it a mutator that silently stopped producing
# parseable output would never be noticed and the fuzzer would degrade
# into a no-op while still reporting PASS.
#
# Deterministic and fast (well under a second); the long soak is an
# operator action, not a gate. See design/acpi/fuzz-strategy.md §4.1.
echo "[pre-push] aml-fuzz (R30.M9 #1085/#1087)..."
if ! bash tools/verify-aml-fuzz.sh; then
    echo "ERROR: aml-fuzz failed — see design/acpi/fuzz-strategy.md" >&2
    exit 1
fi
echo "[pre-push] aml-fuzz PASS"

# R49.M3 (#1578): emitted-vs-asserted fingerprint coverage.
# R30.M9 note — WHY THIS IS ONLY NOW IN THE HOOK. #1578 built this gate
# and two successive iterations then ran it BY HAND, which means the gate
# that exists to stop an unwitnessed marker being introduced was itself
# relying on somebody remembering. That is the same defect one level up:
# a guardrail nobody is forced through is a guardrail that eventually
# is not run. It is a sub-second python scan over the tree, so there is
# no cost argument for leaving it out.
echo "[pre-push] fingerprint-coverage (R49.M3 #1578)..."
if ! bash tools/verify-fingerprint-coverage.sh; then
    echo "ERROR: fingerprint-coverage failed — a printed 'OK' marker is asserted" >&2
    echo "       by no golden. Assert it, or justify an allowlist entry." >&2
    exit 1
fi
echo "[pre-push] fingerprint-coverage PASS"

# Atomics byte-pattern audit — same argument as above: it was hook-absent
# and hand-run. It checks the emitted encodings of the LOCK-prefixed
# instructions the schedulers and the Global Lock depend on, which is
# precisely the class of defect no behavioural test observes.
echo "[pre-push] atomics..."
if ! bash tools/verify-atomics.sh; then
    echo "ERROR: atomics failed (LOCK-prefix encoding regression)" >&2
    exit 1
fi
echo "[pre-push] atomics PASS"

for MODE in boot_r8_only boot_r10 boot_r11 boot_r12 boot_r12_denial \
            boot_r14b_hivma boot_r14b_kpti boot_r14b_ipi boot_r14b_loader \
            boot_r17_shell_echo_hello \
            boot_r17_shell_multi_command \
            boot_r17_shell_shutdown \
            boot_r17_shell_child_process \
            boot_smp; do
    echo "[pre-push] Testing ${MODE}..."
    if ! run_smoke_with_retry "${MODE}"; then
        echo "ERROR: ${MODE} failed twice (regression detected)" >&2
        exit 1
    fi
    echo "[pre-push] ${MODE} PASS"
done

