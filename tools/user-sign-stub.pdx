// tools/user-sign-stub.pdx — user-space stub for libpdx-volume's signing
// entry points.
//
// libpdx-volume/src/pdxb_sign.pdx's `pdxb_sign_superblock` etc. call
// paideia-as's `MlDsa65::sign` trait, which lowers to an `extern "C"
// mldsa65_sign_runtime_entry` thunk hosted in the paideia-as Rust
// runtime (paideia-pq-sign::ffi). That thunk exists only in a Rust-
// linked artifact (paideia-as itself, kernel objects, host tools);
// a ring-3 user ELF cannot reach it.
//
// R64v2.POS-001 (#1976): the R64v2 tool ELFs (mkfs.pdxfs, umount.pdxfs)
// therefore link this stub in place of pdxb_sign.o. Every entry returns
// a stub sentinel that the calling tool routes to a SIG_UNAVAILABLE /
// DEVICE_TARGET_STUB result_code path. Real signing awaits a userspace
// mldsa65_sign host — plausibly a new libpdx-key that opens a KIND_
// SIG_KEY cap and forwards to the kernel via a sig-service syscall.
//
// The three signatures below must match libpdx-volume/src/pdxb_sign.pdx
// byte-for-byte. Any mismatch produces a link-time error that is a
// louder signal than a runtime surprise, so the discipline holds.

module UserSignStub = structure {

  // Return-code contract mirrors libpdx-volume: 3309 (MLDSA65_SIG_LEN)
  // on success, non-zero on failure. Stub always returns
  // 0xFFFFFFFFFFFFFFFE (PDXB_SIGN_STUB — one below the verify stub's
  // 0xFF..FF, distinct so a caller inspecting can tell them apart).
  //
  // Every entry point uses a bare `mov rax; ret` — no push/pop, no
  // callee-save concerns since nothing survives the call.

  pub let pdxb_sign_superblock : (u64, u64, u64, u64) -> u64 !{crypto, mem} @{paideia.crypto} =
    fn (sb_ptr: u64) (seed_ptr: u64) (out_sig_ptr: u64) (out_sig_len: u64) -> unsafe {
      effects: {crypto, mem}, capabilities: {paideia.crypto},
      justification: "paideia-os#1976 user-space sign stub. mldsa65_sign_runtime_entry (Rust-runtime extern-C thunk) is unreachable from a ring-3 ELF. Return PDXB_SIGN_STUB (0xFFFFFFFFFFFFFFFE) so the tool's caller routes to its stubbed sign path (mkfs: DEVICE_STUB / SIG_STUB; umount: SIG_KEY_LOCKED). Labels prefixed uss_.",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret;
      }
    }

  pub let pdxb_sign_inode_tail : (u64, u64, u64, u64, u64) -> u64 !{crypto, mem} @{paideia.crypto} =
    fn (inode_ptr: u64) (tail_offset: u64) (tail_len: u64) (seed_ptr: u64) (out_sig_ptr: u64) -> unsafe {
      effects: {crypto, mem}, capabilities: {paideia.crypto},
      justification: "paideia-os#1976 user-space sign stub. Same rationale as pdxb_sign_superblock. Labels prefixed usi_.",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFE;
        ret;
      }
    }

  pub let pdxb_verify_inode_tail : (u64, u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (inode_ptr: u64) (tail_offset: u64) (tail_len: u64) (sig_ptr: u64) (sig_len: u64) (pub_key_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "paideia-os#1976 user-space verify stub. mldsa65_verify intrinsic doesn't exist at all (libpdx-volume flags this in its own architecture.md §8). Matches libpdx-volume's own fail-closed posture — returns PDXB_VER_ERR_NOT_IMPLEMENTED (0xFFFFFFFFFFFFFFFF). Labels prefixed usv_.",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      }
    }
}
