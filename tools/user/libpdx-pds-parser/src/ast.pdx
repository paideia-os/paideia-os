  //   out of range (`node_ref == 0` or `node_ref >= _ast_pool_next`);
  //   the void return has no error-code surface. Callers pass the
  //   handle they just received from `_ast_alloc`, which the module
  //   trusts.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ast_sp_.
  // ==========================================================================
  pub let _ast_set_payload_u32 : (u64, u64) -> () !{mem} @{} =
    fn (node_ref: u64) (payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_set_payload_u32 overwrites the u32 payload slot at [+12] of the given SyntaxNode. Pure leaf; zero pushes; no stack frame; no nested CALL. Validate node_ref: cmp rdi, 0 je ast_sp_done; load _ast_pool_next via `lea r11,[rip+_ast_pool_next]; mov rax,[r11]`; cmp rdi, rax; jae ast_sp_done. Compute node_addr via `mov r10, rdi; shl r10, 5; lea r11, [rip + _ast_node_pool]; add r10, r11`. Store payload as u32 at [+12] via `mov_d [r10+12], rsi`. All immediates (0) imm8-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_sp_.",
      block: {
        // Validate node_ref != 0.
        cmp rdi, 0;
        je  ast_sp_done;

        // Validate node_ref < _ast_pool_next.
        lea r11, [rip + _ast_pool_next];
        mov rax, [r11];
        cmp rdi, rax;
        jae ast_sp_done;

        // Compute node_addr = &_ast_node_pool + node_ref * 32.
        mov r10, rdi;
        shl r10, 5;
        lea r11, [rip + _ast_node_pool];
        add r10, r11;

        // Store payload u32 at [+12].
        mov_d [r10 + 12], rsi;

      ast_sp_done:
        ret;
      }
    }

  // ==========================================================================
  // _ast_set_child_ref(node_ref, child_array_ref) -> ()
  //
  //   rdi = node_ref           -- pool_idx returned by _ast_alloc
