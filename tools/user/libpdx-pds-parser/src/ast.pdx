  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ast_se_.
  // ==========================================================================
  pub let _ast_set_extra_ref : (u64, u64) -> () !{mem} @{} =
    fn (node_ref: u64) (extra_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_set_extra_ref overwrites the u64 extra_ref slot at [+24] of the given SyntaxNode. Pure leaf; zero pushes; no stack frame; no nested CALL. Validate node_ref: cmp rdi, 0 je ast_se_done; load _ast_pool_next via `lea r11,[rip+_ast_pool_next]; mov rax,[r11]`; cmp rdi, rax; jae ast_se_done. Compute node_addr via `mov r10, rdi; shl r10, 5; lea r11, [rip + _ast_node_pool]; add r10, r11`. Store extra_ref as u64 at [+24] via `mov [r10+24], rsi`. All immediates (0) imm8-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_se_.",
      block: {
        // Validate node_ref != 0.
        cmp rdi, 0;
        je  ast_se_done;

        // Validate node_ref < _ast_pool_next.
        lea r11, [rip + _ast_pool_next];
        mov rax, [r11];
        cmp rdi, rax;
        jae ast_se_done;

        // Compute node_addr.
        mov r10, rdi;
        shl r10, 5;
        lea r11, [rip + _ast_node_pool];
        add r10, r11;

        // Store extra_ref u64 at [+24].
        mov [r10 + 24], rsi;

      ast_se_done:
