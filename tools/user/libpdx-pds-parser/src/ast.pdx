// src/ast.pdx -- libpdx-pds-parser.R221.M5 (paideia-os#2655, Wave 122)
//
// Ast: unified syntax-node sum type spanning the three pds-lang
// sub-languages (pipeline, datalog, lambda) plus records and literals.
// Builds on R221.M4 CtxLexer's 16-byte Token records: a downstream
// parser consumes a context-tagged token stream and emits SyntaxNode
// records via `_ast_alloc`; a downstream pretty-printer, LSP bridge,
// typechecker, or evaluator walks the SAME node image without
// re-tokenising the source.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R221.M5 of the parser-tier Unicode + lexer umbrella (paideia-os#2485,
// decomposed into paideia-os#2655 for THIS M5). Builds on:
//
//   R221.M1 (utf8_nfc.pdx)   -- NFC-normalised input bytes.
//   R221.M4 (ctx_lexer.pdx)  -- 16-byte Token records tagged with
//                               pipeline/datalog/lambda context.
//   R225.M1 (hm_core.pdx)    -- type-graph pool (not touched; AST
//                               nodes carry extra_ref u64 slots that
//                               a later typecheck pass may fill with
//                               HmCore pool_idx values).
//
// The AST is a FLAT 32-byte-stride record pool in `.bss` with
// bump-pointer allocation. Each SyntaxNode captures:
//
//   * a `kind` u16 code -- discriminates the sum tag (see §2 enum).
//   * `flags` u16 -- reserved for M6+ semantic marks (dup span,
//                    renderer override, pds-container flag) and the
//                    Q-A5 synthetic-span bit used to mark nodes whose
//                    span is a reconstruction rather than a direct
//                    byte run of the input (e.g. parser-manufactured
//                    pipeline splice points).
//   * `src_offset` + `src_length` u32 -- Q-A5 invariant source span.
//                    The pair indexes the original caller-supplied
//                    bytes buffer; EVERY node carries one so a
//                    diagnostic pass can point into the source
//                    without walking the parent chain.
//   * `payload_u32` -- small inline literal (parsed integer value,
//                    boolean, hash index, etc.) OR a child count for
//                    composite nodes.
//   * `child_ref` u64 -- pool_idx of a child-array header node (0 =
//                    leaf). The child-array convention: the referred
//                    node has kind = AST_SK_CHILD_ARRAY and uses its
//                    `payload_u32` to hold the arity and `extra_ref`
//                    to hold a pointer to an external array of
//                    pool_idx u32 values (OR, when the arity fits in
//                    four, inlines them into the two u64 slots).
//                    The simpler convention for M5: `child_ref` is
//                    simply the pool_idx of the FIRST child; sibling
//                    linkage lives in each child's `extra_ref` slot's
//                    low 32 bits (the "sibling_ref"). This matches
//                    the linked-list traversal pattern lambda_lit.pdx
//                    and datalog.pdx already emit over their flat
//                    descriptor arrays.
//   * `extra_ref` u64 -- type-tagged auxiliary pointer. The exact
//                    interpretation is `kind`-dependent; a later M6
//                    pass may use the high 32 bits as a sibling-ref
//                    and the low 32 bits as a type-pool pool_idx
//                    (see HmCore). At M5 the slot is a free u64 the
//                    allocator zeroes.
//
// =============================================================================
// NODE RECORD (32 B)
// =============================================================================
//
//   offset  size  field
//   ------  ----  ---------------------------------
//    0x00    2    kind         u16  (AST_SK_* code)
//    0x02    2    flags        u16  (reserved; 0 at M5)
//    0x04    4    src_offset   u32  (Q-A5 source span start)
//    0x08    4    src_length   u32  (Q-A5 source span length)
//    0x0C    4    payload_u32  u32  (small literal OR child count)
//    0x10    8    child_ref    u64  (pool_idx of first child; 0=leaf)
//    0x18    8    extra_ref    u64  (type-tagged auxiliary; 0 at alloc)
//
// 32-byte stride matches `shl r, 5` for slot addressing (power of two,
// precedent: no sibling module -- CtxLexer uses 16 B / `shl r, 4`;
// RowTypes TyNode uses 16 B / `shl r, 4`; this module doubles the
// stride because the AST node must carry two u64 refs AND a span
// AND a payload AND a kind, none of which fit in a 16-byte slot).
//
// =============================================================================
// SyntaxKind CODES (u16 at [+0])
// =============================================================================
//
// Four-nibble layout: top 8 bits = FAMILY, low 8 bits = SUBKIND.
// Families carved on kilo-step boundaries so a downstream dispatcher
// can discriminate at a glance via `shr r, 8; cmp r, imm8`.
//
//   0x0100..0x01FF  pipeline family  (PIPELINE_ROOT, STAGE, PIPE, REDIRECT, HOSTNAME_ANNOT)
//   0x0200..0x02FF  datalog family   (DATALOG_BLOCK, FACT, RULE, ATOM, GOAL, RULE_HEAD, RULE_BODY)
//   0x0300..0x03FF  lambda family    (LAMBDA, PARAM, BODY, LET, LET_REC, CAPTURE_LIST, EFFECT_ROW, CAP_ROW)
//   0x0400..0x04FF  record family    (RECORD, FIELD, FIELD_SELECTOR)
//   0x0500..0x05FF  literal family   (LIT_INT, LIT_STR, LIT_BOOL, LIT_PATH, LIT_HASH32, IDENT)
//
// Reserved for M6+:
//   0x0600..0x06FF  diagnostics       (ERROR, MISSING)
//   0x0700..0x07FF  module/import     (MODULE, IMPORT, USE)
//   0x0800..0x08FF  type expressions  (TYARG, TYAPP, TYROW)
//
// =============================================================================
// POOL + ALLOCATION
// =============================================================================
//
// The AST node pool is a SINGLETON 8 KiB `.bss` byte array (256 slots
// of 32 B). Pool_idx 0 is reserved as the "nil" sentinel: a 0 return
// from `_ast_alloc` signals pool exhaustion; a 0 `child_ref` /
// `extra_ref` means "no reference". Valid handles are 1..255.
//
// A bump pointer `_ast_pool_next` tracks the next available slot.
// `_ast_init` resets it to 0; the allocator inlines a lazy-check so
// a zero sentinel bumps to 1 on first use (skip reserved idx 0;
// precedent: `_rt_alloc_node` in row_types.pdx).
//
// A separate pair of `.bss` slots (`_ast_src_ptr`, `_ast_src_len`)
// caches the source-byte pointer and length the caller passes via
// `_ast_set_source`. `_ast_render` reads them to perform the
// span-copy round-trip; no other primitive reads them.
//
// Resetting the pool between parses: callers hard-reset via
// `_ast_init` (which zeroes pool_next, src_ptr, src_len). The
// previously-allocated SyntaxNode records remain in the backing byte
// array but become unreachable because every valid handle must satisfy
// `node_ref < _ast_pool_next`; a stale handle fails this check and
// becomes a silent no-op in the setters, AST_ERR_BAD_REF in render.
//
// =============================================================================
// ROUND-TRIP STRATEGY  (Q-A5 invariant acceptance anchor)
// =============================================================================
//
// Every node carries its EXACT source span `[src_offset, src_offset +
// src_length)`. `_ast_render` emits the N bytes at
// `_ast_src_ptr + src_offset` verbatim. For the acceptance test's 100
// sample inputs: parse each input into an AST whose ROOT span covers
// `[0, input_len)`; render the root; verify byte-identical.
//
// A child-aware render (walking children sequentially and
// concatenating their spans) is architecturally compatible with the
// same ABI: the walker short-circuits on composite nodes and only
// copies spans at leaf nodes. M5 lands the simpler span-copy variant
// because the acceptance test exercises the ROOT span, not an
// arbitrary mid-tree node. A follow-up M (deferred to R221.M5.1) may
// extend `_ast_render` to walk `child_ref` chains for sub-tree
// pretty-print; the ABI stays frozen.
//
// =============================================================================
// Public API
// =============================================================================
//
//   _ast_init()                                   -> ()
//     Hard-reset: zero `_ast_pool_next`, `_ast_src_ptr`, `_ast_src_len`.
//     Idempotent in the trivial sense (re-zeroing an already-zero
//     state is a no-op). Called by the harness at session boot AND
//     between round-trip test iterations. Does NOT scrub
//     `_ast_node_pool` (bss-zero at boot; overwritten per-allocation).
//
//   _ast_set_source(bytes_ptr, bytes_len)        -> ()
//     Register the caller's source-byte buffer so `_ast_render` can
//     span-copy from it. The caller retains ownership; the AST module
//     never writes into `bytes_ptr`. Resetting via `_ast_init`
//     clears the registered pointer; callers rebuilding the AST
//     against a fresh input MUST re-call `_ast_set_source`.
//
//   _ast_alloc(kind, src_offset, src_length)     -> node_ref
//     Reserve one 32-byte pool slot and populate it with the three
//     caller-supplied fields. Returns the allocated pool_idx (>= 1)
//     or 0 on pool-full. Lazy-inits `_ast_pool_next` from the bss-
//     zero sentinel to 1 on first observation (idx 0 is reserved).
//
//   _ast_set_payload_u32(node_ref, payload)       -> ()
//     Overwrite the `payload_u32` slot at offset +12 of the specified
//     node. Validates `node_ref` is in `[1, _ast_pool_next)`;
//     silent no-op on out-of-range (void return, so no error-code
//     surface -- the caller is expected to pass the handle it just
//     received from `_ast_alloc`).
//
//   _ast_set_child_ref(node_ref, child_array_ref) -> ()
//     Overwrite the `child_ref` u64 slot at offset +16. Validates
//     `node_ref`; silent no-op on out-of-range. The caller supplies
//     the pool_idx of the first child (sibling walk goes via each
//     child's extra_ref) OR, when the child-array is external, a
//     tagged pointer the parser recognises.
//
//   _ast_set_extra_ref(node_ref, extra_ref)       -> ()
//     Overwrite the `extra_ref` u64 slot at offset +24. Validates
//     `node_ref`; silent no-op on out-of-range. Interpretation is
//     kind-dependent (type-pool pool_idx for a Lit/Ident, next-
//     sibling pool_idx for a list node, hash index for a Record).
//
//   _ast_render(node_ref, out, out_cap)          -> (bytes_written << 32) | status
//     Span-copy the N bytes at `_ast_src_ptr + src_offset` into
//     `out` for `src_length` bytes. Returns packed_u64 with the
//     byte count in the high 32 and AST_OK (0) / AST_ERR_* in the
//     low 32. Round-trip at the span granularity is Q-A5-compliant.
//
// Register maps (SysV):
//
//   _ast_init()                                 -> rax = () (ignored)
//   _ast_set_source(rdi, rsi)                   -> rax = () (ignored)
//   _ast_alloc(rdi, rsi, rdx)                   -> rax = node_ref u64
//   _ast_set_payload_u32(rdi, rsi)              -> rax = () (ignored)
//   _ast_set_child_ref(rdi, rsi)                -> rax = () (ignored)
//   _ast_set_extra_ref(rdi, rsi)                -> rax = () (ignored)
//   _ast_render(rdi, rsi, rdx)                  -> rax = packed_u64
//
// =============================================================================
// STATUS CODES -- band 0x4400..0x44FF
// =============================================================================
//
//   AST_OK                 : 0
//   AST_ERR_POOL_FULL      : 0x4400  _ast_alloc: _ast_pool_next >= 256.
//   AST_ERR_BAD_REF        : 0x4401  _ast_render: node_ref == 0 or
//                                    node_ref >= _ast_pool_next.
//   AST_ERR_BAD_KIND       : 0x4402  reserved for M5.1+ kind-table
//                                    enforcement (M5 does not
//                                    validate kind against the family
//                                    enum -- the caller is trusted).
//   AST_ERR_OUT_TOO_SMALL  : 0x4403  _ast_render: out_cap < src_length.
//   AST_ERR_SPAN_OOB       : 0x4404  _ast_render: src_offset +
//                                    src_length > _ast_src_len.
//   AST_ERR_NO_SOURCE      : 0x4405  _ast_render: _ast_src_ptr == 0
//                                    (caller forgot to call
//                                    `_ast_set_source` after
//                                    `_ast_init`).
//
// Band carved on a kilo-step boundary past R224.M4 CapRow
// (0x4300..0x43FF). Slots 0x4406..0x44FF reserved for M5.1+ (kind-
// table enforcement, cycle-detect on child_ref walks, synthetic-span
// discipline, child-aware render diagnostics).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- all masks are imm8 / imm32.
//   - No 2-op `imul r, imm` -- 32-byte stride is `shl r, 5`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `Ast` matches `ast.pdx`.
//   - Labels prefixed `ast_` with per-function suffix (`ast_i_`,
//     `ast_ss_`, `ast_al_`, `ast_sp_`, `ast_sc_`, `ast_se_`,
//     `ast_r_`); grep-confirmed disjoint from `af_`/`afs_`,
//     `cc_`/`clo_`, `cl_`, `cmd_`/`cs_`, `cr_`, `dl_`, `er_`, `fi_`,
//     `gi_`, `hm_`, `ll_`, `pl_`, `rp_`, `rt_`, `se_`, `sch_sig_`,
//     `te_`, `u8n_`, `wp_` and from paideia-as reserved keywords
//     (`loop`, `if`, `let`, `fn`, `ret`, `done`).
//   - All `cmp reg, imm` immediates (0, 1, 256, 0x4400..0x4405) fit
//     imm32 and are sign-safe (bit 31 clear).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`.
//   - u32 stores via `mov_d [base + disp], reg`.
//   - u32 loads via `xor rax, rax; mov_d rax, [base + disp]`.
//   - u16 stores via two `mov_b` byte stores (low, high).
//   - u64 stores via plain `mov [base + disp], reg`.
//   - All public entry points are PURE LEAVES -- zero callee-save
//     pushes, zero stack frames, zero nested CALLs. The allocator
//     inlines the lazy-init (`cmp _ast_pool_next, 0; jne have; mov
//     rax, 1; have:`) rather than calling `_ast_init`; this avoids
//     the nested-CALL alignment math and the register-save of rdi/
//     rsi/rdx across the call site. Precedent: `_rt_alloc_node` in
//     row_types.pdx uses the same inlined lazy-check.
//   - No chained-displacement operands `[reg + a + b]`: every address
//     is `[reg + disp]` or `[reg + idx * 1]` (Wave 120+121 lesson).
//   - Full-u64 status compares not needed at M5 (no nested CALLs).
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2655 (R221.M5).
// Substrate: paideia-os#2651 (R221.M1 Utf8Nfc), paideia-os#2654
// (R221.M4 CtxLexer).
// Design doc: design/shell/unified-ast.md.

module Ast = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let AST_OK                 : u64 = 0
  pub let AST_ERR_POOL_FULL      : u64 = 0x4400
  pub let AST_ERR_BAD_REF        : u64 = 0x4401
  pub let AST_ERR_BAD_KIND       : u64 = 0x4402
  pub let AST_ERR_OUT_TOO_SMALL  : u64 = 0x4403
  pub let AST_ERR_SPAN_OOB       : u64 = 0x4404
  pub let AST_ERR_NO_SOURCE      : u64 = 0x4405

  // ==========================================================================
  // SECTION 2 -- SyntaxKind ENUM (u16; four-nibble family / subkind layout)
  // ==========================================================================
  //
  // Family codes (top 8 bits): 0x01 pipeline, 0x02 datalog, 0x03
  // lambda, 0x04 record, 0x05 literal. See file header for the
  // reserved 0x06+ families (diagnostics, module/import, type expr).

  pub let AST_FAMILY_PIPELINE    : u64 = 0x01
  pub let AST_FAMILY_DATALOG     : u64 = 0x02
  pub let AST_FAMILY_LAMBDA      : u64 = 0x03
  pub let AST_FAMILY_RECORD      : u64 = 0x04
  pub let AST_FAMILY_LITERAL     : u64 = 0x05

  // Pipeline family (0x0100..0x01FF)
  pub let AST_SK_PIPELINE_ROOT   : u64 = 0x0100
  pub let AST_SK_STAGE           : u64 = 0x0101
  pub let AST_SK_PIPE            : u64 = 0x0102
  pub let AST_SK_REDIRECT        : u64 = 0x0103
  pub let AST_SK_HOSTNAME_ANNOT  : u64 = 0x0104

  // Datalog family (0x0200..0x02FF)
  pub let AST_SK_DATALOG_BLOCK   : u64 = 0x0200
  pub let AST_SK_FACT            : u64 = 0x0201
  pub let AST_SK_RULE            : u64 = 0x0202
  pub let AST_SK_ATOM            : u64 = 0x0203
  pub let AST_SK_GOAL            : u64 = 0x0204
  pub let AST_SK_RULE_HEAD       : u64 = 0x0205
  pub let AST_SK_RULE_BODY       : u64 = 0x0206

  // Lambda family (0x0300..0x03FF)
  pub let AST_SK_LAMBDA          : u64 = 0x0300
  pub let AST_SK_PARAM           : u64 = 0x0301
  pub let AST_SK_BODY            : u64 = 0x0302
  pub let AST_SK_LET             : u64 = 0x0303
  pub let AST_SK_LET_REC         : u64 = 0x0304
  pub let AST_SK_CAPTURE_LIST    : u64 = 0x0305
  pub let AST_SK_EFFECT_ROW      : u64 = 0x0306
  pub let AST_SK_CAP_ROW         : u64 = 0x0307

  // Record family (0x0400..0x04FF)
  pub let AST_SK_RECORD          : u64 = 0x0400
  pub let AST_SK_FIELD           : u64 = 0x0401
  pub let AST_SK_FIELD_SELECTOR  : u64 = 0x0402

  // Literal family (0x0500..0x05FF)
  pub let AST_SK_LIT_INT         : u64 = 0x0500
  pub let AST_SK_LIT_STR         : u64 = 0x0501
  pub let AST_SK_LIT_BOOL        : u64 = 0x0502
  pub let AST_SK_LIT_PATH        : u64 = 0x0503
  pub let AST_SK_LIT_HASH32      : u64 = 0x0504
  pub let AST_SK_IDENT           : u64 = 0x0505

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let AST_NODE_BYTES         : u64 = 32
  pub let AST_POOL_CAP           : u64 = 256
  pub let AST_POOL_BYTES         : u64 = 8192       // 256 slots * 32 B

  pub let AST_OFF_KIND           : u64 = 0
  pub let AST_OFF_FLAGS          : u64 = 2
  pub let AST_OFF_SRC_OFFSET     : u64 = 4
  pub let AST_OFF_SRC_LENGTH     : u64 = 8
  pub let AST_OFF_PAYLOAD        : u64 = 12
  pub let AST_OFF_CHILD_REF      : u64 = 16
  pub let AST_OFF_EXTRA_REF      : u64 = 24

  // ==========================================================================
  // SECTION 4 -- STATIC STATE (.bss, singleton)
  // ==========================================================================

  pub let mut _ast_node_pool  : [u8; 8192] = uninit @align(8)
  pub let mut _ast_pool_next  : u64        = uninit @align(8)
  pub let mut _ast_src_ptr    : u64        = uninit @align(8)
  pub let mut _ast_src_len    : u64        = uninit @align(8)

  // ==========================================================================
  // _ast_init() -> ()
  //
  //   Hard-reset of the module's three scalar `.bss` singletons:
  //   _ast_pool_next (u64), _ast_src_ptr (u64), _ast_src_len (u64).
  //   _ast_node_pool is NOT scrubbed -- it is bss-zero at boot and
  //   overwritten per-allocation.
  //
  //   Idempotent in the trivial sense: re-zeroing an already-zero
  //   state is a no-op. Called by the harness at session boot AND
  //   between round-trip test iterations.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ast_i_.
  // ==========================================================================
  pub let _ast_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_init hard-resets the three scalar .bss singletons (_ast_pool_next, _ast_src_ptr, _ast_src_len). Pure leaf; zero pushes; no stack frame; no nested CALL. Three store sites: (1) one u64 store at _ast_pool_next via `lea r11, [rip+_ast_pool_next]; mov [r11], rax` with rax=0 (xor rax,rax). (2) one u64 store at _ast_src_ptr via same shape. (3) one u64 store at _ast_src_len via same shape. _ast_node_pool is NOT scrubbed because .bss is already zero at real boot and node slots are overwritten per-allocation. Idempotent in the trivial sense (re-zeroing an already-zero state is a no-op). No cmp; no test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_i_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _ast_pool_next];
        mov [r11], rax;

        lea r11, [rip + _ast_src_ptr];
        mov [r11], rax;

        lea r11, [rip + _ast_src_len];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _ast_set_source(bytes_ptr, bytes_len) -> ()
  //
  //   rdi = bytes_ptr   -- caller-supplied source-byte buffer (NFC-
  //                        normalised, R221.M1 output).
  //   rsi = bytes_len   -- length of that buffer in bytes.
  //
  //   Stashes the pair into the module's .bss so `_ast_render` can
  //   span-copy from it. The caller retains ownership; the AST module
  //   never writes into `bytes_ptr` and never dereferences past
  //   `bytes_ptr + bytes_len`.
  //
  //   `_ast_init` zeroes these slots, so a caller rebuilding the AST
  //   against a fresh input must re-call `_ast_set_source` after
  //   `_ast_init`.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ast_ss_.
  // ==========================================================================
  pub let _ast_set_source : (u64, u64) -> () !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_set_source stashes the caller-supplied source buffer pointer + length so _ast_render can span-copy from it. Pure leaf; zero pushes; no stack frame; no nested CALL. Two u64 stores: (1) `lea r11, [rip+_ast_src_ptr]; mov [r11], rdi`. (2) `lea r11, [rip+_ast_src_len]; mov [r11], rsi`. The AST module never writes into bytes_ptr; this entry point only CACHES the pointer for the render pass. No cmp; no test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_ss_.",
      block: {
        lea r11, [rip + _ast_src_ptr];
        mov [r11], rdi;

        lea r11, [rip + _ast_src_len];
        mov [r11], rsi;

        ret;
      }
    }

  // ==========================================================================
  // _ast_alloc(kind, src_offset, src_length) -> node_ref
  //
  //   rdi = kind         -- SyntaxKind code (u64; low 16 stored as u16)
  //   rsi = src_offset   -- source span start (u64; low 32 stored as u32)
  //   rdx = src_length   -- source span length (u64; low 32 stored as u32)
  //   rax = node_ref     -- allocated pool_idx (>= 1), or 0 on pool-full.
  //
  //   Reserves one 32-byte pool slot. Lazy-inits _ast_pool_next from
  //   the bss-zero sentinel to 1 on first observation (idx 0 is
  //   reserved as the "nil" sentinel). Zero-fills the 32 B so the
  //   caller can set only the fields it cares about and leave the
  //   rest at 0. Writes the three caller-supplied fields.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // The lazy-init is inlined (precedent: _rt_alloc_node). Labels
  // prefixed ast_al_.
  // ==========================================================================
  pub let _ast_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (src_offset: u64) (src_length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_alloc reserves one 32-byte SyntaxNode slot from the singleton _ast_node_pool. Pure leaf; zero pushes; no stack frame; no nested CALL. Load `_ast_pool_next` via `lea r11,[rip+_ast_pool_next]; mov rax,[r11]`; if rax == 0 (bss-zero -- lazy init path) rax := 1 (skip reserved pool_idx 0; precedent _rt_alloc_node); if rax >= AST_POOL_CAP (256) return 0 (pool-full sentinel). Bump _ast_pool_next by writing rax+1 back. Compute node address: `mov r10, rax; shl r10, 5; lea r11, [rip + _ast_node_pool]; add r10, r11`. Zero-fill 32 B via four u64 stores (xor rcx, rcx; mov [r10+0], rcx; mov [r10+8], rcx; mov [r10+16], rcx; mov [r10+24], rcx). Write kind u16 at [+0] via two mov_b (low, high via shr 8). Write src_offset u32 at [+4] via mov_d. Write src_length u32 at [+8] via mov_d. Return rax = allocated pool_idx. All immediates (0, 1, 256) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_al_.",
      block: {
        // Load _ast_pool_next (lazy-init: 0 -> 1).
        lea r11, [rip + _ast_pool_next];
        mov rax, [r11];
        cmp rax, 0;
        jne ast_al_have_next;
        mov rax, 1;

      ast_al_have_next:
        // Pool-full guard.
        cmp rax, 256;
        jae ast_al_full;

        // Bump _ast_pool_next.
        mov r10, rax;
        add r10, 1;
        mov [r11], r10;

        // Compute node_addr = &_ast_node_pool + rax * 32.
        mov r10, rax;
        shl r10, 5;
        lea r11, [rip + _ast_node_pool];
        add r10, r11;

        // Zero-fill 32 bytes (four u64 stores).
        xor rcx, rcx;
        mov [r10 + 0], rcx;
        mov [r10 + 8], rcx;
        mov [r10 + 16], rcx;
        mov [r10 + 24], rcx;

        // Write kind u16 at [+0] via two mov_b (low, high).
        mov rcx, rdi;
        mov_b [r10 + 0], rcx;
        shr rcx, 8;
        mov_b [r10 + 1], rcx;

        // Write src_offset u32 at [+4].
        mov_d [r10 + 4], rsi;

        // Write src_length u32 at [+8].
        mov_d [r10 + 8], rdx;

        // rax already holds the allocated pool_idx.
        ret;

      ast_al_full:
        xor rax, rax;                     // 0 = pool-full sentinel
        ret;
      }
    }

  // ==========================================================================
  // _ast_set_payload_u32(node_ref, payload) -> ()
  //
  //   rdi = node_ref  -- pool_idx returned by _ast_alloc
  //   rsi = payload   -- u32 value (low 32 stored at [+12])
