  //   Overwrites the `child_ref` u64 slot at [+16]. Silent no-op on
  //   out-of-range node_ref. The reference is not validated beyond
  //   the node_ref range check -- the parser is free to encode the
  //   child linkage however it chooses (pool_idx, tagged pointer,
  //   external array handle).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ast_sc_.
  // ==========================================================================
  pub let _ast_set_child_ref : (u64, u64) -> () !{mem} @{} =
    fn (node_ref: u64) (child_array_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_set_child_ref overwrites the u64 child_ref slot at [+16] of the given SyntaxNode. Pure leaf; zero pushes; no stack frame; no nested CALL. Validate node_ref: cmp rdi, 0 je ast_sc_done; load _ast_pool_next via `lea r11,[rip+_ast_pool_next]; mov rax,[r11]`; cmp rdi, rax; jae ast_sc_done. Compute node_addr via `mov r10, rdi; shl r10, 5; lea r11, [rip + _ast_node_pool]; add r10, r11`. Store child_array_ref as u64 at [+16] via `mov [r10+16], rsi`. All immediates (0) imm8-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_sc_.",
      block: {
        // Validate node_ref != 0.
        cmp rdi, 0;
        je  ast_sc_done;

        // Validate node_ref < _ast_pool_next.
        lea r11, [rip + _ast_pool_next];
        mov rax, [r11];
        cmp rdi, rax;
        jae ast_sc_done;

        // Compute node_addr.
        mov r10, rdi;
        shl r10, 5;
        lea r11, [rip + _ast_node_pool];
        add r10, r11;

        // Store child_ref u64 at [+16].
        mov [r10 + 16], rsi;

      ast_sc_done:
        ret;
      }
    }

  // ==========================================================================
  // _ast_set_extra_ref(node_ref, extra_ref) -> ()
  //
  //   rdi = node_ref    -- pool_idx returned by _ast_alloc
  //   rsi = extra_ref   -- u64 type-tagged auxiliary pointer
