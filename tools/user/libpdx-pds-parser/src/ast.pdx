      }
    }

  // ==========================================================================
  // _ast_render(node_ref, out, out_cap) -> packed_u64
  //
  //   rdi = node_ref    -- pool_idx returned by _ast_alloc
  //   rsi = out         -- destination byte buffer
  //   rdx = out_cap     -- destination buffer capacity
  //   rax = packed_u64  -- (bytes_written << 32) | status
  //
  //   Span-copy the N = src_length bytes at
  //   `_ast_src_ptr + src_offset` into `out`. Returns packed_u64 with
  //   the byte count in the high 32 and AST_OK (0) / AST_ERR_* in
  //   the low 32.
  //
  //   Error paths:
  //     AST_ERR_BAD_REF        -- node_ref == 0 OR
  //                               node_ref >= _ast_pool_next.
  //     AST_ERR_NO_SOURCE      -- _ast_src_ptr == 0 (caller forgot
  //                               to call _ast_set_source after
  //                               _ast_init).
  //     AST_ERR_SPAN_OOB       -- src_offset + src_length >
  //                               _ast_src_len.
  //     AST_ERR_OUT_TOO_SMALL  -- out_cap < src_length.
  //
  //   On success the high 32 of rax hold the byte count (= src_length);
  //   on error the high 32 are 0 and only the low 32 carry the code.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rbx/r12..r15 untouched; rax, rcx, rdx, rsi, r8..r11
  // used as described in the loop. Labels prefixed ast_r_.
  // ==========================================================================
  pub let _ast_render : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (node_ref: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M5 (#2655): _ast_render span-copies the source bytes at (_ast_src_ptr + node.src_offset, len=node.src_length) into the caller's out buffer. Pure leaf; zero pushes; no stack frame; no nested CALL. Validate node_ref: cmp rdi, 0 je ast_r_bad_ref; load _ast_pool_next; cmp rdi, rax; jae ast_r_bad_ref. Compute node_addr. Read src_offset u32 at [+4] into r8 (xor r8,r8; mov_d r8,[r10+4]). Read src_length u32 at [+8] into r9 (same shape). Check out_cap: cmp r9, rdx; ja ast_r_oos. Check source set: load _ast_src_ptr into rcx; cmp rcx, 0; je ast_r_no_src. Check span bounds: load _ast_src_len into r11; mov rax, r8; add rax, r9; cmp rax, r11; ja ast_r_span_oob. Compute src_addr = _ast_src_ptr + src_offset: add rcx, r8. Memcpy loop byte-by-byte: xor r11, r11 (i); loop head: cmp r11, r9; jae done; xor rax, rax; mov_b rax, [rcx + r11 * 1]; mov_b [rsi + r11 * 1], rax; add r11, 1; jmp head. On done: pack return (r9 << 32) | AST_OK via `mov rax, r9; shl rax, 32`. Error returns load the status code into rax with high 32 implicit zero. All immediates (0, 0x4401, 0x4403, 0x4404, 0x4405) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ast_r_.",
      block: {
        // ---- Validate node_ref ------------------------------------------
        cmp rdi, 0;
        je  ast_r_bad_ref;

        lea r11, [rip + _ast_pool_next];
        mov rax, [r11];
        cmp rdi, rax;
        jae ast_r_bad_ref;

        // ---- Compute node_addr ------------------------------------------
        mov r10, rdi;
        shl r10, 5;
        lea r11, [rip + _ast_node_pool];
        add r10, r11;

        // ---- Read src_offset u32 at [+4] into r8 ------------------------
        xor r8, r8;
        mov_d r8, [r10 + 4];

        // ---- Read src_length u32 at [+8] into r9 ------------------------
        xor r9, r9;
        mov_d r9, [r10 + 8];

        // ---- Check out_cap: src_length <= out_cap -----------------------
        cmp r9, rdx;
        ja  ast_r_oos;

        // ---- Check source set: _ast_src_ptr != 0 ------------------------
        lea r11, [rip + _ast_src_ptr];
        mov rcx, [r11];
        cmp rcx, 0;
        je  ast_r_no_src;

        // ---- Check span bounds: src_offset + src_length <= _ast_src_len -
        lea r11, [rip + _ast_src_len];
        mov r11, [r11];
        mov rax, r8;
        add rax, r9;
        cmp rax, r11;
        ja  ast_r_span_oob;

        // ---- Compute src_addr = _ast_src_ptr + src_offset ---------------
        add rcx, r8;

        // ---- Memcpy r9 bytes from [rcx] to [rsi] via byte loop ---------
        xor r11, r11;

      ast_r_mc_loop:
        cmp r11, r9;
        jae ast_r_mc_done;
        xor rax, rax;
        mov_b rax, [rcx + r11 * 1];
        mov_b [rsi + r11 * 1], rax;
        add r11, 1;
        jmp ast_r_mc_loop;

      ast_r_mc_done:
        // Pack return: (bytes_written=r9 << 32) | AST_OK (0).
        mov rax, r9;
        shl rax, 32;
        ret;

        // ---- Error return paths -----------------------------------------
      ast_r_bad_ref:
        mov rax, 0x4401;
        ret;

      ast_r_oos:
        mov rax, 0x4403;
        ret;

      ast_r_no_src:
        mov rax, 0x4405;
        ret;

      ast_r_span_oob:
        mov rax, 0x4404;
        ret;
      }
    }

}
