// src/span_map.pdx -- libpdx-pds-parser.R221.M6 (paideia-os#2656, Wave 123)
//
// SpanMap: source-span tracking across UTF-8 -> NFC normalization.
// Preserves the Q-A5 invariant that every AST node points back into
// the ORIGINAL caller-supplied source bytes, not the NFC-normalised
// output. Builds on R221.M1 Utf8Nfc (`_u8n_decode_and_normalize`)
// and layers underneath R221.M5 Ast (which stores `src_offset` /
// `src_length` fields in each SyntaxNode).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R221.M6 of the parser-tier Unicode + lexer umbrella (paideia-os#2485,
// decomposed into paideia-os#2656 for THIS M6). Builds on:
//
//   R221.M1 (utf8_nfc.pdx)   -- UTF-8 decoder + NFC normalizer whose
//                               output buffer the AST layer walks.
//   R221.M5 (ast.pdx)        -- Ast module whose SyntaxNode records
//                               carry `src_offset` / `src_length` u32
//                               fields that index INTO the NFC-form
//                               output. R221.M6 refines that index
//                               back into the pre-NFC source buffer.
//
// NFC composition can MERGE multiple source codepoints into one NFC
// codepoint. The canonical example:
//
//   src:  'a' (0x61) + U+0301 COMBINING ACUTE ACCENT (0xCC 0x81)
//         => 3 source bytes.
//   nfc:  U+00E1 LATIN SMALL LETTER A WITH ACUTE   (0xC3 0xA1)
//         => 2 nfc bytes.
//
// An AST node that quotes the composed character at `nfc_offset = 0`
// with `nfc_length = 2` MUST map back to `src_offset = 0`,
// `src_length = 3` for a user-visible diagnostic to quote what the
// user actually typed. Direct offset-to-offset mapping does not work
// because the two sides have different byte strides across the
// composed region.
//
// =============================================================================
// SPAN MAP = SPARSE DELTA LIST
// =============================================================================
//
// A span map is an array of `(nfc_offset_u32, src_offset_u32)` pairs
// stored in strictly monotonic order. Each pair records a position
// AT WHICH the two cursors have diverged by a fresh amount. BETWEEN
// consecutive pairs, both cursors advance in BYTE-FOR-BYTE lockstep
// (that is, `nfc[i] == src[i + delta]` where delta is derived from
// the preceding pair).
//
// Lookup `_sm_lookup(nfc_offset) -> src_offset`:
//
//   1. Binary-search the pair array for the LARGEST pair whose
//      `nfc_offset` is <= the queried `nfc_offset`.
//   2. If no pair applies (query < first pair's nfc or table empty):
//      return the queried value unchanged (identity map).
//   3. Otherwise: `src_offset = pair.src + (query - pair.nfc)`.
//
// Example map for the a-acute case:
//
//   pair_count = 1
//   pair[0] = (nfc=2, src=3)
//
//   Query _sm_lookup(0)   -> 0 (no pair applies, identity).
//   Query _sm_lookup(1)   -> 1 (no pair applies; the fast path's
//                               ASCII prefix mapped identically; the
//                               boundary falls AT nfc=2 where the
//                               composed region ended).
//   Query _sm_lookup(2)   -> 3 (pair[0] applies; src = 3 + 0 = 3).
//   Query _sm_lookup(5)   -> 6 (pair[0] applies; src = 3 + 3 = 6).
//
// A pure-ASCII input NEVER triggers a pair (R221.M1's fast branch is
// a byte-for-byte copy; the identity map holds throughout). The
// 1024-slot pair pool is sized for the pathological case where every
// shell input carries composable combining marks; typical shell
// input touches zero or one pair per line.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _sm_init() -> ()
//     Hard-reset: zero `_sm_pair_count` and (idempotently) leave the
//     backing byte array in whatever state it was in. .bss zero-init
//     at boot guarantees a cold-start identity map. Idempotent.
//
//   _sm_record_pair(nfc_offset, src_offset) -> errno
//     Append one pair (nfc_offset, src_offset) at the end of the
//     monotonic list. Validates:
//       - `_sm_pair_count < SM_POOL_CAP` (1024); else SM_ERR_POOL_FULL.
//       - When `_sm_pair_count > 0`: `nfc_offset > prev.nfc_offset`
//         AND `src_offset > prev.src_offset`; else
//         SM_ERR_NON_MONOTONIC.
//     Both fields are stored as u32 (low 32 of each arg). Callers that
//     need > 4 GiB input buffers must land R221.M6.1 or later.
//
//   _sm_lookup(nfc_offset) -> src_offset
//     Pure-leaf binary search over the monotonic pair array. Returns
//     the mapped source offset per the formula above. Zero-size table
//     collapses to the identity map (returns the queried value).
//
//   _sm_from_u8nfc(bytes_src, src_len, bytes_nfc, nfc_len) -> errno
//     Rebuild the span-map in one shot by walking both buffers in
//     lockstep. CALLs `_sm_init` first (always fresh table), then
//     scans byte-by-byte while bytes match. On the first divergence,
//     decodes the UTF-8 scalar length from the lead byte at the NFC
//     cursor, advances the NFC cursor past that scalar, scans the
//     src cursor forward until it finds the next byte matching the
//     new NFC lead byte (resynchronisation), then CALLs
//     `_sm_record_pair` with the post-composition cursor pair.
//     Repeats until one cursor reaches end-of-input.
//
//     Returns:
//       SM_OK (0)                 on success.
//       SM_ERR_BAD_INPUT (0x4703) if src_ptr == 0 or nfc_ptr == 0.
//       SM_ERR_POOL_FULL (0x4700) propagated from _sm_record_pair.
//       SM_ERR_NON_MONOTONIC (0x4701) propagated (should not fire
//                                     given the walk invariant; the
//                                     slot is defensive).
//
// Register maps (SysV):
//
//   _sm_init()                                      -> rax = () (ignored)
//   _sm_record_pair(rdi, rsi)                       -> rax = errno u64
//   _sm_lookup(rdi)                                 -> rax = src_offset u64
//   _sm_from_u8nfc(rdi, rsi, rdx, rcx)              -> rax = errno u64
//
// =============================================================================
// STATUS CODES -- band 0x4700..0x47FF
// =============================================================================
//
//   SM_OK                  : 0
//   SM_ERR_POOL_FULL       : 0x4700  _sm_record_pair: pair_count
//                                    >= SM_POOL_CAP (1024).
//   SM_ERR_NON_MONOTONIC   : 0x4701  _sm_record_pair: nfc_offset <=
//                                    prev.nfc OR src_offset <=
//                                    prev.src.
//   SM_ERR_OOB_OFFSET      : 0x4702  reserved for R221.M6.1+ when
//                                    the pair fields widen to u64
//                                    or an input-length overflow
//                                    guard is added.
//   SM_ERR_BAD_INPUT       : 0x4703  _sm_from_u8nfc: null pointer in
//                                    src_ptr or nfc_ptr.
//
// Band carved on a fresh kilo-step boundary past R222.M5 CmdRegistry
// (0x4500..0x45FF), R224.M5 LetScope (0x4600..0x46FF). Slots
// 0x4704..0x47FF reserved for M6.1+ follow-ups (per-pair invalid
// UTF-8 code, bounded resync window exhaustion, u64-width pair
// fields, cross-NFC-form interop).
//
// =============================================================================
// POOL + .bss STATE
// =============================================================================
//
//   _sm_pairs       : [u8; 8192] = 1024 slots x 8-byte pair stride.
//                     offset [+0] = nfc_offset u32.
//                     offset [+4] = src_offset u32.
//                     8-byte stride matches `shl r, 3` for slot
//                     addressing (power of two; precedent:
//                     `_cmdreg_entries` uses `shl r, 5 + shl r, 4`
//                     for 48 B stride; `_ast_node_pool` uses
//                     `shl r, 5` for 32 B stride; the 8 B SpanMap
//                     stride is the smallest in the parser-tier).
//   _sm_pair_count  : u64 -- current number of valid pairs. .bss
//                     zero-init at boot means a cold-start table is
//                     empty (identity map); `_sm_init` restores this
//                     state explicitly between parses.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- not used (no 64-bit mask ops needed).
//   - No 2-op `imul r, imm` -- 8-byte stride is `shl r, 3`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `SpanMap` matches `span_map.pdx`.
//   - Labels prefixed `sm_` with per-function suffix (`sm_rp_`,
//     `sm_lu_`, `sm_fnfc_`); grep-confirmed disjoint from `af_`,
//     `afs_`, `ast_`, `cc_`, `cl_`, `clo_`, `cmd_`, `cmdreg_`,
//     `cr_`, `cs_`, `dl_`, `er_`, `fi_`, `gi_`, `hm_`, `ll_`,
//     `ls_`, `pl_`, `rp_`, `rt_`, `se_`, `sch_sig_`, `te_`,
//     `u8n_`, `wp_` and from paideia-as reserved keywords
//     (`loop`, `if`, `let`, `fn`, `ret`, `done`).
//   - All `cmp reg, imm` immediates (0, 1, 1024, 0x80, 0xC0, 0xE0,
//     0xF0, 0xF8, 0x4700..0x4703) fit imm32 with bit 31 clear and
//     are sign-safe (direct cmp-imm32).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx]`
//     (zero-extends into the full qword, so the loaded byte never
//     has bit 63 set).
//   - u32 stores via `mov_d [base + disp], reg`.
//   - u32 loads via `xor rN, rN; mov_d rN, [base + disp]`.
//   - u64 stores via plain `mov [base + disp], reg`.
//   - `_sm_init`, `_sm_record_pair`, `_sm_lookup` are PURE LEAVES --
//     zero callee-save pushes, zero stack frames, zero nested CALLs.
//     `_sm_from_u8nfc` is NOT a pure leaf: it has a 5-push callee-
//     save prologue (rbx, r12, r13, r14, r15) + `sub rsp, 16` for
//     one local slot (sc, the src cursor; a pad slot keeps alignment)
//     giving rsp%16==0 at every nested CALL (entry rsp%16==8 + 40
//     pushes = %16==8 wait recompute: entry rsp%16==8; each push
//     subtracts 8; after 5 pushes rsp%16 = (8 - 40) mod 16 = 0; then
//     sub rsp, 16 keeps rsp%16==0; pre-CALL rsp%16==0 as SysV
//     requires).
//   - r11 is CALLER-save and clobbered by nested CALLs. In
//     `_sm_from_u8nfc`, no value held in r11 crosses a CALL -- state
//     survives in rbx/r12/r13/r14/r15 and in the stack local
//     `[rsp + 0]`.
//   - No chained-displacement operands `[reg + a + b]`: every address
//     is `[reg + disp]` or `[base + idx]` (Wave 120+121 lesson).
//   - Full-u64 status compares not needed in the pure leaves. In
//     `_sm_from_u8nfc`, the one status check after `_sm_record_pair`
//     uses `cmp rax, 0` (direct zero check against the u64 return).
//
// =============================================================================
// REGISTER-LIVENESS NOTE (per paideia-os#2656 brief)
// =============================================================================
//
// r11 is clobbered by nested CALL per SysV ABI. In `_sm_from_u8nfc`
// the state that must survive the two nested CALLs (`_sm_init`,
// `_sm_record_pair`) is placed in the SysV callee-save set:
//
//   rbx = src_ptr        (set once, read on every byte load from src)
//   r12 = src_len        (set once, cmp'd against sc on EOI check)
//   r13 = nfc_ptr        (set once, read on every byte load from nfc)
//   r14 = nfc_len        (set once, cmp'd against nc on EOI check)
//   r15 = nc             (nfc cursor; bumped per matched byte or
//                         per decoded nfc scalar on divergence)
//   [rsp + 0] = sc       (src cursor; bumped per matched byte or
//                         scanned on resync; stack-held because we
//                         are already at 5 callee-save regs and must
//                         leave rbp free for a future frame-pointer
//                         pass)
//
// The leaves (`_sm_init`, `_sm_record_pair`, `_sm_lookup`) use only
// caller-save scratch (rax, rcx, rdx, r8, r9, r10, r11) and the
// address-computation helper rN11 for RIP-relative LEA.
//
// =============================================================================
// RESYNC HEURISTIC (M6; follow-up to R221.M6.1 for exactness)
// =============================================================================
//
// On a byte-level divergence `nfc[nc] != src[sc]`, the walker:
//
//   1. Decodes the UTF-8 scalar length `L` from the lead byte at
//      `nfc[nc]`:
//        0x00..0x7F           -> 1
//        0x80..0xBF           -> 1  (defensive: continuation byte
//                                    seen in lead slot; treat as 1)
//        0xC0..0xDF           -> 2
//        0xE0..0xEF           -> 3
//        0xF0..0xF7           -> 4
//        else                 -> 1  (defensive)
//   2. Advances `nc := nc + L` (past the current NFC scalar).
//   3. If `nc >= nfc_len`, sets `sc := src_len` (every remaining
//      source byte is composed into the preceding NFC region).
//      Otherwise scans `src[sc..src_len)` byte-by-byte for the next
//      byte equal to the (new) `nfc[nc]`. The first match is treated
//      as the resync point; `sc` is set to that index.
//   4. Records the pair `(nc, sc)` via `_sm_record_pair`.
//
// This heuristic is correct for canonical-composition cases where
// NFC merges K consecutive source codepoints into one NFC codepoint
// (the dominant case: Latin + combining marks). It is NOT guaranteed
// to be byte-exact under adversarial inputs where the next-matching
// src byte is a coincidence rather than the true resync point; a
// bounded-window variant that cross-checks the next W bytes is
// filed as R221.M6.1. For M6 the heuristic is sufficient:
//
//   * Pure ASCII input never triggers the resync branch (byte
//     equality holds throughout; the pair table stays empty).
//   * The dominant combining-mark case (`a` + U+0301 -> á; `ñ`;
//     `ü`; etc.) resyncs to the first post-composition byte, which
//     IS the correct re-alignment because the composed region's
//     tail is a byte sequence that does not re-appear inside the
//     composed region's source bytes.
//   * A diagnostic that quotes `src[src_offset..]` for ONE scalar
//     may land on an adjacent cluster boundary rather than the
//     exact pre-NFC byte; this is acceptable at the ERROR-REPORT
//     granularity R221.M5 §9 §Round-trip documents.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2656 (R221.M6).
// Substrate: paideia-os#2651 (R221.M1 Utf8Nfc), paideia-os#2655
// (R221.M5 Ast).
// Design doc: design/shell/span-map-nfc.md.

module SpanMap = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax by _sm_record_pair and
  //                            _sm_from_u8nfc)
  // ==========================================================================
  //
  // Small-value range 0x4700..0x47FF, reserved for span-map parser-
  // tier packed-status codes across R221.M6+. Disjoint from every
  // other user-space error band in paideia-os (see caps.decl).

  pub let SM_OK                  : u64 = 0
  pub let SM_ERR_POOL_FULL       : u64 = 0x4700
  pub let SM_ERR_NON_MONOTONIC   : u64 = 0x4701
  pub let SM_ERR_OOB_OFFSET      : u64 = 0x4702
  pub let SM_ERR_BAD_INPUT       : u64 = 0x4703

  // ==========================================================================
  // SECTION 2 -- POOL + STRIDE CONSTANTS
  // ==========================================================================

  pub let SM_POOL_CAP     : u64 = 1024          // max pair count
  pub let SM_PAIR_BYTES   : u64 = 8             // 2 x u32 per pair
  pub let SM_POOL_BYTES   : u64 = 8192          // SM_POOL_CAP * SM_PAIR_BYTES

  pub let SM_OFF_NFC      : u64 = 0             // pair field [+0] u32
  pub let SM_OFF_SRC      : u64 = 4             // pair field [+4] u32

  // ==========================================================================
  // SECTION 3 -- STATIC STATE (.bss, singleton)
  // ==========================================================================

  pub let mut _sm_pairs       : [u8; 8192] = uninit @align(8)
  pub let mut _sm_pair_count  : u64        = uninit @align(8)

  // ==========================================================================
  // _sm_init() -> ()
  //
  //   Hard-reset the pair count to 0. Does NOT scrub `_sm_pairs`
  //   because the pair-count sentinel is the sole source of truth
  //   for "which slots are valid"; stale bytes past slot
  //   `_sm_pair_count` are unreachable because every reader guards
  //   against `pair_count` first.
  //
  //   Idempotent in the trivial sense: re-zeroing an already-zero
  //   state is a no-op. Called by `_sm_from_u8nfc` at entry, and
  //   externally at harness boot / between round-trip test iterations.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sm_i_.
  // ==========================================================================
  pub let _sm_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M6 (#2656): _sm_init hard-resets _sm_pair_count to 0. Pure leaf; zero pushes; no stack frame; no nested CALL. One u64 store: `lea r11,[rip+_sm_pair_count]; mov [r11], rax` with rax=0 (xor rax,rax). The 8 KiB `_sm_pairs` backing array is NOT scrubbed because the pair-count sentinel is the sole source of truth; stale bytes past slot count are unreachable. Idempotent (re-zeroing an already-zero state is a no-op). No cmp; no test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sm_i_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _sm_pair_count];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _sm_record_pair(nfc_offset, src_offset) -> errno
  //
  //   rdi = nfc_offset   (u64, low 32 stored as u32 at pair [+0])
  //   rsi = src_offset   (u64, low 32 stored as u32 at pair [+4])
  //   rax = errno        (SM_OK, SM_ERR_POOL_FULL, SM_ERR_NON_MONOTONIC)
  //
  //   Append one pair at slot `_sm_pair_count` and bump the count.
  //   Enforces STRICT monotonicity: when count > 0, both the
  //   new nfc_offset AND new src_offset must be strictly greater than
  //   the previous pair's values; else SM_ERR_NON_MONOTONIC.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sm_rp_.
  // ==========================================================================
  pub let _sm_record_pair : (u64, u64) -> u64 !{mem} @{} =
    fn (nfc_offset: u64) (src_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M6 (#2656): _sm_record_pair appends one (nfc_offset u32, src_offset u32) pair into the monotonic _sm_pairs array. Pure leaf; zero pushes; no stack frame; no nested CALL. Load _sm_pair_count via `lea r11,[rip+_sm_pair_count]; mov rax,[r11]`. Pool guard: cmp rax, 1024; jae sm_rp_full (return SM_ERR_POOL_FULL=0x4700). Monotonicity guard (only when rax > 0): compute previous pair address via `mov r10, rax; sub r10, 1; shl r10, 3; lea r11,[rip+_sm_pairs]; add r10, r11`; load prev.nfc u32 at [+0] into r9 via `xor r9,r9; mov_d r9,[r10+0]`; cmp rdi, r9; jbe sm_rp_non_mono (require strictly greater); load prev.src u32 at [+4] into r9 via same shape; cmp rsi, r9; jbe sm_rp_non_mono. Store at the current slot: `mov r10, rax; shl r10, 3; lea r11,[rip+_sm_pairs]; add r10, r11`; `mov_d [r10+0], rdi`; `mov_d [r10+4], rsi`. Bump count: `mov r10, rax; add r10, 1; lea r11,[rip+_sm_pair_count]; mov [r11], r10`. Return SM_OK (0) via xor rax, rax. All cmp immediates (0, 1024) fit imm32 with bit 31 clear. Error returns use `mov rax, imm32`. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sm_rp_.",
      block: {
        // Load _sm_pair_count.
        lea r11, [rip + _sm_pair_count];
        mov rax, [r11];

        // Pool-full guard.
        cmp rax, 1024;
        jae sm_rp_full;

        // If count == 0, skip the monotonicity check (first write).
        cmp rax, 0;
        je  sm_rp_write;

        // Compute previous pair address: &_sm_pairs + (count - 1) * 8.
        mov r10, rax;
        sub r10, 1;
        shl r10, 3;
        lea r11, [rip + _sm_pairs];
        add r10, r11;

        // Load prev.nfc u32 at [+0].
        xor r9, r9;
        mov_d r9, [r10 + 0];
        cmp rdi, r9;
        jbe sm_rp_non_mono;

        // Load prev.src u32 at [+4].
        xor r9, r9;
        mov_d r9, [r10 + 4];
        cmp rsi, r9;
        jbe sm_rp_non_mono;

      sm_rp_write:
        // Compute current pair address: &_sm_pairs + count * 8.
        mov r10, rax;
        shl r10, 3;
        lea r11, [rip + _sm_pairs];
        add r10, r11;

        // Store u32 nfc_offset at [+0].
        mov_d [r10 + 0], rdi;

        // Store u32 src_offset at [+4].
        mov_d [r10 + 4], rsi;

        // Bump _sm_pair_count.
        mov r10, rax;
        add r10, 1;
        lea r11, [rip + _sm_pair_count];
        mov [r11], r10;

        // Return SM_OK.
        xor rax, rax;
        ret;

      sm_rp_full:
        mov rax, 0x4700;
        ret;

      sm_rp_non_mono:
        mov rax, 0x4701;
        ret;
      }
    }

  // ==========================================================================
  // _sm_lookup(nfc_offset) -> src_offset
  //
  //   rdi = nfc_offset   (u64, low 32 meaningful)
  //   rax = src_offset   (u64, mapped source byte offset)
  //
  //   Binary-search the pair array for the largest `pair.nfc_offset`
  //   that is <= `nfc_offset`. Returns `pair.src + (nfc_offset -
  //   pair.nfc)`. When the table is empty OR the query is strictly
  //   less than every pair's nfc_offset, returns `nfc_offset` itself
  //   (identity map; the ASCII fast path never touches the pair
  //   table).
  //
  //   Binary search is loop-shaped `lo = 0, hi = count`, invariant
  //   `pair[lo-1].nfc <= query < pair[hi].nfc` (with virtual
  //   `pair[-1].nfc = 0` and `pair[count].nfc = +inf`). Terminates
  //   when `lo == hi`; the preceding slot (lo - 1) is the answer.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sm_lu_.
  // ==========================================================================
  pub let _sm_lookup : (u64) -> u64 !{mem} @{} =
    fn (nfc_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M6 (#2656): _sm_lookup binary-searches _sm_pairs for the largest pair whose nfc_offset <= rdi, returns pair.src + (rdi - pair.nfc). Pure leaf; zero pushes; no stack frame; no nested CALL. Load count via `lea r11,[rip+_sm_pair_count]; mov rcx,[r11]`. Empty-table guard: cmp rcx, 0; je sm_lu_identity. Binary search: xor rax, rax (lo=0); mov r9, rcx (hi=count). Loop: cmp rax, r9; jae sm_lu_done. Compute mid = (lo + hi) / 2 via `mov r10, rax; add r10, r9; shr r10, 1`. Load pair[mid].nfc u32: `mov r8, r10; shl r8, 3; lea r11,[rip+_sm_pairs]; add r8, r11; xor rdx, rdx; mov_d rdx, [r8+0]`. If pair[mid].nfc > rdi: hi = mid (jmp loop). Else: lo = mid + 1 (jmp loop). On lo == hi: if lo == 0 return rdi (identity). Else preceding slot = lo - 1: compute addr via `sub rax, 1; mov r10, rax; shl r10, 3; lea r11,[rip+_sm_pairs]; add r10, r11`; load pair.nfc u32 at [+0] into r8; load pair.src u32 at [+4] into r9; return `mov rax, rdi; sub rax, r8; add rax, r9`. All cmp immediates (0) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sm_lu_.",
      block: {
        // Load pair count.
        lea r11, [rip + _sm_pair_count];
        mov rcx, [r11];

        // Empty-table fast path: identity.
        cmp rcx, 0;
        je  sm_lu_identity;

        // Binary search: lo = 0, hi = count.
        xor rax, rax;
        mov r9, rcx;

      sm_lu_loop:
        cmp rax, r9;
        jae sm_lu_done;

        // mid = (lo + hi) / 2
        mov r10, rax;
        add r10, r9;
        shr r10, 1;

        // Load pair[mid].nfc u32 at [+0].
        mov r8, r10;
        shl r8, 3;
        lea r11, [rip + _sm_pairs];
        add r8, r11;
        xor rdx, rdx;
        mov_d rdx, [r8 + 0];

        // If pair[mid].nfc > rdi: hi = mid.
        cmp rdx, rdi;
        ja  sm_lu_hi;

        // Else: lo = mid + 1.
        add r10, 1;
        mov rax, r10;
        jmp sm_lu_loop;

      sm_lu_hi:
        mov r9, r10;
        jmp sm_lu_loop;

      sm_lu_done:
        // lo == hi; the preceding slot (lo - 1) holds the answer.
        // If lo == 0, no pair applies -- identity.
        cmp rax, 0;
        je  sm_lu_identity;

        sub rax, 1;
        mov r10, rax;
        shl r10, 3;
        lea r11, [rip + _sm_pairs];
        add r10, r11;

        // Load pair.nfc u32 at [+0] into r8.
        xor r8, r8;
        mov_d r8, [r10 + 0];

        // Load pair.src u32 at [+4] into r9.
        xor r9, r9;
        mov_d r9, [r10 + 4];

        // src_offset = pair.src + (rdi - pair.nfc).
        mov rax, rdi;
        sub rax, r8;
        add rax, r9;
        ret;

      sm_lu_identity:
        mov rax, rdi;
        ret;
      }
    }

  // ==========================================================================
  // _sm_from_u8nfc(bytes_src, src_len, bytes_nfc, nfc_len) -> errno
  //
  //   rdi = bytes_src    -- pre-NFC source byte buffer.
  //   rsi = src_len      -- source length in bytes.
  //   rdx = bytes_nfc    -- post-NFC byte buffer (R221.M1 output).
  //   rcx = nfc_len      -- NFC length in bytes.
  //   rax = errno        (SM_OK, SM_ERR_BAD_INPUT, SM_ERR_POOL_FULL,
  //                       SM_ERR_NON_MONOTONIC)
  //
  //   Rebuild the span map in one pass. CALLs `_sm_init` first (always
  //   fresh table), walks both buffers in lockstep, and records one
  //   pair per divergence boundary.
  //
  //   The resync heuristic is documented in the module header
  //   §"RESYNC HEURISTIC"; the walker's control flow is:
  //
  //     loop_top:
  //       if nc >= nfc_len OR sc >= src_len: break
  //       if nfc[nc] == src[sc]:
  //         nc++; sc++; loop_top
  //       else:
  //         L := utf8_scalar_len(nfc[nc])
  //         nc += L
  //         if nc >= nfc_len:
  //           sc := src_len
  //         else:
  //           sync := nfc[nc]
  //           while sc < src_len and src[sc] != sync: sc++
  //         _sm_record_pair(nc, sc)
  //         loop_top
  //
  //   Frame plan: 5 callee-save pushes (rbx=src_ptr, r12=src_len,
  //   r13=nfc_ptr, r14=nfc_len, r15=nc) + `sub rsp, 16` for two
  //   local slots (sc at [rsp+0], pad at [rsp+8]). Entry rsp%16==8 +
  //   40 pushes = rsp%16==0 + 16 locals = rsp%16==0 pre-CALL (SysV
  //   requirement).
  //
  //   r11 is NEVER held across a nested CALL -- state survives in
  //   rbx/r12/r13/r14/r15 and the stack local [rsp+0].
  //
  // Labels prefixed sm_fnfc_.
  // ==========================================================================
  pub let _sm_from_u8nfc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_src: u64) (src_len: u64) (bytes_nfc: u64) (nfc_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M6 (#2656): _sm_from_u8nfc rebuilds the span map in one pass by walking src and nfc buffers in lockstep. Validates bytes_src != 0 and bytes_nfc != 0 (SM_ERR_BAD_INPUT=0x4703) BEFORE the SysV prologue. Prologue: 5 callee-save pushes (rbx=src_ptr, r12=src_len, r13=nfc_ptr, r14=nfc_len, r15=nc) + `sub rsp, 16` (locals: [rsp+0]=sc, [rsp+8]=pad). Entry rsp%16==8 + 40 pushes + 16 locals -> rsp%16==0 pre-CALL. CALLs _sm_init to reset the pair table (one nested CALL; args passed in rdi/rsi untouched, _sm_init is a pure leaf that only writes _sm_pair_count). Initializes nc=0 in r15 and sc=0 in [rsp+0]. Byte-level walk: loop_top checks nc < nfc_len (cmp r15, r14; jae done) and sc < src_len (mov rax,[rsp+0]; cmp rax, r12; jae done); loads nfc[nc] via `xor rax, rax; mov_b rax, [r13+r15]` and src[sc] via `mov r11, [rsp+0]; xor r10, r10; mov_b r10, [rbx+r11]`; on equal, advance both; on divergence, decode UTF-8 scalar length from rax (0x80..0xC0 -> 1 fallback; 0xC0..0xE0 -> 2; 0xE0..0xF0 -> 3; 0xF0..0xF8 -> 4; else 1), advance nc by L, then scan src for the next byte matching nfc[nc] (or set sc=src_len if nc >= nfc_len), then CALL _sm_record_pair(nc, sc). On _sm_record_pair non-OK return, propagate rax and jump to epilogue. Epilogue restores rsp and callee-save in reverse push order. r11 is clobbered by nested CALLs; no value survives in it. State survives in rbx/r12/r13/r14/r15 and the stack local [rsp+0]. All cmp immediates (0, 0x80, 0xC0, 0xE0, 0xF0, 0xF8) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let; no chained-displacement operand. Labels prefixed sm_fnfc_.",
      block: {
        // ---- Null-pointer guards (BEFORE prologue; no frame yet) ---------
        cmp rdi, 0;
        je  sm_fnfc_bad_input_bare;

        cmp rdx, 0;
        je  sm_fnfc_bad_input_bare;

        // ---- Prologue --------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 16;              // locals: [rsp+0]=sc, [rsp+8]=pad

        mov rbx, rdi;              // src_ptr
        mov r12, rsi;              // src_len
        mov r13, rdx;              // nfc_ptr
        mov r14, rcx;              // nfc_len

        // ---- Reset span-map table --------------------------------------
        call _sm_init;

        // ---- Initialize cursors ----------------------------------------
        xor r15, r15;              // nc = 0
        xor rax, rax;
        mov [rsp + 0], rax;        // sc = 0

      sm_fnfc_loop_top:
        // End-of-input: nc >= nfc_len?
        cmp r15, r14;
        jae sm_fnfc_done_ok;

        // sc >= src_len?
        mov rax, [rsp + 0];
        cmp rax, r12;
        jae sm_fnfc_done_ok;

        // Load nfc[nc] into rax (zero-extended).
        xor rax, rax;
        mov_b rax, [r13 + r15];

        // Load src[sc] into r10 (zero-extended).
        mov r11, [rsp + 0];
        xor r10, r10;
        mov_b r10, [rbx + r11];

        // Byte-equal: advance both cursors.
        cmp rax, r10;
        jne sm_fnfc_diverge;

        add r15, 1;                // nc++
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;        // sc++
        jmp sm_fnfc_loop_top;

      sm_fnfc_diverge:
        // rax holds nfc[nc] (lead byte). Decode UTF-8 scalar length.
        //   0x00..0x7F           -> 1
        //   0x80..0xBF (fallback)-> 1
        //   0xC0..0xDF           -> 2
        //   0xE0..0xEF           -> 3
        //   0xF0..0xF7           -> 4
        //   0xF8+ (fallback)     -> 1
        cmp rax, 0x80;
        jb  sm_fnfc_sl1;
        cmp rax, 0xC0;
        jb  sm_fnfc_sl1;           // continuation-byte fallback
        cmp rax, 0xE0;
        jb  sm_fnfc_sl2;
        cmp rax, 0xF0;
        jb  sm_fnfc_sl3;
        cmp rax, 0xF8;
        jb  sm_fnfc_sl4;
        jmp sm_fnfc_sl1;           // 0xF8+ fallback

      sm_fnfc_sl1:
        mov r9, 1;
        jmp sm_fnfc_sl_got;

      sm_fnfc_sl2:
        mov r9, 2;
        jmp sm_fnfc_sl_got;

      sm_fnfc_sl3:
        mov r9, 3;
        jmp sm_fnfc_sl_got;

      sm_fnfc_sl4:
        mov r9, 4;

      sm_fnfc_sl_got:
        // Advance nc past the current NFC scalar.
        add r15, r9;

        // If nc >= nfc_len, all remaining src bytes are composed.
        cmp r15, r14;
        jae sm_fnfc_src_to_end;

        // Load the resync target byte: nfc[nc].
        xor r9, r9;
        mov_b r9, [r13 + r15];

      sm_fnfc_sync_scan:
        mov rax, [rsp + 0];
        cmp rax, r12;
        jae sm_fnfc_sync_done;     // sc exhausted; stop here

        // Load src[sc].
        xor r10, r10;
        mov_b r10, [rbx + rax];
        cmp r10, r9;
        je  sm_fnfc_sync_done;

        add rax, 1;
        mov [rsp + 0], rax;
        jmp sm_fnfc_sync_scan;

      sm_fnfc_src_to_end:
        mov rax, r12;
        mov [rsp + 0], rax;
        // fallthrough to sm_fnfc_sync_done

      sm_fnfc_sync_done:
        // Record pair (nc, sc). r11 is clobbered by the CALL; nc and
        // sc survive in r15 and [rsp+0] respectively.
        mov rdi, r15;
        mov rsi, [rsp + 0];
        call _sm_record_pair;

        // On non-OK status, propagate (rax already carries the code).
        cmp rax, 0;
        jne sm_fnfc_epilogue;

        jmp sm_fnfc_loop_top;

      sm_fnfc_done_ok:
        xor rax, rax;              // SM_OK

      sm_fnfc_epilogue:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sm_fnfc_bad_input_bare:
        // Pre-prologue error return. No frame to tear down.
        mov rax, 0x4703;
        ret;
      }
    }

}
