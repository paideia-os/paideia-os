// src/lambda_lit.pdx -- libpdx-pds-parser.R224.M1 (paideia-os#2675)
//
// LambdaLit: parser-tier lexer for the paideia-shell lambda literal
// grammar (`\x:u64 -> x + 1`, `\(x:u64, y:u64) -> x + y`). R224.M1 of
// the lambda-lang umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R224 is the lambda-lang umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R224 --
// Lambda surface"). The semantic shell treats lambdas as FIRST-CLASS
// literal values that flow through pipelines; a user may write:
//
//     ls | filter \f:path -> file_size(f) > 1.MB
//     reduce \(a:u64, b:u64) -> a + b
//
// R224.M1 (THIS module) is the parser-tier primitive that recognises
// the LITERAL header: the backslash, the parameter list (either the
// one-param no-parens form or the n-param parens-and-comma form), and
// the `->` arrow. Everything AFTER the arrow is captured as OPAQUE
// trailing bytes -- a later R224 milestone (M2, expression parse) will
// walk those bytes against the Expr grammar and emit the body AST.
//
// Scope at M1:
//   * recognise the `\` + ParamList + `->` prefix
//   * emit a LambdaHeader + n_params x Param descriptor array
//   * copy the opaque body bytes verbatim into the out buffer
//   * return the total bytes_written for the caller
//
// Out of scope at M1 (deferred):
//   * expression parse of the body (R224.M2)
//   * closure environment capture (R224.M2+)
//   * effect-row annotations and inference (R224.M3)
//   * capability-row typing (R224.M4)
//   * nested lambda + let-rec scoping (R224.M5)
//   * record-destructuring patterns in Param (R224.M1 only accepts
//     the simple `identifier : type_name` shape; destructuring arrives
//     at R224.M5 with the pattern-matcher ingress).
//
// The parser is user-space (satellite library) because the shell runs
// in user space; the kernel-side substrate never touches lambda-
// literal bytes directly (it sees elaborated AST / effect / cap rows
// via higher-level R220 paideia-as ingress).
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     Lambda      := WS* "\" WS* ParamList WS* "->" Expr
//     ParamList   := SingleParam | "(" WS* MultiParam? WS* ")"
//     SingleParam := Param
//     MultiParam  := Param (WS* "," WS* Param)*
//     Param       := identifier WS* ":" WS* type_name
//     identifier  := [A-Za-z_] [A-Za-z0-9_]*          (len 1..13)
//     type_name   := one of  u64 | i64 | str | hex | hash32 | tsc
//                          | path | pid
//     Expr        := <opaque bytes, parsed at R224.M2>
//     WS          := 0x20 | 0x09 | 0x0A | 0x0D
//
// The `\(` ... `)` form MAY carry an empty parameter list: `\() -> ...`
// is a legal zero-param lambda (useful for suspended computations).
// The no-parens form `\x:u64 -> ...` is the common sugar for the
// one-param case; the two forms produce byte-identical header +
// descriptor arrays (differing only in n_params = 0, 1 or more).
//
// =============================================================================
// TYPE SET (M1 SUBSET)
// =============================================================================
//
// The eight type names map 1:1 to the R222.M1 SchemasSig type set --
// deliberate overlap so that lambda parameters and cmd-functor record
// fields share the SAME type dispatch byte (R224.M3 effect inference
// walks both tables uniformly, and R224.M6 "lambda through pipeline"
// requires that a stage-record field's type_code and a lambda-param's
// type_code are interchangeable at the compare point):
//
//     u64     -> LL_TYPE_U64    = 1   (mirror SS_TYPE_U64)
//     i64     -> LL_TYPE_I64    = 2   (mirror SS_TYPE_I64)
//     str     -> LL_TYPE_STR    = 3   (mirror SS_TYPE_STR)
//     hex     -> LL_TYPE_HEX    = 4   (mirror SS_TYPE_HEX)
//     hash32  -> LL_TYPE_HASH32 = 5   (mirror SS_TYPE_HASH32)
//     tsc     -> LL_TYPE_TSC    = 6   (mirror SS_TYPE_TSC)
//     path    -> LL_TYPE_PATH   = 8   (mirror SS_TYPE_PATH)
//     pid     -> LL_TYPE_PID    = 9   (mirror SS_TYPE_PID)
//
// Type code 7 is reserved (R222.M1 keeps it aligned with R129.M4
// SF_TYPE_IMAGE); the same reservation holds here.
//
// =============================================================================
// RECORD LAYOUT
// =============================================================================
//
// Output buffer layout after a successful parse:
//
//     [+0  .. +31]           LambdaHeader (32 B)
//     [+32 .. +32 + n*32)    Param[0..n]  (32 B each, n = n_params)
//     [+32 + n*32 .. end)    opaque body bytes (verbatim copy of
//                            input bytes AFTER the arrow)
//
// LambdaHeader (32 B):
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic              u32 = LL_HEADER_MAGIC ('LMBD'
//                                        little-endian = 0x44424D4C)
//     4      2   n_params           u16  0..LL_MAX_PARAMS (= 8)
//     6      2   flags              u16  bit flags (reserved; 0 at M1)
//     8      4   body_offset        u32  byte offset within out buffer
//                                        where opaque body begins
//                                        (= 32 + n_params * 32)
//    12      4   body_len           u32  byte length of opaque body
//                                        (= bytes_len - cursor-after-arrow)
//    16     16   reserved[16]       u8   zeroed; reserved for M2+
//                                        (effect-row id, cap-row id,
//                                        source span, etc.)
//
//   total: 32 B (LL_HEADER_BYTES)
//
// Param descriptor (32 B each):
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      1   type_code          u8   LL_TYPE_* (1..9, 7 reserved)
//     1      1   name_len           u8   1..LL_NAME_MAX (= 13)
//     2     14   name_inline[14]    u8   ASCII identifier, zero-padded
//                                        past name_len
//    16     16   reserved[16]       u8   zeroed; reserved for M2+
//                                        (default-value slot, closure-
//                                        capture bit, record-destructure
//                                        pattern pointer, etc.)
//
//   total: 32 B (LL_PARAM_BYTES)
//
// Stride 32 is a power of two so param addressing uses `shl rN, 5`
// (never 2-op `imul r, imm` -- see feedback_pdx_encoder_pitfalls). The
// 14-byte inline name mirrors SchemasSig's R222.M1 field descriptor
// name slot: 13 bytes of name plus a 1-byte null is sufficient for
// every lambda-param name observed in the semantic-shell plan
// examples (`f`, `x`, `y`, `path`, `name`, `size`, `inode`, `mtime`,
// etc.) and sidesteps a pointer+len indirection -- a downstream pass
// walking the descriptor table never dereferences a sibling buffer.
//
// The 16-byte reserved tail per Param is 2x bigger than R222.M1's
// SchemasSig field descriptor because lambda params carry MORE
// per-slot state than cmd-functor fields: at M2+ a param slot will
// hold a default-value pointer (8 B), a closure-capture flag (1 B),
// and a destructure-pattern descriptor id (4 B), with room for one
// more u16 M3+ effect-row slot.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ll_parse(bytes_ptr, bytes_len, out_ptr, out_cap)   -> packed_u64
//
//     Parses the lambda literal starting at bytes_ptr. On success,
//     writes a LambdaHeader followed by n_params Param descriptors
//     followed by the opaque body bytes to the out buffer. Returns a
//     packed `(bytes_written << 32) | status` u64; `bytes_written` is
//     meaningful only when `status == LL_OK` (on error, callers
//     ignore the top 32 bits).
//
//     Status one of:
//        LL_OK                  = 0
//        LL_ERR_SYNTAX          = 0x2C00  bad grammar
//        LL_ERR_TOO_MANY_PARAMS = 0x2C01  n_params > LL_MAX_PARAMS (= 8)
//        LL_ERR_UNKNOWN_TYPE    = 0x2C02  type_name not in the M1 set
//        LL_ERR_OUT_TOO_SMALL   = 0x2C03  out_cap insufficient for
//                                         header + params + body bytes
//        LL_ERR_NO_ARROW        = 0x2C04  ParamList terminator was
//                                         not `->` (dedicated code
//                                         rather than SYNTAX so the
//                                         diagnostic can point at
//                                         the specific missing token
//                                         rather than at "something
//                                         went wrong")
//
//   Register map (SysV):
//
//     _ll_parse(rdi, rsi, rdx, rcx) -> rax
//         rdi = bytes_ptr
//         rsi = bytes_len
//         rdx = out_ptr
//         rcx = out_cap
//         rax = (bytes_written << 32) | status
//
//   Internal cross-function helpers (not re-exported past M1 ABI;
//   signatures frozen now so M2+ can reuse them):
//
//     _ll_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
//     _ll_classify_type(ident_ptr, ident_len)  -> type_code
//     _ll_parse_param(bytes_ptr, bytes_len, cursor_in,
//                     param_write_ptr) -> (new_cursor << 32) | status
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller is expected to have already
//     run the input bytes through _u8n_decode_and_normalize so this
//     module may assume (a) valid UTF-8, (b) NFC-form. Because the
//     grammar accepts only ASCII identifiers and ASCII punctuation
//     (`\`, `(`, `)`, `,`, `:`, `->`, WS), the parser only ever
//     inspects the ASCII subset of its input. Non-ASCII bytes inside
//     an identifier fall through to LL_ERR_SYNTAX via the ident
//     byte-class check (none of 0x80..0xFF is in [A-Za-z0-9_]).
//     Non-ASCII bytes in the body are copied VERBATIM (opaque at M1);
//     R224.M2 will walk them through the expression parse.
//
//   R222.M1 (SchemasSig)  --  the type codes LL_TYPE_* mirror
//     SS_TYPE_* exactly (shared M1 subset). A later pass that
//     compares a lambda parameter's declared type against a cmd-
//     functor record field's type reads the two bytes directly and
//     `cmp`s them. The two modules do NOT share code (SchemasSig
//     carries its own `_sch_sig_classify_type` leaf; this module
//     carries `_ll_classify_type`); the duplication is intentional
//     at M1 so neither module becomes a build-order dependency of
//     the other.
//
//   R223.M1 (Pipeline)  --  a lambda literal that appears as a
//     pipeline-stage argv word is parsed FIRST by Pipeline at the
//     lexer tier (which emits one span per `|`-delimited stage) and
//     then handed, span-by-span, to THIS module at the lambda-token
//     tier. The two parsers never share a cursor; they operate on
//     the same NFC-normalised input buffer but at different depth
//     plies.
//
//   R224.M2 (Expr parse)  --  consumes the (body_offset, body_len)
//     slot on the LambdaHeader. Walks the opaque bytes against the
//     Expr grammar and emits an expression AST into a sibling buffer.
//     Does NOT re-walk the Param descriptors -- those are consumed
//     intact by both M2 (name-lookup table) and M3 (effect-row
//     inference seed).
//
//   R224.M3 (effect polymorphism)  --  seats the inferred effect row
//     into the LambdaHeader's `reserved[16]` tail (specifically bytes
//     [16..24] = effect-row id u64). The reservation is wide enough
//     to hold the id directly rather than a pointer.
//
//   R224.M4 (capability-row typing)  --  seats the inferred capability
//     row id into the LambdaHeader's `reserved[16]` tail (bytes
//     [24..32] = cap-row id u64).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32 (0xFF, 0xFFFF).
//   - No 2-op `imul r, imm` -- param stride is `shl rN, 5` (* 32).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `LambdaLit` matches `lambda_lit.pdx`.
//   - Labels prefixed `ll_` (grep-confirmed no collision with any
//     existing paideia-os label namespace; the kernel's `lam.pdx`
//     LAM primitives use the `lam_` three-letter prefix, disjoint
//     from `ll_`).
//   - All `cmp reg, imm` immediates <= 0x2C04 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging.
//   - All byte loads via `xor rax, rax; mov_b rax, [base + idx]`
//     (zero-extends into the full qword); byte stores via
//     `mov_b [dst + disp], reg`, same shape as SchemasSig and
//     Pipeline.
//   - u16 stores via two `mov_b` byte writes (low, high); mov_w
//     short-form not used.
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: Pipeline
//     _pl_emit_word, libpdx-argv emit_parse_error).
//   - u64 zero-fill of a fresh header / Param uses `xor rax, rax;
//     mov [dst + disp], rax; ...` (2 qwords for header reserved,
//     2 qwords for Param reserved).
//   - `_ll_skip_ws` and `_ll_classify_type` are pure leaves: no
//     callee-save push, no stack frame, no nested CALL.
//   - `_ll_parse_param` is a cross-function helper that CALLs
//     `_ll_skip_ws` and `_ll_classify_type`. Prologue: 5 callee-
//     save pushes (rbx, rbp, r12, r13, r14 = 40 B) + sub rsp, 8 for
//     one scratch slot + alignment -> rsp%16==0 (entry 8, +40 = %16==0,
//     wait: 8+40=48, %16==0; +8 = 56, %16==8 -- so we SKIP the extra
//     +8 and rely on the 5-push being already aligned at the CALL).
//     Reconciling: 5 pushes = 40 B; entry rsp%16==8; post-push
//     rsp%16 = (8-40) mod 16 = -32 mod 16 = 0. So %16==0 after 5
//     pushes with no scratch -- nested CALL alignment satisfied with
//     no `sub rsp`. We still allocate `sub rsp, 16` to hold two
//     scratch u64 slots (ident_start, ident_len), yielding rsp%16==0
//     at every nested CALL (8+40+16 = 64 -> %16==0).
//   - `_ll_parse` has a 6-push + 24-byte-scratch frame
//     (rsp%16==0 at every nested CALL). Entry rsp%16==8, +48 pushes
//     = %16==8, +24 scratch = 8+48+24 = 80, %16==0. Matches
//     SchemasSig's _ss_parse_body frame.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R224.M2  Expression parser (same satellite library; consumes
//            the LambdaHeader body_offset/body_len slot).
//   R224.M3  Effect-row inference and polymorphism; seats the
//            inferred row into the header's reserved tail.
//   R224.M4  Capability-row typing; shares the reserved tail with M3.
//   R224.M5  Nested lambda + let-rec scoping; parser integration
//            with R221.M5 AST.
//   R224.M6  Lambda as first-class pipeline value; integration with
//            R223 pipeline-lang stage ABI.
//   R224.M7  Linear/affine interaction with substructural lattice
//            (Walker 2005 propagation rule).
//
// =============================================================================
// Upstream: paideia-os#2675 (THIS ticket, R224.M1). Substrate:
// paideia-os#2651 (R221.M1 UTF-8/NFC parser-tier wrapper),
// paideia-os#2658 (R222.M1 SchemasSig for shared type codes).
// Design doc: design/shell/lambda-literal-grammar.md.

module LambdaLit = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Small-value range 0x2C00..0x2CFF, reserved for the R224 lambda-
  // lang parser band. Disjoint from the R221 parser-tier band
  // (0x2700..), the R222 cmd-functor band (0x2A00..), the R223
  // pipeline-lang band (0x2B00..), and the R129.M4 schema_fmt band
  // (0x1900..). Wave 114 reconciled the earlier "R225.M* reserved"
  // comment: 0x2C00..0x2CFF = R224.M1 (this landing), 0x2D00..0x2DFF
  // = R225.M1 hm_core (HM_ERR_*), 0x2E00..0x2EFF = R226.M1 datalog
  // (DL_ERR_*). The caps.decl reservation records this split.
  //
  // Grep confirmation at R224.M1 landing time:
  //   grep -rE '0x2C0[0-4]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/lambda-literal-grammar.md.

  pub let LL_OK                   : u64 = 0
  pub let LL_ERR_SYNTAX           : u64 = 0x2C00
  pub let LL_ERR_TOO_MANY_PARAMS  : u64 = 0x2C01
  pub let LL_ERR_UNKNOWN_TYPE     : u64 = 0x2C02
  pub let LL_ERR_OUT_TOO_SMALL    : u64 = 0x2C03
  pub let LL_ERR_NO_ARROW         : u64 = 0x2C04

  // ==========================================================================
  // SECTION 2 -- TYPE CODES (one byte, written to param_desc[+0])
  // ==========================================================================
  //
  // Codes 1..6 mirror R222.M1 SS_TYPE_* exactly. Code 7 is deliberately
  // skipped to stay aligned with SF_TYPE_IMAGE's reserved slot. Codes
  // 8..9 are the shared cmd-functor + lambda-param extensions.
  // LL_UNKNOWN_TYPE is a sentinel returned by _ll_classify_type on
  // mismatch; it is NOT a valid param_type byte.

  pub let LL_TYPE_U64             : u64 = 1
  pub let LL_TYPE_I64             : u64 = 2
  pub let LL_TYPE_STR             : u64 = 3
  pub let LL_TYPE_HEX             : u64 = 4
  pub let LL_TYPE_HASH32          : u64 = 5
  pub let LL_TYPE_TSC             : u64 = 6
  pub let LL_TYPE_PATH            : u64 = 8
  pub let LL_TYPE_PID             : u64 = 9
  pub let LL_UNKNOWN_TYPE         : u64 = 0xFF

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let LL_HEADER_BYTES         : u64 = 32
  pub let LL_PARAM_BYTES          : u64 = 32
  pub let LL_NAME_MAX             : u64 = 13
  pub let LL_MAX_PARAMS           : u64 = 8
  pub let LL_HEADER_MAGIC         : u64 = 0x44424D4C

  // LambdaHeader field offsets (byte offsets from header base).
  pub let LL_OFF_MAGIC            : u64 = 0
  pub let LL_OFF_N_PARAMS         : u64 = 4
  pub let LL_OFF_FLAGS            : u64 = 6
  pub let LL_OFF_BODY_OFFSET      : u64 = 8
  pub let LL_OFF_BODY_LEN         : u64 = 12
  pub let LL_OFF_RESERVED         : u64 = 16

  // Param field offsets (byte offsets from param base).
  pub let LL_PARAM_OFF_TYPE       : u64 = 0
  pub let LL_PARAM_OFF_NAME_LEN   : u64 = 1
  pub let LL_PARAM_OFF_NAME       : u64 = 2
  pub let LL_PARAM_OFF_RESERVED   : u64 = 16

  // ==========================================================================
  // _ll_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a space-
  // class byte, OR cursor == bytes_len (end-of-input is a valid stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ll_sw_.
  // ==========================================================================
  pub let _ll_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M1 (#2675): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. The space-class check is four cmp-imm32 branches rather than a bitmap because the set is small and the branch predictor can speculate the common no-ws case. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ll_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      ll_sw_scan:
        cmp rax, rsi;
        jae ll_sw_stop;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  ll_sw_step;
        cmp rcx, 0x09;
        je  ll_sw_step;
        cmp rcx, 0x0A;
        je  ll_sw_step;
        cmp rcx, 0x0D;
        je  ll_sw_step;
        jmp ll_sw_stop;

      ll_sw_step:
        add rax, 1;
        jmp ll_sw_scan;

      ll_sw_stop:
        ret;
      }
    }

  // ==========================================================================
  // _ll_classify_type(ident_ptr, ident_len) -> type_code
  //
  //   rdi = ident_ptr
  //   rsi = ident_len
  //   rax = LL_TYPE_U64 (1), LL_TYPE_I64 (2), LL_TYPE_STR (3),
  //         LL_TYPE_HEX (4), LL_TYPE_HASH32 (5), LL_TYPE_TSC (6),
  //         LL_TYPE_PATH (8), LL_TYPE_PID (9), or LL_UNKNOWN_TYPE (0xFF).
  //
  // Length-switched dispatch -- branch on ident_len first, then compare
  // the exact literal bytes. Length-3 covers u64/i64/str/hex/tsc/pid
  // (six 3-letter types). Length-4 covers `path`. Length-6 covers
  // `hash32`. Any other length is unknown.
  //
  // Shape parallel to R222.M1 _sch_sig_classify_type and R135.M5
  // _wb_classify_type. Pure leaf -- no callee-save push, no stack
  // frame, no nested CALL. Labels prefixed ll_ct_.
  // ==========================================================================
  pub let _ll_classify_type : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M1 (#2675): classify a candidate type_name ident against the M1-known type set. Length-switched dispatch: 3 -> six 3-letter types (u64/i64/str/hex/tsc/pid); 4 -> path; 6 -> hash32. Each length arm does a first-byte branch (`xor rax, rax; mov_b rax, [rdi+0]; cmp rax, <lit>; je ...`) then confirms the trailing bytes with further mov_b+cmp pairs. Returns LL_UNKNOWN_TYPE (0xFF) on any mismatch. Pure leaf -- zero pushes, no stack frame, no nested CALL. All ASCII literals (0x30..0x7A) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ll_ct_.",
      block: {
        cmp rsi, 3;
        je  ll_ct_len3;
        cmp rsi, 4;
        je  ll_ct_len4;
        cmp rsi, 6;
        je  ll_ct_len6;
        jmp ll_ct_bad;

        // ---- length 3: u64 / i64 / str / hex / tsc / pid ----
      ll_ct_len3:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                         // 'u'
        je  ll_ct_u64;
        cmp rax, 0x69;                         // 'i'
        je  ll_ct_i64;
        cmp rax, 0x73;                         // 's'
        je  ll_ct_str;
        cmp rax, 0x68;                         // 'h'
        je  ll_ct_hex;
        cmp rax, 0x74;                         // 't'
        je  ll_ct_tsc;
        cmp rax, 0x70;                         // 'p'
        je  ll_ct_pid;
        jmp ll_ct_bad;

      ll_ct_u64:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne ll_ct_bad;
        mov rax, 1;                            // LL_TYPE_U64
        ret;

      ll_ct_i64:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne ll_ct_bad;
        mov rax, 2;                            // LL_TYPE_I64
        ret;

      ll_ct_str:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x74;                         // 't'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x72;                         // 'r'
        jne ll_ct_bad;
        mov rax, 3;                            // LL_TYPE_STR
        ret;

      ll_ct_hex:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x65;                         // 'e'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x78;                         // 'x'
        jne ll_ct_bad;
        mov rax, 4;                            // LL_TYPE_HEX
        ret;

      ll_ct_tsc:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x73;                         // 's'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x63;                         // 'c'
        jne ll_ct_bad;
        mov rax, 6;                            // LL_TYPE_TSC
        ret;

      ll_ct_pid:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x69;                         // 'i'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x64;                         // 'd'
        jne ll_ct_bad;
        mov rax, 9;                            // LL_TYPE_PID
        ret;

        // ---- length 4: path ----
      ll_ct_len4:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x70;                         // 'p'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x74;                         // 't'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne ll_ct_bad;
        mov rax, 8;                            // LL_TYPE_PATH
        ret;

        // ---- length 6: hash32 ----
      ll_ct_len6:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x68;                         // 'h'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x73;                         // 's'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0x33;                         // '3'
        jne ll_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 5];
        cmp rax, 0x32;                         // '2'
        jne ll_ct_bad;
        mov rax, 5;                            // LL_TYPE_HASH32
        ret;

      ll_ct_bad:
        mov rax, 0xFF;                         // LL_UNKNOWN_TYPE
        ret;
      }
    }

  // ==========================================================================
  // _ll_parse_param(bytes_ptr, bytes_len, cursor_in,
  //                 param_write_ptr) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rcx = param_write_ptr   (dst for the 32-byte Param descriptor)
  //   rax = (new_cursor << 32) | status
  //
  // Parses exactly ONE Param (identifier WS* ':' WS* type_name) at the
  // current cursor and writes a 32-byte Param descriptor at
  // param_write_ptr. Returns the post-Param cursor packed into the
  // high 32 bits, and status in the low 32:
  //
  //     LL_OK                 -- descriptor written, cursor advanced.
  //     LL_ERR_SYNTAX         -- bad grammar at ident or ':'.
  //     LL_ERR_UNKNOWN_TYPE   -- type_name not in the M1 set.
  //
  // Does NOT itself check LL_MAX_PARAMS or LL_ERR_OUT_TOO_SMALL --
  // those are the main parse's responsibility (caller validates
  // before calling here).
  //
  // Prologue: 5 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len,
  // r12=cursor, r13=param_write_ptr, r14=scratch for the type_start
  // span) = 40 B; +16 B scratch frame = 56 B; rsp%16 = (8-56) mod 16
  // = 0 at every nested CALL. Scratch slots:
  //
  //   [rsp + 0]  = ident_start
  //   [rsp + 8]  = ident_len
  //
  // Labels prefixed ll_pp_.
  // ==========================================================================
  pub let _ll_parse_param : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64)
       (param_write_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M1 (#2675): parse ONE Param (identifier WS* ':' WS* type_name) and write a 32-byte Param descriptor at param_write_ptr. 5 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=param_write_ptr, r14=scratch) + sub rsp, 16 (two u64 scratch slots: ident_start and ident_len) -> rsp%16==0 at every nested CALL (entry 8, +40 pushes = %16==0, +16 scratch = %16==0). Grammar: skip_ws; ident scan (byte-class [A-Za-z_] [A-Za-z0-9_]*; max LL_NAME_MAX=13 chars); skip_ws + require ':'; skip_ws; type_name scan; classify via _ll_classify_type; emit descriptor (type_code u8, name_len u8, name bytes + zero-pad, reserved[16]=0). The 32-byte descriptor is written byte-by-byte via mov_b and two u64 zero stores for the reserved tail. Returns packed (new_cursor << 32) | status; caller uses `cmp rax, 0xFFFFFFFF` style masking (actually just `cmp (rax & 0xFFFF), 0`) to test status -- or more cheaply, the main parse jumps to error if `rax & 0xFFFFFFFF != 0`, extracting new_cursor by shr-32. All error paths pack (0 << 32) | status so new_cursor is only valid on OK. All cmp immediates (ASCII 0x30..0x7A, LL_NAME_MAX=13) fit in imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ll_pp_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        mov r12, rdx;                          // cursor
        mov r13, rcx;                          // param_write_ptr
        xor r14, r14;                          // scratch
        xor rax, rax;
        mov [rsp + 0], rax;                    // ident_start = 0
        mov [rsp + 8], rax;                    // ident_len = 0

        // ---- skip_ws before ident ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        // ---- Ident scan ----
        cmp r12, rbp;
        jae ll_pp_err_syntax;

        mov [rsp + 0], r12;                    // ident_start = cursor
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;                         // '_'
        je  ll_pp_ident_more;
        cmp rax, 0x41;                         // 'A'
        jb  ll_pp_err_syntax;
        cmp rax, 0x5A;                         // 'Z'
        jbe ll_pp_ident_more;
        cmp rax, 0x61;                         // 'a'
        jb  ll_pp_err_syntax;
        cmp rax, 0x7A;                         // 'z'
        ja  ll_pp_err_syntax;

      ll_pp_ident_more:
        add r12, 1;

      ll_pp_ident_scan:
        cmp r12, rbp;
        jae ll_pp_ident_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  ll_pp_ident_step;
        cmp rax, 0x30;                         // '0'
        jb  ll_pp_ident_check_alpha;
        cmp rax, 0x39;                         // '9'
        jbe ll_pp_ident_step;
      ll_pp_ident_check_alpha:
        cmp rax, 0x41;
        jb  ll_pp_ident_end;
        cmp rax, 0x5A;
        jbe ll_pp_ident_step;
        cmp rax, 0x61;
        jb  ll_pp_ident_end;
        cmp rax, 0x7A;
        ja  ll_pp_ident_end;
      ll_pp_ident_step:
        add r12, 1;
        jmp ll_pp_ident_scan;

      ll_pp_ident_end:
        // ident_len = cursor - ident_start
        mov rax, r12;
        sub rax, [rsp + 0];
        mov [rsp + 8], rax;                    // ident_len
        cmp rax, 0;
        je  ll_pp_err_syntax;
        cmp rax, 13;                           // LL_NAME_MAX
        ja  ll_pp_err_syntax;

        // ---- Require ':' (skip_ws first) ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae ll_pp_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne ll_pp_err_syntax;
        add r12, 1;

        // ---- skip_ws before type_name ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        // ---- Type_name scan ----
        cmp r12, rbp;
        jae ll_pp_err_syntax;
        mov r14, r12;                          // type_start
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  ll_pp_type_more;
        cmp rax, 0x41;
        jb  ll_pp_err_syntax;
        cmp rax, 0x5A;
        jbe ll_pp_type_more;
        cmp rax, 0x61;
        jb  ll_pp_err_syntax;
        cmp rax, 0x7A;
        ja  ll_pp_err_syntax;

      ll_pp_type_more:
        add r12, 1;

      ll_pp_type_scan:
        cmp r12, rbp;
        jae ll_pp_type_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  ll_pp_type_step;
        cmp rax, 0x30;
        jb  ll_pp_type_check_alpha;
        cmp rax, 0x39;
        jbe ll_pp_type_step;
      ll_pp_type_check_alpha:
        cmp rax, 0x41;
        jb  ll_pp_type_end;
        cmp rax, 0x5A;
        jbe ll_pp_type_step;
        cmp rax, 0x61;
        jb  ll_pp_type_end;
        cmp rax, 0x7A;
        ja  ll_pp_type_end;
      ll_pp_type_step:
        add r12, 1;
        jmp ll_pp_type_scan;

      ll_pp_type_end:
        // type_len = cursor - type_start; must be >= 1 (we matched >=
        // one byte above).
        mov r8, r12;
        sub r8, r14;
        cmp r8, 0;
        je  ll_pp_err_syntax;

        // ---- Classify ----
        // _ll_classify_type(bytes_ptr + type_start, type_len).
        mov rdi, rbx;
        add rdi, r14;
        mov rsi, r8;
        call _ll_classify_type;
        cmp rax, 0xFF;                         // LL_UNKNOWN_TYPE
        je  ll_pp_err_bad_type;

        // rax = type_code (1..9, with 7 skipped). Stash in r14.
        mov r14, rax;

        // ---- Write Param descriptor at r13. ----
        // [r13 + 0] = type_code (u8). Source register must be rax
        // for the paideia-as mov_b byte-store encoding (precedent:
        // SchemasSig _ss_parse_body line 954, Pipeline _pl_emit_word
        // line 408).
        mov rax, r14;
        mov_b [r13 + 0], rax;

        // [r13 + 1] = ident_len (u8).
        mov rax, [rsp + 8];
        mov_b [r13 + 1], rax;

        // Copy ident bytes: src = rbx + ident_start; dst = r13 + 2.
        // Count = ident_len.
        mov r9, [rsp + 0];                     // r9 = ident_start
        mov r10, [rsp + 8];                    // r10 = ident_len

        xor r11, r11;                          // i = 0
      ll_pp_name_copy:
        cmp r11, r10;
        jae ll_pp_name_pad;
        mov rdi, rbx;
        add rdi, r9;
        add rdi, r11;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, r13;
        add rsi, 2;
        add rsi, r11;
        mov_b [rsi + 0], rax;
        add r11, 1;
        jmp ll_pp_name_copy;

      ll_pp_name_pad:
        // Zero-pad bytes [2 + ident_len .. 16).
        mov r11, r10;
        add r11, 2;                            // start_off = 2 + ident_len
      ll_pp_name_pad_scan:
        cmp r11, 16;
        jae ll_pp_reserved_zero;
        mov rsi, r13;
        add rsi, r11;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r11, 1;
        jmp ll_pp_name_pad_scan;

      ll_pp_reserved_zero:
        // Zero reserved[16] at [r13 + 16..32] via two u64 stores.
        xor rax, rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // ---- Success: pack (new_cursor << 32) | LL_OK. ----
        mov rax, r12;
        shl rax, 32;
        jmp ll_pp_epilogue;

        // ---- Error paths ----
      ll_pp_err_syntax:
        mov rax, 0x2C00;                       // LL_ERR_SYNTAX
        jmp ll_pp_epilogue;

      ll_pp_err_bad_type:
        mov rax, 0x2C02;                       // LL_ERR_UNKNOWN_TYPE
        jmp ll_pp_epilogue;

      ll_pp_epilogue:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _ll_parse(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Walks the input bytes as:
  //
  //   skip_ws
  //   require '\'                              (else LL_ERR_SYNTAX)
  //   skip_ws
  //   if peek == '(':
  //       consume '('
  //       skip_ws
  //       if peek == ')':
  //           consume ')'                      -- empty multi-param
  //       else:
  //           parse_param                      -- 1st param
  //           loop:
  //               skip_ws
  //               if peek == ',': consume, parse_param
  //               elif peek == ')': consume, break
  //               else: LL_ERR_SYNTAX
  //   else:
  //       parse_param                          -- single param, no parens
  //   skip_ws
  //   require "->"                             (else LL_ERR_NO_ARROW)
  //   body_offset_input = cursor
  //   body_len = bytes_len - body_offset_input
  //   validate out_cap >= 32 + n_params*32 + body_len (else OUT_TOO_SMALL)
  //   copy body_len bytes from input[body_offset_input..] to
  //        out_ptr + 32 + n_params*32
  //   write LambdaHeader at out_ptr[0..32]:
  //       magic = LL_HEADER_MAGIC
  //       n_params = n_params (u16)
  //       flags = 0 (u16)
  //       body_offset = 32 + n_params*32   (u32; offset within out)
  //       body_len = body_len               (u32)
  //       reserved[16] = 0
  //   bytes_written = body_offset + body_len
  //   return (bytes_written << 32) | LL_OK
  //
  // Register map (6 callee-save pushes + 24-byte scratch frame ->
  // rsp%16==0 steady):
  //
  //   rbx = bytes_ptr
  //   rbp = bytes_len
  //   r12 = cursor (into input)
  //   r13 = out_ptr base (immutable)
  //   r14 = out_cap (immutable)
  //   r15 = n_params counter
  //
  //   [rsp + 0]  = param_write_ptr (initial: r13 + LL_HEADER_BYTES)
  //   [rsp + 8]  = scratch (unused but zeroed for determinism)
  //   [rsp + 16] = scratch (unused but zeroed for determinism)
  //
  // Labels prefixed ll_.
  // ==========================================================================
  pub let _ll_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M1 (#2675): parse a `\\x:u64 -> ...` or `\\(x:u64, y:u64) -> ...` lambda literal. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr base, r14=out_cap, r15=n_params) + sub rsp, 24 (scratch) -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +24 scratch -> %16==0; nested CALLs into _ll_skip_ws and _ll_parse_param land aligned). State: cursor walks through input; param_write_ptr at [rsp+0] walks through output param descriptors starting at out_ptr + LL_HEADER_BYTES (32). Each _ll_parse_param call emits a 32-byte Param descriptor and returns a packed (new_cursor << 32) | status; on status != 0 we jump to the error epilogue with the status in rax. Grammar: skip_ws; '\\'; skip_ws; one of (a) '(' + MultiParam + ')' or (b) SingleParam; skip_ws; '->'; the rest is opaque body bytes. Body-copy pass: validate out_cap >= 32 + n_params*32 + body_len; byte-copy from [rbx + body_offset_input .. rbx + bytes_len) to [r13 + body_offset_out ..). Header-write pass: magic u32 'LMBD'=0x44424D4C via mov_d; n_params u16 and flags u16 via mov_b pairs; body_offset u32 and body_len u32 via mov_d; reserved[16] zeroed via two u64 stores. Param stride multiplied as `shl rN, 5` for the * 32 computation -- never `imul r, imm` (per feedback_pdx_encoder_pitfalls). All error paths jump to a shared epilogue that unwinds the 24-byte scratch and 6 callee-save pops. All `cmp` immediates (ASCII literals 0x20..0x7F, type codes 0..9, status codes 0x2C00..0x2C04, LL_MAX_PARAMS=8, LL_NAME_MAX=13, LL_HEADER_BYTES=32, LL_PARAM_BYTES=32) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ll_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Load state regs.
        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        xor r12, r12;                          // cursor = 0
        mov r13, rdx;                          // out_ptr (immutable)
        mov r14, rcx;                          // out_cap (immutable)
        xor r15, r15;                          // n_params = 0

        // param_write_ptr = out_ptr + LL_HEADER_BYTES (32).
        mov rax, r13;
        add rax, 32;
        mov [rsp + 0], rax;

        xor rax, rax;
        mov [rsp + 8], rax;
        mov [rsp + 16], rax;

        // Capacity guard: must fit at least the header.
        cmp r14, 32;
        jb  ll_err_oos;

        // ------------------------------------------------------------
        // skip_ws + require '\'.
        // ------------------------------------------------------------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae ll_err_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5C;                         // '\\'
        jne ll_err_syntax;
        add r12, 1;

        // ------------------------------------------------------------
        // skip_ws; peek for '(' (multi-param) vs single-param path.
        // ------------------------------------------------------------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae ll_err_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x28;                         // '('
        je  ll_multi_open;

        // ------------------------------------------------------------
        // Single-param path: validate caps + MAX_PARAMS, then parse.
        // ------------------------------------------------------------
      ll_single_entry:
        // Capacity: param_write_ptr + 32 - out_ptr <= out_cap.
        mov rax, [rsp + 0];
        add rax, 32;
        sub rax, r13;
        cmp rax, r14;
        ja  ll_err_oos;

        // Param-count guard (always true on first entry since r15=0,
        // but keep the shape uniform with the multi-param path).
        cmp r15, 8;                            // LL_MAX_PARAMS
        jae ll_err_too_many;

        // Call _ll_parse_param(bytes_ptr, bytes_len, cursor,
        // param_write_ptr) -> packed(new_cursor<<32)|status.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call _ll_parse_param;

        // Split rax into (new_cursor, status).
        mov r10, rax;                          // r10 = status candidate
        shl r10, 32;                           // zap high 32
        shr r10, 32;                           // r10 = low 32 (status)
        cmp r10, 0;
        jne ll_err_from_sub;

        // Success: extract new_cursor from high 32.
        shr rax, 32;
        mov r12, rax;                          // cursor = new_cursor

        // Advance param_write_ptr + n_params.
        mov rax, [rsp + 0];
        add rax, 32;
        mov [rsp + 0], rax;
        add r15, 1;

        jmp ll_after_params;

        // ------------------------------------------------------------
        // Multi-param path: '(' + optional empty + Param (',' Param)*
        // + ')'.
        // ------------------------------------------------------------
      ll_multi_open:
        add r12, 1;                            // consume '('

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae ll_err_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x29;                         // ')'
        je  ll_multi_close;

      ll_multi_first:
        // Caps + MAX_PARAMS before each parse_param.
        mov rax, [rsp + 0];
        add rax, 32;
        sub rax, r13;
        cmp rax, r14;
        ja  ll_err_oos;

        cmp r15, 8;
        jae ll_err_too_many;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call _ll_parse_param;

        mov r10, rax;
        shl r10, 32;
        shr r10, 32;
        cmp r10, 0;
        jne ll_err_from_sub;

        shr rax, 32;
        mov r12, rax;

        mov rax, [rsp + 0];
        add rax, 32;
        mov [rsp + 0], rax;
        add r15, 1;

      ll_multi_tail:
        // skip_ws; expect ',' or ')'.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae ll_err_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2C;                         // ','
        je  ll_multi_comma;
        cmp rax, 0x29;                         // ')'
        je  ll_multi_close;
        jmp ll_err_syntax;

      ll_multi_comma:
        add r12, 1;                            // consume ','
        jmp ll_multi_first;

      ll_multi_close:
        add r12, 1;                            // consume ')'
        jmp ll_after_params;

        // ------------------------------------------------------------
        // After params: skip_ws + require "->".
        // ------------------------------------------------------------
      ll_after_params:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _ll_skip_ws;
        mov r12, rax;

        // Need two bytes: '-' and '>'.
        mov rax, r12;
        add rax, 1;
        cmp rax, rbp;
        jae ll_err_no_arrow;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2D;                         // '-'
        jne ll_err_no_arrow;

        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x3E;                         // '>'
        jne ll_err_no_arrow;

        add r12, 2;                            // consume "->"

        // ------------------------------------------------------------
        // Body copy + header write.
        //
        // body_offset_input = r12 (current cursor)
        // body_len          = rbp - r12
        // body_offset_out   = LL_HEADER_BYTES + n_params * LL_PARAM_BYTES
        //                   = 32 + (r15 << 5)
        // required_out_cap  = body_offset_out + body_len
        // ------------------------------------------------------------
        mov r10, r15;                          // r10 = n_params
        shl r10, 5;                            // r10 = n_params * 32
        add r10, 32;                           // r10 = body_offset_out

        mov r11, rbp;
        sub r11, r12;                          // r11 = body_len

        // Capacity check: out_cap >= body_offset_out + body_len.
        mov r8, r10;
        add r8, r11;
        cmp r8, r14;
        ja  ll_err_oos;

        // ---- Body-copy loop: byte-by-byte from input to out. -----
        xor rcx, rcx;                          // i = 0

      ll_body_copy:
        cmp rcx, r11;
        jae ll_body_done;

        mov rdi, rbx;
        add rdi, r12;
        add rdi, rcx;
        xor rax, rax;
        mov_b rax, [rdi + 0];

        mov rsi, r13;
        add rsi, r10;
        add rsi, rcx;
        mov_b [rsi + 0], rax;

        add rcx, 1;
        jmp ll_body_copy;

      ll_body_done:
        // ---- Header write at r13[0..32]. ------------------------
        //
        // magic (u32) at [r13 + LL_OFF_MAGIC = 0]:
        mov rax, 0x44424D4C;
        mov_d [r13 + 0], rax;

        // n_params (u16) at [r13 + LL_OFF_N_PARAMS = 4]:
        //   low byte, high byte via two mov_b.
        mov rax, r15;
        mov_b [r13 + 4], rax;
        shr rax, 8;
        mov_b [r13 + 5], rax;

        // flags (u16) at [r13 + LL_OFF_FLAGS = 6] = 0:
        xor rax, rax;
        mov_b [r13 + 6], rax;
        mov_b [r13 + 7], rax;

        // body_offset (u32) at [r13 + LL_OFF_BODY_OFFSET = 8]:
        mov rax, r10;
        mov_d [r13 + 8], rax;

        // body_len (u32) at [r13 + LL_OFF_BODY_LEN = 12]:
        mov rax, r11;
        mov_d [r13 + 12], rax;

        // reserved[16] at [r13 + 16..32] = 0 (two u64 zero stores).
        xor rax, rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // ---- Success: pack return. --------------------------------
        //
        // bytes_written = body_offset_out + body_len = r10 + r11 = r8
        // (we computed r8 above for the cap check; it's intact).
        // Pack: (bytes_written << 32) | LL_OK (= 0).
        mov rax, r8;
        shl rax, 32;
        jmp ll_epilogue;

        // ============================================================
        // Error paths
        // ============================================================
      ll_err_from_sub:
        // r10 carries the LL_ERR_* status from the sub-walk.
        mov rax, r10;
        jmp ll_epilogue;

      ll_err_syntax:
        mov rax, 0x2C00;                       // LL_ERR_SYNTAX
        jmp ll_epilogue;

      ll_err_too_many:
        mov rax, 0x2C01;                       // LL_ERR_TOO_MANY_PARAMS
        jmp ll_epilogue;

      ll_err_oos:
        mov rax, 0x2C03;                       // LL_ERR_OUT_TOO_SMALL
        jmp ll_epilogue;

      ll_err_no_arrow:
        mov rax, 0x2C04;                       // LL_ERR_NO_ARROW
        jmp ll_epilogue;

        // ============================================================
        // Epilogue
        // ============================================================
      ll_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
