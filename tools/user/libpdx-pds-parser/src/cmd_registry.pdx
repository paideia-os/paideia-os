// src/cmd_registry.pdx -- libpdx-pds-parser.R222.M5 (paideia-os#2662)
//
// CmdRegistry: per-session command-registry client. R222.M5 of the
// cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1 (SchemasSig) + R222.M2 (CommandSig) + R222.M3 (FunctorInstance)
// + R222.M4 (ArgFlagSpec) land the four PER-COMMAND SIGNATURE records.
// R222.M5 (THIS module) lands the per-SESSION CATALOGUE those four
// records index into: a flat hash table over command name_hash that
// a REPL prompt consults at every dispatch to resolve
// `<name> <args>...` into a `(cmd_sig_body_ref, functor_ref)` pair.
//
// Per `design/terminal/command-registry.md`:
//
//   * The on-disk source of truth is `/system/shell/commands.toml`
//     (shared across all users) plus `/users/<u>/shell/commands.toml`
//     (per-user shadow). User-shadow entries OVERRIDE system entries
//     with the same name (per CRG-D4).
//   * At session start the registry client reads BOTH files, registers
//     the system entries first (scope=CMDREG_SCOPE_SYSTEM=0), then the
//     user entries (scope=CMDREG_SCOPE_USER=1). The lookup rule prefers
//     the user entry when both exist.
//
// At M5 the TOML parser is NOT reinvented: the on-disk TOML -> flat
// bytes transform lives in the kernel-side `cmd_registry_parser.pdx`
// (R123.M2, landed) which this user-space client calls back into at
// session boot via linker-resolved symbol. In isolation (fixture
// drivers, this landing's acceptance test), the caller hands this
// module a pre-flattened byte buffer of 48-byte entries directly
// through `_cmdreg_register` -- the TOML layer is one bind point above
// this and does NOT appear in the public API of this module. That
// discipline keeps the registry client testable without the kernel-
// side pdxfs path a running session needs.
//
// Scope at M5:
//   * flat 128-slot .bss table of 48-byte entries (closed-addressing
//     hash table with linear-probe collision resolution)
//   * `_cmdreg_init` zero-fills the table (idempotent lazy boot hook)
//   * `_cmdreg_register(scope, name, name_len, cs_body_ref, functor_ref)`
//     interns a (name_hash, cs_body_ref, functor_ref, scope) tuple
//     into the first unoccupied slot on the probe chain
//   * `_cmdreg_lookup(name, name_len, out_entry_ptr)` scans the probe
//     chain of the hashed slot; among all matching entries picks the
//     SCOPE=USER entry if any, else the SCOPE=SYSTEM entry; writes the
//     winning entry's pointer to `out_entry_ptr`
//   * `_cmdreg_dump(out, out_cap)` lists all occupied entries into a
//     caller buffer for the `describe` builtin (R222.M8)
//   * FNV-1a 64 hash of the command name as the probe key, byte-for-
//     byte identical to R222.M2 CommandSig's `_cmd_sig_fnv1a64` and
//     R222.M3 FunctorInstance's `_fi_fnv1a64` (same offset basis and
//     prime; name_hash on a given utf-8 ASCII command name is numeric-
//     ally identical across the three modules so `name_hash` can be
//     compared against the CommandSig CapDecl's `name_hash` field for
//     a free integrity check)
//
// Out of scope at M5 (deferred):
//   * TOML parse (lives in R123.M2 kernel-side cmd_registry_parser.pdx)
//   * commands.toml bind (R222.M6)
//   * registry fuzz corpus (R222.M7)
//   * `describe <cmd>` serialization (R222.M8; this module provides
//     the enumeration surface `_cmdreg_dump` M8 will format over)
//   * hot reload (CRG-O1 open; a running session picks up registry
//     changes at the NEXT session boot in M5)
//   * registry eviction (never evicts at M5; the table is write-once
//     from session boot to session end)
//
// =============================================================================
// POOL LAYOUT
// =============================================================================
//
// `.bss` `_cmdreg_entries : [u8; N*48]` with N=CMDREG_SLOTS=128 and
// stride CMDREG_ENTRY_BYTES=48. Per-entry layout:
//
//     offset size field               notes
//     ------ ---- ------------------- ------------------------------
//       0x00  8   name_hash   u64     FNV-1a 64 of the command name
//                                     bytes. 0 marks an empty slot
//                                     (collision with a legitimate
//                                     name whose FNV hash is exactly
//                                     0 is 2^-64; a defensive future
//                                     landing may reserve a sentinel
//                                     bit).
//       0x08  8   cs_body_ref u64     opaque u64 handle to the owning
//                                     CommandSig record (R222.M2). At
//                                     M5 this is a pointer into a
//                                     caller-managed region; a later
//                                     landing may replace it with a
//                                     pool-relative index.
//       0x10  8   functor_ref u64     opaque u64 handle to the paideia-
//                                     as functor module (R222.M3). At
//                                     M5 the caller treats this as a
//                                     tagged word; M6+ unifies the tag.
//       0x18  1   scope       u8      0 = CMDREG_SCOPE_SYSTEM,
//                                     1 = CMDREG_SCOPE_USER.
//       0x19  1   flags       u8      reserved; 0 at M5.
//       0x1A  1   name_len    u8      1..CMDREG_NAME_MAX = 16.
//       0x1B  1   reserved    u8      0.
//       0x1C 16   name_inline u8[16]  ASCII name bytes, zero-padded
//                                     past name_len (16-byte truncation
//                                     boundary; name_hash preserves
//                                     full identity).
//       0x2C  4   reserved    u32     0.
//
//     total: 48 B (CMDREG_ENTRY_BYTES)
//
// The 48-byte stride is NOT a power of two, so the stride multiply is
// `shl idx, 5` (* 32) + `shl idx, 4` (* 16) via two shift+add -- never
// 2-op `imul r, imm` (per feedback_pdx_encoder_pitfalls). The two sub-
// strides are both power-of-two so each individual shift stays in the
// pitfall-safe shape.
//
// Hash-to-slot mapping: `slot = hash mod 128`. Because 128 = 2^7, the
// mod is `(hash << 57) >> 57` -- isolates the low 7 bits via a shift-
// pair, never `and r, imm64` (per feedback_pdx_encoder_pitfalls). The
// row_types.pdx precedent for idx masking (`shl r, 40; shr r, 40`
// isolates low 24 bits) is the same shape.
//
// Linear-probe discipline: on insert, probe `slot, slot+1, slot+2, ...
// (mod 128)` until an empty slot is found. On lookup, probe the same
// chain; stop at the FIRST empty slot and return the best match seen
// so far. "Best match" is defined as:
//
//   1. If any entry on the probe chain has name_hash == target_hash
//      AND scope == CMDREG_SCOPE_USER, return that entry.
//   2. Else, if any entry has name_hash == target_hash AND scope ==
//      CMDREG_SCOPE_SYSTEM, return that entry.
//   3. Else return CMDREG_ERR_NOT_FOUND.
//
// The two-pass register discipline (system entries registered FIRST,
// user entries SECOND) is a SIMPLIFICATION over the general case:
// because the probe chain visits entries in insertion order, a user
// entry registered after its matching system entry lands later on the
// probe chain, so the lookup can stop at the FIRST user hit (if any)
// before continuing to the system entry. The implementation does the
// full chain scan for correctness, keeping the invariant decoupled
// from the register call order.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _cmdreg_init() -> ()
//
//     Zero-fills the 128-entry table and resets both the system and
//     user cursors to 0. Idempotent: a second call after the first is
//     a no-op (the module tracks initialisation via a .bss sentinel
//     `_cmdreg_init_state`; `_cmdreg_init_state != 0` short-circuits).
//     Every public API that READS the table calls `_cmdreg_init` at
//     its entry (Wave 120 lazy-init lesson).
//
//     Register map: () -> rax (ignored).
//
//   _cmdreg_register(scope, name, name_len, cs_body_ref, functor_ref)
//                                                   -> errno
//
//     Insert an entry at scope in {CMDREG_SCOPE_SYSTEM, CMDREG_SCOPE_USER}.
//     Computes `name_hash = _cmdreg_fnv1a64(name, name_len)`, probes
//     the slot chain starting at `hash mod 128`, and claims the first
//     empty slot.
//
//     Returns:
//       CMDREG_OK                   (0)       on insert.
//       CMDREG_ERR_BAD_SCOPE        (0x4502)  scope not in {0, 1}.
//       CMDREG_ERR_BAD_NAME         (0x4503)  name_len == 0 or
//                                             name_len > CMDREG_NAME_MAX.
//       CMDREG_ERR_TABLE_FULL       (0x4504)  all 128 slots occupied
//                                             (probe wrapped to the
//                                             starting slot).
//
//     Register map: (rdi, rsi, rdx, rcx, r8) -> rax.
//
//   _cmdreg_lookup(name, name_len, out_entry_ptr) -> errno
//
//     Resolve a name to its best-match entry. Writes the entry base
//     address into `*out_entry_ptr` on success; writes 0 on error.
//
//     Returns:
//       CMDREG_OK                   (0)       on hit.
//       CMDREG_ERR_BAD_NAME         (0x4503)  name_len == 0 or
//                                             name_len > CMDREG_NAME_MAX.
//       CMDREG_ERR_NOT_FOUND        (0x4501)  no entry with matching
//                                             name_hash on the probe
//                                             chain.
//
//     Register map: (rdi, rsi, rdx) -> rax.
//
//   _cmdreg_dump(out, out_cap) -> packed_u64
//
//     List all occupied entries into `out[0 .. 48 * n]`, in slot
//     order. Returns `(bytes_written << 32) | status`:
//
//       CMDREG_OK                   (0)
//       CMDREG_ERR_OUT_TOO_SMALL    (0x4505)  out_cap <
//                                             (n_occupied * 48).
//
//     Register map: (rdi, rsi) -> rax.
//
//   _cmdreg_fnv1a64(ptr, len) -> hash
//
//     Byte-for-byte identical to R222.M2's `_cmd_sig_fnv1a64` and
//     R222.M3's `_fi_fnv1a64`. Replicated here so this module can be
//     linked standalone (same disjoint-leaf precedent as the parser-
//     family's `_sch_sig_skip_ws` / `_cmd_sig_skip_ws` / `_fi_skip_ws`
//     / `_afs_skip_ws` quartet).
//
//     Register map: (rdi, rsi) -> rax.
//
// =============================================================================
// STATUS BAND -- 0x4500..0x45FF
// =============================================================================
//
//   CMDREG_OK                   = 0
//   CMDREG_ERR_NOT_FOUND        = 0x4501
//   CMDREG_ERR_BAD_SCOPE        = 0x4502
//   CMDREG_ERR_BAD_NAME         = 0x4503
//   CMDREG_ERR_TABLE_FULL       = 0x4504
//   CMDREG_ERR_OUT_TOO_SMALL    = 0x4505
//
// The 0x4500..0x45FF band carves a non-adjacent kilo-step past Wave
// 121's 0x4300..0x43FF (R224.M4 CapRow). The 0x4400..0x44FF slot
// is reserved for the parallel R221.M5 arm of this wave; the two
// Wave 122 arms sit on adjacent kilo-step boundaries disjoint from
// every prior landed band.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- hash-slot mod uses `shl r, 57; shr r, 57`
//     to isolate low 7 bits of a u64; name-length mask / bit tests
//     use imm8 variants only.
//   - No 2-op `imul r, imm` -- 48-byte stride decomposes as
//     `shl idx, 5 (= *32) + shl idx, 4 (= *16)` summed into a scratch
//     register; the FNV multiply is one-op `mul rcx` (precedent:
//     command_sig.pdx line 450).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `CmdRegistry` matches `cmd_registry.pdx`.
//   - Labels prefixed `cmdreg_` (NOT `cr_` which is TAKEN by R224.M4
//     CapRow). The prefix is grep-confirmed unique across the parser-
//     tier modules (u8n_, gi_, wp_, sch_sig_, cmd_sig_, fi_, afs_,
//     pl_, rp_, ll_, cc_, er_, cr_, hm_, rt_, dl_, se_, te_, cl_).
//     Never bare `loop`/`if`/`let`/`fn`/`ret` (per
//     reference_paideia_as_reserved_labels).
//   - All `cmp reg, imm` immediates (0, 1, 2, 7, 16, 48, 127, 128,
//     status codes 0x4500..0x4505) fit in imm32 with bit 31 clear.
//     CMDREG_FNV_OFFSET (0xCBF29CE484222325) and CMDREG_FNV_PRIME
//     (0x100000001B3) are both imm64 loaded via `mov rN, imm64`.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx]` zero-extend
//     into the full qword.
//   - Byte stores via `mov_b [dst + disp], reg` or
//     `mov r11, base; add r11, idx; mov_b [r11], src`.
//   - u32 stores via `mov_d [dst + disp], reg`.
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - Cross-module `.bss` reads/writes via
//     `lea r11, [rip + sym]; mov [r11], rax` (precedent: cap_row.pdx
//     lines 407, 435; row_types.pdx; audit_record.pdx).
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
// r11 is clobbered by every nested CALL. Every value that must survive
// a nested CALL lives in r12..r15 (callee-save pushed on function
// entry) or on the stack. The three nested-CALL sites in this module:
//
//   * `_cmdreg_register`: nested CALLs are `_cmdreg_init` (idempotent
//     leaf) + `_cmdreg_fnv1a64` (pure leaf). Frame: 5 callee-save
//     pushes (rbx=scope, r12=name, r13=name_len, r14=cs_body_ref,
//     r15=functor_ref) + `sub rsp, 24` (3 scratch slots: name_hash,
//     slot_idx, probe_count) -> rsp%16==0 steady (entry %16==8,
//     +40 pushes = %16==0, +24 scratch = %16==8 -- the odd count
//     requires an extra 8 B pad to realign). Corrected frame:
//     5 pushes + `sub rsp, 32` (4 slots: name_hash, slot_idx,
//     probe_count, pad) -> %16==0 at the nested CALLs.
//
//   * `_cmdreg_lookup`: nested CALLs are `_cmdreg_init` + `_cmdreg_fnv1a64`.
//     Frame: 4 callee-save pushes (rbx=name, r12=name_len,
//     r13=out_entry_ptr, r14=best_match_user_or_system) +
//     `sub rsp, 32` (4 scratch slots: name_hash, slot_idx,
//     probe_count, best_entry_ptr) -> entry %16==8, +32 pushes =
//     %16==8, +32 scratch = %16==8 (odd), so bump to `sub rsp, 40`
//     for alignment. Simplification: 5 pushes (add r15) + `sub rsp, 24`.
//
//   * `_cmdreg_dump`: nested CALL is `_cmdreg_init`. Frame: 4 callee-
//     save pushes (rbx=out, r12=out_cap, r13=slot_idx, r14=n_written) +
//     `sub rsp, 8` pad -> entry %16==8, +32 pushes = %16==8, +8 pad =
//     %16==0 at the nested CALL.
//
// =============================================================================
// LAZY-INIT DISCIPLINE (WAVE 120 LESSON, REAFFIRMED WAVE 121)
// =============================================================================
//
// Every public API that READS the registry table calls `_cmdreg_init`
// at its first instruction after the SysV prologue. `_cmdreg_init`'s
// non-zero sentinel short-circuit keeps the hot path at one branch.
// This replicates the R224.M3 EffectRow / R224.M4 CapRow pattern.
//
// =============================================================================
// Upstream: paideia-os#2486 (R222 umbrella), paideia-os#2662 (THIS
// ticket, R222.M5). Substrate: paideia-os#2658 (R222.M1 SchemasSig),
// paideia-os#2659 (R222.M2 CommandSig), paideia-os#2660 (R222.M3
// FunctorInstance), paideia-os#2661 (R222.M4 ArgFlagSpec). Design doc:
// design/shell/command-registry-client.md. Related: design/terminal/
// command-registry.md (the on-disk source of truth, CRG-D1..D4);
// design/shell/commands-toml-grammar.md (R123.M2 kernel-side TOML
// parser, landed Wave N-k).

module CmdRegistry = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES
  // ==========================================================================

  pub let CMDREG_OK                 : u64 = 0
  pub let CMDREG_ERR_NOT_FOUND      : u64 = 0x4501
  pub let CMDREG_ERR_BAD_SCOPE      : u64 = 0x4502
  pub let CMDREG_ERR_BAD_NAME       : u64 = 0x4503
  pub let CMDREG_ERR_TABLE_FULL     : u64 = 0x4504
  pub let CMDREG_ERR_OUT_TOO_SMALL  : u64 = 0x4505

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let CMDREG_SLOTS              : u64 = 128
  pub let CMDREG_ENTRY_BYTES        : u64 = 48
  pub let CMDREG_NAME_MAX           : u64 = 16
  pub let CMDREG_SLOT_MASK          : u64 = 127   // CMDREG_SLOTS - 1

  // Scope codes.
  pub let CMDREG_SCOPE_SYSTEM       : u64 = 0
  pub let CMDREG_SCOPE_USER         : u64 = 1

  // Entry field offsets.
  pub let CMDREG_OFF_NAME_HASH      : u64 = 0     // u64
  pub let CMDREG_OFF_CS_BODY_REF    : u64 = 8     // u64
  pub let CMDREG_OFF_FUNCTOR_REF    : u64 = 16    // u64
  pub let CMDREG_OFF_SCOPE          : u64 = 24    // u8
  pub let CMDREG_OFF_FLAGS          : u64 = 25    // u8
  pub let CMDREG_OFF_NAME_LEN       : u64 = 26    // u8
  pub let CMDREG_OFF_RESERVED_B     : u64 = 27    // u8
  pub let CMDREG_OFF_NAME_INLINE    : u64 = 28    // u8[16]
  pub let CMDREG_OFF_RESERVED_W     : u64 = 44    // u32

  // ==========================================================================
  // SECTION 3 -- STATIC STATE
  // ==========================================================================
  //
  // 128 slots x 48 bytes = 6144 bytes = 0x1800. Aligned to 8 so u64
  // field reads at offset 0 / 8 / 16 are naturally aligned.

  pub let mut _cmdreg_entries       : [u8; 6144] = uninit @align(8)
  pub let mut _cmdreg_init_state    : u64         = uninit @align(8)
  pub let mut _cmdreg_count_system  : u64         = uninit @align(8)
  pub let mut _cmdreg_count_user    : u64         = uninit @align(8)

  // ==========================================================================
  // _cmdreg_init() -> ()
  //
  //   Zero-fills _cmdreg_entries (6144 bytes, u64 steps of 8 -> 768
  //   iterations) and sets _cmdreg_count_system := 0,
  //   _cmdreg_count_user := 0. Idempotent via the sentinel
  //   _cmdreg_init_state (0 = not initialised, 1 = initialised).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cmdreg_ini_.
  // ==========================================================================
  pub let _cmdreg_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M5 (#2662): _cmdreg_init zero-fills the 6144 B entry table (128 slots x 48 B stride) and both scope cursors. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Idempotency: load _cmdreg_init_state via `lea r11,[rip+_cmdreg_init_state]; mov rax,[r11]`; if rax != 0 return. Else loop i in 0..6144 stepping by 8, writing 0 to _cmdreg_entries[i] via `lea r9,[rip+_cmdreg_entries]; mov r10,r9; add r10,rcx; mov [r10],0`. Then clear _cmdreg_count_system and _cmdreg_count_user via `lea r11,[rip+sym]; mov [r11], 0`. Finally set _cmdreg_init_state := 1. All cmp immediates (0, 1, 6144) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cmdreg_ini_.",
      block: {
        // Idempotency check.
        lea r11, [rip + _cmdreg_init_state];
        mov rax, [r11];
        cmp rax, 0;
        jne cmdreg_ini_done;

        // Zero-fill _cmdreg_entries by u64 stride (768 iterations).
        lea r9, [rip + _cmdreg_entries];
        xor rcx, rcx;                          // i = 0

      cmdreg_ini_zero_loop:
        cmp rcx, 6144;                         // CMDREG_SLOTS * CMDREG_ENTRY_BYTES
        jae cmdreg_ini_clear_counts;
        mov r10, r9;
        add r10, rcx;
        xor rax, rax;
        mov [r10], rax;
        add rcx, 8;
        jmp cmdreg_ini_zero_loop;

      cmdreg_ini_clear_counts:
        xor rax, rax;
        lea r11, [rip + _cmdreg_count_system];
        mov [r11], rax;
        lea r11, [rip + _cmdreg_count_user];
        mov [r11], rax;

        // Mark initialised.
        mov rax, 1;
        lea r11, [rip + _cmdreg_init_state];
        mov [r11], rax;

      cmdreg_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _cmdreg_fnv1a64(ptr, len) -> hash
  //
  //   rdi = ptr
  //   rsi = len
  //   rax = FNV-1a 64 hash
  //
  // Byte-for-byte mirror of R222.M2's _cmd_sig_fnv1a64 and R222.M3's
  // _fi_fnv1a64 (offset basis 0xCBF29CE484222325, prime 0x100000001B3,
  // standard FNV-1a loop body). Replicated here so this module can be
  // linked standalone -- the three parser-family FNV leaves live in
  // disjoint linker-visible symbol namespaces and a downstream consumer
  // that compares name_hash values across the three families is
  // guaranteed numerical equality because the algorithm and constants
  // are identical.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rax = hash accumulator, rcx = fnv_prime (held
  // across the loop), rdx = mul high half (clobbered each iteration),
  // r8 = ptr (saved from rdi), r9 = len (saved from rsi), r10 = i,
  // r11 = byte load scratch.
  // Labels prefixed cmdreg_fnv_.
  // ==========================================================================
  pub let _cmdreg_fnv1a64 : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M5 (#2662): FNV-1a 64 hash over [ptr, ptr+len). Pure leaf; zero pushes; no stack frame; no nested CALL. Load offset basis 0xCBF29CE484222325 (imm64) into rax; load fnv_prime 0x100000001B3 (imm64) into rcx held across the loop. For each byte: zero-extend byte load into r11 via `xor r11,r11; mov_b r11,[r8+r10]`; xor r11 into rax; xor rdx,rdx to clear the mul high half; `mul rcx` -> rdx:rax = rax * fnv_prime, keep low 64 in rax. Advance r10 by 1; loop. Terminates on r10 >= r9. Zero-length input returns the offset basis unchanged (standard FNV behaviour). Byte-for-byte identical to command_sig.pdx's _cmd_sig_fnv1a64 (R222.M2) and functor_instance.pdx's _fi_fnv1a64 (R222.M3). The one-op `mul rcx` form is distinct from the pitfall-listed 2-op `imul r,imm`. All cmp immediates are 0 (i < len) which is imm8-safe. No test (zero-check uses `cmp r10,r9` + jae). No and-imm64. No multiline let. Labels prefixed cmdreg_fnv_.",
      block: {
        mov r8, rdi;                           // r8 = ptr
        mov r9, rsi;                           // r9 = len
        mov rax, 0xCBF29CE484222325;           // h = fnv_offset_basis
        mov rcx, 0x100000001B3;                // fnv_prime
        xor r10, r10;                          // i = 0

      cmdreg_fnv_loop:
        cmp r10, r9;
        jae cmdreg_fnv_done;

        xor r11, r11;
        mov_b r11, [r8 + r10];                 // byte load
        xor rax, r11;                          // h ^= byte

        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * fnv_prime

        add r10, 1;
        jmp cmdreg_fnv_loop;

      cmdreg_fnv_done:
        ret;
      }
    }

  // ==========================================================================
  // _cmdreg_register(scope, name, name_len, cs_body_ref, functor_ref)
  //                                                   -> errno
  //
  //   rdi = scope       (u8 widened to u64; must be 0 or 1)
  //   rsi = name        (ptr to ASCII bytes)
  //   rdx = name_len    (1..CMDREG_NAME_MAX = 16)
  //   rcx = cs_body_ref (opaque u64)
  //   r8  = functor_ref (opaque u64)
  //   rax = CMDREG_OK | CMDREG_ERR_*
  //
  // Flow:
  //   1. Validate scope in {0, 1}; name_len in [1 .. CMDREG_NAME_MAX].
  //   2. Call _cmdreg_init (idempotent).
  //   3. Call _cmdreg_fnv1a64(name, name_len) -> name_hash.
  //   4. slot = name_hash mod 128 via shift-pair (shl 57; shr 57).
  //   5. Linear-probe forward (mod 128) up to 128 attempts; on empty
  //      slot (name_hash field at [entry+0] == 0), write the full
  //      48-byte entry and return OK.
  //   6. If all 128 probes see occupied slots, return TABLE_FULL.
  //
  // Frame: 5 callee-save pushes (rbx=name, r12=name_len,
  // r13=cs_body_ref, r14=functor_ref, r15=scope_byte) + `sub rsp, 24`
  // (3 scratch slots: name_hash, probe_count, pad for 16-B align) ->
  // entry %16==8, +40 pushes = %16==0, +24 scratch = %16==8;
  // simplification: use 6 callee-save pushes (add r11 as "slot_byte_addr"
  // but that fights the clobber contract) OR use 5 pushes + `sub rsp,
  // 32` (4 slots: name_hash, slot_idx, probe_count, pad) -> %16==0.
  // The 4-slot form is cleaner and leaves one slot for M6+ growth.
  //
  // Labels prefixed cmdreg_reg_.
  // ==========================================================================
  pub let _cmdreg_register : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (scope: u64) (name: u64) (name_len: u64) (cs_body_ref: u64) (functor_ref: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M5 (#2662): _cmdreg_register inserts a new entry into _cmdreg_entries. 5 callee-save pushes (rbx=name, r12=name_len, r13=cs_body_ref, r14=functor_ref, r15=scope_byte) + `sub rsp, 32` (4 scratch slots: [+0] name_hash, [+8] slot_idx, [+16] probe_count, [+24] pad) -> entry rsp%16==8, +40 pushes = %16==0, +32 scratch = %16==0 steady at every nested CALL. Flow: validate scope <= 1 (cmp r15, 1; ja CMDREG_ERR_BAD_SCOPE); validate r12 >= 1 and r12 <= 16 (cmp r12, 0; je CMDREG_ERR_BAD_NAME; cmp r12, 16; ja CMDREG_ERR_BAD_NAME); call _cmdreg_init (idempotent lazy boot). Load scratch args into rdi/rsi for _cmdreg_fnv1a64(name, name_len) call -> rax = name_hash; store at [rsp+0]. Compute slot = (name_hash << 57) >> 57 -> isolates low 7 bits (= name_hash mod 128); store at [rsp+8]. Clear probe_count at [rsp+16]. Probe loop: entry_addr = &_cmdreg_entries + slot_idx*48 (stride via shl 5 + shl 4); load u64 name_hash at [entry+0]; if 0 (empty slot), write the full 48-byte entry (name_hash u64, cs_body_ref u64, functor_ref u64, scope u8, 0 u8, name_len u8, 0 u8, name_inline 16 B zero-padded, 0 u32), bump the per-scope cursor, return CMDREG_OK. If occupied, advance slot_idx to (slot+1) mod 128 via shift-pair, bump probe_count, if probe_count >= 128 return CMDREG_ERR_TABLE_FULL. All cmp immediates (0, 1, 16, 48, 128, 0x4502, 0x4503, 0x4504) fit imm32 with bit 31 clear. The stride multiply is `shl r2, 5` + `shl r3, 4` + `add r2, r3` -- never 2-op `imul r,imm`. The mod via shift pair is `shl r, 57; shr r, 57` -- never `and r, imm64`. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cmdreg_reg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov r15, rdi;                          // scope
        mov rbx, rsi;                          // name
        mov r12, rdx;                          // name_len
        mov r13, rcx;                          // cs_body_ref
        mov r14, r8;                           // functor_ref

        // Validate scope <= 1.
        cmp r15, 1;
        ja  cmdreg_reg_bad_scope;

        // Validate name_len >= 1.
        cmp r12, 0;
        je  cmdreg_reg_bad_name;

        // Validate name_len <= 16.
        cmp r12, 16;                           // CMDREG_NAME_MAX
        ja  cmdreg_reg_bad_name;

        // Lazy init.
        call _cmdreg_init;

        // Compute name_hash = FNV-1a 64 over (name, name_len).
        mov rdi, rbx;
        mov rsi, r12;
        call _cmdreg_fnv1a64;
        mov [rsp + 0], rax;                    // scratch[name_hash]

        // slot_idx = name_hash mod 128 via shift-pair isolate-low-7.
        mov rcx, rax;
        shl rcx, 57;
        shr rcx, 57;                           // rcx = slot_idx in 0..127
        mov [rsp + 8], rcx;                    // scratch[slot_idx]

        // probe_count = 0.
        xor rax, rax;
        mov [rsp + 16], rax;

      cmdreg_reg_probe_loop:
        // probe_count >= 128 -> TABLE_FULL.
        mov rax, [rsp + 16];
        cmp rax, 128;                          // CMDREG_SLOTS
        jae cmdreg_reg_table_full;

        // entry_addr = &_cmdreg_entries + slot_idx * 48
        //            = base + (slot_idx * 32) + (slot_idx * 16).
        mov rcx, [rsp + 8];                    // slot_idx
        mov r9, rcx;
        shl rcx, 5;                            // slot_idx * 32
        shl r9, 4;                             // slot_idx * 16
        add rcx, r9;                           // slot_idx * 48
        lea r11, [rip + _cmdreg_entries];
        add rcx, r11;                          // rcx = entry_addr

        // Probe: name_hash at [entry+0] == 0 means empty slot.
        mov rax, [rcx + 0];
        cmp rax, 0;
        je  cmdreg_reg_claim_slot;

        // Occupied -- advance slot_idx = (slot_idx + 1) mod 128.
        mov rax, [rsp + 8];
        add rax, 1;
        shl rax, 57;
        shr rax, 57;
        mov [rsp + 8], rax;

        // Bump probe_count.
        mov rax, [rsp + 16];
        add rax, 1;
        mov [rsp + 16], rax;

        jmp cmdreg_reg_probe_loop;

      cmdreg_reg_claim_slot:
        // rcx = entry_addr. Write 48-byte entry.
        // [+0] name_hash u64.
        mov rax, [rsp + 0];
        mov [rcx + 0], rax;

        // [+8] cs_body_ref u64.
        mov [rcx + 8], r13;

        // [+16] functor_ref u64.
        mov [rcx + 16], r14;

        // [+24] scope u8.
        mov_b [rcx + 24], r15;

        // [+25] flags u8 = 0.
        xor rax, rax;
        mov_b [rcx + 25], rax;

        // [+26] name_len u8.
        mov_b [rcx + 26], r12;

        // [+27] reserved u8 = 0.
        xor rax, rax;
        mov_b [rcx + 27], rax;

        // [+28..+44] name_inline[16] zero-filled then overwritten.
        xor rax, rax;
        mov [rcx + 28], rax;                   // 8 bytes
        mov [rcx + 36], rax;                   // 8 bytes

        // Copy name bytes: dst = rcx+28, src = rbx, count = r12.
        xor r8, r8;                            // j = 0
      cmdreg_reg_name_copy:
        cmp r8, r12;
        jae cmdreg_reg_name_pad_done;
        xor rax, rax;
        mov_b rax, [rbx + r8];
        mov r11, rcx;
        add r11, 28;                           // CMDREG_OFF_NAME_INLINE
        add r11, r8;
        mov_b [r11 + 0], rax;
        add r8, 1;
        jmp cmdreg_reg_name_copy;

      cmdreg_reg_name_pad_done:
        // [+44] reserved u32 = 0.
        xor rax, rax;
        mov_d [rcx + 44], rax;

        // Bump the per-scope cursor.
        cmp r15, 0;
        jne cmdreg_reg_bump_user;

        lea r11, [rip + _cmdreg_count_system];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        jmp cmdreg_reg_ok;

      cmdreg_reg_bump_user:
        lea r11, [rip + _cmdreg_count_user];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

      cmdreg_reg_ok:
        xor rax, rax;                          // CMDREG_OK = 0
        jmp cmdreg_reg_epilogue;

      cmdreg_reg_bad_scope:
        mov rax, 0x4502;                       // CMDREG_ERR_BAD_SCOPE
        jmp cmdreg_reg_epilogue;

      cmdreg_reg_bad_name:
        mov rax, 0x4503;                       // CMDREG_ERR_BAD_NAME
        jmp cmdreg_reg_epilogue;

      cmdreg_reg_table_full:
        mov rax, 0x4504;                       // CMDREG_ERR_TABLE_FULL

      cmdreg_reg_epilogue:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cmdreg_lookup(name, name_len, out_entry_ptr) -> errno
  //
  //   rdi = name            (ptr to ASCII bytes)
  //   rsi = name_len        (1..CMDREG_NAME_MAX = 16)
  //   rdx = out_entry_ptr   (ptr to u64; receives entry base addr on
  //                          OK, 0 on error)
  //   rax = CMDREG_OK | CMDREG_ERR_*
  //
  // Flow:
  //   1. Validate name_len in [1 .. CMDREG_NAME_MAX].
  //   2. Call _cmdreg_init (idempotent).
  //   3. Hash name via _cmdreg_fnv1a64.
  //   4. slot = hash mod 128.
  //   5. Probe forward; keep track of the best matching entry seen
  //      so far (preferring USER over SYSTEM). Stop at the first empty
  //      slot OR after 128 probes.
  //   6. If a match was found, write its address to *out_entry_ptr
  //      and return OK; else return NOT_FOUND.
  //
  // Frame: 6 callee-save pushes (rbx=name, r12=name_len,
  // r13=out_entry_ptr, r14=best_entry_ptr_or_0, r15=target_hash_or_slot) +
  // `sub rsp, 16` (2 scratch slots: slot_idx, probe_count) -> entry
  // %16==8, +48 pushes = %16==8, +16 scratch = %16==8 (misaligned); fix
  // by `sub rsp, 24` (add 8 B pad slot) -> %16==0 at the nested CALLs.
  //
  // Labels prefixed cmdreg_lu_.
  // ==========================================================================
  pub let _cmdreg_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (name: u64) (name_len: u64) (out_entry_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M5 (#2662): _cmdreg_lookup resolves a command name to its best-match entry (prefers CMDREG_SCOPE_USER over CMDREG_SCOPE_SYSTEM when both exist on the probe chain). 6 callee-save pushes (rbx=name, r12=name_len, r13=out_entry_ptr, r14=best_entry_ptr accumulator (0 initially), r15=target_hash) + `sub rsp, 24` (3 scratch slots: [+0] slot_idx, [+8] probe_count, [+16] pad for 16-B alignment) -> entry rsp%16==8, +48 pushes = %16==8, +24 scratch = %16==0 steady at every nested CALL. Flow: validate r12 >= 1 and r12 <= 16 (BAD_NAME on fail; also writes 0 to *out_entry_ptr before return). Call _cmdreg_init. Call _cmdreg_fnv1a64(rbx, r12) -> r15 = target_hash. slot_idx = (target_hash << 57) >> 57. probe_count = 0. best_entry_ptr = 0 (r14). Probe loop (up to 128 iterations): entry_addr = &_cmdreg_entries + slot_idx*48; load entry.name_hash u64 at [entry+0]; if 0 (empty) break; if entry.name_hash != target_hash, advance slot/probe; else load entry.scope u8 at [entry+24]; if scope == USER (1), set best_entry_ptr = entry_addr and break (user wins immediately); else if scope == SYSTEM (0) and best_entry_ptr == 0, set best_entry_ptr = entry_addr and keep probing (a user shadow may be later on the chain). On loop exit: if best_entry_ptr != 0, write it to *out_entry_ptr, return CMDREG_OK; else write 0 to *out_entry_ptr, return CMDREG_ERR_NOT_FOUND. All cmp immediates (0, 1, 16, 48, 128, 0x4501, 0x4503) fit imm32 with bit 31 clear. Stride via shl 5 + shl 4 + add; mod via shift-pair shl 57; shr 57. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cmdreg_lu_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                          // name
        mov r12, rsi;                          // name_len
        mov r13, rdx;                          // out_entry_ptr
        xor r14, r14;                          // best_entry_ptr = 0

        // Validate name_len >= 1.
        cmp r12, 0;
        je  cmdreg_lu_bad_name;

        // Validate name_len <= 16.
        cmp r12, 16;                           // CMDREG_NAME_MAX
        ja  cmdreg_lu_bad_name;

        // Lazy init.
        call _cmdreg_init;

        // Compute target hash.
        mov rdi, rbx;
        mov rsi, r12;
        call _cmdreg_fnv1a64;
        mov r15, rax;                          // target_hash

        // slot_idx = target_hash mod 128.
        mov rcx, rax;
        shl rcx, 57;
        shr rcx, 57;
        mov [rsp + 0], rcx;                    // scratch[slot_idx]

        // probe_count = 0.
        xor rax, rax;
        mov [rsp + 8], rax;

      cmdreg_lu_probe_loop:
        // probe_count >= 128 -> break.
        mov rax, [rsp + 8];
        cmp rax, 128;
        jae cmdreg_lu_decide;

        // entry_addr = &_cmdreg_entries + slot_idx * 48.
        mov rcx, [rsp + 0];
        mov r9, rcx;
        shl rcx, 5;
        shl r9, 4;
        add rcx, r9;
        lea r11, [rip + _cmdreg_entries];
        add rcx, r11;                          // rcx = entry_addr

        // Load entry.name_hash.
        mov rax, [rcx + 0];
        cmp rax, 0;
        je  cmdreg_lu_decide;                  // empty slot -> stop

        // Compare name_hash.
        cmp rax, r15;
        jne cmdreg_lu_advance;

        // Hash match. Check scope.
        xor rax, rax;
        mov_b rax, [rcx + 24];                 // CMDREG_OFF_SCOPE
        cmp rax, 1;                            // CMDREG_SCOPE_USER
        je  cmdreg_lu_user_hit;

        // scope == SYSTEM: remember if not already remembered.
        cmp r14, 0;
        jne cmdreg_lu_advance;
        mov r14, rcx;                          // best = this system entry
        jmp cmdreg_lu_advance;

      cmdreg_lu_user_hit:
        mov r14, rcx;                          // user wins outright
        jmp cmdreg_lu_decide;

      cmdreg_lu_advance:
        // slot_idx = (slot_idx + 1) mod 128.
        mov rax, [rsp + 0];
        add rax, 1;
        shl rax, 57;
        shr rax, 57;
        mov [rsp + 0], rax;

        // Bump probe_count.
        mov rax, [rsp + 8];
        add rax, 1;
        mov [rsp + 8], rax;

        jmp cmdreg_lu_probe_loop;

      cmdreg_lu_decide:
        cmp r14, 0;
        je  cmdreg_lu_not_found;

        // Write best to *out_entry_ptr; return OK.
        mov [r13], r14;
        xor rax, rax;                          // CMDREG_OK
        jmp cmdreg_lu_epilogue;

      cmdreg_lu_not_found:
        xor rax, rax;
        mov [r13], rax;                        // *out = 0
        mov rax, 0x4501;                       // CMDREG_ERR_NOT_FOUND
        jmp cmdreg_lu_epilogue;

      cmdreg_lu_bad_name:
        xor rax, rax;
        cmp r13, 0;
        je  cmdreg_lu_bad_name_ret;
        mov [r13], rax;                        // *out = 0 (defensive)
      cmdreg_lu_bad_name_ret:
        mov rax, 0x4503;                       // CMDREG_ERR_BAD_NAME

      cmdreg_lu_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cmdreg_dump(out, out_cap) -> packed_u64
  //
  //   rdi = out       (ptr to caller buffer; filled on OK)
  //   rsi = out_cap   (byte capacity of the caller buffer)
  //   rax = (bytes_written << 32) | status
  //
  // Walks slots 0..CMDREG_SLOTS, copying each occupied entry's 48-byte
  // record contiguously into the caller buffer. "Occupied" = name_hash
  // at [entry+0] != 0. Returns bytes_written only when status ==
  // CMDREG_OK; on OUT_TOO_SMALL the top 32 bits are undefined and the
  // caller must ignore them.
  //
  // Frame: 5 callee-save pushes (rbx=out, r12=out_cap, r13=slot_idx,
  // r14=n_written_bytes, r15=n_occupied) + `sub rsp, 8` for alignment
  // -> entry %16==8, +40 pushes = %16==0, +8 pad = %16==8 (misaligned);
  // fix by using 4 pushes + `sub rsp, 16`:
  // entry %16==8, +32 pushes = %16==8, +16 pad = %16==8 (also bad).
  // Correct: 5 pushes + `sub rsp, 24` (2 scratch slots + pad) ->
  // entry %16==8, +40 pushes = %16==0, +24 scratch = %16==8;
  // simpler: 4 pushes + `sub rsp, 8` pad -> %16==0.
  //
  // Chosen frame: 4 callee-save pushes (rbx=out, r12=out_cap,
  // r13=n_written, r14=slot_idx) + `sub rsp, 8` pad = 40 B frame; entry
  // %16==8, +32 pushes = %16==8, +8 pad = %16==0 at the nested CALL to
  // _cmdreg_init.
  //
  // Labels prefixed cmdreg_dump_.
  // ==========================================================================
  pub let _cmdreg_dump : (u64, u64) -> u64 !{mem} @{} =
    fn (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M5 (#2662): _cmdreg_dump copies all occupied entries into the caller buffer in slot order. 4 callee-save pushes (rbx=out, r12=out_cap, r13=n_written, r14=slot_idx) + `sub rsp, 8` pad = 40 B frame; entry rsp%16==8, +32 pushes = %16==8, +8 pad = %16==0 steady at the single nested CALL to _cmdreg_init. Flow: lazy init; walk slot_idx 0..128; for each entry_addr = &_cmdreg_entries + slot_idx*48 (stride via shl 5 + shl 4 + add), load name_hash u64 at [entry+0]; if 0, skip; else capacity check: (n_written + 48) <= out_cap (OUT_TOO_SMALL on fail); byte-copy 48 bytes from entry to out+n_written via 6 u64 moves (0/8/16/24/32/40); bump n_written by 48. On loop exit: pack return as (n_written << 32) | CMDREG_OK. All cmp immediates (0, 48, 128, 0x4505) fit imm32 with bit 31 clear. Stride via shl 5 + shl 4; no mod needed because the walk is sequential. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cmdreg_dump_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                          // out
        mov r12, rsi;                          // out_cap
        xor r13, r13;                          // n_written = 0
        xor r14, r14;                          // slot_idx = 0

        // Lazy init.
        call _cmdreg_init;

      cmdreg_dump_walk:
        cmp r14, 128;                          // CMDREG_SLOTS
        jae cmdreg_dump_done;

        // entry_addr = &_cmdreg_entries + slot_idx * 48.
        mov rcx, r14;
        mov r9, r14;
        shl rcx, 5;
        shl r9, 4;
        add rcx, r9;
        lea r11, [rip + _cmdreg_entries];
        add rcx, r11;                          // rcx = entry_addr

        // Load name_hash.
        mov rax, [rcx + 0];
        cmp rax, 0;
        je  cmdreg_dump_skip;

        // Capacity: n_written + 48 <= out_cap.
        mov r8, r13;
        add r8, 48;                            // CMDREG_ENTRY_BYTES
        cmp r8, r12;
        ja  cmdreg_dump_oos;

        // Copy 48 bytes = 6 x u64 from entry to out + n_written.
        mov r10, rbx;
        add r10, r13;                          // dst = out + n_written

        mov rax, [rcx + 0];
        mov [r10 + 0], rax;
        mov rax, [rcx + 8];
        mov [r10 + 8], rax;
        mov rax, [rcx + 16];
        mov [r10 + 16], rax;
        mov rax, [rcx + 24];
        mov [r10 + 24], rax;
        mov rax, [rcx + 32];
        mov [r10 + 32], rax;
        mov rax, [rcx + 40];
        mov [r10 + 40], rax;

        add r13, 48;                           // n_written += 48

      cmdreg_dump_skip:
        add r14, 1;                            // slot_idx++
        jmp cmdreg_dump_walk;

      cmdreg_dump_done:
        // Return (n_written << 32) | CMDREG_OK.
        mov rax, r13;
        shl rax, 32;
        jmp cmdreg_dump_epilogue;

      cmdreg_dump_oos:
        mov rax, 0x4505;                       // CMDREG_ERR_OUT_TOO_SMALL

      cmdreg_dump_epilogue:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
