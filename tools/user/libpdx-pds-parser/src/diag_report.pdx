// src/diag_report.pdx -- libpdx-pds-parser.R225.M7 (paideia-os#2688)
//
// DiagReport: typed-error diagnostic reporting with source spans +
// suggestions. R225.M7 of the HM-type-checker umbrella
// (paideia-os#2489); builds a 128-byte canonical Diag record from
// the R225.M1 HmCore / R225.M2 RowTypes / R225.M4 EffectUnify
// error paths and renders it in two surface forms: LSP-compatible
// JSON (for the P8 LSP-embed consumer) and compact human text
// (for the REPL diagnostic lane).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Every type error that leaves the elaborator carries:
//   * a primary span (byte-offset + byte-length into the SOURCE
//     buffer -- NOT the NFC-normalised buffer; the Q-A5 invariant);
//   * an optional secondary span (future wire-up: the "related
//     information" span pointing at e.g. the colliding earlier
//     binding; defaults to (0, 0) at raw M7);
//   * expected-vs-actual type names (32 bytes each; inline so the
//     Diag record is self-contained and can cross a process
//     boundary without pointer rewrites);
//   * a suggestion string when the elaborator can derive one (e.g.
//     "parse(x)" for a str/u64 coercion; "wrap in `Some`" for an
//     Option mismatch); 32 bytes inline, empty when none.
//
// The record is 128 bytes exactly so a report queue stores N diags
// at `[base + i << 7]` -- `shl r, 7` addressing, no `imul`.
//
// R225.M7 ships THREE emit entries:
//   * `_dr_build` populates the record from arg bundle (code +
//     severity + primary span + three string pointers + out/out_cap).
//   * `_dr_render_lsp` serializes the record to LSP-compatible
//     JSON (one line, no trailing newline; the LSP transport
//     wraps multiple diagnostics in a `publishDiagnostics` array).
//   * `_dr_render_human` serializes the record to a compact text
//     line for the REPL (`E<code>[<sev>] at <off>+<len>:
//     expected <exp>, got <act> (hint: <sug>)`).
//
// All three emit entries are self-contained byte walkers over
// caller-supplied buffers; no `.bss` at raw M7 (M7.1 adds a
// per-session diagnostic-queue head slot for the `_dr_push_queue`
// helper).
//
// Out of scope at raw M7 (deferred to M7.1+ follow-ups):
//   * `_dr_set_secondary(record, off, len)` -- patch the secondary
//     span after `_dr_build`. Needed when the elaborator
//     synthesises a "see-also" cross-reference.
//   * `_dr_push_queue(record)` -- enqueue onto a session-local
//     diagnostic queue consumed by the REPL post-pass.
//   * `_dr_byte_offset_to_line_column(src_ptr, src_len, byte_off)
//     -> packed(line_u32, col_u32)` -- the LSP range emission at
//     raw M7 uses `line=0, character=byte_offset` because the span
//     resolver needs the source buffer and a UTF-8-aware line-break
//     scan. M7.1 wires this up; downstream LSP clients accept the
//     byte-offset fallback.
//   * Decimal digit count > 10 (u32 ceiling). M7's `_dr_h_emit_u32_dec`
//     covers the full u32 range (0..4_294_967_295 == 10 digits
//     max).
//
// Status band 0x5B00..0x5BFF carved on the next kilo-step boundary
// past Wave 129's R229.M8 MultiLine (0x5A00..0x5AFF). Grep-confirmed
// virgin outside this module + caps.decl + the design doc.
//
// =============================================================================
// Diag RECORD WIRE FORMAT -- 128 BYTES EXACTLY
// =============================================================================
//
//   [+0x00]   u32    magic              = 'DIAG' (0x47414944 LE)
//   [+0x04]   u16    code               (E-number; e.g. 0x5810 =
//                                        E0980_RANK_TOO_HIGH)
//   [+0x06]   u16    severity           0 ERROR, 1 WARNING, 2 INFO,
//                                        3 HINT (LSP severity = +1)
//   [+0x08]   u32    primary_src_offset (into caller's SOURCE buffer,
//                                        not NFC-form; Q-A5)
//   [+0x0C]   u32    primary_src_length
//   [+0x10]   u32    secondary_src_offset (0 at raw M7)
//   [+0x14]   u32    secondary_src_length (0 at raw M7)
//   [+0x18]   u8[32] expected_type_name   (NUL-padded; stop-at-NUL
//                                          on render; empty => omit
//                                          from message string)
//   [+0x38]   u8[32] actual_type_name     (same shape)
//   [+0x58]   u8[32] suggestion_inline    (same shape)
//   [+0x78]   u64    next_diag_ref        (0 at raw M7; M7.1 queue
//                                          link field; the queue
//                                          implementation picks
//                                          between pool-idx and
//                                          byte-offset encodings)
//
// Total: 128 bytes == 0x80 == 2^7. Record addressing is `shl r, 7;
// add r, base` (power-of-two stride; no `imul` pitfall).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _dr_init() -> ()
//     Bare `ret`. M7 holds NO `.bss` state (every Diag record is
//     caller-owned; the queue head slot lands at M7.1). Kept for
//     parallelism with the parser-family init-hook convention.
//
//   _dr_build(code_sev, primary_off, primary_len,
//             strings_ptr, out, out_cap) -> packed_u64
//     Populate a 128-byte Diag record at `out`.
//       rdi = code_sev  = code (low 16) | (severity (16) << 16);
//                         e.g. (0 << 16) | 0x5810 for an ERROR
//                         with code 0x5810.
//       rsi = primary_off (u32)
//       rdx = primary_len (u32)
//       rcx = strings_ptr -- NULLable; else points to a 96-byte
//                            buffer with expected[32] + actual[32]
//                            + suggestion[32]. NUL-pad convention:
//                            the first NUL byte terminates the
//                            inline string; the remainder of each
//                            32-byte slot is unused on render.
//       r8  = out        -- destination record buffer (128 bytes).
//       r9  = out_cap    -- caller's buffer capacity.
//       rax = packed_u64 -- (DR_RECORD_BYTES << 32) | status.
//
//     Status codes: DR_OK (0), DR_ERR_BAD_INPUT (0x5B00; out==0),
//     DR_ERR_OUT_TOO_SMALL (0x5B01; out_cap < 128),
//     DR_ERR_BAD_SEVERITY (0x5B03; severity > 3).
//
//     Rationale for the packed `code_sev` first arg + the 96-byte
//     `strings_ptr` second-triple: paideia-as's SysV x64 unsafe-body
//     lambda caps register-passed args at 6 (per `sysv_x64_7arg_
//     unsafe_body_b1708.pdx` + design/compiler/lambda-arity-stack-
//     spill.md §4.4/§11: an unsafe body suppresses the frame-pointer
//     prologue that stack-passed args would be read back through at
//     `[rbp + N]`, so an unsafe-bodied lambda with > 6 args is
//     refused with B1708). The literal brief signature
//     (`code, severity, primary_off, primary_len, expected_ptr,
//     actual_ptr, suggestion_ptr, out, out_cap`) is 9 args; packing
//     code+severity into one u64 and bundling the three strings
//     into one `strings_ptr` reduces the arg count to 6 without
//     losing any field. The strings buffer is a flat triple (32 B
//     each at offsets 0 / 32 / 64) so the caller fills it with
//     three memcpy's from the elaborator's intern tables.
//
//   _dr_render_lsp(record_ptr, record_len, out, out_cap) -> packed_u64
//     Serialize the record to LSP-compatible one-line JSON of the
//     shape
//       {"range":{"start":{"line":0,"character":<n>},"end":{"line":
//        0,"character":<n>}},"severity":<n>,"code":"E<hex4>",
//        "message":"expected <exp>, got <act>; hint: <sug>"}
//     Fields with empty inline strings (first byte == NUL) are
//     omitted from the message (e.g. no "; hint:" when
//     suggestion_inline is empty).
//
//     LSP severity mapping: our severity 0..3 -> LSP 1..4
//     (Error=1, Warning=2, Info=3, Hint=4).
//
//     LSP range at raw M7 uses `line=0, character=byte_offset` as a
//     byte-level fallback; M7.1 wires the UTF-8-aware line/column
//     resolver (`_dr_byte_offset_to_line_column`) and refines both
//     the start and end positions.
//
//     The `code` field is JSON-string-encoded (`"E<hex4>"`) rather
//     than integer-encoded; LSP's `code` field accepts
//     `integer | string` per LSP 3.17 §Diagnostic. The hex form
//     groups directly with the band carved in `caps.decl`.
//
//     Returns packed_u64 = (bytes_written << 32) | status.
//
//   _dr_render_human(record_ptr, record_len, out, out_cap)
//                                                    -> packed_u64
//     Serialize the record to a compact single-line human form:
//       E<hex4> <SEV> at <dec_off>+<dec_len>: expected <exp>,
//                                              got <act> (hint: <sug>)
//     SEV is one of ERR / WARN / INFO / HINT. Empty inline strings
//     collapse the surrounding `expected <>, got <>` or `(hint: <>)`
//     clause.
//
//     Returns packed_u64 = (bytes_written << 32) | status.
//
// =============================================================================
// INTERNAL HELPERS (module-private pure leaves)
// =============================================================================
//
// The two render entries are long linear byte-emitters; they call
// into three module-private pure-leaf helpers for the repeating
// shapes:
//
//   _dr_h_emit_lit(src_ptr, src_len, out, out_cap, pos) -> new_pos
//     Byte-copy `src_len` literal bytes from `src_ptr` to
//     `out + pos`. Validates `pos + src_len <= out_cap`; returns
//     `out_cap + 1` as the overflow sentinel on failure. Caller
//     checks `new_pos > out_cap` once at the end rather than per-
//     emit (the sentinel is sticky across subsequent emits because
//     the overflow check inside each helper rejects any pos >
//     out_cap).
//
//   _dr_h_emit_cstr(src_ptr, max_bytes, out, out_cap, pos) -> new_pos
//     Byte-copy from `src_ptr` up to `max_bytes` or the first NUL
//     byte, whichever comes first. Same overflow sentinel.
//
//   _dr_h_emit_u16_hex(value, out, out_cap, pos) -> new_pos
//     Emit 4 hex nibbles (uppercase 0-9A-F) for `value` low 16
//     bits. Fixed 4-byte emit.
//
//   _dr_h_emit_u32_dec(value, out, out_cap, pos) -> new_pos
//     Emit variable 1..10 decimal digits for `value` low 32 bits
//     via greedy-subtraction over the powers-of-10 table.
//     `value == 0` emits a single '0'.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- band values 0x5B00..0x5BFF fit imm32.
//   - No 2-op `imul r, imm` -- 128-byte record stride is `shl r, 7`;
//     32-byte string stride is `shl r, 5`; 4-byte u32 stride is
//     `shl r, 2`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `DiagReport` matches `diag_report.pdx`.
//   - Labels prefixed `dr_` and `dr_h_` for the module-private
//     helpers (grep-confirmed unique against every landed parser-
//     tier prefix: u8n_, gi_, wp_, cl_, ast_, sm_, fh_, sch_sig_,
//     cmd_sig_, fi_, afs_, cmdreg_, dm_, ds_, pl_, rp_, fo_, sgr_,
//     ws_, ha_, st_, ll_, cc_, er_, cr_, ls_, pl_lam_, lp_, hm_,
//     rt_, eu_, dl_, se_, te_, jc_, h_, le_, vi_, ml_, ir_, rc_).
//     Never bare `loop`/`if`/`let`/`fn`/`ret`/`done`.
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 10, 16, 32, 64,
//     96, 128, status codes 0x5B00..0x5B04, hex4 '0'=0x30, 'A'=0x41,
//     'E'=0x45, powers of 10 up to 10^9=0x3B9ACA00) fit imm32 with
//     bit 31 clear so direct `cmp reg, imm32` is sign-extension-
//     safe.
//   - Byte loads via `xor r,r; mov_b r,[base + idx * 1]` on reg+reg
//     or `xor r,r; mov_b r,[base + imm_disp]` on reg+disp. u32
//     loads via `xor r,r; mov_d r,[base + imm_disp]` (zero-extends
//     per SDM Vol.1 3.4.1.1). u32 stores via `mov_d`. u16 stores
//     via two `mov_b` (low byte then high byte at adjacent disps).
//     u8 stores via `mov_b`.
//   - No chained-displacement operands (precedent: span_map.pdx,
//     rank_check.pdx). Three-term address computations are pre-
//     computed into a register via `mov; shl; add` sequences.
//   - Cross-module .bss not written (zero `.bss` at raw M7).
//   - Register-liveness: `_dr_init` is bare `ret`. `_dr_build` has
//     ONE nested CALL (into `_dr_h_emit_cstr` for the strings-ptr
//     copy branch; if we inline that too, zero nested CALLs).
//     Actually at raw M7 we INLINE the 96-byte string copy in
//     `_dr_build` as 96 bare mov_b stores -- no nested CALL, so
//     `_dr_build` is a PURE LEAF (zero callee-save pushes, no
//     stack frame). The two render entries have multiple nested
//     CALLs (into the four `_dr_h_emit_*` helpers) + a 6-push
//     callee-save prologue (6 x 8 = 48B; entry rsp%16==8; after
//     pushes rsp%16==0 at every nested CALL by SysV).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M7.1  `.bss` session-local diagnostic queue head +
//              `_dr_push_queue(record)` enqueuer + `_dr_drain_queue(
//              out, out_cap, max_count)` drainer.
//   R225.M7.2  `_dr_byte_offset_to_line_column(src_ptr, src_len,
//              byte_off) -> packed(line, col)` for LSP range
//              refinement + `_dr_render_lsp` wire-up.
//   R225.M7.3  `_dr_set_secondary(record, off, len)` patcher.
//   R225.M7.4  `_dr_make_suggestion(code, expected_ptr, actual_ptr,
//              out, out_cap)` -- derive a suggestion string from
//              the (code, types) pair when the HM elaborator cannot
//              provide one directly.
//   R225.M7.5  60-error acceptance corpus + golden LSP + human
//              output per `design/shell/diagnostic-reporting.md` §8.
//   R225.M7.6  Kernel-side wire-up at the REPL dispatch tier
//              (reads `_dr_render_human` for the terminal lane and
//              `_dr_render_lsp` for the LSP transport lane).
//
// =============================================================================
// Upstream: paideia-os#2688 (THIS ticket, R225.M7). Design doc:
// design/shell/diagnostic-reporting.md. Related plans:
// design/terminal/semantic-shell-language-plan.md section R225.M7,
// design/shell/hm-algorithm-w-core.md (R225.M1 HmCore error codes),
// design/shell/rank-restricted-polymorphism.md (R225.M6 E0980 /
// E0981 diagnostic family), design/shell/span-map-nfc.md (R221.M6
// Q-A5 source-span invariant).

module DiagReport = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 of packed_u64)
  // ==========================================================================
  //
  // Band 0x5B00..0x5BFF carved on a kilo-step boundary past
  // Wave 129's R229.M8 MultiLine (0x5A00..0x5AFF). Grep-confirmed
  // virgin at R225.M7 landing time.

  pub let DR_OK                     : u64 = 0
  pub let DR_ERR_BAD_INPUT          : u64 = 0x5B00
  pub let DR_ERR_OUT_TOO_SMALL      : u64 = 0x5B01
  pub let DR_ERR_BAD_RECORD         : u64 = 0x5B02
  pub let DR_ERR_BAD_SEVERITY       : u64 = 0x5B03
  pub let DR_ERR_RENDER_OVERFLOW    : u64 = 0x5B04

  // ==========================================================================
  // SECTION 2 -- SEVERITY + MAGIC + LAYOUT CONSTANTS
  // ==========================================================================

  // Our severity axis (0..3).
  pub let DR_SEV_ERROR              : u64 = 0
  pub let DR_SEV_WARNING            : u64 = 1
  pub let DR_SEV_INFO               : u64 = 2
  pub let DR_SEV_HINT               : u64 = 3
  pub let DR_SEV_MAX                : u64 = 3

  // 'DIAG' little-endian: D(0x44) I(0x49) A(0x41) G(0x47) ->
  // u32 LE = 0x47414944.
  pub let DR_MAGIC                  : u64 = 0x47414944

  // Record layout.
  pub let DR_RECORD_BYTES           : u64 = 128
  pub let DR_NAME_BYTES             : u64 = 32
  pub let DR_STRINGS_BYTES          : u64 = 96

  pub let DR_OFF_MAGIC              : u64 = 0
  pub let DR_OFF_CODE               : u64 = 4
  pub let DR_OFF_SEVERITY           : u64 = 6
  pub let DR_OFF_PRIMARY_OFF        : u64 = 8
  pub let DR_OFF_PRIMARY_LEN        : u64 = 12
  pub let DR_OFF_SECONDARY_OFF      : u64 = 16
  pub let DR_OFF_SECONDARY_LEN      : u64 = 20
  pub let DR_OFF_EXPECTED           : u64 = 24
  pub let DR_OFF_ACTUAL             : u64 = 56
  pub let DR_OFF_SUGGESTION         : u64 = 88
  pub let DR_OFF_NEXT               : u64 = 120

  // Render output caps (callers may pass larger).
  pub let DR_LSP_MIN_CAP            : u64 = 512
  pub let DR_HUMAN_MIN_CAP          : u64 = 256

  // ==========================================================================
  // SECTION 3 -- STATIC TABLES (.rodata)
  // ==========================================================================
  //
  // Powers of 10 (u32) for the decimal emitter's greedy subtraction.
  // 10 entries from 10^9 down to 10^0. All fit imm32 with bit 31
  // clear so direct `cmp reg, imm32` would be sign-safe (we load the
  // table at runtime via rip-relative LEA + mov_d regardless).

  pub let DR_POW10_COUNT            : u64 = 10

  pub let _dr_pow10 : [u32; 10] = [
    0x3B9ACA00,                              // 1_000_000_000
    0x05F5E100,                              // 100_000_000
    0x00989680,                              // 10_000_000
    0x000F4240,                              // 1_000_000
    0x000186A0,                              // 100_000
    0x00002710,                              // 10_000
    0x000003E8,                              // 1_000
    0x00000064,                              // 100
    0x0000000A,                              // 10
    0x00000001                               // 1
  ] @align(8)

  // Hex nibble lookup: '0'..'9', 'A'..'F' = 16 bytes.
  pub let _dr_hex_digits : [u8; 16] = [
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
    0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46
  ] @align(8)

  // Severity-name LUT: 4 x 4-byte slots ("ERR\0", "WARN", "INFO",
  // "HINT"). The emitter copies 3-4 bytes per slot stopping at the
  // first NUL. Fixed layout so a downstream golden test can
  // address `_dr_sev_names + sev * 4`.
  pub let _dr_sev_names : [u8; 16] = [
    0x45, 0x52, 0x52, 0x00,                  // "ERR\0"
    0x57, 0x41, 0x52, 0x4E,                  // "WARN"
    0x49, 0x4E, 0x46, 0x4F,                  // "INFO"
    0x48, 0x49, 0x4E, 0x54                   // "HINT"
  ] @align(8)

  // Literal templates (fixed byte strings used by the renderers).
  // Each has a sibling `_LEN` constant to keep the emitter's arg
  // triple (ptr, len, dst/cap/pos) deterministic.

  pub let _dr_lit_lsp_prefix : [u8; 40] = [
    0x7B, 0x22, 0x72, 0x61, 0x6E, 0x67, 0x65, 0x22,     // {"range"
    0x3A, 0x7B, 0x22, 0x73, 0x74, 0x61, 0x72, 0x74,     // :{"start
    0x22, 0x3A, 0x7B, 0x22, 0x6C, 0x69, 0x6E, 0x65,     // ":{"line
    0x22, 0x3A, 0x30, 0x2C, 0x22, 0x63, 0x68, 0x61,     // ":0,"cha
    0x72, 0x61, 0x63, 0x74, 0x65, 0x72, 0x22, 0x3A      // racter":
  ] @align(8)
  pub let DR_LIT_LSP_PREFIX_LEN     : u64 = 40

  pub let _dr_lit_lsp_mid1 : [u8; 24] = [
    0x7D, 0x2C, 0x22, 0x65, 0x6E, 0x64, 0x22, 0x3A,     // },"end":
    0x7B, 0x22, 0x6C, 0x69, 0x6E, 0x65, 0x22, 0x3A,     // {"line":
    0x30, 0x2C, 0x22, 0x63, 0x68, 0x61, 0x72, 0x61      // 0,"chara
  ] @align(8)
  pub let DR_LIT_LSP_MID1_LEN       : u64 = 24

  pub let _dr_lit_lsp_mid1_tail : [u8; 11] = [
    0x63, 0x74, 0x65, 0x72, 0x22, 0x3A,                 // cter":
    0x00, 0x00, 0x00, 0x00, 0x00                        // pad (unused)
  ] @align(8)
  pub let DR_LIT_LSP_MID1_TAIL_LEN  : u64 = 6

  pub let _dr_lit_lsp_mid2 : [u8; 24] = [
    0x7D, 0x7D, 0x2C, 0x22, 0x73, 0x65, 0x76, 0x65,     // }},"seve
    0x72, 0x69, 0x74, 0x79, 0x22, 0x3A,                 // rity":
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  // pad
  ] @align(8)
  pub let DR_LIT_LSP_MID2_LEN       : u64 = 14

  pub let _dr_lit_lsp_mid3 : [u8; 16] = [
    0x2C, 0x22, 0x63, 0x6F, 0x64, 0x65, 0x22, 0x3A,     // ,"code":
    0x22, 0x45,                                         // "E
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00                  // pad
  ] @align(8)
  pub let DR_LIT_LSP_MID3_LEN       : u64 = 10

  pub let _dr_lit_lsp_mid4 : [u8; 24] = [
    0x22, 0x2C, 0x22, 0x6D, 0x65, 0x73, 0x73, 0x61,     // ","messa
    0x67, 0x65, 0x22, 0x3A, 0x22, 0x65, 0x78, 0x70,     // ge":"exp
    0x65, 0x63, 0x74, 0x65, 0x64, 0x20,                 // ected
    0x00, 0x00                                          // pad
  ] @align(8)
  pub let DR_LIT_LSP_MID4_LEN       : u64 = 22

  pub let _dr_lit_got_sep : [u8; 8] = [
    0x2C, 0x20, 0x67, 0x6F, 0x74, 0x20,                 // , got
    0x00, 0x00                                          // pad
  ] @align(8)
  pub let DR_LIT_GOT_SEP_LEN        : u64 = 6

  pub let _dr_lit_hint_sep : [u8; 16] = [
    0x3B, 0x20, 0x68, 0x69, 0x6E, 0x74, 0x3A, 0x20,     // ; hint:
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00      // pad
  ] @align(8)
  pub let DR_LIT_HINT_SEP_LEN       : u64 = 8

  pub let _dr_lit_lsp_suffix : [u8; 8] = [
    0x22, 0x7D,                                         // "}
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00                  // pad
  ] @align(8)
  pub let DR_LIT_LSP_SUFFIX_LEN     : u64 = 2

  // Human-form literals.

  pub let _dr_lit_human_e : [u8; 8] = [
    0x45,                                               // "E"
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_HUMAN_E_LEN        : u64 = 1

  pub let _dr_lit_sp : [u8; 8] = [
    0x20,                                               // " "
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_SP_LEN             : u64 = 1

  pub let _dr_lit_at : [u8; 8] = [
    0x20, 0x61, 0x74, 0x20,                             // " at "
    0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_AT_LEN             : u64 = 4

  pub let _dr_lit_plus : [u8; 8] = [
    0x2B,                                               // "+"
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_PLUS_LEN           : u64 = 1

  pub let _dr_lit_colon_sp_exp : [u8; 16] = [
    0x3A, 0x20, 0x65, 0x78, 0x70, 0x65, 0x63, 0x74,     // ": expect"
    0x65, 0x64, 0x20,                                   // "ed "
    0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_COLON_SP_EXP_LEN   : u64 = 11

  pub let _dr_lit_open_hint : [u8; 16] = [
    0x20, 0x28, 0x68, 0x69, 0x6E, 0x74, 0x3A, 0x20,     // " (hint: "
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_OPEN_HINT_LEN      : u64 = 8

  pub let _dr_lit_close_paren : [u8; 8] = [
    0x29,                                               // ")"
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ] @align(8)
  pub let DR_LIT_CLOSE_PAREN_LEN    : u64 = 1

  // ==========================================================================
  // _dr_init() -> ()
  //
  //   Bare `ret`. Raw M7 holds NO `.bss` state (every Diag record is
  //   caller-owned). Kept for parallelism with the parser-family
  //   init-hook convention; an M7.1 landing adds a `.bss`
  //   session-local diagnostic-queue head slot and this init will
  //   zero-fill it on first call.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_ini_.
  // ==========================================================================
  pub let _dr_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_init is a bare ret. Raw M7 holds NO .bss state (every Diag record is caller-owned; the session-local diagnostic-queue head slot lands at M7.1). Zero callee-save pushes; no stack frame; no nested CALL. Kept for parallelism with the parser-family init-hook convention (_rc_init R225.M6, _st_init R223.M7, _lp_init R224.M7, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _dr_h_emit_lit(src, src_len, out, out_cap, pos) -> new_pos
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rdx = out
  //   rcx = out_cap
  //   r8  = pos (current cursor)
  //   rax = new_pos (or out_cap + 1 as the overflow sentinel)
  //
  //   Byte-copy src_len bytes to out + pos. Validates pos +
  //   src_len <= out_cap; on overflow returns out_cap + 1 as the
  //   sticky-sentinel the caller tests once at the end.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_h_el_.
  // ==========================================================================
  pub let _dr_h_emit_lit : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (src_len: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_h_emit_lit byte-copies src_len bytes to out+pos. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) overflow probe mov rax,r8; add rax,rsi; cmp rax,rcx; ja overflow (return rcx+1 sentinel). (2) copy loop: xor r9,r9; while r9 < src_len load src byte via xor r10,r10; mov_b r10,[rdi+r9]; store via mov_b [rdx+r11],r10 where r11 = r8+r9; advance r9. (3) return rax = r8 + src_len. All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_h_el_.",
      block: {
        // Overflow probe: pos + src_len > out_cap ?
        mov rax, r8;
        add rax, rsi;
        cmp rax, rcx;
        ja  dr_h_el_overflow;

        // r9 = i = 0.
        xor r9, r9;

      dr_h_el_loop:
        cmp r9, rsi;
        jae dr_h_el_done;

        // Load src byte.
        xor r10, r10;
        mov_b r10, [rdi + r9];

        // Store at out + (pos + i). Pre-compute dst addr into r11.
        mov r11, r8;
        add r11, r9;
        mov_b [rdx + r11], r10;

        add r9, 1;
        jmp dr_h_el_loop;

      dr_h_el_done:
        // new_pos = pos + src_len (already in rax from the probe).
        ret;

      dr_h_el_overflow:
        mov rax, rcx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _dr_h_emit_cstr(src, max_bytes, out, out_cap, pos) -> new_pos
  //
  //   rdi = src_ptr
  //   rsi = max_bytes
  //   rdx = out
  //   rcx = out_cap
  //   r8  = pos
  //   rax = new_pos (sticky overflow sentinel = out_cap + 1)
  //
  //   Byte-copy from src up to max_bytes OR the first NUL byte,
  //   whichever comes first. The caller passes DR_NAME_BYTES = 32
  //   for the three inline strings (expected / actual / suggestion).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_h_ec_.
  // ==========================================================================
  pub let _dr_h_emit_cstr : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (max_bytes: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_h_emit_cstr byte-copies from src up to max_bytes or first NUL. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) NULL-source short-circuit: cmp rdi,0; je done (return pos unchanged). (2) copy loop: xor r9,r9; while r9 < max_bytes: load src byte via xor r10,r10; mov_b r10,[rdi+r9]; cmp r10,0; je done (NUL terminates). Overflow probe: mov r11,r8; add r11,r9; cmp r11,rcx; jae overflow. Store via mov_b [rdx+r11],r10. advance r9. (3) return rax = pos + i. All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_h_ec_.",
      block: {
        // NULL-source: return pos unchanged.
        cmp rdi, 0;
        je  dr_h_ec_done_unchanged;

        xor r9, r9;                            // i = 0

      dr_h_ec_loop:
        cmp r9, rsi;
        jae dr_h_ec_done;

        // Load src[i].
        xor r10, r10;
        mov_b r10, [rdi + r9];

        // Stop at first NUL.
        cmp r10, 0;
        je  dr_h_ec_done;

        // Overflow probe.
        mov r11, r8;
        add r11, r9;
        cmp r11, rcx;
        jae dr_h_ec_overflow;

        // Store byte at out + (pos + i).
        mov_b [rdx + r11], r10;

        add r9, 1;
        jmp dr_h_ec_loop;

      dr_h_ec_done:
        // new_pos = pos + i.
        mov rax, r8;
        add rax, r9;
        ret;

      dr_h_ec_done_unchanged:
        mov rax, r8;
        ret;

      dr_h_ec_overflow:
        mov rax, rcx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _dr_h_emit_u16_hex(value, out, out_cap, pos) -> new_pos
  //
  //   rdi = value          (u64; low 16 bits emitted)
  //   rsi = out
  //   rdx = out_cap
  //   rcx = pos
  //   rax = new_pos        (or out_cap + 1 on overflow)
  //
  //   Emit 4 hex nibbles (uppercase 0-9A-F) for value & 0xFFFF.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_h_eh_.
  // ==========================================================================
  pub let _dr_h_emit_u16_hex : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_h_emit_u16_hex emits 4 hex nibbles for value & 0xFFFF. Pure leaf; zero pushes; no stack frame; no nested CALL. Overflow probe: mov rax,rcx; add rax,4; cmp rax,rdx; ja overflow. Then for each nibble position 12,8,4,0 (high nibble first): mov r8,rdi; shr r8,<pos>; and r8,15 (imm8 fits imm32); lea r11,[rip+_dr_hex_digits]; xor r9,r9; mov_b r9,[r11+r8]; compute dst addr via mov r10,rsi; add r10,rcx; mov_b [r10+<i>],r9; (where i = 0,1,2,3). Return rax = pos + 4. All immediates (0, 4, 15, 12, 8) fit imm32. No test; no imul-r-imm; no multiline let. Labels prefixed dr_h_eh_.",
      block: {
        // Overflow probe.
        mov rax, rcx;
        add rax, 4;
        cmp rax, rdx;
        ja  dr_h_eh_overflow;

        // Pre-compute hex-table base and dst base.
        lea r11, [rip + _dr_hex_digits];

        mov r10, rsi;                          // out
        add r10, rcx;                          // out + pos

        // Nibble 0: bits 15..12.
        mov r8, rdi;
        shr r8, 12;
        and r8, 15;
        xor r9, r9;
        mov_b r9, [r11 + r8];
        mov_b [r10 + 0], r9;

        // Nibble 1: bits 11..8.
        mov r8, rdi;
        shr r8, 8;
        and r8, 15;
        xor r9, r9;
        mov_b r9, [r11 + r8];
        mov_b [r10 + 1], r9;

        // Nibble 2: bits 7..4.
        mov r8, rdi;
        shr r8, 4;
        and r8, 15;
        xor r9, r9;
        mov_b r9, [r11 + r8];
        mov_b [r10 + 2], r9;

        // Nibble 3: bits 3..0.
        mov r8, rdi;
        and r8, 15;
        xor r9, r9;
        mov_b r9, [r11 + r8];
        mov_b [r10 + 3], r9;

        // new_pos = pos + 4 (already in rax from the probe).
        ret;

      dr_h_eh_overflow:
        mov rax, rdx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _dr_h_emit_u32_dec(value, out, out_cap, pos) -> new_pos
  //
  //   rdi = value          (u64; low 32 bits emitted)
  //   rsi = out
  //   rdx = out_cap
  //   rcx = pos
  //   rax = new_pos        (or out_cap + 1 on overflow)
  //
  //   Emit decimal digits for value & 0xFFFFFFFF via greedy
  //   subtraction over the 10-entry powers-of-10 table. A value of
  //   0 emits a single '0'. Max output: 10 digits (u32 ceiling =
  //   4_294_967_295).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_h_ed_.
  // ==========================================================================
  pub let _dr_h_emit_u32_dec : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_h_emit_u32_dec emits decimal digits via greedy-subtract over the 10-entry powers-of-10 table. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) value==0 fast path: overflow probe pos+1 vs out_cap; emit '0' (0x30) at out+pos; return pos+1. (2) general: xor r11,r11 (emit_flag = 0); xor r8,r8 (i = 0 pow index); loop while i < 10: load pow = _dr_pow10[i] u32 via lea+shl+mov_d. Inner subtract loop: digit=0; while value >= pow: value -= pow; digit += 1. If digit > 0 OR emit_flag != 0: overflow probe pos vs out_cap; mov_b [out+pos], ('0'+digit); pos += 1; emit_flag = 1. i += 1. (3) return rax = pos. Note: value held in rdi (caller-save) but we modify it; after this function returns rdi is untrusted by caller contract. All immediates (0, 1, 2, 10, 15, '0'=0x30) fit imm32. No test; no imul-r-imm; no multiline let. Labels prefixed dr_h_ed_.",
      block: {
        // Fast path: value == 0 emits a single '0'.
        cmp rdi, 0;
        jne dr_h_ed_general;

        // Overflow probe for the single '0'.
        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  dr_h_ed_overflow;

        // Compute dst addr and store '0' (0x30).
        mov r11, rsi;
        add r11, rcx;
        mov r9, 48;                            // '0'
        mov_b [r11 + 0], r9;

        // rax already = pos + 1.
        ret;

      dr_h_ed_general:
        // r11 = emit_flag (0 = suppress leading zeros).
        xor r11, r11;
        // r8 = i (pow index 0..9).
        xor r8, r8;

      dr_h_ed_pow_loop:
        cmp r8, 10;
        jae dr_h_ed_done;

        // Load pow = _dr_pow10[i] (u32 stride 4).
        mov r10, r8;
        shl r10, 2;
        lea r9, [rip + _dr_pow10];
        add r9, r10;
        xor r10, r10;
        mov_d r10, [r9 + 0];                   // r10 = pow

        // Inner: digit = 0; while value >= pow: value -= pow; digit += 1.
        //   value in rdi; pow in r10; digit in r9.
        xor r9, r9;

      dr_h_ed_sub_loop:
        cmp rdi, r10;
        jb  dr_h_ed_digit_done;
        sub rdi, r10;
        add r9, 1;
        jmp dr_h_ed_sub_loop;

      dr_h_ed_digit_done:
        // Emit digit iff digit > 0 OR emit_flag != 0.
        cmp r9, 0;
        jne dr_h_ed_emit;
        cmp r11, 0;
        je  dr_h_ed_next;

      dr_h_ed_emit:
        // Overflow probe: pos + 1 > out_cap ?
        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  dr_h_ed_overflow;

        // char = '0' + digit = 0x30 + r9.
        mov r10, 48;
        add r10, r9;

        // Store at out + pos.
        mov rax, rsi;
        add rax, rcx;
        mov_b [rax + 0], r10;

        // pos += 1; emit_flag := 1.
        add rcx, 1;
        mov r11, 1;

      dr_h_ed_next:
        add r8, 1;
        jmp dr_h_ed_pow_loop;

      dr_h_ed_done:
        // If nothing was emitted (all powers skipped; value was 0 but
        // caught above -- defensive): emit a single '0'.
        cmp r11, 0;
        jne dr_h_ed_return;

        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  dr_h_ed_overflow;

        mov r11, rsi;
        add r11, rcx;
        mov r9, 48;
        mov_b [r11 + 0], r9;
        add rcx, 1;

      dr_h_ed_return:
        mov rax, rcx;
        ret;

      dr_h_ed_overflow:
        mov rax, rdx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _dr_build(code_sev, primary_off, primary_len, strings_ptr,
  //           out, out_cap) -> packed_u64
  //
  //   rdi = code_sev = (severity << 16) | (code & 0xFFFF)
  //   rsi = primary_off (u32)
  //   rdx = primary_len (u32)
  //   rcx = strings_ptr (NULLable; else 96-byte triple)
  //   r8  = out (destination 128-byte buffer)
  //   r9  = out_cap
  //   rax = packed_u64 = (DR_RECORD_BYTES << 32) | status
  //
  // Flow:
  //   1. Validate out != 0 (BAD_INPUT).
  //   2. Validate out_cap >= DR_RECORD_BYTES=128 (OUT_TOO_SMALL).
  //   3. Extract severity = (code_sev >> 16) & 0xFFFF. Validate
  //      severity <= 3 (BAD_SEVERITY).
  //   4. Extract code = code_sev & 0xFFFF.
  //   5. Zero-fill 128 bytes at out via 16 u64 stores
  //      (`mov [out + disp], rax` with rax=0, disp = 0..120 step 8).
  //      Done inline so the function stays a pure leaf.
  //   6. Store magic 'DIAG' = 0x47414944 u32 at [out + 0].
  //   7. Store code u16 at [out + 4] (two mov_b: low byte then high
  //      byte at [+4] and [+5]).
  //   8. Store severity u16 at [out + 6] (same shape).
  //   9. Store primary_off u32 at [out + 8].
  //  10. Store primary_len u32 at [out + 12].
  //      (Secondary 0,0 covered by Step 5's zero-fill.)
  //  11. If strings_ptr != 0, byte-copy 96 bytes to [out + 24].
  //      Done inline as a byte-count loop (no CALL).
  //  12. Return packed (128 << 32) | 0.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dr_b_.
  // ==========================================================================
  pub let _dr_build : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (code_sev: u64) (primary_off: u64) (primary_len: u64)
       (strings_ptr: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_build populates a 128-byte Diag record. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) cmp r8,0 je bad_input (return 0x5B00); (2) cmp r9,128 jb out_too_small (return 0x5B01); (3) sev = rdi >> 16 (safe shr; sev field is u16 so low 16 only matters); and r10,0xFFFF; cmp r10,3; ja bad_severity (return 0x5B03); (4) code = rdi & 0xFFFF; (5) zero-fill 128 bytes via 16 unrolled `mov [r8+disp], rax` (rax=0, disp 0..120 step 8); (6) write magic u32 via `mov rax, 0x47414944; mov_d [r8+0], rax`; (7) write code u16 via two mov_b (low at [+4], high at [+5]); (8) write severity u16 via two mov_b (low at [+6], high at [+7]); (9/10) write primary_off/len u32 via mov_d; (11) if strings_ptr == 0 skip; else byte-copy 96 bytes [rcx..rcx+96) to [r8+24..r8+120); (12) return (128 << 32) | 0. All cmp immediates (0, 3, 128) fit imm32. All `and` immediates (0xFFFF) fit imm32 (imm32 safe: bit 31 clear). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_b_.",
      block: {
        // (1) Validate out != 0.
        cmp r8, 0;
        je  dr_b_bad_input;

        // (2) Validate out_cap >= 128.
        cmp r9, 128;
        jb  dr_b_out_too_small;

        // (3) Extract + validate severity.
        mov r10, rdi;
        shr r10, 16;
        and r10, 0xFFFF;
        cmp r10, 3;
        ja  dr_b_bad_severity;

        // Save severity in r11 for Step 8.
        mov r11, r10;

        // (4) Extract code (low 16 of rdi) into r10.
        mov r10, rdi;
        and r10, 0xFFFF;

        // (5) Zero-fill 128 bytes.
        xor rax, rax;
        mov [r8 + 0  ], rax;
        mov [r8 + 8  ], rax;
        mov [r8 + 16 ], rax;
        mov [r8 + 24 ], rax;
        mov [r8 + 32 ], rax;
        mov [r8 + 40 ], rax;
        mov [r8 + 48 ], rax;
        mov [r8 + 56 ], rax;
        mov [r8 + 64 ], rax;
        mov [r8 + 72 ], rax;
        mov [r8 + 80 ], rax;
        mov [r8 + 88 ], rax;
        mov [r8 + 96 ], rax;
        mov [r8 + 104], rax;
        mov [r8 + 112], rax;
        mov [r8 + 120], rax;

        // (6) Write magic u32 'DIAG' = 0x47414944 at [+0].
        mov rax, 0x47414944;
        mov_d [r8 + 0], rax;

        // (7) Write code u16 at [+4..+6).
        //   low byte = code & 0xFF; high byte = (code >> 8) & 0xFF.
        mov r9, r10;
        and r9, 0xFF;
        mov_b [r8 + 4], r9;

        mov r9, r10;
        shr r9, 8;
        and r9, 0xFF;
        mov_b [r8 + 5], r9;

        // (8) Write severity u16 at [+6..+8).
        mov r9, r11;
        and r9, 0xFF;
        mov_b [r8 + 6], r9;

        mov r9, r11;
        shr r9, 8;
        and r9, 0xFF;
        mov_b [r8 + 7], r9;

        // (9) Write primary_off u32 at [+8].
        mov_d [r8 + 8], rsi;

        // (10) Write primary_len u32 at [+12].
        mov_d [r8 + 12], rdx;

        // Secondary (0,0 at raw M7) already zero from Step 5.

        // (11) If strings_ptr != 0, byte-copy 96 bytes to [out + 24].
        cmp rcx, 0;
        je  dr_b_strings_done;

        xor r9, r9;                            // j = 0

      dr_b_strings_loop:
        cmp r9, 96;
        jae dr_b_strings_done;

        // Load src byte strings_ptr[j].
        xor rax, rax;
        mov_b rax, [rcx + r9];

        // Compute dst addr: out + 24 + j.
        mov r10, r9;
        add r10, 24;
        mov_b [r8 + r10], rax;

        add r9, 1;
        jmp dr_b_strings_loop;

      dr_b_strings_done:
        // (12) Return packed (128 << 32) | 0.
        mov rax, 128;
        shl rax, 32;
        ret;

      dr_b_bad_input:
        mov rax, 0x5B00;
        ret;

      dr_b_out_too_small:
        mov rax, 0x5B01;
        ret;

      dr_b_bad_severity:
        mov rax, 0x5B03;
        ret;
      }
    }

  // ==========================================================================
  // _dr_render_human(record_ptr, record_len, out, out_cap)
  //                                                 -> packed_u64
  //
  //   rdi = record_ptr
  //   rsi = record_len
  //   rdx = out
  //   rcx = out_cap
  //   rax = packed_u64 = (bytes_written << 32) | status
  //
  //   Serialize the record to:
  //     "E<hex4> <SEV> at <dec_off>+<dec_len>: expected <exp>,
  //      got <act> (hint: <sug>)"
  //   where <SEV> is one of ERR / WARN / INFO / HINT and the hint
  //   clause is omitted when suggestion_inline is empty.
  //
  // Register plan (6 callee-save pushes = 48B; entry rsp%16==8 ->
  // after prologue rsp%16==0 at every nested CALL):
  //   rbx = record_ptr
  //   rbp = out
  //   r12 = out_cap
  //   r13 = cursor (bytes written so far)
  //   r14, r15 = scratch across CALLs
  //
  // Labels prefixed dr_rh_.
  // ==========================================================================
  pub let _dr_render_human : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (record_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_render_human emits a compact human-readable diagnostic line. Prologue: 6 callee-save pushes (rbx/rbp/r12/r13/r14/r15 = 48B) + sub rsp,8 align; entry rsp%16==8 -> after pushes+sub rsp%16==0 at every nested CALL (into _dr_h_emit_lit / _dr_h_emit_u16_hex / _dr_h_emit_u32_dec / _dr_h_emit_cstr). Validates record_ptr != 0, out != 0 (BAD_INPUT 0x5B00); record_len >= 128 (BAD_RECORD 0x5B02); magic 'DIAG' at [record+0] via mov_d (BAD_RECORD). Then emits literals + hex4(code) + ' ' + sev_name + ' at ' + dec(primary_off) + '+' + dec(primary_len) + ': expected ' + cstr(expected,32) + ', got ' + cstr(actual,32); if suggestion[0] != 0 emits ' (hint: ' + cstr(suggestion,32) + ')'. On any helper returning out_cap+1 (sticky overflow sentinel), returns (0 << 32) | DR_ERR_RENDER_OVERFLOW. Otherwise returns (cursor << 32) | DR_OK. rbx = record_ptr; rbp = out; r12 = out_cap; r13 = cursor; r14/r15 = scratch. All cmp immediates (0, 128, 0x47414944) fit imm32 (0x47414944 has bit 31 clear). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_rh_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // align: 8 + 48 + 8 = 64 -> rsp%16==0 at nested CALL

        // Validate.
        cmp rdi, 0;
        je  dr_rh_bad_input;
        cmp rdx, 0;
        je  dr_rh_bad_input;
        cmp rsi, 128;
        jb  dr_rh_bad_record;

        // Validate magic.
        xor rax, rax;
        mov_d rax, [rdi + 0];
        mov r15, 0x47414944;
        cmp rax, r15;
        jne dr_rh_bad_record;

        // Stash state.
        mov rbx, rdi;                          // record_ptr
        mov rbp, rdx;                          // out
        mov r12, rcx;                          // out_cap
        xor r13, r13;                          // cursor = 0

        // --- Emit 'E' ---
        lea r14, [rip + _dr_lit_human_e];
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit hex4(code) --- (code is u16 at record[+4..+6))
        xor r15, r15;
        mov_b r15, [rbx + 4];
        xor r14, r14;
        mov_b r14, [rbx + 5];
        shl r14, 8;
        or  r15, r14;                          // r15 = code

        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u16_hex;
        mov r13, rax;

        // --- Emit ' ' + sev_name (3-4 bytes, stop-at-NUL) ---
        lea r14, [rip + _dr_lit_sp];
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // Read severity u16 at [+6..+8).
        xor r15, r15;
        mov_b r15, [rbx + 6];
        xor r14, r14;
        mov_b r14, [rbx + 7];
        shl r14, 8;
        or  r15, r14;                          // r15 = severity
        cmp r15, 3;
        ja  dr_rh_bad_severity;

        // sev_name_ptr = _dr_sev_names + sev * 4.
        mov r14, r15;
        shl r14, 2;
        lea r15, [rip + _dr_sev_names];
        add r15, r14;

        mov rdi, r15;
        mov rsi, 4;                            // up to 4 bytes
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- Emit ' at ' ---
        lea r14, [rip + _dr_lit_at];
        mov rdi, r14;
        mov rsi, 4;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit dec(primary_off) ---
        xor r15, r15;
        mov_d r15, [rbx + 8];
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u32_dec;
        mov r13, rax;

        // --- Emit '+' ---
        lea r14, [rip + _dr_lit_plus];
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit dec(primary_len) ---
        xor r15, r15;
        mov_d r15, [rbx + 12];
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u32_dec;
        mov r13, rax;

        // --- Emit ': expected ' ---
        lea r14, [rip + _dr_lit_colon_sp_exp];
        mov rdi, r14;
        mov rsi, 11;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit cstr(expected, 32) ---
        mov rdi, rbx;
        add rdi, 24;                           // expected offset
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- Emit ', got ' ---
        lea r14, [rip + _dr_lit_got_sep];
        mov rdi, r14;
        mov rsi, 6;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit cstr(actual, 32) ---
        mov rdi, rbx;
        add rdi, 56;                           // actual offset
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- Suggestion: skip if first byte is NUL ---
        xor r15, r15;
        mov_b r15, [rbx + 88];
        cmp r15, 0;
        je  dr_rh_finish;

        // --- Emit ' (hint: ' ---
        lea r14, [rip + _dr_lit_open_hint];
        mov rdi, r14;
        mov rsi, 8;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- Emit cstr(suggestion, 32) ---
        mov rdi, rbx;
        add rdi, 88;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- Emit ')' ---
        lea r14, [rip + _dr_lit_close_paren];
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

      dr_rh_finish:
        // Overflow check: if cursor > out_cap, return RENDER_OVERFLOW.
        cmp r13, r12;
        ja  dr_rh_overflow;

        // Pack (cursor << 32) | DR_OK.
        mov rax, r13;
        shl rax, 32;
        jmp dr_rh_epilogue;

      dr_rh_bad_input:
        mov rax, 0x5B00;
        jmp dr_rh_epilogue;

      dr_rh_bad_record:
        mov rax, 0x5B02;
        jmp dr_rh_epilogue;

      dr_rh_bad_severity:
        mov rax, 0x5B03;
        jmp dr_rh_epilogue;

      dr_rh_overflow:
        mov rax, 0x5B04;
        jmp dr_rh_epilogue;

      dr_rh_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _dr_render_lsp(record_ptr, record_len, out, out_cap) -> packed_u64
  //
  //   rdi = record_ptr
  //   rsi = record_len
  //   rdx = out
  //   rcx = out_cap
  //   rax = packed_u64 = (bytes_written << 32) | status
  //
  //   Serialize the record to LSP-compatible one-line JSON:
  //     {"range":{"start":{"line":0,"character":<N>},"end":{"line":0,
  //      "character":<N>}},"severity":<N>,"code":"E<hex4>",
  //      "message":"expected <exp>, got <act>; hint: <sug>"}
  //   Suggestion clause omitted when suggestion_inline is empty.
  //
  //   LSP severity mapping: our severity 0..3 -> LSP 1..4.
  //
  // Register plan: identical to _dr_render_human (6 pushes; rbx /
  // rbp / r12 / r13 / r14 / r15; cursor in r13).
  //
  // Labels prefixed dr_rl_.
  // ==========================================================================
  pub let _dr_render_lsp : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (record_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M7 (#2688): _dr_render_lsp emits a LSP-compatible one-line JSON diagnostic. Prologue: 6 callee-save pushes (rbx/rbp/r12/r13/r14/r15 = 48B) + sub rsp,8 align; entry rsp%16==8 -> after pushes+sub rsp%16==0 at every nested CALL (into _dr_h_emit_lit / _dr_h_emit_u16_hex / _dr_h_emit_u32_dec / _dr_h_emit_cstr). Validates record_ptr != 0, out != 0 (BAD_INPUT 0x5B00); record_len >= 128 (BAD_RECORD 0x5B02); magic 'DIAG' at [record+0] (BAD_RECORD). Then emits (in order): lsp_prefix literal (40B), dec(primary_off), lsp_mid1 literal (24B), lsp_mid1_tail literal (6B), dec(primary_off + primary_len), lsp_mid2 literal (14B), dec(severity + 1), lsp_mid3 literal (10B), hex4(code), lsp_mid4 literal (22B), cstr(expected,32), got_sep literal (6B), cstr(actual,32); if suggestion[0] != 0 emits hint_sep literal (8B) + cstr(suggestion,32); then lsp_suffix literal (2B). On any helper returning out_cap+1 (sticky overflow sentinel), returns 0x5B04 RENDER_OVERFLOW. Otherwise returns (cursor << 32) | DR_OK. rbx = record_ptr; rbp = out; r12 = out_cap; r13 = cursor; r14/r15 = scratch. All cmp immediates (0, 128, 0x47414944) fit imm32 sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dr_rl_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                            // align: 8 + 48 + 8 = 64 -> rsp%16==0 at nested CALL

        // Validate.
        cmp rdi, 0;
        je  dr_rl_bad_input;
        cmp rdx, 0;
        je  dr_rl_bad_input;
        cmp rsi, 128;
        jb  dr_rl_bad_record;

        xor rax, rax;
        mov_d rax, [rdi + 0];
        mov r15, 0x47414944;
        cmp rax, r15;
        jne dr_rl_bad_record;

        mov rbx, rdi;
        mov rbp, rdx;
        mov r12, rcx;
        xor r13, r13;

        // --- lsp_prefix (40B) ---
        lea r14, [rip + _dr_lit_lsp_prefix];
        mov rdi, r14;
        mov rsi, 40;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- dec(primary_off) ---
        xor r15, r15;
        mov_d r15, [rbx + 8];
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u32_dec;
        mov r13, rax;

        // --- lsp_mid1 (24B) ---
        lea r14, [rip + _dr_lit_lsp_mid1];
        mov rdi, r14;
        mov rsi, 24;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- lsp_mid1_tail "cter":" (6B) ---
        lea r14, [rip + _dr_lit_lsp_mid1_tail];
        mov rdi, r14;
        mov rsi, 6;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- dec(primary_off + primary_len) ---
        xor r15, r15;
        mov_d r15, [rbx + 8];
        xor r14, r14;
        mov_d r14, [rbx + 12];
        add r15, r14;
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u32_dec;
        mov r13, rax;

        // --- lsp_mid2 }},"severity": (14B) ---
        lea r14, [rip + _dr_lit_lsp_mid2];
        mov rdi, r14;
        mov rsi, 14;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- dec(severity + 1) ---
        xor r15, r15;
        mov_b r15, [rbx + 6];
        xor r14, r14;
        mov_b r14, [rbx + 7];
        shl r14, 8;
        or  r15, r14;
        add r15, 1;                            // LSP severity = our + 1
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u32_dec;
        mov r13, rax;

        // --- lsp_mid3 ,"code":"E (10B) ---
        lea r14, [rip + _dr_lit_lsp_mid3];
        mov rdi, r14;
        mov rsi, 10;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- hex4(code) ---
        xor r15, r15;
        mov_b r15, [rbx + 4];
        xor r14, r14;
        mov_b r14, [rbx + 5];
        shl r14, 8;
        or  r15, r14;
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _dr_h_emit_u16_hex;
        mov r13, rax;

        // --- lsp_mid4 ","message":"expected  (22B) ---
        lea r14, [rip + _dr_lit_lsp_mid4];
        mov rdi, r14;
        mov rsi, 22;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- cstr(expected, 32) ---
        mov rdi, rbx;
        add rdi, 24;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- ', got ' (6B) ---
        lea r14, [rip + _dr_lit_got_sep];
        mov rdi, r14;
        mov rsi, 6;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- cstr(actual, 32) ---
        mov rdi, rbx;
        add rdi, 56;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

        // --- Suggestion branch: skip if first byte NUL ---
        xor r15, r15;
        mov_b r15, [rbx + 88];
        cmp r15, 0;
        je  dr_rl_close;

        // --- '; hint: ' (8B) ---
        lea r14, [rip + _dr_lit_hint_sep];
        mov rdi, r14;
        mov rsi, 8;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // --- cstr(suggestion, 32) ---
        mov rdi, rbx;
        add rdi, 88;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_cstr;
        mov r13, rax;

      dr_rl_close:
        // --- '"}' (2B) ---
        lea r14, [rip + _dr_lit_lsp_suffix];
        mov rdi, r14;
        mov rsi, 2;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _dr_h_emit_lit;
        mov r13, rax;

        // Overflow check.
        cmp r13, r12;
        ja  dr_rl_overflow;

        mov rax, r13;
        shl rax, 32;
        jmp dr_rl_epilogue;

      dr_rl_bad_input:
        mov rax, 0x5B00;
        jmp dr_rl_epilogue;

      dr_rl_bad_record:
        mov rax, 0x5B02;
        jmp dr_rl_epilogue;

      dr_rl_overflow:
        mov rax, 0x5B04;
        jmp dr_rl_epilogue;

      dr_rl_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
