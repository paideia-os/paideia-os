// src/effect_unify.pdx -- libpdx-pds-parser.R225.M4 (paideia-os#2685)
//
// EffectUnify: effect-row unification with sub-row JOIN semantics
// and rank-restricted-quantifier enforcement (P10). Layered over
// R225.M2 RowTypes (Rémy row primitives, source of truth for the
// TyRow kind + the shared singleton _hm_pool) and reuses R224.M3
// EffectRow's packed-id ROW_EXT encoding (label id in the arg0
// slot). R225.M4 of the HM-typechecker umbrella (paideia-os#2489).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R225 is the typechecker umbrella (per design/terminal/semantic-
// shell-language-plan.md section "R225 -- Unified HM type checker
// across three sub-languages"). R225.M1 landed the Robinson /
// Damas-Milner 1982 kernel (hm_core.pdx); R225.M2 landed the Rémy
// 1992 row-polymorphism extension (row_types.pdx); R225.M3 is
// deferred (Datalog predicate types via schema registry). R225.M4
// (THIS module) lands the EFFECT-ROW UNIFICATION layer:
//
//   * `_eu_unify(row_a, row_b) -> (joined_row, status)` -- JOIN two
//     effect rows; the join is the LEAST (upper-bound) row that is
//     a super-row of both inputs. Effects are MONOTONE: a lambda
//     that performs the labels in row_a can safely be re-typed to
//     the join row that adds row_b's labels. The join operation
//     coincides with set-union over the label alphabet, with
//     fresh-ROW_VAR tail if either input carries an open tail.
//
//   * `_eu_check_rank(scheme_ptr, scheme_len) -> status` -- validate
//     that a HmCore scheme (wire format: n_bound_vars + n_body_nodes
//     + bound_var_ids + body) satisfies the P10 rank restriction:
//     "type schemes may bind row variables only at the OUTERMOST
//     arrow; nested rows cannot generalize". At M4 the HmCore wire
//     format exposes a SINGLE outer ∀, so the check is a shape-
//     validator (header consistency, bounded sizes, legal node
//     kinds). The RANK_RESTRICTED_VIOLATION code is reserved for
//     the M4.1 wire-format extension that lands nested-quantifier
//     body nodes.
//
//   * `_eu_least(rows_ptr, n) -> (joined_row, status)` -- fold the
//     JOIN across N effect rows. The join operation is associative
//     and commutative (set union with ROW_VAR tail propagation), so
//     the fold order is irrelevant; this entry is a convenience
//     wrapper that saves N-1 call sites in the typechecker driver.
//
// Why JOIN and not Rémy pivot. Rémy's record-row unification
// demands structural equality: `{a: τ₁, b: τ₂}` and `{a: τ₁', c:
// τ₃}` CANNOT unify unless both tails are row-vars that pivot into
// a common shape. Effects behave DIFFERENTLY: a lambda that
// performs `!{io}` can always be given the type `!{io, mem}` -- the
// extra permission is harmless. The lattice is thus:
//
//     bot = {}  (closed empty, bottom)
//     L1 \/ L2 = union(L1, L2)  (join of two label sets)
//     top = Σ ∪ {ρ_fresh}  (open row covering all labels)
//
// The JOIN is the LEAST-UPPER-BOUND operation. _eu_unify's "unify"
// name is a conventional overload: when the type-checker encounters
// two effect rows that must flow into one position, the JOIN is
// what the inferred-type's effect row must be. The pre-existing
// Rémy-pivot `_rt_row_unify` is NOT the right primitive here; this
// module provides a disjoint second row-arithmetic entry point.
//
// =============================================================================
// POOL REUSE (R225.M2 ABSOLUTE)
// =============================================================================
//
// EffectUnify shares R225.M2's singleton `_hm_pool` + `_hm_pool_next`
// + `_hm_var_next` via the row-aware allocators `_rt_row_empty` /
// `_rt_row_var` / `_rt_row_extend` and the resolved-chain walker
// `_rt_find`. The duplicate-label check inside the row builder uses
// `_rt_row_select` (R225.M2) rather than a hand-written walk, so
// the dedup discipline matches the one row-restrict/row-concat
// already enforce. No new pool slot layout; the 16-byte TyRow
// stride is inherited verbatim.
//
// EffectUnify does NOT call into EffectRow (R224.M3) at the link
// level. The two modules share a semantic contract (the arg0 u32
// slot carries a packed `(tag << 24) | idx` label id); EffectUnify
// treats the arg0 bytes as an OPAQUE u32 label identity -- it does
// NOT decode the packed tuple, so the identity comparison reduces
// to a 32-bit `cmp` on arg0 which works equally for both the
// R224.M3 effect-label encoding and the R224.M4 capability-label
// encoding. The TyRow dispatch byte at [+2] (subkind) is the
// authoritative EMPTY/EXT/VAR discriminator in both flavours.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _eu_unify(row_a, row_b) -> packed_u64
//     Compute the JOIN of two effect rows. Returns
//     (joined_row_ref << 32) | status in rax. On any walk-time
//     error (non-TyRow kind on a cursor; too many unique labels),
//     the high 32 bits are zero and the low 32 bits carry the
//     error band 0x4900..0x4907.
//
//   _eu_check_rank(scheme_ptr, scheme_len) -> status
//     Validate a HmCore scheme byte stream against the P10 rank
//     restriction. At M4: EU_OK iff the scheme is well-formed
//     (header consistent with scheme_len; n_bound_vars <= 64;
//     n_body_nodes in [1..128]; every body node's kind in
//     {TYVAR, TYCON, TYAPP, TYROW}). EU_ERR_BAD_SCHEME on
//     malformed shape; EU_ERR_RANK_RESTRICTED_VIOLATION reserved
//     for M4.1 wire-format with nested quantifier body nodes.
//
//   _eu_least(rows_ptr, n) -> packed_u64
//     Fold `_eu_unify` across N row pool_idx values. Returns
//     (joined_row_ref << 32) | status. On n == 0 returns
//     (0 << 32) | EU_ERR_EMPTY_ARRAY; on n > EU_MAX_JOIN_ARITY
//     (16) returns (0 << 32) | EU_ERR_TOO_MANY. Any inner
//     `_eu_unify` failure bubbles up with its own packed form.
//
// Register maps (SysV):
//
//   _eu_unify(rdi, rsi)              -> rax
//   _eu_check_rank(rdi, rsi)         -> rax
//   _eu_least(rdi, rsi)              -> rax
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- scheme-length math uses `shl r, 2` for
//     u32 arrays and `shl r, 4` for 16-byte node arrays; the only
//     bit mask needed is "is subkind the EXT code (1)" which is a
//     direct `cmp r, 1`.
//   - No 2-op `imul r, imm` -- 16-byte node stride is `shl r, 4`;
//     4-byte u32 scratch stride is `shl r, 2`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `EffectUnify` matches `effect_unify.pdx`.
//   - Labels prefixed `eu_` (unique against the sibling parser-tier
//     modules in this library: u8n_ (R221.M1), gi_ (R221.M2),
//     wp_ (R221.M3), cl_ (R221.M4), ast_ (R221.M5), sch_sig_
//     (R222.M1), cmd_sig_ (R222.M2), fi_ (R222.M3), afs_ (R222.M4),
//     cmdreg_ (R222.M5), pl_ (R223.M1), rp_ (R223.M2), ll_ (R224.M1),
//     cc_ (R224.M2), er_ (R224.M3), cr_ (R224.M4), ls_ (R224.M5),
//     hm_ (R225.M1), rt_ (R225.M2), dl_ (R226.M1), se_ (R229.M2),
//     te_ (R229.M3)). Never bare `loop`/`if`/`let`/`fn`/`ret`.
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 8, 16, 32, 64,
//     128, status codes 0x4900..0x4907) fit imm32 with bit 31 clear.
//   - Byte loads via `xor r,r; mov_b r,[base]` (zero-extends into
//     full qword); u32 loads via `xor r,r; mov_d r,[addr]` (zero-
//     extends); u64 loads via plain `mov`.
//   - u32 stores via `mov_d`; u8 stores via `mov_b`.
//   - Cross-module .bss writes via `lea r11, [rip + sym]; mov
//     [r11], rax` (precedent: audit_record.pdx; row_types.pdx).
//   - Register-liveness: r11 is clobbered by every nested CALL.
//     Every value that must survive a nested CALL lives in r12..r15
//     (callee-save) or on the stack frame scratch slot.
//   - _eu_unify, _eu_least and _eu_check_rank are self-contained
//     (no self-recursion). _eu_unify calls _rt_find (nested) +
//     _rt_row_empty / _rt_row_var / _rt_row_extend / _rt_row_select
//     (nested, cross-module into R225.M2). _eu_least calls
//     _eu_unify (nested, intra-module). _eu_check_rank is a pure
//     byte walker over the caller-supplied scheme buffer with no
//     nested CALL.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M4.1  Wire-format extension landing nested-quantifier body
//              nodes in the HmCore scheme serialisation; THIS is
//              when `EU_ERR_RANK_RESTRICTED_VIOLATION` becomes a
//              reachable return code (the walker learns to descend
//              into a nested scheme-ref body kind and reject any
//              bound-var declaration on the inner level).
//   R225.M4.2  Inner-subterm Rémy unification on effect-labelled
//              rows -- when the join is forced to produce a
//              non-flat shape because one input carries row-vars
//              bound by the enclosing environment. Reserves the
//              `EU_ERR_UNIFY_INCONSISTENT` + `EU_ERR_ROWVAR_OCCURS`
//              slots.
//   R225.M4.3  Capability-row join (parallel to the effect-row
//              join; R224.M4 CapRow uses the same encoding). The
//              implementation is already k-ary generic in the
//              label alphabet; the parallel landing is a renaming
//              exercise.
//   R225.M4.4  Per-session effect-label alphabet override: when a
//              session declares additional effect labels via a
//              future `_er_declare`, the JOIN result labels remain
//              valid (packed-id identity preserved).
//   R225.M4.5  Row-fingerprint caching: a per-REPL turn LRU keyed
//              on `(row_a, row_b)` + hashed label-set signatures,
//              so repeated joins across a tight REPL loop skip the
//              walk/build cost.
//   R225.M4.6  30-test proptest corpus + fingerprint goldens
//              (filed as R225.M4.9 follow-up; the test enumeration
//              is in the design doc §7).
//
// =============================================================================
// Upstream: paideia-os#2685 (THIS ticket, R225.M4). Design doc:
// design/shell/effect-row-unification.md. Related plans:
// design/terminal/semantic-shell-language-plan.md section R225.M4,
// design/shell/row-types-remy.md, design/shell/effect-polymorphism.md.

module EffectUnify = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax, low 32 bits for packed)
  // ==========================================================================
  //
  // Band 0x4900..0x49FF, carved on a kilo-step boundary past the
  // Wave-121 R224.M4 CapRow band (0x4300..0x43FF) and the Wave-122
  // R221.M5 Ast band (0x4400..0x44FF), R222.M5 CmdRegistry band
  // (0x4500..0x45FF) and R224.M5 LetScope band (0x4600..0x46FF),
  // and the parallel R221.M6/R222.M6 Wave-123 arm reservations
  // (0x4700..0x47FF R221.M6 and 0x4800..0x48FF R222.M6 by prior
  // arm-dispatch convention). Slots 0x4908..0x49FF reserved for
  // R225.M4.1+ follow-ups.

  pub let EU_OK                            : u64 = 0
  pub let EU_ERR_KIND_MISMATCH             : u64 = 0x4900
  pub let EU_ERR_POOL_FULL                 : u64 = 0x4901
  pub let EU_ERR_RANK_RESTRICTED_VIOLATION : u64 = 0x4902
  pub let EU_ERR_BAD_SCHEME                : u64 = 0x4903
  pub let EU_ERR_EMPTY_ARRAY               : u64 = 0x4904
  pub let EU_ERR_TOO_MANY                  : u64 = 0x4905
  pub let EU_ERR_ROWVAR_OCCURS             : u64 = 0x4906
  pub let EU_ERR_UNIFY_INCONSISTENT        : u64 = 0x4907

  // ==========================================================================
  // SECTION 2 -- KIND + SUBKIND + LAYOUT CONSTANTS
  // ==========================================================================
  //
  // RowTypes kind/subkind constants duplicated here so this module
  // compiles standalone without a cross-module `let` import
  // (paideia-as cross-module `let` import lands with R220.M11;
  // row_types.pdx uses the same duplication precedent).

  pub let EU_KIND_TYROW              : u64 = 4

  pub let EU_SUBKIND_EMPTY           : u64 = 0
  pub let EU_SUBKIND_EXT             : u64 = 1
  pub let EU_SUBKIND_VAR             : u64 = 2

  // HmCore kind codes needed by _eu_check_rank's body-node walk.
  pub let EU_HM_KIND_TYVAR           : u64 = 1
  pub let EU_HM_KIND_TYCON           : u64 = 2
  pub let EU_HM_KIND_TYAPP           : u64 = 3

  pub let EU_OFF_KIND                : u64 = 0
  pub let EU_OFF_SUBKIND             : u64 = 2
  pub let EU_OFF_ARG0                : u64 = 4
  pub let EU_OFF_ARG1                : u64 = 8
  pub let EU_OFF_ARG2                : u64 = 12

  // Walk bounds. 16 labels per row is the same cap R224.M3 EffectRow
  // uses for `_er_parse` collection; EffectUnify's walk mirrors that
  // discipline. The join target carries at most 32 raw entries (16
  // from row_a + 16 from row_b) BEFORE dedup; after dedup the row
  // may be shorter, but the scratch must sit the raw count.
  pub let EU_MAX_LABELS_PER_ROW      : u64 = 16
  pub let EU_MAX_RAW_LABELS          : u64 = 32
  pub let EU_MAX_JOIN_ARITY          : u64 = 16

  // Scheme wire-format constants (mirror HmCore's definitions in
  // hm_core.pdx; duplicated so this module compiles standalone).
  pub let EU_SCHEME_HDR_BYTES        : u64 = 8
  pub let EU_SCHEME_OFF_NBOUND       : u64 = 0
  pub let EU_SCHEME_OFF_NBODY        : u64 = 4
  pub let EU_SCHEME_OFF_IDS          : u64 = 8
  pub let EU_SCHEME_MAX_BOUND        : u64 = 64
  pub let EU_SCHEME_MAX_BODY         : u64 = 128
  pub let EU_SCHEME_NODE_BYTES       : u64 = 16
  pub let EU_SCHEME_ID_BYTES         : u64 = 4

  // ==========================================================================
  // SECTION 3 -- STATIC STATE
  // ==========================================================================
  //
  // `_eu_label_scratch` is the raw-collect buffer for `_eu_unify`'s
  // Phase 1 label-walk (up to 32 u32 packed label ids before dedup).
  // Disjoint from R225.M1 `_hm_subst_table`, R225.M2
  // `_rt_row_restrict`/`_rt_row_concat` scratch slice at
  // `_hm_subst_table[384..512)`, R224.M3 `_er_parse_scratch` (64 B)
  // and R224.M4 `_cr_parse_scratch` (64 B). The four scratch
  // surfaces could in principle be unified at a later M, but the
  // disjoint carve-out keeps the four sub-languages independently
  // reviewable AND lets effect-row join operations run concurrently
  // with effect-row/capability-row parse in the same shell turn.

  pub let mut _eu_label_scratch : [u8; 128] = uninit @align(8)

  // ==========================================================================
  // _eu_unify(row_a, row_b) -> packed_u64
  //
  //   rdi = row_a           (pool_idx of the first effect row)
  //   rsi = row_b           (pool_idx of the second effect row)
  //   rax = (joined_row_ref << 32) | status
  //
  // Compute the JOIN (set union with ROW_VAR tail propagation) of
  // two effect rows. The algorithm walks each row collecting its
  // packed label ids and ROW_VAR-tail bit, then rebuilds a single
  // row containing the union of labels with the appropriate tail.
  //
  // Phase 1a (walk row_a):
  //   cursor := row_a
  //   loop:
  //     cursor := _rt_find(cursor)
  //     if kind != TyRow: return KIND_MISMATCH
  //     subkind of cursor:
  //       EMPTY -> done (phase 1b)
  //       VAR   -> has_var_tail := 1; done
  //       EXT   -> scratch[a_count] := arg0; a_count += 1;
  //                 cursor := arg2; continue
  //
  // Phase 1b (walk row_b): identical to 1a but appends into
  //   scratch[a_count .. a_count + b_count).
  //
  // Phase 2 (build output row):
  //   tail := has_var_tail ? _rt_row_var() : _rt_row_empty()
  //   for j = (a_count + b_count - 1) down to 0:
  //     label := scratch[j]
  //     if _rt_row_select(tail, label, &dummy) == RT_OK:
  //       skip (duplicate)
  //     else:
  //       tail := _rt_row_extend(label, 0, tail)
  //       if tail == 0: return POOL_FULL
  //   return (tail << 32) | EU_OK
  //
  // The dedup via _rt_row_select is O(k^2) over the combined label
  // count (at most 32 x 32 = 1024 scans) which is acceptable at
  // typecheck time; the walk + build is bounded by the pool budget.
  //
  // Register map: 6 callee-save pushes (rbx=cursor/tail accumulator,
  // rbp=row_b, r12=a_count then j, r13=b_count then label,
  // r14=has_var_tail, r15=unused) + sub rsp, 24 (slot0=total count,
  // slot1=dummy out_type_idx for _rt_row_select, slot2=align pad) =
  // 72 B frame; entry rsp%16==8, after prologue (48 bytes of pushes
  // leaves rsp%16==8, +24 bytes of sub = +24 % 16 == 8, so
  // rsp%16==(8-8)%16==0) every nested CALL (_rt_find, _rt_row_empty,
  // _rt_row_var, _rt_row_select, _rt_row_extend) sees aligned stack.
  // Labels prefixed eu_un_.
  // ==========================================================================
  pub let _eu_unify : (u64, u64) -> u64 !{mem} @{} =
    fn (row_a: u64) (row_b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M4 (#2685): _eu_unify computes the JOIN (set union with ROW_VAR tail propagation) of two effect rows. 6 callee-save pushes (rbx=cursor/tail accumulator, rbp=row_b, r12=a_count then j in rebuild, r13=b_count then label in rebuild, r14=has_var_tail flag, r15=unused-but-preserved) + sub rsp,24 (slot0 at [rsp+0]=total count snapshot, slot1 at [rsp+8]=dummy out_type_idx for _rt_row_select, slot2 at [rsp+16]=align pad) = 72 B frame; entry rsp%16==8, after prologue rsp%16==0 and every nested CALL (_rt_find, _rt_row_empty, _rt_row_var, _rt_row_select, _rt_row_extend) sees aligned stack. Phase 1a walks row_a: loop (_rt_find; node_addr via shl/lea/add; mov_b kind; cmp != 4 -> KIND_MISMATCH; mov_b subkind; cmp == 0 EMPTY -> phase 1b; cmp == 2 VAR -> r14:=1, phase 1b; cmp == 1 EXT required else KIND_MISMATCH; cap r12 < 16 else TOO_MANY; load arg0 u32 label; scratch_addr = &_eu_label_scratch + r12*4 via shl r,2 + lea r11; mov_d store; r12+=1; load arg2 u32 as new cursor; loop). Phase 1b walks row_b identically but appends past r12 (scratch_offset = (r12+r13)*4); cap (r12+r13) < 32 else TOO_MANY. Phase 2 build: total := r12+r13 stored at [rsp+0]; call _rt_row_empty or _rt_row_var -> rbx=tail; if 0 POOL_FULL; j := total; r12:=j; r13:= label register. Rebuild loop: cmp r12,0 je done; r12-=1; load scratch[r12*4] into r13; call _rt_row_select(rbx, r13, [rsp+8]); if rax==0 duplicate skip; else call _rt_row_extend(r13, 0, rbx); if rax==0 POOL_FULL; rbx:=rax; loop. Done: pack (rbx<<32) | EU_OK. All cmp immediates (0, 1, 2, 4, 16, 32, status codes 0x4900..0x4907) fit imm32 with bit 31 clear. Byte loads via mov_b, u32 loads via mov_d, u32 stores via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed eu_un_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                          // cursor = row_a
        mov rbp, rsi;                          // rbp = row_b
        xor r12, r12;                          // a_count = 0
        xor r13, r13;                          // b_count = 0
        xor r14, r14;                          // has_var_tail = 0
        xor r15, r15;                          // reserved

        // ==================================================================
        // Phase 1a: walk row_a, collect labels, note tail flavour.
        // ==================================================================
      eu_un_walk_a_loop:
        mov rdi, rbx;
        call _rt_find;
        mov rbx, rax;

        // node_addr = &_hm_pool + rbx * 16.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Read kind byte.
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 4;                            // EU_KIND_TYROW
        jne eu_un_kind_mismatch;

        // Read subkind byte at +2.
        xor rcx, rcx;
        mov_b rcx, [r10 + 2];

        cmp rcx, 0;                            // ROW_EMPTY -> Phase 1b
        je  eu_un_walk_b_init;
        cmp rcx, 2;                            // ROW_VAR -> flag + Phase 1b
        je  eu_un_walk_a_var;
        cmp rcx, 1;                            // ROW_EXT
        jne eu_un_kind_mismatch;

        // Cap: a_count < 16.
        cmp r12, 16;                           // EU_MAX_LABELS_PER_ROW
        jae eu_un_too_many;

        // Load packed label id (arg0 u32).
        xor rax, rax;
        mov_d rax, [r10 + 4];

        // scratch_addr = &_eu_label_scratch + a_count * 4.
        mov r9, r12;
        shl r9, 2;
        lea r8, [rip + _eu_label_scratch];
        add r9, r8;
        mov_d [r9 + 0], rax;                   // scratch[a_count] = label

        add r12, 1;                            // a_count += 1

        // Advance cursor := arg2 (rest row).
        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov rbx, rax;
        jmp eu_un_walk_a_loop;

      eu_un_walk_a_var:
        mov r14, 1;                            // has_var_tail := 1
        jmp eu_un_walk_b_init;

        // ==================================================================
        // Phase 1b: walk row_b, append labels past a_count.
        // ==================================================================
      eu_un_walk_b_init:
        mov rbx, rbp;                          // cursor := row_b

      eu_un_walk_b_loop:
        mov rdi, rbx;
        call _rt_find;
        mov rbx, rax;

        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 4;
        jne eu_un_kind_mismatch;

        xor rcx, rcx;
        mov_b rcx, [r10 + 2];

        cmp rcx, 0;                            // ROW_EMPTY -> Phase 2
        je  eu_un_build;
        cmp rcx, 2;                            // ROW_VAR -> flag + Phase 2
        je  eu_un_walk_b_var;
        cmp rcx, 1;                            // ROW_EXT
        jne eu_un_kind_mismatch;

        // Cap: b_count < 16 (per-row).
        cmp r13, 16;                           // EU_MAX_LABELS_PER_ROW
        jae eu_un_too_many;

        // Cap: raw total < 32.
        mov rax, r12;
        add rax, r13;
        cmp rax, 32;                           // EU_MAX_RAW_LABELS
        jae eu_un_too_many;

        xor rax, rax;
        mov_d rax, [r10 + 4];                  // label

        // scratch_addr = &_eu_label_scratch + (a_count + b_count) * 4.
        mov r9, r12;
        add r9, r13;
        shl r9, 2;
        lea r8, [rip + _eu_label_scratch];
        add r9, r8;
        mov_d [r9 + 0], rax;

        add r13, 1;

        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov rbx, rax;
        jmp eu_un_walk_b_loop;

      eu_un_walk_b_var:
        mov r14, 1;
        jmp eu_un_build;

        // ==================================================================
        // Phase 2: build the join row.
        //
        // r12 = a_count, r13 = b_count at phase entry.
        // After tail allocation, r12 is reused as the countdown
        // index j; r13 is reused as the current label (preserved
        // across each _rt_row_select / _rt_row_extend call).
        // ==================================================================
      eu_un_build:
        // total = r12 + r13; stash at [rsp+0].
        mov rax, r12;
        add rax, r13;
        mov [rsp + 0], rax;

        // Allocate tail.
        cmp r14, 0;
        jne eu_un_build_var;

        call _rt_row_empty;
        jmp eu_un_build_check;

      eu_un_build_var:
        call _rt_row_var;

      eu_un_build_check:
        cmp rax, 0;
        je  eu_un_pool_full;
        mov rbx, rax;                          // tail accumulator

        // Load total back into r12 (now serves as countdown j).
        mov rax, [rsp + 0];
        mov r12, rax;

      eu_un_prepend_loop:
        cmp r12, 0;
        je  eu_un_done;

        sub r12, 1;                            // j = r12-1 (new r12 = j)

        // Load scratch[r12*4] into r13.
        mov r9, r12;
        shl r9, 2;
        lea r8, [rip + _eu_label_scratch];
        add r9, r8;
        xor rax, rax;
        mov_d rax, [r9 + 0];
        mov r13, rax;                          // label (preserved)

        // Dedup check: _rt_row_select(tail, label, &dummy).
        mov rdi, rbx;
        mov rsi, r13;
        lea rdx, [rsp + 8];                    // dummy out_type_idx
        call _rt_row_select;
        cmp rax, 0;                            // RT_OK -> duplicate
        je  eu_un_prepend_loop;

        // Not a duplicate: prepend ROW_EXT.
        mov rdi, r13;                          // label packed id
        xor rsi, rsi;                          // field_type_idx = 0
        mov rdx, rbx;                          // rest = current tail
        call _rt_row_extend;
        cmp rax, 0;
        je  eu_un_pool_full;
        mov rbx, rax;                          // tail = new ROW_EXT

        jmp eu_un_prepend_loop;

      eu_un_done:
        // Pack: (tail << 32) | EU_OK.
        mov rax, rbx;
        shl rax, 32;
        jmp eu_un_epilogue;

      eu_un_kind_mismatch:
        mov rax, 0x4900;                       // EU_ERR_KIND_MISMATCH
        jmp eu_un_epilogue;

      eu_un_pool_full:
        mov rax, 0x4901;                       // EU_ERR_POOL_FULL
        jmp eu_un_epilogue;

      eu_un_too_many:
        mov rax, 0x4905;                       // EU_ERR_TOO_MANY
        jmp eu_un_epilogue;

      eu_un_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _eu_check_rank(scheme_ptr, scheme_len) -> status
  //
  //   rdi = scheme_ptr      (byte pointer to a HmCore scheme stream)
  //   rsi = scheme_len      (byte length of the scheme)
  //   rax = EU_OK (0) or EU_ERR_BAD_SCHEME (0x4903) /
  //         EU_ERR_RANK_RESTRICTED_VIOLATION (0x4902)
  //
  // Validate a HmCore scheme byte stream against the P10 rank
  // restriction: "type schemes may bind row variables only at the
  // OUTERMOST arrow; nested rows cannot generalize".
  //
  // At M4, the HmCore wire format carries a SINGLE outer ∀, so by
  // construction every row-var declared in `bound_var_ids` is at
  // the outermost quantifier level. The check therefore reduces to
  // a well-formedness validation:
  //
  //   1. scheme_len >= 8 (header fits).
  //   2. n_bound_vars <= EU_SCHEME_MAX_BOUND (64).
  //   3. n_body_nodes in [1 .. EU_SCHEME_MAX_BODY (128)].
  //   4. scheme_len == 8 + 4*n_bound_vars + 16*n_body_nodes.
  //   5. Every body node's kind byte is in {TYVAR=1, TYCON=2,
  //      TYAPP=3, TYROW=4}.
  //
  // Any violation returns EU_ERR_BAD_SCHEME. The
  // RANK_RESTRICTED_VIOLATION code is reserved for the M4.1
  // wire-format extension that lands nested-quantifier body nodes
  // (a new kind byte, e.g. HM_KIND_FORALL = 5, with its own bound-
  // var list); THIS pass learns to descend into the inner scheme
  // and refuse any bound-var declaration on the inner level.
  //
  // Pure byte walker over caller data -- no callee-save push, no
  // stack frame, no nested CALL. Labels prefixed eu_cr_.
  // ==========================================================================
  pub let _eu_check_rank : (u64, u64) -> u64 !{mem} @{} =
    fn (scheme_ptr: u64) (scheme_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M4 (#2685): _eu_check_rank validates a HmCore scheme byte stream against the P10 rank restriction. Pure byte walker over caller data; zero callee-save pushes; no stack frame; no nested CALL. Flow: (1) rsi (scheme_len) >= 8 else BAD_SCHEME; (2) load n_bound_vars via `xor rax,rax; mov_d rax,[rdi+0]`; cmp > 64 BAD_SCHEME (RANK_RESTRICTED_VIOLATION reserved for M4.1 nested-quantifier form); (3) load n_body_nodes via `xor rcx,rcx; mov_d rcx,[rdi+4]`; cmp == 0 BAD_SCHEME; cmp > 128 BAD_SCHEME; (4) expected_len = 8 + 4*n_bound + 16*n_body; compare == rsi; r9 computes expected: r9 := rax; shl r9,2; add r9,rcx<<4 by `mov r10,rcx; shl r10,4; add r9,r10`; add r9,8; cmp r9 == rsi else BAD_SCHEME; (5) body_offset = 8 + 4*n_bound; body_offset computed via r8 := rax; shl r8,2; add r8,8. For i = 0..n_body: node_addr = rdi + body_offset + i*16; load kind byte via `xor rdx,rdx; mov_b rdx,[node_addr]`; cmp in {1,2,3,4} else BAD_SCHEME. Return EU_OK. All cmp immediates (0, 1, 2, 3, 4, 8, 64, 128, status codes 0x4902/0x4903) fit imm32 with bit 31 clear. Byte load via `xor r,r; mov_b r,[base + idx * 1]` (paideia-as #1248 mitigation). u32 loads via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed eu_cr_.",
      block: {
        // (1) scheme_len >= 8 (header).
        cmp rsi, 8;                            // EU_SCHEME_HDR_BYTES
        jb  eu_cr_bad_scheme;

        // (2) Load n_bound_vars.
        xor rax, rax;
        mov_d rax, [rdi + 0];                  // n_bound_vars u32
        cmp rax, 64;                           // EU_SCHEME_MAX_BOUND
        ja  eu_cr_bad_scheme;

        // (3) Load n_body_nodes.
        xor rcx, rcx;
        mov_d rcx, [rdi + 4];                  // n_body_nodes u32
        cmp rcx, 0;
        je  eu_cr_bad_scheme;
        cmp rcx, 128;                          // EU_SCHEME_MAX_BODY
        ja  eu_cr_bad_scheme;

        // (4) expected_len = 8 + 4*n_bound + 16*n_body.
        //   r9 = 4 * n_bound.
        mov r9, rax;
        shl r9, 2;
        //   r10 = 16 * n_body.
        mov r10, rcx;
        shl r10, 4;
        add r9, r10;
        add r9, 8;
        cmp r9, rsi;
        jne eu_cr_bad_scheme;

        // (5) Walk body nodes; validate kind bytes.
        //   body_offset = 8 + 4*n_bound; stash in r8.
        mov r8, rax;
        shl r8, 2;
        add r8, 8;

        //   i = 0 in r9; n_body in rcx.
        xor r9, r9;

      eu_cr_body_loop:
        cmp r9, rcx;
        jae eu_cr_ok;

        // node_addr = rdi + r8 + r9 * 16.
        //   r10 = r9 * 16; r10 += r8; r11 = rdi + r10.
        mov r10, r9;
        shl r10, 4;
        add r10, r8;
        mov r11, rdi;
        add r11, r10;

        // Load kind byte.
        xor rdx, rdx;
        mov_b rdx, [r11 + 0];
        cmp rdx, 1;                            // EU_HM_KIND_TYVAR
        je  eu_cr_body_next;
        cmp rdx, 2;                            // EU_HM_KIND_TYCON
        je  eu_cr_body_next;
        cmp rdx, 3;                            // EU_HM_KIND_TYAPP
        je  eu_cr_body_next;
        cmp rdx, 4;                            // EU_KIND_TYROW
        je  eu_cr_body_next;
        jmp eu_cr_bad_scheme;

      eu_cr_body_next:
        add r9, 1;
        jmp eu_cr_body_loop;

      eu_cr_ok:
        xor rax, rax;                          // EU_OK
        ret;

      eu_cr_bad_scheme:
        mov rax, 0x4903;                       // EU_ERR_BAD_SCHEME
        ret;
      }
    }

  // ==========================================================================
  // _eu_least(rows_ptr, n) -> packed_u64
  //
  //   rdi = rows_ptr        (ptr to a u32 array of n row pool_idx values)
  //   rsi = n               (count; 0..EU_MAX_JOIN_ARITY (16))
  //   rax = (joined_row_ref << 32) | status
  //
  // Fold `_eu_unify` across N rows. The join operation is
  // associative and commutative (set union with ROW_VAR tail
  // propagation), so the fold order is irrelevant; this entry is a
  // convenience that saves N-1 call sites in the typechecker
  // driver.
  //
  // Algorithm:
  //   if n == 0: return (0 << 32) | EU_ERR_EMPTY_ARRAY
  //   if n > EU_MAX_JOIN_ARITY: return (0 << 32) | EU_ERR_TOO_MANY
  //   acc := rows[0]
  //   for i = 1..n:
  //     r := rows[i]
  //     (acc_new, status) := _eu_unify(acc, r)
  //     if status != EU_OK: return (0 << 32) | status
  //     acc := acc_new
  //   return (acc << 32) | EU_OK
  //
  // Register map: 4 callee-save pushes (rbx=rows_ptr, rbp=n, r12=i,
  // r13=acc) + sub rsp, 8 (align) = 40 B frame; entry rsp%16==8,
  // after prologue rsp%16==(8 - 4*8 - 8)%16==(8 - 40)%16==0 and the
  // single nested CALL to `_eu_unify` sees aligned stack. Labels
  // prefixed eu_le_.
  // ==========================================================================
  pub let _eu_least : (u64, u64) -> u64 !{mem} @{} =
    fn (rows_ptr: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M4 (#2685): _eu_least folds _eu_unify across N effect rows. 4 callee-save pushes (rbx=rows_ptr, rbp=n, r12=i, r13=acc) + sub rsp,8 align = 40 B frame; entry rsp%16==8, after prologue rsp%16==0 and the single nested CALL to _eu_unify sees aligned stack. Flow: (1) cmp rsi,0 je empty_array (return 0x4904 low 32); (2) cmp rsi, 16 ja too_many (return 0x4905 low 32); (3) load acc = rows[0] via `xor rax,rax; mov_d rax,[rbx+0]`; r13 := rax. (4) r12 := 1 (i=1). Loop: cmp r12, rbp jae done; load r_i via `xor rax,rax; mov_d rax,[rbx + r12*4]` (reg+reg*4 scaled form; r12 is callee-save survived, no spill needed); call _eu_unify(r13, rax); extract status via `mov rcx,rax; shl rcx,32; shr rcx,32`; cmp rcx,0 jne bubble (pack 0 << 32 | rcx); extract new acc via `shr rax,32`; r13:=rax; r12+=1; loop. Done: pack (r13 << 32) | EU_OK. All cmp immediates (0, 16, status codes 0x4904/0x4905) fit imm32 with bit 31 clear. u32 loads via mov_d (zero-extends). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed eu_le_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                          // rows_ptr
        mov rbp, rsi;                          // n

        // (1) n == 0 -> EMPTY_ARRAY.
        cmp rbp, 0;
        je  eu_le_empty_array;

        // (2) n > 16 -> TOO_MANY.
        cmp rbp, 16;                           // EU_MAX_JOIN_ARITY
        ja  eu_le_too_many;

        // (3) acc = rows[0].
        xor rax, rax;
        mov_d rax, [rbx + 0];
        mov r13, rax;                          // r13 = acc

        // (4) i = 1.
        mov r12, 1;

      eu_le_loop:
        cmp r12, rbp;
        jae eu_le_done;

        // r_i = rows[i]; scratch_addr = rows_ptr + i*4.
        mov r9, r12;
        shl r9, 2;
        add r9, rbx;
        xor rax, rax;
        mov_d rax, [r9 + 0];                   // r_i

        // _eu_unify(acc, r_i).
        mov rdi, r13;                          // acc
        mov rsi, rax;                          // r_i
        call _eu_unify;

        // Extract status (low 32).
        mov rcx, rax;
        shl rcx, 32;
        shr rcx, 32;
        cmp rcx, 0;
        jne eu_le_bubble;

        // Extract new acc (high 32).
        shr rax, 32;
        mov r13, rax;

        add r12, 1;
        jmp eu_le_loop;

      eu_le_done:
        // Pack: (acc << 32) | EU_OK.
        mov rax, r13;
        shl rax, 32;
        jmp eu_le_epilogue;

      eu_le_bubble:
        // rcx holds the inner status; rax low 32 is also status + high 32
        // may hold the inner's partial pack. Return (0 << 32) | status so
        // the caller sees a clean error pack without a stale row ref.
        mov rax, rcx;
        jmp eu_le_epilogue;

      eu_le_empty_array:
        mov rax, 0x4904;                       // EU_ERR_EMPTY_ARRAY
        jmp eu_le_epilogue;

      eu_le_too_many:
        mov rax, 0x4905;                       // EU_ERR_TOO_MANY
        jmp eu_le_epilogue;

      eu_le_epilogue:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
