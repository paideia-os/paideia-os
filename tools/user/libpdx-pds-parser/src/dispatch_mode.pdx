// src/dispatch_mode.pdx -- libpdx-pds-parser.R222.M6 (paideia-os#2663)
//
// DispatchMode: light vs heavy dispatch classifier + indirector.
// R222.M6 of the cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1..M5 landed the four per-command signature parsers and the
// per-session registry client. R222.M6 (THIS module) sits on top of
// that stack: at every REPL dispatch the framework reads a command's
// declared resource needs from its `CommandSig` record and decides
// whether to elaborate the functor IN-PROCESS (LIGHT) or SPAWN a
// separate process (HEAVY). The actual invocation flows through two
// disjoint weak-import `.bss` function-pointer slots the kernel-side
// substrate publishes at session boot.
//
// The resource-need declaration lives in a `resource_mask` u32 at
// offset 84 of the CommandSigHeader (R222.M2 ABI). R222.M2 reserved
// the 44-byte tail at `[CS_HEADER + 84 .. +128)` "for R222.M3+
// (effect-row id, cap-row id, source span, etc.)"; THIS landing
// claims the first 4 bytes without disturbing any R222.M2..M5 reader
// of the header. See `design/shell/light-heavy-dispatch.md` §1 for
// the layout rationale.
//
// Bit layout of `resource_mask`:
//
//     bit 0  FS_READ        reads filesystem bytes
//     bit 1  FS_WRITE       writes filesystem bytes
//     bit 2  NET            makes outbound network connections
//     bit 3  EXEC           invokes other processes
//     bit 4  LONG_RUNNING   may run past the shell's per-turn deadline
//     bit 5  HIGH_MEM       retains a large working set
//
// Classification rule:
//
//     DM_HEAVY_MASK = NET | EXEC | LONG_RUNNING | HIGH_MEM = 0x3C
//     LIGHT iff (resource_mask & DM_HEAVY_MASK) == 0
//     HEAVY otherwise
//
// This simplifies the brief's two-condition shape ("`resource_mask ==
// 0` OR `resource_mask & 0x3C == 0`") because the first condition is
// subsumed by the second: `0 & 0x3C == 0`.
//
// The classifier is a pure leaf; one `and r, imm8` + one branch. The
// imm8 variant of `and` is permitted (per feedback_pdx_encoder_pitfalls
// -- "name-length mask / bit tests use imm8 variants only"; precedent
// grapheme_iter.pdx line 335 `and r11, 0xFF`).
//
// =============================================================================
// WEAK-IMPORT SEAMS
// =============================================================================
//
// Two `.bss` function-pointer slots, nil at session boot:
//
//     _dm_light_fn   : u64    in-process invoker ptr (0 = unregistered)
//     _dm_spawn_fn   : u64    spawn invoker ptr (0 = unregistered)
//
// Both match the R133.M5 `_tcg_check_fn` / R133.M6 `_sc_dispatch_fn`
// precedent byte-for-byte (`script_cmd.pdx` lines 435, 497). The pdx
// dialect lacks linker-level weak imports; the function-pointer slot
// is the convention. Two one-shot registration primitives publish
// each; both reject `fn_ptr == 0` with DM_ERR_NULL_FN.
//
// Dispatcher ABI (both slots share):
//
//     fn_ptr(cs_body, cs_len, mat_body, mat_len) -> u64
//         returns 0 on success, non-zero errno on failure.
//
// The caller passes:
//   * cs_body / cs_len   -- the CommandSig record (R222.M2 output).
//   * mat_body / mat_len -- the FunctorInstance materialization record
//                           (R222.M3 output) with elaborated args.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _dm_init() -> ()
//     Idempotent boot. Clears both weak-import slots and the three
//     decision counters. .bss zero-init at program load already
//     satisfies this; the explicit init supports a test harness
//     that wants to reset counters between runs. Pure leaf.
//
//   _dm_register_light(fn_ptr) -> u64
//     Publishes fn_ptr into _dm_light_fn. Returns DM_OK on OK,
//     DM_ERR_NULL_FN (0x4803) on nil.
//
//   _dm_register_spawn(fn_ptr) -> u64
//     Publishes fn_ptr into _dm_spawn_fn. Returns DM_OK on OK,
//     DM_ERR_NULL_FN (0x4803) on nil.
//
//   _dm_classify(cs_body, cs_len) -> u64
//     Validates the CommandSig record, loads resource_mask u32 at
//     [cs_body + 84], ANDs with DM_HEAVY_MASK (0x3C) and returns
//     DM_LIGHT (0) iff the result is 0; DM_HEAVY (1) otherwise.
//     On invalid record: DM_ERR_BAD_RECORD (0x4800). Pure leaf.
//
//   _dm_dispatch(cs_body, cs_len, mat_body, mat_len) -> packed_u64
//     Classify, bump the matching decision counter, indirect-call
//     the matching weak-import slot. Returns:
//        bits [15: 0]  status   (DM_OK or DM_ERR_*)
//        bit  [16]     decision (0 = LIGHT, 1 = HEAVY)
//        bits [63:32]  downstream errno on *_FAILED paths; 0 else.
//
// Register maps (SysV):
//
//   _dm_init()                                       -> rax (ignored)
//   _dm_register_light(rdi)                          -> rax
//   _dm_register_spawn(rdi)                          -> rax
//   _dm_classify(rdi, rsi)                           -> rax
//   _dm_dispatch(rdi, rsi, rdx, rcx)                 -> rax
//
// =============================================================================
// FINGERPRINT SURFACE (per `design/shell/light-heavy-dispatch.md` §6)
// =============================================================================
//
// Three u64 .bss counters record the dispatch sequence a session has
// observed:
//
//   _dm_light_count    bumped on each DM_LIGHT dispatch
//   _dm_heavy_count    bumped on each DM_HEAVY dispatch
//   _dm_last_decision  1 = LIGHT, 2 = HEAVY, 0 = never dispatched
//
// A smoke-mode asserter observes the counters to anchor the 4-command
// acceptance test. The counters are session-local; `_dm_init` resets
// them.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the lone `and` immediate is 0x3C which
//     fits imm8 with bit 7 clear (precedent: grapheme_iter.pdx:335
//     `and r11, 0xFF`).
//   - No 2-op `imul r, imm` -- this module performs no multiply.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `DispatchMode` matches `dispatch_mode.pdx`.
//   - Labels prefixed `dm_` (grep-confirmed unique against the
//     parser-tier modules: u8n_, gi_, wp_, cl_, sch_sig_, cmd_sig_,
//     fi_, afs_, cmdreg_, pl_, rp_, ll_, cc_, er_, cr_, hm_, rt_,
//     dl_, se_, te_, ls_, ast_). The lone `dm_*` labels in the
//     tree (`dm_pud_divide_setup`, `dm_fail` in src/user/dmesg.pdx)
//     are function-scoped so they do not share a linker-visible
//     namespace. Never bare `loop`/`if`/`let`/`fn`/`ret`/`done`.
//   - All `cmp reg, imm` immediates (0, 1, 64, 128, 0x3C, status
//     codes 0x4800..0x4806, magic 0x47495343) fit imm32 with bit
//     31 clear -- 0x47495343 is below the imm32 sign-extension
//     boundary (< 0x80000000) so `cmp rax, 0x47495343` is safe.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx]`
//     (zero-extends into the full qword).
//   - u32 loads via `mov_d rN, [base + disp]` (precedent:
//     arg_flag_spec.pdx:1703 `mov_d rax, [rbx + 0]`).
//   - u64 .bss reads via `lea r11, [rip + sym]; mov rax, [r11]`
//     (precedent: cmd_registry.pdx:379).
//   - u64 .bss writes via `lea r11, [rip + sym]; mov [r11], rax`.
//   - Indirect CALL via `mov rax, [slot_ptr]; call rax` (precedent:
//     script_cmd.pdx:660).
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
// r11 is clobbered by every nested CALL. Values that must survive
// a nested CALL live in r12..r15 or in .bss.
//
//   _dm_init                  pure leaf.
//   _dm_classify              pure leaf.
//   _dm_register_light        pure leaf (no nested CALL).
//   _dm_register_spawn        pure leaf (no nested CALL).
//   _dm_dispatch              4 callee-save pushes + sub rsp, 8 pad
//                             = 40 B frame; entry rsp%16==8, +32
//                             pushes = %16==8, +8 pad = %16==0 at
//                             the nested CALL into _dm_classify and
//                             at the indirect CALL through the
//                             weak-import slot.
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// .bss zero-init at program load naturally gives every slot the
// correct initial value (0 for the two function pointers; 0 for
// each counter; 0 for `_dm_last_decision`). Unlike R222.M5
// CmdRegistry (which maintains a `_cmdreg_init_state` sentinel to
// avoid re-zero-filling a 6 KiB table), this module's state is
// four scalar u64 slots, so there is no zero-fill cost to amortize
// and no sentinel is kept. `_dm_init` just writes zeros to all four
// slots; the hot path (`_dm_classify` / `_dm_dispatch`) does not
// call it.
//
// =============================================================================
// Upstream: paideia-os#2663 (THIS ticket, R222.M6). Substrate:
// paideia-os#2659 (R222.M2 CommandSig). Design doc:
// design/shell/light-heavy-dispatch.md. Related:
// design/shell/cmd-functor-command-sig.md (the record this module
// reads resource_mask from), design/shell/command-registry-client.md
// (the R222.M5 registry client that produces the cs_body_ref the
// dispatcher classifies), src/kernel/core/pds/script_cmd.pdx (the
// R133.M6 weak-import precedent this module's _dm_*_fn slots mirror
// byte-for-byte).

module DispatchMode = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES
  // ==========================================================================
  //
  // Band 0x4800..0x48FF, carved on a kilo-step boundary past the
  // Wave-122 bands (R221.M5 Ast 0x4400..0x44FF; R222.M5 CmdRegistry
  // 0x4500..0x45FF; R224.M5 LetScope 0x4600..0x46FF) with 0x4700..
  // 0x47FF reserved for the parallel Wave-123 R221.M6 arm. Seven
  // slots used; 0x4807..0x48FF reserved for M6.1+ follow-ups.

  pub let DM_OK                   : u64 = 0
  pub let DM_LIGHT                : u64 = 0
  pub let DM_HEAVY                : u64 = 1

  pub let DM_ERR_BAD_RECORD       : u64 = 0x4800
  pub let DM_ERR_NO_LIGHT_FN      : u64 = 0x4801
  pub let DM_ERR_NO_SPAWN_FN      : u64 = 0x4802
  pub let DM_ERR_NULL_FN          : u64 = 0x4803
  pub let DM_ERR_LIGHT_FAILED     : u64 = 0x4804
  pub let DM_ERR_SPAWN_FAILED     : u64 = 0x4805
  pub let DM_ERR_BAD_MAT          : u64 = 0x4806

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  // Resource-mask bits (R222.M6 ABI).
  pub let DM_BIT_FS_READ          : u64 = 0x01
  pub let DM_BIT_FS_WRITE         : u64 = 0x02
  pub let DM_BIT_NET              : u64 = 0x04
  pub let DM_BIT_EXEC             : u64 = 0x08
  pub let DM_BIT_LONG_RUNNING     : u64 = 0x10
  pub let DM_BIT_HIGH_MEM         : u64 = 0x20

  // Heavy mask: NET | EXEC | LONG_RUNNING | HIGH_MEM.
  pub let DM_HEAVY_MASK           : u64 = 0x3C

  // CommandSig geometry (R222.M2 ABI).
  pub let DM_CS_HEADER_BYTES      : u64 = 128
  pub let DM_CS_OFF_MAGIC         : u64 = 0
  pub let DM_CS_OFF_RESOURCE_MASK : u64 = 84
  pub let DM_CS_MAGIC             : u64 = 0x47495343   // 'CSIG' LE

  // FunctorInstance geometry (R222.M3 ABI; minimum header size).
  pub let DM_FI_HEADER_BYTES_MIN  : u64 = 64

  // Dispatch result pack.
  pub let DM_DECISION_SHIFT       : u64 = 16

  // Decision sentinel values (for _dm_last_decision; DM_LIGHT=0
  // collides with "never dispatched", so this module stores
  // 1 for LIGHT and 2 for HEAVY in that slot).
  pub let DM_SENTINEL_LIGHT       : u64 = 1
  pub let DM_SENTINEL_HEAVY       : u64 = 2

  // ==========================================================================
  // SECTION 3 -- STATIC STATE
  // ==========================================================================
  //
  // Four u64 scalars + no table. .bss zero-init at program load
  // naturally gives every slot the correct initial value.

  pub let mut _dm_light_fn        : u64 = uninit @align(8)
  pub let mut _dm_spawn_fn        : u64 = uninit @align(8)
  pub let mut _dm_light_count     : u64 = uninit @align(8)
  pub let mut _dm_heavy_count     : u64 = uninit @align(8)
  pub let mut _dm_last_decision   : u64 = uninit @align(8)

  // ==========================================================================
  // _dm_init() -> ()
  //
  //   Clears every slot (both weak-import fn pointers and all three
  //   decision counters). .bss zero-init at program load already
  //   gives the correct boot state; this entry point exists so a
  //   test harness can reset counters between runs without rebooting
  //   the process.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dm_init_.
  // ==========================================================================
  pub let _dm_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M6 (#2663): _dm_init clears the five u64 scalar .bss slots (_dm_light_fn, _dm_spawn_fn, _dm_light_count, _dm_heavy_count, _dm_last_decision). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Each slot is written to zero via `xor rax, rax; lea r11, [rip + sym]; mov [r11], rax`. .bss zero-init at program load already satisfies the boot semantic; this routine exists for test-time resets. All five slots are u64 scalars; no sentinel is maintained (precedent: let_scope.pdx _ls_init which also relies on .bss zero-init). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dm_init_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _dm_light_fn];
        mov [r11], rax;

        lea r11, [rip + _dm_spawn_fn];
        mov [r11], rax;

        lea r11, [rip + _dm_light_count];
        mov [r11], rax;

        lea r11, [rip + _dm_heavy_count];
        mov [r11], rax;

        lea r11, [rip + _dm_last_decision];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _dm_register_light(fn_ptr) -> errno
  //
  //   rdi = fn_ptr (user-space in-process invoker)
  //   rax = DM_OK (0) on OK; DM_ERR_NULL_FN (0x4803) on nil.
  //
  // Publishes `fn_ptr` into `_dm_light_fn`. Mirrors
  // `_pds_sc_register_dispatcher` (script_cmd.pdx:482) minus the
  // klog_s1 emit (user-space has no klog surface).
  //
  // Pure leaf -- no nested CALL. Labels prefixed dm_rl_.
  // ==========================================================================
  pub let _dm_register_light : (u64) -> u64 !{mem} @{} =
    fn (fn_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M6 (#2663): publish the in-process invoker's entry address into the module-level _dm_light_fn registration slot. Pure leaf; no callee-save push; no stack frame; no nested CALL. Mirrors _pds_sc_register_dispatcher (script_cmd.pdx:482) minus the klog_s1 emit (user-space has no klog surface). Guard: cmp rdi, 0 je dm_rl_null -- nil fn_ptr returns DM_ERR_NULL_FN (0x4803) without touching the slot. Else: lea r11, [rip + _dm_light_fn]; mov [r11], rdi; xor rax, rax (DM_OK). Status 0x4803 fits imm32 sign-ext safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dm_rl_.",
      block: {
        cmp rdi, 0;
        je  dm_rl_null;

        lea r11, [rip + _dm_light_fn];
        mov [r11], rdi;

        xor rax, rax;                          // DM_OK
        ret;

      dm_rl_null:
        mov rax, 0x4803;                       // DM_ERR_NULL_FN
        ret;
      }
    }

  // ==========================================================================
  // _dm_register_spawn(fn_ptr) -> errno
  //
  //   rdi = fn_ptr (user-space spawn invoker)
  //   rax = DM_OK (0) on OK; DM_ERR_NULL_FN (0x4803) on nil.
  //
  // Publishes `fn_ptr` into `_dm_spawn_fn`. Symmetric with
  // `_dm_register_light`.
  //
  // Pure leaf -- no nested CALL. Labels prefixed dm_rs_.
  // ==========================================================================
  pub let _dm_register_spawn : (u64) -> u64 !{mem} @{} =
    fn (fn_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M6 (#2663): publish the spawn-side invoker's entry address into the module-level _dm_spawn_fn registration slot. Pure leaf; no callee-save push; no stack frame; no nested CALL. Symmetric with _dm_register_light. Guard: cmp rdi, 0 je dm_rs_null -- nil fn_ptr returns DM_ERR_NULL_FN (0x4803) without touching the slot. Else: lea r11, [rip + _dm_spawn_fn]; mov [r11], rdi; xor rax, rax (DM_OK). Status 0x4803 fits imm32 sign-ext safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dm_rs_.",
      block: {
        cmp rdi, 0;
        je  dm_rs_null;

        lea r11, [rip + _dm_spawn_fn];
        mov [r11], rdi;

        xor rax, rax;                          // DM_OK
        ret;

      dm_rs_null:
        mov rax, 0x4803;                       // DM_ERR_NULL_FN
        ret;
      }
    }

  // ==========================================================================
  // _dm_classify(cs_body, cs_len) -> decision_or_err
  //
  //   rdi = cs_body (CommandSig record, R222.M2 output)
  //   rsi = cs_len  (byte length of the record)
  //   rax = DM_LIGHT (0) | DM_HEAVY (1) | DM_ERR_BAD_RECORD (0x4800)
  //
  // Flow:
  //   1. Validate cs_body != 0 AND cs_len >= 128 (DM_CS_HEADER_BYTES).
  //   2. Load magic u32 at [cs_body + 0] (zero-ext); compare 'CSIG'
  //      (0x47495343); mismatch -> DM_ERR_BAD_RECORD.
  //   3. Load resource_mask u32 at [cs_body + 84] (zero-ext).
  //   4. AND with DM_HEAVY_MASK (0x3C, imm8).
  //   5. Return DM_HEAVY iff ANDed value non-zero; else DM_LIGHT.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: r8 = cs_body, r9 = cs_len, rax = scratch.
  // Labels prefixed dm_cl_.
  // ==========================================================================
  pub let _dm_classify : (u64, u64) -> u64 !{mem} @{} =
    fn (cs_body: u64) (cs_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M6 (#2663): _dm_classify validates the CommandSig record and reads resource_mask at offset 84 to decide LIGHT (0) vs HEAVY (1). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Register plan: r8 = cs_body, r9 = cs_len, rax = scratch for the magic/mask loads and compares. Flow: cmp r8, 0 je dm_cl_bad; cmp r9, 128 jb dm_cl_bad (DM_CS_HEADER_BYTES). Load magic u32 via xor rax,rax; mov_d rax, [r8 + 0]; cmp rax, 0x47495343 jne dm_cl_bad (DM_CS_MAGIC). Load resource_mask u32 via xor rax,rax; mov_d rax, [r8 + 84] (DM_CS_OFF_RESOURCE_MASK). and rax, 0x3C (imm8 variant; DM_HEAVY_MASK = NET|EXEC|LONG_RUNNING|HIGH_MEM). cmp rax, 0 je dm_cl_light. Return DM_HEAVY (1) via mov rax, 1. dm_cl_light returns xor rax,rax (DM_LIGHT = 0). dm_cl_bad returns mov rax, 0x4800 (DM_ERR_BAD_RECORD). All cmp immediates (0, 128, 0x47495343, 0x4800) fit imm32 with bit 31 clear -- 0x47495343 < 0x80000000 so sign-extension is safe. The 0x3C mask fits imm8 (bit 7 clear); the imm8 variant of `and r64, imm8` is permitted per feedback_pdx_encoder_pitfalls (precedent: grapheme_iter.pdx:335 `and r11, 0xFF`). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dm_cl_.",
      block: {
        mov r8, rdi;                           // cs_body
        mov r9, rsi;                           // cs_len

        // (I1) cs_body != 0.
        cmp r8, 0;
        je  dm_cl_bad;

        // (I2) cs_len >= DM_CS_HEADER_BYTES (128).
        cmp r9, 128;
        jb  dm_cl_bad;

        // (I3) magic u32 at [cs_body + 0] == 0x47495343 ('CSIG').
        xor rax, rax;
        mov_d rax, [r8 + 0];
        cmp rax, 0x47495343;                   // DM_CS_MAGIC
        jne dm_cl_bad;

        // Load resource_mask u32 at [cs_body + 84].
        xor rax, rax;
        mov_d rax, [r8 + 84];                  // DM_CS_OFF_RESOURCE_MASK

        // Isolate the heavy bits (NET | EXEC | LONG_RUNNING | HIGH_MEM).
        and rax, 0x3C;                         // DM_HEAVY_MASK (imm8)
        cmp rax, 0;
        je  dm_cl_light;

        mov rax, 1;                            // DM_HEAVY
        ret;

      dm_cl_light:
        xor rax, rax;                          // DM_LIGHT (0)
        ret;

      dm_cl_bad:
        mov rax, 0x4800;                       // DM_ERR_BAD_RECORD
        ret;
      }
    }

  // ==========================================================================
  // _dm_dispatch(cs_body, cs_len, mat_body, mat_len) -> packed_u64
  //
  //   rdi = cs_body
  //   rsi = cs_len
  //   rdx = mat_body (FunctorInstance materialization, R222.M3 output)
  //   rcx = mat_len
  //   rax = packed:
  //         bits [15: 0]  status   (DM_OK / DM_ERR_*)
  //         bit  [16]     decision (0 = LIGHT, 1 = HEAVY)
  //         bits [63:32]  downstream errno on *_FAILED paths; 0 else.
  //
  // Flow:
  //   1. Validate mat_body != 0 AND mat_len >= 64 (DM_FI_HEADER_BYTES_MIN).
  //      On fail: pack DM_ERR_BAD_MAT (0x4806) with decision=0, errno=0.
  //   2. Classify via _dm_classify. Propagate DM_ERR_BAD_RECORD.
  //   3. Bump _dm_light_count or _dm_heavy_count by 1; write
  //      _dm_last_decision := 1 (LIGHT) or 2 (HEAVY).
  //   4. Load the matching weak-import slot. Nil -> DM_ERR_NO_LIGHT_FN
  //      (0x4801) or DM_ERR_NO_SPAWN_FN (0x4802) with decision packed.
  //   5. Indirect-call the slot with (cs_body, cs_len, mat_body,
  //      mat_len). On return 0: pack DM_OK with decision. On non-zero:
  //      pack DM_ERR_LIGHT_FAILED (0x4804) / DM_ERR_SPAWN_FAILED
  //      (0x4805) with the dispatcher's errno in bits [63:32].
  //
  // Frame: 4 callee-save pushes (rbx = cs_body, r12 = cs_len,
  // r13 = mat_body, r14 = mat_len) + sub rsp, 8 pad = 40 B frame;
  // entry rsp%16==8, +32 pushes = %16==8, +8 pad = %16==0 at every
  // nested CALL (one into _dm_classify leaf, one indirect to the
  // registered slot).
  //
  // Labels prefixed dm_dsp_.
  // ==========================================================================
  pub let _dm_dispatch : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (cs_body: u64) (cs_len: u64) (mat_body: u64) (mat_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M6 (#2663): _dm_dispatch classifies the CommandSig record, bumps the matching decision counter, and indirect-calls the matching weak-import slot (_dm_light_fn or _dm_spawn_fn) with (cs_body, cs_len, mat_body, mat_len). 4 callee-save pushes (rbx = cs_body, r12 = cs_len, r13 = mat_body, r14 = mat_len) + sub rsp, 8 pad = 40 B frame; entry rsp%16==8, +32 pushes = %16==8, +8 pad = %16==0 at every nested CALL. Flow: cmp r13, 0 je dm_dsp_bad_mat; cmp r14, 64 jb dm_dsp_bad_mat (DM_FI_HEADER_BYTES_MIN). mov rdi, rbx; mov rsi, r12; call _dm_classify -> rax. cmp rax, 0x4800 je dm_dsp_bad_record. cmp rax, 1 je dm_dsp_heavy_path. Light path: bump _dm_light_count via lea r11+mov+add 1+mov; write _dm_last_decision := 1 (DM_SENTINEL_LIGHT); load _dm_light_fn via lea r11, [rip + _dm_light_fn]; mov rax, [r11]; cmp rax, 0 je dm_dsp_no_light_fn. Set up args: mov rdi, rbx; mov rsi, r12; mov rdx, r13; mov rcx, r14. Indirect call: call rax. Pack return: on rax == 0 return DM_OK | (0 << 16) via xor rax,rax; on rax != 0 pack (errno << 32) | (0 << 16) | DM_ERR_LIGHT_FAILED (0x4804) via shl rax, 32; or rax, 0x4804. Heavy path: symmetric with _dm_heavy_count, DM_SENTINEL_HEAVY (2), _dm_spawn_fn, DM_ERR_NO_SPAWN_FN (0x4802), DM_ERR_SPAWN_FAILED (0x4805), and decision bit 16 set via or rax, 0x10000. All cmp immediates (0, 1, 64, 0x4800, 0x4801, 0x4802, 0x4804, 0x4805, 0x4806) fit imm32 with bit 31 clear. Byte / u32 loads via xor+mov_d; u64 .bss writes via lea+mov. Indirect CALL via mov rax, [slot_ptr]; call rax (precedent: script_cmd.pdx:660). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dm_dsp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                          // cs_body
        mov r12, rsi;                          // cs_len
        mov r13, rdx;                          // mat_body
        mov r14, rcx;                          // mat_len

        // (I1) mat_body != 0 AND mat_len >= 64.
        cmp r13, 0;
        je  dm_dsp_bad_mat;
        cmp r14, 64;                           // DM_FI_HEADER_BYTES_MIN
        jb  dm_dsp_bad_mat;

        // Classify.
        mov rdi, rbx;
        mov rsi, r12;
        call _dm_classify;

        // Propagate DM_ERR_BAD_RECORD.
        cmp rax, 0x4800;                       // DM_ERR_BAD_RECORD
        je  dm_dsp_bad_record;

        // Branch on decision.
        cmp rax, 1;                            // DM_HEAVY
        je  dm_dsp_heavy_path;

        // --------- LIGHT PATH ---------

        // Bump _dm_light_count by 1.
        lea r11, [rip + _dm_light_count];
        mov rax, [r11];
        add rax, 1;
        lea r11, [rip + _dm_light_count];
        mov [r11], rax;

        // Set _dm_last_decision := 1 (DM_SENTINEL_LIGHT).
        mov rax, 1;
        lea r11, [rip + _dm_last_decision];
        mov [r11], rax;

        // Load _dm_light_fn.
        lea r11, [rip + _dm_light_fn];
        mov rax, [r11];
        cmp rax, 0;
        je  dm_dsp_no_light_fn;

        // Indirect-call the light invoker: fn(cs_body, cs_len, mat_body, mat_len).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call rax;

        // Dispatcher return: 0 -> OK, non-zero -> LIGHT_FAILED.
        cmp rax, 0;
        jne dm_dsp_light_failed;

        // OK pack: decision=0, errno=0, status=DM_OK=0 -> rax = 0.
        xor rax, rax;
        jmp dm_dsp_epilogue;

      dm_dsp_light_failed:
        // Pack: (errno << 32) | (0 << 16) | 0x4804.
        shl rax, 32;
        mov r10, 0x4804;                       // DM_ERR_LIGHT_FAILED
        or  rax, r10;
        jmp dm_dsp_epilogue;

      dm_dsp_heavy_path:
        // --------- HEAVY PATH ---------

        // Bump _dm_heavy_count by 1.
        lea r11, [rip + _dm_heavy_count];
        mov rax, [r11];
        add rax, 1;
        lea r11, [rip + _dm_heavy_count];
        mov [r11], rax;

        // Set _dm_last_decision := 2 (DM_SENTINEL_HEAVY).
        mov rax, 2;
        lea r11, [rip + _dm_last_decision];
        mov [r11], rax;

        // Load _dm_spawn_fn.
        lea r11, [rip + _dm_spawn_fn];
        mov rax, [r11];
        cmp rax, 0;
        je  dm_dsp_no_spawn_fn;

        // Indirect-call the spawn invoker.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call rax;

        cmp rax, 0;
        jne dm_dsp_spawn_failed;

        // OK pack: decision=1, errno=0, status=DM_OK -> rax = 0x10000.
        mov rax, 0x10000;                      // bit 16 set
        jmp dm_dsp_epilogue;

      dm_dsp_spawn_failed:
        // Pack: (errno << 32) | (1 << 16) | 0x4805.
        shl rax, 32;
        mov r10, 0x10000;                      // decision bit 16
        or  rax, r10;
        mov r10, 0x4805;                       // DM_ERR_SPAWN_FAILED
        or  rax, r10;
        jmp dm_dsp_epilogue;

      dm_dsp_no_light_fn:
        mov rax, 0x4801;                       // DM_ERR_NO_LIGHT_FN
        jmp dm_dsp_epilogue;

      dm_dsp_no_spawn_fn:
        // Pack: (0 << 32) | (1 << 16) | 0x4802.
        mov rax, 0x10000;                      // decision bit 16
        mov r10, 0x4802;                       // DM_ERR_NO_SPAWN_FN
        or  rax, r10;
        jmp dm_dsp_epilogue;

      dm_dsp_bad_record:
        // _dm_classify already returned DM_ERR_BAD_RECORD (0x4800)
        // in rax. decision = 0, errno = 0; rax is already correct.
        jmp dm_dsp_epilogue;

      dm_dsp_bad_mat:
        mov rax, 0x4806;                       // DM_ERR_BAD_MAT

      dm_dsp_epilogue:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
