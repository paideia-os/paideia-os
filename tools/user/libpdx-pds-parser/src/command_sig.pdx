// src/command_sig.pdx -- libpdx-pds-parser.R222.M2 (paideia-os#2659)
//
// CommandSig: parser-tier body parser for the `command_sig { ... }`
// cmd-functor identity block. R222.M2 of the cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1 (SchemasSig, paideia-os#2658, landed Wave 113) declared the
// INPUT + OUTPUT record shapes of a semantic-shell command functor.
// R222.M2 (THIS module) adds the COMPANION signature: the command's
// FUNCTOR IDENTITY block, which carries
//
//   * the command's human-readable NAME (len 1..48 ASCII),
//   * the set of CAPABILITIES the command requires (up to 8, each a
//     (name, rights-u64) pair),
//   * the command's VERSION (SemVer-shaped, len 1..16 ASCII), and
//   * the command's STABILITY tier (one of {stable, experimental,
//     deprecated}).
//
// Together, SchemasSig (R222.M1) and CommandSig (THIS landing) are
// the two functor-parameter signatures that every semantic-shell
// command module satisfies:
//
//     module Find(Schemas : SchemasSig)(Caps : CommandSig)
//         : struct { ... } = struct ... end
//
// The parser is user-space (satellite library) because the shell runs
// in user space and because the CommandSig record is produced once at
// functor-elaboration time, hashed into the schema-registry fingerprint
// pipeline (R222.M8), and handed to the kernel-side cap-decl checker
// (R227.M2) as a flat byte blob at `exec` time. No kernel-side state
// lives here.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     CommandSig    := Decl*                     (whitespace-separated)
//     Decl          := NameDecl
//                    | CapDecl
//                    | VersionDecl
//                    | StabilityDecl
//     NameDecl      := "name"      ":" WS* "\"" NAME "\""
//     CapDecl       := "cap"       ":" WS* NAME ":" WS* HEX_RIGHTS
//     VersionDecl   := "version"   ":" WS* "\"" SEMVER "\""
//     StabilityDecl := "stability" ":" WS* ("stable"
//                                          | "experimental"
//                                          | "deprecated")
//     NAME          := [0x21..0x7E except '"']+   (len 1..48)
//     SEMVER        := [0x21..0x7E except '"']+   (len 1..16)
//     HEX_RIGHTS    := "0x" [0-9A-Fa-f]+          (1..16 hex digits)
//     WS            := 0x20 | 0x09 | 0x0A | 0x0D
//
// The entry point consumes the body BETWEEN the `{` and the `}`; the
// braces and the leading `command_sig` keyword are not part of the
// input. The caller (a later R222 milestone's lexer / AST pass) locates
// the braces and hands the inner bytes to this module.
//
// Max 8 CapDecls per sig; max 1 NameDecl / VersionDecl / StabilityDecl
// (duplicates land in a "last wins" fashion -- no explicit duplicate
// detection, because the on-disk commands.toml bind layer upstream
// enforces uniqueness, and "last wins" is both the cheapest and most
// forgiving behaviour).
//
// =============================================================================
// RECORD LAYOUT
// =============================================================================
//
// Output buffer layout after a successful parse:
//
//     [+0     .. +128)       CommandSigHeader (128 B)
//     [+128   .. +128+n*32)  CapDecl[0..n]    (32 B each, n = n_caps)
//
// CommandSigHeader (128 B):
//
//   offset  size  field                 notes
//   ------  ----  --------------------  ------------------------------
//     0      4   magic         u32     CS_HEADER_MAGIC ('CSIG' LE
//                                       = 0x47495343)
//     4      1   n_caps        u8      0 .. CS_MAX_CAPS (= 8)
//     5      1   stability     u8      0 (unset) / 1 (stable) / 2
//                                       (experimental) / 3 (deprecated)
//     6      1   name_len      u8      0 .. CS_NAME_MAX (= 48)
//     7      1   version_len   u8      0 .. CS_VERSION_MAX (= 16)
//     8     48   name_inline[48] u8    ASCII name, zero-padded past
//                                       name_len
//    56     16   version_inline[16] u8 ASCII semver, zero-padded past
//                                       version_len
//    72      4   caps_offset   u32     = CS_HEADER_BYTES (128)
//    76      4   caps_len      u32     = n_caps * CS_CAP_DESC_BYTES (32)
//    80      4   flags         u32     bitmask (CS_FLAG_HAS_NAME = 0x01,
//                                       CS_FLAG_HAS_VERSION = 0x02,
//                                       CS_FLAG_HAS_STABILITY = 0x04)
//    84     44   reserved[44]  u8      zeroed; reserved for R222.M3+
//                                       (effect-row id, cap-row id,
//                                       source span, etc.)
//
//   total: 128 B (CS_HEADER_BYTES)
//
// CapDecl (32 B each):
//
//   offset  size  field                  notes
//   ------  ----  ---------------------  ------------------------------
//     0      8   name_hash   u64        FNV-1a 64 of the FULL cap-name
//                                        bytes (identity hash; preserves
//                                        full name past the 16-byte
//                                        inline window).
//     8      8   rights      u64        bitmask parsed from HEX_RIGHTS
//    16     16   name_inline[16] u8     first 16 bytes of the cap name,
//                                        zero-padded; truncated past
//                                        16 chars (name_hash preserves
//                                        full identity).
//
//   total: 32 B (CS_CAP_DESC_BYTES)
//
// Stride 32 is a power of two so cap addressing uses `shl rN, 5` --
// never 2-op `imul r, imm` (per feedback_pdx_encoder_pitfalls). The
// 16-byte inline name mirrors the structural choice R222.M1 made for
// SchemasSig field names: a downstream pass walking the cap table
// never dereferences a sibling buffer, and the name_hash u64 preserves
// full identity across the 16-byte truncation boundary.
//
// Fingerprint input shape (R222.M8 serialization): the full 128-byte
// header plus n_caps * 32 bytes of CapDecl descriptors, byte-identical
// across host and kernel-side consumers because every field is inline
// (no pointer dereferences).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _cs_parse_body(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
//     Parses the body between `{` and `}` -- NOT including the braces.
//     Writes a CommandSigHeader at out_ptr[0..128], then n_caps CapDecl
//     descriptors starting at out_ptr[128..128 + n_caps*32]. Returns
//     a packed `(bytes_written << 32) | status` u64; bytes_written is
//     meaningful only when `status == CS_OK` (on error, callers ignore
//     the top 32 bits).
//
//     Status one of:
//        CS_OK                     = 0
//        CS_ERR_SYNTAX             = 0x3300  bad grammar at the current
//                                             cursor
//        CS_ERR_TOO_MANY_CAPS      = 0x3301  n_caps > CS_MAX_CAPS (= 8)
//        CS_ERR_UNKNOWN_STABILITY  = 0x3302  stability value not in the
//                                             {stable, experimental,
//                                              deprecated} set
//        CS_ERR_OUT_TOO_SMALL      = 0x3303  out_cap < 128 + n_caps*32
//
//   Register map (SysV):
//
//     _cs_parse_body(rdi, rsi, rdx, rcx) -> rax
//         rdi = bytes_ptr
//         rsi = bytes_len
//         rdx = out_ptr
//         rcx = out_cap
//         rax = (bytes_written << 32) | status
//
//   Internal cross-function helpers (module-private; not re-exported):
//
//     _cmd_sig_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
//     _cmd_sig_fnv1a64(ptr, len) -> u64 hash
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller is expected to have already run
//     the input bytes through _u8n_decode_and_normalize so this module
//     may assume (a) valid UTF-8, (b) NFC-form. Because the grammar
//     accepts only ASCII keywords, ASCII punctuation, and ASCII values
//     (name/version/stability/hex rights), the parser only ever
//     inspects the ASCII subset of its input. Non-ASCII bytes inside
//     a keyword or ident fall through to CS_ERR_SYNTAX via the ident-
//     byte-class check (none of 0x80..0xFF is in [A-Za-z0-9_]).
//
//   R222.M1 (SchemasSig)  --  the companion signature. A command's
//     paideia-as functor module takes BOTH (Schemas : SchemasSig)
//     and (Caps : CommandSig) as parameters; the two parsers run
//     side by side at functor-elaboration time. The two modules do
//     NOT share code (SchemasSig carries its own _sch_sig_skip_ws
//     leaf; this module carries _cmd_sig_skip_ws) -- the duplication
//     is intentional at M1/M2 so neither module becomes a build-order
//     dependency of the other.
//
//   R222.M3 (REPL dispatch)  --  consumes the CommandSig record at
//     each command invocation to check the required caps are available
//     and the stability tier is permitted under the session's policy.
//     M3 reads the fields by offset directly off the 128-byte header.
//
//   R222.M8 (serialization)  --  round-trips the (header + cap array)
//     byte image through the queryable form the `describe <cmd>`
//     builtin consumes. The 16-byte inline cap name is a stable
//     primary key for the per-cap record; the name_hash u64 preserves
//     full identity across truncation.
//
//   R227.M2 (cap-decl checker, paideia-os#2650, landed Wave 115)  --
//     at `exec` time the kernel-side cap-decl checker reads the
//     CommandSig cap array from the elf .caps.decl section and compares
//     each (name_hash, rights) pair against the parent task's cap table.
//     The byte-identical layout here (hash + rights at offsets 0 + 8)
//     is the direct match target the checker consumes.
//
//   R133.M2 (pds-container format gate)  --  the pds container's
//     header pragma pass (R227.M1, landed Wave 112) seats the
//     CommandSig fingerprint into the container header; R133.M2 then
//     reads it back at load time to verify the on-disk cap requirements
//     match the elaborator's view.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32 (0xFF, 0xFFFF).
//   - No 2-op `imul r, imm` -- cap stride is `shl rN, 5` (* 32); the
//     FNV multiply by the 64-bit prime uses `mul rcx` (one-op unsigned
//     mul: rdx:rax <- rax * rcx), which is a distinct instruction
//     shape from the pitfall-listed 2-op `imul r, imm`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `CommandSig` matches `command_sig.pdx`.
//   - Labels prefixed `cmd_sig_` (NEVER `cs_` -- `cs_*` is used by
//     203 kernel-side labels + 30 user-space labels across the repo,
//     grep-confirmed at R222.M2 landing time). The public API still
//     owns the `_cs_*` entry-point namespace since that is a distinct
//     "with-underscore prefix" convention from the `cs_*` kernel label
//     namespace.
//   - All `cmp reg, imm` immediates <= 0x3303 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. The FNV-1a constants
//     (offset-basis 0xCBF29CE484222325 and prime 0x100000001B3) are
//     loaded via `mov rN, imm64` (REX.W + MOV imm64 encoding, same
//     shape as `mov r10, 0xFFFFFFFFFFFFFFFF` in libpdx-elevate's
//     elevate_client_send.pdx and `mov r10, 0x00FFFFFFFFFFFFFF` in
//     mkfs.pdxfs's elevate_gate.pdx).
//   - All byte loads via `xor rax, rax; mov_b rax, [base + idx]`
//     (zero-extends into the full qword); byte stores via
//     `mov_b [dst + disp], reg`, same shape as SchemasSig / LambdaLit
//     / Pipeline.
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: Pipeline
//     _pl_emit_word, libpdx-argv emit_parse_error).
//   - u64 stores via `mov [dst + disp], reg`.
//   - u64 zero-fill of the fresh header uses a shift-add loop stepping
//     by 8 (16 iterations across 128 bytes); loop counter in rax,
//     stride add r11, 8, bound compare at 128.
//   - `_cmd_sig_skip_ws` and `_cmd_sig_fnv1a64` are pure leaves: no
//     callee-save push, no stack frame, no nested CALL.
//   - `_cs_parse_body` has a 6-push + 24-byte-scratch frame
//     (rsp%16==0 at every nested CALL; entry %16==8, +48 pushes =
//     %16==8, +24 scratch = 8+48+24 = 80, %16==0). Matches SchemasSig's
//     _ss_parse_body and LambdaLit's _ll_parse frames.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R222.M3  REPL dispatch wires the parsed CommandSig into the per-
//            command policy check and the cap-table lookup.
//   R222.M4  ArgSpec + FlagSpec parsers (same satellite; adjacent
//            signature parameters to SchemasSig + CommandSig).
//   R222.M5  Registry client reads a serialized form of the CommandSig
//            record from /system/shell/commands.toml.
//   R222.M8  `describe <cmd>` builtin round-trips the CommandSig
//            through the queryable form.
//
// =============================================================================
// Upstream: paideia-os#2659 (THIS ticket, R222.M2). Substrate:
// paideia-os#2651 (R221.M1 UTF-8/NFC parser-tier wrapper), paideia-
// os#2658 (R222.M1 SchemasSig, companion). Design doc:
// design/shell/cmd-functor-command-sig.md.

module CommandSig = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Small-value range 0x3300..0x33FF, reserved for the R222.M2 cmd-
  // functor-identity parser band. Disjoint from the R221 parser-tier
  // band (0x2700..), the R222.M1 schemas-sig band (0x2A00..), the R223
  // pipeline-lang band (0x2B00..), the R224 lambda-lang band (0x2C00..),
  // the R225 hm-core band (0x2D00..), the R226 datalog band (0x2E00..),
  // and every other user-space packed-status range in the paideia-os
  // tree.
  //
  // Grep confirmation at R222.M2 landing time:
  //   grep -rE '0x330[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/cmd-functor-command-sig.md.

  pub let CS_OK                     : u64 = 0
  pub let CS_ERR_SYNTAX             : u64 = 0x3300
  pub let CS_ERR_TOO_MANY_CAPS      : u64 = 0x3301
  pub let CS_ERR_UNKNOWN_STABILITY  : u64 = 0x3302
  pub let CS_ERR_OUT_TOO_SMALL      : u64 = 0x3303

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let CS_HEADER_BYTES    : u64 = 128
  pub let CS_CAP_DESC_BYTES  : u64 = 32
  pub let CS_MAX_CAPS        : u64 = 8
  pub let CS_NAME_MAX        : u64 = 48
  pub let CS_VERSION_MAX     : u64 = 16
  pub let CS_HEX_RIGHTS_MAX  : u64 = 16    // max hex digits in a u64

  // Magic: 'CSIG' little-endian = 0x47495343. Reads correctly as the
  // 4-byte ASCII string "CSIG" in a hex dump.
  pub let CS_HEADER_MAGIC    : u64 = 0x47495343

  // Stability tier codes (one byte, written to [header + CS_OFF_STABILITY]).
  pub let CS_STAB_UNSET         : u64 = 0
  pub let CS_STAB_STABLE        : u64 = 1
  pub let CS_STAB_EXPERIMENTAL  : u64 = 2
  pub let CS_STAB_DEPRECATED    : u64 = 3

  // Flag bitmask (u32 at CS_OFF_FLAGS).
  pub let CS_FLAG_HAS_NAME      : u64 = 0x01
  pub let CS_FLAG_HAS_VERSION   : u64 = 0x02
  pub let CS_FLAG_HAS_STABILITY : u64 = 0x04

  // Header field offsets (byte offsets from header base).
  pub let CS_OFF_MAGIC          : u64 = 0
  pub let CS_OFF_N_CAPS         : u64 = 4
  pub let CS_OFF_STABILITY      : u64 = 5
  pub let CS_OFF_NAME_LEN       : u64 = 6
  pub let CS_OFF_VERSION_LEN    : u64 = 7
  pub let CS_OFF_NAME           : u64 = 8     // 48 B inline
  pub let CS_OFF_VERSION        : u64 = 56    // 16 B inline
  pub let CS_OFF_CAPS_OFFSET    : u64 = 72    // u32
  pub let CS_OFF_CAPS_LEN       : u64 = 76    // u32
  pub let CS_OFF_FLAGS          : u64 = 80    // u32
  pub let CS_OFF_RESERVED       : u64 = 84    // 44 B reserved

  // CapDecl field offsets (byte offsets from descriptor base).
  pub let CS_CAP_OFF_HASH       : u64 = 0     // u64
  pub let CS_CAP_OFF_RIGHTS     : u64 = 8     // u64
  pub let CS_CAP_OFF_NAME       : u64 = 16    // 16 B inline

  // ==========================================================================
  // _cmd_sig_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a space-
  // class byte, OR cursor == bytes_len (end-of-input is a valid stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Byte-for-byte mirror of _sch_sig_skip_ws / _ll_skip_ws / _dl_skip_ws
  // so a maintainer who patches one patches them in lockstep (the
  // whitespace discipline is a shared property of the pds-lang family).
  // Labels prefixed cmd_sig_sw_.
  // ==========================================================================
  pub let _cmd_sig_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M2 (#2659): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. The space-class check is four cmp-imm32 branches rather than a bitmap because the set is small and the branch predictor can speculate the common no-ws case. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cmd_sig_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      cmd_sig_sw_loop:
        cmp rax, rsi;
        jae cmd_sig_sw_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  cmd_sig_sw_advance;
        cmp rcx, 0x09;
        je  cmd_sig_sw_advance;
        cmp rcx, 0x0A;
        je  cmd_sig_sw_advance;
        cmp rcx, 0x0D;
        je  cmd_sig_sw_advance;
        jmp cmd_sig_sw_done;

      cmd_sig_sw_advance:
        add rax, 1;
        jmp cmd_sig_sw_loop;

      cmd_sig_sw_done:
        ret;
      }
    }

  // ==========================================================================
  // _cmd_sig_fnv1a64(ptr, len) -> hash
  //
  //   rdi = ptr
  //   rsi = len
  //   rax = FNV-1a 64 hash
  //
  // FNV-1a 64 as per the standard reference (fnv_offset_basis =
  // 0xCBF29CE484222325, fnv_prime = 0x100000001B3). The hash is used
  // as a stable identity for cap names past the 16-byte inline window:
  // two cap names that share their first 16 bytes but diverge past
  // that still land distinct hashes. Deliberately NOT BLAKE3 here:
  // (a) this is a user-space library leaf and must not take a linker
  // dep on paideia_crypto_blake3_hash (precedent: libpdx-pds-parser's
  // whole module tree is pure-leaf; see caps.decl), (b) FNV-1a 64 is
  // fast enough for 1..48-byte cap names at functor-elaboration time
  // (which happens once per command module load), and (c) the hash
  // is identity-only, not a security primitive -- a later R222.M? that
  // wants a cryptographic cap-name fingerprint can replace this body
  // with a BLAKE3 wrapper call without an ABI break.
  //
  // Multiplication by the 64-bit prime uses `mul rcx` (one-op unsigned
  // mul: rdx:rax <- rax * rcx; we keep the low 64 in rax, discarding
  // rdx). This is a distinct instruction shape from the pitfall-listed
  // 2-op `imul r, imm`, which is the shape paideia-as#1545 refuses to
  // encode. Encoder support confirmed via jcc_tests.rs line 1695 et seq
  // (`48 F7 E0..E1` encoding; same `mul reg` form).
  //
  // A zero-length input returns the offset basis unchanged (standard
  // FNV behaviour; preserves the "no bytes consumed, no mixing" shape).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rax = hash accumulator, rcx = fnv_prime (held
  // across the loop), rdx = mul high half (clobbered each iteration),
  // r8 = ptr (saved from rdi; rdi untouched past the entry mov), r9 =
  // len (saved from rsi), r10 = index i, r11 = byte load scratch.
  // Labels prefixed cmd_sig_fnv_.
  // ==========================================================================
  pub let _cmd_sig_fnv1a64 : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M2 (#2659): FNV-1a 64 hash over [ptr, ptr+len). Pure leaf; zero pushes; no stack frame; no nested CALL. Load offset basis 0xCBF29CE484222325 (imm64 via REX.W+MOV, precedent: libpdx-elevate's elevate_client_send and mkfs.pdxfs's elevate_gate) into rax; load fnv_prime 0x100000001B3 (imm64) into rcx, held across the loop. For each byte: xor-load byte into r11 (zero-extended via `xor r11, r11; mov_b r11, [r8 + r10]`); xor r11 into rax; xor rdx, rdx to clear the mul high half; `mul rcx` yields rdx:rax = rax * fnv_prime, we take the low 64 in rax. Advance r10 by 1; loop. Terminates on r10 >= r9. A zero-length input returns the offset basis unchanged (standard FNV behaviour). All cmp immediates are 0 (the i < len test) which is imm8-safe. No test (zero-check uses `cmp r10, r9` + `jae`). No and-imm64. No 2-op imul-r-imm (the `mul rcx` here is the one-op unsigned mul form, distinct from the pitfall-listed shape). No multiline let. Labels prefixed cmd_sig_fnv_.",
      block: {
        mov r8, rdi;                           // r8 = ptr (saved)
        mov r9, rsi;                           // r9 = len (saved)
        mov rax, 0xCBF29CE484222325;           // h = fnv_offset_basis
        mov rcx, 0x100000001B3;                // fnv_prime (held in rcx)
        xor r10, r10;                          // i = 0

      cmd_sig_fnv_loop:
        cmp r10, r9;
        jae cmd_sig_fnv_done;

        xor r11, r11;
        mov_b r11, [r8 + r10];                 // byte load
        xor rax, r11;                          // h ^= byte

        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * fnv_prime

        add r10, 1;
        jmp cmd_sig_fnv_loop;

      cmd_sig_fnv_done:
        ret;
      }
    }

  // ==========================================================================
  // _cs_parse_body(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Walks the body as a Decl* loop over whitespace-separated decls.
  // Each iteration:
  //
  //   skip_ws
  //   if cursor == bytes_len: success (break)
  //   scan keyword ident
  //   length-switched classify:
  //     len 3 -> "cap"      -> cap decl arm
  //     len 4 -> "name"     -> name decl arm
  //     len 7 -> "version"  -> version decl arm
  //     len 9 -> "stability"-> stability decl arm
  //     else  -> CS_ERR_SYNTAX
  //   per-arm:
  //     skip_ws + require ':' + skip_ws + parse-value + write-to-header
  //   loop
  //
  // On success writes the final CommandSigHeader fields (n_caps,
  // caps_len) and packs the return.
  //
  // Register plan (6 callee-save pushes + 24-byte scratch slot;
  // rsp%16==0 steady; entry %16==8, +48 pushes = %16==8, +24 scratch
  // = 8+48+24 = 80, %16==0; nested CALLs into _cmd_sig_skip_ws and
  // _cmd_sig_fnv1a64 land aligned):
  //
  //   rbx = bytes_ptr (immutable)
  //   rbp = bytes_len (immutable)
  //   r12 = cursor (byte offset into body)
  //   r13 = out_ptr base (immutable)
  //   r14 = out_cap (immutable)
  //   r15 = n_caps counter
  //
  //   [rsp +  0] = scratch #0 (cap_name_start during a cap decl)
  //   [rsp +  8] = scratch #1 (cap_name_len during a cap decl)
  //   [rsp + 16] = scratch #2 (cap_rights u64 during a cap decl)
  //
  // Labels prefixed cmd_sig_pb_.
  // ==========================================================================
  pub let _cs_parse_body : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M2 (#2659): parse the body of a `command_sig { ... }` block into a CommandSigHeader (128 B) + up to 8 CapDecl descriptors (32 B each). 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr, r14=out_cap, r15=n_caps) + `sub rsp, 24` for three scratch slots (cap_name_start, cap_name_len, cap_rights) + alignment -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +24 scratch -> %16==0). Nested CALLs (_cmd_sig_skip_ws leaf, _cmd_sig_fnv1a64 leaf) therefore need no additional per-call pad. State machine: Decl* loop over whitespace-separated decls; each iteration scans one keyword (length-switched classify: 3=`cap`, 4=`name`, 7=`version`, 9=`stability`), skips ws + requires ':' + skips ws, then dispatches to the matching arm. Name/version arms require '\"' NAME '\"' with len 1..CS_NAME_MAX / 1..CS_VERSION_MAX; stability arm requires an unquoted ident classified against the {stable, experimental, deprecated} length-switched set; cap arm requires NAME ':' WS* '0x' HEX_RIGHTS. The cap arm computes name_hash via a nested call to _cmd_sig_fnv1a64, enforces n_caps < CS_MAX_CAPS (CS_ERR_TOO_MANY_CAPS) and 128 + (n_caps+1)*32 <= out_cap (CS_ERR_OUT_TOO_SMALL), then writes the 32-byte CapDecl at out_ptr + 128 + r15*32 (stride multiply via `shl rax, 5` -- never `imul r, imm`). Header prelude zero-fills the 128 bytes via a shift-add loop stepping by 8 (16 iterations); magic u32 and caps_offset u32 are stamped immediately via `mov_d`. Header coda writes n_caps u8, caps_len u32, flags u32, and packs the return `(bytes_written << 32) | CS_OK`. All error paths jump to a shared epilogue that unwinds the 24-byte scratch and 6 callee-save pops. All `cmp` immediates (ASCII literals 0x22..0x7F, CS_MAX_CAPS=8, CS_NAME_MAX=48, CS_VERSION_MAX=16, CS_HEX_RIGHTS_MAX=16, CS_HEADER_BYTES=128, CS_CAP_DESC_BYTES=32, flag bits 0x01..0x04, stability codes 0..3, status codes 0x3300..0x3303) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. CS_HEADER_MAGIC (0x47495343) and the FNV constants (used only inside _cmd_sig_fnv1a64 which is a leaf) are the only >32-bit immediates and both go through `mov rN, imm64` loads. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed cmd_sig_pb_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Load state regs.
        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        xor r12, r12;                          // cursor = 0
        mov r13, rdx;                          // out_ptr (immutable)
        mov r14, rcx;                          // out_cap (immutable)
        xor r15, r15;                          // n_caps = 0

        // Zero scratch slots for determinism.
        xor rax, rax;
        mov [rsp + 0], rax;
        mov [rsp + 8], rax;
        mov [rsp + 16], rax;

        // Capacity guard: must fit at least the header.
        cmp r14, 128;
        jb  cmd_sig_pb_oos;

        // ---- Zero-fill header (128 bytes) via a u64 stepping loop. ---
        // r11 = offset in [0..128); add 8 each iteration.
        xor r11, r11;
      cmd_sig_pb_zero_hdr:
        cmp r11, 128;
        jae cmd_sig_pb_hdr_prelude;
        xor rax, rax;
        mov rcx, r13;
        add rcx, r11;
        mov [rcx + 0], rax;                    // u64 zero store
        add r11, 8;
        jmp cmd_sig_pb_zero_hdr;

        // ---- Header prelude: magic + caps_offset. --------------------
      cmd_sig_pb_hdr_prelude:
        mov rax, 0x47495343;                   // CS_HEADER_MAGIC 'CSIG'
        mov_d [r13 + 0], rax;                  // magic u32 at +0

        mov rax, 128;                          // caps_offset = header size
        mov_d [r13 + 72], rax;                 // u32 at +CS_OFF_CAPS_OFFSET

        // ============================================================
        // Decl* loop entry.
        // ============================================================
      cmd_sig_pb_decl_loop:
        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        // End-of-input is a clean success exit.
        cmp r12, rbp;
        jae cmd_sig_pb_done;

        // ---- Scan keyword ident (byte-class [A-Za-z_]...). ----------
        mov r10, r12;                          // kw_start
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;                         // '_'
        je  cmd_sig_pb_kw_cont;
        cmp rax, 0x41;                         // 'A'
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x5A;                         // 'Z'
        jbe cmd_sig_pb_kw_cont;
        cmp rax, 0x61;                         // 'a'
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x7A;                         // 'z'
        ja  cmd_sig_pb_syntax;

      cmd_sig_pb_kw_cont:
        add r12, 1;
      cmd_sig_pb_kw_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_kw_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  cmd_sig_pb_kw_step;
        cmp rax, 0x30;                         // '0'
        jb  cmd_sig_pb_kw_check_alpha;
        cmp rax, 0x39;                         // '9'
        jbe cmd_sig_pb_kw_step;
      cmd_sig_pb_kw_check_alpha:
        cmp rax, 0x41;
        jb  cmd_sig_pb_kw_end;
        cmp rax, 0x5A;
        jbe cmd_sig_pb_kw_step;
        cmp rax, 0x61;
        jb  cmd_sig_pb_kw_end;
        cmp rax, 0x7A;
        ja  cmd_sig_pb_kw_end;
      cmd_sig_pb_kw_step:
        add r12, 1;
        jmp cmd_sig_pb_kw_scan;

      cmd_sig_pb_kw_end:
        // kw_len = r12 - kw_start = r12 - r10
        mov r11, r12;
        sub r11, r10;
        cmp r11, 0;
        je  cmd_sig_pb_syntax;

        // ---- Length-switched dispatch over the four known keywords. -
        cmp r11, 3;
        je  cmd_sig_pb_kw_len3;                // "cap"
        cmp r11, 4;
        je  cmd_sig_pb_kw_len4;                // "name"
        cmp r11, 7;
        je  cmd_sig_pb_kw_len7;                // "version"
        cmp r11, 9;
        je  cmd_sig_pb_kw_len9;                // "stability"
        jmp cmd_sig_pb_syntax;

        // ---- "cap" (c=0x63, a=0x61, p=0x70) -------------------------
      cmd_sig_pb_kw_len3:
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x63;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x61;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x70;
        jne cmd_sig_pb_syntax;
        jmp cmd_sig_pb_decl_cap;

        // ---- "name" (n=0x6E, a=0x61, m=0x6D, e=0x65) ----------------
      cmd_sig_pb_kw_len4:
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x6E;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x61;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x6D;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x65;
        jne cmd_sig_pb_syntax;
        jmp cmd_sig_pb_decl_name;

        // ---- "version" (v=0x76, e=0x65, r=0x72, s=0x73, i=0x69, o=0x6F, n=0x6E) --
      cmd_sig_pb_kw_len7:
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x76;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x65;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x72;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x73;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 4];
        cmp rax, 0x69;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 5];
        cmp rax, 0x6F;
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 6];
        cmp rax, 0x6E;
        jne cmd_sig_pb_syntax;
        jmp cmd_sig_pb_decl_version;

        // ---- "stability" (s t a b i l i t y) ------------------------
      cmd_sig_pb_kw_len9:
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x73;                         // 's'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x74;                         // 't'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x61;                         // 'a'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x62;                         // 'b'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 4];
        cmp rax, 0x69;                         // 'i'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 5];
        cmp rax, 0x6C;                         // 'l'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 6];
        cmp rax, 0x69;                         // 'i'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 7];
        cmp rax, 0x74;                         // 't'
        jne cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 8];
        cmp rax, 0x79;                         // 'y'
        jne cmd_sig_pb_syntax;
        jmp cmd_sig_pb_decl_stability;

        // ============================================================
        // Decl arm: "name" : "<NAME>"
        // ============================================================
      cmd_sig_pb_decl_name:
        // skip_ws + require ':' + skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        // Require opening '"'.
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x22;                         // '"'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        // Scan NAME bytes until next '"'. Length-bounded at CS_NAME_MAX.
        mov r10, r12;                          // name_start
      cmd_sig_pb_name_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;                 // unterminated '"'
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x22;                         // closing '"'?
        je  cmd_sig_pb_name_end;
        // Accept printable ASCII 0x21..0x7E (excluding '"' which was
        // the previous branch).
        cmp rax, 0x21;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x7E;
        ja  cmd_sig_pb_syntax;
        add r12, 1;
        // Length guard: name_len = r12 - r10 must stay <= CS_NAME_MAX.
        mov r11, r12;
        sub r11, r10;
        cmp r11, 48;                           // CS_NAME_MAX
        ja  cmd_sig_pb_syntax;
        jmp cmd_sig_pb_name_scan;

      cmd_sig_pb_name_end:
        // r11 = name_len. Must be >= 1.
        mov r11, r12;
        sub r11, r10;
        cmp r11, 0;
        je  cmd_sig_pb_syntax;

        // Consume closing '"'.
        add r12, 1;

        // Write name_len u8 at [r13 + CS_OFF_NAME_LEN = 6].
        mov rax, r11;
        mov_b [r13 + 6], rax;

        // Copy name bytes to [r13 + CS_OFF_NAME = 8 .. 8 + name_len).
        // Overwrites any prior name_inline bytes (last-wins idempotence).
        // Also zero-pads the trailing bytes to byte 56 so a shorter
        // "last-wins" replacement does not leave stale tail bytes.
        xor r9, r9;                            // i = 0
      cmd_sig_pb_name_copy:
        cmp r9, r11;
        jae cmd_sig_pb_name_pad;
        mov rdi, rbx;
        add rdi, r10;
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, r13;
        add rsi, 8;
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp cmd_sig_pb_name_copy;

      cmd_sig_pb_name_pad:
        // Zero-pad [8 + name_len .. 56).
        mov r9, r11;
        add r9, 8;
      cmd_sig_pb_name_pad_loop:
        cmp r9, 56;
        jae cmd_sig_pb_name_set_flag;
        mov rsi, r13;
        add rsi, r9;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp cmd_sig_pb_name_pad_loop;

      cmd_sig_pb_name_set_flag:
        // Set CS_FLAG_HAS_NAME in flags u32 at [r13 + CS_OFF_FLAGS = 80].
        mov_d rax, [r13 + 80];
        or  rax, 0x01;                         // CS_FLAG_HAS_NAME
        mov_d [r13 + 80], rax;
        jmp cmd_sig_pb_decl_loop;

        // ============================================================
        // Decl arm: "version" : "<SEMVER>"
        // ============================================================
      cmd_sig_pb_decl_version:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x22;                         // '"'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov r10, r12;                          // version_start
      cmd_sig_pb_ver_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x22;
        je  cmd_sig_pb_ver_end;
        cmp rax, 0x21;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x7E;
        ja  cmd_sig_pb_syntax;
        add r12, 1;
        mov r11, r12;
        sub r11, r10;
        cmp r11, 16;                           // CS_VERSION_MAX
        ja  cmd_sig_pb_syntax;
        jmp cmd_sig_pb_ver_scan;

      cmd_sig_pb_ver_end:
        mov r11, r12;
        sub r11, r10;
        cmp r11, 0;
        je  cmd_sig_pb_syntax;

        add r12, 1;                            // consume closing '"'

        // version_len u8 at [r13 + CS_OFF_VERSION_LEN = 7].
        mov rax, r11;
        mov_b [r13 + 7], rax;

        // Copy version bytes to [r13 + CS_OFF_VERSION = 56 .. 56+len).
        xor r9, r9;
      cmd_sig_pb_ver_copy:
        cmp r9, r11;
        jae cmd_sig_pb_ver_pad;
        mov rdi, rbx;
        add rdi, r10;
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, r13;
        add rsi, 56;
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp cmd_sig_pb_ver_copy;

      cmd_sig_pb_ver_pad:
        mov r9, r11;
        add r9, 56;
      cmd_sig_pb_ver_pad_loop:
        cmp r9, 72;                            // 56 + 16 = CS_OFF_CAPS_OFFSET
        jae cmd_sig_pb_ver_set_flag;
        mov rsi, r13;
        add rsi, r9;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp cmd_sig_pb_ver_pad_loop;

      cmd_sig_pb_ver_set_flag:
        mov_d rax, [r13 + 80];
        or  rax, 0x02;                         // CS_FLAG_HAS_VERSION
        mov_d [r13 + 80], rax;
        jmp cmd_sig_pb_decl_loop;

        // ============================================================
        // Decl arm: "stability" : (stable | experimental | deprecated)
        // ============================================================
      cmd_sig_pb_decl_stability:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        // Scan an unquoted ident for the stability value.
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        mov r10, r12;                          // val_start
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x41;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x5A;
        jbe cmd_sig_pb_stab_cont;
        cmp rax, 0x61;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x7A;
        ja  cmd_sig_pb_syntax;

      cmd_sig_pb_stab_cont:
        add r12, 1;
      cmd_sig_pb_stab_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_stab_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x41;
        jb  cmd_sig_pb_stab_end;
        cmp rax, 0x5A;
        jbe cmd_sig_pb_stab_step;
        cmp rax, 0x61;
        jb  cmd_sig_pb_stab_end;
        cmp rax, 0x7A;
        ja  cmd_sig_pb_stab_end;
      cmd_sig_pb_stab_step:
        add r12, 1;
        jmp cmd_sig_pb_stab_scan;

      cmd_sig_pb_stab_end:
        mov r11, r12;
        sub r11, r10;
        cmp r11, 0;
        je  cmd_sig_pb_bad_stab;

        // Length-switched classify over {stable=6, deprecated=10,
        // experimental=12}.
        cmp r11, 6;
        je  cmd_sig_pb_stab_check_stable;
        cmp r11, 10;
        je  cmd_sig_pb_stab_check_deprecated;
        cmp r11, 12;
        je  cmd_sig_pb_stab_check_experimental;
        jmp cmd_sig_pb_bad_stab;

      cmd_sig_pb_stab_check_stable:
        // "stable" s=0x73 t=0x74 a=0x61 b=0x62 l=0x6C e=0x65
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x73;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x74;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x61;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x62;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 4];
        cmp rax, 0x6C;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 5];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        mov rax, 1;                            // CS_STAB_STABLE
        jmp cmd_sig_pb_stab_write;

      cmd_sig_pb_stab_check_experimental:
        // "experimental" e=0x65 x=0x78 p=0x70 e=0x65 r=0x72 i=0x69
        //                m=0x6D e=0x65 n=0x6E t=0x74 a=0x61 l=0x6C
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x78;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x70;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 4];
        cmp rax, 0x72;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 5];
        cmp rax, 0x69;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 6];
        cmp rax, 0x6D;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 7];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 8];
        cmp rax, 0x6E;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 9];
        cmp rax, 0x74;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 10];
        cmp rax, 0x61;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 11];
        cmp rax, 0x6C;
        jne cmd_sig_pb_bad_stab;
        mov rax, 2;                            // CS_STAB_EXPERIMENTAL
        jmp cmd_sig_pb_stab_write;

      cmd_sig_pb_stab_check_deprecated:
        // "deprecated" d=0x64 e=0x65 p=0x70 r=0x72 e=0x65 c=0x63
        //              a=0x61 t=0x74 e=0x65 d=0x64
        xor rax, rax;
        mov_b rax, [rbx + r10 + 0];
        cmp rax, 0x64;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 1];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 2];
        cmp rax, 0x70;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 3];
        cmp rax, 0x72;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 4];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 5];
        cmp rax, 0x63;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 6];
        cmp rax, 0x61;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 7];
        cmp rax, 0x74;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 8];
        cmp rax, 0x65;
        jne cmd_sig_pb_bad_stab;
        xor rax, rax;
        mov_b rax, [rbx + r10 + 9];
        cmp rax, 0x64;
        jne cmd_sig_pb_bad_stab;
        mov rax, 3;                            // CS_STAB_DEPRECATED
        jmp cmd_sig_pb_stab_write;

      cmd_sig_pb_stab_write:
        // Write stability u8 at [r13 + CS_OFF_STABILITY = 5].
        mov_b [r13 + 5], rax;
        // Set CS_FLAG_HAS_STABILITY in flags u32.
        mov_d rax, [r13 + 80];
        or  rax, 0x04;                         // CS_FLAG_HAS_STABILITY
        mov_d [r13 + 80], rax;
        jmp cmd_sig_pb_decl_loop;

        // ============================================================
        // Decl arm: "cap" : <name> : 0x<rights>
        // ============================================================
      cmd_sig_pb_decl_cap:
        // Count guard.
        cmp r15, 8;                            // CS_MAX_CAPS
        jae cmd_sig_pb_too_many_caps;

        // Capacity guard: header + (n_caps + 1) * CS_CAP_DESC_BYTES
        //               = 128 + (r15 + 1) * 32 <= r14
        mov rax, r15;
        add rax, 1;
        shl rax, 5;                            // *32
        add rax, 128;
        cmp rax, r14;
        ja  cmd_sig_pb_oos;

        // skip_ws + require ':' + skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        // ---- Scan cap name ident (byte-class [A-Za-z_] [A-Za-z0-9_]*).
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        mov [rsp + 0], r12;                    // cap_name_start

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  cmd_sig_pb_cap_name_cont;
        cmp rax, 0x41;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x5A;
        jbe cmd_sig_pb_cap_name_cont;
        cmp rax, 0x61;
        jb  cmd_sig_pb_syntax;
        cmp rax, 0x7A;
        ja  cmd_sig_pb_syntax;

      cmd_sig_pb_cap_name_cont:
        add r12, 1;
      cmd_sig_pb_cap_name_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_cap_name_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  cmd_sig_pb_cap_name_step;
        cmp rax, 0x30;
        jb  cmd_sig_pb_cap_name_check_alpha;
        cmp rax, 0x39;
        jbe cmd_sig_pb_cap_name_step;
      cmd_sig_pb_cap_name_check_alpha:
        cmp rax, 0x41;
        jb  cmd_sig_pb_cap_name_end;
        cmp rax, 0x5A;
        jbe cmd_sig_pb_cap_name_step;
        cmp rax, 0x61;
        jb  cmd_sig_pb_cap_name_end;
        cmp rax, 0x7A;
        ja  cmd_sig_pb_cap_name_end;
      cmd_sig_pb_cap_name_step:
        add r12, 1;
        jmp cmd_sig_pb_cap_name_scan;

      cmd_sig_pb_cap_name_end:
        // cap_name_len = r12 - cap_name_start
        mov rax, r12;
        sub rax, [rsp + 0];
        mov [rsp + 8], rax;                    // cap_name_len
        cmp rax, 0;
        je  cmd_sig_pb_syntax;
        cmp rax, 48;                           // CS_NAME_MAX
        ja  cmd_sig_pb_syntax;

        // ---- skip_ws + require ':' + skip_ws (before HEX_RIGHTS).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;
        jne cmd_sig_pb_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cmd_sig_skip_ws;
        mov r12, rax;

        // ---- Parse HEX_RIGHTS = "0x" [0-9A-Fa-f]+ (1..16 digits).
        // Expect '0'.
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x30;                         // '0'
        jne cmd_sig_pb_syntax;
        add r12, 1;

        // Expect 'x' or 'X'.
        cmp r12, rbp;
        jae cmd_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x78;                         // 'x'
        je  cmd_sig_pb_hex_scan_entry;
        cmp rax, 0x58;                         // 'X'
        je  cmd_sig_pb_hex_scan_entry;
        jmp cmd_sig_pb_syntax;

      cmd_sig_pb_hex_scan_entry:
        add r12, 1;

        // Accumulate hex digits into r9 (rights).
        xor r9, r9;                            // rights = 0
        xor r11, r11;                          // digit count = 0
      cmd_sig_pb_hex_scan:
        cmp r12, rbp;
        jae cmd_sig_pb_hex_scan_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        // 0..9 ?
        cmp rax, 0x30;
        jb  cmd_sig_pb_hex_scan_end;
        cmp rax, 0x39;
        jbe cmd_sig_pb_hex_digit_decimal;
        // A..F ?
        cmp rax, 0x41;
        jb  cmd_sig_pb_hex_scan_end;
        cmp rax, 0x46;
        jbe cmd_sig_pb_hex_digit_upper;
        // a..f ?
        cmp rax, 0x61;
        jb  cmd_sig_pb_hex_scan_end;
        cmp rax, 0x66;
        jbe cmd_sig_pb_hex_digit_lower;
        jmp cmd_sig_pb_hex_scan_end;

      cmd_sig_pb_hex_digit_decimal:
        sub rax, 0x30;                         // digit = byte - '0'
        jmp cmd_sig_pb_hex_digit_merge;
      cmd_sig_pb_hex_digit_upper:
        sub rax, 0x41;
        add rax, 10;                           // digit = byte - 'A' + 10
        jmp cmd_sig_pb_hex_digit_merge;
      cmd_sig_pb_hex_digit_lower:
        sub rax, 0x61;
        add rax, 10;                           // digit = byte - 'a' + 10

      cmd_sig_pb_hex_digit_merge:
        // rights = (rights << 4) | digit
        shl r9, 4;
        or  r9, rax;
        add r11, 1;
        cmp r11, 16;                           // CS_HEX_RIGHTS_MAX
        ja  cmd_sig_pb_syntax;                 // >16 hex digits overflows u64
        add r12, 1;
        jmp cmd_sig_pb_hex_scan;

      cmd_sig_pb_hex_scan_end:
        // Must have consumed at least one hex digit.
        cmp r11, 0;
        je  cmd_sig_pb_syntax;

        // r9 = rights. Stash it in the scratch slot across the fnv call.
        mov [rsp + 16], r9;                    // cap_rights

        // ---- Compute cap_name_hash via FNV-1a 64. --------------------
        // _cmd_sig_fnv1a64(rbx + cap_name_start, cap_name_len) -> rax.
        mov rdi, rbx;
        add rdi, [rsp + 0];                    // + cap_name_start
        mov rsi, [rsp + 8];                    // cap_name_len
        call _cmd_sig_fnv1a64;
        // rax = name_hash. Keep in r8 to free rax for other work.
        mov r8, rax;

        // ---- Compute cap_desc_ptr = r13 + 128 + r15 * 32. -----------
        mov rcx, r15;
        shl rcx, 5;                            // *32
        add rcx, 128;
        add rcx, r13;                          // rcx = cap_desc_ptr

        // ---- Write CapDecl descriptor. ------------------------------
        // [+0]  name_hash u64
        mov [rcx + 0], r8;
        // [+8]  rights u64
        mov r9, [rsp + 16];
        mov [rcx + 8], r9;

        // ---- Copy inline name (up to 16 bytes; truncate past that).
        // src = rbx + cap_name_start; count = min(cap_name_len, 16).
        mov r10, [rsp + 8];                    // r10 = cap_name_len
        cmp r10, 16;
        jbe cmd_sig_pb_cap_name_copy_entry;
        mov r10, 16;                           // cap: truncate
      cmd_sig_pb_cap_name_copy_entry:
        xor r11, r11;                          // i = 0
      cmd_sig_pb_cap_name_copy:
        cmp r11, r10;
        jae cmd_sig_pb_cap_name_pad;
        mov rdi, rbx;
        add rdi, [rsp + 0];
        add rdi, r11;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, rcx;
        add rsi, 16;
        add rsi, r11;
        mov_b [rsi + 0], rax;
        add r11, 1;
        jmp cmd_sig_pb_cap_name_copy;

      cmd_sig_pb_cap_name_pad:
        // Zero-pad [16 + i .. 32).
        mov r11, r10;
        add r11, 16;
      cmd_sig_pb_cap_name_pad_loop:
        cmp r11, 32;
        jae cmd_sig_pb_cap_done;
        mov rsi, rcx;
        add rsi, r11;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r11, 1;
        jmp cmd_sig_pb_cap_name_pad_loop;

      cmd_sig_pb_cap_done:
        // Bump n_caps counter and clear scratch slots.
        add r15, 1;
        xor rax, rax;
        mov [rsp + 0], rax;
        mov [rsp + 8], rax;
        mov [rsp + 16], rax;
        jmp cmd_sig_pb_decl_loop;

        // ============================================================
        // Success exit: finalise header, pack return.
        // ============================================================
      cmd_sig_pb_done:
        // n_caps u8 at [r13 + CS_OFF_N_CAPS = 4].
        mov rax, r15;
        mov_b [r13 + 4], rax;

        // caps_len u32 at [r13 + CS_OFF_CAPS_LEN = 76] = n_caps * 32.
        mov rax, r15;
        shl rax, 5;                            // *32
        mov_d [r13 + 76], rax;

        // bytes_written = CS_HEADER_BYTES + n_caps * CS_CAP_DESC_BYTES
        //               = 128 + r15 * 32
        mov rax, r15;
        shl rax, 5;
        add rax, 128;
        // Pack (bytes_written << 32) | CS_OK (= 0).
        shl rax, 32;
        jmp cmd_sig_pb_epilogue;

        // ============================================================
        // Error paths
        // ============================================================
      cmd_sig_pb_syntax:
        mov rax, 0x3300;                       // CS_ERR_SYNTAX
        jmp cmd_sig_pb_epilogue;

      cmd_sig_pb_too_many_caps:
        mov rax, 0x3301;                       // CS_ERR_TOO_MANY_CAPS
        jmp cmd_sig_pb_epilogue;

      cmd_sig_pb_bad_stab:
        mov rax, 0x3302;                       // CS_ERR_UNKNOWN_STABILITY
        jmp cmd_sig_pb_epilogue;

      cmd_sig_pb_oos:
        mov rax, 0x3303;                       // CS_ERR_OUT_TOO_SMALL
        jmp cmd_sig_pb_epilogue;

      cmd_sig_pb_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
