// src/rank_check.pdx -- libpdx-pds-parser.R225.M6 (paideia-os#2687)
//
// RankCheck: rank-restricted let-polymorphism enforcement (P10).
// Walker-style scheme-shape validator that rejects any HmCore scheme
// byte stream whose body carries a nested `TYFORALL` / `TYSCHEME`
// constructor, together with a composite entry that threads the
// check over a LetScope-shaped binding. R225.M6 of the HM-type-
// checker umbrella (paideia-os#2489); layered over R225.M1 HmCore
// (hm_core.pdx) scheme wire format + R225.M4 EffectUnify
// (effect_unify.pdx) shape-validator precedent.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Standard Hindley-Milner is RANK-1: a let-binding may generalise its
// RHS's type scheme ONLY when every `∀` quantifier sits at the
// outermost position (i.e. not under an arrow). A rank-2 scheme has
// the form `∀a. a → ∀b. b → b` -- the inner `∀b` sits under the outer
// arrow and defies first-order unification. Classical algorithm W
// handles rank-1 schemes and refuses to synthesise rank-2 ones
// without an explicit type annotation at the function boundary.
//
// R225.M6 lands the enforcement side: a pure byte walker that
// traverses the scheme AST and refuses any body node whose kind
// byte names a quantifier/scheme carrier (`TYFORALL` = 5 or
// `TYSCHEME` = 6; both reserved for the R225.M4.1 wire-format
// extension landing nested-quantifier body nodes).  At raw M6 the
// HmCore wire format only emits kinds in `{TYVAR=1, TYCON=2,
// TYAPP=3, TYROW=4}` so a well-formed scheme produced by the
// current elaborator always passes.  The validator is forward-
// facing: the moment the M4.1 wire-format extension lands, any
// scheme whose body carries a nested quantifier is rejected
// IMMEDIATELY at this walker without a second-pass depth counter.
//
// Scope at M6:
//   * `_rc_check_scheme(scheme_ptr, scheme_len) -> status` -- primary
//     walker.  Shape validation (header consistent, bounded sizes,
//     legal kind codes) PLUS the rank-restriction gate (any
//     `TYFORALL` / `TYSCHEME` body node at any depth triggers
//     rejection).  Discriminates the specific violation subtype:
//       - body[0] with kind TYFORALL/TYSCHEME -> `RC_ERR_NESTED_FORALL`
//         (0x5811 = E0981; the root body node is itself a quantifier
//         carrier, which cannot be the SINGLE outer `∀` because the
//         header already encodes that one; so a nested quantifier at
//         the root means the scheme is doubly-quantified).
//       - body[i>0] with kind TYFORALL/TYSCHEME -> `RC_ERR_RANK_TOO_HIGH`
//         (0x5810 = E0980; a quantifier carrier sits under some other
//         body node, i.e. not at the outermost position; this is the
//         standard rank-2 refusal case).
//     The two error codes map 1:1 onto the user-facing diagnostic
//     wording "scheme has nested forall at root" vs "scheme requires
//     rank-2 (annotate at boundary)".
//
//   * `_rc_check_binding(scope_kind, scheme_ptr, scheme_len) -> status`
//     -- composite entry over a LetScope-shaped binding.  Validates
//     scope_kind in {SCOPE_LET=1, SCOPE_LETREC=2, SCOPE_LAMBDA=3}; on
//     SCOPE_LAMBDA (lambda parameter -- parameters are NOT generalised
//     per standard HM rank-1) returns `RC_OK` without walking the
//     scheme bytes; on SCOPE_LET / SCOPE_LETREC delegates to
//     `_rc_check_scheme`.  Centralises the "lambda params don't need
//     a rank check" short-circuit so each HM-elaborator call site
//     doesn't have to replicate it.
//
//   * `_rc_init()` -- bare `ret`.  M6 holds NO `.bss` state (the
//     walker is purely over caller-supplied scheme bytes).  Kept for
//     parallelism with the parser-family init-hook convention
//     (`_eu_check_rank` has no init; `_lp_init`, `_st_init`,
//     `_ha_init`, `_ws_init`, `_ds_init`, `_dm_init`, `_cmdreg_init`
//     all exist as bare `ret` or near-bare `ret` entry points for the
//     later-M landing that adds `.bss` state, e.g. a per-REPL-turn
//     violation counter at M6.1).
//
// Out of scope at raw M6 (deferred to M6.1+ follow-ups):
//   * `RC_ERR_PREDICATIVE_VIOLATION` (0x5812 = E0982): predicative
//     polymorphism refuses `∀a. a` as an argument to a type
//     constructor.  Requires discriminating "nested forall under an
//     arrow" from "nested forall under a type-constructor arg" --
//     the latter needs the TyApp body node + its arg-list structure
//     to be walked.  Reserved for M6.2 when the HmCore wire format
//     exposes TyApp-head discrimination (via a bit in the arity byte
//     or a dedicated kind code for "type-constructor application"
//     distinct from "function application").
//
//   * `RC_ERR_UNANNOTATED_BOUNDARY` (0x5813 = E0983): the diagnostic
//     the user sees when their code demands rank-2 but has no
//     explicit annotation at the boundary.  Reserved for M6.3 when
//     the lambda-literal grammar lands annotation-at-boundary syntax
//     (`\(f :: ∀a. a → a). f 1 ; f "hi"`).
//
//   * Scheme byte stream delegation from `_rc_check_binding` through
//     a LetScope frame: raw M6 asks the caller to supply the scheme
//     bytes directly rather than dereferencing a frame's
//     `type_scheme_ref` u32 (which is caller-opaque: HmCore pool_idx
//     at raw M5 or TypeEnv scheme_id at the M5.1 wire-up).  M6.1
//     wires `_ls_resolve` -> scheme-materialiser -> `_rc_check_scheme`
//     once the HmCore `_hm_materialise_scheme(pool_idx, out_buf,
//     out_cap)` entry lands.
//
// The parser is user-space (satellite library) because the shell runs
// in user space; the kernel-side substrate (R107+) never touches
// rank-restriction annotation bytes directly.
//
// =============================================================================
// HM STANDARD SEMANTICS
// =============================================================================
//
// Rank-1 definition.  A type scheme `σ` is RANK-1 iff
//   σ ::= ∀a_1 ... a_n. τ          where τ is a MONOTYPE (no ∀).
// A rank-2 scheme has the shape
//   ∀a_1 ... a_n. (∀b_1 ... b_m. τ_arg) → τ_result
// -- the inner `∀b_j` quantifier sits under the arrow's domain, which
// first-order unification cannot handle without higher-order
// matching.  Standard HM (Milner 1978, Damas-Milner 1982) is a rank-1
// language.  System F (Girard 1972) allows arbitrary ranks; Haskell
// requires `-XRankNTypes` + explicit annotations to lift above rank-1.
//
// Why reject.  The HM elaborator's `_hm_generalise` and
// `_hm_instantiate` only quantify fresh TyVars at the scheme header
// position (bound_var_ids array).  A nested `∀` in the body would
// have to carry its OWN bound-var list, which the current wire format
// cannot represent (kind byte max = TYROW = 4).  The M4.1 wire-format
// extension adds TYFORALL/TYSCHEME body kinds; at that point the
// elaborator could in principle synthesise rank-2 schemes from
// explicit annotations.  Without the enforcement gate here, those
// schemes would silently flow into `_hm_unify`'s TyApp arm, which
// would unify a TyVar against a TyApp whose children recursively
// contain more TyVars quantified at a different scope level, and
// return nonsensical substitutions -- a hard-to-diagnose soundness
// bug.  THIS module slams the door shut.
//
// Workaround at the user source level.  When a shell user genuinely
// needs rank-2 (e.g. a higher-rank combinator passing a polymorphic
// function to multiple instantiations inside its body), the surface
// syntax must carry an EXPLICIT annotation at the boundary:
//
//     let runId : (∀a. a → a) → () = \f. (f 1; f "hi"; ())
//
// The annotation defeats inference ambiguity by naming the
// higher-rank type at the function-argument position.  Raw M6 does
// NOT recognise this annotation syntax (the lambda-literal grammar
// at R224.M1 is rank-1 by construction); the M6.3 landing introduces
// the annotation parser and threads the resulting scheme through to
// the elaborator without passing it through this check.
//
// =============================================================================
// SCHEME WIRE FORMAT  (mirror of HmCore)
// =============================================================================
//
//   [+0]   u32  n_bound_vars        (count of generalised vars)
//   [+4]   u32  n_body_nodes        (count of body nodes; >= 1)
//   [+8]   u32[n_bound_vars]        bound_var_ids    (sorted ascending)
//   [+8 + 4*n_bound_vars]
//          TypeNode[n_body_nodes]   body             (16-byte stride each)
//
// Per-node layout (16-byte stride):
//   [+0]   u8   kind
//   [+1]   u8   arity (TyCon's declared arity; 0 for TyVar/TyApp)
//   [+2]   u8   depth / reserved
//   [+3]   u8   flags (bit 0 = HM_VARFLAG_EXTERNAL for TyVar)
//   [+4]   u32  arg0 (var_id | con_id | left-child body-idx)
//   [+8]   u32  arg1 (right-child body-idx | field count)
//   [+12]  u32  resolved (TyVar substitution target in the LIVE pool)
//
// Legal kind codes at raw M6:
//   HM_KIND_TYVAR    = 1
//   HM_KIND_TYCON    = 2
//   HM_KIND_TYAPP    = 3
//   HM_KIND_TYROW    = 4  (R225.M2 RowTypes extension)
//
// Reserved kind codes (M4.1 wire-format extension):
//   HM_KIND_TYFORALL = 5  (body-level ∀; THIS module rejects)
//   HM_KIND_TYSCHEME = 6  (nested scheme reference; THIS module rejects)
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- band values 0x5800..0x58FF fit imm32.
//   - No 2-op `imul r, imm` -- 16-byte node stride is `shl r, 4`;
//     4-byte u32 scratch stride is `shl r, 2`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `RankCheck` matches `rank_check.pdx`.
//   - Labels prefixed `rc_` (unique against the sibling parser-tier
//     modules: u8n_ (R221.M1), gi_ (R221.M2), wp_ (R221.M3), cl_
//     (R221.M4), ast_ (R221.M5), sm_ (R221.M6), fh_ (R221.M7),
//     sch_sig_ (R222.M1), cmd_sig_ (R222.M2), fi_ (R222.M3), afs_
//     (R222.M4), cmdreg_ (R222.M5), dm_ (R222.M6), ds_ (R222.M8),
//     pl_ (R223.M1), rp_ (R223.M2), fo_ (R223.M3), sgr_ (R223.M4),
//     ws_ (R223.M5), ha_ (R223.M6), st_ (R223.M7), ll_ (R224.M1),
//     cc_ (R224.M2), er_ (R224.M3), cr_ (R224.M4), ls_ (R224.M5),
//     pl_lam_ (R224.M6), lp_ (R224.M7), hm_ (R225.M1), rt_ (R225.M2),
//     eu_ (R225.M4), dl_ (R226.M1), se_ (R229.M2), te_ (R229.M3),
//     jc_ (R229.M4), h_ (R229.M5), le_ (R229.M6), vi_ (R229.M7)).
//     Never bare `loop`/`if`/`let`/`fn`/`ret`/`done`.
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 5, 6, 8, 16, 64,
//     128, status codes 0x5800..0x5813) fit imm32 with bit 31 clear
//     so direct `cmp reg, imm32` is sign-extension-safe.
//   - Byte loads via `xor r,r; mov_b r,[base + idx * 1]` on reg+reg;
//     `xor r,r; mov_b r,[base + imm_disp]` on reg+disp.
//   - u32 loads via `xor r,r; mov_d r,[base + imm_disp]` (zero-
//     extends per SDM Vol.1 3.4.1.1).
//   - No stores (the walker is read-only over caller buffers).
//   - Cross-module .bss not written at raw M6 (M6.1 wire-up adds the
//     per-REPL-turn violation counter in this module's own .bss).
//   - Register-liveness: `_rc_check_scheme` is a PURE LEAF (zero
//     nested CALL; zero callee-save pushes; r11 scratch-free).
//     `_rc_check_binding` has one intra-module nested CALL to
//     `_rc_check_scheme`; a single `sub rsp, 8` aligns the stack for
//     SysV and no callee-save push is needed (the three argument
//     registers rdi/rsi/rdx are either consumed verbatim or
//     overwritten by the delegate call setup).
//   - `_rc_init` is a bare `ret` (no `.bss` state at raw M6).
//
// =============================================================================
// WAVE 128 LESSONS APPLIED
// =============================================================================
//
//   * `_eu_check_rank` precedent (R225.M4, Wave 123) is the direct
//     ancestor: both validate a scheme byte stream against the same
//     wire format; both are pure byte walkers with zero `.bss`
//     interaction.  `_eu_check_rank`'s shape-validation phase
//     byte-for-byte serves as the first half of `_rc_check_scheme`'s
//     work; the second half (nested-quantifier detection) extends
//     the kind-byte switch to recognise TYFORALL / TYSCHEME.
//   * Lazy-init pattern NOT applied -- the module has no `.bss` at
//     raw M6; the pattern reapplies at M6.1 when the per-REPL-turn
//     violation counter lands.
//   * No chained-displacement operands.  Three-term address
//     computations (`scheme_ptr + body_offset + i*16`) are
//     pre-computed into r11 or r10 via `mov; shl; add; add`
//     sequences; every byte load is a two-register form or a
//     reg+disp form with imm fitting in a signed 32-bit field.
//   * All status-code immediates (0x5800..0x5813) fit imm32 with
//     bit 31 clear so direct `cmp reg, imm32` / `mov reg, imm32`
//     is sign-safe; no MOVABS staging needed.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M6.1  `.bss` violation counter + per-REPL-turn fingerprint
//              (one u64; mirrors `_dm_light_count` / `_dm_heavy_count`
//              precedent at R222.M6).
//   R225.M6.2  `RC_ERR_PREDICATIVE_VIOLATION` wire-up when the HmCore
//              TyApp body node exposes head-discrimination (M4.1
//              wire-format extension needed).
//   R225.M6.3  `RC_ERR_UNANNOTATED_BOUNDARY` wire-up when the lambda-
//              literal grammar (R224.M1) learns annotation-at-
//              boundary syntax (`\(f :: ∀a. a → a). ...`).
//   R225.M6.4  `_rc_check_binding` dereferences a LetScope frame
//              directly (requires `_ls_resolve` + a HmCore scheme-
//              materialiser).
//   R225.M6.5  20-test adversarial corpus + fingerprint goldens
//              (`tests/proptest_rank_check.pdx`); the design doc §9
//              enumerates the 20 cases so a late-landing test
//              harness can golden them from the spec.
//
// =============================================================================
// Upstream: paideia-os#2687 (THIS ticket, R225.M6). Design doc:
// design/shell/rank-restricted-polymorphism.md. Related plans:
// design/terminal/semantic-shell-language-plan.md section R225.M6,
// design/shell/hm-algorithm-w-core.md (R225.M1 scheme wire format),
// design/shell/effect-row-unification.md (R225.M4 _eu_check_rank
// precedent), design/shell/let-in-scoping.md (R224.M5 LetScope frame
// shape for the M6.4 wire-up).

module RankCheck = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Band 0x5800..0x58FF, carved on a kilo-step boundary past the
  // Wave-128 bands (R223.M7 SessionType 0x5500..0x55FF; R224.M7
  // LinearPropagate 0x5600..0x56FF; R229.M7 ViMode 0x5700..0x57FF)
  // and past all prior landed bands.  Slots 0x5814..0x58FF reserved
  // for M6.1+ follow-ups.
  //
  // Diagnostic-family mapping (E0980 family per the issue brief):
  //   E0980_RANK_TOO_HIGH         -> RC_ERR_RANK_TOO_HIGH          (0x5810)
  //   E0981_NESTED_FORALL         -> RC_ERR_NESTED_FORALL          (0x5811)
  //   E0982_PREDICATIVE_VIOLATION -> RC_ERR_PREDICATIVE_VIOLATION  (0x5812)
  //   E0983_UNANNOTATED_BOUNDARY  -> RC_ERR_UNANNOTATED_BOUNDARY   (0x5813)

  pub let RC_OK                           : u64 = 0
  pub let RC_ERR_BAD_SCHEME               : u64 = 0x5800
  pub let RC_ERR_RANK_TOO_HIGH            : u64 = 0x5810
  pub let RC_ERR_NESTED_FORALL            : u64 = 0x5811
  pub let RC_ERR_PREDICATIVE_VIOLATION    : u64 = 0x5812
  pub let RC_ERR_UNANNOTATED_BOUNDARY     : u64 = 0x5813

  // ==========================================================================
  // SECTION 2 -- KIND + LAYOUT CONSTANTS (mirror HmCore)
  // ==========================================================================
  //
  // Legal M6 wire-format kinds:
  pub let RC_HM_KIND_TYVAR                : u64 = 1
  pub let RC_HM_KIND_TYCON                : u64 = 2
  pub let RC_HM_KIND_TYAPP                : u64 = 3
  pub let RC_HM_KIND_TYROW                : u64 = 4

  // Reserved M4.1 wire-format extension kinds (rejected by this walker):
  pub let RC_HM_KIND_TYFORALL             : u64 = 5
  pub let RC_HM_KIND_TYSCHEME             : u64 = 6

  // LetScope kind discriminators (mirror LetScope):
  pub let RC_SCOPE_LET                    : u64 = 1
  pub let RC_SCOPE_LETREC                 : u64 = 2
  pub let RC_SCOPE_LAMBDA                 : u64 = 3

  // Scheme wire-format offsets + bounds (mirror HmCore):
  pub let RC_SCHEME_HDR_BYTES             : u64 = 8
  pub let RC_SCHEME_OFF_NBOUND            : u64 = 0
  pub let RC_SCHEME_OFF_NBODY             : u64 = 4
  pub let RC_SCHEME_MAX_BOUND             : u64 = 64
  pub let RC_SCHEME_MAX_BODY              : u64 = 128
  pub let RC_SCHEME_NODE_BYTES            : u64 = 16

  pub let RC_OFF_KIND                     : u64 = 0

  // ==========================================================================
  // _rc_init() -> ()
  //
  //   Bare `ret`.  Raw M6 holds NO `.bss` state; the walker is purely
  //   over caller-supplied scheme bytes.  The entry point exists for
  //   parallelism with the parser-family init-hook convention so a
  //   later landing that adds `.bss` (per-REPL-turn violation counter
  //   at M6.1) does not break the API.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed rc_ini_.
  // ==========================================================================
  pub let _rc_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R225.M6 (#2687): _rc_init is a bare ret. Raw M6 holds NO .bss state; the entry exists for parallelism with the parser-family init-hook convention (_st_init R223.M7, _lp_init R224.M7, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5) so a later landing that adds .bss (per-REPL-turn violation counter at M6.1) does not break the API. Zero callee-save pushes; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rc_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _rc_check_scheme(scheme_ptr, scheme_len) -> status
  //
  //   rdi = scheme_ptr      (byte pointer to a HmCore scheme stream)
  //   rsi = scheme_len      (byte length of the scheme)
  //   rax = RC_OK (0) or RC_ERR_BAD_SCHEME (0x5800) /
  //         RC_ERR_RANK_TOO_HIGH (0x5810) /
  //         RC_ERR_NESTED_FORALL (0x5811)
  //
  // Validate a HmCore scheme byte stream against the P10 rank
  // restriction: "type schemes may bind type variables only at the
  // OUTERMOST position; nested ∀ cannot generalise".
  //
  // Flow:
  //   1. scheme_len >= 8 (header fits).  BAD_SCHEME on fail.
  //   2. Load n_bound_vars (u32 at +0); cmp > 64 -> BAD_SCHEME.
  //   3. Load n_body_nodes (u32 at +4); cmp == 0 or > 128 ->
  //      BAD_SCHEME.
  //   4. expected_len = 8 + 4*n_bound + 16*n_body; cmp != scheme_len
  //      -> BAD_SCHEME.
  //   5. body_offset = 8 + 4*n_bound.  Walk body nodes i = 0..n_body:
  //      - Load kind byte at &scheme_ptr + body_offset + i*16.
  //      - If kind in {1, 2, 3, 4}: continue (legal M6 kind).
  //      - If kind == 5 (TYFORALL) OR kind == 6 (TYSCHEME):
  //          If i == 0: return NESTED_FORALL.
  //          Else:      return RANK_TOO_HIGH.
  //      - Else: return BAD_SCHEME (unknown kind).
  //   6. All body nodes passed -> return RC_OK.
  //
  // Pure byte walker over caller data -- no callee-save push, no
  // stack frame, no nested CALL.  Labels prefixed rc_cs_.
  // ==========================================================================
  pub let _rc_check_scheme : (u64, u64) -> u64 !{mem} @{} =
    fn (scheme_ptr: u64) (scheme_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M6 (#2687): _rc_check_scheme validates a HmCore scheme byte stream against the P10 rank restriction. Pure byte walker over caller data; zero callee-save pushes; no stack frame; no nested CALL. Flow: (1) rsi (scheme_len) >= 8 else BAD_SCHEME; (2) load n_bound_vars via xor rax,rax; mov_d rax,[rdi+0]; cmp > 64 BAD_SCHEME; (3) load n_body_nodes via xor rcx,rcx; mov_d rcx,[rdi+4]; cmp == 0 BAD_SCHEME; cmp > 128 BAD_SCHEME; (4) expected_len = 8 + 4*n_bound + 16*n_body; r9 := rax; shl r9,2; r10 := rcx; shl r10,4; add r9,r10; add r9,8; cmp r9 == rsi else BAD_SCHEME; (5) body_offset = 8 + 4*n_bound stashed in r8 via mov r8,rax; shl r8,2; add r8,8. For i = 0..n_body (r9 = i; rcx = n_body as loop bound): node_addr = rdi + r8 + r9*16 computed as r10 := r9; shl r10,4; add r10,r8; r11 := rdi; add r11,r10; load kind byte via xor rdx,rdx; mov_b rdx,[r11+0]; cmp in {1,2,3,4} (TYVAR..TYROW) legal; cmp == 5 (TYFORALL) -> if r9==0 NESTED_FORALL else RANK_TOO_HIGH; cmp == 6 (TYSCHEME) -> if r9==0 NESTED_FORALL else RANK_TOO_HIGH; else BAD_SCHEME. Return RC_OK on fall-through. All cmp immediates (0, 1, 2, 3, 4, 5, 6, 8, 64, 128, status codes 0x5800/0x5810/0x5811) fit imm32 with bit 31 clear. Byte load via xor r,r; mov_b r,[base + imm_disp] (two-register form after r11 pre-compute). u32 loads via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rc_cs_.",
      block: {
        // (1) scheme_len >= 8 (header).
        cmp rsi, 8;                            // RC_SCHEME_HDR_BYTES
        jb  rc_cs_bad_scheme;

        // (2) Load n_bound_vars.
        xor rax, rax;
        mov_d rax, [rdi + 0];                  // n_bound_vars u32
        cmp rax, 64;                           // RC_SCHEME_MAX_BOUND
        ja  rc_cs_bad_scheme;

        // (3) Load n_body_nodes.
        xor rcx, rcx;
        mov_d rcx, [rdi + 4];                  // n_body_nodes u32
        cmp rcx, 0;
        je  rc_cs_bad_scheme;
        cmp rcx, 128;                          // RC_SCHEME_MAX_BODY
        ja  rc_cs_bad_scheme;

        // (4) expected_len = 8 + 4*n_bound + 16*n_body.
        //   r9 = 4 * n_bound.
        mov r9, rax;
        shl r9, 2;
        //   r10 = 16 * n_body.
        mov r10, rcx;
        shl r10, 4;
        add r9, r10;
        add r9, 8;
        cmp r9, rsi;
        jne rc_cs_bad_scheme;

        // (5) Walk body nodes; validate kind + rank gate.
        //   body_offset = 8 + 4*n_bound; stash in r8.
        mov r8, rax;
        shl r8, 2;
        add r8, 8;

        //   i = 0 in r9; n_body in rcx.
        xor r9, r9;

      rc_cs_body_loop:
        cmp r9, rcx;
        jae rc_cs_ok;

        // node_addr = rdi + r8 + r9 * 16.
        //   r10 = r9 * 16; r10 += r8; r11 = rdi + r10.
        mov r10, r9;
        shl r10, 4;
        add r10, r8;
        mov r11, rdi;
        add r11, r10;

        // Load kind byte.
        xor rdx, rdx;
        mov_b rdx, [r11 + 0];

        // Legal M6 kinds: {TYVAR=1, TYCON=2, TYAPP=3, TYROW=4}.
        cmp rdx, 1;                            // RC_HM_KIND_TYVAR
        je  rc_cs_body_next;
        cmp rdx, 2;                            // RC_HM_KIND_TYCON
        je  rc_cs_body_next;
        cmp rdx, 3;                            // RC_HM_KIND_TYAPP
        je  rc_cs_body_next;
        cmp rdx, 4;                            // RC_HM_KIND_TYROW
        je  rc_cs_body_next;

        // Reserved M4.1 kinds: TYFORALL=5 / TYSCHEME=6 -> rank violation.
        cmp rdx, 5;                            // RC_HM_KIND_TYFORALL
        je  rc_cs_rank_violation;
        cmp rdx, 6;                            // RC_HM_KIND_TYSCHEME
        je  rc_cs_rank_violation;

        // Unknown kind -> schema malformed.
        jmp rc_cs_bad_scheme;

      rc_cs_body_next:
        add r9, 1;
        jmp rc_cs_body_loop;

      rc_cs_rank_violation:
        // r9 holds the offending body index.
        //   r9 == 0 -> nested forall at the root (header already carries
        //              the single outer ∀; a root quantifier body node
        //              means the scheme is doubly-quantified).
        //   r9 > 0  -> rank-2 (quantifier under some parent).
        cmp r9, 0;
        je  rc_cs_nested_forall;
        mov rax, 0x5810;                       // RC_ERR_RANK_TOO_HIGH
        ret;

      rc_cs_nested_forall:
        mov rax, 0x5811;                       // RC_ERR_NESTED_FORALL
        ret;

      rc_cs_ok:
        xor rax, rax;                          // RC_OK
        ret;

      rc_cs_bad_scheme:
        mov rax, 0x5800;                       // RC_ERR_BAD_SCHEME
        ret;
      }
    }

  // ==========================================================================
  // _rc_check_binding(scope_kind, scheme_ptr, scheme_len) -> status
  //
  //   rdi = scope_kind      (1 = SCOPE_LET, 2 = SCOPE_LETREC,
  //                          3 = SCOPE_LAMBDA; mirror LetScope)
  //   rsi = scheme_ptr      (byte pointer to a HmCore scheme stream)
  //   rdx = scheme_len      (byte length of the scheme)
  //   rax = RC_OK (0) or RC_ERR_BAD_SCHEME (0x5800) or any
  //         `_rc_check_scheme` error code.
  //
  // Composite entry over a LetScope-shaped binding.  Validates
  // scope_kind in [1..3] (BAD_SCHEME on fail); on SCOPE_LAMBDA (3)
  // returns RC_OK WITHOUT walking the scheme bytes (lambda params
  // are NOT generalised per standard HM); on SCOPE_LET (1) /
  // SCOPE_LETREC (2) delegates to `_rc_check_scheme`.
  //
  // Centralises the "lambda params don't need a rank check" short-
  // circuit so each HM-elaborator call site doesn't have to
  // replicate it.  M6.4 wires this entry to dereference a LetScope
  // frame directly; raw M6 asks the caller to supply the kind +
  // scheme bytes explicitly.
  //
  // Register map: zero callee-save push + sub rsp, 8 (align only;
  // r11/rax/rcx are the only scratch regs touched; rdi/rsi/rdx are
  // the arg triple).  Entry rsp%16 == 8; after sub rsp,8 rsp%16 == 0
  // so the single intra-module nested CALL to `_rc_check_scheme` sees
  // aligned stack.  Labels prefixed rc_cb_.
  // ==========================================================================
  pub let _rc_check_binding : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scope_kind: u64) (scheme_ptr: u64) (scheme_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M6 (#2687): _rc_check_binding is the composite entry over a LetScope-shaped binding. Zero callee-save pushes + sub rsp,8 align = 8 B frame; entry rsp%16==8, after sub rsp,8 rsp%16==0 at the single intra-module nested CALL to _rc_check_scheme. Flow: (1) cmp rdi,0 je bad_kind (return 0x5800 BAD_SCHEME); (2) cmp rdi,3 ja bad_kind (reject kind > 3); (3) cmp rdi,3 je lambda_ok (SCOPE_LAMBDA short-circuit: lambda params are NOT generalised per standard HM; return RC_OK WITHOUT walking the scheme bytes); (4) SCOPE_LET (1) or SCOPE_LETREC (2) fall through: setup delegate call mov rdi,rsi; mov rsi,rdx; call _rc_check_scheme; return its rax verbatim. All cmp immediates (0, 1, 3, status code 0x5800) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rc_cb_.",
      block: {
        sub rsp, 8;                            // align for nested CALL

        // Validate scope_kind in [1..3].
        cmp rdi, 0;
        je  rc_cb_bad_kind;
        cmp rdi, 3;
        ja  rc_cb_bad_kind;

        // SCOPE_LAMBDA (3) -> short-circuit RC_OK.
        cmp rdi, 3;
        je  rc_cb_lambda_ok;

        // SCOPE_LET (1) or SCOPE_LETREC (2) -> delegate to _rc_check_scheme.
        mov rdi, rsi;                          // scheme_ptr
        mov rsi, rdx;                          // scheme_len
        call _rc_check_scheme;
        jmp rc_cb_epilogue;

      rc_cb_lambda_ok:
        xor rax, rax;                          // RC_OK
        jmp rc_cb_epilogue;

      rc_cb_bad_kind:
        mov rax, 0x5800;                       // RC_ERR_BAD_SCHEME
        jmp rc_cb_epilogue;

      rc_cb_epilogue:
        add rsp, 8;
        ret;
      }
    }

}
