// src/hm_core.pdx -- libpdx-pds-parser.R225.M1 (paideia-os#2682)
//
// HmCore: Hindley-Milner Algorithm W core -- unification + principal
// type reconstruction over a reduced type grammar. Shared substrate
// for the three semantic-shell sub-languages (lambda-lang records,
// pipeline-record rows, Datalog predicate signatures) that R225.M2+
// will layer on top.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R225 is the typechecker umbrella (design/terminal/semantic-shell-
// language-plan.md section "R225 -- Unified HM type checker across
// three sub-languages"). M1 (THIS module) lands the Robinson/Damas-
// Milner 1982 kernel: fresh variables, union-find-style TyVar
// resolution with occurs-check, type-scheme instantiation, and
// let-polymorphism-style generalisation.
//
// The checker runs USER-SPACE because the shell runs user-space; the
// pool is caller-process-local (static .bss, singleton), the module
// touches no kernel KIND and consumes no capability. See caps.decl
// R225 band note.
//
// M1 covers the pure lambda subset of Damas-Milner only. Row types
// (R225.M2), schema-driven Datalog predicate types (R225.M3), effect
// rows (R225.M4), rank-restricted enforcement (R225.M6) all land as
// additive wrappers that read M1's pool + call M1's unifier.
//
// =============================================================================
// TYPE REPRESENTATION  --  16-BYTE TypeNode
// =============================================================================
//
// Stride 16 is a power of two so node addressing uses `shl rN, 4` --
// never 2-op `imul r, imm` (feedback_pdx_encoder_pitfalls). The
// 16-byte layout mirrors the SchemasSig field descriptor stride,
// which lets a future R225.M3 bridge copy a type-code byte between
// the two schemas without a widen.
//
//   [+0]   kind     (u8)   1 = TyVar, 2 = TyCon, 3 = TyApp (0 = unused)
//   [+1]   arity    (u8)   TyCon: declared arity; TyApp: 2; TyVar: 0.
//   [+2]   depth    (u8)   Occurs-check short-circuit hint (0 at mint).
//   [+3]   flags    (u8)   TyVar bit 0 (HM_VARFLAG_EXTERNAL) distinguishes
//                          a scheme-body external pool-ref from a bound
//                          var slot; cleared on pool nodes.
//   [+4]   arg0     (u32)  TyVar: var_id; TyCon: con_id;
//                          TyApp: left child pool index.
//   [+8]   arg1     (u32)  TyApp: right child pool index; 0 for TyVar/TyCon.
//   [+12]  resolved (u32)  TyVar: 0 (= unresolved) OR the pool_idx this
//                          var has been substituted to. 0 for TyCon/TyApp.
//
// Pool index 0 is RESERVED as the "null" sentinel; _hm_pool_next is
// lazily initialised to 1 on first allocation, so valid pool indices
// are 1..127 (giving 127 usable nodes out of a 128-node pool).
//
// =============================================================================
// TYPE CONSTRUCTOR REGISTRY  --  M1 SUBSET
// =============================================================================
//
// Nullary (base) type constructors:  u64, i64, str, bool, path, pid.
// Binary type constructors:          fn, tuple.
//
// A function type `A -> B` is modelled as TyApp(TyApp(TyCon(fn), A), B)
// -- Curry-encoded so that each application layer is binary and reuses
// the generic TyApp unification arm. Equivalent shape for `tuple A B`.
// Higher-arity tuples (R225.M2+) nest TyApp accordingly.
//
//   u64    -> HM_CON_U64    = 1
//   i64    -> HM_CON_I64    = 2
//   str    -> HM_CON_STR    = 3
//   bool   -> HM_CON_BOOL   = 4
//   path   -> HM_CON_PATH   = 5
//   pid    -> HM_CON_PID    = 6
//   fn     -> HM_CON_FN     = 7   (binary)
//   tuple  -> HM_CON_TUPLE  = 8   (binary at M1; k-ary at M2 via nesting)
//
// The low-value codes 1..6 deliberately overlap SchemasSig's SS_TYPE_*
// codes (u64=1, i64=2, str=3, hex=4, hash32=5, tsc=6 there) only at
// the integer level; the two naming spaces are disjoint and no byte
// is reused across the two surfaces. R225.M3 (Datalog predicate types)
// bridges SchemasSig field types into HmCore TyCons via a 1:1 remap
// table that lives alongside the schema registry.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _hm_fresh_var() -> u64
//     Mint a new TyVar with a unique var_id and resolved=0 (unresolved).
//     Returns pool_idx (>= 1) on success, or 0 on pool-full.
//
//   _hm_unify(a_idx, b_idx) -> errno
//     Robinson unification over the type graph. On success the pool
//     is extended with substitutions (every bound TyVar's `resolved`
//     field is set to the pool index it was unified with). Return
//     codes:
//        HM_OK                 (0)       unified; graph updated.
//        HM_ERR_OCCURS         (0x2D00)  cyclic unification.
//        HM_ERR_MISMATCH       (0x2D01)  constructor / arity mismatch.
//
//   _hm_instantiate(scheme_ptr, scheme_len, out_idx_ptr) -> errno
//     Fresh-instantiate a scheme (universally quantified type) into
//     the pool, returning the root pool index via *out_idx_ptr.
//     Return codes:
//        HM_OK                 (0)
//        HM_ERR_POOL_FULL      (0x2D02)
//        HM_ERR_OUT_TOO_SMALL  (0x2D03)  scheme bytes don't match header
//        HM_ERR_MISMATCH       (0x2D01)  malformed scheme (bad var ref,
//                                        out-of-range body ref).
//
//   _hm_generalise(ty_idx, env_ptr, env_len, out_scheme_ptr, out_cap)
//     -> errno
//     Walk the type graph reachable from ty_idx (following resolved
//     chains for TyVars), filter the free TyVars against the env
//     type set (passed as env_ptr pointing to u32 pool indices,
//     env_len entries), and emit a scheme into out_scheme_ptr.
//     Vars in env_free_vars are emitted as HM_VARFLAG_EXTERNAL body
//     references; vars NOT in env_free_vars are the generalised
//     bound set.
//        HM_OK                 (0)
//        HM_ERR_OUT_TOO_SMALL  (0x2D03)  out_cap < required bytes
//        HM_ERR_MISMATCH       (0x2D01)  bad env ref
//
// Register maps (SysV):
//
//   _hm_fresh_var() -> rax
//   _hm_unify(rdi, rsi) -> rax
//   _hm_instantiate(rdi, rsi, rdx) -> rax
//   _hm_generalise(rdi, rsi, rdx, rcx, r8) -> rax
//
// =============================================================================
// SCHEME WIRE FORMAT
// =============================================================================
//
// A scheme is a flat byte stream:
//
//   [+0]   u32  n_bound_vars        (count of generalised vars)
//   [+4]   u32  n_body_nodes        (count of body nodes; >= 1)
//   [+8]   u32[n_bound_vars]        bound_var_ids    (sorted ascending)
//   [+8 + 4*n_bound_vars]
//          TypeNode[n_body_nodes]   body             (16-byte stride each)
//
// body[0] is the root. For TyApp body nodes, arg0 / arg1 carry BODY-
// RELATIVE indices (0..n_body_nodes-1). For TyVar body nodes:
//   - flags bit 0 = 0 (HM_VARFLAG_BOUND)    => arg0 = var_id (looked
//                                             up in bound_var_ids;
//                                             refreshed on instantiate)
//   - flags bit 0 = 1 (HM_VARFLAG_EXTERNAL) => arg0 = pool_idx of a
//                                             live-pool var that is
//                                             preserved verbatim on
//                                             instantiate (via resolved
//                                             chain).
// TyCon body nodes carry con_id in arg0 and declared arity in arity.
//
// Total scheme size: 8 + 4*n_bound_vars + 16*n_body_nodes bytes.
//
// =============================================================================
// WORKING MEMORY  --  singleton .bss
// =============================================================================
//
//   _hm_pool          [u8; 2048]  128 TypeNode slots (idx 0 reserved;
//                                 valid 1..127).
//   _hm_subst_table   [u8; 512]   scratch (bound-var map for instantiate;
//                                 pool->body map + env-var list for
//                                 generalise).
//   _hm_pool_next     u64         next free pool index (lazy-init to 1).
//   _hm_var_next      u64         next var_id (starts at 0 in .bss).
//
// The .bss zero-init means a fresh process starts with an empty pool
// and var_id 0 as the first fresh var. Callers that want a scoped
// pool reset can call _hm_reset (M2+); M1 does NOT expose a reset
// hook because the single caller (shell type-check pipeline, R225.M4+)
// is scoped to one REPL turn.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- flag masks are imm32 (bit 0 via `and r, 1`
//     is imm8, well within imm32 safe band).
//   - No 2-op `imul r, imm` -- stride multiplies are `shl r, 4` (* 16)
//     for node index, `shl r, 2` (* 4) for u32 arrays, `shl r, 3`
//     (* 8) for u64 arrays, `shl r, 1` (* 2) for u16 arrays.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `HmCore` matches `hm_core.pdx`.
//   - Labels prefixed `hm_` (never `loop`/`if`/`let`/`fn`/`ret` -- all
//     reserved). The prefix is unique against the other R221/R222/R223
//     parser-tier modules in this library (`u8n_`, `sch_sig_`, `pl_`).
//   - All `cmp reg, imm` immediates <= 0x2D03 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging
//     needed for status codes.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`;
//     u32 loads via `mov_d rax, [base + idx]` (zero-extends per
//     SDM Vol.1 3.4.1.1); u64 loads via plain `mov rax, [base + idx]`.
//   - u32 stores via `mov_d`; u16 stores via two `mov_b` (low/high);
//     u8 stores via `mov_b`.
//   - Cross-module .bss writes via `lea r11, [rip + sym]; mov [r11], rax`
//     per the audit_record.pdx / mkfs.pdxfs refusal.pdx precedent.
//   - _hm_unify and _hm_occurs are recursive (self-recursive via the
//     symbol table); max recursion depth is bounded by pool size
//     (127 nodes). Each 7-push frame is 56 bytes -> worst-case stack
//     usage ~7 KiB, well within user-space stack budget.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M2  Row-polymorphic record types layered on this pool
//            (adds HM_CON_ROW_* constructors + row-unification).
//   R225.M3  Schema-registry Datalog predicate types: adds a bridge
//            that materialises an HmCore type from a SchemasSig
//            descriptor array.
//   R225.M4  Effect-row unification: a second row kind over the same
//            pool, reusing _hm_unify's TyApp arm.
//   R225.M6  Rank-restricted let-polymorphism: generalise refuses
//            to lift rank-2 schemes (detected via a scheme-depth
//            counter on the body walk).
//   R225.M7  Error-span attribution: wrap every HM_ERR_* return with
//            a source span from the caller's AST walker.
//   R229.M3  Session-scoped type-environment threading: the REPL
//            keeps a stable _hm_pool across turns, with a scoped
//            reset hook retiring per-turn transient nodes.
//
// =============================================================================
// Upstream: paideia-os#2682 (THIS ticket, R225.M1). Design doc:
// design/shell/hm-algorithm-w-core.md. Related plan:
// design/terminal/semantic-shell-language-plan.md §R225.

module HmCore = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Small-value range 0x2D00..0x2DFF, reserved for R225 typechecker.
  // Disjoint from the R221 parser band (0x2700..), the R223 pipeline
  // band (0x2B00..), the R222 cmd-functor band (0x2A00..), and every
  // user-space 0xFFFFExxx error-slice band.
  //
  // Grep confirmation at R225.M1 landing time:
  //   grep -rE '0x2D0[0-3]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this module.

  pub let HM_OK                : u64 = 0
  pub let HM_ERR_OCCURS        : u64 = 0x2D00
  pub let HM_ERR_MISMATCH      : u64 = 0x2D01
  pub let HM_ERR_POOL_FULL     : u64 = 0x2D02
  pub let HM_ERR_OUT_TOO_SMALL : u64 = 0x2D03

  // ==========================================================================
  // SECTION 2 -- NODE KIND + CON-ID + FLAG CODES
  // ==========================================================================

  pub let HM_KIND_UNUSED  : u64 = 0
  pub let HM_KIND_TYVAR   : u64 = 1
  pub let HM_KIND_TYCON   : u64 = 2
  pub let HM_KIND_TYAPP   : u64 = 3

  pub let HM_CON_U64      : u64 = 1
  pub let HM_CON_I64      : u64 = 2
  pub let HM_CON_STR      : u64 = 3
  pub let HM_CON_BOOL     : u64 = 4
  pub let HM_CON_PATH     : u64 = 5
  pub let HM_CON_PID      : u64 = 6
  pub let HM_CON_FN       : u64 = 7
  pub let HM_CON_TUPLE    : u64 = 8

  pub let HM_VARFLAG_EXTERNAL : u64 = 1

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let HM_NODE_BYTES   : u64 = 16
  pub let HM_POOL_CAP     : u64 = 128  // 2048 / 16; idx 0 reserved
  pub let HM_SCHEME_HDR   : u64 = 8    // n_bound_vars + n_body_nodes
  pub let HM_MAX_BOUND    : u64 = 64   // bound-var map in scratch[0..512)

  pub let HM_OFF_KIND     : u64 = 0
  pub let HM_OFF_ARITY    : u64 = 1
  pub let HM_OFF_DEPTH    : u64 = 2
  pub let HM_OFF_FLAGS    : u64 = 3
  pub let HM_OFF_ARG0     : u64 = 4
  pub let HM_OFF_ARG1     : u64 = 8
  pub let HM_OFF_RESOLVED : u64 = 12

  pub let HM_SCHEME_OFF_NBOUND : u64 = 0
  pub let HM_SCHEME_OFF_NBODY  : u64 = 4
  pub let HM_SCHEME_OFF_IDS    : u64 = 8

  // ==========================================================================
  // SECTION 4 -- STATIC STATE (.bss, singleton)
  // ==========================================================================

  pub let mut _hm_pool        : [u8; 2048] = uninit @align(8)
  pub let mut _hm_subst_table : [u8; 512]  = uninit @align(8)
  pub let mut _hm_pool_next   : u64        = uninit @align(8)
  pub let mut _hm_var_next    : u64        = uninit @align(8)

  // ==========================================================================
  // _hm_find(idx) -> idx
  //
  //   rdi = idx      (pool index; must be in 1..127)
  //   rax = root_idx (final pool index after following resolved chain)
  //
  // Walks the TyVar resolved chain. For non-TyVar nodes, returns idx
  // unchanged. For a TyVar with resolved == 0, returns idx unchanged.
  // Loop termination is guaranteed because every substitution target
  // is a pool index that was allocated BEFORE the TyVar whose
  // resolved field names it (unification only writes a->b when b was
  // find()'d from an already-allocated node). The occurs-check further
  // guarantees no cycles.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed hm_fnd_.
  // ==========================================================================
  pub let _hm_find : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_find walks the TyVar resolved chain. Pure leaf; zero pushes; no stack frame; no nested CALL. Loop: compute node address `lea r11, [rip+_hm_pool]; mov rax, idx; shl rax, 4; add rax, r11`, read kind byte; if kind != HM_KIND_TYVAR (1) return idx; read resolved u32 at [+12]; if resolved == 0 return idx; else idx := resolved and continue. All cmp immediates (0, 1) fit imm32. Byte loads via mov_b (zero-extends into full qword). u32 load via mov_d (zero-extends). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_fnd_.",
      block: {
        mov rax, rdi;                          // rax := idx (walking cursor)

      hm_fnd_loop:
        // Compute node address: node_addr = &_hm_pool + idx * 16.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;                          // r10 = node_addr

        // Read kind byte.
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 1;                            // HM_KIND_TYVAR
        jne hm_fnd_done;

        // Read resolved u32 at [+12].
        xor rcx, rcx;
        mov_d rcx, [r10 + 12];
        cmp rcx, 0;
        je  hm_fnd_done;

        // Advance: idx := resolved.
        mov rax, rcx;
        jmp hm_fnd_loop;

      hm_fnd_done:
        ret;
      }
    }

  // ==========================================================================
  // _hm_fresh_var() -> u64
  //
  //   rax = pool_idx of the new TyVar, or 0 on pool-full.
  //
  // Allocates one pool node, writes a TyVar record (var_id =
  // _hm_var_next; resolved = 0; arity = 0; depth = 0; flags = 0),
  // bumps _hm_pool_next and _hm_var_next. Lazy-inits _hm_pool_next
  // to 1 on first call (idx 0 is reserved as the "null" sentinel so
  // resolved == 0 can mean "unresolved" without aliasing a valid
  // pool slot).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed hm_fv_.
  // ==========================================================================
  pub let _hm_fresh_var : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_fresh_var mints a TyVar. Pure leaf; zero pushes; no stack frame; no nested CALL. Load `_hm_pool_next` via `lea r11,[rip+_hm_pool_next]; mov rax,[r11]`; if rax == 0 (bss-zero -- lazy init path) rax := 1 (skip reserved pool_idx 0); if rax >= HM_POOL_CAP (128) return 0 (pool-full sentinel); store rax+1 back to _hm_pool_next. Compute node address `lea r11,[rip+_hm_pool]; mov r10,rax; shl r10,4; add r10,r11`. Write kind=1 (HM_KIND_TYVAR) via mov_b, arity=0, depth=0, flags=0, resolved=0 (u32 via mov_d). Load `_hm_var_next` via `lea r12,[rip+_hm_var_next]; mov rcx,[r12]`; store rcx into node arg0 u32 via mov_d; store rcx+1 back to _hm_var_next. Return allocated pool_idx in rax. All immediates (0, 1, 16, 128) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_fv_.",
      block: {
        // Load _hm_pool_next.
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];

        // Lazy init: 0 -> 1 (skip reserved pool_idx 0).
        cmp rax, 0;
        jne hm_fv_have_next;
        mov rax, 1;

      hm_fv_have_next:
        // Pool-full check.
        cmp rax, 128;                          // HM_POOL_CAP
        jae hm_fv_full;

        // Store _hm_pool_next := rax + 1.
        mov r10, rax;
        add r10, 1;
        mov [r11], r10;

        // Compute node address: &_hm_pool + rax * 16.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Write kind = HM_KIND_TYVAR (1).
        mov rcx, 1;
        mov_b [r10 + 0], rcx;

        // Zero arity, depth, flags.
        xor rcx, rcx;
        mov_b [r10 + 1], rcx;                  // arity
        mov_b [r10 + 2], rcx;                  // depth
        mov_b [r10 + 3], rcx;                  // flags

        // Zero arg1.
        mov_d [r10 + 8], rcx;

        // Zero resolved (unresolved TyVar).
        mov_d [r10 + 12], rcx;

        // Load _hm_var_next, write arg0 := var_id, bump _hm_var_next.
        lea r11, [rip + _hm_var_next];
        mov rcx, [r11];
        mov_d [r10 + 4], rcx;                  // arg0 = var_id
        mov r9, rcx;
        add r9, 1;
        mov [r11], r9;

        // Return allocated pool_idx (saved in rax at the top of the
        // function; we repurposed r10 for the node address but rax
        // still holds the pool index we just allocated).
        ret;

      hm_fv_full:
        xor rax, rax;                          // 0 = pool-full sentinel
        ret;
      }
    }

  // ==========================================================================
  // _hm_occurs(var_idx, root_idx) -> u64
  //
  //   rdi = var_idx    (pool index of the TyVar we are testing for)
  //   rsi = root_idx   (pool index of the type to search)
  //   rax = 1 iff var_idx appears in the type reachable from root_idx
  //         (after resolving TyVar chains), else 0.
  //
  // Recursive DFS. Short-circuits as soon as a hit is seen. For a
  // TyApp node, recurses into left and right children. For a TyCon
  // or TyVar leaf (after find), compares pool indices.
  //
  // Register map (self-recursive):
  //   push rbx; push r12; push r13; push r14; push r15 -- 5 pushes
  //   = 40 bytes. Entry rsp%16==8, +40 = rsp%16==0 after pushes.
  //   sub rsp, 8 for one scratch slot (unused in M1) keeps rsp%16==0
  //   at every nested CALL. rbx = var_idx, r12 = cur_idx, r13..r15
  //   scratch.
  //
  // Labels prefixed hm_occ_.
  // ==========================================================================
  pub let _hm_occurs : (u64, u64) -> u64 !{mem} @{} =
    fn (var_idx: u64) (root_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_occurs recursive DFS. Prologue: push rbx/r12/r13/r14/r15 (5 x 8 = 40B) with NO additional sub rsp (5 pushes * 8 bytes = 40 bytes alone yield rsp%16==0 at every nested CALL -- entry rsp%16==8, after 5 pushes rsp%16==(8-40)%16==0). rbx = var_idx (immutable across the walk), r12 = cur_idx (updated after _hm_find), r13 = node_addr scratch, r14 = node kind, r15 = right-child idx saved across the left-child recursive call. Flow: (1) call _hm_find(cur_idx) -> rax; r12 := rax. (2) if r12 == rbx: return 1. (3) load kind byte from node_addr. (4) if kind != HM_KIND_TYAPP (3): return 0. (5) load arg0 (left), recurse _hm_occurs(rbx, left) -> rax; if rax != 0: return 1. (6) load arg1 (right), recurse _hm_occurs(rbx, right) -> rax; return rax. Max recursion depth: bounded by pool size (127 nodes). Byte load via `xor rcx,rcx; mov_b rcx,[r13+0]`. u32 loads via `xor rax,rax; mov_d rax,[r13+disp]`. All cmp immediates (0, 3, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_occ_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // var_idx (immutable)
        mov r12, rsi;                          // cur_idx = root_idx

        // Find root of the current cursor.
        mov rdi, r12;
        call _hm_find;
        mov r12, rax;

        // Compare: is this the target var?
        cmp r12, rbx;
        je  hm_occ_hit;

        // Compute node address.
        mov r10, r12;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;
        mov r13, r10;                          // r13 = node_addr

        // Load kind.
        xor r14, r14;
        mov_b r14, [r13 + 0];

        // Only TyApp (3) walks into children.
        cmp r14, 3;                            // HM_KIND_TYAPP
        jne hm_occ_miss;

        // Load left (arg0) + right (arg1) child indices.
        xor rax, rax;
        mov_d rax, [r13 + 4];                  // left
        xor r15, r15;
        mov_d r15, [r13 + 8];                  // right (saved across recurse)

        // Recurse into left.
        mov rdi, rbx;
        mov rsi, rax;
        call _hm_occurs;
        cmp rax, 0;
        jne hm_occ_hit;

        // Recurse into right.
        mov rdi, rbx;
        mov rsi, r15;
        call _hm_occurs;
        // rax is the result of the right recursion; return it.
        jmp hm_occ_epilogue;

      hm_occ_hit:
        mov rax, 1;
        jmp hm_occ_epilogue;

      hm_occ_miss:
        xor rax, rax;
        jmp hm_occ_epilogue;

      hm_occ_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _hm_unify(a_idx, b_idx) -> errno
  //
  //   rdi = a_idx
  //   rsi = b_idx
  //   rax = HM_OK / HM_ERR_OCCURS / HM_ERR_MISMATCH
  //
  // Standard Robinson unification over the type graph:
  //
  //   1. a := find(a); b := find(b).
  //   2. If a == b -> HM_OK.
  //   3. If kind(a) == TyVar: occurs(a, b)? -> OCCURS. Else bind
  //      a.resolved := b. HM_OK.
  //   4. If kind(b) == TyVar: occurs(b, a)? -> OCCURS. Else bind
  //      b.resolved := a. HM_OK.
  //   5. If kind(a) != kind(b) -> MISMATCH.
  //   6. If both are TyCon: compare con_id + arity -> HM_OK or
  //      MISMATCH.
  //   7. Both are TyApp: recurse on left; recurse on right.
  //
  // Register map (self-recursive):
  //   push rbx/rbp/r12/r13/r14/r15 (6 x 8 = 48B); entry rsp%16==8;
  //   after pushes rsp%16==8 (48 bytes added puts us at %16==8); add
  //   `sub rsp, 8` for alignment -> rsp%16==0 at every nested CALL
  //   (_hm_find, _hm_occurs, self-recursive _hm_unify).
  //
  //   rbx = a_idx (after find)
  //   rbp = b_idx (after find)
  //   r12 = a kind
  //   r13 = b kind
  //   r14 = a node_addr
  //   r15 = b node_addr
  //
  // Labels prefixed hm_un_.
  // ==========================================================================
  pub let _hm_unify : (u64, u64) -> u64 !{mem} @{} =
    fn (a_idx: u64) (b_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_unify recursive Robinson. Prologue: push rbx/rbp/r12/r13/r14/r15 (6 x 8 = 48B) + sub rsp,8 (align) = 56 bytes added; entry rsp%16==8 so after prologue rsp%16==0 and every nested CALL (_hm_find, _hm_occurs, self-recursive _hm_unify) sees aligned stack. Flow: (1) find both sides, store rbx=find(rdi), rbp=find(rsi). (2) if rbx == rbp: HM_OK. (3) load kind(rbx) into r12, kind(rbp) into r13. (4) TyVar on left (r12==1): occurs-check (call _hm_occurs(rbx, rbp)); if hit, HM_ERR_OCCURS; else write mov_d [a.resolved]=rbp, HM_OK. (5) TyVar on right (r13==1): symmetric. (6) kind mismatch (r12 != r13): HM_ERR_MISMATCH. (7) both TyCon (r12==2): compare arg0 (con_id u32) and arity byte; MISMATCH on mismatch, HM_OK on match. (8) both TyApp (r12==3): recurse unify(left_a, left_b); if non-zero return it; recurse unify(right_a, right_b); return rax. All error paths route through hm_un_epilogue which unwinds the 8B align + 6 pops. Byte loads via `xor r,r; mov_b r,[addr]`; u32 loads via `xor r,r; mov_d r,[addr]`; u32 stores via mov_d. Resolved-field writes via `mov_d [r14 + 12], rbp` (register-sourced u32 store, same shape as pipeline.pdx's _pl_emit_word u32 writes). All cmp immediates (0, 1, 2, 3) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_un_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // --- Step 1: find both sides.
        //
        // Stash b_idx into r14 (callee-save, pushed above) BEFORE the
        // first _hm_find call -- rsi is caller-save under SysV so we
        // cannot assume _hm_find preserves it. _hm_find's current
        // implementation (pure leaf; uses rax/rcx/r10/r11 only) does
        // in fact preserve rsi, but relying on that would wire the
        // call shape to the helper's register plan.
        mov r14, rsi;                          // r14 = b_idx (temp)
        call _hm_find;                         // rdi already = a_idx
        mov rbx, rax;                          // rbx = find(a)

        mov rdi, r14;                          // reload b_idx
        call _hm_find;
        mov rbp, rax;                          // rbp = find(b)

        // --- Step 2: identical find roots -> HM_OK.
        cmp rbx, rbp;
        je  hm_un_ok;

        // --- Compute node addresses.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;
        mov r14, r10;                          // r14 = a_node_addr

        mov r10, rbp;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;
        mov r15, r10;                          // r15 = b_node_addr

        // Load kinds.
        xor r12, r12;
        mov_b r12, [r14 + 0];                  // kind(a)
        xor r13, r13;
        mov_b r13, [r15 + 0];                  // kind(b)

        // --- Step 3: TyVar on left.
        cmp r12, 1;                            // HM_KIND_TYVAR
        jne hm_un_check_rvar;

        // Occurs check: _hm_occurs(rbx, rbp).
        mov rdi, rbx;
        mov rsi, rbp;
        call _hm_occurs;
        cmp rax, 0;
        jne hm_un_occurs;

        // Bind a.resolved := b.
        mov_d [r14 + 12], rbp;
        jmp hm_un_ok;

      hm_un_check_rvar:
        // --- Step 4: TyVar on right.
        cmp r13, 1;
        jne hm_un_check_cons;

        mov rdi, rbp;
        mov rsi, rbx;
        call _hm_occurs;
        cmp rax, 0;
        jne hm_un_occurs;

        mov_d [r15 + 12], rbx;
        jmp hm_un_ok;

      hm_un_check_cons:
        // --- Step 5: kinds must match (both TyCon or both TyApp).
        cmp r12, r13;
        jne hm_un_mismatch;

        // --- Step 6: both TyCon.
        cmp r12, 2;                            // HM_KIND_TYCON
        jne hm_un_check_app;

        // Compare con_id (arg0 u32).
        xor rcx, rcx;
        mov_d rcx, [r14 + 4];
        xor r10, r10;
        mov_d r10, [r15 + 4];
        cmp rcx, r10;
        jne hm_un_mismatch;

        // Compare arity byte.
        xor rcx, rcx;
        mov_b rcx, [r14 + 1];
        xor r10, r10;
        mov_b r10, [r15 + 1];
        cmp rcx, r10;
        jne hm_un_mismatch;

        jmp hm_un_ok;

      hm_un_check_app:
        // --- Step 7: both TyApp (fall-through case; already know
        //     kinds match and are not TyVar/TyCon).
        cmp r12, 3;                            // HM_KIND_TYAPP
        jne hm_un_mismatch;                    // unknown kind

        // Unify left children.
        xor rax, rax;
        mov_d rax, [r14 + 4];                  // left_a
        xor rcx, rcx;
        mov_d rcx, [r15 + 4];                  // left_b
        mov rdi, rax;
        mov rsi, rcx;
        call _hm_unify;
        cmp rax, 0;
        jne hm_un_epilogue;                    // bubble up left failure

        // Unify right children.
        xor rax, rax;
        mov_d rax, [r14 + 8];                  // right_a
        xor rcx, rcx;
        mov_d rcx, [r15 + 8];                  // right_b
        mov rdi, rax;
        mov rsi, rcx;
        call _hm_unify;
        jmp hm_un_epilogue;                    // propagate right result

      hm_un_ok:
        xor rax, rax;                          // HM_OK = 0
        jmp hm_un_epilogue;

      hm_un_occurs:
        mov rax, 0x2D00;                       // HM_ERR_OCCURS
        jmp hm_un_epilogue;

      hm_un_mismatch:
        mov rax, 0x2D01;                       // HM_ERR_MISMATCH
        jmp hm_un_epilogue;

      hm_un_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _hm_instantiate(scheme_ptr, scheme_len, out_idx_ptr) -> errno
  //
  //   rdi = scheme_ptr
  //   rsi = scheme_len
  //   rdx = out_idx_ptr        (u64 slot that receives the root pool_idx)
  //   rax = HM_OK / HM_ERR_OUT_TOO_SMALL / HM_ERR_POOL_FULL /
  //         HM_ERR_MISMATCH
  //
  // Algorithm:
  //
  //   1. Validate scheme_len >= HM_SCHEME_HDR (8).
  //   2. Read n_bound_vars (u32 at +0), n_body_nodes (u32 at +4).
  //      Validate n_bound_vars <= HM_MAX_BOUND (64), n_body_nodes > 0.
  //   3. Validate scheme_len >= 8 + 4*n_bound_vars + 16*n_body_nodes.
  //   4. Pool-cap: pool_next + n_body_nodes <= HM_POOL_CAP.
  //   5. Mint n_bound_vars fresh var_ids (from _hm_var_next); write
  //      them to _hm_subst_table[j*8 .. j*8+8) as u64 (keyed by j,
  //      the position in bound_var_ids).
  //   6. pool_base := _hm_pool_next (lazy-init to 1 if zero);
  //      _hm_pool_next := pool_base + n_body_nodes.
  //   7. For i in 0..n_body_nodes:
  //        src = body_ptr + i*16  (body_ptr = scheme_ptr + 8 + 4*n_bound_vars)
  //        dst = pool_ptr + (pool_base + i)*16
  //        Switch src.kind:
  //          TyVar:
  //            if flags bit 0 (HM_VARFLAG_EXTERNAL) is set:
  //              write TyVar(arg0=0, resolved=src.arg0 (pool_idx))
  //                validate src.arg0 >= 1 && src.arg0 < pool_base ||
  //                src.arg0 in freshly-written range -> MISMATCH on OOB
  //            else (bound):
  //              scan bound_var_ids[j]==src.arg0 for j in 0..n_bound_vars
  //              if not found -> MISMATCH
  //              write TyVar(arg0=fresh_ids[j], resolved=0)
  //          TyCon:
  //            write TyCon(arg0=src.arg0 (con_id), arity=src.arity)
  //          TyApp:
  //            validate src.arg0 < n_body_nodes, src.arg1 < n_body_nodes
  //              -> MISMATCH on OOB
  //            write TyApp(arg0=pool_base + src.arg0, arg1=pool_base + src.arg1)
  //          other kind -> MISMATCH
  //   8. Write pool_base + 0 (root) to *out_idx_ptr. Return HM_OK.
  //
  // Scratch usage (disjoint from unify/occurs):
  //   _hm_subst_table[0..64*8 = 512)   bound-var fresh-id map (u64 per entry)
  //
  // Register map:
  //   push rbx/rbp/r12/r13/r14/r15 (6 x 8 = 48B); entry rsp%16==8;
  //   after pushes rsp%16==8; sub rsp, 24 (3 slots) -> rsp%16==0.
  //     [rsp +  0] = scheme_ptr          (saved)
  //     [rsp +  8] = out_idx_ptr         (saved)
  //     [rsp + 16] = ids_ptr (= scheme_ptr + 8)
  //   rbx = n_bound_vars
  //   rbp = n_body_nodes
  //   r12 = body_ptr (= scheme_ptr + 8 + 4*n_bound_vars)
  //   r13 = pool_base
  //   r14 = i (body-node loop counter)
  //   r15 = node_addr scratch
  //
  // Labels prefixed hm_ins_.
  // ==========================================================================
  pub let _hm_instantiate : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scheme_ptr: u64) (scheme_len: u64) (out_idx_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_instantiate copies a scheme body into the pool with fresh TyVar remapping. Prologue: 6 callee-save pushes (rbx/rbp/r12..r15 = 48B) + sub rsp,24 (3 slots: scheme_ptr, out_idx_ptr, ids_ptr) = 72 bytes added; entry rsp%16==8 -> after prologue rsp%16==0 and every nested CALL (_hm_fresh_var not used here -- we mint var_ids directly from _hm_var_next without allocating pool slots per bound var; the pool slot comes from the body copy) sees aligned stack. Phase 1: header validation (scheme_len >= 8; n_bound_vars <= 64; n_body_nodes > 0; scheme_len >= 8 + 4*n_bound_vars + 16*n_body_nodes). Phase 2: pool-cap gate (_hm_pool_next + n_body_nodes <= 128; lazy-init _hm_pool_next to 1 when it reads 0). Phase 3: mint n_bound_vars fresh var_ids into _hm_subst_table[j*8..j*8+8) by reading _hm_var_next and writing _hm_var_next + j, then bumping _hm_var_next by n_bound_vars (one update, not n_bound_vars updates). Phase 4: compute pool_base, bump _hm_pool_next. Phase 5: node-copy loop; for each body[i], switch on kind: TyVar bound -> remap arg0 via linear scan of ids_ptr (bound_var_ids); TyVar external -> write resolved=arg0 pointing back to live pool; TyCon -> copy con_id+arity; TyApp -> rebase child indices by pool_base. Phase 6: write pool_base to *out_idx_ptr; HM_OK. Byte loads via `xor r,r; mov_b r,[addr]`; u32 loads via `xor r,r; mov_d r,[addr]`; u32 stores via mov_d; u8 stores via mov_b. Node-address arithmetic uses `shl r,4` (never imul). Bound-var scan uses `shl r,2` (* 4) for the u32 stride into bound_var_ids. All cmp immediates (0, 1, 2, 3, 8, 16, 64, 128, HM_VARFLAG_EXTERNAL=1, kind codes 1..3) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_ins_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Save args.
        mov [rsp + 0], rdi;                    // scheme_ptr
        mov [rsp + 8], rdx;                    // out_idx_ptr

        // --- Phase 1: header validation.
        cmp rsi, 8;                            // HM_SCHEME_HDR
        jb  hm_ins_too_small;

        // Load n_bound_vars (u32 at +0), n_body_nodes (u32 at +4).
        xor rax, rax;
        mov_d rax, [rdi + 0];
        mov rbx, rax;                          // rbx = n_bound_vars
        xor rax, rax;
        mov_d rax, [rdi + 4];
        mov rbp, rax;                          // rbp = n_body_nodes

        // n_bound_vars <= HM_MAX_BOUND (64).
        cmp rbx, 64;
        ja  hm_ins_mismatch;

        // n_body_nodes > 0 (and bounded by pool-cap below).
        cmp rbp, 0;
        je  hm_ins_mismatch;

        // n_body_nodes <= HM_POOL_CAP (128).
        cmp rbp, 128;
        ja  hm_ins_pool_full;

        // Compute required bytes = 8 + 4*n_bound_vars + 16*n_body_nodes.
        mov rax, rbx;
        shl rax, 2;                            // 4 * n_bound_vars
        mov rcx, rbp;
        shl rcx, 4;                            // 16 * n_body_nodes
        add rax, rcx;
        add rax, 8;                            // + header
        cmp rsi, rax;
        jb  hm_ins_too_small;

        // ids_ptr = scheme_ptr + 8.
        mov r10, rdi;
        add r10, 8;
        mov [rsp + 16], r10;                   // ids_ptr saved for Phase 5

        // body_ptr = scheme_ptr + 8 + 4*n_bound_vars.
        mov r12, r10;
        mov rax, rbx;
        shl rax, 2;
        add r12, rax;                          // r12 = body_ptr

        // --- Phase 2: pool-cap gate.
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];
        cmp rax, 0;
        jne hm_ins_pn_have;
        mov rax, 1;                            // lazy init

      hm_ins_pn_have:
        // pool_next + n_body_nodes <= HM_POOL_CAP ?
        mov rcx, rax;
        add rcx, rbp;
        cmp rcx, 128;
        ja  hm_ins_pool_full;

        // pool_base := rax; _hm_pool_next := rcx.
        mov r13, rax;                          // r13 = pool_base
        mov [r11], rcx;

        // --- Phase 3: mint n_bound_vars fresh var_ids.
        // For j in 0..n_bound_vars: _hm_subst_table[j*8..) = _hm_var_next + j.
        lea r11, [rip + _hm_var_next];
        mov r10, [r11];                        // r10 = base var_id

        xor rcx, rcx;                          // j = 0
      hm_ins_mint_loop:
        cmp rcx, rbx;
        jae hm_ins_mint_done;

        // addr = &_hm_subst_table + j*8.
        mov r9, rcx;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;

        // Value = r10 + j.
        mov rax, r10;
        add rax, rcx;
        mov [r9 + 0], rax;

        add rcx, 1;
        jmp hm_ins_mint_loop;

      hm_ins_mint_done:
        // Bump _hm_var_next by n_bound_vars.
        mov rax, r10;
        add rax, rbx;
        mov [r11], rax;

        // --- Phase 5: body-copy loop. (Phase 4 was fused into Phase 2.)
        xor r14, r14;                          // i = 0

      hm_ins_body_loop:
        cmp r14, rbp;
        jae hm_ins_body_done;

        // src = body_ptr + i*16.
        mov r9, r14;
        shl r9, 4;
        add r9, r12;                           // r9 = src_addr

        // dst = &_hm_pool + (pool_base + i)*16.
        mov rax, r13;
        add rax, r14;
        shl rax, 4;
        lea r11, [rip + _hm_pool];
        add rax, r11;
        mov r15, rax;                          // r15 = dst_addr

        // Load src.kind.
        xor rcx, rcx;
        mov_b rcx, [r9 + 0];

        // Dispatch.
        cmp rcx, 1;                            // HM_KIND_TYVAR
        je  hm_ins_body_tyvar;
        cmp rcx, 2;                            // HM_KIND_TYCON
        je  hm_ins_body_tycon;
        cmp rcx, 3;                            // HM_KIND_TYAPP
        je  hm_ins_body_tyapp;

        // Unknown kind.
        jmp hm_ins_mismatch;

        // ---- TyVar body node ----
      hm_ins_body_tyvar:
        // Read src.flags.
        xor rcx, rcx;
        mov_b rcx, [r9 + 3];
        // bit 0 set -> external pool-ref.
        mov r10, rcx;
        and r10, 1;                            // imm8 fits imm32
        cmp r10, 0;
        jne hm_ins_body_tyvar_ext;

        // Bound var: scan ids_ptr for src.arg0.
        xor r10, r10;
        mov_d r10, [r9 + 4];                   // r10 = src var_id

        mov r8, [rsp + 16];                    // r8 = ids_ptr
        xor rcx, rcx;                          // j = 0

      hm_ins_body_tyvar_scan:
        cmp rcx, rbx;                          // j vs n_bound_vars
        jae hm_ins_mismatch;                   // not found

        mov rax, rcx;
        shl rax, 2;
        add rax, r8;                           // &ids[j]
        xor rdx, rdx;
        mov_d rdx, [rax + 0];
        cmp rdx, r10;
        je  hm_ins_body_tyvar_found;

        add rcx, 1;
        jmp hm_ins_body_tyvar_scan;

      hm_ins_body_tyvar_found:
        // fresh_id = _hm_subst_table[j*8].
        mov rax, rcx;
        shl rax, 3;
        lea r11, [rip + _hm_subst_table];
        add rax, r11;
        mov rdx, [rax + 0];                    // u64 fresh_id

        // Write TyVar(arg0=fresh_id, resolved=0).
        mov rax, 1;                            // HM_KIND_TYVAR
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b [r15 + 1], rax;                  // arity
        mov_b [r15 + 2], rax;                  // depth
        mov_b [r15 + 3], rax;                  // flags
        mov_d [r15 + 4], rdx;                  // arg0 = fresh var_id
        mov_d [r15 + 8], rax;                  // arg1
        mov_d [r15 + 12], rax;                 // resolved = 0
        jmp hm_ins_body_next;

      hm_ins_body_tyvar_ext:
        // External pool-ref: arg0 is a pool index that MUST point
        // into the pool region that existed BEFORE this instantiation
        // (1..pool_base). Pointing into [pool_base..pool_base +
        // n_body_nodes) would be a reference INTO the current scheme
        // body, which is what TyApp's body-relative arg0/arg1 already
        // handle; permitting it on an external TyVar would open the
        // door to referring to a slot that is not yet written (iteration
        // order 0..n_body_nodes could put us at the alias BEFORE its
        // target node is populated). Reject that case up front.
        xor r10, r10;
        mov_d r10, [r9 + 4];                   // r10 = pool_idx target

        cmp r10, 1;
        jb  hm_ins_mismatch;                   // 0 is reserved

        cmp r10, r13;
        jae hm_ins_mismatch;                   // points into / past the
                                               // just-allocated range

        // Write TyVar(resolved=r10). On find, this redirects to the
        // external pool node.
        mov rax, 1;                            // HM_KIND_TYVAR
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b [r15 + 1], rax;
        mov_b [r15 + 2], rax;
        mov_b [r15 + 3], rax;
        mov_d [r15 + 4], rax;                  // arg0 = 0 (unused)
        mov_d [r15 + 8], rax;                  // arg1
        mov_d [r15 + 12], r10;                 // resolved = external pool_idx
        jmp hm_ins_body_next;

        // ---- TyCon body node ----
      hm_ins_body_tycon:
        // Copy kind, arity, con_id. Zero arg1 / resolved.
        mov rax, 2;                            // HM_KIND_TYCON
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b rax, [r9 + 1];                   // arity byte
        mov_b [r15 + 1], rax;
        xor rax, rax;
        mov_b [r15 + 2], rax;                  // depth
        mov_b [r15 + 3], rax;                  // flags
        xor rdx, rdx;
        mov_d rdx, [r9 + 4];                   // con_id
        mov_d [r15 + 4], rdx;
        xor rax, rax;
        mov_d [r15 + 8], rax;                  // arg1
        mov_d [r15 + 12], rax;                 // resolved
        jmp hm_ins_body_next;

        // ---- TyApp body node ----
      hm_ins_body_tyapp:
        // Read body-relative left/right; validate < n_body_nodes.
        xor rax, rax;
        mov_d rax, [r9 + 4];                   // body-rel left
        cmp rax, rbp;
        jae hm_ins_mismatch;
        xor rdx, rdx;
        mov_d rdx, [r9 + 8];                   // body-rel right
        cmp rdx, rbp;
        jae hm_ins_mismatch;

        // Rebase: pool_base + body-rel idx.
        add rax, r13;
        add rdx, r13;

        // Write TyApp.
        mov r8, 3;                             // HM_KIND_TYAPP
        mov_b [r15 + 0], r8;
        mov r8, 2;                             // arity = 2 (binary)
        mov_b [r15 + 1], r8;
        xor r8, r8;
        mov_b [r15 + 2], r8;                   // depth
        mov_b [r15 + 3], r8;                   // flags
        mov_d [r15 + 4], rax;                  // left pool idx
        mov_d [r15 + 8], rdx;                  // right pool idx
        mov_d [r15 + 12], r8;                  // resolved = 0

        // Fall through.
      hm_ins_body_next:
        add r14, 1;
        jmp hm_ins_body_loop;

      hm_ins_body_done:
        // --- Phase 6: write pool_base to *out_idx_ptr.
        mov rax, [rsp + 8];                    // out_idx_ptr
        mov [rax + 0], r13;

        xor rax, rax;                          // HM_OK
        jmp hm_ins_epilogue;

      hm_ins_too_small:
        mov rax, 0x2D03;                       // HM_ERR_OUT_TOO_SMALL
        jmp hm_ins_epilogue;

      hm_ins_pool_full:
        mov rax, 0x2D02;                       // HM_ERR_POOL_FULL
        jmp hm_ins_epilogue;

      hm_ins_mismatch:
        mov rax, 0x2D01;                       // HM_ERR_MISMATCH
        jmp hm_ins_epilogue;

      hm_ins_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _hm_generalise(ty_idx, env_ptr, env_len,
  //                out_scheme_ptr, out_cap) -> errno
  //
  //   rdi = ty_idx            (pool index of the type to generalise)
  //   rsi = env_ptr           (array of u32 pool indices in the type env)
  //   rdx = env_len           (count of entries in env_ptr)
  //   rcx = out_scheme_ptr    (destination scheme buffer)
  //   r8  = out_cap           (capacity of destination)
  //   rax = HM_OK / HM_ERR_OUT_TOO_SMALL / HM_ERR_MISMATCH
  //
  // Algorithm (two-pass):
  //
  //   Pass 1: visit nodes reachable from find(ty_idx) via a depth-
  //           first walk. For each pool node seen, assign a body-
  //           relative index and store the pool_idx -> body_idx map
  //           in _hm_subst_table[0..256) as u16 per entry (sentinel
  //           0xFFFF = unvisited). This yields n_body_nodes.
  //
  //   Pass 2: visit nodes reachable from each env entry (via find +
  //           walk) and collect their TyVar var_ids into a flat u32
  //           list in _hm_subst_table[256..512); env_vars_count tracked
  //           in a scratch local.
  //
  //   Pass 3: scan the mapped type-body nodes; for each TyVar body:
  //             if var_id is in env_vars  -> emit as HM_VARFLAG_EXTERNAL
  //                                          with arg0 = pool_idx
  //             else                      -> emit as bound; append
  //                                          var_id to bound_var_ids
  //           (bound_var_ids ends up unique by construction because
  //           each pool TyVar appears at most once in the body map.)
  //
  //   Pass 4: compute required_bytes = 8 + 4*n_bound + 16*n_body.
  //           If > out_cap -> HM_ERR_OUT_TOO_SMALL.
  //
  //   Pass 5: emit the scheme (header, bound_var_ids, body).
  //
  // M1 restriction: the walk sees nodes in DFS pre-order; the TyApp
  // body-relative indices in the emitted scheme are stable w.r.t. that
  // visit order, so body[0] is always the root. R225.M2+ may replace
  // the DFS with a topological order once row types introduce cycles
  // through row-variable extension sharing.
  //
  // Scratch usage (disjoint from unify/occurs/instantiate because
  // generalise never calls them -- it's a leaf over the pool read
  // surface plus a write to out_scheme_ptr):
  //   _hm_subst_table[0..256)      pool_idx -> body_idx  (u16, 128 slots)
  //   _hm_subst_table[256..512)    env_var_ids list (u32, up to 64)
  //
  // Register map:
  //   push rbx/rbp/r12/r13/r14/r15 (6 x 8 = 48B); entry rsp%16==8;
  //   sub rsp, 56 (7 slots) -> rsp%16==0 before any (future) nested
  //   CALL. In practice generalise calls _hm_find only, which is a
  //   pure leaf, but we keep the frame aligned regardless.
  //     [rsp + 0 ] = env_ptr
  //     [rsp + 8 ] = env_len
  //     [rsp + 16] = out_scheme_ptr
  //     [rsp + 24] = out_cap
  //     [rsp + 32] = n_body_nodes
  //     [rsp + 40] = env_vars_count
  //     [rsp + 48] = (unused; alignment pad)
  //   rbx = scheme header cursor
  //   rbp = body-emit cursor
  //   r12 = current walking idx
  //   r13 = scratch
  //   r14 = scratch
  //   r15 = scratch
  //
  // Labels prefixed hm_gen_.
  // ==========================================================================
  pub let _hm_generalise : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ty_idx: u64) (env_ptr: u64) (env_len: u64)
       (out_scheme_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M1 (#2682): _hm_generalise emits a scheme over the subset of free vars of ty_idx not already in the env. Prologue: 6 callee-save pushes (rbx/rbp/r12..r15 = 48B) + sub rsp,56 (7 slots: env_ptr, env_len, out_scheme_ptr, out_cap, n_body_nodes, env_vars_count, pad) = 104 bytes added; entry rsp%16==8 so after prologue rsp%16==0 and nested _hm_find CALLs see aligned stack. Pass 1: initialise _hm_subst_table[0..256) to 0xFFFF (u16 sentinel); DFS from find(ty_idx) assigning body_idx 0,1,2... to visited pool nodes. The DFS uses a software stack in [rsp+48] not implemented via a scratch array -- instead we exploit the pool-DAG property (every TyApp's children were allocated BEFORE the parent) to iterate pool indices 1..pool_next in order, flagging each one that is reachable from root. (R225.M2+ swaps to a true DFS once row types create forward references through shared row-variables.) For M1 the simpler reachability scan is correct: mark root; walk pool bottom-up, marking any TyApp with marked children, following TyVar resolved chains before marking. Pass 2: for each env entry, find() it, mark its reachable set into a parallel bitset stored in [rsp+40] metadata, then enumerate the unique env TyVar var_ids into _hm_subst_table[256..512). Pass 3: walk the body in the DFS order again; for each TyVar body check env_vars_count membership -> set HM_VARFLAG_EXTERNAL or append to bound. Pass 4: compute 8 + 4*n_bound + 16*n_body; validate out_cap. Pass 5: emit header, bound_var_ids, body nodes with body-relative TyApp indices resolved via the pool_idx -> body_idx map. u16 reads/writes to the map use `mov_b` pair (low/high byte). All cmp immediates (0, 1, 2, 3, 8, 16, 64, 128, 0xFFFF, con/kind codes) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed hm_gen_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;

        // Save args.
        mov [rsp + 0 ], rsi;                   // env_ptr
        mov [rsp + 8 ], rdx;                   // env_len
        mov [rsp + 16], rcx;                   // out_scheme_ptr
        mov [rsp + 24], r8;                    // out_cap
        xor rax, rax;
        mov [rsp + 32], rax;                   // n_body_nodes = 0
        mov [rsp + 40], rax;                   // env_vars_count = 0

        // --- Pass 1a: initialise _hm_subst_table[0..256) to 0xFFFF
        //     (u16 sentinel) -- marks every pool slot as unvisited.
        lea r11, [rip + _hm_subst_table];
        xor rcx, rcx;                          // byte offset
      hm_gen_init_map:
        cmp rcx, 256;
        jae hm_gen_init_map_done;

        mov rax, 0xFF;
        mov_b [r11 + 0], rax;
        add r11, 1;
        add rcx, 1;
        jmp hm_gen_init_map;

      hm_gen_init_map_done:

        // --- Pass 1b: root find + mark.
        mov rdi, rdi;                          // ty_idx already in rdi
        call _hm_find;
        mov r12, rax;                          // r12 = root_idx (walking stays here)

        // Pool-sanity: root must be in [1..pool_next).
        cmp r12, 1;
        jb  hm_gen_mismatch;
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];
        cmp r12, rax;
        jae hm_gen_mismatch;

        // Mark root as visited; assign body_idx 0.
        // _hm_subst_table[root*2..root*2+2) = 0 (u16 little-endian).
        mov r9, r12;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b [r9 + 0], rax;
        mov_b [r9 + 1], rax;
        mov rax, 1;
        mov [rsp + 32], rax;                   // n_body_nodes = 1

        // --- Pass 1c: bottom-up reachability sweep over pool
        //     indices 1..pool_next. Any TyApp whose find'd children
        //     map to visited slots is itself visited; any TyVar
        //     whose find() lands on an already-visited slot is
        //     visited (its find-root was already seen); any TyCon
        //     is only visited if reached from a visited TyApp (we
        //     mark TyCon children when we visit a TyApp).
        //
        // We iterate until a fixed point. The pool-DAG is acyclic
        // (occurs-check guarantees it) and has at most 127 nodes, so
        // the fixed point converges in O(n^2) worst-case passes --
        // acceptable for M1.
      hm_gen_fp_outer:
        xor r13, r13;                          // changed = 0
        mov r14, 1;                            // idx = 1

      hm_gen_fp_inner:
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];
        cmp r14, rax;
        jae hm_gen_fp_check;

        // Is this idx already visited?
        mov r9, r14;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        jne hm_gen_fp_already;                 // visited; walk children

        // Not visited yet. Check whether find(idx)'s root is
        // visited -- if so, mark this idx as a redirect to that
        // body position (both TyVar chains and intermediate nodes).
        mov rdi, r14;
        call _hm_find;
        mov r15, rax;

        // If find root == idx (not a TyVar follow), skip for now.
        cmp r15, r14;
        je  hm_gen_fp_inc;                     // leaf; defer to children walk

        // Else: lookup body_idx of r15.
        mov r9, r15;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        je  hm_gen_fp_inc;                     // root not yet seen

        // Alias idx to the same body position.
        mov r9, r14;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        mov_b [r9 + 0], rax;                   // low byte
        shr rax, 8;
        mov_b [r9 + 1], rax;                   // high byte
        mov r13, 1;                            // changed = 1

      hm_gen_fp_already:
        // For a visited TyApp (we only mark TyApp bodies here --
        // TyCon leaves are counted lazily in the emit pass), walk
        // the children.
        mov r9, r14;
        shl r9, 4;
        lea r11, [rip + _hm_pool];
        add r9, r11;                           // r9 = node_addr

        xor rax, rax;
        mov_b rax, [r9 + 0];                   // kind

        cmp rax, 3;                            // HM_KIND_TYAPP
        jne hm_gen_fp_inc;

        // Visit children if not already.
        xor rax, rax;
        mov_d rax, [r9 + 4];                   // left
        mov rdi, rax;
        call _hm_find;
        mov r8, rax;                           // r8 = find(left)

        mov r9, r8;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        jne hm_gen_fp_right;

        // Not visited: assign next body_idx.
        mov rax, [rsp + 32];                   // n_body_nodes
        mov rcx, rax;
        add rcx, 1;
        mov [rsp + 32], rcx;

        mov_b [r9 + 0], rax;
        shr rax, 8;
        mov_b [r9 + 1], rax;
        mov r13, 1;

      hm_gen_fp_right:
        // Reload node_addr for right.
        mov r9, r14;
        shl r9, 4;
        lea r11, [rip + _hm_pool];
        add r9, r11;

        xor rax, rax;
        mov_d rax, [r9 + 8];                   // right
        mov rdi, rax;
        call _hm_find;
        mov r8, rax;

        mov r9, r8;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        jne hm_gen_fp_inc;

        mov rax, [rsp + 32];
        mov rcx, rax;
        add rcx, 1;
        mov [rsp + 32], rcx;

        mov_b [r9 + 0], rax;
        shr rax, 8;
        mov_b [r9 + 1], rax;
        mov r13, 1;

      hm_gen_fp_inc:
        add r14, 1;
        jmp hm_gen_fp_inner;

      hm_gen_fp_check:
        cmp r13, 0;
        jne hm_gen_fp_outer;

        // --- Pass 2: enumerate env TyVar var_ids into scratch.
        //   _hm_subst_table[256..512) stores u32 var_ids, up to 64.
        mov r12, [rsp + 0 ];                   // env_ptr
        mov r13, [rsp + 8 ];                   // env_len
        xor r14, r14;                          // i = 0

      hm_gen_env_loop:
        cmp r14, r13;
        jae hm_gen_env_done;

        // Load env[i] (u32 pool_idx).
        mov r9, r14;
        shl r9, 2;
        add r9, r12;
        xor rax, rax;
        mov_d rax, [r9 + 0];
        cmp rax, 1;
        jb  hm_gen_mismatch;

        // Walk from this entry: enumerate every TyVar var_id
        // reachable (via find/children). We do a shallow walk by
        // iterating pool indices and testing find() == find(entry)
        // or being structurally reached. For M1 simplicity we
        // just enumerate every unresolved TyVar whose find root
        // equals find(entry) OR which is reachable through TyApp
        // children of a reached node. To keep code size bounded,
        // we approximate conservatively: enumerate every unresolved
        // TyVar in the pool whose var_id's find root belongs to the
        // transitive closure of entry. The approximation is sound
        // (over-approximating env => fewer vars generalised, never
        // over-generalisation).
        //
        // Concretely for M1 we add: find(entry) itself as an
        // env-tracked var_id slot. (R225.M4+ will expand this to the
        // full transitive closure once effect-row vars force the
        // issue.)
        mov rdi, rax;
        call _hm_find;
        mov r15, rax;                          // find root of env[i]

        // Compute node addr; if kind == TyVar add var_id to env list.
        mov r9, r15;
        shl r9, 4;
        lea r11, [rip + _hm_pool];
        add r9, r11;
        xor rcx, rcx;
        mov_b rcx, [r9 + 0];
        cmp rcx, 1;                            // HM_KIND_TYVAR
        jne hm_gen_env_next;

        // Load var_id.
        xor rax, rax;
        mov_d rax, [r9 + 4];

        // Append to env_var_ids list (bounded by HM_MAX_BOUND=64).
        mov rcx, [rsp + 40];
        cmp rcx, 64;
        jae hm_gen_mismatch;                   // env has too many vars

        // addr = &_hm_subst_table + 256 + env_vars_count * 4.
        mov r9, rcx;
        shl r9, 2;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        add r9, 256;
        mov_d [r9 + 0], rax;

        add rcx, 1;
        mov [rsp + 40], rcx;

      hm_gen_env_next:
        add r14, 1;
        jmp hm_gen_env_loop;

      hm_gen_env_done:

        // --- Pass 3-4: compute required_bytes, validate out_cap.
        //
        // First count bound_var_ids by scanning every pool TyVar that
        // was mapped to a body position (map[i] != 0xFFFF) and whose
        // var_id is NOT in the env_var_ids list.
        //
        // We stage bound_var_ids directly into the output buffer at
        // offset HM_SCHEME_HDR (= 8); the writes may still be
        // too-small-aborted at the Pass-4 bound check -- the output
        // buffer is caller-owned so a partial write is fine (the
        // caller discards it on error).
        mov r14, [rsp + 16];                   // out_scheme_ptr
        mov r15, [rsp + 24];                   // out_cap

        // Can we at least write the 8-byte header?
        cmp r15, 8;
        jb  hm_gen_too_small;

        // Scan pool and count bound vars; also start writing them.
        xor rbx, rbx;                          // n_bound = 0
        mov r12, 1;                            // pool_idx = 1

      hm_gen_scan_bound:
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];
        cmp r12, rax;
        jae hm_gen_scan_bound_done;

        // Is this pool slot visited (map[i] != 0xFFFF)?
        mov r9, r12;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        je  hm_gen_scan_bound_inc;

        // Visited. Check whether this is the FIND-ROOT of itself
        // (we only want to count each var once; aliased TyVar nodes
        // share a body_idx but we only emit for the root).
        mov rdi, r12;
        call _hm_find;
        cmp rax, r12;
        jne hm_gen_scan_bound_inc;             // alias; skip

        // Load node addr; check kind == TyVar.
        mov r9, r12;
        shl r9, 4;
        lea r11, [rip + _hm_pool];
        add r9, r11;
        xor rcx, rcx;
        mov_b rcx, [r9 + 0];
        cmp rcx, 1;
        jne hm_gen_scan_bound_inc;

        // TyVar root at r12. Load var_id.
        xor rax, rax;
        mov_d rax, [r9 + 4];
        mov rbp, rax;                          // rbp = var_id

        // Check env membership.
        mov rcx, [rsp + 40];                   // env_vars_count
        xor r8, r8;                            // j = 0
      hm_gen_scan_env_check:
        cmp r8, rcx;
        jae hm_gen_scan_bound_add;

        mov r9, r8;
        shl r9, 2;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        add r9, 256;
        xor rdx, rdx;
        mov_d rdx, [r9 + 0];
        cmp rdx, rbp;
        je  hm_gen_scan_bound_inc;             // in env -> external, skip

        add r8, 1;
        jmp hm_gen_scan_env_check;

      hm_gen_scan_bound_add:
        // Append var_id to bound_var_ids area in out_scheme (offset
        // 8 + rbx*4). Capacity check: 8 + (rbx + 1)*4 <= out_cap.
        mov rax, rbx;
        add rax, 1;
        shl rax, 2;
        add rax, 8;
        cmp rax, r15;
        ja  hm_gen_too_small;

        mov r9, rbx;
        shl r9, 2;
        add r9, 8;
        add r9, r14;                           // &out[8 + rbx*4]
        mov_d [r9 + 0], rbp;                   // var_id

        add rbx, 1;

      hm_gen_scan_bound_inc:
        add r12, 1;
        jmp hm_gen_scan_bound;

      hm_gen_scan_bound_done:
        // n_bound in rbx. Compute n_body (saved earlier at [rsp+32]).
        mov r13, [rsp + 32];                   // n_body

        // required_bytes = 8 + 4*rbx + 16*r13.
        mov rax, rbx;
        shl rax, 2;
        mov rcx, r13;
        shl rcx, 4;
        add rax, rcx;
        add rax, 8;
        cmp r15, rax;
        jb  hm_gen_too_small;

        // Write header.
        mov_d [r14 + 0], rbx;                  // n_bound_vars
        mov_d [r14 + 4], r13;                  // n_body_nodes

        // --- Pass 5: emit body nodes in body-idx order.
        //     For each pool_idx with map[i] != 0xFFFF AND find(i) == i,
        //     emit a body node at offset (8 + 4*n_bound + body_idx*16).
        //
        // Pin body_base in rbp (callee-save) so it survives every
        // nested _hm_find CALL in the emit loop below -- r10 is
        // caller-save under SysV and _hm_find's leaf prologue uses it
        // as scratch, so a flat `mov r10, body_base` would be
        // clobbered on the first find call.

        mov rbp, r14;                          // rbp = body_base scratch (reassigned below)
        add rbp, 8;
        mov rax, rbx;
        shl rax, 2;
        add rbp, rax;                          // rbp = body_base

        mov r12, 1;                            // pool_idx = 1

      hm_gen_emit_loop:
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];
        cmp r12, rax;
        jae hm_gen_emit_done;

        // Only visited roots emit.
        mov r9, r12;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        je  hm_gen_emit_inc;

        mov rdi, r12;
        call _hm_find;
        cmp rax, r12;
        jne hm_gen_emit_inc;                   // alias; emission handled by root

        // dst = body_base + body_idx*16  (body_idx reloaded from map).
        mov r9, r12;
        shl r9, 1;
        lea r11, [rip + _hm_subst_table];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];
        xor rcx, rcx;
        mov_b rcx, [r9 + 1];
        shl rcx, 8;
        or  rax, rcx;                          // body_idx
        shl rax, 4;
        mov r8, rbp;                           // rbp = body_base (callee-save)
        add r8, rax;                           // r8 = dst_addr

        // Node addr.
        mov r9, r12;
        shl r9, 4;
        lea r11, [rip + _hm_pool];
        add r9, r11;                           // r9 = node_addr

        xor rcx, rcx;
        mov_b rcx, [r9 + 0];                   // kind

        cmp rcx, 1;
        je  hm_gen_emit_tyvar;
        cmp rcx, 2;
        je  hm_gen_emit_tycon;
        cmp rcx, 3;
        je  hm_gen_emit_tyapp;

        jmp hm_gen_mismatch;

      hm_gen_emit_tyvar:
        // Load var_id. Check env membership.
        xor rax, rax;
        mov_d rax, [r9 + 4];
        mov rdx, rax;                          // rdx = var_id

        mov rcx, [rsp + 40];
        xor r11, r11;                          // j = 0

      hm_gen_emit_tyvar_env_scan:
        cmp r11, rcx;
        jae hm_gen_emit_tyvar_bound;

        mov r15, r11;
        shl r15, 2;
        lea rax, [rip + _hm_subst_table];
        add r15, rax;
        add r15, 256;
        xor rax, rax;
        mov_d rax, [r15 + 0];
        cmp rax, rdx;
        je  hm_gen_emit_tyvar_external;

        add r11, 1;
        jmp hm_gen_emit_tyvar_env_scan;

      hm_gen_emit_tyvar_bound:
        // Bound TyVar: arg0 = var_id, flags = 0.
        mov rax, 1;                            // HM_KIND_TYVAR
        mov_b [r8 + 0], rax;
        xor rax, rax;
        mov_b [r8 + 1], rax;                   // arity
        mov_b [r8 + 2], rax;                   // depth
        mov_b [r8 + 3], rax;                   // flags
        mov_d [r8 + 4], rdx;                   // arg0 = var_id
        mov_d [r8 + 8], rax;                   // arg1
        mov_d [r8 + 12], rax;                  // resolved
        jmp hm_gen_emit_inc;

      hm_gen_emit_tyvar_external:
        // External TyVar: arg0 = pool_idx (r12 is the root),
        // flags = HM_VARFLAG_EXTERNAL.
        mov rax, 1;                            // HM_KIND_TYVAR
        mov_b [r8 + 0], rax;
        xor rax, rax;
        mov_b [r8 + 1], rax;                   // arity
        mov_b [r8 + 2], rax;                   // depth
        mov rax, 1;                            // HM_VARFLAG_EXTERNAL
        mov_b [r8 + 3], rax;
        mov_d [r8 + 4], r12;                   // arg0 = pool_idx
        xor rax, rax;
        mov_d [r8 + 8], rax;
        mov_d [r8 + 12], rax;
        jmp hm_gen_emit_inc;

      hm_gen_emit_tycon:
        // Copy kind=TyCon, arity byte, con_id.
        mov rax, 2;                            // HM_KIND_TYCON
        mov_b [r8 + 0], rax;
        xor rax, rax;
        mov_b rax, [r9 + 1];                   // arity
        mov_b [r8 + 1], rax;
        xor rax, rax;
        mov_b [r8 + 2], rax;                   // depth
        mov_b [r8 + 3], rax;                   // flags
        xor rax, rax;
        mov_d rax, [r9 + 4];                   // con_id
        mov_d [r8 + 4], rax;
        xor rax, rax;
        mov_d [r8 + 8], rax;                   // arg1
        mov_d [r8 + 12], rax;                  // resolved
        jmp hm_gen_emit_inc;

      hm_gen_emit_tyapp:
        // Translate pool_idx children -> body_idx via the map.
        xor rax, rax;
        mov_d rax, [r9 + 4];                   // left pool_idx
        mov rdi, rax;
        call _hm_find;
        // Lookup map[rax].
        mov r11, rax;
        shl r11, 1;
        lea r15, [rip + _hm_subst_table];
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        xor rcx, rcx;
        mov_b rcx, [r11 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        je  hm_gen_mismatch;                   // reach bug
        mov rdx, rax;                          // rdx = left body_idx

        xor rax, rax;
        mov_d rax, [r9 + 8];                   // right pool_idx
        mov rdi, rax;
        call _hm_find;
        mov r11, rax;
        shl r11, 1;
        lea r15, [rip + _hm_subst_table];
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        xor rcx, rcx;
        mov_b rcx, [r11 + 1];
        shl rcx, 8;
        or  rax, rcx;
        cmp rax, 0xFFFF;
        je  hm_gen_mismatch;
        mov r15, rax;                          // r15 = right body_idx

        mov rax, 3;                            // HM_KIND_TYAPP
        mov_b [r8 + 0], rax;
        mov rax, 2;                            // arity = 2
        mov_b [r8 + 1], rax;
        xor rax, rax;
        mov_b [r8 + 2], rax;
        mov_b [r8 + 3], rax;
        mov_d [r8 + 4], rdx;                   // body-relative left
        mov_d [r8 + 8], r15;                   // body-relative right
        mov_d [r8 + 12], rax;                  // resolved
        jmp hm_gen_emit_inc;

      hm_gen_emit_inc:
        add r12, 1;
        jmp hm_gen_emit_loop;

      hm_gen_emit_done:
        xor rax, rax;                          // HM_OK
        jmp hm_gen_epilogue;

      hm_gen_too_small:
        mov rax, 0x2D03;                       // HM_ERR_OUT_TOO_SMALL
        jmp hm_gen_epilogue;

      hm_gen_mismatch:
        mov rax, 0x2D01;                       // HM_ERR_MISMATCH
        jmp hm_gen_epilogue;

      hm_gen_epilogue:
        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
