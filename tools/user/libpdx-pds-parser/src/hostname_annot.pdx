// src/hostname_annot.pdx -- libpdx-pds-parser (paideia-os#2671, R223.M6)
//
// HostnameAnnot: parser-tier primitive that recognises the `@hostname`
// annotation that MAY prefix a pipeline stage. The annotation is the
// parse-side half of the remote-shell transport (R105+ substrate; the
// encrypted-channel wire-up is a separate milestone). At R223.M6 we
// commit ONLY the parse surface: a caller walking a stage's leading
// bytes consumes `@<hostname>` + trailing whitespace (if present) and
// emits one 32-byte HostAnnot record describing where the stage should
// execute (local, or on the hashed remote host).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R223 is the pipeline-lang umbrella (paideia-os#2487). R223.M1
// (`src/pipeline.pdx`) landed the lexer-tier `cmd1 arg | cmd2 ...`
// stage parser. R223.M2 (`src/record_projection.pdx`) landed the
// `select`/`project` field-selector parser. R223.M3 (`filter_op.pdx`)
// and R223.M4 (`sort_group_reduce.pdx`) landed the four core
// combinator parsers. R223.M6 (THIS module) adds the HOSTNAME-
// ANNOTATION recogniser: a POST-pass on each pipeline stage's leading
// bytes that decides where the stage runs.
//
//   `@workstation echo foo`
//     -- stage runs on `workstation` (hostname_hash = FNV-1a 64 of
//        "workstation"; IS_LOCAL bit clear).
//
//   `echo foo`
//     -- stage is local (IS_LOCAL bit set; hostname_hash zero).
//
//   `@ echo foo`
//     -- stage is EXPLICITLY local (IS_LOCAL bit set; empty-@ idiom
//        reserved for future federation-override syntax). At M6 the
//        semantics are byte-identical to no-@.
//
// The substrate half (encrypted-transport wire-up) is a SEPARATE
// milestone that consumes HostAnnot records emitted here; this module
// is strictly parse-only.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//   StagePrefix := ( '@' Hostname? WS* )?
//   Hostname    := [A-Za-z0-9.-]+   (byte length 1..HA_HOSTNAME_MAX = 16)
//   WS          := 0x20 | 0x09 | 0x0A | 0x0D
//
// Rejected: a hostname whose byte length exceeds HA_HOSTNAME_MAX (16).
// Everything else is well-formed:
//
//   * No `@` at the first byte -> IS_LOCAL record, bytes_consumed = 0.
//   * `@` followed by WS or EOI -> IS_LOCAL record (empty-@ idiom),
//     bytes_consumed = 1 + trailing-WS run.
//   * `@<hostname>` -> remote record with hash of the hostname bytes,
//     bytes_consumed = 1 + hostname_len + trailing-WS run.
//
// Leading whitespace BEFORE the `@` (or before the first non-`@` byte)
// is NOT consumed: this module is a POST-pass on a stage's leading
// bytes AFTER the pipeline stage parser has already trimmed between-
// stage whitespace at R223.M1. If the caller passes bytes that start
// with whitespace, this module sees no `@` and returns IS_LOCAL with
// bytes_consumed = 0 -- that whitespace belongs to the stage body
// grammar, not to the hostname annotation.
//
// =============================================================================
// HOSTANNOT RECORD (32 bytes)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -----------------------------------------------------
//     0      4   magic           u32   'HOST' LE (0x54534F48)
//     4      4   flags           u32   bit 0 = HA_FLAG_IS_LOCAL
//                                      (set iff no hostname, i.e. no
//                                      `@` or empty `@`); bits 1..31
//                                      reserved, zero at M6.
//     8      8   hostname_hash   u64   FNV-1a 64 of hostname bytes.
//                                      Zero iff IS_LOCAL.
//    16     16   hostname_inline [u8;16] -- ASCII hostname, zero-padded.
//                                      All zero iff IS_LOCAL.
//
//   total: 32 B (HA_RECORD_BYTES)
//
// Rationale:
//
//   * Stride is a power of two: a dispatcher indexing an array of
//     HostAnnot records multiplies by 32 via `shl rN, 5` -- no 2-op
//     `imul r, imm` (per feedback_pdx_encoder_pitfalls).
//   * Magic 'HOST' = 0x54534F48 LE reads as the 4-byte ASCII string
//     "HOST" in a hex-dump sequential scan (per the Wave 125
//     SortGroupReduce magic-reconciliation lesson: byte-sequence
//     readability matters more than numeric prettiness).
//   * The 16-byte inline capacity covers the "short hostname" idiom
//     the brief anchors (workstation, laptop, lab-01, 10.0.0.5,
//     node.local, etc.). Longer FQDNs (> 16 bytes) are rejected at
//     parse with HA_ERR_HOSTNAME_TOO_LONG; the M6.1 landing introduces
//     a pointer-indirect long-hostname mode.
//   * The hash is INLINE (u64) rather than (ptr, len): the record is
//     byte-identical when hashed into a federation-plan fingerprint,
//     and the downstream dispatcher does not need to dereference back
//     into the pipeline source bytes to compare targets.
//   * The flags u32 is sized at 4 bytes (not u16) so the record stays
//     naturally aligned at 4-byte boundaries across magic/flags/hash;
//     a u16 flags would force a 2-byte reserved pad.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ha_init() -> ()
//
//     Idempotent lazy boot hook. M6 holds NO .bss state (every
//     HostAnnot record is caller-owned on every path; the check
//     primitive operates as a pure FNV compare over a caller-supplied
//     record + hostname bytes). Bare `ret`. Kept for parallelism with
//     the DispatchMode (R222.M6) / CmdRegistry (R222.M5) / DescribeSig
//     (R222.M8) init-hook family so a later landing that adds .bss
//     (per-session hostname counters, a hostname-intern table) does
//     not break the API.
//
//     Register map: () -> rax (ignored).
//
//   _ha_parse(bytes, bytes_len, out, out_cap)
//                                            -> (bytes_consumed<<32) | status
//
//     Parses the OPTIONAL `@hostname` prefix of a pipeline stage's
//     leading bytes. Writes one 32-byte HostAnnot record at
//     [out, out+32). Returns `(bytes_consumed << 32) | status` where
//     `bytes_consumed` is the number of input bytes the annotation
//     occupied (0 if no `@` prefix; 1 + hostname_len + trailing-WS run
//     otherwise). The caller resumes stage-body parsing at
//     `bytes + bytes_consumed`.
//
//     Flow:
//       1. Validate out != 0, out_cap >= HA_RECORD_BYTES (32).
//       2. Zero-fill the 32-byte record via four u64 stores.
//       3. If bytes_len == 0 OR bytes == 0 OR [bytes + 0] != '@':
//            -> emit IS_LOCAL record (magic, flags=1, hash=0,
//               inline=all-zero); bytes_consumed = 0.
//       4. Else:
//            a. Advance cursor past the '@'.
//            b. Scan hostname: run of bytes in [A-Za-z0-9.-];
//               hostname_len = cursor_end - cursor_start.
//            c. If hostname_len == 0:
//                 -> emit IS_LOCAL record; bytes_consumed = 1 +
//                    trailing-WS run.
//            d. If hostname_len > HA_HOSTNAME_MAX (16):
//                 -> HA_ERR_HOSTNAME_TOO_LONG.
//            e. Else:
//                 -> compute FNV-1a 64 over hostname bytes; copy up
//                    to 16 bytes into hostname_inline; zero-pad to
//                    16; set magic + flags=0 + hash + inline;
//                    bytes_consumed = 1 + hostname_len + trailing-WS
//                    run.
//       5. Return (bytes_consumed << 32) | HA_OK.
//
//     Returns:
//       HA_OK                      (0)       on success
//       HA_ERR_HOSTNAME_TOO_LONG   (0x5301)  hostname > 16 bytes
//       HA_ERR_OUT_TOO_SMALL       (0x5302)  out null or out_cap < 32
//
//     Note: SYNTAX cases (`@` immediately followed by a non-hostname
//     non-WS byte like `@|` or `@/foo`) are treated as EMPTY-@ at M6:
//     the `@` is consumed, hostname_len = 0, IS_LOCAL is set, and
//     parse continues. The downstream pipeline-stage dispatcher is
//     where the next byte reparses as the stage body. HA_ERR_SYNTAX
//     (0x5300) is RESERVED for a stricter M6.1 landing that refuses
//     the empty-@ idiom when a strict-federation-mode toggle is on.
//
//     Register map (SysV):
//       _ha_parse(rdi, rsi, rdx, rcx) -> rax
//         rdi = bytes
//         rsi = bytes_len
//         rdx = out
//         rcx = out_cap
//         rax = (bytes_consumed << 32) | status
//
//   _ha_check(record, host_ptr, host_len) -> status
//
//     Type-check a HostAnnot record against a caller-supplied hostname
//     string. The caller passes the record emitted by _ha_parse (or
//     a serialised copy thereof) and the hostname string the current
//     execution context is bound to (empty if local). Returns HA_OK
//     iff the record MATCHES the hostname per these rules:
//
//       * IS_LOCAL record + host_len == 0:         HA_OK
//       * IS_LOCAL record + host_len > 0:          HA_ERR_HOST_MISMATCH
//       * Remote record + host_len == 0:           HA_ERR_HOST_MISMATCH
//       * Remote record + host_len > 0:            compute FNV-1a 64
//           of host_ptr[0..host_len), compare to record.hostname_hash;
//           match -> HA_OK; mismatch -> HA_ERR_HOST_MISMATCH.
//
//     Flow:
//       1. Validate record != 0; magic == 'HOST' at [record+0].
//       2. host_len > 0 => host_ptr != 0.
//       3. Dispatch on IS_LOCAL bit + host_len; compute FNV-1a 64 on
//          the remote-remote branch.
//
//     Returns:
//       HA_OK                      (0)       on match
//       HA_ERR_BAD_RECORD          (0x5303)  record null or magic !=
//                                            'HOST'
//       HA_ERR_HOST_MISMATCH       (0x5304)  record vs host disagree
//       HA_ERR_BAD_HOST_PTR        (0x5305)  host_len > 0 && host_ptr
//                                            == 0
//
//     Register map (SysV):
//       _ha_check(rdi, rsi, rdx) -> rax
//         rdi = record
//         rsi = host_ptr
//         rdx = host_len
//         rax = HA_OK | HA_ERR_*
//
// =============================================================================
// STATUS BAND -- 0x5300..0x53FF
// =============================================================================
//
//   HA_OK                       = 0
//   HA_ERR_SYNTAX               = 0x5300   // reserved for M6.1 strict-mode
//   HA_ERR_HOSTNAME_TOO_LONG    = 0x5301
//   HA_ERR_OUT_TOO_SMALL        = 0x5302
//   HA_ERR_BAD_RECORD           = 0x5303
//   HA_ERR_HOST_MISMATCH        = 0x5304
//   HA_ERR_BAD_HOST_PTR         = 0x5305
//
// The 0x5300..0x53FF range is reserved for the R223.M6 hostname-
// annotation band. The parallel R223.M5 arm occupies 0x5200..0x52FF;
// the two bands are disjoint so a downstream dispatcher's compound
// error path can distinguish flag/positional partition faults from
// hostname-annotation faults. Slots 0x5306..0x53FF reserved for
// R223.M6.1+ follow-ups (long-hostname pointer-indirect mode,
// strict-federation-mode refusal of empty-@, cross-session hostname
// cache misses, canonical-form hostname normalisation errors).
//
// Grep confirmation at R223.M6 landing time:
//   grep -rE '0x530[0-5]\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/hostname-annotation.md.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- bit-isolation uses imm8 variants only
//     (`and rN, 1` for the IS_LOCAL mask); precedent dispatch_mode.pdx
//     line 422 `and rax, 0x3C` imm8 variant.
//   - No 2-op `imul rN, imm` -- byte-copy loops step by 1; FNV
//     uses the one-op `mul rN` form (unsigned-mul rdx:rax = rax*rN).
//   - FNV constants 0xCBF29CE484222325 (offset basis) and 0x100000001B3
//     (prime) are > imm32, so they load via `mov rN, imm64` (MOVABS).
//     The 'HOST' magic (0x54534F48) fits in imm32 with bit 31 clear.
//     Precedent for FNV-1a 64 inline: history.pdx line 727-728
//     (_h_append inlined FNV).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `HostnameAnnot` matches `hostname_annot.pdx`.
//   - Labels prefixed `ha_` -- disjoint from every prior parser-tier
//     label prefix (u8n_, gi_, wp_, sch_sig_, cmd_sig_, fi_, afs_,
//     pl_, pl_lam_, rp_, ll_, cc_, er_, cr_, cmdreg_, hm_, rt_, dl_,
//     se_, te_, cl_, dm_, fo_, sgr_, jc_, fh_, ast_, sm_, ls_, lex_,
//     eu_, h_, ds_). Never bare `loop` / `if` / `let` / `fn` / `ret`
//     (per reference_paideia_as_reserved_labels).
//   - All `cmp reg, imm` immediates (ASCII literals 0x20..0x7F,
//     HA_HOSTNAME_MAX=16, HA_RECORD_BYTES=32, status codes
//     0x5300..0x5305, magic 0x54534F48) fit imm32 with bit 31 clear
//     so direct cmp-imm32 is sign-extension-safe.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx * 1]` with
//     explicit *1 scale (paideia-as #1248 + U1606 mitigation per
//     libpdx-audit audit_file_sink precedent).
//   - Byte stores via `mov_b [dst + disp], reg` (same shape as
//     DescribeSig name copy); for `[base + idx]` stores precompute
//     the address into a scratch (`mov r9, base; add r9, idx;
//     mov_b [r9 + 0], reg`) to sidestep the mov_b [reg + reg + off],
//     reg encoder gap -- precedent session_env.pdx, job_control.pdx,
//     history.pdx.
//   - u32 stores via `mov_d [dst + disp], reg` (writes low 4 bytes).
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - No chained-displacement addressing with three terms: all
//     [base + off + idx] expressions are precomputed into a scratch
//     via `add` first, then dereferenced via `[rN + 0]`. Precedent:
//     command_sig.pdx name-copy loops.
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
//   * `_ha_init`: bare `ret`. No regs touched. Pure leaf.
//
//   * `_ha_parse`: 6-push callee-save frame (rbx, rbp, r12, r13, r14,
//     r15 = 48 bytes); pure leaf (no nested CALL, FNV inlined). After
//     prologue, rsp%16==(8+48)%16==8; pure-leaf with no CALL does not
//     require rsp%16==0 at a call site because no call site exists;
//     epilogue pops 6 before `ret` so stack balance is restored.
//     Precedent _h_append (R229.M5): same 6-push, 0-sub, FNV-inlined,
//     pure-leaf shape.
//
//     Register plan:
//       rbx = bytes_ptr          (held through FNV loop)
//       rbp = bytes_len
//       r12 = out                (held through zero-fill + inline copy)
//       r13 = cursor into bytes  (walks `@`, hostname run, trailing WS)
//       r14 = hostname_start     (offset into bytes where hostname begins)
//       r15 = hostname_len       (bytes in the matched [A-Za-z0-9.-] run)
//     Scratch: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11.
//     FNV-1a 64 inner loop uses: rax (accumulator), rcx (prime, held
//     through loop), rdx (mul high half - clobbered by `mul`), r10
//     (loop index), r11 (byte load).
//
//   * `_ha_check`: 1-push callee-save frame (rbx = 8 bytes); pure
//     leaf (no nested CALL, FNV inlined). Entry rsp%16==8; +8 push
//     = %16==0; no CALL; pop; ret.
//
//     Register plan:
//       rbx = record            (held through flow)
//     Scratch: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11.
//     FNV-1a 64 uses the same register plan as _ha_parse.
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// Not applicable at M6: this module holds no .bss state. Every
// HostAnnot record is caller-owned on both the parse and check paths.
// `_ha_init` is a bare `ret` placeholder; a later landing that adds
// .bss (per-session hostname counters, a hostname-intern table) will
// flesh it out behind the same name.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R223.M1 (Pipeline)  --  this module is a POST-pass on each
//     PipelineStage record's leading bytes. The caller identifies a
//     stage's cmd_name_offset / cmd_name_len (R223.M1 fields), hands
//     the bytes starting at cmd_name_offset to this module, and uses
//     the returned bytes_consumed to skip past the annotation before
//     dispatching the stage body.
//
//   R223.M5 (parallel; flag/positional partition)  --  disjoint error
//     band (0x5200..0x52FF); independent record shape; no shared
//     surface. The two arms land under one wave and consolidate via
//     the main agent at batch close.
//
//   R223.M7 (future; pipeline fuzz corpus)  --  will fold HostAnnot
//     into the fuzz-harness coverage once a FUZZ_KIND_HOSTANNOT target
//     is added. The parser is already pure-leaf discipline-compliant
//     (every byte load zero-extended; every status code imm32-safe;
//     no imul-r-imm) so the fuzz-harness drop-in requires no changes
//     to this module.
//
//   Substrate wire-up (remote-shell daemon)  --  a FUTURE milestone
//     outside the R223 umbrella consumes HostAnnot records emitted
//     here and routes stage bytes to the encrypted-channel transport.
//     At R223.M6 the substrate is NOT present; the record is a pure
//     parse artefact.
//
// =============================================================================
// Upstream: paideia-os#2487 (R223 umbrella), paideia-os#2671 (THIS
// ticket, R223.M6). Substrate: paideia-os#2666 (R223.M1 Pipeline
// stage parser -- caller identifies the per-stage leading bytes this
// module parses). Design doc:
// design/shell/hostname-annotation.md. Related:
// design/shell/remote-shell-daemon.md (R105+ encrypted-transport
// substrate the record ultimately feeds),
// design/shell/remote-shell-hybrid-kem.md (post-quantum KEM wire-up).

module HostnameAnnot = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Small-value range 0x5300..0x53FF, reserved for the R223.M6
  // hostname-annotation band. Disjoint from every prior landed
  // satellite band and from the parallel R223.M5 arm (0x5200..0x52FF).
  //
  // Grep confirmation at R223.M6 landing time:
  //   grep -rE '0x530[0-5]\b' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/hostname-annotation.md.

  pub let HA_OK                       : u64 = 0
  pub let HA_ERR_SYNTAX               : u64 = 0x5300
  pub let HA_ERR_HOSTNAME_TOO_LONG    : u64 = 0x5301
  pub let HA_ERR_OUT_TOO_SMALL        : u64 = 0x5302
  pub let HA_ERR_BAD_RECORD           : u64 = 0x5303
  pub let HA_ERR_HOST_MISMATCH        : u64 = 0x5304
  pub let HA_ERR_BAD_HOST_PTR         : u64 = 0x5305

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let HA_RECORD_BYTES             : u64 = 32
  pub let HA_HOSTNAME_MAX             : u64 = 16

  // Magic: 'HOST' little-endian = 0x54534F48. Reads as the 4-byte
  // ASCII string "HOST" in a hex dump (bytes 48 4F 53 54 = H O S T).
  pub let HA_RECORD_MAGIC             : u64 = 0x54534F48

  // Field offsets within one HostAnnot record (byte offsets from base).
  pub let HA_OFF_MAGIC                : u64 = 0    // u32
  pub let HA_OFF_FLAGS                : u64 = 4    // u32
  pub let HA_OFF_HOSTNAME_HASH        : u64 = 8    // u64
  pub let HA_OFF_HOSTNAME_INLINE      : u64 = 16   // [u8;16]

  // Flag bits in the `flags` u32 at [record + 4].
  //
  //   bit 0  HA_FLAG_IS_LOCAL  set iff the stage is LOCAL (no `@`
  //                            prefix OR `@` with empty hostname).
  //                            Clear iff a hostname was parsed; in
  //                            that case the hash + inline fields
  //                            carry the parsed hostname.
  //   bits 1..31  reserved; always 0 at M6.
  pub let HA_FLAG_IS_LOCAL            : u64 = 0x00000001

  // ==========================================================================
  // _ha_init() -> ()
  //
  // Idempotent lazy boot hook. M6 holds no .bss state so the body is
  // a bare `ret`. Kept for parallelism with the DispatchMode /
  // CmdRegistry / DescribeSig init-hook family; a later landing that
  // adds .bss will flesh this out without an ABI break.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ha_ini_ (none at M6).
  // ==========================================================================
  pub let _ha_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R223.M6 (#2671): _ha_init is a bare ret at this landing. The module holds no .bss state at M6 (every HostAnnot record is caller-owned on both the parse and check paths; the check primitive operates as a pure FNV compare over a caller-supplied record + hostname bytes). The entry point exists for parallelism with the DispatchMode (R222.M6) / CmdRegistry (R222.M5) / DescribeSig (R222.M8) init-hook family so a later landing that adds .bss (e.g., per-session hostname counters or a hostname-intern table) does not break the API. Pure leaf; zero pushes; no stack frame; no nested CALL. No cmp immediates; no byte loads; no stores. Labels prefixed ha_ini_ (none at M6).",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _ha_parse(bytes, bytes_len, out, out_cap)
  //                                       -> (bytes_consumed<<32) | status
  //
  //   rdi = bytes
  //   rsi = bytes_len
  //   rdx = out
  //   rcx = out_cap
  //   rax = (bytes_consumed << 32) | status
  //
  // Parses the OPTIONAL `@hostname` prefix of a pipeline stage's
  // leading bytes. See the top-of-file API block for the full flow
  // and semantics. Pure leaf (6-push, FNV-1a 64 inlined; no nested
  // CALL).
  //
  // Prologue: 6 callee-save pushes (rbx, rbp, r12, r13, r14, r15 =
  // 48 B); no `sub rsp` needed. Entry rsp%16==8; +48 pushes =
  // rsp%16==8; no CALL fires. Epilogue pops 6 before `ret`.
  //
  // Labels prefixed ha_pa_.
  // ==========================================================================
  pub let _ha_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes: u64) (bytes_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M6 (#2671): _ha_parse recognises the OPTIONAL `@hostname` prefix of a pipeline stage's leading bytes and emits a 32-byte HostAnnot record. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=out, r13=cursor, r14=hostname_start, r15=hostname_len); pure leaf (FNV-1a 64 inlined) with no nested CALL so no sub-rsp pad is needed. Guards: out != 0 (cmp rdx, 0; je ha_pa_oos); out_cap >= HA_RECORD_BYTES (32) (cmp rcx, 32; jb ha_pa_oos). Zero-fill the 32-byte record at [out, out+32) via four u64 stores at displacements 0, 8, 16, 24 with rax=0. Fast-path: if bytes_len == 0 OR bytes == 0, emit the local record (magic 'HOST' u32 at [out+0] via mov_d; HA_FLAG_IS_LOCAL=1 at [out+4] via mov_d) and return (0 << 32) | HA_OK. First-byte probe: load byte at [rbx + 0] via xor rax,rax; mov_b rax,[rbx+0*1]; cmp rax, 0x40 (ASCII '@'); jne ha_pa_local (NO '@' prefix -> IS_LOCAL path). On '@' seen: advance r13 (cursor) to 1 (past '@'); save hostname_start=1 into r14; scan hostname run of bytes in [A-Za-z0-9.-]: cmp byte against 0x2D ('-'), 0x2E ('.'), 0x30..0x39, 0x41..0x5A, 0x61..0x7A per byte; advance r13 on match; stop on first non-matching byte or EOI. hostname_len = r13 - r14 into r15. Decision: hostname_len == 0 (empty-@ idiom) -> emit IS_LOCAL (same body as the no-@ case) with bytes_consumed = 1 + trailing-WS run; hostname_len > HA_HOSTNAME_MAX (16) -> HA_ERR_HOSTNAME_TOO_LONG (packed with hostname-end offset for diagnostics); else -> emit REMOTE record. REMOTE emit: write magic 'HOST' u32 at [out+0] via mov_d; write flags u32=0 at [out+4] via mov_d; copy hostname_len bytes from [rbx + r14] into [out + 16 + i] via byte-by-byte loop (precompute dst = out + 16 + i into r9 before mov_b to sidestep the three-term addressing encoder gap, precedent session_env.pdx / job_control.pdx / history.pdx); zero-pad bytes [16 + hostname_len .. 32) via byte-by-byte loop. Compute FNV-1a 64 over (rbx + r14, r15): rax = 0xCBF29CE484222325 (offset basis, imm64 MOVABS), rcx = 0x100000001B3 (prime, imm64 MOVABS held across loop), r10 = 0 (i); loop: cmp r10, r15 / jae done; precompute src = rbx + r14 + r10 into r11 (3-term address collapsed); xor r9, r9; mov_b r9, [r11 + 0]; xor rax, r9; xor rdx, rdx; mul rcx (rdx:rax = rax * prime; low in rax); add r10, 1; jmp loop; done -> write rax at [out + 8] (u64). Trailing-WS run: after the hostname (or after '@' in the empty-@ case), advance r13 while [rbx + r13] is in {0x20, 0x09, 0x0A, 0x0D} AND r13 < rbp. Pack return: bytes_consumed = r13; packed = (r13 << 32) | HA_OK; shl r13, 32; mov rax, r13; or rax, 0 (HA_OK). All cmp immediates (0, 1, 7, 8, 16, 32, 48, 57, 65, 90, 97, 122, 0x09, 0x0A, 0x0D, 0x20, 0x2D, 0x2E, 0x30, 0x39, 0x40, 0x41, 0x5A, 0x5F, 0x61, 0x7A, HA_HOSTNAME_MAX=16, HA_RECORD_BYTES=32, 0x5301, 0x5302, 0x54534F48) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. The 'HOST' magic 0x54534F48 fits as imm32 (< 0x80000000). FNV constants are > imm32 and load via MOVABS (10-byte REX+mov encoding); precedent history.pdx line 727-728. No test; no and-imm64; no imul-r-imm (FNV uses one-op `mul rcx`); no multiline let; no three-term addressing (all [base+idx+off] precomputed). Labels prefixed ha_pa_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save args into callee-save regs.
        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        mov r12, rdx;                          // out
        xor r13, r13;                          // cursor = 0
        xor r14, r14;                          // hostname_start = 0
        xor r15, r15;                          // hostname_len   = 0

        // ---- Validate out buffer ---------------------------------------
        cmp r12, 0;                            // out != 0
        je  ha_pa_oos;

        cmp rcx, 32;                           // out_cap >= HA_RECORD_BYTES
        jb  ha_pa_oos;

        // ---- Zero-fill 32-B record via four u64 stores -----------------
        xor rax, rax;
        mov [r12 + 0], rax;
        mov [r12 + 8], rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;

        // ---- Empty-input fast path -------------------------------------
        // bytes_len == 0 -> local record, bytes_consumed = 0.
        cmp rbp, 0;
        je  ha_pa_local_zero;

        // bytes == 0 -> local record, bytes_consumed = 0.
        cmp rbx, 0;
        je  ha_pa_local_zero;

        // ---- First-byte probe ------------------------------------------
        // Load byte at [bytes + 0].
        xor rax, rax;
        mov_b rax, [rbx + 0 * 1];
        cmp rax, 0x40;                         // '@'
        jne ha_pa_local_zero;

        // ---- '@' seen; advance cursor past '@' and scan hostname -------
        mov r13, 1;                            // cursor := 1 (past '@')
        mov r14, 1;                            // hostname_start := 1

      ha_pa_scan:
        cmp r13, rbp;
        jae ha_pa_scan_done;
        // Load byte at [bytes + cursor * 1].
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        // Allowed: '-', '.', '0'..'9', 'A'..'Z', 'a'..'z'.
        cmp rax, 0x2D;                         // '-'
        je  ha_pa_scan_advance;
        cmp rax, 0x2E;                         // '.'
        je  ha_pa_scan_advance;
        cmp rax, 0x30;                         // '0'
        jb  ha_pa_scan_done;
        cmp rax, 0x39;                         // '9'
        jbe ha_pa_scan_advance;
        cmp rax, 0x41;                         // 'A'
        jb  ha_pa_scan_done;
        cmp rax, 0x5A;                         // 'Z'
        jbe ha_pa_scan_advance;
        cmp rax, 0x61;                         // 'a'
        jb  ha_pa_scan_done;
        cmp rax, 0x7A;                         // 'z'
        ja  ha_pa_scan_done;

      ha_pa_scan_advance:
        add r13, 1;
        jmp ha_pa_scan;

      ha_pa_scan_done:
        // hostname_len = cursor - hostname_start.
        mov r15, r13;
        sub r15, r14;

        // Empty hostname (`@` immediately followed by non-hostname byte
        // or EOI) -> emit LOCAL record with bytes_consumed = cursor +
        // trailing-WS. The cursor is already past '@' (at offset 1 or
        // further if nothing matched).
        cmp r15, 0;
        je  ha_pa_local_at_consumed;

        // Hostname too long?
        cmp r15, 16;                           // HA_HOSTNAME_MAX
        ja  ha_pa_too_long;

        // ---- REMOTE record emit ----------------------------------------
        // magic 'HOST' u32 at [out + 0].
        mov r9, 0x54534F48;                    // HA_RECORD_MAGIC
        mov_d [r12 + 0], r9;

        // flags u32 = 0 at [out + 4].
        xor rax, rax;
        mov_d [r12 + 4], rax;

        // Copy hostname bytes into [out + 16 + i].
        xor r10, r10;                          // i = 0

      ha_pa_name_copy:
        cmp r10, r15;
        jae ha_pa_name_pad;
        // src_addr = bytes + hostname_start + i (precomputed to sidestep
        // three-term addressing).
        mov r11, rbx;
        add r11, r14;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        // dst_addr = out + 16 + i.
        mov r9, r12;
        add r9, 16;                            // HA_OFF_HOSTNAME_INLINE
        add r9, r10;
        mov_b [r9 + 0], rax;
        add r10, 1;
        jmp ha_pa_name_copy;

      ha_pa_name_pad:
        // Zero-pad bytes [16 + hostname_len .. 32).
        // r10 currently equals hostname_len; walk until it hits 16.
      ha_pa_name_pad_loop:
        cmp r10, 16;                           // HA_HOSTNAME_MAX
        jae ha_pa_fnv_begin;
        mov r9, r12;
        add r9, 16;
        add r9, r10;
        xor rax, rax;
        mov_b [r9 + 0], rax;
        add r10, 1;
        jmp ha_pa_name_pad_loop;

      ha_pa_fnv_begin:
        // Inlined FNV-1a 64 over hostname bytes.
        //   src bytes: [rbx + r14 + i] for i in 0..r15
        //   accumulator: rax = 0xCBF29CE484222325 (offset basis)
        //   prime:       rcx = 0x100000001B3 (held across loop)
        //   mul rcx: rdx:rax = rax * prime; rdx clobbered.
        mov rax, 0xCBF29CE484222325;           // offset basis (imm64)
        mov rcx, 0x100000001B3;                // prime (imm64)
        xor r10, r10;                          // i = 0

      ha_pa_fnv_loop:
        cmp r10, r15;
        jae ha_pa_fnv_done;
        // src_addr = rbx + r14 + r10 into r11.
        mov r11, rbx;
        add r11, r14;
        add r11, r10;
        xor r9, r9;
        mov_b r9, [r11 + 0];                   // byte (zero-ext)
        xor rax, r9;                           // h ^= byte
        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * prime
        add r10, 1;
        jmp ha_pa_fnv_loop;

      ha_pa_fnv_done:
        // Write hash u64 at [out + 8].
        mov [r12 + 8], rax;

        // ---- Trailing-WS run after hostname ----------------------------
        // r13 already points to the first non-hostname byte.
      ha_pa_ws_remote:
        cmp r13, rbp;
        jae ha_pa_ok_pack;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;                         // SP
        je  ha_pa_ws_remote_advance;
        cmp rax, 0x09;                         // TAB
        je  ha_pa_ws_remote_advance;
        cmp rax, 0x0A;                         // LF
        je  ha_pa_ws_remote_advance;
        cmp rax, 0x0D;                         // CR
        je  ha_pa_ws_remote_advance;
        jmp ha_pa_ok_pack;

      ha_pa_ws_remote_advance:
        add r13, 1;
        jmp ha_pa_ws_remote;

      ha_pa_ok_pack:
        // Pack return: (bytes_consumed << 32) | HA_OK.
        mov rax, r13;
        shl rax, 32;                           // HA_OK = 0 so no `or`
        jmp ha_pa_epilogue;

      // --------------------------------------------------------------------
      // LOCAL emit paths.
      // --------------------------------------------------------------------
      //
      // ha_pa_local_zero:    no `@` seen; cursor = 0; emit LOCAL + 0.
      // ha_pa_local_at_consumed: `@` seen but hostname empty; emit
      //                      LOCAL + bytes_consumed = cursor + trailing-WS.
      //
      // Both paths share the LOCAL record body (magic + flags with
      // IS_LOCAL bit set; hash and inline stay zero from the pre-fill).
      // --------------------------------------------------------------------

      ha_pa_local_zero:
        xor r13, r13;                          // cursor = 0
        jmp ha_pa_local_emit;

      ha_pa_local_at_consumed:
        // r13 already points past '@' (and any non-hostname garbage
        // was NOT consumed; cursor remains at offset 1 unless the
        // scan loop advanced it over 0-match hostname bytes -- which
        // cannot happen because the loop advances only on byte
        // matches). For the empty-@ idiom the cursor is at offset 1
        // (just past the '@') and we now consume trailing WS.
      ha_pa_local_ws:
        cmp r13, rbp;
        jae ha_pa_local_emit;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;                         // SP
        je  ha_pa_local_ws_advance;
        cmp rax, 0x09;                         // TAB
        je  ha_pa_local_ws_advance;
        cmp rax, 0x0A;                         // LF
        je  ha_pa_local_ws_advance;
        cmp rax, 0x0D;                         // CR
        je  ha_pa_local_ws_advance;
        jmp ha_pa_local_emit;

      ha_pa_local_ws_advance:
        add r13, 1;
        jmp ha_pa_local_ws;

      ha_pa_local_emit:
        // magic 'HOST' u32 at [out + 0].
        mov r9, 0x54534F48;                    // HA_RECORD_MAGIC
        mov_d [r12 + 0], r9;
        // flags u32 at [out + 4] = HA_FLAG_IS_LOCAL (1).
        mov rax, 1;                            // HA_FLAG_IS_LOCAL
        mov_d [r12 + 4], rax;
        // Hash + inline left zeroed by the pre-fill.
        // Pack return: (bytes_consumed << 32) | HA_OK.
        mov rax, r13;
        shl rax, 32;
        jmp ha_pa_epilogue;

      // --------------------------------------------------------------------
      // Error return paths.
      // --------------------------------------------------------------------

      ha_pa_too_long:
        // bytes_consumed field carries the end-of-hostname offset
        // (r13) so a diagnostic site can point at the offending span.
        mov rax, r13;
        shl rax, 32;
        or  rax, 0x5301;                       // HA_ERR_HOSTNAME_TOO_LONG
        jmp ha_pa_epilogue;

      ha_pa_oos:
        // bytes_consumed = 0.
        xor rax, rax;
        shl rax, 32;
        or  rax, 0x5302;                       // HA_ERR_OUT_TOO_SMALL
        jmp ha_pa_epilogue;

      // --------------------------------------------------------------------
      // Epilogue.
      // --------------------------------------------------------------------
      ha_pa_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _ha_check(record, host_ptr, host_len) -> status
  //
  //   rdi = record            (ptr to a 32-B HostAnnot record)
  //   rsi = host_ptr          (ptr to hostname bytes; may be 0 if
  //                            host_len == 0)
  //   rdx = host_len          (byte length of hostname)
  //   rax = HA_OK | HA_ERR_*
  //
  // Validate a HostAnnot record and compare it to a caller-supplied
  // hostname. See the top-of-file API block for the full flow and
  // semantics.
  //
  // 1-push callee-save frame (rbx holds `record` across the FNV
  // compare). Pure leaf (FNV-1a 64 inlined; no nested CALL).
  //
  // Entry rsp%16==8; +8 push = rsp%16==0; no CALL; pop; ret. 1-push
  // is sufficient because `record` is the only datum we need to hold
  // across the FNV loop (host_ptr and host_len stay in their caller-
  // save slots; FNV uses rax/rcx/rdx/r10/r11 and does not touch rsi
  // or rbx).
  //
  // Labels prefixed ha_ck_.
  // ==========================================================================
  pub let _ha_check : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (record: u64) (host_ptr: u64) (host_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M6 (#2671): _ha_check validates a 32-B HostAnnot record and compares it against (host_ptr, host_len). 1-push callee-save frame (rbx holds record across the FNV compare); pure leaf (FNV-1a 64 inlined) with no nested CALL. Entry rsp%16==8; +8 push = rsp%16==0; no CALL fires. Guards: record != 0 (cmp rdi, 0; je ha_ck_bad_rec); magic 'HOST' u32 at [record + 0] via xor rax,rax; mov_d rax,[rdi+0]; cmp rax, 0x54534F48; jne ha_ck_bad_rec. host_len > 0 => host_ptr != 0 (cmp rdx, 0; je ha_ck_proceed; cmp rsi, 0; je ha_ck_bad_host_ptr). Load flags u32 at [record + 4] via xor rax,rax; mov_d rax,[rdi+4]. Isolate IS_LOCAL bit via and rax, 1 (imm8). Dispatch: IS_LOCAL=1 branch (cmp rax, 1; je ha_ck_is_local) -> if host_len == 0: HA_OK; else: HA_ERR_HOST_MISMATCH. IS_LOCAL=0 branch (remote): if host_len == 0: HA_ERR_HOST_MISMATCH; else compute FNV-1a 64 over (host_ptr, host_len); compare to record.hostname_hash at [record + 8]; match -> HA_OK; mismatch -> HA_ERR_HOST_MISMATCH. FNV plan: save record into rbx (callee-save) so FNV can clobber rdx (mul high); rax = 0xCBF29CE484222325 (basis, MOVABS); rcx = 0x100000001B3 (prime, MOVABS, held across loop); r10 = 0 (i); loop: cmp r10, rdx; jae done -- wait, rdx holds host_len which `mul` clobbers; must save host_len into r8 first. Register plan corrected: save rbx := rdi (record); save r8 := rdx (host_len); then host_ptr stays in rsi. Loop: cmp r10, r8; jae done; src = rsi + r10 into r11; xor r9, r9; mov_b r9, [r11 + 0]; xor rax, r9; xor rdx, rdx; mul rcx; add r10, 1; jmp. On done, compare rax to [rbx + 8] (u64); equal -> HA_OK; else HA_ERR_HOST_MISMATCH. All cmp immediates (0, 1, 8, 0x54534F48, status codes 0x5303..0x5305) fit imm32 with bit 31 clear. FNV constants are > imm32 and load via MOVABS (precedent history.pdx line 727-728). No test; no and-imm64 (the IS_LOCAL mask uses imm8 `and rax, 1`); no imul-r-imm (FNV uses one-op `mul rcx`); no multiline let; no three-term addressing. Labels prefixed ha_ck_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;

        // Save record into callee-save (we need to re-read [record+8]
        // after the FNV loop, and FNV clobbers rdx + many caller-saves).
        mov rbx, rdi;

        // Also save host_len into r8 BEFORE any `mul` instruction
        // clobbers rdx.
        mov r8, rdx;                           // r8 = host_len

        // ---- Validate record != 0 and magic ----------------------------
        cmp rbx, 0;
        je  ha_ck_bad_rec;

        xor rax, rax;
        mov_d rax, [rbx + 0];                  // magic u32
        cmp rax, 0x54534F48;                   // HA_RECORD_MAGIC
        jne ha_ck_bad_rec;

        // ---- Validate host_ptr vs host_len -----------------------------
        // host_len > 0 => host_ptr != 0.
        cmp r8, 0;
        je  ha_ck_hlen_zero_ok;
        cmp rsi, 0;
        je  ha_ck_bad_host_ptr;

      ha_ck_hlen_zero_ok:
        // ---- Read flags, isolate IS_LOCAL bit --------------------------
        xor rax, rax;
        mov_d rax, [rbx + 4];                  // flags u32
        and rax, 1;                            // imm8; isolate IS_LOCAL

        cmp rax, 1;
        je  ha_ck_is_local;

        // ---- REMOTE branch --------------------------------------------
        // record is remote; host_len must be > 0.
        cmp r8, 0;
        je  ha_ck_mismatch;

        // Inlined FNV-1a 64 over (host_ptr, host_len).
        //   src bytes:   [rsi + i] for i in 0..r8
        //   accumulator: rax = 0xCBF29CE484222325 (basis)
        //   prime:       rcx = 0x100000001B3 (held across loop)
        //   mul rcx:     rdx:rax = rax * prime; rdx clobbered.
        mov rax, 0xCBF29CE484222325;           // offset basis
        mov rcx, 0x100000001B3;                // prime
        xor r10, r10;                          // i = 0

      ha_ck_fnv_loop:
        cmp r10, r8;
        jae ha_ck_fnv_done;
        // src_addr = rsi + r10 into r11 (two-term, no need for
        // three-term precompute but we still staged into r11 for
        // encoder-shape uniformity).
        mov r11, rsi;
        add r11, r10;
        xor r9, r9;
        mov_b r9, [r11 + 0];                   // byte (zero-ext)
        xor rax, r9;                           // h ^= byte
        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * prime
        add r10, 1;
        jmp ha_ck_fnv_loop;

      ha_ck_fnv_done:
        // Compare FNV result to record.hostname_hash u64 at [rbx + 8].
        mov r11, [rbx + 8];
        cmp rax, r11;
        jne ha_ck_mismatch;

        // Match.
        xor rax, rax;                          // HA_OK = 0
        jmp ha_ck_epilogue;

        // ---- LOCAL branch ---------------------------------------------
      ha_ck_is_local:
        cmp r8, 0;                             // host_len == 0?
        jne ha_ck_mismatch;
        xor rax, rax;                          // HA_OK = 0
        jmp ha_ck_epilogue;

        // ---- Error return paths ---------------------------------------
      ha_ck_bad_rec:
        mov rax, 0x5303;                       // HA_ERR_BAD_RECORD
        jmp ha_ck_epilogue;

      ha_ck_mismatch:
        mov rax, 0x5304;                       // HA_ERR_HOST_MISMATCH
        jmp ha_ck_epilogue;

      ha_ck_bad_host_ptr:
        mov rax, 0x5305;                       // HA_ERR_BAD_HOST_PTR
        jmp ha_ck_epilogue;

        // ---- Epilogue -------------------------------------------------
      ha_ck_epilogue:
        pop rbx;
        ret;
      }
    }

}
