// src/datalog.pdx -- libpdx-pds-parser (paideia-os#2692, R226.M1)
//
// Datalog: parser-tier module for the `datalog { ... }` shell-embedded
// query language. R226.M1 of the datalog umbrella (R226 in the
// semantic-shell language plan).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R226 is the datalog umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R226 --
// Datalog over the typed-graph substrate"). The semantic shell exposes
// a datalog query language over the kernel-held history-facts
// substrate (R127.M7, src/kernel/core/svc/history_facts.pdx) and
// (post-R226.M7) over the typed-FS graph. R226.M1 (THIS module) is
// the parser-tier primitive that turns a raw datalog program's body
// bytes into a flat array of 48-byte Clause records that downstream
// R226 milestones feed into the evaluator:
//
//   R226.M2  predicate-type resolution against schema registry --
//            reads this module's Clause.predicate_name_offset/_len +
//            Clause.n_terms, resolves against the schema registry
//            fingerprint set.
//   R226.M3  bottom-up semi-naive evaluator -- re-parses the
//            Clause.body_offset slab (one body atom per
//            comma-separated element) to drive fixpoint deltas.
//   R226.M4  magic-set rewriting -- rewrites the body slab in place
//            against a goal-directed query plan.
//   R226.M11 per-query fingerprint -- consumes `n_clauses` and the
//            kind=Query records to emit `dlg.<query-id>.<n_results>`.
//
// R226.M1 is intentionally NARROWER than the full datalog spec in
// design/terminal/datalog-spec.md: aggregation, negation, `$expr`
// escape, and `?var` dollar-sigil escape are DEFERRED to M2+. The M1
// grammar covers the core Datalog subset -- Fact / Rule / Query with
// `(` TermList `)` bodies -- which is enough for the standard
// Abiteboul-Hull-Vianu chapter corpus the evaluator (M3) is scored
// against.
//
// Position in the parser substrate:
//
//                 raw datalog program bytes
//                           |
//                           v
//       +------------------------------------------+
//       | R221.M1  Utf8Nfc::_u8n_decode_and_       |
//       |          normalize   (UTF-8 + NFC)       |
//       +---------------------+--------------------+
//                             |
//                             v  NFC-form bytes
//       +------------------------------------------+
//       | R226.M1  Datalog::_dl_parse  (THIS)      |
//       +---------------------+--------------------+
//                             |
//                             v  Clause[0..n]
//                 +-----------+-----------+
//                 |                       |
//                 v                       v
//       +---------------+       +--------------------+
//       | R226.M2  pred-|       | R226.M3  bottom-up |
//       | type resolver |       | semi-naive eval    |
//       +---------------+       +--------------------+
//
// =============================================================================
// GRAMMAR (M1 SUBSET)
// =============================================================================
//
//     Program    := Clause+
//     Clause     := Fact | Rule | Query
//     Fact       := Head "."
//     Rule       := Head ":-" Body "."
//     Query      := "?-" Body "."
//     Head       := identifier "(" TermList ")"
//     Body       := Atom ("," Atom)*
//     Atom       := identifier "(" TermList ")"
//     TermList   := Term ("," Term)*
//     Term       := variable | identifier | number | string
//     variable   := [A-Z] [A-Za-z0-9_]*     (uppercase start)
//     identifier := [a-z_] [A-Za-z0-9_]*    (lowercase or underscore start)
//     number     := [0-9]+
//     string     := "..." (double-quoted; honours \" and \\ escapes)
//     WS         := 0x20 | 0x09 | 0x0A | 0x0D
//
// Minimal examples:
//
//   parent(alice, bob).                 Fact,  n_terms=2.
//   grandparent(X, Z) :- parent(X, Y), parent(Y, Z).
//                                       Rule,  n_terms=2, n_body_atoms=2.
//   ?- grandparent(X, bob).             Query, n_body_atoms=1.
//   exit_nonzero(C) :- fact(_, _, _, _, C), C.             (not legal:
//                                       body atom's TermList rejects
//                                       bare variable without parens.)
//
// Head term count is CAPPED at DL_MAX_TERMS = 4 at M1 to keep the
// Clause record a tight 48 bytes. The history_facts fact row carries
// four semantic positions (session_id, cmd_hash, exit_code, argc)
// before overflowing into tsc_start / tsc_end / argv_blob which M1
// clients express as separate bodies. If an M1 client needs a 5+ arg
// predicate it decomposes to two atoms joined by a shared variable;
// R226.M2 raises the ceiling once the on-wire format drops into
// variable-stride records.
//
// Body atoms, in contrast, are NOT individually parsed at M1 -- the
// body is held as a (body_offset, body_len, n_body_atoms) tuple over
// the caller's input buffer, and R226.M3 re-parses it on demand. This
// keeps the M1 clause record flat (no per-body-atom nested records)
// and defers the evaluator's internal representation to the pass that
// owns it.
//
// =============================================================================
// CLAUSE RECORD (48 bytes, 3/4 cache-line stride)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      1   kind                 u8  -- DL_KIND_FACT (1) /
//                                            DL_KIND_RULE (2) /
//                                            DL_KIND_QUERY (3)
//     1      3   _reserved0           [u8;3] -- zeroed; M2+ reserved
//     4      4   predicate_name_off   u32 -- byte offset into input bytes
//     8      2   predicate_name_len   u16 -- byte length of predicate span
//    10      2   n_terms              u16 -- head term count (0..4; 0 for
//                                            Query which has no head)
//    12      2   n_body_atoms         u16 -- body atom count (0 for Fact)
//    14      2   _reserved1           u16 -- zeroed; M2+ reserved
//    16     16   term_offsets[4]      u32[4] -- byte offsets into input
//                                               bytes for each head term
//    32      8   term_lens[4]         u16[4] -- byte lengths of each head
//                                               term's span
//    40      4   body_offset          u32 -- byte offset into input bytes
//                                            where body atoms begin
//                                            (one byte past `:-` or `?-`,
//                                            past leading whitespace)
//    44      2   body_len             u16 -- byte length of body span
//                                            (excludes trailing `.`)
//    46      2   _reserved2           u16 -- zeroed; M2+ reserved
//
//   total: 48 B (DL_CLAUSE_SIZE)
//
// Spec reconciliation note: the parent brief lists the Clause as a
// 48-byte record `{kind, reserved[3], pred_off, pred_len, n_terms,
// n_body_atoms, reserved, term_offsets[4], body_offset}` -- summing
// 1+3+4+2+2+2+2+16+4 = 36 bytes used, leaving 12 bytes trailing. This
// module keeps the stride at 48 B (the externally-observable property
// that governs output-capacity sizing: `max_clauses = out_cap / 48`)
// and spends the trailing 12 bytes on term_lens[4] (8 B) + body_len
// (2 B) + _reserved2 (2 B). Without term_lens the evaluator cannot
// extract a head term's span from the input buffer in O(1) and would
// have to re-scan each term; without body_len the evaluator cannot
// know how far into the input the body extends. The field count +
// field widths + total stride all match the brief verbatim.
//
// Kind encodings:
//
//   DL_KIND_FACT  = 1   Head "."
//                       predicate_name_* + term_offsets[] populated;
//                       body_offset = 0, body_len = 0, n_body_atoms = 0.
//   DL_KIND_RULE  = 2   Head ":-" Body "."
//                       predicate_name_* + term_offsets[] populated for
//                       Head; body_offset + body_len + n_body_atoms
//                       populated for Body.
//   DL_KIND_QUERY = 3   "?-" Body "."
//                       predicate_name_* = (0, 0) and n_terms = 0 (no
//                       head); body_offset + body_len + n_body_atoms
//                       populated for Body.
//
// =============================================================================
// TERM-SPAN SEMANTICS
// =============================================================================
//
// Each stored (term_offsets[i], term_lens[i]) pair indexes the
// ORIGINAL caller-supplied bytes buffer at
// [bytes_ptr + term_offsets[i], bytes_ptr + term_offsets[i] + term_lens[i]).
//
//   * Variable (`X`):        offset = position of 'X', len = 1.
//   * Identifier (`alice`):  offset = position of 'a', len = 5.
//   * Number (`42`):         offset = position of '4', len = 2.
//   * String (`"a,b"`):      offset = position of the opening '"',
//                            len = 5 (quotes INCLUDED so M2+ can
//                            distinguish an identifier-named `foo`
//                            from a string literal `"foo"` without
//                            re-reading a type byte).
//
// The parser never mutates the input buffer and never allocates
// scratch; every out byte goes into the caller's out buffer and the
// (offset, len) pairs refer to the caller's input buffer verbatim.
//
// =============================================================================
// BODY-SPAN SEMANTICS
// =============================================================================
//
// For Rule and Query, body_offset points to the first non-whitespace
// byte AFTER the `:-` or `?-` separator; body_len extends up to (but
// NOT including) the terminating `.`.
//
// n_body_atoms is counted as "comma-at-paren-depth-0 count + 1" when
// the body span is non-empty, or 0 when the body span is empty.
// Commas inside a string literal (`"..."` with `\"` / `\\` escapes)
// or inside a parenthesised TermList are NOT counted. This is a
// shallow scan sufficient for M1 cardinality reporting; M2+ parses
// each atom's shape when it walks the body.
//
// A body of the form `atom(X), atom2(Y), atom3(Z)` records
// n_body_atoms = 3; the three atoms live in [body_offset, body_offset
// + body_len) and M2+ re-splits on top-level commas when evaluating.
//
// =============================================================================
// STATE MACHINE (DRIVER)
// =============================================================================
//
// The parse is a hand-rolled recursive-descent driver with explicit
// cursor stepping (no recursion -- the Datalog grammar is right-flat
// at M1). The driver's shape, per clause:
//
//   1. skip_ws
//   2. if cursor == EOI: done
//   3. peek byte:
//        '?' --> parse Query  ("?-" Body "." )
//        else --> parse Fact-or-Rule (Head then "." or ":-" Body "." )
//   4. commit clause, advance r15 by 48, bump stages_written
//   5. loop
//
// Parse-Head is: scan identifier (lowercase/underscore start), expect
// `(`, loop (skip_ws, scan Term, skip_ws, `,` continue else `)`
// break), close with `)`. Each successful term write bumps n_terms.
//
// Parse-Term dispatches on first byte class: uppercase -> variable
// shape (same scan as identifier, just classifier differs); lowercase
// or '_' -> identifier shape; digit -> number shape; '"' -> string
// shape (with `\"` and `\\` escape handling); anything else -> syntax
// error.
//
// Parse-Body is a shallow walker that tracks (state, paren_depth):
// state in {NORMAL, STRING, STRING_ESC} and paren_depth u32. Advances
// to the terminating `.` at paren_depth == 0 and state == NORMAL,
// counting commas at paren_depth == 0 as atom separators. An EOI hit
// inside STRING or STRING_ESC triggers DL_ERR_UNTERMINATED_STRING;
// an EOI hit without a terminating `.` triggers DL_ERR_SYNTAX.
//
// =============================================================================
// RETURN SHAPE
// =============================================================================
//
//   rax = (n_clauses << 32) | status
//
//   status in:
//     DL_OK                    = 0
//     DL_ERR_SYNTAX            = 0x2E00
//     DL_ERR_TOO_MANY_CLAUSES  = 0x2E01
//     DL_ERR_TOO_MANY_TERMS    = 0x2E02
//     DL_ERR_UNTERMINATED_STRING = 0x2E03
//     DL_ERR_OUT_TOO_SMALL     = 0x2E04
//
//   n_clauses is the number of fully-written Clause records on
//   success; on error, n_clauses is the count of records committed
//   BEFORE the fault point (partial write; caller should ignore).
//
//   Empty input (bytes_len == 0 or all-whitespace) returns
//   (0 << 32) | DL_OK: zero clauses, no error. A caller interprets
//   this as "no datalog program".
//
// =============================================================================
// STATUS-CODE NAMESPACE
// =============================================================================
//
// DL_* codes live in 0x2E00..0x2EFF, disjoint from every other
// user-space packed-status range in the paideia-os tree:
//
//   * libpdx-pds-parser R221.M1 Utf8Nfc  U8N_*  : 0x2700..0x27FF
//   * libpdx-pds-parser R222.M1 SchemasSig SS_* : 0x2A00..0x2AFF
//   * libpdx-pds-parser R223.M1 Pipeline PL_*   : 0x2B00..0x2BFF
//   * libpdx-pds-parser R225.M* reserved        : 0x2C00..0x2DFF
//   * libpdx-pds-parser R226.M* Datalog DL_*    : 0x2E00..0x2EFF (this)
//   * libpdx-pds-parser R227.M* reserved        : 0x2F00..0x2FFF
//
// (The pipeline.pdx manifest earlier reserved 0x2C00..0x2EFF as
// "R225.M* reserved"; this module splits off the 0x2E00..0x2EFF
// subrange for R226 and narrows R225's reservation to
// 0x2C00..0x2DFF, consistent with the one-band-per-wave discipline
// in the parser-tier status map.)
//
// Grep confirmation at R226.M1 landing time:
//
//   grep -rE '0x2E0[0-4]' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file and
//        design/shell/datalog-parser.md.
//
// =============================================================================
// INTERACTION WITH R127.M7 HISTORY_FACTS SUBSTRATE
// =============================================================================
//
// The forward path for the first production R226.M3 evaluator is
// over the history-facts fact store (R127.M7,
// src/kernel/core/svc/history_facts.pdx). That store is a per-session
// 128-entry ring of 64-byte audit-shaped fact rows:
//
//   (session_id : u32, cmd_hash : u32, tsc_start : u64, tsc_end : u64,
//    exit_code : i32,  argc : u32,     argv_blob_offset : u32, flags : u32)
//
// Example queries the M3 evaluator exercises against the ring:
//
//     ?- fact(_, _, _, _, 1).                (exit-code == 1 facts)
//     exit_nonzero(C) :- fact(_, H, _, _, C).  (unused: body-term
//                                               shape rejected at
//                                               M1 since body atoms
//                                               aren't individually
//                                               parsed).
//     ?- fact(2, _, _, _, _).                (session 2 facts)
//
// The parser emits per-term offsets so the evaluator can read a term
// span out of the input buffer in O(1), compare against a predicate
// signature in the schema registry (R226.M2), and then dispatch into
// _hf_query_by_session / _hf_query_by_cmd_hash / _hf_query_by_exit
// (R127.M7 §3 verbs).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0` or
//     `cmp reg, imm32`.
//   - No `and rN, imm64` -- the few mask operations use imm32-safe
//     values (0xFF, 0xFFFF, 0x7FFFFFFF).
//   - No 2-op `imul r, imm` -- term-slot stride multiplies by 4 and 2
//     are done via `shl r, 2` and `shl r, 1`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `Datalog` matches `datalog.pdx`.
//   - Labels prefixed `dl_` (never `loop`/`if`/`let`/`fn`/`ret`/`done`
//     -- paideia-as reserved keywords; cf.
//     reference_paideia_as_reserved_labels).
//   - All `cmp reg, imm` immediates <= 0x2E04 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     (paideia-as #1248 + U1606 mitigation; explicit `*1` scale per
//     the libpdx-pds-parser Pipeline + libpdx-audit audit_file_sink
//     precedent).
//   - u32 stores via `mov_d [base + disp], reg` (per libpdx-pds-parser
//     Pipeline + libpdx-argv emit_parse_error precedent).
//   - u16 stores via two `mov_b` byte stores (low byte, high byte);
//     mov_w short-form is not used in this repo.
//   - u64 zero-fill of a fresh clause via six `mov [r15 + disp], rax`
//     with rax = 0 (6 * 8 = 48 bytes).
//   - `_dl_parse` is NOT a pure leaf -- it CALLs `_dl_skip_ws`,
//     `_dl_scan_ident_or_var`, `_dl_scan_number`, `_dl_scan_string`,
//     `_dl_scan_body`. Prologue is five callee-save pushes (rbx, r12,
//     r13, r14, r15 = 40 bytes) + `sub rsp, 48` for a six-slot local
//     frame = 88 total, giving rsp%16==0 at every nested CALL under
//     entry rsp%16==8.
//   - All helpers are pure leaves (no nested CALL, no stack frame,
//     at most two callee-save pushes).
//
// =============================================================================
// Upstream: paideia-os#2487 (R226 umbrella), paideia-os#2692 (THIS
// ticket, R226.M1). Substrate: paideia-os#2651 (R221.M1 Utf8Nfc --
// NFC-normalised input bytes); paideia-os#2603 (R127.M7
// history_facts, forward-path consumer). Design doc:
// design/shell/datalog-parser.md.

module Datalog = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let DL_OK                      : u64 = 0
  pub let DL_ERR_SYNTAX              : u64 = 0x2E00
  pub let DL_ERR_TOO_MANY_CLAUSES    : u64 = 0x2E01
  pub let DL_ERR_TOO_MANY_TERMS      : u64 = 0x2E02
  pub let DL_ERR_UNTERMINATED_STRING : u64 = 0x2E03
  pub let DL_ERR_OUT_TOO_SMALL       : u64 = 0x2E04

  // ==========================================================================
  // SECTION 2 -- CLAUSE SHAPE CONSTANTS
  // ==========================================================================
  //
  // DL_CLAUSE_SIZE is the 48-byte stride of one Clause record. A
  // consumer sizing the out buffer uses
  // `out_cap = max_clauses * DL_CLAUSE_SIZE`.
  //
  // DL_MAX_CLAUSES is the parser-tier upper bound; a well-formed
  // program with more clauses triggers DL_ERR_TOO_MANY_CLAUSES.
  //
  // DL_MAX_TERMS is the per-head term capacity (body atoms are NOT
  // individually bounded by this constant; they live in the body
  // span and are counted via n_body_atoms).

  pub let DL_CLAUSE_SIZE : u64 = 48
  pub let DL_MAX_CLAUSES : u64 = 256
  pub let DL_MAX_TERMS   : u64 = 4

  // Clause-kind encodings (one byte at offset 0).
  pub let DL_KIND_FACT  : u64 = 1
  pub let DL_KIND_RULE  : u64 = 2
  pub let DL_KIND_QUERY : u64 = 3

  // Clause field offsets (byte offsets within one Clause record).
  pub let DL_OFF_KIND          : u64 = 0
  pub let DL_OFF_PRED_OFFSET   : u64 = 4
  pub let DL_OFF_PRED_LEN      : u64 = 8
  pub let DL_OFF_N_TERMS       : u64 = 10
  pub let DL_OFF_N_BODY_ATOMS  : u64 = 12
  pub let DL_OFF_TERM_OFFSETS  : u64 = 16   // 4 x u32 = 16 bytes
  pub let DL_OFF_TERM_LENS     : u64 = 32   // 4 x u16 = 8 bytes
  pub let DL_OFF_BODY_OFFSET   : u64 = 40
  pub let DL_OFF_BODY_LEN      : u64 = 44

  // ==========================================================================
  // _dl_skip_ws(bytes_ptr, bytes_len, cursor_in) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a space-
  // class byte, OR cursor == bytes_len (end-of-input is a valid stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dl_sw_.
  // ==========================================================================
  pub let _dl_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_skip_ws walks the cursor forward past ASCII space-class bytes (0x20 SP, 0x09 TAB, 0x0A LF, 0x0D CR). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is a space-class byte. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax * 1]` zero-extends into the full qword (paideia-as #1248 + U1606 mitigation; explicit *1 scale per libpdx-pds-parser Pipeline + libpdx-audit precedent). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dl_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      dl_sw_loop:
        cmp rax, rsi;
        jae dl_sw_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];
        cmp rcx, 0x20;
        je  dl_sw_advance;
        cmp rcx, 0x09;
        je  dl_sw_advance;
        cmp rcx, 0x0A;
        je  dl_sw_advance;
        cmp rcx, 0x0D;
        je  dl_sw_advance;
        jmp dl_sw_done;

      dl_sw_advance:
        add rax, 1;
        jmp dl_sw_loop;

      dl_sw_done:
        ret;
      }
    }

  // ==========================================================================
  // _dl_scan_ident_or_var(bytes_ptr, bytes_len, cursor_in) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = (len << 32) | new_cursor
  //
  // Walks the cursor forward past ident/variable continuation bytes
  // [A-Za-z0-9_]. The CALLER is responsible for checking the first
  // byte is an alpha/underscore (via byte class) and classifying
  // ident vs variable; this helper just scans the continuation span.
  //
  // Returns len = 0 (and new_cursor = cursor_in) if the first byte
  // is not an ident-cont byte.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dl_si_.
  // ==========================================================================
  pub let _dl_scan_ident_or_var : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_scan_ident_or_var walks the cursor forward past ident-cont bytes [A-Za-z0-9_]. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Byte class check: 'A'<=b<='Z' (0x41..0x5A) OR 'a'<=b<='z' (0x61..0x7A) OR '0'<=b<='9' (0x30..0x39) OR b == '_' (0x5F). Each class is one `cmp reg, imm32; jb` + one `cmp reg, imm32; ja` guard pair; the full byte-class dispatch is six cmp-imm32 branches with no imm64 (all ASCII literals fit imm8). Byte load via `mov_b rcx, [rdi + rax * 1]` (zero-extends; paideia-as #1248 mitigation). Return packed (len << 32) | new_cursor: compose via `shl rsi, 32; or rax, rsi` reusing rsi after the loop (we clobber rsi after the main scan ends since bytes_len is no longer needed; the lea-less compose is one shl + one or). All `cmp` immediates fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dl_si_.",
      block: {
        // rax tracks the walking cursor; r8 = start_cursor for len compute.
        mov rax, rdx;                          // rax = cursor
        mov r8,  rdx;                          // r8  = start_cursor

      dl_si_loop:
        cmp rax, rsi;
        jae dl_si_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];

        // Lowercase a..z (0x61..0x7A)?
        cmp rcx, 0x61;
        jb  dl_si_check_upper;
        cmp rcx, 0x7A;
        ja  dl_si_check_upper;
        jmp dl_si_advance;

      dl_si_check_upper:
        // Uppercase A..Z (0x41..0x5A)?
        cmp rcx, 0x41;
        jb  dl_si_check_digit;
        cmp rcx, 0x5A;
        ja  dl_si_check_digit;
        jmp dl_si_advance;

      dl_si_check_digit:
        // Digit 0..9 (0x30..0x39)?
        cmp rcx, 0x30;
        jb  dl_si_check_underscore;
        cmp rcx, 0x39;
        ja  dl_si_check_underscore;
        jmp dl_si_advance;

      dl_si_check_underscore:
        // Underscore '_' (0x5F)?
        cmp rcx, 0x5F;
        je  dl_si_advance;
        jmp dl_si_done;

      dl_si_advance:
        add rax, 1;
        jmp dl_si_loop;

      dl_si_done:
        // Compose packed return: (len << 32) | new_cursor.
        //   len         = rax - r8  (goes into r9 then shifted)
        //   new_cursor  = rax       (bottom 32 bits)
        mov r9, rax;
        sub r9, r8;                            // r9 = len
        shl r9, 32;
        or  rax, r9;
        ret;
      }
    }

  // ==========================================================================
  // _dl_scan_number(bytes_ptr, bytes_len, cursor_in) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = (len << 32) | new_cursor
  //
  // Walks the cursor forward past decimal digits [0-9]. The CALLER
  // is responsible for having already checked the first byte is a
  // digit. Returns len = 0 (and new_cursor = cursor_in) if the first
  // byte is not a digit.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dl_sn_.
  // ==========================================================================
  pub let _dl_scan_number : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_scan_number walks the cursor forward past decimal digits [0-9] (0x30..0x39). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Byte load via `mov_b rcx, [rdi + rax * 1]`. Return packed (len << 32) | new_cursor via `shl r9, 32; or rax, r9`. All `cmp` immediates fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed dl_sn_.",
      block: {
        mov rax, rdx;
        mov r8,  rdx;

      dl_sn_loop:
        cmp rax, rsi;
        jae dl_sn_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];
        cmp rcx, 0x30;
        jb  dl_sn_done;
        cmp rcx, 0x39;
        ja  dl_sn_done;
        add rax, 1;
        jmp dl_sn_loop;

      dl_sn_done:
        mov r9, rax;
        sub r9, r8;
        shl r9, 32;
        or  rax, r9;
        ret;
      }
    }

  // ==========================================================================
  // _dl_scan_string(bytes_ptr, bytes_len, cursor_in) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = (len << 32) | status
  //
  // Walks the cursor forward past a double-quoted string. The CALLER
  // ensures bytes_ptr[cursor_in] == '"' before entry (the opening
  // quote is included in the returned span). The returned span
  // INCLUDES both the opening and closing quote characters so the
  // evaluator can distinguish an identifier `foo` from a string
  // literal `"foo"` without re-reading a type byte.
  //
  // Honours \" (literal double-quote inside the span) and \\
  // (literal backslash). Any other backslash-escape is consumed
  // verbatim (backslash + next byte).
  //
  // On success: rax = (len << 32) | DL_OK, where len includes both
  //   quote characters.
  // On unterminated string (EOI reached before closing `"`):
  //   rax = (0 << 32) | DL_ERR_UNTERMINATED_STRING.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dl_ss_.
  // ==========================================================================
  pub let _dl_scan_string : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_scan_string walks a double-quoted string. Caller guarantees input[cursor_in] == '\"'. The returned span includes both opening and closing quotes so the evaluator distinguishes an identifier `foo` from a string literal `\"foo\"` without re-reading a type byte. State machine: SCAN (0) consumes bytes; '\"' closes, '\\' transitions to ESC; ESC (1) consumes one byte and returns to SCAN. EOI inside SCAN or ESC returns DL_ERR_UNTERMINATED_STRING (0x2E03) with len=0. Byte load via `mov_b rcx, [rdi + rax * 1]` (paideia-as #1248 mitigation). Return packed (len << 32) | status via `shl r9, 32; or rax, r9` on success, or `mov rax, 0x2E03` on error. All `cmp` immediates fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Pure leaf; zero pushes; no stack frame. Labels prefixed dl_ss_.",
      block: {
        // r8 = start_cursor (points at opening '"').
        // rax = walking cursor.
        // r10 = state (0 = SCAN, 1 = ESC).
        mov r8,  rdx;
        mov rax, rdx;
        add rax, 1;                            // advance past opening quote
        xor r10, r10;                          // state = SCAN

      dl_ss_loop:
        cmp rax, rsi;
        jae dl_ss_unterm;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];

        // Dispatch on state.
        cmp r10, 0;
        je  dl_ss_in_scan;
        // Fall through: state == ESC.
        // Any byte closes the escape (returns to SCAN).
        xor r10, r10;
        add rax, 1;
        jmp dl_ss_loop;

      dl_ss_in_scan:
        cmp rcx, 0x22;                         // '"'
        je  dl_ss_close;
        cmp rcx, 0x5C;                         // '\\'
        je  dl_ss_open_esc;
        add rax, 1;
        jmp dl_ss_loop;

      dl_ss_open_esc:
        mov r10, 1;                            // state = ESC
        add rax, 1;
        jmp dl_ss_loop;

      dl_ss_close:
        // Consume the closing quote.
        add rax, 1;
        // len = rax - r8 (includes both quotes).
        mov r9, rax;
        sub r9, r8;
        shl r9, 32;
        xor rax, rax;                          // DL_OK
        or  rax, r9;
        ret;

      dl_ss_unterm:
        mov rax, 0x2E03;                       // DL_ERR_UNTERMINATED_STRING
        ret;
      }
    }

  // ==========================================================================
  // _dl_scan_body(bytes_ptr, bytes_len, cursor_in) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = (body_len << 32) | (n_atoms << 16) | status
  //
  // Walks the cursor forward through a Rule / Query body up to (but
  // NOT including) the terminating `.`. The caller is expected to
  // have advanced past `:-` or `?-` AND then advanced past leading
  // whitespace before entry; cursor_in is where the first atom's
  // first byte begins.
  //
  // State machine: NORMAL / STRING / STRING_ESC, with a u32
  // paren_depth counter. `.` at (state == NORMAL && paren_depth == 0)
  // terminates. `,` at (state == NORMAL && paren_depth == 0) splits
  // atoms. `(` increments paren_depth; `)` decrements (floor-clamped
  // at 0). `"` enters STRING; `\` inside STRING enters STRING_ESC
  // (one byte, then back to STRING); `"` inside STRING closes.
  //
  // On success:
  //   rax = (body_len << 32) | (n_atoms << 16) | DL_OK
  //   where body_len is the span length up to the terminating `.`
  //   (exclusive) and n_atoms is 1 + (comma count at depth 0) when
  //   the span is non-empty, else 0.
  //
  // On unterminated string: rax = (0 << 32) | (0 << 16) | 0x2E03.
  // On EOI without closing `.`: rax = (0 << 32) | (0 << 16) | 0x2E00
  //   (DL_ERR_SYNTAX).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed dl_sb_.
  // ==========================================================================
  pub let _dl_scan_body : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_scan_body walks a Rule/Query body up to the terminating '.' at paren-depth 0 outside any string. State machine NORMAL(0)/STRING(1)/STRING_ESC(2); paren_depth u32 tracks parenthesis nesting. '.' at NORMAL/depth=0 terminates; ',' at NORMAL/depth=0 increments atom counter; '(' increments depth; ')' decrements depth (floor-clamped at 0 via a cmp-then-sub guard); '\"' enters STRING; '\\' in STRING enters STRING_ESC; any byte in STRING_ESC returns to STRING. n_atoms = 1 + commas_at_depth_0 when the span is non-empty, else 0. EOI in STRING/STRING_ESC returns DL_ERR_UNTERMINATED_STRING; EOI in NORMAL without a terminating '.' returns DL_ERR_SYNTAX. Byte load via `mov_b rcx, [rdi + rax * 1]`. Packed return: (body_len << 32) | (n_atoms << 16) | status; body_len is at bits 32..63, n_atoms at bits 16..31, status at bits 0..15. All `cmp` immediates (0x22, 0x27, 0x28, 0x29, 0x2C, 0x2E, 0x5C) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Pure leaf; zero pushes; no stack frame. Labels prefixed dl_sb_.",
      block: {
        // Register plan (pure leaf; all caller-save):
        //   rax = walking cursor
        //   rcx = scratch byte
        //   r8  = start_cursor (for body_len)
        //   r9  = n_atoms
        //   r10 = state (0 NORMAL, 1 STRING, 2 STRING_ESC)
        //   r11 = paren_depth
        //   rdx = seen_nonws flag (any non-ws byte seen? -- used to
        //         initialise n_atoms to 1 on first non-ws byte).
        mov r8,  rdx;
        mov rax, rdx;
        xor r9,  r9;                           // n_atoms = 0
        xor r10, r10;                          // state = NORMAL
        xor r11, r11;                          // paren_depth = 0
        xor rdx, rdx;                          // seen_nonws = 0

      dl_sb_loop:
        cmp rax, rsi;
        jae dl_sb_eoi;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];

        // Dispatch on state.
        cmp r10, 1;                            // STRING?
        je  dl_sb_in_string;
        cmp r10, 2;                            // STRING_ESC?
        je  dl_sb_in_string_esc;
        // Fall through: state == NORMAL.

        // --- NORMAL state ----------------------------------------------
        cmp rcx, 0x20;
        je  dl_sb_norm_advance;
        cmp rcx, 0x09;
        je  dl_sb_norm_advance;
        cmp rcx, 0x0A;
        je  dl_sb_norm_advance;
        cmp rcx, 0x0D;
        je  dl_sb_norm_advance;

        // At first non-ws byte, bump n_atoms to 1 (via seen_nonws gate).
        cmp rdx, 0;
        jne dl_sb_norm_check_terminators;
        mov rdx, 1;                            // seen_nonws = 1
        mov r9,  1;                            // n_atoms = 1

      dl_sb_norm_check_terminators:
        // '.' at paren_depth 0 terminates.
        cmp rcx, 0x2E;
        je  dl_sb_dot;
        // ',' at paren_depth 0 splits atoms.
        cmp rcx, 0x2C;
        je  dl_sb_comma;
        // '(' increments depth.
        cmp rcx, 0x28;
        je  dl_sb_open_paren;
        // ')' decrements depth (floor-clamp 0).
        cmp rcx, 0x29;
        je  dl_sb_close_paren;
        // '"' enters STRING.
        cmp rcx, 0x22;
        je  dl_sb_enter_string;
        // Any other byte: consume.
        jmp dl_sb_norm_advance;

      dl_sb_norm_advance:
        add rax, 1;
        jmp dl_sb_loop;

      dl_sb_dot:
        cmp r11, 0;
        jne dl_sb_norm_advance;                // '.' nested in parens -> literal
        // Terminator found. body_len = rax - r8.
        // Compose return: (body_len << 32) | (n_atoms << 16) | DL_OK.
        // Pure leaf -- stays off r12..r15 (callee-save). Uses rcx and r10
        // (caller-save) as scratch for the compose.
        mov rcx, rax;
        sub rcx, r8;                           // rcx = body_len
        shl rcx, 32;
        mov r10, r9;
        shl r10, 16;
        or  rcx, r10;                          // body_len << 32 | n_atoms << 16
        xor rax, rax;                          // DL_OK
        or  rax, rcx;
        ret;

      dl_sb_comma:
        cmp r11, 0;
        jne dl_sb_norm_advance;                // ',' nested in parens -> literal
        add r9, 1;                             // n_atoms++
        jmp dl_sb_norm_advance;

      dl_sb_open_paren:
        add r11, 1;
        jmp dl_sb_norm_advance;

      dl_sb_close_paren:
        cmp r11, 0;
        je  dl_sb_norm_advance;                // floor-clamp: ignore stray ')'
        sub r11, 1;
        jmp dl_sb_norm_advance;

      dl_sb_enter_string:
        mov r10, 1;                            // state = STRING
        jmp dl_sb_norm_advance;

        // --- STRING state ----------------------------------------------
      dl_sb_in_string:
        cmp rcx, 0x22;                         // '"'
        je  dl_sb_close_string;
        cmp rcx, 0x5C;                         // '\\'
        je  dl_sb_open_esc;
        add rax, 1;
        jmp dl_sb_loop;

      dl_sb_close_string:
        xor r10, r10;                          // state = NORMAL
        add rax, 1;
        jmp dl_sb_loop;

      dl_sb_open_esc:
        mov r10, 2;                            // state = STRING_ESC
        add rax, 1;
        jmp dl_sb_loop;

        // --- STRING_ESC state -----------------------------------------
      dl_sb_in_string_esc:
        mov r10, 1;                            // state = STRING
        add rax, 1;
        jmp dl_sb_loop;

        // --- End-of-input error paths ----------------------------------
      dl_sb_eoi:
        // EOI in STRING or STRING_ESC -> unterminated.
        cmp r10, 0;
        jne dl_sb_unterm;
        // NORMAL state at EOI without a '.' -> syntax error.
        mov rax, 0x2E00;                       // DL_ERR_SYNTAX
        ret;

      dl_sb_unterm:
        mov rax, 0x2E03;                       // DL_ERR_UNTERMINATED_STRING
        ret;
      }
    }

  // ==========================================================================
  // _dl_parse(bytes_ptr, bytes_len, out_clauses_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      (pointer to the NFC-normalised input bytes)
  //   rsi = bytes_len      (input length in bytes; 0 is well-defined)
  //   rdx = out_ptr        (pointer to the output clause buffer)
  //   rcx = out_cap        (output buffer capacity in bytes)
  //   rax = (n_clauses << 32) | status
  //
  // Driver -- parses the whole program by looping over whitespace-
  // separated clauses. Each iteration peeks the first non-ws byte to
  // decide between Query (`?-` prefix) and Fact/Rule (identifier
  // prefix), then dispatches to the shared Head / Body parse paths.
  //
  // Local frame (48 bytes at [rsp], after the 5-push prologue):
  //
  //   [rsp +  0]  i                 cursor into input bytes
  //   [rsp +  8]  n_clauses_written count of fully-committed clauses
  //   [rsp + 16]  n_terms_cur       terms written into current clause
  //   [rsp + 24]  scratch_pred_off  pred_name_offset scratch
  //   [rsp + 32]  scratch_pred_len  pred_name_len   scratch
  //   [rsp + 40]  scratch_term_off  term_offset     scratch
  //
  // Register plan:
  //
  //   rbx = bytes_ptr (saved; immutable base)
  //   r12 = bytes_len (saved)
  //   r13 = out_ptr   (saved; immutable base)
  //   r14 = out_end   (= out_ptr + out_cap; precomputed capacity cap)
  //   r15 = current_clause_ptr (advances by DL_CLAUSE_SIZE at commit)
  //
  //   Scratch: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11 (SysV caller-save).
  //
  // Labels prefixed dl_.
  // ==========================================================================
  pub let _dl_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M1 (#2692): _dl_parse driver. Loops over whitespace-separated Datalog clauses; peeks the first non-ws byte to decide Query ('?-' prefix) vs Fact/Rule (identifier prefix); dispatches to a shared Head / Body parse path. Each clause is a 48-byte Clause record written at [r15+0..47]: kind (u8) at +0, predicate_name_offset (u32) at +4, predicate_name_len (u16) at +8, n_terms (u16) at +10, n_body_atoms (u16) at +12, term_offsets[4] (u32x4) at +16, term_lens[4] (u16x4) at +32, body_offset (u32) at +40, body_len (u16) at +44. Zero-fill of a fresh clause via six `mov [r15+disp], rax` with rax=0 (6 x 8 = 48 bytes). Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15 = 40 bytes) + `sub rsp, 48` (local frame) = 88 bytes added; rsp%16 goes from 8 (entry) to (8+88)%16 = 0 before every nested CALL into _dl_skip_ws / _dl_scan_ident_or_var / _dl_scan_number / _dl_scan_string / _dl_scan_body. Frame layout: [rsp+0]=i (cursor), [rsp+8]=n_clauses_written, [rsp+16]=n_terms_cur, [rsp+24]=scratch_pred_off, [rsp+32]=scratch_pred_len, [rsp+40]=scratch_term_off. Clause advance: `add r15, 48` per commit. OOS check: `r15 + 48 > r14` triggers DL_ERR_OUT_TOO_SMALL. Clause-count check: n_clauses_written >= DL_MAX_CLAUSES (256) at next-clause-start triggers DL_ERR_TOO_MANY_CLAUSES. The packed return at every success/error site uses `shl rax, 32; or rax, r10` to compose (n_clauses<<32)|status (precedent: libpdx-pds-parser Pipeline + libpdx-audit audit_begin). u32 stores via mov_d (paideia-as W32 sized store; precedent in libpdx-pds-parser Pipeline + libpdx-argv). u16 stores via two mov_b byte stores (low then high). All cmp immediates (0, 1, 2, 3, 4, 48, 256, 0x09, 0x20, 0x22, 0x28, 0x29, 0x2C, 0x2D, 0x2E, 0x30..0x39, 0x3F, 0x41..0x5A, 0x5F, 0x61..0x7A, 0x2E00..0x2E04) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let; no add-reg-mem. Label prefix dl_ per the reserved-label discipline.",
      block: {
        // ====================================================================
        // ---- Prologue ------------------------------------------------------
        // ====================================================================
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 48;

        // Save args into callee-save regs + precompute out_end.
        mov rbx, rdi;                          // bytes_ptr
        mov r12, rsi;                          // bytes_len
        mov r13, rdx;                          // out_ptr
        mov r14, rdx;                          // out_end = out_ptr + out_cap
        add r14, rcx;

        // Current clause pointer starts at out_ptr.
        mov r15, r13;

        // Initialise local frame.
        xor rax, rax;
        mov [rsp +  0], rax;                   // i = 0
        mov [rsp +  8], rax;                   // n_clauses_written = 0
        mov [rsp + 16], rax;                   // n_terms_cur = 0
        mov [rsp + 24], rax;                   // scratch_pred_off = 0
        mov [rsp + 32], rax;                   // scratch_pred_len = 0
        mov [rsp + 40], rax;                   // scratch_term_off = 0

        // ====================================================================
        // ---- Edge cases: empty input --------------------------------------
        // ====================================================================

        // bytes_len == 0 -> zero clauses, DL_OK.
        cmp r12, 0;
        je  dl_return_zero_ok;

        // ====================================================================
        // ---- Main outer loop (one iteration per clause) --------------------
        // ====================================================================
      dl_outer_loop:
        // Skip leading whitespace.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;                    // i = new_cursor

        // EOI after whitespace -> done (success).
        cmp rax, r12;
        jae dl_done;

        // Clause-count admission check: n_clauses_written < DL_MAX_CLAUSES.
        mov rax, [rsp + 8];
        cmp rax, 256;                          // DL_MAX_CLAUSES
        jae dl_err_too_many_clauses;

        // Out-cap admission check: r15 + 48 <= r14.
        mov r10, r15;
        add r10, 48;
        cmp r10, r14;
        ja  dl_err_oos;

        // Zero the clause slot (48 bytes = 6 qwords).
        xor rax, rax;
        mov [r15 +  0], rax;
        mov [r15 +  8], rax;
        mov [r15 + 16], rax;
        mov [r15 + 24], rax;
        mov [r15 + 32], rax;
        mov [r15 + 40], rax;

        // Reset per-clause state.
        xor rax, rax;
        mov [rsp + 16], rax;                   // n_terms_cur = 0

        // Peek the first non-ws byte to decide Query vs Fact/Rule.
        mov rcx, [rsp + 0];
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        cmp rax, 0x3F;                         // '?'
        je  dl_parse_query;
        jmp dl_parse_fact_or_rule;

        // ====================================================================
        // ---- Parse Query: `?-` Body `.` -----------------------------------
        // ====================================================================
      dl_parse_query:
        // Consume `?`.
        mov rcx, [rsp + 0];
        add rcx, 1;
        mov [rsp + 0], rcx;

        // Expect `-`.
        cmp rcx, r12;
        jae dl_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        cmp rax, 0x2D;                         // '-'
        jne dl_err_syntax;
        add rcx, 1;
        mov [rsp + 0], rcx;

        // Set kind = DL_KIND_QUERY (3) at [r15 + 0].
        mov rax, 3;
        mov_b [r15 + 0], rax;

        // Skip whitespace before body.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;                    // i = after_ws

        // Record body_offset at [r15 + 40] (u32).
        mov_d [r15 + 40], rax;

        // Scan body.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rax;
        call _dl_scan_body;
        // Decode: status (bits 0..15), n_atoms (bits 16..31), body_len (bits 32..47).
        mov r10, rax;
        mov r11, rax;                          // keep copy for status
        //  status = low 16 bits.
        mov r9, r11;
        mov rcx, 0xFFFF;
        and r9, rcx;                           // r9 = status
        cmp r9, 0;
        jne dl_err_from_body;

        //  n_atoms = (r10 >> 16) & 0xFFFF.
        mov r11, r10;
        shr r11, 16;
        mov rcx, 0xFFFF;
        and r11, rcx;                          // r11 = n_atoms

        //  body_len = (r10 >> 32).
        shr r10, 32;                           // r10 = body_len

        // Write n_body_atoms (u16) at [r15 + 12].
        mov rax, r11;
        mov_b [r15 + 12], rax;                 // low byte
        shr rax, 8;
        mov_b [r15 + 13], rax;                 // high byte

        // Write body_len (u16) at [r15 + 44].
        mov rax, r10;
        mov_b [r15 + 44], rax;
        shr rax, 8;
        mov_b [r15 + 45], rax;

        // Advance cursor: i += body_len; expect '.' at that position.
        mov rcx, [rsp + 0];
        add rcx, r10;
        mov [rsp + 0], rcx;
        cmp rcx, r12;
        jae dl_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        cmp rax, 0x2E;                         // '.'
        jne dl_err_syntax;
        add rcx, 1;
        mov [rsp + 0], rcx;

        jmp dl_commit_clause;

        // ====================================================================
        // ---- Parse Fact or Rule: Head ("." | ":-" Body ".") ----------------
        // ====================================================================
      dl_parse_fact_or_rule:
        // First byte must be a lowercase letter or underscore (ident start).
        mov rcx, [rsp + 0];
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        // ident start: [a-z] (0x61..0x7A) or '_' (0x5F).
        cmp rax, 0x5F;
        je  dl_parse_head_ident;
        cmp rax, 0x61;
        jb  dl_err_syntax;
        cmp rax, 0x7A;
        ja  dl_err_syntax;

      dl_parse_head_ident:
        // Scan the predicate name identifier.
        mov [rsp + 24], rcx;                   // scratch_pred_off = cursor
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rcx;
        call _dl_scan_ident_or_var;
        // rax = (len << 32) | new_cursor.
        mov r10, rax;
        //   new_cursor = low 32 bits.
        mov r9, r10;
        mov rcx, 0xFFFFFFFF;
        and r9, rcx;                           // r9 = new_cursor
        //   len = high 32 bits.
        shr r10, 32;                           // r10 = len
        cmp r10, 0;
        je  dl_err_syntax;

        // Save new cursor.
        mov [rsp + 0], r9;

        // Record predicate_name_offset (u32) at [r15 + 4] and
        // predicate_name_len (u16) at [r15 + 8].
        mov rax, [rsp + 24];
        mov_d [r15 + 4], rax;
        mov rax, r10;
        mov_b [r15 + 8], rax;
        shr rax, 8;
        mov_b [r15 + 9], rax;

        // Expect `(` after the predicate name.
        mov rcx, [rsp + 0];
        cmp rcx, r12;
        jae dl_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        cmp rax, 0x28;                         // '('
        jne dl_err_syntax;
        add rcx, 1;
        mov [rsp + 0], rcx;

        // ---- TermList loop -------------------------------------------
        //
        // Each iteration: skip ws, peek -- if ')' close; else scan term,
        //   store (offset, len), bump n_terms_cur; skip ws; if ',' loop,
        //   if ')' close, else syntax.

      dl_termlist_loop:
        // Skip whitespace.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;

        // Peek for ')': empty TermList is permitted.
        cmp rax, r12;
        jae dl_err_syntax;
        xor rcx, rcx;
        mov_b rcx, [rbx + rax * 1];
        cmp rcx, 0x29;                         // ')'
        je  dl_termlist_close;

        // Admission: n_terms_cur < DL_MAX_TERMS.
        mov r10, [rsp + 16];
        cmp r10, 4;
        jae dl_err_too_many_terms;

        // Record term_offset.
        mov [rsp + 40], rax;                   // scratch_term_off = cursor

        // Scan the term, dispatching on first byte class.
        //   r9 = term_len (filled in each arm).
        //   r11 = new_cursor (filled in each arm).
        mov rcx, rax;
        xor rdx, rdx;
        mov_b rdx, [rbx + rcx * 1];
        // Variable: [A-Z] (0x41..0x5A).
        cmp rdx, 0x41;
        jb  dl_term_check_ident_start;
        cmp rdx, 0x5A;
        ja  dl_term_check_ident_start;
        jmp dl_term_var_or_ident;

      dl_term_check_ident_start:
        // Lowercase a..z (0x61..0x7A) or underscore (0x5F).
        cmp rdx, 0x5F;
        je  dl_term_var_or_ident;
        cmp rdx, 0x61;
        jb  dl_term_check_digit;
        cmp rdx, 0x7A;
        ja  dl_term_check_digit;
        jmp dl_term_var_or_ident;

      dl_term_check_digit:
        cmp rdx, 0x30;
        jb  dl_term_check_string;
        cmp rdx, 0x39;
        ja  dl_term_check_string;
        jmp dl_term_number;

      dl_term_check_string:
        cmp rdx, 0x22;                         // '"'
        je  dl_term_string;
        jmp dl_err_syntax;

      dl_term_var_or_ident:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rcx;
        call _dl_scan_ident_or_var;
        // rax = (len << 32) | new_cursor.
        mov r10, rax;
        mov r11, r10;
        mov rcx, 0xFFFFFFFF;
        and r11, rcx;                          // r11 = new_cursor
        shr r10, 32;                           // r10 = len
        mov r9, r10;                           // r9 = term_len
        jmp dl_term_store;

      dl_term_number:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rcx;
        call _dl_scan_number;
        mov r10, rax;
        mov r11, r10;
        mov rcx, 0xFFFFFFFF;
        and r11, rcx;
        shr r10, 32;
        mov r9, r10;
        jmp dl_term_store;

      dl_term_string:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rcx;
        call _dl_scan_string;
        // rax = (len << 32) | status.
        mov r10, rax;
        // Check status (low 32 bits).
        mov r9, r10;
        mov rcx, 0xFFFFFFFF;
        and r9, rcx;
        cmp r9, 0;
        jne dl_err_from_term_string;
        // Compute new_cursor = cursor_in + len.
        shr r10, 32;                           // r10 = len
        mov r11, [rsp + 40];
        add r11, r10;                          // r11 = new_cursor
        mov r9, r10;                           // r9 = term_len
        jmp dl_term_store;

      dl_term_store:
        // Store term_offset (u32) at [r15 + 16 + n_terms_cur*4]:
        //   r8 = r15 + n_terms_cur*4 (via shl r8, 2 + add r8, r15)
        //   mov_d [r8 + 16], scratch_term_off
        mov r10, [rsp + 16];                   // r10 = n_terms_cur
        mov r8, r10;
        shl r8, 2;
        add r8, r15;
        mov rax, [rsp + 40];
        mov_d [r8 + 16], rax;

        // Store term_len (u16) at [r15 + 32 + n_terms_cur*2]:
        //   r8 = r15 + n_terms_cur*2 (via shl r8, 1 + add r8, r15)
        mov r8, r10;
        shl r8, 1;
        add r8, r15;
        mov rax, r9;
        mov_b [r8 + 32], rax;
        shr rax, 8;
        mov_b [r8 + 33], rax;

        // Bump n_terms_cur.
        add r10, 1;
        mov [rsp + 16], r10;

        // Advance cursor.
        mov [rsp + 0], r11;

        // Skip whitespace, then check `,` or `)`.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;

        cmp rax, r12;
        jae dl_err_syntax;
        xor rcx, rcx;
        mov_b rcx, [rbx + rax * 1];
        cmp rcx, 0x2C;                         // ','
        je  dl_termlist_comma;
        cmp rcx, 0x29;                         // ')'
        je  dl_termlist_close;
        jmp dl_err_syntax;

      dl_termlist_comma:
        add rax, 1;
        mov [rsp + 0], rax;
        jmp dl_termlist_loop;

      dl_termlist_close:
        // Consume ')'.
        add rax, 1;
        mov [rsp + 0], rax;

        // Write n_terms (u16) at [r15 + 10].
        mov r10, [rsp + 16];
        mov rax, r10;
        mov_b [r15 + 10], rax;
        shr rax, 8;
        mov_b [r15 + 11], rax;

        // ---- Decide Fact vs Rule by what follows the closing `)` --------
        //
        // Skip whitespace then peek.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;

        cmp rax, r12;
        jae dl_err_syntax;
        xor rcx, rcx;
        mov_b rcx, [rbx + rax * 1];
        cmp rcx, 0x2E;                         // '.'
        je  dl_fact_terminator;
        cmp rcx, 0x3A;                         // ':'
        je  dl_rule_sep_colon;
        jmp dl_err_syntax;

        // --- Fact: consume `.` and commit.
      dl_fact_terminator:
        // kind = DL_KIND_FACT (1).
        mov rax, 1;
        mov_b [r15 + 0], rax;

        // Consume '.'.
        mov rcx, [rsp + 0];
        add rcx, 1;
        mov [rsp + 0], rcx;
        jmp dl_commit_clause;

        // --- Rule: expect `:-`, then Body, then `.`.
      dl_rule_sep_colon:
        // Consume `:` then expect `-`.
        add rax, 1;
        mov [rsp + 0], rax;
        cmp rax, r12;
        jae dl_err_syntax;
        xor rcx, rcx;
        mov_b rcx, [rbx + rax * 1];
        cmp rcx, 0x2D;                         // '-'
        jne dl_err_syntax;
        add rax, 1;
        mov [rsp + 0], rax;

        // kind = DL_KIND_RULE (2).
        mov rax, 2;
        mov_b [r15 + 0], rax;

        // Skip whitespace before body.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        call _dl_skip_ws;
        mov [rsp + 0], rax;

        // body_offset = cursor.
        mov_d [r15 + 40], rax;

        // Scan body.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, rax;
        call _dl_scan_body;
        // Decode: status (bits 0..15), n_atoms (bits 16..31), body_len (bits 32..47).
        mov r10, rax;
        mov r11, rax;
        mov r9, r11;
        mov rcx, 0xFFFF;
        and r9, rcx;                           // r9 = status
        cmp r9, 0;
        jne dl_err_from_body;

        mov r11, r10;
        shr r11, 16;
        mov rcx, 0xFFFF;
        and r11, rcx;                          // r11 = n_atoms

        shr r10, 32;                           // r10 = body_len

        // Write n_body_atoms (u16) at [r15 + 12].
        mov rax, r11;
        mov_b [r15 + 12], rax;
        shr rax, 8;
        mov_b [r15 + 13], rax;

        // Write body_len (u16) at [r15 + 44].
        mov rax, r10;
        mov_b [r15 + 44], rax;
        shr rax, 8;
        mov_b [r15 + 45], rax;

        // Advance cursor past body, expect `.`.
        mov rcx, [rsp + 0];
        add rcx, r10;
        mov [rsp + 0], rcx;
        cmp rcx, r12;
        jae dl_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        cmp rax, 0x2E;                         // '.'
        jne dl_err_syntax;
        add rcx, 1;
        mov [rsp + 0], rcx;
        jmp dl_commit_clause;

        // ====================================================================
        // ---- Commit clause: advance r15, bump count, loop -----------------
        // ====================================================================
      dl_commit_clause:
        // Bump n_clauses_written.
        mov rax, [rsp + 8];
        add rax, 1;
        mov [rsp + 8], rax;
        // Advance r15 by DL_CLAUSE_SIZE (48).
        add r15, 48;
        jmp dl_outer_loop;

        // ====================================================================
        // ---- Normal completion --------------------------------------------
        // ====================================================================
      dl_done:
        // Pack return: (n_clauses << 32) | DL_OK.
        mov rax, [rsp + 8];
        mov r10, 0;                            // status = DL_OK
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

        // ====================================================================
        // ---- Error return paths -------------------------------------------
        // ====================================================================
      dl_err_syntax:
        mov r10, 0x2E00;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_err_too_many_clauses:
        mov r10, 0x2E01;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_err_too_many_terms:
        mov r10, 0x2E02;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_err_from_term_string:
        // r9 carries DL_ERR_UNTERMINATED_STRING already.
        mov r10, r9;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_err_from_body:
        // r9 carries DL_ERR_SYNTAX or DL_ERR_UNTERMINATED_STRING already.
        mov r10, r9;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_err_oos:
        mov r10, 0x2E04;
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        jmp dl_epilogue;

      dl_return_zero_ok:
        // (0 << 32) | DL_OK == 0.
        xor rax, rax;
        jmp dl_epilogue;

        // ====================================================================
        // ---- Epilogue -----------------------------------------------------
        // ====================================================================
      dl_epilogue:
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
