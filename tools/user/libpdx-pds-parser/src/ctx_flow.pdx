// src/ctx_flow.pdx -- libpdx-pds-parser.R225.M5 (paideia-os#2686)
//
// CtxFlow: parser-tier cross-context type-flow bridge over the
// Datalog <-> pipeline-record seam. R225.M5 of the R225 typechecker
// umbrella (paideia-os#2489).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The semantic shell's pds-lang mixes three sub-languages inside the
// same turn:
//
//     ... | datalog { parent(?X, ?Y) } | ...
//
// A Datalog variable (`?X`) that OCCURS in a term that escapes the
// `datalog { ... }` block MUST take the typed argument slot of the
// predicate it binds against. Conversely, a pipeline record (whose
// shape is a R225.M2 row type) that FLOWS IN to a `datalog { ... }`
// block must be re-interpreted as a ground datalog term whose per-
// field type is read off the row.
//
// R225.M3 (PredicateTypes; landed Wave 133 as R226.M2 PredicateTypes
// in the datalog umbrella) carved the predicate-side substrate: a
// 64-byte PredicateRecord with magic 'PRTY' at `[+0]`, u16 arity at
// `[+4]`, u64 name_hash at `[+8]`, u8[32] arg_type_codes at `[+32]`.
// R225.M2 (RowTypes; landed Wave 118) carved the pipeline-side
// substrate: a shared type-graph pool whose row nodes expose fields
// via `_rt_row_select(row_idx, label_hash, out_type_idx_ptr)`.
//
// R225.M5 (THIS module) closes the seam: a CALLER-DRIVEN surface that
// materializes a 64-byte CtxFlow record describing one bridge value
// (one `?var` escaping to pipeline context OR one pipeline field
// entering a datalog block), carrying the source type-ref, the
// derived destination type-ref, the direction byte, and the bridge
// name inline (so a downstream diagnostic reporter can print it
// without re-reading the caller's input). The record is caller-
// supplied, pure data; THIS module owns no `.bss` state. Three
// derivation / check entry points over caller-owned 64-byte scratch:
//
//                raw pds-lang program bytes
//                          |
//                          v
//      +------------------------------------------+
//      | R221 Utf8Nfc + CtxLexer                  |
//      +---------------------+--------------------+
//                            |
//        +-------------------+---------------------+
//        v                                         v
//   +---------+                               +---------+
//   | datalog |                               | pipeline|
//   | R226.M1 |                               | R223.M1 |
//   +----+----+                               +----+----+
//        |                                         |
//        v   per-term type codes                   v   row fields
//   +---------+                               +---------+
//   | R226.M2 |                               | R225.M2 |
//   | PredTy  |                               | RowTypes|
//   +----+----+                               +----+----+
//         \                                       /
//          \                                     /
//           v                                   v
//                   R225.M5 CtxFlow (THIS)
//                 ------------------------------
//                 _cxf_derive_datalog_to_pipeline
//                 _cxf_derive_pipeline_to_datalog
//                 _cxf_check
//                 ------------------------------
//                            |
//                            v
//               typed bridge record for the
//               elaborator / HM solver / Datalog
//               elaborator seam
//
// The surface is deliberately CALLER-DRIVEN. The caller (the shell's
// semantic elaborator; not yet landed, owned by R225.M8+ or an
// adjacent landing in the R225 wave) walks the AST, for each cross-
// context escape computes the bridge name + source type-ref, and
// calls the matching derive entry point. The returned 64-byte record
// is a flat, position-stable, cache-line-sized value the elaborator
// stashes beside its own typing-env entry.
//
// =============================================================================
// RECORD LAYOUT -- 64-BYTE CtxFlow
// =============================================================================
//
//   offset  size  field                 contents
//   ------  ----  -----------------     -----------------------------
//     0      4   magic                  u32 -- 'CTXF' (0x46585443 LE)
//                                              = bytes 43 54 58 46 on
//                                              disk (ASCII C T X F).
//     4      1   direction              u8 -- 0 DATALOG_TO_PIPELINE
//                                             (the datalog `?var`
//                                             escapes outward);
//                                             1 PIPELINE_TO_DATALOG
//                                             (a pipeline-record
//                                             field flows inward).
//     5      1   flags                  u8 -- reserved for M5.1+
//                                             annotation bits (open-
//                                             tail, recursive-escape,
//                                             etc.). Zero at raw M5.
//     6      2   reserved               u16 -- zero at raw M5.
//     8      8   src_type_ref           u64 -- source type-ref:
//                                             direction=0: pointer to
//                                               the resolved
//                                               PredicateRecord (R226.M2;
//                                               magic 'PRTY' at [+0]).
//                                             direction=1: HmCore
//                                               pool_idx (u32 payload
//                                               zero-extended) naming
//                                               the row type-graph
//                                               node (TyRow ROW_EXT /
//                                               ROW_VAR / ROW_EMPTY).
//    16      8   dst_type_ref           u64 -- derived type-ref:
//                                             direction=0: SchemasSig
//                                               / PT_TYPE_* code
//                                               (SS_TYPE_U64 = 1 ..
//                                               PT_TYPE_WILD = 11) in
//                                               the low 8 bits; upper
//                                               56 bits zero.
//                                             direction=1: HmCore
//                                               pool_idx (u32 payload
//                                               zero-extended) naming
//                                               the per-field type
//                                               node resolved via
//                                               _rt_row_select.
//    24     32   bridge_name_inline     u8[32] -- bridge name, zero-
//                                               padded. For direction=0
//                                               this is the ?var name
//                                               (minus leading `?`);
//                                               for direction=1 this
//                                               is the row-field
//                                               label name.
//    56      8   reserved               u64 -- zero at raw M5.
//
//   total: 64 B (CXF_RECORD_BYTES). The record is pure data; the
//   module owns NO .bss pool for it. The record is caller-owned on
//   every public surface.
//
// Stride-reconciliation note: the parent brief listed the inline-name
// buffer as `u8[32]` at offset 0x18, and the terminal reserved slot
// at offset 0x38 = 56. 0x38 + 8 = 0x40 = 64, so the full record is
// exactly 64 bytes; no stride widening needed (compare R226.M2's
// 48-vs-64 reconciliation at its landing).
//
// =============================================================================
// POOL  --  NONE
// =============================================================================
//
// R225.M5 owns NO `.bss` state. Every record is caller-owned. The
// derivation entries read ONLY caller-supplied pointer args
// (`predicate_record` for direction=0; the shared HmCore pool via
// R225.M2's `_rt_label_hash` + `_rt_row_select` for direction=1).
// The check entry reads ONLY the caller-supplied 64-byte record.
//
// `_cxf_init` is a bare `ret` -- kept for parallelism with the
// parser-family init-hook convention (`_ha_init` R223.M6, `_ws_init`
// R223.M5, `_ds_init` R222.M8, `_dm_init` R222.M6, `_cmdreg_init`
// R222.M5, `_st_init` R223.M7).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _cxf_init() -> ()
//     Bare `ret`. Pure leaf. Entry rsp%16==8.
//
//   _cxf_derive_datalog_to_pipeline(predicate_record, arg_idx,
//                                   var_name_ptr, var_name_len,
//                                   out, out_cap) -> status
//     Materialize a direction=0 CtxFlow record from a resolved
//     PredicateRecord + the per-call arg_idx + the ?var name span.
//     The derived dst_type_ref is the predicate's arg_type_codes[
//     arg_idx] byte zero-extended into u64.
//
//     rdi = predicate_record  -- ptr to a 64-byte R226.M2 PredicateRecord
//                                (magic 'PRTY' at [+0]).
//     rsi = arg_idx           -- 0..arity-1; must be < predicate.arity.
//     rdx = var_name_ptr      -- ASCII identifier bytes of the ?var
//                                name (without the leading `?`).
//     rcx = var_name_len      -- length in bytes, in [1..32].
//     r8  = out               -- 64-byte caller-owned scratch.
//     r9  = out_cap           -- capacity in bytes; must be >= 64.
//     rax = CXF_OK | CXF_ERR_*
//
//     Pure leaf -- no CALL, no callee-save pushes, no stack frame.
//     Labels prefixed cxf_dp_.
//
//   _cxf_derive_pipeline_to_datalog(row_type_ref, field_name_ptr,
//                                   field_name_len, out, out_cap)
//                                                           -> status
//     Materialize a direction=1 CtxFlow record from a pipeline-row
//     type-ref + the field-name span. Resolves the field's typed
//     slot by calling R225.M2 `_rt_label_hash` to compute the FNV-1a
//     32 label hash, then R225.M2 `_rt_row_select` to walk the row
//     chain for the matching ROW_EXT and read its field-type
//     pool_idx. That pool_idx (zero-extended into u64) is the
//     derived dst_type_ref.
//
//     rdi = row_type_ref      -- HmCore pool_idx (u32 payload) naming
//                                a TyRow node. CALLER unwraps any
//                                outer TyApp(TyCon(RECORD,1), row)
//                                wrapping before invocation.
//     rsi = field_name_ptr    -- ASCII identifier bytes of the field
//                                label.
//     rdx = field_name_len    -- length in bytes, in [1..32].
//     rcx = out               -- 64-byte caller-owned scratch.
//     r8  = out_cap           -- capacity in bytes; must be >= 64.
//     rax = CXF_OK | CXF_ERR_*
//
//     6 callee-save pushes + sub rsp, 24 = 72 B frame. Nested CALLs
//     to _rt_label_hash + _rt_row_select. Labels prefixed cxf_pd_.
//
//   _cxf_check(ctxflow_record, record_len) -> status
//     Validate a filled CtxFlow record. Confirms magic, direction
//     in {0, 1}, src_type_ref != 0, dst_type_ref != 0, record_len
//     >= 64. The record's bridge_name_inline / reserved bytes are
//     NOT structurally inspected -- the caller is responsible for
//     name hygiene.
//
//     rdi = ctxflow_record    -- ptr to a 64-byte record.
//     rsi = record_len        -- capacity in bytes; must be >= 64.
//     rax = CXF_OK | CXF_ERR_*
//
//     Pure leaf -- no CALL, no callee-save pushes, no stack frame.
//     Labels prefixed cxf_ck_.
//
// =============================================================================
// STATUS CODES -- band 0x6600..0x66FF
// =============================================================================
//
// Grep confirmation at R225.M5 landing time:
//
//   grep -rE '0x66[0-9A-F]{2}' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file, caps.decl,
//        design/shell/cross-context-type-flow.md, STATUS.md, and
//        .plans/scratch/CHANGELOG-R225M5.md.
//
// Band 0x6600..0x66FF sits directly above R227.M7 ScriptCache
// (0x6500..0x65FF, landed Wave 133), R226.M2 PredicateTypes
// (0x6400..0x64FF, landed Wave 133), R225.M10 CheckFingerprint
// (0x6300..0x63FF, landed Wave 133), R227.M6 VersionPragma
// (0x6200..0x62FF, landed Wave 132), and R225.M9 ProptestHm
// (0x6100..0x61FF, landed Wave 132). The next kilo-step band
// 0x6700..0x67FF stays reserved for a future R225 wave arm.
//
//   CXF_OK                    = 0        operation succeeded.
//   CXF_ERR_BAD_PTR           = 0x6600   NULL pointer where a non-NULL
//                                        pointer was required
//                                        (predicate_record, var_name_
//                                        ptr, out, field_name_ptr,
//                                        ctxflow_record == 0).
//   CXF_ERR_BAD_RECORD        = 0x6601   predicate_record magic at
//                                        [+0] != 'PRTY' on derive;
//                                        ctxflow_record magic at
//                                        [+0] != 'CTXF' on check.
//   CXF_ERR_BAD_DIRECTION     = 0x6602   _cxf_check: direction byte
//                                        at [+4] not in {0, 1}.
//   CXF_ERR_BAD_ARG_IDX       = 0x6603   _cxf_derive_datalog_to_
//                                        pipeline: arg_idx >= arity.
//   CXF_ERR_BAD_NAME          = 0x6604   bridge name len == 0 or
//                                        len > CXF_NAME_MAX (32), OR
//                                        name_ptr == 0 with len > 0.
//   CXF_ERR_OUT_TOO_SMALL     = 0x6605   out_cap < CXF_RECORD_BYTES
//                                        (64).
//   CXF_ERR_UNKNOWN_FIELD     = 0x6606   _cxf_derive_pipeline_to_
//                                        datalog: _rt_row_select
//                                        returned RT_ERR_LABEL_MISSING
//                                        (0x3600) -- the row chain
//                                        has no ROW_EXT with the
//                                        requested label.
//   CXF_ERR_BAD_ROW           = 0x6607   _cxf_derive_pipeline_to_
//                                        datalog: row_type_ref == 0
//                                        (an unresolved row ref is
//                                        rejected at raw M5; M5.1+
//                                        may add row-var relax).
//   CXF_ERR_BAD_LEN           = 0x6608   _cxf_check: record_len <
//                                        CXF_RECORD_BYTES (64).
//   CXF_ERR_BAD_TYPE_CODE     = 0x6609   _cxf_derive_datalog_to_
//                                        pipeline: the type code at
//                                        [predicate_record + 32 +
//                                        arg_idx] is 0 (SS_TYPE_END)
//                                        or > PT_TYPE_WILD (11) --
//                                        indicates a zero-arity-slot
//                                        read past the live arity or
//                                        a corrupted PredicateRecord.
//   CXF_ERR_BAD_SRC_REF       = 0x660A   _cxf_check: src_type_ref ==
//                                        0 OR dst_type_ref == 0
//                                        (both axes rejected under
//                                        one slot; the derive paths
//                                        themselves never emit a
//                                        record with either slot
//                                        zero so this is a check-
//                                        time catch for externally
//                                        produced records).
//
// Slots 0x660B..0x66FF reserved for M5.1+ derive / check diagnostics
// (open-tail row-var relax, recursive-escape warn-level, subsumption
// rule refinement for cross-context subtyping, bridge-name UTF-8
// validation, PredicateRecord-arg-type-code vs row-field-type
// cross-validation when the HM bridge M5.2+ lands).
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R226.M2 PredicateTypes (predicate_types.pdx)
//     The direction=0 derive path reads the caller-supplied
//     PredicateRecord in-place: validates the magic u32 at [+0] via
//     `cmp rax, 0x59545250` (= 'PRTY' LE), reads the u16 arity at
//     [+4] (low+high byte stitched), reads the u8 type code at
//     [predicate_record + 32 + arg_idx] via `mov_b`. No direct call
//     from THIS module into predicate_types.pdx; the caller resolves
//     the record via `_pt_lookup` and hands it to us by pointer.
//
//   R225.M2 RowTypes (row_types.pdx)
//     The direction=1 derive path CALLs `_rt_label_hash(ptr, len)`
//     to compute the FNV-1a 32 label hash, then
//     `_rt_row_select(row_idx, label_hash, &scratch)` to walk the
//     row chain. These are intra-library CALLs across module
//     linker-scopes (precedent: `_rt_row_unify` calls `_hm_unify`
//     from the sibling R225.M1 hm_core.pdx the same way).
//
//   R222.M1 SchemasSig (schemas_sig.pdx)
//     The type-code set in the direction=0 derive path uses the
//     SS_TYPE_* numbering (1..6, 8..9) verbatim as the low 8 bits
//     of dst_type_ref. PT_TYPE_VAR (10) and PT_TYPE_WILD (11) are
//     the parser-tier M2 extensions (defined in predicate_types.pdx)
//     that THIS module accepts without translation on derive.
//
//   R225.M8+ HM semantic elaborator (NOT yet landed)
//     The caller of all three entry points. Walks the AST, drives
//     the per-escape derive calls, stashes each returned CtxFlow
//     record beside its own typing-env entry, and plumbs the
//     bridge records into the diagnostic reporter's E09NN /
//     E07NN family when a mismatch surfaces.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the only mask we need is `shl r, 48;
//     shr r, 48` to isolate low 16 bits of a scratch register when
//     reading the u16 arity field (parallel to R226.M2 flags
//     isolation).
//   - No 2-op `imul r, imm` -- no multiplication in this module.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `CtxFlow` matches `ctx_flow.pdx`.
//   - Labels prefixed `cxf_` (unique against every landed parser-tier
//     label prefix: u8n_, gi_, wp_, cl_, ast_, sm_, fh_, sch_sig_,
//     cmd_sig_, fi_, afs_, cmdreg_, dm_, ds_, pl_, pl_lam_, rp_, fo_,
//     sgr_, ws_, ha_, st_, ll_, cc_, er_, cr_, ls_, lp_, hm_, rt_,
//     eu_, dl_, se_, te_, jc_, h_, le_, vi_, ml_, ir_, rc_, rd_, dr_,
//     lc_, lh_, tf_, mf_, vp_, pth_, scc_, pt_). Per-function suffix:
//     `cxf_ini_` init, `cxf_dp_` datalog-to-pipeline derive, `cxf_pd_`
//     pipeline-to-datalog derive, `cxf_ck_` check. Never bare
//     `loop`/`if`/`let`/`fn`/`ret`/`done` (paideia-as reserved
//     keywords).
//   - All `cmp reg, imm` immediates (0, 1, 2, 32, 64, 11, 0x46585443,
//     0x59545250, 0x6600..0x660A) fit imm32 with bit 31 clear.
//     'CTXF' = 0x46585443 and 'PRTY' = 0x59545250 both have bit 31
//     clear, so direct `mov r, imm32` and `cmp r, imm32` are sign-
//     safe.
//   - Byte loads via `xor r,r; mov_b r,[addr + idx * 1]` (zero-
//     extends into the full qword; paideia-as #1248 + U1606
//     mitigation; explicit *1 scale per libpdx-pds-parser Pipeline
//     + libpdx-audit precedent).
//   - u32 stores via `mov_d`; u16 stores via two `mov_b` byte stores
//     (low, high); u64 stores via plain `mov [dst], rax`.
//   - u8 stores via `mov_b [dst], rN`.
//   - No three-term addressing: every `[base + idx + disp]`
//     precomputes the address via `mov r10, base; add r10, idx;
//     add r10, disp; mov_b dst, [r10]` (per the encoder-pitfalls
//     note; parallel to R226.M2 `_pt_check_call` discipline).
//   - `_cxf_init` is pure leaf. `_cxf_derive_datalog_to_pipeline` is
//     pure leaf (reads caller buffers only; writes caller-supplied
//     out buffer; no CALL). `_cxf_check` is pure leaf (reads caller
//     buffer only; no CALL). Only `_cxf_derive_pipeline_to_datalog`
//     holds a callee-save frame -- 6 pushes + sub rsp, 24 = 72 B
//     total. Entry rsp%16==8, +48 pushes = %16==8, +24 = %16==0 at
//     every nested CALL (_rt_label_hash, _rt_row_select).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M5.1  Open-tail row-var relax: direction=1 derive currently
//              rejects a ROW_VAR tail (via CXF_ERR_UNKNOWN_FIELD when
//              _rt_row_select returns LABEL_MISSING). M5.1 adds a
//              row-var-tail-as-fresh-TyVar relax (allocates a fresh
//              type-graph node and binds the row-var's resolved
//              slot to it; the caller then sees a derived dst_type
//              that is a TyVar instead of an opaque pool_idx).
//   R225.M5.2  HM-bridge cross-validation: once R225.M8 PlusExpand
//              lands, _cxf_check gains an optional magic-level
//              `expect` check that verifies the derived dst_type_ref
//              is compatible with the expected type at the escape
//              site. This stays an additive status code
//              (CXF_ERR_BRIDGE_INCOMPATIBLE, 0x660B).
//   R225.M5.3  25-test corpus landing under
//              `tests/shell/cross-context/` + proptest-hm bridge
//              shim (mirrors the R221.M7 + R225.M9 split).
//   R225.M8    HM semantic elaborator: consumes the three public
//              entries on every datalog-escape and every pipeline-
//              into-datalog recognition point.
//   R226.M3    Bottom-up semi-naive evaluator: reads the
//              direction=1 derived field types to confirm the
//              in-flow record satisfies the predicate's typed slot.
//
// =============================================================================
// Upstream: paideia-os#2489 (R225 umbrella), paideia-os#2686 (THIS
// ticket, R225.M5). Substrate: paideia-os#2683 (R225.M2 RowTypes),
// paideia-os#2693 (R226.M2 PredicateTypes), paideia-os#2666
// (R223.M1 Pipeline), paideia-os#2692 (R226.M1 Datalog). Design doc:
// design/shell/cross-context-type-flow.md.

module CtxFlow = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Band 0x6600..0x66FF, reserved for the R225.M5 cross-context
  // type-flow substrate. Disjoint from every prior landed satellite
  // band (see caps.decl for the full disjointness proof).

  pub let CXF_OK                       : u64 = 0
  pub let CXF_ERR_BAD_PTR              : u64 = 0x6600
  pub let CXF_ERR_BAD_RECORD           : u64 = 0x6601
  pub let CXF_ERR_BAD_DIRECTION        : u64 = 0x6602
  pub let CXF_ERR_BAD_ARG_IDX          : u64 = 0x6603
  pub let CXF_ERR_BAD_NAME             : u64 = 0x6604
  pub let CXF_ERR_OUT_TOO_SMALL        : u64 = 0x6605
  pub let CXF_ERR_UNKNOWN_FIELD        : u64 = 0x6606
  pub let CXF_ERR_BAD_ROW              : u64 = 0x6607
  pub let CXF_ERR_BAD_LEN              : u64 = 0x6608
  pub let CXF_ERR_BAD_TYPE_CODE        : u64 = 0x6609
  pub let CXF_ERR_BAD_SRC_REF          : u64 = 0x660A

  // ==========================================================================
  // SECTION 2 -- RECORD LAYOUT CONSTANTS
  // ==========================================================================

  pub let CXF_RECORD_BYTES             : u64 = 64
  pub let CXF_NAME_MAX                 : u64 = 32

  // Magic: 'CTXF' little-endian = 0x46585443. Reads as the 4-byte
  // ASCII string "CTXF" in a hex dump (bytes 43 54 58 46).
  pub let CXF_RECORD_MAGIC             : u64 = 0x46585443

  // Record field offsets.
  pub let CXF_OFF_MAGIC                : u64 = 0        // u32
  pub let CXF_OFF_DIRECTION            : u64 = 4        // u8
  pub let CXF_OFF_FLAGS                : u64 = 5        // u8
  pub let CXF_OFF_RESERVED_6           : u64 = 6        // u16
  pub let CXF_OFF_SRC_TYPE_REF         : u64 = 8        // u64
  pub let CXF_OFF_DST_TYPE_REF         : u64 = 16       // u64
  pub let CXF_OFF_BRIDGE_NAME_INLINE   : u64 = 24       // u8[32]
  pub let CXF_OFF_RESERVED_56          : u64 = 56       // u64

  // Direction codes.
  pub let CXF_DIR_DATALOG_TO_PIPELINE  : u64 = 0
  pub let CXF_DIR_PIPELINE_TO_DATALOG  : u64 = 1

  // R226.M2 constants (duplicated as local literals so the module
  // links standalone against predicate_types.pdx's constants --
  // we only need the magic + the arg-type-codes offset + the arity
  // offset to read a resolved PredicateRecord in-place).
  pub let CXF_PT_RECORD_MAGIC          : u64 = 0x59545250
  pub let CXF_PT_OFF_ARITY             : u64 = 4
  pub let CXF_PT_OFF_ARG_TYPE_CODES    : u64 = 32
  pub let CXF_PT_TYPE_CODE_MAX         : u64 = 11

  // R225.M2 return code we discriminate against (RT_OK = 0 is
  // handled by zero-value compare; the explicit miss code is below).
  pub let CXF_RT_ERR_LABEL_MISSING     : u64 = 0x3600

  // ==========================================================================
  // _cxf_init() -> ()
  //
  //   Bare `ret`. The module owns NO .bss state at raw M5 so there
  //   is nothing to zero. Kept for parallelism with the parser-
  //   family init-hook convention.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cxf_ini_.
  // ==========================================================================
  pub let _cxf_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R225.M5 (#2686): _cxf_init is a bare ret. The module owns NO .bss state at raw M5 -- every record is caller-owned on all three public entries. Kept for parallelism with the parser-family init-hook convention (_st_init R223.M7, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Entry rsp%16==8 (standard SysV). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cxf_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _cxf_derive_datalog_to_pipeline(predicate_record, arg_idx,
  //                                 var_name_ptr, var_name_len,
  //                                 out, out_cap) -> status
  //
  //   rdi = predicate_record    -- ptr to a R226.M2 64-byte
  //                                PredicateRecord ('PRTY' magic).
  //   rsi = arg_idx             -- 0..arity-1.
  //   rdx = var_name_ptr        -- ASCII name bytes.
  //   rcx = var_name_len        -- 1..32.
  //   r8  = out                 -- 64-byte caller-owned scratch.
  //   r9  = out_cap             -- bytes, >= 64.
  //   rax = CXF_OK | CXF_ERR_*
  //
  // Flow:
  //   1. Validate out != 0 (BAD_PTR 0x6600).
  //   2. Validate out_cap >= 64 (OUT_TOO_SMALL 0x6605).
  //   3. Validate predicate_record != 0 (BAD_PTR).
  //   4. Load u32 magic at [predicate_record + 0]; compare with
  //      'PRTY' (0x59545250); mismatch -> BAD_RECORD (0x6601).
  //   5. Load u16 arity at [predicate_record + 4] (low+high stitched);
  //      compare arg_idx < arity (BAD_ARG_IDX 0x6603 on fail).
  //   6. Validate var_name_ptr != 0 (BAD_PTR); var_name_len in
  //      [1..32] (BAD_NAME 0x6604).
  //   7. Load u8 arg_type_codes[arg_idx] at [predicate_record + 32
  //      + arg_idx]; validate in [1..11] (BAD_TYPE_CODE 0x6609).
  //   8. Zero-fill 64 bytes at out via 8 u64 stores.
  //   9. Stamp u32 magic 'CTXF' at [+0]; u8 direction = 0 at [+4];
  //      u8 flags = 0 at [+5]; u16 reserved at [+6] (already zero);
  //      u64 src_type_ref = predicate_record at [+8]; u64 dst_type_
  //      ref = arg_type_code (zero-extended) at [+16]; byte-copy
  //      var_name_len bytes at [+24..+24+var_name_len] (zero-padded
  //      past len via the zero-fill above); u64 reserved at [+56]
  //      (already zero).
  //  10. Return CXF_OK.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // We have 6 args in rdi/rsi/rdx/rcx/r8/r9; since no CALL fires we
  // can use any caller-save register freely including the arg regs
  // after the first read. Labels prefixed cxf_dp_.
  // ==========================================================================
  pub let _cxf_derive_datalog_to_pipeline : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (predicate_record: u64) (arg_idx: u64) (var_name_ptr: u64) (var_name_len: u64)
       (out: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R225.M5 (#2686): _cxf_derive_datalog_to_pipeline materializes a direction=0 CtxFlow record from a resolved R226.M2 PredicateRecord + arg_idx + ?var name span. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL (no need to preserve args across CALL -- there is no CALL). Entry rsp%16==8 (standard SysV). Flow: (1) validate r8 (out) != 0 (BAD_PTR 0x6600); (2) r9 (out_cap) >= 64 (OUT_TOO_SMALL 0x6605); (3) rdi (predicate_record) != 0 (BAD_PTR); (4) load u32 magic via `xor rax,rax; mov_d rax,[rdi+0]`; compare with 0x59545250 'PRTY', mismatch -> BAD_RECORD 0x6601; (5) load u16 arity via two mov_b: `xor rax,rax; mov_b rax,[rdi+4]; xor r10,r10; mov_b r10,[rdi+5]; shl r10,8; or rax,r10` and shl 48/shr 48 to isolate low 16 bits defensively; compare rsi (arg_idx) < rax (arity), fail -> BAD_ARG_IDX 0x6603; (6) rdx (var_name_ptr) != 0 (BAD_PTR); rcx (var_name_len) in [1..32] (BAD_NAME 0x6604); (7) precompute addr = rdi + 32 + rsi via `mov r10, rdi; add r10, rsi; add r10, 32` then `xor rax,rax; mov_b rax,[r10]` to read type code; validate 1 <= type_code <= 11 (BAD_TYPE_CODE 0x6609 outside range; this catches a corrupted record whose arg_type_codes[arg_idx] slot was never populated); (8) zero-fill 64 bytes at r8 via 8 u64 stores at [r8+0], [+8], ..., [+56]; (9) stamp u32 magic 'CTXF' = 0x46585443 at [r8+0] via `mov rax, 0x46585443; mov_d [r8+0], rax`; u8 direction = 0 at [r8+4] (already zero from zero-fill but re-stamped via mov_b for clarity); u8 flags = 0 at [r8+5]; u64 src_type_ref = rdi at [r8+8]; u64 dst_type_ref = type_code at [r8+16]; byte-copy name_len bytes from [rdx] to [r8+24..] via a loop with mov_b at `[r10+24]` where r10 is a precomputed address; u64 reserved = 0 at [r8+56] (already zero). (10) return CXF_OK (0). 'CTXF' = 0x46585443 has bit 30 set but bit 31 clear so direct mov r,imm32 and cmp r,imm32 are sign-safe. 'PRTY' = 0x59545250 also has bit 31 clear. All other cmp immediates (0, 1, 11, 32, 64, 0x6600, 0x6601, 0x6603, 0x6604, 0x6605, 0x6609) fit imm32 with bit 31 clear. Byte loads via `xor r,r; mov_b r,[addr]`. u32 loads via `xor r,r; mov_d r,[addr]`. u16 load via two byte loads + shift+or. u32 store via mov_d. u64 store via plain mov. u8 store via mov_b. No test; no and-imm64; no imul-r-imm; no three-term addressing; no multiline let. Labels prefixed cxf_dp_.",
      block: {
        // (1) Validate out != 0.
        cmp r8, 0;
        je  cxf_dp_bad_ptr;

        // (2) Validate out_cap >= 64.
        cmp r9, 64;
        jb  cxf_dp_out_too_small;

        // (3) Validate predicate_record != 0.
        cmp rdi, 0;
        je  cxf_dp_bad_ptr;

        // (4) Load u32 magic at [predicate_record + 0]; compare 'PRTY'.
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x59545250;                   // CXF_PT_RECORD_MAGIC
        jne cxf_dp_bad_record;

        // (5) Load u16 arity at [predicate_record + 4] (low+high bytes).
        xor rax, rax;
        mov_b rax, [rdi + 4];
        xor r10, r10;
        mov_b r10, [rdi + 5];
        shl r10, 8;
        or  rax, r10;
        // Defensive low-16 isolation (shl/shr pair; no and-imm64).
        shl rax, 48;
        shr rax, 48;
        // Compare arg_idx < arity.
        cmp rsi, rax;
        jae cxf_dp_bad_arg_idx;

        // (6) Validate var_name_ptr != 0 and var_name_len in [1..32].
        cmp rdx, 0;
        je  cxf_dp_bad_ptr;
        cmp rcx, 0;
        je  cxf_dp_bad_name;
        cmp rcx, 32;                           // CXF_NAME_MAX
        ja  cxf_dp_bad_name;

        // (7) Load type_code at [predicate_record + 32 + arg_idx].
        //     Precompute address: no three-term addressing.
        mov r10, rdi;
        add r10, rsi;
        add r10, 32;                           // CXF_PT_OFF_ARG_TYPE_CODES
        xor rax, rax;
        mov_b rax, [r10];                      // rax = type_code
        // Validate type_code in [1..11].
        cmp rax, 0;
        je  cxf_dp_bad_type_code;
        cmp rax, 11;                           // CXF_PT_TYPE_CODE_MAX
        ja  cxf_dp_bad_type_code;
        // Save type_code in r11 (caller-save but no CALL fires).
        mov r11, rax;

        // (8) Zero-fill 64 bytes at out via 8 u64 stores.
        xor rax, rax;
        mov [r8 +  0], rax;
        mov [r8 +  8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
        mov [r8 + 32], rax;
        mov [r8 + 40], rax;
        mov [r8 + 48], rax;
        mov [r8 + 56], rax;

        // (9) Stamp u32 magic 'CTXF' at [+0].
        mov rax, 0x46585443;                   // CXF_RECORD_MAGIC
        mov_d [r8 + 0], rax;

        // u8 direction = 0 at [+4] (zero from zero-fill; re-stamp for clarity).
        xor rax, rax;
        mov_b [r8 + 4], rax;

        // u8 flags = 0 at [+5] (zero from zero-fill; re-stamp).
        mov_b [r8 + 5], rax;

        // u64 src_type_ref = predicate_record at [+8].
        mov [r8 + 8], rdi;

        // u64 dst_type_ref = type_code (held in r11) at [+16].
        mov [r8 + 16], r11;

        // Byte-copy var_name_len bytes from [rdx] to [r8 + 24 .. +24+len].
        //     Precompute per-iteration addresses (no three-term addressing).
        xor rax, rax;                          // i = 0
      cxf_dp_copy_name_loop:
        cmp rax, rcx;
        jae cxf_dp_copy_name_done;
        // byte_src = [rdx + i]
        mov r10, rdx;
        add r10, rax;
        xor r11, r11;
        mov_b r11, [r10];
        // byte_dst at [r8 + 24 + i]
        mov r10, r8;
        add r10, rax;
        mov_b [r10 + 24], r11;
        add rax, 1;
        jmp cxf_dp_copy_name_loop;

      cxf_dp_copy_name_done:
        // u64 reserved = 0 at [+56] already zero from zero-fill.

        // (10) Return CXF_OK.
        xor rax, rax;
        ret;

      cxf_dp_bad_ptr:
        mov rax, 0x6600;
        ret;

      cxf_dp_bad_record:
        mov rax, 0x6601;
        ret;

      cxf_dp_bad_arg_idx:
        mov rax, 0x6603;
        ret;

      cxf_dp_bad_name:
        mov rax, 0x6604;
        ret;

      cxf_dp_out_too_small:
        mov rax, 0x6605;
        ret;

      cxf_dp_bad_type_code:
        mov rax, 0x6609;
        ret;
      }
    }

  // ==========================================================================
  // _cxf_derive_pipeline_to_datalog(row_type_ref, field_name_ptr,
  //                                 field_name_len, out, out_cap)
  //                                                          -> status
  //
  //   rdi = row_type_ref        -- HmCore pool_idx naming a TyRow
  //                                (ROW_EXT / ROW_VAR / ROW_EMPTY).
  //                                Caller unwraps TyApp wrapping.
  //   rsi = field_name_ptr      -- ASCII identifier bytes.
  //   rdx = field_name_len      -- 1..32.
  //   rcx = out                 -- 64-byte caller-owned scratch.
  //   r8  = out_cap             -- bytes, >= 64.
  //   rax = CXF_OK | CXF_ERR_*
  //
  // Flow:
  //   1. Validate out != 0 (BAD_PTR 0x6600).
  //   2. Validate out_cap >= 64 (OUT_TOO_SMALL 0x6605).
  //   3. Validate field_name_ptr != 0 (BAD_PTR).
  //   4. Validate field_name_len in [1..32] (BAD_NAME 0x6604).
  //   5. Validate row_type_ref != 0 (BAD_ROW 0x6607).
  //   6. Call _rt_label_hash(field_name_ptr, field_name_len) -> rax
  //      (upper 32 bits zero).
  //   7. Store scratch[0] := 0 (sentinel for the _rt_row_select
  //      out param); call _rt_row_select(row_type_ref, label_hash,
  //      &scratch) -> rax (RT_OK = 0 or RT_ERR_LABEL_MISSING =
  //      0x3600). On miss -> UNKNOWN_FIELD (0x6606).
  //   8. Load scratch[0] into r11 (= field_type_pool_idx).
  //   9. Zero-fill 64 bytes at out via 8 u64 stores.
  //  10. Stamp 'CTXF' magic at [+0]; u8 direction = 1 at [+4];
  //      u8 flags = 0 at [+5]; u64 src_type_ref = row_type_ref at
  //      [+8]; u64 dst_type_ref = field_type_pool_idx (r11) at
  //      [+16]; byte-copy field_name_len bytes at [+24..].
  //  11. Return CXF_OK.
  //
  // Register map:
  //   rbx = row_type_ref (across _rt_label_hash CALL)
  //   rbp = field_name_ptr (used again as _rt_label_hash arg)
  //   r12 = field_name_len (used again as _rt_label_hash arg)
  //   r13 = out
  //   r14 = out_cap
  //   r15 = label_hash (across _rt_row_select CALL)
  //   [rsp + 0] = scratch u64 for _rt_row_select out param
  //   [rsp + 8] = pad
  //
  // 6 callee-save pushes + sub rsp, 24 = 72 B frame. Entry rsp%16==8,
  // +48 pushes = %16==8, +24 scratch = %16==0 (16 would leave %16==8) at every nested CALL
  // (_rt_label_hash, _rt_row_select). Labels prefixed cxf_pd_.
  // ==========================================================================
  pub let _cxf_derive_pipeline_to_datalog : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_type_ref: u64) (field_name_ptr: u64) (field_name_len: u64)
       (out: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R225.M5 (#2686): _cxf_derive_pipeline_to_datalog materializes a direction=1 CtxFlow record from a row-type pool_idx + field-name span. Resolves the field via R225.M2 _rt_label_hash + _rt_row_select (cross-module CALLs; precedent: R225.M2 _rt_row_unify calls _hm_unify from the sibling R225.M1 hm_core.pdx). 6 callee-save pushes (rbx=row_type_ref, rbp=field_name_ptr, r12=field_name_len, r13=out, r14=out_cap, r15=label_hash) + `sub rsp, 24` scratch frame (slot 0 = u64 out param for _rt_row_select; slot 8,16 = pad) = 72 B. Entry rsp%16==8, after 6 pushes rsp%16==8, +24 scratch = rsp%16==0 at every nested CALL. Flow: (1) validate rcx (out) != 0 (BAD_PTR 0x6600); (2) r8 (out_cap) >= 64 (OUT_TOO_SMALL 0x6605); (3) rsi (field_name_ptr) != 0 (BAD_PTR); (4) rdx (field_name_len) in [1..32] (BAD_NAME 0x6604); (5) rdi (row_type_ref) != 0 (BAD_ROW 0x6607); (6) move args into callee-save and call _rt_label_hash(rdi=rbp, rsi=r12) -> r15 = label_hash; (7) zero scratch via `xor rax,rax; mov [rsp+0], rax`; call _rt_row_select(rdi=rbx, rsi=r15, rdx=rsp+0) -> rax status; on RT_ERR_LABEL_MISSING (0x3600) return UNKNOWN_FIELD (0x6606); on RT_OK (0) continue; any other value is a defensive catch -> UNKNOWN_FIELD; (8) load scratch[0] into r11; (9) zero-fill 64 bytes at r13 via 8 u64 stores; (10) stamp u32 magic 'CTXF' = 0x46585443 at [r13+0] via mov_d; u8 direction = 1 at [r13+4]; u8 flags = 0 at [r13+5]; u64 src_type_ref = rbx at [r13+8]; u64 dst_type_ref = r11 (field_type_pool_idx) at [r13+16]; byte-copy r12 bytes from [rbp] to [r13+24..] via a loop with per-iteration precomputed addresses (no three-term addressing); u64 reserved = 0 at [r13+56] from zero-fill. (11) return CXF_OK (0). 'CTXF' = 0x46585443 has bit 31 clear -- imm32 sign-safe. All other cmp immediates (0, 1, 32, 64, 0x3600, 0x6600, 0x6604, 0x6605, 0x6606, 0x6607) fit imm32 with bit 31 clear. Byte loads via `xor r,r; mov_b r,[addr]`. u32 store via mov_d. u8 store via mov_b. u64 store via plain mov. r15 holds label_hash across the second CALL. No test; no and-imm64; no imul-r-imm; no three-term addressing; no multiline let. Labels prefixed cxf_pd_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;                           // scratch[0]=u64 out param; scratch[8]=pad

        // Save args into callee-save registers BEFORE validating / CALLing.
        mov rbx, rdi;                          // row_type_ref
        mov rbp, rsi;                          // field_name_ptr
        mov r12, rdx;                          // field_name_len
        mov r13, rcx;                          // out
        mov r14, r8;                           // out_cap
        xor r15, r15;                          // label_hash (computed later)

        // (1) Validate out != 0.
        cmp r13, 0;
        je  cxf_pd_bad_ptr;

        // (2) Validate out_cap >= 64.
        cmp r14, 64;
        jb  cxf_pd_out_too_small;

        // (3) Validate field_name_ptr != 0.
        cmp rbp, 0;
        je  cxf_pd_bad_ptr;

        // (4) Validate field_name_len in [1..32].
        cmp r12, 0;
        je  cxf_pd_bad_name;
        cmp r12, 32;                           // CXF_NAME_MAX
        ja  cxf_pd_bad_name;

        // (5) Validate row_type_ref != 0.
        cmp rbx, 0;
        je  cxf_pd_bad_row;

        // (6) Compute label_hash via _rt_label_hash(field_name_ptr, len).
        mov rdi, rbp;
        mov rsi, r12;
        call _rt_label_hash;
        mov r15, rax;                          // r15 = label_hash

        // (7) Zero scratch[0], then _rt_row_select(row_type_ref,
        //     label_hash, &scratch[0]).
        xor rax, rax;
        mov [rsp + 0], rax;

        mov rdi, rbx;
        mov rsi, r15;
        mov rdx, rsp;                          // &scratch[0] (= rsp + 0)
        call _rt_row_select;

        // Branch on status: RT_OK (0) -> continue; else -> UNKNOWN_FIELD.
        cmp rax, 0;
        jne cxf_pd_unknown_field;

        // (8) Load scratch[0] into r11 = field_type_pool_idx.
        mov r11, [rsp + 0];

        // (9) Zero-fill 64 bytes at out (r13) via 8 u64 stores.
        xor rax, rax;
        mov [r13 +  0], rax;
        mov [r13 +  8], rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;
        mov [r13 + 32], rax;
        mov [r13 + 40], rax;
        mov [r13 + 48], rax;
        mov [r13 + 56], rax;

        // (10) Stamp u32 magic 'CTXF' at [+0].
        mov rax, 0x46585443;                   // CXF_RECORD_MAGIC
        mov_d [r13 + 0], rax;

        // u8 direction = 1 at [+4].
        mov rax, 1;
        mov_b [r13 + 4], rax;

        // u8 flags = 0 at [+5] (zero from zero-fill; re-stamp).
        xor rax, rax;
        mov_b [r13 + 5], rax;

        // u64 src_type_ref = row_type_ref (rbx) at [+8].
        mov [r13 + 8], rbx;

        // u64 dst_type_ref = field_type_pool_idx (r11) at [+16].
        mov [r13 + 16], r11;

        // Byte-copy field_name_len bytes from [rbp] to [r13 + 24 .. +24+len].
        xor rax, rax;                          // i = 0
      cxf_pd_copy_name_loop:
        cmp rax, r12;
        jae cxf_pd_copy_name_done;
        // byte_src = [rbp + i]
        mov r10, rbp;
        add r10, rax;
        xor r11, r11;
        mov_b r11, [r10];
        // byte_dst at [r13 + 24 + i]
        mov r10, r13;
        add r10, rax;
        mov_b [r10 + 24], r11;
        add rax, 1;
        jmp cxf_pd_copy_name_loop;

      cxf_pd_copy_name_done:
        // u64 reserved = 0 at [+56] already zero from zero-fill.

        // (11) Return CXF_OK.
        xor rax, rax;
        jmp cxf_pd_epilogue;

      cxf_pd_bad_ptr:
        mov rax, 0x6600;
        jmp cxf_pd_epilogue;

      cxf_pd_bad_name:
        mov rax, 0x6604;
        jmp cxf_pd_epilogue;

      cxf_pd_out_too_small:
        mov rax, 0x6605;
        jmp cxf_pd_epilogue;

      cxf_pd_unknown_field:
        mov rax, 0x6606;
        jmp cxf_pd_epilogue;

      cxf_pd_bad_row:
        mov rax, 0x6607;
        jmp cxf_pd_epilogue;

      cxf_pd_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cxf_check(ctxflow_record, record_len) -> status
  //
  //   rdi = ctxflow_record      -- ptr to a 64-byte CtxFlow record.
  //   rsi = record_len          -- caller-stated capacity, >= 64.
  //   rax = CXF_OK | CXF_ERR_*
  //
  // Flow:
  //   1. Validate ctxflow_record != 0 (BAD_PTR 0x6600).
  //   2. Validate record_len >= 64 (BAD_LEN 0x6608).
  //   3. Load u32 magic at [+0]; compare 'CTXF' (0x46585443);
  //      mismatch -> BAD_RECORD (0x6601).
  //   4. Load u8 direction at [+4]; validate in {0, 1}
  //      (BAD_DIRECTION 0x6602).
  //   5. Load u64 src_type_ref at [+8]; validate != 0
  //      (BAD_SRC_REF 0x660A).
  //   6. Load u64 dst_type_ref at [+16]; validate != 0
  //      (BAD_SRC_REF 0x660A -- same slot per the status taxonomy).
  //   7. Return CXF_OK.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cxf_ck_.
  // ==========================================================================
  pub let _cxf_check : (u64, u64) -> u64 !{mem} @{} =
    fn (ctxflow_record: u64) (record_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R225.M5 (#2686): _cxf_check validates a filled 64-byte CtxFlow record for magic + direction + non-null src/dst slots. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Entry rsp%16==8. Flow: (1) rdi (ctxflow_record) != 0 (BAD_PTR 0x6600); (2) rsi (record_len) >= 64 (BAD_LEN 0x6608); (3) load u32 magic via `xor rax,rax; mov_d rax,[rdi+0]`; compare with 0x46585443 'CTXF' LE, mismatch -> BAD_RECORD (0x6601); (4) load u8 direction via `xor rax,rax; mov_b rax,[rdi+4]`; validate in {0, 1} -- compare with 0 then 1 (either match -> continue; else BAD_DIRECTION 0x6602); (5) load u64 src_type_ref at [rdi+8]; compare != 0 (BAD_SRC_REF 0x660A); (6) load u64 dst_type_ref at [rdi+16]; compare != 0 (BAD_SRC_REF 0x660A -- shared slot per taxonomy); (7) return CXF_OK (0). 'CTXF' = 0x46585443 has bit 31 clear -- imm32 sign-safe. All cmp immediates (0, 1, 64, 0x46585443, 0x6600, 0x6601, 0x6602, 0x6608, 0x660A) fit imm32 with bit 31 clear. Byte loads via mov_b (zero-extends). u32 load via mov_d. u64 load via plain mov. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cxf_ck_.",
      block: {
        // (1) Validate ctxflow_record != 0.
        cmp rdi, 0;
        je  cxf_ck_bad_ptr;

        // (2) Validate record_len >= 64.
        cmp rsi, 64;
        jb  cxf_ck_bad_len;

        // (3) Load u32 magic at [+0]; compare 'CTXF'.
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x46585443;                   // CXF_RECORD_MAGIC
        jne cxf_ck_bad_record;

        // (4) Load u8 direction at [+4]; validate in {0, 1}.
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0;
        je  cxf_ck_direction_ok;
        cmp rax, 1;
        je  cxf_ck_direction_ok;
        jmp cxf_ck_bad_direction;

      cxf_ck_direction_ok:
        // (5) Load u64 src_type_ref at [+8]; validate != 0.
        mov rax, [rdi + 8];
        cmp rax, 0;
        je  cxf_ck_bad_src_ref;

        // (6) Load u64 dst_type_ref at [+16]; validate != 0.
        mov rax, [rdi + 16];
        cmp rax, 0;
        je  cxf_ck_bad_src_ref;

        // (7) Return CXF_OK.
        xor rax, rax;
        ret;

      cxf_ck_bad_ptr:
        mov rax, 0x6600;
        ret;

      cxf_ck_bad_record:
        mov rax, 0x6601;
        ret;

      cxf_ck_bad_direction:
        mov rax, 0x6602;
        ret;

      cxf_ck_bad_len:
        mov rax, 0x6608;
        ret;

      cxf_ck_bad_src_ref:
        mov rax, 0x660A;
        ret;
      }
    }

}
