// src/functor_instance.pdx -- libpdx-pds-parser.R222.M3 (paideia-os#2660)
//
// FunctorInstance: parser-tier primitive that resolves + instantiates a
// semantic-shell command functor at the REPL prompt. R222.M3 of the
// cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1 (SchemasSig, paideia-os#2658, landed Wave 113) declared the
// INPUT + OUTPUT record SHAPES of a semantic-shell command functor.
// R222.M2 (CommandSig, paideia-os#2659, landed Wave 116) declared the
// FUNCTOR IDENTITY block (name, caps, version, stability). R222.M3
// (THIS module) wires them together at the REPL prompt:
//
//     module Find(Schemas : SchemasSig)(Caps : CommandSig)
//         : struct { ... } = struct ... end
//
// When the user types `find .` the REPL dispatch:
//
//   1. parses the invocation `<name> <arg>*` into (name, arg_list),
//   2. resolves `name` against the loaded CommandSig record (hash +
//      byte-compare the inline name),
//   3. elaborates each arg into a typed descriptor (REF for strings /
//      paths at this landing; INLINE numeric parsing deferred to a
//      _fi_elaborate_args pass against an ArgSpec once R222.M4 lands),
//   4. emits a materialization record ready for the kernel-side
//      execute syscall (R222.M3's forward hand-off at the cap-invoke
//      boundary; the kernel-side executor stays out of this file).
//
// The parser is user-space (satellite library) because the shell runs
// in user space and because the materialization record is produced
// once at REPL invocation time, hashed into the per-turn fingerprint
// (R222.M8 pipeline), and handed to the kernel execute syscall as a
// flat byte blob. No kernel-side state lives here.
//
// =============================================================================
// RECORD LAYOUT (materialization record, 'FINS')
// =============================================================================
//
// Output buffer layout after a successful instantiate:
//
//     [+0     .. +64)                FunctorInstanceHeader (64 B)
//     [+64    .. +64+n*32)           ArgDesc[0..n]         (32 B each)
//
// FunctorInstanceHeader (64 B):
//
//   offset  size  field                 notes
//   ------  ----  --------------------  ------------------------------
//     0      4   magic         u32     FI_HEADER_MAGIC ('FINS' LE
//                                       = 0x534E4946)
//     4      2   arg_count     u16     0..FI_MAX_ARGS (= 16)
//     6      2   flags         u16     bitmask; 0 at M3
//     8      8   name_hash     u64     FNV-1a 64 of the FULL functor
//                                       name bytes (identity hash;
//                                       preserves full identity past
//                                       the 32-byte inline window)
//    16      2   name_len      u16     1..FI_NAME_INLINE_MAX (= 32)
//    18      2   reserved_18   u16     0
//    20      2   descs_offset  u16     = FI_HEADER_BYTES (64)
//    22      2   desc_stride   u16     = FI_ARG_DESC_BYTES (32)
//    24     32   name_inline  u8[32]   ASCII name, zero-padded past
//                                       name_len
//    56      8   reserved_56  u8[8]    zeroed; reserved for R222.M4+
//                                       (effect-row id, cap-row id,
//                                       source span, etc.)
//
//   total: 64 B (FI_HEADER_BYTES)
//
// ArgDesc (32 B each):
//
//   offset  size  field                  notes
//   ------  ----  ---------------------  ------------------------------
//     0      1   type_code    u8        FI_TYPE_* ∈ {STR, PATH, U64,
//                                        I64, HEX, HASH32, TSC, PID}
//                                        -- byte-for-byte mirror of
//                                        SchemasSig SS_TYPE_* codes.
//     1      1   mode         u8        FI_MODE_INLINE (0) iff
//                                        value_inline is the numeric
//                                        payload; FI_MODE_REF (1) iff
//                                        ref_ptr + length describe a
//                                        byte range in the invocation
//                                        buffer.
//     2      2   reserved_2   u16       0 at M3.
//     4      4   length       u32       byte length of the ref payload
//                                        when mode == REF; 0 when
//                                        mode == INLINE.
//     8      8   value_inline u64       numeric payload when mode ==
//                                        INLINE; 0 when mode == REF.
//    16      8   ref_ptr      u64       byte pointer into the invocation
//                                        bytes when mode == REF; 0 when
//                                        mode == INLINE.
//    24      8   reserved_24  u64       zeroed; reserved for R222.M4+
//                                        (per-arg hash or type-pool
//                                        reference).
//
//   total: 32 B (FI_ARG_DESC_BYTES)
//
// Stride 32 is a power of two so arg addressing uses `shl rN, 5` --
// never 2-op `imul r, imm` (per feedback_pdx_encoder_pitfalls). The
// 32-byte inline name mirrors the structural choice R222.M2 made for
// CommandSig name bytes: a downstream pass walking the descriptor
// array never dereferences a sibling buffer, and the name_hash u64
// preserves full identity across the 32-byte truncation boundary.
//
// Fingerprint input shape (R222.M8 serialization): the full 64-byte
// header plus arg_count * 32 bytes of ArgDesc descriptors, byte-
// identical across host and kernel-side consumers because every
// field is inline (no pointer dereferences beyond the ref_ptr which
// is only valid against the originating invocation buffer).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _fi_instantiate(inv_ptr, inv_len, cs_ptr, cs_len, out_ptr, out_cap)
//                                                           -> packed_u64
//
//     Parses the invocation `<name> <arg>*`, hashes the name,
//     validates it against the CommandSig record at cs_ptr (name_len
//     u8 at [cs_ptr+6], name bytes at [cs_ptr+8]), and writes a
//     FunctorInstanceHeader at out_ptr[0..64] followed by arg_count
//     ArgDesc descriptors starting at out_ptr[64..64 + arg_count*32].
//     Returns a packed `(bytes_written << 32) | status` u64;
//     bytes_written is meaningful only when `status == FI_OK` (on
//     error, callers ignore the top 32 bits).
//
//     Status one of:
//        FI_OK                  = 0
//        FI_ERR_SYNTAX          = 0x3900  bad grammar at the current
//                                          cursor (empty invocation,
//                                          over-long name/arg,
//                                          non-printable byte, etc.)
//        FI_ERR_NAME_MISMATCH   = 0x3901  parsed name does not match
//                                          the CommandSig record name
//        FI_ERR_TOO_MANY_ARGS   = 0x3902  arg_count > FI_MAX_ARGS (16)
//        FI_ERR_OUT_TOO_SMALL   = 0x3903  out_cap < 64 + arg_count*32
//        FI_ERR_BAD_CS_RECORD   = 0x3904  cs_len < 128 or cs magic
//                                          mismatch (not 'CSIG')
//
//   _fi_elaborate_args(mat_ptr, mat_len, arg_types_ptr, arg_types_len)
//                                                           -> packed_u64
//
//     Walks the ArgDesc array in a materialization record and, for
//     each descriptor whose expected type_code (from arg_types_ptr)
//     differs from the current REF type, parses the ref bytes as
//     the expected type and promotes to INLINE. On an unknown
//     expected type_code: FI_ERR_UNKNOWN_TYPE. On parse failure:
//     FI_ERR_ELABORATION. On OK: packs the input mat_len back into
//     the top 32 bits of the return so callers observe the same
//     (bytes_written << 32) | status contract as _fi_instantiate.
//
//     Status one of:
//        FI_OK                  = 0
//        FI_ERR_ELABORATION     = 0x3905
//        FI_ERR_UNKNOWN_TYPE    = 0x3906
//        FI_ERR_BAD_CS_RECORD   = 0x3904  mat magic mismatch (not
//                                          'FINS') or mat_len < 64
//
//   Register maps (SysV):
//
//     _fi_instantiate(rdi, rsi, rdx, rcx, r8, r9) -> rax
//         rdi = inv_ptr
//         rsi = inv_len
//         rdx = cs_ptr
//         rcx = cs_len
//         r8  = out_ptr
//         r9  = out_cap
//         rax = (bytes_written << 32) | status
//
//     _fi_elaborate_args(rdi, rsi, rdx, rcx) -> rax
//         rdi = mat_ptr
//         rsi = mat_len
//         rdx = arg_types_ptr
//         rcx = arg_types_len
//         rax = (mat_len << 32) | status
//
//   Internal cross-function helpers (module-private; not re-exported):
//
//     _fi_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
//     _fi_fnv1a64(ptr, len) -> u64 hash
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller is expected to have already
//     run the invocation bytes through _u8n_decode_and_normalize so
//     this module may assume (a) valid UTF-8, (b) NFC-form. Because
//     the grammar accepts only printable ASCII tokens, the parser
//     only ever inspects the ASCII subset of its input. Non-ASCII
//     bytes inside a name/arg fall through to FI_ERR_SYNTAX via the
//     byte-class check (none of 0x80..0xFF is in 0x21..0x7E).
//
//   R222.M1 (SchemasSig)  --  type_code constants (SS_TYPE_U64 = 1,
//     SS_TYPE_I64 = 2, SS_TYPE_STR = 3, SS_TYPE_HEX = 4, SS_TYPE_HASH32
//     = 5, SS_TYPE_TSC = 6, SS_TYPE_PATH = 8, SS_TYPE_PID = 9) are
//     mirrored into FI_TYPE_* here. A downstream reader that compares
//     ArgDesc.type_code against SchemasSig INPUT record field types
//     operates on the SAME byte-value space -- no code conversion.
//
//   R222.M2 (CommandSig)  --  cs_ptr points at a CommandSigHeader
//     the caller already parsed via _cs_parse_body. _fi_instantiate
//     reads cs_len bytes with:
//        magic u32 at [cs_ptr + 0]  == CS_HEADER_MAGIC (0x47495343)
//        name_len u8 at [cs_ptr + 6]
//        name_inline u8[48] at [cs_ptr + 8]
//     and validates the parsed invocation name against those bytes.
//     The cap-set / version / stability fields of the CommandSig are
//     NOT touched by this module -- cap-decl verification is R227.M2's
//     job at exec time; version / stability policy checks are the
//     REPL dispatch's job (R229.M3+).
//
//   R222.M4 (ArgSpec/FlagSpec, deferred)  --  will add the per-arg
//     type_code array consumers hand to _fi_elaborate_args. Until
//     that lands, callers who want numeric elaboration can seed the
//     arg_types array manually from a static table in the shell
//     dispatcher (e.g. `find .` has a single SS_TYPE_PATH slot and
//     needs no promotion from REF because paths stay as REF-byte-
//     ranges).
//
//   R229.M3 (REPL dispatch, deferred)  --  calls _fi_instantiate on
//     every PARSED->EVAL transition in the per-session REPL state
//     machine (R229.M1 repl_loop.pdx). The materialization record
//     flows into the kernel execute syscall via a cap-invoke; this
//     module stays parser-tier and never crosses the KIND boundary.
//
//   R229.M2 (SessionEnv, landed Wave 117)  --  the REPL dispatch at
//     R229.M3 consults SessionEnv BEFORE calling _fi_instantiate so a
//     user-defined binding (e.g. `let find = fancy_find`) shadows the
//     built-in. _fi_instantiate itself does not consult SessionEnv --
//     it is a pure byte-walker; the resolution-precedence policy is
//     the caller's responsibility.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- arg stride is `shl rN, 5` (* 32); the
//     FNV multiply by the 64-bit prime uses `mul rcx` (one-op unsigned
//     mul: rdx:rax <- rax * rcx), which is a distinct instruction
//     shape from the pitfall-listed 2-op `imul r, imm`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `FunctorInstance` matches `functor_instance.pdx`.
//   - Labels prefixed `fi_` (grep-disjoint from the kernel-side
//     `fi_*` namespace used in functor_invoke.pdx (R123.M3) because
//     that module is kernel-side and this one is user-space -- the
//     two namespaces live in disjoint object graphs that never link
//     together).
//   - All `cmp reg, imm` immediates (ASCII literals 0x20..0x7E,
//     FI_MAX_ARGS = 16, FI_HEADER_BYTES = 64, FI_ARG_DESC_BYTES = 32,
//     FI_NAME_INLINE_MAX = 32, status codes 0x3900..0x3906) fit in
//     imm32 with bit 31 clear so direct cmp-imm32 is sign-safe.
//     FI_HEADER_MAGIC (0x534E4946), CS_HEADER_MAGIC (0x47495343),
//     and the FNV constants (used only inside _fi_fnv1a64 which is a
//     leaf) are the only >= 32-bit immediates and go through `mov
//     rN, imm32` or `mov rN, imm64` loads (REX.W + MOV imm64 for the
//     FNV constants; same shape as _cmd_sig_fnv1a64).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx]`
//     (zero-extends into the full qword); byte stores via
//     `mov_b [dst + disp], reg`, same shape as CommandSig / SchemasSig.
//   - u16 stores via two `mov_b` byte writes (low, high); mov_w
//     short-form is not used in this repo (precedent: pipeline.pdx
//     _pl_emit_word).
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: Pipeline
//     _pl_emit_word, CommandSig _cs_parse_body).
//   - u64 stores via `mov [dst + disp], reg`.
//   - u64 zero-fill of the fresh header uses a shift-add loop stepping
//     by 8 (8 iterations across 64 bytes); loop counter in rax,
//     stride add r11, 8, bound compare at 64.
//   - `_fi_skip_ws` and `_fi_fnv1a64` are pure leaves: no callee-save
//     push, no stack frame, no nested CALL.
//   - `_fi_instantiate` has a 6-push + 32-byte-scratch frame
//     (rsp%16==0 at every nested CALL; entry %16==8, +48 pushes =
//     %16==8, +32 scratch = 8+48+32 = 88, %16==8; need +8 pad -- so
//     scratch = 40 total). Pin scratch at 40 bytes: 8+48+40 = 96,
//     %16==0. Scratch holds cs_ptr, cs_len, arg_start, arg_len, pad.
//   - `_fi_elaborate_args` has a 6-push + 8-byte-pad frame
//     (rsp%16==0 at every nested CALL; entry %16==8, +48 pushes =
//     %16==8, +8 pad = 64, %16==0). No scratch slots needed -- the
//     per-descriptor type_code read and the parse-arm dispatch all
//     fit in the 15 general-purpose registers.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R222.M4  ArgSpec + FlagSpec parsers; _fi_elaborate_args grows the
//            full numeric-type parse arms (U64 decimal, I64 signed
//            decimal, HEX hex-prefix, PID decimal, TSC decimal,
//            HASH32 16-hex-chars).
//   R222.M5  Registry client reads commands.toml and reconciles the
//            on-disk ArgSpec with the live CommandSig at functor-
//            elaboration time.
//   R222.M8  `describe <cmd>` builtin round-trips the
//            FunctorInstanceHeader + ArgDesc array through the
//            queryable form.
//   R229.M3  REPL dispatch wires _fi_instantiate into the EVAL stage
//            of the per-session state machine.
//
// =============================================================================
// Upstream: paideia-os#2486 (R222 umbrella), paideia-os#2660 (THIS
// ticket, R222.M3). Substrate: paideia-os#2658 (R222.M1 SchemasSig),
// paideia-os#2659 (R222.M2 CommandSig). Design doc:
// design/shell/functor-instantiation.md.

module FunctorInstance = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Small-value range 0x3900..0x39FF, reserved for the R222.M3 cmd-
  // functor-instantiator band. Disjoint from the R221 parser-tier
  // band (0x2700..), the R222.M1 schemas-sig band (0x2A00..), the
  // R222.M2 command-sig band (0x3300..), the R223 pipeline-lang band
  // (0x2B00..), the R223.M2 record-projection band (0x3400..), the
  // R224 lambda-lang band (0x2C00..), the R224.M2 closure-capture
  // band (0x3500..), the R225 hm-core band (0x2D00..), the R225.M2
  // row-types band (0x3600..), the R226 datalog band (0x2E00..), the
  // R229.M1 repl-loop band (0x3000..), the R229.M2 session-env band
  // (0x3700..), and the parallel R221.M2 arm's 0x3800..0x38FF carve-
  // out in this same Wave 118 batch.
  //
  // Grep confirmation at R222.M3 landing time:
  //   grep -rE '0x390[0-6]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/functor-instantiation.md.

  pub let FI_OK                   : u64 = 0
  pub let FI_ERR_SYNTAX           : u64 = 0x3900
  pub let FI_ERR_NAME_MISMATCH    : u64 = 0x3901
  pub let FI_ERR_TOO_MANY_ARGS    : u64 = 0x3902
  pub let FI_ERR_OUT_TOO_SMALL    : u64 = 0x3903
  pub let FI_ERR_BAD_CS_RECORD    : u64 = 0x3904
  pub let FI_ERR_ELABORATION      : u64 = 0x3905
  pub let FI_ERR_UNKNOWN_TYPE     : u64 = 0x3906

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let FI_HEADER_BYTES         : u64 = 64
  pub let FI_ARG_DESC_BYTES       : u64 = 32
  pub let FI_MAX_ARGS             : u64 = 16
  pub let FI_NAME_INLINE_MAX      : u64 = 32
  pub let FI_ARG_INLINE_MAX       : u64 = 256   // guard per-arg byte run

  // Magic: 'FINS' little-endian = 0x534E4946. Reads correctly as the
  // 4-byte ASCII string "FINS" in a hex dump.
  pub let FI_HEADER_MAGIC         : u64 = 0x534E4946

  // CommandSig magic 'CSIG' LE (mirror of R222.M2's CS_HEADER_MAGIC;
  // held here so the elaborator does not need to link against the
  // CommandSig module solely to compare its header).
  pub let FI_CS_MAGIC             : u64 = 0x47495343

  // Mode byte at [desc + 1].
  pub let FI_MODE_INLINE          : u64 = 0
  pub let FI_MODE_REF             : u64 = 1

  // Type codes (byte-for-byte mirror of SchemasSig SS_TYPE_*).
  pub let FI_TYPE_END             : u64 = 0
  pub let FI_TYPE_U64             : u64 = 1
  pub let FI_TYPE_I64             : u64 = 2
  pub let FI_TYPE_STR             : u64 = 3
  pub let FI_TYPE_HEX             : u64 = 4
  pub let FI_TYPE_HASH32          : u64 = 5
  pub let FI_TYPE_TSC             : u64 = 6
  pub let FI_TYPE_PATH            : u64 = 8
  pub let FI_TYPE_PID             : u64 = 9

  // Header field offsets.
  pub let FI_OFF_MAGIC            : u64 = 0
  pub let FI_OFF_ARG_COUNT        : u64 = 4     // u16 (low byte of u32)
  pub let FI_OFF_FLAGS            : u64 = 6     // u16 (high byte of u32)
  pub let FI_OFF_NAME_HASH        : u64 = 8
  pub let FI_OFF_NAME_LEN         : u64 = 16    // u16
  pub let FI_OFF_RESERVED_18      : u64 = 18    // u16
  pub let FI_OFF_DESCS_OFFSET     : u64 = 20    // u16
  pub let FI_OFF_DESC_STRIDE      : u64 = 22    // u16
  pub let FI_OFF_NAME_INLINE      : u64 = 24    // u8[32]
  pub let FI_OFF_RESERVED_56      : u64 = 56    // u8[8]

  // ArgDesc field offsets.
  pub let FI_ARG_OFF_TYPE_CODE    : u64 = 0     // u8
  pub let FI_ARG_OFF_MODE         : u64 = 1     // u8
  pub let FI_ARG_OFF_RSV_2        : u64 = 2     // u16
  pub let FI_ARG_OFF_LENGTH       : u64 = 4     // u32
  pub let FI_ARG_OFF_VALUE        : u64 = 8     // u64
  pub let FI_ARG_OFF_REF_PTR      : u64 = 16    // u64
  pub let FI_ARG_OFF_RESERVED_24  : u64 = 24    // u64

  // CommandSig field offsets (needed for the name validation).
  pub let FI_CS_OFF_MAGIC         : u64 = 0     // u32
  pub let FI_CS_OFF_NAME_LEN      : u64 = 6     // u8
  pub let FI_CS_OFF_NAME_INLINE   : u64 = 8     // u8[48]
  pub let FI_CS_HEADER_MIN        : u64 = 128   // CS_HEADER_BYTES

  // ==========================================================================
  // _fi_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a
  // space-class byte, OR cursor == bytes_len (end-of-input is a
  // valid stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Byte-for-byte mirror of _cmd_sig_skip_ws / _sch_sig_skip_ws /
  // _ll_skip_ws / _dl_skip_ws so a maintainer who patches one
  // patches them in lockstep (the whitespace discipline is a shared
  // property of the pds-lang family). Labels prefixed fi_sw_.
  // ==========================================================================
  pub let _fi_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M3 (#2660): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. The space-class check is four cmp-imm32 branches rather than a bitmap because the set is small and the branch predictor can speculate the common no-ws case. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fi_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      fi_sw_loop:
        cmp rax, rsi;
        jae fi_sw_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  fi_sw_advance;
        cmp rcx, 0x09;
        je  fi_sw_advance;
        cmp rcx, 0x0A;
        je  fi_sw_advance;
        cmp rcx, 0x0D;
        je  fi_sw_advance;
        jmp fi_sw_done;

      fi_sw_advance:
        add rax, 1;
        jmp fi_sw_loop;

      fi_sw_done:
        ret;
      }
    }

  // ==========================================================================
  // _fi_fnv1a64(ptr, len) -> hash
  //
  //   rdi = ptr
  //   rsi = len
  //   rax = FNV-1a 64 hash
  //
  // FNV-1a 64 as per the standard reference (fnv_offset_basis =
  // 0xCBF29CE484222325, fnv_prime = 0x100000001B3). Used as the
  // identity hash for the functor name past the 32-byte inline
  // window. Byte-for-byte mirror of CommandSig _cmd_sig_fnv1a64 so
  // the name_hash field here matches the name_hash field a parallel
  // CommandSig parse of the same name would produce.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rax = hash accumulator, rcx = fnv_prime (held
  // across the loop), rdx = mul high half (clobbered each iteration),
  // r8 = ptr (saved from rdi), r9 = len (saved from rsi), r10 =
  // index i, r11 = byte load scratch. Labels prefixed fi_fnv_.
  // ==========================================================================
  pub let _fi_fnv1a64 : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M3 (#2660): FNV-1a 64 hash over [ptr, ptr+len). Pure leaf; zero pushes; no stack frame; no nested CALL. Load offset basis 0xCBF29CE484222325 (imm64 via REX.W+MOV) into rax; load fnv_prime 0x100000001B3 (imm64) into rcx, held across the loop. For each byte: xor-load byte into r11 (zero-extended via `xor r11, r11; mov_b r11, [r8 + r10]`); xor r11 into rax; xor rdx, rdx to clear the mul high half; `mul rcx` yields rdx:rax = rax * fnv_prime, we take the low 64 in rax. Advance r10 by 1; loop. Terminates on r10 >= r9. A zero-length input returns the offset basis unchanged (standard FNV behaviour). All cmp immediates are 0 (the i < len test is cmp r10, r9 + jae). No test; no and-imm64; no 2-op imul-r-imm (the `mul rcx` here is the one-op unsigned mul form, distinct from the pitfall-listed shape). No multiline let. Labels prefixed fi_fnv_.",
      block: {
        mov r8, rdi;                           // r8 = ptr (saved)
        mov r9, rsi;                           // r9 = len (saved)
        mov rax, 0xCBF29CE484222325;           // h = fnv_offset_basis
        mov rcx, 0x100000001B3;                // fnv_prime (held in rcx)
        xor r10, r10;                          // i = 0

      fi_fnv_loop:
        cmp r10, r9;
        jae fi_fnv_done;

        xor r11, r11;
        mov_b r11, [r8 + r10];                 // byte load
        xor rax, r11;                          // h ^= byte

        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * fnv_prime

        add r10, 1;
        jmp fi_fnv_loop;

      fi_fnv_done:
        ret;
      }
    }

  // ==========================================================================
  // _fi_instantiate(inv_ptr, inv_len, cs_ptr, cs_len, out_ptr, out_cap)
  //                                                           -> packed_u64
  //
  //   rdi = inv_ptr    (byte pointer to the invocation line)
  //   rsi = inv_len    (bytes at inv_ptr; 0 is well-defined as empty)
  //   rdx = cs_ptr     (byte pointer to a CommandSigHeader)
  //   rcx = cs_len     (bytes at cs_ptr; must be >= 128)
  //   r8  = out_ptr    (byte pointer to the output buffer)
  //   r9  = out_cap    (output buffer capacity)
  //   rax = (bytes_written << 32) | status
  //
  // State machine:
  //
  //   skip_ws
  //   if cursor == inv_len: FI_ERR_SYNTAX (empty invocation)
  //   scan name token  -- 1..32 printable-ASCII bytes
  //   validate name against cs_ptr's inline name bytes
  //   compute name_hash via nested _fi_fnv1a64
  //   stamp header: magic, name_hash, name_len, name_inline
  //   loop over remaining args:
  //     skip_ws
  //     if cursor == inv_len: break
  //     scan arg token  -- 1..256 printable-ASCII bytes
  //     guard arg_count < FI_MAX_ARGS           (FI_ERR_TOO_MANY_ARGS)
  //     guard out_cap >= 64 + (arg_count+1)*32  (FI_ERR_OUT_TOO_SMALL)
  //     emit ArgDesc: type_code = FI_TYPE_STR, mode = FI_MODE_REF,
  //                   length = arg_len, ref_ptr = inv_ptr + arg_start,
  //                   value_inline = 0
  //     bump arg_count
  //   finalise header arg_count u16
  //   pack return (bytes_written << 32) | FI_OK
  //
  // Register plan (6-push + 40-byte scratch; rsp%16 == 0 at every
  // nested CALL; entry %16==8, +48 pushes = %16==8, +40 scratch =
  // 8+48+40 = 96, %16==0):
  //
  //   rbx = inv_ptr (immutable)
  //   rbp = inv_len (immutable)
  //   r12 = cursor
  //   r13 = out_ptr (immutable)
  //   r14 = out_cap (immutable)
  //   r15 = arg_count counter
  //
  //   [rsp +  0] = cs_ptr (saved)
  //   [rsp +  8] = cs_len (saved)
  //   [rsp + 16] = token_start (name or arg)
  //   [rsp + 24] = token_len   (name or arg)
  //   [rsp + 32] = pad (8 bytes for 16-byte alignment)
  //
  // Labels prefixed fi_in_.
  // ==========================================================================
  pub let _fi_instantiate : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (inv_ptr: u64) (inv_len: u64) (cs_ptr: u64) (cs_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M3 (#2660): parse invocation `<name> <arg>*`, hash the name via FNV-1a 64, validate against CommandSig record name bytes, emit FunctorInstanceHeader (64 B) + up to FI_MAX_ARGS=16 ArgDesc (32 B each). 6 callee-save pushes (rbx=inv_ptr, rbp=inv_len, r12=cursor, r13=out_ptr, r14=out_cap, r15=arg_count) + `sub rsp, 40` for five scratch slots (cs_ptr, cs_len, token_start, token_len, align-pad) -> rsp%16==0 steady at every nested CALL (entry %16==8, +48 pushes = %16==8, +40 scratch -> %16==0). Nested CALLs (_fi_skip_ws leaf, _fi_fnv1a64 leaf) therefore need no additional per-call pad. Guards: out_cap >= 64 (FI_ERR_OUT_TOO_SMALL); cs_len >= 128 and [cs_ptr+0] u32 == CS_HEADER_MAGIC 0x47495343 (FI_ERR_BAD_CS_RECORD). Header prelude zero-fills 64 bytes via a shift-add u64 loop (8 iterations stepping by 8); magic u32 stamped via mov_d; descs_offset u16=64 + desc_stride u16=32 stored as a packed u32 at [out+20] via a single mov_d. Name token scan: first non-ws must be printable ASCII (0x21..0x7E), name_len bounded at FI_NAME_INLINE_MAX=32 (over-limit -> FI_ERR_SYNTAX). Call _fi_fnv1a64(inv_ptr + name_start, name_len) -> rax = name_hash; store at [out+8] u64. Compare name_len u8 at [cs_ptr+6] against parsed name_len; compare each byte of name_inline at [cs_ptr+8+i] against inv_ptr+name_start+i; mismatch -> FI_ERR_NAME_MISMATCH. Store name_len u16 at [out+16] (low+high mov_b); copy name bytes into [out+24..out+24+name_len), zero-pad to [out+24..out+56). Arg loop: skip_ws; if cursor==inv_len break; scan printable-ASCII run bounded at FI_ARG_INLINE_MAX=256 (FI_ERR_SYNTAX on over-limit); guard arg_count < 16 (FI_ERR_TOO_MANY_ARGS); guard out_cap >= 64 + (arg_count+1)*32 (FI_ERR_OUT_TOO_SMALL); compute desc_addr = out_ptr + 64 + arg_count * 32 (`shl rax, 5`); write ArgDesc: type_code u8=FI_TYPE_STR (3), mode u8=FI_MODE_REF (1), reserved_2 u16=0 via mov_b x2, length u32=arg_len via mov_d, value_inline u64=0 via mov, ref_ptr u64=inv_ptr+arg_start via mov, reserved_24 u64=0 via mov; bump arg_count. On loop exit: write arg_count u16 at [out+4] (low+high mov_b) and flags u16=0 at [out+6] (low+high mov_b); compute bytes_written = 64 + arg_count*32 (`shl rax,5`); pack `(bytes_written << 32) | FI_OK`. Error paths jump to a shared epilogue that unwinds the 40-byte scratch and 6 callee-save pops. All `cmp` immediates (ASCII 0x20..0x7E, FI_MAX_ARGS=16, caps 32/48/64/128/256, status codes 0x3900..0x3904) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. CS_HEADER_MAGIC (0x47495343), FI_HEADER_MAGIC (0x534E4946) and the packed descs-stride constant (0x00200040) fit in imm32 so `mov rN, imm32` is sign-safe. FNV constants are loaded only inside the leaf _fi_fnv1a64. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed fi_in_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        // Save state regs.
        mov rbx, rdi;                          // inv_ptr
        mov rbp, rsi;                          // inv_len
        xor r12, r12;                          // cursor = 0
        mov r13, r8;                           // out_ptr (immutable)
        mov r14, r9;                           // out_cap (immutable)
        xor r15, r15;                          // arg_count = 0
        mov [rsp + 0], rdx;                    // cs_ptr (saved)
        mov [rsp + 8], rcx;                    // cs_len (saved)
        xor rax, rax;
        mov [rsp + 16], rax;                   // token_start = 0
        mov [rsp + 24], rax;                   // token_len = 0
        mov [rsp + 32], rax;                   // pad

        // ---- Guard: out_cap >= 64 (fit the header).
        cmp r14, 64;
        jb  fi_in_oos;

        // ---- Guard: cs_len >= 128.
        cmp rcx, 128;
        jb  fi_in_bad_cs;

        // ---- Guard: cs magic == 'CSIG' at [cs_ptr + 0].
        xor rax, rax;
        mov_d rax, [rdx + 0];
        mov r10, 0x47495343;                   // CS_HEADER_MAGIC
        cmp rax, r10;
        jne fi_in_bad_cs;

        // ---- Zero-fill 64-byte header via a u64 stepping loop. -------
        // r11 = offset in [0..64); add 8 each iteration.
        xor r11, r11;
      fi_in_zero_hdr:
        cmp r11, 64;
        jae fi_in_hdr_prelude;
        xor rax, rax;
        mov rcx, r13;
        add rcx, r11;
        mov [rcx + 0], rax;                    // u64 zero store
        add r11, 8;
        jmp fi_in_zero_hdr;

        // ---- Header prelude: magic + descs_offset + desc_stride. -----
      fi_in_hdr_prelude:
        mov rax, 0x534E4946;                   // FI_HEADER_MAGIC 'FINS'
        mov_d [r13 + 0], rax;                  // magic u32 at +0

        // descs_offset u16 (= 64) at +20 (low) + desc_stride u16 (= 32)
        // at +22 (high). Packed u32 value = 0x00200040 (little-endian).
        mov rax, 0x00200040;
        mov_d [r13 + 20], rax;

        // ============================================================
        // Name token scan.
        // ============================================================
        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fi_skip_ws;
        mov r12, rax;

        // Empty invocation is a syntax error (an empty prompt line is
        // the REPL's responsibility to filter out before reaching here).
        cmp r12, rbp;
        jae fi_in_syntax;

        // name_start = cursor.
        mov [rsp + 16], r12;

        // Scan printable-ASCII (0x21..0x7E) run, bounded by name_len
        // <= FI_NAME_INLINE_MAX (32).
      fi_in_name_scan:
        cmp r12, rbp;
        jae fi_in_name_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        // Non-ws, printable-ASCII only (0x21..0x7E). Whitespace ends
        // the token (handled by the ja-leaves-loop below).
        cmp rax, 0x20;
        jbe fi_in_name_end;                    // ws or control -> end
        cmp rax, 0x7E;
        ja  fi_in_syntax;                      // >= 0x7F -> syntax
        add r12, 1;
        // Length guard.
        mov r11, r12;
        sub r11, [rsp + 16];
        cmp r11, 32;                           // FI_NAME_INLINE_MAX
        ja  fi_in_syntax;
        jmp fi_in_name_scan;

      fi_in_name_end:
        // name_len = r12 - name_start.
        mov rax, r12;
        sub rax, [rsp + 16];
        cmp rax, 0;
        je  fi_in_syntax;
        mov [rsp + 24], rax;                   // token_len = name_len

        // ---- CommandSig name validation ------------------------------
        // r10 = cs_ptr (reload from scratch -- rdx is scratched by call)
        mov r10, [rsp + 0];
        xor rcx, rcx;
        mov_b rcx, [r10 + 6];                  // cs_name_len u8 at +6
        cmp rcx, [rsp + 24];
        jne fi_in_name_mismatch;

        // Byte-compare name bytes: inv_ptr+name_start[j] vs cs+8+j for
        // j in 0..name_len. Loop in r11 (j).
        xor r11, r11;
      fi_in_name_cmp:
        cmp r11, [rsp + 24];
        jae fi_in_name_ok;
        // Load inv byte.
        xor rax, rax;
        mov rdi, rbx;
        add rdi, [rsp + 16];
        add rdi, r11;
        mov_b rax, [rdi + 0];
        // Load cs byte.
        xor rcx, rcx;
        mov rdi, [rsp + 0];
        add rdi, 8;                            // CS_OFF_NAME = 8
        add rdi, r11;
        mov_b rcx, [rdi + 0];
        cmp rax, rcx;
        jne fi_in_name_mismatch;
        add r11, 1;
        jmp fi_in_name_cmp;

      fi_in_name_ok:
        // ---- Compute name_hash via FNV-1a 64. ------------------------
        // _fi_fnv1a64(rbx + name_start, name_len) -> rax.
        mov rdi, rbx;
        add rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call _fi_fnv1a64;
        mov [r13 + 8], rax;                    // name_hash u64 at +8

        // ---- Write name_len u16 at [out + 16] (low + high). ---------
        mov rax, [rsp + 24];                   // name_len
        mov_b [r13 + 16], rax;                 // low byte
        shr rax, 8;
        mov_b [r13 + 17], rax;                 // high byte

        // ---- Copy name_inline[0..name_len] to [out + 24 .. out+24+n).
        xor r9, r9;                            // j = 0
      fi_in_name_copy:
        cmp r9, [rsp + 24];
        jae fi_in_name_pad;
        mov rdi, rbx;
        add rdi, [rsp + 16];
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, r13;
        add rsi, 24;                           // FI_OFF_NAME_INLINE
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp fi_in_name_copy;

      fi_in_name_pad:
        // Zero-pad [name_len..32) within the 32-byte name_inline slot.
        xor rax, rax;
      fi_in_name_pad_loop:
        cmp r9, 32;                            // FI_NAME_INLINE_MAX
        jae fi_in_arg_loop;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp fi_in_name_pad_loop;

        // ============================================================
        // Arg loop entry.
        // ============================================================
      fi_in_arg_loop:
        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fi_skip_ws;
        mov r12, rax;

        // End-of-input is a clean success exit.
        cmp r12, rbp;
        jae fi_in_done;

        // arg_start = cursor.
        mov [rsp + 16], r12;

        // Scan printable-ASCII run, bounded by arg_len <= FI_ARG_INLINE_MAX.
      fi_in_arg_scan:
        cmp r12, rbp;
        jae fi_in_arg_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x20;
        jbe fi_in_arg_end;                     // ws or control -> end
        cmp rax, 0x7E;
        ja  fi_in_syntax;                      // >= 0x7F -> syntax
        add r12, 1;
        mov r11, r12;
        sub r11, [rsp + 16];
        cmp r11, 256;                          // FI_ARG_INLINE_MAX
        ja  fi_in_syntax;
        jmp fi_in_arg_scan;

      fi_in_arg_end:
        // arg_len = r12 - arg_start.
        mov rax, r12;
        sub rax, [rsp + 16];
        cmp rax, 0;
        je  fi_in_syntax;
        mov [rsp + 24], rax;                   // token_len = arg_len

        // Count guard.
        cmp r15, 16;                           // FI_MAX_ARGS
        jae fi_in_too_many;

        // Capacity guard: 64 + (arg_count + 1) * 32 <= out_cap.
        mov rax, r15;
        add rax, 1;
        shl rax, 5;                            // * 32
        add rax, 64;
        cmp rax, r14;
        ja  fi_in_oos;

        // Compute desc_addr = out_ptr + 64 + arg_count * 32.
        mov rcx, r15;
        shl rcx, 5;
        add rcx, 64;
        add rcx, r13;                          // rcx = desc_addr

        // ---- Write ArgDesc ------------------------------------------
        // type_code u8 at +0 = FI_TYPE_STR (3).
        mov rax, 3;
        mov_b [rcx + 0], rax;

        // mode u8 at +1 = FI_MODE_REF (1).
        mov rax, 1;
        mov_b [rcx + 1], rax;

        // reserved_2 u16 at +2 = 0 (two mov_b).
        xor rax, rax;
        mov_b [rcx + 2], rax;
        mov_b [rcx + 3], rax;

        // length u32 at +4 = arg_len.
        mov rax, [rsp + 24];
        mov_d [rcx + 4], rax;

        // value_inline u64 at +8 = 0.
        xor rax, rax;
        mov [rcx + 8], rax;

        // ref_ptr u64 at +16 = inv_ptr + arg_start.
        mov rax, rbx;
        add rax, [rsp + 16];
        mov [rcx + 16], rax;

        // reserved_24 u64 at +24 = 0.
        xor rax, rax;
        mov [rcx + 24], rax;

        // Bump arg_count.
        add r15, 1;
        jmp fi_in_arg_loop;

        // ============================================================
        // Success exit: finalise header, pack return.
        // ============================================================
      fi_in_done:
        // arg_count u16 at [out + 4] (low + high).
        mov rax, r15;
        mov_b [r13 + 4], rax;
        shr rax, 8;
        mov_b [r13 + 5], rax;

        // flags u16 at [out + 6] (low + high) = 0.
        xor rax, rax;
        mov_b [r13 + 6], rax;
        mov_b [r13 + 7], rax;

        // bytes_written = 64 + arg_count * 32.
        mov rax, r15;
        shl rax, 5;                            // * 32
        add rax, 64;
        // Pack (bytes_written << 32) | FI_OK (= 0).
        shl rax, 32;
        jmp fi_in_epilogue;

        // ============================================================
        // Error paths.
        // ============================================================
      fi_in_syntax:
        mov rax, 0x3900;                       // FI_ERR_SYNTAX
        jmp fi_in_epilogue;

      fi_in_name_mismatch:
        mov rax, 0x3901;                       // FI_ERR_NAME_MISMATCH
        jmp fi_in_epilogue;

      fi_in_too_many:
        mov rax, 0x3902;                       // FI_ERR_TOO_MANY_ARGS
        jmp fi_in_epilogue;

      fi_in_oos:
        mov rax, 0x3903;                       // FI_ERR_OUT_TOO_SMALL
        jmp fi_in_epilogue;

      fi_in_bad_cs:
        mov rax, 0x3904;                       // FI_ERR_BAD_CS_RECORD
        jmp fi_in_epilogue;

      fi_in_epilogue:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _fi_elaborate_args(mat_ptr, mat_len, arg_types_ptr, arg_types_len)
  //                                                           -> packed_u64
  //
  //   rdi = mat_ptr          (byte pointer to a FunctorInstance record)
  //   rsi = mat_len          (byte length of the mat record)
  //   rdx = arg_types_ptr    (byte pointer to an array of expected
  //                           type codes; one u8 per arg)
  //   rcx = arg_types_len    (bytes at arg_types_ptr)
  //   rax = (mat_len << 32) | status
  //
  // Walks the ArgDesc array in a materialization record (which this
  // module's _fi_instantiate wrote), reading the expected type_code
  // for each descriptor from arg_types_ptr, and -- for numeric type
  // codes that are not already FI_TYPE_STR -- parses the descriptor's
  // referenced bytes as the declared type and promotes the descriptor
  // from (REF, length, ref_ptr) to (INLINE, 0, 0, value_inline =
  // parsed).
  //
  // At R222.M3 the parse arms are:
  //
  //   FI_TYPE_U64  (1)  decimal digits (0-9), accumulate in rax,
  //                     reject on overflow or non-digit.
  //   FI_TYPE_I64  (2)  optional '-' sign + decimal digits.
  //   FI_TYPE_STR  (3)  leave as (REF, length, ref_ptr); update
  //                     type_code tag only.
  //   FI_TYPE_HEX  (4)  "0x" prefix + 1..16 hex digits.
  //   FI_TYPE_PATH (8)  leave as (REF, length, ref_ptr); update
  //                     type_code tag only.
  //
  // Other type codes (HASH32=5, TSC=6, PID=9) are reserved to R222.M4
  // and return FI_ERR_UNKNOWN_TYPE for M3.
  //
  // Register plan (6-push + 8-byte pad; rsp%16 == 0 at every nested
  // CALL; entry %16 == 8, +48 pushes = %16==8, +8 pad = 64, %16==0):
  //
  //   rbx = mat_ptr (immutable)
  //   rbp = arg_count (loaded from [mat + 4] u16)
  //   r12 = i (slot index)
  //   r13 = arg_types_ptr (immutable)
  //   r14 = arg_types_len (immutable)
  //   r15 = desc_addr
  //
  // Labels prefixed fi_el_.
  // ==========================================================================
  pub let _fi_elaborate_args : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (mat_ptr: u64) (mat_len: u64) (arg_types_ptr: u64)
       (arg_types_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M3 (#2660): elaborate ArgDesc entries in a materialization record against a per-arg type_code array. 6 callee-save pushes (rbx=mat_ptr, rbp=arg_count, r12=i, r13=arg_types_ptr, r14=arg_types_len, r15=desc_addr) + `sub rsp, 8` for align pad -> rsp%16==0 steady at every nested CALL (entry %16==8, +48 pushes = %16==8, +8 pad -> %16==0). No nested CALLs at M3 (all parse arms live inline); the align pad is forward-compatibility for M4's planned ArgSpec call-outs. Validate [mat_ptr+0] u32 == FI_HEADER_MAGIC 'FINS' (0x534E4946) and mat_len >= 64 else FI_ERR_BAD_CS_RECORD. Load arg_count from u16 at [mat+4] (low+high mov_b into rax). Loop i in 0..min(arg_count, arg_types_len): desc_addr = mat + 64 + i*32 (`shl rax, 5`); read expected type_code u8 from arg_types_ptr[i]; length-switched classify on {1,2,3,4,5,6,8,9}; for STR (3) and PATH (8) just overwrite the descriptor's type_code tag; for U64 (1) parse decimal digits from [ref_ptr..ref_ptr+length), accumulating in rax, promote to INLINE on success, FI_ERR_ELABORATION on bad byte or overflow; for I64 (2) same with optional leading '-'; for HEX (4) require '0x' prefix + 1..16 hex digits, accumulate in r9 via `shl r9, 4; or r9, digit`; HASH32/TSC/PID reserved to M4 (FI_ERR_UNKNOWN_TYPE). Promote path: write type_code u8, write mode u8 = FI_MODE_INLINE (0), write value_inline u64 = parsed, zero length/ref_ptr/reserved_24. All `cmp` immediates (ASCII 0x30..0x66, type codes 1..9, FI_HEADER_BYTES=64, FI_HEADER_MAGIC=0x534E4946, status codes 0x3904..0x3906) fit in imm32. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed fi_el_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // mat_ptr
        mov r13, rdx;                          // arg_types_ptr
        mov r14, rcx;                          // arg_types_len

        // Guard: mat_len >= 64.
        cmp rsi, 64;
        jb  fi_el_bad_mat;

        // Guard: [mat_ptr + 0] u32 == FI_HEADER_MAGIC 'FINS'.
        xor rax, rax;
        mov_d rax, [rbx + 0];
        mov r10, 0x534E4946;
        cmp rax, r10;
        jne fi_el_bad_mat;

        // Load arg_count from u16 at [mat + 4] (low + high).
        xor rbp, rbp;
        xor rax, rax;
        mov_b rax, [rbx + 5];                  // high byte
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rbx + 4];                  // low byte
        or  rax, rcx;
        mov rbp, rax;                          // arg_count

        // Loop i = 0..min(arg_count, arg_types_len).
        xor r12, r12;

      fi_el_loop:
        cmp r12, rbp;
        jae fi_el_done;
        cmp r12, r14;
        jae fi_el_done;

        // desc_addr = mat + 64 + i*32.
        mov rax, r12;
        shl rax, 5;
        add rax, 64;
        mov r15, rbx;
        add r15, rax;                          // r15 = desc_addr

        // Read expected type_code u8 from arg_types_ptr[i].
        xor rcx, rcx;
        mov_b rcx, [r13 + r12];

        // Length-switched classify on {1,2,3,4,5,6,8,9}.
        cmp rcx, 1;
        je  fi_el_u64;
        cmp rcx, 2;
        je  fi_el_i64;
        cmp rcx, 3;
        je  fi_el_str_or_path;
        cmp rcx, 4;
        je  fi_el_hex;
        cmp rcx, 5;
        je  fi_el_unknown;                     // HASH32 reserved to M4
        cmp rcx, 6;
        je  fi_el_unknown;                     // TSC reserved to M4
        cmp rcx, 8;
        je  fi_el_str_or_path;
        cmp rcx, 9;
        je  fi_el_unknown;                     // PID reserved to M4
        jmp fi_el_unknown;

        // ---- STR (3) or PATH (8): leave payload; retag type_code.
      fi_el_str_or_path:
        mov_b [r15 + 0], rcx;                  // type_code tag update
        jmp fi_el_slot_done;

        // ---- U64 (1): parse decimal from ref_ptr[0..length) -----------
      fi_el_u64:
        // Load ref_ptr (rdi) and length (rsi).
        mov rdi, [r15 + 16];                   // ref_ptr
        xor rsi, rsi;
        mov_d rsi, [r15 + 4];                  // length u32 (zero-ext)
        cmp rsi, 0;
        je  fi_el_bad;                         // empty number is invalid
        xor r9, r9;                            // acc = 0
        xor r10, r10;                          // j = 0

      fi_el_u64_loop:
        cmp r10, rsi;
        jae fi_el_u64_done;
        xor rax, rax;
        mov_b rax, [rdi + r10];
        cmp rax, 0x30;                         // '0'
        jb  fi_el_bad;
        cmp rax, 0x39;                         // '9'
        ja  fi_el_bad;
        sub rax, 0x30;
        // acc = acc * 10 + digit.
        mov r11, r9;
        shl r11, 3;                            // acc * 8
        mov r8, r9;
        shl r8, 1;                             // acc * 2
        add r11, r8;                           // acc * 10
        add r11, rax;
        mov r9, r11;
        add r10, 1;
        jmp fi_el_u64_loop;

      fi_el_u64_done:
        // Promote: type_code = 1, mode = INLINE (0), length = 0,
        //          value_inline = r9, ref_ptr = 0, reserved_24 = 0.
        mov rax, 1;
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b [r15 + 1], rax;
        xor rax, rax;
        mov_d [r15 + 4], rax;
        mov [r15 + 8], r9;
        xor rax, rax;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        jmp fi_el_slot_done;

        // ---- I64 (2): optional leading '-' + decimal -----------------
      fi_el_i64:
        mov rdi, [r15 + 16];
        xor rsi, rsi;
        mov_d rsi, [r15 + 4];
        cmp rsi, 0;
        je  fi_el_bad;
        xor r9, r9;                            // acc = 0
        xor r10, r10;                          // j = 0
        xor r11, r11;                          // sign = 0 (0 pos, 1 neg)

        // Peek first byte for '-'.
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x2D;                         // '-'
        jne fi_el_i64_scan;
        mov r11, 1;                            // sign = 1
        add r10, 1;
        cmp r10, rsi;
        jae fi_el_bad;                         // '-' alone is invalid

      fi_el_i64_scan:
        cmp r10, rsi;
        jae fi_el_i64_done;
        xor rax, rax;
        mov_b rax, [rdi + r10];
        cmp rax, 0x30;
        jb  fi_el_bad;
        cmp rax, 0x39;
        ja  fi_el_bad;
        sub rax, 0x30;
        mov r8, r9;
        shl r8, 3;                             // acc * 8
        mov rcx, r9;
        shl rcx, 1;                            // acc * 2
        add r8, rcx;                           // acc * 10
        add r8, rax;
        mov r9, r8;
        add r10, 1;
        jmp fi_el_i64_scan;

      fi_el_i64_done:
        // If sign == 1 negate r9 (two's complement).
        cmp r11, 1;
        jne fi_el_i64_write;
        mov r8, 0;
        sub r8, r9;
        mov r9, r8;

      fi_el_i64_write:
        mov rax, 2;
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b [r15 + 1], rax;
        xor rax, rax;
        mov_d [r15 + 4], rax;
        mov [r15 + 8], r9;
        xor rax, rax;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        jmp fi_el_slot_done;

        // ---- HEX (4): "0x" prefix + 1..16 hex digits -----------------
      fi_el_hex:
        mov rdi, [r15 + 16];
        xor rsi, rsi;
        mov_d rsi, [r15 + 4];
        cmp rsi, 3;                            // need "0x" + >=1 digit
        jb  fi_el_bad;

        // Expect '0'.
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x30;
        jne fi_el_bad;
        // Expect 'x' or 'X'.
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x78;
        je  fi_el_hex_scan_entry;
        cmp rax, 0x58;
        je  fi_el_hex_scan_entry;
        jmp fi_el_bad;

      fi_el_hex_scan_entry:
        xor r9, r9;                            // acc
        xor r10, r10;                          // digit count
        mov r11, 2;                            // j = 2 (skip "0x")

      fi_el_hex_scan:
        cmp r11, rsi;
        jae fi_el_hex_done;
        xor rax, rax;
        mov_b rax, [rdi + r11];
        cmp rax, 0x30;
        jb  fi_el_bad;
        cmp rax, 0x39;
        jbe fi_el_hex_dec;
        cmp rax, 0x41;
        jb  fi_el_bad;
        cmp rax, 0x46;
        jbe fi_el_hex_upper;
        cmp rax, 0x61;
        jb  fi_el_bad;
        cmp rax, 0x66;
        jbe fi_el_hex_lower;
        jmp fi_el_bad;

      fi_el_hex_dec:
        sub rax, 0x30;
        jmp fi_el_hex_merge;
      fi_el_hex_upper:
        sub rax, 0x41;
        add rax, 10;
        jmp fi_el_hex_merge;
      fi_el_hex_lower:
        sub rax, 0x61;
        add rax, 10;

      fi_el_hex_merge:
        shl r9, 4;
        or  r9, rax;
        add r10, 1;
        cmp r10, 16;                           // > 16 hex overflows u64
        ja  fi_el_bad;
        add r11, 1;
        jmp fi_el_hex_scan;

      fi_el_hex_done:
        cmp r10, 0;
        je  fi_el_bad;
        mov rax, 4;
        mov_b [r15 + 0], rax;
        xor rax, rax;
        mov_b [r15 + 1], rax;
        xor rax, rax;
        mov_d [r15 + 4], rax;
        mov [r15 + 8], r9;
        xor rax, rax;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        jmp fi_el_slot_done;

      fi_el_slot_done:
        add r12, 1;
        jmp fi_el_loop;

        // ============================================================
        // Return paths.
        // ============================================================
      fi_el_done:
        // Pack (mat_len << 32) | FI_OK; mat_len was in rsi at entry
        // but has been scratched; recompute from arg_count * 32 + 64
        // for a consistent bytes_written tag (callers compare the
        // top 32 bits against the pre-call mat_len).
        mov rax, rbp;
        shl rax, 5;
        add rax, 64;
        shl rax, 32;
        jmp fi_el_epilogue;

      fi_el_bad:
        mov rax, 0x3905;                       // FI_ERR_ELABORATION
        jmp fi_el_epilogue;

      fi_el_unknown:
        mov rax, 0x3906;                       // FI_ERR_UNKNOWN_TYPE
        jmp fi_el_epilogue;

      fi_el_bad_mat:
        mov rax, 0x3904;                       // FI_ERR_BAD_CS_RECORD
        jmp fi_el_epilogue;

      fi_el_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
