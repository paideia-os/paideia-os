// src/utf8_nfc.pdx -- libpdx-pds-parser.M1 (paideia-os#2651, R221.M1)
//
// Utf8Nfc: parser-tier UTF-8 decoder + NFC normalizer wrapper, tuned
// for the pds-lang / semantic-shell parser call site.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx parser-tier wrapper over
// libpdx-unicode-tables's R131.M1 UTF-8 primitives and R131.M3 NFC
// normaliser. Where libpdx-unicode-tables exposes a byte-level codec
// surface (`utf8_decode_cp` for one scalar at a time, `_norm_nfc` for
// a bulk normalise, `_ipc_nfc_check` for IPC-boundary presence
// detection), THIS module exposes exactly the two entry points the
// shell / pds-lang parser needs:
//
//   _u8n_decode_and_normalize(bytes_ptr, bytes_len, out_ptr, out_cap)
//       -> packed_u64        (bytes_written << 32) | status
//   _u8n_quick_check_ascii  (bytes_ptr, bytes_len)
//       -> u64               1 iff every byte < 0x80, else 0
//
// `_u8n_decode_and_normalize` first calls `_u8n_quick_check_ascii`.
// On a pure-ASCII input (every byte < 0x80), it does a byte-for-byte
// copy from input to output -- correct because every ASCII code point
// is a trivially-well-formed 1-byte UTF-8 scalar AND a fixed point of
// NFC (no U+0000..U+007F code point has a canonical decomposition in
// the UCD, nor participates as the mark of any such decomposition).
// On a non-ASCII input, it delegates to M3's `_norm_nfc`, which
// validates UTF-8 internally and emits the NFC-form bytes. The slow
// path translates M3's three-value status (0=OK, 1=OUT_TOO_SMALL,
// 2=INVALID_UTF8) into this module's four-value U8N_* taxonomy.
//
// =============================================================================
// FAST-PATH HEURISTIC
// =============================================================================
//
// `_u8n_quick_check_ascii` is a single-pass byte scan, O(bytes_len),
// no table loads, no nested calls. Scan rule:
//
//     for each byte b in [bytes_ptr, bytes_ptr + bytes_len):
//         if b >= 0x80:
//             return is_ascii=0
//     return is_ascii=1
//
// A zero-length input returns is_ascii=1 (the empty sequence is
// vacuously ASCII and vacuously NFC).
//
// Shape parallel to IpcNfc::_ipc_nfc_check: both return a single-bit
// boolean through a u64 register, both are pure leaves, both O(n).
// The difference is the scan rule:
//
//   * _ipc_nfc_check returns is_nfc=0 on any byte equal to 0xCC or
//     0xCD (combining-marks lead-byte presence check -- a
//     conservative is-already-NFC predicate across the full
//     user-space Unicode text surface).
//
//   * _u8n_quick_check_ascii returns is_ascii=0 on any byte >= 0x80
//     (true-ASCII predicate -- a tighter check that is correct for
//     the parser's hot path specifically because ASCII input is
//     always both valid UTF-8 and already-NFC).
//
// Why ASCII and not 0xCC/0xCD at the parser call site:
//
//   * The parser's input is dominated by pipeline tokens, builtin
//     names, keywords, and ASCII path components. The <5%
//     non-ASCII fraction of typical pds input is in identifiers
//     and user-authored strings.
//   * ASCII-pass is strictly STRONGER than 0xCC/0xCD-absence: it
//     gates BOTH the full UTF-8 validator AND the NFC pass, where
//     the IPC heuristic gates only the NFC pass (and still runs
//     the validator inside _norm_nfc).
//   * A single `cmp byte, 0x80; jae ...` per byte is cheaper than
//     the two-cmp sequence `_ipc_nfc_check` uses.
//
// =============================================================================
// FALSE-NEGATIVE / FALSE-POSITIVE ANALYSIS
// =============================================================================
//
// `_u8n_quick_check_ascii` is EXACT at R221.M1. The predicate "every
// byte < 0x80" is both necessary and sufficient for "the input is
// ASCII" by RFC 3629 §3 definition.
//
// `_u8n_decode_and_normalize` is correct in both branches:
//
//   Fast branch (is_ascii=1):
//     The input is ASCII, so:
//       (a) It is RFC 3629 §3 well-formed UTF-8 (every byte is a
//           complete 1-byte scalar in 0x00..0x7F).
//       (b) It is already in NFC (no U+0000..U+007F code point has
//           a canonical decomposition in the UCD, nor appears as
//           the mark of any such decomposition -- every M3 decomp
//           mark is in U+0300..U+036F).
//     So copying bytes_len bytes from input to output IS the NFC
//     transform. The fast branch cannot false-positive -- it never
//     reports U8N_OK on an input that is not actually NFC-form.
//
//   Slow branch (is_ascii=0):
//     Delegates to _norm_nfc, which handles every well-formed UTF-8
//     input (including inputs whose non-ASCII prefix is immediately
//     followed by ASCII; the substrate makes no shortcut on
//     "mostly ASCII"). There is no correctness loss on partial-
//     ASCII input, only the slow-path cost of the UTF-8 pass on
//     bytes the fast path could not shortcut.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// `_u8n_quick_check_ascii` -> u64:
//
//   rax = 1  (every byte in [bytes_ptr, bytes_ptr+bytes_len) is
//             strictly less than 0x80, OR bytes_len == 0)
//   rax = 0  (at least one byte >= 0x80 was seen before end-of-input)
//
// `_u8n_decode_and_normalize` -> packed_u64:
//
//   bits [63:32]  bytes_written    (0 on failure; >0 on success)
//   bits [31:0]   status           one of U8N_* below
//
//     U8N_OK                 = 0        normalise succeeded; bytes_written
//                                       carries NFC byte count.
//     U8N_ERR_INVALID_UTF8   = 0x2700   input is not RFC 3629 well-formed.
//     U8N_ERR_OUT_TOO_SMALL  = 0x2701   out_cap < NFC output byte count.
//     U8N_ERR_NORMALIZE_FAIL = 0x2702   reserved for post-M1 normaliser-
//                                       internal failure; never returned
//                                       at M1 since _norm_nfc's status
//                                       taxonomy at R131.M3 is exhaustively
//                                       in {0,1,2}.
//
// =============================================================================
// STATUS-CODE NAMESPACE
// =============================================================================
//
// The U8N_* codes live in a small-value range (0x2700..0x27FF) that
// is deliberately NOT inside any user-space 0xFFFFExxx error-band
// slice taken by libpdx-unicode-tables (M1 utf8 at 0xFFFFE700..70F,
// M2 grapheme at 0xFFFFE710..71F, M3 normalize at 0xFFFFE720..72F,
// M4 collation at 0xFFFFE730..73F, M5 width at 0xFFFFE750..75F, M6
// bidi at 0xFFFFE760..76F, M7 locale at 0xFFFFE770..77F, M8 ipc-nfc
// at 0xFFFFE780..78F). Rationale:
//
//   * The U8N_* codes are a PACKED-RETURN status field, always in
//     the low 32 bits of a 64-bit packed value. They are
//     discriminated by position (bits [31:0] of the packed shape),
//     not by band magnitude.
//
//   * Keeping the codes small means a caller doing `and rN, 0xFF`
//     (or an `and rN, 0xFFFFFFFF` 32-bit mask on the status half)
//     for status gets a plain switch-safe value without needing a
//     MOVABS comparison against a 0xFFFFExxx band.
//
//   * 0x2700..0x27FF is the reserved parser-tier packed-status
//     range (future R221 milestones). It is disjoint from every
//     other packed-status byte in the paideia-os tree:
//
//       - M3 _norm_nfc status: 0..2 (low 8 bits).
//       - M8 _ipc_nfc_check status: always 0.
//       - R131 user-space error band: 0xFFFFE700..0xFFFFE7FF (large).
//       - Shell dispatch ret bands: 0xFFFFEC/ED/EB.
//
// Grep confirmation at R221.M1 landing time:
//
//   grep -rE '0x2(7)0[0-9A-F]' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this module.
//
// =============================================================================
// CROSS-MODULE LINKAGE
// =============================================================================
//
// Entry-point `_u8n_decode_and_normalize` calls `_norm_nfc` from the
// Normalize module of libpdx-unicode-tables (R131.M3). This resolves
// at link time via the standard `--extra-obj-dir` pointing at
// libpdx-unicode-tables's build-out directory, matching the shape the
// three r64v2 tools already use for libpdx-volume / libpdx-audit.
//
// No new KIND surface, no new syscall, no new ambient service.
// Entry-point `_u8n_quick_check_ascii` is a pure leaf with no nested
// call -- it can be linked standalone.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the two mask operations use imm32-safe
//     values (0xFF for status extraction; the ASCII threshold 0x80
//     is used only via `cmp reg, imm32`, not `and`).
//   - No 2-op `imul r, imm` -- not used; the scan advances
//     `add rcx, 1`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `Utf8Nfc` matches `utf8_nfc.pdx`.
//   - Labels prefixed `u8n_` (never `loop`/`if`/`let`/`fn`/`ret` --
//     reserved).
//   - All `cmp reg, imm` immediates <= 0x2702 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging.
//   - All byte loads via `mov_b` (zero-extends into the full qword);
//     byte stores via `mov_b [dst + idx], reg` (register-indexed
//     byte store, same shape as libpdx-audit's audit_file_sink).
//   - `_u8n_quick_check_ascii` is a pure leaf: no callee-save push,
//     no stack frame, no nested CALL.
//   - `_u8n_decode_and_normalize` is NOT a pure leaf: it has a
//     prologue of four pushes (rbx, r12, r13, r14) plus a `sub rsp,
//     8` for CALL alignment, giving 40 bytes of frame; the four
//     callee-save slots carry the four entry-point args across both
//     possible nested calls (`_u8n_quick_check_ascii` and
//     `_norm_nfc`). The epilogue is `add rsp, 8; pop r14; pop r13;
//     pop r12; pop rbx; ret`.
//   - No `add reg, [mem]` anywhere.
//   - Entry rsp%16==8 preserved per SysV; four pushes keep rsp%16==8,
//     the one `sub rsp, 8` brings it to 0 for both nested CALLs,
//     and the epilogue `add rsp, 8` restores rsp%16==8 before the
//     four pops and ret.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R221.M2  TR#29 grapheme cluster boundary iterator over this
//            module's output bytes (consumes libpdx-unicode-tables
//            R131.M2 `_gc_next`).
//   R221.M3  TR#11 width table for cursor/column math.
//   R221.M4  Context-tracking lexer that walks this module's output
//            buffer at the token boundary.
//   R221.M5  Unified AST sum type consuming the token stream.
//   R221.M6  Span-emitting sibling entry point
//            (`_u8n_decode_and_normalize_with_map`) for LSP
//            diagnostics that need pre-NFC byte spans. The M1
//            contract remains the fast API; the span-emitting
//            variant is a superset for callers that need it.
//   R221.M7  Parser-side fuzz corpus (shares this module's error
//            band for parse-time rejection taxonomies).
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2651 (THIS
// ticket, R221.M1). Substrate: paideia-os#2612 (R131.M1 UTF-8),
// paideia-os#2614 (R131.M3 normalize). Design doc:
// design/shell/parser-utf8-nfc.md.

module Utf8Nfc = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Small-value range 0x2700..0x27FF, reserved for parser-tier
  // packed-status codes across R221. Disjoint from every user-space
  // error band in paideia-os (see module header).

  pub let U8N_OK                 : u64 = 0
  pub let U8N_ERR_INVALID_UTF8   : u64 = 0x2700
  pub let U8N_ERR_OUT_TOO_SMALL  : u64 = 0x2701
  pub let U8N_ERR_NORMALIZE_FAIL : u64 = 0x2702

  // ==========================================================================
  // SECTION 2 -- is_ascii CONSTANTS (returned in rax by _u8n_quick_check_ascii)
  // ==========================================================================
  //
  // Boolean-shaped: 0 means "the scan found at least one byte with
  // bit 7 set"; 1 means "every byte in [bytes_ptr, bytes_ptr +
  // bytes_len) is strictly < 0x80, OR bytes_len was 0".

  pub let U8N_NOT_ASCII : u64 = 0
  pub let U8N_IS_ASCII  : u64 = 1

  // ==========================================================================
  // SECTION 3 -- PACK-SHAPE CONSTANTS
  // ==========================================================================
  //
  // The packed_u64 return of `_u8n_decode_and_normalize` places
  // bytes_written in bits [63:32] and status in bits [31:0]. The
  // shift immediates below are only documentation -- the body uses
  // `shl rax, 32` directly.

  pub let U8N_BYTES_SHIFT : u64 = 32   // bits [63:32] = bytes_written

  // ==========================================================================
  // _u8n_quick_check_ascii(bytes_ptr, bytes_len) -> u64
  //
  //   rdi = bytes_ptr      (pointer to the first payload byte)
  //   rsi = bytes_len      (length in bytes; 0 is well-defined and
  //                         returns is_ascii=1 immediately)
  //   rax = is_ascii       1 iff every byte < 0x80, else 0
  //
  // Pure leaf. No callee-save push, no stack frame. All scratch is
  // caller-save (rax, rcx). Labels prefixed u8n_chk_.
  //
  // Scan loop:
  //
  //   rcx = 0 (cursor)
  //   loop:
  //     if rcx >= rsi: return 1
  //     byte = [rdi + rcx]
  //     if byte >= 0x80: return 0
  //     rcx += 1
  //     goto loop
  //
  // The `cmp rax, 0x80; jae ...` compares the zero-extended byte
  // (0..0xFF) against 0x80 as imm32. 0x80 is a positive imm32 that
  // sign-extends to 0x0000000000000080 under REX.W, so the
  // comparison is sign-safe without MOVABS staging.
  // ==========================================================================
  pub let _u8n_quick_check_ascii : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.M1 (#2651): _u8n_quick_check_ascii scans the byte range for any byte with bit 7 set (>= 0x80). Any hit returns is_ascii=0; otherwise returns is_ascii=1. A zero-length input returns is_ascii=1 (vacuously ASCII). Pure leaf; no callee-save push; no stack frame; no nested CALL. The one `cmp rax, 0x80` immediate is positive imm32 so direct cmp-imm32 is sign-extension-safe. Byte load via mov_b (zero-extends into full qword, so the 0..0xFF range of the loaded byte never has bit 63 set). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed u8n_chk_.",
      block: {
        // rcx = i = 0 (byte cursor).
        xor rcx, rcx;

      u8n_chk_loop:
        // Loop termination: i >= bytes_len -> all bytes were ASCII.
        cmp rcx, rsi;
        jae u8n_chk_ascii;

        // Load the current byte, zero-extended into rax.
        mov_b rax, [rdi + rcx];

        // Any byte with bit 7 set exits the fast path.
        cmp rax, 0x80;
        jae u8n_chk_not_ascii;

        // Advance cursor and repeat.
        add rcx, 1;
        jmp u8n_chk_loop;

      u8n_chk_ascii:
        // All bytes < 0x80 (or bytes_len == 0) -> is_ascii=1.
        mov rax, 1;
        ret;

      u8n_chk_not_ascii:
        // At least one byte >= 0x80 -> is_ascii=0.
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _u8n_decode_and_normalize(bytes_ptr, bytes_len, out_ptr, out_cap)
  //     -> packed_u64
  //
  //   rdi = bytes_ptr      (pointer to the first input byte)
  //   rsi = bytes_len      (input length in bytes)
  //   rdx = out_ptr        (pointer to the output buffer)
  //   rcx = out_cap        (output buffer capacity, in bytes)
  //   rax = (bytes_written << 32) | status
  //         status in {U8N_OK, U8N_ERR_INVALID_UTF8,
  //                    U8N_ERR_OUT_TOO_SMALL, U8N_ERR_NORMALIZE_FAIL}
  //
  // Control flow:
  //
  //   1. Prologue: push rbx/r12/r13/r14 (callee-save); sub rsp, 8 for
  //      CALL alignment. Save the four entry-point args into those
  //      four callee-save regs so they survive both possible nested
  //      calls (the ASCII check first, then possibly _norm_nfc).
  //        rbx = bytes_ptr
  //        r12 = bytes_len
  //        r13 = out_ptr
  //        r14 = out_cap
  //   2. Call _u8n_quick_check_ascii(bytes_ptr, bytes_len) -- rdi,
  //      rsi already carry the right args, nothing to shuffle.
  //      rax = 1 (fast) or 0 (slow).
  //   3. Fast branch (rax == 1):
  //      a. Check out_cap >= bytes_len (r12 <= r14). If r12 > r14
  //         then the output buffer cannot hold the copy, return
  //         U8N_ERR_OUT_TOO_SMALL.
  //      b. Copy loop: for i in 0..bytes_len, out[i] = src[i].
  //      c. Return (bytes_len << 32) | U8N_OK.
  //   4. Slow branch (rax == 0):
  //      a. Restore the four args into rdi/rsi/rdx/rcx from
  //         rbx/r12/r13/r14.
  //      b. Call _norm_nfc. rax = (out_bytes << 32) | status3
  //         with status3 in {0, 1, 2}.
  //      c. Extract status3 = rax & 0xFF, map to U8N_*:
  //           0 -> U8N_OK (rax is already in the right packed shape)
  //           1 -> U8N_ERR_OUT_TOO_SMALL (zero bytes_written)
  //           2 -> U8N_ERR_INVALID_UTF8 (zero bytes_written)
  //           other (unreachable at M1) -> U8N_ERR_NORMALIZE_FAIL
  //   5. Epilogue: add rsp, 8; pop r14; pop r13; pop r12; pop rbx; ret.
  //
  // Labels prefixed u8n_dnn_.
  // ==========================================================================
  pub let _u8n_decode_and_normalize : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.M1 (#2651): _u8n_decode_and_normalize parser-tier entry point. Prologue pushes rbx/r12/r13/r14 and sub rsp 8 (40-byte frame; rsp%16==0 pre-CALL). Saves the 4 args into those four callee-save regs so they survive both nested CALLs. Calls _u8n_quick_check_ascii (no arg shuffle; rdi/rsi already correct). On rax==1 (fast / ASCII), checks out_cap>=bytes_len (returns U8N_ERR_OUT_TOO_SMALL if not), then byte-loops out[i]=src[i] via mov_b load + mov_b store (register-indexed, same shape as libpdx-audit audit_file_sink and libpdx-argv schema_emit). Returns (bytes_len<<32)|U8N_OK. On rax==0 (slow / non-ASCII), restores args from the four callee-save slots into rdi/rsi/rdx/rcx and tail-call-shaped calls _norm_nfc (identical 4-arg surface). Translates _norm_nfc status (and rdx, 0xFF uses imm32-safe mask) to U8N_*: 0->U8N_OK (packed shape passes through), 1->U8N_ERR_OUT_TOO_SMALL, 2->U8N_ERR_INVALID_UTF8, otherwise U8N_ERR_NORMALIZE_FAIL. Epilogue restores callee-save in reverse push order. All cmp immediates <= 0x2702 < 0x80000000 so direct cmp-imm32 is sign-safe; the 0x80 ASCII threshold and 0xFF status mask are both imm32-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed u8n_dnn_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;             // align rsp%16 to 0 for CALL

        // Save args into callee-save regs.
        mov rbx, rdi;           // bytes_ptr
        mov r12, rsi;           // bytes_len
        mov r13, rdx;           // out_ptr
        mov r14, rcx;           // out_cap

        // ---- Call _u8n_quick_check_ascii(bytes_ptr, bytes_len) ---------
        // rdi, rsi already carry the right args from the entry-point
        // calling convention.
        call _u8n_quick_check_ascii;

        // rax = 1 (ASCII) or 0 (not ASCII).
        cmp rax, 0;
        je  u8n_dnn_slow;

        // ---- Fast path (ASCII) -----------------------------------------
        // Check out_cap >= bytes_len. If r12 > r14, the output buffer
        // cannot hold the ASCII copy.
        cmp r12, r14;
        ja  u8n_dnn_fast_too_small;

        // Copy loop: for i in 0..bytes_len, out[i] = src[i].
        // Uses rcx as the cursor; rax as the byte-load destination.
        xor rcx, rcx;

      u8n_dnn_fast_copy:
        cmp rcx, r12;
        jae u8n_dnn_fast_done;
        mov_b rax, [rbx + rcx];
        mov_b [r13 + rcx], rax;
        add rcx, 1;
        jmp u8n_dnn_fast_copy;

      u8n_dnn_fast_done:
        // Pack (bytes_len << 32) | U8N_OK (status=0).
        mov rax, r12;
        shl rax, 32;
        jmp u8n_dnn_epilogue;

      u8n_dnn_fast_too_small:
        // Return U8N_ERR_OUT_TOO_SMALL with bytes_written=0.
        mov rax, 0x2701;
        jmp u8n_dnn_epilogue;

        // ---- Slow path (non-ASCII, delegate to _norm_nfc) --------------
      u8n_dnn_slow:
        // Restore the four args into the SysV first-four-arg regs.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;

        // Call _norm_nfc(bytes_ptr, bytes_len, out_ptr, out_cap).
        // rsp%16 is 0 at this point (prologue sub rsp 8 + 4 pushes =
        // 40 bytes, rsp went from %16==8 to %16==0).
        call _norm_nfc;

        // rax = (out_bytes << 32) | status3; status3 in {0,1,2}.
        // Extract status3 into rdx via a 0xFF mask (imm32-safe).
        mov rdx, rax;
        and rdx, 0xFF;

        // Dispatch on status3.
        cmp rdx, 0;
        je  u8n_dnn_epilogue;         // U8N_OK -- rax packed shape already correct

        cmp rdx, 1;
        je  u8n_dnn_slow_oos;

        cmp rdx, 2;
        je  u8n_dnn_slow_bad;

        // Any other status (unreachable at M1 given R131.M3's three-value
        // taxonomy) -> U8N_ERR_NORMALIZE_FAIL. Reserved for future
        // normaliser-internal failures (table-version mismatch, scratch-
        // overflow, etc.) that a later M3.1+ landing may introduce.
        mov rax, 0x2702;
        jmp u8n_dnn_epilogue;

      u8n_dnn_slow_oos:
        mov rax, 0x2701;
        jmp u8n_dnn_epilogue;

      u8n_dnn_slow_bad:
        mov rax, 0x2700;
        jmp u8n_dnn_epilogue;

        // ---- Epilogue --------------------------------------------------
      u8n_dnn_epilogue:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
