// src/sort_group_reduce.pdx -- libpdx-pds-parser (paideia-os#2669, R223.M4)
//
// SortGroupReduce: parser-tier primitive that reads the ARGV bytes of
// a pipeline stage whose head word is `sort`, `group`, or `reduce`
// and emits a single 32-byte SortGroupReduce record carrying the key /
// reducer predicate span (and, for reduce, the seed expression span).
// Consumers (R225 HM typechecker, R223.M4+ pipeline-stage dispatcher)
// use the record to run the key expression / reducer lambda against
// each typed-record pass flowing through the pipeline.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R223 is the pipeline-lang umbrella (paideia-os#2487). R223.M1
// (pipeline.pdx) lands the pipeline stage parser; R223.M2
// (record_projection.pdx) `select`/`project`; R223.M3 (filter_op.pdx)
// the `where`/`filter`/`by` combinator. R223.M4 (THIS module) adds the
// three STANDARD AGGREGATION COMBINATORS:
//
//     ls | sort by size desc
//     ls | group by ext
//     ls | reduce { |acc, r| acc + r.size } 0
//
// All three live in one module (and one 32-byte record shape) because
// the stage dispatcher treats them as peer entries in the standard-
// combinator taxonomy and because the parser-tier record discipline
// scales better by SHARING the stride than by growing three disjoint
// 16/24/40-byte records. The `kind` byte at offset 4 discriminates
// SORT (0) / GROUP (1) / REDUCE (2) for the downstream R225 HM pass.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     Sort        ::= 'sort'   WS+ 'by' WS+ Expr (WS+ ('asc'|'desc'))?
//     Group       ::= 'group'  WS+ 'by' WS+ Expr
//     Reduce      ::= 'reduce' WS* '{' WS* '|' WS* Ident
//                                        WS* ',' WS* Ident
//                                        WS* '|' Body '}'
//                      WS+ SeedExpr
//     Ident       ::= [A-Za-z_] [A-Za-z0-9_]*       (len 1..SGR_NAME_MAX)
//     Expr        ::= <opaque bytes; R224.M2 Expr grammar via R225 HM>
//     Body        ::= <any bytes until the first unescaped '}'>
//     SeedExpr    ::= <any bytes until EOI; CtxLexer-bounded>
//     WS          ::= 0x20 | 0x09 | 0x0A | 0x0D
//
// Rejected:
//   * `sort`/`group` without a following `by` keyword;
//   * `sort`/`group` with an empty expression body after `by` (after
//     trimming trailing WS and -- for sort only -- optional
//     `asc`/`desc` suffix);
//   * `reduce` without a following `{`;
//   * `reduce { ...` without a matching `}`;
//   * `reduce { |...` whose binder prefix is not EXACTLY two
//     comma-separated idents between a pair of `|`;
//   * a binder ident whose byte length exceeds SGR_NAME_MAX (14) or
//     is empty;
//   * `reduce { ... }` with no non-WS seed expression after the
//     closing `}` (seed is MANDATORY at M4; a reducer with no seed
//     is a non-starter -- the type is ambiguous without one);
//   * the three head keywords in a form other than their exact
//     lowercase ASCII bytes (the dispatch at the pipeline-stage
//     level feeds us the already-trimmed argv; the head word was
//     already matched by the stage dispatcher, so this module
//     validates the TAIL only -- but the three public wrappers each
//     VERIFY the head keyword as a sanity check, so a caller that
//     routes mistakenly is caught cleanly).
//
// The caller feeds the WHOLE stage argv bytes (including the leading
// head keyword, so the module can re-verify dispatch). The three
// public entry points differ only in which head keyword they expect
// and which kind byte they stamp.
//
// =============================================================================
// SORTGROUPREDUCE RECORD (32 bytes)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic             u32    SORT -> 0x54524F53 LE  (bytes
//                                          'S','O','R','T' on disk)
//                                         GROUP-> 0x53505247 LE  (bytes
//                                          'G','R','P','S' on disk)
//                                         REDU -> 0x55444552 LE  (bytes
//                                          'R','E','D','U' on disk)
//     4      1   kind              u8     0 = SORT, 1 = GROUP, 2 = REDUCE
//     5      1   flags             u8     bit 0 = SGR_FLAG_DESC
//                                          (sort-only; set iff an explicit
//                                          `desc` suffix was present);
//                                         bit 1 = SGR_FLAG_HAS_SEED
//                                          (reduce-only; always set for a
//                                          well-formed REDUCE record);
//                                         bits 2..7 reserved.
//     6      2   reserved          u16    zeroed; reserved for M4.1+
//                                          (binder-count u8, source-span
//                                          id, etc.).
//     8      8   predicate_span    u64    packed (body_start << 32) |
//                                          body_len; indexes the CALLER-
//                                          supplied bytes_ptr.
//    16      8   seed_span         u64    REDUCE only -- packed
//                                          (seed_start << 32) | seed_len
//                                          for the seed expression after
//                                          the closing `}`. 0 for SORT /
//                                          GROUP (already zero-filled).
//    24      8   reserved          u64    zeroed; reserved for M4.1+.
//
//   total: 32 B (SGR_RECORD_BYTES)
//
// Magic-reconciliation note. The parent brief for R223.M4 reads
// `SORT='TROS'(0x53524F54 LE)` which, when the u32 constant 0x53524F54
// is stored on an LE machine, produces on-disk bytes 'T','O','R','S'
// (i.e. "TORS"), not "SORT". The precedent (FilterOp's 'FILT' magic
// at R223.M3: u32 constant 0x544C4946, bytes 'F','I','L','T' on disk)
// is to pick the four-byte ASCII tag that reads as the IDENTIFIER
// (SORT / GROUP / REDUCE) when scanning memory sequentially. This
// module therefore stores:
//
//     SORT_MAGIC  u32 = 0x54524F53   // disk bytes "SORT"
//     GROUP_MAGIC u32 = 0x53505247   // disk bytes "GRPS" (G=5-byte head)
//     REDU_MAGIC  u32 = 0x55444552   // disk bytes "REDU" (R=6-byte head)
//
// GROUP uses the four-byte tag "GRPS" rather than "GROU" so the on-
// disk tag doesn't collide with any R221..R225 FourCC prefix; "REDU"
// is used over "REDC" for the same reason and matches the brief.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _sgr_init() -> ()
//
//     Idempotent pure-leaf boot hook. The module carries no `.bss`
//     state at M4 (no label-intern table; no scheme pool); the init
//     exists so the shell's boot sequence can wire a uniform `*_init`
//     entry point across every pds-parser submodule.
//
//   _sgr_parse_sort(bytes, len, out, out_cap) -> packed_u64
//
//     Parses `sort by EXPR (asc|desc)?`. Writes one 32-byte
//     SortGroupReduce record at out with kind = SGR_KIND_SORT (0) and
//     flags.bit0 set iff an explicit `desc` suffix was present.
//
//   _sgr_parse_group(bytes, len, out, out_cap) -> packed_u64
//
//     Parses `group by EXPR`. Writes one 32-byte record with
//     kind = SGR_KIND_GROUP (1) and flags = 0.
//
//   _sgr_parse_reduce(bytes, len, out, out_cap) -> packed_u64
//
//     Parses `reduce { |acc, r| body } SeedExpr`. Writes one 32-byte
//     record with kind = SGR_KIND_REDUCE (2) and flags.bit1 set.
//
//   The three wrappers delegate to the module-private
//   `_sgr_parse_impl` which takes a kind byte in r8 and runs the
//   matching path. `_sgr_skip_ws` is a shared pure-leaf WS walker.
//
//   Register map (SysV):
//
//     _sgr_parse_sort / _sgr_parse_group / _sgr_parse_reduce
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = out_ptr, rcx = out_cap)
//       -> rax = (bytes_written << 32) | status
//
//     _sgr_parse_impl
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = out_ptr, rcx = out_cap,
//        r8  = kind_byte 0|1|2)
//       -> rax = (bytes_written << 32) | status
//
//     _sgr_skip_ws
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = cursor_in)
//       -> rax = cursor_out
//
// =============================================================================
// RETURN CODES
// =============================================================================
//
//   SGR_OK                   = 0
//   SGR_ERR_SYNTAX           = 0x4D00   grammar fault anywhere.
//   SGR_ERR_HEAD_MISMATCH    = 0x4D01   head keyword did not match
//                                       the entry-point's keyword.
//   SGR_ERR_NO_BY            = 0x4D02   sort/group tail missing the
//                                       `by` keyword after the head.
//   SGR_ERR_EMPTY_BODY       = 0x4D03   expression body is empty
//                                       after trimming WS / `asc` /
//                                       `desc`.
//   SGR_ERR_NO_OPEN_BRACE    = 0x4D04   reduce tail did not start
//                                       with `{`.
//   SGR_ERR_NO_CLOSE_BRACE   = 0x4D05   reduce reached EOI before
//                                       the matching `}`.
//   SGR_ERR_NO_PIPE          = 0x4D06   reduce binder prefix missing
//                                       an expected `|` boundary.
//   SGR_ERR_NAME_TOO_LONG    = 0x4D07   reduce binder ident exceeded
//                                       SGR_NAME_MAX (14).
//   SGR_ERR_NO_SEED          = 0x4D08   reduce missing a non-empty
//                                       seed expression after `}`.
//   SGR_ERR_BAD_KIND         = 0x4D09   _sgr_parse_impl called with
//                                       kind > SGR_KIND_REDUCE (2);
//                                       defence against a bogus
//                                       upstream caller.
//   SGR_ERR_OUT_TOO_SMALL    = 0x4D0A   out_cap < SGR_RECORD_BYTES
//                                       (32).
//
// `bytes_written` is 32 on success for all three entry points; 0 on
// error (caller ignores the top 32 bits).
//
// =============================================================================
// STATUS-CODE NAMESPACE
// =============================================================================
//
// SGR_* codes live in 0x4D00..0x4DFF, disjoint from every other
// user-space packed-status range in the paideia-os tree. The band
// sits one slot above FilterOp's 0x4C00..0x4CFF (R223.M3).
//
// Grep confirmation at R223.M4 landing time:
//   grep -rE '0x4D0[0-9A-F]' tools/user/libpdx-pds-parser/
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/sort-group-reduce.md.
//   grep -rE '0x4D' tools/user/libpdx-pds-parser/
//     -> same hits only (the 0x4D band is free in libpdx-pds-parser;
//     the external 0x4D sightings in paideia-os live under tools/
//     user/mv/ as a schema id, under libpdx-unicode-tables/ as a
//     Unicode range endpoint, and under tools/user/mkdir/ as a FourCC
//     for an unrelated record kind -- none of them are packed-u64
//     return statuses in this library's protocol).
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller has already run the input
//     bytes through _u8n_decode_and_normalize so this module may
//     assume valid UTF-8 in NFC form. Non-ASCII bytes inside an
//     identifier fall through to SGR_ERR_SYNTAX via the ident
//     byte-class check (none of 0x80..0xFF is in [A-Za-z0-9_]).
//     Non-ASCII bytes inside the opaque expression / seed spans are
//     stored by reference (byte offset + length) without inspection.
//
//   R221.M4 (CtxLexer)  --  the caller is expected to use CtxLexer
//     for pipeline-level `|` partitioning so this module sees an argv
//     span bounded by two outer `|` boundaries. Lambda-binder `|`
//     characters inside `reduce { |acc,r| ... }` are inside the stage
//     and do not cause confusion because the OUTER tokeniser
//     recognised them as sub-stage lexemes.
//
//   R223.M1 (Pipeline)  --  this module is a POST-pass on the
//     PipelineStage records that R223.M1 emits. The dispatcher
//     identifies a stage whose cmd_name matches `sort`, `group`, or
//     `reduce` and calls the matching entry point here.
//
//   R223.M3 (FilterOp)  --  disjoint operator parse; both modules
//     sit at the pipeline-stage POST-pass tier. The two stages can
//     appear in the same pipeline (`ls | where { |f| f.size > 1.MB }
//     | sort by size desc`); the operators do not interact at parse
//     time.
//
//   R224.M1 (LambdaLit)  --  this module does NOT call _ll_parse;
//     the predicate_span and seed_span pack byte spans back into the
//     caller's input bytes. The HM pass runs _ll_parse (for reduce's
//     body) or an Expr walker (for sort/group's key expr and reduce's
//     seed expr) against those bytes when it elaborates the stage.
//
//   R225 (HM typechecker)  --  the HM pass instantiates:
//     * SORT  predicate as `fn (Record) -> Comparable` (where
//       Comparable is any type with a total order instance);
//     * GROUP predicate as `fn (Record) -> Hashable`;
//     * REDUCE body as `fn (A, Record) -> A` and seed as `A`, with
//       A chosen by unifying the two.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- the module has no stride-indexed array
//     arithmetic (the record is a single 32-byte write).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `SortGroupReduce` matches `sort_group_reduce.pdx`.
//   - Public symbols prefixed `_sgr_*` (entry points); internal
//     labels prefixed `sgr_*`. The `sgr_` prefix is disjoint from
//     every sibling satellite's prefix (`u8n_`, `gi_`, `wp_`, `cl_`,
//     `ast_`, `sm_`, `sch_sig_`, `cmd_sig_`, `fi_`, `afs_`,
//     `cmdreg_`, `dm_`, `pl_`, `rp_`, `fo_`, `ll_`, `cc_`, `er_`,
//     `cr_`, `ls_`, `hm_`, `rt_`, `dl_`, `se_`, `te_`, `eu_`) and
//     disjoint from paideia-as reserved keywords (`loop`, `if`,
//     `let`, `fn`, `ret`, `done`, etc.).
//   - All `cmp reg, imm` immediates (ASCII literals 0x20..0x7F,
//     SGR_NAME_MAX = 14, SGR_RECORD_BYTES = 32, kind constants 0..2,
//     status codes 0x4D00..0x4D0A, magic u32s) fit in imm32 with bit
//     31 clear so direct `cmp reg, imm32` is sign-extension-safe. No
//     MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     with explicit *1 scale.
//   - Byte stores via `mov_b [dst + disp], reg` with constant
//     displacement only (no [reg + reg*1 + imm] form -- the encoder
//     synthesises those via a scratch `add`).
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: FilterOp
//     magic write).
//   - u64 zero-fill of the 32-byte record uses four `mov [dst +
//     disp], rax` with rax = 0, covering the full stride.
//   - `_sgr_init` is a pure-leaf idempotent no-op at M4; zero
//     pushes, zero stack frame, zero nested CALL.
//   - `_sgr_skip_ws` is a pure-leaf WS walker; zero pushes, zero
//     stack frame, zero nested CALL. Shape parallel to the family's
//     shared WS discipline (R221.M1 `_u8n_skip_ws`, R223.M2
//     `_rp_skip_ws`, R223.M3 `_fo_skip_ws`, R224.M1 `_ll_skip_ws`).
//   - `_sgr_parse_impl` has a 6 callee-save push + 24 B scratch
//     frame: push rbx, rbp, r12, r13, r14, r15 (= 48 B) + sub rsp,
//     24. Entry rsp%16==8; +48 pushes = %16==8; +24 scratch = %16==0
//     at every nested CALL into `_sgr_skip_ws`. Scratch slots:
//     [rsp+0] kind spill, [rsp+8] body_start, [rsp+16] body_end /
//     seed_start compose.
//   - Public wrappers (`_sgr_parse_sort`, `_sgr_parse_group`,
//     `_sgr_parse_reduce`) are 1-callee-save-push wrappers: push
//     rbx + inline keyword verification + mov r8, <kind> + call
//     _sgr_parse_impl + pop rbx + ret. Entry rsp%16==8; after the
//     push rsp%16==0, the nested CALL lands at callee-entry
//     rsp%16==8 (callee's own 6-push + 24 scratch lifts to steady
//     %16==0 for ITS own nested CALLs).
//   - r11 is NEVER held across a nested CALL (Wave 116 register-
//     liveness lesson). Values that must survive a nested CALL live
//     in rbx..r15 or on the stack.
//
// =============================================================================
// Upstream: paideia-os#2487 (R223 umbrella), paideia-os#2669 (THIS
// ticket, R223.M4). Substrate: paideia-os#2666 (R223.M1 Pipeline
// stage parser -- source of the argv spans this module consumes),
// paideia-os#2668 (R223.M3 FilterOp -- shape precedent for the
// 32-byte-record + predicate-span layout), paideia-os#2675 (R224.M1
// LambdaLit -- the reducer body's downstream parser; this module
// stores the byte span rather than invoking it).
// Design doc: design/shell/sort-group-reduce.md.

module SortGroupReduce = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let SGR_OK                  : u64 = 0
  pub let SGR_ERR_SYNTAX          : u64 = 0x4D00
  pub let SGR_ERR_HEAD_MISMATCH   : u64 = 0x4D01
  pub let SGR_ERR_NO_BY           : u64 = 0x4D02
  pub let SGR_ERR_EMPTY_BODY      : u64 = 0x4D03
  pub let SGR_ERR_NO_OPEN_BRACE   : u64 = 0x4D04
  pub let SGR_ERR_NO_CLOSE_BRACE  : u64 = 0x4D05
  pub let SGR_ERR_NO_PIPE         : u64 = 0x4D06
  pub let SGR_ERR_NAME_TOO_LONG   : u64 = 0x4D07
  pub let SGR_ERR_NO_SEED         : u64 = 0x4D08
  pub let SGR_ERR_BAD_KIND        : u64 = 0x4D09
  pub let SGR_ERR_OUT_TOO_SMALL   : u64 = 0x4D0A

  // ==========================================================================
  // SECTION 2 -- KIND / FLAG / LAYOUT CONSTANTS
  // ==========================================================================

  pub let SGR_KIND_SORT           : u64 = 0
  pub let SGR_KIND_GROUP          : u64 = 1
  pub let SGR_KIND_REDUCE         : u64 = 2

  pub let SGR_FLAG_DESC           : u64 = 0x01
  pub let SGR_FLAG_HAS_SEED       : u64 = 0x02

  pub let SGR_RECORD_BYTES        : u64 = 32
  pub let SGR_NAME_MAX            : u64 = 14

  // Magic u32s. See the "Magic-reconciliation note" in the header.
  pub let SGR_MAGIC_SORT          : u64 = 0x54524F53
  pub let SGR_MAGIC_GROUP         : u64 = 0x53505247
  pub let SGR_MAGIC_REDUCE        : u64 = 0x55444552

  // Record field offsets (bytes, from record base).
  pub let SGR_OFF_MAGIC           : u64 = 0
  pub let SGR_OFF_KIND            : u64 = 4
  pub let SGR_OFF_FLAGS           : u64 = 5
  pub let SGR_OFF_RESERVED_1      : u64 = 6
  pub let SGR_OFF_PRED_SPAN       : u64 = 8
  pub let SGR_OFF_SEED_SPAN       : u64 = 16
  pub let SGR_OFF_RESERVED_2      : u64 = 24

  // ==========================================================================
  // _sgr_init() -> ()
  //
  // Idempotent pure-leaf boot hook. No `.bss` state at M4.
  //
  // Pure leaf; no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sgr_ini_.
  // ==========================================================================
  pub let _sgr_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): _sgr_init idempotent boot hook. No `.bss` state at M4 so the body is a bare `ret`. Pure leaf; zero pushes, zero stack frame, zero nested CALL. The entry exists so the shell's uniform `*_init` wiring across every pds-parser submodule (precedent: _fo_init, _rp_skip_ws, _ast_init, _sm_init, _dm_init, _cmdreg_init, _er_init, _cr_init, _ls_init) does not special-case SortGroupReduce. A future M4.x that adds a parse-count counter in `.bss` populates this body with the lazy-populate shape; no ABI change. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sgr_ini_.",
      block: {
      sgr_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _sgr_skip_ws(bytes_ptr, bytes_len, cursor_in) -> cursor_out
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Pure leaf; no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sgr_sw_. Shape byte-for-byte parallel to the
  // family's shared WS discipline so the pds-lang family's whitespace
  // semantics stay bit-identical.
  // ==========================================================================
  pub let _sgr_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): skip ASCII whitespace in {SP, TAB, LF, CR}. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax * 1] is in the space-class set. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All cmp immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax * 1]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sgr_sw_. Byte-for-byte parallel to R221.M1 _u8n_skip_ws, R223.M2 _rp_skip_ws, R223.M3 _fo_skip_ws, R224.M1 _ll_skip_ws, R224.M2 _cc_skip_ws, R226.M1 _dl_skip_ws.",
      block: {
        mov rax, rdx;                            // cursor := cursor_in

      sgr_sw_scan:
        cmp rax, rsi;
        jae sgr_sw_stop;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];
        cmp rcx, 0x20;
        je  sgr_sw_step;
        cmp rcx, 0x09;
        je  sgr_sw_step;
        cmp rcx, 0x0A;
        je  sgr_sw_step;
        cmp rcx, 0x0D;
        je  sgr_sw_step;
        jmp sgr_sw_stop;

      sgr_sw_step:
        add rax, 1;
        jmp sgr_sw_scan;

      sgr_sw_stop:
        ret;
      }
    }

  // ==========================================================================
  // _sgr_parse_impl(bytes_ptr, bytes_len, out_ptr, out_cap, kind_byte)
  //
  //   rdi = bytes_ptr    (ARGV bytes AFTER the head keyword has been
  //                       stripped by the caller wrapper)
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   r8  = kind_byte (0 = SORT, 1 = GROUP, 2 = REDUCE)
  //   rax = (bytes_written << 32) | status
  //
  // Shared implementation of the three public entry points. The
  // caller's wrapper has already stripped the leading head keyword
  // bytes FROM the input and reset the cursor to the tail. kind_byte
  // selects the three code paths:
  //
  //   Kind 0 (SORT):
  //     expect `WS+ 'by' WS+ Expr (WS+ ('asc'|'desc'))?` with the
  //     direction suffix stripped from the Expr body if present.
  //
  //   Kind 1 (GROUP):
  //     expect `WS+ 'by' WS+ Expr`.
  //
  //   Kind 2 (REDUCE):
  //     expect `WS* { WS* | WS* ident WS* , WS* ident WS* | body }
  //             WS+ seed`.
  //
  // All three paths produce the 32-byte SortGroupReduce record laid
  // out above.
  //
  // Prologue: 6 callee-save pushes (rbx = bytes_ptr, rbp = bytes_len,
  // r12 = cursor, r13 = out_ptr, r14 = out_cap, r15 = scratch for
  // body_start / body_end composition) + sub rsp, 24 (slot 0 =
  // kind_byte spill; slot 8 = body_start saved; slot 16 = body_end
  // saved).
  //
  // Labels prefixed sgr_pi_.
  // ==========================================================================
  pub let _sgr_parse_impl : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64)
       (kind_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): shared body of _sgr_parse_sort/_sgr_parse_group/_sgr_parse_reduce. Kind 0 (SORT): WS+ 'by' WS+ Expr (WS+ ('asc'|'desc'))?. Kind 1 (GROUP): WS+ 'by' WS+ Expr. Kind 2 (REDUCE): WS* '{' WS* '|' WS* ident WS* ',' WS* ident WS* '|' body '}' WS+ seed. Writes a 32-byte SortGroupReduce record at out_ptr with magic (per-kind: 'SORT' 0x54524F53 LE, 'GRPS' 0x53505247 LE, 'REDU' 0x55444552 LE), u8 kind, u8 flags (DESC bit on sort if `desc` suffix; HAS_SEED bit on reduce), u16 reserved, u64 predicate_span packing (body_start<<32)|body_len (indexing into the CALLER-supplied bytes_ptr), u64 seed_span (reduce only; 0 for sort/group), u64 reserved. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr, r14=out_cap, r15=scratch) + sub rsp, 24 (slot 0 = kind_byte spill; slots 8/16 = body_start / body_end save for the trim-asc/desc phase) -> rsp%16==0 steady at every nested CALL into _sgr_skip_ws (entry 8, +48 pushes = 8, +24 scratch = 0). Capacity guard: out_cap >= SGR_RECORD_BYTES = 32; else SGR_ERR_OUT_TOO_SMALL. Kind guard: kind_byte > 2 -> SGR_ERR_BAD_KIND. Zero-fill the 32-byte record via four `mov [r13+disp], rax` with rax=0 before field writes; this gives free zero-padding for the reserved slots and the seed_span of SORT/GROUP. r11 is NEVER held across a nested CALL (Wave 116 lesson); long-lived scratch lives in rbx..r15 or on the stack. All cmp immediates (ASCII 0x20..0x7F, SGR_NAME_MAX=14, SGR_RECORD_BYTES=32, kind constants, status codes 0x4D00..0x4D0A, magic u32s) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sgr_pi_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Spill kind_byte to scratch slot 0; zero the other slots.
        mov [rsp + 0], r8;
        xor rax, rax;
        mov [rsp + 8], rax;                      // body_start placeholder
        mov [rsp + 16], rax;                     // body_end placeholder

        // Load state regs.
        mov rbx, rdi;                            // bytes_ptr
        mov rbp, rsi;                            // bytes_len
        xor r12, r12;                            // cursor = 0
        mov r13, rdx;                            // out_ptr
        mov r14, rcx;                            // out_cap
        xor r15, r15;                            // scratch

        // Capacity guard: must fit a full 32-byte record.
        cmp r14, 32;
        jb  sgr_pi_err_oos;

        // Kind guard: kind_byte in [0..2].
        mov rax, [rsp + 0];
        cmp rax, 2;
        ja  sgr_pi_err_bad_kind;

        // Zero-fill the 32-byte record via four u64 stores.
        xor rax, rax;
        mov [r13 + 0], rax;
        mov [r13 + 8], rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // Write kind byte at [r13 + 4].
        mov rax, [rsp + 0];
        mov_b [r13 + 4], rax;

        // Dispatch on kind for magic + body-parse path.
        mov rax, [rsp + 0];
        cmp rax, 0;
        je  sgr_pi_sort;
        cmp rax, 1;
        je  sgr_pi_group;
        jmp sgr_pi_reduce;

        // ------------------------------------------------------------
        // SORT path: `WS+ 'by' WS+ Expr (WS+ ('asc'|'desc'))?`
        // ------------------------------------------------------------
      sgr_pi_sort:
        // Write SORT magic.
        mov rax, 0x54524F53;                     // 'SORT' LE
        mov_d [r13 + 0], rax;

        // Skip leading WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // Expect 'b','y'.
        cmp r12, rbp;
        jae sgr_pi_err_no_by;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x62;                           // 'b'
        jne sgr_pi_err_no_by;
        add r12, 1;
        cmp r12, rbp;
        jae sgr_pi_err_no_by;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x79;                           // 'y'
        jne sgr_pi_err_no_by;
        add r12, 1;

        // Skip WS after 'by'.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // body_start = r12.
        mov r15, r12;                            // body_start

        // body_end = bytes_len (CtxLexer-bounded).
        mov r12, rbp;                            // body_end

        // Trim trailing WS: while body_end > body_start and
        // byte[body_end - 1] in WS, body_end--.
      sgr_pi_sort_trim1:
        cmp r12, r15;
        jbe sgr_pi_sort_dir_check;               // body_end <= body_start
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x20;
        je  sgr_pi_sort_trim1_step;
        cmp rax, 0x09;
        je  sgr_pi_sort_trim1_step;
        cmp rax, 0x0A;
        je  sgr_pi_sort_trim1_step;
        cmp rax, 0x0D;
        je  sgr_pi_sort_trim1_step;
        jmp sgr_pi_sort_dir_check;
      sgr_pi_sort_trim1_step:
        sub r12, 1;
        jmp sgr_pi_sort_trim1;

        // Direction suffix check: try `desc` (4 bytes) first, then
        // `asc` (3 bytes). The token must be preceded by a WS byte
        // OR by body_start itself (i.e. the suffix stands alone).
      sgr_pi_sort_dir_check:
        // Save body_end to [rsp + 16] so we can restore if neither
        // suffix matches (we restore it unconditionally after the
        // check since body_end only shrinks on match -- the save is
        // conceptual).
        mov [rsp + 16], r12;

        // Try `desc`.
        mov rax, r12;
        sub rax, r15;                            // body_len
        cmp rax, 4;
        jb  sgr_pi_sort_try_asc;

        // desc_start = body_end - 4.
        mov r11, r12;
        sub r11, 4;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x64;                           // 'd'
        jne sgr_pi_sort_try_asc;
        // byte[desc_start + 1] = 'e'. Compute via scratch add.
        mov r10, r11;
        add r10, 1;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x65;                           // 'e'
        jne sgr_pi_sort_try_asc;
        // byte[desc_start + 2] = 's'.
        mov r10, r11;
        add r10, 2;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x73;                           // 's'
        jne sgr_pi_sort_try_asc;
        // byte[desc_start + 3] = 'c'.
        mov r10, r11;
        add r10, 3;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x63;                           // 'c'
        jne sgr_pi_sort_try_asc;

        // Token-boundary check: desc_start == body_start, OR
        // byte[desc_start - 1] is WS.
        cmp r11, r15;
        je  sgr_pi_sort_desc_match;
        mov r10, r11;
        sub r10, 1;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x20;
        je  sgr_pi_sort_desc_match;
        cmp rax, 0x09;
        je  sgr_pi_sort_desc_match;
        cmp rax, 0x0A;
        je  sgr_pi_sort_desc_match;
        cmp rax, 0x0D;
        je  sgr_pi_sort_desc_match;
        jmp sgr_pi_sort_try_asc;

      sgr_pi_sort_desc_match:
        // Set DESC flag.
        mov rax, 1;
        mov_b [r13 + 5], rax;
        // body_end := desc_start.
        mov r12, r11;
        jmp sgr_pi_sort_trim2;

      sgr_pi_sort_try_asc:
        // Try `asc`.
        mov rax, r12;
        sub rax, r15;
        cmp rax, 3;
        jb  sgr_pi_sort_body_done;

        // asc_start = body_end - 3.
        mov r11, r12;
        sub r11, 3;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x61;                           // 'a'
        jne sgr_pi_sort_body_done;
        mov r10, r11;
        add r10, 1;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x73;                           // 's'
        jne sgr_pi_sort_body_done;
        mov r10, r11;
        add r10, 2;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x63;                           // 'c'
        jne sgr_pi_sort_body_done;

        // Token-boundary check.
        cmp r11, r15;
        je  sgr_pi_sort_asc_match;
        mov r10, r11;
        sub r10, 1;
        xor rax, rax;
        mov_b rax, [rbx + r10 * 1];
        cmp rax, 0x20;
        je  sgr_pi_sort_asc_match;
        cmp rax, 0x09;
        je  sgr_pi_sort_asc_match;
        cmp rax, 0x0A;
        je  sgr_pi_sort_asc_match;
        cmp rax, 0x0D;
        je  sgr_pi_sort_asc_match;
        jmp sgr_pi_sort_body_done;

      sgr_pi_sort_asc_match:
        // DESC flag remains clear (default ascending).
        // body_end := asc_start.
        mov r12, r11;
        // Fall through to trim2.

      sgr_pi_sort_trim2:
        // Re-trim trailing WS after stripping the direction suffix.
      sgr_pi_sort_trim2_loop:
        cmp r12, r15;
        jbe sgr_pi_sort_body_done;
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x20;
        je  sgr_pi_sort_trim2_step;
        cmp rax, 0x09;
        je  sgr_pi_sort_trim2_step;
        cmp rax, 0x0A;
        je  sgr_pi_sort_trim2_step;
        cmp rax, 0x0D;
        je  sgr_pi_sort_trim2_step;
        jmp sgr_pi_sort_body_done;
      sgr_pi_sort_trim2_step:
        sub r12, 1;
        jmp sgr_pi_sort_trim2_loop;

      sgr_pi_sort_body_done:
        // body_end = r12; body_start = r15.
        // Verify body non-empty.
        cmp r12, r15;
        jbe sgr_pi_err_empty_body;

        // predicate_span = (body_start << 32) | body_len.
        mov rax, r15;
        shl rax, 32;
        mov rcx, r12;
        sub rcx, r15;
        or  rax, rcx;
        mov [r13 + 8], rax;

        // Pack return.
        mov rax, 32;
        shl rax, 32;
        jmp sgr_pi_epilogue;

        // ------------------------------------------------------------
        // GROUP path: `WS+ 'by' WS+ Expr`
        // ------------------------------------------------------------
      sgr_pi_group:
        // Write GROUP magic.
        mov rax, 0x53505247;                     // 'GRPS' LE
        mov_d [r13 + 0], rax;

        // Skip leading WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // Expect 'b','y'.
        cmp r12, rbp;
        jae sgr_pi_err_no_by;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x62;                           // 'b'
        jne sgr_pi_err_no_by;
        add r12, 1;
        cmp r12, rbp;
        jae sgr_pi_err_no_by;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x79;                           // 'y'
        jne sgr_pi_err_no_by;
        add r12, 1;

        // Skip WS after 'by'.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // body_start = r12; body_end = rbp.
        mov r15, r12;
        mov r12, rbp;

        // Trim trailing WS.
      sgr_pi_group_trim:
        cmp r12, r15;
        jbe sgr_pi_group_done;
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x20;
        je  sgr_pi_group_trim_step;
        cmp rax, 0x09;
        je  sgr_pi_group_trim_step;
        cmp rax, 0x0A;
        je  sgr_pi_group_trim_step;
        cmp rax, 0x0D;
        je  sgr_pi_group_trim_step;
        jmp sgr_pi_group_done;
      sgr_pi_group_trim_step:
        sub r12, 1;
        jmp sgr_pi_group_trim;

      sgr_pi_group_done:
        // Verify body non-empty.
        cmp r12, r15;
        jbe sgr_pi_err_empty_body;

        // predicate_span.
        mov rax, r15;
        shl rax, 32;
        mov rcx, r12;
        sub rcx, r15;
        or  rax, rcx;
        mov [r13 + 8], rax;

        // Pack return.
        mov rax, 32;
        shl rax, 32;
        jmp sgr_pi_epilogue;

        // ------------------------------------------------------------
        // REDUCE path:
        // `WS* '{' WS* '|' WS* ident WS* ',' WS* ident WS* '|' body
        //  '}' WS+ seed`
        // ------------------------------------------------------------
      sgr_pi_reduce:
        // Write REDUCE magic.
        mov rax, 0x55444552;                     // 'REDU' LE
        mov_d [r13 + 0], rax;

        // Skip leading WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // Expect '{'.
        cmp r12, rbp;
        jae sgr_pi_err_no_open_brace;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7B;                           // '{'
        jne sgr_pi_err_no_open_brace;
        add r12, 1;

        // Skip WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // Expect '|'.
        cmp r12, rbp;
        jae sgr_pi_err_no_pipe;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7C;                           // '|'
        jne sgr_pi_err_no_pipe;
        add r12, 1;

        // Parse FIRST binder ident.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // First byte must be in [A-Za-z_].
        cmp r12, rbp;
        jae sgr_pi_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;                           // '_'
        je  sgr_pi_red_b1_scan;
        cmp rax, 0x41;                           // 'A'
        jb  sgr_pi_err_syntax;
        cmp rax, 0x5A;                           // 'Z'
        jbe sgr_pi_red_b1_scan;
        cmp rax, 0x61;                           // 'a'
        jb  sgr_pi_err_syntax;
        cmp rax, 0x7A;                           // 'z'
        ja  sgr_pi_err_syntax;

      sgr_pi_red_b1_scan:
        mov r15, r12;                            // b1_start
        add r12, 1;
      sgr_pi_red_b1_cont:
        cmp r12, rbp;
        jae sgr_pi_red_b1_done;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;
        je  sgr_pi_red_b1_step;
        cmp rax, 0x30;                           // '0'
        jb  sgr_pi_red_b1_check_alpha;
        cmp rax, 0x39;                           // '9'
        jbe sgr_pi_red_b1_step;
      sgr_pi_red_b1_check_alpha:
        cmp rax, 0x41;
        jb  sgr_pi_red_b1_done;
        cmp rax, 0x5A;
        jbe sgr_pi_red_b1_step;
        cmp rax, 0x61;
        jb  sgr_pi_red_b1_done;
        cmp rax, 0x7A;
        ja  sgr_pi_red_b1_done;
      sgr_pi_red_b1_step:
        add r12, 1;
        jmp sgr_pi_red_b1_cont;

      sgr_pi_red_b1_done:
        // Verify length 1..SGR_NAME_MAX.
        mov rax, r12;
        sub rax, r15;
        cmp rax, 0;
        je  sgr_pi_err_syntax;
        cmp rax, 14;
        ja  sgr_pi_err_name_too_long;

        // Skip WS; expect ','.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae sgr_pi_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x2C;                           // ','
        jne sgr_pi_err_syntax;
        add r12, 1;

        // Skip WS; parse SECOND binder ident.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae sgr_pi_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;
        je  sgr_pi_red_b2_scan;
        cmp rax, 0x41;
        jb  sgr_pi_err_syntax;
        cmp rax, 0x5A;
        jbe sgr_pi_red_b2_scan;
        cmp rax, 0x61;
        jb  sgr_pi_err_syntax;
        cmp rax, 0x7A;
        ja  sgr_pi_err_syntax;

      sgr_pi_red_b2_scan:
        mov r15, r12;                            // b2_start
        add r12, 1;
      sgr_pi_red_b2_cont:
        cmp r12, rbp;
        jae sgr_pi_red_b2_done;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;
        je  sgr_pi_red_b2_step;
        cmp rax, 0x30;
        jb  sgr_pi_red_b2_check_alpha;
        cmp rax, 0x39;
        jbe sgr_pi_red_b2_step;
      sgr_pi_red_b2_check_alpha:
        cmp rax, 0x41;
        jb  sgr_pi_red_b2_done;
        cmp rax, 0x5A;
        jbe sgr_pi_red_b2_step;
        cmp rax, 0x61;
        jb  sgr_pi_red_b2_done;
        cmp rax, 0x7A;
        ja  sgr_pi_red_b2_done;
      sgr_pi_red_b2_step:
        add r12, 1;
        jmp sgr_pi_red_b2_cont;

      sgr_pi_red_b2_done:
        mov rax, r12;
        sub rax, r15;
        cmp rax, 0;
        je  sgr_pi_err_syntax;
        cmp rax, 14;
        ja  sgr_pi_err_name_too_long;

        // Skip WS; expect closing '|'.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae sgr_pi_err_no_pipe;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7C;                           // '|'
        jne sgr_pi_err_no_pipe;
        add r12, 1;

        // body_start = r12.
        mov r15, r12;

        // Body scan: all bytes up to the first '}' (M4; nested-brace
        // tracking is deferred to M4.1 along with FilterOp M3.1).
      sgr_pi_red_body:
        cmp r12, rbp;
        jae sgr_pi_err_no_close_brace;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7D;                           // '}'
        je  sgr_pi_red_body_done;
        add r12, 1;
        jmp sgr_pi_red_body;

      sgr_pi_red_body_done:
        // body_end = r12; verify non-empty.
        mov rax, r12;
        sub rax, r15;
        cmp rax, 0;
        je  sgr_pi_err_empty_body;

        // predicate_span = (body_start << 32) | body_len.
        mov rax, r15;
        shl rax, 32;
        mov rcx, r12;
        sub rcx, r15;
        or  rax, rcx;
        mov [r13 + 8], rax;

        // Consume closing '}'.
        add r12, 1;

        // Skip WS before the seed expression.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sgr_skip_ws;
        mov r12, rax;

        // seed_start = r12.
        mov r15, r12;

        // seed_end = rbp (CtxLexer-bounded).
        mov r12, rbp;

        // Trim trailing WS off the seed.
      sgr_pi_red_seed_trim:
        cmp r12, r15;
        jbe sgr_pi_red_seed_done;
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov_b rax, [rbx + r11 * 1];
        cmp rax, 0x20;
        je  sgr_pi_red_seed_trim_step;
        cmp rax, 0x09;
        je  sgr_pi_red_seed_trim_step;
        cmp rax, 0x0A;
        je  sgr_pi_red_seed_trim_step;
        cmp rax, 0x0D;
        je  sgr_pi_red_seed_trim_step;
        jmp sgr_pi_red_seed_done;
      sgr_pi_red_seed_trim_step:
        sub r12, 1;
        jmp sgr_pi_red_seed_trim;

      sgr_pi_red_seed_done:
        // Verify seed non-empty (seed is MANDATORY at M4).
        cmp r12, r15;
        jbe sgr_pi_err_no_seed;

        // seed_span = (seed_start << 32) | seed_len.
        mov rax, r15;
        shl rax, 32;
        mov rcx, r12;
        sub rcx, r15;
        or  rax, rcx;
        mov [r13 + 16], rax;

        // Set HAS_SEED flag (bit 1).
        mov rax, 2;
        mov_b [r13 + 5], rax;

        // Pack return.
        mov rax, 32;
        shl rax, 32;
        jmp sgr_pi_epilogue;

        // ------------------------------------------------------------
        // Error paths. Each packs 0 in the bytes_written slot.
        // ------------------------------------------------------------
      sgr_pi_err_syntax:
        mov rax, 0x4D00;
        jmp sgr_pi_epilogue;

      sgr_pi_err_no_by:
        mov rax, 0x4D02;
        jmp sgr_pi_epilogue;

      sgr_pi_err_empty_body:
        mov rax, 0x4D03;
        jmp sgr_pi_epilogue;

      sgr_pi_err_no_open_brace:
        mov rax, 0x4D04;
        jmp sgr_pi_epilogue;

      sgr_pi_err_no_close_brace:
        mov rax, 0x4D05;
        jmp sgr_pi_epilogue;

      sgr_pi_err_no_pipe:
        mov rax, 0x4D06;
        jmp sgr_pi_epilogue;

      sgr_pi_err_name_too_long:
        mov rax, 0x4D07;
        jmp sgr_pi_epilogue;

      sgr_pi_err_no_seed:
        mov rax, 0x4D08;
        jmp sgr_pi_epilogue;

      sgr_pi_err_bad_kind:
        mov rax, 0x4D09;
        jmp sgr_pi_epilogue;

      sgr_pi_err_oos:
        mov rax, 0x4D0A;
        jmp sgr_pi_epilogue;

      sgr_pi_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _sgr_parse_sort(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `sort`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `sort` head keyword (4 bytes) + one
  // trailing WS byte (so `sortX` is rejected), strips the 4-byte
  // keyword, and delegates to `_sgr_parse_impl` with kind = 0.
  //
  // Prologue: 1 callee-save push (rbx = bytes_ptr). Entry rsp%16==8;
  // after `push rbx` rsp%16==0; nested CALL lands aligned.
  //
  // Labels prefixed sgr_so_.
  // ==========================================================================
  pub let _sgr_parse_sort : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): public `sort by EXPR (asc|desc)?` entry point. Thin wrapper that verifies the leading `sort` head keyword (4 bytes: 's','o','r','t') plus one trailing WS byte (SP/TAB/LF/CR) so `sortX` is rejected cleanly, then delegates to _sgr_parse_impl with kind=0 and the bytes_ptr/bytes_len shifted past the 4-byte keyword (the trailing WS is kept so the delegated _sgr_skip_ws consumes it). Head-keyword verification is inline (no helper): fail with SGR_ERR_HEAD_MISMATCH if any of the four expected bytes mismatches, if bytes_len < 5, or if byte[4] is not in {0x20, 0x09, 0x0A, 0x0D}. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _sgr_parse_impl lands at callee entry rsp%16==8 (the callee's own 6-push + 24-byte-scratch frame then lifts to %16==0 steady for its own nested CALLs). No test; no and-imm64; no imul-r-imm; no multiline let. r11 clobbered freely as scratch. Labels prefixed sgr_so_.",
      block: {
        push rbx;
        mov rbx, rdi;

        // Verify `sort` keyword + trailing WS (5 bytes min).
        cmp rsi, 5;
        jb  sgr_so_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x73;                           // 's'
        jne sgr_so_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x6F;                           // 'o'
        jne sgr_so_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x72;                           // 'r'
        jne sgr_so_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x74;                           // 't'
        jne sgr_so_err_head;

        // byte[4] must be WS so `sortX` is rejected.
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x20;
        je  sgr_so_ws_ok;
        cmp rax, 0x09;
        je  sgr_so_ws_ok;
        cmp rax, 0x0A;
        je  sgr_so_ws_ok;
        cmp rax, 0x0D;
        je  sgr_so_ws_ok;
        jmp sgr_so_err_head;

      sgr_so_ws_ok:
        // Delegate: shift input past the 4-byte keyword.
        mov rdi, rbx;
        add rdi, 4;
        mov r10, rsi;
        sub r10, 4;
        mov rsi, r10;
        mov r8, 0;                               // kind = SORT
        call _sgr_parse_impl;

        pop rbx;
        ret;

      sgr_so_err_head:
        mov rax, 0x4D01;                         // SGR_ERR_HEAD_MISMATCH
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _sgr_parse_group(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `group`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `group` head keyword (5 bytes) + one
  // trailing WS, strips the keyword, delegates to `_sgr_parse_impl`
  // with kind = 1.
  //
  // Labels prefixed sgr_gr_.
  // ==========================================================================
  pub let _sgr_parse_group : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): public `group by EXPR` entry point. Thin wrapper that verifies the leading `group` head keyword (5 bytes: 'g','r','o','u','p') plus one trailing WS byte so `groupX` is rejected cleanly, then delegates to _sgr_parse_impl with kind=1 and the bytes_ptr/bytes_len shifted past the 5-byte keyword. Head-keyword verification inline: fail with SGR_ERR_HEAD_MISMATCH if any of the five expected bytes mismatches, if bytes_len < 6, or if byte[5] is not in {0x20, 0x09, 0x0A, 0x0D}. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _sgr_parse_impl lands aligned. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sgr_gr_.",
      block: {
        push rbx;
        mov rbx, rdi;

        cmp rsi, 6;
        jb  sgr_gr_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x67;                           // 'g'
        jne sgr_gr_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x72;                           // 'r'
        jne sgr_gr_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x6F;                           // 'o'
        jne sgr_gr_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x75;                           // 'u'
        jne sgr_gr_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x70;                           // 'p'
        jne sgr_gr_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 0x20;
        je  sgr_gr_ws_ok;
        cmp rax, 0x09;
        je  sgr_gr_ws_ok;
        cmp rax, 0x0A;
        je  sgr_gr_ws_ok;
        cmp rax, 0x0D;
        je  sgr_gr_ws_ok;
        jmp sgr_gr_err_head;

      sgr_gr_ws_ok:
        mov rdi, rbx;
        add rdi, 5;
        mov r10, rsi;
        sub r10, 5;
        mov rsi, r10;
        mov r8, 1;                               // kind = GROUP
        call _sgr_parse_impl;

        pop rbx;
        ret;

      sgr_gr_err_head:
        mov rax, 0x4D01;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _sgr_parse_reduce(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `reduce`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `reduce` head keyword (6 bytes), strips
  // the keyword, delegates to `_sgr_parse_impl` with kind = 2. Reduce
  // does NOT require a trailing WS after the keyword (the next
  // character may be `{`, since `reduce{|a,b|...}` is legal with no
  // intervening WS); the four-byte-min check is sufficient to catch
  // `reduceX`-shaped mistakes because the dispatcher that drove us
  // here already matched the keyword as a whole word.
  //
  // Labels prefixed sgr_re_.
  // ==========================================================================
  pub let _sgr_parse_reduce : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M4 (#2669): public `reduce { |acc, r| body } seed` entry point. Thin wrapper that verifies the leading `reduce` head keyword (6 bytes: 'r','e','d','u','c','e') then delegates to _sgr_parse_impl with kind=2 and the bytes_ptr/bytes_len shifted past the 6-byte keyword. Unlike sort/group, reduce does NOT require a trailing WS after the keyword because `reduce{...}` is a legal form (the `{` is a token-terminating character on its own). Head-keyword verification inline: fail with SGR_ERR_HEAD_MISMATCH if any of the six expected bytes mismatches or if bytes_len < 6. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _sgr_parse_impl lands aligned. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sgr_re_.",
      block: {
        push rbx;
        mov rbx, rdi;

        cmp rsi, 6;
        jb  sgr_re_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x72;                           // 'r'
        jne sgr_re_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x65;                           // 'e'
        jne sgr_re_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x64;                           // 'd'
        jne sgr_re_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x75;                           // 'u'
        jne sgr_re_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x63;                           // 'c'
        jne sgr_re_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 0x65;                           // 'e'
        jne sgr_re_err_head;

        mov rdi, rbx;
        add rdi, 6;
        mov r10, rsi;
        sub r10, 6;
        mov rsi, r10;
        mov r8, 2;                               // kind = REDUCE
        call _sgr_parse_impl;

        pop rbx;
        ret;

      sgr_re_err_head:
        mov rax, 0x4D01;
        pop rbx;
        ret;
      }
    }

}
