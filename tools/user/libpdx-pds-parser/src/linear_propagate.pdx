// src/linear_propagate.pdx -- libpdx-pds-parser.R224.M7 (paideia-os#2681)
//
// LinearPropagate: parser-tier substrate for the Walker 2005
// substructural-lattice propagation rule across lambda closure capture
// (R224.M7 of the lambda-lang umbrella, paideia-os#2488).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R224 is the lambda-lang umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R224 --
// Lambda surface"). R224.M1 landed the lambda-literal header parser
// (`\x:u64 -> body`); R224.M2 landed the explicit closure-capture
// list (`[binding, binding, ...]`); R224.M3 landed the effect-row
// (`!{io, mem}`); R224.M4 landed the capability-row (`@{read, write}`);
// R224.M5 landed the nested lambda + let-rec scope frames; R224.M6
// landed the first-class pipeline-value box (`PipelineLambda`).
//
// R224.M7 (THIS module) lands the SUBSTRUCTURAL-LATTICE PROPAGATION
// rule from Walker, D. "Substructural Type Systems", in
// _Advanced Topics in Types and Programming Languages_ (B. C. Pierce
// ed., MIT Press 2005), chapter 1. The rule:
//
//     A lambda that CLOSES OVER (captures) any binding with
//     substructural kind K is ITSELF of kind at-least K; the
//     propagated kind is the LATTICE JOIN of its captures' kinds.
//
// The semantic-shell universe uses the four-point substructural
// lattice (Walker 2005 §1.3):
//
//   UNRESTRICTED (0)   weakening (drop) + contraction (dup) allowed
//   AFFINE       (1)   weakening allowed, contraction FORBIDDEN
//   RELEVANT     (2)   contraction allowed, weakening FORBIDDEN
//   LINEAR       (3)   neither allowed; use-exactly-once
//
// Observe that AFFINE and RELEVANT are INCOMPARABLE in the lattice
// (neither restriction implies the other). The lattice is therefore
// NOT a chain. The task's integer encoding is CHOSEN so that the
// two restriction bits align with the integer's low two bits:
//
//   bit 0 == 1  <=>  contraction (dup) is FORBIDDEN
//   bit 1 == 1  <=>  weakening (drop) is FORBIDDEN
//
//     UNRESTRICTED = 0b00 = 0
//     AFFINE       = 0b01 = 1   (no dup; drop OK)
//     RELEVANT     = 0b10 = 2   (dup OK; no drop)
//     LINEAR       = 0b11 = 3   (no dup, no drop)
//
// Under this encoding:
//
//     JOIN(a, b) = a | b                  (union of restrictions;
//                                          "the stronger kind")
//     MEET(a, b) = a & b                  (intersection of
//                                          restrictions; "the weaker
//                                          kind")
//
// Verifying the non-trivial pair:
//
//     JOIN(AFFINE, RELEVANT)   = 0b01 | 0b10 = 0b11 = LINEAR   ✓
//                               (a closure capturing both an AFFINE
//                                binding and a RELEVANT binding may
//                                neither dup nor drop; LINEAR)
//     MEET(AFFINE, RELEVANT)   = 0b01 & 0b10 = 0b00 = UNRESTRICTED ✓
//                               (the shared restriction set is empty;
//                                UNRESTRICTED is the least-restrictive
//                                lower bound both share)
//
// The lattice-aware encoding lets `_lp_join` and `_lp_meet` compile
// to a single `or` / `and` instruction over 64-bit zero-extended
// u8 operands, with no table lookup.
//
// Scope at M7:
//   * `_lp_init` -- idempotent boot hook (no `.bss` state at raw M7).
//   * `_lp_meet(k1, k2)` -- lattice meet.
//   * `_lp_join(k1, k2)` -- lattice join.
//   * `_lp_check_use(kind, use_count)` -- discipline check: assert
//     a binding of kind K was consumed by its enclosing scope the
//     correct number of times:
//        LINEAR     requires use_count == 1
//        AFFINE     requires use_count <= 1
//        RELEVANT   requires use_count >= 1
//        UNRESTRICTED has no constraint
//   * `_lp_classify_lambda(lambda_lit_ref, closure_env_ref,
//                          env_kinds_ref, env_kinds_len) -> packed_u64`
//      -- walks a R224.M2 ClosureCapture record's binding array,
//         JOINs the per-binding kind over all captures, returns the
//         propagated lambda kind packed with status.
//
// Out of scope at M7 (deferred):
//   * M7.1 -- lambda-literal header annotation: the LambdaLit header
//     at R224.M1 does not yet carry a user-declared kind override
//     slot; a future splice-point will reserve one u8 in the header's
//     reserved tail and `_lp_classify_lambda` will JOIN the declared
//     override with the computed propagation (meet-dominated by the
//     caller-asked kind).
//   * M7.2 -- cross-boundary use-count tracking: `_lp_check_use` is a
//     per-binding assertion over a caller-threaded use_count; a future
//     landing wires the use_count via the R224.M5 LetScope frame
//     bookkeeping so the elaborator can emit `_lp_check_use` at scope-
//     pop time automatically.
//   * M7.3 -- diagnostic surface: raw M7 returns packed status codes;
//     a future landing wires an `E0840_*` diagnostic family through
//     the diagnostic-collector shared by R224.M3 EffectRow and
//     R224.M4 CapRow.
//   * M7.4 -- recursive capture (let-rec): a let-rec recursive binding
//     captures itself; the R224.M5 scope frames must mark the self-
//     capture edge and the propagation must ignore it to avoid
//     the trivial fixpoint `L -> L -> L`. Raw M7 trusts the caller
//     to pre-filter.
//
// The module is a PARSER-TIER substrate: it does NOT itself consult
// the kernel-side capability table, run the HM pass, or evaluate a
// lambda. It is called from the HM elaborator (R225) and from the
// R229 REPL dispatcher to classify a lambda once at elaboration time.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
// LinearPropagate has NO parser-tier grammar of its own at M7 -- it
// is a LATTICE-AWARE value computation over bindings already parsed
// by R224.M2 ClosureCapture. The input to `_lp_classify_lambda` is a
// previously-emitted ClosureCapture record (its 32-byte
// ClosureCaptureHeader + N 32-byte Binding descriptors) PLUS a
// caller-supplied `env_kinds` byte array that gives the substructural
// kind for each binding slot, indexed in parallel.
//
// A caller that wishes to apply the propagation to a lambda that has
// NO explicit capture list (the implicit by-reference capture over the
// enclosing scope) passes `closure_env_ref == 0`; the propagated kind
// is then UNRESTRICTED (there are no captures to join, so the JOIN is
// over the empty set, which is the lattice bottom: UNRESTRICTED).
//
// =============================================================================
// SUBSTRUCTURAL KINDS
// =============================================================================
//
//   LP_KIND_UNRESTRICTED  = 0    (weakening + contraction allowed)
//   LP_KIND_AFFINE        = 1    (weakening allowed; no contraction)
//   LP_KIND_RELEVANT      = 2    (contraction allowed; no weakening)
//   LP_KIND_LINEAR        = 3    (no weakening; no contraction)
//   LP_UNKNOWN_KIND       = 0xFF (sentinel: input kind out of band)
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _lp_init() -> ()
//
//     Idempotent pure-leaf boot hook. The module carries no `.bss`
//     state at raw M7 (the four public entry points operate entirely
//     over caller-supplied buffers and immediate inputs); the init
//     exists so the shell's boot sequence can wire a uniform `*_init`
//     entry point across every pds-parser submodule. A future M7.1+
//     that adds a `.bss` (e.g. a propagated-kind counter, a diagnostic
//     ring buffer, a user-declared-override intern table) populates
//     this body with the lazy-populate shape without an ABI break.
//
//   _lp_meet(k1, k2) -> kind_u8
//
//     Returns the lattice MEET of two substructural kinds (`k1 & k2`
//     under the two-bit restriction encoding). Returns LP_UNKNOWN_KIND
//     (0xFF) when either input is > LP_KIND_LINEAR (3) -- the only
//     band validation the primitive performs.
//
//     Register map (SysV): rdi = k1 (u8 zero-extended), rsi = k2
//     (u8 zero-extended), rax = result (u8 zero-extended).
//
//   _lp_join(k1, k2) -> kind_u8
//
//     Returns the lattice JOIN of two substructural kinds (`k1 | k2`
//     under the two-bit restriction encoding). Returns LP_UNKNOWN_KIND
//     when either input is > 3. Walker 2005's propagation rule is
//     JOIN over the captures' kinds, so this is the primitive the
//     elaborator uses most.
//
//     Register map (SysV): rdi = k1, rsi = k2, rax = result.
//
//   _lp_check_use(kind, use_count) -> status
//
//     Validates that a binding of substructural kind `kind` has been
//     used `use_count` times in a way consistent with the lattice.
//     The four discipline rules per Walker 2005 §1.3:
//
//        LINEAR     : use_count MUST equal 1
//        AFFINE     : use_count MUST be in {0, 1}
//        RELEVANT   : use_count MUST be >= 1
//        UNRESTRICTED : any use_count is admissible
//
//     Returns one of:
//
//        LP_OK                    = 0
//        LP_ERR_BAD_KIND          = 0x5600  kind > 3
//        LP_ERR_LINEAR_NOT_USED   = 0x5601  LINEAR with use_count == 0
//        LP_ERR_LINEAR_MULTI_USE  = 0x5602  LINEAR with use_count > 1
//        LP_ERR_AFFINE_MULTI_USE  = 0x5603  AFFINE with use_count > 1
//        LP_ERR_RELEVANT_NOT_USED = 0x5604  RELEVANT with use_count == 0
//
//     Register map (SysV): rdi = kind, rsi = use_count, rax = status.
//
//   _lp_classify_lambda(lambda_lit_ref, closure_env_ref,
//                       env_kinds_ref, env_kinds_len) -> packed_u64
//
//     Walks a R224.M2 ClosureCapture record (header at closure_env_ref;
//     magic 'CCAP' at [+0], n_bindings u16 at [+4]) and, for each
//     binding slot i in [0, n_bindings), reads the caller-supplied
//     substructural kind at `env_kinds_ref[i]` and JOINs it into an
//     accumulator starting at LP_KIND_UNRESTRICTED (0). The final
//     accumulator is the propagated lambda kind.
//
//     If `closure_env_ref == 0` the lambda has no explicit capture
//     list; the empty-set JOIN is UNRESTRICTED (0) by convention
//     (lattice bottom). This mirrors the ClosureCaptureHeader IS_EMPTY
//     flag semantics at R224.M2.
//
//     The `lambda_lit_ref` parameter is reserved for M7.1 (user-
//     declared kind override): raw M7 does NOT dereference it; the
//     caller may pass 0.
//
//     Returns packed `(propagated_kind << 32) | status` u64:
//
//        LP_OK                   = 0
//        LP_ERR_BAD_MAGIC        = 0x5605  closure_env_ref's u32 at
//                                          [+0] != 'CCAP' (0x50414343)
//        LP_ERR_NULL_PTR         = 0x5606  closure_env_ref != 0 AND
//                                          n_bindings > 0 AND
//                                          env_kinds_ref == 0
//        LP_ERR_BAD_INDEX        = 0x5607  env_kinds_len < n_bindings
//        LP_ERR_BAD_KIND         = 0x5600  env_kinds[i] > 3 for some i
//        LP_ERR_BAD_N_BINDINGS   = 0x5608  n_bindings > LP_MAX_BINDINGS
//                                          (16; mirrors R224.M2
//                                          CC_MAX_BINDINGS)
//
//     Register map (SysV):
//        rdi = lambda_lit_ref     (reserved; may be 0)
//        rsi = closure_env_ref    (ptr to ClosureCapture record; may be 0)
//        rdx = env_kinds_ref      (ptr to u8[env_kinds_len])
//        rcx = env_kinds_len      (bound)
//        rax = (propagated_kind << 32) | status
//
// =============================================================================
// RETURN CODES / STATUS BAND
// =============================================================================
//
// Error band 0x5600..0x56FF, reserved for the R224.M7 linear-propagate
// primitive. Disjoint from every other error band in the libpdx-pds-
// parser family:
//
//   R221.M1 utf8_nfc           0x2700..0x27FF
//   R222.M1 schemas_sig        0x2A00..0x2AFF
//   R222.M2 command_sig        0x3300..0x33FF
//   R223.M1 pipeline           0x2B00..0x2BFF
//   R223.M2 record_projection  0x3400..0x34FF
//   R224.M1 lambda_lit         0x2C00..0x2CFF
//   R224.M2 closure_capture    0x3500..0x35FF
//   R224.M6 pipeline_lambda    0x5000..0x50FF
//   R223.M5 wire_sink          0x5200..0x52FF
//   R223.M6 hostname_annot     0x5300..0x53FF
//   R229.M6 line_editor        0x5400..0x54FF
//   R223.M7 (reserved)         0x5500..0x55FF
//   R224.M7 linear_propagate   0x5600..0x56FF   (THIS band)
//
// Grep confirmation at R224.M7 landing time:
//   grep -rE '0x56[0-9A-F]{2}' tools/user/libpdx-pds-parser/
//     -> no prior hits (the band is virgin).
//   grep -rE '0x560[0-8]\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/linear-propagation.md.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R224.M1 (LambdaLit)  --  this module stores no reference to the
//     parsed LambdaHeader at raw M7; the `lambda_lit_ref` argument is
//     reserved for the M7.1 user-declared-kind override. A later
//     splice-point lands a `kind_u8` slot in the LambdaHeader's
//     reserved tail; `_lp_classify_lambda` will then read that byte
//     and JOIN it with the propagated kind so the HM pass can refuse
//     a caller-declared UNRESTRICTED lambda whose captures compute
//     LINEAR.
//
//   R224.M2 (ClosureCapture)  --  this module READS the R224.M2
//     record's header + binding-array layout:
//        magic 'CCAP' at [+0]            : u32
//        n_bindings at [+4]              : u16 (0..CC_MAX_BINDINGS=16)
//        binding array starting at [+32] : 32 B each
//     Raw M7 reads ONLY the header's magic + n_bindings; the binding
//     array itself is NOT dereferenced because the per-binding kind is
//     caller-supplied in parallel through `env_kinds_ref`. The
//     parallel-array shape avoids a cross-module dependency on the
//     ClosureCapture Binding stride.
//
//   R224.M3 (EffectRow)  --  not touched. EffectRow is a DESCRIPTIVE
//     type-level artefact; this module is a PRESCRIPTIVE discipline
//     check. The two surfaces are orthogonal: a lambda may be LINEAR
//     and pure (`!{}`) at the same time.
//
//   R224.M4 (CapRow)  --  the substructural-lattice encoding here
//     echoes the Q-A2 "substructural capability lattice" that R224.M4
//     CapRow uses for capability discipline. Both modules share the
//     two-bit "restriction set" view (no_drop, no_dup); the modules
//     differ in what they RESTRICT: CapRow restricts the per-cap
//     permission row; this module restricts per-BINDING use counts.
//     The two are composed at the HM-pass elaborator surface in a
//     later landing (M7.6+).
//
//   R224.M5 (LetScope)  --  the elaborator-side wire-up (M7.2) calls
//     `_lp_check_use(kind, use_count)` at `_ls_pop` time to validate
//     the just-popped frame's binding use discipline. Raw M7 does
//     NOT make this call itself; the elaborator orchestrates.
//
//   R224.M6 (PipelineLambda)  --  the propagated lambda kind computed
//     here flows into a PipelineLambda record via the HM-pass
//     elaborator (M7.5+); raw M7 does NOT itself write any field of
//     a PipelineLambda record.
//
//   R225 (HM typechecker)  --  the HM pass instantiates the lambda,
//     collects its captures as parsed by R224.M2, synthesises each
//     binding's substructural kind from its elaborated type scheme
//     (an open row-variable binding is UNRESTRICTED by default; an
//     explicit `linear`/`affine`/`relevant` type-annotation lifts the
//     binding to the matching kind), hands the resulting byte array
//     to `_lp_classify_lambda`, and uses the returned kind both as a
//     discipline annotation on the lambda's type and (at M7.5) as a
//     write into the LambdaHeader's reserved tail.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32 (the two-bit
//     kind band fits in imm8 trivially).
//   - No 2-op `imul r, imm` -- `_lp_classify_lambda`'s per-binding
//     index step is `add r9, 1` (byte stride for env_kinds_ref is 1,
//     so no multiplication is needed).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `LinearPropagate` matches `linear_propagate.pdx`.
//   - Public symbols prefixed `_lp_*` (entry points); internal labels
//     prefixed `lp_*` with per-function suffixes (`lp_ini_`, `lp_mt_`,
//     `lp_jn_`, `lp_cu_`, `lp_cl_`). The `lp_` prefix is grep-disjoint
//     from every sibling satellite's prefix in this library:
//     `u8n_`, `gi_`, `wp_`, `cl_`, `ast_`, `sm_`, `sch_sig_`,
//     `cmd_sig_`, `fi_`, `afs_`, `cmdreg_`, `dm_`, `pl_`, `pl_lam_`,
//     `rp_`, `fo_`, `sgr_`, `ll_`, `cc_`, `clo_`, `er_`, `cr_`,
//     `ls_`, `hm_`, `rt_`, `dl_`, `se_`, `te_`, `eu_`, `fh_`, `jc_`,
//     `h_`, `le_`, `ds_`, `ha_`, `ws_`. The `lp_` prefix is also
//     disjoint from paideia-as reserved keywords (`loop`, `if`,
//     `let`, `fn`, `ret`, `done`).
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, LP_MAX_BINDINGS=16,
//     status codes 0x5600..0x5608, magic u32 0x50414343) fit in imm32
//     with bit 31 clear, so direct `cmp reg, imm32` is sign-extension
//     safe.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]` with
//     explicit *1 scale (U1606 mitigation precedent from
//     pipeline_lambda.pdx).
//   - u32 loads via `xor rax, rax; mov_d rax, [base + imm_disp]`
//     (zero-extends; subsequent `cmp` against imm32 magic is sign-safe).
//   - u16 loads via two `mov_b` byte reads: low byte at [+4], high
//     byte at [+5], shifted and OR'd into one qword.
//   - r11 is used freely as a staging register inside each entry point
//     because NONE of the five entry points makes a nested CALL (all
//     five are PURE LEAVES: zero callee-save pushes, zero stack frame,
//     zero nested CALL).
//   - The lattice JOIN / MEET are single-instruction operations
//     (`or rax, rsi` / `and rax, rsi` with rax = rdi); no table lookup.
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE (per entry point)
// =============================================================================
//
//   `_lp_init`               :  zero pushes, zero frame, zero CALLs.
//   `_lp_meet`               :  zero pushes, zero frame, zero CALLs.
//   `_lp_join`               :  zero pushes, zero frame, zero CALLs.
//   `_lp_check_use`          :  zero pushes, zero frame, zero CALLs.
//   `_lp_classify_lambda`    :  zero pushes, zero frame, zero CALLs.
//                               Loop state lives entirely in SysV
//                               scratch regs (r8..r11, rax).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R224.M7.1  LambdaHeader kind-override byte: reserve one u8 in the
//              R224.M1 header's reserved tail and have
//              `_lp_classify_lambda` JOIN the declared override with
//              the computed propagation (caller-declared tightens; it
//              cannot loosen).
//   R224.M7.2  LetScope wire-up: `_ls_pop` folds in a
//              `_lp_check_use(kind, use_count)` call so the elaborator
//              emits the discipline check at every scope-pop.
//   R224.M7.3  Diagnostic surface: `E0840_*` family via the shared
//              diagnostic-collector used by EffectRow (M3) and CapRow
//              (M4) so the shell renders LINEAR_NOT_USED /
//              AFFINE_MULTI_USE / RELEVANT_NOT_USED at the offending
//              source span.
//   R224.M7.4  Let-rec recursive capture: filter the self-capture edge
//              out of the JOIN input so recursive bindings do not
//              trivially fixpoint to LINEAR.
//   R224.M7.5  PipelineLambda wire-up: on `_pl_lam_box`, call
//              `_lp_classify_lambda` and persist the propagated kind
//              in the PipelineLambda record's reserved tail byte.
//   R224.M7.6  CapRow / LinearPropagate composition: a CapRow label
//              that itself carries a Q-A2 substructural tag (e.g. a
//              `cap_mint` with a LINEAR discipline) propagates through
//              `_lp_classify_lambda` the same way a LINEAR binding
//              would.
//
// =============================================================================
// Upstream: paideia-os#2488 (R224 umbrella), paideia-os#2681 (THIS
// ticket, R224.M7). Substrate: paideia-os#2676 (R224.M2 ClosureCapture,
// record shape). Design doc: design/shell/linear-propagation.md.
// Primary citation: Walker, D. "Substructural Type Systems", in
// _Advanced Topics in Types and Programming Languages_ (B. C. Pierce
// ed., MIT Press 2005), chapter 1.

module LinearPropagate = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Error band 0x5600..0x56FF, reserved for R224.M7 linear-propagate.
  // Nine slots used; 247 slots reserved for R224.M7.1..M7.6 follow-ups.

  pub let LP_OK                     : u64 = 0
  pub let LP_ERR_BAD_KIND           : u64 = 0x5600
  pub let LP_ERR_LINEAR_NOT_USED    : u64 = 0x5601
  pub let LP_ERR_LINEAR_MULTI_USE   : u64 = 0x5602
  pub let LP_ERR_AFFINE_MULTI_USE   : u64 = 0x5603
  pub let LP_ERR_RELEVANT_NOT_USED  : u64 = 0x5604
  pub let LP_ERR_BAD_MAGIC          : u64 = 0x5605
  pub let LP_ERR_NULL_PTR           : u64 = 0x5606
  pub let LP_ERR_BAD_INDEX          : u64 = 0x5607
  pub let LP_ERR_BAD_N_BINDINGS     : u64 = 0x5608

  // ==========================================================================
  // SECTION 2 -- SUBSTRUCTURAL KIND CODES (one byte, used as u8)
  // ==========================================================================
  //
  // The two-bit restriction encoding is load-bearing: lattice JOIN is
  // bitwise OR; lattice MEET is bitwise AND. Changing the numeric
  // values of these constants would require rewriting `_lp_join` and
  // `_lp_meet` to use a lookup table.

  pub let LP_KIND_UNRESTRICTED      : u64 = 0
  pub let LP_KIND_AFFINE            : u64 = 1
  pub let LP_KIND_RELEVANT          : u64 = 2
  pub let LP_KIND_LINEAR            : u64 = 3
  pub let LP_UNKNOWN_KIND           : u64 = 0xFF

  // ==========================================================================
  // SECTION 3 -- LAYOUT / BOUND CONSTANTS
  // ==========================================================================
  //
  // Mirrors R224.M2 ClosureCapture layout. Keep in sync with
  // closure_capture.pdx CC_HEADER_MAGIC / CC_MAX_BINDINGS.

  pub let LP_CC_HEADER_MAGIC        : u64 = 0x50414343  // 'CCAP' LE u32
  pub let LP_CC_OFF_MAGIC           : u64 = 0
  pub let LP_CC_OFF_N_BINDINGS      : u64 = 4
  pub let LP_MAX_BINDINGS           : u64 = 16

  // ==========================================================================
  // _lp_init() -> ()
  //
  // Idempotent pure-leaf boot hook. No `.bss` state at M7 so the body
  // is a bare `ret`. Pure leaf; zero pushes, zero stack frame, zero
  // nested CALL. The entry exists so the shell's uniform `*_init`
  // wiring across every pds-parser submodule does not special-case
  // LinearPropagate (precedent: `_pl_lam_init` at R224.M6,
  // `_ds_init` at R222.M8, `_ha_init` at R223.M6, `_ws_init` at
  // R223.M5).
  //
  // Labels prefixed lp_ini_.
  // ==========================================================================
  pub let _lp_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M7 (#2681): _lp_init idempotent boot hook. No `.bss` state at raw M7; body is a bare `ret`. Pure leaf; zero callee-save pushes; zero stack frame; zero nested CALL. The entry exists so the shell's uniform `*_init` wiring across every pds-parser submodule (precedent: `_pl_lam_init` R224.M6, `_ds_init` R222.M8, `_ha_init` R223.M6, `_ws_init` R223.M5) does not special-case LinearPropagate. A future M7.1+ that adds a propagated-kind counter or a user-declared-override intern table in `.bss` populates this body with the lazy-populate shape without an ABI break. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lp_ini_.",
      block: {
      lp_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _lp_meet(k1, k2) -> kind_u8
  //
  //   rdi = k1 (u8 zero-extended)
  //   rsi = k2 (u8 zero-extended)
  //   rax = kind_u8 result OR LP_UNKNOWN_KIND (0xFF) on bad input
  //
  // Lattice MEET under the two-bit restriction encoding: bitwise AND
  // of the restriction bits. Returns LP_UNKNOWN_KIND (0xFF) if either
  // input is > LP_KIND_LINEAR (3). No table lookup; a single `and`
  // instruction over the pre-validated inputs.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lp_mt_.
  // ==========================================================================
  pub let _lp_meet : (u64, u64) -> u64 !{mem} @{} =
    fn (k1: u64) (k2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M7 (#2681): lattice MEET. Validates both inputs are in [0,3]; returns LP_UNKNOWN_KIND (0xFF) on overflow. On a valid pair returns k1 & k2 under the two-bit restriction encoding (bit 0 = no_contraction; bit 1 = no_weakening). The MEET of two kinds is the LESS restrictive kind: the intersection of restrictions. Pure leaf; zero pushes, zero stack frame, zero nested CALL. Both validation cmps use imm8 (3) which is sign-extension safe. The result is bounded in [0,3] after the AND so no explicit mask is needed on return. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lp_mt_.",
      block: {
        cmp rdi, 3;
        ja  lp_mt_bad;
        cmp rsi, 3;
        ja  lp_mt_bad;
        mov rax, rdi;
        and rax, rsi;
        ret;

      lp_mt_bad:
        mov rax, 0xFF;                           // LP_UNKNOWN_KIND
        ret;
      }
    }

  // ==========================================================================
  // _lp_join(k1, k2) -> kind_u8
  //
  //   rdi = k1 (u8 zero-extended)
  //   rsi = k2 (u8 zero-extended)
  //   rax = kind_u8 result OR LP_UNKNOWN_KIND (0xFF) on bad input
  //
  // Lattice JOIN under the two-bit restriction encoding: bitwise OR of
  // the restriction bits. Returns LP_UNKNOWN_KIND (0xFF) if either
  // input is > LP_KIND_LINEAR (3). This is the primitive the elaborator
  // uses most: Walker 2005's propagation rule is JOIN over the captures'
  // kinds.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lp_jn_.
  // ==========================================================================
  pub let _lp_join : (u64, u64) -> u64 !{mem} @{} =
    fn (k1: u64) (k2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M7 (#2681): lattice JOIN. Validates both inputs are in [0,3]; returns LP_UNKNOWN_KIND (0xFF) on overflow. On a valid pair returns k1 | k2 under the two-bit restriction encoding (bit 0 = no_contraction; bit 1 = no_weakening). The JOIN of two kinds is the MORE restrictive kind: the UNION of restrictions. Verifies the non-trivial pair JOIN(AFFINE=1, RELEVANT=2) = 1|2 = 3 = LINEAR -- a closure capturing both an affine and a relevant binding may neither dup nor drop. Pure leaf; zero pushes, zero stack frame, zero nested CALL. Both validation cmps use imm8 (3) which is sign-extension safe. The result is bounded in [0,3] after the OR so no explicit mask is needed on return. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lp_jn_.",
      block: {
        cmp rdi, 3;
        ja  lp_jn_bad;
        cmp rsi, 3;
        ja  lp_jn_bad;
        mov rax, rdi;
        or  rax, rsi;
        ret;

      lp_jn_bad:
        mov rax, 0xFF;                           // LP_UNKNOWN_KIND
        ret;
      }
    }

  // ==========================================================================
  // _lp_check_use(kind, use_count) -> status
  //
  //   rdi = kind (u8 zero-extended; 0..3)
  //   rsi = use_count (u64)
  //   rax = status
  //
  // Validates that a binding of substructural kind `kind` has been
  // used `use_count` times in a way consistent with the lattice
  // (Walker 2005 §1.3):
  //
  //      kind                use_count validity
  //      ---------------     --------------------------------
  //      UNRESTRICTED (0)    any use_count (no constraint)
  //      AFFINE       (1)    use_count in {0, 1}
  //      RELEVANT     (2)    use_count >= 1
  //      LINEAR       (3)    use_count == 1 exactly
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lp_cu_.
  // ==========================================================================
  pub let _lp_check_use : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (use_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M7 (#2681): per-binding substructural-use discipline check. Dispatches on `kind` (rdi) against the four-point lattice. UNRESTRICTED (0): return LP_OK unconditionally. AFFINE (1): LP_ERR_AFFINE_MULTI_USE if use_count > 1; else LP_OK. RELEVANT (2): LP_ERR_RELEVANT_NOT_USED if use_count == 0; else LP_OK. LINEAR (3): LP_ERR_LINEAR_NOT_USED if use_count == 0; LP_ERR_LINEAR_MULTI_USE if use_count > 1; else LP_OK. Kinds > 3 return LP_ERR_BAD_KIND. Pure leaf; zero pushes, zero stack frame, zero nested CALL. All cmp immediates (0, 1, 2, 3, status codes 0x5600..0x5604) fit in imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lp_cu_.",
      block: {
        // kind > 3 is a programming error.
        cmp rdi, 3;
        ja  lp_cu_err_bad_kind;

        // Dispatch on kind.
        cmp rdi, 3;
        je  lp_cu_linear;
        cmp rdi, 2;
        je  lp_cu_relevant;
        cmp rdi, 1;
        je  lp_cu_affine;

        // Fall through: UNRESTRICTED (0). Any use_count admissible.
        xor rax, rax;                            // LP_OK
        ret;

      lp_cu_affine:
        // AFFINE: use_count in {0, 1}. use_count > 1 is a violation.
        cmp rsi, 1;
        ja  lp_cu_err_affine_multi;
        xor rax, rax;                            // LP_OK
        ret;

      lp_cu_relevant:
        // RELEVANT: use_count >= 1.
        cmp rsi, 0;
        je  lp_cu_err_relevant_not_used;
        xor rax, rax;                            // LP_OK
        ret;

      lp_cu_linear:
        // LINEAR: use_count == 1 exactly.
        cmp rsi, 0;
        je  lp_cu_err_linear_not_used;
        cmp rsi, 1;
        ja  lp_cu_err_linear_multi;
        xor rax, rax;                            // LP_OK
        ret;

      lp_cu_err_bad_kind:
        mov rax, 0x5600;                         // LP_ERR_BAD_KIND
        ret;

      lp_cu_err_linear_not_used:
        mov rax, 0x5601;                         // LP_ERR_LINEAR_NOT_USED
        ret;

      lp_cu_err_linear_multi:
        mov rax, 0x5602;                         // LP_ERR_LINEAR_MULTI_USE
        ret;

      lp_cu_err_affine_multi:
        mov rax, 0x5603;                         // LP_ERR_AFFINE_MULTI_USE
        ret;

      lp_cu_err_relevant_not_used:
        mov rax, 0x5604;                         // LP_ERR_RELEVANT_NOT_USED
        ret;
      }
    }

  // ==========================================================================
  // _lp_classify_lambda(lambda_lit_ref, closure_env_ref,
  //                     env_kinds_ref, env_kinds_len) -> packed_u64
  //
  //   rdi = lambda_lit_ref  (reserved for M7.1; may be 0)
  //   rsi = closure_env_ref (ptr to R224.M2 ClosureCapture record; may be 0)
  //   rdx = env_kinds_ref   (ptr to u8[env_kinds_len])
  //   rcx = env_kinds_len   (bound; must be >= n_bindings or BAD_INDEX)
  //   rax = (propagated_kind << 32) | status
  //
  // Walker 2005 propagation rule applied to a R224.M2 ClosureCapture
  // record. For each binding i in [0, n_bindings), the per-binding
  // kind is read from env_kinds_ref[i] (byte stride; one u8 per
  // binding) and JOINed into an accumulator starting at
  // LP_KIND_UNRESTRICTED (0). The final accumulator is the propagated
  // lambda kind packed in the high 32 bits of the return.
  //
  // If closure_env_ref == 0, the lambda has no capture list; the
  // empty-set JOIN is UNRESTRICTED by convention. The packed return
  // is (0 << 32) | LP_OK = 0.
  //
  // If closure_env_ref != 0, the header's magic u32 at [+0] must be
  // 'CCAP' (0x50414343); n_bindings u16 at [+4] must be <=
  // LP_MAX_BINDINGS (16; same bound as R224.M2 CC_MAX_BINDINGS).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL
  // (the lattice JOIN is inlined as `or r10, r11` since calling
  // `_lp_join` would require a stack frame for alignment).
  //
  // Register map:
  //   rsi = closure_env_ref (immutable through the walk)
  //   rdx = env_kinds_ref (immutable)
  //   rcx = env_kinds_len (immutable)
  //   r8  = n_bindings (loaded from header; immutable through walk)
  //   r9  = i (loop counter, 0..n_bindings)
  //   r10 = acc (joined kind, u8 zero-extended)
  //   r11 = per-iter scratch (byte load target)
  //   rax = return packed_u64
  //
  // Labels prefixed lp_cl_.
  // ==========================================================================
  pub let _lp_classify_lambda : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (lambda_lit_ref: u64) (closure_env_ref: u64)
       (env_kinds_ref: u64) (env_kinds_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M7 (#2681): Walker 2005 propagation across a R224.M2 ClosureCapture record. Pure leaf; zero callee-save pushes; zero stack frame; zero nested CALL (the JOIN is inlined as `or r10, r11` because calling `_lp_join` would require a stack frame for SysV alignment). The `lambda_lit_ref` argument (rdi) is reserved for M7.1 (user-declared kind override); raw M7 does NOT dereference it; the caller may pass 0. Flow: if closure_env_ref == 0, return (0 << 32) | LP_OK (empty-set JOIN is UNRESTRICTED by lattice convention). Else load magic u32 at [rsi+0] via `xor rax, rax; mov_d rax, [rsi + 0]`; compare against 0x50414343 ('CCAP' LE); mismatch -> LP_ERR_BAD_MAGIC. Load n_bindings u16 via two byte reads at [rsi+4] (low) and [rsi+5] (high) OR'd into r8; validate r8 <= LP_MAX_BINDINGS (16) else LP_ERR_BAD_N_BINDINGS. Validate env_kinds_len >= n_bindings (rcx >= r8) else LP_ERR_BAD_INDEX. If n_bindings > 0 validate env_kinds_ref != 0 else LP_ERR_NULL_PTR. Init r9 = 0, r10 = 0 (acc = UNRESTRICTED). Loop: if r9 >= r8 break; load env_kinds[r9] as u8 via `xor r11, r11; mov_b r11, [rdx + r9 * 1]`; validate r11 <= 3 else LP_ERR_BAD_KIND; or r10, r11 (JOIN); add r9, 1; jmp top. On loop exit, pack (r10 << 32) | LP_OK into rax: `mov rax, r10; shl rax, 32; ret`. All cmp immediates (0, 3, 16, status codes 0x5600..0x5608, magic 0x50414343) fit in imm32 with bit 31 clear. r11 is used freely (no nested CALL exists). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lp_cl_.",
      block: {
        // ---- closure_env_ref == 0 shortcut: empty capture, UNRESTRICTED.
        cmp rsi, 0;
        je  lp_cl_empty;

        // ---- Validate 'CCAP' magic at [rsi + 0]. ----
        xor rax, rax;
        mov_d rax, [rsi + 0];
        cmp rax, 0x50414343;                     // LP_CC_HEADER_MAGIC
        jne lp_cl_err_bad_magic;

        // ---- Load n_bindings u16 at [rsi + 4..6] into r8. ----
        xor r8, r8;
        xor r11, r11;
        mov_b r11, [rsi + 5];                    // high byte
        shl r11, 8;
        mov_b r8, [rsi + 4];                     // low byte
        or  r8, r11;

        // ---- Validate n_bindings <= LP_MAX_BINDINGS (16). ----
        cmp r8, 16;
        ja  lp_cl_err_bad_nb;

        // ---- If n_bindings == 0 the capture list is empty: UNRESTRICTED.
        cmp r8, 0;
        je  lp_cl_empty;

        // ---- Validate env_kinds_len (rcx) >= n_bindings (r8). ----
        cmp rcx, r8;
        jb  lp_cl_err_bad_index;

        // ---- Validate env_kinds_ref (rdx) != 0 when n_bindings > 0.
        cmp rdx, 0;
        je  lp_cl_err_null;

        // ---- Loop init: i = 0, acc = UNRESTRICTED (0). ----
        xor r9, r9;
        xor r10, r10;

      lp_cl_loop_top:
        cmp r9, r8;
        jae lp_cl_loop_done;

        // Load env_kinds[r9] as u8 via byte load with explicit *1 scale.
        xor r11, r11;
        mov_b r11, [rdx + r9 * 1];

        // Validate the per-binding kind is in [0, 3].
        cmp r11, 3;
        ja  lp_cl_err_bad_kind;

        // JOIN: acc |= kind.
        or  r10, r11;

        add r9, 1;
        jmp lp_cl_loop_top;

      lp_cl_loop_done:
        // Pack return: (acc << 32) | LP_OK.
        mov rax, r10;
        shl rax, 32;
        ret;

        // ---- Shared empty-capture tail: (0 << 32) | LP_OK = 0. ----
      lp_cl_empty:
        xor rax, rax;
        ret;

        // ---- Error paths: status in low 32; propagated_kind in high 32
        //      is 0 (callers ignore the top 32 bits on a non-OK status).
      lp_cl_err_bad_magic:
        mov rax, 0x5605;                         // LP_ERR_BAD_MAGIC
        ret;

      lp_cl_err_null:
        mov rax, 0x5606;                         // LP_ERR_NULL_PTR
        ret;

      lp_cl_err_bad_index:
        mov rax, 0x5607;                         // LP_ERR_BAD_INDEX
        ret;

      lp_cl_err_bad_kind:
        mov rax, 0x5600;                         // LP_ERR_BAD_KIND
        ret;

      lp_cl_err_bad_nb:
        mov rax, 0x5608;                         // LP_ERR_BAD_N_BINDINGS
        ret;
      }
    }

}
