// src/check_fingerprint.pdx -- libpdx-pds-parser.R225.M10 (paideia-os#2691)
//
// CheckFingerprint: parser-tier per-turn TYPECHECK-OUTCOME anti-
// fabrication fingerprint emitter + correlator. Every REPL turn's
// typechecker run (R227.M4 LoadCheck orchestrating R221.M5 Ast +
// R225.M1 HmCore + R225.M6 RankCheck + R225.M7 DiagReport) emits a
// 64-byte CheckFingerprint record whose rendered tag is
// `@fingerprint("check.<turn-id>.<result>")` where `<result>` is
// either the literal `ok` (checker passed) or `fail-<N>` (checker
// emitted N diagnostics). R225.M10 of the typechecker umbrella
// (paideia-os#2489).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R229.M10 TurnFingerprint (sibling, landed Wave 131) lands the
// RESULT-side half of the paideia-os project P9 anti-fabrication
// anchor: every REPL turn emits `@fingerprint("turn.<id>.<hash-hex>")`
// anchoring the actual result bytes. R225.M10 (THIS module) lands the
// TYPECHECK-side half: every REPL turn ALSO emits
// `@fingerprint("check.<id>.<ok|fail-N>")` anchoring the checker's
// PASS/FAIL outcome. The debugger (both the sub-agent debugger and the
// smoke-mode correlation harness) treats this tag as the ground truth
// for every turn's claimed checker outcome.
//
// Position in the substrate graph:
//
//   TTY ISR -> _rl_tick (R229.M1) -> state := EVALUATE
//        -> parser builds AST (R221.M5)
//        -> _lc_check_script(script, len, chain, cap) (R227.M4)
//              -> LC_OK OR LC_ERR_TYPECHECK_FAILED
//        -> _lc_count_diags(chain, cap) -> N
//        -> _cf_emit(turn_id, lc_status, N, out, 64)  (THIS module)
//              -> 64-byte CheckFingerprint record on caller scratch
//        -> _cf_render_tag(record, out, out_cap)
//              -> `@fingerprint("check.<id>.<ok|fail-N>")` ASCII string
//              -> klog emission + stdout emission (R229.M1 driver)
//        -> IFF LC_OK: evaluator dispatch
//        -> state := WRITING -> R229.M9 Renderer + R229.M10 TurnFingerprint
//        -> state := READING -> _rl_emit_prompt
//
// CheckFingerprint is PARSER-TIER by geography (same satellite library
// as HmCore, RankCheck, DiagReport, LoadCheck, TurnFingerprint) but is
// NOT itself a type-checker -- the module computes a hash and renders
// an ASCII tag over the OUTCOME of the type-check. The hash is byte-
// for-byte identical to the parser-family FNV leaves
// (`_cmd_sig_fnv1a64` R222.M2, `_fi_fnv1a64` R222.M3,
// `_cmdreg_fnv1a64` R222.M5, `_ws_schema_hash` R223.M5, the inlined
// FNV in `_h_append` R229.M5, the inlined FNV in `_tf_emit`
// R229.M10) so a cross-boundary correlator comparing hashes from
// different code paths over the same result-string bytes gets
// numerical equality.
//
// Lives user-space because the REPL runs user-space; the state is
// caller-process-local (zero `.bss` at raw M10; every record is
// caller-owned on all four operational paths); the module touches no
// kernel KIND and consumes no capability (caps.decl R225.M10 band
// note).
//
// Why CheckFingerprint is distinct from R229.M10 (TurnFingerprint):
//   * R229.M10 TurnFingerprint hashes the RESULT bytes (opaque to the
//     eyeball; rendered tag carries the raw hash hex).
//   * CheckFingerprint hashes the CHECKER-OUTCOME bytes (semantic
//     "ok" / "fail-N"; rendered tag carries the human-readable form).
//   * Both are 64-byte records on identical stride; both share the
//     `@fingerprint("...")` wrapper; both anchor the P9 invariant on
//     a different half of the per-turn hot path.
//
// Why CheckFingerprint has no `.bss` state:
//   The module is a pure function of its inputs: given (turn_id,
//   lc_result_status, n_diags), the output 64-byte record and its
//   rendered tag are deterministic (modulo the rdtsc timestamp field,
//   which is explicit non-determinism isolated to one u64). The
//   debugger does NOT need a .bss cursor -- the turn_id is caller-
//   supplied by the REPL state machine. Zero `.bss` -> this module is
//   a pure leaf over caller-supplied inputs on all four entry points.
//
// =============================================================================
// CheckFingerprint RECORD -- 64 BYTES
// =============================================================================
//
// Record stride is a power of two (64 = 1 << 6) so a future per-
// session multi-check ring (one row per turn, up to a bounded horizon)
// can index via `shl idx, 6`.
//
//   0x00 u32    magic              'CFPR' (0x52504643 LE) -- reads
//                                   byte-sequentially as byte[0]=0x43 'C',
//                                   byte[1]=0x46 'F', byte[2]=0x50 'P',
//                                   byte[3]=0x52 'R' per the Wave 125
//                                   SortGroupReduce magic-reconciliation
//                                   lesson (byte-sequence readability
//                                   over numeric prettiness). The u32
//                                   fits in imm32 with bit 31 clear so
//                                   direct `cmp reg, imm32` is sign-
//                                   extension-safe.
//   0x04 u32    turn_id             1-based turn counter from the REPL
//                                   state machine; MUST be the SAME
//                                   value R229.M10 TurnFingerprint
//                                   emitted this turn.
//   0x08 u64    result_hash         FNV-1a 64 of the result-string
//                                   bytes ("ok" iff OK branch;
//                                   "fail-<N>" iff FAIL branch where
//                                   <N> is variable-width decimal).
//   0x10 u64    timestamp_us        rdtsc sample at emit time. The REPL
//                                   driver may convert to microseconds
//                                   via TSC calibration (R20.M3) at
//                                   display time; this module stores
//                                   the raw TSC for byte-for-byte
//                                   reproducibility across tools.
//   0x18 u8[32] rendered_tag        Pre-rendered ASCII:
//                                     `check.<id>.<ok|fail-N>`
//                                   where <id> is variable-width
//                                   decimal (1..10 digits, no leading
//                                   zeros) and the result-string is
//                                   either the literal 2-byte "ok" OR
//                                   "fail-" (5 bytes) + variable-width
//                                   decimal N (1..10 digits). NUL-
//                                   padded to 32 bytes. Max rendered
//                                   width is 6 + 10 + 1 + 5 + 10 = 32
//                                   bytes exactly (u32 ceiling turn_id,
//                                   u32 ceiling n_diags, FAIL branch).
//                                   The debugger reads from offset 0
//                                   until first NUL or offset 32,
//                                   whichever comes first.
//   0x38 u64    reserved            Zero at M10; reserved for M10.1+
//                                   (M10.1 adds an `env_mask` u32
//                                   covering the cap-row delta between
//                                   CHECK and READ phases; M10.2 adds a
//                                   `diag_head_offset` u32 locating
//                                   the first LC_DIAG record in the
//                                   same-turn chain).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _cf_init() -> ()
//     Bare `ret` boot hook. M10 holds NO .bss state (every operation
//     is caller-scratched). Kept for parallelism with the parser-
//     family init-hook convention (`_tf_init` R229.M10, `_rd_init`
//     R229.M9, `_ha_init` R223.M6, `_ws_init` R223.M5, `_ds_init`
//     R222.M8, `_dm_init` R222.M6, `_cmdreg_init` R222.M5,
//     `_st_init` R223.M7).
//
//   _cf_emit(turn_id, lc_result_status, n_diags, out, out_cap) -> status
//     rdi = turn_id            (1-based u64; low 32 bits of turn id)
//     rsi = lc_result_status   (0 = OK branch; non-zero = FAIL branch)
//     rdx = n_diags            (0..u32-max; count from _lc_count_diags)
//     rcx = out                (ptr to caller-owned 64-byte scratch)
//     r8  = out_cap            (>= 64)
//     rax = CF_OK or CF_ERR_* in low 32 (no packing; 64 bytes written
//                                on success, unspecified on error)
//
//     Validates (out != 0 -> CF_ERR_BAD_OUT; out_cap >= 64 ->
//     CF_ERR_OUT_TOO_SMALL; turn_id > 0xFFFFFFFF -> CF_ERR_BAD_TURN_ID;
//     n_diags > 0xFFFFFFFF -> CF_ERR_BAD_N_DIAGS). On success: writes
//     64 bytes to out: magic + turn_id + FNV-1a 64 of result-string +
//     rdtsc timestamp + rendered ASCII tag + reserved zero. 6 callee-
//     save push frame (rbx=turn_id, rbp=lc_result_status, r12=n_diags,
//     r13=out, r14=out_cap, r15=hash) with NO nested CALL (FNV
//     inlined; decimal rendering unrolled) so no sub-rsp alignment pad
//     is required (precedent: R229.M5 `_h_append`, R229.M10 `_tf_emit`).
//
//   _cf_render_tag(record, out, out_cap) -> packed_u64
//     rdi = record     (ptr to 64-byte CheckFingerprint record)
//     rsi = out        (ptr to caller-owned output buffer)
//     rdx = out_cap    (>= 16 for the smallest tag:
//                       `@fingerprint("")` = 16 bytes; typical 20..48)
//     rax = (bytes_written << 32) | status
//
//     Emits `@fingerprint("<record.rendered_tag>")` where
//     <record.rendered_tag> is copied from record[+0x18..+0x18+N] up
//     to the first NUL or offset 32 (whichever first). Validates
//     record != 0 (CF_ERR_BAD_RECORD), out != 0 (CF_ERR_BAD_OUT),
//     magic at record[+0..+4] == 'CFPR' (CF_ERR_BAD_MAGIC), and
//     out_cap >= needed (CF_ERR_OUT_TOO_SMALL). Pure leaf; zero
//     callee-save pushes; no stack frame; no nested CALL. Prefix
//     "@fingerprint(\"" (14 B) and suffix "\")" (2 B) emitted as
//     byte-unrolled stores.
//
//   _cf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
//     rdi = expected_tag       (ptr to expected `@fingerprint("...")`
//                               ASCII string)
//     rsi = expected_len       (byte length of expected_tag; >= 16)
//     rdx = actual_record      (ptr to 64-byte CheckFingerprint record)
//     rcx = record_len         (= 64; defensive guard)
//     rax = CF_OK iff the record would render byte-identically to
//           expected_tag, else CF_ERR_MISMATCH or a validation error.
//
//     The debugger's compare entry: given a claimed fingerprint tag
//     (from a tool-call log, a klog capture, or a smoke-mode golden)
//     and the record the shell actually emitted, confirm they refer
//     to the SAME turn's checker outcome. Avoids a stack scratch
//     buffer by:
//       (a) verifying expected_tag begins with `@fingerprint("` (14 B);
//       (b) verifying expected_tag ends with `")` (2 B);
//       (c) extracting inner = expected_tag[14..expected_len-2];
//       (d) byte-comparing inner against record[+0x18..+0x18+N] with
//           the shorter side terminating on first NUL (if the record's
//           inline tag is NUL-padded) or inner's end;
//       (e) requiring N == inner_len (where N is the record's live
//           tag length).
//     Pure leaf; zero callee-save pushes; no stack frame; no nested
//     CALL. Validates record_len == 64 (CF_ERR_BAD_LEN),
//     actual_record != 0 (CF_ERR_BAD_RECORD), expected_tag != 0
//     (CF_ERR_BAD_EXPECTED), magic at record[+0..+4] == 'CFPR'
//     (CF_ERR_BAD_MAGIC), expected_len >= 16 (CF_ERR_BAD_LEN).
//
// Register maps (SysV):
//
//   _cf_init()                                             -> ()
//   _cf_emit(rdi, rsi, rdx, rcx, r8)                       -> rax
//   _cf_render_tag(rdi, rsi, rdx)                          -> rax
//   _cf_correlate(rdi, rsi, rdx, rcx)                      -> rax
//
// =============================================================================
// STATUS-CODE NAMESPACE  --  0x6300..0x63FF
// =============================================================================
//
// CheckFingerprint packed-status range. Nine slots used at R225.M10:
//
//   CF_OK                     = 0        success; 64 B written (emit) or
//                                        packed bytes_written (render)
//   CF_ERR_BAD_OUT            = 0x6300   out == 0 on any entry
//   CF_ERR_OUT_TOO_SMALL      = 0x6301   out_cap below required width
//   CF_ERR_BAD_TURN_ID        = 0x6302   turn_id > 0xFFFFFFFF (upper
//                                        32 set; must fit u32 for the
//                                        record's turn_id field)
//   CF_ERR_BAD_N_DIAGS        = 0x6303   n_diags > 0xFFFFFFFF (upper
//                                        32 set; must fit u32 for the
//                                        decimal rendering ceiling)
//   CF_ERR_BAD_RECORD         = 0x6304   record == 0 (_cf_render_tag /
//                                        _cf_correlate)
//   CF_ERR_BAD_MAGIC          = 0x6305   record[+0..+4] != 'CFPR' LE
//   CF_ERR_MISMATCH           = 0x6306   _cf_correlate: expected_tag's
//                                        inner differs from the
//                                        record's rendered_tag
//   CF_ERR_BAD_LEN            = 0x6307   _cf_correlate: record_len
//                                        != 64 OR expected_len < 16
//                                        OR expected_tag missing
//                                        wrapper
//   CF_ERR_BAD_EXPECTED       = 0x6308   _cf_correlate: expected_tag
//                                        == 0
//
// Slots 0x6309..0x63FF reserved for R225.M10.1+ follow-ups
// (CF_ERR_BAD_ENV_MASK on an M10.1 env-mask field validator;
// CF_ERR_HASH_MISMATCH on an M10.3 strict-mode hash-only correlator
// that recomputes FNV from the result-string bytes;
// CF_ERR_TIMESTAMP_SKEW on an M10.4 rdtsc-skew sanity bound;
// CF_ERR_LC_RESULT_UNKNOWN on an M10.6 four-category outcome adapter).
//
// Band 0x6300..0x63FF is disjoint from every landed parser-tier
// packed-status band (0x3C00..0x62FF; see
// design/shell/check-fingerprint.md §5.1 for the full matrix). The
// 0x6300..0x63FF carve-out sits directly above the R227.M6
// VersionPragma band (0x6200..0x62FF). A downstream compound-error
// dispatcher can discriminate "check-fingerprint faulted" from every
// other sibling satellite's failure modes by
// `shr r, 8; cmp r, 0x63`.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R229.M1 (repl_loop.pdx, kernel) -- drives the fingerprint emission
//     path. After the typechecker (R227.M4 LoadCheck) returns the
//     outcome status + diag count, the REPL calls `_cf_emit(turn_id,
//     lc_status, n_diags, scratch, 64)` into THIS module to produce
//     the record, then calls `_cf_render_tag(scratch, out, out_cap)`
//     to compose the `@fingerprint("...")` string for klog + stdout
//     emission.
//
//   R227.M4 (load_check.pdx) -- supplies the per-turn (lc_status,
//     n_diags) pair that this module anchors. The REPL driver calls
//     `_lc_check_script` to get the status + diag chain, then
//     `_lc_count_diags` to get N, then `_cf_emit` with both.
//
//   R229.M10 (turn_fingerprint.pdx) -- the parallel per-turn record.
//     TurnFingerprint's result_hash FNV covers the RESULT BYTES;
//     CheckFingerprint's result_hash covers the CHECK-OUTCOME string
//     bytes. Both hashes use the same offset basis + prime (standard
//     FNV-1a 64) so numerical equality across them is guaranteed WHEN
//     the input byte streams match.
//
//   design/foundations/project-invariants.md P9 -- the authoritative
//     invariant statement. P9 commits every REPL turn to a verifiable
//     fingerprint anchor; THIS module provides the typecheck-side
//     half of that commitment.
//
//   design/debugger/anti-fabrication-anchors.md (planned R30 doc) --
//     the smoke-mode correlation harness that iterates N turns, feeds
//     synthetic outcomes, captures the emitted tags, and asserts that
//     every tag's inner structure matches
//     `check.<id>.<ok|fail-N>`.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32; the low-
//     nibble mask `and rN, 15` fits imm8.
//   - No 2-op `imul r, imm` -- the FNV multiply is the one-op
//     `mul rcx` form (unsigned 64x64; distinct from the pitfall-
//     listed 2-op shape per the Wave 125 pdx-encoder-pitfalls lesson).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `CheckFingerprint` matches `check_fingerprint.pdx`.
//   - Labels prefixed `cf_` with per-function suffix (`cf_ini_`,
//     `cf_em_`, `cf_rt_`, `cf_co_`). Disjoint from every landed
//     parser-tier prefix (grep-confirmed against `rd_`, `le_`, `vi_`,
//     `ml_`, `lp_`, `st_`, `h_`, `ha_`, `ws_`, `ir_`, `rc_`, `lc_`,
//     `dr_`, `u8n_`, `gi_`, `wp_`, `cl_`, `ast_`, `sm_`, `ss_` /
//     `sch_sig_`, `cmd_sig_`, `fi_`, `afs_`, `cmdreg_`, `dm_`, `ds_`,
//     `pl_`, `pl_lam_`, `rp_`, `fo_`, `sgr_`, `ll_`, `cc_`, `er_`,
//     `cr_`, `ls_`, `hm_`, `rt_`, `eu_`, `dl_`, `se_`, `te_`, `jc_`,
//     `fh_`, `tf_`, `mf_`, `vp_`, `pth_`, `lh_`) and from the
//     paideia-as reserved keywords (`loop`, `if`, `let`, `fn`, `ret`,
//     `done`).
//   - All `cmp reg, imm` immediates (0, 1, 2, 4, 5, 6, 10, 14, 15, 16,
//     31, 32, 56, 64, 128, 4096, 0xFFFFFFFF, byte literals 0x22 '"',
//     0x28 '(', 0x29 ')', 0x2D '-', 0x2E '.', 0x40 '@', 0x61 'a',
//     0x63 'c', 0x65 'e', 0x66 'f', 0x67 'g', 0x68 'h', 0x69 'i',
//     0x6B 'k', 0x6C 'l', 0x6E 'n', 0x6F 'o', 0x70 'p', 0x72 'r',
//     0x74 't', 0x75 'u', hex 0x30 '0'..0x39 '9', status codes
//     0x6300..0x6308, magic 0x52504643 'CFPR') fit imm32 with
//     bit 31 clear so direct `cmp reg, imm32` is sign-safe.
//     0xFFFFFFFF is the one imm32 edge value where bit 31 is set --
//     we stage it via MOVABS into a scratch register and compare
//     register-to-register to avoid sign-extension corner cases.
//     The FNV offset basis 0xCBF29CE484222325 and prime
//     0x100000001B3 are imm64 constants loaded via REX.W+MOV
//     (precedent: _cmd_sig_fnv1a64 line 437, _ws_schema_hash,
//     _h_append embedded FNV, _tf_emit embedded FNV).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     (precedent: FNV-family byte load across the five parser-tier
//     FNV sites).
//   - u32 stores via plain `mov_d [dst + disp], reg` (low 32 of
//     reg).
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - Byte stores: when the index is a register and the base is also
//     a register, precompute the dst address into a scratch register
//     then `mov_b [scratch + i], reg` to sidestep the
//     `mov_b [reg + reg + off], reg` encoder gap (precedent:
//     history.pdx line 663, turn_fingerprint.pdx throughout).
//   - `_cf_init`, `_cf_render_tag`, `_cf_correlate` are PURE LEAVES
//     with zero callee-save pushes and zero nested CALL. r11 is used
//     freely as scratch because no CALL fires.
//   - `_cf_emit` is a 6-callee-save-push frame with ZERO nested CALL
//     (FNV inlined; decimal rendering unrolled). No sub-rsp alignment
//     pad is required when there is no nested CALL (precedent: R229.M5
//     `_h_append`, R229.M10 `_tf_emit`).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M10.1  env-mask field: an additional u32 at [record+0x38..+0x3C]
//               captures the cap-row delta between the CHECK and READ
//               phases of the turn, so the correlator can detect a
//               mid-turn capability drift.
//   R225.M10.2  diag-chain-head field: an additional u32 at
//               [record+0x3C..+0x40] carries the byte offset of the
//               first LC_DIAG record in the chain emitted by the same
//               turn.
//   R225.M10.3  strict-mode hash-only correlator: a second
//               `_cf_correlate_strict(expected_tag, expected_len,
//               lc_status, n_diags)` that RECOMPUTES the FNV from the
//               reconstructed result-string bytes.
//   R225.M10.4  rdtsc-skew sanity bound: the correlator rejects a
//               record whose timestamp precedes the previous turn's.
//   R225.M10.5  Smoke-mode golden corpus: 200-turn session fixture
//               under `smoke/check-fingerprint-m10.golden.txt` with
//               one line per turn carrying the full
//               `@fingerprint("...")` tag, consumed by
//               `tools/verify-check-fingerprint-coverage.sh`.
//   R225.M10.6  4-category outcome adapter: admit (LC_OK /
//               LC_ERR_RANK_VIOLATION / LC_ERR_HM_FAILED /
//               LC_ERR_IMPORT_FAILED) + N and render as
//               `check.<id>.<ok|rank-N|hm-N|import-N>`.
//
// =============================================================================
// Upstream: paideia-os#2489 (R225 typechecker umbrella),
// paideia-os#2691 (THIS ticket, R225.M10 CheckFingerprint),
// paideia-os#2706 (R227.M4 LoadCheck -- the orchestrator whose
// outcome is anchored here), paideia-os#2728 (R229.M10
// TurnFingerprint -- the RESULT-side sibling anchor),
// paideia-os#2688 (R225.M7 DiagReport -- elaborator-tier diagnostic
// surface), paideia-os#2659 (R222.M2 CommandSig -- FNV discipline
// source of truth).
// Design docs: design/shell/check-fingerprint.md (R225.M10, THIS
// landing), design/foundations/project-invariants.md P9 (the
// invariant this module makes verifiable),
// design/shell/turn-fingerprint.md (R229.M10 sibling record),
// design/shell/typecheck-at-load.md (R227.M4 orchestrator),
// design/shell/repl-loop-scaffold.md (R229.M1 umbrella).

module CheckFingerprint = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax low 32 bits)
  // ==========================================================================

  pub let CF_OK                      : u64 = 0
  pub let CF_ERR_BAD_OUT             : u64 = 0x6300
  pub let CF_ERR_OUT_TOO_SMALL       : u64 = 0x6301
  pub let CF_ERR_BAD_TURN_ID         : u64 = 0x6302
  pub let CF_ERR_BAD_N_DIAGS         : u64 = 0x6303
  pub let CF_ERR_BAD_RECORD          : u64 = 0x6304
  pub let CF_ERR_BAD_MAGIC           : u64 = 0x6305
  pub let CF_ERR_MISMATCH            : u64 = 0x6306
  pub let CF_ERR_BAD_LEN             : u64 = 0x6307
  pub let CF_ERR_BAD_EXPECTED        : u64 = 0x6308

  // ==========================================================================
  // SECTION 2 -- RECORD + FIELD CONSTANTS
  // ==========================================================================

  pub let CF_MAGIC                   : u64 = 0x52504643   // 'CFPR' LE
  pub let CF_RECORD_BYTES            : u64 = 64
  pub let CF_RENDERED_TAG_BYTES      : u64 = 32

  // Record field offsets.
  pub let CF_OFF_MAGIC               : u64 = 0
  pub let CF_OFF_TURN_ID             : u64 = 4
  pub let CF_OFF_RESULT_HASH         : u64 = 8
  pub let CF_OFF_TIMESTAMP           : u64 = 16
  pub let CF_OFF_RENDERED_TAG        : u64 = 24
  pub let CF_OFF_RESERVED            : u64 = 56

  // External wrapper widths.
  pub let CF_WRAPPER_PREFIX_BYTES    : u64 = 14   // `@fingerprint("`
  pub let CF_WRAPPER_SUFFIX_BYTES    : u64 = 2    // `")`

  // ==========================================================================
  // SECTION 3 -- POW10 TABLE (for variable-width decimal rendering)
  // ==========================================================================
  //
  // Mirrors R225.M7 DiagReport's `_dr_pow10` layout and R229.M10
  // TurnFingerprint's `_tf_pow10`. The emitter walks this table
  // high-to-low (10^9 down to 10^0) and greedy-subtracts to extract
  // each decimal digit. All values are u32 (ceiling 10^9 =
  // 1_000_000_000 fits u32 with headroom; the full u32 range is
  // 4_294_967_295 which requires the pow index 9 entry).

  pub let _cf_pow10 : [u32; 10] = [
    0x3B9ACA00,                              // 1_000_000_000
    0x05F5E100,                              //   100_000_000
    0x00989680,                              //    10_000_000
    0x000F4240,                              //     1_000_000
    0x000186A0,                              //       100_000
    0x00002710,                              //        10_000
    0x000003E8,                              //         1_000
    0x00000064,                              //           100
    0x0000000A,                              //            10
    0x00000001                               //             1
  ] @align(8)

  // ==========================================================================
  // SECTION 4 -- WRAPPER PREFIX LITERAL
  // ==========================================================================
  //
  // 14-byte constant `@fingerprint("` emitted at the head of every
  // `_cf_render_tag` output. Laid out in .rodata so `_cf_render_tag`
  // can byte-copy without 14 inline mov-imm stores.

  pub let _cf_prefix : [u8; 16] = [
    0x40, 0x66, 0x69, 0x6E, 0x67, 0x65, 0x72, 0x70,     // @fingerp
    0x72, 0x69, 0x6E, 0x74, 0x28, 0x22, 0x00, 0x00      // rint("<2 pad>
  ] @align(8)

  // ==========================================================================
  // _cf_init() -> ()
  //
  //   Bare `ret`. M10 holds NO .bss state.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cf_ini_.
  // ==========================================================================
  pub let _cf_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R225.M10 (#2691): CheckFingerprint holds no .bss state at raw M10 (every operation is caller-scratched on all four entry points). _cf_init is a bare `ret` kept for parallelism with the parser-family init-hook convention (_tf_init R229.M10, _rd_init R229.M9, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5, _st_init R223.M7). Pure leaf; zero pushes; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cf_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _cf_emit(turn_id, lc_result_status, n_diags, out, out_cap) -> status
  //
  //   rdi = turn_id            (1-based; must fit u32)
  //   rsi = lc_result_status   (0 = OK branch; non-zero = FAIL branch)
  //   rdx = n_diags            (0..u32-max)
  //   rcx = out                (ptr to caller-owned 64-byte scratch)
  //   r8  = out_cap            (>= 64)
  //   rax = CF_OK / CF_ERR_*
  //
  //   Writes 64 bytes to out:
  //     [out+0x00..+0x04]  magic 'CFPR'
  //     [out+0x04..+0x08]  turn_id (u32)
  //     [out+0x08..+0x10]  result_hash (FNV-1a 64 of result-string bytes)
  //     [out+0x10..+0x18]  timestamp (rdtsc)
  //     [out+0x18..+0x38]  rendered_tag ASCII `check.<id>.<ok|fail-N>` + NUL pad
  //     [out+0x38..+0x40]  reserved u64 = 0
  //
  //   6 callee-save pushes (rbx=turn_id, rbp=lc_result_status,
  //   r12=n_diags, r13=out, r14=out_cap, r15=hash). No nested CALL
  //   (FNV inlined; decimal rendering unrolled). No sub-rsp
  //   alignment pad needed because no nested CALL fires (precedent:
  //   R229.M5 `_h_append`, R229.M10 `_tf_emit`).
  //
  //   Register plan:
  //     rbx = turn_id (saved input; low 32 are the record's turn_id;
  //                    also the dividend for the decimal rendering)
  //     rbp = lc_result_status (saved input; 0 → OK; else FAIL)
  //     r12 = n_diags (saved input; dividend for the FAIL branch's
  //                    N rendering)
  //     r13 = out (saved input; destination base for every record
  //                field store)
  //     r14 = out_cap (saved input; guard reference)
  //     r15 = hash (populated inline while result-string bytes
  //                 are emitted)
  //
  //   Labels prefixed cf_em_.
  // ==========================================================================
  pub let _cf_emit : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (turn_id: u64) (lc_result_status: u64) (n_diags: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M10 (#2691): _cf_emit produces the 64-byte CheckFingerprint record at [out, out+64). 6 callee-save pushes (rbx=turn_id, rbp=lc_result_status, r12=n_diags, r13=out, r14=out_cap, r15=hash); no nested CALL (FNV inlined; decimal rendering unrolled) so no sub-rsp alignment pad is required (precedent R229.M5 `_h_append`, R229.M10 `_tf_emit`). Guards: out != 0 (CF_ERR_BAD_OUT 0x6300); out_cap >= 64 (CF_ERR_OUT_TOO_SMALL 0x6301); turn_id upper 32 bits != 0 (CF_ERR_BAD_TURN_ID 0x6302 via MOVABS-staged compare); n_diags upper 32 bits != 0 (CF_ERR_BAD_N_DIAGS 0x6303 via MOVABS-staged compare). The upper-32 checks stage 0xFFFFFFFF via MOVABS into a scratch register and compare register-to-register (direct cmp-imm32 with bit 31 set is sign-extension-unsafe). Flow: (1) Store magic 'CFPR' u32 at [r13+0] via mov_d (0x52504643 < 0x80000000). (2) Store turn_id low 32 at [r13+4] via mov_d. (3) Zero-fill rendered_tag region [r13+24..+56] (32 B) via four u64 stores. (4) Emit `check.` (6 bytes 0x63 0x68 0x65 0x63 0x6B 0x2E) at [r13+24..+30] via six mov_b with imm8 disp (r13 base). (5) Decimal-render turn_id (rbx) starting at [r13+30] via greedy-subtract over _cf_pow10[0..10] with emit_flag (rdi = working turn_id, r8 = pow index, rcx = pow value, r9 = digit, r10 = emit_flag, rdx = cursor starting at 6, r11 = scratch, rsi = dst-address compute). Edge case turn_id == 0 emits a single '0'. (6) Emit `.` (0x2E) at the write cursor; cursor++. (7) Pre-FNV: rax = basis 0xCBF29CE484222325 (REX.W+MOV); rcx = prime 0x100000001B3 (REX.W+MOV). This clobbers the pow-value rcx used in step 5, which is fine because step 5 has completed. (8) Branch on rbp (lc_result_status): rbp == 0 -> OK branch; else -> FAIL branch. (9) OK branch: emit byte 'o' (0x6F) at cursor + hash it (xor rax, 0x6F; xor rdx, rdx; mul rcx); cursor++; emit byte 'k' (0x6B) + hash; cursor++. (10) FAIL branch: emit bytes 'f' (0x66), 'a' (0x61), 'i' (0x69), 'l' (0x6C), '-' (0x2D) at cursor advancing by 1 per byte, hashing each. Then decimal-render n_diags (r12) at the cursor via the same greedy-subtract pattern as turn_id, hashing each digit byte as it is emitted (edge case n_diags == 0 emits a single '0'). (11) After step 9 or 10 completes, r15 = rax (final hash). (12) Store r15 at [r13+8] via plain mov. (13) rdtsc; shl rdx, 32; or rax, rdx; mov [r13+16], rax. (14) Zero reserved u64 at [r13+56]. (15) Return CF_OK (rax = 0). Error returns stamp rax to the CF_ERR_* code and jump to the common epilogue which pops r15..rbx and `ret`s. All cmp immediates (0, 1, 2, 6, 10, 24, 30, 56, 64, byte literals 0x2D '-', 0x2E '.', 0x30 '0', 0x61 'a', 0x63 'c', 0x65 'e', 0x66 'f', 0x68 'h', 0x69 'i', 0x6B 'k', 0x6C 'l', 0x6E 'n', 0x6F 'o', shift count 32, status codes 0x6300..0x6303, magic 0x52504643) fit imm32 with bit 31 clear. 0xFFFFFFFF has bit 31 set so it is staged via MOVABS. The two FNV constants (0xCBF29CE484222325, 0x100000001B3) load via REX.W+MOV. No test (every zero-check uses `cmp reg, 0`). No and-imm64 (the one `and r, 15` would fit imm8 but we do not use it here). No 2-op imul-r-imm (the `mul rcx` in FNV is the one-op unsigned-mul form). No multiline let. Labels prefixed cf_em_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Save inputs to callee-save.
        mov rbx, rdi;                        // turn_id
        mov rbp, rsi;                        // lc_result_status
        mov r12, rdx;                        // n_diags
        mov r13, rcx;                        // out
        mov r14, r8;                         // out_cap

        // ---- Guard: out != 0.
        cmp r13, 0;
        je  cf_em_bad_out;

        // ---- Guard: out_cap >= 64.
        cmp r14, 64;
        jb  cf_em_oos;

        // ---- Guard: turn_id upper 32 bits must be clear.
        //      Stage 0xFFFFFFFF via MOVABS; cmp register-to-register.
        mov rax, 0xFFFFFFFF;
        cmp rbx, rax;
        ja  cf_em_bad_turn_id;

        // ---- Guard: n_diags upper 32 bits must be clear.
        //      Stage 0xFFFFFFFF via MOVABS; cmp register-to-register.
        mov rax, 0xFFFFFFFF;
        cmp r12, rax;
        ja  cf_em_bad_n_diags;

        // ===================================================================
        // Write fixed fields: magic, turn_id. Hash + timestamp come later.
        // ===================================================================

        // ---- magic 'CFPR' u32 at [out+0].
        mov rax, 0x52504643;                 // 'CFPR' LE (byte-seq C F P R)
        mov_d [r13 + 0], rax;

        // ---- turn_id u32 at [out+4]  (low 32 of rbx).
        mov_d [r13 + 4], rbx;

        // ===================================================================
        // Rendered-tag write pass: 32 bytes at [out+24..+56].
        // ===================================================================
        //
        // Step 1: zero-fill 32 bytes via four u64 stores. This also
        // handles NUL-padding past the live tail of the ASCII tag.

        xor rax, rax;
        mov [r13 + 24], rax;
        mov [r13 + 32], rax;
        mov [r13 + 40], rax;
        mov [r13 + 48], rax;

        // ---- Emit `check.` (6 bytes) at [out+24..+30].
        //      Each `mov_b [r13 + <const disp>], rax` has imm8 disp.
        mov rax, 0x63;                       // 'c'
        mov_b [r13 + 24], rax;
        mov rax, 0x68;                       // 'h'
        mov_b [r13 + 25], rax;
        mov rax, 0x65;                       // 'e'
        mov_b [r13 + 26], rax;
        mov rax, 0x63;                       // 'c'
        mov_b [r13 + 27], rax;
        mov rax, 0x6B;                       // 'k'
        mov_b [r13 + 28], rax;
        mov rax, 0x2E;                       // '.'
        mov_b [r13 + 29], rax;

        // ---- Decimal-render turn_id (rbx) starting at [out+30].
        //
        //      Greedy-subtract over _cf_pow10[0..10]. Writes at
        //      [out+24+cursor] where cursor advances per emitted digit.
        //      Cursor starts at 6 (just past `check.`).
        //
        //      Register use within this block:
        //        rdi = working turn_id (modifiable copy of rbx)
        //        r8  = pow index (0..9; outer loop)
        //        rcx = pow value (loaded each outer iter from
        //              _cf_pow10[i])
        //        r9  = digit counter per outer iter
        //        r10 = emit_flag (0 initially; 1 once first non-zero
        //              digit emitted)
        //        rdx = cursor (byte offset into rendered_tag; starts
        //              at 6)
        //        r11 = scratch (dst-address compute; char = '0' + d)
        //        rsi = pow table scratch (lea + shl)
        //
        //      Edge case: turn_id == 0. The greedy loop emits nothing
        //      (every digit is 0 and emit_flag stays 0); the fallback
        //      at cf_em_dec_tid_done emits a single '0' and advances
        //      cursor.

        mov rdi, rbx;                        // rdi = working turn_id
        xor r8, r8;                          // i = 0
        xor r10, r10;                        // emit_flag = 0
        mov rdx, 6;                          // cursor = 6

      cf_em_dec_tid_pow_loop:
        cmp r8, 10;
        jae cf_em_dec_tid_done;

        // Load pow = _cf_pow10[i] (u32 stride 4).
        mov rsi, r8;
        shl rsi, 2;
        lea r11, [rip + _cf_pow10];
        add r11, rsi;
        xor rcx, rcx;
        mov_d rcx, [r11 + 0];                // rcx = pow

        // Inner greedy subtract: digit = 0; while rdi >= rcx:
        //                        rdi -= rcx; digit += 1.
        xor r9, r9;                          // digit = 0

      cf_em_dec_tid_sub_loop:
        cmp rdi, rcx;
        jb  cf_em_dec_tid_digit_done;
        sub rdi, rcx;
        add r9, 1;
        jmp cf_em_dec_tid_sub_loop;

      cf_em_dec_tid_digit_done:
        // Emit digit iff digit > 0 OR emit_flag != 0.
        cmp r9, 0;
        jne cf_em_dec_tid_emit;
        cmp r10, 0;
        je  cf_em_dec_tid_next;

      cf_em_dec_tid_emit:
        // char = '0' + digit (0x30 + r9 low byte).
        mov r11, 48;
        add r11, r9;
        // dst = r13 + 24 + cursor.
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;
        mov r10, 1;                          // emit_flag := 1

      cf_em_dec_tid_next:
        add r8, 1;
        jmp cf_em_dec_tid_pow_loop;

      cf_em_dec_tid_done:
        // If nothing was emitted (turn_id was 0), emit a single '0'.
        cmp r10, 0;
        jne cf_em_dec_tid_separator;
        mov r11, 48;                         // '0'
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;

      cf_em_dec_tid_separator:
        // Emit `.` separator at [out+24+cursor].
        mov r11, 46;                         // '.'
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;

        // ===================================================================
        // Pre-FNV: initialise hash accumulator rax = basis; rcx = prime.
        // ===================================================================
        //
        // These load after the decimal rendering completes because
        // the decimal loop uses rcx for the pow value. From this
        // point forward rcx is held as the FNV prime for the
        // inline-hash emit-and-hash sequence.

        mov rax, 0xCBF29CE484222325;         // basis
        mov rcx, 0x100000001B3;              // prime

        // ===================================================================
        // Branch on lc_result_status: 0 -> OK, else -> FAIL.
        // ===================================================================
        cmp rbp, 0;
        jne cf_em_fail_branch;

        // ===================================================================
        // OK branch: emit "ok" (2 bytes) and hash each byte.
        // ===================================================================
        //
        //   rax = hash
        //   rcx = prime (held)
        //   r9  = cursor (copied from rdx on entry; held across the
        //                 inline FNV multiplies which clobber rdx)
        //   rsi = dst-address scratch
        //   r11 = byte to emit + hash input
        //
        // Copy rdx -> r9 on entry.
        mov r9, rdx;

        // Byte 'o' (0x6F) at [out+24+r9]; hash.
        mov r11, 0x6F;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // Byte 'k' (0x6B) at [out+24+r9]; hash.
        mov r11, 0x6B;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        jmp cf_em_hash_done;

      cf_em_fail_branch:
        // ===================================================================
        // FAIL branch: emit "fail-" (5 bytes) and hash each, then
        // decimal-render n_diags and hash each digit.
        // ===================================================================
        //
        //   rax = hash
        //   rcx = prime (held)
        //   r9  = cursor (copied from rdx on entry; held across the
        //                 inline FNV multiplies which clobber rdx)
        //   rsi = dst-address scratch
        //   r11 = byte to emit + hash input
        //
        // Copy rdx -> r9 on entry.
        mov r9, rdx;

        // Byte 'f' (0x66) at [out+24+r9]; hash.
        mov r11, 0x66;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // Byte 'a' (0x61).
        mov r11, 0x61;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // Byte 'i' (0x69).
        mov r11, 0x69;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // Byte 'l' (0x6C).
        mov r11, 0x6C;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // Byte '-' (0x2D).
        mov r11, 0x2D;
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

        // ===================================================================
        // Decimal-render n_diags (r12) at [out+24+r9], hashing each
        // emitted digit byte.
        // ===================================================================
        //
        // Mirrors the turn_id decimal pass but with hash side-effect.
        //
        //   rdi = working n_diags
        //   r8  = pow index (0..9)
        //   r10 = emit_flag (0 initially)
        //   rsi = scratch (pow address compute + dst-address compute)
        //   r11 = pow-value hold (for FNV multiply) and digit scratch
        //
        // After the decimal pass completes, if emit_flag is still 0
        // (n_diags == 0), emit a single '0' and hash it.
        //
        // Register-reuse concern: the inner greedy subtract requires
        // the pow value register. Using rcx would clobber the FNV
        // prime; use a different scratch, hold the pow value in a
        // callee-save register during the subtract. But all callee-
        // saves are taken (rbx/rbp/r12/r13/r14/r15). Alternative: use
        // r11 for the pow value during the inner subtract. The
        // decimal loop only uses r11 for the per-digit char build,
        // which happens AFTER the subtract completes. So r11 can
        // hold the pow value during the subtract.

        mov rdi, r12;                        // working n_diags
        xor r8, r8;                          // i = 0
        xor r10, r10;                        // emit_flag = 0

      cf_em_dec_n_pow_loop:
        cmp r8, 10;
        jae cf_em_dec_n_done;

        // Load pow = _cf_pow10[i] (u32 stride 4) into r11.
        mov rsi, r8;
        shl rsi, 2;
        lea r11, [rip + _cf_pow10];
        add r11, rsi;
        xor rsi, rsi;
        mov_d rsi, [r11 + 0];                // rsi = pow (temporary)
        mov r11, rsi;                        // r11 = pow

        // Inner greedy subtract: digit = 0; while rdi >= r11:
        //                        rdi -= r11; digit += 1.
        // digit held in rsi (fresh scratch; the pow-table lea above
        // is complete so rsi is free).
        xor rsi, rsi;                        // digit = 0

      cf_em_dec_n_sub_loop:
        cmp rdi, r11;
        jb  cf_em_dec_n_digit_done;
        sub rdi, r11;
        add rsi, 1;
        jmp cf_em_dec_n_sub_loop;

      cf_em_dec_n_digit_done:
        // Emit digit iff digit > 0 OR emit_flag != 0.
        cmp rsi, 0;
        jne cf_em_dec_n_emit;
        cmp r10, 0;
        je  cf_em_dec_n_next;

      cf_em_dec_n_emit:
        // char = '0' + digit (0x30 + rsi low byte).
        // Hold char in r11 (byte to emit + hash input). We no longer
        // need the pow value because the subtract is complete.
        mov r11, 48;
        add r11, rsi;
        // dst = r13 + 24 + r9.
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        // Hash the digit byte.
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;
        mov r10, 1;                          // emit_flag := 1

      cf_em_dec_n_next:
        add r8, 1;
        jmp cf_em_dec_n_pow_loop;

      cf_em_dec_n_done:
        // If nothing emitted (n_diags == 0), emit a single '0' and hash.
        cmp r10, 0;
        jne cf_em_hash_done;
        mov r11, 48;                         // '0'
        mov rsi, r13;
        add rsi, 24;
        add rsi, r9;
        mov_b [rsi + 0], r11;
        xor rax, r11;
        xor rdx, rdx;
        mul rcx;
        add r9, 1;

      cf_em_hash_done:
        // ---- Store final hash at [out+8].
        mov r15, rax;
        mov [r13 + 8], r15;

        // ---- Timestamp u64 at [out+16] via rdtsc.
        rdtsc;                               // edx:eax = TSC
        shl rdx, 32;
        or  rax, rdx;
        mov [r13 + 16], rax;

        // ---- Reserved u64 at [out+56] = 0.
        xor rax, rax;
        mov [r13 + 56], rax;

        // ---- Return CF_OK.
        xor rax, rax;
        jmp cf_em_epilogue;

      cf_em_bad_out:
        mov rax, 0x6300;                     // CF_ERR_BAD_OUT
        jmp cf_em_epilogue;

      cf_em_oos:
        mov rax, 0x6301;                     // CF_ERR_OUT_TOO_SMALL
        jmp cf_em_epilogue;

      cf_em_bad_turn_id:
        mov rax, 0x6302;                     // CF_ERR_BAD_TURN_ID
        jmp cf_em_epilogue;

      cf_em_bad_n_diags:
        mov rax, 0x6303;                     // CF_ERR_BAD_N_DIAGS
        jmp cf_em_epilogue;

      cf_em_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cf_render_tag(record, out, out_cap) -> packed_u64
  //
  //   rdi = record     (ptr to 64-byte CheckFingerprint record)
  //   rsi = out        (ptr to caller-owned output buffer)
  //   rdx = out_cap    (>= 16 at minimum)
  //   rax = (bytes_written << 32) | status
  //
  //   Emits `@fingerprint("<inner>")` where <inner> is copied from
  //   record[+24..+24+N] up to the first NUL or offset 32.
  //
  //   Validates:
  //     record != 0                           (CF_ERR_BAD_RECORD)
  //     out != 0                              (CF_ERR_BAD_OUT)
  //     record[+0..+4] == 'CFPR' LE           (CF_ERR_BAD_MAGIC)
  //     out_cap >= 16 + inner_len             (CF_ERR_OUT_TOO_SMALL)
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cf_rt_.
  // ==========================================================================
  pub let _cf_render_tag : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (record: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M10 (#2691): _cf_render_tag emits `@fingerprint(\"<inner>\")` where <inner> is copied from record[+24..+24+N] up to the first NUL or offset 32. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rdi != 0 (CF_ERR_BAD_RECORD 0x6304); rsi != 0 (CF_ERR_BAD_OUT 0x6300); u32 at [rdi+0] == 0x52504643 'CFPR' LE (CF_ERR_BAD_MAGIC 0x6305). (2) Compute inner_len by scanning record+24..record+56 for first NUL (byte load into r11, cmp r11, 0, je done). r9 holds inner_len. (3) Compute needed = 16 + inner_len into r10. (4) Guard rdx >= r10 (CF_ERR_OUT_TOO_SMALL 0x6301). (5) Emit prefix: byte-copy 14 bytes from _cf_prefix[0..14] to rsi[0..14]. Byte-stepping loop with precomputed source + dst bases. (6) Byte-copy inner_len bytes from record+24 to rsi+14. (7) Emit suffix `\")` (2 bytes 0x22 0x29) at [rsi + 14 + inner_len]. (8) Return packed_u64 = (needed << 32) | CF_OK. All cmp immediates (0, 14, 16, 24, 32, 56, byte literals 0x22 0x29, magic 0x52504643, status codes 0x6300..0x6305) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cf_rt_.",
      block: {
        // ---- Guard: record != 0.
        cmp rdi, 0;
        je  cf_rt_bad_record;

        // ---- Guard: out != 0.
        cmp rsi, 0;
        je  cf_rt_bad_out;

        // ---- Guard: magic 'CFPR' at [record+0].
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x52504643;                 // 'CFPR' LE
        jne cf_rt_bad_magic;

        // ---- Compute inner_len by scanning record+24..record+56.
        //
        //   r8  = record + 24 (inner base; precomputed, held across scan)
        //   r9  = i  (inner_len accumulator)
        //
        //   Loop: while i < 32: load byte at [r8 + i]; if 0 break; i++.

        mov r8, rdi;
        add r8, 24;                          // r8 = &record.rendered_tag
        xor r9, r9;                          // r9 = i = 0

      cf_rt_scan_loop:
        cmp r9, 32;
        jae cf_rt_scan_done;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        cmp r11, 0;
        je  cf_rt_scan_done;
        add r9, 1;
        jmp cf_rt_scan_loop;

      cf_rt_scan_done:
        // r9 = inner_len.

        // ---- Compute needed = 16 + inner_len; guard out_cap >= needed.
        mov r10, r9;
        add r10, 16;
        cmp rdx, r10;
        jb  cf_rt_oos;

        // ---- Emit prefix (14 bytes) from _cf_prefix to out[0..14].
        //
        //   lea rcx, [rip + _cf_prefix]  -- src base
        //   xor rax, rax                 -- i = 0
        //   loop: cmp rax, 14; jae done; byte load; byte store; i++.

        lea rcx, [rip + _cf_prefix];
        xor rax, rax;

      cf_rt_pre_loop:
        cmp rax, 14;
        jae cf_rt_pre_done;
        xor r11, r11;
        mov_b r11, [rcx + rax];
        // dst = rsi + rax; precompute into r8-scratch (clobbering the
        // inner-base r8 is safe here because the inner copy that
        // follows re-derives its own base from rdi + 24).
        mov r8, rsi;
        add r8, rax;
        mov_b [r8 + 0], r11;
        add rax, 1;
        jmp cf_rt_pre_loop;

      cf_rt_pre_done:

        // ---- Byte-copy inner bytes from record+24 to out+14 (inner_len
        //      bytes).
        //
        //   r8  = &record[24] (re-derived; loop-held)
        //   rcx = &out[14]    (loop-held dst base)
        //   rax = i           (0..inner_len)
        //   r11 = per-byte source scratch
        //   rdi = per-byte dst-address scratch (we no longer need the
        //         caller's record pointer -- r8 carries the inner base
        //         so rdi is free to clobber as caller-save scratch;
        //         touching r12/rbx/rbp/r13/r14/r15 is OFF LIMITS inside
        //         this pure-leaf frame because there is no callee-save
        //         push bracket to restore them before `ret`)

        mov r8, rdi;
        add r8, 24;
        mov rcx, rsi;
        add rcx, 14;
        xor rax, rax;

      cf_rt_inner_loop:
        cmp rax, r9;
        jae cf_rt_inner_done;
        xor r11, r11;
        mov_b r11, [r8 + rax];
        mov rdi, rcx;
        add rdi, rax;
        mov_b [rdi + 0], r11;
        add rax, 1;
        jmp cf_rt_inner_loop;

      cf_rt_inner_done:

        // ---- Emit suffix `")` (2 bytes 0x22 0x29) at out[14 + inner_len].
        //
        //   dst_base = out + 14 + inner_len; written at [dst+0] and [dst+1].

        mov rcx, rsi;
        add rcx, 14;
        add rcx, r9;
        mov rax, 0x22;                       // '"'
        mov_b [rcx + 0], rax;
        mov rax, 0x29;                       // ')'
        mov_b [rcx + 1], rax;

        // ---- Pack return: (bytes_written << 32) | CF_OK.
        //      bytes_written = 16 + inner_len = r10.
        mov rax, r10;
        shl rax, 32;                         // (needed << 32) | 0
        ret;

      cf_rt_bad_record:
        mov rax, 0x6304;                     // CF_ERR_BAD_RECORD
        ret;

      cf_rt_bad_out:
        mov rax, 0x6300;                     // CF_ERR_BAD_OUT
        ret;

      cf_rt_bad_magic:
        mov rax, 0x6305;                     // CF_ERR_BAD_MAGIC
        ret;

      cf_rt_oos:
        mov rax, 0x6301;                     // CF_ERR_OUT_TOO_SMALL
        ret;
      }
    }

  // ==========================================================================
  // _cf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
  //
  //   rdi = expected_tag
  //   rsi = expected_len
  //   rdx = actual_record
  //   rcx = record_len
  //   rax = CF_OK (0) iff expected_tag renders byte-identically to
  //         `@fingerprint("<actual_record.rendered_tag>")`
  //
  //   The debugger's compare entry. Avoids a scratch buffer by:
  //     (a) verifying expected_tag[0..14] == `@fingerprint("`;
  //     (b) verifying expected_tag[expected_len-2..] == `")`;
  //     (c) extracting inner_len = expected_len - 16;
  //     (d) byte-comparing expected_tag[14..14+inner_len] against
  //         record[+24..+24+inner_len];
  //     (e) requiring record[+24+inner_len] == NUL (or inner_len==32).
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cf_co_.
  // ==========================================================================
  pub let _cf_correlate : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (expected_tag: u64) (expected_len: u64) (actual_record: u64) (record_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M10 (#2691): _cf_correlate compares an expected `@fingerprint(\"check.<id>.<ok|fail-N>\")` tag against the record a shell actually emitted. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rcx == 64 (CF_ERR_BAD_LEN 0x6307); rdx != 0 (CF_ERR_BAD_RECORD 0x6304); rdi != 0 (CF_ERR_BAD_EXPECTED 0x6308); rsi >= 16 (CF_ERR_BAD_LEN); u32 at [rdx+0] == 0x52504643 (CF_ERR_BAD_MAGIC 0x6305). (2) Verify prefix: compare 14 bytes at [expected_tag + 0..14] against _cf_prefix[0..14]. Mismatch -> CF_ERR_BAD_LEN. (3) Verify suffix: byte at [expected_tag + expected_len - 2] == 0x22 '\"' AND byte at [expected_tag + expected_len - 1] == 0x29 ')'. Mismatch -> CF_ERR_BAD_LEN. (4) Compute inner_len = expected_len - 16; guard inner_len <= 32 (CF_ERR_MISMATCH 0x6306 if the record's rendered_tag field only holds 32 bytes). (5) Byte-compare expected_tag[14..14+inner_len] against actual_record[24..24+inner_len]: on any mismatch -> CF_ERR_MISMATCH. (6) If inner_len < 32, verify actual_record[24+inner_len] == 0 (NUL terminator; a record whose rendered_tag is LONGER than the expected inner is a mismatch); else (inner_len == 32) accept as-is since the field maxes at 32 bytes. (7) Return CF_OK. All cmp immediates (0, 1, 2, 14, 16, 32, 56, 64, byte literals 0x22 0x29, magic 0x52504643, status codes 0x6304..0x6308) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cf_co_. r11 is used freely as scratch because no CALL fires.",
      block: {
        // ---- Guard: record_len == 64.
        cmp rcx, 64;
        jne cf_co_bad_len;

        // ---- Guard: actual_record != 0.
        cmp rdx, 0;
        je  cf_co_bad_record;

        // ---- Guard: expected_tag != 0.
        cmp rdi, 0;
        je  cf_co_bad_expected;

        // ---- Guard: expected_len >= 16.
        cmp rsi, 16;
        jb  cf_co_bad_len;

        // ---- Guard: magic 'CFPR' at [actual_record+0].
        xor rax, rax;
        mov_d rax, [rdx + 0];
        cmp rax, 0x52504643;
        jne cf_co_bad_magic;

        // ===================================================================
        // Verify prefix: expected_tag[0..14] vs _cf_prefix[0..14].
        // ===================================================================
        //
        //   r8  = &_cf_prefix (loop-held)
        //   r9  = expected_tag (loop-held source)
        //   rax = i (0..14)
        //   r10 = byte from expected_tag
        //   r11 = byte from _cf_prefix

        lea r8, [rip + _cf_prefix];
        mov r9, rdi;
        xor rax, rax;

      cf_co_pre_loop:
        cmp rax, 14;
        jae cf_co_pre_done;
        xor r10, r10;
        mov_b r10, [r9 + rax];
        xor r11, r11;
        mov_b r11, [r8 + rax];
        cmp r10, r11;
        jne cf_co_bad_len;                   // prefix mismatch = missing wrapper
        add rax, 1;
        jmp cf_co_pre_loop;

      cf_co_pre_done:

        // ===================================================================
        // Verify suffix: expected_tag[expected_len - 2] == '"' AND
        //                expected_tag[expected_len - 1] == ')'.
        // ===================================================================

        mov r8, rsi;
        sub r8, 2;                           // r8 = expected_len - 2
        mov r9, rdi;
        add r9, r8;                          // r9 = &expected_tag[len - 2]
        xor r10, r10;
        mov_b r10, [r9 + 0];
        cmp r10, 0x22;                       // '"'
        jne cf_co_bad_len;
        xor r10, r10;
        mov_b r10, [r9 + 1];
        cmp r10, 0x29;                       // ')'
        jne cf_co_bad_len;

        // ===================================================================
        // Byte-compare inner.
        // ===================================================================
        //
        //   inner_len = expected_len - 16  (prefix 14 + suffix 2)
        //   Guard: inner_len <= 32.
        //   r8 = inner_len
        //   r9 = &expected_tag[14] (source)
        //   r10 = &actual_record[24] (source)
        //   rax = i (0..inner_len)

        mov r8, rsi;
        sub r8, 16;                          // r8 = inner_len
        cmp r8, 32;
        ja  cf_co_mismatch;                  // inner longer than record field

        mov r9, rdi;
        add r9, 14;                          // r9 = &expected_tag[14]
        mov r10, rdx;
        add r10, 24;                         // r10 = &actual_record[24]
        xor rax, rax;

      cf_co_cmp_loop:
        cmp rax, r8;
        jae cf_co_cmp_done;
        xor r11, r11;
        mov_b r11, [r9 + rax];
        xor rcx, rcx;
        mov_b rcx, [r10 + rax];
        cmp r11, rcx;
        jne cf_co_mismatch;
        add rax, 1;
        jmp cf_co_cmp_loop;

      cf_co_cmp_done:

        // ===================================================================
        // If inner_len < 32: verify record[24 + inner_len] == 0 so the
        // record's live tag is not LONGER than the expected inner.
        // ===================================================================

        cmp r8, 32;
        je  cf_co_ok;                        // record tag maxes out at 32

        xor r11, r11;
        mov_b r11, [r10 + r8];               // byte at &record[24 + inner_len]
        cmp r11, 0;
        jne cf_co_mismatch;                  // record has more bytes = mismatch

      cf_co_ok:
        xor rax, rax;                        // CF_OK
        ret;

      cf_co_bad_len:
        mov rax, 0x6307;                     // CF_ERR_BAD_LEN
        ret;

      cf_co_bad_record:
        mov rax, 0x6304;                     // CF_ERR_BAD_RECORD
        ret;

      cf_co_bad_expected:
        mov rax, 0x6308;                     // CF_ERR_BAD_EXPECTED
        ret;

      cf_co_bad_magic:
        mov rax, 0x6305;                     // CF_ERR_BAD_MAGIC
        ret;

      cf_co_mismatch:
        mov rax, 0x6306;                     // CF_ERR_MISMATCH
        ret;
      }
    }

}
