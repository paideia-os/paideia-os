// src/load_check.pdx -- libpdx-pds-parser.R227.M4 (paideia-os#2706)
//
// LoadCheck: parser-tier TYPE-CHECK-AT-LOAD PIPELINE SPINE. Walks a
// pds-lang script body, runs the R225 typechecker over every top-level
// `let` binding, and chains per-binding diagnostics into a caller-owned
// 128-byte-stride record stream. One ORCHESTRATOR primitive that
// composes R221.M5 Ast, R225.M1 HmCore, R225.M6 RankCheck, and R225.M7
// DiagReport (sibling Wave 129 arm; landed) into the single entry
// point the kernel-side R133.M5 TypecheckGate (`_pds_tcg_gate`)
// invokes through its registered user-space checker fn-ptr slot.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R227 is the pds container / loader umbrella (paideia-os#2491). R227.M1
// (header pragmas) landed Wave 112 at the kernel tier; R227.M2 (cap-decl
// checker) landed Wave 115 at the kernel tier; R227.M3 (parser-tier
// `#import` directive + module graph) landed Wave 129 (sibling arm in
// `src/import_resolve.pdx`). R227.M4 (THIS module) lands the parser-tier
// TYPE-CHECK-AT-LOAD orchestrator -- the SPINE that walks the script
// body pre-execution and fails the load on any type error.
//
// Position in the pds-loader pipeline (kernel-side ordering):
//
//   .pds admitted
//        -> R133.M2 caps-decl gate  (`_pds_cdg_gate`)        PASS
//        -> R133.M3 import graph    (`_ig_build_order`)      PASS
//        -> R133.M4 version gate    (`_vg_check`)            PASS
//        -> R133.M5 typecheck gate  (`_pds_tcg_gate`)        DELEGATES
//                              -> _tcg_check_fn (THIS module)
//                                 -> _lc_check_script(body, len, out, cap)
//                                        -> LC_OK  OR
//                                        -> LC_ERR_TYPECHECK_FAILED
//                                           + 128-B diag chain
//        -> STAGE EFFECT DISPATCH   (only on LC_OK)
//
// LoadCheck lives USER-SPACE because the shell runs user-space (the HM
// type system is a satellite library, not a kernel service); the pool
// is caller-process-local (singleton .bss, three u64 scalars + 24 B
// canonical-scheme buffer, 48 B total); the module touches no kernel
// KIND and consumes no capability. See caps.decl R227.M4 band note.
//
// Why a dedicated orchestrator (not a flag on `_rc_check_scheme`):
//
//   * R225.M6 RankCheck validates one scheme byte stream in isolation.
//     R225.M1 HmCore runs unification + instantiation + generalisation
//     over TyNode pool indices with no script-level walk. R221.M5 Ast
//     allocates SyntaxNode records but orchestrates no top-level walk.
//     R229.M3 TypeEnv threads schemes across REPL turns but does not
//     take a script body as input.
//
//   * LoadCheck is ABOVE all of these: one entry per load; walks top-
//     level `let` bindings in textual order; emits diagnostic chain
//     via chained 128-byte records; returns pass/fail. The kernel-side
//     `_pds_tcg_gate` or the standalone `pdsc verify` driver calls
//     `_lc_check_script` ONCE per script and reads the chain on fail.
//
//   * Distinct from R225.M7 DiagReport: R225.M7 (band 0x5B00..0x5BFF,
//     landed Wave 129) emits ELABORATOR-tier type-error diagnostics
//     (magic 'DIAG' = 0x47414944; next_offset at [+120]; expected/
//     actual/suggestion inline strings). LoadCheck emits BINDING-
//     tier load-time failures (magic 'LCDG' = 0x47444C4C; next_offset
//     at [+104]; binding_idx + name/message inline). Both records are
//     128-B stride power-of-two addressable. An M4.1+ landing may
//     embed a DR record INSIDE an LC_DIAG's `message_inline` field as
//     a secondary payload once the elaborator wire-up materialises
//     per-binding DR records.
//
// =============================================================================
// LC_DIAG RECORD LAYOUT  (128 bytes; LoadCheck-local; distinct from R225.M7 DR)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -----------------------------------------------------
//     0      4   magic           u32   'LCDG' LE (0x47444C4C)
//     4      4   code            u32   LC_* or RC_* status code
//     8      4   src_offset      u32   byte offset in script bytes
//    12      4   src_length      u32   byte length of binding span
//    16      1   severity        u8    LC_SEV_* (0=INFO .. 3=FATAL)
//    17      3   reserved        u8[3] zero at M4
//    20      4   binding_idx     u32   0-based position in top-level order
//    24     16   name_inline     u8[16] zero-padded binding name (if parsed)
//    40     64   message_inline  u8[64] zero-padded diagnostic message
//   104      8   next_offset     u64   byte offset of next record (0 = terminal)
//   112     16   reserved        u8[16] zero at M4 (hash + timestamp at M4.1+)
//
//   total: 128 B (LC_DIAG_BYTES)
//
// Stride 128 = 2^7 so addressing uses `shl rN, 7` (precedent: history.pdx
// 128-B History record uses `shl rN, 7`). Magic 'LCDG' = 0x47444C4C LE
// reads as the 4-byte ASCII string "LCDG" in a hex-dump sequential scan
// (byte sequence 4C 43 44 47). Distinct from R225.M7 DiagReport's
// 'DIAG' = 0x47414944 (next_offset at [+120]); the two 128-B records
// serve different tiers of the diagnostic pipeline (LoadCheck emits
// binding-level load-time failures; DiagReport emits elaborator-tier
// type errors). An M4.1+ landing may embed a DR record inside an
// LC_DIAG's `message_inline` field as a secondary payload.
//
// Severity codes:
//
//   LC_SEV_INFO    = 0   (non-blocking; chain still walkable)
//   LC_SEV_WARN    = 1   (surface in prompt; not fail)
//   LC_SEV_ERROR   = 2   (fail load; diagnostic surfaces)
//   LC_SEV_FATAL   = 3   (fail load + abort further checks)
//
// At raw M4 every emitted diag carries `severity = LC_SEV_ERROR` because
// the walker only emits on confirmed-fail bindings.
//
// =============================================================================
// CANONICAL SCHEME  (24 bytes; `.bss`-resident)
// =============================================================================
//
// Phase 4 of the pipeline (per-binding RankCheck) needs a HmCore scheme
// byte stream to validate. At raw M4 the top-level parser is not yet
// landed (R221.M9+ follow-up), so the orchestrator synthesises a
// CANONICAL rank-1 scheme (`∀. u64`) as a stand-in for the elaborator-
// derived scheme that lands at M4.1. The canonical scheme passes
// RankCheck under raw-M6 wire format (every well-formed scheme does),
// but keeps the RankCheck CALL on the pipeline spine so the moment
// M4.1 wires real HmCore-derived schemes, nothing in the orchestrator
// shape has to change.
//
// Canonical scheme bytes (24 B total):
//
//   [+0..+4]   n_bound_vars = 0 (u32)
//   [+4..+8]   n_body_nodes = 1 (u32)
//   [+8..+9]   body[0].kind = 2 (HM_KIND_TYCON)
//   [+9..+10]  body[0].arity = 0
//   [+10..+11] body[0].depth = 0
//   [+11..+12] body[0].flags = 0
//   [+12..+16] body[0].arg0 = 1 (HM_CON_U64, con_id)
//   [+16..+20] body[0].arg1 = 0
//   [+20..+24] body[0].resolved = 0
//
// Lazy-populated by `_lc_init` and by the first-call path inside
// `_lc_check_script`. `.bss` zero-init at cold boot gives every byte
// 0 which does NOT satisfy the canonical shape (kind byte at +8 must
// be 2); the init hook writes the full 24 B.
//
// =============================================================================
// TOP-LEVEL BINDING DETECTION  (ASCII heuristic)
// =============================================================================
//
// At raw M4 the AST parser is not yet landed; `_lc_check_script`
// identifies top-level `let` bindings via an ASCII byte-walker that
// tracks outer brace/paren depth and matches the keyword at proper
// token boundaries:
//
//   boundary_before(i)  :=  i == 0  OR  bytes[i-1] in {LF, CR, SP, TAB, ';'}
//   boundary_after(i+3) :=  bytes[i+3] in {LF, CR, SP, TAB}
//   outer_depth(i)      :=  brace_depth == 0 AND paren_depth == 0
//
//   is_top_let(i) iff
//     outer_depth(i)
//     AND boundary_before(i)
//     AND bytes[i..i+3] == "let"
//     AND boundary_after(i+3)
//
// When a top-level `let` is found at offset i, the walker scans forward
// to the next top-level `;` or EOF; this slice is the BINDING SPAN. The
// orchestrator then validates three syntactic preconditions:
//
//   (a) span contains at least one `=` byte;
//   (b) local brace_depth and paren_depth inside the span return to 0;
//   (c) RHS (bytes after the first `=`) has at least one non-WS byte
//       other than `;`.
//
// Failure of (a) / (b) / (c) emits a diag record with code
// `LC_ERR_BAD_SCHEME` (0x5C04) and severity `LC_SEV_ERROR` (2); otherwise
// the orchestrator calls `_rc_check_scheme(_lc_canon_scheme, 24)` and
// emits a diag with `code = <returned status>` on non-OK.
//
// M4.1 replaces the three-precondition syntactic check with REAL HM
// inference against the elaborator-derived scheme. The syntactic
// checks SATISFY THE RAW-M4 ACCEPTANCE anchor (5 well-typed + 5 ill-
// typed fixtures; see design/shell/typecheck-at-load.md §7).
//
// Comment handling: `(* ... *)` opens outer paren depth 1 (because `(`
// is a paren byte), which naturally gates `let` detection off while
// inside the comment. `//` and `/* */` comments are NOT recognised at
// raw M4 (the AST parser at M4.1+ absorbs the real comment grammar).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _lc_init() -> ()
//     Boot hook. Scrubs `_lc_binding_count`, `_lc_last_fail_code`, and
//     `_lc_diag_emit_count` (three u64 scalars = 24 B). Writes the
//     canonical scheme bytes into `_lc_canon_scheme` (24 B). Idempotent.
//     Pure leaf; zero pushes; no stack frame; no nested CALL.
//
//   _lc_check_script(script_body, body_len, out_diag_chain, out_cap)
//                                                   -> status
//     rdi = script_body     byte pointer to the script source
//     rsi = body_len        byte length of the script
//     rdx = out_diag_chain  caller-owned buffer for the diag chain
//     rcx = out_cap         capacity of out_diag_chain in bytes
//     rax = LC_OK / LC_ERR_* code
//
//     The ONE entry per load. Validates buffer shapes; byte-walks the
//     script for top-level `let` bindings; for each, validates
//     syntactic preconditions AND calls `_rc_check_scheme` on the
//     canonical scheme; emits a 128-B diag record on fail and chains
//     via the `next_offset` field. Returns `LC_OK` iff no diag was
//     emitted; `LC_ERR_TYPECHECK_FAILED` (0x5C00) iff at least one
//     diag was emitted; `LC_ERR_BAD_SCRIPT` / `LC_ERR_OUT_TOO_SMALL`
//     / `LC_ERR_TOO_MANY_BINDINGS` on surface violations.
//
//   _lc_count_diags(diag_chain, chain_len) -> u64
//     rdi = diag_chain
//     rsi = chain_len
//     rax = count of valid DiagReport records visible via the chain
//
//     Walks diag_chain starting at offset 0; follows `next_offset`
//     until it reaches 0 OR exceeds chain_len OR 64 iterations (cycle
//     guard). Returns the count. Pure leaf.
//
// Register maps (SysV):
//
//   _lc_init()                                            -> rax
//   _lc_check_script(rdi, rsi, rdx, rcx)                  -> rax
//   _lc_count_diags(rdi, rsi)                             -> rax
//
// =============================================================================
// STATUS BAND  --  0x5C00..0x5CFF
// =============================================================================
//
//   LC_OK                        = 0
//   LC_ERR_TYPECHECK_FAILED      = 0x5C00    at least one binding failed
//   LC_ERR_BAD_SCRIPT            = 0x5C01    script_body == 0 OR body_len == 0
//   LC_ERR_OUT_TOO_SMALL         = 0x5C02    out == 0 OR out_cap < 128
//   LC_ERR_TOO_MANY_BINDINGS     = 0x5C03    binding count > 64
//   LC_ERR_BAD_SCHEME            = 0x5C04    synthetic (precond fail)
//   LC_ERR_RANK_VIOLATION        = 0x5C05    pass-through from RankCheck
//   LC_ERR_PARSE_FAILED          = 0x5C06    reserved for M4.1 Ast wire-up
//   LC_ERR_HM_FAILED             = 0x5C07    reserved for M4.1 HmCore wire-up
//   LC_ERR_IMPORT_FAILED         = 0x5C08    reserved for M4.2 ImportResolve wire-up
//
// Slots 0x5C09..0x5CFF reserved for M4.1+ follow-ups (binding-level
// cycle detect, synthetic-span discipline, LSP-hover attach, per-
// chain fingerprint).
//
// The 0x5C00..0x5CFF carve-out sits above the 0x5B00..0x5BFF R225.M7
// DiagReport band (landed Wave 129 as a sibling parallel arm) and
// above the 0x5A00..0x5AFF R229.M8 MultiLine band. Disjoint from every other
// parser-tier packed-status range. A downstream compound-error
// dispatcher can discriminate "the type-check-at-load gate rejected"
// from every other satellite's failure modes via
// `shr r, 8; cmp r, 0x5C`.
//
// Grep confirmation at R227.M4 landing time:
//
//   grep -rE '0x5C(0[0-8])\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/typecheck-at-load.md.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- band values 0x5C00..0x5C08 fit imm32.
//   - No 2-op `imul r, imm` -- 128-byte DiagReport stride uses
//     `shl rN, 7`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `LoadCheck` matches `load_check.pdx`.
//   - Labels prefixed `lc_` with per-function suffix (`lc_ini_`,
//     `lc_cs_`, `lc_cd_`). Grep-confirmed disjoint from every landed
//     parser-tier label prefix (u8n_, gi_, wp_, cl_, ast_, sm_, fh_,
//     sch_sig_, cmd_sig_, fi_, afs_, cmdreg_, dm_, ds_, pl_, rp_,
//     fo_, sgr_, ws_, ha_, st_, ll_, cc_, er_, cr_, ls_, pl_lam_,
//     lp_, hm_, rt_, eu_, dl_, se_, te_, jc_, h_, le_, vi_, ml_,
//     ir_, rc_) and the kernel-side `tcg_` prefix (R133.M5) so a
//     future linker-level audit does not confuse the two halves of
//     the typecheck-at-load pipeline. Also disjoint from the paideia-
//     as reserved-keyword set (loop, if, let, fn, ret, done).
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 24, 64, 128,
//     ASCII literals 0x09, 0x0A, 0x0D, 0x20, 0x28, 0x29, 0x3B, 0x3D,
//     0x65, 0x6C, 0x74, 0x7B, 0x7D, magic 0x47444C4C, status codes
//     0x5C00..0x5C08) fit imm32 with bit 31 clear so direct cmp-imm32
//     is sign-extension-safe. No MOVABS staging needed.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx * 1]`.
//   - Byte stores via `mov_b [base + disp], reg` or precomputed
//     `mov r9, base; add r9, idx; mov_b [r9 + 0], reg`.
//   - u32 stores via `mov_d [dst + disp], reg`.
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - No chained-displacement operands `[reg + a + b]`: every
//     address is `[reg + disp]` or `[reg + idx * 1]`.
//   - Cross-module `.bss` writes via `lea r11, [rip + sym]; mov [r11], reg`.
//   - Full-u64 status compares not needed (every status is imm32 safe).
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
//   * `_lc_init`: zero callee-save pushes (pure leaf; no CALL).
//
//   * `_lc_check_script`: 6-push callee-save frame (rbx, rbp, r12,
//     r13, r14, r15 = 48 bytes) + `sub rsp, 40` (five u64 scratch
//     slots). Entry rsp%16==8; after prologue rsp%16==0 at every
//     nested CALL to `_rc_check_scheme`. Register plan:
//       rbx = script_body        (held through entire walk)
//       rbp = body_len
//       r12 = out_diag_chain
//       r13 = out_cap
//       r14 = i (outer cursor into script_body)
//       r15 = diag_write_offset  (bytes written to out_diag_chain)
//     Stack slots:
//       [rsp +  0] = outer brace_depth
//       [rsp +  8] = outer paren_depth
//       [rsp + 16] = binding_count
//       [rsp + 24] = current binding src_offset  (preserved across CALL)
//       [rsp + 32] = current binding src_length  (preserved across CALL)
//     Scratch (across CALL): rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11.
//     After the CALL to `_rc_check_scheme`, rax carries RankCheck's
//     status (RC_OK / RC_ERR_*); the orchestrator preserves it in rcx
//     before emitting the diag.
//
//   * `_lc_count_diags`: zero callee-save pushes (pure leaf; no CALL).
//     Register plan: rbx-free; uses rax (count), rcx (cursor offset),
//     rdx (iteration guard), r8 (temp), r9 (magic read).
//     Entry rsp%16==8; `ret` leaves rsp%16==0.
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// R227.M4 holds FOUR `.bss` singletons: three u64 scalars
// (`_lc_binding_count`, `_lc_last_fail_code`, `_lc_diag_emit_count`) +
// one 24-byte canonical-scheme buffer (`_lc_canon_scheme`). `.bss`
// zero-init at cold boot gives every byte 0, which satisfies the
// scalar invariant BUT NOT the canonical-scheme invariant (kind byte
// at [+8] must be 2 = HM_KIND_TYCON). `_lc_init` writes the full 24 B
// of canonical bytes.
//
// `_lc_check_script` reads the kind byte at [_lc_canon_scheme + 8]
// and lazy-populates the full canonical scheme on first observation
// of 0. This permits a caller that forgets to call `_lc_init` to still
// get correct behaviour on the first `_lc_check_script` call
// (precedent: `_hm_fresh_var` lazy-inits `_hm_pool_next`; `_rt_find`
// lazy-inits `_rt_pool_next`).
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R225.M6 (rank_check.pdx)  --  `_lc_check_script` CALLs
//     `_rc_check_scheme` once per top-level `let` binding found. The
//     canonical scheme passes under raw-M6 wire format; the gate is
//     wired for the moment M4.1 wire-format extension lands.
//
//   R225.M1 (hm_core.pdx)  --  the canonical scheme at raw M4 encodes
//     a HmCore TyCon over `HM_CON_U64 = 1`. No HmCore CALL happens at
//     raw M4; M4.1 wires `_hm_generalise` + `_hm_instantiate` once
//     the top-level parser materialises binding RHS types.
//
//   R221.M5 (ast.pdx)  --  the AST pool is not materialised at raw
//     M4 (ASCII heuristic suffices for top-level `let` detection).
//     M4.1 wires `_ast_alloc` / `_ast_set_source` / `_ast_render`
//     once the top-level parser lands.
//
//   R225.M7 (diag_report.pdx; sibling parallel arm, landed Wave 129)
//     --  R225.M7 emits ELABORATOR-tier type-error diagnostics
//     (`_dr_build`, `_dr_render_lsp`, `_dr_render_human`; magic 'DIAG'
//     = 0x47414944; next_offset at [+120]; expected/actual/suggestion
//     inline strings). LoadCheck emits BINDING-tier load-time
//     failures with a different 128-B record (magic 'LCDG';
//     next_offset at [+104]; binding_idx + name/message inline). The
//     two records are distinct; an M4.1+ landing may embed a DR
//     record inside LC_DIAG's `message_inline` field as a secondary
//     payload when the elaborator wire-up materialises per-binding
//     DR records.
//
//   R227.M3 (import_resolve.pdx)  --  `_ir_build_graph` +
//     `_ir_detect_cycle` are consulted by `_lc_check_script` at M4.2
//     (before the top-level let walk) to emit `LC_ERR_IMPORT_FAILED`
//     on cycle/resolve-fault. Not wired at raw M4.
//
//   R133.M5 (src/kernel/core/pds/typecheck_gate.pdx)  --  the kernel-
//     side gate registers `_lc_check_script` via
//     `_pds_tcg_register_checker` at REPL boot. The registration
//     shim converts the kernel's PipelineBody format
//     (TCG_MAGIC = 'PIPB') to the parser-tier script-body byte
//     stream LoadCheck consumes; the shim lands at M4.4.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R227.M4.1  Wire real HmCore inference per binding; replace the
//              canonical scheme with elaborator-derived schemes; emit
//              TYFORALL diags surfaced through the body kind-byte
//              extension (R225.M4.1).
//   R227.M4.2  ImportResolve wire-up: run `_ir_build_graph` +
//              `_ir_detect_cycle` before the top-level let walk; emit
//              `LC_ERR_IMPORT_FAILED` on cycle/resolve-fault.
//   R227.M4.3  AST pretty-print of the failing binding into the diag's
//              `message_inline` field (requires R221.M5.1 child-aware
//              `_ast_render`).
//   R227.M4.4  Kernel-side `_pds_tcg_register_checker` wire-up: a
//              thin shim adapts the PipelineBody format to the
//              script-body byte stream LoadCheck consumes; registers
//              at REPL boot.
//   R227.M4.5  Standalone `pdsc verify` driver that calls
//              `_lc_check_script` over an on-disk `.pds` file.
//   R227.M4.6  FNV-1a 64 hash of the binding name into the diag
//              record's reserved u64 at [+112] for dedup across
//              concurrent loads.
//   R227.M4.7  rdtsc timestamp into the diag record's reserved u64
//              at [+120] for ordering within a load's chain.
//
// =============================================================================
// Upstream: paideia-os#2491 (R227 pds container umbrella), paideia-os
// #2706 (THIS ticket, R227.M4 Type-check-at-load pipeline). Mirror:
// paideia-os#2624 (R133.M5 kernel-side TypecheckGate) -- the kernel
// gate invokes this orchestrator through its registered fn-ptr slot.
// Design doc: design/shell/typecheck-at-load.md.

module LoadCheck = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax low 32 bits)
  // ==========================================================================
  //
  // Small-value range 0x5C00..0x5CFF, reserved for the R227.M4 type-
  // check-at-load band. Disjoint from every landed satellite band
  // including the sibling Wave 129 arm R225.M7 DiagReport
  // (0x5B00..0x5BFF).

  pub let LC_OK                        : u64 = 0
  pub let LC_ERR_TYPECHECK_FAILED      : u64 = 0x5C00
  pub let LC_ERR_BAD_SCRIPT            : u64 = 0x5C01
  pub let LC_ERR_OUT_TOO_SMALL         : u64 = 0x5C02
  pub let LC_ERR_TOO_MANY_BINDINGS     : u64 = 0x5C03
  pub let LC_ERR_BAD_SCHEME            : u64 = 0x5C04
  pub let LC_ERR_RANK_VIOLATION        : u64 = 0x5C05
  pub let LC_ERR_PARSE_FAILED          : u64 = 0x5C06
  pub let LC_ERR_HM_FAILED             : u64 = 0x5C07
  pub let LC_ERR_IMPORT_FAILED         : u64 = 0x5C08

  // ==========================================================================
  // SECTION 2 -- DIAG RECORD + SEVERITY CODES
  // ==========================================================================

  pub let LC_DIAG_BYTES          : u64 = 128
  pub let LC_DIAG_MAGIC          : u64 = 0x47444C4C   // 'LCDG' LE

  // Field offsets within one DiagReport-shaped record.
  pub let LC_DIAG_OFF_MAGIC       : u64 = 0           // u32
  pub let LC_DIAG_OFF_CODE        : u64 = 4           // u32
  pub let LC_DIAG_OFF_SRC_OFFSET  : u64 = 8           // u32
  pub let LC_DIAG_OFF_SRC_LENGTH  : u64 = 12          // u32
  pub let LC_DIAG_OFF_SEVERITY    : u64 = 16          // u8
  pub let LC_DIAG_OFF_BINDING_IDX : u64 = 20          // u32
  pub let LC_DIAG_OFF_NAME        : u64 = 24          // u8[16]
  pub let LC_DIAG_OFF_MESSAGE     : u64 = 40          // u8[64]
  pub let LC_DIAG_OFF_NEXT        : u64 = 104         // u64

  // Severity codes.
  pub let LC_SEV_INFO   : u64 = 0
  pub let LC_SEV_WARN   : u64 = 1
  pub let LC_SEV_ERROR  : u64 = 2
  pub let LC_SEV_FATAL  : u64 = 3

  // Walker ceiling.
  pub let LC_MAX_BINDINGS : u64 = 64

  // Canonical-scheme buffer size (mirrors HmCore scheme wire format
  // header + one TyCon body node = 8 + 16 = 24 B).
  pub let LC_CANON_SCHEME_BYTES : u64 = 24

  // ==========================================================================
  // SECTION 3 -- STATIC STATE (.bss, singleton; 48 B total)
  // ==========================================================================
  //
  // `_lc_binding_count`, `_lc_last_fail_code`, `_lc_diag_emit_count`
  // track the last `_lc_check_script` call's progress for test-time
  // inspection (not read by the orchestrator proper). The 24-byte
  // `_lc_canon_scheme` buffer is lazy-populated by `_lc_init` and by
  // the first `_lc_check_script` call that observes kind byte == 0 at
  // [+8].

  pub let mut _lc_binding_count   : u64        = uninit @align(8)
  pub let mut _lc_last_fail_code  : u64        = uninit @align(8)
  pub let mut _lc_diag_emit_count : u64        = uninit @align(8)
  pub let mut _lc_canon_scheme    : [u8; 24]   = uninit @align(8)

  // ==========================================================================
  // _lc_init() -> ()
  //
  //   Defensive scrub of the three u64 scalars + write of the
  //   canonical rank-1 scheme (`∀. u64`) into `_lc_canon_scheme`.
  //   `.bss` zero-init at cold boot satisfies the scalar invariant;
  //   the canonical-scheme bytes (kind=2 at +8; con_id=1 at +12;
  //   n_body=1 at +4) are NOT zero and must be written explicitly.
  //
  //   Idempotent in the trivial sense: re-writing the same canonical
  //   bytes to the same slot is a no-op in effect.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lc_ini_.
  // ==========================================================================
  pub let _lc_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M4 (#2706): defensive scrub of _lc_binding_count / _lc_last_fail_code / _lc_diag_emit_count (three u64 scalars) + canonical scheme write (24 bytes at _lc_canon_scheme). .bss zero-init at cold boot already satisfies the scalar invariant; the canonical scheme (`∀. u64` = HmCore scheme-wire with n_bound_vars=0, n_body_nodes=1, body=[TYCON(con_id=HM_CON_U64=1, arity=0)]) requires explicit writes of non-zero bytes (kind=2 at +8, n_body=1 at +4, con_id=1 at +12). Pure leaf; zero pushes; no stack frame; no nested CALL. Scalar stores via `lea r11, [rip + sym]; mov [r11], rax` with rax=0. Canonical-scheme stores: n_bound_vars (u32 @ +0) = 0 via mov_d; n_body_nodes (u32 @ +4) = 1 via mov_d with rax=1; kind byte (u8 @ +8) = 2 via mov_b with rax=2; arity (u8 @ +9) = 0; depth (u8 @ +10) = 0; flags (u8 @ +11) = 0; arg0 u32 (u32 @ +12) = 1 (HM_CON_U64); arg1 u32 (u32 @ +16) = 0; resolved u32 (u32 @ +20) = 0. All immediates (0, 1, 2) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lc_ini_.",
      block: {
        // ---- Scrub scalars (three u64 = 24 B).
        xor rax, rax;

        lea r11, [rip + _lc_binding_count];
        mov [r11], rax;

        lea r11, [rip + _lc_last_fail_code];
        mov [r11], rax;

        lea r11, [rip + _lc_diag_emit_count];
        mov [r11], rax;

        // ---- Write canonical scheme (24 B).
        lea r11, [rip + _lc_canon_scheme];

        // n_bound_vars (u32 @ +0) = 0.
        xor rax, rax;
        mov_d [r11 + 0], rax;

        // n_body_nodes (u32 @ +4) = 1.
        mov rax, 1;
        mov_d [r11 + 4], rax;

        // body[0].kind (u8 @ +8) = 2 (HM_KIND_TYCON).
        mov rax, 2;
        mov_b [r11 + 8], rax;

        // body[0].arity / depth / flags (u8[3] @ +9..+12) = 0.
        xor rax, rax;
        mov_b [r11 + 9], rax;
        mov_b [r11 + 10], rax;
        mov_b [r11 + 11], rax;

        // body[0].arg0 (u32 @ +12) = 1 (HM_CON_U64).
        mov rax, 1;
        mov_d [r11 + 12], rax;

        // body[0].arg1 (u32 @ +16) = 0.
        xor rax, rax;
        mov_d [r11 + 16], rax;

        // body[0].resolved (u32 @ +20) = 0.
        mov_d [r11 + 20], rax;

        ret;
      }
    }

  // ==========================================================================
  // _lc_check_script(script_body, body_len, out_diag_chain, out_cap)
  //                                                   -> status
  //
  //   rdi = script_body
  //   rsi = body_len
  //   rdx = out_diag_chain
  //   rcx = out_cap
  //   rax = LC_OK / LC_ERR_*
  //
  // The one entry per load. See the top-of-file API block for the
  // full pipeline shape. 6-push + sub rsp, 40 (five u64 scratch
  // slots) frame; entry rsp%16==8, after prologue rsp%16==0 at every
  // nested CALL to `_rc_check_scheme`.
  //
  // Labels prefixed lc_cs_.
  // ==========================================================================
  pub let _lc_check_script : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (script_body: u64) (body_len: u64)
       (out_diag_chain: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M4 (#2706): _lc_check_script walks a pds-lang script body, locates top-level `let` bindings via ASCII heuristic (brace/paren depth tracked outer-level; keyword 'let' at a line/semicolon boundary with WS after), validates three syntactic preconditions per binding (span contains '=', local balance returns to 0, RHS non-empty), calls _rc_check_scheme on a canonical rank-1 scheme per binding, emits 128-byte DiagReport-shaped records into the caller-owned out_diag_chain buffer on failure, chains them via next_offset at +104. 6 callee-save pushes (rbx=script_body, rbp=body_len, r12=out_diag_chain, r13=out_cap, r14=i cursor, r15=diag_write_offset) + sub rsp,40 (five scratch slots: outer brace_depth @ +0, outer paren_depth @ +8, binding_count @ +16, binding src_offset @ +24, binding src_length @ +32) = 88 bytes added; entry rsp%16==8 so after prologue rsp%16==0 and every nested CALL to _rc_check_scheme sees aligned stack. Phase 0: validate script_body != 0, body_len > 0 (LC_ERR_BAD_SCRIPT); out_diag_chain != 0, out_cap >= LC_DIAG_BYTES 128 (LC_ERR_OUT_TOO_SMALL). Phase 1: lazy-populate _lc_canon_scheme iff kind byte at [+8] == 0 (bss cold-boot sentinel); writes the same 24 bytes _lc_init would. Phase 2: initialise scratch (brace_depth = paren_depth = binding_count = 0; cursor i = 0; diag_write_offset = 0). Phase 3: outer walk over script bytes. For each byte: branch on '{' '}' '(' ')' to update outer depth with 0-floor clamp; on 'l' at depth==0 AND prev byte is {LF,CR,SP,TAB,';',BOF} AND bytes[i+1..i+3] == 'e','t' AND bytes[i+3] is {LF,CR,SP,TAB}, enter inner scan. Inner scan: advance past 'let ' (4 bytes); scan until next top-level ';' or EOF tracking local brace/paren depth (r8/r9) and has_eq flag (r10). On inner done: validate has_eq == 1 (else emit diag with code LC_ERR_BAD_SCHEME 0x5C04); validate inner r8 == 0 AND r9 == 0 (else emit syntactic diag); re-walk inside span to confirm RHS (bytes after first '=') has at least one non-WS, non-';' byte (else emit syntactic diag). If all preconditions pass: call _rc_check_scheme(_lc_canon_scheme, 24); preserve rax in rcx; if rcx != 0 emit diag with code = rcx. Diag emit: zero-fill 128 bytes at [r12 + r15]; write magic 'LCDG' u32 at +0 via mov_d; code u32 at +4; src_offset u32 at +8; src_length u32 at +12; severity u8 (= LC_SEV_ERROR = 2) at +16; binding_idx u32 at +20; name_inline/message_inline zero-filled via u64 stores at +24, +32, +40..+96 (sixteen 8-byte zero stores covering 24..104); next_offset u64 at +104 = r15 + 128 (speculative; patched to 0 at end). After each emit r15 += 128. Capacity check per emit: if r15 + 128 > r13 skip emit but still count binding. Phase 4: patch last diag's next_offset to 0 iff r15 > 0 (compute last_slot = r12 + r15 - 128; zero at +104). Phase 5: decide: r15 == 0 -> LC_OK; else LC_ERR_TYPECHECK_FAILED 0x5C00. Binding-count overflow: binding_count > LC_MAX_BINDINGS 64 -> LC_ERR_TOO_MANY_BINDINGS 0x5C03. All cmp immediates (0, 1, 2, 3, 4, 24, 64, 128, byte literals 0x09/0x0A/0x0D/0x20/0x28/0x29/0x3B/0x3D/0x65/0x6C/0x74/0x7B/0x7D, magic 0x47444C4C, status codes 0x5C00..0x5C04) fit imm32 with bit 31 clear. Byte load via `xor r,r; mov_b r,[base+idx*1]`. u32 store via mov_d. u8 store via mov_b. u64 store via plain mov. No test; no and-imm64; no imul-r-imm; no multiline let; no three-term addressing (all precomputed into r11). r11 held across _rc_check_scheme CALL via re-derivation (we only use r11 after the CALL in the emit path, which re-computes `lea r11, [rip + ...]` or `mov r11, r12; add r11, r15`). Labels prefixed lc_cs_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        mov rbx, rdi;                          // script_body
        mov rbp, rsi;                          // body_len
        mov r12, rdx;                          // out_diag_chain
        mov r13, rcx;                          // out_cap

        // ---- Phase 0: input validation --------------------------------
        cmp rbx, 0;
        je  lc_cs_bad_script;
        cmp rbp, 0;
        je  lc_cs_bad_script;
        cmp r12, 0;
        je  lc_cs_oos;
        cmp r13, 128;                          // LC_DIAG_BYTES
        jb  lc_cs_oos;

        // ---- Phase 1: lazy-populate canonical scheme ------------------
        // Check kind byte at [_lc_canon_scheme + 8]. If 0 (bss cold-
        // boot), write the full 24 bytes.
        lea r11, [rip + _lc_canon_scheme];
        xor rax, rax;
        mov_b rax, [r11 + 8];
        cmp rax, 0;
        jne lc_cs_canon_ready;

        // Populate: write all 24 bytes.
        xor rax, rax;
        mov_d [r11 + 0], rax;                  // n_bound_vars = 0
        mov rax, 1;
        mov_d [r11 + 4], rax;                  // n_body_nodes = 1
        mov rax, 2;
        mov_b [r11 + 8], rax;                  // kind = TYCON
        xor rax, rax;
        mov_b [r11 + 9], rax;                  // arity
        mov_b [r11 + 10], rax;                 // depth
        mov_b [r11 + 11], rax;                 // flags
        mov rax, 1;
        mov_d [r11 + 12], rax;                 // con_id = HM_CON_U64
        xor rax, rax;
        mov_d [r11 + 16], rax;                 // arg1
        mov_d [r11 + 20], rax;                 // resolved

      lc_cs_canon_ready:
        // ---- Phase 2: initialise scratch ------------------------------
        xor rax, rax;
        mov [rsp + 0], rax;                    // outer brace_depth = 0
        mov [rsp + 8], rax;                    // outer paren_depth = 0
        mov [rsp + 16], rax;                   // binding_count = 0
        mov [rsp + 24], rax;                   // binding src_offset = 0
        mov [rsp + 32], rax;                   // binding src_length = 0

        xor r14, r14;                          // cursor i = 0
        xor r15, r15;                          // diag_write_offset = 0

        // ---- Phase 3: outer walk --------------------------------------
      lc_cs_outer_top:
        cmp r14, rbp;
        jae lc_cs_outer_done;

        xor rax, rax;
        mov_b rax, [rbx + r14 * 1];

        // Branch on outer-structural bytes.
        cmp rax, 0x7B;                         // '{'
        je  lc_cs_brace_up;
        cmp rax, 0x7D;                         // '}'
        je  lc_cs_brace_down;
        cmp rax, 0x28;                         // '('
        je  lc_cs_paren_up;
        cmp rax, 0x29;                         // ')'
        je  lc_cs_paren_down;

        // Not a structural byte: check for top-level 'let'.
        cmp rax, 0x6C;                         // 'l'
        jne lc_cs_outer_next;

        // Depth must be 0.
        mov rcx, [rsp + 0];
        cmp rcx, 0;
        jne lc_cs_outer_next;
        mov rcx, [rsp + 8];
        cmp rcx, 0;
        jne lc_cs_outer_next;

        // Boundary before: i==0 OR prev byte in {LF, CR, SP, TAB, ';'}.
        cmp r14, 0;
        je  lc_cs_check_et;
        mov r11, r14;
        sub r11, 1;
        xor rcx, rcx;
        mov_b rcx, [rbx + r11 * 1];
        cmp rcx, 0x0A;                         // LF
        je  lc_cs_check_et;
        cmp rcx, 0x0D;                         // CR
        je  lc_cs_check_et;
        cmp rcx, 0x20;                         // SP
        je  lc_cs_check_et;
        cmp rcx, 0x09;                         // TAB
        je  lc_cs_check_et;
        cmp rcx, 0x3B;                         // ';'
        je  lc_cs_check_et;
        jmp lc_cs_outer_next;

      lc_cs_check_et:
        // bytes[i+1] must be 'e' (0x65).
        mov r11, r14;
        add r11, 1;
        cmp r11, rbp;
        jae lc_cs_outer_next;
        xor rcx, rcx;
        mov_b rcx, [rbx + r11 * 1];
        cmp rcx, 0x65;                         // 'e'
        jne lc_cs_outer_next;

        // bytes[i+2] must be 't' (0x74).
        mov r11, r14;
        add r11, 2;
        cmp r11, rbp;
        jae lc_cs_outer_next;
        xor rcx, rcx;
        mov_b rcx, [rbx + r11 * 1];
        cmp rcx, 0x74;                         // 't'
        jne lc_cs_outer_next;

        // bytes[i+3] must be WS (SP/TAB/LF/CR). (Required-WS boundary.)
        mov r11, r14;
        add r11, 3;
        cmp r11, rbp;
        jae lc_cs_outer_next;
        xor rcx, rcx;
        mov_b rcx, [rbx + r11 * 1];
        cmp rcx, 0x20;
        je  lc_cs_binding_hit;
        cmp rcx, 0x09;
        je  lc_cs_binding_hit;
        cmp rcx, 0x0A;
        je  lc_cs_binding_hit;
        cmp rcx, 0x0D;
        je  lc_cs_binding_hit;
        jmp lc_cs_outer_next;

      lc_cs_binding_hit:
        // Confirmed top-level `let` binding at offset r14.
        // Save src_offset.
        mov [rsp + 24], r14;

        // Check binding_count overflow BEFORE scanning this binding.
        mov rcx, [rsp + 16];
        cmp rcx, 64;                           // LC_MAX_BINDINGS
        jae lc_cs_too_many;

        // Advance past 'let ' (4 bytes) and inner-scan the binding body.
        add r14, 4;

        xor r8, r8;                            // inner brace_depth
        xor r9, r9;                            // inner paren_depth
        xor r10, r10;                          // has_eq flag

      lc_cs_inner_top:
        cmp r14, rbp;
        jae lc_cs_inner_done;

        xor rcx, rcx;
        mov_b rcx, [rbx + r14 * 1];

        // Top-level ';' at inner depth 0 ends the binding (consume it).
        cmp rcx, 0x3B;                         // ';'
        jne lc_cs_inner_not_semi;
        cmp r8, 0;
        jne lc_cs_inner_not_semi;
        cmp r9, 0;
        jne lc_cs_inner_not_semi;
        add r14, 1;                            // consume ';'
        jmp lc_cs_inner_done;

      lc_cs_inner_not_semi:
        cmp rcx, 0x7B;
        je  lc_cs_inner_bu;
        cmp rcx, 0x7D;
        je  lc_cs_inner_bd;
        cmp rcx, 0x28;
        je  lc_cs_inner_pu;
        cmp rcx, 0x29;
        je  lc_cs_inner_pd;
        cmp rcx, 0x3D;                         // '='
        je  lc_cs_inner_set_eq;
        jmp lc_cs_inner_next;

      lc_cs_inner_bu:
        add r8, 1;
        jmp lc_cs_inner_next;

      lc_cs_inner_bd:
        cmp r8, 0;
        je  lc_cs_inner_next;
        sub r8, 1;
        jmp lc_cs_inner_next;

      lc_cs_inner_pu:
        add r9, 1;
        jmp lc_cs_inner_next;

      lc_cs_inner_pd:
        cmp r9, 0;
        je  lc_cs_inner_next;
        sub r9, 1;
        jmp lc_cs_inner_next;

      lc_cs_inner_set_eq:
        mov r10, 1;
        jmp lc_cs_inner_next;

      lc_cs_inner_next:
        add r14, 1;
        jmp lc_cs_inner_top;

      lc_cs_inner_done:
        // Compute src_length = r14 - saved src_offset.
        mov rax, r14;
        sub rax, [rsp + 24];
        mov [rsp + 32], rax;

        // Validate: has_eq == 1.
        cmp r10, 1;
        jne lc_cs_emit_syntax_fail;

        // Validate: inner depths return to 0.
        cmp r8, 0;
        jne lc_cs_emit_syntax_fail;
        cmp r9, 0;
        jne lc_cs_emit_syntax_fail;

        // Validate: RHS non-empty (scan for '=' then non-WS after).
        mov rdi, [rsp + 24];                   // binding src_offset
        mov rsi, r14;                          // end-of-binding cursor

      lc_cs_scan_eq:
        cmp rdi, rsi;
        jae lc_cs_emit_syntax_fail;
        xor rcx, rcx;
        mov_b rcx, [rbx + rdi * 1];
        cmp rcx, 0x3D;
        je  lc_cs_found_eq;
        add rdi, 1;
        jmp lc_cs_scan_eq;

      lc_cs_found_eq:
        add rdi, 1;                            // past '='

      lc_cs_scan_rhs:
        cmp rdi, rsi;
        jae lc_cs_emit_syntax_fail;            // empty RHS
        xor rcx, rcx;
        mov_b rcx, [rbx + rdi * 1];
        cmp rcx, 0x20;
        je  lc_cs_scan_rhs_adv;
        cmp rcx, 0x09;
        je  lc_cs_scan_rhs_adv;
        cmp rcx, 0x0A;
        je  lc_cs_scan_rhs_adv;
        cmp rcx, 0x0D;
        je  lc_cs_scan_rhs_adv;
        cmp rcx, 0x3B;                         // ';' before any non-WS
        je  lc_cs_emit_syntax_fail;
        jmp lc_cs_rhs_nonempty;

      lc_cs_scan_rhs_adv:
        add rdi, 1;
        jmp lc_cs_scan_rhs;

      lc_cs_rhs_nonempty:
        // ---- Call _rc_check_scheme(_lc_canon_scheme, 24) ------------
        lea rdi, [rip + _lc_canon_scheme];
        mov rsi, 24;                           // LC_CANON_SCHEME_BYTES
        call _rc_check_scheme;

        // rax carries RankCheck status. 0 = pass (no diag emit).
        cmp rax, 0;
        je  lc_cs_binding_accept;

        // Preserve code in rcx and emit diag.
        mov rcx, rax;
        jmp lc_cs_emit_diag;

      lc_cs_emit_syntax_fail:
        // Synthetic syntactic failure: LC_ERR_BAD_SCHEME (0x5C04).
        mov rcx, 0x5C04;
        jmp lc_cs_emit_diag;

      lc_cs_emit_diag:
        // Capacity check: r15 + 128 <= r13.
        mov rax, r15;
        add rax, 128;                          // LC_DIAG_BYTES
        cmp rax, r13;
        ja  lc_cs_binding_accept;              // out of cap; count binding

        // Compute dst_base = r12 + r15.
        mov r11, r12;
        add r11, r15;

        // Zero-fill the 128 B record first.
        xor rax, rax;
        mov [r11 + 0], rax;
        mov [r11 + 8], rax;
        mov [r11 + 16], rax;
        mov [r11 + 24], rax;
        mov [r11 + 32], rax;
        mov [r11 + 40], rax;
        mov [r11 + 48], rax;
        mov [r11 + 56], rax;
        mov [r11 + 64], rax;
        mov [r11 + 72], rax;
        mov [r11 + 80], rax;
        mov [r11 + 88], rax;
        mov [r11 + 96], rax;
        mov [r11 + 104], rax;
        mov [r11 + 112], rax;
        mov [r11 + 120], rax;

        // magic 'LCDG' u32 at +0.
        mov rax, 0x47444C4C;                   // LC_DIAG_MAGIC
        mov_d [r11 + 0], rax;

        // code u32 at +4 (held in rcx by both emit paths).
        mov_d [r11 + 4], rcx;

        // src_offset u32 at +8.
        mov rax, [rsp + 24];
        mov_d [r11 + 8], rax;

        // src_length u32 at +12.
        mov rax, [rsp + 32];
        mov_d [r11 + 12], rax;

        // severity u8 at +16 = LC_SEV_ERROR (2).
        mov rax, 2;
        mov_b [r11 + 16], rax;

        // binding_idx u32 at +20.
        mov rax, [rsp + 16];
        mov_d [r11 + 20], rax;

        // Speculative next_offset u64 at +104 = r15 + 128 (patched to
        // 0 at outer_done).
        mov rax, r15;
        add rax, 128;
        mov [r11 + 104], rax;

        // Advance diag_write_offset.
        add r15, 128;

      lc_cs_binding_accept:
        // Increment binding_count.
        mov rax, [rsp + 16];
        add rax, 1;
        mov [rsp + 16], rax;
        cmp rax, 64;
        ja  lc_cs_too_many;
        jmp lc_cs_outer_top;                   // r14 already past binding

        // ---- Outer-structural byte handlers --------------------------
      lc_cs_brace_up:
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp lc_cs_outer_next;

      lc_cs_brace_down:
        mov rax, [rsp + 0];
        cmp rax, 0;
        je  lc_cs_outer_next;
        sub rax, 1;
        mov [rsp + 0], rax;
        jmp lc_cs_outer_next;

      lc_cs_paren_up:
        mov rax, [rsp + 8];
        add rax, 1;
        mov [rsp + 8], rax;
        jmp lc_cs_outer_next;

      lc_cs_paren_down:
        mov rax, [rsp + 8];
        cmp rax, 0;
        je  lc_cs_outer_next;
        sub rax, 1;
        mov [rsp + 8], rax;
        jmp lc_cs_outer_next;

      lc_cs_outer_next:
        add r14, 1;
        jmp lc_cs_outer_top;

      lc_cs_outer_done:
        // ---- Phase 4: patch last diag's next_offset to 0 -------------
        cmp r15, 0;
        je  lc_cs_decide;
        mov r11, r12;
        add r11, r15;
        sub r11, 128;
        xor rax, rax;
        mov [r11 + 104], rax;

      lc_cs_decide:
        // ---- Phase 5: decide pass/fail -------------------------------
        // Save diag_emit_count = r15 / 128 for test-time inspection.
        mov rax, r15;
        shr rax, 7;                            // r15 / 128
        lea r11, [rip + _lc_diag_emit_count];
        mov [r11], rax;

        // Save binding_count for inspection.
        mov rax, [rsp + 16];
        lea r11, [rip + _lc_binding_count];
        mov [r11], rax;

        cmp r15, 0;
        jne lc_cs_tc_failed;

        xor rax, rax;                          // LC_OK
        jmp lc_cs_epilogue;

      lc_cs_tc_failed:
        mov rax, 0x5C00;                       // LC_ERR_TYPECHECK_FAILED
        // Save last_fail_code.
        lea r11, [rip + _lc_last_fail_code];
        mov [r11], rax;
        jmp lc_cs_epilogue;

      lc_cs_bad_script:
        mov rax, 0x5C01;                       // LC_ERR_BAD_SCRIPT
        jmp lc_cs_epilogue;

      lc_cs_oos:
        mov rax, 0x5C02;                       // LC_ERR_OUT_TOO_SMALL
        jmp lc_cs_epilogue;

      lc_cs_too_many:
        mov rax, 0x5C03;                       // LC_ERR_TOO_MANY_BINDINGS
        jmp lc_cs_epilogue;

      lc_cs_epilogue:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _lc_count_diags(diag_chain, chain_len) -> u64
  //
  //   rdi = diag_chain
  //   rsi = chain_len
  //   rax = count of valid DiagReport records
  //
  // Walks the chain by following the `next_offset` field at +104 of
  // each record. Starts at offset 0; terminates on next_offset == 0,
  // next_offset >= chain_len, bad magic, or 64 iterations (cycle
  // guard, bounded at LC_MAX_BINDINGS).
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lc_cd_.
  // ==========================================================================
  pub let _lc_count_diags : (u64, u64) -> u64 !{mem} @{} =
    fn (diag_chain: u64) (chain_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M4 (#2706): _lc_count_diags walks the diag chain starting at diag_chain[0], follows next_offset u64 at +104 of each 128-B DiagReport record, counts records whose magic u32 at +0 is 'LCDG' (0x47444C4C). Terminates on: (a) next_offset == 0 (terminal) after counting the current record; (b) current offset + 128 > chain_len (truncated); (c) magic mismatch (bad record); (d) 64 iterations (cycle guard bounded at LC_MAX_BINDINGS). Pure leaf; zero pushes; no stack frame; no nested CALL. Register plan: rdi = diag_chain (preserved); rsi = chain_len (preserved); rax = count; rcx = current cursor offset into diag_chain; r8 = iteration guard; r9 = scratch byte/word read; r11 = address staging. Flow: if diag_chain == 0 OR chain_len < 128 return 0. Init rax = 0 (count); rcx = 0 (cursor); r8 = 0 (iter). Loop: iter >= 64 -> break; cursor + 128 > chain_len -> break; r11 = diag_chain + cursor; load u32 magic at [r11+0] into r9 via mov_d; cmp r9 != 0x47444C4C -> break; increment count; load u64 next_offset at [r11+104] into r9; iter += 1; if r9 == 0 break; cursor := r9. All cmp immediates (0, 64, 128, magic 0x47444C4C) fit imm32 with bit 31 clear. Byte / u32 / u64 loads via mov_d / mov with zero-extend. No test; no and-imm64; no imul-r-imm; no multiline let; no three-term addressing. Labels prefixed lc_cd_.",
      block: {
        // ---- Fast rejects.
        cmp rdi, 0;
        je  lc_cd_zero;
        cmp rsi, 128;                          // LC_DIAG_BYTES
        jb  lc_cd_zero;

        // ---- Init.
        xor rax, rax;                          // count = 0
        xor rcx, rcx;                          // cursor = 0
        xor r8, r8;                            // iter = 0

      lc_cd_loop:
        // Iteration guard (cycle break at LC_MAX_BINDINGS).
        cmp r8, 64;
        jae lc_cd_done;

        // Capacity: cursor + 128 <= chain_len.
        mov r9, rcx;
        add r9, 128;
        cmp r9, rsi;
        ja  lc_cd_done;

        // Compute record address.
        mov r11, rdi;
        add r11, rcx;

        // Load magic u32 at +0.
        xor r9, r9;
        mov_d r9, [r11 + 0];
        cmp r9, 0x47444C4C;                    // LC_DIAG_MAGIC
        jne lc_cd_done;

        // Valid record: count it.
        add rax, 1;

        // Load next_offset u64 at +104.
        mov r9, [r11 + 104];

        // Advance iteration guard.
        add r8, 1;

        // Terminal: next_offset == 0.
        cmp r9, 0;
        je  lc_cd_done;

        // Follow chain.
        mov rcx, r9;
        jmp lc_cd_loop;

      lc_cd_zero:
        xor rax, rax;
        ret;

      lc_cd_done:
        ret;
      }
    }

}
