// src/filter_op.pdx -- libpdx-pds-parser (paideia-os#2668, R223.M3)
//
// FilterOp: parser-tier primitive that reads the ARGV bytes of a
// pipeline stage whose head word is `where`, `filter`, or `by` and
// emits a single 32-byte FilterOp record carrying the predicate span
// and the dispatch mode. Consumers (R225 HM typechecker, R223.M3+
// pipeline-stage dispatcher) use the record to run the predicate
// lambda against each typed-record pass flowing through the pipeline
// and filter out rows for which the lambda returns false.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R223 is the pipeline-lang umbrella (paideia-os#2487). R223.M1
// (pipeline.pdx) lands the pipeline stage parser. R223.M2
// (record_projection.pdx) lands the `select`/`project FIELDS` field-
// list parser. R223.M3 (THIS module) adds the FILTER COMBINATOR: when
// a pipeline stage's head word is `where`, `filter`, or `by`, its
// argv bytes carry a predicate that selects which rows of the typed-
// record stream pass to the next stage.
//
//     ls | where { |f| f.size > 1.MB }
//     ps | filter { |p| p.cpu > 50 }
//     ls | by size > 1.MB
//
// `where` and `filter` are two parse-syntax entry points to the SAME
// combinator (`filter` is standard functional idiom; `where` reads
// closer to SQL and PowerShell). Both consume a lambda-literal-shaped
// block `{ |binders| body }` as the predicate. `by` is the terse
// shorthand that elides the lambda header and binders: `by EXPR`
// desugars to `where { |f| f.EXPR }` where `f` is the implicit
// per-row binder. The three operators share one 32-byte output
// record; the `mode` byte at offset 16 discriminates for the
// downstream R225 HM pass and the R223.M3+ stage dispatcher.
//
// At R223.M3 this module is PARSER-tier only: it validates the
// grammar and emits the record with a 64-bit `predicate_lambda_ref`
// slot that packs (body_offset << 32) | body_len -- a reference back
// into the caller's input bytes. The downstream HM pass walks those
// bytes through R224.M1 LambdaLit's `_ll_parse` to materialise the
// predicate's AST and infer its type (`fn (Record) -> bool`). The
// per-stage dispatcher binds that lambda to each incoming record
// at runtime.
//
// Out of scope at M3 (deferred):
//   * Lambda materialisation: this module does not call `_ll_parse`.
//     The predicate_lambda_ref carries the byte span only; the HM
//     pass runs `_ll_parse` as its own step when it elaborates the
//     stage. Keeping the two parsers at compile-time disjoint
//     mirrors R223.M2's choice (RecordProjection does not call into
//     SchemasSig either).
//   * Nested-brace balancing: a predicate body `{ |f| g({...}) }`
//     with a nested braced block is M3.1. At M3 the first unescaped
//     `}` terminates the body; this is sufficient for every
//     R223.M3 shell example.
//   * Depth-aware pipe-split for lambda bodies that themselves
//     contain `|`: R221.M4 CtxLexer already partitions pipeline-
//     level `|` from lambda-binder `|`; this module trusts that the
//     caller handed it argv bytes bounded by the outer stage's
//     `|` boundaries (CtxLexer-aware).
//   * `by` with full expression grammar (sub-expressions, nested
//     method calls, lambdas): M3 accepts the opaque byte run from
//     `by` through EOI; the R225 HM pass walks the bytes as an
//     Expr. The `_fo_desugar_by` helper emits a lambda-source
//     string into a caller buffer, for callers that want to
//     materialise the sugared form through _ll_parse directly.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     where_op    := "where"  WS* LambdaBlock
//     filter_op   := "filter" WS* LambdaBlock
//     by_op       := "by"     WS+ Expr
//     LambdaBlock := "{" WS* "|" WS* BinderList WS* "|" Expr "}"
//     BinderList  := identifier (WS* "," WS* identifier)*
//     identifier  := [A-Za-z_] [A-Za-z0-9_]*          (len 1..FO_NAME_MAX)
//     Expr        := <opaque bytes; R224.M2 Expr grammar via R225 HM>
//     WS          := 0x20 | 0x09 | 0x0A | 0x0D
//
// Rejected: `where` or `filter` without an opening `{`; `{` without a
// following `|`; empty binder list `{ || body }`; a BinderList element
// whose byte length exceeds FO_NAME_MAX (14); mismatched or missing
// `}`; `by` without a following non-empty expression; the three head
// keywords in a form other than their exact lowercase ASCII bytes
// (the dispatch at the pipeline-stage level feeds us the already-
// trimmed argv; the head word was already matched by the stage
// dispatcher, so this module validates the TAIL only -- but the three
// public wrappers each VERIFY the head keyword as a sanity check, so
// a caller that routes mistakenly is caught cleanly).
//
// The caller feeds the WHOLE stage argv bytes (including the leading
// head keyword, so the module can re-verify dispatch). The three
// public entry points differ only in which head keyword they expect
// and which mode byte they stamp.
//
// =============================================================================
// FILTEROP RECORD (32 bytes)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic                u32 = FO_HEADER_MAGIC ('FILT'
//                                          little-endian = 0x544C4946)
//     4      4   _pad                 u32   zeroed; alignment pad so
//                                          the u64 predicate_lambda_ref
//                                          at +8 lands 8-byte aligned.
//     8      8   predicate_lambda_ref u64   packed (body_offset << 32) |
//                                          body_len; offset indexes the
//                                          CALLER-supplied input bytes.
//    16      1   mode                 u8    FO_MODE_WHERE  (0)
//                                          FO_MODE_FILTER (1)
//                                          FO_MODE_BY     (2)
//    17      1   flags                u8    bit 0 = HAS_BY (set iff mode
//                                          == 2); bits 1..7 reserved.
//    18     14   reserved[14]         u8    zeroed; reserved for M3.1+
//                                          (binder-count u8, effect-row
//                                          seed id, cap-row seed id,
//                                          source span, etc.)
//
//   total: 32 B (FO_RECORD_BYTES)
//
// Layout reconciliation (parent brief R223.M3): the brief reads
// `magic u32, predicate_lambda_ref u64, mode u8, flags u8, reserved
// [14]` which sums to 28 bytes but prescribes a 32-byte stride; the
// precedent (pipeline.pdx `_reserved: [u8;14]` note) is to pick the
// stride (externally-observable in sizing arithmetic) and expand the
// internal layout. This module inserts a 4-byte zero `_pad` after the
// u32 magic so predicate_lambda_ref sits at an 8-byte boundary and
// the reserved tail stays [u8;14]. The record is externally probed
// via its sizeof (32 B) and its field offsets (FO_OFF_* constants);
// consumers never read the pad slot.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _fo_init() -> ()
//
//     Idempotent pure-leaf boot hook. The module carries no `.bss`
//     state at M3 (no label-intern table; no scheme pool); the init
//     exists so the shell's boot sequence can wire a uniform `*_init`
//     entry point across every pds-parser submodule. At M3 the body
//     is a bare `ret`.
//
//   _fo_parse_where(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
//     Parses the argv bytes of a `where { |binder| body }` pipeline
//     stage. Validates the leading `where` head keyword, then the
//     lambda-block tail. Writes one 32-byte FilterOp record at
//     out_ptr with mode = FO_MODE_WHERE (0). Returns
//     `(bytes_written << 32) | status`.
//
//   _fo_parse_filter(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
//     Same shape; expects the leading `filter` head keyword and
//     stamps mode = FO_MODE_FILTER (1). At M3 the semantics are
//     identical to `_fo_parse_where`; the mode byte survives so a
//     future M3.x can differentiate (e.g., `filter` keeps non-matching
//     rows as part of a diagnostic stream, `where` drops them silently
//     -- the two reserved semantics in standard functional idioms).
//
//   _fo_parse_by(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
//     Expects the leading `by` head keyword; the body is the opaque
//     expression bytes until EOI. Stamps mode = FO_MODE_BY (2) and
//     sets FO_FLAG_HAS_BY (bit 0 of the flags byte) so a downstream
//     dispatcher can route the opaque body through `_fo_desugar_by`
//     if it needs the lambda-source form.
//
//   The three wrappers delegate to the module-private `_fo_parse_body`
//   impl (NOT a public entry point; the dispatch brief lists it as an
//   internal helper). The impl takes the mode byte in r8 and runs
//   either the `{ |binder| body }` scan (modes 0, 1) or the terse
//   `expr` scan (mode 2).
//
//   _fo_desugar_by(expr_ptr, expr_len, out_ptr, out_cap) -> packed_u64
//
//     Transforms a `by expr` shorthand into the equivalent
//     lambda-source bytes `\f -> f.expr` suitable for feeding to
//     R224.M1 LambdaLit's `_ll_parse`. Writes the synthesised bytes
//     into out_ptr. Caller supplies the expr bytes with the leading
//     `by` + WS already stripped (so the caller can use the same
//     helper from a non-shell context, e.g. a `cmd ... by X` suffix
//     syntax at the renderer-override tier). Returns
//     `(bytes_written << 32) | status`.
//
//   Register map (SysV):
//
//     _fo_parse_where / _fo_parse_filter / _fo_parse_by
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = out_ptr, rcx = out_cap)
//       -> rax = (bytes_written << 32) | status
//
//     _fo_parse_body
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = out_ptr, rcx = out_cap,
//        r8  = mode_byte 0|1|2)
//       -> rax = (bytes_written << 32) | status
//
//     _fo_desugar_by
//       (rdi = expr_ptr, rsi = expr_len, rdx = out_ptr, rcx = out_cap)
//       -> rax = (bytes_written << 32) | status
//
//     _fo_skip_ws
//       (rdi = bytes_ptr, rsi = bytes_len, rdx = cursor_in)
//       -> rax = cursor_out
//
// =============================================================================
// RETURN CODES
// =============================================================================
//
//   FO_OK                     = 0
//   FO_ERR_SYNTAX             = 0x4C00   grammar fault at head keyword,
//                                        binder list, or body scan.
//   FO_ERR_NO_OPEN_BRACE      = 0x4C01   `where`/`filter` tail did
//                                        not start with `{`.
//   FO_ERR_NO_CLOSE_BRACE     = 0x4C02   EOI before matching `}`.
//   FO_ERR_NO_PIPE_BINDER     = 0x4C03   `{` not followed by `|binder|`.
//   FO_ERR_NAME_TOO_LONG      = 0x4C04   binder-ident byte length >
//                                        FO_NAME_MAX (14).
//   FO_ERR_EMPTY_BODY         = 0x4C05   `|binder|` with no body bytes
//                                        before `}`, OR `by` with no
//                                        expression bytes after `by`.
//   FO_ERR_NO_BY_KEYWORD      = 0x4C06   `_fo_parse_by` leading argv was
//                                        not `by` + WS.
//   FO_ERR_HEAD_MISMATCH      = 0x4C07   `_fo_parse_where` / `_fo_parse_
//                                        filter` leading argv did not
//                                        match the dispatched keyword.
//   FO_ERR_BAD_MODE           = 0x4C08   `_fo_parse_body` called with
//                                        mode > FO_MODE_BY (2); defence
//                                        against an upstream caller
//                                        routing a bogus mode byte.
//   FO_ERR_OUT_TOO_SMALL      = 0x4C09   out_cap < FO_RECORD_BYTES (32)
//                                        for `_fo_parse_*`; or
//                                        out_cap < required length for
//                                        `_fo_desugar_by`.
//
// `bytes_written` is the count of bytes written to out_ptr on
// success (= 32 for `_fo_parse_*`; = synthesised lambda-source length
// for `_fo_desugar_by`). On error, `bytes_written` is 0 (caller
// ignores the top 32 bits).
//
// =============================================================================
// STATUS-CODE NAMESPACE
// =============================================================================
//
// FO_* codes live in 0x4C00..0x4CFF, disjoint from every other
// user-space packed-status range in the paideia-os tree. The 0x4A00
// and 0x4B00 bands are reserved for the parallel R221.M7 fuzz-corpus
// and R222.M7 fuzz-corpus arms respectively; 0x4C00 is the next
// unused 256-slot slice above them.
//
// Grep confirmation at R223.M3 landing time:
//   grep -rE '0x4C0[0-9]' tools/user/libpdx-pds-parser/
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/where-filter-op.md.
//   grep -rE '0x4B0[0-9]' paideia-os/ (verified disjoint): the one
//     prior hit at `src/kernel/core/fs/pdxfs/upgrade_v1.pdx`
//     (`UPG_INIT_MARK = 0x4B0A`) is a magic cookie, NOT a packed-
//     status code -- it lives in the kernel-side pdxfs namespace and
//     never flows through this library's packed-u64 return protocol.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller is expected to have already
//     run the input bytes through _u8n_decode_and_normalize so this
//     module may assume (a) valid UTF-8, (b) NFC-form. Non-ASCII
//     bytes inside an identifier fall through to FO_ERR_SYNTAX via
//     the ident byte-class check (none of 0x80..0xFF is in
//     [A-Za-z0-9_]). Non-ASCII bytes in the opaque body span are
//     copied-by-reference verbatim (the record only stores the
//     offset+len pair; no bytes leave the caller's buffer).
//
//   R221.M4 (CtxLexer)  --  the caller is expected to use CtxLexer
//     for pipeline-level `|` partitioning so this module sees an
//     argv span bounded by two outer `|` boundaries. Lambda-binder
//     `|` characters inside `{ |binder| ... }` are inside the stage
//     and do not cause confusion because the OUTER tokeniser
//     recognised them as sub-stage lexemes.
//
//   R223.M1 (Pipeline)  --  this module is a POST-pass on the
//     PipelineStage records that R223.M1 emits. The dispatcher
//     identifies a stage whose cmd_name matches `where`, `filter`,
//     or `by` and calls the matching entry point here.
//
//   R223.M2 (RecordProjection)  --  disjoint operator parse; both
//     modules sit at the pipeline-stage POST-pass tier. The two
//     stages can appear in the same pipeline (`ls | where { |f|
//     f.size > 1.MB } | select name, size`); the operators do not
//     interact at parse time.
//
//   R224.M1 (LambdaLit)  --  this module does NOT call _ll_parse;
//     the predicate_lambda_ref packs the body byte span and the HM
//     pass runs _ll_parse against those bytes when it elaborates the
//     stage. The TYPE codes shared with LambdaLit (u64/i64/str/...)
//     do not surface here -- the body is opaque at M3.
//
//   R224.M3 (EffectRow)  --  reads the predicate's effect row to
//     stamp a lambda effect-row seed; the FilterOp.reserved tail
//     carries 14 bytes available at M3.1 for the effect-row id.
//
//   R225.M1+ (HmCore / RowTypes)  --  the HM pass instantiates the
//     predicate as `fn (Record) -> bool`. If the predicate's return
//     type unifies with `bool` the stage is well-formed; otherwise
//     the HM pass raises E0810-family.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- not needed; the module has no
//     stride-indexed array arithmetic (the record is a single
//     32-byte write).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `FilterOp` matches `filter_op.pdx`.
//   - Public symbols prefixed `_fo_*` (entry points); internal
//     labels prefixed `fo_*` (grep-confirmed free of linker-visible
//     symbol collisions; disjoint from every sibling satellite's
//     prefix: `u8n_`, `gi_`, `wp_`, `cl_`, `ast_`, `sm_`,
//     `sch_sig_`, `cmd_sig_`, `fi_`, `afs_`, `cmdreg_`, `dm_`,
//     `pl_`, `rp_`, `ll_`, `cc_`, `er_`, `cr_`, `ls_`, `hm_`,
//     `rt_`, `dl_`, `se_`, `te_`, `eu_`). The `fo_` prefix is
//     disjoint from paideia-as reserved keywords (`loop`, `if`,
//     `let`, `fn`, `ret`, `done`, etc.).
//   - All `cmp reg, imm` immediates (ASCII literals 0x20..0x7F,
//     FO_NAME_MAX = 14, FO_RECORD_BYTES = 32, mode constants 0..2,
//     status codes 0x4C00..0x4C09, desugar prefix length) fit in
//     imm32 with bit 31 clear so direct `cmp reg, imm32` is
//     sign-extension-safe. No MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     with explicit *1 scale (paideia-as #1248 + U1606 mitigation
//     per libpdx-audit audit_file_sink precedent).
//   - Byte stores via `mov_b [dst + disp], reg` (same shape as
//     ClosureCapture's descriptor write).
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: Pipeline
//     _pl_emit_word, LambdaLit body_offset write).
//   - u64 zero-fill of the 32-byte record uses four `mov [dst +
//     disp], rax` with rax = 0, covering the full stride.
//   - `_fo_init` is a pure-leaf idempotent no-op at M3; zero
//     pushes, zero stack frame, zero nested CALL.
//   - `_fo_skip_ws` is a pure-leaf WS walker; zero pushes, zero
//     stack frame, zero nested CALL. Shape parallel to R224.M1
//     `_ll_skip_ws`, R223.M2 `_rp_skip_ws`.
//   - `_fo_parse_body` has a 6 callee-save push + 24 B scratch
//     frame: push rbx, rbp, r12, r13, r14, r15 (= 48 B) + sub rsp,
//     24. Entry rsp%16==8; +48 pushes = %16==8; +24 scratch =
//     %16==0 at every nested CALL into `_fo_skip_ws`. Scratch
//     slots: [rsp+0] cursor, [rsp+8] body_start, [rsp+16] mode_byte
//     spill.
//   - Public wrappers (`_fo_parse_where`, `_fo_parse_filter`,
//     `_fo_parse_by`) are 1-nested-call wrappers: `sub rsp, 8` +
//     `mov r8, <mode>` + `call _fo_parse_body` + `add rsp, 8` +
//     `ret`. Entry rsp%16==8; after `sub rsp, 8` rsp%16==0; the
//     nested CALL lands aligned.
//   - `_fo_desugar_by` has a 5 callee-save push + 16 B scratch
//     frame: push rbx, rbp, r12, r13, r14 (= 40 B) + sub rsp, 16.
//     Entry rsp%16==8; +40 pushes = %16==0; +16 scratch = %16==0.
//     No nested CALL at M3; the frame reserves alignment for an
//     M3.1 extension that may call _fo_skip_ws.
//   - r11 is NEVER held across a nested CALL (Wave 116
//     register-liveness lesson). Values that must survive a nested
//     CALL live in rbx/rbp/r12..r15 or on the stack.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R223.M3.1  Nested-brace balancing: a predicate body with an
//              inner `{...}` block tracks brace depth.
//   R223.M4    `@hostname` annotation: cross-host filtering routes
//              the FilterOp record through the wire-format serializer.
//   R223.M5    Flag/positional partition on the filter head: a
//              `where --strict { |f| ... }` form adds a flag byte to
//              reserved[0].
//   R223.M6    Canonical-form renderer: round-trips the record back
//              to its three parse-syntax forms.
//   R225.M3    HM-time: `_hm_check_filter` instantiates the predicate
//              as `fn (Record) -> bool` and unifies against the input
//              stage's row type.
//
// =============================================================================
// Upstream: paideia-os#2487 (R223 umbrella), paideia-os#2668 (THIS
// ticket, R223.M3). Substrate: paideia-os#2666 (R223.M1 Pipeline
// stage parser -- source of the argv spans this module consumes),
// paideia-os#2675 (R224.M1 LambdaLit -- the predicate's downstream
// parser; this module stores the byte span rather than invoking it).
// Design doc: design/shell/where-filter-op.md.

module FilterOp = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let FO_OK                 : u64 = 0
  pub let FO_ERR_SYNTAX         : u64 = 0x4C00
  pub let FO_ERR_NO_OPEN_BRACE  : u64 = 0x4C01
  pub let FO_ERR_NO_CLOSE_BRACE : u64 = 0x4C02
  pub let FO_ERR_NO_PIPE_BINDER : u64 = 0x4C03
  pub let FO_ERR_NAME_TOO_LONG  : u64 = 0x4C04
  pub let FO_ERR_EMPTY_BODY     : u64 = 0x4C05
  pub let FO_ERR_NO_BY_KEYWORD  : u64 = 0x4C06
  pub let FO_ERR_HEAD_MISMATCH  : u64 = 0x4C07
  pub let FO_ERR_BAD_MODE       : u64 = 0x4C08
  pub let FO_ERR_OUT_TOO_SMALL  : u64 = 0x4C09

  // ==========================================================================
  // SECTION 2 -- MODE / FLAG / LAYOUT CONSTANTS
  // ==========================================================================

  pub let FO_MODE_WHERE         : u64 = 0
  pub let FO_MODE_FILTER        : u64 = 1
  pub let FO_MODE_BY            : u64 = 2

  pub let FO_FLAG_HAS_BY        : u64 = 0x01

  pub let FO_RECORD_BYTES       : u64 = 32
  pub let FO_NAME_MAX           : u64 = 14
  pub let FO_HEADER_MAGIC       : u64 = 0x544C4946     // 'FILT' LE

  // Record field offsets (bytes, from record base).
  pub let FO_OFF_MAGIC          : u64 = 0
  pub let FO_OFF_PAD            : u64 = 4
  pub let FO_OFF_PRED_REF       : u64 = 8
  pub let FO_OFF_MODE           : u64 = 16
  pub let FO_OFF_FLAGS          : u64 = 17
  pub let FO_OFF_RESERVED       : u64 = 18

  // ==========================================================================
  // _fo_init() -> ()
  //
  // Idempotent pure-leaf boot hook. The module carries no `.bss`
  // state at M3 (no label-intern table; no scheme pool); the init
  // exists so the shell's boot sequence can wire a uniform `*_init`
  // entry point across every pds-parser submodule. At M3 the body
  // is a bare `ret`. A future M3.x that adds `.bss` state (e.g. a
  // parse-count counter for smoke-mode assertion, mirroring
  // `_dm_init`'s `.bss` counters) will populate the body without an
  // ABI break.
  //
  // Pure leaf; no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed fo_ini_.
  // ==========================================================================
  pub let _fo_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): _fo_init idempotent boot hook. The module has no `.bss` state at M3 so the body is a bare `ret`. Pure leaf; zero pushes, zero stack frame, zero nested CALL. The entry exists so the shell's uniform `*_init` wiring across every pds-parser submodule (precedent: _ast_init, _sm_init, _dm_init, _cmdreg_init, _er_init, _cr_init, _ls_init) does not special-case FilterOp. A future M3.x that adds a parse-count counter in `.bss` will populate this body with the lazy-populate shape; no ABI change. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fo_ini_.",
      block: {
      fo_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _fo_skip_ws(bytes_ptr, bytes_len, cursor_in) -> cursor_out
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a
  // space-class byte, OR cursor == bytes_len (end-of-input is a valid
  // stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed fo_sw_. Shape byte-for-byte parallel to R221.M1
  // _u8n_skip_ws, R222.M1 _sch_sig_skip_ws, R223.M2 _rp_skip_ws,
  // R224.M1 _ll_skip_ws, R224.M2 _cc_skip_ws, R226.M1 _dl_skip_ws so
  // the pds-lang family's whitespace discipline stays bit-identical.
  // ==========================================================================
  pub let _fo_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): skip ASCII whitespace in {SP, TAB, LF, CR}. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the space-class set. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All cmp immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fo_sw_. Byte-for-byte parallel to the family's shared WS discipline.",
      block: {
        mov rax, rdx;                            // cursor := cursor_in

      fo_sw_scan:
        cmp rax, rsi;
        jae fo_sw_stop;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];
        cmp rcx, 0x20;
        je  fo_sw_step;
        cmp rcx, 0x09;
        je  fo_sw_step;
        cmp rcx, 0x0A;
        je  fo_sw_step;
        cmp rcx, 0x0D;
        je  fo_sw_step;
        jmp fo_sw_stop;

      fo_sw_step:
        add rax, 1;
        jmp fo_sw_scan;

      fo_sw_stop:
        ret;
      }
    }

  // ==========================================================================
  // _fo_parse_body(bytes_ptr, bytes_len, out_ptr, out_cap, mode_byte)
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   r8  = mode_byte (0=WHERE, 1=FILTER, 2=BY)
  //   rax = (bytes_written << 32) | status
  //
  // Shared implementation of the three public entry points. The
  // caller's wrapper has already stripped the leading head keyword
  // bytes (`where`, `filter`, `by`) FROM the input and reset the
  // cursor to the tail. mode_byte selects the two code paths:
  //
  //   Modes 0 and 1 (WHERE/FILTER):
  //     expect `WS* { WS* | WS* binder (WS* , WS* binder)* WS* | body }`
  //     where body = any bytes up to the first unescaped `}`.
  //
  //   Mode 2 (BY):
  //     expect `WS+ expr` where expr = any bytes until EOI (the
  //     caller is CtxLexer-bounded so the stage end is the input end).
  //
  // All three paths produce the same 32-byte FilterOp record:
  //
  //     [+0..+4]   magic = 'FILT' LE (0x544C4946)
  //     [+4..+8]   pad u32 = 0 (alignment)
  //     [+8..+16]  predicate_lambda_ref u64 =
  //                   (body_start << 32) | body_len
  //                where body_start indexes bytes_ptr and body_len
  //                is the body byte count (strict; closing `}` /
  //                EOI not included).
  //     [+16]      mode u8 (from r8)
  //     [+17]      flags u8 (bit 0 set iff mode == 2)
  //     [+18..+32] reserved[14] = 0
  //
  // Prologue: 6 callee-save pushes (rbx = bytes_ptr, rbp = bytes_len,
  // r12 = cursor, r13 = out_ptr, r14 = out_cap_remaining,
  // r15 = scratch for body_start / body_len composition) + sub rsp,
  // 24 scratch (slot 0 = mode_byte spill; slots 8 / 16 = alignment
  // pad reserved for M3.1). Entry rsp%16==8; +48 pushes = %16==8;
  // +24 scratch = %16==0 at every nested CALL into `_fo_skip_ws`.
  //
  // Labels prefixed fo_pb_.
  // ==========================================================================
  pub let _fo_parse_body : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64)
       (mode_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): shared body of _fo_parse_where/_fo_parse_filter/_fo_parse_by. Modes 0/1 (WHERE/FILTER): expect `WS* { WS* | WS* binder (, binder)* WS* | body }`; mode 2 (BY): expect `WS+ expr` until EOI. Writes a 32-byte FilterOp record at out_ptr with magic 'FILT' (0x544C4946 LE), 4-byte pad, u64 predicate_lambda_ref packing (body_start<<32)|body_len (indexing into the CALLER-supplied bytes_ptr -- the record carries no copy; a downstream HM pass reads bytes from the caller's buffer), u8 mode, u8 flags (HAS_BY bit when mode==2), 14 reserved bytes. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr, r14=out_cap_remaining, r15=scratch) + sub rsp, 24 (slot 0 = mode_byte spill; slots 8/16 = alignment pad reserved for M3.1) -> rsp%16==0 steady at every nested CALL into _fo_skip_ws (entry 8, +48 pushes = 8, +24 scratch = 0). Capacity guard: out_cap >= FO_RECORD_BYTES = 32; else FO_ERR_OUT_TOO_SMALL. Mode guard: mode_byte > 2 -> FO_ERR_BAD_MODE (defence against a bogus upstream caller). Zero-fill the 32-byte record via four `mov [r13+disp], rax` with rax=0 before field writes; this gives free zero-padding for the 4-byte pad and the 14-byte reserved tail. Field writes: magic u32 via mov_d; predicate_lambda_ref u64 via mov [r13+8], rax; mode u8 via mov_b; flags u8 via mov_b. r11 is NEVER held across a nested CALL (Wave 116 lesson); long-lived scratch lives in rbx..r15 or on the stack. All cmp immediates (ASCII 0x20..0x7F, FO_NAME_MAX=14, FO_RECORD_BYTES=32, mode constants, status codes 0x4C00..0x4C09) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fo_pb_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Spill mode_byte into scratch slot 0.
        mov [rsp + 0], r8;
        xor rax, rax;
        mov [rsp + 8], rax;                      // pad
        mov [rsp + 16], rax;                     // pad

        // Load state regs.
        mov rbx, rdi;                            // bytes_ptr
        mov rbp, rsi;                            // bytes_len
        xor r12, r12;                            // cursor = 0
        mov r13, rdx;                            // out_ptr
        mov r14, rcx;                            // out_cap_remaining
        xor r15, r15;                            // scratch

        // Capacity guard: must fit a full 32-byte FilterOp record.
        cmp r14, 32;
        jb  fo_pb_err_oos;

        // Mode guard: mode_byte in [0..2].
        mov rax, [rsp + 0];
        cmp rax, 2;
        ja  fo_pb_err_bad_mode;

        // Zero-fill the 32-byte record via four u64 stores. Later
        // writes overwrite the live bytes; this gives us a clean
        // reserved tail and a zeroed pad for free.
        xor rax, rax;
        mov [r13 + 0], rax;
        mov [r13 + 8], rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // Write magic 'FILT' (0x544C4946 LE) at [r13 + 0].
        mov rax, 0x544C4946;                     // FO_HEADER_MAGIC
        mov_d [r13 + 0], rax;

        // Dispatch on mode.
        mov rax, [rsp + 0];
        cmp rax, 2;
        je  fo_pb_by;
        // Modes 0/1 share the lambda-block scan.
        jmp fo_pb_lambda_block;

        // ----------------------------------------------------------
        // Lambda-block scan: `WS* { WS* | WS* binder,... WS* | body }`
        // ----------------------------------------------------------
      fo_pb_lambda_block:
        // Skip leading WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fo_skip_ws;
        mov r12, rax;

        // Expect `{`.
        cmp r12, rbp;
        jae fo_pb_err_no_open_brace;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7B;                           // '{'
        jne fo_pb_err_no_open_brace;
        add r12, 1;

        // Skip WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fo_skip_ws;
        mov r12, rax;

        // Expect `|`.
        cmp r12, rbp;
        jae fo_pb_err_no_pipe;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7C;                           // '|'
        jne fo_pb_err_no_pipe;
        add r12, 1;

        // ---- BinderList scan: identifier (',' identifier)* ----
      fo_pb_binder_entry:
        // Skip WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fo_skip_ws;
        mov r12, rax;

        // Expect ident start [A-Za-z_].
        cmp r12, rbp;
        jae fo_pb_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;                           // '_'
        je  fo_pb_binder_scan;
        cmp rax, 0x41;                           // 'A'
        jb  fo_pb_err_syntax;
        cmp rax, 0x5A;                           // 'Z'
        jbe fo_pb_binder_scan;
        cmp rax, 0x61;                           // 'a'
        jb  fo_pb_err_syntax;
        cmp rax, 0x7A;                           // 'z'
        ja  fo_pb_err_syntax;

      fo_pb_binder_scan:
        // name_start = r12; walk continuation bytes while they are
        // in [A-Za-z0-9_].
        mov r15, r12;                            // name_start
        add r12, 1;

      fo_pb_binder_cont:
        cmp r12, rbp;
        jae fo_pb_binder_done;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x5F;                           // '_'
        je  fo_pb_binder_step;
        cmp rax, 0x30;                           // '0'
        jb  fo_pb_binder_check_alpha;
        cmp rax, 0x39;                           // '9'
        jbe fo_pb_binder_step;
      fo_pb_binder_check_alpha:
        cmp rax, 0x41;                           // 'A'
        jb  fo_pb_binder_done;
        cmp rax, 0x5A;                           // 'Z'
        jbe fo_pb_binder_step;
        cmp rax, 0x61;                           // 'a'
        jb  fo_pb_binder_done;
        cmp rax, 0x7A;                           // 'z'
        ja  fo_pb_binder_done;
      fo_pb_binder_step:
        add r12, 1;
        jmp fo_pb_binder_cont;

      fo_pb_binder_done:
        // name_len = r12 - name_start; must be 1..FO_NAME_MAX.
        mov rax, r12;
        sub rax, r15;
        cmp rax, 0;
        je  fo_pb_err_syntax;
        cmp rax, 14;                             // FO_NAME_MAX
        ja  fo_pb_err_name_too_long;

        // Skip WS.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fo_skip_ws;
        mov r12, rax;

        // Peek: ',' continues the list; '|' closes it; anything else
        // is a syntax error.
        cmp r12, rbp;
        jae fo_pb_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x2C;                           // ','
        je  fo_pb_binder_comma;
        cmp rax, 0x7C;                           // '|'
        je  fo_pb_binder_close;
        jmp fo_pb_err_syntax;

      fo_pb_binder_comma:
        add r12, 1;
        jmp fo_pb_binder_entry;

      fo_pb_binder_close:
        // Consume the closing `|`.
        add r12, 1;

        // ---- Body scan: all bytes up to the first `}` (M3; nested
        // `{...}` tracking lands at M3.1).
        mov r15, r12;                            // body_start

      fo_pb_body_scan:
        cmp r12, rbp;
        jae fo_pb_err_no_close_brace;
        xor rax, rax;
        mov_b rax, [rbx + r12 * 1];
        cmp rax, 0x7D;                           // '}'
        je  fo_pb_body_done;
        add r12, 1;
        jmp fo_pb_body_scan;

      fo_pb_body_done:
        // body_len = r12 - body_start; must be > 0 (empty body is
        // not a valid predicate).
        mov rax, r12;
        sub rax, r15;
        cmp rax, 0;
        je  fo_pb_err_empty_body;

        // Compose predicate_lambda_ref = (body_start << 32) | body_len
        // into rax.
        mov rax, r15;                            // body_start
        shl rax, 32;
        mov rcx, r12;
        sub rcx, r15;                            // body_len
        or  rax, rcx;

        // Write predicate_lambda_ref u64 at [r13 + 8].
        mov [r13 + 8], rax;

        // Write mode u8 at [r13 + 16].
        mov rax, [rsp + 0];                      // mode_byte
        mov_b [r13 + 16], rax;

        // Write flags u8 at [r13 + 17] (bit 0 set iff mode == 2).
        mov rax, [rsp + 0];
        cmp rax, 2;
        je  fo_pb_set_has_by;
        xor rax, rax;
        jmp fo_pb_write_flags;
      fo_pb_set_has_by:
        mov rax, 1;                              // FO_FLAG_HAS_BY
      fo_pb_write_flags:
        mov_b [r13 + 17], rax;

        // Pack return: (bytes_written << 32) | FO_OK with
        // bytes_written = FO_RECORD_BYTES = 32.
        mov rax, 32;
        shl rax, 32;
        jmp fo_pb_epilogue;

        // ----------------------------------------------------------
        // BY scan: expect `WS+ expr` until EOI.
        // ----------------------------------------------------------
      fo_pb_by:
        // Skip leading WS (the public wrapper has stripped the `by`
        // keyword but not the WS after it).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _fo_skip_ws;
        mov r12, rax;

        // body_start = r12.
        mov r15, r12;

        // Must have at least one non-WS byte.
        cmp r12, rbp;
        jae fo_pb_err_empty_body;

        // body_end = rbp (the input is CtxLexer-bounded to the stage).
        // body_len = rbp - r15.
        mov rax, rbp;
        sub rax, r15;
        cmp rax, 0;
        je  fo_pb_err_empty_body;

        // predicate_lambda_ref = (body_start << 32) | body_len.
        mov rax, r15;
        shl rax, 32;
        mov rcx, rbp;
        sub rcx, r15;
        or  rax, rcx;
        mov [r13 + 8], rax;

        // mode u8 = 2 (FO_MODE_BY).
        mov rax, 2;
        mov_b [r13 + 16], rax;

        // flags u8 = 1 (FO_FLAG_HAS_BY).
        mov rax, 1;
        mov_b [r13 + 17], rax;

        // Pack return.
        mov rax, 32;
        shl rax, 32;
        jmp fo_pb_epilogue;

        // ----------------------------------------------------------
        // Error paths. Each packs 0 in the bytes_written slot so the
        // caller treats the top 32 bits as uninitialised.
        // ----------------------------------------------------------
      fo_pb_err_syntax:
        mov rax, 0x4C00;                         // FO_ERR_SYNTAX
        jmp fo_pb_epilogue;

      fo_pb_err_no_open_brace:
        mov rax, 0x4C01;
        jmp fo_pb_epilogue;

      fo_pb_err_no_close_brace:
        mov rax, 0x4C02;
        jmp fo_pb_epilogue;

      fo_pb_err_no_pipe:
        mov rax, 0x4C03;
        jmp fo_pb_epilogue;

      fo_pb_err_name_too_long:
        mov rax, 0x4C04;
        jmp fo_pb_epilogue;

      fo_pb_err_empty_body:
        mov rax, 0x4C05;
        jmp fo_pb_epilogue;

      fo_pb_err_bad_mode:
        mov rax, 0x4C08;
        jmp fo_pb_epilogue;

      fo_pb_err_oos:
        mov rax, 0x4C09;
        jmp fo_pb_epilogue;

      fo_pb_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _fo_parse_where(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `where`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `where` head keyword, strips it from
  // the input, and delegates to `_fo_parse_body` with mode = 0.
  //
  // Head-keyword verification is INLINE (no call) because it is five
  // byte-compares and does not merit its own helper. If the head
  // keyword mismatches, returns FO_ERR_HEAD_MISMATCH -- a caller that
  // dispatches here through its own cmd_name matcher never hits this,
  // but defensive-dispatch at the shell level does.
  //
  // Prologue: 1 callee-save push (rbx = bytes_ptr) + sub rsp, 8 pad.
  // Entry rsp%16==8; +8 push = %16==0; wait 1-push is 8 bytes so
  // actually (8+8)%16 == 0; +8 pad = (8+8+8)%16 == 8 -- that's wrong.
  // Reconciled: we skip the pad since 1 push already lands rsp%16==0.
  // Actually, entry rsp%16==8; after `push rbx` rsp lowers 8 bytes
  // -> (8-8)%16==0; the nested CALL lands aligned (callee entry
  // rsp%16==8, which _fo_parse_body's own 48+24 pushes+scratch lifts
  // to %16==0 steady). We also allocate `sub rsp, 8` AFTER the push
  // so the stack footprint is a documented 16-byte frame -- it is
  // free alignment headroom reserved for an M3.1 helper call before
  // the main dispatch, and the nested CALL still lands at %16==8
  // (callee entry) because `sub rsp, 8` would put us at %16==8
  // (unaligned) -- so we DO NOT allocate the pad; the frame is
  // exactly 1 push + call + ret.
  //
  // Labels prefixed fo_wh_.
  // ==========================================================================
  pub let _fo_parse_where : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): public `where { |binder| body }` entry point. Thin wrapper that verifies the leading `where` head keyword (5 bytes: 'w','h','e','r','e' plus one trailing WS or `{`) then delegates to _fo_parse_body with mode=0 and the bytes_ptr/bytes_len shifted past the keyword. Head-keyword verification inline (no helper): fail with FO_ERR_HEAD_MISMATCH if any of the five expected bytes mismatches or if bytes_len < 5. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _fo_parse_body lands at callee entry rsp%16==8 (the callee's own 6-push + 24-byte-scratch frame then lifts to %16==0 steady for its own nested CALLs). No test; no and-imm64; no imul-r-imm; no multiline let. r11 clobbered freely as scratch. Labels prefixed fo_wh_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        mov rbx, rdi;                            // bytes_ptr saved

        // Verify leading `where` keyword (5 bytes).
        cmp rsi, 5;
        jb  fo_wh_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x77;                           // 'w'
        jne fo_wh_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x68;                           // 'h'
        jne fo_wh_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x65;                           // 'e'
        jne fo_wh_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x72;                           // 'r'
        jne fo_wh_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x65;                           // 'e'
        jne fo_wh_err_head;

        // Delegate: shift input past the 5-byte keyword.
        mov rdi, rbx;
        add rdi, 5;
        mov r10, rsi;
        sub r10, 5;
        mov rsi, r10;
        mov r8, 0;                               // mode = FO_MODE_WHERE
        call _fo_parse_body;

        pop rbx;
        ret;

      fo_wh_err_head:
        mov rax, 0x4C07;                         // FO_ERR_HEAD_MISMATCH
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _fo_parse_filter(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `filter`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `filter` head keyword (6 bytes), strips
  // it from the input, and delegates to `_fo_parse_body` with
  // mode = 1.
  //
  // Same alignment plan as `_fo_parse_where`.
  //
  // Labels prefixed fo_fi_.
  // ==========================================================================
  pub let _fo_parse_filter : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): public `filter { |binder| body }` entry point. Thin wrapper that verifies the leading `filter` head keyword (6 bytes: 'f','i','l','t','e','r') then delegates to _fo_parse_body with mode=1 and the bytes_ptr/bytes_len shifted past the keyword. Head-keyword verification inline: fail with FO_ERR_HEAD_MISMATCH if any of the six expected bytes mismatches or if bytes_len < 6. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _fo_parse_body lands aligned. At M3 the WHERE and FILTER arms share identical body semantics; the mode byte survives on the written record so a future M3.x can split the two (e.g. filter preserves non-matching rows into a diagnostic sink; where drops them silently). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fo_fi_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        mov rbx, rdi;                            // bytes_ptr saved

        // Verify leading `filter` keyword (6 bytes).
        cmp rsi, 6;
        jb  fo_fi_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x66;                           // 'f'
        jne fo_fi_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x69;                           // 'i'
        jne fo_fi_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x6C;                           // 'l'
        jne fo_fi_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 0x74;                           // 't'
        jne fo_fi_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 0x65;                           // 'e'
        jne fo_fi_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 0x72;                           // 'r'
        jne fo_fi_err_head;

        // Delegate: shift input past the 6-byte keyword.
        mov rdi, rbx;
        add rdi, 6;
        mov r10, rsi;
        sub r10, 6;
        mov rsi, r10;
        mov r8, 1;                               // mode = FO_MODE_FILTER
        call _fo_parse_body;

        pop rbx;
        ret;

      fo_fi_err_head:
        mov rax, 0x4C07;                         // FO_ERR_HEAD_MISMATCH
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _fo_parse_by(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr      -- argv bytes INCLUDING the leading `by`
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Thin wrapper: verifies the `by` head keyword (2 bytes), strips it
  // from the input, and delegates to `_fo_parse_body` with mode = 2.
  //
  // The keyword must be followed by at least one WS byte (so `byx`
  // is NOT a valid `by` form, mirroring Perl's/Ruby's lexer-level
  // rejection of `byx`). The WS byte is consumed by the delegated
  // `_fo_parse_body`'s initial `_fo_skip_ws` so this wrapper does
  // not re-check it.
  //
  // Same alignment plan as `_fo_parse_where`.
  //
  // Labels prefixed fo_by_.
  // ==========================================================================
  pub let _fo_parse_by : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): public `by EXPR` entry point. Thin wrapper that verifies the leading `by` head keyword (2 bytes: 'b','y') plus one trailing WS byte (SP/TAB/LF/CR) so `byx` is rejected cleanly, then delegates to _fo_parse_body with mode=2 and the bytes_ptr/bytes_len shifted past the 2-byte keyword. Head-keyword verification inline: fail with FO_ERR_NO_BY_KEYWORD if either of the two expected bytes mismatches, if bytes_len < 3, or if byte[2] is not in {0x20, 0x09, 0x0A, 0x0D}. Entry rsp%16==8; prologue is 1 callee-save push (rbx=bytes_ptr); after the push rsp%16==0 so the nested CALL into _fo_parse_body lands aligned. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fo_by_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        mov rbx, rdi;                            // bytes_ptr saved

        // Verify leading `by` keyword + trailing WS (3 bytes min).
        cmp rsi, 3;
        jb  fo_by_err_head;

        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x62;                           // 'b'
        jne fo_by_err_head;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x79;                           // 'y'
        jne fo_by_err_head;

        // byte[2] must be WS so `byx` is rejected.
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 0x20;
        je  fo_by_ws_ok;
        cmp rax, 0x09;
        je  fo_by_ws_ok;
        cmp rax, 0x0A;
        je  fo_by_ws_ok;
        cmp rax, 0x0D;
        je  fo_by_ws_ok;
        jmp fo_by_err_head;

      fo_by_ws_ok:
        // Delegate: shift input past the 2-byte keyword (keep the WS
        // byte so the delegated _fo_skip_ws consumes it).
        mov rdi, rbx;
        add rdi, 2;
        mov r10, rsi;
        sub r10, 2;
        mov rsi, r10;
        mov r8, 2;                               // mode = FO_MODE_BY
        call _fo_parse_body;

        pop rbx;
        ret;

      fo_by_err_head:
        mov rax, 0x4C06;                         // FO_ERR_NO_BY_KEYWORD
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _fo_desugar_by(expr_ptr, expr_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = expr_ptr   -- the expression bytes AFTER the `by ` prefix
  //   rsi = expr_len
  //   rdx = out_ptr    -- destination buffer for the synthesised
  //                       lambda-source string
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Synthesises `\f -> f.<expr>` into out_ptr. The caller supplies
  // the expression bytes with the leading `by` + WS already stripped
  // (so the helper is reusable from non-shell contexts). The
  // synthesised string is suitable for feeding to R224.M1 LambdaLit
  // `_ll_parse` as the predicate source.
  //
  // Written bytes:
  //
  //     \f -> f.<expr>
  //     ^^^^^^^^^      7-byte fixed prefix (backslash, 'f', SP,
  //                    '-', '>', SP, 'f', '.')  -- 8 bytes actually.
  //
  // Count re-check: `\f -> f.` is '\', 'f', ' ', '-', '>', ' ',
  // 'f', '.' = 8 bytes. The record's expr span follows directly
  // after, so bytes_written = 8 + expr_len.
  //
  // Capacity guard: out_cap >= 8 + expr_len; else FO_ERR_OUT_TOO_SMALL.
  // Empty expression (expr_len == 0): FO_ERR_EMPTY_BODY.
  //
  // Prologue: 5 callee-save pushes (rbx = expr_ptr, rbp = expr_len,
  // r12 = out_ptr, r13 = i cursor, r14 = scratch) + sub rsp, 16
  // (two u64 scratch slots reserved for M3.1 helper calls).
  //
  // Labels prefixed fo_dsg_.
  // ==========================================================================
  pub let _fo_desugar_by : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (expr_ptr: u64) (expr_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M3 (#2668): synthesise `\\f -> f.<expr>` lambda-source bytes into out_ptr. 5 callee-save pushes (rbx=expr_ptr, rbp=expr_len, r12=out_ptr, r13=i cursor, r14=scratch) + sub rsp, 16 (two u64 scratch slots reserved for M3.1 helper calls) -> rsp%16==0 at a hypothetical future nested CALL (entry 8, +40 pushes = 0, +16 scratch = 0). At M3 the body contains no nested CALL; the frame is reserved for an M3.1 extension that may call _fo_skip_ws to trim trailing WS from the expr bytes. Fixed 8-byte prefix: 0x5C ('\\'), 0x66 ('f'), 0x20 (SP), 0x2D ('-'), 0x3E ('>'), 0x20 (SP), 0x66 ('f'), 0x2E ('.'). Each prefix byte is written by a `mov rax, imm32; mov_b [r12 + i], rax` pair (imm32 for the ASCII literal; mov_b for the low byte). Expression bytes are copied in a byte-loop at offset 8. Capacity guard: out_cap >= 8 + expr_len; else FO_ERR_OUT_TOO_SMALL (0x4C09). Empty-expr guard: expr_len == 0; else FO_ERR_EMPTY_BODY (0x4C05). bytes_written = 8 + expr_len on success; packed as (bytes_written << 32) | FO_OK. No test; no and-imm64; no imul-r-imm; no multiline let. r11 clobbered freely as scratch. Labels prefixed fo_dsg_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        xor rax, rax;
        mov [rsp + 0], rax;
        mov [rsp + 8], rax;

        mov rbx, rdi;                            // expr_ptr
        mov rbp, rsi;                            // expr_len
        mov r12, rdx;                            // out_ptr
        xor r13, r13;                            // i = 0
        xor r14, r14;                            // scratch

        // Empty-expr guard.
        cmp rbp, 0;
        je  fo_dsg_err_empty;

        // Capacity guard: need 8 + expr_len bytes.
        mov rax, rbp;
        add rax, 8;
        cmp rcx, rax;
        jb  fo_dsg_err_oos;

        // Write 8-byte prefix: '\', 'f', ' ', '-', '>', ' ', 'f', '.'
        mov rax, 0x5C;                           // '\'
        mov_b [r12 + 0], rax;
        mov rax, 0x66;                           // 'f'
        mov_b [r12 + 1], rax;
        mov rax, 0x20;                           // SP
        mov_b [r12 + 2], rax;
        mov rax, 0x2D;                           // '-'
        mov_b [r12 + 3], rax;
        mov rax, 0x3E;                           // '>'
        mov_b [r12 + 4], rax;
        mov rax, 0x20;                           // SP
        mov_b [r12 + 5], rax;
        mov rax, 0x66;                           // 'f'
        mov_b [r12 + 6], rax;
        mov rax, 0x2E;                           // '.'
        mov_b [r12 + 7], rax;

        // Copy expr bytes: for i in 0..expr_len:
        //   out_ptr[8 + i] = expr_ptr[i]
      fo_dsg_copy:
        cmp r13, rbp;
        jae fo_dsg_done;
        // src byte.
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        // dst addr = out_ptr + 8 + i.
        mov r14, r12;
        add r14, 8;
        add r14, r13;
        mov_b [r14 + 0], rax;
        add r13, 1;
        jmp fo_dsg_copy;

      fo_dsg_done:
        // Pack return: ((8 + expr_len) << 32) | FO_OK.
        mov rax, rbp;
        add rax, 8;
        shl rax, 32;
        jmp fo_dsg_epilogue;

      fo_dsg_err_empty:
        mov rax, 0x4C05;                         // FO_ERR_EMPTY_BODY
        jmp fo_dsg_epilogue;

      fo_dsg_err_oos:
        mov rax, 0x4C09;                         // FO_ERR_OUT_TOO_SMALL
        jmp fo_dsg_epilogue;

      fo_dsg_epilogue:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
