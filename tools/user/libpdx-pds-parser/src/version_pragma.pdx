// src/version_pragma.pdx -- libpdx-pds-parser.R227.M6 (paideia-os#2708)
//
// VersionPragma: parser-tier primitive that parses the
// `#requires-paideia OP X.Y[.Z]` directive into a 32-byte VersionPragma
// record and compares the parsed constraint against a caller-supplied
// running-system version triple. R227.M6 of the pds container / loader
// umbrella; the PARSER-tier half of the kernel-side R133.M4
// `_vg_check` version-gate dispatcher.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R227 is the pds container / loader umbrella (paideia-os#2491). R227.M1
// (header pragmas) landed Wave 112 at the kernel tier; R227.M2 (cap-decl
// checker) landed Wave 115 at the kernel tier; R227.M3 (ImportResolve)
// landed Wave 129; R227.M4 (LoadCheck) landed Wave 129; R227.M5
// (ModuleFunctor) landed Wave 130 / 131. R227.M6 (THIS module) lands
// the PARSER-TIER half of the version-pragma machinery:
//
//   * parse one `#requires-paideia OP X.Y[.Z]` directive out of a byte
//     range into a 32-byte VersionPragma record;
//   * check a parsed record against a caller-supplied running-system
//     (major, minor, patch) triple and return VP_OK / VP_ERR_VERSION_
//     MISMATCH.
//
// The kernel-side R133.M4 `_vg_check` already implements the version
// gate as a single-shot dispatcher (parse + compare against the kernel
// version triple in one entry). THIS module splits the dispatcher into
// a PARSE phase (emits a reusable record) and a CHECK phase (callable
// against ANY running-triple -- not only the kernel-tier
// KERNEL_VERSION_* statics). The two halves agree on grammar,
// comparison semantics, and semver digit-cap (per the Wave 118 R133.M4
// lesson: cap each component's digit run at 9 to avoid u32 overflow).
//
// Reasons the parser-tier split exists:
//
//   (A) OFFLINE REUSE. A hypothetical `pdsc verify` driver (R227.M4.5
//       forward-path) needs to parse `#requires-paideia` directives
//       outside the running kernel; THIS module makes that reuse
//       possible without re-invoking the kernel-tier dispatcher.
//
//   (B) MULTI-SHIM CHECKING. The REPL may need to version-gate a
//       script against the shell's own version (parser lib triple)
//       OR against a federated-remote peer's version, not just the
//       kernel's. `_vp_check` takes the running triple as explicit
//       u64 arguments so the caller picks the compare target.
//
//   (C) RECORD REUSE. A load-time pds-loader walk may parse the
//       pragma once, cache the record, and check against several
//       candidate (running) triples (e.g. during federation
//       negotiation). The 32-byte record is cheap to cache and
//       pointer-pass.
//
// The two halves do NOT share .bss state (both are PURE LEAVES over
// caller-supplied buffers) and do NOT share a packed-status band --
// the kernel-side 0x3B00..0x3BFF band stays with `_vg_check`; the
// parser-tier 0x6200..0x62FF band is this module's own.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//   VersionPragma := '#requires-paideia' WS+ OP WS+ SEMVER
//   OP            := '>=' | '<=' | '~=' | '>' | '<' | '='
//   SEMVER        := DIGITS '.' DIGITS [ '.' DIGITS ]
//   DIGITS        := [0-9]+                      1..9 digits per component
//   WS            := 0x20 | 0x09 | 0x0A | 0x0D
//
// The parser scans greedily: `>=` matches before `>`, `<=` before `<`,
// `~=` before any single-byte op. Trailing whitespace / newline after
// the version is tolerated and left to the caller; `bytes_consumed`
// (packed into the high 32 of the return) points at the first byte
// AFTER the last parsed semver digit so the caller can advance.
//
// `~=` is the "compatible with" op -- same major, equal-or-newer within
// that major. Named `~=` because `^` is a bitxor token in pdx-lang
// (parity with R133.M4 kernel-side).
//
// Semver digit-cap: each component's digit run is CAPPED AT 9 DIGITS
// (`cmp rcx, 9; ja vp_bad_semver`). The paideia-as R133.M4 Wave 118
// lesson: a u32 component overflows at 10 digits ($2^{32} - 1 = 4
// 294 967 295$, ten decimal places). Cap at 9 keeps every component
// safely inside u32.
//
// =============================================================================
// COMPARISON SEMANTICS
// =============================================================================
//
// Three-way lex compare on (major, minor, patch):
//
//     cmp3((hm,hn,hp), (rm,rn,rp)) =
//         HI    if hm > rm, or (hm==rm and hn > rn),
//                      or (hm==rm and hn==rn and hp > rp)
//         EQ    if (hm,hn,hp) == (rm,rn,rp)
//         LO    otherwise
//
// Op dispatch (same as kernel-side `_vg_check`):
//
//     =    satisfied when cmp == EQ
//     >=   satisfied when cmp in {HI, EQ}
//     <=   satisfied when cmp in {LO, EQ}
//     >    satisfied when cmp == HI
//     <    satisfied when cmp == LO
//     ~=   satisfied when have.major == req.major AND cmp in {HI, EQ}
//
// The internal three-way result is encoded as rsi in {0 (LO), 1 (EQ),
// 2 (HI)} so each dispatch arm uses an imm8-fit cmp.
//
// (have, running) is the FIRST operand of each compare (the caller-
// supplied running triple); (req, required) is the SECOND operand
// (loaded from the parsed VersionPragma record).
//
// =============================================================================
// VERSIONPRAGMA RECORD (32 bytes)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -----------------------------------------------------
//     0      4   magic         u32   'RVPR' LE (0x52505652) -- bytes
//                                     52 56 50 52 in a hex-dump scan
//     4      1   op            u8    0 VP_OP_EQ, 1 VP_OP_GE, 2 VP_OP_LE,
//                                     3 VP_OP_GT, 4 VP_OP_LT, 5
//                                     VP_OP_TILDE
//     5      1   flags         u8    bit 0 VP_FLAG_PATCH_PRESENT set
//                                     iff the parsed directive supplied
//                                     a `.patch` component; bits 1..7
//                                     reserved, zero at M6.
//     6      2   reserved_6    u16   zero at M6.
//     8      4   major         u32   parsed major; 0..999_999_999.
//    12      4   minor         u32   parsed minor; 0..999_999_999.
//    16      4   patch         u32   parsed patch; 0..999_999_999;
//                                     zero when VP_FLAG_PATCH_PRESENT
//                                     is clear.
//    20     12   reserved_20   u8[12] zero at M6.
//
//   total: 32 B (VP_RECORD_BYTES; power-of-two stride for `shl rN, 5`
//                addressing without 2-op imul-r-imm)
//
// Rationale:
//
//   * Stride 32 = 2^5 so a dispatcher indexing an array of
//     VersionPragma records (future per-import pragma cache) multiplies
//     via `shl rN, 5` -- no 2-op `imul r, imm`.
//   * Magic 'RVPR' = 0x52505652 LE reads as the 4-byte ASCII string
//     "RVPR" in a hex-dump sequential scan (byte sequence 52 56 50 52).
//     Distinct from R222.M3 FunctorInstance's 'FINS' (0x534E4946),
//     R227.M3 ImportResolve's 'IMPT' (0x54504D49), R227.M4 LoadCheck's
//     'LCDG' (0x47444C4C), R227.M5 ModuleFunctor's 'MFCT' (0x5443464D),
//     R229.M10 TurnFingerprint's 'TFPR' (0x52504654), R222.M2
//     CommandSig's 'CSIG' (0x47495343), R229.M5 History's 'HREC'
//     (0x43455248), R223.M5 WireSink's 'WSNK' (0x4B4E5357), R223.M6
//     HostnameAnnot's 'HOST' (0x54534F48), R222.M8 DescribeSig's
//     'DESC' (0x43534544), R223.M7 SessionType's 'SESS' (0x53534553),
//     and R225.M7 DiagReport's 'DIAG' (0x47414944). Magic 0x52505652
//     fits imm32 with bit 31 clear so direct `mov r9, 0x52505652`
//     (mov-r64-imm32-zero-extend) + `mov_d [r12 + 0], r9` lands the
//     magic without a MOVABS.
//   * The 12-byte reserved tail (0x14..0x20) carries no payload at
//     M6; forward-path landings reserve it for an optional parsed-
//     prerelease tag (M6.1), parsed-build-metadata tag (M6.2), and
//     a two-u16 err-span pair (M6.3; `src_offset` + `src_length` on
//     the directive line, for diagnostic span injection).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _vp_init() -> ()
//     Bare `ret` at raw M6. VersionPragma holds NO `.bss` state at
//     this landing -- every record is caller-owned on all operational
//     paths. Kept for parallelism with the parser-family init-hook
//     convention (`_mf_init` R227.M5, `_lc_init` R227.M4, `_ir_init`
//     R227.M3, `_tf_init` R229.M10, `_lh_init` R225.M8, `_dr_init`
//     R225.M7, `_rc_init` R225.M6, `_st_init` R223.M7, `_ha_init`
//     R223.M6, `_ws_init` R223.M5, `_ds_init` R222.M8) so an M6.1+
//     landing that adds `.bss` (per-session pragma intern table,
//     check counter, diag-chain head) does not break the API.
//
//   _vp_parse(bytes, bytes_len, out, out_cap) -> packed_u64
//     Parse one `#requires-paideia OP X.Y[.Z]` directive out of the
//     leading bytes of a source byte run. Writes one 32-byte
//     VersionPragma record. Returns `(bytes_consumed << 32) | status`.
//
//     Register map: (rdi, rsi, rdx, rcx) -> rax.
//
//   _vp_check(record_ref, running_major, running_minor, running_patch)
//                                                 -> status
//     Compare a parsed VersionPragma record against a caller-supplied
//     running-system version triple. Returns VP_OK (0) iff the
//     recorded (op, req_major, req_minor, req_patch) is satisfied by
//     the running triple; VP_ERR_VERSION_MISMATCH (0x6210) iff the
//     constraint fails; VP_ERR_BAD_RECORD (0x6204) iff record_ref ==
//     0 OR the magic u32 at [+0] does not match 'RVPR'.
//
//     Register map: (rdi, rsi, rdx, rcx) -> rax.
//
// =============================================================================
// STATUS BAND -- 0x6200..0x62FF
// =============================================================================
//
//   VP_OK                       = 0
//   VP_ERR_BAD_DIRECTIVE        = 0x6200   prefix mismatch -- the input
//                                           does not begin with the exact
//                                           17-byte string "#requires-
//                                           paideia".
//   VP_ERR_BAD_OP               = 0x6201   op token not in {>=, <=, ~=,
//                                           >, <, =}.
//   VP_ERR_BAD_SEMVER           = 0x6202   missing / malformed digit run
//                                           OR missing '.' between major
//                                           and minor OR digit count > 9
//                                           on any component (u32 overflow
//                                           guard; R133.M4 Wave 118
//                                           lesson).
//   VP_ERR_OUT_TOO_SMALL        = 0x6203   _vp_parse: out == 0 or
//                                           out_cap < VP_RECORD_BYTES
//                                           (32).
//   VP_ERR_BAD_RECORD           = 0x6204   _vp_check: record_ref == 0
//                                           or magic mismatch.
//   VP_ERR_SRC_TOO_SHORT        = 0x6205   _vp_parse: bytes_len < 18
//                                           (prefix 17 + at least one
//                                           trailing byte).
//   VP_ERR_VERSION_MISMATCH     = 0x6210   _vp_check: directive parsed
//                                           but running triple fails op
//                                           vs required triple.
//
// Slots 0x6206..0x620F reserved for M6.1+ parse diagnostics (prerelease
// tag parse, build-metadata tag parse, non-ASCII byte in directive,
// trailing-garbage strictness toggle, trailing-newline requirement
// toggle). Slots 0x6211..0x62FF reserved for M6.2+ check diagnostics
// (version-skew warn-level, prerelease-ordering compare, build-metadata-
// ignore flag assertion).
//
// The 0x6200..0x62FF carve-out skips the parallel 0x6100..0x61FF band
// (R225.M9 property-test harness arm) and sits directly above the
// R229.M10 TurnFingerprint band (0x6000..0x60FF). A downstream
// compound-error dispatcher discriminates "version-pragma substrate
// faulted" from every other satellite's failure modes via
// `shr r, 8; cmp r, 0x62`. Disjoint from every landed parser-tier
// packed-status range AND from the kernel-side 0x3B00..0x3BFF
// VersionGate band (two halves of the same version-check machinery
// in disjoint error-code spaces -- the parser-tier record producer
// vs. the kernel-tier dispatcher).
//
// Grep confirmation at R227.M6 landing time:
//   grep -rE '0x62(0[0-5]|10)\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/version-pragma.md.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the VP_FLAG_PATCH_PRESENT bit is a single
//     imm8 (`or r11, 1`); no multi-byte mask is used.
//   - No 2-op `imul rN, imm` -- the 32-byte stride is `shl rN, 5`
//     (power of two). The semver digit accumulator uses
//     `(acc * 8) + (acc * 2) = acc * 10` via `shl` + `add` (precedent
//     kernel-side version_gate.pdx L507-514 and R229.M10
//     turn_fingerprint `_tf_pow10` decimal rendering).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `VersionPragma` matches `version_pragma.pdx`.
//   - Labels prefixed `vp_` with per-handler suffix (`vp_ini_` init,
//     `vp_pa_` parse, `vp_ck_` check). Grep-confirmed virgin inside
//     tools/user/libpdx-pds-parser/src/*.pdx (no prior `vp_` label
//     in the parser-tier library). The kernel-side `vp_submit` /
//     `vp_await` symbols in src/kernel/core/ipc/vello_render_channel.pdx
//     are GLOBAL linker symbols in the kernel, NOT local labels in
//     this parser-tier library; the two live in disjoint linker
//     scopes (parser-tier library has its own namespace; call sites
//     reach `vp_submit` by linker fixup only when the kernel is in
//     the link set, which this library NEVER is). Grep-confirmed
//     disjoint from every landed parser-tier label prefix (u8n_,
//     gi_, wp_, cl_, ast_, sm_, fh_, sch_sig_, cmd_sig_, fi_, afs_,
//     cmdreg_, dm_, ds_, pl_, pl_lam_, rp_, fo_, sgr_, ws_, ha_,
//     st_, ll_, cc_, er_, cr_, ls_, lp_, hm_, rt_, eu_, dl_, se_,
//     te_, jc_, h_, le_, vi_, ml_, ir_, rc_, rd_, dr_, lc_, lh_,
//     tf_, mf_) AND from the kernel-side `vg_` prefix (R133.M4
//     VersionGate) -- `vp_` and `vg_` differ on the second
//     character and label resolution is prefix-anchored, not first-
//     character-coalesced. Never bare `loop` / `if` / `let` / `fn`
//     / `ret` (per reference_paideia_as_reserved_labels).
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 5, 9, 17, 18, 32,
//     byte literals 0x09, 0x0A, 0x0D, 0x20, 0x23, 0x2D, 0x2E, 0x30,
//     0x39, 0x3C, 0x3D, 0x3E, 0x61, 0x65, 0x69, 0x70, 0x72, 0x7E,
//     status codes 0x6200..0x6210, magic 0x52505652) fit imm32 with
//     bit 31 clear so direct cmp-imm32 is sign-extension-safe.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx * 1]` with
//     explicit *1 scale (mov_b does not implicitly zero-extend per
//     the R133.M3 L450 precedent).
//   - Byte stores via `mov_b [dst + disp], reg`.
//   - u16 stores via `mov_w [dst + disp], reg` -- not needed at M6
//     (the reserved u16 is covered by zero-fill).
//   - u32 stores via `mov_d [dst + disp], reg`.
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - No chained-displacement addressing with three terms: all
//     [base + off + idx] expressions precomputed via `add` first.
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
//   * `_vp_init`: zero pushes; zero stack frame; zero nested CALL.
//     Bare `ret`. VersionPragma holds NO `.bss` state at raw M6.
//
//   * `_vp_parse`: 6-push callee-save frame (rbx, rbp, r12, r13, r14,
//     r15 = 48 B). Pure leaf (no nested CALL) so no sub-rsp pad is
//     needed. Register plan:
//       rbx = bytes_ptr        (held through the whole scan)
//       rbp = bytes_len
//       r12 = out              (held through zero-fill + emit)
//       r13 = cursor
//       r14 = parsed_op        (0..5; written to [out+4] at emit)
//       r15 = patch_flag       (0 or VP_FLAG_PATCH_PRESENT bit)
//     Scratch: rax, rcx, rdx, rsi, rdi, r8 (digit accumulator), r9
//     (digit scratch), r10 (digit *10 scratch), r11 (misc).
//
//   * `_vp_check`: 4-push callee-save frame (rbx, rbp, r12, r13).
//     Pure leaf (no nested CALL) so no sub-rsp pad is needed.
//     Register plan:
//       rbx = record_ref
//       rbp = running_major
//       r12 = running_minor
//       r13 = running_patch
//     Scratch: rax, rcx, rdx, rsi (three-way result 0/1/2), rdi, r8
//     (req_major), r9 (req_minor), r10 (req_patch), r11 (op code),
//     r14, r15.
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// R227.M6 holds NO `.bss` state at this landing (parallel to R227.M5
// ModuleFunctor, R229.M10 TurnFingerprint, R225.M8 LspHover, R225.M7
// DiagReport, R225.M6 RankCheck, R223.M5 WireSink, R223.M6
// HostnameAnnot, R223.M7 SessionType). `.bss` zero-init at cold boot
// trivially satisfies the module's "no mutable state" invariant.
// `_vp_init` is a bare `ret` kept for parallelism with the parser-
// family init-hook convention.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R133.M4 (kernel-side `_vg_check` version gate) -- the kernel-tier
//     DISPATCHER walks a `.pds` pragma line in one shot (parse +
//     compare against the kernel-tier KERNEL_VERSION_* statics).
//     THIS module splits the dispatcher into a parse phase and a
//     check phase so the record can be reused OR cached, and so a
//     non-kernel running triple can be supplied by the caller.
//     Grammar and comparison semantics are identical.
//
//   R227.M1 (kernel pds header pragmas) -- the containing `.pds`
//     container reader walks the TEXT section and feeds the single
//     `#requires-paideia` line to THIS module.
//
//   R227.M3 (ImportResolve) -- a per-module `#requires-paideia`
//     constraint may be propagated along with the ImportDirective at
//     the M6.3 forward-path landing (per-import version pin).
//
//   R221.M1 (Utf8Nfc) -- R227.M6 operates on ALREADY-NORMALISED NFC
//     bytes; the caller walks text through Utf8Nfc first and hands
//     the normalised bytes to _vp_parse. ASCII-only grammar is
//     reasonable because the `#requires-paideia` directive is all
//     ASCII (prefix, op token, decimal digits, dot separators).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R227.M6.1  Prerelease tag parse: extend the record's reserved tail
//              to carry a prerelease tag (`-alpha.1`, `-rc.2`) per
//              SemVer 2.0 §9; add VP_ERR_BAD_PRERELEASE diagnostic
//              in 0x6206..0x620F reserved slot.
//   R227.M6.2  Build-metadata parse: SemVer 2.0 §10 `+build.1`;
//              record extension; VP_FLAG_BUILD_PRESENT bit.
//   R227.M6.3  Per-import version pin: ImportResolve carries a
//              parsed VersionPragma pointer per ImportDirective; the
//              loader cross-checks against the imported module's
//              own `#requires-paideia` on resolve.
//   R227.M6.4  Diagnostic span: `src_offset` + `src_length` u16 pair
//              in the reserved tail so a downstream reporter can
//              render the exact directive bytes without re-reading
//              the source line.
//   R227.M6.5  8-fixture acceptance corpus `tests/proptest_version_
//              pragma.pdx`: four matching + four mismatching fixtures
//              per the ticket acceptance anchor (see design doc §7).
//
// =============================================================================
// Upstream: paideia-os#2491 (R227 pds container umbrella), paideia-os
// #2708 (THIS ticket, R227.M6 Version pragma + resolution).
// Mirror: paideia-os#2623 (R133.M4 kernel-side VersionGate) -- grammar
// + comparison semantics identical; error-code spaces disjoint
// (parser-tier 0x6200..0x62FF vs. kernel-tier 0x3B00..0x3BFF).
// Design doc: design/shell/version-pragma.md.

module VersionPragma = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Band 0x6200..0x62FF, reserved for the R227.M6 version-pragma
  // substrate. Disjoint from every prior landed satellite band AND
  // from the kernel-tier 0x3B00..0x3BFF VersionGate band.

  pub let VP_OK                       : u64 = 0
  pub let VP_ERR_BAD_DIRECTIVE        : u64 = 0x6200
  pub let VP_ERR_BAD_OP               : u64 = 0x6201
  pub let VP_ERR_BAD_SEMVER           : u64 = 0x6202
  pub let VP_ERR_OUT_TOO_SMALL        : u64 = 0x6203
  pub let VP_ERR_BAD_RECORD           : u64 = 0x6204
  pub let VP_ERR_SRC_TOO_SHORT        : u64 = 0x6205
  pub let VP_ERR_VERSION_MISMATCH     : u64 = 0x6210

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let VP_RECORD_BYTES             : u64 = 32
  pub let VP_PREFIX_LEN               : u64 = 17       // '#requires-paideia'
  pub let VP_MIN_SRC_LEN              : u64 = 18       // prefix + at least 1
  pub let VP_DIGIT_CAP                : u64 = 9        // u32 overflow guard

  // Magic: 'RVPR' little-endian = 0x52505652. Reads as the 4-byte
  // ASCII string "RVPR" in a hex dump (bytes 52 56 50 52).
  pub let VP_RECORD_MAGIC             : u64 = 0x52505652

  // Field offsets within one VersionPragma record.
  pub let VP_OFF_MAGIC                : u64 = 0        // u32
  pub let VP_OFF_OP                   : u64 = 4        // u8
  pub let VP_OFF_FLAGS                : u64 = 5        // u8
  pub let VP_OFF_RESERVED_6           : u64 = 6        // u16
  pub let VP_OFF_MAJOR                : u64 = 8        // u32
  pub let VP_OFF_MINOR                : u64 = 12       // u32
  pub let VP_OFF_PATCH                : u64 = 16       // u32
  pub let VP_OFF_RESERVED_20          : u64 = 20       // u8[12]

  // Op codes (match the kernel-side VersionGate dispatch layout in
  // the semantic sense but encoded 0..5 here so VP_OP_EQ = 0 fits
  // the implicit record initialiser).
  pub let VP_OP_EQ                    : u64 = 0
  pub let VP_OP_GE                    : u64 = 1
  pub let VP_OP_LE                    : u64 = 2
  pub let VP_OP_GT                    : u64 = 3
  pub let VP_OP_LT                    : u64 = 4
  pub let VP_OP_TILDE                 : u64 = 5

  // Flag bits in the `flags` u8 at [record + 5].
  pub let VP_FLAG_PATCH_PRESENT       : u64 = 0x01

  // Three-way compare result codes (internal, in rsi).
  pub let VP_CMP_LO                   : u64 = 0
  pub let VP_CMP_EQ                   : u64 = 1
  pub let VP_CMP_HI                   : u64 = 2

  // Directive prefix "#requires-paideia" (17 bytes; stored NUL-
  // padded to 18 bytes for alignment, compared on 17 of 18 bytes).
  pub let vp_prefix     : [u8; 18] = "#requires-paideia\0"

  // ==========================================================================
  // _vp_init() -> ()
  //
  //   Bare `ret`. VersionPragma holds NO `.bss` state at raw M6.
  //   Pure leaf; zero pushes; no stack frame; no nested CALL.
  //
  // Labels prefixed vp_ini_.
  // ==========================================================================
  pub let _vp_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R227.M6 (#2708): bare `ret`. VersionPragma holds NO .bss state at raw M6 (every record is caller-owned on all operational paths). Kept for parallelism with the parser-family init-hook convention (_mf_init R227.M5, _lc_init R227.M4, _ir_init R227.M3, _tf_init R229.M10, _lh_init R225.M8, _dr_init R225.M7, _rc_init R225.M6, _st_init R223.M7, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8) so an M6.1+ landing that adds .bss (per-session pragma intern table, check counter, diag-chain head) does not break the API. Pure leaf; zero pushes; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed vp_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _vp_parse(bytes, bytes_len, out, out_cap)
  //                                     -> (bytes_consumed << 32) | status
  //
  //   rdi = bytes
  //   rsi = bytes_len
  //   rdx = out
  //   rcx = out_cap
  //   rax = (bytes_consumed << 32) | status
  //
  // Parse one `#requires-paideia OP X.Y[.Z]` directive. See the top-
  // of-file API block for the full flow and semantics. Pure leaf
  // (6-push; no nested CALL).
  //
  // Flow:
  //   1. Validate out != 0, out_cap >= VP_RECORD_BYTES (32).
  //   2. Validate bytes_len >= VP_MIN_SRC_LEN (18).
  //   3. Zero-fill the 32-byte record via four u64 stores.
  //   4. memcmp src[0..17] vs vp_prefix[0..17]; mismatch -> BAD_DIRECTIVE.
  //   5. Skip WS+ (required at least one). Mismatch -> BAD_DIRECTIVE.
  //   6. Parse op token (greedy 2-char first, then 1-char). On
  //      failure -> BAD_OP. Stash op code (0..5) in r14.
  //   7. Skip WS+ (required at least one). Mismatch -> BAD_SEMVER.
  //   8. Parse major digits (1..9) into local accumulator; store u32
  //      at [out+8]. Zero digits or > 9 digits -> BAD_SEMVER.
  //   9. Expect '.'. Mismatch -> BAD_SEMVER.
  //  10. Parse minor digits (1..9); store u32 at [out+12].
  //  11. If next byte is '.', parse patch digits (1..9); store u32
  //      at [out+16]; set r15 = VP_FLAG_PATCH_PRESENT.
  //  12. Emit magic u32 at [out+0]; op u8 at [out+4]; flags u8 at
  //      [out+5]. Reserved bytes stay zero from zero-fill.
  //  13. Return packed (bytes_consumed << 32) | VP_OK.
  //
  // Labels prefixed vp_pa_.
  // ==========================================================================
  pub let _vp_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes: u64) (bytes_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M6 (#2708): _vp_parse parses one `#requires-paideia OP X.Y[.Z]` directive out of the leading bytes of a source byte run and emits a 32-byte VersionPragma record. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=out, r13=cursor, r14=parsed_op, r15=patch_flag); pure leaf (no nested CALL) so no sub-rsp pad is needed. Guards: out != 0 (cmp rdx, 0; je vp_pa_oos); out_cap >= VP_RECORD_BYTES 32 (cmp rcx, 32; jb vp_pa_oos); bytes_len >= VP_MIN_SRC_LEN 18 (cmp rsi, 18; jb vp_pa_sts). Zero-fill 32 bytes at [out, out+32) via four u64 stores at displacements 0, 8, 16, 24 with rax=0. memcmp 17 bytes of src vs vp_prefix via explicit per-byte compare loop (xor rax, rax; mov_b rax, [rbx + r13 * 1]; xor rcx, rcx; mov_b rcx, [r9 + r13 * 1]; cmp rax, rcx; jne vp_pa_bd); mismatch -> VP_ERR_BAD_DIRECTIVE 0x6200. Skip WS+ (SP 0x20, TAB 0x09, LF 0x0A, CR 0x0D) advancing r13; first iteration must consume at least one WS byte (mismatch -> VP_ERR_BAD_DIRECTIVE). Parse op token: load first op byte; try 2-char first by probing [r13+1]: '>' + '=' -> VP_OP_GE (1), '>' alone -> VP_OP_GT (3); '<' + '=' -> VP_OP_LE (2), '<' alone -> VP_OP_LT (4); '~' + '=' -> VP_OP_TILDE (5), '~' alone -> VP_ERR_BAD_OP; '=' alone -> VP_OP_EQ (0); any other first byte -> VP_ERR_BAD_OP. Stash op code in r14; advance r13 by 1 or 2. Skip WS+ (required at least one; mismatch -> VP_ERR_BAD_SEMVER). Parse major digits: zero accumulator r8; zero digit count rcx; loop while byte in [0x30, 0x39]: acc = (acc<<3) + (acc<<1) + (byte - 0x30) via mov r10, r8; shl r10, 3; mov r11, r8; shl r11, 1; add r10, r11; sub rax, 48; add r10, rax; mov r8, r10; add r13, 1; add rcx, 1; cmp rcx, 9; ja vp_pa_bs; -- cap at 9 digits (R133.M4 Wave 118 u32 overflow guard). Zero digits -> VP_ERR_BAD_SEMVER. Store major u32 at [out+8] via mov_d. Expect '.' (0x2E); mismatch -> VP_ERR_BAD_SEMVER. Parse minor digits same shape; store u32 at [out+12]. If next byte is '.', advance and parse patch digits same shape; store u32 at [out+16]; set r15 = 1 (VP_FLAG_PATCH_PRESENT bit 0). Emit record header: mov r9, 0x52505652; mov_d [r12+0], r9 (magic); mov_b [r12+4], r14 (op); mov_b [r12+5], r15 (flags; reserved bits stay zero). Pack return: shl r13 (consumed_bytes) by 32 into rax, OR with VP_OK (0). All cmp immediates (0, 1, 2, 3, 4, 5, 9, 17, 18, 32, byte literals 0x09/0x0A/0x0D/0x20/0x23/0x2D/0x2E/0x30/0x39/0x3C/0x3D/0x3E/0x61/0x65/0x69/0x70/0x72/0x7E, status codes 0x6200..0x6205, magic 0x52505652) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm (acc*10 via (shl rN,3)+(shl rM,1)+add); no multiline let; no three-term addressing. Labels prefixed vp_pa_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        mov r12, rdx;                          // out
        xor r13, r13;                          // cursor = 0
        xor r14, r14;                          // parsed_op = 0 (= VP_OP_EQ default)
        xor r15, r15;                          // patch_flag = 0

        // ---- Validate output buffer -----------------------------------
        cmp r12, 0;
        je  vp_pa_oos;
        cmp rcx, 32;                           // VP_RECORD_BYTES
        jb  vp_pa_oos;

        // ---- Validate input length ------------------------------------
        cmp rbp, 18;                           // VP_MIN_SRC_LEN
        jb  vp_pa_sts;

        // ---- Zero-fill 32-B record via four u64 stores ----------------
        xor rax, rax;
        mov [r12 + 0], rax;
        mov [r12 + 8], rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;

        // ---- memcmp src[0..17] vs vp_prefix[0..17] --------------------
        lea r9, [rip + vp_prefix];             // r9 = &vp_prefix

      vp_pa_pfx:
        cmp r13, 17;                           // VP_PREFIX_LEN
        jae vp_pa_pfx_ok;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        xor rcx, rcx;
        mov_b rcx, [r9  + r13 * 1];
        cmp rax, rcx;
        jne vp_pa_bd;
        add r13, 1;
        jmp vp_pa_pfx;

      vp_pa_pfx_ok:
        // r13 = 17 (points at first byte after prefix).

        // ---- Skip WS+ between prefix and op (at least one) -----------
        cmp r13, rbp;
        jae vp_pa_bd;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;                         // SP
        je  vp_pa_ws1_adv;
        cmp rax, 0x09;                         // TAB
        je  vp_pa_ws1_adv;
        cmp rax, 0x0A;                         // LF
        je  vp_pa_ws1_adv;
        cmp rax, 0x0D;                         // CR
        je  vp_pa_ws1_adv;
        jmp vp_pa_bd;                          // required WS missing

      vp_pa_ws1_adv:
        add r13, 1;

      vp_pa_ws1:
        cmp r13, rbp;
        jae vp_pa_bd;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;
        je  vp_pa_ws1_more;
        cmp rax, 0x09;
        je  vp_pa_ws1_more;
        cmp rax, 0x0A;
        je  vp_pa_ws1_more;
        cmp rax, 0x0D;
        je  vp_pa_ws1_more;
        jmp vp_pa_op;

      vp_pa_ws1_more:
        add r13, 1;
        jmp vp_pa_ws1;

        // ---- Parse op token: greedy 2-char first, then 1-char --------
      vp_pa_op:
        // At least one byte available (vp_pa_ws1 ensured r13 < rbp).
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];            // first op byte

        // Is there a second byte available?
        mov rcx, r13;
        add rcx, 1;
        cmp rcx, rbp;
        jae vp_pa_op1;

        // Load second op byte candidate.
        xor r10, r10;
        mov_b r10, [rbx + rcx * 1];

        // -- '>' then '=' -> VP_OP_GE; else '>' alone -> VP_OP_GT.
        cmp rax, 0x3E;                         // '>'
        jne vp_pa_op_tryle;
        cmp r10, 0x3D;                         // '='
        jne vp_pa_op_gt1;
        mov r14, 1;                            // VP_OP_GE
        add r13, 2;
        jmp vp_pa_ws2;
      vp_pa_op_gt1:
        mov r14, 3;                            // VP_OP_GT
        add r13, 1;
        jmp vp_pa_ws2;

      vp_pa_op_tryle:
        // -- '<' then '=' -> VP_OP_LE; else '<' alone -> VP_OP_LT.
        cmp rax, 0x3C;                         // '<'
        jne vp_pa_op_trytilde;
        cmp r10, 0x3D;
        jne vp_pa_op_lt1;
        mov r14, 2;                            // VP_OP_LE
        add r13, 2;
        jmp vp_pa_ws2;
      vp_pa_op_lt1:
        mov r14, 4;                            // VP_OP_LT
        add r13, 1;
        jmp vp_pa_ws2;

      vp_pa_op_trytilde:
        // -- '~' then '=' -> VP_OP_TILDE; '~' alone is invalid.
        cmp rax, 0x7E;                         // '~'
        jne vp_pa_op_tryeq;
        cmp r10, 0x3D;
        jne vp_pa_bo;
        mov r14, 5;                            // VP_OP_TILDE
        add r13, 2;
        jmp vp_pa_ws2;

      vp_pa_op_tryeq:
        // -- '=' alone -> VP_OP_EQ; anything else -> BAD_OP.
        cmp rax, 0x3D;                         // '='
        jne vp_pa_bo;
        mov r14, 0;                            // VP_OP_EQ
        add r13, 1;
        jmp vp_pa_ws2;

      vp_pa_op1:
        // Only 1 byte available: '=' / '>' / '<' as single-char ops.
        cmp rax, 0x3D;                         // '='
        je  vp_pa_op1_eq;
        cmp rax, 0x3E;                         // '>'
        je  vp_pa_op1_gt;
        cmp rax, 0x3C;                         // '<'
        je  vp_pa_op1_lt;
        jmp vp_pa_bo;
      vp_pa_op1_eq:
        mov r14, 0;
        add r13, 1;
        jmp vp_pa_ws2;
      vp_pa_op1_gt:
        mov r14, 3;
        add r13, 1;
        jmp vp_pa_ws2;
      vp_pa_op1_lt:
        mov r14, 4;
        add r13, 1;
        jmp vp_pa_ws2;

        // ---- Skip WS+ between op and major (at least one) ------------
      vp_pa_ws2:
        cmp r13, rbp;
        jae vp_pa_bs;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;
        je  vp_pa_ws2_adv;
        cmp rax, 0x09;
        je  vp_pa_ws2_adv;
        cmp rax, 0x0A;
        je  vp_pa_ws2_adv;
        cmp rax, 0x0D;
        je  vp_pa_ws2_adv;
        jmp vp_pa_bs;                          // required WS missing

      vp_pa_ws2_adv:
        add r13, 1;

      vp_pa_ws2_more:
        cmp r13, rbp;
        jae vp_pa_bs;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;
        je  vp_pa_ws2_x;
        cmp rax, 0x09;
        je  vp_pa_ws2_x;
        cmp rax, 0x0A;
        je  vp_pa_ws2_x;
        cmp rax, 0x0D;
        je  vp_pa_ws2_x;
        jmp vp_pa_maj;

      vp_pa_ws2_x:
        add r13, 1;
        jmp vp_pa_ws2_more;

        // ---- Parse major digits into r8; store u32 at [out+8] --------
      vp_pa_maj:
        xor r8, r8;                            // major_acc = 0
        xor rcx, rcx;                          // digit_count = 0
      vp_pa_maj_loop:
        cmp r13, rbp;
        jae vp_pa_maj_done;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x30;                         // '0'
        jb  vp_pa_maj_done;
        cmp rax, 0x39;                         // '9'
        ja  vp_pa_maj_done;
        //   r8 = r8*10 + (rax - 48)
        mov r10, r8;
        shl r10, 3;                            // r8 * 8
        mov r11, r8;
        shl r11, 1;                            // r8 * 2
        add r10, r11;                          // r8 * 10
        sub rax, 48;
        add r10, rax;
        mov r8, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;                            // VP_DIGIT_CAP
        ja  vp_pa_bs;
        jmp vp_pa_maj_loop;

      vp_pa_maj_done:
        cmp rcx, 0;
        je  vp_pa_bs;
        mov_d [r12 + 8], r8;                   // VP_OFF_MAJOR

        // Expect '.'.
        cmp r13, rbp;
        jae vp_pa_bs;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x2E;                         // '.'
        jne vp_pa_bs;
        add r13, 1;

        // ---- Parse minor digits into r8; store u32 at [out+12] --------
      vp_pa_min:
        xor r8, r8;
        xor rcx, rcx;
      vp_pa_min_loop:
        cmp r13, rbp;
        jae vp_pa_min_done;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x30;
        jb  vp_pa_min_done;
        cmp rax, 0x39;
        ja  vp_pa_min_done;
        mov r10, r8;
        shl r10, 3;
        mov r11, r8;
        shl r11, 1;
        add r10, r11;
        sub rax, 48;
        add r10, rax;
        mov r8, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;
        ja  vp_pa_bs;
        jmp vp_pa_min_loop;

      vp_pa_min_done:
        cmp rcx, 0;
        je  vp_pa_bs;
        mov_d [r12 + 12], r8;                  // VP_OFF_MINOR

        // ---- Optional patch component -------------------------------
        cmp r13, rbp;
        jae vp_pa_emit;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x2E;                         // '.'
        jne vp_pa_emit;
        add r13, 1;

        // ---- Parse patch digits into r8; store u32 at [out+16] -------
      vp_pa_pat:
        xor r8, r8;
        xor rcx, rcx;
      vp_pa_pat_loop:
        cmp r13, rbp;
        jae vp_pa_pat_done;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x30;
        jb  vp_pa_pat_done;
        cmp rax, 0x39;
        ja  vp_pa_pat_done;
        mov r10, r8;
        shl r10, 3;
        mov r11, r8;
        shl r11, 1;
        add r10, r11;
        sub rax, 48;
        add r10, rax;
        mov r8, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;
        ja  vp_pa_bs;
        jmp vp_pa_pat_loop;

      vp_pa_pat_done:
        cmp rcx, 0;
        je  vp_pa_bs;
        mov_d [r12 + 16], r8;                  // VP_OFF_PATCH
        mov r15, 1;                            // VP_FLAG_PATCH_PRESENT

        // ---- Emit magic + op + flags --------------------------------
      vp_pa_emit:
        mov r9, 0x52505652;                    // VP_RECORD_MAGIC
        mov_d [r12 + 0], r9;                   // VP_OFF_MAGIC
        mov_b [r12 + 4], r14;                  // VP_OFF_OP
        mov_b [r12 + 5], r15;                  // VP_OFF_FLAGS

        // ---- Pack return: (bytes_consumed << 32) | VP_OK -------------
        mov rax, r13;
        shl rax, 32;                           // VP_OK = 0
        jmp vp_pa_epilogue;

      // ------------------------------------------------------------------
      // Error paths
      // ------------------------------------------------------------------
      vp_pa_bd:
        mov rax, r13;
        shl rax, 32;
        or  rax, 0x6200;                       // VP_ERR_BAD_DIRECTIVE
        jmp vp_pa_epilogue;

      vp_pa_bo:
        mov rax, r13;
        shl rax, 32;
        or  rax, 0x6201;                       // VP_ERR_BAD_OP
        jmp vp_pa_epilogue;

      vp_pa_bs:
        mov rax, r13;
        shl rax, 32;
        or  rax, 0x6202;                       // VP_ERR_BAD_SEMVER
        jmp vp_pa_epilogue;

      vp_pa_oos:
        xor rax, rax;
        or  rax, 0x6203;                       // VP_ERR_OUT_TOO_SMALL
        jmp vp_pa_epilogue;

      vp_pa_sts:
        xor rax, rax;
        or  rax, 0x6205;                       // VP_ERR_SRC_TOO_SHORT
        jmp vp_pa_epilogue;

      vp_pa_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _vp_check(record_ref, running_major, running_minor, running_patch)
  //                                               -> status
  //
  //   rdi = record_ref
  //   rsi = running_major
  //   rdx = running_minor
  //   rcx = running_patch
  //   rax = VP_OK (0) OR VP_ERR_VERSION_MISMATCH (0x6210) OR
  //         VP_ERR_BAD_RECORD (0x6204)
  //
  // Compare a parsed VersionPragma record against a caller-supplied
  // running-system (major, minor, patch) triple. Pure leaf (4-push;
  // no nested CALL).
  //
  // Flow:
  //   1. Validate record_ref != 0 and magic matches 0x52505652 LE.
  //      Fail -> VP_ERR_BAD_RECORD.
  //   2. Load op u8 at [+4]; req_major u32 at [+8]; req_minor u32 at
  //      [+12]; req_patch u32 at [+16].
  //   3. Three-way compare (running vs required) into rsi in {0, 1,
  //      2} (LO, EQ, HI).
  //   4. Dispatch on op:
  //        VP_OP_EQ    (0): rsi == 1 -> OK
  //        VP_OP_GE    (1): rsi >= 1 -> OK
  //        VP_OP_LE    (2): rsi <= 1 -> OK
  //        VP_OP_GT    (3): rsi == 2 -> OK
  //        VP_OP_LT    (4): rsi == 0 -> OK
  //        VP_OP_TILDE (5): running_major == req_major AND rsi >= 1 -> OK
  //      Any other op code OR fail arm -> VP_ERR_VERSION_MISMATCH.
  //
  // Labels prefixed vp_ck_.
  // ==========================================================================
  pub let _vp_check : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ref: u64) (running_major: u64) (running_minor: u64)
       (running_patch: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M6 (#2708): _vp_check compares a parsed VersionPragma record against a caller-supplied running-system (major, minor, patch) triple and returns VP_OK (0) on satisfied constraint OR VP_ERR_VERSION_MISMATCH (0x6210) on unsatisfied OR VP_ERR_BAD_RECORD (0x6204) on NULL record or magic mismatch. 4 callee-save pushes (rbx=record_ref, rbp=running_major, r12=running_minor, r13=running_patch); pure leaf (no nested CALL) so no sub-rsp pad is needed. Guards: record_ref != 0 (cmp rdi, 0; je vp_ck_br); load magic u32 at [rbx+0] via xor r8,r8; mov_d r8,[rbx+0]; cmp r8, 0x52505652; jne vp_ck_br. Load op u8 at [rbx+4] via xor r11, r11; mov_b r11, [rbx+4]; req_major u32 at [rbx+8] via xor r8, r8; mov_d r8, [rbx+8]; req_minor u32 at [rbx+12] via xor r9, r9; mov_d r9, [rbx+12]; req_patch u32 at [rbx+16] via xor r10, r10; mov_d r10, [rbx+16]. Three-way compare (running vs required) encoded as rsi in {0 LO, 1 EQ, 2 HI}: cmp rbp, r8 (majors); ja vp_ck_hi; jb vp_ck_lo; cmp r12, r9 (minors); ja vp_ck_hi; jb vp_ck_lo; cmp r13, r10 (patches); ja vp_ck_hi; jb vp_ck_lo; mov rsi, 1 (EQ); jmp vp_ck_dispatch. Dispatch on r11 (op code 0..5): cmp r11, 0 -> vp_ck_eq; cmp r11, 1 -> vp_ck_ge; cmp r11, 2 -> vp_ck_le; cmp r11, 3 -> vp_ck_gt; cmp r11, 4 -> vp_ck_lt; cmp r11, 5 -> vp_ck_tilde; else vp_ck_vm. Each arm: EQ (cmp rsi, 1; je ok), GE (cmp rsi, 1; jae ok), LE (cmp rsi, 1; jbe ok), GT (cmp rsi, 2; je ok), LT (cmp rsi, 0; je ok), TILDE (cmp rbp, r8; jne vm; cmp rsi, 1; jae ok). On OK: xor rax, rax (= VP_OK 0); jmp epilogue. On VM: mov rax, 0x6210 (VP_ERR_VERSION_MISMATCH); jmp epilogue. On BR: mov rax, 0x6204 (VP_ERR_BAD_RECORD); jmp epilogue. All immediates (0, 1, 2, 3, 4, 5, 0x6204, 0x6210, 0x52505652) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let; no three-term addressing. Labels prefixed vp_ck_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;

        mov rbx, rdi;                          // record_ref
        mov rbp, rsi;                          // running_major
        mov r12, rdx;                          // running_minor
        mov r13, rcx;                          // running_patch

        // ---- Validate record pointer + magic ------------------------
        cmp rbx, 0;
        je  vp_ck_br;
        xor r8, r8;
        mov_d r8, [rbx + 0];                   // magic u32
        mov r9, 0x52505652;                    // VP_RECORD_MAGIC
        cmp r8, r9;
        jne vp_ck_br;

        // ---- Load op + required triple -----------------------------
        xor r11, r11;
        mov_b r11, [rbx + 4];                  // op u8
        xor r8, r8;
        mov_d r8, [rbx + 8];                   // req_major u32
        xor r9, r9;
        mov_d r9, [rbx + 12];                  // req_minor u32
        xor r10, r10;
        mov_d r10, [rbx + 16];                 // req_patch u32

        // ---- Three-way compare: running vs required ---------------
        //   rsi = 0 (LO), 1 (EQ), 2 (HI)
        cmp rbp, r8;                           // majors
        ja  vp_ck_hi;
        jb  vp_ck_lo;
        cmp r12, r9;                           // minors
        ja  vp_ck_hi;
        jb  vp_ck_lo;
        cmp r13, r10;                          // patches
        ja  vp_ck_hi;
        jb  vp_ck_lo;
        mov rsi, 1;                            // VP_CMP_EQ
        jmp vp_ck_dispatch;

      vp_ck_lo:
        mov rsi, 0;                            // VP_CMP_LO
        jmp vp_ck_dispatch;

      vp_ck_hi:
        mov rsi, 2;                            // VP_CMP_HI

        // ---- Dispatch on op code ----------------------------------
      vp_ck_dispatch:
        cmp r11, 0;                            // VP_OP_EQ
        je  vp_ck_eq;
        cmp r11, 1;                            // VP_OP_GE
        je  vp_ck_ge;
        cmp r11, 2;                            // VP_OP_LE
        je  vp_ck_le;
        cmp r11, 3;                            // VP_OP_GT
        je  vp_ck_gt;
        cmp r11, 4;                            // VP_OP_LT
        je  vp_ck_lt;
        cmp r11, 5;                            // VP_OP_TILDE
        je  vp_ck_tilde;
        jmp vp_ck_vm;

      vp_ck_eq:
        cmp rsi, 1;
        je  vp_ck_ok;
        jmp vp_ck_vm;

      vp_ck_ge:
        cmp rsi, 1;
        jae vp_ck_ok;                          // 1 EQ or 2 HI
        jmp vp_ck_vm;

      vp_ck_le:
        cmp rsi, 1;
        jbe vp_ck_ok;                          // 0 LO or 1 EQ
        jmp vp_ck_vm;

      vp_ck_gt:
        cmp rsi, 2;
        je  vp_ck_ok;
        jmp vp_ck_vm;

      vp_ck_lt:
        cmp rsi, 0;
        je  vp_ck_ok;
        jmp vp_ck_vm;

      vp_ck_tilde:
        // Same major AND running >= required.
        cmp rbp, r8;
        jne vp_ck_vm;
        cmp rsi, 1;
        jae vp_ck_ok;
        jmp vp_ck_vm;

      vp_ck_ok:
        xor rax, rax;                          // VP_OK
        jmp vp_ck_epilogue;

      vp_ck_vm:
        mov rax, 0x6210;                       // VP_ERR_VERSION_MISMATCH
        jmp vp_ck_epilogue;

      vp_ck_br:
        mov rax, 0x6204;                       // VP_ERR_BAD_RECORD

      vp_ck_epilogue:
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
