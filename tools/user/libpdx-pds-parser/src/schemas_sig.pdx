// src/schemas_sig.pdx -- libpdx-pds-parser.R222.M1 (paideia-os#2658)
//
// SchemasSig: parser-tier body parser for the `schemas_sig { ... -> ... }`
// cmd-functor type signature. R222.M1 of the cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222 is the cmd-functor umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R222 -- Command-
// module functor surface + registry client (SH-D5)"). A semantic-shell
// command is declared as a paideia-as functor:
//
//     module Find(Schemas : SchemasSig)(...) : CommandSig = struct ... end
//
// The `SchemasSig` signature is the first functor parameter: it names
// the input + output record shapes the command may consume and produce.
// R222.M1 (THIS module) is the parser-tier primitive that turns the raw
// body bytes of a `schemas_sig { ... -> ... }` block into two separate
// field-descriptor arrays -- one for the input shape, one for the
// output shape -- that later R222 milestones feed into the schema-
// registry fingerprinting pipeline.
//
// The parser is user-space (satellite library) because the shell runs
// in user space and because the field-descriptor arrays are produced
// once at functor-elaboration time and then handed to the kernel-side
// schema registry via a flat byte-blob syscall (M2+). No kernel-side
// state lives here.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     SchemasSigBody := WS* FieldList? WS* "->" WS* FieldList WS*
//                     | WS* "->" WS* FieldList WS*       (empty input)
//     FieldList      := Field (WS* "," WS* Field)*
//     Field          := identifier WS* ":" WS* type_name
//     identifier     := [A-Za-z_] [A-Za-z0-9_]*          (len 1..13)
//     type_name      := one of  u64 | i64 | str | hex | hash32 | tsc
//                            |  path | pid
//     WS             := 0x20 | 0x09 | 0x0A | 0x0D
//
// The entry point consumes the body BETWEEN the `{` and the `}` -- the
// braces themselves are not part of the input, nor is the leading
// `schemas_sig` keyword. The caller (a later R222 milestone's lexer /
// AST pass) locates the braces and hands the inner bytes to this
// module.
//
// Three forms are legal:
//
//   1. `path: path -> name: str, size: u64`  (both non-empty)
//   2. `-> status: u64`                      (empty input, non-empty output)
//   3. `path: path -> ... error ...`         (input non-empty is fine too)
//
// The output list MUST be non-empty: a command that produces no record
// output declares `-> status: u64` or similar. (R222.M2 CommandSig may
// relax this when `output_schema = None` is wired through.)
//
// =============================================================================
// TYPE SET (M1 SUBSET)
// =============================================================================
//
// The eight type names map 1:1 to the schema_fmt R129.M4 type codes
// where they overlap, with two new M1-additions (`path`, `pid`) for
// cmd-functor-only shapes:
//
//     u64     -> SS_TYPE_U64    = 1   (shared with SF_TYPE_U64)
//     i64     -> SS_TYPE_I64    = 2   (shared with SF_TYPE_I64)
//     str     -> SS_TYPE_STR    = 3   (shared with SF_TYPE_STR)
//     hex     -> SS_TYPE_HEX    = 4   (shared with SF_TYPE_HEX)
//     hash32  -> SS_TYPE_HASH32 = 5   (shared with SF_TYPE_HASH32)
//     tsc     -> SS_TYPE_TSC    = 6   (shared with SF_TYPE_TSC)
//     path    -> SS_TYPE_PATH   = 8   (NEW; 7 reserved for SF_TYPE_IMAGE)
//     pid     -> SS_TYPE_PID    = 9   (NEW; 8-byte pid)
//
// Type code 7 is DELIBERATELY SKIPPED to stay aligned with R129.M4's
// reserved SF_TYPE_IMAGE slot (schema_fmt.pdx section 1). A future
// R222.M? landing that adds SS_TYPE_IMAGE will reuse code 7 and the
// two type systems stay interchangeable at the dispatch byte.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ss_parse_body(bytes_ptr, bytes_len,
//                  out_in_schema_ptr,  out_in_cap,
//                  out_out_schema_ptr, out_out_cap)   -> errno
//
//     Parses the body between `{` and `}` -- NOT including the braces.
//     Writes the input FieldList into `out_in_schema_ptr` and the
//     output FieldList into `out_out_schema_ptr`, each as a packed
//     array of SS_FIELD_DESC_BYTES-stride entries terminated by an
//     SS_TYPE_END (field_type == 0) sentinel. Returns one of:
//
//        SS_OK                 = 0
//        SS_ERR_SYNTAX         = 0x2A00  bad grammar
//        SS_ERR_UNKNOWN_TYPE   = 0x2A01  type_name not in the M1 set
//        SS_ERR_TOO_MANY_FIELDS= 0x2A02  per-side field count exceeds
//                                        SS_MAX_FIELDS (32) OR the
//                                        caller-provided capacity is
//                                        too small to hold the schema
//                                        + its END terminator.
//
//   _ss_match_record(sig_schema_ptr, sig_schema_len, record_ptr) -> errno
//
//     M2+ runtime typecheck hook. At R222.M1, this stub returns
//     SS_UNIMPLEMENTED (= 0x2A03) unconditionally. The signature is
//     fixed at M1 so M2+ landings can wire in the full match without
//     a public-API break.
//
// Register maps (SysV):
//
//   _ss_parse_body(rdi, rsi, rdx, rcx, r8, r9) -> rax
//       rdi = bytes_ptr
//       rsi = bytes_len
//       rdx = out_in_schema_ptr
//       rcx = out_in_cap
//       r8  = out_out_schema_ptr
//       r9  = out_out_cap
//       rax = errno
//
//   _ss_match_record(rdi, rsi, rdx) -> rax
//       rdi = sig_schema_ptr
//       rsi = sig_schema_len
//       rdx = record_ptr
//       rax = SS_UNIMPLEMENTED at M1
//
// =============================================================================
// FIELD DESCRIPTOR LAYOUT  --  16 BYTES PER FIELD
// =============================================================================
//
// Stride 16 is a power of two so descriptor addressing uses `shl rN, 4`
// -- no 2-op `imul r, imm` (per feedback_pdx_encoder_pitfalls).
// Width-16 is tight enough that a 32-field schema plus END terminator
// fits in SS_SCHEMA_SIDE_MIN = (32+1) * 16 = 528 bytes. Shells seat
// one scratch buffer per side (either on stack or in the elaborator's
// per-session arena).
//
//   [+0]    field_type   (u8)   SS_TYPE_END (0) or SS_TYPE_* (1..9)
//   [+1]    name_len     (u8)   0 .. SS_NAME_MAX (= 13)
//   [+2..+15] name_inline (14 B) ASCII identifier, zero-padded.
//                                 SS_TYPE_END entries carry zeros here.
//
// Name is inline, not pointer+len, so the schema can be hashed or
// serialized without a dereference walk. 13 bytes of name is enough
// for every cmd-functor field name observed in the semantic-shell
// language-plan examples (`name`, `size`, `path`, `inode`, `mtime`,
// `tag`, `hash`, `status`, `ticks`, ...).
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R131.M1 (UTF-8)  --  the caller is expected to have already run
//     the input bytes through R221.M1's _u8n_decode_and_normalize so
//     this module may assume (a) valid UTF-8, (b) NFC-form. Because
//     the grammar accepts only ASCII identifiers and ASCII punctuation
//     (`{`, `}`, `,`, `:`, `->`), the parser only ever inspects the
//     ASCII subset of its input. Non-ASCII bytes inside an identifier
//     will fall through to SS_ERR_SYNTAX via the ident-cont byte-class
//     check (none of 0x80..0xFF is in [A-Za-z0-9_]).
//
//   R129.M4 (schema_fmt)  --  the type-code numbering is deliberately
//     shared across the two modules so a cmd-functor's output_schema
//     can be rendered by _schema_fmt_render after a one-pass copy of
//     the field_type bytes. The 14-byte inline name needs a pass-
//     through widen into schema_fmt's 30-byte name slot (M2+ bridge).
//
//   R222.M2 (CommandSig)  --  consumes two SchemasSig arrays per
//     command, hashes them via schema-registry.md fingerprints, and
//     seats them into the elaborator's per-command record. The hash
//     input is the full 16-byte-per-field byte sequence up to (but
//     not including) the END terminator -- a byte-identical hash
//     across host and kernel-side consumers.
//
//   R222.M3 (REPL dispatch)  --  calls _ss_match_record at each
//     command invocation to validate incoming records against the
//     signature. M3 therefore blocks on M2+ wiring the full match.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- field-stride is `shl rN, 4` (* 16).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `SchemasSig` matches `schemas_sig.pdx`.
//   - Labels prefixed `sch_sig_` (never `loop`/`if`/`let`/`fn`/`ret`
//     -- reserved). `ss_` is NOT used because `ss_` is already a
//     prefix fragment in other kernel modules (lit_ss_, xhci_ss_,
//     dpam_ss_, mb_ss_, etc.) and the public API names already own
//     the `_ss_*` entry-point namespace.
//   - All `cmp reg, imm` immediates <= 0x2A03 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging.
//   - All byte loads via `mov_b` (zero-extends into the full qword);
//     byte stores via `mov_b [dst + idx], reg` (register-indexed byte
//     store, same shape as libpdx-audit's audit_file_sink and
//     utf8_nfc.pdx's fast-path copy).
//   - `_sch_sig_classify_type` and `_sch_sig_skip_ws` are pure leaves:
//     no callee-save push, no stack frame, no nested CALL.
//   - `_ss_parse_body` has a 6-push + 24-byte-scratch frame (rsp%16==0
//     at every nested CALL; see per-function stack notes below).
//   - `_ss_match_record` at M1 is a one-mov-one-ret leaf: no frame.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R222.M2  CommandSig body parser (same satellite library; consumes
//            the two field-desc arrays this module produces).
//   R222.M3  REPL dispatch wires _ss_match_record into the per-record
//            consumer. M3 replaces this module's stub with a full
//            field-by-field type-code compare over the record stream.
//   R222.M4  ArgSpec + FlagSpec parsers (same satellite; shares the
//            type set via SS_TYPE_* mirror constants in those modules).
//   R222.M8  Serialization of SchemasSig to the queryable form the
//            `describe <cmd>` builtin consumes.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella, same library), paideia-os#2658
// (THIS ticket, R222.M1). Substrate: paideia-os#2607 (R129.M4
// schema_fmt type codes), paideia-os#2651 (R221.M1 UTF-8/NFC parser-
// tier wrapper). Design doc: design/shell/cmd-functor-schemas-sig.md.

module SchemasSig = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Small-value range 0x2A00..0x2AFF, reserved for the R222 cmd-functor
  // parser band. Disjoint from the R221 parser-tier band (0x2700..),
  // the R129.M4 schema_fmt band (0x1900..), the R135.M5 wit_bridge
  // band (0x1C00..), and the user-space 0xFFFFExxx error-slice bands.
  //
  // Grep confirmation at R222.M1 landing time:
  //   grep -rE '0x2A0[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this module.

  pub let SS_OK                  : u64 = 0
  pub let SS_ERR_SYNTAX          : u64 = 0x2A00
  pub let SS_ERR_UNKNOWN_TYPE    : u64 = 0x2A01
  pub let SS_ERR_TOO_MANY_FIELDS : u64 = 0x2A02
  pub let SS_UNIMPLEMENTED       : u64 = 0x2A03

  // ==========================================================================
  // SECTION 2 -- TYPE CODES (one byte, written to field_desc[+0])
  // ==========================================================================
  //
  // Codes 0..6 mirror R129.M4 SF_TYPE_* exactly. Code 7 is deliberately
  // skipped to stay aligned with SF_TYPE_IMAGE's reserved slot. Codes
  // 8..9 are the cmd-functor-only extensions. SS_UNKNOWN_TYPE is a
  // sentinel returned by _sch_sig_classify_type; it is NOT a valid
  // field_type byte.

  pub let SS_TYPE_END          : u64 = 0
  pub let SS_TYPE_U64          : u64 = 1
  pub let SS_TYPE_I64          : u64 = 2
  pub let SS_TYPE_STR          : u64 = 3
  pub let SS_TYPE_HEX          : u64 = 4
  pub let SS_TYPE_HASH32       : u64 = 5
  pub let SS_TYPE_TSC          : u64 = 6
  pub let SS_TYPE_PATH         : u64 = 8
  pub let SS_TYPE_PID          : u64 = 9
  pub let SS_UNKNOWN_TYPE      : u64 = 0xFF

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let SS_FIELD_DESC_BYTES  : u64 = 16
  pub let SS_NAME_MAX          : u64 = 13
  pub let SS_MAX_FIELDS        : u64 = 32
  pub let SS_SCHEMA_SIDE_MIN   : u64 = 528   // (SS_MAX_FIELDS + 1) * 16

  // Field-descriptor offsets (bytes, from desc base).
  pub let SS_OFF_TYPE          : u64 = 0
  pub let SS_OFF_NAME_LEN      : u64 = 1
  pub let SS_OFF_NAME_INLINE   : u64 = 2

  // ==========================================================================
  // _sch_sig_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a space-
  // class byte, OR cursor == bytes_len (end-of-input is a valid stop).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sch_sig_sw_.
  // ==========================================================================
  pub let _sch_sig_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M1 (#2658): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. The space-class check is four cmp-imm32 branches rather than a bitmap because the set is small and the branch predictor can speculate the common no-ws case. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sch_sig_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      sch_sig_sw_loop:
        cmp rax, rsi;
        jae sch_sig_sw_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  sch_sig_sw_advance;
        cmp rcx, 0x09;
        je  sch_sig_sw_advance;
        cmp rcx, 0x0A;
        je  sch_sig_sw_advance;
        cmp rcx, 0x0D;
        je  sch_sig_sw_advance;
        jmp sch_sig_sw_done;

      sch_sig_sw_advance:
        add rax, 1;
        jmp sch_sig_sw_loop;

      sch_sig_sw_done:
        ret;
      }
    }

  // ==========================================================================
  // _sch_sig_classify_type(ident_ptr, ident_len) -> type_code
  //
  //   rdi = ident_ptr
  //   rsi = ident_len
  //   rax = SS_TYPE_U64 (1), SS_TYPE_I64 (2), SS_TYPE_STR (3),
  //         SS_TYPE_HEX (4), SS_TYPE_HASH32 (5), SS_TYPE_TSC (6),
  //         SS_TYPE_PATH (8), SS_TYPE_PID (9), or SS_UNKNOWN_TYPE (0xFF).
  //
  // Length-switched dispatch -- branch on ident_len first, then compare
  // the exact literal bytes. Length-3 covers u64/i64/str/hex/tsc/pid
  // (six 3-letter types). Length-4 covers `path`. Length-6 covers
  // `hash32`. Any other length is unknown.
  //
  // Shape parallel to wit_bridge R135.M5's `_wb_classify_type`. Pure
  // leaf -- no callee-save push, no stack frame, no nested CALL. Labels
  // prefixed sch_sig_ct_.
  // ==========================================================================
  pub let _sch_sig_classify_type : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M1 (#2658): classify a candidate type_name ident against the M1-known type set. Length-switched dispatch: 3 -> six 3-letter types (u64/i64/str/hex/tsc/pid); 4 -> path; 6 -> hash32. Each length arm does a first-byte branch (`xor rax, rax; mov_b rax, [rdi+0]; cmp rax, <lit>; je ...`) then confirms the trailing bytes with further mov_b+cmp pairs. Returns SS_UNKNOWN_TYPE (0xFF) on any mismatch. Pure leaf -- zero pushes, no stack frame, no nested CALL. All ASCII literals (0x62..0x75) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sch_sig_ct_.",
      block: {
        cmp rsi, 3;
        je  sch_sig_ct_len3;
        cmp rsi, 4;
        je  sch_sig_ct_len4;
        cmp rsi, 6;
        je  sch_sig_ct_len6;
        jmp sch_sig_ct_unknown;

        // ---- length 3: u64 / i64 / str / hex / tsc / pid ----
      sch_sig_ct_len3:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                         // 'u'
        je  sch_sig_ct_u64_try;
        cmp rax, 0x69;                         // 'i'
        je  sch_sig_ct_i64_try;
        cmp rax, 0x73;                         // 's'
        je  sch_sig_ct_str_try;
        cmp rax, 0x68;                         // 'h'
        je  sch_sig_ct_hex_try;
        cmp rax, 0x74;                         // 't'
        je  sch_sig_ct_tsc_try;
        cmp rax, 0x70;                         // 'p'
        je  sch_sig_ct_pid_try;
        jmp sch_sig_ct_unknown;

      sch_sig_ct_u64_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne sch_sig_ct_unknown;
        mov rax, 1;                            // SS_TYPE_U64
        ret;

      sch_sig_ct_i64_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne sch_sig_ct_unknown;
        mov rax, 2;                            // SS_TYPE_I64
        ret;

      sch_sig_ct_str_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x74;                         // 't'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x72;                         // 'r'
        jne sch_sig_ct_unknown;
        mov rax, 3;                            // SS_TYPE_STR
        ret;

      sch_sig_ct_hex_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x65;                         // 'e'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x78;                         // 'x'
        jne sch_sig_ct_unknown;
        mov rax, 4;                            // SS_TYPE_HEX
        ret;

      sch_sig_ct_tsc_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x73;                         // 's'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x63;                         // 'c'
        jne sch_sig_ct_unknown;
        mov rax, 6;                            // SS_TYPE_TSC
        ret;

      sch_sig_ct_pid_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x69;                         // 'i'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x64;                         // 'd'
        jne sch_sig_ct_unknown;
        mov rax, 9;                            // SS_TYPE_PID
        ret;

        // ---- length 4: path ----
      sch_sig_ct_len4:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x70;                         // 'p'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x74;                         // 't'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne sch_sig_ct_unknown;
        mov rax, 8;                            // SS_TYPE_PATH
        ret;

        // ---- length 6: hash32 ----
      sch_sig_ct_len6:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x68;                         // 'h'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x73;                         // 's'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0x33;                         // '3'
        jne sch_sig_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 5];
        cmp rax, 0x32;                         // '2'
        jne sch_sig_ct_unknown;
        mov rax, 5;                            // SS_TYPE_HASH32
        ret;

      sch_sig_ct_unknown:
        mov rax, 0xFF;                         // SS_UNKNOWN_TYPE
        ret;
      }
    }

  // ==========================================================================
  // _ss_parse_body(bytes_ptr, bytes_len,
  //                out_in_schema_ptr,  out_in_cap,
  //                out_out_schema_ptr, out_out_cap)   -> errno
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_in_schema_ptr
  //   rcx = out_in_cap
  //   r8  = out_out_schema_ptr
  //   r9  = out_out_cap
  //   rax = errno (SS_OK or SS_ERR_*)
  //
  // Walks the body as a tiny state machine:
  //
  //   INPUT_PHASE (fields written to out_in_schema_ptr):
  //     skip_ws
  //     if peek is "->" -> emit END to in_schema, jump to OUTPUT_PHASE
  //     parse_field into in_schema
  //     loop:
  //       skip_ws
  //       if peek is ",": advance, parse next field
  //       elif peek is "->": advance 2, emit END, jump to OUTPUT_PHASE
  //       else: SS_ERR_SYNTAX
  //
  //   OUTPUT_PHASE (fields written to out_out_schema_ptr):
  //     skip_ws
  //     parse_field into out_schema   (output list must be non-empty)
  //     loop:
  //       skip_ws
  //       if cursor == len: emit END, SS_OK
  //       if peek is ",": advance, parse next field
  //       else: SS_ERR_SYNTAX
  //
  // Each `parse_field` sub-walk:
  //   - skip_ws
  //   - read ident (byte class [A-Za-z_] [A-Za-z0-9_]*)
  //       ident_len > SS_NAME_MAX -> SS_ERR_SYNTAX
  //       ident_len == 0          -> SS_ERR_SYNTAX
  //   - skip_ws
  //   - require ':'  (else SS_ERR_SYNTAX)
  //   - skip_ws
  //   - read type_name (same ident class)
  //       classify -> SS_UNKNOWN_TYPE  -> SS_ERR_UNKNOWN_TYPE
  //   - require cap_remaining >= 2 * SS_FIELD_DESC_BYTES
  //         (one for this field, one for the END terminator); otherwise
  //         SS_ERR_TOO_MANY_FIELDS.
  //   - require fields_in_current < SS_MAX_FIELDS;
  //         otherwise SS_ERR_TOO_MANY_FIELDS.
  //   - write 16-byte descriptor
  //   - advance current_out_ptr += 16, current_out_cap -= 16, counter++
  //
  // Register map (6 callee-save pushes + 24-byte scratch slot ->
  // rsp%16==0 steady; entry %16==8, +48 pushes = %16==8, +24 scratch
  // -> %16==0; nested CALL alignment satisfied for both _sch_sig_skip_ws
  // and _sch_sig_classify_type):
  //   rbx = bytes_ptr
  //   rbp = bytes_len
  //   r12 = cursor
  //   r13 = current_out_ptr (switches at phase boundary)
  //   r14 = current_out_cap_remaining
  //   r15 = fields_in_current
  //   [rsp +  0] = out_out_schema_ptr   (saved for phase 2)
  //   [rsp +  8] = out_out_cap          (saved for phase 2)
  //   [rsp + 16] = alignment pad (unused)
  //
  // Labels prefixed sch_sig_pb_.
  // ==========================================================================
  pub let _ss_parse_body : (u64, u64, u64, u64, u64, u64) -> u64
                            !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_in_schema_ptr: u64) (out_in_cap: u64)
       (out_out_schema_ptr: u64) (out_out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M1 (#2658): parse the body of a `schemas_sig { ... -> ... }` block. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=current_out_ptr, r14=current_out_cap, r15=fields_in_current) + `sub rsp, 24` for the two phase-2 arg slots plus alignment pad -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +24 scratch -> %16==0). Nested CALLs (_sch_sig_skip_ws leaf, _sch_sig_classify_type leaf) therefore need no additional per-call pad. State machine: INPUT phase writes to r13/r14 (first-arg out_schema); OUTPUT phase swaps r13/r14 to the stack-saved out_out_schema. Each parse_field sub-walk: skip_ws; ident scan (byte-class [A-Za-z_] [A-Za-z0-9_]*; max SS_NAME_MAX = 13 chars); skip_ws + require ':'; skip_ws; type_name scan; classify via _sch_sig_classify_type; capacity + field-count guards; emit 16-byte descriptor (field_type u8, name_len u8, name bytes + zero-pad). Field-stride multiply uses `shl rax, 4` (* 16) -- never `imul r, imm`. All error paths jump to a shared epilogue that unwinds the 24-byte scratch and 6 callee-save pops. All `cmp` immediates (ASCII literals 0x20..0x7F, type codes 0..9, status codes 0x2A00..0x2A03, max-fields 32, name-max 13) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sch_sig_pb_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Spill phase-2 args to the stack scratch before we rebind the
        // ARG registers for nested calls. Zero the phase-tag slot so
        // the first parse_field pass defaults to the INPUT path.
        mov [rsp + 0], r8;                     // out_out_schema_ptr
        mov [rsp + 8], r9;                     // out_out_cap
        xor rax, rax;
        mov [rsp + 16], rax;                   // phase_tag = 0 (INPUT)

        // Load state regs.
        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        xor r12, r12;                          // cursor = 0
        mov r13, rdx;                          // current_out_ptr = in_schema
        mov r14, rcx;                          // current_out_cap  = in_cap
        xor r15, r15;                          // fields_in_current = 0

        // Capacity guard for phase 1: need at least one END terminator
        // in out_in_schema (empty input is legal, trailing END required).
        cmp r14, 16;
        jb  sch_sig_pb_too_many;

        // ------------------------------------------------------------
        // INPUT_PHASE entry: skip_ws, check for immediate "->".
        // ------------------------------------------------------------
      sch_sig_pb_input_entry:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // Check for "->" (empty input case).
        mov rax, r12;
        add rax, 1;
        cmp rax, rbp;                          // need two bytes available
        jae sch_sig_pb_input_first_field;      // not enough bytes: must
                                               // be a first-field path
                                               // (or trailing-syntax
                                               // error caught below)

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2D;                         // '-'
        jne sch_sig_pb_input_first_field;
        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x3E;                         // '>'
        jne sch_sig_pb_input_first_field;
        // Match "->" at cursor; consume it and jump to OUTPUT phase.
        add r12, 2;
        jmp sch_sig_pb_phase_switch;

        // ------------------------------------------------------------
        // Parse the first input field. Falls through to the common
        // "after a field" tail which looks for "," or "->".
        // ------------------------------------------------------------
      sch_sig_pb_input_first_field:
        jmp sch_sig_pb_parse_field;

      sch_sig_pb_input_after_field:
        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // End-of-input inside the input phase without seeing "->"
        // is a syntax error.
        cmp r12, rbp;
        jae sch_sig_pb_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];

        // ',' continues the input list.
        cmp rax, 0x2C;
        je  sch_sig_pb_input_comma;

        // "->" terminates the input list.
        cmp rax, 0x2D;
        jne sch_sig_pb_syntax;
        mov rcx, r12;
        add rcx, 1;
        cmp rcx, rbp;
        jae sch_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x3E;
        jne sch_sig_pb_syntax;
        add r12, 2;
        jmp sch_sig_pb_phase_switch;

      sch_sig_pb_input_comma:
        add r12, 1;
        jmp sch_sig_pb_parse_field;

        // ------------------------------------------------------------
        // Phase switch: emit END to current (input) schema, swap
        // r13/r14/r15 to the output-schema state.
        // ------------------------------------------------------------
      sch_sig_pb_phase_switch:
        // Capacity for input END already reserved at entry; write it.
        mov rax, 0;
        mov_b [r13 + 0], rax;                  // type = SS_TYPE_END
        mov_b [r13 + 1], rax;                  // name_len = 0

        // Rebind r13/r14 to the output-schema buffer.
        mov r13, [rsp + 0];                    // out_out_schema_ptr
        mov r14, [rsp + 8];                    // out_out_cap
        xor r15, r15;                          // fields_in_current = 0

        // Output side needs capacity for at least ONE real field +
        // ONE END terminator (output list must be non-empty).
        cmp r14, 32;
        jb  sch_sig_pb_too_many;

        // ------------------------------------------------------------
        // OUTPUT_PHASE: at least one field required.
        // ------------------------------------------------------------
      sch_sig_pb_output_first_field:
        jmp sch_sig_pb_parse_field_out;

      sch_sig_pb_output_after_field:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // End-of-input in the output phase is a clean termination.
        cmp r12, rbp;
        jae sch_sig_pb_output_done;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2C;
        jne sch_sig_pb_syntax;
        add r12, 1;
        jmp sch_sig_pb_parse_field_out;

      sch_sig_pb_output_done:
        // Write END to out_out_schema; emit SS_OK.
        mov rax, 0;
        mov_b [r13 + 0], rax;
        mov_b [r13 + 1], rax;
        xor rax, rax;                          // SS_OK = 0
        jmp sch_sig_pb_epilogue;

        // ------------------------------------------------------------
        // parse_field: shared sub-walk used by both phases.
        //
        // Two entries (sch_sig_pb_parse_field for input,
        // sch_sig_pb_parse_field_out for output) to avoid saving a
        // "which phase?" flag -- the only difference is the return
        // label at the end.
        // ------------------------------------------------------------
      sch_sig_pb_parse_field:
        // Field-count guard.
        cmp r15, 32;                           // SS_MAX_FIELDS
        jae sch_sig_pb_too_many;

        // Capacity guard: need this field + END terminator (2 * 16 = 32).
        cmp r14, 32;
        jb  sch_sig_pb_too_many;

        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // Field body is parsed by inline logic that writes to r13.
        // On entry, [rsp + 16] carries the phase tag (0 = INPUT,
        // 1 = OUTPUT); the INPUT entry falls through with the slot
        // still 0 (prologue initialised, or cleared at the previous
        // field completion), and the OUTPUT entry writes 1 before
        // reaching here.
        jmp sch_sig_pb_body_core;

      sch_sig_pb_parse_field_out:
        cmp r15, 32;
        jae sch_sig_pb_too_many;
        cmp r14, 32;
        jb  sch_sig_pb_too_many;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // Spill a tag onto the stack so sch_sig_pb_body_core knows
        // which continuation to use.
        mov rax, 1;
        mov [rsp + 16], rax;
        jmp sch_sig_pb_body_core;

        // ------------------------------------------------------------
        // Field body: ident ':' type_name.
        // Uses rbp (bytes_len) for the bound; must not clobber rbp.
        // Nested calls may clobber rdi/rsi/rdx -- we reload from
        // rbx/rbp/r12 each time.
        // ------------------------------------------------------------
      sch_sig_pb_body_core:

        // ---- Ident scan ----
        // The first byte must be in [A-Za-z_]. Subsequent bytes may
        // additionally be [0-9].
        cmp r12, rbp;
        jae sch_sig_pb_syntax;

        mov r10, r12;                          // ident_start = cursor
        xor rax, rax;
        mov_b rax, [rbx + r12];
        // '_' = 0x5F
        cmp rax, 0x5F;
        je  sch_sig_pb_ident_cont;
        // A..Z
        cmp rax, 0x41;
        jb  sch_sig_pb_syntax;
        cmp rax, 0x5A;
        jbe sch_sig_pb_ident_cont;
        // a..z
        cmp rax, 0x61;
        jb  sch_sig_pb_syntax;
        cmp rax, 0x7A;
        ja  sch_sig_pb_syntax;

      sch_sig_pb_ident_cont:
        add r12, 1;

      sch_sig_pb_ident_loop:
        cmp r12, rbp;
        jae sch_sig_pb_ident_done;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        // '_'
        cmp rax, 0x5F;
        je  sch_sig_pb_ident_step;
        // 0..9
        cmp rax, 0x30;
        jb  sch_sig_pb_ident_check_alpha;
        cmp rax, 0x39;
        jbe sch_sig_pb_ident_step;
      sch_sig_pb_ident_check_alpha:
        // A..Z
        cmp rax, 0x41;
        jb  sch_sig_pb_ident_done;
        cmp rax, 0x5A;
        jbe sch_sig_pb_ident_step;
        // a..z
        cmp rax, 0x61;
        jb  sch_sig_pb_ident_done;
        cmp rax, 0x7A;
        ja  sch_sig_pb_ident_done;
      sch_sig_pb_ident_step:
        add r12, 1;
        jmp sch_sig_pb_ident_loop;

      sch_sig_pb_ident_done:
        // ident_len = cursor - ident_start
        mov r11, r12;
        sub r11, r10;
        cmp r11, 0;
        je  sch_sig_pb_syntax;
        cmp r11, 13;                           // SS_NAME_MAX
        ja  sch_sig_pb_syntax;

        // Stash ident_start and ident_len for the descriptor write.
        // r10 = ident_start, r11 = ident_len already set.

        // ---- Expect ':' ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae sch_sig_pb_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne sch_sig_pb_syntax;
        add r12, 1;

        // ---- skip_ws before type_name ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sch_sig_skip_ws;
        mov r12, rax;

        // ---- Type_name scan ----
        cmp r12, rbp;
        jae sch_sig_pb_syntax;
        mov r8, r12;                           // type_start
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  sch_sig_pb_type_cont;
        cmp rax, 0x41;
        jb  sch_sig_pb_syntax;
        cmp rax, 0x5A;
        jbe sch_sig_pb_type_cont;
        cmp rax, 0x61;
        jb  sch_sig_pb_syntax;
        cmp rax, 0x7A;
        ja  sch_sig_pb_syntax;

      sch_sig_pb_type_cont:
        add r12, 1;

      sch_sig_pb_type_loop:
        cmp r12, rbp;
        jae sch_sig_pb_type_done;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  sch_sig_pb_type_step;
        cmp rax, 0x30;
        jb  sch_sig_pb_type_check_alpha;
        cmp rax, 0x39;
        jbe sch_sig_pb_type_step;
      sch_sig_pb_type_check_alpha:
        cmp rax, 0x41;
        jb  sch_sig_pb_type_done;
        cmp rax, 0x5A;
        jbe sch_sig_pb_type_step;
        cmp rax, 0x61;
        jb  sch_sig_pb_type_done;
        cmp rax, 0x7A;
        ja  sch_sig_pb_type_done;
      sch_sig_pb_type_step:
        add r12, 1;
        jmp sch_sig_pb_type_loop;

      sch_sig_pb_type_done:
        // type_len = cursor - type_start
        mov r9, r12;
        sub r9, r8;
        cmp r9, 0;
        je  sch_sig_pb_syntax;

        // ---- Classify ----
        // _sch_sig_classify_type(bytes_ptr + type_start, type_len)
        mov rdi, rbx;
        add rdi, r8;
        mov rsi, r9;
        call _sch_sig_classify_type;
        cmp rax, 0xFF;                         // SS_UNKNOWN_TYPE
        je  sch_sig_pb_bad_type;

        // rax now holds the type code (1..9, with 7 skipped).

        // ---- Write descriptor ----
        // [r13 +  0]  = type_code  (u8)
        // [r13 +  1]  = ident_len  (u8)      (ident_len <= 13)
        // [r13 +  2..] = ident bytes (zero-padded to byte 15)
        mov_b [r13 + 0], rax;                  // type_code
        mov rcx, r11;                          // ident_len
        mov_b [r13 + 1], rcx;

        // Copy ident bytes.
        xor r9, r9;                            // i = 0
      sch_sig_pb_name_copy:
        cmp r9, r11;
        jae sch_sig_pb_name_pad;
        // src_addr = rbx + r10 + i
        mov rdi, rbx;
        add rdi, r10;
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        // dst_addr = r13 + 2 + i
        mov rsi, r13;
        add rsi, 2;
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp sch_sig_pb_name_copy;

      sch_sig_pb_name_pad:
        // Zero-pad bytes [2 + ident_len .. 16).
        mov r9, r11;
        add r9, 2;                             // start_off = 2 + ident_len
      sch_sig_pb_name_pad_loop:
        cmp r9, 16;
        jae sch_sig_pb_desc_done;
        mov rsi, r13;
        add rsi, r9;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp sch_sig_pb_name_pad_loop;

      sch_sig_pb_desc_done:
        // Advance output cursor + accounting.
        add r13, 16;
        sub r14, 16;
        add r15, 1;

        // Return to the right phase's "after a field" label.
        mov rax, [rsp + 16];
        // Clear the tag slot so the next input-phase field defaults
        // to 0 even if the previous one was output-phase.
        xor rcx, rcx;
        mov [rsp + 16], rcx;
        cmp rax, 1;
        je  sch_sig_pb_output_after_field;
        jmp sch_sig_pb_input_after_field;

        // ------------------------------------------------------------
        // Error paths
        // ------------------------------------------------------------
      sch_sig_pb_syntax:
        mov rax, 0x2A00;                       // SS_ERR_SYNTAX
        jmp sch_sig_pb_epilogue;

      sch_sig_pb_bad_type:
        mov rax, 0x2A01;                       // SS_ERR_UNKNOWN_TYPE
        jmp sch_sig_pb_epilogue;

      sch_sig_pb_too_many:
        mov rax, 0x2A02;                       // SS_ERR_TOO_MANY_FIELDS
        jmp sch_sig_pb_epilogue;

      sch_sig_pb_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _ss_match_record(sig_schema_ptr, sig_schema_len, record_ptr) -> errno
  //
  //   rdi = sig_schema_ptr   (array of SS_FIELD_DESC_BYTES-stride descriptors)
  //   rsi = sig_schema_len   (bytes in sig_schema_ptr, inc. END terminator)
  //   rdx = record_ptr       (opaque; M2+ will define per-type offsets)
  //   rax = SS_UNIMPLEMENTED at M1
  //
  // M1 stub -- the signature is frozen now so R222.M2+ can wire in the
  // full runtime type-check without an ABI break. At M1, returns
  // SS_UNIMPLEMENTED (0x2A03) unconditionally.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed sch_sig_mr_.
  // ==========================================================================
  pub let _ss_match_record : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sig_schema_ptr: u64) (sig_schema_len: u64) (record_ptr: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M1 (#2658): typecheck stub. M1 does not yet implement the per-field type-code compare -- that lands at R222.M3 when REPL dispatch wires _ss_match_record into the per-record consumer. Pure leaf; zero pushes; no stack frame; no nested CALL. Signature is frozen at this landing so M2+ can replace the body without an ABI break. `mov rax, imm32` (0x2A03 fits in imm32 with bit 31 clear). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed sch_sig_mr_.",
      block: {
      sch_sig_mr_entry:
        mov rax, 0x2A03;                       // SS_UNIMPLEMENTED
        ret;
      }
    }

}
