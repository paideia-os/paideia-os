// src/arg_flag_spec.pdx -- libpdx-pds-parser.R222.M4 (paideia-os#2661)
//
// ArgFlagSpec: parser-tier HM-typed argument + flag descriptors for
// semantic-shell cmd-functors. R222.M4 of the cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1 (SchemasSig, Wave 113) declared the INPUT + OUTPUT record
// SHAPES. R222.M2 (CommandSig, Wave 116) declared the FUNCTOR IDENTITY
// block. R222.M3 (FunctorInstance, Wave 118) wired the two together
// at REPL prompt time, emitting a flat materialization record of
// `(type_code=STR, mode=REF)` ArgDesc stubs. R222.M4 (THIS module)
// adds the two REMAINING signature parameters -- positional ArgSpec
// and named FlagSpec -- and the invocation-time type-checker that
// walks a FunctorInstance materialization record against those
// signatures, producing diagnostics referenced to each ArgDesc's
// source byte range in the invocation buffer.
//
//     module Find(Schemas : SchemasSig)
//                (Caps    : CommandSig)
//                (Args    : ArgSpec   )
//                (Flags   : FlagSpec  )
//         : struct { ... } = struct ... end
//
// At the REPL prompt:
//
//   1. _fi_instantiate (R222.M3) parses `<name> <arg>*` into a
//      FunctorInstance materialization record (FINS magic + ArgDesc
//      array).
//   2. _afs_check_invocation (THIS module) walks the ArgDesc array
//      against the per-command ArgSpec + FlagSpec records, promoting
//      type mismatches to packed-status diagnostics that reference
//      each ArgDesc's (ref_ptr, length) source span.
//   3. On AFS_OK, R229.M3 (REPL dispatch, deferred) calls
//      _fi_elaborate_args seeded from the ArgSpec type_codes to
//      promote REF ArgDescs into INLINE numeric values.
//
// =============================================================================
// RECORD LAYOUTS
// =============================================================================
//
// ArgSpec (32 B each):
//
//   offset size field               notes
//   ------ ---- ------------------- ------------------------------
//     0     4   magic         u32   AFS_ARG_SPEC_MAGIC ('ARGS' LE
//                                    = 0x53475241)
//     4     2   pos           u16   0..AFS_MAX_ARGS-1; 0xFFFF reserved
//                                    for a future flag-only sentinel.
//     6     2   flags         u16   bit 0 OPTIONAL, bit 1 VARIADIC
//     8     1   type_code     u8    AFS_TYPE_* mirroring SchemasSig
//                                    SS_TYPE_* / FunctorInstance
//                                    FI_TYPE_* byte-for-byte.
//     9     1   name_len      u8    1..AFS_NAME_MAX = 14
//    10    14   name_inline   u8[]  ASCII, zero-padded past name_len
//    24     8   default_ref   u64   type-tagged default-value ptr; 0
//                                    at M4 (default-literal grammar
//                                    lands at R222.M6).
//
//   total: 32 B (AFS_ARG_SPEC_BYTES; power-of-two for `shl rN, 5`
//   stride).
//
// FlagSpec (32 B each):
//
//   offset size field               notes
//   ------ ---- ------------------- ------------------------------
//     0     4   magic         u32   AFS_FLAG_SPEC_MAGIC ('FLAG' LE
//                                    = 0x47414C46)
//     4     2   flags         u16   bit 0 TAKES_VALUE, bit 1 REPEATABLE
//     6     1   short_char    u8    ASCII letter or 0 (no short form)
//     7     1   long_len      u8    1..AFS_NAME_MAX = 14
//     8    14   long_name     u8[]  ASCII, zero-padded past long_len
//    22     1   type_code     u8    0 for bool flag; AFS_TYPE_* for a
//                                    flag whose value is consumed
//                                    from the next invocation token.
//    23     9   reserved      u8[]  zeroed; reserved for R222.M6
//                                    (default-literal slot).
//
//   total: 32 B (AFS_FLAG_SPEC_BYTES).
//
// The brief sketched `reserved[4]` on ArgSpec and `reserved[11]` on
// FlagSpec, which would have made the records 36 and 34 bytes
// respectively. This landing shrinks both to a strict 32 bytes so the
// stride multiply is a single `shl rN, 5` -- never 2-op `imul r, imm`
// (per feedback_pdx_encoder_pitfalls). A future need for a cap-row
// id or source-span u32 can carve into default_ref's low bits or add
// a sibling descriptor type without an ABI break.
//
// =============================================================================
// GRAMMARS
// =============================================================================
//
// ArgSpec body:
//
//     ArgSpecBody := ArgDecl*
//     ArgDecl     := "arg" WS* ":" WS* NAME WS* ":" WS* TYPE_NAME
//                        [WS* "?"] [WS* "..."]
//     NAME        := [A-Za-z_] [A-Za-z0-9_]*     (len 1..14)
//     TYPE_NAME   := u64 | i64 | str | hex | hash32 | tsc | path | pid
//
// Position auto-increments by appearance order; `?` sets OPTIONAL
// (bit 0); `...` sets VARIADIC (bit 1).
//
// FlagSpec body:
//
//     FlagSpecBody := FlagDecl*
//     FlagDecl     := "flag" WS* ":" WS* "--" LONG_NAME
//                            [WS* "," WS* "-" SHORT_CHAR]
//                            [WS* ":" WS* TYPE_NAME]
//                            [WS* "+"]
//     LONG_NAME    := [A-Za-z] [A-Za-z0-9_-]*     (len 1..14)
//     SHORT_CHAR   := [A-Za-z]                    (1 char)
//
// Type-name presence sets TAKES_VALUE (bit 0); `+` sets REPEATABLE
// (bit 1).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _afs_parse_arg_spec_body(bytes_ptr, bytes_len, out_ptr, out_cap)
//                                                        -> packed_u64
//
//     Parses the body between `{` and `}` of an `arg_spec { ... }`
//     block. Writes AFS_ARG_SPEC_BYTES * n_args bytes starting at
//     out_ptr. Returns a packed `(bytes_written << 32) | status`
//     u64; bytes_written is meaningful only when status == AFS_OK.
//
//   _afs_parse_flag_spec_body(bytes_ptr, bytes_len, out_ptr, out_cap)
//                                                        -> packed_u64
//
//     Parses the body of a `flag_spec { ... }` block. Writes
//     AFS_FLAG_SPEC_BYTES * n_flags bytes starting at out_ptr.
//     Returns `(bytes_written << 32) | status`.
//
//   _afs_check_invocation(args_body, args_len, flags_body, flags_len,
//                         invocation, inv_len)           -> status
//
//     Walks the ArgDesc array in a FunctorInstance materialization
//     record (as produced by R222.M3's _fi_instantiate) against the
//     ArgSpec + FlagSpec records. Returns the first error encountered,
//     or AFS_OK on full match. Validates:
//
//       * invocation starts with the FunctorInstance 'FINS' magic
//       * inv_len >= 64 + arg_count * 32
//       * each ArgDesc that starts with `--` resolves against a
//         FlagSpec long_name (AFS_ERR_UNKNOWN_FLAG otherwise)
//       * each ArgDesc of length 2 starting with `-` resolves against
//         a FlagSpec short_char (AFS_ERR_UNKNOWN_FLAG otherwise)
//       * for each positional ArgDesc, the byte run parses as the
//         corresponding ArgSpec's type_code (AFS_ERR_TYPE_MISMATCH)
//       * all non-OPTIONAL ArgSpecs are consumed (MISSING_REQUIRED)
//       * total positionals do not exceed the ArgSpec count unless
//         the last ArgSpec is VARIADIC (EXTRA_POS)
//
// Register maps (SysV):
//
//   _afs_parse_arg_spec_body (rdi, rsi, rdx, rcx) -> rax
//   _afs_parse_flag_spec_body(rdi, rsi, rdx, rcx) -> rax
//   _afs_check_invocation    (rdi, rsi, rdx, rcx, r8, r9) -> rax
//
// Internal module-private helpers (not re-exported):
//
//   _afs_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
//   _afs_classify_type(ident_ptr, ident_len) -> type_code
//   _afs_parse_as_type(ptr, len, type_code) -> status (OK or MISMATCH)
//
// =============================================================================
// STATUS BAND -- 0x3C00..0x3CFF
// =============================================================================
//
//   AFS_OK                     = 0
//   AFS_ERR_SYNTAX             = 0x3C00
//   AFS_ERR_UNKNOWN_TYPE       = 0x3C01
//   AFS_ERR_TOO_MANY_ARGS      = 0x3C02
//   AFS_ERR_TOO_MANY_FLAGS     = 0x3C03
//   AFS_ERR_OUT_TOO_SMALL      = 0x3C04
//   AFS_ERR_BAD_INVOCATION     = 0x3C05
//   AFS_ERR_TYPE_MISMATCH      = 0x3C06
//   AFS_ERR_MISSING_REQUIRED   = 0x3C07
//   AFS_ERR_UNKNOWN_FLAG       = 0x3C08
//   AFS_ERR_FLAG_NO_VALUE      = 0x3C09
//   AFS_ERR_EXTRA_POS          = 0x3C0A
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- stride is `shl rN, 5` (* 32).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `ArgFlagSpec` matches `arg_flag_spec.pdx`.
//   - Labels prefixed `afs_` (grep-confirmed: libpdx-audit's
//     audit_file_sink uses `afs_` for FUNCTION-LOCAL labels, which
//     are function-scoped in paideia-as -- the two modules live in
//     disjoint linker-visible symbol namespaces).
//   - All `cmp reg, imm` immediates fit in imm32 with bit 31 clear.
//     The two magic values (0x53475241, 0x47414C46) and the
//     FunctorInstance magic (0x534E4946) all fit in imm32.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx]`;
//     byte stores via `mov_b [dst + disp], reg`.
//   - u16 stores via two `mov_b` byte writes (low, high).
//   - u32 stores via `mov_d [dst + disp], reg`.
//   - u64 stores via `mov [dst + disp], reg`.
//   - Zero-fill of a fresh 32-byte spec record uses a u64 stepping
//     loop (4 iterations stepping by 8).
//   - `_afs_skip_ws`, `_afs_classify_type`, `_afs_parse_as_type` are
//     pure leaves: no callee-save push, no stack frame, no nested
//     CALL.
//   - `_afs_parse_arg_spec_body` / `_afs_parse_flag_spec_body` have a
//     6-push + 24-byte-scratch frame (rsp%16==0 at every nested CALL;
//     entry %16==8, +48 pushes = %16==8, +24 scratch = 8+48+24 = 80,
//     %16==0). Scratch holds token_start, token_len, pad.
//   - `_afs_check_invocation` has a 6-push + 40-byte-scratch frame
//     (entry %16==8, +48 pushes = %16==8, +40 scratch = 8+48+40 = 96,
//     %16==0). Scratch holds invocation ptr, arg_count u64, pos_idx,
//     args_body saved copy, pad.
//
// =============================================================================
// STATUS-CHECK DISCIPLINE (WAVE 118 LESSON)
// =============================================================================
//
//   The Wave 118 debugger pass caught two infinite-loop bugs where
//   status 0x3800 (low byte 0x00) was masked with `and r11, 0xFF` and
//   misread as OK. Any status check in this file uses full-32-bit
//   `cmp` -- never `and reg, 0xFF`. The status values 0x3C00 and
//   0x3C0A both end `..0x..00..0x..0A` which still has nonzero low
//   byte for most codes, but 0x3C00 itself has low byte 0 so a byte-
//   masked read would silently misclassify the first status code of
//   this band as AFS_OK.
//
// =============================================================================
// Upstream: paideia-os#2486 (R222 umbrella), paideia-os#2661 (THIS
// ticket, R222.M4). Substrate: paideia-os#2658 (R222.M1 SchemasSig),
// paideia-os#2659 (R222.M2 CommandSig), paideia-os#2660 (R222.M3
// FunctorInstance). Design doc: design/shell/arg-flag-spec-typing.md.

module ArgFlagSpec = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES
  // ==========================================================================

  pub let AFS_OK                     : u64 = 0
  pub let AFS_ERR_SYNTAX             : u64 = 0x3C00
  pub let AFS_ERR_UNKNOWN_TYPE       : u64 = 0x3C01
  pub let AFS_ERR_TOO_MANY_ARGS      : u64 = 0x3C02
  pub let AFS_ERR_TOO_MANY_FLAGS     : u64 = 0x3C03
  pub let AFS_ERR_OUT_TOO_SMALL      : u64 = 0x3C04
  pub let AFS_ERR_BAD_INVOCATION     : u64 = 0x3C05
  pub let AFS_ERR_TYPE_MISMATCH      : u64 = 0x3C06
  pub let AFS_ERR_MISSING_REQUIRED   : u64 = 0x3C07
  pub let AFS_ERR_UNKNOWN_FLAG       : u64 = 0x3C08
  pub let AFS_ERR_FLAG_NO_VALUE      : u64 = 0x3C09
  pub let AFS_ERR_EXTRA_POS          : u64 = 0x3C0A

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let AFS_ARG_SPEC_BYTES         : u64 = 32
  pub let AFS_FLAG_SPEC_BYTES        : u64 = 32
  pub let AFS_MAX_ARGS               : u64 = 16
  pub let AFS_MAX_FLAGS              : u64 = 16
  pub let AFS_NAME_MAX               : u64 = 14

  pub let AFS_ARG_SPEC_MAGIC         : u64 = 0x53475241   // 'ARGS' LE
  pub let AFS_FLAG_SPEC_MAGIC        : u64 = 0x47414C46   // 'FLAG' LE
  pub let AFS_FI_HEADER_MAGIC        : u64 = 0x534E4946   // 'FINS' LE
  pub let AFS_FI_HEADER_BYTES        : u64 = 64
  pub let AFS_FI_ARG_DESC_BYTES      : u64 = 32

  // ArgSpec flag bits.
  pub let AFS_ARG_FLAG_OPTIONAL      : u64 = 0x01
  pub let AFS_ARG_FLAG_VARIADIC      : u64 = 0x02

  // FlagSpec flag bits.
  pub let AFS_FLAG_TAKES_VALUE       : u64 = 0x01
  pub let AFS_FLAG_REPEATABLE        : u64 = 0x02

  // Type codes (byte-for-byte mirror of R222.M1 SchemasSig SS_TYPE_*
  // and R222.M3 FunctorInstance FI_TYPE_*).
  pub let AFS_TYPE_END               : u64 = 0
  pub let AFS_TYPE_U64               : u64 = 1
  pub let AFS_TYPE_I64               : u64 = 2
  pub let AFS_TYPE_STR               : u64 = 3
  pub let AFS_TYPE_HEX               : u64 = 4
  pub let AFS_TYPE_HASH32            : u64 = 5
  pub let AFS_TYPE_TSC               : u64 = 6
  pub let AFS_TYPE_PATH              : u64 = 8
  pub let AFS_TYPE_PID               : u64 = 9
  pub let AFS_TYPE_UNKNOWN           : u64 = 0xFF

  // ArgSpec field offsets.
  pub let AFS_ARG_OFF_MAGIC          : u64 = 0
  pub let AFS_ARG_OFF_POS            : u64 = 4
  pub let AFS_ARG_OFF_FLAGS          : u64 = 6
  pub let AFS_ARG_OFF_TYPE_CODE      : u64 = 8
  pub let AFS_ARG_OFF_NAME_LEN       : u64 = 9
  pub let AFS_ARG_OFF_NAME_INLINE    : u64 = 10
  pub let AFS_ARG_OFF_DEFAULT_REF    : u64 = 24

  // FlagSpec field offsets.
  pub let AFS_FLAG_OFF_MAGIC         : u64 = 0
  pub let AFS_FLAG_OFF_FLAGS         : u64 = 4
  pub let AFS_FLAG_OFF_SHORT_CHAR    : u64 = 6
  pub let AFS_FLAG_OFF_LONG_LEN      : u64 = 7
  pub let AFS_FLAG_OFF_LONG_NAME     : u64 = 8
  pub let AFS_FLAG_OFF_TYPE_CODE     : u64 = 22

  // FunctorInstance (R222.M3) field offsets (for check_invocation).
  pub let AFS_FI_OFF_MAGIC           : u64 = 0
  pub let AFS_FI_OFF_ARG_COUNT       : u64 = 4

  // ArgDesc (R222.M3) field offsets (for check_invocation).
  pub let AFS_FI_DESC_OFF_LENGTH     : u64 = 4
  pub let AFS_FI_DESC_OFF_REF_PTR    : u64 = 16

  // ==========================================================================
  // _afs_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Byte-for-byte mirror of _sch_sig_skip_ws / _cmd_sig_skip_ws /
  // _fi_skip_ws. Labels prefixed afs_sw_.
  // ==========================================================================
  pub let _afs_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. The space-class check is four cmp-imm32 branches rather than a bitmap because the set is small and the branch predictor can speculate the common no-ws case. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All `cmp` immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed afs_sw_.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      afs_sw_loop:
        cmp rax, rsi;
        jae afs_sw_done;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  afs_sw_advance;
        cmp rcx, 0x09;
        je  afs_sw_advance;
        cmp rcx, 0x0A;
        je  afs_sw_advance;
        cmp rcx, 0x0D;
        je  afs_sw_advance;
        jmp afs_sw_done;

      afs_sw_advance:
        add rax, 1;
        jmp afs_sw_loop;

      afs_sw_done:
        ret;
      }
    }

  // ==========================================================================
  // _afs_classify_type(ident_ptr, ident_len) -> type_code
  //
  //   rdi = ident_ptr
  //   rsi = ident_len
  //   rax = AFS_TYPE_* or AFS_TYPE_UNKNOWN (0xFF)
  //
  // Length-switched classify over {u64, i64, str, hex, hash32, tsc,
  // path, pid}. Mirrors R222.M1 SchemasSig _sch_sig_classify_type
  // byte-for-byte so a downstream consumer that compares type codes
  // across the two families operates on the same byte-value space.
  // Pure leaf. Labels prefixed afs_ct_.
  // ==========================================================================
  pub let _afs_classify_type : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): classify a candidate type_name ident against the M4-known type set. Length-switched dispatch: 3 -> six 3-letter types (u64/i64/str/hex/tsc/pid); 4 -> path; 6 -> hash32. Each length arm does a first-byte branch then confirms the trailing bytes with mov_b+cmp pairs. Returns AFS_TYPE_UNKNOWN (0xFF) on any mismatch. Pure leaf -- zero pushes, no stack frame, no nested CALL. All ASCII literals (0x62..0x75) fit in imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed afs_ct_.",
      block: {
        cmp rsi, 3;
        je  afs_ct_len3;
        cmp rsi, 4;
        je  afs_ct_len4;
        cmp rsi, 6;
        je  afs_ct_len6;
        jmp afs_ct_unknown;

      afs_ct_len3:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                         // 'u'
        je  afs_ct_u64_try;
        cmp rax, 0x69;                         // 'i'
        je  afs_ct_i64_try;
        cmp rax, 0x73;                         // 's'
        je  afs_ct_str_try;
        cmp rax, 0x68;                         // 'h'
        je  afs_ct_hex_try;
        cmp rax, 0x74;                         // 't'
        je  afs_ct_tsc_try;
        cmp rax, 0x70;                         // 'p'
        je  afs_ct_pid_try;
        jmp afs_ct_unknown;

      afs_ct_u64_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne afs_ct_unknown;
        mov rax, 1;                            // AFS_TYPE_U64
        ret;

      afs_ct_i64_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;
        jne afs_ct_unknown;
        mov rax, 2;                            // AFS_TYPE_I64
        ret;

      afs_ct_str_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x74;                         // 't'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x72;                         // 'r'
        jne afs_ct_unknown;
        mov rax, 3;                            // AFS_TYPE_STR
        ret;

      afs_ct_hex_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x65;                         // 'e'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x78;                         // 'x'
        jne afs_ct_unknown;
        mov rax, 4;                            // AFS_TYPE_HEX
        ret;

      afs_ct_tsc_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x73;                         // 's'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x63;                         // 'c'
        jne afs_ct_unknown;
        mov rax, 6;                            // AFS_TYPE_TSC
        ret;

      afs_ct_pid_try:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x69;                         // 'i'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x64;                         // 'd'
        jne afs_ct_unknown;
        mov rax, 9;                            // AFS_TYPE_PID
        ret;

      afs_ct_len4:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x70;                         // 'p'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x74;                         // 't'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne afs_ct_unknown;
        mov rax, 8;                            // AFS_TYPE_PATH
        ret;

      afs_ct_len6:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x68;                         // 'h'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x73;                         // 's'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0x33;                         // '3'
        jne afs_ct_unknown;
        xor rax, rax;
        mov_b rax, [rdi + 5];
        cmp rax, 0x32;                         // '2'
        jne afs_ct_unknown;
        mov rax, 5;                            // AFS_TYPE_HASH32
        ret;

      afs_ct_unknown:
        mov rax, 0xFF;                         // AFS_TYPE_UNKNOWN
        ret;
      }
    }

  // ==========================================================================
  // _afs_parse_as_type(ptr, len, type_code) -> status
  //
  //   rdi = ptr        (byte pointer to the value run)
  //   rsi = len        (byte length of the value run)
  //   rdx = type_code  (AFS_TYPE_*)
  //   rax = AFS_OK or AFS_ERR_TYPE_MISMATCH
  //
  // Validates that bytes [ptr..ptr+len) parse as the given type_code.
  //
  //   U64 / TSC / PID (1 / 6 / 9):   all decimal digits, len >= 1
  //   I64 (2):                       optional '-' then decimal digits
  //   STR / PATH (3 / 8):            always OK (len >= 1)
  //   HEX (4):                       "0x" + 1..16 hex digits
  //   HASH32 (5):                    "0x" + exactly 16 hex digits
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed afs_pt_.
  // ==========================================================================
  pub let _afs_parse_as_type : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) (type_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): typecheck a byte run against a declared type_code. Pure leaf; zero pushes; no stack frame; no nested CALL. Dispatch on rdx: U64/TSC/PID require all decimal digits (0x30..0x39); I64 allows an optional leading '-' (0x2D); STR/PATH always accept any non-empty run; HEX requires '0x' prefix + 1..16 hex digits; HASH32 requires '0x' prefix + exactly 16 hex digits. Empty run (rsi == 0) returns MISMATCH for every type (even STR/PATH, since an empty ArgDesc byte-range is a parser bug upstream). All cmp immediates (ASCII 0x2D/0x30/0x39/0x41/0x46/0x61/0x66/0x78/0x58, type codes 1..9, len 2/3/18, status 0x3C06) fit in imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed afs_pt_.",
      block: {
        // Empty byte run is always a mismatch.
        cmp rsi, 0;
        je  afs_pt_mismatch;

        // Dispatch on type_code.
        cmp rdx, 1;                            // U64
        je  afs_pt_decimal;
        cmp rdx, 6;                            // TSC
        je  afs_pt_decimal;
        cmp rdx, 9;                            // PID
        je  afs_pt_decimal;
        cmp rdx, 2;                            // I64
        je  afs_pt_signed;
        cmp rdx, 3;                            // STR
        je  afs_pt_ok;
        cmp rdx, 8;                            // PATH
        je  afs_pt_ok;
        cmp rdx, 4;                            // HEX
        je  afs_pt_hex;
        cmp rdx, 5;                            // HASH32
        je  afs_pt_hash32;
        jmp afs_pt_mismatch;

        // ---- U64 / TSC / PID: all decimal digits -----------------
      afs_pt_decimal:
        xor rcx, rcx;                          // i = 0
      afs_pt_decimal_loop:
        cmp rcx, rsi;
        jae afs_pt_ok;
        xor rax, rax;
        mov_b rax, [rdi + rcx];
        cmp rax, 0x30;
        jb  afs_pt_mismatch;
        cmp rax, 0x39;
        ja  afs_pt_mismatch;
        add rcx, 1;
        jmp afs_pt_decimal_loop;

        // ---- I64: optional '-' then decimal digits ---------------
      afs_pt_signed:
        xor rcx, rcx;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x2D;                         // '-'
        jne afs_pt_signed_scan;
        // Consume the '-'; must have at least one digit after.
        add rcx, 1;
        cmp rcx, rsi;
        jae afs_pt_mismatch;                   // '-' alone -> mismatch
      afs_pt_signed_scan:
        cmp rcx, rsi;
        jae afs_pt_ok;
        xor rax, rax;
        mov_b rax, [rdi + rcx];
        cmp rax, 0x30;
        jb  afs_pt_mismatch;
        cmp rax, 0x39;
        ja  afs_pt_mismatch;
        add rcx, 1;
        jmp afs_pt_signed_scan;

        // ---- HEX: "0x" prefix + 1..16 hex digits -----------------
      afs_pt_hex:
        cmp rsi, 3;                            // "0x" + >=1 digit
        jb  afs_pt_mismatch;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x30;                         // '0'
        jne afs_pt_mismatch;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x78;                         // 'x'
        je  afs_pt_hex_scan;
        cmp rax, 0x58;                         // 'X'
        je  afs_pt_hex_scan;
        jmp afs_pt_mismatch;
      afs_pt_hex_scan:
        // Digit count 1..16; cursor starts at index 2.
        mov rcx, 2;                            // i = 2
        xor r8, r8;                            // n_digits = 0
      afs_pt_hex_scan_loop:
        cmp rcx, rsi;
        jae afs_pt_hex_done;
        xor rax, rax;
        mov_b rax, [rdi + rcx];
        cmp rax, 0x30;
        jb  afs_pt_mismatch;
        cmp rax, 0x39;
        jbe afs_pt_hex_digit;
        cmp rax, 0x41;
        jb  afs_pt_mismatch;
        cmp rax, 0x46;
        jbe afs_pt_hex_digit;
        cmp rax, 0x61;
        jb  afs_pt_mismatch;
        cmp rax, 0x66;
        jbe afs_pt_hex_digit;
        jmp afs_pt_mismatch;
      afs_pt_hex_digit:
        add r8, 1;
        cmp r8, 16;                            // > 16 hex overflows u64
        ja  afs_pt_mismatch;
        add rcx, 1;
        jmp afs_pt_hex_scan_loop;
      afs_pt_hex_done:
        cmp r8, 0;                             // need >= 1 digit
        je  afs_pt_mismatch;
        jmp afs_pt_ok;

        // ---- HASH32: "0x" + exactly 16 hex digits ----------------
      afs_pt_hash32:
        cmp rsi, 18;                           // "0x" + 16 digits
        jne afs_pt_mismatch;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x30;
        jne afs_pt_mismatch;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x78;
        je  afs_pt_hash32_scan;
        cmp rax, 0x58;
        je  afs_pt_hash32_scan;
        jmp afs_pt_mismatch;
      afs_pt_hash32_scan:
        mov rcx, 2;                            // i = 2
      afs_pt_hash32_loop:
        cmp rcx, rsi;
        jae afs_pt_ok;
        xor rax, rax;
        mov_b rax, [rdi + rcx];
        cmp rax, 0x30;
        jb  afs_pt_mismatch;
        cmp rax, 0x39;
        jbe afs_pt_hash32_step;
        cmp rax, 0x41;
        jb  afs_pt_mismatch;
        cmp rax, 0x46;
        jbe afs_pt_hash32_step;
        cmp rax, 0x61;
        jb  afs_pt_mismatch;
        cmp rax, 0x66;
        ja  afs_pt_mismatch;
      afs_pt_hash32_step:
        add rcx, 1;
        jmp afs_pt_hash32_loop;

      afs_pt_ok:
        xor rax, rax;                          // AFS_OK = 0
        ret;

      afs_pt_mismatch:
        mov rax, 0x3C06;                       // AFS_ERR_TYPE_MISMATCH
        ret;
      }
    }

  // ==========================================================================
  // _afs_parse_arg_spec_body(bytes_ptr, bytes_len, out_ptr, out_cap)
  //                                                      -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Parses `arg : NAME : TYPE [? ...]*` decls. Each decl becomes a
  // 32-byte ArgSpec record. Position auto-assigned by order (0, 1, ...).
  //
  // Register plan (6-push + 24-byte scratch; rsp%16==0 steady):
  //
  //   rbx = bytes_ptr (immutable)
  //   rbp = bytes_len (immutable)
  //   r12 = cursor
  //   r13 = out_ptr (immutable base)
  //   r14 = out_cap (immutable)
  //   r15 = n_args counter
  //
  //   [rsp +  0] = token_start
  //   [rsp +  8] = token_len
  //   [rsp + 16] = pad
  //
  // Labels prefixed afs_pa_.
  // ==========================================================================
  pub let _afs_parse_arg_spec_body : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): parse `arg_spec { ... }` body into a flat array of AFS_ARG_SPEC_BYTES=32 ArgSpec records. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr, r14=out_cap, r15=n_args) + `sub rsp, 24` for scratch slots (token_start, token_len, pad) -> rsp%16==0 steady at every nested CALL (entry %16==8, +48 pushes = %16==8, +24 scratch -> %16==0). Each iteration: skip_ws; if cursor==len success; scan keyword `arg` (len 3, confirm each byte); skip_ws+require ':'+skip_ws; scan NAME (byte-class [A-Za-z_] + [A-Za-z0-9_]*; max AFS_NAME_MAX=14); skip_ws+require ':'+skip_ws; scan TYPE_NAME (same byte-class); classify via _afs_classify_type (unknown -> UNKNOWN_TYPE); peek for optional '?' and '...' flag suffixes; stride-mul via `shl r, 5` (never imul r,imm) to compute desc_addr = out_ptr + n_args*32; zero-fill the 32-byte record via a u64 stepping loop (4 iterations stepping by 8); stamp magic (0x53475241), pos u16 = n_args (low+high mov_b), flags u16 (low+high mov_b), type_code u8, name_len u8, name_inline bytes + zero-pad, default_ref u64 = 0. Count guard: n_args < AFS_MAX_ARGS=16 (TOO_MANY_ARGS). Capacity guard: (n_args+1)*32 <= out_cap (OUT_TOO_SMALL). All error paths jump to a shared epilogue that unwinds the 24-byte scratch and 6 callee-save pops. All cmp immediates (ASCII literals 0x21..0x7E, counts 14/16, size constants 32/64, status codes 0x3C00..0x3C04) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. AFS_ARG_SPEC_MAGIC (0x53475241) and AFS_TYPE_UNKNOWN (0xFF) fit in imm32 so mov rN, imm32 is sign-safe. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed afs_pa_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        xor r12, r12;                          // cursor = 0
        mov r13, rdx;                          // out_ptr
        mov r14, rcx;                          // out_cap
        xor r15, r15;                          // n_args = 0

        xor rax, rax;
        mov [rsp + 0], rax;                    // token_start = 0
        mov [rsp + 8], rax;                    // token_len = 0
        mov [rsp + 16], rax;                   // pad

        // ============================================================
        // Decl loop.
        // ============================================================
      afs_pa_decl_loop:
        // skip_ws
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        // End-of-input is clean exit.
        cmp r12, rbp;
        jae afs_pa_done;

        // Count guard (checked before parsing the next decl).
        cmp r15, 16;                           // AFS_MAX_ARGS
        jae afs_pa_too_many;

        // Capacity guard: need (n_args+1) * 32 <= out_cap.
        mov rax, r15;
        add rax, 1;
        shl rax, 5;                            // * 32
        cmp rax, r14;
        ja  afs_pa_oos;

        // ---- Match keyword "arg" (len 3: a=0x61, r=0x72, g=0x67). --
        // Need 3 bytes available at cursor.
        mov rax, r12;
        add rax, 3;
        cmp rax, rbp;
        ja  afs_pa_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x61;                         // 'a'
        jne afs_pa_syntax;
        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x72;                         // 'r'
        jne afs_pa_syntax;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x67;                         // 'g'
        jne afs_pa_syntax;
        add r12, 3;                            // consume "arg"

        // ---- skip_ws + require ':' + skip_ws -----------------------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pa_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        jne afs_pa_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        // ---- Scan NAME: [A-Za-z_] [A-Za-z0-9_]* ---------------------
        cmp r12, rbp;
        jae afs_pa_syntax;
        mov [rsp + 0], r12;                    // name_start

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;                         // '_'
        je  afs_pa_name_cont;
        cmp rax, 0x41;
        jb  afs_pa_syntax;
        cmp rax, 0x5A;
        jbe afs_pa_name_cont;
        cmp rax, 0x61;
        jb  afs_pa_syntax;
        cmp rax, 0x7A;
        ja  afs_pa_syntax;

      afs_pa_name_cont:
        add r12, 1;

      afs_pa_name_scan:
        cmp r12, rbp;
        jae afs_pa_name_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  afs_pa_name_step;
        cmp rax, 0x30;
        jb  afs_pa_name_check_alpha;
        cmp rax, 0x39;
        jbe afs_pa_name_step;
      afs_pa_name_check_alpha:
        cmp rax, 0x41;
        jb  afs_pa_name_end;
        cmp rax, 0x5A;
        jbe afs_pa_name_step;
        cmp rax, 0x61;
        jb  afs_pa_name_end;
        cmp rax, 0x7A;
        ja  afs_pa_name_end;
      afs_pa_name_step:
        add r12, 1;
        jmp afs_pa_name_scan;

      afs_pa_name_end:
        // name_len = r12 - name_start
        mov rax, r12;
        sub rax, [rsp + 0];
        cmp rax, 0;
        je  afs_pa_syntax;
        cmp rax, 14;                           // AFS_NAME_MAX
        ja  afs_pa_syntax;
        mov [rsp + 8], rax;                    // name_len

        // ---- skip_ws + require ':' + skip_ws -----------------------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pa_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;
        jne afs_pa_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        // ---- Scan TYPE_NAME (same ident class). --------------------
        cmp r12, rbp;
        jae afs_pa_syntax;
        mov r8, r12;                           // type_start

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  afs_pa_type_cont;
        cmp rax, 0x41;
        jb  afs_pa_syntax;
        cmp rax, 0x5A;
        jbe afs_pa_type_cont;
        cmp rax, 0x61;
        jb  afs_pa_syntax;
        cmp rax, 0x7A;
        ja  afs_pa_syntax;

      afs_pa_type_cont:
        add r12, 1;

      afs_pa_type_scan:
        cmp r12, rbp;
        jae afs_pa_type_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  afs_pa_type_step;
        cmp rax, 0x30;
        jb  afs_pa_type_check_alpha;
        cmp rax, 0x39;
        jbe afs_pa_type_step;
      afs_pa_type_check_alpha:
        cmp rax, 0x41;
        jb  afs_pa_type_end;
        cmp rax, 0x5A;
        jbe afs_pa_type_step;
        cmp rax, 0x61;
        jb  afs_pa_type_end;
        cmp rax, 0x7A;
        ja  afs_pa_type_end;
      afs_pa_type_step:
        add r12, 1;
        jmp afs_pa_type_scan;

      afs_pa_type_end:
        // type_len = r12 - type_start
        mov r9, r12;
        sub r9, r8;
        cmp r9, 0;
        je  afs_pa_syntax;

        // Classify.
        mov rdi, rbx;
        add rdi, r8;
        mov rsi, r9;
        call _afs_classify_type;
        cmp rax, 0xFF;                         // AFS_TYPE_UNKNOWN
        je  afs_pa_bad_type;
        // rax now holds type_code (1..9, with 7 skipped). Save in r10.
        mov r10, rax;

        // ---- Peek for optional "?" and "..." suffix flags. ---------
        // Build flags_val in r11.
        xor r11, r11;

        // skip_ws (soft -- no error on end-of-input)
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

      afs_pa_opt_check:
        cmp r12, rbp;
        jae afs_pa_write;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3F;                         // '?'
        je  afs_pa_set_optional;
        cmp rax, 0x2E;                         // '.'
        je  afs_pa_check_variadic;
        jmp afs_pa_write;

      afs_pa_set_optional:
        or  r11, 0x01;                         // AFS_ARG_FLAG_OPTIONAL
        add r12, 1;
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;
        jmp afs_pa_opt_check;

      afs_pa_check_variadic:
        // Require "..." (three dots). Need 3 bytes available.
        mov rax, r12;
        add rax, 3;
        cmp rax, rbp;
        ja  afs_pa_syntax;
        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x2E;
        jne afs_pa_syntax;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x2E;
        jne afs_pa_syntax;
        or  r11, 0x02;                         // AFS_ARG_FLAG_VARIADIC
        add r12, 3;
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;
        jmp afs_pa_opt_check;

        // ============================================================
        // Write ArgSpec record at out_ptr + n_args * 32.
        // ============================================================
      afs_pa_write:
        // desc_addr = r13 + n_args * 32.
        mov rcx, r15;
        shl rcx, 5;                            // * 32
        add rcx, r13;                          // rcx = desc_addr

        // Zero-fill 32 bytes via u64 stepping loop (4 iterations).
        xor rax, rax;
        mov [rcx + 0], rax;
        mov [rcx + 8], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;

        // magic u32 at +0.
        mov rax, 0x53475241;                   // 'ARGS' LE
        mov_d [rcx + 0], rax;

        // pos u16 at +4 = n_args (low + high).
        mov rax, r15;
        mov_b [rcx + 4], rax;
        shr rax, 8;
        mov_b [rcx + 5], rax;

        // flags u16 at +6 = r11 (low + high).
        mov rax, r11;
        mov_b [rcx + 6], rax;
        shr rax, 8;
        mov_b [rcx + 7], rax;

        // type_code u8 at +8 = r10.
        mov_b [rcx + 8], r10;

        // name_len u8 at +9.
        mov rax, [rsp + 8];
        mov_b [rcx + 9], rax;

        // Copy name bytes to +10..+10+name_len.
        xor r9, r9;                            // j = 0
      afs_pa_name_copy:
        cmp r9, [rsp + 8];
        jae afs_pa_name_pad;
        mov rdi, rbx;
        add rdi, [rsp + 0];                    // name_start
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, rcx;
        add rsi, 10;                           // AFS_ARG_OFF_NAME_INLINE
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp afs_pa_name_copy;

      afs_pa_name_pad:
        // Zero-pad [10 + name_len .. 24). default_ref already zeroed.
        mov r9, [rsp + 8];
        add r9, 10;
      afs_pa_name_pad_loop:
        cmp r9, 24;                            // AFS_ARG_OFF_DEFAULT_REF
        jae afs_pa_slot_done;
        mov rsi, rcx;
        add rsi, r9;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp afs_pa_name_pad_loop;

      afs_pa_slot_done:
        add r15, 1;                            // n_args++
        jmp afs_pa_decl_loop;

        // ============================================================
        // Success exit.
        // ============================================================
      afs_pa_done:
        // bytes_written = n_args * 32.
        mov rax, r15;
        shl rax, 5;
        shl rax, 32;
        // Pack `(bytes_written << 32) | AFS_OK`.
        jmp afs_pa_epilogue;

        // ============================================================
        // Error paths.
        // ============================================================
      afs_pa_syntax:
        mov rax, 0x3C00;                       // AFS_ERR_SYNTAX
        jmp afs_pa_epilogue;

      afs_pa_bad_type:
        mov rax, 0x3C01;                       // AFS_ERR_UNKNOWN_TYPE
        jmp afs_pa_epilogue;

      afs_pa_too_many:
        mov rax, 0x3C02;                       // AFS_ERR_TOO_MANY_ARGS
        jmp afs_pa_epilogue;

      afs_pa_oos:
        mov rax, 0x3C04;                       // AFS_ERR_OUT_TOO_SMALL
        jmp afs_pa_epilogue;

      afs_pa_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _afs_parse_flag_spec_body(bytes_ptr, bytes_len, out_ptr, out_cap)
  //                                                      -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Parses `flag : --LONG [, -S] [: TYPE] [+]` decls. Each decl
  // becomes a 32-byte FlagSpec record.
  //
  // Register plan (6-push + 24-byte scratch; rsp%16==0 steady):
  //
  //   rbx = bytes_ptr
  //   rbp = bytes_len
  //   r12 = cursor
  //   r13 = out_ptr
  //   r14 = out_cap
  //   r15 = n_flags
  //
  //   [rsp +  0] = long_start
  //   [rsp +  8] = long_len
  //   [rsp + 16] = pad
  //
  // Labels prefixed afs_pf_.
  // ==========================================================================
  pub let _afs_parse_flag_spec_body : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): parse `flag_spec { ... }` body into a flat array of AFS_FLAG_SPEC_BYTES=32 FlagSpec records. 6 callee-save pushes + `sub rsp, 24` for scratch slots -> rsp%16==0 steady at every nested CALL. Each iteration: skip_ws; if cursor==len success; scan keyword `flag` (len 4, confirm each byte); skip_ws+require ':'+skip_ws; require '--' + scan LONG_NAME (byte-class [A-Za-z] + [A-Za-z0-9_-]*; max AFS_NAME_MAX=14); peek for optional ',' then '-' SHORT_CHAR; peek for optional ':' TYPE_NAME; peek for optional '+'; stride-mul via `shl r, 5`. Zero-fill 32-byte record via four u64 stores; stamp magic (0x47414C46 'FLAG'), flags u16 (TAKES_VALUE if type seen, REPEATABLE if '+' seen), short_char u8, long_len u8, long_name bytes + zero-pad, type_code u8. Count guard: n_flags < AFS_MAX_FLAGS=16 (TOO_MANY_FLAGS). Capacity guard: (n_flags+1)*32 <= out_cap (OUT_TOO_SMALL). Error paths jump to a shared epilogue. All cmp immediates fit in imm32. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed afs_pf_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;
        mov rbp, rsi;
        xor r12, r12;
        mov r13, rdx;
        mov r14, rcx;
        xor r15, r15;

        xor rax, rax;
        mov [rsp + 0], rax;
        mov [rsp + 8], rax;
        mov [rsp + 16], rax;

      afs_pf_decl_loop:
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pf_done;

        cmp r15, 16;                           // AFS_MAX_FLAGS
        jae afs_pf_too_many;

        mov rax, r15;
        add rax, 1;
        shl rax, 5;
        cmp rax, r14;
        ja  afs_pf_oos;

        // ---- Match keyword "flag" (len 4). -------------------------
        mov rax, r12;
        add rax, 4;
        cmp rax, rbp;
        ja  afs_pf_syntax;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x66;                         // 'f'
        jne afs_pf_syntax;
        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x6C;                         // 'l'
        jne afs_pf_syntax;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x61;                         // 'a'
        jne afs_pf_syntax;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x67;                         // 'g'
        jne afs_pf_syntax;
        add r12, 4;

        // ---- skip_ws + require ':' + skip_ws -----------------------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pf_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;
        jne afs_pf_syntax;
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        // ---- Require "--" prefix. ----------------------------------
        mov rax, r12;
        add rax, 2;
        cmp rax, rbp;
        ja  afs_pf_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2D;                         // '-'
        jne afs_pf_syntax;
        mov rcx, r12;
        add rcx, 1;
        xor rax, rax;
        mov_b rax, [rbx + rcx];
        cmp rax, 0x2D;
        jne afs_pf_syntax;
        add r12, 2;

        // ---- Scan LONG_NAME: [A-Za-z] [A-Za-z0-9_-]* ---------------
        cmp r12, rbp;
        jae afs_pf_syntax;
        mov [rsp + 0], r12;                    // long_start

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x41;
        jb  afs_pf_syntax;
        cmp rax, 0x5A;
        jbe afs_pf_long_cont;
        cmp rax, 0x61;
        jb  afs_pf_syntax;
        cmp rax, 0x7A;
        ja  afs_pf_syntax;

      afs_pf_long_cont:
        add r12, 1;
      afs_pf_long_scan:
        cmp r12, rbp;
        jae afs_pf_long_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;                         // '_'
        je  afs_pf_long_step;
        cmp rax, 0x2D;                         // '-' (allowed inside long)
        je  afs_pf_long_step;
        cmp rax, 0x30;
        jb  afs_pf_long_check_alpha;
        cmp rax, 0x39;
        jbe afs_pf_long_step;
      afs_pf_long_check_alpha:
        cmp rax, 0x41;
        jb  afs_pf_long_end;
        cmp rax, 0x5A;
        jbe afs_pf_long_step;
        cmp rax, 0x61;
        jb  afs_pf_long_end;
        cmp rax, 0x7A;
        ja  afs_pf_long_end;
      afs_pf_long_step:
        add r12, 1;
        jmp afs_pf_long_scan;

      afs_pf_long_end:
        mov rax, r12;
        sub rax, [rsp + 0];
        cmp rax, 0;
        je  afs_pf_syntax;
        cmp rax, 14;                           // AFS_NAME_MAX
        ja  afs_pf_syntax;
        mov [rsp + 8], rax;                    // long_len

        // ---- Optional ", -S" (short-char). -------------------------
        // r10 = short_char accumulator (0 if none).
        xor r10, r10;
        // r11 = flags_val accumulator.
        xor r11, r11;
        // r8 = type_code accumulator (0 bool).
        xor r8, r8;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pf_write;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2C;                         // ','
        jne afs_pf_check_type;

        // Consume ',' then skip_ws, require '-', one ASCII letter.
        add r12, 1;
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pf_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2D;                         // '-'
        jne afs_pf_syntax;
        add r12, 1;

        cmp r12, rbp;
        jae afs_pf_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x41;
        jb  afs_pf_syntax;
        cmp rax, 0x5A;
        jbe afs_pf_short_ok;
        cmp rax, 0x61;
        jb  afs_pf_syntax;
        cmp rax, 0x7A;
        ja  afs_pf_syntax;
      afs_pf_short_ok:
        mov r10, rax;                          // short_char
        add r12, 1;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

      afs_pf_check_type:
        cmp r12, rbp;
        jae afs_pf_write;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':' -> has type
        jne afs_pf_check_plus;

        // Consume ':', skip_ws, scan TYPE_NAME.
        add r12, 1;
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae afs_pf_syntax;
        mov r9, r12;                           // type_start

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  afs_pf_type_cont;
        cmp rax, 0x41;
        jb  afs_pf_syntax;
        cmp rax, 0x5A;
        jbe afs_pf_type_cont;
        cmp rax, 0x61;
        jb  afs_pf_syntax;
        cmp rax, 0x7A;
        ja  afs_pf_syntax;

      afs_pf_type_cont:
        add r12, 1;
      afs_pf_type_scan:
        cmp r12, rbp;
        jae afs_pf_type_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  afs_pf_type_step;
        cmp rax, 0x30;
        jb  afs_pf_type_check_alpha;
        cmp rax, 0x39;
        jbe afs_pf_type_step;
      afs_pf_type_check_alpha:
        cmp rax, 0x41;
        jb  afs_pf_type_end;
        cmp rax, 0x5A;
        jbe afs_pf_type_step;
        cmp rax, 0x61;
        jb  afs_pf_type_end;
        cmp rax, 0x7A;
        ja  afs_pf_type_end;
      afs_pf_type_step:
        add r12, 1;
        jmp afs_pf_type_scan;

      afs_pf_type_end:
        // type_len = r12 - r9. Classify.
        mov rdx, r12;
        sub rdx, r9;
        cmp rdx, 0;
        je  afs_pf_syntax;
        // _afs_classify_type(bytes_ptr + type_start, type_len) -> rax.
        mov rdi, rbx;
        add rdi, r9;
        mov rsi, rdx;
        call _afs_classify_type;
        cmp rax, 0xFF;
        je  afs_pf_bad_type;
        mov r8, rax;                           // type_code
        or  r11, 0x01;                         // AFS_FLAG_TAKES_VALUE

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _afs_skip_ws;
        mov r12, rax;

      afs_pf_check_plus:
        cmp r12, rbp;
        jae afs_pf_write;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2B;                         // '+'
        jne afs_pf_write;
        or  r11, 0x02;                         // AFS_FLAG_REPEATABLE
        add r12, 1;

        // ============================================================
        // Write FlagSpec record.
        // ============================================================
      afs_pf_write:
        // desc_addr = r13 + n_flags * 32.
        mov rcx, r15;
        shl rcx, 5;
        add rcx, r13;

        // Zero-fill 32 bytes.
        xor rax, rax;
        mov [rcx + 0], rax;
        mov [rcx + 8], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;

        // magic u32 at +0.
        mov rax, 0x47414C46;                   // 'FLAG' LE
        mov_d [rcx + 0], rax;

        // flags u16 at +4 = r11.
        mov rax, r11;
        mov_b [rcx + 4], rax;
        shr rax, 8;
        mov_b [rcx + 5], rax;

        // short_char u8 at +6.
        mov_b [rcx + 6], r10;

        // long_len u8 at +7.
        mov rax, [rsp + 8];
        mov_b [rcx + 7], rax;

        // Copy long_name bytes to +8..+8+long_len.
        xor r9, r9;
      afs_pf_long_copy:
        cmp r9, [rsp + 8];
        jae afs_pf_long_pad;
        mov rdi, rbx;
        add rdi, [rsp + 0];
        add rdi, r9;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, rcx;
        add rsi, 8;                            // AFS_FLAG_OFF_LONG_NAME
        add rsi, r9;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp afs_pf_long_copy;

      afs_pf_long_pad:
        mov r9, [rsp + 8];
        add r9, 8;
      afs_pf_long_pad_loop:
        cmp r9, 22;                            // AFS_FLAG_OFF_TYPE_CODE
        jae afs_pf_write_type;
        mov rsi, rcx;
        add rsi, r9;
        xor rax, rax;
        mov_b [rsi + 0], rax;
        add r9, 1;
        jmp afs_pf_long_pad_loop;

      afs_pf_write_type:
        // type_code u8 at +22.
        mov_b [rcx + 22], r8;

        add r15, 1;
        jmp afs_pf_decl_loop;

      afs_pf_done:
        mov rax, r15;
        shl rax, 5;
        shl rax, 32;
        jmp afs_pf_epilogue;

      afs_pf_syntax:
        mov rax, 0x3C00;                       // AFS_ERR_SYNTAX
        jmp afs_pf_epilogue;

      afs_pf_bad_type:
        mov rax, 0x3C01;                       // AFS_ERR_UNKNOWN_TYPE
        jmp afs_pf_epilogue;

      afs_pf_too_many:
        mov rax, 0x3C03;                       // AFS_ERR_TOO_MANY_FLAGS
        jmp afs_pf_epilogue;

      afs_pf_oos:
        mov rax, 0x3C04;                       // AFS_ERR_OUT_TOO_SMALL
        jmp afs_pf_epilogue;

      afs_pf_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _afs_check_invocation(args_body, args_len, flags_body, flags_len,
  //                       invocation, inv_len) -> status
  //
  //   rdi = args_body    (ArgSpec records concatenated)
  //   rsi = args_len     (bytes at args_body)
  //   rdx = flags_body   (FlagSpec records concatenated)
  //   rcx = flags_len    (bytes at flags_body)
  //   r8  = invocation   (FunctorInstance materialization record)
  //   r9  = inv_len      (bytes at invocation; >= 64 + arg_count*32)
  //   rax = status
  //
  // State machine (over the materialization record's ArgDesc array):
  //
  //   validate FINS magic + inv_len
  //   load arg_count from [inv + 4] u16
  //   pos_idx = 0  (next ArgSpec slot to fill)
  //   for i in 0..arg_count:
  //     desc_addr = inv + 64 + i*32
  //     ref_ptr = desc[+16] u64; length = desc[+4] u32
  //     if length >= 2 and ref_ptr[0] == '-' and ref_ptr[1] == '-':
  //       long-flag path:
  //         scan ref_ptr[2..] for matching FlagSpec long_name
  //         (linear scan; byte-compare long_len + name_inline)
  //         if not found: UNKNOWN_FLAG
  //         if TAKES_VALUE: i += 1; if i >= arg_count: FLAG_NO_VALUE;
  //                         call _afs_parse_as_type on the next ArgDesc.
  //     elif length == 2 and ref_ptr[0] == '-':
  //       short-flag path:
  //         scan FlagSpec records for matching short_char
  //         if not found: UNKNOWN_FLAG
  //         if TAKES_VALUE: same NO_VALUE / type-check logic as long.
  //     else:
  //       positional path:
  //         if pos_idx >= args_count AND no VARIADIC slot: EXTRA_POS
  //         load ArgSpec[min(pos_idx, variadic_slot)]
  //         _afs_parse_as_type(ref_ptr, length, type_code);
  //         if non-OK: TYPE_MISMATCH
  //         pos_idx += 1 (unless variadic slot in use)
  //   endfor
  //   for each ArgSpec slot not consumed and not OPTIONAL:
  //     MISSING_REQUIRED
  //   return AFS_OK
  //
  // Register plan (6-push + 40-byte scratch; rsp%16==0 steady):
  //
  //   rbx = invocation ptr (immutable base of the mat record)
  //   rbp = arg_count (loaded from [inv + 4] u16)
  //   r12 = i (current ArgDesc index into arg_count)
  //   r13 = args_body (immutable)
  //   r14 = flags_body (immutable)
  //   r15 = pos_idx (next ArgSpec slot to fill)
  //
  //   [rsp +  0] = args_len
  //   [rsp +  8] = flags_len
  //   [rsp + 16] = arg_specs_count (= args_len / 32)
  //   [rsp + 24] = flag_specs_count (= flags_len / 32)
  //   [rsp + 32] = pad
  //
  // Labels prefixed afs_ci_.
  // ==========================================================================
  pub let _afs_check_invocation : (u64, u64, u64, u64, u64, u64) -> u64
                                   !{mem} @{} =
    fn (args_body: u64) (args_len: u64) (flags_body: u64) (flags_len: u64)
       (invocation: u64) (inv_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M4 (#2661): walk the ArgDesc stream of a FunctorInstance materialization record against ArgSpec + FlagSpec records, promoting type mismatches to packed-status diagnostics referenced to each ArgDesc's (ref_ptr, length) source span. 6 callee-save pushes (rbx=invocation, rbp=arg_count, r12=i, r13=args_body, r14=flags_body, r15=pos_idx) + `sub rsp, 40` for scratch (args_len, flags_len, arg_specs_count, flag_specs_count, pad) -> rsp%16==0 steady at every nested CALL (entry %16==8, +48 pushes = %16==8, +40 scratch = 8+48+40 = 96, %16==0). Guards: inv_len >= 64 (FI_HEADER_BYTES), [inv+0] u32 == 0x534E4946 'FINS' (BAD_INVOCATION), inv_len >= 64 + arg_count*32 (BAD_INVOCATION). Load arg_count u16 at [inv+4] via two mov_b (low+high). arg_specs_count = args_len / 32 (via shr 5); flag_specs_count = flags_len / 32. Walk i = 0..arg_count: compute desc_addr = inv + 64 + i*32 (`shl rax, 5`); load ref_ptr u64 at [desc+16]; load length u32 at [desc+4] (zero-ext via xor+mov_d). Classify: length>=2 && ref_ptr[0]=='-' && ref_ptr[1]=='-' -> long-flag; length==2 && ref_ptr[0]=='-' -> short-flag; else positional. Long-flag: linear scan FlagSpec records comparing long_len u8 at [spec+7] and long_name bytes at [spec+8..]; UNKNOWN_FLAG on miss; if flags u16 at [spec+4] has bit 0 (TAKES_VALUE), i += 1, check i < arg_count (FLAG_NO_VALUE), load next ArgDesc, call _afs_parse_as_type(ref_ptr, length, flag_type_code). Short-flag: scan short_char u8 at [spec+6]; same TAKES_VALUE logic. Positional: if pos_idx >= arg_specs_count && last ArgSpec not VARIADIC -> EXTRA_POS; load ArgSpec[min(pos_idx, variadic_cap)] type_code u8 at [spec+8]; call _afs_parse_as_type; non-OK -> TYPE_MISMATCH; pos_idx += 1 unless already past variadic. After the walk: for each ArgSpec slot in 0..arg_specs_count whose flags u16 at [spec+6] has bit 0 clear (not OPTIONAL) and that was not consumed (pos_idx < this slot), MISSING_REQUIRED. The variadic slot is OPTIONAL by convention (zero or more args acceptable). All cmp immediates fit in imm32. Nested calls to _afs_skip_ws (not used here) / _afs_classify_type (not used here) / _afs_parse_as_type (6-reg clobber) land aligned. No test; no and-imm64; no 2-op imul-r-imm; no multiline let. Labels prefixed afs_ci_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        mov rbx, r8;                           // invocation (immutable)
        mov r13, rdi;                          // args_body (immutable)
        mov r14, rdx;                          // flags_body (immutable)
        mov [rsp + 0], rsi;                    // args_len
        mov [rsp + 8], rcx;                    // flags_len

        // arg_specs_count = args_len / 32.
        mov rax, rsi;
        shr rax, 5;
        mov [rsp + 16], rax;                   // arg_specs_count

        // flag_specs_count = flags_len / 32.
        mov rax, rcx;
        shr rax, 5;
        mov [rsp + 24], rax;                   // flag_specs_count

        xor rax, rax;
        mov [rsp + 32], rax;                   // pad

        xor r12, r12;                          // i = 0
        xor r15, r15;                          // pos_idx = 0

        // ---- Guard: inv_len >= 64 ----------------------------------
        cmp r9, 64;
        jb  afs_ci_bad_inv;

        // ---- Guard: FINS magic at [inv + 0] ------------------------
        xor rax, rax;
        mov_d rax, [rbx + 0];
        mov rcx, 0x534E4946;                   // 'FINS'
        cmp rax, rcx;
        jne afs_ci_bad_inv;

        // ---- Load arg_count u16 at [inv + 4]. ----------------------
        xor rax, rax;
        mov_b rax, [rbx + 5];                  // high byte
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [rbx + 4];                  // low byte
        or  rax, rcx;
        mov rbp, rax;                          // arg_count

        // ---- Guard: inv_len >= 64 + arg_count * 32. ----------------
        mov rax, rbp;
        shl rax, 5;
        add rax, 64;
        cmp rax, r9;
        ja  afs_ci_bad_inv;

        // ============================================================
        // Walk the ArgDesc array.
        // ============================================================
      afs_ci_arg_loop:
        cmp r12, rbp;
        jae afs_ci_arg_done;

        // desc_addr = inv + 64 + i*32.
        mov rcx, r12;
        shl rcx, 5;
        add rcx, 64;
        add rcx, rbx;                          // rcx = desc_addr

        // length = [desc + 4] u32 (zero-ext).
        xor r8, r8;
        mov_d r8, [rcx + 4];                   // r8 = length

        // ref_ptr = [desc + 16] u64.
        mov r9, [rcx + 16];                    // r9 = ref_ptr

        // ---- Classify as long / short / positional. ----------------
        // long: length >= 2 && ref_ptr[0]=='-' && ref_ptr[1]=='-'
        // short: length == 2 && ref_ptr[0]=='-' && !long
        // positional: otherwise

        cmp r8, 2;
        jb  afs_ci_positional;

        // ref_ptr[0]
        xor rax, rax;
        mov_b rax, [r9 + 0];
        cmp rax, 0x2D;                         // '-'
        jne afs_ci_positional;

        // ref_ptr[1]
        xor rax, rax;
        mov_b rax, [r9 + 1];
        cmp rax, 0x2D;                         // '-'
        je  afs_ci_long_flag;

        // short flag path: must be exactly length 2 and ref_ptr[1] is
        // an ASCII letter.
        cmp r8, 2;
        jne afs_ci_syntax_or_pos;              // length != 2 -> treat
                                               // as positional (user
                                               // might type `-foo`).
        // Validate letter class.
        cmp rax, 0x41;
        jb  afs_ci_positional;
        cmp rax, 0x5A;
        jbe afs_ci_short_flag;
        cmp rax, 0x61;
        jb  afs_ci_positional;
        cmp rax, 0x7A;
        ja  afs_ci_positional;
        jmp afs_ci_short_flag;

      afs_ci_syntax_or_pos:
        jmp afs_ci_positional;

        // ============================================================
        // Long-flag path.
        //   rax at entry: the second-byte '-' hit; we already consumed
        //   two '-' bytes. Scan long_name = ref_ptr[2..length).
        // ============================================================
      afs_ci_long_flag:
        // long_name_ptr = ref_ptr + 2; long_name_len = length - 2.
        // Linear scan FlagSpec records.
        mov r10, 0;                            // j (FlagSpec index)
      afs_ci_long_scan:
        cmp r10, [rsp + 24];                   // flag_specs_count
        jae afs_ci_unknown_flag;
        // spec_addr = flags_body + j * 32.
        mov rax, r10;
        shl rax, 5;
        add rax, r14;                          // rax = spec_addr

        // long_len u8 at [spec + 7].
        xor rdx, rdx;
        mov_b rdx, [rax + 7];
        // length - 2 must equal long_len.
        mov rdi, r8;
        sub rdi, 2;
        cmp rdx, rdi;
        jne afs_ci_long_next;

        // Byte-compare: spec[+8+k] vs ref_ptr[2+k] for k in 0..long_len.
        xor rdi, rdi;                          // k = 0
      afs_ci_long_cmp:
        cmp rdi, rdx;
        jae afs_ci_long_hit;
        // src byte: spec[+8+k].
        mov rsi, rax;
        add rsi, 8;
        add rsi, rdi;
        xor rcx, rcx;
        mov_b rcx, [rsi + 0];
        // tgt byte: ref_ptr[2+k].
        mov rsi, r9;
        add rsi, 2;
        add rsi, rdi;
        xor r11, r11;
        mov_b r11, [rsi + 0];
        cmp rcx, r11;
        jne afs_ci_long_next;
        add rdi, 1;
        jmp afs_ci_long_cmp;

      afs_ci_long_next:
        add r10, 1;
        jmp afs_ci_long_scan;

      afs_ci_long_hit:
        // rax = spec_addr. Check TAKES_VALUE.
        xor rdi, rdi;
        mov_b rdi, [rax + 4];                  // flags low byte
        // Bit 0 is TAKES_VALUE.
        mov rcx, rdi;
        shr rcx, 0;
        // Test bit 0 by cmp rdi&1,0 -> we can do cmp rdi,1 after &
        // but we avoid `and`. Use `shr rdi, 1; shl rdi, 1; cmp rdi, orig`?
        // Simplest: cmp rdi, 1 and jump accordingly. Since the only
        // valid bits are 0 (bool), 1 (TAKES_VALUE), 2 (REPEATABLE),
        // 3 (both): bit 0 set iff rdi is odd. Do:
        //   mov rsi, rdi; shr rsi, 1; shl rsi, 1; cmp rsi, rdi; jne has_takes
        mov rsi, rdi;
        shr rsi, 1;
        shl rsi, 1;
        cmp rsi, rdi;
        je  afs_ci_slot_done;                  // bit 0 clear -> bool flag

        // TAKES_VALUE set. Load flag_type_code at [spec + 22] u8.
        xor rdx, rdx;
        mov_b rdx, [rax + 22];

        // Advance i, verify next ArgDesc exists, type-check it.
        add r12, 1;
        cmp r12, rbp;
        jae afs_ci_flag_no_value;

        // Next desc_addr = inv + 64 + i*32.
        mov rcx, r12;
        shl rcx, 5;
        add rcx, 64;
        add rcx, rbx;

        xor r8, r8;
        mov_d r8, [rcx + 4];                   // next length
        mov r9, [rcx + 16];                    // next ref_ptr

        // Call _afs_parse_as_type(r9, r8, rdx).
        mov rdi, r9;
        mov rsi, r8;
        // rdx already = type_code.
        call _afs_parse_as_type;
        cmp rax, 0;
        jne afs_ci_type_mismatch;
        jmp afs_ci_slot_done;

        // ============================================================
        // Short-flag path.
        //   r9[1] = short_char candidate (already loaded in rax at the
        //   entry sentinel).
        // ============================================================
      afs_ci_short_flag:
        // short_char = ref_ptr[1] -> rbp used as arg_count, free from
        // clobber risk. Preserve rax (short_char) into r11.
        mov r11, rax;                          // short_char

        mov r10, 0;                            // j
      afs_ci_short_scan:
        cmp r10, [rsp + 24];                   // flag_specs_count
        jae afs_ci_unknown_flag;
        mov rax, r10;
        shl rax, 5;
        add rax, r14;                          // spec_addr

        xor rcx, rcx;
        mov_b rcx, [rax + 6];                  // short_char u8
        cmp rcx, 0;
        je  afs_ci_short_next;                 // no short form -> skip
        cmp rcx, r11;
        je  afs_ci_short_hit;

      afs_ci_short_next:
        add r10, 1;
        jmp afs_ci_short_scan;

      afs_ci_short_hit:
        // Same TAKES_VALUE handling as long.
        xor rdi, rdi;
        mov_b rdi, [rax + 4];
        mov rsi, rdi;
        shr rsi, 1;
        shl rsi, 1;
        cmp rsi, rdi;
        je  afs_ci_slot_done;

        xor rdx, rdx;
        mov_b rdx, [rax + 22];

        add r12, 1;
        cmp r12, rbp;
        jae afs_ci_flag_no_value;

        mov rcx, r12;
        shl rcx, 5;
        add rcx, 64;
        add rcx, rbx;

        xor r8, r8;
        mov_d r8, [rcx + 4];
        mov r9, [rcx + 16];

        mov rdi, r9;
        mov rsi, r8;
        call _afs_parse_as_type;
        cmp rax, 0;
        jne afs_ci_type_mismatch;
        jmp afs_ci_slot_done;

        // ============================================================
        // Positional path.
        //   r8 = length, r9 = ref_ptr.
        // ============================================================
      afs_ci_positional:
        // target_slot = min(pos_idx, arg_specs_count - 1) but only if
        // the last slot is VARIADIC. Else, pos_idx >= arg_specs_count
        // is EXTRA_POS.
        //
        // Simpler algorithm:
        //   if pos_idx < arg_specs_count:
        //       target_slot = pos_idx
        //       pos_idx += 1
        //   else:
        //       target_slot = arg_specs_count - 1
        //       if ArgSpec[target_slot].flags & VARIADIC == 0:
        //           EXTRA_POS
        //       (don't bump pos_idx; variadic absorbs extra args)

        cmp r15, [rsp + 16];                   // arg_specs_count
        jb  afs_ci_pos_in_range;

        // Overflow case: check if last slot is VARIADIC.
        mov rax, [rsp + 16];
        cmp rax, 0;
        je  afs_ci_extra_pos;                  // no ArgSpecs -> extra
        sub rax, 1;                            // target_slot = count - 1
        // spec_addr = args_body + target_slot * 32.
        shl rax, 5;
        add rax, r13;
        // flags low byte at [spec + 6] (bit 1 = VARIADIC).
        xor rdi, rdi;
        mov_b rdi, [rax + 6];
        // Check bit 1: rdi == 2 or rdi == 3 means bit 1 set.
        cmp rdi, 2;
        je  afs_ci_pos_variadic_match;
        cmp rdi, 3;
        je  afs_ci_pos_variadic_match;
        jmp afs_ci_extra_pos;

      afs_ci_pos_variadic_match:
        // Keep target_slot = count - 1 (already computed in rax up to
        // the shl-add). Recompute spec_addr cleanly.
        mov rax, [rsp + 16];
        sub rax, 1;
        shl rax, 5;
        add rax, r13;
        jmp afs_ci_pos_type_check;

      afs_ci_pos_in_range:
        // target_slot = pos_idx. spec_addr = args_body + pos_idx * 32.
        mov rax, r15;
        shl rax, 5;
        add rax, r13;
        add r15, 1;                            // pos_idx++

      afs_ci_pos_type_check:
        // Load type_code at [spec + 8] u8.
        xor rdx, rdx;
        mov_b rdx, [rax + 8];
        // Call _afs_parse_as_type(ref_ptr=r9, length=r8, type_code=rdx).
        mov rdi, r9;
        mov rsi, r8;
        call _afs_parse_as_type;
        cmp rax, 0;
        jne afs_ci_type_mismatch;

      afs_ci_slot_done:
        add r12, 1;
        jmp afs_ci_arg_loop;

        // ============================================================
        // Post-walk: check all required ArgSpecs have been consumed.
        // ============================================================
      afs_ci_arg_done:
        // For each ArgSpec slot in [pos_idx .. arg_specs_count),
        // require either OPTIONAL (bit 0) or VARIADIC (bit 1).
        mov r10, r15;                          // k = pos_idx
      afs_ci_req_loop:
        cmp r10, [rsp + 16];                   // arg_specs_count
        jae afs_ci_ok;
        // spec_addr = args_body + k * 32.
        mov rax, r10;
        shl rax, 5;
        add rax, r13;
        // flags low byte at [spec + 6].
        xor rdi, rdi;
        mov_b rdi, [rax + 6];
        // OPTIONAL = bit 0; VARIADIC = bit 1. Required if neither
        // bit set -> rdi == 0.
        cmp rdi, 0;
        je  afs_ci_missing_required;
        add r10, 1;
        jmp afs_ci_req_loop;

      afs_ci_ok:
        xor rax, rax;                          // AFS_OK
        jmp afs_ci_epilogue;

      afs_ci_bad_inv:
        mov rax, 0x3C05;                       // AFS_ERR_BAD_INVOCATION
        jmp afs_ci_epilogue;

      afs_ci_type_mismatch:
        mov rax, 0x3C06;                       // AFS_ERR_TYPE_MISMATCH
        jmp afs_ci_epilogue;

      afs_ci_missing_required:
        mov rax, 0x3C07;                       // AFS_ERR_MISSING_REQUIRED
        jmp afs_ci_epilogue;

      afs_ci_unknown_flag:
        mov rax, 0x3C08;                       // AFS_ERR_UNKNOWN_FLAG
        jmp afs_ci_epilogue;

      afs_ci_flag_no_value:
        mov rax, 0x3C09;                       // AFS_ERR_FLAG_NO_VALUE
        jmp afs_ci_epilogue;

      afs_ci_extra_pos:
        mov rax, 0x3C0A;                       // AFS_ERR_EXTRA_POS
        jmp afs_ci_epilogue;

      afs_ci_epilogue:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
