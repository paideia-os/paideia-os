// src/pipeline_lambda.pdx -- libpdx-pds-parser (paideia-os#2680, R224.M6)
//
// PipelineLambda: parser-tier primitive that boxes a lambda value so
// it can flow through a pipeline `|` and be threaded into a filter /
// sort / reduce combinator at parse time. R224.M6 of the lambda-lang
// umbrella (paideia-os#2488).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R224 is the lambda-lang umbrella (paideia-os#2488). R224.M1 landed
// the LambdaLit header (`\x:u64 -> ...`); R224.M2 the ClosureCapture
// list (`[x, y:T, ...]`); R224.M3 the EffectRow (`!{...}`); R224.M4
// the CapRow (`@{...}`); R224.M5 the LetScope frame pool (nested
// `let` / `let rec` / lambda bindings). R224.M6 (THIS module) lands
// the FIRST-CLASS PIPELINE VALUE: a 32-byte PipelineLambda record
// that packs a lambda's four parser-tier handles (literal, closure
// env, effect row, capability row) into a single boxed value and
// drives the three APIs needed to flow it through a pipeline:
//
//     ls | filter { |f| f.size > 1.MB } | sort by { |f| f.size } desc
//
// Scope at M6:
//   * Define the 32-byte PipelineLambda record (`'PLAM'` magic +
//     per-handle u32 pool indices).
//   * Public `_pl_lam_box` -- packs four u32 pool indices into a
//     32-byte PipelineLambda record.
//   * Public `_pl_lam_unbox` -- reads a 32-byte PipelineLambda record
//     and writes its four u32 pool indices (zero-extended to u64)
//     into caller-supplied out slots.
//   * Public `_pl_lam_apply_to_combinator` -- threads a PipelineLambda
//     reference into a FilterOp / SortGroupReduce record so the HM
//     pass (R225) can elaborate the predicate against the boxed
//     lambda rather than re-parsing the body byte span.
//   * Idempotent `_pl_lam_init` boot hook for uniformity with every
//     other pds-parser submodule.
//
// A lambda is a VALUE in the semantic-shell universe: it can be bound
// in a let, stored in a session variable, passed to a combinator
// (`filter`, `sort`, `reduce`), piped through `|`. The parser-tier
// substrate for that semantic reality is a 32-byte record stride --
// the same stride as every other R223 pipeline-stage record and the
// R224.M2 ClosureCapture header -- so a downstream dispatcher that
// walks the mixed stream of pipeline-stage POST-pass records sees
// one uniform 32-byte stride.
//
// Out of scope at M6 (deferred):
//   * M6.1 -- Closure environment materialisation: the PipelineLambda
//     carries a `closure_env_idx` pointing at R224.M2 ClosureCapture;
//     M6 does NOT dereference the pointer. A downstream call site
//     that needs to snapshot the captured bindings (BY_VALUE path for
//     cross-process invocation) walks the ClosureCapture body itself.
//   * M6.2 -- Direct lambda-literal flowthrough (`\x. ... | sort by
//     ...`): raw M6 asks the pipeline-stage parser to emit a
//     LambdaLit record first, then wrap it with `_pl_lam_box` as a
//     separate step. The one-shot `_pl_lam_parse_literal` convenience
//     is M6.2.
//   * M6.3 -- Cross-session serialisation: `_pl_lam_render` /
//     `_pl_lam_recover` for persisting a PipelineLambda across
//     session boundaries (ties into R229.M6 persistent per-user env).
//   * M6.4 -- Rank-restricted propagation: the HM pass (R225.M6)
//     refuses a PipelineLambda whose scheme has rank > 1 at any
//     combinator-consume site. Raw M6 stores the lambda-literal
//     reference verbatim; the rank check is purely a HM-pass concern.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
// PipelineLambda has NO parser-tier grammar of its own at M6 -- it is
// a parser-tier VALUE constructor over pool indices that the HM pass
// (or an earlier call site) has already allocated by parsing a
// LambdaLit header + optional ClosureCapture + optional EffectRow +
// optional CapRow. The three public entry points are therefore:
//
//   build:        _pl_lam_box(lambda_lit_idx, closure_env_idx,
//                             effect_row_idx, cap_row_idx,
//                             out, out_cap)       -> packed_u64
//   decompose:    _pl_lam_unbox(record, record_len,
//                               out_ll, out_cc, out_er, out_cr)
//                                                 -> packed_u64
//   thread into
//   combinator:   _pl_lam_apply_to_combinator(pipelam_record,
//                                             pipelam_len,
//                                             comb_record,
//                                             comb_len)
//                                                 -> packed_u64
//
// =============================================================================
// PIPELINELAMBDA RECORD (32 bytes)
// =============================================================================
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic              u32 = PL_LAM_HEADER_MAGIC ('PLAM'
//                                        little-endian = 0x4D414C50)
//     4      2   flags              u16  bit 0 = PL_LAM_FLAG_CLOSURE
//                                        (set iff closure_env_idx != 0)
//                                        bit 1 = PL_LAM_FLAG_HAS_EFFECT
//                                        (set iff effect_row_idx != 0)
//                                        bit 2 = PL_LAM_FLAG_HAS_CAP
//                                        (set iff cap_row_idx != 0)
//                                        bits 3..15 reserved
//     6      2   reserved           u16  zeroed; reserved for M6.1+
//                                        (rank-restriction marker,
//                                        source-span id, etc.)
//     8      4   lambda_lit_idx     u32  index into R224.M1 LambdaLit
//                                        pool / caller-supplied pool
//                                        (opaque at M6)
//    12      4   closure_env_idx    u32  index into R224.M2 ClosureCapture
//                                        pool (0 if no captures)
//    16      4   effect_row_idx     u32  R224.M3 EffectRow / R225.M2
//                                        RowTypes pool idx (0 if pure)
//    20      4   cap_row_idx        u32  R224.M4 CapRow / R225.M2
//                                        RowTypes pool idx (0 if ambient)
//    24      8   reserved           u64  zeroed; reserved for M6.1+
//                                        (closure-arena ref, source-
//                                        range span, HM scheme id, etc.)
//
//   total: 32 B (PL_LAM_RECORD_BYTES)
//
// Layout note. The parent brief for R224.M6 reads a sketch with four
// u64 slots at 0x08/0x10/0x18/0x20 that totals 40 B. The brief then
// SIMPLIFIES the sketch down to four u32 pool-index slots so the
// record stays at 32 B -- the same stride as every other R223
// pipeline-stage POST-pass record (FilterOp 32 B, SortGroupReduce
// 32 B, ClosureCapture header 32 B). THIS module implements the
// simplified 32-byte layout verbatim. If a future M6.1+ needs a
// u64-wide handle it is placed in the 8-byte `reserved` slot at
// offset 24 without an ABI break (consumers probe via field offsets,
// not sizeof).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _pl_lam_init() -> ()
//
//     Idempotent pure-leaf boot hook. The module carries no `.bss`
//     state at M6 (no label-intern table; no pool); the init exists
//     so the shell's boot sequence can wire a uniform `*_init` entry
//     point across every pds-parser submodule.
//
//   _pl_lam_box(lambda_lit_idx, closure_env_idx,
//               effect_row_idx, cap_row_idx,
//               out, out_cap)                       -> packed_u64
//
//     Packs the four u32 pool indices into a 32-byte PipelineLambda
//     record. Sets the three flag bits (CLOSURE, HAS_EFFECT, HAS_CAP)
//     according to whether each of the three optional idx fields is
//     nonzero. Returns `(bytes_written << 32) | status` with
//     bytes_written = 32 on success, 0 on error.
//
//     Status one of:
//        PL_LAM_OK                          = 0
//        PL_LAM_ERR_OUT_TOO_SMALL           = 0x5001  out_cap < 32
//        PL_LAM_ERR_NULL_RECORD             = 0x5007  out == 0
//        PL_LAM_ERR_BAD_INDEX               = 0x5008  any of the four
//                                                     indices has the
//                                                     high 32 bits set
//                                                     (not a valid u32)
//
//   _pl_lam_unbox(record, record_len,
//                 out_lambda_lit_ref,
//                 out_closure_env_ref,
//                 out_effect_ref,
//                 out_cap_ref)                      -> packed_u64
//
//     Reads a 32-byte PipelineLambda record and writes its four pool
//     indices (zero-extended to u64) into the four caller-supplied
//     out slots. Returns `(32 << 32) | PL_LAM_OK` on success. Any
//     out-ptr may be 0 to skip writing that field (the three
//     caller-opt handles -- closure/effect/cap -- are typically
//     fetched together, but a HM-pass pre-pass that only wants the
//     lambda_lit_ref can pass three zeroes).
//
//     Status one of:
//        PL_LAM_OK                          = 0
//        PL_LAM_ERR_NULL_RECORD             = 0x5007  record == 0
//        PL_LAM_ERR_RECORD_TOO_SMALL        = 0x5003  record_len < 32
//        PL_LAM_ERR_BAD_MAGIC               = 0x5002  magic != 'PLAM'
//
//   _pl_lam_apply_to_combinator(pipelam_record, pipelam_len,
//                               comb_record, comb_len)
//                                                   -> packed_u64
//
//     Threads a PipelineLambda reference into a FilterOp (R223.M3)
//     or SortGroupReduce (R223.M4) combinator record so that the HM
//     pass (R225) uses the boxed lambda as the predicate / key /
//     reducer rather than re-parsing the combinator record's own
//     body byte span.
//
//     Specifically:
//       * Validates the PipelineLambda magic ('PLAM').
//       * Validates the combinator magic is one of 'FILT' (FilterOp),
//         'SORT' / 'GRPS' / 'REDU' (SortGroupReduce).
//       * Reads the PipelineLambda's lambda_lit_idx u32 from offset 8.
//       * Writes that idx into the combinator's reserved tail (last
//         four bytes at offset 28, present in both record shapes).
//       * Sets the combinator's "lambda-sourced" flag bit:
//           FilterOp:            flags u8 at +17, bit 1 (0x02)
//           SortGroupReduce:     flags u8 at +5,  bit 2 (0x04)
//         Both bits sit in slots the parent records explicitly
//         reserved for M3.1+ / M4.1+ follow-ups and are therefore
//         available at raw M6.
//       * Returns `(32 << 32) | PL_LAM_OK` on success; 0 bytes-written
//         on error.
//
//     Status one of:
//        PL_LAM_OK                          = 0
//        PL_LAM_ERR_NULL_RECORD             = 0x5007  either ptr == 0
//        PL_LAM_ERR_RECORD_TOO_SMALL        = 0x5003  pipelam_len < 32
//        PL_LAM_ERR_COMBINATOR_TOO_SMALL    = 0x5006  comb_len < 32
//        PL_LAM_ERR_BAD_MAGIC               = 0x5002  pipelam magic
//                                                     mismatch
//        PL_LAM_ERR_BAD_COMBINATOR          = 0x5005  comb magic not
//                                                     in {FILT, SORT,
//                                                     GRPS, REDU}
//
//   Register map (SysV):
//
//     _pl_lam_box(rdi, rsi, rdx, rcx, r8, r9) -> rax
//        rdi = lambda_lit_idx u32  (low 32 bits used; high 32 must be 0)
//        rsi = closure_env_idx u32
//        rdx = effect_row_idx u32
//        rcx = cap_row_idx u32
//        r8  = out
//        r9  = out_cap
//        rax = (bytes_written << 32) | status
//
//     _pl_lam_unbox(rdi, rsi, rdx, rcx, r8, r9) -> rax
//        rdi = record_ptr
//        rsi = record_len
//        rdx = out_lambda_lit_ref u64*
//        rcx = out_closure_env_ref u64*
//        r8  = out_effect_ref u64*
//        r9  = out_cap_ref u64*
//        rax = (bytes_written << 32) | status
//
//     _pl_lam_apply_to_combinator(rdi, rsi, rdx, rcx) -> rax
//        rdi = pipelam_record
//        rsi = pipelam_len
//        rdx = combinator_record
//        rcx = combinator_len
//        rax = (bytes_written << 32) | status
//
// =============================================================================
// RETURN CODES
// =============================================================================
//
//   PL_LAM_OK                        = 0
//   PL_LAM_ERR_SYNTAX                = 0x5000  reserved; general
//                                              grammar fault for a
//                                              future `_pl_lam_parse_
//                                              literal` M6.2 landing.
//   PL_LAM_ERR_OUT_TOO_SMALL         = 0x5001  box: out_cap < 32.
//   PL_LAM_ERR_BAD_MAGIC             = 0x5002  unbox/apply: PipelineLambda
//                                              magic != 'PLAM'.
//   PL_LAM_ERR_RECORD_TOO_SMALL      = 0x5003  unbox/apply: record_len
//                                              < 32.
//   PL_LAM_ERR_NULL_OUT              = 0x5004  reserved for a future
//                                              strict unbox mode that
//                                              refuses null out slots.
//   PL_LAM_ERR_BAD_COMBINATOR        = 0x5005  apply: combinator magic
//                                              not in {FILT, SORT,
//                                              GRPS, REDU}.
//   PL_LAM_ERR_COMBINATOR_TOO_SMALL  = 0x5006  apply: comb_len < 32.
//   PL_LAM_ERR_NULL_RECORD           = 0x5007  box/unbox/apply: a
//                                              required record pointer
//                                              is 0.
//   PL_LAM_ERR_BAD_INDEX             = 0x5008  box: any of the four
//                                              pool indices has the
//                                              high 32 bits set.
//
// `bytes_written` is 32 on success for all three entry points; 0 on
// error (caller ignores the top 32 bits).
//
// =============================================================================
// STATUS-CODE NAMESPACE
// =============================================================================
//
// PL_LAM_* codes live in 0x5000..0x50FF, carved on a kilo-step
// boundary past Wave 125's R229.M4 JobControl band (0x4E00..0x4EFF)
// and past the parallel R222.M8 band (0x4F00..0x4FFF, reserved for
// the Wave 125 sibling arm). The 0x5000 slice is the next unused
// 256-slot slice above those two bands and is disjoint from every
// other user-space packed-status range in the paideia-os tree.
//
// Grep confirmation at R224.M6 landing time:
//   grep -rE '0x50[0-9A-F]{2}' tools/user/libpdx-pds-parser/
//     -> prior hits: `CC_HEADER_MAGIC = 0x50414343` ('CCAP' FourCC in
//        closure_capture.pdx; a magic cookie, NOT a packed-status
//        code) -- disjoint semantic namespace.
//   grep -rE '0x500[0-8]\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/lambda-as-pipeline-value.md.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  not touched by this module. The pool
//     indices are already caller-elaborated at the point of `_pl_lam_
//     box`; no byte walking occurs here.
//
//   R221.M4 (CtxLexer)  --  not touched. The pipeline-level `|`
//     partitioning that lets a PipelineLambda flow between stages is
//     the OUTER lexer's responsibility; this module operates on a
//     single stage's already-parsed handles.
//
//   R223.M1 (Pipeline)  --  this module does NOT call `_pl_parse`;
//     the stage dispatcher that routes a lambda-shaped stage argv to
//     the parser handles that routing one tier up. PipelineLambda is
//     downstream of Pipeline, not peered with it.
//
//   R223.M3 (FilterOp)  --  `_pl_lam_apply_to_combinator` writes the
//     boxed lambda's `lambda_lit_idx` into the FilterOp record's
//     reserved tail (bytes 28..32) and sets the "lambda-sourced"
//     flag bit (`flags u8 at +17`, bit 1). The FilterOp record stays
//     valid under both the pre-R224.M6 (byte-span-only) and
//     post-R224.M6 (boxed-lambda) interpretations because the body
//     span at offset 8 is left untouched.
//
//   R223.M4 (SortGroupReduce)  --  dual to FilterOp. The lambda
//     idx goes into bytes 28..32 and the lambda-sourced flag bit is
//     bit 2 of `flags u8 at +5` (bits 0 and 1 are the pre-existing
//     DESC and HAS_SEED bits). The predicate_span u64 at offset 8
//     (and the seed_span u64 at offset 16 for REDUCE) stay intact.
//
//   R224.M1 (LambdaLit)  --  this module stores a `lambda_lit_idx`
//     u32 as an opaque payload. It does NOT dereference it. The
//     downstream HM pass that elaborates the PipelineLambda uses the
//     idx to look up the stored LambdaHeader + Param descriptors.
//
//   R224.M2 (ClosureCapture)  --  this module stores a
//     `closure_env_idx` u32 as an opaque payload. The HM pass /
//     eval-time dispatcher that reifies the lambda across a process
//     boundary walks the ClosureCapture body itself.
//
//   R224.M3 (EffectRow)  --  this module stores an `effect_row_idx`
//     u32 as an opaque payload. The row-pool interpretation (RowTypes
//     pool idx at R225.M2) is the HM pass's responsibility; this
//     module simply flows the idx through.
//
//   R224.M4 (CapRow)  --  dual to EffectRow. The `cap_row_idx` u32
//     is stored opaquely; the HM pass / cap-check pass interprets.
//
//   R224.M5 (LetScope)  --  not touched. The scope frames that back a
//     lambda's enclosing `let` bindings live in LetScope's `.bss`
//     pool; a PipelineLambda carries only the lambda's own handles,
//     not the enclosing frame cursor. A HM-pass that type-checks a
//     PipelineLambda consumer walks the LetScope chain through the
//     lambda_lit_idx -> LambdaLit record's own binding list, not
//     through this record.
//
//   R225 (HM typechecker)  --  the HM pass instantiates a
//     PipelineLambda-consuming combinator at:
//       * FilterOp:        `fn (Record) -> bool`
//       * SortGroupReduce SORT:  `fn (Record) -> Comparable`
//       * SortGroupReduce GROUP: `fn (Record) -> Hashable`
//       * SortGroupReduce REDUCE: `fn (A, Record) -> A` with seed `A`
//     and unifies the lambda's inferred type (via `lambda_lit_idx`)
//     against the combinator's expected shape.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- no stride-indexed array arithmetic
//     (the record is a single 32-byte write; four scalar u32 writes
//     at known displacements).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `PipelineLambda` matches `pipeline_lambda.pdx`.
//   - Public symbols prefixed `_pl_lam_*` (entry points); internal
//     labels prefixed `pl_lam_*`. The `pl_lam_` prefix is DISJOINT
//     from pipeline.pdx's `pl_` prefix (two extra bytes: `lam_`), so
//     grep over the library source produces no label collision; it
//     is also disjoint from every sibling satellite's prefix
//     (`u8n_`, `gi_`, `wp_`, `cl_`, `ast_`, `sm_`, `sch_sig_`,
//     `cmd_sig_`, `fi_`, `afs_`, `cmdreg_`, `dm_`, `pl_`, `rp_`,
//     `fo_`, `sgr_`, `ll_`, `cc_`, `er_`, `cr_`, `ls_`, `hm_`,
//     `rt_`, `dl_`, `se_`, `te_`, `eu_`, `fh_`, `jc_`) and disjoint
//     from paideia-as reserved keywords (`loop`, `if`, `let`, `fn`,
//     `ret`, `done`, etc.).
//   - All `cmp reg, imm` immediates (32, u32-high-bits mask check,
//     status codes 0x5001..0x5008, magic u32s) fit in imm32 with
//     bit 31 clear so direct `cmp reg, imm32` is sign-extension-safe.
//     The four combinator magic FourCCs (0x544C4946, 0x54524F53,
//     0x53505247, 0x55444552) and the PipelineLambda magic
//     (0x4D414C50) all fit in imm32 with bit 31 clear.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     with explicit *1 scale (U1606 mitigation precedent).
//   - Byte stores via `mov_b [dst + imm_disp], reg` with constant
//     displacement only.
//   - u32 loads via `xor rax, rax; mov_d rax, [base + imm_disp]`
//     (zero-extends into the full qword, so the subsequent `cmp`
//     against an imm32 magic is sign-safe).
//   - u32 stores via `mov_d [dst + imm_disp], reg` (precedent:
//     FilterOp magic write).
//   - u64 zero-fill of the 32-byte record uses four `mov [dst +
//     disp], rax` with rax = 0, covering the full stride.
//   - High-32-bits-of-u32-arg validation uses `mov r, imm32;
//     shl r, 32; and-less compare` via a `shr` reduction: specifically
//     `mov rax, arg; shr rax, 32; cmp rax, 0; jne err` (shr by imm8 is
//     always available).
//   - OR-into-byte for the "lambda-sourced" flag bit uses load-op-store
//     via staging register: `xor rax, rax; mov_b rax, [dst + disp];
//     or rax, imm8; mov_b [dst + disp], rax` (precedent: closure_
//     capture.pdx any_by_value flag updates).
//   - `_pl_lam_init`, `_pl_lam_box`, `_pl_lam_unbox`, `_pl_lam_apply_
//     to_combinator` are PURE LEAVES: zero callee-save push, zero
//     stack frame, zero nested CALL. The four public entry points
//     operate entirely on the SysV scratch set (rax, rcx, rdx, rsi,
//     rdi, r8, r9, r10, r11); none of the computations needs a
//     register to survive a CALL because there is no CALL.
//   - r11 is used as the OR-into-byte staging register freely because
//     no nested CALL exists in this module.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R224.M6.1  Closure environment materialisation helper that walks
//              the stored `closure_env_idx` and emits the
//              Serializable Binding array for cross-process invocation.
//   R224.M6.2  One-shot `_pl_lam_parse_literal` convenience: parses a
//              bytes-span of lambda-literal source, allocates the
//              LambdaLit + ClosureCapture handles, and returns a
//              fully-boxed PipelineLambda in one call.
//   R224.M6.3  Cross-session serialisation `_pl_lam_render` /
//              `_pl_lam_recover` (ties into R229.M6 persistent env).
//   R224.M6.4  Rank-restriction propagation (dual with R225.M6).
//   R225.M3    HM-time elaboration: `_hm_check_pipelam_consumer`
//              instantiates the PipelineLambda's declared scheme and
//              unifies against the consuming combinator's expected
//              shape.
//
// =============================================================================
// Upstream: paideia-os#2488 (R224 umbrella), paideia-os#2680 (THIS
// ticket, R224.M6). Substrate: paideia-os#2675 (R224.M1 LambdaLit),
// paideia-os#2676 (R224.M2 ClosureCapture), paideia-os#2677 (R224.M3
// EffectRow), paideia-os#2678 (R224.M4 CapRow), paideia-os#2668
// (R223.M3 FilterOp -- destination record shape), paideia-os#2669
// (R223.M4 SortGroupReduce -- destination record shape).
// Design doc: design/shell/lambda-as-pipeline-value.md.

module PipelineLambda = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let PL_LAM_OK                        : u64 = 0
  pub let PL_LAM_ERR_SYNTAX                : u64 = 0x5000
  pub let PL_LAM_ERR_OUT_TOO_SMALL         : u64 = 0x5001
  pub let PL_LAM_ERR_BAD_MAGIC             : u64 = 0x5002
  pub let PL_LAM_ERR_RECORD_TOO_SMALL      : u64 = 0x5003
  pub let PL_LAM_ERR_NULL_OUT              : u64 = 0x5004
  pub let PL_LAM_ERR_BAD_COMBINATOR        : u64 = 0x5005
  pub let PL_LAM_ERR_COMBINATOR_TOO_SMALL  : u64 = 0x5006
  pub let PL_LAM_ERR_NULL_RECORD           : u64 = 0x5007
  pub let PL_LAM_ERR_BAD_INDEX             : u64 = 0x5008

  // ==========================================================================
  // SECTION 2 -- FLAG / LAYOUT CONSTANTS
  // ==========================================================================

  pub let PL_LAM_FLAG_CLOSURE              : u64 = 0x01
  pub let PL_LAM_FLAG_HAS_EFFECT           : u64 = 0x02
  pub let PL_LAM_FLAG_HAS_CAP              : u64 = 0x04

  pub let PL_LAM_RECORD_BYTES              : u64 = 32

  // PipelineLambda magic FourCC: 'PLAM' little-endian u32.
  //   byte 0 'P' = 0x50, byte 1 'L' = 0x4C, byte 2 'A' = 0x41,
  //   byte 3 'M' = 0x4D.  LE u32 = 0x4D414C50.
  pub let PL_LAM_HEADER_MAGIC              : u64 = 0x4D414C50

  // Combinator magic FourCCs (destination records; mirrors values in
  // filter_op.pdx and sort_group_reduce.pdx).
  pub let PL_LAM_COMB_MAGIC_FILT           : u64 = 0x544C4946  // 'FILT' LE
  pub let PL_LAM_COMB_MAGIC_SORT           : u64 = 0x54524F53  // 'SORT' LE
  pub let PL_LAM_COMB_MAGIC_GROUP          : u64 = 0x53505247  // 'GRPS' LE
  pub let PL_LAM_COMB_MAGIC_REDUCE         : u64 = 0x55444552  // 'REDU' LE

  // Record field offsets (bytes, from record base).
  pub let PL_LAM_OFF_MAGIC                 : u64 = 0
  pub let PL_LAM_OFF_FLAGS                 : u64 = 4
  pub let PL_LAM_OFF_RESERVED_1            : u64 = 6
  pub let PL_LAM_OFF_LAMBDA_LIT_IDX        : u64 = 8
  pub let PL_LAM_OFF_CLOSURE_ENV_IDX       : u64 = 12
  pub let PL_LAM_OFF_EFFECT_ROW_IDX        : u64 = 16
  pub let PL_LAM_OFF_CAP_ROW_IDX           : u64 = 20
  pub let PL_LAM_OFF_RESERVED_2            : u64 = 24

  // Combinator-side poke targets. Both FilterOp and SortGroupReduce
  // records reserve the last 4 bytes of their 32-byte stride; we poke
  // the PipelineLambda's lambda_lit_idx u32 at [combinator + 28] in
  // both cases. The lambda-sourced flag bit lives in each record's
  // flags byte at the record-specific displacement.
  pub let PL_LAM_COMB_OFF_LAMBDA_IDX       : u64 = 28
  pub let PL_LAM_FO_FLAGS_OFF              : u64 = 17   // FilterOp flags u8
  pub let PL_LAM_SGR_FLAGS_OFF             : u64 = 5    // SortGroupReduce flags u8
  pub let PL_LAM_FO_FLAG_LAMBDA_SOURCED    : u64 = 0x02 // FilterOp bit 1
  pub let PL_LAM_SGR_FLAG_LAMBDA_SOURCED   : u64 = 0x04 // SortGroupReduce bit 2

  // ==========================================================================
  // _pl_lam_init() -> ()
  //
  // Idempotent pure-leaf boot hook. No `.bss` state at M6.
  //
  // Pure leaf; no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pl_lam_ini_.
  // ==========================================================================
  pub let _pl_lam_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M6 (#2680): _pl_lam_init idempotent boot hook. No `.bss` state at M6 so the body is a bare `ret`. Pure leaf; zero pushes, zero stack frame, zero nested CALL. The entry exists so the shell's uniform `*_init` wiring across every pds-parser submodule (precedent: _fo_init at R223.M3, _sgr_init at R223.M4, _rp_init at R223.M2, _ast_init at R221.M5, _sm_init at R221.M6, _dm_init at R222.M6, _cmdreg_init at R222.M5, _er_init at R224.M3, _cr_init at R224.M4, _ls_init at R224.M5, _jc_init at R229.M4) does not special-case PipelineLambda. A future M6.1 that adds a parse-count counter or a closure-arena next-cursor in `.bss` populates this body with the lazy-populate shape; no ABI change. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pl_lam_ini_.",
      block: {
      pl_lam_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _pl_lam_box(lambda_lit_idx, closure_env_idx, effect_row_idx,
  //             cap_row_idx, out, out_cap) -> packed_u64
  //
  //   rdi = lambda_lit_idx    (u32; high 32 bits must be 0)
  //   rsi = closure_env_idx   (u32; high 32 bits must be 0)
  //   rdx = effect_row_idx    (u32; high 32 bits must be 0)
  //   rcx = cap_row_idx       (u32; high 32 bits must be 0)
  //   r8  = out               (destination record ptr)
  //   r9  = out_cap           (destination capacity bytes)
  //   rax = (bytes_written << 32) | status
  //
  // Packs the four u32 pool indices into a 32-byte PipelineLambda
  // record at `out`. Sets flag bits CLOSURE / HAS_EFFECT / HAS_CAP
  // according to whether each of the three optional idx fields is
  // nonzero. Zero-fills the 32-byte record first so the reserved
  // slots and the high half of flags u16 come out zero without
  // explicit per-byte writes.
  //
  // Pure leaf: no callee-save push, no stack frame, no nested CALL.
  // All computations fit in the SysV scratch set. Labels prefixed
  // pl_lam_bx_.
  // ==========================================================================
  pub let _pl_lam_box : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (lambda_lit_idx: u64) (closure_env_idx: u64)
       (effect_row_idx: u64) (cap_row_idx: u64)
       (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M6 (#2680): pack four u32 pool indices into a 32-byte PipelineLambda record at `out`. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL (all computations fit in the SysV caller-save set rax/rcx/rdx/rsi/rdi/r8/r9/r10/r11). Flow: validate out != 0 (NULL_RECORD); validate out_cap >= 32 (OUT_TOO_SMALL); validate each of the four indices fits in u32 (high 32 bits == 0) via `mov rax, arg; shr rax, 32; cmp rax, 0; jne err_bad_index` (BAD_INDEX if any slot overflows). Zero-fill the 32-byte record via four `mov [r8 + disp], rax` with rax=0. Write magic u32 ('PLAM' 0x4D414C50 LE) at [r8+0] via mov_d. Compute flags u16: start with 0; if closure_env_idx != 0 OR with 0x01; if effect_row_idx != 0 OR with 0x02; if cap_row_idx != 0 OR with 0x04. Write flags u16 at [r8+4] via two mov_b (low from the computed value, high byte 0). Write four u32 indices at the four 4-byte offsets 8/12/16/20 via mov_d. The 8-byte reserved slot at offset 24 is already zero from the zero-fill. Pack return: mov rax, 32; shl rax, 32; return (32 << 32) | PL_LAM_OK (0, so no OR needed). All cmp immediates (0, 32, status codes 0x5001..0x5008, magic u32 0x4D414C50, flag masks 0x01..0x04) fit in imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pl_lam_bx_.",
      block: {
        // out == 0 guard.
        cmp r8, 0;
        je  pl_lam_bx_err_null;

        // out_cap >= 32 guard.
        cmp r9, 32;                              // PL_LAM_RECORD_BYTES
        jb  pl_lam_bx_err_oos;

        // Validate high 32 bits of each u32 idx == 0.
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne pl_lam_bx_err_bad_index;

        mov rax, rsi;
        shr rax, 32;
        cmp rax, 0;
        jne pl_lam_bx_err_bad_index;

        mov rax, rdx;
        shr rax, 32;
        cmp rax, 0;
        jne pl_lam_bx_err_bad_index;

        mov rax, rcx;
        shr rax, 32;
        cmp rax, 0;
        jne pl_lam_bx_err_bad_index;

        // Zero-fill the 32-byte record (four u64 stores).
        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

        // Write magic u32 ('PLAM' LE 0x4D414C50) at [r8 + 0].
        mov rax, 0x4D414C50;                     // PL_LAM_HEADER_MAGIC
        mov_d [r8 + 0], rax;

        // Compute flags u16 low byte in r10.
        xor r10, r10;

        // bit 0 (CLOSURE) set iff closure_env_idx != 0.
        cmp rsi, 0;
        je  pl_lam_bx_flag_check_effect;
        or  r10, 0x01;                           // PL_LAM_FLAG_CLOSURE
      pl_lam_bx_flag_check_effect:
        // bit 1 (HAS_EFFECT) set iff effect_row_idx != 0.
        cmp rdx, 0;
        je  pl_lam_bx_flag_check_cap;
        or  r10, 0x02;                           // PL_LAM_FLAG_HAS_EFFECT
      pl_lam_bx_flag_check_cap:
        // bit 2 (HAS_CAP) set iff cap_row_idx != 0.
        cmp rcx, 0;
        je  pl_lam_bx_flag_write;
        or  r10, 0x04;                           // PL_LAM_FLAG_HAS_CAP

      pl_lam_bx_flag_write:
        // Write flags u16 at [r8 + 4]: low byte = r10, high byte = 0.
        mov rax, r10;
        mov_b [r8 + 4], rax;
        xor rax, rax;
        mov_b [r8 + 5], rax;

        // Reserved u16 at [r8 + 6] already zero from the zero-fill.

        // Write four u32 pool indices.
        mov rax, rdi;
        mov_d [r8 + 8], rax;                     // lambda_lit_idx
        mov rax, rsi;
        mov_d [r8 + 12], rax;                    // closure_env_idx
        mov rax, rdx;
        mov_d [r8 + 16], rax;                    // effect_row_idx
        mov rax, rcx;
        mov_d [r8 + 20], rax;                    // cap_row_idx

        // Reserved u64 at [r8 + 24] already zero from the zero-fill.

        // Pack return: (32 << 32) | PL_LAM_OK.
        mov rax, 32;
        shl rax, 32;
        ret;

      pl_lam_bx_err_null:
        mov rax, 0x5007;                         // PL_LAM_ERR_NULL_RECORD
        ret;

      pl_lam_bx_err_oos:
        mov rax, 0x5001;                         // PL_LAM_ERR_OUT_TOO_SMALL
        ret;

      pl_lam_bx_err_bad_index:
        mov rax, 0x5008;                         // PL_LAM_ERR_BAD_INDEX
        ret;
      }
    }

  // ==========================================================================
  // _pl_lam_unbox(record, record_len,
  //               out_lambda_lit_ref,
  //               out_closure_env_ref,
  //               out_effect_ref,
  //               out_cap_ref) -> packed_u64
  //
  //   rdi = record_ptr
  //   rsi = record_len
  //   rdx = out_lambda_lit_ref  (u64 *; 0 to skip)
  //   rcx = out_closure_env_ref (u64 *; 0 to skip)
  //   r8  = out_effect_ref      (u64 *; 0 to skip)
  //   r9  = out_cap_ref         (u64 *; 0 to skip)
  //   rax = (bytes_written << 32) | status
  //
  // Reads a 32-byte PipelineLambda record and writes its four u32
  // pool indices (zero-extended to u64) into the four caller-
  // supplied out slots. Any out-ptr may be 0 to skip writing that
  // field, so a HM-pass pre-pass that only wants the lambda-literal
  // handle can pass three zeroes for the remaining slots.
  //
  // Pure leaf: no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pl_lam_ux_.
  // ==========================================================================
  pub let _pl_lam_unbox : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (record_len: u64)
       (out_ll: u64) (out_cc: u64)
       (out_er: u64) (out_cr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M6 (#2680): read a 32-byte PipelineLambda record and write its four u32 pool indices (zero-extended to u64) into the four caller-supplied out slots. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate record_ptr != 0 (NULL_RECORD); validate record_len >= 32 (RECORD_TOO_SMALL); read magic u32 at [rdi+0] (zero-extended via `xor rax,rax; mov_d rax,[rdi+0]`) and verify == PL_LAM_HEADER_MAGIC (0x4D414C50 LE); on mismatch return BAD_MAGIC. Then for each of the four out-ptrs (rdx, rcx, r8, r9) that is nonzero, read the matching u32 at the corresponding record offset (8/12/16/20) and store as u64 into [out-ptr+0]. Each out-ptr == 0 is a legitimate skip (not an error at raw M6; PL_LAM_ERR_NULL_OUT is reserved for a future strict-mode variant). Pack return: (32 << 32) | PL_LAM_OK. All cmp immediates (0, 32, magic 0x4D414C50, status codes 0x5002/0x5003/0x5007) fit imm32 with bit 31 clear. Byte / u32 loads zero-extend via xor-and-mov pattern so subsequent cmp against imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pl_lam_ux_.",
      block: {
        // record_ptr == 0 guard.
        cmp rdi, 0;
        je  pl_lam_ux_err_null;

        // record_len >= 32 guard.
        cmp rsi, 32;                             // PL_LAM_RECORD_BYTES
        jb  pl_lam_ux_err_rec_too_small;

        // Read magic u32 at [rdi + 0] into rax (zero-extended).
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x4D414C50;                     // PL_LAM_HEADER_MAGIC
        jne pl_lam_ux_err_bad_magic;

        // out_lambda_lit_ref (rdx).
        cmp rdx, 0;
        je  pl_lam_ux_skip_ll;
        xor rax, rax;
        mov_d rax, [rdi + 8];
        mov [rdx + 0], rax;
      pl_lam_ux_skip_ll:

        // out_closure_env_ref (rcx).
        cmp rcx, 0;
        je  pl_lam_ux_skip_cc;
        xor rax, rax;
        mov_d rax, [rdi + 12];
        mov [rcx + 0], rax;
      pl_lam_ux_skip_cc:

        // out_effect_ref (r8).
        cmp r8, 0;
        je  pl_lam_ux_skip_er;
        xor rax, rax;
        mov_d rax, [rdi + 16];
        mov [r8 + 0], rax;
      pl_lam_ux_skip_er:

        // out_cap_ref (r9).
        cmp r9, 0;
        je  pl_lam_ux_skip_cr;
        xor rax, rax;
        mov_d rax, [rdi + 20];
        mov [r9 + 0], rax;
      pl_lam_ux_skip_cr:

        // Pack return: (32 << 32) | PL_LAM_OK.
        mov rax, 32;
        shl rax, 32;
        ret;

      pl_lam_ux_err_null:
        mov rax, 0x5007;                         // PL_LAM_ERR_NULL_RECORD
        ret;

      pl_lam_ux_err_rec_too_small:
        mov rax, 0x5003;                         // PL_LAM_ERR_RECORD_TOO_SMALL
        ret;

      pl_lam_ux_err_bad_magic:
        mov rax, 0x5002;                         // PL_LAM_ERR_BAD_MAGIC
        ret;
      }
    }

  // ==========================================================================
  // _pl_lam_apply_to_combinator(pipelam_record, pipelam_len,
  //                             comb_record, comb_len) -> packed_u64
  //
  //   rdi = pipelam_record
  //   rsi = pipelam_len
  //   rdx = comb_record
  //   rcx = comb_len
  //   rax = (bytes_written << 32) | status
  //
  // Threads a PipelineLambda reference into a FilterOp (R223.M3) or
  // SortGroupReduce (R223.M4) combinator record. The combinator
  // record is modified IN PLACE:
  //   * The PipelineLambda's lambda_lit_idx u32 is written at
  //     [comb_record + 28] (last 4 bytes of the reserved tail, which
  //     is zero in both FilterOp and SortGroupReduce at parse time).
  //   * A "lambda-sourced predicate" flag bit is set in the
  //     combinator's flags byte:
  //       FilterOp:            flags u8 at +17, bit 1 (0x02).
  //       SortGroupReduce:     flags u8 at +5,  bit 2 (0x04).
  //
  // Returns `(32 << 32) | PL_LAM_OK` on success; 0 bytes-written on
  // error.
  //
  // Pure leaf: no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pl_lam_ap_.
  // ==========================================================================
  pub let _pl_lam_apply_to_combinator : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (pipelam_record: u64) (pipelam_len: u64)
       (comb_record: u64) (comb_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M6 (#2680): thread a PipelineLambda reference into a FilterOp (R223.M3) or SortGroupReduce (R223.M4) combinator record. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate both record pointers != 0 (NULL_RECORD); validate pipelam_len >= 32 (RECORD_TOO_SMALL); validate comb_len >= 32 (COMBINATOR_TOO_SMALL); read pipelam magic at [rdi+0] (zero-extended via `xor rax,rax; mov_d rax,[rdi+0]`); verify == PL_LAM_HEADER_MAGIC (0x4D414C50); on mismatch BAD_MAGIC. Read combinator magic at [rdx+0] (zero-extended u32); dispatch on magic: FILT (0x544C4946) -> FilterOp path; SORT (0x54524F53) OR GRPS (0x53505247) OR REDU (0x55444552) -> SortGroupReduce path; else BAD_COMBINATOR. Read PipelineLambda's lambda_lit_idx u32 at [rdi+8] (zero-extended). FilterOp path: store the idx u32 at [rdx+28] via mov_d; OR flag bit 0x02 into [rdx+17] via load-op-store (`xor rax,rax; mov_b rax,[rdx+17]; or rax,0x02; mov_b [rdx+17],rax`; r11 free as staging because no nested CALL exists). SortGroupReduce path: store the idx u32 at [rdx+28]; OR flag bit 0x04 into [rdx+5]. Pack return: (32 << 32) | PL_LAM_OK. All cmp immediates (0, 32, magic u32s 0x4D414C50/0x544C4946/0x54524F53/0x53505247/0x55444552, flag bits 0x02/0x04, status codes 0x5002/0x5003/0x5005/0x5006/0x5007) fit imm32 with bit 31 clear. u32 loads zero-extend via xor+mov_d so cmp against imm32 is sign-safe. OR-into-byte uses imm8 flag mask (always fits in `or r64, imm8`). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pl_lam_ap_.",
      block: {
        // pipelam_record == 0 guard.
        cmp rdi, 0;
        je  pl_lam_ap_err_null;

        // comb_record == 0 guard.
        cmp rdx, 0;
        je  pl_lam_ap_err_null;

        // pipelam_len >= 32 guard.
        cmp rsi, 32;                             // PL_LAM_RECORD_BYTES
        jb  pl_lam_ap_err_rec_too_small;

        // comb_len >= 32 guard.
        cmp rcx, 32;
        jb  pl_lam_ap_err_comb_too_small;

        // Verify PipelineLambda magic ('PLAM' 0x4D414C50 LE) at [rdi+0].
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x4D414C50;                     // PL_LAM_HEADER_MAGIC
        jne pl_lam_ap_err_bad_magic;

        // Read combinator magic u32 at [rdx + 0] into rax.
        xor rax, rax;
        mov_d rax, [rdx + 0];

        // Dispatch on combinator magic. Each of the four FourCCs
        // fits in imm32 with bit 31 clear, so direct `cmp reg,
        // imm32` is sign-extension-safe.
        cmp rax, 0x544C4946;                     // 'FILT' LE
        je  pl_lam_ap_filt_path;
        cmp rax, 0x54524F53;                     // 'SORT' LE
        je  pl_lam_ap_sgr_path;
        cmp rax, 0x53505247;                     // 'GRPS' LE
        je  pl_lam_ap_sgr_path;
        cmp rax, 0x55444552;                     // 'REDU' LE
        je  pl_lam_ap_sgr_path;

        jmp pl_lam_ap_err_bad_comb;

        // ------------------------------------------------------------
        // FilterOp path: poke idx at +28; OR flag bit 0x02 at +17.
        // ------------------------------------------------------------
      pl_lam_ap_filt_path:
        // Read PipelineLambda's lambda_lit_idx u32 at [rdi + 8].
        xor rax, rax;
        mov_d rax, [rdi + 8];

        // Write at [rdx + 28].
        mov_d [rdx + 28], rax;

        // OR flag bit 0x02 into [rdx + 17] via load-op-store.
        xor rax, rax;
        mov_b rax, [rdx + 17];
        or  rax, 0x02;                           // PL_LAM_FO_FLAG_LAMBDA_SOURCED
        mov_b [rdx + 17], rax;

        jmp pl_lam_ap_done;

        // ------------------------------------------------------------
        // SortGroupReduce path: poke idx at +28; OR flag bit 0x04 at +5.
        // ------------------------------------------------------------
      pl_lam_ap_sgr_path:
        // Read PipelineLambda's lambda_lit_idx u32 at [rdi + 8].
        xor rax, rax;
        mov_d rax, [rdi + 8];

        // Write at [rdx + 28].
        mov_d [rdx + 28], rax;

        // OR flag bit 0x04 into [rdx + 5] via load-op-store.
        xor rax, rax;
        mov_b rax, [rdx + 5];
        or  rax, 0x04;                           // PL_LAM_SGR_FLAG_LAMBDA_SOURCED
        mov_b [rdx + 5], rax;

        jmp pl_lam_ap_done;

      pl_lam_ap_done:
        // Pack return: (32 << 32) | PL_LAM_OK.
        mov rax, 32;
        shl rax, 32;
        ret;

      pl_lam_ap_err_null:
        mov rax, 0x5007;                         // PL_LAM_ERR_NULL_RECORD
        ret;

      pl_lam_ap_err_rec_too_small:
        mov rax, 0x5003;                         // PL_LAM_ERR_RECORD_TOO_SMALL
        ret;

      pl_lam_ap_err_comb_too_small:
        mov rax, 0x5006;                         // PL_LAM_ERR_COMBINATOR_TOO_SMALL
        ret;

      pl_lam_ap_err_bad_magic:
        mov rax, 0x5002;                         // PL_LAM_ERR_BAD_MAGIC
        ret;

      pl_lam_ap_err_bad_comb:
        mov rax, 0x5005;                         // PL_LAM_ERR_BAD_COMBINATOR
        ret;
      }
    }

}
