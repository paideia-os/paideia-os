// src/session_type.pdx -- libpdx-pds-parser.R223.M7 (paideia-os#2672)
//
// SessionType: parser-tier session-typed edge protocol enforcement for
// pipeline-lang stage graphs. R223.M7 of the pipeline-lang umbrella
// (paideia-os#2487).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R223.M1 (pipeline.pdx) lands the pipeline stage parser + `|`. R223.M2
// (record_projection.pdx) lands `select` / `project`. R223.M3
// (filter_op.pdx) lands `where` / `filter` / `by`. R223.M4
// (sort_group_reduce.pdx) lands the three standard aggregation
// combinators. R223.M5 (wire_sink.pdx) lands the Cap'n Proto-ish wire
// framer. R223.M6 (hostname_annot.pdx) lands the `@hostname` prefix
// recogniser. All six landings operate on records flowing through a
// pipeline stage graph; none of them STATICALLY ENFORCES that the
// producer stage's output schema matches what the consumer stage
// expects to receive.
//
// R223.M7 (THIS module) lands the SESSION-TYPED EDGE discipline that
// turns every `|` boundary into a typed protocol between the producer's
// output and the consumer's input. The intuition is the standard
// session-type / pi-calculus duality: a sender's protocol `!X; done`
// (send record of schema X, then close) is dual to a receiver's
// protocol `?X; done` (receive record of schema X, then close). An
// edge type-checks iff the two halves are duals of each other, with
// the SAME schema tag on both sides.
//
// A pipeline edge therefore materialises as TWO SessionType records
// at parse time:
//
//   Record A -- producer-side half, direction = PRODUCE (!), schema =
//               producer-output-schema.
//   Record B -- consumer-side half, direction = CONSUME (?), schema =
//               consumer-input-schema.
//
// `_st_build_edge` emits the pair back-to-back into caller-owned
// storage from the two schema NAMES (16-byte zero-padded ASCII
// identifiers). `_st_check_duality` validates the pair and reports an
// E0710-family diagnostic on mismatch. `_st_render` emits the human-
// readable surface form (`!FileRec;done` or `?FileRec;done`) for the
// REPL's error reporter.
//
// The acceptance adversarial test (per issue #2672): 10 pipelines
// each wired with mismatched producer / consumer schemas across their
// edges all fail type-check with the E0710 family of diagnostics.
//
// =============================================================================
// WHY SESSION TYPES AND NOT A FLAT TYPE SIGNATURE COMPARE
// =============================================================================
//
// A naive scheme would stamp each stage with an output-record schema
// and a next-stage input-record schema, then at `|` check `stage[i]
// .out == stage[i+1].in` with a plain structural compare. That shape
// works today (R223.M1 could implement it in ten lines) but DOES NOT
// EXTEND to the two directions the pipeline-lang roadmap already names:
//
//   (a) Multi-step protocols. `find . @remote | sort by size |
//       reduce by group` is dual-closed over three edges today; the
//       next-wave roadmap adds `@remote` fan-out that opens a
//       SUB-PROTOCOL (fan send, fan recv) on each edge. A session
//       type names an ORDERED PROTOCOL (`!X; ?Ack; !Y; done`) that
//       a flat compare can never capture because the compare
//       conflates "schema" with "whole protocol".
//
//   (b) Direction encoding. The user's semantic-shell plan has
//       `& reduce` running the reduce side AS CONSUMER (receiving
//       records) and `| reduce` running it AS PRODUCER (seeding
//       its own records). A flat schema compare cannot distinguish
//       `!X` from `?X` -- both have schema X but opposite
//       direction. The session-type discipline makes the direction
//       the FIRST classifier a check consults.
//
// At raw M7 the protocol is a SINGLE STEP each side (`!X; done` on
// one half, `?X; done` on the other) because the acceptance test
// targets single-edge mismatch. The 32-byte record carries direction
// + flags + schema_tag + inline name; room for multi-step chaining
// via a trailing far-pointer is reserved in `flags` bit 1 for a
// R223.M7.1+ follow-up that extends to the brief's "sub-protocol"
// use case.
//
// Scope at M7:
//   * 32-byte SessionType record: magic + direction byte + flags +
//     reserved + schema_tag_hash + schema_name_inline.
//   * `_st_init()` -- pure-leaf bare `ret` boot hook (no .bss state at
//     M7; the entry exists for parallelism with the parser-family
//     init-hook convention).
//   * `_st_build_edge(producer_name_ptr, consumer_name_ptr, out,
//                     out_cap) -> packed_u64`
//     Emits TWO 32-byte SessionType records back-to-back into out
//     (first PRODUCE on producer_name, then CONSUME on consumer_name).
//   * `_st_check_duality(edge_a, edge_b) -> status`
//     Verifies the two records form a dual pair (same magic, same
//     schema_tag, opposite direction, both CLOSED).
//   * `_st_render(record, out, out_cap) -> packed_u64`
//     Emits `!schema;done` or `?schema;done` into out for the REPL's
//     error reporter.
//
// Out of scope at M7 (deferred):
//   * Multi-step protocols (`!X; ?Ack; !Y; done`). M7.1 lands the
//     trailing far-pointer encoding under `flags` bit 1 that carries
//     a protocol chain beyond the single-step M7 shape.
//   * Fan-out protocols for `@group:rule` host-set edges (R223.M6
//     federation extension). M7.2 pairs with HostnameAnnot's
//     kind=GROUP record.
//   * Branch types (`&{A, B}` external choice; `+{A, B}` internal
//     choice) for the REPL's `switch` / `case` combinator landing.
//     M7.3 lands branch encoding in a trailing variant tag.
//   * Linearity propagation: once R224.M7 lands affine effect typing
//     the edge pair becomes STATICALLY one-shot. M7.4 wires that in.
//   * Property-test corpus (10 adversarial mismatched pipelines, per
//     the acceptance brief). Deferred to the eventual R223 fuzz
//     landing; the design doc §8 enumerates the ten cases.
//
// =============================================================================
// SESSIONTYPE RECORD LAYOUT (M7, 32 B)
// =============================================================================
//
//   offset  size  field                     notes
//   ------  ----  ------------------------- ------------------------------------
//     0x00   4   magic           u32        ST_RECORD_MAGIC ('SESS' LE
//                                            = 0x53534553). Reads as the
//                                            four ASCII bytes "SESS" in
//                                            a hex-dump sequential scan.
//     0x04   1   direction       u8         ST_DIR_PRODUCE (0, "!")
//                                            or ST_DIR_CONSUME (1, "?").
//                                            Any other value is a
//                                            protocol-drift fault.
//     0x05   1   flags           u8         bit 0 = ST_FLAG_CLOSED (session
//                                            finalised with `;done`;
//                                            always set at M7 since the
//                                            single-step protocol is
//                                            terminal). bits 1..7 reserved
//                                            at M7 (bit 1 = far-ptr
//                                            multi-step chain at M7.1+;
//                                            bits 2..7 = branch / linearity
//                                            at M7.2+).
//     0x06   2   reserved        u16        Zeroed at M7; reserved for
//                                            an M7.1+ variant tag.
//     0x08   8   schema_tag_hash u64        FNV-1a 64 of the schema name
//                                            bytes (0..first-NUL inside
//                                            the 16-byte buffer). Byte-
//                                            for-byte identical to
//                                            R222.M2 `_cmd_sig_fnv1a64`,
//                                            R222.M3 `_fi_fnv1a64`,
//                                            R222.M5 `_cmdreg_fnv1a64`,
//                                            R223.M5 `_ws_schema_hash`,
//                                            R223.M6 inlined FNV in
//                                            `_ha_parse`, R229.M5
//                                            inlined FNV in `_h_append`
//                                            (offset basis
//                                            0xCBF29CE484222325, prime
//                                            0x100000001B3).
//     0x10  16   schema_name_inline [u8;16] ASCII identifier, zero-padded.
//                                            Caller passes a pointer to
//                                            a 16-byte zero-padded buffer;
//                                            this module byte-copies all
//                                            16 bytes verbatim (including
//                                            the zero padding beyond the
//                                            first NUL byte).
//
// Record stride is 32 B so an edge pair occupies 64 B total. A caller
// buffer of 64 B holds one complete edge; a longer buffer holds a
// chain of edges concatenated.
//
// Field-by-field rationale:
//
//   * `magic`. Standard wire-format discipline. 'SESS' LE = 0x53534553
//     -- the u32 value whose little-endian representation reads as
//     the identifier in a hex-dump sequential scan (per the Wave 125
//     SortGroupReduce magic-reconciliation lesson). Disjoint from the
//     landed Wave 127 sibling magics: 'WSNK' (0x4B4E5357, R223.M5),
//     'HOST' (0x54534F48, R223.M6), 'LHEA' (0x4145484C, R229.M6).
//
//   * `direction`. One byte because the raw-M7 protocol lattice has
//     exactly two inhabitants (PRODUCE, CONSUME). An M7.3 branch
//     extension carves `ST_DIR_CHOICE` (2) and `ST_DIR_OFFER` (3)
//     into the same byte without rewiring the layout.
//
//   * `flags`. One byte, bit-mapped. At M7 bit 0 marks a closed
//     session (`;done` emitted). Downstream M7.1+ claims bit 1 for
//     far-ptr multi-step chaining; bits 2..7 for branch and
//     linearity.
//
//   * `reserved`. Two bytes carved to keep the (direction, flags,
//     reserved) group 32-bit-aligned so the FOLLOWING schema_tag_hash
//     u64 lands on an 8-byte boundary. M7.1 reinterprets as a
//     variant tag for far-ptr protocol chains without breaking the
//     M7 wire shape.
//
//   * `schema_tag_hash`. 64-bit FNV so an edge-duality check consults
//     this field directly without a byte-by-byte name compare.
//     Byte-for-byte identical to the parser-family's six prior FNV
//     leaves so a schema registered via R222.M2 CommandSig hashes
//     byte-identically here. The caller derives this field INSIDE
//     `_st_build_edge` by scanning the 16-byte input for the first
//     NUL byte and FNV-hashing the live prefix.
//
//   * `schema_name_inline`. 16 bytes of inline name (zero-padded).
//     Carries enough bits for every schema name in the semantic-shell
//     language plan (`FileRec`, `Signal`, `TokenRec`, `Entry`,
//     `Record`, `Stat`, ...). Longer names were out of scope by the
//     R222.M1 SchemasSig 14-char identifier cap already baked in; the
//     16-byte inline here matches that budget (plus two bytes of
//     slack).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _st_init() -> ()
//
//     Idempotent lazy boot hook. M7 holds NO .bss state (every
//     SessionType record is caller-owned on all three operational
//     paths; the hash is a pure byte walk over caller-supplied name
//     bytes). Body is a bare `ret`. Kept for parallelism with the
//     parser-family init-hook convention (`_ha_init` R223.M6,
//     `_ws_init` R223.M5, `_ds_init` R222.M8, `_dm_init` R222.M6,
//     `_cmdreg_init` R222.M5) so a later landing that adds .bss
//     (per-session edge counters, a schema-tag intern table, a
//     per-session duality-fault counter) does not break the API.
//
//     Register map: () -> rax (ignored).
//
//   _st_build_edge(producer_name_ptr, consumer_name_ptr, out,
//                  out_cap) -> packed_u64
//
//     Emits TWO 32-byte SessionType records back-to-back at
//     out[0..64) from the producer and consumer schema NAMES (each
//     a pointer to a 16-byte zero-padded ASCII identifier). The
//     first record is the PRODUCE half on producer_name; the second
//     is the CONSUME half on consumer_name.
//
//     Steps:
//       1. Validate producer_name_ptr != 0, consumer_name_ptr != 0
//          (ST_ERR_BAD_SCHEMA on failure).
//       2. Validate out != 0, out_cap >= 64 (ST_ERR_OUT_TOO_SMALL on
//          failure).
//       3. Zero-fill the 64-byte region (two 32-byte records).
//       4. Record A (PRODUCE):
//            - Stamp magic 'SESS' u32 at [out + 0].
//            - direction byte 0 at [out + 4] (ST_DIR_PRODUCE); the
//              zero-fill already leaves this zero but we store
//              explicitly for register-liveness symmetry with
//              Record B.
//            - flags byte 1 at [out + 5] (ST_FLAG_CLOSED).
//            - reserved u16 at [out + 6..+8] stays zero.
//            - Byte-copy 16 bytes of producer_name_ptr into
//              [out + 16..+32].
//            - Scan [producer_name_ptr + 0..+16] for first NUL to
//              get the effective schema-name length (0..16).
//            - Compute FNV-1a 64 over the live prefix; store u64 at
//              [out + 8].
//       5. Record B (CONSUME):
//            - Stamp magic 'SESS' u32 at [out + 32].
//            - direction byte 1 at [out + 36] (ST_DIR_CONSUME).
//            - flags byte 1 at [out + 37] (ST_FLAG_CLOSED).
//            - reserved u16 at [out + 38..+40] stays zero.
//            - Byte-copy 16 bytes of consumer_name_ptr into
//              [out + 48..+64].
//            - Scan + FNV over the consumer name; store u64 at
//              [out + 40].
//       6. Return (64 << 32) | ST_OK.
//
//     Returns packed_u64 whose high 32 is the bytes_written (= 64
//     on success, 0 on error) and low 32 is the status code:
//       ST_OK                        (0)       on success
//       ST_ERR_BAD_SCHEMA            (0x5500)  producer_name_ptr == 0
//                                              OR consumer_name_ptr == 0
//       ST_ERR_OUT_TOO_SMALL         (0x5501)  out == 0 OR out_cap < 64
//
//     Register map (SysV):
//       _st_build_edge(rdi, rsi, rdx, rcx) -> rax
//         rdi = producer_name_ptr  (ptr to 16-byte zero-padded name)
//         rsi = consumer_name_ptr  (ptr to 16-byte zero-padded name)
//         rdx = out                (ptr to >= 64 B caller buffer)
//         rcx = out_cap            (byte capacity of out)
//         rax = (bytes_written << 32) | status
//
//   _st_check_duality(edge_a, edge_b) -> status
//
//     Validates that two SessionType records form a dual pair:
//       (1) both records carry ST_RECORD_MAGIC;
//       (2) directions are opposite (one PRODUCE, one CONSUME);
//       (3) schema_tag_hash fields are equal;
//       (4) both records have ST_FLAG_CLOSED set.
//
//     Return taxonomy maps the brief's E0710 family directly onto
//     the 0x5500..0x55FF band:
//       ST_OK                        (0)
//       ST_ERR_BAD_RECORD            (0x5502)  edge_a == 0 OR edge_b == 0
//       ST_ERR_SCHEMA_MISMATCH       (0x5510)  E0710: schema_tag_hash
//                                              differs between the two
//                                              halves.
//       ST_ERR_DIRECTION_MISMATCH    (0x5511)  E0711: both halves carry
//                                              the same direction byte
//                                              (both PRODUCE or both
//                                              CONSUME) -- not a dual
//                                              pair.
//       ST_ERR_UNCLOSED_SESSION      (0x5512)  E0712: one or both halves
//                                              have ST_FLAG_CLOSED clear.
//       ST_ERR_PROTOCOL_DRIFT        (0x5513)  E0713: magic mismatch on
//                                              either half OR direction
//                                              byte > 1 on either half.
//
//     Validation ordering is magic FIRST (E0713 PROTOCOL_DRIFT
//     subsumes all other faults because a non-magic record is not a
//     SessionType), then direction, then closed, then schema. Each
//     diagnostic site reports a distinct error class so the REPL's
//     error reporter can pick the most specific message without a
//     secondary classifier.
//
//     Register map (SysV):
//       _st_check_duality(rdi, rsi) -> rax
//         rdi = edge_a            (ptr to first 32-B record)
//         rsi = edge_b            (ptr to second 32-B record)
//         rax = ST_OK | ST_ERR_*
//
//   _st_render(record, out, out_cap) -> packed_u64
//
//     Renders a human-readable surface form of a SessionType record
//     into out[0..bytes_written):
//
//       direction byte 0 (ST_DIR_PRODUCE) -> '!' prefix.
//       direction byte 1 (ST_DIR_CONSUME) -> '?' prefix.
//       schema name copied from [record + 16..+32] up to first NUL
//         byte (0..16 bytes).
//       suffix ';done' (5 bytes) iff ST_FLAG_CLOSED set, else
//         ';open' (5 bytes).
//
//     Total bytes_written = 1 (prefix) + schema_len (0..16) + 5
//     (suffix) = 6..22 bytes.
//
//     Steps:
//       1. Validate record != 0 (ST_ERR_BAD_RECORD on failure).
//       2. Validate magic (ST_ERR_PROTOCOL_DRIFT on failure).
//       3. Validate direction byte in {0, 1} (ST_ERR_PROTOCOL_DRIFT
//          on failure).
//       4. Validate out != 0 (ST_ERR_OUT_TOO_SMALL on failure).
//       5. Compute schema_len by scanning [record + 16..+32] for
//          first NUL (cap 16).
//       6. Compute total_bytes = 1 + schema_len + 5. Validate
//          out_cap >= total_bytes (ST_ERR_OUT_TOO_SMALL on failure).
//       7. Write prefix byte ('!' = 0x21 or '?' = 0x3F) at [out + 0].
//       8. Byte-copy schema_len bytes from [record + 16] to
//          [out + 1].
//       9. Write suffix: ';' (0x3B) at [out + 1 + schema_len], then
//          'd'/'o'/'p'/'e'/'n' or 'd'/'o'/'n'/'e'/'\0' at
//          [+2..+6] offset from (1 + schema_len) -- i.e., all five
//          suffix bytes at [out + 1 + schema_len + 1..+6]. The
//          'open' and 'done' suffixes are both 5 bytes long so the
//          write loop is identical.
//      10. Return (total_bytes << 32) | ST_OK.
//
//     Register map (SysV):
//       _st_render(rdi, rsi, rdx) -> rax
//         rdi = record            (ptr to 32-B record)
//         rsi = out               (ptr to caller buffer)
//         rdx = out_cap           (byte capacity of out)
//         rax = (bytes_written << 32) | status
//
// =============================================================================
// STATUS BAND -- 0x5500..0x55FF
// =============================================================================
//
//   ST_OK                     = 0
//   ST_ERR_BAD_SCHEMA         = 0x5500
//   ST_ERR_OUT_TOO_SMALL      = 0x5501
//   ST_ERR_BAD_RECORD         = 0x5502
//   ST_ERR_SCHEMA_MISMATCH    = 0x5510   (E0710)
//   ST_ERR_DIRECTION_MISMATCH = 0x5511   (E0711)
//   ST_ERR_UNCLOSED_SESSION   = 0x5512   (E0712)
//   ST_ERR_PROTOCOL_DRIFT     = 0x5513   (E0713)
//
// The 0x5500..0x55FF range is reserved for the R223.M7 session-type
// band. Slots 0x5503..0x550F reserved for M7.1+ build/validate faults
// (far-ptr chain errors, variant-tag errors, intern-table collisions).
// Slots 0x5514..0x55FF reserved for M7.2+ branch and linearity
// diagnostics (`&`-choice, `+`-offer, affinity violations).
//
// The 0x5500..0x55FF band carves a one-kilo-step past Wave 127's
// 0x5400..0x54FF (R229.M6 LineEditor), 0x5300..0x53FF (R223.M6
// HostnameAnnot), 0x5200..0x52FF (R223.M5 WireSink), 0x5100..0x51FF
// (R229.M5 History), 0x5000..0x50FF (R224.M6 PipelineLambda), and
// 0x4F00..0x4FFF (R222.M8 DescribeSig). The band displaces the prior
// "deferred Vi-mode state machine" soft reservation under R229.M6.5
// (which was never a landing commitment, only a note in LineEditor's
// forward-path section); R229.M6.5 moves to 0x5600..0x56FF when
// landed. SessionType's band is disjoint from every other parser-
// tier packed-status range in the paideia-os tree so a downstream
// compound-error dispatcher can discriminate "the session-type
// substrate faulted" from every other satellite's failure modes
// by a single `shr r, 8; cmp r, 0x55` idiom.
//
// Grep confirmation at R223.M7 landing time:
//   grep -rE '0x55(0[0-2]|1[0-3])\b' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file + caps.decl +
//        design/shell/session-typed-edges.md.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- bit-isolation uses imm8 (`and rax, 1` to
//     test ST_FLAG_CLOSED). No imm32 masks used in this file at M7.
//   - No 2-op `imul rN, imm` -- the 16-byte stride uses `shl rN, 4`
//     (NOT NEEDED at M7: all schema-name offsets are compile-time
//     constants 16, 32, 48 so direct `add r, 16` suffices).
//   - Variable shift via `shr rN, cl` / `shl rN, cl` is NOT USED at
//     M7 (every shift amount in this module is a compile-time
//     constant: 32).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `SessionType` matches `session_type.pdx`.
//   - Labels prefixed `st_` (grep-confirmed unique against the
//     parser-tier modules' prior prefixes u8n_, gi_, wp_, sch_sig_,
//     cmd_sig_, fi_, afs_, pl_, rp_, ll_, cc_, er_, cr_, cmdreg_,
//     hm_, rt_, dl_, se_, te_, cl_, dm_, fo_, sgr_, jc_, fh_, ast_,
//     sm_, ls_, lex_, eu_, h_, pl_lam_, ds_, le_, ha_, ws_). The
//     paideia-as reserved keyword set (`loop`, `if`, `let`, `fn`,
//     `ret`) is avoided per reference_paideia_as_reserved_labels.
//   - All `cmp reg, imm` immediates (0, 1, 16, 32, 64, 0x21, 0x3B,
//     0x3F, 0x53534553, status codes 0x5500..0x5513, field offsets
//     0, 4, 5, 8, 16, 32, 36, 37, 40, 48) fit imm32 with bit 31
//     clear (0x53534553 < 0x80000000 so cmp-imm32 is sign-safe). No
//     immediate in this file needs the imm64 encoding except the
//     two FNV constants (0xCBF29CE484222325, 0x100000001B3) which
//     use the standard `mov r64, imm64` encoding (precedent:
//     _cmd_sig_fnv1a64 lines 437-438; _ha_parse lines 607-608).
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx]` (zero-
//     extend into the full qword).
//   - Byte stores via `mov_b [dst + disp], reg` (writes low 8 bits).
//   - u32 loads via `xor rN, rN; mov_d rN, [base + disp]` (zero-
//     extend into the full qword).
//   - u32 stores via `mov_d [dst + disp], reg` (writes low 32 bits).
//   - u64 loads/stores via plain `mov`.
//   - No chained-displacement addressing: `[base + off + idx]` is
//     precomputed into a scratch via `add` first, then dereferenced
//     via `[rN + 0]`. Precedent: hostname_annot.pdx name-copy loops
//     at lines 574-583, FNV byte-load at 614-619.
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
// Every entry point in this module is a PURE LEAF -- no nested CALL,
// no callee-save push by the two leafmost entries (`_st_init`,
// `_st_check_duality`), and a 4-push / 3-push frame for the two
// callers that carry state across inner loops. The r11 clobber
// contract never activates because no CALL fires.
//
//   * `_st_init`: bare `ret`. No regs touched.
//   * `_st_build_edge`: 4 inputs in rdi, rsi, rdx, rcx; scratch in
//     rax, r8, r9, r10, r11. Prologue pushes rbx (= producer_name
//     base, saved across the two record emits), rbp (= consumer_name
//     base, same reason), r12 (= out base, held unchanged across
//     all stores), r13 (unused at M7 but reserved for an M7.1+
//     chain-pointer carry); 4 pushes = 32 B; entry rsp%16==8 so
//     after pushes rsp%16 == (8+32)%16 == 8. No CALL fires so the
//     odd rsp alignment is harmless. r10 is the write index (dies
//     each loop). r9 (byte scratch) and r11 (addr scratch) are
//     caller-save and reused freely. rax is the FNV accumulator
//     during the hash loops and the return packer afterward. rcx
//     holds the FNV prime across the two hash loops (reloaded for
//     the second).
//   * `_st_check_duality`: 2 inputs in rdi, rsi; scratch in rax, rcx,
//     rdx, r8, r9. No pushes; no stack frame. rax carries the status
//     code at every return site. r8 and r9 are two-way byte / qword
//     scratch for the direction / flags / hash compares. Pure leaf.
//   * `_st_render`: 3 inputs in rdi, rsi, rdx; scratch in rax, r8,
//     r9, r10, r11. Prologue pushes rbx (= record base) and r12 (=
//     out base); 2 pushes = 16 B; entry rsp%16==8 so after pushes
//     rsp%16 == (8+16)%16 == 8. No CALL fires. r13 holds schema_len
//     across the capacity check and the copy loops. r10 is the write
//     index (dies each loop).
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// Not applicable at M7: this module holds no .bss state. Every
// SessionType record is caller-owned on all three operational paths;
// the hash operates as a pure byte walk over a caller-supplied name
// buffer. `_st_init` is a bare `ret` placeholder; a later landing
// that adds .bss (per-session edge counters, a schema-tag intern
// table, a per-session duality-fault counter) will flesh it out
// behind the same name without an ABI break.
//
// =============================================================================
// LINKER DEPENDENCIES
// =============================================================================
//
// NO external cross-library linker dependency. NO intra-library
// cross-module linker dependency. The FNV offset basis
// (0xCBF29CE484222325) and prime (0x100000001B3) are replicated as
// local module constants so the hash validates the input without a
// cross-module linker dep on command_sig.pdx, wire_sink.pdx, or
// hostname_annot.pdx -- the same disjoint-leaf precedent as the
// parser-family's seven prior FNV leaves (`_cmd_sig_fnv1a64`,
// `_fi_fnv1a64`, `_cmdreg_fnv1a64`, `_ws_schema_hash`, inlined in
// `_ha_parse` and `_ha_check` and `_h_append`). All three public
// entry points can be linked standalone against a bare parser-tier
// object graph; no new `--extra-obj-dir` is introduced.
//
// R223.M7.1+ (multi-step protocol chains) will introduce a one-way
// structural dependency on R222.M1 SchemasSig (per-field type
// codes for sub-protocol records) but STILL no linker-visible
// dependency because the SchemasSig body buffer is handed in as
// an opaque caller-managed pointer.
//
// =============================================================================
// Upstream: paideia-os#2487 (R223 umbrella), paideia-os#2672 (THIS
// ticket, R223.M7). Substrate: paideia-os#2666 (R223.M1 Pipeline),
// paideia-os#2658 (R222.M1 SchemasSig -- schema name universe),
// paideia-os#2683 (R225.M2 RowTypes -- the row-type lattice that
// pairs with the session-type lattice), paideia-os#2685 (R225.M4
// EffectUnify -- the effect-row counterpart of the duality rule).
// Design doc: design/shell/session-typed-edges.md. Related:
// design/shell/pipeline-stage-parser.md (R223.M1), design/shell/
// cmd-functor-schemas-sig.md (R222.M1), design/shell/
// effect-row-unification.md (R225.M4).

module SessionType = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (low 32 bits of return)
  // ==========================================================================
  //
  // Small-value range 0x5500..0x55FF, reserved for the R223.M7
  // session-type band. Disjoint from every prior landed R223
  // submodule band:
  //   Pipeline            0x2B00..0x2BFF (R223.M1)
  //   RecordProjection    0x3400..0x34FF (R223.M2)
  //   FilterOp            0x4C00..0x4CFF (R223.M3)
  //   SortGroupReduce     0x4D00..0x4DFF (R223.M4)
  //   WireSink            0x5200..0x52FF (R223.M5)
  //   HostnameAnnot       0x5300..0x53FF (R223.M6)
  //
  // Grep confirmation at R223.M7 landing time:
  //   grep -rE '0x55(0[0-2]|1[0-3])\b' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/session-typed-edges.md.

  pub let ST_OK                       : u64 = 0
  pub let ST_ERR_BAD_SCHEMA           : u64 = 0x5500
  pub let ST_ERR_OUT_TOO_SMALL        : u64 = 0x5501
  pub let ST_ERR_BAD_RECORD           : u64 = 0x5502
  pub let ST_ERR_SCHEMA_MISMATCH      : u64 = 0x5510
  pub let ST_ERR_DIRECTION_MISMATCH   : u64 = 0x5511
  pub let ST_ERR_UNCLOSED_SESSION     : u64 = 0x5512
  pub let ST_ERR_PROTOCOL_DRIFT       : u64 = 0x5513

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  // 32-byte SessionType record stride.
  pub let ST_RECORD_BYTES             : u64 = 32

  // Edge-pair byte width (two records back-to-back).
  pub let ST_EDGE_PAIR_BYTES          : u64 = 64

  // Maximum inline schema-name length.
  pub let ST_SCHEMA_NAME_MAX          : u64 = 16

  // Magic: 'SESS' little-endian = 0x53534553. Reads as the 4-byte
  // ASCII string "SESS" in a hex dump (bytes 53 45 53 53 = S E S S).
  pub let ST_RECORD_MAGIC             : u64 = 0x53534553

  // Direction byte values (at [record + 4]).
  pub let ST_DIR_PRODUCE              : u64 = 0
  pub let ST_DIR_CONSUME              : u64 = 1

  // Flag bits in the `flags` u8 at [record + 5].
  //
  //   bit 0  ST_FLAG_CLOSED       set iff the session is finalised
  //                                with `;done`. Always set at M7
  //                                since the single-step protocol
  //                                is terminal; a session without
  //                                this bit is in the open state
  //                                and fails _st_check_duality
  //                                with E0712 (ST_ERR_UNCLOSED_SESSION).
  //   bit 1  ST_FLAG_CHAIN        reserved for M7.1+ far-ptr multi-
  //                                step chain. Always 0 at M7.
  //   bits 2..7  reserved; always 0 at M7.
  pub let ST_FLAG_CLOSED              : u64 = 0x01

  // Record field offsets (byte offsets from record base).
  pub let ST_OFF_MAGIC                : u64 = 0    // u32
  pub let ST_OFF_DIRECTION            : u64 = 4    // u8
  pub let ST_OFF_FLAGS                : u64 = 5    // u8
  pub let ST_OFF_RESERVED             : u64 = 6    // u16
  pub let ST_OFF_SCHEMA_TAG_HASH      : u64 = 8    // u64
  pub let ST_OFF_SCHEMA_NAME_INLINE   : u64 = 16   // [u8; 16]

  // Second-record field offsets inside the 64-byte edge pair
  // (byte offsets from edge-pair base, i.e. first-record base).
  pub let ST_B_OFF_MAGIC              : u64 = 32   // u32
  pub let ST_B_OFF_DIRECTION          : u64 = 36   // u8
  pub let ST_B_OFF_FLAGS              : u64 = 37   // u8
  pub let ST_B_OFF_RESERVED           : u64 = 38   // u16
  pub let ST_B_OFF_SCHEMA_TAG_HASH    : u64 = 40   // u64
  pub let ST_B_OFF_SCHEMA_NAME_INLINE : u64 = 48   // [u8; 16]

  // ==========================================================================
  // _st_init() -> ()
  //
  // Idempotent lazy boot hook. M7 holds no .bss state so the body is
  // a bare `ret`. Kept for parallelism with the parser-family init-
  // hook convention (_ha_init R223.M6, _ws_init R223.M5, _ds_init
  // R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5); a later landing
  // that adds .bss (per-session edge counters, a schema-tag intern
  // table, a per-session duality-fault counter) will flesh this out
  // behind the same name without an ABI break.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // ==========================================================================
  pub let _st_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R223.M7 (#2672): _st_init is a bare ret at this landing. The module holds no .bss state at M7 (every SessionType record is caller-owned on all three operational paths; the hash operates as a pure byte walk over a caller-supplied name buffer). The entry point exists for parallelism with the parser-family init-hook convention (_ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5) so a later landing that adds .bss (per-session edge counters, a schema-tag intern table, a per-session duality-fault counter) does not break the API. Pure leaf; zero pushes; no stack frame; no nested CALL. No cmp immediates; no byte loads; no stores. Labels prefixed st_ini_ (none at M7).",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _st_build_edge(producer_name_ptr, consumer_name_ptr, out, out_cap)
  //                                                    -> packed_u64
  //
  //   rdi = producer_name_ptr   (ptr to 16-byte zero-padded ASCII name)
  //   rsi = consumer_name_ptr   (ptr to 16-byte zero-padded ASCII name)
  //   rdx = out                 (ptr to caller buffer; >= 64 bytes)
  //   rcx = out_cap             (byte capacity of out)
  //   rax = (bytes_written << 32) | status
  //
  // Emits TWO 32-byte SessionType records back-to-back:
  //   [out +  0.. +32) -- PRODUCE on producer_name
  //   [out + 32.. +64) -- CONSUME on consumer_name
  //
  // Flow:
  //   1. Validate producer_name_ptr != 0 (ST_ERR_BAD_SCHEMA on fail).
  //   2. Validate consumer_name_ptr != 0 (ST_ERR_BAD_SCHEMA on fail).
  //   3. Validate out != 0, out_cap >= 64 (ST_ERR_OUT_TOO_SMALL).
  //   4. Zero-fill the 64 bytes via 8 u64 stores.
  //   5. Record A: stamp magic / direction / flags / name / hash.
  //   6. Record B: stamp magic / direction / flags / name / hash.
  //   7. Return (64 << 32) | ST_OK.
  //
  // Pure leaf -- no nested CALL. Prologue: 4 callee-save pushes
  // (rbx = producer_name_ptr, rbp = consumer_name_ptr, r12 = out,
  // r13 = reserved for M7.1+). Labels prefixed st_be_.
  // ==========================================================================
  pub let _st_build_edge : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (producer_name_ptr: u64) (consumer_name_ptr: u64) (out: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M7 (#2672): _st_build_edge emits two 32-byte SessionType records back-to-back at [out, out+64). Pure leaf; no nested CALL. 4 callee-save pushes (rbx=producer_name_ptr, rbp=consumer_name_ptr, r12=out, r13=reserved for an M7.1+ chain-pointer carry). Flow: (1) Validate rbx != 0 (cmp rbx, 0; je st_be_bad_schema). (2) Validate rbp != 0 (cmp rbp, 0; je st_be_bad_schema). (3) Validate r12 != 0 (cmp r12, 0; je st_be_oos); validate out_cap >= 64 (cmp rcx, 64; jb st_be_oos). (4) Zero-fill the 64-byte region via 8 u64 stores (xor rax, rax; then mov [r12+disp], rax for disp in {0,8,16,24,32,40,48,56}). (5) Record A emit: write magic 'SESS' (0x53534553) u32 at [out+0] via mov r9, 0x53534553; mov_d [r12 + 0], r9; the magic fits imm32 (< 0x80000000). Write direction byte 0 at [out+4] via xor rax, rax; mov_b [r12 + 4], rax (zero-fill already left it zero but we store explicitly for symmetry with Record B). Write flags byte 1 (ST_FLAG_CLOSED) at [out+5] via mov rax, 1; mov_b [r12 + 5], rax. The reserved u16 at [out+6..+8] stays zero from the zero-fill. Byte-copy loop producer_name[0..16] to [out+16..+32]: xor r10, r10; each iter cmp r10, 16; jae ...; precompute src = producer_name_ptr + r10 into r11 (mov r11, rbx; add r11, r10); xor rax, rax; mov_b rax, [r11 + 0]; precompute dst = out + 16 + r10 into r9 (mov r9, r12; add r9, 16; add r9, r10); mov_b [r9 + 0], rax; add r10, 1; jmp. Length scan for FNV: xor r10, r10; each iter cmp r10, 16; jae ...; precompute src = producer_name_ptr + r10 into r11 (two-term addressing); xor rax, rax; mov_b rax, [r11 + 0]; cmp rax, 0; je done (first NUL ends the live prefix); add r10, 1; jmp. On done r10 is the live length (0..16). FNV-1a 64 over producer_name[0..r10] into rax: mov rax, 0xCBF29CE484222325 (offset basis, imm64 MOVABS); mov rcx, 0x100000001B3 (prime, imm64 MOVABS); save len (r10) into r8 BEFORE the mul-rdx-clobber; xor r10, r10 (reuse r10 as loop idx); each iter cmp r10, r8; jae done; precompute src = rbx + r10 into r11; xor r9, r9; mov_b r9, [r11 + 0]; xor rax, r9 (h ^= byte); xor rdx, rdx (clear mul high half); mul rcx (rdx:rax = rax * prime; low in rax); add r10, 1; jmp. Write hash u64 at [out+8] via mov [r12 + 8], rax. (6) Record B emit (consumer_name, direction=1): mirrors Record A at offsets [out+32..+64]. Write magic at [out+32] via mov r9, 0x53534553; mov_d [r12 + 32], r9. Write direction byte 1 at [out+36] via mov rax, 1; mov_b [r12 + 36], rax. Write flags byte 1 at [out+37] via mov rax, 1; mov_b [r12 + 37], rax. Byte-copy consumer_name[0..16] to [out+48..+64]: xor r10, r10; precompute src = rbp + r10 into r11, dst = r12 + 48 + r10 into r9, byte-copy. Length scan + FNV mirror the Record A sequence over rbp (consumer_name_ptr). Write hash u64 at [out+40]. (7) Return packed_u64 = (64 << 32) | ST_OK: mov rax, 64; shl rax, 32; jmp epilogue (ST_OK = 0 so no `or`). Error paths: st_be_bad_schema packs (0 << 32) | 0x5500; st_be_oos packs (0 << 32) | 0x5501. Epilogue: pop r13; pop r12; pop rbp; pop rbx; ret. All cmp immediates (0, 1, 16, 32, 48, 64, 0x53534553, status codes 0x5500..0x5501) fit imm32 with bit 31 clear. FNV constants > imm32 and load via MOVABS (precedent hostname_annot.pdx lines 607-608; wire_sink.pdx lines 947-948). No test; no and-imm64; no 2-op imul-r-imm (FNV uses one-op `mul rcx`); no multiline let; no three-term addressing (all [base+idx+off] precomputed into a scratch). Labels prefixed st_be_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;

        // Save args into callee-save regs.
        mov rbx, rdi;                          // producer_name_ptr
        mov rbp, rsi;                          // consumer_name_ptr
        mov r12, rdx;                          // out
        xor r13, r13;                          // reserved for M7.1+ chain-ptr

        // ---- Input validation ------------------------------------------
        // producer_name_ptr != 0.
        cmp rbx, 0;
        je  st_be_bad_schema;

        // consumer_name_ptr != 0.
        cmp rbp, 0;
        je  st_be_bad_schema;

        // out != 0.
        cmp r12, 0;
        je  st_be_oos;

        // out_cap >= 64 (ST_EDGE_PAIR_BYTES).
        cmp rcx, 64;
        jb  st_be_oos;

        // ---- Zero-fill 64-byte region via 8 u64 stores -----------------
        xor rax, rax;
        mov [r12 + 0],  rax;
        mov [r12 + 8],  rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;
        mov [r12 + 32], rax;
        mov [r12 + 40], rax;
        mov [r12 + 48], rax;
        mov [r12 + 56], rax;

        // ================================================================
        // RECORD A -- PRODUCE on producer_name
        // ================================================================

        // ---- Record A: magic 'SESS' u32 at [out + 0] -------------------
        mov r9, 0x53534553;                    // ST_RECORD_MAGIC
        mov_d [r12 + 0], r9;

        // ---- Record A: direction byte 0 (PRODUCE) at [out + 4] ---------
        // The zero-fill already left this zero; we store explicitly for
        // symmetry with Record B and to document intent.
        xor rax, rax;                          // ST_DIR_PRODUCE = 0
        mov_b [r12 + 4], rax;

        // ---- Record A: flags byte 1 (CLOSED) at [out + 5] --------------
        mov rax, 1;                            // ST_FLAG_CLOSED
        mov_b [r12 + 5], rax;

        // ---- Record A: reserved u16 at [+6..+8] stays zero -------------

        // ---- Record A: byte-copy producer_name[0..16] into [out+16..+32]
        xor r10, r10;                          // i = 0

      st_be_pname_copy:
        cmp r10, 16;                           // ST_SCHEMA_NAME_MAX
        jae st_be_pname_scan;
        // src = producer_name_ptr + i into r11 (two-term precompute).
        mov r11, rbx;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];                  // byte (zero-ext)
        // dst = out + 16 + i into r9 (three-term precompute).
        mov r9, r12;
        add r9, 16;                            // ST_OFF_SCHEMA_NAME_INLINE
        add r9, r10;
        mov_b [r9 + 0], rax;
        add r10, 1;
        jmp st_be_pname_copy;

      st_be_pname_scan:
        // Scan producer_name[0..16] for first NUL to compute live length.
        xor r10, r10;                          // i = 0

      st_be_pname_scan_loop:
        cmp r10, 16;
        jae st_be_pname_fnv_begin;
        mov r11, rbx;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        cmp rax, 0;                            // NUL byte?
        je  st_be_pname_fnv_begin;
        add r10, 1;
        jmp st_be_pname_scan_loop;

      st_be_pname_fnv_begin:
        // r10 = producer schema-name live length (0..16).
        // Save len into r8 BEFORE the FNV mul clobbers rdx.
        mov r8, r10;                           // r8 = plen
        mov rax, 0xCBF29CE484222325;           // offset basis (imm64 MOVABS)
        mov rcx, 0x100000001B3;                // prime (imm64 MOVABS)
        xor r10, r10;                          // i = 0 (reuse r10)

      st_be_pname_fnv_loop:
        cmp r10, r8;
        jae st_be_pname_fnv_done;
        // src = rbx + i into r11.
        mov r11, rbx;
        add r11, r10;
        xor r9, r9;
        mov_b r9, [r11 + 0];                   // byte (zero-ext)
        xor rax, r9;                           // h ^= byte
        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * prime
        add r10, 1;
        jmp st_be_pname_fnv_loop;

      st_be_pname_fnv_done:
        // Write Record A schema_tag_hash u64 at [out + 8].
        mov [r12 + 8], rax;

        // ================================================================
        // RECORD B -- CONSUME on consumer_name
        // ================================================================

        // ---- Record B: magic 'SESS' u32 at [out + 32] ------------------
        mov r9, 0x53534553;                    // ST_RECORD_MAGIC
        mov_d [r12 + 32], r9;

        // ---- Record B: direction byte 1 (CONSUME) at [out + 36] -------
        mov rax, 1;                            // ST_DIR_CONSUME
        mov_b [r12 + 36], rax;

        // ---- Record B: flags byte 1 (CLOSED) at [out + 37] ------------
        mov rax, 1;                            // ST_FLAG_CLOSED
        mov_b [r12 + 37], rax;

        // ---- Record B: reserved u16 at [+38..+40] stays zero -----------

        // ---- Record B: byte-copy consumer_name[0..16] to [out+48..+64]
        xor r10, r10;                          // i = 0

      st_be_cname_copy:
        cmp r10, 16;
        jae st_be_cname_scan;
        // src = consumer_name_ptr + i into r11.
        mov r11, rbp;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        // dst = out + 48 + i into r9.
        mov r9, r12;
        add r9, 48;                            // ST_B_OFF_SCHEMA_NAME_INLINE
        add r9, r10;
        mov_b [r9 + 0], rax;
        add r10, 1;
        jmp st_be_cname_copy;

      st_be_cname_scan:
        // Scan consumer_name[0..16] for first NUL.
        xor r10, r10;                          // i = 0

      st_be_cname_scan_loop:
        cmp r10, 16;
        jae st_be_cname_fnv_begin;
        mov r11, rbp;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        cmp rax, 0;
        je  st_be_cname_fnv_begin;
        add r10, 1;
        jmp st_be_cname_scan_loop;

      st_be_cname_fnv_begin:
        // r10 = consumer schema-name live length.
        mov r8, r10;                           // r8 = clen
        mov rax, 0xCBF29CE484222325;           // offset basis
        mov rcx, 0x100000001B3;                // prime
        xor r10, r10;                          // i = 0

      st_be_cname_fnv_loop:
        cmp r10, r8;
        jae st_be_cname_fnv_done;
        mov r11, rbp;
        add r11, r10;
        xor r9, r9;
        mov_b r9, [r11 + 0];
        xor rax, r9;
        xor rdx, rdx;
        mul rcx;
        add r10, 1;
        jmp st_be_cname_fnv_loop;

      st_be_cname_fnv_done:
        // Write Record B schema_tag_hash u64 at [out + 40].
        mov [r12 + 40], rax;

        // ---- Pack return: (64 << 32) | ST_OK ---------------------------
        mov rax, 64;                           // ST_EDGE_PAIR_BYTES
        shl rax, 32;                           // bytes_written in high 32
                                               // ST_OK = 0 so no `or`
        jmp st_be_epilogue;

        // ---- Error return paths ----------------------------------------
      st_be_bad_schema:
        xor rax, rax;                          // bytes_written = 0
        shl rax, 32;
        or  rax, 0x5500;                       // ST_ERR_BAD_SCHEMA
        jmp st_be_epilogue;

      st_be_oos:
        xor rax, rax;                          // bytes_written = 0
        shl rax, 32;
        or  rax, 0x5501;                       // ST_ERR_OUT_TOO_SMALL
        jmp st_be_epilogue;

        // ---- Epilogue --------------------------------------------------
      st_be_epilogue:
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _st_check_duality(edge_a, edge_b) -> status
  //
  //   rdi = edge_a            (ptr to first 32-B SessionType record)
  //   rsi = edge_b            (ptr to second 32-B SessionType record)
  //   rax = ST_OK | ST_ERR_*
  //
  // Validates two SessionType records form a dual pair:
  //   (1) both carry ST_RECORD_MAGIC                        -> E0713 on fail
  //   (2) directions are opposite (one PRODUCE, one CONSUME) -> E0711 on fail
  //   (3) schema_tag_hash fields are equal                   -> E0710 on fail
  //   (4) both halves have ST_FLAG_CLOSED set                -> E0712 on fail
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed st_cd_.
  // ==========================================================================
  pub let _st_check_duality : (u64, u64) -> u64 !{mem} @{} =
    fn (edge_a: u64) (edge_b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M7 (#2672): _st_check_duality validates two 32-B SessionType records form a dual pair. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Guards (in order so most-specific error wins): (1) edge_a != 0 (cmp rdi, 0; je st_cd_bad_rec); edge_b != 0 (cmp rsi, 0; je st_cd_bad_rec). (2) Magic 'SESS' (0x53534553) at [edge_a + 0]: xor rax, rax; mov_d rax, [rdi + 0]; cmp rax, 0x53534553; jne st_cd_drift. 0x53534553 < 0x80000000 so cmp-imm32 is sign-safe. Magic at [edge_b + 0]: xor rax, rax; mov_d rax, [rsi + 0]; cmp rax, 0x53534553; jne st_cd_drift. (3) Direction byte at [edge_a + 4]: xor r8, r8; mov_b r8, [rdi + 4]; cmp r8, 1; ja st_cd_drift (direction > 1 is drift). Direction byte at [edge_b + 4]: xor r9, r9; mov_b r9, [rsi + 4]; cmp r9, 1; ja st_cd_drift. (4) Dual-direction compare: cmp r8, r9; je st_cd_dir_mismatch (both halves same direction -> E0711). (5) Closed-flag check: xor rax, rax; mov_b rax, [rdi + 5]; and rax, 1; cmp rax, 1; jne st_cd_unclosed (imm8 mask; isolates bit 0 only). Same for [edge_b + 5]: xor rax, rax; mov_b rax, [rsi + 5]; and rax, 1; cmp rax, 1; jne st_cd_unclosed. (6) Schema-tag compare: mov r8, [rdi + 8]; mov r9, [rsi + 8]; cmp r8, r9; jne st_cd_schema_mismatch (E0710). (7) Success: xor rax, rax (ST_OK = 0); ret. Error returns: st_cd_bad_rec stamps rax := 0x5502; st_cd_drift 0x5513; st_cd_dir_mismatch 0x5511; st_cd_unclosed 0x5512; st_cd_schema_mismatch 0x5510. All cmp immediates (0, 1, 0x53534553, status codes 0x5502..0x5513, field offsets 0, 4, 5, 8) fit imm32 with bit 31 clear. No test; no and-imm64 (the CLOSED-flag mask uses imm8 `and rax, 1`); no 2-op imul-r-imm; no multiline let; no three-term addressing. Labels prefixed st_cd_.",
      block: {
        // ---- Validate record pointers ----------------------------------
        cmp rdi, 0;
        je  st_cd_bad_rec;
        cmp rsi, 0;
        je  st_cd_bad_rec;

        // ---- Validate magic on both halves (E0713 PROTOCOL_DRIFT) ------
        xor rax, rax;
        mov_d rax, [rdi + 0];                  // edge_a.magic u32
        cmp rax, 0x53534553;                   // ST_RECORD_MAGIC
        jne st_cd_drift;

        xor rax, rax;
        mov_d rax, [rsi + 0];                  // edge_b.magic u32
        cmp rax, 0x53534553;
        jne st_cd_drift;

        // ---- Validate direction bytes in {0, 1} (E0713) ----------------
        xor r8, r8;
        mov_b r8, [rdi + 4];                   // edge_a.direction u8
        cmp r8, 1;
        ja  st_cd_drift;                       // > 1 is drift

        xor r9, r9;
        mov_b r9, [rsi + 4];                   // edge_b.direction u8
        cmp r9, 1;
        ja  st_cd_drift;

        // ---- Direction must differ (E0711 DIRECTION_MISMATCH) ----------
        cmp r8, r9;
        je  st_cd_dir_mismatch;

        // ---- Both halves must have CLOSED bit set (E0712 UNCLOSED) -----
        xor rax, rax;
        mov_b rax, [rdi + 5];                  // edge_a.flags u8
        and rax, 1;                            // imm8; isolate ST_FLAG_CLOSED
        cmp rax, 1;
        jne st_cd_unclosed;

        xor rax, rax;
        mov_b rax, [rsi + 5];                  // edge_b.flags u8
        and rax, 1;                            // imm8
        cmp rax, 1;
        jne st_cd_unclosed;

        // ---- Schema-tag hashes must match (E0710 SCHEMA_MISMATCH) ------
        mov r8, [rdi + 8];                     // edge_a.schema_tag_hash u64
        mov r9, [rsi + 8];                     // edge_b.schema_tag_hash u64
        cmp r8, r9;
        jne st_cd_schema_mismatch;

        // ---- Success ---------------------------------------------------
        xor rax, rax;                          // ST_OK = 0
        ret;

        // ---- Error return paths ----------------------------------------
      st_cd_bad_rec:
        mov rax, 0x5502;                       // ST_ERR_BAD_RECORD
        ret;

      st_cd_drift:
        mov rax, 0x5513;                       // ST_ERR_PROTOCOL_DRIFT (E0713)
        ret;

      st_cd_dir_mismatch:
        mov rax, 0x5511;                       // ST_ERR_DIRECTION_MISMATCH (E0711)
        ret;

      st_cd_unclosed:
        mov rax, 0x5512;                       // ST_ERR_UNCLOSED_SESSION (E0712)
        ret;

      st_cd_schema_mismatch:
        mov rax, 0x5510;                       // ST_ERR_SCHEMA_MISMATCH (E0710)
        ret;
      }
    }

  // ==========================================================================
  // _st_render(record, out, out_cap) -> packed_u64
  //
  //   rdi = record            (ptr to 32-B SessionType record)
  //   rsi = out               (ptr to caller buffer)
  //   rdx = out_cap           (byte capacity of out)
  //   rax = (bytes_written << 32) | status
  //
  // Renders a human-readable surface form into out:
  //   direction 0 -> '!' prefix
  //   direction 1 -> '?' prefix
  //   schema name copied from [record + 16..+32] stopping at first NUL
  //     (0..16 bytes)
  //   suffix ';done' (5 B) iff ST_FLAG_CLOSED set, else ';open'
  //
  // Total bytes_written = 1 + schema_len + 5 (6..22 bytes).
  //
  // Pure leaf -- no nested CALL. Prologue: 2 callee-save pushes
  // (rbx = record, r12 = out). Labels prefixed st_rn_.
  // ==========================================================================
  pub let _st_render : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (record: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R223.M7 (#2672): _st_render emits a human-readable surface form of a SessionType record into out[0..total_bytes). Pure leaf; no nested CALL. 2 callee-save pushes (rbx=record, r12=out). Flow: (1) Validate record != 0 (cmp rdi, 0; je st_rn_bad_rec). (2) Validate out != 0 (cmp rsi, 0; je st_rn_oos). (3) Validate magic 'SESS' at [record + 0]: xor rax, rax; mov_d rax, [rbx + 0]; cmp rax, 0x53534553; jne st_rn_drift. (4) Load direction byte at [record + 4] into r8: xor r8, r8; mov_b r8, [rbx + 4]; cmp r8, 1; ja st_rn_drift (direction > 1 is drift). (5) Load flags byte at [record + 5] into r9: xor r9, r9; mov_b r9, [rbx + 5]; and r9, 1 (imm8 isolate CLOSED). (6) Scan schema name [record + 16..+32] for first NUL to compute schema_len: xor r10, r10; each iter cmp r10, 16; jae done; mov r11, rbx; add r11, 16; add r11, r10; xor rax, rax; mov_b rax, [r11 + 0]; cmp rax, 0; je done; add r10, 1; jmp. Save r10 into r13 as schema_len. (7) Compute total_bytes = 1 + schema_len + 5 into rcx: mov rcx, r13; add rcx, 6. Validate out_cap (rdx) >= rcx: cmp rdx, rcx; jb st_rn_oos. (8) Write prefix byte: compute '!' (0x21) if direction=0, '?' (0x3F) if direction=1. Branch via cmp r8, 0; je st_rn_prefix_produce; else fall to _consume. Write byte at [out + 0] via mov_b. (9) Byte-copy schema_len bytes from [record + 16] to [out + 1]: xor r10, r10; each iter cmp r10, r13; jae done; precompute src = rbx + 16 + r10 into r11; precompute dst = r12 + 1 + r10 into r9 (both three-term precomputed to sidestep the encoder gap); byte-load into rax; byte-store. (10) Write 5-byte suffix. If CLOSED (r9==1): write ';done' = {0x3B, 0x64, 0x6F, 0x6E, 0x65}. Else: write ';open' = {0x3B, 0x6F, 0x70, 0x65, 0x6E}. Start offset = out + 1 + schema_len into r11 (precomputed via mov r11, r12; add r11, 1; add r11, r13). Branch via cmp r9, 1; je st_rn_sfx_done; else fall to _open. In each branch write five bytes via five mov_b instructions at [r11 + 0], [r11 + 1], ..., [r11 + 4] using rax as the byte-value scratch per store (each byte-value fits imm8). (11) Pack return: total_bytes already in rcx; mov rax, rcx; shl rax, 32; jmp epilogue (ST_OK = 0 so no `or`). Error paths: st_rn_bad_rec packs (0 << 32) | 0x5502; st_rn_oos packs (0 << 32) | 0x5501; st_rn_drift packs (0 << 32) | 0x5513. Epilogue: pop r12; pop rbx; wait: we also pushed r13. 3 pushes total. Actually, let's revisit: we need r13 across the loops. Push count: rbx, r12, r13 = 3. Entry rsp%16==8; +24 = rsp%16==0 but no CALL fires so alignment is moot. Epilogue pops r13, r12, rbx. All cmp immediates (0, 1, 6, 16, 0x53534553, status codes 0x5501..0x5513, field offsets 0, 4, 5, 16, suffix byte values 0x21, 0x3B, 0x3F, 0x64, 0x65, 0x6E, 0x6F, 0x70) fit imm32 with bit 31 clear. No test; no and-imm64 (CLOSED mask uses imm8); no 2-op imul; no multiline let; no three-term addressing. Labels prefixed st_rn_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push r12;
        push r13;

        // Save args into callee-save regs.
        mov rbx, rdi;                          // record
        mov r12, rsi;                          // out
        xor r13, r13;                          // schema_len = 0 (set below)

        // ---- Validate record and out pointers --------------------------
        cmp rbx, 0;
        je  st_rn_bad_rec;

        cmp r12, 0;
        je  st_rn_oos;

        // ---- Validate magic 'SESS' at [record + 0] ---------------------
        xor rax, rax;
        mov_d rax, [rbx + 0];
        cmp rax, 0x53534553;                   // ST_RECORD_MAGIC
        jne st_rn_drift;

        // ---- Load direction byte at [record + 4] into r8 ---------------
        xor r8, r8;
        mov_b r8, [rbx + 4];
        cmp r8, 1;                             // in {0, 1}?
        ja  st_rn_drift;                       // > 1 is drift

        // ---- Load flags byte at [record + 5]; isolate CLOSED bit -------
        xor r9, r9;
        mov_b r9, [rbx + 5];
        and r9, 1;                             // imm8; isolate ST_FLAG_CLOSED

        // ---- Scan schema name [record + 16..+32] for first NUL ---------
        xor r10, r10;                          // i = 0

      st_rn_scan:
        cmp r10, 16;                           // ST_SCHEMA_NAME_MAX
        jae st_rn_scan_done;
        // src_addr = record + 16 + i into r11.
        mov r11, rbx;
        add r11, 16;                           // ST_OFF_SCHEMA_NAME_INLINE
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        cmp rax, 0;
        je  st_rn_scan_done;
        add r10, 1;
        jmp st_rn_scan;

      st_rn_scan_done:
        mov r13, r10;                          // schema_len (0..16)

        // ---- Compute total_bytes = 1 + schema_len + 5 ------------------
        mov rcx, r13;
        add rcx, 6;                            // + '!' prefix + 5-byte suffix

        // ---- Validate out_cap (rdx) >= total_bytes ---------------------
        cmp rdx, rcx;
        jb  st_rn_oos;

        // ---- Write prefix byte ('!' = 0x21 or '?' = 0x3F) at [out + 0]
        cmp r8, 0;
        je  st_rn_prefix_produce;

        // CONSUME ('?')
        mov rax, 0x3F;
        mov_b [r12 + 0], rax;
        jmp st_rn_name_copy;

      st_rn_prefix_produce:
        // PRODUCE ('!')
        mov rax, 0x21;
        mov_b [r12 + 0], rax;

        // ---- Byte-copy schema[0..schema_len) from [rbx+16] to [r12+1]
      st_rn_name_copy:
        xor r10, r10;                          // i = 0

      st_rn_name_copy_loop:
        cmp r10, r13;
        jae st_rn_suffix;
        // src = record + 16 + i into r11.
        mov r11, rbx;
        add r11, 16;
        add r11, r10;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        // dst = out + 1 + i into r9.
        mov r9, r12;
        add r9, 1;
        add r9, r10;
        mov_b [r9 + 0], rax;
        add r10, 1;
        jmp st_rn_name_copy_loop;

        // ---- Suffix ----------------------------------------------------
        // r11 = &out[1 + schema_len] (start of suffix region).
      st_rn_suffix:
        mov r11, r12;
        add r11, 1;
        add r11, r13;                          // r11 = suffix base

        // Re-load flags byte from [record + 5] (r9 was clobbered as
        // the dst-address scratch inside the name-copy loop; rbx
        // still holds record across callee-save prologue).
        xor r9, r9;
        mov_b r9, [rbx + 5];
        and r9, 1;                             // imm8; isolate CLOSED

        cmp r9, 1;                             // CLOSED bit set?
        je  st_rn_sfx_done;

        // ';open' = { 0x3B, 0x6F, 0x70, 0x65, 0x6E }
        mov rax, 0x3B;                         // ';'
        mov_b [r11 + 0], rax;
        mov rax, 0x6F;                         // 'o'
        mov_b [r11 + 1], rax;
        mov rax, 0x70;                         // 'p'
        mov_b [r11 + 2], rax;
        mov rax, 0x65;                         // 'e'
        mov_b [r11 + 3], rax;
        mov rax, 0x6E;                         // 'n'
        mov_b [r11 + 4], rax;
        jmp st_rn_pack;

      st_rn_sfx_done:
        // ';done' = { 0x3B, 0x64, 0x6F, 0x6E, 0x65 }
        mov rax, 0x3B;                         // ';'
        mov_b [r11 + 0], rax;
        mov rax, 0x64;                         // 'd'
        mov_b [r11 + 1], rax;
        mov rax, 0x6F;                         // 'o'
        mov_b [r11 + 2], rax;
        mov rax, 0x6E;                         // 'n'
        mov_b [r11 + 3], rax;
        mov rax, 0x65;                         // 'e'
        mov_b [r11 + 4], rax;

      st_rn_pack:
        // Pack return: (total_bytes << 32) | ST_OK.
        mov rax, rcx;                          // total_bytes
        shl rax, 32;
        jmp st_rn_epilogue;

        // ---- Error return paths ----------------------------------------
      st_rn_bad_rec:
        xor rax, rax;
        shl rax, 32;
        or  rax, 0x5502;                       // ST_ERR_BAD_RECORD
        jmp st_rn_epilogue;

      st_rn_oos:
        xor rax, rax;
        shl rax, 32;
        or  rax, 0x5501;                       // ST_ERR_OUT_TOO_SMALL
        jmp st_rn_epilogue;

      st_rn_drift:
        xor rax, rax;
        shl rax, 32;
        or  rax, 0x5513;                       // ST_ERR_PROTOCOL_DRIFT
        jmp st_rn_epilogue;

        // ---- Epilogue --------------------------------------------------
      st_rn_epilogue:
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
