// src/multi_line.pdx -- libpdx-pds-parser.R229.M8 (paideia-os#2726)
//
// MultiLine: parser-tier incomplete-expression continuation detector.
// Scans a single input line byte stream and tracks brace / paren
// nesting, open double-quoted-string state, and trailing line-
// continuation backslash across successive `_ml_scan_line` calls
// so the shell REPL knows when to prompt for another input line
// (and with what continuation marker) before dispatching the
// accumulated bytes to the full parser.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R229 is the REPL evaluator umbrella (paideia-os#2493; design doc
// design/shell/repl-loop-scaffold.md). R229.M1 kernel-side landed
// the PROMPT/READING/PARSED/EVAL/WRITING/IDLE state machine; R229.M2
// landed SessionEnv; R229.M3 landed TypeEnv; R229.M4 landed
// JobControl; R229.M5 landed History; R229.M6 landed LineEditor
// (emacs); R229.M7 landed ViMode. R229.M8 (THIS module) lands the
// substrate every READING-mode line-commit consults before deciding
// whether to dispatch the accumulated input to the full parser or
// to keep READING on a continuation prompt.
//
// Position in the substrate graph:
//
//   TTY ISR -> _rl_tick (R229.M1) -> state := READING
//        -> on RET-commit (byte 0x0A / 0x0D):
//              _le_get_buffer(line_tmp, line_tmp_cap) -> bytes, len
//              _ml_scan_line(bytes, len) -> cont_state
//                 - 0 (COMPLETE)              : dispatch to parser
//                 - 1 (INCOMPLETE_BRACE)      : prompt with "{> "
//                 - 2 (INCOMPLETE_PAREN)      : prompt with "(> "
//                 - 3 (INCOMPLETE_STR)        : prompt with "\"> "
//                 - 4 (INCOMPLETE_BACKSLASH)  : prompt with "\\> "
//              iff dispatch:                   : _ml_reset
//              iff continue:                   : append LF to
//                                                _le_buf; redraw
//                                                prompt via
//                                                _ml_continuation_
//                                                prompt(out, cap);
//                                                stay in READING.
//        -> state := WRITING -> _rl_emit_prompt -> READING
//
// MultiLine is PARSER-TIER by geography (same satellite library as
// SessionEnv, TypeEnv, HmCore, JobControl, History, LineEditor,
// ViMode) but is NOT itself a parser -- the module stores two
// nesting-depth counters + two one-bit latches and runs a single-
// pass byte-walker over caller-supplied input. The accumulated
// bytes are STILL handed to the full parser (CtxLexer R221.M4;
// Pipeline R223.M1; etc.) after the top-level expression completes;
// MultiLine's job is strictly to answer the READING-mode question
// "did the user just finish a top-level expression?".
//
// Lives user-space because the shell runs user-space; the pool is
// caller-process-local (singleton .bss, four u64 scalars, 32 B);
// the module touches no kernel KIND and consumes no capability
// (caps.decl R229.M8 band note).
//
// Why MultiLine is distinct from R221.M4 CtxLexer:
//   * R221.M4 CtxLexer is a FULL tokeniser that classifies every
//     byte run into a 16-byte Token record with tier membership
//     (pipeline / datalog / lambda). It calls into libpdx-unicode-
//     tables for NFC normalisation + grapheme boundaries. It is the
//     authoritative lexical surface the AST, HM typechecker, and
//     REPL dispatch read from.
//   * R229.M8 MultiLine is a READING-tier HEURISTIC that runs
//     BEFORE CtxLexer sees anything. It scans RAW (not-yet-NFC)
//     bytes with no Unicode awareness because the question "is the
//     top-level expression complete?" is answered by ASCII `{`,
//     `}`, `(`, `)`, `"`, `\` -- every one of these is a single
//     byte in UTF-8. MultiLine runs ONCE per RET-commit, over the
//     bytes already in `_le_buf`; CtxLexer runs ONCE per
//     expression-commit, over the NFC-normalised byte stream.
//   * The two substrates co-exist. MultiLine's nesting counters are
//     a BUDGET APPROXIMATION of CtxLexer's `_cl_stack` + `_cl_depth`
//     for the subset of balanced tokens READING cares about. A
//     later M8.4 landing may fold the two by having MultiLine
//     consult CtxLexer's stack directly; raw M8 keeps the two
//     wholly disjoint so the READING heuristic has NO dependency
//     on CtxLexer's lazy-init surface.
//
// =============================================================================
// INCOMPLETE-EXPRESSION DETECTION
// =============================================================================
//
// Four sources of incompleteness, in priority order:
//
//   1. INCOMPLETE_STR       -- open `"` without matching close.
//                              Priority first because the string
//                              body contains unresolved `{`, `}`,
//                              `(`, `)` the brace/paren counter
//                              MUST NOT see.
//   2. INCOMPLETE_BRACE     -- `{` count > `}` count.
//   3. INCOMPLETE_PAREN     -- `(` count > `)` count.
//   4. INCOMPLETE_BACKSLASH -- trailing `\` before newline AND not
//                              inside a string.
//
// Byte-walker rules:
//
//   in_escape  = 1 (last byte, when seen inside a string, was `\`):
//     consume this byte and clear in_escape; no counter / latch change.
//
//   in_string  = 1 (we're inside a `"..."`):
//     byte == `\`: set in_escape = 1 (next byte is literal).
//     byte == `"`: clear in_string (string closed).
//     else:        no change.
//
//   neither (default parse):
//     byte == `{`: brace_depth += 1.
//     byte == `}`: brace_depth -= 1 (clamped at 0 on underflow).
//     byte == `(`: paren_depth += 1.
//     byte == `)`: paren_depth -= 1 (clamped at 0).
//     byte == `"`: set in_string = 1.
//     else:        no change.
//
// After the per-byte walk, trailing-backslash check:
//
//   iff (len > 0) AND (last_byte == `\`) AND (in_string == 0) AND
//       (in_escape == 0):
//     set _ml_backslash_pending = 1.
//   else:
//     set _ml_backslash_pending = 0.
//
// Note: in_escape is a per-call local; it resets to 0 at every
// `_ml_scan_line` entry. The CROSS-LINE latch is only
// `_ml_in_string` (so an opening `"` on line N stays active on
// line N+1 until line N+K's closing `"`). The trailing-backslash
// latch `_ml_backslash_pending` is a HEURISTIC for the UI (the
// prompt renderer); the parser proper never reads it (the next
// `_ml_scan_line` call rewrites it from scratch).
//
// =============================================================================
// STATE PRIORITY
// =============================================================================
//
// The scan returns the HIGHEST-priority incompleteness in a single
// pass:
//
//     if in_string:                 ML_STATE_INCOMPLETE_STR
//     else if brace_depth > 0:      ML_STATE_INCOMPLETE_BRACE
//     else if paren_depth > 0:      ML_STATE_INCOMPLETE_PAREN
//     else if backslash_pending:    ML_STATE_INCOMPLETE_BACKSLASH
//     else:                         ML_STATE_COMPLETE
//
// =============================================================================
// STATE
// =============================================================================
//
// All state lives in this module's own `.bss` (32 B total; four
// u64 scalars):
//
//   _ml_brace_depth        : u64  signed brace nesting depth; low
//                                 63 bits used; clamped at 0.
//   _ml_paren_depth        : u64  signed paren nesting depth; low
//                                 63 bits used; clamped at 0.
//   _ml_in_string          : u64  0 iff not in a `"..."`; 1 iff open
//                                 (low byte authoritative; high
//                                 bytes reserved).
//   _ml_backslash_pending  : u64  0 iff last `_ml_scan_line` call's
//                                 input did NOT end on a `\` outside
//                                 a string; 1 iff it did (low byte
//                                 authoritative; high bytes reserved).
//
// Cold-boot: `.bss` zero-init gives every scalar 0 (COMPLETE state).
// `_ml_init` is a defensive scrub (four u64 stores = 32 B); the
// scrub is also what `_ml_reset` does after a successful parse
// dispatch so the next prompt starts from COMPLETE.
//
// Width rationale: the two u8 fields called out in the design spec
// (`_ml_in_string` and `_ml_backslash_pending` with 6 B reserved)
// are widened to u64 scalars to keep the four-store scrub
// byte-identical with the parser-family convention (precedent:
// `_vi_mode`, `_vi_pending_op`, `_vi_pending_g`,
// `_vi_visual_anchor` are all u64 in R229.M7 even though the
// mode value is 0..3 and the two latches are 0..1); only the low
// byte of each is authoritative, and the compare-against-1 at the
// state-priority test naturally ignores the reserved high bytes.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ml_init() -> ()
//     Boot hook. Defensive scrub of the four u64 scalars (32 B).
//     Pure leaf; zero pushes; no stack frame; no nested CALL.
//
//   _ml_reset() -> ()
//     Clear every scalar (semantic hook for "an expression just
//     dispatched; start fresh" called by the REPL after a
//     COMPLETE-state RET-commit). Byte-for-byte identical scrub to
//     _ml_init at raw M8; kept as a distinct symbol so a future
//     landing that distinguishes boot-vs-expression-commit (e.g.
//     an undo ring per-expression-boundary at M8.5) can diverge
//     the two.
//
//   _ml_scan_line(bytes_ptr, len) -> continuation_state_u8
//     rdi = bytes_ptr
//     rsi = len
//     rax = ML_STATE_COMPLETE / ML_STATE_INCOMPLETE_BRACE /
//           ML_STATE_INCOMPLETE_PAREN / ML_STATE_INCOMPLETE_STR /
//           ML_STATE_INCOMPLETE_BACKSLASH
//
//     Scan one line's bytes under the walker rules above and
//     update `.bss` state in place. `in_escape` is a per-call
//     local that always starts at 0 (line boundaries never carry
//     escape state; a trailing `\` inside a string becomes
//     INCOMPLETE_STR, not INCOMPLETE_BACKSLASH, because
//     `_ml_in_string` wins the priority ladder). Pure leaf (zero
//     pushes, zero stack frame, zero nested CALL); 0-byte input
//     returns the current state without modifying `.bss`.
//
//   _ml_state() -> u8
//     Read-only state inspector for the prompt renderer and the
//     REPL dispatcher. Returns the SAME u8 the last
//     `_ml_scan_line` would return if called with (0, 0): derived
//     from the current `.bss` scalars via the priority ladder.
//     Pure leaf.
//
//   _ml_continuation_prompt(out, out_cap) -> packed_u64
//     rdi = out
//     rsi = out_cap
//     rax = (bytes_written << 32) | status
//
//     Emit the right continuation prompt for the current state:
//       ML_STATE_COMPLETE              : 0 B (nothing written;
//                                            caller uses the
//                                            session's primary
//                                            prompt).
//       ML_STATE_INCOMPLETE_BRACE      : "{> " (3 B).
//       ML_STATE_INCOMPLETE_PAREN      : "(> " (3 B).
//       ML_STATE_INCOMPLETE_STR        : "\"> " (3 B).
//       ML_STATE_INCOMPLETE_BACKSLASH  : "\\> " (3 B).
//
//     Pure leaf; zero pushes. Guards: out != 0 (ML_ERR_BAD_PTR);
//     out_cap >= needed (ML_ERR_OUT_TOO_SMALL); state in 0..4
//     (ML_ERR_BAD_STATE; defensive -- `.bss` writes never produce
//     out-of-range values).
//
// Register maps (SysV):
//
//   _ml_init()                                              -> ()
//   _ml_reset()                                             -> ()
//   _ml_scan_line(rdi, rsi)                                 -> rax
//   _ml_state()                                             -> rax
//   _ml_continuation_prompt(rdi, rsi)                       -> rax
//
// =============================================================================
// STATUS-CODE NAMESPACE  --  0x5A00..0x5AFF
// =============================================================================
//
// Multi-line packed-status range. Three slots used at R229.M8:
//
//   ML_OK                   = 0
//   ML_ERR_BAD_PTR          = 0x5A00  (_ml_continuation_prompt:
//                                      out == 0)
//   ML_ERR_OUT_TOO_SMALL    = 0x5A01  (_ml_continuation_prompt:
//                                      out_cap < needed)
//   ML_ERR_BAD_STATE        = 0x5A02  (_ml_continuation_prompt:
//                                      derived state outside 0..4;
//                                      defensive)
//
// `_ml_scan_line` and `_ml_state` return the state VALUE (0..4),
// NOT a status code; they do not fault. `_ml_init` and `_ml_reset`
// return `()` -- no status code.
//
// Slots 0x5A03..0x5AFF reserved for R229.M8.1+ follow-ups
// (ML_ERR_HERE_DOC_UNCLOSED on `<<EOF` heredoc deferred to M8.1,
// ML_ERR_MAX_NEST_DEPTH if the counters bump a safety ceiling at
// M8.2, ML_ERR_NESTED_QUOTE on `"..."..."` single-quote parallel
// at M8.3, etc.).
//
// The 0x5A00..0x5AFF carve-out skips the 0x5800..0x58FF (reserved
// for the Wave 129 parallel-arm R225.M6 landing) and 0x5900..0x59FF
// (reserved for the Wave 129 parallel-arm R227.M3 landing) bands
// and sits adjacent to the 0x5700..0x57FF R229.M7 ViMode band -- a
// downstream compound-error dispatcher can discriminate "the vi
// state machine faulted" from "the multi-line continuation
// detector faulted" via `shr r, 8; cmp r, 0x57` vs
// `cmp r, 0x5A`. Disjoint from every other parser-tier packed-
// status band in the paideia-os tree.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R229.M6 (line_editor.pdx) -- MultiLine does NOT read the
//     LineEditor .bss. The REPL dispatcher is responsible for
//     snapshotting `_le_buf[0.._le_buf_len)` via `_le_get_buffer`
//     into a scratch pool and handing (ptr, len) to
//     `_ml_scan_line`. Keeping MultiLine free of a LineEditor
//     linker reference means the module can be unit-tested
//     against a synthetic input stream with no editor state.
//
//   R229.M1 (repl_loop.pdx, kernel) -- the REPL dispatcher runs
//     `_ml_scan_line` on every RET-commit AFTER
//     `_le_get_buffer`. On COMPLETE it calls `_ml_reset` BEFORE
//     dispatching to the parser so the next expression starts
//     from the ground state; on non-COMPLETE it calls
//     `_ml_continuation_prompt` to render the appropriate marker
//     and stays in READING. The LF (0x0A) that triggered the
//     RET-commit MAY be appended to `_le_buf` via a one-byte
//     `_le_insert_bytes(ptr=&lf, len=1)` BEFORE the continuation
//     prompt redraws so the accumulated expression is a single
//     byte stream the full parser can tokenise once the final
//     line commits.
//
//   R221.M4 (ctx_lexer.pdx) -- MultiLine runs BEFORE CtxLexer.
//     The two share no linker-visible state at raw M8. If a
//     future M8.4 wires the two by having MultiLine consult
//     `_cl_depth` as a cross-check, the dependency enters as a
//     one-way intra-library linker reference identical in shape
//     to R229.M7's six-reference pattern against R229.M6's `.bss`
//     singletons.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32; the low-
//     byte mask `and rax, 0xFF` fits imm32 with bit 31 clear.
//   - No 2-op `imul r, imm` -- no stride multiplies at this tier
//     (every address uses `[base + idx * 1]` with idx a scratch
//     register loop counter).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `MultiLine` matches `multi_line.pdx`.
//   - Labels prefixed `ml_` with per-function suffix (`ml_ini_`,
//     `ml_rst_`, `ml_scan_`, `ml_st_`, `ml_cp_`). Disjoint from
//     every landed parser-tier prefix (confirmed grep-clean against
//     `le_`, `vi_`, `lp_`, `st_` R229/R223/R224 bands; `h_`
//     R229.M5 History; `cl_` R221.M4 CtxLexer; etc.) and from the
//     paideia-as reserved keywords (`loop`, `if`, `let`, `fn`,
//     `ret`, `done`).
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 32, status
//     codes 0x5A00..0x5A02, byte literals 0x22 '"', 0x28 '(',
//     0x29 ')', 0x5C '\', 0x7B '{', 0x7D '}') fit imm32 with bit
//     31 clear so direct cmp-imm32 is sign-safe. No MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`.
//   - Byte stores via `mov_b [dst + idx], reg`.
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - `.bss` writes via `lea r11, [rip + sym]; mov [r11], reg`.
//     r11 is used freely as a staging register throughout the
//     module because no public entry point has a nested CALL.
//   - `_ml_scan_line` is a PURE LEAF: ZERO callee-save pushes,
//     ZERO stack frame, ZERO nested CALL. State across iterations
//     lives in rcx (in_string), rdx (in_escape), r8 (loop idx),
//     r9 (brace_depth), r10 (paren_depth) -- all SysV caller-save
//     scratch, no save required (we have no CALL to clobber them).
//     Entry rsp%16==8 steady; final `ret` leaves rsp%16==0.
//   - `_ml_init`, `_ml_reset`, `_ml_state`, and
//     `_ml_continuation_prompt` are PURE LEAVES with zero pushes.
//   - Three-term address computations `[base + off + idx]` are
//     pre-computed into a scratch register via `mov; add; add`
//     sequences; the only two-register addressing form used is
//     `[base + idx * 1]`.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R229.M8.1  Heredoc: `<<EOF` ... `EOF` on its own line. Adds a
//              fifth INCOMPLETE kind (`ML_STATE_INCOMPLETE_HEREDOC`
//              = 5) + a per-session heredoc-tag pool (16 slots x
//              16 B = 256 B `.bss`). Status code
//              ML_ERR_HERE_DOC_UNCLOSED at 0x5A03.
//   R229.M8.2  Safety ceiling: cap `brace_depth` and `paren_depth`
//              at 128; emit ML_ERR_MAX_NEST_DEPTH at 0x5A04 on
//              overflow. Prevents a corrupt input from running
//              the counters past int64 overflow if a `}` is lost
//              to byte-level corruption upstream.
//   R229.M8.3  Single-quote parallel: track `'...'` string state
//              alongside `"..."`; a mismatched close within either
//              variant surfaces as ML_ERR_NESTED_QUOTE at 0x5A05.
//   R229.M8.4  CtxLexer bridge: MultiLine consults
//              `_cl_depth` / `_cl_stack[_cl_depth - 1]` as a
//              cross-check against its own counters. Divergence
//              surfaces as a klog_s1 fingerprint
//              "ML DEPTH DIVERGENCE ..." but does NOT fault
//              READING-mode dispatch.
//   R229.M8.5  Expression-boundary undo-ring hook: `_ml_reset`
//              gains a semantic distinct from `_ml_init` by
//              snapshotting the just-dispatched expression's byte
//              image into a 16-slot ring the C-x C-u emacs
//              binding + vi `u` can walk back through.
//   R229.M8.6  Nested bracket discrimination: `[` / `]` tracked
//              separately from `(` / `)` for the per-record-stage
//              projection syntax surface.
//   R229.M8.7  Smoke-mode fingerprint goldens for the acceptance
//              15-expression corpus from design doc §5.
//   R229.M8.8  Line-continuation inside a string: the current
//              design treats `\\n` inside `"..."` as literal; a
//              future landing may recognise `\\\n` (backslash
//              before LF) inside a string as a continuation
//              marker that keeps the string open across a line
//              boundary without the LF appearing in the final
//              string value.
//
// =============================================================================
// Upstream: paideia-os#2493 (R229 REPL evaluator umbrella),
// paideia-os#2726 (THIS ticket, R229.M8 Multi-line input for
// incomplete expressions), paideia-os#2724 (R229.M6 LineEditor
// substrate), paideia-os#2725 (R229.M7 ViMode satellite). Design
// doc: design/shell/multi-line-input.md.

module MultiLine = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax low 32 bits)
  // ==========================================================================

  pub let ML_OK                 : u64 = 0
  pub let ML_ERR_BAD_PTR        : u64 = 0x5A00
  pub let ML_ERR_OUT_TOO_SMALL  : u64 = 0x5A01
  pub let ML_ERR_BAD_STATE      : u64 = 0x5A02

  // ==========================================================================
  // SECTION 2 -- CONTINUATION-STATE VALUES
  // ==========================================================================
  //
  // Returned as the low 8 bits of rax by _ml_scan_line and _ml_state;
  // consumed by _ml_continuation_prompt to pick the right prompt
  // marker.

  pub let ML_STATE_COMPLETE              : u64 = 0
  pub let ML_STATE_INCOMPLETE_BRACE      : u64 = 1
  pub let ML_STATE_INCOMPLETE_PAREN      : u64 = 2
  pub let ML_STATE_INCOMPLETE_STR        : u64 = 3
  pub let ML_STATE_INCOMPLETE_BACKSLASH  : u64 = 4

  // ==========================================================================
  // SECTION 3 -- STATIC STATE (.bss, singleton)
  // ==========================================================================
  //
  // Cold-boot .bss zero-init gives every scalar 0 which is the
  // COMPLETE ground state. `_ml_init` is a defensive scrub.

  pub let mut _ml_brace_depth        : u64 = uninit @align(8)
  pub let mut _ml_paren_depth        : u64 = uninit @align(8)
  pub let mut _ml_in_string          : u64 = uninit @align(8)
  pub let mut _ml_backslash_pending  : u64 = uninit @align(8)

  // ==========================================================================
  // _ml_init() -> ()
  //
  //   Boot hook. Defensive scrub of the four u64 scalars (32 B).
  //   `.bss` zero-init already satisfies the cold-boot invariant;
  //   this entry point exists for chaos-restart / test-time reset.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ml_ini_.
  // ==========================================================================
  pub let _ml_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M8 (#2726): defensive scrub of the four u64 scalars (_ml_brace_depth, _ml_paren_depth, _ml_in_string, _ml_backslash_pending). .bss zero-init at program load already satisfies the cold-boot semantic (every scalar == 0 = COMPLETE); this entry point exists for test-time reset + chaos-restart. Pure leaf; zero pushes; no stack frame; no nested CALL. Each store is `lea r11, [rip + sym]; mov [r11], rax` with rax=0. All immediates (0) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ml_ini_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _ml_brace_depth];
        mov [r11], rax;

        lea r11, [rip + _ml_paren_depth];
        mov [r11], rax;

        lea r11, [rip + _ml_in_string];
        mov [r11], rax;

        lea r11, [rip + _ml_backslash_pending];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _ml_reset() -> ()
  //
  //   Expression-boundary hook. Clear every scalar after a
  //   successful COMPLETE-state parse dispatch so the next
  //   expression starts from the ground state. Byte-for-byte
  //   identical scrub to _ml_init at raw M8; distinct symbol so a
  //   future M8.5 landing (expression-boundary undo ring) can
  //   diverge the two.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ml_rst_.
  // ==========================================================================
  pub let _ml_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M8 (#2726): clear every scalar after a COMPLETE-state parse dispatch so the next expression starts clean. Byte-identical to _ml_init at raw M8; distinct symbol for the parser-family init-vs-reset convention (precedent: _le_init vs _le_reset in R229.M6; _vi_init vs _vi_reset in R229.M7). Pure leaf; zero pushes; no stack frame; no nested CALL. Each store is `lea r11, [rip + sym]; mov [r11], rax` with rax=0. All immediates (0) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ml_rst_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _ml_brace_depth];
        mov [r11], rax;

        lea r11, [rip + _ml_paren_depth];
        mov [r11], rax;

        lea r11, [rip + _ml_in_string];
        mov [r11], rax;

        lea r11, [rip + _ml_backslash_pending];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _ml_scan_line(bytes_ptr, len) -> continuation_state_u8
  //
  //   rdi = bytes_ptr
  //   rsi = len
  //   rax = continuation state (0..4) in low byte
  //
  //   Scan one line's bytes under the walker rules documented in
  //   the header. Mutates `.bss` scalars in place. Returns the
  //   priority-ladder-derived state after the scan.
  //
  //   Register plan (SysV scratch only; ZERO pushes; PURE LEAF):
  //     rdi = bytes_ptr (input, preserved)
  //     rsi = len (input, preserved)
  //     rax = scratch byte read; final return
  //     rcx = in_string (loaded from .bss; written back)
  //     rdx = in_escape (per-call local; starts at 0)
  //     r8  = loop index i
  //     r9  = brace_depth (loaded from .bss; written back)
  //     r10 = paren_depth (loaded from .bss; written back)
  //     r11 = .bss lea staging
  //
  //   No CALL inside this function so r11 may be used freely as a
  //   staging register. Entry rsp%16==8; `ret` leaves rsp%16==0.
  //
  //   Labels prefixed ml_scan_.
  // ==========================================================================
  pub let _ml_scan_line : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M8 (#2726): scan one line's bytes under the byte-walker rules (header INCOMPLETE-EXPRESSION DETECTION section) and update `.bss` scalars in place. Pure leaf; zero pushes; zero stack frame; zero nested CALL. State across iterations lives in rcx (in_string), rdx (in_escape, per-call local), r8 (i), r9 (brace_depth), r10 (paren_depth) -- all SysV caller-save. r11 is used freely as .bss lea staging because no nested CALL exists. Load `.bss` state at entry; branch by byte at each iteration; clamp depths to 0 on underflow; write `.bss` state back at loop exit; derive priority-ladder state (STR > BRACE > PAREN > BACKSLASH > COMPLETE). After the per-byte walk, trailing-backslash check: iff (len > 0) AND (in_string == 0) AND (last_byte == 0x5C), set backslash_pending = 1 else 0. The in_escape latch is a per-call local (initialised to 0 at entry); it does NOT carry across `_ml_scan_line` calls (a trailing `\\` inside a string becomes INCOMPLETE_STR by priority, not INCOMPLETE_BACKSLASH). All cmp immediates (0, 1, 2, 3, 4, 0x22 '\"', 0x28 '(', 0x29 ')', 0x5C '\\\\', 0x7B '{', 0x7D '}') fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ml_scan_.",
      block: {
        // ---- Load `.bss` state at entry.
        lea r11, [rip + _ml_brace_depth];
        mov r9, [r11];                     // r9 = brace_depth
        lea r11, [rip + _ml_paren_depth];
        mov r10, [r11];                    // r10 = paren_depth
        lea r11, [rip + _ml_in_string];
        mov rcx, [r11];                    // rcx = in_string

        // ---- Per-call local: in_escape := 0 (never carries
        //      across `_ml_scan_line` calls).
        xor rdx, rdx;

        // ---- Clear backslash_pending defensively; we will set it
        //      to 1 only if the trailing-byte check succeeds.
        xor rax, rax;
        lea r11, [rip + _ml_backslash_pending];
        mov [r11], rax;

        // ---- Loop i = 0 .. len-1.
        xor r8, r8;                        // i = 0

      ml_scan_top:
        cmp r8, rsi;
        jae ml_scan_loop_done;

        // ---- Load byte.
        xor rax, rax;
        mov_b rax, [rdi + r8 * 1];

        // ---- in_escape branch (we are consuming an escaped byte
        //      from inside a string; clear escape and advance).
        cmp rdx, 1;
        je  ml_scan_consume_escape;

        // ---- in_string branch.
        cmp rcx, 1;
        je  ml_scan_in_string;

        // =====================================================
        // Default parse: outside any string, no pending escape.
        // =====================================================
        cmp rax, 0x7B;                     // '{'
        je  ml_scan_brace_up;
        cmp rax, 0x7D;                     // '}'
        je  ml_scan_brace_down;
        cmp rax, 0x28;                     // '('
        je  ml_scan_paren_up;
        cmp rax, 0x29;                     // ')'
        je  ml_scan_paren_down;
        cmp rax, 0x22;                     // '"'
        je  ml_scan_enter_string;
        // Backslash OUTSIDE a string carries no mid-line meaning;
        // the trailing-byte post-pass is what decides line
        // continuation. All other bytes are no-ops.
        jmp ml_scan_next_iter;

      ml_scan_brace_up:
        add r9, 1;
        jmp ml_scan_next_iter;

      ml_scan_brace_down:
        // Clamp at 0 on underflow (extra `}` with no matching `{`
        // is tolerated; the shell's full parser catches it later).
        cmp r9, 0;
        je  ml_scan_next_iter;
        sub r9, 1;
        jmp ml_scan_next_iter;

      ml_scan_paren_up:
        add r10, 1;
        jmp ml_scan_next_iter;

      ml_scan_paren_down:
        cmp r10, 0;
        je  ml_scan_next_iter;
        sub r10, 1;
        jmp ml_scan_next_iter;

      ml_scan_enter_string:
        mov rcx, 1;                        // in_string = 1
        jmp ml_scan_next_iter;

        // =====================================================
        // in_string branch: we're inside a `"..."`. Only `"` and
        // `\` matter; everything else is literal body.
        // =====================================================
      ml_scan_in_string:
        cmp rax, 0x5C;                     // '\'
        je  ml_scan_set_escape;
        cmp rax, 0x22;                     // '"'
        je  ml_scan_exit_string;
        jmp ml_scan_next_iter;

      ml_scan_set_escape:
        mov rdx, 1;                        // in_escape = 1
        jmp ml_scan_next_iter;

      ml_scan_exit_string:
        xor rcx, rcx;                      // in_string = 0
        jmp ml_scan_next_iter;

        // =====================================================
        // in_escape consume: eat one byte literal, clear escape.
        // =====================================================
      ml_scan_consume_escape:
        xor rdx, rdx;                      // in_escape = 0
        jmp ml_scan_next_iter;

      ml_scan_next_iter:
        add r8, 1;
        jmp ml_scan_top;

      ml_scan_loop_done:
        // ---- Write back `.bss` state.
        lea r11, [rip + _ml_brace_depth];
        mov [r11], r9;
        lea r11, [rip + _ml_paren_depth];
        mov [r11], r10;
        lea r11, [rip + _ml_in_string];
        mov [r11], rcx;

        // ---- Trailing-backslash check. iff (len > 0) AND
        //      (in_string == 0) AND (last_byte == 0x5C), set
        //      backslash_pending = 1.
        cmp rsi, 0;
        je  ml_scan_decide;                // len == 0: skip
        cmp rcx, 0;
        jne ml_scan_decide;                // in_string: skip
        mov r11, rsi;
        sub r11, 1;                        // r11 = len - 1
        xor rax, rax;
        mov_b rax, [rdi + r11 * 1];        // rax = last byte
        cmp rax, 0x5C;                     // '\'
        jne ml_scan_decide;
        // Set backslash_pending = 1.
        mov rax, 1;
        lea r11, [rip + _ml_backslash_pending];
        mov [r11], rax;

      ml_scan_decide:
        // ---- Derive state via priority ladder.
        //      STR > BRACE > PAREN > BACKSLASH > COMPLETE.
        //      rcx, r9, r10 still hold in_string, brace_depth,
        //      paren_depth. backslash_pending is now in .bss.
        cmp rcx, 1;
        je  ml_scan_result_str;
        cmp r9, 0;
        ja  ml_scan_result_brace;
        cmp r10, 0;
        ja  ml_scan_result_paren;
        // Check backslash_pending.
        lea r11, [rip + _ml_backslash_pending];
        mov rax, [r11];
        cmp rax, 1;
        je  ml_scan_result_backslash;
        // Fall through: COMPLETE.
        xor rax, rax;                      // ML_STATE_COMPLETE = 0
        ret;

      ml_scan_result_brace:
        mov rax, 1;                        // ML_STATE_INCOMPLETE_BRACE
        ret;

      ml_scan_result_paren:
        mov rax, 2;                        // ML_STATE_INCOMPLETE_PAREN
        ret;

      ml_scan_result_str:
        mov rax, 3;                        // ML_STATE_INCOMPLETE_STR
        ret;

      ml_scan_result_backslash:
        mov rax, 4;                        // ML_STATE_INCOMPLETE_BACKSLASH
        ret;
      }
    }

  // ==========================================================================
  // _ml_state() -> u8
  //
  //   Returns the priority-ladder-derived continuation state from
  //   the current `.bss` scalars without touching them. Useful
  //   for the prompt renderer / REPL dispatcher when it wants to
  //   know "where are we right now?" without re-scanning a line.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ml_st_.
  // ==========================================================================
  pub let _ml_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M8 (#2726): read-only state inspector. Returns the same priority-ladder-derived state (STR > BRACE > PAREN > BACKSLASH > COMPLETE) `_ml_scan_line` would return at its decide label. Pure leaf; zero pushes; no stack frame; no nested CALL. Loads the four scalars via `lea r11, [rip + sym]; mov r?, [r11]` and runs the ladder. All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ml_st_.",
      block: {
        // Load in_string.
        lea r11, [rip + _ml_in_string];
        mov rcx, [r11];
        cmp rcx, 1;
        je  ml_st_result_str;
        // Load brace_depth.
        lea r11, [rip + _ml_brace_depth];
        mov r9, [r11];
        cmp r9, 0;
        ja  ml_st_result_brace;
        // Load paren_depth.
        lea r11, [rip + _ml_paren_depth];
        mov r10, [r11];
        cmp r10, 0;
        ja  ml_st_result_paren;
        // Load backslash_pending.
        lea r11, [rip + _ml_backslash_pending];
        mov rax, [r11];
        cmp rax, 1;
        je  ml_st_result_backslash;
        xor rax, rax;                      // ML_STATE_COMPLETE
        ret;

      ml_st_result_brace:
        mov rax, 1;
        ret;

      ml_st_result_paren:
        mov rax, 2;
        ret;

      ml_st_result_str:
        mov rax, 3;
        ret;

      ml_st_result_backslash:
        mov rax, 4;
        ret;
      }
    }

  // ==========================================================================
  // _ml_continuation_prompt(out, out_cap) -> packed_u64
  //
  //   rdi = out
  //   rsi = out_cap
  //   rax = (bytes_written << 32) | status
  //
  //   Emit the right continuation prompt for the current state.
  //   See the header's PUBLIC API section for the per-state
  //   prompt byte strings.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ml_cp_.
  // ==========================================================================
  pub let _ml_continuation_prompt : (u64, u64) -> u64 !{mem} @{} =
    fn (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M8 (#2726): emit the per-state continuation prompt byte string. Pure leaf; zero pushes; no stack frame; no nested CALL. Guards: out != 0 (ML_ERR_BAD_PTR); state in 0..4 (ML_ERR_BAD_STATE); out_cap >= needed bytes (ML_ERR_OUT_TOO_SMALL). Derive state inline via the same priority ladder _ml_state uses (STR > BRACE > PAREN > BACKSLASH > COMPLETE). Byte strings: COMPLETE -> 0 B (return (0 << 32) | ML_OK); INCOMPLETE_BRACE -> \"{> \" (3 B: 0x7B 0x3E 0x20); INCOMPLETE_PAREN -> \"(> \" (3 B: 0x28 0x3E 0x20); INCOMPLETE_STR -> \\\"> \" (3 B: 0x22 0x3E 0x20); INCOMPLETE_BACKSLASH -> \"\\\\> \" (3 B: 0x5C 0x3E 0x20). Writes bytes via `mov_b [out + idx], imm8`-equivalent (`xor rax, rax; mov rax, imm8; mov_b [out + N], rax`). Returns packed_u64 = (3 << 32) | ML_OK on INCOMPLETE_*; (0 << 32) | ML_OK on COMPLETE. All cmp immediates (0, 1, 2, 3, 4, status codes 0x5A00..0x5A02, byte literals 0x20, 0x22, 0x28, 0x3E, 0x5C, 0x7B) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ml_cp_.",
      block: {
        // ---- Guard: out != 0.
        cmp rdi, 0;
        je  ml_cp_bad_ptr;

        // ---- Derive state (priority ladder; identical to _ml_state).
        lea r11, [rip + _ml_in_string];
        mov rcx, [r11];
        cmp rcx, 1;
        je  ml_cp_state_str;
        lea r11, [rip + _ml_brace_depth];
        mov r9, [r11];
        cmp r9, 0;
        ja  ml_cp_state_brace;
        lea r11, [rip + _ml_paren_depth];
        mov r10, [r11];
        cmp r10, 0;
        ja  ml_cp_state_paren;
        lea r11, [rip + _ml_backslash_pending];
        mov rax, [r11];
        cmp rax, 1;
        je  ml_cp_state_backslash;

        // ---- COMPLETE: emit zero bytes, return (0 << 32) | ML_OK.
        xor rax, rax;
        ret;

        // ---- INCOMPLETE_BRACE: emit "{> " (3 B).
      ml_cp_state_brace:
        cmp rsi, 3;
        jb  ml_cp_oos;
        mov rax, 0x7B;                     // '{'
        mov_b [rdi + 0], rax;
        mov rax, 0x3E;                     // '>'
        mov_b [rdi + 1], rax;
        mov rax, 0x20;                     // ' '
        mov_b [rdi + 2], rax;
        mov rax, 3;
        shl rax, 32;                       // (3 << 32) | ML_OK (ML_OK=0)
        ret;

        // ---- INCOMPLETE_PAREN: emit "(> " (3 B).
      ml_cp_state_paren:
        cmp rsi, 3;
        jb  ml_cp_oos;
        mov rax, 0x28;                     // '('
        mov_b [rdi + 0], rax;
        mov rax, 0x3E;                     // '>'
        mov_b [rdi + 1], rax;
        mov rax, 0x20;                     // ' '
        mov_b [rdi + 2], rax;
        mov rax, 3;
        shl rax, 32;
        ret;

        // ---- INCOMPLETE_STR: emit "\"> " (3 B).
      ml_cp_state_str:
        cmp rsi, 3;
        jb  ml_cp_oos;
        mov rax, 0x22;                     // '"'
        mov_b [rdi + 0], rax;
        mov rax, 0x3E;                     // '>'
        mov_b [rdi + 1], rax;
        mov rax, 0x20;                     // ' '
        mov_b [rdi + 2], rax;
        mov rax, 3;
        shl rax, 32;
        ret;

        // ---- INCOMPLETE_BACKSLASH: emit "\> " (3 B).
      ml_cp_state_backslash:
        cmp rsi, 3;
        jb  ml_cp_oos;
        mov rax, 0x5C;                     // '\'
        mov_b [rdi + 0], rax;
        mov rax, 0x3E;                     // '>'
        mov_b [rdi + 1], rax;
        mov rax, 0x20;                     // ' '
        mov_b [rdi + 2], rax;
        mov rax, 3;
        shl rax, 32;
        ret;

      ml_cp_bad_ptr:
        mov rax, 0x5A00;                   // ML_ERR_BAD_PTR
        ret;

      ml_cp_oos:
        mov rax, 0x5A01;                   // ML_ERR_OUT_TOO_SMALL
        ret;
      }
    }

}
