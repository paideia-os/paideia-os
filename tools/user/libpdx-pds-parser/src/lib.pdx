  pub let LPX_PDS_PARSER_R226_M2_READY : u64 = 0   // R226.M2 predicate-type resolution
  pub let LPX_PDS_PARSER_R226_M3_READY : u64 = 0   // R226.M3 bottom-up semi-naive evaluator
  pub let LPX_PDS_PARSER_R226_M4_READY : u64 = 0   // R226.M4 magic-set rewriting
  pub let LPX_PDS_PARSER_R226_M5_READY : u64 = 0   // R226.M5 stratified negation
  pub let LPX_PDS_PARSER_R226_M6_READY : u64 = 0   // R226.M6 aggregation library
  pub let LPX_PDS_PARSER_R226_M7_READY : u64 = 0   // R226.M7 typed-graph effect
  pub let LPX_PDS_PARSER_R226_M8_READY : u64 = 0   // R226.M8 session-local EDB
  pub let LPX_PDS_PARSER_R226_M9_READY : u64 = 0   // R226.M9 query-time type-check
  pub let LPX_PDS_PARSER_R226_M10_READY : u64 = 0  // R226.M10 progress emission
  pub let LPX_PDS_PARSER_R226_M11_READY : u64 = 0  // R226.M11 per-query fingerprint

