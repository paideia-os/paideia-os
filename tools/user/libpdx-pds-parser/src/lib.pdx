  //
  // 1 iff the corresponding milestone's surface is landed in this
  // library. Consumers that want to feature-detect at startup read
  // these constants and gate on them before calling the matching
  // entry points.

  // R221 wave (parser-tier Unicode + lexer):
  pub let LPX_PDS_PARSER_M1_READY : u64 = 1   // R221.M1 UTF-8 decoder + NFC normalizer
  pub let LPX_PDS_PARSER_M2_READY : u64 = 1   // R221.M2 grapheme cluster iterator (TR#29)
  pub let LPX_PDS_PARSER_M3_READY : u64 = 1   // R221.M3 width pass (TR#11)
  pub let LPX_PDS_PARSER_M4_READY : u64 = 1   // R221.M4 context-tracking lexer
  pub let LPX_PDS_PARSER_M5_READY : u64 = 1   // R221.M5 unified AST
  pub let LPX_PDS_PARSER_M6_READY : u64 = 0   // R221.M6 span-mapping NFC variant
  pub let LPX_PDS_PARSER_M7_READY : u64 = 0   // R221.M7 parser fuzz corpus

  // R222 wave (cmd-functor):
  pub let LPX_PDS_PARSER_R222_M1_READY : u64 = 1   // R222.M1 SchemasSig body parser
  pub let LPX_PDS_PARSER_R222_M2_READY : u64 = 1   // R222.M2 CommandSig body parser (name + caps + version + stability)
  pub let LPX_PDS_PARSER_R222_M3_READY : u64 = 1   // R222.M3 Functor instantiation materialization record
  pub let LPX_PDS_PARSER_R222_M4_READY : u64 = 1   // R222.M4 ArgSpec + FlagSpec
  pub let LPX_PDS_PARSER_R222_M5_READY : u64 = 1   // R222.M5 registry client
  pub let LPX_PDS_PARSER_R222_M6_READY : u64 = 0   // R222.M6 commands.toml bind
  pub let LPX_PDS_PARSER_R222_M7_READY : u64 = 0   // R222.M7 cmd-functor fuzz corpus
  pub let LPX_PDS_PARSER_R222_M8_READY : u64 = 0   // R222.M8 `describe <cmd>` serialization

  // R223 wave (pipeline-lang):
  pub let LPX_PDS_PARSER_R223_M1_READY : u64 = 1   // R223.M1 Pipeline stage parser + `|`
  pub let LPX_PDS_PARSER_R223_M2_READY : u64 = 1   // R223.M2 Record projection: select/project FIELDS
  pub let LPX_PDS_PARSER_R223_M3_READY : u64 = 0   // R223.M3 redirection operators
  pub let LPX_PDS_PARSER_R223_M4_READY : u64 = 0   // R223.M4 @hostname annotation
  pub let LPX_PDS_PARSER_R223_M5_READY : u64 = 0   // R223.M5 flag/positional partition
  pub let LPX_PDS_PARSER_R223_M6_READY : u64 = 0   // R223.M6 canonical-form renderer
  pub let LPX_PDS_PARSER_R223_M7_READY : u64 = 0   // R223.M7 pipeline fuzz corpus

  // R224 wave (lambda-lang):
  pub let LPX_PDS_PARSER_R224_M1_READY : u64 = 1   // R224.M1 Lambda literal grammar
  pub let LPX_PDS_PARSER_R224_M2_READY : u64 = 1   // R224.M2 Closure capture over pipeline-scope bindings
  pub let LPX_PDS_PARSER_R224_M3_READY : u64 = 1   // R224.M3 effect polymorphism (effect rows + subtype)
  pub let LPX_PDS_PARSER_R224_M4_READY : u64 = 1   // R224.M4 capability-row typing
  pub let LPX_PDS_PARSER_R224_M5_READY : u64 = 1   // R224.M5 nested lambda + let-rec scoping (LetScope)
  pub let LPX_PDS_PARSER_R224_M6_READY : u64 = 0   // R224.M6 first-class pipeline value
  pub let LPX_PDS_PARSER_R224_M7_READY : u64 = 0   // R224.M7 linear/affine propagation

  // R225 wave (HM typechecker over the unified pds-lang AST):
  pub let LPX_PDS_PARSER_R225_M1_READY : u64 = 1   // R225.M1 HM algorithm W core (unify + instantiate + generalise)
  pub let LPX_PDS_PARSER_R225_M2_READY : u64 = 1   // R225.M2 pipeline-record row types
  pub let LPX_PDS_PARSER_R225_M3_READY : u64 = 0   // R225.M3 Datalog predicate types via schema registry
  pub let LPX_PDS_PARSER_R225_M4_READY : u64 = 0   // R225.M4 effect-row unification
  pub let LPX_PDS_PARSER_R225_M5_READY : u64 = 0   // R225.M5 cross-context type flow
