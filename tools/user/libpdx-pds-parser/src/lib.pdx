// src/lib.pdx -- libpdx-pds-parser.M1 (paideia-os#2651, R221.M1)
//
// LibpdxPdsParser: library umbrella module.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This file is the library's SELF-DESCRIBING manifest: it carries the
// version triple and the per-milestone feature-ready flags that a
// consumer can `cmp`-against to feature-gate on a specific wave's
// surface.
//
// It intentionally carries NO per-primitive logic -- every real
// parser-tier primitive lives in its own module file (src/utf8_nfc.pdx
// at R221.M1; src/grapheme_iter.pdx at R221.M2; src/width_pass.pdx at
// R221.M3; src/lexer.pdx at R221.M4; src/ast.pdx at R221.M5; etc.).
// This mirrors the shape libpdx-unicode-tables uses.
//
// =============================================================================
// VERSIONING + FEATURE GATES
// =============================================================================
//
// LPX_PDS_PARSER_VERSION_MAJOR / _MINOR / _PATCH follow SemVer. The
// MAJOR bump signals an incompatible API change (an entry point's
// signature changing, a status band moving); MINOR is additive (a
// new primitive, a new M-wave landing); PATCH is a bug fix that
// preserves wire-level behavior.
//
// LPX_PDS_PARSER_M1_READY etc. are per-milestone feature-ready flags.
// Only M1 is 1 at this landing; M2..M7 remain 0 until their
// landings close.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2651 (R221.M1).
// Design doc: design/shell/parser-utf8-nfc.md.

module LibpdxPdsParser = structure {

  // ==========================================================================
  // VERSION TRIPLE (SemVer; MAJOR.MINOR.PATCH)
  // ==========================================================================

  pub let LPX_PDS_PARSER_VERSION_MAJOR : u64 = 1
  pub let LPX_PDS_PARSER_VERSION_MINOR : u64 = 0
  pub let LPX_PDS_PARSER_VERSION_PATCH : u64 = 0

  // ==========================================================================
  // PER-MILESTONE FEATURE-READY FLAGS
  // ==========================================================================
  //
  // 1 iff the corresponding milestone's surface is landed in this
  // library. Consumers that want to feature-detect at startup read
  // these constants and gate on them before calling the matching
  // entry points.

  pub let LPX_PDS_PARSER_M1_READY : u64 = 1   // UTF-8 decoder + NFC normalizer
  pub let LPX_PDS_PARSER_M2_READY : u64 = 0   // grapheme cluster iterator
  pub let LPX_PDS_PARSER_M3_READY : u64 = 0   // width pass
  pub let LPX_PDS_PARSER_M4_READY : u64 = 0   // context-tracking lexer
  pub let LPX_PDS_PARSER_M5_READY : u64 = 0   // unified AST
  pub let LPX_PDS_PARSER_M6_READY : u64 = 0   // span-mapping NFC variant
  pub let LPX_PDS_PARSER_M7_READY : u64 = 0   // parser fuzz corpus

  // ==========================================================================
  // UCD / SUBSTRATE PIN
  // ==========================================================================
  //
  // Mirrors libpdx-unicode-tables's UCD pin. A reader of this
  // library's output across repos gates on this constant to detect
  // UCD drift between the substrate and this consumer.

  pub let LPX_PDS_PARSER_UCD_VERSION_MAJOR : u64 = 15
  pub let LPX_PDS_PARSER_UCD_VERSION_MINOR : u64 = 1

}
