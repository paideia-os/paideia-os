// src/lib.pdx -- libpdx-pds-parser.M1 (paideia-os#2651, R221.M1)
//
// LibpdxPdsParser: library umbrella module.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This file is the library's SELF-DESCRIBING manifest: it carries the
// version triple and the per-milestone feature-ready flags that a
// consumer can `cmp`-against to feature-gate on a specific wave's
// surface.
//
// It intentionally carries NO per-primitive logic -- every real
// parser-tier primitive lives in its own module file (src/utf8_nfc.pdx
// at R221.M1; src/grapheme_iter.pdx at R221.M2; src/width_pass.pdx at
// R221.M3; src/lexer.pdx at R221.M4; src/ast.pdx at R221.M5;
// src/pipeline.pdx at R223.M1; src/schemas_sig.pdx at R222.M1;
// src/lambda_lit.pdx at R224.M1; src/hm_core.pdx at R225.M1;
// src/datalog.pdx at R226.M1; etc.). This mirrors the shape
// libpdx-unicode-tables uses.
//
// =============================================================================
// VERSIONING + FEATURE GATES
// =============================================================================
//
// LPX_PDS_PARSER_VERSION_MAJOR / _MINOR / _PATCH follow SemVer. The
// MAJOR bump signals an incompatible API change (an entry point's
// signature changing, a status band moving); MINOR is additive (a
// new primitive, a new M-wave landing); PATCH is a bug fix that
// preserves wire-level behavior.
//
// LPX_PDS_PARSER_M1_READY etc. are per-milestone feature-ready flags.
// Only M1 is 1 at this landing; M2..M7 remain 0 until their
// landings close.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2651 (R221.M1),
// paideia-os#2487 (R223 umbrella), paideia-os#2666 (R223.M1),
// paideia-os#2658 (R222.M1 SchemasSig), paideia-os#2675 (R224.M1
// LambdaLit), paideia-os#2682 (R225.M1 HmCore), paideia-os#2692
// (R226.M1 Datalog). Design docs:
// design/shell/parser-utf8-nfc.md,
// design/shell/pipeline-stage-parser.md,
// design/shell/cmd-functor-schemas-sig.md,
// design/shell/lambda-literal-grammar.md,
// design/shell/hm-algorithm-w-core.md,
// design/shell/datalog-parser.md.

module LibpdxPdsParser = structure {

  // ==========================================================================
  // VERSION TRIPLE (SemVer; MAJOR.MINOR.PATCH)
  // ==========================================================================

  pub let LPX_PDS_PARSER_VERSION_MAJOR : u64 = 1
  pub let LPX_PDS_PARSER_VERSION_MINOR : u64 = 6
  pub let LPX_PDS_PARSER_VERSION_PATCH : u64 = 0

  // ==========================================================================
  // PER-MILESTONE FEATURE-READY FLAGS
  // ==========================================================================
  //
  // 1 iff the corresponding milestone's surface is landed in this
  // library. Consumers that want to feature-detect at startup read
  // these constants and gate on them before calling the matching
  // entry points.

  // R221 wave (parser-tier Unicode + lexer):
  pub let LPX_PDS_PARSER_M1_READY : u64 = 1   // R221.M1 UTF-8 decoder + NFC normalizer
  pub let LPX_PDS_PARSER_M2_READY : u64 = 0   // R221.M2 grapheme cluster iterator
  pub let LPX_PDS_PARSER_M3_READY : u64 = 0   // R221.M3 width pass
  pub let LPX_PDS_PARSER_M4_READY : u64 = 0   // R221.M4 context-tracking lexer
  pub let LPX_PDS_PARSER_M5_READY : u64 = 0   // R221.M5 unified AST
  pub let LPX_PDS_PARSER_M6_READY : u64 = 0   // R221.M6 span-mapping NFC variant
  pub let LPX_PDS_PARSER_M7_READY : u64 = 0   // R221.M7 parser fuzz corpus

  // R223 wave (pipeline-lang):
  pub let LPX_PDS_PARSER_R223_M1_READY : u64 = 1   // R223.M1 Pipeline stage parser + `|`
  pub let LPX_PDS_PARSER_R223_M2_READY : u64 = 0   // R223.M2 stage-ABI materialiser
  pub let LPX_PDS_PARSER_R223_M3_READY : u64 = 0   // R223.M3 redirection operators
  pub let LPX_PDS_PARSER_R223_M4_READY : u64 = 0   // R223.M4 @hostname annotation
  pub let LPX_PDS_PARSER_R223_M5_READY : u64 = 0   // R223.M5 flag/positional partition
  pub let LPX_PDS_PARSER_R223_M6_READY : u64 = 0   // R223.M6 canonical-form renderer
  pub let LPX_PDS_PARSER_R223_M7_READY : u64 = 0   // R223.M7 pipeline fuzz corpus

  // R224 wave (lambda-lang):
  pub let LPX_PDS_PARSER_R224_M1_READY : u64 = 1   // R224.M1 Lambda literal grammar
  pub let LPX_PDS_PARSER_R224_M2_READY : u64 = 0   // R224.M2 expression body parser
  pub let LPX_PDS_PARSER_R224_M3_READY : u64 = 0   // R224.M3 effect polymorphism
  pub let LPX_PDS_PARSER_R224_M4_READY : u64 = 0   // R224.M4 capability-row typing
  pub let LPX_PDS_PARSER_R224_M5_READY : u64 = 0   // R224.M5 nested lambda + let-rec
  pub let LPX_PDS_PARSER_R224_M6_READY : u64 = 0   // R224.M6 first-class pipeline value
  pub let LPX_PDS_PARSER_R224_M7_READY : u64 = 0   // R224.M7 linear/affine propagation

  // R225 wave (HM typechecker over the unified pds-lang AST):
  pub let LPX_PDS_PARSER_R225_M1_READY : u64 = 1   // R225.M1 HM algorithm W core (unify + instantiate + generalise)
  pub let LPX_PDS_PARSER_R225_M2_READY : u64 = 0   // R225.M2 pipeline-record row types
  pub let LPX_PDS_PARSER_R225_M3_READY : u64 = 0   // R225.M3 Datalog predicate types via schema registry
  pub let LPX_PDS_PARSER_R225_M4_READY : u64 = 0   // R225.M4 effect-row unification
  pub let LPX_PDS_PARSER_R225_M5_READY : u64 = 0   // R225.M5 cross-context type flow
  pub let LPX_PDS_PARSER_R225_M6_READY : u64 = 0   // R225.M6 rank-restricted let-polymorphism
  pub let LPX_PDS_PARSER_R225_M7_READY : u64 = 0   // R225.M7 error reporting + source spans
  pub let LPX_PDS_PARSER_R225_M8_READY : u64 = 0   // R225.M8 LSP-embed hover query surface
  pub let LPX_PDS_PARSER_R225_M9_READY : u64 = 0   // R225.M9 property-test harness
  pub let LPX_PDS_PARSER_R225_M10_READY : u64 = 0  // R225.M10 per-turn type-check fingerprint

  // R226 wave (datalog over the typed-graph substrate):
  pub let LPX_PDS_PARSER_R226_M1_READY : u64 = 1   // R226.M1 Datalog parser (facts, rules, queries)
  pub let LPX_PDS_PARSER_R226_M2_READY : u64 = 0   // R226.M2 predicate-type resolution
  pub let LPX_PDS_PARSER_R226_M3_READY : u64 = 0   // R226.M3 bottom-up semi-naive evaluator
  pub let LPX_PDS_PARSER_R226_M4_READY : u64 = 0   // R226.M4 magic-set rewriting
  pub let LPX_PDS_PARSER_R226_M5_READY : u64 = 0   // R226.M5 stratified negation
  pub let LPX_PDS_PARSER_R226_M6_READY : u64 = 0   // R226.M6 aggregation library
  pub let LPX_PDS_PARSER_R226_M7_READY : u64 = 0   // R226.M7 typed-graph effect
  pub let LPX_PDS_PARSER_R226_M8_READY : u64 = 0   // R226.M8 session-local EDB
  pub let LPX_PDS_PARSER_R226_M9_READY : u64 = 0   // R226.M9 query-time type-check
  pub let LPX_PDS_PARSER_R226_M10_READY : u64 = 0  // R226.M10 progress emission
  pub let LPX_PDS_PARSER_R226_M11_READY : u64 = 0  // R226.M11 per-query fingerprint

  // ==========================================================================
  // UCD / SUBSTRATE PIN
  // ==========================================================================
  //
  // Mirrors libpdx-unicode-tables's UCD pin. A reader of this
  // library's output across repos gates on this constant to detect
  // UCD drift between the substrate and this consumer.

  pub let LPX_PDS_PARSER_UCD_VERSION_MAJOR : u64 = 15
  pub let LPX_PDS_PARSER_UCD_VERSION_MINOR : u64 = 1

}
