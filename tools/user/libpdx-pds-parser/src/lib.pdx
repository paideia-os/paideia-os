// src/lib.pdx -- libpdx-pds-parser.R222.M5 (paideia-os#2662, Wave 122)
//
// LibpdxPdsParser: library umbrella module.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This file is the library's SELF-DESCRIBING manifest: it carries the
// version triple and the per-milestone feature-ready flags that a
// consumer can `cmp`-against to feature-gate on a specific wave's
// surface.
//
// It intentionally carries NO per-primitive logic -- every real
// parser-tier primitive lives in its own module file (src/utf8_nfc.pdx
// at R221.M1; src/grapheme_iter.pdx at R221.M2; src/width_pass.pdx at
// R221.M3; src/lexer.pdx at R221.M4; src/ast.pdx at R221.M5;
// src/pipeline.pdx at R223.M1; src/schemas_sig.pdx at R222.M1;
// src/command_sig.pdx at R222.M2; src/lambda_lit.pdx at R224.M1;
// src/closure_capture.pdx at R224.M2; src/hm_core.pdx at R225.M1;
// src/row_types.pdx at R225.M2; src/datalog.pdx at R226.M1;
// src/session_env.pdx at R229.M2; src/type_env.pdx at R229.M3;
// src/grapheme_iter.pdx at R221.M2;
// src/functor_instance.pdx at R222.M3;
// src/arg_flag_spec.pdx at R222.M4;
// src/effect_row.pdx at R224.M3;
// src/ctx_lexer.pdx at R221.M4;
// src/cap_row.pdx at R224.M4;
// src/cmd_registry.pdx at R222.M5;
// src/let_scope.pdx at R224.M5;
// src/ast.pdx at R221.M5; etc.). This mirrors the shape
// libpdx-unicode-tables uses.
//
// =============================================================================
// VERSIONING + FEATURE GATES
// =============================================================================
//
// LPX_PDS_PARSER_VERSION_MAJOR / _MINOR / _PATCH follow SemVer. The
// MAJOR bump signals an incompatible API change (an entry point's
// signature changing, a status band moving); MINOR is additive (a
// new primitive, a new M-wave landing); PATCH is a bug fix that
// preserves wire-level behavior.
//
// LPX_PDS_PARSER_M1_READY etc. are per-milestone feature-ready flags.
// Only M1 is 1 at this landing; M2..M7 remain 0 until their
// landings close.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2651 (R221.M1),
// paideia-os#2487 (R223 umbrella), paideia-os#2666 (R223.M1),
// paideia-os#2667 (R223.M2 RecordProjection), paideia-os#2658
// (R222.M1 SchemasSig), paideia-os#2659 (R222.M2 CommandSig),
// paideia-os#2675 (R224.M1 LambdaLit), paideia-os#2676 (R224.M2
// ClosureCapture), paideia-os#2682 (R225.M1 HmCore), paideia-os#2683
// (R225.M2 RowTypes), paideia-os#2692 (R226.M1 Datalog),
// paideia-os#2493 (R229 REPL evaluator umbrella), paideia-os#2720
// (R229.M2 SessionEnv), paideia-os#2721 (R229.M3 TypeEnv),
// paideia-os#2652 (R221.M2 GraphemeIter TR#29),
// paideia-os#2653 (R221.M3 WidthPass TR#11),
// paideia-os#2654 (R221.M4 CtxLexer),
// paideia-os#2660 (R222.M3 FunctorInstance),
// paideia-os#2661 (R222.M4 ArgFlagSpec),
// paideia-os#2677 (R224.M3 EffectRow),
// paideia-os#2678 (R224.M4 CapRow),
// paideia-os#2662 (R222.M5 CmdRegistry),
// paideia-os#2679 (R224.M5 LetScope),
// paideia-os#2655 (R221.M5 Ast). Design docs:
// design/shell/parser-utf8-nfc.md,
// design/shell/pipeline-stage-parser.md,
// design/shell/pipeline-record-projection.md,
// design/shell/cmd-functor-schemas-sig.md,
// design/shell/cmd-functor-command-sig.md,
// design/shell/lambda-literal-grammar.md,
// design/shell/closure-capture.md,
// design/shell/hm-algorithm-w-core.md,
// design/shell/row-types-remy.md,
// design/shell/datalog-parser.md,
// design/shell/repl-loop-scaffold.md,
// design/shell/session-env.md,
// design/shell/type-env-threading.md,
// design/shell/grapheme-cluster-boundaries-tr29.md,
// design/shell/width-pass-tr11.md,
// design/shell/ctx-tracking-lexer.md,
// design/shell/functor-instantiation.md,
// design/shell/arg-flag-spec-typing.md,
// design/shell/effect-polymorphism.md,
// design/shell/capability-row-typing.md,
// design/shell/command-registry-client.md,
// design/shell/let-in-scoping.md,
// design/shell/unified-ast.md.

module LibpdxPdsParser = structure {

  // ==========================================================================
  // VERSION TRIPLE (SemVer; MAJOR.MINOR.PATCH)
  // ==========================================================================

  pub let LPX_PDS_PARSER_VERSION_MAJOR : u64 = 1
  pub let LPX_PDS_PARSER_VERSION_MINOR : u64 = 19
  pub let LPX_PDS_PARSER_VERSION_PATCH : u64 = 0

  // ==========================================================================
