// src/load_fingerprint.pdx -- libpdx-pds-parser.R227.M8 (paideia-os#2710)
//
// LoadFingerprint: parser-tier per-SCRIPT-LOAD anti-fabrication
// fingerprint emitter + correlator. Every pds script load emits
// `@fingerprint("pds.load.<script-hash-hex>")` so the debugger (and
// the correlation harness) can anchor each load event to a FNV-1a 64
// hash of the actual script bytes. R227.M8 of the pds-container /
// loader umbrella (paideia-os#2491).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R229.M10 TurnFingerprint (sibling, landed Wave 131) lands the
// RESULT-side half of the paideia-os project P9 anti-fabrication
// anchor: every REPL turn emits `@fingerprint("turn.<id>.<hash-hex>")`
// anchoring the actual result bytes. R225.M10 CheckFingerprint
// (sibling, landed Wave 133) lands the TYPECHECK-OUTCOME-side half:
// every REPL turn ALSO emits `@fingerprint("check.<id>.<ok|fail-N>")`
// anchoring the typechecker outcome. R227.M8 (THIS module) lands the
// LOAD-SITE half: every pds script LOAD emits
// `@fingerprint("pds.load.<script-hash-hex>")` anchoring the actual
// script bytes before the elaborator / typechecker / evaluator ever
// sees them. The three fingerprints together form a chain:
//
//   `pds.load.<hash>` -> `check.<id>.<ok|fail-N>` -> `turn.<id>.<hash>`
//
// so a downstream auditor can trace a claimed turn's result back
// through its typechecker outcome and finally to the exact script
// bytes that produced it.
//
// Position in the substrate graph:
//
//   loader entry point (R227.M1 kernel-side) -> script bytes
//        -> script_hash = FNV-1a 64(script_bytes)   (caller computes)
//        -> _lf_emit(script_hash, out, 64)          (THIS module)
//              -> 64-byte LoadFingerprint record on caller scratch
//        -> _lf_render_tag(record, out, out_cap)
//              -> `@fingerprint("pds.load.<hash-hex>")` ASCII string
//              -> klog emission + stdout emission
//        -> R227.M3 ImportResolve, R227.M4 LoadCheck, R227.M5 ModuleFunctor...
//        -> R225.M10 CheckFingerprint emission (parallel per-turn anchor)
//        -> R229.M10 TurnFingerprint emission (per-turn RESULT anchor)
//
// LoadFingerprint is PARSER-TIER by geography (same satellite library
// as TurnFingerprint, CheckFingerprint, LoadCheck, ImportResolve) but
// is NOT itself a loader -- the module computes nothing except an
// ASCII tag over a caller-supplied script_hash. The hash is NOT
// recomputed here: the caller (the kernel-side R227.M1 loader) owns
// the FNV-1a 64 of the script bytes BEFORE calling this module, and
// passes the hash in directly. This simplification (vs TurnFingerprint
// which inlines the FNV-1a 64 loop) is deliberate: at load time the
// caller already has the script bytes in a known buffer and will
// (per R227.M7 ScriptCache) also use the hash as a cache key, so
// re-computing it here would be redundant work on every load.
//
// Lives user-space because the shell runs user-space; the state is
// caller-process-local (zero `.bss` at raw M8; every record is
// caller-owned on all three operational paths); the module touches
// no kernel KIND and consumes no capability (caps.decl R227.M8 band
// note).
//
// Why LoadFingerprint is distinct from R229.M10 (TurnFingerprint)
// and R225.M10 (CheckFingerprint):
//   * R229.M10 TurnFingerprint hashes the RESULT bytes of a REPL turn
//     (per-TURN; one record per command execution).
//   * R225.M10 CheckFingerprint hashes the CHECK-OUTCOME bytes of a
//     REPL turn's typechecker run (per-TURN; one record per command).
//   * R227.M8 LoadFingerprint hashes the SCRIPT bytes at LOAD TIME
//     (per-LOAD; one record per script loaded, which may be one time
//     at session start or N times under a `source <path>` loop).
//   * All three are 64-byte records on identical stride; all three
//     share the `@fingerprint("...")` wrapper; all three anchor the
//     P9 invariant on a different half of the execution pipeline.
//
// Why LoadFingerprint has no `.bss` state:
//   The module is a pure function of its inputs: given (script_hash),
//   the output 64-byte record and its rendered tag are deterministic
//   (modulo the rdtsc timestamp field, which is explicit non-
//   determinism isolated to one u64). The debugger does NOT need a
//   .bss load-counter -- the number of loads is caller-tracked by
//   the loader's own state. Zero `.bss` -> this module is a pure
//   leaf over caller-supplied inputs on all four entry points.
//
// =============================================================================
// LoadFingerprint RECORD -- 64 BYTES
// =============================================================================
//
// Record stride is a power of two (64 = 1 << 6) so a future per-
// session multi-load ring (one row per load, up to a bounded horizon)
// can index via `shl idx, 6`.
//
//   0x00 u32    magic              'LFPR' (0x5250464C LE) -- reads
//                                   byte-sequentially as byte[0]=0x4C 'L',
//                                   byte[1]=0x46 'F', byte[2]=0x50 'P',
//                                   byte[3]=0x52 'R' per the Wave 125
//                                   SortGroupReduce magic-reconciliation
//                                   lesson (byte-sequence readability
//                                   over numeric prettiness). The u32
//                                   fits in imm32 with bit 31 clear so
//                                   direct `cmp reg, imm32` is sign-
//                                   extension-safe.
//   0x04 u32    reserved           Zero at M8; reserved for M8.1+
//                                   (M8.1 adds a `load_mode` u32
//                                   discriminating interactive /
//                                   source / require / import).
//   0x08 u64    script_hash        FNV-1a 64 of the caller's script
//                                   bytes. Caller-supplied; this
//                                   module does NOT recompute it.
//                                   Byte-for-byte identical to the
//                                   parser-tier FNV family
//                                   (_cmd_sig_fnv1a64 R222.M2,
//                                   _fi_fnv1a64 R222.M3,
//                                   _cmdreg_fnv1a64 R222.M5,
//                                   _ws_schema_hash R223.M5, the
//                                   inlined FNV in _h_append R229.M5,
//                                   _tf_emit R229.M10, _cf_emit
//                                   R225.M10). Also byte-for-byte
//                                   identical to the (source_hash)
//                                   field of R227.M7 ScriptCache so
//                                   a downstream cache lookup over
//                                   this hash hits the same slot.
//   0x10 u64    timestamp_us       rdtsc sample at emit time. The
//                                   loader may convert to microseconds
//                                   via TSC calibration (R20.M3) at
//                                   display time; this module stores
//                                   the raw TSC for byte-for-byte
//                                   reproducibility across tools.
//   0x18 u8[32] rendered_tag       Pre-rendered ASCII:
//                                     `pds.load.<hash-hex>`
//                                   where <hash-hex> is 16-char
//                                   lowercase hexadecimal of the full
//                                   64-bit script_hash. Fixed width:
//                                   9 + 16 = 25 bytes exactly (no
//                                   variable-width decimal to render
//                                   because LoadFingerprint carries
//                                   no caller-visible counter). NUL-
//                                   padded to 32 bytes (7 B pad). The
//                                   debugger reads from offset 0
//                                   until first NUL or offset 32,
//                                   whichever first.
//   0x38 u64    reserved           Zero at M8; reserved for M8.1+
//                                   (M8.1 adds a `script_bytes_len`
//                                   u32 at [+0x38..+0x3C] so an
//                                   auditor can cross-check the FNV
//                                   input length without the loader
//                                   plumbing the length into a second
//                                   record; M8.2 adds a `source_kind`
//                                   u8 at [+0x3C] discriminating
//                                   stdin / file / tty / network).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _lf_init() -> ()
//     Bare `ret` boot hook. M8 holds NO .bss state (every operation
//     is caller-scratched). Kept for parallelism with the parser-
//     family init-hook convention (`_tf_init` R229.M10, `_cf_init`
//     R225.M10, `_rd_init` R229.M9, `_ha_init` R223.M6, `_ws_init`
//     R223.M5, `_ds_init` R222.M8, `_dm_init` R222.M6, `_cmdreg_init`
//     R222.M5, `_st_init` R223.M7).
//
//   _lf_emit(script_hash, out, out_cap) -> status
//     rdi = script_hash    (FNV-1a 64 of script bytes; caller-computed)
//     rsi = out            (ptr to caller-owned 64-byte scratch)
//     rdx = out_cap        (>= 64)
//     rax = LF_OK or LF_ERR_* in low 32 (no packing; 64 bytes written
//                            on success, unspecified on error)
//
//     Validates (out != 0 -> LF_ERR_BAD_OUT; out_cap >= 64 ->
//     LF_ERR_OUT_TOO_SMALL). On success: writes 64 bytes to out:
//     magic + reserved u32 + script_hash + rdtsc timestamp + rendered
//     ASCII tag + reserved u64. 2 callee-save push frame
//     (rbx=script_hash, rbp=out) with NO nested CALL (hex rendering
//     unrolled; no FNV loop because the caller already supplied the
//     hash). No sub-rsp alignment pad is required (no nested CALL).
//
//   _lf_render_tag(record, out, out_cap) -> packed_u64
//     rdi = record     (ptr to 64-byte LoadFingerprint record)
//     rsi = out        (ptr to caller-owned output buffer)
//     rdx = out_cap    (>= 16 for the smallest tag:
//                       `@fingerprint("")` = 16 bytes; typical 41 B)
//     rax = (bytes_written << 32) | status
//
//     Emits `@fingerprint("<record.rendered_tag>")` where
//     <record.rendered_tag> is copied from record[+0x18..+0x18+N] up
//     to the first NUL or offset 32 (whichever first). Validates
//     record != 0 (LF_ERR_BAD_RECORD), out != 0 (LF_ERR_BAD_OUT),
//     magic at record[+0..+4] == 'LFPR' (LF_ERR_BAD_MAGIC), and
//     out_cap >= needed (LF_ERR_OUT_TOO_SMALL). Pure leaf; zero
//     callee-save pushes; no stack frame; no nested CALL. Prefix
//     "@fingerprint(\"" (14 B) and suffix "\")" (2 B) emitted via
//     byte-copy from .rodata _lf_prefix.
//
//   _lf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
//     rdi = expected_tag       (ptr to expected `@fingerprint("...")`
//                               ASCII string)
//     rsi = expected_len       (byte length of expected_tag; >= 16)
//     rdx = actual_record      (ptr to 64-byte LoadFingerprint record)
//     rcx = record_len         (= 64; defensive guard)
//     rax = LF_OK iff the record would render byte-identically to
//           expected_tag, else LF_ERR_MISMATCH or a validation error.
//
//     The debugger's compare entry: given a claimed fingerprint tag
//     (from a tool-call log, a klog capture, or a smoke-mode golden)
//     and the record the loader actually emitted, confirm they refer
//     to the SAME script load. Avoids a stack scratch buffer by:
//       (a) verifying expected_tag begins with `@fingerprint("` (14 B);
//       (b) verifying expected_tag ends with `")` (2 B);
//       (c) extracting inner = expected_tag[14..expected_len-2];
//       (d) byte-comparing inner against record[+0x18..+0x18+N] with
//           the shorter side terminating on first NUL (if the record's
//           inline tag is NUL-padded) or inner's end;
//       (e) requiring N == inner_len (where N is the record's live
//           tag length).
//     Pure leaf; zero callee-save pushes; no stack frame; no nested
//     CALL. Validates record_len == 64 (LF_ERR_BAD_LEN),
//     actual_record != 0 (LF_ERR_BAD_RECORD), expected_tag != 0
//     (LF_ERR_BAD_EXPECTED), magic at record[+0..+4] == 'LFPR'
//     (LF_ERR_BAD_MAGIC), expected_len >= 16 (LF_ERR_BAD_LEN).
//
// Register maps (SysV):
//
//   _lf_init()                                             -> ()
//   _lf_emit(rdi, rsi, rdx)                                -> rax
//   _lf_render_tag(rdi, rsi, rdx)                          -> rax
//   _lf_correlate(rdi, rsi, rdx, rcx)                      -> rax
//
// =============================================================================
// STATUS-CODE NAMESPACE  --  0x6800..0x68FF
// =============================================================================
//
// LoadFingerprint packed-status range. Seven slots used at R227.M8:
//
//   LF_OK                     = 0        success; 64 B written (emit) or
//                                        packed bytes_written (render)
//   LF_ERR_BAD_OUT            = 0x6800   out == 0 on any entry
//   LF_ERR_OUT_TOO_SMALL      = 0x6801   out_cap below required width
//   LF_ERR_BAD_RECORD         = 0x6802   record == 0 (_lf_render_tag /
//                                        _lf_correlate)
//   LF_ERR_BAD_MAGIC          = 0x6803   record[+0..+4] != 'LFPR' LE
//   LF_ERR_MISMATCH           = 0x6804   _lf_correlate: expected_tag's
//                                        inner differs from the
//                                        record's rendered_tag
//   LF_ERR_BAD_LEN            = 0x6805   _lf_correlate: record_len != 64
//                                        OR expected_len < 16 OR
//                                        expected_tag missing wrapper
//   LF_ERR_BAD_EXPECTED       = 0x6806   _lf_correlate: expected_tag == 0
//
// Slots 0x6807..0x68FF reserved for R227.M8.1+ follow-ups
// (LF_ERR_BAD_LOAD_MODE on an M8.1 load_mode field validator;
// LF_ERR_HASH_MISMATCH on an M8.3 strict-mode hash-only correlator
// that recomputes FNV from the script bytes; LF_ERR_TIMESTAMP_SKEW
// on an M8.4 rdtsc-skew sanity bound; LF_ERR_BAD_SOURCE_KIND on an
// M8.2 source_kind discriminator validator).
//
// Band 0x6800..0x68FF is disjoint from every landed parser-tier
// packed-status band at R227.M8 landing time. The 0x6600..0x66FF and
// 0x6700..0x67FF slices sit between the R225.M10 CheckFingerprint
// (0x6300..0x63FF) / R226.M2 PredicateTypes (0x6400..0x64FF) /
// R227.M7 ScriptCache (0x6500..0x65FF) carve-outs and this landing;
// they are held as reserved slack for sibling arms in-flight at this
// wave. R227.M8 LoadFingerprint claims 0x6800..0x68FF directly above
// the next-available slack boundary. A downstream compound-error
// dispatcher can discriminate "load-fingerprint faulted" from every
// other sibling satellite's failure modes by `shr r, 8; cmp r, 0x68`.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R227.M1 (pds loader, kernel-side; forward-path umbrella) -- the
//     primary caller of this module. The loader computes
//     script_hash = FNV-1a 64(script_bytes) at ingress (the hash
//     also serves R227.M7 ScriptCache as the lookup key), then
//     invokes `_lf_emit(script_hash, scratch, 64)` to produce the
//     record, then `_lf_render_tag(scratch, out, out_cap)` to compose
//     the `@fingerprint("...")` string for klog + stdout emission.
//
//   R227.M7 (script_cache.pdx) -- the hash input is shared: the
//     caller's FNV-1a 64 of the script bytes is BOTH the LoadFingerprint
//     script_hash AND the ScriptCache source_hash. A single hash
//     computation at the loader's ingress feeds both substrates.
//
//   R229.M10 (turn_fingerprint.pdx) -- the per-turn RESULT anchor
//     sibling. Hashes are byte-for-byte identical (same FNV-1a 64
//     offset basis + prime) so a cross-boundary correlator comparing
//     the LoadFingerprint.script_hash with a TurnFingerprint computed
//     over the same bytes gets numerical equality.
//
//   R225.M10 (check_fingerprint.pdx) -- the per-turn TYPECHECK anchor
//     sibling. Together with LoadFingerprint and TurnFingerprint
//     forms the three-anchor chain described in the SCOPE section.
//
//   design/foundations/project-invariants.md P9 -- the authoritative
//     invariant statement. P9 commits every pds script load +
//     every REPL turn to a verifiable fingerprint anchor; THIS
//     module provides the load-site third of that commitment.
//
//   design/debugger/anti-fabrication-anchors.md (planned R30 doc) --
//     the smoke-mode correlation harness that iterates N script
//     loads, feeds synthetic script hashes, captures the emitted
//     tags, and asserts that every tag's inner structure matches
//     `pds.load.<FNV-of-script>`.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32; the low-
//     nibble mask `and rN, 15` fits imm8.
//   - No 2-op `imul r, imm` -- M8 has no multiply at all; the hash
//     is caller-supplied so no FNV multiply fires here.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `LoadFingerprint` matches `load_fingerprint.pdx`.
//   - Labels prefixed `lf_` with per-function suffix (`lf_ini_`,
//     `lf_em_`, `lf_rt_`, `lf_co_`). Disjoint from every landed
//     parser-tier prefix (grep-confirmed against `u8n_`, `gi_`,
//     `wp_`, `cl_`, `ast_`, `sm_`, `fh_`, `sch_sig_`, `cmd_sig_`,
//     `fi_`, `afs_`, `cmdreg_`, `dm_`, `ds_`, `pl_`, `pl_lam_`,
//     `rp_`, `fo_`, `sgr_`, `ws_`, `ha_`, `st_`, `ll_`, `cc_`,
//     `er_`, `cr_`, `ls_`, `lp_`, `hm_`, `rt_`, `eu_`, `dl_`,
//     `se_`, `te_`, `jc_`, `h_`, `le_`, `vi_`, `ml_`, `ir_`,
//     `rc_`, `rd_`, `dr_`, `lc_`, `lh_`, `tf_`, `mf_`, `vp_`,
//     `pth_`, `scc_`, `cf_`, `pt_`) and from the paideia-as
//     reserved keywords (`loop`, `if`, `let`, `fn`, `ret`, `done`).
//   - All `cmp reg, imm` immediates (0, 1, 2, 4, 5, 6, 9, 14, 15,
//     16, 24, 25, 32, 33, 48, 56, 64, byte literals 0x22 '"',
//     0x28 '(', 0x29 ')', 0x2E '.', 0x40 '@', 0x61 'a', 0x64 'd',
//     0x65 'e', 0x66 'f', 0x67 'g', 0x69 'i', 0x6C 'l', 0x6E 'n',
//     0x6F 'o', 0x70 'p', 0x72 'r', 0x73 's', 0x74 't', hex
//     0x30 '0'..0x39 '9', 0x61 'a'..0x66 'f', status codes
//     0x6800..0x6806, magic 0x5250464C 'LFPR') fit imm32 with
//     bit 31 clear so direct `cmp reg, imm32` is sign-safe. No
//     imm64 constants at M8 (no FNV; the magic is imm32).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     (precedent: FNV-family byte load across the parser-tier
//     FNV sites).
//   - u32 stores via plain `mov_d [dst + disp], reg` (low 32 of
//     reg).
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - Byte stores: when the destination is `[base_reg + const_disp]`
//     with disp fitting imm8, use `mov_b [base + disp], reg`
//     directly (precedent: turn_fingerprint.pdx line 684 for the
//     constant-disp form). When both base and index are registers,
//     precompute the dst address into a scratch register then
//     `mov_b [scratch + 0], reg` to sidestep the
//     `mov_b [reg + reg + off], reg` encoder gap (precedent:
//     history.pdx line 663; turn_fingerprint.pdx throughout the
//     render_tag + correlate loops).
//   - `_lf_init`, `_lf_render_tag`, `_lf_correlate` are PURE LEAVES
//     with zero callee-save pushes and zero nested CALL. r11 is
//     used freely as scratch because no CALL fires.
//   - `_lf_emit` is a 2-callee-save-push frame (rbx = script_hash,
//     rbp = out) with ZERO nested CALL (hex rendering unrolled; no
//     FNV loop). No sub-rsp alignment pad is required when there
//     is no nested CALL (precedent: R229.M5 `_h_append`, R229.M10
//     `_tf_emit`, R225.M10 `_cf_emit`).
//
// =============================================================================
// REGISTER-LIVENESS NOTES
// =============================================================================
//
//   _lf_emit uses rbx + rbp as the 2-push callee-save pair. rbx
//   holds the saved script_hash across the rdtsc clobber (rdtsc
//   writes edx:eax so rax and rdx are destroyed between the hash
//   store at [+8] and the timestamp store at [+16]; the hash store
//   must therefore happen BEFORE rdtsc, and the hex-render reads of
//   script_hash must come from rbx not rdi). rbp holds the saved
//   out ptr across every store so the destination base is a stable
//   callee-save register across the whole body. The 16-nibble hex
//   unroll uses r8 (hex table base; held across loop), r9 (nibble
//   value), r11 (hex digit); r10 is unused in M8 (reserved for
//   M8.1+ env-mask style additions).
//
//   _lf_render_tag is a pure leaf: rdi = record (held across the
//   NUL scan), rsi = out (held across prefix + inner + suffix
//   emits), rdx = out_cap (held across the needed guard). The
//   NUL-scan uses r8 (= &record[24]; loop-held) + r9 (= inner_len;
//   accumulator) + r11 (per-byte scratch). The prefix emit uses
//   rcx (= &_lf_prefix) + rax (= i) + r11 (byte) + r8 (dst-address
//   scratch; safe to clobber because the inner-copy that follows
//   re-derives its own base). The inner copy uses r8 (= &record[24];
//   re-derived) + rcx (= &out[14]; loop-held) + rax (= i) + r11
//   (byte) + rdi (dst-address scratch; the caller's record pointer
//   is no longer needed because r8 carries the inner base from
//   this point on). The suffix emit uses rcx (= &out[14+inner_len])
//   + rax (byte).
//
//   _lf_correlate is a pure leaf: no callee-save pushes. The
//   prefix verify uses r8 (= &_lf_prefix) + r9 (= expected_tag;
//   loop-held source) + rax (= i) + r10 (expected byte) + r11
//   (prefix byte). The suffix verify uses r8 (expected_len - 2)
//   + r9 (= &expected_tag[len-2]) + r10 (byte). The inner compare
//   uses r8 (= inner_len) + r9 (= &expected_tag[14]) + r10
//   (= &actual_record[24]) + rax (= i) + r11 (expected byte) +
//   rcx (actual byte). The trailing-NUL check uses r11 (byte at
//   &record[24 + inner_len]).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R227.M8.1  load_mode field: an additional u32 at [record+0x04..
//              +0x08] discriminates interactive REPL load (0) from
//              `source <path>` load (1) from `require <mod>` load (2)
//              from `#import <mod>` load (3). Lets the correlation
//              harness detect a load-mode drift that the hash alone
//              does not reveal.
//   R227.M8.2  source_kind + script_bytes_len field: an additional
//              u32+u32 at [record+0x38..+0x40] carries the hashed
//              byte count AND the source kind (stdin/file/tty/net)
//              so an auditor can cross-check the hash input length
//              and provenance without consulting the loader's state.
//   R227.M8.3  strict-mode hash-only correlator: a second
//              `_lf_correlate_strict(expected_tag, expected_len,
//              script_ptr, script_len)` that RECOMPUTES the FNV
//              from the script bytes and compares to the hash
//              parsed out of expected_tag's inner. Catches a
//              tampered record where magic + rendered_tag match but
//              the hash field was overwritten.
//   R227.M8.4  rdtsc-skew sanity bound: the correlator rejects a
//              record whose timestamp precedes the previous load's
//              timestamp (`_lf_correlate_sequence` over an ordered
//              array of records).
//   R227.M8.5  Smoke-mode golden corpus: 5-script load fixture
//              under `smoke/load-fingerprint-m8.golden.txt` with
//              one line per load carrying the full
//              `@fingerprint("...")` tag, consumed by
//              `tools/verify-load-fingerprint-coverage.sh`. The
//              5-script count matches the issue's acceptance anchor.
//
// =============================================================================
// Upstream: paideia-os#2491 (R227 pds container / loader umbrella),
// paideia-os#2710 (THIS ticket, R227.M8 LoadFingerprint),
// paideia-os#2709 (R227.M7 ScriptCache -- the sibling that shares
// the script_hash input), paideia-os#2728 (R229.M10 TurnFingerprint
// -- the sibling RESULT-side anchor), paideia-os#2691 (R225.M10
// CheckFingerprint -- the sibling TYPECHECK-side anchor),
// paideia-os#2659 (R222.M2 CommandSig -- FNV discipline source of
// truth).
// Design docs: design/shell/load-fingerprint.md (R227.M8, THIS
// landing), design/foundations/project-invariants.md P9 (the
// invariant this module makes verifiable),
// design/shell/turn-fingerprint.md (R229.M10 sibling record),
// design/shell/check-fingerprint.md (R225.M10 sibling record),
// design/shell/script-cache.md (R227.M7 sibling that shares the
// script_hash input).

module LoadFingerprint = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax low 32 bits)
  // ==========================================================================

  pub let LF_OK                      : u64 = 0
  pub let LF_ERR_BAD_OUT             : u64 = 0x6800
  pub let LF_ERR_OUT_TOO_SMALL       : u64 = 0x6801
  pub let LF_ERR_BAD_RECORD          : u64 = 0x6802
  pub let LF_ERR_BAD_MAGIC           : u64 = 0x6803
  pub let LF_ERR_MISMATCH            : u64 = 0x6804
  pub let LF_ERR_BAD_LEN             : u64 = 0x6805
  pub let LF_ERR_BAD_EXPECTED        : u64 = 0x6806

  // ==========================================================================
  // SECTION 2 -- RECORD + FIELD CONSTANTS
  // ==========================================================================

  pub let LF_MAGIC                   : u64 = 0x5250464C   // 'LFPR' LE
  pub let LF_RECORD_BYTES            : u64 = 64
  pub let LF_RENDERED_TAG_BYTES      : u64 = 32
  pub let LF_RENDERED_TAG_LIVE_BYTES : u64 = 25           // 9 ("pds.load.") + 16 hex
  pub let LF_HEX_NIBBLES             : u64 = 16

  // Record field offsets.
  pub let LF_OFF_MAGIC               : u64 = 0
  pub let LF_OFF_RESERVED1           : u64 = 4
  pub let LF_OFF_SCRIPT_HASH         : u64 = 8
  pub let LF_OFF_TIMESTAMP           : u64 = 16
  pub let LF_OFF_RENDERED_TAG        : u64 = 24
  pub let LF_OFF_RESERVED2           : u64 = 56

  // Rendered-tag inner layout (relative to [+0x18]).
  pub let LF_TAG_PREFIX_BYTES        : u64 = 9            // `pds.load.`
  pub let LF_TAG_HEX_OFFSET          : u64 = 9            // first hex byte at [+24+9]

  // External wrapper widths.
  pub let LF_WRAPPER_PREFIX_BYTES    : u64 = 14           // `@fingerprint("`
  pub let LF_WRAPPER_SUFFIX_BYTES    : u64 = 2            // `")`

  // Standard rendered tag length under the raw-M8 shape.
  pub let LF_STD_INNER_LEN           : u64 = 25           // == LF_RENDERED_TAG_LIVE_BYTES
  pub let LF_STD_WRAPPED_LEN         : u64 = 41           // 14 + 25 + 2

  // ==========================================================================
  // SECTION 3 -- HEX NIBBLE LOOKUP (lowercase 0-9 a-f)
  // ==========================================================================
  //
  // 16-byte table laid out as the standard ASCII glyph sequence.
  // The emitter indexes via `shr r, N; and r, 15; mov_b r, [_lf_hex + r]`.
  // Mirrors R229.M10 TurnFingerprint's `_tf_hex_digits` layout.

  pub let _lf_hex_digits : [u8; 16] = [
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,     // '0'..'7'
    0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66      // '8', '9', 'a'..'f'
  ] @align(8)

  // ==========================================================================
  // SECTION 4 -- WRAPPER PREFIX LITERAL
  // ==========================================================================
  //
  // 14-byte constant `@fingerprint("` emitted at the head of every
  // `_lf_render_tag` output. Laid out in .rodata so `_lf_render_tag` can
  // byte-copy without 14 inline mov-imm stores. Byte-for-byte identical
  // to R229.M10 TurnFingerprint's `_tf_prefix` and R225.M10
  // CheckFingerprint's `_cf_prefix`; each module owns its own copy so
  // the modules link standalone with no cross-module linker dependency
  // on this constant.

  pub let _lf_prefix : [u8; 16] = [
    0x40, 0x66, 0x69, 0x6E, 0x67, 0x65, 0x72, 0x70,     // @fingerp
    0x72, 0x69, 0x6E, 0x74, 0x28, 0x22, 0x00, 0x00      // rint("<2 pad>
  ] @align(8)

  // ==========================================================================
  // _lf_init() -> ()
  //
  //   Bare `ret`. M8 holds NO .bss state.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lf_ini_.
  // ==========================================================================
  pub let _lf_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R227.M8 (#2710): LoadFingerprint holds no .bss state at raw M8 (every operation is caller-scratched on all four entry points; the hash is caller-supplied so no FNV loop fires). _lf_init is a bare `ret` kept for parallelism with the parser-family init-hook convention (_tf_init R229.M10, _cf_init R225.M10, _rd_init R229.M9, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5, _st_init R223.M7). Pure leaf; zero pushes; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lf_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _lf_emit(script_hash, out, out_cap) -> status
  //
  //   rdi = script_hash   (FNV-1a 64 of script bytes; caller-computed)
  //   rsi = out           (ptr to caller-owned 64-byte scratch)
  //   rdx = out_cap       (>= 64)
  //   rax = LF_OK / LF_ERR_*
  //
  //   Writes 64 bytes to out:
  //     [out+0x00..+0x04]  magic 'LFPR'
  //     [out+0x04..+0x08]  reserved u32 = 0
  //     [out+0x08..+0x10]  script_hash (u64; verbatim from rdi)
  //     [out+0x10..+0x18]  timestamp (rdtsc)
  //     [out+0x18..+0x38]  rendered_tag ASCII `pds.load.<hex>` + NUL pad
  //     [out+0x38..+0x40]  reserved u64 = 0
  //
  //   2 callee-save pushes (rbx=script_hash, rbp=out). No nested CALL
  //   (hex rendering unrolled; no FNV loop). No sub-rsp alignment pad
  //   needed because no nested CALL fires (precedent: R229.M5
  //   `_h_append`, R229.M10 `_tf_emit`, R225.M10 `_cf_emit`).
  //
  //   Register plan:
  //     rbx = script_hash (saved input across rdtsc clobber; the hex-
  //                        render loop reads from rbx not rdi)
  //     rbp = out (saved input; destination base for every record
  //                field store)
  //     r8  = hex-table base (`_lf_hex_digits`; held across unroll)
  //     r9  = per-nibble scratch (nibble value 0..15)
  //     r11 = per-nibble hex digit (byte load from hex table)
  //     rax, rcx, rdx = used freely (rdtsc clobbers rax + rdx)
  //
  //   Labels prefixed lf_em_.
  // ==========================================================================
  pub let _lf_emit : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (script_hash: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M8 (#2710): _lf_emit produces the 64-byte LoadFingerprint record at [out, out+64). 2 callee-save pushes (rbx=script_hash, rbp=out); no nested CALL (hex rendering unrolled; no FNV loop because the caller supplies the hash) so no sub-rsp alignment pad is required (precedent R229.M5 `_h_append`, R229.M10 `_tf_emit`, R225.M10 `_cf_emit`). Guards (BEFORE pushes so an early-return avoids the push/pop pair): out == 0 (LF_ERR_BAD_OUT 0x6800); out_cap < 64 (LF_ERR_OUT_TOO_SMALL 0x6801). After pushes: save rdi -> rbx (script_hash) and rsi -> rbp (out). Fixed-field write pass: store magic 0x5250464C 'LFPR' at [rbp+0] via mov_d (0x5250464C < 0x80000000 so mov-imm32 is sign-safe); store reserved u32 = 0 at [rbp+4] via mov_d; store script_hash (rbx) at [rbp+8] via plain mov. rdtsc clobber: rdtsc writes edx:eax so rax + rdx are destroyed; this must come AFTER the hash store at [+8] (which reads rbx into memory). shl rdx, 32; or rax, rdx; mov [rbp+16], rax. Zero reserved u64 at [rbp+56]. Rendered-tag write pass at [rbp+24..+56] (32 B region): (A) zero-fill 32 B via four u64 stores of 0 from a cleared rax. (B) Emit `pds.load.` (9 bytes 0x70 'p', 0x64 'd', 0x73 's', 0x2E '.', 0x6C 'l', 0x6F 'o', 0x61 'a', 0x64 'd', 0x2E '.') at [rbp+24..+33] via nine `mov_b [rbp + const_disp], rax` with disp 24..32 (imm8-safe; precedent turn_fingerprint.pdx line 684). (C) Hex-render script_hash (rbx) as 16 lowercase nibbles via unrolled per-position reads: for N in (60, 56, 52, ..., 4, 0) emit nibble = (rbx >> N) & 15 as _lf_hex_digits[nibble] at [rbp+33+i] for i in (0..16). Each unrolled nibble: mov r9, rbx; shr r9, N; and r9, 15; xor r11, r11; mov_b r11, [r8 + r9]; mov_b [rbp + 33+i], r11. The hex-table base is pre-staged into r8 once before the first nibble via lea r8, [rip + _lf_hex_digits]. (D) The NUL-pad at [rbp+49..+56] (7 bytes) is already handled by the step (A) zero-fill; no further writes. Return LF_OK (rax = 0). Error returns stamp rax to the LF_ERR_* code BEFORE the push pair fires (so no pop is needed on error). All cmp immediates (0, 64, byte literals 0x61 'a', 0x64 'd', 0x6C 'l', 0x6E 'n', 0x6F 'o', 0x70 'p', 0x73 's', 0x2E '.', shift counts 32, 60..0 step 4, status codes 0x6800..0x6801, magic 0x5250464C) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No imm64 constants at M8 (no FNV; the magic is imm32). No test (every zero-check uses `cmp reg, 0`). No and-imm64 (the one `and r, 15` fits imm8). No 2-op imul-r-imm. No multiline let. Labels prefixed lf_em_.",
      block: {
        // ---- Guard: out != 0.
        //      Checked BEFORE pushes so an early-return avoids the
        //      push/pop pair.
        cmp rsi, 0;
        je  lf_em_bad_out_early;

        // ---- Guard: out_cap >= 64.
        cmp rdx, 64;
        jb  lf_em_oos_early;

        push rbx;
        push rbp;

        // ---- Save inputs to callee-save.
        mov rbx, rdi;                        // script_hash
        mov rbp, rsi;                        // out

        // ===================================================================
        // Write fixed fields: magic, reserved1, script_hash.
        // ===================================================================

        // ---- magic 'LFPR' u32 at [out+0].
        mov rax, 0x5250464C;                 // 'LFPR' LE (byte-seq L F P R)
        mov_d [rbp + 0], rax;

        // ---- reserved u32 at [out+4] = 0.
        xor rax, rax;
        mov_d [rbp + 4], rax;

        // ---- script_hash u64 at [out+8].
        mov [rbp + 8], rbx;

        // ---- timestamp u64 at [out+16] via rdtsc.
        rdtsc;                               // edx:eax = TSC
        shl rdx, 32;
        or  rax, rdx;
        mov [rbp + 16], rax;

        // ---- reserved u64 at [out+56] = 0.
        xor rax, rax;
        mov [rbp + 56], rax;

        // ===================================================================
        // Rendered-tag write pass: 32 bytes at [out+24..+56].
        // ===================================================================
        //
        // Step 1: zero-fill 32 bytes via four u64 stores. This also
        // handles NUL-padding past the live tail at [+49..+56].

        xor rax, rax;
        mov [rbp + 24], rax;
        mov [rbp + 32], rax;
        mov [rbp + 40], rax;
        mov [rbp + 48], rax;

        // ---- Emit `pds.load.` (9 bytes) at [out+24..+33].
        //      Each `mov_b [rbp + <const disp>], rax` has imm8 disp
        //      which the encoder handles natively.
        mov rax, 0x70;                       // 'p'
        mov_b [rbp + 24], rax;
        mov rax, 0x64;                       // 'd'
        mov_b [rbp + 25], rax;
        mov rax, 0x73;                       // 's'
        mov_b [rbp + 26], rax;
        mov rax, 0x2E;                       // '.'
        mov_b [rbp + 27], rax;
        mov rax, 0x6C;                       // 'l'
        mov_b [rbp + 28], rax;
        mov rax, 0x6F;                       // 'o'
        mov_b [rbp + 29], rax;
        mov rax, 0x61;                       // 'a'
        mov_b [rbp + 30], rax;
        mov rax, 0x64;                       // 'd'
        mov_b [rbp + 31], rax;
        mov rax, 0x2E;                       // '.'
        mov_b [rbp + 32], rax;

        // ---- Hex-render rbx (script_hash) as 16 lowercase nibbles
        //      at [out+33..+49].
        //
        //      Pre-stage the hex table base.
        lea r8, [rip + _lf_hex_digits];

        // Nibble 15 (bits 63..60) at [out+33].
        mov r9, rbx;
        shr r9, 60;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 33], r11;

        // Nibble 14 (bits 59..56) at [out+34].
        mov r9, rbx;
        shr r9, 56;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 34], r11;

        // Nibble 13 (bits 55..52) at [out+35].
        mov r9, rbx;
        shr r9, 52;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 35], r11;

        // Nibble 12 (bits 51..48) at [out+36].
        mov r9, rbx;
        shr r9, 48;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 36], r11;

        // Nibble 11 (bits 47..44) at [out+37].
        mov r9, rbx;
        shr r9, 44;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 37], r11;

        // Nibble 10 (bits 43..40) at [out+38].
        mov r9, rbx;
        shr r9, 40;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 38], r11;

        // Nibble 9 (bits 39..36) at [out+39].
        mov r9, rbx;
        shr r9, 36;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 39], r11;

        // Nibble 8 (bits 35..32) at [out+40].
        mov r9, rbx;
        shr r9, 32;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 40], r11;

        // Nibble 7 (bits 31..28) at [out+41].
        mov r9, rbx;
        shr r9, 28;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 41], r11;

        // Nibble 6 (bits 27..24) at [out+42].
        mov r9, rbx;
        shr r9, 24;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 42], r11;

        // Nibble 5 (bits 23..20) at [out+43].
        mov r9, rbx;
        shr r9, 20;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 43], r11;

        // Nibble 4 (bits 19..16) at [out+44].
        mov r9, rbx;
        shr r9, 16;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 44], r11;

        // Nibble 3 (bits 15..12) at [out+45].
        mov r9, rbx;
        shr r9, 12;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 45], r11;

        // Nibble 2 (bits 11..8) at [out+46].
        mov r9, rbx;
        shr r9, 8;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 46], r11;

        // Nibble 1 (bits 7..4) at [out+47].
        mov r9, rbx;
        shr r9, 4;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 47], r11;

        // Nibble 0 (bits 3..0) at [out+48].
        mov r9, rbx;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        mov_b [rbp + 48], r11;

        // ---- Return LF_OK via the pop epilogue.
        xor rax, rax;
        pop rbp;
        pop rbx;
        ret;

      lf_em_bad_out_early:
        mov rax, 0x6800;                     // LF_ERR_BAD_OUT
        ret;

      lf_em_oos_early:
        mov rax, 0x6801;                     // LF_ERR_OUT_TOO_SMALL
        ret;
      }
    }

  // ==========================================================================
  // _lf_render_tag(record, out, out_cap) -> packed_u64
  //
  //   rdi = record     (ptr to 64-byte LoadFingerprint record)
  //   rsi = out        (ptr to caller-owned output buffer)
  //   rdx = out_cap    (>= 16 at minimum; standard load tag needs 41 B)
  //   rax = (bytes_written << 32) | status
  //
  //   Emits `@fingerprint("<inner>")` where <inner> is copied from
  //   record[+0x18..+0x18+N] up to the first NUL or offset 32.
  //
  //   Validates:
  //     record != 0                           (LF_ERR_BAD_RECORD)
  //     out != 0                              (LF_ERR_BAD_OUT)
  //     record[+0..+4] == 'LFPR' LE           (LF_ERR_BAD_MAGIC)
  //     out_cap >= 16 + inner_len             (LF_ERR_OUT_TOO_SMALL)
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lf_rt_.
  // ==========================================================================
  pub let _lf_render_tag : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (record: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M8 (#2710): _lf_render_tag emits `@fingerprint(\"<inner>\")` where <inner> is copied from record[+24..+24+N] up to the first NUL or offset 32. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rdi != 0 (LF_ERR_BAD_RECORD 0x6802); rsi != 0 (LF_ERR_BAD_OUT 0x6800); u32 at [rdi+0] == 0x5250464C 'LFPR' LE (LF_ERR_BAD_MAGIC 0x6803). (2) Compute inner_len by scanning record+24..record+56 for first NUL (byte load into r11, cmp r11, 0, je done). r9 holds inner_len. (3) Compute needed = 16 + inner_len into r10. (4) Guard rdx >= r10 (LF_ERR_OUT_TOO_SMALL 0x6801). (5) Emit prefix: byte-copy 14 bytes from _lf_prefix[0..14] to rsi[0..14]. Use a byte-stepping loop with precomputed source + dst bases. (6) Byte-copy inner_len bytes from record+24 to rsi+14. (7) Emit suffix `\")` (2 bytes 0x22 0x29) at [rsi + 14 + inner_len]. (8) Return packed_u64 = (needed << 32) | LF_OK. All cmp immediates (0, 14, 16, 24, 32, 56, byte literals 0x22 0x29, magic 0x5250464C, status codes 0x6800..0x6803) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lf_rt_.",
      block: {
        // ---- Guard: record != 0.
        cmp rdi, 0;
        je  lf_rt_bad_record;

        // ---- Guard: out != 0.
        cmp rsi, 0;
        je  lf_rt_bad_out;

        // ---- Guard: magic 'LFPR' at [record+0].
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x5250464C;                 // 'LFPR' LE
        jne lf_rt_bad_magic;

        // ---- Compute inner_len by scanning record+24..record+56.
        //
        //   r8  = record + 24 (inner base; precomputed, held across scan)
        //   r9  = i  (inner_len accumulator)
        //
        //   Loop: while i < 32: load byte at [r8 + i]; if 0 break; i++.

        mov r8, rdi;
        add r8, 24;                          // r8 = &record.rendered_tag
        xor r9, r9;                          // r9 = i = 0

      lf_rt_scan_loop:
        cmp r9, 32;
        jae lf_rt_scan_done;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        cmp r11, 0;
        je  lf_rt_scan_done;
        add r9, 1;
        jmp lf_rt_scan_loop;

      lf_rt_scan_done:
        // r9 = inner_len.

        // ---- Compute needed = 16 + inner_len; guard out_cap >= needed.
        mov r10, r9;
        add r10, 16;
        cmp rdx, r10;
        jb  lf_rt_oos;

        // ---- Emit prefix (14 bytes) from _lf_prefix to out[0..14].
        //
        //   lea rcx, [rip + _lf_prefix]  -- src base
        //   xor rax, rax                 -- i = 0
        //   loop: cmp rax, 14; jae done; byte load; byte store; i++.

        lea rcx, [rip + _lf_prefix];
        xor rax, rax;

      lf_rt_pre_loop:
        cmp rax, 14;
        jae lf_rt_pre_done;
        xor r11, r11;
        mov_b r11, [rcx + rax];
        // dst = rsi + rax; precompute into r8-scratch (clobbering the
        // inner-base r8 is safe here because the inner copy that
        // follows re-derives its own base from rdi + 24).
        mov r8, rsi;
        add r8, rax;
        mov_b [r8 + 0], r11;
        add rax, 1;
        jmp lf_rt_pre_loop;

      lf_rt_pre_done:

        // ---- Byte-copy inner bytes from record+24 to out+14 (inner_len
        //      bytes).
        //
        //   r8  = &record[24] (re-derived; loop-held)
        //   rcx = &out[14]    (loop-held dst base)
        //   rax = i           (0..inner_len)
        //   r11 = per-byte source scratch
        //   rdi = per-byte dst-address scratch (we no longer need the
        //         caller's record pointer -- r8 carries the inner base
        //         so rdi is free to clobber as caller-save scratch)

        mov r8, rdi;
        add r8, 24;
        mov rcx, rsi;
        add rcx, 14;
        xor rax, rax;

      lf_rt_inner_loop:
        cmp rax, r9;
        jae lf_rt_inner_done;
        xor r11, r11;
        mov_b r11, [r8 + rax];
        mov rdi, rcx;
        add rdi, rax;
        mov_b [rdi + 0], r11;
        add rax, 1;
        jmp lf_rt_inner_loop;

      lf_rt_inner_done:

        // ---- Emit suffix `")` (2 bytes 0x22 0x29) at out[14 + inner_len].
        //
        //   dst_base = out + 14 + inner_len; written at [dst+0] and [dst+1].

        mov rcx, rsi;
        add rcx, 14;
        add rcx, r9;
        mov rax, 0x22;                       // '"'
        mov_b [rcx + 0], rax;
        mov rax, 0x29;                       // ')'
        mov_b [rcx + 1], rax;

        // ---- Pack return: (bytes_written << 32) | LF_OK.
        //      bytes_written = 16 + inner_len = r10.
        mov rax, r10;
        shl rax, 32;                         // (needed << 32) | 0
        ret;

      lf_rt_bad_record:
        mov rax, 0x6802;                     // LF_ERR_BAD_RECORD
        ret;

      lf_rt_bad_out:
        mov rax, 0x6800;                     // LF_ERR_BAD_OUT
        ret;

      lf_rt_bad_magic:
        mov rax, 0x6803;                     // LF_ERR_BAD_MAGIC
        ret;

      lf_rt_oos:
        mov rax, 0x6801;                     // LF_ERR_OUT_TOO_SMALL
        ret;
      }
    }

  // ==========================================================================
  // _lf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
  //
  //   rdi = expected_tag
  //   rsi = expected_len
  //   rdx = actual_record
  //   rcx = record_len
  //   rax = LF_OK (0) iff expected_tag renders byte-identically to
  //         `@fingerprint("<actual_record.rendered_tag>")`
  //
  //   The debugger's compare entry. Avoids a scratch buffer by:
  //     (a) verifying expected_tag[0..14] == `@fingerprint("`;
  //     (b) verifying expected_tag[expected_len-2..] == `")`;
  //     (c) extracting inner_len = expected_len - 16;
  //     (d) byte-comparing expected_tag[14..14+inner_len] against
  //         record[+24..+24+inner_len];
  //     (e) requiring record[+24+inner_len] == NUL (or inner_len==32).
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lf_co_.
  // ==========================================================================
  pub let _lf_correlate : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (expected_tag: u64) (expected_len: u64) (actual_record: u64) (record_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R227.M8 (#2710): _lf_correlate compares an expected `@fingerprint(\"...\")` tag against the record a loader actually emitted. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rcx == 64 (LF_ERR_BAD_LEN 0x6805); rdx != 0 (LF_ERR_BAD_RECORD 0x6802); rdi != 0 (LF_ERR_BAD_EXPECTED 0x6806); rsi >= 16 (LF_ERR_BAD_LEN); u32 at [rdx+0] == 0x5250464C (LF_ERR_BAD_MAGIC 0x6803). (2) Verify prefix: compare 14 bytes at [expected_tag + 0..14] against _lf_prefix[0..14]. Mismatch -> LF_ERR_BAD_LEN (missing wrapper). (3) Verify suffix: byte at [expected_tag + expected_len - 2] == 0x22 '\"' AND byte at [expected_tag + expected_len - 1] == 0x29 ')'. Mismatch -> LF_ERR_BAD_LEN. (4) Compute inner_len = expected_len - 16; guard inner_len <= 32 (LF_ERR_MISMATCH 0x6804 if the record's rendered_tag field only holds 32 bytes). (5) Byte-compare expected_tag[14..14+inner_len] against actual_record[24..24+inner_len]: on any mismatch -> LF_ERR_MISMATCH. (6) If inner_len < 32, verify actual_record[24+inner_len] == 0 (NUL terminator; a record whose rendered_tag is LONGER than the expected inner is a mismatch); else (inner_len == 32) accept as-is since the field maxes at 32 bytes. (7) Return LF_OK. All cmp immediates (0, 1, 2, 14, 16, 32, 56, 64, byte literals 0x22 0x29, magic 0x5250464C, status codes 0x6802..0x6806) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lf_co_. r11 is used freely as scratch because no CALL fires.",
      block: {
        // ---- Guard: record_len == 64.
        cmp rcx, 64;
        jne lf_co_bad_len;

        // ---- Guard: actual_record != 0.
        cmp rdx, 0;
        je  lf_co_bad_record;

        // ---- Guard: expected_tag != 0.
        cmp rdi, 0;
        je  lf_co_bad_expected;

        // ---- Guard: expected_len >= 16.
        cmp rsi, 16;
        jb  lf_co_bad_len;

        // ---- Guard: magic 'LFPR' at [actual_record+0].
        xor rax, rax;
        mov_d rax, [rdx + 0];
        cmp rax, 0x5250464C;
        jne lf_co_bad_magic;

        // ===================================================================
        // Verify prefix: expected_tag[0..14] vs _lf_prefix[0..14].
        // ===================================================================
        //
        //   r8  = &_lf_prefix (loop-held)
        //   r9  = expected_tag (loop-held source)
        //   rax = i (0..14)
        //   r10 = byte from expected_tag
        //   r11 = byte from _lf_prefix

        lea r8, [rip + _lf_prefix];
        mov r9, rdi;
        xor rax, rax;

      lf_co_pre_loop:
        cmp rax, 14;
        jae lf_co_pre_done;
        xor r10, r10;
        mov_b r10, [r9 + rax];
        xor r11, r11;
        mov_b r11, [r8 + rax];
        cmp r10, r11;
        jne lf_co_bad_len;                   // prefix mismatch = missing wrapper
        add rax, 1;
        jmp lf_co_pre_loop;

      lf_co_pre_done:

        // ===================================================================
        // Verify suffix: expected_tag[expected_len - 2] == '"' AND
        //                expected_tag[expected_len - 1] == ')'.
        // ===================================================================

        mov r8, rsi;
        sub r8, 2;                           // r8 = expected_len - 2
        mov r9, rdi;
        add r9, r8;                          // r9 = &expected_tag[len - 2]
        xor r10, r10;
        mov_b r10, [r9 + 0];
        cmp r10, 0x22;                       // '"'
        jne lf_co_bad_len;
        xor r10, r10;
        mov_b r10, [r9 + 1];
        cmp r10, 0x29;                       // ')'
        jne lf_co_bad_len;

        // ===================================================================
        // Byte-compare inner.
        // ===================================================================
        //
        //   inner_len = expected_len - 16  (prefix 14 + suffix 2)
        //   Guard: inner_len <= 32.
        //   r8 = inner_len
        //   r9 = &expected_tag[14] (source)
        //   r10 = &actual_record[24] (source)
        //   rax = i (0..inner_len)

        mov r8, rsi;
        sub r8, 16;                          // r8 = inner_len
        cmp r8, 32;
        ja  lf_co_mismatch;                  // inner longer than record field

        mov r9, rdi;
        add r9, 14;                          // r9 = &expected_tag[14]
        mov r10, rdx;
        add r10, 24;                         // r10 = &actual_record[24]
        xor rax, rax;

      lf_co_cmp_loop:
        cmp rax, r8;
        jae lf_co_cmp_done;
        xor r11, r11;
        mov_b r11, [r9 + rax];
        xor rcx, rcx;
        mov_b rcx, [r10 + rax];
        cmp r11, rcx;
        jne lf_co_mismatch;
        add rax, 1;
        jmp lf_co_cmp_loop;

      lf_co_cmp_done:

        // ===================================================================
        // If inner_len < 32: verify record[24 + inner_len] == 0 so the
        // record's live tag is not LONGER than the expected inner.
        // ===================================================================

        cmp r8, 32;
        je  lf_co_ok;                        // record tag maxes out at 32

        xor r11, r11;
        mov_b r11, [r10 + r8];               // byte at &record[24 + inner_len]
        cmp r11, 0;
        jne lf_co_mismatch;                  // record has more bytes = mismatch

      lf_co_ok:
        xor rax, rax;                        // LF_OK
        ret;

      lf_co_bad_len:
        mov rax, 0x6805;                     // LF_ERR_BAD_LEN
        ret;

      lf_co_bad_record:
        mov rax, 0x6802;                     // LF_ERR_BAD_RECORD
        ret;

      lf_co_bad_expected:
        mov rax, 0x6806;                     // LF_ERR_BAD_EXPECTED
        ret;

      lf_co_bad_magic:
        mov rax, 0x6803;                     // LF_ERR_BAD_MAGIC
        ret;

      lf_co_mismatch:
        mov rax, 0x6804;                     // LF_ERR_MISMATCH
        ret;
      }
    }

}
