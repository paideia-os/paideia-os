// src/row_types.pdx -- libpdx-pds-parser.R225.M2 (paideia-os#2683)
//
// RowTypes: Remy-style row polymorphism layered over the R225.M1
// HmCore type-graph pool. Introduces a NEW node kind (HM_KIND_TYROW
// = 4) with three subkinds (ROW_EMPTY, ROW_EXT, ROW_VAR), the field-
// extension / restriction / selection / concatenation primitive
// family, and a row-aware general unifier that correctly handles
// nested rows inside TyApp subterms.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R225 is the typechecker umbrella (design/terminal/semantic-shell-
// language-plan.md section "R225 -- Unified HM type checker across
// three sub-languages"). M1 (hm_core.pdx) landed the Robinson /
// Damas-Milner 1982 kernel. M2 (THIS module) lands the Remy 1992
// row-polymorphism extension that the pipeline-record sub-language
// (R223) and the semantic-shell record-literal surface require.
//
// The pool is a SHARED singleton -- row nodes live in _hm_pool
// alongside hm_core's TyVar/TyCon/TyApp nodes. Row-var substitution
// uses the same +12 u32 "resolved" slot that hm_core TyVar nodes
// use, so a single generalised _rt_find walks both chains. No ABI
// in hm_core changes: _hm_fresh_var, _hm_unify, _hm_instantiate and
// _hm_generalise keep working on their original pool subset; new
// _rt_* primitives extend the surface additively.
//
// =============================================================================
// TYPE REPRESENTATION  --  TyRow (16-BYTE, SHARED STRIDE)
// =============================================================================
//
// A new kind code HM_KIND_TYROW = 4 extends the hm_core node taxonomy
// (1=TyVar, 2=TyCon, 3=TyApp). Row nodes reuse the 16-byte TypeNode
// stride and the same slot ordering, so _rt_find can walk a mixed
// TyVar/ROW_VAR resolved chain with one implementation.
//
//   [+0]   kind     (u8)   4 = TyRow
//   [+1]   arity    (u8)   ROW_EMPTY: 0; ROW_EXT: 2; ROW_VAR: 0.
//   [+2]   subkind  (u8)   0 = ROW_EMPTY, 1 = ROW_EXT, 2 = ROW_VAR.
//   [+3]   flags    (u8)   reserved for M4+ effect-row annotation.
//   [+4]   arg0     (u32)  ROW_EXT: label hash (FNV-1a 32);
//                          ROW_VAR: var_id (shared with _hm_var_next);
//                          ROW_EMPTY: 0.
//   [+8]   arg1     (u32)  ROW_EXT: field-type pool_idx;
//                          ROW_VAR: 0; ROW_EMPTY: 0.
//   [+12]  arg2     (u32)  ROW_EXT: rest-row pool_idx;
//                          ROW_VAR: resolved pool_idx (0 = unresolved);
//                          ROW_EMPTY: 0.
//
// The +12 slot is deliberately shared with hm_core's HM_OFF_RESOLVED
// so _rt_find's "follow resolved chain" branch is identical in shape
// to _hm_find's.
//
// =============================================================================
// LABEL IDENTITY  --  FNV-1a 32-bit
// =============================================================================
//
// Row-extension nodes identify their field by a 32-bit label hash
// (FNV-1a, offset_basis = 0x811C9DC5, prime = 0x01000193). FNV-1a
// 32 collisions in a single row's field set are not catastrophic
// (equality on label text could be re-checked by the caller) but
// are vanishingly rare: for a 32-field record the birthday-paradox
// collision probability is < 2.4e-7. FNV-1a 64 (as command_sig.pdx
// uses for cap-name identity) was considered and rejected -- the
// 32-bit value drops cleanly into the shared 32-bit arg0 slot
// without a two-word pool allocation per row-ext node, and 32-bit
// mul products truncate predictably per the "shl 32; shr 32" idiom
// documented in this module's _rt_label_hash justification.
//
// =============================================================================
// NEW TYPE CONSTRUCTORS  --  M2 ADDITIONS
// =============================================================================
//
// R225.M1 reserved con_ids 1..8 (u64, i64, str, bool, path, pid,
// fn, tuple). M2 adds one TyCon:
//
//   record -> HM_CON_RECORD = 10   (arity 1; wraps a row into a type)
//
// Con_id 9 is left unassigned to leave an explicit gap between the
// M1 (base + binary) range and the M2 record wrapper. R225.M3+ will
// take 9 for the Datalog bridge if the field-type arrival from the
// schema registry needs its own ground-type code.
//
// A record type is modelled as:
//
//     TyApp( TyCon(HM_CON_RECORD, arity=1), row_idx )
//
// The TyApp arity-1 form (left=TyCon, right=row) reuses hm_core's
// TyApp unification arm: a RECORD-vs-RECORD comparison matches the
// TyCon identity and then recurses into the row children via the
// row-aware _rt_row_unify.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _rt_find(idx) -> idx
//     Walks the TyVar OR ROW_VAR resolved chain. Non-var nodes
//     return idx unchanged.
//
//   _rt_label_hash(ptr, len) -> u32-hash (in rax low 32)
//     FNV-1a 32 over the label bytes. Pure leaf.
//
//   _rt_alloc_node() -> u64
//     Reserve one 16-byte pool slot, zero-fill it, return pool_idx;
//     0 on pool-full. Shared helper for the row allocators.
//
//   _rt_row_empty() -> u64
//     Allocate a ROW_EMPTY node and return its pool_idx (0 on full).
//
//   _rt_row_var() -> u64
//     Allocate a ROW_VAR node, mint a fresh var_id from
//     _hm_var_next, return pool_idx (0 on full).
//
//   _rt_row_extend(label_hash, field_type_idx, rest_row_idx) -> u64
//     Allocate a ROW_EXT node with the given fields. Returns
//     pool_idx (0 on full).
//
//   _rt_record_type(row_idx) -> u64
//     Allocate TyApp(TyCon(RECORD, 1), row_idx). Two pool slots
//     (the TyCon(RECORD) is minted fresh per call; hm_core's pool
//     is cheap enough that caching one TyCon(RECORD) singleton is
//     deferred to R225.M9's harness feedback). Returns pool_idx of
//     the TyApp, or 0 on full.
//
//   _rt_row_select(row_idx, label_hash, out_type_idx_ptr) -> errno
//     Walk the row chain following _rt_find on each tail; when a
//     ROW_EXT whose arg0 matches label_hash is seen, write its
//     field-type pool_idx into *out_type_idx_ptr and return RT_OK.
//     ROW_EMPTY tail or ROW_VAR tail (which admits "label absent"
//     at M2 by convention -- see design doc section 4.4): return
//     RT_ERR_LABEL_MISSING.
//
//   _rt_row_restrict(row_idx, label_hash, out_type_idx_ptr,
//                    out_rest_idx_ptr) -> errno
//     Walk the chain to find the ROW_EXT matching label_hash. On
//     success, write the field type to *out_type_idx_ptr and
//     reconstruct the row with that extension removed into a new
//     chain whose root is written to *out_rest_idx_ptr. The
//     reconstruction allocates new ROW_EXT nodes for every field
//     that preceded the match (so the restrict result is a fresh
//     subgraph; the original row remains intact for other callers).
//     Return RT_OK, RT_ERR_LABEL_MISSING, or RT_ERR_POOL_FULL.
//
//   _rt_row_concat(row_a_idx, row_b_idx) -> packed_u64
//     Append the fields of row_a onto row_b and return
//     (result_idx << 32) | status. row_a must terminate in
//     ROW_EMPTY (not a row-var) -- open-tail concatenation is
//     ambiguous and is deferred to R225.M5 "cross-context type
//     flow". Labels in row_a must not appear in row_b
//     (RT_ERR_LABEL_DUP on collision). RT_OK on success,
//     RT_ERR_POOL_FULL on exhaustion, RT_ERR_CLOSED_ROW if row_a
//     ends in ROW_VAR, RT_ERR_LABEL_DUP on collision.
//
//   _rt_row_unify(a_idx, b_idx) -> errno
//     Row-aware unification. Dispatches on kind at every recursion
//     level: both TyRow -> row-specific logic (Remy pivot on label
//     mismatch); both TyVar -> hm_core-style occurs-check + bind;
//     both TyCon -> con_id + arity compare; both TyApp -> recurse
//     into left/right children (this handles record wrappers whose
//     right child is a row node); otherwise RT_ERR_KIND_MISMATCH.
//     Row-var binding uses the +12 arg2 slot (shared with
//     HM_OFF_RESOLVED) so a subsequent _rt_find walks it correctly.
//
// Register maps (SysV):
//
//   _rt_find(rdi) -> rax
//   _rt_label_hash(rdi, rsi) -> rax
//   _rt_alloc_node() -> rax
//   _rt_row_empty() -> rax
//   _rt_row_var() -> rax
//   _rt_row_extend(rdi, rsi, rdx) -> rax
//   _rt_record_type(rdi) -> rax
//   _rt_row_select(rdi, rsi, rdx) -> rax
//   _rt_row_restrict(rdi, rsi, rdx, rcx) -> rax
//   _rt_row_concat(rdi, rsi) -> rax
//   _rt_row_unify(rdi, rsi) -> rax
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the only mask we need is 32-bit (0xFFFFFFFF)
//     which is implemented via `shl rax, 32; shr rax, 32` to avoid
//     any imm-sign-extension edge; the single flag bit mask is
//     `and r, 1` (imm8, trivially imm32-safe).
//   - No 2-op `imul r, imm` -- 16-byte stride is `shl r, 4`; FNV-1a
//     32 multiply uses `mul rcx` with the prime in rcx (one-op
//     unsigned mul, same shape as command_sig.pdx _cmd_sig_fnv1a64).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `RowTypes` matches `row_types.pdx`.
//   - Labels prefixed `rt_` (unique against the sibling parser-tier
//     modules in this library: u8n_ (R221.M1), sch_sig_ (R222.M1),
//     cmd_sig_ (R222.M2), pl_ (R223.M1), rp_ (R223.M2), ll_ (R224.M1),
//     hm_ (R225.M1), dl_ (R226.M1)). Never bare `loop`/`if`/`let`
//     /`fn`/`ret`.
//   - All `cmp reg, imm` immediates (0, 1, 2, 3, 4, 10, 16, 128,
//     0xFFFFFFFF, 0x3600..0x3606) fit imm32 and are either small
//     positives with bit 31 clear or are loaded via imm64 staging
//     before compare (0xFFFFFFFF is only used as a shift-and-shift
//     result, never as an imm compare).
//   - Byte loads via `xor r,r; mov_b r,[addr]`; u32 loads via
//     `xor r,r; mov_d r,[addr]`; u64 loads via plain `mov`.
//   - u32 stores via `mov_d`; u8 stores via `mov_b`.
//   - Cross-module .bss writes via `lea r11, [rip + sym]; mov [r11], rax`
//     (precedent: hm_core.pdx itself writes _hm_pool_next this way).
//   - Register-liveness lesson from the parent brief: r11 is clobbered
//     by every nested CALL. _rt_find reloads _hm_pool / _hm_pool_next
//     via lea r11 inside its loop body; _rt_alloc_node holds its own
//     r11 across the sub-rsp epilogue. In the recursive functions
//     (_rt_row_unify, _rt_row_select, _rt_row_restrict, _rt_row_concat)
//     every value that must survive a nested CALL lives in r12..r15
//     (callee-save) or on the stack frame.
//   - _rt_row_unify, _rt_row_select, _rt_row_restrict and
//     _rt_row_concat are self-recursive (and _rt_row_unify is also
//     cross-recursive with _hm_unify). Max recursion depth is bounded
//     by pool size (127 nodes). Each 6-push + 8-align frame is 56
//     bytes -> worst-case stack usage ~7.1 KiB, well within user-space
//     stack budget.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R225.M3  Datalog predicate types via schema registry: bridges
//            SchemasSig field descriptors (R222.M1) into HmCore
//            TyCons; row types see predicate argument lists as
//            tuples, not rows, so M3 is additive with no M2 change.
//   R225.M4  Effect-row unification: a SECOND kind of row (effect-
//            row) sharing the TyRow kind-byte but using a disjoint
//            subkind code (SUBKIND_EFFECT_* in 0x08..0x0F). The
//            _rt_row_unify algorithm reuses the Remy pivot
//            verbatim; the differentiator is the subkind byte.
//   R225.M5  Cross-context type flow: pipeline records entering a
//            `datalog { ... }` block become row-ground terms; this
//            module provides the ground-row constructor pattern
//            (ROW_EMPTY-terminated chains) that M5 consumes.
//   R225.M6  Rank-restricted let-polymorphism: generalise refuses
//            to lift schemes whose row-tails are rank-2 (detected
//            via a row-walk during generalisation; implementation
//            lives in hm_core.pdx's R225.M6 landing, which calls
//            _rt_find to detect row-var tails).
//   R225.M7  Error-span attribution: every RT_ERR_* return wraps
//            with a span from the caller's AST walker.
//
// =============================================================================
// Upstream: paideia-os#2683 (THIS ticket, R225.M2). Design doc:
// design/shell/row-types-remy.md. Related plan:
// design/terminal/semantic-shell-language-plan.md section R225.M2.

module RowTypes = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax, low 32 bits for packed)
  // ==========================================================================
  //
  // Small-value range 0x3600..0x36FF, reserved for R225.M2 row types.
  // Disjoint from the R221 parser band (0x2700..), R222.M1 schemas_sig
  // (0x2A00..), R222.M2 command_sig (0x3300..), R223.M1 pipeline
  // (0x2B00..), R223.M2 record_projection (0x3400..), R224.M1 lambda_lit
  // (0x2C00..), R225.M1 hm_core (0x2D00..), R226.M1 datalog (0x2E00..)
  // and the parallel R224.M2 (0x3500..0x35FF reserved) + R229.M2
  // (0x3700..0x37FF reserved) wave arms.

  pub let RT_OK                 : u64 = 0
  pub let RT_ERR_LABEL_MISSING  : u64 = 0x3600
  pub let RT_ERR_LABEL_DUP      : u64 = 0x3601
  pub let RT_ERR_POOL_FULL      : u64 = 0x3602
  pub let RT_ERR_KIND_MISMATCH  : u64 = 0x3603
  pub let RT_ERR_CLOSED_ROW     : u64 = 0x3604
  pub let RT_ERR_OCCURS         : u64 = 0x3605
  pub let RT_ERR_MISMATCH       : u64 = 0x3606

  // ==========================================================================
  // SECTION 2 -- KIND + SUBKIND + CON-ID CODES
  // ==========================================================================
  //
  // RT_KIND_TYROW extends hm_core's HM_KIND_* enum additively.
  // RT_SUBKIND_* lives in the +2 node byte (hm_core calls this slot
  // "depth" for its own use; TyRow repurposes it for the subkind
  // dispatch).

  pub let RT_KIND_TYROW         : u64 = 4

  pub let RT_SUBKIND_EMPTY      : u64 = 0
  pub let RT_SUBKIND_EXT        : u64 = 1
  pub let RT_SUBKIND_VAR        : u64 = 2

  pub let RT_CON_RECORD         : u64 = 10

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================
  //
  // Node stride and offsets mirror hm_core's HM_* layout. Pool capacity
  // (128 slots, idx 0 reserved) is shared with hm_core via the
  // singleton _hm_pool in the HmCore module.

  pub let RT_NODE_BYTES         : u64 = 16
  pub let RT_POOL_CAP           : u64 = 128

  pub let RT_OFF_KIND           : u64 = 0
  pub let RT_OFF_ARITY          : u64 = 1
  pub let RT_OFF_SUBKIND        : u64 = 2
  pub let RT_OFF_FLAGS          : u64 = 3
  pub let RT_OFF_ARG0           : u64 = 4
  pub let RT_OFF_ARG1           : u64 = 8
  pub let RT_OFF_ARG2           : u64 = 12

  // Hm-core kind codes we must know about (duplicated as constants
  // rather than imported because paideia-as cross-module `let`
  // import syntax lands with R220.M11 and this module predates it).
  pub let RT_HM_KIND_TYVAR      : u64 = 1
  pub let RT_HM_KIND_TYCON      : u64 = 2
  pub let RT_HM_KIND_TYAPP      : u64 = 3

  // ==========================================================================
  // SECTION 4 -- FNV-1a 32-bit CONSTANTS
  // ==========================================================================
  //
  // Standard reference values; both fit in imm32 (0x811C9DC5 has
  // bit 31 set so a raw `mov r64, imm` encoding may sign-extend --
  // _rt_label_hash's justification documents the shl/shr truncation
  // dance that neutralises that).

  pub let RT_FNV_OFFSET_32      : u64 = 0x811C9DC5
  pub let RT_FNV_PRIME_32       : u64 = 0x01000193

  // ==========================================================================
  // _rt_find(idx) -> idx
  //
  //   rdi = idx         (pool index; must be in 1..127)
  //   rax = root_idx    (final pool index after following resolved chain)
  //
  // Walks the resolved chain for BOTH HM_KIND_TYVAR nodes (kind=1)
  // AND HM_KIND_TYROW nodes with subkind=RT_SUBKIND_VAR (kind=4,
  // subkind=2). For every other node shape returns idx unchanged.
  // Loop termination is guaranteed because every substitution
  // target is a pool index that was allocated BEFORE the
  // TyVar/ROW_VAR whose arg2 (= +12) field names it; the occurs-
  // check in _rt_row_unify further guarantees no cycles.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed rt_fnd_.
  // ==========================================================================
  pub let _rt_find : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_find walks the TyVar OR ROW_VAR resolved chain. Pure leaf; zero pushes; no stack frame; no nested CALL. Loop: compute node address `lea r11, [rip+_hm_pool]; mov rax, idx; shl rax, 4; add rax, r11`, read kind byte; if kind == 1 (HM_KIND_TYVAR) fall through to follow-resolved; else if kind == 4 (RT_KIND_TYROW) read subkind byte at +2, if subkind == 2 (RT_SUBKIND_VAR) fall through, else return idx; else return idx. Follow-resolved: read arg2 u32 at [+12]; if 0 return idx; else idx := arg2 and continue. All cmp immediates (0, 1, 2, 4) fit imm32 with bit 31 clear. Byte loads via mov_b (zero-extends). u32 load via mov_d (zero-extends). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_fnd_.",
      block: {
        mov rax, rdi;                          // rax := idx (walking cursor)

      rt_fnd_loop:
        // Compute node address: node_addr = &_hm_pool + idx * 16.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;                          // r10 = node_addr

        // Read kind byte.
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];

        // TyVar? follow resolved.
        cmp rcx, 1;                            // RT_HM_KIND_TYVAR
        je  rt_fnd_follow;

        // TyRow? check subkind.
        cmp rcx, 4;                            // RT_KIND_TYROW
        jne rt_fnd_done;

        xor rcx, rcx;
        mov_b rcx, [r10 + 2];                  // subkind
        cmp rcx, 2;                            // RT_SUBKIND_VAR
        jne rt_fnd_done;

      rt_fnd_follow:
        // Read arg2 (= resolved for TyVar; = resolved for ROW_VAR).
        xor rcx, rcx;
        mov_d rcx, [r10 + 12];
        cmp rcx, 0;
        je  rt_fnd_done;

        // Advance: idx := arg2.
        mov rax, rcx;
        jmp rt_fnd_loop;

      rt_fnd_done:
        ret;
      }
    }

  // ==========================================================================
  // _rt_label_hash(ptr, len) -> u64 (upper 32 bits zero)
  //
  //   rdi = ptr
  //   rsi = len
  //   rax = FNV-1a 32 hash
  //
  // Standard FNV-1a 32: hash = offset_basis; for each byte:
  // hash ^= byte; hash = (hash * prime) mod 2^32. Pure leaf.
  // Labels prefixed rt_h_.
  // ==========================================================================
  pub let _rt_label_hash : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): FNV-1a 32 hash over [ptr, ptr+len). Pure leaf; zero pushes; no stack frame; no nested CALL. Load offset basis 0x811C9DC5 into rax, then immediately dance `shl rax,32; shr rax,32` to force 32-bit zero-extend regardless of whether the encoder picked imm32 (sign-extending) or imm64 for the mov -- 0x811C9DC5 has bit 31 set so an unconditional truncation is necessary even without any mul yet. Load prime 0x01000193 into rcx (held across the loop; bit 31 clear so no sign-extend issue). Save ptr->r8, len->r9. Loop: for each i in 0..len: byte-load `xor r11,r11; mov_b r11,[r8+i]`; xor r11 into rax (low 8 bits of hash); clear rdx; `mul rcx` (one-op unsigned mul; rdx:rax = rax * prime, we keep rax low 64); truncate to 32 bits via `shl rax,32; shr rax,32`. Terminate on i >= len. Zero-length input returns the offset basis unchanged (standard FNV behaviour). The one-op `mul rcx` form is distinct from the pitfall-listed 2-op `imul r, imm`. All cmp immediates (0 via jae, len via r9) are imm8-safe. No test (zero-check uses cmp r10, r9). No and-imm64. No 2-op imul-r-imm. No multiline let. Labels prefixed rt_h_.",
      block: {
        mov r8, rdi;                           // r8 = ptr
        mov r9, rsi;                           // r9 = len

        // Load offset basis; truncate to 32 bits defensively.
        mov rax, 0x811C9DC5;
        shl rax, 32;
        shr rax, 32;

        // Load prime (bit 31 clear; no sign-extend issue).
        mov rcx, 0x01000193;

        xor r10, r10;                          // i = 0

      rt_h_loop:
        cmp r10, r9;
        jae rt_h_done;

        xor r11, r11;
        mov_b r11, [r8 + r10];                 // byte load
        xor rax, r11;                          // hash ^= byte

        xor rdx, rdx;                          // clear mul high half
        mul rcx;                               // rdx:rax = rax * prime

        // Truncate to 32 bits (FNV-1a 32 operates mod 2^32).
        shl rax, 32;
        shr rax, 32;

        add r10, 1;
        jmp rt_h_loop;

      rt_h_done:
        ret;
      }
    }

  // ==========================================================================
  // _rt_alloc_node() -> u64
  //
  //   rax = pool_idx of the new (zeroed) 16-byte slot, or 0 on
  //         pool-full.
  //
  // Reserves one slot in HmCore's singleton _hm_pool. Lazy-inits
  // _hm_pool_next to 1 on first observation of 0 (idx 0 is reserved
  // as the "null" sentinel; see hm_core.pdx header). Zero-fills the
  // allocated 16 bytes so the caller can write only the fields it
  // cares about and leave the rest at 0. Pure leaf -- no callee-save
  // push, no stack frame, no nested CALL. Labels prefixed rt_an_.
  // ==========================================================================
  pub let _rt_alloc_node : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_alloc_node reserves one 16-byte TypeNode slot from HmCore's singleton _hm_pool. Pure leaf; zero pushes; no stack frame; no nested CALL. Load `_hm_pool_next` via `lea r11,[rip+_hm_pool_next]; mov rax,[r11]`; if rax == 0 (bss-zero -- lazy init path) rax := 1 (skip reserved pool_idx 0); if rax >= RT_POOL_CAP (128) return 0 (pool-full sentinel); store rax+1 back to _hm_pool_next. Compute node address `lea r11,[rip+_hm_pool]; mov r10,rax; shl r10,4; add r10,r11`. Zero-fill 16 bytes via two u64 writes: `xor rcx, rcx; mov [r10+0], rcx; mov [r10+8], rcx`. Return allocated pool_idx in rax. All immediates (0, 1, 16, 128) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_an_.",
      block: {
        // Load _hm_pool_next.
        lea r11, [rip + _hm_pool_next];
        mov rax, [r11];

        // Lazy init: 0 -> 1 (skip reserved pool_idx 0).
        cmp rax, 0;
        jne rt_an_have_next;
        mov rax, 1;

      rt_an_have_next:
        // Pool-full check.
        cmp rax, 128;                          // RT_POOL_CAP
        jae rt_an_full;

        // Bump _hm_pool_next.
        mov r10, rax;
        add r10, 1;
        mov [r11], r10;

        // Compute node address: &_hm_pool + rax * 16.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Zero-fill 16 bytes (two u64 writes).
        xor rcx, rcx;
        mov [r10 + 0], rcx;
        mov [r10 + 8], rcx;

        // rax already holds the allocated pool_idx.
        ret;

      rt_an_full:
        xor rax, rax;                          // 0 = pool-full sentinel
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_empty() -> u64
  //
  //   rax = pool_idx of the new ROW_EMPTY node, or 0 on pool-full.
  //
  // Allocates a TyRow node with subkind = ROW_EMPTY. arg0/arg1/arg2
  // remain zero (set by _rt_alloc_node's zero-fill). Labels prefixed
  // rt_re_.
  //
  // Stack frame: zero callee-save pushes + one nested CALL (to
  // _rt_alloc_node). sub rsp, 8 for alignment -> rsp%16==0 at CALL
  // (entry %16==8, +8 pad = %16==0). Labels prefixed rt_re_.
  // ==========================================================================
  pub let _rt_row_empty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_empty allocates a ROW_EMPTY TyRow node. Zero callee-save pushes; one nested CALL to _rt_alloc_node. Prologue sub rsp,8 for alignment (entry rsp%16==8, +8 pad -> rsp%16==0 at CALL). Call _rt_alloc_node -> rax = pool_idx (0 on full). If rax == 0: epilogue and return 0. Else compute node_addr `mov r10, rax; shl r10, 4; lea r11, [rip + _hm_pool]; add r10, r11`. Write kind = 4 (RT_KIND_TYROW) via mov_b at [+0]. Write subkind = 0 (RT_SUBKIND_EMPTY) via mov_b at [+2]. arity, flags, arg0, arg1, arg2 already zero from the allocator's zero-fill. Epilogue add rsp,8 and return pool_idx in rax. All cmp immediates (0) imm8-safe. Byte stores via mov_b. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_re_.",
      block: {
        sub rsp, 8;                            // align for nested CALL

        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_re_epilogue;

        // Compute node address.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Write kind = RT_KIND_TYROW.
        mov rcx, 4;
        mov_b [r10 + 0], rcx;

        // subkind at +2 is already 0 (ROW_EMPTY) from zero-fill;
        // write it explicitly for self-documenting intent.
        xor rcx, rcx;
        mov_b [r10 + 2], rcx;

      rt_re_epilogue:
        add rsp, 8;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_var() -> u64
  //
  //   rax = pool_idx of the new ROW_VAR node, or 0 on pool-full.
  //
  // Allocates a TyRow node with subkind = ROW_VAR. Mints a fresh
  // var_id from HmCore's _hm_var_next counter (shared with TyVar
  // minting -- the var_id namespace is unified across type-vars
  // and row-vars, so a scheme-generalise walk can distinguish them
  // only by the owning node's kind, not by its var_id). Labels
  // prefixed rt_rv_.
  //
  // Stack frame: zero callee-save pushes + one nested CALL. sub
  // rsp, 8 for alignment -> rsp%16==0 at CALL. Labels prefixed rt_rv_.
  // ==========================================================================
  pub let _rt_row_var : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_var allocates a ROW_VAR TyRow node. Zero callee-save pushes; one nested CALL to _rt_alloc_node. Prologue sub rsp,8 for alignment. Call _rt_alloc_node -> rax = pool_idx (0 on full). If rax == 0: epilogue and return 0. Else compute node_addr via shl/lea/add; write kind = 4 at [+0], subkind = 2 (RT_SUBKIND_VAR) at [+2]. Load `_hm_var_next` via `lea r11, [rip + _hm_var_next]; mov rcx, [r11]`; write rcx as u32 var_id at [+4] via mov_d; bump _hm_var_next in-place by rcx+1 via `add rcx, 1; mov [r11], rcx`. arg1/arg2 remain zero from the allocator's zero-fill. Epilogue add rsp,8 and return pool_idx in rax. All cmp immediates (0) imm8-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_rv_.",
      block: {
        sub rsp, 8;                            // align for nested CALL

        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_rv_epilogue;

        // Compute node address.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // kind = RT_KIND_TYROW (4).
        mov rcx, 4;
        mov_b [r10 + 0], rcx;

        // subkind = RT_SUBKIND_VAR (2).
        mov rcx, 2;
        mov_b [r10 + 2], rcx;

        // Mint fresh var_id from _hm_var_next.
        lea r11, [rip + _hm_var_next];
        mov rcx, [r11];
        mov_d [r10 + 4], rcx;                  // arg0 = var_id
        add rcx, 1;
        mov [r11], rcx;

      rt_rv_epilogue:
        add rsp, 8;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_extend(label_hash, field_type_idx, rest_row_idx) -> u64
  //
  //   rdi = label_hash         (u32 FNV-1a 32 of the field name)
  //   rsi = field_type_idx     (pool_idx of the field's type)
  //   rdx = rest_row_idx       (pool_idx of the rest-of-row)
  //   rax = pool_idx of the new ROW_EXT node, or 0 on pool-full.
  //
  // The caller is responsible for ensuring (a) rest_row_idx names a
  // TyRow node (ROW_EMPTY, ROW_EXT or ROW_VAR), and (b) label_hash
  // is not already present in rest_row_idx (duplicate-label detection
  // is _rt_row_unify's job, not this constructor's -- a parse-site
  // caller that is building a record literal with a syntax-checked
  // disjoint field list already knows this invariant holds).
  //
  // Register map: 1 callee-save push (rbx) to park rdi across the
  // CALL; rsi and rdx are also saved into r12/r13 which are then
  // written into the node. Actually simpler: pushing nothing and
  // instead spilling the three args into stack slots works too, but
  // using callee-save registers is cleaner. Push 3 callee-save: rbx,
  // r12, r13 (24 bytes). Entry rsp%16==8; +24 = %16==0; no further
  // sub needed. Labels prefixed rt_rx_.
  // ==========================================================================
  pub let _rt_row_extend : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (label_hash: u64) (field_type_idx: u64) (rest_row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_extend allocates a ROW_EXT TyRow node. 3 callee-save pushes (rbx=label_hash, r12=field_type_idx, r13=rest_row_idx) = 24 bytes; entry rsp%16==8, after pushes rsp%16==0 and the single nested CALL to _rt_alloc_node sees aligned stack. Save args into callee-save regs BEFORE CALL (rdi/rsi/rdx are caller-save under SysV so _rt_alloc_node may clobber them). Call _rt_alloc_node -> rax = pool_idx (0 on full). If rax == 0: epilogue and return 0. Compute node_addr `mov r10, rax; shl r10, 4; lea r11, [rip + _hm_pool]; add r10, r11`. Write kind = 4 at [+0], subkind = 1 (RT_SUBKIND_EXT) at [+2], arity = 2 at [+1]. Write arg0 = rbx (label_hash u32) at [+4] via mov_d; arg1 = r12 (field_type_idx u32) at [+8] via mov_d; arg2 = r13 (rest_row_idx u32) at [+12] via mov_d. Epilogue pops rbx/r12/r13 and returns pool_idx in rax. All cmp immediates (0) imm8-safe. u32 stores via mov_d. Byte stores via mov_b. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_rx_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Save args into callee-save regs (nested CALL will clobber rdi/rsi/rdx).
        mov rbx, rdi;                          // label_hash
        mov r12, rsi;                          // field_type_idx
        mov r13, rdx;                          // rest_row_idx

        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_rx_epilogue;

        // Compute node address.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // kind = RT_KIND_TYROW (4).
        mov rcx, 4;
        mov_b [r10 + 0], rcx;

        // arity = 2.
        mov rcx, 2;
        mov_b [r10 + 1], rcx;

        // subkind = RT_SUBKIND_EXT (1).
        mov rcx, 1;
        mov_b [r10 + 2], rcx;

        // arg0 = label_hash (u32).
        mov_d [r10 + 4], rbx;

        // arg1 = field_type_idx (u32).
        mov_d [r10 + 8], r12;

        // arg2 = rest_row_idx (u32).
        mov_d [r10 + 12], r13;

      rt_rx_epilogue:
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _rt_record_type(row_idx) -> u64
  //
  //   rdi = row_idx     (pool_idx of a row node)
  //   rax = pool_idx of the TyApp(TyCon(RECORD,1), row_idx), or 0
  //         on pool-full.
  //
  // Allocates two pool slots: a TyCon(con_id=RT_CON_RECORD, arity=1)
  // and a TyApp whose left = the TyCon and right = row_idx. The
  // TyApp arity byte is 2 (per hm_core convention: TyApp is always
  // binary at the raw-node layer; the TyCon's arity byte declares
  // the user-facing arity of the type constructor). Labels prefixed
  // rt_rt_.
  //
  // Register map: 1 callee-save push (rbx = row_idx across the two
  // nested CALLs) + 1 slot for the first allocation's pool_idx (r12).
  // 2 pushes = 16B; entry rsp%16==8, +16 = %16==8; add sub rsp,8 for
  // alignment -> rsp%16==0 at CALL.
  // ==========================================================================
  pub let _rt_record_type : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_record_type allocates TyApp(TyCon(RECORD,1), row_idx). 2 callee-save pushes (rbx=row_idx, r12=con_idx) + sub rsp,8 pad = 24B; entry rsp%16==8, +24 -> rsp%16==0 at every nested CALL. First alloc: _rt_alloc_node -> con_idx; write it as TyCon with kind=2 (RT_HM_KIND_TYCON) at [+0], arity=1 at [+1], subkind=0 at [+2] (unused for TyCon; left at zero-fill but set explicitly), con_id=RT_CON_RECORD=10 as u32 at [+4] via mov_d. Second alloc: _rt_alloc_node -> app_idx. Write it as TyApp with kind=3 (RT_HM_KIND_TYAPP) at [+0], arity=2 at [+1], arg0=con_idx u32 at [+4], arg1=rbx (row_idx) u32 at [+8]. On ANY alloc failure (rax == 0): skip remaining writes and return 0. Epilogue pops r12/rbx and returns pool_idx. All cmp immediates (0) imm8-safe. u32 stores via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_rt_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                          // row_idx

        // --- First allocation: TyCon(RECORD, arity=1).
        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_rt_full;
        mov r12, rax;                          // con_idx

        // Compute node_addr.
        mov r10, r12;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // kind = RT_HM_KIND_TYCON (2).
        mov rcx, 2;
        mov_b [r10 + 0], rcx;

        // arity = 1 (record is unary over its row child).
        mov rcx, 1;
        mov_b [r10 + 1], rcx;

        // con_id = RT_CON_RECORD (10) at arg0.
        mov rcx, 10;
        mov_d [r10 + 4], rcx;

        // --- Second allocation: TyApp(con_idx, row_idx).
        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_rt_full;

        // Compute app_node_addr; app_idx is in rax, keep it in rax
        // for return and use r10 for the write destination.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // kind = RT_HM_KIND_TYAPP (3).
        mov rcx, 3;
        mov_b [r10 + 0], rcx;

        // arity = 2 (TyApp is always binary at the node layer).
        mov rcx, 2;
        mov_b [r10 + 1], rcx;

        // arg0 = con_idx (u32).
        mov_d [r10 + 4], r12;

        // arg1 = row_idx (u32).
        mov_d [r10 + 8], rbx;

        jmp rt_rt_epilogue;

      rt_rt_full:
        xor rax, rax;

      rt_rt_epilogue:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_select(row_idx, label_hash, out_type_idx_ptr) -> errno
  //
  //   rdi = row_idx
  //   rsi = label_hash
  //   rdx = out_type_idx_ptr
  //   rax = RT_OK / RT_ERR_LABEL_MISSING
  //
  // Walks the row chain. At each step: _rt_find on current cursor;
  // read kind + subkind. ROW_EXT: compare arg0 to label_hash; if
  // match, write arg1 to *out_type_idx_ptr and return RT_OK; else
  // advance cursor := arg2. ROW_EMPTY or ROW_VAR tail: return
  // RT_ERR_LABEL_MISSING (an open row-var tail could in principle
  // match the label if the var is later bound to a row containing
  // it; M2 treats ROW_VAR tails as "no commitment yet" and returns
  // LABEL_MISSING conservatively -- the pipeline-record select site
  // that drove this call will have already run _rt_row_unify to
  // constrain the row shape).
  //
  // Register map: 3 callee-save pushes (rbx=cursor, r12=label_hash,
  // r13=out_type_idx_ptr) + sub rsp, 8 pad = 32B; entry rsp%16==8,
  // after prologue rsp%16==0 at every nested CALL (_rt_find). Labels
  // prefixed rt_sel_.
  // ==========================================================================
  pub let _rt_row_select : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) (label_hash: u64) (out_type_idx_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_select walks the row chain for label_hash. 3 callee-save pushes (rbx=cursor, r12=label_hash, r13=out_type_idx_ptr) + sub rsp,8 pad = 32B; entry rsp%16==8, after prologue rsp%16==0 at every nested CALL to _rt_find. Loop: rdi:=rbx; call _rt_find; rbx:=rax. Compute node_addr; read kind byte. If kind != 4 (RT_KIND_TYROW) return RT_ERR_LABEL_MISSING (the row chain degenerated through an uninhabited path -- treated as miss). Read subkind. If subkind == 0 (EMPTY) or 2 (VAR): return LABEL_MISSING. If subkind == 1 (EXT): read arg0 u32 (label), compare to r12 (label_hash); match -> read arg1 u32 (field_type_idx), store at [r13+0] via mov [r13+0], rax (u64 store OK since we zero the upper 32 via xor+mov_d read), return RT_OK. Else advance: read arg2 u32 (rest_row_idx) into rbx, loop. All cmp immediates (0, 1, 2, 4, status codes 0x3600..0x3606) fit imm32 with bit 31 clear. Byte loads via mov_b; u32 loads via mov_d; u64 store at *out_type_idx_ptr via plain mov (we build the full qword via xor+mov_d which zero-extends). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_sel_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                          // rbx = cursor
        mov r12, rsi;                          // r12 = label_hash
        mov r13, rdx;                          // r13 = out_type_idx_ptr

      rt_sel_loop:
        // Resolve current cursor through _rt_find.
        mov rdi, rbx;
        call _rt_find;
        mov rbx, rax;

        // Compute node_addr.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Read kind byte.
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 4;                            // RT_KIND_TYROW
        jne rt_sel_miss;

        // Read subkind byte at +2.
        xor rcx, rcx;
        mov_b rcx, [r10 + 2];

        // ROW_EMPTY (0) or ROW_VAR (2) -> miss.
        cmp rcx, 0;
        je  rt_sel_miss;
        cmp rcx, 2;
        je  rt_sel_miss;

        // Must be ROW_EXT (1) -- otherwise schema violation.
        cmp rcx, 1;
        jne rt_sel_miss;

        // Compare label.
        xor rax, rax;
        mov_d rax, [r10 + 4];                  // label hash at arg0
        cmp rax, r12;
        jne rt_sel_next;

        // Hit: write field-type pool_idx to *out_type_idx_ptr.
        xor rax, rax;
        mov_d rax, [r10 + 8];                  // field_type_idx at arg1
        mov [r13 + 0], rax;

        xor rax, rax;                          // RT_OK
        jmp rt_sel_epilogue;

      rt_sel_next:
        // Advance: cursor := arg2 (rest_row_idx).
        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov rbx, rax;
        jmp rt_sel_loop;

      rt_sel_miss:
        mov rax, 0x3600;                       // RT_ERR_LABEL_MISSING
        jmp rt_sel_epilogue;

      rt_sel_epilogue:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_restrict(row_idx, label_hash,
  //                  out_type_idx_ptr, out_rest_idx_ptr) -> errno
  //
  //   rdi = row_idx
  //   rsi = label_hash
  //   rdx = out_type_idx_ptr    (receives field_type pool_idx)
  //   rcx = out_rest_idx_ptr    (receives restricted row pool_idx)
  //   rax = RT_OK / RT_ERR_LABEL_MISSING / RT_ERR_POOL_FULL
  //
  // Two-phase restrict:
  //
  //   Phase 1 (walk + collect): walk the chain finding the first
  //     ROW_EXT whose label matches. Record every preceding
  //     ROW_EXT's (label, field_type) pair in a scratch array
  //     stored at _hm_subst_table[384..512) (3 x 4 bytes per entry,
  //     up to 10 entries at M2 -- larger records are rejected with
  //     RT_ERR_LABEL_MISSING if the walk overflows). Note the
  //     tail (ROW_EMPTY, ROW_VAR, or the ROW_EXT that follows the
  //     matched one).
  //
  //   Phase 2 (rebuild): starting from the tail, repeatedly allocate
  //     ROW_EXT nodes prepending the collected (label, field_type)
  //     pairs in reverse order of collection. The final allocation
  //     is the restricted-row root; write its pool_idx to
  //     *out_rest_idx_ptr.
  //
  // M2 restrict is conservative on ROW_VAR tails (returns
  // LABEL_MISSING) because committing to a shape ahead of
  // unification would prematurely close an otherwise-open row. The
  // caller that wants to restrict a polymorphic record field should
  // first run _rt_row_unify to force the row's shape, then restrict.
  //
  // Scratch usage: _hm_subst_table[384..512) = 128 bytes. 10 entries
  // of (u32 label, u32 field_type_idx) = 80 bytes; remaining 48 bytes
  // reserved for M3+ (e.g. per-entry source span in R225.M7). We
  // deliberately pick a scratch slice disjoint from hm_core's uses:
  // _hm_instantiate uses [0..512), _hm_generalise uses [0..512) in
  // two halves [0..256) and [256..512). The _rt_row_restrict walk
  // is pure-row and never aliases with those passes because row-
  // flavoured work and type-scheme work never happen inside the
  // same shell turn (type-check runs over the parsed AST then
  // feeds the result into evaluation; the scratch is re-used
  // between phases).
  //
  // Register map: 6 callee-save pushes (rbx=cursor, rbp=label_hash,
  // r12=out_type_idx_ptr, r13=out_rest_idx_ptr, r14=collected_count,
  // r15=tail_idx) + sub rsp, 8 pad = 56B; entry rsp%16==8, after
  // prologue rsp%16==0 at every nested CALL (_rt_find +
  // _rt_alloc_node). Labels prefixed rt_rr_.
  //
  // RT_MAX_PREFIX_FIELDS = 10 (bounded by the 128/12-byte scratch
  // slot = 10, with one entry of slack).
  // ==========================================================================
  pub let RT_MAX_PREFIX_FIELDS : u64 = 10

  pub let _rt_row_restrict : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) (label_hash: u64)
       (out_type_idx_ptr: u64) (out_rest_idx_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_restrict walks the row and rebuilds without the matched extension. 6 callee-save pushes (rbx=cursor, rbp=label_hash, r12=out_type_idx_ptr, r13=out_rest_idx_ptr, r14=collected_count, r15=tail_idx) + sub rsp,8 pad = 56B; entry rsp%16==8, after prologue rsp%16==0 at every nested CALL (_rt_find, _rt_alloc_node). Phase 1: loop: _rt_find(cursor); read kind; if != 4 miss; read subkind; EMPTY/VAR -> miss; EXT: compare arg0 to rbp. Match -> read arg1 (field_type), store at [r12+0], read arg2 (next_tail) into r15, break out of Phase 1. No match -> append (arg0 u32 label, arg1 u32 ftype) to _hm_subst_table[384 + r14*8 .. +8) via two mov_d; r14+=1; if r14 >= RT_MAX_PREFIX_FIELDS -> miss (over-long prefix at M2); cursor := arg2; loop. Phase 2: rax := r15 (tail), then for j = r14-1 down to 0: load scratch[384+j*8] (label), scratch[384+j*8+4] (ftype), call _rt_alloc_node -> new_idx (0 on full -> pool_full), compute node_addr, write kind=4/arity=2/subkind=1/arg0=label/arg1=ftype/arg2=rax; rax:=new_idx. End of Phase 2: store rax at [r13+0], return RT_OK. Scratch region [384..512) is disjoint from _hm_instantiate's [0..512) and _hm_generalise's [0..256)+[256..512) because row-flavoured work and type-scheme work never interleave inside one turn. All cmp immediates (0, 1, 2, 4, 10, status codes 0x3600..0x3606) fit imm32 with bit 31 clear. Byte loads via mov_b, u32 loads via mov_d, u32 stores via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_rr_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // cursor
        mov rbp, rsi;                          // label_hash
        mov r12, rdx;                          // out_type_idx_ptr
        mov r13, rcx;                          // out_rest_idx_ptr
        xor r14, r14;                          // collected_count = 0
        xor r15, r15;                          // tail_idx = 0 (unset)

        // --- Phase 1: walk + collect prefix fields.
      rt_rr_walk_loop:
        mov rdi, rbx;
        call _rt_find;
        mov rbx, rax;

        // Compute node_addr.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Read kind.
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 4;
        jne rt_rr_miss;

        // Read subkind.
        xor rcx, rcx;
        mov_b rcx, [r10 + 2];

        cmp rcx, 0;                            // ROW_EMPTY
        je  rt_rr_miss;
        cmp rcx, 2;                            // ROW_VAR
        je  rt_rr_miss;
        cmp rcx, 1;                            // ROW_EXT
        jne rt_rr_miss;

        // Compare label.
        xor rax, rax;
        mov_d rax, [r10 + 4];                  // arg0 = label
        cmp rax, rbp;
        je  rt_rr_match;

        // No match: append (label, field_type) to scratch.
        cmp r14, 10;                           // RT_MAX_PREFIX_FIELDS
        jae rt_rr_miss;                        // over-long prefix at M2

        // scratch_addr = &_hm_subst_table + 384 + r14*8.
        mov r9, r14;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;

        // label already in rax from the compare above.
        mov_d [r9 + 0], rax;                   // label slot (u32)

        // Read arg1 (field_type).
        xor rax, rax;
        mov_d rax, [r10 + 8];
        mov_d [r9 + 4], rax;                   // field_type slot (u32)

        add r14, 1;

        // cursor := arg2.
        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov rbx, rax;
        jmp rt_rr_walk_loop;

      rt_rr_match:
        // Write field_type_idx to *out_type_idx_ptr.
        xor rax, rax;
        mov_d rax, [r10 + 8];
        mov [r12 + 0], rax;

        // tail_idx = arg2.
        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov r15, rax;

        // --- Phase 2: rebuild in reverse order.
        // rbx now acts as "accumulator pool_idx" (starts at tail,
        // becomes each successive ROW_EXT).
        mov rbx, r15;

      rt_rr_rebuild_loop:
        cmp r14, 0;
        je  rt_rr_rebuild_done;

        // j := r14 - 1 (index into scratch).
        sub r14, 1;

        // scratch_addr = &_hm_subst_table + 384 + r14*8.
        mov r9, r14;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;

        // Load (label, field_type) BEFORE the alloc call (alloc
        // clobbers caller-save regs; stash in r12/r13 would collide
        // with the output pointers, so stash into the stack slot
        // we don't use for anything else -- actually r9 itself is
        // a scratch-pointer, we can re-derive it. Simpler: load the
        // two u32 into caller-save r10 (label) and r11 (ftype),
        // call alloc, then recompute scratch pointer isn't needed
        // because we have r14 again. But r10 and r11 are caller-save
        // and get clobbered by the CALL. So we must spill them. Use
        // the stack pad slot at [rsp+0]).
        xor rax, rax;
        mov_d rax, [r9 + 0];                   // label
        mov [rsp + 0], rax;                    // spill label

        // Allocate ROW_EXT node.
        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_rr_pool_full;

        // Compute node_addr.
        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        // Write kind = 4, arity = 2, subkind = 1.
        mov rcx, 4;
        mov_b [r10 + 0], rcx;
        mov rcx, 2;
        mov_b [r10 + 1], rcx;
        mov rcx, 1;
        mov_b [r10 + 2], rcx;

        // Write arg0 = label (spilled).
        mov rcx, [rsp + 0];
        mov_d [r10 + 4], rcx;

        // Reload field_type from scratch (r14 was decremented but
        // retains the index that matches the scratch position we
        // read label from -- scratch_addr still at base + r14*8).
        mov r9, r14;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;
        xor rcx, rcx;
        mov_d rcx, [r9 + 4];
        mov_d [r10 + 8], rcx;                  // arg1 = field_type

        // arg2 = rbx (accumulator -- previous tail or ROW_EXT).
        mov_d [r10 + 12], rbx;

        // Advance accumulator.
        mov rbx, rax;
        jmp rt_rr_rebuild_loop;

      rt_rr_rebuild_done:
        // rbx is the final restricted-row root.
        mov [r13 + 0], rbx;
        xor rax, rax;                          // RT_OK
        jmp rt_rr_epilogue;

      rt_rr_miss:
        mov rax, 0x3600;                       // RT_ERR_LABEL_MISSING
        jmp rt_rr_epilogue;

      rt_rr_pool_full:
        mov rax, 0x3602;                       // RT_ERR_POOL_FULL
        jmp rt_rr_epilogue;

      rt_rr_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_concat(row_a_idx, row_b_idx) -> packed_u64
  //
  //   rdi = row_a_idx
  //   rsi = row_b_idx
  //   rax = (result_idx << 32) | status
  //
  // Append fields of row_a onto row_b. Row_a must terminate in
  // ROW_EMPTY; a ROW_VAR tail returns RT_ERR_CLOSED_ROW (the "closed"
  // name is a slight misnomer in this failure case -- row_a's tail
  // was NOT a ground-closed row; M3+ widens the definition). Label
  // collisions between row_a's fields and row_b return
  // RT_ERR_LABEL_DUP.
  //
  // Algorithm:
  //   Phase 1: walk row_a, collecting (label, field_type) pairs into
  //            _hm_subst_table[384..512) (bounded by
  //            RT_MAX_PREFIX_FIELDS = 10).
  //   Phase 2: for each collected label, call _rt_row_select against
  //            row_b with that label; a RT_OK return means collision
  //            -> RT_ERR_LABEL_DUP.
  //   Phase 3: rebuild in reverse order, prepending onto row_b.
  //
  // Register map: 6 callee-save pushes (rbx=cursor/accumulator,
  // rbp=row_b_idx, r12=collected_count, r13=label_scratch_cursor,
  // r14=unused/pad, r15=unused/pad) + sub rsp, 24 (3 slots: slot0=
  // spill for label across CALL, slot1=spill for ftype, slot2=pad)
  // = 72B; entry rsp%16==8, after prologue rsp%16==0 at every nested
  // CALL (_rt_find, _rt_row_select, _rt_alloc_node). Labels prefixed
  // rt_cat_.
  // ==========================================================================
  pub let _rt_row_concat : (u64, u64) -> u64 !{mem} @{} =
    fn (row_a_idx: u64) (row_b_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_concat appends row_a onto row_b. 6 callee-save pushes (rbx=cursor/accumulator, rbp=row_b_idx, r12=collected_count, r13=unused, r14=unused, r15=unused) + sub rsp,24 (3 slots: spill label across CALL, spill ftype, spill scratch_cursor) = 72B; entry rsp%16==8, after prologue rsp%16==0 at every nested CALL (_rt_find, _rt_row_select, _rt_alloc_node). Phase 1: loop over row_a: _rt_find; read kind/subkind. ROW_EMPTY tail -> exit Phase 1. ROW_VAR tail -> RT_ERR_CLOSED_ROW. ROW_EXT -> append (label u32, ftype u32) to scratch[384 + r12*8 .. +8), r12+=1, bound-check against RT_MAX_PREFIX_FIELDS (10, else LABEL_MISSING -- treat as 'too wide' to match the restrict discipline). Phase 2: for j in 0..r12: call _rt_row_select(rbp, label_j, &slot2) where slot2 is a stack-local u64; if returns RT_OK -> RT_ERR_LABEL_DUP. Phase 3: rebuild in reverse order; start accumulator at rbp (row_b); for j = r12-1 down to 0: alloc ROW_EXT with arg0=scratch[j].label, arg1=scratch[j].ftype, arg2=accumulator; accumulator := new_idx. Final: return (accumulator << 32) | RT_OK. All cmp immediates (0, 1, 2, 4, 10, status codes 0x3600..0x3606) fit imm32 with bit 31 clear. Byte loads via mov_b, u32 loads via mov_d, u32 stores via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_cat_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                          // cursor = row_a_idx
        mov rbp, rsi;                          // rbp = row_b_idx
        xor r12, r12;                          // collected_count = 0

        // --- Phase 1: walk row_a and collect.
      rt_cat_walk_loop:
        mov rdi, rbx;
        call _rt_find;
        mov rbx, rax;

        // Compute node_addr.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        xor rcx, rcx;
        mov_b rcx, [r10 + 0];
        cmp rcx, 4;
        jne rt_cat_miss;                       // treat as LABEL_MISSING
                                               // (schema violation)

        xor rcx, rcx;
        mov_b rcx, [r10 + 2];

        cmp rcx, 0;                            // ROW_EMPTY -> Phase 2
        je  rt_cat_walk_done;
        cmp rcx, 2;                            // ROW_VAR -> CLOSED_ROW
        je  rt_cat_closed;
        cmp rcx, 1;                            // ROW_EXT
        jne rt_cat_miss;

        // Append (label, ftype) to scratch.
        cmp r12, 10;                           // RT_MAX_PREFIX_FIELDS
        jae rt_cat_miss;

        mov r9, r12;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;

        xor rax, rax;
        mov_d rax, [r10 + 4];                  // label
        mov_d [r9 + 0], rax;

        xor rax, rax;
        mov_d rax, [r10 + 8];                  // ftype
        mov_d [r9 + 4], rax;

        add r12, 1;

        // Advance cursor := arg2.
        xor rax, rax;
        mov_d rax, [r10 + 12];
        mov rbx, rax;
        jmp rt_cat_walk_loop;

      rt_cat_walk_done:
        // --- Phase 2: collision check (every collected label vs row_b).
        xor rbx, rbx;                          // j = 0

      rt_cat_coll_loop:
        cmp rbx, r12;
        jae rt_cat_coll_done;

        // Load scratch[j].label into rsi for the _rt_row_select call.
        mov r9, rbx;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;
        xor rax, rax;
        mov_d rax, [r9 + 0];                   // label

        mov rdi, rbp;                          // row_b_idx
        mov rsi, rax;                          // label_hash
        lea rdx, [rsp + 16];                   // scratch out slot
        call _rt_row_select;
        cmp rax, 0;                            // RT_OK means label exists in row_b
        je  rt_cat_dup;

        add rbx, 1;
        jmp rt_cat_coll_loop;

      rt_cat_coll_done:
        // --- Phase 3: rebuild in reverse order.
        mov rbx, rbp;                          // accumulator = row_b_idx

      rt_cat_build_loop:
        cmp r12, 0;
        je  rt_cat_build_done;

        sub r12, 1;

        // Spill label + ftype from scratch (both survive the alloc call
        // because we re-derive scratch addr post-call, but easier to
        // just reload r12 and recompute).
        mov r9, r12;
        shl r9, 3;
        lea r8, [rip + _hm_subst_table];
        add r9, r8;
        add r9, 384;

        xor rax, rax;
        mov_d rax, [r9 + 0];
        mov [rsp + 0], rax;                    // spill label

        xor rax, rax;
        mov_d rax, [r9 + 4];
        mov [rsp + 8], rax;                    // spill ftype

        // Alloc ROW_EXT.
        call _rt_alloc_node;
        cmp rax, 0;
        je  rt_cat_pool_full;

        mov r10, rax;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;

        mov rcx, 4;
        mov_b [r10 + 0], rcx;
        mov rcx, 2;
        mov_b [r10 + 1], rcx;
        mov rcx, 1;
        mov_b [r10 + 2], rcx;

        mov rcx, [rsp + 0];                    // label
        mov_d [r10 + 4], rcx;
        mov rcx, [rsp + 8];                    // ftype
        mov_d [r10 + 8], rcx;
        mov_d [r10 + 12], rbx;                 // arg2 = accumulator

        mov rbx, rax;
        jmp rt_cat_build_loop;

      rt_cat_build_done:
        // Pack result: (rbx << 32) | RT_OK.
        mov rax, rbx;
        shl rax, 32;
        // RT_OK = 0, so no need to OR.
        jmp rt_cat_epilogue;

      rt_cat_miss:
        mov rax, 0x3600;                       // RT_ERR_LABEL_MISSING
        jmp rt_cat_epilogue;

      rt_cat_closed:
        mov rax, 0x3604;                       // RT_ERR_CLOSED_ROW
        jmp rt_cat_epilogue;

      rt_cat_dup:
        mov rax, 0x3601;                       // RT_ERR_LABEL_DUP
        jmp rt_cat_epilogue;

      rt_cat_pool_full:
        mov rax, 0x3602;                       // RT_ERR_POOL_FULL
        jmp rt_cat_epilogue;

      rt_cat_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _rt_row_unify(a_idx, b_idx) -> errno
  //
  //   rdi = a_idx
  //   rsi = b_idx
  //   rax = RT_OK / RT_ERR_LABEL_MISSING / RT_ERR_LABEL_DUP /
  //         RT_ERR_POOL_FULL / RT_ERR_KIND_MISMATCH / RT_ERR_CLOSED_ROW /
  //         RT_ERR_OCCURS / RT_ERR_MISMATCH
  //
  // Row-aware general unifier. Recursively walks matching subterms:
  //
  //   1. a := _rt_find(a); b := _rt_find(b).
  //   2. If a == b -> RT_OK.
  //   3. Dispatch on (kind_a, kind_b):
  //      a) Both TyVar (hm_core kind=1):
  //         - occurs(a, b)? -> MISMATCH (treat as occurs-fail at M2;
  //           caller discriminates via hm_core's HM_ERR_OCCURS if it
  //           cares; the two codes are disjoint ranges so no shadowing).
  //         - bind a.resolved := b.
  //         Actually: delegate to _hm_unify for pure HM subterms. This
  //         keeps the one implementation of occurs-check / binding
  //         canonical.
  //      b) Both TyCon: delegate to _hm_unify.
  //      c) Both TyApp: delegate to _hm_unify is NOT safe because its
  //         children may themselves be rows. Instead, compare the
  //         left/right children via _rt_row_unify (self-recursive).
  //         Arity byte is already encoded in the children.
  //      d) Both TyRow:
  //         - subkind_a == subkind_b == EMPTY -> RT_OK.
  //         - One is VAR: occurs-check (walk the other row); if hit,
  //           RT_ERR_OCCURS; else bind var.arg2 := other.
  //         - Both EXT with same label: unify field types (recursive);
  //           unify rest-rows (recursive).
  //         - Both EXT with different labels: Remy pivot. Allocate a
  //           fresh ROW_VAR rho_fresh; build pivot_a = ROW_EXT(label_b,
  //           ftype_b, rho_fresh), pivot_b = ROW_EXT(label_a, ftype_a,
  //           rho_fresh); unify(rest(a), pivot_a); unify(rest(b),
  //           pivot_b).
  //         - EMPTY vs EXT (either direction): RT_ERR_CLOSED_ROW.
  //      e) Mixed kinds -> RT_ERR_KIND_MISMATCH.
  //
  // Register map: 6 callee-save pushes (rbx=a, rbp=b, r12=a_kind,
  // r13=b_kind, r14=a_node_addr, r15=b_node_addr) + sub rsp, 8 pad =
  // 56B; entry rsp%16==8, after prologue rsp%16==0 at every nested
  // CALL (_rt_find, _hm_unify, _rt_alloc_node, _rt_row_var,
  // _rt_row_extend, self-recursive _rt_row_unify). Labels prefixed
  // rt_un_.
  // ==========================================================================
  pub let _rt_row_unify : (u64, u64) -> u64 !{mem} @{} =
    fn (a_idx: u64) (b_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M2 (#2683): _rt_row_unify Remy-style row + general-type recursive unifier. 6 callee-save pushes (rbx=a, rbp=b, r12=a_kind, r13=b_kind, r14=a_node_addr, r15=b_node_addr) + sub rsp,8 pad = 56B; entry rsp%16==8, after prologue rsp%16==0 at every nested CALL (_rt_find, _hm_unify for TyVar/TyCon arms, _rt_row_var and _rt_row_extend for Remy pivot allocations, self-recursive _rt_row_unify for TyApp children + ROW_EXT recursive subterms). Flow: (1) find both; (2) identity -> RT_OK; (3) load kinds; (4) kind_a == TyVar OR kind_b == TyVar -> delegate to _hm_unify(a, b) which handles occurs-check and binding (hm_core's internal state machine is canonical for pure HM binding; it does not know about rows but a TyVar can only unify with any-kind-at-all including a TyRow -- hm_core's unifier will set a.resolved := b verbatim regardless of b's kind; the subsequent _rt_find walks the chain correctly across kinds); (5) kind_a == TyCon && kind_b == TyCon -> _hm_unify (compares con_id + arity; nullary); (6) kind_a == TyApp && kind_b == TyApp -> recurse on left children, then right children (DO NOT delegate to _hm_unify's TyApp arm because its children may be rows); (7) kind_a == TyRow && kind_b == TyRow -> row branch (below); (8) else -> KIND_MISMATCH. Row branch dispatches on (subkind_a, subkind_b): EMPTY/EMPTY -> OK; VAR on left or right -> occurs-check via _rt_row_occurs then bind arg2 field via mov_d; EXT/EXT -> compare arg0 labels: match -> recurse on arg1 (field types) and arg2 (rest rows); mismatch -> Remy pivot: alloc rho_fresh = _rt_row_var; alloc pivot_a = _rt_row_extend(label_b, ftype_b, rho_fresh); alloc pivot_b = _rt_row_extend(label_a, ftype_a, rho_fresh); recurse(rest_a, pivot_a); recurse(rest_b, pivot_b); EMPTY/EXT (either direction) -> CLOSED_ROW. All cmp immediates (0, 1, 2, 3, 4, status codes 0x3600..0x3606) fit imm32 with bit 31 clear. Byte loads via mov_b, u32 loads via mov_d, u32 stores via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed rt_un_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // --- Step 1: find both sides.
        mov r14, rsi;                          // park b_idx in r14 before find(a)
        call _rt_find;                         // rdi still = a_idx
        mov rbx, rax;                          // rbx = find(a)

        mov rdi, r14;
        call _rt_find;
        mov rbp, rax;                          // rbp = find(b)

        // --- Step 2: identity -> OK.
        cmp rbx, rbp;
        je  rt_un_ok;

        // --- Compute node addresses + read kinds.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;
        mov r14, r10;                          // a_node_addr

        mov r10, rbp;
        shl r10, 4;
        lea r11, [rip + _hm_pool];
        add r10, r11;
        mov r15, r10;                          // b_node_addr

        xor r12, r12;
        mov_b r12, [r14 + 0];                  // a kind
        xor r13, r13;
        mov_b r13, [r15 + 0];                  // b kind

        // --- Step 3a: either side TyVar -> delegate to _hm_unify.
        cmp r12, 1;                            // RT_HM_KIND_TYVAR
        je  rt_un_delegate_hm;
        cmp r13, 1;
        je  rt_un_delegate_hm;

        // --- Step 3b: kind mismatch -> MISMATCH.
        cmp r12, r13;
        jne rt_un_kind_mismatch;

        // --- Step 3c: both TyCon -> delegate to _hm_unify.
        cmp r12, 2;                            // RT_HM_KIND_TYCON
        je  rt_un_delegate_hm;

        // --- Step 3d: both TyApp -> recurse on children.
        cmp r12, 3;                            // RT_HM_KIND_TYAPP
        je  rt_un_tyapp;

        // --- Step 3e: both TyRow -> row branch.
        cmp r12, 4;                            // RT_KIND_TYROW
        je  rt_un_tyrow;

        // Unknown kind.
        jmp rt_un_kind_mismatch;

        // ---------------------------------------------------------
        // Delegate to _hm_unify. _hm_unify sees a (possibly TyRow)
        // target as "an unknown kind TyApp-like node" from its
        // perspective, but on the TyVar/TyCon arms it will handle
        // correctly: a TyVar binds to a TyRow via the +12 resolved
        // slot which _rt_find walks; a TyCon-vs-TyRow comparison
        // produces HM_ERR_MISMATCH which we map to RT_ERR_MISMATCH
        // (the two codes are in disjoint bands so we don't need to
        // translate values -- the caller inspecting the return code
        // sees the hm_core band or our band depending on the error
        // path, and both bands document "field-type unification
        // failure" at their first slot).
        // ---------------------------------------------------------
      rt_un_delegate_hm:
        mov rdi, rbx;
        mov rsi, rbp;
        call _hm_unify;
        jmp rt_un_epilogue;                    // bubble up hm_core's errno

        // ---------------------------------------------------------
        // Both TyApp: unify left children then right children.
        // ---------------------------------------------------------
      rt_un_tyapp:
        xor rax, rax;
        mov_d rax, [r14 + 4];                  // a.arg0 (left_a)
        xor rcx, rcx;
        mov_d rcx, [r15 + 4];                  // b.arg0 (left_b)
        mov rdi, rax;
        mov rsi, rcx;
        call _rt_row_unify;
        cmp rax, 0;
        jne rt_un_epilogue;                    // bubble up left failure

        // Unify right children.
        xor rax, rax;
        mov_d rax, [r14 + 8];                  // a.arg1 (right_a)
        xor rcx, rcx;
        mov_d rcx, [r15 + 8];                  // b.arg1 (right_b)
        mov rdi, rax;
        mov rsi, rcx;
        call _rt_row_unify;
        jmp rt_un_epilogue;

        // ---------------------------------------------------------
        // Both TyRow: Remy row unification.
        // ---------------------------------------------------------
      rt_un_tyrow:
        xor r12, r12;
        mov_b r12, [r14 + 2];                  // a subkind
        xor r13, r13;
        mov_b r13, [r15 + 2];                  // b subkind

        // Both EMPTY -> OK.
        cmp r12, 0;
        jne rt_un_row_check_a_var;
        cmp r13, 0;
        jne rt_un_row_a_empty_b_other;
        jmp rt_un_ok;

      rt_un_row_a_empty_b_other:
        // a is EMPTY, b is EXT or VAR.
        cmp r13, 2;                            // b VAR
        je  rt_un_row_bind_b;
        jmp rt_un_closed_row;                  // EMPTY vs EXT

      rt_un_row_check_a_var:
        // a is EXT or VAR.
        cmp r12, 2;                            // a VAR
        je  rt_un_row_bind_a;

        // a is EXT.
        cmp r13, 0;
        je  rt_un_closed_row;                  // EXT vs EMPTY
        cmp r13, 2;
        je  rt_un_row_bind_b_against_ext;

        // Both EXT: label compare.
        xor rax, rax;
        mov_d rax, [r14 + 4];                  // label_a
        xor rcx, rcx;
        mov_d rcx, [r15 + 4];                  // label_b
        cmp rax, rcx;
        jne rt_un_row_pivot;

        // Same label: unify field types + unify rest-rows.
        xor rax, rax;
        mov_d rax, [r14 + 8];                  // ftype_a
        xor rcx, rcx;
        mov_d rcx, [r15 + 8];                  // ftype_b
        mov rdi, rax;
        mov rsi, rcx;
        call _rt_row_unify;
        cmp rax, 0;
        jne rt_un_epilogue;

        xor rax, rax;
        mov_d rax, [r14 + 12];                 // rest_a
        xor rcx, rcx;
        mov_d rcx, [r15 + 12];                 // rest_b
        mov rdi, rax;
        mov rsi, rcx;
        call _rt_row_unify;
        jmp rt_un_epilogue;

        // -----------------------------------------------------------
        // ROW_VAR bind helpers. Writes a.arg2 (resolved slot) := b_idx
        // (or b.arg2 := a_idx), after confirming the opposite side
        // does not transitively contain the row-var (occurs-check is
        // conservative: we skip it at M2 because the row grammar's
        // chain-of-extensions depth is bounded by the pool and we rely
        // on hm_core's TyVar occurs-check for the shared type-level
        // cycles. R225.M4 lands a full _rt_row_occurs; for M2 we
        // detect the degenerate case `bind self to self` via the
        // identity check at step (2) above).
        // -----------------------------------------------------------
      rt_un_row_bind_a:
        // a is VAR -- write a.arg2 := rbp.
        mov_d [r14 + 12], rbp;
        jmp rt_un_ok;

      rt_un_row_bind_b:
        // b is VAR -- write b.arg2 := rbx.
        mov_d [r15 + 12], rbx;
        jmp rt_un_ok;

      rt_un_row_bind_b_against_ext:
        // a is EXT, b is VAR -- bind b to a.
        mov_d [r15 + 12], rbx;
        jmp rt_un_ok;

        // -----------------------------------------------------------
        // Both EXT with different labels: Remy pivot.
        //   rho_fresh := _rt_row_var()
        //   pivot_a   := _rt_row_extend(label_b, ftype_b, rho_fresh)
        //   pivot_b   := _rt_row_extend(label_a, ftype_a, rho_fresh)
        //   unify(rest(a), pivot_a)
        //   unify(rest(b), pivot_b)
        //
        // Across the pivot, we must preserve label_a, ftype_a, rest_a,
        // label_b, ftype_b, rest_b, and the fresh row-var pool_idx.
        // We spill them into the stack slot [rsp+0] + the pad. Actually
        // simpler: we have one pad slot (8B). We can rebuild label_a /
        // label_b / etc. from r14 / r15 node pointers which stay alive
        // (callee-save), BUT a nested CALL to _rt_row_unify may cause
        // r14 or r15 to be reused for its own callee frame. Since they
        // ARE callee-save, the inner call restores them -- SysV ABI
        // guarantees that. So r14 / r15 stay valid across every nested
        // CALL. We reload label / ftype / rest from [r14+disp] and
        // [r15+disp] on demand after each call. We need to preserve
        // rho_fresh across the two pivot_* alloc calls -- store it in
        // the stack slot at [rsp+0] after _rt_row_var returns.
        // -----------------------------------------------------------
      rt_un_row_pivot:
        // 1) rho_fresh.
        call _rt_row_var;
        cmp rax, 0;
        je  rt_un_pool_full;
        mov [rsp + 0], rax;                    // spill rho_fresh

        // 2) pivot_a = _rt_row_extend(label_b, ftype_b, rho_fresh).
        xor rax, rax;
        mov_d rax, [r15 + 4];                  // label_b
        mov rdi, rax;
        xor rax, rax;
        mov_d rax, [r15 + 8];                  // ftype_b
        mov rsi, rax;
        mov rdx, [rsp + 0];                    // rho_fresh
        call _rt_row_extend;
        cmp rax, 0;
        je  rt_un_pool_full;

        // Unify rest_a with pivot_a.
        xor rcx, rcx;
        mov_d rcx, [r14 + 12];                 // rest_a
        mov rdi, rcx;
        mov rsi, rax;
        call _rt_row_unify;
        cmp rax, 0;
        jne rt_un_epilogue;

        // 3) pivot_b = _rt_row_extend(label_a, ftype_a, rho_fresh).
        xor rax, rax;
        mov_d rax, [r14 + 4];                  // label_a
        mov rdi, rax;
        xor rax, rax;
        mov_d rax, [r14 + 8];                  // ftype_a
        mov rsi, rax;
        mov rdx, [rsp + 0];                    // rho_fresh
        call _rt_row_extend;
        cmp rax, 0;
        je  rt_un_pool_full;

        // Unify rest_b with pivot_b.
        xor rcx, rcx;
        mov_d rcx, [r15 + 12];                 // rest_b
        mov rdi, rcx;
        mov rsi, rax;
        call _rt_row_unify;
        jmp rt_un_epilogue;

      rt_un_ok:
        xor rax, rax;                          // RT_OK
        jmp rt_un_epilogue;

      rt_un_kind_mismatch:
        mov rax, 0x3603;                       // RT_ERR_KIND_MISMATCH
        jmp rt_un_epilogue;

      rt_un_closed_row:
        mov rax, 0x3604;                       // RT_ERR_CLOSED_ROW
        jmp rt_un_epilogue;

      rt_un_pool_full:
        mov rax, 0x3602;                       // RT_ERR_POOL_FULL
        jmp rt_un_epilogue;

      rt_un_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
