// src/let_scope.pdx -- libpdx-pds-parser.R224.M5 (paideia-os#2679)
//
// LetScope: nested-lambda + `let` / `let rec` lexical scope frame
// pool for the paideia-shell lambda-lang surface, following the
// Damas-Milner standard-HM shadowing discipline. R224.M5 of the
// lambda-lang umbrella (paideia-os#2488); layered over R225.M1
// HmCore type-scheme storage via a u32 type_scheme_ref payload
// (TypeNode pool index at raw M5; TypeEnv scheme_id at the R229.M3+
// REPL wire-up). Co-landed with Wave 122's parallel R221.M5
// (unified AST at 0x4400..0x44FF band) and R222.M5 (registry client
// at 0x4500..0x45FF band) arms; this landing carves the disjoint
// 0x4600..0x46FF band.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R224 is the lambda-lang umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R224 --
// Lambda surface"). R224.M1 landed the lambda-literal header parser;
// R224.M2 landed the closure-capture list; R224.M3 landed the effect
// row (`!{...}`); R224.M4 landed the capability row (`@{...}`);
// R224.M5 (THIS module) lands the LEXICAL SCOPE FRAME POOL that
// supports nested lambdas and `let` / `let rec` binding resolution
// across the parse pass.
//
// The scope-frame pool is a parser-tier working-memory substrate: a
// 128-slot ring of 32-byte frames (slot 0 reserved as the
// null-sentinel so `parent_frame_ref == 0` means "no enclosing
// scope"). Each frame records ONE lexical binding (one `let`
// variable, one `let rec` variable, or one lambda parameter) and
// chains to its enclosing frame via `parent_frame_ref`. The three
// kinds share one record layout; only the `kind` discriminator byte
// differs. A resolve walks the parent chain inner-first so inner
// shadowing of an outer name is natural (first match wins; the
// outer binding is never visited).
//
// Scope at M5:
//   * recognise `let x = expr in body` with lexical scoping of `x`
//     across `body`; `x` is intended to be generalised to a type
//     scheme by the HM elaborator if its RHS has no free TyVars
//     bound by the enclosing scope (the generalisation step itself
//     is R225.M6; this landing stores the pool_idx the elaborator
//     chooses as the per-binding `type_scheme_ref`).
//   * recognise `let rec f = \x. ... f ... in body` -- `f` is in
//     scope of its own RHS (self-recursion). Mutual recursion
//     (`let rec f = ... and g = ... in body`) is landed by issuing
//     N `_ls_push_letrec` calls over the common parent before the
//     elaborator types the RHSs; the elaborator reads them back via
//     `_ls_resolve` on the shared frame cursor.
//   * recognise lambda parameter bindings `\x. body` -- `x` is in
//     scope across `body` only (lambda parameter is pushed as kind
//     SCOPE_LAMBDA on entry to the body-elaboration pass and popped
//     logically by the enclosing frame cursor at body exit).
//   * provide `_ls_resolve(frame, name, name_len)` -- inner-first
//     parent-chain walk returning the matching binding's
//     `type_scheme_ref` with `LS_OK`, or `LS_ERR_NOT_FOUND` when the
//     chain ends at the null-sentinel without a match.
//
// Out of scope at M5 (deferred):
//   * M5.1 TypeEnv `scheme_id` payload interpretation: raw M5 stores
//     the caller-supplied `type_scheme_ref` verbatim; the R229.M3+
//     REPL wire-up chooses whether that u32 is a HmCore pool_idx
//     (monomorphic) or a TypeEnv scheme_id (polymorphic).
//   * M5.2 Mutual-recursion batch helper: `_ls_push_letrec_group`
//     that takes an array of (name, scheme_ref) pairs and pushes N
//     frames atomically. Raw M5 asks the caller to loop over
//     `_ls_push_letrec`.
//   * M5.3 Grammar splice-points: `_ll_parse` consuming `let` /
//     `let rec` prefix syntax inside a lambda body. Raw M5 is a
//     working-memory substrate; the grammar driver that pushes the
//     frames lives at the R224.M5-dispatch layer which is R221.M5
//     unified-AST's responsibility.
//   * M5.4 Compacting pop: `_ls_pop` currently returns `parent` but
//     does NOT reclaim the slot (frames are append-only within a
//     parse pass; the pool is reset by re-calling `_ls_init` or by
//     calling `_ls_init` after a bulk `_ls_frame_next := 0` reset).
//     Compaction is M5.4+.
//   * M5.5 Frame fingerprint goldens for the smoke-mode asserter:
//     filed with the proptest harness as R224.M5-005.
//
// The parser is user-space (satellite library) because the shell runs
// in user space; the kernel-side substrate (R107+) never touches
// scope-frame annotation bytes directly.
//
// =============================================================================
// HM STANDARD SEMANTICS
// =============================================================================
//
// Standard HM shadowing:
//
//   let x = e1 in let x = e2 in body
//     -> inner `x` shadows outer within `body`. `_ls_resolve` on
//        the inner frame returns the inner binding's type_scheme_ref;
//        the outer binding is never reached.
//
// Recursion via `let rec`:
//
//   let rec f = \x. (f x) in body
//     -> `f` is in scope on the RHS of its own binding. The
//        elaborator pushes a SCOPE_LETREC frame BEFORE typing the
//        RHS, so a free-name resolution of `f` inside `\x. (f x)`
//        hits the self frame. Generalisation defers until the RHS
//        is typed (R225.M6).
//
//   let rec f = ... and g = ... in body
//     -> N SCOPE_LETREC frames are pushed over the common parent
//        before any RHS is typed; the elaborator reads them back
//        via `_ls_resolve` on the shared frame cursor.
//
// Lambda shadowing:
//
//   let x = e1 in \x. body
//     -> lambda param `x` shadows outer `let x` within `body`.
//        Same inner-first chain-walk rule as nested lets.
//
// =============================================================================
// FRAME RECORD LAYOUT  (32 BYTES, 128 FRAMES = 4096 BYTES POOL)
// =============================================================================
//
//   [+0x00]  kind                (u16)    SCOPE_LET=1,
//                                         SCOPE_LETREC=2,
//                                         SCOPE_LAMBDA=3,
//                                         0 = unused slot sentinel.
//   [+0x02]  flags               (u16)    reserved; 0.
//   [+0x04]  parent_frame_ref    (u32)    pool_idx of enclosing frame,
//                                         0 = top-level (null sentinel).
//   [+0x08]  name_inline         (u8[16]) binding name bytes, right-
//                                         padded with zero. Max 16.
//   [+0x18]  name_len            (u8)     1..16; 0 is slot-unused /
//                                         rejected input.
//   [+0x19]  reserved            (u8)     0.
//   [+0x1A]  reserved            (u16)    0.
//   [+0x1C]  type_scheme_ref     (u32)    opaque u32 chosen by the
//                                         caller: at raw M5 it is a
//                                         HmCore pool_idx; at
//                                         R229.M3+ REPL wire-up it
//                                         may be a TypeEnv
//                                         scheme_id; LetScope stores
//                                         + forwards the bytes
//                                         without interpretation.
//
// Pool index 0 is RESERVED as the null-sentinel (per the HmCore
// precedent). After `_ls_init`, `_ls_frame_next` is 1; valid frame
// refs are 1..127 (giving 127 usable frames out of a 128-slot pool).
// Pool-full is `_ls_frame_next >= 128`.
//
// =============================================================================
// POOL
// =============================================================================
//
//   .bss  _ls_frame_pool  : [u8; 4096]   @align(8)   128 frames * 32 B
//   .bss  _ls_frame_next  : u64          @align(8)   next-free idx
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ls_init() -> ()
//     Boot hook. Lazy-populates the null-sentinel at slot 0 by
//     setting `_ls_frame_next := 1`. Idempotent (re-call short-
//     circuits on next != 0). Called at the entry of every public
//     API that reads or writes the pool.
//
//   _ls_push_let(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
//     Push a SCOPE_LET frame. Returns the new frame_ref (>= 1) on
//     success, or 0 on bad-input / pool-full. Writes the record at
//     &_ls_frame_pool + next*32, then bumps next.
//
//   _ls_push_letrec(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
//     Push a SCOPE_LETREC frame. Same shape as _ls_push_let; the
//     only difference is the kind-byte discriminator.
//
//   _ls_push_lambda(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
//     Push a SCOPE_LAMBDA frame (lambda parameter binding).
//
//   _ls_resolve(frame_ref, name_ptr, name_len) -> packed_u64
//     Walk the parent chain starting at `frame_ref`, inner-first.
//     On name match (len equal, bytes equal), return
//     `(type_scheme_ref << 32) | LS_OK`. On chain-end (cursor == 0)
//     with no match, return `(0 << 32) | LS_ERR_NOT_FOUND`. On a
//     malformed cursor (>=128 or kind==0 mid-walk), return
//     `LS_ERR_BAD_FRAME`. On bad name input, return
//     `LS_ERR_BAD_NAME`.
//
//   _ls_pop(frame_ref) -> parent_frame_ref
//     Convenience accessor: read the parent u32 at
//     &_ls_frame_pool + frame_ref*32 + 4 and return it. Does NOT
//     free the slot (frames are append-only across a parse pass;
//     the pool is reset by a fresh _ls_init on a cleared next).
//     Returns 0 on frame_ref == 0 or frame_ref >= 128.
//
// Register maps (SysV):
//
//   _ls_init()                                       -> rax (ignored)
//   _ls_push_let(rdi, rsi, rdx, rcx)                 -> rax
//   _ls_push_letrec(rdi, rsi, rdx, rcx)              -> rax
//   _ls_push_lambda(rdi, rsi, rdx, rcx)              -> rax
//   _ls_push_impl(rdi, rsi, rdx, rcx, r8)            -> rax
//   _ls_resolve(rdi, rsi, rdx)                       -> rax
//   _ls_pop(rdi)                                     -> rax
//
// `_ls_push_impl` is a module-internal helper that the three public
// push wrappers tail-call-equivalent (sub rsp,8; call; add rsp,8;
// ret) through, with r8 pre-set to the kind byte. It is marked
// `pub` only because paideia-as object-visibility granularity is
// per-symbol; downstream callers should use the three named push
// entries, not `_ls_push_impl`.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and r11, imm64` -- bounds compares use `cmp r, imm32`
//     (immediates 0, 1, 3, 16, 32, 128 all fit imm32 with bit 31
//     clear).
//   - No 2-op `imul r, imm` -- frame stride 32 is `shl r, 5`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `LetScope` matches `let_scope.pdx`.
//   - Labels prefixed `ls_` (unique against the sibling parser-tier
//     modules: u8n_ (R221.M1), gi_ (R221.M2), wp_ (R221.M3), cl_
//     (R221.M4), sch_sig_ (R222.M1), cmd_sig_ (R222.M2), fi_
//     (R222.M3), afs_ (R222.M4), pl_ (R223.M1), rp_ (R223.M2), ll_
//     (R224.M1), cc_ (R224.M2), er_ (R224.M3), cr_ (R224.M4), hm_
//     (R225.M1), rt_ (R225.M2), dl_ (R226.M1), se_ (R229.M2), te_
//     (R229.M3)). Never bare `loop`/`if`/`let`/`fn`/`ret`/`done`.
//   - All `cmp reg, imm` immediates (0, 1, 3, 16, 32, 128, 4096,
//     status codes 0x4600..0x4604) fit imm32 with bit 31 clear and
//     are small positive.
//   - Byte loads via `xor r,r; mov_b r,[base + idx * 1]` with the
//     explicit *1 scale on reg+reg forms (paideia-as #1248
//     mitigation).
//   - u32 loads via `xor r,r; mov_d r,[addr + disp]`.
//   - u8 stores decomposed via staging register (`mov r11, base;
//     add r11, idx; mov_b [r11 + 0], src`) when the destination is
//     reg+reg; `mov_b [reg + imm_disp], src` is used when the
//     destination is reg+disp with no second register (ctx_lexer /
//     cap_row precedent).
//   - u32 stores via `mov_d [reg + imm_disp], src`.
//   - Cross-module .bss writes via `lea r11, [rip + sym]; mov [r11],
//     rax`.
//   - Register-liveness: r11 clobbered by every nested CALL. Every
//     value that must survive a nested CALL lives in r12..r15
//     (callee-save) or in the module's own .bss. In LetScope, only
//     `_ls_push_impl` and `_ls_resolve` make a nested CALL (both
//     call `_ls_init` idempotently at entry); the three push
//     wrappers also make the single `_ls_push_impl` nested CALL;
//     `_ls_init` and `_ls_pop` are pure leaves with no nested CALL.
//
// =============================================================================
// WAVE 120 LESSON (lazy-init at every entry)
// =============================================================================
//
// R224.M3 EffectRow's M3 landing had a lazy-init bug: _er_label_lookup
// read _er_label_table_count without calling _er_init, so the first
// _er_parse against a zero-initialised .bss missed every primitive.
// R224.M4 CapRow replicated the mitigation across every label-table
// reader. THIS module replicates the pattern across every public API
// that writes OR reads the frame pool: `_ls_push_impl` (and therefore
// each of the three push wrappers) and `_ls_resolve` each call
// `_ls_init` at their first instruction after the SysV prologue.
// `_ls_init`'s next-non-zero short-circuit keeps the hot path at one
// branch. `_ls_pop` is a pure-leaf read-only accessor on a frame
// whose kind=0 slot-sentinel is indistinguishable from a never-
// initialised .bss zero at the parent u32 slot, so `_ls_pop` is
// safe to skip the init call (the behaviour on a never-pushed-to
// pool is "return 0" which is also the correct behaviour for
// frame_ref == 0 after a legitimate push sequence).
//
// =============================================================================
// WAVE 120+121 LESSONS APPLIED
// =============================================================================
//
//   * Lazy-init `_ls_init` idempotent from writers AND readers.
//     Every push wrapper and `_ls_resolve` invokes it; `_ls_pop`
//     deliberately does not (pure leaf; zero-init pool returns 0
//     correctly without the init call).
//   * No chained-displacement operands. Every byte / u32 store uses
//     [base + imm_disp] with the disp folded into the write
//     instruction's displacement field directly; reg+reg
//     destinations are staged via r11.
//   * Exact-match tests use `jne`, not `jb` (precedent fix in cap_row:
//     an `rho` identifier length check that used `jb` mis-matched
//     "rhombus"; here `_ls_resolve` byte-compares with explicit
//     equality so no analogous pitfall).
//   * Full-u64 status compares on CALL return via `shl rax, 32; shr
//     rax, 32` to defensively zero-extend the low 32 before compare
//     against an imm32 sentinel. Not currently exercised here
//     (every nested CALL's rax is either consumed verbatim or
//     discarded via rax=... re-write), but documented for M5.1+
//     when the dispatcher starts chaining frame_ref returns from
//     `_ls_push_impl` through `_ls_resolve`.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R224.M5.1  TypeEnv scheme_id payload (`type_scheme_ref` is a
//              TypeEnv scheme_id instead of a HmCore pool_idx when
//              `flags & 1` is set).
//   R224.M5.2  `_ls_push_letrec_group` batch mutual-recursion push.
//   R224.M5.3  `_ll_parse` splice-points for `let` / `let rec`.
//   R224.M5.4  Compacting pop that reclaims the slot.
//   R224.M5.5  12-test proptest corpus + fingerprint goldens
//              (`tests/proptest_let_scope.pdx`); the design doc §7
//              enumerates the 12 cases so a late-landing test
//              harness can golden them from the spec.
//
// =============================================================================
// Upstream: paideia-os#2679 (THIS ticket, R224.M5). Design doc:
// design/shell/let-in-scoping.md. Related plans:
// design/terminal/semantic-shell-language-plan.md section R224.M5,
// design/shell/hm-algorithm-w-core.md (R225.M1 scheme-storage
// substrate), design/shell/lambda-literal-grammar.md (R224.M1
// grammar driver that will splice at M5.3), design/shell/type-env-
// threading.md (R229.M3 TypeEnv scheme-store substrate for M5.1).

module LetScope = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax, low 32 bits for packed)
  // ==========================================================================
  //
  // Band 0x4600..0x46FF, carved on a kilo-step boundary past the
  // Wave-121 bands (R221.M4 CtxLexer 0x4200..0x42FF; R224.M4 CapRow
  // 0x4300..0x43FF) and past the Wave-122 parallel-arm bands
  // (R221.M5 unified-AST 0x4400..0x44FF; R222.M5 registry-client
  // 0x4500..0x45FF). Slots 0x4605..0x46FF reserved for M5.1+
  // follow-ups.
  //
  // Diagnostic-family mapping (E0830 family per the issue brief):
  //   E0830_NAME_NOT_FOUND  -> LS_ERR_NOT_FOUND     (0x4601)
  //   E0831_BAD_FRAME       -> LS_ERR_BAD_FRAME     (0x4602)
  //   E0832_BAD_NAME        -> LS_ERR_BAD_NAME      (0x4603)
  //   E0833_POOL_FULL       -> LS_ERR_POOL_FULL     (0x4600)
  //   E0834_BAD_KIND        -> LS_ERR_BAD_KIND      (0x4604)

  pub let LS_OK                       : u64 = 0
  pub let LS_ERR_POOL_FULL            : u64 = 0x4600
  pub let LS_ERR_NOT_FOUND            : u64 = 0x4601
  pub let LS_ERR_BAD_FRAME            : u64 = 0x4602
  pub let LS_ERR_BAD_NAME             : u64 = 0x4603
  pub let LS_ERR_BAD_KIND             : u64 = 0x4604

  // ==========================================================================
  // SECTION 2 -- KIND + LAYOUT CONSTANTS
  // ==========================================================================

  pub let LS_SCOPE_LET                : u64 = 1
  pub let LS_SCOPE_LETREC             : u64 = 2
  pub let LS_SCOPE_LAMBDA             : u64 = 3

  pub let LS_FRAME_SLOTS              : u64 = 128
  pub let LS_FRAME_STRIDE             : u64 = 32
  pub let LS_FRAME_POOL_BYTES         : u64 = 4096  // 128 * 32
  pub let LS_NAME_MAX                 : u64 = 16

  pub let LS_OFF_KIND                 : u64 = 0
  pub let LS_OFF_FLAGS                : u64 = 2
  pub let LS_OFF_PARENT               : u64 = 4
  pub let LS_OFF_NAME                 : u64 = 8
  pub let LS_OFF_NAME_LEN             : u64 = 24
  pub let LS_OFF_RESERVED_1           : u64 = 25
  pub let LS_OFF_RESERVED_2           : u64 = 26
  pub let LS_OFF_SCHEME_REF           : u64 = 28

  // ==========================================================================
  // SECTION 3 -- STATIC STATE
  // ==========================================================================
  //
  // `_ls_frame_pool` is .bss-zero at program load, which naturally
  // encodes the "slot 0 unused, every other slot `kind == 0`" shape.
  // `_ls_frame_next` is .bss-zero at program load; `_ls_init` on
  // first call sets it to 1 (reserve slot 0 as null-sentinel).

  pub let mut _ls_frame_pool          : [u8; 4096] = uninit @align(8)
  pub let mut _ls_frame_next          : u64        = uninit @align(8)

  // ==========================================================================
  // _ls_init() -> ()
  //
  //   Idempotent boot. On a cold .bss (_ls_frame_next == 0), reserve
  //   slot 0 by setting _ls_frame_next := 1. The .bss zero-init at
  //   program load has already zero-filled _ls_frame_pool, which is
  //   the "zero-fill pool" behaviour the brief asks for; this init
  //   routine's job is only to allocate the null-sentinel and record
  //   that the pool is now live. On a warm pool (_ls_frame_next != 0),
  //   short-circuit.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ls_ini_.
  // ==========================================================================
  pub let _ls_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_init reserves slot 0 of _ls_frame_pool as the null-sentinel by setting _ls_frame_next := 1 on a cold .bss. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Idempotency: load _ls_frame_next via `lea r11,[rip+_ls_frame_next]; mov rax,[r11]`; if rax != 0 return. Else write 1 to _ls_frame_next via `mov rax,1; lea r11,[rip+_ls_frame_next]; mov [r11],rax`. .bss zero-init at program load has already zero-filled _ls_frame_pool, so no explicit per-byte zero-fill is needed; the brief's `zero-fill pool` wording is satisfied by that program-load behaviour plus the sentinel allocation. All cmp immediates (0) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ls_ini_.",
      block: {
        // Idempotency check.
        lea r11, [rip + _ls_frame_next];
        mov rax, [r11];
        cmp rax, 0;
        jne ls_ini_fast_done;

        // Reserve slot 0 by setting next := 1.
        mov rax, 1;
        lea r11, [rip + _ls_frame_next];
        mov [r11], rax;

      ls_ini_fast_done:
        ret;
      }
    }

  // ==========================================================================
  // _ls_push_impl(parent, name_ptr, name_len, type_scheme_ref, kind)
  //   -> frame_ref
  //
  //   rdi = parent              (u32 value in low 32; 0 = top-level)
  //   rsi = name_ptr            (caller-supplied name bytes)
  //   rdx = name_len            (1..16)
  //   rcx = type_scheme_ref     (u32 payload)
  //   r8  = kind                (1 = LET, 2 = LETREC, 3 = LAMBDA)
  //   rax = frame_ref           (>= 1 on success, 0 on error)
  //
  //   Validate name_len in [1..16] and kind in [1..3], check pool has
  //   room (_ls_frame_next < 128), allocate at slot `_ls_frame_next`,
  //   write the 32-byte header, bump _ls_frame_next, return the pre-
  //   increment slot index.
  //
  //   Internal helper. The three public push wrappers below each set
  //   r8 to a literal kind and CALL this function. Exposed as `pub`
  //   only because paideia-as object-visibility granularity is per-
  //   symbol; downstream callers should use the three named entries.
  //
  // 5 callee-save pushes (rbx=parent, r12=name_ptr, r13=name_len,
  // r14=type_scheme_ref, r15=kind) = 40 B frame; entry rsp%16==8,
  // after 5 pushes rsp%16==0 (odd count aligns at the single nested
  // CALL to _ls_init). Labels prefixed ls_pi_.
  // ==========================================================================
  pub let _ls_push_impl : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (name_ptr: u64) (name_len: u64) (type_scheme_ref: u64) (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_push_impl allocates a 32-byte frame at &_ls_frame_pool + _ls_frame_next*32, writes the header, and bumps _ls_frame_next. 5 callee-save pushes (rbx=parent, r12=name_ptr, r13=name_len, r14=type_scheme_ref, r15=kind) = 40 B frame; entry rsp%16==8, after 5 pushes rsp%16==0 at the one nested CALL to _ls_init (idempotent leaf; Wave 120 lazy-init lesson). Flow: stash rdi/rsi/rdx/rcx/r8 into rbx/r12/r13/r14/r15 before the init call (SysV caller-save -- defensive even though _ls_init only touches rax/r11). Validate name_len: cmp r13,0 je fail; cmp r13,16 ja fail. Validate kind: cmp r15,1 jb fail; cmp r15,3 ja fail. Load _ls_frame_next into r10 via lea+mov; cmp r10,128 jae fail. frame_addr = &_ls_frame_pool + r10*32 computed as r9 = r10; shl r9,5; lea r11,[rip+_ls_frame_pool]; add r9,r11. Write kind u16 at r9+0 (low byte from r15, high byte zero) via two mov_b stores. Write flags u16 at r9+2 (both bytes zero). Write parent u32 at r9+4 via mov rax,rbx; mov_d [r9+4],rax. Write name bytes [r9+8..r9+8+name_len) via copy loop (r8=r9+8 base; rcx=j; mov_b rax,[r12+rcx*1]; mov r11,r8; add r11,rcx; mov_b [r11+0],rax; rcx+=1 until rcx==r13). Zero-pad [r9+8+name_len..r9+8+16) via same staging-register pattern. Write name_len u8 at r9+24. Zero reserved bytes +25/+26/+27. Write type_scheme_ref u32 at r9+28 via mov rax,r14; mov_d [r9+28],rax. Bump _ls_frame_next := r10 + 1 via mov rax,r10; add rax,1; lea r11,[rip+_ls_frame_next]; mov [r11],rax. Return rax := r10 (pre-increment slot idx). All cmp immediates (0, 1, 3, 16, 128) fit imm32 with bit 31 clear. Byte loads via mov_b with explicit *1 scale on reg+reg. Byte stores via staging register for reg+reg forms; [reg+imm_disp] for reg+disp. u32 stores via mov_d [reg+imm_disp]. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ls_pi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // parent
        mov r12, rsi;                          // name_ptr
        mov r13, rdx;                          // name_len
        mov r14, rcx;                          // type_scheme_ref
        mov r15, r8;                           // kind

        // Lazy-init (Wave 120 lesson).
        call _ls_init;

        // Validate name_len in [1..16].
        cmp r13, 0;
        je  ls_pi_bad_name;
        cmp r13, 16;                           // LS_NAME_MAX
        ja  ls_pi_bad_name;

        // Validate kind in [1..3].
        cmp r15, 1;
        jb  ls_pi_bad_kind;
        cmp r15, 3;
        ja  ls_pi_bad_kind;

        // Load _ls_frame_next; validate < 128.
        lea r11, [rip + _ls_frame_next];
        mov r10, [r11];
        cmp r10, 128;                          // LS_FRAME_SLOTS
        jae ls_pi_pool_full;

        // frame_addr = &_ls_frame_pool + r10 * 32.
        mov r9, r10;
        shl r9, 5;
        lea r11, [rip + _ls_frame_pool];
        add r9, r11;

        // Write kind u16 at +0 (low byte = kind, high byte = 0).
        mov rax, r15;
        mov_b [r9 + 0], rax;
        xor rax, rax;
        mov_b [r9 + 1], rax;

        // Write flags u16 at +2 (both bytes 0).
        xor rax, rax;
        mov_b [r9 + 2], rax;
        mov_b [r9 + 3], rax;

        // Write parent u32 at +4.
        mov rax, rbx;
        mov_d [r9 + 4], rax;

        // Write name bytes at +8..+8+name_len, zero-pad to +24.
        //   r8 = &name_dst_base = r9 + 8
        //   rcx = j (loop counter)
        mov r8, r9;
        add r8, 8;
        xor rcx, rcx;

      ls_pi_name_copy_loop:
        cmp rcx, r13;
        jae ls_pi_name_pad_init;

        xor rax, rax;
        mov_b rax, [r12 + rcx * 1];            // src byte
        mov r11, r8;
        add r11, rcx;
        mov_b [r11 + 0], rax;                  // dst byte

        add rcx, 1;
        jmp ls_pi_name_copy_loop;

      ls_pi_name_pad_init:
        xor rax, rax;

      ls_pi_name_pad_loop:
        cmp rcx, 16;                           // LS_NAME_MAX
        jae ls_pi_name_pad_fin;
        mov r11, r8;
        add r11, rcx;
        mov_b [r11 + 0], rax;
        add rcx, 1;
        jmp ls_pi_name_pad_loop;

      ls_pi_name_pad_fin:
        // Write name_len u8 at +24.
        mov rax, r13;
        mov_b [r9 + 24], rax;

        // Zero reserved bytes +25, +26, +27.
        xor rax, rax;
        mov_b [r9 + 25], rax;
        mov_b [r9 + 26], rax;
        mov_b [r9 + 27], rax;

        // Write type_scheme_ref u32 at +28.
        mov rax, r14;
        mov_d [r9 + 28], rax;

        // Bump _ls_frame_next := r10 + 1 (pre-increment was r10).
        mov rax, r10;
        add rax, 1;
        lea r11, [rip + _ls_frame_next];
        mov [r11], rax;

        // Return rax := r10 (pre-increment slot = allocated frame_ref).
        mov rax, r10;
        jmp ls_pi_epilogue;

      ls_pi_bad_name:
        xor rax, rax;
        jmp ls_pi_epilogue;

      ls_pi_bad_kind:
        xor rax, rax;
        jmp ls_pi_epilogue;

      ls_pi_pool_full:
        xor rax, rax;
        jmp ls_pi_epilogue;

      ls_pi_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _ls_push_let(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
  //
  //   Thin wrapper: set r8 := 1 (SCOPE_LET), CALL _ls_push_impl.
  //
  // Entry rsp%16==8; `sub rsp, 8` brings rsp%16==0 at the nested CALL
  // to _ls_push_impl. Labels prefixed ls_pl_.
  // ==========================================================================
  pub let _ls_push_let : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (name_ptr: u64) (name_len: u64) (type_scheme_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_push_let is a thin wrapper that sets r8=1 (SCOPE_LET) and CALLs _ls_push_impl. sub rsp,8 pad; entry rsp%16==8, after sub rsp%16==0 at the nested CALL (correct SysV alignment). On return rax carries the frame_ref from _ls_push_impl; add rsp,8 restores. No pushes needed because no local state spans the CALL. All cmp immediates (none here) are trivially imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ls_pl_.",
      block: {
        sub rsp, 8;
        mov r8, 1;                             // LS_SCOPE_LET
        call _ls_push_impl;
        add rsp, 8;
        ret;
      }
    }

  // ==========================================================================
  // _ls_push_letrec(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
  //
  //   Thin wrapper: set r8 := 2 (SCOPE_LETREC), CALL _ls_push_impl.
  //   Labels prefixed ls_plr_.
  // ==========================================================================
  pub let _ls_push_letrec : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (name_ptr: u64) (name_len: u64) (type_scheme_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_push_letrec is a thin wrapper that sets r8=2 (SCOPE_LETREC) and CALLs _ls_push_impl. Alignment and shape identical to _ls_push_let (sub rsp,8 for SysV alignment at the nested CALL). Labels prefixed ls_plr_.",
      block: {
        sub rsp, 8;
        mov r8, 2;                             // LS_SCOPE_LETREC
        call _ls_push_impl;
        add rsp, 8;
        ret;
      }
    }

  // ==========================================================================
  // _ls_push_lambda(parent, name_ptr, name_len, type_scheme_ref) -> frame_ref
  //
  //   Thin wrapper: set r8 := 3 (SCOPE_LAMBDA), CALL _ls_push_impl.
  //   Labels prefixed ls_pla_.
  // ==========================================================================
  pub let _ls_push_lambda : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (name_ptr: u64) (name_len: u64) (type_scheme_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_push_lambda is a thin wrapper that sets r8=3 (SCOPE_LAMBDA) and CALLs _ls_push_impl. Alignment and shape identical to _ls_push_let. Labels prefixed ls_pla_.",
      block: {
        sub rsp, 8;
        mov r8, 3;                             // LS_SCOPE_LAMBDA
        call _ls_push_impl;
        add rsp, 8;
        ret;
      }
    }

  // ==========================================================================
  // _ls_resolve(frame_ref, name_ptr, name_len) -> packed_u64
  //
  //   rdi = frame_ref      (starting cursor; 0 = top-level, no match)
  //   rsi = name_ptr
  //   rdx = name_len       (1..16)
  //   rax = packed_u64:
  //           low 32:  LS_OK (0) or LS_ERR_* (0x4601..0x4603)
  //           high 32: on LS_OK, the matched frame's type_scheme_ref;
  //                    else 0.
  //
  //   Walk the parent chain inner-first: at each frame, compare
  //   name_len then byte-wise content; on exact match return the
  //   stored type_scheme_ref packed with LS_OK; else follow
  //   parent_frame_ref. If cursor reaches 0 without a match, return
  //   LS_ERR_NOT_FOUND. If cursor >= 128 or kind == 0 mid-walk,
  //   return LS_ERR_BAD_FRAME.
  //
  //   Shadowing is naturally supported: the innermost binding wins
  //   because the walk visits inner frames first and returns on the
  //   first byte-level name match.
  //
  // 3 callee-save pushes (rbx=cursor, r12=name_ptr, r13=name_len) =
  // 24 B frame; entry rsp%16==8, after 3 pushes rsp%16==0 at the one
  // nested CALL to _ls_init (Wave 120 lesson). Labels prefixed ls_r_.
  // ==========================================================================
  pub let _ls_resolve : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (frame_ref: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_resolve walks the parent chain starting at frame_ref inner-first, comparing name_len then bytes. 3 callee-save pushes (rbx=cursor, r12=name_ptr, r13=name_len) = 24 B frame; entry rsp%16==8, after 3 pushes rsp%16==0 at the one nested CALL to _ls_init (Wave 120 lazy-init lesson). Flow: stash args; call _ls_init; validate name_len in [1..16] else return LS_ERR_BAD_NAME. Loop: if rbx==0 return (0<<32)|LS_ERR_NOT_FOUND; if rbx>=128 return (0<<32)|LS_ERR_BAD_FRAME; frame_addr = &_ls_frame_pool + rbx*32 (shl 5 + lea+add); read kind u16 at +0 via `xor rcx,rcx; mov_b rcx,[addr+0]` then OR with high byte at +1 shifted by 8 (defensive; kind always fits in low byte at M5 so hi byte read is a nice-to-have); if kind==0 return BAD_FRAME. Read this_name_len u8 at +24; cmp with r13; if != skip to parent. Byte-compare bytes [name_dst=addr+8, name_dst+r13) with [r12, r12+r13); any mismatch skip to parent. On full match read type_scheme_ref u32 at +28 into rax; shl rax,32; return rax | LS_OK (0, so no OR needed). Skip-to-parent: read parent u32 at +4 into cursor; continue. All cmp immediates (0, 16, 128, status codes 0x4601..0x4603) fit imm32 with bit 31 clear. Byte loads via `mov_b r,[base+idx*1]`; u32 loads via mov_d. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ls_r_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                          // cursor
        mov r12, rsi;                          // name_ptr
        mov r13, rdx;                          // name_len

        // Lazy-init (Wave 120 lesson).
        call _ls_init;

        // Validate name_len in [1..16].
        cmp r13, 0;
        je  ls_r_bad_name;
        cmp r13, 16;                           // LS_NAME_MAX
        ja  ls_r_bad_name;

      ls_r_walk:
        // Chain-end check.
        cmp rbx, 0;
        je  ls_r_not_found;

        // Range check (defensive; mid-walk corruption would be a
        // caller bug, but a bare BAD_FRAME is friendlier than a
        // segfault).
        cmp rbx, 128;                          // LS_FRAME_SLOTS
        jae ls_r_bad_frame;

        // frame_addr = &_ls_frame_pool + rbx * 32 (into r9).
        mov r9, rbx;
        shl r9, 5;
        lea r11, [rip + _ls_frame_pool];
        add r9, r11;

        // Read kind u16 at +0; if kind == 0 BAD_FRAME.
        xor rcx, rcx;
        mov_b rcx, [r9 + 0];
        xor rax, rax;
        mov_b rax, [r9 + 1];
        shl rax, 8;
        or  rcx, rax;                          // full u16 kind
        cmp rcx, 0;
        je  ls_r_bad_frame;

        // Read this_name_len u8 at +24; if != r13 skip to parent.
        xor rax, rax;
        mov_b rax, [r9 + 24];
        cmp rax, r13;
        jne ls_r_next;

        // Byte-compare name_inline[0..r13) against name_ptr[0..r13).
        // Base of name_inline = r9 + 8 in r8; j in rcx.
        mov r8, r9;
        add r8, 8;
        xor rcx, rcx;

      ls_r_byte_loop:
        cmp rcx, r13;
        jae ls_r_match;

        xor rax, rax;
        mov_b rax, [r8 + rcx * 1];             // slot byte
        xor rdx, rdx;
        mov_b rdx, [r12 + rcx * 1];            // caller byte
        cmp rax, rdx;
        jne ls_r_next;

        add rcx, 1;
        jmp ls_r_byte_loop;

      ls_r_match:
        // Read type_scheme_ref u32 at +28 and return packed with LS_OK.
        xor rax, rax;
        mov_d rax, [r9 + 28];
        shl rax, 32;                           // (ref << 32) | LS_OK (0)
        jmp ls_r_epilogue;

      ls_r_next:
        // cursor := parent u32 at +4.
        xor rax, rax;
        mov_d rax, [r9 + 4];
        mov rbx, rax;
        jmp ls_r_walk;

      ls_r_not_found:
        mov rax, 0x4601;                       // LS_ERR_NOT_FOUND
        jmp ls_r_epilogue;

      ls_r_bad_frame:
        mov rax, 0x4602;                       // LS_ERR_BAD_FRAME
        jmp ls_r_epilogue;

      ls_r_bad_name:
        mov rax, 0x4603;                       // LS_ERR_BAD_NAME
        jmp ls_r_epilogue;

      ls_r_epilogue:
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _ls_pop(frame_ref) -> parent_frame_ref
  //
  //   rdi = frame_ref
  //   rax = parent_frame_ref  (0 on frame_ref == 0 or frame_ref >= 128;
  //                            otherwise the stored u32 parent)
  //
  //   Pure-leaf read-only accessor. Does NOT reclaim the slot; the
  //   pool is append-only within a parse pass. A caller that wants
  //   to reset the pool across parses sets _ls_frame_next := 0 and
  //   calls _ls_init (which re-reserves slot 0).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ls_po_.
  // ==========================================================================
  pub let _ls_pop : (u64) -> u64 !{mem} @{} =
    fn (frame_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M5 (#2679): _ls_pop reads the stored parent_frame_ref u32 at &_ls_frame_pool + frame_ref*32 + 4 and returns it in rax. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL (safe to skip _ls_init: a never-pushed pool has every parent u32 as .bss zero, which equals the correct 'top-level' sentinel). Flow: cmp rdi,0 je zero; cmp rdi,128 jae zero; r9 = rdi; shl r9,5; lea r11,[rip+_ls_frame_pool]; add r9,r11; xor rax,rax; mov_d rax,[r9+4]; ret. All cmp immediates (0, 128) fit imm32 with bit 31 clear. u32 load via mov_d [reg+imm_disp]. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ls_po_.",
      block: {
        cmp rdi, 0;
        je  ls_po_zero;
        cmp rdi, 128;                          // LS_FRAME_SLOTS
        jae ls_po_zero;

        mov r9, rdi;
        shl r9, 5;
        lea r11, [rip + _ls_frame_pool];
        add r9, r11;

        xor rax, rax;
        mov_d rax, [r9 + 4];
        ret;

      ls_po_zero:
        xor rax, rax;
        ret;
      }
    }

}
