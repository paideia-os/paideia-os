// src/closure_capture.pdx -- libpdx-pds-parser.R224.M2 (paideia-os#2676)
//
// ClosureCapture: parser-tier primitive for the paideia-shell lambda
// closure-capture list grammar (`[a, b:u64, c:path]`). R224.M2 of
// the lambda-lang umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R224 is the lambda-lang umbrella (per
// design/terminal/semantic-shell-language-plan.md section "R224 --
// Lambda surface"). R224.M1 (`src/lambda_lit.pdx`, Wave 114) landed
// the lambda-literal header parser: it recognises `\x:u64 -> body`
// and `\(x:u64, y:u64) -> body` and emits a flat LambdaHeader + Param
// array image.
//
// R224.M2 (THIS module) adds the CLOSURE-CAPTURE LIST: the OPTIONAL
// `[binding, binding, ...]` section that follows the backslash and
// precedes the parameter list. Its presence is the user's explicit
// opt-in to CROSS-PROCESS SERIALIZATION of the lambda (Q13 in
// `design/01-foundational-decisions.md`): in-process lambdas capture
// pipeline-scope bindings BY REFERENCE automatically (the HM pass at
// R225.M1+ walks the body and threads free variables through the
// enclosing environment); crossing a process boundary requires the
// bindings to serialize, which the explicit list enumerates.
//
//     // In-process lambda -- no capture list. The free variable `n`
//     // is captured by reference from the enclosing pipeline scope.
//     map \x:u64 -> x + n
//
//     // Cross-process lambda -- explicit capture list. The runtime
//     // marshals each listed binding into the serialized closure
//     // payload before the lambda flows across a process boundary.
//     @remote reduce \[acc, item:u64] (a:u64, b:u64) -> acc + a + b
//
// Within the explicit list each binding is one of two forms:
//
//     name              -- CAPTURE-BY-REFERENCE (mode = CC_MODE_BY_REF).
//                          The receiver resolves `name` against ITS
//                          own session-local scope by that name. The
//                          wire payload carries the name only, not a
//                          value. Only sound when the receiver is
//                          known to hold a bound value under that
//                          name (session-registered binding, broadcast
//                          session, etc.); the type checker enforces
//                          this at R225.M5.
//
//     name : type_name  -- CAPTURE-BY-VALUE (mode = CC_MODE_BY_VALUE).
//                          The sender serializes the current value of
//                          the binding on the sender side using the
//                          declared type_name, and the receiver
//                          deserialises into a FRESH, SESSION-LOCAL
//                          binding of that name. Values flow across
//                          the trust boundary; the type_name mirrors
//                          R222.M1 SchemasSig / R224.M1 LambdaLit
//                          type codes (u64, i64, str, hex, hash32,
//                          tsc, path, pid).
//
// R224.M2 is deliberately the PARSER tier: it emits the capture-list
// descriptor array that downstream milestones consume -- R224.M3
// effect-row inference reads the by-value / by-reference partition to
// stamp an effect-row seed; R224.M4 capability-row typing reads it to
// stamp a cap-row seed; R224.M6 first-class-pipeline-value runtime
// uses the by-value entries to drive serialization; R225.M5 cross-
// context type flow uses the by-reference entries to drive
// session-scope lookup.
//
// Grammar interaction with R224.M1 lambda_lit:
//
//   The capture list appears BETWEEN the `\` and the ParamList:
//
//       Lambda := WS* "\" WS* CaptureList? WS* ParamList WS* "->" Expr
//       CaptureList := "[" WS* BindingList? WS* "]"
//       BindingList := Binding (WS* "," WS* Binding)*
//       Binding     := identifier (WS* ":" WS* type_name)?
//
//   R224.M1's _ll_parse currently REJECTS a `[` after the backslash
//   (its SingleParam / MultiParam dispatch does not know about `[`).
//   The R224.M2+ integration pass (not landed at this M2; filed as
//   R224.M2.5 follow-up) will insert a CaptureList dispatch step
//   between the backslash-consume and the ParamList dispatch. Until
//   that pass lands, _cc_parse operates STANDALONE: a caller that has
//   located a `[...]` byte range (via its own byte-walker, or via a
//   future R224.M2.5 integration) hands those bytes to _cc_parse,
//   which emits the CC image.
//
//   Standalone call shape -- the input bytes point AT (or AT whitespace
//   PRECEDING) the opening `[` and extend AT LEAST through the matching
//   `]`. Any trailing bytes past the `]` are preserved (bytes_written
//   does not include them); the caller observes the consumed byte
//   count via the top 32 bits of the packed return.
//
// Out of scope at M2 (deferred):
//   * Integration pass inserting the CaptureList into _ll_parse
//     (R224.M2.5, same umbrella).
//   * Mixed-mode validation (a binding declared BY_REF in one lambda
//     and BY_VALUE in a sibling must not alias) -- R224.M3+.
//   * Capture-list for let-rec recursive capture (R224.M5).
//   * Linear/affine propagation across capture (R224.M7, Walker 2005).
//   * Nested-capture (a capture list that itself holds a lambda) --
//     the parser accepts the identifier but the HM pass at R225.M1+
//     will type-check the nested shape.
//
// =============================================================================
// GRAMMAR
// =============================================================================
//
//     CaptureList := WS* "[" WS* BindingList? WS* "]"
//     BindingList := Binding (WS* "," WS* Binding)*
//     Binding     := identifier (WS* ":" WS* type_name)?
//     identifier  := [A-Za-z_] [A-Za-z0-9_]*          (len 1..14)
//     type_name   := one of  u64 | i64 | str | hex | hash32 | tsc
//                          | path | pid
//     WS          := 0x20 | 0x09 | 0x0A | 0x0D
//
// An empty list `[]` is legal (zero bindings; the HAS_EMPTY flag bit
// is set in the emitted header). A list containing only whitespace
// `[   ]` is the same shape.
//
// =============================================================================
// TYPE SET
// =============================================================================
//
// The type codes mirror R222.M1 SchemasSig SS_TYPE_* and R224.M1
// LambdaLit LL_TYPE_* byte-for-byte so the three parsers share a
// dispatch byte that the R225.M1 HmCore bridge can read directly:
//
//     u64     -> CC_TYPE_U64    = 1
//     i64     -> CC_TYPE_I64    = 2
//     str     -> CC_TYPE_STR    = 3
//     hex     -> CC_TYPE_HEX    = 4
//     hash32  -> CC_TYPE_HASH32 = 5
//     tsc     -> CC_TYPE_TSC    = 6
//     path    -> CC_TYPE_PATH   = 8
//     pid     -> CC_TYPE_PID    = 9
//
// Type code 7 is reserved (matches R222.M1 SF_TYPE_IMAGE reservation).
// Type code 0 is used in a Binding descriptor to signify "untyped"
// (BY_REF capture); it is NOT a valid type_name parse result.
//
// =============================================================================
// RECORD LAYOUT
// =============================================================================
//
// Output buffer layout after a successful parse:
//
//     [+0  .. +32]              ClosureCaptureHeader (32 B)
//     [+32 .. +32 + n*32)       Binding[0..n]  (32 B each)
//
// bytes_written = 32 + n_bindings * 32. The reader walks header first,
// then the array; a self-contained image, no indirection into caller
// buffers past the end of the write.
//
// ClosureCaptureHeader (32 B):
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic              u32 = CC_HEADER_MAGIC ('CCAP'
//                                        little-endian = 0x50414343)
//     4      2   n_bindings         u16  0..CC_MAX_BINDINGS (= 16)
//     6      2   flags              u16  bit 0 = HAS_BY_VALUE (set iff
//                                        at least one Binding has
//                                        mode = BY_VALUE); bit 1 =
//                                        IS_EMPTY (set iff n_bindings
//                                        == 0); bits 2..15 reserved.
//     8      4   bindings_offset    u32  byte offset within out buffer
//                                        where the Binding array
//                                        begins (= 32)
//    12      4   bindings_len       u32  byte length of the Binding
//                                        array (= n_bindings * 32)
//    16     16   reserved[16]       u8   zeroed; reserved for M3+
//                                        (effect-row seed id, cap-row
//                                        seed id, source span, etc.)
//
//   total: 32 B (CC_HEADER_BYTES)
//
// Binding descriptor (32 B each):
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      1   type_code          u8   0 (untyped/BY_REF) or
//                                        CC_TYPE_* (1..9, 7 reserved)
//                                        for BY_VALUE.
//     1      1   name_len           u8   1..CC_NAME_MAX (= 14)
//    2     14   name_inline[14]    u8    ASCII identifier, zero-padded
//                                        past name_len.
//    16      1   mode               u8   CC_MODE_BY_REF (0) or
//                                        CC_MODE_BY_VALUE (1). Derived
//                                        from the presence (or absence)
//                                        of the `: type_name` suffix.
//    17     15   reserved[15]       u8   zeroed; reserved for M3+
//                                        (per-binding effect-flag,
//                                        linear/affine marker, source
//                                        span, etc.)
//
//   total: 32 B (CC_BINDING_BYTES)
//
// Stride 32 is a power of two so binding addressing uses `shl rN, 5`
// -- never 2-op `imul r, imm` (per feedback_pdx_encoder_pitfalls). The
// 14-byte inline name mirrors R224.M1 LambdaLit's Param name_inline
// so a downstream pass that computes `name_eq(param, capture)` reads
// the two 14-byte spans directly without a widen.
//
// The 32-byte Binding stride parallels R224.M1 Param stride byte-for-
// byte: both carry a type_code at +0, name_len at +1, name_inline at
// +2..+16, and 16 bytes of M3+ scratch at +16..+32. The ONE position
// that differs is the +16 slot -- Param reserves it for M3+ default-
// value pointer; Binding uses byte +16 for the capture mode flag and
// reserves bytes +17..+32 for M3+ seed data.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _cc_parse(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
//     Parses a `[binding, binding, ...]` capture list starting at (or
//     at whitespace preceding) the opening `[`. On success, writes a
//     ClosureCaptureHeader (32 B) at out_ptr followed by n_bindings
//     Binding descriptors (32 B each). Returns a packed
//     `(bytes_written << 32) | status` u64; bytes_written is
//     meaningful only when status == CC_OK (on error, callers ignore
//     the top 32 bits).
//
//     Status one of:
//        CC_OK                     = 0
//        CC_ERR_SYNTAX             = 0x3500  bad grammar at ident,
//                                            ':', ',', or trailing byte
//        CC_ERR_TOO_MANY_BINDINGS  = 0x3501  n_bindings > CC_MAX_BINDINGS
//                                            (= 16)
//        CC_ERR_UNKNOWN_TYPE       = 0x3502  type_name not in the M2
//                                            set
//        CC_ERR_OUT_TOO_SMALL      = 0x3503  out_cap < 32 + n_bindings
//                                            * 32
//        CC_ERR_NO_OPEN            = 0x3504  first non-whitespace
//                                            byte was not `[`
//        CC_ERR_NO_CLOSE           = 0x3505  EOI before matching `]`
//
//   Register map (SysV):
//
//     _cc_parse(rdi, rsi, rdx, rcx) -> rax
//         rdi = bytes_ptr
//         rsi = bytes_len
//         rdx = out_ptr
//         rcx = out_cap
//         rax = (bytes_written << 32) | status
//
//   Internal cross-function helpers (not re-exported past the M2
//   ABI; signatures frozen now so M3+ can reuse them):
//
//     _cc_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
//     _cc_classify_type(ident_ptr, ident_len)  -> type_code
//     _cc_parse_binding(bytes_ptr, bytes_len, cursor_in,
//                       write_ptr) -> (new_cursor << 32) | status
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R221.M1 (UTF-8/NFC)  --  the caller is expected to have already
//     run the input bytes through _u8n_decode_and_normalize. Grammar
//     accepts only ASCII identifiers, ASCII punctuation (`[`, `]`,
//     `,`, `:`, WS), so non-ASCII bytes inside an identifier fall
//     through to CC_ERR_SYNTAX via the ident byte-class check.
//
//   R222.M1 (SchemasSig)  --  type codes CC_TYPE_* mirror SS_TYPE_*
//     exactly. The two modules do NOT share code (SchemasSig carries
//     `_sch_sig_classify_type`; this module carries
//     `_cc_classify_type`); the duplication keeps the modules
//     link-order-independent.
//
//   R223.M1 (Pipeline)  --  a lambda with a capture list that appears
//     as a pipeline-stage argv word is parsed FIRST by Pipeline (which
//     emits one span per `|`-delimited stage), then by R224.M1
//     LambdaLit (which recognises the backslash prefix), then
//     (post-R224.M2.5 integration) by THIS module via a nested call
//     from LambdaLit. The three parsers share no cursor; they operate
//     on the same NFC-normalised input at different depth plies.
//
//   R224.M1 (LambdaLit)  --  the integration pass R224.M2.5 (filed as
//     an umbrella follow-up, not landed at THIS M2) will insert a
//     call to _cc_parse between the backslash-consume and the ParamList
//     dispatch inside _ll_parse. The caller supplies the input span
//     starting at the first byte after the backslash and the write
//     offset at (out_ptr + LL_HEADER_BYTES) so the CC image lands
//     BEFORE the LambdaHeader on the output. The combined output
//     layout at R224.M2.5 will be
//     (CC image + LambdaHeader + Param array + body bytes); the
//     LambdaHeader's reserved tail gains a new slot pointing at the
//     CC image offset (reserved[0..4] = cc_offset u32).
//
//   R224.M3 (effect-row inference)  --  reads n_bindings and
//     per-binding mode. A BY_VALUE binding contributes a serialization
//     effect to the lambda's inferred row; a BY_REF binding contributes
//     an environment-lookup effect.
//
//   R224.M4 (capability-row typing)  --  reads the by-value partition
//     to require the sender's cap-row holds the "serialize-of-type-X"
//     capability for each listed type, and the by-reference partition
//     to require the receiver's cap-row holds "resolve-by-name".
//
//   R224.M6 (lambda through pipeline)  --  the by-value Binding
//     descriptors drive the serializer at the host/trust boundary:
//     each descriptor's type_code + name selects a type-specific
//     marshal routine from the R223.M5 wire-format sink.
//
//   R225.M5 (cross-context type flow)  --  the BY_REF partition
//     induces a lookup against the receiver's session-scope type
//     environment; a missing binding emits an E0710-family diagnostic.
//     The BY_VALUE partition induces fresh type environment entries at
//     the receiver side using the declared type_name.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32.
//   - No 2-op `imul r, imm` -- binding stride is `shl rN, 5` (* 32).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `ClosureCapture` matches `closure_capture.pdx`.
//   - Public symbols prefixed `_cc_*` (entry points).
//   - Internal labels prefixed `clo_*` (grep-confirmed free). The
//     `cc_*` prefix is NOT reused for internal labels because
//     `cc_*` collides with R133.M2 cap_check's internal labels
//     (cc_scan, cc_denied, etc.) at the grep level; labels are
//     function-local in paideia-as so there is no compile-time
//     collision, but keeping distinct prefixes keeps grep audits
//     clean. Public API still owns the `_cc_*` symbol namespace.
//   - All `cmp reg, imm` immediates <= 0x3505 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. No MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx]`
//     (zero-extends into the full qword); byte stores via
//     `mov_b [dst + disp], reg`, same shape as LambdaLit / SchemasSig.
//   - u16 stores via two `mov_b` byte writes (low, high).
//   - u32 stores via `mov_d [dst + disp], reg` (precedent: LambdaLit
//     body_offset write, Pipeline _pl_emit_word).
//   - u64 zero-fill of a fresh descriptor uses `xor rax, rax;
//     mov [dst + disp], rax` repeated.
//   - `_cc_skip_ws` and `_cc_classify_type` are pure leaves: no
//     callee-save push, no stack frame, no nested CALL.
//   - `_cc_parse_binding` has a 5 callee-save push + 16 B scratch
//     frame; rsp%16==0 at every nested CALL (entry 8, +40 pushes = 0,
//     +16 scratch = 0). r11 is caller-saved and never crosses a
//     nested CALL (Wave 116 register-liveness lesson). Values that
//     must survive a nested CALL live in rbx/rbp/r12/r13/r14 or on
//     the stack.
//   - `_cc_parse` has a 6 callee-save push + 24 B scratch frame; rsp
//     %16==0 at every nested CALL (entry 8, +48 pushes = 8, +24
//     scratch = 0). Matches LambdaLit _ll_parse's frame shape.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R224.M2.5  Integration: insert _cc_parse call into _ll_parse so
//              a lambda literal with a capture list parses in one
//              call. Same umbrella follow-up.
//   R224.M3    Effect-row inference: reads n_bindings + per-binding
//              mode to seat an effect-row seed.
//   R224.M4    Capability-row typing: reads the by-value partition to
//              require serialize-of-type-X capabilities on the sender.
//   R224.M5    Nested lambda + let-rec: capture-list unification with
//              let-rec recursive binding.
//   R224.M6    Lambda as first-class pipeline value: by-value Binding
//              descriptors drive the wire-format serializer.
//   R224.M7    Linear/affine interaction: Walker 2005 propagation --
//              a lambda capturing a linear value is itself linear.
//
// =============================================================================
// Upstream: paideia-os#2676 (THIS ticket, R224.M2). Substrate:
// paideia-os#2675 (R224.M1 LambdaLit), paideia-os#2651 (R221.M1
// UTF-8/NFC), paideia-os#2658 (R222.M1 SchemasSig for shared type
// codes). Design doc: design/shell/closure-capture.md.

module ClosureCapture = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================
  //
  // Error band 0x3500..0x35FF, reserved for the R224.M2 closure-capture
  // parser. Disjoint from every other error band in the libpdx-pds-parser
  // family:
  //   R221.M1 utf8_nfc           0x2700..0x27FF
  //   R222.M1 schemas_sig        0x2A00..0x2AFF
  //   R222.M2 command_sig        0x3300..0x33FF
  //   R223.M1 pipeline           0x2B00..0x2BFF
  //   R223.M2 record_projection  0x3400..0x34FF
  //   R224.M1 lambda_lit         0x2C00..0x2CFF
  //   R224.M2 closure_capture    0x3500..0x35FF   (THIS band)
  //   R225.M1 hm_core            0x2D00..0x2DFF
  //   R226.M1 datalog            0x2E00..0x2EFF
  //
  // Grep confirmation at R224.M2 landing time:
  //   grep -rE '0x350[0-5]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/closure-capture.md.

  pub let CC_OK                     : u64 = 0
  pub let CC_ERR_SYNTAX             : u64 = 0x3500
  pub let CC_ERR_TOO_MANY_BINDINGS  : u64 = 0x3501
  pub let CC_ERR_UNKNOWN_TYPE       : u64 = 0x3502
  pub let CC_ERR_OUT_TOO_SMALL      : u64 = 0x3503
  pub let CC_ERR_NO_OPEN            : u64 = 0x3504
  pub let CC_ERR_NO_CLOSE           : u64 = 0x3505

  // ==========================================================================
  // SECTION 2 -- TYPE CODES (one byte, written to Binding[+0])
  // ==========================================================================
  //
  // Codes 1..6 mirror R222.M1 SS_TYPE_* and R224.M1 LL_TYPE_* exactly.
  // Code 7 is skipped (R129.M4 SF_TYPE_IMAGE reservation). Codes 8..9
  // are the shared cmd-functor + lambda-param + capture-binding
  // extensions. CC_TYPE_UNTYPED (0) is a Binding-descriptor slot
  // sentinel for BY_REF; it is NOT a type_name parse result.
  // CC_UNKNOWN_TYPE (0xFF) is the _cc_classify_type miss sentinel; it
  // is NOT a valid Binding type_code.

  pub let CC_TYPE_UNTYPED           : u64 = 0
  pub let CC_TYPE_U64               : u64 = 1
  pub let CC_TYPE_I64               : u64 = 2
  pub let CC_TYPE_STR               : u64 = 3
  pub let CC_TYPE_HEX               : u64 = 4
  pub let CC_TYPE_HASH32            : u64 = 5
  pub let CC_TYPE_TSC               : u64 = 6
  pub let CC_TYPE_PATH              : u64 = 8
  pub let CC_TYPE_PID               : u64 = 9
  pub let CC_UNKNOWN_TYPE           : u64 = 0xFF

  // ==========================================================================
  // SECTION 3 -- CAPTURE MODE CODES (one byte, written to Binding[+16])
  // ==========================================================================

  pub let CC_MODE_BY_REF            : u64 = 0
  pub let CC_MODE_BY_VALUE          : u64 = 1

  // ==========================================================================
  // SECTION 4 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let CC_HEADER_BYTES           : u64 = 32
  pub let CC_BINDING_BYTES          : u64 = 32
  pub let CC_NAME_MAX               : u64 = 14
  pub let CC_MAX_BINDINGS           : u64 = 16
  pub let CC_HEADER_MAGIC           : u64 = 0x50414343

  // Header field offsets.
  pub let CC_OFF_MAGIC              : u64 = 0
  pub let CC_OFF_N_BINDINGS         : u64 = 4
  pub let CC_OFF_FLAGS              : u64 = 6
  pub let CC_OFF_BINDINGS_OFFSET    : u64 = 8
  pub let CC_OFF_BINDINGS_LEN       : u64 = 12
  pub let CC_OFF_RESERVED           : u64 = 16

  // Header flag bits.
  pub let CC_FLAG_HAS_BY_VALUE      : u64 = 0x01
  pub let CC_FLAG_IS_EMPTY          : u64 = 0x02

  // Binding descriptor field offsets.
  pub let CC_BIND_OFF_TYPE          : u64 = 0
  pub let CC_BIND_OFF_NAME_LEN      : u64 = 1
  pub let CC_BIND_OFF_NAME          : u64 = 2
  pub let CC_BIND_OFF_MODE          : u64 = 16
  pub let CC_BIND_OFF_RESERVED      : u64 = 17

  // ==========================================================================
  // _cc_skip_ws(bytes_ptr, bytes_len, cursor) -> new_cursor
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rax = cursor_out
  //
  // Walks the cursor forward past bytes in {0x20, 0x09, 0x0A, 0x0D}.
  // Returns the first index at which bytes_ptr[cursor] is NOT a
  // space-class byte, OR cursor == bytes_len (end-of-input stops the
  // walk).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed clo_sw_.
  // ==========================================================================
  pub let _cc_skip_ws : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M2 (#2676): skip ASCII whitespace. Pure leaf; zero pushes; no stack frame; no nested CALL. rax starts at the entry cursor and advances while [rdi + rax] is in the ASCII space-class set {0x20, 0x09, 0x0A, 0x0D}. End-of-input (rax == rsi) is a valid stop and returns the current cursor unchanged. All cmp immediates (0x20, 0x09, 0x0A, 0x0D) fit in imm32 with bit 31 clear. Byte load via `mov_b rcx, [rdi + rax]` zero-extends into the full qword so the subsequent cmp is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed clo_sw_. Byte-for-byte parallel to R224.M1 _ll_skip_ws, R222.M1 _sch_sig_skip_ws, R223.M2 _rp_skip_ws, R226.M1 _dl_skip_ws so the whitespace discipline is a shared property of the pds-lang family.",
      block: {
        mov rax, rdx;                          // cursor := cursor_in

      clo_sw_scan:
        cmp rax, rsi;
        jae clo_sw_stop;
        xor rcx, rcx;
        mov_b rcx, [rdi + rax];
        cmp rcx, 0x20;
        je  clo_sw_step;
        cmp rcx, 0x09;
        je  clo_sw_step;
        cmp rcx, 0x0A;
        je  clo_sw_step;
        cmp rcx, 0x0D;
        je  clo_sw_step;
        jmp clo_sw_stop;

      clo_sw_step:
        add rax, 1;
        jmp clo_sw_scan;

      clo_sw_stop:
        ret;
      }
    }

  // ==========================================================================
  // _cc_classify_type(ident_ptr, ident_len) -> type_code
  //
  //   rdi = ident_ptr
  //   rsi = ident_len
  //   rax = CC_TYPE_U64 (1), CC_TYPE_I64 (2), CC_TYPE_STR (3),
  //         CC_TYPE_HEX (4), CC_TYPE_HASH32 (5), CC_TYPE_TSC (6),
  //         CC_TYPE_PATH (8), CC_TYPE_PID (9), or CC_UNKNOWN_TYPE
  //         (0xFF).
  //
  // Length-switched dispatch: 3-byte names (u64/i64/str/hex/tsc/pid),
  // 4-byte names (path), 6-byte names (hash32). Any other length is
  // unknown.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed clo_ct_.
  //
  // Shape parallel to R224.M1 _ll_classify_type and R222.M1
  // _sch_sig_classify_type. The three parsers share the same type-
  // code dispatch byte so a downstream pass (R225.M5 cross-context
  // type flow) that compares a cmd-functor record field type to a
  // lambda parameter type to a captured-binding type reads the one
  // byte directly without a widen.
  // ==========================================================================
  pub let _cc_classify_type : (u64, u64) -> u64 !{mem} @{} =
    fn (ident_ptr: u64) (ident_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M2 (#2676): classify a candidate type_name ident against the M2-known type set. Length-switched dispatch: 3 -> six 3-letter types (u64/i64/str/hex/tsc/pid); 4 -> path; 6 -> hash32. Each length arm does a first-byte branch (`xor rax, rax; mov_b rax, [rdi+0]; cmp rax, <lit>; je ...`) then confirms the trailing bytes with further mov_b+cmp pairs. Returns CC_UNKNOWN_TYPE (0xFF) on any mismatch. Pure leaf -- zero pushes, no stack frame, no nested CALL. All ASCII literals (0x30..0x7A) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed clo_ct_. Byte-for-byte parallel to R224.M1 _ll_classify_type so the two modules share a verified dispatch table shape.",
      block: {
        cmp rsi, 3;
        je  clo_ct_len3;
        cmp rsi, 4;
        je  clo_ct_len4;
        cmp rsi, 6;
        je  clo_ct_len6;
        jmp clo_ct_bad;

        // ---- length 3: u64 / i64 / str / hex / tsc / pid ----
      clo_ct_len3:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x75;                         // 'u'
        je  clo_ct_u64;
        cmp rax, 0x69;                         // 'i'
        je  clo_ct_i64;
        cmp rax, 0x73;                         // 's'
        je  clo_ct_str;
        cmp rax, 0x68;                         // 'h'
        je  clo_ct_hex;
        cmp rax, 0x74;                         // 't'
        je  clo_ct_tsc;
        cmp rax, 0x70;                         // 'p'
        je  clo_ct_pid;
        jmp clo_ct_bad;

      clo_ct_u64:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne clo_ct_bad;
        mov rax, 1;                            // CC_TYPE_U64
        ret;

      clo_ct_i64:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x36;                         // '6'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x34;                         // '4'
        jne clo_ct_bad;
        mov rax, 2;                            // CC_TYPE_I64
        ret;

      clo_ct_str:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x74;                         // 't'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x72;                         // 'r'
        jne clo_ct_bad;
        mov rax, 3;                            // CC_TYPE_STR
        ret;

      clo_ct_hex:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x65;                         // 'e'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x78;                         // 'x'
        jne clo_ct_bad;
        mov rax, 4;                            // CC_TYPE_HEX
        ret;

      clo_ct_tsc:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x73;                         // 's'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x63;                         // 'c'
        jne clo_ct_bad;
        mov rax, 6;                            // CC_TYPE_TSC
        ret;

      clo_ct_pid:
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x69;                         // 'i'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x64;                         // 'd'
        jne clo_ct_bad;
        mov rax, 9;                            // CC_TYPE_PID
        ret;

        // ---- length 4: path ----
      clo_ct_len4:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x70;                         // 'p'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x74;                         // 't'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne clo_ct_bad;
        mov rax, 8;                            // CC_TYPE_PATH
        ret;

        // ---- length 6: hash32 ----
      clo_ct_len6:
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x68;                         // 'h'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                         // 'a'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x73;                         // 's'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x68;                         // 'h'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 0x33;                         // '3'
        jne clo_ct_bad;
        xor rax, rax;
        mov_b rax, [rdi + 5];
        cmp rax, 0x32;                         // '2'
        jne clo_ct_bad;
        mov rax, 5;                            // CC_TYPE_HASH32
        ret;

      clo_ct_bad:
        mov rax, 0xFF;                         // CC_UNKNOWN_TYPE
        ret;
      }
    }

  // ==========================================================================
  // _cc_parse_binding(bytes_ptr, bytes_len, cursor_in,
  //                   write_ptr) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_in
  //   rcx = write_ptr          (dst for the 32-byte Binding descriptor)
  //   rax = (new_cursor << 32) | status
  //
  // Parses one Binding -- `identifier (WS* ':' WS* type_name)?` -- and
  // writes a 32-byte Binding descriptor at write_ptr.
  //
  // The optional `: type_name` suffix is DETECTED by peeking after the
  // identifier (through whitespace): if the next non-ws byte is ':',
  // the typed branch runs; if it is ',' or ']' (or EOI), the untyped
  // branch runs. Any other peek byte is CC_ERR_SYNTAX.
  //
  //   Untyped branch:   type_code = 0 (CC_TYPE_UNTYPED), mode =
  //                     CC_MODE_BY_REF (0).
  //   Typed branch:     type_code = CC_TYPE_* (1..9), mode =
  //                     CC_MODE_BY_VALUE (1).
  //
  // Status one of:
  //
  //     CC_OK                 -- descriptor written, cursor advanced.
  //     CC_ERR_SYNTAX         -- bad grammar at ident, ':', or peek.
  //     CC_ERR_UNKNOWN_TYPE   -- type_name not in the M2 set.
  //
  // Does NOT itself check CC_MAX_BINDINGS or CC_ERR_OUT_TOO_SMALL --
  // those are the main parse's responsibility.
  //
  // Prologue: 5 callee-save pushes (rbx = bytes_ptr, rbp = bytes_len,
  // r12 = cursor, r13 = write_ptr, r14 = scratch for type_start +
  // post-classify type_code) + 16 B scratch (two u64 slots:
  // ident_start, ident_len). Entry rsp%16==8; +40 (5 pushes) = 0; +16
  // scratch = 0. Every nested CALL into _cc_skip_ws / _cc_classify_type
  // sees rsp%16==0.
  //
  // r11 is NEVER held across a nested CALL (Wave 116 lesson). All
  // long-lived scratch lives in callee-saved regs (r12..r14) or on
  // the stack.
  //
  // Labels prefixed clo_pb_.
  // ==========================================================================
  pub let _cc_parse_binding : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64)
       (write_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M2 (#2676): parse ONE Binding (identifier WS* ':'? WS* type_name?) and write a 32-byte Binding descriptor at write_ptr. 5 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=write_ptr, r14=type_code_or_type_start) + sub rsp, 16 (two u64 scratch slots: ident_start, ident_len) -> rsp%16==0 at every nested CALL (entry 8, +40 pushes = 0, +16 scratch = 0). Grammar: skip_ws; ident scan (byte-class [A-Za-z_] [A-Za-z0-9_]*; max CC_NAME_MAX=14 chars); skip_ws; peek for ':', ',' , ']' or EOI; if ':', typed branch (consume ':', skip_ws, scan type_name ident, classify via _cc_classify_type, write type_code and mode=1); else untyped branch (type_code=0, mode=0). Each branch emits the descriptor: zero-fill four u64 slots over the 32-byte descriptor, overwrite type_code at [+0], name_len at [+1], name bytes at [+2..+2+name_len], mode at [+16]. Returns packed (new_cursor << 32) | status; all error paths pack (0 << 32) | status so new_cursor is only valid on OK. r11 is NEVER held across a nested CALL -- values that must survive are in r12/r13/r14 or on the stack (Wave 116 lesson). All cmp immediates (ASCII 0x30..0x7A, CC_NAME_MAX=14, mode constants 0..1) fit in imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed clo_pb_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        mov r12, rdx;                          // cursor
        mov r13, rcx;                          // write_ptr
        xor r14, r14;                          // scratch
        xor rax, rax;
        mov [rsp + 0], rax;                    // ident_start = 0
        mov [rsp + 8], rax;                    // ident_len = 0

        // ---- Zero-fill the 32-byte Binding descriptor via four u64
        // stores. This gives us free zero-padding for name_inline past
        // name_len and for the reserved tail; later writes overwrite
        // only the live bytes. ----
        xor rax, rax;
        mov [r13 + 0], rax;
        mov [r13 + 8], rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // ---- skip_ws before ident ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        // ---- Ident scan: at least one [A-Za-z_] byte required.
        cmp r12, rbp;
        jae clo_pb_err_syntax;

        mov [rsp + 0], r12;                    // ident_start = cursor
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;                         // '_'
        je  clo_pb_ident_more;
        cmp rax, 0x41;                         // 'A'
        jb  clo_pb_err_syntax;
        cmp rax, 0x5A;                         // 'Z'
        jbe clo_pb_ident_more;
        cmp rax, 0x61;                         // 'a'
        jb  clo_pb_err_syntax;
        cmp rax, 0x7A;                         // 'z'
        ja  clo_pb_err_syntax;

      clo_pb_ident_more:
        add r12, 1;

      clo_pb_ident_scan:
        cmp r12, rbp;
        jae clo_pb_ident_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  clo_pb_ident_step;
        cmp rax, 0x30;                         // '0'
        jb  clo_pb_ident_check_alpha;
        cmp rax, 0x39;                         // '9'
        jbe clo_pb_ident_step;
      clo_pb_ident_check_alpha:
        cmp rax, 0x41;
        jb  clo_pb_ident_end;
        cmp rax, 0x5A;
        jbe clo_pb_ident_step;
        cmp rax, 0x61;
        jb  clo_pb_ident_end;
        cmp rax, 0x7A;
        ja  clo_pb_ident_end;
      clo_pb_ident_step:
        add r12, 1;
        jmp clo_pb_ident_scan;

      clo_pb_ident_end:
        // ident_len = cursor - ident_start
        mov rax, r12;
        sub rax, [rsp + 0];
        mov [rsp + 8], rax;                    // ident_len
        cmp rax, 0;
        je  clo_pb_err_syntax;
        cmp rax, 14;                           // CC_NAME_MAX
        ja  clo_pb_err_syntax;

        // ---- skip_ws, peek for ':' (typed) or ',' / ']' / EOI (untyped) ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        // If EOI reached after the ident, this is an untyped binding
        // and the caller will dispatch on EOI vs expected close. Fall
        // through to untyped-write.
        cmp r12, rbp;
        jae clo_pb_untyped;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x3A;                         // ':'
        je  clo_pb_typed;

        // Peek is ',' or ']' (caller handles those). Untyped binding.
        cmp rax, 0x2C;                         // ','
        je  clo_pb_untyped;
        cmp rax, 0x5D;                         // ']'
        je  clo_pb_untyped;

        // Any other peek byte at this point is a grammar error.
        jmp clo_pb_err_syntax;

        // ---- Untyped branch: type_code=0, mode=0 (both already zero
        // from the zero-fill); just write name_len + name bytes.
      clo_pb_untyped:
        // type_code already 0 (zero-fill); mode already 0.
        jmp clo_pb_write_name;

        // ---- Typed branch: consume ':', skip_ws, scan type_name,
        // classify, write type_code + mode=1.
      clo_pb_typed:
        add r12, 1;                            // consume ':'

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae clo_pb_err_syntax;

        mov r14, r12;                          // type_start

        // Scan type_name: at least one [A-Za-z_] byte required.
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  clo_pb_type_more;
        cmp rax, 0x41;
        jb  clo_pb_err_syntax;
        cmp rax, 0x5A;
        jbe clo_pb_type_more;
        cmp rax, 0x61;
        jb  clo_pb_err_syntax;
        cmp rax, 0x7A;
        ja  clo_pb_err_syntax;

      clo_pb_type_more:
        add r12, 1;

      clo_pb_type_scan:
        cmp r12, rbp;
        jae clo_pb_type_end;
        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5F;
        je  clo_pb_type_step;
        cmp rax, 0x30;
        jb  clo_pb_type_check_alpha;
        cmp rax, 0x39;
        jbe clo_pb_type_step;
      clo_pb_type_check_alpha:
        cmp rax, 0x41;
        jb  clo_pb_type_end;
        cmp rax, 0x5A;
        jbe clo_pb_type_step;
        cmp rax, 0x61;
        jb  clo_pb_type_end;
        cmp rax, 0x7A;
        ja  clo_pb_type_end;
      clo_pb_type_step:
        add r12, 1;
        jmp clo_pb_type_scan;

      clo_pb_type_end:
        // type_len = cursor - type_start; must be >= 1.
        mov r8, r12;
        sub r8, r14;
        cmp r8, 0;
        je  clo_pb_err_syntax;

        // Classify via _cc_classify_type(bytes_ptr + type_start, type_len).
        mov rdi, rbx;
        add rdi, r14;
        mov rsi, r8;
        call _cc_classify_type;
        cmp rax, 0xFF;                         // CC_UNKNOWN_TYPE
        je  clo_pb_err_bad_type;

        // Stash type_code in r14 (callee-saved; survives write pass).
        mov r14, rax;

        // Write type_code (u8) at [r13 + 0].
        mov rax, r14;
        mov_b [r13 + 0], rax;

        // Write mode = CC_MODE_BY_VALUE (1) at [r13 + 16].
        mov rax, 1;
        mov_b [r13 + 16], rax;

        // Fall through to the shared name-write path.

      clo_pb_write_name:
        // Write name_len (u8) at [r13 + 1].
        mov rax, [rsp + 8];
        mov_b [r13 + 1], rax;

        // Copy ident bytes: src = rbx + ident_start; dst = r13 + 2.
        // Count = ident_len. (Zero-pad past ident_len is implicit from
        // the earlier zero-fill of the 32-byte descriptor.)
        mov r9, [rsp + 0];                     // r9 = ident_start
        mov r10, [rsp + 8];                    // r10 = ident_len

        xor r11, r11;                          // i = 0
      clo_pb_name_copy:
        cmp r11, r10;
        jae clo_pb_name_done;
        mov rdi, rbx;
        add rdi, r9;
        add rdi, r11;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        mov rsi, r13;
        add rsi, 2;
        add rsi, r11;
        mov_b [rsi + 0], rax;
        add r11, 1;
        jmp clo_pb_name_copy;

      clo_pb_name_done:
        // Success: pack (new_cursor << 32) | CC_OK.
        mov rax, r12;
        shl rax, 32;
        jmp clo_pb_epilogue;

        // ---- Error paths ----
      clo_pb_err_syntax:
        mov rax, 0x3500;                       // CC_ERR_SYNTAX
        jmp clo_pb_epilogue;

      clo_pb_err_bad_type:
        mov rax, 0x3502;                       // CC_ERR_UNKNOWN_TYPE
        jmp clo_pb_epilogue;

      clo_pb_epilogue:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cc_parse(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = (bytes_written << 32) | status
  //
  // Walks the input bytes as:
  //
  //   skip_ws
  //   require '['                              (else CC_ERR_NO_OPEN)
  //   loop:
  //       skip_ws
  //       if EOI:            CC_ERR_NO_CLOSE
  //       if peek == ']':    consume, break
  //       caps + max-bindings check
  //       call parse_binding
  //       update any_by_value from binding's mode byte
  //       advance write_ptr + n_bindings
  //       skip_ws
  //       if EOI:            CC_ERR_NO_CLOSE
  //       if peek == ',':    consume, continue
  //       if peek == ']':    consume, break
  //       else:              CC_ERR_SYNTAX
  //   write header at out_ptr[0..32]:
  //       magic = CC_HEADER_MAGIC
  //       n_bindings (u16)
  //       flags (u16): bit 0 = HAS_BY_VALUE, bit 1 = IS_EMPTY
  //       bindings_offset (u32) = 32
  //       bindings_len (u32)    = n_bindings * 32
  //       reserved[16] = 0
  //   bytes_written = 32 + n_bindings * 32
  //   return (bytes_written << 32) | CC_OK
  //
  // Register map (6 callee-save pushes + 24-byte scratch frame ->
  // rsp%16==0 steady):
  //
  //   rbx = bytes_ptr
  //   rbp = bytes_len
  //   r12 = cursor (into input)
  //   r13 = out_ptr base (immutable)
  //   r14 = out_cap (immutable)
  //   r15 = n_bindings counter
  //
  //   [rsp + 0]  = binding_write_ptr (initial: r13 + CC_HEADER_BYTES)
  //   [rsp + 8]  = any_by_value flag (0 or 1; ORed with each binding's
  //                mode byte after parse)
  //   [rsp + 16] = scratch (unused but zeroed for determinism)
  //
  // Labels prefixed clo_.
  // ==========================================================================
  pub let _cc_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64)
       (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R224.M2 (#2676): parse a `[binding, binding, ...]` closure-capture list. 6 callee-save pushes (rbx=bytes_ptr, rbp=bytes_len, r12=cursor, r13=out_ptr base, r14=out_cap, r15=n_bindings) + sub rsp, 24 (scratch: binding_write_ptr at [rsp+0], any_by_value at [rsp+8], unused [rsp+16]) -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +24 scratch -> %16==0; nested CALLs into _cc_skip_ws / _cc_parse_binding land aligned). State: cursor walks through input; binding_write_ptr walks through output binding descriptors starting at out_ptr + CC_HEADER_BYTES (32). Each _cc_parse_binding call emits a 32-byte Binding descriptor and returns a packed (new_cursor << 32) | status; on status != 0 we jump to the error epilogue with the status in rax. Grammar: skip_ws; '['; (skip_ws; peek `]` -> close; else parse_binding; skip_ws; `,`-continue or `]`-close)*; emit header. Binding stride multiplied as `shl rN, 5` for the * 32 computation -- never `imul r, imm` (per feedback_pdx_encoder_pitfalls). All error paths jump to a shared epilogue that unwinds the 24-byte scratch and 6 callee-save pops. All `cmp` immediates (ASCII literals 0x20..0x7F, CC_MAX_BINDINGS=16, CC_NAME_MAX=14, CC_HEADER_BYTES=32, CC_BINDING_BYTES=32, status codes 0x3500..0x3505, flag bits 0x01..0x02) fit in imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. CC_HEADER_MAGIC (0x50414343) is the only >24-bit immediate and goes through `mov rN, imm32` (within imm32 range for mov -- the magic value is 0x50414343 which does not have bit 31 set, so this is sign-extension-safe). The any_by_value flag at [rsp+8] is updated via load-op-store (`mov rax, [rsp+8]; or rax, mode; mov [rsp+8], rax`) rather than `or mem, reg`. r11 is NEVER held across a nested CALL -- values survive via callee-saved regs (r12..r15) or stack. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed clo_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                          // bytes_ptr
        mov rbp, rsi;                          // bytes_len
        xor r12, r12;                          // cursor = 0
        mov r13, rdx;                          // out_ptr (immutable)
        mov r14, rcx;                          // out_cap (immutable)
        xor r15, r15;                          // n_bindings = 0

        // binding_write_ptr = out_ptr + CC_HEADER_BYTES (32).
        mov rax, r13;
        add rax, 32;
        mov [rsp + 0], rax;

        // any_by_value flag = 0; scratch = 0.
        xor rax, rax;
        mov [rsp + 8], rax;
        mov [rsp + 16], rax;

        // Capacity guard: must fit at least the header.
        cmp r14, 32;
        jb  clo_err_oos;

        // ---- skip_ws + require '[' ----
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae clo_err_no_open;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5B;                         // '['
        jne clo_err_no_open;
        add r12, 1;                            // consume '['

        // ============================================================
        // Main loop: parse Binding (',' Binding)* then ']'.
        // ============================================================
      clo_loop_top:
        // skip_ws; EOI? close?
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae clo_err_no_close;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x5D;                         // ']'
        je  clo_loop_close;

        // Capacity: binding_write_ptr + 32 - out_ptr <= out_cap.
        mov rax, [rsp + 0];
        add rax, 32;
        sub rax, r13;
        cmp rax, r14;
        ja  clo_err_oos;

        // Max-bindings guard.
        cmp r15, 16;                           // CC_MAX_BINDINGS
        jae clo_err_too_many;

        // Call _cc_parse_binding(bytes_ptr, bytes_len, cursor,
        // binding_write_ptr) -> packed(new_cursor<<32)|status.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call _cc_parse_binding;

        // Split rax into (new_cursor, status).
        mov r10, rax;
        shl r10, 32;
        shr r10, 32;                           // r10 = status
        cmp r10, 0;
        jne clo_err_from_sub;

        // Success: extract new_cursor from high 32.
        shr rax, 32;
        mov r12, rax;                          // cursor = new_cursor

        // OR the binding's mode byte into any_by_value.
        mov rdi, [rsp + 0];                    // binding_write_ptr
        xor rax, rax;
        mov_b rax, [rdi + 16];                 // mode byte
        mov rcx, [rsp + 8];
        or  rcx, rax;
        mov [rsp + 8], rcx;

        // Advance binding_write_ptr + n_bindings.
        mov rax, [rsp + 0];
        add rax, 32;
        mov [rsp + 0], rax;
        add r15, 1;

        // skip_ws, expect ',' or ']'.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _cc_skip_ws;
        mov r12, rax;

        cmp r12, rbp;
        jae clo_err_no_close;

        xor rax, rax;
        mov_b rax, [rbx + r12];
        cmp rax, 0x2C;                         // ','
        je  clo_loop_comma;
        cmp rax, 0x5D;                         // ']'
        je  clo_loop_close;
        jmp clo_err_syntax;

      clo_loop_comma:
        add r12, 1;                            // consume ','
        jmp clo_loop_top;

      clo_loop_close:
        add r12, 1;                            // consume ']'
        jmp clo_header_write;

        // ============================================================
        // Header write.
        //
        // bytes_written = 32 + n_bindings * 32
        // bindings_offset = 32
        // bindings_len    = n_bindings * 32
        // flags = (any_by_value ? HAS_BY_VALUE : 0)
        //       | (n_bindings == 0 ? IS_EMPTY : 0)
        // ============================================================
      clo_header_write:
        // magic (u32) at [r13 + 0] = CC_HEADER_MAGIC (0x50414343).
        mov rax, 0x50414343;
        mov_d [r13 + 0], rax;

        // n_bindings (u16) at [r13 + 4]: low byte, high byte.
        mov rax, r15;
        mov_b [r13 + 4], rax;
        shr rax, 8;
        mov_b [r13 + 5], rax;

        // Compute flags u16 into r11 (loop-local scratch -- no nested
        // CALL between here and the mov_b store below).
        xor r11, r11;
        mov rax, [rsp + 8];                    // any_by_value (0 or 1)
        or  r11, rax;                          // bit 0 = HAS_BY_VALUE
        cmp r15, 0;
        jne clo_hdr_set_byval_only;
        or  r11, 2;                            // bit 1 = IS_EMPTY
      clo_hdr_set_byval_only:
        // flags u16 at [r13 + 6]: low byte (bits 0..7), high byte 0.
        mov rax, r11;
        mov_b [r13 + 6], rax;
        xor rax, rax;
        mov_b [r13 + 7], rax;

        // bindings_offset (u32) at [r13 + 8] = 32.
        mov rax, 32;
        mov_d [r13 + 8], rax;

        // bindings_len (u32) at [r13 + 12] = n_bindings * 32.
        mov rax, r15;
        shl rax, 5;
        mov_d [r13 + 12], rax;

        // reserved[16] at [r13 + 16..32] = 0 (two u64 zero stores).
        xor rax, rax;
        mov [r13 + 16], rax;
        mov [r13 + 24], rax;

        // ---- Success: pack return. --------------------------------
        //
        // bytes_written = 32 + n_bindings * 32.
        mov rax, r15;
        shl rax, 5;
        add rax, 32;
        shl rax, 32;
        jmp clo_epilogue;

        // ============================================================
        // Error paths
        // ============================================================
      clo_err_from_sub:
        mov rax, r10;                          // sub's status in r10
        jmp clo_epilogue;

      clo_err_syntax:
        mov rax, 0x3500;                       // CC_ERR_SYNTAX
        jmp clo_epilogue;

      clo_err_too_many:
        mov rax, 0x3501;                       // CC_ERR_TOO_MANY_BINDINGS
        jmp clo_epilogue;

      clo_err_oos:
        mov rax, 0x3503;                       // CC_ERR_OUT_TOO_SMALL
        jmp clo_epilogue;

      clo_err_no_open:
        mov rax, 0x3504;                       // CC_ERR_NO_OPEN
        jmp clo_epilogue;

      clo_err_no_close:
        mov rax, 0x3505;                       // CC_ERR_NO_CLOSE
        jmp clo_epilogue;

        // ============================================================
        // Epilogue
        // ============================================================
      clo_epilogue:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
