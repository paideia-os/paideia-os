// src/fuzz_harness.pdx -- libpdx-pds-parser.R221.M7 (paideia-os#2657)
//
// FuzzHarness: single-entry survivability driver that feeds a caller-
// supplied byte buffer through the parser-tier pipeline (UTF-8 decode
// + NFC, grapheme-cluster count, context-tracking lexer, pipeline
// parser, Datalog parser, lambda parser) and returns a packed status
// in the dedicated 0x4A00..0x4AFF band. R221.M7 of the parser-tier
// Unicode + lexer umbrella (paideia-os#2485).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Semantic-shell §15.6 contract: "The parser is fuzz-tested per dev-
// env §9.5. Malformed input may produce errors but never crashes."
// R221.M7 lands THREE pieces that satisfy that contract jointly:
//
//   1. THIS module (`fuzz_harness.pdx`) -- a stable, single-entry
//      byte-vector sink. An external AFL++ / libFuzzer driver (not
//      part of THIS M7 landing) hands _fh_drive a mutator-generated
//      byte buffer and length; _fh_drive invokes every parser-tier
//      primitive against the input and returns to the driver with a
//      well-defined status. Any state the parser would reach via
//      SIGSEGV / SIGBUS / SIGILL instead surfaces as a non-return
//      from _fh_drive -- AFL interprets that as a crash candidate.
//
//   2. The seed corpus at `tests/shell/parser-fuzz/seeds/`, enumerated
//      in `design/shell/parser-fuzz-corpus.md`. 30..50 inputs across
//      four adversarial families: malformed UTF-8, malformed NFC,
//      pathological delimiter nesting, ASCII edge cases. The corpus
//      is a static artifact; AFL replays it on every nightly fuzz.
//
//   3. The `README.md` under the corpus directory, enumerating the
//      external driver's AFL++ / libFuzzer wire-up (deferred to a
//      follow-up ticket; the seeds + harness ARE the M7 deliverable
//      per the acceptance clause).
//
// The harness drives:
//
//     _u8n_decode_and_normalize   (R221.M1)
//     _gi_count_clusters          (R221.M2)
//     _cl_init + _cl_tokenize     (R221.M4)
//     _pl_parse                   (R223.M1)
//     _dl_parse                   (R226.M1)
//     _ll_parse                   (R224.M1)
//
// in that fixed order. Every parser's return status (success OR a
// documented error band value) is accepted without crashing the
// harness -- the harness explicitly SWALLOWS parser-level errors
// because "parser rejected the input with a documented error code"
// is the correct outcome of a fuzz iteration, NOT a failure. Only
// an actual non-return (SIGSEGV / wild write / infinite loop) is a
// crash.
//
// =============================================================================
// FALLBACK DISCIPLINE
// =============================================================================
//
// On entry, if the input is empty (len == 0), _fh_drive returns FH_OK
// without touching any parser (every parser has a documented empty-
// input early return). Otherwise:
//
//   1. Call `_u8n_decode_and_normalize` into `_fh_nfc_buf`.
//   2. If U8N_OK, the downstream parsers see the NFC-form bytes.
//   3. If U8N_* ERROR (invalid UTF-8, out-too-small, normalise-fail,
//      or any future unknown code), the downstream parsers see the
//      ORIGINAL raw input. This exercises the parsers' tolerance of
//      malformed UTF-8 explicitly -- a key §15.6 corollary.
//
// Both arms of the fallback feed the same four downstream parsers in
// the same fixed order, so coverage is identical regardless of NFC
// outcome.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _fh_drive(bytes, len) -> packed_u64
//     rdi = bytes          (pointer to the fuzz input)
//     rsi = len            (length in bytes; 0 is well-defined)
//     rax = packed status:
//           bits [15: 0]   FH_* code (FH_OK on normal return;
//                                     FH_ERR_* on input-shape fault)
//           bits [31:16]   stage reached (0..6; see table below)
//           bits [63:32]   reserved (0 on M7)
//
//     Stage encoding:
//       0  pre-entry / input-shape fault
//       1  NFC decode completed (regardless of status)
//       2  grapheme-cluster count completed
//       3  _cl_init + _cl_tokenize completed
//       4  _pl_parse completed
//       5  _dl_parse completed
//       6  _ll_parse completed  (full-pipeline survival)
//
//     A caller that observes rax = (6 << 16) | 0 learned that the
//     input survived the complete pipeline. Any lower stage with
//     FH_OK means the harness bailed on an input-shape guard before
//     reaching that stage (len == 0 returns stage 0 FH_OK). FH_ERR_*
//     is reserved for harness-internal input-shape faults -- NEVER
//     for parser-level errors.
//
// Register map (SysV):
//
//     _fh_drive(rdi, rsi)         -> rax
//
// =============================================================================
// STATUS CODES -- band 0x4A00..0x4AFF
// =============================================================================
//
//   FH_OK                   : 0        normal return.
//   FH_ERR_NULL_INPUT       : 0x4A00   bytes == 0 and len > 0.
//   FH_ERR_INPUT_TOO_LARGE  : 0x4A01   len > FH_MAX_INPUT_BYTES
//                                      (16384). Protects the fixed-
//                                      size .bss NFC buffer.
//
// Band carved on a fresh kilo-step boundary past R225.M4 EffectUnify
// (0x4900..0x49FF). Slots 0x4A02..0x4AFF reserved for M7.1+ follow-
// ups (per-parser timeout seams, oracle-arm status assertions,
// coverage-feedback feedback-channel codes).
//
// Note: FH_* status codes are DISJOINT from every parser-tier error
// band (0x2700..0x49FF across M1..M4 of all five R221..R229 waves)
// and from the kernel-side `src/kernel/core/user/founder_home.pdx`
// FH_* band (0xFFFFE53A..0xFFFFE540). The kernel-side band uses the
// u32-negative tail of the u64 range; this module uses the small-
// value user-space range -- a disjointness-proof grep shows no slot
// overlap.
//
// =============================================================================
// .bss STATE (singleton)
// =============================================================================
//
//   _fh_nfc_buf     : [u8; 32768] -- NFC-form byte sink. Sized 2x
//                     FH_MAX_INPUT_BYTES; NFC can expand input by
//                     at most ~1.5x in canonical-composition (table-
//                     bounded; the Unicode canonical-decomposition
//                     mappings never exceed a 2x byte-count ratio
//                     in NFC form across the UCD 15.1 corpus).
//   _fh_tok_buf     : [u8; 8192]  -- CtxLexer Token-record sink
//                     (512 slots at 16 B stride).
//   _fh_pl_buf      : [u8; 1024]  -- Pipeline PL_MAX_STAGES (16)
//                     x 64 B stride = 1024 bytes exactly.
//   _fh_dl_buf      : [u8; 2048]  -- Datalog Clause-record sink
//                     (~42 clauses at 48 B stride). Caps clauses
//                     well below DL_MAX_CLAUSES (256) because the
//                     harness only needs enough room for the parser
//                     to exercise its full byte-walker, not to
//                     admit record-count-saturated input.
//   _fh_ll_buf      : [u8; 1024]  -- Lambda-literal record sink
//                     (header + 8 params at 32 B + body room).
//
// Total: 32768 + 8192 + 1024 + 2048 + 1024 = 45056 B = 44 KiB. All
// five buffers are .bss (zero-filled by the loader; no explicit
// init required between fuzz iterations because every parser
// documented behavior is "write-then-read" and never reads stale
// bytes past the record it just emitted).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- NFC-status extraction uses `shl r, 32;
//     shr r, 32` (defensive zero-extend; Wave 118 lesson).
//   - No 2-op `imul r, imm` -- the harness does no multiply.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `FuzzHarness` matches `fuzz_harness.pdx`.
//   - Labels prefixed `fh_drv_` (grep-confirmed unique against the
//     parser-tier modules in THIS library: u8n_, gi_, wp_, cl_,
//     ast_, sm_, sch_sig_, cmd_sig_, fi_, afs_, cmdreg_, dm_, pl_,
//     rp_, ll_, cc_, er_, cr_, ls_, hm_, rt_, eu_, dl_, se_, te_).
//     The kernel-side `src/kernel/core/user/founder_home.pdx` uses
//     function-scoped `fh_cv_*` labels, which share no linker-
//     visible namespace with our function-scoped `fh_drv_*` labels
//     (precedent: `dispatch_mode.pdx` dm_* vs `src/user/dmesg.pdx`
//     dm_pud_* function-scoped collision allowance). Never bare
//     `loop`/`if`/`let`/`fn`/`ret`/`done`.
//   - All `cmp reg, imm` immediates (0, 16384, status codes
//     0x4A00..0x4A01) fit imm32 with bit 31 clear.
//   - Byte / u32 / u64 loads via the standard shapes (mov_b, mov_d,
//     mov). u64 stores via plain `mov [r11+disp], rN`.
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
// r11 is clobbered by every nested CALL. Values that must survive
// a nested CALL live in callee-save regs:
//
//   rbx = parse_ptr (set after the NFC-vs-fallback decision; stable
//         for the lex / pipeline / datalog / lambda calls)
//   rbp = parse_len (stable)
//   r12 = raw_bytes_ptr (saved from rdi; survives the NFC CALL so
//         the fallback branch can restore parse_ptr to r12)
//   r13 = raw_bytes_len (saved from rsi; survives the NFC CALL)
//
// Four callee-save pushes + sub rsp, 8 alignment pad = 40 B frame.
// Entry rsp%16==8 + 32 pushes = %16==8, +8 pad = %16==0 pre-CALL
// (SysV requirement, honoured at every nested CALL).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R221.M7.1  AFL++ driver glue: a small `.c` or `.pdx` shim that
//              `malloc`s a 64 KiB sidecar buffer, reads AFL's
//              `__AFL_FUZZ_INIT()`-provided bytes, and tail-calls
//              `_fh_drive`. Lands under
//              `tools/user/libpdx-pds-parser/tools/fuzz/`.
//   R221.M7.2  libFuzzer driver: `LLVMFuzzerTestOneInput(buf, len)`
//              shim that forwards to `_fh_drive`. Same shim shape
//              as M7.1 minus the AFL `__AFL_FUZZ_LOOP` wrapper.
//   R221.M7.3  Oracle arm: after each parser call, assert the
//              packed status is in the parser's documented error
//              band (0x2700..0x27FF for U8N, 0x3800..0x38FF for
//              GI, 0x4200..0x42FF for CL, 0x2B00..0x2BFF for PL,
//              0x2E00..0x2EFF for DL, 0x2C00..0x2CFF for LL).
//              Any unknown code is a §15.6 contract violation.
//              Reserves slots 0x4A02..0x4A09.
//   R221.M7.4  Coverage-guided seed accretion: feed AFL's queue
//              output back into `tests/shell/parser-fuzz/seeds/`
//              on each nightly green run (per dev-env §9.5
//              "auto-committed by a bot").
//   R221.M7.5  Smoke-mode asserter: a per-boot harness run over
//              a 10-seed hot subset that gates the shell boot
//              on §15.6 contract compliance. Reserves a
//              per-seed TSC counter at the sibling `.bss` scalar.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2657 (R221.M7).
// Substrate: paideia-os#2651 (R221.M1 Utf8Nfc), paideia-os#2652
// (R221.M2 GraphemeIter), paideia-os#2654 (R221.M4 CtxLexer),
// paideia-os#2666 (R223.M1 Pipeline), paideia-os#2675 (R224.M1
// LambdaLit), paideia-os#2692 (R226.M1 Datalog). Design doc:
// design/shell/parser-fuzz-corpus.md. Verification clause:
// design/terminal/semantic-shell.md §15.6.

module FuzzHarness = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 16 bits of packed rax)
  // ==========================================================================
  //
  // Band 0x4A00..0x4AFF, carved on a kilo-step boundary past R225.M4
  // EffectUnify (0x4900..0x49FF). Two slots used at R221.M7; slots
  // 0x4A02..0x4AFF reserved for M7.1+ follow-ups.

  pub let FH_OK                  : u64 = 0
  pub let FH_ERR_NULL_INPUT      : u64 = 0x4A00
  pub let FH_ERR_INPUT_TOO_LARGE : u64 = 0x4A01

  // ==========================================================================
  // SECTION 2 -- STAGE CODES (returned in bits [31:16] of packed rax)
  // ==========================================================================

  pub let FH_STAGE_ENTRY         : u64 = 0
  pub let FH_STAGE_NFC           : u64 = 1
  pub let FH_STAGE_GRAPHEME      : u64 = 2
  pub let FH_STAGE_LEX           : u64 = 3
  pub let FH_STAGE_PIPELINE      : u64 = 4
  pub let FH_STAGE_DATALOG       : u64 = 5
  pub let FH_STAGE_LAMBDA        : u64 = 6

  // ==========================================================================
  // SECTION 3 -- LAYOUT CONSTANTS
  // ==========================================================================

  // Maximum input length the harness will drive. 16 KiB covers the
  // dev-env §9.5 "very long input" case (10 KiB+) with headroom.
  pub let FH_MAX_INPUT_BYTES     : u64 = 16384

  // Buffer sizes (bytes) for the five internal parser sinks.
  pub let FH_NFC_BUF_BYTES       : u64 = 32768
  pub let FH_TOK_BUF_BYTES       : u64 = 8192
  pub let FH_PL_BUF_BYTES        : u64 = 1024
  pub let FH_DL_BUF_BYTES        : u64 = 2048
  pub let FH_LL_BUF_BYTES        : u64 = 1024

  // Pack-shape constant: stage shift.
  pub let FH_STAGE_SHIFT         : u64 = 16

  // ==========================================================================
  // SECTION 4 -- STATIC STATE (.bss, singleton)
  // ==========================================================================
  //
  // Zero-init at loader time satisfies the "fresh buffer per fuzz
  // iteration" semantic for every downstream parser. The parsers
  // all follow write-then-read discipline over their output records,
  // so stale bytes past the written-count are never observed.

  pub let mut _fh_nfc_buf : [u8; 32768] = uninit @align(8)
  pub let mut _fh_tok_buf : [u8; 8192]  = uninit @align(8)
  pub let mut _fh_pl_buf  : [u8; 1024]  = uninit @align(8)
  pub let mut _fh_dl_buf  : [u8; 2048]  = uninit @align(8)
  pub let mut _fh_ll_buf  : [u8; 1024]  = uninit @align(8)

  // ==========================================================================
  // _fh_drive(bytes, len) -> packed_u64
  //
  //   rdi = bytes (fuzz input ptr)
  //   rsi = len   (byte count)
  //   rax = (stage << 16) | status
  //
  // See the module header for the pack shape and stage encoding.
  //
  // Pre-entry input-shape guards return BEFORE the prologue (bare
  // return paths; no frame to tear down). The main body runs under
  // a 4-push + 8-pad frame; every nested CALL sees rsp%16==0.
  //
  // Labels prefixed fh_drv_.
  // ==========================================================================
  pub let _fh_drive : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M7 (#2657): _fh_drive single-entry survivability driver. Feeds (bytes, len) through _u8n_decode_and_normalize (into _fh_nfc_buf, cap 32768) then branches on NFC status: on U8N_OK the downstream parsers see the NFC-form bytes; on any error the downstream parsers see the raw input (so parser tolerance of malformed UTF-8 is exercised). Fixed order downstream: _gi_count_clusters, _cl_init + _cl_tokenize (into _fh_tok_buf cap 8192), _pl_parse (into _fh_pl_buf cap 1024), _dl_parse (into _fh_dl_buf cap 2048), _ll_parse (into _fh_ll_buf cap 1024). Every parser return status is SWALLOWED (a documented error band code is NOT a fuzz failure; only non-return is). Pre-entry guards: len == 0 -> return FH_OK stage 0 bare (empty input is a well-defined no-op); bytes == 0 and len > 0 -> return FH_ERR_NULL_INPUT (0x4A00) stage 0 bare; len > FH_MAX_INPUT_BYTES (16384) -> return FH_ERR_INPUT_TOO_LARGE (0x4A01) stage 0 bare. Prologue: 4 callee-save pushes (rbx=parse_ptr post-NFC, rbp=parse_len post-NFC, r12=raw_bytes_ptr, r13=raw_bytes_len) + sub rsp, 8 pad = 40 B frame; entry rsp%16==8 + 32 pushes = %16==8, +8 pad = %16==0 pre-CALL (SysV requirement). r12/r13 preserve raw ptr+len across the NFC CALL so the fallback branch restores parse_ptr/parse_len to r12/r13 on NFC failure. NFC status extraction uses `mov r9, rax; shl r9, 32; shr r9, 32` (defensive zero-extend; avoids and-imm64). Each downstream parser call rebuilds the arg vector (rdi=rbx, rsi=rbp, rdx=lea [rip + _fh_*_buf], rcx=cap). Final return packs stage 6 (LAMBDA) with FH_OK status via `mov rax, 6; shl rax, 16`. All cmp immediates (0, 16384, 0x4A00, 0x4A01) fit imm32 with bit 31 clear. Byte / u32 / u64 loads via the standard shapes. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed fh_drv_.",
      block: {
        // ---- Pre-prologue input-shape guards ---------------------------
        //
        // (G1) Empty input: well-defined no-op; every downstream parser
        // documents an empty-input early return, so skipping them is
        // equivalent to running them. Return FH_OK stage 0.
        cmp rsi, 0;
        je  fh_drv_empty_ok_bare;

        // (G2) Null input ptr with non-zero len: harness-level fault;
        // return FH_ERR_NULL_INPUT with stage 0.
        cmp rdi, 0;
        je  fh_drv_null_bare;

        // (G3) Oversize input: cap at FH_MAX_INPUT_BYTES (16384).
        cmp rsi, 16384;
        ja  fh_drv_too_large_bare;

        // ---- Prologue --------------------------------------------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub  rsp, 8;

        // Save raw ptr + len into callee-save regs; they survive the
        // NFC CALL that follows and are read on the fallback branch.
        mov r12, rdi;                            // raw_bytes_ptr
        mov r13, rsi;                            // raw_bytes_len

        // ---- Stage 1: NFC decode --------------------------------------
        //
        // _u8n_decode_and_normalize(bytes, len, _fh_nfc_buf, 32768)
        // returns (bytes_written << 32) | status in rax; status in
        // {U8N_OK (0), U8N_ERR_INVALID_UTF8 (0x2700), U8N_ERR_OUT_
        // TOO_SMALL (0x2701), U8N_ERR_NORMALIZE_FAIL (0x2702)}.
        mov rdi, r12;
        mov rsi, r13;
        lea r11, [rip + _fh_nfc_buf];
        mov rdx, r11;
        mov rcx, 32768;                          // FH_NFC_BUF_BYTES
        call _u8n_decode_and_normalize;

        // Extract status (low 32 bits) via defensive zero-extend.
        mov r9, rax;
        shl r9, 32;
        shr r9, 32;

        // Branch on NFC status: U8N_OK -> parse the NFC buffer;
        // anything else -> fall back to the raw input (exercising
        // parser tolerance of malformed UTF-8 explicitly).
        cmp r9, 0;
        jne fh_drv_fallback;

        // ---- NFC-OK branch: parse_ptr = _fh_nfc_buf, parse_len = NFC written ----
        lea r11, [rip + _fh_nfc_buf];
        mov rbx, r11;                            // parse_ptr
        shr rax, 32;
        mov rbp, rax;                            // parse_len = bytes_written
        jmp fh_drv_grapheme;

        // ---- NFC-error branch: parse_ptr = raw, parse_len = raw len ----
      fh_drv_fallback:
        mov rbx, r12;                            // parse_ptr = raw
        mov rbp, r13;                            // parse_len = raw len

        // ---- Stage 2: grapheme cluster count --------------------------
        //
        // _gi_count_clusters(parse_ptr, parse_len) returns packed
        // (count << 32) | status in rax. We swallow the return.
      fh_drv_grapheme:
        mov rdi, rbx;
        mov rsi, rbp;
        call _gi_count_clusters;

        // ---- Stage 3: lexer reset + tokenize --------------------------
        //
        // _cl_init() clears the ctx-lexer .bss stack; _cl_tokenize
        // walks the input via _cl_lex_token until EOF or error and
        // emits 16 B Token records into _fh_tok_buf.
        call _cl_init;

        mov rdi, rbx;
        mov rsi, rbp;
        lea r11, [rip + _fh_tok_buf];
        mov rdx, r11;
        mov rcx, 8192;                           // FH_TOK_BUF_BYTES
        call _cl_tokenize;

        // ---- Stage 4: pipeline parser ---------------------------------
        //
        // _pl_parse(parse_ptr, parse_len, _fh_pl_buf, 1024) emits up
        // to PL_MAX_STAGES (16) 64 B PipelineStage records.
        mov rdi, rbx;
        mov rsi, rbp;
        lea r11, [rip + _fh_pl_buf];
        mov rdx, r11;
        mov rcx, 1024;                           // FH_PL_BUF_BYTES
        call _pl_parse;

        // ---- Stage 5: datalog parser ----------------------------------
        //
        // _dl_parse(parse_ptr, parse_len, _fh_dl_buf, 2048) emits
        // 48 B Clause records; the 2 KiB cap bounds the harness
        // output far below DL_MAX_CLAUSES (256).
        mov rdi, rbx;
        mov rsi, rbp;
        lea r11, [rip + _fh_dl_buf];
        mov rdx, r11;
        mov rcx, 2048;                           // FH_DL_BUF_BYTES
        call _dl_parse;

        // ---- Stage 6: lambda-literal parser ---------------------------
        //
        // _ll_parse(parse_ptr, parse_len, _fh_ll_buf, 1024) emits a
        // single lambda-literal record (header + up to 8 Param
        // descriptors + body-span fields).
        mov rdi, rbx;
        mov rsi, rbp;
        lea r11, [rip + _fh_ll_buf];
        mov rdx, r11;
        mov rcx, 1024;                           // FH_LL_BUF_BYTES
        call _ll_parse;

        // ---- Normal return: stage 6, FH_OK (0) ------------------------
        //
        // Full-pipeline survival. Pack (6 << 16) | 0 = 0x60000.
        mov rax, 6;
        shl rax, 16;

        // ---- Epilogue --------------------------------------------------
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

        // ---- Pre-prologue bare returns --------------------------------
        //
        // No frame; rax packs stage (always 0 here) and status.

      fh_drv_empty_ok_bare:
        // Stage 0 | FH_OK (0) -> rax = 0.
        xor rax, rax;
        ret;

      fh_drv_null_bare:
        // Stage 0 | FH_ERR_NULL_INPUT (0x4A00).
        mov rax, 0x4A00;
        ret;

      fh_drv_too_large_bare:
        // Stage 0 | FH_ERR_INPUT_TOO_LARGE (0x4A01).
        mov rax, 0x4A01;
        ret;
      }
    }

}
