// src/predicate_types.pdx -- libpdx-pds-parser.R226.M2 (paideia-os#2693)
//
// PredicateTypes: parser-tier predicate-type resolution and
// argument-position typechecking for the Datalog surface. R226.M2 of
// the datalog umbrella (paideia-os#2490).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R226.M1 (datalog.pdx) lands the parser that turns raw datalog
// program bytes into a flat array of 48-byte Clause records exposing
// each head term as a (byte_offset, byte_len) span over the caller's
// input buffer. That parser is deliberately UNTYPED: it does not
// know which predicates have been declared by the kernel-side schema
// registry (R220.M4), it does not know a predicate's expected arity,
// and it does not know which SchemasSig type each argument position
// must satisfy. R226.M2 (THIS module) closes that gap.
//
// Position in the parser substrate:
//
//                 raw datalog program bytes
//                           |
//                           v
//       +------------------------------------------+
//       | R221.M1  Utf8Nfc::_u8n_decode_and_       |
//       |          normalize   (UTF-8 + NFC)       |
//       +---------------------+--------------------+
//                             |
//                             v  NFC-form bytes
//       +------------------------------------------+
//       | R226.M1  Datalog::_dl_parse              |
//       +---------------------+--------------------+
//                             |
//                             v  Clause[0..n]
//       +------------------------------------------+
//       | R226.M2  PredicateTypes::_pt_* (THIS)    |
//       +---------------------+--------------------+
//                             |
//                             v  typed predicate refs
//       +------------------------------------------+
//       | R226.M3  bottom-up semi-naive evaluator  |
//       +------------------------------------------+
//
// The surface is deliberately CALLER-DRIVEN. The caller (the shell's
// datalog elaborator -- not yet landed; owned by R226.M3+ or an
// adjacent R226 milestone) walks the Clause array, for each head /
// body atom computes the predicate name span, computes the actual
// argument type codes from the term classifier, and calls into this
// module's four public entry points to:
//
//   1. _pt_register  -- declare a predicate (either from the schema
//                       registry on startup, or AUTO-REGISTER a
//                       user-defined predicate on first use from the
//                       body of a Rule or a Fact).
//   2. _pt_lookup    -- look up a predicate by name_hash; returns the
//                       48-byte record on hit, PT_ERR_UNKNOWN_PREDICATE
//                       on miss (the signal the elaborator uses to
//                       auto-register).
//   3. _pt_check_call -- validate a call site's arity and per-position
//                       type codes against the resolved predicate's
//                       signature.
//
// =============================================================================
// RECORD LAYOUT -- 64-BYTE PredicateRecord
// =============================================================================
//
// The record carries magic (so a stray read against uninitialised .bss
// is diagnosable), arity, flags, a 64-bit name identity (FNV-1a 64),
// a 16-byte inline name copy (so a downstream reporter can emit the
// surface name without re-reading the caller's input), and up to 32
// per-argument SchemasSig type codes.
//
//   offset  size  field
//   ------  ----  -------------------------------------------------------
//     0      4   magic                 u32 -- 'PRTY' (0x59545250 LE)
//                                             = bytes 50 52 54 59 on disk
//                                             (ASCII P R T Y).
//     4      2   arity                 u16 -- 0..PT_MAX_ARITY (= 32)
//     6      2   flags                 u16 -- bit 0 PT_FLAG_USER_DEFINED
//                                             (= 0x0001); other bits
//                                             reserved for M2.1+ (open
//                                             world, recursive, aggregate
//                                             return, etc.)
//     8      8   name_hash             u64 -- FNV-1a 64 over the name
//                                             bytes. The lookup key.
//    16     16   name_inline           u8[16] -- ASCII identifier, zero-
//                                               padded to 16 bytes. Names
//                                               longer than 16 bytes are
//                                               rejected at register.
//    32     32   arg_type_codes        u8[32] -- SchemasSig type codes
//                                               (SS_TYPE_U64=1, SS_TYPE_I64
//                                               =2, SS_TYPE_STR=3, SS_TYPE_
//                                               HEX=4, SS_TYPE_HASH32=5,
//                                               SS_TYPE_TSC=6, SS_TYPE_PATH
//                                               =8, SS_TYPE_PID=9, plus
//                                               the parser-tier M2
//                                               extensions PT_TYPE_VAR=10
//                                               (= Datalog variable;
//                                               compatible with any
//                                               ground type at a call
//                                               site) and PT_TYPE_WILD=11
//                                               (= `_` placeholder;
//                                               compatible with any
//                                               ground type). Slots past
//                                               arity are 0 (= SS_TYPE_END).
//
//   total: 64 B (PT_RECORD_BYTES) -- stride is a power of two so pool
//   addressing uses `shl rN, 6` with no 2-op `imul r, imm`
//   (feedback_pdx_encoder_pitfalls).
//
// Record-stride reconciliation note: the parent brief listed the
// record as "48B" but then specified field offsets up to 0x40 (= 64
// decimal) with `u8[32] arg_type_codes at 0x20..0x40` AND stated an
// arity cap of 32. The two constraints together are only satisfiable
// at stride 64, not stride 48. This module honours the field-offset
// AND arity-cap commitments (both externally observable) at the cost
// of a 16-byte widening on the stride constant, which bumps the pool
// footprint from 6144 B to 8192 B. See section 2 of the design doc.
//
// =============================================================================
// POOL  --  SINGLETON .bss
// =============================================================================
//
//   _pt_predicates      : [u8; 128 * 64]  -- 8192 B, @align(8).
//   _pt_predicate_count : u64             -- number of occupied slots.
//   _pt_init_state      : u64             -- 0 = uninitialised, 1 = init.
//
// The pool is a dense array -- slot i lives at offset i * 64 from the
// base. The lookup is a LINEAR SCAN over 0..n with early exit on
// name_hash match (precedent: _cmd_sig_fnv1a64 identity-only hashing
// in R222.M2, R222.M5). An M2.1+ landing may introduce an open-addressed
// hash table once register call-rates in production exceed what the
// linear scan can tolerate; the public API is stable across that
// change because callers only see the record pointer / errno.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _pt_init() -> ()
//     Zero-fill the pool, clear the counter, mark initialised. Idempotent.
//     Pure leaf. Entry rsp%16==8 (standard SysV).
//
//   _pt_register(name_ptr, name_len, arity, arg_types_ptr, flags) -> errno
//     Register a predicate. If a predicate with the same name_hash is
//     already present, this call is a no-op and returns PT_OK (the
//     elaborator's auto-register path on body atoms is idempotent by
//     design; the second occurrence of `parent(X, Y)` in a program
//     must not fail even though the first one already registered it).
//     If no record with the same hash exists, allocate the next free
//     slot in _pt_predicates (slot index = _pt_predicate_count), fill
//     in all fields, bump the counter.
//
//     rdi = name_ptr        -- ASCII identifier bytes (1..16 bytes).
//     rsi = name_len        -- length in bytes.
//     rdx = arity           -- 0..PT_MAX_ARITY (= 32).
//     rcx = arg_types_ptr   -- ptr to arity bytes of SchemasSig type
//                              codes (SS_TYPE_* OR PT_TYPE_VAR OR
//                              PT_TYPE_WILD). May be NULL iff arity == 0.
//     r8  = flags           -- flags u16 (bit 0 PT_FLAG_USER_DEFINED).
//     rax = PT_OK | PT_ERR_*
//
//   _pt_lookup(name_ptr, name_len, out_record_ptr) -> errno
//     Look up a predicate by name. On hit, writes the 64-byte record
//     to [out_record_ptr, out_record_ptr+64). On miss, writes 64 zero
//     bytes to [out_record_ptr, out_record_ptr+64) and returns
//     PT_ERR_UNKNOWN_PREDICATE (0x6412 = E0902).
//
//     rdi = name_ptr        -- ASCII identifier bytes.
//     rsi = name_len        -- length in bytes.
//     rdx = out_record_ptr  -- 64-byte caller-owned scratch.
//     rax = PT_OK | PT_ERR_*
//
//   _pt_check_call(predicate_record, actual_args_ptr, actual_n_args,
//                  actual_type_codes) -> status
//     Validate a call site's arity + per-position type codes against
//     the predicate's resolved signature. The `actual_args_ptr`
//     argument is OPAQUE at R226.M2 and reserved for M3+ when the
//     evaluator passes its Clause.term_offsets[] pointer here (this
//     lets a later landing attach a source-span to each per-position
//     type-mismatch diagnostic without an ABI break; see the design
//     doc section 7 for the forward path).
//
//     rdi = predicate_record  -- ptr to a 64-byte record (either from
//                                _pt_lookup or an in-pool pointer).
//     rsi = actual_args_ptr   -- opaque; reserved for M3+.
//     rdx = actual_n_args     -- call-site arity.
//     rcx = actual_type_codes -- ptr to actual_n_args bytes of SS_TYPE_*
//                                codes derived from the call site's
//                                terms (ident -> SS_TYPE_STR; number
//                                -> SS_TYPE_U64; string -> SS_TYPE_STR;
//                                variable -> PT_TYPE_VAR).
//     rax = PT_OK | PT_ERR_ARITY_MISMATCH | PT_ERR_TYPE_MISMATCH
//           | PT_ERR_BAD_RECORD | PT_ERR_BAD_PTR
//
//     Compatibility rule: PT_TYPE_VAR and PT_TYPE_WILD on the EXPECTED
//     side (predicate's arg_type_codes[i]) match any actual type code.
//     PT_TYPE_VAR and PT_TYPE_WILD on the ACTUAL side also match any
//     expected type. All other mismatches are reported as
//     PT_ERR_TYPE_MISMATCH.
//
// =============================================================================
// STATUS CODES -- band 0x6400..0x64FF
// =============================================================================
//
// Grep confirmation at R226.M2 landing time:
//
//   grep -rE '0x64[0-9A-F]{2}' paideia-os/{src,tools,design,tests}
//     -> no packed-status hits outside this file,
//        design/shell/predicate-type-resolution.md, caps.decl,
//        STATUS.md, and the parallel R226M2 scratch CHANGELOG.
//
// The 0x6400..0x64FF carve-out sits directly above R225.M9 proptest_hm
// (0x6100..0x61FF), R227.M6 version_pragma (0x6200..0x62FF), and the
// reserved 0x6300..0x63FF slice held for the parallel R225.M10 arm.
// The next kilo-step band 0x6500..0x65FF stays reserved for a future
// R226.M3 (bottom-up evaluator) landing when it comes.
//
//   PT_OK                      = 0        operation succeeded.
//   PT_ERR_BAD_PTR             = 0x6400   NULL pointer where a non-NULL
//                                         pointer was required (name_ptr
//                                         == 0 on _pt_register or
//                                         _pt_lookup; out_record_ptr == 0
//                                         on _pt_lookup; predicate_record
//                                         == 0 on _pt_check_call).
//   PT_ERR_BAD_NAME            = 0x6401   name_len == 0 or name_len > 16.
//   PT_ERR_BAD_ARITY           = 0x6402   arity > PT_MAX_ARITY (32) on
//                                         _pt_register.
//   PT_ERR_POOL_FULL           = 0x6403   _pt_predicate_count ==
//                                         PT_POOL_SLOTS (128); no room
//                                         for a new predicate.
//   PT_ERR_BAD_TYPE_CODE       = 0x6404   arg_type_codes[i] not in the
//                                         SS_TYPE_* set OR PT_TYPE_VAR /
//                                         PT_TYPE_WILD on _pt_register
//                                         or _pt_check_call.
//   PT_ERR_ARITY_MISMATCH      = 0x6410   call-site arity != predicate
//                                         arity (E0900).
//   PT_ERR_TYPE_MISMATCH       = 0x6411   call-site type code at some
//                                         position differs from the
//                                         predicate's signature (E0901).
//   PT_ERR_UNKNOWN_PREDICATE   = 0x6412   _pt_lookup: no record with
//                                         matching name_hash (E0902).
//   PT_ERR_BAD_RECORD          = 0x6413   _pt_check_call: record magic
//                                         at [+0] != 'PRTY'.
//
// Slots 0x6405..0x640F reserved for M2.1+ register/lookup diagnostics;
// 0x6414..0x64FF reserved for M2.2+ check-call diagnostics (per-position
// subsumption rule refinement, implicit-coercion warn-level, open-world
// unknown-predicate relax).
//
// E09NN diagnostic family mapping (per the §15 diagnostic register):
//
//   E0900_PREDICATE_ARITY         <-> PT_ERR_ARITY_MISMATCH   (0x6410)
//   E0901_PREDICATE_TYPE_MISMATCH <-> PT_ERR_TYPE_MISMATCH    (0x6411)
//   E0902_PREDICATE_UNKNOWN       <-> PT_ERR_UNKNOWN_PREDICATE (0x6412)
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R226.M1 Datalog parser (datalog.pdx)
//     The caller feeds `_dl_parse` output's per-head and per-body-atom
//     predicate name spans + per-term classifier codes into this
//     module's `_pt_register` and `_pt_check_call` entry points. No
//     direct call from THIS module into datalog.pdx (parser is pure);
//     the caller stitches the two layers.
//
//   R222.M1 SchemasSig (schemas_sig.pdx)
//     The type codes in _pt_predicates's arg_type_codes[] field reuse
//     the SS_TYPE_* numbering 1..9 verbatim so a schema-registry
//     declaration can be fed into _pt_register with no translation.
//     PT_TYPE_VAR (= 10) and PT_TYPE_WILD (= 11) are the parser-tier
//     M2 extensions that only exist on the datalog-call side.
//
//   R220.M4 schema registry (kernel-side; NOT yet landed)
//     At R226.M2 the registry wire-up is deferred: there is no live
//     kernel-side predicate catalogue yet. The elaborator is expected
//     to AUTO-REGISTER every predicate on first-use, treating every
//     predicate as "user-defined" by stamping PT_FLAG_USER_DEFINED on
//     the record. The post-R220.M4 landing will add a startup pass
//     that pre-registers the kernel-known predicates with the schema-
//     registry's type codes (and clears PT_FLAG_USER_DEFINED). The
//     public API is stable across that change.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the only mask we need is `and r, 0xFFFF`
//     (imm32-safe) for the u16 flags read; otherwise shift pairs.
//   - No 2-op `imul r, imm` -- the 64-byte pool stride is `shl r, 6`;
//     FNV-1a 64 multiply uses the one-op `mul rcx` form (shape
//     identical to _cmd_sig_fnv1a64, _cmdreg_fnv1a64, _fi_fnv1a64).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `PredicateTypes` matches `predicate_types.pdx`.
//   - Labels prefixed `pt_` (unique against every landed parser-tier
//     label prefix: u8n_, gi_, wp_, cl_, ast_, sm_, fh_, sch_sig_,
//     cmd_sig_, fi_, afs_, cmdreg_, dm_, ds_, pl_, pl_lam_, rp_, fo_,
//     sgr_, ws_, ha_, st_, ll_, cc_, er_, cr_, ls_, lp_, hm_, rt_,
//     eu_, dl_, se_, te_, jc_, h_, le_, vi_, ml_, ir_, rc_, rd_, dr_,
//     lc_, lh_, tf_, mf_, vp_, pth_). Per-function suffix: `pt_ini_`
//     init, `pt_reg_` register, `pt_lk_` lookup, `pt_cc_` check-call,
//     `pt_fnv_` FNV helper. Never bare `loop`/`if`/`let`/`fn`/`ret`/
//     `done` (paideia-as reserved keywords).
//   - All `cmp reg, imm` immediates (0, 1, 2, 16, 32, 48, 64, 128,
//     0x6400..0x6413, 0x59545250) fit imm32 with bit 31 clear so
//     direct cmp-imm32 is sign-safe. No MOVABS staging.
//   - Byte loads via `xor r,r; mov_b r,[addr + idx * 1]` (zero-extends
//     into the full qword; paideia-as #1248 + U1606 mitigation;
//     explicit *1 scale per libpdx-pds-parser Pipeline / libpdx-audit
//     precedent).
//   - u32 stores via `mov_d`; u16 stores via two `mov_b` byte stores
//     (low, high); u64 stores via plain `mov [dst], rax`.
//   - u8 stores via `mov_b [dst], rN`.
//   - Cross-module .bss writes via `lea r11, [rip + sym]; mov [r11], rax`
//     (precedent: hm_core.pdx _hm_pool_next, cmd_registry.pdx
//     _cmdreg_count_system).
//   - `_pt_init` is pure leaf (no CALL). `_pt_register` and
//     `_pt_lookup` each CALL `_pt_init` (lazy boot) and `_pt_fnv1a64`.
//     Both have 6-push callee-save frames + sub rsp pad for
//     rsp%16==0 at every nested CALL. `_pt_check_call` is a pure leaf
//     (no CALL). `_pt_fnv1a64` is a pure leaf.
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R226.M2.1  Open-world catalogue (set PT_FLAG_OPEN_WORLD bit when
//              a predicate is pre-declared with no body on first use;
//              distinguishes "declared but never used" from "used
//              before declared").
//   R226.M2.2  Subsumption rule refinement: PT_TYPE_HASH32 should
//              implicitly subsume PT_TYPE_U64 at call-sites (both are
//              8-byte scalars; the hash32 is a 32-bit value stored in
//              a u64 slot).
//   R226.M3    Bottom-up semi-naive evaluator: consumes this module's
//              `_pt_lookup` and `_pt_check_call` as the type-arrival
//              gate before firing a fixpoint delta.
//   R226.M9    Query-time type-check: the per-query planner calls
//              `_pt_check_call` once per body atom and once per head
//              atom at plan time; errors become E09NN diagnostics.
//   R220.M4    Schema-registry wire-up: a startup pass pre-registers
//              the kernel-known predicates with their SchemasSig type
//              codes, clearing PT_FLAG_USER_DEFINED on each entry.
//
// =============================================================================
// Upstream: paideia-os#2490 (R226 umbrella), paideia-os#2693 (THIS
// ticket, R226.M2). Substrate: paideia-os#2692 (R226.M1 Datalog
// parser), paideia-os#2658 (R222.M1 SchemasSig type codes),
// paideia-os#2682 (R225.M1 HmCore type-graph pool -- cross-reference
// only; no linker dep at raw M2). Design doc:
// design/shell/predicate-type-resolution.md.

module PredicateTypes = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Band 0x6400..0x64FF, reserved for the R226.M2 predicate-type
  // resolution substrate. Disjoint from every prior landed satellite
  // band. The 0x6300..0x63FF slice is held for the parallel R225.M10
  // per-turn fingerprint arm (not yet landed).

  pub let PT_OK                       : u64 = 0
  pub let PT_ERR_BAD_PTR              : u64 = 0x6400
  pub let PT_ERR_BAD_NAME             : u64 = 0x6401
  pub let PT_ERR_BAD_ARITY            : u64 = 0x6402
  pub let PT_ERR_POOL_FULL            : u64 = 0x6403
  pub let PT_ERR_BAD_TYPE_CODE        : u64 = 0x6404
  pub let PT_ERR_ARITY_MISMATCH       : u64 = 0x6410
  pub let PT_ERR_TYPE_MISMATCH        : u64 = 0x6411
  pub let PT_ERR_UNKNOWN_PREDICATE    : u64 = 0x6412
  pub let PT_ERR_BAD_RECORD           : u64 = 0x6413

  // ==========================================================================
  // SECTION 2 -- RECORD / POOL LAYOUT CONSTANTS
  // ==========================================================================

  pub let PT_RECORD_BYTES             : u64 = 64
  pub let PT_POOL_SLOTS               : u64 = 128
  pub let PT_POOL_BYTES               : u64 = 8192     // 128 * 64
  pub let PT_NAME_MAX                 : u64 = 16
  pub let PT_MAX_ARITY                : u64 = 32

  // Magic: 'PRTY' little-endian = 0x59545250. Reads as the 4-byte
  // ASCII string "PRTY" in a hex dump (bytes 50 52 54 59).
  pub let PT_RECORD_MAGIC             : u64 = 0x59545250

  // Record field offsets.
  pub let PT_OFF_MAGIC                : u64 = 0        // u32
  pub let PT_OFF_ARITY                : u64 = 4        // u16
  pub let PT_OFF_FLAGS                : u64 = 6        // u16
  pub let PT_OFF_NAME_HASH            : u64 = 8        // u64
  pub let PT_OFF_NAME_INLINE          : u64 = 16       // u8[16]
  pub let PT_OFF_ARG_TYPE_CODES       : u64 = 32       // u8[32]

  // Flag bits in the `flags` u16 at [record + 6].
  pub let PT_FLAG_USER_DEFINED        : u64 = 0x0001

  // Parser-tier type-code extensions beyond the SS_TYPE_* set.
  // These are only used on the per-position arg_type_codes[] of a
  // predicate signature OR of a call-site; they do NOT appear in a
  // schema-registry declaration.
  pub let PT_TYPE_VAR                 : u64 = 10
  pub let PT_TYPE_WILD                : u64 = 11

  // The maximum type-code we accept at _pt_register and _pt_check_call.
  // Codes 0 (SS_TYPE_END) and 7 (reserved SF_TYPE_IMAGE slot) are
  // explicitly disallowed as arg_type_codes[i] inputs.
  pub let PT_TYPE_CODE_MAX            : u64 = 11

  // ==========================================================================
  // SECTION 3 -- STATIC STATE (.bss, singleton)
  // ==========================================================================

  pub let mut _pt_predicates          : [u8; 8192] = uninit @align(8)
  pub let mut _pt_predicate_count     : u64        = uninit @align(8)
  pub let mut _pt_init_state          : u64        = uninit @align(8)

  // ==========================================================================
  // _pt_fnv1a64(ptr, len) -> u64 hash
  //
  //   rdi = ptr
  //   rsi = len
  //   rax = FNV-1a 64 hash
  //
  // Byte-for-byte mirror of R222.M2's _cmd_sig_fnv1a64 (offset basis
  // 0xCBF29CE484222325, prime 0x100000001B3). Replicated so the module
  // links standalone -- the four parser-family FNV leaves
  // (_cmd_sig_fnv1a64, _fi_fnv1a64, _cmdreg_fnv1a64, _ha_fnv1a64, and
  // now _pt_fnv1a64) live in disjoint linker namespaces but produce
  // byte-identical hashes for byte-identical inputs so a downstream
  // consumer may compare name_hash values across families.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pt_fnv_.
  // ==========================================================================
  pub let _pt_fnv1a64 : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M2 (#2693): FNV-1a 64 hash over [ptr, ptr+len). Pure leaf; zero pushes; no stack frame; no nested CALL. Load offset basis 0xCBF29CE484222325 (imm64) into rax; load fnv_prime 0x100000001B3 (imm64) into rcx held across the loop. For each byte: zero-extend byte load into r11 via `xor r11,r11; mov_b r11,[r8+r10*1]`; xor r11 into rax; xor rdx,rdx to clear the mul high half; `mul rcx` -> rdx:rax = rax * fnv_prime, keep low 64 in rax. Advance r10 by 1; loop. Terminates on r10 >= r9. Zero-length input returns offset basis unchanged (standard FNV behaviour). Byte-for-byte identical to command_sig.pdx _cmd_sig_fnv1a64, cmd_registry.pdx _cmdreg_fnv1a64, functor_instance.pdx _fi_fnv1a64, and hostname_annot.pdx _ha_fnv1a64. The one-op `mul rcx` form is distinct from the pitfall-listed 2-op `imul r,imm`. All cmp immediates are 0 (i < len via jae). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pt_fnv_.",
      block: {
        mov r8, rdi;                           // r8 = ptr
        mov r9, rsi;                           // r9 = len
        mov rax, 0xCBF29CE484222325;           // h = fnv_offset_basis
        mov rcx, 0x100000001B3;                // fnv_prime
        xor r10, r10;                          // i = 0

      pt_fnv_loop:
        cmp r10, r9;
        jae pt_fnv_done;

        xor r11, r11;
        mov_b r11, [r8 + r10 * 1];
        xor rax, r11;

        xor rdx, rdx;
        mul rcx;

        add r10, 1;
        jmp pt_fnv_loop;

      pt_fnv_done:
        ret;
      }
    }

  // ==========================================================================
  // _pt_init() -> ()
  //
  //   Zero-fills _pt_predicates (8192 bytes, u64 steps of 8 -> 1024
  //   iterations), clears _pt_predicate_count. Idempotent via the
  //   sentinel _pt_init_state (0 = not initialised, 1 = initialised).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pt_ini_.
  // ==========================================================================
  pub let _pt_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M2 (#2693): _pt_init zero-fills the 8192 B pool (128 slots x 64 B stride) and clears the counter. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Idempotency: load _pt_init_state via `lea r11,[rip+_pt_init_state]; mov rax,[r11]`; if rax != 0 return. Else loop i in 0..8192 stepping by 8, writing 0 to _pt_predicates[i] via `lea r9,[rip+_pt_predicates]; mov r10,r9; add r10,rcx; mov [r10], rax` (rax=0). Then clear _pt_predicate_count via `lea r11,[rip+_pt_predicate_count]; mov [r11], 0`. Finally set _pt_init_state := 1. All cmp immediates (0, 1, 8192) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pt_ini_.",
      block: {
        // Idempotency check.
        lea r11, [rip + _pt_init_state];
        mov rax, [r11];
        cmp rax, 0;
        jne pt_ini_done;

        // Zero-fill _pt_predicates by u64 stride (1024 iterations).
        lea r9, [rip + _pt_predicates];
        xor rcx, rcx;                          // i = 0

      pt_ini_zero_loop:
        cmp rcx, 8192;
        jae pt_ini_clear_count;
        mov r10, r9;
        add r10, rcx;
        xor rax, rax;
        mov [r10], rax;
        add rcx, 8;
        jmp pt_ini_zero_loop;

      pt_ini_clear_count:
        xor rax, rax;
        lea r11, [rip + _pt_predicate_count];
        mov [r11], rax;

        // Mark initialised.
        mov rax, 1;
        lea r11, [rip + _pt_init_state];
        mov [r11], rax;

      pt_ini_done:
        ret;
      }
    }

  // ==========================================================================
  // _pt_register(name_ptr, name_len, arity, arg_types_ptr, flags) -> errno
  //
  //   rdi = name_ptr
  //   rsi = name_len
  //   rdx = arity
  //   rcx = arg_types_ptr   (may be NULL iff arity == 0)
  //   r8  = flags           (low 16 bits honoured)
  //   rax = PT_OK | PT_ERR_*
  //
  // Flow:
  //   1. Validate name_ptr != 0 (PT_ERR_BAD_PTR).
  //   2. Validate name_len in [1..PT_NAME_MAX] (PT_ERR_BAD_NAME).
  //   3. Validate arity <= PT_MAX_ARITY (PT_ERR_BAD_ARITY).
  //   4. If arity > 0, validate arg_types_ptr != 0 (PT_ERR_BAD_PTR) and
  //      validate every arg_types[i] in {1..6, 8, 9, 10, 11}
  //      (PT_ERR_BAD_TYPE_CODE).
  //   5. Call _pt_init (idempotent lazy boot).
  //   6. Compute name_hash = FNV-1a 64(name_ptr, name_len).
  //   7. Linear-scan _pt_predicates[0 .. _pt_predicate_count); if a
  //      record with name_hash matches at [+8], return PT_OK (idempotent
  //      re-register).
  //   8. If _pt_predicate_count == PT_POOL_SLOTS, return PT_ERR_POOL_FULL.
  //   9. Else allocate slot [_pt_predicate_count], zero-fill 64 bytes,
  //      stamp magic + arity + flags + name_hash + name_inline (zero-
  //      padded) + arg_type_codes (zero-padded).
  //  10. Bump _pt_predicate_count. Return PT_OK.
  //
  // Frame: 6 callee-save pushes (rbx=name_ptr, rbp=name_len, r12=arity,
  // r13=arg_types_ptr, r14=flags, r15=name_hash) + `sub rsp, 40` (5
  // scratch slots: [+0] slot_idx, [+8] i, [+16] entry_addr, [+24] pad).
  // Entry rsp%16==8, +48 pushes = %16==8, +40 scratch = %16==0 steady
  // at every nested CALL. Nested CALLs: _pt_init, _pt_fnv1a64.
  //
  // Labels prefixed pt_reg_.
  // ==========================================================================
  pub let _pt_register : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) (arity: u64) (arg_types_ptr: u64) (flags: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M2 (#2693): _pt_register inserts a new PredicateRecord into _pt_predicates OR returns PT_OK if a matching record already exists (idempotent re-register). 6 callee-save pushes (rbx=name_ptr, rbp=name_len, r12=arity, r13=arg_types_ptr, r14=flags, r15=name_hash) + `sub rsp, 40` scratch frame = 88 B. Entry rsp%16==8, after 6 pushes %16==8, +40 scratch = rsp%16==0 at every nested CALL to _pt_init and _pt_fnv1a64. Flow: (1) validate name_ptr != 0 (BAD_PTR 0x6400); (2) name_len in [1..16] (BAD_NAME 0x6401); (3) arity <= 32 (BAD_ARITY 0x6402); (4) if arity > 0, validate arg_types_ptr != 0 (BAD_PTR) and loop i in 0..arity validating arg_types[i] in {1..6, 8..11} (BAD_TYPE_CODE 0x6404); (5) call _pt_init; (6) call _pt_fnv1a64 -> r15 = name_hash; (7) linear scan existing records -- for i in 0.._pt_predicate_count, entry_addr = _pt_predicates + i*64, load u64 at [entry+8], compare with r15, if match return PT_OK; (8) if _pt_predicate_count == 128 return POOL_FULL (0x6403); (9) allocate slot [count], zero-fill 64 bytes via eight u64 stores, stamp u32 magic 0x59545250 at [+0], u16 arity at [+4] (two mov_b), u16 flags & 0xFFFF at [+6] (two mov_b), u64 name_hash at [+8], 16-byte name_inline byte-copy at [+16..+32] zero-padded, arg_type_codes byte-copy at [+32..+32+arity] zero-padded. (10) Bump _pt_predicate_count. Byte load via `mov_b rN,[addr + idx * 1]`; u32 store via `mov_d`; u16 store via two mov_b; u64 store via plain mov; stride multiply via `shl r, 6`. All cmp immediates (0, 1, 2, 6, 7, 8, 11, 12, 16, 32, 64, 128, 0xFFFF, 0x59545250, 0x6400..0x6404) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed pt_reg_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;                          // 8 mod 16 after 6 pushes -> 0 mod 16 at CALL (was 32: misaligned)

        mov rbx, rdi;                          // name_ptr
        mov rbp, rsi;                          // name_len
        mov r12, rdx;                          // arity
        mov r13, rcx;                          // arg_types_ptr
        mov r14, r8;                           // flags
        xor r15, r15;                          // name_hash (computed later)

        // (1) Validate name_ptr != 0.
        cmp rbx, 0;
        je  pt_reg_bad_ptr;

        // (2) Validate name_len in [1..16].
        cmp rbp, 0;
        je  pt_reg_bad_name;
        cmp rbp, 16;
        ja  pt_reg_bad_name;

        // (3) Validate arity <= 32.
        cmp r12, 32;
        ja  pt_reg_bad_arity;

        // (4) If arity > 0, validate arg_types_ptr != 0.
        cmp r12, 0;
        je  pt_reg_skip_type_check;
        cmp r13, 0;
        je  pt_reg_bad_ptr;

        // Validate each arg_type_codes[i] in {1..6, 8..11}.
        xor rcx, rcx;                          // i = 0
      pt_reg_type_check_loop:
        cmp rcx, r12;
        jae pt_reg_skip_type_check;
        xor rax, rax;
        mov_b rax, [r13 + rcx * 1];
        // 0 (SS_TYPE_END) and 7 (reserved SF_TYPE_IMAGE) are disallowed.
        cmp rax, 0;
        je  pt_reg_bad_type_code;
        cmp rax, 7;
        je  pt_reg_bad_type_code;
        cmp rax, 11;                           // PT_TYPE_CODE_MAX
        ja  pt_reg_bad_type_code;
        add rcx, 1;
        jmp pt_reg_type_check_loop;

      pt_reg_skip_type_check:
        // (5) Lazy init.
        call _pt_init;

        // (6) Compute name_hash.
        mov rdi, rbx;
        mov rsi, rbp;
        call _pt_fnv1a64;
        mov r15, rax;                          // r15 = name_hash

        // (7) Linear-scan existing records for an existing name_hash match.
        xor rcx, rcx;                          // i = 0
        mov [rsp + 8], rcx;                    // scratch[i]

      pt_reg_scan_loop:
        lea r11, [rip + _pt_predicate_count];
        mov rax, [r11];
        mov rcx, [rsp + 8];
        cmp rcx, rax;
        jae pt_reg_scan_done;

        // entry_addr = _pt_predicates + i * 64.
        mov r9, rcx;
        shl r9, 6;
        lea r11, [rip + _pt_predicates];
        add r9, r11;
        mov [rsp + 16], r9;                    // scratch[entry_addr]

        // Compare u64 name_hash at [entry + 8] with r15.
        mov rax, [r9 + 8];
        cmp rax, r15;
        je  pt_reg_idempotent_hit;

        // Advance.
        mov rcx, [rsp + 8];
        add rcx, 1;
        mov [rsp + 8], rcx;
        jmp pt_reg_scan_loop;

      pt_reg_scan_done:
        // (8) Pool-full check.
        lea r11, [rip + _pt_predicate_count];
        mov rax, [r11];
        cmp rax, 128;                          // PT_POOL_SLOTS
        jae pt_reg_pool_full;

        // (9) Allocate slot: entry_addr = _pt_predicates + count * 64.
        mov r9, rax;
        shl r9, 6;
        lea r11, [rip + _pt_predicates];
        add r9, r11;
        mov [rsp + 16], r9;                    // scratch[entry_addr]

        // Zero-fill the 64-byte slot via eight u64 stores.
        xor rax, rax;
        mov [r9 +  0], rax;
        mov [r9 +  8], rax;
        mov [r9 + 16], rax;
        mov [r9 + 24], rax;
        mov [r9 + 32], rax;
        mov [r9 + 40], rax;
        mov [r9 + 48], rax;
        mov [r9 + 56], rax;

        // Stamp u32 magic at [+0].
        mov rax, 0x59545250;                   // PT_RECORD_MAGIC
        mov_d [r9 + 0], rax;

        // Stamp u16 arity at [+4] (two byte stores: low, high).
        mov rax, r12;
        mov_b [r9 + 4], rax;
        shr rax, 8;
        mov_b [r9 + 5], rax;

        // Stamp u16 flags at [+6] (two byte stores: low, high). Mask
        // via `shl r, 48; shr r, 48` to isolate the low 16 bits (no
        // and-imm64; the imm 0xFFFF would be imm32-safe but shift-pair
        // is a clean idiom and parallel to row_types.pdx's 32-bit
        // isolation shape).
        mov rax, r14;
        shl rax, 48;
        shr rax, 48;
        mov_b [r9 + 6], rax;
        shr rax, 8;
        mov_b [r9 + 7], rax;

        // Stamp u64 name_hash at [+8].
        mov [r9 + 8], r15;

        // Byte-copy name_inline at [+16..+32]: copy name_len bytes
        // from [rbx], rest left zero from the zero-fill above.
        xor rcx, rcx;                          // i = 0
      pt_reg_copy_name_loop:
        cmp rcx, rbp;
        jae pt_reg_copy_name_done;
        xor rax, rax;
        mov_b rax, [rbx + rcx * 1];
        mov r10, r9;
        add r10, rcx;
        mov_b [r10 + 16], rax;
        add rcx, 1;
        jmp pt_reg_copy_name_loop;

      pt_reg_copy_name_done:
        // Byte-copy arg_type_codes at [+32..+32+arity]: copy arity
        // bytes from [r13]; rest zero from the zero-fill.
        cmp r12, 0;
        je  pt_reg_bump_count;

        xor rcx, rcx;                          // i = 0
      pt_reg_copy_types_loop:
        cmp rcx, r12;
        jae pt_reg_bump_count;
        xor rax, rax;
        mov_b rax, [r13 + rcx * 1];
        mov r10, r9;
        add r10, rcx;
        mov_b [r10 + 32], rax;
        add rcx, 1;
        jmp pt_reg_copy_types_loop;

      pt_reg_bump_count:
        // (10) Bump _pt_predicate_count.
        lea r11, [rip + _pt_predicate_count];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        xor rax, rax;                          // PT_OK
        jmp pt_reg_epilogue;

      pt_reg_idempotent_hit:
        xor rax, rax;                          // PT_OK (idempotent)
        jmp pt_reg_epilogue;

      pt_reg_bad_ptr:
        mov rax, 0x6400;
        jmp pt_reg_epilogue;

      pt_reg_bad_name:
        mov rax, 0x6401;
        jmp pt_reg_epilogue;

      pt_reg_bad_arity:
        mov rax, 0x6402;
        jmp pt_reg_epilogue;

      pt_reg_pool_full:
        mov rax, 0x6403;
        jmp pt_reg_epilogue;

      pt_reg_bad_type_code:
        mov rax, 0x6404;
        jmp pt_reg_epilogue;

      pt_reg_epilogue:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _pt_lookup(name_ptr, name_len, out_record_ptr) -> errno
  //
  //   rdi = name_ptr
  //   rsi = name_len
  //   rdx = out_record_ptr   (64-byte caller-owned scratch)
  //   rax = PT_OK | PT_ERR_*
  //
  // Flow:
  //   1. Validate name_ptr != 0, out_record_ptr != 0 (PT_ERR_BAD_PTR).
  //   2. Validate name_len in [1..PT_NAME_MAX] (PT_ERR_BAD_NAME).
  //   3. Zero-fill 64 bytes at out_record_ptr via 8 u64 stores
  //      (defensive: a miss still returns a well-defined record).
  //   4. Call _pt_init (idempotent).
  //   5. Compute name_hash.
  //   6. Linear-scan _pt_predicates[0 .. _pt_predicate_count); on match,
  //      byte-copy the 64-byte record into out_record_ptr and return
  //      PT_OK. On exhausted scan, return PT_ERR_UNKNOWN_PREDICATE.
  //
  // Frame: 5 callee-save pushes (rbx=name_ptr, rbp=name_len,
  // r12=out_record_ptr, r13=name_hash, r14=i) + `sub rsp, 8` pad.
  // Entry rsp%16==8, +40 pushes = %16==0, +8 pad = %16==8 (misaligned
  // -- doubled to +16 would be clean; use 6 pushes + sub rsp,8 instead
  // for %16==0 at the nested CALLs). Chosen frame: 6 callee-save
  // pushes (rbx, rbp, r12, r13, r14, r15=entry_addr scratch) + `sub rsp,
  // 8` pad -> entry %16==8, +48 pushes = %16==8, +8 pad = %16==0.
  //
  // Labels prefixed pt_lk_.
  // ==========================================================================
  pub let _pt_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) (out_record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M2 (#2693): _pt_lookup resolves a predicate by name and copies its 64-byte record into out_record_ptr on hit, or writes 64 zero bytes and returns PT_ERR_UNKNOWN_PREDICATE on miss. 6 callee-save pushes (rbx=name_ptr, rbp=name_len, r12=out_record_ptr, r13=name_hash, r14=i, r15=entry_addr scratch) + `sub rsp, 8` pad = 56 B frame. Entry rsp%16==8, after 6 pushes %16==8, +8 pad = rsp%16==0 at every nested CALL to _pt_init and _pt_fnv1a64. Flow: (1) validate name_ptr != 0 AND out_record_ptr != 0 (BAD_PTR 0x6400); (2) name_len in [1..16] (BAD_NAME 0x6401); (3) zero-fill 64 bytes at out_record_ptr via eight u64 stores; (4) call _pt_init; (5) call _pt_fnv1a64 -> r13 = name_hash; (6) linear scan: for i in 0.._pt_predicate_count, entry_addr = _pt_predicates + i*64 (via shl 6 + lea + add), load u64 at [entry+8], compare with r13; on hit byte-copy 64 bytes to out_record_ptr via eight u64 loads+stores and return PT_OK; on scan exhaustion return PT_ERR_UNKNOWN_PREDICATE (0x6412). The defensive zero-fill BEFORE the scan guarantees out_record_ptr holds a well-defined zero record on every miss path. Byte-copy via `mov rax, [src+off]; mov [dst+off], rax` eight times (eight u64 steps = 64 bytes). All cmp immediates (0, 1, 8, 16, 56, 64, 0x6400, 0x6401, 0x6412) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm (stride via shl 6); no multiline let. Labels prefixed pt_lk_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // name_ptr
        mov rbp, rsi;                          // name_len
        mov r12, rdx;                          // out_record_ptr
        xor r13, r13;                          // name_hash (computed later)
        xor r14, r14;                          // i = 0

        // (1) Validate name_ptr != 0 AND out_record_ptr != 0.
        cmp rbx, 0;
        je  pt_lk_bad_ptr;
        cmp r12, 0;
        je  pt_lk_bad_ptr;

        // (2) Validate name_len in [1..16].
        cmp rbp, 0;
        je  pt_lk_bad_name;
        cmp rbp, 16;
        ja  pt_lk_bad_name;

        // (3) Zero-fill 64 bytes at out_record_ptr via 8 u64 stores.
        xor rax, rax;
        mov [r12 +  0], rax;
        mov [r12 +  8], rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;
        mov [r12 + 32], rax;
        mov [r12 + 40], rax;
        mov [r12 + 48], rax;
        mov [r12 + 56], rax;

        // (4) Lazy init.
        call _pt_init;

        // (5) Compute name_hash.
        mov rdi, rbx;
        mov rsi, rbp;
        call _pt_fnv1a64;
        mov r13, rax;

        // (6) Linear scan.
        xor r14, r14;                          // i = 0

      pt_lk_scan_loop:
        lea r11, [rip + _pt_predicate_count];
        mov rax, [r11];
        cmp r14, rax;
        jae pt_lk_not_found;

        // entry_addr = _pt_predicates + i * 64.
        mov r15, r14;
        shl r15, 6;
        lea r11, [rip + _pt_predicates];
        add r15, r11;

        // Compare u64 name_hash at [entry + 8].
        mov rax, [r15 + 8];
        cmp rax, r13;
        je  pt_lk_hit;

        add r14, 1;
        jmp pt_lk_scan_loop;

      pt_lk_hit:
        // Byte-copy 64 bytes from entry (r15) to out_record_ptr (r12)
        // via eight u64 loads+stores.
        mov rax, [r15 +  0];
        mov [r12 +  0], rax;
        mov rax, [r15 +  8];
        mov [r12 +  8], rax;
        mov rax, [r15 + 16];
        mov [r12 + 16], rax;
        mov rax, [r15 + 24];
        mov [r12 + 24], rax;
        mov rax, [r15 + 32];
        mov [r12 + 32], rax;
        mov rax, [r15 + 40];
        mov [r12 + 40], rax;
        mov rax, [r15 + 48];
        mov [r12 + 48], rax;
        mov rax, [r15 + 56];
        mov [r12 + 56], rax;

        xor rax, rax;                          // PT_OK
        jmp pt_lk_epilogue;

      pt_lk_not_found:
        mov rax, 0x6412;                       // PT_ERR_UNKNOWN_PREDICATE
        jmp pt_lk_epilogue;

      pt_lk_bad_ptr:
        mov rax, 0x6400;
        jmp pt_lk_epilogue;

      pt_lk_bad_name:
        mov rax, 0x6401;
        jmp pt_lk_epilogue;

      pt_lk_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _pt_check_call(predicate_record, actual_args_ptr, actual_n_args,
  //                actual_type_codes) -> status
  //
  //   rdi = predicate_record    (ptr to a 64-byte PredicateRecord)
  //   rsi = actual_args_ptr     (opaque; reserved for M3+ -- unused at
  //                              raw M2 but kept in the signature so
  //                              M3+ can attach per-position source
  //                              spans without an ABI break)
  //   rdx = actual_n_args
  //   rcx = actual_type_codes   (ptr to actual_n_args bytes)
  //   rax = PT_OK | PT_ERR_*
  //
  // Flow:
  //   1. Validate predicate_record != 0 (PT_ERR_BAD_PTR). If
  //      actual_n_args > 0, validate actual_type_codes != 0
  //      (PT_ERR_BAD_PTR).
  //   2. Validate magic u32 at [record + 0] == 'PRTY' (PT_ERR_BAD_RECORD).
  //   3. Load u16 arity at [record + 4]; compare with actual_n_args.
  //      Mismatch -> PT_ERR_ARITY_MISMATCH (E0900).
  //   4. For i in 0..arity:
  //        expected = record.arg_type_codes[i]  = [record + 32 + i]
  //        actual   = actual_type_codes[i]     = [rcx + i]
  //        If expected == PT_TYPE_VAR OR expected == PT_TYPE_WILD OR
  //           actual   == PT_TYPE_VAR OR actual   == PT_TYPE_WILD:
  //             match (both wildcard sides compatible with any ground).
  //        Else if expected == actual: match.
  //        Else PT_ERR_TYPE_MISMATCH (E0901).
  //   5. Return PT_OK.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed pt_cc_.
  //
  // The pure-leaf shape intentionally avoids the FNV call: the caller
  // has ALREADY resolved the predicate (via _pt_lookup or via a direct
  // pool pointer) before entering this entry, so the hash computation
  // belongs on the lookup side, not the check side.
  // ==========================================================================
  pub let _pt_check_call : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (predicate_record: u64) (actual_args_ptr: u64) (actual_n_args: u64) (actual_type_codes: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser R226.M2 (#2693): _pt_check_call validates a call-site's arity and per-position type codes against a predicate's resolved signature. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Entry rsp%16==8 (standard SysV; no pushes so stays at 8; no CALL fires, so no alignment constraint on the body). Flow: (1) validate rdi != 0 (BAD_PTR 0x6400); if rdx > 0 validate rcx != 0 (BAD_PTR); (2) load u32 magic via `xor rax,rax; mov_d rax,[rdi+0]`; compare with 0x59545250, mismatch -> BAD_RECORD (0x6413); (3) load u16 arity via two mov_b: `xor rax,rax; mov_b rax,[rdi+4]; xor r8,r8; mov_b r8,[rdi+5]; shl r8,8; or rax,r8`; compare with rdx, mismatch -> ARITY_MISMATCH (0x6410); (4) for i in 0..arity, load expected byte via `xor r9,r9; mov_b r9,[rdi + i + 32]` (computed as `mov r10, rdi; add r10, i; add r10, 32; xor r9,r9; mov_b r9,[r10]`, OR via `[rdi + i*1 + 32]` three-term... but libpdx-pds-parser avoids three-term addressing per the encoder-pitfalls note, so a precompute of the address is used). Load actual byte at [rcx + i]. If expected in {10 PT_TYPE_VAR, 11 PT_TYPE_WILD} match; else if actual in {10, 11} match; else if expected == actual match; else TYPE_MISMATCH (0x6411). (5) return PT_OK (0). All cmp immediates (0, 10, 11, 32, 0x59545250, 0x6400, 0x6410, 0x6411, 0x6413) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let; no three-term addressing. Labels prefixed pt_cc_.",
      block: {
        // (1) Validate predicate_record != 0.
        cmp rdi, 0;
        je  pt_cc_bad_ptr;

        // If actual_n_args > 0, validate actual_type_codes != 0.
        cmp rdx, 0;
        je  pt_cc_check_magic;
        cmp rcx, 0;
        je  pt_cc_bad_ptr;

      pt_cc_check_magic:
        // (2) Load u32 magic at [record + 0]; compare with 'PRTY'.
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x59545250;                   // PT_RECORD_MAGIC
        jne pt_cc_bad_record;

        // (3) Load u16 arity at [record + 4]: low byte + high byte << 8.
        xor rax, rax;
        mov_b rax, [rdi + 4];
        xor r8, r8;
        mov_b r8, [rdi + 5];
        shl r8, 8;
        or  rax, r8;
        // Compare with actual_n_args.
        cmp rax, rdx;
        jne pt_cc_arity_mismatch;

        // (4) Loop i in 0..arity comparing per-position type codes.
        xor r11, r11;                          // i = 0

      pt_cc_type_loop:
        cmp r11, rdx;                          // i < arity
        jae pt_cc_ok;

        // expected = [record + 32 + i]. Precompute address.
        mov r10, rdi;
        add r10, r11;
        add r10, 32;
        xor r9, r9;
        mov_b r9, [r10];                       // r9 = expected

        // actual = [actual_type_codes + i].
        mov r10, rcx;
        add r10, r11;
        xor r8, r8;
        mov_b r8, [r10];                       // r8 = actual

        // Compatibility rule:
        //   expected == PT_TYPE_VAR (10)  -> match.
        //   expected == PT_TYPE_WILD (11) -> match.
        //   actual   == PT_TYPE_VAR  (10) -> match.
        //   actual   == PT_TYPE_WILD (11) -> match.
        //   expected == actual            -> match.
        //   else                           -> TYPE_MISMATCH.
        cmp r9, 10;
        je  pt_cc_type_match;
        cmp r9, 11;
        je  pt_cc_type_match;
        cmp r8, 10;
        je  pt_cc_type_match;
        cmp r8, 11;
        je  pt_cc_type_match;
        cmp r9, r8;
        je  pt_cc_type_match;

        jmp pt_cc_type_mismatch;

      pt_cc_type_match:
        add r11, 1;
        jmp pt_cc_type_loop;

      pt_cc_ok:
        xor rax, rax;                          // PT_OK
        ret;

      pt_cc_bad_ptr:
        mov rax, 0x6400;
        ret;

      pt_cc_bad_record:
        mov rax, 0x6413;
        ret;

      pt_cc_arity_mismatch:
        mov rax, 0x6410;
        ret;

      pt_cc_type_mismatch:
        mov rax, 0x6411;
        ret;
      }
    }

}
