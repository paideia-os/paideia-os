// src/describe_sig.pdx -- libpdx-pds-parser.R222.M8 (paideia-os#2665)
//
// DescribeSig: queryable DescriptorBlob serializer / deserializer for
// the `describe <cmd>` builtin and the "commands operating on X"
// semantic-query surface. R222.M8 of the cmd-functor umbrella.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R222.M1 (SchemasSig, Wave 113) declared the INPUT + OUTPUT record
// SHAPES. R222.M2 (CommandSig, Wave 116) declared the FUNCTOR IDENTITY
// block (name + caps + version + stability). R222.M3 (FunctorInstance,
// Wave 118) wired the two together at REPL prompt time. R222.M4
// (ArgFlagSpec, Wave 119) added the positional + named parameter
// signatures. R222.M5 (CmdRegistry, Wave 122) landed the per-session
// catalogue the four records index into. R222.M6 (DispatchMode, Wave
// 123) added the light-vs-heavy classifier. R222.M8 (THIS module)
// lands the SERIALIZATION surface the `describe <cmd>` builtin and the
// "commands operating on FileSchema" semantic-query consume.
//
// Per `design/terminal/semantic-shell.md` section 6.4:
//
//   > The shell's tab completion queries the registry for available
//   > commands. Each command's signature is the discovery surface:
//   > * Command name
//   > * Argument names + types
//   > * Flag names + types
//   > * Required capabilities
//   > * Help text
//   >
//   > This is the "semantically queryable" feature applied to commands
//   > themselves -- the user can ask the shell "what commands operate
//   > on PDFs?" and get a typed answer.
//
// The query surface is a flat 256-byte DescriptorBlob record. The
// record is DENORMALIZED from the authoritative CommandSig (R222.M2)
// so that `describe <cmd>` and `commands operating on <schema>` are
// O(1) INDEX LOOKUPS rather than requiring per-call reparse of the
// CommandSig body. The blob carries pre-computed bitmap fields
// (arg_type_mask, schema_hash_ids) that the query path matches
// against; a future landing (M8.1) will populate those bitmaps by
// folding ArgSpec (R222.M4) + SchemasSig (R222.M1) companion records
// at serialize time.
//
// Scope at M8:
//   * 256-byte DescriptorBlob layout (fixed, extensible via version u16)
//   * `_ds_serialize` populates the fields derivable from CommandSig
//     alone (magic, version, flags, name_hash, name_inline (truncated
//     32-B), cs_body_ref); leaves arg_type_mask / schema_hash_ids /
//     query_payload zero-filled for the M8.1 companion-signature folder
//   * `_ds_deserialize` validates the blob magic + version and extracts
//     the two load-bearing identity fields (cs_body_ref, name_hash)
//   * `_ds_matches_type` tests the pre-computed arg_type_mask bitmap
//     against a caller-supplied type_code (0..255); at raw M8 the mask
//     is zero so this returns 0 until M8.1 populates the field
//   * `_ds_matches_schema` scans the pre-computed schema_hash_ids list
//     for a caller-supplied schema_tag (1..255); at raw M8 the list is
//     empty so this returns 0 until M8.1 populates the field
//   * `_ds_init` is a bare `ret` -- M8 holds NO .bss state (the blob
//     is caller-owned on both the serialize and the deserialize paths);
//     the entry point is kept for parallelism with the DispatchMode /
//     CmdRegistry init hook family so a later landing that adds .bss
//     (e.g., per-session describe counters) does not break the API
//
// Out of scope at M8 (deferred):
//   * ArgSpec / FlagSpec folder into arg_type_mask (M8.1)
//   * SchemasSig folder into schema_hash_ids (M8.1)
//   * On-wire rendering of the DescriptorBlob into human-readable
//     text (the `describe <cmd>` builtin itself; the shell-side
//     consumer of this module)
//   * query_payload bitmap format (reserved, 128 bytes; the exact
//     predicate encoding stays undefined pending the semantic-query
//     DSL at R229+)
//   * cross-wave stability guarantees on the version field (bumped on
//     any wire-format change; version 1 is M8's commitment surface)
//
// =============================================================================
// WIRE FORMAT -- DescriptorBlob (256 B total)
// =============================================================================
//
//   offset size field               notes
//   ------ ---- ------------------- ----------------------------------
//     0x00  4   magic         u32   DS_BLOB_MAGIC ('DESC' LE
//                                    = 0x43534544). Reads as the four
//                                    ASCII bytes "DESC" sequentially.
//     0x04  2   version       u16   DS_BLOB_VERSION = 1.
//     0x06  2   flags         u16   low 16 bits of CS_FLAG_HAS_* copied
//                                    verbatim from CommandSigHeader+80.
//     0x08  8   name_hash     u64   FNV-1a 64 of the command name;
//                                    caller-supplied (computed via
//                                    _cmd_sig_fnv1a64 at the shell
//                                    layer; byte-identical across
//                                    R222.M2 / M3 / M5 / M8 FNV leaves).
//     0x10 32   name_inline[32] u8  First 32 bytes of CommandSig
//                                    name_inline[48] (truncated past
//                                    32; name_hash preserves full
//                                    identity for any name length up
//                                    to CS_NAME_MAX = 48).
//     0x30  2   arg_count     u16   0 at M8; M8.1 populates from
//                                    companion ArgSpec body.
//     0x32  2   flag_count    u16   0 at M8; M8.1 populates from
//                                    companion FlagSpec body.
//     0x34  2   schema_count  u16   0 at M8; M8.1 populates from
//                                    companion SchemasSig body
//                                    (count of schema tags carried in
//                                    schema_hash_ids below).
//     0x36  2   reserved      u16   zeroed; reserved for M8.2+.
//     0x38  8   cs_body_ref   u64   pointer back to the source
//                                    CommandSig record (caller-managed
//                                    region; opaque at this tier).
//     0x40 32   arg_type_mask u8    256-bit bitmap: bit N set iff
//                                    type_code N is referenced by any
//                                    ArgSpec in the companion arg body.
//                                    Byte N/8 bit N%8. Zero at M8.
//     0x60 32   schema_hash_ids u8  list of up to 32 u8 schema tags;
//                                    valid entries at indices
//                                    0..schema_count. Zero at M8.
//     0x80 128  query_payload u8    reserved for queryable predicates;
//                                    zero at M8. Format undefined
//                                    pending the semantic-query DSL.
//
//   total: 256 B (DS_BLOB_BYTES)
//
// The denormalized shape means the query path NEVER dereferences the
// cs_body_ref pointer: `commands operating on <schema>` matches the
// schema_hash_ids slot, `describe <cmd>` prints the name_inline window
// and the type set from arg_type_mask -- all pure bitmap tests against
// a 256-byte record. The cs_body_ref lets a caller walk back to the
// authoritative CommandSig record on demand (e.g., `describe --verbose
// <cmd>` renders the cap array by reparsing the 128+32*n_caps original
// bytes).
//
// Fingerprint input shape (R222.M8 serialization, this landing): the
// full 256-byte DescriptorBlob is a stable byte image for any
// downstream consumer that wants to hash the catalogue entry -- every
// field is inline, no pointer dereferences on either path, and the
// zero-fill prelude guarantees deterministic layout across the
// reserved regions.
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _ds_init() -> ()
//
//     Idempotent lazy boot hook. M8 holds no .bss state so the body
//     is a bare `ret`. Kept for parallelism with the DispatchMode /
//     CmdRegistry init-hook family; a later landing that adds .bss
//     (e.g., per-session describe counters) will flesh this out.
//
//     Register map: () -> rax (ignored).
//
//   _ds_serialize(cs_body, cs_len, name_hash, out, out_cap) -> status
//
//     Produce a DescriptorBlob at `out[0..256]` from a parsed
//     CommandSig record at `cs_body[0..cs_len]`.
//
//     Steps:
//       1. Validate cs_body != 0, cs_len >= CS_HEADER_BYTES (128),
//          and CommandSig magic 'CSIG' (0x47495343) at [cs_body + 0].
//       2. Validate out != 0 and out_cap >= DS_BLOB_BYTES (256).
//       3. Zero-fill the 256 bytes via a u64 stepping loop (32 iters
//          stepping by 8).
//       4. Write magic 'DESC' u32 at [+0], version u16 (= 1) at [+4],
//          flags u16 (copied byte-wise from CommandSig flags u32 at
//          [cs_body + 80], low 16 bits) at [+6], name_hash u64 at [+8].
//       5. Copy the first 32 bytes of CommandSig name_inline (at
//          [cs_body + 8..40]) into the blob at [+16..48].
//       6. Write cs_body_ref u64 (= cs_body input) at [+56].
//       7. Leave arg_count / flag_count / schema_count / arg_type_mask
//          / schema_hash_ids / query_payload zero (M8 default; M8.1
//          will layer-fill from the companion signatures).
//       8. Return DS_OK.
//
//     Returns:
//       DS_OK                   (0)       on success
//       DS_ERR_BAD_RECORD       (0x4F00)  cs_body null, cs_len < 128,
//                                         or CommandSig magic mismatch
//       DS_ERR_OUT_TOO_SMALL    (0x4F01)  out null or out_cap < 256
//
//     Register map (SysV):
//       _ds_serialize(rdi, rsi, rdx, rcx, r8) -> rax
//         rdi = cs_body
//         rsi = cs_len
//         rdx = name_hash
//         rcx = out
//         r8  = out_cap
//         rax = DS_OK | DS_ERR_*
//
//   _ds_deserialize(blob, blob_len, out_cs_body_ref, out_name_hash)
//                                                        -> status
//
//     Validate a DescriptorBlob and extract the two load-bearing
//     identity fields.
//
//     Steps:
//       1. Validate blob != 0, blob_len >= DS_BLOB_BYTES (256),
//          out_cs_body_ref != 0, out_name_hash != 0.
//       2. Validate magic 'DESC' (0x43534544) at [blob + 0] and
//          version u16 (= 1) at [blob + 4].
//       3. Read cs_body_ref u64 at [blob + 56]; write to
//          *out_cs_body_ref.
//       4. Read name_hash u64 at [blob + 8]; write to *out_name_hash.
//       5. Return DS_OK.
//
//     Returns:
//       DS_OK                   (0)       on success
//       DS_ERR_BAD_BLOB         (0x4F02)  blob null, blob_len < 256,
//                                         null out pointers, magic
//                                         mismatch, or version != 1
//
//     Register map (SysV):
//       _ds_deserialize(rdi, rsi, rdx, rcx) -> rax
//         rdi = blob
//         rsi = blob_len
//         rdx = out_cs_body_ref  (ptr to u64)
//         rcx = out_name_hash    (ptr to u64)
//         rax = DS_OK | DS_ERR_*
//
//   _ds_matches_type(blob, type_code) -> bool
//
//     Test bit `type_code` of the arg_type_mask bitmap at
//     [blob + 64..96]. Pure bitmap predicate; the caller is
//     responsible for passing a type_code in the AFS_TYPE_* / SS_TYPE_*
//     / FI_TYPE_* set (0..255 by shape; valid at M4 are 0..9 and 255).
//
//     At the raw M8 landing arg_type_mask is zero-filled, so this
//     entry always returns 0 for every type_code. A follow-up M8.1
//     landing populates the bitmap from the companion ArgSpec body
//     and the predicate becomes meaningful. Shipping the entry point
//     at M8 locks the API shape; the semantics flip at M8.1 without
//     an ABI break.
//
//     Returns:
//       0  (false)  blob null, type_code > 255, or bit clear
//       1  (true)   bit set in arg_type_mask
//
//     Register map (SysV):
//       _ds_matches_type(rdi, rsi) -> rax
//         rdi = blob
//         rsi = type_code  (0..255)
//         rax = 0 | 1
//
//   _ds_matches_schema(blob, schema_tag) -> bool
//
//     Scan the schema_hash_ids list at [blob + 96..128] for an entry
//     equal to `schema_tag`. The valid list length is schema_count u16
//     at [blob + 52], capped at 32 for safety. A schema_tag of 0 is
//     invalid (0 is the "no schema" sentinel in the SchemasSig family)
//     and always returns 0.
//
//     At the raw M8 landing schema_count is zero so this entry always
//     returns 0. A follow-up M8.1 landing populates the list and the
//     predicate becomes meaningful.
//
//     Returns:
//       0  (false)  blob null, schema_tag == 0 or > 255, or no match
//       1  (true)   schema_tag found in [blob + 96 + i] for some
//                   i < schema_count
//
//     Register map (SysV):
//       _ds_matches_schema(rdi, rsi) -> rax
//         rdi = blob
//         rsi = schema_tag  (1..255)
//         rax = 0 | 1
//
// =============================================================================
// STATUS BAND -- 0x4F00..0x4FFF
// =============================================================================
//
//   DS_OK                     = 0
//   DS_ERR_BAD_RECORD         = 0x4F00
//   DS_ERR_OUT_TOO_SMALL      = 0x4F01
//   DS_ERR_BAD_BLOB           = 0x4F02
//   DS_ERR_TOO_MANY_SCHEMAS   = 0x4F03   // reserved for M8.1 fold path
//
// The 0x4F00..0x4FFF range is reserved for the R222.M8 describe-wire
// band. The prior R222 submodule bands (0x3300 CommandSig, 0x3C00
// ArgFlagSpec, 0x4500 CmdRegistry, 0x4800 DispatchMode, 0x3900
// FunctorInstance, 0x2A00 SchemasSig) are disjoint -- the R222
// submodule bands remain error-disjoint so a downstream dispatcher's
// compound error path can distinguish describe-serialization faults
// from every other R222 submodule fault. Slots 0x4F04..0x4FFF reserved
// for M8.1 (companion-signature folder) and M8.2+ (per-blob fingerprint
// mismatch, query_payload decoder errors, etc.).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- bit-isolation uses imm8 variants only
//     (`and rN, 7` for the bit_idx isolate, `and rN, 1` for the final
//     bit mask); precedent: dispatch_mode.pdx line 422 `and rax, 0x3C`
//     imm8 variant.
//   - No 2-op `imul rN, imm` -- the 256-B blob zero-fill uses a u64
//     stepping loop (32 iterations stepping by 8); the name copy
//     steps byte-by-byte (32 iters stepping by 1).
//   - Variable shift uses `shl rN, cl` / `shr rN, cl` -- precedent:
//     cap_row.pdx line 1204 `shl rdx, cl` (R224.M4 _cr_check_env).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `DescribeSig` matches `describe_sig.pdx`.
//   - Labels prefixed `ds_` (grep-confirmed unique against the
//     parser-tier modules' prior prefixes u8n_, gi_, wp_, sch_sig_,
//     cmd_sig_, fi_, afs_, pl_, rp_, ll_, cc_, er_, cr_, cmdreg_,
//     hm_, rt_, dl_, se_, te_, cl_, dm_, cl_, fo_, sgr_, jc_, fh_,
//     ast_, sm_, ls_, lex_, eu_). The lone pre-existing `ds_` family
//     label (`pdxl_in_ds_*` in src/kernel/core/fs/pdxfs_lite/inode.pdx)
//     is function-scoped and lives in a disjoint kernel-side linker
//     namespace -- the same disjointness pattern cap_row.pdx and
//     cmd_registry.pdx cite for their own `cr_` / `cmdreg_` prefixes.
//     The public API still owns the `_ds_*` entry-point namespace,
//     which is distinct from the `ds_*` function-local label namespace.
//     Never bare `loop` / `if` / `let` / `fn` / `ret` (per
//     reference_paideia_as_reserved_labels).
//   - All `cmp reg, imm` immediates (0, 1, 7, 32, 128, 255, 256,
//     magic 0x47495343 and 0x43534544, status codes 0x4F00..0x4F03,
//     field offsets 0, 4, 6, 8, 16, 48, 50, 52, 54, 56, 64, 96, 128)
//     fit imm32 with bit 31 clear. The two magic values are both
//     < 0x80000000 so direct cmp-imm32 is sign-safe. No immediate in
//     this file needs the imm64 encoding.
//   - Byte loads via `xor rN, rN; mov_b rN, [base + idx]`
//     (zero-extend into the full qword).
//   - Byte stores via `mov_b [dst + disp], reg` -- stores only the
//     low 8 bits of the source register regardless of upper-byte
//     content, same shape used across the parser family.
//   - u32 loads via `xor rN, rN; mov_d rN, [base + disp]`.
//   - u32 stores via `mov_d [dst + disp], reg` (writes low 4 bytes).
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - No chained-displacement addressing: compute `[base + off + idx]`
//     into a scratch via `add rN, off; add rN, idx` first, then
//     dereference via `[rN + 0]`. Precedent: command_sig.pdx name-copy
//     loops (lines 821-830).
//
// =============================================================================
// REGISTER-LIVENESS DISCIPLINE
// =============================================================================
//
// Every entry point in this module is a PURE LEAF -- no nested CALL,
// no callee-save push, no stack frame, no `sub rsp, N`. The r11 clobber
// contract never activates because no CALL fires. Register plans:
//
//   * `_ds_init`: bare `ret`. No regs touched.
//   * `_ds_serialize`: 5 inputs in rdi, rsi, rdx, rcx, r8; scratch in
//     rax, r9, r10, r11; status + return in rax. rsi (cs_len) and r8
//     (out_cap) are read-only inputs that live through the function
//     body; rdi (cs_body) and rcx (out) are the two base pointers held
//     unchanged across the zero-fill and name-copy loops. rdx
//     (name_hash) is store-through to [rcx + 8] early then free.
//   * `_ds_deserialize`: 4 inputs in rdi, rsi, rdx, rcx; scratch in
//     rax, r9. rdi (blob) and rdx/rcx (out ptrs) are held unchanged;
//     rsi (blob_len) is read-only after the length guard.
//   * `_ds_matches_type`: 2 inputs in rdi, rsi; scratch in rax, rcx,
//     r9, r10. rcx holds the bit_idx that `shr r10, cl` consumes.
//   * `_ds_matches_schema`: 2 inputs in rdi, rsi; scratch in rax, r8
//     (schema_count), r9 (byte load), r10 (loop idx), r11 (addr calc).
//
// =============================================================================
// LAZY-INIT DISCIPLINE
// =============================================================================
//
// Not applicable at M8: this module holds no .bss state. The DescriptorBlob
// is caller-owned on both the serialize and deserialize paths; the matches
// predicates operate as pure bitmap tests over a caller-supplied blob.
// `_ds_init` is a bare `ret` placeholder; a later landing that adds .bss
// (e.g., per-session describe counters, a schema_tag intern table) will
// flesh it out behind the same name.
//
// =============================================================================
// Upstream: paideia-os#2486 (R222 umbrella), paideia-os#2665 (THIS
// ticket, R222.M8). Substrate: paideia-os#2658 (R222.M1 SchemasSig),
// paideia-os#2659 (R222.M2 CommandSig), paideia-os#2660 (R222.M3
// FunctorInstance), paideia-os#2661 (R222.M4 ArgFlagSpec),
// paideia-os#2662 (R222.M5 CmdRegistry), paideia-os#2663 (R222.M6
// DispatchMode). Design doc: design/shell/describe-wire-format.md.
// Related: design/shell/command-discovery-api.md (R123.M5 kernel-side
// module-enumeration surface the shell layer wraps), design/terminal/
// semantic-shell.md section 6.4 (the semantically-queryable discovery
// contract this blob materializes).

module DescribeSig = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax)
  // ==========================================================================
  //
  // Small-value range 0x4F00..0x4FFF, reserved for the R222.M8
  // describe-wire band. Disjoint from every prior landed R222
  // submodule band:
  //   SchemasSig    0x2A00..0x2AFF (R222.M1)
  //   CommandSig    0x3300..0x33FF (R222.M2)
  //   FunctorInst   0x3900..0x39FF (R222.M3)
  //   ArgFlagSpec   0x3C00..0x3CFF (R222.M4)
  //   CmdRegistry   0x4500..0x45FF (R222.M5)
  //   DispatchMode  0x4800..0x48FF (R222.M6)
  //
  // Grep confirmation at R222.M8 landing time:
  //   grep -rE '0x4F0[0-3]' paideia-os/{src,tools,design,tests}
  //     -> no packed-status hits outside this file + caps.decl +
  //        design/shell/describe-wire-format.md.

  pub let DS_OK                     : u64 = 0
  pub let DS_ERR_BAD_RECORD         : u64 = 0x4F00
  pub let DS_ERR_OUT_TOO_SMALL      : u64 = 0x4F01
  pub let DS_ERR_BAD_BLOB           : u64 = 0x4F02
  pub let DS_ERR_TOO_MANY_SCHEMAS   : u64 = 0x4F03

  // ==========================================================================
  // SECTION 2 -- LAYOUT CONSTANTS
  // ==========================================================================

  pub let DS_BLOB_BYTES             : u64 = 256
  pub let DS_BLOB_VERSION           : u64 = 1

  // Magic: 'DESC' little-endian = 0x43534544. Reads as the 4-byte
  // ASCII string "DESC" in a hex dump.
  pub let DS_BLOB_MAGIC             : u64 = 0x43534544

  // CommandSig magic (byte-for-byte identical to command_sig.pdx's
  // CS_HEADER_MAGIC); replicated as a local constant so the serializer
  // can validate the input without a cross-module linker dep.
  pub let DS_CS_HEADER_MAGIC        : u64 = 0x47495343   // 'CSIG' LE

  // CommandSig layout constants we read from (mirror R222.M2 shape).
  pub let DS_CS_HEADER_BYTES        : u64 = 128
  pub let DS_CS_OFF_NAME            : u64 = 8     // CommandSig name_inline base
  pub let DS_CS_OFF_FLAGS           : u64 = 80    // CommandSig flags u32

  // DescriptorBlob field offsets (byte offsets from blob base).
  pub let DS_OFF_MAGIC              : u64 = 0     // u32
  pub let DS_OFF_VERSION            : u64 = 4     // u16
  pub let DS_OFF_FLAGS              : u64 = 6     // u16
  pub let DS_OFF_NAME_HASH          : u64 = 8     // u64
  pub let DS_OFF_NAME_INLINE        : u64 = 16    // 32 B
  pub let DS_OFF_ARG_COUNT          : u64 = 48    // u16
  pub let DS_OFF_FLAG_COUNT         : u64 = 50    // u16
  pub let DS_OFF_SCHEMA_COUNT       : u64 = 52    // u16
  pub let DS_OFF_RESERVED           : u64 = 54    // u16
  pub let DS_OFF_CS_BODY_REF        : u64 = 56    // u64
  pub let DS_OFF_ARG_TYPE_MASK      : u64 = 64    // 32 B
  pub let DS_OFF_SCHEMA_HASH_IDS    : u64 = 96    // 32 B
  pub let DS_OFF_QUERY_PAYLOAD      : u64 = 128   // 128 B

  // Caps.
  pub let DS_NAME_INLINE_BYTES      : u64 = 32
  pub let DS_ARG_TYPE_MASK_BYTES    : u64 = 32
  pub let DS_SCHEMA_HASH_IDS_MAX    : u64 = 32

  // ==========================================================================
  // _ds_init() -> ()
  //
  // Idempotent lazy boot hook. M8 holds no .bss state so the body is
  // a bare `ret`. Kept for parallelism with the DispatchMode /
  // CmdRegistry init-hook family; a later landing that adds .bss will
  // flesh this out without an ABI break.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed ds_ini_ (none at M8).
  // ==========================================================================
  pub let _ds_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R222.M8 (#2665): _ds_init is a bare ret at this landing. The module holds no .bss state at M8 (the DescriptorBlob is caller-owned on both the serialize and deserialize paths; the matches predicates are pure bitmap tests over a caller-supplied blob). The entry point exists for parallelism with the DispatchMode (R222.M6) / CmdRegistry (R222.M5) init-hook family so a later landing that adds .bss (e.g., per-session describe counters or a schema_tag intern table) does not break the API. Pure leaf; zero pushes; no stack frame; no nested CALL. No cmp immediates; no byte loads; no stores. Labels prefixed ds_ini_ (none at M8).",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _ds_serialize(cs_body, cs_len, name_hash, out, out_cap) -> status
  //
  //   rdi = cs_body
  //   rsi = cs_len
  //   rdx = name_hash
  //   rcx = out            (ptr to >= 256-byte caller buffer)
  //   r8  = out_cap        (byte capacity of out)
  //   rax = DS_OK | DS_ERR_*
  //
  // Produce a 256-byte DescriptorBlob from a parsed CommandSig record.
  //
  // Flow:
  //   1. Validate cs_body != 0, cs_len >= 128, CSIG magic at offset 0.
  //   2. Validate out != 0, out_cap >= 256.
  //   3. Zero-fill the 256-B blob (32 iters stepping by 8).
  //   4. Write magic 'DESC' u32 at [+0], version lo byte 1 at [+4]
  //      (hi byte stays zeroed by step 3), flags lo/hi bytes copied
  //      from CommandSigHeader+80..82 to [+6..+8], name_hash u64 at
  //      [+8], name_inline[32] copied from CommandSig[+8..+40] to
  //      blob[+16..+48], cs_body_ref u64 at [+56].
  //   5. Everything else stays zero (arg_count / flag_count /
  //      schema_count / reserved / arg_type_mask / schema_hash_ids /
  //      query_payload); M8.1 populates those from companion sigs.
  //   6. Return DS_OK (0) in rax.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rdi, rcx held unchanged (cs_body, out bases); rdx
  // (name_hash) store-through to [rcx+8] then free; rax/r9/r10/r11
  // scratch. Labels prefixed ds_ser_.
  // ==========================================================================
  pub let _ds_serialize : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (cs_body: u64) (cs_len: u64) (name_hash: u64) (out: u64) (out_cap: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M8 (#2665): _ds_serialize produces a 256-byte DescriptorBlob at [out, out+256) from a CommandSig record at [cs_body, cs_body+cs_len). Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate cs_body != 0 (cmp rdi, 0; je ds_ser_bad_record); cs_len >= 128 (cmp rsi, 128; jb); CSIG magic at [cs_body + 0] via xor rax,rax; mov_d rax,[rdi+0]; cmp rax,0x47495343; jne; out != 0 (cmp rcx, 0; je ds_ser_oos); out_cap >= 256 (cmp r8, 256; jb ds_ser_oos). Zero-fill the 256-B blob via r11 stepping loop: 32 iterations writing u64 zero at [out + r11], r11 += 8 each iter. Stamp magic 'DESC' (0x43534544) u32 at [out+0] via mov r9,imm32; mov_d [rcx+0], r9. Stamp version u16 low byte at [out+4] (hi byte zero via step 2); mov rax,1; mov_b [rcx+4], rax. Copy CommandSig flags u32 at [cs_body + 80] into blob flags u16 at [out+6]: two byte loads at CS+80 and CS+81 into blob+6 and blob+7 (CS flags only use bits 0..2 at M2 so the high byte is always 0 but defensive two-byte copy covers any post-M2 extension of the low 16 bits). Stamp name_hash u64 at [out+8]: mov [rcx+8], rdx. Copy 32 bytes of CommandSig name_inline at [cs_body + 8..40] to blob name_inline at [out + 16..48] via a byte-by-byte loop (32 iters stepping by 1). Stamp cs_body_ref u64 at [out+56]: mov [rcx+56], rdi (the input pointer IS the opaque ref). Return rax=0 (DS_OK). All cmp immediates (0, 128, 256, 0x47495343, status codes 0x4F00..0x4F01) fit imm32 with bit 31 clear -- 0x47495343 < 0x80000000 so cmp-imm32 is sign-safe. Blob magic 0x43534544 < 0x80000000 so mov-imm32 to a scratch is sign-safe. No chained-displacement addressing: all [base+off+idx] expressions are precomputed into a scratch via add. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ds_ser_.",
      block: {
        // ---- Input validation --------------------------------------------
        // cs_body != 0.
        cmp rdi, 0;
        je  ds_ser_bad_record;

        // cs_len >= DS_CS_HEADER_BYTES (128).
        cmp rsi, 128;
        jb  ds_ser_bad_record;

        // Read CSIG magic u32 at [cs_body + 0].
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x47495343;                   // DS_CS_HEADER_MAGIC
        jne ds_ser_bad_record;

        // out != 0.
        cmp rcx, 0;
        je  ds_ser_oos;

        // out_cap >= DS_BLOB_BYTES (256).
        cmp r8, 256;
        jb  ds_ser_oos;

        // ---- Zero-fill 256-B blob via u64 stepping loop -----------------
        xor r11, r11;                          // i = 0
      ds_ser_zero_loop:
        cmp r11, 256;                          // DS_BLOB_BYTES
        jae ds_ser_hdr;
        mov r10, rcx;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;                    // u64 zero store
        add r11, 8;
        jmp ds_ser_zero_loop;

      ds_ser_hdr:
        // ---- Header stamp ------------------------------------------------
        // magic u32 'DESC' at [+0].
        mov r9, 0x43534544;                    // DS_BLOB_MAGIC
        mov_d [rcx + 0], r9;

        // version u16 low byte at [+4] = 1 (high byte zero via zero-fill).
        mov rax, 1;                            // DS_BLOB_VERSION
        mov_b [rcx + 4], rax;

        // flags u16: copy low 16 bits of CommandSig flags u32 at
        // [cs_body + 80..82] -> blob at [+6..+8]. Two defensive byte
        // copies cover any post-M2 extension of the low 16 bits.
        xor rax, rax;
        mov_b rax, [rdi + 80];                 // DS_CS_OFF_FLAGS low byte
        mov_b [rcx + 6], rax;
        xor rax, rax;
        mov_b rax, [rdi + 81];
        mov_b [rcx + 7], rax;

        // name_hash u64 at [+8].
        mov [rcx + 8], rdx;

        // ---- name_inline copy (32 bytes from CS+8 to blob+16) -----------
        xor r11, r11;                          // i = 0
      ds_ser_name_copy:
        cmp r11, 32;                           // DS_NAME_INLINE_BYTES
        jae ds_ser_cs_ref;
        // src = cs_body + 8 + i
        mov r10, rdi;
        add r10, 8;                            // DS_CS_OFF_NAME
        add r10, r11;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        // dst = out + 16 + i
        mov r9, rcx;
        add r9, 16;                            // DS_OFF_NAME_INLINE
        add r9, r11;
        mov_b [r9 + 0], rax;
        add r11, 1;
        jmp ds_ser_name_copy;

      ds_ser_cs_ref:
        // cs_body_ref u64 at [+56] = cs_body input.
        mov [rcx + 56], rdi;

        // Everything else remains zero (arg_count, flag_count,
        // schema_count, reserved, arg_type_mask, schema_hash_ids,
        // query_payload). M8.1 populates those from companion sigs.

        xor rax, rax;                          // DS_OK = 0
        ret;

      ds_ser_bad_record:
        mov rax, 0x4F00;                       // DS_ERR_BAD_RECORD
        ret;

      ds_ser_oos:
        mov rax, 0x4F01;                       // DS_ERR_OUT_TOO_SMALL
        ret;
      }
    }

  // ==========================================================================
  // _ds_deserialize(blob, blob_len, out_cs_body_ref, out_name_hash)
  //                                                     -> status
  //
  //   rdi = blob
  //   rsi = blob_len
  //   rdx = out_cs_body_ref  (ptr to u64)
  //   rcx = out_name_hash    (ptr to u64)
  //   rax = DS_OK | DS_ERR_BAD_BLOB
  //
  // Validate a DescriptorBlob and extract (cs_body_ref, name_hash).
  //
  // Flow:
  //   1. Validate blob != 0, blob_len >= 256, out ptrs != 0.
  //   2. Validate 'DESC' magic at [+0], version lo byte at [+4] == 1.
  //   3. Write *out_cs_body_ref := blob[+56] u64; *out_name_hash :=
  //      blob[+8] u64.
  //   4. Return DS_OK.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Register plan: rdi (blob), rdx, rcx held unchanged; rax/r9 scratch.
  // Labels prefixed ds_des_.
  // ==========================================================================
  pub let _ds_deserialize : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (blob: u64) (blob_len: u64) (out_cs_body_ref: u64) (out_name_hash: u64)
       -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M8 (#2665): _ds_deserialize validates a DescriptorBlob at [blob, blob+blob_len) and extracts (cs_body_ref, name_hash) into caller-owned out slots. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate blob != 0 (cmp rdi, 0; je ds_des_bad); blob_len >= 256 (cmp rsi, 256; jb); out_cs_body_ref != 0 (cmp rdx, 0; je); out_name_hash != 0 (cmp rcx, 0; je). Read magic u32 at [blob+0] via xor rax,rax; mov_d rax,[rdi+0]; cmp rax,0x43534544; jne. Read version low byte at [blob+4] via xor rax,rax; mov_b rax,[rdi+4]; cmp rax,1; jne (version high byte at [+5] is checked implicitly by the serialize-side zero-fill contract; a stricter check lands at M8.2). Extract cs_body_ref u64 at [blob+56]: mov rax,[rdi+56]; mov [rdx+0], rax. Extract name_hash u64 at [blob+8]: mov rax,[rdi+8]; mov [rcx+0], rax. Return rax=0 (DS_OK). All cmp immediates (0, 1, 256, 0x43534544, 0x4F02) fit imm32 with bit 31 clear -- 0x43534544 < 0x80000000 so cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ds_des_.",
      block: {
        // blob != 0.
        cmp rdi, 0;
        je  ds_des_bad;

        // blob_len >= DS_BLOB_BYTES (256).
        cmp rsi, 256;
        jb  ds_des_bad;

        // out_cs_body_ref != 0.
        cmp rdx, 0;
        je  ds_des_bad;

        // out_name_hash != 0.
        cmp rcx, 0;
        je  ds_des_bad;

        // Magic u32 at [+0] == 'DESC' (0x43534544).
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x43534544;                   // DS_BLOB_MAGIC
        jne ds_des_bad;

        // version low byte at [+4] == 1.
        xor rax, rax;
        mov_b rax, [rdi + 4];
        cmp rax, 1;                            // DS_BLOB_VERSION
        jne ds_des_bad;

        xor rax, rax;
        mov_b rax, [rdi + 5];                  // version u16 high byte must be 0
        cmp rax, 0;
        jne ds_des_bad;

        // cs_body_ref u64 at [+56] -> *out_cs_body_ref.
        mov rax, [rdi + 56];
        mov [rdx + 0], rax;

        // name_hash u64 at [+8] -> *out_name_hash.
        mov rax, [rdi + 8];
        mov [rcx + 0], rax;

        xor rax, rax;                          // DS_OK = 0
        ret;

      ds_des_bad:
        mov rax, 0x4F02;                       // DS_ERR_BAD_BLOB
        ret;
      }
    }

  // ==========================================================================
  // _ds_matches_type(blob, type_code) -> bool
  //
  //   rdi = blob
  //   rsi = type_code  (0..255)
  //   rax = 0 (false) | 1 (true)
  //
  // Test bit `type_code` of the arg_type_mask bitmap at [blob + 64..96].
  //
  // Flow:
  //   1. Validate blob != 0, type_code <= 255 (return 0 on either fail).
  //   2. byte_idx = type_code >> 3; bit_idx = type_code & 7 (imm8).
  //   3. Load byte at [blob + 64 + byte_idx] into r10.
  //   4. bit = (byte >> bit_idx) & 1  (shr r10, cl; and r10, 1).
  //   5. Return bit in rax.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // The variable shift `shr r10, cl` consumes rcx's low byte; rcx is
  // scratch (not an input to this function). Labels prefixed ds_mt_.
  // ==========================================================================
  pub let _ds_matches_type : (u64, u64) -> u64 !{mem} @{} =
    fn (blob: u64) (type_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M8 (#2665): _ds_matches_type tests bit `type_code` of the arg_type_mask bitmap at [blob + 64..96]. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate blob != 0 (cmp rdi, 0; je ds_mt_false); type_code <= 255 (cmp rsi, 255; ja). Compute byte_idx = type_code >> 3 into rax (shr rax, 3). Compute byte address = blob + 64 + byte_idx into r9 (mov r9, rdi; add r9, 64; add r9, rax). Load byte at [r9 + 0] into r10 (zero-extended). Compute bit_idx = type_code & 7 into rcx (and r,imm8 is pitfall-safe; precedent dispatch_mode.pdx line 422 and r64,imm8). Shift r10 right by cl: `shr r10, cl` (variable shift via CL; encoder-validated precedent cap_row.pdx line 1204 shl rdx,cl, pdxfs_lite/alloc.pdx line 192 shr r11,cl). Mask low bit: `and r10, 1` (imm8). Return r10 in rax. ds_mt_false: xor rax, rax; ret. All cmp immediates (0, 255) and all `and r,imm` masks (7, 1) fit imm8. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ds_mt_.",
      block: {
        // Validate blob != 0.
        cmp rdi, 0;
        je  ds_mt_false;

        // Validate type_code <= 255 (fits in u8; 256-bit bitmap).
        cmp rsi, 255;
        ja  ds_mt_false;

        // byte_idx = type_code >> 3 (which u8 slot in the 32-byte mask).
        mov rax, rsi;
        shr rax, 3;                            // rax = byte_idx (0..31)

        // byte_addr = blob + DS_OFF_ARG_TYPE_MASK + byte_idx.
        mov r9, rdi;
        add r9, 64;                            // DS_OFF_ARG_TYPE_MASK
        add r9, rax;

        // Load the byte (zero-ext into r10).
        xor r10, r10;
        mov_b r10, [r9 + 0];

        // bit_idx = type_code & 7 -> cl (via rcx).
        mov rcx, rsi;
        and rcx, 7;                            // imm8

        // bit = (byte >> bit_idx) & 1.
        shr r10, cl;
        and r10, 1;                            // imm8

        mov rax, r10;
        ret;

      ds_mt_false:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _ds_matches_schema(blob, schema_tag) -> bool
  //
  //   rdi = blob
  //   rsi = schema_tag  (1..255; 0 is the "no schema" sentinel)
  //   rax = 0 (false) | 1 (true)
  //
  // Scan the schema_hash_ids list at [blob + 96..128] for an entry
  // equal to schema_tag. The valid list length is schema_count u16 at
  // [blob + 52], capped at 32 for safety.
  //
  // Flow:
  //   1. Validate blob != 0, schema_tag in [1..255].
  //   2. Read schema_count u16 at [blob + 52] via two byte loads
  //      (lo then hi) ORed together.
  //   3. Cap schema_count at DS_SCHEMA_HASH_IDS_MAX (32).
  //   4. If schema_count == 0, return 0.
  //   5. Scan [blob + 96 + i] for i in 0..schema_count; return 1 on
