  // Register plan: rdi (blob) held; rsi (schema_tag) held; r8 holds
  // schema_count across the loop (volatile but not clobbered by any
  // CALL here); r10 = loop index; r9/r11 = scratch byte/addr.
  // Labels prefixed ds_ms_.
  // ==========================================================================
  pub let _ds_matches_schema : (u64, u64) -> u64 !{mem} @{} =
    fn (blob: u64) (schema_tag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R222.M8 (#2665): _ds_matches_schema scans the schema_hash_ids list at [blob + 96..128] for schema_tag. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Flow: validate blob != 0 (cmp rdi, 0; je ds_ms_false); schema_tag != 0 (cmp rsi, 0; je); schema_tag <= 255 (cmp rsi, 255; ja). Read schema_count u16 at [blob + 52] via two byte loads: xor r8,r8; mov_b r8,[rdi+52] (low byte); xor r9,r9; mov_b r9,[rdi+53] (high byte); shl r9,8; or r8,r9. Cap r8 at DS_SCHEMA_HASH_IDS_MAX (32): cmp r8, 32; jbe ds_ms_cap_ok; mov r8, 32. If r8 == 0 return false (cmp r8, 0; je ds_ms_false). Scan loop: xor r10, r10 (i = 0); each iter cmp r10,r8; jae ds_ms_false. Compute addr = blob + 96 + i: mov r11, rdi; add r11, 96; add r11, r10. Load byte: xor r9, r9; mov_b r9, [r11 + 0]. Compare: cmp r9, rsi; je ds_ms_true. Advance: add r10, 1; jmp. ds_ms_true: mov rax, 1; ret. ds_ms_false: xor rax, rax; ret. All cmp immediates (0, 32, 255) fit imm8/imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed ds_ms_.",
      block: {
        // Validate blob != 0.
        cmp rdi, 0;
        je  ds_ms_false;

        // Validate schema_tag != 0 (0 is the SchemasSig "no schema" sentinel).
        cmp rsi, 0;
        je  ds_ms_false;

        // Validate schema_tag <= 255.
        cmp rsi, 255;
        ja  ds_ms_false;

        // Read schema_count u16 at [blob + 52] via two byte loads.
        xor r8, r8;
        mov_b r8, [rdi + 52];                  // DS_OFF_SCHEMA_COUNT lo
        xor r9, r9;
        mov_b r9, [rdi + 53];                  // DS_OFF_SCHEMA_COUNT hi
        shl r9, 8;
        or  r8, r9;                            // r8 = schema_count

        // Cap at DS_SCHEMA_HASH_IDS_MAX (32).
        cmp r8, 32;
        jbe ds_ms_cap_ok;
        mov r8, 32;
      ds_ms_cap_ok:

        // Empty list -> false.
        cmp r8, 0;
        je  ds_ms_false;

        // Scan loop.
        xor r10, r10;                          // i = 0
      ds_ms_loop:
        cmp r10, r8;
        jae ds_ms_false;
        // addr = blob + DS_OFF_SCHEMA_HASH_IDS + i
        mov r11, rdi;
        add r11, 96;                           // DS_OFF_SCHEMA_HASH_IDS
        add r11, r10;
        xor r9, r9;
        mov_b r9, [r11 + 0];
        cmp r9, rsi;
        je  ds_ms_true;
        add r10, 1;
        jmp ds_ms_loop;

      ds_ms_true:
        mov rax, 1;
        ret;

      ds_ms_false:
        xor rax, rax;
        ret;
      }
    }

}
