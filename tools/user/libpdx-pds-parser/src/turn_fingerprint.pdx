// src/turn_fingerprint.pdx -- libpdx-pds-parser.R229.M10 (paideia-os#2728)
//
// TurnFingerprint: parser-tier per-turn anti-fabrication fingerprint
// emitter. Every REPL turn emits `@fingerprint("turn.<id>.<hash-hex>")`
// so the debugger (and the correlation harness) can anchor each turn's
// claimed result to a FNV-1a 64 hash of the actual result bytes. R229.M10
// of the REPL evaluator umbrella (paideia-os#2493).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R229.M1 lands the REPL state machine (kernel-side). R229.M2..M9 land
// the parser-tier satellites (SessionEnv, TypeEnv, JobControl, History,
// LineEditor, ViMode, MultiLine, Renderer). R229.M10 (THIS module) lands
// the principal anti-fabrication hook of the paideia-os project P9
// discipline (`design/foundations/project-invariants.md` P9 and
// `.claude/CLAUDE.md`): every REPL turn MUST emit a 64-byte
// TurnFingerprint record carrying the turn's id, its result bytes'
// FNV-1a 64 hash, an rdtsc timestamp, and a pre-rendered ASCII tag of
// the form `turn.<id>.<hash-hex>`. The debugger (both the sub-agent
// debugger and the smoke-mode correlation harness) treats this tag as
// the ground truth for every turn's claimed outcome.
//
// Position in the substrate graph:
//
//   TTY ISR -> _rl_tick (R229.M1) -> state := EVALUATE
//        -> evaluator dispatch -> result bytes
//        -> _tf_emit(turn_id, result_ptr, result_len, out, 64)
//              -> 64-byte TurnFingerprint record on caller scratch
//        -> _tf_render_tag(record, out, out_cap)
//              -> `@fingerprint("turn.<id>.<hash-hex>")` ASCII string
//              -> klog emission + stdout emission (R229.M1 driver)
//        -> state := WRITING (R229.M9 Renderer)
//        -> state := READING -> _rl_emit_prompt
//
// TurnFingerprint is PARSER-TIER by geography (same satellite library as
// LineEditor, ViMode, MultiLine, Renderer, History) but is NOT itself a
// parser -- the module computes a hash and renders an ASCII tag. The
// hash is byte-for-byte identical to the parser-family FNV leaves
// (`_cmd_sig_fnv1a64` R222.M2, `_fi_fnv1a64` R222.M3,
// `_cmdreg_fnv1a64` R222.M5, `_ws_schema_hash` R223.M5, the inlined FNV
// in `_h_append` R229.M5) so a cross-boundary correlator comparing
// hashes from different code paths over the same result bytes gets
// numerical equality.
//
// Lives user-space because the REPL runs user-space; the state is
// caller-process-local (zero `.bss` at raw M10; every record is caller-
// owned on all three operational paths); the module touches no kernel
// KIND and consumes no capability (caps.decl R229.M10 band note).
//
// Why TurnFingerprint is distinct from R229.M5 (History):
//   * R229.M5 History owns a 128-slot ring of 128-byte History records
//     persistent across the whole session (for Ctrl-R recall, `history`
//     builtin, up-arrow). The History row carries its own cmd_hash via
//     an inlined FNV but hashes the COMMAND TEXT, not the RESULT bytes;
//     the two hashes serve different anchoring purposes.
//   * TurnFingerprint owns a 64-byte record per turn, caller-scratched,
//     consumed by the debugger / correlator and then discarded. The
//     record is NOT persisted across turns in a parser-tier structure;
//     the kernel-side R229.M1 driver may klog it for post-mortem but
//     the parser tier produces a fresh record on every emit call.
//
// Why TurnFingerprint has no `.bss` state:
//   The module is a pure function of its inputs: given (turn_id,
//   result_ptr, result_len), the output 64-byte record and its rendered
//   tag are deterministic (modulo the rdtsc timestamp field, which is
//   explicit non-determinism isolated to one u64). The debugger does
//   NOT need a .bss cursor or counter -- the turn_id is caller-supplied
//   by the REPL state machine, which already tracks it via its own
//   turn-counter field. Zero `.bss` -> this module is a pure leaf
//   over caller-supplied buffers on all four entry points.
//
// =============================================================================
// TurnFingerprint RECORD -- 64 BYTES
// =============================================================================
//
// Record stride is a power of two (64 = 1 << 6) so a future per-session
// multi-turn ring (one row per turn, up to a bounded horizon) can index
// via `shl idx, 6`.
//
//   0x00 u32    magic              'TFPR' (0x52504654 LE) -- reads
//                                   byte-sequentially as byte[0]=0x54 'T',
//                                   byte[1]=0x46 'F', byte[2]=0x50 'P',
//                                   byte[3]=0x52 'R' per the Wave 125
//                                   SortGroupReduce magic-reconciliation
//                                   lesson (byte-sequence readability
//                                   over numeric prettiness). The u32
//                                   fits in imm32 with bit 31 clear so
//                                   direct `cmp reg, imm32` is sign-
//                                   extension-safe.
//   0x04 u32    turn_id             1-based turn counter from the REPL
//                                   state machine; MUST be the SAME
//                                   value the REPL has already assigned
//                                   to this turn in its state record.
//   0x08 u64    result_hash         FNV-1a 64 of
//                                   result_ptr[0..result_len). Zero-
//                                   length result returns the FNV
//                                   offset basis 0xCBF29CE484222325
//                                   unchanged (standard FNV behaviour).
//   0x10 u64    timestamp_us        rdtsc sample at emit time. The REPL
//                                   driver may convert to microseconds
//                                   via TSC calibration (R20.M3) at
//                                   display time; this module stores
//                                   the raw TSC for byte-for-byte
//                                   reproducibility across tools.
//   0x18 u8[32] rendered_tag        Pre-rendered ASCII:
//                                     `turn.<id>.<hash-hex>`
//                                   where <id> is variable-width
//                                   decimal (1..10 digits, no leading
//                                   zeros) and <hash-hex> is 16-char
//                                   lowercase hexadecimal of the full
//                                   64-bit result_hash. NUL-padded to
//                                   32 bytes. Max rendered width is
//                                   5 + 10 + 1 + 16 = 32 bytes exactly
//                                   (u32 ceiling turn_id). The debugger
//                                   reads from offset 0 until first NUL
//                                   or offset 32, whichever comes first.
//   0x38 u64    reserved            Zero at M10; reserved for M10.1+
//                                   (M10.1 adds an `env_mask` u32
//                                   covering the cap-row delta between
//                                   READ and WRITE phases; M10.2 adds a
//                                   `result_len_u32` low-32 so a
//                                   downstream auditor can cross-check
//                                   the hash input length without the
//                                   REPL plumbing the length into a
//                                   second record).
//
// =============================================================================
// PUBLIC API
// =============================================================================
//
//   _tf_init() -> ()
//     Bare `ret` boot hook. M10 holds NO .bss state (every operation is
//     caller-scratched). Kept for parallelism with the parser-family
//     init-hook convention (`_rd_init` R229.M9, `_ha_init` R223.M6,
//     `_ws_init` R223.M5, `_ds_init` R222.M8, `_dm_init` R222.M6,
//     `_cmdreg_init` R222.M5, `_st_init` R223.M7).
//
//   _tf_emit(turn_id, result_ptr, result_len, out, out_cap) -> status
//     rdi = turn_id         (1-based u64; low 32 bits of turn id)
//     rsi = result_ptr      (ptr to result bytes; may be 0 iff len == 0)
//     rdx = result_len      (0..TF_RESULT_MAX = 4096)
//     rcx = out             (ptr to caller-owned 64-byte scratch)
//     r8  = out_cap         (>= 64)
//     rax = TF_OK or TF_ERR_* in low 32 (no packing; 64 bytes written
//                            on success, unspecified on error)
//
//     Validates (out != 0 -> TF_ERR_BAD_OUT; out_cap >= 64 ->
//     TF_ERR_OUT_TOO_SMALL; result_len > 0 && result_ptr == 0 ->
//     TF_ERR_BAD_RESULT; result_len > TF_RESULT_MAX ->
//     TF_ERR_RESULT_TOO_LARGE; turn_id > 0xFFFFFFFF ->
//     TF_ERR_BAD_TURN_ID). On success: writes 64 bytes to out:
//     magic + turn_id + FNV-1a 64 hash + rdtsc timestamp + rendered
//     ASCII tag + reserved zero. 6 callee-save push frame
//     (rbx=turn_id, rbp=result_ptr, r12=result_len, r13=out,
//     r14=out_cap, r15=hash) with NO nested CALL (FNV inlined;
//     decimal + hex rendering unrolled) so no sub-rsp alignment pad
//     is required (precedent: R229.M5 `_h_append`).
//
//   _tf_render_tag(record, out, out_cap) -> packed_u64
//     rdi = record     (ptr to 64-byte TurnFingerprint record)
//     rsi = out        (ptr to caller-owned output buffer)
//     rdx = out_cap    (>= 16 for the smallest tag:
//                       `@fingerprint("")` = 16 bytes; typical 20..48)
//     rax = (bytes_written << 32) | status
//
//     Emits `@fingerprint("<record.rendered_tag>")` where
//     <record.rendered_tag> is copied from record[+0x18..+0x18+N] up
//     to the first NUL or offset 32 (whichever first). Validates
//     record != 0 (TF_ERR_BAD_RECORD), out != 0 (TF_ERR_BAD_OUT),
//     magic at record[+0..+4] == 'TFPR' (TF_ERR_BAD_MAGIC), and
//     out_cap >= needed (TF_ERR_OUT_TOO_SMALL). Pure leaf; zero
//     callee-save pushes; no stack frame; no nested CALL. Prefix
//     "@fingerprint(\"" (14 B: 0x40 0x66 0x69 0x6E 0x67 0x65 0x72
//     0x70 0x72 0x69 0x6E 0x74 0x28 0x22) and suffix "\")" (2 B:
//     0x22 0x29) emitted as byte-unrolled stores.
//
//   _tf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
//     rdi = expected_tag       (ptr to expected `@fingerprint("...")`
//                               ASCII string)
//     rsi = expected_len       (byte length of expected_tag; >= 16)
//     rdx = actual_record      (ptr to 64-byte TurnFingerprint record)
//     rcx = record_len         (= 64; defensive guard)
//     rax = TF_OK iff the record would render byte-identically to
//           expected_tag, else TF_ERR_MISMATCH or a validation error.
//
//     The debugger's compare entry: given a claimed fingerprint tag
//     (from a tool-call log, a klog capture, or a smoke-mode golden)
//     and the record the shell actually emitted, confirm they refer
//     to the SAME turn. Avoids a stack scratch buffer by:
//       (a) verifying expected_tag begins with `@fingerprint("` (14 B);
//       (b) verifying expected_tag ends with `")` (2 B);
//       (c) extracting inner = expected_tag[14..expected_len-2];
//       (d) byte-comparing inner against record[+0x18..+0x18+N] with
//           the shorter side terminating on first NUL (if the record's
//           inline tag is NUL-padded) or inner's end;
//       (e) requiring N == inner_len (where N is the record's live
//           tag length).
//     Pure leaf; zero callee-save pushes; no stack frame; no nested
//     CALL. Validates record_len == 64 (TF_ERR_BAD_LEN),
//     actual_record != 0 (TF_ERR_BAD_RECORD), expected_tag != 0
//     (TF_ERR_BAD_EXPECTED), magic at record[+0..+4] == 'TFPR'
//     (TF_ERR_BAD_MAGIC), expected_len >= 16 (TF_ERR_BAD_LEN).
//
// Register maps (SysV):
//
//   _tf_init()                                             -> ()
//   _tf_emit(rdi, rsi, rdx, rcx, r8)                       -> rax
//   _tf_render_tag(rdi, rsi, rdx)                          -> rax
//   _tf_correlate(rdi, rsi, rdx, rcx)                      -> rax
//
// =============================================================================
// STATUS-CODE NAMESPACE  --  0x6000..0x60FF
// =============================================================================
//
// TurnFingerprint packed-status range. Ten slots used at R229.M10:
//
//   TF_OK                     = 0        success; 64 B written (emit) or
//                                        packed bytes_written (render)
//   TF_ERR_BAD_OUT            = 0x6000   out == 0 on any entry
//   TF_ERR_OUT_TOO_SMALL      = 0x6001   out_cap below required width
//   TF_ERR_BAD_RESULT         = 0x6002   result_len > 0 AND result_ptr == 0
//                                        (_tf_emit)
//   TF_ERR_RESULT_TOO_LARGE   = 0x6003   result_len > TF_RESULT_MAX (4096)
//   TF_ERR_BAD_TURN_ID        = 0x6004   turn_id > 0xFFFFFFFF (upper 32
//                                        set; must fit u32 for the
//                                        record's turn_id field)
//   TF_ERR_BAD_RECORD         = 0x6005   record == 0 (_tf_render_tag /
//                                        _tf_correlate)
//   TF_ERR_BAD_MAGIC          = 0x6006   record[+0..+4] != 'TFPR' LE
//   TF_ERR_MISMATCH           = 0x6007   _tf_correlate: expected_tag's
//                                        inner differs from the record's
//                                        rendered_tag
//   TF_ERR_BAD_LEN            = 0x6008   _tf_correlate: record_len != 64
//                                        OR expected_len < 16 OR
//                                        expected_tag missing wrapper
//   TF_ERR_BAD_EXPECTED       = 0x6009   _tf_correlate: expected_tag == 0
//
// Slots 0x600A..0x60FF reserved for R229.M10.1+ follow-ups
// (TF_ERR_BAD_ENV_MASK on an M10.1 env-mask field validator;
// TF_ERR_HASH_MISMATCH on an M10.3 strict-mode hash-only correlator
// that recomputes FNV from the result bytes; TF_ERR_TIMESTAMP_SKEW on
// an M10.4 rdtsc-skew sanity bound).
//
// Band 0x6000..0x60FF is disjoint from every landed parser-tier packed-
// status band:
//
//   0x3C00..0x3CFF (R222.M4 arg_flag_spec)
//   0x3F00..0x3FFF (R221.M3 width_pass)
//   0x4100..0x41FF (R222.M3 functor_instance)
//   0x4500..0x45FF (R222.M5 cmd_registry)
//   0x4800..0x48FF (R222.M6 dispatch_mode)
//   0x4A00..0x4AFF (R229.M2 session_env)
//   0x4B00..0x4BFF (R229.M3 type_env)
//   0x4C00..0x4CFF (R222.M8 describe_sig)
//   0x4D00..0x4DFF (R222.M4 arg_flag_spec extended)
//   0x4E00..0x4EFF (R229.M4 job_control)
//   0x4F00..0x4FFF (R222.M8 describe_sig)
//   0x5000..0x50FF (R224.M6 pipeline_lambda)
//   0x5100..0x51FF (R229.M5 history)
//   0x5200..0x52FF (R223.M5 wire_sink)
//   0x5300..0x53FF (R223.M6 hostname_annot)
//   0x5400..0x54FF (R229.M6 line_editor)
//   0x5500..0x55FF (R223.M7 session_type)
//   0x5600..0x56FF (R224.M7 linear_propagate)
//   0x5700..0x57FF (R229.M7 vi_mode)
//   0x5800..0x58FF (R225.M6 rank_check)
//   0x5900..0x59FF (R227.M3 import_resolve)
//   0x5A00..0x5AFF (R229.M8 multi_line)
//   0x5B00..0x5BFF (R225.M7 diag_report)
//   0x5C00..0x5CFF (R227.M4 load_check)
//   0x5D00..0x5DFF (R229.M9 renderer)
//   0x5E00..0x5EFF (R225.M8 lsp_hover)
//   0x5F00..0x5FFF (R227.M5 module_functor)
//
// R229.M10 claims 0x6000..0x60FF directly above the Wave 130 /
// 131 R227.M5 ModuleFunctor band (landed in the same wave). A
// downstream compound-error dispatcher can discriminate "turn-
// fingerprint faulted" from every other sibling satellite's failure
// modes by `shr r, 8; cmp r, 0x60`.
//
// =============================================================================
// INTERACTIONS
// =============================================================================
//
//   R229.M1 (repl_loop.pdx, kernel) -- drives the fingerprint emission
//     path. Immediately after the evaluator returns the result bytes,
//     the REPL calls `_tf_emit(turn_id, result_ptr, result_len,
//     scratch, 64)` into THIS module to produce the record, then calls
//     `_tf_render_tag(scratch, out, out_cap)` to compose the
//     `@fingerprint("...")` string for klog + stdout emission.
//
//   R229.M5 (history.pdx) -- the parallel per-turn record. History's
//     cmd_hash FNV covers the COMMAND TEXT; TurnFingerprint's
//     result_hash covers the RESULT BYTES. Both hashes use the same
//     offset basis + prime (standard FNV-1a 64) so numerical equality
//     across them is guaranteed WHEN the input byte streams match.
//
//   design/foundations/project-invariants.md P9 -- the authoritative
//     invariant statement. P9 commits every REPL turn to a verifiable
//     fingerprint anchor; THIS module provides the parser-tier half of
//     that commitment.
//
//   design/debugger/anti-fabrication-anchors.md (planned R30 doc) --
//     the smoke-mode correlation harness that iterates N turns, feeds
//     synthetic results, captures the emitted tags, and asserts that
//     every tag's inner structure matches `turn.<id>.<FNV-of-result>`.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 or imm32; the low-
//     nibble mask `and rN, 15` fits imm8.
//   - No 2-op `imul r, imm` -- the FNV multiply is the one-op
//     `mul rcx` form (unsigned 64x64; distinct from the pitfall-
//     listed 2-op shape per the Wave 125 pdx-encoder-pitfalls lesson).
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `TurnFingerprint` matches `turn_fingerprint.pdx`.
//   - Labels prefixed `tf_` with per-function suffix (`tf_ini_`,
//     `tf_em_`, `tf_rt_`, `tf_co_`). Disjoint from every landed
//     parser-tier prefix (grep-confirmed against `rd_`, `le_`, `vi_`,
//     `ml_`, `lp_`, `st_`, `h_`, `ha_`, `ws_`, `ir_`, `rc_`, `lc_`,
//     `dr_`, `u8n_`, `gi_`, `wp_`, `cl_`, `ast_`, `sm_`, `ss_` /
//     `sch_sig_`, `cmd_sig_`, `fi_`, `afs_`, `cmdreg_`, `dm_`, `ds_`,
//     `pl_`, `pl_lam_`, `rp_`, `fo_`, `sgr_`, `ll_`, `cc_`, `er_`,
//     `cr_`, `ls_`, `hm_`, `rt_`, `eu_`, `dl_`, `se_`, `te_`, `jc_`,
//     `fh_`) and from the paideia-as reserved keywords (`loop`, `if`,
//     `let`, `fn`, `ret`, `done`). Also disjoint from the kernel-side
//     `atf_` prefix (R129.M3 ANSI256 tabular fallback) because `tf_`
//     is a strict suffix-free prefix.
//   - All `cmp reg, imm` immediates (0, 1, 2, 4, 5, 6, 10, 14, 15, 16,
//     32, 60, 64, 128, 4096, 0xFFFFFFFF, byte literals 0x22 '"',
//     0x28 '(', 0x29 ')', 0x2E '.', 0x40 '@', 0x65 'e', 0x66 'f',
//     0x67 'g', 0x69 'i', 0x6E 'n', 0x70 'p', 0x72 'r', 0x74 't',
//     0x75 'u', hex 0x30 '0'..0x39 '9', 0x61 'a'..0x66 'f', status
//     codes 0x6000..0x6009, magic 0x52504654 'TFPR') fit imm32 with
//     bit 31 clear so direct `cmp reg, imm32` is sign-safe.
//     0xFFFFFFFF is the one imm32 edge value where bit 31 is set --
//     we stage it via MOVABS into a scratch register and compare
//     register-to-register to avoid sign-extension corner cases.
//     The FNV offset basis 0xCBF29CE484222325 and prime
//     0x100000001B3 are imm64 constants loaded via REX.W+MOV
//     (precedent: _cmd_sig_fnv1a64 line 437, _ws_schema_hash line
//     947, _h_append embedded FNV).
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`
//     (precedent: FNV-family byte load across the five parser-tier
//     FNV sites).
//   - u32 stores via plain `mov_d [dst + disp], reg` (low 32 of
//     reg).
//   - u64 stores via plain `mov [dst + disp], reg`.
//   - Byte stores: when the index is a register and the base is also
//     a register, precompute the dst address into a scratch register
//     then `mov_b [scratch + i], reg` to sidestep the
//     `mov_b [reg + reg + off], reg` encoder gap (precedent:
//     history.pdx line 663 `mov_b [rsi + r10 * 1], rax`).
//   - `_tf_init`, `_tf_render_tag`, `_tf_correlate` are PURE LEAVES
//     with zero callee-save pushes and zero nested CALL. r11 is used
//     freely as scratch because no CALL fires.
//   - `_tf_emit` is a 6-callee-save-push frame with ZERO nested CALL
//     (FNV inlined; decimal + hex rendering unrolled). No sub-rsp
//     alignment pad is required when there is no nested CALL
//     (precedent: R229.M5 `_h_append`).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   R229.M10.1  env-mask field: an additional u32 at [record+0x38..+0x3C]
//               captures the cap-row delta between the READ and WRITE
//               phases of the turn, so the correlator can detect a
//               mid-turn capability drift (a privilege escalation that
//               the standard result-hash does not notice).
//   R229.M10.2  result-length field: an additional u32 at
//               [record+0x3C..+0x40] carries the hashed byte count so
//               an auditor can cross-check the hash input without
//               consulting the REPL's own state. Lets the smoke-mode
//               correlator detect a mid-pipeline byte truncation that
//               both ends agree on but which the result-hash alone
//               cannot distinguish from a legitimately empty result.
//   R229.M10.3  strict-mode hash-only correlator: a second
//               `_tf_correlate_strict(expected_tag, expected_len,
//               result_ptr, result_len)` that RECOMPUTES the FNV from
//               the result bytes and compares to the hash parsed out
//               of expected_tag's inner. Catches a tampered record
//               where magic + turn_id + rendered_tag match but the
//               hash field was overwritten.
//   R229.M10.4  rdtsc-skew sanity bound: the correlator rejects a
//               record whose timestamp precedes the previous turn's
//               timestamp (`_tf_correlate_sequence` over an ordered
//               array of records).
//   R229.M10.5  Smoke-mode golden corpus: 500-turn session fixture
//               under `smoke/turn-fingerprint-m10.golden.txt` with
//               one line per turn carrying the full
//               `@fingerprint("...")` tag, consumed by
//               `tools/verify-fingerprint-coverage.sh`.
//
// =============================================================================
// Upstream: paideia-os#2493 (R229 REPL evaluator umbrella),
// paideia-os#2728 (THIS ticket, R229.M10 TurnFingerprint),
// paideia-os#2659 (R222.M2 CommandSig -- FNV discipline source of
// truth), paideia-os#2670 (R223.M5 WireSink -- parallel schema-hash
// FNV leaf precedent), paideia-os#2723 (R229.M5 History -- parallel
// per-turn record precedent), paideia-os#2727 (R229.M9 Renderer --
// the sibling WRITE-side satellite that emits the tag downstream).
// Design docs: design/shell/turn-fingerprint.md (R229.M10, THIS
// landing), design/foundations/project-invariants.md P9 (the invariant
// this module makes verifiable), design/shell/history-storage.md
// (R229.M5 sibling record), design/shell/repl-loop-scaffold.md
// (R229.M1 umbrella).

module TurnFingerprint = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in rax low 32 bits)
  // ==========================================================================

  pub let TF_OK                      : u64 = 0
  pub let TF_ERR_BAD_OUT             : u64 = 0x6000
  pub let TF_ERR_OUT_TOO_SMALL       : u64 = 0x6001
  pub let TF_ERR_BAD_RESULT          : u64 = 0x6002
  pub let TF_ERR_RESULT_TOO_LARGE    : u64 = 0x6003
  pub let TF_ERR_BAD_TURN_ID         : u64 = 0x6004
  pub let TF_ERR_BAD_RECORD          : u64 = 0x6005
  pub let TF_ERR_BAD_MAGIC           : u64 = 0x6006
  pub let TF_ERR_MISMATCH            : u64 = 0x6007
  pub let TF_ERR_BAD_LEN             : u64 = 0x6008
  pub let TF_ERR_BAD_EXPECTED        : u64 = 0x6009

  // ==========================================================================
  // SECTION 2 -- RECORD + FIELD CONSTANTS
  // ==========================================================================

  pub let TF_MAGIC                   : u64 = 0x52504654   // 'TFPR' LE
  pub let TF_RECORD_BYTES            : u64 = 64
  pub let TF_RENDERED_TAG_BYTES      : u64 = 32
  pub let TF_RESULT_MAX              : u64 = 4096

  // Record field offsets.
  pub let TF_OFF_MAGIC               : u64 = 0
  pub let TF_OFF_TURN_ID             : u64 = 4
  pub let TF_OFF_RESULT_HASH         : u64 = 8
  pub let TF_OFF_TIMESTAMP           : u64 = 16
  pub let TF_OFF_RENDERED_TAG        : u64 = 24
  pub let TF_OFF_RESERVED            : u64 = 56

  // External wrapper widths.
  pub let TF_WRAPPER_PREFIX_BYTES    : u64 = 14   // `@fingerprint("`
  pub let TF_WRAPPER_SUFFIX_BYTES    : u64 = 2    // `")`

  // ==========================================================================
  // SECTION 3 -- POW10 TABLE (for variable-width decimal rendering)
  // ==========================================================================
  //
  // Mirrors R225.M7 DiagReport's `_dr_pow10` layout. The emitter walks
  // this table high-to-low (10^9 down to 10^0) and greedy-subtracts to
  // extract each decimal digit. All values are u32 (ceiling 10^9 =
  // 1_000_000_000 fits u32 with headroom; the full u32 range is
  // 4_294_967_295 which requires the pow index 9 entry).

  pub let _tf_pow10 : [u32; 10] = [
    0x3B9ACA00,                              // 1_000_000_000
    0x05F5E100,                              //   100_000_000
    0x00989680,                              //    10_000_000
    0x000F4240,                              //     1_000_000
    0x000186A0,                              //       100_000
    0x00002710,                              //        10_000
    0x000003E8,                              //         1_000
    0x00000064,                              //           100
    0x0000000A,                              //            10
    0x00000001                               //             1
  ] @align(8)

  // ==========================================================================
  // SECTION 4 -- HEX NIBBLE LOOKUP (lowercase 0-9 a-f)
  // ==========================================================================
  //
  // 16-byte table laid out as the standard ASCII glyph sequence.
  // The emitter indexes via `shr r, N; and r, 15; mov_b r, [_tf_hex + r]`.

  pub let _tf_hex_digits : [u8; 16] = [
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,     // '0'..'7'
    0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66      // '8', '9', 'a'..'f'
  ] @align(8)

  // ==========================================================================
  // SECTION 5 -- WRAPPER PREFIX LITERAL
  // ==========================================================================
  //
  // 14-byte constant `@fingerprint("` emitted at the head of every
  // `_tf_render_tag` output. Laid out in .rodata so `_tf_render_tag` can
  // byte-copy without 14 inline mov-imm stores.

  pub let _tf_prefix : [u8; 16] = [
    0x40, 0x66, 0x69, 0x6E, 0x67, 0x65, 0x72, 0x70,     // @fingerp
    0x72, 0x69, 0x6E, 0x74, 0x28, 0x22, 0x00, 0x00      // rint("<2 pad>
  ] @align(8)

  // ==========================================================================
  // _tf_init() -> ()
  //
  //   Bare `ret`. M10 holds NO .bss state.
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed tf_ini_.
  // ==========================================================================
  pub let _tf_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R229.M10 (#2728): TurnFingerprint holds no .bss state at raw M10 (every operation is caller-scratched on all four entry points). _tf_init is a bare `ret` kept for parallelism with the parser-family init-hook convention (_rd_init R229.M9, _ha_init R223.M6, _ws_init R223.M5, _ds_init R222.M8, _dm_init R222.M6, _cmdreg_init R222.M5, _st_init R223.M7). Pure leaf; zero pushes; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed tf_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _tf_emit(turn_id, result_ptr, result_len, out, out_cap) -> status
  //
  //   rdi = turn_id       (1-based; must fit u32)
  //   rsi = result_ptr    (may be 0 iff result_len == 0)
  //   rdx = result_len    (0..TF_RESULT_MAX=4096)
  //   rcx = out           (ptr to caller-owned 64-byte scratch)
  //   r8  = out_cap       (>= 64)
  //   rax = TF_OK / TF_ERR_*
  //
  //   Writes 64 bytes to out:
  //     [out+0x00..+0x04]  magic 'TFPR'
  //     [out+0x04..+0x08]  turn_id (u32)
  //     [out+0x08..+0x10]  result_hash (FNV-1a 64 of result bytes)
  //     [out+0x10..+0x18]  timestamp (rdtsc)
  //     [out+0x18..+0x38]  rendered_tag ASCII `turn.<id>.<hex>` + NUL pad
  //     [out+0x38..+0x40]  reserved u64 = 0
  //
  //   6 callee-save pushes (rbx=turn_id, rbp=result_ptr, r12=result_len,
  //   r13=out, r14=out_cap, r15=hash). No nested CALL (FNV inlined,
  //   decimal + hex rendering unrolled). No sub-rsp alignment pad
  //   needed because no nested CALL fires (precedent: R229.M5
  //   `_h_append`).
  //
  //   Register plan:
  //     rbx = turn_id (saved input; low 32 are the record's turn_id;
  //                    also the dividend for the decimal rendering)
  //     rbp = result_ptr (saved input; the FNV loop uses r8 as its
  //                       working ptr-base so rbp is preserved intact
  //                       for post-FNV reference if needed)
  //     r12 = result_len (saved input; the FNV loop uses r9 as its
  //                       working len)
  //     r13 = out (saved input; destination base for every record
  //                field store)
  //     r14 = out_cap (saved input; guard reference)
  //     r15 = hash (populated from rax after FNV completes; feeds
  //                 the hex-emission loop)
  //
  //   Labels prefixed tf_em_.
  // ==========================================================================
  pub let _tf_emit : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (turn_id: u64) (result_ptr: u64) (result_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M10 (#2728): _tf_emit produces the 64-byte TurnFingerprint record at [out, out+64). 6 callee-save pushes (rbx=turn_id, rbp=result_ptr, r12=result_len, r13=out, r14=out_cap, r15=hash); no nested CALL (FNV inlined; decimal + hex rendering unrolled) so no sub-rsp alignment pad is required (precedent R229.M5 `_h_append`). Guards: out != 0 (TF_ERR_BAD_OUT 0x6000); out_cap >= 64 (TF_ERR_OUT_TOO_SMALL 0x6001); result_len > 0 AND result_ptr == 0 (TF_ERR_BAD_RESULT 0x6002); result_len > 4096 (TF_ERR_RESULT_TOO_LARGE 0x6003); turn_id upper 32 bits != 0 (TF_ERR_BAD_TURN_ID 0x6004). The turn_id upper-32 check stages 0xFFFFFFFF via MOVABS into a scratch register and compares register-to-register (direct cmp-imm32 with bit 31 set is sign-extension-unsafe). FNV-1a 64 loop byte-identical to _cmd_sig_fnv1a64 (R222.M2), _fi_fnv1a64 (R222.M3), _cmdreg_fnv1a64 (R222.M5), _ws_schema_hash (R223.M5), and _h_append (R229.M5): rax = 0xCBF29CE484222325 (basis via REX.W+MOV); rcx = 0x100000001B3 (prime via REX.W+MOV; held across the loop); r8 = result_ptr; r9 = result_len; r10 = 0 (i); loop: cmp r10, r9 / jae done / xor r11, r11 / mov_b r11, [r8 + r10] / xor rax, r11 / xor rdx, rdx / mul rcx / add r10, 1 / jmp loop. On loop exit rax holds the hash; copy to r15. Fast-path zero-length: result_len == 0 short-circuits to rax = basis unchanged (standard FNV). After FNV: rdtsc + shl rdx, 32 + or rax, rdx -> 64-bit tsc; store at [r13+16] via plain mov. Store magic 0x52504654 'TFPR' at [r13+0] via mov_d (low 32 of rax; 0x52504654 < 0x80000000 so mov-imm32 is sign-safe). Store turn_id (rbx low 32) at [r13+4] via mov_d. Store hash (r15) at [r13+8] via plain mov. Store reserved 0 at [r13+56] via plain mov. Then the rendered_tag write pass: zero-fill [r13+24..+56] (32 B) via four u64 stores of 0; emit `turn.` (5 bytes 0x74 0x75 0x72 0x6E 0x2E) at [r13+24..+29] via five mov_b byte stores (precompute dst = r13+24 into a scratch register to sidestep the mov_b [reg+disp], reg form directly -- actually `mov_b [r13 + disp], rax` with disp fitting imm8 is well-formed since r13 is a general reg and the disp is a constant 24..28; no reg+reg indexing is required here); decimal-render turn_id (rbx) starting at [r13+29] via greedy-subtract over _tf_pow10[0..10] with emit_flag; emit `.` (0x2E) at the write cursor; hex-render r15 as 16 lowercase nibbles via unrolled `shr r, N; and r, 15; mov_b r, [_tf_hex_digits + r]; mov_b [dst + i], r` for N in 60..0 step 4. The decimal loop uses rdi (modifiable copy of rbx = turn_id) as the working dividend; r8 for pow index 0..9; rcx for pow value loaded via lea+shl+mov_d from _tf_pow10[i]; r9 as digit counter per iter; r10 for emit_flag; r11 as scratch; rsi for the dst-address recompute; rdx as the cursor-into-rendered-tag (starts at 5 after the leading `turn.`). After decimal: emit `.` at [r13+24+rdx]; rdx++. Then 16 unrolled hex nibble emits: for N in (60, 56, ..., 4, 0): compute nibble = (r15 >> N) & 15; load _tf_hex_digits[nibble] into scratch; write to [r13+24+rdx]; rdx++. Return TF_OK (rax = 0). Error returns stamp rax to the TF_ERR_* code and jump to the common epilogue which pops r15..rbx and `ret`s. All cmp immediates (0, 1, 10, 16, 32, 64, 4096, 0, 24, 29, 56, byte literals 0x74 't', 0x75 'u', 0x72 'r', 0x6E 'n', 0x2E '.', 0x30 '0', shift counts 32, 60..0 step 4, status codes 0x6000..0x6004, magic 0x52504654) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. 0xFFFFFFFF has bit 31 set so it is staged via MOVABS and compared register-to-register. The two FNV constants (0xCBF29CE484222325, 0x100000001B3) load via REX.W+MOV (precedent _cmd_sig_fnv1a64 line 437). No test (every zero-check uses `cmp reg, 0`). No and-imm64 (the one `and r, 15` fits imm8). No 2-op imul-r-imm (the one `mul rcx` in FNV is the one-op unsigned-mul form). No multiline let. Labels prefixed tf_em_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Save inputs to callee-save.
        mov rbx, rdi;                        // turn_id
        mov rbp, rsi;                        // result_ptr
        mov r12, rdx;                        // result_len
        mov r13, rcx;                        // out
        mov r14, r8;                         // out_cap

        // ---- Guard: out != 0.
        cmp r13, 0;
        je  tf_em_bad_out;

        // ---- Guard: out_cap >= 64.
        cmp r14, 64;
        jb  tf_em_oos;

        // ---- Guard: result_len <= 4096.
        cmp r12, 4096;
        ja  tf_em_result_too_large;

        // ---- Guard: result_len > 0 && result_ptr == 0 -> BAD_RESULT.
        cmp r12, 0;
        je  tf_em_result_ptr_ok;
        cmp rbp, 0;
        je  tf_em_bad_result;
      tf_em_result_ptr_ok:

        // ---- Guard: turn_id upper 32 bits must be clear.
        //      Stage 0xFFFFFFFF via MOVABS; cmp register-to-register.
        mov rax, 0xFFFFFFFF;
        cmp rbx, rax;
        ja  tf_em_bad_turn_id;

        // ===================================================================
        // FNV-1a 64 over [result_ptr, result_ptr + result_len)
        // ===================================================================
        //
        // Byte-for-byte identical to _cmd_sig_fnv1a64 (R222.M2),
        // _fi_fnv1a64 (R222.M3), _cmdreg_fnv1a64 (R222.M5),
        // _ws_schema_hash (R223.M5), and the inlined FNV in _h_append
        // (R229.M5). Offset basis 0xCBF29CE484222325; prime
        // 0x100000001B3. A zero-length input leaves rax = basis.
        //
        //   rax = hash accumulator
        //   rcx = fnv_prime (held across the loop)
        //   rdx = mul high half (clobbered each iter)
        //   r8  = ptr base
        //   r9  = len
        //   r10 = i
        //   r11 = per-byte load scratch

        mov r8, rbp;                         // r8 = result_ptr
        mov r9, r12;                         // r9 = result_len
        mov rax, 0xCBF29CE484222325;         // basis
        mov rcx, 0x100000001B3;              // prime
        xor r10, r10;                        // i = 0

      tf_em_fnv_loop:
        cmp r10, r9;
        jae tf_em_fnv_done;

        xor r11, r11;
        mov_b r11, [r8 + r10];               // byte load
        xor rax, r11;                        // h ^= byte

        xor rdx, rdx;                        // clear mul high half
        mul rcx;                             // rdx:rax = rax * prime

        add r10, 1;
        jmp tf_em_fnv_loop;

      tf_em_fnv_done:
        mov r15, rax;                        // r15 = result_hash

        // ===================================================================
        // Write fixed fields: magic, turn_id, result_hash, timestamp.
        // ===================================================================

        // ---- magic 'TFPR' u32 at [out+0].
        mov rax, 0x52504654;                 // 'TFPR' LE (byte-seq T F P R)
        mov_d [r13 + 0], rax;

        // ---- turn_id u32 at [out+4]  (low 32 of rbx).
        mov_d [r13 + 4], rbx;

        // ---- result_hash u64 at [out+8].
        mov [r13 + 8], r15;

        // ---- timestamp u64 at [out+16] via rdtsc.
        rdtsc;                               // edx:eax = TSC
        shl rdx, 32;
        or  rax, rdx;
        mov [r13 + 16], rax;

        // ---- reserved u64 at [out+56] = 0.
        xor rax, rax;
        mov [r13 + 56], rax;

        // ===================================================================
        // Rendered-tag write pass: 32 bytes at [out+24..+56].
        // ===================================================================
        //
        // Step 1: zero-fill 32 bytes via four u64 stores. This also
        // handles NUL-padding past the live tail of the ASCII tag.

        xor rax, rax;
        mov [r13 + 24], rax;
        mov [r13 + 32], rax;
        mov [r13 + 40], rax;
        mov [r13 + 48], rax;

        // ---- Emit `turn.` (5 bytes) at [out+24..+29].
        //      Each `mov_b [r13 + <const disp>], rax` has imm8 disp
        //      which the encoder handles natively (no reg+reg idx).
        mov rax, 0x74;                       // 't'
        mov_b [r13 + 24], rax;
        mov rax, 0x75;                       // 'u'
        mov_b [r13 + 25], rax;
        mov rax, 0x72;                       // 'r'
        mov_b [r13 + 26], rax;
        mov rax, 0x6E;                       // 'n'
        mov_b [r13 + 27], rax;
        mov rax, 0x2E;                       // '.'
        mov_b [r13 + 28], rax;

        // ---- Decimal-render turn_id (rbx) starting at [out+29].
        //
        //      Greedy-subtract over _tf_pow10[0..10]. Writes at
        //      [out+24+cursor] where cursor advances per emitted digit.
        //      Cursor starts at 5 (just past `turn.`).
        //
        //      Register use within this block:
        //        rdi = working turn_id (modifiable copy of rbx; rbx
        //              itself is preserved for debuggability)
        //        r8  = pow index (0..9; outer loop)
        //        rcx = pow value (loaded each outer iter from
        //              _tf_pow10[i])
        //        r9  = digit counter per outer iter
        //        r10 = emit_flag (0 initially; 1 once first non-zero
        //              digit emitted)
        //        rdx = cursor (byte offset into rendered_tag; starts
        //              at 5)
        //        r11 = scratch (dst-address compute; char = '0' + d)
        //        rsi = pow table scratch (lea + shl)
        //
        //      Edge case: turn_id == 0. The greedy loop emits nothing
        //      (every digit is 0 and emit_flag stays 0); the fallback
        //      at tf_em_dec_done emits a single '0' and advances
        //      cursor.

        mov rdi, rbx;                        // rdi = working turn_id
        xor r8, r8;                          // i = 0
        xor r10, r10;                        // emit_flag = 0
        mov rdx, 5;                          // cursor = 5

      tf_em_dec_pow_loop:
        cmp r8, 10;
        jae tf_em_dec_done;

        // Load pow = _tf_pow10[i] (u32 stride 4).
        mov rsi, r8;
        shl rsi, 2;
        lea r11, [rip + _tf_pow10];
        add r11, rsi;
        xor rcx, rcx;
        mov_d rcx, [r11 + 0];                // rcx = pow

        // Inner greedy subtract: digit = 0; while rdi >= rcx:
        //                        rdi -= rcx; digit += 1.
        xor r9, r9;                          // digit = 0

      tf_em_dec_sub_loop:
        cmp rdi, rcx;
        jb  tf_em_dec_digit_done;
        sub rdi, rcx;
        add r9, 1;
        jmp tf_em_dec_sub_loop;

      tf_em_dec_digit_done:
        // Emit digit iff digit > 0 OR emit_flag != 0.
        cmp r9, 0;
        jne tf_em_dec_emit;
        cmp r10, 0;
        je  tf_em_dec_next;

      tf_em_dec_emit:
        // char = '0' + digit (0x30 + r9 low byte).
        mov r11, 48;
        add r11, r9;
        // dst = r13 + 24 + cursor.
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;
        mov r10, 1;                          // emit_flag := 1

      tf_em_dec_next:
        add r8, 1;
        jmp tf_em_dec_pow_loop;

      tf_em_dec_done:
        // If nothing was emitted (turn_id was 0), emit a single '0'.
        cmp r10, 0;
        jne tf_em_dec_separator;
        mov r11, 48;                         // '0'
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;

      tf_em_dec_separator:
        // Emit `.` separator at [out+24+cursor].
        mov r11, 46;                         // '.'
        mov rsi, r13;
        add rsi, 24;
        add rsi, rdx;
        mov_b [rsi + 0], r11;
        add rdx, 1;

        // ---- Hex-render r15 (result_hash) as 16 lowercase nibbles.
        //
        //      Unrolled per nibble position. For each nibble (high
        //      first = shift 60, 56, ..., 4, 0):
        //        tmp = (r15 >> N) & 15
        //        char = _tf_hex_digits[tmp]
        //        write char at [out+24+cursor]
        //        cursor += 1

        // Pre-stage the hex table base.
        lea rsi, [rip + _tf_hex_digits];

        // Nibble 15 (bits 63..60).
        mov r9, r15;
        shr r9, 60;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 14 (bits 59..56).
        mov r9, r15;
        shr r9, 56;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 13 (bits 55..52).
        mov r9, r15;
        shr r9, 52;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 12 (bits 51..48).
        mov r9, r15;
        shr r9, 48;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 11 (bits 47..44).
        mov r9, r15;
        shr r9, 44;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 10 (bits 43..40).
        mov r9, r15;
        shr r9, 40;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 9 (bits 39..36).
        mov r9, r15;
        shr r9, 36;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 8 (bits 35..32).
        mov r9, r15;
        shr r9, 32;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 7 (bits 31..28).
        mov r9, r15;
        shr r9, 28;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 6 (bits 27..24).
        mov r9, r15;
        shr r9, 24;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 5 (bits 23..20).
        mov r9, r15;
        shr r9, 20;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 4 (bits 19..16).
        mov r9, r15;
        shr r9, 16;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 3 (bits 15..12).
        mov r9, r15;
        shr r9, 12;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 2 (bits 11..8).
        mov r9, r15;
        shr r9, 8;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 1 (bits 7..4).
        mov r9, r15;
        shr r9, 4;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // Nibble 0 (bits 3..0).
        mov r9, r15;
        and r9, 15;
        xor r11, r11;
        mov_b r11, [rsi + r9];
        mov r8, r13;
        add r8, 24;
        add r8, rdx;
        mov_b [r8 + 0], r11;
        add rdx, 1;

        // ---- Return TF_OK.
        xor rax, rax;
        jmp tf_em_epilogue;

      tf_em_bad_out:
        mov rax, 0x6000;                     // TF_ERR_BAD_OUT
        jmp tf_em_epilogue;

      tf_em_oos:
        mov rax, 0x6001;                     // TF_ERR_OUT_TOO_SMALL
        jmp tf_em_epilogue;

      tf_em_bad_result:
        mov rax, 0x6002;                     // TF_ERR_BAD_RESULT
        jmp tf_em_epilogue;

      tf_em_result_too_large:
        mov rax, 0x6003;                     // TF_ERR_RESULT_TOO_LARGE
        jmp tf_em_epilogue;

      tf_em_bad_turn_id:
        mov rax, 0x6004;                     // TF_ERR_BAD_TURN_ID
        jmp tf_em_epilogue;

      tf_em_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _tf_render_tag(record, out, out_cap) -> packed_u64
  //
  //   rdi = record     (ptr to 64-byte TurnFingerprint record)
  //   rsi = out        (ptr to caller-owned output buffer)
  //   rdx = out_cap    (>= 16 at minimum)
  //   rax = (bytes_written << 32) | status
  //
  //   Emits `@fingerprint("<inner>")` where <inner> is copied from
  //   record[+0x18..+0x18+N] up to the first NUL or offset 32.
  //
  //   Validates:
  //     record != 0                           (TF_ERR_BAD_RECORD)
  //     out != 0                              (TF_ERR_BAD_OUT)
  //     record[+0..+4] == 'TFPR' LE           (TF_ERR_BAD_MAGIC)
  //     out_cap >= 16 + inner_len             (TF_ERR_OUT_TOO_SMALL)
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed tf_rt_.
  // ==========================================================================
  pub let _tf_render_tag : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (record: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M10 (#2728): _tf_render_tag emits `@fingerprint(\"<inner>\")` where <inner> is copied from record[+24..+24+N] up to the first NUL or offset 32. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rdi != 0 (TF_ERR_BAD_RECORD 0x6005); rsi != 0 (TF_ERR_BAD_OUT 0x6000); u32 at [rdi+0] == 0x52504654 'TFPR' LE (TF_ERR_BAD_MAGIC 0x6006). (2) Compute inner_len by scanning record+24..record+56 for first NUL (byte load into r11, cmp r11, 0, je done). r9 holds inner_len. (3) Compute needed = 16 + inner_len into r10. (4) Guard rdx >= r10 (TF_ERR_OUT_TOO_SMALL 0x6001). (5) Emit prefix: byte-copy 14 bytes from _tf_prefix[0..14] to rsi[0..14]. Use a byte-stepping loop with precomputed source + dst bases. (6) Byte-copy inner_len bytes from record+24 to rsi+14. (7) Emit suffix `\")` (2 bytes 0x22 0x29) at [rsi + 14 + inner_len]. (8) Return packed_u64 = (needed << 32) | TF_OK. All cmp immediates (0, 14, 16, 24, 32, 56, byte literals 0x22 0x29, magic 0x52504654, status codes 0x6000..0x6006) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed tf_rt_.",
      block: {
        // ---- Guard: record != 0.
        cmp rdi, 0;
        je  tf_rt_bad_record;

        // ---- Guard: out != 0.
        cmp rsi, 0;
        je  tf_rt_bad_out;

        // ---- Guard: magic 'TFPR' at [record+0].
        xor rax, rax;
        mov_d rax, [rdi + 0];
        cmp rax, 0x52504654;                 // 'TFPR' LE
        jne tf_rt_bad_magic;

        // ---- Compute inner_len by scanning record+24..record+56.
        //
        //   r8  = record + 24 (inner base; precomputed, held across scan)
        //   r9  = i  (inner_len accumulator)
        //
        //   Loop: while i < 32: load byte at [r8 + i]; if 0 break; i++.

        mov r8, rdi;
        add r8, 24;                          // r8 = &record.rendered_tag
        xor r9, r9;                          // r9 = i = 0

      tf_rt_scan_loop:
        cmp r9, 32;
        jae tf_rt_scan_done;
        xor r11, r11;
        mov_b r11, [r8 + r9];
        cmp r11, 0;
        je  tf_rt_scan_done;
        add r9, 1;
        jmp tf_rt_scan_loop;

      tf_rt_scan_done:
        // r9 = inner_len.

        // ---- Compute needed = 16 + inner_len; guard out_cap >= needed.
        mov r10, r9;
        add r10, 16;
        cmp rdx, r10;
        jb  tf_rt_oos;

        // ---- Emit prefix (14 bytes) from _tf_prefix to out[0..14].
        //
        //   lea rcx, [rip + _tf_prefix]  -- src base
        //   xor rax, rax                 -- i = 0
        //   loop: cmp rax, 14; jae done; byte load; byte store; i++.

        lea rcx, [rip + _tf_prefix];
        xor rax, rax;

      tf_rt_pre_loop:
        cmp rax, 14;
        jae tf_rt_pre_done;
        xor r11, r11;
        mov_b r11, [rcx + rax];
        // dst = rsi + rax; precompute into r8-scratch (clobbering the
        // inner-base r8 is safe here because the inner copy that
        // follows re-derives its own base from rdi + 24).
        mov r8, rsi;
        add r8, rax;
        mov_b [r8 + 0], r11;
        add rax, 1;
        jmp tf_rt_pre_loop;

      tf_rt_pre_done:

        // ---- Byte-copy inner bytes from record+24 to out+14 (inner_len
        //      bytes).
        //
        //   r8  = &record[24] (re-derived; loop-held)
        //   rcx = &out[14]    (loop-held dst base)
        //   rax = i           (0..inner_len)
        //   r11 = per-byte source scratch
        //   rdi = per-byte dst-address scratch (we no longer need the
        //         caller's record pointer -- r8 carries the inner base
        //         so rdi is free to clobber as caller-save scratch;
        //         touching r12/rbx/rbp/r13/r14/r15 is OFF LIMITS inside
        //         this pure-leaf frame because there is no callee-save
        //         push bracket to restore them before `ret`)

        mov r8, rdi;
        add r8, 24;
        mov rcx, rsi;
        add rcx, 14;
        xor rax, rax;

      tf_rt_inner_loop:
        cmp rax, r9;
        jae tf_rt_inner_done;
        xor r11, r11;
        mov_b r11, [r8 + rax];
        mov rdi, rcx;
        add rdi, rax;
        mov_b [rdi + 0], r11;
        add rax, 1;
        jmp tf_rt_inner_loop;

      tf_rt_inner_done:

        // ---- Emit suffix `")` (2 bytes 0x22 0x29) at out[14 + inner_len].
        //
        //   dst_base = out + 14 + inner_len; written at [dst+0] and [dst+1].

        mov rcx, rsi;
        add rcx, 14;
        add rcx, r9;
        mov rax, 0x22;                       // '"'
        mov_b [rcx + 0], rax;
        mov rax, 0x29;                       // ')'
        mov_b [rcx + 1], rax;

        // ---- Pack return: (bytes_written << 32) | TF_OK.
        //      bytes_written = 16 + inner_len = r10.
        mov rax, r10;
        shl rax, 32;                         // (needed << 32) | 0
        ret;

      tf_rt_bad_record:
        mov rax, 0x6005;                     // TF_ERR_BAD_RECORD
        ret;

      tf_rt_bad_out:
        mov rax, 0x6000;                     // TF_ERR_BAD_OUT
        ret;

      tf_rt_bad_magic:
        mov rax, 0x6006;                     // TF_ERR_BAD_MAGIC
        ret;

      tf_rt_oos:
        mov rax, 0x6001;                     // TF_ERR_OUT_TOO_SMALL
        ret;
      }
    }

  // ==========================================================================
  // _tf_correlate(expected_tag, expected_len, actual_record, record_len) -> status
  //
  //   rdi = expected_tag
  //   rsi = expected_len
  //   rdx = actual_record
  //   rcx = record_len
  //   rax = TF_OK (0) iff expected_tag renders byte-identically to
  //         `@fingerprint("<actual_record.rendered_tag>")`
  //
  //   The debugger's compare entry. Avoids a scratch buffer by:
  //     (a) verifying expected_tag[0..14] == `@fingerprint("`;
  //     (b) verifying expected_tag[expected_len-2..] == `")`;
  //     (c) extracting inner_len = expected_len - 16;
  //     (d) byte-comparing expected_tag[14..14+inner_len] against
  //         record[+24..+24+inner_len];
  //     (e) requiring record[+24+inner_len] == NUL (or inner_len==32).
  //
  // Pure leaf -- zero callee-save push, no stack frame, no nested CALL.
  // Labels prefixed tf_co_.
  // ==========================================================================
  pub let _tf_correlate : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (expected_tag: u64) (expected_len: u64) (actual_record: u64) (record_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R229.M10 (#2728): _tf_correlate compares an expected `@fingerprint(\"...\")` tag against the record a shell actually emitted. Pure leaf; zero pushes; no stack frame; no nested CALL. Flow: (1) Validate rcx == 64 (TF_ERR_BAD_LEN 0x6008); rdx != 0 (TF_ERR_BAD_RECORD 0x6005); rdi != 0 (TF_ERR_BAD_EXPECTED 0x6009); rsi >= 16 (TF_ERR_BAD_LEN); u32 at [rdx+0] == 0x52504654 (TF_ERR_BAD_MAGIC 0x6006). (2) Verify prefix: compare 14 bytes at [expected_tag + 0..14] against _tf_prefix[0..14]. Mismatch -> TF_ERR_BAD_LEN (missing wrapper). (3) Verify suffix: byte at [expected_tag + expected_len - 2] == 0x22 '\"' AND byte at [expected_tag + expected_len - 1] == 0x29 ')'. Mismatch -> TF_ERR_BAD_LEN. (4) Compute inner_len = expected_len - 16; guard inner_len <= 32 (TF_ERR_MISMATCH 0x6007 if the record's rendered_tag field only holds 32 bytes). (5) Byte-compare expected_tag[14..14+inner_len] against actual_record[24..24+inner_len]: on any mismatch -> TF_ERR_MISMATCH. (6) If inner_len < 32, verify actual_record[24+inner_len] == 0 (NUL terminator; a record whose rendered_tag is LONGER than the expected inner is a mismatch); else (inner_len == 32) accept as-is since the field maxes at 32 bytes. (7) Return TF_OK. All cmp immediates (0, 1, 2, 14, 16, 32, 56, 64, byte literals 0x22 0x29, magic 0x52504654, status codes 0x6005..0x6009) fit imm32 with bit 31 clear so direct cmp-imm32 is sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed tf_co_. r11 is used freely as scratch because no CALL fires.",
      block: {
        // ---- Guard: record_len == 64.
        cmp rcx, 64;
        jne tf_co_bad_len;

        // ---- Guard: actual_record != 0.
        cmp rdx, 0;
        je  tf_co_bad_record;

        // ---- Guard: expected_tag != 0.
        cmp rdi, 0;
        je  tf_co_bad_expected;

        // ---- Guard: expected_len >= 16.
        cmp rsi, 16;
        jb  tf_co_bad_len;

        // ---- Guard: magic 'TFPR' at [actual_record+0].
        xor rax, rax;
        mov_d rax, [rdx + 0];
        cmp rax, 0x52504654;
        jne tf_co_bad_magic;

        // ===================================================================
        // Verify prefix: expected_tag[0..14] vs _tf_prefix[0..14].
        // ===================================================================
        //
        //   r8  = &_tf_prefix (loop-held)
        //   r9  = expected_tag (loop-held source)
        //   rax = i (0..14)
        //   r10 = byte from expected_tag
        //   r11 = byte from _tf_prefix

        lea r8, [rip + _tf_prefix];
        mov r9, rdi;
        xor rax, rax;

      tf_co_pre_loop:
        cmp rax, 14;
        jae tf_co_pre_done;
        xor r10, r10;
        mov_b r10, [r9 + rax];
        xor r11, r11;
        mov_b r11, [r8 + rax];
        cmp r10, r11;
        jne tf_co_bad_len;                   // prefix mismatch = missing wrapper
        add rax, 1;
        jmp tf_co_pre_loop;

      tf_co_pre_done:

        // ===================================================================
        // Verify suffix: expected_tag[expected_len - 2] == '"' AND
        //                expected_tag[expected_len - 1] == ')'.
        // ===================================================================

        mov r8, rsi;
        sub r8, 2;                           // r8 = expected_len - 2
        mov r9, rdi;
        add r9, r8;                          // r9 = &expected_tag[len - 2]
        xor r10, r10;
        mov_b r10, [r9 + 0];
        cmp r10, 0x22;                       // '"'
        jne tf_co_bad_len;
        xor r10, r10;
        mov_b r10, [r9 + 1];
        cmp r10, 0x29;                       // ')'
        jne tf_co_bad_len;

        // ===================================================================
        // Byte-compare inner.
        // ===================================================================
        //
        //   inner_len = expected_len - 16  (prefix 14 + suffix 2)
        //   Guard: inner_len <= 32.
        //   r8 = inner_len
        //   r9 = &expected_tag[14] (source)
        //   r10 = &actual_record[24] (source)
        //   rax = i (0..inner_len)

        mov r8, rsi;
        sub r8, 16;                          // r8 = inner_len
        cmp r8, 32;
        ja  tf_co_mismatch;                  // inner longer than record field

        mov r9, rdi;
        add r9, 14;                          // r9 = &expected_tag[14]
        mov r10, rdx;
        add r10, 24;                         // r10 = &actual_record[24]
        xor rax, rax;

      tf_co_cmp_loop:
        cmp rax, r8;
        jae tf_co_cmp_done;
        xor r11, r11;
        mov_b r11, [r9 + rax];
        xor rcx, rcx;
        mov_b rcx, [r10 + rax];
        cmp r11, rcx;
        jne tf_co_mismatch;
        add rax, 1;
        jmp tf_co_cmp_loop;

      tf_co_cmp_done:

        // ===================================================================
        // If inner_len < 32: verify record[24 + inner_len] == 0 so the
        // record's live tag is not LONGER than the expected inner.
        // ===================================================================

        cmp r8, 32;
        je  tf_co_ok;                        // record tag maxes out at 32

        xor r11, r11;
        mov_b r11, [r10 + r8];               // byte at &record[24 + inner_len]
        cmp r11, 0;
        jne tf_co_mismatch;                  // record has more bytes = mismatch

      tf_co_ok:
        xor rax, rax;                        // TF_OK
        ret;

      tf_co_bad_len:
        mov rax, 0x6008;                     // TF_ERR_BAD_LEN
        ret;

      tf_co_bad_record:
        mov rax, 0x6005;                     // TF_ERR_BAD_RECORD
        ret;

      tf_co_bad_expected:
        mov rax, 0x6009;                     // TF_ERR_BAD_EXPECTED
        ret;

      tf_co_bad_magic:
        mov rax, 0x6006;                     // TF_ERR_BAD_MAGIC
        ret;

      tf_co_mismatch:
        mov rax, 0x6007;                     // TF_ERR_MISMATCH
        ret;
      }
    }

}
