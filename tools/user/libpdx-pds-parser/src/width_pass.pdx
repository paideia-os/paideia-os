// src/width_pass.pdx -- libpdx-pds-parser (paideia-os#2653, R221.M3)
//
// WidthPass: parser-tier TR#11 (East Asian Width) column classifier +
// cluster-aware column accumulator. Drives cursor-advance and
// column-math for the pds-lang REPL line editor and the terminal
// grid renderer.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R221.M3 of the semantic-shell parser-tier Unicode umbrella
// (paideia-os#2485). R221.M1 (utf8_nfc.pdx) landed the UTF-8 decoder +
// NFC normaliser; R221.M2 (grapheme_iter.pdx) landed the TR#29
// grapheme-cluster-boundary iterator; R221.M3 (THIS module) layers
// the TR#11 column classifier on top so the renderer and the line
// editor can answer:
//
//   * "How many columns does this cp occupy?"             _wp_char_width
//   * "How many columns does this cluster occupy?"        _wp_cluster_width
//   * "How many columns does this entire string occupy?"  _wp_cols
//
// plus two locale-amb accessors:
//
//   * "What width should the Ambiguous class use today?"  _wp_locale_amb_width
//   * "Switch the Ambiguous class default (1 or 2)."       _wp_set_locale_amb
//
// The parser-tier wrapper intentionally does NOT re-ship the primary
// EAW classification table. That ~16 KiB "Latin + CJK + emoji +
// Hangul" range table already lives one tier down in the substrate
// (libpdx-unicode-tables/src/width.pdx `_width_char`, R131.M5) --
// duplicating it here would be a maintenance liability every time
// the UCD moves. Instead this module:
//
//   1. Delegates the primary width question (W/F/H/Na/N/zero-width)
//      to the substrate's `_width_char`.
//   2. OVERLAYS a parser-tier Ambiguous (A-class) range table in its
//      own `.rodata` that applies iff the active locale asks for
//      Ambiguous==2 (East-Asian default).
//
// Entry points:
//
//   _wp_char_width       (cp)                            -> width_u64
//   _wp_cluster_width    (bytes_ptr, bytes_len)          -> width_u64
//   _wp_cols             (bytes_ptr, bytes_len)          -> packed_u64
//                                                           (cols << 32) | status
//   _wp_locale_amb_width ()                              -> u64 in {1,2}
//   _wp_set_locale_amb   (width)                         -> status
//
// `_wp_char_width` / `_wp_cluster_width` / `_wp_locale_amb_width`
// return width in {0, 1, 2} in the low byte of rax; the upper bits
// are zero. `_wp_cols` packs the running column count in bits
// [63:32] and a parser-tier WP_* status code in bits [31:0]; the
// partial accumulator is still meaningful on INVALID_UTF8 (columns
// consumed up to the malformed byte).
//
// Status taxonomy (returned in low 32 bits of _wp_cols's packed
// result, or in rax for _wp_set_locale_amb):
//
//   WP_OK                      = 0
//   WP_ERR_INVALID_UTF8        = 0x3F00   substrate / _gi_next_cluster
//                                         reported invalid UTF-8 at the
//                                         current cursor.
//   WP_ERR_BAD_LOCALE_WIDTH    = 0x3F01   _wp_set_locale_amb called with
//                                         a width not in {1, 2}.
//
// Slots 0x3F02..0x3FFF are reserved for M3.1+ follow-ups (locale-
// aware Ambiguous expansion, Hangul-Jamo scalar handling, line-break
// TR#14 integration).
//
// =============================================================================
// WHY A PARSER-TIER WRAPPER
// =============================================================================
//
// Substrate `_width_char` (R131.M5) answers the "pure" TR#11 question
// for a decoded code point: it folds the UCD East-Asian-Width property
// into {0, 1, 2} using the standard reduced-EAW baseline (combining
// marks + controls + ZWJ + variation selectors ->  0; CJK + Hiragana
// + Katakana + Hangul + fullwidth + emoji -> 2; everything else -> 1).
// What it does NOT give callers out of the box:
//
// 1. **A cluster-aware entry point.** TR#11 columns are COUNTED PER
//    CLUSTER, not per code point: a Latin base + combining diacritic
//    is one visual column, not one-plus-zero. The parser-tier
//    `_wp_cluster_width` and `_wp_cols` walk the TR#29 cluster graph
//    (via R221.M2's `_gi_next_cluster`) and decode each cluster's
//    base cp (via substrate `utf8_decode_cp`) before asking the
//    substrate for its EAW class.
//
// 2. **A locale-sensitive Ambiguous hook.** UAX #11 §4 says the
//    Ambiguous class (A) is "wide" (2) under East-Asian locales and
//    "narrow" (1) elsewhere. The substrate conservatively returns 1
//    for every A-class code point (silently widening would misalign
//    every Western terminal grid). The parser-tier wrapper owns the
//    locale-switch state (`.bss` singleton `_wp_locale_amb_state`)
//    AND a parser-tier A-class range table that overlays the
//    substrate's narrow-default when the active locale asks for
//    Ambiguous==2.
//
// 3. **A single error band disjoint from the substrate's.** The
//    substrate's `_width_str` returns `W_STATUS_INVALID_UTF8 = 2` in
//    the low 8 bits of a packed return; `_gi_next_cluster` returns
//    `GI_ERR_INVALID_UTF8 = 0x3800` in the low 32 bits of ITS packed
//    return. The parser-tier wrapper lifts both into
//    `WP_ERR_INVALID_UTF8 = 0x3F00` so a downstream REPL dispatcher
//    can discriminate "width-pass fault" from "grapheme-iter fault"
//    from "substrate fault" without further context.
//
// =============================================================================
// A-CLASS RANGE TABLE
// =============================================================================
//
// The parser-tier A-class table is a sorted array of (lo_cp, hi_cp)
// u32 pairs covering the ranges that UAX #11 marks Ambiguous and
// that most-overlap with CJK terminal fonts' double-width cells.
// At M3 the table is a coarse approximation (18 ranges = 144 bytes)
// that over-covers slightly in favour of simpler lookup; M3.1 lands
// a precise UCD-driven A-class table.
//
// Table entries (sorted ascending by lo_cp):
//
//   0x00A1..0x00FE   Latin-1 Supplement (coarse)
//   0x0100..0x024F   Latin Extended-A + part of Extended-B
//   0x02B0..0x02FF   Spacing modifier letters
//   0x0370..0x03FF   Greek + Coptic
//   0x0400..0x04FF   Cyrillic
//   0x2010..0x2027   General Punctuation (coarse)
//   0x2030..0x203A   General Punctuation
//   0x2074..0x208E   Super/subscript + currency symbols (coarse)
//   0x2100..0x214F   Letterlike Symbols
//   0x2150..0x218F   Number Forms
//   0x2190..0x21FF   Arrows
//   0x2200..0x22FF   Mathematical Operators
//   0x2460..0x24FF   Enclosed Alphanumerics
//   0x2500..0x259F   Box Drawing + Block Elements
//   0x25A0..0x25FF   Geometric Shapes
//   0x2600..0x26FF   Miscellaneous Symbols
//   0x2700..0x27BF   Dingbats (coarse)
//   0x2B55..0x2B59   Heavy large circle neighbourhood
//
// The table is scanned linearly on an A-class lookup. The scan is
// O(N) where N = 18 ranges = 18 cmp+branch pairs = ~36 fused uops;
// well within the "100 kchar/s on QEMU" target even with locale
// amb==2 (which triggers the overlay for every cp whose substrate
// classification returned narrow). M3.1 will swap in a binary search
// once the table grows past ~64 entries.
//
// Table coverage note: ranges are intentionally slightly conservative
// (over-cover) at M3; a precise table lands at M3.1. The over-coverage
// manifests only when `_wp_locale_amb_width()` reports 2 (East-Asian
// locale) AND the cp is in the overlay range AND is actually Neutral
// rather than Ambiguous in UAX #11. For the baseline terminal use
// case (box drawing, letterlike symbols, arrows), the over-coverage
// is harmless -- those ranges are predominantly Ambiguous anyway.
//
// =============================================================================
// CROSS-MODULE LINKAGE
// =============================================================================
//
// Three external symbols resolved at link time:
//
//   _width_char        (libpdx-unicode-tables::Width, R131.M5)
//   utf8_decode_cp     (libpdx-unicode-tables::Utf8, R131.M1)
//   _gi_next_cluster   (libpdx-pds-parser::GraphemeIter, R221.M2;
//                       intra-library, no --extra-obj-dir needed)
//
// The two cross-library symbols resolve via
// `--extra-obj-dir tools/user/libpdx-unicode-tables/build-out`,
// matching the shape R221.M1/M2 already use.
//
// =============================================================================
// TARGET THROUGHPUT
// =============================================================================
//
// `_wp_cols` is the hot path. Per-cluster inner loop:
//
//   _gi_next_cluster:   1 CALL (fast path = pure leaf, ~20 insns;
//                       slow path = CALL into substrate _gc_next)
//   utf8_decode_cp:     1 CALL (pure leaf, decode base cp)
//   _wp_char_width:     1 CALL -> _width_char (substrate pure leaf,
//                       <= 11 cmp+branch pairs); plus A-class overlay
//                       scan (<= 18 cmp pairs) iff locale amb==2 AND
//                       substrate returned narrow.
//
// At ~80-120 cycles per cluster, QEMU-TCG tops out around 100-150
// kchar/s on an ASCII-heavy prompt; the target is 100 kchar/s per
// the issue brief.
//
// =============================================================================
// NFC / NFKD INTERACTION
// =============================================================================
//
// Width is measured on the input bytes AS-IS; callers that want
// "visual width of the user-typed form" pass raw bytes, callers that
// want "visual width of the canonical form" pre-normalise via R221.M1.
// The two forms agree under NFC/NFD because combining marks are
// width-0 in both forms; they DISAGREE under NFKD/NFKC on fullwidth-
// ASCII inputs (U+FF21 'Ａ' is wide=2 but decomposes to 'A' which is
// narrow=1). The parser-tier wrapper takes no position on which form
// is "correct" -- it reports what the caller passed.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask (0xFF, 0xFFFFFFFF) fits imm32
//     sign-safe (bit 31 clear).
//   - No 2-op `imul r, imm` -- the A-class table stride is 8 bytes
//     per (lo, hi) pair, implemented via `shl rN, 3`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `WidthPass` matches `width_pass.pdx`.
//   - Labels prefixed `wp_` with per-function suffix: `wp_cw_` for
//     `_wp_char_width`, `wp_cl_` for `_wp_cluster_width`, `wp_co_`
//     for `_wp_cols`, `wp_la_` for `_wp_locale_amb_width`, `wp_sl_`
//     for `_wp_set_locale_amb`. Disjoint from paideia-as reserved
//     keywords (`loop`, `if`, `let`, `fn`, `ret`, `done`) and from
//     every sibling parser-tier module's label prefix (`u8n_`,
//     `gi_`, `ss_`, `cs_`, `fi_`, `afs_`, `pl_`, `rp_`, `ll_`,
//     `cc_`, `hm_`, `rt_`, `dl_`, `se_`, `te_`).
//   - All `cmp reg, imm` immediates <= 0x3F01 < 0x80000000 so direct
//     `cmp reg, imm32` is sign-extension-safe. The highest cp
//     referenced in the A-class table is 0x2B59 which is also <
//     0x80000000. No MOVABS staging needed.
//   - Byte loads via `mov_b` (zero-extends into full qword).
//   - u32 loads via `mov_d` (zero-extends into full qword).
//   - r11 is NEVER held across a nested CALL -- values that survive
//     go in r12..r15 or stack.
//   - Full-u64 compares on status (Wave 118 lesson -- a bare
//     `and rN, 0xFF` on a status that contains 0x3F00 or 0x3800
//     aliases to 0, which would spin a cluster-walk loop forever).
//     The _wp_cols loop does a `shl r11, 32; shr r11, 32` low-32
//     extraction before comparing against 0x3800 and 0x3F00.
//   - Entry rsp%16==8 preserved per SysV; pre-nested-CALL rsp%16==0
//     enforced through push count parity (see per-function headers).
//
// =============================================================================
// FORWARD PATH
// =============================================================================
//
//   M3.1  Precise UCD-driven A-class table (replaces the 18-range
//         coarse overlay). Property source: UCD-15.1
//         EastAsianWidth.txt filtered to A-class entries.
//   M3.2  Hangul Jamo scalar handling: L / V / T jamos in
//         U+1100..U+11FF carry width per their composition rule
//         (L and V alone are wide=2, T is narrow=0 as a trailing
//         combining form).
//   M3.3  TR#14 line-break integration (optional break opportunities
//         inside the column walk).
//   M4    Context-tracking lexer consumes `_wp_cols` output for
//         prompt + diagnostic rendering.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2653 (THIS
// ticket, R221.M3). Substrate: paideia-os#2616 (R131.M5 width),
// paideia-os#2612 (R131.M1 UTF-8), paideia-os#2652 (R221.M2
// GraphemeIter). Design doc: design/shell/width-pass-tr11.md.

module WidthPass = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let WP_OK                     : u64 = 0
  pub let WP_ERR_INVALID_UTF8       : u64 = 0x3F00
  pub let WP_ERR_BAD_LOCALE_WIDTH   : u64 = 0x3F01

  // ==========================================================================
  // SECTION 2 -- LOCALE AMBIGUOUS WIDTH CONSTANTS
  // ==========================================================================
  //
  // The `.bss` state `_wp_locale_amb_state` stores (width - 1): a
  // zero-initialised byte then naturally decodes to A-width==1
  // (narrow default) without an explicit init call. Callers read via
  // `_wp_locale_amb_width()` which adds 1 before returning.

  pub let WP_LOCALE_AMB_NARROW : u64 = 1    // Western default
  pub let WP_LOCALE_AMB_WIDE   : u64 = 2    // East-Asian locale

  // ==========================================================================
  // SECTION 3 -- A-CLASS RANGE TABLE (parser-tier overlay in .rodata)
  // ==========================================================================
  //
  // 18 ranges = 36 u32 values = 144 bytes aligned to 8. Scanned
  // linearly in `_wp_char_width` when the substrate reports narrow
  // AND the active locale amb width is 2. See the "A-CLASS RANGE
  // TABLE" header section for the coverage rationale.

  pub let WP_AMB_RANGES_LEN : u64 = 18

  pub let _wp_amb_ranges : [u32; 36] = [
    0x000000A1, 0x000000FE,        // Latin-1 Supplement
    0x00000100, 0x0000024F,        // Latin Extended-A + partial B
    0x000002B0, 0x000002FF,        // Spacing modifier letters
    0x00000370, 0x000003FF,        // Greek + Coptic
    0x00000400, 0x000004FF,        // Cyrillic
    0x00002010, 0x00002027,        // General Punctuation (coarse)
    0x00002030, 0x0000203A,        // General Punctuation
    0x00002074, 0x0000208E,        // Super/subscripts (coarse)
    0x00002100, 0x0000214F,        // Letterlike Symbols
    0x00002150, 0x0000218F,        // Number Forms
    0x00002190, 0x000021FF,        // Arrows
    0x00002200, 0x000022FF,        // Mathematical Operators
    0x00002460, 0x000024FF,        // Enclosed Alphanumerics
    0x00002500, 0x0000259F,        // Box Drawing + Block Elements
    0x000025A0, 0x000025FF,        // Geometric Shapes
    0x00002600, 0x000026FF,        // Miscellaneous Symbols
    0x00002700, 0x000027BF,        // Dingbats (coarse)
    0x00002B55, 0x00002B59         // Heavy large circle neighbourhood
  ] @align(8)

  // ==========================================================================
  // SECTION 4 -- STATIC STATE (.bss, singleton)
  // ==========================================================================
  //
  // One u64 slot holds the locale-amb state as (width - 1). The .bss
  // zero-init naturally produces state==0 -> narrow default (width 1),
  // matching the Western-locale convention. _wp_set_locale_amb writes
  // 0 or 1 after validating the caller passed width in {1, 2}.

  pub let mut _wp_locale_amb_state : u64 = uninit @align(8)

  // ==========================================================================
  // _wp_char_width(cp) -> width_u64
  //
  //   rdi = cp (0..U+10FFFF; caller promises a successfully-decoded
  //         code point)
  //   rax = width in {0, 1, 2}
  //
  // Delegates the primary TR#11 question to substrate `_width_char`.
  // On a narrow (width=1) result, overlays the parser-tier A-class
  // table when `_wp_locale_amb_state == 1` (East-Asian locale asked
  // for Ambiguous==2). The overlay is a linear scan over the 18-range
  // table; a match flips the result to 2.
  //
  // Register plan:
  //   rbx = cp (callee-save; preserved across the single CALL)
  //   r10, r11, rcx, rax = scratch
  //
  // Alignment: entry rsp%16==8; one push (rbx) brings rsp%16==0
  // which is SysV's pre-CALL requirement. Single CALL to
  // `_width_char`. No further nested call.
  //
  // Labels prefixed wp_cw_.
  // ==========================================================================
  pub let _wp_char_width : (u64) -> u64 !{mem} @{} =
    fn (cp: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.R221.M3 (#2653): _wp_char_width returns the TR#11 column width of a single code point. Delegates to substrate _width_char (R131.M5) for the primary classification (0 for combining marks + controls + ZWJ + variation selectors; 2 for CJK + Hiragana + Katakana + Hangul + fullwidth + emoji; 1 for the narrow default). On a narrow result, overlays the parser-tier 18-range A-class table iff _wp_locale_amb_state == 1 (East-Asian locale). Table scan is linear with 8-byte stride (shl rN, 3; never imul) over 18 (lo, hi) u32 pairs; match flips result to 2. One callee-save push (rbx holds cp across the CALL to _width_char); entry rsp%16==8 + 8 push = rsp%16==0 pre-CALL (SysV requirement). All cmp immediates (0, 1, 2, 18, 0x2B59) fit imm32 sign-safe. u32 loads via mov_d (zero-extends into full qword). r11 and r10 are scratch; r11 is used only AFTER the single CALL (the overlay scan), never held across it. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed wp_cw_.",
      block: {
        push rbx;
        mov rbx, rdi;                          // save cp
        call _width_char;                      // substrate: 0, 1, or 2
        cmp rax, 1;                            // narrow result -> check overlay
        jne wp_cw_done;

        // ---- Substrate said narrow. Check locale amb state. --------
        lea r11, [rip + _wp_locale_amb_state];
        mov r11, [r11];
        cmp r11, 1;                            // 0 -> narrow default; 1 -> East-Asian
        jne wp_cw_done;                        // keep narrow

        // ---- Linear scan over _wp_amb_ranges (18 pairs). ------------
        lea r11, [rip + _wp_amb_ranges];
        xor rcx, rcx;                          // i = 0

      wp_cw_scan_top:
        cmp rcx, 18;                           // WP_AMB_RANGES_LEN
        jae wp_cw_narrow;

        mov r10, rcx;
        shl r10, 3;                            // i * 8 bytes per (lo, hi) pair

        // Load lo (u32).
        xor rax, rax;
        mov_d rax, [r11 + r10 + 0];
        cmp rbx, rax;
        jb wp_cw_scan_next;

        // Load hi (u32).
        xor rax, rax;
        mov_d rax, [r11 + r10 + 4];
        cmp rbx, rax;
        ja wp_cw_scan_next;

        // Match: cp is in an A-class range AND locale wants wide.
        mov rax, 2;
        pop rbx;
        ret;

      wp_cw_scan_next:
        add rcx, 1;
        jmp wp_cw_scan_top;

      wp_cw_narrow:
        // No A-class match -- substrate's narrow result stands.
        mov rax, 1;
        pop rbx;
        ret;

      wp_cw_done:
        // rax already holds the substrate result (0 or 2).
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _wp_cluster_width(bytes_ptr, bytes_len) -> width_u64
  //
  //   rdi = bytes_ptr  (first byte of the cluster)
  //   rsi = bytes_len  (byte length of the cluster span, >= 1)
  //   rax = width in {0, 1, 2}; defensively 0 on INVALID_UTF8.
  //
  // Decodes the cluster's BASE code point via substrate
  // `utf8_decode_cp(bytes_ptr, bytes_len)` and calls `_wp_char_width`
  // on it. Combining marks after the base are implicitly zero-width
  // (they classify as width-0 on their own), so a cluster's width is
  // its base's width per TR#11 §5.
  //
  // Caller contract: `bytes_ptr .. bytes_ptr + bytes_len` is a
  // single, well-isolated TR#29 grapheme cluster. If the byte run is
  // ill-formed UTF-8, _wp_cluster_width returns 0 rather than
  // signalling (the public API has no error channel at M3 -- a
  // sibling `_wp_cluster_width_checked` with a packed status return
  // is reserved for M3.1).
  //
  // Register plan:
  //   rbx = scratch for alignment (no state to save across either
  //         nested CALL; both decode args fit directly in rdi/rsi).
  //
  // Alignment: entry rsp%16==8; one push (rbx) brings rsp%16==0.
  // Two nested CALLs: `utf8_decode_cp` then `_wp_char_width`; both
  // start at rsp%16==0 (the push consumes no further frame slot
  // across either call because we don't need to save anything).
  //
  // Labels prefixed wp_cl_.
  // ==========================================================================
  pub let _wp_cluster_width : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.R221.M3 (#2653): _wp_cluster_width decodes a single cluster's base code point via substrate utf8_decode_cp (R131.M1) and calls _wp_char_width on it. Combining marks after the base are width-0 by the substrate's classification, so a cluster's TR#11 width is its base's width per TR#11 §5. Defensive fallback: if utf8_decode_cp returns the error band (bits [31:24] == 0xFF), the function returns 0 rather than signalling -- M3's public API has no error channel; a sibling checked variant with a packed status is reserved for M3.1. One callee-save push (rbx) just for alignment; entry rsp%16==8 + 8 push = rsp%16==0 pre-CALL (SysV requirement) for both nested CALLs. Discriminator uses the bits-[31:24] idiom documented at tools/user/libpdx-unicode-tables/src/utf8.pdx L91-L105: `mov r11, rax; shr r11, 24; and r11, 0xFF; cmp r11, 4; ja error`. All cmp immediates (0, 4, 0xFF) fit imm32 sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. r11 is used only within the discriminator (between the two CALLs) and never held across the second CALL. Labels prefixed wp_cl_.",
      block: {
        push rbx;                              // alignment-only push

        // ---- Decode the cluster's base cp ---------------------------
        // rdi, rsi already carry (bytes_ptr, bytes_len).
        call utf8_decode_cp;

        // Discriminate per the utf8.pdx bits-[31:24] idiom.
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja wp_cl_err;

        // Success: cp = rax >> 32.
        mov rdi, rax;
        shr rdi, 32;
        call _wp_char_width;

        // rax now holds width in {0, 1, 2}.
        pop rbx;
        ret;

      wp_cl_err:
        // Defensive fallback on malformed UTF-8: return 0.
        xor rax, rax;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _wp_cols(bytes_ptr, bytes_len) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rax = (total_cols << 32) | status
  //         status in {WP_OK, WP_ERR_INVALID_UTF8}
  //
  // Walks the input one TR#29 grapheme cluster at a time via
  // `_gi_next_cluster` (R221.M2). For each cluster, decodes the
  // base cp via substrate `utf8_decode_cp` and classifies via
  // `_wp_char_width`; accumulates the per-cluster width into r14.
  //
  // Return shape:
  //   OK:       (total_cols << 32) | 0
  //   INVALID:  (partial_cols << 32) | 0x3F00
  //
  // The partial accumulator is still meaningful on INVALID_UTF8
  // (columns consumed up to the malformed byte).
  //
  // Register plan (5 callee-save pushes):
  //   rbx = bytes_ptr        (preserved across every CALL)
  //   r12 = bytes_len        (preserved across every CALL)
  //   r13 = cursor           (walker; advances via _gi_next_cluster)
  //   r14 = total_cols       (accumulator)
  //   r15 = next_cursor      (temp; survives across utf8_decode_cp
  //                            + _wp_char_width between the two CALLs)
  //
  // Alignment: entry rsp%16==8; five 8-byte pushes shift rsp by 40
  // bytes, so (8+40) mod 16 = 0. Matches SysV requirement at every
  // nested CALL site (_gi_next_cluster, utf8_decode_cp,
  // _wp_char_width). No `sub rsp, N` pad needed.
  //
  // Status discipline (Wave 118 lesson):
  //   _gi_next_cluster returns status in the LOW 32 bits of its
  //   packed return. GI_ERR_INVALID_UTF8 (0x3800) has low byte 0x00,
  //   so a bare `and rN, 0xFF` on the status aliases to 0 (OK) and
  //   would spin forever. The loop extracts the full 32-bit status
  //   via `shl r11, 32; shr r11, 32` and compares against both
  //   0x3800 (substrate-tier INVALID_UTF8) AND 1 (EOF) and 0 (OK).
  //
  // Labels prefixed wp_co_.
  // ==========================================================================
  pub let _wp_cols : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.R221.M3 (#2653): _wp_cols walks the input one TR#29 grapheme cluster at a time via _gi_next_cluster (R221.M2) and sums per-cluster widths (base cp width per TR#11 §5; combining marks are width-0 by substrate classification). Return shape: (total_cols << 32) | status. OK (gi status=0) accumulates and continues; EOF (gi status=1, defensive -- loop also guards cursor < bytes_len) exits with status=0; INVALID (gi status=0x3800) exits with WP_ERR_INVALID_UTF8=0x3F00 and the partial accumulator still meaningful. 5 callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=cursor, r14=total_cols, r15=next_cursor) + no pad: entry rsp%16==8 + 40 bytes = (48 mod 16)=0 pre-CALL; matches SysV at every nested CALL (_gi_next_cluster, utf8_decode_cp, _wp_char_width). Status discipline (Wave 118 lesson): a bare `and rN, 0xFF` on 0x3800 or 0x3F00 aliases to 0 and spins; the loop extracts the full 32-bit status via `shl r11, 32; shr r11, 32` and compares against 0x3800 (substrate INVALID) + 1 (EOF) + 0 (OK). Discriminator on utf8_decode_cp uses the bits-[31:24] idiom; defensive fallback adds width=1 if decode diverges from grapheme-iter's seed (shouldn't happen -- both delegate to substrate). All cmp immediates (0, 1, 0x3800, 0x3F00) fit imm32 sign-safe. r11 is used only within sub-CALL discriminators and never held across a CALL. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed wp_co_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // rbx = bytes_ptr
        mov r12, rsi;                          // r12 = bytes_len
        xor r13, r13;                          // r13 = cursor = 0
        xor r14, r14;                          // r14 = total_cols = 0

      wp_co_loop_top:
        // Termination: cursor >= bytes_len (OK, done).
        cmp r13, r12;
        jae wp_co_ok;

        // ---- Advance by one grapheme cluster -----------------------
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _gi_next_cluster;

        // Extract the full 32-bit status word (Wave 118 lesson).
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;

        cmp r11, 0x3800;                       // GI_ERR_INVALID_UTF8
        je wp_co_invalid;

        cmp r11, 1;                            // GI_STATUS_EOF
        je wp_co_ok;                           // defensive; guard above covers

        cmp r11, 0;                            // GI_STATUS_OK
        jne wp_co_invalid;                     // unknown status -> defensive

        // ---- OK: save next_cursor and compute cluster width ---------
        mov r15, rax;
        shr r15, 32;                           // r15 = next_cursor

        // Decode the base cp via utf8_decode_cp(bytes_ptr + cursor,
        //                                       bytes_len - cursor).
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Discriminate per utf8.pdx bits-[31:24] idiom.
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja wp_co_width_one_fallback;

        // Success: cp in rax[63:32]. Classify via _wp_char_width.
        mov rdi, rax;
        shr rdi, 32;
        call _wp_char_width;

        // ---- Accumulate and advance --------------------------------
        add r14, rax;
        mov r13, r15;
        jmp wp_co_loop_top;

      wp_co_width_one_fallback:
        // Defensive: _gi_next_cluster said this cluster starts with a
        // valid cp but utf8_decode_cp disagreed. Count the cluster as
        // width 1 (one visible column) and advance past it. Both
        // decoders share the same substrate so this path should not
        // trigger at M3; included for forward resilience to M3.1+
        // substrate changes.
        add r14, 1;
        mov r13, r15;
        jmp wp_co_loop_top;

      wp_co_ok:
        // Pack (total_cols << 32) | WP_OK.
        mov rax, r14;
        shl rax, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      wp_co_invalid:
        // Pack (partial_cols << 32) | WP_ERR_INVALID_UTF8.
        mov rax, r14;
        shl rax, 32;
        add rax, 0x3F00;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _wp_locale_amb_width() -> u64
  //
  //   rax = active locale ambiguous width in {1, 2}
  //
  // Reads `_wp_locale_amb_state` (stored as `width - 1` so .bss
  // zero-init decodes to the Western-locale narrow default) and
  // returns width = state + 1.
  //
  // Pure leaf. No callee-save push, no stack frame, no nested CALL.
  // Labels prefixed wp_la_.
  // ==========================================================================
  pub let _wp_locale_amb_width : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.R221.M3 (#2653): _wp_locale_amb_width reads the .bss singleton _wp_locale_amb_state and returns (state + 1), giving 1 (narrow default) on a zero-init slot and 2 after _wp_set_locale_amb(2) was called. Pure leaf; zero pushes; no stack frame; no nested CALL. No immediates with bit 31 set. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed wp_la_.",
      block: {
        lea r11, [rip + _wp_locale_amb_state];
        mov rax, [r11];
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _wp_set_locale_amb(width) -> status
  //
  //   rdi = width in {1, 2}
  //   rax = WP_OK (0) on success; WP_ERR_BAD_LOCALE_WIDTH (0x3F01) if
  //         width not in {1, 2}.
  //
  // Writes `_wp_locale_amb_state := width - 1` after validating the
  // input is in {1, 2}. Any other value is rejected without touching
  // the state slot.
  //
  // Pure leaf. No callee-save push, no stack frame, no nested CALL.
  // Labels prefixed wp_sl_.
  // ==========================================================================
  pub let _wp_set_locale_amb : (u64) -> u64 !{mem} @{} =
    fn (width: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-pds-parser.R221.M3 (#2653): _wp_set_locale_amb validates the caller-supplied width is in {1, 2} and writes _wp_locale_amb_state := width - 1 on success. Rejection returns WP_ERR_BAD_LOCALE_WIDTH (0x3F01) without touching the state slot. Pure leaf; zero pushes; no stack frame; no nested CALL. Two cmp instructions gate the input: `cmp rdi, 1; jb bad` and `cmp rdi, 2; ja bad`. All cmp immediates (1, 2, 0x3F01) fit imm32 sign-safe. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed wp_sl_.",
      block: {
        cmp rdi, 1;
        jb wp_sl_bad;
        cmp rdi, 2;
        ja wp_sl_bad;

        // Valid: write state = width - 1.
        mov rax, rdi;
        sub rax, 1;
        lea r11, [rip + _wp_locale_amb_state];
        mov [r11], rax;
        xor rax, rax;                          // WP_OK
        ret;

      wp_sl_bad:
        mov rax, 0x3F01;                       // WP_ERR_BAD_LOCALE_WIDTH
        ret;
      }
    }

}
