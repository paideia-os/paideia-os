  // ==========================================================================
  // _lh_init() -> ()
  //
  //   Bare `ret`. Raw M8 holds NO .bss state (every HoverResponse
  //   record is caller-owned). Kept for parallelism with the parser-
  //   family init-hook convention; an M8.2 landing adds a .bss
  //   session-local hover-queue head slot and this init will zero-
  //   fill it on first call.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lh_ini_.
  // ==========================================================================
  pub let _lh_init : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_init is a bare ret. Raw M8 holds NO .bss state (every HoverResponse record is caller-owned; the session-local hover-queue head slot lands at M8.2). Zero callee-save pushes; no stack frame; no nested CALL. Kept for parallelism with the parser-family init-hook convention (_dr_init R225.M7, _rc_init R225.M6, _lc_init R227.M4, _rd_init R229.M9). No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_ini_.",
      block: {
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_is_ident(byte) -> u64
  //
  //   rdi = byte  (u64; low 8 bits inspected)
  //   rax = 1 iff byte in [a-zA-Z0-9_-]; 0 otherwise.
  //
  //   Identifier charset: 'a'..'z' (0x61..0x7A) | 'A'..'Z'
  //   (0x41..0x5A) | '0'..'9' (0x30..0x39) | '_' (0x5F) | '-'
  //   (0x2D). Checked as four cmp-range gates + two cmp-equal
  //   gates.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lh_h_ii_.
  // ==========================================================================
  pub let _lh_h_is_ident : (u64) -> u64 !{} @{} =
    fn (byte: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_is_ident returns 1 iff byte in [a-zA-Z0-9_-]. Four range gates + two equality gates. Pure leaf; zero pushes; no stack frame; no nested CALL. All cmp immediates (0x2D, 0x30, 0x39, 0x41, 0x5A, 0x5F, 0x61, 0x7A) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_h_ii_.",
      block: {
        // 'a'..'z'
        cmp rdi, 0x61;
        jb  lh_h_ii_not_lower;
        cmp rdi, 0x7A;
        ja  lh_h_ii_not_lower;
        mov rax, 1;
        ret;

      lh_h_ii_not_lower:
        // 'A'..'Z'
        cmp rdi, 0x41;
        jb  lh_h_ii_not_upper;
        cmp rdi, 0x5A;
        ja  lh_h_ii_not_upper;
        mov rax, 1;
        ret;

      lh_h_ii_not_upper:
        // '0'..'9'
        cmp rdi, 0x30;
        jb  lh_h_ii_not_digit;
        cmp rdi, 0x39;
        ja  lh_h_ii_not_digit;
        mov rax, 1;
        ret;

      lh_h_ii_not_digit:
        // '_'
        cmp rdi, 0x5F;
        jne lh_h_ii_not_underscore;
        mov rax, 1;
        ret;

      lh_h_ii_not_underscore:
        // '-'
        cmp rdi, 0x2D;
        jne lh_h_ii_no;
        mov rax, 1;
        ret;

      lh_h_ii_no:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_scan_token(buffer, len, cursor) -> packed_u64
  //
  //   rdi = buffer
  //   rsi = len
  //   rdx = cursor      (byte offset into buffer; may equal len)
  //   rax = packed_u64 = (token_offset u32 << 32) | token_length u32
  //                     0 when no token at cursor.
  //
  //   Flow:
  //     (1) if len == 0 OR cursor > len: return 0.
  //     (2) adjust: if cursor == len (end-of-line): cursor = len - 1
  //         (safe because len >= 1 from Step 1).
  //     (3) load byte at buffer[cursor]; CALL _lh_h_is_ident; if 0:
  //         return 0 (NO_TOKEN).
  //     (4) grow-left: start = cursor; while start > 0: load
  //         buffer[start-1]; CALL is_ident; break on 0; else
  //         start -= 1.
  //     (5) grow-right: end = cursor; while end < len: load
  //         buffer[end]; CALL is_ident; break on 0; else end += 1.
  //     (6) pack: rax = (start << 32) | (end - start).
  //
  // Frame plan: 4 callee-save pushes (rbx = buffer; r12 = len;
  // r13 = start; r14 = end) + sub rsp,8 align. Entry rsp%16==8 ->
  // after 4 pushes (32B) + 8B sub = 40 + 8 = 48, (8+48) mod 16 =
  // 0 at every nested CALL.
  //
  // Labels prefixed lh_h_st_.
  // ==========================================================================
  pub let _lh_h_scan_token : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer: u64) (len: u64) (cursor: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_scan_token finds the identifier-char span straddling cursor. Prologue: 4 callee-save pushes (rbx = buffer; r12 = len; r13 = start-scratch; r14 = end-scratch) + sub rsp,8 align; entry rsp%16==8 -> after pushes+sub rsp%16==0 at every nested CALL into _lh_h_is_ident. Validates len != 0, cursor <= len. Clamps cursor to len-1 when cursor == len (end-of-line). First is_ident probe at cursor rejects NO_TOKEN as packed 0. Grow-left then grow-right using cmp+je on is_ident return. Returns packed (start << 32) | (end - start). All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_h_st_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // (1) len == 0?
        cmp rsi, 0;
        je  lh_h_st_notoken;

        // (1b) cursor > len?
        cmp rdx, rsi;
        ja  lh_h_st_notoken;

        // (2) cursor == len? clamp to len - 1.
        cmp rdx, rsi;
        jne lh_h_st_cursor_ok;
        mov rdx, rsi;
        sub rdx, 1;

      lh_h_st_cursor_ok:
        mov rbx, rdi;                          // rbx = buffer
        mov r12, rsi;                          // r12 = len

        // (3) is_ident(buffer[cursor])?
        xor rax, rax;
        mov_b rax, [rbx + rdx];
        mov rdi, rax;
        call _lh_h_is_ident;
        cmp rax, 0;
        je  lh_h_st_notoken;

        // (4) grow-left.
        mov r13, rdx;                          // start = cursor

      lh_h_st_left_loop:
        cmp r13, 0;
        je  lh_h_st_left_done;

        // probe buffer[start - 1].
        mov rax, r13;
        sub rax, 1;
        xor rdi, rdi;
        mov_b rdi, [rbx + rax];
        call _lh_h_is_ident;
        cmp rax, 0;
        je  lh_h_st_left_done;

        // start -= 1.
        sub r13, 1;
        jmp lh_h_st_left_loop;

      lh_h_st_left_done:
        // (5) grow-right.
        mov r14, rdx;                          // end = cursor

      lh_h_st_right_loop:
        cmp r14, r12;
        jae lh_h_st_right_done;

        // probe buffer[end].
        xor rdi, rdi;
        mov_b rdi, [rbx + r14];
        call _lh_h_is_ident;
        cmp rax, 0;
        je  lh_h_st_right_done;

        // end += 1 (one past the last identifier char becomes end).
        add r14, 1;
        jmp lh_h_st_right_loop;

      lh_h_st_right_done:
        // (6) pack (start << 32) | (end - start).
        mov rax, r14;
        sub rax, r13;                          // length
        mov r11, r13;
        shl r11, 32;
        or  rax, r11;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lh_h_st_notoken:
        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_table_lookup(token_ptr, token_len, out_record) -> flags_u64
  //
  //   rdi = token_ptr   (bytes to compare)
  //   rsi = token_len   (byte count; 1..LH_TABLE_NAME_BYTES=16)
  //   rdx = out_record  (128-byte HoverResponse record)
  //   rax = flags_u64   LH_FLAG_TYPE_KNOWN | _EFFECT_KNOWN |
  //                     _CAP_KNOWN (= 7) on hit; 0 on miss.
  //
  //   Flow:
  //     (1) if token_len == 0 OR token_len > 16: miss.
  //     (2) for i in 0..10:
  //           entry = _lh_demo_table + i * 128;
  //           // name-length match: count non-NUL bytes in entry[0..16].
  //           j = 0; while j < 16 and entry[j] != 0: j += 1;
  //           if j != token_len: continue.
  //           // byte compare entry[0..token_len] vs token[0..token_len].
  //           k = 0; while k < token_len: if entry[k] != token[k]: break;
  //           k += 1;
  //           if k != token_len: continue.
  //           // hit: byte-copy 96 bytes from entry[+16] to out[+16].
  //           for b in 0..96: out[16+b] = entry[16+b].
  //           return 7.
  //     (3) miss: return 0.
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed lh_h_tl_.
  // ==========================================================================
  pub let _lh_h_table_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (token_ptr: u64) (token_len: u64) (out_record: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_table_lookup scans the 10-entry 128-byte-stride demo table and byte-copies 96B of (type, effect, cap) to out+16 on hit. Pure leaf; zero callee-save pushes; no stack frame; no nested CALL. Entry address: r9 = i << 7 + _lh_demo_table_base (shl r9,7; add r9,base). Name-length probe: count non-NUL bytes in entry[0..16] via j-loop until first NUL. Length match: j == token_len. Byte compare entry[0..token_len] vs token[0..token_len]. 96-byte triple copy inlined (byte-count loop). Returns 7 on hit, 0 on miss. All cmp immediates (0, 16, 96) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_h_tl_.",
      block: {
        // (1) empty / too-long token: miss.
        cmp rsi, 0;
        je  lh_h_tl_miss;
        cmp rsi, 16;
        ja  lh_h_tl_miss;

        // r8 = i (entry index 0..9).
        xor r8, r8;

      lh_h_tl_outer:
        cmp r8, 10;
        jae lh_h_tl_miss;

        // r9 = entry addr = _lh_demo_table + i * 128.
        mov r9, r8;
        shl r9, 7;
        lea r10, [rip + _lh_demo_table];
        add r9, r10;

        // --- Measure entry name length into r10 (0..16).
        xor r10, r10;                          // j = 0

      lh_h_tl_name_loop:
        cmp r10, 16;
        jae lh_h_tl_name_done;

        xor rax, rax;
        mov_b rax, [r9 + r10];
        cmp rax, 0;
        je  lh_h_tl_name_done;

        add r10, 1;
        jmp lh_h_tl_name_loop;

      lh_h_tl_name_done:
        // Length match?
        cmp r10, rsi;
        jne lh_h_tl_next;

        // --- Byte-compare entry[0..token_len] vs token_ptr[0..token_len].
        xor r11, r11;                          // k = 0

      lh_h_tl_cmp_loop:
        cmp r11, rsi;
        jae lh_h_tl_match;                     // all bytes matched

        xor rax, rax;
        mov_b rax, [r9 + r11];                 // entry[k]
        xor rcx, rcx;
        mov_b rcx, [rdi + r11];                // token[k]
        cmp rax, rcx;
        jne lh_h_tl_next;

        add r11, 1;
        jmp lh_h_tl_cmp_loop;

      lh_h_tl_match:
        // --- Byte-copy 96 bytes from entry[+16] to out[+16].
        xor r11, r11;                          // b = 0

      lh_h_tl_copy_loop:
        cmp r11, 96;
        jae lh_h_tl_hit;

        // src byte at entry + 16 + b.
        mov rax, r9;
        add rax, 16;
        add rax, r11;
        xor rcx, rcx;
        mov_b rcx, [rax + 0];

        // dst byte at out + 16 + b.
        mov rax, rdx;
        add rax, 16;
        add rax, r11;
        mov_b [rax + 0], rcx;

        add r11, 1;
        jmp lh_h_tl_copy_loop;

      lh_h_tl_hit:
        mov rax, 7;                            // TYPE | EFFECT | CAP
        ret;

      lh_h_tl_next:
        add r8, 1;
        jmp lh_h_tl_outer;

      lh_h_tl_miss:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_emit_lit(src, src_len, out, out_cap, pos) -> new_pos
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rdx = out
  //   rcx = out_cap
  //   r8  = pos
  //   rax = new_pos (or out_cap + 1 as sticky overflow sentinel)
  //
  //   Byte-copy src_len bytes to out + pos. Mirrors
  //   DiagReport::_dr_h_emit_lit. Pure leaf; no CALL.
  //
  // Labels prefixed lh_h_el_.
  // ==========================================================================
  pub let _lh_h_emit_lit : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (src_len: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_emit_lit byte-copies src_len bytes to out+pos. Pure leaf; zero pushes; no stack frame; no nested CALL. Overflow probe: mov rax,r8; add rax,rsi; cmp rax,rcx; ja overflow (return rcx+1 sentinel). Copy loop: xor r9,r9; while r9 < src_len load src byte via xor r10,r10; mov_b r10,[rdi+r9]; store via mov_b [rdx+r11],r10 where r11 = r8+r9; advance r9. Return rax = r8 + src_len. All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_h_el_.",
      block: {
        mov rax, r8;
        add rax, rsi;
        cmp rax, rcx;
        ja  lh_h_el_overflow;

        xor r9, r9;

      lh_h_el_loop:
        cmp r9, rsi;
        jae lh_h_el_done;

        xor r10, r10;
        mov_b r10, [rdi + r9];

        mov r11, r8;
        add r11, r9;
        mov_b [rdx + r11], r10;

        add r9, 1;
        jmp lh_h_el_loop;

      lh_h_el_done:
        ret;

      lh_h_el_overflow:
        mov rax, rcx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_emit_cstr(src, max_bytes, out, out_cap, pos) -> new_pos
  //
  //   rdi = src_ptr
  //   rsi = max_bytes
  //   rdx = out
  //   rcx = out_cap
  //   r8  = pos
  //   rax = new_pos (sticky overflow sentinel = out_cap + 1)
  //
  //   Byte-copy from src up to max_bytes OR first NUL byte,
  //   whichever comes first. Mirrors DiagReport::_dr_h_emit_cstr.
  //
  // Labels prefixed lh_h_ec_.
  // ==========================================================================
  pub let _lh_h_emit_cstr : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (max_bytes: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_emit_cstr byte-copies from src up to max_bytes or first NUL. Pure leaf; zero pushes; no stack frame; no nested CALL. NULL-source short-circuit: cmp rdi,0 je done (return pos). Copy loop: xor r9,r9; while r9 < max_bytes: load src byte via xor r10,r10; mov_b r10,[rdi+r9]; cmp r10,0 je done (NUL terminates). Overflow probe: mov r11,r8; add r11,r9; cmp r11,rcx; jae overflow. Store via mov_b [rdx+r11],r10. advance r9. Return rax = pos + i. All cmp immediates (0, 1) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_h_ec_.",
      block: {
        cmp rdi, 0;
        je  lh_h_ec_done_unchanged;

        xor r9, r9;

      lh_h_ec_loop:
        cmp r9, rsi;
        jae lh_h_ec_done;

        xor r10, r10;
        mov_b r10, [rdi + r9];

        cmp r10, 0;
        je  lh_h_ec_done;

        mov r11, r8;
        add r11, r9;
        cmp r11, rcx;
        jae lh_h_ec_overflow;

        mov_b [rdx + r11], r10;

        add r9, 1;
        jmp lh_h_ec_loop;

      lh_h_ec_done:
        mov rax, r8;
        add rax, r9;
        ret;

      lh_h_ec_done_unchanged:
        mov rax, r8;
        ret;

      lh_h_ec_overflow:
        mov rax, rcx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _lh_h_emit_u32_dec(value, out, out_cap, pos) -> new_pos
  //
  //   rdi = value (u64; low 32 bits emitted)
  //   rsi = out
  //   rdx = out_cap
  //   rcx = pos
  //   rax = new_pos (or out_cap + 1 on overflow)
  //
  //   Emit decimal digits via greedy subtraction over the 10-entry
  //   _lh_pow10 table. Mirrors DiagReport::_dr_h_emit_u32_dec.
  //
  // Labels prefixed lh_h_ed_.
  // ==========================================================================
  pub let _lh_h_emit_u32_dec : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (out: u64) (out_cap: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_h_emit_u32_dec emits decimal digits via greedy subtraction over _lh_pow10. Pure leaf; zero pushes; no stack frame; no nested CALL. value==0 fast path emits a single '0' after a pos+1 vs out_cap probe. General path: xor r11,r11 (emit_flag=0); xor r8,r8 (i=0 pow index); loop while i<10: load pow = _lh_pow10[i] u32; inner subtract loop until value<pow; emit digit iff digit>0 or emit_flag. All immediates (0, 1, 2, 10, 48='0') fit imm32. No test; no imul-r-imm; no multiline let. Labels prefixed lh_h_ed_.",
      block: {
        cmp rdi, 0;
        jne lh_h_ed_general;

        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  lh_h_ed_overflow;

        mov r11, rsi;
        add r11, rcx;
        mov r9, 48;
        mov_b [r11 + 0], r9;
        ret;

      lh_h_ed_general:
        xor r11, r11;                          // emit_flag
        xor r8, r8;                            // i

      lh_h_ed_pow_loop:
        cmp r8, 10;
        jae lh_h_ed_done;

        // r10 = pow = _lh_pow10[i].
        mov r10, r8;
        shl r10, 2;
        lea r9, [rip + _lh_pow10];
        add r9, r10;
        xor r10, r10;
        mov_d r10, [r9 + 0];

        xor r9, r9;                            // digit

      lh_h_ed_sub_loop:
        cmp rdi, r10;
        jb  lh_h_ed_digit_done;
        sub rdi, r10;
        add r9, 1;
        jmp lh_h_ed_sub_loop;

      lh_h_ed_digit_done:
        cmp r9, 0;
        jne lh_h_ed_emit;
        cmp r11, 0;
        je  lh_h_ed_next;

      lh_h_ed_emit:
        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  lh_h_ed_overflow;

        mov r10, 48;
        add r10, r9;

        mov rax, rsi;
        add rax, rcx;
        mov_b [rax + 0], r10;

        add rcx, 1;
        mov r11, 1;

      lh_h_ed_next:
        add r8, 1;
        jmp lh_h_ed_pow_loop;

      lh_h_ed_done:
        cmp r11, 0;
        jne lh_h_ed_return;

        mov rax, rcx;
        add rax, 1;
        cmp rax, rdx;
        ja  lh_h_ed_overflow;

        mov r11, rsi;
        add r11, rcx;
        mov r9, 48;
        mov_b [r11 + 0], r9;
        add rcx, 1;

      lh_h_ed_return:
        mov rax, rcx;
        ret;

      lh_h_ed_overflow:
        mov rax, rdx;
        add rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _lh_query(buffer_ptr, buffer_len, cursor_byte, out, out_cap)
  //                                                     -> packed_u64
  //
  //   rdi = buffer_ptr
  //   rsi = buffer_len
  //   rdx = cursor_byte
  //   rcx = out
  //   r8  = out_cap
  //   rax = packed_u64 = (LH_RECORD_BYTES << 32) | status
  //
  // Flow:
  //   1. Validate buffer_ptr != 0 and out != 0 (BAD_INPUT).
  //   2. Validate out_cap >= LH_RECORD_BYTES=128 (OUT_TOO_SMALL).
  //   3. Validate cursor_byte <= buffer_len (CURSOR_OOB).
  //   4. Zero-fill 128 bytes at out via 16 u64 stores (unrolled).
  //   5. Stamp magic 'HOVR' u32 at [out + 0].
  //   6. CALL _lh_h_scan_token(buffer_ptr, buffer_len, cursor_byte).
  //      Unpack: token_offset = (rax >> 32); token_length = rax & 0xFFFFFFFF.
  //      If both 0: skip to Step 9 with status = LH_ERR_NO_TOKEN.
  //   7. Write token_byte_offset u32 at [out + 4] (via mov_d).
  //      Write token_byte_length u32 at [out + 8].
  //      Set flags |= LH_FLAG_IS_IDENT.
  //   8. CALL _lh_h_table_lookup(buffer_ptr + token_offset,
  //                              token_length, out).
  //      Returned flag bits OR'd into our flags u32.
  //   9. Write flags u32 at [out + 12].
  //  10. If NO_TOKEN: return (128 << 32) | LH_ERR_NO_TOKEN.
  //      Else:      return (128 << 32) | LH_OK.
  //
  // Register plan:
  //   rbx = buffer_ptr    (restored across both nested CALLs)
  //   rbp = out           (restored across both nested CALLs)
  //   r12 = out_cap       (unused after Step 2; held defensively)
  //   r13 = token_offset  (post-Step 6)
  //   r14 = token_length  (post-Step 6)
  //   r15 = flags accumulator
  //   6 pushes = 48B; entry rsp%16==8 -> add sub rsp,8 -> rsp%16==0.
  //
  // Labels prefixed lh_q_.
  // ==========================================================================
  pub let _lh_query : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buffer_ptr: u64) (buffer_len: u64) (cursor_byte: u64)
       (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_query resolves cursor_byte into a 128-byte HoverResponse record. Prologue: 6 callee-save pushes (rbx/rbp/r12/r13/r14/r15 = 48B) + sub rsp,8 align; entry rsp%16==8 -> after pushes+sub rsp%16==0 at every nested CALL. Nested CALLs: _lh_h_scan_token (3-arg), _lh_h_table_lookup (3-arg). Flow (1) cmp rdi,0 je bad_input (0x5E00); cmp rcx,0 je bad_input; (2) cmp r8,128 jb out_too_small (0x5E01); (3) cmp rdx,rsi ja cursor_oob (0x5E02); (4) zero-fill 128B via 16 unrolled mov [rbp+disp],rax (rax=0); (5) write magic 0x52564F48 u32 at [rbp+0]; (6) CALL _lh_h_scan_token -> rax = (off<<32)|len; token_length extracted via shl r14,32; shr r14,32 (zero-extend low 32 without and-imm64 encoder pitfall); token_offset extracted via shr r13,32; cmp both zero -> notoken branch; (7) mov_d [rbp+4],r13 and mov_d [rbp+8],r14; (8) prepare token_ptr = rbx + r13; CALL _lh_h_table_lookup; or flags accumulator with return value; (9) write flags u32 at [rbp+12]; (10) return packed (128<<32)|status. All cmp immediates (0, 128, 7, 8, 0x52564F48) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_q_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // (1) Validate buffer_ptr != 0.
        cmp rdi, 0;
        je  lh_q_bad_input;

        // (1b) Validate out != 0.
        cmp rcx, 0;
        je  lh_q_bad_input;

        // (2) Validate out_cap >= 128.
        cmp r8, 128;
        jb  lh_q_out_too_small;

        // (3) Validate cursor_byte <= buffer_len.
        cmp rdx, rsi;
        ja  lh_q_cursor_oob;

        // Stash state across CALLs.
        mov rbx, rdi;                          // rbx = buffer_ptr
        mov rbp, rcx;                          // rbp = out
        mov r12, r8;                           // r12 = out_cap (reserved)
        xor r15, r15;                          // flags accumulator = 0

        // (4) Zero-fill 128 bytes at out via 16 unrolled u64 stores.
        xor rax, rax;
        mov [rbp + 0  ], rax;
        mov [rbp + 8  ], rax;
        mov [rbp + 16 ], rax;
        mov [rbp + 24 ], rax;
        mov [rbp + 32 ], rax;
        mov [rbp + 40 ], rax;
        mov [rbp + 48 ], rax;
        mov [rbp + 56 ], rax;
        mov [rbp + 64 ], rax;
        mov [rbp + 72 ], rax;
        mov [rbp + 80 ], rax;
        mov [rbp + 88 ], rax;
        mov [rbp + 96 ], rax;
        mov [rbp + 104], rax;
        mov [rbp + 112], rax;
        mov [rbp + 120], rax;

        // (5) Stamp magic 'HOVR' = 0x52564F48 u32 at [out + 0].
        mov rax, 0x52564F48;
        mov_d [rbp + 0], rax;

        // (6) CALL _lh_h_scan_token(rbx, rsi, rdx).
        //     rsi and rdx are already the right args; set rdi.
        mov rdi, rbx;
        call _lh_h_scan_token;

        // Unpack (off<<32)|len.
        //   token_length = rax & 0xFFFFFFFF (zero-extend low 32 via
        //                                    shl 32; shr 32 to avoid the
        //                                    "and r, imm64" encoder
        //                                    pitfall when the mask has
        //                                    bit 31 set).
        mov r14, rax;
        shl r14, 32;
        shr r14, 32;                           // r14 = token_length
        mov r13, rax;
        shr r13, 32;                           // r13 = token_offset

        // (6b) No-token short-circuit: both halves zero.
        cmp r13, 0;
        jne lh_q_have_token;
        cmp r14, 0;
        jne lh_q_have_token;

        // No token: flags remain 0; magic already stamped.
        // Still write flags u32 (zero) at [+12] -- redundant with
        // the zero-fill but kept for symmetry with the hit path.
        mov_d [rbp + 12], r15;

        // Return (128 << 32) | LH_ERR_NO_TOKEN.
        mov rax, 128;
        shl rax, 32;
        mov r11, 0x5E03;
        or  rax, r11;
        jmp lh_q_epilogue;

      lh_q_have_token:
        // (7) Write token_byte_offset u32 at [+4], token_byte_length
        //     u32 at [+8]. Set LH_FLAG_IS_IDENT.
        mov_d [rbp + 4], r13;
        mov_d [rbp + 8], r14;
        or  r15, 8;                            // LH_FLAG_IS_IDENT

        // (8) CALL _lh_h_table_lookup(buffer + token_offset,
        //                             token_length, out).
        mov rdi, rbx;
        add rdi, r13;                          // token_ptr
        mov rsi, r14;                          // token_len
        mov rdx, rbp;                          // out_record
        call _lh_h_table_lookup;

        // OR table flags into accumulator.
        or  r15, rax;

        // (9) Write flags u32 at [+12].
        mov_d [rbp + 12], r15;

        // (10) Return (128 << 32) | LH_OK.
        mov rax, 128;
        shl rax, 32;
        jmp lh_q_epilogue;

      lh_q_bad_input:
        mov rax, 0x5E00;
        jmp lh_q_epilogue;

      lh_q_out_too_small:
        mov rax, 0x5E01;
        jmp lh_q_epilogue;

      lh_q_cursor_oob:
        mov rax, 0x5E02;
        jmp lh_q_epilogue;

      lh_q_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _lh_render_lsp_json(record_ptr, record_len, out, out_cap)
  //                                                     -> packed_u64
  //
  //   rdi = record_ptr
  //   rsi = record_len
  //   rdx = out
  //   rcx = out_cap
  //   rax = packed_u64 = (bytes_written << 32) | status
  //
  //   Emits:
  //     {"contents":{"kind":"markdown","value":"
  //       **type**: <t>
  //       \n**effects**: <e>
  //       \n**capabilities**: <c>"
  //     },"range":{"start":{"line":0,"character":<off>},
  //       "end":{"line":0,"character":<off+len>}}}
  //   Suggestion-shape: effects / capabilities lines omitted when
  //   the respective 32-byte inline string's first byte is NUL.
  //
  // Register plan: identical to DiagReport's render entries.
  // Labels prefixed lh_r_.
  // ==========================================================================
  pub let _lh_render_lsp_json : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (record_len: u64) (out: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R225.M8 (#2689): _lh_render_lsp_json emits a LSP Hover payload. Prologue: 6 callee-save pushes (rbx/rbp/r12/r13/r14/r15 = 48B) + sub rsp,8 align; entry rsp%16==8 -> after pushes+sub rsp%16==0 at every nested CALL into _lh_h_emit_lit / _lh_h_emit_cstr / _lh_h_emit_u32_dec. Validates record_ptr != 0, out != 0 (BAD_INPUT 0x5E00); record_len >= 128 (BAD_RECORD 0x5E05); magic 'HOVR' = 0x52564F48 at [record+0] (BAD_RECORD). Emits (in order): j_prefix (40B), j_type lit (10B), cstr(type,32), if effect[0]!=0 j_effect lit (15B) + cstr(effect,32), if cap[0]!=0 j_cap lit (20B) + cstr(cap,32), j_mid1 (42B), dec(token_offset), j_mid2 (30B), dec(token_offset + token_length), j_suffix (3B). On any helper returning out_cap+1 sentinel, returns 0x5E06 RENDER_OVERFLOW. Otherwise returns (cursor << 32) | DR_OK. rbx = record_ptr; rbp = out; r12 = out_cap; r13 = cursor; r14/r15 = scratch. All cmp immediates (0, 128, 0x52564F48) fit imm32 with bit 31 clear. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed lh_r_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // Validate.
        cmp rdi, 0;
        je  lh_r_bad_input;
        cmp rdx, 0;
        je  lh_r_bad_input;
        cmp rsi, 128;
        jb  lh_r_bad_record;

        // Validate magic.
        xor rax, rax;
        mov_d rax, [rdi + 0];
        mov r15, 0x52564F48;
        cmp rax, r15;
        jne lh_r_bad_record;

        // Stash state.
        mov rbx, rdi;                          // record_ptr
        mov rbp, rdx;                          // out
        mov r12, rcx;                          // out_cap
        xor r13, r13;                          // cursor

        // --- j_prefix (40B) ---
        lea r14, [rip + _lh_lit_j_prefix];
        mov rdi, r14;
        mov rsi, 40;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- "**type**: " (10B) ---
        lea r14, [rip + _lh_lit_j_type];
        mov rdi, r14;
        mov rsi, 10;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- cstr(type, 32) ---
        mov rdi, rbx;
        add rdi, 16;                           // LH_OFF_TYPE
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_cstr;
        mov r13, rax;

        // --- Effect branch: skip if effect[0] == NUL ---
        xor r15, r15;
        mov_b r15, [rbx + 48];                 // LH_OFF_EFFECT
        cmp r15, 0;
        je  lh_r_after_effect;

        // --- "\n**effects**: " (15B) ---
        lea r14, [rip + _lh_lit_j_effect];
        mov rdi, r14;
        mov rsi, 15;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- cstr(effect, 32) ---
        mov rdi, rbx;
        add rdi, 48;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_cstr;
        mov r13, rax;

      lh_r_after_effect:
        // --- Cap branch: skip if cap[0] == NUL ---
        xor r15, r15;
        mov_b r15, [rbx + 80];                 // LH_OFF_CAP
        cmp r15, 0;
        je  lh_r_after_cap;

        // --- "\n**capabilities**: " (20B) ---
        lea r14, [rip + _lh_lit_j_cap];
        mov rdi, r14;
        mov rsi, 20;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- cstr(cap, 32) ---
        mov rdi, rbx;
        add rdi, 80;
        mov rsi, 32;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_cstr;
        mov r13, rax;

      lh_r_after_cap:
        // --- j_mid1 "},"range":{"start":{"line":0,"character": (42B) ---
        lea r14, [rip + _lh_lit_j_mid1];
        mov rdi, r14;
        mov rsi, 42;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- dec(token_offset) ---
        xor r15, r15;
        mov_d r15, [rbx + 4];
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _lh_h_emit_u32_dec;
        mov r13, rax;

        // --- j_mid2 },"end":{"line":0,"character": (30B) ---
        lea r14, [rip + _lh_lit_j_mid2];
        mov rdi, r14;
        mov rsi, 30;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // --- dec(token_offset + token_length) ---
        xor r15, r15;
        mov_d r15, [rbx + 4];
        xor r14, r14;
        mov_d r14, [rbx + 8];
        add r15, r14;
        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        call _lh_h_emit_u32_dec;
        mov r13, rax;

        // --- j_suffix "}}}" (3B) ---
        lea r14, [rip + _lh_lit_j_suffix];
        mov rdi, r14;
        mov rsi, 3;
        mov rdx, rbp;
        mov rcx, r12;
        mov r8, r13;
        call _lh_h_emit_lit;
        mov r13, rax;

        // Overflow check.
        cmp r13, r12;
        ja  lh_r_overflow;

        mov rax, r13;
        shl rax, 32;
        jmp lh_r_epilogue;

      lh_r_bad_input:
        mov rax, 0x5E00;
        jmp lh_r_epilogue;

      lh_r_bad_record:
        mov rax, 0x5E05;
        jmp lh_r_epilogue;

      lh_r_overflow:
        mov rax, 0x5E06;
        jmp lh_r_epilogue;

      lh_r_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
