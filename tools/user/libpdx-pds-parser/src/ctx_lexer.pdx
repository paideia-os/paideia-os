// src/ctx_lexer.pdx -- libpdx-pds-parser.R221.M4 (paideia-os#2654)
//
// CtxLexer: context-tracking lexer for the paideia-shell pds-lang
// surface. Walks a UTF-8 (NFC-normalised, R221.M1) byte stream and
// emits one 16-byte Token record per terminal, tagged with the
// enclosing-tier context code so downstream passes do not re-deduce
// pipeline-vs-datalog-vs-lambda membership.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// R221.M4 of the parser-tier Unicode + lexer umbrella (paideia-os#2485,
// decomposed into paideia-os#2654 for THIS M4). Builds on:
//   R221.M1 (utf8_nfc.pdx)      -- NFC-normalised input bytes
//   R221.M2 (grapheme_iter.pdx) -- cluster iterator (used by the REPL
//                                  grid renderer; the lexer itself
//                                  classifies at the ASCII subset).
//   R221.M3 (width_pass.pdx)    -- TR#11 column classifier (REPL only).
//
// The three sub-languages woven into pds-lang reinterpret the same
// glyphs:
//
//     | pipeline       | datalog     | lambda
//   --+----------------+-------------+---------------
//   | | stage pipe     | SYNTAX err  | arg delim
//   { | lambda / block | datalog hdr | nested
//
// R221.M4 is the single-pass byte-walker that captures tier membership
// once at lex time, so R221.M5 (AST), R225.M3+ (typecheck), and
// R229.M3-dispatch (REPL dispatch) all walk the same token image
// without re-scanning the input for the enclosing tier.
//
// =============================================================================
// CONTEXT MODEL
// =============================================================================
//
// Three context codes:
//   CTX_PIPELINE = 0    outer / implicit
//   CTX_DATALOG  = 1    inside `datalog { ... }`
//   CTX_LAMBDA   = 2    inside `{ |args| body }`
//
// A 16-byte .bss stack + depth word tracks nesting; depth==0 means
// the stack is empty and the implicit outer context is CTX_PIPELINE.
// Every `{` pushes a context byte; every `}` pops. Three dispositions
// for `{`:
//   previous token was TOK_KW_DATALOG       -> push CTX_DATALOG
//   next non-WS byte on same line is `|`     -> push CTX_LAMBDA
//   otherwise                                -> push a COPY of current
// The third case is the brace-balancing invariant: every `{` pushes
// SOMETHING so every `}` has a matching entry.
//
// Public API:
//   _cl_init()                                  -> ()
//   _cl_push_ctx(ctx)                           -> errno
//   _cl_pop_ctx()                               -> (ctx<<32) | status
//   _cl_current_ctx()                           -> ctx u8
//   _cl_lex_token(bytes, len, cursor, out_tok)  -> (new_cursor<<32)|status
//   _cl_tokenize(bytes, len, out, out_cap)      -> (bytes_written<<32)|status
//
// The .bss stack is session-wide. Every entry point of a fresh REPL
// session MUST call `_cl_init` first (same discipline as _er_init /
// _se_init). Un-called degrades gracefully to the zero state
// (depth=0 => CTX_PIPELINE); the harness still wires _cl_init at
// R229.M3-dispatch session-boot.
//
// =============================================================================
// TOKEN RECORD (16 B)
// =============================================================================
//
//   offset  size  field
//   ------  ----  ---------------------------------
//    0x00    2    kind                u16
//    0x02    1    ctx                 u8 (CTX_*)
//    0x03    1    flags               u8 (reserved; 0 at M4)
//    0x04    4    src_offset          u32
//    0x08    4    src_length          u32
//    0x0C    4    payload             u32 (0 at M4)
//
// 16-byte stride matches `shl r, 4` for slot addressing.
//
// For TOK_LBRACE: ctx = inner (post-push). For TOK_RBRACE: ctx = inner
// (pre-pop). Both brace tokens thus carry the context code of what's
// INSIDE the braces, so a downstream dispatcher can discriminate a
// lambda-closing `}` from a datalog-closing `}` by a single byte load.
//
// =============================================================================
// STATUS CODES -- band 0x4200..0x42FF
// =============================================================================
//
//   CL_OK                      : 0
//   CL_ERR_SYNTAX              : 0x4200   unrecognised byte / bad op lookahead
//   CL_ERR_STACK_OVERFLOW      : 0x4201   push on depth == 16
//   CL_ERR_STACK_UNDERFLOW     : 0x4202   pop on depth == 0
//   CL_ERR_UNMATCHED_BRACE     : 0x4203   '}' with depth == 0 at emit time
//   CL_ERR_PIPE_IN_DATALOG     : 0x4204   '|' in CTX_DATALOG
//   CL_ERR_UNTERMINATED_STRING : 0x4205   '"' with no closing '"'
//   CL_ERR_OUT_TOO_SMALL       : 0x4206   out_cap insufficient
//   CL_ERR_BAD_CTX             : 0x4207   push with ctx > 2
//
// Band carved on a kilo-step boundary past R224.M3 EffectRow
// (0x4000..0x40FF) and the reserved R133.M6 kernel-parallel slot
// (0x4100..0x41FF). Slots 0x4208..0x42FF reserved for M4.1+.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8 / imm32 (0xFF, 0xFFFF).
//   - No 2-op `imul r, imm` -- stride multiplies are `shl r, 1`/`shl r, 4`.
//   - No multiline `pub let = "..."` -- single-line justifications.
//   - Module basename `CtxLexer` matches `ctx_lexer.pdx`.
//   - Labels prefixed `cl_` with per-function suffix (`cl_lt_`,
//     `cl_ti_`, `cl_ip_`, `cl_pp_`, `cl_cu_`, `cl_tz_`); confirmed
//     disjoint from `cc_`/`cs_`/`clo_` and from paideia-as reserved
//     keywords (`loop`, `if`, `let`, `fn`, `ret`, `done`).
//   - All `cmp reg, imm` immediates <= 0x42FF < 0x80000000 so direct
//     `cmp reg, imm32` is sign-safe. No MOVABS staging.
//   - Byte loads via `xor rax, rax; mov_b rax, [base + idx * 1]`.
//   - u32 stores via `mov_d [base + disp], reg`.
//   - u16 stores via two `mov_b` byte stores (low, high).
//   - `_cl_lex_token` is a PURE LEAF -- no nested CALL; stack ops
//     inlined via direct .bss writes.
//   - `_cl_tokenize` has ONE nested CALL per iteration (_cl_lex_token).
//   - Full-u64 status compare on nested CALL (Wave 118 lesson): the
//     tokenize loop masks the status low 32 via `shl rax,32; shr rax,32`
//     rather than `and rax, imm64`.
//
// =============================================================================
// Upstream: paideia-os#2485 (R221 umbrella), paideia-os#2654 (R221.M4).
// Substrate: paideia-os#2651 (R221.M1 Utf8Nfc).
// Design doc: design/shell/ctx-tracking-lexer.md.

module CtxLexer = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 32 bits of packed result)
  // ==========================================================================

  pub let CL_OK                      : u64 = 0
  pub let CL_ERR_SYNTAX              : u64 = 0x4200
  pub let CL_ERR_STACK_OVERFLOW      : u64 = 0x4201
  pub let CL_ERR_STACK_UNDERFLOW     : u64 = 0x4202
  pub let CL_ERR_UNMATCHED_BRACE     : u64 = 0x4203
  pub let CL_ERR_PIPE_IN_DATALOG     : u64 = 0x4204
  pub let CL_ERR_UNTERMINATED_STRING : u64 = 0x4205
  pub let CL_ERR_OUT_TOO_SMALL       : u64 = 0x4206
  pub let CL_ERR_BAD_CTX             : u64 = 0x4207

  // ==========================================================================
  // SECTION 2 -- CONTEXT + TOKEN KIND CONSTANTS
  // ==========================================================================

  pub let CTX_PIPELINE : u64 = 0
  pub let CTX_DATALOG  : u64 = 1
  pub let CTX_LAMBDA   : u64 = 2

  pub let TOK_EOF         : u64 = 0
  pub let TOK_IDENT       : u64 = 1
  pub let TOK_NUMBER      : u64 = 2
  pub let TOK_STRING      : u64 = 3
  pub let TOK_PIPE        : u64 = 4
  pub let TOK_ARG_DELIM   : u64 = 5
  pub let TOK_LBRACE      : u64 = 6
  pub let TOK_RBRACE      : u64 = 7
  pub let TOK_LPAREN      : u64 = 8
  pub let TOK_RPAREN      : u64 = 9
  pub let TOK_COMMA       : u64 = 10
  pub let TOK_KW_DATALOG  : u64 = 11
  pub let TOK_ARROW       : u64 = 12
  pub let TOK_COLON       : u64 = 13
  pub let TOK_DOT         : u64 = 14
  pub let TOK_RULE_ARROW  : u64 = 15
  pub let TOK_QUERY_ARROW : u64 = 16

  pub let CL_STACK_DEPTH_MAX : u64 = 16
  pub let CL_TOKEN_BYTES     : u64 = 16

  // Token field offsets (byte offsets from Token base).
  pub let CL_OFF_KIND       : u64 = 0
  pub let CL_OFF_CTX        : u64 = 2
  pub let CL_OFF_FLAGS      : u64 = 3
  pub let CL_OFF_SRC_OFFSET : u64 = 4
  pub let CL_OFF_SRC_LENGTH : u64 = 8
  pub let CL_OFF_PAYLOAD    : u64 = 12

  // ==========================================================================
  // SECTION 3 -- STATIC STATE (.bss, singleton)
  // ==========================================================================

  pub let mut _cl_stack      : [u8; 16] = uninit @align(8)
  pub let mut _cl_depth      : u64      = uninit @align(8)
  pub let mut _cl_last_kind  : u64      = uninit @align(8)

  // ==========================================================================
  // _cl_init() -> ()
  //
  //   Boot hook. Zero-fills _cl_stack (16 B = 2 u64 stores), _cl_depth
  //   (u64), and _cl_last_kind (u64). Idempotent in the trivial sense
  //   (re-zeroing an already-zero state is a no-op).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cl_ini_.
  // ==========================================================================
  pub let _cl_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): _cl_init zero-fills the module .bss state (16-byte _cl_stack, u64 _cl_depth, u64 _cl_last_kind). Pure leaf; zero pushes; no stack frame; no nested CALL. Three store sites: (1) two u64 stores at [_cl_stack + 0] and [_cl_stack + 8] cover the 16-byte stack via `lea r11, [rip+_cl_stack]; mov [r11+0], rax; mov [r11+8], rax` with rax=0. (2) one u64 store at _cl_depth via `lea r11,[rip+_cl_depth]; mov [r11], rax`. (3) one u64 store at _cl_last_kind. All stores use rax=0 (xor rax,rax). No cmp; no test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_ini_.",
      block: {
        xor rax, rax;

        lea r11, [rip + _cl_stack];
        mov [r11 + 0], rax;
        mov [r11 + 8], rax;

        lea r11, [rip + _cl_depth];
        mov [r11], rax;

        lea r11, [rip + _cl_last_kind];
        mov [r11], rax;

        ret;
      }
    }

  // ==========================================================================
  // _cl_push_ctx(ctx) -> errno
  //
  //   rdi = ctx (0, 1, or 2)
  //   rax = CL_OK on success,
  //         CL_ERR_BAD_CTX if ctx > 2,
  //         CL_ERR_STACK_OVERFLOW if depth == 16.
  //
  //   Public primitive for test harnesses. The internal lexer manages
  //   the stack via direct .bss writes without calling this entry
  //   point (register-pressure reason -- see _cl_lex_token).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cl_pp_.
  // ==========================================================================
  pub let _cl_push_ctx : (u64) -> u64 !{mem} @{} =
    fn (ctx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): push a context byte onto the .bss context stack. Pure leaf; zero pushes; no stack frame; no nested CALL. Validate ctx <= 2 else return CL_ERR_BAD_CTX (0x4207). Load depth via `lea r11,[rip+_cl_depth]; mov rax,[r11]`; if rax >= 16 return CL_ERR_STACK_OVERFLOW (0x4201). Store ctx byte at _cl_stack[rax] via `lea r11,[rip+_cl_stack]; add r11, rax; mov_b [r11+0], rdi`. Bump depth via `add rax, 1; mov [r11_depth], rax`. All immediates (0, 1, 2, 16, 0x4201, 0x4207) fit imm32 and are sign-safe. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_pp_.",
      block: {
        // Validate ctx <= 2.
        cmp rdi, 2;
        ja  cl_pp_bad_ctx;

        // Load depth.
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 16;
        jae cl_pp_overflow;

        // Store stack[depth] := ctx (byte).
        lea r10, [rip + _cl_stack];
        add r10, rax;
        mov_b [r10 + 0], rdi;

        // depth := depth + 1.
        add rax, 1;
        mov [r11], rax;

        // Return CL_OK.
        xor rax, rax;
        ret;

      cl_pp_bad_ctx:
        mov rax, 0x4207;
        ret;

      cl_pp_overflow:
        mov rax, 0x4201;
        ret;
      }
    }

  // ==========================================================================
  // _cl_pop_ctx() -> packed_u64
  //
  //   rax = (popped_ctx << 32) | CL_OK on success,
  //         CL_ERR_STACK_UNDERFLOW on empty stack (depth == 0).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cl_pp_po_.
  // ==========================================================================
  pub let _cl_pop_ctx : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): pop the top of the .bss context stack. Pure leaf; zero pushes; no stack frame; no nested CALL. Load depth; if 0 return CL_ERR_STACK_UNDERFLOW (0x4202). Decrement to idx = depth-1; read ctx byte at _cl_stack[idx]; store back depth := idx. Pack return as (ctx << 32) | CL_OK via `shl rcx,32; or rax, rcx` idiom with rax = CL_OK = 0 and rcx = ctx. All immediates (0, 0x4202) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_pp_po_.",
      block: {
        // Load depth.
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 0;
        je  cl_pp_po_underflow;

        // idx = depth - 1.
        sub rax, 1;

        // Read stack[idx] into rcx.
        lea r10, [rip + _cl_stack];
        add r10, rax;
        xor rcx, rcx;
        mov_b rcx, [r10 + 0];

        // Store depth := idx.
        mov [r11], rax;

        // Pack (ctx << 32) | CL_OK.
        shl rcx, 32;
        xor rax, rax;
        or  rax, rcx;
        ret;

      cl_pp_po_underflow:
        mov rax, 0x4202;
        ret;
      }
    }

  // ==========================================================================
  // _cl_current_ctx() -> u8
  //
  //   rax = stack[depth-1] if depth > 0, else CTX_PIPELINE (0).
  //
  // Pure leaf -- no callee-save push, no stack frame, no nested CALL.
  // Labels prefixed cl_cu_.
  // ==========================================================================
  pub let _cl_current_ctx : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): read the current context -- stack top iff depth>0, else CTX_PIPELINE. Pure leaf; zero pushes; no stack frame; no nested CALL. Load depth; if 0 return 0 (CTX_PIPELINE). Else compute idx = depth-1; read byte at _cl_stack[idx]; return. All immediates (0) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_cu_.",
      block: {
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 0;
        je  cl_cu_pipeline;

        sub rax, 1;
        lea r10, [rip + _cl_stack];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        ret;

      cl_cu_pipeline:
        xor rax, rax;                    // CTX_PIPELINE
        ret;
      }
    }

  // ==========================================================================
  // _cl_lex_token(bytes_ptr, bytes_len, cursor, out_token) -> packed_u64
  //
  //   rdi = bytes_ptr      pointer to NFC-normalised input bytes
  //   rsi = bytes_len      input length in bytes; 0 is well-defined (EOF)
  //   rdx = cursor_in      byte offset to start scanning at
  //   rcx = out_token      pointer to a 16-byte Token slot the lexer fills
  //   rax = (new_cursor << 32) | status
  //
  //   Emits ONE Token record at [out_token]. On success writes the 16
  //   bytes per the §4 layout and sets new_cursor past the consumed
  //   bytes. On error, the Token slot is NOT required to be well-formed
  //   and new_cursor points at the fault byte.
  //
  // Pure leaf -- no nested CALL. Stack-manipulation side effects on
  // '{' and '}' are inlined via direct .bss writes.
  //
  // Register plan:
  //   rbx = bytes_ptr      (saved)
  //   r12 = bytes_len      (saved)
  //   r13 = cursor         (mutable; walks forward)
  //   r14 = out_token      (fixed base)
  //   r15 = start_offset   (saved at the first byte of this token)
  //   r8  = token kind     (final value for emit path)
  //   r9  = scratch        (loop counters, lookahead cursor)
  //   r10, r11, rax, rcx, rdx, rdi, rsi = free scratch
  //
  // Entry rsp%16 == 8; after 5 callee-save pushes rsp%16 == 0; no
  // `sub rsp` needed because there is no nested CALL. Labels prefixed
  // cl_lt_.
  // ==========================================================================
  pub let _cl_lex_token : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_in: u64) (out_token: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): _cl_lex_token walks input bytes to the next token boundary and writes a 16-byte Token record. Pure leaf -- no nested CALL; all .bss stack ops inlined. 5 callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=cursor, r14=out_token, r15=start_offset) = 40 B; entry rsp%16==8, after 5 pushes rsp%16==0, no `sub rsp` needed because no nested CALL. Byte loads via `xor rax,rax; mov_b rax,[rbx+r13*1]`. All cmp immediates (0x00..0x7F ASCII, 0x4200..0x4207 status) fit imm32 with bit 31 clear. The emit path writes kind as two mov_b (lo, hi via `shr rax,8`), ctx as one mov_b, flags u8 as mov_b 0, src_offset u32 via mov_d, src_length u32 via mov_d, payload u32 via mov_d 0. Lambda-lookahead at `{`: scans forward from cursor+1 past SP/TAB (NOT past LF/CR), checks the first non-WS byte for `|`. datalog-keyword match: 7-byte compare `d a t a l o g` against the ident span. Stack mutations: `{` push BEFORE emit, `}` emit then pop. _cl_last_kind updated on every successful emit via `lea r11,[rip+_cl_last_kind]; mov [r11], r8`. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_lt_.",
      block: {
        // ====================================================================
        // ---- Prologue ------------------------------------------------------
        // ====================================================================
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bytes_ptr
        mov r12, rsi;                    // bytes_len
        mov r13, rdx;                    // cursor
        mov r14, rcx;                    // out_token

        // ====================================================================
        // ---- Whitespace skip ----------------------------------------------
        // ====================================================================
      cl_lt_ws:
        cmp r13, r12;
        jae cl_lt_eof;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x20;                   // SP
        je  cl_lt_ws_adv;
        cmp rax, 0x09;                   // TAB
        je  cl_lt_ws_adv;
        cmp rax, 0x0A;                   // LF
        je  cl_lt_ws_adv;
        cmp rax, 0x0D;                   // CR
        je  cl_lt_ws_adv;
        jmp cl_lt_dispatch;

      cl_lt_ws_adv:
        add r13, 1;
        jmp cl_lt_ws;

        // ====================================================================
        // ---- EOF -----------------------------------------------------------
        // ====================================================================
      cl_lt_eof:
        mov r15, r13;                    // start = cursor
        mov r8, 0;                       // TOK_EOF
        jmp cl_lt_emit;

        // ====================================================================
        // ---- Dispatch on first byte ---------------------------------------
        // ====================================================================
      cl_lt_dispatch:
        // rax = first byte, r13 = cursor at that byte
        mov r15, r13;                    // start_offset snapshot

        // ---- identifier start [A-Za-z_] ---------------------------------
        cmp rax, 0x41;                   // 'A'
        jb  cl_lt_try_digit;
        cmp rax, 0x5A;                   // 'Z'
        jbe cl_lt_ident;
        cmp rax, 0x5F;                   // '_'
        je  cl_lt_ident;
        cmp rax, 0x61;                   // 'a'
        jb  cl_lt_try_other;
        cmp rax, 0x7A;                   // 'z'
        jbe cl_lt_ident;
        jmp cl_lt_try_other;

      cl_lt_try_digit:
        cmp rax, 0x30;                   // '0'
        jb  cl_lt_try_other;
        cmp rax, 0x39;                   // '9'
        ja  cl_lt_try_other;
        jmp cl_lt_number;

      cl_lt_try_other:
        cmp rax, 0x7B;                   // '{'
        je  cl_lt_lbrace;
        cmp rax, 0x7D;                   // '}'
        je  cl_lt_rbrace;
        cmp rax, 0x28;                   // '('
        je  cl_lt_lparen;
        cmp rax, 0x29;                   // ')'
        je  cl_lt_rparen;
        cmp rax, 0x2C;                   // ','
        je  cl_lt_comma;
        cmp rax, 0x2E;                   // '.'
        je  cl_lt_dot;
        cmp rax, 0x3A;                   // ':'
        je  cl_lt_colon;
        cmp rax, 0x3F;                   // '?'
        je  cl_lt_quest;
        cmp rax, 0x2D;                   // '-'
        je  cl_lt_dash;
        cmp rax, 0x7C;                   // '|'
        je  cl_lt_pipe;
        cmp rax, 0x22;                   // '"'
        je  cl_lt_string;
        jmp cl_lt_err_syntax;

        // ====================================================================
        // ---- Identifier / keyword run --------------------------------------
        // ====================================================================
      cl_lt_ident:
        add r13, 1;
      cl_lt_ident_scan:
        cmp r13, r12;
        jae cl_lt_ident_done;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        // [A-Za-z0-9_] ?
        cmp rax, 0x30;
        jb  cl_lt_ident_done;
        cmp rax, 0x39;
        jbe cl_lt_ident_cont;
        cmp rax, 0x41;
        jb  cl_lt_ident_done;
        cmp rax, 0x5A;
        jbe cl_lt_ident_cont;
        cmp rax, 0x5F;
        je  cl_lt_ident_cont;
        cmp rax, 0x61;
        jb  cl_lt_ident_done;
        cmp rax, 0x7A;
        jbe cl_lt_ident_cont;
        jmp cl_lt_ident_done;
      cl_lt_ident_cont:
        add r13, 1;
        jmp cl_lt_ident_scan;

      cl_lt_ident_done:
        // Length = r13 - r15.
        mov r10, r13;
        sub r10, r15;
        // Keyword "datalog" check: length must be 7.
        cmp r10, 7;
        jne cl_lt_ident_plain;
        // byte 0: 'd' (0x64)
        xor rax, rax;
        mov_b rax, [rbx + r15 * 1];
        cmp rax, 0x64;
        jne cl_lt_ident_plain;
        // byte 1: 'a' (0x61)
        mov r9, r15;
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x61;
        jne cl_lt_ident_plain;
        // byte 2: 't' (0x74)
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x74;
        jne cl_lt_ident_plain;
        // byte 3: 'a' (0x61)
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x61;
        jne cl_lt_ident_plain;
        // byte 4: 'l' (0x6C)
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x6C;
        jne cl_lt_ident_plain;
        // byte 5: 'o' (0x6F)
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x6F;
        jne cl_lt_ident_plain;
        // byte 6: 'g' (0x67)
        add r9, 1;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x67;
        jne cl_lt_ident_plain;
        // Match!
        mov r8, 11;                      // TOK_KW_DATALOG
        jmp cl_lt_emit;
      cl_lt_ident_plain:
        mov r8, 1;                       // TOK_IDENT
        jmp cl_lt_emit;

        // ====================================================================
        // ---- Number run ----------------------------------------------------
        // ====================================================================
      cl_lt_number:
        add r13, 1;
      cl_lt_number_scan:
        cmp r13, r12;
        jae cl_lt_number_done;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x30;
        jb  cl_lt_number_done;
        cmp rax, 0x39;
        ja  cl_lt_number_done;
        add r13, 1;
        jmp cl_lt_number_scan;
      cl_lt_number_done:
        mov r8, 2;                       // TOK_NUMBER
        jmp cl_lt_emit;

        // ====================================================================
        // ---- String literal -----------------------------------------------
        // ====================================================================
      cl_lt_string:
        // Opening '"' at r13; content starts at r13+1; r15 was set to r13.
        // We adjust r15 to point at content start, and the token span
        // reflects CONTENT bytes (excludes quotes).
        add r13, 1;                      // past opening quote
        mov r15, r13;                    // start_offset = content start
      cl_lt_string_scan:
        cmp r13, r12;
        jae cl_lt_err_unterm_string;
        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0x22;                   // closing '"'
        je  cl_lt_string_close;
        cmp rax, 0x5C;                   // '\\'
        je  cl_lt_string_esc;
        add r13, 1;
        jmp cl_lt_string_scan;
      cl_lt_string_esc:
        // Consume the backslash and whatever byte follows (if any).
        add r13, 1;
        cmp r13, r12;
        jae cl_lt_err_unterm_string;
        add r13, 1;
        jmp cl_lt_string_scan;
      cl_lt_string_close:
        // r13 points at closing '"'. The span is [r15, r13).
        // We advance past the quote AFTER writing the token record
        // (the record uses r13 as the exclusive end). Record stride
        // bookkeeping: set r8 = TOK_STRING and emit, then post-emit
        // bump r13 past the closing quote (handled in cl_lt_string_emit).
        mov r8, 3;                       // TOK_STRING
        jmp cl_lt_string_emit;

      cl_lt_string_emit:
        // Inline the emit here so the final new_cursor includes the
        // closing quote.
        // Write kind (u16) at [r14 + 0..2]
        mov rax, r8;
        mov_b [r14 + 0], rax;
        shr rax, 8;
        mov_b [r14 + 1], rax;
        // Write ctx (u8) at [r14 + 2]
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 0;
        je  cl_lt_str_ctx_pipe;
        sub rax, 1;
        lea r11, [rip + _cl_stack];
        add r11, rax;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        jmp cl_lt_str_ctx_write;
      cl_lt_str_ctx_pipe:
        xor rax, rax;
      cl_lt_str_ctx_write:
        mov_b [r14 + 2], rax;
        xor rax, rax;
        mov_b [r14 + 3], rax;            // flags = 0
        // src_offset u32 = r15
        mov rax, r15;
        mov_d [r14 + 4], rax;
        // src_length u32 = r13 - r15
        mov rax, r13;
        sub rax, r15;
        mov_d [r14 + 8], rax;
        // payload u32 = 0
        xor rax, rax;
        mov_d [r14 + 12], rax;
        // Update last_kind
        lea r11, [rip + _cl_last_kind];
        mov [r11], r8;
        // Bump cursor past the closing quote.
        add r13, 1;
        jmp cl_lt_finalize;

        // ====================================================================
        // ---- Single-char + two-char operators -----------------------------
        // ====================================================================
      cl_lt_lparen:
        add r13, 1;
        mov r8, 8;                       // TOK_LPAREN
        jmp cl_lt_emit;
      cl_lt_rparen:
        add r13, 1;
        mov r8, 9;                       // TOK_RPAREN
        jmp cl_lt_emit;
      cl_lt_comma:
        add r13, 1;
        mov r8, 10;                      // TOK_COMMA
        jmp cl_lt_emit;
      cl_lt_dot:
        add r13, 1;
        mov r8, 14;                      // TOK_DOT
        jmp cl_lt_emit;

      cl_lt_colon:
        // Lookahead for ':-'
        mov r9, r13;
        add r9, 1;
        cmp r9, r12;
        jae cl_lt_colon_bare;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x2D;                   // '-'
        jne cl_lt_colon_bare;
        add r13, 2;
        mov r8, 15;                      // TOK_RULE_ARROW
        jmp cl_lt_emit;
      cl_lt_colon_bare:
        add r13, 1;
        mov r8, 13;                      // TOK_COLON
        jmp cl_lt_emit;

      cl_lt_quest:
        // '?' must be followed by '-'.
        mov r9, r13;
        add r9, 1;
        cmp r9, r12;
        jae cl_lt_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x2D;                   // '-'
        jne cl_lt_err_syntax;
        add r13, 2;
        mov r8, 16;                      // TOK_QUERY_ARROW
        jmp cl_lt_emit;

      cl_lt_dash:
        // '-' must be followed by '>'.
        mov r9, r13;
        add r9, 1;
        cmp r9, r12;
        jae cl_lt_err_syntax;
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x3E;                   // '>'
        jne cl_lt_err_syntax;
        add r13, 2;
        mov r8, 12;                      // TOK_ARROW
        jmp cl_lt_emit;

        // ====================================================================
        // ---- '|' dispatch (context-sensitive) -----------------------------
        // ====================================================================
      cl_lt_pipe:
        // Determine current context from depth/stack.
        lea r11, [rip + _cl_depth];
        mov r9, [r11];
        cmp r9, 0;
        je  cl_lt_pipe_pipeline;         // depth==0 => CTX_PIPELINE
        sub r9, 1;
        lea r11, [rip + _cl_stack];
        add r11, r9;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        cmp rax, 1;                      // CTX_DATALOG
        je  cl_lt_err_pipe_in_datalog;
        cmp rax, 2;                      // CTX_LAMBDA
        je  cl_lt_pipe_lambda;
        // Any other ctx value: treat as pipeline for safety.
        jmp cl_lt_pipe_pipeline;
      cl_lt_pipe_pipeline:
        add r13, 1;
        mov r8, 4;                       // TOK_PIPE
        jmp cl_lt_emit;
      cl_lt_pipe_lambda:
        add r13, 1;
        mov r8, 5;                       // TOK_ARG_DELIM
        jmp cl_lt_emit;

        // ====================================================================
        // ---- '{' dispatch (context-opening) -------------------------------
        // ====================================================================
      cl_lt_lbrace:
        // Decision 1: previous kind == TOK_KW_DATALOG ?
        lea r11, [rip + _cl_last_kind];
        mov rax, [r11];
        cmp rax, 11;                     // TOK_KW_DATALOG
        je  cl_lt_lb_push_datalog;

        // Decision 2: lookahead past SP/TAB (NOT past LF/CR) for '|'.
        mov r9, r13;
        add r9, 1;                       // past '{'
      cl_lt_lb_look:
        cmp r9, r12;
        jae cl_lt_lb_push_same;          // EOI = no '|' = not a lambda
        xor rax, rax;
        mov_b rax, [rbx + r9 * 1];
        cmp rax, 0x20;                   // SP
        je  cl_lt_lb_look_adv;
        cmp rax, 0x09;                   // TAB
        je  cl_lt_lb_look_adv;
        cmp rax, 0x7C;                   // '|'
        je  cl_lt_lb_push_lambda;
        jmp cl_lt_lb_push_same;
      cl_lt_lb_look_adv:
        add r9, 1;
        jmp cl_lt_lb_look;

      cl_lt_lb_push_same:
        // Push COPY of current context: depth==0 => CTX_PIPELINE,
        // else stack[depth-1].
        lea r11, [rip + _cl_depth];
        mov r10, [r11];
        cmp r10, 0;
        je  cl_lt_lb_do_pipeline;
        mov r9, r10;
        sub r9, 1;
        lea r11, [rip + _cl_stack];
        add r11, r9;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        jmp cl_lt_lb_do_push;
      cl_lt_lb_do_pipeline:
        xor rax, rax;                    // CTX_PIPELINE
        jmp cl_lt_lb_do_push;

      cl_lt_lb_push_datalog:
        mov rax, 1;                      // CTX_DATALOG
        jmp cl_lt_lb_do_push;

      cl_lt_lb_push_lambda:
        mov rax, 2;                      // CTX_LAMBDA
        // fallthrough

      cl_lt_lb_do_push:
        // rax = new_ctx. Push onto stack.
        lea r11, [rip + _cl_depth];
        mov r10, [r11];
        cmp r10, 16;
        jae cl_lt_err_stack_overflow;
        lea r9, [rip + _cl_stack];
        add r9, r10;
        mov_b [r9 + 0], rax;
        add r10, 1;
        mov [r11], r10;

        // Emit TOK_LBRACE with ctx = (post-push, inner).
        add r13, 1;
        mov r8, 6;                       // TOK_LBRACE
        jmp cl_lt_emit;

        // ====================================================================
        // ---- '}' dispatch (context-closing) -------------------------------
        // ====================================================================
      cl_lt_rbrace:
        // Guard: depth must be > 0.
        lea r11, [rip + _cl_depth];
        mov r10, [r11];
        cmp r10, 0;
        je  cl_lt_err_unmatched_brace;

        // Emit TOK_RBRACE with ctx = (pre-pop, inner), THEN pop.
        add r13, 1;
        mov r8, 7;                       // TOK_RBRACE
        // Fall through to the normal emit path, which reads the
        // CURRENT (pre-pop) stack top as ctx. After the emit path
        // finalises (which has already updated last_kind), we pop
        // via the post-emit tail (cl_lt_rb_pop_after).
        jmp cl_lt_emit_then_pop;

      cl_lt_emit_then_pop:
        // Same as cl_lt_emit, but after writing the record and
        // updating last_kind, we pop the stack before finalising.
        // Write kind (u16).
        mov rax, r8;
        mov_b [r14 + 0], rax;
        shr rax, 8;
        mov_b [r14 + 1], rax;
        // Write ctx (u8) from current top.
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 0;
        je  cl_lt_rb_ctx_pipe;
        sub rax, 1;
        lea r11, [rip + _cl_stack];
        add r11, rax;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        jmp cl_lt_rb_ctx_write;
      cl_lt_rb_ctx_pipe:
        xor rax, rax;
      cl_lt_rb_ctx_write:
        mov_b [r14 + 2], rax;
        xor rax, rax;
        mov_b [r14 + 3], rax;            // flags = 0
        mov rax, r15;
        mov_d [r14 + 4], rax;            // src_offset
        mov rax, r13;
        sub rax, r15;
        mov_d [r14 + 8], rax;            // src_length
        xor rax, rax;
        mov_d [r14 + 12], rax;           // payload
        lea r11, [rip + _cl_last_kind];
        mov [r11], r8;
        // Pop: depth -= 1 (depth known > 0 at this point).
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        sub rax, 1;
        mov [r11], rax;
        jmp cl_lt_finalize;

        // ====================================================================
        // ---- Shared emit path (non-stack-mutating tokens) -----------------
        // ====================================================================
      cl_lt_emit:
        // Write kind (u16) at [r14 + 0..2]
        mov rax, r8;
        mov_b [r14 + 0], rax;
        shr rax, 8;
        mov_b [r14 + 1], rax;
        // Write ctx (u8) at [r14 + 2]: current top or CTX_PIPELINE.
        lea r11, [rip + _cl_depth];
        mov rax, [r11];
        cmp rax, 0;
        je  cl_lt_em_ctx_pipe;
        sub rax, 1;
        lea r11, [rip + _cl_stack];
        add r11, rax;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        jmp cl_lt_em_ctx_write;
      cl_lt_em_ctx_pipe:
        xor rax, rax;
      cl_lt_em_ctx_write:
        mov_b [r14 + 2], rax;
        // Write flags (u8) at [r14 + 3] = 0.
        xor rax, rax;
        mov_b [r14 + 3], rax;
        // Write src_offset (u32) at [r14 + 4] = r15.
        mov rax, r15;
        mov_d [r14 + 4], rax;
        // Write src_length (u32) at [r14 + 8] = r13 - r15.
        mov rax, r13;
        sub rax, r15;
        mov_d [r14 + 8], rax;
        // Write payload (u32) at [r14 + 12] = 0.
        xor rax, rax;
        mov_d [r14 + 12], rax;
        // Update _cl_last_kind.
        lea r11, [rip + _cl_last_kind];
        mov [r11], r8;
        // Fall through to finalize.

      cl_lt_finalize:
        // Pack return: (new_cursor << 32) | CL_OK.
        xor rax, rax;                    // CL_OK = 0
        mov r11, r13;
        shl r11, 32;
        or  rax, r11;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // ====================================================================
        // ---- Error return paths -------------------------------------------
        // ====================================================================
      cl_lt_err_syntax:
        mov r10, 0x4200;                 // CL_ERR_SYNTAX
        jmp cl_lt_err_pack;
      cl_lt_err_stack_overflow:
        mov r10, 0x4201;
        jmp cl_lt_err_pack;
      cl_lt_err_unmatched_brace:
        mov r10, 0x4203;
        jmp cl_lt_err_pack;
      cl_lt_err_pipe_in_datalog:
        mov r10, 0x4204;
        jmp cl_lt_err_pack;
      cl_lt_err_unterm_string:
        mov r10, 0x4205;
        jmp cl_lt_err_pack;

      cl_lt_err_pack:
        // Pack: (new_cursor=r13 << 32) | status(r10).
        mov rax, r10;
        mov r11, r13;
        shl r11, 32;
        or  rax, r11;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _cl_tokenize(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr    pointer to a buffer that receives Token records
  //   rcx = out_cap    buffer capacity in bytes (must be >= 16)
  //   rax = (bytes_written << 32) | status
  //
  //   Walks the whole input calling _cl_lex_token until it emits a
  //   TOK_EOF or hits an error. bytes_written counts the Token records
  //   written (including the final TOK_EOF record on a clean walk).
  //
  // Register plan:
  //   rbx = bytes_ptr      (saved)
  //   r12 = bytes_len      (saved)
  //   r13 = out_ptr        (base; immutable)
  //   r14 = out_end        (= out_ptr + out_cap)
  //   r15 = write_cursor   (advances by CL_TOKEN_BYTES per iter)
  //   [rsp + 0] = cursor_in
  //   [rsp + 8] = tok_count (bytes_written / 16; tracks records
  //                           committed BEFORE the fault point on error)
  //
  // One nested CALL per iteration into _cl_lex_token. Entry rsp%16==8;
  // after 5 pushes + sub rsp,16 rsp%16==0 at the nested CALL. Labels
  // prefixed cl_tz_.
  // ==========================================================================
  pub let _cl_tokenize : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R221.M4 (#2654): _cl_tokenize walks input bytes calling _cl_lex_token for successive 16-byte Token records until EOF or error. 5 callee-save pushes (rbx=bytes_ptr, r12=bytes_len, r13=out_ptr, r14=out_end, r15=write_cursor) + sub rsp,16 for two local slots (cursor_in at [rsp+0], tok_count at [rsp+8]) = 56 B frame; entry rsp%16==8, after 5 pushes + 16-pad rsp%16==0 at every nested _cl_lex_token CALL. Loop: (1) OOS check: if r15 + 16 > r14 return (tok_count<<32)|CL_ERR_OUT_TOO_SMALL. (2) Call _cl_lex_token(rbx, r12, [rsp+0], r15). (3) Full-u64 status check: raw rax packs (new_cursor<<32)|status; extract status via `mov r10, rax; shl r10, 32; shr r10, 32` (defensive zero-extend, Wave 118 lesson -- avoids `and r10, imm64`); if status != CL_OK return (tok_count<<32)|status. (4) Extract new_cursor via `shr rax, 32`; store at [rsp+0]. (5) Read emitted kind u8 at [r15+0] (low byte of u16 kind -- always 0 for TOK_EOF, non-zero otherwise). (6) Bump r15 += 16, tok_count += 1. (7) If kind == 0 (TOK_EOF) return (tok_count<<32)|CL_OK. Else continue. All immediates (0, 16, 0x4206) fit imm32. No test; no and-imm64; no imul-r-imm; no multiline let. Labels prefixed cl_tz_.",
      block: {
        // ---- Prologue --------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                    // bytes_ptr
        mov r12, rsi;                    // bytes_len
        mov r13, rdx;                    // out_ptr
        mov r14, rdx;
        add r14, rcx;                    // out_end = out_ptr + out_cap
        mov r15, r13;                    // write_cursor = out_ptr

        xor rax, rax;
        mov [rsp + 0], rax;              // cursor_in = 0
        mov [rsp + 8], rax;              // tok_count = 0

      cl_tz_loop:
        // ---- OOS check: write_cursor + 16 <= out_end ------------------
        mov r10, r15;
        add r10, 16;                     // CL_TOKEN_BYTES
        cmp r10, r14;
        ja  cl_tz_err_oos;

        // ---- Call _cl_lex_token(bytes, len, cursor_in, write_cursor) --
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, [rsp + 0];
        mov rcx, r15;
        call _cl_lex_token;

        // Extract status (low 32) via shl/shr (defensive; Wave 118).
        mov r10, rax;
        shl r10, 32;
        shr r10, 32;                     // r10 = status (zero-extended)
        cmp r10, 0;
        jne cl_tz_err_from_lex;

        // Extract new_cursor (high 32) via shr.
        mov r11, rax;
        shr r11, 32;
        mov [rsp + 0], r11;              // cursor_in = new_cursor

        // Read emitted kind (byte at write_cursor + 0): TOK_EOF iff 0.
        xor rax, rax;
        mov_b rax, [r15 + 0];
        // The u16 kind is split low/high; TOK_EOF=0 means byte 0 and
        // byte 1 both zero. For every other kind at M4 (values 1..16),
        // the low byte is non-zero, so a single-byte compare suffices.

        // Bump write cursor + tok_count regardless of kind.
        add r15, 16;
        mov r11, [rsp + 8];
        add r11, 1;
        mov [rsp + 8], r11;

        // If TOK_EOF (kind == 0) stop with success.
        cmp rax, 0;
        je  cl_tz_done_ok;

        // Else loop.
        jmp cl_tz_loop;

        // ---- Success path --------------------------------------------
      cl_tz_done_ok:
        mov rax, [rsp + 8];              // tok_count
        shl rax, 32;
        // status = CL_OK = 0, so or-with-zero is a no-op; just leave.
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // ---- Error paths ---------------------------------------------
      cl_tz_err_from_lex:
        // r10 holds the status propagated from _cl_lex_token.
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      cl_tz_err_oos:
        mov r10, 0x4206;                 // CL_ERR_OUT_TOO_SMALL
        mov rax, [rsp + 8];
        shl rax, 32;
        or  rax, r10;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
