// tests/proptest_ipc_nfc.pdx -- libpdx-unicode-tables.M8 (paideia-os#2619)
//
// ProptestIpcNfc: three invariant witnesses for the IPC-boundary NFC
// hook primitives (`_ipc_nfc_check`, `_ipc_nfc_apply`).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. Three
// invariants mirror the R131.M8 brief:
//
//   PIN_IDEMPOTENT    -- apply(apply(x)) == apply(x). Formally: for
//                        any input x, calling `_ipc_nfc_apply` twice
//                        yields the same output bytes as calling it
//                        once. Witness: "e" + U+0301 (0x65 0xCC 0x81)
//                        exercises the Latin-combining compose path;
//                        both apply calls produce "é" (0xC3 0xA9).
//
//   PIN_CHECK_APPLY   -- check(apply(x)) == 1 for any x. Formally:
//                        after normalising, the heuristic must declare
//                        the result in NFC. Witness: apply "e"+U+0301
//                        to "é" (0xC3 0xA9), then check "é" and
//                        expect is_nfc=1 (no 0xCC/0xCD bytes in the
//                        output).
//
//   PIN_ASCII         -- check(ascii_string) == 1. Formally: every
//                        pure-ASCII input (every byte < 0x80) is
//                        declared NFC by the fast-path heuristic.
//                        Witness: "hello" (0x68 0x65 0x6C 0x6C 0x6F)
//                        has no 0xCC/0xCD bytes and so returns
//                        is_nfc=1.
//
// =============================================================================
// FIXTURE INPUTS + OUTPUT BUFFERS
// =============================================================================
//
// Three input fixtures and two output buffers in .bss:
//
//   _pin_in_decomp  "e" + U+0301 (3 bytes: 65 CC 81)
//   _pin_in_ascii   "hello"      (5 bytes: 68 65 6C 6C 6F)
//   _pin_in_nfc     filled by apply(decomp) at test-time ("é" = 2 bytes: C3 A9)
//   _pin_out1       intermediate output for the idempotence case (16 bytes)
//   _pin_out2       intermediate output for the idempotence case (16 bytes)
//
// All five live at align(8). pin_reset zero-fills and populates the
// two static input fixtures via mov_b.
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFEDEx)
// =============================================================================
//
//   0            PIN_PASS                     all invariants hold
//   0xFFFFEDE1   PIN_FAIL_IDEMPOTENT          apply twice disagreed with
//                                             apply once (bytes or length)
//   0xFFFFEDE2   PIN_FAIL_CHECK_APPLY         check(apply(x)) was not
//                                             is_nfc=1
//   0xFFFFEDE3   PIN_FAIL_ASCII               check("hello") was not
//                                             is_nfc=1
//
// Extends the paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize
//   0xFFFFED8x  ProptestCollation
//   0xFFFFED9x  ProptestWidth
//   0xFFFFEDAx  VKBench (disjoint, not a proptest driver)
//   0xFFFFEDBx  VKFeatures (disjoint)
//   0xFFFFEDCx  ProptestBidi
//   0xFFFFEDDx  ProptestLocale
//   0xFFFFEDEx  ProptestIpcNfc              <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestIpcNfc`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 0xFFFFEDE3 which is <= 0x7FFFFFFF
//     (sign-safe imm32); no MOVABS staging needed.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 1-5 callee-save pushes + alignment pad for the
//     nested CALLs.
//
// Upstream: paideia-os#2619 (R131.M8 IPC-boundary NFC hook).

module ProptestIpcNfc = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PIN_PASS                : u64 = 0
  pub let PIN_FAIL_IDEMPOTENT     : u64 = 0xFFFFEDE1
  pub let PIN_FAIL_CHECK_APPLY    : u64 = 0xFFFFEDE2
  pub let PIN_FAIL_ASCII          : u64 = 0xFFFFEDE3

  // ==========================================================================
  // Fixture buffers (.bss)
  //
  // _pin_in_decomp holds the 3-byte decomposed sequence 0x65 0xCC 0x81
  // in bytes [0..3] with five trailing zero bytes.
  //
  // _pin_in_ascii holds the 5-byte ASCII string "hello" in bytes
  // [0..5] with three trailing zero bytes.
  //
  // _pin_out1 and _pin_out2 are 16-byte scratch buffers for apply
  // outputs. 16 bytes comfortably holds the 2-byte "é" result plus
  // any future growth.
  // ==========================================================================
  pub let mut _pin_in_decomp : [u8; 8]  = uninit @align(8)
  pub let mut _pin_in_ascii  : [u8; 8]  = uninit @align(8)
  pub let mut _pin_out1      : [u8; 16] = uninit @align(8)
  pub let mut _pin_out2      : [u8; 16] = uninit @align(8)

  // ==========================================================================
  // pin_reset() -> ()
  //
  // Zero the fixtures and output buffers, then populate the two static
  // input fixtures byte-by-byte. Leaf; r10 base, rax byte constant.
  // Labels prefixed pin_rs_.
  // ==========================================================================
  pub let pin_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M8 (#2619): zero fixtures and output buffers, then populate _pin_in_decomp with 'e'+U+0301 (65 CC 81) and _pin_in_ascii with 'hello' (68 65 6C 6C 6F). Matches pl_reset / pb_reset / pw_reset / pnc_reset / pnm_reset pattern. Leaf; no callee-save. Labels prefixed pin_rs_.",
      block: {
        xor rax, rax;

        // Zero _pin_in_decomp (8 bytes = 1 qword).
        lea r10, [rip + _pin_in_decomp];
        mov [r10 + 0], rax;

        // Zero _pin_in_ascii (8 bytes = 1 qword).
        lea r10, [rip + _pin_in_ascii];
        mov [r10 + 0], rax;

        // Zero _pin_out1 (16 bytes = 2 qwords).
        lea r10, [rip + _pin_out1];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        // Zero _pin_out2 (16 bytes = 2 qwords).
        lea r10, [rip + _pin_out2];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        // Populate _pin_in_decomp: "e" + U+0301 = 65 CC 81
        lea r10, [rip + _pin_in_decomp];
        mov rax, 0x65; mov_b [r10 + 0], rax;
        mov rax, 0xCC; mov_b [r10 + 1], rax;
        mov rax, 0x81; mov_b [r10 + 2], rax;

        // Populate _pin_in_ascii: "hello" = 68 65 6C 6C 6F
        lea r10, [rip + _pin_in_ascii];
        mov rax, 0x68; mov_b [r10 + 0], rax;
        mov rax, 0x65; mov_b [r10 + 1], rax;
        mov rax, 0x6C; mov_b [r10 + 2], rax;
        mov rax, 0x6C; mov_b [r10 + 3], rax;
        mov rax, 0x6F; mov_b [r10 + 4], rax;

        ret
      }
    }

  // ==========================================================================
  // pin_case_idempotent() -> u64
  //
  // Invariant PIN_IDEMPOTENT: apply(apply(x)) == apply(x).
  //
  // Procedure:
  //   1. apply(_pin_in_decomp, 3, _pin_out1, 16) -> packed1
  //   2. extract out1_len = packed1 >> 32 (expect 2)
  //   3. apply(_pin_out1, out1_len, _pin_out2, 16) -> packed2
  //   4. extract out2_len = packed2 >> 32 (expect 2)
  //   5. assert out1_len == out2_len
  //   6. assert _pin_out1[0..out1_len] == _pin_out2[0..out1_len]
  //
  // Both normalise calls must leave status=0 (OK) in bits [7:0].
  //
  // 4 callee-save pushes (rbx, r12, r13, r14) + sub rsp 8 pad for
  // rsp%16==0 pre-CALL (SysV). rbx=out1_packed, r12=out2_packed,
  // r13=out1_len, r14=byte-compare cursor. Labels prefixed pin_id_.
  // ==========================================================================
  pub let pin_case_idempotent : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M8 (#2619): idempotence witness. _ipc_nfc_apply('e'+U+0301 -> out1) then _ipc_nfc_apply(out1 -> out2) must agree on length and bytes. Expected length is 2 (bytes C3 A9 for 'é'). 4 callee-save pushes (rbx, r12, r13, r14) + sub rsp 8 pad: 8+32+8=48, 48 mod 16=0 pre-CALL. Status mask 0xFF fits imm32. No test; no and-imm64; no imul-r-imm. Byte loads via mov_b. Labels prefixed pin_id_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pin_reset;

        // ---- First apply: apply(_pin_in_decomp, 3) into _pin_out1 ----
        lea rdi, [rip + _pin_in_decomp];
        mov rsi, 3;
        lea rdx, [rip + _pin_out1];
        mov rcx, 16;
        call _ipc_nfc_apply;
        mov rbx, rax;                   // rbx = packed1

        // status byte in bits [7:0] must be 0.
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pin_id_fail;

        // out1_len = packed1 >> 32
        mov r13, rbx;
        shr r13, 32;

        // ---- Second apply: apply(_pin_out1, out1_len) into _pin_out2 ----
        lea rdi, [rip + _pin_out1];
        mov rsi, r13;
        lea rdx, [rip + _pin_out2];
        mov rcx, 16;
        call _ipc_nfc_apply;
        mov r12, rax;                   // r12 = packed2

        // status byte in bits [7:0] must be 0.
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pin_id_fail;

        // out2_len = packed2 >> 32; must equal out1_len.
        mov r11, r12;
        shr r11, 32;
        cmp r11, r13;
        jne pin_id_fail;

        // ---- Byte-compare _pin_out1[0..out1_len] against _pin_out2 ----
        xor r14, r14;

      pin_id_cmp_loop:
        cmp r14, r13;
        jae pin_id_pass;

        lea r10, [rip + _pin_out1];
        mov_b rax, [r10 + r14];

        lea r10, [rip + _pin_out2];
        mov_b r11, [r10 + r14];

        cmp rax, r11;
        jne pin_id_fail;

        add r14, 1;
        jmp pin_id_cmp_loop;

      pin_id_pass:
        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pin_id_fail:
        mov rax, 0xFFFFEDE1;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pin_case_check_apply() -> u64
  //
  // Invariant PIN_CHECK_APPLY: check(apply(x)) == 1.
  //
  // Procedure:
  //   1. apply(_pin_in_decomp, 3, _pin_out1, 16) -> packed
  //   2. extract out_len = packed >> 32 (expect 2)
  //   3. check(_pin_out1, out_len) -> packed_chk
  //   4. assert (packed_chk >> 32) == 1 (is_nfc)
  //
  // 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: entry rsp%16==8 +
  // 16 (pushes) + 8 (pad) = 32, 32 mod 16=0 pre-CALL. rbx=out_len,
  // r12=is_nfc. Labels prefixed pin_ca_.
  // ==========================================================================
  pub let pin_case_check_apply : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M8 (#2619): check-apply agreement witness. After apply('e'+U+0301) the output 'é' (C3 A9) must satisfy check(output) == is_nfc=1 (no 0xCC/0xCD bytes in C3 A9). 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: 8+16+8=32, 32 mod 16=0 pre-CALL. Status mask 0xFF fits imm32. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed pin_ca_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pin_reset;

        // apply(_pin_in_decomp, 3, _pin_out1, 16)
        lea rdi, [rip + _pin_in_decomp];
        mov rsi, 3;
        lea rdx, [rip + _pin_out1];
        mov rcx, 16;
        call _ipc_nfc_apply;

        // status byte must be 0 (OK) for the test to be meaningful.
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pin_ca_fail;

        // out_len = packed >> 32
        mov rbx, rax;
        shr rbx, 32;

        // check(_pin_out1, out_len)
        lea rdi, [rip + _pin_out1];
        mov rsi, rbx;
        call _ipc_nfc_check;

        // is_nfc = packed_chk >> 32; must be 1.
        mov r12, rax;
        shr r12, 32;
        cmp r12, 1;
        jne pin_ca_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pin_ca_fail:
        mov rax, 0xFFFFEDE2;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pin_case_ascii() -> u64
  //
  // Invariant PIN_ASCII: check(ascii_string) == 1.
  //
  // Procedure:
  //   1. check(_pin_in_ascii, 5) -> packed
  //   2. assert (packed >> 32) == 1 (is_nfc)
  //
  // 1 callee-save push (rbx): entry rsp%16==8 + 8 = (16 mod 16)=0
  // pre-CALL. No pad needed. Labels prefixed pin_as_.
  // ==========================================================================
  pub let pin_case_ascii : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M8 (#2619): ASCII fast-path witness. _ipc_nfc_check('hello') must return is_nfc=1 (no 0xCC/0xCD bytes in 68 65 6C 6C 6F). 1 callee-save push (rbx): 8+8=16, 16 mod 16=0 pre-CALL. All cmp immediates fit imm32. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed pin_as_.",
      block: {
        push rbx;

        call pin_reset;

        // check(_pin_in_ascii, 5)
        lea rdi, [rip + _pin_in_ascii];
        mov rsi, 5;
        call _ipc_nfc_check;

        // is_nfc = packed >> 32; must be 1.
        mov rbx, rax;
        shr rbx, 32;
        cmp rbx, 1;
        jne pin_as_fail;

        xor rax, rax;
        pop rbx;
        ret;

      pin_as_fail:
        mov rax, 0xFFFFEDE3;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pin_run_all() -> u64
  //
  // Umbrella driver: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PIN_PASS). Mirrors pl_run_all,
  // pb_run_all, pw_run_all, pnc_run_all, pnm_run_all, pgc_run_all,
  // tsf_run_all.
  //
  // Entry rsp%16==8; 1 push (rbx) leaves rsp%16==0 pre-CALL. Labels
  // prefixed pin_all_.
  // ==========================================================================
  pub let pin_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M8 (#2619): umbrella driver. Call each pin_case_* in order, return the first non-zero fail code. Entry rsp%16==8; 1 push rbx -> rsp%16==0 pre-CALL. Labels prefixed pin_all_.",
      block: {
        push rbx;

        call pin_case_idempotent;
        cmp rax, 0;
        jne pin_all_exit;

        call pin_case_check_apply;
        cmp rax, 0;
        jne pin_all_exit;

        call pin_case_ascii;
        cmp rax, 0;
        jne pin_all_exit;

        xor rax, rax;

      pin_all_exit:
        pop rbx;
        ret
      }
    }

}
