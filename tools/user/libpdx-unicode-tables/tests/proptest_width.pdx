// tests/proptest_width.pdx -- libpdx-unicode-tables.M5 (paideia-os#2616)
//
// ProptestWidth: three invariant witnesses for the display-width
// primitives (`_width_char`, `_width_str`).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. The
// paideia-as encoder has no QuickCheck / Hypothesis equivalent, so
// property-based coverage is approximated by picking inputs that
// stress each branch of the classifier and the accumulator.
//
// Three invariants mirror the R131.M5 brief:
//
//   PW_NONNEG       -- Non-negative: `_width_str` returns status=0 and
//                       width in the valid range for a well-formed input.
//                       Witness: "hello" (ASCII, five narrow columns).
//                       The u64 return cannot numerically be negative,
//                       so this invariant collapses to "status is OK
//                       AND width equals the hand-computed sum".
//
//   PW_ADDITIVE     -- Monotonic (ASCII-only): concat(a, b) width ==
//                       width(a) + width(b). This is NOT true in general
//                       for Unicode because grapheme-cluster joining can
//                       merge a trailing EXTEND of a with a leading base
//                       of b into a single cluster, dropping the base's
//                       width to zero. For ASCII inputs there is no
//                       cluster-merging (every ASCII cp except CR/LF
//                       starts its own cluster via GB999), so the
//                       additive invariant does hold.
//                       Witness: "abc" (3 bytes) vs "ab" (2 bytes) +
//                       "c" (1 byte). width("abc") must equal
//                       width("ab") + width("c") = 2 + 1 = 3.
//
//   PW_EMPTY        -- Zero input: `_width_str("", 0)` returns status=0
//                       and width=0. The empty-input EOF path through
//                       `_gc_next` must produce an accumulator of zero,
//                       not something incidentally close.
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// Each fixture lives in a .bss byte buffer initialised by pw_reset:
//
//   _pw_in_hello    "hello"       (5 bytes: 68 65 6C 6C 6F)
//   _pw_in_ab       "ab"          (2 bytes: 61 62)
//   _pw_in_c        "c"           (1 byte:  63)
//   _pw_in_abc      "abc"         (3 bytes: 61 62 63)
//   _pw_in_empty    (zero bytes; the ptr is valid but len=0 is passed)
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFED9x)
// =============================================================================
//
//   0            PW_PASS                 all invariants hold
//   0xFFFFED91   PW_FAIL_NONNEG          width_str returned non-OK or
//                                        wrong width on a well-formed
//                                        ASCII input
//   0xFFFFED92   PW_FAIL_ADDITIVE        width(concat) != sum of widths
//                                        for ASCII inputs
//   0xFFFFED93   PW_FAIL_EMPTY           width_str("", 0) not (0, 0)
//
// Extends the paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize
//   0xFFFFED8x  ProptestCollation
//   0xFFFFED9x  ProptestWidth              <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestWidth`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 5 (fixture sizes, status codes 0/2,
//     and widths 0/1/2/3/5), so no imm32 staging needed; the fail-code
//     constants (0xFFFFED9x) are mov'd into rax then returned.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 2 or 3 callee-save pushes + alignment pad for the
//     nested `_width_str` CALLs.
//
// Upstream: paideia-os#2616 (R131.M5 display width).

module ProptestWidth = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PW_PASS                : u64 = 0
  pub let PW_FAIL_NONNEG         : u64 = 0xFFFFED91
  pub let PW_FAIL_ADDITIVE       : u64 = 0xFFFFED92
  pub let PW_FAIL_EMPTY          : u64 = 0xFFFFED93

  // ==========================================================================
  // Fixture buffers (.bss)
  //
  // Each buffer is sized to the maximum fixture length rounded up to a
  // qword multiple. All four buffers live in .bss; pw_reset zero-fills
  // them and populates each before any case runs. The empty case does
  // not need a buffer -- any valid pointer with len=0 works; the hello
  // buffer doubles as the empty-case source.
  // ==========================================================================
  pub let mut _pw_in_hello        : [u8; 8]  = uninit @align(8)
  pub let mut _pw_in_ab           : [u8; 8]  = uninit @align(8)
  pub let mut _pw_in_c            : [u8; 8]  = uninit @align(8)
  pub let mut _pw_in_abc          : [u8; 8]  = uninit @align(8)

  // ==========================================================================
  // pw_reset() -> ()
  //
  // Zero every fixture qword and then populate the four input buffers
  // byte-by-byte via mov_b. Matches tlx_reset / pgc_reset / pnm_reset /
  // pnc_reset's zero-then-write-bytes pattern. Leaf; r10 base, rax byte
  // constant. Labels prefixed pw_rs_.
  // ==========================================================================
  pub let pw_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): zero every fixture qword, then populate the four input buffers byte-by-byte via mov_b. Matches tlx_reset / pgc_reset / pnm_reset / pnc_reset's zero-then-write pattern. Leaf; no callee-save. Labels prefixed pw_rs_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _pw_in_hello];
        mov [r10 + 0], rax;
        lea r10, [rip + _pw_in_ab];
        mov [r10 + 0], rax;
        lea r10, [rip + _pw_in_c];
        mov [r10 + 0], rax;
        lea r10, [rip + _pw_in_abc];
        mov [r10 + 0], rax;

        // Populate _pw_in_hello: 0x68 0x65 0x6C 0x6C 0x6F ("hello").
        lea r10, [rip + _pw_in_hello];
        mov rax, 0x68; mov_b [r10 + 0], rax;
        mov rax, 0x65; mov_b [r10 + 1], rax;
        mov rax, 0x6C; mov_b [r10 + 2], rax;
        mov rax, 0x6C; mov_b [r10 + 3], rax;
        mov rax, 0x6F; mov_b [r10 + 4], rax;

        // Populate _pw_in_ab: 0x61 0x62 ("ab").
        lea r10, [rip + _pw_in_ab];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0x62; mov_b [r10 + 1], rax;

        // Populate _pw_in_c: 0x63 ("c").
        lea r10, [rip + _pw_in_c];
        mov rax, 0x63; mov_b [r10 + 0], rax;

        // Populate _pw_in_abc: 0x61 0x62 0x63 ("abc").
        lea r10, [rip + _pw_in_abc];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0x62; mov_b [r10 + 1], rax;
        mov rax, 0x63; mov_b [r10 + 2], rax;

        ret
      }
    }

  // ==========================================================================
  // pw_case_nonneg() -> u64
  //
  // Invariant: _width_str returns a well-defined (status=0, width=5) for
  // the ASCII input "hello". A u64 return is naturally non-negative, so
  // the "non-negative" invariant is strengthened here to "status is OK
  // AND width equals the hand-computed sum". This guards against:
  //
  //   * The classifier accidentally classifying an ASCII character as
  //     width 0 (controls) or width 2 (fullwidth), which would make the
  //     total disagree with 5.
  //   * _gc_next reporting a false-positive INVALID_UTF8 on a valid
  //     ASCII sequence, which would surface as status=2 and fail here.
  //
  // 2 callee-save pushes + sub rsp 8 pad for CALL alignment. Entry
  // rsp%16==8 + 16 + 8 = 32 mod 16 = 0 pre-CALL. Labels prefixed
  // pw_nn_.
  // ==========================================================================
  pub let pw_case_nonneg : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): non-negative invariant for 'hello'. _width_str returns (status << 0) | (width << 32); status must be 0 (OK) and width must be 5 (five ASCII cps each contributing 1). 2 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pw_nn_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pw_reset;

        // _width_str("hello", 5) -> (5 << 32) | 0 = 0x0000000500000000.
        lea rdi, [rip + _pw_in_hello];
        mov rsi, 5;
        call _width_str;

        // Status (low 8 bits) must be 0.
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pw_nn_fail;

        // Width (bits 63:32) must be 5.
        shr rax, 32;
        cmp rax, 5;
        jne pw_nn_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pw_nn_fail:
        mov rax, 0xFFFFED91;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pw_case_additive() -> u64
  //
  // Invariant: width(concat(a, b)) == width(a) + width(b) for ASCII
  // inputs. For non-ASCII inputs this is NOT true in general -- a
  // trailing EXTEND of `a` can merge with a leading base of `b` into
  // one cluster, dropping the base's width. For ASCII every cp except
  // CR/LF starts its own cluster, so the invariant holds. Witness:
  // "ab" + "c" vs "abc", each component ASCII.
  //
  // 2 callee-save pushes (rbx, r12) + sub rsp 8 pad for CALL
  // alignment. Entry rsp%16==8 + 16 (pushes) + 8 (pad) = 32,
  // 32 mod 16 == 0 pre-CALL (matches SysV). rbx holds width('ab')
  // across the second and third _width_str calls; r12 holds
  // width('c') across the third call. Labels prefixed pw_ad_.
  // ==========================================================================
  pub let pw_case_additive : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): additive invariant for ASCII. width_str('ab') + width_str('c') must equal width_str('abc'). Three serial _width_str calls; store widths in rbx and r12 across calls. 2 callee-save pushes + sub rsp 8 pad: 8+16+8=32, 32 mod 16=0 pre-CALL. Labels prefixed pw_ad_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pw_reset;

        // width_str("ab", 2) -- extract width and save in rbx.
        lea rdi, [rip + _pw_in_ab];
        mov rsi, 2;
        call _width_str;
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pw_ad_fail;
        shr rax, 32;
        mov rbx, rax;              // rbx = width("ab")

        // width_str("c", 1) -- extract width and save in r12.
        lea rdi, [rip + _pw_in_c];
        mov rsi, 1;
        call _width_str;
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pw_ad_fail;
        shr rax, 32;
        mov r12, rax;              // r12 = width("c")

        // width_str("abc", 3) -- extract width into rax, compare to
        // rbx + r12.
        lea rdi, [rip + _pw_in_abc];
        mov rsi, 3;
        call _width_str;
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne pw_ad_fail;
        shr rax, 32;

        // rax must equal rbx + r12.
        add rbx, r12;
        cmp rax, rbx;
        jne pw_ad_fail;

        // Also pin the actual value (defence against all three being
        // simultaneously wrong): rax must be 3.
        cmp rax, 3;
        jne pw_ad_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pw_ad_fail:
        mov rax, 0xFFFFED92;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pw_case_empty() -> u64
  //
  // Invariant: _width_str("", 0) returns status=0 and width=0. The
  // empty-input path goes through _gc_next's immediate-EOF branch
  // (status=1 on the first call); _width_str catches that, exits via
  // w_s_ok, and returns (0 << 32) | 0 == 0.
  //
  // 2 callee-save pushes + sub rsp 8 pad. Labels prefixed pw_em_.
  // ==========================================================================
  pub let pw_case_empty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): zero-input invariant. _width_str on an empty byte range (len=0) must return 0 (status=0, width=0). The empty-input path is _gc_next's immediate-EOF branch; _width_str catches EOF and exits via w_s_ok with the untouched zero accumulator. 2 callee-save pushes + sub rsp 8 pad. Labels prefixed pw_em_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pw_reset;

        // _width_str(_pw_in_hello, 0) -- any valid ptr with len=0.
        lea rdi, [rip + _pw_in_hello];
        mov rsi, 0;
        call _width_str;

        // Full packed return must be exactly 0 (status=0, width=0).
        cmp rax, 0;
        jne pw_em_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pw_em_fail:
        mov rax, 0xFFFFED93;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pw_run_all() -> u64
  //
  // Umbrella driver: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PW_PASS). Mirrors pnc_run_all,
  // pnm_run_all, pgc_run_all, tsf_run_all.
  //
  // 1 push (rbx) + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed
  // pw_all_.
  // ==========================================================================
  pub let pw_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): umbrella driver. Call each pw_case_* in order, return the first non-zero fail code. 1 push + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pw_all_.",
      block: {
        push rbx;
        sub rsp, 8;

        call pw_case_nonneg;
        cmp rax, 0;
        jne pw_all_exit;

        call pw_case_additive;
        cmp rax, 0;
        jne pw_all_exit;

        call pw_case_empty;
        cmp rax, 0;
        jne pw_all_exit;

        xor rax, rax;

      pw_all_exit:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

}
