// tests/proptest_normalize.pdx -- libpdx-unicode-tables.M3 (paideia-os#2614)
//
// ProptestNormalize: four invariant witnesses for the four
// normalization forms (NFC, NFD, NFKC, NFKD).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. The
// paideia-as encoder has no QuickCheck / Hypothesis equivalent, so
// property-based coverage is approximated by picking inputs that
// stress each phase of the TR#15 algorithm (decompose, sort, compose,
// encode).
//
// Four invariants mirror the R131.M3 brief:
//
//   PNM_IDEMP    -- Idempotence: FORM(FORM(x)) == FORM(x) for every
//                   FORM in {NFC, NFD, NFKC, NFKD}. The witness
//                   covers NFC explicitly on "a + U+0301" and
//                   verifies that normalising twice produces the
//                   same output bytes.
//   PNM_RT       -- Round-trip: NFD(NFC(x)) reproduces the input
//                   bytes when the input is NFC-stable (precomposed
//                   á = U+00E1 is such a stable form). This checks
//                   that decompose + compose do not drift the
//                   byte-identity of a canonical representative.
//   PNM_UTF8     -- UTF-8 validity: FORM(x) outputs valid UTF-8 for
//                   every FORM. Verified by linking against this
//                   library's own `utf8_is_valid` on the output
//                   buffer.
//   PNM_LENGTH   -- Length bound: FORM(x).len <= 3 * x.len (TR#15
//                   §13 bound: no code point decomposes to more
//                   than 3 cps, each of which encodes in at most
//                   4 bytes; our Latin baseline tightens this to
//                   2 cps for canonical decomps + 1 cp for compat,
//                   which comfortably fits inside 3*).
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// Each case uses one of these byte fixtures populated in .bss by
// `pnm_reset` before invocation:
//
//   _pnm_in_aacute      "a" + U+0301           (3 bytes: 61 CC 81)
//   _pnm_in_aacute_pc   "a-acute precomposed"  (2 bytes: C3 A1)
//   _pnm_in_cafe_acute  "cafe" + U+0301        (6 bytes: 63 61 66 65 CC 81)
//   _pnm_in_hello       "hello"                (5 bytes: 68 65 6C 6C 6F)
//
// Two output buffers (32 bytes each) collect the normalization
// results. 32 bytes is comfortably above the 3*input upper bound
// for every fixture here.
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFED7x)
// =============================================================================
//
//   0            PNM_PASS                all invariants hold
//   0xFFFFED71   PNM_FAIL_IDEMP          FORM(FORM(x)) != FORM(x)
//   0xFFFFED72   PNM_FAIL_ROUNDTRIP      NFD(NFC(x)) != x for stable x
//   0xFFFFED73   PNM_FAIL_UTF8_VALID     FORM(x) output is malformed UTF-8
//   0xFFFFED74   PNM_FAIL_LENGTH_BOUND   FORM(x).len > 3 * x.len
//
// Extends the existing paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize       <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestNormalize`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 32 (fixture sizes and status
//     codes 0/1/2), so no imm32 staging needed; the fail-code
//     constants (0xFFFFED7x) are MOVABS-staged into r11 then
//     compared.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 3 callee-save pushes + alignment pad for the
//     nested _norm_* / utf8_is_valid CALLs.
//
// Upstream: paideia-os#2614 (R131.M3 normalization).

module ProptestNormalize = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PNM_PASS                : u64 = 0
  pub let PNM_FAIL_IDEMP          : u64 = 0xFFFFED71
  pub let PNM_FAIL_ROUNDTRIP      : u64 = 0xFFFFED72
  pub let PNM_FAIL_UTF8_VALID     : u64 = 0xFFFFED73
  pub let PNM_FAIL_LENGTH_BOUND   : u64 = 0xFFFFED74

  // ==========================================================================
  // Fixture buffers (.bss)
  // ==========================================================================
  pub let mut _pnm_in_aacute       : [u8; 8]  = uninit @align(8)
  pub let mut _pnm_in_aacute_pc    : [u8; 8]  = uninit @align(8)
  pub let mut _pnm_in_cafe_acute   : [u8; 8]  = uninit @align(8)
  pub let mut _pnm_in_hello        : [u8; 8]  = uninit @align(8)

  // Two output buffers; 32 bytes each is comfortably above every
  // fixture's 3*input upper bound.
  pub let mut _pnm_out1            : [u8; 32] = uninit @align(8)
  pub let mut _pnm_out2            : [u8; 32] = uninit @align(8)

  // ==========================================================================
  // pnm_reset() -> ()
  //
  // Zero every fixture / output qword, then populate the four input
  // buffers byte-by-byte via mov_b. Matches tlx_reset / pgc_reset
  // zero-then-write-bytes pattern. Leaf; r10 base, rax byte const.
  // ==========================================================================
  pub let pnm_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): zero all fixture + output buffers, then populate the four input buffers byte-by-byte via mov_b. Matches pgc_reset's zero-then-write pattern. Leaf; no callee-save. Labels prefixed pnm_rs_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _pnm_in_aacute];
        mov [r10 + 0], rax;

        lea r10, [rip + _pnm_in_aacute_pc];
        mov [r10 + 0], rax;

        lea r10, [rip + _pnm_in_cafe_acute];
        mov [r10 + 0], rax;

        lea r10, [rip + _pnm_in_hello];
        mov [r10 + 0], rax;

        lea r10, [rip + _pnm_out1];
        mov [r10 +  0], rax;
        mov [r10 +  8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _pnm_out2];
        mov [r10 +  0], rax;
        mov [r10 +  8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        // Populate _pnm_in_aacute: 0x61 0xCC 0x81 ("a" + U+0301).
        lea r10, [rip + _pnm_in_aacute];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0xCC; mov_b [r10 + 1], rax;
        mov rax, 0x81; mov_b [r10 + 2], rax;

        // Populate _pnm_in_aacute_pc: 0xC3 0xA1 (U+00E1 precomposed).
        lea r10, [rip + _pnm_in_aacute_pc];
        mov rax, 0xC3; mov_b [r10 + 0], rax;
        mov rax, 0xA1; mov_b [r10 + 1], rax;

        // Populate _pnm_in_cafe_acute: 0x63 0x61 0x66 0x65 0xCC 0x81
        // ("cafe" + U+0301).
        lea r10, [rip + _pnm_in_cafe_acute];
        mov rax, 0x63; mov_b [r10 + 0], rax;
        mov rax, 0x61; mov_b [r10 + 1], rax;
        mov rax, 0x66; mov_b [r10 + 2], rax;
        mov rax, 0x65; mov_b [r10 + 3], rax;
        mov rax, 0xCC; mov_b [r10 + 4], rax;
        mov rax, 0x81; mov_b [r10 + 5], rax;

        // Populate _pnm_in_hello: 0x68 0x65 0x6C 0x6C 0x6F.
        lea r10, [rip + _pnm_in_hello];
        mov rax, 0x68; mov_b [r10 + 0], rax;
        mov rax, 0x65; mov_b [r10 + 1], rax;
        mov rax, 0x6C; mov_b [r10 + 2], rax;
        mov rax, 0x6C; mov_b [r10 + 3], rax;
        mov rax, 0x6F; mov_b [r10 + 4], rax;

        ret
      }
    }

  // ==========================================================================
  // pnm_bufcmp(ptr_a, ptr_b, len) -> 0 if equal else 1
  //
  //   rdi = ptr_a
  //   rsi = ptr_b
  //   rdx = len
  //   rax = 0 iff every byte in [0, len) matches between the two
  //         buffers; 1 on first mismatch.
  //
  // Leaf. Labels prefixed pnm_cmp_.
  // ==========================================================================
  pub let pnm_bufcmp : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ptr_a: u64) (ptr_b: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): pnm_bufcmp byte-by-byte compares [ptr_a, ptr_a+len) against [ptr_b, ptr_b+len). Returns 0 for equal, 1 for mismatch. Leaf; no callee-save; byte loads via mov_b. No test; no and-imm64; no imul-r-imm. Labels prefixed pnm_cmp_.",
      block: {
        xor rax, rax;                // i = 0 (in rax, also used as return)
        xor rcx, rcx;                // index

      pnm_cmp_top:
        cmp rcx, rdx;
        jae pnm_cmp_eq;
        mov_b r10, [rdi + rcx];
        mov_b r11, [rsi + rcx];
        cmp r10, r11;
        jne pnm_cmp_ne;
        add rcx, 1;
        jmp pnm_cmp_top;

      pnm_cmp_eq:
        xor rax, rax;
        ret;

      pnm_cmp_ne:
        mov rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // pnm_case_idempotence() -> u64
  //
  // Invariant: NFC(NFC("a" + U+0301)) == NFC("a" + U+0301).
  // The first NFC produces "á" (2 bytes: C3 A1). The second NFC
  // on that output must also be "á" (idempotent). We assert both
  // out1 and out2 have the same byte content and length.
  //
  // 3 callee-save pushes + sub rsp 8 pad. Entry rsp%16==8 + 24 + 8
  // = 40 mod 16 = 8 — wait that is NOT 0. Correct math: entry 8,
  // 3 pushes = +24, rsp%16 = (8+24) mod 16 = 32 mod 16 = 0. Pre-
  // nested-CALL rsp%16==0 ✓ WITHOUT the pad. Add the pad only if
  // the push count is even. Here 3 is odd so no pad -- but we
  // keep a 4th push (r14) for symmetry and the pad disappears.
  // Final: 4 pushes (rbx, r12, r13, r14) + sub rsp 8 = (8+32+8) mod
  // 16 = 48 mod 16 = 0. Pre-nested-CALL ✓.
  //
  // Labels prefixed pnm_id_.
  // ==========================================================================
  pub let pnm_case_idempotence : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): idempotence witness. NFC(NFC('a'+U+0301)) must equal NFC('a'+U+0301). We call _norm_nfc on the input into _pnm_out1, then call _norm_nfc on _pnm_out1 into _pnm_out2, then byte-compare out1 and out2. 4 callee-save pushes (rbx, r12, r13, r14) + sub rsp 8 pad for rsp%16==0 pre-CALL. r12=out1 bytes, r13=out2 bytes. Labels prefixed pnm_id_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnm_reset;

        // First normalization: NFC(in, 3) -> out1 (cap 32).
        lea rdi, [rip + _pnm_in_aacute];
        mov rsi, 3;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfc;

        // Status check.
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_id_fail;

        // Extract out1 bytes.
        shr rax, 32;
        mov r12, rax;                // r12 = out1 byte count

        // Second normalization: NFC(out1, out1_len) -> out2 (cap 32).
        lea rdi, [rip + _pnm_out1];
        mov rsi, r12;
        lea rdx, [rip + _pnm_out2];
        mov rcx, 32;
        call _norm_nfc;

        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_id_fail;

        shr rax, 32;
        mov r13, rax;                // r13 = out2 byte count

        // Lengths must match.
        cmp r12, r13;
        jne pnm_id_fail;

        // Bytes must match.
        lea rdi, [rip + _pnm_out1];
        lea rsi, [rip + _pnm_out2];
        mov rdx, r12;
        call pnm_bufcmp;
        cmp rax, 0;
        jne pnm_id_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnm_id_fail:
        mov rax, 0xFFFFED71;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnm_case_roundtrip() -> u64
  //
  // Invariant: NFD(NFC("a-acute precomposed")) == input.
  // Starting with the NFC-stable form "á" (U+00E1, bytes C3 A1):
  //   step 1: NFC(input)  -> out1 should be "á" unchanged (2 bytes).
  //   step 2: NFD(out1)   -> out2 should be "a" + U+0301 (3 bytes).
  // Then: NFC(out2)       -> out1 should be "á" again (2 bytes), and
  //                          equal input byte-for-byte.
  //
  // 4 pushes + sub rsp 8 pad (same shape as pnm_case_idempotence).
  // Labels prefixed pnm_rt_.
  // ==========================================================================
  pub let pnm_case_roundtrip : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): round-trip witness. NFC(precomposed á) -> out1 == input (stable); NFD(out1) -> out2 (decomposed form); NFC(out2) -> out1' and out1' == original precomposed input (byte-equal). 4 callee-save pushes + sub rsp 8 pad. Labels prefixed pnm_rt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnm_reset;

        // Step 1: NFC(input, 2) -> out1 (cap 32). Should be input byte-equal.
        lea rdi, [rip + _pnm_in_aacute_pc];
        mov rsi, 2;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfc;

        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_rt_fail;
        shr rax, 32;
        mov r12, rax;
        // Lengths must match.
        cmp r12, 2;
        jne pnm_rt_fail;
        // Byte compare out1 vs input.
        lea rdi, [rip + _pnm_out1];
        lea rsi, [rip + _pnm_in_aacute_pc];
        mov rdx, 2;
        call pnm_bufcmp;
        cmp rax, 0;
        jne pnm_rt_fail;

        // Step 2: NFD(out1, 2) -> out2.
        lea rdi, [rip + _pnm_out1];
        mov rsi, 2;
        lea rdx, [rip + _pnm_out2];
        mov rcx, 32;
        call _norm_nfd;

        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_rt_fail;
        shr rax, 32;
        mov r13, rax;                // r13 = out2 length (decomposed)

        // Step 3: NFC(out2) -> out1. Overwrite out1.
        lea rdi, [rip + _pnm_out2];
        mov rsi, r13;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfc;

        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_rt_fail;
        shr rax, 32;
        mov r14, rax;
        cmp r14, 2;
        jne pnm_rt_fail;

        // Final byte compare: out1 vs original input.
        lea rdi, [rip + _pnm_out1];
        lea rsi, [rip + _pnm_in_aacute_pc];
        mov rdx, 2;
        call pnm_bufcmp;
        cmp rax, 0;
        jne pnm_rt_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnm_rt_fail:
        mov rax, 0xFFFFED72;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnm_case_utf8_valid() -> u64
  //
  // Invariant: every form's output is valid UTF-8. Checked by
  // running NFC / NFD / NFKC / NFKD on the "a + U+0301" fixture
  // and running utf8_is_valid on each output.
  //
  // 4 pushes + sub rsp 8 pad. Labels prefixed pnm_uv_.
  // ==========================================================================
  pub let pnm_case_utf8_valid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): UTF-8 validity witness. For each of the four forms, run on 'a + U+0301' and assert utf8_is_valid returns 1 on the output. 4 callee-save pushes + sub rsp 8 pad. Labels prefixed pnm_uv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnm_reset;

        // --- NFC ---
        lea rdi, [rip + _pnm_in_aacute];
        mov rsi, 3;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfc;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_uv_fail;
        shr rax, 32;
        mov r12, rax;
        lea rdi, [rip + _pnm_out1];
        mov rsi, r12;
        call utf8_is_valid;
        cmp rax, 1;
        jne pnm_uv_fail;

        // --- NFD ---
        lea rdi, [rip + _pnm_in_aacute];
        mov rsi, 3;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfd;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_uv_fail;
        shr rax, 32;
        mov r12, rax;
        lea rdi, [rip + _pnm_out1];
        mov rsi, r12;
        call utf8_is_valid;
        cmp rax, 1;
        jne pnm_uv_fail;

        // --- NFKC ---
        lea rdi, [rip + _pnm_in_aacute];
        mov rsi, 3;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfkc;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_uv_fail;
        shr rax, 32;
        mov r12, rax;
        lea rdi, [rip + _pnm_out1];
        mov rsi, r12;
        call utf8_is_valid;
        cmp rax, 1;
        jne pnm_uv_fail;

        // --- NFKD ---
        lea rdi, [rip + _pnm_in_aacute];
        mov rsi, 3;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfkd;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_uv_fail;
        shr rax, 32;
        mov r12, rax;
        lea rdi, [rip + _pnm_out1];
        mov rsi, r12;
        call utf8_is_valid;
        cmp rax, 1;
        jne pnm_uv_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnm_uv_fail:
        mov rax, 0xFFFFED73;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnm_case_length_bound() -> u64
  //
  // Invariant: output length <= 3 * input length. Run NFC and NFD
  // on "cafe + U+0301" (6 bytes) and verify both outputs fit
  // inside 18 bytes (= 3*6).
  //
  // 4 pushes + sub rsp 8 pad. Labels prefixed pnm_lb_.
  // ==========================================================================
  pub let pnm_case_length_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): length-bound witness. TR#15 §13 bound: output <= 3 * input bytes. Run NFC and NFD on 'cafe + U+0301' (6 bytes) and assert each output length <= 18. 4 callee-save pushes + sub rsp 8 pad. r12 = input len, r13 = 3*input len = bound. Labels prefixed pnm_lb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnm_reset;

        mov r12, 6;                  // input length
        // Bound = 3 * input length. Compute via (shl 1 + add).
        mov r13, r12;
        shl r13, 1;
        add r13, r12;                // r13 = 3 * 6 = 18

        // --- NFC ---
        lea rdi, [rip + _pnm_in_cafe_acute];
        mov rsi, r12;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfc;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_lb_fail;
        shr rax, 32;
        cmp rax, r13;
        ja  pnm_lb_fail;

        // --- NFD ---
        lea rdi, [rip + _pnm_in_cafe_acute];
        mov rsi, r12;
        lea rdx, [rip + _pnm_out1];
        mov rcx, 32;
        call _norm_nfd;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnm_lb_fail;
        shr rax, 32;
        cmp rax, r13;
        ja  pnm_lb_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnm_lb_fail:
        mov rax, 0xFFFFED74;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnm_run_all() -> u64
  //
  // Umbrella: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PNM_PASS). Mirrors pgc_run_all /
  // tsf_run_all / tlx_run_all. 1 push (rbx) + sub rsp 8 pad.
  // ==========================================================================
  pub let pnm_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): umbrella driver. Call each pnm_case_* in order, return the first non-zero fail code. 1 push + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pnm_all_.",
      block: {
        push rbx;
        sub rsp, 8;

        call pnm_case_idempotence;
        cmp rax, 0;
        jne pnm_all_exit;

        call pnm_case_roundtrip;
        cmp rax, 0;
        jne pnm_all_exit;

        call pnm_case_utf8_valid;
        cmp rax, 0;
        jne pnm_all_exit;

        call pnm_case_length_bound;
        cmp rax, 0;
        jne pnm_all_exit;

        xor rax, rax;

      pnm_all_exit:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

}
