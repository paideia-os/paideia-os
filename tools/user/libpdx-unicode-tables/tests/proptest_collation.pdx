// tests/proptest_collation.pdx -- libpdx-unicode-tables.M4 (paideia-os#2615)
//
// ProptestCollation: four invariant witnesses for the UCA collation primitives
// (_coll_compare, _coll_sort_key).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the property's
// edge, and the driver asserts the property holds.  Four invariants mirror
// the R131.M4 brief:
//
//   PNC_REFLEX   -- Reflexivity: compare(x, x) == 0 for every x in a
//                   witness set.  Covers ASCII, Latin-1 with diacritic
//                   (NFC form), and "cafe + U+0301" (NFD form).
//
//   PNC_ANTISYM  -- Antisymmetry: compare(x, y) == -compare(y, x).
//                   Covers "a"/"b" (strict order), "a"/"á" (L2 breaks
//                   tie), "a"/"A" (L3 breaks tie).
//
//   PNC_TRANS    -- Transitivity: compare(x,y) < 0 && compare(y,z) < 0
//                   implies compare(x,z) < 0.  Covers {a, b, c}
//                   (strict ascending ASCII) and {a, A, b} (L3 then L1).
//
//   PNC_KEYCMP   -- Sort-key correctness: sign(compare(x, y)) ==
//                   sign(memcmp(sort_key(x), sort_key(y))).  Materialises
//                   both keys to local scratch buffers, calls
//                   _coll_keycmp over them, and compares the sign to
//                   _coll_compare's result.
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// Each fixture lives in a .bss byte buffer initialised by pnc_reset:
//
//   _pnc_in_a           "a"           (1 byte: 61)
//   _pnc_in_b           "b"           (1 byte: 62)
//   _pnc_in_c           "c"           (1 byte: 63)
//   _pnc_in_aupper      "A"           (1 byte: 41)
//   _pnc_in_aacute_pc   "á" NFC       (2 bytes: C3 A1)
//   _pnc_in_aacute_nfd  "a" + U+0301  (3 bytes: 61 CC 81)
//   _pnc_in_cafe_acute  "cafe"+U+0301 (6 bytes: 63 61 66 65 CC 81)
//
// Two sort-key scratch buffers (64 bytes each) collect keys for the
// sort-key-correctness invariant.
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFED8x)
// =============================================================================
//
//   0            PNC_PASS                all invariants hold
//   0xFFFFED81   PNC_FAIL_REFLEXIVITY    compare(x, x) != 0
//   0xFFFFED82   PNC_FAIL_ANTISYMMETRY   compare(x, y) + compare(y, x) != 0
//   0xFFFFED83   PNC_FAIL_TRANSITIVITY   compare(a,b)<0 && compare(b,c)<0
//                                        but compare(a,c) >= 0
//   0xFFFFED84   PNC_FAIL_SORT_KEY       sign(compare(x,y)) != sign(keycmp(...))
//
// Extends the paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize
//   0xFFFFED8x  ProptestCollation      <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestCollation`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 32 (fixture sizes and status codes),
//     so no imm32 staging needed; the fail-code constants (0xFFFFED8x)
//     are mov'd into rax then returned.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 4 callee-save pushes + alignment pad for the nested
//     _coll_* CALLs.
//   - Signed-sign discrimination of _coll_compare's -1/0/1 return uses
//     `cmp rax, 0; je/jl/jg` where the -1 bit pattern is all-ones
//     (0xFFFFFFFFFFFFFFFF) and reads as negative under signed `cmp`.
//
// Upstream: paideia-os#2615 (R131.M4 collation).

module ProptestCollation = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PNC_PASS                : u64 = 0
  pub let PNC_FAIL_REFLEXIVITY    : u64 = 0xFFFFED81
  pub let PNC_FAIL_ANTISYMMETRY   : u64 = 0xFFFFED82
  pub let PNC_FAIL_TRANSITIVITY   : u64 = 0xFFFFED83
  pub let PNC_FAIL_SORT_KEY       : u64 = 0xFFFFED84

  // ==========================================================================
  // Fixture buffers (.bss)
  // ==========================================================================
  pub let mut _pnc_in_a           : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_b           : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_c           : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_aupper      : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_aacute_pc   : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_aacute_nfd  : [u8; 8]  = uninit @align(8)
  pub let mut _pnc_in_cafe_acute  : [u8; 8]  = uninit @align(8)

  pub let mut _pnc_key_a_scratch  : [u8; 64] = uninit @align(8)
  pub let mut _pnc_key_b_scratch  : [u8; 64] = uninit @align(8)

  // ==========================================================================
  // pnc_reset() -> ()
  //
  // Zero every fixture / key qword, then populate the seven input buffers
  // byte-by-byte via mov_b. Matches pnm_reset's zero-then-write pattern.
  // Leaf; r10 base, rax byte const.
  // ==========================================================================
  pub let pnc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): zero all fixture + key buffers, then populate the seven input buffers byte-by-byte via mov_b. Matches pnm_reset's zero-then-write pattern. Leaf; no callee-save. Labels prefixed pnc_rs_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _pnc_in_a];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_b];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_c];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_aupper];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_aacute_pc];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_aacute_nfd];
        mov [r10 + 0], rax;
        lea r10, [rip + _pnc_in_cafe_acute];
        mov [r10 + 0], rax;

        lea r10, [rip + _pnc_key_a_scratch];
        mov [r10 +  0], rax;
        mov [r10 +  8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        lea r10, [rip + _pnc_key_b_scratch];
        mov [r10 +  0], rax;
        mov [r10 +  8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        // Populate single-byte fixtures.
        lea r10, [rip + _pnc_in_a];
        mov rax, 0x61; mov_b [r10 + 0], rax;

        lea r10, [rip + _pnc_in_b];
        mov rax, 0x62; mov_b [r10 + 0], rax;

        lea r10, [rip + _pnc_in_c];
        mov rax, 0x63; mov_b [r10 + 0], rax;

        lea r10, [rip + _pnc_in_aupper];
        mov rax, 0x41; mov_b [r10 + 0], rax;

        // _pnc_in_aacute_pc: 0xC3 0xA1 (U+00E1 precomposed).
        lea r10, [rip + _pnc_in_aacute_pc];
        mov rax, 0xC3; mov_b [r10 + 0], rax;
        mov rax, 0xA1; mov_b [r10 + 1], rax;

        // _pnc_in_aacute_nfd: 0x61 0xCC 0x81 ("a" + U+0301).
        lea r10, [rip + _pnc_in_aacute_nfd];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0xCC; mov_b [r10 + 1], rax;
        mov rax, 0x81; mov_b [r10 + 2], rax;

        // _pnc_in_cafe_acute: 0x63 0x61 0x66 0x65 0xCC 0x81.
        lea r10, [rip + _pnc_in_cafe_acute];
        mov rax, 0x63; mov_b [r10 + 0], rax;
        mov rax, 0x61; mov_b [r10 + 1], rax;
        mov rax, 0x66; mov_b [r10 + 2], rax;
        mov rax, 0x65; mov_b [r10 + 3], rax;
        mov rax, 0xCC; mov_b [r10 + 4], rax;
        mov rax, 0x81; mov_b [r10 + 5], rax;

        ret
      }
    }

  // ==========================================================================
  // pnc_case_reflexivity() -> u64
  //
  // Invariant: compare(x, x) == 0 for every x in a witness set:
  //   {"a", "b", "á" NFC, "cafe"+U+0301}
  //
  // 4 callee-save pushes + sub rsp 8 pad.  Entry rsp%16==8 + 32 + 8 = 48
  // mod 16 = 0 pre-nested-CALL (SysV).  Labels prefixed pnc_rf_.
  // ==========================================================================
  pub let pnc_case_reflexivity : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): reflexivity witness. compare(x, x) must return 0 for every x. Covers {ASCII 'a', ASCII 'b', 'á' NFC (2 bytes), 'cafe'+U+0301 (6 bytes)}. 4 callee-save pushes + sub rsp 8 pad. Labels prefixed pnc_rf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnc_reset;

        // --- compare("a", "a") must be 0 ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_a];
        mov rcx, 1;
        call _coll_compare;
        cmp rax, 0;
        jne pnc_rf_fail;

        // --- compare("b", "b") must be 0 ---
        lea rdi, [rip + _pnc_in_b];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_b];
        mov rcx, 1;
        call _coll_compare;
        cmp rax, 0;
        jne pnc_rf_fail;

        // --- compare("á", "á") must be 0 ---
        lea rdi, [rip + _pnc_in_aacute_pc];
        mov rsi, 2;
        lea rdx, [rip + _pnc_in_aacute_pc];
        mov rcx, 2;
        call _coll_compare;
        cmp rax, 0;
        jne pnc_rf_fail;

        // --- compare("cafe"+U+0301, same) must be 0 ---
        lea rdi, [rip + _pnc_in_cafe_acute];
        mov rsi, 6;
        lea rdx, [rip + _pnc_in_cafe_acute];
        mov rcx, 6;
        call _coll_compare;
        cmp rax, 0;
        jne pnc_rf_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnc_rf_fail:
        mov rax, 0xFFFFED81;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnc_case_antisymmetry() -> u64
  //
  // Invariant: compare(x, y) == -compare(y, x).  Equivalently, compare(x,y)
  // + compare(y,x) == 0 when values are in {-1, 0, 1}.  Covers three pairs:
  //   ("a", "b"), ("a", "á"), ("a", "A").
  //
  // 4 callee-save pushes + sub rsp 8 pad.  Labels prefixed pnc_as_.
  // ==========================================================================
  pub let pnc_case_antisymmetry : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): antisymmetry witness. compare(x,y) + compare(y,x) must sum to 0 under i64 arithmetic (since values are in {-1,0,1}, the sum must be 0). Covers ('a','b'), ('a','á' NFC), ('a','A'). 4 callee-save pushes + sub rsp 8 pad. r12 and r13 hold the two compare results across their serial calls. Labels prefixed pnc_as_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnc_reset;

        // --- Pair 1: compare("a", "b") + compare("b", "a") == 0 ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_b];
        mov rcx, 1;
        call _coll_compare;
        mov r12, rax;
        lea rdi, [rip + _pnc_in_b];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_a];
        mov rcx, 1;
        call _coll_compare;
        mov r13, rax;
        add r12, r13;
        cmp r12, 0;
        jne pnc_as_fail;

        // --- Pair 2: compare("a", "á") + compare("á", "a") == 0 ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_aacute_pc];
        mov rcx, 2;
        call _coll_compare;
        mov r12, rax;
        lea rdi, [rip + _pnc_in_aacute_pc];
        mov rsi, 2;
        lea rdx, [rip + _pnc_in_a];
        mov rcx, 1;
        call _coll_compare;
        mov r13, rax;
        add r12, r13;
        cmp r12, 0;
        jne pnc_as_fail;

        // --- Pair 3: compare("a", "A") + compare("A", "a") == 0 ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_aupper];
        mov rcx, 1;
        call _coll_compare;
        mov r12, rax;
        lea rdi, [rip + _pnc_in_aupper];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_a];
        mov rcx, 1;
        call _coll_compare;
        mov r13, rax;
        add r12, r13;
        cmp r12, 0;
        jne pnc_as_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnc_as_fail:
        mov rax, 0xFFFFED82;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnc_case_transitivity() -> u64
  //
  // Invariant: compare(a, b) < 0 && compare(b, c) < 0 => compare(a, c) < 0.
  //
  // Covers {"a", "b", "c"} (strict ASCII ascending).  We assert
  // compare("a","b") < 0, compare("b","c") < 0, and compare("a","c") < 0.
  //
  // "Less than zero" is tested on the i64 return: the -1 bit pattern
  // (0xFFFFFFFFFFFFFFFF) is negative under signed cmp.  We use `cmp rax, 0;
  // jge fail` (ge is signed; jl matches the signed-negative branch).
  //
  // 4 callee-save pushes + sub rsp 8 pad.  Labels prefixed pnc_tr_.
  // ==========================================================================
  pub let pnc_case_transitivity : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): transitivity witness. compare(a,b)<0 && compare(b,c)<0 => compare(a,c)<0 (signed comparison). Covers {'a','b','c'} (strict ASCII ascending). Signed-less-than discrimination uses `cmp rax,0; jge fail` where jge is the signed branch (-1 is negative, 0 and 1 are non-negative so jge triggers on 0 or 1 and we fail; jl falls through on -1 which is the pass path). 4 callee-save pushes + sub rsp 8 pad. Labels prefixed pnc_tr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnc_reset;

        // compare("a", "b") < 0.
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_b];
        mov rcx, 1;
        call _coll_compare;
        cmp rax, 0;
        jge pnc_tr_fail;

        // compare("b", "c") < 0.
        lea rdi, [rip + _pnc_in_b];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_c];
        mov rcx, 1;
        call _coll_compare;
        cmp rax, 0;
        jge pnc_tr_fail;

        // compare("a", "c") < 0 (transitivity conclusion).
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_c];
        mov rcx, 1;
        call _coll_compare;
        cmp rax, 0;
        jge pnc_tr_fail;

        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnc_tr_fail:
        mov rax, 0xFFFFED83;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnc_case_sort_key() -> u64
  //
  // Invariant: sign(compare(x, y)) == sign(keycmp(sort_key(x), sort_key(y))).
  //
  // Materialises key_a = sort_key("a") and key_b = sort_key("á" NFC) into
  // the local scratch buffers, then calls _coll_keycmp over the keys and
  // compares the SIGN of that result to _coll_compare("a", "á")'s sign.
  //
  // The two paths MUST produce the same sign: _coll_compare internally
  // uses _coll_sort_key + _coll_keycmp, so this is a public-API
  // consistency check more than a semantic surprise -- but it protects
  // against future refactors that might split the paths.
  //
  // 4 callee-save pushes + sub rsp 8 pad.  r12 = direct-compare result;
  // r13 = key-byte-count of a; r14 = key-byte-count of b.  Labels prefixed
  // pnc_sk_.
  // ==========================================================================
  pub let pnc_case_sort_key : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): sort-key-correctness witness. sign(compare(x,y)) must equal sign(keycmp(sort_key(x), sort_key(y))). We take x='a', y='á' NFC: direct compare returns -1 (a < á). Materialising keys and running _coll_keycmp over them must also return -1. 4 callee-save pushes + sub rsp 8 pad. r12=direct-compare rax, r13=key_a byte count, r14=key_b byte count. Encoder: no test (cmp 0); no and-imm64 (0xFF fits imm32); no imul-r-imm. Labels prefixed pnc_sk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        call pnc_reset;

        // --- Direct compare ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_in_aacute_pc];
        mov rcx, 2;
        call _coll_compare;
        mov r12, rax;

        // --- Materialise key_a ---
        lea rdi, [rip + _pnc_in_a];
        mov rsi, 1;
        lea rdx, [rip + _pnc_key_a_scratch];
        mov rcx, 64;
        call _coll_sort_key;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnc_sk_fail;
        shr rax, 32;
        mov r13, rax;

        // --- Materialise key_b ---
        lea rdi, [rip + _pnc_in_aacute_pc];
        mov rsi, 2;
        lea rdx, [rip + _pnc_key_b_scratch];
        mov rcx, 64;
        call _coll_sort_key;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pnc_sk_fail;
        shr rax, 32;
        mov r14, rax;

        // --- keycmp ---
        lea rdi, [rip + _pnc_key_a_scratch];
        mov rsi, r13;
        lea rdx, [rip + _pnc_key_b_scratch];
        mov rcx, r14;
        call _coll_keycmp;

        // Signs must match: r12 (direct) vs rax (keycmp).
        // Three cases: both < 0 (pass), both == 0 (pass), both > 0 (pass).
        // Any mismatch fails.
        //
        //   If r12 < 0 then rax must be < 0.
        //   If r12 == 0 then rax must be == 0.
        //   If r12 > 0 then rax must be > 0.
        //
        // Simplest: if signs differ (r12 negative while rax non-negative,
        // or r12 non-negative while rax negative, or similar for the zero
        // case), fail.  Split by r12's sign.
        cmp r12, 0;
        jl  pnc_sk_direct_neg;
        jg  pnc_sk_direct_pos;
        // r12 == 0: rax must == 0.
        cmp rax, 0;
        jne pnc_sk_fail;
        jmp pnc_sk_ok;

      pnc_sk_direct_neg:
        cmp rax, 0;
        jge pnc_sk_fail;
        jmp pnc_sk_ok;

      pnc_sk_direct_pos:
        cmp rax, 0;
        jle pnc_sk_fail;

      pnc_sk_ok:
        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pnc_sk_fail:
        mov rax, 0xFFFFED84;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pnc_run_all() -> u64
  //
  // Umbrella driver: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PNC_PASS).  Mirrors pnm_run_all,
  // pgc_run_all, tsf_run_all.
  //
  // 1 push (rbx) + sub rsp 8 pad for rsp%16==0 pre-CALL.  Labels prefixed
  // pnc_all_.
  // ==========================================================================
  pub let pnc_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): umbrella driver. Call each pnc_case_* in order, return the first non-zero fail code. 1 push + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pnc_all_.",
      block: {
        push rbx;
        sub rsp, 8;

        call pnc_case_reflexivity;
        cmp rax, 0;
        jne pnc_all_exit;

        call pnc_case_antisymmetry;
        cmp rax, 0;
        jne pnc_all_exit;

        call pnc_case_transitivity;
        cmp rax, 0;
        jne pnc_all_exit;

        call pnc_case_sort_key;
        cmp rax, 0;
        jne pnc_all_exit;

        xor rax, rax;

      pnc_all_exit:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

}
