# libpdx-unicode-tables -- width fingerprint golden
#
# Format: tab-separated `TAG\tINPUT_HEX\tOUTPUT_HEX` where INPUT_HEX
# is the input byte string as hex (no spaces) and OUTPUT_HEX is the
# packed u64 return of `_width_str` encoded as 16 hex nibbles,
# big-endian: `(total_width << 32) | status`.
#
# Empty input is encoded as the literal `-` placeholder for the
# INPUT_HEX column so trailing-tab stripping by any editor cannot
# elide a semantic value: the driver's parser recognises `-` as
# "no bytes".
#
# Reduced EAW baseline (R131.M5): see src/width.pdx module header.
# Each case exercises one path:
#
#   W_ASCII       narrow default (printable ASCII, five columns)
#   W_CJK         wide CJK Unified Ideographs path (U+4E00..U+9FFF)
#   W_FULLWIDTH   wide Fullwidth ASCII path (U+FF01..U+FF60)
#   W_COMBINING   zero-width combining mark path (U+0300..U+036F)
#                 inside a single grapheme cluster (base 'a' = 1,
#                 mark U+0301 contributes 0)
#   W_EMOJI       wide emoji path (U+1F300..U+1F9FF single-range
#                 approximation of Extended_Pictographic)
#   W_MIXED       mixed narrow + wide, width = 1 + 2 = 3
#   W_EMPTY       empty input, width = 0, status = 0
#   W_CONTROL     ESC (0x1B) between two ASCII chars; ESC is C0
#                 control (width 0), 'a' + 'b' = 2; GB4/GB5 split
#                 the string into three single-cp clusters each
#                 contributing its own width
#
# Output decode (OUTPUT_HEX reads top-nibble first):
#
#   0000000500000000  width=5, status=0 (W_ASCII)
#   0000000400000000  width=4, status=0 (W_CJK, W_FULLWIDTH)
#   0000000100000000  width=1, status=0 (W_COMBINING)
#   0000000200000000  width=2, status=0 (W_EMOJI, W_CONTROL)
#   0000000300000000  width=3, status=0 (W_MIXED)
#   0000000000000000  width=0, status=0 (W_EMPTY)
#
# Byte-level walk-throughs:
#
#   W_ASCII     "hello"  = 68 65 6C 6C 6F  (5 ASCII cps, each width 1)
#   W_CJK       "漢字"   = E6 BC A2 E5 AD 97  (U+6F22 + U+5B57, both
#                                              in U+4E00..U+9FFF)
#   W_FULLWIDTH "ＡＢ"   = EF BC A1 EF BC A2  (U+FF21 + U+FF22, both
#                                              in U+FF01..U+FF60)
#   W_COMBINING "a" + U+0301 = 61 CC 81  (base + combining; one cluster
#                                         of width 1)
#   W_EMOJI     "🙂"     = F0 9F 99 82  (U+1F642, in U+1F300..U+1F9FF)
#   W_MIXED     "a漢"    = 61 E6 BC A2  (two clusters: 1 + 2 = 3)
#   W_CONTROL   "a\x1Bb" = 61 1B 62  (three single-cp clusters per
#                                     GB4 break-after-Control and GB5
#                                     break-before-Control; widths
#                                     1 + 0 + 1 = 2)
#
# Milestone: M5 (paideia-os#2616, R131.M5).

W_ASCII	68656C6C6F	0000000500000000
W_CJK	E6BCA2E5AD97	0000000400000000
W_FULLWIDTH	EFBCA1EFBCA2	0000000400000000
W_COMBINING	61CC81	0000000100000000
W_EMOJI	F09F9982	0000000200000000
W_MIXED	61E6BCA2	0000000300000000
W_EMPTY	-	0000000000000000
W_CONTROL	611B62	0000000200000000
