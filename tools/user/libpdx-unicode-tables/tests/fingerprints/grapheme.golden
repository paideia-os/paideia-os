# libpdx-unicode-tables -- grapheme fingerprint golden
#
# Format: tab-separated `TAG\tINPUT_HEX\tOUTPUT_HEX` where
# OUTPUT_HEX is the span list serialised as little-endian u16 pairs
# (start, end), four hex nibbles per u16. Each (start, end) span is
# one grapheme cluster; the empty-input case has an empty OUTPUT_HEX.
#
# Cases are the TR#29 Rev-15 Latin-plus-emoji baseline enumerated by
# the R131.M2 brief:
#
#   GC_AB              "ab"                              2 clusters, OTHER + OTHER
#   GC_A_ACUTE         "a" + U+0301                      1 cluster, GB9 Extend glues
#   GC_A_ACUTE_B       "a" + U+0301 + "b"                2 clusters
#   GC_CRLF            CR + LF                           1 cluster, GB3 fuses
#   GC_LFCR            LF + CR                           2 clusters, GB4 then GB5
#   GC_FLAG_PAIR       flag(US) + flag(JP)               2 clusters, two RI pairs
#   GC_FAMILY          man + ZWJ + woman + ZWJ + girl    1 cluster, GB11 chain
#   GC_EMPTY           (empty)                           0 clusters
#   GC_SINGLE          "a"                               1 cluster
#   GC_LEADING_EXTEND  U+0301 + "a"                      2 clusters, GB1 at start
#
# Milestone: M2 (paideia-os#2613, R131.M2).

GC_AB	6162	00000100 01000200
GC_A_ACUTE	61CC81	00000300
GC_A_ACUTE_B	61CC8162	00000300 03000400
GC_CRLF	0D0A	00000200
GC_LFCR	0A0D	00000100 01000200
GC_FLAG_PAIR	F09F87BAF09F87B8F09F87AFF09F87B5	00000800 08001000
GC_FAMILY	F09F91A8E2808DF09F91A9E2808DF09F91A7	00001200
GC_EMPTY
GC_SINGLE	61	00000100
GC_LEADING_EXTEND	CC8161	00000200 02000300
