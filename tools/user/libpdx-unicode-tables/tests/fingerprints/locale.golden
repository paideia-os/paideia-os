# libpdx-unicode-tables -- locale fingerprint golden
#
# Format: tab-separated `TAG\tINPUT_HEX\tOUTPUT_HEX` where INPUT_HEX
# is the input tag string as hex (no spaces) and OUTPUT_HEX is the
# packed u64 return of `_locale_parse` encoded as 16 hex nibbles,
# big-endian: `(locale_id << 8) | status`.
#
# Reduced locale registry (R131.M7): see src/locale.pdx module header.
# Eight baseline entries at M7:
#
#   id  tag      direction  ambiguous-wide
#   --  -----    ---------  --------------
#   0   C/POSIX  LTR        narrow
#   1   en-US    LTR        narrow
#   2   en-GB    LTR        narrow
#   3   ja-JP    LTR        wide
#   4   zh-CN    LTR        wide
#   5   ko-KR    LTR        wide
#   6   he-IL    RTL        narrow
#   7   ar-SA    RTL        narrow
#
# Each case exercises one path through the parser state machine:
#
#   LOC_PARSE_EN         canonical 5-byte input "en-US"; dispatch hits
#                        the en-US key branch, returns id=1, status=0
#   LOC_PARSE_JA         canonical 5-byte input "ja-JP"; dispatch hits
#                        the ja-JP key branch, returns id=3, status=0
#   LOC_PARSE_HE         canonical 5-byte input "he-IL"; dispatch hits
#                        the he-IL key branch, returns id=6, status=0
#   LOC_PARSE_UNKNOWN    well-formed 5-byte input "xx-YY"; dispatch
#                        falls through every key, returns id=0, status=1
#   LOC_PARSE_MALFORMED  5-byte input "en_US" with underscore at offset
#                        2; separator-gate rejects, returns id=0,
#                        status=2 (loud diagnostic for the classic
#                        POSIX-style separator)
#
# Output decode (OUTPUT_HEX reads top-nibble first):
#
#   0000000000000100   locale_id=1,  status=0 (LOC_PARSE_EN)
#   0000000000000300   locale_id=3,  status=0 (LOC_PARSE_JA)
#   0000000000000600   locale_id=6,  status=0 (LOC_PARSE_HE)
#   0000000000000001   locale_id=0,  status=1 (LOC_PARSE_UNKNOWN)
#   0000000000000002   locale_id=0,  status=2 (LOC_PARSE_MALFORMED)
#
# Byte-level walk-throughs:
#
#   LOC_PARSE_EN         "en-US"  = 65 6E 2D 55 53
#                                   lang bytes 'e' 'n' (already lowercase);
#                                   region bytes 'U' 'S' (already upper);
#                                   key = 0x53556E65 -> en-US (id=1)
#                                   -> packed = (1 << 8) | 0 = 0x00000100
#
#   LOC_PARSE_JA         "ja-JP"  = 6A 61 2D 4A 50
#                                   lang bytes 'j' 'a'; region bytes 'J' 'P';
#                                   key = 0x504A616A -> ja-JP (id=3)
#                                   -> packed = (3 << 8) | 0 = 0x00000300
#
#   LOC_PARSE_HE         "he-IL"  = 68 65 2D 49 4C
#                                   lang bytes 'h' 'e'; region bytes 'I' 'L';
#                                   key = 0x4C496568 -> he-IL (id=6)
#                                   -> packed = (6 << 8) | 0 = 0x00000600
#
#   LOC_PARSE_UNKNOWN    "xx-YY"  = 78 78 2D 59 59
#                                   lang bytes 'x' 'x'; region bytes 'Y' 'Y';
#                                   key = 0x59597878 -> no match
#                                   -> packed = (0 << 8) | 1 = 0x00000001
#
#   LOC_PARSE_MALFORMED  "en_US"  = 65 6E 5F 55 53
#                                   byte[2]=0x5F ('_') -> separator-gate
#                                   returns MALFORMED
#                                   -> packed = (0 << 8) | 2 = 0x00000002
#
# Milestone: M7 (paideia-os#2618, R131.M7).

LOC_PARSE_EN	656E2D5553	0000000000000100
LOC_PARSE_JA	6A612D4A50	0000000000000300
LOC_PARSE_HE	68652D494C	0000000000000600
LOC_PARSE_UNKNOWN	78782D5959	0000000000000001
LOC_PARSE_MALFORMED	656E5F5553	0000000000000002
