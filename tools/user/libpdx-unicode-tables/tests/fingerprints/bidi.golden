# libpdx-unicode-tables -- bidi fingerprint golden
#
# Format: tab-separated `TAG\tINPUT_HEX\tOUTPUT_HEX` where INPUT_HEX
# is the input byte string as hex (no spaces) and OUTPUT_HEX is the
# concatenation of 16-byte run entries, each entry serialised as
# 32 hex nibbles (little-endian within each field):
#
#   bytes 0..3   byte_start (u32 LE)
#   bytes 4..7   byte_end   (u32 LE)
#   byte 8       class      (u8;  0=L, 1=R, 2=N, 3=AN, 4=EN)
#   bytes 9..15  padding    (7 x 0x00)
#
# One run entry = 32 nibbles. Multiple runs are concatenated with no
# separator. Empty INPUT_HEX (literal empty column) encodes the
# zero-byte input; empty OUTPUT_HEX encodes "no runs emitted".
#
# The packed u64 return of `_bidi_runs` -- (runs_emitted << 32) |
# status -- is NOT encoded here directly; it can be derived from the
# number of 32-nibble entries in OUTPUT_HEX (runs_emitted = len/32)
# with status = 0 on every entry in this file (every case is a
# well-formed UTF-8 input with sufficient capacity).
#
# Reduced bidi table (R131.M6): see src/bidi.pdx module header. Each
# case exercises one path through the aggregator state machine:
#
#   BIDI_PURE_LTR       all-L input, single run (no class change)
#   BIDI_PURE_RTL       all-R input, single run; Hebrew letters
#                       (each U+05xx = 2 bytes in UTF-8)
#   BIDI_MIXED          L->R class change: two runs
#   BIDI_NUMBER         all-EN input, single run; ASCII digits
#   BIDI_ARABIC_DIGITS  all-AN input, single run; Arabic-Indic digits
#                       (U+066x = 2 bytes in UTF-8)
#   BIDI_NEUTRAL        all-N input, single run; ASCII space
#   BIDI_EMPTY          zero-byte input, zero runs (empty OUTPUT_HEX)
#   BIDI_SINGLE_L       one-byte L input, single run; ASCII letter 'x'
#
# Byte-level walk-throughs:
#
#   BIDI_PURE_LTR       "hello"  = 68 65 6C 6C 6F  (5 bytes, 5 ASCII
#                                 cps, all class L)
#                       -> 1 run {0, 5, L=0}
#                       -> 00000000 05000000 00 00000000000000
#
#   BIDI_PURE_RTL       "שלום"   = D7 A9 D7 9C D7 95 D7 9D  (8 bytes,
#                                 4 Hebrew letters: U+05E9, U+05DC,
#                                 U+05D5, U+05DD; all class R)
#                       -> 1 run {0, 8, R=1}
#                       -> 00000000 08000000 01 00000000000000
#
#   BIDI_MIXED          "abcשלום" = 61 62 63 D7 A9 D7 9C D7 95 D7 9D
#                                   (11 bytes: 3 ASCII L + 4 Hebrew R)
#                       -> 2 runs {0, 3, L=0}, {3, 11, R=1}
#                       -> 00000000 03000000 00 00000000000000
#                          03000000 0B000000 01 00000000000000
#
#   BIDI_NUMBER         "123"    = 31 32 33  (3 bytes, 3 ASCII digits,
#                                 all class EN)
#                       -> 1 run {0, 3, EN=4}
#                       -> 00000000 03000000 04 00000000000000
#
#   BIDI_ARABIC_DIGITS  "٠١٢"    = D9 A0 D9 A1 D9 A2  (6 bytes, 3
#                                 Arabic-Indic digits U+0660, U+0661,
#                                 U+0662; all class AN -- peeled from
#                                 the Arabic R block)
#                       -> 1 run {0, 6, AN=3}
#                       -> 00000000 06000000 03 00000000000000
#
#   BIDI_NEUTRAL        " "      = 20  (1 byte, ASCII space, class N)
#                       -> 1 run {0, 1, N=2}
#                       -> 00000000 01000000 02 00000000000000
#
#   BIDI_EMPTY          ""       = (zero bytes)
#                       -> 0 runs
#                       -> OUTPUT_HEX empty
#
#   BIDI_SINGLE_L       "x"      = 78  (1 byte, ASCII letter, class L)
#                       -> 1 run {0, 1, L=0}
#                       -> 00000000 01000000 00 00000000000000
#
# Milestone: M6 (paideia-os#2617, R131.M6).

BIDI_PURE_LTR	68656C6C6F	00000000050000000000000000000000
BIDI_PURE_RTL	D7A9D79CD795D79D	00000000080000000100000000000000
BIDI_MIXED	616263D7A9D79CD795D79D	00000000030000000000000000000000030000000B0000000100000000000000
BIDI_NUMBER	313233	00000000030000000400000000000000
BIDI_ARABIC_DIGITS	D9A0D9A1D9A2	00000000060000000300000000000000
BIDI_NEUTRAL	20	00000000010000000200000000000000
BIDI_EMPTY
BIDI_SINGLE_L	78	00000000010000000000000000000000
