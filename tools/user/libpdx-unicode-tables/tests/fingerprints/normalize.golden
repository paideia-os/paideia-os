# libpdx-unicode-tables -- normalize fingerprint golden
#
# Format: tab-separated `TAG\tFORM\tINPUT_HEX\tOUTPUT_HEX` where
# FORM is one of {NFC, NFD, NFKC, NFKD}, INPUT_HEX is the input
# bytes as hex (no spaces), and OUTPUT_HEX is the expected output
# bytes. The empty-input / empty-output case is encoded as the
# literal `-` placeholder (both HEX columns), so trailing-tab
# stripping by any editor cannot elide a semantic value: the
# driver's parser recognises `-` as "no bytes".
#
# Cases cover the R131.M3 baseline:
#
#   NFC_A_ACUTE               NFC("a" + U+0301)      -> "a" with acute (U+00E1)
#   NFD_A_ACUTE_PRECOMPOSED   NFD("a" with acute)    -> "a" + U+0301
#   NFKC_FULLWIDTH            NFKC(FULLWIDTH a)      -> "a" (U+0061)
#   NFKD_FULLWIDTH            NFKD(FULLWIDTH a)      -> "a"
#   NFC_IDEMPOTENT            NFC("a" with acute)    -> "a" with acute (stable)
#   NFD_EMPTY                 NFD("")                -> "" (empty-passthrough)
#   NFC_MULTIPLE              NFC("cafe" + U+0301)   -> "cafe" with final acute
#   NFC_PASSTHROUGH           NFC("hello")           -> "hello" (ASCII stable)
#
# Milestone: M3 (paideia-os#2614, R131.M3).

NFC_A_ACUTE	NFC	61CC81	C3A1
NFD_A_ACUTE_PRECOMPOSED	NFD	C3A1	61CC81
NFKC_FULLWIDTH	NFKC	EFBD81	61
NFKD_FULLWIDTH	NFKD	EFBD81	61
NFC_IDEMPOTENT	NFC	C3A1	C3A1
NFD_EMPTY	NFD	-	-
NFC_MULTIPLE	NFC	63616665CC81	636166C3A9
NFC_PASSTHROUGH	NFC	68656C6C6F	68656C6C6F
