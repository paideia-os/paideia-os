# libpdx-unicode-tables -- ipc_nfc fingerprint golden
#
# Format: tab-separated `TAG\tOP\tINPUT_HEX\tOUTPUT_HEX` where OP is one
# of {check, apply}, INPUT_HEX is the input bytes as hex (no spaces),
# and OUTPUT_HEX is:
#
#   * For OP=check: the packed u64 return of `_ipc_nfc_check` encoded
#     as 16 hex nibbles, big-endian: `(is_nfc << 32) | status`.
#   * For OP=apply: the output bytes written to the destination buffer.
#     The out_bytes field of `_ipc_nfc_apply`'s packed return equals
#     the byte length of this field divided by 2.
#
# The empty-input / empty-output case is encoded as the literal `-`
# placeholder (both HEX columns) so trailing-tab stripping by any
# editor cannot elide a semantic value: the driver's parser recognises
# `-` as "no bytes". The check-on-empty case still has a well-defined
# packed u64 result; it is written out explicitly below.
#
# IPC-boundary NFC hook heuristic (R131.M8): the check path scans for
# UTF-8 lead bytes 0xCC and 0xCD. Any hit returns is_nfc=0; no hit
# returns is_nfc=1. ASCII inputs (every byte < 0x80) naturally miss
# the 0xCC/0xCD comparison and fall through to is_nfc=1.
#
# Cases cover the R131.M8 baseline:
#
#   IPC_NFC_ASCII         check("hello")           -> is_nfc=1, status=0
#   IPC_NFC_PRECOMPOSED   check("é" = U+00E9)      -> is_nfc=1, status=0
#                         (two-byte UTF-8 C3 A9; no 0xCC/0xCD leads)
#   IPC_NFC_DECOMPOSED    check("e" + U+0301)      -> is_nfc=0, status=0
#                         (three bytes 65 CC 81; 0xCC lead triggers)
#   IPC_NFC_EMPTY         check("")                -> is_nfc=1, status=0
#                         (empty input falls through to the no-mark path)
#   IPC_NFC_APPLY         apply("e" + U+0301)      -> "é" (C3 A9), 2 bytes
#                         (M3 _norm_nfc composes the base+mark pair to
#                          the Latin-1 Supplement precomposed form)
#
# Output decode for check cases (OUTPUT_HEX reads top-nibble first):
#
#   0000000100000000   is_nfc=1,  status=0  (IPC_NFC_ASCII)
#   0000000100000000   is_nfc=1,  status=0  (IPC_NFC_PRECOMPOSED)
#   0000000000000000   is_nfc=0,  status=0  (IPC_NFC_DECOMPOSED)
#   0000000100000000   is_nfc=1,  status=0  (IPC_NFC_EMPTY)
#
# Byte-level walk-throughs:
#
#   IPC_NFC_ASCII         "hello"  = 68 65 6C 6C 6F
#                                    5 bytes; every byte < 0x80;
#                                    no 0xCC or 0xCD lead found;
#                                    -> packed = (1 << 32) | 0 = 0x100000000
#
#   IPC_NFC_PRECOMPOSED   "é"      = C3 A9
#                                    2 bytes; lead byte 0xC3 != 0xCC && != 0xCD;
#                                    continuation 0xA9 != 0xCC && != 0xCD;
#                                    no mark found;
#                                    -> packed = (1 << 32) | 0 = 0x100000000
#
#   IPC_NFC_DECOMPOSED    "e+acute" = 65 CC 81
#                                    3 bytes; byte[0]=0x65 clear;
#                                    byte[1]=0xCC -> MATCH -> is_nfc=0;
#                                    -> packed = (0 << 32) | 0 = 0x0
#
#   IPC_NFC_EMPTY         ""       = (zero bytes)
#                                    rcx==0 at loop head; rcx>=rsi so
#                                    the loop exits via the ipc_chk_nfc
#                                    arm immediately;
#                                    -> packed = (1 << 32) | 0 = 0x100000000
#
#   IPC_NFC_APPLY         input    = 65 CC 81
#                         output   = C3 A9  (two bytes; the Latin-1
#                                    Supplement precomposed form of
#                                    U+00E9 'LATIN SMALL LETTER E
#                                    WITH ACUTE'; M3's canonical
#                                    decomp table carries this entry
#                                    as (U+00E9, U+0065, U+0301), and
#                                    the compose phase inverts it)
#                                    out_bytes = 2, status = 0
#                                    packed = (2 << 32) | 0 = 0x200000000
#
# Milestone: M8 (paideia-os#2619, R131.M8).

IPC_NFC_ASCII	check	68656C6C6F	0000000100000000
IPC_NFC_PRECOMPOSED	check	C3A9	0000000100000000
IPC_NFC_DECOMPOSED	check	65CC81	0000000000000000
IPC_NFC_EMPTY	check	-	0000000100000000
IPC_NFC_APPLY	apply	65CC81	C3A9
