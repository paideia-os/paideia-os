// tests/proptest_bidi.pdx -- libpdx-unicode-tables.M6 (paideia-os#2617)
//
// ProptestBidi: three invariant witnesses for the bidi run-aggregator
// primitives (`_bidi_class`, `_bidi_runs`).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. The
// paideia-as encoder has no QuickCheck / Hypothesis equivalent, so
// property-based coverage is approximated by picking inputs that
// stress each branch of the aggregator state machine.
//
// Three invariants mirror the R131.M6 brief:
//
//   PB_COVERAGE  -- Coverage: for a well-formed UTF-8 input, the emitted
//                   runs cover [0, bytes_len) exactly: no gaps, no
//                   overlaps. The first run's byte_start is 0, the last
//                   run's byte_end is bytes_len, and run[i].byte_end ==
//                   run[i+1].byte_start for every consecutive pair.
//                   Witness: "abcשלום" -- 2 runs expected
//                   (L spanning bytes 0..3, R spanning bytes 3..11).
//
//   PB_NONEMPTY  -- Non-empty: every emitted run has byte_end > byte_start.
//                   The run-aggregator never produces an empty run (one
//                   with byte_end == byte_start) because a run is
//                   initialised only on the first cluster of a new class
//                   and extended per cluster; byte_end at flush time is
//                   always strictly greater than byte_start.
//                   Witness: "abcשלום" -- both runs have end > start.
//
//   PB_MONOTONE  -- Monotone class: consecutive runs always carry
//                   different class values. The aggregator's "same
//                   class => extend" branch guarantees two adjacent runs
//                   never share a class, since a class change is the
//                   only trigger for a run boundary.
//                   Witness: "abcשלום" -- run[0].class == L (0) and
//                   run[1].class == R (1); 0 != 1 so the invariant holds.
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// A single input fixture is shared across all three invariants (the
// witness exercises every property on the same mixed-direction string):
//
//   _pb_in_mixed    "abcשלום"    (11 bytes: 61 62 63 D7 A9 D7 9C D7 95 D7 9D)
//
// Output buffer: _pb_out_runs holds up to 4 runs x 16 bytes = 64 bytes.
// Only 2 runs are expected but the extra capacity catches any accidental
// over-emission (e.g. a run split that should have been an extension).
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFEDCx)
// =============================================================================
//
//   0            PB_PASS                 all invariants hold
//   0xFFFFEDC1   PB_FAIL_COVERAGE        runs do not cover [0, bytes_len)
//                                        exactly: gaps, overlaps, or wrong
//                                        endpoints
//   0xFFFFEDC2   PB_FAIL_NONEMPTY        at least one run has byte_end
//                                        <= byte_start
//   0xFFFFEDC3   PB_FAIL_MONOTONE        consecutive runs share a class
//
// Extends the paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize
//   0xFFFFED8x  ProptestCollation
//   0xFFFFED9x  ProptestWidth
//   0xFFFFEDAx  VKBench (vk/bench.pdx; disjoint, not a proptest driver)
//   0xFFFFEDBx  VKFeatures (vk/vk_features.pdx; disjoint)
//   0xFFFFEDCx  ProptestBidi              <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestBidi`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 11 (fixture sizes, status codes,
//     class values 0..4), so no imm32 staging needed; the fail-code
//     constants (0xFFFFEDCx) are mov'd into rax then returned.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 3 callee-save pushes + alignment pad for the
//     nested `_bidi_runs` CALL.
//
// Upstream: paideia-os#2617 (R131.M6 bidi runs).

module ProptestBidi = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PB_PASS                : u64 = 0
  pub let PB_FAIL_COVERAGE       : u64 = 0xFFFFEDC1
  pub let PB_FAIL_NONEMPTY       : u64 = 0xFFFFEDC2
  pub let PB_FAIL_MONOTONE       : u64 = 0xFFFFEDC3

  // ==========================================================================
  // Fixture buffers (.bss)
  //
  // Input fixture is 16 bytes (holds "abcשלום" = 11 bytes with room to
  // spare). Output buffer is 64 bytes (4 runs x 16 bytes); only 2 runs
  // are expected for the mixed witness but extra capacity catches
  // accidental over-emission. pb_reset zero-fills them and writes the
  // input bytes.
  // ==========================================================================
  pub let mut _pb_in_mixed        : [u8; 16] = uninit @align(8)
  pub let mut _pb_out_runs        : [u8; 64] = uninit @align(8)

  // ==========================================================================
  // pb_reset() -> ()
  //
  // Zero every fixture qword and then populate the input buffer
  // byte-by-byte via mov_b with "abcשלום" (0x61 0x62 0x63 0xD7 0xA9 0xD7
  // 0x9C 0xD7 0x95 0xD7 0x9D). Matches tlx_reset / pgc_reset / pnm_reset
  // / pnc_reset / pw_reset's zero-then-write pattern. Leaf; r10 base,
  // rax byte constant. Labels prefixed pb_rs_.
  // ==========================================================================
  pub let pb_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): zero fixture qwords, then populate _pb_in_mixed byte-by-byte with the 11 bytes of 'abcשלום' (61 62 63 D7 A9 D7 9C D7 95 D7 9D). Also zero _pb_out_runs. Matches pw_reset / pnc_reset / pnm_reset / pgc_reset pattern. Leaf; no callee-save. Labels prefixed pb_rs_.",
      block: {
        xor rax, rax;

        // Zero _pb_in_mixed (16 bytes = 2 qwords).
        lea r10, [rip + _pb_in_mixed];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        // Zero _pb_out_runs (64 bytes = 8 qwords).
        lea r10, [rip + _pb_out_runs];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        // Populate _pb_in_mixed: "abcשלום"
        //   61 62 63 D7 A9 D7 9C D7 95 D7 9D
        lea r10, [rip + _pb_in_mixed];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0x62; mov_b [r10 + 1], rax;
        mov rax, 0x63; mov_b [r10 + 2], rax;
        mov rax, 0xD7; mov_b [r10 + 3], rax;
        mov rax, 0xA9; mov_b [r10 + 4], rax;
        mov rax, 0xD7; mov_b [r10 + 5], rax;
        mov rax, 0x9C; mov_b [r10 + 6], rax;
        mov rax, 0xD7; mov_b [r10 + 7], rax;
        mov rax, 0x95; mov_b [r10 + 8], rax;
        mov rax, 0xD7; mov_b [r10 + 9], rax;
        mov rax, 0x9D; mov_b [r10 + 10], rax;

        ret
      }
    }

  // ==========================================================================
  // pb_case_coverage() -> u64
  //
  // Invariant: for the mixed input "abcשלום" (11 bytes), _bidi_runs
  // emits exactly 2 runs that together cover [0, 11) with no gap and
  // no overlap:
  //
  //   run[0] = {byte_start=0, byte_end=3,  class=L (0)}
  //   run[1] = {byte_start=3, byte_end=11, class=R (1)}
  //
  // Checks performed:
  //   - packed return: (runs_emitted << 32) | status
  //     - status (low 8 bits) == 0
  //     - runs_emitted (bits 63:32) == 2
  //   - run[0].byte_start == 0
  //   - run[0].byte_end   == 3
  //   - run[1].byte_start == 3   (== run[0].byte_end -- no gap, no overlap)
  //   - run[1].byte_end   == 11  (== bytes_len)
  //
  // 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: entry rsp%16==8 +
  // 16 (pushes) + 8 (pad) = 32, 32 mod 16 == 0 pre-CALL. Matches
  // pw_case_nonneg / pw_case_additive / pw_case_empty pattern.
  // Labels prefixed pb_cv_.
  // ==========================================================================
  pub let pb_case_coverage : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): coverage invariant for 'abcשלום'. _bidi_runs must emit exactly 2 runs covering [0, 11) with no gap or overlap: run[0]={0,3,L}, run[1]={3,11,R}. 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: 8+16+8=32, 32 mod 16=0 pre-CALL. Labels prefixed pb_cv_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pb_reset;

        // _bidi_runs(_pb_in_mixed, 11, _pb_out_runs, 4)
        lea rdi, [rip + _pb_in_mixed];
        mov rsi, 11;
        lea rdx, [rip + _pb_out_runs];
        mov rcx, 4;
        call _bidi_runs;

        // Status (low 8 bits) must be 0.
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pb_cv_fail;

        // runs_emitted (bits 63:32) must be 2.
        shr rax, 32;
        cmp rax, 2;
        jne pb_cv_fail;

        // Inspect run[0] at _pb_out_runs + 0.
        lea r10, [rip + _pb_out_runs];
        // qword 0 of run[0] = (byte_end << 32) | byte_start.
        mov rbx, [r10 + 0];
        // Low 32 = byte_start == 0.
        mov r12, rbx;
        and r12, 0xFFFFFFFF;
        cmp r12, 0;
        jne pb_cv_fail;
        // High 32 = byte_end == 3.
        shr rbx, 32;
        cmp rbx, 3;
        jne pb_cv_fail;

        // Inspect run[1] at _pb_out_runs + 16.
        mov rbx, [r10 + 16];
        // Low 32 = byte_start == 3  (== run[0].byte_end: no gap).
        mov r12, rbx;
        and r12, 0xFFFFFFFF;
        cmp r12, 3;
        jne pb_cv_fail;
        // High 32 = byte_end == 11 (== bytes_len).
        shr rbx, 32;
        cmp rbx, 11;
        jne pb_cv_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pb_cv_fail:
        mov rax, 0xFFFFEDC1;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pb_case_nonempty() -> u64
  //
  // Invariant: every emitted run has byte_end > byte_start. The aggregator
  // never produces an empty run (one with byte_end == byte_start) because
  // a new run is initialised only on the first cluster of a new class
  // (byte_start = cursor at that point) and extended per cluster
  // (byte_end moves forward); byte_end at flush time is always strictly
  // greater than byte_start. Witness: "abcשלום" -- both runs have end >
  // start (3 > 0 and 11 > 3).
  //
  // 2 callee-save pushes (rbx, r12) + sub rsp 8 pad. Labels prefixed pb_ne_.
  // ==========================================================================
  pub let pb_case_nonempty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): non-empty invariant for 'abcשלום'. _bidi_runs must emit 2 runs each with byte_end > byte_start. Pulls run[0] and run[1] from _pb_out_runs, checks both. 2 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pb_ne_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pb_reset;

        lea rdi, [rip + _pb_in_mixed];
        mov rsi, 11;
        lea rdx, [rip + _pb_out_runs];
        mov rcx, 4;
        call _bidi_runs;

        // Status must be 0 for the invariant to be testable.
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pb_ne_fail;

        // runs_emitted must be 2.
        shr rax, 32;
        cmp rax, 2;
        jne pb_ne_fail;

        // Check run[0]: byte_end (high 32) > byte_start (low 32).
        lea r10, [rip + _pb_out_runs];
        mov rbx, [r10 + 0];
        mov r12, rbx;
        and r12, 0xFFFFFFFF;        // byte_start
        shr rbx, 32;                // byte_end
        cmp rbx, r12;
        jbe pb_ne_fail;             // byte_end <= byte_start -> fail

        // Check run[1]: byte_end > byte_start.
        mov rbx, [r10 + 16];
        mov r12, rbx;
        and r12, 0xFFFFFFFF;
        shr rbx, 32;
        cmp rbx, r12;
        jbe pb_ne_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pb_ne_fail:
        mov rax, 0xFFFFEDC2;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pb_case_monotone() -> u64
  //
  // Invariant: consecutive runs always have different class values. If
  // run[i].class == run[i+1].class, the aggregator should have extended
  // instead of flushing + starting a new run. Witness: "abcשלום" --
  // run[0].class == 0 (L) and run[1].class == 1 (R); 0 != 1 so the
  // invariant holds.
  //
  // 2 callee-save pushes + sub rsp 8 pad. Labels prefixed pb_mn_.
  // ==========================================================================
  pub let pb_case_monotone : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): monotone-class invariant for 'abcשלום'. _bidi_runs must emit 2 runs whose class values differ; run[0].class = L (0), run[1].class = R (1), 0 != 1. Reads class byte at run_offset+8 (low byte of qword 1). 2 callee-save pushes + sub rsp 8 pad. Labels prefixed pb_mn_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pb_reset;

        lea rdi, [rip + _pb_in_mixed];
        mov rsi, 11;
        lea rdx, [rip + _pb_out_runs];
        mov rcx, 4;
        call _bidi_runs;

        // Status must be 0.
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;
        jne pb_mn_fail;

        // runs_emitted must be 2.
        shr rax, 32;
        cmp rax, 2;
        jne pb_mn_fail;

        // Read run[0].class at _pb_out_runs + 8 (low byte of qword 1).
        lea r10, [rip + _pb_out_runs];
        mov rbx, [r10 + 8];
        and rbx, 0xFF;

        // Read run[1].class at _pb_out_runs + 24.
        mov r12, [r10 + 24];
        and r12, 0xFF;

        // Classes must differ.
        cmp rbx, r12;
        je pb_mn_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pb_mn_fail:
        mov rax, 0xFFFFEDC3;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pb_run_all() -> u64
  //
  // Umbrella driver: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PB_PASS). Mirrors pw_run_all,
  // pnc_run_all, pnm_run_all, pgc_run_all, tsf_run_all.
  //
  // 1 push (rbx) + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed
  // pb_all_.
  // ==========================================================================
  pub let pb_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): umbrella driver. Call each pb_case_* in order, return the first non-zero fail code. 1 push + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed pb_all_.",
      block: {
        push rbx;
        sub rsp, 8;

        call pb_case_coverage;
        cmp rax, 0;
        jne pb_all_exit;

        call pb_case_nonempty;
        cmp rax, 0;
        jne pb_all_exit;

        call pb_case_monotone;
        cmp rax, 0;
        jne pb_all_exit;

        xor rax, rax;

      pb_all_exit:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

}
