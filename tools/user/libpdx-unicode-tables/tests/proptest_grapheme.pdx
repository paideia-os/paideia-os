// tests/proptest_grapheme.pdx -- libpdx-unicode-tables.M2 (paideia-os#2613)
//
// ProptestGrapheme: five invariant witnesses for `_gc_next` / `_gc_count`.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. The
// paideia-as encoder has no QuickCheck / Hypothesis equivalent, so
// property-based coverage is approximated by picking inputs that
// stress each branch of the state machine.
//
// Five invariants mirror the brief:
//
//   PGC_RT        -- Round-trip: concatenating all span bytes
//                    reproduces the input (every byte is in exactly
//                    one span).
//   PGC_MONO      -- Monotone: for every span, end > start; for
//                    consecutive spans, next.start == prev.end
//                    (no gaps, no overlaps).
//   PGC_COUNT     -- Count agreement: `_gc_count` equals the span
//                    count collected by iterating `_gc_next` to EOF.
//   PGC_EOF       -- EOF status iff cursor == bytes_len: EOF is
//                    returned exactly when the iterator reaches the
//                    end, and never prematurely.
//   PGC_INVALID   -- Invalid UTF-8 propagates: starting from a byte
//                    the UTF-8 layer refuses, `_gc_next` returns
//                    status=2 with no span emitted.
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// Each case uses one of three byte fixtures populated in .bss by
// `pgc_reset` before invocation:
//
//   _pgc_in_ab        "ab"                 (2 bytes)
//   _pgc_in_aacuteB   "a" + U+0301 + "b"   (4 bytes: 61 CC 81 62)
//   _pgc_in_bad       0xFF                 (1 byte: lone 0xFF; UTF-8 refuses)
//   _pgc_in_a         "a"                  (1 byte)
//
// The reset routine zero-fills then writes the fixture bytes one at a
// time via `mov_b`, matching the byte-write pattern established by
// test_lexer.pdx's tlx_reset (shell/tests/test_lexer.pdx L132-L232).
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFED6x)
// =============================================================================
//
//   0            PGC_PASS                 all invariants hold
//   0xFFFFED61   PGC_FAIL_ROUNDTRIP       round-trip reconstruction failed
//   0xFFFFED62   PGC_FAIL_MONOTONE        a span broke monotonicity
//   0xFFFFED63   PGC_FAIL_COUNT           _gc_count disagreed with iteration
//   0xFFFFED64   PGC_FAIL_EOF             EOF status at wrong cursor position
//   0xFFFFED65   PGC_FAIL_INVALID         INVALID_UTF8 not reported where expected
//
// Extends the existing paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme          <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestGrapheme`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 4 (small counts, byte literals,
//     and status codes 0/1/2), so no imm32 staging needed.
//   - r11 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 2 or 3 callee-save pushes + alignment pad for
//     the nested `_gc_next` / `_gc_count` CALLs.
//
// Upstream: paideia-os#2613 (R131.M2 grapheme-cluster iterator).

module ProptestGrapheme = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PGC_PASS                : u64 = 0
  pub let PGC_FAIL_ROUNDTRIP      : u64 = 0xFFFFED61
  pub let PGC_FAIL_MONOTONE       : u64 = 0xFFFFED62
  pub let PGC_FAIL_COUNT          : u64 = 0xFFFFED63
  pub let PGC_FAIL_EOF            : u64 = 0xFFFFED64
  pub let PGC_FAIL_INVALID        : u64 = 0xFFFFED65

  // ==========================================================================
  // Fixture buffers (.bss)
  //
  // Each buffer is sized to the maximum fixture length rounded up to
  // a qword multiple. All four slots live in .bss; `pgc_reset` zero-
  // fills and populates them before each case runs.
  // ==========================================================================
  pub let mut _pgc_in_ab          : [u8; 8]  = uninit @align(8)
  pub let mut _pgc_in_aacuteB     : [u8; 8]  = uninit @align(8)
  pub let mut _pgc_in_bad         : [u8; 8]  = uninit @align(8)
  pub let mut _pgc_in_a           : [u8; 8]  = uninit @align(8)

  // Span buffer (up to 8 pairs of u64 = 128 bytes). Each span pair is
  // (start, end) stored as two consecutive qwords. The iteration
  // helper in each case walks _gc_next, writing collected spans here.
  pub let mut _pgc_spans          : [u8; 128] = uninit @align(8)
  pub let mut _pgc_span_count     : u64       = 0

  // ==========================================================================
  // pgc_reset() -> ()
  //
  // Zero every fixture qword and then populate the four input buffers
  // byte-by-byte. Also zeroes the span buffer and span count. Leaf;
  // r10 base, rax byte constant.
  // ==========================================================================
  pub let pgc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): zero all four fixture buffers plus the span-collection buffer, then populate the four inputs byte-by-byte via mov_b. Matches tlx_reset's zero-then-write-bytes pattern (shell/tests/test_lexer.pdx). Leaf function; no callee-save push. Labels prefixed pgc_rs_.",
      block: {
        // Zero _pgc_in_ab (1 qword).
        xor rax, rax;
        lea r10, [rip + _pgc_in_ab];
        mov [r10 + 0], rax;

        // Zero _pgc_in_aacuteB (1 qword).
        lea r10, [rip + _pgc_in_aacuteB];
        mov [r10 + 0], rax;

        // Zero _pgc_in_bad (1 qword).
        lea r10, [rip + _pgc_in_bad];
        mov [r10 + 0], rax;

        // Zero _pgc_in_a (1 qword).
        lea r10, [rip + _pgc_in_a];
        mov [r10 + 0], rax;

        // Zero _pgc_spans (16 qwords).
        lea r10, [rip + _pgc_spans];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov [r10 + 64], rax;
        mov [r10 + 72], rax;
        mov [r10 + 80], rax;
        mov [r10 + 88], rax;
        mov [r10 + 96], rax;
        mov [r10 + 104], rax;
        mov [r10 + 112], rax;
        mov [r10 + 120], rax;

        // Zero span count.
        lea r10, [rip + _pgc_span_count];
        mov [r10 + 0], rax;

        // Populate _pgc_in_ab: 0x61 0x62 ("ab").
        lea r10, [rip + _pgc_in_ab];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0x62; mov_b [r10 + 1], rax;

        // Populate _pgc_in_aacuteB: 0x61 0xCC 0x81 0x62
        // ("a" + U+0301 combining acute + "b").
        lea r10, [rip + _pgc_in_aacuteB];
        mov rax, 0x61; mov_b [r10 + 0], rax;
        mov rax, 0xCC; mov_b [r10 + 1], rax;
        mov rax, 0x81; mov_b [r10 + 2], rax;
        mov rax, 0x62; mov_b [r10 + 3], rax;

        // Populate _pgc_in_bad: 0xFF (lone high byte; invalid lead).
        lea r10, [rip + _pgc_in_bad];
        mov rax, 0xFF; mov_b [r10 + 0], rax;

        // Populate _pgc_in_a: 0x61 ("a").
        lea r10, [rip + _pgc_in_a];
        mov rax, 0x61; mov_b [r10 + 0], rax;

        ret
      }
    }

  // ==========================================================================
  // pgc_collect_spans(src_ptr, src_len) -> u64
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rax = span count (also written to _pgc_span_count); on
  //         INVALID_UTF8 at the FIRST call, returns 0 and leaves
  //         _pgc_span_count=0 (no spans emitted).
  //
  // Walks _gc_next until EOF, writing each (start, end) pair to
  // _pgc_spans as two consecutive qwords. Mid-cluster INVALID_UTF8
  // (returned as OK with partial cluster) still yields a span. A
  // top-of-loop INVALID_UTF8 breaks WITHOUT appending a span,
  // preserving the "no spans emitted" invariant for all-invalid
  // input.
  //
  // Register plan: rbx=src_ptr, r12=src_len, r13=cursor, r14=span_count.
  // 4 pushes + sub rsp 8 for CALL alignment.
  // ==========================================================================
  pub let pgc_collect_spans : (u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): walk _gc_next from cursor=0 to EOF, writing each (start, end) qword pair to _pgc_spans[16*i, 16*i+16). r15 holds the previous cursor as `start` for the next span write. On INVALID at the first iteration, exit with count=0. 4 pushes + sub rsp 8 for rsp%16==0 pre-CALL. Labels prefixed pgc_col_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;              // src_ptr
        mov r12, rsi;              // src_len
        xor r13, r13;              // cursor = 0
        xor r14, r14;              // span count

      pgc_col_loop_top:
        // Save cursor as `start` for the span we're about to append.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _gc_next;

        // Status in low 8 bits.
        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 1;
        je pgc_col_done;
        cmp rcx, 2;
        je pgc_col_done;              // INVALID: stop without appending

        // OK: next_cursor = rax >> 32. Current span is (r13, next_cursor).
        shr rax, 32;

        // Write span pair: _pgc_spans[16*r14 + 0] = r13 (start);
        //                   _pgc_spans[16*r14 + 8] = rax (end).
        mov r11, r14;
        shl r11, 4;                  // r11 = r14 * 16 (byte offset)
        lea r10, [rip + _pgc_spans];
        add r10, r11;
        mov [r10 + 0], r13;
        mov [r10 + 8], rax;

        // Advance.
        mov r13, rax;
        add r14, 1;
        jmp pgc_col_loop_top;

      pgc_col_done:
        // Publish span count and return it.
        lea r10, [rip + _pgc_span_count];
        mov [r10 + 0], r14;
        mov rax, r14;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_case_roundtrip() -> u64
  //
  // Invariant: concatenating span bytes = input bytes. For "ab",
  // spans must be [(0,1), (1,2)]: byte 0 is 'a' (one cluster), byte
  // 1 is 'b' (another). Round-trip witnessed by checking that the
  // last span's end equals the input length and every span's start
  // is 0 or matches the previous span's end (gap-free coverage).
  //
  // 2 pushes + `sub rsp, 8` for CALL alignment.
  // ==========================================================================
  pub let pgc_case_roundtrip : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): round-trip invariant for 'ab'. Collect spans; assert span_count==2, spans[0]=(0,1), spans[1]=(1,2). Also asserts gap-free coverage: spans[0].end == spans[1].start == 1, and spans[1].end == 2 (= src_len). 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed pgc_rt_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pgc_reset;

        lea rdi, [rip + _pgc_in_ab];
        mov rsi, 2;
        call pgc_collect_spans;

        // Expect span count = 2.
        cmp rax, 2;
        jne pgc_rt_fail;

        // Load spans[0] = (0, 1).
        lea r12, [rip + _pgc_spans];
        mov rax, [r12 + 0];        // spans[0].start
        cmp rax, 0;
        jne pgc_rt_fail;
        mov rax, [r12 + 8];        // spans[0].end
        cmp rax, 1;
        jne pgc_rt_fail;

        // Load spans[1] = (1, 2).
        mov rax, [r12 + 16];
        cmp rax, 1;
        jne pgc_rt_fail;
        mov rax, [r12 + 24];
        cmp rax, 2;
        jne pgc_rt_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pgc_rt_fail:
        mov rax, 0xFFFFED61;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_case_monotone() -> u64
  //
  // Invariant: cluster.end > cluster.start, next.start == prev.end.
  // For "áb" (4 bytes 61 CC 81 62) we expect spans
  // [(0,3), (3,4)]: GB9 glues the combining acute to 'a' producing
  // a 3-byte cluster, then 'b' is its own cluster.
  //
  // The witness also exercises: span[0].end=3 > span[0].start=0,
  // span[1].start=3 == span[0].end=3, span[1].end=4 > span[1].start=3.
  // ==========================================================================
  pub let pgc_case_monotone : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): monotone invariant for 'a + U+0301 + b'. Collect spans; assert span_count==2, spans[0]=(0,3), spans[1]=(3,4), and the consecutive-span contiguity (spans[0].end == spans[1].start). 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed pgc_mo_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pgc_reset;

        lea rdi, [rip + _pgc_in_aacuteB];
        mov rsi, 4;
        call pgc_collect_spans;

        cmp rax, 2;
        jne pgc_mo_fail;

        lea r12, [rip + _pgc_spans];
        // spans[0] = (0, 3)
        mov rax, [r12 + 0];
        cmp rax, 0;
        jne pgc_mo_fail;
        mov rax, [r12 + 8];
        cmp rax, 3;
        jne pgc_mo_fail;

        // spans[1] = (3, 4)
        mov rax, [r12 + 16];
        cmp rax, 3;
        jne pgc_mo_fail;
        mov rax, [r12 + 24];
        cmp rax, 4;
        jne pgc_mo_fail;

        // Contiguity: spans[1].start == spans[0].end
        mov rbx, [r12 + 8];
        mov rax, [r12 + 16];
        cmp rax, rbx;
        jne pgc_mo_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pgc_mo_fail:
        mov rax, 0xFFFFED62;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_case_count() -> u64
  //
  // Invariant: _gc_count agrees with the number of spans produced
  // by iterating _gc_next. For "áb", both must report 2.
  // ==========================================================================
  pub let pgc_case_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): count invariant: _gc_count on 'a + U+0301 + b' returns 2, matching the 2 spans produced by iterating _gc_next. 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed pgc_ct_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pgc_reset;

        // 1) Collect via iteration.
        lea rdi, [rip + _pgc_in_aacuteB];
        mov rsi, 4;
        call pgc_collect_spans;
        mov rbx, rax;              // rbx = iterated span count

        // 2) Call _gc_count.
        lea rdi, [rip + _pgc_in_aacuteB];
        mov rsi, 4;
        call _gc_count;

        // Compare.
        cmp rax, rbx;
        jne pgc_ct_fail;

        // Also verify the actual value (defence against both being wrong).
        cmp rax, 2;
        jne pgc_ct_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pgc_ct_fail:
        mov rax, 0xFFFFED63;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_case_eof() -> u64
  //
  // Invariant: status==EOF iff cursor == bytes_len. Three sub-checks:
  //
  //   (a) _gc_next("a", 1, cursor=0) must return status=OK with
  //       next_cursor=1.
  //   (b) _gc_next("a", 1, cursor=1) must return status=EOF.
  //   (c) _gc_next("", 0, cursor=0) must return status=EOF (empty
  //       input immediate EOF).
  // ==========================================================================
  pub let pgc_case_eof : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): EOF status invariant. (a) cursor=0 on 'a' returns OK with next_cursor=1; (b) cursor=1 on 'a' returns status=1 (EOF); (c) cursor=0 on empty returns status=1. Each sub-check uses the status-in-low-byte and next-cursor-in-high-32 discrimination. 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed pgc_ef_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pgc_reset;

        // (a) cursor=0 on 'a' → OK, next_cursor=1.
        lea rdi, [rip + _pgc_in_a];
        mov rsi, 1;
        mov rdx, 0;
        call _gc_next;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 0;                // status must be OK (0)
        jne pgc_ef_fail;
        shr rax, 32;
        cmp rax, 1;                // next_cursor must be 1
        jne pgc_ef_fail;

        // (b) cursor=1 on 'a' → EOF.
        lea rdi, [rip + _pgc_in_a];
        mov rsi, 1;
        mov rdx, 1;
        call _gc_next;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 1;                // status must be EOF (1)
        jne pgc_ef_fail;

        // (c) empty input → EOF.
        lea rdi, [rip + _pgc_in_a];
        mov rsi, 0;
        mov rdx, 0;
        call _gc_next;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 1;
        jne pgc_ef_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pgc_ef_fail:
        mov rax, 0xFFFFED64;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_case_invalid() -> u64
  //
  // Invariant: INVALID_UTF8 is returned at the seed decode when the
  // byte is unrecoverable, and no spans are emitted (iteration count
  // stays at 0). Also exercises `_gc_count`'s invalid-propagation
  // path: it must return GC_INVALID_UTF8 (0xFFFFE710), not a partial
  // count.
  //
  // Fixture: a single 0xFF byte -- the UTF-8 layer refuses this as
  // either a lead or a continuation (lead class 0xF5..0xFF is BAD_CP).
  // ==========================================================================
  pub let pgc_case_invalid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): invalid-UTF8 propagation. _gc_next on 0xFF with cursor=0 returns status=2 (INVALID_UTF8) and next_cursor=0 (unchanged). pgc_collect_spans on the same input yields span_count=0. _gc_count on the same input returns GC_INVALID_UTF8 (0xFFFFE710). 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed pgc_in_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pgc_reset;

        // (a) _gc_next on 0xFF at cursor=0 → status=2.
        lea rdi, [rip + _pgc_in_bad];
        mov rsi, 1;
        mov rdx, 0;
        call _gc_next;
        mov rbx, rax;
        and rbx, 0xFF;
        cmp rbx, 2;
        jne pgc_in_fail;

        // (b) pgc_collect_spans yields 0 spans.
        lea rdi, [rip + _pgc_in_bad];
        mov rsi, 1;
        call pgc_collect_spans;
        cmp rax, 0;
        jne pgc_in_fail;

        // (c) _gc_count returns GC_INVALID_UTF8 (0xFFFFE710).
        lea rdi, [rip + _pgc_in_bad];
        mov rsi, 1;
        call _gc_count;
        mov r11, 0xFFFFE710;
        cmp rax, r11;
        jne pgc_in_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pgc_in_fail:
        mov rax, 0xFFFFED65;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgc_run_all() -> u64
  //
  // Umbrella: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PGC_PASS) if every case passed.
  // Matches the tsf_run_all / tlx_run_all shape so the boot-time
  // smoke harness can call it from the single top-level loop.
  //
  // 1 push (rbx) + `sub rsp, 8` for CALL alignment.
  // ==========================================================================
  pub let pgc_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): umbrella driver. Call each pgc_case_* in sequence; return the first non-zero fail code. Matches tsf_run_all shape so boot-time smoke harness can invoke it uniformly. 1 push + sub rsp 8 for rsp%16==0 pre-CALL. Labels prefixed pgc_all_.",
      block: {
        push rbx;
        sub rsp, 8;

        call pgc_case_roundtrip;
        cmp rax, 0;
        jne pgc_all_exit;

        call pgc_case_monotone;
        cmp rax, 0;
        jne pgc_all_exit;

        call pgc_case_count;
        cmp rax, 0;
        jne pgc_all_exit;

        call pgc_case_eof;
        cmp rax, 0;
        jne pgc_all_exit;

        call pgc_case_invalid;
        cmp rax, 0;
        jne pgc_all_exit;

        xor rax, rax;

      pgc_all_exit:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

}
