// tests/proptest_locale.pdx -- libpdx-unicode-tables.M7 (paideia-os#2618)
//
// ProptestLocale: three invariant witnesses for the locale-registry
// primitives (`_locale_parse`, `_locale_default`, `_locale_direction`,
// `_locale_width_ambiguous_is_wide`).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// "Proptest" in this .pdx dialect means a witness-driver suite: each
// invariant has one or more hand-chosen inputs that exercise the
// property's edge, and the driver asserts the property holds. Three
// invariants mirror the R131.M7 brief:
//
//   PL_DEFAULT_WELL_DEFINED
//                   -- The default locale has a defined direction. Formally:
//                      `_locale_direction(_locale_default()) == 0 (LTR)`.
//                      Witness: evaluate the two-call composition and
//                      compare against the expected LTR value.
//
//   PL_PARSE_IDEMPOTENT
//                   -- Calling `_locale_parse` twice on the same input
//                      yields identical results. Formally: for every
//                      canonical tag `t` in the registry,
//                      `_locale_parse(t) == _locale_parse(t)`. Witness:
//                      the single tag "en-US" exercises every branch
//                      state (prelude length check, hyphen check, bytes-
//                      to-key assembly, key dispatch) and the invariant
//                      holds iff the parser is a pure function.
//
//   PL_DIRECTION_TOTALITY
//                   -- Every id in [0, 8) returns a direction in {0, 1}.
//                      Formally: for id in 0..7,
//                      `_locale_direction(id) in {0, 1}`. Witness: the
//                      driver iterates the eight baseline ids and
//                      asserts the return is <= 1 for each.
//
// =============================================================================
// FIXTURE INPUTS
// =============================================================================
//
// A single input fixture is shared across the parse-idempotence case:
//
//   _pl_in_en_us    "en-US"   (5 bytes: 65 6E 2D 55 53)
//
// Direction totality and default-well-defined do not need a text input
// fixture: they call `_locale_direction` with a numeric id directly.
//
// =============================================================================
// FAIL-CODE BAND (0xFFFFEDDx)
// =============================================================================
//
//   0            PL_PASS                      all invariants hold
//   0xFFFFEDD1   PL_FAIL_DEFAULT              default locale's direction
//                                             is not LTR (0)
//   0xFFFFEDD2   PL_FAIL_IDEMPOTENT           two calls on the same input
//                                             produced different results
//   0xFFFFEDD3   PL_FAIL_DIRECTION_TOTALITY   locale_direction(id) > 1 for
//                                             some id in [0, 8)
//
// Extends the paideia-os test-fail band family:
//
//   0xFFFFED0x  TestCapsNarrow
//   0xFFFFED1x  TestAuditFirst
//   0xFFFFED2x  TestSmokeMatrix
//   0xFFFFED3x  TestReleaseManifest
//   0xFFFFED4x  TestSyscallFloor
//   0xFFFFED5x  TestLexer
//   0xFFFFED6x  ProptestGrapheme
//   0xFFFFED7x  ProptestNormalize
//   0xFFFFED8x  ProptestCollation
//   0xFFFFED9x  ProptestWidth
//   0xFFFFEDAx  VKBench (disjoint, not a proptest driver)
//   0xFFFFEDBx  VKFeatures (disjoint)
//   0xFFFFEDCx  ProptestBidi
//   0xFFFFEDDx  ProptestLocale              <-- this module
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ProptestLocale`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - All `cmp reg, imm` use imm <= 8 (fixture sizes, status codes,
//     id values 0..7, direction values 0..1), so no imm32 staging is
//     needed; the fail-code constants (0xFFFFEDDx) are mov'd into rax
//     then returned.
//   - r10 scratch for .bss address loads via `lea r10, [rip + sym]`.
//   - Byte writes to fixtures via `mov_b`.
//   - Case entries: 1-2 callee-save pushes + alignment pad for the
//     nested CALLs.
//
// Upstream: paideia-os#2618 (R131.M7 locale registry).

module ProptestLocale = structure {

  // ==========================================================================
  // Fail codes
  // ==========================================================================
  pub let PL_PASS                      : u64 = 0
  pub let PL_FAIL_DEFAULT              : u64 = 0xFFFFEDD1
  pub let PL_FAIL_IDEMPOTENT           : u64 = 0xFFFFEDD2
  pub let PL_FAIL_DIRECTION_TOTALITY   : u64 = 0xFFFFEDD3

  // ==========================================================================
  // Fixture buffer (.bss)
  //
  // 8-byte buffer holds the 5-byte tag "en-US" with three trailing
  // zero bytes. pl_reset zero-fills and writes the five bytes via
  // mov_b. Matches the pw_reset / pb_reset / pnc_reset pattern.
  // ==========================================================================
  pub let mut _pl_in_en_us : [u8; 8] = uninit @align(8)

  // ==========================================================================
  // pl_reset() -> ()
  //
  // Zero the fixture qword, then populate _pl_in_en_us byte-by-byte with
  // the five bytes of "en-US" (0x65 0x6E 0x2D 0x55 0x53). Leaf;
  // r10 base, rax byte constant. Labels prefixed pl_rs_.
  // ==========================================================================
  pub let pl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): zero fixture qword, then populate _pl_in_en_us byte-by-byte with the 5 bytes of 'en-US' (65 6E 2D 55 53). Matches pb_reset / pw_reset / pnc_reset pattern. Leaf; no callee-save. Labels prefixed pl_rs_.",
      block: {
        xor rax, rax;

        // Zero _pl_in_en_us (8 bytes = 1 qword).
        lea r10, [rip + _pl_in_en_us];
        mov [r10 + 0], rax;

        // Populate _pl_in_en_us: "en-US"
        //   65 6E 2D 55 53
        mov rax, 0x65; mov_b [r10 + 0], rax;
        mov rax, 0x6E; mov_b [r10 + 1], rax;
        mov rax, 0x2D; mov_b [r10 + 2], rax;
        mov rax, 0x55; mov_b [r10 + 3], rax;
        mov rax, 0x53; mov_b [r10 + 4], rax;

        ret
      }
    }

  // ==========================================================================
  // pl_case_default() -> u64
  //
  // Invariant PL_DEFAULT_WELL_DEFINED: the default locale's direction is
  // LTR. Formally:
  //
  //   _locale_direction(_locale_default()) == 0
  //
  // Fails with PL_FAIL_DEFAULT (0xFFFFEDD1) otherwise. 1 callee-save
  // push (rbx) + sub rsp 8 pad for rsp%16==0 pre-CALL. Labels prefixed
  // pl_df_.
  // ==========================================================================
  pub let pl_case_default : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): default-well-defined invariant. Compose _locale_direction(_locale_default()) and assert the result is 0 (LTR). Entry rsp%16==8; 1 callee-save push (rbx) brings rsp%16==0 pre-CALL (SysV). No extra pad needed. Labels prefixed pl_df_.",
      block: {
        push rbx;

        // _locale_default() -> rax = 0 (C/POSIX)
        call _locale_default;

        // _locale_direction(rax=0) -> rax must be 0 (LTR)
        mov rdi, rax;
        call _locale_direction;

        cmp rax, 0;
        jne pl_df_fail;

        xor rax, rax;
        pop rbx;
        ret;

      pl_df_fail:
        mov rax, 0xFFFFEDD1;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pl_case_idempotent() -> u64
  //
  // Invariant PL_PARSE_IDEMPOTENT: two parses of the same tag yield
  // identical results. Formally:
  //
  //   _locale_parse("en-US") == _locale_parse("en-US")
  //
  // Both calls must return the same packed u64 (0x100 for "en-US" --
  // locale_id=1, status=0). Fails with PL_FAIL_IDEMPOTENT (0xFFFFEDD2)
  // otherwise.
  //
  // 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: entry rsp%16==8 +
  // 16 (pushes) + 8 (pad) = 32, 32 mod 16 = 0 pre-CALL. Labels prefixed
  // pl_id_.
  // ==========================================================================
  pub let pl_case_idempotent : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): parse-idempotent invariant for 'en-US'. Two calls to _locale_parse(tag_ptr, 5) must return identical packed u64 values. Expected: 0x100 (locale_id=1, status=0) for 'en-US' both times. 2 callee-save pushes (rbx, r12) + sub rsp 8 pad: 8+16+8=32, 32 mod 16=0 pre-CALL. Labels prefixed pl_id_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call pl_reset;

        // First call: _locale_parse(_pl_in_en_us, 5)
        lea rdi, [rip + _pl_in_en_us];
        mov rsi, 5;
        call _locale_parse;
        mov rbx, rax;

        // Second call: _locale_parse(_pl_in_en_us, 5)
        lea rdi, [rip + _pl_in_en_us];
        mov rsi, 5;
        call _locale_parse;
        mov r12, rax;

        // Both results must agree.
        cmp rbx, r12;
        jne pl_id_fail;

        // And both must be the expected value for "en-US" (0x100).
        cmp rbx, 0x100;
        jne pl_id_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      pl_id_fail:
        mov rax, 0xFFFFEDD2;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pl_case_direction_totality() -> u64
  //
  // Invariant PL_DIRECTION_TOTALITY: every id in [0, 8) returns a
  // direction in {0, 1}. Walks the eight baseline ids one by one,
  // calling `_locale_direction(id)` on each, and asserting the return
  // is <= 1.
  //
  // Fails with PL_FAIL_DIRECTION_TOTALITY (0xFFFFEDD3) on the first
  // id whose direction is > 1.
  //
  // 1 callee-save push (rbx) for the iteration counter: entry
  // rsp%16==8, after push rsp%16==0 pre-CALL (SysV). No pad needed.
  // Labels prefixed pl_dt_.
  // ==========================================================================
  pub let pl_case_direction_totality : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): direction-totality invariant over [0, 8). For each id 0..7 call _locale_direction(id) and assert return <= 1. Entry rsp%16==8; push rbx (rsp%16=0); call _locale_direction keeps rsp%16==0 pre-CALL. No pad needed. Labels prefixed pl_dt_.",
      block: {
        push rbx;

        xor rbx, rbx;              // rbx = i = 0

      pl_dt_loop:
        cmp rbx, 8;
        jae pl_dt_pass;

        mov rdi, rbx;
        call _locale_direction;

        cmp rax, 1;
        ja  pl_dt_fail;            // > 1 is a totality violation

        add rbx, 1;
        jmp pl_dt_loop;

      pl_dt_pass:
        xor rax, rax;
        pop rbx;
        ret;

      pl_dt_fail:
        mov rax, 0xFFFFEDD3;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pl_run_all() -> u64
  //
  // Umbrella driver: run every case in declaration order and return the
  // first non-zero fail code, or 0 (PL_PASS). Mirrors pb_run_all,
  // pw_run_all, pnc_run_all, pnm_run_all, pgc_run_all, tsf_run_all.
  //
  // Entry rsp%16==8; 1 push (rbx) leaves rsp%16==0 pre-CALL. Labels
  // prefixed pl_all_.
  // ==========================================================================
  pub let pl_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): umbrella driver. Call each pl_case_* in order, return the first non-zero fail code. Entry rsp%16==8; 1 push rbx -> rsp%16==0 pre-CALL. Labels prefixed pl_all_.",
      block: {
        push rbx;

        call pl_case_default;
        cmp rax, 0;
        jne pl_all_exit;

        call pl_case_idempotent;
        cmp rax, 0;
        jne pl_all_exit;

        call pl_case_direction_totality;
        cmp rax, 0;
        jne pl_all_exit;

        xor rax, rax;

      pl_all_exit:
        pop rbx;
        ret
      }
    }

}
