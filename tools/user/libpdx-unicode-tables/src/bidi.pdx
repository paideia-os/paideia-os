// src/bidi.pdx -- libpdx-unicode-tables.M6 (paideia-os#2617, R131.M6)
//
// Bidi: user-space UAX #9 (Unicode Bidirectional Algorithm) run-level
// classifier over UTF-8.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of what every terminal / shell / pds
// consumer needs when it has to answer "what directional runs does this
// string decompose into, so I can reorder them for display on a
// left-to-right monospace grid?". Two public entry points:
//
//   _bidi_class(cp)                                          -> u64
//   _bidi_runs(bytes_ptr, bytes_len, out_runs_ptr, out_cap)  -> packed_u64
//
// `_bidi_class` returns one of five reduced BIDI_CLASS values:
//
//   0 = L   (Left-to-Right)        -- Latin, Greek, Cyrillic (reduced)
//   1 = R   (Right-to-Left)        -- Hebrew, Arabic letters, Pres Forms
//   2 = N   (Neutral / Other)      -- default fallback
//   3 = AN  (Arabic Number)        -- Arabic-Indic digit scripts
//   4 = EN  (European Number)      -- ASCII digits
//
// `_bidi_runs` iterates the input grapheme cluster by grapheme cluster
// via `_gc_next`, classifies the first code point of each cluster via
// `_bidi_class`, and groups consecutive clusters of the same class into
// MONOTONE RUNS. Each run entry is 16 bytes:
//
//   offset 0..3  : byte_start   (u32, LE) -- start of run in input
//   offset 4..7  : byte_end     (u32, LE) -- one past end of run
//   offset 8     : class        (u8)      -- 0=L, 1=R, 2=N, 3=AN, 4=EN
//   offset 9..15 : padding      (u8[7])   -- zeroed
//
// The 16-byte entry size matches a cache line divisor and lets the
// caller (shell prompt renderer, pds text column, GPU terminal) index
// into `out_runs_ptr` with `shl i, 4` and interpret the two qwords
// directly.
//
// Return shape of `_bidi_runs`:
//
//   bits [63:32]  runs_emitted  (0..out_cap)
//   bits [7:0]    status        (0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8)
//   bits [31:8]   reserved      (always 0)
//
// On OUT_TOO_SMALL the runs_emitted field reflects the number of runs
// SUCCESSFULLY WRITTEN before capacity was exhausted; on INVALID_UTF8
// the field reflects runs committed up to (but not including) the run
// that would have contained the malformed byte (i.e. the current open
// run is NOT flushed on INVALID -- the partial content is discarded,
// matching utf8_count_cp's `wc -m`-style refusal and keeping the
// invariant "an emitted run always ends at a valid cluster boundary").
//
// =============================================================================
// REDUCED UAX #9 BIDI_CLASS TABLE (R131.M6 Latin + Arabic/Hebrew baseline)
// =============================================================================
//
// The full UAX #9 BIDI_CLASS property set is 23 classes across ~140,000
// code points in Unicode 15.1.0 (L, R, AL, EN, ES, ET, AN, CS, NSM,
// BN, B, S, WS, ON, LRE, LRO, RLE, RLO, PDF, LRI, RLI, FSI, PDI). For
// the R131.M6 baseline this file encodes a REDUCED FIVE-CLASS subset
// sufficient for shell / pds / terminal run-level reordering on the
// text consumer sites encounter today:
//
// L (0) -- Left-to-Right:
//
//   * U+0041..U+005A         ASCII uppercase (A..Z)
//   * U+0061..U+007A         ASCII lowercase (a..z)
//   * U+00C0..U+00FF         Latin-1 Supplement letters (and the two
//                            algebraic signs U+00D7 ×, U+00F7 ÷; in the
//                            full UCD these are class ON, but at M6
//                            the reduced table treats the entire block
//                            as L -- see Further Work for M6.1 refinement)
//   * U+0100..U+024F         Latin Extended-A + Latin Extended-B
//
// R (1) -- Right-to-Left:
//
//   * U+0590..U+05FF         Hebrew (letters, punctuation, cantillation
//                            marks; in the full UCD cantillation marks
//                            are class NSM but at M6 the whole block
//                            is R -- see Further Work for M6.1)
//   * U+0600..U+06FF         Arabic block except digits (which are AN
//                            and must be peeled BEFORE this range check
//                            fires; see the classifier ordering below).
//                            In the full UCD Arabic letters are class
//                            AL and get R-direction resolution; the
//                            M6 baseline folds AL into R for simplicity.
//   * U+FB50..U+FDFF         Arabic Presentation Forms-A (ligatures and
//                            contextual-form variants)
//
// AN (3) -- Arabic Number:
//
//   * U+0660..U+0669         Arabic-Indic digits (٠..٩)
//   * U+06F0..U+06F9         Extended Arabic-Indic digits (۰..۹;
//                            Persian / Urdu locale)
//
// EN (4) -- European Number:
//
//   * U+0030..U+0039         ASCII digits (0..9)
//
// N (2) -- Neutral / Other (default fallback):
//
//   Every code point not covered by the four sets above. This includes
//   ASCII space + punctuation, Latin-1 non-letter cps outside U+00C0..FF,
//   Greek (U+0370..03FF), Cyrillic (U+0400..04FF), every CJK block,
//   emoji, combining marks outside the Hebrew/Arabic ranges, control
//   characters, and every supplementary-plane cp.
//
// AMBIGUOUS CLASSES NOT YET SPLIT (treated as N at M6; M6.1 refines):
//
//   * ES  (European Separator: U+002B +, U+002D -)         -> N
//   * ET  (European Terminator: U+0024 $, U+0025 %, U+00A2 ¢, ...) -> N
//   * CS  (Common Separator: U+002C ,, U+002E ., U+003A :)  -> N
//   * NSM (Non-Spacing Mark: combining marks)               -> N (unless
//                                                            inside Hebrew
//                                                            or Arabic
//                                                            block)
//   * BN  (Boundary Neutral: ZWJ, ZWNJ, format chars)       -> N
//   * B   (Paragraph Separator: U+2029)                      -> N
//   * S   (Segment Separator: TAB)                           -> N
//   * WS  (Whitespace: U+0020, U+00A0, U+2028)               -> N
//   * ON  (Other Neutral: brackets, math symbols, pictos)    -> N
//
// =============================================================================
// RUN AGGREGATION ALGORITHM
// =============================================================================
//
// `_bidi_runs` is a one-pass streaming aggregator. State across loop
// iterations:
//
//   cursor         -- byte offset into bytes_ptr (next cluster to read)
//   run_start      -- byte offset at which the current run began
//   run_class      -- BIDI_CLASS of the current run (0xFF = no run yet)
//   runs_emitted   -- number of 16-byte runs already written to out_runs
//
// Per iteration:
//
//   1. If cursor == bytes_len, break out of loop (flush final run if any).
//   2. Call _gc_next to advance by one grapheme cluster.
//      - EOF  (status=1): break (flush).
//      - INVALID (status=2): return (runs_emitted << 32) | 2 without
//        flushing (invariant: emitted runs always end at a valid
//        cluster boundary).
//      - OK (status=0): save next_cursor on stack; proceed to classify.
//   3. Call utf8_decode_cp on the first byte of the cluster to get cp.
//      Defensive fallback: on any decode-band value, treat the cluster
//      as class N (shouldn't fire; _gc_next and utf8_decode_cp share
//      the same decoder).
//   4. Call _bidi_class(cp).
//   5. If run_class == 0xFF (no current run), initialise:
//        run_class := new_class
//        run_start := cursor
//   6. Else if new_class != run_class, flush the current run and start
//      a new one:
//        - Capacity check: if runs_emitted == out_cap, return
//          (runs_emitted << 32) | 1 (OUT_TOO_SMALL).
//        - Write 16-byte entry at out_runs[runs_emitted]:
//            qword 0 = (cursor << 32) | run_start   (byte_end << 32 | byte_start)
//            qword 1 = run_class                     (class in low byte)
//        - runs_emitted += 1
//        - run_class := new_class
//        - run_start := cursor
//   7. Else (new_class == run_class), extend: no new run; the current
//      run's end implicitly grows to include this cluster.
//   8. cursor := next_cursor; loop.
//
// On exit (EOF or cursor == bytes_len):
//   If run_class != 0xFF, flush the final run with byte_end == cursor
//   (which == bytes_len at EOF). This produces (runs_emitted << 32) | 0.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// _bidi_class returns a u64 in {0, 1, 2, 3, 4}. No error band -- the
// caller has already decoded the cp, so a class-of-a-known-cp call
// cannot fail.
//
// _bidi_runs returns a packed u64:
//
//   bits [63:32]  runs_emitted  (0..out_cap)
//   bits [7:0]    status        (0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8)
//   bits [31:8]   reserved      (always 0)
//
// On OUT_TOO_SMALL the runs_emitted field is the number of runs
// successfully written before capacity ran out; the caller should
// re-invoke with a larger buffer. The partial content is COMMITTED
// (not atomic) -- this diverges from _norm_nfX / _coll_sort_key
// which emit atomically; for runs, partial content is useful (the
// caller can resume from byte_end of the last committed run).
//
// On INVALID_UTF8 the runs_emitted field reflects runs committed
// BEFORE the malformed byte; the current open run (bytes between
// its byte_start and the malformed byte) is DISCARDED. This keeps
// the invariant "every emitted run ends at a valid cluster boundary"
// and lets a caller safely interpret the partial output.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the only masks used (0xFF for status
//     extraction and class discrimination) fit imm32 sign-safe.
//   - No 2-op `imul r, imm`; the per-run output offset uses shift
//     (`shl r11, 4` -- stride 16 bytes), never multiply.
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Bidi` matches `bidi.pdx` (verified at write-time).
//   - Labels prefixed `bidi_` (never `loop`/`if`/`let`/`fn` -- reserved).
//   - All `cmp reg, imm` immediates <= 0xFDFF (Arabic Pres Forms-A
//     upper bound); all values are positive and well under 0x7FFFFFFF,
//     so direct `cmp reg, imm` is sign-extension-safe
//     (imm == (imm as i32 as i64)). No MOVABS staging needed.
//   - All byte loads via `mov_b` where applicable (this module does no
//     direct byte load of input; utf8_decode_cp / _gc_next do the byte
//     reads). Output writes are qword-granular (two qwords per 16-byte
//     run entry) so no byte writes either.
//   - Entry rsp%16==8 preserved per SysV; nested-CALL rsp%16==0
//     enforced through push count parity + stack-scratch pad (see
//     per-function headers).
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// FURTHER WORK (not landed here; tracked in STATUS.md + design doc)
// =============================================================================
//
//   M6.1  Full UAX #9 BIDI_CLASS split. Add the 18 remaining classes
//         (AL distinct from R, NSM carved out of Hebrew/Arabic, ES/ET/CS
//         for European number clustering, ON for brackets and math,
//         WS/BN/B/S for whitespace and separators). The current five-
//         class reduction is enough for Latin + Arabic + Hebrew runs
//         but not for the per-paragraph reordering TR#9 §3.3 defines.
//   M6.2  Paragraph-level resolution (TR#9 §P1). Determine paragraph
//         direction (sot) from the first strong character, then run
//         the full P1..P3 algorithm. The current `_bidi_runs` emits
//         raw class-grouped runs; a caller can approximate paragraph
//         direction by inspecting the first non-N run.
//   M6.3  Explicit directional embeddings LRE / RLE / LRO / RLO / PDF
//         / LRI / RLI / FSI / PDI (TR#9 §3.3.2). Needed for mixed-
//         direction nested content. The M6 baseline treats these as
//         N (they are rare in terminal input today).
//   M6.4  Mirroring pairs (TR#9 §3.4). Brackets and other paired
//         characters mirror when inside an RTL run. Needs the UCD
//         BidiMirroring.txt pair table.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (M1 UTF-8), paideia-os#2613 (M2 grapheme), paideia-os#2614 (M3
// normalize), paideia-os#2615 (M4 collation), paideia-os#2616 (M5
// width), paideia-os#2617 (THIS M6 ticket). Design doc:
// design/toolchain/libpdx-unicode-bidi.md.

module Bidi = structure {

  // ==========================================================================
  // SECTION 1 -- BIDI CLASS CONSTANTS (returned by _bidi_class)
  // ==========================================================================
  //
  // Five values at M6. The reduced subset covers L, R, N, AN, EN; the
  // other 18 UAX #9 classes land at M6.1+. The constants are small
  // non-negative integers packed into the low byte of a u64; a byte
  // of class value fits in the 16-byte run entry's class slot without
  // any encoding.

  pub let BIDI_L   : u64 = 0
  pub let BIDI_R   : u64 = 1
  pub let BIDI_N   : u64 = 2
  pub let BIDI_AN  : u64 = 3
  pub let BIDI_EN  : u64 = 4

  // Sentinel used internally by _bidi_runs to signal "no current run
  // yet" at the start of the loop (before the first cluster is read)
  // and used nowhere else. Not exported; a public consumer never sees
  // this value in a run entry's class slot.

  pub let BIDI_SENTINEL_NONE : u64 = 0xFF

  // ==========================================================================
  // SECTION 2 -- STATUS CODES (returned in low 8 bits of _bidi_runs's rax)
  // ==========================================================================
  //
  // Three disjoint values at M6. Status fits comfortably in a byte;
  // the low 8 bits of the return are reserved to leave room for future
  // sub-status flags (e.g. BIDI_PARAGRAPH_RTL at M6.2 once paragraph-
  // level resolution lands). At M6 only the low 8 bits are non-zero
  // and the high 24 of the status word are zero on every success and
  // error.

  pub let BIDI_STATUS_OK           : u64 = 0
  pub let BIDI_STATUS_OUT_TOO_SMALL : u64 = 1
  pub let BIDI_STATUS_INVALID_UTF8 : u64 = 2

  // ==========================================================================
  // SECTION 3 -- ERROR BAND 0xFFFFE760..0xFFFFE76F (M6, bidi)
  // ==========================================================================
  //
  // Sixth 16-wide aligned user-space error-code slice taken by this
  // library (R131.M6, paideia-os#2617). Jumps over the M5 slice
  // (0xFFFFE750..0xFFFFE75F; last used slot W_INVALID_UTF8 at
  // 0xFFFFE750). Two slots used at M6; the remaining 14 slots are
  // reserved for later bidi-layer error kinds (e.g.
  // BIDI_PARAGRAPH_UNKNOWN once paragraph-level resolution lands at
  // M6.2). Disjoint from every other user-space band in the
  // paideia-os tree. Grep confirmation at M6 landing time:
  //
  //   grep -rE '0xFFFFE76[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no hits outside this file + caps.decl.
  //
  // The internal band values are documented constants but the public
  // API never returns them raw: it packs the status code (0/1/2) into
  // the low 8 bits of the result, matching the _norm_nf{c,d,kc,kd} /
  // _coll_sort_key / _width_str convention.

  pub let BIDI_INVALID_UTF8    : u64 = 0xFFFFE760
  pub let BIDI_OUT_TOO_SMALL   : u64 = 0xFFFFE761

  // ==========================================================================
  // _bidi_class(cp) -> class
  //
  //   rdi = cp (0..U+10FFFF; caller promises a successfully-decoded
  //         code point -- this function makes no range check for the
  //         surrogate half or > U+10FFFF, since utf8_decode_cp /
  //         _gc_next already rejected those at the UTF-8 layer).
  //   rax = class in {0 (L), 1 (R), 2 (N), 3 (AN), 4 (EN)}
  //
  // Straight-line range-dispatch classifier. Each branch tests one
  // range; on match it returns the class; on miss it falls through
  // to the next range. Order matters for the Arabic block:
  // the AN digit ranges (U+0660..U+0669, U+06F0..U+06F9) must be
  // peeled BEFORE the generic R band U+0600..U+06FF, because the
  // digits are nested inside the Arabic block and would otherwise
  // classify as R.
  //
  // Leaf function. No callee-save push. All scratch is caller-save
  // (rax). Labels prefixed bidi_c_.
  // ==========================================================================
  pub let _bidi_class : (u64) -> u64 !{} @{} =
    fn (cp: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): _bidi_class maps a decoded UTF-8 code point to its UAX #9 reduced BIDI_CLASS value. Range dispatch across 10 ranges in BMP: EN U+0030..0039, L U+0041..005A, L U+0061..007A, L U+00C0..00FF, L U+0100..024F, R U+0590..05FF, AN U+0660..0669 (peeled from Arabic R block), AN U+06F0..06F9 (peeled), R U+0600..06FF (rest of Arabic block), R U+FB50..FDFF (Arabic Pres Forms-A); fallthrough N (2). Order: AN peeled before R so Arabic-Indic digits classify as AN not R. All compare values are <= 0xFDFF < 0x7FFFFFFF so `cmp rdi, imm` direct is sign-extension-safe (imm == (imm as i32 as i64)). No test; no and-imm64; no imul; no byte load. Leaf; no callee-save push; no stack frame. Labels prefixed bidi_c_.",
      block: {
        // ---- EN: ASCII digits U+0030..0039 ----
        cmp rdi, 0x0030;
        jb bidi_c_sk_en;
        cmp rdi, 0x0039;
        ja bidi_c_sk_en;
        mov rax, 4;
        ret;

      bidi_c_sk_en:
        // ---- L: ASCII uppercase U+0041..005A ----
        cmp rdi, 0x0041;
        jb bidi_c_sk_up;
        cmp rdi, 0x005A;
        ja bidi_c_sk_up;
        xor rax, rax;
        ret;

      bidi_c_sk_up:
        // ---- L: ASCII lowercase U+0061..007A ----
        cmp rdi, 0x0061;
        jb bidi_c_sk_lo;
        cmp rdi, 0x007A;
        ja bidi_c_sk_lo;
        xor rax, rax;
        ret;

      bidi_c_sk_lo:
        // ---- L: Latin-1 Supplement letters U+00C0..00FF ----
        cmp rdi, 0x00C0;
        jb bidi_c_sk_l1;
        cmp rdi, 0x00FF;
        ja bidi_c_sk_l1;
        xor rax, rax;
        ret;

      bidi_c_sk_l1:
        // ---- L: Latin Extended-A + Latin Extended-B U+0100..024F ----
        cmp rdi, 0x0100;
        jb bidi_c_sk_le;
        cmp rdi, 0x024F;
        ja bidi_c_sk_le;
        xor rax, rax;
        ret;

      bidi_c_sk_le:
        // ---- R: Hebrew U+0590..05FF ----
        cmp rdi, 0x0590;
        jb bidi_c_sk_he;
        cmp rdi, 0x05FF;
        ja bidi_c_sk_he;
        mov rax, 1;
        ret;

      bidi_c_sk_he:
        // ---- AN: Arabic-Indic digits U+0660..0669 (peel from Arabic R block) ----
        cmp rdi, 0x0660;
        jb bidi_c_sk_ad1;
        cmp rdi, 0x0669;
        ja bidi_c_sk_ad1;
        mov rax, 3;
        ret;

      bidi_c_sk_ad1:
        // ---- AN: Extended Arabic-Indic digits U+06F0..06F9 (peel) ----
        cmp rdi, 0x06F0;
        jb bidi_c_sk_ad2;
        cmp rdi, 0x06F9;
        ja bidi_c_sk_ad2;
        mov rax, 3;
        ret;

      bidi_c_sk_ad2:
        // ---- R: Arabic block U+0600..06FF (rest; digits already peeled) ----
        cmp rdi, 0x0600;
        jb bidi_c_sk_ar;
        cmp rdi, 0x06FF;
        ja bidi_c_sk_ar;
        mov rax, 1;
        ret;

      bidi_c_sk_ar:
        // ---- R: Arabic Presentation Forms-A U+FB50..FDFF ----
        cmp rdi, 0xFB50;
        jb bidi_c_default;
        cmp rdi, 0xFDFF;
        ja bidi_c_default;
        mov rax, 1;
        ret;

      bidi_c_default:
        // ---- N: default fallback (every cp not matched above) ----
        mov rax, 2;
        ret;
      }
    }

  // ==========================================================================
  // _bidi_runs(bytes_ptr, bytes_len, out_runs_ptr, out_cap) -> packed_u64
  //
  //   rdi = bytes_ptr    -- input UTF-8 byte buffer
  //   rsi = bytes_len    -- input length in bytes
  //   rdx = out_runs_ptr -- output buffer (16-byte-aligned recommended)
  //   rcx = out_cap      -- capacity of out_runs in NUMBER OF RUNS (not bytes)
  //   rax = (runs_emitted << 32) | status
  //         status in {0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8}
  //
  // Walks the input one grapheme cluster at a time via _gc_next.
  // Per cluster: decodes the base cp via utf8_decode_cp, classifies
  // via _bidi_class, and either initialises the current run (first
  // cluster), extends it (same class), or flushes it + starts a new
  // one (different class). On EOF or exhausted input, flushes the
  // final run.
  //
  // Each run entry occupies 16 bytes:
  //
  //   qword 0 (offset 0..7):   bits [31:0]  = byte_start (u32 LE)
  //                            bits [63:32] = byte_end   (u32 LE)
  //   qword 1 (offset 8..15):  bits [7:0]   = class      (u8)
  //                            bits [63:8]  = padding    (zeros)
  //
  // Written via two qword stores: `mov [out_runs + i*16 + 0], qw0`
  // and `mov [out_runs + i*16 + 8], qw1`.
  //
  // Register plan (5 callee-save pushes + 32-byte stack scratch):
  //   rbx    = bytes_ptr   (callee-save, preserved across every CALL)
  //   r12    = bytes_len   (callee-save)
  //   r13    = cursor      (callee-save; mutates across loop)
  //   r14    = out_runs_ptr (callee-save)
  //   r15    = out_cap     (callee-save; in NUMBER OF RUNS)
  //
  // Stack scratch (32 bytes = four qwords):
  //   [rsp+0]  = run_start     (byte offset in input where current run began)
  //   [rsp+8]  = current_class (0xFF = no run yet; else 0..4)
  //   [rsp+16] = runs_emitted  (count of runs committed so far)
  //   [rsp+24] = next_cursor   (saved across utf8_decode_cp + _bidi_class CALLs)
  //
  // Alignment: entry rsp%16==8; five 8-byte pushes shift rsp by 40 bytes
  // -> (8 + 40) mod 16 = 48 mod 16 = 0. Then sub rsp, 32 -> rsp%16==0.
  // Matches SysV requirement for every nested CALL (_gc_next,
  // utf8_decode_cp, _bidi_class).
  //
  // Labels prefixed bidi_r_.
  // ==========================================================================
  pub let _bidi_runs : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_runs_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M6 (#2617): _bidi_runs walks input one grapheme cluster at a time via _gc_next, classifies first cp of each cluster via _bidi_class (defensive fallback to N on utf8_decode_cp error-band), and aggregates consecutive same-class clusters into monotone runs. Each run entry is 16 bytes: qword0=(byte_end<<32)|byte_start, qword1=class in low byte. Return (runs_emitted<<32)|status with status 0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8. OUT_TOO_SMALL commits partial output (caller resumes from last byte_end); INVALID_UTF8 discards the current open run (invariant: emitted runs always end at valid cluster boundary). 5 callee-save pushes (rbx, r12, r13, r14, r15) + sub rsp 32: entry rsp%16==8 + 40 + 32 = 80, 80 mod 16 = 0 pre-CALL (SysV). Status mask 0xFF fits imm32. Index-to-offset via `shl r11, 4` (stride 16, no imul). Sentinel 0xFF fits imm32. All cmp immediates <= 4 (status codes, class values, bytes_consumed sentinel). No test; no and-imm64; no imul-r-imm; no byte load; no byte write. Labels prefixed bidi_r_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rdi;              // rbx = bytes_ptr
        mov r12, rsi;              // r12 = bytes_len
        mov r14, rdx;              // r14 = out_runs_ptr
        mov r15, rcx;              // r15 = out_cap

        xor r13, r13;              // r13 = cursor = 0

        // Initialise stack scratch:
        //   run_start     = 0
        //   current_class = 0xFF (sentinel: no current run)
        //   runs_emitted  = 0
        //   next_cursor   = 0 (will be overwritten per loop)
        xor rax, rax;
        mov [rsp + 0], rax;         // run_start = 0
        mov [rsp + 16], rax;        // runs_emitted = 0
        mov [rsp + 24], rax;        // next_cursor = 0 (scratch)
        mov rax, 0xFF;
        mov [rsp + 8], rax;         // current_class = sentinel

      bidi_r_loop_top:
        // ---- EOF check (cursor >= bytes_len) ----
        cmp r13, r12;
        jae bidi_r_flush;

        // ---- _gc_next(bytes_ptr, bytes_len, cursor) ----
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _gc_next;

        // Extract status (low 8 bits).
        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 1;
        je bidi_r_flush;           // EOF: flush final run (if any) and exit OK
        cmp rcx, 2;
        je bidi_r_invalid;         // INVALID: discard open run, exit status=2

        // OK: save next_cursor for use after the inner CALLs.
        mov rdx, rax;
        shr rdx, 32;
        mov [rsp + 24], rdx;        // next_cursor saved

        // ---- utf8_decode_cp(bytes_ptr + cursor, bytes_len - cursor) ----
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Discriminate via bits [31:24] of packed return: 1..4 on
        // success, 0xFF on error band. See src/utf8.pdx "Caller
        // discrimination idiom".
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja bidi_r_defclass;         // defensive fallback: use class N (2)

        // cp = rax >> 32; call _bidi_class(cp).
        mov rdi, rax;
        shr rdi, 32;
        call _bidi_class;
        jmp bidi_r_haveclass;

      bidi_r_defclass:
        // Defensive fallback: _gc_next said this cluster starts at a
        // valid cp but utf8_decode_cp disagreed. Treat the cluster as
        // class N (neutral, no bidi effect) and keep going. Current
        // M6 cannot exercise this path (_gc_next and utf8_decode_cp
        // share the same decoder).
        mov rax, 2;

      bidi_r_haveclass:
        // rax = new_class in {0..4}; next_cursor at [rsp+24].

        // Load current_class from stack.
        mov rcx, [rsp + 8];
        cmp rcx, 0xFF;
        je bidi_r_init_run;         // no current run: initialise

        cmp rax, rcx;
        je bidi_r_extend;           // same class: extend (no emit)

        // ---- Class differs: flush current run then start new ----
        // Capacity check: runs_emitted < out_cap?
        mov r11, [rsp + 16];
        cmp r11, r15;
        jae bidi_r_too_small;

        // Compute output offset: r11 * 16 (shl r11, 4).
        // Preserve runs_emitted in rcx for post-increment.
        mov rcx, r11;
        shl rcx, 4;
        // Base + offset into r9 so we address with [r9 + disp].
        mov r9, r14;
        add r9, rcx;

        // qword 0 = (cursor << 32) | run_start
        mov rdx, r13;              // byte_end = current cursor
        shl rdx, 32;
        mov r8, [rsp + 0];         // run_start
        or rdx, r8;
        mov [r9 + 0], rdx;

        // qword 1 = current_class in low byte, rest zero.
        // (We already have current_class in [rsp+8].)
        mov rdx, [rsp + 8];
        mov [r9 + 8], rdx;

        // runs_emitted += 1
        add r11, 1;
        mov [rsp + 16], r11;

        // Fall through to initialise new run with (rax = new_class).

      bidi_r_init_run:
        // Start a new run: run_start := cursor, current_class := new_class
        mov [rsp + 0], r13;
        mov [rsp + 8], rax;

      bidi_r_extend:
        // Advance cursor to next_cursor and loop.
        mov r13, [rsp + 24];
        jmp bidi_r_loop_top;

      bidi_r_flush:
        // ---- Flush final run (if any) and exit OK ----
        // If current_class == 0xFF, no run to flush.
        mov rcx, [rsp + 8];
        cmp rcx, 0xFF;
        je bidi_r_pack_ok;

        // Capacity check for the final run.
        mov r11, [rsp + 16];
        cmp r11, r15;
        jae bidi_r_too_small;

        mov rcx, r11;
        shl rcx, 4;
        mov r9, r14;
        add r9, rcx;

        // qword 0 = (bytes_len << 32) | run_start
        // At EOF, cursor == bytes_len; r13 holds it either way (EOF
        // path returns next_cursor == cursor in _gc_next's packed
        // return, so r13 is still cursor_byte which equals bytes_len
        // when EOF was triggered by the cursor-check at the loop top;
        // if the EOF came from _gc_next's status=1, r13 == bytes_len
        // because the only way to reach _gc_next's EOF branch is to
        // have cursor == bytes_len at entry).
        mov rdx, r13;
        shl rdx, 32;
        mov r8, [rsp + 0];
        or rdx, r8;
        mov [r9 + 0], rdx;

        // qword 1 = current_class in low byte.
        mov rdx, [rsp + 8];
        mov [r9 + 8], rdx;

        // runs_emitted += 1
        add r11, 1;
        mov [rsp + 16], r11;

      bidi_r_pack_ok:
        // Return (runs_emitted << 32) | 0.
        mov rax, [rsp + 16];
        shl rax, 32;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bidi_r_invalid:
        // Return (runs_emitted << 32) | 2.
        // The current open run (if any) is DISCARDED: emitted runs
        // always end at a valid cluster boundary. The partial accumulator
        // of runs_emitted still reflects runs committed BEFORE the
        // malformed byte.
        mov rax, [rsp + 16];
        shl rax, 32;
        add rax, 2;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bidi_r_too_small:
        // Return (runs_emitted << 32) | 1.
        // Partial output IS committed (unlike normalize / collation
        // which emit atomically): the caller may resume from the
        // last committed run's byte_end. See module header "RETURN
        // SHAPES" for the rationale.
        mov rax, [rsp + 16];
        shl rax, 32;
        add rax, 1;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
