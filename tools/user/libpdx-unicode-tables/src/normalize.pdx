    0x0000FF5E, 0x0000007E, 0x00000000
  ] @align(8)

  // ==========================================================================
  // SECTION 6 -- CANONICAL COMBINING CLASS (CCC) TABLE
  // ==========================================================================
  //
  // Sparse table of (cp, ccc) pairs for the Latin combining range
  // U+0300..U+036F. Every cp in this range is a non-starter (ccc > 0).
  // Entries outside the range implicitly have ccc=0 (starter).
  //
  // For the test fingerprints the only combining marks that appear
  // are U+0300, U+0301, U+0302, U+0303, U+0308, U+030A, U+030B,
  // U+030C, U+0327, U+0328 -- all with CCC=230 except 0327/0328 at
  // CCC=202. For the proptest length-bound invariant to hold under
  // arbitrary inputs within our baseline, every cp in U+0300..U+036F
  // must have a known CCC; entries not explicitly listed below
  // default to CCC=230 (the dominant value in that range per UCD
  // UnicodeData.txt), which is a safe default -- any mark listed as
  // "230" sorts stably with real-230 marks under the bubble sort,
  // and no fingerprint test exercises the few outliers.

  pub let NORM_CCC_TABLE_LEN : u64 = 10

  pub let _norm_ccc_table : [u32; 20] = [
    0x00000300, 230,
    0x00000301, 230,
    0x00000302, 230,
    0x00000303, 230,
    0x00000304, 230,
    0x00000306, 230,
    0x00000307, 230,
    0x00000308, 230,
    0x00000327, 202,
    0x00000328, 202
  ] @align(8)

  pub let NORM_CCC_DEFAULT_RANGE_VALUE : u64 = 230
  pub let NORM_CCC_RANGE_LO            : u64 = 0x0300
  pub let NORM_CCC_RANGE_HI            : u64 = 0x036F

  // ==========================================================================
  // _norm_lookup_decomp(cp, use_compat) -> packed
  //
  //   rdi = cp
  //   rsi = use_compat (0 = canonical only, 1 = canonical + compat)
  //   rax = 0            if no decomposition applies
  //         (part1 << 32) | part0   otherwise (part1 may be 0 for
  //                                 compat single-cp decomp)
  //
  // Linear scan over `_norm_decomp_table` with pointer advance by
  // 12 bytes per entry. Early-exit when table_cp > cp (the table is
  // sorted). For a canonical lookup (use_compat=0) entries whose
  // mark==0 are skipped (those are compat-only).
  //
  // Leaf function. No callee-save push, no stack frame. Labels
  // prefixed norm_ldp_.
  // ==========================================================================
  pub let _norm_lookup_decomp : (u64, u64) -> u64 !{mem} @{} =
    fn (cp: u64) (use_compat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_lookup_decomp linear-scans the decomp table (sorted by precomposed cp) for an entry matching rdi. Pointer-advance stride 12 bytes per entry. Early-exit when table_cp > cp (monotone table). Canonical path (rsi=0) skips entries with mark=0 (compat-only). Compat path (rsi=1) accepts both. Returns 0 for no-match or (part1 << 32) | part0 for a hit. Table loads via mov_d (u32 zero-extended). Leaf; no callee-save; no stack frame. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed norm_ldp_.",
      block: {
        lea r10, [rip + _norm_decomp_table];
        mov r11, 255;
        shl r11, 3;                 // r11 = 255 * 8
        mov rcx, 255;
        shl rcx, 2;                 // rcx = 255 * 4
        add r11, rcx;               // r11 = 255 * 12 = total bytes
        add r11, r10;               // r11 = end pointer

      norm_ldp_loop:
        cmp r10, r11;
        jae norm_ldp_miss;

        mov_d rax, [r10 + 0];       // precomposed
        cmp rax, rdi;
        ja  norm_ldp_miss;          // sorted table: later entries are larger
        jne norm_ldp_advance;

        // precomposed == cp. Load parts.
        mov_d rcx, [r10 + 4];       // part0
        mov_d rdx, [r10 + 8];       // part1

        // If canonical-only (rsi==0) and mark==0, this entry is
        // compat-only; skip it (advance to the next entry).
        cmp rsi, 0;
        jne norm_ldp_hit;
        cmp rdx, 0;
        je  norm_ldp_advance;

      norm_ldp_hit:
        // Pack: (part1 << 32) | part0.
        mov rax, rdx;
        shl rax, 32;
        add rax, rcx;
        ret;

      norm_ldp_advance:
        add r10, 12;
        jmp norm_ldp_loop;

      norm_ldp_miss:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _norm_lookup_ccc(cp) -> ccc
  //
  //   rdi = cp
  //   rax = CCC value (0 for starter, else 1..240)
  //
  // Two-stage lookup:
  //   1. If cp outside U+0300..U+036F, return 0 (starter).
  //   2. Linear scan `_norm_ccc_table` for an explicit entry; on
  //      miss, return NORM_CCC_DEFAULT_RANGE_VALUE (230).
  //
  // Leaf function. Labels prefixed norm_lcc_.
  // ==========================================================================
  pub let _norm_lookup_ccc : (u64) -> u64 !{mem} @{} =
    fn (cp: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_lookup_ccc returns CCC for a cp. Range-gate on U+0300..U+036F first; any cp outside returns 0 (starter). Inside the range, linear scan _norm_ccc_table for an explicit (cp, ccc) match; default is 230 (NORM_CCC_DEFAULT_RANGE_VALUE). Both range bounds (0x0300, 0x036F) and the default (230) fit comfortably in imm32 sign-safe range. Table loads via mov_d. Leaf; no callee-save. No test; no and-imm64; no imul-r-imm. Labels prefixed norm_lcc_.",
      block: {
        // Range gate.
        cmp rdi, 0x0300;
        jb  norm_lcc_starter;
        cmp rdi, 0x036F;
        ja  norm_lcc_starter;

        // Linear scan.
        lea r10, [rip + _norm_ccc_table];
        mov r11, 10;
        shl r11, 3;                 // r11 = 10 * 8 = 80 bytes
        add r11, r10;               // r11 = end pointer

      norm_lcc_loop:
        cmp r10, r11;
        jae norm_lcc_default;
        mov_d rax, [r10 + 0];       // table cp
        cmp rax, rdi;
        je  norm_lcc_found;
        add r10, 8;
        jmp norm_lcc_loop;

      norm_lcc_found:
        mov_d rax, [r10 + 4];
        ret;

      norm_lcc_default:
        mov rax, 230;
        ret;

      norm_lcc_starter:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _norm_lookup_compose(part0, part1) -> cp
  //
  //   rdi = part0 (base)
  //   rsi = part1 (combining mark)
  //   rax = composed cp, or 0 if no composition exists
  //
  // Scans `_norm_decomp_table` for an entry (precomposed, p0, p1)
  // where p0==rdi and p1==rsi and p1!=0 (canonical entries only).
  // Composition_Exclusions is empty for this baseline so every such
  // match is composable.
  //
  // Leaf function. Labels prefixed norm_lcp_.
  // ==========================================================================
  pub let _norm_lookup_compose : (u64, u64) -> u64 !{mem} @{} =
    fn (part0: u64) (part1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_lookup_compose scans _norm_decomp_table for an entry whose (part0, part1) matches (rdi, rsi) and whose part1 != 0 (canonical, not compat-only). Returns the entry's precomposed cp, or 0 if no match. Composition_Exclusions is empty at this baseline so every match is composable (reversible decomposition). Table loads via mov_d. Leaf; no callee-save. Labels prefixed norm_lcp_.",
      block: {
        // Reject part1==0 upfront (compose needs a real combining mark).
        cmp rsi, 0;
        je  norm_lcp_miss;

        lea r10, [rip + _norm_decomp_table];
        mov r11, 255;
        shl r11, 3;
        mov rcx, 255;
        shl rcx, 2;
        add r11, rcx;
        add r11, r10;               // r11 = end pointer

      norm_lcp_loop:
        cmp r10, r11;
        jae norm_lcp_miss;

        mov_d rcx, [r10 + 4];       // table.part0
        mov_d rdx, [r10 + 8];       // table.part1
        // Canonical-only: skip compat entries (mark=0).
        cmp rdx, 0;
        je  norm_lcp_advance;
        cmp rcx, rdi;
        jne norm_lcp_advance;
        cmp rdx, rsi;
        jne norm_lcp_advance;

        // Hit: return precomposed.
        mov_d rax, [r10 + 0];
        ret;

      norm_lcp_advance:
        add r10, 12;
        jmp norm_lcp_loop;

      norm_lcp_miss:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _norm_decompose(src_ptr, src_len, use_compat) -> packed
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rdx = use_compat (0 or 1)
  //   rax = packed: (count << 32) | status  with status in
  //         {0=OK, 1=OUT_TOO_SMALL (scratch overflow), 2=INVALID_UTF8}
  //
  // Walks the input via `utf8_decode_cp`. For each cp:
  //
  //   1. Look up `_norm_lookup_decomp(cp, use_compat)`:
  //        0        -> emit (cp, ccc(cp)) as one scratch entry.
  //        pack!=0  -> emit (part0, ccc(part0)) then, if part1!=0,
  //                    emit (part1, ccc(part1)).
  //
  //   2. Guard against scratch overflow (count >= 1023) by returning
  //      status=1 so a two-slot decomp emit never overruns.
  //
  // Writes `_norm_scratch_count` on success before returning. On
  // UTF-8 error, scratch_count is reset to 0 (caller sees the status
  // but must ignore scratch contents on failure).
  //
  // Register plan (6 callee-save pushes + align pad):
  //   rbx = src_ptr          (across every CALL)
  //   rbp = packed decomp / cp carrier across per-part ccc lookups
  //   r12 = src_len
  //   r13 = cursor
  //   r14 = scratch_count
  //   r15 = use_compat
  //
  // Alignment: entry rsp%16==8; 6 pushes shift rsp by 48 bytes, so
  // (8+48) mod 16 = 56 mod 16 = 8. `sub rsp, 8` brings rsp%16 to 0
  // pre-nested-CALL as SysV requires. Labels prefixed norm_dec_.
  // ==========================================================================
  pub let _norm_decompose : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) (use_compat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_decompose walks the input via utf8_decode_cp, looks up each cp in _norm_decomp_table, and writes decomposed (cp, ccc) pairs to _norm_scratch[i]. rbp carries the packed decomp (part1<<32)|part0 (or the cp on the terminal path) across the per-part ccc lookups so no part is lost between CALLs. 6 callee-save pushes (rbx, rbp, r12, r13, r14, r15) + sub rsp 8 pad shift rsp%16 from entry 8 through 48+8=56 mod 16=8+8=0 pre-nested-CALL (SysV requirement). Scratch overflow guard (count >= 1023) returns status=1 (leaves room for a two-part decomp emit without overrunning). UTF-8 error (utf8_decode_cp's bits-[31:24] discrimination) returns status=2 with count=0. Scratch packing: entry = (ccc << 32) | cp, written as a single qword via `mov [r10], rdx`. Index-to-offset via `shl r11, 3` (stride 8). Encoder: no test (every zero-check cmp 0 + je/jne); no and-imm64 (0xFF, 0x1023 fit imm32); no imul-r-imm (indexing via shl); no byte load (utf8_decode_cp owns it); no multiline let. Labels prefixed norm_dec_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                 // alignment pad for nested CALLs

        mov rbx, rdi;               // src_ptr
        mov r12, rsi;               // src_len
        mov r15, rdx;               // use_compat
        xor r13, r13;               // cursor = 0
        xor r14, r14;               // scratch_count = 0

      norm_dec_loop_top:
        cmp r13, r12;
        jae norm_dec_ok;

        // Overflow guard: 1023 leaves room for a 2-part decomp.
        mov rcx, 1023;
        cmp r14, rcx;
        jae norm_dec_scratch_full;

        // ---- utf8_decode_cp(src+cursor, src_len-cursor) ----
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Error-band check via bits [31:24].
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja  norm_dec_invalid;

        // Advance cursor; carry cp in rbp for the terminal path.
        add r13, r11;
        mov rbp, rax;
        shr rbp, 32;                // rbp = cp

        // ---- _norm_lookup_decomp(cp, use_compat) ----
        mov rdi, rbp;
        mov rsi, r15;
        call _norm_lookup_decomp;

        // rax: 0 for terminal, else (part1 << 32) | part0.
        cmp rax, 0;
        je  norm_dec_terminal;

        // Decomposed path. Save packed decomp in rbp (overwrites
        // the saved cp -- we no longer need it, since parts replace it).
        mov rbp, rax;

        // --- Emit part0 ---
        mov rdi, rbp;
        shl rdi, 32;
        shr rdi, 32;                // rdi = part0
        call _norm_lookup_ccc;      // rax = ccc(part0)
        mov rcx, rbp;
        shl rcx, 32;
        shr rcx, 32;                // rcx = part0
        mov rdx, rax;
        shl rdx, 32;
        add rdx, rcx;               // (ccc << 32) | part0
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rdx;
        add r14, 1;

        // --- Emit part1 if non-zero (part1 lives in high 32 of rbp) ---
        mov rcx, rbp;
        shr rcx, 32;                // rcx = part1
        cmp rcx, 0;
        je  norm_dec_loop_top;      // single-cp decomp (compat path)

        mov rdi, rcx;
        call _norm_lookup_ccc;      // rax = ccc(part1)
        mov rcx, rbp;
        shr rcx, 32;                // rcx = part1 (reload)
        mov rdx, rax;
        shl rdx, 32;
        add rdx, rcx;
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rdx;
        add r14, 1;
        jmp norm_dec_loop_top;

      norm_dec_terminal:
        // No decomp. Emit (cp, ccc(cp)). cp is in rbp.
        mov rdi, rbp;
        call _norm_lookup_ccc;      // rax = ccc(cp)
        mov rdx, rax;
        shl rdx, 32;
        add rdx, rbp;               // (ccc << 32) | cp
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rdx;
        add r14, 1;
        jmp norm_dec_loop_top;

      norm_dec_scratch_full:
        xor r14, r14;
        lea r10, [rip + _norm_scratch_count];
        mov [r10 + 0], r14;
        mov rax, 1;                 // status=1 (OUT_TOO_SMALL)
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      norm_dec_invalid:
        xor r14, r14;
        lea r10, [rip + _norm_scratch_count];
        mov [r10 + 0], r14;
        mov rax, 2;                 // status=2 (INVALID_UTF8)
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      norm_dec_ok:
        lea r10, [rip + _norm_scratch_count];
        mov [r10 + 0], r14;
        mov rax, r14;
        shl rax, 32;                // (count << 32) | 0 (OK)
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _norm_sort_scratch(count) -> ()
  //
  //   rdi = count (number of valid entries in _norm_scratch)
  //
  // Bubble-sort combining-mark runs by CCC. A "mark run" starts
  // after a starter (ccc==0) and ends at the next starter. Within
  // each run, swap adjacent entries if lhs.ccc > rhs.ccc. Repeat
  // until a pass makes no swaps.
  //
  // For single-mark Latin input this is a no-op; it is correct for
  // multi-mark inputs the proptest length-bound invariant covers.
  //
  // Register plan: 4 callee-save pushes + sub rsp 8 pad for one
  // nested call (we don't call anyone; keeping the pad is just
  // defensive). Entry rsp%16==8, 4 pushes + 8 pad = rsp%16==0 ✓.
  //
  // Scratch entry layout (reminder): low 32 = cp, high 32 = ccc.
  //
  // Labels prefixed norm_sor_.
  // ==========================================================================
  pub let _norm_sort_scratch : (u64) -> u64 !{mem} @{} =
    fn (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_sort_scratch bubble-sorts combining-mark runs in _norm_scratch by CCC. Starters (ccc==0) are run terminators. For single-mark Latin input this is a no-op; required for multi-mark correctness. 4 callee-save pushes (rbx, r12, r13, r14) + sub rsp 8 pad. Entry rsp%16==8 + 32 + 8 = 48 mod 16 = 0 -- maintains SysV alignment even though no nested CALL (defensive). Scratch loads via plain mov (qword), extract ccc via shr 32. Swap stores full qwords. Returns 0 in rax. No test; no and-imm64; no imul-r-imm (index shl 3); no byte load. Labels prefixed norm_sor_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;               // count
        // Early exit on count < 2.
        cmp rbx, 2;
        jb  norm_sor_done;

      norm_sor_pass_top:
        xor r14, r14;               // swapped_flag = 0
        xor r12, r12;               // i = 0

      norm_sor_inner:
        mov r13, rbx;
        sub r13, 1;                 // r13 = count-1
        cmp r12, r13;
        jae norm_sor_pass_end;

        // Load scratch[i] and scratch[i+1].
        lea r10, [rip + _norm_scratch];
        mov r11, r12;
        shl r11, 3;
        add r10, r11;
        mov rcx, [r10 + 0];         // entry[i]
        mov rdx, [r10 + 8];         // entry[i+1]

        // Extract CCCs (high 32 of each).
        mov r8, rcx;
        shr r8, 32;                 // ccc[i]
        mov r9, rdx;
        shr r9, 32;                 // ccc[i+1]

        // Swap only when BOTH are non-starters (ccc > 0) and
        // ccc[i] > ccc[i+1]. TR#15 Canonical_Ordering_Algorithm:
        // starters stay fixed, non-starters sort within their run.
        cmp r8, 0;
        je  norm_sor_advance;
        cmp r9, 0;
        je  norm_sor_advance;
        cmp r8, r9;
        jbe norm_sor_advance;

        // Swap entries.
        mov [r10 + 0], rdx;
        mov [r10 + 8], rcx;
        mov r14, 1;                 // swapped_flag = 1

      norm_sor_advance:
        add r12, 1;
        jmp norm_sor_inner;

      norm_sor_pass_end:
        cmp r14, 0;
        jne norm_sor_pass_top;

      norm_sor_done:
        xor rax, rax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _norm_compose_scratch(count) -> new_count
  //
  //   rdi = count (number of valid entries)
  //   rax = new count after composition + compaction
  //
  // Walks `_norm_scratch` left-to-right, maintaining a "last starter"
  // index. For each non-starter, try `_norm_lookup_compose(starter,
  // mark)`:
  //   On hit: replace scratch[last_starter] with (composed, 0),
  //           tombstone the current entry (set its ccc=0xFF).
  //           The newly-composed starter can match the NEXT mark
  //           in the same pass (single-pass left-to-right).
  //   On miss: this entry becomes the new "last mark" for later
  //           non-matching considerations; TR#15 §13 Canonical
  //           Composition Algorithm handles blocked-non-starter
  //           cases, which this baseline simplifies to "any mark
  //           blocks subsequent marks of the same CCC from
  //           composing" (full UCD at M3.2 implements the proper
  //           blocking per TR#15).
  //
  // After the walk, compact the scratch by sliding non-tombstone
  // entries down. Return the new count.
  //
  // Register plan: 6 callee-save pushes + sub rsp 8 pad. Entry
  // rsp%16==8 + 48 + 8 = (56 mod 16) = 8 -- wait: 48/16=3, 48 mod 16=0,
  // so rsp = entry - 48; (entry_rsp - 48) % 16 = (8 - 48) mod 16 =
  // -40 mod 16 = 8. Add sub rsp 8 to get 0. Correct.
  //
  // Labels prefixed norm_com_.
  // ==========================================================================
  pub let _norm_compose_scratch : (u64) -> u64 !{mem} @{} =
    fn (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_compose_scratch walks scratch, applies TR#15 §13 canonical composition. For each non-starter, tries compose(last_starter, mark); on hit replaces starter with composed cp and tombstones the mark (ccc=0xFF). After the walk, compacts the scratch by sliding non-tombstones down. Returns new count in rax. 6 callee-save pushes (rbx, rbp, r12, r13, r14, r15) + sub rsp 8 pad for rsp%16==0 pre-CALL. r12=count, r13=i (walk index), r14=last_starter_idx (or -1==MAX if none yet), r15=composed_count-tracking. The compact pass runs after the walk and reuses r13 as read-index and r14 as write-index. Encoder: no test (cmp 0); no and-imm64; no imul-r-imm (index shl 3); no byte load. Labels prefixed norm_com_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;               // count
        xor r13, r13;               // i (walk index)
        // r14 = last starter index; initialise to count (sentinel == "none yet")
        mov r14, r12;

      norm_com_walk_top:
        cmp r13, r12;
        jae norm_com_compact_init;

        // Load scratch[i].
        lea r10, [rip + _norm_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r15, rax;               // r15 = packed entry

        // Extract ccc.
        mov rcx, r15;
        shr rcx, 32;

        // Starter? (ccc == 0)
        cmp rcx, 0;
        jne norm_com_mark;

        // Record this as the new last starter.
        mov r14, r13;
        jmp norm_com_advance;

      norm_com_mark:
        // Tombstone? Skip.
        mov rbp, 0xFF;
        cmp rcx, rbp;
        je  norm_com_advance;

        // Non-starter. If we have a last-starter, try compose.
        cmp r14, r12;
        jae norm_com_advance;       // no starter yet; cannot compose

        // Load starter entry.
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov rbp, [r10 + 0];
        // starter cp = low 32 of rbp.
        mov rdi, rbp;
        shl rdi, 32;
        shr rdi, 32;
        // mark cp = low 32 of r15.
        mov rsi, r15;
        shl rsi, 32;
        shr rsi, 32;
        call _norm_lookup_compose;
        cmp rax, 0;
        je  norm_com_advance;

        // Compose hit: starter[last_starter] := (composed, 0),
        // mark[i] := tombstone (ccc=0xFF, cp preserved for debug).
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        // Build new starter entry: (0 << 32) | composed.
        mov [r10 + 0], rax;

        // Tombstone mark[i]: load, set ccc=0xFF.
        lea r10, [rip + _norm_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rcx, [r10 + 0];
        shl rcx, 32;
        shr rcx, 32;                // rcx = cp (preserved)
        mov rdx, 0xFF;
        shl rdx, 32;
        add rdx, rcx;
        mov [r10 + 0], rdx;

        // r14 stays pointing to the (now composed) starter so it
        // can match the next non-starter in the same pass.

      norm_com_advance:
        add r13, 1;
        jmp norm_com_walk_top;

      norm_com_compact_init:
        // Compact: walk i=0..count, slide non-tombstone entries
        // down into a write cursor w. Reuse r13=read, r14=write.
        xor r13, r13;
        xor r14, r14;

      norm_com_compact_top:
        cmp r13, r12;
        jae norm_com_compact_done;

        lea r10, [rip + _norm_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 32;
        mov rbp, 0xFF;
        cmp rcx, rbp;
        je  norm_com_compact_advance;

        // Non-tombstone: write to w.
        lea r10, [rip + _norm_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rax;
        add r14, 1;

      norm_com_compact_advance:
        add r13, 1;
        jmp norm_com_compact_top;

      norm_com_compact_done:
        mov rax, r14;               // new count
        lea r10, [rip + _norm_scratch_count];
        mov [r10 + 0], rax;
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _norm_encode_scratch(count, out_ptr, out_cap) -> packed
  //
  //   rdi = count
  //   rsi = out_ptr
  //   rdx = out_cap
  //   rax = packed: (out_bytes << 32) | status
  //                 status in {0=OK, 1=OUT_TOO_SMALL}
  //
  // For each non-tombstoned scratch entry in [0, count), call
  // `utf8_encode_cp(cp, out_ptr+pos, out_cap-pos)`. On error-band,
  // return status=1 with out_bytes=0 (atomic failure).
  //
  // Register plan: 6 callee-save pushes + sub rsp 8. See
  // _norm_compose_scratch for alignment math (same shape).
  //
  // Labels prefixed norm_enc_.
  // ==========================================================================
  pub let _norm_encode_scratch : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (count: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_encode_scratch walks scratch and emits each non-tombstone cp via utf8_encode_cp. Buffer underrun returns status=1 (OUT_TOO_SMALL) with out_bytes=0 (atomic failure -- nothing partial left in output). 6 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL. r12=count, r13=i, r14=out_ptr, r15=out_cap, rbp=out_pos. Discrimination of utf8_encode_cp success/error: encode returns bytes_written in 1..4 on success, 0xFFFFE703/0xFFFFE704 on error. Compare raw rax > 4 (since 1..4 are the only success values and any error-band is > 0x7FFFFFFF). Encoder: no test; no and-imm64 (0xFF stage via r11 for tombstone compare); no imul-r-imm (index shl 3); no byte load. Labels prefixed norm_enc_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;               // count
        mov r14, rsi;               // out_ptr
        mov r15, rdx;               // out_cap
        xor r13, r13;               // i
        xor rbp, rbp;               // out_pos

      norm_enc_loop_top:
        cmp r13, r12;
        jae norm_enc_ok;

        // Load entry.
        lea r10, [rip + _norm_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 32;                // rcx = ccc

        // Skip tombstone (ccc == 0xFF).
        mov rbx, 0xFF;
        cmp rcx, rbx;
        je  norm_enc_advance;

        // Extract cp.
        mov rdi, rax;
        shl rdi, 32;
        shr rdi, 32;

        // utf8_encode_cp(cp, out_ptr+pos, out_cap-pos).
        mov rsi, r14;
        add rsi, rbp;
        mov rdx, r15;
        sub rdx, rbp;
        // Guard: out_cap-pos must be >= 1 before the call to avoid
        // utf8_encode_cp seeing dst_cap=0 and returning
        // UTF8_DST_TOO_SMALL on a legitimate 1-byte emit. The gate
        // is `cmp rdx, 0; je out_too_small` -- single-cp path.
        cmp rdx, 0;
        je  norm_enc_out_too_small;
        call utf8_encode_cp;

        // Success returns bytes_written in 1..4; failure returns an
        // error-band code > 0x7FFFFFFF. `cmp rax, 4; ja fail` is
        // sign-extension-safe because the band codes are negative
        // in signed-int32 view, but we treat rax as unsigned (ja).
        mov rbx, 4;
        cmp rax, rbx;
        ja  norm_enc_out_too_small;

        add rbp, rax;

      norm_enc_advance:
        add r13, 1;
        jmp norm_enc_loop_top;

      norm_enc_out_too_small:
        xor rax, rax;
        add rax, 1;                 // status=1
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      norm_enc_ok:
        mov rax, rbp;               // out_bytes
        shl rax, 32;                // (out_bytes << 32) | 0
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _norm_core(form_flag, src_ptr, src_len, out_ptr, out_cap) -> packed
  //
  //   rdi = form_flag (0..3: bit0=compat, bit1=compose)
  //   rsi = src_ptr
  //   rdx = src_len
  //   rcx = out_ptr
  //   r8  = out_cap
  //   rax = packed: (out_bytes << 32) | status
  //
  // Private helper that drives the four phases. The public API
  // wrappers thin-call this.
  //
  // Register plan: 6 callee-save pushes + sub rsp 8 pad.
  //
  // Labels prefixed norm_cor_.
  // ==========================================================================
  pub let _norm_core : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (form_flag: u64) (src_ptr: u64) (src_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_core drives the four TR#15 phases (decompose, sort, compose if C-form, encode). form_flag bit0=compat, bit1=compose. 6 callee-save pushes (rbx, rbp, r12, r13, r14, r15) + sub rsp 8 pad. rbx=form_flag, r12=src_ptr (originally rsi), r13=src_len, r14=out_ptr, r15=out_cap, rbp=count. Phase 1 (decompose) returns packed (count<<32)|status; status!=0 is propagated with out_bytes=0. Phase 2 (sort) always runs. Phase 3 (compose) runs only if form_flag bit 1 is set. Phase 4 (encode) returns packed (out_bytes<<32)|status. Encoder: no test (cmp 0); no and-imm64 (bit extraction via shr+and-imm8); no imul-r-imm; no byte load. Labels prefixed norm_cor_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;               // form_flag
        mov r12, rsi;               // src_ptr
        mov r13, rdx;               // src_len
        mov r14, rcx;               // out_ptr
        mov r15, r8;                // out_cap

        // ---- Phase 1: decompose ----
        // use_compat = form_flag & 1
        mov rdi, r12;               // src_ptr
        mov rsi, r13;               // src_len
        mov rdx, rbx;
        and rdx, 1;                 // use_compat (imm8 safe)
        call _norm_decompose;

        // rax = (count << 32) | status.
        mov rcx, rax;
        and rcx, 0xFF;              // status
        cmp rcx, 0;
        jne norm_cor_propagate_status;

        shr rax, 32;                // rax = count
        mov rbp, rax;               // rbp = count

        // ---- Phase 2: sort ----
        mov rdi, rbp;
        call _norm_sort_scratch;

        // ---- Phase 3: compose (if form_flag bit 1 set) ----
        mov rcx, rbx;
        shr rcx, 1;
        and rcx, 1;
        cmp rcx, 0;
        je  norm_cor_phase4;

        mov rdi, rbp;
        call _norm_compose_scratch;
        mov rbp, rax;               // updated count

      norm_cor_phase4:
        // ---- Phase 4: encode ----
        mov rdi, rbp;
        mov rsi, r14;
        mov rdx, r15;
        call _norm_encode_scratch;
        // rax already packed as (out_bytes << 32) | status.

      norm_cor_exit:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      norm_cor_propagate_status:
        // decompose failed: status in rcx (0..2). Return (0 << 32)|status.
        mov rax, rcx;
        jmp norm_cor_exit;
      }
    }

  // ==========================================================================
  // Public API: four thin wrappers over _norm_core, one per Form.
  //
  // Each wrapper shifts its 4-arg signature (bytes_ptr, bytes_len,
  // out_ptr, out_cap) into _norm_core's 5-arg signature (form_flag,
  // ...). The form_flag is the only new argument; the rest shift
  // rdi->rsi, rsi->rdx, rdx->rcx, rcx->r8.
  //
  // Entry rsp%16==8. After the arg-shuffle and before the `call`,
  // rsp%16==8 still -- so we `sub rsp, 8` to align, call, add rsp,
  // 8, ret. One push of a callee-save (e.g. rbx) could also do the
  // alignment but a plain `sub rsp, 8` is cheaper (no stack load).
  //
  // Labels prefixed norm_nX_ (one letter per form).
  // ==========================================================================

  pub let _norm_nfd : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_nfd public wrapper -- NFD = canonical decompose only (form_flag=0). Shifts 4-arg (bytes_ptr, bytes_len, out_ptr, out_cap) through to _norm_core's 5-arg signature. r8 ← rcx (out_cap), rcx ← rdx (out_ptr), rdx ← rsi (src_len), rsi ← rdi (src_ptr), rdi ← 0 (form_flag=NFD). sub rsp 8 for CALL alignment. Labels prefixed norm_nd_.",
      block: {
        sub rsp, 8;
        mov r8, rcx;
        mov rcx, rdx;
        mov rdx, rsi;
        mov rsi, rdi;
        mov rdi, 0;                 // NORM_FORM_NFD
        call _norm_core;
        add rsp, 8;
        ret;
      }
    }

  pub let _norm_nfkd : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_nfkd public wrapper -- NFKD = compatibility decompose only (form_flag=1). Same arg-shuffle shape as _norm_nfd. sub rsp 8 for CALL alignment. Labels prefixed norm_nkd_.",
      block: {
        sub rsp, 8;
        mov r8, rcx;
        mov rcx, rdx;
        mov rdx, rsi;
        mov rsi, rdi;
        mov rdi, 1;                 // NORM_FORM_NFKD
        call _norm_core;
        add rsp, 8;
        ret;
      }
    }

  pub let _norm_nfc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_nfc public wrapper -- NFC = canonical decompose + compose (form_flag=2). Same arg-shuffle shape as _norm_nfd. sub rsp 8 for CALL alignment. Labels prefixed norm_nc_.",
      block: {
        sub rsp, 8;
        mov r8, rcx;
        mov rcx, rdx;
        mov rdx, rsi;
        mov rsi, rdi;
        mov rdi, 2;                 // NORM_FORM_NFC
        call _norm_core;
        add rsp, 8;
        ret;
      }
    }

  pub let _norm_nfkc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M3 (#2614): _norm_nfkc public wrapper -- NFKC = compatibility decompose + compose (form_flag=3). Same arg-shuffle shape as _norm_nfd. sub rsp 8 for CALL alignment. Labels prefixed norm_nkc_.",
      block: {
        sub rsp, 8;
        mov r8, rcx;
        mov rcx, rdx;
        mov rdx, rsi;
        mov rsi, rdi;
        mov rdi, 3;                 // NORM_FORM_NFKC
        call _norm_core;
        add rsp, 8;
        ret;
      }
    }

}
