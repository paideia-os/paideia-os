// src/normalize.pdx -- libpdx-unicode-tables.M3 (paideia-os#2614, R131.M3)
//
// Normalize: user-space UAX #15 Unicode Normalization Forms over UTF-8.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of what a full-UCD normalizer provides.
// Four public entry points, one per Normalization Form, all with the
// same signature:
//
//   _norm_nfd (bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//   _norm_nfc (bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//   _norm_nfkd(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//   _norm_nfkc(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed_u64
//
// where the packed return is `(out_bytes << 32) | status`, with status
// in {0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8}.
//
// =============================================================================
// REDUCED UCD TABLE SCOPE (R131.M3 Latin-combining + fullwidth-ASCII baseline)
// =============================================================================
//
// The real Unicode Normalization Algorithm needs the FULL
// DerivedNormalizationProps.txt, UnicodeData.txt (canonical and
// compatibility decomposition fields), and the Composition_Exclusions
// list. For the R131.M3 baseline this file encodes a reduced subset
// sufficient for shell / pds / terminal correctness on Western text
// plus the two most common CJK fullwidth-ASCII cleanup needs:
//
// CANONICAL decompositions (used by NFC + NFD + NFKC + NFKD):
//
//   * Latin-1 Supplement precomposed (U+00C0..U+00FF, 53 entries).
//     Grave / acute / circumflex / tilde / dieresis / ring / cedilla
//     over A/C/E/I/N/O/U/Y plus their lowercase variants.
//   * Latin Extended-A precomposed (U+0100..U+017F, 108 entries).
//     Macron / breve / ogonek / dot / caron / stroke-free precomposed
//     variants for most European languages. Entries without a canonical
//     decomp in the UCD (Đ ħ ı Ł ŋ Œ Ŧ etc.) are omitted; entries that
//     doubly decompose to a Latin-1 Supplement base (none exist in Ext-A;
//     the first such entry is U+01DE in Ext-B, which this baseline does
//     not land) are also omitted so the table encodes FULLY-DECOMPOSED
//     forms and the decomposer stays single-level.
//
// COMPATIBILITY decompositions (used by NFKC + NFKD only; NFC + NFD skip them):
//
//   * Fullwidth-ASCII U+FF01..U+FF5E (94 entries). Each maps to the
//     corresponding ASCII code point by subtracting 0xFEE0. The
//     decomposition is single-cp (no combining mark), so these
//     entries carry mark=0 which is the discriminator the decomp
//     lookup uses to decide whether a given entry is compat-only.
//
// COMPOSITION EXCLUSIONS: empty for this baseline. Every canonical
// decomposition is therefore reversible by the composition step. In
// a full-UCD landing (M3.2+), this becomes a non-empty set reading
// from DerivedNormalizationProps.txt's Composition_Exclusions field,
// and the compose step gates on it.
//
// SCRIPTS EXPLICITLY DEFERRED to M3.2+ follow-ups (tracked in
// STATUS.md and the design doc at design/toolchain/
// libpdx-unicode-normalize.md):
//
//   * Devanagari (U+0900..U+097F) and other Indic scripts: need the
//     full Indic combining-mark set and the Nukta-reordering rules.
//   * Hebrew (U+0590..U+05FF): niqqud ordering.
//   * Arabic (U+0600..U+06FF): lam-alef compat decomps, presentation
//     forms (U+FB50..FDFF, U+FE70..FEFF).
//   * CJK Compatibility (U+F900..FAFF, U+2F800..2FA1F): canonical
//     decomps for IDS variants.
//   * Hangul syllables (U+AC00..D7A3): algorithmic L+V+T decomp per
//     TR#15 §16. (Note: TR#15 defines this algorithmically, not by
//     table lookup, so landing it is a code change not a data
//     change; still deferred to M3.2.)
//   * Latin Extended-B and beyond (U+0180..): extended precomposed
//     diacritics.
//
// =============================================================================
// UAX #15 ALGORITHM
// =============================================================================
//
// The implementation follows UAX #15 Rev. 55 (unicode.org/reports/tr15)
// adapted for a reduced table set. Four phases per call:
//
//   1. Decompose: walk the input one code point at a time via
//      utf8_decode_cp; for each cp, look up its decomposition in
//      the (compat or canonical) table. If decomposable, write the
//      decomposed parts to a scratch buffer as (cp, ccc) entries;
//      else write (cp, ccc(cp)) directly. Because this baseline's
//      table encodes fully-decomposed forms, a single lookup pass
//      suffices (the forward path to full UCD lands two-level
//      decomp as a worklist, which is a code change at M3.2).
//
//   2. Canonical ordering: run through the scratch buffer and
//      sort runs of non-starters (ccc > 0) by their Canonical
//      Combining Class (CCC). Starters (ccc == 0) terminate a
//      sort run; the sort is bubble-sort stable within each run.
//      For our Latin baseline every mark in the fingerprint
//      goldens has only one combining mark per base, so the sort
//      is effectively a no-op at test time; it is wired for
//      correctness under multi-mark input the proptest length
//      invariant exercises.
//
//   3. Composition (NFC + NFKC only; NFD + NFKD skip this phase):
//      walk the scratch buffer looking for (starter, non-starter)
//      pairs where the starter plus the non-starter composes to
//      a single cp via the composition table (inverse of the
//      canonical decomposition table, minus composition exclusions
//      which this baseline leaves empty). On a hit, replace the
//      starter with the composed cp and tombstone the non-starter
//      (ccc = 0xFF sentinel). The walk is left-to-right single-
//      pass; a composed starter can match the NEXT non-starter in
//      the same pass (so "cafe\u{0301}\u{0302}" over an alphabet
//      that composes both would collapse both marks).
//
//   4. Encode: walk the scratch buffer in order and emit each
//      non-tombstoned (cp, ccc) entry via utf8_encode_cp into the
//      caller-supplied output buffer. On buffer underrun (dst_cap
//      exhausted mid-encode) return status=1 (OUT_TOO_SMALL) with
//      out_bytes=0 (atomic failure -- nothing partial is left in
//      the output buffer, matching paideia-as-unicode's own
//      write-all-or-nothing semantics).
//
// =============================================================================
// SCRATCH BUFFER + REENTRANCY
// =============================================================================
//
// The decomposed intermediate representation lives in a static .bss
// buffer `_norm_scratch` (8 KiB, 1024 entries of 8 bytes each). Each
// entry layout:
//
//   bits [31:0]   cp         (0..0x10FFFF; sentinel 0xFFFFFFFF reserved
//                             for a future tombstone shape if the
//                             CCC-sentinel path proves too narrow)
//   bits [63:32]  ccc        (0..240 real, 0xFF reserved as tombstone)
//
// Using the ccc-high-byte 0xFF as the tombstone keeps the cp low-32
// legible for the encode phase's `utf8_encode_cp(cp, ...)` call site
// (we read the cp via `mov_d` without touching the high half; the
// tombstone check reads the high half and skips when it is 0xFF).
//
// REENTRANCY: this library is DESIGNED FOR SINGLE-THREADED RING-3
// CONSUMERS (shell, pds, terminal) and the scratch buffer is a
// process-wide shared slot. Overlapping calls -- including a signal
// handler invoking _norm_nfc while the main thread is partway
// through its own _norm_nfc -- will corrupt the intermediate scratch
// and MAY corrupt the output buffer. The ring-3 consumers that
// link this today all run on a single thread with no signal handler
// path through text processing, so this is acceptable at M3. If
// multi-threading support lands at R131.M5+ the scratch moves to
// a caller-supplied workspace argument.
//
// Scratch capacity is 1024 entries. For a 2048-byte input of fully
// precomposed Latin cps, each precomposed cp decomposes to 2 entries
// (base + mark), so the worst-case entry count is 2 * (bytes_len / 2)
// = bytes_len. For bytes_len > 1024 the decompose phase MAY overflow
// scratch; the current implementation returns status=1
// (OUT_TOO_SMALL) in that case, treating scratch overflow as a
// buffer-space exhaustion equivalent to the caller's out_cap being
// too small. This is a correctness-safe refusal (never a silent
// truncation).
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// Every public API returns one packed u64:
//
//   bits [63:32]  out_bytes_written  (0 on failure, >0 on success)
//   bits [7:0]    status             (0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8)
//   bits [31:8]   reserved           (always 0)
//
// Status discrimination:
//
//     mov r11, rax
//     and r11, 0xFF             -- r11 = status (0..2)
//     cmp r11, 0
//     jne <failure path>
//     shr rax, 32               -- rax = out_bytes_written on success
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- wide masks staged via MOVABS into r11,
//     then `and reg, r11`. The widest raw imm32-safe mask used here
//     is 0xFFFF (fits imm32 sign-safely). No 64-bit mask constants
//     appear anywhere in this file.
//   - No 2-op `imul r, imm`; indexing uses shifts (scratch entry
//     stride 8 -> `shl r, 3`; decomp table stride 12 -> `shl r, 2;
//     lea r, [r + r*2]` for i*12 or a plain `add r, 12`-per-step
//     pointer-advance scan; the latter is what every lookup here
//     uses).
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Normalize` matches `normalize.pdx`.
//   - Labels prefixed `norm_` (never `loop`/`if`/`let`/`fn` --
//     paideia-as reserved).
//   - MOVABS-into-register for every imm whose signed-imm32
//     representation differs from its unsigned value. The decomp
//     table max cp is 0xFF5E and the max combined mask is 0xFF, so
//     every immediate here fits comfortably in imm32 sign-safe range
//     (<= 0x7FFFFFFF). The only MOVABS staging is for the error-band
//     return constants (0xFFFFE720+) at the test-mode decompose exit.
//   - All byte loads via `mov_b` where applicable; this module does
//     no direct byte load of input (utf8_decode_cp owns that). Byte
//     stores to the output buffer are owned by utf8_encode_cp.
//   - Table loads via `mov_d` for u32 fields (zero-extends into the
//     full qword), matching libpdx-volume/pdxb_checksum.pdx.
//   - Entry rsp%16==8 preserved per SysV; nested-CALL rsp%16==0
//     enforced through push count parity (see per-function headers).
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (M1 UTF-8), paideia-os#2613 (M2 grapheme), paideia-os#2614 (THIS M3
// ticket). Design doc: design/toolchain/libpdx-unicode-normalize.md.

module Normalize = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (packed in low 8 bits of every return)
  // ==========================================================================

  pub let NORM_STATUS_OK            : u64 = 0
  pub let NORM_STATUS_OUT_TOO_SMALL : u64 = 1
  pub let NORM_STATUS_INVALID_UTF8  : u64 = 2

  // ==========================================================================
  // SECTION 2 -- ERROR BAND 0xFFFFE720..0xFFFFE72F (M3, normalize)
  // ==========================================================================
  //
  // Reserves the third 16-wide aligned slice above M2's
  // 0xFFFFE710..0xFFFFE71F slot. Two codes used at M3; the remaining
  // 14 slots are reserved for later normalization error kinds (e.g.
  // SCRATCH_OVERFLOW once that becomes its own distinct status at
  // M3.1, or TABLE_VERSION_MISMATCH when the UCD-pinned table set
  // can be swapped at run time at M3.2). Disjoint from every other
  // user-space band in the paideia-os tree (grep confirmation in
  // caps.decl's updated section).

  pub let NORM_INVALID_UTF8_CODE : u64 = 0xFFFFE720
  pub let NORM_OUT_TOO_SMALL_CODE : u64 = 0xFFFFE721

  // ==========================================================================
  // SECTION 3 -- FORM FLAGS
  // ==========================================================================
  //
  // Each public API wrapper sets its form flag before dispatching
  // into the shared `_norm_core` body. The flag is a two-bit value:
  //
  //   bit 0: compat (0 = canonical only, 1 = canonical + compatibility)
  //   bit 1: compose (0 = D-form, 1 = C-form)
  //
  // So: NFD=0b00, NFC=0b10, NFKD=0b01, NFKC=0b11.

  pub let NORM_FORM_NFD  : u64 = 0
  pub let NORM_FORM_NFKD : u64 = 1
  pub let NORM_FORM_NFC  : u64 = 2
  pub let NORM_FORM_NFKC : u64 = 3

  // ==========================================================================
  // SECTION 4 -- SCRATCH BUFFER (.bss)
  // ==========================================================================
  //
  // 1024 entries x 8 bytes = 8192 bytes. See module header for the
  // per-entry layout and reentrancy caveat. `_norm_scratch_count`
  // tracks the number of valid entries written during the current
  // call; it is reset to 0 by _norm_decompose and read by the sort /
  // compose / encode phases.

  pub let NORM_SCRATCH_MAX_ENTRIES : u64 = 1024
  pub let mut _norm_scratch        : [u8; 8192] = uninit @align(8)
  pub let mut _norm_scratch_count  : u64        = 0

  // Tombstone sentinel in the CCC high byte of a scratch entry.
  pub let NORM_TOMBSTONE_CCC : u64 = 0xFF

  // ==========================================================================
  // SECTION 5 -- DECOMPOSITION TABLE
  // ==========================================================================
  //
  // Flat triple-u32 table: (precomposed, part0, part1).
  //
  //   * `mark == 0` entries are COMPAT-ONLY (fullwidth-ASCII); the
  //     canonical lookup path skips them.
  //   * `mark != 0` entries are CANONICAL (both canonical and compat
  //     paths accept them -- compat is a superset of canonical per
  //     TR#15 §4).
  //
  // Sorted by precomposed cp so a linear scan terminates early on
  // "cp < table[i].precomposed" via a monotone-table early-exit. The
  // scan is linear in count (worst case ~255 iterations); for the
  // table sizes here (fits in one L1 line * ~24) this is faster than
  // a binary search's branch-misprediction cost.
  //
  // Entry count: 161 canonical (53 Latin-1 Sup + 108 Latin Ext-A) +
  // 94 compat (fullwidth-ASCII) = 255 entries. Each entry 3 u32 = 12
  // bytes = 3060 bytes total. Lives in .rodata.
  //
  // One entry per line (3 u32 values). Per the softarch brief's
  // "Big tables land as `pub let` arrays of u32 pairs or triples;
  // keep them single-line per entry" rule.

  pub let NORM_DECOMP_TABLE_LEN : u64 = 255

  pub let _norm_decomp_table : [u32; 765] = [
