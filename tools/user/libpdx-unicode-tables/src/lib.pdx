// src/lib.pdx -- libpdx-unicode-tables.M1 (paideia-os#2612, R131.M1)
//
// LibpdxUnicodeTables: library umbrella module.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This file is the library's SELF-DESCRIBING manifest: it carries the
// version triple, the capability-floor marker (none at M1), and the
// R131 milestone roadmap as compile-time constants a consumer can
// `cmp`-against to feature-gate on a specific wave's surface.
//
// It intentionally carries NO per-primitive logic -- every real
// decode/encode body lives in its own module file (src/utf8.pdx at M1;
// src/utf16.pdx, src/grapheme.pdx, src/norm.pdx, src/ucd.pdx at later
// milestones). This mirrors the shape libpdx-volume already uses:
// vol_kind / mount_table / pdxb_superblock / pdxb_sign are each their
// own module in their own file, with no top-level umbrella at all
// (libpdx-volume's `lib.pdx` does not exist). This library's lib.pdx
// does exist so a consumer can link ONE object (`build-out/lib.o`) to
// pick up the version/feature-gate constants without pulling in the
// full codec, which keeps the "feature-detect at startup, then dlsym
// the real symbols" idiom cheap.
//
// =============================================================================
// VERSIONING + FEATURE GATES
// =============================================================================
//
// LPX_UNICODE_VERSION_MAJOR / _MINOR / _PATCH follow SemVer. The
// MAJOR bump signals an incompatible API change (a decoder's return
// shape changing, a band code moving); MINOR is additive (a new
// primitive, a new UCD-generated table); PATCH is a bug fix that
// preserves wire-level behavior.
//
// LPX_UNICODE_UCD_VERSION mirrors the paideia-as-unicode UCD pin (15.1
// at the time of this M1 landing, per the paideia-as-unicode crate's
// `UCD_VERSION` constant at tools/paideia-as/crates/paideia-as-unicode/
// src/ucd.rs). Any UCD-generated table landed by a later milestone
// (Mn-mapping, grapheme-break property, normalization decomposition
// tables) MUST be re-generated from the pinned version; a reader of
// this library's output across repos can gate on this constant to
// detect UCD drift between the Rust-side generator and the pdx-side
// consumer.
//
// LPX_UNICODE_M1_READY etc. are per-milestone feature-ready flags.
// Only M1 is 1 at this landing; M2..M6 remain 0 until their landings
// close.
//
// Upstream: paideia-os#2480 (R131 Unicode umbrella); paideia-os#2612
// (this M1 ticket). Rust-side mirror:
// tools/paideia-as/crates/paideia-as-unicode/src/lib.rs.

module LibpdxUnicodeTables = structure {

  // ---- SemVer ----
  pub let LPX_UNICODE_VERSION_MAJOR : u64 = 1
  pub let LPX_UNICODE_VERSION_MINOR : u64 = 4
  pub let LPX_UNICODE_VERSION_PATCH : u64 = 0

  // ---- UCD pin (mirror of paideia-as-unicode::ucd::UCD_VERSION) ----
  // Encoded as (major << 16) | (minor << 8) | 0 so a consumer can
  // compare against another library's constant with a single mov+cmp.
  // 15.1.0 at M1.
  pub let LPX_UNICODE_UCD_VERSION   : u64 = 0x0F0100

  // ---- Per-milestone readiness flags (0 = not yet landed) ----
  //
  // M1 = utf8 primitives (paideia-os#2612)
  // M2 = grapheme-cluster iterator (paideia-os#2613); the earlier
  //      "streaming decoder" sketch has been pushed later pending
  //      the opaque-handle convention this library will own.
  // M3 = NFC/NFD/NFKC/NFKD normalization (paideia-os#2614);
  //      promoted up the M-table from the original "M6" slot to
  //      serve the shell / pds Unicode-stability work ahead of
  //      the streaming decoder + utf16 bridge, which bind to
  //      specific consumer sites not yet landed.
  // M4 = UCA collation (paideia-os#2615, reduced DUCET baseline);
  //      promoted up again -- shell / pds / terminal all need a
  //      locale-aware ordering primitive ahead of the streaming
  //      decoder + utf16 bridge, which bind to not-yet-landed sites.
  // M5 = display width (TR#11 reduced EAW, paideia-os#2616); promoted
  //      up again -- shell / pds / terminal all need column counting
  //      ahead of the streaming decoder + utf16 bridge, which bind
  //      to not-yet-landed consumer sites.
  // M6 = utf8 streaming decoder iterator (opaque-handle API)
  // M7 = utf16 bridge (lsp_bridge analog)
  // M8 = stream validators (fail-recover variant)
  pub let LPX_UNICODE_M1_READY      : u64 = 1   // utf8 primitives
  pub let LPX_UNICODE_M2_READY      : u64 = 1   // grapheme-cluster iterator (TR#29 reduced)
  pub let LPX_UNICODE_M3_READY      : u64 = 1   // normalization (NFC/NFD/NFKC/NFKD, reduced UCD)
  pub let LPX_UNICODE_M4_READY      : u64 = 1   // UCA collation (UTS#10, reduced DUCET)
  pub let LPX_UNICODE_M5_READY      : u64 = 1   // display width (TR#11, reduced EAW)
  pub let LPX_UNICODE_M6_READY      : u64 = 0   // streaming decoder iterator
  pub let LPX_UNICODE_M7_READY      : u64 = 0   // utf16 bridge
  pub let LPX_UNICODE_M8_READY      : u64 = 0   // stream validators (fail-recover)

  // ---- Feature-gate accessor ------------------------------------------
  //
  // lpx_unicode_feature_level() -> u64
  //
  // Returns the highest milestone number (1..8) whose primitives are
  // fully linked and callable. A consumer that wants to use a specific
  // primitive can gate on this (`cmp rax, 1; jb <fall back>`); this
  // avoids reading each _READY constant individually when all a caller
  // needs is "do we have at least M5?".
  //
  // Walk the _READY constants in declared order; return the index of
  // the LAST one set to 1. At M5 landing (R131.M5, paideia-os#2616)
  // M1..M5 are 1 and M6..M8 are 0, so the accessor returns 5.
  //
  // Leaf, no callee-save, no stack frame. Labels prefixed u_feat_.
  //
  pub let lpx_unicode_feature_level : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): feature-level accessor. At M5 the top of the ready stack is display width (LPX_UNICODE_M5_READY=1); return 5. Future milestones close by flipping their _READY constant to 1 and replacing this body with a cmp-and-raise chain. Leaf function, no callee-save push, no stack frame. Encoder: no test; no cmp against imm > 0x7FFFFFFF; no byte load.",
      block: {
        mov rax, 5;
        ret;
      }
    }

}
