// src/utf8.pdx -- libpdx-unicode-tables.M1 (paideia-os#2612, R131.M1)
//
// Utf8: user-space UTF-8 decode/encode primitives.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of what paideia-as-unicode (Rust-side,
// at tools/paideia-as/crates/paideia-as-unicode/src/utf8.rs) already
// exposes via its `Utf8Decoder` streaming iterator. The shell, pds, and
// every other ring-3 consumer that needs to walk a UTF-8 string on
// paideia-os links THIS library instead of either (a) re-implementing
// RFC 3629 by hand in every tool or (b) stepping through the kernel
// (there is no kernel-side UTF-8 primitive, by design: Unicode belongs
// above the capability boundary).
//
// Four entry points:
//
//   utf8_decode_cp(src_ptr, src_len)         -> packed | UTF8_*
//   utf8_encode_cp(cp, dst_ptr, dst_cap)     -> bytes_written | UTF8_*
//   utf8_is_valid(src_ptr, src_len)          -> 1 | 0
//   utf8_count_cp(src_ptr, src_len)          -> count | UTF8_*
//
// The decode return shape packs (codepoint_u21 << 32) | (bytes_u3 << 24)
// into one u64 register (status_u8 reserved at bits [7:0], always 0 on
// success at this landing). Error returns live in a disjoint 5-code
// band at 0xFFFFE700..0xFFFFE704 (SECTION 2 below). The two shapes are
// discriminated by bits [31:24] of the result: on success, that byte
// is `bytes_consumed` in 1..4; on every error band code it is 0xFF.
// See "Caller discrimination idiom" below for the exact 4-instruction
// `shr/and 0xFF/cmp 4/ja` sequence callers should use. A naive
// `cmp rax, 0xFFFFE700; jae error` is UNSAFE here because for any
// cp >= 1 the packed success value numerically exceeds the band code.
//
// =============================================================================
// RFC 3629 WELL-FORMED UTF-8 (reproduced here, cited at every gate)
// =============================================================================
//
// Per RFC 3629 §3 (encoding form) + §4 (well-formed byte sequences):
//
//   codepoint range     bits    bytes   byte 0        byte 1        byte 2        byte 3
//   U+0000..U+007F       7       1      0xxxxxxx
//   U+0080..U+07FF       11      2      110xxxxx      10xxxxxx
//   U+0800..U+FFFF       16      3      1110xxxx      10xxxxxx      10xxxxxx
//   U+10000..U+10FFFF    21      4      11110xxx      10xxxxxx      10xxxxxx      10xxxxxx
//
// Rejection cases (RFC 3629 §4 lead-byte sub-ranges):
//
//   OVERLONG: a sequence whose cp could be encoded in fewer bytes:
//     - lead 0xC0/0xC1 (would encode cp < 0x80 as 2 bytes)       -> UTF8_OVERLONG
//     - lead 0xE0 with byte1 < 0xA0 (would encode cp < 0x800)    -> UTF8_OVERLONG
//     - lead 0xF0 with byte1 < 0x90 (would encode cp < 0x10000)  -> UTF8_OVERLONG
//
//   SURROGATE: a code point in U+D800..U+DFFF, which the Unicode
//   standard forbids outside the UTF-16 encoding:
//     - lead 0xED with byte1 >= 0xA0                             -> UTF8_BAD_CP
//
//   OUT-OF-RANGE: a code point > U+10FFFF:
//     - lead 0xF4 with byte1 > 0x8F                              -> UTF8_BAD_CP
//     - lead 0xF5..0xFF entirely                                 -> UTF8_BAD_CP
//
//   TRUNCATED: src_len shorter than the lead byte's declared sequence length
//                                                                -> UTF8_TRUNCATED
//
//   BAD_CONTINUATION: a non-continuation byte (bits 7:6 != 10)
//   where RFC 3629 §3 demands one, or a lone continuation byte
//   (0x80..0xBF) appearing as a lead                             -> UTF8_BAD_UTF8
//
// This file DOES NOT implement the "advance past the offending byte
// and keep decoding" error-recovery that paideia-as-unicode's
// `Utf8Decoder::next` does; the shell's lexer wants a single pass that
// either fully decodes one code point or returns a specific error --
// recovery is the caller's job. See the module header's "FURTHER
// MILESTONES" index for the M2+ decode-iterator surface that will.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// utf8_decode_cp:
//
//   Success (rax layout):
//     bits [63:32]  codepoint     (0..0x10FFFF)
//     bits [31:24]  bytes_consumed (1..4)
//     bits [23:0]   status         (always 0 at this landing)
//
//   Failure (rax exactly):
//     0xFFFFE700..0xFFFFE704  (SECTION 2 band -- disjoint from success)
//
// Caller discrimination idiom (used by utf8_is_valid / utf8_count_cp
// below -- consumers outside this library should use the same shape):
//
//     mov r11, rax                 // save packed/error
//     shr r11, 24
//     and r11, 0xFF                // r11 = bytes_consumed on success, 0xFF on error
//     cmp r11, 4
//     ja  <error>                  // r11 >= 5 ==> error band (bytes 1..4 are legal)
//
// A naive `cmp rax, 0xFFFFE700; jae error` is UNSAFE here: for any
// cp >= 1 the packed success rax is >= 0x0000000100000000 which is
// unsigned-above 0xFFFFE700 (= 2^32 - 0x18FF ~ 4.29 * 10^9) -- the
// discriminator is bits [31:24] of rax, not rax itself. Every band
// code has bits [31:24] = 0xFF while every success packs bytes_consumed
// in 1..4 there.
//
// Successful decode extraction:
//   codepoint      = rax >> 32
//   bytes_consumed = (rax >> 24) & 0xFF
//
// utf8_encode_cp:
//
//   Success:  rax = bytes_written in 1..4.
//   Failure:  rax = 0xFFFFE703 (UTF8_BAD_CP: surrogate or > U+10FFFF)
//                or 0xFFFFE704 (UTF8_DST_TOO_SMALL: dst_cap < required).
//
// utf8_is_valid: 1 iff every code point in [src_ptr, src_ptr+src_len)
// decodes cleanly, else 0. Does not distinguish between error kinds;
// callers that need the specific reason should walk via utf8_decode_cp
// instead.
//
// utf8_count_cp: codepoint count on success, else the first error band
// code encountered (the walk stops at the first malformed sequence --
// the count up to that point is lost; this matches `wc -m`-style
// semantics where a malformed string has no well-defined length).
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE per the softarch brief)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- every mask is imm8/imm32 (0xFF, 0x3F,
//     0x1F, 0x0F, 0x07, 0xC0; all fit the imm8/imm32 sign-extension
//     trap guard requirement `imm == (imm as i32 as i64)`).
//   - No 2-op `imul r, imm`; left shifts replace multiplies here.
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Utf8` matches `utf8.pdx`.
//   - Labels prefixed `u8_` (never `loop`/`if`/`let` -- those are
//     paideia-as reserved).
//   - MOVABS-into-register for every imm whose signed-imm32 representation
//     differs from its unsigned value; all comparisons use `cmp reg, imm`
//     only for imm in [0, 0x7FFFFFFF], else staged through r10/r11.
//   - All byte loads via `mov_b` (zero-extends into the full qword
//     destination), matching libpdx-volume/pdxb_quota.pdx precedent.
//   - No `add reg, [mem]` anywhere -- every `add` is reg,reg or reg,imm.
//   - Leaf functions: no nested CALL, no callee-save prologue, no
//     alignment pad. utf8_is_valid / utf8_count_cp DO call
//     utf8_decode_cp -- those two use a two-push rbx/r12 prologue to
//     preserve the walk pointer + remaining-length across the call.
//
// =============================================================================
// FURTHER MILESTONES (not landed here)
// =============================================================================
//
//   M2  streaming decoder: an iterator-shaped surface
//       (utf8_decode_iter_begin/next/end) matching paideia-as-unicode's
//       Utf8Decoder for the shell's R221.M4 lexer. Requires an
//       opaque-handle convention this library does not yet own.
//   M3  utf16 bridge: utf8_offset_to_utf16 / utf16_offset_to_utf8 for
//       LSP consumers (paideia-as-unicode::lsp_bridge analog).
//   M4  stream validators (fail-fast and fail-recover variants).
//   M5  grapheme-cluster boundaries (needs UCD GraphemeBreakProperty).
//   M6  normalization (NFC/NFD -- needs UCD DerivedNormalizationProps).
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (this ticket, R131.M1). Rust-side mirror:
// tools/paideia-as/crates/paideia-as-unicode/src/utf8.rs.

module Utf8 = structure {

  // ==========================================================================
  // SECTION 1 -- RFC 3629 CLASSIFICATION CONSTANTS
  // ==========================================================================
  //
  // Lead-byte boundaries used by the decoder's dispatch. Every value
  // fits in imm8 but has bit 7 set, so for the trap-guard-safe path we
  // compare them staged through a register or via imm32-form `cmp` --
  // the encoder picks the imm32 form automatically for `cmp reg, imm`
  // when imm > 0x7F (positive imm32, so sign-extension to i64 is a
  // no-op; the i32==i64 identity holds).

  pub let UTF8_LEAD_1BYTE_MAX : u64 = 0x7F   // 0..0x7F are ASCII, 1 byte
  pub let UTF8_CONT_LO        : u64 = 0x80   // first continuation byte
  pub let UTF8_CONT_HI        : u64 = 0xBF   // last  continuation byte
  pub let UTF8_LEAD_2BYTE_LO  : u64 = 0xC2   // 0xC0/0xC1 are OVERLONG
  pub let UTF8_LEAD_2BYTE_HI  : u64 = 0xDF
  pub let UTF8_LEAD_3BYTE_LO  : u64 = 0xE0
  pub let UTF8_LEAD_3BYTE_HI  : u64 = 0xEF
  pub let UTF8_LEAD_4BYTE_LO  : u64 = 0xF0
  pub let UTF8_LEAD_4BYTE_HI  : u64 = 0xF4   // 0xF5..0xFF encode > U+10FFFF

  pub let UTF8_E0_C1_MIN      : u64 = 0xA0   // lead 0xE0: byte1 must be >= 0xA0
  pub let UTF8_ED_C1_MAX      : u64 = 0x9F   // lead 0xED: byte1 must be <= 0x9F
  pub let UTF8_F0_C1_MIN      : u64 = 0x90   // lead 0xF0: byte1 must be >= 0x90
  pub let UTF8_F4_C1_MAX      : u64 = 0x8F   // lead 0xF4: byte1 must be <= 0x8F

  pub let UTF8_MAX_CP         : u64 = 0x10FFFF
  pub let UTF8_SURROGATE_LO   : u64 = 0xD800
  pub let UTF8_SURROGATE_HI   : u64 = 0xDFFF

  // Pack-shape constants.
  pub let UTF8_BYTES_SHIFT    : u64 = 24     // bits [31:24] = bytes_consumed
  pub let UTF8_CP_SHIFT       : u64 = 32     // bits [63:32] = codepoint

  // ==========================================================================
  // SECTION 2 -- RETURN BAND 0xFFFFE700..0xFFFFE704 (five codes)
  // ==========================================================================
  //
  // This library takes an entire 16-wide aligned slice (0xFFFFE700..0F)
  // at the top of its user-space error-code taxonomy; only the first
  // five slots are used at M1. The band is disjoint from every other
  // code anywhere in the paideia-os tree:
  //
  //   grep -rE '0xFFFFE70[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no hits anywhere (confirmed at M1 scaffold time).
  //
  // Slots 5..F are reserved for M2+ error kinds (e.g. STATE_INVALID for
  // the streaming-decoder resume path, BUFFER_LOCKED for a future
  // write-through variant). The band shares the "high-user" shape with
  // libpdx-elevate's 0xFFFFE5E0..EF and paideia-os's shell / mv /
  // libpdx-elevate 0xFFFFEAxx bands (all are user-space, disjoint from
  // the kernel driver 0xFFFFFCxx cluster).

  pub let UTF8_BAD_UTF8       : u64 = 0xFFFFE700  // bad lead or bad continuation byte
  pub let UTF8_TRUNCATED      : u64 = 0xFFFFE701  // src_len shorter than lead's declared seq
  pub let UTF8_OVERLONG       : u64 = 0xFFFFE702  // RFC 3629 §4 overlong 2/3/4-byte form
  pub let UTF8_BAD_CP         : u64 = 0xFFFFE703  // surrogate (D800..DFFF) or > U+10FFFF
  pub let UTF8_DST_TOO_SMALL  : u64 = 0xFFFFE704  // dst_cap < bytes required to encode

  // ==========================================================================
  // utf8_decode_cp(src_ptr, src_len) -> packed_u64 | UTF8_*
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rax = success packed as described in the module header, OR
  //         one of the five UTF8_* codes in SECTION 2.
  //
  // Dispatch over the lead byte's declared sequence length. Each path
  // validates: (1) src_len >= seq_len (else UTF8_TRUNCATED), (2) every
  // continuation byte matches the RFC 3629 §4 sub-range, (3) the
  // resulting cp is not a surrogate and is <= U+10FFFF (the sub-range
  // table above makes those two checks structurally free, but the
  // 1-byte and 2-byte paths skip them because their value range cannot
  // violate either constraint).
  //
  // Leaf function. No callee-save push. All scratch is caller-save:
  //   rax     = result accumulator / scratch
  //   rcx     = scratch (byte load target, decode shift target)
  //   rdx     = scratch (continuation byte, mask immediate stage)
  //   r8      = codepoint accumulator
  //   r9      = scratch (continuation byte 2)
  //   r10     = scratch (continuation byte 3)
  //   r11     = staging register for immediates > imm8 sign-safe range
  //             (also used by paideia-as internally; we only write it,
  //              never expect it to survive across any instruction we
  //              did not emit ourselves)
  //
  // Labels prefixed u8_dec_.
  // ==========================================================================
  pub let utf8_decode_cp : (u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M1 (#2612): utf8_decode_cp real body. RFC 3629 §3 + §4 well-formed UTF-8 decoder: dispatch over lead byte 0..0x7F (1-byte ASCII), 0xC2..0xDF (2-byte), 0xE0..0xEF (3-byte with 0xE0/0xED sub-range gates), 0xF0..0xF4 (4-byte with 0xF0/0xF4 sub-range gates). Overlong leads 0xC0/0xC1 and 0xE0-with-byte1<0xA0 and 0xF0-with-byte1<0x90 return UTF8_OVERLONG. Surrogate lead 0xED with byte1>=0xA0 and 0xF4-with-byte1>0x8F / 0xF5..0xFF entirely return UTF8_BAD_CP. Lone continuation 0x80..0xBF as a lead returns UTF8_BAD_UTF8. src_len shorter than seq returns UTF8_TRUNCATED. Non-continuation byte in [0x80..0xBF] where RFC 3629 §3 demands one returns UTF8_BAD_UTF8. Byte loads via mov_b (zero-extends). Immediate masks (0x3F, 0x1F, 0x0F, 0x07) are small imm8/imm32 safe. Pack = (cp << 32) | (seq_len << 24); seq_len is 1..4 so the shifts are plain shl imm8. MOVABS for the UTF8_* band returns (every band value > 0x7FFFFFFF). No test; no and-imm64; no imul-r-imm; no multiline let; no add-reg-mem. Labels prefixed u8_dec_. Leaf; no callee-save prologue; no stack frame.",
      block: {
        // Gate 0: src_len == 0 -> UTF8_TRUNCATED.
        cmp rsi, 0;
        je  u8_dec_truncated;

        // Load the lead byte, zero-extended into rcx.
        mov_b rcx, [rdi + 0];

        // ---- Dispatch by lead-byte range -------------------------------
        // 1-byte ASCII: 0x00..0x7F.
        cmp rcx, 0x7F;
        jbe u8_dec_1byte;

        // Continuation byte 0x80..0xBF appearing as a lead -> BAD_UTF8.
        cmp rcx, 0xBF;
        jbe u8_dec_bad_utf8;

        // 2-byte overlong: 0xC0..0xC1 -> OVERLONG.
        cmp rcx, 0xC1;
        jbe u8_dec_overlong;

        // 2-byte valid: 0xC2..0xDF.
        cmp rcx, 0xDF;
        jbe u8_dec_2byte;

        // 3-byte: 0xE0..0xEF.
        cmp rcx, 0xEF;
        jbe u8_dec_3byte;

        // 4-byte: 0xF0..0xF4.
        cmp rcx, 0xF4;
        jbe u8_dec_4byte;

        // 0xF5..0xFF -> BAD_CP (would encode > U+10FFFF).
        jmp u8_dec_bad_cp;

        // ---- 1-byte ASCII path (rcx holds the byte) --------------------
      u8_dec_1byte:
        // Pack cp=rcx into bits [63:32], bytes=1 into bits [31:24].
        mov r8, rcx;
        shl r8, 32;
        mov rax, 1;
        shl rax, 24;
        add rax, r8;
        ret;

        // ---- 2-byte path (rcx = lead in 0xC2..0xDF) --------------------
      u8_dec_2byte:
        cmp rsi, 2;
        jb  u8_dec_truncated;
        mov_b rdx, [rdi + 1];
        // byte1 must be 0x80..0xBF.
        cmp rdx, 0x80;
        jb  u8_dec_bad_utf8;
        cmp rdx, 0xBF;
        ja  u8_dec_bad_utf8;
        // cp = ((lead & 0x1F) << 6) | (byte1 & 0x3F)
        mov r8, rcx;
        and r8, 0x1F;
        shl r8, 6;
        mov rax, rdx;
        and rax, 0x3F;
        add r8, rax;
        // Pack cp=r8, bytes=2.
        shl r8, 32;
        mov rax, 2;
        shl rax, 24;
        add rax, r8;
        ret;

        // ---- 3-byte path (rcx = lead in 0xE0..0xEF) --------------------
      u8_dec_3byte:
        cmp rsi, 3;
        jb  u8_dec_truncated;
        mov_b rdx, [rdi + 1];
        mov_b r9,  [rdi + 2];

        // byte2 (r9) must be 0x80..0xBF -- the simple continuation check
        // for the last byte applies regardless of the sub-range gating
        // on byte1.
        cmp r9, 0x80;
        jb  u8_dec_bad_utf8;
        cmp r9, 0xBF;
        ja  u8_dec_bad_utf8;

        // Sub-range gating on byte1 by lead:
        //   lead == 0xE0 -> byte1 in 0xA0..0xBF (else OVERLONG for < 0xA0)
        //   lead == 0xED -> byte1 in 0x80..0x9F (else BAD_CP for >= 0xA0,
        //                                       the surrogate half)
        //   else         -> byte1 in 0x80..0xBF
        cmp rcx, 0xE0;
        je  u8_dec_3byte_e0;
        cmp rcx, 0xED;
        je  u8_dec_3byte_ed;

        // Default 3-byte: byte1 in 0x80..0xBF.
        cmp rdx, 0x80;
        jb  u8_dec_bad_utf8;
        cmp rdx, 0xBF;
        ja  u8_dec_bad_utf8;
        jmp u8_dec_3byte_assemble;

      u8_dec_3byte_e0:
        // lead 0xE0: byte1 must be 0xA0..0xBF (< 0xA0 is overlong-for-3B).
        cmp rdx, 0xA0;
        jb  u8_dec_overlong;
        cmp rdx, 0xBF;
        ja  u8_dec_bad_utf8;
        jmp u8_dec_3byte_assemble;

      u8_dec_3byte_ed:
        // lead 0xED: byte1 must be 0x80..0x9F (>= 0xA0 is surrogate).
        cmp rdx, 0x80;
        jb  u8_dec_bad_utf8;
        cmp rdx, 0x9F;
        ja  u8_dec_bad_cp;

      u8_dec_3byte_assemble:
        // cp = ((lead & 0x0F) << 12) | ((byte1 & 0x3F) << 6) | (byte2 & 0x3F)
        mov r8, rcx;
        and r8, 0x0F;
        shl r8, 12;
        mov rax, rdx;
        and rax, 0x3F;
        shl rax, 6;
        add r8, rax;
        mov rax, r9;
        and rax, 0x3F;
        add r8, rax;
        // Pack cp=r8, bytes=3.
        shl r8, 32;
        mov rax, 3;
        shl rax, 24;
        add rax, r8;
        ret;

        // ---- 4-byte path (rcx = lead in 0xF0..0xF4) --------------------
      u8_dec_4byte:
        cmp rsi, 4;
        jb  u8_dec_truncated;
        mov_b rdx, [rdi + 1];
        mov_b r9,  [rdi + 2];
        mov_b r10, [rdi + 3];

        // byte2 (r9) and byte3 (r10) must each be 0x80..0xBF.
        cmp r9, 0x80;
        jb  u8_dec_bad_utf8;
        cmp r9, 0xBF;
        ja  u8_dec_bad_utf8;
        cmp r10, 0x80;
        jb  u8_dec_bad_utf8;
        cmp r10, 0xBF;
        ja  u8_dec_bad_utf8;

        // Sub-range gating on byte1 by lead:
        //   lead == 0xF0 -> byte1 in 0x90..0xBF (else OVERLONG for < 0x90)
        //   lead == 0xF4 -> byte1 in 0x80..0x8F (else BAD_CP for > 0x8F,
        //                                       which encodes > U+10FFFF)
        //   else         -> byte1 in 0x80..0xBF
        cmp rcx, 0xF0;
        je  u8_dec_4byte_f0;
        cmp rcx, 0xF4;
        je  u8_dec_4byte_f4;

        // Default 4-byte (0xF1..0xF3): byte1 in 0x80..0xBF.
        cmp rdx, 0x80;
        jb  u8_dec_bad_utf8;
        cmp rdx, 0xBF;
        ja  u8_dec_bad_utf8;
        jmp u8_dec_4byte_assemble;

      u8_dec_4byte_f0:
        cmp rdx, 0x90;
        jb  u8_dec_overlong;
        cmp rdx, 0xBF;
        ja  u8_dec_bad_utf8;
        jmp u8_dec_4byte_assemble;

      u8_dec_4byte_f4:
        cmp rdx, 0x80;
        jb  u8_dec_bad_utf8;
        cmp rdx, 0x8F;
        ja  u8_dec_bad_cp;

      u8_dec_4byte_assemble:
        // cp = ((lead  & 0x07) << 18)
        //    | ((byte1 & 0x3F) << 12)
        //    | ((byte2 & 0x3F) << 6)
        //    | (byte3 & 0x3F)
        mov r8, rcx;
        and r8, 0x07;
        shl r8, 18;
        mov rax, rdx;
        and rax, 0x3F;
        shl rax, 12;
        add r8, rax;
        mov rax, r9;
        and rax, 0x3F;
        shl rax, 6;
        add r8, rax;
        mov rax, r10;
        and rax, 0x3F;
        add r8, rax;
        // Pack cp=r8, bytes=4.
        shl r8, 32;
        mov rax, 4;
        shl rax, 24;
        add rax, r8;
        ret;

        // ---- Error exits (MOVABS the band code) ------------------------
      u8_dec_bad_utf8:
        mov rax, 0xFFFFE700;
        ret;
      u8_dec_truncated:
        mov rax, 0xFFFFE701;
        ret;
      u8_dec_overlong:
        mov rax, 0xFFFFE702;
        ret;
      u8_dec_bad_cp:
        mov rax, 0xFFFFE703;
        ret;
      }
    }

  // ==========================================================================
  // utf8_encode_cp(cp, dst_ptr, dst_cap) -> bytes_written | UTF8_*
  //
  //   rdi = cp
  //   rsi = dst_ptr
  //   rdx = dst_cap
  //   rax = bytes_written (1..4) on success, UTF8_BAD_CP (surrogate or
  //         > U+10FFFF) or UTF8_DST_TOO_SMALL on failure.
  //
  // Inverse of utf8_decode_cp per RFC 3629 §3. Writes 1..4 bytes to
  // dst_ptr; dst_cap gates the write (short-buffer failure before any
  // byte is written). Surrogate code points U+D800..U+DFFF and code
  // points > U+10FFFF are refused with UTF8_BAD_CP; the Unicode
  // standard forbids both from being encoded in any UTF.
  //
  // Dispatch tree:
  //   cp <  0x80       -> 1 byte  (requires dst_cap >= 1)
  //   cp <  0x800      -> 2 bytes (requires dst_cap >= 2)
  //   cp <  0x10000    -> 3 bytes (requires dst_cap >= 3; reject D800..DFFF)
  //   cp <= 0x10FFFF   -> 4 bytes (requires dst_cap >= 4)
  //   else             -> UTF8_BAD_CP
  //
  // Leaf. No nested call. All scratch is caller-save (rax, rcx, r8,
  // r9, r10, r11, rdi, rsi, rdx). Byte stores via `mov_b [dst+off], reg`
  // match pdxb_quota.pdx's byte-store precedent. Labels prefixed u8_enc_.
  // ==========================================================================
  pub let utf8_encode_cp : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (cp: u64) (dst_ptr: u64) (dst_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M1 (#2612): utf8_encode_cp real body. RFC 3629 §3 inverse of utf8_decode_cp. Dispatch cp<0x80/0x800/0x10000/0x110000 with surrogate (D800..DFFF) and OOR (>0x10FFFF) rejected via UTF8_BAD_CP. dst_cap gate per path; UTF8_DST_TOO_SMALL on under-capacity. All boundaries (0x80, 0x800, 0x10000, 0xD800, 0xDFFF, 0x110000) fit in imm32 (every value <= 0x110000 < 0x7FFFFFFF) so `cmp rdi, imm` is sign-extension-safe. Byte stores via mov_b (matches pdxb_quota.pdx L232 precedent). Masks (0x3F, 0x1F, 0x0F, 0x07, 0xC0, 0xE0, 0xF0) are small imm8/imm32 safe. OR of mask with payload uses `add` (payload bits are always zero where the mask bits sit, because payload is `and`-ed to 0x3F before the OR, so add==or semantically). MOVABS for UTF8_BAD_CP / UTF8_DST_TOO_SMALL (both >0x7FFFFFFF). Labels prefixed u8_enc_. Leaf.",
      block: {
        // -------- Reject surrogates and > U+10FFFF upfront --------
        // cp > 0x10FFFF -> UTF8_BAD_CP.
        mov rax, rdi;
        mov r11, 0x10FFFF;
        cmp rax, r11;
        ja  u8_enc_bad_cp;

        // Surrogate D800..DFFF -> UTF8_BAD_CP.
        mov r11, 0xD800;
        cmp rax, r11;
        jb  u8_enc_sz_check;      // < 0xD800: not a surrogate
        mov r11, 0xDFFF;
        cmp rax, r11;
        jbe u8_enc_bad_cp;        // in [0xD800, 0xDFFF]: surrogate

      u8_enc_sz_check:
        // -------- Dispatch by cp range --------
        cmp rax, 0x80;
        jb  u8_enc_1byte;
        cmp rax, 0x800;
        jb  u8_enc_2byte;
        cmp rax, 0x10000;
        jb  u8_enc_3byte;
        jmp u8_enc_4byte;

        // ---- 1-byte path --------------------
      u8_enc_1byte:
        cmp rdx, 1;
        jb  u8_enc_dst_too_small;
        mov_b [rsi + 0], rax;      // 0xxxxxxx
        mov rax, 1;
        ret;

        // ---- 2-byte path --------------------
        //   b0 = 0xC0 | (cp >> 6)
        //   b1 = 0x80 | (cp & 0x3F)
      u8_enc_2byte:
        cmp rdx, 2;
        jb  u8_enc_dst_too_small;
        mov rcx, rax;              // rcx = cp (preserved via rax above)
        mov r8, rcx;
        shr r8, 6;
        add r8, 0xC0;
        mov_b [rsi + 0], r8;
        mov r8, rcx;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 1], r8;
        mov rax, 2;
        ret;

        // ---- 3-byte path --------------------
        //   b0 = 0xE0 |  (cp >> 12)
        //   b1 = 0x80 | ((cp >>  6) & 0x3F)
        //   b2 = 0x80 |  (cp        & 0x3F)
      u8_enc_3byte:
        cmp rdx, 3;
        jb  u8_enc_dst_too_small;
        mov rcx, rax;
        mov r8, rcx;
        shr r8, 12;
        add r8, 0xE0;
        mov_b [rsi + 0], r8;
        mov r8, rcx;
        shr r8, 6;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 1], r8;
        mov r8, rcx;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 2], r8;
        mov rax, 3;
        ret;

        // ---- 4-byte path --------------------
        //   b0 = 0xF0 |  (cp >> 18)
        //   b1 = 0x80 | ((cp >> 12) & 0x3F)
        //   b2 = 0x80 | ((cp >>  6) & 0x3F)
        //   b3 = 0x80 |  (cp        & 0x3F)
      u8_enc_4byte:
        cmp rdx, 4;
        jb  u8_enc_dst_too_small;
        mov rcx, rax;
        mov r8, rcx;
        shr r8, 18;
        add r8, 0xF0;
        mov_b [rsi + 0], r8;
        mov r8, rcx;
        shr r8, 12;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 1], r8;
        mov r8, rcx;
        shr r8, 6;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 2], r8;
        mov r8, rcx;
        and r8, 0x3F;
        add r8, 0x80;
        mov_b [rsi + 3], r8;
        mov rax, 4;
        ret;

      u8_enc_bad_cp:
        mov rax, 0xFFFFE703;
        ret;
      u8_enc_dst_too_small:
        mov rax, 0xFFFFE704;
        ret;
      }
    }

  // ==========================================================================
  // utf8_is_valid(src_ptr, src_len) -> 1 | 0
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rax = 1 iff [src_ptr, src_ptr+src_len) is a well-formed UTF-8
  //         sequence; 0 on the first malformed sub-sequence encountered.
  //
  // Walk by calling utf8_decode_cp(cur_ptr, remaining); on success,
  // advance cur_ptr += bytes_consumed and remaining -= bytes_consumed;
  // on an error-band return, exit with 0. An empty buffer (src_len==0)
  // is valid (returns 1), matching paideia-as-unicode's own
  // Utf8Decoder::new(b"").collect() -> Ok(vec![]) semantics.
  //
  // Register plan:
  //   rbx     = cur_ptr (callee-save, must be pushed)
  //   r12     = remaining_len (callee-save, must be pushed)
  //
  // Two callee-save pushes -> 16 bytes of stack adjust, so the pre-CALL
  // rsp%16 posture is preserved (entry rsp%16==8 -> after two 8-byte
  // pushes rsp%16==8 -> matches SysV ABI for the nested utf8_decode_cp
  // call). Labels prefixed u8_vld_.
  // ==========================================================================
  pub let utf8_is_valid : (u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M1 (#2612): utf8_is_valid walks the byte range by calling utf8_decode_cp repeatedly; returns 1 iff every code point decodes without entering the UTF8_* error band. Two callee-save pushes (rbx, r12) preserve the walk pointer and remaining-length across the nested CALL. Entry rsp%16==8; two 8-byte pushes -> rsp%16==8 (SysV requires rsp%16==0 at the moment of a CALL; two pushes add 16 bytes so rsp%16 flips 8->(8-16 mod 16)==8, which matches SysV's own entry invariant -- see elevate_request_pack_op_word's identical two-push shape at elevate_request.pdx L387 for the same reasoning). Discrimination uses the bits-[31:24] idiom: `mov r11, rax; shr r11, 24; and r11, 0xFF; cmp r11, 4; ja fail`. On an error return (every band code has bits [31:24]==0xFF so r11 == 0xFF > 4), bail with rax=0. On success r11 == bytes_consumed in 1..4; apply to rbx (`add rbx, r11`) and r12 (`sub r12, r11`). Loop exits with rax=1 when r12 == 0. Masks are small imm8 (0xFF, 4) so no imm32 staging. Encoder: no test; no and-imm64; no imul-r-imm; no byte load (we never deref src ourselves -- utf8_decode_cp does). Labels prefixed u8_vld_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;              // rbx = cur_ptr
        mov r12, rsi;              // r12 = remaining
      u8_vld_loop_top:
        cmp r12, 0;
        je  u8_vld_ok;
        // Call utf8_decode_cp(rbx, r12).
        mov rdi, rbx;
        mov rsi, r12;
        call utf8_decode_cp;
        // Error band? bits [31:24] of rax are 0xFF on error, 1..4 on
        // success. See module header "Caller discrimination idiom".
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja  u8_vld_fail;
        // r11 now holds bytes_consumed; advance walk pointer / remaining.
        add rbx, r11;
        sub r12, r11;
        jmp u8_vld_loop_top;
      u8_vld_ok:
        mov rax, 1;
        pop r12;
        pop rbx;
        ret;
      u8_vld_fail:
        xor rax, rax;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // utf8_count_cp(src_ptr, src_len) -> count | UTF8_*
  //
  //   rdi = src_ptr
  //   rsi = src_len
  //   rax = codepoint count (0..src_len) on success, OR one of the
  //         UTF8_* error band codes if the walk encounters a malformed
  //         sub-sequence (the count up to that point is lost; a caller
  //         wanting the partial count should use the streaming surface
  //         landing at M2 instead).
  //
  // Walk by calling utf8_decode_cp; increment r13 per successful decode;
  // bail with the raw error code on the first malformed decode. Three
  // callee-save pushes (rbx = cur_ptr, r12 = remaining, r13 = count)
  // -> 24-byte stack adjust so rsp%16 toggles 8 -> 0 -> ... we add an
  // extra 8-byte `sub rsp, 8` so rsp%16==0 pre-nested-CALL. Labels
  // prefixed u8_cnt_.
  // ==========================================================================
  pub let utf8_count_cp : (u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M1 (#2612): utf8_count_cp walks the byte range and counts successful decodes. Three callee-save pushes (rbx, r12, r13) preserve cur_ptr/remaining/count. Entry rsp%16==8; after 3 pushes rsp%16 flips 8->0 (24 bytes added, modulo 16 is 8+24==32==0); we add `sub rsp, 8` so rsp%16==8 again -- NO wait: SysV CALL expects rsp%16==0 at the moment of CALL (so that the CALLEE sees rsp%16==8 at entry after the implicit push rip). Entry rsp%16==8; three pushes -> rsp%16==(8+24) mod 16 = 0; the `sub rsp, 8` would make it rsp%16==8 which is WRONG. Omit the `sub rsp, 8`: three pushes alone give rsp%16==0 which is what we want pre-CALL. Loop: on utf8_decode_cp success (bits [31:24] of rax in 1..4), extract bytes_consumed and apply to rbx/r12, add 1 to r13; on error-band return (bits [31:24] == 0xFF), propagate rax unchanged. Loop exits on r12==0 with rax=r13. Discrimination uses `mov r11, rax; shr r11, 24; and r11, 0xFF; cmp r11, 4; ja propagate` (the bits-[31:24] idiom documented in the module header). Encoder: no test; no and-imm64; no imul-r-imm; no byte loads. Labels prefixed u8_cnt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;               // rbx = cur_ptr
        mov r12, rsi;               // r12 = remaining
        xor r13, r13;               // r13 = count
      u8_cnt_loop_top:
        cmp r12, 0;
        je  u8_cnt_done;
        mov rdi, rbx;
        mov rsi, r12;
        call utf8_decode_cp;
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja  u8_cnt_propagate;
        add rbx, r11;
        sub r12, r11;
        add r13, 1;
        jmp u8_cnt_loop_top;
      u8_cnt_done:
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      u8_cnt_propagate:
        // rax already holds the UTF8_* error band code.
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
