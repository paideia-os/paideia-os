// src/width.pdx -- libpdx-unicode-tables.M5 (paideia-os#2616, R131.M5)
//
// Width: user-space TR#11 (East Asian Width) display-column classifier
// over UTF-8.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of what every terminal / shell / pds
// consumer needs when it has to answer "how many columns on a monospace
// grid does this string occupy?". Two public entry points:
//
//   _width_char(cp)                        -> u64 (0, 1, or 2)
//   _width_str(bytes_ptr, bytes_len)       -> packed_u64
//
// where the packed return is `(total_width << 32) | status`, with status
// in {0=OK, 2=INVALID_UTF8}. The width is the sum of each grapheme
// cluster's base code-point width; combining marks (zero-width by
// construction) contribute 0 and never widen their cluster.
//
// =============================================================================
// REDUCED EAW TABLE (R131.M5 CJK + emoji baseline)
// =============================================================================
//
// The full UAX #11 EAW property set is ~140,000 code points across six
// classes (Narrow, Wide, Halfwidth, Fullwidth, Ambiguous, Neutral) in
// Unicode 15.1.0. For the R131.M5 baseline this file encodes a reduced
// subset sufficient for shell / pds / terminal column correctness on the
// text consumer sites encounter today:
//
// WIDTH 0 (zero-width -- combining marks, ZWJ, variation selectors,
// control chars):
//
//   * U+0000..U+001F         C0 controls
//   * U+007F..U+009F         DEL + C1 controls
//   * U+0300..U+036F         Latin combining diacritics
//                            (shares the range M2's Grapheme classifier
//                             uses for its EXTEND property; this is the
//                             same block)
//   * U+200D                 ZERO WIDTH JOINER (ZWJ)
//   * U+FE00..U+FE0F         Variation Selectors VS1..VS16
//
// WIDTH 2 (wide / fullwidth -- East Asian scripts and common emoji):
//
//   * U+3000..U+303E         CJK Symbols and Punctuation
//   * U+3041..U+30FF         Hiragana + Katakana
//   * U+3400..U+4DBF         CJK Unified Ideographs Extension A
//   * U+4E00..U+9FFF         CJK Unified Ideographs
//   * U+AC00..U+D7A3         Hangul Syllables
//   * U+F900..U+FAFF         CJK Compatibility Ideographs
//   * U+FF01..U+FF60         Fullwidth ASCII (U+FF21='Ａ', etc.)
//   * U+FFE0..U+FFE6         Fullwidth sign block (¢, £, ¥, ￦, ...)
//   * U+1F300..U+1F9FF       Emoji (single-range approximation of the
//                            Extended_Pictographic property; matches
//                            the M2 Grapheme classifier's PICTOGRAPHIC
//                            range)
//
// WIDTH 1 (narrow -- the default):
//
//   Every code point not covered by the two sets above. This includes
//   printable ASCII (0x20..0x7E), Latin-1 Supplement non-controls, Latin
//   Extended-A, Greek, Cyrillic, Hebrew, Arabic, and every other BMP
//   script not in the wide table above.
//
// AMBIGUOUS WIDTH (UAX #11 class A): treated as narrow at M5. This is
// the locale-insensitive default; a locale-aware classifier (`_width_
// char_lc(cp, locale)`) that returns 2 for Ambiguous under East Asian
// locales lands at M5.1. Rationale: the current consumer sites (shell
// prompt, pds listing, terminal grid) all run with a Western locale
// default, and silently widening Ambiguous (e.g. U+00A7 §, U+2010 ‒, box
// drawing U+2500..U+257F) would misalign every Western terminal grid
// today for no gain. See STATUS.md "M5 limitations" and the design doc
// at design/toolchain/libpdx-unicode-width.md for the full migration
// path.
//
// =============================================================================
// UCA PIPELINE INTERACTION (M3 / M4) + GRAPHEME ITERATION (M2)
// =============================================================================
//
// `_width_str` walks the input one grapheme cluster at a time via
// `_gc_next` (M2). For each cluster it calls `utf8_decode_cp` on the
// FIRST byte of the cluster to get the base code point, then
// `_width_char(cp)` to get the cluster's display width. Non-base code
// points inside the cluster (combining marks, ZWJ, variation selectors
// in the GB9/GB11 chain) are implicitly zero-width because they would
// anyway classify as width-0 on their own; summing by cluster rather
// than by code point is the TR#11-aligned shape (a cluster is a single
// user-perceived character, so its width is the base's width).
//
// Normalisation form MATTERS for display width: NFC and NFD have the
// same width (combining marks are zero-width in both forms, and the
// precomposed base in NFC inherits its base's width), but NFKD / NFKC
// may DIFFER on fullwidth-ASCII inputs ('Ａ' is wide=2 but decomposes
// under NFKC to 'A' which is narrow=1). Callers that want "visual width
// of the user-typed string" should NOT normalise before calling
// _width_str; callers that want "visual width of the canonical form"
// should pass the already-normalised bytes.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// _width_char returns a u64 in {0, 1, 2}. No error band -- the caller
// has already decoded the cp (via utf8_decode_cp or _gc_next) so a
// width-of-a-known-cp call cannot fail.
//
// _width_str returns a packed u64:
//
//   bits [63:32]  total_width  (0..2 * number of clusters)
//   bits [7:0]    status       (0=OK, 2=INVALID_UTF8)
//   bits [31:8]   reserved     (always 0)
//
// On INVALID_UTF8 the total_width field reflects the sum ACCUMULATED
// SO FAR (clusters up to but not including the malformed byte). The
// status byte is the authoritative success/failure signal.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the only mask used (0xFF for status
//     extraction) fits imm32 sign-safe (0xFF is positive, well under
//     0x7FFFFFFF).
//   - No 2-op `imul r, imm`; the classifier uses only straight-line
//     range dispatch (no indexing arithmetic), and _width_str accumulates
//     via `add r14, rax` -- no multiply anywhere.
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Width` matches `width.pdx`.
//   - Labels prefixed `w_` (never `loop`/`if`/`let`/`fn` -- reserved).
//   - All `cmp reg, imm` immediates <= 0x1F9FF (the emoji upper bound);
//     all values are positive and well under 0x7FFFFFFF, so direct
//     `cmp reg, imm` is sign-extension-safe (imm == (imm as i32 as i64)).
//     No MOVABS staging needed.
//   - All byte loads via `mov_b` where applicable (this module does no
//     direct byte load of input; utf8_decode_cp / _gc_next do all byte
//     reads).
//   - Entry rsp%16==8 preserved per SysV; nested-CALL rsp%16==0 enforced
//     through push count parity (see per-function headers).
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// FURTHER WORK (not landed here; tracked in STATUS.md + design doc)
// =============================================================================
//
//   M5.1  Locale-sensitive Ambiguous handling. Add a second entry point
//         `_width_char_lc(cp, locale) -> u64` whose Ambiguous class
//         (currently narrow) returns 2 under East Asian locales (ja,
//         ko, zh) and 1 elsewhere. Needs a locale constant table.
//   M5.2  Full UCD EastAsianWidth.txt load. Replaces the hand-coded
//         range table in `_width_char` with a trie or sorted range
//         lookup. The current CJK+emoji baseline is enough for the
//         three consumer sites (shell, pds, terminal) today but not
//         for every script.
//   M5.3  Extended_Pictographic trie (sparse, ~1500 cps) replacing the
//         single-range approximation at U+1F300..U+1F9FF. Lands
//         alongside M2.2's trie for the Grapheme classifier.
//   M5.4  Hangul Jamo (U+1100..U+11FF) handling. L (leading consonant)
//         and V (vowel) are wide=2 at TR#11 even when they appear as
//         standalone cps (not composed into a syllable); T (trailing)
//         is narrow because it's a combining form. M5.4 wires this.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (M1 UTF-8), paideia-os#2613 (M2 grapheme), paideia-os#2614 (M3
// normalize), paideia-os#2615 (M4 collation), paideia-os#2616 (THIS M5
// ticket). Design doc: design/toolchain/libpdx-unicode-width.md.

module Width = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (returned in low 8 bits of _width_str's rax)
  // ==========================================================================
  //
  // Two disjoint values at M5. Status 1 (OUT_TOO_SMALL) is NOT used
  // because _width_str writes nothing -- the entire result lives in rax.
  // The slot is reserved for symmetry with the rest of the library.

  pub let W_STATUS_OK           : u64 = 0
  pub let W_STATUS_INVALID_UTF8 : u64 = 2

  // ==========================================================================
  // SECTION 2 -- ERROR BAND 0xFFFFE750..0xFFFFE75F (M5, width)
  // ==========================================================================
  //
  // Fifth 16-wide aligned user-space error-code slice taken by this
  // library (R131.M5, paideia-os#2616). Skips 0xFFFFE740..0xFFFFE74F
  // which is already claimed by the adaptive_rate sample's policy
  // module (src/samples/adaptive_rate/policy.pdx, G9.M6). One slot
  // used at M5; the remaining 15 slots are reserved for later
  // width-layer error kinds (e.g. W_LOCALE_UNKNOWN once per-locale
  // Ambiguous handling lands at M5.1). Disjoint from every other
  // user-space band in the paideia-os tree. Grep confirmation at M5
  // landing time:
  //
  //   grep -rE '0xFFFFE75[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no hits outside this file + caps.decl.
  //
  // The internal band value is a documented constant but the public
  // API never returns it raw: it packs status=2 into the low 8 bits of
  // the result, matching the _norm_nf{c,d,kc,kd} / _coll_sort_key
  // convention.

  pub let W_INVALID_UTF8      : u64 = 0xFFFFE750

  // ==========================================================================
  // _width_char(cp) -> width
  //
  //   rdi = cp (0..U+10FFFF; caller promises a successfully-decoded
  //         code point -- this function makes no range check for the
  //         surrogate half or > U+10FFFF, since utf8_decode_cp /
  //         _gc_next already rejected those at the UTF-8 layer).
  //   rax = width in {0, 1, 2}
  //
  // Straight-line range-dispatch classifier. Width-0 branches first
  // (controls, combining marks, ZWJ, variation selectors), then
  // width-2 branches (CJK + Hangul + fullwidth + emoji), with a final
  // fallthrough to width 1 (narrow default).
  //
  // Order matters only for the zero-width C0-controls branch:
  // cp <= 0x1F must be peeled BEFORE any width-2 range check that
  // might overlap. (At M5 no width-2 range starts below 0x3000 so no
  // overlap can actually occur, but the ordering stays conservative
  // for M5.1 locale-sensitive expansion.)
  //
  // Leaf function. No callee-save push. All scratch is caller-save
  // (rax). Labels prefixed w_c_.
  // ==========================================================================
  pub let _width_char : (u64) -> u64 !{} @{} =
    fn (cp: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): _width_char maps a decoded UTF-8 code point to its UAX #11 reduced-EAW display width. Four width-0 bands first (C0 controls U+0000..001F, C1 controls + DEL U+007F..009F, Latin combining U+0300..036F, ZWJ U+200D, variation selectors U+FE00..FE0F), then nine width-2 bands (CJK punct U+3000..303E, Hiragana/Katakana U+3041..30FF, CJK Ext-A U+3400..4DBF, CJK Unified U+4E00..9FFF, Hangul Syllables U+AC00..D7A3, CJK Compat U+F900..FAFF, Fullwidth ASCII U+FF01..FF60, Fullwidth signs U+FFE0..FFE6, Emoji U+1F300..1F9FF), falling through to width 1 (narrow default). All compare values are <= 0x1F9FF < 0x7FFFFFFF so `cmp rdi, imm` direct is sign-extension-safe. No test; no and-imm64; no imul; no byte load. Leaf; no callee-save push; no stack frame. Labels prefixed w_c_.",
      block: {
        // ---- Width 0: C0 controls U+0000..U+001F -------------------
        cmp rdi, 0x1F;
        ja w_c_check_c1;
        xor rax, rax;
        ret;

      w_c_check_c1:
        // ---- Width 0: DEL + C1 controls U+007F..U+009F -------------
        cmp rdi, 0x7F;
        jb w_c_check_combining;
        cmp rdi, 0x9F;
        ja w_c_check_combining;
        xor rax, rax;
        ret;

      w_c_check_combining:
        // ---- Width 0: Latin combining diacritics U+0300..U+036F ----
        cmp rdi, 0x0300;
        jb w_c_check_zwj;
        cmp rdi, 0x036F;
        ja w_c_check_zwj;
        xor rax, rax;
        ret;

      w_c_check_zwj:
        // ---- Width 0: Zero Width Joiner U+200D ---------------------
        cmp rdi, 0x200D;
        jne w_c_check_vs;
        xor rax, rax;
        ret;

      w_c_check_vs:
        // ---- Width 0: Variation Selectors U+FE00..U+FE0F -----------
        cmp rdi, 0xFE00;
        jb w_c_wide_cjk_punct;
        cmp rdi, 0xFE0F;
        ja w_c_wide_cjk_punct;
        xor rax, rax;
        ret;

      w_c_wide_cjk_punct:
        // ---- Width 2: CJK Symbols and Punctuation U+3000..U+303E ---
        //
        // From here on, every range is ascending. If cp < range.lo we
        // know cp < every subsequent range.lo too, so a `jb` jumps
        // directly to the narrow default (width 1).
        cmp rdi, 0x3000;
        jb w_c_narrow;
        cmp rdi, 0x303E;
        jbe w_c_wide_match;

        // ---- Width 2: Hiragana + Katakana U+3041..U+30FF -----------
        cmp rdi, 0x3041;
        jb w_c_narrow;
        cmp rdi, 0x30FF;
        jbe w_c_wide_match;

        // ---- Width 2: CJK Unified Ideographs Ext-A U+3400..U+4DBF --
        cmp rdi, 0x3400;
        jb w_c_narrow;
        cmp rdi, 0x4DBF;
        jbe w_c_wide_match;

        // ---- Width 2: CJK Unified Ideographs U+4E00..U+9FFF --------
        cmp rdi, 0x4E00;
        jb w_c_narrow;
        cmp rdi, 0x9FFF;
        jbe w_c_wide_match;

        // ---- Width 2: Hangul Syllables U+AC00..U+D7A3 --------------
        cmp rdi, 0xAC00;
        jb w_c_narrow;
        cmp rdi, 0xD7A3;
        jbe w_c_wide_match;

        // ---- Width 2: CJK Compatibility Ideographs U+F900..U+FAFF --
        cmp rdi, 0xF900;
        jb w_c_narrow;
        cmp rdi, 0xFAFF;
        jbe w_c_wide_match;

        // ---- Width 2: Fullwidth ASCII U+FF01..U+FF60 ---------------
        cmp rdi, 0xFF01;
        jb w_c_narrow;
        cmp rdi, 0xFF60;
        jbe w_c_wide_match;

        // ---- Width 2: Fullwidth sign block U+FFE0..U+FFE6 ----------
        cmp rdi, 0xFFE0;
        jb w_c_narrow;
        cmp rdi, 0xFFE6;
        jbe w_c_wide_match;

        // ---- Width 2: Emoji (Extended_Pictographic approx) ---------
        //      U+1F300..U+1F9FF
        cmp rdi, 0x1F300;
        jb w_c_narrow;
        cmp rdi, 0x1F9FF;
        jbe w_c_wide_match;

        // Above the top wide range: narrow default.
        jmp w_c_narrow;

      w_c_wide_match:
        mov rax, 2;
        ret;

      w_c_narrow:
        mov rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _width_str(bytes_ptr, bytes_len) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rax = (total_width << 32) | status
  //
  // Walks the input one grapheme cluster at a time via _gc_next. For
  // each cluster:
  //
  //   1. _gc_next(bytes_ptr, bytes_len, cursor) -> (next_cursor, status).
  //      - EOF (status=1): exit with the accumulated total, status=0.
  //      - INVALID_UTF8 (status=2): exit with the accumulated total,
  //        status=2 (byte at cursor is unrecoverable; partial total
  //        is still meaningful as "columns consumed so far").
  //      - OK (status=0): proceed.
  //   2. utf8_decode_cp(bytes_ptr + cursor, bytes_len - cursor)
  //      -> packed cp + bytes_consumed. The cluster has been
  //      successfully seeded by _gc_next so this decode MUST succeed;
  //      a defensive fallback to width 1 covers any future divergence
  //      between the two decoders.
  //   3. _width_char(cp) -> width in {0, 1, 2}.
  //   4. Add width to accumulator, advance cursor to next_cursor,
  //      loop.
  //
  // Register plan (five callee-save pushes; alignment math below):
  //   rbx    = bytes_ptr (callee-save, preserved across every CALL)
  //   r12    = bytes_len (callee-save)
  //   r13    = cursor    (callee-save; mutates across loop)
  //   r14    = total_width (callee-save; mutates across loop)
  //   r15    = saved next_cursor across the inner decode / width calls
  //            (so step 4 can restore it as r13 after step 3)
  //
  // Alignment: entry rsp%16==8; five 8-byte pushes shift rsp by 40
  // bytes, so (8+40) mod 16 = 48 mod 16 = 0. Matches SysV requirement.
  // No extra `sub rsp, N` pad.
  //
  // Labels prefixed w_s_.
  // ==========================================================================
  pub let _width_str : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M5 (#2616): _width_str walks the input one grapheme cluster at a time via _gc_next, decodes the base cp of each cluster via utf8_decode_cp, calls _width_char on the base cp, and accumulates the per-cluster widths in r14. Return shape: (total_width << 32) | status. EOF (gc status=1) exits with status=0 and the accumulated total; INVALID (gc status=2) exits with status=2 and the partial total; OK (gc status=0) continues the loop. Defensive fallback: if utf8_decode_cp disagrees with _gc_next's seed decode (shouldn't happen but could if the two layers diverge later), the cluster still counts as width 1. 5 callee-save pushes (rbx, r12, r13, r14, r15): entry rsp%16==8 + 40 bytes = (48 mod 16)=0 pre-CALL; matches SysV requirement for _gc_next, utf8_decode_cp, and _width_char. Status mask 0xFF fits imm32. All cmp immediates <= 4 (status codes and bytes_consumed sentinel). No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed w_s_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;              // rbx = bytes_ptr
        mov r12, rsi;              // r12 = bytes_len
        xor r13, r13;              // r13 = cursor = 0
        xor r14, r14;              // r14 = total_width = 0

      w_s_loop_top:
        // ---- Advance by one grapheme cluster ---------------------
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _gc_next;

        // Extract status (low 8 bits).
        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 1;
        je w_s_ok;                 // EOF: finish successfully
        cmp rcx, 2;
        je w_s_invalid;            // INVALID: propagate

        // OK: save next_cursor in r15 for use after the inner calls.
        mov r15, rax;
        shr r15, 32;

        // ---- Decode the base cp of this cluster ------------------
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Discriminate via bits [31:24] of the packed return: 1..4 on
        // success, 0xFF on error band. See utf8.pdx header "Caller
        // discrimination idiom".
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja w_s_skip_width_one;     // defensive fallback: width = 1

        // cp = rax >> 32.
        mov rdi, rax;
        shr rdi, 32;
        call _width_char;

        // ---- Accumulate and advance ------------------------------
        add r14, rax;
        mov r13, r15;
        jmp w_s_loop_top;

      w_s_skip_width_one:
        // Defensive fallback: _gc_next said this cluster starts with a
        // valid cp but utf8_decode_cp disagreed. Treat the cluster as
        // width 1 (one visible column) and advance past it. Current
        // M5 can't exercise this path -- _gc_next and utf8_decode_cp
        // share the same decoder.
        add r14, 1;
        mov r13, r15;
        jmp w_s_loop_top;

      w_s_ok:
        // Pack: rax = (r14 << 32) | 0.
        mov rax, r14;
        shl rax, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      w_s_invalid:
        // Pack: rax = (r14 << 32) | 2. The partial accumulator is
        // still meaningful (columns consumed up to the malformed
        // byte); status=2 is the authoritative error signal.
        mov rax, r14;
        shl rax, 32;
        add rax, 2;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
