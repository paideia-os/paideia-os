// src/grapheme.pdx -- libpdx-unicode-tables.M2 (paideia-os#2613, R131.M2)
//
// Grapheme: user-space TR#29 grapheme-cluster iterator over UTF-8.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of what paideia-as-unicode's
// `grapheme::GraphemeIter` already exposes to Rust-side consumers at
// tools/paideia-as/crates/paideia-as-unicode/src/grapheme.rs. Every
// ring-3 consumer that needs to walk a UTF-8 string by USER-PERCEIVED
// characters (not raw code points) -- notably the shell's prompt
// renderer, pds's text-column reflow, and the GPU-native terminal's
// grid builder -- links this module instead of either (a) iterating
// one code point at a time and getting the display cursor off by one
// on combining-mark input, or (b) stepping through the kernel.
//
// Two entry points:
//
//   _gc_next(bytes_ptr, bytes_len, cursor_byte) -> packed_u64
//   _gc_count(bytes_ptr, bytes_len)             -> u64 | GC_*
//
// where `packed_u64` is `(next_cursor << 32) | status`, with status in
// {0=OK, 1=EOF, 2=INVALID_UTF8}, and `_gc_count` returns the
// grapheme-cluster count on success or `GC_INVALID_UTF8`
// (0xFFFFE710, in the reserved 0xFFFFE710..0xFFFFE71F slice at the
// top of this library's user-space error band) when any sub-sequence
// fails to decode cleanly.
//
// =============================================================================
// UAX #29 Rev. 15 (unicode.org/reports/tr29/tr29-43.html) RULE SET
// =============================================================================
//
// The algorithm implemented here is the "extended grapheme cluster"
// variant of Unicode Technical Report #29 Rev. 15 (the UCD-15.1 pin
// that `src/lib.pdx::LPX_UNICODE_UCD_VERSION` carries). The full
// rule set (41 rules at Rev 15) is reduced to a Latin-plus-emoji
// baseline here: Hangul syllable composition (GB6/GB7/GB8) is
// stubbed as a no-op pending the full UCD GraphemeBreakProperty
// table at a later milestone (see "FURTHER WORK" below).
//
// GB1 (sot ÷ Any)
//   Break at the start of text. Expressed in `_gc_next` by the fact
//   that the iterator's first call always consumes one code point as
//   the cluster's SEED before entering the extension loop; `_gc_count`
//   re-enters this seed-and-extend cycle per cluster.
//
// GB2 (Any ÷ eot)
//   Break at the end of text. Enforced by the loop top's
//   `cmp r13, r12; jae gc_next_ok` check.
//
// GB3 (CR × LF)
//   No break between CR and LF. Encoded as `prop0==CR && prop1==LF
//   -> advance + continue`, with `prop0` promoted to LF so a
//   subsequent prop can still break via GB4.
//
// GB4 (Control | CR | LF ÷)
//   Break after Control, CR, LF.  `prop0 in {CR,LF,Control} -> break`
//   (comes AFTER the GB3 shortcut so CR-LF stays glued).
//
// GB5 (÷ Control | CR | LF)
//   Break before Control, CR, LF.
//
// GB6, GB7, GB8  -- Hangul syllable composition
//   STUBBED. The full table-driven classification (L/V/T/LV/LVT)
//   needs UCD HangulSyllableType.txt, which is not landed at M2;
//   each Hangul syllable at M2 is treated as a sequence of
//   independent clusters per GB999. Flagged in handback and in the
//   STATUS.md milestone checklist.
//
// GB9 (× (Extend | ZWJ))
//   No break before Extend or ZWJ. This is the core "combining mark
//   joins the base" rule for Latin diacritics and the first step of
//   the emoji-ZWJ chain.
//
// GB9a (× SpacingMark)
//   STUBBED at M2 (SpacingMark table is EMPTY in our reduced
//   property set, so this rule never fires).
//
// GB9b (Prepend ×)
//   STUBBED at M2 (Prepend table is EMPTY in our reduced property
//   set, so this rule never fires).
//
// GB11 ((\p{Extended_Pictographic} Extend*) ZWJ × \p{Extended_Pictographic})
//   No break inside an emoji ZWJ sequence. Encoded by tracking two
//   bits of state across the extension loop:
//     ep_chain  -- the cluster began at a Pictographic and only
//                  Extend/ZWJ have been consumed since.
//     zwj_armed -- the IMMEDIATELY preceding prop was ZWJ while
//                  ep_chain was active.
//   When `zwj_armed == 1 && prop1 == Pictographic`, extend; reset
//   zwj_armed, keep ep_chain=1 (the new EP starts a fresh potential
//   EP-chain). Consuming an Extend after a ZWJ clears zwj_armed but
//   keeps ep_chain -- the chain survives Extend* but a non-adjacent
//   ZWJ-then-EP does NOT satisfy GB11.
//
// GB12 (sot (RI RI)* RI × RI)
// GB13 ([^RI] (RI RI)* RI × RI)
//   Flag emoji: pairs of Regional_Indicator cluster, extras start
//   fresh clusters. Encoded by `ri_count` (0, 1, or 2): starts at 1
//   if the cluster SEED was RI; a second RI with `prop0==RI &&
//   ri_count==1` extends to count=2; a third RI then breaks (count=2
//   fails the condition).
//
// GB999 (Any ÷ Any)
//   Default: break between any two code points not covered above.
//
// =============================================================================
// REDUCED TR#29 PROPERTY TABLE (R131.M2 Latin-plus-emoji baseline)
// =============================================================================
//
// Classification happens in `_gc_classify(cp)` by range compares.
// The seven properties this milestone recognises are:
//
//   prop  constant                range (code points)                reason
//    0    GC_PROP_OTHER           everything else                    GB999
//    1    GC_PROP_CR              U+000D                             GB3, GB4
//    2    GC_PROP_LF              U+000A                             GB3, GB4
//    3    GC_PROP_CONTROL         U+0000..U+001F except CR/LF        GB4, GB5
//                                 U+007F..U+009F
//    4    GC_PROP_EXTEND          U+0300..U+036F (Latin combining)   GB9
//    5    GC_PROP_ZWJ             U+200D                             GB9, GB11
//    6    GC_PROP_RI              U+1F1E6..U+1F1FF                   GB12, GB13
//    7    GC_PROP_PICTOGRAPHIC    U+1F300..U+1F9FF                   GB11
//
// Properties NOT YET REPRESENTED: SpacingMark, Prepend, L, V, T,
// LV, LVT. See STATUS.md "M2 limitations" for the full list and the
// milestone that lands each.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// _gc_next:
//
//   Success (rax layout):
//     bits [63:32]  next_cursor   (end of this cluster in bytes)
//     bits [31:0]   status        (0=OK, 1=EOF, 2=INVALID_UTF8)
//
//   The caller extracts via `shr rax, 32` (next_cursor) and `and
//   rax, 0xFFFFFFFF` (status). An OK status means the cluster is
//   `[cursor_byte, next_cursor)`; EOF means the input is exhausted
//   (cursor_byte == bytes_len); INVALID_UTF8 means the byte at
//   `cursor_byte` could not be decoded, and cursor_byte is
//   unchanged in bits [63:32] -- the caller may skip past the
//   offending byte and retry, mirroring paideia-as-unicode's
//   `Utf8Decoder::next` recovery semantics.
//
//   If an invalid byte appears MID-CLUSTER (after at least one
//   successful code-point decode), `_gc_next` returns OK with the
//   partial cluster ending just before the invalid byte, so the
//   NEXT call to `_gc_next` sees INVALID_UTF8 as its initial decode.
//   This matches ICU's `BreakIterator::next` recovery semantics and
//   lets the proptest "round-trip" invariant hold on valid prefixes.
//
// _gc_count:
//
//   Success:  rax = cluster count (0..bytes_len).
//   Failure:  rax = 0xFFFFE710 (GC_INVALID_UTF8) if any sub-sequence
//             is malformed; the partial count up to that point is
//             discarded, matching utf8_count_cp's `wc -m`-style
//             refusal.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- wide masks are staged via `mov r11, imm64;
//     and reg, r11` (MOVABS into a register, then reg-reg AND). The
//     masks that need this are 0xFFFFFFFFFFFF00FF (clear state byte 1)
//     and 0xFFFFFFFFFF00FFFF (clear state byte 2). Small masks
//     (0xFF, 0x100, 0x10000, 0x20000) all fit imm32 sign-safe.
//   - No 2-op `imul r, imm`; the dispatcher uses shifts, not
//     multiplies, so no imul anywhere in this module.
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Grapheme` matches `grapheme.pdx`.
//   - Labels prefixed `gc_` (never `loop`/`if`/`let` -- reserved).
//   - MOVABS-into-register for every imm whose signed-imm32
//     representation differs from its unsigned value. All compares
//     here use imm <= 0x1F9FF (Pictographic upper bound), which is
//     well below 0x7FFFFFFF, so `cmp reg, imm` direct is safe.
//   - All byte loads via `mov_b` where applicable (we only call
//     utf8_decode_cp, which does the actual byte load internally;
//     this module does no direct byte load of input).
//   - Entry rsp%16==8 preserved; nested-CALL rsp%16==0 enforced
//     through push count parity (see per-function headers).
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// FURTHER WORK (not landed here; tracked in STATUS.md)
// =============================================================================
//
//   M2.1  Hangul syllable composition (GB6/GB7/GB8). Needs UCD
//         HangulSyllableType.txt table landing as a `[u8; N]`
//         binding; the classifier's final branch grows a range
//         check for 0xAC00..0xD7A3 split into L/V/T/LV/LVT classes.
//   M2.2  Full GraphemeBreakProperty.txt load. Replaces the hand-
//         coded range table in `_gc_classify` with a trie or sorted
//         range lookup. The current Latin-plus-emoji baseline is
//         enough for shell/pds display cursor correctness on
//         diacritic and emoji input, but not for Indic scripts
//         (SpacingMark/Prepend are empty here).
//   M2.3  SpacingMark (GB9a) and Prepend (GB9b) once the UCD tables
//         land. The rule gates are already present in the state
//         machine shape (just no prop assigns at them yet).
//   M2.4  Streaming-iterator surface mirroring paideia-as-unicode's
//         `GraphemeIter` type (opaque handle, next() API). Current
//         API is cursor-threading, which is zero-alloc but requires
//         the caller to loop.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (M1 UTF-8 primitives), paideia-os#2613 (THIS M2 ticket).
// Rust-side mirror: tools/paideia-as/crates/paideia-as-unicode/
// src/grapheme.rs.

module Grapheme = structure {

  // ==========================================================================
  // SECTION 1 -- REDUCED PROPERTY-CLASS CONSTANTS (Rev 15 Latin baseline)
  // ==========================================================================
  //
  // Property values are small (0..7) and are passed in rax from
  // _gc_classify to _gc_next's rule gates. They are NOT exposed to
  // consumers of this library -- the classifier is pub so a smoke
  // test can call it directly, but the integer values are an
  // internal implementation detail that may compact or extend when
  // M2.1 lands Hangul.

  pub let GC_PROP_OTHER        : u64 = 0
  pub let GC_PROP_CR           : u64 = 1
  pub let GC_PROP_LF           : u64 = 2
  pub let GC_PROP_CONTROL      : u64 = 3
  pub let GC_PROP_EXTEND       : u64 = 4
  pub let GC_PROP_ZWJ          : u64 = 5
  pub let GC_PROP_RI           : u64 = 6
  pub let GC_PROP_PICTOGRAPHIC : u64 = 7

  // ==========================================================================
  // SECTION 2 -- STATUS CODES (returned in low 32 bits of _gc_next's rax)
  // ==========================================================================
  //
  // Three disjoint values. Status fits comfortably in a byte; the
  // low 32 bits of the return are reserved to leave room for future
  // sub-status flags (e.g. BIDI_RTL hints at M3). At M2 only the
  // low byte is non-zero and the high 24 of the status word are
  // zero on every success and error.

  pub let GC_STATUS_OK           : u64 = 0
  pub let GC_STATUS_EOF          : u64 = 1
  pub let GC_STATUS_INVALID_UTF8 : u64 = 2

  // ==========================================================================
  // SECTION 3 -- ERROR BAND for _gc_count (0xFFFFE710..0xFFFFE71F)
  // ==========================================================================
  //
  // Reserves the next 16-wide aligned slice above M1's
  // 0xFFFFE700..0xFFFFE70F slot. One code used at M2; the remaining
  // 15 slots are reserved for M3+ error kinds (e.g. GC_STATE_INVALID
  // if a future streaming-iterator surface lands with a resume path).
  // Disjoint from every other user-space band per the grep
  // confirmation documented in `caps.decl`.

  pub let GC_INVALID_UTF8      : u64 = 0xFFFFE710

  // ==========================================================================
  // _gc_classify(cp) -> prop
  //
  //   rdi = cp (0..U+10FFFF; caller promises a successfully-decoded
  //         code point -- this function makes no range check for the
  //         surrogate half or > U+10FFFF, since utf8_decode_cp
  //         already rejected those at the UTF-8 layer).
  //   rax = property value (0..7)
  //
  // Straight-line range-dispatch classifier. Each branch returns
  // immediately on match, falling through to the next range on miss.
  // Order matters only for the two Control bands (0x00..0x1F sans
  // CR/LF, and 0x7F..0x9F) -- CR and LF must be matched BEFORE the
  // generic 0x00..0x1F check (otherwise they would be mis-classified
  // as Control). The remaining branches are mutually disjoint so
  // their order is a performance choice (ASCII first since it is
  // the overwhelming common case).
  //
  // Leaf function. No callee-save push. All scratch is caller-save
  // (rax). Labels prefixed gc_cls_.
  // ==========================================================================
  pub let _gc_classify : (u64) -> u64 !{} @{} =
    fn (cp: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): _gc_classify maps a decoded UTF-8 code point to one of eight TR#29 property values. Straight-line range dispatch: CR (U+000D)=1, LF (U+000A)=2, Control 0x00..0x1F=3 (CR/LF already peeled), ZWJ U+200D=5, Extend U+0300..U+036F=4, Control 0x7F..0x9F=3, Regional Indicator U+1F1E6..U+1F1FF=6, Pictographic U+1F300..U+1F9FF=7, fallthrough=0 (OTHER). All compare values are <= 0x1F9FF < 0x7FFFFFFF so `cmp rdi, imm` direct is sign-extension-safe (imm == (imm as i32 as i64)). No test; no and-imm64; no imul; no byte load. Leaf; no callee-save push; no stack frame. Labels prefixed gc_cls_.",
      block: {
        // CR (U+000D) -- must be peeled before the generic 0x00..0x1F
        // Control branch below.
        cmp rdi, 0x0D;
        jne gc_cls_lf;
        mov rax, 1;
        ret;

      gc_cls_lf:
        // LF (U+000A) -- must be peeled before the generic Control branch.
        cmp rdi, 0x0A;
        jne gc_cls_ctrl_lo;
        mov rax, 2;
        ret;

      gc_cls_ctrl_lo:
        // Control: 0x00..0x1F (CR and LF already matched out).
        cmp rdi, 0x1F;
        ja gc_cls_zwj;
        mov rax, 3;
        ret;

      gc_cls_zwj:
        // ZWJ (U+200D) -- short-circuit the single-cp case before
        // the Extend range check below.
        cmp rdi, 0x200D;
        jne gc_cls_extend;
        mov rax, 5;
        ret;

      gc_cls_extend:
        // Extend: U+0300..U+036F (combining diacritics for Latin
        // scripts; the reduced M2 baseline).
        cmp rdi, 0x0300;
        jb gc_cls_control_hi;
        cmp rdi, 0x036F;
        ja gc_cls_control_hi;
        mov rax, 4;
        ret;

      gc_cls_control_hi:
        // Control: 0x7F..0x9F (DEL + C1 controls). These are also
        // GB4/GB5 participants, so classify them as Control (3) and
        // the state machine will break around them.
        cmp rdi, 0x7F;
        jb gc_cls_ri;
        cmp rdi, 0x9F;
        ja gc_cls_ri;
        mov rax, 3;
        ret;

      gc_cls_ri:
        // Regional Indicator: U+1F1E6..U+1F1FF (26 letters A..Z used
        // as flag-emoji building blocks).
        cmp rdi, 0x1F1E6;
        jb gc_cls_pict;
        cmp rdi, 0x1F1FF;
        ja gc_cls_pict;
        mov rax, 6;
        ret;

      gc_cls_pict:
        // Pictographic: U+1F300..U+1F9FF. Simplified single-range
        // approximation of UCD emoji-data.txt's Extended_Pictographic
        // property for M2. The real property is a sparse set with
        // ~1500 code points, which M2.2 will land as a sorted range
        // table; the single range here covers the common emoji
        // supplement blocks (Symbols, Pictographs, Transport,
        // Supplemental Symbols and Pictographs, Supplemental
        // Pictographs) that account for every emoji in the M2
        // fingerprint goldens.
        cmp rdi, 0x1F300;
        jb gc_cls_other;
        cmp rdi, 0x1F9FF;
        ja gc_cls_other;
        mov rax, 7;
        ret;

      gc_cls_other:
        // Default: OTHER (0). Every code point not covered by the
        // seven branches above falls here. For a Latin baseline this
        // includes the entire BMP outside the four small ranges, plus
        // everything > U+1F9FF that isn't a flag RI.
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _gc_next(bytes_ptr, bytes_len, cursor_byte) -> packed_u64
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = cursor_byte
  //   rax = (next_cursor << 32) | status (0=OK, 1=EOF, 2=INVALID_UTF8)
  //
  // Advances the cursor by one grapheme cluster. The TR#29 state
  // machine implemented inline:
  //
  //   1. If cursor >= bytes_len, return EOF.
  //   2. Decode the lead code point at cursor via utf8_decode_cp.
  //      On the error band, return INVALID_UTF8 with cursor
  //      unchanged (bits [63:32]).
  //   3. Advance cursor by bytes_consumed, classify the lead to
  //      prop0, initialise the state packed in r15:
  //        byte 0 (ep_chain)  = (prop0 == PICTOGRAPHIC) ? 1 : 0
  //        byte 1 (zwj_armed) = 0
  //        byte 2 (ri_count)  = (prop0 == RI) ? 1 : 0
  //   4. Loop:
  //        a. If cursor >= bytes_len, return OK (GB2 break).
  //        b. Decode next cp. On error-band, return OK with current
  //           cursor (cluster ends just before the malformed byte;
  //           the caller's next invocation will see INVALID_UTF8 at
  //           its initial decode).
  //        c. Classify to prop1 (preserve bytes_consumed in r10
  //           across the classify call -- _gc_classify is a leaf we
  //           own and does not touch r10).
  //        d. Apply the TR#29 rule gates in order: GB3, GB4, GB5,
  //           GB9-Extend, GB9-ZWJ, GB11, GB12/13; GB6/7/8 (Hangul)
  //           stubbed; GB9a (SpacingMark) and GB9b (Prepend) empty.
  //           Each gate either advances cursor + updates state and
  //           continues the loop, or jumps to gc_next_ok (break).
  //
  // Register plan (five callee-save pushes; see alignment math below):
  //   rbx     = bytes_ptr (callee-save, preserved across every CALL)
  //   r12     = bytes_len (callee-save)
  //   r13     = cursor    (callee-save; mutates across loop)
  //   r14     = prop0     (callee-save)
  //   r15     = state packed as three bytes:
  //             bits [7:0]   ep_chain   (0 or 1)
  //             bits [15:8]  zwj_armed  (0 or 1)
  //             bits [23:16] ri_count   (0, 1, or 2)
  //             bits [63:24] unused (always 0)
  //
  // Alignment: entry rsp%16==8; five 8-byte pushes shift rsp by 40
  // bytes, so (8+40) mod 16 = 48 mod 16 = 0. Pre-nested-CALL
  // rsp%16==0 matches SysV requirement. No extra `sub rsp, N` pad.
  //
  // Labels prefixed gc_next_.
  // ==========================================================================
  pub let _gc_next : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (cursor_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): _gc_next advances cursor by one TR#29 (UAX #29 Rev 15 reduced-Latin+emoji) grapheme cluster. Seed-and-extend algorithm: decode cp at cursor via utf8_decode_cp; INVALID at seed returns status=2 with cursor unchanged; INVALID mid-cluster returns status=0 with cluster ending before the malformed byte. State: ep_chain in r15 byte 0 (lead was PICTOGRAPHIC and only Extend/ZWJ consumed since), zwj_armed in byte 1 (last consumed prop was ZWJ while ep_chain=1), ri_count in byte 2 (RI pair progress). Rules: GB3 (CR LF), GB4/5 (break around CR/LF/Control), GB9 (no break before Extend/ZWJ), GB11 (ZWJ-armed EP extends), GB12/13 (RI pairs). GB6/7/8 Hangul stubbed. GB9a/GB9b empty tables. GB999 default break. 5 callee-save pushes (rbx, r12, r13, r14, r15): entry rsp%16==8 + 40 bytes = (48 mod 16)=0 pre-CALL; matches SysV requirement for utf8_decode_cp and _gc_classify. State-byte clear masks (0xFFFFFFFFFFFF00FF, 0xFFFFFFFFFF00FFFF) are imm64 so staged via MOVABS into r11, then `and r15, r11` (reg-reg form; satisfies the no-and-imm64 rule). All cmp immediates <= 0x7FFFFFFF. No test; no and-imm64; no imul-r-imm; no byte load (utf8_decode_cp does it). Labels prefixed gc_next_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;              // rbx = bytes_ptr
        mov r12, rsi;              // r12 = bytes_len
        mov r13, rdx;               // r13 = cursor

        // ---- EOF check (GB2 at start) --------------------------------
        cmp r13, r12;
        jae gc_next_eof;

        // ---- Seed: decode cp at cursor -------------------------------
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Discriminate via bits [31:24]: 1..4 on success, 0xFF on
        // error band. See src/utf8.pdx module header "Caller
        // discrimination idiom".
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja gc_next_invalid;

        // r11 = bytes_consumed (1..4); rax >> 32 = cp.
        // Advance cursor past the seed cp.
        add r13, r11;

        // Classify the seed cp.
        mov rdi, rax;
        shr rdi, 32;
        call _gc_classify;
        mov r14, rax;              // r14 = prop0

        // Initialise state in r15 based on prop0.
        //   byte 0 (ep_chain)  = (prop0 == PICTOGRAPHIC) ? 1 : 0
        //   byte 1 (zwj_armed) = 0 (never armed at seed)
        //   byte 2 (ri_count)  = (prop0 == RI) ? 1 : 0
        xor r15, r15;
        cmp r14, 7;                // PICTOGRAPHIC
        jne gc_next_init_check_ri;
        add r15, 1;                // ep_chain = 1 in byte 0

      gc_next_init_check_ri:
        cmp r14, 6;                // RI
        jne gc_next_loop_top;
        // ri_count = 1 in byte 2 (bits 23:16); add 0x10000.
        mov r11, 0x10000;
        add r15, r11;

        // ============================================================
        // Extension loop: try to glue the next cp to the current cluster.
        // ============================================================
      gc_next_loop_top:
        // GB2: if cursor hit the end, cluster closes here with OK.
        cmp r13, r12;
        jae gc_next_ok;

        // Decode the candidate next cp.
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        // Mid-cluster INVALID: close the cluster here (OK) so the
        // next call to _gc_next sees INVALID at its seed decode.
        // See module header "RETURN SHAPES" for the recovery
        // semantics.
        ja gc_next_ok;

        // Preserve bytes_consumed across the classify call.
        // _gc_classify is a leaf we own and only touches rax/rcx/rdx/r11,
        // so r10 survives.
        mov r10, r11;              // r10 = next bytes_consumed

        mov rdi, rax;
        shr rdi, 32;
        call _gc_classify;
        // rax = prop1 (0..7); r10 = bytes_consumed; r14 = prop0;
        // r15 = packed state.

        // ---- GB3: CR x LF  (prop0==CR && prop1==LF -> no break) ----
        cmp r14, 1;                // CR
        jne gc_next_rule_gb4;
        cmp rax, 2;                // LF
        jne gc_next_rule_gb4;
        // Consume LF; prop0 becomes LF; state resets (LF cannot
        // participate in ep_chain / ri_count).
        add r13, r10;
        mov r14, rax;
        xor r15, r15;
        jmp gc_next_loop_top;

      gc_next_rule_gb4:
        // ---- GB4: break AFTER CR / LF / Control (prop0 is terminal) ----
        cmp r14, 1;
        je gc_next_ok;
        cmp r14, 2;
        je gc_next_ok;
        cmp r14, 3;
        je gc_next_ok;

        // ---- GB5: break BEFORE CR / LF / Control (prop1 is terminal) --
        cmp rax, 1;
        je gc_next_ok;
        cmp rax, 2;
        je gc_next_ok;
        cmp rax, 3;
        je gc_next_ok;

        // ---- GB9: x Extend  (no break before combining mark) ----
        cmp rax, 4;                // EXTEND
        jne gc_next_rule_gb9zwj;
        // Consume Extend. ep_chain stays (GB11 allows EP Extend*).
        // zwj_armed MUST be cleared: GB11 requires ZWJ IMMEDIATELY
        // before the second EP; an Extend between a ZWJ and the next
        // EP kills the GB11 opportunity.
        add r13, r10;
        mov r14, rax;
        mov r11, 0xFFFFFFFFFFFF00FF;  // mask: clear byte 1 (zwj_armed)
        and r15, r11;
        jmp gc_next_loop_top;

      gc_next_rule_gb9zwj:
        // ---- GB9: x ZWJ  (no break before zero-width joiner) ----
        cmp rax, 5;                // ZWJ
        jne gc_next_rule_gb11;
        add r13, r10;
        mov r14, rax;
        // If ep_chain (byte 0) is set, arm zwj (set byte 1 to 1);
        // else leave zwj_armed cleared.
        mov rcx, r15;
        and rcx, 0xFF;
        cmp rcx, 1;
        jne gc_next_zwj_clear_arm;
        // ep_chain=1 branch: set zwj_armed=1 (clear byte 1, then add 0x100).
        mov r11, 0xFFFFFFFFFFFF00FF;
        and r15, r11;
        add r15, 0x100;
        jmp gc_next_loop_top;
      gc_next_zwj_clear_arm:
        // ep_chain=0 branch: ensure zwj_armed=0.
        mov r11, 0xFFFFFFFFFFFF00FF;
        and r15, r11;
        jmp gc_next_loop_top;

      gc_next_rule_gb11:
        // ---- GB11: (EP Extend*) ZWJ x EP  (emoji ZWJ sequence) ----
        cmp rax, 7;                // PICTOGRAPHIC
        jne gc_next_rule_gb12;
        // Check zwj_armed (byte 1 of r15).
        mov rcx, r15;
        shr rcx, 8;
        and rcx, 0xFF;
        cmp rcx, 1;
        jne gc_next_ok;            // zwj_armed=0 => GB11 doesn't fire
        // GB11 fires: consume EP, reset state to (ep_chain=1,
        // zwj_armed=0, ri_count=0) -- the new EP starts a fresh
        // potential chain.
        add r13, r10;
        mov r14, rax;
        mov r15, 1;                // ep_chain=1, zwj_armed=0, ri_count=0
        jmp gc_next_loop_top;

      gc_next_rule_gb12:
        // ---- GB12 / GB13: RI pairs  (even-count RIs glue, odd break) ----
        cmp rax, 6;                // RI
        jne gc_next_rule_other;
        // Fire ONLY if prop0==RI and ri_count==1 (odd so far, pair completing).
        cmp r14, 6;
        jne gc_next_ok;
        mov rcx, r15;
        shr rcx, 16;
        and rcx, 0xFF;
        cmp rcx, 1;
        jne gc_next_ok;
        // Pair completes: consume RI, bump ri_count to 2.
        add r13, r10;
        mov r14, rax;
        // Clear byte 2 of r15, then add 0x20000 to set ri_count=2.
        mov r11, 0xFFFFFFFFFF00FFFF;
        and r15, r11;
        mov r11, 0x20000;
        add r15, r11;
        jmp gc_next_loop_top;

      gc_next_rule_other:
        // ---- GB999: default break ----
        // No rule matched; cluster closes at the current cursor.
        jmp gc_next_ok;

        // ============================================================
        // Exits
        // ============================================================
      gc_next_ok:
        // Pack: rax = (r13 << 32) | 0.
        mov rax, r13;
        shl rax, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gc_next_eof:
        // Pack: rax = (r13 << 32) | 1. r13 == cursor_byte which
        // equals bytes_len on EOF entry; still, pack it faithfully.
        mov rax, r13;
        shl rax, 32;
        add rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gc_next_invalid:
        // Pack: rax = (r13 << 32) | 2. r13 is unchanged (we never
        // advanced on the failed seed decode), so bits [63:32] carry
        // the input cursor -- the caller may skip past the offending
        // byte and retry.
        mov rax, r13;
        shl rax, 32;
        add rax, 2;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _gc_count(bytes_ptr, bytes_len) -> u64 | GC_INVALID_UTF8
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rax = cluster count on success, GC_INVALID_UTF8 (0xFFFFE710) on
  //         malformed input.
  //
  // Walks the input one cluster at a time by repeated _gc_next
  // calls, incrementing a counter per successful OK status. Mirrors
  // utf8_count_cp's `wc -m`-style refusal: partial count discarded
  // on INVALID_UTF8.
  //
  // Register plan (four callee-save pushes + alignment pad):
  //   rbx     = bytes_ptr (callee-save)
  //   r12     = bytes_len (callee-save)
  //   r13     = cursor    (callee-save)
  //   r14     = count     (callee-save)
  //
  // Alignment: entry rsp%16==8; four 8-byte pushes shift rsp by 32,
  // so (8+32) mod 16 = 40 mod 16 = 8. Add `sub rsp, 8` to reach
  // rsp%16==0 pre-nested-CALL. Pop the pad before returning.
  //
  // Labels prefixed gc_cnt_.
  // ==========================================================================
  pub let _gc_count : (u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): _gc_count walks the input via _gc_next and returns the cluster count. 4 callee-save pushes (rbx, r12, r13, r14) + sub rsp 8 pad gives rsp%16==0 pre-CALL (SysV requirement). Status discrimination: low 8 bits of _gc_next's rax hold the status (0/1/2); extract via `mov rcx, rax; and rcx, 0xFF`; cmp to 1 for EOF (return count), cmp to 2 for INVALID (return GC_INVALID_UTF8). On OK, extract next_cursor via `shr rax, 32`, assign to r13, bump r14, loop. Encoder: no test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed gc_cnt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;                // alignment pad for nested CALL

        mov rbx, rdi;              // rbx = bytes_ptr
        mov r12, rsi;              // r12 = bytes_len
        xor r13, r13;              // r13 = cursor = 0
        xor r14, r14;              // r14 = count = 0

      gc_cnt_loop_top:
        // Call _gc_next(bytes_ptr, bytes_len, cursor).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _gc_next;

        // Extract status (low 8 bits).
        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 1;
        je gc_cnt_done;
        cmp rcx, 2;
        je gc_cnt_invalid;

        // OK: extract next_cursor and advance; bump count.
        shr rax, 32;
        mov r13, rax;
        add r14, 1;
        jmp gc_cnt_loop_top;

      gc_cnt_done:
        mov rax, r14;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gc_cnt_invalid:
        mov rax, 0xFFFFE710;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

}
