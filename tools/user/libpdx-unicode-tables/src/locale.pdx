// src/locale.pdx -- libpdx-unicode-tables.M7 (paideia-os#2618, R131.M7)
//
// Locale: user-space BCP 47 locale registry substrate.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx locale-registry surface the shell, pds and the
// GPU-native terminal link whenever a text operation whose answer depends
// on cultural policy (collation order, bidi direction, UAX #11 ambiguous
// width handling) must be parameterised by the ambient user locale. Four
// public entry points:
//
//   _locale_parse(tag_ptr, tag_len)              -> packed u64
//   _locale_default()                            -> u64
//   _locale_direction(locale_id)                 -> u64
//   _locale_width_ambiguous_is_wide(locale_id)   -> u64
//
// `_locale_parse` normalises a BCP 47 `language[-REGION]` tag (the only
// shape M7 accepts) and returns a packed u64:
//
//   bits [63:8]  locale_id  (0..7 at M7)
//   bits [7:0]   status     (0=OK, 1=UNKNOWN, 2=MALFORMED)
//
// `_locale_default` returns the canonical fallback locale_id (0 = C /
// POSIX). This is the locale a consumer uses when it has no ambient
// preference to consult (headless build output, test harness, pre-login
// shell prompt). The default is designed to make every policy knob
// deterministic without reference to any environment variable.
//
// `_locale_direction(id)` returns 0 (LTR) or 1 (RTL) -- the dominant
// writing direction for the locale. Six of the eight baseline locales are
// LTR (C, en-US, en-GB, ja-JP, zh-CN, ko-KR); two are RTL (he-IL, ar-SA).
// The bidi run reorderer (M6 `_bidi_runs`) uses this value to pick the
// paragraph direction when the input has no strong-direction run.
//
// `_locale_width_ambiguous_is_wide(id)` returns 0 (narrow) or 1 (wide):
// the UAX #11 ambiguous-class policy. East Asian locales (ja-JP, zh-CN,
// ko-KR) widen ambiguous code points to 2 columns to match historical
// terminal behaviour; every other locale treats them as narrow (1). This
// is the knob the width-aware consumer (`_width_char_lc`, landing at
// M7.1 alongside the UAX #11 ambiguous table) will dispatch on.
//
// =============================================================================
// REDUCED LOCALE REGISTRY (R131.M7 baseline -- 8 locales)
// =============================================================================
//
// Eight entries at M7, covering the three directional / width axes that
// the dependent primitives (bidi, width, collation) can actually observe
// at this milestone:
//
//   id  tag      direction  ambiguous-wide
//   --  -----    ---------  --------------
//   0   C/POSIX  LTR (0)    narrow (0)       -- default
//   1   en-US    LTR (0)    narrow (0)
//   2   en-GB    LTR (0)    narrow (0)
//   3   ja-JP    LTR (0)    wide (1)
//   4   zh-CN    LTR (0)    wide (1)
//   5   ko-KR    LTR (0)    wide (1)
//   6   he-IL    RTL (1)    narrow (0)
//   7   ar-SA    RTL (1)    narrow (0)
//
// Every locale_id in [0, 8) is well-defined on every policy accessor.
// IDs >= 8 fall back to the default (LTR, narrow); the public API treats
// unknown IDs as the default rather than returning an error band, matching
// the "treat UNKNOWN as default" convention used by every policy module
// in the paideia-os tree. A fail-fast caller that wants to reject unknown
// IDs can gate on `_locale_parse` returning status=0 before using the id.
//
// =============================================================================
// BCP 47 SUBSET PARSER (M7 scope)
// =============================================================================
//
// `_locale_parse` accepts the strict shape `xx-YY` only -- the five-byte
// `language[-REGION]` form with exactly a 2-letter language code, a
// literal '-' separator at byte offset 2, and a 2-letter region. Both
// subtags are case-insensitive: the parser lowercases the language bytes
// (A..Z -> a..z) and uppercases the region bytes (a..z -> A..Z) before
// comparing against the registry, so inputs like "en-us", "EN-US",
// "En-Us" all canonicalise to the same registry key.
//
// Length and separator failures land as MALFORMED (status=2):
//
//   * `tag_len != 5`          -> MALFORMED
//   * `tag[2] == '_'`         -> MALFORMED (classic POSIX separator;
//                                explicitly refused so a caller passing
//                                `en_US` from a getenv() LANG value gets
//                                a loud diagnostic rather than a silent
//                                UNKNOWN that the user cannot distinguish
//                                from a typo)
//   * `tag[2] != '-'`         -> MALFORMED (every other separator)
//
// A well-formed 5-byte `xx-YY` that does not match any registry entry
// returns UNKNOWN (status=1, locale_id=0): the parser treats it as a
// recognised shape with an unknown identity, letting the caller fall
// back to the default locale cleanly.
//
// Deferred shapes (land at M7.1+):
//
//   * `language` alone (2 or 3 bytes, no region)
//   * 3-letter language (ISO 639-3, `iw-IL`-style legacy)
//   * Script subtag (`sr-Cyrl-RS`)
//   * Variant / extension subtags (`de-CH-1996`, `en-US-u-ca-gregory`)
//
// Each of these is MALFORMED at M7 (`tag_len != 5` fires before any
// subtag parsing). The design doc at design/toolchain/libpdx-unicode-
// locale.md tracks the roadmap.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// `_locale_parse` -> packed u64:
//
//   bits [63:8]  locale_id  (0..7 on success; 0 on UNKNOWN or MALFORMED)
//   bits [7:0]   status     (0=OK, 1=UNKNOWN, 2=MALFORMED)
//
// Status 1 (UNKNOWN) is a soft failure: the tag was well-formed but did
// not match any entry; the caller may silently fall back to the default
// locale. Status 2 (MALFORMED) is a hard failure: the tag violates the
// `xx-YY` shape; the caller should surface this to the user.
//
// `_locale_default` -> u64. Returns 0 (C / POSIX). No error band -- the
// default locale is always well-defined.
//
// `_locale_direction` -> u64 in {0, 1}. Returns 0 (LTR) for every id
// outside the baseline registry; this is a soft fallback matching the
// "unknown id behaves like default" convention described above.
//
// `_locale_width_ambiguous_is_wide` -> u64 in {0, 1}. Returns 0 (narrow)
// for every id outside the baseline registry.
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- the parser builds its 4-byte key via `shl +
//     add` of lowercased / uppercased bytes; no mask is applied.
//   - No 2-op `imul r, imm`; every arithmetic step is `shl imm8 / add`.
//   - No multiline `pub let = "..."` -- single-line only.
//   - Module basename `Locale` matches `locale.pdx` (verified at write-time).
//   - Labels prefixed `locale_` (never `loop`/`if`/`let`/`fn` -- reserved).
//   - All `cmp reg, imm` immediates <= 0x53556E65 (the "en-US" key value;
//     0x53556E65 < 0x80000000 so direct `cmp reg, imm32` is sign-extension-
//     safe (imm == (imm as i32 as i64))). No MOVABS staging needed for the
//     keys or for any status / id constant.
//   - All byte loads via `mov_b` (zero-extends into the full qword);
//     bytes are 0..0xFF so no sign-extension concern.
//   - Entry rsp%16==8 preserved per SysV; every public entry point is a
//     pure leaf (no nested CALL) so no callee-save push or stack-scratch
//     is required.
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// FURTHER WORK (not landed here; tracked in STATUS.md + design doc)
// =============================================================================
//
//   M7.1  Language-only parse (`en`, `ja`, `he`). Add the 2-byte and
//         3-byte prefix path; each language maps to its first-registry-
//         match locale (en -> en-US, ja -> ja-JP, etc). Needed before
//         environment-variable passthrough (`LANG=en`) stops surfacing
//         MALFORMED on an otherwise legal POSIX value.
//   M7.2  Script subtag (`sr-Cyrl-RS`). Three-subtag form adds script
//         awareness between language and region. Rare in M7 consumer
//         sites but needed for the vfx shell's RTL preview mode.
//   M7.3  Variant subtags (`de-CH-1996`). Pre-reform / post-reform
//         German locale split. M7.3 target when the vfx variant
//         picker lands.
//   M7.4  Full locale axis set (ambiguous-wide, decimal separator,
//         grouping separator, currency symbol, first-day-of-week).
//         The M7 baseline exposes only direction + ambiguous-wide;
//         the full axis set lands incrementally alongside each
//         consumer site that needs it.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612
// (M1 UTF-8), paideia-os#2613 (M2 grapheme), paideia-os#2614 (M3
// normalize), paideia-os#2615 (M4 collation), paideia-os#2616 (M5
// width), paideia-os#2617 (M6 bidi), paideia-os#2618 (THIS M7
// ticket). Design doc: design/toolchain/libpdx-unicode-locale.md.

module Locale = structure {

  // ==========================================================================
  // SECTION 1 -- LOCALE_ID CONSTANTS (returned in bits [63:8] of _locale_parse)
  // ==========================================================================
  //
  // Eight values at M7. The ids are small non-negative integers used as
  // table indices and compare operands; a status byte travels in the low
  // 8 bits of the packed return beneath them. The default id (0) is
  // literally the fall-through on every policy accessor and so does not
  // require a dedicated branch at the call site.

  pub let LOCALE_C      : u64 = 0
  pub let LOCALE_EN_US  : u64 = 1
  pub let LOCALE_EN_GB  : u64 = 2
  pub let LOCALE_JA_JP  : u64 = 3
  pub let LOCALE_ZH_CN  : u64 = 4
  pub let LOCALE_KO_KR  : u64 = 5
  pub let LOCALE_HE_IL  : u64 = 6
  pub let LOCALE_AR_SA  : u64 = 7

  pub let LOCALE_REGISTRY_LEN : u64 = 8

  // ==========================================================================
  // SECTION 2 -- STATUS CODES (returned in low 8 bits of _locale_parse's rax)
  // ==========================================================================
  //
  // Three disjoint values at M7. The status byte sits beneath the
  // locale_id in the packed return; a shift by 8 recovers the id and a
  // mask with 0xFF recovers the status. UNKNOWN and MALFORMED both carry
  // locale_id=0 so a caller that ignores status and uses the id directly
  // still gets the default-locale fallback behaviour.

  pub let LOCALE_STATUS_OK        : u64 = 0
  pub let LOCALE_STATUS_UNKNOWN   : u64 = 1
  pub let LOCALE_STATUS_MALFORMED : u64 = 2

  // ==========================================================================
  // SECTION 3 -- DIRECTION CONSTANTS (returned by _locale_direction)
  // ==========================================================================

  pub let LOCALE_DIR_LTR : u64 = 0
  pub let LOCALE_DIR_RTL : u64 = 1

  // ==========================================================================
  // SECTION 4 -- AMBIGUOUS WIDTH CONSTANTS (returned by _locale_width_...)
  // ==========================================================================

  pub let LOCALE_AMBIG_NARROW : u64 = 0
  pub let LOCALE_AMBIG_WIDE   : u64 = 1

  // ==========================================================================
  // SECTION 5 -- ERROR BAND 0xFFFFE770..0xFFFFE77F (M7, locale)
  // ==========================================================================
  //
  // Seventh 16-wide aligned user-space error-code slice taken by this
  // library (R131.M7, paideia-os#2618). Zero slots used at M7: the
  // public API encodes all three status codes (0/1/2) in the low 8 bits
  // of the packed return rather than returning a raw band value. The
  // slice is reserved for later locale-layer error kinds (e.g.
  // LOCALE_TAG_TOO_LONG once length-flexible tags land at M7.2, or
  // LOCALE_REGISTRY_FULL if the registry becomes caller-populated at
  // M7.5). Disjoint from every other user-space band in the paideia-os
  // tree. Grep confirmation at M7 landing time:
  //
  //   grep -rE '0xFFFFE77[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no hits outside caps.decl at landing.
  //
  // The internal band is a documented placeholder; no public constant
  // in this file exports it. Future error kinds land as
  // `pub let LOCALE_* : u64 = 0xFFFFE77X` additions.

  // ==========================================================================
  // SECTION 6 -- REGISTRY KEYS (packed u32 per canonicalised tag)
  // ==========================================================================
  //
  // Each key is a 32-bit value computed from the canonicalised tag:
  //
  //   key = lang[0] | (lang[1] << 8) | (region[0] << 16) | (region[1] << 24)
  //
  // where lang bytes are lowercased (a..z) and region bytes are uppercased
  // (A..Z). The constants below record each registry entry's key for
  // reference; `_locale_parse` compares the computed key against each
  // constant inline rather than iterating a table (seven comparisons for
  // seven keyed entries; the eighth entry -- C / POSIX -- is never
  // reached from the parser because its canonical tag is not `xx-YY`).

  pub let LOCALE_KEY_EN_US : u64 = 0x53556E65   // "e"|"n"<<8|"U"<<16|"S"<<24
  pub let LOCALE_KEY_EN_GB : u64 = 0x42476E65   // "e"|"n"<<8|"G"<<16|"B"<<24
  pub let LOCALE_KEY_JA_JP : u64 = 0x504A616A   // "j"|"a"<<8|"J"<<16|"P"<<24
  pub let LOCALE_KEY_ZH_CN : u64 = 0x4E43687A   // "z"|"h"<<8|"C"<<16|"N"<<24
  pub let LOCALE_KEY_KO_KR : u64 = 0x524B6F6B   // "k"|"o"<<8|"K"<<16|"R"<<24
  pub let LOCALE_KEY_HE_IL : u64 = 0x4C496568   // "h"|"e"<<8|"I"<<16|"L"<<24
  pub let LOCALE_KEY_AR_SA : u64 = 0x41537261   // "a"|"r"<<8|"S"<<16|"A"<<24

  // ==========================================================================
  // _locale_parse(tag_ptr, tag_len) -> packed_u64
  //
  //   rdi = tag_ptr   (pointer to the tag's first byte)
  //   rsi = tag_len   (length in bytes; must be 5 for M7)
  //   rax = (locale_id << 8) | status
  //         status in {0=OK, 1=UNKNOWN, 2=MALFORMED}
  //
  // Validates the strict `xx-YY` five-byte shape, canonicalises the
  // tag's language and region subtags (language lowercased, region
  // uppercased), packs them into a 4-byte key, and dispatches over
  // seven known keys. On match returns `(id << 8)`; on no-match returns
  // 1 (UNKNOWN); on length / separator failure returns 2 (MALFORMED).
  //
  // Pure leaf. No callee-save push. All scratch is caller-save
  // (rax, rcx, r10). Labels prefixed locale_p_.
  // ==========================================================================
  pub let _locale_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (tag_ptr: u64) (tag_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): _locale_parse validates the strict xx-YY five-byte BCP 47 subset: length==5, byte[2]=='-' (explicitly rejects '_' with MALFORMED to surface POSIX-style separators as a loud diagnostic), lowercases language bytes (A..Z -> +0x20), uppercases region bytes (a..z -> -0x20), packs lang[0]|(lang[1]<<8)|(reg[0]<<16)|(reg[1]<<24) into a 4-byte key, dispatches over seven known keys (en-US, en-GB, ja-JP, zh-CN, ko-KR, he-IL, ar-SA) returning (id<<8). Any other 5-byte xx-YY input returns status=1 (UNKNOWN); any length/separator failure returns status=2 (MALFORMED). All seven key constants are <= 0x53556E65 < 0x80000000 so direct `cmp reg, imm32` is sign-extension-safe (imm == (imm as i32 as i64)). ASCII constants (0x20, 0x2D, 0x41, 0x5A, 0x5F, 0x61, 0x7A) fit imm8. Pure leaf; no callee-save push; no stack frame; no nested CALL. No test; no and-imm64; no imul-r-imm. Byte loads via mov_b. Labels prefixed locale_p_.",
      block: {
        // ---- Gate 0: tag_len must be exactly 5 ----
        cmp rsi, 5;
        jne locale_p_malformed;

        // ---- Gate 1: byte[2] must be '-' (0x2D); '_' (0x5F) is a
        //      hard failure (classic POSIX separator; refuse loudly
        //      so a caller cannot confuse MALFORMED with UNKNOWN).
        mov_b rax, [rdi + 2];
        cmp rax, 0x5F;
        je  locale_p_malformed;
        cmp rax, 0x2D;
        jne locale_p_malformed;

        // ---- Build the 4-byte canonical key in r10. ----
        //
        // byte[0]: lowercase if 'A'..'Z'.
        mov_b rax, [rdi + 0];
        cmp rax, 0x41;
        jb  locale_p_b0_done;
        cmp rax, 0x5A;
        ja  locale_p_b0_done;
        add rax, 0x20;
      locale_p_b0_done:
        mov r10, rax;

        // byte[1]: lowercase if 'A'..'Z'; shift 8 and merge.
        mov_b rax, [rdi + 1];
        cmp rax, 0x41;
        jb  locale_p_b1_done;
        cmp rax, 0x5A;
        ja  locale_p_b1_done;
        add rax, 0x20;
      locale_p_b1_done:
        shl rax, 8;
        add r10, rax;

        // byte[3]: uppercase if 'a'..'z'; shift 16 and merge.
        mov_b rax, [rdi + 3];
        cmp rax, 0x61;
        jb  locale_p_b3_done;
        cmp rax, 0x7A;
        ja  locale_p_b3_done;
        sub rax, 0x20;
      locale_p_b3_done:
        shl rax, 16;
        add r10, rax;

        // byte[4]: uppercase if 'a'..'z'; shift 24 and merge.
        mov_b rax, [rdi + 4];
        cmp rax, 0x61;
        jb  locale_p_b4_done;
        cmp rax, 0x7A;
        ja  locale_p_b4_done;
        sub rax, 0x20;
      locale_p_b4_done:
        shl rax, 24;
        add r10, rax;

        // ---- Dispatch over registry keys ----
        cmp r10, 0x53556E65;
        jne locale_p_try_en_gb;
        mov rax, 0x100;             // (1 << 8) | 0
        ret;

      locale_p_try_en_gb:
        cmp r10, 0x42476E65;
        jne locale_p_try_ja_jp;
        mov rax, 0x200;             // (2 << 8) | 0
        ret;

      locale_p_try_ja_jp:
        cmp r10, 0x504A616A;
        jne locale_p_try_zh_cn;
        mov rax, 0x300;             // (3 << 8) | 0
        ret;

      locale_p_try_zh_cn:
        cmp r10, 0x4E43687A;
        jne locale_p_try_ko_kr;
        mov rax, 0x400;             // (4 << 8) | 0
        ret;

      locale_p_try_ko_kr:
        cmp r10, 0x524B6F6B;
        jne locale_p_try_he_il;
        mov rax, 0x500;             // (5 << 8) | 0
        ret;

      locale_p_try_he_il:
        cmp r10, 0x4C496568;
        jne locale_p_try_ar_sa;
        mov rax, 0x600;             // (6 << 8) | 0
        ret;

      locale_p_try_ar_sa:
        cmp r10, 0x41537261;
        jne locale_p_unknown;
        mov rax, 0x700;             // (7 << 8) | 0
        ret;

      locale_p_unknown:
        // Well-formed shape, no registry match -> UNKNOWN
        // (locale_id=0, status=1).
        mov rax, 1;
        ret;

      locale_p_malformed:
        // Length / separator failure -> MALFORMED
        // (locale_id=0, status=2).
        mov rax, 2;
        ret;
      }
    }

  // ==========================================================================
  // _locale_default() -> u64
  //
  //   rax = default locale_id (0 = C / POSIX)
  //
  // The canonical fallback locale when a consumer has no ambient
  // preference to consult. 0 is literally the default on every policy
  // accessor's unknown-id fall-through branch, so a consumer that uses
  // this id gets the same answer as a consumer that passes an unknown
  // id to the accessors directly.
  //
  // Pure leaf. No callee-save push. Labels prefixed locale_d_.
  // ==========================================================================
  pub let _locale_default : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): _locale_default returns 0 (C / POSIX) as the canonical fallback locale. Pure leaf; no callee-save push; no stack frame. No test; no and-imm64; no imul; no byte load.",
      block: {
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _locale_direction(locale_id) -> u64
  //
  //   rdi = locale_id (any u64; ids outside [0, 8) fall through to LTR)
  //   rax = 0 (LTR) or 1 (RTL)
  //
  // At M7 the two RTL locales are he-IL (id=6) and ar-SA (id=7); every
  // other id -- including unknown ids above 7 -- is LTR. The range
  // dispatch encodes the RTL window as [6, 7] inclusive so an unknown
  // id above 7 cleanly falls through to the LTR default.
  //
  // Pure leaf. Labels prefixed locale_dir_.
  // ==========================================================================
  pub let _locale_direction : (u64) -> u64 !{} @{} =
    fn (locale_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): _locale_direction returns 1 (RTL) iff locale_id in {6, 7} (he-IL, ar-SA); 0 (LTR) otherwise. Range dispatch via two cmp against imm8-safe constants (6 and 7). Pure leaf; no callee-save push; no stack frame. No test; no and-imm64; no imul; no byte load.",
      block: {
        cmp rdi, 6;
        jb  locale_dir_ltr;
        cmp rdi, 7;
        ja  locale_dir_ltr;
        mov rax, 1;
        ret;

      locale_dir_ltr:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _locale_width_ambiguous_is_wide(locale_id) -> u64
  //
  //   rdi = locale_id (any u64; ids outside [0, 8) fall through to narrow)
  //   rax = 0 (narrow) or 1 (wide)
  //
  // At M7 the three wide-ambiguous locales are ja-JP (id=3), zh-CN (id=4),
  // and ko-KR (id=5); every other id falls through to narrow (the UAX #11
  // Rev. 36 default for the non-East-Asian locales). The range dispatch
  // encodes the wide window as [3, 5] inclusive.
  //
  // The downstream `_width_char_lc(cp, locale)` entry point (landing at
  // M7.1 alongside the UAX #11 ambiguous table) dispatches on this value
  // to decide whether an ambiguous-class code point contributes 1 or 2
  // columns to the display-width sum.
  //
  // Pure leaf. Labels prefixed locale_w_.
  // ==========================================================================
  pub let _locale_width_ambiguous_is_wide : (u64) -> u64 !{} @{} =
    fn (locale_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-unicode-tables.M7 (#2618): _locale_width_ambiguous_is_wide returns 1 (wide) iff locale_id in {3, 4, 5} (ja-JP, zh-CN, ko-KR); 0 (narrow) otherwise. Range dispatch via two cmp against imm8-safe constants (3 and 5). Pure leaf; no callee-save push; no stack frame. No test; no and-imm64; no imul; no byte load.",
      block: {
        cmp rdi, 3;
        jb  locale_w_narrow;
        cmp rdi, 5;
        ja  locale_w_narrow;
        mov rax, 1;
        ret;

      locale_w_narrow:
        xor rax, rax;
        ret;
      }
    }

}
