// src/collation.pdx -- libpdx-unicode-tables.M4 (paideia-os#2615, R131.M4)
//
// Collation: Unicode Collation Algorithm (UTS #10, "UCA") baseline.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The paideia-os-side .pdx analog of a UCA-level string-ordering primitive.
// Two public entry points share the same packed-return idiom as the rest of
// the library:
//
//   _coll_compare(a_ptr, a_len, b_ptr, b_len) -> i64
//     Returns -1 / 0 / 1 (as a signed 64-bit value: 0xFFFFFFFFFFFFFFFF for
//     -1, 0 for equal, 1 for a > b). The ordering is lexicographic by UCA
//     sort key under the reduced DUCET encoded below.
//
//   _coll_sort_key(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed u64
//     Materialises the UCA sort key (a binary blob suitable for byte-wise
//     memcmp) to the caller buffer. Returns (out_bytes_written << 32) |
//     status with status in {0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8}.
//
// =============================================================================
// REDUCED DUCET SCOPE (R131.M4 ASCII + Latin-combining baseline)
// =============================================================================
//
// The full DUCET (allkeys.txt in Unicode 15.1.0) is ~27,000 entries. The
// M4 baseline encodes a reduced set sufficient for shell / pds / terminal
// sort correctness on Western text where the common cases are:
//
//   * ASCII printable U+0020..U+007E
//     - Space, punctuation and digits get distinct L1 bands that sort BEFORE
//       letters (consistent with UCA DUCET's broad weight bands).
//     - Letters A-Z and a-z share L1 within each case (so 'a' and 'A' are
//       equivalent at L1).  Case distinction appears at L3: lowercase
//       0x0002, uppercase 0x0008 (lowercase < uppercase per TR#10 §7.3).
//     - L2 for every ASCII code point is 0x0020 (COMMON).
//
//   * Combining marks U+0300..U+036F
//     - All have L1 == 0 (contribute nothing to primary order).
//     - L2 depends on the specific mark (13 explicit entries, default 0x0040).
//     - L3 == 0x0002.
//     This is what gives "á" (NFD = 'a' + U+0301) its L1-tied-with-'a'
//     but L2-higher-than-'a' sort position, exactly as UCA §7.3 requires.
//
//   * Latin-1 Supplement U+00A0..U+00FF and Latin Extended-A U+0100..U+017F
//     (non-decomposing code points only)
//     - Letters that DO decompose canonically (e.g. U+00E1 'á' -> 'a' + U+0301,
//       U+0107 'ć' -> 'c' + U+0301) never reach the classifier because
//       the pipeline runs NFD first; they appear only as base + mark pairs
//       which the ASCII and combining-mark paths handle.
//     - Letters that do NOT decompose canonically (Æ, Ø, Ð, þ, ß, Đ, Ħ, ı,
//       Ł, ŋ, Œ, Ŧ, etc.) fall into a FALLBACK L1 band placed strictly
//       above every ASCII letter.  They sort by code-point order among
//       themselves.  A full-DUCET landing (M4.2) places each in its proper
//       UCA position.
//
// SCRIPTS and FEATURES explicitly DEFERRED to M4.2+ follow-ups (tracked in
// STATUS.md and the design doc at design/toolchain/libpdx-unicode-collation.md):
//
//   * CJK Unified Ideographs (U+4E00..U+9FFF, U+3400..U+4DBF, U+20000..U+2A6DF
//     etc.): need the DUCET implicit-weight algorithm (TR#10 §10) or the
//     pinyin/radical-stroke tailoring. Deferred to M4.2 (basic implicit
//     weights) and M4.3 (pinyin tailoring).
//   * Hangul (U+1100..U+11FF Jamos, U+AC00..U+D7A3 Syllables): need the
//     per-TR#10 §7.1.5 Hangul-specific weighting; deferred to M4.2.
//   * Bidi/RTL (Arabic U+0600..U+06FF, Hebrew U+0590..U+05FF): currently
//     fall into the generic Latin-Ext-and-above fallback, which keeps them
//     consistent-but-not-locale-correct.  Full bidi collation lands at M4.3.
//   * Devanagari (U+0900..U+097F), Thai (U+0E00..U+0E7F), and other
//     complex-shaping scripts: same posture as Arabic/Hebrew; M4.3 target.
//   * Locale tailorings (CLDR root -> per-locale deltas): the baseline is
//     the DUCET root collation only.  Per-locale (e.g. Swedish-tailored
//     á sorts after z instead of as a diacritic of a) tailoring is M4.4.
//   * Variable-weighting (shifted, blanked, non-ignorable at L4 for
//     punctuation and whitespace): deferred.  M4 produces only L1/L2/L3
//     weights.
//   * Case-level (L2.5): deferred.  Case information is folded into L3
//     at M4; a separate L2.5 fine-grain case level is M4.4.
//
// =============================================================================
// UCA PIPELINE (reduced, 4 phases)
// =============================================================================
//
// The implementation follows TR#10 Rev. 46 (unicode.org/reports/tr10) adapted
// for the reduced DUCET above.  Four phases per call:
//
//   1. Normalize to NFD (call M3's _norm_nfd).  Decomposing á to a + U+0301
//      lets the collation elements fall out directly from the per-code-point
//      classifier; without this step, we would need a precomposed-cp table
//      sized at the Latin-1 + Latin-Ext-A canonical decomposables (161
//      additional entries).  NFD normalisation to a scratch buffer is the
//      cheaper option because the normalize library is already linked.
//
//   2. Build Collation Elements: walk the NFD byte stream one code point at
//      a time via utf8_decode_cp; for each cp, call _coll_classify to
//      produce a packed (L1, L2, L3) triple and append it to the CE scratch.
//      One CE per code point (no many-to-one contractions at M4).
//
//   3. Form sort key: walk the CE array three times (one per level), writing
//      each level's non-zero weights as big-endian u16s to the output buffer,
//      with a u16 0x0000 separator between consecutive levels.  Zero weights
//      are omitted (they would otherwise collide with the level separator).
//
//   4. Compare keys byte-wise (compare path only): read-only memcmp over the
//      min of the two keys' lengths, with "shorter key wins" as the final
//      tiebreaker.  Returns -1 / 0 / 1 as an i64 (-1 is 0xFFFFFFFFFFFFFFFF).
//
// Example walk-through: NFC "á" (0xC3 0xA1) and ASCII "a" (0x61):
//
//   NFD("á")       -> 'a' + U+0301  (2 code points)
//   CEs            -> (0x1C00, 0x0020, 0x0002), (0, 0x0024, 0x0002)
//   Key("á") L1    -> 1C 00
//            sep   -> 00 00
//            L2    -> 00 20 00 24
//            sep   -> 00 00
//            L3    -> 00 02 00 02
//                     (14 bytes total)
//
//   NFD("a")       -> 'a'           (1 code point)
//   CEs            -> (0x1C00, 0x0020, 0x0002)
//   Key("a") L1    -> 1C 00
//            sep   -> 00 00
//            L2    -> 00 20
//            sep   -> 00 00
//            L3    -> 00 02
//                     (10 bytes total)
//
//   Byte-wise memcmp: the keys agree on the first 6 bytes; byte 6 of "a"
//   is 0x00 (the L2->L3 separator) while byte 6 of "á" is 0x00 (continuing
//   the L2 stream with the second entry).  Both are 0x00, continue.  Byte
//   7 of "a" is 0x00 (continuing the separator) while byte 7 of "á" is
//   0x24 (the mark's L2).  0x00 < 0x24 so "a" < "á".
//
// =============================================================================
// SCRATCH BUFFERS + REENTRANCY
// =============================================================================
//
// The pipeline uses four static .bss buffers:
//
//   _coll_nfd_scratch     4096 bytes -- NFD output from phase 1 (feeds phase 2).
//   _coll_ce_scratch      8192 bytes -- 1024 CE entries x 8 bytes each.
//   _coll_key_a_scratch   8192 bytes -- compare path: sort key of a.
//   _coll_key_b_scratch   8192 bytes -- compare path: sort key of b.
//
// Per-CE layout in _coll_ce_scratch:
//
//   bits [15:0]   L3   (0..0xFFFF)
//   bits [31:16]  L2   (0..0xFFFF)
//   bits [47:32]  L1   (0..0xFFFF)
//   bits [63:48]  reserved (zero)
//
// REENTRANCY: this library is SINGLE-THREADED by construction (shell, pds,
// terminal all run ring-3 on a single thread).  Overlapping calls -- including
// one _coll_compare interrupted by a signal handler that calls _coll_sort_key
// -- will corrupt the scratch buffers.  No consumer of this library today
// has that call shape; a future thread/signal-safe variant moves scratch
// into a caller-supplied workspace argument (M4.5 target).
//
// Also: _coll_sort_key reuses _norm_scratch (owned by src/normalize.pdx)
// transitively through _norm_nfd.  Because _coll_compare calls _coll_sort_key
// SEQUENTIALLY (first for a, writing to _coll_key_a_scratch to completion,
// then for b), the second NFD run of _coll_sort_key cleanly overwrites the
// first's _norm_scratch without affecting the already-materialised key_a.
//
// =============================================================================
// RETURN SHAPES
// =============================================================================
//
// _coll_compare returns an i64:
//    -1  (0xFFFFFFFFFFFFFFFF)  a < b
//     0  (0x0000000000000000)  a == b
//     1  (0x0000000000000001)  a > b
//
// A UTF-8 error on EITHER input is treated as "treat that side as empty"
// (ignorable) rather than failing the compare, because a sort routine
// embedded in a shell command path should never crash on malformed input.
// A caller that wants fail-fast UTF-8 validation uses utf8_is_valid first.
//
// _coll_sort_key returns a packed u64:
//
//   bits [63:32]  out_bytes_written  (0 on failure, >0 on success)
//   bits [7:0]    status             (0=OK, 1=OUT_TOO_SMALL, 2=INVALID_UTF8)
//   bits [31:8]   reserved           (always 0)
//
// =============================================================================
// paideia-as ENCODER DISCIPLINE (ABSOLUTE)
// =============================================================================
//
//   - No `test rN, rN` -- every zero-check is `cmp reg, 0; je/jne`.
//   - No `and rN, imm64` -- all masks used (0xFF, 0xFFFF) fit imm32 sign-
//     safe (both are positive, well under 0x7FFFFFFF).  The 0xFFFF mask is
//     used only via shl/shr register-pair idioms OR as a small positive
//     imm32, never staged via MOVABS because MOVABS is reserved for the
//     error-band constants (0xFFFFE730, 0xFFFFE731).
//   - No 2-op `imul r, imm`; CE-array indexing uses `shl r, 3` (stride 8);
//     mark-table indexing uses `add r, 8` (stride 8) per linear-scan step.
//   - No multiline `pub let = "..."` -- single-line only; big tables land
//     as `pub let [u32; N]` arrays, one entry per line.
//   - Module basename `Collation` matches `collation.pdx`.
//   - Labels prefixed `coll_` (never `loop`/`if`/`let`/`fn` -- paideia-as
//     reserved).
//   - MOVABS-into-register for every imm whose signed-imm32 representation
//     differs from its unsigned value (the two error-band constants).
//   - All byte stores to the output buffer via `mov_b`.
//   - Table loads via `mov_d` for u32 fields (zero-extends into the full
//     qword), matching normalize.pdx + grapheme.pdx precedent.
//   - Entry rsp%16==8 preserved per SysV; nested-CALL rsp%16==0 enforced
//     through push count parity (see per-function headers).
//   - No `add reg, [mem]` anywhere.
//
// =============================================================================
// Upstream: paideia-os#2480 (R131 Unicode umbrella), paideia-os#2612 (M1),
// paideia-os#2613 (M2 grapheme), paideia-os#2614 (M3 normalize),
// paideia-os#2615 (THIS M4 ticket). Design doc:
// design/toolchain/libpdx-unicode-collation.md.

module Collation = structure {

  // ==========================================================================
  // SECTION 1 -- STATUS CODES (packed in low 8 bits of every sort_key return)
  // ==========================================================================

  pub let COLL_STATUS_OK            : u64 = 0
  pub let COLL_STATUS_OUT_TOO_SMALL : u64 = 1
  pub let COLL_STATUS_INVALID_UTF8  : u64 = 2

  // ==========================================================================
  // SECTION 2 -- ERROR BAND 0xFFFFE730..0xFFFFE73F (M4, collation)
  // ==========================================================================
  //
  // Fourth 16-wide aligned user-space error-code slice taken by this library.
  // Two codes defined at M4; the remaining 14 slots are reserved for later
  // collation kinds (e.g. TAILORING_UNKNOWN once per-locale tailoring lands
  // at M4.4, VARIABLE_WEIGHT_UNDEFINED at M4.3). Disjoint from every other
  // user-space band in the paideia-os tree. Grep confirmation at M4
  // landing time:
  //
  //   grep -rE '0xFFFFE73[0-9A-F]' paideia-os/{src,tools,design,tests}
  //     -> no hits outside this file + caps.decl.

  pub let COLL_INVALID_UTF8   : u64 = 0xFFFFE730
  pub let COLL_OUT_TOO_SMALL  : u64 = 0xFFFFE731

  // ==========================================================================
  // SECTION 3 -- WEIGHT CONSTANTS
  // ==========================================================================
  //
  // The L1 (primary) weight bands for the ASCII baseline. These are
  // deliberately spaced to leave room for later M4.2+ additions (CJK,
  // Hangul) that will slot in via DUCET's implicit-weight algorithm.

  pub let COLL_L1_SPACE       : u64 = 0x0209   // U+0020
  pub let COLL_L1_PUNCT1_BASE : u64 = 0x0210   // U+0021..U+002F
  pub let COLL_L1_PUNCT2_BASE : u64 = 0x0280   // U+003A..U+0040
  pub let COLL_L1_PUNCT3_BASE : u64 = 0x0300   // U+005B..U+0060
  pub let COLL_L1_PUNCT4_BASE : u64 = 0x0320   // U+007B..U+007E
  pub let COLL_L1_DIGIT_BASE  : u64 = 0x1200   // U+0030..U+0039
  pub let COLL_L1_LETTER_BASE : u64 = 0x1C00   // U+0041..U+005A, U+0061..U+007A
  pub let COLL_L1_LATIN1_BASE : u64 = 0xF800   // U+00A0..U+00FF fallback
  pub let COLL_L1_LATIN_A_BASE: u64 = 0xF900   // U+0100..U+017F fallback
  pub let COLL_L1_HIGH_FALLBK : u64 = 0xFE00   // U+0180..U+02FF fallback
  pub let COLL_L1_ABOVE_MARKS : u64 = 0xFF00   // U+0370..           fallback

  pub let COLL_L2_COMMON      : u64 = 0x0020   // default L2 for base letters
  pub let COLL_L2_MARK_DEFAULT: u64 = 0x0040   // default L2 for unlisted mark

  pub let COLL_L3_LOWER       : u64 = 0x0002   // lowercase + marks + non-cased
  pub let COLL_L3_UPPER       : u64 = 0x0008   // uppercase letters

  // ==========================================================================
  // SECTION 4 -- SCRATCH BUFFERS (.bss)
  // ==========================================================================
  //
  // See module header for the per-CE layout and the reentrancy caveat.
  // _coll_ce_count tracks the number of valid CE entries written during the
  // current call; it is reset to 0 by _coll_build_ces and read by the
  // level-stream emit phase.

  pub let COLL_CE_MAX_ENTRIES    : u64 = 1024
  pub let COLL_NFD_SCRATCH_BYTES : u64 = 4096
  pub let COLL_KEY_SCRATCH_BYTES : u64 = 8192

  pub let mut _coll_nfd_scratch    : [u8; 4096] = uninit @align(8)
  pub let mut _coll_ce_scratch     : [u8; 8192] = uninit @align(8)
  pub let mut _coll_ce_count       : u64        = 0
  pub let mut _coll_key_a_scratch  : [u8; 8192] = uninit @align(8)
  pub let mut _coll_key_b_scratch  : [u8; 8192] = uninit @align(8)

  // ==========================================================================
  // SECTION 5 -- MARK L2 TABLE
  // ==========================================================================
  //
  // Flat (cp, L2) pair table for the 13 explicit combining marks that appear
  // in the normalize module's canonical decomposition set. Marks not listed
  // but inside U+0300..U+036F fall back to COLL_L2_MARK_DEFAULT (0x0040).
  //
  // These L2 values are DUCET-informed but not DUCET-identical: the full
  // DUCET uses weights that spread marks across a wider band to leave room
  // for script-specific extensions; the reduced M4 baseline packs them
  // tightly in the 0x0024..0x0055 range because the only consumers today
  // (shell completion, pds listing, terminal selection) do not need finer
  // granularity.
  //
  // Sorted by cp so a linear scan is cache-friendly (fits easily in one
  // L1 line).  13 entries x 2 u32 = 26 u32 = 104 bytes.  One entry per
  // line per the big-tables single-line rule.

  pub let COLL_MARK_TABLE_LEN : u64 = 13

  pub let _coll_mark_table : [u32; 26] = [
    0x00000300, 0x00000025,
    0x00000301, 0x00000024,
    0x00000302, 0x00000027,
    0x00000303, 0x0000002B,
    0x00000304, 0x00000030,
    0x00000306, 0x00000028,
    0x00000307, 0x0000002E,
    0x00000308, 0x0000002F,
    0x0000030A, 0x00000032,
    0x0000030B, 0x00000033,
    0x0000030C, 0x00000034,
    0x00000327, 0x00000054,
    0x00000328, 0x00000055
  ] @align(8)

  // ==========================================================================
  // _coll_lookup_mark(cp) -> L2
  //
  //   rdi = cp (expected in U+0300..U+036F; caller gates the range)
  //   rax = L2 weight (16-bit value in low 16 bits of rax); on no-match,
  //         returns COLL_L2_MARK_DEFAULT (0x0040).
  //
  // Leaf. No callee-save push, no stack frame. Linear scan over the 13-entry
  // mark table at stride 8 bytes per entry. Labels prefixed coll_lm_.
  // ==========================================================================
  pub let _coll_lookup_mark : (u64) -> u64 !{mem} @{} =
    fn (cp: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_lookup_mark linear-scans _coll_mark_table for a cp match and returns the entry's L2 weight. On no-match, returns COLL_L2_MARK_DEFAULT (0x0040). Table has 13 entries at stride 8 bytes (two u32 per entry). Pointer-advance scan: `add r10, 8` per iteration. Table loads via mov_d (u32 zero-extended). Leaf; no callee-save; no stack frame. No test; no and-imm64; no imul-r-imm; no byte load. Labels prefixed coll_lm_.",
      block: {
        lea r10, [rip + _coll_mark_table];
        mov r11, 13;
        shl r11, 3;                 // r11 = 13 * 8 = 104 bytes
        add r11, r10;               // r11 = end pointer

      coll_lm_loop:
        cmp r10, r11;
        jae coll_lm_default;
        mov_d rax, [r10 + 0];
        cmp rax, rdi;
        je  coll_lm_found;
        add r10, 8;
        jmp coll_lm_loop;

      coll_lm_found:
        mov_d rax, [r10 + 4];
        ret;

      coll_lm_default:
        mov rax, 0x40;
        ret;
      }
    }

  // ==========================================================================
  // _coll_classify(cp) -> packed_u64
  //
  //   rdi = cp (0..0x10FFFF; caller is responsible for validity)
  //   rax = (L1 << 32) | (L2 << 16) | L3, each weight a 16-bit value.
  //         An "ignorable" classification (controls, DEL) returns 0
  //         (all three weights zero), which the emit phase correctly
  //         skips at every level.
  //
  // Branches over cp ranges in strict order (early exit on first match):
  //
  //   cp < 0x20            -> ignorable (controls)
  //   cp == 0x20           -> space
  //   cp <= 0x2F           -> punct1 band
  //   cp <= 0x39           -> digit band
  //   cp <= 0x40           -> punct2 band
  //   cp <= 0x5A           -> upper letter (letter_base + (cp-0x41)*4, L3=UPPER)
  //   cp <= 0x60           -> punct3 band
  //   cp <= 0x7A           -> lower letter (letter_base + (cp-0x61)*4, L3=LOWER)
  //   cp <= 0x7E           -> punct4 band
  //   cp <= 0x9F           -> ignorable (DEL + C1 controls)
  //   cp <= 0xFF           -> Latin-1 fallback (latin1_base + (cp-0xA0)*2)
  //   cp <= 0x17F          -> Latin-Ext-A fallback (latin_a_base + (cp-0x100)*2)
  //   cp <  0x300          -> high fallback (high_fallbk)
  //   cp <= 0x36F          -> combining mark (L1=0; L2 from table; L3=LOWER)
  //   cp >= 0x370          -> above-marks fallback (above_marks)
  //
  // Non-mark branches do NOT need the stack-alignment pad because they are
  // leaf exits.  The mark branch calls _coll_lookup_mark and MUST shift rsp
  // for SysV alignment -- it uses a dedicated `sub rsp 8 / call / add rsp 8`
  // bracket local to that branch only.
  //
  // Labels prefixed coll_cl_.
  // ==========================================================================
  pub let _coll_classify : (u64) -> u64 !{mem} @{} =
    fn (cp: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_classify maps a cp to a packed (L1, L2, L3) triple. Branch tree walks the cp ranges in strict increasing order; early exit on first match. ASCII ranges (space, punct1..4, digits, letters) each compute L1 algorithmically via (cp - range_base) * stride + L1_base, then pack with the branch-specific L2/L3. Combining-mark branch (U+0300..U+036F) nests a call to _coll_lookup_mark (16-bit L2 return) and packs (0, L2, 0x0002); the call branch has its own sub-rsp-8/add-rsp-8 bracket for SysV CALL alignment (entry rsp%16==8, sub rsp 8 -> rsp%16==0 ✓). All other branches are leaf exits. Pack idiom: rax starts holding L1, shl 32, add (L2 << 16), add L3. Encoder: no test (cmp 0 everywhere); no and-imm64 (COLL_L1_* constants and 0xFFFF-sized masks are small positive imm32); no imul-r-imm (letter stride-4 via shl 2; punct/latin stride-2 via shl 1); no byte load. Labels prefixed coll_cl_.",
      block: {
        // Branch 1: cp < 0x20 -> ignorable.
        cmp rdi, 0x20;
        jb  coll_cl_ignorable;

        // Branch 2: cp == 0x20 (space).
        jne coll_cl_above_space;
        mov rax, 0x209;
        shl rax, 32;
        mov rcx, 0x20;
        shl rcx, 16;
        add rax, rcx;
        add rax, 0x2;
        ret;

      coll_cl_above_space:
        cmp rdi, 0x2F;
        ja  coll_cl_above_punct1;
        // Punct1 band: L1 = COLL_L1_PUNCT1_BASE + (cp - 0x21) * 2
        mov rax, rdi;
        sub rax, 0x21;
        shl rax, 1;
        add rax, 0x210;
        jmp coll_cl_pack_common;

      coll_cl_above_punct1:
        cmp rdi, 0x39;
        ja  coll_cl_above_digit;
        // Digit band: L1 = COLL_L1_DIGIT_BASE + (cp - 0x30) * 2
        mov rax, rdi;
        sub rax, 0x30;
        shl rax, 1;
        add rax, 0x1200;
        jmp coll_cl_pack_common;

      coll_cl_above_digit:
        cmp rdi, 0x40;
        ja  coll_cl_above_punct2;
        // Punct2 band: L1 = COLL_L1_PUNCT2_BASE + (cp - 0x3A) * 2
        mov rax, rdi;
        sub rax, 0x3A;
        shl rax, 1;
        add rax, 0x280;
        jmp coll_cl_pack_common;

      coll_cl_above_punct2:
        cmp rdi, 0x5A;
        ja  coll_cl_above_upper;
        // Upper letter: L1 = COLL_L1_LETTER_BASE + (cp - 0x41) * 4; L3 = 0x08
        mov rax, rdi;
        sub rax, 0x41;
        shl rax, 2;
        add rax, 0x1C00;
        shl rax, 32;
        mov rcx, 0x20;
        shl rcx, 16;
        add rax, rcx;
        add rax, 0x8;
        ret;

      coll_cl_above_upper:
        cmp rdi, 0x60;
        ja  coll_cl_above_punct3;
        // Punct3 band: L1 = COLL_L1_PUNCT3_BASE + (cp - 0x5B) * 2
        mov rax, rdi;
        sub rax, 0x5B;
        shl rax, 1;
        add rax, 0x300;
        jmp coll_cl_pack_common;

      coll_cl_above_punct3:
        cmp rdi, 0x7A;
        ja  coll_cl_above_lower;
        // Lower letter: L1 = COLL_L1_LETTER_BASE + (cp - 0x61) * 4; L3 = 0x02
        mov rax, rdi;
        sub rax, 0x61;
        shl rax, 2;
        add rax, 0x1C00;
        jmp coll_cl_pack_common;

      coll_cl_above_lower:
        cmp rdi, 0x7E;
        ja  coll_cl_above_punct4;
        // Punct4 band: L1 = COLL_L1_PUNCT4_BASE + (cp - 0x7B) * 2
        mov rax, rdi;
        sub rax, 0x7B;
        shl rax, 1;
        add rax, 0x320;
        jmp coll_cl_pack_common;

      coll_cl_above_punct4:
        // U+007F DEL + U+0080..U+009F C1 controls -> ignorable.
        cmp rdi, 0x9F;
        jbe coll_cl_ignorable;

        cmp rdi, 0xFF;
        ja  coll_cl_above_latin1;
        // Latin-1 fallback: L1 = COLL_L1_LATIN1_BASE + (cp - 0xA0) * 2
        mov rax, rdi;
        sub rax, 0xA0;
        shl rax, 1;
        add rax, 0xF800;
        jmp coll_cl_pack_common;

      coll_cl_above_latin1:
        cmp rdi, 0x17F;
        ja  coll_cl_above_latin_a;
        // Latin-Ext-A fallback: L1 = COLL_L1_LATIN_A_BASE + (cp - 0x100) * 2
        mov rax, rdi;
        sub rax, 0x100;
        shl rax, 1;
        add rax, 0xF900;
        jmp coll_cl_pack_common;

      coll_cl_above_latin_a:
        cmp rdi, 0x2FF;
        ja  coll_cl_mark_or_above;
        // High fallback band (U+0180..U+02FF): L1 = COLL_L1_HIGH_FALLBK
        mov rax, 0xFE00;
        jmp coll_cl_pack_common;

      coll_cl_mark_or_above:
        cmp rdi, 0x36F;
        ja  coll_cl_above_marks;
        // Combining mark path: L1=0, L2 = _coll_lookup_mark(cp), L3=0x02.
        // Local SysV alignment for the nested CALL: sub rsp 8 ... add rsp 8.
        sub rsp, 8;
        call _coll_lookup_mark;
        shl rax, 16;                // place L2 at bits [31:16]
        add rax, 0x2;               // L3 = 0x02
        // L1 slot (bits [47:32]) is zero -- rax was built from (L2<<16)+L3
        // with no high bits set, matching the (L1=0) design.
        add rsp, 8;
        ret;

      coll_cl_above_marks:
        // Above-marks fallback (U+0370..): L1 = COLL_L1_ABOVE_MARKS.
        mov rax, 0xFF00;
        jmp coll_cl_pack_common;

      coll_cl_pack_common:
        // rax = L1. Pack with L2 = 0x0020, L3 = 0x0002.
        shl rax, 32;
        mov rcx, 0x20;
        shl rcx, 16;
        add rax, rcx;
        add rax, 0x2;
        ret;

      coll_cl_ignorable:
        xor rax, rax;
        ret;
      }
    }

  // ==========================================================================
  // _coll_build_ces(src_ptr, src_len) -> packed
  //
  //   rdi = src_ptr  (bytes of NFD-normalised UTF-8)
  //   rsi = src_len
  //   rax = packed: (count << 32) | status
  //         status in {0=OK, 1=OUT_TOO_SMALL (CE scratch overflow),
  //                    2=INVALID_UTF8}
  //
  // Walks src via utf8_decode_cp.  For each cp, calls _coll_classify and
  // writes the resulting packed (L1, L2, L3) qword to _coll_ce_scratch[count].
  // Overflow guard: count >= COLL_CE_MAX_ENTRIES (1024) returns status=1.
  //
  // Writes _coll_ce_count on success before returning.  On UTF-8 error,
  // _coll_ce_count is reset to 0 (caller sees the status but must ignore
  // ce_scratch contents on failure).
  //
  // Register plan (5 callee-save pushes + alignment math):
  //   rbx = src_ptr          (across every CALL)
  //   r12 = src_len
  //   r13 = cursor
  //   r14 = ce_count
  //   r15 = packed CE result from _coll_classify (saved across the next
  //         call to utf8_decode_cp? no -- we store CE before the next
  //         decode and reuse r15 freely).
  //
  // Alignment: entry rsp%16==8; 5 pushes shift rsp by 40 bytes, so rsp%16 =
  // (8-40) mod 16 = (-32) mod 16 = 0 -- WAIT: entry is rsp%16==8, after 5
  // pushes rsp mod 16 = (8 + 40) mod 16 ... no, pushes DECREMENT rsp. If
  // rsp0 % 16 == 8 and we subtract 40, rsp' mod 16 = (8 - 40) mod 16 =
  // -32 mod 16 = 0.  5 pushes alone give rsp%16==0 at the nested CALL
  // site, which is what SysV requires.  NO sub rsp 8 pad needed.
  //
  // Labels prefixed coll_bc_.
  // ==========================================================================
  pub let _coll_build_ces : (u64, u64) -> u64 !{mem} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_build_ces walks NFD bytes via utf8_decode_cp, classifies each cp via _coll_classify, and writes packed CE qwords to _coll_ce_scratch. 5 callee-save pushes (rbx, r12, r13, r14, r15): entry rsp%16==8 + 40 = rsp%16=0 at the nested CALL (SysV). CE-count overflow guard (count >= 1024) returns status=1. UTF-8 error (utf8_decode_cp's bits-[31:24] discrimination) returns status=2 with count=0. CE packing: _coll_classify's return IS the CE packed form; written as a single qword via `mov [r10], rdx`. Index-to-offset via `shl r11, 3` (stride 8). Encoder: no test (cmp 0); no and-imm64 (0xFF fits imm32); no imul-r-imm (indexing via shl); no byte load (utf8_decode_cp owns it); no multiline let. Labels prefixed coll_bc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;               // src_ptr
        mov r12, rsi;               // src_len
        xor r13, r13;               // cursor = 0
        xor r14, r14;               // ce_count = 0

      coll_bc_loop_top:
        cmp r13, r12;
        jae coll_bc_ok;

        // Overflow guard: 1024 entries max.
        mov rcx, 1024;
        cmp r14, rcx;
        jae coll_bc_ce_full;

        // ---- utf8_decode_cp(src + cursor, src_len - cursor) ----
        mov rdi, rbx;
        add rdi, r13;
        mov rsi, r12;
        sub rsi, r13;
        call utf8_decode_cp;

        // Error-band check via bits [31:24].
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 4;
        ja  coll_bc_invalid;

        // Advance cursor; derive cp.
        add r13, r11;
        shr rax, 32;                // rax = cp

        // ---- _coll_classify(cp) ----
        mov rdi, rax;
        call _coll_classify;
        mov r15, rax;               // r15 = packed CE

        // Store CE at _coll_ce_scratch[ce_count].
        lea r10, [rip + _coll_ce_scratch];
        mov r11, r14;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], r15;
        add r14, 1;
        jmp coll_bc_loop_top;

      coll_bc_ce_full:
        xor r14, r14;
        lea r10, [rip + _coll_ce_count];
        mov [r10 + 0], r14;
        mov rax, 1;                 // status=1 OUT_TOO_SMALL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      coll_bc_invalid:
        xor r14, r14;
        lea r10, [rip + _coll_ce_count];
        mov [r10 + 0], r14;
        mov rax, 2;                 // status=2 INVALID_UTF8
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      coll_bc_ok:
        lea r10, [rip + _coll_ce_count];
        mov [r10 + 0], r14;
        mov rax, r14;
        shl rax, 32;                // (count << 32) | 0
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _coll_emit_key(count, out_ptr, out_cap) -> packed
  //
  //   rdi = count
  //   rsi = out_ptr
  //   rdx = out_cap
  //   rax = packed: (out_bytes_written << 32) | status
  //                 status in {0=OK, 1=OUT_TOO_SMALL}
  //
  // Writes the UCA sort key: three level streams separated by u16 0x0000
  // sentinels.  For each level L in {1, 2, 3}, scans _coll_ce_scratch[0..count]
  // and writes each non-zero weight at that level as a big-endian u16.  A
  // 0x0000 separator follows levels 1 and 2 (not level 3).
  //
  // Capacity gating: before writing each byte, we check `pos < out_cap`;
  // on exhaustion we return status=1 with out_bytes_written=0 (atomic
  // failure, matching normalize.pdx's write-all-or-nothing semantics).
  //
  // Register plan (6 callee-save pushes + sub rsp 8 pad for even push count):
  //   rbx = out_ptr
  //   rbp = out_cap
  //   r12 = count
  //   r13 = i (CE scan index for the current level)
  //   r14 = out_pos
  //   r15 = current level (1, 2, or 3)
  //
  // Alignment: 6 pushes = 48 bytes.  (8 - 48) mod 16 = (-40) mod 16 = 8.
  // Add sub rsp 8 to shift to 0.
  //
  // Labels prefixed coll_ek_.
  // ==========================================================================
  pub let _coll_emit_key : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (count: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_emit_key writes three level streams (L1, L2, L3) separated by u16 0x0000 sentinels. Walks _coll_ce_scratch three times; at each pass, extracts the per-CE weight at the current level and writes it big-endian as two bytes IF non-zero. Separator u16 is written only between levels (after L1 and after L2, not after L3). Capacity gate before each byte write: pos < out_cap or we return (0, status=1). Weight extraction uses shl/shr idioms to avoid imm32 edge cases with 0xFFFF: L1 is `shr ce,32`; L2 is `shl ce,32; shr ce,48`; L3 is `shl ce,48; shr ce,48`. Big-endian emit: hi byte = shr 8, lo byte = low 8. 6 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL (we make no nested CALL here, but keep the pad for symmetry and future-proofing against adding a per-byte helper). Encoder: no test (cmp 0); no and-imm64 (0xFF mask is small imm32); no imul-r-imm (level_index * ce_stride_8 via shl 3); no byte load (we WRITE bytes via mov_b, never read them from the output). Labels prefixed coll_ek_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rsi;               // out_ptr
        mov rbp, rdx;               // out_cap
        mov r12, rdi;               // count
        xor r14, r14;               // out_pos = 0

        // Edge case: count == 0 -> emit zero bytes, status=0.
        cmp r12, 0;
        je  coll_ek_ok;

        // =========================================================
        // PASS 1 (L1 stream)
        // =========================================================
        mov r15, 1;
        xor r13, r13;

      coll_ek_l1_loop:
        cmp r13, r12;
        jae coll_ek_l1_done;

        // Load CE[r13].
        lea r10, [rip + _coll_ce_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];

        // Extract L1 (bits [47:32]).
        shr rax, 32;                // L1 in low 16 (high 48 are 0).

        // Skip zero weight (L1 = 0 means "ignorable at level 1").
        cmp rax, 0;
        je  coll_ek_l1_adv;

        // Emit big-endian u16 (hi, lo). Capacity gate before each byte.
        mov rcx, r14;
        add rcx, 2;
        cmp rcx, rbp;
        ja  coll_ek_too_small;

        // High byte: shr 8.
        mov rcx, rax;
        shr rcx, 8;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 0], rcx;
        // Low byte.
        mov rcx, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 1], rcx;
        add r14, 2;

      coll_ek_l1_adv:
        add r13, 1;
        jmp coll_ek_l1_loop;

      coll_ek_l1_done:
        // Emit L1->L2 separator (two zero bytes).
        mov rcx, r14;
        add rcx, 2;
        cmp rcx, rbp;
        ja  coll_ek_too_small;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 0], rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 1], rax;
        add r14, 2;

        // =========================================================
        // PASS 2 (L2 stream)
        // =========================================================
        xor r13, r13;

      coll_ek_l2_loop:
        cmp r13, r12;
        jae coll_ek_l2_done;

        lea r10, [rip + _coll_ce_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];

        // Extract L2 (bits [31:16]) via shl/shr idiom (encoder-safe for
        // 16-bit masks).  shl 32 pushes bits [63:32] out; shr 48 pulls
        // the remaining bits [47:32] (originally [31:16]) into low 16.
        shl rax, 32;
        shr rax, 48;

        cmp rax, 0;
        je  coll_ek_l2_adv;

        mov rcx, r14;
        add rcx, 2;
        cmp rcx, rbp;
        ja  coll_ek_too_small;

        mov rcx, rax;
        shr rcx, 8;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 0], rcx;
        mov rcx, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 1], rcx;
        add r14, 2;

      coll_ek_l2_adv:
        add r13, 1;
        jmp coll_ek_l2_loop;

      coll_ek_l2_done:
        // Emit L2->L3 separator.
        mov rcx, r14;
        add rcx, 2;
        cmp rcx, rbp;
        ja  coll_ek_too_small;
        xor rax, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 0], rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 1], rax;
        add r14, 2;

        // =========================================================
        // PASS 3 (L3 stream, no trailing separator)
        // =========================================================
        xor r13, r13;

      coll_ek_l3_loop:
        cmp r13, r12;
        jae coll_ek_ok;

        lea r10, [rip + _coll_ce_scratch];
        mov r11, r13;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];

        // Extract L3 (bits [15:0]) via shl 48 / shr 48.
        shl rax, 48;
        shr rax, 48;

        cmp rax, 0;
        je  coll_ek_l3_adv;

        mov rcx, r14;
        add rcx, 2;
        cmp rcx, rbp;
        ja  coll_ek_too_small;

        mov rcx, rax;
        shr rcx, 8;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 0], rcx;
        mov rcx, rax;
        mov r10, rbx;
        add r10, r14;
        mov_b [r10 + 1], rcx;
        add r14, 2;

      coll_ek_l3_adv:
        add r13, 1;
        jmp coll_ek_l3_loop;

      coll_ek_ok:
        mov rax, r14;
        shl rax, 32;                // (out_bytes_written << 32) | 0
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      coll_ek_too_small:
        xor rax, rax;
        add rax, 1;                 // status=1 OUT_TOO_SMALL
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _coll_sort_key(bytes_ptr, bytes_len, out_ptr, out_cap) -> packed
  //
  //   rdi = bytes_ptr
  //   rsi = bytes_len
  //   rdx = out_ptr
  //   rcx = out_cap
  //   rax = packed: (out_bytes_written << 32) | status
  //
  // Public entry point #1.  Pipeline: NFD -> CE build -> emit key.
  //
  // Edge case: bytes_len == 0 returns (0 << 32) | 0 directly, so an empty
  // input yields an empty key (no separators written -- correct per UCA:
  // an empty collation element list has no level streams).
  //
  // Register plan (6 callee-save pushes + sub rsp 8 pad):
  //   rbx = bytes_ptr          (preserved across all nested CALLs)
  //   rbp = bytes_len
  //   r12 = out_ptr
  //   r13 = out_cap
  //   r14 = NFD byte count (produced by _norm_nfd, consumed by build_ces)
  //   r15 = CE count (produced by _coll_build_ces, consumed by emit_key)
  //
  // Alignment: 6 pushes + sub rsp 8 = 56 bytes; (8-56) mod 16 = 0.
  //
  // Labels prefixed coll_sk_.
  // ==========================================================================
  pub let _coll_sort_key : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bytes_ptr: u64) (bytes_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_sort_key drives the three-phase UCA pipeline (NFD -> build CEs -> emit key). 6 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL. rbx=bytes_ptr, rbp=bytes_len, r12=out_ptr, r13=out_cap, r14=NFD byte count, r15=CE count. Edge case bytes_len==0 returns 0 directly (empty key is valid per UCA). Phase 1 (NFD): status != 0 is propagated with out_bytes=0; packed-return discrimination via `and rax, 0xFF` for status, `shr rax, 32` for byte count. Phase 2 (build_ces): same discrimination shape. Phase 3 (emit_key): packed-return straight-propagates (same shape). Encoder: no test (cmp 0); no and-imm64 (0xFF, 0x0 fit imm32); no imul-r-imm; no byte load. Labels prefixed coll_sk_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;               // bytes_ptr
        mov rbp, rsi;               // bytes_len
        mov r12, rdx;               // out_ptr
        mov r13, rcx;               // out_cap

        // Edge case: empty input -> empty key, status=0.
        cmp rbp, 0;
        je  coll_sk_empty;

        // ---- Phase 1: NFD to _coll_nfd_scratch ----
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _coll_nfd_scratch];
        mov rcx, 4096;              // COLL_NFD_SCRATCH_BYTES
        call _norm_nfd;

        // Status discrimination.
        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 0;
        jne coll_sk_nfd_fail;

        shr rax, 32;
        mov r14, rax;               // NFD byte count

        // ---- Phase 2: build CEs ----
        lea rdi, [rip + _coll_nfd_scratch];
        mov rsi, r14;
        call _coll_build_ces;

        mov rcx, rax;
        and rcx, 0xFF;
        cmp rcx, 0;
        jne coll_sk_ces_fail;

        shr rax, 32;
        mov r15, rax;               // CE count

        // ---- Phase 3: emit key ----
        mov rdi, r15;
        mov rsi, r12;
        mov rdx, r13;
        call _coll_emit_key;
        // rax already packed (out_bytes << 32) | status.
        jmp coll_sk_exit;

      coll_sk_empty:
        xor rax, rax;               // packed (0 << 32) | 0
        jmp coll_sk_exit;

      coll_sk_nfd_fail:
        // Propagate NFD status (1=OUT_TOO_SMALL on scratch overflow,
        // 2=INVALID_UTF8).  Translate scratch-overflow to a visible
        // OUT_TOO_SMALL for the caller.
        mov rax, rcx;
        jmp coll_sk_exit;

      coll_sk_ces_fail:
        // Build-CE status: 1=OUT_TOO_SMALL (ce overflow) or 2=INVALID_UTF8.
        mov rax, rcx;

      coll_sk_exit:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // _coll_keycmp(a_ptr, a_len, b_ptr, b_len) -> i64
  //
  //   rdi = a_ptr
  //   rsi = a_len
  //   rdx = b_ptr
  //   rcx = b_len
  //   rax = -1 (0xFFFFFFFFFFFFFFFF) if a < b
  //          0 if equal
  //          1 if a > b
  //
  // Byte-wise lexicographic memcmp with "shorter wins" tiebreaker.  This is
  // the standard C-library memcmp semantics applied to the UCA sort key
  // output.
  //
  // Leaf.  No callee-save push needed (all state in caller-save registers).
  //
  // Labels prefixed coll_kc_.
  // ==========================================================================
  pub let _coll_keycmp : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (a_ptr: u64) (a_len: u64) (b_ptr: u64) (b_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_keycmp byte-wise memcmp over min(a_len, b_len) with shorter-key-wins tiebreaker. Returns -1 (via `xor rax,rax; sub rax,1`), 0, or 1 as an i64. Leaf; no callee-save. Byte loads via mov_b (zero-extended). Encoder: no test (cmp 0); no and-imm64; no imul-r-imm; no multiline let. Labels prefixed coll_kc_.",
      block: {
        xor r8, r8;                 // i = 0

        // min_len = min(a_len, b_len) in r9.
        mov r9, rsi;
        cmp r9, rcx;
        jbe coll_kc_min_ok;
        mov r9, rcx;

      coll_kc_min_ok:
        // Walk i = 0..min_len.
      coll_kc_loop:
        cmp r8, r9;
        jae coll_kc_tie_check;
        mov_b r10, [rdi + r8];
        mov_b r11, [rdx + r8];
        cmp r10, r11;
        jb  coll_kc_lt;
        ja  coll_kc_gt;
        add r8, 1;
        jmp coll_kc_loop;

      coll_kc_tie_check:
        // All bytes in [0, min_len) equal.  Shorter wins.
        cmp rsi, rcx;
        jb  coll_kc_lt;
        ja  coll_kc_gt;
        xor rax, rax;
        ret;

      coll_kc_lt:
        xor rax, rax;
        sub rax, 1;                 // -1 == 0xFFFFFFFFFFFFFFFF
        ret;

      coll_kc_gt:
        mov rax, 1;
        ret;
      }
    }

  // ==========================================================================
  // _coll_compare(a_ptr, a_len, b_ptr, b_len) -> i64
  //
  //   rdi = a_ptr
  //   rsi = a_len
  //   rdx = b_ptr
  //   rcx = b_len
  //   rax = -1 / 0 / 1 (as an i64)
  //
  // Public entry point #2.  Materialises both sort keys into the two
  // compare-local scratch buffers (_coll_key_a_scratch, _coll_key_b_scratch,
  // 8192 bytes each) then byte-wise memcmps them.
  //
  // UTF-8 failure handling: if _coll_sort_key returns a non-zero status for
  // either input (OUT_TOO_SMALL on scratch overflow, or INVALID_UTF8), the
  // compare treats that side as having a 0-length key.  Two malformed
  // inputs thus compare equal.  Rationale: a sort routine embedded in a
  // shell pipeline should never crash on bad bytes; callers that need
  // fail-fast UTF-8 validation call utf8_is_valid first.
  //
  // Register plan (6 callee-save pushes + sub rsp 8 pad):
  //   rbx = a_ptr
  //   rbp = a_len
  //   r12 = b_ptr
  //   r13 = b_len
  //   r14 = key_a byte count
  //   r15 = key_b byte count
  //
  // Labels prefixed coll_cm_.
  // ==========================================================================
  pub let _coll_compare : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (a_ptr: u64) (a_len: u64) (b_ptr: u64) (b_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M4 (#2615): _coll_compare materialises sort keys for a and b into the two compare-local scratch buffers (_coll_key_a_scratch, _coll_key_b_scratch, 8192 bytes each), then calls _coll_keycmp for byte-wise memcmp with shorter-wins tiebreaker. Returns -1/0/1 as i64 (-1 via xor+sub pattern). 6 callee-save pushes + sub rsp 8 pad for rsp%16==0 pre-CALL. rbx=a_ptr, rbp=a_len, r12=b_ptr, r13=b_len, r14=key_a byte count, r15=key_b byte count. On sort_key failure (status != 0): treat that side as a 0-length key (no crash, orderable). Encoder: no test (cmp 0); no and-imm64 (0xFF fits imm32); no imul-r-imm; no byte load (we delegate byte-level work to _coll_keycmp). Labels prefixed coll_cm_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;               // a_ptr
        mov rbp, rsi;               // a_len
        mov r12, rdx;               // b_ptr
        mov r13, rcx;               // b_len

        // ---- Sort key for a ----
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _coll_key_a_scratch];
        mov rcx, 8192;
        call _coll_sort_key;

        // On failure, zero the key_a byte count (treat as empty).
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        je  coll_cm_key_a_ok;
        xor r14, r14;
        jmp coll_cm_key_b;

      coll_cm_key_a_ok:
        shr rax, 32;
        mov r14, rax;

      coll_cm_key_b:
        // ---- Sort key for b ----
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + _coll_key_b_scratch];
        mov rcx, 8192;
        call _coll_sort_key;

        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        je  coll_cm_key_b_ok;
        xor r15, r15;
        jmp coll_cm_cmp;

      coll_cm_key_b_ok:
        shr rax, 32;
        mov r15, rax;

      coll_cm_cmp:
        // ---- Compare keys ----
        lea rdi, [rip + _coll_key_a_scratch];
        mov rsi, r14;
        lea rdx, [rip + _coll_key_b_scratch];
        mov rcx, r15;
        call _coll_keycmp;
        // rax already in {-1, 0, 1} by _coll_keycmp's contract.

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

}
