// benches/grapheme.pdx -- libpdx-unicode-tables.M2 (paideia-os#2613)
//
// BenchGrapheme: straight-line perf fixtures for `_gc_next` /
// `_gc_count`.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This file is a BENCHMARK FIXTURE, not a criterion harness: paideia-os
// has no Rust-side crate wrapper for this library, so there is no
// `cargo bench` entry point. Each bench function is a straight-line
// driver that invokes the measured primitive against a well-defined
// fixture and returns a count the measurement harness can divide by
// elapsed-cycle count (as read via `rdtsc` by whichever downstream
// harness links this module).
//
// Two benches:
//
//   gcb_bench_ascii_8      -- iterate `_gc_next` over 8 ASCII bytes;
//                              return 8 (= cluster count).
//   gcb_bench_family_emoji -- call `_gc_count` on the 18-byte
//                              family-emoji ZWJ sequence; return 1
//                              (= cluster count via GB11 chain).
//
// Both benches run their fixture ONCE: a downstream wrapper repeats
// the call under rdtsc / rdtscp timing. The fixtures are small by
// design -- a bench suite that wants to measure throughput at
// stream length can call these in a tight repeat loop or chain the
// family emoji 100 times for a longer sample.
//
// =============================================================================
// FIXTURE LAYOUT
// =============================================================================
//
//   _gcb_in_ascii8        "abcdefgh"                            (8 bytes)
//   _gcb_in_family        man + ZWJ + woman + ZWJ + girl       (18 bytes)
//
// =============================================================================
// paideia-as CONFORMANCE
// =============================================================================
//
//   - Module name `BenchGrapheme` matches `grapheme.pdx` basename
//     under the benches/ root (paideia-as treats bench/test modules
//     the same way for the module-basename rule).
//   - No `test` mnemonic; no `and reg, imm64`; no `imul r, imm`; no
//     multiline strings; no `add reg, [mem]`.
//   - Labels prefixed `gcb_`.
//   - Byte writes to fixtures via `mov_b`.
//   - Each bench entry: 2 pushes + `sub rsp, 8` for CALL alignment.
//
// Upstream: paideia-os#2613 (R131.M2).

module BenchGrapheme = structure {

  // ==========================================================================
  // Fixture buffers (.bss)
  // ==========================================================================
  pub let mut _gcb_in_ascii8   : [u8; 8]   = uninit @align(8)
  pub let mut _gcb_in_family   : [u8; 24]  = uninit @align(8)

  // ==========================================================================
  // gcb_reset() -> ()
  //
  // Zero-fill both fixtures then write the byte constants. Leaf
  // function. Labels prefixed gcb_rs_.
  // ==========================================================================
  pub let gcb_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): initialise the two bench fixtures. Zero-fill then write bytes via mov_b. _gcb_in_ascii8 = 'abcdefgh'. _gcb_in_family = F0 9F 91 A8 E2 80 8D F0 9F 91 A9 E2 80 8D F0 9F 91 A7 (man + ZWJ + woman + ZWJ + girl). Leaf function; no callee-save push. Labels prefixed gcb_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _gcb_in_ascii8];
        mov [r10 + 0], rax;

        lea r10, [rip + _gcb_in_family];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;

        // Populate ascii8: "abcdefgh".
        lea r10, [rip + _gcb_in_ascii8];
        mov rax, 0x61; mov_b [r10 + 0], rax;  // a
        mov rax, 0x62; mov_b [r10 + 1], rax;  // b
        mov rax, 0x63; mov_b [r10 + 2], rax;  // c
        mov rax, 0x64; mov_b [r10 + 3], rax;  // d
        mov rax, 0x65; mov_b [r10 + 4], rax;  // e
        mov rax, 0x66; mov_b [r10 + 5], rax;  // f
        mov rax, 0x67; mov_b [r10 + 6], rax;  // g
        mov rax, 0x68; mov_b [r10 + 7], rax;  // h

        // Populate family emoji: 18 bytes.
        lea r10, [rip + _gcb_in_family];
        // Man (U+1F468) = F0 9F 91 A8
        mov rax, 0xF0; mov_b [r10 + 0], rax;
        mov rax, 0x9F; mov_b [r10 + 1], rax;
        mov rax, 0x91; mov_b [r10 + 2], rax;
        mov rax, 0xA8; mov_b [r10 + 3], rax;
        // ZWJ (U+200D) = E2 80 8D
        mov rax, 0xE2; mov_b [r10 + 4], rax;
        mov rax, 0x80; mov_b [r10 + 5], rax;
        mov rax, 0x8D; mov_b [r10 + 6], rax;
        // Woman (U+1F469) = F0 9F 91 A9
        mov rax, 0xF0; mov_b [r10 + 7], rax;
        mov rax, 0x9F; mov_b [r10 + 8], rax;
        mov rax, 0x91; mov_b [r10 + 9], rax;
        mov rax, 0xA9; mov_b [r10 + 10], rax;
        // ZWJ (U+200D) = E2 80 8D
        mov rax, 0xE2; mov_b [r10 + 11], rax;
        mov rax, 0x80; mov_b [r10 + 12], rax;
        mov rax, 0x8D; mov_b [r10 + 13], rax;
        // Girl (U+1F467) = F0 9F 91 A7
        mov rax, 0xF0; mov_b [r10 + 14], rax;
        mov rax, 0x9F; mov_b [r10 + 15], rax;
        mov rax, 0x91; mov_b [r10 + 16], rax;
        mov rax, 0xA7; mov_b [r10 + 17], rax;

        ret
      }
    }

  // ==========================================================================
  // gcb_bench_ascii_8() -> u64
  //
  // Measurement target: `_gc_count` over 8 ASCII bytes. Expected
  // return value: 8 (each byte is its own cluster via GB999). The
  // downstream harness measures the cycle count across one
  // invocation; dividing by 8 gives per-cluster cycles on the pure
  // ASCII fast path.
  //
  // 2 pushes + sub rsp 8 for CALL alignment.
  // ==========================================================================
  pub let gcb_bench_ascii_8 : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): bench driver for ASCII fast path. Reset fixture, call _gc_count('abcdefgh', 8). Returns 8 clusters. Exercise only the OTHER x OTHER GB999 path, no state transitions beyond ri_count/ep_chain stays 0 at seed. 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed gcb_a8_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call gcb_reset;

        lea rdi, [rip + _gcb_in_ascii8];
        mov rsi, 8;
        call _gc_count;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gcb_bench_family_emoji() -> u64
  //
  // Measurement target: `_gc_count` over the 18-byte family emoji.
  // Expected return value: 1 (GB11 glues the whole sequence into
  // one cluster). The downstream harness measures cycle count across
  // one invocation; this exercises the full GB11 state machine
  // (ep_chain toggle, zwj_armed set/consume, EP extend) plus three
  // 4-byte and two 3-byte UTF-8 decodes.
  //
  // 2 pushes + sub rsp 8 for CALL alignment.
  // ==========================================================================
  pub let gcb_bench_family_emoji : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-unicode-tables.M2 (#2613): bench driver for the GB11 emoji-ZWJ state-machine hot path. Reset fixture, call _gc_count(family 18 bytes). Returns 1 cluster. Exercise ep_chain toggle, zwj_armed set/consume, 4-byte + 3-byte UTF-8 decode cycles. 2 pushes + sub rsp 8 for CALL alignment. Labels prefixed gcb_fe_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call gcb_reset;

        lea rdi, [rip + _gcb_in_family];
        mov rsi, 18;
        call _gc_count;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

}
