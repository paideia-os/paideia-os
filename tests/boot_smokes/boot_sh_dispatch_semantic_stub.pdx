// tests/boot_smokes/boot_sh_dispatch_semantic_stub.pdx
// R222.M7 (paideia-os#2664, umbrella #2486)
//
// SMOKE SHAPE — Semantic-mode (M7 stub) dispatch via /bin/sh.
//
// Scenario (post-M7-cont swap in bin_seeds.pdx):
//   1. Caller sets `PDX_SHELL_MODE=semantic` in envp.
//   2. init (or shell exec_child) fork+execves `/bin/sh` which is
//      sh_dispatch.elf once bin_seeds.pdx points /bin/sh at it.
//   3. sh_dispatch._start emits `SH DISPATCH START` via sys_debug_puts.
//   4. _sd_route scans envp, matches `PDX_SHELL_MODE=` prefix, reads the
//      value `semantic\0`, routes to _sd_semantic_stub.
//   5. _sd_semantic_stub emits `sh dispatch mode=semantic (stub)` and
//      `sh dispatch semantic shell not yet available`, then tail-calls
//      _sd_legacy_fallback.
//   6. _sd_legacy_fallback emits `sh dispatch mode=legacy` and execves
//      `/bin/legacy-sh`.
//   7. Legacy shell's `SHELL START` witness fires, the shell prompts,
//      smoke driver sends `ls\n`, dispatch_line miss, exec_child forks
//      + execves /bin/ls, ls emits its directory listing, shell
//      reprompts.
//   8. Smoke asserts: ALL fingerprints landed in order, proving (a) the
//      gate decoded the env var, (b) the stub emitted the marker, and
//      (c) the fallback still ran the user's command under the legacy
//      shell.
//
// Expected on-wire fingerprint subsequence:
//
//   SH DISPATCH START
//   sh dispatch mode=semantic (stub)
//   sh dispatch semantic shell not yet available
//   sh dispatch mode=legacy
//   SHELL START
//   <ls output>
//
// Status at M7: SHAPE ONLY. Same deferral as the legacy-mode smoke --
// kernel-side swap in bin_seeds.pdx pending at M7-cont, this file is a
// shape stub documenting the fingerprint sequence the full-AC run will
// assert once the swap lands. See design/shell/sh-dispatch.md §SECTION
// 4 and §SECTION 9.
//
// Replacement when real semantic shell lands (sibling wave):
//   `sh dispatch mode=semantic (stub)` and `sh dispatch semantic shell
//   not yet available` are retired; a real semantic entry fingerprint
//   lands in their place. `sh dispatch mode=legacy` and `SHELL START`
//   drop out of the semantic subsequence (semantic path no longer
//   falls through to legacy). The AC smoke is updated at that landing.

module BootShDispatchSemanticStub = structure {

  // ============================================================================
  // Expected fingerprints (data, not instructions). Wire length excludes NUL.
  // ============================================================================

  pub let fp_dispatch_start : [u8; 19] = "SH DISPATCH START\n\0"
  pub let fp_dispatch_start_len : u64 = 18

  pub let fp_mode_semantic : [u8; 34] = "sh dispatch mode=semantic (stub)\n\0"
  pub let fp_mode_semantic_len : u64 = 33

  pub let fp_semantic_na : [u8; 46] = "sh dispatch semantic shell not yet available\n\0"
  pub let fp_semantic_na_len : u64 = 45

  pub let fp_mode_legacy : [u8; 25] = "sh dispatch mode=legacy\n\0"
  pub let fp_mode_legacy_len : u64 = 24

  pub let fp_shell_start : [u8; 13] = "SHELL START\n\0"
  pub let fp_shell_start_len : u64 = 12

  // Input envp key/value the smoke driver sets.
  pub let in_envp_mode_key : [u8; 16] = "PDX_SHELL_MODE=\0"
  pub let in_envp_mode_key_prefix_len : u64 = 15

  pub let in_envp_mode_val : [u8; 9]  = "semantic\0"
  pub let in_envp_mode_val_len : u64 = 8

  // Command the driver pipes into shell stdin after SHELL START.
  pub let in_cmd : [u8; 4]  = "ls\n\0"
  pub let in_cmd_wire_len : u64 = 3

  // ============================================================================
  // Expected exit code: 0 (legacy fallback shell exited cleanly after builtin+ls).
  // ============================================================================
  pub let exp_exit_code : u64 = 0

  // ============================================================================
  // Stub test entry (declarative placeholder; real driver lives in
  // tools/run-smoke.sh once R222.M7-cont wires the kernel-side swap).
  // ============================================================================
  pub let smoke_boot_sh_dispatch_semantic_stub : () -> u64 !{} @{} =
    fn () -> 0
}
