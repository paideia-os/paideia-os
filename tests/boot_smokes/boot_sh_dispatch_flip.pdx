// tests/boot_smokes/boot_sh_dispatch_flip.pdx
// R229.M11 (paideia-os#2729, umbrella #2493)
//
// SMOKE SHAPE — Default-flip dispatch via /bin/sh with PDX_SHELL_MODE unset.
//
// Rationale: the pre-flip smokes (boot_sh_dispatch_legacy.pdx and
// boot_sh_dispatch_semantic_stub.pdx) cover the two EXPLICIT routing
// cases (user set PDX_SHELL_MODE=legacy or PDX_SHELL_MODE=semantic).
// Neither covers the DEFAULT path that every unset-envp invocation
// now takes at R229.M11. This smoke fills that gap.
//
// Scenario (post-M11 default-flip in sh_dispatch.pdx):
//   1. Caller invokes `/bin/sh` with NO `PDX_SHELL_MODE=` entry in envp
//      (either envp omits the key entirely, or envp is NULL, or envp
//      has 16 unrelated entries — any shape where the key compare
//      exhausts without a match).
//   2. init (or shell exec_child) fork+execves `/bin/sh` which is
//      sh_dispatch.elf (seeded by bin_seeds.pdx since M7-cont).
//   3. sh_dispatch._start emits `SH DISPATCH START` via sys_debug_puts.
//   4. _sd_route scans envp, finds no `PDX_SHELL_MODE=` entry (or
//      envp==0, or cap exhausted). ALL three fall-through branches now
//      target sd_route_semantic (the NEW R229.M11 default) rather than
//      sd_route_legacy (the retired R222.M7 default).
//   5. _sd_semantic_stub emits `sh dispatch mode=semantic (stub)` and
//      `sh dispatch semantic shell not yet available`, then tail-calls
//      _sd_legacy_fallback (the stub body is UNCHANGED at M11 — only
//      _sd_route's routing policy flipped).
//   6. _sd_legacy_fallback emits `sh dispatch mode=legacy` and execves
//      `/bin/legacy-sh` (the hard-linked alias still ships at M11).
//   7. Legacy shell's `SHELL START` witness fires, the shell prompts,
//      smoke driver sends `ls\n`, dispatch_line miss, exec_child forks
//      + execves /bin/ls, ls emits its directory listing, shell
//      reprompts.
//   8. Smoke asserts: ALL fingerprints land in order, proving:
//        (a) the gate reached _start under the unset-envp invocation,
//        (b) the semantic-stub route was chosen (the DEFAULT at M11),
//        (c) the stub's fall-through still runs the user's command.
//      AC: both `/bin/sh` and `/bin/legacy-sh` exit 0.
//
// Expected on-wire fingerprint subsequence:
//
//   SH DISPATCH START
//   sh dispatch mode=semantic (stub)
//   sh dispatch semantic shell not yet available
//   sh dispatch mode=legacy
//   SHELL START
//   <ls output>
//
// Difference from boot_sh_dispatch_semantic_stub.pdx:
//   The semantic-stub smoke has PDX_SHELL_MODE=semantic in envp and
//   asserts the SAME fingerprint sequence. This smoke has NO
//   PDX_SHELL_MODE at all in envp and asserts the SAME sequence. Both
//   paths converge inside _sd_route at sd_route_semantic, but only
//   this smoke proves the DEFAULT (not the explicit opt-in) takes
//   that route.
//
// Replacement when real semantic shell lands (sibling landing per
// design/shell/legacy-shell-retirement.md §5.1):
//   The two stub markers (`sh dispatch mode=semantic (stub)` and
//   `sh dispatch semantic shell not yet available`) retire; a real
//   semantic-entry fingerprint lands in their place. The
//   `sh dispatch mode=legacy` and `SHELL START` markers drop out of
//   the subsequence because the semantic path no longer tail-calls
//   legacy. This smoke's assertion list is updated at that landing.
//
// paideia-as discipline: this file compiles as a module skeleton; the
// executable body lives in the smoke driver (tools/run-smoke.sh +
// kernel-side wiring). Reserved-label discipline not applicable (no
// asm block). Encoder discipline per feedback_pdx_encoder_pitfalls:
// single-line `pub let name : [u8; N] = "..."` literals; byte counts
// equal len(string including trailing newline) + 1 for NUL; wire
// lengths exclude the NUL. Module basename `BootShDispatchFlip`
// matches the file basename `boot_sh_dispatch_flip.pdx` per the
// CamelCase-from-underscored-basename convention (same rule as
// `BootShDispatchLegacy`, `BootShDispatchSemanticStub`, `ChildHello`,
// `PdxProduce`, `ElevateBrokerDaemon`).

module BootShDispatchFlip = structure {

  // ============================================================================
  // Expected fingerprints (data, not instructions). Wire length excludes NUL.
  // Byte counts match the active sh_dispatch.pdx constants:
  //   sd_start_msg          -> 18 wire + 1 NUL = 19 storage
  //   sd_mode_semantic_msg  -> 33 wire + 1 NUL = 34 storage
  //   sd_semantic_na_msg    -> 45 wire + 1 NUL = 46 storage
  //   sd_mode_legacy_msg    -> 24 wire + 1 NUL = 25 storage
  //   shell_start_msg       -> 12 wire + 1 NUL = 13 storage (shell.pdx L20)
  // ============================================================================

  pub let fp_dispatch_start : [u8; 19] = "SH DISPATCH START\n\0"
  pub let fp_dispatch_start_len : u64 = 18

  pub let fp_mode_semantic : [u8; 34] = "sh dispatch mode=semantic (stub)\n\0"
  pub let fp_mode_semantic_len : u64 = 33

  pub let fp_semantic_na : [u8; 46] = "sh dispatch semantic shell not yet available\n\0"
  pub let fp_semantic_na_len : u64 = 45

  pub let fp_mode_legacy : [u8; 25] = "sh dispatch mode=legacy\n\0"
  pub let fp_mode_legacy_len : u64 = 24

  pub let fp_shell_start : [u8; 13] = "SHELL START\n\0"
  pub let fp_shell_start_len : u64 = 12

  // ============================================================================
  // Input discipline — PDX_SHELL_MODE is UNSET.
  //
  // The driver constructs envp with the usual HOME/PATH entries but NO
  // PDX_SHELL_MODE= entry. This proves the DEFAULT fall-through branch
  // in _sd_route reaches sd_route_semantic rather than sd_route_legacy
  // (the inverted R229.M11 polarity).
  // ============================================================================

  // The absent-key sentinel. Present for grep-anchor completeness so a
  // reader auditing the smoke can find the key the invocation deliberately
  // does NOT set.
  pub let unset_envp_mode_key : [u8; 16] = "PDX_SHELL_MODE=\0"
  pub let unset_envp_mode_key_prefix_len : u64 = 15

  // Command the driver pipes into shell stdin after SHELL START.
  pub let in_cmd : [u8; 4]  = "ls\n\0"
  pub let in_cmd_wire_len : u64 = 3

  // ============================================================================
  // Expected exit codes.
  //
  // Both `/bin/sh` and `/bin/legacy-sh` must exit 0:
  //   bin_sh_exit_code      — /bin/sh invocation under R229.M11 default
  //                            (semantic stub -> legacy -> ls -> exit 0)
  //   bin_legacy_exit_code  — direct /bin/legacy-sh invocation (no stub
  //                            markers; legacy shell boots verbatim and
  //                            exits 0 after `ls`).
  // ============================================================================
  pub let bin_sh_exit_code     : u64 = 0
  pub let bin_legacy_exit_code : u64 = 0

  // ============================================================================
  // Stub test entry (declarative placeholder; real driver lives in
  // tools/run-smoke.sh once the kernel-side wiring + envp construction
  // for the unset-mode case is parked beside the two existing dispatch
  // smokes).
  // ============================================================================
  pub let smoke_boot_sh_dispatch_flip : () -> u64 !{} @{} =
    fn () -> 0
}
