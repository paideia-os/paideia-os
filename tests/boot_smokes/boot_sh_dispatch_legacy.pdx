// tests/boot_smokes/boot_sh_dispatch_legacy.pdx
// R222.M7 (paideia-os#2664, umbrella #2486)
//
// SMOKE SHAPE — Legacy-mode dispatch via /bin/sh.
//
// Scenario (post-M7-cont swap in bin_seeds.pdx):
//   1. Caller sets `PDX_SHELL_MODE=legacy` in envp.
//   2. init (or shell exec_child) fork+execves `/bin/sh` which is
//      sh_dispatch.elf once bin_seeds.pdx points /bin/sh at it.
//   3. sh_dispatch._start emits `SH DISPATCH START` via sys_debug_puts.
//   4. _sd_route scans envp, matches `PDX_SHELL_MODE=` prefix, reads the
//      value `legacy\0`, falls through to _sd_legacy_fallback.
//   5. _sd_legacy_fallback emits `sh dispatch mode=legacy` and execves
//      `/bin/legacy-sh` (the hard-linked alias of shell.elf).
//   6. The legacy shell's own `SHELL START` witness fires, the shell
//      prompts, the smoke driver sends `ls\n`, dispatch_line walks the
//      builtin table, misses, exec_child forks + execves /bin/ls.
//   7. ls emits its directory listing; the shell reprompts.
//   8. Smoke asserts: all five fingerprints landed in order.
//
// Expected on-wire fingerprint subsequence (lowercase per the tree's
// skip-fingerprint discipline, except the uppercase start markers which
// mirror the SHELL START / CHILD HELLO convention):
//
//   SH DISPATCH START
//   sh dispatch mode=legacy
//   SHELL START
//   <ls output>
//
// Status at M7: SHAPE ONLY. The kernel-side swap of /bin/sh =
// sh_dispatch.elf and seed of /bin/legacy-sh = shell.elf is deferred to
// M7-cont per design/shell/sh-dispatch.md §SECTION 4. Until then the
// dispatcher runs standalone (invoked via a direct execve of /bin/
// sh_dispatch, not through /bin/sh) and this smoke is a stub.
//
// paideia-as discipline: this file compiles as a module skeleton; the
// executable body lives in the smoke driver and the kernel-side seed
// chain, not in this file. Reserved-label discipline not applicable
// (no asm block).

module BootShDispatchLegacy = structure {

  // ============================================================================
  // Expected fingerprints (data, not instructions). Wire length excludes NUL.
  // ============================================================================

  pub let fp_dispatch_start : [u8; 19] = "SH DISPATCH START\n\0"
  pub let fp_dispatch_start_len : u64 = 18

  pub let fp_mode_legacy : [u8; 25] = "sh dispatch mode=legacy\n\0"
  pub let fp_mode_legacy_len : u64 = 24

  pub let fp_shell_start : [u8; 13] = "SHELL START\n\0"
  pub let fp_shell_start_len : u64 = 12

  // Input envp key/value the smoke driver sets.
  pub let in_envp_mode_key : [u8; 16] = "PDX_SHELL_MODE=\0"
  pub let in_envp_mode_key_prefix_len : u64 = 15

  pub let in_envp_mode_val : [u8; 7]  = "legacy\0"
  pub let in_envp_mode_val_len : u64 = 6

  // Command the driver pipes into shell stdin after SHELL START.
  pub let in_cmd : [u8; 4]  = "ls\n\0"
  pub let in_cmd_wire_len : u64 = 3

  // ============================================================================
  // Expected exit code: 0 (legacy shell exited cleanly after builtin+ls).
  // ============================================================================
  pub let exp_exit_code : u64 = 0

  // ============================================================================
  // Stub test entry (declarative placeholder; real driver lives in
  // tools/run-smoke.sh once R222.M7-cont wires the kernel-side swap).
  // ============================================================================
  pub let smoke_boot_sh_dispatch_legacy : () -> u64 !{} @{} =
    fn () -> 0
}
