// tests/kernel/drivers/wwan/wwan_probe_synth.pdx -- R40.M4-002 (#1359)
//
// Boot witness for wwan_probe. Asserts individual validators (vendor,
// form, bar), refusals across BAD_VENDOR / BAD_PRODUCT / BAD_BAR
// (align + len) / BAD_FORM / ENOSPC, the happy path over two probes
// (Intel + Fibocom), row accessors, and the power-gating seam
// (D0 -> D3 -> D0 accepted, D1/D2 refused, same-state refused).
//
// Fingerprint: WWAN PROBE OK
//
// No cap slots.

module WwanProbeSynth = structure {

  pub let mut _wwpw_stage : u64 = 0

  pub let wwpw_ok   : [u8; 15] = "WWAN PROBE OK\0"
  pub let wwpw_fail : [u8; 17] = "WWAN PROBE FAIL\0"

  pub let wwan_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M4-002 (#1359): boot witness. Stages: (1) reset + arbitration pin. (2) individual validators. (3) BAD_VENDOR. (4) BAD_PRODUCT. (5) BAD_BAR_ALIGN. (6) BAD_BAR_LEN. (7) BAD_FORM. (8) Happy Intel probe. (9) Happy Fibocom probe. (10) Row accessors. (11) ENOSPC. (12) Power D0 -> D3. (13) Power D3 -> D0. (14) Power D1 refused. (15) Power same-state refused. (16) Counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        call wwp_reset;

        call wwp_arbitrated;
        cmp rax, 0;
        jne wwpw_fail_stage;

        // -- 2. Individual validators.
        mov rax, 2;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        call wwp_vendor_valid;
        cmp rax, 1;
        jne wwpw_fail_stage;
        mov rdi, 0x2CB7;
        call wwp_vendor_valid;
        cmp rax, 1;
        jne wwpw_fail_stage;
        mov rdi, 0x1234;
        call wwp_vendor_valid;
        cmp rax, 0;
        jne wwpw_fail_stage;

        mov rdi, 1;
        call wwp_form_valid;
        cmp rax, 1;
        jne wwpw_fail_stage;
        mov rdi, 2;
        call wwp_form_valid;
        cmp rax, 1;
        jne wwpw_fail_stage;
        mov rdi, 3;
        call wwp_form_valid;
        cmp rax, 0;
        jne wwpw_fail_stage;

        mov rdi, 0xE0000000;
        mov rsi, 0x1000;
        call wwp_bar_valid;
        cmp rax, 1;
        jne wwpw_fail_stage;
        mov rdi, 0xE0000001;             // misaligned
        mov rsi, 0x1000;
        call wwp_bar_valid;
        cmp rax, 0;
        jne wwpw_fail_stage;
        mov rdi, 0xE0000000;
        mov rsi, 0x800;                  // too short
        call wwp_bar_valid;
        cmp rax, 0;
        jne wwpw_fail_stage;

        // -- 3. BAD_VENDOR.
        mov rax, 3;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;                 // not Intel/Fibocom
        mov rsi, 0x7360;
        mov rdx, 0xE0000000;
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        mov r11, 0xFFFFF1AF;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 4. BAD_PRODUCT (product=0).
        mov rax, 4;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        mov rsi, 0;
        mov rdx, 0xE0000000;
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        mov r11, 0xFFFFF1AE;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 5. BAD_BAR_ALIGN.
        mov rax, 5;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        mov rsi, 0x7360;
        mov rdx, 0xE0000001;             // misaligned
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        mov r11, 0xFFFFF1AD;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 6. BAD_BAR_LEN.
        mov rax, 6;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        mov rsi, 0x7360;
        mov rdx, 0xE0000000;
        mov rcx, 0x800;                  // too short
        mov r8, 1;
        call wwp_probe_add;
        mov r11, 0xFFFFF1AC;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 7. BAD_FORM.
        mov rax, 7;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        mov rsi, 0x7360;
        mov rdx, 0xE0000000;
        mov rcx, 0x1000;
        mov r8, 3;                       // invalid form
        call wwp_probe_add;
        mov r11, 0xFFFFF1AB;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 8. Happy Intel probe.
        mov rax, 8;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;                 // Intel
        mov rsi, 0x7360;                 // XMM 7360
        mov rdx, 0xE0000000;
        mov rcx, 0x1000;
        mov r8, 1;                       // M.2 3042
        call wwp_probe_add;
        cmp rax, 0;
        jne wwpw_fail_stage;

        // -- 9. Happy Fibocom probe.
        mov rax, 9;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x2CB7;                 // Fibocom
        mov rsi, 0x0007;                 // L850-GL
        mov rdx, 0xE0001000;
        mov rcx, 0x2000;
        mov r8, 2;                       // M.2 3052
        call wwp_probe_add;
        cmp rax, 0;
        jne wwpw_fail_stage;

        call wwp_probe_count_of;
        cmp rax, 2;
        jne wwpw_fail_stage;

        // -- 10. Row accessors.
        mov rax, 10;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wwp_probe_row_vendor;
        mov r11, 0x8086;
        cmp rax, r11;
        jne wwpw_fail_stage;

        mov rdi, 0;
        call wwp_probe_row_product;
        mov r11, 0x7360;
        cmp rax, r11;
        jne wwpw_fail_stage;

        mov rdi, 0;
        call wwp_probe_row_form;
        cmp rax, 1;
        jne wwpw_fail_stage;

        mov rdi, 0;
        call wwp_probe_row_bar_base;
        mov r11, 0xE0000000;
        cmp rax, r11;
        jne wwpw_fail_stage;

        mov rdi, 0;
        call wwp_probe_row_bar_len;
        mov r11, 0x1000;
        cmp rax, r11;
        jne wwpw_fail_stage;

        mov rdi, 1;
        call wwp_probe_row_vendor;
        mov r11, 0x2CB7;
        cmp rax, r11;
        jne wwpw_fail_stage;

        mov rdi, 1;
        call wwp_probe_row_form;
        cmp rax, 2;
        jne wwpw_fail_stage;

        // -- 11. ENOSPC (fill to 4, then refuse fifth).
        mov rax, 11;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        mov rsi, 0x7361;
        mov rdx, 0xE0002000;
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        cmp rax, 0;
        jne wwpw_fail_stage;

        mov rdi, 0x8086;
        mov rsi, 0x7362;
        mov rdx, 0xE0003000;
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        cmp rax, 0;
        jne wwpw_fail_stage;

        // Fifth -- refused.
        mov rdi, 0x8086;
        mov rsi, 0x7363;
        mov rdx, 0xE0004000;
        mov rcx, 0x1000;
        mov r8, 1;
        call wwp_probe_add;
        mov r11, 0xFFFFF1A8;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 12. Power D0 -> D3.
        mov rax, 12;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;
        call wwp_pwr_transition;
        cmp rax, 0;
        jne wwpw_fail_stage;

        call wwp_pwr_last_of;
        cmp rax, 3;
        jne wwpw_fail_stage;

        // -- 13. Power D3 -> D0.
        mov rax, 13;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 0;
        call wwp_pwr_transition;
        cmp rax, 0;
        jne wwpw_fail_stage;

        call wwp_pwr_last_of;
        cmp rax, 0;
        jne wwpw_fail_stage;

        // -- 14. Power D1 refused as target.
        mov rax, 14;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // D1
        call wwp_pwr_transition;
        mov r11, 0xFFFFF1AA;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 15. Same-state refused.
        mov rax, 15;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call wwp_pwr_transition;
        mov r11, 0xFFFFF1A9;
        cmp rax, r11;
        jne wwpw_fail_stage;

        // -- 16. Counter fanout.
        mov rax, 16;
        lea rcx, [rip + _wwpw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ATTEMPTS
        call wwp_stat;
        // Attempts: stages 3, 4, 5, 6, 7, 8, 9, 11(x3) = 10.
        cmp rax, 10;
        jne wwpw_fail_stage;

        mov rdi, 1;                      // ACCEPTED
        call wwp_stat;
        // Accepted: 8, 9, 11(x2) = 4.
        cmp rax, 4;
        jne wwpw_fail_stage;

        mov rdi, 3;                      // PWR_D0
        call wwp_stat;
        cmp rax, 1;                      // stage 13
        jne wwpw_fail_stage;

        mov rdi, 4;                      // PWR_D3
        call wwp_stat;
        cmp rax, 1;                      // stage 12
        jne wwpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wwpw_ok];
        call klog_s1;

        call wwp_reset;
        xor rax, rax;
        jmp wwpw_out;

      wwpw_fail_stage:
        lea rax, [rip + _wwpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wwpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wwp_reset;
        mov rax, 1;

      wwpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
