// tests/kernel/drivers/wwan/mbim_synth.pdx -- R40.M4-003 (#1361)
//
// Boot witness for the MBIM driver. Asserts the control-channel FSM
// (CLOSED -> OPEN -> CONNECTED -> OPEN -> CLOSED), refusals from every
// wrong entry state (BAD_STATE / NOT_OPEN / NOT_CONNECTED /
// ALREADY_OPEN / ALREADY_CONN), the three session verbs, notification
// posting with kind + signal validation, and the get_signal_strength
// readback.
//
// Fingerprint: MBIM OK
//
// No cap slots.

module MbimSynth = structure {

  pub let mut _mbimw_stage : u64 = 0

  pub let mbimw_ok   : [u8; 8] = "MBIM OK\0"
  pub let mbimw_fail : [u8; 10] = "MBIM FAIL\0"

  pub let mbim_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M4-003 (#1361): boot witness. Stages: (1) reset + arbitration pin. (2) close-while-closed NOT_OPEN. (3) connect-while-closed NOT_OPEN. (4) disconnect-while-closed NOT_CONNECTED. (5) open (CLOSED -> OPEN). (6) already-open refused. (7) connect (OPEN -> CONNECTED). (8) already-conn refused. (9) get_signal on connected (default 0). (10) notification SIGNAL_STATE (-50 dBm as 0xFFCE). (11) get_signal reads 0xFFCE. (12) notification bad kind refused. (13) notification bad signal refused. (14) disconnect (CONNECTED -> OPEN). (15) close (OPEN -> CLOSED). (16) session_id > 255 refused. (17) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_reset;

        call mbim_arbitrated;
        cmp rax, 0;
        jne mbimw_fail_stage;

        // -- 2. Close while CLOSED -> NOT_OPEN.
        mov rax, 2;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_close;
        mov r11, 0xFFFFF19D;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 3. Connect while CLOSED -> NOT_OPEN.
        mov rax, 3;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call mbim_connect;
        mov r11, 0xFFFFF19D;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 4. Disconnect while CLOSED -> NOT_CONNECTED.
        mov rax, 4;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_disconnect;
        mov r11, 0xFFFFF19B;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 5. Open.
        mov rax, 5;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_open;
        cmp rax, 0;
        jne mbimw_fail_stage;

        call mbim_state_of;
        cmp rax, 1;                      // OPEN
        jne mbimw_fail_stage;

        // -- 6. Already open.
        mov rax, 6;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_open;
        mov r11, 0xFFFFF19C;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 7. Connect.
        mov rax, 7;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // session_id
        call mbim_connect;
        cmp rax, 0;
        jne mbimw_fail_stage;

        call mbim_state_of;
        cmp rax, 2;                      // CONNECTED
        jne mbimw_fail_stage;

        // -- 8. Already connected.
        mov rax, 8;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call mbim_connect;
        mov r11, 0xFFFFF19A;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 9. get_signal reads 0 by default.
        mov rax, 9;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_get_signal_strength;
        cmp rax, 0;
        jne mbimw_fail_stage;

        // -- 10. Post SIGNAL_STATE notification (-50 dBm as 0xFFCE).
        mov rax, 10;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // SIGNAL_STATE
        mov rsi, 0xFFCE;
        call mbim_notif_post;
        cmp rax, 0;
        jne mbimw_fail_stage;

        call mbim_notif_last_kind;
        cmp rax, 1;
        jne mbimw_fail_stage;

        call mbim_notif_last_raw;
        mov r11, 0xFFCE;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 11. get_signal reads 0xFFCE.
        mov rax, 11;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_get_signal_strength;
        mov r11, 0xFFCE;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 12. Notification with bad kind.
        mov rax, 12;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 5;                      // not in {1,2,3}
        mov rsi, 0;
        call mbim_notif_post;
        mov r11, 0xFFFFF199;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 13. Notification SIGNAL_STATE with signal > 0xFFFF.
        mov rax, 13;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x10000;
        call mbim_notif_post;
        mov r11, 0xFFFFF198;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 14. Disconnect.
        mov rax, 14;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_disconnect;
        cmp rax, 0;
        jne mbimw_fail_stage;

        call mbim_state_of;
        cmp rax, 1;                      // OPEN
        jne mbimw_fail_stage;

        // -- 15. Close.
        mov rax, 15;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        call mbim_close;
        cmp rax, 0;
        jne mbimw_fail_stage;

        call mbim_state_of;
        cmp rax, 0;                      // CLOSED
        jne mbimw_fail_stage;

        // -- 16. Connect with session_id > 255 refused (even in
        // CLOSED, but state check runs after arg check).
        mov rax, 16;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 256;
        call mbim_connect;
        mov r11, 0xFFFFF19E;
        cmp rax, r11;
        jne mbimw_fail_stage;

        // -- 17. Counter fanout.
        mov rax, 17;
        lea rcx, [rip + _mbimw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // OPENS
        call mbim_stat;
        cmp rax, 1;                      // stage 5
        jne mbimw_fail_stage;

        mov rdi, 1;                      // CLOSES
        call mbim_stat;
        cmp rax, 1;                      // stage 15
        jne mbimw_fail_stage;

        mov rdi, 2;                      // CONNECTS
        call mbim_stat;
        cmp rax, 1;                      // stage 7
        jne mbimw_fail_stage;

        mov rdi, 3;                      // DISCONNECTS
        call mbim_stat;
        cmp rax, 1;                      // stage 14
        jne mbimw_fail_stage;

        mov rdi, 4;                      // NOTIFS
        call mbim_stat;
        cmp rax, 1;                      // stage 10
        jne mbimw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mbimw_ok];
        call klog_s1;

        call mbim_reset;
        xor rax, rax;
        jmp mbimw_out;

      mbimw_fail_stage:
        lea rax, [rip + _mbimw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mbimw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mbim_reset;
        mov rax, 1;

      mbimw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
