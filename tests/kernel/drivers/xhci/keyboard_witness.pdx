// tests/kernel/drivers/xhci/keyboard_witness.pdx — R26-M6-005 (#969)
//
// T14 G4 xHCI keyboard input smoke witness.
//
// Owner issue #969 is `gated:hardware`. At R26 close, the witness
// function lands here as a callable ELF symbol (verified via `nm
// build/kernel.elf | grep xhci_keyboard_smoke_witness`). Live
// invocation on the T14 G4 is done manually by the operator via a
// GDB `call xhci_keyboard_smoke_witness()` after attach — see the
// operator recipe at `tools/xhci-keyboard-smoke.md` for the full
// BIOS-toggle + GDB-attach ceremony.
//
// -----------------------------------------------------------------------------
// What this witness PROVES on live hardware
// -----------------------------------------------------------------------------
//
// (a) At least one xHCI controller landed on the R26.M1 probe path
//     (`_xhci_device_count > 0` — checked by the SKIP guard).
//
// (b) The R26.M6 HID stack is byte-callable: the witness synthesises
//     a fake 8-byte HID Boot Keyboard report ({modifiers=0,
//     reserved=0, key='a'=0x04, 0, 0, 0, 0, 0}) into a .bss scratch,
//     calls hid_process_report(&scratch), and verifies the byte 'a'
//     lands in _tty_line_buf.
//
// (c) The R26.M6 HID -> TTY bridge (hid_bridge_to_tty) forwards the
//     byte through tty_process_input (R16.M5 cooked-mode router).
//
// The witness deliberately does NOT chain full xHCI EP1-IN polling —
// live-report capture from the physical keyboard is the R27
// driver-attach scope (event ring walker + xhci_hotplug_handler_event
// wire).
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove at R26.M6
// -----------------------------------------------------------------------------
//
// - Live capture of user keystrokes from the physical T14 G4 keyboard.
//   That path requires (i) the R27 driver-attach ceremony to fire on
//   the hotplug edge (port_reset -> enable_slot -> ... ->
//   configure_ep_hid) and (ii) an IRQ walker on the event ring that
//   dispatches Transfer Events (TRB Type 32) to
//   hid_process_report(report_pa). Both land at R27+.
//
// - Under QEMU-TCG `-kernel` boot, _xhci_device_count == 0 (no MCFG ->
//   PCI enumerator drains empty -> no xHCI controllers surface), so
//   this witness always takes the SKIP branch. The witness's body
//   under -kernel emits "XHCI KBD SMOKE SKIP no controllers\n" and
//   returns 0.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   BEGIN                "XHCI KBD SMOKE BEGIN\n"                (21 + \0)
//   SKIP                 "XHCI KBD SMOKE SKIP no controllers\n"  (35 + \0)
//   TRANSLATE OK         "XHCI KBD SMOKE TRANSLATE OK\n"         (28 + \0)
//   TRANSLATE FAIL       "XHCI KBD SMOKE TRANSLATE FAIL\n"       (30 + \0)
//   REPORT OK            "XHCI KBD SMOKE REPORT OK\n"            (25 + \0)
//   HID KEY <char> fires as a side-effect of hid_process_report on the
//   synthetic 'a' input.
//   END                  "XHCI KBD SMOKE END\n"                  (19 + \0)
//
// -----------------------------------------------------------------------------
// Synthetic HID report layout (per USB HID 1.11 §B.1)
// -----------------------------------------------------------------------------
//
//   +0  0x00                       modifiers (no shift)
//   +1  0x00                       reserved
//   +2  0x04                       usage 'a'
//   +3  0x00                       (empty slot)
//   +4  0x00
//   +5  0x00
//   +6  0x00
//   +7  0x00
//
// -----------------------------------------------------------------------------
// Register plan (2-push callee-save + 8 B align)
// -----------------------------------------------------------------------------
//
//   rbx = _xhci_device_count (checked for SKIP)
//   rbp = ASCII byte returned by hid_translate (for the TRANSLATE
//         phase — 0x61 = 'a' expected)
//
//   2 pushes = 16 B; entry rsp%16==8 -> 24, sub rsp,8 -> 32, %16==0
//   (aligned for nested hid_translate + hid_process_report calls).

module KeyboardWitness = structure {

  pub let _xhci_kbd_begin_msg     : [u8; 22] = "XHCI KBD SMOKE BEGIN\n\0"
  pub let _xhci_kbd_skip_msg      : [u8; 36] = "XHCI KBD SMOKE SKIP no controllers\n\0"
  pub let _xhci_kbd_xlate_ok_msg  : [u8; 29] = "XHCI KBD SMOKE TRANSLATE OK\n\0"
  pub let _xhci_kbd_xlate_fail_msg: [u8; 31] = "XHCI KBD SMOKE TRANSLATE FAIL\n\0"
  pub let _xhci_kbd_report_ok_msg : [u8; 26] = "XHCI KBD SMOKE REPORT OK\n\0"
  pub let _xhci_kbd_end_msg       : [u8; 20] = "XHCI KBD SMOKE END\n\0"

  // 8-byte scratch report — populated in-place by the witness body.
  pub let mut _xhci_kbd_smoke_report : [u8; 8] = uninit @align(8)

  // ============================================================================
  // xhci_keyboard_smoke_witness() -> u64
  // ============================================================================
  //
  // Returns:
  //   0 = pass (either SKIP-under-no-controllers or full-happy-path).
  //   1 = fail (translate returned unexpected ASCII byte).

  pub let xhci_keyboard_smoke_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M6-005 (#969, gated:hardware). Structural witness for the T14 G4 xHCI keyboard input smoke. Live invocation runs under GDB (see tools/xhci-keyboard-smoke.md). Body: (1) 2-push callee-save + sub rsp,8 align — 32 B; entry rsp%16==8 -> aligned for every nested call. (2) Emit BEGIN. (3) SKIP guard: rax = [rip + _xhci_device_count]; if 0 -> emit SKIP + END + return 0 (matches nvme_hw_smoke_witness pattern). (4) TRANSLATE phase: mov rdi, 0x04 (usage 'a'); xor rsi, rsi (no modifiers); call hid_translate. Save rax in rbp. cmp rbp, 0x61 ('a'); jne xlate_fail; emit TRANSLATE OK; else emit TRANSLATE FAIL + END + return 1. (5) REPORT phase: populate _xhci_kbd_smoke_report bytewise: [0]=0, [1]=0, [2]=0x04, [3..7]=0 via mov_b stores. lea rdi, [rip + _xhci_kbd_smoke_report]; call hid_process_report. Side effect: emits `HID KEY a\\n` fingerprint + pushes 'a' into _tty_line_buf via tty_process_input. Emit REPORT OK. (6) Emit END. Return 0. Reserved labels: `xhci_kbd_`.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        xor rbp, rbp;

        // ---- (1) Emit BEGIN ----
        lea rdi, [rip + _xhci_kbd_begin_msg];
        call uart_puts;

        // ---- (2) SKIP guard: no xHCI controllers ----
        mov rax, [rip + _xhci_device_count];
        cmp rax, 0;
        jne xhci_kbd_run;

        lea rdi, [rip + _xhci_kbd_skip_msg];
        call uart_puts;

        lea rdi, [rip + _xhci_kbd_end_msg];
        call uart_puts;

        xor rax, rax;
        jmp xhci_kbd_done;

      xhci_kbd_run:
        // ---- (3) TRANSLATE phase ----
        mov rdi, 0x04;                           // usage 'a'
        xor rsi, rsi;                            // no modifiers
        call hid_translate;
        mov rbp, rax;

        cmp rbp, 0x61;
        jne xhci_kbd_xlate_fail;

        lea rdi, [rip + _xhci_kbd_xlate_ok_msg];
        call uart_puts;

        // ---- (4) REPORT phase — populate synthetic report + dispatch ----
        // byte[0] = modifiers = 0
        xor rax, rax;
        lea rcx, [rip + _xhci_kbd_smoke_report];
        mov_b [rcx + 0], rax;
        // byte[1] = reserved = 0
        mov_b [rcx + 1], rax;
        // byte[2] = usage 'a' = 0x04
        mov rdx, 0x04;
        mov_b [rcx + 2], rdx;
        // bytes[3..7] = 0
        mov_b [rcx + 3], rax;
        mov_b [rcx + 4], rax;
        mov_b [rcx + 5], rax;
        mov_b [rcx + 6], rax;
        mov_b [rcx + 7], rax;

        lea rdi, [rip + _xhci_kbd_smoke_report];
        call hid_process_report;

        lea rdi, [rip + _xhci_kbd_report_ok_msg];
        call uart_puts;

        lea rdi, [rip + _xhci_kbd_end_msg];
        call uart_puts;

        xor rax, rax;
        jmp xhci_kbd_done;

      xhci_kbd_xlate_fail:
        lea rdi, [rip + _xhci_kbd_xlate_fail_msg];
        call uart_puts;

        lea rdi, [rip + _xhci_kbd_end_msg];
        call uart_puts;

        mov rax, 1;

      xhci_kbd_done:
        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
