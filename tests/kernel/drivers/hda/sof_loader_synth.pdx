// tests/kernel/drivers/hda/sof_loader_synth.pdx -- R33.M6-001 (#1162)
//
// Boot witness for the SOF FIRMWARE LOADER scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the arbitration pin (0), the bind refusals (BAD_FW_PTR,
// BAD_FW_LEN below and above bound, REBIND on second bind), the
// advance discipline (NOT_BOUND before bind, NOT_VERIFIED before
// mark_verified, BAD_STAGE past STAGE_READY), and one-way stage
// advance from ROM through READY (four calls to advance).
//
// IT ASSERTS NOTHING ABOUT A REAL DSP HANDSHAKE. sof_loader.pdx §4
// documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 SOF LOADER OK

module SofLoaderSynth = structure {

  pub let mut _hda_sl_w_stage : u64 = 0

  pub let hda_sl_w_ok   : [u8; 14] = "SOF LOADER OK\0"
  pub let hda_sl_w_fail : [u8; 16] = "SOF LOADER FAIL\0"

  // A dummy firmware region: 64 bytes of static bytes, well within
  // HDA_SOF_FW_MAX_LEN (4 MiB) and non-null.
  pub let _hda_sl_w_fw_region : [u8; 64] = "SOF firmware placeholder witness bytes 0123456789ABCDEF Paideia"

  pub let sof_loader_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M6-001 (#1162): boot witness for the SOF loader scaffold. Stages: (S10) arbitrated == 0. (S20) bound == 0 initially. (S30) bind(0, 64) -> BAD_FW_PTR. (S40) bind(region, 0) -> BAD_FW_LEN. (S50) bind(region, 0x00500000) -> BAD_FW_LEN (above 4 MiB). (S60) bind(region, 64) -> OK; bound == 1; stage == 0. (S70) advance before mark_verified -> NOT_VERIFIED. (S80) mark_verified; advance -> stage 1; advance -> stage 2; advance -> stage 3; ready() == 1. (S90) fifth advance -> BAD_STAGE. (S100) second bind -> REBIND. Teardown: reset() so a subsequent run starts clean. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_sl_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        call hda_sof_loader_reset;

        // S10 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_arbitrated;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;

        // S20 -- bound == 0 initially.
        mov rax, 20;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_bound;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;

        // S30 -- bind(0, 64) -> BAD_FW_PTR.
        mov rax, 30;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 64;
        call hda_sof_loader_bind;
        mov r11, 0xFFFFFC8F;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // S40 -- bind(region, 0) -> BAD_FW_LEN.
        mov rax, 40;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sl_w_fw_region];
        xor rsi, rsi;
        call hda_sof_loader_bind;
        mov r11, 0xFFFFFC8E;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // S50 -- bind(region, 0x00500000) -> BAD_FW_LEN.
        mov rax, 50;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sl_w_fw_region];
        mov rsi, 0x00500000;
        call hda_sof_loader_bind;
        mov r11, 0xFFFFFC8E;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // S60 -- bind(region, 64) -> OK; bound; stage == 0.
        mov rax, 60;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sl_w_fw_region];
        mov rsi, 64;
        call hda_sof_loader_bind;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_bound;
        cmp rax, 1;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_stage;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;

        // S70 -- advance before mark_verified -> NOT_VERIFIED.
        mov rax, 70;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_advance;
        mov r11, 0xFFFFFC8B;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // S80 -- mark_verified; three advances -> stage 3; ready.
        mov rax, 80;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_mark_verified;
        call hda_sof_loader_advance;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_stage;
        cmp rax, 1;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_advance;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_advance;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_stage;
        cmp rax, 3;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_ready;
        cmp rax, 1;
        jne hda_sl_w_fail_stage;

        // S90 -- fifth advance -> BAD_STAGE.
        mov rax, 90;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_advance;
        mov r11, 0xFFFFFC8A;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // S100 -- second bind -> REBIND.
        mov rax, 100;
        lea rcx, [rip + _hda_sl_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sl_w_fw_region];
        mov rsi, 64;
        call hda_sof_loader_bind;
        mov r11, 0xFFFFFC8D;
        cmp rax, r11;
        jne hda_sl_w_fail_stage;

        // Teardown: leave loader in a READY state so the sof_effects
        // witness downstream can exercise its NOT_READY gate flip.
        call hda_sof_loader_reset;
        lea rdi, [rip + _hda_sl_w_fw_region];
        mov rsi, 64;
        call hda_sof_loader_bind;
        cmp rax, 0;
        jne hda_sl_w_fail_stage;
        call hda_sof_loader_mark_verified;
        call hda_sof_loader_advance;
        call hda_sof_loader_advance;
        call hda_sof_loader_advance;
        call hda_sof_loader_ready;
        cmp rax, 1;
        jne hda_sl_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sl_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_sl_w_out;

      hda_sl_w_fail_stage:
        lea rax, [rip + _hda_sl_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sl_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_sl_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
