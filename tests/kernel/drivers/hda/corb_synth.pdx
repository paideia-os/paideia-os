// tests/kernel/drivers/hda/corb_synth.pdx — R33.M1-003 (#1139)
//
// Boot witness for the HDA CORB (Command Output Ring Buffer) SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the init latch (BAD_ALIGN / BAD_SIZE refusals, the REBIND
// refusal on second init), the arbitration pin (0 -- the honesty
// function), the refusal discipline on submit (NOT_INITIALISED before
// init, BAD_VERB for a 33-bit verb), and the DEFERRED_HARDWARE outcome
// on the happy path. IT ASSERTS NOTHING ABOUT A REAL CORB DMA WRITE
// OR A REAL WP/RP HANDSHAKE, because none runs in this tree --
// hda/corb.pdx §4 documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA CORB OK

module CorbSynth = structure {

  pub let mut _hda_cb_w_stage : u64 = 0

  pub let hda_cb_w_ok   : [u8; 12] = "HDA CORB OK\0"
  pub let hda_cb_w_fail : [u8; 14] = "HDA CORB FAIL\0"

  pub let hda_corb_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M1-003 (#1139): boot witness for the HDA CORB scaffold. Stages: (S1) bound() = 0 before init; arbitrated() = 0 (honesty pin). (S2) submit(0) before init -> NOT_INITIALISED. (S3) init(ring_pa=0x100, size_code=3) -> BAD_SIZE (out of {0,1,2}). (S4) init(ring_pa=0x105, size_code=2) -> BAD_ALIGN (not 128-byte-aligned). (S5) init(ring_pa=0x1000, size_code=2) -> OK; bound() = 1; ring_pa() == 0x1000; size_code() == 2; arbitrated() STILL 0. (S6) submit(0x100000000) -> BAD_VERB (33 bits). (S7) submit(0xF0100710) -> DEFERRED_HARDWARE. submits() advanced by exactly one. (S8) init a second time -> REBIND. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_cb_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- bound() = 0, arbitrated() = 0.
        mov rax, 10;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        call hda_corb_bound;
        cmp rax, 0;
        jne hda_cb_w_fail_stage;

        call hda_corb_arbitrated;
        cmp rax, 0;
        jne hda_cb_w_fail_stage;

        // S2 -- submit before init -> NOT_INITIALISED.
        mov rax, 20;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call hda_corb_submit;
        mov r11, 0xFFFFFC6F;             // NOT_INITIALISED
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        // S3 -- init with size_code = 3 -> BAD_SIZE.
        mov rax, 30;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 3;
        call hda_corb_init;
        mov r11, 0xFFFFFC6D;             // BAD_SIZE
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        // S4 -- init with ring_pa misaligned -> BAD_ALIGN.
        mov rax, 40;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x105;                  // 0x105 & 0x7F != 0
        mov rsi, 2;
        call hda_corb_init;
        mov r11, 0xFFFFFC6E;             // BAD_ALIGN
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        // S5 -- init OK; bound = 1; ring_pa == 0x1000; size_code == 2.
        mov rax, 50;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 2;
        call hda_corb_init;
        cmp rax, 0;
        jne hda_cb_w_fail_stage;

        call hda_corb_bound;
        cmp rax, 1;
        jne hda_cb_w_fail_stage;

        call hda_corb_ring_pa;
        mov r11, 0x1000;
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        call hda_corb_size_code;
        cmp rax, 2;
        jne hda_cb_w_fail_stage;

        call hda_corb_arbitrated;
        cmp rax, 0;
        jne hda_cb_w_fail_stage;

        // S6 -- submit(33-bit verb) -> BAD_VERB.
        mov rax, 60;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x100000000;
        call hda_corb_submit;
        mov r11, 0xFFFFFC6B;             // BAD_VERB
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        // S7 -- submit(happy) -> DEFERRED_HARDWARE.
        mov rax, 70;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        call hda_corb_submits;
        mov rbx, rax;                    // submits before

        mov rdi, 0xF0100710;             // codec 0xF, node 0x01, verb 0x00710
        call hda_corb_submit;
        mov r11, 0xFFFFFC6C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        call hda_corb_submits;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_cb_w_fail_stage;

        // S8 -- second init -> REBIND.
        mov rax, 80;
        lea rcx, [rip + _hda_cb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 2;
        call hda_corb_init;
        mov r11, 0xFFFFFC6A;             // REBIND
        cmp rax, r11;
        jne hda_cb_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_cb_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_cb_w_out;

      hda_cb_w_fail_stage:
        lea rax, [rip + _hda_cb_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_cb_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_cb_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
