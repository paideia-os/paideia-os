// tests/kernel/drivers/hda/alc287_mic_synth.pdx -- R33.M4-003 (#1154)
//
// Boot witness for the ALC287 MIC PATH scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// arbitrated == 0, BAD_ADDR gate, bind() OK on initialised codec,
// select(INTERNAL) OK, select(EXTERNAL) OK, select(2) refused
// BAD_WHICH, select() before bind returns NOT_BOUND, nc_enable() OK
// after bind, nc_enable() before bind returns NOT_BOUND.
//
// RUNS AFTER alc287_init_witness (needs init_bound()) and after
// verbs_witness (needs CORB/RIRB bound).
//
// IT ASSERTS NOTHING ABOUT REAL MIC INPUT DATA.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 ALC287 MIC OK

module Alc287MicSynth = structure {

  pub let mut _hda_mc_w_stage : u64 = 0

  pub let hda_mc_w_ok   : [u8; 14] = "ALC287 MIC OK\0"
  pub let hda_mc_w_fail : [u8; 16] = "ALC287 MIC FAIL\0"

  pub let alc287_mic_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M4-003 (#1154): boot witness for the ALC287 mic path scaffold. Stages: (S1) arbitrated == 0. (S2) bind(16) -> BAD_ADDR. (S3) bind(0) -> OK; bound == 1. (S4) select(0=INTERNAL) -> OK; ST_SEL_INT +=1; ST_ACTIVE == 0. (S5) select(1=EXTERNAL) -> OK; ST_SEL_EXT +=1; ST_ACTIVE == 1. (S6) select(2) -> BAD_WHICH. (S7) nc_enable() -> OK; ST_NC_CALLS +=1; ST_NC_ENABLED == 1. (S8) reset(); select(0) -> NOT_BOUND; nc_enable() -> NOT_BOUND. Teardown: rebind for downstream witnesses. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_mc_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        call hda_alc287_mic_reset;

        // S1
        mov rax, 10;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        call hda_alc287_mic_arbitrated;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;

        // S2 -- bind(16) -> BAD_ADDR.
        mov rax, 20;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        call hda_alc287_mic_bind;
        mov r11, 0xFFFFFCEF;
        cmp rax, r11;
        jne hda_mc_w_fail_stage;

        // S3 -- bind(0) -> OK; bound == 1.
        mov rax, 30;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_alc287_mic_bind;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;
        call hda_alc287_mic_bound;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;

        // S4 -- select(0) OK; ST_SEL_INT +=1; ST_ACTIVE == 0.
        mov rax, 40;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // ST_SEL_INT
        call hda_alc287_mic_stat;
        mov rbx, rax;
        xor rdi, rdi;                    // INTERNAL
        call hda_alc287_mic_select;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;
        mov rdi, 1;
        call hda_alc287_mic_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;
        mov rdi, 10;                     // ST_ACTIVE
        call hda_alc287_mic_stat;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;

        // S5 -- select(1) OK; ST_SEL_EXT +=1; ST_ACTIVE == 1.
        mov rax, 50;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // ST_SEL_EXT
        call hda_alc287_mic_stat;
        mov rbx, rax;
        mov rdi, 1;                      // EXTERNAL
        call hda_alc287_mic_select;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;
        mov rdi, 2;
        call hda_alc287_mic_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;
        mov rdi, 10;
        call hda_alc287_mic_stat;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;

        // S6 -- select(2) -> BAD_WHICH.
        mov rax, 60;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call hda_alc287_mic_select;
        mov r11, 0xFFFFFCEC;
        cmp rax, r11;
        jne hda_mc_w_fail_stage;

        // S7 -- nc_enable() -> OK; ST_NC_CALLS +=1; ST_NC_ENABLED == 1.
        mov rax, 70;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // ST_NC_CALLS
        call hda_alc287_mic_stat;
        mov rbx, rax;
        call hda_alc287_mic_nc_enable;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;
        mov rdi, 3;
        call hda_alc287_mic_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;
        mov rdi, 11;                     // ST_NC_ENABLED
        call hda_alc287_mic_stat;
        cmp rax, 1;
        jne hda_mc_w_fail_stage;

        // S8 -- reset(); select and nc_enable both -> NOT_BOUND.
        mov rax, 80;
        lea rcx, [rip + _hda_mc_w_stage];
        mov [rcx], rax;
        call hda_alc287_mic_reset;
        xor rdi, rdi;
        call hda_alc287_mic_select;
        mov r11, 0xFFFFFCED;
        cmp rax, r11;
        jne hda_mc_w_fail_stage;
        call hda_alc287_mic_nc_enable;
        mov r11, 0xFFFFFCED;
        cmp rax, r11;
        jne hda_mc_w_fail_stage;

        // Teardown: rebind.
        xor rdi, rdi;
        call hda_alc287_mic_bind;
        cmp rax, 0;
        jne hda_mc_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_mc_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_mc_w_out;

      hda_mc_w_fail_stage:
        lea rax, [rip + _hda_mc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_mc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_mc_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
