// tests/kernel/drivers/hda/bdl_synth.pdx — R33.M3-002 (#1148)
//
// Boot witness for the HDA BDL scaffold.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//   R33 HDA BDL OK

module BdlSynth = structure {

  pub let mut _hda_bdl_w_stage : u64 = 0

  pub let hda_bdl_w_ok   : [u8; 15] = "R33 HDA BDL OK\0"
  pub let hda_bdl_w_fail : [u8; 17] = "R33 HDA BDL FAIL\0"

  pub let hda_bdl_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M3-002 (#1148): boot witness for HDA BDL scaffold. Stages: (S1) bound() == 0, arbitrated() == 0. (S2) populate before init -> NOT_INITIALISED. (S3) init(pa=0x40, entries=1) -> BAD_COUNT (< 2). (S4) init(pa=0x40, entries=257) -> BAD_COUNT (> 256). (S5) init(pa=0x101, entries=4) -> BAD_ALIGN. (S6) init(pa=0x2000, entries=4) -> OK; bound() == 1; entries() == 4; cbl() == 0. (S7) populate(index=4, ...) -> BAD_INDEX. (S8) populate(index=0, pa=0x101, len=1024, flags=0) -> BAD_ALIGN. (S9) populate(index=0, pa=0x3000, len=0, flags=0) -> BAD_LENGTH. (S10) populate(index=0, pa=0x3000, len=1024, flags=2) -> BAD_FLAGS. (S11) populate(index=0, pa=0x3000, len=1024, flags=1) -> OK; entry_pa(0) == 0x3000, entry_length(0) == 1024, entry_flags(0) == 1, cbl() == 1024. (S12) populate(index=1, pa=0x3400, len=2048, flags=0) -> OK; cbl() == 3072. (S13) program(0) -> DEFERRED_HARDWARE; programs() advanced. (S14) init again -> REBIND. Both exits scrub. Labels prefixed hda_bdl_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        call hda_bdl_reset;

        // S1.
        mov rax, 10;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        call hda_bdl_bound;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;
        call hda_bdl_arbitrated;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        // S2.
        mov rax, 20;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1000;
        mov rdx, 1024;
        mov rcx, 0;
        call hda_bdl_populate;
        mov r11, 0xFFFFFC4F;             // NOT_INITIALISED
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S3 -- entries < MIN.
        mov rax, 30;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x40;
        mov rsi, 1;
        call hda_bdl_init;
        mov r11, 0xFFFFFC4D;             // BAD_COUNT
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S4 -- entries > MAX.
        mov rax, 40;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x40;
        mov rsi, 257;
        call hda_bdl_init;
        mov r11, 0xFFFFFC4D;
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S5 -- pa not aligned.
        mov rax, 50;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x101;
        mov rsi, 4;
        call hda_bdl_init;
        mov r11, 0xFFFFFC4E;             // BAD_ALIGN
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S6 -- init OK.
        mov rax, 60;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x2000;
        mov rsi, 4;
        call hda_bdl_init;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_bound;
        cmp rax, 1;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_entries;
        cmp rax, 4;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_cbl;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        // S7 -- populate BAD_INDEX.
        mov rax, 70;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0x3000;
        mov rdx, 1024;
        mov rcx, 0;
        call hda_bdl_populate;
        mov r11, 0xFFFFFC4C;             // BAD_INDEX
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S8 -- populate BAD_ALIGN.
        mov rax, 80;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x101;
        mov rdx, 1024;
        mov rcx, 0;
        call hda_bdl_populate;
        mov r11, 0xFFFFFC4E;             // BAD_ALIGN
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S9 -- populate BAD_LENGTH (zero).
        mov rax, 90;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x3000;
        mov rdx, 0;
        mov rcx, 0;
        call hda_bdl_populate;
        mov r11, 0xFFFFFC4B;             // BAD_LENGTH
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S10 -- populate BAD_FLAGS.
        mov rax, 100;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x3000;
        mov rdx, 1024;
        mov rcx, 2;                      // bit 1 is reserved
        call hda_bdl_populate;
        mov r11, 0xFFFFFC4A;             // BAD_FLAGS
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // S11 -- populate OK, entry 0.
        mov rax, 110;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x3000;
        mov rdx, 1024;
        mov rcx, 1;                      // IOC
        call hda_bdl_populate;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        mov rdi, 0;
        call hda_bdl_entry_pa;
        mov r11, 0x3000;
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        mov rdi, 0;
        call hda_bdl_entry_length;
        cmp rax, 1024;
        jne hda_bdl_w_fail_stage;

        mov rdi, 0;
        call hda_bdl_entry_flags;
        cmp rax, 1;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_cbl;
        cmp rax, 1024;
        jne hda_bdl_w_fail_stage;

        // S12 -- populate entry 1.
        mov rax, 120;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x3400;
        mov rdx, 2048;
        mov rcx, 0;
        call hda_bdl_populate;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_cbl;
        cmp rax, 3072;
        jne hda_bdl_w_fail_stage;

        // S13 -- program.
        mov rax, 130;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        call hda_bdl_programs;
        mov rbx, rax;

        mov rdi, 0;
        call hda_bdl_program;
        mov r11, 0xFFFFFC48;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        call hda_bdl_programs;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_bdl_w_fail_stage;

        // S14 -- REBIND.
        mov rax, 140;
        lea rcx, [rip + _hda_bdl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x2000;
        mov rsi, 4;
        call hda_bdl_init;
        mov r11, 0xFFFFFC49;             // REBIND
        cmp rax, r11;
        jne hda_bdl_w_fail_stage;

        // Arbitrated STILL 0.
        call hda_bdl_arbitrated;
        cmp rax, 0;
        jne hda_bdl_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_bdl_w_ok];
        call klog_s1;
        call hda_bdl_reset;
        xor rax, rax;
        jmp hda_bdl_w_out;

      hda_bdl_w_fail_stage:
        lea rax, [rip + _hda_bdl_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_bdl_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hda_bdl_reset;
        mov rax, 1;

      hda_bdl_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
