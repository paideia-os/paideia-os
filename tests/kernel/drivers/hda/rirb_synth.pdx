// tests/kernel/drivers/hda/rirb_synth.pdx — R33.M1-004 (#1140)
//
// Boot witness for the HDA RIRB (Response Input Ring Buffer) SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the init latch (BAD_ALIGN / BAD_SIZE refusals, the REBIND
// refusal on second init), the arbitration pin (0 -- the honesty
// function), the refusal discipline on consume (NOT_INITIALISED before
// init, BAD_KIND for kind > 1), and the DEFERRED_HARDWARE outcome on
// both SOLICITED and UNSOLICITED classifications. IT ASSERTS NOTHING
// ABOUT A REAL DMA RESPONSE READ OR A REAL EX-BIT CLASSIFICATION,
// because none runs in this tree -- hda/rirb.pdx §4 documents the
// gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA RIRB OK

module RirbSynth = structure {

  pub let mut _hda_rb_w_stage : u64 = 0

  pub let hda_rb_w_ok   : [u8; 16] = "R33 HDA RIRB OK\0"
  pub let hda_rb_w_fail : [u8; 18] = "R33 HDA RIRB FAIL\0"

  pub let hda_rirb_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M1-004 (#1140): boot witness for the HDA RIRB scaffold. Stages: (S1) bound() = 0 before init; arbitrated() = 0 (honesty pin). (S2) consume(SOLICITED) before init -> NOT_INITIALISED. (S3) init(ring_pa=0x100, size_code=3) -> BAD_SIZE. (S4) init(ring_pa=0x108, size_code=2) -> BAD_ALIGN (0x108 & 0x7F != 0). (S5) init(ring_pa=0x2000, size_code=2) -> OK; bound() = 1; ring_pa() == 0x2000; size_code() == 2; arbitrated() STILL 0. (S6) consume(2) -> BAD_KIND (out of {0,1}). (S7) consume(SOLICITED) -> DEFERRED_HARDWARE. solicited() advanced by exactly one. (S8) consume(UNSOLICITED) -> DEFERRED_HARDWARE. unsolicited() advanced by exactly one. (S9) init a second time -> REBIND. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_rb_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- bound() = 0, arbitrated() = 0.
        mov rax, 10;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        call hda_rirb_bound;
        cmp rax, 0;
        jne hda_rb_w_fail_stage;

        call hda_rirb_arbitrated;
        cmp rax, 0;
        jne hda_rb_w_fail_stage;

        // S2 -- consume before init -> NOT_INITIALISED.
        mov rax, 20;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // SOLICITED
        call hda_rirb_consume;
        mov r11, 0xFFFFFC7F;             // NOT_INITIALISED
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        // S3 -- init with size_code = 3 -> BAD_SIZE.
        mov rax, 30;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 3;
        call hda_rirb_init;
        mov r11, 0xFFFFFC7D;             // BAD_SIZE
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        // S4 -- misaligned ring_pa -> BAD_ALIGN.
        mov rax, 40;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x108;                  // 0x108 & 0x7F = 0x08 != 0
        mov rsi, 2;
        call hda_rirb_init;
        mov r11, 0xFFFFFC7E;             // BAD_ALIGN
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        // S5 -- init OK; bound = 1; ring_pa == 0x2000; size_code == 2.
        mov rax, 50;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x2000;
        mov rsi, 2;
        call hda_rirb_init;
        cmp rax, 0;
        jne hda_rb_w_fail_stage;

        call hda_rirb_bound;
        cmp rax, 1;
        jne hda_rb_w_fail_stage;

        call hda_rirb_ring_pa;
        mov r11, 0x2000;
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        call hda_rirb_size_code;
        cmp rax, 2;
        jne hda_rb_w_fail_stage;

        call hda_rirb_arbitrated;
        cmp rax, 0;
        jne hda_rb_w_fail_stage;

        // S6 -- consume(2) -> BAD_KIND.
        mov rax, 60;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call hda_rirb_consume;
        mov r11, 0xFFFFFC7B;             // BAD_KIND
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        // S7 -- consume(SOLICITED) -> DEFERRED_HARDWARE.
        mov rax, 70;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        call hda_rirb_solicited;
        mov rbx, rax;                    // solicited before

        mov rdi, 0;                      // SOLICITED
        call hda_rirb_consume;
        mov r11, 0xFFFFFC7C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        call hda_rirb_solicited;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_rb_w_fail_stage;

        // S8 -- consume(UNSOLICITED) -> DEFERRED_HARDWARE.
        mov rax, 80;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        call hda_rirb_unsolicited;
        mov r13, rax;                    // unsolicited before

        mov rdi, 1;                      // UNSOLICITED
        call hda_rirb_consume;
        mov r11, 0xFFFFFC7C;
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        call hda_rirb_unsolicited;
        sub rax, r13;
        cmp rax, 1;
        jne hda_rb_w_fail_stage;

        // S9 -- second init -> REBIND.
        mov rax, 90;
        lea rcx, [rip + _hda_rb_w_stage];
        mov [rcx], rax;

        mov rdi, 0x2000;
        mov rsi, 2;
        call hda_rirb_init;
        mov r11, 0xFFFFFC7A;             // REBIND
        cmp rax, r11;
        jne hda_rb_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_rb_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_rb_w_out;

      hda_rb_w_fail_stage:
        lea rax, [rip + _hda_rb_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_rb_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_rb_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
