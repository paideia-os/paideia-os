// tests/kernel/drivers/hda/alc287_jack_synth.pdx -- R33.M4-004 (#1155)
//
// Boot witness for the ALC287 JACK-DETECTION scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// arbitrated == 0, arm(16) -> BAD_ADDR, arm(0) OK and latches, isr()
// before arm -> NOT_ARMED (checked before arm), publish(2) -> BAD_STATE,
// publish(1) and publish(0) both OK with ST_PUBLISHED bumps, isr(0xAB,
// subtag) -> UNKNOWN_TAG, isr(0x01, 0x01) -> OK triggers publish +
// auto_switch (ST_JACK_STATE == 1), isr(0x01, 0x00) -> OK
// (ST_JACK_STATE == 0), and reset() clears state.
//
// RUNS AFTER alc287_hp_spk_witness so auto_switch can succeed; after
// alc287_init_witness (init_bound needed); after verbs_witness.
//
// IT ASSERTS NOTHING ABOUT A REAL INTERRUPT ENTRY OR A REAL RIRB
// UNSOLICITED FRAME.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 ALC287 JACK OK

module Alc287JackSynth = structure {

  pub let mut _hda_jk_w_stage : u64 = 0

  pub let hda_jk_w_ok   : [u8; 19] = "R33 ALC287 JACK OK\0"
  pub let hda_jk_w_fail : [u8; 21] = "R33 ALC287 JACK FAIL\0"

  pub let alc287_jack_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M4-004 (#1155): boot witness for the ALC287 jack scaffold. Stages: (S1) arbitrated == 0. (S2) isr before arm -> NOT_ARMED. (S3) arm(16) -> BAD_ADDR. (S4) arm(0) -> OK; armed == 1. (S5) publish(2) -> BAD_STATE. (S6) publish(1) OK; ST_PUBLISHED +=1; state == 1. (S7) publish(0) OK; state == 0. (S8) isr(0xAB, 0) -> UNKNOWN_TAG. (S9) isr(0x01, 0x01) -> OK; ST_JACK_STATE == 1. (S10) isr(0x01, 0x00) -> OK; ST_JACK_STATE == 0. Teardown: reset. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_jk_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        call hda_alc287_jack_reset;

        // S1
        mov rax, 10;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        call hda_alc287_jack_arbitrated;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;

        // S2 -- isr before arm -> NOT_ARMED.
        mov rax, 20;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 0x01;
        mov rsi, 0x00;
        call hda_alc287_jack_isr;
        mov r11, 0xFFFFFCFD;             // NOT_ARMED
        cmp rax, r11;
        jne hda_jk_w_fail_stage;

        // S3 -- arm(16) -> BAD_ADDR.
        mov rax, 30;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        call hda_alc287_jack_arm;
        mov r11, 0xFFFFFCFF;
        cmp rax, r11;
        jne hda_jk_w_fail_stage;

        // S4 -- arm(0) -> OK; armed == 1.
        mov rax, 40;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_alc287_jack_arm;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;
        call hda_alc287_jack_armed;
        cmp rax, 1;
        jne hda_jk_w_fail_stage;

        // S5 -- publish(2) -> BAD_STATE.
        mov rax, 50;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call hda_alc287_jack_publish;
        mov r11, 0xFFFFFCFB;
        cmp rax, r11;
        jne hda_jk_w_fail_stage;

        // S6 -- publish(1) OK; ST_PUBLISHED +=1; state == 1.
        mov rax, 60;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // ST_PUBLISHED
        call hda_alc287_jack_stat;
        mov rbx, rax;
        mov rdi, 1;
        call hda_alc287_jack_publish;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;
        mov rdi, 2;
        call hda_alc287_jack_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_jk_w_fail_stage;
        mov rdi, 10;                     // ST_JACK_STATE
        call hda_alc287_jack_stat;
        cmp rax, 1;
        jne hda_jk_w_fail_stage;

        // S7 -- publish(0) OK; state == 0.
        mov rax, 70;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_alc287_jack_publish;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;
        mov rdi, 10;
        call hda_alc287_jack_stat;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;

        // S8 -- isr(0xAB, 0) -> UNKNOWN_TAG.
        mov rax, 80;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 0xAB;
        xor rsi, rsi;
        call hda_alc287_jack_isr;
        mov r11, 0xFFFFFCFC;
        cmp rax, r11;
        jne hda_jk_w_fail_stage;

        // S9 -- isr(0x01, 0x01) -> OK; ST_JACK_STATE == 1.
        mov rax, 90;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 0x01;
        mov rsi, 0x01;
        call hda_alc287_jack_isr;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;
        mov rdi, 10;
        call hda_alc287_jack_stat;
        cmp rax, 1;
        jne hda_jk_w_fail_stage;

        // S10 -- isr(0x01, 0x00) -> OK; ST_JACK_STATE == 0.
        mov rax, 100;
        lea rcx, [rip + _hda_jk_w_stage];
        mov [rcx], rax;
        mov rdi, 0x01;
        xor rsi, rsi;
        call hda_alc287_jack_isr;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;
        mov rdi, 10;
        call hda_alc287_jack_stat;
        cmp rax, 0;
        jne hda_jk_w_fail_stage;

        // Teardown.
        call hda_alc287_jack_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_jk_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_jk_w_out;

      hda_jk_w_fail_stage:
        lea rax, [rip + _hda_jk_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_jk_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_jk_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
