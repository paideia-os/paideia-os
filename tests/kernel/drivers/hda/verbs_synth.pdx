// tests/kernel/drivers/hda/verbs_synth.pdx -- R33.M2-004 (#1145)
//
// Boot witness for the HDA per-verb helpers.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the SHORT-form packer's field validation (BAD on
// codec_addr 16, node 256, verb4 16, payload16 65536), the SHORT-form
// happy path (verb 0xF at all bits packs correctly), the send_long
// refusals (BAD_ADDR, BAD_NODE, BAD_PAYLOAD), the send_long happy path
// (DEFERRED_HARDWARE; SENDS_LONG counter advances), the send_short
// happy path (DEFERRED_HARDWARE; SENDS_SHORT counter advances), the
// per-verb wrappers (each bumps its own counter on DEFERRED_HARDWARE),
// and the arbitration pin (0 -- the honesty function).
//
// RUNS AFTER the CORB/RIRB witnesses so both init latches are SET;
// every send here therefore reaches DEFERRED_HARDWARE rather than
// NOT_READY.
//
// IT ASSERTS NOTHING ABOUT A REAL VERB TRANSPORT OR RESPONSE, because
// verbs.pdx §4 documents the deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA VERBS OK

module VerbsSynth = structure {

  pub let mut _hda_vb_w_stage : u64 = 0

  pub let hda_vb_w_ok   : [u8; 17] = "R33 HDA VERBS OK\0"
  pub let hda_vb_w_fail : [u8; 19] = "R33 HDA VERBS FAIL\0"

  pub let hda_verbs_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M2-004 (#1145): boot witness for the per-verb helpers. Stages: (S1) arbitrated == 0. (S2) pack_short(15, 1, 3, 0xABCD) packs to 0xF013ABCD ((codec<<28)|(node<<20)|(verb4<<16)|payload16). (S3) pack_short(16, ...) -> BAD. (S4) pack_short(0, 0, 16, 0) -> BAD (verb4 range). (S5) pack_short(0, 0, 0, 65536) -> BAD (payload16 range). (S6) send_long(0, 0, 0xF07, 0) -> DEFERRED_HARDWARE; SENDS_LONG advanced by 1. (S7) send_long(16, ...) -> BAD_ADDR. (S8) send_long(0, 256, ...) -> BAD_NODE. (S9) send_long(0, 0, 0xF07, 256) -> BAD_PAYLOAD. (S10) send_short(0, 0, 3, 0x1234) -> DEFERRED_HARDWARE; SENDS_SHORT advanced. (S11..S17) per-verb wrappers (get_pin_ctl, set_pin_ctl, get_eapd, set_eapd, get_power_state, set_power_state, get_amp_gain, set_amp_gain) each -> DEFERRED_HARDWARE and each advances its own counter. Runs after CORB/RIRB witnesses so init latches are set. Six-push prologue keeps rsp%16 == 0 across nested calls. Labels prefixed hda_vb_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        // S1 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        call hda_verb_arbitrated;
        cmp rax, 0;
        jne hda_vb_w_fail_stage;

        // S2 -- pack_short(15, 1, 3, 0xABCD) = 0xF13ABCD.
        mov rax, 20;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 15;
        mov rsi, 1;
        mov rdx, 3;
        mov rcx, 0xABCD;
        call hda_verb_pack_short;
        mov r11, 0xF013ABCD;             // (15<<28)|(1<<20)|(3<<16)|0xABCD
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S3 -- pack_short with codec_addr 16 -> BAD.
        mov rax, 30;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call hda_verb_pack_short;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S4 -- pack_short with verb4 16 -> BAD.
        mov rax, 40;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 16;
        xor rcx, rcx;
        call hda_verb_pack_short;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S5 -- pack_short with payload16 65536 -> BAD.
        mov rax, 50;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 65536;
        call hda_verb_pack_short;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S6 -- send_long(0, 0, 0xF07, 0) -> DEFERRED_HARDWARE; count++.
        mov rax, 60;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;                    // ST_SENDS_LONG
        call hda_verb_stat;
        mov rbx, rax;                    // before
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 0xF07;
        xor rcx, rcx;
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        xor rdi, rdi;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S7 -- send_long(16, ...) -> BAD_ADDR.
        mov rax, 70;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBE;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S8 -- send_long(0, 256, ...) -> BAD_NODE.
        mov rax, 80;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 256;
        xor rdx, rdx;
        xor rcx, rcx;
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBD;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S9 -- send_long(0, 0, 0xF07, 256) -> BAD_PAYLOAD.
        mov rax, 90;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 0xF07;
        mov rcx, 256;
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBC;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;

        // S10 -- send_short(0, 0, 3, 0x1234) -> DEFERRED_HARDWARE; count++.
        mov rax, 100;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 1;                        // ST_SENDS_SHORT
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 3;
        mov rcx, 0x1234;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 1;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S11 -- get_pin_ctl(0, 5) -> DEFERRED_HARDWARE; ST_GET_PIN_CTL++.
        mov rax, 110;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 6;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        call hda_verb_get_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 6;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S12 -- set_pin_ctl(0, 5, 0x40) -> DEFERRED_HARDWARE; ST_SET_PIN_CTL++.
        mov rax, 120;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 7;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        mov rdx, 0x40;
        call hda_verb_set_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 7;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S13 -- get_eapd(0, 5) -> DEFERRED_HARDWARE; ST_GET_EAPD++.
        mov rax, 130;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 8;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        call hda_verb_get_eapd;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 8;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S14 -- set_eapd(0, 5, 0x02) -> DEFERRED_HARDWARE; ST_SET_EAPD++.
        mov rax, 140;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 9;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        mov rdx, 0x02;
        call hda_verb_set_eapd;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 9;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S15 -- get_power_state(0, 5) -> DEFERRED_HARDWARE; ST_GET_POWER++.
        mov rax, 150;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 10;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        call hda_verb_get_power_state;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 10;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S16 -- set_power_state(0, 5, 3) -> DEFERRED_HARDWARE; ST_SET_POWER++.
        mov rax, 160;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 11;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        mov rdx, 3;
        call hda_verb_set_power_state;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 11;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S17 -- get_amp_gain(0, 5, 0xA0) -> DEFERRED_HARDWARE; ST_GET_AMP++.
        mov rax, 170;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 12;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        mov rdx, 0xA0;
        call hda_verb_get_amp_gain;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 12;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // S18 -- set_amp_gain(0, 5, 0xB000) -> DEFERRED_HARDWARE; ST_SET_AMP++.
        mov rax, 180;
        lea rcx, [rip + _hda_vb_w_stage];
        mov [rcx], rax;
        mov rdi, 13;
        call hda_verb_stat;
        mov rbx, rax;
        xor rdi, rdi;
        mov rsi, 5;
        mov rdx, 0xB000;
        call hda_verb_set_amp_gain;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hda_vb_w_fail_stage;
        mov rdi, 13;
        call hda_verb_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_vb_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_vb_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_vb_w_out;

      hda_vb_w_fail_stage:
        lea rax, [rip + _hda_vb_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_vb_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_vb_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
