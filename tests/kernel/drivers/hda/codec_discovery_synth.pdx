// tests/kernel/drivers/hda/codec_discovery_synth.pdx — R33.M2-001 (#1142)
//
// Boot witness for the HDA CODEC DISCOVERY SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the verb encoder's field validation (BAD on codec_addr 16,
// node 256, verb 4096, payload 4096), the get_parameter refusal
// discipline (BAD_ADDR / BAD_NODE / BAD_PARAM), the arbitration pin (0
// -- the honesty function), and the DEFERRED_HARDWARE outcome on the
// happy path. Function-group and widget walk counts, and probe_all's
// total, are asserted against the scaffold's fixed enumeration.
//
// IT ASSERTS NOTHING ABOUT A REAL DMA RESPONSE OR A REAL VENDOR_ID
// BYTE, because none reaches this ring -- codec_discovery.pdx §4
// documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA CODEC DISCOVER OK

module CodecDiscoverySynth = structure {

  pub let mut _hda_cd_w_stage : u64 = 0

  pub let hda_cd_w_ok   : [u8; 26] = "R33 HDA CODEC DISCOVER OK\0"
  pub let hda_cd_w_fail : [u8; 28] = "R33 HDA CODEC DISCOVER FAIL\0"

  pub let hda_codec_discovery_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M2-001 (#1142): boot witness for the HDA codec discovery scaffold. RUNS AFTER controller / reset / corb / rirb witnesses, which leave the CORB and RIRB init latches SET; every get_parameter here therefore reaches DEFERRED_HARDWARE rather than NOT_READY. Stages: (S1) arbitrated() = 0. (S2) verb_encode(15, 0x01, 0xF00, 0x00) = 0xF0F00000 -- the scaffold encoder places verb at [23:12] (shl 12); a live R33.M3 encoder that follows Intel HDA §7.3.3 will place verb at [19:8] and this constant will be rewritten in the same commit. (S3) verb_encode(16, ..) = BAD. (S4) get_parameter(0, 0, VENDOR_ID) -> DEFERRED_HARDWARE; GET_PARAMS advanced by exactly one. (S5) get_parameter(16, 0, 0) -> BAD_ADDR. (S6) walk_function_groups(0) returns 2. (S7) walk_widgets(0, 1) returns 8. (S8) discovery_probe_all() returns 16. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_cd_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- arbitrated = 0
        mov rax, 10;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;
        call hda_codec_discovery_arbitrated;
        cmp rax, 0;
        jne hda_cd_w_fail_stage;

        // S2 -- verb_encode happy path.
        mov rax, 20;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;
        mov rdi, 15;
        mov rsi, 1;
        mov rdx, 0xF00;
        xor rcx, rcx;
        call hda_codec_verb_encode;
        mov r11, 0xF0F00000;             // scaffold encoder: verb << 12
        cmp rax, r11;
        jne hda_cd_w_fail_stage;

        // S3 -- verb_encode with codec_addr out of range.
        mov rax, 30;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call hda_codec_verb_encode;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_cd_w_fail_stage;

        // S4 -- get_parameter(0, 0, VENDOR_ID) -> DEFERRED_HARDWARE.
        mov rax, 40;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // ST_GET_PARAMS
        call hda_codec_disc_stat;
        mov rbx, rax;                    // before

        xor rdi, rdi;                    // codec 0
        xor rsi, rsi;                    // node 0
        xor rdx, rdx;                    // VENDOR_ID
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hda_cd_w_fail_stage;

        mov rdi, 1;
        call hda_codec_disc_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_cd_w_fail_stage;

        // S5 -- get_parameter(16, 0, 0) -> BAD_ADDR.
        mov rax, 50;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;

        mov rdi, 16;
        xor rsi, rsi;
        xor rdx, rdx;
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8E;             // BAD_ADDR
        cmp rax, r11;
        jne hda_cd_w_fail_stage;

        // S6 -- walk_function_groups(0) = 2.
        mov rax, 60;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call hda_codec_walk_function_groups;
        cmp rax, 2;                      // HDA_CD_FG_PER_CODEC
        jne hda_cd_w_fail_stage;

        // S7 -- walk_widgets(0, 1) = 8.
        mov rax, 70;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 1;
        call hda_codec_walk_widgets;
        cmp rax, 8;                      // HDA_CD_WIDGETS_PER_FG
        jne hda_cd_w_fail_stage;

        // S8 -- probe_all = 16.
        mov rax, 80;
        lea rcx, [rip + _hda_cd_w_stage];
        mov [rcx], rax;

        call hda_codec_discovery_probe_all;
        cmp rax, 16;                     // HDA_CODEC_MAX
        jne hda_cd_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_cd_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_cd_w_out;

      hda_cd_w_fail_stage:
        lea rax, [rip + _hda_cd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_cd_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_cd_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
