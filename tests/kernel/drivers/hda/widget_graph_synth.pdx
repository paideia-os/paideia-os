// tests/kernel/drivers/hda/widget_graph_synth.pdx -- R33.M2-002 (#1143)
//
// Boot witness for the HDA WIDGET GRAPH typed record.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the empty-table invariants (count == 0 before add, find
// misses), the add gate refusals (BAD_ADDR / BAD_NODE / BAD_TYPE),
// happy-path row installation (add returns row_id 0..n and count
// advances), the row read seams (codec / node / type / conn_len / conn),
// the REBIND refusal on a duplicate (codec, node), the append_conn
// happy path (advances connections_len; each byte lands in the right
// slot) and refusals (BAD_ROW, BAD_CONN_NODE, FULL_CONN at MAX_CONN),
// and the arbitration pin (0 -- the honesty function).
//
// IT ASSERTS NOTHING ABOUT A REAL VERB-RESPONSE INGEST, because none
// runs -- widget_graph.pdx §4 documents the deferral.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA WIDGET GRAPH OK

module WidgetGraphSynth = structure {

  pub let mut _hda_wg_w_stage : u64 = 0

  pub let hda_wg_w_ok   : [u8; 20] = "HDA WIDGET GRAPH OK\0"
  pub let hda_wg_w_fail : [u8; 22] = "HDA WIDGET GRAPH FAIL\0"

  pub let hda_widget_graph_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M2-002 (#1143): boot witness for the widget graph typed record. Stages: (S1) arbitrated == 0, count == 0. (S2) add(16, ...) -> BAD_ADDR. (S3) add(0, 256, ...) -> BAD_NODE. (S4) add(0, 1, 0xE) -> BAD_TYPE. (S5) add(0, 1, AUDIO_OUT) -> 0; count == 1; row_type/codec/node/conn_len as written. (S6) add(0, 1, AUDIO_OUT) again -> REBIND. (S7) add(0, 2, PIN_COMPLEX) -> 1. (S8) append_conn(1, 5) -> OK; conn_len(1) == 1; row_conn(1, 0) == 5. (S9) append_conn(1, 6) -> OK; conn_len == 2; row_conn(1, 1) == 6. (S10) fill row 1 up to conn_len == 8 then append_conn -> FULL_CONN. (S11) append_conn(999, 0) -> BAD_ROW. (S12) append_conn(1, 256) -> BAD_CONN_NODE. (S13) reset(); count == 0 (row bytes are dead past count). Each stage runs only if the previous passed. Six-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_wg_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        // S1 -- arbitrated == 0, count == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        call hda_widget_graph_arbitrated;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        call hda_widget_graph_count;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;

        // S2 -- add(16, ...) -> BAD_ADDR.
        mov rax, 20;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        xor rsi, rsi;
        xor rdx, rdx;
        call hda_widget_graph_add;
        mov r11, 0xFFFFFC9F;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S3 -- add(0, 256, ...) -> BAD_NODE.
        mov rax, 30;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 256;
        xor rdx, rdx;
        call hda_widget_graph_add;
        mov r11, 0xFFFFFC9E;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S4 -- add(0, 1, 0xE) -> BAD_TYPE (reserved / unknown).
        mov rax, 40;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;
        mov rdx, 0xE;
        call hda_widget_graph_add;
        mov r11, 0xFFFFFC9D;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S5 -- add(0, 1, AUDIO_OUT=0) -> row 0.
        mov rax, 50;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;
        xor rdx, rdx;
        call hda_widget_graph_add;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        call hda_widget_graph_count;
        cmp rax, 1;
        jne hda_wg_w_fail_stage;
        xor rdi, rdi;
        call hda_widget_graph_row_codec;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        xor rdi, rdi;
        call hda_widget_graph_row_node;
        cmp rax, 1;
        jne hda_wg_w_fail_stage;
        xor rdi, rdi;
        call hda_widget_graph_row_type;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        xor rdi, rdi;
        call hda_widget_graph_row_conn_len;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;

        // S6 -- add(0, 1, ...) again -> REBIND.
        mov rax, 60;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;
        xor rdx, rdx;
        call hda_widget_graph_add;
        mov r11, 0xFFFFFC9B;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S7 -- add(0, 2, PIN_COMPLEX=4) -> row 1.
        mov rax, 70;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 2;
        mov rdx, 4;
        call hda_widget_graph_add;
        cmp rax, 1;
        jne hda_wg_w_fail_stage;

        // S8 -- append_conn(1, 5) -> OK.
        mov rax, 80;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 5;
        call hda_widget_graph_append_conn;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        mov rdi, 1;
        call hda_widget_graph_row_conn_len;
        cmp rax, 1;
        jne hda_wg_w_fail_stage;
        mov rdi, 1;
        xor rsi, rsi;
        call hda_widget_graph_row_conn;
        cmp rax, 5;
        jne hda_wg_w_fail_stage;

        // S9 -- append_conn(1, 6) -> OK.
        mov rax, 90;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 6;
        call hda_widget_graph_append_conn;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        mov rdi, 1;
        call hda_widget_graph_row_conn_len;
        cmp rax, 2;
        jne hda_wg_w_fail_stage;
        mov rdi, 1;
        mov rsi, 1;
        call hda_widget_graph_row_conn;
        cmp rax, 6;
        jne hda_wg_w_fail_stage;

        // S10 -- fill row 1 to MAX_CONN and then FULL_CONN.
        mov rax, 100;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        // Already have 2 conns; add 6 more (7..12).
        mov r12, 7;                        // next target node
        mov r13, 6;                        // remaining appends
      hda_wg_w_fill:
        cmp r13, 0;
        je  hda_wg_w_fill_done;
        mov rdi, 1;
        mov rsi, r12;
        call hda_widget_graph_append_conn;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;
        add r12, 1;
        sub r13, 1;
        jmp hda_wg_w_fill;
      hda_wg_w_fill_done:
        mov rdi, 1;
        call hda_widget_graph_row_conn_len;
        cmp rax, 8;
        jne hda_wg_w_fail_stage;
        // Ninth append -> FULL_CONN.
        mov rdi, 1;
        mov rsi, 99;
        call hda_widget_graph_append_conn;
        mov r11, 0xFFFFFC9A;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S11 -- append_conn(999, 0) -> BAD_ROW.
        mov rax, 110;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        mov rdi, 999;
        xor rsi, rsi;
        call hda_widget_graph_append_conn;
        mov r11, 0xFFFFFC99;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S12 -- append_conn(0, 256) -> BAD_CONN_NODE. Row 0 has 0
        // conns, so this exercises the width gate not the FULL gate.
        mov rax, 120;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 256;
        call hda_widget_graph_append_conn;
        mov r11, 0xFFFFFC97;
        cmp rax, r11;
        jne hda_wg_w_fail_stage;

        // S13 -- reset(); count == 0.
        mov rax, 130;
        lea rcx, [rip + _hda_wg_w_stage];
        mov [rcx], rax;
        call hda_widget_graph_reset;
        call hda_widget_graph_count;
        cmp rax, 0;
        jne hda_wg_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_wg_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_wg_w_out;

      hda_wg_w_fail_stage:
        lea rax, [rip + _hda_wg_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_wg_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_wg_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
