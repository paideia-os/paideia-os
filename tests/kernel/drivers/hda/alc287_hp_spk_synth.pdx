// tests/kernel/drivers/hda/alc287_hp_spk_synth.pdx -- R33.M4-002 (#1153)
//
// Boot witness for the ALC287 HP + SPK PATH scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arbitrated == 0, the bind gate rejects codec 16 with
// BAD_ADDR, bind() on the initialised codec succeeds and stamps the
// latch, a second bind is idempotent (no state advance), auto_switch
// works for both jack states (0 and 1), auto_switch(2) is refused
// BAD_STATE, and auto_switch() before bind returns NOT_BOUND (after
// teardown).
//
// RUNS AFTER alc287_init_witness so init_bound() reports codec 0 + 1.
// RUNS AFTER verbs_witness so CORB/RIRB are bound.
//
// IT ASSERTS NOTHING ABOUT A REAL AMP WRITE.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 ALC287 HP-SPK OK

module Alc287HpSpkSynth = structure {

  pub let mut _hda_hs_w_stage : u64 = 0

  pub let hda_hs_w_ok   : [u8; 17] = "ALC287 HP-SPK OK\0"
  pub let hda_hs_w_fail : [u8; 19] = "ALC287 HP-SPK FAIL\0"

  pub let alc287_hp_spk_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M4-002 (#1153): boot witness for the ALC287 HP+SPK path scaffold. Stages: (S1) arbitrated == 0. (S2) bind(16) -> BAD_ADDR. (S3) bind(0) -> OK; ST_BINDS advances by 1; latch stamped 1. (S4) auto_switch(1) -> OK; ST_SWITCHES advances by 1; state stamped 1. (S5) auto_switch(0) -> OK; state stamped 0. (S6) auto_switch(2) -> BAD_STATE. (S7) reset(); auto_switch(0) -> NOT_BOUND. Teardown: re-bind so downstream witnesses see the bound state. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_hs_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        call hda_alc287_hp_spk_reset;

        // S1 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        call hda_alc287_hp_spk_arbitrated;
        cmp rax, 0;
        jne hda_hs_w_fail_stage;

        // S2 -- bind(16) -> BAD_ADDR.
        mov rax, 20;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        mov rdi, 16;
        call hda_alc287_hp_spk_bind;
        mov r11, 0xFFFFFCDF;
        cmp rax, r11;
        jne hda_hs_w_fail_stage;

        // S3 -- bind(0) -> OK; ST_BINDS += 1; latch == 1.
        mov rax, 30;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;                    // ST_BINDS
        call hda_alc287_hp_spk_stat;
        mov rbx, rax;

        xor rdi, rdi;
        call hda_alc287_hp_spk_bind;
        cmp rax, 0;
        jne hda_hs_w_fail_stage;

        xor rdi, rdi;
        call hda_alc287_hp_spk_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_hs_w_fail_stage;

        call hda_alc287_hp_spk_bound;
        cmp rax, 1;
        jne hda_hs_w_fail_stage;

        // S4 -- auto_switch(1) -> OK; ST_SWITCHES += 1.
        mov rax, 40;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call hda_alc287_hp_spk_stat;
        mov rbx, rax;

        mov rdi, 1;
        call hda_alc287_hp_spk_auto_switch;
        cmp rax, 0;
        jne hda_hs_w_fail_stage;

        mov rdi, 1;
        call hda_alc287_hp_spk_stat;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_hs_w_fail_stage;

        // S5 -- auto_switch(0) -> OK.
        mov rax, 50;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_alc287_hp_spk_auto_switch;
        cmp rax, 0;
        jne hda_hs_w_fail_stage;

        // S6 -- auto_switch(2) -> BAD_STATE.
        mov rax, 60;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call hda_alc287_hp_spk_auto_switch;
        mov r11, 0xFFFFFCDB;             // BAD_STATE
        cmp rax, r11;
        jne hda_hs_w_fail_stage;

        // S7 -- reset(); auto_switch(0) -> NOT_BOUND.
        mov rax, 70;
        lea rcx, [rip + _hda_hs_w_stage];
        mov [rcx], rax;
        call hda_alc287_hp_spk_reset;
        xor rdi, rdi;
        call hda_alc287_hp_spk_auto_switch;
        mov r11, 0xFFFFFCDD;             // NOT_BOUND
        cmp rax, r11;
        jne hda_hs_w_fail_stage;

        // Teardown: rebind for downstream witnesses (jack_isr needs
        // auto_switch to reach a bound path).
        xor rdi, rdi;
        call hda_alc287_hp_spk_bind;
        cmp rax, 0;
        jne hda_hs_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_hs_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_hs_w_out;

      hda_hs_w_fail_stage:
        lea rax, [rip + _hda_hs_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_hs_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_hs_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
