// tests/kernel/drivers/hda/pin_config_synth.pdx -- R33.M2-003 (#1144)
//
// Boot witness for the HDA pin configuration DECODERS.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts that each of the nine field getters returns the correct
// slice of a hand-crafted 32-bit default_cfg word, and that the width
// gate refuses an input outside u32 (DECODE_BAD). The test vector is
// chosen so every field has a distinct value, so a getter that read
// the wrong bit range would return a different value than the one
// the vector encodes.
//
// It also asserts the arbitration pin (0 -- the honesty function).
//
// IT ASSERTS NOTHING ABOUT A REAL VERB READ (§0 defers).
//
// -----------------------------------------------------------------------------
// Vector
// -----------------------------------------------------------------------------
//
//   default_cfg = 0x02214020
//                 ├──┬──┬──┬──┬──┬──┬──┬──┤
//                 │02│21│40│20│
//
//   [31:30] port_connectivity = 0 (jack)          bits: 00
//   [29:28] gross_loc         = 0 (external)      bits: 00
//   [27:24] geom_loc          = 2                 bits: 0010
//   [23:20] default_device    = 2 (HP_OUT)        bits: 0010
//   [19:16] connection_type   = 1 (1/8 stereo)    bits: 0001
//   [15:12] color             = 4 (green)         bits: 0100
//   [11: 8] misc              = 0                 bits: 0000
//   [ 7: 4] default_assoc     = 2                 bits: 0010
//   [ 3: 0] sequence          = 0                 bits: 0000
//
//   Word: 0000_0010 0010_0001 0100_0000 0010_0000 = 0x02214020
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA PIN CONFIG OK

module PinConfigSynth = structure {

  pub let mut _hda_pc_w_stage : u64 = 0

  pub let hda_pc_w_ok   : [u8; 22] = "R33 HDA PIN CONFIG OK\0"
  pub let hda_pc_w_fail : [u8; 24] = "R33 HDA PIN CONFIG FAIL\0"

  pub let hda_pin_config_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M2-003 (#1144): boot witness for the pin config decoders. Stages: (S1) arbitrated == 0. (S2..S10) Each of the nine getters returns the encoded value from vector 0x00221420 (see file header). (S11) hda_pin_cfg_is_u32 accepts 0xFFFFFFFF, refuses 0x100000000. (S12) every getter returns DECODE_BAD (0xFFFFFFFFFFFFFFFF) when fed 0x100000000. Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 across the nested calls. Labels prefixed hda_pc_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Cache the vector (matches the bit-layout table in the file header).
        mov r12, 0x02214020;

        // S1 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        call hda_pin_cfg_arbitrated;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S2 -- conn == 0.
        mov rax, 20;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_conn;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S3 -- gross_loc == 0.
        mov rax, 30;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_gross_loc;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S4 -- geom_loc == 2.
        mov rax, 40;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_geom_loc;
        cmp rax, 2;
        jne hda_pc_w_fail_stage;

        // S5 -- device == 2 (HP_OUT).
        mov rax, 50;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_device;
        cmp rax, 2;
        jne hda_pc_w_fail_stage;

        // S6 -- ctype == 1.
        mov rax, 60;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_ctype;
        cmp rax, 1;
        jne hda_pc_w_fail_stage;

        // S7 -- color == 4 (green).
        mov rax, 70;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_color;
        cmp rax, 4;
        jne hda_pc_w_fail_stage;

        // S8 -- misc == 0.
        mov rax, 80;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_misc;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S9 -- assoc == 2.
        mov rax, 90;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_assoc;
        cmp rax, 2;
        jne hda_pc_w_fail_stage;

        // S10 -- seq == 0.
        mov rax, 100;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call hda_pin_cfg_seq;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S11 -- is_u32.
        mov rax, 110;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, 0xFFFFFFFF;
        call hda_pin_cfg_is_u32;
        cmp rax, 1;
        jne hda_pc_w_fail_stage;
        mov rdi, 0x100000000;
        call hda_pin_cfg_is_u32;
        cmp rax, 0;
        jne hda_pc_w_fail_stage;

        // S12 -- getters refuse input > u32.
        mov rax, 120;
        lea rcx, [rip + _hda_pc_w_stage];
        mov [rcx], rax;
        mov rdi, 0x100000000;
        call hda_pin_cfg_device;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_pc_w_fail_stage;
        mov rdi, 0x100000000;
        call hda_pin_cfg_seq;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_pc_w_fail_stage;
        mov rdi, 0x100000000;
        call hda_pin_cfg_conn;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hda_pc_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_pc_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_pc_w_out;

      hda_pc_w_fail_stage:
        lea rax, [rip + _hda_pc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_pc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_pc_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
