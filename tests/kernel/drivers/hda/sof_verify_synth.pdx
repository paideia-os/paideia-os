// tests/kernel/drivers/hda/sof_verify_synth.pdx -- R33.M6-004 (#1165)
//
// Boot witness for the SOF DUAL-SIGNATURE VERIFICATION scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts:
//
//   (1) arbitration pin (0) — the underlying ML-DSA-65 primitive is
//       still a scaffold at R29 per sig_verify.pdx §0;
//   (2) the scaffold-epoch happy path: both signatures bytewise zero
//       and both keys valid keyring entries yields
//       HDA_SOF_VERIFY_DUAL_SCAFFOLD (1), NOT DUAL_OK (0);
//   (3) the predicate discipline: dual_is_ok(DUAL_SCAFFOLD) == 0,
//       dual_is_ok(DUAL_OK) == 1. This is the assertion that keeps
//       the fail-closed contract intact through the R32 flip: a
//       consumer that gates its attach-to-loader decision through
//       this predicate cannot accidentally accept an unsigned blob
//       at R29 or ever;
//   (4) the fail-closed AND: null fw_ptr yields DUAL_BOTH_FAIL
//       (both underlying arms return SIG_BAD_ARTIFACT);
//   (5) the mixed-scaffold rejection: one arm scaffold + one arm
//       non-scaffold yields DUAL_MIXED_SCAFFOLD, never accepted.
//       Constructed by giving arm-1 a null artifact len (arm-1
//       returns SIG_BAD_ARTIFACT_LEN) while arm-2 is scaffold-valid.
//       Wait -- that would give MIXED (non-scaffold + scaffold).
//
// It asserts NOTHING about a real ML-DSA-65 verification. Both arms
// depend on sig_verify.pdx which is the R29 scaffold surface.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 SOF VERIFY OK

module SofVerifySynth = structure {

  pub let mut _hda_sv_w_stage : u64 = 0

  pub let hda_sv_w_ok   : [u8; 14] = "SOF VERIFY OK\0"
  pub let hda_sv_w_fail : [u8; 16] = "SOF VERIFY FAIL\0"

  // 64-byte firmware artifact stand-in. Non-zero on purpose: the
  // verifier's terminal branches key on SIGNATURE fields being all
  // zero, and an all-zero artifact would leave open the question of
  // which buffer a scan actually read.
  pub let _hda_sv_w_fw : [u64; 8] = [
    0x1122334455667788, 0xAABBCCDDEEFF0011,
    0xDEADBEEFCAFEBABE, 0x0123456789ABCDEF,
    0xFEDCBA9876543210, 0xA5A5A5A5A5A5A5A5,
    0x5A5A5A5A5A5A5A5A, 0x5555555555555555
  ]

  // 3312 bytes of signature buffer (414 qwords = 3312, sig len 3309).
  // Two of them, one per arm, zeroed at witness entry so the witness
  // tests the verifier not the toolchain's data emission.
  pub let mut _hda_sv_w_sig_paideia : [u64; 414] = [0; 414]
  pub let mut _hda_sv_w_sig_vendor  : [u64; 414] = [0; 414]

  pub let sof_verify_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M6-004 (#1165): boot witness for the SOF dual-sig scaffold. Stages: (S10) arbitrated == 0. (S20) both zero sigs + valid paideia_pk (keyring role 0) + valid intel_pk (keyring role 1) -> DUAL_SCAFFOLD (1). (S30) dual_is_ok(DUAL_SCAFFOLD) == 0. (S40) dual_is_ok(DUAL_OK) == 1. (S50) null fw_ptr -> DUAL_BOTH_FAIL (both arms return SIG_BAD_ARTIFACT). (S60) valid arm 2 + fw_len == 0 (arm 1 rejects, arm 2 rejects both since fw_len is shared) -> DUAL_BOTH_FAIL. Zeros the two sig buffers at entry so the SCAFFOLD arm is deterministic. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_sv_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        // Zero the two sig buffers (defensive; the .bss initializers
        // already say [0; 414], but the witness controls its own
        // state so a re-run stays deterministic).
        lea r10, [rip + _hda_sv_w_sig_paideia];
        mov rcx, 414;
      hda_sv_w_zero_pa:
        cmp rcx, 0;
        je hda_sv_w_zero_pa_done;
        xor rax, rax;
        mov [r10], rax;
        add r10, 8;
        sub rcx, 1;
        jmp hda_sv_w_zero_pa;
      hda_sv_w_zero_pa_done:

        lea r10, [rip + _hda_sv_w_sig_vendor];
        mov rcx, 414;
      hda_sv_w_zero_ve:
        cmp rcx, 0;
        je hda_sv_w_zero_ve_done;
        xor rax, rax;
        mov [r10], rax;
        add r10, 8;
        sub rcx, 1;
        jmp hda_sv_w_zero_ve;
      hda_sv_w_zero_ve_done:

        // Resolve paideia_pk (keyring role 0) into r12.
        xor rdi, rdi;
        call keyring_pk_ptr;
        cmp rax, 0;
        je hda_sv_w_fail_stage_setup;
        mov r12, rax;                        // paideia_pk

        // Resolve intel_pk (keyring role 1) into r13.
        mov rdi, 1;
        call keyring_pk_ptr;
        cmp rax, 0;
        je hda_sv_w_fail_stage_setup;
        mov r13, rax;                        // vendor_pk (intel)

        // S10 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        call hda_sof_verify_arbitrated;
        cmp rax, 0;
        jne hda_sv_w_fail_stage;

        // S20 -- happy scaffold: zero sigs + valid keys -> DUAL_SCAFFOLD.
        mov rax, 20;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sv_w_fw];
        mov rsi, 64;
        lea rdx, [rip + _hda_sv_w_sig_paideia];
        mov rcx, r12;
        lea r8, [rip + _hda_sv_w_sig_vendor];
        mov r9, r13;
        call hda_sof_verify_dual;
        cmp rax, 1;                          // DUAL_SCAFFOLD
        jne hda_sv_w_fail_stage;

        // S30 -- dual_is_ok(DUAL_SCAFFOLD) == 0.
        mov rax, 30;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call hda_sof_verify_dual_is_ok;
        cmp rax, 0;
        jne hda_sv_w_fail_stage;

        // S40 -- dual_is_ok(DUAL_OK) == 1.
        mov rax, 40;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;                        // DUAL_OK
        call hda_sof_verify_dual_is_ok;
        cmp rax, 1;
        jne hda_sv_w_fail_stage;

        // S50 -- null fw_ptr -> DUAL_BOTH_FAIL.
        //
        // Both arms are called with fw_ptr = 0; both underlying
        // driver_sig_verify_algo runs return SIG_BAD_ARTIFACT
        // (0xFFFFFD81). Both arms fail with the same non-scaffold
        // code -> DUAL_BOTH_FAIL.
        mov rax, 50;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 64;
        lea rdx, [rip + _hda_sv_w_sig_paideia];
        mov rcx, r12;
        lea r8, [rip + _hda_sv_w_sig_vendor];
        mov r9, r13;
        call hda_sof_verify_dual;
        mov r11, 0xFFFFFCA2;                 // DUAL_BOTH_FAIL
        cmp rax, r11;
        jne hda_sv_w_fail_stage;

        // S60 -- fw_len == 0 -> both arms return SIG_BAD_ARTIFACT_LEN
        //        -> DUAL_BOTH_FAIL.
        mov rax, 60;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sv_w_fw];
        xor rsi, rsi;
        lea rdx, [rip + _hda_sv_w_sig_paideia];
        mov rcx, r12;
        lea r8, [rip + _hda_sv_w_sig_vendor];
        mov r9, r13;
        call hda_sof_verify_dual;
        mov r11, 0xFFFFFCA2;
        cmp rax, r11;
        jne hda_sv_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sv_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_sv_w_out;

      hda_sv_w_fail_stage_setup:
        // Setup failure (keyring not initialised). Record stage 0.
        xor rax, rax;
        lea rcx, [rip + _hda_sv_w_stage];
        mov [rcx], rax;
        jmp hda_sv_w_fail_stage;

      hda_sv_w_fail_stage:
        lea rax, [rip + _hda_sv_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sv_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_sv_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
