// tests/kernel/drivers/hda/alc287_init_synth.pdx -- R33.M4-001 (#1152)
//
// Boot witness for the ALC287 VENDOR INIT SEQUENCE scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the arbitration pin (0), the bind latch's starting state
// (0), the happy-path apply (returns OK; ST_APPLIED advances by six;
// ST_BOUND stamped codec+1), the LATCH refusal (a second apply for
// the same codec returns ALREADY_BOUND), the BAD_ADDR refusal
// (codec 16), and that reset() clears the latch so a re-apply passes.
//
// RUNS AFTER hda_verbs_witness so CORB/RIRB are bound and every
// underlying hda_verb_send_short reaches DEFERRED_HARDWARE rather
// than NOT_READY.
//
// IT ASSERTS NOTHING ABOUT A REAL COEFFICIENT WRITE. alc287_init.pdx §4
// documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 ALC287 INIT OK

module Alc287InitSynth = structure {

  pub let mut _hda_ai_w_stage : u64 = 0

  pub let hda_ai_w_ok   : [u8; 19] = "R33 ALC287 INIT OK\0"
  pub let hda_ai_w_fail : [u8; 21] = "R33 ALC287 INIT FAIL\0"

  pub let alc287_init_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M4-001 (#1152): boot witness for the ALC287 init scaffold. Stages: (S1) arbitrated == 0. (S2) bound == 0 initially. (S3) apply(0) -> OK; ST_APPLIED advanced by 6; ST_BOUND == 1. (S4) apply(0) -> ALREADY_BOUND (LATCH). (S5) reset(); bound == 0; apply(0) -> OK (re-application works). (S6) apply(16) -> BAD_ADDR after another reset. Teardown: reset() so a subsequent run starts clean. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_ai_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        // Ensure clean start.
        call hda_alc287_init_reset;

        // S1 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;
        call hda_alc287_init_arbitrated;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;

        // S2 -- bound == 0 initially.
        mov rax, 20;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;
        call hda_alc287_init_bound;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;

        // S3 -- apply(0) -> OK; ST_APPLIED +=6; ST_BOUND == 1.
        mov rax, 30;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // ST_APPLIED
        call hda_alc287_init_stat;
        mov rbx, rax;                    // before

        xor rdi, rdi;                    // codec 0
        call hda_alc287_init_apply;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;

        xor rdi, rdi;
        call hda_alc287_init_stat;
        sub rax, rbx;
        cmp rax, 6;
        jne hda_ai_w_fail_stage;

        call hda_alc287_init_bound;
        cmp rax, 1;                      // codec 0 + 1
        jne hda_ai_w_fail_stage;

        // S4 -- second apply(0) -> ALREADY_BOUND.
        mov rax, 40;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_alc287_init_apply;
        mov r11, 0xFFFFFCCE;             // ALREADY_BOUND
        cmp rax, r11;
        jne hda_ai_w_fail_stage;

        // S5 -- reset(); bound == 0; re-apply(0) -> OK.
        mov rax, 50;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;
        call hda_alc287_init_reset;
        call hda_alc287_init_bound;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;
        xor rdi, rdi;
        call hda_alc287_init_apply;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;

        // S6 -- reset(); apply(16) -> BAD_ADDR.
        mov rax, 60;
        lea rcx, [rip + _hda_ai_w_stage];
        mov [rcx], rax;
        call hda_alc287_init_reset;
        mov rdi, 16;
        call hda_alc287_init_apply;
        mov r11, 0xFFFFFCCF;             // BAD_ADDR
        cmp rax, r11;
        jne hda_ai_w_fail_stage;

        // Teardown: leave latch bound to codec 0 so downstream
        // witnesses (hp_spk, mic, jack) can pass their NOT_INIT gates.
        call hda_alc287_init_reset;
        xor rdi, rdi;
        call hda_alc287_init_apply;
        cmp rax, 0;
        jne hda_ai_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_ai_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_ai_w_out;

      hda_ai_w_fail_stage:
        lea rax, [rip + _hda_ai_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_ai_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_ai_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
