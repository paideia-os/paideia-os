// tests/kernel/drivers/hda/sof_topology_synth.pdx -- R33.M6-002 (#1163)
//
// Boot witness for the SOF TOPOLOGY BINARY PARSER scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the header refusals (BAD_BUF_PTR on null, BAD_BUF_LEN
// on short, BAD_MAGIC on wrong magic, BAD_SIZE on size/len mismatch,
// BAD_ABI on wrong major), the happy header parse, count()
// round-trip, and per-tuple decode (tuple_type + tuple_size for
// index 0 and 1; BAD_TUP_INDEX on out-of-bound index).
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 SOF TOPOLOGY OK

module SofTopologySynth = structure {

  pub let mut _hda_st_w_stage : u64 = 0

  pub let hda_st_w_ok   : [u8; 16] = "SOF TOPOLOGY OK\0"
  pub let hda_st_w_fail : [u8; 18] = "SOF TOPOLOGY FAIL\0"

  // A hand-rolled 40-byte SOF topology buffer:
  //   HEADER (16 bytes)
  //     magic  = 0x50465353
  //     size   = 24  (== 2 * 12)
  //     abi    = 0x03000000 (major 3)
  //     count  = 2
  //   TUPLES:
  //     [0] type=0x0002 (WIDGET), offset=0, size=0
  //     [1] type=0x0003 (GRAPH),  offset=0, size=0
  //
  // Little-endian; each u32 spelt byte-by-byte to keep the layout
  // legible at review. The trailing '.' pad brings total length to
  // exactly 16 + 24 = 40 bytes, matching `size + 16 == buf_len`.
  pub let _hda_st_w_buf : [u8; 40] = [
    0x53u8, 0x53u8, 0x46u8, 0x50u8,       // magic 0x50465353
    0x18u8, 0x00u8, 0x00u8, 0x00u8,       // size = 24
    0x00u8, 0x00u8, 0x00u8, 0x03u8,       // abi (major = 3 in high byte)
    0x02u8, 0x00u8, 0x00u8, 0x00u8,       // count = 2
    // tuple 0
    0x02u8, 0x00u8, 0x00u8, 0x00u8,       // type = 2 (WIDGET)
    0x00u8, 0x00u8, 0x00u8, 0x00u8,       // offset = 0
    0x00u8, 0x00u8, 0x00u8, 0x00u8,       // size = 0
    // tuple 1
    0x03u8, 0x00u8, 0x00u8, 0x00u8,       // type = 3 (GRAPH)
    0x00u8, 0x00u8, 0x00u8, 0x00u8,       // offset = 0
    0x00u8, 0x00u8, 0x00u8, 0x00u8        // size = 0
  ]

  // A 40-byte buffer with the WRONG magic. Otherwise identical.
  pub let _hda_st_w_bad_magic : [u8; 40] = [
    0xDEu8, 0xADu8, 0xBEu8, 0xEFu8,       // wrong magic
    0x18u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x03u8,
    0x02u8, 0x00u8, 0x00u8, 0x00u8,
    0x02u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x03u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  // A 40-byte buffer with ABI major = 2 (unsupported).
  pub let _hda_st_w_bad_abi : [u8; 40] = [
    0x53u8, 0x53u8, 0x46u8, 0x50u8,
    0x18u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x02u8,       // abi major = 2
    0x02u8, 0x00u8, 0x00u8, 0x00u8,
    0x02u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x03u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  pub let sof_topology_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M6-002 (#1163): boot witness for the SOF topology parser scaffold. Stages: (S10) parse_header(0, 40) -> BAD_BUF_PTR. (S20) parse_header(buf, 8) -> BAD_BUF_LEN. (S30) parse_header(bad_magic, 40) -> BAD_MAGIC. (S40) parse_header(buf, 100) -> BAD_SIZE (len/size disagree). (S50) parse_header(bad_abi, 40) -> BAD_ABI. (S60) parse_header(buf, 40) -> OK; count == 2. (S70) tuple_type(buf, 40, 0) == 2 (WIDGET). (S80) tuple_type(buf, 40, 1) == 3 (GRAPH). (S90) tuple_size(buf, 40, 0) == 0. (S100) tuple_type(buf, 40, 5) -> BAD_TUP_INDEX. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_st_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        // S10 -- parse_header(0, 40) -> BAD_BUF_PTR.
        mov rax, 10;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 40;
        call hda_sof_topology_parse_header;
        mov r11, 0xFFFFFC7F;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // S20 -- parse_header(buf, 8) -> BAD_BUF_LEN.
        mov rax, 20;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 8;
        call hda_sof_topology_parse_header;
        mov r11, 0xFFFFFC7E;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // S30 -- parse_header(bad_magic, 40) -> BAD_MAGIC.
        mov rax, 30;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_bad_magic];
        mov rsi, 40;
        call hda_sof_topology_parse_header;
        mov r11, 0xFFFFFC7D;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // S40 -- parse_header(buf, 100) -> BAD_SIZE.
        mov rax, 40;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 100;
        call hda_sof_topology_parse_header;
        mov r11, 0xFFFFFC7C;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // S50 -- parse_header(bad_abi, 40) -> BAD_ABI.
        mov rax, 50;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_bad_abi];
        mov rsi, 40;
        call hda_sof_topology_parse_header;
        mov r11, 0xFFFFFC7B;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // S60 -- parse_header(buf, 40) -> OK; count == 2.
        mov rax, 60;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 40;
        call hda_sof_topology_parse_header;
        cmp rax, 0;
        jne hda_st_w_fail_stage;
        lea rdi, [rip + _hda_st_w_buf];
        call hda_sof_topology_count;
        cmp rax, 2;
        jne hda_st_w_fail_stage;

        // S70 -- tuple_type(buf, 40, 0) == 2.
        mov rax, 70;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 40;
        xor rdx, rdx;
        call hda_sof_topology_tuple_type;
        cmp rax, 2;
        jne hda_st_w_fail_stage;

        // S80 -- tuple_type(buf, 40, 1) == 3.
        mov rax, 80;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 40;
        mov rdx, 1;
        call hda_sof_topology_tuple_type;
        cmp rax, 3;
        jne hda_st_w_fail_stage;

        // S90 -- tuple_size(buf, 40, 0) == 0.
        mov rax, 90;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 40;
        xor rdx, rdx;
        call hda_sof_topology_tuple_size;
        cmp rax, 0;
        jne hda_st_w_fail_stage;

        // S100 -- tuple_type(buf, 40, 5) -> BAD_TUP_INDEX.
        mov rax, 100;
        lea rcx, [rip + _hda_st_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_st_w_buf];
        mov rsi, 40;
        mov rdx, 5;
        call hda_sof_topology_tuple_type;
        mov r11, 0xFFFFFC7A;
        cmp rax, r11;
        jne hda_st_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_st_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_st_w_out;

      hda_st_w_fail_stage:
        lea rax, [rip + _hda_st_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_st_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_st_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
