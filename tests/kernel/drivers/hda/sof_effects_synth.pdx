// tests/kernel/drivers/hda/sof_effects_synth.pdx -- R33.M6-003 (#1164)
//
// Boot witness for the SOF EFFECT PIPELINE dispatch scaffold.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the arbitration pin (0), the READY gate (attach without a
// loader/codec bound returns NOT_READY), attach happy path (OK; slot
// stamped kind+1), the slot-busy refusal (second attach into occupied
// slot -> SLOT_BUSY), the slot-empty refusal (detach of empty slot),
// the kind/slot bounds (BAD_KIND on 8, BAD_SLOT on 8), and detach OK.
//
// RUNS AFTER alc287_init_witness (which binds codec 0) AND
// sof_loader_witness (which binds+advances to READY) so the two
// preconditions hold.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 SOF EFFECTS OK

module SofEffectsSynth = structure {

  pub let mut _hda_sfx_w_stage : u64 = 0

  pub let hda_sfx_w_ok   : [u8; 19] = "R33 SOF EFFECTS OK\0"
  pub let hda_sfx_w_fail : [u8; 21] = "R33 SOF EFFECTS FAIL\0"

  // A dummy firmware region for a mid-witness re-bind of the loader.
  pub let _hda_sfx_w_fw_region : [u8; 32] = "SOF effects witness firmware pad"

  pub let sof_effects_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M6-003 (#1164): boot witness for the SOF effects pipeline scaffold. Stages: (S10) arbitrated == 0. (S20) with loader RESET (not ready), attach(0, BASS) -> NOT_READY. (S30) re-bind + advance loader to READY. (S40) attach(0, BASS) -> OK; slot_kind(0) == BASS+1. (S50) attach(0, DRC) -> SLOT_BUSY. (S60) attach(9, DRC) -> BAD_SLOT. (S70) attach(1, 9) -> BAD_KIND. (S80) detach(0) -> OK; slot_kind(0) == 0. (S90) detach(0) -> SLOT_EMPTY. (S100) clear(); slot_kind on every slot == 0. Six pushes leave rsp%16 == 0 at nested calls. Labels prefixed hda_sfx_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        call hda_sof_effects_clear;

        // S10 -- arbitrated == 0.
        mov rax, 10;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        call hda_sof_effects_arbitrated;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;

        // S20 -- with loader RESET, attach -> NOT_READY.
        mov rax, 20;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        call hda_sof_loader_reset;
        xor rdi, rdi;
        mov rsi, 1;                          // BASS
        call hda_sof_effects_attach;
        mov r11, 0xFFFFFC6F;                 // NOT_READY
        cmp rax, r11;
        jne hda_sfx_w_fail_stage;

        // S30 -- re-bind + advance loader to READY.
        mov rax, 30;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hda_sfx_w_fw_region];
        mov rsi, 32;
        call hda_sof_loader_bind;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;
        call hda_sof_loader_mark_verified;
        call hda_sof_loader_advance;
        call hda_sof_loader_advance;
        call hda_sof_loader_advance;
        call hda_sof_loader_ready;
        cmp rax, 1;
        jne hda_sfx_w_fail_stage;

        // S40 -- attach(0, BASS) -> OK; slot_kind(0) == BASS+1 == 2.
        mov rax, 40;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;
        call hda_sof_effects_attach;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;
        xor rdi, rdi;
        call hda_sof_effects_slot_kind;
        cmp rax, 2;
        jne hda_sfx_w_fail_stage;

        // S50 -- attach(0, DRC) -> SLOT_BUSY.
        mov rax, 50;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 2;                          // DRC
        call hda_sof_effects_attach;
        mov r11, 0xFFFFFC6C;                 // SLOT_BUSY
        cmp rax, r11;
        jne hda_sfx_w_fail_stage;

        // S60 -- attach(9, DRC) -> BAD_SLOT.
        mov rax, 60;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        mov rdi, 9;
        mov rsi, 2;
        call hda_sof_effects_attach;
        mov r11, 0xFFFFFC6E;
        cmp rax, r11;
        jne hda_sfx_w_fail_stage;

        // S70 -- attach(1, 9) -> BAD_KIND.
        mov rax, 70;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 9;
        call hda_sof_effects_attach;
        mov r11, 0xFFFFFC6D;
        cmp rax, r11;
        jne hda_sfx_w_fail_stage;

        // S80 -- detach(0) -> OK; slot_kind(0) == 0.
        mov rax, 80;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_sof_effects_detach;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;
        xor rdi, rdi;
        call hda_sof_effects_slot_kind;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;

        // S90 -- detach(0) -> SLOT_EMPTY.
        mov rax, 90;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call hda_sof_effects_detach;
        mov r11, 0xFFFFFC6B;
        cmp rax, r11;
        jne hda_sfx_w_fail_stage;

        // S100 -- clear(); slot_kind for every slot == 0.
        mov rax, 100;
        lea rcx, [rip + _hda_sfx_w_stage];
        mov [rcx], rax;
        call hda_sof_effects_clear;
        xor rdi, rdi;
        call hda_sof_effects_slot_kind;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;
        mov rdi, 7;
        call hda_sof_effects_slot_kind;
        cmp rax, 0;
        jne hda_sfx_w_fail_stage;

        // Teardown: leave loader in a READY state so downstream witnesses
        // that gate on the loader do not have to re-bind.
        // (No effect table state; every slot is already cleared.)

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sfx_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_sfx_w_out;

      hda_sfx_w_fail_stage:
        lea rax, [rip + _hda_sfx_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_sfx_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_sfx_w_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
