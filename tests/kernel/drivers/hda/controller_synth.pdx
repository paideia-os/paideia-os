// tests/kernel/drivers/hda/controller_synth.pdx — R33.M1-001 (#1137)
//
// Boot witness for the HDA CONTROLLER PROBE + BAR MAPPING SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the bind latch (including the REBIND refusal), the
// arbitration pin (0 -- the honesty function), the refusal discipline
// (BAD_REG, NOT_BOUND) and the DEFERRED_HARDWARE outcome on both the
// read seam and the write seam. IT ASSERTS NOTHING ABOUT A REAL PCI
// PROBE OR REAL MMIO, because none runs in this tree --
// hda/controller.pdx §4 documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA CONTROLLER OK

module ControllerSynth = structure {

  pub let mut _hda_ct_w_stage : u64 = 0

  pub let hda_ct_w_ok   : [u8; 18] = "HDA CONTROLLER OK\0"
  pub let hda_ct_w_fail : [u8; 20] = "HDA CONTROLLER FAIL\0"

  pub let hda_controller_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M1-001 (#1137): boot witness for the HDA controller scaffold. Stages: (S1) bound() = 0 before bind; arbitrated() = 0 (honesty pin). (S2) read(HDA_REG_GCTL=0x08) before bind -> NOT_BOUND. (S3) bind(0xC0FFEE) -> OK; bound() = 1; arbitrated() STILL 0; bar() == 0xC0FFEE. (S4) read(0x08) after bind -> DEFERRED_HARDWARE. (S5) write(0x08, 0) after bind -> DEFERRED_HARDWARE. (S6) read(0x60) -> BAD_REG (past HDA_REG_MAX_OFFSET). write(0x60, 0) -> BAD_REG. (S7) bind(0xDEAD) a second time -> REBIND. (S8) reads() and writes() moved by exactly one each. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_ct_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- bound() = 0, arbitrated() = 0.
        mov rax, 10;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        call hda_controller_bound;
        cmp rax, 0;
        jne hda_ct_w_fail_stage;

        call hda_controller_arbitrated;
        cmp rax, 0;
        jne hda_ct_w_fail_stage;

        // S2 -- read before bind -> NOT_BOUND.
        mov rax, 20;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        mov rdi, 0x08;
        call hda_controller_read;
        mov r11, 0xFFFFFC4F;             // NOT_BOUND
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S3 -- bind, bound() = 1, arbitrated() still 0, bar() == 0xC0FFEE.
        mov rax, 30;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE;
        call hda_controller_bind;
        cmp rax, 0;
        jne hda_ct_w_fail_stage;

        call hda_controller_bound;
        cmp rax, 1;
        jne hda_ct_w_fail_stage;

        call hda_controller_arbitrated;
        cmp rax, 0;
        jne hda_ct_w_fail_stage;

        call hda_controller_bar;
        mov r11, 0xC0FFEE;
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S4 -- read after bind -> DEFERRED_HARDWARE.
        mov rax, 40;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        call hda_controller_reads;
        mov rbx, rax;                    // reads before

        mov rdi, 0x08;
        call hda_controller_read;
        mov r11, 0xFFFFFC4C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S5 -- write after bind -> DEFERRED_HARDWARE.
        mov rax, 50;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        call hda_controller_writes;
        mov r13, rax;                    // writes before

        mov rdi, 0x08;
        mov rsi, 0;
        call hda_controller_write;
        mov r11, 0xFFFFFC4C;
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S6 -- refusal boundaries.
        mov rax, 60;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        // read: reg = 0x60 (past HDA_REG_MAX_OFFSET) -> BAD_REG.
        mov rdi, 0x60;
        call hda_controller_read;
        mov r11, 0xFFFFFC4E;
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // write: reg = 0x60 -> BAD_REG.
        mov rdi, 0x60;
        mov rsi, 0;
        call hda_controller_write;
        mov r11, 0xFFFFFC4E;
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S7 -- second bind -> REBIND.
        mov rax, 70;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        mov rdi, 0xDEAD;
        call hda_controller_bind;
        mov r11, 0xFFFFFC4B;             // REBIND
        cmp rax, r11;
        jne hda_ct_w_fail_stage;

        // S8 -- reads() and writes() moved by exactly one each.
        mov rax, 80;
        lea rcx, [rip + _hda_ct_w_stage];
        mov [rcx], rax;

        call hda_controller_reads;
        sub rax, rbx;
        cmp rax, 1;                      // exactly S4
        jne hda_ct_w_fail_stage;

        call hda_controller_writes;
        sub rax, r13;
        cmp rax, 1;                      // exactly S5
        jne hda_ct_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_ct_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_ct_w_out;

      hda_ct_w_fail_stage:
        lea rax, [rip + _hda_ct_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_ct_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_ct_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
