// tests/kernel/drivers/hda/reset_synth.pdx — R33.M1-002 (#1138)
//
// Boot witness for the HDA CONTROLLER RESET SEQUENCE SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the arm and release seams propagate the controller write
// seam's return (DEFERRED_HARDWARE on the happy path, since
// controller_witness leaves the controller bound), the arbitration pin
// (0 -- the honesty function), and that each seam's call counter
// advances by exactly one on each dispatch. IT ASSERTS NOTHING ABOUT
// A REAL GCTL WRITE OR A REAL CRST READBACK POLL, because none runs
// in this tree -- hda/reset.pdx §3 documents the gated:hardware
// deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R33 HDA RESET OK
//
// -----------------------------------------------------------------------------
// Placement
// -----------------------------------------------------------------------------
//
// This witness MUST run after controller_witness -- arm and release
// dispatch through hda_controller_write, which returns NOT_BOUND
// unless the controller is bound. controller_witness leaves the
// controller in the bound state (S3 bind, S7 rebind attempt which
// does not clear the latch), so this witness sees the DEFERRED_HARDWARE
// happy path on both seams.

module ResetSynth = structure {

  pub let mut _hda_rs_w_stage : u64 = 0

  pub let hda_rs_w_ok   : [u8; 17] = "R33 HDA RESET OK\0"
  pub let hda_rs_w_fail : [u8; 19] = "R33 HDA RESET FAIL\0"

  pub let hda_reset_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R33.M1-002 (#1138): boot witness for the HDA reset scaffold. Stages: (S1) arbitrated() = 0 (honesty pin). (S2) arm() -> DEFERRED_HARDWARE (controller bound by controller_witness). arm_count() advanced by exactly one. (S3) release() -> DEFERRED_HARDWARE. release_count() advanced by exactly one. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hda_rs_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- arbitrated() = 0.
        mov rax, 10;
        lea rcx, [rip + _hda_rs_w_stage];
        mov [rcx], rax;

        call hda_reset_arbitrated;
        cmp rax, 0;
        jne hda_rs_w_fail_stage;

        // S2 -- arm() -> DEFERRED_HARDWARE; count advanced by exactly one.
        mov rax, 20;
        lea rcx, [rip + _hda_rs_w_stage];
        mov [rcx], rax;

        call hda_reset_arm_count;
        mov rbx, rax;                    // arm count before

        call hda_reset_arm;
        mov r11, 0xFFFFFC4C;             // DEFERRED_HARDWARE (from controller write)
        cmp rax, r11;
        jne hda_rs_w_fail_stage;

        call hda_reset_arm_count;
        sub rax, rbx;
        cmp rax, 1;
        jne hda_rs_w_fail_stage;

        // S3 -- release() -> DEFERRED_HARDWARE; count advanced by exactly one.
        mov rax, 30;
        lea rcx, [rip + _hda_rs_w_stage];
        mov [rcx], rax;

        call hda_reset_release_count;
        mov r13, rax;                    // release count before

        call hda_reset_release;
        mov r11, 0xFFFFFC4C;
        cmp rax, r11;
        jne hda_rs_w_fail_stage;

        call hda_reset_release_count;
        sub rax, r13;
        cmp rax, 1;
        jne hda_rs_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_rs_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hda_rs_w_out;

      hda_rs_w_fail_stage:
        lea rax, [rip + _hda_rs_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hda_rs_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hda_rs_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
