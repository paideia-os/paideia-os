// tests/kernel/drivers/cam/ipu6_verify_synth.pdx — R40.M1-002 (#1348)
//
// Boot witness for ipu6_verify.  Asserts NULL/undersize/magic
// refusals, vendor-sig-empty refusal, paideia-sig-empty refusal,
// section-shape refusal, dual-sig happy path with section extents
// recorded, idempotent identity re-verify, swap refusal, counter
// fanout and the arbitration honesty pin.
//
// Fingerprint: IPU6 VERIFY OK

module Ipu6VerifySynth = structure {

  pub let mut _ipvw_stage : u64 = 0

  pub let ipvw_ok   : [u8; 16] = "IPU6 VERIFY OK\0"
  pub let ipvw_fail : [u8; 18] = "IPU6 VERIFY FAIL\0"

  // Blob layout (§1 of ipu6_verify.pdx).  Represented as 16 u64s
  // (128 bytes) so code_off + code_len fit inside the buffer when
  // we build a good bundle.
  pub let mut _ipvw_blob_good        : [u64; 16] = uninit @align(64)
  pub let mut _ipvw_blob_no_vendor   : [u64; 16] = uninit @align(64)
  pub let mut _ipvw_blob_no_paideia  : [u64; 16] = uninit @align(64)
  pub let mut _ipvw_blob_bad_magic   : [u64; 16] = uninit @align(64)
  pub let mut _ipvw_blob_bad_sec     : [u64; 16] = uninit @align(64)

  pub let ipv_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M1-002 (#1348): boot witness. Stages: (1) reset + arbitration pin + blob prep. (2) NULL blob. (3) undersize. (4) bad magic. (5) vendor sig empty. (6) paideia sig empty. (7) bad section (code walks past blob_len). (8) happy path + row accessors. (9) idempotent same-bundle. (10) swap refusal. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        call ipv_reset;

        // Zero all five buffers.
        lea r10, [rip + _ipvw_blob_good];
        xor rax, rax;
        xor rcx, rcx;
      ipvw_zg:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ipvw_zg;

        lea r10, [rip + _ipvw_blob_no_vendor];
        xor rcx, rcx;
      ipvw_znv:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ipvw_znv;

        lea r10, [rip + _ipvw_blob_no_paideia];
        xor rcx, rcx;
      ipvw_znp:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ipvw_znp;

        lea r10, [rip + _ipvw_blob_bad_magic];
        xor rcx, rcx;
      ipvw_zbm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ipvw_zbm;

        lea r10, [rip + _ipvw_blob_bad_sec];
        xor rcx, rcx;
      ipvw_zbs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ipvw_zbs;

        // Populate good blob.
        //   hdr [0] = (body 0x50) << 32 | magic 'IPU6' LE 0x36555049
        //   [1..4] two sig slots (u64 pairs) — non-zero
        //   [5] code_off (u32 @+40) | code_len (u32 @+44)
        //   [7..15] body (opaque payload the digest reads)
        //
        // Section offset: code_off = 0x40, code_len = 0x10.
        // Lands inside the 128-byte blob (code 0x40..0x4F).
        lea r10, [rip + _ipvw_blob_good];
        mov rax, 0x0000005036555049;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;              // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;             // vendor_sig[1]
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;             // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;             // paideia_sig[1]
        // slot 5 (@+40): code_off = 0x40, code_len = 0x10
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;
        // Body words (readable at code_off).
        mov rax, 0xDEADC0DEC0FEBABE;
        mov [r10 + 64], rax;             // code word 0
        mov rax, 0xF00DFACEBAADFEED;
        mov [r10 + 72], rax;             // code word 1

        // no_vendor: valid header + code words, empty vendor.
        lea r10, [rip + _ipvw_blob_no_vendor];
        mov rax, 0x0000005036555049;
        mov [r10 + 0], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;

        // no_paideia: valid header + code words, empty paideia.
        lea r10, [rip + _ipvw_blob_no_paideia];
        mov rax, 0x0000005036555049;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;

        // bad_magic: wrong-magic header + both sig slots set +
        // valid section extent (so we can prove the magic check
        // catches it BEFORE the sig checks would).
        lea r10, [rip + _ipvw_blob_bad_magic];
        mov rax, 0x00000050DEADBEEF;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        // bad_sec: valid header + sigs, code_off + code_len walks
        // past blob_len (code_off = 0x40, code_len = 0xFF00 -> ends
        // at 0xFF40 which is > blob_len = 0x80).
        lea r10, [rip + _ipvw_blob_bad_sec];
        mov rax, 0x0000005036555049;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;
        // code walks off.
        mov rax, 0x0000FF0000000040;
        mov [r10 + 40], rax;

        call ipv_arbitrated;
        cmp rax, 0;
        jne ipvw_fail_stage;

        // -- 2. NULL blob.
        mov rax, 2;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF25A;             // NULL_BLOB
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 3. Undersize.
        mov rax, 3;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_good];
        mov rsi, 0x2F;                   // one below header size 0x30
        call ipv_verify;
        mov r11, 0xFFFFF25E;             // TOO_SMALL
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 4. Bad magic.
        mov rax, 4;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_bad_magic];
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF25D;             // BAD_MAGIC
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 5. Vendor sig empty.
        mov rax, 5;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_no_vendor];
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF25C;             // BAD_VENDOR_SIG
        cmp rax, r11;
        jne ipvw_fail_stage;

        // Standalone helper agrees.
        lea rdi, [rip + _ipvw_blob_no_vendor];
        mov rsi, 0x80;
        call ipv_verify_vendor;
        mov r11, 0xFFFFF25C;
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 6. Paideia sig empty.
        mov rax, 6;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_no_paideia];
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF25B;             // BAD_PAIDEIA_SIG
        cmp rax, r11;
        jne ipvw_fail_stage;

        lea rdi, [rip + _ipvw_blob_no_paideia];
        mov rsi, 0x80;
        call ipv_verify_paideia;
        mov r11, 0xFFFFF25B;
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 7. Bad section (code walks past blob_len).
        mov rax, 7;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_bad_sec];
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF259;             // BAD_SECTION
        cmp rax, r11;
        jne ipvw_fail_stage;

        // Precondition: nothing has succeeded.
        call ipv_is_verified;
        cmp rax, 0;
        jne ipvw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_good];
        mov rsi, 0x80;
        call ipv_verify;
        cmp rax, 0;
        jne ipvw_fail_stage;

        call ipv_is_verified;
        cmp rax, 1;
        jne ipvw_fail_stage;

        call ipv_blob_ptr_of;
        lea r11, [rip + _ipvw_blob_good];
        cmp rax, r11;
        jne ipvw_fail_stage;

        call ipv_blob_len_of;
        cmp rax, 0x80;
        jne ipvw_fail_stage;

        call ipv_code_off_of;
        cmp rax, 0x40;
        jne ipvw_fail_stage;

        call ipv_code_len_of;
        cmp rax, 0x10;
        jne ipvw_fail_stage;

        // -- 9. Idempotent same-bundle.
        mov rax, 9;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_good];
        mov rsi, 0x80;
        call ipv_verify;
        cmp rax, 0;
        jne ipvw_fail_stage;

        // -- 10. Swap refusal.
        mov rax, 10;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ipvw_blob_no_vendor];
        mov rsi, 0x80;
        call ipv_verify;
        mov r11, 0xFFFFF25F;             // BAD_ARG
        cmp rax, r11;
        jne ipvw_fail_stage;

        lea rdi, [rip + _ipvw_blob_good];
        mov rsi, 0x81;
        call ipv_verify;
        mov r11, 0xFFFFF25F;
        cmp rax, r11;
        jne ipvw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _ipvw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // VERIFIED
        call ipv_stat;
        cmp rax, 1;
        jne ipvw_fail_stage;

        mov rdi, 1;                      // VENDOR_MISS
        call ipv_stat;
        cmp rax, 1;
        jne ipvw_fail_stage;

        mov rdi, 2;                      // PAIDEIA_MISS
        call ipv_stat;
        cmp rax, 1;
        jne ipvw_fail_stage;

        mov rdi, 4;                      // SECTION_MISS
        call ipv_stat;
        cmp rax, 1;
        jne ipvw_fail_stage;

        mov rdi, 3;                      // REFUSED
        call ipv_stat;
        // NULL (2), TOO_SMALL (3), BAD_MAGIC (4), BAD_VENDOR (5),
        // BAD_PAIDEIA (6), BAD_SECTION (7), BAD_ARG (10 twice) = 8.
        cmp rax, 8;
        jne ipvw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipvw_ok];
        call klog_s1;

        call ipv_reset;
        xor rax, rax;
        jmp ipvw_out;

      ipvw_fail_stage:
        lea rax, [rip + _ipvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ipv_reset;
        mov rax, 1;

      ipvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
