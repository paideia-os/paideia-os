// tests/kernel/drivers/cam/sensor_init_synth.pdx — R40.M2-004 (#1354)
//
// Boot witness for sensor_init.  Asserts individual validators
// (mode/res/fps), the joint-support matrix (STILL / PREVIEW / VIDEO
// at their permitted geometries), refusals across BAD_MODE / BAD_RES /
// BAD_FPS / BAD_TRIPLE, teardown NOT_PROG, ALREADY_PROG, the
// happy path over three programmed triples (1920x1080@30 preview,
// 1280x720@60 video, 2592x1944@15 still), CTRL echoes, and counters.
//
// Fingerprint: R40 SENSOR INIT OK

module SensorInitSynth = structure {

  pub let mut _sinitw_stage : u64 = 0

  pub let sinitw_ok   : [u8; 20] = "R40 SENSOR INIT OK\n\0"
  pub let sinitw_fail : [u8; 22] = "R40 SENSOR INIT FAIL\n\0"

  pub let sinit_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M2-004 (#1354): boot witness. Stages: (1) reset + arbitration pin. (2) individual validators. (3) joint-support matrix. (4) BAD_MODE. (5) BAD_FPS. (6) BAD_RES. (7) BAD_TRIPLE. (8) NOT_PROG teardown. (9) Happy path -- preview 1920x1080@30. (10) CTRL echoes. (11) ALREADY_PROG. (12) Teardown + re-program video 1280x720@60. (13) Teardown + re-program still 2592x1944@15. (14) Counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        call sinit_reset;

        call sinit_arbitrated;
        cmp rax, 0;
        jne sinitw_fail_stage;

        // -- 2. Individual validators.
        mov rax, 2;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call sinit_mode_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 3;
        call sinit_mode_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 4;
        call sinit_mode_valid;
        cmp rax, 0;
        jne sinitw_fail_stage;
        mov rdi, 0;
        call sinit_mode_valid;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 15;
        call sinit_fps_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 60;
        call sinit_fps_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 45;
        call sinit_fps_valid;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 1920;
        mov rsi, 1080;
        call sinit_res_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 1280;
        mov rsi, 720;
        call sinit_res_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 2592;
        mov rsi, 1944;
        call sinit_res_valid;
        cmp rax, 1;
        jne sinitw_fail_stage;
        mov rdi, 800;                    // odd geometry
        mov rsi, 600;
        call sinit_res_valid;
        cmp rax, 0;
        jne sinitw_fail_stage;

        // -- 3. Joint-support matrix (spot check).
        mov rax, 3;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        // PREVIEW 1280x720@60 -- yes.
        mov rdi, 2;
        mov rsi, 1280;
        mov rdx, 720;
        mov rcx, 60;
        call sinit_triple_supported;
        cmp rax, 1;
        jne sinitw_fail_stage;

        // VIDEO 1920x1080@30 -- yes.
        mov rdi, 3;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call sinit_triple_supported;
        cmp rax, 1;
        jne sinitw_fail_stage;

        // STILL 2592x1944@15 -- yes.
        mov rdi, 1;
        mov rsi, 2592;
        mov rdx, 1944;
        mov rcx, 15;
        call sinit_triple_supported;
        cmp rax, 1;
        jne sinitw_fail_stage;

        // VIDEO 2592x1944@15 -- no (not accepted for video).
        mov rdi, 3;
        mov rsi, 2592;
        mov rdx, 1944;
        mov rcx, 15;
        call sinit_triple_supported;
        cmp rax, 0;
        jne sinitw_fail_stage;

        // PREVIEW 2592x1944@30 -- no.
        mov rdi, 2;
        mov rsi, 2592;
        mov rdx, 1944;
        mov rcx, 30;
        call sinit_triple_supported;
        cmp rax, 0;
        jne sinitw_fail_stage;

        // -- 4. BAD_MODE.
        mov rax, 4;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // out-of-range mode
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call sinit_program;
        mov r11, 0xFFFFF20F;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 5. BAD_FPS.
        mov rax, 5;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 24;                     // not in {15,30,60}
        call sinit_program;
        mov r11, 0xFFFFF20D;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 6. BAD_RES.
        mov rax, 6;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 800;                    // unsupported width
        mov rdx, 600;
        mov rcx, 30;
        call sinit_program;
        mov r11, 0xFFFFF20E;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 7. BAD_TRIPLE (VIDEO with 2592x1944@15 -- individually
        //         valid but not joint-supported).
        mov rax, 7;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 2592;
        mov rdx, 1944;
        mov rcx, 15;
        call sinit_program;
        mov r11, 0xFFFFF20C;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 8. NOT_PROG teardown.
        mov rax, 8;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        call sinit_teardown;
        mov r11, 0xFFFFF20A;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 9. Happy path -- PREVIEW 1920x1080@30.
        mov rax, 9;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call sinit_program;
        cmp rax, 0;
        jne sinitw_fail_stage;

        call sinit_is_programmed;
        cmp rax, 1;
        jne sinitw_fail_stage;

        // -- 10. CTRL echoes.
        mov rax, 10;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // CTRL_MODE
        call sinit_ctrl_read;
        cmp rax, 2;
        jne sinitw_fail_stage;

        mov rdi, 1;                      // CTRL_WIDTH
        call sinit_ctrl_read;
        mov r11, 1920;
        cmp rax, r11;
        jne sinitw_fail_stage;

        mov rdi, 2;                      // CTRL_HEIGHT
        call sinit_ctrl_read;
        mov r11, 1080;
        cmp rax, r11;
        jne sinitw_fail_stage;

        mov rdi, 3;                      // CTRL_FPS
        call sinit_ctrl_read;
        cmp rax, 30;
        jne sinitw_fail_stage;

        mov rdi, 4;                      // CTRL_REG_BYTES (preview = 96)
        call sinit_ctrl_read;
        cmp rax, 96;
        jne sinitw_fail_stage;

        mov rdi, 5;                      // CTRL_PROG_SEQ
        call sinit_ctrl_read;
        cmp rax, 1;
        jne sinitw_fail_stage;

        // -- 11. ALREADY_PROG.
        mov rax, 11;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 30;
        call sinit_program;
        mov r11, 0xFFFFF20B;
        cmp rax, r11;
        jne sinitw_fail_stage;

        // -- 12. Teardown + re-program VIDEO 1280x720@60.
        mov rax, 12;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        call sinit_teardown;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 3;
        mov rsi, 1280;
        mov rdx, 720;
        mov rcx, 60;
        call sinit_program;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 4;                      // CTRL_REG_BYTES (video = 192)
        call sinit_ctrl_read;
        cmp rax, 192;
        jne sinitw_fail_stage;

        // -- 13. Teardown + re-program STILL 2592x1944@15.
        mov rax, 13;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        call sinit_teardown;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 1;
        mov rsi, 2592;
        mov rdx, 1944;
        mov rcx, 15;
        call sinit_program;
        cmp rax, 0;
        jne sinitw_fail_stage;

        mov rdi, 4;                      // CTRL_REG_BYTES (still = 128)
        call sinit_ctrl_read;
        cmp rax, 128;
        jne sinitw_fail_stage;

        mov rdi, 5;                      // CTRL_PROG_SEQ = 3
        call sinit_ctrl_read;
        cmp rax, 3;
        jne sinitw_fail_stage;

        // -- 14. Counter fanout.
        mov rax, 14;
        lea rcx, [rip + _sinitw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // PROGRAMS
        call sinit_stat;
        cmp rax, 3;                      // stages 9, 12, 13
        jne sinitw_fail_stage;

        mov rdi, 1;                      // REFUSED
        call sinit_stat;
        // Only sinit_program refusals bump REFUSED (stages 4, 5, 6,
        // 7, 11 = 5).  Stage 8's sinit_teardown NOT_PROG returns
        // the error code but does not bump the counter, matching
        // the sibling mcsi_phy_teardown NOT_INITED convention.
        cmp rax, 5;
        jne sinitw_fail_stage;

        mov rdi, 2;                      // TEARDOWNS
        call sinit_stat;
        cmp rax, 2;                      // stages 12, 13
        jne sinitw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sinitw_ok];
        call klog_s1;

        call sinit_reset;
        xor rax, rax;
        jmp sinitw_out;

      sinitw_fail_stage:
        lea rax, [rip + _sinitw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sinitw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sinit_reset;
        mov rax, 1;

      sinitw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
