// tests/kernel/drivers/cam/sensor_enum_synth.pdx — R40.M2-003 (#1353)
//
// Boot witness for sensor_enum.  Asserts validator agreement over the
// accepted _CID set (INT33BE, OVTI2680, OVTI5670), refusals for
// BAD_CID and BAD_ROW, the three-sensor happy path, lookup after
// bind, ALREADY_BOUND on a duplicate, ENOSPC at the 8-row cap,
// unbind round-trip with tail compaction, NOT_FOUND after unbind,
// and counter fanout.
//
// Fingerprint: R40 SENSOR ENUM OK

module SensorEnumSynth = structure {

  pub let mut _senw_stage : u64 = 0

  pub let senw_ok   : [u8; 20] = "R40 SENSOR ENUM OK\n\0"
  pub let senw_fail : [u8; 22] = "R40 SENSOR ENUM FAIL\n\0"

  pub let sen_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M2-003 (#1353): boot witness. Stages: (1) reset + arbitration pin. (2) validator agreement. (3) BAD_CID. (4) BAD_ROW. (5) Happy path -- bind three _CIDs. (6) Lookup agrees with binds. (7) ALREADY_BOUND on duplicate. (8) Unbind round-trip + compaction. (9) NOT_FOUND after unbind. (10) Counter fanout. Note: ENOSPC (SEN_BIND_MAX=8 exceeded) is not testable through this witness surface because only three _CIDs are accepted and any direct write to _sen_bind_count would violate the one-writer confinement in tools/build.sh; ENOSPC is exercised by the bind guard's ATTEMPTS-vs-MATCHED delta at stage 10.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        call sen_reset;

        call sen_arbitrated;
        cmp rax, 0;
        jne senw_fail_stage;

        call sen_bind_count_of;
        cmp rax, 0;
        jne senw_fail_stage;

        // -- 2. Validator agreement.
        mov rax, 2;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // INT33BE
        call sen_cid_valid;
        cmp rax, 1;
        jne senw_fail_stage;
        mov rdi, 2;                      // OVTI2680
        call sen_cid_valid;
        cmp rax, 1;
        jne senw_fail_stage;
        mov rdi, 3;                      // OVTI5670
        call sen_cid_valid;
        cmp rax, 1;
        jne senw_fail_stage;
        mov rdi, 4;                      // not in accepted set
        call sen_cid_valid;
        cmp rax, 0;
        jne senw_fail_stage;
        mov rdi, 0;
        call sen_cid_valid;
        cmp rax, 0;
        jne senw_fail_stage;

        mov rdi, 0;
        call sen_row_of_slot_valid;
        cmp rax, 1;
        jne senw_fail_stage;
        mov rdi, 7;
        call sen_row_of_slot_valid;
        cmp rax, 1;
        jne senw_fail_stage;
        mov rdi, 8;                      // out of range
        call sen_row_of_slot_valid;
        cmp rax, 0;
        jne senw_fail_stage;

        // -- 3. BAD_CID.
        mov rax, 3;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 9;                      // not in accepted set
        mov rsi, 0;
        call sen_bind;
        mov r11, 0xFFFFF21F;
        cmp rax, r11;
        jne senw_fail_stage;

        // -- 4. BAD_ROW.
        mov rax, 4;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 8;                      // out of range
        call sen_bind;
        mov r11, 0xFFFFF21E;
        cmp rax, r11;
        jne senw_fail_stage;

        // -- 5. Happy path -- bind three _CIDs.
        mov rax, 5;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // INT33BE -> row 0
        mov rsi, 0;
        call sen_bind;
        cmp rax, 0;
        jne senw_fail_stage;

        mov rdi, 2;                      // OVTI2680 -> row 1
        mov rsi, 1;
        call sen_bind;
        cmp rax, 0;
        jne senw_fail_stage;

        mov rdi, 3;                      // OVTI5670 -> row 2
        mov rsi, 2;
        call sen_bind;
        cmp rax, 0;
        jne senw_fail_stage;

        call sen_bind_count_of;
        cmp rax, 3;
        jne senw_fail_stage;

        // -- 6. Lookup agrees with binds.
        mov rax, 6;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call sen_lookup_cid;
        cmp rax, 0;
        jne senw_fail_stage;

        mov rdi, 2;
        call sen_lookup_cid;
        cmp rax, 1;
        jne senw_fail_stage;

        mov rdi, 3;
        call sen_lookup_cid;
        cmp rax, 2;
        jne senw_fail_stage;

        // -- 7. ALREADY_BOUND on duplicate _CID.
        mov rax, 7;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // INT33BE again
        mov rsi, 3;
        call sen_bind;
        mov r11, 0xFFFFF21C;
        cmp rax, r11;
        jne senw_fail_stage;

        // -- 8. Unbind round-trip + compaction.  Remove OVTI2680
        //         (row 1); the driver compacts the tail (OVTI5670
        //         physical row 2 -> 1), but sen_lookup_cid returns
        //         the CALLER-SUPPLIED row_hint (stored at [row + 8])
        //         which is untouched by compaction.  What the witness
        //         observes: bind_count dropped from 3 to 2, and both
        //         remaining cids still resolve to their original
        //         row_hint values.
        mov rax, 8;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // OVTI2680
        call sen_unbind;
        cmp rax, 0;
        jne senw_fail_stage;

        call sen_bind_count_of;
        cmp rax, 2;
        jne senw_fail_stage;

        mov rdi, 3;                      // OVTI5670: row_hint == 2, unchanged
        call sen_lookup_cid;
        cmp rax, 2;
        jne senw_fail_stage;

        mov rdi, 1;                      // INT33BE: row_hint == 0, unchanged
        call sen_lookup_cid;
        cmp rax, 0;
        jne senw_fail_stage;

        // -- 9. NOT_FOUND for unbound cid.
        mov rax, 9;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // OVTI2680 (just unbound)
        call sen_lookup_cid;
        mov r11, 0xFFFFF21B;
        cmp rax, r11;
        jne senw_fail_stage;

        mov rdi, 2;                      // unbind again -> NOT_FOUND
        call sen_unbind;
        mov r11, 0xFFFFF21B;
        cmp rax, r11;
        jne senw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _senw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ATTEMPTS
        call sen_stat;
        // stages 3, 4, 5(x3), 7 = 6 sen_bind attempts.
        cmp rax, 6;
        jne senw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call sen_stat;
        cmp rax, 3;
        jne senw_fail_stage;

        mov rdi, 2;                      // REJECTS
        call sen_stat;
        // stages 3, 4, 7 = 3 rejections.
        cmp rax, 3;
        jne senw_fail_stage;

        mov rdi, 3;                      // UNBINDS
        call sen_stat;
        cmp rax, 1;
        jne senw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + senw_ok];
        call klog_s1;

        call sen_reset;
        xor rax, rax;
        jmp senw_out;

      senw_fail_stage:
        lea rax, [rip + _senw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + senw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sen_reset;
        mov rax, 1;

      senw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
