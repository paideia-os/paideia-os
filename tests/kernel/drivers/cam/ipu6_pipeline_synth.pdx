// tests/kernel/drivers/cam/ipu6_pipeline_synth.pdx — R40.M3-001 (#1355)
//
// Boot witness for ipu6_pipeline.  Asserts individual validators
// (stage / format / dim), the configure gate (BAD_FORMAT / BAD_DIM /
// BAD_ARG / ALREADY_CONFIGURED / NOT_CONFIGURED), single-stage runs,
// full-chain process_frame with FRAMES_IN/OUT accounting, teardown
// NOT_CONFIGURED, and counter fanout.
//
// Fingerprint: R40 IPU6 PIPELINE OK

module Ipu6PipelineSynth = structure {

  pub let mut _ipp2w_stage : u64 = 0

  pub let ipp2w_ok   : [u8; 22] = "R40 IPU6 PIPELINE OK\n\0"
  pub let ipp2w_fail : [u8; 24] = "R40 IPU6 PIPELINE FAIL\n\0"

  pub let ipu6_pipeline_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M3-001 (#1355): boot witness. Stages: (1) reset + arbitration pin. (2) validators (stage, format, dim). (3) NOT_CONFIGURED on run_stage/process_frame/teardown. (4) configure BAD_FORMAT. (5) configure BAD_DIM. (6) configure BAD_ARG (stream_key=0). (7) Happy configure. (8) ALREADY_CONFIGURED. (9) run_stage BAD_STAGE (=4). (10) process_frame chain (three frames). (11) CTRL echoes (FRAMES_IN/OUT, per-stage counts). (12) teardown + reconfigure.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        call ipp2_reset;

        call ipp2_arbitrated;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call ipp2_stage_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 3;
        call ipp2_stage_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 4;
        call ipp2_stage_valid;
        cmp rax, 0;
        jne ipp2w_fail_stage;
        mov rdi, 0;
        call ipp2_stage_valid;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        mov rdi, 1;
        call ipp2_format_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 3;
        call ipp2_format_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 4;
        call ipp2_format_valid;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        mov rdi, 1;
        call ipp2_dim_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 8192;
        call ipp2_dim_valid;
        cmp rax, 1;
        jne ipp2w_fail_stage;
        mov rdi, 8193;
        call ipp2_dim_valid;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        // -- 3. NOT_CONFIGURED on run_stage / process_frame / teardown.
        mov rax, 3;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call ipp2_run_stage;
        mov r11, 0xFFFFF1EC;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        call ipp2_process_frame;
        mov r11, 0xFFFFF1EC;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        call ipp2_teardown;
        mov r11, 0xFFFFF1EC;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 4. configure BAD_FORMAT.
        mov rax, 4;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE;
        mov rsi, 4;                      // fmt=4 (illegal)
        mov rdx, 1920;
        mov rcx, 1080;
        call ipp2_configure;
        mov r11, 0xFFFFF1EE;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 5. configure BAD_DIM.
        mov rax, 5;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE;
        mov rsi, 1;
        mov rdx, 0;                      // width=0
        mov rcx, 1080;
        call ipp2_configure;
        mov r11, 0xFFFFF1ED;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 6. configure BAD_ARG (stream_key=0).
        mov rax, 6;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 1920;
        mov rcx, 1080;
        call ipp2_configure;
        mov r11, 0xFFFFF1EA;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 7. Happy configure.
        mov rax, 7;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE;
        mov rsi, 1;                      // NV12
        mov rdx, 1920;
        mov rcx, 1080;
        call ipp2_configure;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        call ipp2_is_configured;
        cmp rax, 1;
        jne ipp2w_fail_stage;

        // -- 8. ALREADY_CONFIGURED.
        mov rax, 8;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE;
        mov rsi, 1;
        mov rdx, 1920;
        mov rcx, 1080;
        call ipp2_configure;
        mov r11, 0xFFFFF1EB;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 9. run_stage BAD_STAGE (=4).
        mov rax, 9;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 4;
        call ipp2_run_stage;
        mov r11, 0xFFFFF1EF;
        cmp rax, r11;
        jne ipp2w_fail_stage;

        // -- 10. process_frame chain (three frames).
        mov rax, 10;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        call ipp2_process_frame;
        cmp rax, 0;
        jne ipp2w_fail_stage;
        call ipp2_process_frame;
        cmp rax, 0;
        jne ipp2w_fail_stage;
        call ipp2_process_frame;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        // -- 11. CTRL echoes: FRAMES_IN=3, FRAMES_OUT=3, per-stage 3.
        mov rax, 11;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // FRAMES_IN
        call ipp2_ctrl_read;
        cmp rax, 3;
        jne ipp2w_fail_stage;

        mov rdi, 5;                      // FRAMES_OUT
        call ipp2_ctrl_read;
        cmp rax, 3;
        jne ipp2w_fail_stage;

        mov rdi, 6;                      // LAST_STAGE
        call ipp2_ctrl_read;
        cmp rax, 3;                      // FORMAT
        jne ipp2w_fail_stage;

        mov rdi, 1;                      // DENOISE stage count
        call ipp2_stage_count;
        cmp rax, 3;
        jne ipp2w_fail_stage;

        mov rdi, 2;                      // ISP
        call ipp2_stage_count;
        cmp rax, 3;
        jne ipp2w_fail_stage;

        mov rdi, 3;                      // FORMAT
        call ipp2_stage_count;
        cmp rax, 3;
        jne ipp2w_fail_stage;

        // -- 12. teardown + reconfigure with different geom.
        mov rax, 12;
        lea rcx, [rip + _ipp2w_stage];
        mov [rcx], rax;

        call ipp2_teardown;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        call ipp2_is_configured;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        mov rdi, 0xC0FFEE2;
        mov rsi, 2;                      // YUYV
        mov rdx, 1280;
        mov rcx, 720;
        call ipp2_configure;
        cmp rax, 0;
        jne ipp2w_fail_stage;

        mov rdi, 1;                      // FORMAT
        call ipp2_ctrl_read;
        cmp rax, 2;                      // YUYV
        jne ipp2w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipp2w_ok];
        call klog_s1;

        call ipp2_reset;
        xor rax, rax;
        jmp ipp2w_out;

      ipp2w_fail_stage:
        lea rax, [rip + _ipp2w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ipp2w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ipp2_reset;
        mov rax, 1;

      ipp2w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
