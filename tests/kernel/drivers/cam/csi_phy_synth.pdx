// tests/kernel/drivers/cam/csi_phy_synth.pdx — R40.M2-002 (#1351)
//
// Boot witness for csi_phy (MIPI-CSI D-PHY 2.5 receiver init).  Asserts
// validator agreement (lanes and rate), ESC_TIMEOUT, ALREADY_INITED,
// BAD_LANES, BAD_RATE, teardown NOT_INITED and the happy path over
// 1 / 2 / 4 lanes with the default 1.5 Gbps setpoint plus CTRL echoes.
//
// Fingerprint: R40 CSI PHY OK

module CsiPhySynth = structure {

  pub let mut _mcsiw_stage : u64 = 0

  pub let mcsiw_ok   : [u8; 16] = "R40 CSI PHY OK\n\0"
  pub let mcsiw_fail : [u8; 18] = "R40 CSI PHY FAIL\n\0"

  pub let mcsi_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M2-002 (#1351): boot witness. Stages: (1) reset + arbitration pin. (2) validator agreement. (3) NOT_INITED teardown. (4) ESC_TIMEOUT. (5) reset + stamp ESC + happy path 2 lanes @ 1.5 Gbps. (6) CTRL echoes. (7) ALREADY_INITED. (8) teardown round-trip + 4-lane re-init. (9) 1-lane re-init after teardown. (10) BAD_LANES + BAD_RATE. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_reset;

        call mcsi_arbitrated;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        // -- 2. Validator agreement.
        mov rax, 2;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call mcsi_lanes_valid;
        cmp rax, 1;
        jne mcsiw_fail_stage;
        mov rdi, 2;
        call mcsi_lanes_valid;
        cmp rax, 1;
        jne mcsiw_fail_stage;
        mov rdi, 4;
        call mcsi_lanes_valid;
        cmp rax, 1;
        jne mcsiw_fail_stage;
        mov rdi, 3;                      // 3 lanes refused (MIPI D-PHY)
        call mcsi_lanes_valid;
        cmp rax, 0;
        jne mcsiw_fail_stage;
        mov rdi, 8;
        call mcsi_lanes_valid;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        mov rdi, 1500000000;             // 1.5 Gbps
        call mcsi_rate_valid;
        cmp rax, 1;
        jne mcsiw_fail_stage;
        mov rdi, 0x10C388D00;            // 4500000000 (4.5 Gbps top) — must be hex; imm32-truncated form drops the high bit
        call mcsi_rate_valid;
        cmp rax, 1;
        jne mcsiw_fail_stage;
        mov rdi, 0;
        call mcsi_rate_valid;
        cmp rax, 0;
        jne mcsiw_fail_stage;
        mov rdi, 0x12A05F200;            // 5000000000 (above 4.5 Gbps) — same hex-only rule
        call mcsi_rate_valid;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        // -- 3. NOT_INITED teardown.
        mov rax, 3;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_phy_teardown;
        mov r11, 0xFFFFF229;             // NOT_INITED
        cmp rax, r11;
        jne mcsiw_fail_stage;

        // -- 4. ESC_TIMEOUT (ESC_SETTLED never stamped).
        mov rax, 4;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1500000000;
        call mcsi_phy_init;
        mov r11, 0xFFFFF22C;             // ESC_TIMEOUT
        cmp rax, r11;
        jne mcsiw_fail_stage;

        call mcsi_is_inited;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        // -- 5. Reset, stamp ESC, happy path 2 lanes @ 1.5 Gbps.
        mov rax, 5;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_reset;
        call mcsi_ctrl_stamp_esc_settled;

        mov rdi, 2;
        mov rsi, 1500000000;
        call mcsi_phy_init;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        call mcsi_is_inited;
        cmp rax, 1;
        jne mcsiw_fail_stage;

        // -- 6. CTRL echoes.
        mov rax, 6;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // CTRL_LANE_MASK
        call mcsi_ctrl_read;
        cmp rax, 3;                      // (1<<2)-1 = 3
        jne mcsiw_fail_stage;

        mov rdi, 1;                      // CTRL_HSRX_ENABLE
        call mcsi_ctrl_read;
        cmp rax, 1;
        jne mcsiw_fail_stage;

        mov rdi, 2;                      // CTRL_DATA_RATE
        call mcsi_ctrl_read;
        mov r11, 1500000000;
        cmp rax, r11;
        jne mcsiw_fail_stage;

        mov rdi, 4;                      // CTRL_INIT_SEQ
        call mcsi_ctrl_read;
        cmp rax, 1;
        jne mcsiw_fail_stage;

        // -- 7. ALREADY_INITED.
        mov rax, 7;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 1500000000;
        call mcsi_phy_init;
        mov r11, 0xFFFFF22A;             // ALREADY_INITED
        cmp rax, r11;
        jne mcsiw_fail_stage;

        // -- 8. Teardown round-trip + 4-lane re-init.
        mov rax, 8;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_phy_teardown;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        call mcsi_is_inited;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        // 4-lane re-init.  ESC_SETTLED still stamped from stage 5.
        mov rdi, 4;
        mov rsi, 1500000000;
        call mcsi_phy_init;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        mov rdi, 0;                      // CTRL_LANE_MASK
        call mcsi_ctrl_read;
        cmp rax, 15;                     // (1<<4)-1 = 15
        jne mcsiw_fail_stage;

        // -- 9. 1-lane re-init after teardown.
        mov rax, 9;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_phy_teardown;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        mov rdi, 1;
        mov rsi, 1500000000;
        call mcsi_phy_init;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        mov rdi, 0;
        call mcsi_ctrl_read;
        cmp rax, 1;                      // (1<<1)-1 = 1
        jne mcsiw_fail_stage;

        // -- 10. BAD_LANES + BAD_RATE (both need init cleared).
        mov rax, 10;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        call mcsi_phy_teardown;
        cmp rax, 0;
        jne mcsiw_fail_stage;

        mov rdi, 3;                      // 3 lanes
        mov rsi, 1500000000;
        call mcsi_phy_init;
        mov r11, 0xFFFFF22E;             // BAD_LANES
        cmp rax, r11;
        jne mcsiw_fail_stage;

        mov rdi, 2;
        mov rsi, 0;                      // rate=0
        call mcsi_phy_init;
        mov r11, 0xFFFFF22D;             // BAD_RATE
        cmp rax, r11;
        jne mcsiw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _mcsiw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // INITS
        call mcsi_stat;
        cmp rax, 3;                      // stages 5, 8, 9
        jne mcsiw_fail_stage;

        mov rdi, 1;                      // TIMEOUTS
        call mcsi_stat;
        cmp rax, 1;                      // stage 4
        jne mcsiw_fail_stage;

        mov rdi, 3;                      // TEARDOWNS
        call mcsi_stat;
        cmp rax, 3;                      // stages 8, 9, 10
        jne mcsiw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mcsiw_ok];
        call klog_s1;

        call mcsi_reset;
        xor rax, rax;
        jmp mcsiw_out;

      mcsiw_fail_stage:
        lea rax, [rip + _mcsiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mcsiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mcsi_reset;
        mov rax, 1;

      mcsiw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
