// tests/kernel/drivers/cam/ipu6_load_synth.pdx — R40.M1-003 (#1349)
//
// Boot witness for ipu6_load.  Asserts precondition gate
// (NOT_VERIFIED), ALREADY_LOADED refusal, READY_TIMEOUT (BOOT_READY
// bit never set), the happy path with stamped BOOT_READY, and CTRL
// echoes for the uploaded code section plus the CPU_HALT release
// edge.
//
// Fingerprint: R40 IPU6 LOAD OK

module Ipu6LoadSynth = structure {

  pub let mut _iplw_stage : u64 = 0

  pub let iplw_ok   : [u8; 18] = "R40 IPU6 LOAD OK\n\0"
  pub let iplw_fail : [u8; 20] = "R40 IPU6 LOAD FAIL\n\0"

  // A well-formed bundle.  Backing storage sized so code_off +
  // code_len fits:
  //   code_off = 0x40, code_len = 0x80000 -> ends at 0x80040
  //   blob_len declared = 0x80100
  //   backing storage = [u64; 65536] = 512 KiB (0x80000 bytes)
  //     ... but code end at 0x80040 -> need 0x80048 storage
  //     ... use 131072 u64s = 1 MiB (0x100000 bytes)
  //
  // The digest reads read two u64s at code_off; the offset sits
  // inside the 1 MiB storage, so the reads are in-bounds.
  pub let mut _iplw_blob : [u64; 131072] = uninit @align(64)

  pub let ipl_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M1-003 (#1349): boot witness. Stages: (1) reset both modules + arbitration pin + bundle prep. (2) NOT_VERIFIED before verify. (3) verify a well-formed bundle. (4) READY_TIMEOUT (BOOT_READY never set). (5) reset + stamp READY + reload happy. (6) CTRL echoes. (7) ALREADY_LOADED. (8) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        call ipl_reset;
        call ipv_reset;

        // Zero the bundle header (16 u64s = 128 bytes).  Rest of
        // .bss is zero-init.
        lea r10, [rip + _iplw_blob];
        xor rax, rax;
        xor rcx, rcx;
      iplw_zhdr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  iplw_zhdr;

        // Populate bundle header.
        // hdr [0] = (body 0x80000) << 32 | magic 'IPU6' LE
        //         = 0x0008000036555049
        lea r10, [rip + _iplw_blob];
        mov rax, 0x0008000036555049;
        mov [r10 + 0], rax;

        // sig slots — non-zero.
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;              // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;             // vendor_sig[1]
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;             // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;             // paideia_sig[1]

        // slot 5 (@+40): code_off = 0x40 | (code_len = 0x80000)<<32
        //              = 0x0008000000000040
        mov rax, 0x0008000000000040;
        mov [r10 + 40], rax;

        // Digest source words at code_off = 0x40.
        mov rax, 0xDEADC0DEC0FEBABE;
        mov [r10 + 64], rax;             // code[0]
        mov rax, 0xF00DFACEBAADFEED;
        mov [r10 + 72], rax;             // code[1]

        call ipl_arbitrated;
        cmp rax, 0;
        jne iplw_fail_stage;

        // -- 2. NOT_VERIFIED before verify.
        mov rax, 2;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        // chip_rev arbitrary here — the gate is verified, not compat.
        mov rdi, 0x00010500;
        call ipl_load;
        mov r11, 0xFFFFF24E;             // NOT_VERIFIED
        cmp rax, r11;
        jne iplw_fail_stage;

        // -- 3. Verify a well-formed bundle.
        mov rax, 3;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _iplw_blob];
        mov rsi, 0x80100;
        call ipv_verify;
        cmp rax, 0;
        jne iplw_fail_stage;

        // -- 4. READY_TIMEOUT.
        // Currently BOOT_READY (CTRL_STATUS bit 0) is clear, so a
        // load that reaches the poll times out.
        mov rax, 4;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        mov rdi, 0x00010500;
        call ipl_load;
        mov r11, 0xFFFFF24B;             // READY_TIMEOUT
        cmp rax, r11;
        jne iplw_fail_stage;

        // Iters counter shows the poll ran to the bound.
        call ipl_ready_iters_of;
        mov r11, 0x100000;
        cmp rax, r11;
        jne iplw_fail_stage;

        // The load was NOT successful.
        call ipl_is_loaded;
        cmp rax, 0;
        jne iplw_fail_stage;

        // -- 5. Reset load state, stamp READY, retry.
        mov rax, 5;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        call ipl_reset;
        call ipl_ctrl_stamp_ready;

        mov rdi, 0x00010506;
        call ipl_load;
        cmp rax, 0;
        jne iplw_fail_stage;

        call ipl_is_loaded;
        cmp rax, 1;
        jne iplw_fail_stage;

        // Ready-iters is 0 (BOOT_READY was set before the poll).
        call ipl_ready_iters_of;
        cmp rax, 0;
        jne iplw_fail_stage;

        // -- 6. CTRL echoes.
        mov rax, 6;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        // CODE_ADDR echoed the SRAM base.
        mov rdi, 3;                      // IPL_CTRL_CODE_ADDR
        call ipl_ctrl_read;
        mov r11, 0x200000;
        cmp rax, r11;
        jne iplw_fail_stage;

        // CODE_DIGEST = code[0] XOR code[1].
        mov rdi, 4;                      // IPL_CTRL_CODE_DIGEST
        call ipl_ctrl_read;
        mov r11, 0xDEADC0DEC0FEBABE;
        mov r10, 0xF00DFACEBAADFEED;
        xor r11, r10;
        cmp rax, r11;
        jne iplw_fail_stage;

        // CPU_HALT was released (CTRL_RESET bit 0 clear).
        mov rdi, 0;                      // IPL_CTRL_RESET
        call ipl_ctrl_read;
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        jne iplw_fail_stage;

        // CHIP_REV was stamped with caller's value.
        mov rdi, 2;                      // IPL_CTRL_CHIP_REV
        call ipl_ctrl_read;
        mov r11, 0x00010506;
        cmp rax, r11;
        jne iplw_fail_stage;

        // Upload seq bumped.
        mov rdi, 5;                      // IPL_CTRL_UPLOAD_SEQ
        call ipl_ctrl_read;
        cmp rax, 1;
        jne iplw_fail_stage;

        // -- 7. ALREADY_LOADED.
        mov rax, 7;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        mov rdi, 0x00010506;
        call ipl_load;
        mov r11, 0xFFFFF24A;             // ALREADY_LOADED
        cmp rax, r11;
        jne iplw_fail_stage;

        // -- 8. Counter fanout.
        mov rax, 8;
        lea rcx, [rip + _iplw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // LOADS
        call ipl_stat;
        cmp rax, 1;                      // stage 5
        jne iplw_fail_stage;

        mov rdi, 1;                      // TIMEOUTS
        call ipl_stat;
        // Stage 4's timeout is wiped by stage 5's ipl_reset (which
        // zeros stats along with the CTRL bank per the driver's
        // "boot + teardown" contract).  Only counters accumulated
        // AFTER the reset are observable here.
        cmp rax, 0;
        jne iplw_fail_stage;

        mov rdi, 2;                      // REFUSED
        call ipl_stat;
        // Post-reset refusals: ALREADY_LOADED at stage 7 = 1.
        cmp rax, 1;
        jne iplw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + iplw_ok];
        call klog_s1;

        call ipl_reset;
        call ipv_reset;
        xor rax, rax;
        jmp iplw_out;

      iplw_fail_stage:
        lea rax, [rip + _iplw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + iplw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ipl_reset;
        call ipv_reset;
        mov rax, 1;

      iplw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
