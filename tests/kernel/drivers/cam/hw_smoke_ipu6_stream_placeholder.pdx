// tests/kernel/drivers/cam/hw_smoke_ipu6_stream_placeholder.pdx —
//   R40.M3-004 (#1358)
//
// DORMANT hardware-gated placeholder for the R40.M3 IPU6 capture-
// stream smoke on a real ThinkPad T14 G4.
//
// #1358 delivers `tools/hw-smoke-r40-ipu6-stream.md`: an operator
// recipe for asserting that the R40.M3 wire (KIND_IPU6_STREAM +
// IPU6 imaging pipeline + camera_capture_channel) delivers a steady
// 30 fps NV12 frame stream against a real IPU6-driven MIPI-CSI
// sensor and its shipping firmware bundle.  Per
// design/roadmap/next-wave-synthesis.md §10 D7 (gated:hardware
// discipline), an issue whose acceptance requires PHYSICAL hardware
// in the loop CANNOT emit a golden fingerprint from a QEMU-OVMF
// boot -- QEMU has no CSI transport, no image sensor to shovel
// pixels through, and the fingerprint would lie.
//
// The RIGHT SHAPE for a dormant issue is a placeholder module that
// COMPILES but emits NOTHING.  This module is that placeholder.  It
// carries no witness function, no fingerprint, and no boot-witness
// registration.  The build-time coverage gate is satisfied because
// there is nothing to cover.
//
// When R40.M4+ or a later milestone lands the IPU6 capture smoke on
// real hardware, this file is replaced by a real synth that emits
// "R40 IPU6 STREAM HW-SMOKE OK" and takes ITS marker into the golden.
//
// The empty module is deliberately unreferenced from
// r30_platform.pdx.  That is the whole point of the dormant shape:
// nothing at boot calls into it, so nothing at boot lies about it.

module HwSmokeIpu6StreamPlaceholder = structure {
  // Compile-only marker so paideia-as accepts an "empty" module.
  pub let _r40_m3_004_hw_smoke_ipu6_stream_placeholder : u64 = 0
}
