// tests/kernel/drivers/cam/ipu6_probe_synth.pdx — R40.M1-001 (#1347)
//
// Boot witness for ipu6_probe.  Asserts BAD_CLASS, BAD_VENDOR,
// BAD_FAMILY, BAD_BAR0, MISALIGNED, BAD_CAPS, BAD_HW_TYPE refusals;
// the two-family happy path (0x9A19 / 0x462E); the decode packing
// of hw_type|step|dash; counter fanout and the arbitration honesty
// pin.
//
// Fingerprint: IPU6 PROBE OK

module Ipu6ProbeSynth = structure {

  pub let mut _ippw_stage : u64 = 0

  pub let ippw_ok   : [u8; 15] = "IPU6 PROBE OK\0"
  pub let ippw_fail : [u8; 17] = "IPU6 PROBE FAIL\0"

  pub let ipu6_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R40.M1-001 (#1347): boot witness. Stages: (1) reset + arbitration pin. (2) validator agreement in isolation. (3) BAD_CLASS. (4) BAD_VENDOR. (5) BAD_FAMILY. (6) BAD_BAR0 (base=0 and short length). (7) MISALIGNED. (8) BAD_CAPS (0 word). (9) BAD_HW_TYPE (type nibble 0). (10) happy path over both device ids + decode packing. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        call ipp_probe_reset;

        call ipp_probe_arbitrated;
        cmp rax, 0;
        jne ippw_fail_stage;

        // -- 2. Validator agreement.
        mov rax, 2;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        call ipp_class_valid;
        cmp rax, 1;
        jne ippw_fail_stage;
        mov rdi, 0x0300;
        call ipp_class_valid;
        cmp rax, 0;
        jne ippw_fail_stage;

        mov rdi, 0x8086;
        call ipp_vendor_valid;
        cmp rax, 1;
        jne ippw_fail_stage;
        mov rdi, 0x10DE;
        call ipp_vendor_valid;
        cmp rax, 0;
        jne ippw_fail_stage;

        mov rdi, 0x9A19;
        call ipp_family_valid;
        cmp rax, 1;
        jne ippw_fail_stage;
        mov rdi, 0x462E;
        call ipp_family_valid;
        cmp rax, 1;
        jne ippw_fail_stage;
        mov rdi, 0x1919;                 // IPU3-ish -- refused
        call ipp_family_valid;
        cmp rax, 0;
        jne ippw_fail_stage;

        // -- 3. BAD_CLASS.
        mov rax, 3;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;                 // Display / VGA (wrong)
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00010500;              // hw_type nibble = 0x105
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26E;             // BAD_CLASS
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 4. BAD_VENDOR.
        mov rax, 4;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x10DE;                 // NVIDIA (wrong)
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00010500;
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26D;             // BAD_VENDOR
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 5. BAD_FAMILY.
        mov rax, 5;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x1919;                 // IPU3
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00010500;
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26C;             // BAD_FAMILY
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 6. BAD_BAR0 (base=0).
        mov rax, 6;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0;                      // NULL base
        mov r8, 0x800000;
        mov r9, 0x00010500;
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26B;             // BAD_BAR0
        cmp rax, r11;
        jne ippw_fail_stage;

        // BAD_BAR0 (len < 8 MB).
        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x100000;                // 1 MB (too small)
        mov r9, 0x00010500;
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26B;
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 7. MISALIGNED (base not 64 KiB aligned).
        mov rax, 7;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80008000;             // 32 KiB aligned, not 64
        mov r8, 0x800000;
        mov r9, 0x00010500;
        call ipp_probe_recognise;
        mov r11, 0xFFFFF26A;             // MISALIGNED
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 8. BAD_CAPS (0).
        mov rax, 8;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0;                       // BAD_CAPS
        call ipp_probe_recognise;
        mov r11, 0xFFFFF269;
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 9. BAD_HW_TYPE (chip-type nibble 0).
        mov rax, 9;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00000005;              // type nibble 0, step=1, dash=1
        call ipp_probe_recognise;
        mov r11, 0xFFFFF268;             // BAD_HW_TYPE
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 10. Happy path — 0x9A19 with hw_type=0x105, step=1,
        //         dash=2 (caps = 0x00010506 -> type 0x105,
        //         step (bits 3..2)=1, dash (bits 1..0)=2).
        mov rax, 10;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x9A19;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00010506;
        call ipp_probe_recognise;
        // Expected: hw_type | (step << 16) | (dash << 24)
        //         = 0x105 | (1 << 16) | (2 << 24) = 0x02010105
        mov r11, 0x02010105;
        cmp rax, r11;
        jne ippw_fail_stage;

        // Same for 0x462E.
        mov rdi, 0x0480;
        mov rsi, 0x8086;
        mov rdx, 0x462E;
        mov rcx, 0x80000000;
        mov r8, 0x800000;
        mov r9, 0x00010506;
        call ipp_probe_recognise;
        mov r11, 0x02010105;
        cmp rax, r11;
        jne ippw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _ippw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ATTEMPTS
        call ipp_probe_stat;
        // Stages 3..10: stage 6 hits twice, stages 3/4/5/7/8/9 once
        // each, stage 10 twice = 2 + 6 + 2 = 10.
        cmp rax, 10;
        jne ippw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call ipp_probe_stat;
        cmp rax, 2;                      // two happy path admits
        jne ippw_fail_stage;

        mov rdi, 2;                      // REJECTS
        call ipp_probe_stat;
        cmp rax, 8;                      // 8 refusals total
        jne ippw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ippw_ok];
        call klog_s1;

        call ipp_probe_reset;
        xor rax, rax;
        jmp ippw_out;

      ippw_fail_stage:
        lea rax, [rip + _ippw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ippw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ipp_probe_reset;
        mov rax, 1;

      ippw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
