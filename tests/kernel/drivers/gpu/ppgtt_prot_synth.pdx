// tests/kernel/drivers/gpu/ppgtt_prot_synth.pdx — R37.M4-004 (#1270)
//
// Boot witness for the PPGTT protection-bit composer.
//
// Asserts prot / frame / mocs validators, compose for RO / RW / RX,
// round-trip through extract_prot, MOCS bit mapping, and range-
// invalidate arithmetic.
//
// Fingerprint: R37 PPGTT PROT OK

module PpgttProtSynth = structure {

  pub let mut _pppw_stage : u64 = 0

  pub let pppw_ok   : [u8; 16] = "PPGTT PROT OK\n\0"
  pub let pppw_fail : [u8; 18] = "PPGTT PROT FAIL\n\0"

  pub let mut _pppw_pgcount : u64 = 0

  pub let pppw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-004 (#1270): reset PPGTT prot counters + local scratch.",
      block: {
        call ppgtt_prot_reset;
        lea r10, [rip + _pppw_pgcount];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    }

  pub let ppgtt_prot_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M4-004 (#1270): boot witness. Stages: (1) validators. (2) compose RO/RW/RX. (3) extract round-trip. (4) MOCS bits. (5) range invalidate arithmetic.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _pppw_stage];
        mov [rcx], rax;

        call pppw_scrub;

        // -- 1. Validators.
        mov rdi, 2;
        call ppp_prot_valid;
        cmp rax, 1;
        jne pppw_fail_stage;
        mov rdi, 3;
        call ppp_prot_valid;
        cmp rax, 0;
        jne pppw_fail_stage;

        mov rdi, 0x1000;
        call ppp_frame_valid;
        cmp rax, 1;
        jne pppw_fail_stage;
        mov rdi, 0x1001;
        call ppp_frame_valid;
        cmp rax, 0;
        jne pppw_fail_stage;

        mov rdi, 3;
        call ppp_mocs_valid;
        cmp rax, 1;
        jne pppw_fail_stage;
        mov rdi, 8;
        call ppp_mocs_valid;
        cmp rax, 0;
        jne pppw_fail_stage;

        // -- 2. Compose RO / RW / RX.
        mov rax, 2;
        lea rcx, [rip + _pppw_stage];
        mov [rcx], rax;

        // RO: PRESENT | U | NX | frame.
        mov rdi, 0;                      // RO
        mov rsi, 0x2000;
        mov rdx, 0;                      // mocs=0
        call ppp_compose;
        // Expect: 0x2000 | 0x1 (P) | 0x4 (U) | 0x8000000000000000 (NX)
        mov r11, 0x8000000000002005;
        cmp rax, r11;
        jne pppw_fail_stage;

        // RW: PRESENT | U | RW | NX | frame.
        mov rdi, 1;                      // RW
        mov rsi, 0x2000;
        mov rdx, 0;
        call ppp_compose;
        mov r11, 0x8000000000002007;
        cmp rax, r11;
        jne pppw_fail_stage;

        // RX: PRESENT | U | frame (no RW, no NX).
        mov rdi, 2;                      // RX
        mov rsi, 0x2000;
        mov rdx, 0;
        call ppp_compose;
        mov r11, 0x2005;
        cmp rax, r11;
        jne pppw_fail_stage;

        // -- 3. Extract round-trip.
        mov rax, 3;
        lea rcx, [rip + _pppw_stage];
        mov [rcx], rax;

        // Compose RW then extract -> 1.
        mov rdi, 1;
        mov rsi, 0x2000;
        mov rdx, 0;
        call ppp_compose;
        mov rdi, rax;
        call ppp_extract_prot;
        cmp rax, 1;
        jne pppw_fail_stage;

        // Compose RX then extract -> 2.
        mov rdi, 2;
        mov rsi, 0x2000;
        mov rdx, 0;
        call ppp_compose;
        mov rdi, rax;
        call ppp_extract_prot;
        cmp rax, 2;
        jne pppw_fail_stage;

        // Compose RO then extract -> 0.
        mov rdi, 0;
        mov rsi, 0x2000;
        mov rdx, 0;
        call ppp_compose;
        mov rdi, rax;
        call ppp_extract_prot;
        cmp rax, 0;
        jne pppw_fail_stage;

        // Non-present PTE extract -> DECODE_BAD.
        mov rdi, 0;                      // no PRESENT bit
        call ppp_extract_prot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne pppw_fail_stage;

        // -- 4. MOCS bits: mocs=7 sets PWT (bit 3), PCD (bit 4), PAT (bit 9).
        mov rax, 4;
        lea rcx, [rip + _pppw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // RW
        mov rsi, 0x2000;
        mov rdx, 7;
        call ppp_compose;
        // Expect: 0x8000000000002007 | 0x8 | 0x10 | 0x200 = 0x800000000000221F
        // (bit-4 PCD | bit-3 PWT | bit-9 PAT, atop RW's low nibble 0x7).
        mov r11, 0x800000000000221F;
        cmp rax, r11;
        jne pppw_fail_stage;

        // -- 5. Range invalidate arithmetic.
        mov rax, 5;
        lea rcx, [rip + _pppw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0x5000;                 // 5 pages
        lea rdx, [rip + _pppw_pgcount];
        call ppp_range_invalidate;
        cmp rax, 0;
        jne pppw_fail_stage;

        lea r10, [rip + _pppw_pgcount];
        mov rax, [r10];
        cmp rax, 5;
        jne pppw_fail_stage;

        // Bad range: unaligned span refused.
        mov rdi, 0x1000;
        mov rsi, 0x5001;
        lea rdx, [rip + _pppw_pgcount];
        call ppp_range_invalidate;
        mov r11, 0xFFFFF5CB;
        cmp rax, r11;
        jne pppw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pppw_ok];
        call klog_s1;

        call pppw_scrub;
        xor rax, rax;
        jmp pppw_out;

      pppw_fail_stage:
        lea rax, [rip + _pppw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pppw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pppw_scrub;
        mov rax, 1;

      pppw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
