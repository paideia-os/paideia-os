// tests/kernel/drivers/gpu/ctx_priority_synth.pdx — R37.M5-004 (#1275)
//
// Boot witness for context priority + preemption points.
//
// Asserts priority / bucket / mode validators, byte->bucket mapping,
// pairwise priority compare, preempt-mode selection (non-preemptible
// wins, then bucket), and should_preempt bucket rule.
//
// Fingerprint: R37 GPU CTX PRIORITY OK

module CtxPrioritySynth = structure {

  pub let mut _ctxpriw_stage : u64 = 0

  pub let ctxpriw_ok   : [u8; 22] = "GPU CTX PRIORITY OK\0"
  pub let ctxpriw_fail : [u8; 24] = "GPU CTX PRIORITY FAIL\0"

  pub let ctxpriw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-004 (#1275): reset priority counters.",
      block: {
        call ctx_priority_reset;
        ret
      }
    }

  pub let ctx_priority_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M5-004 (#1275): boot witness. Stages: (1) validators. (2) byte->bucket mapping. (3) compare. (4) preempt_mode: NEVER on non_preemptible; HEAVY on URGENT; NORMAL on HIGH/NORMAL; MILD on IDLE. (5) should_preempt: bucket-strict rule.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ctxpriw_stage];
        mov [rcx], rax;

        call ctxpriw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call ctxpri_priority_valid;
        cmp rax, 1;
        jne ctxpriw_fail_stage;
        mov rdi, 0xFF;
        call ctxpri_priority_valid;
        cmp rax, 1;
        jne ctxpriw_fail_stage;
        mov rdi, 0x100;
        call ctxpri_priority_valid;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        mov rdi, 3;
        call ctxpri_bucket_valid;
        cmp rax, 1;
        jne ctxpriw_fail_stage;
        mov rdi, 4;
        call ctxpri_bucket_valid;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        mov rdi, 3;
        call ctxpri_mode_valid;
        cmp rax, 1;
        jne ctxpriw_fail_stage;
        mov rdi, 4;
        call ctxpri_mode_valid;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        // -- 2. Byte -> bucket.
        mov rax, 2;
        lea rcx, [rip + _ctxpriw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ctxpri_to_bucket;
        cmp rax, 0;                      // IDLE
        jne ctxpriw_fail_stage;

        mov rdi, 63;
        call ctxpri_to_bucket;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        mov rdi, 64;
        call ctxpri_to_bucket;
        cmp rax, 1;                      // NORMAL
        jne ctxpriw_fail_stage;

        mov rdi, 127;
        call ctxpri_to_bucket;
        cmp rax, 1;
        jne ctxpriw_fail_stage;

        mov rdi, 128;
        call ctxpri_to_bucket;
        cmp rax, 2;                      // HIGH
        jne ctxpriw_fail_stage;

        mov rdi, 191;
        call ctxpri_to_bucket;
        cmp rax, 2;
        jne ctxpriw_fail_stage;

        mov rdi, 192;
        call ctxpri_to_bucket;
        cmp rax, 3;                      // URGENT
        jne ctxpriw_fail_stage;

        mov rdi, 255;
        call ctxpri_to_bucket;
        cmp rax, 3;
        jne ctxpriw_fail_stage;

        // -- 3. Compare.
        mov rax, 3;
        lea rcx, [rip + _ctxpriw_stage];
        mov [rcx], rax;

        mov rdi, 200;
        mov rsi, 100;
        call ctxpri_compare;
        cmp rax, 2;                      // GT
        jne ctxpriw_fail_stage;

        mov rdi, 100;
        mov rsi, 200;
        call ctxpri_compare;
        cmp rax, 0;                      // LT
        jne ctxpriw_fail_stage;

        mov rdi, 100;
        mov rsi, 100;
        call ctxpri_compare;
        cmp rax, 1;                      // EQ
        jne ctxpriw_fail_stage;

        mov rdi, 0x100;
        mov rsi, 100;
        call ctxpri_compare;
        mov r11, 0xFFFFF57F;             // BAD_PRIORITY
        cmp rax, r11;
        jne ctxpriw_fail_stage;

        // -- 4. preempt_mode.
        mov rax, 4;
        lea rcx, [rip + _ctxpriw_stage];
        mov [rcx], rax;

        // non_preemptible=1 -> NEVER regardless of priority.
        mov rdi, 200;
        mov rsi, 1;
        call ctxpri_preempt_mode;
        cmp rax, 0;                      // NEVER
        jne ctxpriw_fail_stage;

        // URGENT -> HEAVY
        mov rdi, 200;
        mov rsi, 0;
        call ctxpri_preempt_mode;
        cmp rax, 3;                      // HEAVY
        jne ctxpriw_fail_stage;

        // HIGH -> NORMAL
        mov rdi, 150;
        mov rsi, 0;
        call ctxpri_preempt_mode;
        cmp rax, 2;                      // NORMAL
        jne ctxpriw_fail_stage;

        // NORMAL -> NORMAL
        mov rdi, 100;
        mov rsi, 0;
        call ctxpri_preempt_mode;
        cmp rax, 2;
        jne ctxpriw_fail_stage;

        // IDLE -> MILD
        mov rdi, 30;
        mov rsi, 0;
        call ctxpri_preempt_mode;
        cmp rax, 1;                      // MILD
        jne ctxpriw_fail_stage;

        // bad priority
        mov rdi, 0x100;
        mov rsi, 0;
        call ctxpri_preempt_mode;
        mov r11, 0xFFFFF57F;
        cmp rax, r11;
        jne ctxpriw_fail_stage;

        // -- 5. should_preempt: bucket-strict rule.
        mov rax, 5;
        lea rcx, [rip + _ctxpriw_stage];
        mov [rcx], rax;

        // inflight=NORMAL(100), new=URGENT(200) -> preempt
        mov rdi, 100;
        mov rsi, 200;
        call ctxpri_should_preempt;
        cmp rax, 1;
        jne ctxpriw_fail_stage;

        // inflight=URGENT(200), new=NORMAL(100) -> NO preempt
        mov rdi, 200;
        mov rsi, 100;
        call ctxpri_should_preempt;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        // Same bucket, different byte: no preempt.
        mov rdi, 100;                    // NORMAL
        mov rsi, 127;                    // NORMAL
        call ctxpri_should_preempt;
        cmp rax, 0;
        jne ctxpriw_fail_stage;

        // Bad priority.
        mov rdi, 100;
        mov rsi, 0x100;
        call ctxpri_should_preempt;
        mov r11, 0xFFFFF57F;
        cmp rax, r11;
        jne ctxpriw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ctxpriw_ok];
        call klog_s1;

        call ctxpriw_scrub;
        xor rax, rax;
        jmp ctxpriw_out;

      ctxpriw_fail_stage:
        lea rax, [rip + _ctxpriw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ctxpriw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ctxpriw_scrub;
        mov rax, 1;

      ctxpriw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
