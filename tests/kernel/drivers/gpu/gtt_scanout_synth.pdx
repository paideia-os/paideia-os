// tests/kernel/drivers/gpu/gtt_scanout_synth.pdx — R37.M4-005 (#1271)
//
// Boot witness for the GTT scan-out bookkeeping module.
//
// Asserts index / frame validators, PTE composer, map happy path,
// duplicate-index refusal, unmap round-trip, and ENOSPC at 8 slots.
//
// Fingerprint: R37 GTT SCANOUT OK

module GttScanoutSynth = structure {

  pub let mut _gttsw_stage : u64 = 0

  pub let gttsw_ok   : [u8; 20] = "R37 GTT SCANOUT OK\n\0"
  pub let gttsw_fail : [u8; 22] = "R37 GTT SCANOUT FAIL\n\0"

  pub let gttsw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-005 (#1271): reset GTT scan-out table + counters.",
      block: {
        call gtt_scanout_reset;
        ret
      }
    }

  pub let gtt_scanout_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M4-005 (#1271): boot witness. Stages: (1) validators. (2) PTE composer. (3) map happy path. (4) INDEX_IN_USE refusal. (5) unmap round-trip. (6) ENOSPC at 8 slots.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        call gttsw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call gtts_index_valid;
        cmp rax, 1;
        jne gttsw_fail_stage;
        mov r10, 0x100000;
        mov rdi, r10;
        call gtts_index_valid;
        cmp rax, 0;
        jne gttsw_fail_stage;

        mov rdi, 0x1000;
        call gtts_frame_valid;
        cmp rax, 1;
        jne gttsw_fail_stage;
        mov rdi, 0x1001;
        call gtts_frame_valid;
        cmp rax, 0;
        jne gttsw_fail_stage;

        // -- 2. PTE composer.
        mov rax, 2;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        mov rdi, 0x2000;
        call gtts_pte_compose;
        // Expect: 0x2000 | 0x1 = 0x2001.
        mov r11, 0x2001;
        cmp rax, r11;
        jne gttsw_fail_stage;

        // Bad frame refused.
        mov rdi, 0x2001;
        call gtts_pte_compose;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne gttsw_fail_stage;

        // -- 3. Map happy path.
        mov rax, 3;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        mov rdi, 5;                      // bo_row_id
        mov rsi, 0x100;                  // gtt_index
        mov rdx, 0x8000;                 // frame_pa
        call gtts_map_inner;
        cmp rax, 0;
        jne gttsw_fail_stage;

        mov rdi, 0;
        call gtts_mapping_valid;
        cmp rax, 1;
        jne gttsw_fail_stage;
        mov rdi, 0;
        call gtts_mapping_bo;
        cmp rax, 5;
        jne gttsw_fail_stage;
        mov rdi, 0;
        call gtts_mapping_index;
        mov r11, 0x100;
        cmp rax, r11;
        jne gttsw_fail_stage;
        mov rdi, 0;
        call gtts_mapping_frame;
        mov r11, 0x8000;
        cmp rax, r11;
        jne gttsw_fail_stage;

        // -- 4. INDEX_IN_USE.
        mov rax, 4;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        mov rdi, 6;
        mov rsi, 0x100;                  // same index
        mov rdx, 0x9000;
        call gtts_map_inner;
        mov r11, 0xFFFFF5BA;             // INDEX_IN_USE
        cmp rax, r11;
        jne gttsw_fail_stage;

        // -- 5. Unmap round-trip.
        mov rax, 5;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gtts_unmap_inner;
        cmp rax, 0;
        jne gttsw_fail_stage;

        mov rdi, 0;
        call gtts_mapping_valid;
        cmp rax, 0;
        jne gttsw_fail_stage;

        // Re-map same index -- should succeed.
        mov rdi, 6;
        mov rsi, 0x100;
        mov rdx, 0x9000;
        call gtts_map_inner;
        cmp rax, 0;
        jne gttsw_fail_stage;

        // Double unmap refused.
        mov rdi, 0;
        call gtts_unmap_inner;
        cmp rax, 0;
        jne gttsw_fail_stage;
        mov rdi, 0;
        call gtts_unmap_inner;
        mov r11, 0xFFFFF5B8;             // UNMAP_ALREADY
        cmp rax, r11;
        jne gttsw_fail_stage;

        // -- 6. ENOSPC at 8 slots.
        mov rax, 6;
        lea rcx, [rip + _gttsw_stage];
        mov [rcx], rax;

        call gttsw_scrub;

        xor rbx, rbx;
        mov r12, 0x200;
      gttsw_fill:
        cmp rbx, 8;
        jae gttsw_fill_done;
        mov rdi, 5;
        mov rsi, r12;
        mov rdx, 0x8000;
        call gtts_map_inner;
        mov r11, 0xFFFFF5BB;
        cmp rax, r11;
        je  gttsw_fail_stage;
        add r12, 1;
        add rbx, 1;
        jmp gttsw_fill;
      gttsw_fill_done:

        mov rdi, 5;
        mov rsi, r12;
        mov rdx, 0x8000;
        call gtts_map_inner;
        mov r11, 0xFFFFF5BB;             // ENOSPC
        cmp rax, r11;
        jne gttsw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gttsw_ok];
        call klog_s1;

        call gttsw_scrub;
        xor rax, rax;
        jmp gttsw_out;

      gttsw_fail_stage:
        lea rax, [rip + _gttsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gttsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gttsw_scrub;
        mov rax, 1;

      gttsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
