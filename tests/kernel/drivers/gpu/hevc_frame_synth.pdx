// tests/kernel/drivers/gpu/hevc_frame_synth.pdx — R37.M8-003 (#1287)
//
// Boot witness for the HEVC frame plumbing scaffold.  Asserts:
//   * NULL_DESC refusal.
//   * BAD_DESC_SIZE refusal.
//   * BAD_NAL refusal (nal_type > 63).
//   * BAD_TEMPORAL_ID refusal (t_id_plus1 outside [1, 7]).
//   * BAD_SLICE_TYPE refusal (slice_type > 2).
//   * BAD_PPS_ID refusal (pps_id > 63).
//   * happy admit round-trip -- ring records frame_number,
//     admitted counter increments, hevc_frame_last returns it.
//   * ring wrap discipline (17 admits with an unchanged head-mod
//     invariant).
//   * hevc_frame_decode ALWAYS returns HEVC_DEFERRED (framework
//     seam) and bumps the DEFERRED counter.
//   * arbitration honesty pin.
//
// Fingerprint: R37 HEVC FRAME OK

module HevcFrameSynth = structure {

  pub let mut _hevcw_stage : u64 = 0

  pub let hevcw_ok   : [u8; 18] = "R37 HEVC FRAME OK\n\0"
  pub let hevcw_fail : [u8; 20] = "R37 HEVC FRAME FAIL\n\0"

  // A well-formed descriptor (32 bytes; only 0x10 required).
  //   [+0x00] nal_unit_type = 1 (TRAIL_R)
  //   [+0x01] temporal_id_plus1 = 1
  //   [+0x02] pps_id = 0
  //   [+0x03] dep_slice_seg = 0
  //   [+0x04] slice_type = 2 (I)
  //   [+0x05..0x08] reserved
  //   [+0x08] slice_seg_addr = 0
  //   [+0x0C] frame_number = 42
  //   [+0x10] descriptor_size = 0x20
  pub let mut _hevcw_desc_ok      : [u64; 4] = uninit @align(64)
  pub let mut _hevcw_desc_bad_sz  : [u64; 4] = uninit @align(64)
  pub let mut _hevcw_desc_bad_nal : [u64; 4] = uninit @align(64)
  pub let mut _hevcw_desc_bad_tid : [u64; 4] = uninit @align(64)
  pub let mut _hevcw_desc_bad_st  : [u64; 4] = uninit @align(64)
  pub let mut _hevcw_desc_bad_pps : [u64; 4] = uninit @align(64)

  pub let hevc_frame_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M8-003 (#1287): boot witness. Stages: (1) reset + descriptor prep. (2) NULL_DESC. (3) BAD_DESC_SIZE. (4) BAD_NAL. (5) BAD_TEMPORAL_ID. (6) BAD_SLICE_TYPE. (7) BAD_PPS_ID. (8) happy admit round-trip. (9) 17-admit wrap discipline. (10) hevc_frame_decode returns DEFERRED. (11) counter fanout + arbitration pin.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        call hevc_frame_reset;

        // -- Prep the six descriptors.  Each is 32 bytes = [u64; 4].
        // desc_ok: nal=1, tid+1=1, pps=0, slice_type=2, frame=42,
        //          desc_size=0x20.  Layout:
        //  [0]: byte 0 nal=1, byte 1 tid+1=1, byte 2 pps=0, byte 3 dep=0,
        //       byte 4 slice=2, bytes 5..7 reserved -> LE u64 =
        //       0x0000000200000101.
        //  [1]: bytes 8..15 = slice_seg_addr (u32) + frame_number (u32) =
        //       (42u32 << 32) | 0 = 0x0000002A00000000.
        //  [2]: bytes 16..23 = desc_size (u32=0x20) + reserved (u32=0) ->
        //       LE u64 = 0x0000000000000020.
        //  [3]: 0.
        lea r10, [rip + _hevcw_desc_ok];
        mov rax, 0x0000000200000101;
        mov [r10 + 0], rax;
        mov rax, 0x0000002A00000000;
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000020;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // desc_bad_sz: desc_size = 0x08 (< HEVC_DESC_MIN_SIZE 0x10).
        lea r10, [rip + _hevcw_desc_bad_sz];
        mov rax, 0x0000000200000101;
        mov [r10 + 0], rax;
        mov rax, 0x0000000100000000;      // frame_number = 1
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000008;      // desc_size = 8 (too small)
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // desc_bad_nal: nal_type = 100 (> 63).
        lea r10, [rip + _hevcw_desc_bad_nal];
        mov rax, 0x0000000200000164;      // byte 0 = 0x64 = 100
        mov [r10 + 0], rax;
        mov rax, 0x0000000200000000;
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000020;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // desc_bad_tid: tid_plus1 = 8 (> 7).
        lea r10, [rip + _hevcw_desc_bad_tid];
        mov rax, 0x0000000200000801;      // byte 1 = 0x08 = 8
        mov [r10 + 0], rax;
        mov rax, 0x0000000300000000;
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000020;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // desc_bad_st: slice_type = 3 (> 2).
        lea r10, [rip + _hevcw_desc_bad_st];
        mov rax, 0x0000000300000101;      // byte 4 = 0x03 = 3
        mov [r10 + 0], rax;
        mov rax, 0x0000000400000000;
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000020;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // desc_bad_pps: pps_id = 64 (> 63).
        lea r10, [rip + _hevcw_desc_bad_pps];
        mov rax, 0x0000000200400101;      // byte 2 = 0x40 = 64
        mov [r10 + 0], rax;
        mov rax, 0x0000000500000000;
        mov [r10 + 8], rax;
        mov rax, 0x0000000000000020;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        // -- 2. NULL_DESC.
        mov rax, 2;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call hevc_frame_admit;
        mov r11, 0xFFFFF50E;             // NULL_DESC
        cmp rax, r11;
        jne hevcw_fail_stage;

        // -- 3. BAD_DESC_SIZE.
        mov rax, 3;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_bad_sz];
        call hevc_frame_admit;
        mov r11, 0xFFFFF50D;             // BAD_DESC_SIZE
        cmp rax, r11;
        jne hevcw_fail_stage;

        // -- 4. BAD_NAL.
        mov rax, 4;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_bad_nal];
        call hevc_frame_admit;
        mov r11, 0xFFFFF50C;             // BAD_NAL
        cmp rax, r11;
        jne hevcw_fail_stage;

        // Validator agreement.
        mov rdi, 100;
        call hevc_nal_valid;
        cmp rax, 0;
        jne hevcw_fail_stage;
        mov rdi, 21;
        call hevc_nal_valid;
        cmp rax, 1;
        jne hevcw_fail_stage;

        // -- 5. BAD_TEMPORAL_ID.
        mov rax, 5;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_bad_tid];
        call hevc_frame_admit;
        mov r11, 0xFFFFF50B;             // BAD_TEMPORAL_ID
        cmp rax, r11;
        jne hevcw_fail_stage;

        mov rdi, 8;
        call hevc_temporal_id_valid;
        cmp rax, 0;
        jne hevcw_fail_stage;
        mov rdi, 0;
        call hevc_temporal_id_valid;
        cmp rax, 0;
        jne hevcw_fail_stage;
        mov rdi, 4;
        call hevc_temporal_id_valid;
        cmp rax, 1;
        jne hevcw_fail_stage;

        // -- 6. BAD_SLICE_TYPE.
        mov rax, 6;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_bad_st];
        call hevc_frame_admit;
        mov r11, 0xFFFFF50A;             // BAD_SLICE_TYPE
        cmp rax, r11;
        jne hevcw_fail_stage;

        mov rdi, 3;
        call hevc_slice_type_valid;
        cmp rax, 0;
        jne hevcw_fail_stage;
        mov rdi, 2;
        call hevc_slice_type_valid;
        cmp rax, 1;
        jne hevcw_fail_stage;

        // -- 7. BAD_PPS_ID.
        mov rax, 7;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_bad_pps];
        call hevc_frame_admit;
        mov r11, 0xFFFFF509;             // BAD_PPS_ID
        cmp rax, r11;
        jne hevcw_fail_stage;

        // -- 8. Happy admit.
        mov rax, 8;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_ok];
        call hevc_frame_admit;
        cmp rax, 0;
        jne hevcw_fail_stage;

        call hevc_frames_admitted;
        cmp rax, 1;
        jne hevcw_fail_stage;

        call hevc_frame_last;
        cmp rax, 42;
        jne hevcw_fail_stage;

        // -- 9. Ring wrap.  Admit HEVC_RING_SIZE (16) more times so
        //       total = 17.  hevc_frames_admitted must be 17;
        //       hevc_frame_last must return the last admitted
        //       frame_number (42, since desc_ok's frame_number
        //       does not change across admits).
        mov rax, 9;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        xor rbx, rbx;
      hevcw_wrap:
        cmp rbx, 16;
        jae hevcw_wrap_done;
        lea rdi, [rip + _hevcw_desc_ok];
        call hevc_frame_admit;
        cmp rax, 0;
        jne hevcw_fail_stage;
        add rbx, 1;
        jmp hevcw_wrap;
      hevcw_wrap_done:

        call hevc_frames_admitted;
        cmp rax, 17;
        jne hevcw_fail_stage;

        call hevc_frame_last;
        cmp rax, 42;
        jne hevcw_fail_stage;

        // -- 10. hevc_frame_decode always DEFERRED.
        mov rax, 10;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hevcw_desc_ok];
        call hevc_frame_decode;
        mov r11, 0xFFFFF508;             // DEFERRED
        cmp rax, r11;
        jne hevcw_fail_stage;

        // Second call also DEFERRED (idempotent).
        lea rdi, [rip + _hevcw_desc_ok];
        call hevc_frame_decode;
        mov r11, 0xFFFFF508;
        cmp rax, r11;
        jne hevcw_fail_stage;

        // -- 11. Counter fanout + arbitration pin.
        mov rax, 11;
        lea rcx, [rip + _hevcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ADMITS
        call hevc_stat;
        cmp rax, 17;
        jne hevcw_fail_stage;
        mov rdi, 1;                      // REFUSED
        call hevc_stat;
        // 6 refusals: NULL, BAD_SIZE, BAD_NAL, BAD_TEMPORAL,
        // BAD_SLICE_TYPE, BAD_PPS_ID.
        cmp rax, 6;
        jne hevcw_fail_stage;
        mov rdi, 2;                      // DEFERRED
        call hevc_stat;
        cmp rax, 2;
        jne hevcw_fail_stage;

        call hevc_arbitrated;
        cmp rax, 0;
        jne hevcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hevcw_ok];
        call klog_s1;

        call hevc_frame_reset;
        xor rax, rax;
        jmp hevcw_out;

      hevcw_fail_stage:
        lea rax, [rip + _hevcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hevcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hevc_frame_reset;
        mov rax, 1;

      hevcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
