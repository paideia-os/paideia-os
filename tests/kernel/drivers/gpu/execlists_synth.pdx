// tests/kernel/drivers/gpu/execlists_synth.pdx — R37.M5-003 (#1274)
//
// Boot witness for the execlists submission path (fallback when GuC
// is unavailable).
//
// Asserts engine validator, engine init, descriptor pack, submit
// happy path (ELEMENT0 then ELEMENT1), SATURATED at 3rd submit,
// completion round-trip, and stray-completion IDLE refuse.
//
// Fingerprint: R37 GPU EXECLISTS OK

module ExeclistsSynth = structure {

  pub let mut _exlw_stage : u64 = 0

  pub let exlw_ok   : [u8; 19] = "GPU EXECLISTS OK\0"
  pub let exlw_fail : [u8; 21] = "GPU EXECLISTS FAIL\0"

  pub let exlw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-003 (#1274): reset execlists engines + counters.",
      block: {
        call execlists_reset;
        ret
      }
    }

  pub let execlists_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M5-003 (#1274): boot witness. Stages: (1) engine validator. (2) NOT_READY before init. (3) engine init + descriptor pack. (4) submit ELEMENT0. (5) submit ELEMENT1. (6) SATURATED at third submit. (7) completion round-trip. (8) stray-completion IDLE refuse.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        call exlw_scrub;

        // -- 1. Validator.
        mov rdi, 0;
        call exl_engine_valid;
        cmp rax, 1;
        jne exlw_fail_stage;
        mov rdi, 3;
        call exl_engine_valid;
        cmp rax, 0;
        jne exlw_fail_stage;

        // -- 2. Submit before init -> NOT_READY.
        mov rax, 2;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        // Craft a valid descriptor first (pack).
        mov rdi, 0x100000;
        mov rsi, 0;
        mov rdx, 1;
        call exl_descriptor_pack;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r11;
        je  exlw_fail_stage;

        mov rdi, 0;
        mov rsi, r15;
        call exl_submit;
        mov r11, 0xFFFFF589;             // NOT_READY
        cmp rax, r11;
        jne exlw_fail_stage;

        // -- 3. Engine init + descriptor pack refuse cases.
        mov rax, 3;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call exl_engine_init;
        cmp rax, 0;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_ready;
        cmp rax, 1;
        jne exlw_fail_stage;

        // bad descriptor: unaligned lrc_pa
        mov rdi, 0x100001;
        mov rsi, 0;
        mov rdx, 1;
        call exl_descriptor_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne exlw_fail_stage;

        // bad descriptor: engine=3
        mov rdi, 0x100000;
        mov rsi, 3;
        mov rdx, 1;
        call exl_descriptor_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne exlw_fail_stage;

        // bad descriptor: ctx > 0xF
        mov rdi, 0x100000;
        mov rsi, 0;
        mov rdx, 0x10;
        call exl_descriptor_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne exlw_fail_stage;

        // -- 4. Submit ELEMENT0 (slot returned = 0).
        mov rax, 4;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, r15;                    // descriptor pinned earlier
        call exl_submit;
        cmp rax, 0;                      // slot 0
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_busy;
        cmp rax, 1;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_inflight;
        cmp rax, 1;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_last_lo;
        cmp rax, r15;
        jne exlw_fail_stage;

        // -- 5. Submit ELEMENT1 (slot returned = 1).
        mov rax, 5;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        mov rdi, 0x200000;
        mov rsi, 0;
        mov rdx, 2;
        call exl_descriptor_pack;
        mov r14, rax;

        mov rdi, 0;
        mov rsi, r14;
        call exl_submit;
        cmp rax, 1;                      // slot 1
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_inflight;
        cmp rax, 2;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_last_hi;
        cmp rax, r14;
        jne exlw_fail_stage;

        // -- 6. SATURATED at third submit.
        mov rax, 6;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        mov rdi, 0x300000;
        mov rsi, 0;
        mov rdx, 3;
        call exl_descriptor_pack;
        mov r13, rax;

        mov rdi, 0;
        mov rsi, r13;
        call exl_submit;
        mov r11, 0xFFFFF58C;             // SATURATED
        cmp rax, r11;
        jne exlw_fail_stage;

        // -- 7. Completion round-trip.
        mov rax, 7;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call exl_note_completion;
        cmp rax, 0;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_inflight;
        cmp rax, 1;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_busy;
        cmp rax, 1;                      // still busy (1 in flight)
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_note_completion;
        cmp rax, 0;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_inflight;
        cmp rax, 0;
        jne exlw_fail_stage;

        mov rdi, 0;
        call exl_engine_busy;
        cmp rax, 0;                      // idle
        jne exlw_fail_stage;

        // Now can submit again (was saturated before, now capacity).
        mov rdi, 0;
        mov rsi, r13;
        call exl_submit;
        cmp rax, 0;                      // slot 0
        jne exlw_fail_stage;

        // -- 8. Stray completion -> IDLE.
        mov rax, 8;
        lea rcx, [rip + _exlw_stage];
        mov [rcx], rax;

        // Consume the single in-flight submission.
        mov rdi, 0;
        call exl_note_completion;
        cmp rax, 0;
        jne exlw_fail_stage;

        // Now another completion is stray.
        mov rdi, 0;
        call exl_note_completion;
        mov r11, 0xFFFFF58B;             // IDLE
        cmp rax, r11;
        jne exlw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + exlw_ok];
        call klog_s1;

        call exlw_scrub;
        xor rax, rax;
        jmp exlw_out;

      exlw_fail_stage:
        lea rax, [rip + _exlw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + exlw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call exlw_scrub;
        mov rax, 1;

      exlw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
