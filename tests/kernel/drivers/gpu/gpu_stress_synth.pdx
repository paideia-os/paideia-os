// tests/kernel/drivers/gpu/gpu_stress_synth.pdx — R37.M8-004 (#1288)
//
// Boot witness for the GPU submission stress rig.  Runs 100 000
// no-op batch cycles (alloc + begin + noop + end + builder_end +
// free) and asserts:
//   * stress_run returns STRESS_OK
//   * stress_last_delta returns 0 (no VRAM/BO leak)
//   * stress_last_iters_run == 100_000
//   * stress_last_error == STRESS_OK
//   * PASSES counter bumped exactly once
//   * FAILS counter zero
//   * a caller-side bug refusal (iters == 0 -> BAD_ARG) reports the
//     right code without perturbing counters
//   * arbitration honesty pin returns 0
//
// Fingerprint: R37 GPU STRESS OK
//
// Cross-file scrub: on entry the witness scrubs the batch builder,
// the BO allocator, gpu_stress's own tables, and gmmio.  On exit
// the same scrub runs before the fingerprint is emitted so the
// next witness inherits an empty state.

module GpuStressSynth = structure {

  pub let mut _stressw_stage : u64 = 0

  pub let stressw_ok   : [u8; 15] = "GPU STRESS OK\n\0"
  pub let stressw_fail : [u8; 17] = "GPU STRESS FAIL\n\0"

  pub let gpu_stress_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M8-004 (#1288): boot witness. Stages: (1) scrub all four modules touched by the rig. (2) bad-arg refusal (iters == 0). (3) run 100 000 iters. (4) delta == 0, iters_run == 100_000, last_error == STRESS_OK. (5) counter fanout. (6) second run of 1 iter: leak-free, delta still 0. (7) arbitration pin.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        call gpu_stress_reset;
        call bo_alloc_reset;
        call batch_builder_reset;
        call gmmio_reset;

        // -- 2. BAD_ARG on iters == 0.
        mov rax, 2;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call stress_run;
        mov r11, 0xFFFFF4FF;             // BAD_ARG
        cmp rax, r11;
        jne stressw_fail_stage;

        // -- 3. Run 100 000 iters.
        mov rax, 3;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        mov rdi, 100000;
        call stress_run;
        cmp rax, 0;
        jne stressw_fail_stage;

        // -- 4. Bookkeeping.
        mov rax, 4;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        call stress_last_iters_run;
        mov r11, 100000;
        cmp rax, r11;
        jne stressw_fail_stage;

        call stress_last_delta;
        cmp rax, 0;
        jne stressw_fail_stage;

        call stress_last_error;
        cmp rax, 0;
        jne stressw_fail_stage;

        call stress_last_first_fail;
        cmp rax, 0;
        jne stressw_fail_stage;

        // -- 5. Counter fanout.
        mov rax, 5;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // RUNS
        call stress_stat;
        cmp rax, 1;
        jne stressw_fail_stage;

        mov rdi, 1;                      // PASSES
        call stress_stat;
        cmp rax, 1;
        jne stressw_fail_stage;

        mov rdi, 2;                      // FAILS
        call stress_stat;
        cmp rax, 0;
        jne stressw_fail_stage;

        // BO allocator: 100 000 allocs, 100 000 frees.
        mov rdi, 0;                      // BOA_ST_ALLOCS
        call boa_stat;
        mov r11, 100000;
        cmp rax, r11;
        jne stressw_fail_stage;

        mov rdi, 1;                      // BOA_ST_FREES
        call boa_stat;
        mov r11, 100000;
        cmp rax, r11;
        jne stressw_fail_stage;

        // Batch builder: 100 000 begins, 100 000 ends, 200 000
        // appends (MI_NOOP + MI_BATCH_BUFFER_END per iter).
        mov rdi, 0;                      // BAT_ST_BEGINS
        call bat_stat;
        mov r11, 100000;
        cmp rax, r11;
        jne stressw_fail_stage;

        mov rdi, 1;                      // BAT_ST_ENDS
        call bat_stat;
        mov r11, 100000;
        cmp rax, r11;
        jne stressw_fail_stage;

        mov rdi, 2;                      // BAT_ST_APPENDS
        call bat_stat;
        mov r11, 200000;
        cmp rax, r11;
        jne stressw_fail_stage;

        // -- 6. Second run of 1 iter: still leak-free.
        mov rax, 6;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call stress_run;
        cmp rax, 0;
        jne stressw_fail_stage;

        call stress_last_delta;
        cmp rax, 0;
        jne stressw_fail_stage;

        call stress_last_iters_run;
        cmp rax, 1;
        jne stressw_fail_stage;

        // RUNS -> 2, PASSES -> 2.
        mov rdi, 0;
        call stress_stat;
        cmp rax, 2;
        jne stressw_fail_stage;
        mov rdi, 1;
        call stress_stat;
        cmp rax, 2;
        jne stressw_fail_stage;

        // -- 7. Arbitration pin.
        mov rax, 7;
        lea rcx, [rip + _stressw_stage];
        mov [rcx], rax;

        call stress_arbitrated;
        cmp rax, 0;
        jne stressw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + stressw_ok];
        call klog_s1;

        call gpu_stress_reset;
        call bo_alloc_reset;
        call batch_builder_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp stressw_out;

      stressw_fail_stage:
        lea rax, [rip + _stressw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + stressw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gpu_stress_reset;
        call bo_alloc_reset;
        call batch_builder_reset;
        call gmmio_reset;
        mov rax, 1;

      stressw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
