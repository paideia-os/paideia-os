// tests/kernel/drivers/gpu/batch_builder_synth.pdx — R37.M6-003 (#1279)
//
// Boot witness for the batch buffer builder.
//
// Asserts begin/end lifecycle, single-session busy trip, cursor
// advancement per emit, bounds check on overflow, PIPE_CONTROL flag
// validation, and every opcode round-trips to the expected bytes at
// the expected offsets in the synthetic backing.
//
// Fingerprint: R37 GPU BATCH BUILDER OK

module BatchBuilderSynth = structure {

  pub let mut _batw_stage : u64 = 0

  pub let batw_ok   : [u8; 21] = "GPU BATCH BUILDER OK\0"
  pub let batw_fail : [u8; 23] = "GPU BATCH BUILDER FAIL\0"

  // 256-byte synthetic backing (as [u64; 32]).
  pub let mut _batw_backing : [u64; 32] = uninit @align(64)

  pub let batw_scrub_backing : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-003 (#1279): zero the synthetic batch backing.",
      block: {
        lea r10, [rip + _batw_backing];
        xor rax, rax;
        xor rcx, rcx;
      batw_sb_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  batw_sb_loop;
        ret
      }
    }

  pub let batw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-003 (#1279): reset builder state and backing.",
      block: {
        call batch_builder_reset;
        call batw_scrub_backing;
        ret
      }
    }

  pub let batch_builder_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M6-003 (#1279): boot witness. Stages: (1) initial idle; emit on idle refused. (2) begin/end lifecycle. (3) BUSY (second begin). (4) BAD_ARG (zero backing / small capacity). (5) MI_NOOP bytes / cursor. (6) MI_STORE_DWORD_IMM bytes / cursor. (7) MI_BATCH_BUFFER_START bytes / cursor. (8) MI_BATCH_BUFFER_END bytes / cursor. (9) PIPE_CONTROL bytes + BAD_FLAGS refuse. (10) OVERFLOW trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        call batw_scrub;

        // -- 1. Idle initially; emit refused.
        call bat_active;
        cmp rax, 0;
        jne batw_fail_stage;

        call bat_emit_noop;
        mov r11, 0xFFFFF54D;             // IDLE
        cmp rax, r11;
        jne batw_fail_stage;

        // -- 2. Begin then end lifecycle.
        mov rax, 2;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _batw_backing];
        mov rsi, 256;
        call batch_builder_begin;
        cmp rax, 0;
        jne batw_fail_stage;

        call bat_active;
        cmp rax, 1;
        jne batw_fail_stage;

        call bat_capacity;
        cmp rax, 256;
        jne batw_fail_stage;

        call bat_cursor;
        cmp rax, 0;
        jne batw_fail_stage;

        call batch_builder_end;
        cmp rax, 0;                      // final cursor
        jne batw_fail_stage;

        call bat_active;
        cmp rax, 0;
        jne batw_fail_stage;

        // -- 3. BUSY: second begin without end.
        mov rax, 3;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _batw_backing];
        mov rsi, 256;
        call batch_builder_begin;
        cmp rax, 0;
        jne batw_fail_stage;

        lea rdi, [rip + _batw_backing];
        mov rsi, 256;
        call batch_builder_begin;
        mov r11, 0xFFFFF54E;             // BUSY
        cmp rax, r11;
        jne batw_fail_stage;

        // Reset for next stage.
        call batch_builder_end;

        // -- 4. BAD_ARG.
        mov rax, 4;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // backing == 0
        mov rsi, 256;
        call batch_builder_begin;
        mov r11, 0xFFFFF54F;             // BAD_ARG
        cmp rax, r11;
        jne batw_fail_stage;

        lea rdi, [rip + _batw_backing];
        mov rsi, 3;                      // capacity < 4
        call batch_builder_begin;
        mov r11, 0xFFFFF54F;
        cmp rax, r11;
        jne batw_fail_stage;

        lea rdi, [rip + _batw_backing];
        mov rsi, 6;                      // capacity not multiple of 4
        call batch_builder_begin;
        mov r11, 0xFFFFF54F;
        cmp rax, r11;
        jne batw_fail_stage;

        // -- 5. MI_NOOP.
        mov rax, 5;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        call batw_scrub;
        lea rdi, [rip + _batw_backing];
        mov rsi, 256;
        call batch_builder_begin;
        cmp rax, 0;
        jne batw_fail_stage;

        call bat_emit_noop;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_cursor;
        cmp rax, 4;
        jne batw_fail_stage;
        // Backing[0..4] should be MI_NOOP = 0.
        lea r10, [rip + _batw_backing];
        mov eax, [r10 + 0];
        cmp rax, 0x00000000;
        jne batw_fail_stage;

        // -- 6. MI_STORE_DWORD_IMM (four dwords, cursor bumps by 16).
        mov rax, 6;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        mov rdi, 0x11223344AABBCCDD;
        mov rsi, 0xDEADBEEF;
        call bat_emit_store_dword_imm;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_cursor;
        cmp rax, 20;                     // 4 + 16
        jne batw_fail_stage;

        // Header at offset 4.
        lea r10, [rip + _batw_backing];
        mov eax, [r10 + 4];
        mov r11, 0x20000000;
        cmp rax, r11;
        jne batw_fail_stage;
        // addr_lo at offset 8 = 0xAABBCCDD
        mov eax, [r10 + 8];
        mov r11, 0xAABBCCDD;
        cmp rax, r11;
        jne batw_fail_stage;
        // addr_hi at offset 12 = 0x11223344
        mov eax, [r10 + 12];
        mov r11, 0x11223344;
        cmp rax, r11;
        jne batw_fail_stage;
        // value at offset 16 = 0xDEADBEEF
        mov eax, [r10 + 16];
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne batw_fail_stage;

        // -- 7. MI_BATCH_BUFFER_START (three dwords, cursor bumps by 12).
        mov rax, 7;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        mov rdi, 0x00000001CAFED00D;
        call bat_emit_batch_start;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_cursor;
        cmp rax, 32;                     // 20 + 12
        jne batw_fail_stage;

        lea r10, [rip + _batw_backing];
        mov eax, [r10 + 20];
        mov r11, 0x31800001;
        cmp rax, r11;
        jne batw_fail_stage;
        mov eax, [r10 + 24];
        mov r11, 0xCAFED00D;
        cmp rax, r11;
        jne batw_fail_stage;
        mov eax, [r10 + 28];
        cmp rax, 1;
        jne batw_fail_stage;

        // -- 8. MI_BATCH_BUFFER_END.
        mov rax, 8;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        call bat_emit_batch_end;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_cursor;
        cmp rax, 36;
        jne batw_fail_stage;

        lea r10, [rip + _batw_backing];
        mov eax, [r10 + 32];
        mov r11, 0x05000000;
        cmp rax, r11;
        jne batw_fail_stage;

        // -- 9. PIPE_CONTROL: bad flags refuse, then good flags.
        mov rax, 9;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        // Bad flag: bit outside 0x0FFFF000.
        mov rdi, 0x40000000;
        call bat_emit_pipe_control;
        mov r11, 0xFFFFF54A;             // BAD_FLAGS
        cmp rax, r11;
        jne batw_fail_stage;

        // Good flags: CS_STALL | DC_FLUSH | RTC_FLUSH.  Note DC_FLUSH
        // is bit 5 (0x20), which is OUTSIDE 0x0FFFF000 -- the caller
        // must combine it via the low-bit contract of the header
        // itself; here we validate the mask contract, so pass only
        // flags inside the mask range.
        mov rdi, 0x00101000;             // CS_STALL | RTC_FLUSH
        call bat_emit_pipe_control;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_cursor;
        cmp rax, 60;                     // 36 + 24
        jne batw_fail_stage;

        // Header at offset 36 = 0x7A000004 | 0x00101000 = 0x7A101004.
        lea r10, [rip + _batw_backing];
        mov eax, [r10 + 36];
        mov r11, 0x7A101004;
        cmp rax, r11;
        jne batw_fail_stage;

        // -- 10. OVERFLOW.
        mov rax, 10;
        lea rcx, [rip + _batw_stage];
        mov [rcx], rax;

        call batch_builder_end;
        call batw_scrub;
        lea rdi, [rip + _batw_backing];
        mov rsi, 8;                      // tiny capacity
        call batch_builder_begin;
        cmp rax, 0;
        jne batw_fail_stage;
        call bat_emit_noop;
        cmp rax, 0;
        jne batw_fail_stage;             // 1 NOOP fits (cursor=4)
        call bat_emit_noop;
        cmp rax, 0;
        jne batw_fail_stage;             // 2 NOOPs fit (cursor=8)
        call bat_emit_noop;
        mov r11, 0xFFFFF54C;             // OVERFLOW
        cmp rax, r11;
        jne batw_fail_stage;

        call batch_builder_end;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + batw_ok];
        call klog_s1;

        call batw_scrub;
        xor rax, rax;
        jmp batw_out;

      batw_fail_stage:
        lea rax, [rip + _batw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + batw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call batw_scrub;
        mov rax, 1;

      batw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
