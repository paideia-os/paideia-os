// tests/kernel/drivers/gpu/lrc_synth.pdx — R37.M5-002 (#1273)
//
// Boot witness for the Logical Ring Context (LRC) bookkeeping.
//
// Asserts engine / PA / size validators, per-engine size mapping,
// lrc_init happy path, DUPLICATE (same ctx + engine), cross-engine
// non-interference (same ctx, different engines OK), teardown
// round-trip, and ENOSPC at 16 entries.
//
// Fingerprint: R37 GPU LRC OK

module LrcSynth = structure {

  pub let mut _lrcw_stage : u64 = 0

  pub let lrcw_ok   : [u8; 17] = "R37 GPU LRC OK\n\0"
  pub let lrcw_fail : [u8; 19] = "R37 GPU LRC FAIL\n\0"

  pub let lrcw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): reset LRC table + counters.",
      block: {
        call lrc_table_reset;
        ret
      }
    }

  pub let lrc_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M5-002 (#1273): boot witness. Stages: (1) validators. (2) size mapping. (3) lrc_init happy path (render). (4) DUPLICATE refused. (5) cross-engine (blitter, video) OK on same ctx. (6) teardown round-trip. (7) ENOSPC at 16 rows.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        call lrcw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call lrc_engine_valid;
        cmp rax, 1;
        jne lrcw_fail_stage;
        mov rdi, 3;
        call lrc_engine_valid;
        cmp rax, 0;
        jne lrcw_fail_stage;

        mov rdi, 0x1000;
        call lrc_pa_valid;
        cmp rax, 1;
        jne lrcw_fail_stage;
        mov rdi, 0x1001;
        call lrc_pa_valid;
        cmp rax, 0;
        jne lrcw_fail_stage;
        mov rdi, 0;
        call lrc_pa_valid;
        cmp rax, 0;
        jne lrcw_fail_stage;

        // -- 2. Size mapping.
        mov rax, 2;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // render
        call lrc_size_for_engine;
        mov r11, 0x10000;
        cmp rax, r11;
        jne lrcw_fail_stage;

        mov rdi, 1;                      // blitter
        call lrc_size_for_engine;
        mov r11, 0x4000;
        cmp rax, r11;
        jne lrcw_fail_stage;

        mov rdi, 2;                      // video
        call lrc_size_for_engine;
        mov r11, 0x8000;
        cmp rax, r11;
        jne lrcw_fail_stage;

        mov rdi, 3;
        call lrc_size_for_engine;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // size_valid pairing
        mov rdi, 0;
        mov rsi, 0x10000;
        call lrc_size_valid;
        cmp rax, 1;
        jne lrcw_fail_stage;

        mov rdi, 0;
        mov rsi, 0x8000;                 // wrong size for render
        call lrc_size_valid;
        cmp rax, 0;
        jne lrcw_fail_stage;

        // -- 3. lrc_init happy path (ctx=1, engine=0=render, pa=0x100000, size=64K).
        mov rax, 3;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0x100000;
        mov rcx, 0x10000;
        call lrc_init_no_stamp;
        cmp rax, 0;
        jne lrcw_fail_stage;

        mov rdi, 0;
        call lrc_row_valid;
        cmp rax, 1;
        jne lrcw_fail_stage;

        mov rdi, 0;
        call lrc_row_ctx;
        cmp rax, 1;
        jne lrcw_fail_stage;

        mov rdi, 0;
        call lrc_row_engine;
        cmp rax, 0;
        jne lrcw_fail_stage;

        mov rdi, 0;
        call lrc_row_pa;
        mov r11, 0x100000;
        cmp rax, r11;
        jne lrcw_fail_stage;

        mov rdi, 0;
        call lrc_row_size;
        mov r11, 0x10000;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // -- 4. DUPLICATE refused (same ctx, same engine).
        mov rax, 4;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0x200000;
        mov rcx, 0x10000;
        call lrc_init_no_stamp;
        mov r11, 0xFFFFF599;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // BAD_SIZE (wrong size for engine).
        mov rdi, 2;
        mov rsi, 0;                      // render but size=0x4000 (blitter)
        mov rdx, 0x200000;
        mov rcx, 0x4000;
        call lrc_init_no_stamp;
        mov r11, 0xFFFFF59C;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // -- 5. Cross-engine on same ctx OK.
        mov rax, 5;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // blitter
        mov rdx, 0x200000;
        mov rcx, 0x4000;
        call lrc_init_no_stamp;
        cmp rax, 1;                      // row 1
        jne lrcw_fail_stage;

        mov rdi, 1;
        mov rsi, 2;                      // video
        mov rdx, 0x300000;
        mov rcx, 0x8000;
        call lrc_init_no_stamp;
        cmp rax, 2;                      // row 2
        jne lrcw_fail_stage;

        // find lookups
        mov rdi, 1;
        mov rsi, 1;
        call lrc_find;
        cmp rax, 1;
        jne lrcw_fail_stage;

        mov rdi, 1;
        mov rsi, 2;
        call lrc_find;
        cmp rax, 2;
        jne lrcw_fail_stage;

        mov rdi, 99;                     // no such ctx
        mov rsi, 0;
        call lrc_find;
        mov r11, 0xFF;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // -- 6. Teardown round-trip.
        mov rax, 6;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call lrc_teardown;
        cmp rax, 0;
        jne lrcw_fail_stage;

        mov rdi, 2;
        call lrc_row_valid;
        cmp rax, 0;
        jne lrcw_fail_stage;

        // Bad teardown id
        mov rdi, 99;
        call lrc_teardown;
        mov r11, 0xFFFFF598;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // Re-init the freed slot
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 0x400000;
        mov rcx, 0x8000;
        call lrc_init_no_stamp;
        cmp rax, 2;
        jne lrcw_fail_stage;

        // -- 7. ENOSPC.  We already have 3 rows.  Add 13 more.
        mov rax, 7;
        lea rcx, [rip + _lrcw_stage];
        mov [rcx], rax;

        mov rbx, 2;                      // start_ctx (already used ctx=1)
      lrcw_fill:
        cmp rbx, 15;                     // ctx 2..14 = 13 more contexts, each with one render LRC
        ja  lrcw_check_enospc;
        mov rdi, rbx;
        mov rsi, 0;                      // render
        mov r14, rbx;
        shl r14, 20;                     // pa = ctx * 0x100000
        add r14, 0x1000000;              // offset base
        mov rdx, r14;
        mov rcx, 0x10000;
        call lrc_init_no_stamp;
        // Expect success until ENOSPC hits.
        mov r11, 0xFFFFF59A;
        cmp rax, r11;
        je  lrcw_check_enospc;
        add rbx, 1;
        jmp lrcw_fill;

      lrcw_check_enospc:
        // Now the table should be full or nearly full.  One more init
        // MUST return ENOSPC.
        mov rdi, 99;
        mov rsi, 0;
        mov rdx, 0x9000000;
        mov rcx, 0x10000;
        call lrc_init_no_stamp;
        mov r11, 0xFFFFF59A;
        cmp rax, r11;
        jne lrcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lrcw_ok];
        call klog_s1;

        call lrcw_scrub;
        xor rax, rax;
        jmp lrcw_out;

      lrcw_fail_stage:
        lea rax, [rip + _lrcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lrcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call lrcw_scrub;
        mov rax, 1;

      lrcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
