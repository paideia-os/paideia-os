// tests/kernel/drivers/gpu/guc_submit_synth.pdx — R37.M6-002 (#1277)
//
// Boot witness for GuC-mediated submission.
//
// Asserts queue validator, single-issuer discipline (a second start on a
// queue that already has an in-flight submit is refused with
// QUEUE_BUSY), finish returns the completed row_id and clears busy,
// finish on an idle queue refused with QUEUE_IDLE, MMIO_NOT_BOUND
// discipline before gmmio_bind, doorbell round-trip after bind, and
// counters bump on every path.
//
// Fingerprint: R37 GUC SUBMIT OK

module GucSubmitSynth = structure {

  pub let mut _gsubw_stage : u64 = 0

  pub let gsubw_ok   : [u8; 15] = "GUC SUBMIT OK\n\0"
  pub let gsubw_fail : [u8; 17] = "GUC SUBMIT FAIL\n\0"

  pub let gsubw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-002 (#1277): reset per-queue records + counters.",
      block: {
        call guc_submit_reset;
        ret
      }
    }

  pub let guc_submit_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M6-002 (#1277): boot witness. Stages: (1) validators. (2) BAD_QUEUE / idle initial. (3) MMIO_NOT_BOUND before gmmio_bind. (4) bind gmmio. (5) Happy start on queue 3 + accessors + counters. (6) Single-issuer trip: second start on the busy queue -> QUEUE_BUSY. (7) Finish returns the completed row_id and clears busy. (8) Finish on idle refused with QUEUE_IDLE. (9) Start on a different queue proceeds independently.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        call gsubw_scrub;
        call gmmio_reset;

        // -- 1. Validators.
        mov rdi, 0;
        call gsub_queue_valid;
        cmp rax, 1;
        jne gsubw_fail_stage;
        mov rdi, 7;
        call gsub_queue_valid;
        cmp rax, 1;
        jne gsubw_fail_stage;
        mov rdi, 8;
        call gsub_queue_valid;
        cmp rax, 0;
        jne gsubw_fail_stage;

        // -- 2. BAD_QUEUE + idle initial.
        mov rax, 2;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 8;
        call gsub_queue_busy;
        cmp rax, 0;
        jne gsubw_fail_stage;

        mov rdi, 8;
        call gsub_queue_inflight_row;
        cmp rax, 0xFF;
        jne gsubw_fail_stage;

        mov rdi, 8;
        mov rsi, 5;
        call gsub_start;
        mov r11, 0xFFFFF55F;             // BAD_QUEUE
        cmp rax, r11;
        jne gsubw_fail_stage;

        mov rdi, 8;
        call gsub_finish;
        mov r11, 0xFFFFF55F;
        cmp rax, r11;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_busy;
        cmp rax, 0;
        jne gsubw_fail_stage;
        mov rdi, 3;
        call gsub_queue_inflight_row;
        cmp rax, 0xFF;
        jne gsubw_fail_stage;

        // -- 3. MMIO_NOT_BOUND before gmmio_bind.
        mov rax, 3;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 7;
        call gsub_start;
        mov r11, 0xFFFFF55B;             // MMIO_NOT_BOUND
        cmp rax, r11;
        jne gsubw_fail_stage;

        // Atomicity: queue must still be idle after the failed start.
        mov rdi, 3;
        call gsub_queue_busy;
        cmp rax, 0;
        jne gsubw_fail_stage;

        // -- 4. Bind synthetic MMIO backing.
        mov rax, 4;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne gsubw_fail_stage;

        // -- 5. Happy start on queue 3 + accessors + counters.
        mov rax, 5;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 7;                      // arbitrary submit_row_id
        call gsub_start;
        cmp rax, 0;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_busy;
        cmp rax, 1;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_inflight_row;
        cmp rax, 7;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_submits;
        cmp rax, 1;
        jne gsubw_fail_stage;

        // STARTS counter bumped once.
        mov rdi, 0;                      // STARTS
        call gsub_stat;
        cmp rax, 1;
        jne gsubw_fail_stage;
        // DBELLS counter bumped once.
        mov rdi, 3;                      // DBELLS
        call gsub_stat;
        cmp rax, 1;
        jne gsubw_fail_stage;

        // Sequence bumped.
        call gsub_seq_read;
        cmp rax, 1;
        jne gsubw_fail_stage;

        // -- 6. Single-issuer trip.
        mov rax, 6;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 9;                      // different row -- irrelevant
        call gsub_start;
        mov r11, 0xFFFFF55D;             // QUEUE_BUSY
        cmp rax, r11;
        jne gsubw_fail_stage;

        // Queue state must be unchanged.
        mov rdi, 3;
        call gsub_queue_inflight_row;
        cmp rax, 7;
        jne gsubw_fail_stage;
        mov rdi, 3;
        call gsub_queue_submits;
        cmp rax, 1;
        jne gsubw_fail_stage;

        // -- 7. Finish returns the completed row_id and clears busy.
        mov rax, 7;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        call gsub_finish;
        cmp rax, 7;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_busy;
        cmp rax, 0;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_inflight_row;
        cmp rax, 0xFF;
        jne gsubw_fail_stage;

        mov rdi, 3;
        call gsub_queue_completes;
        cmp rax, 1;
        jne gsubw_fail_stage;

        // -- 8. Finish on an idle queue refused with QUEUE_IDLE.
        mov rax, 8;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 5;                      // never started
        call gsub_finish;
        mov r11, 0xFFFFF55C;             // QUEUE_IDLE
        cmp rax, r11;
        jne gsubw_fail_stage;

        // -- 9. Start on a different queue proceeds independently.
        mov rax, 9;
        lea rcx, [rip + _gsubw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 11;
        call gsub_start;
        cmp rax, 0;
        jne gsubw_fail_stage;

        mov rdi, 5;
        call gsub_queue_busy;
        cmp rax, 1;
        jne gsubw_fail_stage;
        mov rdi, 5;
        call gsub_queue_inflight_row;
        cmp rax, 11;
        jne gsubw_fail_stage;

        // Queue 3 must remain idle.
        mov rdi, 3;
        call gsub_queue_busy;
        cmp rax, 0;
        jne gsubw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gsubw_ok];
        call klog_s1;

        call gsubw_scrub;
        call gmmio_reset;
        xor rax, rax;
        jmp gsubw_out;

      gsubw_fail_stage:
        lea rax, [rip + _gsubw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gsubw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gsubw_scrub;
        call gmmio_reset;
        mov rax, 1;

      gsubw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
