// tests/kernel/drivers/gpu/guc_verify_synth.pdx — R37.M2-001 (#1257)
//
// Boot witness for guc_verify. Asserts NULL/undersize/magic refusals,
// vendor-sig-empty refusal, paideia-sig-empty refusal, dual-sig happy
// path, idempotent identity re-verify, swap refusal, and the
// arbitration honesty pin.
//
// Fingerprint: R37 GUC VERIFY OK

module GucVerifySynth = structure {

  pub let mut _gucvw_stage : u64 = 0

  pub let gucvw_ok   : [u8; 19] = "R37 GUC VERIFY OK\n\0"
  pub let gucvw_fail : [u8; 21] = "R37 GUC VERIFY FAIL\n\0"

  // Two synthetic blobs — one well-formed (both sig slots non-empty),
  // three malformed (vendor empty; paideia empty; wrong magic).
  //
  // Layout mirrors guc_verify.pdx §1:
  //   [0] magic 'GUCF' (LE 0x46435547)
  //   [4] body_size
  //   [8..15]  vendor_sig[0..1]  (u64 pair)
  //   [16..23] paideia_sig[0..1] (u64 pair)
  //   [24..]   body (unused)
  //
  // We represent each blob as 8 u64s (64 bytes) — 40 header + 24 body
  // padding so the ptr passed to gucv_verify has enough tail.

  pub let mut _gucvw_blob_good : [u64; 8] = uninit @align(64)
  pub let mut _gucvw_blob_no_vendor : [u64; 8] = uninit @align(64)
  pub let mut _gucvw_blob_no_paideia : [u64; 8] = uninit @align(64)
  pub let mut _gucvw_blob_bad_magic : [u64; 8] = uninit @align(64)

  pub let guc_verify_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M2-001 (#1257): boot witness. Stages: (1) reset + arbitration pin. (2) NULL blob. (3) undersize blob. (4) bad magic. (5) vendor sig empty. (6) paideia sig empty. (7) dual-sig happy path + row accessors. (8) idempotent same-blob. (9) swap refusal. (10) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        call gucv_reset;

        // Zero all four blob buffers.
        lea r10, [rip + _gucvw_blob_good];
        xor rax, rax;
        xor rcx, rcx;
      gucvw_zero_good:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gucvw_zero_good;

        lea r10, [rip + _gucvw_blob_no_vendor];
        xor rcx, rcx;
      gucvw_zero_nv:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gucvw_zero_nv;

        lea r10, [rip + _gucvw_blob_no_paideia];
        xor rcx, rcx;
      gucvw_zero_np:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gucvw_zero_np;

        lea r10, [rip + _gucvw_blob_bad_magic];
        xor rcx, rcx;
      gucvw_zero_bm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gucvw_zero_bm;

        // Populate: header u64 packs magic (low 32) + body_size
        // (high 32); the buffers were zeroed above so a lone qword
        // write covers both fields without a dword-ptr helper.
        // hdr_good = (0x100 << 32) | 0x46435547 = 0x0000010046435547
        // hdr_bad  = (0x100 << 32) | 0xDEADBEEF = 0x00000100DEADBEEF

        // Good blob: header + both sig slots.
        lea r10, [rip + _gucvw_blob_good];
        mov rax, 0x0000010046435547;           // header
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;                    // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;                   // vendor_sig[1]
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;                   // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;                   // paideia_sig[1]

        // no_vendor blob: header + paideia slot; vendor slot zero.
        lea r10, [rip + _gucvw_blob_no_vendor];
        mov rax, 0x0000010046435547;
        mov [r10 + 0], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        // no_paideia blob: header + vendor slot; paideia slot zero.
        lea r10, [rip + _gucvw_blob_no_paideia];
        mov rax, 0x0000010046435547;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;

        // bad_magic blob: wrong-magic header + both sig slots set.
        lea r10, [rip + _gucvw_blob_bad_magic];
        mov rax, 0x00000100DEADBEEF;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        call gucv_arbitrated;
        cmp rax, 0;
        jne gucvw_fail_stage;

        // -- 2. NULL blob.
        mov rax, 2;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1000;
        call gucv_verify;
        mov r11, 0xFFFFF67A;             // NULL_BLOB
        cmp rax, r11;
        jne gucvw_fail_stage;

        // -- 3. Undersize blob (len < 0x28).
        mov rax, 3;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x27;                   // one byte short of header
        call gucv_verify;
        mov r11, 0xFFFFF67E;             // TOO_SMALL
        cmp rax, r11;
        jne gucvw_fail_stage;

        // -- 4. Bad magic.
        mov rax, 4;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_bad_magic];
        mov rsi, 0x40;
        call gucv_verify;
        mov r11, 0xFFFFF67D;             // BAD_MAGIC
        cmp rax, r11;
        jne gucvw_fail_stage;

        // -- 5. Vendor sig empty.
        mov rax, 5;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_no_vendor];
        mov rsi, 0x40;
        call gucv_verify;
        mov r11, 0xFFFFF67C;             // BAD_VENDOR_SIG
        cmp rax, r11;
        jne gucvw_fail_stage;

        // Standalone vendor helper agrees.
        lea rdi, [rip + _gucvw_blob_no_vendor];
        mov rsi, 0x40;
        call gucv_verify_vendor;
        mov r11, 0xFFFFF67C;
        cmp rax, r11;
        jne gucvw_fail_stage;

        // -- 6. Paideia sig empty.
        mov rax, 6;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_no_paideia];
        mov rsi, 0x40;
        call gucv_verify;
        mov r11, 0xFFFFF67B;             // BAD_PAIDEIA_SIG
        cmp rax, r11;
        jne gucvw_fail_stage;

        // Standalone paideia helper agrees.
        lea rdi, [rip + _gucvw_blob_no_paideia];
        mov rsi, 0x40;
        call gucv_verify_paideia;
        mov r11, 0xFFFFF67B;
        cmp rax, r11;
        jne gucvw_fail_stage;

        // Precondition: nothing has succeeded yet, so state stays clean.
        call gucv_is_verified;
        cmp rax, 0;
        jne gucvw_fail_stage;

        // -- 7. Happy path + accessors.
        mov rax, 7;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x40;
        call gucv_verify;
        cmp rax, 0;
        jne gucvw_fail_stage;

        call gucv_is_verified;
        cmp rax, 1;
        jne gucvw_fail_stage;

        call gucv_blob_ptr_of;
        lea r11, [rip + _gucvw_blob_good];
        cmp rax, r11;
        jne gucvw_fail_stage;

        call gucv_blob_len_of;
        cmp rax, 0x40;
        jne gucvw_fail_stage;

        // Vendor + paideia helpers accept the good blob standalone.
        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x40;
        call gucv_verify_vendor;
        cmp rax, 0;
        jne gucvw_fail_stage;
        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x40;
        call gucv_verify_paideia;
        cmp rax, 0;
        jne gucvw_fail_stage;

        // -- 8. Idempotent same-blob.
        mov rax, 8;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x40;
        call gucv_verify;
        cmp rax, 0;
        jne gucvw_fail_stage;

        // -- 9. Swap refusal.
        mov rax, 9;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        // Different ptr with same len: swap on ptr.
        lea rdi, [rip + _gucvw_blob_no_vendor];
        mov rsi, 0x40;
        call gucv_verify;
        mov r11, 0xFFFFF67F;             // BAD_ARG
        cmp rax, r11;
        jne gucvw_fail_stage;

        // Same ptr with different len: swap on len.
        lea rdi, [rip + _gucvw_blob_good];
        mov rsi, 0x41;
        call gucv_verify;
        mov r11, 0xFFFFF67F;
        cmp rax, r11;
        jne gucvw_fail_stage;

        // -- 10. Stat fanout.
        mov rax, 10;
        lea rcx, [rip + _gucvw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // VERIFIED
        call gucv_stat;
        cmp rax, 1;                      // stage 7 accepted once
        jne gucvw_fail_stage;

        mov rdi, 1;                      // VENDOR_MISS
        call gucv_stat;
        cmp rax, 1;                      // stage 5 hit once
        jne gucvw_fail_stage;

        mov rdi, 2;                      // PAIDEIA_MISS
        call gucv_stat;
        cmp rax, 1;                      // stage 6 hit once
        jne gucvw_fail_stage;

        mov rdi, 3;                      // REFUSED (all refuse paths)
        call gucv_stat;
        // Refusals bumped: NULL (2), TOO_SMALL (3), BAD_MAGIC (4),
        // BAD_VENDOR (5 — sole call to top-level; sub-helper does NOT
        // bump), BAD_PAIDEIA (6 — same), BAD_ARG (9 twice) = 7.
        cmp rax, 7;
        jne gucvw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gucvw_ok];
        call klog_s1;

        call gucv_reset;
        xor rax, rax;
        jmp gucvw_out;

      gucvw_fail_stage:
        lea rax, [rip + _gucvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gucvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gucv_reset;
        mov rax, 1;

      gucvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
