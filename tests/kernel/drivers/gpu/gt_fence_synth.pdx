// tests/kernel/drivers/gpu/gt_fence_synth.pdx — R37.M7-003 (#1283)
//
// Boot witness for the GT fence + interrupt path.
//
// Asserts engine validator, MMIO_NOT_BOUND discipline before gmmio_bind,
// signal path (CS_SEQNO stamp + GT_IIR edge set), the ISR advances
// last_signaled_seqno + write-1-to-clears the serviced bits, wait
// short-circuits on already-reached seqno, wait registers on
// not-yet-reached seqno, second wait on a busy engine is refused,
// completion via the ISR clears a registered waiter and bumps
// UNBLOCKS, monotonicity (older seqno never rolls back last_signaled),
// and cross-engine independence.
//
// Fingerprint: R37 GT FENCE OK

module GtFenceSynth = structure {

  pub let mut _gtfw_stage : u64 = 0

  pub let gtfw_ok   : [u8; 11] = "GT FENCE OK\n\0"
  pub let gtfw_fail : [u8; 13] = "GT FENCE FAIL\n\0"

  pub let gtfw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M7-003 (#1283): reset per-engine records + counters.",
      block: {
        call gt_fence_reset;
        ret
      }
    }

  pub let gt_fence_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M7-003 (#1283): boot witness. Stages: (1) validators. (2) MMIO_NOT_BOUND before gmmio_bind. (3) bind gmmio. (4) BAD_ENGINE / BAD_SEQNO refusals. (5) signal on engine 1 seqno=5; last_signaled still 0; pending IIR bit visible via ISR advance. (6) wait for future seqno registers; second wait -> WAIT_BUSY; wait for past seqno -> REACHED (no register). (7) ISR advances last_signaled + releases waiter + bumps UNBLOCKS. (8) monotonicity: older seqno does not roll back. (9) cross-engine independence: engine 0 unaffected by engine 1 traffic.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        call gtfw_scrub;
        call gmmio_reset;

        // -- 1. Validators.
        mov rdi, 0;
        call gtf_engine_valid;
        cmp rax, 1;
        jne gtfw_fail_stage;
        mov rdi, 3;
        call gtf_engine_valid;
        cmp rax, 1;
        jne gtfw_fail_stage;
        mov rdi, 4;
        call gtf_engine_valid;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // Initial state: last_signaled = 0, no pending waiter.
        mov rdi, 0;
        call gtf_signaled;
        cmp rax, 0;
        jne gtfw_fail_stage;
        mov rdi, 1;
        call gtf_pending;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // -- 2. MMIO_NOT_BOUND before gmmio_bind.
        mov rax, 2;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 5;
        call gtf_signal;
        mov r11, 0xFFFFF53C;             // MMIO_NOT_BOUND
        cmp rax, r11;
        jne gtfw_fail_stage;

        call gtf_isr;
        mov r11, 0xFFFFF53C;
        cmp rax, r11;
        jne gtfw_fail_stage;

        // -- 3. Bind synthetic MMIO backing.
        mov rax, 3;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // -- 4. BAD_ENGINE / BAD_SEQNO refusals.
        mov rax, 4;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 5;
        call gtf_signal;
        mov r11, 0xFFFFF53F;             // BAD_ENGINE
        cmp rax, r11;
        jne gtfw_fail_stage;

        mov rdi, 1;
        mov rsi, 0;
        call gtf_signal;
        mov r11, 0xFFFFF53E;             // BAD_SEQNO
        cmp rax, r11;
        jne gtfw_fail_stage;

        mov rdi, 4;
        mov rsi, 5;
        call gtf_wait;
        mov r11, 0xFFFFF53F;
        cmp rax, r11;
        jne gtfw_fail_stage;

        mov rdi, 1;
        mov rsi, 0;
        call gtf_wait;
        mov r11, 0xFFFFF53E;
        cmp rax, r11;
        jne gtfw_fail_stage;

        // -- 5. Signal on engine 1 seqno=5.  last_signaled still 0
        //       (that is the ISR's job).  SIGNALS counter bumped.
        mov rax, 5;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 5;
        call gtf_signal;
        cmp rax, 0;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_signaled;
        cmp rax, 0;
        jne gtfw_fail_stage;

        mov rdi, 0;                      // SIGNALS
        call gtf_stat;
        cmp rax, 1;
        jne gtfw_fail_stage;

        // -- 6. Wait for future seqno registers, second wait busy,
        //       wait for reached seqno short-circuits.
        mov rax, 6;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        // wait(engine=1, seqno=7): future.  Registers.  Returns OK (0).
        mov rdi, 1;
        mov rsi, 7;
        call gtf_wait;
        cmp rax, 0;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_pending;
        cmp rax, 1;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_pending_seqno;
        cmp rax, 7;
        jne gtfw_fail_stage;

        // Second wait on engine 1 -> WAIT_BUSY.
        mov rdi, 1;
        mov rsi, 3;
        call gtf_wait;
        mov r11, 0xFFFFF53D;             // WAIT_BUSY
        cmp rax, r11;
        jne gtfw_fail_stage;

        // Pending state must be unchanged.
        mov rdi, 1;
        call gtf_pending_seqno;
        cmp rax, 7;
        jne gtfw_fail_stage;

        // -- 7. ISR advances last_signaled + releases waiter.  The
        //       pending waiter's seqno (7) is above the currently
        //       signaled value (5), so the FIRST isr run advances
        //       last_signaled -> 5 but leaves the waiter registered.
        mov rax, 7;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        call gtf_isr;
        cmp rax, 0;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_signaled;
        cmp rax, 5;
        jne gtfw_fail_stage;

        // Waiter still registered (5 < 7).
        mov rdi, 1;
        call gtf_pending;
        cmp rax, 1;
        jne gtfw_fail_stage;

        // gtf_reached(1, 5) = 1; gtf_reached(1, 6) = 0.
        mov rdi, 1;
        mov rsi, 5;
        call gtf_reached;
        cmp rax, 1;
        jne gtfw_fail_stage;
        mov rdi, 1;
        mov rsi, 6;
        call gtf_reached;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // A NEW wait for a seqno already reached short-circuits with
        // GTF_REACHED (1) and DOES NOT touch the pending waiter slot.
        // Use engine 2 for the short-circuit so engine 1's registered
        // waiter is not disturbed.
        mov rdi, 2;
        mov rsi, 10;
        call gtf_signal;
        cmp rax, 0;
        jne gtfw_fail_stage;
        call gtf_isr;
        cmp rax, 0;
        jne gtfw_fail_stage;
        mov rdi, 2;
        mov rsi, 10;
        call gtf_wait;
        cmp rax, 1;
        jne gtfw_fail_stage;
        mov rdi, 2;
        call gtf_pending;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // Signal seqno 8 on engine 1; ISR then releases the pending 7.
        mov rdi, 1;
        mov rsi, 8;
        call gtf_signal;
        cmp rax, 0;
        jne gtfw_fail_stage;

        call gtf_isr;
        cmp rax, 0;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_signaled;
        cmp rax, 8;
        jne gtfw_fail_stage;

        mov rdi, 1;
        call gtf_pending;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // UNBLOCKS counter bumped exactly once (engine 1's waiter).
        mov rdi, 3;                      // UNBLOCKS
        call gtf_stat;
        cmp rax, 1;
        jne gtfw_fail_stage;

        // -- 8. Monotonicity: signalling an OLDER seqno does not roll
        //       last_signaled back.
        mov rax, 8;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 3;                      // < 8
        call gtf_signal;
        cmp rax, 0;
        jne gtfw_fail_stage;
        call gtf_isr;
        cmp rax, 0;
        jne gtfw_fail_stage;
        mov rdi, 1;
        call gtf_signaled;
        cmp rax, 8;
        jne gtfw_fail_stage;

        // -- 9. Cross-engine independence.  Engine 0 has seen no
        //       signals so last_signaled is still 0, and gtf_reached
        //       against seqno 1 must be 0.
        mov rax, 9;
        lea rcx, [rip + _gtfw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gtf_signaled;
        cmp rax, 0;
        jne gtfw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call gtf_reached;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // Engine 3 receives a signal + ISR advances only its own slot.
        mov rdi, 3;
        mov rsi, 42;
        call gtf_signal;
        cmp rax, 0;
        jne gtfw_fail_stage;
        call gtf_isr;
        cmp rax, 0;
        jne gtfw_fail_stage;
        mov rdi, 3;
        call gtf_signaled;
        cmp rax, 42;
        jne gtfw_fail_stage;
        mov rdi, 0;
        call gtf_signaled;
        cmp rax, 0;
        jne gtfw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gtfw_ok];
        call klog_s1;

        call gtfw_scrub;
        call gmmio_reset;
        xor rax, rax;
        jmp gtfw_out;

      gtfw_fail_stage:
        lea rax, [rip + _gtfw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gtfw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gtfw_scrub;
        call gmmio_reset;
        mov rax, 1;

      gtfw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
