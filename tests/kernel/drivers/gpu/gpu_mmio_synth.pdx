// tests/kernel/drivers/gpu/gpu_mmio_synth.pdx — R37.M1-001 (#1253)
//
// Boot witness for gpu_mmio. Asserts BAR-alignment/length validators,
// bind idempotence + swap-refusal, offset gate (NOT_BOUND / UNALIGNED
// / OUT_OF_RANGE), round-trip through the synthetic backing store,
// and the arbitration honesty pin.
//
// Fingerprint: R37 GPU MMIO OK

module GpuMmioSynth = structure {

  pub let mut _gmmiow_stage : u64 = 0

  pub let gmmiow_ok   : [u8; 13] = "GPU MMIO OK\0"
  pub let gmmiow_fail : [u8; 15] = "GPU MMIO FAIL\0"

  pub let gpu_mmio_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M1-001 (#1253): boot witness. Stages: (1) reset + arbitration pin. (2) BAR alignment / length validators. (3) NOT_BOUND refusal from write/read before bind. (4) bind: bad base, misaligned, too small. (5) bind happy path + idempotent same-bind. (6) bind swap refusal. (7) offset gate refusals (UNALIGNED / OUT_OF_RANGE). (8) round-trip: write then read yields the u32 back.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        call gmmio_reset;

        call gmmio_arbitrated;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        // -- 2. Alignment / length validators.
        mov rax, 2;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;             // 16 MB aligned
        call gmmio_bar_aligned;
        cmp rax, 1;
        jne gmmiow_fail_stage;

        mov rdi, 0xF0800000;             // 8 MB aligned, not 16
        call gmmio_bar_aligned;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        mov rdi, 0x1000000;              // exactly 16 MB
        call gmmio_bar_len_ok;
        cmp rax, 1;
        jne gmmiow_fail_stage;

        mov rdi, 0xFFFFFF;               // 16 MB - 1
        call gmmio_bar_len_ok;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        // -- 3. NOT_BOUND before bind.
        mov rax, 3;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0xDEADBEEF;
        call gmmio_write32;
        mov r11, 0xFFFFF6AB;             // NOT_BOUND
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0;
        call gmmio_read32;
        mov r11, 0xFFFFF6AB;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // -- 4. Bind failures.
        mov rax, 4;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1000000;
        call gmmio_bind;
        mov r11, 0xFFFFF6AE;             // BAD_BAR
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0xF0800000;             // 8 MB aligned, not 16
        mov rsi, 0x1000000;
        call gmmio_bind;
        mov r11, 0xFFFFF6AD;             // MISALIGNED
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0xF0000000;
        mov rsi, 0x800000;               // 8 MB — too small
        call gmmio_bind;
        mov r11, 0xFFFFF6AC;             // TOO_SMALL
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // -- 5. Bind happy path + idempotence.
        mov rax, 5;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        call gmmio_is_bound;
        cmp rax, 1;
        jne gmmiow_fail_stage;

        call gmmio_bar_base_of;
        mov r11, 0xF0000000;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        call gmmio_bar_len_of;
        mov r11, 0x1000000;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // Idempotent same-bind.
        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        // -- 6. Bind swap refusal.
        mov rax, 6;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0xE0000000;             // different base
        mov rsi, 0x1000000;
        call gmmio_bind;
        mov r11, 0xFFFFF6AE;             // BAD_BAR
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0xF0000000;
        mov rsi, 0x2000000;              // different len
        call gmmio_bind;
        mov r11, 0xFFFFF6AE;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // -- 7. Offset gate: UNALIGNED / OUT_OF_RANGE.
        mov rax, 7;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // not u32-aligned
        mov rsi, 0x12345678;
        call gmmio_write32;
        mov r11, 0xFFFFF6A9;             // UNALIGNED_OFF
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0x1000000;              // == bar_len
        mov rsi, 0x12345678;
        call gmmio_write32;
        mov r11, 0xFFFFF6AA;             // OUT_OF_RANGE
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // -- 8. Round-trip.
        mov rax, 8;
        lea rcx, [rip + _gmmiow_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 0xCAFEF00D;
        call gmmio_write32;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        mov rdi, 0x100;
        call gmmio_read32;
        mov r11, 0xCAFEF00D;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // Different offset writes independently.
        mov rdi, 0x200;
        mov rsi, 0xDEADBEEF;
        call gmmio_write32;
        cmp rax, 0;
        jne gmmiow_fail_stage;

        mov rdi, 0x100;
        call gmmio_read32;
        mov r11, 0xCAFEF00D;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        mov rdi, 0x200;
        call gmmio_read32;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne gmmiow_fail_stage;

        // Counters advanced.
        mov rdi, 0;                      // READS
        call gmmio_stat;
        cmp rax, 0;
        je  gmmiow_fail_stage;

        mov rdi, 1;                      // WRITES
        call gmmio_stat;
        cmp rax, 0;
        je  gmmiow_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gmmiow_ok];
        call klog_s1;

        call gmmio_reset;
        xor rax, rax;
        jmp gmmiow_out;

      gmmiow_fail_stage:
        lea rax, [rip + _gmmiow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gmmiow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gmmio_reset;
        mov rax, 1;

      gmmiow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
