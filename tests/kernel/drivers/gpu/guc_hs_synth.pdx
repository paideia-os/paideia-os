// tests/kernel/drivers/gpu/guc_hs_synth.pdx — R37.M2-003 (#1259)
//
// Boot witness for guc_hs. Asserts precondition gates
// (NOT_LOADED / MMIO_NOT_BOUND), TIMEOUT if UKERNEL_LOADED never
// clears, BAD_VERSION on a zero version word, feature negotiation
// arithmetic (§2 intersection), and the handshake happy path with
// SLPC kick + row accessors.
//
// Fingerprint: R37 GUC HANDSHAKE OK

module GucHsSynth = structure {

  pub let mut _guchsw_stage : u64 = 0

  pub let guchsw_ok   : [u8; 18] = "GUC HANDSHAKE OK\0"
  pub let guchsw_fail : [u8; 20] = "GUC HANDSHAKE FAIL\0"

  // Reuse a verified blob shape from guc_verify §1.
  pub let mut _guchsw_blob : [u64; 8] = uninit @align(64)

  pub let guc_hs_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M2-003 (#1259): boot witness. Stages: (1) reset all four modules + arbitration pin. (2) negotiate() arithmetic in isolation. (3) NOT_LOADED before verify+load. (4) verify + bind + load. (5) MMIO_NOT_BOUND — deferred: we bind before load so this hit is unrepresentable; use handshake without bind after a scrub instead. (6) TIMEOUT when UKERNEL_LOADED not set. (7) BAD_VERSION when VERSION==0. (8) Happy path + SLPC kick + version + features intersection. (9) ALREADY_UP. (10) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        call guchs_reset;
        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;

        // Populate a well-formed blob.
        lea r10, [rip + _guchsw_blob];
        xor rax, rax;
        xor rcx, rcx;
      guchsw_zero_blob:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  guchsw_zero_blob;

        mov rax, 0x0000010046435547;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        call guchs_arbitrated;
        cmp rax, 0;
        jne guchsw_fail_stage;

        // -- 2. negotiate() arithmetic in isolation.
        mov rax, 2;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        // KMD mask = 0x3 (submission | SLPC). GuC advertises 0xF; the
        // intersection is 0x3.
        mov rdi, 0xF;
        call guchs_negotiate;
        cmp rax, 3;
        jne guchsw_fail_stage;

        // GuC advertises only bit 1 (SLPC); intersection is 0x2.
        mov rdi, 0x2;
        call guchs_negotiate;
        cmp rax, 2;
        jne guchsw_fail_stage;

        // GuC advertises 0x0; intersection is 0x0 (a feature-less GuC
        // is a GuC the KMD drives at zero features — not an error at
        // this step; the honesty pin fires elsewhere).
        mov rdi, 0;
        call guchs_negotiate;
        cmp rax, 0;
        jne guchsw_fail_stage;

        // GuC advertises a paideia-unknown bit only; intersection 0x0.
        mov rdi, 0x100;
        call guchs_negotiate;
        cmp rax, 0;
        jne guchsw_fail_stage;

        // -- 3. NOT_LOADED before verify+load.
        mov rax, 3;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        call guchs_handshake;
        mov r11, 0xFFFFF65E;                   // NOT_LOADED
        cmp rax, r11;
        jne guchsw_fail_stage;

        // -- 4. Verify + bind + load.
        mov rax, 4;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _guchsw_blob];
        mov rsi, 0x40;
        call gucv_verify;
        cmp rax, 0;
        jne guchsw_fail_stage;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne guchsw_fail_stage;

        mov rdi, 0x100000;
        mov rsi, 0x80000;
        call gucl_load;
        cmp rax, 0;
        jne guchsw_fail_stage;

        // -- 6. TIMEOUT when UKERNEL_LOADED never set.
        mov rax, 6;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        // GUC_STATUS still 0 (the load path did not touch 0xC000).
        // Bit 30 is clear so handshake times out.
        call guchs_handshake;
        mov r11, 0xFFFFF65C;                   // TIMEOUT
        cmp rax, r11;
        jne guchsw_fail_stage;

        // Stamp UKERNEL_LOADED bit into GUC_STATUS via the seam.
        mov rdi, 0xC000;
        mov rsi, 0x40000000;                   // UKERNEL_LOADED
        call gmmio_write32;
        cmp rax, 0;
        jne guchsw_fail_stage;

        // -- 7. BAD_VERSION when VERSION==0 (default).
        mov rax, 7;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        // GUC_VERSION at 0xC008 is still 0.
        call guchs_handshake;
        mov r11, 0xFFFFF65B;                   // BAD_VERSION
        cmp rax, r11;
        jne guchsw_fail_stage;

        // Verify SLPC register got kicked (side effect of stage 7's
        // handshake — SLPC write happens BEFORE the version read).
        mov rdi, 0xC02C;                       // SLPC_INIT
        call gmmio_read32;
        cmp rax, 0x51C0100;                    // SLPC_INIT_TOKEN
        jne guchsw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        // Stamp a version (major=1, minor=5 -> 0x00010005) and a
        // feature word that includes both KMD-known bits plus one
        // paideia-unknown bit (0x2 | 0x1 | 0x100 = 0x103).
        mov rdi, 0xC008;
        mov rsi, 0x00010005;
        call gmmio_write32;
        cmp rax, 0;
        jne guchsw_fail_stage;

        mov rdi, 0xC00C;
        mov rsi, 0x103;
        call gmmio_write32;
        cmp rax, 0;
        jne guchsw_fail_stage;

        call guchs_handshake;
        cmp rax, 0;
        jne guchsw_fail_stage;

        call guchs_is_ready;
        cmp rax, 1;
        jne guchsw_fail_stage;

        call guchs_version_of;
        mov r11, 0x00010005;
        cmp rax, r11;
        jne guchsw_fail_stage;

        call guchs_features_of;
        cmp rax, 3;                            // 0x103 & 0x3 = 0x3
        jne guchsw_fail_stage;

        // -- 9. ALREADY_UP on second handshake.
        mov rax, 9;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        call guchs_handshake;
        mov r11, 0xFFFFF659;                   // ALREADY_UP
        cmp rax, r11;
        jne guchsw_fail_stage;

        // -- 10. Stat fanout.
        mov rax, 10;
        lea rcx, [rip + _guchsw_stage];
        mov [rcx], rax;

        mov rdi, 0;                            // HANDSHAKES
        call guchs_stat;
        cmp rax, 1;
        jne guchsw_fail_stage;

        mov rdi, 1;                            // TIMEOUTS
        call guchs_stat;
        cmp rax, 1;                            // stage 6
        jne guchsw_fail_stage;

        mov rdi, 2;                            // REFUSED
        call guchs_stat;
        // NOT_LOADED (3) + BAD_VERSION (7) + ALREADY_UP (9) = 3.
        cmp rax, 3;
        jne guchsw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + guchsw_ok];
        call klog_s1;

        call guchs_reset;
        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp guchsw_out;

      guchsw_fail_stage:
        lea rax, [rip + _guchsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + guchsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call guchs_reset;
        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;
        mov rax, 1;

      guchsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
