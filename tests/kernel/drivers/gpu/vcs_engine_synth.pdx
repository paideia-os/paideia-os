// tests/kernel/drivers/gpu/vcs_engine_synth.pdx — R37.M8-002 (#1286)
//
// Boot witness for the VCS engine substrate.  Asserts:
//   * validators (bind refusals, wake refusals when unbound / unwoken).
//   * MMIO_NOT_BOUND gate before gmmio_bind.
//   * LRC bind + accessor round-trip.
//   * wake path -- writes ENABLE|VALID to RING_CTL, clears MI_MODE.
//   * ALREADY_WOKEN refusal.
//   * HuC not ready gate on submit_begin.
//   * happy submit_begin/submit_finish cycle after HuC ready.
//   * single-issuer trip (second submit_begin -> QUEUE_BUSY).
//   * QUEUE_IDLE on submit_finish with nothing in flight.
//   * sleep refuses while a submit is in flight, succeeds afterwards.
//   * wake counter monotonic across a wake -> sleep -> wake sequence.
//
// Fingerprint: R37 VCS ENGINE OK
//
// Depends on huc_load being present.  This witness runs AFTER
// huc_load_witness so hucl_accepted() is a controlled input (the
// witness scrubs at the top so the HuC state at boot is not
// smuggled forward).

module VcsEngineSynth = structure {

  pub let mut _vcsw_stage : u64 = 0

  pub let vcsw_ok   : [u8; 14] = "VCS ENGINE OK\0"
  pub let vcsw_fail : [u8; 16] = "VCS ENGINE FAIL\0"

  // A reusable HuC blob (matches huc_load_synth's ok blob).
  pub let mut _vcsw_huc_blob : [u64; 8] = uninit @align(64)

  pub let vcs_engine_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M8-002 (#1286): boot witness. Stages: (1) reset all three modules. (2) accessors zero at boot. (3) MMIO_NOT_BOUND gate. (4) bind gmmio. (5) LRC bind refusals (bad size / null). (6) LRC bind + accessor. (7) LRC_NOT_BOUND before bind is cleared -- covered by reset+wake. (8) wake path + register echoes. (9) ALREADY_WOKEN. (10) HuC_NOT_READY on submit_begin. (11) load HuC, then submit_begin OK. (12) QUEUE_BUSY on second submit_begin. (13) submit_finish returns row_id, clears inflight. (14) QUEUE_IDLE on second submit_finish. (15) sleep refuses on inflight, succeeds after drain. (16) wake_seq monotonic across wake/sleep/wake. (17) counters.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_engine_reset;
        call huc_load_reset;
        call gmmio_reset;

        // Prep the HuC blob.
        lea r10, [rip + _vcsw_huc_blob];
        xor rax, rax;
        xor rcx, rcx;
      vcsw_zero_blob:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vcsw_zero_blob;
        mov rax, 0x0000010046435548;     // 'HUCF' magic + body 0x100
        mov [r10 + 0], rax;
        mov rax, 0xAAAA111100002222;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov rax, 0xBBBB333300004444;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;

        // -- 2. Accessors zero at boot.
        mov rax, 2;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_woken;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_lrc_pa;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_inflight;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_submit_count;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_complete_count;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_wake_seq;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // -- 3. MMIO_NOT_BOUND before gmmio_bind.
        mov rax, 3;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_wake;
        mov r11, 0xFFFFF51E;             // MMIO_NOT_BOUND
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 4. Bind gmmio.
        mov rax, 4;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // -- 5. LRC bind refusals.
        mov rax, 5;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        // null LRC pa -> BAD_ARG.
        mov rdi, 0;
        mov rsi, 0x8000;
        call vcs_bind_lrc;
        mov r11, 0xFFFFF51F;             // BAD_ARG
        cmp rax, r11;
        jne vcsw_fail_stage;

        // Wrong size -> BAD_ARG.
        mov rdi, 0x200000;
        mov rsi, 0x4000;                 // != 32 KiB
        call vcs_bind_lrc;
        mov r11, 0xFFFFF51F;
        cmp rax, r11;
        jne vcsw_fail_stage;

        // Still not woken.
        call vcs_woken;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // -- 6. LRC bind happy + accessor.
        mov rax, 6;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        mov rdi, 0x200000;
        mov rsi, 0x8000;
        call vcs_bind_lrc;
        cmp rax, 0;
        jne vcsw_fail_stage;

        call vcs_lrc_pa;
        mov r11, 0x200000;
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 7. wake — happy path.
        mov rax, 7;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_wake;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_woken;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // RING_CTL saw ENABLE|VALID = 3.
        mov rdi, 0xC080;
        call gmmio_read32;
        cmp rax, 3;
        jne vcsw_fail_stage;

        // MI_MODE saw 0 (STOP_RING cleared).
        mov rdi, 0xC084;
        call gmmio_read32;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // wake_seq bumped to 1.
        call vcs_wake_seq;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // -- 8. ALREADY_WOKEN.
        mov rax, 8;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_wake;
        mov r11, 0xFFFFF51B;             // ALREADY_WOKEN
        cmp rax, r11;
        jne vcsw_fail_stage;

        // Rebind refused while woken.
        mov rdi, 0x300000;
        mov rsi, 0x8000;
        call vcs_bind_lrc;
        mov r11, 0xFFFFF51B;
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 9. HuC_NOT_READY on submit_begin.
        mov rax, 9;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        // Ensure HuC has not been loaded.
        call hucl_accepted;
        cmp rax, 0;
        jne vcsw_fail_stage;

        mov rdi, 5;                      // submit_row_id
        call vcs_submit_begin;
        mov r11, 0xFFFFF518;             // HUC_NOT_READY
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 10. Load HuC then submit_begin OK.
        mov rax, 10;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _vcsw_huc_blob];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        cmp rax, 0;
        jne vcsw_fail_stage;

        mov rdi, 5;
        call vcs_submit_begin;
        cmp rax, 0;
        jne vcsw_fail_stage;

        call vcs_inflight;
        cmp rax, 1;
        jne vcsw_fail_stage;

        call vcs_submit_count;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // -- 11. Second submit_begin -> QUEUE_BUSY.
        mov rax, 11;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        call vcs_submit_begin;
        mov r11, 0xFFFFF51A;             // QUEUE_BUSY
        cmp rax, r11;
        jne vcsw_fail_stage;

        // sleep refused with in-flight submit.
        call vcs_sleep;
        mov r11, 0xFFFFF51A;
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 12. submit_finish returns row_id, clears inflight.
        mov rax, 12;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_submit_finish;
        cmp rax, 5;
        jne vcsw_fail_stage;

        call vcs_inflight;
        cmp rax, 0;
        jne vcsw_fail_stage;

        call vcs_complete_count;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // -- 13. QUEUE_IDLE on second submit_finish.
        mov rax, 13;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_submit_finish;
        mov r11, 0xFFFFF519;             // QUEUE_IDLE
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 14. sleep succeeds after drain.
        mov rax, 14;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_sleep;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_woken;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // MI_MODE saw STOP_RING = 1.
        mov rdi, 0xC084;
        call gmmio_read32;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // RING_CTL saw 0.
        mov rdi, 0xC080;
        call gmmio_read32;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // NOT_WOKEN on second sleep.
        call vcs_sleep;
        mov r11, 0xFFFFF51C;             // NOT_WOKEN
        cmp rax, r11;
        jne vcsw_fail_stage;

        // -- 15. wake_seq monotonic across a second wake.
        mov rax, 15;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        call vcs_wake;
        cmp rax, 0;
        jne vcsw_fail_stage;
        call vcs_wake_seq;
        cmp rax, 2;
        jne vcsw_fail_stage;

        // -- 16. Counter fanout.
        mov rax, 16;
        lea rcx, [rip + _vcsw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // WAKES
        call vcs_stat;
        cmp rax, 2;
        jne vcsw_fail_stage;
        mov rdi, 1;                      // SLEEPS
        call vcs_stat;
        cmp rax, 1;
        jne vcsw_fail_stage;
        mov rdi, 2;                      // SUBMITS
        call vcs_stat;
        cmp rax, 1;
        jne vcsw_fail_stage;
        mov rdi, 3;                      // COMPLETES
        call vcs_stat;
        cmp rax, 1;
        jne vcsw_fail_stage;

        // Arbitration pin.
        call vcs_arbitrated;
        cmp rax, 0;
        jne vcsw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vcsw_ok];
        call klog_s1;

        call vcs_engine_reset;
        call huc_load_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp vcsw_out;

      vcsw_fail_stage:
        lea rax, [rip + _vcsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vcsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vcs_engine_reset;
        call huc_load_reset;
        call gmmio_reset;
        mov rax, 1;

      vcsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
