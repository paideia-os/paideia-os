// tests/kernel/drivers/gpu/bo_alloc_synth.pdx — R37.M3-002 (#1263)
//
// Boot witness for the GPU BO slab allocator.
//
// Asserts class-size lookups, size-to-class rounding (including
// round-up bump), per-class free-list scan, ENOSPC at class
// exhaustion, and free / re-alloc round-trip.
//
// Fingerprint: R37 GPU BO ALLOC OK

module BoAllocSynth = structure {

  pub let mut _boaw_stage : u64 = 0

  pub let boaw_ok   : [u8; 18] = "GPU BO ALLOC OK\0"
  pub let boaw_fail : [u8; 20] = "GPU BO ALLOC FAIL\0"

  pub let boaw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-002 (#1263): reset BO allocator pool + stats.",
      block: {
        call bo_alloc_reset;
        ret
      }
    }

  pub let bo_alloc_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M3-002 (#1263): boot witness. Stages: (1) class-size lookups. (2) size-to-class rounding. (3) alloc happy path. (4) memory_slot=0 refused. (5) bad class refused. (6) ENOSPC at class exhaustion. (7) free round-trip. (8) row accessors.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        call boaw_scrub;

        // -- 1. Class-size lookups.
        mov rdi, 0;
        call boa_class_size;
        mov r11, 0x1000;
        cmp rax, r11;
        jne boaw_fail_stage;
        mov rdi, 5;
        call boa_class_size;
        mov r11, 0x400000;
        cmp rax, r11;
        jne boaw_fail_stage;
        mov rdi, 6;                      // bad
        call boa_class_size;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 2. Size-to-class rounding.
        mov rax, 2;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 4096;                   // exact 4K -> class 0
        call boa_size_to_class;
        cmp rax, 0;
        jne boaw_fail_stage;
        mov rdi, 5000;                   // 5K -> class 1 (16K)
        call boa_size_to_class;
        cmp rax, 1;
        jne boaw_fail_stage;
        mov rdi, 0x400000;               // 4M -> class 5
        call boa_size_to_class;
        cmp rax, 5;
        jne boaw_fail_stage;
        mov rdi, 0x400001;               // > 4M refused
        call boa_size_to_class;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne boaw_fail_stage;
        mov rdi, 0;                      // 0 refused
        call boa_size_to_class;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 3. Alloc happy path.
        mov rax, 3;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // class 64K
        mov rsi, 100;                    // memory_slot
        call boa_alloc;
        // First slab of class 2 = index 16.
        cmp rax, 16;
        jne boaw_fail_stage;

        // -- 4. memory_slot=0 refused.
        mov rax, 4;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;                      // BAD memory
        call boa_alloc;
        mov r11, 0xFFFFF639;             // NO_MEMORY
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 5. Bad class refused.
        mov rax, 5;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 6;                      // BAD class
        mov rsi, 100;
        call boa_alloc;
        mov r11, 0xFFFFF63D;             // BAD_CLASS
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 6. ENOSPC at class exhaustion.
        mov rax, 6;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        // Class 2 already has slot 16 in use; alloc 7 more to fill.
        xor rbx, rbx;
      boaw_fill:
        cmp rbx, 7;
        jae boaw_fill_done;
        mov rdi, 2;
        mov rsi, 200;
        call boa_alloc;
        // Each should succeed (slots 17..23).
        cmp rax, 24;
        jae boaw_fail_stage;
        add rbx, 1;
        jmp boaw_fill;
      boaw_fill_done:

        // Class 2 now full; next alloc must ENOSPC.
        mov rdi, 2;
        mov rsi, 300;
        call boa_alloc;
        mov r11, 0xFFFFF63C;             // ENOSPC
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 7. Free round-trip.
        mov rax, 7;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 16;                     // free slab 16
        call boa_free;
        cmp rax, 0;
        jne boaw_fail_stage;

        // Now alloc again; must land back at 16.
        mov rdi, 2;
        mov rsi, 400;
        call boa_alloc;
        cmp rax, 16;
        jne boaw_fail_stage;

        // Free already-free must fail.
        mov rdi, 47;
        call boa_free;
        mov r11, 0xFFFFF63B;             // FREE_ALREADY
        cmp rax, r11;
        jne boaw_fail_stage;

        // Free out-of-range must fail.
        mov rdi, 48;
        call boa_free;
        mov r11, 0xFFFFF63A;             // BAD_SLAB_ID
        cmp rax, r11;
        jne boaw_fail_stage;

        // -- 8. Row accessors.
        mov rax, 8;
        lea rcx, [rip + _boaw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        call boa_slab_valid;
        cmp rax, 1;
        jne boaw_fail_stage;

        mov rdi, 16;
        call boa_slab_class;
        cmp rax, 2;
        jne boaw_fail_stage;

        mov rdi, 16;
        call boa_slab_memory;
        cmp rax, 400;
        jne boaw_fail_stage;

        mov rdi, 16;
        call boa_slab_size;
        mov r11, 0x10000;                // 64K
        cmp rax, r11;
        jne boaw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + boaw_ok];
        call klog_s1;

        call boaw_scrub;
        xor rax, rax;
        jmp boaw_out;

      boaw_fail_stage:
        lea rax, [rip + _boaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + boaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call boaw_scrub;
        mov rax, 1;

      boaw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
