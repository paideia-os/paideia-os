// tests/kernel/drivers/gpu/ppgtt_walker_synth.pdx — R37.M4-002 (#1268)
//
// Boot witness for the PPGTT 4-level walker.
//
// Asserts va decomposition (9-bit slices per level), session
// open/close, duplicate-open refusal, translate happy path against a
// caller-supplied mock walk table, NOT_PRESENT short-circuit, and
// shootdown sequence bump.
//
// Fingerprint: R37 PPGTT WALKER OK

module PpgttWalkerSynth = structure {

  pub let mut _pptww_stage : u64 = 0

  pub let pptww_ok   : [u8; 18] = "PPGTT WALKER OK\n\0"
  pub let pptww_fail : [u8; 20] = "PPGTT WALKER FAIL\n\0"

  // Four mock level tables (PML4, PDPT, PD, PT), 4 entries each.
  // A "present" leaf PTE = frame_pa | 0x1.  A "present" inner PTE
  // = 0x1 (payload is unused by the mock walker).
  pub let mut _pptww_pml4 : [u64; 4] = uninit @align(64)
  pub let mut _pptww_pdpt : [u64; 4] = uninit @align(64)
  pub let mut _pptww_pd   : [u64; 4] = uninit @align(64)
  pub let mut _pptww_pt   : [u64; 4] = uninit @align(64)

  // [PML4 base, PDPT base, PD base, PT base]
  pub let mut _pptww_table : [u64; 4] = uninit @align(64)

  pub let pptww_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-002 (#1268): reset walker sessions + counters + mock tables.",
      block: {
        call ppgtt_walker_reset;

        xor rax, rax;
        lea r10, [rip + _pptww_pml4];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _pptww_pdpt];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _pptww_pd];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _pptww_pt];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _pptww_table];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        ret
      }
    }

  pub let ppgtt_walker_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M4-002 (#1268): boot witness. Stages: (1) va decomposition. (2) va validator. (3) open + duplicate refusal. (4) translate happy path. (5) NOT_PRESENT short-circuit. (6) shootdown sequence.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        call pptww_scrub;

        // -- 1. va decomposition.
        // va = 0x0000_1234_5678_9000 (arbitrary aligned).
        // Actually easier: va = (idx3 << 39) | (idx2 << 30) | (idx1 << 21) | (idx0 << 12).
        // We pick indices reduced mod 4 so each maps to a mock slot 0..3.
        //   idx3=0, idx2=1, idx1=2, idx0=3.
        // va = (0<<39) | (1<<30) | (2<<21) | (3<<12)
        //    = 0x40400000 | 0x00003000 = 0x40403000
        mov r15, 0x40403000;

        mov rdi, r15;
        mov rsi, 0;                      // PT level
        call pptw_va_index;
        cmp rax, 3;
        jne pptww_fail_stage;

        mov rdi, r15;
        mov rsi, 1;                      // PD level
        call pptw_va_index;
        cmp rax, 2;
        jne pptww_fail_stage;

        mov rdi, r15;
        mov rsi, 2;                      // PDPT level
        call pptw_va_index;
        cmp rax, 1;
        jne pptww_fail_stage;

        mov rdi, r15;
        mov rsi, 3;                      // PML4 level
        call pptw_va_index;
        cmp rax, 0;
        jne pptww_fail_stage;

        // -- 2. va validator.
        mov rax, 2;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        call pptw_va_valid;
        cmp rax, 1;
        jne pptww_fail_stage;
        mov rdi, 0x1001;
        call pptw_va_valid;
        cmp rax, 0;
        jne pptww_fail_stage;

        // -- 3. open + duplicate refusal.
        mov rax, 3;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        mov rdi, 5;                      // vm_row_id
        mov rsi, 0x100000;               // pml4_pa
        call pptw_open;
        cmp rax, 0;                      // first session id = 0
        jne pptww_fail_stage;

        // Duplicate open for same vm_row_id.
        mov rdi, 5;
        mov rsi, 0x100000;
        call pptw_open;
        mov r11, 0xFFFFF5E8;             // ALREADY_OPEN
        cmp rax, r11;
        jne pptww_fail_stage;

        // -- 4. translate happy path.
        mov rax, 4;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        // Populate mock tables.
        //   pml4[idx=0] = present, no pa needed.
        //   pdpt[idx=1] = present.
        //   pd  [idx=2] = present.
        //   pt  [idx=3] = 0x200000 | 0x1 (leaf, frame 0x200000).
        lea r10, [rip + _pptww_pml4];
        mov rax, 0x1;
        mov [r10 + 0], rax;

        lea r10, [rip + _pptww_pdpt];
        mov rax, 0x1;
        mov [r10 + 8], rax;              // idx 1 * 8

        lea r10, [rip + _pptww_pd];
        mov rax, 0x1;
        mov [r10 + 16], rax;             // idx 2 * 8

        lea r10, [rip + _pptww_pt];
        mov rax, 0x200001;
        mov [r10 + 24], rax;             // idx 3 * 8

        // Populate walk table.
        lea r10, [rip + _pptww_table];
        lea r11, [rip + _pptww_pml4];
        mov [r10 + 0], r11;
        lea r11, [rip + _pptww_pdpt];
        mov [r10 + 8], r11;
        lea r11, [rip + _pptww_pd];
        mov [r10 + 16], r11;
        lea r11, [rip + _pptww_pt];
        mov [r10 + 24], r11;

        mov rdi, 0;                      // sid
        mov rsi, r15;                    // va
        lea rdx, [rip + _pptww_table];
        call pptw_translate;
        mov r11, 0x200000;
        cmp rax, r11;
        jne pptww_fail_stage;

        // -- 5. NOT_PRESENT short-circuit: clear pd[2].
        mov rax, 5;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        lea r10, [rip + _pptww_pd];
        xor rax, rax;
        mov [r10 + 16], rax;

        mov rdi, 0;
        mov rsi, r15;
        lea rdx, [rip + _pptww_table];
        call pptw_translate;
        mov r11, 0xFFFFF5E9;             // NOT_PRESENT
        cmp rax, r11;
        jne pptww_fail_stage;

        // -- 6. shootdown sequence.
        mov rax, 6;
        lea rcx, [rip + _pptww_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pptw_shootdown;
        cmp rax, 1;
        jne pptww_fail_stage;
        mov rdi, 0;
        call pptw_shootdown;
        cmp rax, 2;
        jne pptww_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pptww_ok];
        call klog_s1;

        call pptww_scrub;
        xor rax, rax;
        jmp pptww_out;

      pptww_fail_stage:
        lea rax, [rip + _pptww_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pptww_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pptww_scrub;
        mov rax, 1;

      pptww_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
