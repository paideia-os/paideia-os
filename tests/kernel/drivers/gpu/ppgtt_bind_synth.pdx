// tests/kernel/drivers/gpu/ppgtt_bind_synth.pdx — R37.M4-003 (#1269)
//
// Boot witness for the PPGTT bind / unbind bookkeeping.
//
// Asserts va / span / prot validators, bind happy path, overlap
// detection within a VM, cross-VM non-interference, unbind round-
// trip, and ENOSPC at 16 entries.
//
// Fingerprint: R37 PPGTT BIND OK

module PpgttBindSynth = structure {

  pub let mut _ppgbw_stage : u64 = 0

  pub let ppgbw_ok   : [u8; 20] = "R37 PPGTT BIND OK\n\0"
  pub let ppgbw_fail : [u8; 22] = "R37 PPGTT BIND FAIL\n\0"

  pub let ppgbw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-003 (#1269): reset PPGTT bind table + counters.",
      block: {
        call ppgtt_bind_reset;
        ret
      }
    }

  pub let ppgtt_bind_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M4-003 (#1269): boot witness. Stages: (1) validators. (2) bind happy path. (3) overlap refused. (4) cross-VM non-interference. (5) unbind round-trip. (6) ENOSPC at 16 rows.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        call ppgbw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call ppgb_prot_valid;
        cmp rax, 1;
        jne ppgbw_fail_stage;
        mov rdi, 3;
        call ppgb_prot_valid;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        mov rdi, 0x1000;
        call ppgb_va_valid;
        cmp rax, 1;
        jne ppgbw_fail_stage;
        mov rdi, 0x1001;                 // misaligned
        call ppgb_va_valid;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        mov rdi, 0x1000;
        call ppgb_span_valid;
        cmp rax, 1;
        jne ppgbw_fail_stage;
        mov rdi, 0;
        call ppgb_span_valid;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        // -- 2. Bind happy path (vm=1, bo=10, va=0x2000, span=0x1000, prot=RW).
        mov rax, 2;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 10;
        mov rdx, 0x2000;
        mov rcx, 0x1000;
        mov r8, 1;                       // RW
        call ppgb_bind;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        mov rdi, 0;
        call ppgb_binding_vm;
        cmp rax, 1;
        jne ppgbw_fail_stage;
        mov rdi, 0;
        call ppgb_binding_va;
        mov r11, 0x2000;
        cmp rax, r11;
        jne ppgbw_fail_stage;
        mov rdi, 0;
        call ppgb_binding_span;
        mov r11, 0x1000;
        cmp rax, r11;
        jne ppgbw_fail_stage;
        mov rdi, 0;
        call ppgb_binding_prot;
        cmp rax, 1;
        jne ppgbw_fail_stage;

        // -- 3. Overlap refused (same VM, overlapping range).
        mov rax, 3;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 11;
        mov rdx, 0x2000;
        mov rcx, 0x1000;
        mov r8, 1;
        call ppgb_bind;
        mov r11, 0xFFFFF5DA;             // OVERLAP
        cmp rax, r11;
        jne ppgbw_fail_stage;

        // -- 4. Cross-VM non-interference (vm=2, same va).
        mov rax, 4;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 11;
        mov rdx, 0x2000;
        mov rcx, 0x1000;
        mov r8, 1;
        call ppgb_bind;
        cmp rax, 1;
        jne ppgbw_fail_stage;

        // -- 5. Unbind round-trip.
        mov rax, 5;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ppgb_unbind;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        mov rdi, 0;
        call ppgb_binding_valid;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        // Re-bind (should land back at slot 0 -- low-first scan).
        mov rdi, 1;
        mov rsi, 10;
        mov rdx, 0x3000;
        mov rcx, 0x1000;
        mov r8, 1;
        call ppgb_bind;
        cmp rax, 0;
        jne ppgbw_fail_stage;

        // Double-unbind refused.
        mov rdi, 0;
        call ppgb_unbind;
        cmp rax, 0;
        jne ppgbw_fail_stage;
        mov rdi, 0;
        call ppgb_unbind;
        mov r11, 0xFFFFF5D7;             // UNBIND_ALREADY
        cmp rax, r11;
        jne ppgbw_fail_stage;

        // -- 6. ENOSPC at 16 rows.
        mov rax, 6;
        lea rcx, [rip + _ppgbw_stage];
        mov [rcx], rax;

        call ppgbw_scrub;

        // Fill 16 non-overlapping rows on vm=1.
        xor rbx, rbx;
        mov r12, 0x10000;
      ppgbw_fill:
        cmp rbx, 16;
        jae ppgbw_fill_done;
        mov rdi, 1;
        mov rsi, 10;
        mov rdx, r12;
        mov rcx, 0x1000;
        mov r8, 1;
        call ppgb_bind;
        mov r11, 0xFFFFF5D9;
        cmp rax, r11;
        je  ppgbw_fail_stage;
        add r12, 0x1000;
        add rbx, 1;
        jmp ppgbw_fill;
      ppgbw_fill_done:

        // Next bind must ENOSPC.
        mov rdi, 1;
        mov rsi, 10;
        mov rdx, 0x20000;
        mov rcx, 0x1000;
        mov r8, 1;
        call ppgb_bind;
        mov r11, 0xFFFFF5D9;             // ENOSPC
        cmp rax, r11;
        jne ppgbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ppgbw_ok];
        call klog_s1;

        call ppgbw_scrub;
        xor rax, rax;
        jmp ppgbw_out;

      ppgbw_fail_stage:
        lea rax, [rip + _ppgbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ppgbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ppgbw_scrub;
        mov rax, 1;

      ppgbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
