// tests/kernel/drivers/gpu/huc_load_synth.pdx — R37.M8-001 (#1285)
//
// Boot witness for the HuC firmware loader (dual-sig + WOPCM
// upload + HUC_ACCEPTED handshake).  Asserts NULL / TOO_SMALL /
// BAD_MAGIC / BAD_VENDOR_SIG / BAD_PAIDEIA_SIG refusals, the
// MMIO_NOT_BOUND gate, WOPCM alignment + size refusals, happy
// path with register echoes through gmmio, ALREADY_LOADED
// refusal, and the arbitration honesty pin.
//
// Fingerprint: R37 HUC LOAD OK
//
// Cross-file scrub discipline: every exit calls huc_load_reset +
// gmmio_reset so the next witness inherits a clean state.

module HucLoadSynth = structure {

  pub let mut _huclw_stage : u64 = 0

  pub let huclw_ok   : [u8; 12] = "HUC LOAD OK\n\0"
  pub let huclw_fail : [u8; 14] = "HUC LOAD FAIL\n\0"

  // A well-formed HuC blob: header (0x28 bytes) with 'HUCF' magic
  // and both signature slots populated.  Body is opaque.
  //   [+0]  hdr: magic 'HUCF' (LE 0x46435548) | body_size 0x100
  //   [+8]  vendor_sig[0]
  //   [+16] vendor_sig[1]
  //   [+24] paideia_sig[0]
  //   [+32] paideia_sig[1]
  pub let mut _huclw_blob_ok        : [u64; 8] = uninit @align(64)
  pub let mut _huclw_blob_no_vendor : [u64; 8] = uninit @align(64)
  pub let mut _huclw_blob_no_paideia: [u64; 8] = uninit @align(64)
  pub let mut _huclw_blob_bad_magic : [u64; 8] = uninit @align(64)

  pub let huc_load_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M8-001 (#1285): boot witness. Stages: (1) reset. (2) arbitration pin. (3) NULL_BLOB / TOO_SMALL / BAD_MAGIC / BAD_VENDOR_SIG / BAD_PAIDEIA_SIG refusals. (4) MMIO_NOT_BOUND gate. (5) bind gmmio. (6) WOPCM_MISALIGNED / WOPCM_TOO_SMALL refusals. (7) happy path + row accessors + register echoes. (8) HUC_STATUS.HUC_ACCEPTED asserted. (9) ALREADY_LOADED. (10) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        call huc_load_reset;
        call gmmio_reset;

        // Populate the four blobs.
        // _huclw_blob_ok: valid magic + both sigs non-zero.
        lea r10, [rip + _huclw_blob_ok];
        xor rax, rax;
        xor rcx, rcx;
      huclw_zero_ok:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  huclw_zero_ok;
        mov rax, 0x0000010046435548;     // magic + body_size 0x100
        mov [r10 + 0], rax;
        mov rax, 0x1111222233334444;
        mov [r10 + 8], rax;
        mov rax, 0x5555666677778888;
        mov [r10 + 16], rax;
        mov rax, 0x9999AAAABBBBCCCC;
        mov [r10 + 24], rax;
        mov rax, 0xDDDDEEEEFFFF0000;
        mov [r10 + 32], rax;

        // _huclw_blob_no_vendor: sigs BOTH zero -> BAD_VENDOR_SIG.
        lea r10, [rip + _huclw_blob_no_vendor];
        xor rax, rax;
        xor rcx, rcx;
      huclw_zero_nv:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  huclw_zero_nv;
        mov rax, 0x0000010046435548;
        mov [r10 + 0], rax;
        // paideia sig set so we know refusal was vendor-side.
        mov rax, 0x1111111111111111;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;

        // _huclw_blob_no_paideia: paideia sig zero -> BAD_PAIDEIA_SIG.
        lea r10, [rip + _huclw_blob_no_paideia];
        xor rax, rax;
        xor rcx, rcx;
      huclw_zero_np:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  huclw_zero_np;
        mov rax, 0x0000010046435548;
        mov [r10 + 0], rax;
        mov rax, 0x2222222222222222;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;

        // _huclw_blob_bad_magic: 'HUC?' where '?' != 'F'.
        lea r10, [rip + _huclw_blob_bad_magic];
        xor rax, rax;
        xor rcx, rcx;
      huclw_zero_bm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  huclw_zero_bm;
        mov rax, 0x0000010047435548;     // 'HUCG' — bad magic
        mov [r10 + 0], rax;
        mov rax, 0x3333333333333333;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;

        // -- 2. Arbitration pin.
        mov rax, 2;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;
        call hucl_arbitrated;
        cmp rax, 0;
        jne huclw_fail_stage;

        // -- 3. Refusal fan-out.
        mov rax, 3;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        // 3a. NULL_BLOB.
        mov rdi, 0;
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF52A;             // NULL_BLOB
        cmp rax, r11;
        jne huclw_fail_stage;

        // 3b. TOO_SMALL (blob_len < HDR_SIZE).
        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x20;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF52E;             // TOO_SMALL
        cmp rax, r11;
        jne huclw_fail_stage;

        // 3c. BAD_MAGIC.
        lea rdi, [rip + _huclw_blob_bad_magic];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF52D;             // BAD_MAGIC
        cmp rax, r11;
        jne huclw_fail_stage;

        // 3d. BAD_VENDOR_SIG.
        lea rdi, [rip + _huclw_blob_no_vendor];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF52C;             // BAD_VENDOR_SIG
        cmp rax, r11;
        jne huclw_fail_stage;

        // 3e. BAD_PAIDEIA_SIG.
        lea rdi, [rip + _huclw_blob_no_paideia];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF52B;             // BAD_PAIDEIA_SIG
        cmp rax, r11;
        jne huclw_fail_stage;

        // -- 4. MMIO_NOT_BOUND with a valid blob.
        mov rax, 4;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF529;             // MMIO_NOT_BOUND
        cmp rax, r11;
        jne huclw_fail_stage;

        // -- 5. Bind gmmio.
        mov rax, 5;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne huclw_fail_stage;

        // -- 6. WOPCM_MISALIGNED and WOPCM_TOO_SMALL.
        mov rax, 6;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        // WOPCM_MISALIGNED: 32 KiB aligned base (not 64 KiB).
        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x40;
        mov rdx, 0x108000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF528;             // WOPCM_MISALIGNED
        cmp rax, r11;
        jne huclw_fail_stage;

        // Validator agreement.
        mov rdi, 0x108000;
        call hucl_wopcm_aligned;
        cmp rax, 0;
        jne huclw_fail_stage;
        mov rdi, 0x100000;
        call hucl_wopcm_aligned;
        cmp rax, 1;
        jne huclw_fail_stage;

        // WOPCM_TOO_SMALL: 256 KiB (below the 512 KiB floor).
        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x40000;
        call hucl_load;
        mov r11, 0xFFFFF527;             // WOPCM_TOO_SMALL
        cmp rax, r11;
        jne huclw_fail_stage;

        mov rdi, 0x80000;
        call hucl_wopcm_size_ok;
        cmp rax, 1;
        jne huclw_fail_stage;
        mov rdi, 0x40000;
        call hucl_wopcm_size_ok;
        cmp rax, 0;
        jne huclw_fail_stage;

        // -- 7. Happy path + register echoes.
        mov rax, 7;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        cmp rax, 0;
        jne huclw_fail_stage;

        call hucl_accepted;
        cmp rax, 1;
        jne huclw_fail_stage;

        call hucl_wopcm_base_of;
        mov r11, 0x100000;
        cmp rax, r11;
        jne huclw_fail_stage;

        call hucl_wopcm_size_of;
        mov r11, 0x80000;
        cmp rax, r11;
        jne huclw_fail_stage;

        // WOPCM_BASE register: (0x100000 >> 16) | 1 = 0x10 | 1 = 0x11.
        mov rdi, 0xC060;
        call gmmio_read32;
        cmp rax, 0x11;
        jne huclw_fail_stage;

        // WOPCM_SIZE register: (0x80000 >> 12) = 0x80.
        mov rdi, 0xC064;
        call gmmio_read32;
        cmp rax, 0x80;
        jne huclw_fail_stage;

        // HUC_CTL register saw the KICK write.
        mov rdi, 0xC068;
        call gmmio_read32;
        cmp rax, 1;
        jne huclw_fail_stage;

        // -- 8. HUC_STATUS.HUC_ACCEPTED asserted by the handshake.
        mov rax, 8;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        mov rdi, 0xC06C;
        call gmmio_read32;
        cmp rax, 1;
        jne huclw_fail_stage;

        // -- 9. ALREADY_LOADED.
        mov rax, 9;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _huclw_blob_ok];
        mov rsi, 0x40;
        mov rdx, 0x100000;
        mov rcx, 0x80000;
        call hucl_load;
        mov r11, 0xFFFFF525;             // ALREADY_LOADED
        cmp rax, r11;
        jne huclw_fail_stage;

        // -- 10. Stat fanout.
        mov rax, 10;
        lea rcx, [rip + _huclw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // LOADS
        call hucl_stat;
        cmp rax, 1;
        jne huclw_fail_stage;

        mov rdi, 1;                      // ACCEPTS
        call hucl_stat;
        cmp rax, 1;
        jne huclw_fail_stage;

        mov rdi, 2;                      // VENDOR_MISS
        call hucl_stat;
        cmp rax, 1;
        jne huclw_fail_stage;

        mov rdi, 3;                      // PAIDEIA_MISS
        call hucl_stat;
        cmp rax, 1;
        jne huclw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + huclw_ok];
        call klog_s1;

        call huc_load_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp huclw_out;

      huclw_fail_stage:
        lea rax, [rip + _huclw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + huclw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call huc_load_reset;
        call gmmio_reset;
        mov rax, 1;

      huclw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
