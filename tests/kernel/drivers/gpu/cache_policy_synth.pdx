// tests/kernel/drivers/gpu/cache_policy_synth.pdx — R37.M3-004 (#1265)
//
// Boot witness for GPU cache-policy classifier.
//
// Asserts per-policy MOCS index mapping, coherency-domain
// classification, and refusal on out-of-range policy.
//
// Fingerprint: R37 GPU CACHE POLICY OK

module CachePolicySynth = structure {

  pub let mut _cpolw_stage : u64 = 0

  pub let cpolw_ok   : [u8; 25] = "R37 GPU CACHE POLICY OK\n\0"
  pub let cpolw_fail : [u8; 27] = "R37 GPU CACHE POLICY FAIL\n\0"

  pub let cpolw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-004 (#1265): reset cache policy counters.",
      block: {
        call cache_policy_reset;
        ret
      }
    }

  pub let cache_policy_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M3-004 (#1265): boot witness. Stages: (1) validator. (2) MOCS mapping WB/WT/UC/WC. (3) coherency-domain mapping. (4) refusal on bad policy.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _cpolw_stage];
        mov [rcx], rax;

        call cpolw_scrub;

        // -- 1. Validator.
        mov rdi, 0;
        call cpol_valid;
        cmp rax, 1;
        jne cpolw_fail_stage;
        mov rdi, 3;
        call cpol_valid;
        cmp rax, 1;
        jne cpolw_fail_stage;
        mov rdi, 4;
        call cpol_valid;
        cmp rax, 0;
        jne cpolw_fail_stage;

        // -- 2. MOCS index mapping.
        mov rax, 2;
        lea rcx, [rip + _cpolw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // WB -> 2
        call cpol_mocs_index;
        cmp rax, 2;
        jne cpolw_fail_stage;

        mov rdi, 1;                      // WT -> 3
        call cpol_mocs_index;
        cmp rax, 3;
        jne cpolw_fail_stage;

        mov rdi, 2;                      // UC -> 0
        call cpol_mocs_index;
        cmp rax, 0;
        jne cpolw_fail_stage;

        mov rdi, 3;                      // WC -> 1
        call cpol_mocs_index;
        cmp rax, 1;
        jne cpolw_fail_stage;

        // -- 3. Coherency-domain mapping.
        mov rax, 3;
        lea rcx, [rip + _cpolw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // WB -> CPU
        call cpol_coherency_domain;
        cmp rax, 0;
        jne cpolw_fail_stage;

        mov rdi, 1;                      // WT -> CPU
        call cpol_coherency_domain;
        cmp rax, 0;
        jne cpolw_fail_stage;

        mov rdi, 2;                      // UC -> NONE
        call cpol_coherency_domain;
        cmp rax, 2;
        jne cpolw_fail_stage;

        mov rdi, 3;                      // WC -> GPU
        call cpol_coherency_domain;
        cmp rax, 1;
        jne cpolw_fail_stage;

        // -- 4. Refusals.
        mov rax, 4;
        lea rcx, [rip + _cpolw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // bad policy
        call cpol_mocs_index;
        mov r11, 0xFFFFF61F;             // CPOL_BAD_POLICY (#1613)
        cmp rax, r11;
        jne cpolw_fail_stage;

        mov rdi, 5;                      // bad policy
        call cpol_coherency_domain;
        mov r11, 0xFFFFF61F;             // CPOL_BAD_POLICY (#1613)
        cmp rax, r11;
        jne cpolw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cpolw_ok];
        call klog_s1;

        call cpolw_scrub;
        xor rax, rax;
        jmp cpolw_out;

      cpolw_fail_stage:
        lea rax, [rip + _cpolw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cpolw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call cpolw_scrub;
        mov rax, 1;

      cpolw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
