// tests/kernel/drivers/gpu/tiling_synth.pdx — R37.M3-003 (#1264)
//
// Boot witness for tiling-format encoders.
//
// Asserts per-format tile-shape lookups, tiles-per-row rounding,
// LINEAR identity transform, and tiled-offset arithmetic for one
// (x, y) in each of the four tiled formats.
//
// Fingerprint: R37 GPU TILING OK

module TilingSynth = structure {

  pub let mut _tilw_stage : u64 = 0

  pub let tilw_ok   : [u8; 19] = "R37 GPU TILING OK\n\0"
  pub let tilw_fail : [u8; 21] = "R37 GPU TILING FAIL\n\0"

  pub let tilw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-003 (#1264): reset tiling counters.",
      block: {
        call tiling_reset;
        ret
      }
    }

  pub let tiling_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M3-003 (#1264): boot witness. Stages: (1) format validator. (2) tile-shape lookups. (3) tiles-per-row. (4) LINEAR identity. (5) X-tiled arithmetic. (6) Y-tiled arithmetic. (7) Tile4 arithmetic. (8) TileF arithmetic. (9) BAD_STRIDE / BAD_DIM refusals.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        call tilw_scrub;

        // -- 1. Format validator.
        mov rdi, 0;
        call til_fmt_valid;
        cmp rax, 1;
        jne tilw_fail_stage;
        mov rdi, 4;
        call til_fmt_valid;
        cmp rax, 1;
        jne tilw_fail_stage;
        mov rdi, 5;
        call til_fmt_valid;
        cmp rax, 0;
        jne tilw_fail_stage;

        // -- 2. Tile-shape lookups.
        mov rax, 2;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call til_tile_width;
        cmp rax, 1;
        jne tilw_fail_stage;
        mov rdi, 1;
        call til_tile_width;
        cmp rax, 512;
        jne tilw_fail_stage;
        mov rdi, 2;
        call til_tile_width;
        cmp rax, 128;
        jne tilw_fail_stage;
        mov rdi, 3;
        call til_tile_width;
        cmp rax, 64;
        jne tilw_fail_stage;
        mov rdi, 4;
        call til_tile_width;
        cmp rax, 256;
        jne tilw_fail_stage;

        mov rdi, 1;
        call til_tile_height;
        cmp rax, 8;
        jne tilw_fail_stage;
        mov rdi, 2;
        call til_tile_height;
        cmp rax, 32;
        jne tilw_fail_stage;
        mov rdi, 3;
        call til_tile_height;
        cmp rax, 64;
        jne tilw_fail_stage;
        mov rdi, 4;
        call til_tile_height;
        cmp rax, 64;
        jne tilw_fail_stage;

        // -- 3. tiles_per_row.
        mov rax, 3;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        // X-tiled, stride 1024 bytes -> ceil(1024/512) = 2.
        mov rdi, 1;
        mov rsi, 1024;
        call til_tiles_per_row;
        cmp rax, 2;
        jne tilw_fail_stage;

        // X-tiled, stride 513 -> ceil(513/512) = 2.
        mov rdi, 1;
        mov rsi, 513;
        call til_tiles_per_row;
        cmp rax, 2;
        jne tilw_fail_stage;

        // -- 4. LINEAR identity: y*stride + x.
        mov rax, 4;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // fmt LINEAR
        mov rsi, 100;                    // x_bytes
        mov rdx, 3;                      // y
        mov rcx, 1024;                   // stride
        call til_encode;
        // 3 * 1024 + 100 = 3172
        cmp rax, 3172;
        jne tilw_fail_stage;

        // -- 5. X-tiled.
        // stride 1024, x_bytes 100, y 3. tile_w=512, tile_h=8.
        // tile_x = 0, intra_x = 100.
        // tile_y = 0, intra_y = 3.
        // tpr = 2. tile_size = 4096.
        // base_row = 0. base_tile = 0. intra = 3*512 + 100 = 1636.
        mov rax, 5;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 100;
        mov rdx, 3;
        mov rcx, 1024;
        call til_encode;
        cmp rax, 1636;
        jne tilw_fail_stage;

        // -- 6. Y-tiled.
        // stride 1024, x_bytes 130, y 5. tile_w=128, tile_h=32.
        // tile_x = 1, intra_x = 2.
        // tile_y = 0, intra_y = 5.
        // tpr = 8. tile_size = 4096.
        // base_row = 0.
        // base_tile = 1 * 4096 = 4096.
        // intra = 5*128 + 2 = 642.
        // total = 4738.
        mov rax, 6;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 130;
        mov rdx, 5;
        mov rcx, 1024;
        call til_encode;
        cmp rax, 4738;
        jne tilw_fail_stage;

        // -- 7. Tile4.
        // stride 512, x_bytes 70, y 3. tile_w=64, tile_h=64.
        // tile_x = 1, intra_x = 6.
        // tile_y = 0, intra_y = 3.
        // tpr = 8. tile_size = 4096.
        // base_row = 0.
        // base_tile = 1 * 4096 = 4096.
        // intra = 3*64 + 6 = 198.
        // total = 4294.
        mov rax, 7;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 70;
        mov rdx, 3;
        mov rcx, 512;
        call til_encode;
        cmp rax, 4294;
        jne tilw_fail_stage;

        // -- 8. TileF.
        // stride 512, x_bytes 260, y 2. tile_w=256, tile_h=64.
        // tile_x = 1, intra_x = 4.
        // tile_y = 0, intra_y = 2.
        // tpr = 2. tile_size = 16384.
        // base_row = 0.
        // base_tile = 1 * 16384 = 16384.
        // intra = 2*256 + 4 = 516.
        // total = 16900.
        mov rax, 8;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 260;
        mov rdx, 2;
        mov rcx, 512;
        call til_encode;
        cmp rax, 16900;
        jne tilw_fail_stage;

        // -- 9. Refusals.
        mov rax, 9;
        lea rcx, [rip + _tilw_stage];
        mov [rcx], rax;

        mov rdi, 5;                      // BAD fmt
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 1024;
        call til_encode;
        mov r11, 0xFFFFF62F;             // BAD_FMT
        cmp rax, r11;
        jne tilw_fail_stage;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;                      // BAD stride
        call til_encode;
        mov r11, 0xFFFFF62D;             // BAD_STRIDE
        cmp rax, r11;
        jne tilw_fail_stage;

        mov rdi, 0;
        mov rsi, 1024;                   // x_bytes == stride
        mov rdx, 0;
        mov rcx, 1024;
        call til_encode;
        mov r11, 0xFFFFF62E;             // BAD_DIM
        cmp rax, r11;
        jne tilw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tilw_ok];
        call klog_s1;

        call tilw_scrub;
        xor rax, rax;
        jmp tilw_out;

      tilw_fail_stage:
        lea rax, [rip + _tilw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tilw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tilw_scrub;
        mov rax, 1;

      tilw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
