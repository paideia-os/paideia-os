// tests/kernel/drivers/gpu/gpu_reg_audit_synth.pdx — R37.M1-004 (#1256)
//
// Boot witness for gpu_reg_audit. Asserts denylist priority over
// whitelist, whitelist range acceptance, guarded-write funnel through
// gmmio, ring push/wrap behaviour, and the arbitration honesty pin.
//
// Fingerprint: R37 GPU REG AUDIT OK

module GpuRegAuditSynth = structure {

  pub let mut _graudw_stage : u64 = 0

  pub let graudw_ok   : [u8; 18] = "GPU REG AUDIT OK\0"
  pub let graudw_fail : [u8; 20] = "GPU REG AUDIT FAIL\0"

  pub let gpu_reg_audit_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M1-004 (#1256): boot witness. Stages: (1) reset both modules + arbitration pin. (2) denylist matches: FUSE_STRAP, HUC_AUTH, HUC_STATUS2, DIE_ID, PAVP_CTL. (3) whitelist matches: GT reset, RESET_CTL, CDCLK, general shadow. (4) MMIO_REFUSED before gmmio_bind. (5) bind gmmio. (6) guarded-write accept -> record accept + funnel through gmmio (readback via gmmio_read32). (7) guarded-write deny -> record deny, gmmio untouched. (8) ring wrap after >256 pushes: seq keeps counting, head wraps to 0. (9) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        call graud_reset;
        call gmmio_reset;

        call graud_arbitrated;
        cmp rax, 0;
        jne graudw_fail_stage;

        // -- 2. Denylist matches (§2).
        mov rax, 2;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0x42014;                // FUSE_STRAP
        call graud_is_denied;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0xC0224;                // HUC_AUTH
        call graud_is_denied;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0xD3B94;                // HUC_STATUS2
        call graud_is_denied;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x9120;                 // DIE_ID
        call graud_is_denied;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x68800;                // PAVP_CTL
        call graud_is_denied;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x100;                  // benign
        call graud_is_denied;
        cmp rax, 0;
        jne graudw_fail_stage;

        // -- 3. Whitelist matches (§1).
        mov rax, 3;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0x941C;                 // GDRST
        call graud_is_safe;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0xD00;                  // RESET_CTL[0]
        call graud_is_safe;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x46000;                // CDCLK_CTL
        call graud_is_safe;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x100;                  // general shadow
        call graud_is_safe;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0x80000;                // outside any range
        call graud_is_safe;
        cmp rax, 0;
        jne graudw_fail_stage;

        // -- 4. MMIO_REFUSED before gmmio_bind.
        mov rax, 4;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0x941C;
        mov rsi, 1;
        call graud_write_guarded;
        mov r11, 0xFFFFF68C;             // MMIO_REFUSED
        cmp rax, r11;
        jne graudw_fail_stage;

        // -- 5. Bind gmmio.
        mov rax, 5;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne graudw_fail_stage;

        call graud_reset;                // scrub deny record from stage 4

        // -- 6. Guarded-write accept + funnel.
        mov rax, 6;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0x941C;                 // GDRST
        mov rsi, 0x1;                    // GRDOM_FULL
        call graud_write_guarded;
        cmp rax, 0;
        jne graudw_fail_stage;

        // gmmio saw it.
        mov rdi, 0x941C;
        call gmmio_read32;
        cmp rax, 1;
        jne graudw_fail_stage;

        // Ring recorded accept.
        call graud_seq_of;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0;                      // slot 0
        mov rsi, 0;                      // seq field
        call graud_entry_field;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0;
        mov rsi, 1;                      // offset field
        call graud_entry_field;
        mov r11, 0x941C;
        cmp rax, r11;
        jne graudw_fail_stage;

        mov rdi, 0;
        mov rsi, 2;                      // val field
        call graud_entry_field;
        cmp rax, 1;
        jne graudw_fail_stage;

        mov rdi, 0;
        mov rsi, 3;                      // flags field
        call graud_entry_field;
        cmp rax, 0;                      // ACCEPT
        jne graudw_fail_stage;

        // -- 7. Guarded-write deny + gmmio untouched.
        mov rax, 7;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        // First stamp a sentinel at PAVP_CTL through the seam directly
        // (audit rings the direct write in gmmio_stats but not in
        // graud). PAVP_CTL is 0x68800 — safe to gmmio_write32 because
        // gmmio's own range check accepts anything under bar_len.
        mov rdi, 0x68800;
        mov rsi, 0xAAAA5555;
        call gmmio_write32;
        cmp rax, 0;
        jne graudw_fail_stage;

        // Now guarded write should DENY.
        mov rdi, 0x68800;                // PAVP_CTL (denylist)
        mov rsi, 0xDEADBEEF;
        call graud_write_guarded;
        mov r11, 0xFFFFF68E;             // DENIED
        cmp rax, r11;
        jne graudw_fail_stage;

        // Value at 0x68800 unchanged (still 0xAAAA5555).
        mov rdi, 0x68800;
        call gmmio_read32;
        mov r11, 0xAAAA5555;
        cmp rax, r11;
        jne graudw_fail_stage;

        // Ring got a deny record.
        call graud_seq_of;
        cmp rax, 2;
        jne graudw_fail_stage;

        mov rdi, 1;                      // slot 1
        mov rsi, 3;                      // flags field
        call graud_entry_field;
        cmp rax, 1;                      // DENY
        jne graudw_fail_stage;

        // Also deny a write that WOULD hit the whitelist but the
        // denylist bites first: 0x9120 (DIE_ID) is inside the
        // whitelist's [0x9000, 0x9800) but on the denylist.
        mov rdi, 0x9120;
        mov rsi, 0xBADF00D0;
        call graud_write_guarded;
        mov r11, 0xFFFFF68E;
        cmp rax, r11;
        jne graudw_fail_stage;

        // And deny a write that misses BOTH lists.
        mov rdi, 0x80000;
        mov rsi, 0xC0DEC0DE;
        call graud_write_guarded;
        mov r11, 0xFFFFF68E;
        cmp rax, r11;
        jne graudw_fail_stage;

        // -- 8. Ring wrap.
        mov rax, 8;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        // Push 260 more accepted writes (varying offset in the safe
        // shadow so gmmio takes them). After stage 7 we already have
        // seq=4 and head=4; 260 more brings seq=264 and head=(264 %
        // 256)=8.
        mov rbx, 0;
      graudw_wrap_loop:
        cmp rbx, 260;
        jae graudw_wrap_done;
        mov rax, rbx;
        shl rax, 2;                      // 4-byte stride
        and rax, 0x3FFC;                 // keep < 0x4000
        mov rdi, rax;
        mov rsi, rbx;
        call graud_write_guarded;
        cmp rax, 0;
        jne graudw_fail_stage;
        add rbx, 1;
        jmp graudw_wrap_loop;
      graudw_wrap_done:

        call graud_seq_of;
        mov r11, 264;
        cmp rax, r11;
        jne graudw_fail_stage;

        call graud_head_of;
        cmp rax, 8;
        jne graudw_fail_stage;

        // -- 9. Stat fanout.
        mov rax, 9;
        lea rcx, [rip + _graudw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ACCEPTS
        call graud_stat;
        mov r11, 261;                    // stage6 (1) + 260 wrap
        cmp rax, r11;
        jne graudw_fail_stage;

        mov rdi, 1;                      // DENIES
        call graud_stat;
        cmp rax, 3;                      // PAVP + DIE_ID + outside-list
        jne graudw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + graudw_ok];
        call klog_s1;

        call graud_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp graudw_out;

      graudw_fail_stage:
        lea rax, [rip + _graudw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + graudw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call graud_reset;
        call gmmio_reset;
        mov rax, 1;

      graudw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
