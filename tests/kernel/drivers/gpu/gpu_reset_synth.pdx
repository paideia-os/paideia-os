// tests/kernel/drivers/gpu/gpu_reset_synth.pdx — R37.M1-003 (#1255)
//
// Boot witness for gpu_reset. Asserts engine validator, NOT_BOUND
// gates against the gpu_mmio seam, full-GPU reset happy path, per-
// engine reset for RCS/BCS/VCS/VECS, and the counter fanout.
//
// Fingerprint: R37 GPU RESET OK

module GpuResetSynth = structure {

  pub let mut _grstw_stage : u64 = 0

  pub let grstw_ok   : [u8; 14] = "GPU RESET OK\0"
  pub let grstw_fail : [u8; 16] = "GPU RESET FAIL\0"

  pub let gpu_reset_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M1-003 (#1255): boot witness. Stages: (1) reset both modules + arbitration pin. (2) engine validator. (3) NOT_BOUND on both entry points before gmmio_bind. (4) bind gmmio. (5) full-GPU reset happy path + count. (6) engine reset RCS / BCS / VCS / VECS + counts. (7) BAD_ENGINE refusal on engine=4. (8) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        call grst_reset;
        call gmmio_reset;

        call grst_arbitrated;
        cmp rax, 0;
        jne grstw_fail_stage;

        // -- 2. Engine validator.
        mov rax, 2;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call grst_engine_valid;
        cmp rax, 1;
        jne grstw_fail_stage;

        mov rdi, 3;                      // VECS
        call grst_engine_valid;
        cmp rax, 1;
        jne grstw_fail_stage;

        mov rdi, 4;
        call grst_engine_valid;
        cmp rax, 0;
        jne grstw_fail_stage;

        // -- 3. NOT_BOUND before gmmio_bind.
        mov rax, 3;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        call grst_full_gpu_reset;
        mov r11, 0xFFFFF69D;             // NOT_BOUND
        cmp rax, r11;
        jne grstw_fail_stage;

        mov rdi, 0;                      // RCS
        call grst_engine_reset;
        mov r11, 0xFFFFF69D;
        cmp rax, r11;
        jne grstw_fail_stage;

        // -- 4. Bind gmmio.
        mov rax, 4;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne grstw_fail_stage;

        // -- 5. Full-GPU reset happy path.
        mov rax, 5;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        call grst_full_gpu_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        call grst_full_count_of;
        cmp rax, 1;
        jne grstw_fail_stage;

        call grst_full_gpu_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        call grst_full_count_of;
        cmp rax, 2;
        jne grstw_fail_stage;

        // -- 6. Per-engine reset RCS / BCS / VCS / VECS.
        mov rax, 6;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // RCS
        call grst_engine_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        mov rdi, 1;                      // BCS
        call grst_engine_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        mov rdi, 2;                      // VCS
        call grst_engine_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        mov rdi, 3;                      // VECS
        call grst_engine_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        mov rdi, 0;
        call grst_engine_count_of;
        cmp rax, 1;
        jne grstw_fail_stage;

        mov rdi, 3;
        call grst_engine_count_of;
        cmp rax, 1;
        jne grstw_fail_stage;

        // Repeat RCS -> count becomes 2.
        mov rdi, 0;
        call grst_engine_reset;
        cmp rax, 0;
        jne grstw_fail_stage;

        mov rdi, 0;
        call grst_engine_count_of;
        cmp rax, 2;
        jne grstw_fail_stage;

        // -- 7. BAD_ENGINE.
        mov rax, 7;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        call grst_engine_reset;
        mov r11, 0xFFFFF69E;             // BAD_ENGINE
        cmp rax, r11;
        jne grstw_fail_stage;

        mov rdi, 99;
        call grst_engine_reset;
        mov r11, 0xFFFFF69E;
        cmp rax, r11;
        jne grstw_fail_stage;

        // -- 8. Stat fanout.
        mov rax, 8;
        lea rcx, [rip + _grstw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // FULL
        call grst_stat;
        cmp rax, 2;
        jne grstw_fail_stage;

        mov rdi, 1;                      // ENGINE
        call grst_stat;
        cmp rax, 5;                      // RCS + BCS + VCS + VECS + RCS
        jne grstw_fail_stage;

        mov rdi, 2;                      // REFUSED
        call grst_stat;
        cmp rax, 4;                      // NOT_BOUND * 2 + BAD_ENGINE * 2
        jne grstw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + grstw_ok];
        call klog_s1;

        call grst_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp grstw_out;

      grstw_fail_stage:
        lea rax, [rip + _grstw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + grstw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call grst_reset;
        call gmmio_reset;
        mov rax, 1;

      grstw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
