// tests/kernel/drivers/gpu/guc_load_synth.pdx — R37.M2-002 (#1258)
//
// Boot witness for guc_load. Asserts precondition gates
// (NOT_VERIFIED / MMIO_NOT_BOUND), §1 shape refusals (misaligned,
// too-small), happy-path FSM (WOPCM_BASE / WOPCM_SIZE / RESET
// write pair through gmmio), not-already-loaded refusal, and the
// arbitration honesty pin.
//
// Fingerprint: R37 GUC LOAD OK

module GucLoadSynth = structure {

  pub let mut _guclw_stage : u64 = 0

  pub let guclw_ok   : [u8; 13] = "GUC LOAD OK\0"
  pub let guclw_fail : [u8; 15] = "GUC LOAD FAIL\0"

  // Reuse a verified blob shape: minimum header (§1 of guc_verify)
  // with non-empty sig slots so gucv_verify accepts it.
  pub let mut _guclw_blob : [u64; 8] = uninit @align(64)

  pub let guc_load_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R37.M2-002 (#1258): boot witness. Stages: (1) reset all three modules + arbitration pin. (2) NOT_VERIFIED before verify. (3) verify a good blob. (4) MMIO_NOT_BOUND before gmmio_bind. (5) bind gmmio. (6) WOPCM_MISALIGNED. (7) WOPCM_TOO_SMALL. (8) happy path + row accessors + register echoes via gmmio. (9) ALREADY_LOADED. (10) stat fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;

        // Zero + populate the blob (well-formed header + both sig slots).
        lea r10, [rip + _guclw_blob];
        xor rax, rax;
        xor rcx, rcx;
      guclw_zero_blob:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  guclw_zero_blob;

        mov rax, 0x0000010046435547;           // hdr: magic 'GUCF' + body 0x100
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;                    // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;                   // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        call gucl_arbitrated;
        cmp rax, 0;
        jne guclw_fail_stage;

        // -- 2. NOT_VERIFIED before verify.
        mov rax, 2;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;                     // 64 KiB-aligned base
        mov rsi, 0x80000;                      // 512 KiB size
        call gucl_load;
        mov r11, 0xFFFFF66E;                   // NOT_VERIFIED
        cmp rax, r11;
        jne guclw_fail_stage;

        // -- 3. Verify.
        mov rax, 3;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _guclw_blob];
        mov rsi, 0x40;
        call gucv_verify;
        cmp rax, 0;
        jne guclw_fail_stage;

        // -- 4. MMIO_NOT_BOUND before gmmio_bind.
        mov rax, 4;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;
        mov rsi, 0x80000;
        call gucl_load;
        mov r11, 0xFFFFF66D;                   // MMIO_NOT_BOUND
        cmp rax, r11;
        jne guclw_fail_stage;

        // -- 5. Bind gmmio.
        mov rax, 5;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        mov rsi, 0x1000000;
        call gmmio_bind;
        cmp rax, 0;
        jne guclw_fail_stage;

        // -- 6. WOPCM_MISALIGNED.
        mov rax, 6;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x108000;                     // 32 KiB aligned, not 64 KiB
        mov rsi, 0x80000;
        call gucl_load;
        mov r11, 0xFFFFF66C;                   // WOPCM_MISALIGNED
        cmp rax, r11;
        jne guclw_fail_stage;

        // Validator agrees.
        mov rdi, 0x108000;
        call gucl_wopcm_aligned;
        cmp rax, 0;
        jne guclw_fail_stage;
        mov rdi, 0x100000;
        call gucl_wopcm_aligned;
        cmp rax, 1;
        jne guclw_fail_stage;

        // -- 7. WOPCM_TOO_SMALL.
        mov rax, 7;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;
        mov rsi, 0x40000;                      // 256 KiB — below 512 KiB
        call gucl_load;
        mov r11, 0xFFFFF66B;                   // WOPCM_TOO_SMALL
        cmp rax, r11;
        jne guclw_fail_stage;

        // Non-multiple-of-4K also refused.
        mov rdi, 0x100000;
        mov rsi, 0x80800;                      // 4 KiB + 512 KiB, wrong step
        call gucl_load;
        mov r11, 0xFFFFF66B;
        cmp rax, r11;
        jne guclw_fail_stage;

        mov rdi, 0x80000;
        call gucl_wopcm_size_ok;
        cmp rax, 1;
        jne guclw_fail_stage;
        mov rdi, 0x40000;
        call gucl_wopcm_size_ok;
        cmp rax, 0;
        jne guclw_fail_stage;

        // -- 8. Happy path + registers echo.
        mov rax, 8;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;
        mov rsi, 0x80000;
        call gucl_load;
        cmp rax, 0;
        jne guclw_fail_stage;

        call gucl_is_loaded;
        cmp rax, 1;
        jne guclw_fail_stage;

        call gucl_wopcm_base_of;
        mov r11, 0x100000;
        cmp rax, r11;
        jne guclw_fail_stage;

        call gucl_wopcm_size_of;
        mov r11, 0x80000;
        cmp rax, r11;
        jne guclw_fail_stage;

        // WOPCM_BASE register saw (base >> 16) | 1 = 0x10 | 1 = 0x11.
        mov rdi, 0xC020;
        call gmmio_read32;
        cmp rax, 0x11;
        jne guclw_fail_stage;

        // WOPCM_SIZE register saw (size >> 12) = 0x80.
        mov rdi, 0xC024;
        call gmmio_read32;
        cmp rax, 0x80;
        jne guclw_fail_stage;

        // RESET register saw the final RELEASE write (0).
        mov rdi, 0xC028;
        call gmmio_read32;
        cmp rax, 0;
        jne guclw_fail_stage;

        // -- 9. ALREADY_LOADED.
        mov rax, 9;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;
        mov rsi, 0x80000;
        call gucl_load;
        mov r11, 0xFFFFF669;                   // ALREADY_LOADED
        cmp rax, r11;
        jne guclw_fail_stage;

        // -- 10. Stat fanout.
        mov rax, 10;
        lea rcx, [rip + _guclw_stage];
        mov [rcx], rax;

        mov rdi, 0;                            // LOADS
        call gucl_stat;
        cmp rax, 1;
        jne guclw_fail_stage;

        mov rdi, 1;                            // RELEASES
        call gucl_stat;
        cmp rax, 1;
        jne guclw_fail_stage;

        mov rdi, 2;                            // REFUSED
        call gucl_stat;
        // Refusals: NOT_VERIFIED (2), NOT_BOUND (4), MISALIGNED (6),
        // TOO_SMALL (7 twice), ALREADY_LOADED (9) = 6.
        cmp rax, 6;
        jne guclw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + guclw_ok];
        call klog_s1;

        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;
        xor rax, rax;
        jmp guclw_out;

      guclw_fail_stage:
        lea rax, [rip + _guclw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + guclw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gucl_reset;
        call gucv_reset;
        call gmmio_reset;
        mov rax, 1;

      guclw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
