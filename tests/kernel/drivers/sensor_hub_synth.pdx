// tests/kernel/drivers/sensor_hub_synth.pdx — R32.M5-002 (#1134)
//
// Boot witness for src/kernel/core/drivers/sensor_hub.pdx.
//
// Asserts refusal discipline, the honesty pin, and that the three
// mount seams publish through hid_event_stream_publish on the SENSOR
// class bit -- with a real KIND_HID_EVENT subscriber wired to receive
// them so the fanout's per-subscriber delivery count is what the
// witness reads.
//
// Fingerprint: SENSOR HUB OK
//
// Cap slots 140..147.

module SensorHubSynth = structure {

  pub let mut _shub_w_stage : u64 = 0

  pub let shub_w_ok   : [u8; 15] = "SENSOR HUB OK\0"
  pub let shub_w_fail : [u8; 17] = "SENSOR HUB FAIL\0"

  pub let shub_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): clear cap_table slots 140..147. Labels prefixed shub_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 140;
      shub_wc_loop:
        cmp rbx, 148;
        jae shub_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp shub_wc_loop;
      shub_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let shub_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-002 (#1134): reset the hub state, the KIND_SENSOR_CHANNEL rows and the HID event stream subscriber table. Three push, three call.",
      block: {
        push rbx;
        call sensor_hub_reset;
        call sensor_channel_table_reset;
        call hid_event_stream_reset;
        call hid_event_table_reset;
        pop rbx;
        ret
      }
    }

  pub let shub_w_endpoint : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): synthetic KIND_IPC_ENDPOINT with RIGHT_MINT.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let sensor_hub_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R32.M5-002 (#1134): boot witness for sensor_hub. Drives the honesty pin, the bind seam (arity zero), the three sample paths' refusal discipline (BAD_TYPE via the common helper, NOT_BOUND before bind), and the fanout wiring by minting a KIND_HID_EVENT subscription on the SENSOR class bit, subscribing it to the stream, and asserting the three sample paths bump the subscriber's delivered counter. Five-push prologue leaves rsp%16 == 0 at every nested call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        call shub_w_clear;
        call shub_w_scrub;

        // -- 1. Honesty pin: arbitrated == 0.
        call sensor_hub_arbitrated;
        cmp rax, 0;
        jne shub_w_fail_stage;

        // -- 2. Unbound refusal: sample_als before bind -> NOT_BOUND.
        mov rax, 2;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        mov rdi, 100;
        call sensor_hub_sample_als;
        mov r11, 0xFFFFFEDF;             // SENSOR_HUB_NOT_BOUND
        cmp rax, r11;
        jne shub_w_fail_stage;

        // -- 3. Bind, then publish should succeed (zero subscribers).
        mov rax, 3;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        call sensor_hub_bind;
        cmp rax, 0;
        jne shub_w_fail_stage;

        call sensor_hub_bound;
        cmp rax, 1;
        jne shub_w_fail_stage;

        // Zero-subscriber publish returns 0 (match count).
        mov rdi, 100;
        call sensor_hub_sample_als;
        cmp rax, 0;
        jne shub_w_fail_stage;

        // -- 4. Wire a subscriber: mint a KIND_IPC_ENDPOINT parent,
        //       mint a KIND_HID_EVENT subscription on HID_EVT_SENSOR,
        //       subscribe it to the stream.
        mov rax, 4;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        mov rdi, 140;
        mov rsi, 0x61;
        call shub_w_endpoint;

        mov rdi, 141;                    // subject
        mov rsi, 140;                    // parent endpoint
        mov rdx, 0x41B;                  // R_HID_EVENT_ALL
        mov rcx, 0x08;                   // HID_EVT_SENSOR
        mov r8, 42;                      // pid
        call hid_event_cap_mint;
        cmp rax, 0;
        jne shub_w_fail_stage;

        mov rdi, 141;
        call hid_event_stream_subscribe;
        cmp rax, 0;
        jne shub_w_fail_stage;

        // -- 5. All three mount paths deliver to the subscriber.
        mov rax, 5;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        mov rdi, 300;                    // synthetic lux
        call sensor_hub_sample_als;
        cmp rax, 1;                      // one match
        jne shub_w_fail_stage;

        mov rdi, 500;                    // synthetic accel
        call sensor_hub_sample_accel;
        cmp rax, 1;
        jne shub_w_fail_stage;

        mov rdi, 700;                    // synthetic gyro
        call sensor_hub_sample_gyro;
        cmp rax, 1;
        jne shub_w_fail_stage;

        // Delivered count on slot 141 should be 3 (the zero-subscriber
        // publish in stage 3 predates the subscribe, so it does not count).
        mov rdi, 141;
        call hid_event_stream_delivered_by;
        cmp rax, 3;
        jne shub_w_fail_stage;

        // Per-mount counters bumped.
        mov rdi, 1;                      // ST_ALS_SAMPLES
        call sensor_hub_stat;
        cmp rax, 2;                      // one un-matched + one matched
        jne shub_w_fail_stage;
        mov rdi, 2;                      // ST_ACC_SAMPLES
        call sensor_hub_stat;
        cmp rax, 1;
        jne shub_w_fail_stage;
        mov rdi, 3;                      // ST_GYR_SAMPLES
        call sensor_hub_stat;
        cmp rax, 1;
        jne shub_w_fail_stage;

        // -- 6. Payload packer places type in the high byte.
        mov rax, 6;
        lea rcx, [rip + _shub_w_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // ACCEL
        mov rsi, 0x1234;
        call sensor_hub_pack_payload;
        mov r11, rax;
        shr r11, 56;
        cmp r11, 2;
        jne shub_w_fail_stage;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, 0x1234;
        jne shub_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + shub_w_ok];
        call klog_s1;

        call shub_w_scrub;
        call shub_w_clear;
        xor rax, rax;
        jmp shub_w_out;

      shub_w_fail_stage:
        lea rax, [rip + _shub_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + shub_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call shub_w_scrub;
        call shub_w_clear;
        mov rax, 1;

      shub_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
