// tests/kernel/drivers/gpio/gpio_pad_synth.pdx
//   R30.M6-003 (#1077) + R30.M6-004 (#1078)
//
// Boot witness for the GPIO line CHANNEL — get, set, direction, pull,
// edge subscription — and for the pad driver that carries them out.
//
// -----------------------------------------------------------------------------
// Why this fixture is different from the two before it
// -----------------------------------------------------------------------------
//
// #1075's fixture proved a capability names one pin. #1076's proved the
// address path reaches that pin's registers. NEITHER OF THEM WROTE A PAD.
// This one does, and three of its assertions cannot be made by any test
// written against the model #1076 shipped.
//
//   1. READ-MODIFY-WRITE PRESERVATION. Every PADCFG register is seeded
//      with a NON-ZERO BACKGROUND PATTERN before each setter runs, and
//      the assertion is against the WHOLE 32-bit word afterwards, not
//      against the field that changed. A setter that rebuilds the word
//      from the fields it cares about passes every field-wise assertion
//      and fails these. That distinction is invisible on QEMU -- there is
//      no pad controller, so the synthetic cell simply holds whatever was
//      written -- and permanent on silicon, where the bits it drops are
//      interrupt routing, pad mode and vendor configuration.
//
//   2. WRITE-1-TO-CLEAR. Sub-test G asserts that writing 0x20 to a
//      registered W1C register turns 0xFFFFFFFF into 0xFFFFFFDF, and that
//      writing 0 changes nothing. Against a plain cell array the first
//      would yield 0x20 and the second 0. Every interrupt-acknowledgement
//      assertion below rests on this one.
//
//   3. THE STORM BOUND, IN BOTH ARMS. Sub-test I subscribes a line whose
//      status register IS registered W1C and observes exactly one service
//      and no storm; sub-test J subscribes one whose status register is a
//      PLAIN CELL -- which is precisely the behaviour of a status bit that
//      will not clear -- and observes the service budget reached, the
//      storm flag set, and the line MASKED in GPI_IE. Under the plain-cell
//      model both lines storm and the first assertion is unmakeable, which
//      is the whole reason the W1C model lands with this issue and not
//      after it.
//
// -----------------------------------------------------------------------------
// Geometry
// -----------------------------------------------------------------------------
//
// One controller, bdf 0x1F00, BAR 0xFD6E0000, 0x2000 bytes, PADCFG stride
// 16 (revision 0x94), two communities:
//
//   community 0: window 0x0000, PADBAR 0x600, pins  0..23
//   community 1: window 0x1000, PADBAR 0x700, pins 24..47
//
// THE TEST LINE IS PIN 29 -- the backlight enable line the issue names --
// and it is in COMMUNITY 1 on purpose: pad_index = 29 - 24 = 5, so pin
// and pad differ, and every offset below is wrong for a driver that
// treats them as the same number.
//
//   PADCFG0  0x1000 + 0x700 + 5*16 = 0x1750
//   PADCFG1                          0x1754
//   GPI_IS   0x1000 + 0x100 + 0*4  = 0x1100   bit 5 (0x20)
//   GPI_IE   0x1000 + 0x120 + 0*4  = 0x1120
//
// The storm line is pin 5, in COMMUNITY 0, so its status word (0x0100) is
// a different register from the test line's and can be left un-registered
// as W1C without disturbing it.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset every table, registry, seam and slot this fixture touches.
//   B  Build the controller, both communities, and mint the line caps.
//   C  DIRECTION, and the read-modify-write preservation assertion.
//   D  A pad in a native function is REFUSED, not stolen.
//   E  Every out-of-range value is a distinct refusal.
//   F  LEVEL: refused on an input, accepted on an output, and PADCFG1
//      untouched by a PADCFG0 write.
//   G  PULL on PADCFG1, preserving the rest of the word -- and PADCFG0
//      unharmed, which is what the 32-bit store width is for.
//   H  THE W1C MODEL ITSELF.
//   I  EDGE SUBSCRIBE: order, stale-status clear, per-bit enable, and one
//      serviced edge.
//   J  THE STORM BOUND, against a status bit that will not clear.
//   K  UNSUBSCRIBE, and the refusal when there was nothing to unsubscribe.
//   L  THE CHANNEL SCHEMA through cap_handler_gpio_line: per-op rights,
//      the CONFIG/WRITE split, and the reserved-bits refusal.
//   M  Teardown.
//
// Cap slots 80..95, disjoint from every other witness's set (0..8, 10..12,
// 14..19, 28..33, 34..45, 46..55, 56..63, 64..79). Both exits clear them,
// revoke the window, reset every table and close the seam.
//
// On any failure the stage number in _gpd_w_stage identifies the
// assertion.

module GpioPadSynth = structure {

  pub let mut _gpd_w_stage : u64 = 0

  // ==========================================================================
  // gpd_w_seed(slot, kind, rights, target) -> ()
  // ==========================================================================

  pub let gpd_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): write a capability descriptor directly into cap_table[slot] (stride 24). Same reason gpl_w_seed exists in the #1075 fixture: the base authorities this fixture needs -- a KIND_MEMORY with RIGHT_MINT for the window root and a KIND_DEVICE carrying a bdf key for the controller identity the line mint INHERITS -- have no mint path in this kernel yet. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;  // [cap-descriptor-ok: R30.M6-004 fixture seeds base authorities the kernel has no mint path for yet -- see gpd_w_seed justification]
        ret
      }
    }

  // ==========================================================================
  // gpd_w_target(slot) -> the WHOLE target_ptr
  // ==========================================================================

  pub let gpd_w_target : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-003 (#1077): cap_table[slot].target_ptr, UNMASKED. The #1075 fixture's gpl_w_row_of masks to [15:0] because the query ops need only the row id; the channel ops also need the owning slot, which R30.M6-003 records in [31:16]. Reading the whole word here is what makes this fixture drive cap_handler_gpio_line with exactly the argument cap_invoke_dispatch would pass it -- a fixture that reconstructed target_ptr from parts would be testing its own arithmetic rather than the descriptor the mint wrote. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 16];
        ret
      }
    }

  // ==========================================================================
  // gpd_w_clear_slots() -> ()
  // ==========================================================================

  pub let gpd_w_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): zero cap_table slots 80..95 (offset 80*24 = 1920, sixteen slots of 24 bytes = 48 qwords). Called at entry and at BOTH exits so this fixture leaves the capability table exactly as it found it, and so a failing run cannot leave a live line capability -- which on this kind means a claimed physical pin -- behind for a later witness. Leaf. Labels prefixed gpd_wc_.",
      block: {
        mov rax, cap_table;
        add rax, 1920;
        xor rcx, rcx;
        xor r8, r8;
      gpd_wc_next:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 48;
        jb  gpd_wc_next;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpd_w_teardown() -> ()
  // ==========================================================================

  pub let gpd_w_teardown : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): the shared exit. Revokes the window as an op-region FIRST (opregion_cap_revoke is idempotent on an empty slot and refuses a wrong kind, so calling it unconditionally is safe however far the run got), then clears the slots and resets the line table, the controller table, the subscription registry and the seam. THE SUBSCRIPTION RESET IS THE ONE THAT MATTERS HERE: a live subscription outliving this fixture is an ISR entry that will re-derive a pad address from a descriptor slot the next boot stage has reused. Called from BOTH exits. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpd_wt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rdi, 82;
        call opregion_cap_revoke;

        call gpd_w_clear_slots;
        call gpio_pad_sub_reset;
        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpio_io_unbind;
        call gpio_io_synth_disable;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_witness() -> 0 | 1
  // ==========================================================================

  pub let gpio_pad_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-003 (#1077) + R30.M6-004 (#1078): boot witness for the GPIO channel schema and the pad driver beneath it. Drives the SHIPPING functions linked into the real kernel, over the synthetic register seam, with the write-1-to-clear model armed on the status register the interrupt path acknowledges. Establishes: every setter preserves the bits it does not own, against a seeded non-zero background; a pad in a native function is refused rather than stolen; every out-of-range direction, pull, trigger and level is a DISTINCT refusal; a level cannot be driven on a line this kernel did not make an output; W1C is modelled rather than absorbed; an edge subscription clears stale status BEFORE enabling and enables per-bit; one edge is serviced exactly once; a status bit that will not clear reaches the service bound, sets the storm flag and is masked; and the schema enforces READ for get, WRITE for set, CONFIG for direction and pull, OBSERVE for the edge count, refusing op_arg reserved bits rather than masking them. Five pushes plus a 32-byte frame keep rsp%16 == 0 at every nested call; cross-call state that does not fit lives in the frame. Both exits call gpd_w_teardown. Labels prefixed gpd_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        // ================================================================
        // A. Reset.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpio_pad_sub_reset;
        call gpd_w_clear_slots;
        call gpio_io_unbind;
        call gpio_io_synth_enable;

        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpd_w_fail;
        call lpss_gpio_ctrl_count;
        cmp rax, 0;
        jne gpd_w_fail;
        call gpio_io_mode;
        cmp rax, 1;                      // GPIO_IO_MODE_SYNTH
        jne gpd_w_fail;

        // ================================================================
        // B. Controller, communities, line capabilities.
        //
        //   80  KIND_MEMORY, MINT              — the window root
        //   81  KIND_DEVICE, MINT, bdf 0x1F00  — the pad controller
        //   82  the op-region window
        //   84  line cap, ALL rights, pin 29   — community 1, pad 5
        //   85  line cap, ALL rights, pin  5   — community 0, pad 5
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 80;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call gpd_w_seed;

        mov rdi, 81;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0x1F00;
        call gpd_w_seed;

        mov rdi, 0x1F00;
        mov rsi, 1;
        mov rdx, 0xFD6E0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 0;
        jne gpd_w_fail;

        xor rdi, rdi;
        mov rsi, 80;
        mov rdx, 82;
        mov rcx, 0x61B;                  // R_OPREG_ALL
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 82;
        call gpio_io_bind;
        cmp rax, 0;
        jne gpd_w_fail;

        // Community 0's header: revision 0x94 -> stride 16, PADBAR 0x600.
        xor rdi, rdi;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x0C;
        mov rsi, 0x600;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne gpd_w_fail;

        // Community 1's header, in its own window with its own PADBAR.
        mov rdi, 0x1000;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x100C;
        mov rsi, 0x700;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 24;                     // community 0: pins 0..23
        call lpss_gpio_add_community;
        cmp rax, 0;
        jne gpd_w_fail;

        xor rdi, rdi;
        mov rsi, 0x1000;
        mov rdx, 24;
        mov rcx, 24;                     // community 1: pins 24..47
        call lpss_gpio_add_community;
        cmp rax, 1;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 81;
        mov rdx, 0x41F;                  // R_GPIO_LINE_ALL
        mov rcx, 29;                     // the backlight enable line
        mov r8, 0xB1;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 85;
        mov rsi, 81;
        mov rdx, 0x41F;
        mov rcx, 5;                      // community 0, same pad index
        mov r8, 0xB2;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne gpd_w_fail;

        // The mint recorded the owning slot in target_ptr[31:16]. That is
        // the only channel by which the handler learns which capability it
        // is acting for, so a mint that stopped writing it would make
        // every channel op below refuse.
        mov rdi, 84;
        call gpd_w_target;
        mov r10, rax;
        shr r10, 16;
        and r10, 0xFF;
        cmp r10, 84;
        jne gpd_w_fail;

        // The pad address, independently computed: community 1's window
        // (0x1000) + its PADBAR (0x700) + pad_index 5 * stride 16.
        mov rdi, 84;
        call gpio_line_pad_off_of_slot;
        mov r10, 0x1750;
        cmp rax, r10;
        jne gpd_w_fail;

        // ... and the interrupt registers derived from the SAME community.
        mov rdi, 84;
        call gpio_pad_is_off_of_slot;
        mov r10, 0x1100;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        call gpio_pad_ie_off_of_slot;
        mov r10, 0x1120;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        call gpio_pad_bit_of_slot;
        cmp rax, 0x20;                   // 1 << (pad_index 5)
        jne gpd_w_fail;

        // ================================================================
        // C. DIRECTION, AND THE PRESERVATION ASSERTION.
        //
        // The background pattern has bits set in every field set_dir must
        // not touch -- reserved [31:28], RXEVCFG, RXINV, IOxAPIC, [19:14],
        // [7:2] and [1:0] -- with PMODE [13:10] clear so the pad is in
        // GPIO mode, and [9:8] set so the change is visible.
        //
        //   0xF69FC3FE  seeded
        //   0xF69FC0FE  after OUTPUT  (bits [9:8] -> 00)
        //   0xF69FC1FE  after INPUT   (bits [9:8] -> 01, TXDIS)
        //
        // These are assertions about the WHOLE WORD. A setter that
        // computed a fresh value from direction alone would leave
        // 0x00000000 or 0x00000100 here and pass every field-wise test.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1750;
        mov rsi, 0xF69FC3FE;
        call gpio_io_synth_poke;

        mov rdi, 84;
        mov rsi, 1;                      // GPIO_DIR_OUTPUT
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF69FC0FE;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 0;                      // GPIO_DIR_INPUT
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF69FC1FE;
        cmp rax, r10;
        jne gpd_w_fail;

        // The cached configuration follows the register and not the other
        // way round: it says INPUT because the write succeeded.
        mov rdi, 84;
        call gpio_line_cfg_of_slot;
        cmp rax, 0;
        jne gpd_w_fail;

        // ================================================================
        // D. A pad in a native function is REFUSED, not stolen.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1750;
        mov rsi, 0x00000400;             // PMODE = 1
        call gpio_io_synth_poke;

        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_set_dir;
        mov r10, 0xFFFFFEE1;             // GPIO_PAD_NOT_GPIO
        cmp rax, r10;
        jne gpd_w_fail;

        // Nothing was written: a refusal that had already stored would
        // have taken the pin away from whatever owns it.
        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0x00000400;
        cmp rax, r10;
        jne gpd_w_fail;

        // ================================================================
        // E. Every out-of-range value is a DISTINCT refusal.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 84;
        mov rsi, 2;                      // no such direction
        call gpio_pad_set_dir;
        mov r10, 0xFFFFFEEE;             // GPIO_PAD_BAD_DIR
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 3;                      // no such pull
        call gpio_pad_set_pull;
        mov r10, 0xFFFFFEED;             // GPIO_PAD_BAD_PULL
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 4;                      // no such trigger
        call gpio_pad_edge_subscribe;
        mov r10, 0xFFFFFEEC;             // GPIO_PAD_BAD_TRIG
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 2;                      // no such level
        call gpio_pad_set_level;
        mov r10, 0xFFFFFEEB;             // GPIO_PAD_BAD_LEVEL
        cmp rax, r10;
        jne gpd_w_fail;

        // A slot that is not a line capability at all.
        mov rdi, 81;                     // KIND_DEVICE
        mov rsi, 1;
        call gpio_pad_set_dir;
        mov r10, 0xFFFFFEEF;             // GPIO_PAD_BAD_SLOT
        cmp rax, r10;
        jne gpd_w_fail;

        // ================================================================
        // F. LEVEL. Refused on an input; accepted on an output; and the
        //    neighbouring register survives, which is what the 32-bit
        //    store width in gpio_io.pdx exists for.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1750;
        mov rsi, 0xF69FC3FE;
        call gpio_io_synth_poke;
        mov rdi, 0x1754;
        mov rsi, 0xA5A5A5A5;
        call gpio_io_synth_poke;

        mov rdi, 84;
        mov rsi, 0;
        call gpio_pad_set_dir;           // INPUT
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_set_level;
        mov r10, 0xFFFFFEEA;             // GPIO_PAD_NOT_OUTPUT
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_set_dir;           // OUTPUT
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_set_level;
        cmp rax, 0;
        jne gpd_w_fail;

        // Whole word: 0xF69FC0FE with GPIOTXSTATE forced to 1.
        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF69FC0FF;
        cmp rax, r10;
        jne gpd_w_fail;

        // PADCFG1 untouched by three PADCFG0 writes.
        mov rdi, 0x1754;
        call gpio_io_synth_peek;
        mov r10, 0xA5A5A5A5;
        cmp rax, r10;
        jne gpd_w_fail;

        // An output reads back what it drives.
        mov rdi, 84;
        call gpio_pad_get_level;
        cmp rax, 1;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 0;
        call gpio_pad_set_level;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 84;
        call gpio_pad_get_level;
        cmp rax, 0;
        jne gpd_w_fail;

        // ================================================================
        // G. PULL, on PADCFG1, preserving the rest of the word.
        //
        //   0xA5A5A5A5 seeded; TERM [13:10] cleared and 0xC (20K pull-up)
        //   ORed in -> 0xA5A5B1A5. Everything else survives.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 84;
        mov rsi, 2;                      // GPIO_PULL_UP
        call gpio_pad_set_pull;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 0x1754;
        call gpio_io_synth_peek;
        mov r10, 0xA5A5B1A5;
        cmp rax, r10;
        jne gpd_w_fail;

        // PADCFG0 is the register BELOW PADCFG1; a store that widened to
        // eight bytes would have taken it with it.
        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF69FC0FE;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 0;                      // GPIO_PULL_NONE
        call gpio_pad_set_pull;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 0x1754;
        call gpio_io_synth_peek;
        mov r10, 0xA5A581A5;
        cmp rax, r10;
        jne gpd_w_fail;

        // ================================================================
        // H. THE WRITE-1-TO-CLEAR MODEL ITSELF.
        //
        // THIS IS THE ASSERTION EVERY INTERRUPT ASSERTION BELOW RESTS ON.
        // Against the plain cell array R30.M6-002 shipped, the first
        // compare would see 0x20 and the second 0.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x1100;
        call gpio_io_synth_w1c_mark;
        cmp rax, 0;
        jne gpd_w_fail;

        // Refused, not repaired, two ways.
        mov rdi, 0x1101;                 // not dword-aligned
        call gpio_io_synth_w1c_mark;
        mov r10, 0xFFFFFF09;             // GPIO_IO_BAD_ARG
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x4000;                 // outside the window
        call gpio_io_synth_w1c_mark;
        mov r10, 0xFFFFFF0A;             // GPIO_IO_RANGE
        cmp rax, r10;
        jne gpd_w_fail;

        // Marking twice is idempotent, not a second entry.
        mov rdi, 0x1100;
        call gpio_io_synth_w1c_mark;
        cmp rax, 0;
        jne gpd_w_fail;

        // The part asserts every bit; only the fixture can do that, which
        // is why the seeding path bypasses register semantics.
        mov rdi, 0x1100;
        mov rsi, 0xFFFFFFFF;
        call gpio_io_synth_poke;

        // Writing a 1 clears THAT BIT AND ONLY THAT BIT.
        mov rdi, 0x1100;
        mov rsi, 0x20;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 0x1100;
        call gpio_io_synth_peek;
        mov r10, 0xFFFFFFDF;
        cmp rax, r10;
        jne gpd_w_fail;

        // Writing 0 does nothing at all.
        mov rdi, 0x1100;
        xor rsi, rsi;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 0x1100;
        call gpio_io_synth_peek;
        mov r10, 0xFFFFFFDF;
        cmp rax, r10;
        jne gpd_w_fail;

        // No write can SET a status bit.
        mov rdi, 0x1100;
        mov rsi, 0x20;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 0x1100;
        call gpio_io_synth_peek;
        mov r10, 0xFFFFFFDF;
        cmp rax, r10;
        jne gpd_w_fail;

        // An UNregistered register is still ordinary storage.
        mov rdi, 0x1120;
        mov rsi, 0x12345678;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 0x1120;
        call gpio_io_synth_peek;
        mov r10, 0x12345678;
        cmp rax, r10;
        jne gpd_w_fail;

        // ================================================================
        // I. EDGE SUBSCRIBE, AND ONE SERVICED EDGE.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        // Firmware left the status word fully asserted and the enable
        // word holding another pad's enable. Both are the states that
        // make the order of operations in edge_subscribe load-bearing.
        mov rdi, 0x1100;
        mov rsi, 0xFFFFFFFF;
        call gpio_io_synth_poke;
        mov rdi, 0x1120;
        mov rsi, 0x00000004;             // pad 2's enable, not ours
        call gpio_io_synth_poke;
        mov rdi, 0x1750;
        mov rsi, 0xF69FC3FE;
        call gpio_io_synth_poke;

        mov rdi, 84;
        mov rsi, 0;                      // an input, as an edge source must be
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;

        // An output cannot subscribe: being interrupted by oneself is not
        // a service, it is a loop.
        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;
        mov rdi, 84;
        mov rsi, 1;                      // GPIO_TRIG_RISING
        call gpio_pad_edge_subscribe;
        mov r10, 0xFFFFFEE9;             // GPIO_PAD_NOT_INPUT
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 84;
        mov rsi, 0;
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;

        call gpio_io_trace_reset;

        mov rdi, 84;
        mov rsi, 1;                      // GPIO_TRIG_RISING
        call gpio_pad_edge_subscribe;
        cmp rax, 0;
        jne gpd_w_fail;

        // PADCFG0: RXEVCFG = EDGE, RXINV clear, IOxAPIC routed, and every
        // other bit of the seeded pattern still there. INPUT left [9:8]
        // at 01, so the baseline is 0xF69FC1FE with [26:25] forced to 01
        // and [23] cleared: 0xF69FC1FE & ~0x06900000 | 0x02100000.
        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF21FC1FE;
        cmp rax, r10;
        jne gpd_w_fail;

        // Stale status cleared -- OUR bit only.
        mov rdi, 0x1100;
        call gpio_io_synth_peek;
        mov r10, 0xFFFFFFDF;
        cmp rax, r10;
        jne gpd_w_fail;

        // Enabled -- without disturbing pad 2's enable.
        mov rdi, 0x1120;
        call gpio_io_synth_peek;
        mov r10, 0x00000024;
        cmp rax, r10;
        jne gpd_w_fail;

        // THE ORDER, from the trace: the status clear precedes the enable.
        // Final register state cannot express this and it is the whole
        // argument for clearing first -- enabling a pad whose status is
        // already asserted is a storm on the very first interrupt.
        mov rdi, 2;                      // GPIO_TRACE_OP_WRITE
        mov rsi, 0x1100;
        xor rdx, rdx;
        call gpio_io_trace_find;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpd_w_fail;
        mov r12, rax;

        mov rdi, 2;
        mov rsi, 0x1120;
        xor rdx, rdx;
        call gpio_io_trace_find;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpd_w_fail;
        cmp r12, rax;
        jae gpd_w_fail;

        // A second subscription on the same line is refused.
        mov rdi, 84;
        mov rsi, 1;
        call gpio_pad_edge_subscribe;
        mov r10, 0xFFFFFEE5;             // GPIO_PAD_ALREADY_SUB
        cmp rax, r10;
        jne gpd_w_fail;

        // One edge arrives.
        mov rdi, 0x1100;
        mov rsi, 0x20;
        call gpio_io_synth_poke;

        call gpio_pad_isr;
        cmp rax, 1;
        jne gpd_w_fail;

        // Acknowledged: the status bit is DOWN. This is the assertion the
        // plain cell array cannot make -- under it the bit would still be
        // set and the ISR would have reached its budget instead.
        mov rdi, 0x1100;
        call gpio_io_synth_peek;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 84;
        call gpio_pad_edge_count;
        cmp rax, 1;
        jne gpd_w_fail;

        mov rdi, 84;
        call gpio_pad_edge_storm;
        cmp rax, 0;
        jne gpd_w_fail;

        // A quiet line costs nothing.
        call gpio_pad_isr;
        cmp rax, 0;
        jne gpd_w_fail;

        // ================================================================
        // J. THE STORM BOUND.
        //
        // Line 85 is in COMMUNITY 0, so its status word is 0x0100 -- a
        // different register, deliberately NOT registered write-1-to-clear.
        // A plain cell absorbs the acknowledgement and answers with it,
        // which is exactly the behaviour of a status bit that will not
        // clear, and exactly the behaviour every register in the #1076
        // model had.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 85;
        call gpio_pad_is_off_of_slot;
        mov r10, 0x0100;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x0120;
        mov rsi, 0;
        call gpio_io_synth_poke;
        mov rdi, 0x0650;                 // community 0, PADBAR 0x600, pad 5
        mov rsi, 0;
        call gpio_io_synth_poke;

        mov rdi, 85;
        mov rsi, 0;
        call gpio_pad_set_dir;
        cmp rax, 0;
        jne gpd_w_fail;

        mov rdi, 85;
        mov rsi, 1;                      // GPIO_TRIG_RISING
        call gpio_pad_edge_subscribe;
        cmp rax, 0;
        jne gpd_w_fail;

        // The stale-status clear was ABSORBED: the cell now holds the bit
        // the driver wrote to knock it down. Stating it as an assertion
        // rather than a comment is what makes this fixture's claim about
        // the register model checkable.
        mov rdi, 0x0100;
        call gpio_io_synth_peek;
        cmp rax, 0x20;
        jne gpd_w_fail;

        mov rdi, 0x0120;
        call gpio_io_synth_peek;
        cmp rax, 0x20;
        jne gpd_w_fail;

        // The ISR now faces a bit that will not go down. It services the
        // budget and stops -- it does NOT return with the condition still
        // asserted and it does NOT keep going.
        call gpio_pad_isr;
        cmp rax, 4;                      // GPIO_ISR_LINE_BUDGET
        jne gpd_w_fail;

        mov rdi, 85;
        call gpio_pad_edge_count;
        cmp rax, 4;
        jne gpd_w_fail;

        mov rdi, 85;
        call gpio_pad_edge_storm;
        cmp rax, 1;
        jne gpd_w_fail;

        // MASKED. This is what makes the bound a termination argument
        // rather than a delay: a line whose status will not clear is
        // disconnected from the interrupt controller.
        mov rdi, 0x0120;
        call gpio_io_synth_peek;
        cmp rax, 0;
        jne gpd_w_fail;

        // And it stays masked: the next entry finds nothing to do, because
        // the storm arm ran once and the line is off.
        call gpio_pad_isr;
        cmp rax, 4;
        jne gpd_w_fail;

        // The line the model DOES cover was unaffected by any of it.
        mov rdi, 84;
        call gpio_pad_edge_storm;
        cmp rax, 0;
        jne gpd_w_fail;

        // ================================================================
        // K. UNSUBSCRIBE.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 84;
        call gpio_pad_edge_unsubscribe;
        cmp rax, 0;
        jne gpd_w_fail;

        // Disabled in GPI_IE, pad 2's enable still standing.
        mov rdi, 0x1120;
        call gpio_io_synth_peek;
        mov r10, 0x00000004;
        cmp rax, r10;
        jne gpd_w_fail;

        // RXEVCFG forced to DISABLED (2), everything else preserved.
        mov rdi, 0x1750;
        call gpio_io_synth_peek;
        mov r10, 0xF41FC1FE;
        cmp rax, r10;
        jne gpd_w_fail;

        // Unsubscribing what was never subscribed is a REFUSAL, not a
        // success: "it is already quiet" and "I quietened it" differ when
        // two components believe they own the same pin.
        mov rdi, 84;
        call gpio_pad_edge_unsubscribe;
        mov r10, 0xFFFFFEE4;             // GPIO_PAD_NOT_SUB
        cmp rax, r10;
        jne gpd_w_fail;

        // ================================================================
        // L. THE CHANNEL SCHEMA, through the dispatch handler.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        mov rdi, 84;
        call gpd_w_target;
        mov r13, rax;                    // the descriptor's target_ptr

        // GET requires READ. INVOKE, which is all the query ops need, is
        // not enough -- reading a line is observing the board.
        mov rdi, 0x008;                  // INVOKE only
        mov rsi, r13;
        mov rdx, 6;                      // GPIO_LINE_OP_GET
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x001;                  // READ
        mov rsi, r13;
        mov rdx, 6;
        call cap_handler_gpio_line;
        cmp rax, 1;
        ja  gpd_w_fail;                  // a level, not a refusal

        // SET requires WRITE, and READ is not enough.
        mov rdi, 0x001;
        mov rsi, r13;
        mov rdx, 0x0107;                 // op 7, level 1
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne gpd_w_fail;

        // THE SPLIT THAT MATTERS. WRITE may toggle an output; it may NOT
        // turn an input into an output, because that starts driving a net
        // something else may already be driving.
        mov rdi, 0x002;                  // WRITE
        mov rsi, r13;
        mov rdx, 0x0108;                 // op 8 (CFG_DIR), dir 1
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x004;                  // CONFIG
        mov rsi, r13;
        mov rdx, 0x0108;
        call cap_handler_gpio_line;
        cmp rax, 0;
        jne gpd_w_fail;

        // ... and now WRITE alone CAN drive it, because it is an output.
        mov rdi, 0x002;
        mov rsi, r13;
        mov rdx, 0x0107;
        call cap_handler_gpio_line;
        cmp rax, 0;
        jne gpd_w_fail;

        // PULL IS CONFIG TOO. A pull-up on a line an external device
        // drives low is a fight, not a preference.
        mov rdi, 0x002;                  // WRITE
        mov rsi, r13;
        mov rdx, 0x0209;                 // op 9 (CFG_PULL), pull 2
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x004;
        mov rsi, r13;
        mov rdx, 0x0209;
        call cap_handler_gpio_line;
        cmp rax, 0;
        jne gpd_w_fail;

        // The edge count is OBSERVE, not READ: how often a line has fired
        // is a fact about the board, and the two rights are separable.
        mov rdi, 0x001;
        mov rsi, r13;
        mov rdx, 12;                     // GPIO_LINE_OP_EDGE_COUNT
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x400;                  // OBSERVE
        mov rsi, r13;
        mov rdx, 12;
        call cap_handler_gpio_line;
        cmp rax, 1;
        jne gpd_w_fail;

        // THE RESERVED-BITS REFUSAL. Fifty-six bits above the operand are
        // exactly where a pin number would be smuggled on an invocation
        // that reaches a pad, so they are refused rather than masked.
        mov rdi, 0x41F;
        mov rsi, r13;
        mov rdx, 0x10107;                // op 7, level 1, bit 16 set
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFF10;             // GPIO_LINE_OP_ARG_RESERVED
        cmp rax, r10;
        jne gpd_w_fail;

        mov rdi, 0x41F;
        mov rsi, r13;
        mov rdx, 0xFFFFFFFFFFFF0006;     // op 6, every high bit set
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFF10;
        cmp rax, r10;
        jne gpd_w_fail;

        // The QUERY ops keep discarding their upper bits, because they
        // have no operand for those bits to be confused with -- the #1075
        // behaviour, unchanged.
        mov rdi, 0x41F;
        mov rsi, r13;
        mov rdx, 0xFFFFFFFFFFFFFF00;     // op 0, every high bit set
        call cap_handler_gpio_line;
        cmp rax, 29;
        jne gpd_w_fail;

        // An op past the end is unsupported, not a wrapped op.
        mov rdi, 0x41F;
        mov rsi, r13;
        mov rdx, 14;
        call cap_handler_gpio_line;
        mov r10, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r10;
        jne gpd_w_fail;

        // QUERY_CFG reports the cached byte: output, pull-up, no trigger.
        mov rdi, 0x008;
        mov rsi, r13;
        mov rdx, 13;                     // GPIO_LINE_OP_QUERY_CFG
        call cap_handler_gpio_line;
        cmp rax, 0x05;                   // dir 1 | (pull 2 << 1)
        jne gpd_w_fail;

        // ================================================================
        // M. Leave everything as we found it.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _gpd_w_stage];
        mov [rcx], rax;

        call gpd_w_teardown;

        call gpio_line_rows_live;
        cmp rax, 0;
        jne gpd_w_fail_notd;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gpio_pad_ok_msg];
        call klog_s1;

        xor rax, rax;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpd_w_fail:
        call gpd_w_teardown;

      gpd_w_fail_notd:
        lea rax, [rip + _gpd_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gpio_pad_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
