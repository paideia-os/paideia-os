// tests/kernel/drivers/gpio/lpss_gpio_synth.pdx — R30.M6-002 (#1076)
//
// Boot witness for the LPSS / PCH pad controller: probe, BAR-to-
// capability, identification, and the community (bank) description that
// turns a pin number into a register address.
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// There is no pad controller in QEMU and there will not be one. The
// things worth testing in this milestone are not the MMIO stores — they
// are the IDENTIFICATION LOGIC, the GEOMETRY VALIDATION and the RIGHTS
// GATE, all of which are hardware-independent and all of which fail
// silently when wrong. A pad controller has no acknowledgement and no
// error path: if the driver decides the wrong thing here, nothing
// reports it and the first symptom is a device that never came out of
// reset.
//
// So the register seam (`core/drivers/gpio/gpio_io.pdx`) is switched to
// its synthetic side and everything above it runs UNCHANGED. The driver
// does not know the mode exists. THE CAPABILITY CHECKS ARE NOT BYPASSED
// IN SYNTHETIC MODE — a window minted without WRITE is refused a write
// here exactly as on metal, which is the only reason sub-test H's
// assertions mean anything.
//
// Every access is appended to an ORDERED TRACE, and the trace is what
// makes two claims checkable that final state cannot express at all:
//
//   * the community header was READ before the geometry derived from it
//     was accepted;
//   * the driver NEVER WROTE a community header register. REVID,
//     CAPLIST and PADBAR are read-only on the part, so a synthetic cell
//     array would absorb such a write silently and then answer with it —
//     the fixture would be describing a controller it had itself
//     configured. "There is no WRITE record at 0x00, 0x0C or 0x100C" is
//     a statement only the trace can make.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset every table, seam and slot this fixture touches.
//   B  An unbound seam refuses everything.
//   C  Controller rows through the SHIPPING allocator: a zero identity
//      and a sub-page window are refused; the two good ones record their
//      measured extent and their bdf key.
//   D  BAR -> capability: a KIND_DEVICE parent is the wrong authority
//      for a memory-like space and is refused with nothing written; the
//      KIND_MEMORY one mints; a second bind is refused.
//   E  IDENTIFICATION, refused six ways before it is accepted: the
//      DesignWare I²C signature (the OTHER LPSS block, with its own
//      code), a dead window, an all-ones window, a zero PADBAR, a
//      misaligned PADBAR, a PADBAR outside the BAR. Then accepted, with
//      the PADCFG stride DERIVED from the revision.
//   F  A LOW-REVISION part gets the OTHER stride. This is the assertion
//      that says the stride was read rather than assumed.
//   G  COMMUNITY DESCRIPTION, refused five ways: an unidentified
//      controller, three bad geometries, an overlapping pin range, a
//      community window with nothing behind it, and an extent that
//      leaves the BAR. Then two good communities — and the second one
//      is NOT at offset zero and NOT based at pin zero, which is the
//      whole point.
//   H  THE SEAM, for real: a read-only window refuses a write, an
//      offset past the window is REFUSED not clamped, a wrong-kind slot
//      cannot be bound, and a REVOKED window stops access immediately
//      with no cached base.
//   I  THE MAPPING. resolve_pin on both communities, on both
//      boundaries, on an unrouted pin and on an unknown controller —
//      with the community-1 answers being the ones an implementation
//      that forgot to subtract pin_base would get wrong.
//   J  THE TRACE: the header reads happened, in order, and NO community
//      header was ever written.
//   K  Community table exhaustion.
//   L  RELEASE takes the controller's communities with it, and the pin
//      map goes with them.
//   M  Teardown.
//
// Cap slots 56..63, disjoint from every other witness's set (0..8,
// 10..12, 14..19, 28..33, 34..45, 46..55). Both exits clear them,
// revoke every window this fixture minted, unbind and close the seam,
// and reset the controller and community tables.
//
// On any failure the stage number in _lpg_w_stage identifies the
// assertion.

module LpssGpioSynth = structure {

  // Stage tracker. Memory-backed rather than a register, matching every
  // other R30 witness: it has to survive every callee-save-clobber
  // pattern in the primitives under test.
  pub let mut _lpg_w_stage : u64 = 0

  // ==========================================================================
  // lpg_w_seed(slot, kind, rights, target) -> ()
  // ==========================================================================

  pub let lpg_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): write a capability descriptor directly into cap_table[slot] (stride 24: kind at +0, rights at +8, target_ptr at +16). The fixture needs two BASE authorities no mint path in this kernel produces yet -- a KIND_MEMORY (4) carrying RIGHT_MINT, which is what an op-region root mint over a memory-like space demands, and a KIND_DEVICE (10), which is the wrong authority for that space and is therefore what makes the refusing direction testable. Seeding them directly is what makes the gate testable in BOTH directions rather than only in the refusing one. Same device as every other R30 witness preamble. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;  // [cap-descriptor-ok: R30.M6-002 fixture seeds KIND_MEMORY/KIND_DEVICE base authorities the kernel has no mint path for yet -- see justification]
        ret
      }
    }

  pub let lpg_w_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): read cap_table[slot].kind. Every 'nothing was written' assertion in this fixture goes through this one accessor, so a refusal that silently wrote a descriptor cannot pass by being asserted with a differently-shaped read somewhere else. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret
      }
    }

  pub let lpg_w_row_of : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): the row id in cap_table[slot].target_ptr[15:0]. Sub-test H needs it to build the time-of-check-to-time-of-use case: a descriptor that still names a KIND_OP_REGION row AFTER that row has been freed is what a revoked-and-reused capability slot looks like from the seam's side, and no ordinary API call produces it. Reading the field here rather than exporting a resolver keeps the fixture's reach out of the shipping surface. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 16];
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  pub let lpg_w_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): zero cap_table slots 56..63 (offset 56*24 = 1344, eight slots of 24 bytes = 24 qwords). Called at entry and at BOTH exits so this fixture leaves the capability table exactly as it found it, and so a failing run cannot leave a live KIND_OP_REGION over a fabricated physical base visible to whatever boots next. The set is disjoint from every other witness's. Leaf. Labels prefixed lpg_wc_.",
      block: {
        mov rax, cap_table;
        add rax, 1344;
        xor rcx, rcx;
        xor r8, r8;
      lpg_wc_next:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 24;
        jb  lpg_wc_next;
        ret
      }
    } @no_frame

  // ==========================================================================
  // lpg_w_teardown() -> ()
  //
  // The shared exit path. Revokes every window this fixture could have
  // minted BEFORE clearing the slots, so op-region ROWS are returned to
  // the table rather than stranded behind a cleared descriptor.
  // ==========================================================================

  pub let lpg_w_teardown : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): the shared exit. Revoke slots 58..61 as op-regions FIRST -- opregion_cap_revoke is idempotent on an empty slot and refuses a wrong kind, so calling it on all four is safe whether or not the run got far enough to mint them -- and only then clear the descriptors. Order matters: clearing a descriptor without revoking would strand its _op_region_table row, and rows are a scarcer resource than slots (OPREG_MAX = 32 across the whole boot). Then unbind and close the seam, and reset the controller and community tables. Called from BOTH exits, which is why it is a function: a fixture whose teardown is inline in the success path leaves the failure path to remember it. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed lpg_wt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, 58;
      lpg_wt_next:
        cmp r12, 62;
        jae lpg_wt_done;
        mov rdi, r12;
        call opregion_cap_revoke;
        add r12, 1;
        jmp lpg_wt_next;

      lpg_wt_done:
        call lpg_w_clear_slots;
        call gpio_io_unbind;
        call gpio_io_synth_disable;
        call lpss_gpio_table_reset;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_witness() -> u64
  // ==========================================================================

  pub let lpss_gpio_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-002 (#1076): boot witness for the pad-controller probe, the BAR-to-capability step, two-stage identification, the derived PADCFG stride, community geometry validation, the pin-to-(community, pad) mapping, and the register seam in both of its refusing directions. Drives the SHIPPING functions linked into the real kernel; touches no hardware, because the seam is in its synthetic mode for the whole fixture and the PCI probe it exercises finds nothing under QEMU's MCFG-absent boot in any case. Controller rows come from lpss_gpio_record, the same allocator the probe uses, so the fixture tests the shape the machine actually has. Five pushes (rbx, r12-r15) leave rsp%16 == 0 at every nested call; all cross-call state that is not in those registers lives in module .bss for the same reason the stage counter does. Both exits call lpg_w_teardown. Labels prefixed lpg_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset everything this fixture touches.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        call lpss_gpio_table_reset;
        call gpio_line_table_reset;
        call lpg_w_clear_slots;
        call gpio_io_unbind;
        call gpio_io_synth_enable;

        call lpss_gpio_ctrl_count;
        cmp rax, 0;
        jne lpg_w_fail;
        call gpio_line_rows_live;
        cmp rax, 0;
        jne lpg_w_fail;
        call gpio_io_mode;
        cmp rax, 1;                      // GPIO_IO_MODE_SYNTH
        jne lpg_w_fail;

        // ================================================================
        // B. An unbound seam refuses everything.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call gpio_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // GPIO_IO_FAULT
        cmp rax, r15;
        jne lpg_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        call gpio_io_write32;
        mov r15, 0xFFFFFF0F;             // GPIO_IO_UNBOUND
        cmp rax, r15;
        jne lpg_w_fail;

        call gpio_io_window_slot;
        cmp rax, 0;
        jne lpg_w_fail;

        // A refused access is NOT traced: the trace records accesses
        // that reached the device, and these reached nothing.
        call gpio_io_trace_count;
        cmp rax, 0;
        jne lpg_w_fail;

        // ================================================================
        // C. Controller rows through the shipping allocator.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        mov rdi, 56;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call lpg_w_seed;

        mov rdi, 57;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0x1F00;
        call lpg_w_seed;

        // A zero controller identity is refused: lpss_gpio_find_by_ctrl_id
        // treats zero as "no controller", so the row would be permanently
        // unreachable and every line minted against it unresolvable.
        xor rdi, rdi;
        mov rsi, 1;
        mov rdx, 0xFD6E0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        mov r15, 0xFFFFFF2D;             // LPSS_GPIO_PROBE_NO_BAR
        cmp rax, r15;
        jne lpg_w_fail;

        // A sub-page window is refused rather than accepted and clipped.
        mov rdi, 0x1F0F;
        mov rsi, 1;
        mov rdx, 0xFD6C0000;
        mov rcx, 0x800;
        call lpss_gpio_record;
        mov r15, 0xFFFFFF2D;
        cmp rax, r15;
        jne lpg_w_fail;

        call lpss_gpio_ctrl_count;
        cmp rax, 0;
        jne lpg_w_fail;

        // Controller 0 — the one everything below is built on.
        mov rdi, 0x1F00;
        mov rsi, 1;                      // intel
        mov rdx, 0xFD6E0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 0;
        jne lpg_w_fail;

        // Controller 1 — a LOW-REVISION part, used to prove the stride
        // is read rather than assumed.
        mov rdi, 0x1F01;
        mov rsi, 1;
        mov rdx, 0xFD6D0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 1;
        jne lpg_w_fail;

        // Controller 2 — left a CANDIDATE forever, so the
        // "communities cannot be described against an unidentified
        // controller" refusal has something to be refused on.
        mov rdi, 0x1F02;
        xor rsi, rsi;                    // NOT an Intel part
        mov rdx, 0xFD6B0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 2;
        jne lpg_w_fail;

        call lpss_gpio_ctrl_count;
        cmp rax, 3;
        jne lpg_w_fail;

        xor rdi, rdi;
        call lpss_gpio_ctrl_state;
        cmp rax, 1;                      // LPSS_GPIO_STATE_CANDIDATE
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_bar_base;
        mov r15, 0xFD6E0000;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_bar_len;
        mov r15, 0x2000;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_id;
        mov r15, 0x1F00;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_intel;
        cmp rax, 1;
        jne lpg_w_fail;
        mov rdi, 2;
        call lpss_gpio_ctrl_intel;
        cmp rax, 0;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_stride;
        cmp rax, 0;                      // no stride before identification
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_comm_count;
        cmp rax, 0;
        jne lpg_w_fail;

        // The identity lookup that the KIND_GPIO_LINE gate performs.
        mov rdi, 0x1F00;
        call lpss_gpio_find_by_ctrl_id;
        cmp rax, 0;
        jne lpg_w_fail;
        mov rdi, 0x1F01;
        call lpss_gpio_find_by_ctrl_id;
        cmp rax, 1;
        jne lpg_w_fail;
        mov rdi, 0xDEAD;
        call lpss_gpio_find_by_ctrl_id;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // LPSS_GPIO_NOT_FOUND
        cmp rax, r15;
        jne lpg_w_fail;
        // Zero is refused rather than matched against a free row.
        xor rdi, rdi;
        call lpss_gpio_find_by_ctrl_id;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // D. BAR -> capability.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        // A KIND_DEVICE parent is the wrong authority for a memory-like
        // space. Refused, and nothing is written.
        xor rdi, rdi;
        mov rsi, 57;                     // KIND_DEVICE, not KIND_MEMORY
        mov rdx, 58;
        mov rcx, 0x61B;                  // R_OPREG_ALL
        call lpss_gpio_bind_window;
        mov r15, 0xFFFFFF2C;             // LPSS_GPIO_WIN_BAD_PARENT
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_window;
        cmp rax, 0;
        jne lpg_w_fail;
        mov rdi, 58;
        call lpg_w_kind;
        cmp rax, 0;
        jne lpg_w_fail;

        // The right authority mints.
        xor rdi, rdi;
        mov rsi, 56;                     // KIND_MEMORY + RIGHT_MINT
        mov rdx, 58;
        mov rcx, 0x61B;
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_window;
        cmp rax, 58;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_state;
        cmp rax, 2;                      // LPSS_GPIO_STATE_WINDOWED
        jne lpg_w_fail;
        mov rdi, 58;
        call lpg_w_kind;
        mov r15, 0x150;                  // KIND_OP_REGION
        cmp rax, r15;
        jne lpg_w_fail;

        // A second bind is refused: two live capabilities over every pin
        // on the package, with no revoke relationship between them.
        xor rdi, rdi;
        mov rsi, 56;
        mov rdx, 61;
        mov rcx, 0x61B;
        call lpss_gpio_bind_window;
        mov r15, 0xFFFFFF2B;             // LPSS_GPIO_WIN_ALREADY
        cmp rax, r15;
        jne lpg_w_fail;

        // Controller 1 gets a READ-ONLY window (no RIGHT_WRITE).
        mov rdi, 1;
        mov rsi, 56;
        mov rdx, 59;
        mov rcx, 0x409;                  // READ | INVOKE | OBSERVE
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne lpg_w_fail;

        // ================================================================
        // E. IDENTIFICATION — refused six ways, then accepted.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        // Not windowed yet: controller 2 has no capability at all.
        mov rdi, 2;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF2A;             // LPSS_GPIO_ID_NOT_WINDOWED
        cmp rax, r15;
        jne lpg_w_fail;

        mov rdi, 58;
        call gpio_io_bind;
        cmp rax, 0;
        jne lpg_w_fail;
        call gpio_io_window_slot;
        cmp rax, 58;
        jne lpg_w_fail;

        // (1) The DesignWare I²C signature: this is the OTHER LPSS block.
        mov rdi, 0xFC;
        mov rsi, 0x44570140;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF29;             // LPSS_GPIO_ID_IS_I2C
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_state;
        cmp rax, 2;                      // still WINDOWED, not advanced
        jne lpg_w_fail;

        // (2) Nothing behind the window: REVID reads zero.
        mov rdi, 0xFC;
        xor rsi, rsi;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF28;             // LPSS_GPIO_ID_NO_PART
        cmp rax, r15;
        jne lpg_w_fail;

        // (3) An all-ones window is not answering either.
        xor rdi, rdi;
        mov rsi, 0xFFFFFFFF;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF28;
        cmp rax, r15;
        jne lpg_w_fail;

        // (4) A zero PADBAR: the PADCFG region has to be somewhere.
        xor rdi, rdi;
        mov rsi, 0x00940000;             // revision 0x94 -> stride 16
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF27;             // LPSS_GPIO_ID_BAD_PADBAR
        cmp rax, r15;
        jne lpg_w_fail;

        // (5) A misaligned PADBAR: register offsets are 4-byte aligned.
        mov rdi, 0x0C;
        mov rsi, 0x0602;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF27;
        cmp rax, r15;
        jne lpg_w_fail;

        // (6) A PADBAR outside the BAR: refused, never clipped.
        mov rdi, 0x0C;
        mov rsi, 0x3000;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF27;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_state;
        cmp rax, 2;                      // six refusals, no state change
        jne lpg_w_fail;

        // ACCEPTED.
        mov rdi, 0x0C;
        mov rsi, 0x600;
        call gpio_io_synth_poke;
        xor rdi, rdi;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_state;
        cmp rax, 3;                      // LPSS_GPIO_STATE_IDENTIFIED
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_revid;
        mov r15, 0x00940000;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        call lpss_gpio_ctrl_stride;
        cmp rax, 16;                     // GPIO_PADCFG_STRIDE_4
        jne lpg_w_fail;

        // Identifying twice would re-derive a stride that communities
        // have already been described against.
        xor rdi, rdi;
        call lpss_gpio_identify;
        mov r15, 0xFFFFFF26;             // LPSS_GPIO_ID_ALREADY
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // F. A LOW-REVISION PART GETS THE OTHER STRIDE.
        //
        // This is the assertion that says the stride was READ. With a
        // hardcoded 16 the two controllers would be indistinguishable
        // here, and every pad access on an older part would land on the
        // pad two positions away — a real, drivable, unrelated pin.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        mov rdi, 59;                     // controller 1's READ-ONLY window
        call gpio_io_bind;
        cmp rax, 0;
        jne lpg_w_fail;

        xor rdi, rdi;
        mov rsi, 0x00930000;             // revision 0x93 -> stride 8
        call gpio_io_synth_poke;
        mov rdi, 1;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne lpg_w_fail;
        mov rdi, 1;
        call lpss_gpio_ctrl_stride;
        cmp rax, 8;                      // GPIO_PADCFG_STRIDE_2
        jne lpg_w_fail;

        // Identification of a read-only window WORKS -- it only reads.
        mov rdi, 1;
        call lpss_gpio_ctrl_state;
        cmp rax, 3;
        jne lpg_w_fail;

        // ================================================================
        // G. COMMUNITY DESCRIPTION.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        mov rdi, 58;                     // back to controller 0's window
        call gpio_io_bind;
        cmp rax, 0;
        jne lpg_w_fail;

        // Controller 2 was never identified: it has no stride, and a
        // community described against it would map every pad to the
        // same register.
        mov rdi, 2;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 8;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF25;             // LPSS_GPIO_COMM_NOT_IDENTIFIED
        cmp rax, r15;
        jne lpg_w_fail;

        // Three bad geometries.
        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;                    // npins == 0
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF23;             // LPSS_GPIO_COMM_BAD_GEOM
        cmp rax, r15;
        jne lpg_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 129;                    // > GPIO_COMM_MAX_PINS
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF23;
        cmp rax, r15;
        jne lpg_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 500;
        mov rcx, 20;                     // 500 + 20 > GPIO_PIN_MAX
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF23;
        cmp rax, r15;
        jne lpg_w_fail;

        xor rdi, rdi;
        call lpss_gpio_comm_count;
        cmp rax, 0;
        jne lpg_w_fail;

        // COMMUNITY 0: window at offset 0, pins 0..23. Its header is
        // already seeded (REVID 0x00940000, PADBAR 0x600).
        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 24;
        call lpss_gpio_add_community;
        cmp rax, 0;
        jne lpg_w_fail;

        // COMMUNITY 1: a DIFFERENT window at 0x1000, a DIFFERENT PADCFG
        // offset, and a pin base of 24. Every one of those three differs
        // from community 0, which is what makes the mapping assertions
        // in sub-test I able to fail.
        mov rdi, 0x1000;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x100C;
        mov rsi, 0x700;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        mov rsi, 0x1000;
        mov rdx, 24;
        mov rcx, 24;
        call lpss_gpio_add_community;
        cmp rax, 1;
        jne lpg_w_fail;

        xor rdi, rdi;
        call lpss_gpio_comm_count;
        cmp rax, 2;
        jne lpg_w_fail;

        // Geometry read back, per community.
        xor rdi, rdi;
        xor rsi, rsi;
        call lpss_gpio_comm_reg_off;
        cmp rax, 0;
        jne lpg_w_fail;
        xor rdi, rdi;
        xor rsi, rsi;
        call lpss_gpio_comm_padbar;
        mov r15, 0x600;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        xor rsi, rsi;
        call lpss_gpio_comm_pin_base;
        cmp rax, 0;
        jne lpg_w_fail;
        xor rdi, rdi;
        mov rsi, 1;
        call lpss_gpio_comm_reg_off;
        mov r15, 0x1000;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        mov rsi, 1;
        call lpss_gpio_comm_padbar;
        mov r15, 0x700;
        cmp rax, r15;
        jne lpg_w_fail;
        xor rdi, rdi;
        mov rsi, 1;
        call lpss_gpio_comm_pin_base;
        cmp rax, 24;
        jne lpg_w_fail;
        xor rdi, rdi;
        mov rsi, 1;
        call lpss_gpio_comm_npins;
        cmp rax, 24;
        jne lpg_w_fail;

        // An unknown community answers UNMAPPED and never a plausible
        // zero -- zero is community 0's ordinary register offset.
        xor rdi, rdi;
        mov rsi, 7;
        call lpss_gpio_comm_reg_off;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // OVERLAP: pins 20..29 would give pin 20 two register windows.
        // Refused rather than resolved by first match, because picking
        // either silently is how a driver comes to drive a pin it did
        // not mean to.
        mov rdi, 0x1900;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x190C;
        mov rsi, 0x600;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        mov rsi, 0x1900;
        mov rdx, 20;
        mov rcx, 10;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF22;             // LPSS_GPIO_COMM_OVERLAP
        cmp rax, r15;
        jne lpg_w_fail;

        // NOTHING BEHIND THE WINDOW: 0x800 was never seeded.
        xor rdi, rdi;
        mov rsi, 0x800;
        mov rdx, 48;
        mov rcx, 8;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF28;             // LPSS_GPIO_ID_NO_PART
        cmp rax, r15;
        jne lpg_w_fail;

        // EXTENT LEAVES THE BAR: 0x1900 + 0x600 = 0x1F00 is inside the
        // 0x2000 window, but 24 pads at 16 bytes runs to 0x2080. Refused
        // rather than clipped: a clipped community has pads whose
        // registers fall outside the capability, and every access to
        // them would be refused by the seam with a range error naming
        // the wrong problem.
        xor rdi, rdi;
        mov rsi, 0x1900;
        mov rdx, 48;
        mov rcx, 24;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF21;             // LPSS_GPIO_COMM_WINDOW
        cmp rax, r15;
        jne lpg_w_fail;

        xor rdi, rdi;
        call lpss_gpio_comm_count;
        cmp rax, 2;                      // three refusals, nothing added
        jne lpg_w_fail;

        // ================================================================
        // H. THE SEAM, in both of its refusing directions.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        // An offset past the window is REFUSED, not clamped.
        mov rdi, 0x2000;
        mov rsi, 1;
        call gpio_io_write32;
        mov r15, 0xFFFFFF0A;             // GPIO_IO_RANGE
        cmp rax, r15;
        jne lpg_w_fail;

        mov rdi, 0x2000;
        call gpio_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // GPIO_IO_FAULT
        cmp rax, r15;
        jne lpg_w_fail;

        // A wrong-kind slot cannot be bound.
        mov rdi, 57;                     // KIND_DEVICE
        call gpio_io_bind;
        mov r15, 0xFFFFFF0E;             // GPIO_IO_WRONG_KIND
        cmp rax, r15;
        jne lpg_w_fail;
        call gpio_io_window_slot;
        cmp rax, 58;                     // the refused bind changed nothing
        jne lpg_w_fail;

        // A READ-ONLY window refuses a write and nothing is stored.
        mov rdi, 59;
        call gpio_io_bind;
        cmp rax, 0;
        jne lpg_w_fail;
        mov rdi, 0x40;
        mov rsi, 0x5A5A5A5A;
        call gpio_io_write32;
        mov r15, 0xFFFFFF0B;             // GPIO_IO_NO_WRITE
        cmp rax, r15;
        jne lpg_w_fail;
        mov rdi, 0x40;
        call gpio_io_synth_peek;
        cmp rax, 0;
        jne lpg_w_fail;
        // ... but a read through it works.
        mov rdi, 0x40;
        call gpio_io_read32;
        cmp rax, 0;
        jne lpg_w_fail;

        // A REVOKED window stops access IMMEDIATELY. There is no cached
        // base to go stale into a still-working pointer, which is the
        // entire reason the seam stores a SLOT and re-resolves it. The
        // revoke clears the descriptor, so the slot is no longer a
        // window at all and the refusal is WRONG_KIND.
        mov rdi, 59;
        call lpg_w_row_of;
        mov r13, rax;                    // the op-region row it named

        mov rdi, 59;
        call opregion_cap_revoke;
        cmp rax, 0;
        jne lpg_w_fail;
        mov rdi, 0x40;
        call gpio_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // GPIO_IO_FAULT
        cmp rax, r15;
        jne lpg_w_fail;
        mov rdi, 0x40;
        mov rsi, 1;
        call gpio_io_write32;
        mov r15, 0xFFFFFF0E;             // GPIO_IO_WRONG_KIND
        cmp rax, r15;
        jne lpg_w_fail;

        // AND THE TIME-OF-CHECK-TO-TIME-OF-USE CASE, which is the one a
        // bind-time-only check would miss entirely. Put a descriptor
        // back in the slot that still LOOKS like a window -- right kind,
        // full rights, pointing at the row the revoke just freed. That
        // is exactly what a revoked-and-reused slot looks like from the
        // seam's side, and the only thing that catches it is the row
        // liveness check on every access.
        mov rdi, 59;
        mov rsi, 0x150;                  // KIND_OP_REGION
        mov rdx, 0x61B;                  // R_OPREG_ALL
        mov rcx, r13;
        call lpg_w_seed;

        mov rdi, 0x40;
        mov rsi, 1;
        call gpio_io_write32;
        mov r15, 0xFFFFFF0D;             // GPIO_IO_DEAD_ROW
        cmp rax, r15;
        jne lpg_w_fail;
        mov rdi, 0x40;
        call gpio_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // ... and nothing was stored on the way through.
        mov rdi, 0x40;
        call gpio_io_synth_peek;
        cmp rax, 0;
        jne lpg_w_fail;

        mov rdi, 59;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call lpg_w_seed;

        mov rdi, 58;
        call gpio_io_bind;
        cmp rax, 0;
        jne lpg_w_fail;

        // ================================================================
        // I. THE MAPPING.
        //
        // Community 0 is pins 0..23 based at 0; community 1 is pins
        // 24..47 based at 24. The community-1 answers are the ones an
        // implementation that never subtracted pin_base would get wrong,
        // and they are the only ones that can be wrong: on community 0
        // the mapping IS the identity.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        // Community 0, pin 5 -> (0, 5). Packed community<<16 | pad.
        mov rdi, 0x1F00;
        mov rsi, 5;
        call lpss_gpio_resolve_pin;
        cmp rax, 5;
        jne lpg_w_fail;

        // Community 0's last pin.
        mov rdi, 0x1F00;
        mov rsi, 23;
        call lpss_gpio_resolve_pin;
        cmp rax, 23;
        jne lpg_w_fail;

        // THE BOUNDARY: pin 24 is community 1's pad 0, not community 0's
        // pad 24. An off-by-one in either direction shows up here.
        mov rdi, 0x1F00;
        mov rsi, 24;
        call lpss_gpio_resolve_pin;
        mov r15, 0x10000;                // community 1, pad 0
        cmp rax, r15;
        jne lpg_w_fail;

        // OUTSIDE COMMUNITY 0: pin 29 is community 1's pad 5. An
        // implementation that returned pad 29 -- the identity mapping
        // that is correct on every pin of community 0 -- fails here and
        // nowhere else.
        mov rdi, 0x1F00;
        mov rsi, 29;
        call lpss_gpio_resolve_pin;
        mov r15, 0x10005;                // community 1, pad 5
        cmp rax, r15;
        jne lpg_w_fail;

        // Community 1's last pin.
        mov rdi, 0x1F00;
        mov rsi, 47;
        call lpss_gpio_resolve_pin;
        mov r15, 0x10017;                // community 1, pad 23
        cmp rax, r15;
        jne lpg_w_fail;

        // A pin past every community is UNMAPPED -- not clamped to the
        // nearest legal pad, which on this part would be a real pin
        // nobody asked for.
        mov rdi, 0x1F00;
        mov rsi, 48;
        call lpss_gpio_resolve_pin;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // GPIO_MAP_UNMAPPED
        cmp rax, r15;
        jne lpg_w_fail;

        // A controller with no communities described answers UNMAPPED,
        // not NO_CTRL: it exists, it just routes nothing yet.
        mov rdi, 0x1F01;
        mov rsi, 5;
        call lpss_gpio_resolve_pin;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // An unknown controller answers NO_CTRL. Two sentinels, because
        // a mistyped controller id and an unrouted pin are different
        // operator problems.
        mov rdi, 0xDEAD;
        mov rsi, 5;
        call lpss_gpio_resolve_pin;
        mov r15, 0xFFFFFFFFFFFFFFFE;     // GPIO_MAP_NO_CTRL
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // J. THE TRACE.
        //
        // Two claims, neither of which final register state can express.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        // (a) ORDERING: community 1's REVID was read before its PADBAR.
        //     The PADCFG offset comes from PADBAR, so a driver that
        //     accepted the community before reading its header accepted
        //     a geometry it had not measured.
        mov rdi, 1;                      // GPIO_TRACE_OP_READ
        mov rsi, 0x1000;
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je lpg_w_fail;
        mov r12, rax;                    // REVID position

        mov rdi, 1;
        mov rsi, 0x100C;
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je lpg_w_fail;
        cmp r12, rax;
        jae lpg_w_fail;                  // REVID must come first

        // (b) NO COMMUNITY HEADER WAS EVER WRITTEN. REVID, CAPLIST and
        //     PADBAR are read-only on the part; a cell array would
        //     absorb a write and then answer with it, so this is the
        //     one assertion that catches a driver configuring the
        //     geometry it then "measures".
        mov rdi, 2;                      // GPIO_TRACE_OP_WRITE
        xor rsi, rsi;                    // REVID, community 0
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        mov rdi, 2;
        mov rsi, 0x0C;                   // PADBAR, community 0
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        mov rdi, 2;
        mov rsi, 0x1000;                 // REVID, community 1
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        mov rdi, 2;
        mov rsi, 0x100C;                 // PADBAR, community 1
        xor rdx, rdx;
        call lpss_gpio_wit_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // K. Community table exhaustion.
        //
        // Fourteen more descriptions on controller 0 fill the sixteen-row
        // table; the seventeenth is refused. They share community 0's
        // register window, which no real part does -- nothing in the
        // model forbids it and this sub-test is about table capacity, not
        // about geometry -- and their pin ranges are disjoint from the
        // real ones so the mapping assertions above stay meaningful.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        mov r13, 100;                    // pin base cursor
        xor r14, r14;                    // added
      lpg_w_fill:
        cmp r14, 14;
        jae lpg_w_fill_done;
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, r13;
        mov rcx, 4;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF08;
        cmp rax, r15;
        jae lpg_w_fail;                  // any refusal is a failure here
        add r13, 4;
        add r14, 1;
        jmp lpg_w_fill;

      lpg_w_fill_done:
        xor rdi, rdi;
        call lpss_gpio_comm_count;
        cmp rax, 16;
        jne lpg_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, r13;
        mov rcx, 4;
        call lpss_gpio_add_community;
        mov r15, 0xFFFFFF24;             // LPSS_GPIO_COMM_ENOSPC
        cmp rax, r15;
        jne lpg_w_fail;

        // The mapping is unchanged by the filler communities.
        mov rdi, 0x1F00;
        mov rsi, 29;
        call lpss_gpio_resolve_pin;
        mov r15, 0x10005;
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // L. RELEASE takes the communities with it.
        //
        // A community row names its controller by INDEX, so one that
        // outlived its controller would attach itself to whatever the
        // next probe put in that slot and apply one part's pin map to
        // another.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call lpss_gpio_release;
        cmp rax, 0;
        jne lpg_w_fail;

        call lpss_gpio_ctrl_count;
        cmp rax, 2;
        jne lpg_w_fail;

        mov rdi, 0x1F00;
        call lpss_gpio_find_by_ctrl_id;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // The pin map went with it.
        mov rdi, 0x1F00;
        mov rsi, 29;
        call lpss_gpio_resolve_pin;
        mov r15, 0xFFFFFFFFFFFFFFFE;     // GPIO_MAP_NO_CTRL
        cmp rax, r15;
        jne lpg_w_fail;

        // And so did the window: the seam is still bound to slot 58, and
        // the release revoked it.
        mov rdi, 0x40;
        call gpio_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpg_w_fail;

        // Releasing an already-free row is refused rather than silently
        // accepted, so a double teardown is visible.
        xor rdi, rdi;
        call lpss_gpio_release;
        mov r15, 0xFFFFFF2E;             // LPSS_GPIO_BAD_IDX
        cmp rax, r15;
        jne lpg_w_fail;

        // ================================================================
        // M. Leave everything as we found it.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _lpg_w_stage];
        mov [rcx], rax;

        call lpg_w_teardown;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpss_gpio_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_w_fail:
        call lpg_w_teardown;

        lea rax, [rip + _lpg_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpss_gpio_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_wit_find(op, off, from) -> idx | GPIO_TRACE_NOT_FOUND
  //
  // A thin forwarder to gpio_io_trace_find, kept in the fixture so the
  // witness's trace queries go through one place and the seam's own
  // three-argument signature is not duplicated at nine call sites.
  // ==========================================================================

  pub let lpss_gpio_wit_find : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, off: u64, from: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): forward to gpio_io_trace_find. A forwarder rather than direct calls because the ordering and 'never written' assertions are the load-bearing ones in this fixture and they should read the trace through one path -- if the query shape ever changes, it changes once and every assertion moves with it, rather than nine call sites drifting apart. One push (rbx, unused) restores rsp%16 to 0 at the nested call. Reserved labels: none.",
      block: {
        push rbx;
        call gpio_io_trace_find;
        pop rbx;
        ret
      }
    }

}
