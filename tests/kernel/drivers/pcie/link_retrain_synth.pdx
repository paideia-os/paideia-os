// tests/kernel/drivers/pcie/link_retrain_synth.pdx — R35.M1-004 (#1198)
//
// Boot witness for the PCIe LTSSM link-retrain scaffold. Asserts
// trigger bit set, is_training decode, speed/width decode, TIMEOUT
// on still-training snapshot, BAD_ITERS on out-of-range iters_cap,
// happy-path sequence.
//
// Fingerprint: R35 PCIE LINK RETRAIN OK

module LinkRetrainSynth = structure {

  pub let mut _plr_w_stage : u64 = 0

  pub let plr_w_ok   : [u8; 26] = "R35 PCIE LINK RETRAIN OK\n\0"
  pub let plr_w_fail : [u8; 28] = "R35 PCIE LINK RETRAIN FAIL\n\0"

  pub let pcie_link_retrain_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M1-004 (#1198): boot witness. Stages: (1) reset. (2) trigger sets bit 5. (3) is_training decode. (4) speed decode. (5) width decode. (6) TIMEOUT on still-training. (7) BAD_ITERS. (8) happy path.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        call pcie_link_retrain_reset;

        // -- 2. Trigger sets bit 5.
        mov rax, 2;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pcie_lr_trigger;
        cmp rax, 0x0020;
        jne plr_w_fail_stage;

        mov rdi, 0x0040;
        call pcie_lr_trigger;
        cmp rax, 0x0060;                 // preserves other bits + sets bit 5
        jne plr_w_fail_stage;

        // -- 3. is_training decode.
        mov rax, 3;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0800;                 // bit 11 set
        call pcie_lr_is_training;
        cmp rax, 1;
        jne plr_w_fail_stage;

        mov rdi, 0x0400;                 // bit 11 clear
        call pcie_lr_is_training;
        cmp rax, 0;
        jne plr_w_fail_stage;

        // -- 4. Speed decode: Link Status with speed 3 (8.0 GT/s).
        mov rax, 4;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0043;                 // width=4 (x4), speed=3
        call pcie_lr_decode_speed;
        cmp rax, 3;
        jne plr_w_fail_stage;

        // Invalid speed (0).
        mov rdi, 0x0040;                 // speed=0
        call pcie_lr_decode_speed;
        mov r11, 0xFFFFFA0D;
        cmp rax, r11;
        jne plr_w_fail_stage;

        // -- 5. Width decode: width=4 (x4).
        mov rax, 5;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0043;
        call pcie_lr_decode_width;
        cmp rax, 4;
        jne plr_w_fail_stage;

        // Invalid width (5, not in {1,2,4,8,16,32}).
        mov rdi, 0x0053;
        call pcie_lr_decode_width;
        mov r11, 0xFFFFFA0C;
        cmp rax, r11;
        jne plr_w_fail_stage;

        // -- 6. TIMEOUT on still-training snapshot.
        mov rax, 6;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0843;                 // training snapshot (bit 11 set)
        mov rsi, 0x0843;                 // "done" snapshot ALSO training
        mov rdx, 1000;
        call pcie_lr_sequence;
        mov r11, 0xFFFFFA0B;             // TIMEOUT
        cmp rax, r11;
        jne plr_w_fail_stage;

        // -- 7. BAD_ITERS.
        mov rax, 7;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0843;
        mov rsi, 0x0043;
        xor rdx, rdx;                    // iters_cap = 0
        call pcie_lr_sequence;
        mov r11, 0xFFFFFA0E;             // BAD_ITERS
        cmp rax, r11;
        jne plr_w_fail_stage;

        mov rdi, 0x0843;
        mov rsi, 0x0043;
        mov rdx, 2000000;                // iters_cap > MAX
        call pcie_lr_sequence;
        mov r11, 0xFFFFFA0E;
        cmp rax, r11;
        jne plr_w_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _plr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0843;
        mov rsi, 0x0043;                 // speed=3, width=4, not training
        mov rdx, 1000;
        call pcie_lr_sequence;
        // packing: speed[7:0] | width[13:8]
        // expected: 3 | (4 << 8) = 3 | 0x400 = 0x403
        cmp rax, 0x403;
        jne plr_w_fail_stage;

        mov rdi, 1;                      // SUCCESS
        call pcie_link_retrain_stat;
        cmp rax, 1;
        jne plr_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plr_w_ok];
        call klog_s1;

        call pcie_link_retrain_reset;
        xor rax, rax;
        jmp plr_w_out;

      plr_w_fail_stage:
        lea rax, [rip + _plr_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plr_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pcie_link_retrain_reset;
        mov rax, 1;

      plr_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
