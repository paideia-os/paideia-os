// tests/kernel/drivers/pcie/hotplug_isr_synth.pdx — R35.M1-001 (#1195)
//
// Boot witness for the PCIe root-port service-interrupt ISR
// scaffold. Asserts Slot Status decoding, clear mask, and end-to-end
// service against synthetic snapshots.
//
// Fingerprint: PCIE HOTPLUG ISR OK
//
// No cap slots consumed — the ISR scaffold is pure state and stats.

module HotplugIsrSynth = structure {

  pub let mut _piso_w_stage : u64 = 0

  pub let piso_w_ok   : [u8; 21] = "PCIE HOTPLUG ISR OK\n\0"
  pub let piso_w_fail : [u8; 23] = "PCIE HOTPLUG ISR FAIL\n\0"

  pub let pcie_hotplug_isr_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M1-001 (#1195): boot witness. Stages: (1) reset. (2) decode empty (0x0). (3) decode presence + DLL. (4) decode all four. (5) clear mask. (6) service single event. (7) service spurious. (8) reject bad bdf.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        call pcie_hotplug_isr_reset;
        call pcie_hotplug_channel_reset;

        // -- 2. Decode empty.
        mov rax, 2;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pcie_hotplug_isr_decode;
        cmp rax, 0;
        jne piso_w_fail_stage;

        // -- 3. Decode presence + DLL.
        mov rax, 3;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0108;                 // PRESENCE (bit 3) + DLL (bit 8)
        call pcie_hotplug_isr_decode;
        cmp rax, 0x3;                    // PRESENCE (0x1) | DLL (0x2)
        jne piso_w_fail_stage;

        // -- 4. Decode all four.
        mov rax, 4;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0x011A;                 // all handled bits
        call pcie_hotplug_isr_decode;
        cmp rax, 0xF;                    // 0x1 | 0x2 | 0x4 | 0x8
        jne piso_w_fail_stage;

        // -- 5. Clear mask.
        mov rax, 5;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0xFFFF;
        call pcie_hotplug_isr_clear_mask;
        cmp rax, 0x011A;
        jne piso_w_fail_stage;

        // -- 6. Service single event (PRESENCE).
        mov rax, 6;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;                 // bdf
        mov rsi, 0x0008;                 // Slot Status: PRESENCE bit
        call pcie_hotplug_isr_service;
        cmp rax, 1;                      // 1 event enqueued
        jne piso_w_fail_stage;

        mov rdi, 0;                      // INTERRUPTS
        call pcie_hotplug_isr_stat;
        cmp rax, 1;
        jne piso_w_fail_stage;

        mov rdi, 1;                      // PRESENCE
        call pcie_hotplug_isr_stat;
        cmp rax, 1;
        jne piso_w_fail_stage;

        // -- 7. Service spurious (Slot Status with no handled bits).
        mov rax, 7;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;
        mov rsi, 0x0040;                 // PRESENCE_DETECT bit only (state, not event)
        call pcie_hotplug_isr_service;
        cmp rax, 0;                      // 0 events enqueued
        jne piso_w_fail_stage;

        mov rdi, 5;                      // SPURIOUS
        call pcie_hotplug_isr_stat;
        cmp rax, 1;
        jne piso_w_fail_stage;

        // -- 8. Reject bad bdf.
        mov rax, 8;
        lea rcx, [rip + _piso_w_stage];
        mov [rcx], rax;

        mov rdi, 0x10000;                // out of range
        mov rsi, 0x0008;
        call pcie_hotplug_isr_service;
        mov r11, 0xFFFFFA2F;             // BAD_ARG
        cmp rax, r11;
        jne piso_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + piso_w_ok];
        call klog_s1;

        call pcie_hotplug_isr_reset;
        call pcie_hotplug_channel_reset;
        xor rax, rax;
        jmp piso_w_out;

      piso_w_fail_stage:
        lea rax, [rip + _piso_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + piso_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pcie_hotplug_isr_reset;
        call pcie_hotplug_channel_reset;
        mov rax, 1;

      piso_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
