// tests/kernel/drivers/usb/uvc/uvc_synth_synth.pdx — R34.M5-004 (#1189)
//
// Boot witness for src/kernel/core/drivers/usb/uvc/uvc_synth.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) class validator (0x0E, 0x01) / (0x0E, 0x02) accept, others refuse
//   (3) header parser: hdr_len 2, flags 0x80 (EOH only) OK
//   (4) header parser refuses reserved bit set (0x10)
//   (5) header parser: ERR bit returns UVC_ERR_BIT_SET
//   (6) frame assembly: append body, EOF -> frames_delivered++
//   (7) FID toggle implicitly starts a new frame
//   (8) overflow refuses payload > FRAME_MAX_BYTES
//
// Fingerprint: UVC SYNTH OK

module UvcSynthSynth = structure {

  pub let mut _uvc_w_stage : u64 = 0

  pub let uvc_w_ok   : [u8; 13] = "UVC SYNTH OK\0"
  pub let uvc_w_fail : [u8; 16] = "UVC SYNTH FAIL\0"

  // Header scratch: 12 bytes max. Two u64 aligned = 16 bytes.
  pub let mut _uvc_w_hdr : [u64; 2] = uninit @align(64)

  pub let uvc_synth_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M5-004 (#1189): uvc_synth scaffold witness. Stages: (1) honesty. (2) class validator. (3) header parse OK. (4) reserved bit refused. (5) ERR bit reported. (6) frame assembly + EOF. (7) FID toggle starts new frame. (8) overflow refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        call uvc_reset;

        // -- 1. Honesty pin.
        call uvc_arbitrated;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        // -- 2. Class validator.
        mov rax, 2;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        mov rdi, 0x0E;
        mov rsi, 0x01;
        call uvc_class_valid;
        cmp rax, 1;
        jne uvc_w_fail_stage;

        mov rdi, 0x0E;
        mov rsi, 0x02;
        call uvc_class_valid;
        cmp rax, 1;
        jne uvc_w_fail_stage;

        mov rdi, 0x0E;
        mov rsi, 0x03;
        call uvc_class_valid;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        mov rdi, 0x0F;
        mov rsi, 0x01;
        call uvc_class_valid;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        // -- 3. Header parse: hdr_len=2, flags=EOH(0x80).
        mov rax, 3;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _uvc_w_hdr];
        mov rax, 2;
        mov [r10 + 0], al;               // hdr_len
        mov rax, 0x80;
        mov [r10 + 1], al;               // flags = EOH

        lea rdi, [rip + _uvc_w_hdr];
        mov rsi, 12;
        call uvc_header_parse;
        mov r11, 0x8002;                 // hdr_len=2, flags=0x80 packed
        cmp rax, r11;
        jne uvc_w_fail_stage;

        // -- 4. Reserved bit set.
        mov rax, 4;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _uvc_w_hdr];
        mov rax, 2;
        mov [r10 + 0], al;
        mov rax, 0x10;                   // reserved bit set
        mov [r10 + 1], al;

        lea rdi, [rip + _uvc_w_hdr];
        mov rsi, 12;
        call uvc_header_parse;
        mov r11, 0xFFFFFA9A;
        cmp rax, r11;
        jne uvc_w_fail_stage;

        // -- 5. ERR bit reported.
        mov rax, 5;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _uvc_w_hdr];
        mov rax, 2;
        mov [r10 + 0], al;
        mov rax, 0x40;                   // ERR
        mov [r10 + 1], al;

        lea rdi, [rip + _uvc_w_hdr];
        mov rsi, 12;
        call uvc_header_parse;
        mov r11, 0xFFFFFA99;
        cmp rax, r11;
        jne uvc_w_fail_stage;

        // -- 6. Frame assembly + EOF finalises.
        mov rax, 6;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        call uvc_reset;

        // Two body-only appends (FID=0, no EOF), then EOF.
        mov rdi, 1024;
        mov rsi, 0;                      // FID=0
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        call uvc_frame_bytes;
        cmp rax, 1024;
        jne uvc_w_fail_stage;

        mov rdi, 512;
        mov rsi, 0;
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        call uvc_frame_bytes;
        cmp rax, 1536;
        jne uvc_w_fail_stage;

        mov rdi, 256;
        mov rsi, 2;                      // EOF
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        call uvc_frames_delivered;
        cmp rax, 1;
        jne uvc_w_fail_stage;

        call uvc_frame_bytes;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        call uvc_in_progress;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        // -- 7. FID toggle starts new frame.
        mov rax, 7;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        call uvc_reset;

        mov rdi, 1024;
        mov rsi, 0;                      // FID=0
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;
        call uvc_frame_bytes;
        cmp rax, 1024;
        jne uvc_w_fail_stage;

        // No EOF; next append with FID=1 implicitly begins new frame.
        mov rdi, 512;
        mov rsi, 1;                      // FID=1, no EOF
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;
        call uvc_frame_bytes;
        cmp rax, 512;
        jne uvc_w_fail_stage;

        call uvc_current_fid;
        cmp rax, 1;
        jne uvc_w_fail_stage;

        // -- 8. Oversize refused.
        mov rax, 8;
        lea rcx, [rip + _uvc_w_stage];
        mov [rcx], rax;

        call uvc_reset;

        // Push to just under FRAME_MAX; extra append > remaining
        // -> UVC_FRAME_OVERSIZE.
        mov rdi, 65535;                  // 65535 < 65536, OK
        mov rsi, 0;
        call uvc_frame_append;
        cmp rax, 0;
        jne uvc_w_fail_stage;

        mov rdi, 2;                      // total would be 65537
        mov rsi, 0;
        call uvc_frame_append;
        mov r11, 0xFFFFFA98;
        cmp rax, r11;
        jne uvc_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uvc_w_ok];
        call klog_s1;

        call uvc_reset;
        xor rax, rax;
        jmp uvc_w_out;

      uvc_w_fail_stage:
        lea rax, [rip + _uvc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uvc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call uvc_reset;
        mov rax, 1;

      uvc_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
