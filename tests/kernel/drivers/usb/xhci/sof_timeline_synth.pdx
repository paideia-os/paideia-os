// tests/kernel/drivers/usb/xhci/sof_timeline_synth.pdx — R34.M5-002 (#1187)
//
// Boot witness for src/kernel/core/drivers/usb/xhci/sof_timeline.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) budget-ceiling set/get + BAD_BUDGET refusal
//   (3) admit accepts up to ceiling, rejects thereafter
//   (4) yield_microframe resets charge, advances uframe
//   (5) uframe wraps 7 -> 0 and steps frame_index
//   (6) frame_index wraps 2047 -> 0 and bumps WRAPS stat
//   (7) sof_frames_after arithmetic (delta 8 uframes == +1 frame)
//
// Fingerprint: XHCI SOF TIMELINE OK

module SofTimelineSynth = structure {

  pub let mut _sof_w_stage : u64 = 0

  pub let sof_w_ok   : [u8; 22] = "XHCI SOF TIMELINE OK\0"
  pub let sof_w_fail : [u8; 24] = "XHCI SOF TIMELINE FAIL\0"

  pub let sof_timeline_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M5-002 (#1187): sof_timeline scaffold witness. Stages: (1) honesty. (2) budget ceiling set/get + BAD_BUDGET. (3) admit accept/reject. (4) yield resets + advances. (5) uframe wrap steps frame. (6) frame wrap 2047->0. (7) frames_after arithmetic.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_timeline_reset;

        // -- 1. Honesty pin.
        call sof_timeline_arbitrated;
        cmp rax, 0;
        jne sof_w_fail_stage;

        // -- 2. Ceiling set/get + BAD_BUDGET.
        mov rax, 2;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_budget_ceiling;
        cmp rax, 3072;
        jne sof_w_fail_stage;

        mov rdi, 1500;
        call sof_set_budget_ceiling;
        cmp rax, 0;
        jne sof_w_fail_stage;

        call sof_budget_ceiling;
        cmp rax, 1500;
        jne sof_w_fail_stage;

        mov rdi, 3073;
        call sof_set_budget_ceiling;
        mov r11, 0xFFFFFABD;             // BAD_BUDGET
        cmp rax, r11;
        jne sof_w_fail_stage;

        // -- 3. Admit accepts up to ceiling, rejects thereafter.
        mov rax, 3;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        mov rdi, 1024;
        call sof_admit;
        cmp rax, 1;
        jne sof_w_fail_stage;
        mov rdi, 476;
        call sof_admit;
        cmp rax, 1;
        jne sof_w_fail_stage;                // total 1500 == ceiling
        mov rdi, 1;
        call sof_admit;
        cmp rax, 0;
        jne sof_w_fail_stage;                // rejected

        call sof_budget_charge;
        cmp rax, 1500;
        jne sof_w_fail_stage;

        // -- 4. Yield resets charge and advances uframe.
        mov rax, 4;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_uframe_index;
        mov r12, rax;                    // baseline uframe
        call sof_yield_microframe;
        call sof_budget_charge;
        cmp rax, 0;
        jne sof_w_fail_stage;

        call sof_uframe_index;
        mov r13, rax;
        sub r13, r12;
        cmp r13, 1;
        jne sof_w_fail_stage;

        // -- 5. uframe wraps 7 -> 0 and steps frame_index.
        mov rax, 5;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_timeline_reset;
        // Push uframe up to 7 with 7 yields.
        mov rbx, 0;
      sof_w_pump1:
        cmp rbx, 7;
        jae sof_w_pump1_done;
        call sof_yield_microframe;
        add rbx, 1;
        jmp sof_w_pump1;
      sof_w_pump1_done:
        call sof_uframe_index;
        cmp rax, 7;
        jne sof_w_fail_stage;
        call sof_frame_index;
        cmp rax, 0;
        jne sof_w_fail_stage;

        call sof_yield_microframe;
        call sof_uframe_index;
        cmp rax, 0;
        jne sof_w_fail_stage;
        call sof_frame_index;
        cmp rax, 1;
        jne sof_w_fail_stage;

        // -- 6. frame_index wraps at 2047 -> 0.
        //   Reset, then run 2047 * 8 = 16376 uframes plus 8 more to
        //   land on frame 0 again. Too expensive as a linear loop, so
        //   we assert wrap by a smaller cycle: reset, run 8 uframes
        //   (frame=1), then run 8*2047 more expressed as an outer
        //   loop. To keep runtime bounded, we test the wrap by direct
        //   inspection: reset, then advance 8 uframes 2048 times.
        //   16384 iterations at ~10 insns each ~= 160K instructions,
        //   modest for a boot witness.
        mov rax, 6;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_timeline_reset;
        mov rbx, 0;
      sof_w_pump2:
        mov r11, 16384;                  // 2048 * 8
        cmp rbx, r11;
        jae sof_w_pump2_done;
        call sof_yield_microframe;
        add rbx, 1;
        jmp sof_w_pump2;
      sof_w_pump2_done:
        call sof_frame_index;
        cmp rax, 0;
        jne sof_w_fail_stage;

        mov rdi, 4;                      // SOF_ST_WRAPS
        call sof_timeline_stat;
        cmp rax, 1;
        jne sof_w_fail_stage;

        // -- 7. frames_after: delta=8 uframes == frame+1 (mod 2048).
        mov rax, 7;
        lea rcx, [rip + _sof_w_stage];
        mov [rcx], rax;

        call sof_timeline_reset;
        mov rdi, 8;
        call sof_frames_after;
        cmp rax, 1;
        jne sof_w_fail_stage;

        mov rdi, 16;
        call sof_frames_after;
        cmp rax, 2;
        jne sof_w_fail_stage;

        // Refuse delta > 2048*8.
        mov rdi, 16385;
        call sof_frames_after;
        mov r11, 0xFFFFFABF;             // BAD_ARG
        cmp rax, r11;
        jne sof_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sof_w_ok];
        call klog_s1;

        call sof_timeline_reset;
        xor rax, rax;
        jmp sof_w_out;

      sof_w_fail_stage:
        lea rax, [rip + _sof_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sof_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sof_timeline_reset;
        mov rax, 1;

      sof_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
