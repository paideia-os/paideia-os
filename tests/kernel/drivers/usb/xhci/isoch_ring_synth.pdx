// tests/kernel/drivers/usb/xhci/isoch_ring_synth.pdx — R34.M5-003 (#1188)
//
// Boot witness for src/kernel/core/drivers/usb/xhci/isoch_ring.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) attach + duplicate-attach refuse
//   (3) append TRB records sfi + length
//   (4) BAD_LENGTH refusal
//   (5) ring wrap flips cycle bit and bumps WRAPS stat
//   (6) enforce_interval refuses tight spacing
//   (7) detach clears rows + stat
//
// Fingerprint: XHCI ISOCH RING OK

module IsochRingSynth = structure {

  pub let mut _iring_w_stage : u64 = 0

  pub let iring_w_ok   : [u8; 21] = "XHCI ISOCH RING OK\n\0\0"
  pub let iring_w_fail : [u8; 23] = "XHCI ISOCH RING FAIL\n\0\0"

  pub let isoch_ring_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M5-003 (#1188): isoch_ring scaffold witness. Stages: (1) honesty. (2) attach + duplicate. (3) append records. (4) BAD_LENGTH. (5) ring wrap flips cycle. (6) enforce_interval. (7) detach clears.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        call isoch_ring_reset;

        // -- 1. Honesty pin.
        call isoch_ring_arbitrated;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // -- 2. Attach + duplicate.
        mov rax, 2;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // synthetic stream_slot
        call isoch_ring_attach;
        cmp rax, 0;
        jne iring_w_fail_stage;          // first ring should get id 0

        mov rdi, 7;
        call isoch_ring_attach;
        mov r11, 0xFFFFFAA8;             // ALREADY_ATTACHED
        cmp rax, r11;
        jne iring_w_fail_stage;

        mov rdi, 0;
        call isoch_ring_attach;
        mov r11, 0xFFFFFAAA;             // BAD_STREAM_SLOT
        cmp rax, r11;
        jne iring_w_fail_stage;

        // -- 3. Append records sfi + length; cycle_bit == 1 initially.
        mov rax, 3;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call isoch_ring_cycle;
        cmp rax, 1;
        jne iring_w_fail_stage;

        mov rdi, 0;                      // ring_id
        mov rsi, 100;                    // sfi
        mov rdx, 512;                    // length
        call isoch_ring_append;
        cmp rax, 0;
        jne iring_w_fail_stage;          // first TRB at slot 0

        mov rdi, 0;
        call isoch_ring_tail;
        cmp rax, 1;
        jne iring_w_fail_stage;

        mov rdi, 0;
        call isoch_ring_last_frame;
        cmp rax, 100;
        jne iring_w_fail_stage;

        // -- 4. BAD_LENGTH.
        mov rax, 4;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 105;
        mov rdx, 3073;                   // > SOF_BUDGET_MAX
        call isoch_ring_append;
        mov r11, 0xFFFFFAAE;
        cmp rax, r11;
        jne iring_w_fail_stage;

        // -- 5. Ring wrap flips cycle bit.
        //   Advance 15 more appends -> tail wraps 15 -> 0 and cycle
        //   flips to 0.
        mov rax, 5;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        mov rbx, 0;
      iring_w_wrap_loop:
        cmp rbx, 15;
        jae iring_w_wrap_done;
        mov rdi, 0;
        mov rsi, 200;
        add rsi, rbx;
        mov rdx, 128;
        call isoch_ring_append;
        // After enough appends the wrap append itself may hit ENOSPC
        // (head=0, new_tail=0). We tolerate both OK and ENOSPC here;
        // the assertion is on the cycle-bit flip that WRAP triggered.
        add rbx, 1;
        jmp iring_w_wrap_loop;
      iring_w_wrap_done:

        mov rdi, 4;                      // WRAPS stat
        call isoch_ring_stat;
        cmp rax, 1;
        jne iring_w_fail_stage;

        mov rdi, 0;
        call isoch_ring_cycle;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // -- 6. enforce_interval refuses tight spacing.
        mov rax, 6;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        call isoch_ring_reset;
        mov rdi, 3;
        call isoch_ring_attach;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // Set last_stamped by appending one TRB at frame 500.
        mov rdi, 0;
        mov rsi, 500;
        mov rdx, 128;
        call isoch_ring_append;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // Attempt to schedule at frame 502 with interval=4 -> refused
        // (delta=2 < interval=4).
        mov rdi, 0;
        mov rsi, 502;
        mov rdx, 4;
        call isoch_ring_enforce_interval;
        mov r11, 0xFFFFFAAB;             // INTERVAL_VIOL
        cmp rax, r11;
        jne iring_w_fail_stage;

        // frame 504 with interval=4 -> accepted.
        mov rdi, 0;
        mov rsi, 504;
        mov rdx, 4;
        call isoch_ring_enforce_interval;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // -- 7. Detach clears rows and stat.
        mov rax, 7;
        lea rcx, [rip + _iring_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call isoch_ring_detach;
        cmp rax, 0;
        jne iring_w_fail_stage;

        // Detach idempotency check: second detach is NOT_ATTACHED.
        mov rdi, 0;
        call isoch_ring_detach;
        mov r11, 0xFFFFFAA9;
        cmp rax, r11;
        jne iring_w_fail_stage;

        // Find must now report ROW_NONE.
        mov rdi, 3;
        call isoch_ring_find_stream;
        cmp rax, 0xFF;
        jne iring_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + iring_w_ok];
        call klog_s1;

        call isoch_ring_reset;
        xor rax, rax;
        jmp iring_w_out;

      iring_w_fail_stage:
        lea rax, [rip + _iring_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + iring_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call isoch_ring_reset;
        mov rax, 1;

      iring_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
