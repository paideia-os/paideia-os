// tests/kernel/drivers/usb/fp/synaptics_synth.pdx — R34.M6-004 (#1193)
//
// Boot witness for src/kernel/core/drivers/usb/fp/synaptics.pdx.
//
// Asserts honesty pin, op/status validators, cmd/resp round-trip,
// status query, capture frame, template extract, and refusal edges.
//
// Fingerprint: SYNAPTICS OK

module SynapticsSynth = structure {

  pub let mut _syn_w_stage : u64 = 0

  pub let syn_w_ok   : [u8; 14] = "SYNAPTICS OK\n\0"
  pub let syn_w_fail : [u8; 16] = "SYNAPTICS FAIL\n\0"

  pub let mut _syn_w_buf : [u64; 4] = uninit @align(64)

  pub let synaptics_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M6-004 (#1193): synaptics scaffold witness. Stages: (1) honesty. (2) validators. (3) cmd_pack round-trip. (4) resp_parse round-trip (status=1 BUSY). (5) STATUS query. (6) CAPTURE 4096. (7) TEMPLATE extract. (8) BAD_OP, BAD_BUF, BAD_STATUS, BAD_CAPTURE_LEN.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        call synaptics_reset;

        // -- 1. Honesty.
        call synaptics_arbitrated;
        cmp rax, 0;
        jne syn_w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        mov rdi, 0x02;
        call synaptics_op_valid;
        cmp rax, 1;
        jne syn_w_fail_stage;
        mov rdi, 0x0F;
        call synaptics_op_valid;
        cmp rax, 1;
        jne syn_w_fail_stage;
        mov rdi, 0x10;
        call synaptics_op_valid;
        cmp rax, 0;
        jne syn_w_fail_stage;

        mov rdi, 3;
        call synaptics_status_valid;
        cmp rax, 1;
        jne syn_w_fail_stage;
        mov rdi, 4;
        call synaptics_status_valid;
        cmp rax, 0;
        jne syn_w_fail_stage;

        // -- 3. cmd_pack: op = 0x02 (STATUS).
        mov rax, 3;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _syn_w_buf];
        mov rsi, 0x02;
        call synaptics_cmd_pack;
        cmp rax, 0;
        jne syn_w_fail_stage;

        lea r10, [rip + _syn_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0x02;
        jne syn_w_fail_stage;

        // -- 4. resp_parse: status = 1 (BUSY).
        mov rax, 4;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _syn_w_buf];
        mov rax, 1;
        mov [r10 + 0], ax;
        lea rdi, [rip + _syn_w_buf];
        mov rsi, 2;
        call synaptics_resp_parse;
        cmp rax, 1;
        jne syn_w_fail_stage;

        // -- 5. STATUS query.
        mov rax, 5;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _syn_w_buf];
        call synaptics_query_status_pack;
        cmp rax, 0;
        jne syn_w_fail_stage;

        lea r10, [rip + _syn_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0x02;
        jne syn_w_fail_stage;

        // -- 6. CAPTURE 4096.
        mov rax, 6;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _syn_w_buf];
        mov rsi, 4096;
        call synaptics_capture_frame_pack;
        cmp rax, 0;
        jne syn_w_fail_stage;

        lea r10, [rip + _syn_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0x08;
        jne syn_w_fail_stage;

        // -- 7. TEMPLATE extract.
        mov rax, 7;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _syn_w_buf];
        call synaptics_template_extract_pack;
        cmp rax, 0;
        jne syn_w_fail_stage;

        lea r10, [rip + _syn_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0x0F;
        jne syn_w_fail_stage;

        // -- 8a. BAD_OP.
        mov rax, 8;
        lea rcx, [rip + _syn_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _syn_w_buf];
        mov rsi, 0x10;
        call synaptics_cmd_pack;
        mov r11, 0xFFFFFA4D;             // BAD_OP
        cmp rax, r11;
        jne syn_w_fail_stage;

        // -- 8b. BAD_BUF on cmd_pack.
        mov rdi, 0;
        mov rsi, 0x02;
        call synaptics_cmd_pack;
        mov r11, 0xFFFFFA4F;             // BAD_BUF
        cmp rax, r11;
        jne syn_w_fail_stage;

        // -- 8c. BAD_STATUS: build response with status=99.
        lea r10, [rip + _syn_w_buf];
        mov rax, 99;
        mov [r10 + 0], ax;
        lea rdi, [rip + _syn_w_buf];
        mov rsi, 2;
        call synaptics_resp_parse;
        mov r11, 0xFFFFFA4C;             // BAD_STATUS
        cmp rax, r11;
        jne syn_w_fail_stage;

        // -- 8d. BAD_CAPTURE_LEN.
        lea rdi, [rip + _syn_w_buf];
        mov rsi, 65537;
        call synaptics_capture_frame_pack;
        mov r11, 0xFFFFFA4A;             // BAD_CAPTURE_LEN
        cmp rax, r11;
        jne syn_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + syn_w_ok];
        call klog_s1;

        call synaptics_reset;
        xor rax, rax;
        jmp syn_w_out;

      syn_w_fail_stage:
        lea rax, [rip + _syn_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + syn_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call synaptics_reset;
        mov rax, 1;

      syn_w_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
