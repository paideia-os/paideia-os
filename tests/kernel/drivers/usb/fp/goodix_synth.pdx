// tests/kernel/drivers/usb/fp/goodix_synth.pdx — R34.M6-003 (#1192)
//
// Boot witness for src/kernel/core/drivers/usb/fp/goodix.pdx.
//
// Asserts honesty pin, cmd/state validators, cmd/resp round-trip,
// MCU state, image frame, enroll transaction, and refusal edges.
//
// Fingerprint: GOODIX OK

module GoodixSynth = structure {

  pub let mut _gdx_w_stage : u64 = 0

  pub let gdx_w_ok   : [u8; 11] = "GOODIX OK\n\0"
  pub let gdx_w_fail : [u8; 13] = "GOODIX FAIL\n\0"

  pub let mut _gdx_w_buf : [u64; 4] = uninit @align(64)   // 32 bytes

  pub let goodix_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M6-003 (#1192): goodix scaffold witness. Stages: (1) honesty. (2) validators. (3) cmd pack round-trip. (4) resp parse round-trip. (5) MCU_STATE query. (6) IMAGE_FRAME with 1024 bytes. (7) enroll begin/add/commit. (8) BAD_CMD, BAD_BUF, BAD_PAYLOAD.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        call goodix_reset;

        // -- 1. Honesty.
        call goodix_arbitrated;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        mov rdi, 0xA6;
        call goodix_cmd_valid;
        cmp rax, 1;
        jne gdx_w_fail_stage;
        mov rdi, 0xB2;
        call goodix_cmd_valid;
        cmp rax, 1;
        jne gdx_w_fail_stage;
        mov rdi, 0xFF;
        call goodix_cmd_valid;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        mov rdi, 0;                      // READY
        call goodix_mcu_state_valid;
        cmp rax, 1;
        jne gdx_w_fail_stage;
        mov rdi, 3;
        call goodix_mcu_state_valid;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        // -- 3. cmd_pack: cmd = 0xA6, payload_len = 0.
        mov rax, 3;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 0xA6;
        mov rdx, 0;
        call goodix_cmd_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        lea r10, [rip + _gdx_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0xA6;
        jne gdx_w_fail_stage;

        // -- 4. resp_parse: build a 4-byte response.
        mov rax, 4;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _gdx_w_buf];
        mov rax, 0xB2;
        mov [r10 + 0], ax;
        mov rax, 8;
        mov [r10 + 2], ax;               // payload_len = 8

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 12;
        call goodix_resp_parse;
        mov r11, 0xB2;
        mov r12, rax;
        and r12, 0xFFFF;
        cmp r12, r11;
        jne gdx_w_fail_stage;
        mov r12, rax;
        shr r12, 16;
        and r12, 0xFFFF;
        cmp r12, 8;
        jne gdx_w_fail_stage;

        // -- 5. MCU_STATE query.
        mov rax, 5;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gdx_w_buf];
        call goodix_query_mcu_state_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        lea r10, [rip + _gdx_w_buf];
        xor rax, rax;
        mov ax, [r10 + 0];
        cmp rax, 0xA6;
        jne gdx_w_fail_stage;

        // -- 6. IMAGE_FRAME with 1024 bytes.
        mov rax, 6;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 1024;
        call goodix_image_frame_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        // -- 7. enroll begin/add/commit.
        mov rax, 7;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 0;
        call goodix_enroll_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 1;
        call goodix_enroll_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 2;
        call goodix_enroll_pack;
        cmp rax, 0;
        jne gdx_w_fail_stage;

        // -- 8a. BAD_CMD.
        mov rax, 8;
        lea rcx, [rip + _gdx_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 0xFF;
        mov rdx, 0;
        call goodix_cmd_pack;
        mov r11, 0xFFFFFA5D;             // BAD_CMD
        cmp rax, r11;
        jne gdx_w_fail_stage;

        // -- 8b. BAD_BUF.
        mov rdi, 0;
        mov rsi, 0xA6;
        mov rdx, 0;
        call goodix_cmd_pack;
        mov r11, 0xFFFFFA5F;             // BAD_BUF
        cmp rax, r11;
        jne gdx_w_fail_stage;

        // -- 8c. BAD_PAYLOAD.
        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 0xA6;
        mov rdx, 65537;                  // > MAX
        call goodix_cmd_pack;
        mov r11, 0xFFFFFA5C;             // BAD_PAYLOAD
        cmp rax, r11;
        jne gdx_w_fail_stage;

        // -- 8d. enroll BAD_ARG (phase 3).
        lea rdi, [rip + _gdx_w_buf];
        mov rsi, 3;
        call goodix_enroll_pack;
        mov r11, 0xFFFFFA58;             // BAD_ARG
        cmp rax, r11;
        jne gdx_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gdx_w_ok];
        call klog_s1;

        call goodix_reset;
        xor rax, rax;
        jmp gdx_w_out;

      gdx_w_fail_stage:
        lea rax, [rip + _gdx_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gdx_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call goodix_reset;
        mov rax, 1;

      gdx_w_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
