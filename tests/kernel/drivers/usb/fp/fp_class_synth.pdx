// tests/kernel/drivers/usb/fp/fp_class_synth.pdx — R34.M6-002 (#1191)
//
// Boot witness for src/kernel/core/drivers/usb/fp/fp_class.pdx.
//
// Asserts honesty pin returns 0, state-machine transitions
// (init -> enroll_start -> add_frame* -> commit -> verify / delete),
// and refusal edges (BAD_STATE, BAD_FRAMES, BAD_TEMPLATE, ENOSPC).
//
// Fingerprint: FP CLASS OK

module FpClassSynth = structure {

  pub let mut _fpcls_w_stage : u64 = 0

  pub let fpcls_w_ok   : [u8; 13] = "FP CLASS OK\n\0"
  pub let fpcls_w_fail : [u8; 15] = "FP CLASS FAIL\n\0"

  pub let fp_class_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M6-002 (#1191): fp_class scaffold witness. Stages: (1) honesty. (2) validators + reset. (3) enroll_start refused before init. (4) init, enroll_start, add 3 frames, commit -> tid non-zero. (5) verify MATCH bumps MATCHES. (6) verify BAD_TEMPLATE for id 0. (7) delete_template drops back to INIT when last removed. (8) enroll_add_frame BAD_STATE outside ENROLLING. (9) commit BAD_FRAMES with 2 frames.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        call fp_class_reset;

        // -- 1. Honesty.
        call fp_class_arbitrated;
        cmp rax, 0;
        jne fpcls_w_fail_stage;

        // -- 2. State starts at INIT.
        mov rax, 2;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        call fp_class_state;
        cmp rax, 0;                      // FP_ST_INIT
        jne fpcls_w_fail_stage;

        // -- 3. Full enroll happy path.
        mov rax, 3;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        call fp_class_enroll_start;
        cmp rax, 0;
        jne fpcls_w_fail_stage;
        call fp_class_state;
        cmp rax, 1;                      // ENROLLING
        jne fpcls_w_fail_stage;

        call fp_class_enroll_add_frame;
        cmp rax, 0;
        jne fpcls_w_fail_stage;
        call fp_class_enroll_add_frame;
        cmp rax, 0;
        jne fpcls_w_fail_stage;
        call fp_class_enroll_add_frame;
        cmp rax, 0;
        jne fpcls_w_fail_stage;

        call fp_class_frames_captured;
        cmp rax, 3;
        jne fpcls_w_fail_stage;

        call fp_class_enroll_commit;
        mov rbx, rax;                    // tid
        cmp rbx, 0;
        je  fpcls_w_fail_stage;

        call fp_class_state;
        cmp rax, 2;                      // ENROLLED
        jne fpcls_w_fail_stage;

        call fp_class_template_count;
        cmp rax, 1;
        jne fpcls_w_fail_stage;

        // -- 4. Verify MATCH.
        mov rax, 4;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 0;                      // MATCH
        call fp_class_verify;
        cmp rax, 0;                      // outcome MATCH
        jne fpcls_w_fail_stage;

        // MATCHES counter should be 1.
        mov rdi, 2;
        call fp_class_stat;
        cmp rax, 1;
        jne fpcls_w_fail_stage;

        // -- 5. Verify BAD_TEMPLATE for id 0.
        mov rax, 5;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call fp_class_verify;
        mov r11, 0xFFFFFA7D;             // BAD_TEMPLATE
        cmp rax, r11;
        jne fpcls_w_fail_stage;

        // -- 6. delete_template of the one live template drops -> INIT.
        mov rax, 6;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call fp_class_delete_template;
        cmp rax, 0;
        jne fpcls_w_fail_stage;

        call fp_class_state;
        cmp rax, 0;                      // back to INIT
        jne fpcls_w_fail_stage;

        // -- 7. enroll_add_frame BAD_STATE outside ENROLLING.
        mov rax, 7;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        call fp_class_enroll_add_frame;
        mov r11, 0xFFFFFA7E;             // BAD_STATE
        cmp rax, r11;
        jne fpcls_w_fail_stage;

        // -- 8. Commit with only 2 frames -> BAD_FRAMES.
        mov rax, 8;
        lea rcx, [rip + _fpcls_w_stage];
        mov [rcx], rax;

        call fp_class_reset;
        call fp_class_enroll_start;
        cmp rax, 0;
        jne fpcls_w_fail_stage;
        call fp_class_enroll_add_frame;
        cmp rax, 0;
        jne fpcls_w_fail_stage;
        call fp_class_enroll_add_frame;
        cmp rax, 0;
        jne fpcls_w_fail_stage;

        call fp_class_enroll_commit;
        mov r11, 0xFFFFFA7C;             // BAD_FRAMES
        cmp rax, r11;
        jne fpcls_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fpcls_w_ok];
        call klog_s1;

        call fp_class_reset;
        xor rax, rax;
        jmp fpcls_w_out;

      fpcls_w_fail_stage:
        lea rax, [rip + _fpcls_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fpcls_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call fp_class_reset;
        mov rax, 1;

      fpcls_w_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
