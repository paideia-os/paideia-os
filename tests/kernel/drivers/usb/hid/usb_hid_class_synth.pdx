// tests/kernel/drivers/usb/hid/usb_hid_class_synth.pdx — R34.M4-001 (#1181)
//
// Boot witness for src/kernel/core/drivers/usb/hid/usb_hid_class.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) descriptor-type / request / protocol / report-type / poll validators
//   (3) SETUP-packet pack (SET_PROTOCOL) writes bmRequestType/bRequest/wValue
//   (4) GET_PROTOCOL pack (IN direction) sets bmRequestType bit 7
//   (5) SET_IDLE pack wValue = (duration<<8)|report_id
//   (6) Failure edges: BAD_REQ, BAD_PROTOCOL, BAD_BUF
//
// Fingerprint: USB HID CLASS OK

module UsbHidClassSynth = structure {

  pub let mut _hcls_w_stage : u64 = 0

  pub let hcls_w_ok   : [u8; 18] = "USB HID CLASS OK\0"
  pub let hcls_w_fail : [u8; 20] = "USB HID CLASS FAIL\0"

  pub let mut _hcls_w_setup : [u64; 2] = uninit @align(64)   // 16 bytes; SETUP is 8

  pub let usb_hid_class_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M4-001 (#1181): usb_hid_class scaffold witness. Stages: (1) honesty. (2) validators. (3) SET_PROTOCOL pack. (4) GET_PROTOCOL direction bit. (5) SET_IDLE wValue. (6) BAD_REQ, BAD_PROTOCOL, BAD_BUF.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        call hid_class_reset;

        // -- 1. Honesty pin.
        call hid_class_arbitrated;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        mov rdi, 0x21;
        call hid_class_desc_type_valid;
        cmp rax, 1;
        jne hcls_w_fail_stage;
        mov rdi, 0x24;
        call hid_class_desc_type_valid;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        mov rdi, 0x0B;
        call hid_class_req_valid;
        cmp rax, 1;
        jne hcls_w_fail_stage;
        mov rdi, 0x0C;
        call hid_class_req_valid;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        mov rdi, 1;
        call hid_class_protocol_valid;
        cmp rax, 1;
        jne hcls_w_fail_stage;
        mov rdi, 2;
        call hid_class_protocol_valid;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        mov rdi, 1;
        call hid_class_report_type_valid;
        cmp rax, 1;
        jne hcls_w_fail_stage;
        mov rdi, 4;
        call hid_class_report_type_valid;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        mov rdi, 1;
        call hid_class_poll_valid;
        cmp rax, 1;
        jne hcls_w_fail_stage;
        mov rdi, 0;
        call hid_class_poll_valid;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        // -- 3. SET_PROTOCOL pack.
        mov rax, 3;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hcls_w_setup];
        mov rsi, 5;                      // interface = 5
        mov rdx, 1;                      // protocol = REPORT
        call hid_class_set_protocol_pack;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        // bmRequestType at [+0] should be 0x21 (SET_PROTOCOL is OUT).
        lea r10, [rip + _hcls_w_setup];
        xor rax, rax;
        mov_b rax, [r10 + 0];
        cmp rax, 0x21;
        jne hcls_w_fail_stage;
        // bRequest at [+1] should be 0x0B.
        xor rax, rax;
        mov_b rax, [r10 + 1];
        cmp rax, 0x0B;
        jne hcls_w_fail_stage;
        // wValue at [+2] should be 1.
        xor rax, rax;
        mov ax, [r10 + 2];
        cmp rax, 1;
        jne hcls_w_fail_stage;
        // wIndex at [+4] should be 5.
        xor rax, rax;
        mov ax, [r10 + 4];
        cmp rax, 5;
        jne hcls_w_fail_stage;

        // -- 4. GET_PROTOCOL pack (IN direction).
        mov rax, 4;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hcls_w_setup];
        mov rsi, 7;
        call hid_class_get_protocol_pack;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        lea r10, [rip + _hcls_w_setup];
        xor rax, rax;
        mov_b rax, [r10 + 0];
        cmp rax, 0xA1;                   // IN direction
        jne hcls_w_fail_stage;
        xor rax, rax;
        mov_b rax, [r10 + 1];
        cmp rax, 0x03;
        jne hcls_w_fail_stage;
        xor rax, rax;
        mov ax, [r10 + 6];
        cmp rax, 1;                      // wLength
        jne hcls_w_fail_stage;

        // -- 5. SET_IDLE pack: wValue = (duration<<8) | report_id.
        mov rax, 5;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hcls_w_setup];
        mov rsi, 3;                      // interface
        mov rdx, 0x04;                   // duration = 4 (16 ms)
        mov rcx, 0x02;                   // report_id = 2
        call hid_class_set_idle_pack;
        cmp rax, 0;
        jne hcls_w_fail_stage;

        lea r10, [rip + _hcls_w_setup];
        xor rax, rax;
        mov_b rax, [r10 + 1];
        cmp rax, 0x0A;                   // SET_IDLE
        jne hcls_w_fail_stage;
        xor rax, rax;
        mov ax, [r10 + 2];
        mov r11, 0x0402;                 // (4 << 8) | 2
        cmp rax, r11;
        jne hcls_w_fail_stage;

        // -- 6a. BAD_REQ via setup_pack.
        mov rax, 6;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hcls_w_setup];
        mov rsi, 0xFF;                   // not a HID request
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        call hid_class_setup_pack;
        mov r11, 0xFFFFFB1E;             // BAD_REQ
        cmp rax, r11;
        jne hcls_w_fail_stage;

        // -- 6b. BAD_PROTOCOL via set_protocol_pack.
        mov rax, 7;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hcls_w_setup];
        mov rsi, 0;
        mov rdx, 3;                      // not 0/1
        call hid_class_set_protocol_pack;
        mov r11, 0xFFFFFB1D;             // BAD_PROTOCOL
        cmp rax, r11;
        jne hcls_w_fail_stage;

        // -- 6c. BAD_BUF.
        mov rax, 8;
        lea rcx, [rip + _hcls_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // buf = NULL
        mov rsi, 0x0B;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        call hid_class_setup_pack;
        mov r11, 0xFFFFFB1A;             // BAD_BUF
        cmp rax, r11;
        jne hcls_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hcls_w_ok];
        call klog_s1;

        call hid_class_reset;
        xor rax, rax;
        jmp hcls_w_out;

      hcls_w_fail_stage:
        lea rax, [rip + _hcls_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hcls_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hid_class_reset;
        mov rax, 1;

      hcls_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
