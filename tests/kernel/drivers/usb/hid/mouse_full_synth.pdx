// tests/kernel/drivers/usb/hid/mouse_full_synth.pdx — R34.M4-003 (#1183)
//
// Boot witness for src/kernel/core/drivers/usb/hid/mouse_full.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) 12-bit X unpack, positive and sign-extended negative
//   (3) 12-bit Y unpack, positive
//   (4) wheel s8 read (positive)
//   (5) button mask read with max_buttons gate
//   (6) resmult pack (high-res on) round-trip
//   (7) Failure edges: BAD_BUF, BAD_MULT, BAD_BUTTON
//
// Fingerprint: USB HID MOUSE FULL OK

module MouseFullSynth = structure {

  pub let mut _mus_w_stage : u64 = 0

  pub let mus_w_ok   : [u8; 23] = "USB HID MOUSE FULL OK\n\0"
  pub let mus_w_fail : [u8; 25] = "USB HID MOUSE FULL FAIL\n\0"

  // 16 bytes of scratch — buttons(1) + xyxy(3) + wheel(1) + hwheel(1) fits.
  pub let mut _mus_w_buf : [u64; 2] = uninit @align(64)

  pub let mouse_full_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M4-003 (#1183): mouse_full scaffold witness. Stages: (1) honesty. (2) unpack_x12 positive + negative. (3) unpack_y12 positive. (4) wheel read. (5) buttons mask. (6) resmult round-trip. (7) BAD_BUF, BAD_MULT, BAD_BUTTON.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        call mouse_full_reset;

        // -- 1. Honesty pin.
        call mouse_full_arbitrated;
        cmp rax, 0;
        jne mus_w_fail_stage;

        // Build a 3-byte payload with X = 0x123 (+291), Y = 0x456 (+1110):
        //   b0 = X[7:0] = 0x23
        //   b1 = (Y[3:0] << 4) | X[11:8] = (6 << 4) | 1 = 0x61
        //   b2 = Y[11:4] = 0x45
        lea r10, [rip + _mus_w_buf];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov rax, 0x23;
        mov [r10 + 0], al;
        mov rax, 0x61;
        mov [r10 + 1], al;
        mov rax, 0x45;
        mov [r10 + 2], al;

        // -- 2a. unpack_x12 positive.
        mov rax, 2;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 3;
        call mouse_unpack_x12;
        mov r11, 0x123;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // -- 2b. Negative sign-extend. Encode X = 0xF00 (12-bit) which
        //         sign-extends to 0xFFFFFFFFFFFFFF00.
        //   b0 = 0x00; b1 = (Y[3:0] << 4) | X[11:8] = (6 << 4) | 0xF = 0x6F
        lea r10, [rip + _mus_w_buf];
        mov rax, 0x00;
        mov [r10 + 0], al;
        mov rax, 0x6F;
        mov [r10 + 1], al;
        // (b2 unchanged)

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 3;
        call mouse_unpack_x12;
        mov r11, 0xFFFFFFFFFFFFFF00;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // -- 3. unpack_y12 positive with the last-set b1/b2.
        mov rax, 3;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 3;
        call mouse_unpack_y12;
        // Y = (b1 >> 4) | (b2 << 4) = 6 | (0x45 << 4) = 6 | 0x450 = 0x456
        mov r11, 0x456;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // -- 4. Wheel read: put 0x05 at buf[4], call with offset 4.
        mov rax, 4;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _mus_w_buf];
        mov rax, 0x05;
        mov [r10 + 4], al;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 8;
        mov rdx, 4;
        call mouse_read_wheel;
        cmp rax, 5;
        jne mus_w_fail_stage;

        // -- 5. Button mask: buf[0] was 0x00 above; write 0x0F, mask to
        //       max_buttons=3 -> 0x07.
        mov rax, 5;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _mus_w_buf];
        mov rax, 0x0F;
        mov [r10], al;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 8;
        mov rdx, 3;
        call mouse_read_buttons;
        cmp rax, 0x07;
        jne mus_w_fail_stage;

        // -- 6. resmult pack round-trip.
        mov rax, 6;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 8;
        mov rdx, 0x0A;                   // 10 — within 4-bit range
        call mouse_resmult_pack;
        cmp rax, 0;
        jne mus_w_fail_stage;
        lea r10, [rip + _mus_w_buf];
        xor rax, rax;
        mov_b rax, [r10];
        cmp rax, 0x0A;
        jne mus_w_fail_stage;

        // -- 7a. BAD_BUF via unpack_x12.
        mov rax, 7;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;
        call mouse_unpack_x12;
        mov r11, 0xFFFFFAFF;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // -- 7b. BAD_MULT via resmult_pack.
        mov rax, 8;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 8;
        mov rdx, 16;                     // > 15
        call mouse_resmult_pack;
        mov r11, 0xFFFFFAFD;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // -- 7c. BAD_BUTTON via read_buttons.
        mov rax, 9;
        lea rcx, [rip + _mus_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _mus_w_buf];
        mov rsi, 8;
        mov rdx, 9;                      // > 8
        call mouse_read_buttons;
        mov r11, 0xFFFFFAFC;
        cmp rax, r11;
        jne mus_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mus_w_ok];
        call klog_s1;

        call mouse_full_reset;
        xor rax, rax;
        jmp mus_w_out;

      mus_w_fail_stage:
        lea rax, [rip + _mus_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mus_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mouse_full_reset;
        mov rax, 1;

      mus_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
