// tests/kernel/drivers/usb/hid/gamepad_synth.pdx — R34.M4-004 (#1184)
//
// Boot witness for src/kernel/core/drivers/usb/hid/gamepad.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) top-collection validator (0x01, 0x05)
//   (3) axis usage validator
//   (4) axis_read_s16: positive and sign-extended negative samples
//   (5) axis_normalize on midpoint returns ~0
//   (6) hat decode: cardinal + null
//   (7) 32-bit button mask read
//   (8) Failure edges: BAD_BUF, BAD_RANGE, BAD_HAT
//
// Fingerprint: USB HID GAMEPAD OK

module GamepadSynth = structure {

  pub let mut _gp_w_stage : u64 = 0

  pub let gp_w_ok   : [u8; 20] = "USB HID GAMEPAD OK\0"
  pub let gp_w_fail : [u8; 22] = "USB HID GAMEPAD FAIL\0"

  pub let mut _gp_w_buf : [u64; 2] = uninit @align(64)

  pub let gamepad_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M4-004 (#1184): gamepad scaffold witness. Stages: (1) honesty. (2) top-collection. (3) axis usage. (4) axis_read_s16 pos+neg. (5) axis_normalize midpoint. (6) hat decode. (7) buttons u32. (8) BAD_BUF, BAD_RANGE, BAD_HAT.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        call gamepad_reset;

        // -- 1. Honesty pin.
        call gamepad_arbitrated;
        cmp rax, 0;
        jne gp_w_fail_stage;

        // -- 2. Top-collection validator.
        mov rax, 2;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 0x01;
        mov rsi, 0x05;
        call gp_top_collection_valid;
        cmp rax, 1;
        jne gp_w_fail_stage;
        mov rdi, 0x01;
        mov rsi, 0x04;                   // joystick, not gamepad
        call gp_top_collection_valid;
        cmp rax, 0;
        jne gp_w_fail_stage;

        // -- 3. Axis usage validator.
        mov rax, 3;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 0x33;                   // Rx
        call gp_axis_usage_valid;
        cmp rax, 1;
        jne gp_w_fail_stage;
        mov rdi, 0x36;                   // slider — not our axis set
        call gp_axis_usage_valid;
        cmp rax, 0;
        jne gp_w_fail_stage;

        // -- 4a. axis_read_s16 positive: write 0x1234 LE at buf[0..2].
        mov rax, 4;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _gp_w_buf];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov rax, 0x1234;
        mov [r10 + 0], ax;

        lea rdi, [rip + _gp_w_buf];
        mov rsi, 8;
        mov rdx, 0;
        call gp_axis_read_s16;
        mov r11, 0x1234;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // -- 4b. Negative: write 0xF000 (== -4096).
        lea r10, [rip + _gp_w_buf];
        mov rax, 0xF000;
        mov [r10 + 0], ax;

        lea rdi, [rip + _gp_w_buf];
        mov rsi, 8;
        mov rdx, 0;
        call gp_axis_read_s16;
        mov r11, 0xFFFFFFFFFFFFF000;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // -- 5. axis_normalize midpoint: sample=128 in [0, 255] -> ~0.
        //       (128 - 0) * 65535 / 255 = 128 * 257 = 32896;
        //       32896 - 32768 = 128
        mov rax, 5;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0;
        mov rdx, 255;
        call gp_axis_normalize;
        cmp rax, 128;
        jne gp_w_fail_stage;

        // -- 6. Hat decode: N + null.
        mov rax, 6;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gp_hat_decode;
        cmp rax, 0;
        jne gp_w_fail_stage;

        mov rdi, 0x0F;
        call gp_hat_decode;
        cmp rax, 0xFF;                   // GP_HAT_NULL
        jne gp_w_fail_stage;

        // -- 7. Button mask: write 0xDEADBEEF LE at buf[0..4].
        mov rax, 7;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _gp_w_buf];
        mov rax, 0xDEADBEEF;
        mov [r10 + 0], eax;

        lea rdi, [rip + _gp_w_buf];
        mov rsi, 8;
        mov rdx, 0;
        call gp_buttons_read_u32;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // -- 8a. BAD_BUF.
        mov rax, 8;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 8;
        mov rdx, 0;
        call gp_axis_read_s16;
        mov r11, 0xFFFFFAEF;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // -- 8b. BAD_RANGE via axis_normalize with lmin == lmax.
        mov rax, 9;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 128;
        mov rdx, 128;
        call gp_axis_normalize;
        mov r11, 0xFFFFFAEB;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // -- 8c. BAD_HAT via hat_decode(8) — 8 is neither direction nor null.
        mov rax, 10;
        lea rcx, [rip + _gp_w_stage];
        mov [rcx], rax;

        mov rdi, 8;
        call gp_hat_decode;
        mov r11, 0xFFFFFAEC;
        cmp rax, r11;
        jne gp_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gp_w_ok];
        call klog_s1;

        call gamepad_reset;
        xor rax, rax;
        jmp gp_w_out;

      gp_w_fail_stage:
        lea rax, [rip + _gp_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gp_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gamepad_reset;
        mov rax, 1;

      gp_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
