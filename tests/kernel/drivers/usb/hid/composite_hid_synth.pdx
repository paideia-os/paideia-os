// tests/kernel/drivers/usb/hid/composite_hid_synth.pdx — R34.M4-005 (#1185)
//
// Boot witness for src/kernel/core/drivers/usb/hid/composite_hid.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) reset -> count 0
//   (3) add (rid=1, kbd, drv=10) -> row 0
//   (4) class_of(1) == KEYBOARD, driver_of(1) == 10
//   (5) rebind refused (ALREADY_BOUND)
//   (6) add (rid=2, mouse, drv=20); count == 2
//   (7) demux: buf[0]=1 -> KEYBOARD; buf[0]=2 -> MOUSE
//   (8) demux miss returns NOT_BOUND
//   (9) remove(1) -> OK; class_of(1) -> NOT_BOUND
//  (10) BAD_REPORT_ID (0 and 256), BAD_CLASS, ENOSPC at 8
//
// Fingerprint: USB HID COMPOSITE OK

module CompositeHidSynth = structure {

  pub let mut _chid_w_stage : u64 = 0

  pub let chid_w_ok   : [u8; 22] = "USB HID COMPOSITE OK\n\0"
  pub let chid_w_fail : [u8; 24] = "USB HID COMPOSITE FAIL\n\0"

  pub let mut _chid_w_buf : [u64; 2] = uninit @align(64)

  pub let composite_hid_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M4-005 (#1185): composite_hid witness. Stages: (1) honesty. (2) empty count. (3) add row. (4) class_of/driver_of. (5) rebind refused. (6) second add. (7) demux hit. (8) demux miss. (9) remove. (10) BAD_REPORT_ID, BAD_CLASS, ENOSPC.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        call composite_hid_reset;

        // -- 1. Honesty pin.
        call composite_hid_arbitrated;
        cmp rax, 0;
        jne chid_w_fail_stage;

        // -- 2. Empty count.
        mov rax, 2;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        call composite_hid_count;
        cmp rax, 0;
        jne chid_w_fail_stage;

        // -- 3. add (1, KEYBOARD, 10).
        mov rax, 3;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // KEYBOARD
        mov rdx, 10;
        call composite_hid_add;
        cmp rax, 0;                      // row 0
        jne chid_w_fail_stage;

        // -- 4. class_of and driver_of.
        mov rax, 4;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call composite_hid_class_of;
        cmp rax, 1;
        jne chid_w_fail_stage;
        mov rdi, 1;
        call composite_hid_driver_of;
        cmp rax, 10;
        jne chid_w_fail_stage;

        // -- 5. Rebind refused.
        mov rax, 5;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 30;
        call composite_hid_add;
        mov r11, 0xFFFFFADD;             // ALREADY_BOUND
        cmp rax, r11;
        jne chid_w_fail_stage;

        // -- 6. add (2, MOUSE, 20); count == 2.
        mov rax, 6;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 2;                      // MOUSE
        mov rdx, 20;
        call composite_hid_add;
        cmp rax, 1;                      // row 1
        jne chid_w_fail_stage;

        call composite_hid_count;
        cmp rax, 2;
        jne chid_w_fail_stage;

        // -- 7. demux hit: buf[0] = 1, expect KEYBOARD.
        mov rax, 7;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _chid_w_buf];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov rax, 1;
        mov [r10 + 0], al;

        lea rdi, [rip + _chid_w_buf];
        mov rsi, 4;
        call composite_hid_demux;
        cmp rax, 1;                      // KEYBOARD
        jne chid_w_fail_stage;

        lea r10, [rip + _chid_w_buf];
        mov rax, 2;
        mov [r10 + 0], al;
        lea rdi, [rip + _chid_w_buf];
        mov rsi, 4;
        call composite_hid_demux;
        cmp rax, 2;                      // MOUSE
        jne chid_w_fail_stage;

        // -- 8. demux miss: buf[0] = 9 -> NOT_BOUND.
        mov rax, 8;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _chid_w_buf];
        mov rax, 9;
        mov [r10 + 0], al;
        lea rdi, [rip + _chid_w_buf];
        mov rsi, 4;
        call composite_hid_demux;
        mov r11, 0xFFFFFADC;             // NOT_BOUND
        cmp rax, r11;
        jne chid_w_fail_stage;

        // -- 9. remove(1) -> OK; class_of(1) -> NOT_BOUND.
        mov rax, 9;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call composite_hid_remove;
        cmp rax, 0;
        jne chid_w_fail_stage;

        mov rdi, 1;
        call composite_hid_class_of;
        mov r11, 0xFFFFFADC;
        cmp rax, r11;
        jne chid_w_fail_stage;

        // -- 10a. BAD_REPORT_ID (0).
        mov rax, 10;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 5;
        call composite_hid_add;
        mov r11, 0xFFFFFADF;
        cmp rax, r11;
        jne chid_w_fail_stage;

        // -- 10b. BAD_CLASS.
        mov rax, 11;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 4;                      // not 1/2/3
        mov rdx, 7;
        call composite_hid_add;
        mov r11, 0xFFFFFADE;
        cmp rax, r11;
        jne chid_w_fail_stage;

        // -- 10c. ENOSPC after 8 live rows.
        //         Currently: row 1 holds (rid=2, MOUSE, 20). Add 7 more,
        //         then one more must ENOSPC.
        mov rax, 12;
        lea rcx, [rip + _chid_w_stage];
        mov [rcx], rax;

        mov rbx, 100;
      chid_w_fill:
        cmp rbx, 107;                    // add 7 (rid 100..106)
        jae chid_w_fill_done;
        mov rdi, rbx;
        mov rsi, 1;                      // KEYBOARD
        mov rdx, 200;
        call composite_hid_add;
        mov r11, 0xFFFFFADB;             // ENOSPC (must NOT be)
        cmp rax, r11;
        je  chid_w_fail_stage;
        add rbx, 1;
        jmp chid_w_fill;
      chid_w_fill_done:

        // Now 8 rows live. One more -> ENOSPC.
        mov rdi, 250;
        mov rsi, 2;
        mov rdx, 250;
        call composite_hid_add;
        mov r11, 0xFFFFFADB;             // ENOSPC
        cmp rax, r11;
        jne chid_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chid_w_ok];
        call klog_s1;

        call composite_hid_reset;
        xor rax, rax;
        jmp chid_w_out;

      chid_w_fail_stage:
        lea rax, [rip + _chid_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chid_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call composite_hid_reset;
        mov rax, 1;

      chid_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
