// tests/kernel/drivers/usb/hid/kbd_full_synth.pdx — R34.M4-002 (#1182)
//
// Boot witness for src/kernel/core/drivers/usb/hid/kbd_full.pdx.
//
// Asserts:
//   (1) honesty pin returns 0
//   (2) modifier byte extraction
//   (3) N-key rollover bit count (popcount over bitmap)
//   (4) bitmap probe: set bit returns 1, clear bit returns 0
//   (5) LED output pack
//   (6) page validator
//   (7) Failure edges: BAD_BUF, BAD_LEDS (out-of-range bit), BAD_USAGE_ID
//
// Fingerprint: R34 USB HID KBD FULL OK

module KbdFullSynth = structure {

  pub let mut _kbd_w_stage : u64 = 0

  pub let kbd_w_ok   : [u8; 25] = "R34 USB HID KBD FULL OK\n\0"
  pub let kbd_w_fail : [u8; 27] = "R34 USB HID KBD FULL FAIL\n\0"

  // 16 bytes of scratch — plenty for a report body plus a 1-byte LED report.
  pub let mut _kbd_w_buf : [u64; 2] = uninit @align(64)

  pub let kbd_full_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M4-002 (#1182): kbd_full scaffold witness. Stages: (1) honesty. (2) modifier read. (3) popcount. (4) bitmap probe (set + clear). (5) LED pack. (6) page validator. (7) BAD_BUF, BAD_LEDS, BAD_USAGE_ID.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        call kbd_full_reset;

        // -- 1. Honesty pin.
        call kbd_full_arbitrated;
        cmp rax, 0;
        jne kbd_w_fail_stage;

        // Fabricate a small report body:
        //   [+0] modifiers = 0x03 (LCtrl | LShift)
        //   [+1] bitmap byte 1 (usage 8..15) = 0x00
        //   [+2] bitmap byte 2 (usage 16..23) = 0x04  -> usage 18 set
        //   [+3] bitmap byte 3 (usage 24..31) = 0x81  -> usages 24,31 set
        lea r10, [rip + _kbd_w_buf];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov rax, 0x03;
        mov [r10 + 0], al;
        xor rax, rax;
        mov [r10 + 1], al;
        mov rax, 0x04;
        mov [r10 + 2], al;
        mov rax, 0x81;
        mov [r10 + 3], al;

        // -- 2. Modifier byte.
        mov rax, 2;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _kbd_w_buf];
        mov rsi, 4;
        call kbd_read_modifiers;
        cmp rax, 0x03;
        jne kbd_w_fail_stage;

        // -- 3. Popcount over buf[1..4] = 0x00 + 0x04 + 0x81 = 3 bits.
        mov rax, 3;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rbx, [rip + _kbd_w_buf];
        add rbx, 1;                      // start at byte 1
        mov rdi, rbx;
        mov rsi, 3;
        call kbd_count_bits;
        cmp rax, 3;
        jne kbd_w_fail_stage;

        // -- 4. Bitmap probe. usage 18 is set (byte 2 bit 2, using base-0
        //       usage numbering over the range [1..24]). Probe for usage 18
        //       over buf[1..4] means byte index = 18/8 = 2, bit = 18%8 = 2.
        mov rax, 4;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rbx, [rip + _kbd_w_buf];
        add rbx, 1;
        mov rdi, rbx;
        mov rsi, 3;
        mov rdx, 18;
        call kbd_bitmap_probe;
        cmp rax, 1;
        jne kbd_w_fail_stage;

        // Usage 17 should be clear.
        lea rbx, [rip + _kbd_w_buf];
        add rbx, 1;
        mov rdi, rbx;
        mov rsi, 3;
        mov rdx, 17;
        call kbd_bitmap_probe;
        cmp rax, 0;
        jne kbd_w_fail_stage;

        // -- 5. LED pack.
        mov rax, 5;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _kbd_w_buf];
        mov rsi, 1;
        mov rdx, 0x03;                   // Num + Caps
        call kbd_led_pack;
        cmp rax, 0;
        jne kbd_w_fail_stage;
        lea r10, [rip + _kbd_w_buf];
        xor rax, rax;
        mov_b rax, [r10];
        cmp rax, 0x03;
        jne kbd_w_fail_stage;

        // -- 6. Page validator.
        mov rax, 6;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        mov rdi, 0x07;
        call kbd_page_valid;
        cmp rax, 1;
        jne kbd_w_fail_stage;
        mov rdi, 0x0C;
        call kbd_page_valid;
        cmp rax, 1;
        jne kbd_w_fail_stage;
        mov rdi, 0x08;
        call kbd_page_valid;
        cmp rax, 0;
        jne kbd_w_fail_stage;

        // -- 7a. BAD_BUF from kbd_read_modifiers.
        mov rax, 7;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 4;
        call kbd_read_modifiers;
        mov r11, 0xFFFFFB0F;             // BAD_BUF
        cmp rax, r11;
        jne kbd_w_fail_stage;

        // -- 7b. BAD_LEDS: bit outside KBD_LED_MASK (0x20).
        mov rax, 8;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _kbd_w_buf];
        mov rsi, 1;
        mov rdx, 0x20;                   // outside mask
        call kbd_led_pack;
        mov r11, 0xFFFFFB0C;             // BAD_LEDS
        cmp rax, r11;
        jne kbd_w_fail_stage;

        // -- 7c. BAD_USAGE_ID from bitmap probe (usage 0 is reserved).
        mov rax, 9;
        lea rcx, [rip + _kbd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _kbd_w_buf];
        mov rsi, 4;
        mov rdx, 0;
        call kbd_bitmap_probe;
        mov r11, 0xFFFFFB0D;             // BAD_USAGE_ID
        cmp rax, r11;
        jne kbd_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbd_w_ok];
        call klog_s1;

        call kbd_full_reset;
        xor rax, rax;
        jmp kbd_w_out;

      kbd_w_fail_stage:
        lea rax, [rip + _kbd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbd_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kbd_full_reset;
        mov rax, 1;

      kbd_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
