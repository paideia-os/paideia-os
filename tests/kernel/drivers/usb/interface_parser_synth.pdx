// tests/kernel/drivers/usb/interface_parser_synth.pdx — R34.M2-003 (#1174)
//
// Boot witness for src/kernel/core/drivers/usb/interface_parser.pdx.
//
// Asserts the descriptor decoder's refusal discipline and the
// happy-path pack, plus the honesty pin and alt-selection helper.
//
// Fingerprint: R34 INTERFACE PARSER OK
// No cap slots. Uses static synthetic descriptor buffers in .rodata.

module InterfaceParserSynth = structure {

  pub let mut _ifps_w_stage : u64 = 0

  pub let ifps_w_ok   : [u8; 24] = "R34 INTERFACE PARSER OK\n\0"
  pub let ifps_w_fail : [u8; 26] = "R34 INTERFACE PARSER FAIL\n\0"

  // Valid interface descriptor: bLength=9, bDescriptorType=0x04,
  // bInterfaceNumber=2, bAlternateSetting=1, bNumEndpoints=3,
  // bInterfaceClass=0x03 (HID), bInterfaceSubClass=0x01,
  // bInterfaceProtocol=0x02, iInterface=0.
  pub let _ifps_valid_desc : [u8; 9] = [
    0x09, 0x04, 0x02, 0x01, 0x03, 0x03, 0x01, 0x02, 0x00
  ]

  // Wrong length (bLength=8).
  pub let _ifps_bad_len_desc : [u8; 9] = [
    0x08, 0x04, 0x02, 0x01, 0x03, 0x03, 0x01, 0x02, 0x00
  ]

  // Wrong type (bDescriptorType=0x21).
  pub let _ifps_bad_type_desc : [u8; 9] = [
    0x09, 0x21, 0x02, 0x01, 0x03, 0x03, 0x01, 0x02, 0x00
  ]

  // Bad ifnum (32).
  pub let _ifps_bad_ifnum_desc : [u8; 9] = [
    0x09, 0x04, 0x20, 0x01, 0x03, 0x03, 0x01, 0x02, 0x00
  ]

  // Bad alt (16).
  pub let _ifps_bad_alt_desc : [u8; 9] = [
    0x09, 0x04, 0x02, 0x10, 0x03, 0x03, 0x01, 0x02, 0x00
  ]

  pub let interface_parser_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M2-003 (#1174): interface descriptor parser witness. Stages: (1) honesty pin. (2) valid parse. (3) accessors. (4) BAD_LENGTH. (5) BAD_TYPE. (6) BAD_IFNUM. (7) BAD_ALT. (8) NULL buf -> BAD_ARG. (9) alt_select happy path. (10) alt_select mismatch -> NOT_FOUND.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        call ifparser_reset;

        // -- 1. Honesty pin.
        call ifparser_arbitrated;
        cmp rax, 0;
        jne ifps_w_fail_stage;

        // -- 2. Valid parse.
        mov rax, 2;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_valid_desc];
        mov rsi, 9;
        call interface_parse;
        mov rbx, rax;                    // save packed

        // packed high byte must be 0 (valid).
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne ifps_w_fail_stage;

        // -- 3. Accessors.
        mov rax, 3;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call if_desc_ok;
        cmp rax, 1;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_ifnum;
        cmp rax, 2;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_alt;
        cmp rax, 1;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_neps;
        cmp rax, 3;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_class;
        cmp rax, 3;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_subclass;
        cmp rax, 1;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_protocol;
        cmp rax, 2;
        jne ifps_w_fail_stage;

        mov rdi, rbx;
        call if_desc_length;
        cmp rax, 9;
        jne ifps_w_fail_stage;

        // -- 4. BAD_LENGTH (buf[0] != len).
        mov rax, 4;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_bad_len_desc];
        mov rsi, 9;
        call interface_parse;
        mov r11, 0xFFFFFB9F;             // BAD_LENGTH
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // -- 5. BAD_TYPE.
        mov rax, 5;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_bad_type_desc];
        mov rsi, 9;
        call interface_parse;
        mov r11, 0xFFFFFB9E;
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // -- 6. BAD_IFNUM.
        mov rax, 6;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_bad_ifnum_desc];
        mov rsi, 9;
        call interface_parse;
        mov r11, 0xFFFFFB9D;
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // -- 7. BAD_ALT.
        mov rax, 7;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_bad_alt_desc];
        mov rsi, 9;
        call interface_parse;
        mov r11, 0xFFFFFB9C;
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // -- 8. NULL buf -> BAD_ARG.
        mov rax, 8;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 9;
        call interface_parse;
        mov r11, 0xFFFFFB9B;
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // -- 9. alt_select happy path (ifnum=2, alt=1).
        mov rax, 9;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_valid_desc];
        mov rsi, 9;
        mov rdx, 2;
        mov rcx, 1;
        call interface_alt_select;
        cmp rax, 0;
        jne ifps_w_fail_stage;

        // -- 10. alt_select mismatch (want ifnum=3).
        mov rax, 10;
        lea rcx, [rip + _ifps_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _ifps_valid_desc];
        mov rsi, 9;
        mov rdx, 3;
        mov rcx, 1;
        call interface_alt_select;
        mov r11, 0xFFFFFB9A;             // NOT_FOUND
        cmp rax, r11;
        jne ifps_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ifps_w_ok];
        call klog_s1;

        call ifparser_reset;
        xor rax, rax;
        jmp ifps_w_out;

      ifps_w_fail_stage:
        lea rax, [rip + _ifps_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ifps_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ifparser_reset;
        mov rax, 1;

      ifps_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
