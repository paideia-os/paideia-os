// tests/kernel/drivers/usb/hub_fsm_synth.pdx — R34.M1-002 (#1168)
//
// Boot witness for src/kernel/core/drivers/usb/hub_fsm.pdx.
//
// Asserts the full DISCONNECTED -> CONFIGURED progression, illegal
// transition refusals, DISCONNECT from every live state, and the
// out-of-range refusals.
//
// Fingerprint: USB HUB FSM OK

module HubFsmSynth = structure {

  pub let mut _hfsm_w_stage : u64 = 0

  pub let hfsm_w_ok   : [u8; 17] = "USB HUB FSM OK\n\0\0"
  pub let hfsm_w_fail : [u8; 19] = "USB HUB FSM FAIL\n\0\0"

  pub let hub_fsm_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M1-002 (#1168): FSM witness. Stages: (1) validators. (2) full happy-path progression on (0,0). (3) illegal transition refusals. (4) DISCONNECT from CONFIGURED to DISCONNECTED. (5) bad row / port / event. (6) idempotent DISCONNECT from DISCONNECTED refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        call hub_fsm_reset;

        // -- 1. Validators.
        mov rdi, 15;
        call hub_fsm_port_valid;
        cmp rax, 1;
        jne hfsm_w_fail_stage;
        mov rdi, 16;
        call hub_fsm_port_valid;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        mov rdi, 5;
        call hub_fsm_event_valid;
        cmp rax, 1;
        jne hfsm_w_fail_stage;
        mov rdi, 6;
        call hub_fsm_event_valid;
        cmp rax, 0;
        jne hfsm_w_fail_stage;
        xor rdi, rdi;
        call hub_fsm_event_valid;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        // -- 2. Happy path: (0,0) DISCONNECTED -> CONNECTED -> RESET -> ADDRESSED -> CONFIGURED
        mov rax, 2;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 1;                      // E_CONNECT
        call hub_fsm_port_event;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        call hub_fsm_get_state;
        cmp rax, 1;                      // S_CONNECTED
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 2;                      // E_RESET_START
        call hub_fsm_port_event;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 3;                      // E_ADDRESSED
        call hub_fsm_port_event;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 4;                      // E_CONFIGURED
        call hub_fsm_port_event;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        call hub_fsm_get_state;
        cmp rax, 4;                      // S_CONFIGURED
        jne hfsm_w_fail_stage;

        // -- 3. Illegal transitions from CONFIGURED (state 4) other than DISCONNECT.
        mov rax, 3;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 1;                      // CONNECT from CONFIGURED
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBD;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 2;                      // RESET_START from CONFIGURED
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBD;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        // -- 4. DISCONNECT from CONFIGURED -> DISCONNECTED.
        mov rax, 4;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 5;                      // E_DISCONNECT
        call hub_fsm_port_event;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        call hub_fsm_get_state;
        cmp rax, 0;
        jne hfsm_w_fail_stage;

        // -- 5. Bad row / bad port / bad event.
        mov rax, 5;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        mov rdi, 16;                     // bad row
        xor rsi, rsi;
        mov rdx, 1;
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBC;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        mov rsi, 16;                     // bad port
        mov rdx, 1;
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBF;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 99;                     // bad event
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBE;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        // -- 6. Idempotent DISCONNECT refused.
        mov rax, 6;
        lea rcx, [rip + _hfsm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, 5;                      // DISCONNECT again from DISCONNECTED
        call hub_fsm_port_event;
        mov r11, 0xFFFFFCBD;
        cmp rax, r11;
        jne hfsm_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hfsm_w_ok];
        call klog_s1;

        call hub_fsm_reset;
        xor rax, rax;
        jmp hfsm_w_out;

      hfsm_w_fail_stage:
        lea rax, [rip + _hfsm_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hfsm_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hub_fsm_reset;
        mov rax, 1;

      hfsm_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
