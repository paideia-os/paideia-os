// tests/kernel/drivers/usb/msc/bot_synth.pdx — R34.M3-001 (#1176)
//
// Boot witness for src/kernel/core/drivers/usb/msc/bot.pdx.
//
// Asserts CBW pack, CSW unpack, honesty pin, and refusal discipline
// on BAD_DIR / BAD_LUN / BAD_CDB_LEN / BAD_SIG / TAG_MISMATCH.
//
// Fingerprint: MSC BOT OK
// No cap slots.

module BotSynth = structure {

  pub let mut _bot_w_stage : u64 = 0

  pub let bot_w_ok   : [u8; 12] = "MSC BOT OK\n\0"
  pub let bot_w_fail : [u8; 14] = "MSC BOT FAIL\n\0"

  // Scratch buffers for CBW/CSW.
  pub let mut _bot_w_cbw : [u64; 4] = uninit @align(64)   // 32 bytes; CBW is 31.
  pub let mut _bot_w_csw : [u64; 4] = uninit @align(64)   // 32 bytes; CSW is 13.

  pub let usb_mscbot_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M3-001 (#1176): BOT scaffold witness. Stages: (1) honesty pin. (2) validators. (3) CBW pack happy path. (4) BAD_LUN. (5) BAD_DIR. (6) BAD_CDB_LEN. (7) CSW pack synth + unpack status/residue. (8) BAD_SIG. (9) TAG_MISMATCH.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        call bot_reset;

        // -- 1. Honesty pin.
        call bot_arbitrated;
        cmp rax, 0;
        jne bot_w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        mov rdi, 15;
        call bot_lun_valid;
        cmp rax, 1;
        jne bot_w_fail_stage;
        mov rdi, 16;
        call bot_lun_valid;
        cmp rax, 0;
        jne bot_w_fail_stage;

        mov rdi, 0xFE;
        call bot_class_request_valid;
        cmp rax, 1;
        jne bot_w_fail_stage;
        mov rdi, 0xFF;
        call bot_class_request_valid;
        cmp rax, 1;
        jne bot_w_fail_stage;
        mov rdi, 0xFD;
        call bot_class_request_valid;
        cmp rax, 0;
        jne bot_w_fail_stage;

        // -- 3. CBW pack happy path.
        mov rax, 3;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _bot_w_cbw];
        mov rsi, 0xCAFEBABE;             // tag
        mov rdx, 4096;                   // dxfer_len
        mov rcx, 1;                      // dir IN
        mov r8, 3;                       // LUN 3
        mov r9, 10;                      // cdb_len
        call bot_cbw_pack;
        cmp rax, 0;
        jne bot_w_fail_stage;

        // Verify signature at [+0..+3].
        lea r10, [rip + _bot_w_cbw];
        xor rax, rax;
        mov eax, [r10 + 0];
        mov r11, 0x43425355;
        cmp rax, r11;
        jne bot_w_fail_stage;
        // Verify tag at [+4..+7].
        xor rax, rax;
        mov eax, [r10 + 4];
        mov r11, 0xCAFEBABE;
        cmp rax, r11;
        jne bot_w_fail_stage;
        // Verify bmCBWFlags at [+12]: bit 7 set for IN.
        xor rax, rax;
        mov_b rax, [r10 + 12];
        cmp rax, 0x80;
        jne bot_w_fail_stage;
        // Verify bCBWLUN at [+13].
        xor rax, rax;
        mov_b rax, [r10 + 13];
        cmp rax, 3;
        jne bot_w_fail_stage;

        // -- 4. BAD_LUN.
        mov rax, 4;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _bot_w_cbw];
        mov rsi, 1;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 16;                      // bad
        mov r9, 6;
        call bot_cbw_pack;
        mov r11, 0xFFFFFB5B;             // BAD_LUN
        cmp rax, r11;
        jne bot_w_fail_stage;

        // -- 5. BAD_DIR.
        mov rax, 5;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _bot_w_cbw];
        mov rsi, 1;
        mov rdx, 0;
        mov rcx, 2;                      // bad direction
        mov r8, 0;
        mov r9, 6;
        call bot_cbw_pack;
        mov r11, 0xFFFFFB5C;             // BAD_DIR
        cmp rax, r11;
        jne bot_w_fail_stage;

        // -- 6. BAD_CDB_LEN.
        mov rax, 6;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _bot_w_cbw];
        mov rsi, 1;
        mov rdx, 0;
        mov rcx, 0;
        mov r8, 0;
        mov r9, 17;                      // bad
        call bot_cbw_pack;
        mov r11, 0xFFFFFB5A;             // BAD_CDB_LEN
        cmp rax, r11;
        jne bot_w_fail_stage;

        // -- 7. CSW synth + unpack.
        mov rax, 7;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        // Fabricate a valid CSW manually.
        lea r10, [rip + _bot_w_csw];
        mov rax, 0x53425355;             // sig
        mov [r10 + 0], eax;
        mov rax, 0xCAFEBABE;             // tag
        mov [r10 + 4], eax;
        mov rax, 128;                    // residue
        mov [r10 + 8], eax;
        mov rax, 1;                      // status = FAILED
        mov [r10 + 12], al;

        lea rdi, [rip + _bot_w_csw];
        mov rsi, 13;
        mov rdx, 0xCAFEBABE;
        call bot_csw_unpack_status;
        cmp rax, 1;
        jne bot_w_fail_stage;

        lea rdi, [rip + _bot_w_csw];
        mov rsi, 13;
        call bot_csw_unpack_residue;
        cmp rax, 128;
        jne bot_w_fail_stage;

        // -- 8. BAD_SIG.
        mov rax, 8;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _bot_w_csw];
        mov rax, 0xDEADBEEF;             // wrong sig
        mov [r10 + 0], eax;

        lea rdi, [rip + _bot_w_csw];
        mov rsi, 13;
        mov rdx, 0xCAFEBABE;
        call bot_csw_unpack_status;
        mov r11, 0xFFFFFB5D;             // BAD_SIG
        cmp rax, r11;
        jne bot_w_fail_stage;

        // -- 9. TAG_MISMATCH.
        mov rax, 9;
        lea rcx, [rip + _bot_w_stage];
        mov [rcx], rax;

        // Restore signature; keep tag = 0xCAFEBABE; ask for a different tag.
        lea r10, [rip + _bot_w_csw];
        mov rax, 0x53425355;
        mov [r10 + 0], eax;

        lea rdi, [rip + _bot_w_csw];
        mov rsi, 13;
        mov rdx, 0xFFFFFFFF;             // wrong tag
        call bot_csw_unpack_status;
        mov r11, 0xFFFFFB57;             // TAG_MISMATCH
        cmp rax, r11;
        jne bot_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bot_w_ok];
        call klog_s1;

        call bot_reset;
        xor rax, rax;
        jmp bot_w_out;

      bot_w_fail_stage:
        lea rax, [rip + _bot_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bot_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bot_reset;
        mov rax, 1;

      bot_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
