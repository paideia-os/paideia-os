// tests/kernel/drivers/usb/msc/uas_synth.pdx — R34.M3-002 (#1177)
//
// Boot witness for src/kernel/core/drivers/usb/msc/uas.pdx.
//
// Asserts IU header pack/unpack, stream-id gating, Command IU pack,
// Response IU / Ready IU / Sense IU decodes and refusal discipline.
//
// Fingerprint: MSC UAS OK
// No cap slots.

module UasSynth = structure {

  pub let mut _uas_w_stage : u64 = 0

  pub let uas_w_ok   : [u8; 12] = "MSC UAS OK\n\0"
  pub let uas_w_fail : [u8; 14] = "MSC UAS FAIL\n\0"

  pub let mut _uas_w_iu : [u64; 8] = uninit @align(64)   // 64 bytes; plenty.

  pub let usb_mscuas_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M3-002 (#1177): UAS scaffold witness. Stages: (1) honesty pin. (2) validators. (3) IU header pack + unpack. (4) BAD_STREAM_ID (0). (5) BAD_IU_TYPE. (6) Command IU pack. (7) BAD_CDB_ADD_LEN. (8) Response IU decode. (9) Ready IU decode + tag check. (10) Sense IU decode.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        call uas_reset;

        // -- 1. Honesty pin.
        call uas_arbitrated;
        cmp rax, 0;
        jne uas_w_fail_stage;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call uas_iu_type_valid;
        cmp rax, 1;
        jne uas_w_fail_stage;
        mov rdi, 7;
        call uas_iu_type_valid;
        cmp rax, 1;
        jne uas_w_fail_stage;
        mov rdi, 0;
        call uas_iu_type_valid;
        cmp rax, 0;
        jne uas_w_fail_stage;
        mov rdi, 2;
        call uas_iu_type_valid;
        cmp rax, 0;
        jne uas_w_fail_stage;
        mov rdi, 8;
        call uas_iu_type_valid;
        cmp rax, 0;
        jne uas_w_fail_stage;

        mov rdi, 1;
        call uas_stream_id_valid;
        cmp rax, 1;
        jne uas_w_fail_stage;
        mov rdi, 65535;
        call uas_stream_id_valid;
        cmp rax, 1;
        jne uas_w_fail_stage;
        mov rdi, 0;
        call uas_stream_id_valid;
        cmp rax, 0;
        jne uas_w_fail_stage;

        // -- 3. IU header pack + unpack.
        mov rax, 3;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 3;                      // Response IU
        mov rdx, 42;                     // stream_id
        call uas_iu_hdr_pack;
        cmp rax, 0;
        jne uas_w_fail_stage;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 4;
        call uas_iu_hdr_type;
        cmp rax, 3;
        jne uas_w_fail_stage;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 4;
        call uas_iu_hdr_stream;
        cmp rax, 42;
        jne uas_w_fail_stage;

        // -- 4. BAD_STREAM_ID (0).
        mov rax, 4;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 1;
        mov rdx, 0;                      // bad
        call uas_iu_hdr_pack;
        mov r11, 0xFFFFFB4C;             // BAD_STREAM_ID
        cmp rax, r11;
        jne uas_w_fail_stage;

        // -- 5. BAD_IU_TYPE.
        mov rax, 5;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 2;                      // bad (not in {1,3,4,5,6,7})
        mov rdx, 1;
        call uas_iu_hdr_pack;
        mov r11, 0xFFFFFB4D;             // BAD_IU_TYPE
        cmp rax, r11;
        jne uas_w_fail_stage;

        // -- 6. Command IU pack.
        mov rax, 6;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 7;                      // stream 7
        mov rdx, 0;                      // task_attr
        mov rcx, 0;                      // add_cdb_len = 0
        call uas_command_iu_pack;
        cmp rax, 0;
        jne uas_w_fail_stage;

        // Verify IU type at [+0] is Command (0x01).
        lea r10, [rip + _uas_w_iu];
        xor rax, rax;
        mov_b rax, [r10 + 0];
        cmp rax, 1;
        jne uas_w_fail_stage;

        // -- 7. BAD_CDB_ADD_LEN (5 — not multiple of 4).
        mov rax, 7;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 1;
        mov rdx, 0;
        mov rcx, 5;                      // bad
        call uas_command_iu_pack;
        mov r11, 0xFFFFFB4B;             // BAD_CDB_ADD_LEN
        cmp rax, r11;
        jne uas_w_fail_stage;

        // -- 8. Response IU decode.
        mov rax, 8;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        // Fabricate a Response IU.
        lea r10, [rip + _uas_w_iu];
        mov rax, 3;                      // Response IU
        mov [r10 + 0], al;
        xor rax, rax;
        mov [r10 + 1], al;
        // Task tag stream = 0x0001 (already validated above, doesn't matter for
        // response unpack — the unpack looks at type + response code).
        mov rax, 0;
        mov [r10 + 2], al;
        mov rax, 1;
        mov [r10 + 3], al;
        // additional response info bytes 4..6 zero.
        xor rax, rax;
        mov [r10 + 4], al;
        mov [r10 + 5], al;
        mov [r10 + 6], al;
        // Response code at [+7] = 5.
        mov rax, 5;
        mov [r10 + 7], al;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 8;
        call uas_response_iu_unpack;
        cmp rax, 5;
        jne uas_w_fail_stage;

        // -- 9. Ready IU decode + tag check.
        mov rax, 9;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 5;                      // Read Ready
        mov rdx, 99;                     // stream
        call uas_iu_hdr_pack;
        cmp rax, 0;
        jne uas_w_fail_stage;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 4;
        mov rdx, 99;
        call uas_ready_iu_unpack;
        cmp rax, 5;
        jne uas_w_fail_stage;

        // Wrong stream -> TAG_MISMATCH.
        lea rdi, [rip + _uas_w_iu];
        mov rsi, 4;
        mov rdx, 100;
        call uas_ready_iu_unpack;
        mov r11, 0xFFFFFB48;             // TAG_MISMATCH
        cmp rax, r11;
        jne uas_w_fail_stage;

        // -- 10. Sense IU decode.
        mov rax, 10;
        lea rcx, [rip + _uas_w_stage];
        mov [rcx], rax;

        lea r10, [rip + _uas_w_iu];
        mov rax, 7;                      // Sense IU
        mov [r10 + 0], al;
        xor rax, rax;
        mov [r10 + 1], al;
        mov [r10 + 2], al;
        mov [r10 + 3], al;
        mov [r10 + 4], al;
        mov [r10 + 5], al;
        // status at [+6] = 2.
        mov rax, 2;
        mov [r10 + 6], al;
        xor rax, rax;
        mov [r10 + 7], al;
        // sense_data_length = 4 (fits in 16-byte buffer at +10..+13).
        mov rax, 0;
        mov [r10 + 8], al;
        mov rax, 4;
        mov [r10 + 9], al;

        lea rdi, [rip + _uas_w_iu];
        mov rsi, 16;
        call uas_sense_iu_unpack_status;
        cmp rax, 2;
        jne uas_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uas_w_ok];
        call klog_s1;

        call uas_reset;
        xor rax, rax;
        jmp uas_w_out;

      uas_w_fail_stage:
        lea rax, [rip + _uas_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + uas_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call uas_reset;
        mov rax, 1;

      uas_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
