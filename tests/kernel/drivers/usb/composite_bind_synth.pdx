// tests/kernel/drivers/usb/composite_bind_synth.pdx — R34.M2-002 (#1173)
//
// Boot witness for src/kernel/core/drivers/usb/composite_bind.pdx.
//
// Asserts the interface-per-driver rule: add/get/remove round-trips
// work, re-binding an interface is REFUSED, ENOSPC at 16, and count
// tracks live rows.
//
// Fingerprint: COMPOSITE BIND OK
// No cap slots — this driver holds no capability, only a private table.

module CompositeBindSynth = structure {

  pub let mut _cbs_w_stage : u64 = 0

  pub let cbs_w_ok   : [u8; 18] = "COMPOSITE BIND OK\n\0"
  pub let cbs_w_fail : [u8; 20] = "COMPOSITE BIND FAIL\n\0"

  pub let composite_bind_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M2-002 (#1173): composite bind witness. Stages: (1) honesty pin. (2) reset. (3) bind (10,20) -> row0. (4) get(10)==20. (5) re-bind (10,21) -> ALREADY_BOUND. (6) bind (11,22). (7) count==2. (8) remove(10) -> OK. (9) get(10)==NOT_BOUND. (10) remove(10) -> NOT_BOUND. (11) fill 16 rows -> ENOSPC. Four-push prologue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        call composite_bind_reset;

        // -- 1. Honesty pin.
        call composite_bind_arbitrated;
        cmp rax, 0;
        jne cbs_w_fail_stage;

        // -- 2. Bind (10, 20).
        mov rax, 2;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 20;
        call composite_bind_add;
        cmp rax, 0;
        jne cbs_w_fail_stage;

        // -- 3. get(10) == 20.
        mov rax, 3;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call composite_bind_get;
        cmp rax, 20;
        jne cbs_w_fail_stage;

        // -- 4. Re-bind (10, 21) -> ALREADY_BOUND.
        mov rax, 4;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 21;
        call composite_bind_add;
        mov r11, 0xFFFFFB8D;             // ALREADY_BOUND
        cmp rax, r11;
        jne cbs_w_fail_stage;

        // -- 5. Bind (11, 22).
        mov rax, 5;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 11;
        mov rsi, 22;
        call composite_bind_add;
        cmp rax, 1;                      // second row
        jne cbs_w_fail_stage;

        // -- 6. count == 2.
        mov rax, 6;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        call composite_bind_count;
        cmp rax, 2;
        jne cbs_w_fail_stage;

        // -- 7. remove(10) -> OK.
        mov rax, 7;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call composite_bind_remove;
        cmp rax, 0;
        jne cbs_w_fail_stage;

        // -- 8. get(10) -> NOT_BOUND.
        mov rax, 8;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call composite_bind_get;
        mov r11, 0xFFFFFB8C;             // NOT_BOUND
        cmp rax, r11;
        jne cbs_w_fail_stage;

        // -- 9. remove(10) -> NOT_BOUND (idempotent no-op).
        mov rax, 9;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call composite_bind_remove;
        mov r11, 0xFFFFFB8C;
        cmp rax, r11;
        jne cbs_w_fail_stage;

        // -- 10. Fill remaining rows and assert ENOSPC.
        // Currently: row 1 has (11,22). Add 15 more with unique keys 100..114.
        mov rax, 10;
        lea rcx, [rip + _cbs_w_stage];
        mov [rcx], rax;

        mov rbx, 100;
      cbs_w_fill:
        cmp rbx, 115;
        jae cbs_w_fill_done;
        mov rdi, rbx;
        mov rsi, 200;
        call composite_bind_add;
        // First 15 (keys 100..114) should succeed.
        mov r11, 0xFFFFFB8B;             // ENOSPC (should NOT be)
        cmp rax, r11;
        je  cbs_w_fail_stage;
        add rbx, 1;
        jmp cbs_w_fill;
      cbs_w_fill_done:

        // Now table has 16 rows (1 + 15). One more should ENOSPC.
        mov rdi, 200;
        mov rsi, 250;
        call composite_bind_add;
        mov r11, 0xFFFFFB8B;             // ENOSPC
        cmp rax, r11;
        jne cbs_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cbs_w_ok];
        call klog_s1;

        call composite_bind_reset;
        xor rax, rax;
        jmp cbs_w_out;

      cbs_w_fail_stage:
        lea rax, [rip + _cbs_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cbs_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call composite_bind_reset;
        mov rax, 1;

      cbs_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
