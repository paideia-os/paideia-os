// tests/kernel/drivers/usb/hub_driver_synth.pdx — R34.M1-001 (#1167)
//
// Boot witness for src/kernel/core/drivers/usb/hub_driver.pdx.
//
// Asserts the descriptor decoder's refusal discipline and the
// happy-path pack, plus the honesty pin.
//
// Fingerprint: R34 USB HUB DESC OK
//
// No cap slots. Uses a static synthetic descriptor buffer in .rodata.

module HubDriverSynth = structure {

  pub let mut _hdrv_w_stage : u64 = 0

  pub let hdrv_w_ok   : [u8; 22] = "R34 USB HUB DESC OK\n\0\0"
  pub let hdrv_w_fail : [u8; 24] = "R34 USB HUB DESC FAIL\n\0\0"

  // A valid 4-port hub descriptor (bLength=9, wHubChars=0x0060 TT ok,
  // bPwrOn=50, bContrCurrent=100, DeviceRemovable=0x00).
  pub let _hdrv_valid_desc : [u8; 9] = [
    0x09,     // bLength = 9
    0x29,     // bDescriptorType = HUB
    0x04,     // bNbrPorts = 4
    0x60,     // wHubCharacteristics [7:0]
    0x00,     // wHubCharacteristics [15:8]
    0x32,     // bPwrOn2PwrGood = 50 (100 ms)
    0x64,     // bHubContrCurrent = 100 mA
    0x00,     // DeviceRemovable
    0x00      // PortPwrCtrlMask (deprecated but present)
  ]

  // Same descriptor but with wrong length byte (buf[0] mismatches len).
  pub let _hdrv_bad_len_desc : [u8; 9] = [
    0x07,     // bLength = 7 (mismatches len=9)
    0x29, 0x04, 0x60, 0x00, 0x32, 0x64, 0x00, 0x00
  ]

  // Wrong descriptor type.
  pub let _hdrv_bad_type_desc : [u8; 9] = [
    0x09,
    0x21,     // bDescriptorType = 0x21 (HID, not HUB)
    0x04, 0x60, 0x00, 0x32, 0x64, 0x00, 0x00
  ]

  // 0 ports.
  pub let _hdrv_bad_ports_desc : [u8; 9] = [
    0x09, 0x29,
    0x00,     // bNbrPorts = 0
    0x60, 0x00, 0x32, 0x64, 0x00, 0x00
  ]

  pub let hub_driver_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M1-001 (#1167): descriptor decode witness. Stages: (1) honesty pin. (2) valid decode. (3) accessors on packed value. (4) BAD_LENGTH. (5) BAD_TYPE. (6) BAD_PORTS. (7) NULL buf. (8) bind seam. Four-push prologue leaves rsp%16 == 0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        call hub_driver_reset;

        // -- 1. Honesty pin.
        call hub_driver_arbitrated;
        cmp rax, 0;
        jne hdrv_w_fail_stage;

        // -- 2. Valid decode.
        mov rax, 2;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hdrv_valid_desc];
        mov rsi, 9;
        call hub_driver_decode;
        mov rbx, rax;
        mov rdi, rbx;
        call hub_desc_ok;
        cmp rax, 1;
        jne hdrv_w_fail_stage;

        // -- 3. Accessors.
        mov rax, 3;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call hub_desc_ports;
        cmp rax, 4;
        jne hdrv_w_fail_stage;

        mov rdi, rbx;
        call hub_desc_length;
        cmp rax, 9;
        jne hdrv_w_fail_stage;

        mov rdi, rbx;
        call hub_desc_type;
        cmp rax, 0x29;
        jne hdrv_w_fail_stage;

        mov rdi, rbx;
        call hub_desc_pwron;
        cmp rax, 50;
        jne hdrv_w_fail_stage;

        mov rdi, rbx;
        call hub_desc_curr;
        cmp rax, 100;
        jne hdrv_w_fail_stage;

        mov rdi, rbx;
        call hub_desc_chars;
        cmp rax, 0x0060;
        jne hdrv_w_fail_stage;

        // hub_desc_tt: chars[6:5] == 0b11 -> tt supported = 1
        mov rdi, rbx;
        call hub_desc_tt;
        cmp rax, 1;
        jne hdrv_w_fail_stage;

        // -- 4. BAD_LENGTH: buf[0] != len.
        mov rax, 4;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hdrv_bad_len_desc];
        mov rsi, 9;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCF;             // BAD_LENGTH
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // len too small.
        lea rdi, [rip + _hdrv_valid_desc];
        mov rsi, 7;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCF;
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // len too large.
        lea rdi, [rip + _hdrv_valid_desc];
        mov rsi, 10;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCF;
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // -- 5. BAD_TYPE.
        mov rax, 5;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hdrv_bad_type_desc];
        mov rsi, 9;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCE;
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // -- 6. BAD_PORTS.
        mov rax, 6;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _hdrv_bad_ports_desc];
        mov rsi, 9;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCD;
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // -- 7. NULL buf -> BAD_ARG.
        mov rax, 7;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 9;
        call hub_driver_decode;
        mov r11, 0xFFFFFCCC;
        cmp rax, r11;
        jne hdrv_w_fail_stage;

        // -- 8. Bind seam.
        mov rax, 8;
        lea rcx, [rip + _hdrv_w_stage];
        mov [rcx], rax;

        call hub_driver_bind;
        cmp rax, 0;
        jne hdrv_w_fail_stage;
        call hub_driver_bound;
        cmp rax, 1;
        jne hdrv_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hdrv_w_ok];
        call klog_s1;

        call hub_driver_reset;
        xor rax, rax;
        jmp hdrv_w_out;

      hdrv_w_fail_stage:
        lea rax, [rip + _hdrv_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hdrv_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hub_driver_reset;
        mov rax, 1;

      hdrv_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
