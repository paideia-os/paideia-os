// tests/kernel/drivers/usb/isoch/hw_smoke_audio_placeholder.pdx — R34.M5-005 (#1190)
//
// USB isochronous HW-smoke PLACEHOLDER — USB audio class (bInterface
// Class 0x01) endpoint attach + isoch stream open.
//
// STATUS: dormant. gated:hardware. This module is deliberately NOT
// registered by any boot witness. Its body is a minimal stub kept
// so `find ... -name '*.pdx'` finds it and the assembler validates
// its syntax, but no code path in QEMU or on the T14 G4 calls the
// function it declares. See tools/hw-smoke-r34-isoch.md for the
// operator recipe that promotes this from a placeholder into a live
// acceptance test.
//
// The one-writer discipline for state cells is deferred until a live
// wire exists — this module owns no .bss, no counters, and no
// declared symbol other than the placeholder itself.
//
// Rationale: mirroring tools/hw-smoke-r34.md § / R34.M3-005 (#1180),
// hardware smokes land as UNSEEDED placeholders so the recipe is
// merged and reviewable before the live capture that promotes it. A
// placeholder that COMPILED but never RAN was the R30.M9 shape and
// is the shape #1190 continues here.

module HwSmokeAudioPlaceholder = structure {

  pub let mut _isoch_hw_smoke_placeholder : u64 = 0

  pub let isoch_hw_smoke_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-005 (#1190): dormant placeholder. Returns 0. Not registered by any boot witness; not on any code path. See tools/hw-smoke-r34-isoch.md for the operator recipe that promotes this to a live acceptance test on the T14 G4.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame
}
