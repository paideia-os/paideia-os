// tests/kernel/drivers/vello/vello_cpu_fallback_synth.pdx --
// G4.M2-004 + G4.M2-005 (#1483, #1484)
//
// Boot witness for the CPU fallback + hash verification. Verifies
// FNV-1a mix, start + ingest sequence, hash readback, verify
// match/mismatch reporting.
//
// Fingerprint: G4 VELLO_CPU_FALLBACK OK

module VelloCpuFallbackSynth = structure {

  pub let mut _vcfsw_stage : u64 = 0

  pub let vcfsw_ok   : [u8; 26] = "G4 VELLO_CPU_FALLBACK OK\0"
  pub let vcfsw_fail : [u8; 28] = "G4 VELLO_CPU_FALLBACK FAIL\0"

  pub let vello_cpu_fallback_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M2-004..005 (#1483-1484) boot witness. Stages: (1) reset. (2) vcf_mix(0, 0) is 0 XOR 0 * PRIME = 0; vcf_mix(OFFSET, 'a') non-zero. (3) start(submit_id=42) claims slot 0; hash_of returns FNV_OFFSET. (4) ingest one tile fold; tiles_of == 1. (5) verify: matching hash returns OK; mismatching returns HASH_MISMATCH.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vcfsw_stage];
        mov [rcx], rax;
        call vcf_reset;

        // 2. vcf_mix boundary + non-trivial.
        mov rax, 2;
        lea rcx, [rip + _vcfsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        call vcf_mix;
        cmp rax, 0;
        jne vcfsw_fail_stage;
        mov r10, 0xCBF29CE484222325;
        mov rdi, r10;
        mov rsi, 0x61;                    // 'a'
        call vcf_mix;
        cmp rax, 0;
        je  vcfsw_fail_stage;

        // 3. start(42) -> slot 0; hash = FNV_OFFSET.
        mov rax, 3;
        lea rcx, [rip + _vcfsw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call vcf_start;
        cmp rax, 0;
        jne vcfsw_fail_stage;
        mov rdi, 0;
        call vcf_hash_of;
        mov r10, 0xCBF29CE484222325;
        cmp rax, r10;
        jne vcfsw_fail_stage;

        // 4. ingest a tile: (tx=1, ty=2, cover_lo=3, cover_hi=4, rgba=0xFF).
        mov rax, 4;
        lea rcx, [rip + _vcfsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 2;
        mov rcx, 3;
        mov r8,  4;
        mov r9,  0xFF;
        call vcf_ingest;
        cmp rax, 0;
        jne vcfsw_fail_stage;
        mov rdi, 0;
        call vcf_tiles_of;
        cmp rax, 1;
        jne vcfsw_fail_stage;

        // 5. verify: pass the computed hash for OK, then a wrong one for MISMATCH.
        mov rax, 5;
        lea rcx, [rip + _vcfsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vcf_hash_of;
        mov r12, rax;
        mov rdi, 0;
        mov rsi, r12;
        call vcf_verify;
        cmp rax, 0;
        jne vcfsw_fail_stage;
        mov rdi, 0;
        mov rsi, 0xDEADBEEF;
        call vcf_verify;
        mov r10, 0xFFFFED7E;
        cmp rax, r10;
        jne vcfsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vcfsw_ok];
        call klog_s1;

        call vcf_reset;
        xor rax, rax;
        jmp vcfsw_out;

      vcfsw_fail_stage:
        lea rax, [rip + _vcfsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vcfsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vcf_reset;
        mov rax, 1;

      vcfsw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
