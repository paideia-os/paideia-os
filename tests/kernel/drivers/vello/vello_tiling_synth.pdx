// tests/kernel/drivers/vello/vello_tiling_synth.pdx --
// G4.M4 (#1488, #1489)
//
// Boot witness for the tile-grid substrate. Verifies level_valid,
// init happy + bad extent + bad level, mark_occupied, mark_skipped,
// mark_coarsened, per-metric read-back.
//
// Fingerprint: G4 VELLO_TILING OK

module VelloTilingSynth = structure {

  pub let mut _vtsw_stage : u64 = 0

  pub let vtsw_ok   : [u8; 20] = "G4 VELLO_TILING OK\0"
  pub let vtsw_fail : [u8; 22] = "G4 VELLO_TILING FAIL\0"

  pub let vello_tiling_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M4 boot witness. Stages: (1) reset. (2) level_valid boundaries. (3) init(submit=7, tx=120, ty=80, level=2) -> slot 0. (4) init with tx=0 refused BAD_EXTENT; with level=4 refused BAD_LEVEL. (5) mark_occupied x3, mark_skipped x2, mark_coarsened x1; counters read back. Three callee-save pushes (odd) keep rsp aligned across nested vt_* + klog calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vtsw_stage];
        mov [rcx], rax;
        call vt_reset;

        // 2. level_valid.
        mov rax, 2;
        lea rcx, [rip + _vtsw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call vt_level_valid;
        cmp rax, 1;
        jne vtsw_fail_stage;
        mov rdi, 4;
        call vt_level_valid;
        cmp rax, 0;
        jne vtsw_fail_stage;

        // 3. init.
        mov rax, 3;
        lea rcx, [rip + _vtsw_stage];
        mov [rcx], rax;
        mov rdi, 7;
        mov rsi, 120;
        mov rdx, 80;
        mov rcx, 2;
        call vt_init;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_level_of;
        cmp rax, 2;
        jne vtsw_fail_stage;

        // 4. init rejects bad extent, bad level.
        mov rax, 4;
        lea rcx, [rip + _vtsw_stage];
        mov [rcx], rax;
        mov rdi, 8;
        mov rsi, 0;                       // bad tx
        mov rdx, 80;
        mov rcx, 1;
        call vt_init;
        mov r10, 0xFFFFED5E;
        cmp rax, r10;
        jne vtsw_fail_stage;
        mov rdi, 9;
        mov rsi, 40;
        mov rdx, 40;
        mov rcx, 4;                       // bad level
        call vt_init;
        mov r10, 0xFFFFED5D;
        cmp rax, r10;
        jne vtsw_fail_stage;

        // 5. mark occupancy metrics + read them back.
        mov rax, 5;
        lea rcx, [rip + _vtsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vt_mark_occupied;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_mark_occupied;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_mark_occupied;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_mark_skipped;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_mark_skipped;
        cmp rax, 0;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_mark_coarsened;
        cmp rax, 0;
        jne vtsw_fail_stage;

        mov rdi, 0;
        call vt_occupied_of;
        cmp rax, 3;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_skipped_of;
        cmp rax, 2;
        jne vtsw_fail_stage;
        mov rdi, 0;
        call vt_coarsened_of;
        cmp rax, 1;
        jne vtsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vtsw_ok];
        call klog_s1;

        call vt_reset;
        xor rax, rax;
        jmp vtsw_out;

      vtsw_fail_stage:
        lea rax, [rip + _vtsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vtsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vt_reset;
        mov rax, 1;

      vtsw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
