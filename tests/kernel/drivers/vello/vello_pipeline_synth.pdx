// tests/kernel/drivers/vello/vello_pipeline_synth.pdx --
// G4.M2 (#1480-1482)
//
// Boot witness for the compute pipeline substrate. Verifies validators,
// submit -> stroke -> fill -> blend -> COMPLETE chain, next_id
// monotone, await behaviour.
//
// Fingerprint: G4 VELLO_PIPELINE OK

module VelloPipelineSynth = structure {

  pub let mut _vpsw_stage : u64 = 0

  pub let vpsw_ok   : [u8; 22] = "G4 VELLO_PIPELINE OK\0"
  pub let vpsw_fail : [u8; 24] = "G4 VELLO_PIPELINE FAIL\0"

  pub let vello_pipeline_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M2 boot witness. Stages: (1) resets. (2) stage_valid + wind_valid. (3) next_id monotone. (4) allocate scene + renderer rows. (5) submit returns non-zero submit_id + finds by id. (6) run_stroke -> run_fill(NON_ZERO) -> run_blend transitions status to COMPLETE. (7) await COMPLETE returns OK; await bad id returns BAD_ID.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        call vp_reset;
        call vr_table_reset;
        call vs_table_reset;

        // 2. validators.
        mov rax, 2;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call vp_stage_valid;
        cmp rax, 1;
        jne vpsw_fail_stage;
        mov rdi, 3;
        call vp_stage_valid;
        cmp rax, 0;
        jne vpsw_fail_stage;
        mov rdi, 1;
        call vp_wind_valid;
        cmp rax, 1;
        jne vpsw_fail_stage;
        mov rdi, 2;
        call vp_wind_valid;
        cmp rax, 0;
        jne vpsw_fail_stage;

        // 3. next_id monotone + non-zero.
        mov rax, 3;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        call vp_next_id;
        cmp rax, 1;
        jne vpsw_fail_stage;
        call vp_next_id;
        cmp rax, 2;
        jne vpsw_fail_stage;

        // 4. Allocate scene row 0 + renderer row 0.
        mov rax, 4;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 32;                      // path_count
        mov rdx, 4;
        call vs_body1_pack;
        mov r12, rax;
        mov rdi, 3;
        mov rsi, 0;
        call vs_hdr_pack;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 0x0AA000;
        mov rdx, r12;
        mov rcx, 4096;
        call vs_tail_alloc;
        cmp rax, 0;
        jne vpsw_fail_stage;

        mov rdi, 20;
        mov rsi, 16;
        mov rdx, 4;
        mov rcx, 2;
        call vr_body1_pack;
        mov r12, rax;
        mov rdi, 6;
        mov rsi, 0xFF;
        call vr_hdr_pack;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 0x0BB000;
        mov rdx, r12;
        call vr_tail_alloc;
        cmp rax, 0;
        jne vpsw_fail_stage;

        // 5. submit(renderer_row=0, scene_row=0, bo_slot=42) -> id.
        mov rax, 5;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 42;
        call vp_submit;
        cmp rax, 0;
        je  vpsw_fail_stage;
        mov r15, rax;                     // submit_id
        mov rdi, r15;
        call vp_find_by_id;
        cmp rax, 0xFF;
        je  vpsw_fail_stage;
        mov r14, rax;                     // ring row_id

        // 6. run_stroke -> stage becomes 1, edges_out = 4 * 32 = 128.
        mov rax, 6;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        mov rdi, r14;
        call vp_run_stroke;
        cmp rax, 128;
        jne vpsw_fail_stage;
        mov rdi, r14;
        call vp_row_stage;
        cmp rax, 1;
        jne vpsw_fail_stage;

        mov rdi, r14;
        mov rsi, 1;                       // NON_ZERO
        call vp_run_fill;
        cmp rax, 0;
        jne vpsw_fail_stage;
        mov rdi, r14;
        call vp_row_stage;
        cmp rax, 2;
        jne vpsw_fail_stage;

        mov rdi, r14;
        call vp_run_blend;
        cmp rax, 0;
        jne vpsw_fail_stage;
        mov rdi, r14;
        call vp_row_status;
        cmp rax, 3;                       // COMPLETE
        jne vpsw_fail_stage;

        // 7. await OK on the completed submit; BAD_ID on 0xdead.
        mov rax, 7;
        lea rcx, [rip + _vpsw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        mov rsi, 0;
        call vp_await;
        cmp rax, 0;
        jne vpsw_fail_stage;
        mov rdi, 0xDEAD;
        mov rsi, 0;
        call vp_await;
        mov r10, 0xFFFFED89;
        cmp rax, r10;
        jne vpsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vpsw_ok];
        call klog_s1;

        call vp_reset;
        call vr_table_reset;
        call vs_table_reset;
        xor rax, rax;
        jmp vpsw_out;

      vpsw_fail_stage:
        lea rax, [rip + _vpsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vpsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vp_reset;
        call vr_table_reset;
        call vs_table_reset;
        mov rax, 1;

      vpsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
