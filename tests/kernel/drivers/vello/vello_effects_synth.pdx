// tests/kernel/drivers/vello/vello_effects_synth.pdx --
// G4.M3 (#1485-1487)
//
// Boot witness for the effects driver (gradient / blur / dash /
// arrow / marker). Verifies validators + enqueue + count_for.
//
// Fingerprint: G4 VELLO_EFFECTS OK

module VelloEffectsSynth = structure {

  pub let mut _vesw_stage : u64 = 0

  pub let vesw_ok   : [u8; 21] = "G4 VELLO_EFFECTS OK\0"
  pub let vesw_fail : [u8; 23] = "G4 VELLO_EFFECTS FAIL\0"

  pub let vello_effects_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M3 boot witness. Stages: (1) reset. (2) kind_valid + sigma_valid + stops_valid + dash_valid boundaries. (3) enqueue GRADIENT_LINEAR with stops=4; kind_of at row0 == 0; p1_of == 4. (4) enqueue BLUR with sigma=8. (5) enqueue DASH with n=4 (even). (6) count_for(submit_id=100) == 3.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        call ve_reset;

        // 2. validators.
        mov rax, 2;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        mov rdi, 6;
        call ve_kind_valid;
        cmp rax, 1;
        jne vesw_fail_stage;
        mov rdi, 7;
        call ve_kind_valid;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 128;
        call ve_sigma_valid;
        cmp rax, 1;
        jne vesw_fail_stage;
        mov rdi, 129;
        call ve_sigma_valid;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 0;
        call ve_sigma_valid;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 16;
        call ve_stops_valid;
        cmp rax, 1;
        jne vesw_fail_stage;
        mov rdi, 17;
        call ve_stops_valid;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 1;
        call ve_stops_valid;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 4;                       // even
        call ve_dash_valid;
        cmp rax, 1;
        jne vesw_fail_stage;
        mov rdi, 3;                       // odd
        call ve_dash_valid;
        cmp rax, 0;
        jne vesw_fail_stage;

        // 3. enqueue GRADIENT_LINEAR with stops=4.
        mov rax, 3;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        mov rdi, 100;                     // submit_id
        mov rsi, 0;                       // kind = LINEAR
        mov rdx, 4;                       // p1 = stops
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 0;
        jne vesw_fail_stage;              // row 0
        mov rdi, 0;
        call ve_kind_of;
        cmp rax, 0;
        jne vesw_fail_stage;
        mov rdi, 0;
        call ve_p1_of;
        cmp rax, 4;
        jne vesw_fail_stage;

        // 4. enqueue BLUR sigma=8.
        mov rax, 4;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 3;                       // BLUR
        mov rdx, 8;                       // sigma
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 1;
        jne vesw_fail_stage;

        // 5. enqueue DASH count=4.
        mov rax, 5;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 4;                       // DASH
        mov rdx, 4;                       // count
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 2;
        jne vesw_fail_stage;

        // 6. count_for(100) == 3.
        mov rax, 6;
        lea rcx, [rip + _vesw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        call ve_count_for;
        cmp rax, 3;
        jne vesw_fail_stage;
        mov rdi, 999;
        call ve_count_for;
        cmp rax, 0;
        jne vesw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vesw_ok];
        call klog_s1;

        call ve_reset;
        xor rax, rax;
        jmp vesw_out;

      vesw_fail_stage:
        lea rax, [rip + _vesw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vesw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ve_reset;
        mov rax, 1;

      vesw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
