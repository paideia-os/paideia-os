// tests/kernel/drivers/vello/g4_integration_synth.pdx --
// G4 milestone integration
//
// End-to-end integration walk across the G4 substrate: encode a
// scene through the channel, submit + advance through STROKE / FILL
// / BLEND, verify via CPU fallback hash equivalence, exercise
// tile-grid + effects overlays.
//
// Fingerprint: G4 INTEGRATION OK

module G4IntegrationSynth = structure {

  pub let mut _g4sw_stage : u64 = 0

  pub let g4sw_ok   : [u8; 19] = "G4 INTEGRATION OK\n\0"
  pub let g4sw_fail : [u8; 21] = "G4 INTEGRATION FAIL\n\0"

  pub let g4_integration_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4 integration walk. Stages: (1) reset all G4 state. (2) allocate scene + renderer rows. (3) vrenc_apply_encode requires KIND_VELLO_SCENE cap; call vse_encode direct then vse_upload. (4) vp_submit + vp_run_stroke + vp_run_fill(EVEN_ODD) + vp_run_blend transitions to COMPLETE. (5) vt_init + mark_occupied + mark_skipped + mark_coarsened. (6) ve_enqueue GRADIENT + BLUR + DASH; count_for equals 3. (7) vcf_start + vcf_ingest + vcf_verify(hash) OK.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        call vs_table_reset;
        call vr_table_reset;
        call vse_reset;
        call vp_reset;
        call vt_reset;
        call ve_reset;
        call vcf_reset;
        call vrenc_stats_reset;

        // 2. Allocate scene row 0 + renderer row 0.
        mov rax, 2;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, 7;                       // bo_slot
        mov rsi, 32;                      // path_count
        mov rdx, 4;                       // sample_count
        call vs_body1_pack;
        mov r12, rax;
        mov rdi, 3;
        mov rsi, 0;
        call vs_hdr_pack;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 0x0100;
        mov rdx, r12;
        mov rcx, 2048;
        call vs_tail_alloc;
        cmp rax, 0;
        jne g4sw_fail_stage;

        mov rdi, 22;
        mov rsi, 16;
        mov rdx, 4;
        mov rcx, 2;
        call vr_body1_pack;
        mov r12, rax;
        mov rdi, 8;
        mov rsi, 0x00FF;
        call vr_hdr_pack;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 0x0200;
        mov rdx, r12;
        call vr_tail_alloc;
        cmp rax, 0;
        jne g4sw_fail_stage;

        // 3. encode + upload direct on scene row 0.
        mov rax, 3;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 2048;
        mov rdx, 32;
        mov rcx, 4;
        mov r8,  0x000F;
        call vse_encode;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, 0;
        call vse_upload;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, 0;
        call vs_row_flags;
        cmp rax, 0x000F;
        jne g4sw_fail_stage;

        // 4. submit + run all three stages.
        mov rax, 4;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, 0;                       // renderer_row
        mov rsi, 0;                       // scene_row
        mov rdx, 42;                      // bo
        call vp_submit;
        cmp rax, 0;
        je  g4sw_fail_stage;
        mov r15, rax;
        mov rdi, r15;
        call vp_find_by_id;
        cmp rax, 0xFF;
        je  g4sw_fail_stage;
        mov r14, rax;
        mov rdi, r14;
        call vp_run_stroke;
        cmp rax, 128;                     // 32 paths * 4 AA
        jne g4sw_fail_stage;
        mov rdi, r14;
        mov rsi, 0;                       // EVEN_ODD
        call vp_run_fill;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, r14;
        call vp_run_blend;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, r15;
        mov rsi, 0;
        call vp_await;
        cmp rax, 0;
        jne g4sw_fail_stage;

        // 5. tile grid + occupancy.
        mov rax, 5;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        mov rsi, 240;                     // tx (4K/16)
        mov rdx, 135;                     // ty
        mov rcx, 2;                       // coarsening_level
        call vt_init;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, 0;
        call vt_mark_occupied;
        mov rdi, 0;
        call vt_mark_skipped;
        mov rdi, 0;
        call vt_mark_coarsened;

        // 6. effect stack overlays.
        mov rax, 6;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        mov rsi, 1;                       // GRAD_RADIAL
        mov rdx, 3;                       // stops
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, r15;
        mov rsi, 3;                       // BLUR
        mov rdx, 12;                      // sigma
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 1;
        jne g4sw_fail_stage;
        mov rdi, r15;
        mov rsi, 4;                       // DASH
        mov rdx, 4;
        mov rcx, 0;
        mov r8,  0;
        call ve_enqueue;
        cmp rax, 2;
        jne g4sw_fail_stage;
        mov rdi, r15;
        call ve_count_for;
        cmp rax, 3;
        jne g4sw_fail_stage;

        // 7. CPU fallback hash verify (matching).
        mov rax, 7;
        lea rcx, [rip + _g4sw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        call vcf_start;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 0xAA;
        mov r8,  0x55;
        mov r9,  0x11;
        call vcf_ingest;
        cmp rax, 0;
        jne g4sw_fail_stage;
        mov rdi, 0;
        call vcf_hash_of;
        mov r13, rax;
        mov rdi, 0;
        mov rsi, r13;
        call vcf_verify;
        cmp rax, 0;
        jne g4sw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g4sw_ok];
        call klog_s1;

        call vs_table_reset;
        call vr_table_reset;
        call vse_reset;
        call vp_reset;
        call vt_reset;
        call ve_reset;
        call vcf_reset;
        call vrenc_stats_reset;
        xor rax, rax;
        jmp g4sw_out;

      g4sw_fail_stage:
        lea rax, [rip + _g4sw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g4sw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vs_table_reset;
        call vr_table_reset;
        call vse_reset;
        call vp_reset;
        call vt_reset;
        call ve_reset;
        call vcf_reset;
        call vrenc_stats_reset;
        mov rax, 1;

      g4sw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
