// tests/kernel/drivers/vello/vello_scene_encoder_synth.pdx --
// G4.M1-005 (#1479) + G4.M1-001 (#1475)
//
// Boot witness for the scene encoder driver. Verifies state slot
// addressing, opcode validation, encode/upload roundtrip on scene
// row 0, parity flip, BUSY refusal.
//
// Fingerprint: G4 VELLO_ENCODER OK

module VelloSceneEncoderSynth = structure {

  pub let mut _vsesw_stage : u64 = 0

  pub let vsesw_ok   : [u8; 21] = "G4 VELLO_ENCODER OK\0"
  pub let vsesw_fail : [u8; 23] = "G4 VELLO_ENCODER FAIL\0"

  pub let vello_scene_encoder_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M1-005 (#1479): boot witness. Stages: (1) resets. (2) state_addr non-null for row 0, null for row 16. (3) op_valid. (4) allocate a scene row + encode. (5) uploads flips parity + clears active. (6) BUSY refusal when encoding on active row.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        call vs_table_reset;
        call vse_reset;

        // 2. state_addr.
        mov rax, 2;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vse_state_addr;
        cmp rax, 0;
        je  vsesw_fail_stage;
        mov rdi, 16;
        call vse_state_addr;
        cmp rax, 0;
        jne vsesw_fail_stage;

        // 3. op_valid: LINE_TO ok, 6 no.
        mov rax, 3;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call vse_op_valid;
        cmp rax, 1;
        jne vsesw_fail_stage;
        mov rdi, 6;
        call vse_op_valid;
        cmp rax, 0;
        jne vsesw_fail_stage;

        // 4. allocate scene row 0 (needed so vs_row_set_flags succeeds)
        // then encode.
        mov rax, 4;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        mov rdi, 5;                       // bo_slot
        mov rsi, 8;                       // path_count
        mov rdx, 4;                       // samples
        call vs_body1_pack;
        mov r12, rax;
        mov rdi, 3;                       // parent_slot
        mov rsi, 0;                       // flags
        call vs_hdr_pack;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 0xBEEF00;
        mov rdx, r12;
        mov rcx, 1024;                    // bytes
        call vs_tail_alloc;
        cmp rax, 0;
        jne vsesw_fail_stage;

        mov rdi, 0;                       // scene_row
        mov rsi, 1024;                    // encoded_bytes
        mov rdx, 8;                       // paths
        mov rcx, 4;                       // samples
        mov r8,  0x0001;                  // flags = HAS_GRADIENTS
        call vse_encode;
        cmp rax, 0;
        jne vsesw_fail_stage;
        mov rdi, 0;
        call vse_active;
        cmp rax, 1;
        jne vsesw_fail_stage;
        mov rdi, 0;
        call vse_bytes_written;
        cmp rax, 1024;
        jne vsesw_fail_stage;

        // 5. upload flips parity + clears active.
        mov rax, 5;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vse_upload;
        cmp rax, 0;
        jne vsesw_fail_stage;
        mov rdi, 0;
        call vse_active;
        cmp rax, 0;
        jne vsesw_fail_stage;
        mov rdi, 0;
        call vse_parity;
        cmp rax, 1;
        jne vsesw_fail_stage;

        // 6. second encode succeeds (buffer idle again after upload).
        //    Then re-encoding without upload gives BUSY.
        mov rax, 6;
        lea rcx, [rip + _vsesw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 512;
        mov rdx, 4;
        mov rcx, 4;
        mov r8,  0;
        call vse_encode;
        cmp rax, 0;
        jne vsesw_fail_stage;
        mov rdi, 0;
        mov rsi, 512;
        mov rdx, 4;
        mov rcx, 4;
        mov r8,  0;
        call vse_encode;
        mov r10, 0xFFFFED9C;
        cmp rax, r10;
        jne vsesw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vsesw_ok];
        call klog_s1;

        call vse_reset;
        call vs_table_reset;
        xor rax, rax;
        jmp vsesw_out;

      vsesw_fail_stage:
        lea rax, [rip + _vsesw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vsesw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vse_reset;
        call vs_table_reset;
        mov rax, 1;

      vsesw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
