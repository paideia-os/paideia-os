// tests/kernel/drivers/vk/bench_synth.pdx -- G3.M4 (#1472, #1473)
//
// Boot witness for bench driver: record, count, latency, average,
// and adaptive_complexity policy.
//
// Fingerprint: G3 VK_BENCH OK

module VkBenchSynth = structure {

  pub let mut _vkbw_stage : u64 = 0

  pub let vkbw_ok   : [u8; 16] = "G3 VK_BENCH OK\n\0"
  pub let vkbw_fail : [u8; 18] = "G3 VK_BENCH FAIL\n\0"

  pub let vk_bench_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M4-*: boot witness. Stages: (1) reset. (2) count = 0. (3) push (100, 200, 400, 16700000); count = 1; latency[0] = 300; average = 300. (4) push a second (50, 100, 250, 16700000); count = 2; average = (300 + 200) / 2 = 250. (5) adaptive_complexity(current=2, refresh=16700000): avg 250 <<< 60% of refresh; raise -> 3. (6) adaptive shed on slow avg: reset + push heavy (100, 200, 16000000, 16700000); adaptive_complexity(current=2, refresh=16700000): avg 15999900 > 90% of 16700000; shed -> 1.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        call vkb_reset;

        // 2. empty count = 0.
        mov rax, 2;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        call vkb_count;
        cmp rax, 0;
        jne vkbw_fail_stage;

        // 3. push one.
        mov rax, 3;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 200;
        mov rdx, 400;
        mov rcx, 16700000;
        call vkb_record;
        call vkb_count;
        cmp rax, 1;
        jne vkbw_fail_stage;
        mov rdi, 0;
        call vkb_latency;
        cmp rax, 300;
        jne vkbw_fail_stage;
        call vkb_average_latency;
        cmp rax, 300;
        jne vkbw_fail_stage;

        // 4. push second.
        mov rax, 4;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        mov rdi, 50;
        mov rsi, 100;
        mov rdx, 250;
        mov rcx, 16700000;
        call vkb_record;
        call vkb_count;
        cmp rax, 2;
        jne vkbw_fail_stage;
        call vkb_average_latency;
        cmp rax, 250;
        jne vkbw_fail_stage;

        // 5. adaptive: current=2, refresh=16700000, avg=250 (<<60%).
        //    Expect raise -> 3.
        mov rax, 5;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 16700000;
        call vkb_adaptive_complexity;
        cmp rax, 3;
        jne vkbw_fail_stage;

        // 6. reset + heavy record; adaptive expected to shed.
        mov rax, 6;
        lea rcx, [rip + _vkbw_stage];
        mov [rcx], rax;
        call vkb_reset;
        mov rdi, 100;
        mov rsi, 200;
        mov rdx, 16000100;
        mov rcx, 16700000;
        call vkb_record;
        mov rdi, 2;
        mov rsi, 16700000;
        call vkb_adaptive_complexity;
        cmp rax, 1;
        jne vkbw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkbw_ok];
        call klog_s1;

        call vkb_reset;
        xor rax, rax;
        jmp vkbw_out;

      vkbw_fail_stage:
        lea rax, [rip + _vkbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vkb_reset;
        mov rax, 1;

      vkbw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
