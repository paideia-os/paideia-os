// tests/kernel/drivers/vk/vk_features_synth.pdx -- G3.M3 (#1468-#1471)
//
// Boot witness for the VK features driver: present_id issuance,
// mark_observed, wait_present fast-path, gcd, and P3 fractional-
// scale validator.
//
// Fingerprint: G3 VK_FEATURES OK

module VkFeaturesSynth = structure {

  pub let mut _vkfw_stage : u64 = 0

  pub let vkfw_ok   : [u8; 19] = "G3 VK_FEATURES OK\0"
  pub let vkfw_fail : [u8; 21] = "G3 VK_FEATURES FAIL\0"

  pub let vk_features_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M3-*: boot witness. Stages: (1) reset. (2) issue_present_id monotone on surface 0. (3) mark_observed advances highest. (4) wait_present fast-path returns 0 when highest >= target. (5) gcd(12, 8) = 4. (6) scale_valid (3, 2) yes; (6, 4) no (not reduced); (0, 1) no.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        call vkf_reset;

        // 2. issue_present_id monotone.
        mov rax, 2;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vkf_issue_present_id;
        cmp rax, 0;
        jne vkfw_fail_stage;
        mov rdi, 0;
        call vkf_issue_present_id;
        cmp rax, 1;
        jne vkfw_fail_stage;
        mov rdi, 0;
        call vkf_issue_present_id;
        cmp rax, 2;
        jne vkfw_fail_stage;

        // 3. mark_observed.
        mov rax, 3;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 42;
        call vkf_mark_observed;
        cmp rax, 0;
        jne vkfw_fail_stage;
        mov rdi, 0;
        call vkf_last_present_id;
        cmp rax, 42;
        jne vkfw_fail_stage;
        // regressing to 10 leaves highest at 42.
        mov rdi, 0;
        mov rsi, 10;
        call vkf_mark_observed;
        mov rdi, 0;
        call vkf_last_present_id;
        cmp rax, 42;
        jne vkfw_fail_stage;

        // 4. wait_present fast-path on target=42, highest=42 returns 0.
        mov rax, 4;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 42;
        mov rdx, 0;
        call vkf_wait_present;
        cmp rax, 0;
        jne vkfw_fail_stage;

        // 5. gcd(12, 8) = 4.
        mov rax, 5;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        mov rdi, 12;
        mov rsi, 8;
        call vkf_gcd;
        cmp rax, 4;
        jne vkfw_fail_stage;

        // 6. scale_valid.
        mov rax, 6;
        lea rcx, [rip + _vkfw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call vkf_scale_valid;
        cmp rax, 1;
        jne vkfw_fail_stage;
        mov rdi, 6;
        mov rsi, 4;
        call vkf_scale_valid;
        cmp rax, 0;
        jne vkfw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call vkf_scale_valid;
        cmp rax, 0;
        jne vkfw_fail_stage;
        mov rdi, 1;
        mov rsi, 1;
        call vkf_scale_valid;
        cmp rax, 1;
        jne vkfw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkfw_ok];
        call klog_s1;

        call vkf_reset;
        xor rax, rax;
        jmp vkfw_out;

      vkfw_fail_stage:
        lea rax, [rip + _vkfw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkfw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vkf_reset;
        mov rax, 1;

      vkfw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
