// tests/kernel/drivers/vk/hw_smoke_g3_placeholder.pdx -- G3.M4-003 (#1474)
//
// D7-dormant HW-smoke placeholder for the "Vulkan triangle renders
// with feedback loop on real T14" acceptance. The recipe lives in
// tools/hw-smoke-g3.md; this module compiles and links but is NOT
// registered in the QEMU boot witness path per gated:hardware
// discipline.
//
// The real HW-smoke opens a KIND_VK_SURFACE against the T14 eDP,
// mints a KIND_VK_SWAPCHAIN_IMAGE swapchain (FIFO), submits a
// hardcoded SPIR-V triangle vertex+fragment pair, and asserts that
// vkWaitForPresentKHR against present_id=1 returns before a 100 ms
// watchdog with a non-zero timestamp reported through
// vk_present_feedback_channel.
//
// This placeholder exists so tools/build.sh can pin the file as
// present (present even if dormant), and tools/hw-smoke-g3.md can
// name it as the entry point a real T14 boot invokes when the
// operator sets G3_HW_SMOKE=1 in the loader sidecar.

module HwSmokeG3Placeholder = structure {

  pub let hw_smoke_g3_stub : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M4-003 (#1474): dormant HW-smoke stub. Not registered under QEMU; see tools/hw-smoke-g3.md for the real T14 recipe.",
      block: {
        ret
      }
    }
}
