// tests/kernel/drivers/vk/icd_synth.pdx -- G3.M1 (#1458, #1459, #1461)
//
// Boot witness for the ICD registry: extension registration, extension
// query, and the SPIR-V magic-word smoke.
//
// Fingerprint: G3 VK_ICD OK

module IcdSynth = structure {

  pub let mut _vkiw_stage : u64 = 0

  pub let vkiw_ok   : [u8; 14] = "G3 VK_ICD OK\0"
  pub let vkiw_fail : [u8; 16] = "G3 VK_ICD FAIL\0"

  // A synthetic SPIR-V header: little-endian magic 0x07230203 in
  // the low 32 bits of a u64. On x86-64 mov eax, [rdi] reads the
  // low four bytes as 0x07230203, which passes vki_spirv_check.
  pub let mut vki_spirv_hdr : [u64; 2] = uninit @align(8)

  // A synthetic bad blob with magic 0x00000000.
  pub let mut vki_bad_blob : [u64; 2] = uninit @align(8)

  pub let vk_icd_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M1-002/003/005: boot witness. Stages: (1) reset. (2) ext_valid. (3) version_valid. (4) register ICD 0xDEAD1 with extensions {KHR_SURFACE, KHR_SWAPCHAIN, PAIDEIA_SURFACE} v1.3. (5) has_ext KHR_SWAPCHAIN yes; VKI_EXT_KHR_PRESENT_ID no. (6) spirv_check on good magic OK. (7) spirv_check on bad magic refused. (8) spirv_check on 3-byte blob refused SHORT.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        call vki_reset;

        // Seed synth spirv blobs: hdr[0] = 0x07230203, blob[0] = 0.
        lea r10, [rip + vki_spirv_hdr];
        mov rax, 0x07230203;
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;
        lea r10, [rip + vki_bad_blob];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        // 2. ext_valid.
        mov rax, 2;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call vki_ext_valid;
        cmp rax, 1;
        jne vkiw_fail_stage;
        mov rdi, 6;
        call vki_ext_valid;
        cmp rax, 1;
        jne vkiw_fail_stage;
        mov rdi, 7;
        call vki_ext_valid;
        cmp rax, 0;
        jne vkiw_fail_stage;
        mov rdi, 0;
        call vki_ext_valid;
        cmp rax, 0;
        jne vkiw_fail_stage;

        // 3. version_valid.
        mov rax, 3;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        mov rdi, 0x00403000;
        call vki_version_valid;
        cmp rax, 1;
        jne vkiw_fail_stage;
        mov rdi, 0x00402000;               // 1.2
        call vki_version_valid;
        cmp rax, 0;
        jne vkiw_fail_stage;

        // 4. register ICD 0xDEAD1 with ext_bitmap
        //    bit1 (KHR_SURFACE) | bit2 (KHR_SWAPCHAIN) | bit6 (PAIDEIA_SURFACE)
        //    = 0x02 | 0x04 | 0x40 = 0x46.
        mov rax, 4;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        mov rdi, 0xDEAD1;
        mov rsi, 0x46;
        mov rdx, 0x00403000;
        call vki_register;
        // Returned row_id 0 is OK.
        cmp rax, 0;
        jne vkiw_fail_stage;

        // 5. has_ext row 0, KHR_SWAPCHAIN=2 yes; KHR_PRESENT_ID=3 no.
        mov rax, 5;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 2;
        call vki_has_ext;
        cmp rax, 1;
        jne vkiw_fail_stage;
        mov rdi, 0;
        mov rsi, 3;
        call vki_has_ext;
        cmp rax, 0;
        jne vkiw_fail_stage;

        // 6. spirv_check on 8-byte good blob.
        mov rax, 6;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        lea rdi, [rip + vki_spirv_hdr];
        mov rsi, 8;
        call vki_spirv_check;
        cmp rax, 0;
        jne vkiw_fail_stage;

        // 7. spirv_check on bad magic.
        mov rax, 7;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        lea rdi, [rip + vki_bad_blob];
        mov rsi, 8;
        call vki_spirv_check;
        mov r10, 0xFFFFEDDA;
        cmp rax, r10;
        jne vkiw_fail_stage;

        // 8. spirv_check on 3-byte blob refused SHORT.
        mov rax, 8;
        lea rcx, [rip + _vkiw_stage];
        mov [rcx], rax;
        lea rdi, [rip + vki_bad_blob];
        mov rsi, 3;
        call vki_spirv_check;
        mov r10, 0xFFFFEDD9;
        cmp rax, r10;
        jne vkiw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkiw_ok];
        call klog_s1;

        call vki_reset;
        xor rax, rax;
        jmp vkiw_out;

      vkiw_fail_stage:
        lea rax, [rip + _vkiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vkiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vki_reset;
        mov rax, 1;

      vkiw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
