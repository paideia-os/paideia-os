// tests/kernel/drivers/vk/swapchain_synth.pdx -- G3.M2 (#1463-1466)
//
// Boot witness for the swapchain driver seams: state slot addr,
// create + destroy round-trip on surface_row 0, acquire advancing
// next_index in rotation, and mode readback.
//
// Fingerprint: G3 VK_SWAPCHAIN DRIVER OK

module VkSwapchainSynth = structure {

  pub let mut _vswcw_stage : u64 = 0

  pub let vswcw_ok   : [u8; 27] = "G3 VK_SWAPCHAIN DRIVER OK\n\0"
  pub let vswcw_fail : [u8; 29] = "G3 VK_SWAPCHAIN DRIVER FAIL\n\0"

  pub let vk_swapchain_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M2-* boot witness. Stages: (1) reset. (2) state_addr non-null for row 0. (3) create(row=0, 1920, 1080, FIFO=0, count=3). (4) mode readback = 0. (5) acquire returns index 0, then 1, then 2, then wraps to 0. (6) resize sets recreate. (7) destroy scrubs slot.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        call vswc_reset;

        // 2. state_addr row 0 non-null.
        mov rax, 2;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vswc_state_addr;
        cmp rax, 0;
        je  vswcw_fail_stage;

        // 3. create(0, 1920, 1080, FIFO, 3).
        mov rax, 3;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1920;
        mov rdx, 1080;
        mov rcx, 0;
        mov r8,  3;
        call vswc_create;
        cmp rax, 0;
        je  vswcw_fail_stage;             // 0 is BAD (need non-zero swapchain_key)

        // 4. mode = 0 (FIFO).
        mov rax, 4;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vswc_mode;
        cmp rax, 0;
        jne vswcw_fail_stage;

        // 5. acquire: three in a row return 0, 1, 2; fourth wraps
        //    back to 0.
        mov rax, 5;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        call vswc_acquire;
        cmp rax, 0;
        jne vswcw_fail_stage;
        mov rdi, 0;
        mov rsi, 0;
        call vswc_acquire;
        cmp rax, 1;
        jne vswcw_fail_stage;
        mov rdi, 0;
        mov rsi, 0;
        call vswc_acquire;
        cmp rax, 2;
        jne vswcw_fail_stage;
        mov rdi, 0;
        mov rsi, 0;
        call vswc_acquire;
        cmp rax, 0;
        jne vswcw_fail_stage;

        // 6. resize.
        mov rax, 6;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 3840;
        mov rdx, 2160;
        call vswc_resize;
        cmp rax, 0;
        jne vswcw_fail_stage;

        // 7. destroy.
        mov rax, 7;
        lea rcx, [rip + _vswcw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vswc_destroy;
        cmp rax, 0;
        jne vswcw_fail_stage;
        // second destroy refuses NOT_CREATED.
        mov rdi, 0;
        call vswc_destroy;
        mov r10, 0xFFFFEDC7;
        cmp rax, r10;
        jne vswcw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vswcw_ok];
        call klog_s1;

        call vswc_reset;
        xor rax, rax;
        jmp vswcw_out;

      vswcw_fail_stage:
        lea rax, [rip + _vswcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vswcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vswc_reset;
        mov rax, 1;

      vswcw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
