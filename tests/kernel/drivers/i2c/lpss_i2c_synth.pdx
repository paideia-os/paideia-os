// tests/kernel/drivers/i2c/lpss_i2c_synth.pdx — R30.M5-003 (#1072) / R30.M5-004 (#1073)
//
// Boot witness for the LPSS I²C controller: probe, BAR-to-capability,
// identification, bring-up ordering, and the transfer engine.
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// There is no I²C hardware here and there will not be one in QEMU. The
// things worth testing in this milestone are not the MMIO stores — they
// are the DIVIDER ARITHMETIC, the BRING-UP ORDERING, the RIGHTS GATE and
// the TRANSFER STATE MACHINE, all of which are hardware-independent and
// all of which fail silently when wrong.
//
// So the register seam (`core/drivers/i2c/dw_io.pdx`) is switched to its
// synthetic side and everything above it runs UNCHANGED. The driver does
// not know the mode exists. Two things make the assertions real:
//
//   * the synthetic side is a DEVICE MODEL, not a RAM buffer — read-to-
//     clear registers really clear, IC_ENABLE really propagates to
//     IC_ENABLE_STATUS, a commanded STOP really raises STOP_DET, and an
//     armed NACK really aborts the next command;
//   * every access is appended to an ORDERED TRACE, so claims about
//     sequence ("the controller was disabled before its configuration
//     was written", "no write-phase command carried STOP") are checked
//     as inequalities between positions rather than inferred from final
//     state, which cannot distinguish the two orders at all.
//
// The capability checks are NOT bypassed in synthetic mode. A window
// minted without WRITE is refused a write here exactly as on metal,
// which is the only reason sub-test E's assertion means anything.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset every table, seam and slot this fixture touches.
//   B  THE DIVIDER, all four spec rates at a 100 MHz ic_clk, plus the
//      closed clock domain, the IC_CON word and the SDA hold. Includes
//      the assertion that High-speed's computed hcnt is BELOW the core
//      minimum, which is why bring-up refuses it rather than clamping.
//   C  An unbound seam refuses everything.
//   D  Controller row, then BAR -> capability: a wrong-kind parent is
//      refused, the right one mints, and a second bind is refused.
//   E  IDENTIFICATION by IC_COMP_TYPE. Confirmed for controller 0;
//      REJECTED (loudly, with state) for controller 1 on a mismatch;
//      and controller 1's READ-ONLY window refuses a write.
//   F  BRING-UP, and the ordering claim: disable, poll, configure,
//      enable, poll — asserted by trace position.
//   G  Bring-up refusals: an unknown ic_clk is REFUSED, not defaulted;
//      High-speed is refused; neither touches a register.
//   H  Bus capability, slave capabilities, controller attachment.
//   I  RIGHTS PER DIRECTION. A read-only capability is refused a write,
//      a write-only one a read, one without INVOKE anything at all —
//      and the refusal happens before any register is touched.
//   J  WRITE: one STOP, no RESTART, and IC_TAR programmed from the
//      CAPABILITY's address between a disable and an enable.
//   K  READ, three bytes, exact and exactly consumed.
//   L  WRITE_READ: REPEATED START. The write-phase command carries no
//      STOP, the first read command carries RESTART, the last carries
//      STOP. This is the whole reason the opcode exists.
//   M  NACK IS CLEAN: address NACK, data NACK and arbitration loss are
//      three distinct codes; IC_CLR_TX_ABRT is read on every one; the
//      abort bit is clear afterwards; and the NEXT transfer succeeds.
//   N  EVERY WAIT IS BOUNDED. A stuck bus produces a distinct timeout
//      per wait rather than a spin: enable, disable, TX FIFO, RX FIFO
//      and STOP.
//   O  BUS RECOVERY and the WEDGE LATCH: tier-1 recovery succeeds;
//      three consecutive failures latch; a latched bus fails fast
//      without touching a register; unwedge is the named exit.
//   P  SMBus: the supported protocols delegate, the unsupported ones
//      are refused by name, and a read-only capability is refused a
//      register read because its command byte is a write.
//   Q  THE ADDRESS MUTANT. A neighbouring device's address in every
//      register a smuggled parameter could arrive in changes nothing.
//   S  INTERRUPT-DRIVEN WRITE: the same wire, the same command flags,
//      the same address from the same capability, a different delivery
//      mechanism. Ends DONE with the line quiet and the claim back.
//   T  INTERRUPT-DRIVEN READ, three bytes, mask dropped at the third
//      command and not the first.
//   U  THE TX_EMPTY STORM, MEASURED. A level-triggered pump counts how
//      many times a CPU would have entered interrupt context; a correct
//      transfer needs two or three whatever its length. Then the mask
//      is put back by hand and the same measurement is asserted to blow
//      past the ceiling, because a bound nothing can breach is not one.
//   V  ADDRESS NACK vs DATA NACK, with an ACCURATE acknowledged-byte
//      count after the data NACK -- and the same armed abort asserted
//      to produce the same code through BOTH engines.
//   W  STOP_DET completes the FSM; its absence hits the existing
//      I2C_XFER_TIMEOUT_STOP and gives the bus back rather than hanging.
//   X  One claim and one wedge latch, shared by both engines.
//   R  Teardown.
//
// Cap slots 46..55, disjoint from every other witness's set (0..8,
// 10..12, 14..19, 28..33, 34..45). Both exits clear them, unbind and
// close the seam, and reset all three tables plus the FSM contexts.
//
// Two fingerprints, in order: R30 LPSS I2C OK for A..R and R30 LPSS
// I2C IRQ OK for S..X. Two rather than one widened marker, because a
// boot in which the polled engine works and the interrupt engine does
// not is a boot somebody needs to be able to see.
//
// On any failure the stage number in _lpss_w_stage identifies the
// assertion.

module LpssI2cSynth = structure {

  pub let mut _lpss_w_stage   : u64 = 0
  pub let mut _lpss_w_bus_row : u64 = 0
  pub let mut _lpss_w_wbuf    : [u64; 4] = uninit @align(8)
  pub let mut _lpss_w_rbuf    : [u64; 4] = uninit @align(8)

  // ==========================================================================
  // lpi_w_seed(slot, kind, rights, target) -> ()
  // ==========================================================================

  pub let lpi_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-003 (#1072): write a capability descriptor directly into cap_table[slot] (stride 24: kind at +0, rights at +8, target_ptr at +16). The fixture needs two BASE authorities no mint path in this kernel produces yet -- a KIND_MEMORY (4) carrying RIGHT_MINT, which is what the op-region root mint demands for a memory-like space, and a KIND_DEVICE (10) carrying a bdf key, which is what the bus mint inherits its controller identity from. Seeding them directly is what makes both gates testable in BOTH directions rather than only in the refusing one. Same device as the i2c capability-pair witness's preamble. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;  // [cap-descriptor-ok: R30.M5-003 fixture seeds KIND_MEMORY/KIND_DEVICE base authorities the kernel has no mint path for yet -- see justification]
        ret
      }
    }

  // ==========================================================================
  // lpi_w_clear_slots() -> ()
  // ==========================================================================

  pub let lpi_w_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-003 (#1072): zero cap_table slots 46..55, the ten this fixture consumes. Base offset 46*24 = 1104; 10 slots * 3 qwords = 30 qwords. Called on BOTH exits so a failure cannot leave a live KIND_OP_REGION over a fabricated physical base, or a slave capability, visible to whatever boots next. Leaf. Labels prefixed lpi_wc_.",
      block: {
        mov rax, cap_table;
        add rax, 1104;
        xor rcx, rcx;
        xor r8, r8;
      lpi_wc_next:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 30;
        jb  lpi_wc_next;
        ret
      }
    } @no_frame

  // ==========================================================================
  // lpi_w_wbyte(i, v) / lpi_w_rbyte(i) — fixture data buffers
  // ==========================================================================

  pub let lpi_w_wbyte : (u64, u64) -> () !{mem} @{} =
    fn (i: u64, v: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): store one byte into the fixture's outgoing buffer. Module storage rather than stack scratch so the buffer's address survives every nested call in a transfer without the fixture having to preserve rsp-relative pointers across five levels of callee. Bounded to 32 bytes. Leaf. Labels prefixed lpi_wb_.",
      block: {
        cmp rdi, 32;
        jae lpi_wb_out;
        lea r10, [rip + _lpss_w_wbuf];
        add r10, rdi;
        mov_b [r10 + 0], rsi;
      lpi_wb_out:
        ret
      }
    } @no_frame

  pub let lpi_w_rbyte : (u64) -> u64 !{mem} @{} =
    fn (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): read one byte from the fixture's incoming buffer, for the exact-bytes assertions in the read and combined-transfer sub-tests. Bounded to 32 bytes; 0 outside. Leaf. Labels prefixed lpi_rb_.",
      block: {
        cmp rdi, 32;
        jae lpi_rb_zero;
        lea r10, [rip + _lpss_w_rbuf];
        add r10, rdi;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        ret;
      lpi_rb_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let lpi_w_wbuf_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): address of the outgoing fixture buffer. Leaf.",
      block: {
        lea rax, [rip + _lpss_w_wbuf];
        ret
      }
    } @no_frame

  pub let lpi_w_rbuf_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): address of the incoming fixture buffer. Leaf.",
      block: {
        lea rax, [rip + _lpss_w_rbuf];
        ret
      }
    } @no_frame

  pub let lpi_w_rbuf_clear : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): zero the incoming buffer before a read, so 'the expected bytes are there' cannot pass on bytes a previous sub-test left behind. Leaf. Labels prefixed lpi_rc_.",
      block: {
        lea r10, [rip + _lpss_w_rbuf];
        xor rax, rax;
        xor rcx, rcx;
      lpi_rc_next:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  lpi_rc_next;
        ret
      }
    } @no_frame

  // ==========================================================================
  // lpi_w_pump(ctrl, max_iters) -> service events the FSM recorded
  //
  // A FAITHFUL MODEL OF LEVEL-TRIGGERED DELIVERY, which is the only
  // instrument that can measure an interrupt storm.
  // ==========================================================================

  pub let lpi_w_pump : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (ctrl: u64, max_iters: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-005 (#1074): drive the service routine the way an interrupt controller would, and report how much work it actually did. Each iteration asks dw_io_synth_line whether the controller is asserting -- IC_RAW_INTR_STAT ANDed with IC_INTR_MASK, which is precisely the condition an IOAPIC dispatches on -- and calls dw_i2c_isr_body ONLY THEN. That distinction is the entire instrument: a pump that called the handler unconditionally would measure nothing about masking, because the handler would run the same number of times whatever the mask said, and the TX_EMPTY storm would be invisible. It also advances modelled time, since observing the line is what the model uses for a clock, so a transfer waiting on the STOP latency progresses whether or not any interrupt is taken. The value returned is the FSM's OWN service counter rather than this loop's iteration count -- the quantity that matters is how many times a CPU had to enter interrupt context, not how many times the fixture looked. Bounded by max_iters so a driver that never completes fails the assertion instead of hanging the boot. Five pushes (rbx, r12-r15) leave rsp%16 == 0 at every nested call. Labels prefixed lpi_wp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // ctrl
        mov r13, rsi;                    // iteration cap
        xor r14, r14;

      lpi_wp_next:
        cmp r14, r13;
        jae lpi_wp_done;

        mov rdi, r12;
        call dw_irq_state;
        cmp rax, 5;                      // DW_IRQ_ST_TERMINAL
        jae lpi_wp_done;

        call dw_io_synth_line;
        cmp rax, 0;
        je  lpi_wp_bump;

        mov rdi, r12;
        call dw_i2c_isr_body;

      lpi_wp_bump:
        add r14, 1;
        jmp lpi_wp_next;

      lpi_wp_done:
        mov rdi, r12;
        call dw_irq_isr_calls;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_i2c_witness() -> 0 on success, 1 on failure
  // ==========================================================================

  pub let lpss_i2c_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-003 (#1072) / R30.M5-004 (#1073): the LPSS I2C boot witness, sub-tests A..R. Drives the SHIPPING probe, window mint, identification, bring-up and transfer engine against the synthetic side of the register seam; nothing below the seam is a test double, and the capability checks run unmodified in both modes. Every exit -- success and failure -- unbinds the seam, returns it to real MMIO, resets the controller/bus/slave tables and clears cap slots 46..55, so a failed assertion cannot leave the kernel addressing a RAM buffer in place of a controller or holding a live window over a fabricated physical base. Five-push prologue (rbx, r12-r15) leaves rsp%16 == 0 at every nested call; the stage counter is memory-backed because the primitives under test clobber every callee-save register. Labels prefixed lpi_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call lpi_w_clear_slots;
        call lpss_i2c_table_reset;
        call i2c_bus_table_reset;
        call i2c_slave_table_reset;
        call dw_irq_reset;
        call dw_io_unbind;
        call dw_io_synth_enable;

        call dw_irq_owner;
        cmp rax, 0;
        jne lpi_w_fail;

        call lpss_i2c_ctrl_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // B. THE DIVIDER. ic_clk = 100 MHz = 100000 kHz, t_fall = 0.
        //
        //   100 kHz  hcnt = 400500000/1e6 - 3 = 397   lcnt = 470 - 1 = 469
        //   400 kHz  hcnt =  60500000/1e6 - 3 =  57   lcnt = 130 - 1 = 129
        //   1 MHz    hcnt =  26500000/1e6 - 3 =  23   lcnt =  50 - 1 =  49
        //   3.4 MHz  hcnt =   6500000/1e6 - 3 =   3   lcnt =  12 - 1 =  11
        //
        // The last row is why bring-up refuses High-speed: 3 is below
        // the core's minimum of 6, and a core programmed with it does
        // not generate 3.4 MHz -- it generates something else and
        // reports nothing.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // Standard mode.
        mov rdi, 100000;
        mov rsi, 4000;
        xor rdx, rdx;
        call dw_i2c_scl_hcnt;
        cmp rax, 397;
        jne lpi_w_fail;
        mov rdi, 100000;
        mov rsi, 4700;
        xor rdx, rdx;
        call dw_i2c_scl_lcnt;
        cmp rax, 469;
        jne lpi_w_fail;

        // Fast mode.
        mov rdi, 100000;
        mov rsi, 600;
        xor rdx, rdx;
        call dw_i2c_scl_hcnt;
        cmp rax, 57;
        jne lpi_w_fail;
        mov rdi, 100000;
        mov rsi, 1300;
        xor rdx, rdx;
        call dw_i2c_scl_lcnt;
        cmp rax, 129;
        jne lpi_w_fail;

        // Fast mode plus.
        mov rdi, 100000;
        mov rsi, 260;
        xor rdx, rdx;
        call dw_i2c_scl_hcnt;
        cmp rax, 23;
        jne lpi_w_fail;
        mov rdi, 100000;
        mov rsi, 500;
        xor rdx, rdx;
        call dw_i2c_scl_lcnt;
        cmp rax, 49;
        jne lpi_w_fail;

        // High speed.
        mov rdi, 100000;
        mov rsi, 60;
        xor rdx, rdx;
        call dw_i2c_scl_hcnt;
        cmp rax, 3;
        jne lpi_w_fail;
        mov rdi, 100000;
        mov rsi, 120;
        xor rdx, rdx;
        call dw_i2c_scl_lcnt;
        cmp rax, 11;
        jne lpi_w_fail;

        // The spec-table lookups agree with the numbers above.
        mov rdi, 100000;
        call dw_i2c_t_high;
        cmp rax, 4000;
        jne lpi_w_fail;
        mov rdi, 400000;
        call dw_i2c_t_low;
        cmp rax, 1300;
        jne lpi_w_fail;
        mov rdi, 1000000;
        call dw_i2c_t_high;
        cmp rax, 260;
        jne lpi_w_fail;
        mov rdi, 3400000;
        call dw_i2c_t_low;
        cmp rax, 120;
        jne lpi_w_fail;
        mov rdi, 90000;                  // not one of the four
        call dw_i2c_t_high;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpi_w_fail;

        // Count validity: the three usable rates pass, High-speed fails.
        mov rdi, 397;
        mov rsi, 469;
        call dw_i2c_counts_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 57;
        mov rsi, 129;
        call dw_i2c_counts_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 23;
        mov rsi, 49;
        call dw_i2c_counts_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 3;                      // High-speed hcnt at 100 MHz
        mov rsi, 11;
        call dw_i2c_counts_valid;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 6;                      // exactly the minimum
        mov rsi, 8;
        call dw_i2c_counts_valid;
        cmp rax, 1;
        jne lpi_w_fail;

        // The clock domain is CLOSED.
        mov rdi, 100000000;
        call dw_i2c_clk_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 120000000;
        call dw_i2c_clk_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 133000000;
        call dw_i2c_clk_valid;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 50000000;
        call dw_i2c_clk_valid;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_i2c_clk_valid;
        cmp rax, 0;
        jne lpi_w_fail;

        // IC_CON. MASTER | RESTART_EN | SLAVE_DISABLE = 0x61, plus the
        // speed field, plus 10-bit master addressing when asked.
        mov rdi, 100000;
        xor rsi, rsi;
        call dw_i2c_con_for_speed;
        cmp rax, 0x63;
        jne lpi_w_fail;
        mov rdi, 400000;
        xor rsi, rsi;
        call dw_i2c_con_for_speed;
        cmp rax, 0x65;
        jne lpi_w_fail;
        mov rdi, 1000000;                // Fast-plus uses the FAST field
        xor rsi, rsi;
        call dw_i2c_con_for_speed;
        cmp rax, 0x65;
        jne lpi_w_fail;
        mov rdi, 400000;
        mov rsi, 1;
        call dw_i2c_con_for_speed;
        cmp rax, 0x75;
        jne lpi_w_fail;

        // SDA hold: 300 ns at 100 MHz is 30 ic_clk periods.
        mov rdi, 100000;
        call dw_i2c_sda_hold;
        cmp rax, 30;
        jne lpi_w_fail;

        // ================================================================
        // C. An unbound seam refuses everything.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call dw_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;     // DW_IO_FAULT
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        call dw_io_write32;
        mov r15, 0xFFFFFF3F;             // DW_IO_UNBOUND
        cmp rax, r15;
        jne lpi_w_fail;

        call dw_io_window_slot;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // D. Controller rows, then BAR -> capability.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // Base authorities. Slot 46 = KIND_MEMORY with RIGHT_MINT (what
        // a memory-like op-region root demands); slot 48 = KIND_DEVICE
        // with RIGHT_MINT and a bdf key (what the bus mint inherits
        // controller identity from).
        mov rdi, 46;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call lpi_w_seed;

        mov rdi, 48;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0x1500;                 // bdf_pack(0,0,21,0)
        call lpi_w_seed;

        // Controller 0: Intel wrapper, 4 KiB window.
        mov rdi, 0x1500;
        mov rsi, 1;                      // intel wrapper
        mov rdx, 0xFED10000;
        mov rcx, 0x1000;
        call lpss_i2c_record;
        cmp rax, 0;
        jne lpi_w_fail;

        // Controller 1: NOT an Intel wrapper, so identification skips
        // the private-space reset release and only reads.
        mov rdi, 0x1501;
        xor rsi, rsi;
        mov rdx, 0xFED11000;
        mov rcx, 0x1000;
        call lpss_i2c_record;
        cmp rax, 1;
        jne lpi_w_fail;

        call lpss_i2c_ctrl_count;
        cmp rax, 2;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpss_i2c_ctrl_state;
        cmp rax, 1;                      // LPSS_I2C_STATE_CANDIDATE
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_bar_base;
        mov r15, 0xFED10000;
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_bar_len;
        cmp rax, 0x1000;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_intel;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 1;
        call lpss_i2c_ctrl_intel;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_bdf;
        mov r15, 0x1500;
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_bus_row;
        mov r15, 0xFFFF;                 // LPSS_I2C_NO_BUS_ROW
        cmp rax, r15;
        jne lpi_w_fail;

        // A zero-length extent is refused: a window covering nothing
        // would mint a capability and then refuse every access with a
        // range error naming the wrong problem.
        mov rdi, 0x1502;
        xor rsi, rsi;
        mov rdx, 0xFED12000;
        xor rcx, rcx;
        call lpss_i2c_record;
        mov r15, 0xFFFFFF5D;             // LPSS_I2C_PROBE_NO_BAR
        cmp rax, r15;
        jne lpi_w_fail;
        call lpss_i2c_ctrl_count;
        cmp rax, 2;
        jne lpi_w_fail;

        // THE WINDOW MINT. A KIND_DEVICE parent is the wrong authority
        // for a memory-like space and is refused; nothing is written.
        xor rdi, rdi;
        mov rsi, 48;                     // KIND_DEVICE, not KIND_MEMORY
        mov rdx, 47;
        mov rcx, 0x61B;                  // R_OPREG_ALL
        call lpss_i2c_bind_window;
        mov r15, 0xFFFFFF5B;             // LPSS_I2C_WIN_BAD_PARENT
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_window;
        cmp rax, 0;
        jne lpi_w_fail;

        // The right authority mints.
        xor rdi, rdi;
        mov rsi, 46;                     // KIND_MEMORY + RIGHT_MINT
        mov rdx, 47;
        mov rcx, 0x61B;
        call lpss_i2c_bind_window;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_window;
        cmp rax, 47;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_state;
        cmp rax, 2;                      // LPSS_I2C_STATE_WINDOWED
        jne lpi_w_fail;

        // The minted window really is a KIND_OP_REGION over the extent
        // the ROW recorded -- inherited, never argued.
        mov rdi, 47;
        call lpss_i2c_wit_kind;
        mov r15, 0x150;                  // KIND_OP_REGION
        cmp rax, r15;
        jne lpi_w_fail;

        // A second bind is refused: two live capabilities for one
        // controller's registers, with no revoke relationship between
        // them, is not something this driver hands out.
        xor rdi, rdi;
        mov rsi, 46;
        mov rdx, 55;
        mov rcx, 0x61B;
        call lpss_i2c_bind_window;
        mov r15, 0xFFFFFF5A;             // LPSS_I2C_WIN_ALREADY
        cmp rax, r15;
        jne lpi_w_fail;

        // Controller 1 gets a READ-ONLY window (no RIGHT_WRITE).
        mov rdi, 1;
        mov rsi, 46;
        mov rdx, 53;
        mov rcx, 0x409;                  // READ | INVOKE | OBSERVE
        call lpss_i2c_bind_window;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // E. IDENTIFICATION by the IP's own identity register.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // Controller 1 first, with a WRONG IC_COMP_TYPE. It is not an
        // Intel wrapper, so identification performs no write -- which
        // is what lets a read-only window get this far.
        mov rdi, 0xFC;
        mov rsi, 0x12345678;
        call dw_io_synth_poke;

        mov rdi, 1;
        call dw_i2c_identify;
        mov r15, 0xFFFFFF5C;             // LPSS_I2C_PROBE_NOT_DESIGNWARE
        cmp rax, r15;
        jne lpi_w_fail;
        mov rdi, 1;
        call lpss_i2c_ctrl_state;
        cmp rax, 5;                      // LPSS_I2C_STATE_REJECTED
        jne lpi_w_fail;

        // The seam is still bound to controller 1's READ-ONLY window.
        // A read is allowed; a write is REFUSED, and nothing is stored.
        mov rdi, 0xFC;
        call dw_io_read32;
        mov r15, 0x12345678;
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, 0x00;
        mov rsi, 0xDEAD;
        call dw_io_write32;
        mov r15, 0xFFFFFF3B;             // DW_IO_NO_WRITE
        cmp rax, r15;
        jne lpi_w_fail;
        mov rdi, 0x00;
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;

        // An offset past the window is refused rather than clamped.
        mov rdi, 0x2000;
        call dw_io_read32;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpi_w_fail;

        // Now controller 0, with the real Synopsys signature.
        mov rdi, 0xFC;
        mov rsi, 0x44570140;             // DW_COMP_TYPE_MAGIC
        call dw_io_synth_poke;

        call dw_io_trace_reset;
        xor rdi, rdi;
        call dw_i2c_identify;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_state;
        cmp rax, 3;                      // LPSS_I2C_STATE_IDENTIFIED
        jne lpi_w_fail;

        // The Intel function reset was released, and it was released
        // BEFORE the identity register was read -- the ordering that,
        // reversed, rejects every Intel controller on the machine
        // because the block still reads back zero.
        mov rdi, 0x204;
        call dw_io_synth_peek;
        cmp rax, 0x7;                    // LPSS_RESETS_RELEASE
        jne lpi_w_fail;

        mov rdi, 2;                      // DW_TRACE_OP_WRITE
        mov rsi, 0x204;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r12, rax;                    // reset-release index

        mov rdi, 1;                      // DW_TRACE_OP_READ
        mov rsi, 0xFC;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r13, rax;                    // COMP_TYPE read index

        cmp r12, r13;
        jae lpi_w_fail;                  // reset MUST precede the read

        // Re-identifying a live controller is refused rather than
        // silently re-releasing a reset under a transfer in flight.
        xor rdi, rdi;
        call dw_i2c_identify;
        mov r15, 0xFFFFFF49;             // LPSS_I2C_IDENTIFY_ALREADY
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // G'. Bring-up refusals come BEFORE any register is touched.
        //     (Run before the successful bring-up so "no register was
        //     written" is an assertion about an empty trace rather than
        //     about the absence of a second write.)
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // An ic_clk nobody has shipped is REFUSED. It is never
        // defaulted to 100 MHz: a wrong divider does not error, it
        // mis-clocks, and it mis-clocks on the customer's cold boot.
        call dw_io_trace_reset;
        xor rdi, rdi;
        mov rsi, 50000000;
        mov rdx, 400000;
        xor rcx, rcx;
        call dw_i2c_bringup;
        mov r15, 0xFFFFFF58;             // LPSS_I2C_INIT_CLK_UNKNOWN
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // High-speed is refused: it needs a master-code preamble this
        // milestone does not implement, and its hcnt is below the
        // core's minimum at every supported ic_clk.
        xor rdi, rdi;
        mov rsi, 100000000;
        mov rdx, 3400000;
        xor rcx, rcx;
        call dw_i2c_bringup;
        mov r15, 0xFFFFFF57;             // LPSS_I2C_INIT_SPEED_UNSUPPORTED
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // A rate outside the four is refused too.
        xor rdi, rdi;
        mov rsi, 100000000;
        mov rdx, 90000;
        xor rcx, rcx;
        call dw_i2c_bringup;
        mov r15, 0xFFFFFF57;
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpss_i2c_ctrl_state;
        cmp rax, 3;                      // still merely IDENTIFIED
        jne lpi_w_fail;

        // Bringing up a controller that was never identified is refused.
        mov rdi, 1;                      // REJECTED controller
        mov rsi, 100000000;
        mov rdx, 400000;
        xor rcx, rcx;
        call dw_i2c_bringup;
        mov r15, 0xFFFFFF53;             // LPSS_I2C_INIT_NOT_IDENTIFIED
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // F. BRING-UP, and THE ORDERING CLAIM.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call dw_io_trace_reset;
        xor rdi, rdi;
        mov rsi, 100000000;
        mov rdx, 400000;                 // Fast mode
        xor rcx, rcx;
        call dw_i2c_bringup;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpss_i2c_ctrl_state;
        cmp rax, 4;                      // LPSS_I2C_STATE_READY
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_clk;
        mov r15, 100000000;
        cmp rax, r15;
        jne lpi_w_fail;

        // Final register state.
        mov rdi, 0x00;                   // IC_CON
        call dw_io_synth_peek;
        cmp rax, 0x65;
        jne lpi_w_fail;
        mov rdi, 0x1C;                   // IC_FS_SCL_HCNT
        call dw_io_synth_peek;
        cmp rax, 57;
        jne lpi_w_fail;
        mov rdi, 0x20;                   // IC_FS_SCL_LCNT
        call dw_io_synth_peek;
        cmp rax, 129;
        jne lpi_w_fail;

        // The bank this rate does NOT use is left at its reset value.
        // The rate lives in the bus capability, so changing it means a
        // different capability and a re-run, not a register poke.
        mov rdi, 0x14;                   // IC_SS_SCL_HCNT
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 0x18;
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 0x7C;                   // IC_SDA_HOLD
        call dw_io_synth_peek;
        cmp rax, 30;
        jne lpi_w_fail;
        mov rdi, 0x6C;                   // IC_ENABLE
        call dw_io_synth_peek;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 0x9C;                   // IC_ENABLE_STATUS
        call dw_io_synth_peek;
        cmp rax, 1;
        jne lpi_w_fail;

        // ---- THE ORDERING, from the trace ----
        //
        // Final state cannot distinguish "disabled, configured,
        // enabled" from "configured while enabled, then toggled": both
        // leave the same registers holding the same values, and the
        // second silently discards the configuration on real silicon.
        // Only positions can tell them apart.

        // The first IC_ENABLE write is the DISABLE, and its value is 0.
        mov rdi, 2;
        mov rsi, 0x6C;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r12, rax;                    // disable index

        mov rdi, r12;
        mov rsi, 2;                      // value field
        call dw_io_trace_field;
        cmp rax, 0;
        jne lpi_w_fail;

        // The disable was CONFIRMED by polling IC_ENABLE_STATUS, not
        // assumed from the write. The core's enable is asynchronous.
        mov rdi, 1;
        mov rsi, 0x9C;
        mov rdx, r12;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r13, rax;                    // disable-poll index
        cmp r12, r13;
        jae lpi_w_fail;

        // IC_CON was written AFTER the confirmed disable.
        mov rdi, 2;
        mov rsi, 0x00;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r14, rax;                    // IC_CON index
        cmp r13, r14;
        jae lpi_w_fail;

        // ... and so were the divider registers.
        mov rdi, 2;
        mov rsi, 0x1C;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        cmp r14, rax;
        jae lpi_w_fail;
        mov r14, rax;                    // HCNT index

        // The ENABLE came after all of it, and its value is 1.
        mov r15, r12;
        add r15, 1;
        mov rdi, 2;
        mov rsi, 0x6C;
        mov rdx, r15;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r15, rax;                    // enable index
        cmp r14, r15;
        jae lpi_w_fail;

        mov rdi, r15;
        mov rsi, 2;
        call dw_io_trace_field;
        cmp rax, 1;
        jne lpi_w_fail;

        // And the enable was confirmed by a poll of its own.
        mov rdi, 1;
        mov rsi, 0x9C;
        mov rdx, r15;
        call dw_io_trace_find;
        mov r12, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r12;
        je  lpi_w_fail;
        cmp r15, rax;
        jae lpi_w_fail;

        // ================================================================
        // H. Bus capability, slaves, controller attachment.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 49;
        mov rsi, 48;
        mov rdx, 0x618;                  // R_I2C_BUS_ALL
        mov rcx, 400000;
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 49;
        call i2c_bus_row_of_slot;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        lea rcx, [rip + _lpss_w_bus_row];
        mov [rcx], rax;
        mov r12, rax;

        // Before attachment there is no controller for this bus.
        mov rdi, r12;
        call lpss_i2c_find_by_bus_row;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpi_w_fail;

        // An out-of-range bus row is refused.
        xor rdi, rdi;
        mov rsi, 99;
        call lpss_i2c_attach_bus;
        mov r15, 0xFFFFFF52;             // LPSS_I2C_BUS_ATTACH_BAD_ROW
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        mov rsi, r12;
        call lpss_i2c_attach_bus;
        cmp rax, 0;
        jne lpi_w_fail;

        // Re-pointing a live controller at another bus row is refused:
        // it would silently redirect every slave capability derived
        // from the old one.
        xor rdi, rdi;
        mov rsi, r12;
        call lpss_i2c_attach_bus;
        mov r15, 0xFFFFFF51;             // LPSS_I2C_BUS_ATTACH_ALREADY
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, r12;
        call lpss_i2c_find_by_bus_row;
        cmp rax, 0;
        jne lpi_w_fail;

        // An unattached controller is not found by the sentinel row.
        mov rdi, 0xFFFF;
        call lpss_i2c_find_by_bus_row;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        jne lpi_w_fail;

        // Slave capabilities: full, read-only, write-only, no-invoke.
        mov rdi, 50;
        mov rsi, 49;
        mov rdx, 0x41B;                  // R_I2C_SLAVE_ALL
        mov rcx, 0x1A;
        xor r8, r8;                      // 7-bit
        mov r9, 0xAA;                    // driver hint
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x009;                  // INVOKE | READ
        mov rcx, 0x2B;
        xor r8, r8;
        mov r9, 0xBB;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 52;
        mov rsi, 49;
        mov rdx, 0x00A;                  // INVOKE | WRITE
        mov rcx, 0x3C;
        xor r8, r8;
        mov r9, 0xCC;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 54;
        mov rsi, 49;
        mov rdx, 0x001;                  // READ, but NO INVOKE
        mov rcx, 0x4D;
        xor r8, r8;
        mov r9, 0xDD;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne lpi_w_fail;

        // The addresses came from the mint and live in the rows.
        mov rdi, 50;
        call i2c_slave_addr_of_slot;
        cmp rax, 0x1A;
        jne lpi_w_fail;
        mov rdi, 51;
        call i2c_slave_addr_of_slot;
        cmp rax, 0x2B;
        jne lpi_w_fail;
        mov rdi, 50;
        call i2c_slave_bus_row_of_slot;
        cmp rax, r12;
        jne lpi_w_fail;
        mov rdi, 50;
        call i2c_slave_mode_of_slot;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // I. RIGHTS PER DIRECTION.
        //
        // #1071 reserved READ and WRITE in R_I2C_SLAVE_ALL with nothing
        // consuming them, precisely so a capability minted before this
        // landing would be REFUSED a transfer rather than silently
        // acquiring one. This is where they are consumed.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // A read-only capability may not write.
        mov rdi, 51;
        mov rsi, 0x00A;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6B;             // I2C_XFER_NO_WRITE_RIGHT
        cmp rax, r15;
        jne lpi_w_fail;

        // A write-only capability may not read.
        mov rdi, 52;
        mov rsi, 0x009;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6C;             // I2C_XFER_NO_READ_RIGHT
        cmp rax, r15;
        jne lpi_w_fail;

        // Neither may perform a combined transfer.
        mov rdi, 51;
        mov rsi, 0x00B;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6B;
        cmp rax, r15;
        jne lpi_w_fail;
        mov rdi, 52;
        mov rsi, 0x00B;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6C;
        cmp rax, r15;
        jne lpi_w_fail;

        // Without INVOKE, nothing at all.
        mov rdi, 54;
        mov rsi, 0x009;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6D;             // I2C_XFER_NO_INVOKE
        cmp rax, r15;
        jne lpi_w_fail;

        // A capability of another kind is not a slave capability.
        mov rdi, 46;                     // KIND_MEMORY
        mov rsi, 0x009;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6E;             // I2C_XFER_WRONG_KIND
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, 300;
        mov rsi, 0x009;
        call i2c_xfer_resolve;
        mov r15, 0xFFFFFF6F;             // I2C_XFER_BAD_SLOT
        cmp rax, r15;
        jne lpi_w_fail;

        // The full capability resolves to controller 0.
        mov rdi, 50;
        mov rsi, 0x00B;
        call i2c_xfer_resolve;
        cmp rax, 0;
        jne lpi_w_fail;

        // END TO END: the refusal happens before ANY register is
        // touched -- a denied caller must not be able to disturb the
        // bus on its way to being denied.
        call dw_io_trace_reset;
        mov rdi, 51;                     // read-only
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 51;
        mov rdx, 1;
        mov rcx, 64;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF6B;             // I2C_XFER_NO_WRITE_RIGHT
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // A zero length is refused, and an over-long one.
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        xor rdx, rdx;
        mov rcx, 64;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF67;             // I2C_XFER_BAD_LEN
        cmp rax, r15;
        jne lpi_w_fail;

        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 4096;
        mov rcx, 64;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF67;
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // J. WRITE: one STOP, no RESTART, and IC_TAR from the CAPABILITY.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;                   // IC_STATUS
        mov rsi, 0x02;                   // TFNF: room in the TX FIFO
        call dw_io_synth_poke;

        mov rdi, 0;
        mov rsi, 0xAB;
        call lpi_w_wbyte;

        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // The device addressed is the one the CAPABILITY names, and the
        // fixture never supplied an address anywhere.
        mov rdi, 0x04;                   // IC_TAR
        call dw_io_synth_peek;
        cmp rax, 0x1A;
        jne lpi_w_fail;

        // Exactly one command carried STOP; none carried RESTART.
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x200;                  // DW_CMD_STOP
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;                  // DW_CMD_RESTART
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x100;                  // DW_CMD_READ
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;

        // The pushed word is the byte plus STOP and nothing else.
        mov rdi, 2;
        mov rsi, 0x10;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov rdi, rax;
        mov rsi, 2;
        call dw_io_trace_field;
        mov r15, 0x2AB;                  // 0xAB | DW_CMD_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        // IC_TAR was written while the controller was DISABLED. Writing
        // it enabled is accepted and discarded by the real core, and
        // the transfer then goes to whatever address was there before.
        mov rdi, 2;
        mov rsi, 0x6C;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r12, rax;
        mov rdi, 2;
        mov rsi, 0x04;                   // IC_TAR
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r13, rax;
        cmp r12, r13;
        jae lpi_w_fail;                  // disable precedes IC_TAR
        mov r15, r12;
        add r15, 1;
        mov rdi, 2;
        mov rsi, 0x6C;
        mov rdx, r15;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        cmp r13, rax;
        jae lpi_w_fail;                  // IC_TAR precedes re-enable

        // ================================================================
        // K. READ, three bytes, exact and exactly consumed.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call lpi_w_rbuf_clear;
        mov rdi, 0x11;
        call dw_io_synth_push_rx;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 0x22;
        call dw_io_synth_push_rx;
        mov rdi, 0x33;
        call dw_io_synth_push_rx;

        call dw_io_trace_reset;
        call lpi_w_rbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 3;
        mov rcx, 4096;
        call i2c_xfer_read;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpi_w_rbyte;
        cmp rax, 0x11;
        jne lpi_w_fail;
        mov rdi, 1;
        call lpi_w_rbyte;
        cmp rax, 0x22;
        jne lpi_w_fail;
        mov rdi, 2;
        call lpi_w_rbyte;
        cmp rax, 0x33;
        jne lpi_w_fail;

        // Exactly three bytes consumed -- not two, not four.
        call dw_io_synth_rx_pending;
        cmp rax, 0;
        jne lpi_w_fail;

        // Three read commands, one STOP, no RESTART.
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x100;
        call dw_io_trace_count_bit;
        cmp rax, 3;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x200;
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // L. WRITE_READ — THE REPEATED START.
        //
        // The write phase must not be terminated by a STOP. A STOP
        // releases the bus; another master may take it, or the part may
        // time out its own register pointer, and the read that follows
        // returns a DIFFERENT register's contents with no error
        // anywhere. That bug is invisible in final state and visible
        // here only because the trace records the command flags.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call lpi_w_rbuf_clear;
        mov rdi, 0x55;
        call dw_io_synth_push_rx;
        mov rdi, 0x66;
        call dw_io_synth_push_rx;

        xor rdi, rdi;
        mov rsi, 0x07;                   // the register pointer byte
        call lpi_w_wbyte;

        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov r14, rax;
        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 50;
        mov rsi, r14;
        mov rdx, 1;                      // wlen
        mov r8,  2;                      // rlen
        mov r9,  4096;
        call i2c_xfer_write_read;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpi_w_rbyte;
        cmp rax, 0x55;
        jne lpi_w_fail;
        mov rdi, 1;
        call lpi_w_rbyte;
        cmp rax, 0x66;
        jne lpi_w_fail;

        // EXACTLY ONE RESTART and EXACTLY ONE STOP across the whole
        // combined transfer.
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x200;
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;

        // Command 0: the register pointer. Plain write, NO STOP.
        mov rdi, 2;
        mov rsi, 0x10;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r12, rax;
        mov rdi, r12;
        mov rsi, 2;
        call dw_io_trace_field;
        cmp rax, 0x07;
        jne lpi_w_fail;

        // Command 1: READ with RESTART -- the turnaround, bus held.
        mov r15, r12;
        add r15, 1;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, r15;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r13, rax;
        mov rdi, r13;
        mov rsi, 2;
        call dw_io_trace_field;
        mov r15, 0x500;                  // DW_CMD_READ | DW_CMD_RESTART
        cmp rax, r15;
        jne lpi_w_fail;

        // Command 2: READ with STOP -- and only now.
        mov r15, r13;
        add r15, 1;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, r15;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov rdi, rax;
        mov rsi, 2;
        call dw_io_trace_field;
        mov r15, 0x300;                  // DW_CMD_READ | DW_CMD_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // M. NACK IS A CLEAN OUTCOME.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 0xAB;
        call lpi_w_wbyte;

        // Address NACK: nothing is there.
        mov rdi, 0x01;                   // DW_ABRT_7B_ADDR_NOACK
        call dw_io_synth_arm_nack;
        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF63;             // I2C_XFER_NACK_ADDR
        cmp rax, r15;
        jne lpi_w_fail;

        call i2c_xfer_last_abort;
        cmp rax, 0x01;
        jne lpi_w_fail;

        // THE CONTROLLER IS NOT WEDGED. IC_CLR_TX_ABRT was read, which
        // is what releases the flush-held TX FIFO; the abort bit and the
        // source word are both clear.
        mov rdi, 1;                      // DW_TRACE_OP_READ
        mov rsi, 0x54;                   // IC_CLR_TX_ABRT
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;

        mov rdi, 0x34;                   // IC_RAW_INTR_STAT
        call dw_io_synth_peek;
        and rax, 0x40;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 0x80;                   // IC_TX_ABRT_SOURCE
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;

        // ... and the very next transfer works.
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // Data NACK: something is there and rejected a byte.
        mov rdi, 0x08;                   // DW_ABRT_TXDATA_NOACK
        call dw_io_synth_arm_nack;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF62;             // I2C_XFER_NACK_DATA
        cmp rax, r15;
        jne lpi_w_fail;

        // Arbitration lost: another master won.
        mov rdi, 0x1000;                 // DW_ABRT_ARB_LOST
        call dw_io_synth_arm_nack;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF61;             // I2C_XFER_ARB_LOST
        cmp rax, r15;
        jne lpi_w_fail;

        // A NACK during a READ is reported, not turned into a timeout.
        call lpi_w_rbuf_clear;
        mov rdi, 0x01;
        call dw_io_synth_arm_nack;
        call lpi_w_rbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_read;
        mov r15, 0xFFFFFF63;
        cmp rax, r15;
        jne lpi_w_fail;

        // The bus is still healthy after four aborts in a row.
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // N. EVERY WAIT IS BOUNDED, WITH ITS OWN CODE.
        // ================================================================
        mov rax, 14;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // The two enable waits, driven directly.
        mov rdi, 1;
        call dw_io_synth_set_stuck;

        mov rdi, 0x9C;                   // IC_ENABLE_STATUS pinned to 1
        mov rsi, 1;
        call dw_io_synth_poke;
        xor rdi, rdi;
        call dw_i2c_wait_enable;
        mov r15, 0xFFFFFF55;             // LPSS_I2C_INIT_DISABLE_TIMEOUT
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, 0x9C;
        xor rsi, rsi;
        call dw_io_synth_poke;
        mov rdi, 1;
        call dw_i2c_wait_enable;
        mov r15, 0xFFFFFF54;             // LPSS_I2C_INIT_ENABLE_TIMEOUT
        cmp rax, r15;
        jne lpi_w_fail;

        // A whole transfer against a stuck controller TERMINATES.
        mov rdi, 0x9C;
        mov rsi, 1;
        call dw_io_synth_poke;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 64;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF55;
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        call dw_io_synth_set_stuck;

        // TX FIFO: no room, ever.
        mov rdi, 0x70;                   // IC_STATUS
        xor rsi, rsi;                    // no TFNF
        call dw_io_synth_poke;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 8;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF66;             // I2C_XFER_TIMEOUT_TXFIFO
        cmp rax, r15;
        jne lpi_w_fail;

        // RX FIFO: a byte that never arrives.
        mov rdi, 0x70;
        mov rsi, 0x02;                   // TFNF only, no RFNE
        call dw_io_synth_poke;
        call lpi_w_rbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 8;
        call i2c_xfer_read;
        mov r15, 0xFFFFFF65;             // I2C_XFER_TIMEOUT_RXFIFO
        cmp rax, r15;
        jne lpi_w_fail;

        // STOP: the one that means the bus is probably still held.
        //
        // R30.M5-005 (#1074): the read above pushed its terminating
        // command before it gave up waiting for a byte, so a STOP is
        // still in flight on the model's clock. Cancelling it is what
        // makes this an assertion about a STOP THAT NEVER COMES rather
        // than a race between the budget and the previous sub-step's
        // leftovers -- which is a distinction the model only acquired
        // when STOP_DET stopped being instantaneous.
        mov rdi, 0x34;                   // IC_RAW_INTR_STAT
        xor rsi, rsi;
        call dw_io_synth_poke;
        xor rdi, rdi;
        call dw_io_synth_arm_stop;
        mov rdi, 8;
        call dw_xfer_wait_stop;
        mov r15, 0xFFFFFF64;             // I2C_XFER_TIMEOUT_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // O. BUS RECOVERY and the WEDGE LATCH.
        // ================================================================
        mov rax, 15;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;
        mov rdi, 0x34;
        xor rsi, rsi;
        call dw_io_synth_poke;

        // Tier 1 succeeds: IC_ENABLE.ABORT, the resulting TX_ABRT is
        // cleared, and the controller is cycled.
        xor rdi, rdi;
        call i2c_bus_recover;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_recover_fails;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne lpi_w_fail;

        // Now make the enable cycle fail. One failure is not a verdict.
        mov rdi, 1;
        call dw_io_synth_set_stuck;

        xor rdi, rdi;
        call i2c_bus_recover;
        mov r15, 0xFFFFFF4E;             // LPSS_I2C_RECOVER_FAILED
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_recover_fails;
        cmp rax, 1;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call i2c_bus_recover;
        mov r15, 0xFFFFFF4E;
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne lpi_w_fail;

        // The third consecutive failure LATCHES.
        xor rdi, rdi;
        call i2c_bus_recover;
        mov r15, 0xFFFFFF60;             // I2C_XFER_BUS_WEDGED
        cmp rax, r15;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 1;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_recover_fails;
        cmp rax, 3;
        jne lpi_w_fail;

        xor rdi, rdi;
        call dw_io_synth_set_stuck;

        // A latched bus FAILS FAST -- one table read, no register
        // access, no budget burned. Otherwise one stuck peripheral
        // becomes N stalled drivers.
        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF60;
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // The named exit. Its caller is R30.M6's pin-level recovery;
        // the state is waiting for an authority, not terminal.
        xor rdi, rdi;
        call lpss_i2c_unwedge;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne lpi_w_fail;

        // It is not a general counter reset: a controller that was
        // never latched is refused, so the three-strike budget cannot
        // be made unreachable by calling this in a loop.
        xor rdi, rdi;
        call lpss_i2c_unwedge;
        mov r15, 0xFFFFFF4D;             // LPSS_I2C_NOT_WEDGED
        cmp rax, r15;
        jne lpi_w_fail;

        // And the bus works again.
        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // P. SMBus.
        // ================================================================
        mov rax, 16;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        // Refused, by name, before any bus state is touched.
        call dw_io_trace_reset;
        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 50;
        xor rsi, rsi;                    // I2C_SMBUS_QUICK
        xor rdx, rdx;
        mov r8, 4096;
        call i2c_smbus_op;
        mov r15, 0xFFFFFF4C;             // LPSS_I2C_SMBUS_UNSUPPORTED
        cmp rax, r15;
        jne lpi_w_fail;

        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 50;
        mov rsi, 8;                      // I2C_SMBUS_BLOCK_READ
        xor rdx, rdx;
        mov r8, 4096;
        call i2c_smbus_op;
        mov r15, 0xFFFFFF4C;
        cmp rax, r15;
        jne lpi_w_fail;

        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;

        // BYTE_DATA_WRITE: {command, data} as one two-byte write.
        xor rdi, rdi;
        mov rsi, 0x34;
        call lpi_w_rbyte;                // (no-op read to keep rbuf live)
        call lpi_w_rbuf_ptr;
        mov r10, rax;
        mov rax, 0x34;
        mov_b [r10 + 0], rax;

        call dw_io_trace_reset;
        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 50;
        mov rsi, 3;                      // I2C_SMBUS_BYTE_DATA_WRITE
        mov rdx, 0x12;                   // command
        mov r8, 4096;
        call i2c_smbus_op;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 2;
        mov rsi, 0x10;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov r12, rax;
        mov rdi, r12;
        mov rsi, 2;
        call dw_io_trace_field;
        cmp rax, 0x12;                   // the command byte, no STOP
        jne lpi_w_fail;
        mov r15, r12;
        add r15, 1;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, r15;
        call dw_io_trace_find;
        mov rdi, rax;
        mov rsi, 2;
        call dw_io_trace_field;
        mov r15, 0x234;                  // 0x34 | DW_CMD_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        // A READ-ONLY capability is refused a register read, because
        // its command byte is a write that moves the device's pointer.
        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 51;
        mov rsi, 4;                      // I2C_SMBUS_BYTE_DATA_READ
        mov rdx, 0x12;
        mov r8, 4096;
        call i2c_smbus_op;
        mov r15, 0xFFFFFF6B;             // I2C_XFER_NO_WRITE_RIGHT
        cmp rax, r15;
        jne lpi_w_fail;

        // The full capability performs it, with a repeated START.
        call lpi_w_rbuf_clear;
        mov rdi, 0x99;
        call dw_io_synth_push_rx;
        call dw_io_trace_reset;
        call lpi_w_rbuf_ptr;
        mov rcx, rax;
        mov rdi, 50;
        mov rsi, 4;                      // BYTE_DATA_READ
        mov rdx, 0x12;
        mov r8, 4096;
        call i2c_smbus_op;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call lpi_w_rbyte;
        cmp rax, 0x99;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;                  // DW_CMD_RESTART
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;

        // ================================================================
        // Q. THE ADDRESS MUTANT.
        //
        // A neighbouring device's address (0x2B, slot 51's) loaded into
        // every register a smuggled parameter could arrive in. The
        // answer must still be this capability's own address, in every
        // resolver and on the wire.
        // ================================================================
        mov rax, 17;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 50;
        mov rsi, 0x2B;
        mov rdx, 0x2B;
        mov rcx, 0x2B;
        mov r8,  0x2B;
        mov r9,  0x2B;
        call i2c_slave_addr_of_slot;
        cmp rax, 0x1A;
        jne lpi_w_fail;

        mov rdi, 50;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 1;
        mov r8,  1;
        mov r9,  1;
        call i2c_slave_mode_of_slot;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 50;
        mov rsi, 7;
        mov rdx, 7;
        mov rcx, 7;
        mov r8,  7;
        mov r9,  7;
        call i2c_slave_bus_row_of_slot;
        lea r10, [rip + _lpss_w_bus_row];
        mov r10, [r10];
        cmp rax, r10;
        jne lpi_w_fail;

        // And end to end: the wire still carries 0x1A.
        mov rdi, 0x04;                   // scrub IC_TAR first
        xor rsi, rsi;
        call dw_io_synth_poke;

        xor rdi, rdi;
        mov rsi, 0xAB;
        call lpi_w_wbyte;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        mov r8,  0x2B;                   // smuggled
        mov r9,  0x2B;                   // smuggled
        call i2c_xfer_write;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 0x04;
        call dw_io_synth_peek;
        cmp rax, 0x1A;
        jne lpi_w_fail;

        // ================================================================
        // S. INTERRUPT-DRIVEN WRITE, end to end.
        //
        // The same capability, the same controller, the same abort
        // decode -- and a completely different delivery mechanism. What
        // is being established here is that the FSM engine reaches the
        // same wire with the same command flags as the polled one, so
        // the assertions are deliberately the SAME assertions sub-test
        // J makes: IC_TAR from the capability, exactly one STOP, no
        // RESTART, no READ, and the pushed word byte-for-byte.
        // ================================================================
        mov rax, 18;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call dw_irq_reset;
        mov rdi, 0x70;                   // IC_STATUS
        mov rsi, 0x02;                   // TFNF: room in the TX FIFO
        call dw_io_synth_poke;
        mov rdi, 0x34;                   // IC_RAW_INTR_STAT
        xor rsi, rsi;
        call dw_io_synth_poke;
        xor rdi, rdi;
        call dw_io_synth_arm_stop;

        xor rdi, rdi;
        mov rsi, 0xAB;
        call lpi_w_wbyte;

        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // The device addressed is the one the CAPABILITY names, on this
        // path too. There is no address parameter to supply.
        mov rdi, 0x04;                   // IC_TAR
        call dw_io_synth_peek;
        cmp rax, 0x1A;
        jne lpi_w_fail;

        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x200;                  // DW_CMD_STOP
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;                  // DW_CMD_RESTART
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x100;                  // DW_CMD_READ
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 2;
        mov rsi, 0x10;
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;
        mov rdi, rax;
        mov rsi, 2;
        call dw_io_trace_field;
        mov r15, 0x2AB;                  // 0xAB | DW_CMD_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        // The FSM recorded success and accounted for every byte. The
        // outcome fields survive the release -- "this row is free" and
        // "the last transfer on it ended DONE" are different facts, and
        // a caller asking how many bytes landed asks after the call has
        // returned.
        xor rdi, rdi;
        mov rsi, 9;                      // DW_IRQ_F_ERR
        call dw_irq_field;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call i2c_xfer_bytes_done;
        cmp rax, 1;
        jne lpi_w_fail;

        // The row is back to FREE, so the next transfer can have it. A
        // row left in a terminal state would refuse every subsequent
        // FREE -> SETUP transition and the controller would be usable
        // exactly once.
        xor rdi, rdi;
        call dw_irq_state;
        cmp rax, 0;                      // DW_IRQ_ST_FREE
        jne lpi_w_fail;

        // Two service events for a one-byte write: one to queue it and
        // mask TX_EMPTY, one to see the STOP. Sub-test U measures this
        // properly; here it is asserted exactly, because a one-byte
        // write has no room for interpretation.
        xor rdi, rdi;
        call dw_irq_isr_calls;
        cmp rax, 2;
        jne lpi_w_fail;

        // TX_EMPTY was masked at the LAST-QUEUED command, which for a
        // one-byte write is the first and only one. Asserting the
        // POSITION and not merely the final mask is what distinguishes
        // this from a driver that masked at the first byte of a long
        // transfer and went deaf to its own TX FIFO.
        xor rdi, rdi;
        call dw_irq_masked_at;
        cmp rax, 1;
        jne lpi_w_fail;

        // Exactly one write to IC_INTR_MASK carried TX_EMPTY: the arm.
        // Nothing re-armed it afterwards.
        mov rdi, 2;
        mov rsi, 0x30;                   // IC_INTR_MASK
        mov rdx, 0x10;                   // DW_INTR_TX_EMPTY
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;

        // The line is QUIET afterwards and the claim is back.
        mov rdi, 0x30;
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;
        call dw_io_synth_line;
        cmp rax, 0;
        jne lpi_w_fail;
        call dw_irq_owner;
        cmp rax, 0;
        jne lpi_w_fail;

        // And the transfer consumed its own STOP rather than leaving
        // one armed for whoever comes next.
        call dw_io_synth_stop_pending;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // T. INTERRUPT-DRIVEN READ, three bytes.
        // ================================================================
        mov rax, 19;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call lpi_w_rbuf_clear;
        mov rdi, 0x11;
        call dw_io_synth_push_rx;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 0x22;
        call dw_io_synth_push_rx;
        mov rdi, 0x33;
        call dw_io_synth_push_rx;

        call dw_io_trace_reset;
        call lpi_w_rbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 3;
        mov rcx, 4096;
        call i2c_xfer_irq_read;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpi_w_rbyte;
        cmp rax, 0x11;
        jne lpi_w_fail;
        mov rdi, 1;
        call lpi_w_rbyte;
        cmp rax, 0x22;
        jne lpi_w_fail;
        mov rdi, 2;
        call lpi_w_rbyte;
        cmp rax, 0x33;
        jne lpi_w_fail;

        // Exactly three consumed -- the rdone < rcmd guard means the
        // routine cannot pop a byte no command asked for.
        call dw_io_synth_rx_pending;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x100;                  // DW_CMD_READ
        call dw_io_trace_count_bit;
        cmp rax, 3;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x200;
        call dw_io_trace_count_bit;
        cmp rax, 1;
        jne lpi_w_fail;
        mov rdi, 2;
        mov rsi, 0x10;
        mov rdx, 0x400;
        call dw_io_trace_count_bit;
        cmp rax, 0;
        jne lpi_w_fail;

        // The mask dropped at the THIRD command, not the first.
        xor rdi, rdi;
        call dw_irq_masked_at;
        cmp rax, 3;
        jne lpi_w_fail;

        xor rdi, rdi;
        mov rsi, 9;                      // DW_IRQ_F_ERR
        call dw_irq_field;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_irq_state;
        cmp rax, 0;                      // DW_IRQ_ST_FREE
        jne lpi_w_fail;

        // ================================================================
        // U. THE TX_EMPTY STORM, MEASURED -- AND THE MEASUREMENT SHOWN
        //    TO HAVE TEETH.
        //
        // TX_EMPTY is a LEVEL against IC_TX_TL, which bring-up programs
        // to zero, so once the last byte has left the FIFO it is
        // asserted forever. A driver that leaves it unmasked completes
        // its transfer correctly and takes an interrupt on every EOI
        // until the STOP lands -- no wrong data, no error, just a CPU
        // that disappears into interrupt context. Nothing about the
        // final state of the machine records that it happened.
        //
        // So it is measured instead, by a pump that dispatches exactly
        // while the line is asserted. And because a ceiling nothing can
        // breach proves nothing, the SECOND half puts TX_EMPTY back into
        // the mask by hand -- exactly what a driver that forgot would
        // leave behind -- and asserts the same measurement blows past
        // the ceiling.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;

        xor rdi, rdi;
        mov rsi, 0xC0;
        call lpi_w_wbyte;
        mov rdi, 1;
        mov rsi, 0xC1;
        call lpi_w_wbyte;
        mov rdi, 2;
        mov rsi, 0xC2;
        call lpi_w_wbyte;
        mov rdi, 3;
        mov rsi, 0xC3;
        call lpi_w_wbyte;

        // ---- correct: two or three service events, whatever the length ----
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 4;
        xor rcx, rcx;
        xor r8, r8;
        call i2c_xfer_irq_begin;
        mov r15, 0xFFFFFF30;
        cmp rax, r15;
        jae lpi_w_fail;
        mov r12, rax;                    // ctrl

        mov rdi, r12;
        mov rsi, 128;
        call lpi_w_pump;
        cmp rax, 4;
        ja  lpi_w_fail;                  // the ceiling

        // BETWEEN submission and completion the terminal state is
        // visible, and this is the only place it is: the pump drove the
        // FSM to DONE and the claim has not yet been given back.
        mov rdi, r12;
        call dw_irq_state;
        cmp rax, 5;                      // DW_IRQ_ST_DONE
        jne lpi_w_fail;
        mov r15, r12;
        add r15, 1;
        call dw_irq_owner;
        mov r13, r15;
        cmp rax, r13;
        jne lpi_w_fail;

        mov rdi, r12;
        mov rsi, 4096;
        call i2c_xfer_irq_finish;
        cmp rax, 0;
        jne lpi_w_fail;

        mov rdi, r12;
        call dw_irq_masked_at;
        cmp rax, 4;
        jne lpi_w_fail;

        // ---- sabotaged: the same measurement, the mask put back ----
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 4;
        xor rcx, rcx;
        xor r8, r8;
        call i2c_xfer_irq_begin;
        mov r15, 0xFFFFFF30;
        cmp rax, r15;
        jae lpi_w_fail;
        mov r12, rax;

        mov rdi, r12;
        mov rsi, 1;                      // one event: everything queued
        call lpi_w_pump;

        mov rdi, 0x30;                   // IC_INTR_MASK
        mov rsi, 0x254;                  // TX_EMPTY back in, by hand
        call dw_io_synth_poke;

        mov rdi, r12;
        mov rsi, 128;
        call lpi_w_pump;
        cmp rax, 10;
        jb  lpi_w_fail;                  // the ceiling has teeth

        mov rdi, r12;
        mov rsi, 4096;
        call i2c_xfer_irq_finish;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // V. ADDRESS NACK AND DATA NACK ARE DIFFERENT FAILURES, AND THE
        //    BYTE COUNT AFTER A DATA NACK IS ACCURATE.
        //
        // Nobody answered is the ordinary outcome of a probe. A device
        // that answered and then gave up partway is a real failure, and
        // the caller needs to know how far the message got, because a
        // half-applied multi-byte register write leaves a part in a
        // state its driver does not believe it is in.
        //
        // The count is NOT the number of bytes pushed: the abort flushes
        // and holds the TX FIFO, and the NACKed byte reached the wire
        // without being acknowledged. Two bytes acknowledged out of a
        // four-byte write is a number only a correct computation gives.
        // ================================================================
        mov rax, 21;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;

        // ---- address NACK, interrupt path ----
        mov rdi, 0x01;                   // DW_ABRT_7B_ADDR_NOACK
        call dw_io_synth_arm_nack;
        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        mov r15, 0xFFFFFF63;             // I2C_XFER_NACK_ADDR
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        call dw_irq_nack_phase;
        cmp rax, 1;                      // DW_IRQ_NACK_ADDR
        jne lpi_w_fail;
        xor rdi, rdi;
        call i2c_xfer_bytes_done;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_irq_last_abort;
        cmp rax, 0x01;
        jne lpi_w_fail;

        // IC_CLR_TX_ABRT is read on the interrupt path too -- it is the
        // same dw_xfer_check_abort, which is the point.
        mov rdi, 1;                      // DW_TRACE_OP_READ
        mov rsi, 0x54;                   // IC_CLR_TX_ABRT
        xor rdx, rdx;
        call dw_io_trace_find;
        mov r15, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r15;
        je  lpi_w_fail;

        // ... and the very next transfer works, which is the half of
        // the property that says a NACK does not wedge the controller.
        xor rdi, rdi;
        mov rsi, 0xAB;
        call lpi_w_wbyte;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // ---- data NACK on the third byte of four ----
        xor rdi, rdi;
        mov rsi, 0xC0;
        call lpi_w_wbyte;
        mov rdi, 1;
        mov rsi, 0xC1;
        call lpi_w_wbyte;
        mov rdi, 2;
        mov rsi, 0xC2;
        call lpi_w_wbyte;
        mov rdi, 3;
        mov rsi, 0xC3;
        call lpi_w_wbyte;

        mov rdi, 2;                      // let two commands through
        mov rsi, 0x08;                   // DW_ABRT_TXDATA_NOACK
        call dw_io_synth_arm_nack_after;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 4;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        mov r15, 0xFFFFFF62;             // I2C_XFER_NACK_DATA
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        call dw_irq_nack_phase;
        cmp rax, 2;                      // DW_IRQ_NACK_DATA
        jne lpi_w_fail;
        xor rdi, rdi;
        call i2c_xfer_bytes_done;
        cmp rax, 2;                      // TWO acknowledged, not three
        jne lpi_w_fail;

        // ---- THE SAME NACK, THE SAME CODE, ON THE POLLED PATH ----
        //
        // This is the assertion that says the two engines cannot have
        // drifted: they do not agree because someone kept them in
        // agreement, they agree because there is one decode.
        mov rdi, 2;
        mov rsi, 0x08;
        call dw_io_synth_arm_nack_after;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 4;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF62;
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, 0x01;
        call dw_io_synth_arm_nack;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;
        mov r15, 0xFFFFFF63;
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, 0x01;
        call dw_io_synth_arm_nack;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        mov r15, 0xFFFFFF63;
        cmp rax, r15;
        jne lpi_w_fail;

        // ================================================================
        // W. STOP_DET COMPLETES THE FSM; ITS ABSENCE HITS THE EXISTING
        //    TIMEOUT RATHER THAN HANGING.
        //
        // No new timeout code is minted. The terminal states are reached
        // by STOP_DET or by an abort, so a transfer that reached neither
        // is one whose STOP never appeared -- which is what
        // I2C_XFER_TIMEOUT_STOP has meant since #1073, and which is the
        // one timeout that means the bus is probably still held.
        // ================================================================
        mov rax, 22;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;

        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        xor rcx, rcx;
        xor r8, r8;
        call i2c_xfer_irq_begin;
        mov r15, 0xFFFFFF30;
        cmp rax, r15;
        jae lpi_w_fail;
        mov r12, rax;

        mov rdi, r12;
        mov rsi, 1;
        call lpi_w_pump;                 // the command is on the wire

        // The STOP never reaches the wire.
        xor rdi, rdi;
        call dw_io_synth_arm_stop;

        mov rdi, r12;
        mov rsi, 64;                     // a small, deliberate budget
        call i2c_xfer_irq_finish;
        mov r15, 0xFFFFFF64;             // I2C_XFER_TIMEOUT_STOP
        cmp rax, r15;
        jne lpi_w_fail;

        mov rdi, r12;
        mov rsi, 9;                      // DW_IRQ_F_ERR
        call dw_irq_field;
        mov r15, 0xFFFFFF64;
        cmp rax, r15;
        jne lpi_w_fail;                  // the FSM recorded it, not the caller

        // A timed-out transfer gives the bus back. A claim held past a
        // failure would turn one stuck device into a controller nobody
        // can ever use; that is what the wedge latch is for, and it is
        // reached deliberately rather than by leaking a claim.
        call dw_irq_owner;
        cmp rax, 0;
        jne lpi_w_fail;
        mov rdi, 0x30;
        call dw_io_synth_peek;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // X. ONE CLAIM AND ONE WEDGE LATCH, SHARED BY BOTH ENGINES.
        // ================================================================
        mov rax, 23;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;
        mov rdi, 0x34;
        xor rsi, rsi;
        call dw_io_synth_poke;
        xor rdi, rdi;
        call dw_io_synth_arm_stop;

        // Hold the claim by hand. BOTH engines are refused, with the
        // same code -- which is what "a polled transfer and an
        // interrupt-driven transfer can never be in flight on one wire"
        // means operationally.
        xor rdi, rdi;
        call dw_irq_claim;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_irq_claim;
        mov r15, 0xFFFFFFE6;             // I2C_IRQ_BUSY
        cmp rax, r15;
        jne lpi_w_fail;

        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_write;             // polled
        mov r15, 0xFFFFFFE6;
        cmp rax, r15;
        jne lpi_w_fail;

        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;         // interrupt-driven
        mov r15, 0xFFFFFFE6;
        cmp rax, r15;
        jne lpi_w_fail;

        xor rdi, rdi;
        call dw_irq_release;
        cmp rax, 0;
        jne lpi_w_fail;

        // Releasing a claim nobody holds is refused rather than
        // silently freeing whoever holds it next.
        xor rdi, rdi;
        call dw_irq_release;
        mov r15, 0xFFFFFFE5;             // I2C_IRQ_NOT_OWNER
        cmp rax, r15;
        jne lpi_w_fail;

        // ---- the wedge latch is one latch ----
        mov rdi, 1;
        call dw_io_synth_set_stuck;
        xor rdi, rdi;
        call i2c_bus_recover;
        xor rdi, rdi;
        call i2c_bus_recover;
        xor rdi, rdi;
        call i2c_bus_recover;
        xor rdi, rdi;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 1;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_io_synth_set_stuck;

        // A latched bus fails FAST on the interrupt path too: one table
        // read, no register access, and THE CLAIM IS NEVER TAKEN -- so
        // a wedged controller does not also become an unclaimable one.
        call dw_io_trace_reset;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        mov r15, 0xFFFFFF60;             // I2C_XFER_BUS_WEDGED
        cmp rax, r15;
        jne lpi_w_fail;
        call dw_io_trace_count;
        cmp rax, 0;
        jne lpi_w_fail;
        call dw_irq_owner;
        cmp rax, 0;
        jne lpi_w_fail;

        xor rdi, rdi;
        call lpss_i2c_unwedge;
        cmp rax, 0;
        jne lpi_w_fail;

        // And an interrupt-driven transfer works again afterwards.
        mov rdi, 0x70;
        mov rsi, 0x02;
        call dw_io_synth_poke;
        mov rdi, 0x34;
        xor rsi, rsi;
        call dw_io_synth_poke;
        xor rdi, rdi;
        call dw_io_synth_arm_stop;
        call lpi_w_wbuf_ptr;
        mov rsi, rax;
        mov rdi, 50;
        mov rdx, 1;
        mov rcx, 4096;
        call i2c_xfer_irq_write;
        cmp rax, 0;
        jne lpi_w_fail;

        // ================================================================
        // R. Teardown.
        // ================================================================
        mov rax, 24;
        lea rcx, [rip + _lpss_w_stage];
        mov [rcx], rax;

        call dw_irq_reset;
        call dw_io_unbind;
        call dw_io_synth_disable;
        call lpss_i2c_table_reset;
        call lpi_w_clear_slots;
        call i2c_bus_table_reset;
        call i2c_slave_table_reset;

        call dw_io_mode;
        cmp rax, 0;                      // DW_IO_MODE_MMIO
        jne lpi_w_fail;
        call lpss_i2c_ctrl_count;
        cmp rax, 0;
        jne lpi_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 0;
        jne lpi_w_fail;
        call i2c_bus_rows_live;
        cmp rax, 0;
        jne lpi_w_fail;
        call dw_irq_owner;
        cmp rax, 0;
        jne lpi_w_fail;
        xor rdi, rdi;
        call dw_irq_state;
        cmp rax, 0;                      // DW_IRQ_ST_FREE
        jne lpi_w_fail;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpss_i2c_ok_msg];
        call klog_s1;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpss_i2c_irq_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpi_w_fail:
        call dw_irq_reset;
        call dw_io_unbind;
        call dw_io_synth_disable;
        call lpss_i2c_table_reset;
        call lpi_w_clear_slots;
        call i2c_bus_table_reset;
        call i2c_slave_table_reset;

        lea rax, [rip + _lpss_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpss_i2c_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_i2c_wit_kind(slot) -> cap_table[slot].kind
  // ==========================================================================

  pub let lpss_i2c_wit_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-003 (#1072): read the kind field of a capability slot, the single accessor through which every 'a descriptor of the right kind was (or was not) written' assertion in this fixture reads. Stride 24. Returns 0 for an out-of-range slot, which is also the value of a cleared slot -- correct, because both mean 'nothing is there'. Leaf. Labels prefixed lpi_wk_.",
      block: {
        cmp rdi, 256;
        jae lpi_wk_zero;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      lpi_wk_zero:
        xor rax, rax;
        ret
      }
    } @no_frame
}
