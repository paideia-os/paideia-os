// tests/kernel/drivers/audio/route_table_synth.pdx -- R33.M5-003 (#1159)
//
// Boot witness for the audio routing fabric:
//   (a) q15_add_sat saturating arithmetic.
//   (b) route_table_effective_gain (mute + gain composition).
//
// Two fingerprints:
//   R33 AUDIO ROUTE OK      — the effective gain composition
//   R33 Q15 SAT OK          — the saturating adder
//
// No cap slots: (a) is pure arithmetic; (b) uses the route table set
// up by the AudioRouteSynth fixture.
//
// PLACEMENT AFTER audio_route_witness IS REQUIRED. This witness reads
// through route_table_gain_of_slot which delegates to the KIND_AUDIO_ROUTE
// row accessor, and audio_route_witness scrubs its slot set on exit —
// so we mint our own transient state here and scrub on the same axis.

module RouteTableSynth = structure {

  pub let mut _rt_w_stage : u64 = 0

  pub let rt_w_q15_ok    : [u8; 12] = "Q15 SAT OK\0\0"
  pub let rt_w_q15_fail  : [u8; 13] = "Q15 SAT FAIL\0"
  pub let rt_w_ar_ok     : [u8; 15] = "AUDIO ROUTE OK\0"
  pub let rt_w_ar_fail   : [u8; 17] = "AUDIO ROUTE FAIL\0"

  pub let rt_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): clear cap_table slots 168..175. Labels prefixed rt_wc_.",
      block: {
        push rbx;
        mov rbx, 168;
      rt_wc_lp:
        cmp rbx, 176;
        jae rt_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp rt_wc_lp;
      rt_wc_done:
        pop rbx;
        ret
      }
    }

  pub let rt_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-003 (#1159): reset the route + stream + clock tables.",
      block: {
        push rbx;
        call audio_route_table_reset;
        call pcm_stream_table_reset;
        call audio_clock_table_reset;
        pop rbx;
        ret
      }
    }

  pub let rt_w_hw : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): synthetic KIND_HW.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 14;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let rt_w_ep : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let route_table_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R33.M5-003 (#1159): witness for q15_add_sat saturating arithmetic AND route_table_effective_gain composition. Both stages scrub on exit. Labels prefixed rt_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;

        // ============================================================
        // STAGE A -- q15_add_sat.
        // ============================================================

        // S1: 0 + 0 = 0.
        xor rdi, rdi;
        xor rsi, rsi;
        call q15_add_sat;
        cmp rax, 0;
        jne rt_w_fail_q15;

        // S2: +100 + +200 = +300.
        mov rax, 2;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 200;
        call q15_add_sat;
        cmp rax, 300;
        jne rt_w_fail_q15;

        // S3: +30000 + +10000 -> clip to +32767.
        mov rax, 3;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 30000;
        mov rsi, 10000;
        call q15_add_sat;
        cmp rax, 0x7FFF;
        jne rt_w_fail_q15;

        // S4: +32767 + +32767 -> clip to +32767.
        mov rax, 4;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 0x7FFF;
        mov rsi, 0x7FFF;
        call q15_add_sat;
        cmp rax, 0x7FFF;
        jne rt_w_fail_q15;

        // S5: -32000 + -10000 -> clip to -32768.
        mov rax, 5;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 0xFFFFFFFFFFFF8300;     // -32000
        mov rsi, 0xFFFFFFFFFFFFD8F0;     // -10000
        call q15_add_sat;
        mov r11, 0xFFFFFFFFFFFF8000;
        cmp rax, r11;
        jne rt_w_fail_q15;

        // S6: -32768 + -32768 -> clip to -32768.
        mov rax, 6;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 0xFFFFFFFFFFFF8000;
        mov rsi, 0xFFFFFFFFFFFF8000;
        call q15_add_sat;
        mov r11, 0xFFFFFFFFFFFF8000;
        cmp rax, r11;
        jne rt_w_fail_q15;

        // S7: +10000 + -10000 = 0 (no clip).
        mov rax, 7;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 10000;
        mov rsi, 0xFFFFFFFFFFFFD8F0;     // -10000
        call q15_add_sat;
        cmp rax, 0;
        jne rt_w_fail_q15;

        // S8: +32767 + -32768 = -1.
        mov rax, 8;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;
        mov rdi, 0x7FFF;
        mov rsi, 0xFFFFFFFFFFFF8000;
        call q15_add_sat;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne rt_w_fail_q15;

        // Q15 OK.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rt_w_q15_ok];
        call klog_s1;

        // ============================================================
        // STAGE B -- route_table_effective_gain.
        // ============================================================

        mov rax, 20;
        lea rcx, [rip + _rt_w_stage];
        mov [rcx], rax;

        call rt_w_clear;
        call rt_w_scrub;

        // Setup: pcm streams at 168, 169 via ep at 170 and clock at 171/hw 172.
        mov rdi, 172;
        mov rsi, 0xC401;
        mov rdx, 0x200;
        call rt_w_hw;

        mov rdi, 171;
        mov rsi, 172;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne rt_w_fail_ar;

        mov rdi, 170;
        mov rsi, 0x0401;
        mov rdx, 0x200;
        call rt_w_ep;

        mov rdi, 1;
        mov rsi, 48000;
        mov rdx, 2;
        call pcm_stream_frc_pack;
        mov r15, rax;

        mov rdi, 168;
        mov rsi, 170;
        mov rdx, 0x41B;
        mov rcx, 171;
        mov r8, 0xB301;
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne rt_w_fail_ar;

        mov rdi, 169;
        mov rsi, 170;
        mov rdx, 0x41B;
        mov rcx, 171;
        mov r8, 0xB302;
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne rt_w_fail_ar;

        // routing endpoint at 173, subject route at 174.
        mov rdi, 173;
        mov rsi, 0x0402;
        mov rdx, 0x200;
        call rt_w_ep;

        // Mint route src=168, dst=169, mute=0, gain=+2000.
        mov rdi, 168;
        mov rsi, 169;
        xor rdx, rdx;
        mov rcx, 2000;
        call audio_route_body_pack;
        mov r14, rax;

        mov rdi, 174;
        mov rsi, 173;
        mov rdx, 0x41B;
        mov rcx, 168;
        mov r8, 169;
        mov r9, r14;
        call audio_route_cap_mint_inner;
        cmp rax, 0;
        jne rt_w_fail_ar;

        // effective_gain: not muted -> 2000.
        mov rdi, 174;
        call route_table_effective_gain;
        cmp rax, 2000;
        jne rt_w_fail_ar;

        // Mute the route.
        mov rdi, 174;
        mov rsi, 1;
        call audio_route_set_mute;
        cmp rax, 0;
        jne rt_w_fail_ar;

        // effective_gain: muted -> 0.
        mov rdi, 174;
        call route_table_effective_gain;
        cmp rax, 0;
        jne rt_w_fail_ar;

        // Unmute + change gain.
        mov rdi, 174;
        xor rsi, rsi;
        call audio_route_set_mute;
        cmp rax, 0;
        jne rt_w_fail_ar;

        mov rdi, 174;
        mov rsi, 5000;
        call audio_route_set_gain;
        cmp rax, 0;
        jne rt_w_fail_ar;

        mov rdi, 174;
        call route_table_effective_gain;
        cmp rax, 5000;
        jne rt_w_fail_ar;

        // AUDIO ROUTE OK.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rt_w_ar_ok];
        call klog_s1;

        call rt_w_scrub;
        call rt_w_clear;
        xor rax, rax;
        jmp rt_w_out;

      rt_w_fail_q15:
        lea rax, [rip + _rt_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rt_w_q15_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;
        jmp rt_w_out;

      rt_w_fail_ar:
        lea rax, [rip + _rt_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rt_w_ar_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rt_w_scrub;
        call rt_w_clear;
        mov rax, 1;

      rt_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
