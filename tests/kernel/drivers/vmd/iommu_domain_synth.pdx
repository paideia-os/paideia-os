// tests/kernel/drivers/vmd/iommu_domain_synth.pdx — R47.M4-001 (#1421)
//
// Fingerprint: VMD IOMMU DOMAIN OK

module IommuDomainSynth = structure {

  pub let mut _vidw_stage : u64 = 0

  pub let vidw_ok   : [u8; 21] = "VMD IOMMU DOMAIN OK\0"
  pub let vidw_fail : [u8; 23] = "VMD IOMMU DOMAIN FAIL\0"

  pub let vmd_iommu_domain_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M4-001 (#1421): boot witness.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;

        call vmd_iommu_domain_reset;

        // -- 2. Assign endpoint 0 -> domain 100.
        mov rax, 2;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 100;
        call vmd_iommu_assign;
        cmp rax, 0;
        jne vidw_fail_stage;

        // -- 3. Lookup endpoint 0.
        mov rax, 3;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vmd_iommu_lookup;
        cmp rax, 100;
        jne vidw_fail_stage;

        // -- 4. Double-assign endpoint 0 => ALREADY_ASSIGNED.
        mov rax, 4;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 101;
        call vmd_iommu_assign;
        mov r11, 0xFFFFFDD1;
        cmp rax, r11;
        jne vidw_fail_stage;

        // -- 5. Endpoint 1 assigns domain 101 fine.
        mov rax, 5;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 101;
        call vmd_iommu_assign;
        cmp rax, 0;
        jne vidw_fail_stage;

        // -- 6. Lookup missing endpoint => NOT_ASSIGNED.
        mov rax, 6;
        lea rcx, [rip + _vidw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call vmd_iommu_lookup;
        mov r11, 0xFFFFFDD0;
        cmp rax, r11;
        jne vidw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vidw_ok];
        call klog_s1;
        call vmd_iommu_domain_reset;
        xor rax, rax;
        jmp vidw_out;

      vidw_fail_stage:
        lea rax, [rip + _vidw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vidw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_iommu_domain_reset;
        mov rax, 1;

      vidw_out:
        pop rbx;
        ret
      }
    }
}
