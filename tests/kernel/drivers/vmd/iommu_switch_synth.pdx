// tests/kernel/drivers/vmd/iommu_switch_synth.pdx — R47.M4-002 (#1422)
//
// Fingerprint: VMD IOMMU SWITCH OK

module IommuSwitchSynth = structure {

  pub let mut _visw_stage : u64 = 0

  pub let visw_ok   : [u8; 21] = "VMD IOMMU SWITCH OK\0"
  pub let visw_fail : [u8; 23] = "VMD IOMMU SWITCH FAIL\0"

  pub let vmd_iommu_switch_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M4-002 (#1422): boot witness.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;

        call vmd_iommu_switch_reset;

        // -- 2. Install: endpoint 0, from 0, to 100.
        mov rax, 2;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 100;
        call vmd_iommu_switch_do;
        cmp rax, 0;
        jne visw_fail_stage;

        // -- 3. Active == 100.
        mov rax, 3;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vmd_iommu_switch_active;
        cmp rax, 100;
        jne visw_fail_stage;

        // -- 4. Switch 100 -> 200 (valid).
        mov rax, 4;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 200;
        call vmd_iommu_switch_do;
        cmp rax, 0;
        jne visw_fail_stage;

        // -- 5. Switch 100 -> 300 (STALE, active is now 200).
        mov rax, 5;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 300;
        call vmd_iommu_switch_do;
        mov r11, 0xFFFFFDD7;
        cmp rax, r11;
        jne visw_fail_stage;

        // -- 6. NOT_TRACKED on missing endpoint.
        mov rax, 6;
        lea rcx, [rip + _visw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call vmd_iommu_switch_active;
        mov r11, 0xFFFFFDD5;
        cmp rax, r11;
        jne visw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + visw_ok];
        call klog_s1;
        call vmd_iommu_switch_reset;
        xor rax, rax;
        jmp visw_out;

      visw_fail_stage:
        lea rax, [rip + _visw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + visw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_iommu_switch_reset;
        mov rax, 1;

      visw_out:
        pop rbx;
        ret
      }
    }
}
