// tests/kernel/drivers/vmd/msix_remap_synth.pdx — R47.M2-002 (#1416)
//
// Fingerprint: R47 VMD MSIX REMAP OK

module VmdMsixRemapSynth = structure {

  pub let mut _vmxw_stage : u64 = 0

  pub let vmxw_ok   : [u8; 23] = "R47 VMD MSIX REMAP OK\n\0"
  pub let vmxw_fail : [u8; 25] = "R47 VMD MSIX REMAP FAIL\n\0"

  pub let vmd_msix_remap_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M2-002 (#1416): boot witness.",
      block: {
        push rbx;
        push r12;

        mov rax, 1;
        lea rcx, [rip + _vmxw_stage];
        mov [rcx], rax;

        call vmd_msix_remap_reset;

        // -- 2. Happy install: endpoint_row=0, child_vec=3, host_vec=64, cpu=0.
        mov rax, 2;
        lea rcx, [rip + _vmxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;
        mov rdx, 64;
        mov rcx, 0;
        call vmd_msix_install;
        cmp rax, 0;                      // first row
        jne vmxw_fail_stage;

        // -- 3. Lookup returns row 0.
        mov rax, 3;
        lea rcx, [rip + _vmxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;
        call vmd_msix_lookup;
        cmp rax, 0;
        jne vmxw_fail_stage;

        // -- 4. NOT_MAPPED on unknown vec.
        mov rax, 4;
        lea rcx, [rip + _vmxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 99;
        call vmd_msix_lookup;
        mov r11, 0xFFFFFD38;
        cmp rax, r11;
        jne vmxw_fail_stage;

        // -- 5. INSTALLS stat == 1.
        mov rax, 5;
        lea rcx, [rip + _vmxw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vmd_msix_remap_stat;
        cmp rax, 1;
        jne vmxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vmxw_ok];
        call klog_s1;
        call vmd_msix_remap_reset;
        xor rax, rax;
        jmp vmxw_out;

      vmxw_fail_stage:
        lea rax, [rip + _vmxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vmxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_msix_remap_reset;
        mov rax, 1;

      vmxw_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
