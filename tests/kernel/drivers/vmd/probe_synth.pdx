// tests/kernel/drivers/vmd/probe_synth.pdx — R47.M1-001 (#1412)
//
// Boot witness for the VMD PCI probe scaffold.  Asserts class-triple
// discrimination, vendor filter, BAR alignment, cap0 members/cfgoff
// decode, and end-to-end recognise round-trip.
//
// Fingerprint: R47 VMD PROBE OK

module VmdProbeSynth = structure {

  pub let mut _vpw_stage : u64 = 0

  pub let vpw_ok   : [u8; 18] = "R47 VMD PROBE OK\n\0"
  pub let vpw_fail : [u8; 20] = "R47 VMD PROBE FAIL\n\0"

  pub let vmd_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M1-001 (#1412): boot witness. Stages: (1) reset. (2) class valid. (3) vendor valid. (4) alignment. (5) cap0 decode. (6) happy path. (7) BAD_CLASS. (8) MISALIGNED. (9) NO_MEMBERS.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        call vmd_probe_reset;

        // -- 2. Class valid.
        mov rax, 2;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x010400;
        call vmd_probe_class_valid;
        cmp rax, 1;
        jne vpw_fail_stage;
        mov rdi, 0x010500;
        call vmd_probe_class_valid;
        cmp rax, 0;
        jne vpw_fail_stage;

        // -- 3. Vendor.
        mov rax, 3;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        call vmd_probe_vendor_valid;
        cmp rax, 1;
        jne vpw_fail_stage;
        mov rdi, 0x1022;
        call vmd_probe_vendor_valid;
        cmp rax, 0;
        jne vpw_fail_stage;

        // -- 4. Alignment.
        mov rax, 4;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        call vmd_probe_bar_aligned;
        cmp rax, 1;
        jne vpw_fail_stage;
        mov rdi, 0xF0000800;
        call vmd_probe_bar_aligned;
        cmp rax, 0;
        jne vpw_fail_stage;

        // -- 5. cap0 decode: members=8, cfgoff=0x100.
        mov rax, 5;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x00010008;             // cfgoff=0x100, members=8
        call vmd_probe_decode_members;
        cmp rax, 8;
        jne vpw_fail_stage;
        mov rdi, 0x00010008;
        call vmd_probe_decode_cfgoff;
        cmp rax, 0x100;
        jne vpw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x010400;
        mov rsi, 0x8086;
        mov rdx, 0xF0000000;
        mov rcx, 0x200000;               // 2 MiB
        mov r8, 0x00010008;
        call vmd_probe_recognise;
        // Expected: members=8, cfgoff=0x100 packed as 0x10008.
        mov r11, 0x10008;
        cmp rax, r11;
        jne vpw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call vmd_probe_stat;
        cmp rax, 1;
        jne vpw_fail_stage;

        // -- 7. BAD_CLASS.
        mov rax, 7;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x010500;
        mov rsi, 0x8086;
        mov rdx, 0xF0000000;
        mov rcx, 0x200000;
        mov r8, 0x00010008;
        call vmd_probe_recognise;
        mov r11, 0xFFFFFBDE;
        cmp rax, r11;
        jne vpw_fail_stage;

        // -- 8. MISALIGNED.
        mov rax, 8;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x010400;
        mov rsi, 0x8086;
        mov rdx, 0xF0000800;             // misaligned
        mov rcx, 0x200000;
        mov r8, 0x00010008;
        call vmd_probe_recognise;
        mov r11, 0xFFFFFBDB;
        cmp rax, r11;
        jne vpw_fail_stage;

        // -- 9. NO_MEMBERS.
        mov rax, 9;
        lea rcx, [rip + _vpw_stage];
        mov [rcx], rax;

        mov rdi, 0x010400;
        mov rsi, 0x8086;
        mov rdx, 0xF0000000;
        mov rcx, 0x200000;
        mov r8, 0x00010000;              // cfgoff=0x100, members=0
        call vmd_probe_recognise;
        mov r11, 0xFFFFFBD9;
        cmp rax, r11;
        jne vpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vpw_ok];
        call klog_s1;

        call vmd_probe_reset;
        xor rax, rax;
        jmp vpw_out;

      vpw_fail_stage:
        lea rax, [rip + _vpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_probe_reset;
        mov rax, 1;

      vpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
