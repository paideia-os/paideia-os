// tests/kernel/drivers/vmd/bios_off_fallback_synth.pdx — R47.M5-001 (#1424)
//
// Regression witness: the BIOS-off code path still passes.
//
// Fingerprint: R47 VMD BIOS OFF OK

module VmdBiosOffFallbackSynth = structure {

  pub let mut _vfbw_stage : u64 = 0

  pub let vfbw_ok   : [u8; 21] = "R47 VMD BIOS OFF OK\n\0"
  pub let vfbw_fail : [u8; 23] = "R47 VMD BIOS OFF FAIL\n\0"

  pub let vmd_bios_off_fallback_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M5-001 (#1424): regression -- (vmd_present=0, direct_nvme_count=1) still returns OK. Also asserts BOTH_PATHS refusal.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _vfbw_stage];
        mov [rcx], rax;

        call vmd_bios_off_fallback_reset;

        // -- 2. BIOS-off, one NVMe = legal.
        mov rax, 2;
        lea rcx, [rip + _vfbw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        call vmd_bios_off_fallback_check;
        cmp rax, 0;
        jne vfbw_fail_stage;

        // -- 3. BIOS-on, zero direct = legal.
        mov rax, 3;
        lea rcx, [rip + _vfbw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0;
        call vmd_bios_off_fallback_check;
        cmp rax, 0;
        jne vfbw_fail_stage;

        // -- 4. BOTH_PATHS refused.
        mov rax, 4;
        lea rcx, [rip + _vfbw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call vmd_bios_off_fallback_check;
        mov r11, 0xFFFFFDDF;
        cmp rax, r11;
        jne vfbw_fail_stage;

        // -- 5. BAD_ARG on vmd_present=2.
        mov rax, 5;
        lea rcx, [rip + _vfbw_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 0;
        call vmd_bios_off_fallback_check;
        mov r11, 0xFFFFFDDE;
        cmp rax, r11;
        jne vfbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vfbw_ok];
        call klog_s1;
        call vmd_bios_off_fallback_reset;
        xor rax, rax;
        jmp vfbw_out;

      vfbw_fail_stage:
        lea rax, [rip + _vfbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vfbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_bios_off_fallback_reset;
        mov rax, 1;

      vfbw_out:
        pop rbx;
        ret
      }
    }
}
