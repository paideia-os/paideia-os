// tests/kernel/drivers/vmd/root_complex_synth.pdx — R47.M2-001 (#1415)
//
// Fingerprint: VMD ROOT COMPLEX OK

module RootComplexSynth = structure {

  pub let mut _vrcw_stage : u64 = 0

  pub let vrcw_ok   : [u8; 21] = "VMD ROOT COMPLEX OK\n\0"
  pub let vrcw_fail : [u8; 23] = "VMD ROOT COMPLEX FAIL\n\0"

  pub let vmd_root_complex_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M2-001 (#1415): boot witness.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;

        call vmd_root_complex_reset;

        // -- 2. Happy path: vbdf 0x0100 (bus=1), cfg_off 0, cfgoff_base=0x100, bar_len=0x200000.
        // apoff = 0x100 + (1 << 20) + 0 = 0x100100.
        mov rax, 2;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;
        mov rsi, 0;
        mov rdx, 0x100;
        mov rcx, 0x200000;
        call vmd_root_complex_offset;
        mov r11, 0x100100;
        cmp rax, r11;
        jne vrcw_fail_stage;

        // -- 3. BAD_OFFSET.
        mov rax, 3;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;
        mov rsi, 4096;
        mov rdx, 0x100;
        mov rcx, 0x200000;
        call vmd_root_complex_offset;
        mov r11, 0xFFFFFD1D;
        cmp rax, r11;
        jne vrcw_fail_stage;

        // -- 4. BAD_ALIGN.
        mov rax, 4;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;

        mov rdi, 0x0100;
        mov rsi, 3;
        mov rdx, 0x100;
        mov rcx, 0x200000;
        call vmd_root_complex_offset;
        mov r11, 0xFFFFFD1B;
        cmp rax, r11;
        jne vrcw_fail_stage;

        // -- 5. OUT_OF_RANGE.
        mov rax, 5;
        lea rcx, [rip + _vrcw_stage];
        mov [rcx], rax;

        mov rdi, 0xFF00;                 // bus=255
        mov rsi, 0;
        mov rdx, 0x100;
        mov rcx, 0x200000;               // 2 MiB
        call vmd_root_complex_offset;
        mov r11, 0xFFFFFD1C;
        cmp rax, r11;
        jne vrcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcw_ok];
        call klog_s1;
        call vmd_root_complex_reset;
        xor rax, rax;
        jmp vrcw_out;

      vrcw_fail_stage:
        lea rax, [rip + _vrcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_root_complex_reset;
        mov rax, 1;

      vrcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
