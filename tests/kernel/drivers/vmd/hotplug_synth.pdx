// tests/kernel/drivers/vmd/hotplug_synth.pdx — R47.M2-003 (#1417)
//
// Fingerprint: VMD HOTPLUG OK
//
// Depends on KIND_VMD_ENDPOINT being mintable; uses synth slots 244..247.

module HotplugSynth = structure {

  pub let mut _vhpw_stage : u64 = 0

  pub let vhpw_ok   : [u8; 16] = "VMD HOTPLUG OK\n\0"
  pub let vhpw_fail : [u8; 18] = "VMD HOTPLUG FAIL\n\0"

  pub let vhpw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M2-003 (#1417): scrub slots 244..247.",
      block: {
        push rbx;
        mov rbx, 244;
      vhpw_c:
        cmp rbx, 248;
        jae vhpw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp vhpw_c;
      vhpw_c_done:
        pop rbx;
        ret
      }
    }

  pub let vhpw_device : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M2-003 (#1417): mint synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rdx, r13;
        xor rcx, rcx;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let vmd_hotplug_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R47.M2-003 (#1417): boot witness. Detach then re-attach an endpoint row.",
      block: {
        push rbx;
        push r12;

        mov rax, 1;
        lea rcx, [rip + _vhpw_stage];
        mov [rcx], rax;

        call vmd_endpoint_table_reset;
        call vmd_hotplug_reset;
        call vhpw_clear;

        // Parent + vmd_slot devices.
        mov rdi, 244;
        mov rsi, 0x619;
        call vhpw_device;
        mov rdi, 245;
        mov rsi, 0x619;
        call vhpw_device;

        // Mint an endpoint at slot 246 with vmd_slot=245.
        mov rdi, 246;
        mov rsi, 244;
        mov rdx, 0x419;
        mov rcx, 0xC0DE01;
        mov r8, 245;
        mov r9, 0x0200;
        shl r9, 16;
        or  r8, r9;
        mov r9, 0x010802;
        shl r9, 32;
        or  r8, r9;
        call vmd_endpoint_cap_mint_inner;
        cmp rax, 0;
        jne vhpw_fail_stage;

        mov rdi, 246;
        call kve_row_of_slot;
        cmp rax, 0xFF;
        je  vhpw_fail_stage;
        mov rbx, rax;                    // row_id

        // -- 2. DETACH.
        mov rax, 2;
        lea rcx, [rip + _vhpw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 2;                      // DETACH event
        call vmd_hotplug_sequence;
        cmp rax, 0;
        jne vhpw_fail_stage;

        mov rdi, rbx;
        call kve_row_state;
        cmp rax, 3;                      // DETACHED
        jne vhpw_fail_stage;

        // -- 3. ATTACH (re-plug).
        mov rax, 3;
        lea rcx, [rip + _vhpw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 1;                      // ATTACH event
        call vmd_hotplug_sequence;
        cmp rax, 0;
        jne vhpw_fail_stage;

        mov rdi, rbx;
        call kve_row_state;
        cmp rax, 0;                      // ATTACHED
        jne vhpw_fail_stage;

        // -- 4. BAD_EVENT.
        mov rax, 4;
        lea rcx, [rip + _vhpw_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, 99;
        call vmd_hotplug_sequence;
        mov r11, 0xFFFFFD76;
        cmp rax, r11;
        jne vhpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vhpw_ok];
        call klog_s1;
        call vmd_hotplug_reset;
        call vmd_endpoint_table_reset;
        call vhpw_clear;
        xor rax, rax;
        jmp vhpw_out;

      vhpw_fail_stage:
        lea rax, [rip + _vhpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vhpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_hotplug_reset;
        call vmd_endpoint_table_reset;
        call vhpw_clear;
        mov rax, 1;

      vhpw_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
