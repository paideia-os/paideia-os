// tests/kernel/drivers/vmd/nvme_bridge_synth.pdx — R47.M3-001 (#1418)
//
// Fingerprint: R47 VMD NVME BRIDGE OK

module NvmeBridgeSynth = structure {

  pub let mut _vnbw_stage : u64 = 0

  pub let vnbw_ok   : [u8; 24] = "R47 VMD NVME BRIDGE OK\n\0"
  pub let vnbw_fail : [u8; 26] = "R47 VMD NVME BRIDGE FAIL\n\0"

  pub let vmd_nvme_bridge_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M3-001 (#1418): boot witness.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _vnbw_stage];
        mov [rcx], rax;

        call vmd_nvme_bridge_reset;

        // -- 2. Class predicate.
        mov rax, 2;
        lea rcx, [rip + _vnbw_stage];
        mov [rcx], rax;
        mov rdi, 0x010802;
        call vmd_nvme_class_valid;
        cmp rax, 1;
        jne vnbw_fail_stage;
        mov rdi, 0x010800;
        call vmd_nvme_class_valid;
        cmp rax, 0;
        jne vnbw_fail_stage;

        // -- 3. Bind endpoint_row=0.
        mov rax, 3;
        lea rcx, [rip + _vnbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x010802;
        mov rdx, 100;                    // opregion_slot
        mov rcx, 0xC0DECAFE;             // ctrl_handle
        call vmd_nvme_bind;
        cmp rax, 0;
        jne vnbw_fail_stage;

        // -- 4. Binding count == 1.
        mov rax, 4;
        lea rcx, [rip + _vnbw_stage];
        mov [rcx], rax;
        call vmd_nvme_binding_count;
        cmp rax, 1;
        jne vnbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vnbw_ok];
        call klog_s1;
        call vmd_nvme_bridge_reset;
        xor rax, rax;
        jmp vnbw_out;

      vnbw_fail_stage:
        lea rax, [rip + _vnbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vnbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_nvme_bridge_reset;
        mov rax, 1;

      vnbw_out:
        pop rbx;
        ret
      }
    }
}
