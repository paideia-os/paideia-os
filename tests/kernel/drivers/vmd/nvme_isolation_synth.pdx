// tests/kernel/drivers/vmd/nvme_isolation_synth.pdx — R47.M3-002 (#1419)
//
// Fingerprint: VMD NVME ISOLATION OK

module NvmeIsolationSynth = structure {

  pub let mut _vniw_stage : u64 = 0

  pub let vniw_ok   : [u8; 23] = "VMD NVME ISOLATION OK\n\0"
  pub let vniw_fail : [u8; 25] = "VMD NVME ISOLATION FAIL\n\0"

  pub let vmd_nvme_isolation_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M3-002 (#1419): boot witness. Endpoint A claims qp 1; Endpoint B is refused OWNED_BY_OTHER on the same qp; Endpoint A claiming qp 1 again is idempotent.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _vniw_stage];
        mov [rcx], rax;

        call vmd_nvme_isolation_reset;

        // -- 2. Endpoint 0 claims qp 1.
        mov rax, 2;
        lea rcx, [rip + _vniw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        call vmd_iso_qp_claim;
        cmp rax, 0;
        jne vniw_fail_stage;

        // -- 3. Endpoint 1 attempts qp 1: OWNED_BY_OTHER.
        mov rax, 3;
        lea rcx, [rip + _vniw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call vmd_iso_qp_claim;
        mov r11, 0xFFFFFD9B;
        cmp rax, r11;
        jne vniw_fail_stage;

        // -- 4. Endpoint 0 re-claims qp 1: idempotent 0.
        mov rax, 4;
        lea rcx, [rip + _vniw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        call vmd_iso_qp_claim;
        cmp rax, 0;
        jne vniw_fail_stage;

        // -- 5. Lookup owner.
        mov rax, 5;
        lea rcx, [rip + _vniw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call vmd_iso_qp_owner;
        cmp rax, 0;
        jne vniw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vniw_ok];
        call klog_s1;
        call vmd_nvme_isolation_reset;
        xor rax, rax;
        jmp vniw_out;

      vniw_fail_stage:
        lea rax, [rip + _vniw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vniw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_nvme_isolation_reset;
        mov rax, 1;

      vniw_out:
        pop rbx;
        ret
      }
    }
}
