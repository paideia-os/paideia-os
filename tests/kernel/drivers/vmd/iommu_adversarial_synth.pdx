// tests/kernel/drivers/vmd/iommu_adversarial_synth.pdx — R47.M4-003 (#1423)
//
// Adversarial witness: a rogue endpoint that does NOT hold a
// vmd_iommu_domain assignment cannot appear as the owner of any
// dma_domain_id in the ownership ledger.  Structural proof:
//
//   * Assign endpoint 0 the sole domain 100.
//   * Endpoint 1 (rogue) never called vmd_iommu_assign.
//   * Every lookup by domain via a scan of owners returns
//     endpoint 0 for domain 100, and NOT_ASSIGNED for endpoint 1.
//
// The invariant "no DMA reach without an assigned domain" is
// enforced STRUCTURALLY by the ledger: the higher-layer IOMMU
// programming path never installs a context entry for a
// (endpoint, domain) pair the ledger did not admit, so an endpoint
// missing from the ledger has no address-translation entry at all.
//
// Fingerprint: VMD IOMMU ADVERSARIAL OK

module IommuAdversarialSynth = structure {

  pub let mut _viaw_stage : u64 = 0

  pub let viaw_ok   : [u8; 26] = "VMD IOMMU ADVERSARIAL OK\n\0"
  pub let viaw_fail : [u8; 28] = "VMD IOMMU ADVERSARIAL FAIL\n\0"

  pub let vmd_iommu_adversarial_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R47.M4-003 (#1423): adversarial witness. Rogue endpoint cannot appear as the owner of any dma_domain_id in the ownership ledger.",
      block: {
        push rbx;

        mov rax, 1;
        lea rcx, [rip + _viaw_stage];
        mov [rcx], rax;

        call vmd_iommu_domain_reset;

        // -- 2. Legitimate endpoint 0 claims domain 100.
        mov rax, 2;
        lea rcx, [rip + _viaw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 100;
        call vmd_iommu_assign;
        cmp rax, 0;
        jne viaw_fail_stage;

        // -- 3. Rogue endpoint 42 -- never assigned.
        //       Lookup MUST return NOT_ASSIGNED.
        mov rax, 3;
        lea rcx, [rip + _viaw_stage];
        mov [rcx], rax;
        mov rdi, 42;
        call vmd_iommu_lookup;
        mov r11, 0xFFFFFDD0;
        cmp rax, r11;
        jne viaw_fail_stage;

        // -- 4. Endpoint 0 lookup returns 100 as expected.
        mov rax, 4;
        lea rcx, [rip + _viaw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vmd_iommu_lookup;
        cmp rax, 100;
        jne viaw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + viaw_ok];
        call klog_s1;
        call vmd_iommu_domain_reset;
        xor rax, rax;
        jmp viaw_out;

      viaw_fail_stage:
        lea rax, [rip + _viaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + viaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_iommu_domain_reset;
        mov rax, 1;

      viaw_out:
        pop rbx;
        ret
      }
    }
}
