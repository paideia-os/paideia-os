// tests/kernel/drivers/vmd/hw_smoke_r47_placeholder.pdx — R47.M3-003 (#1420)
//                                                        + R47.M5-003 (#1426)
//
// VMD HW-smoke PLACEHOLDER -- covers BOTH the R47.M3 mid-round
// smoke (NVMe visible + read/write on real VMD-on T14) and the
// R47.M5 end-to-end smoke on the T14 G4.
//
// STATUS: dormant. gated:hardware. This module is deliberately NOT
// registered by any boot witness.  Its body is a minimal stub kept
// so `find ... -name '*.pdx'` finds it and the assembler validates
// its syntax, but no code path in QEMU or on the T14 G4 calls the
// function it declares.  See tools/hw-smoke-r47-vmd.md for the
// operator recipe that promotes this from a placeholder into a
// live acceptance test.
//
// Two issues are addressed by one placeholder: the R47.M3
// intermediate test asks for the NVMe first-light through the VMD
// aperture, and the R47.M5 end-to-end test asks for the full stack
// (probe + enumerate + config + msix + iommu + nvme).  On this
// scaffold they collapse to the same UNSEEDED marker; when the
// live capture lands, the recipe will fill in the expected values
// separately, at which point the placeholder is split into two
// callers.
//
// Rationale: mirrors tests/kernel/drivers/pcie/hw_smoke_hotplug_
// placeholder.pdx (R35.M1-005 #1199) and the R34/R37/R38/R39 HW-
// smoke placeholders.  A placeholder that COMPILED but never RAN
// is the shape #1199 established and this file continues.

module HwSmokeR47Placeholder = structure {

  pub let mut _vmd_hw_smoke_placeholder : u64 = 0

  pub let vmd_hw_smoke_r47_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M3-003 (#1420) + R47.M5-003 (#1426): dormant placeholder. Returns 0. Not registered by any boot witness; not on any code path. Body guarded by `arbitrated() == 0` in spirit -- there is nothing arbitrated here yet. See tools/hw-smoke-r47-vmd.md for the operator recipe that promotes this to live acceptance tests on the T14 G4.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
