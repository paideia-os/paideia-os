// tests/kernel/drivers/scsi/scsi_cmd_synth.pdx — R34.M3-003 (#1178)
//
// Boot witness for src/kernel/core/drivers/scsi/scsi_cmd.pdx.
//
// Asserts CDB construction for READ/WRITE(10), READ/WRITE(16),
// INQUIRY, READ_CAPACITY(10/16), TEST_UNIT_READY, REQUEST_SENSE,
// plus refusal discipline on BAD_LBA / BAD_XFER / BAD_LEN.
//
// Fingerprint: SCSI CMD OK
// No cap slots.

module ScsiCmdSynth = structure {

  pub let mut _scmd_w_stage : u64 = 0

  pub let scmd_w_ok   : [u8; 13] = "SCSI CMD OK\0"
  pub let scmd_w_fail : [u8; 15] = "SCSI CMD FAIL\0"

  pub let mut _scmd_w_cdb : [u64; 4] = uninit @align(64)  // 32 bytes; CDBs <= 16.

  pub let scsi_cmd_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R34.M3-003 (#1178): SCSI cmd scaffold witness. Stages: (1) honesty pin. (2) READ(10) happy path. (3) opcode readback. (4) BAD_XFER (0). (5) BAD_LBA (>u32). (6) READ(16). (7) WRITE(10)/WRITE(16). (8) INQUIRY + BAD_ALLOC. (9) READ_CAPACITY(10)/(16). (10) TEST_UNIT_READY. (11) REQUEST_SENSE + BAD_ALLOC.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        call scsi_cmd_reset;

        // -- 1. Honesty pin.
        call scsi_cmd_arbitrated;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        // -- 2. READ(10) happy path.
        mov rax, 2;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        mov rdx, 0x12345678;             // lba
        mov rcx, 8;                      // blocks
        call scsi_cmd_read10;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        // -- 3. Opcode readback.
        mov rax, 3;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        call scsi_cmd_opcode;
        cmp rax, 0x28;
        jne scmd_w_fail_stage;

        // Verify LBA at [+2..+5] big-endian.
        lea r10, [rip + _scmd_w_cdb];
        xor rax, rax;
        mov_b rax, [r10 + 2];
        cmp rax, 0x12;
        jne scmd_w_fail_stage;
        xor rax, rax;
        mov_b rax, [r10 + 5];
        cmp rax, 0x78;
        jne scmd_w_fail_stage;

        // -- 4. BAD_XFER (0).
        mov rax, 4;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        mov rdx, 0;
        mov rcx, 0;                      // bad blocks
        call scsi_cmd_read10;
        mov r11, 0xFFFFFB3B;             // BAD_XFER
        cmp rax, r11;
        jne scmd_w_fail_stage;

        // -- 5. BAD_LBA (> u32).
        mov rax, 5;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        mov r10, 0xFFFFFFFF;
        add r10, 1;
        mov rdx, r10;                    // bad lba
        mov rcx, 1;
        call scsi_cmd_read10;
        mov r11, 0xFFFFFB3C;             // BAD_LBA
        cmp rax, r11;
        jne scmd_w_fail_stage;

        // -- 6. READ(16) happy path.
        mov rax, 6;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        mov rdx, 0x100000000;            // > u32, valid for READ(16)
        mov rcx, 16;
        call scsi_cmd_read16;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        call scsi_cmd_opcode;
        cmp rax, 0x88;
        jne scmd_w_fail_stage;

        // -- 7. WRITE(10) / WRITE(16).
        mov rax, 7;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        mov rdx, 100;
        mov rcx, 4;
        call scsi_cmd_write10;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        call scsi_cmd_opcode;
        cmp rax, 0x2A;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        mov rdx, 100;
        mov rcx, 4;
        call scsi_cmd_write16;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        call scsi_cmd_opcode;
        cmp rax, 0x8A;
        jne scmd_w_fail_stage;

        // -- 8. INQUIRY + BAD_ALLOC.
        mov rax, 8;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        mov rdx, 36;                     // standard inquiry alloc
        call scsi_cmd_inquiry;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        call scsi_cmd_opcode;
        cmp rax, 0x12;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        mov rdx, 0x10000;                // > 0xFFFF
        call scsi_cmd_inquiry;
        mov r11, 0xFFFFFB3A;             // BAD_ALLOC
        cmp rax, r11;
        jne scmd_w_fail_stage;

        // -- 9. READ_CAPACITY(10) / (16).
        mov rax, 9;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        call scsi_cmd_read_capacity_10;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 10;
        call scsi_cmd_opcode;
        cmp rax, 0x25;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        call scsi_cmd_read_capacity_16;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 16;
        call scsi_cmd_opcode;
        cmp rax, 0x9E;
        jne scmd_w_fail_stage;

        // Service action at [+1] must be 0x10.
        lea r10, [rip + _scmd_w_cdb];
        xor rax, rax;
        mov_b rax, [r10 + 1];
        cmp rax, 0x10;
        jne scmd_w_fail_stage;

        // -- 10. TEST_UNIT_READY.
        mov rax, 10;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        call scsi_cmd_test_unit_ready;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        call scsi_cmd_opcode;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        // -- 11. REQUEST_SENSE + BAD_ALLOC.
        mov rax, 11;
        lea rcx, [rip + _scmd_w_stage];
        mov [rcx], rax;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        mov rdx, 18;
        call scsi_cmd_request_sense;
        cmp rax, 0;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        call scsi_cmd_opcode;
        cmp rax, 0x03;
        jne scmd_w_fail_stage;

        lea rdi, [rip + _scmd_w_cdb];
        mov rsi, 6;
        mov rdx, 256;                    // > 255
        call scsi_cmd_request_sense;
        mov r11, 0xFFFFFB3A;             // BAD_ALLOC
        cmp rax, r11;
        jne scmd_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scmd_w_ok];
        call klog_s1;

        call scsi_cmd_reset;
        xor rax, rax;
        jmp scmd_w_out;

      scmd_w_fail_stage:
        lea rax, [rip + _scmd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scmd_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call scsi_cmd_reset;
        mov rax, 1;

      scmd_w_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
