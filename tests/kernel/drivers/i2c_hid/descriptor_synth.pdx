// tests/kernel/drivers/i2c_hid/descriptor_synth.pdx — R32.M1-002 (#1116)
//
// Boot witness for the I²C-HID DESCRIPTOR SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the install latch (including REBIND), the four field
// accessors (report_len, input_reg, max_input, vendor_product), the
// refusal discipline (BAD_DESC on zero, over-length, out-of-range), and
// the fetch propagation of DEFERRED_HARDWARE + NOT_BOUND. IT ASSERTS
// NOTHING ABOUT A REAL PARSE of 30 bytes over a live transport,
// because none runs -- descriptor.pdx §4 documents the deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 I2C_HID DESCRIPTOR OK
//
// PLACEMENT AFTER transport_witness IS REQUIRED. This witness calls
// i2c_hid_descriptor_fetch, which calls i2c_hid_transport_bound; the
// transport witness leaves _i2c_hid_transport_bound = 1, and the
// fetch must return DEFERRED_HARDWARE (the honest sentinel from the
// transport's read seam). Running this before transport_witness would
// have fetch return NOT_BOUND instead, inverting the assertion.

module DescriptorSynth = structure {

  pub let mut _i2chid_desc_w_stage : u64 = 0

  pub let i2chid_desc_w_ok   : [u8; 22] = "I2C_HID DESCRIPTOR OK\0"
  pub let i2chid_desc_w_fail : [u8; 24] = "I2C_HID DESCRIPTOR FAIL\0"

  pub let i2c_hid_descriptor_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M1-002 (#1116): boot witness for the I²C-HID descriptor scaffold. Stages: (S1) valid() = 0 before install. (S2) fetch() on the bound-but-unparsed transport -> the TRANSPORT's DEFERRED_HARDWARE (0xFFFFFEBC), propagated as-is by descriptor.pdx §4 (no translation to the descriptor's own 0xFFFFFECC code); valid() still 0. (S3) install(0, 8, 64, 0x27C601C4) -> BAD_DESC (report_len == 0). install(4097, 8, 64, ...) -> BAD_DESC (report_len > 4096). install(64, 0x10000, 64, ...) -> BAD_DESC (input_reg > 16 bits). install(64, 8, 0, ...) -> BAD_DESC (max_input == 0). install(64, 8, 4097, ...) -> BAD_DESC (max_input > 4096). (S4) install(64, 8, 128, 0x27C601C4) -> OK. valid() = 1. report_len() = 64. input_reg() = 8. max_input() = 128. vendor_product() = 0x27C601C4. (S5) second install -> REBIND. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed i2chid_desc_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- valid() = 0 before install.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2chid_desc_w_stage];
        mov [rcx], rax;

        call i2c_hid_descriptor_valid;
        cmp rax, 0;
        jne i2chid_desc_w_fail_stage;

        // ================================================================
        // S2 -- fetch propagates DEFERRED_HARDWARE from transport;
        //       valid() still 0.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2chid_desc_w_stage];
        mov [rcx], rax;

        call i2c_hid_descriptor_fetch;
        mov r11, 0xFFFFFEBC;             // transport DEFERRED_HARDWARE (propagated)
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_valid;
        cmp rax, 0;
        jne i2chid_desc_w_fail_stage;

        // ================================================================
        // S3 -- install refusal boundaries.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _i2chid_desc_w_stage];
        mov [rcx], rax;

        // report_len = 0 -> BAD_DESC
        mov rdi, 0;
        mov rsi, 8;
        mov rdx, 64;
        mov rcx, 0x27C601C4;             // vendor 0x27C6, product 0x01C4 (Elan touchpad)
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECE;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // report_len = 4097 -> BAD_DESC
        mov rdi, 4097;
        mov rsi, 8;
        mov rdx, 64;
        mov rcx, 0x27C601C4;
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECE;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // input_reg = 0x10000 -> BAD_DESC
        mov rdi, 64;
        mov rsi, 0x10000;
        mov rdx, 64;
        mov rcx, 0x27C601C4;
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECE;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // max_input = 0 -> BAD_DESC
        mov rdi, 64;
        mov rsi, 8;
        mov rdx, 0;
        mov rcx, 0x27C601C4;
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECE;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // max_input = 4097 -> BAD_DESC
        mov rdi, 64;
        mov rsi, 8;
        mov rdx, 4097;
        mov rcx, 0x27C601C4;
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECE;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // Confirm valid() still 0 -- refusals must not latch.
        call i2c_hid_descriptor_valid;
        cmp rax, 0;
        jne i2chid_desc_w_fail_stage;

        // ================================================================
        // S4 -- happy install and accessors.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _i2chid_desc_w_stage];
        mov [rcx], rax;

        mov rdi, 64;
        mov rsi, 8;
        mov rdx, 128;
        mov rcx, 0x27C601C4;
        call i2c_hid_descriptor_install;
        cmp rax, 0;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_valid;
        cmp rax, 1;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_report_len;
        cmp rax, 64;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_input_reg;
        cmp rax, 8;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_max_input;
        cmp rax, 128;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_vendor_product;
        mov r11, 0x27C601C4;
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // ================================================================
        // S5 -- second install -> REBIND.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _i2chid_desc_w_stage];
        mov [rcx], rax;

        mov rdi, 32;
        mov rsi, 16;
        mov rdx, 64;
        mov rcx, 0x04F31820;
        call i2c_hid_descriptor_install;
        mov r11, 0xFFFFFECD;             // REBIND
        cmp rax, r11;
        jne i2chid_desc_w_fail_stage;

        // Confirm original values unchanged.
        call i2c_hid_descriptor_report_len;
        cmp rax, 64;
        jne i2chid_desc_w_fail_stage;

        call i2c_hid_descriptor_input_reg;
        cmp rax, 8;
        jne i2chid_desc_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_desc_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp i2chid_desc_w_out;

      i2chid_desc_w_fail_stage:
        lea rax, [rip + _i2chid_desc_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_desc_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      i2chid_desc_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
