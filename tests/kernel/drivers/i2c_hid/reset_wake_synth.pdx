// tests/kernel/drivers/i2c_hid/reset_wake_synth.pdx — R32.M1-004 (#1118)
//
// Boot witness for the I²C-HID RESET + WAKE SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the honesty pins (arbitrated = 0 for both seams), that
// each seam propagates the transport's DEFERRED_HARDWARE sentinel on
// the happy path (transport bound by transport_witness), and that
// each seam's call counter moved by exactly one. IT ASSERTS NOTHING
// ABOUT A REAL COMMAND WRITE, because none runs -- reset_wake.pdx §3
// documents the deferrals.
//
// -----------------------------------------------------------------------------
// Two fingerprints
// -----------------------------------------------------------------------------
//
//   R32 I2C_HID RESET OK
//   R32 I2C_HID WAKE OK
//
// Two because reset and wake can fail for unrelated reasons (a wrong
// register index for reset, a wrong opcode for wake), and a golden that
// asserts an ordered subsequence needs the two failures distinguishable
// in the log. Reset first because it is the command the bring-up
// sequence issues first.
//
// PLACEMENT AFTER isr_witness IS REQUIRED. This witness assumes the
// transport is bound (transport_witness left it so); reset_send and
// wake_send propagate NOT_BOUND otherwise and this witness's assertion
// of DEFERRED_HARDWARE would invert. Running before transport_witness
// would also invert the counter assertions.

module ResetWakeSynth = structure {

  pub let mut _i2chid_rw_w_stage : u64 = 0

  pub let i2chid_rw_w_ok_r   : [u8; 17] = "I2C_HID RESET OK\0"
  pub let i2chid_rw_w_fail_r : [u8; 19] = "I2C_HID RESET FAIL\0"
  pub let i2chid_rw_w_ok_w   : [u8; 16] = "I2C_HID WAKE OK\0"
  pub let i2chid_rw_w_fail_w : [u8; 18] = "I2C_HID WAKE FAIL\0"

  pub let i2c_hid_reset_wake_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M1-004 (#1118): boot witness for the I²C-HID reset and wake scaffolds. Two markers (reset, wake) so each can fail on its own reason and be distinguished in the log. Reset stages: (R1) reset_arbitrated() = 0 (honesty). (R2) reset_count() sampled as before. (R3) reset_send() -> DEFERRED_HARDWARE propagated from the transport's write seam (transport bound by transport_witness). (R4) reset_count() moved by exactly 1. Wake stages: (W1) wake_arbitrated() = 0. (W2) wake_count() sampled. (W3) wake_send() -> DEFERRED_HARDWARE. (W4) wake_count() moved by exactly 1. Each stage runs only if the previous passed; each half emits its own OK/FAIL fingerprint. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed i2chid_rw_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // R1 -- reset_arbitrated() = 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_reset_arbitrated;
        cmp rax, 0;
        jne i2chid_rw_w_fail_reset;

        // ================================================================
        // R2 -- sample reset_count() before dispatch.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_reset_count;
        mov rbx, rax;                     // saved: reset_count before

        // ================================================================
        // R3 -- reset_send() -> DEFERRED_HARDWARE from transport.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_reset_send;
        mov r11, 0xFFFFFEBC;              // DEFERRED_HARDWARE (transport)
        cmp rax, r11;
        jne i2chid_rw_w_fail_reset;

        // ================================================================
        // R4 -- reset_count() moved by exactly 1.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_reset_count;
        sub rax, rbx;
        cmp rax, 1;
        jne i2chid_rw_w_fail_reset;

        // ---- Reset half PASS: emit "I2C_HID RESET OK".
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_rw_w_ok_r];
        call klog_s1;

        // ================================================================
        // W1 -- wake_arbitrated() = 0.
        // ================================================================
        mov rax, 110;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_wake_arbitrated;
        cmp rax, 0;
        jne i2chid_rw_w_fail_wake;

        // ================================================================
        // W2 -- sample wake_count() before dispatch.
        // ================================================================
        mov rax, 120;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_wake_count;
        mov r13, rax;                     // saved: wake_count before

        // ================================================================
        // W3 -- wake_send() -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 130;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_wake_send;
        mov r11, 0xFFFFFEBC;
        cmp rax, r11;
        jne i2chid_rw_w_fail_wake;

        // ================================================================
        // W4 -- wake_count() moved by exactly 1.
        // ================================================================
        mov rax, 140;
        lea rcx, [rip + _i2chid_rw_w_stage];
        mov [rcx], rax;

        call i2c_hid_wake_count;
        sub rax, r13;
        cmp rax, 1;
        jne i2chid_rw_w_fail_wake;

        // ---- Wake half PASS: emit "I2C_HID WAKE OK".
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_rw_w_ok_w];
        call klog_s1;

        xor rax, rax;
        jmp i2chid_rw_w_out;

      i2chid_rw_w_fail_reset:
        lea rax, [rip + _i2chid_rw_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_rw_w_fail_r];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;
        jmp i2chid_rw_w_out;

      i2chid_rw_w_fail_wake:
        lea rax, [rip + _i2chid_rw_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_rw_w_fail_w];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      i2chid_rw_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
