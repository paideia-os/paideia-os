// tests/kernel/drivers/i2c_hid/isr_synth.pdx — R32.M1-003 (#1117)
//
// Boot witness for the I²C-HID ISR SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the bind latch (including REBIND), the arbitration pin
// (0 -- honesty function), the refusal discipline (NOT_BOUND ordering
// against NO_DESC), and the DEFERRED_HARDWARE outcome propagated from
// the transport's read seam on assert. IT ASSERTS NOTHING ABOUT A REAL
// GPIO EDGE SUBSCRIPTION or a real input-report read -- isr.pdx §3
// documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 I2C_HID ISR OK
//
// PLACEMENT AFTER descriptor_witness IS REQUIRED. This witness's S4
// assumes the descriptor is valid (so the ISR reaches the transport
// read); descriptor_witness leaves valid = 1. Running this witness
// before descriptor_witness would have assert return NO_DESC on the
// happy-path stage.

module IsrSynth = structure {

  pub let mut _i2chid_isr_w_stage : u64 = 0

  pub let i2chid_isr_w_ok   : [u8; 19] = "R32 I2C_HID ISR OK\0"
  pub let i2chid_isr_w_fail : [u8; 21] = "R32 I2C_HID ISR FAIL\0"

  pub let i2c_hid_isr_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M1-003 (#1117): boot witness for the I²C-HID ISR scaffold. Stages: (S1) bound() = 0 before bind; arbitrated() = 0 (honesty pin). (S2) assert() before bind -> NOT_BOUND. (S3) bind() -> OK; bound() = 1; arbitrated() STILL 0. Second bind -> REBIND. (S4) assert() after bind (descriptor is valid, left by descriptor_witness) -> DEFERRED_HARDWARE (propagated from transport read). asserts() counter moved by 1. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed i2chid_isr_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- bound() = 0, arbitrated() = 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2chid_isr_w_stage];
        mov [rcx], rax;

        call i2c_hid_isr_bound;
        cmp rax, 0;
        jne i2chid_isr_w_fail_stage;

        call i2c_hid_isr_arbitrated;
        cmp rax, 0;
        jne i2chid_isr_w_fail_stage;

        // ================================================================
        // S2 -- assert before bind -> NOT_BOUND.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2chid_isr_w_stage];
        mov [rcx], rax;

        call i2c_hid_isr_assert;
        mov r11, 0xFFFFFEDF;             // NOT_BOUND
        cmp rax, r11;
        jne i2chid_isr_w_fail_stage;

        // ================================================================
        // S3 -- bind, bound() = 1, arbitrated() still 0.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _i2chid_isr_w_stage];
        mov [rcx], rax;

        call i2c_hid_isr_bind;
        cmp rax, 0;
        jne i2chid_isr_w_fail_stage;

        call i2c_hid_isr_bound;
        cmp rax, 1;
        jne i2chid_isr_w_fail_stage;

        call i2c_hid_isr_arbitrated;
        cmp rax, 0;
        jne i2chid_isr_w_fail_stage;

        // Second bind -> REBIND.
        call i2c_hid_isr_bind;
        mov r11, 0xFFFFFEDD;             // REBIND
        cmp rax, r11;
        jne i2chid_isr_w_fail_stage;

        // ================================================================
        // S4 -- assert after bind (descriptor is valid, left by
        //       descriptor_witness) -> DEFERRED_HARDWARE from transport.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _i2chid_isr_w_stage];
        mov [rcx], rax;

        call i2c_hid_isr_asserts;
        mov rbx, rax;                    // asserts before

        call i2c_hid_isr_assert;
        mov r11, 0xFFFFFEBC;             // transport DEFERRED_HARDWARE
        cmp rax, r11;
        jne i2chid_isr_w_fail_stage;

        call i2c_hid_isr_asserts;
        sub rax, rbx;
        cmp rax, 1;
        jne i2chid_isr_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_isr_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp i2chid_isr_w_out;

      i2chid_isr_w_fail_stage:
        lea rax, [rip + _i2chid_isr_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_isr_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      i2chid_isr_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
