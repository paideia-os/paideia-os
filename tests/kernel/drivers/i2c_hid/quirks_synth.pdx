// tests/kernel/drivers/i2c_hid/quirks_synth.pdx — R32.M1-005 (#1119)
//
// Boot witness for the I²C-HID QUIRK TABLE.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the honesty pin (consumed = 0 while no bring-up sequence
// keys off the table), the row count (2), the wildcard match on both
// Synaptics and ELAN vendor IDs with several product suffixes, the
// per-vendor flag set (Synaptics -> DELAYED_RESET, ELAN ->
// RESET_BEFORE_DESC | DROP_FIRST_REPORT), and a miss on an unknown
// vendor. IT ASSERTS NOTHING ABOUT A LIVE BRING-UP DECISION, because
// no consumer exists yet -- quirks.pdx §0 documents that.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 I2C_HID QUIRKS OK
//
// One because the whole scaffold is the compile-time table and the
// linear lookup: a broken lookup fails one stage no matter the row,
// and a broken row fails one stage no matter the lookup.
//
// PLACEMENT is unconstrained: this witness reads a compile-time constant
// table and reads/preserves a single .bss counter (_i2c_hid_quirk_
// consumers). It shares no state with any other witness.

module QuirksSynth = structure {

  pub let mut _i2chid_qk_w_stage : u64 = 0

  pub let i2chid_qk_w_ok   : [u8; 22] = "R32 I2C_HID QUIRKS OK\0"
  pub let i2chid_qk_w_fail : [u8; 24] = "R32 I2C_HID QUIRKS FAIL\0"

  pub let i2c_hid_quirks_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M1-005 (#1119): boot witness for the I²C-HID quirk table. Stages: (S1) quirks_consumed() = 0 (honesty pin -- no live bring-up keys off the table). (S2) quirk_count() = 2 (Synaptics + ELAN, task-specified initial entries). (S3) lookup(0x06CB0000) -> DELAYED_RESET (0x1): exact match against Synaptics wildcard row. (S4) lookup(0x06CB1234) -> DELAYED_RESET (0x1): exact miss, wildcard hit on Synaptics. (S5) lookup(0x04F30000) -> RESET_BEFORE_DESC|DROP_FIRST_REPORT (0x6): exact match against ELAN wildcard row. (S6) lookup(0x04F31820) -> 0x6: exact miss, wildcard hit on ELAN. (S7) lookup(0xDEAD1234) -> 0 (I2C_HID_QUIRK_NONE): both passes miss. Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed i2chid_qk_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- honesty pin.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        call i2c_hid_quirks_consumed;
        cmp rax, 0;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S2 -- row count.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        call i2c_hid_quirk_count;
        cmp rax, 2;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S3 -- lookup(0x06CB0000) -> DELAYED_RESET.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x06CB0000;
        call i2c_hid_quirk_lookup;
        cmp rax, 1;                       // DELAYED_RESET
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S4 -- lookup(0x06CB1234) -> DELAYED_RESET (wildcard hit).
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x06CB1234;
        call i2c_hid_quirk_lookup;
        cmp rax, 1;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S5 -- lookup(0x04F30000) -> 0x6 (RESET_BEFORE_DESC|DROP_FIRST).
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x04F30000;
        call i2c_hid_quirk_lookup;
        cmp rax, 6;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S6 -- lookup(0x04F31820) -> 0x6 (wildcard hit).
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x04F31820;
        call i2c_hid_quirk_lookup;
        cmp rax, 6;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // S7 -- lookup(0xDEAD1234) -> NONE.
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _i2chid_qk_w_stage];
        mov [rcx], rax;

        mov rdi, 0xDEAD1234;
        call i2c_hid_quirk_lookup;
        cmp rax, 0;
        jne i2chid_qk_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_qk_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp i2chid_qk_w_out;

      i2chid_qk_w_fail_stage:
        lea rax, [rip + _i2chid_qk_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_qk_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      i2chid_qk_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
