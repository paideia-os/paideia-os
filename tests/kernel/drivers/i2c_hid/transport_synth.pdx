// tests/kernel/drivers/i2c_hid/transport_synth.pdx — R32.M1-001 (#1115)
//
// Boot witness for the I²C-HID TRANSPORT SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the bind latch (including the REBIND refusal), the
// arbitration pin (0 -- the honesty function), the refusal discipline
// (BAD_REG, BAD_LEN, NOT_BOUND) and the DEFERRED_HARDWARE outcome on
// both the read seam and the write seam. IT ASSERTS NOTHING ABOUT A
// REAL I²C TRANSFER, because none runs in this tree --
// transport.pdx §4 documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 I2C_HID TRANSPORT OK
//
// One because there is no unit conversion here and no cached state
// machine that could fail for reasons independent of the seam; the
// whole scaffold is the bind latch and the refusal codes on read/write.

module TransportSynth = structure {

  pub let mut _i2chid_tr_w_stage : u64 = 0

  pub let i2chid_tr_w_ok   : [u8; 21] = "I2C_HID TRANSPORT OK\0"
  pub let i2chid_tr_w_fail : [u8; 23] = "I2C_HID TRANSPORT FAIL\0"

  pub let i2c_hid_transport_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M1-001 (#1115): boot witness for the I²C-HID transport scaffold. Stages: (S1) bound() = 0 before bind; arbitrated() = 0 (honesty pin). (S2) read(0x10, 8) before bind -> NOT_BOUND. (S3) bind(0xBEEF, 0x0001) -> OK; bound() = 1; arbitrated() STILL 0. (S4) read(0x10, 8) after bind -> DEFERRED_HARDWARE. (S5) write(0x22, 0x5A) after bind -> DEFERRED_HARDWARE. (S6) read(0x10000, 8) -> BAD_REG. read(0x10, 0) -> BAD_LEN. read(0x10, 256) -> BAD_LEN. write(0x10000, 0) -> BAD_REG. write(0x10, 0x100) -> BAD_LEN (a byte outside 8 bits is not a byte). (S7) bind(0xBEEF, 0x0001) a second time -> REBIND. (S8) reads() and writes() moved. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed i2chid_tr_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- bound() = 0, arbitrated() = 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        call i2c_hid_transport_bound;
        cmp rax, 0;
        jne i2chid_tr_w_fail_stage;

        call i2c_hid_transport_arbitrated;
        cmp rax, 0;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S2 -- read before bind -> NOT_BOUND.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        mov rdi, 0x10;
        mov rsi, 8;
        call i2c_hid_transport_read;
        mov r11, 0xFFFFFEBF;             // NOT_BOUND
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S3 -- bind, bound() = 1, arbitrated() still 0.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        mov rdi, 0xBEEF;                 // opaque bus handle
        mov rsi, 0x0001;                 // ACPI HidDescRegister
        call i2c_hid_transport_bind;
        cmp rax, 0;
        jne i2chid_tr_w_fail_stage;

        call i2c_hid_transport_bound;
        cmp rax, 1;
        jne i2chid_tr_w_fail_stage;

        call i2c_hid_transport_arbitrated;
        cmp rax, 0;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S4 -- read after bind -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        call i2c_hid_transport_reads;
        mov rbx, rax;                    // reads before

        mov rdi, 0x10;
        mov rsi, 8;
        call i2c_hid_transport_read;
        mov r11, 0xFFFFFEBC;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S5 -- write after bind -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        call i2c_hid_transport_writes;
        mov r13, rax;                    // writes before

        mov rdi, 0x22;
        mov rsi, 0x5A;
        call i2c_hid_transport_write;
        mov r11, 0xFFFFFEBC;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S6 -- refusal boundaries.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        // read: reg = 0x10000 (out of 16 bits) -> BAD_REG
        mov rdi, 0x10000;
        mov rsi, 8;
        call i2c_hid_transport_read;
        mov r11, 0xFFFFFEBE;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // read: len = 0 -> BAD_LEN
        mov rdi, 0x10;
        mov rsi, 0;
        call i2c_hid_transport_read;
        mov r11, 0xFFFFFEBD;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // read: len = 256 -> BAD_LEN
        mov rdi, 0x10;
        mov rsi, 256;
        call i2c_hid_transport_read;
        mov r11, 0xFFFFFEBD;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // write: reg = 0x10000 -> BAD_REG
        mov rdi, 0x10000;
        mov rsi, 0;
        call i2c_hid_transport_write;
        mov r11, 0xFFFFFEBE;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // write: byte = 0x100 -> BAD_LEN
        mov rdi, 0x10;
        mov rsi, 0x100;
        call i2c_hid_transport_write;
        mov r11, 0xFFFFFEBD;
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S7 -- second bind -> REBIND.
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        mov rdi, 0xCAFE;
        mov rsi, 0x0001;
        call i2c_hid_transport_bind;
        mov r11, 0xFFFFFEBB;             // REBIND
        cmp rax, r11;
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // S8 -- reads() and writes() moved.
        // ================================================================
        mov rax, 80;
        lea rcx, [rip + _i2chid_tr_w_stage];
        mov [rcx], rax;

        call i2c_hid_transport_reads;
        sub rax, rbx;
        cmp rax, 1;                      // exactly S4
        jne i2chid_tr_w_fail_stage;

        call i2c_hid_transport_writes;
        sub rax, r13;
        cmp rax, 1;                      // exactly S5
        jne i2chid_tr_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_tr_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp i2chid_tr_w_out;

      i2chid_tr_w_fail_stage:
        lea rax, [rip + _i2chid_tr_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + i2chid_tr_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      i2chid_tr_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
