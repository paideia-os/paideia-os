// tests/kernel/drivers/text/subpixel_synth.pdx -- G5.M3-001 / M3-002 /
// M3-003
//
// Boot witness for drivers/text/subpixel. Exercises pos_of at
// fractional scales, cache insert/lookup/invalidate, and P9
// predicate.
//
// Fingerprint: G5 SUBPX OK

module SubpixelSynth = structure {

  pub let mut _spxw_stage : u64 = 0

  pub let spxw_ok   : [u8; 12] = "G5 SUBPX OK\0"
  pub let spxw_fail : [u8; 14] = "G5 SUBPX FAIL\0"

  pub let subpixel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M3-001..003: boot witness. Stages: (1) reset. (2) pos_of at 1/1 and 3/2. (3) insert -> lookup hit. (4) lookup on scale change misses. (5) invalidate returns 1. (6) P9 predicate accepts 5/4, 3/2, 7/4, 2/1; refuses 6/4, 0/1.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        call subpx_reset;

        // 2. pos_of(1000, 1, 1) -> 1000 * 1000 / 1 = 1_000_000.
        mov rax, 2;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        mov rdi, 1000;
        mov rsi, 1;
        mov rdx, 1;
        call subpx_pos_of;
        mov r10, 1000000;
        cmp rax, r10;
        jne spxw_fail_stage;
        // pos_of(1000, 3, 2) -> 1000 * 3 * 1000 / 2 = 1_500_000.
        mov rdi, 1000;
        mov rsi, 3;
        mov rdx, 2;
        call subpx_pos_of;
        mov r10, 1500000;
        cmp rax, r10;
        jne spxw_fail_stage;

        // 3. insert(row=5, 3, 2) -> lookup hits.
        mov rax, 3;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 3;
        mov rdx, 2;
        call subpx_cache_insert;
        mov r12, rax;                       // slot
        mov rdi, 5;
        mov rsi, 3;
        mov rdx, 2;
        call subpx_cache_lookup;
        cmp rax, r12;
        jne spxw_fail_stage;

        // 4. lookup(row=5, 5, 4) misses (scale changed).
        mov rax, 4;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 5;
        mov rdx, 4;
        call subpx_cache_lookup;
        mov r10, 0xFFFFED7B;
        cmp rax, r10;
        jne spxw_fail_stage;

        // 5. invalidate(5) returns 1.
        mov rax, 5;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call subpx_cache_invalidate;
        cmp rax, 1;
        jne spxw_fail_stage;
        // Post-invalidate lookup at old scale also misses.
        mov rdi, 5;
        mov rsi, 3;
        mov rdx, 2;
        call subpx_cache_lookup;
        mov r10, 0xFFFFED7B;
        cmp rax, r10;
        jne spxw_fail_stage;

        // 6. P9.
        mov rax, 6;
        lea rcx, [rip + _spxw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 4;
        call subpx_p9_valid;
        cmp rax, 1;
        jne spxw_fail_stage;
        mov rdi, 3;
        mov rsi, 2;
        call subpx_p9_valid;
        cmp rax, 1;
        jne spxw_fail_stage;
        mov rdi, 7;
        mov rsi, 4;
        call subpx_p9_valid;
        cmp rax, 1;
        jne spxw_fail_stage;
        mov rdi, 2;
        mov rsi, 1;
        call subpx_p9_valid;
        cmp rax, 1;
        jne spxw_fail_stage;
        mov rdi, 6;
        mov rsi, 4;
        call subpx_p9_valid;
        cmp rax, 0;
        jne spxw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call subpx_p9_valid;
        cmp rax, 0;
        jne spxw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + spxw_ok];
        call klog_s1;

        call subpx_reset;
        xor rax, rax;
        jmp spxw_out;

      spxw_fail_stage:
        lea rax, [rip + _spxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + spxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call subpx_reset;
        mov rax, 1;

      spxw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
