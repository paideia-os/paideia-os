// tests/kernel/drivers/text/color_emoji_synth.pdx -- G5.M4-001..003
//
// Boot witness for drivers/text/color_emoji. Exercises kind_valid,
// strike_select for COLR/SBIX/CBDT + NONE refusal, and COLR
// layer_count ceiling.
//
// Fingerprint: G5 COLOR EMOJI OK

module ColorEmojiSynth = structure {

  pub let mut _cew_stage : u64 = 0

  pub let cew_ok   : [u8; 18] = "G5 COLOR EMOJI OK\0"
  pub let cew_fail : [u8; 20] = "G5 COLOR EMOJI FAIL\0"

  pub let color_emoji_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M4-001..003: boot witness. Stages: (1) reset. (2) kind_valid. (3) strike_select COLR 30px -> 32. (4) strike_select SBIX 50px -> 64. (5) strike_select CBDT 100px -> 128. (6) strike_select NONE refused. (7) layer_count in-range + over-ceiling refused.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        call ce_reset;

        // 2. kind_valid.
        mov rax, 2;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call ce_kind_valid;
        cmp rax, 1;
        jne cew_fail_stage;
        mov rdi, 3;
        call ce_kind_valid;
        cmp rax, 1;
        jne cew_fail_stage;
        mov rdi, 4;
        call ce_kind_valid;
        cmp rax, 0;
        jne cew_fail_stage;

        // 3. strike_select COLR (1) at 30 -> 32.
        mov rax, 3;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 30;
        call ce_strike_select;
        cmp rax, 32;
        jne cew_fail_stage;

        // 4. strike_select SBIX (2) at 50 -> 64.
        mov rax, 4;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 50;
        call ce_strike_select;
        cmp rax, 64;
        jne cew_fail_stage;

        // 5. strike_select CBDT (3) at 100 -> 128.
        mov rax, 5;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 100;
        call ce_strike_select;
        cmp rax, 128;
        jne cew_fail_stage;

        // 6. strike_select NONE (0) refused.
        mov rax, 6;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 30;
        call ce_strike_select;
        mov r10, 0xFFFFED6C;
        cmp rax, r10;
        jne cew_fail_stage;

        // 7. layer_count 12 -> 12; 100 refused.
        mov rax, 7;
        lea rcx, [rip + _cew_stage];
        mov [rcx], rax;
        mov rdi, 65;
        mov rsi, 12;
        call ce_colr_layer_count;
        cmp rax, 12;
        jne cew_fail_stage;
        mov rdi, 65;
        mov rsi, 100;
        call ce_colr_layer_count;
        mov r10, 0xFFFFED6B;
        cmp rax, r10;
        jne cew_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cew_ok];
        call klog_s1;

        call ce_reset;
        xor rax, rax;
        jmp cew_out;

      cew_fail_stage:
        lea rax, [rip + _cew_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cew_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ce_reset;
        mov rax, 1;

      cew_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
