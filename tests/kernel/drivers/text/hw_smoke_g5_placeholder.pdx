// tests/kernel/drivers/text/hw_smoke_g5_placeholder.pdx -- G5.M3-003
// (#1503) P9 acceptance on real T14
//
// D7-dormant HW-smoke placeholder for the G5 "SDF glyphs at 1.25x /
// 1.5x / 1.75x pixel-perfect" acceptance. The recipe lives in
// tools/hw-smoke-g5.md; this module compiles and links but is NOT
// registered in the QEMU boot witness path per gated:hardware
// discipline.
//
// The real HW-smoke opens a KIND_FONT_ATLAS against the T14 eDP's
// KIND_GPU_BO, mints a KIND_TEXT_SHAPE at 5/4, 3/2, then 7/4, and
// asserts the rendered pixel grid matches the golden fixture at
// each scale. The visual regression corpus + golden images live
// under tests/gold/g5/.
//
// This placeholder exists so tools/build.sh can pin the file as
// present (present even if dormant), and tools/hw-smoke-g5.md can
// name it as the entry point a real T14 boot invokes when the
// operator sets G5_HW_SMOKE=1 in the loader sidecar.

module HwSmokeG5Placeholder = structure {

  pub let hw_smoke_g5_stub : () -> () !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M3-003 (#1503): dormant HW-smoke stub. Not registered under QEMU; see tools/hw-smoke-g5.md for the real T14 recipe.",
      block: {
        ret
      }
    }
}
