// tests/kernel/drivers/text/shaper_synth.pdx -- G5.M2-001 / M2-004 /
// M2-005 / M3-004 / M4-004
//
// Boot witness for drivers/text/shaper. Exercises feature validator,
// features_hash, BiDi split, hint decision, Indic clustering.
//
// Fingerprint: G5 SHAPER OK

module ShaperSynth = structure {

  pub let mut _shpw_stage : u64 = 0

  pub let shpw_ok   : [u8; 13] = "G5 SHAPER OK\0"
  pub let shpw_fail : [u8; 15] = "G5 SHAPER FAIL\0"

  pub let shaper_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M2-001..005 + G5.M3-004 + G5.M4-004: boot witness. Stages: (1) reset. (2) features_valid. (3) features_hash stable. (4) apply_features happy + refused. (5) bidi_split. (6) hint_should_hint. (7) indic_cluster Devanagari + refused non-Indic.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        call shp_reset;

        // 2. features_valid: KERN|LIGA ok, 0x100 refused.
        mov rax, 2;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 3;                         // KERN | LIGA
        call shp_features_valid;
        cmp rax, 1;
        jne shpw_fail_stage;
        mov rdi, 0x100;                     // unknown bit
        call shp_features_valid;
        cmp rax, 0;
        jne shpw_fail_stage;

        // 3. features_hash stable: same input -> same output; distinct
        //    inputs -> distinct outputs.
        mov rax, 3;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call shp_features_hash;
        mov r12, rax;
        mov rdi, 3;
        call shp_features_hash;
        cmp rax, r12;
        jne shpw_fail_stage;
        mov rdi, 5;
        call shp_features_hash;
        cmp rax, r12;
        je  shpw_fail_stage;

        // 4. apply_features: KERN|LIGA ok; 0x100 refused.
        mov rax, 4;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call shp_apply_features;
        mov r10, 0xFFFFEDBC;
        cmp rax, r10;
        je  shpw_fail_stage;
        mov rdi, 0x100;
        call shp_apply_features;
        mov r10, 0xFFFFEDBC;
        cmp rax, r10;
        jne shpw_fail_stage;

        // 5. bidi_split: len=200 depth=2 -> 3 sub-runs.
        //    depth=17 refused; len=0 refused.
        mov rax, 5;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 200;
        mov rsi, 2;
        call shp_bidi_split;
        cmp rax, 3;
        jne shpw_fail_stage;
        mov rdi, 200;
        mov rsi, 17;
        call shp_bidi_split;
        mov r10, 0xFFFFEDB9;
        cmp rax, r10;
        jne shpw_fail_stage;
        mov rdi, 0;
        mov rsi, 0;
        call shp_bidi_split;
        mov r10, 0xFFFFEDBB;
        cmp rax, r10;
        jne shpw_fail_stage;

        // 6. hint: 12px @ 144 DPI -> hint; 24px @ 144 DPI -> no.
        mov rax, 6;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 12;
        mov rsi, 144;
        call shp_hint_should_hint;
        cmp rax, 1;
        jne shpw_fail_stage;
        mov rdi, 24;
        mov rsi, 144;
        call shp_hint_should_hint;
        cmp rax, 0;
        jne shpw_fail_stage;
        mov rdi, 12;
        mov rsi, 72;                        // low DPI
        call shp_hint_should_hint;
        cmp rax, 0;
        jne shpw_fail_stage;

        // 7. Indic cluster: DEVANAGARI (10), len=30 -> 11.
        //    LATIN (1) refused.
        mov rax, 7;
        lea rcx, [rip + _shpw_stage];
        mov [rcx], rax;
        mov rdi, 10;
        mov rsi, 30;
        call shp_indic_cluster;
        cmp rax, 11;
        jne shpw_fail_stage;
        mov rdi, 1;                         // LATIN
        mov rsi, 30;
        call shp_indic_cluster;
        mov r10, 0xFFFFEDB8;
        cmp rax, r10;
        jne shpw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + shpw_ok];
        call klog_s1;

        call shp_reset;
        xor rax, rax;
        jmp shpw_out;

      shpw_fail_stage:
        lea rax, [rip + _shpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + shpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call shp_reset;
        mov rax, 1;

      shpw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
