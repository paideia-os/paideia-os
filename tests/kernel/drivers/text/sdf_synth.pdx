// tests/kernel/drivers/text/sdf_synth.pdx -- G5.M1-001 / M1-004 / M1-005
//
// Boot witness for drivers/text/sdf. Exercises tile-size validator,
// format-selection heuristic, gen happy path, and MSDF refinement
// refusal on a non-MSDF atlas.
//
// Fingerprint: G5 SDF OK

module SdfSynth = structure {

  pub let mut _sdfw_stage : u64 = 0

  pub let sdfw_ok   : [u8; 10] = "G5 SDF OK\0"
  pub let sdfw_fail : [u8; 12] = "G5 SDF FAIL\0"

  pub let sdf_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M1-001 (#1491) + G5.M1-004 (#1494) + G5.M1-005 (#1495): boot witness. Stages: (1) reset. (2) tile size. (3) format select COVERAGE. (4) format select SDF. (5) format select MSDF (large + sharp). (6) format select COLOR. (7) sdf_gen refuses bad atlas. (8) sdf_msdf_refine refuses non-MSDF atlas.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset both drivers.
        mov rax, 1;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        call sdf_reset;
        call fa_table_reset;

        // 2. tile_size_valid.
        mov rax, 2;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 16;
        call sdf_tile_size_valid;
        cmp rax, 1;
        jne sdfw_fail_stage;
        mov rdi, 7;                         // < min
        call sdf_tile_size_valid;
        cmp rax, 0;
        jne sdfw_fail_stage;
        mov rdi, 17;                        // not 4-aligned
        call sdf_tile_size_valid;
        cmp rax, 0;
        jne sdfw_fail_stage;

        // 3. format select COVERAGE (14px, 1/1, no flags).
        mov rax, 3;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 14;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 0;
        call sdf_format_select;
        cmp rax, 3;
        jne sdfw_fail_stage;

        // 4. format select SDF (24px, 3/2, no flags).
        mov rax, 4;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 24;
        mov rsi, 3;
        mov rdx, 2;
        mov rcx, 0;
        call sdf_format_select;
        cmp rax, 1;
        jne sdfw_fail_stage;

        // 5. format select MSDF (32px + SHARP flag).
        mov rax, 5;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 32;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 1;                         // SHARP
        call sdf_format_select;
        cmp rax, 2;
        jne sdfw_fail_stage;

        // 5b. format select MSDF (128px, no flags -> big -> MSDF).
        mov rdi, 128;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 0;
        call sdf_format_select;
        cmp rax, 2;
        jne sdfw_fail_stage;

        // 6. format select COLOR (32px + COLOR flag).
        mov rax, 6;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 32;
        mov rsi, 1;
        mov rdx, 1;
        mov rcx, 2;                         // COLOR
        call sdf_format_select;
        cmp rax, 4;
        jne sdfw_fail_stage;

        // 7. sdf_gen against a non-existent atlas refuses cleanly.
        mov rax, 7;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 5;                         // atlas_row not allocated
        mov rsi, 65;                        // glyph_id 'A'
        mov rdx, 32;
        mov rcx, 1;
        call sdf_gen;
        mov r10, 0xFFFFEDAF;
        cmp rax, r10;
        jne sdfw_fail_stage;

        // 8. sdf_msdf_refine refuses when atlas format is SDF, not MSDF.
        //    Set up a row with format = SDF (1), then attempt refine.
        mov rax, 8;
        lea rcx, [rip + _sdfw_stage];
        mov [rcx], rax;
        mov rdi, 3;                         // bo_slot
        mov rsi, 512;
        mov rdx, 512;
        mov rcx, 1;                         // format SDF
        call fa_body1_pack;
        mov r12, rax;
        mov rdi, 0;
        mov rsi, 0;
        call fa_body2_pack;
        mov r13, rax;
        mov rdi, 0;
        call fa_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xF001;
        mov rdx, r12;
        mov rcx, r13;
        call fa_tail_alloc;
        cmp rax, 0;
        jne sdfw_fail_stage;
        mov r14, rax;
        mov rdi, r14;
        mov rsi, 65;
        call sdf_msdf_refine;
        mov r10, 0xFFFFEDAB;
        cmp rax, r10;
        jne sdfw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sdfw_ok];
        call klog_s1;

        call sdf_reset;
        call fa_table_reset;
        xor rax, rax;
        jmp sdfw_out;

      sdfw_fail_stage:
        lea rax, [rip + _sdfw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sdfw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sdf_reset;
        call fa_table_reset;
        mov rax, 1;

      sdfw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
