// tests/kernel/drivers/bt/bt_hid_synth.pdx — R39.M6-002 (#1344)
//
// Boot witness for the BT HID (HID over L2CAP) driver.
//
// Drives bthid_init, bind (keyboard + mouse), duplicate device / CID
// collision refusals, PSM/CID validators, report ingest for both
// happy path and BAD_REPORT, and unbind.
//
// Fingerprint: R39 BT HID OK

module BtHidSynth = structure {

  pub let mut _bthidw_stage : u64 = 0

  pub let bthidw_ok   : [u8; 16] = "R39 BT HID OK\n\0\0"
  pub let bthidw_fail : [u8; 17] = "R39 BT HID FAIL\n\0"

  pub let bthidw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): reset BT HID bind table + counters + init flag.",
      block: {
        call bthid_reset;
        ret
      }
    }

  pub let bt_hid_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M6-002 (#1344): boot witness. Stages: (1) validators. (2) uninit refuse. (3) init idempotent. (4) bind KEYBOARD + MOUSE. (5) DUP_DEVICE refused. (6) CID_COLLISION refused. (7) BAD_KIND refused. (8) BAD_CID refused. (9) ctrl==intr refused. (10) row-accessor round-trip. (11) report ingest happy path + BAD_REPORT. (12) unbind + counter check.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Validators.
        mov rax, 1;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        call bthid_psm_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 0x13;
        call bthid_psm_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 0x01;
        call bthid_psm_valid;
        cmp rax, 0;
        jne bthidw_fail_stage;

        mov rdi, 0;
        call bthid_kind_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 1;
        call bthid_kind_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 5;
        call bthid_kind_valid;
        cmp rax, 0;
        jne bthidw_fail_stage;

        mov rdi, 0x0040;
        call bthid_cid_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 0xFFFF;
        call bthid_cid_valid;
        cmp rax, 1;
        jne bthidw_fail_stage;
        mov rdi, 0x003F;
        call bthid_cid_valid;
        cmp rax, 0;
        jne bthidw_fail_stage;

        // -- 2. Uninit refuse.  bthid_bind must return NOT_INITIALIZED
        // (0xFFFFF288) before bthid_init.
        mov rax, 2;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        call bthidw_scrub;

        mov rdi, 0;                                  // KEYBOARD
        mov rsi, 0x0100;                             // ctrl_cid
        mov rdx, 0x0101;                             // intr_cid
        mov rcx, 10;                                 // hid_slot
        call bthid_bind;
        mov r11, 0xFFFFF288;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 3. init idempotent.
        mov rax, 3;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        call bthid_init;
        cmp rax, 0;
        jne bthidw_fail_stage;
        call bthid_init;
        cmp rax, 0;
        jne bthidw_fail_stage;

        // -- 4. Bind KEYBOARD + MOUSE.
        mov rax, 4;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0;                                  // KEYBOARD
        mov rsi, 0x0100;
        mov rdx, 0x0101;
        mov rcx, 10;
        call bthid_bind;
        mov r11, 0xFFFFF280;
        cmp rax, r11;
        jae bthidw_fail_stage;
        mov r12, rax;                                // keyboard row

        mov rdi, 1;                                  // MOUSE
        mov rsi, 0x0200;
        mov rdx, 0x0201;
        mov rcx, 11;                                 // different hid_slot
        call bthid_bind;
        mov r11, 0xFFFFF280;
        cmp rax, r11;
        jae bthidw_fail_stage;
        mov r13, rax;                                // mouse row

        // -- 5. Duplicate hid_slot refused (DUP_DEVICE 0xFFFFF286).
        mov rax, 5;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x0300;
        mov rdx, 0x0301;
        mov rcx, 10;                                 // dup hid_slot
        call bthid_bind;
        mov r11, 0xFFFFF286;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 6. CID collision refused (CID_COLLISION 0xFFFFF282).
        mov rax, 6;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x0100;                             // clashes with row r12 ctrl
        mov rdx, 0x0400;
        mov rcx, 12;
        call bthid_bind;
        mov r11, 0xFFFFF282;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 7. BAD_KIND refused (0xFFFFF28B).
        mov rax, 7;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 5;                                  // out-of-range kind
        mov rsi, 0x0500;
        mov rdx, 0x0501;
        mov rcx, 13;
        call bthid_bind;
        mov r11, 0xFFFFF28B;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 8. BAD_CID refused (0xFFFFF28C).
        mov rax, 8;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x003F;                             // below dynamic range
        mov rdx, 0x0600;
        mov rcx, 14;
        call bthid_bind;
        mov r11, 0xFFFFF28C;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 9. ctrl == intr refused (BAD_CID).
        mov rax, 9;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x0700;
        mov rdx, 0x0700;                             // same as ctrl
        mov rcx, 15;
        call bthid_bind;
        mov r11, 0xFFFFF28C;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 10. Row-accessor round-trip on r12.
        mov rax, 10;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call bthid_row_kind;
        cmp rax, 0;                                  // KEYBOARD
        jne bthidw_fail_stage;

        mov rdi, r12;
        call bthid_row_ctrl_cid;
        cmp rax, 0x0100;
        jne bthidw_fail_stage;

        mov rdi, r12;
        call bthid_row_intr_cid;
        cmp rax, 0x0101;
        jne bthidw_fail_stage;

        mov rdi, r12;
        call bthid_row_hid_slot;
        cmp rax, 10;
        jne bthidw_fail_stage;

        mov rdi, r13;
        call bthid_row_kind;
        cmp rax, 1;                                  // MOUSE
        jne bthidw_fail_stage;

        // -- 11. Report ingest.
        mov rax, 11;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 8;                                  // typical keyboard report
        call bthid_report_ingest;
        cmp rax, 0;
        jne bthidw_fail_stage;

        // BAD_REPORT: too small.
        mov rdi, r12;
        mov rsi, 1;
        call bthid_report_ingest;
        mov r11, 0xFFFFF285;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // BAD_REPORT: too large.
        mov rdi, r13;
        mov rsi, 600;
        call bthid_report_ingest;
        mov r11, 0xFFFFF285;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // Unbound row -> BAD_ROW.
        mov rdi, 3;                                  // free row
        mov rsi, 8;
        call bthid_report_ingest;
        mov r11, 0xFFFFF28E;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // -- 12. Unbind + counter.
        mov rax, 12;
        lea rcx, [rip + _bthidw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call bthid_unbind;
        cmp rax, 0;
        jne bthidw_fail_stage;
        mov rdi, r13;
        call bthid_unbind;
        cmp rax, 0;
        jne bthidw_fail_stage;

        mov rdi, 1;                                  // UNBINDS counter
        call bthid_stat;
        cmp rax, 2;
        jne bthidw_fail_stage;

        // Unbind on released row -> BAD_ROW.
        mov rdi, r12;
        call bthid_unbind;
        mov r11, 0xFFFFF28E;
        cmp rax, r11;
        jne bthidw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bthidw_ok];
        call klog_s1;

        call bthidw_scrub;
        xor rax, rax;
        jmp bthidw_out;

      bthidw_fail_stage:
        lea rax, [rip + _bthidw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bthidw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bthidw_scrub;
        mov rax, 1;

      bthidw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
