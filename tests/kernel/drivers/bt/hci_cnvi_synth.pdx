// tests/kernel/drivers/bt/hci_cnvi_synth.pdx — R39.M1-001 (#1323)
//
// Boot witness for the HCI transport over CNVi.
//
// Asserts packet-type validator, CMD / EVT / ACL framing packer +
// unpacker symmetry, TX enqueue with free-running counter fullness
// discipline, RX slot write + dequeue, and refuse gates for
// out-of-range opcodes, lengths, and slot indices.
//
// Fingerprint: HCI CNVI OK

module HciCnviSynth = structure {

  pub let mut _hciw_stage : u64 = 0

  pub let hciw_ok   : [u8; 13] = "HCI CNVI OK\0"
  pub let hciw_fail : [u8; 15] = "HCI CNVI FAIL\0"

  pub let hciw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): reset transport state.",
      block: {
        call hci_reset;
        ret
      }
    }

  pub let hci_cnvi_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M1-001 (#1323): boot witness. Stages: (1) packet-type validator. (2) not-arbitrated by default. (3) CMD pack + unpack. (4) CMD BAD_OPCODE. (5) CMD BAD_LEN. (6) EVT pack + unpack. (7) EVT BAD_LEN. (8) ACL pack + unpack. (9) ACL BAD_HANDLE. (10) TX slot write refuses OOR. (11) TX slot write refuses invalid pkt type. (12) TX enqueue round-trip. (13) TX enqueue RING_FULL. (14) RX slot write CMD refused (host-only). (15) RX slot write EVT + dequeue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        call hciw_scrub;

        // -- 1. Packet-type validator.
        mov rdi, 0;
        call hci_pkt_type_valid;
        cmp rax, 0;
        jne hciw_fail_stage;
        mov rdi, 1;
        call hci_pkt_type_valid;
        cmp rax, 1;
        jne hciw_fail_stage;
        mov rdi, 4;
        call hci_pkt_type_valid;
        cmp rax, 1;
        jne hciw_fail_stage;
        mov rdi, 5;
        call hci_pkt_type_valid;
        cmp rax, 0;
        jne hciw_fail_stage;

        // -- 2. arbitrated == 0 at boot.
        mov rax, 2;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        call hci_arbitrated;
        cmp rax, 0;
        jne hciw_fail_stage;

        // -- 3. CMD pack + unpack.
        mov rax, 3;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C03;                 // RESET
        mov rsi, 10;
        call hci_cmd_pack;
        mov r15, rax;
        mov r11, 0xFFFFF128;
        cmp rax, r11;
        je  hciw_fail_stage;
        mov r11, 0xFFFFF12A;
        cmp rax, r11;
        je  hciw_fail_stage;

        // Type indicator should be CMD (0x01).
        mov rdi, r15;
        call hci_pkt_type_of;
        cmp rax, 1;
        jne hciw_fail_stage;

        mov rdi, r15;
        call hci_cmd_unpack_opcode;
        mov r11, 0x0C03;
        cmp rax, r11;
        jne hciw_fail_stage;

        mov rdi, r15;
        call hci_cmd_unpack_len;
        cmp rax, 10;
        jne hciw_fail_stage;

        // -- 4. CMD BAD_OPCODE (opcode > u16).
        mov rax, 4;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x10000;
        mov rsi, 0;
        call hci_cmd_pack;
        mov r11, 0xFFFFF128;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 5. CMD BAD_LEN (len > 255).
        mov rax, 5;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C03;
        mov rsi, 256;
        call hci_cmd_pack;
        mov r11, 0xFFFFF12A;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 6. EVT pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0E;                   // Command Complete
        mov rsi, 4;
        call hci_evt_pack;
        mov r15, rax;
        mov r11, 0xFFFFF126;
        cmp rax, r11;
        je  hciw_fail_stage;
        mov r11, 0xFFFFF12A;
        cmp rax, r11;
        je  hciw_fail_stage;

        mov rdi, r15;
        call hci_pkt_type_of;
        cmp rax, 4;                      // EVT
        jne hciw_fail_stage;

        mov rdi, r15;
        call hci_evt_unpack_code;
        cmp rax, 0x0E;
        jne hciw_fail_stage;

        mov rdi, r15;
        call hci_evt_unpack_len;
        cmp rax, 4;
        jne hciw_fail_stage;

        // -- 7. EVT BAD_LEN.
        mov rax, 7;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0E;
        mov rsi, 256;
        call hci_evt_pack;
        mov r11, 0xFFFFF12A;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 8. ACL pack + unpack.
        mov rax, 8;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0040;                 // conn_handle
        mov rsi, 27;
        call hci_acl_pack;
        mov r15, rax;
        mov r11, 0xFFFFF127;
        cmp rax, r11;
        je  hciw_fail_stage;

        // -- 9. ACL BAD_HANDLE (handle > 0x0FFF).
        mov rax, 9;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000;
        mov rsi, 0;
        call hci_acl_pack;
        mov r11, 0xFFFFF127;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 10. TX slot write refuses OOR slot.
        mov rax, 10;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 16;                     // OOR
        mov rsi, 0x01000000;             // CMD indicator
        mov rdx, 0;
        call hci_tx_slot_write;
        mov r11, 0xFFFFF12E;             // INDEX_OOR
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 11. TX slot write refuses invalid pkt type.
        mov rax, 11;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x00000000;             // no type indicator
        mov rdx, 0;
        call hci_tx_slot_write;
        mov r11, 0xFFFFF12B;             // BAD_PKT_TYPE
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 12. TX enqueue round-trip.
        mov rax, 12;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C03;                 // RESET
        mov rsi, 0;
        call hci_cmd_pack;
        mov r15, rax;

        mov rdi, r15;
        mov rsi, 0xDEADBEEF;
        call hci_tx_enqueue;
        cmp rax, 0;
        jne hciw_fail_stage;

        // tail should be 1 now.
        mov rdi, 1;                      // HCI_IDX_TX_TAIL
        call hci_index_get;
        cmp rax, 1;
        jne hciw_fail_stage;

        // Slot 0 word 0 should equal packed CMD.
        mov rdi, 0;
        mov rsi, 0;
        call hci_tx_slot_read;
        cmp rax, r15;
        jne hciw_fail_stage;

        // Slot 0 word 1 should equal param_word.
        mov rdi, 0;
        mov rsi, 1;
        call hci_tx_slot_read;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 13. TX enqueue RING_FULL after 15 more (total 16).
        mov rax, 13;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rbx, 15;
      hciw_fill:
        mov rdi, r15;
        mov rsi, 0;
        call hci_tx_enqueue;
        cmp rax, 0;
        jne hciw_fail_stage;
        sub rbx, 1;
        jnz hciw_fill;

        mov rdi, r15;
        mov rsi, 0;
        call hci_tx_enqueue;
        mov r11, 0xFFFFF12D;             // RING_FULL
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 14. RX slot write CMD refused (host-only).
        mov rax, 14;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x01000000;             // CMD indicator on RX
        mov rdx, 0;
        call hci_rx_slot_write;
        mov r11, 0xFFFFF12B;
        cmp rax, r11;
        jne hciw_fail_stage;

        // -- 15. RX slot write EVT + dequeue.
        mov rax, 15;
        lea rcx, [rip + _hciw_stage];
        mov [rcx], rax;

        // Pack an EVT.
        mov rdi, 0x0E;
        mov rsi, 4;
        call hci_evt_pack;
        mov r15, rax;

        // Advance tail so dequeue sees one entry (head=0, tail=1).
        mov rdi, 3;                      // HCI_IDX_RX_TAIL
        mov rsi, 1;
        call hci_index_set;
        cmp rax, 0;
        jne hciw_fail_stage;

        mov rdi, 0;
        mov rsi, r15;
        mov rdx, 0x11223344;
        call hci_rx_slot_write;
        cmp rax, 0;
        jne hciw_fail_stage;

        // Dequeue -- word 0 should match.
        call hci_rx_dequeue;
        cmp rax, r15;
        jne hciw_fail_stage;

        // Second dequeue -> empty.
        call hci_rx_dequeue;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hciw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hciw_ok];
        call klog_s1;

        call hciw_scrub;
        xor rax, rax;
        jmp hciw_out;

      hciw_fail_stage:
        lea rax, [rip + _hciw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hciw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hciw_scrub;
        mov rax, 1;

      hciw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
