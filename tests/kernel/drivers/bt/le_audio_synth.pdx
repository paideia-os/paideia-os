// tests/kernel/drivers/bt/le_audio_synth.pdx — R39.M6-003 (#1345)
//
// Boot witness for the LE Audio scaffolding (BAP/CAP).
//
// Drives leau_init, role_declare (unicast-server + broadcast-source),
// role/codec/rate/duration/direction validators, duplicate isoch slot
// refusal, LC3 frame contract with min/max bounds, and role_release.
//
// Fingerprint: LE AUDIO OK

module LeAudioSynth = structure {

  pub let mut _leauw_stage : u64 = 0

  pub let leauw_ok   : [u8; 14] = "LE AUDIO OK\n\0\0"
  pub let leauw_fail : [u8; 15] = "LE AUDIO FAIL\n\0"

  pub let leauw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): reset LE Audio role table + counters + init flag.",
      block: {
        call leau_reset;
        ret
      }
    }

  pub let le_audio_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M6-003 (#1345): boot witness. Stages: (1) validators. (2) uninit refuse. (3) init idempotent. (4) declare unicast-server + broadcast-source. (5) DUP_ROW refused. (6) BAD_ROLE refused. (7) BAD_CODEC refused. (8) BAD_RATE refused. (9) BAD_DURATION refused. (10) BAD_DIRECTION refused. (11) row-accessor round-trip. (12) LC3 frame contract happy path + min/max refusals. (13) release + counter check.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Validators.
        mov rax, 1;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call leau_role_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 4;
        call leau_role_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 5;
        call leau_role_valid;
        cmp rax, 0;
        jne leauw_fail_stage;
        mov rdi, 0;
        call leau_role_valid;
        cmp rax, 0;
        jne leauw_fail_stage;

        mov rdi, 0x06;
        call leau_codec_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 0xFF;
        call leau_codec_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 0x07;
        call leau_codec_valid;
        cmp rax, 0;
        jne leauw_fail_stage;

        mov rdi, 48000;
        call leau_rate_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 44100;
        call leau_rate_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 22050;
        call leau_rate_valid;
        cmp rax, 0;
        jne leauw_fail_stage;

        mov rdi, 10000;
        call leau_duration_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 7500;
        call leau_duration_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 5000;
        call leau_duration_valid;
        cmp rax, 0;
        jne leauw_fail_stage;

        mov rdi, 0;
        call leau_direction_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 1;
        call leau_direction_valid;
        cmp rax, 1;
        jne leauw_fail_stage;
        mov rdi, 2;
        call leau_direction_valid;
        cmp rax, 0;
        jne leauw_fail_stage;

        // -- 2. Uninit refuse.  leau_role_declare must return
        // NOT_INITIALIZED (0xFFFFF276) before leau_init.
        mov rax, 2;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        call leauw_scrub;

        mov rdi, 1;                                  // UNICAST_SERVER
        mov rsi, 0x06;                               // LC3
        mov rdx, 20;                                 // isoch_slot
        mov rcx, 48000;
        mov r8,  10000;
        mov r9,  0;                                  // SINK
        call leau_role_declare;
        mov r11, 0xFFFFF276;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 3. init idempotent.
        mov rax, 3;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        call leau_init;
        cmp rax, 0;
        jne leauw_fail_stage;
        call leau_init;
        cmp rax, 0;
        jne leauw_fail_stage;

        // -- 4. Declare unicast-server + broadcast-source.
        mov rax, 4;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;                                  // UNICAST_SERVER
        mov rsi, 0x06;                               // LC3
        mov rdx, 20;                                 // isoch_slot
        mov rcx, 48000;
        mov r8,  10000;
        mov r9,  0;                                  // SINK
        call leau_role_declare;
        mov r11, 0xFFFFF270;
        cmp rax, r11;
        jae leauw_fail_stage;
        mov r12, rax;                                // unicast row

        mov rdi, 3;                                  // BROADCAST_SOURCE
        mov rsi, 0x06;                               // LC3
        mov rdx, 21;                                 // different isoch_slot
        mov rcx, 24000;
        mov r8,  7500;
        mov r9,  1;                                  // SOURCE
        call leau_role_declare;
        mov r11, 0xFFFFF270;
        cmp rax, r11;
        jae leauw_fail_stage;
        mov r13, rax;                                // broadcast row

        // -- 5. Duplicate isoch_slot refused (DUP_ROW 0xFFFFF275).
        mov rax, 5;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 2;                                  // UNICAST_CLIENT
        mov rsi, 0x06;
        mov rdx, 20;                                 // dup isoch_slot
        mov rcx, 16000;
        mov r8,  10000;
        mov r9,  1;
        call leau_role_declare;
        mov r11, 0xFFFFF275;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 6. BAD_ROLE (0xFFFFF27D).
        mov rax, 6;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 9;                                  // out-of-range role
        mov rsi, 0x06;
        mov rdx, 25;
        mov rcx, 48000;
        mov r8,  10000;
        mov r9,  0;
        call leau_role_declare;
        mov r11, 0xFFFFF27D;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 7. BAD_CODEC (0xFFFFF27C).
        mov rax, 7;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x07;                               // not LC3 nor VENDOR
        mov rdx, 25;
        mov rcx, 48000;
        mov r8,  10000;
        mov r9,  0;
        call leau_role_declare;
        mov r11, 0xFFFFF27C;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 8. BAD_RATE (0xFFFFF27B).
        mov rax, 8;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x06;
        mov rdx, 25;
        mov rcx, 22050;                              // invalid LC3 rate
        mov r8,  10000;
        mov r9,  0;
        call leau_role_declare;
        mov r11, 0xFFFFF27B;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 9. BAD_DURATION (0xFFFFF27A).
        mov rax, 9;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x06;
        mov rdx, 25;
        mov rcx, 48000;
        mov r8,  5000;                               // invalid
        mov r9,  0;
        call leau_role_declare;
        mov r11, 0xFFFFF27A;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 10. BAD_DIRECTION (0xFFFFF279).
        mov rax, 10;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x06;
        mov rdx, 25;
        mov rcx, 48000;
        mov r8,  10000;
        mov r9,  4;                                  // invalid direction
        call leau_role_declare;
        mov r11, 0xFFFFF279;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 11. Row-accessor round-trip on r12.
        mov rax, 11;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call leau_row_role;
        cmp rax, 1;                                  // UNICAST_SERVER
        jne leauw_fail_stage;

        mov rdi, r12;
        call leau_row_codec;
        cmp rax, 0x06;                               // LC3
        jne leauw_fail_stage;

        mov rdi, r12;
        call leau_row_isoch;
        cmp rax, 20;
        jne leauw_fail_stage;

        mov rdi, r12;
        call leau_row_rate;
        cmp rax, 48000;
        jne leauw_fail_stage;

        mov rdi, r13;
        call leau_row_role;
        cmp rax, 3;                                  // BROADCAST_SOURCE
        jne leauw_fail_stage;

        // -- 12. LC3 frame contract.
        mov rax, 12;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 60;                                 // typical LC3 payload
        call leau_isoch_frame;
        cmp rax, 0;
        jne leauw_fail_stage;

        // Below min (15) -> BAD_FRAME 0xFFFFF273.
        mov rdi, r12;
        mov rsi, 10;
        call leau_isoch_frame;
        mov r11, 0xFFFFF273;
        cmp rax, r11;
        jne leauw_fail_stage;

        // Above max (200) -> BAD_FRAME.
        mov rdi, r13;
        mov rsi, 400;
        call leau_isoch_frame;
        mov r11, 0xFFFFF273;
        cmp rax, r11;
        jne leauw_fail_stage;

        // Unbound row -> BAD_ROW 0xFFFFF27E.
        mov rdi, 3;                                  // free row
        mov rsi, 60;
        call leau_isoch_frame;
        mov r11, 0xFFFFF27E;
        cmp rax, r11;
        jne leauw_fail_stage;

        // -- 13. Release + counter check.
        mov rax, 13;
        lea rcx, [rip + _leauw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call leau_role_release;
        cmp rax, 0;
        jne leauw_fail_stage;
        mov rdi, r13;
        call leau_role_release;
        cmp rax, 0;
        jne leauw_fail_stage;

        mov rdi, 1;                                  // RELEASES counter
        call leau_stat;
        cmp rax, 2;
        jne leauw_fail_stage;

        // Release on released row -> BAD_ROW.
        mov rdi, r12;
        call leau_role_release;
        mov r11, 0xFFFFF27E;
        cmp rax, r11;
        jne leauw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + leauw_ok];
        call klog_s1;

        call leauw_scrub;
        xor rax, rax;
        jmp leauw_out;

      leauw_fail_stage:
        lea rax, [rip + _leauw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + leauw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call leauw_scrub;
        mov rax, 1;

      leauw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
