// tests/kernel/drivers/bt/a2dp_synth.pdx — R39.M5-001 (#1339)
//
// Boot witness for the A2DP profile.
//
// Drives a2dp_init, sep_declare (SBC + AAC), duplicate refusal,
// discover bitmask, get_capabilities, set_configuration success + subset
// refusal, the FSM path CONFIGURED -> OPEN -> STREAMING -> OPEN
// (suspend) -> CLOSING (close), and asserts BAD_STATE on illegal edges.
//
// Fingerprint: R39 A2DP OK

module A2dpSynth = structure {

  pub let mut _a2dpw_stage : u64 = 0

  pub let a2dpw_ok   : [u8; 14] = "R39 A2DP OK\n\0\0"
  pub let a2dpw_fail : [u8; 15] = "R39 A2DP FAIL\n\0"

  pub let a2dpw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): reset SEP table + counters + init flag.",
      block: {
        call a2dp_reset;
        ret
      }
    }

  pub let a2dp_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M5-001 (#1339): boot witness. Stages: (1) validators. (2) init idempotent. (3) declare SBC + AAC. (4) declare duplicate SBC refused (DUP_CODEC). (5) discover bitmask. (6) get_capabilities returns codec. (7) set_configuration happy path (SBC). (8) set_configuration BAD_SAMPLE_RATE for non-subset. (9) set_configuration BAD_CHANNEL_MODE for non-subset. (10) open + start + suspend + open + close chain. (11) illegal start on CONFIGURED refused (BAD_STATE). (12) close on IDLE refused (BAD_SEP after release).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Validators.
        mov rax, 1;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call a2dp_codec_valid;
        cmp rax, 1;
        jne a2dpw_fail_stage;
        mov rdi, 2;
        call a2dp_codec_valid;
        cmp rax, 1;
        jne a2dpw_fail_stage;
        mov rdi, 1;
        call a2dp_codec_valid;
        cmp rax, 0;
        jne a2dpw_fail_stage;
        mov rdi, 4;
        call a2dp_codec_valid;
        cmp rax, 0;
        jne a2dpw_fail_stage;

        mov rdi, 0;
        call a2dp_media_valid;
        cmp rax, 1;
        jne a2dpw_fail_stage;
        mov rdi, 1;
        call a2dp_media_valid;
        cmp rax, 0;
        jne a2dpw_fail_stage;

        mov rdi, 3;
        call a2dp_verb_valid;
        cmp rax, 1;
        jne a2dpw_fail_stage;
        mov rdi, 4;
        call a2dp_verb_valid;
        cmp rax, 0;
        jne a2dpw_fail_stage;                        // 4 is not a legal verb

        // -- 2. init idempotent.
        mov rax, 2;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        call a2dpw_scrub;
        call a2dp_init;
        cmp rax, 0;
        jne a2dpw_fail_stage;
        call a2dp_init;
        cmp rax, 0;
        jne a2dpw_fail_stage;

        // -- 3. Declare SBC + AAC.
        mov rax, 3;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, 0;                                  // SBC
        mov rsi, 0;                                  // AUDIO
        mov rdx, 0x03;                               // 48000+44100
        mov rcx, 0x03;                               // JS+STEREO
        call a2dp_sep_declare;
        // Failure guard: any 0xFFFFF2Cx return is a fail.
        mov r11, 0xFFFFF2C0;
        cmp rax, r11;
        jae a2dpw_fail_stage;
        mov r12, rax;                                // sep_sbc

        mov rdi, 2;                                  // AAC
        mov rsi, 0;                                  // AUDIO
        mov rdx, 0x0100;                             // AAC SR 48000
        mov rcx, 0x02;                               // AAC CH 2
        call a2dp_sep_declare;
        mov r11, 0xFFFFF2C0;
        cmp rax, r11;
        jae a2dpw_fail_stage;
        mov r13, rax;                                // sep_aac

        // -- 4. Duplicate SBC refused (DUP_CODEC = 0xFFFFF2C2).
        mov rax, 4;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0x03;
        mov rcx, 0x03;
        call a2dp_sep_declare;
        mov r11, 0xFFFFF2C2;
        cmp rax, r11;
        jne a2dpw_fail_stage;

        // -- 5. Discover bitmask -- must have bits r12 and r13 set.
        mov rax, 5;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        call a2dp_discover;
        mov r14, rax;
        // Bit for sep_sbc.
        mov r11, 1;
        mov rcx, r12;
        shl r11, cl;
        mov rax, r14;
        and rax, r11;
        cmp rax, 0;
        je  a2dpw_fail_stage;
        // Bit for sep_aac.
        mov r11, 1;
        mov rcx, r13;
        shl r11, cl;
        mov rax, r14;
        and rax, r11;
        cmp rax, 0;
        je  a2dpw_fail_stage;

        // -- 6. get_capabilities returns codec type.
        mov rax, 6;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call a2dp_get_capabilities;
        cmp rax, 0;                                  // SBC == 0
        jne a2dpw_fail_stage;

        mov rdi, r13;
        call a2dp_get_capabilities;
        cmp rax, 2;                                  // AAC == 2
        jne a2dpw_fail_stage;

        // -- 7. set_configuration on SBC: pick 44100 + STEREO.
        mov rax, 7;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 0x02;                               // 44100
        mov rdx, 0x02;                               // STEREO
        call a2dp_set_configuration;
        cmp rax, 0;
        jne a2dpw_fail_stage;

        // Confirm state == CONFIGURED (1).
        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, 1;
        jne a2dpw_fail_stage;

        // Confirm the latch: cfg_sample_rate == 0x02.
        mov rdi, r12;
        call a2dp_sep_cfg_sample_rate;
        cmp rax, 2;
        jne a2dpw_fail_stage;

        // -- 8. set_configuration BAD_SAMPLE_RATE for non-subset.
        mov rax, 8;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        // sep_aac has cap_sr = 0x0100 only.  Ask for 0x0200 -> not
        // a subset -> BAD_SAMPLE_RATE (0xFFFFF2C7).
        mov rdi, r13;
        mov rsi, 0x0200;
        mov rdx, 0x02;
        call a2dp_set_configuration;
        mov r11, 0xFFFFF2C7;
        cmp rax, r11;
        jne a2dpw_fail_stage;

        // -- 9. set_configuration BAD_CHANNEL_MODE for non-subset.
        mov rax, 9;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        // sep_aac cap_cm = 0x02 (CH_2 only).  Ask for CH_1 (0x01) ->
        // BAD_CHANNEL_MODE (0xFFFFF2C6).
        mov rdi, r13;
        mov rsi, 0x0100;
        mov rdx, 0x01;
        call a2dp_set_configuration;
        mov r11, 0xFFFFF2C6;
        cmp rax, r11;
        jne a2dpw_fail_stage;

        // -- 10. open/start/suspend/open/close FSM chain on sep_sbc.
        mov rax, 10;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call a2dp_open;
        cmp rax, 0;
        jne a2dpw_fail_stage;
        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, 2;                                  // OPEN
        jne a2dpw_fail_stage;

        mov rdi, r12;
        call a2dp_start;
        cmp rax, 0;
        jne a2dpw_fail_stage;
        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, 3;                                  // STREAMING
        jne a2dpw_fail_stage;

        mov rdi, r12;
        call a2dp_suspend;
        cmp rax, 0;
        jne a2dpw_fail_stage;
        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, 2;                                  // OPEN
        jne a2dpw_fail_stage;

        // -- 11. Illegal start on sep_aac (still IDLE, no config) ->
        // BAD_STATE (0xFFFFF2C9).
        mov rax, 11;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call a2dp_start;
        mov r11, 0xFFFFF2C9;
        cmp rax, r11;
        jne a2dpw_fail_stage;

        // Close sep_sbc; the row is released.
        mov rdi, r12;
        call a2dp_close;
        cmp rax, 0;
        jne a2dpw_fail_stage;

        // -- 12. Close on released row -> BAD_SEP (0xFFFFF2CE).
        mov rax, 12;
        lea rcx, [rip + _a2dpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call a2dp_close;
        mov r11, 0xFFFFF2CE;
        cmp rax, r11;
        jne a2dpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2dpw_ok];
        call klog_s1;

        call a2dpw_scrub;
        xor rax, rax;
        jmp a2dpw_out;

      a2dpw_fail_stage:
        lea rax, [rip + _a2dpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2dpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call a2dpw_scrub;
        mov rax, 1;

      a2dpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
