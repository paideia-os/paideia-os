// tests/kernel/drivers/bt/a2dp_rtx_synth.pdx — R39.M5-003 (#1341)
//
// Boot witness for the A2DP retransmission + resync policy.
//
// Drives a2rtx_init, install (per SEP), duplicate refusal, loss counter
// + EXCEEDED at the ceiling, drift check below threshold (OK), above
// threshold (UNDERRUN_DRAIN + resync_req latched), clear_resync,
// underrun cap, release.
//
// Fingerprint: A2DP RTX OK

module A2dpRtxSynth = structure {

  pub let mut _a2rtxw_stage : u64 = 0

  pub let a2rtxw_ok   : [u8; 14] = "A2DP RTX OK\n\0\0"
  pub let a2rtxw_fail : [u8; 15] = "A2DP RTX FAIL\0"

  pub let a2rtxw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-003 (#1341): reset retx table + counters + init flag.",
      block: {
        call a2rtx_reset;
        ret
      }
    }

  pub let a2rtx_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M5-003 (#1341): boot witness. Stages: (1) uninit refuse. (2) init + install per SEP. (3) duplicate install refused (ROW_IN_USE). (4) loss counter + EXCEEDED ceiling. (5) drift below threshold latches epoch. (6) drift above threshold returns UNDERRUN_DRAIN + resync_req set. (7) clear_resync clears bit. (8) underrun path returns DRAIN below cap, CAPPED above. (9) release.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        call a2rtxw_scrub;

        // -- 1. install without init -> NOT_INITIALIZED (0xFFFFF2A5).
        mov rax, 1;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call a2rtx_install;
        mov r11, 0xFFFFF2A5;
        cmp rax, r11;
        jne a2rtxw_fail_stage;

        // -- 2. init + install two rows.
        mov rax, 2;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        call a2rtx_init;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        mov rdi, 10;
        call a2rtx_install;
        mov r11, 0xFFFFF2A0;
        cmp rax, r11;
        jae a2rtxw_fail_stage;
        mov r12, rax;

        mov rdi, 11;
        call a2rtx_install;
        mov r11, 0xFFFFF2A0;
        cmp rax, r11;
        jae a2rtxw_fail_stage;
        mov r13, rax;

        // -- 3. Duplicate SEP refused (ROW_IN_USE = 0xFFFFF2AB).
        mov rax, 3;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call a2rtx_install;
        mov r11, 0xFFFFF2AB;
        cmp rax, r11;
        jne a2rtxw_fail_stage;

        // -- 4. Loss counter, then EXCEEDED at the ceiling.
        mov rax, 4;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        // Ceiling = 8; nine losses should get us EXCEEDED on the 9th.
        // First eight must return 0.
        mov rbx, 0;
      a2rtxw_loss_loop:
        cmp rbx, 8;
        jae a2rtxw_loss_done;
        mov rdi, r12;
        call a2rtx_note_loss;
        cmp rax, 0;
        jne a2rtxw_fail_stage;
        add rbx, 1;
        jmp a2rtxw_loss_loop;
      a2rtxw_loss_done:
        // Ninth loss -> EXCEEDED (0xFFFFF2AA).
        mov rdi, r12;
        call a2rtx_note_loss;
        mov r11, 0xFFFFF2AA;
        cmp rax, r11;
        jne a2rtxw_fail_stage;

        // -- 5. Drift below threshold: latch epoch.
        mov rax, 5;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        // First observation: last==0 -> just latch (returns 0).
        mov rdi, r13;
        mov rsi, 1000;
        call a2rtx_check_drift;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        // Second observation 1256 samples later (< 1024 is 500, not
        // > 1024).  Use 1500 -> drift=500 -> OK.
        mov rdi, r13;
        mov rsi, 1500;
        call a2rtx_check_drift;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        // -- 6. Drift above threshold -> UNDERRUN_DRAIN + resync_req.
        mov rax, 6;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        // Last was 1500; jump to 5000 -> drift=3500 > 1024 -> DRAIN.
        mov rdi, r13;
        mov rsi, 5000;
        call a2rtx_check_drift;
        mov r11, 0xFFFFF2A9;
        cmp rax, r11;
        jne a2rtxw_fail_stage;

        mov rdi, r13;
        call a2rtx_row_resync_req;
        cmp rax, 1;
        jne a2rtxw_fail_stage;

        // -- 7. clear_resync clears bit.
        mov rax, 7;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call a2rtx_clear_resync;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        mov rdi, r13;
        call a2rtx_row_resync_req;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        // -- 8. Underrun path.
        mov rax, 8;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        // First underrun: returns DRAIN (0xFFFFF2A9).  Repeat up to
        // A2RTX_UNDERRUN_MAX-1 to still get DRAIN.  Then at MAX return
        // CAPPED (0xFFFFF2A8).
        mov rbx, 0;
      a2rtxw_ur_loop:
        cmp rbx, 15;                    // A2RTX_UNDERRUN_MAX - 1
        jae a2rtxw_ur_check_cap;
        mov rdi, r13;
        call a2rtx_note_underrun;
        mov r11, 0xFFFFF2A9;
        cmp rax, r11;
        jne a2rtxw_fail_stage;
        add rbx, 1;
        jmp a2rtxw_ur_loop;
      a2rtxw_ur_check_cap:
        mov rdi, r13;
        call a2rtx_note_underrun;
        mov r11, 0xFFFFF2A8;
        cmp rax, r11;
        jne a2rtxw_fail_stage;

        // -- 9. Release.
        mov rax, 9;
        lea rcx, [rip + _a2rtxw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call a2rtx_release;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        mov rdi, r13;
        call a2rtx_release;
        cmp rax, 0;
        jne a2rtxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2rtxw_ok];
        call klog_s1;

        call a2rtxw_scrub;
        xor rax, rax;
        jmp a2rtxw_out;

      a2rtxw_fail_stage:
        lea rax, [rip + _a2rtxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2rtxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call a2rtxw_scrub;
        mov rax, 1;

      a2rtxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
