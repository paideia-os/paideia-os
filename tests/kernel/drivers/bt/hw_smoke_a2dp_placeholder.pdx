// tests/kernel/drivers/bt/hw_smoke_a2dp_placeholder.pdx — R39.M5-004 (#1342)
//
// Dormant HW-smoke placeholder for the BT A2DP profile + audio bridge.
//
// Per design decision D7 (`gated:hardware`), this witness stays dormant
// in the smoke matrix until a real T14 G4 machine with an Intel AX211
// CNVi controller AND a real A2DP-capable peer (BT headphones or a
// speaker) is present.  Enabling it requires:
//   - a live BT controller reachable through the R39.M2 HCI transport,
//   - an A2DP peer paired via R39.M4 (KIND_BT_PAIRING) that advertises
//     an SBC-sink or AAC-sink SEP,
//   - the R33 audio graph in a bound-slot state so a KIND_PCM_STREAM
//     row exists for the bridge to attach to.
//
// The procedure for hardware bring-up is documented in
// tools/hw-smoke-r39-a2dp.md.  Until then this placeholder returns 0
// unconditionally so the smoke matrix reports GREEN without pretending
// a bring-up ran.

module HwSmokeA2dpPlaceholder = structure {

  pub let hw_smoke_a2dp_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-004 (#1342): dormant HW-smoke per D7 gated:hardware.  Returns 0 unconditionally until a real BT controller + A2DP peer is present.  See tools/hw-smoke-r39-a2dp.md.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
