// tests/kernel/drivers/bt/att_synth.pdx — R39.M3-001 (#1331)
//
// Boot witness for the ATT (Attribute Protocol) codec + server-side
// dispatcher over the R39.M3-002 gatt.pdx attribute database.
//
// Stages:
//   (1)  init + defaults (MTU=23, counters zeroed).
//   (2)  att_opcode extractor.
//   (3)  att_set_mtu refuse (< 23 -> BAD_MTU; clamp > 517 -> 517).
//   (4)  Error Response pack + unpack round-trip.
//   (5)  Exchange MTU Req/Rsp pack + unpack round-trip; opcode mismatch
//        on the wrong unpacker returns ATT_BAD_OPCODE.
//   (6)  Find Info Req pack + unpack + start > end refuse.
//   (7)  Find Info Rsp (format 0x01) pack + unpack (format, handle, uuid).
//   (8)  Write Rsp pack + unpack.
//   (9)  Server dispatch: Exchange MTU Request negotiates MTU up to 100
//        and returns Exch MTU Response carrying 100.
//   (10) Server dispatch: Read Req on a live attribute returns Read Rsp
//        with the value; on a missing handle returns Error(INVALID_HANDLE);
//        on a write-only attribute returns Error(READ_NOT_PERM).
//   (11) Server dispatch: Write Req on a live attribute returns Write Rsp
//        and the stored value updates; on a missing handle returns
//        Error(INVALID_HANDLE); on a read-only attribute returns
//        Error(WRITE_NOT_PERM).
//   (12) Server dispatch: unknown opcode returns Error(REQ_NOT_SUPP)
//        carrying the original opcode.
//
// Fingerprint: R39 ATT OK

module AttSynth = structure {

  pub let mut _attw_stage : u64 = 0

  pub let attw_ok   : [u8; 12] = "R39 ATT OK\n\0"
  pub let attw_fail : [u8; 14] = "R39 ATT FAIL\n\0"

  pub let attw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-001 (#1331): reset ATT + GATT state to a known baseline.",
      block: {
        call att_init;
        call gatt_reset;
        ret
      }
    }

  // Seed the GATT database with three attributes:
  //   0x0010  UUID 0x2A00, perm READ|WRITE, value 0xCAFE
  //   0x0020  UUID 0x2A01, perm WRITE only, value 0x1234
  //   0x0030  UUID 0x2A02, perm READ only,  value 0xBEEF
  pub let attw_seed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-001 (#1331): install three attributes for dispatch tests.",
      block: {
        push r12;

        mov rdi, 0x0010;
        mov rsi, 0x2A00;
        mov rdx, 0x03;                   // READ|WRITE
        mov rcx, 0xCAFE;
        call gatt_attr_insert;
        cmp rax, 16;
        jae attw_seed_fail;

        mov rdi, 0x0020;
        mov rsi, 0x2A01;
        mov rdx, 0x02;                   // WRITE only
        mov rcx, 0x1234;
        call gatt_attr_insert;
        cmp rax, 16;
        jae attw_seed_fail;

        mov rdi, 0x0030;
        mov rsi, 0x2A02;
        mov rdx, 0x01;                   // READ only
        mov rcx, 0xBEEF;
        call gatt_attr_insert;
        cmp rax, 16;
        jae attw_seed_fail;

        xor rax, rax;
        jmp attw_seed_out;
      attw_seed_fail:
        mov rax, 1;
      attw_seed_out:
        pop r12;
        ret
      }
    }

  pub let att_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M3-001 (#1331): ATT protocol boot witness. Exercises codec + server dispatch against a seeded GATT database.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. init + defaults.
        mov rax, 1;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        call attw_scrub;

        call att_mtu;
        cmp rax, 23;
        jne attw_fail_stage;

        mov rdi, 0;                      // ATT_ST_REQS
        call att_stat;
        cmp rax, 0;
        jne attw_fail_stage;

        // -- 2. opcode extractor.
        mov rax, 2;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234567890AB0002;
        call att_opcode;
        cmp rax, 0x02;
        jne attw_fail_stage;

        mov rdi, 0;
        call att_opcode;
        cmp rax, 0;
        jne attw_fail_stage;

        // -- 3. att_set_mtu boundaries.
        mov rax, 3;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 22;
        call att_set_mtu;
        mov r11, 0xFFFFF0CC;             // ATT_BAD_MTU
        cmp rax, r11;
        jne attw_fail_stage;

        mov rdi, 100;
        call att_set_mtu;
        cmp rax, 100;
        jne attw_fail_stage;
        call att_mtu;
        cmp rax, 100;
        jne attw_fail_stage;

        mov rdi, 1024;
        call att_set_mtu;
        cmp rax, 517;                    // clamped
        jne attw_fail_stage;
        call att_mtu;
        cmp rax, 517;
        jne attw_fail_stage;

        // Reset MTU for later dispatch tests.
        call attw_scrub;

        // -- 4. Error Response round-trip.
        mov rax, 4;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 0x0A;                   // req_op = READ_REQ
        mov rsi, 0x1234;                 // handle
        mov rdx, 0x01;                   // ATT_ERR_INVALID_HANDLE
        call att_pack_error_rsp;
        mov r12, rax;
        mov r13, rax;
        and r13, 0xFF;
        cmp r13, 0x01;                   // opcode byte = 0x01
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_error_op;
        cmp rax, 0x0A;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_error_handle;
        cmp rax, 0x1234;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_error_code;
        cmp rax, 0x01;
        jne attw_fail_stage;

        // Opcode-mismatched unpack must refuse.
        mov rdi, 0x02;                   // not an Error Response
        call att_unpack_error_op;
        mov r11, 0xFFFFF0CE;             // ATT_BAD_OPCODE
        cmp rax, r11;
        jne attw_fail_stage;

        // Pack refuses out-of-range fields.
        mov rdi, 0x100;                  // req_op > u8
        mov rsi, 0;
        mov rdx, 0;
        call att_pack_error_rsp;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne attw_fail_stage;

        // -- 5. Exchange MTU Req/Rsp round-trip.
        mov rax, 5;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 185;
        call att_pack_exch_mtu_req;
        mov r12, rax;
        mov r13, rax;
        and r13, 0xFF;
        cmp r13, 0x02;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_exch_mtu_req;
        cmp rax, 185;
        jne attw_fail_stage;

        // Wrong unpacker refuses.
        mov rdi, r12;
        call att_unpack_exch_mtu_rsp;
        mov r11, 0xFFFFF0CE;
        cmp rax, r11;
        jne attw_fail_stage;

        mov rdi, 517;
        call att_pack_exch_mtu_rsp;
        mov r12, rax;
        mov r13, rax;
        and r13, 0xFF;
        cmp r13, 0x03;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_exch_mtu_rsp;
        cmp rax, 517;
        jne attw_fail_stage;

        // Pack refuses > u16.
        mov rdi, 0x10000;
        call att_pack_exch_mtu_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne attw_fail_stage;

        // -- 6. Find Info Req pack + unpack + refuse.
        mov rax, 6;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 0x0001;
        mov rsi, 0xFFFF;
        call att_pack_find_info_req;
        mov r12, rax;
        mov r13, rax;
        and r13, 0xFF;
        cmp r13, 0x04;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_find_info_start;
        cmp rax, 0x0001;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_find_info_end;
        cmp rax, 0xFFFF;
        jne attw_fail_stage;

        // start > end refuses.
        mov rdi, 0x0010;
        mov rsi, 0x0001;
        call att_pack_find_info_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne attw_fail_stage;

        // handle = 0 refuses.
        mov rdi, 0;
        mov rsi, 0x0010;
        call att_pack_find_info_req;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne attw_fail_stage;

        // -- 7. Find Info Rsp (format 0x01) pack + unpack.
        mov rax, 7;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 0x0010;
        mov rsi, 0x2A00;
        call att_pack_find_info_rsp_16;
        mov r12, rax;
        mov r13, rax;
        and r13, 0xFF;
        cmp r13, 0x05;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_find_info_rsp_format;
        cmp rax, 0x01;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_find_info_rsp_handle;
        cmp rax, 0x0010;
        jne attw_fail_stage;

        mov rdi, r12;
        call att_unpack_find_info_rsp_uuid;
        cmp rax, 0x2A00;
        jne attw_fail_stage;

        // -- 8. Write Rsp pack + unpack.
        mov rax, 8;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        call att_pack_write_rsp;
        cmp rax, 0x13;
        jne attw_fail_stage;

        mov rdi, 0x13;
        call att_unpack_write_rsp;
        cmp rax, 0;
        jne attw_fail_stage;

        mov rdi, 0x14;                   // wrong opcode
        call att_unpack_write_rsp;
        mov r11, 0xFFFFF0CE;
        cmp rax, r11;
        jne attw_fail_stage;

        // -- 9. Server dispatch: Exchange MTU.
        mov rax, 9;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        call attw_scrub;

        mov rdi, 100;
        call att_pack_exch_mtu_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        // Response is an Exchange MTU Response.
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x03;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_exch_mtu_rsp;
        cmp rax, 100;
        jne attw_fail_stage;
        call att_mtu;
        cmp rax, 100;
        jne attw_fail_stage;

        // -- 10. Server dispatch: Read.
        mov rax, 10;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        call attw_scrub;
        call attw_seed;
        cmp rax, 0;
        jne attw_fail_stage;

        // 10a. Read a live handle -> Read Rsp with value.
        mov rdi, 0x0010;
        call gatt_pack_read_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x0B;                   // READ_RSP
        jne attw_fail_stage;
        mov rdi, r13;
        call gatt_unpack_read_rsp;
        mov r11, 0xCAFE;
        cmp rax, r11;
        jne attw_fail_stage;

        // 10b. Read a missing handle -> Error(INVALID_HANDLE).
        mov rdi, 0x00FF;
        call gatt_pack_read_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x01;                   // ERROR_RSP
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_op;
        cmp rax, 0x0A;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_handle;
        cmp rax, 0x00FF;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_code;
        cmp rax, 0x01;                   // INVALID_HANDLE
        jne attw_fail_stage;

        // 10c. Read a WRITE-only handle -> Error(READ_NOT_PERM).
        mov rdi, 0x0020;
        call gatt_pack_read_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x01;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_code;
        cmp rax, 0x02;                   // READ_NOT_PERM
        jne attw_fail_stage;

        // -- 11. Server dispatch: Write.
        mov rax, 11;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        // 11a. Write a writable handle -> Write Rsp; value updates.
        mov rdi, 0x0010;
        mov rsi, 0x9999;
        call gatt_pack_write_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        cmp rax, 0x13;                   // WRITE_RSP (payload-less)
        jne attw_fail_stage;

        mov rdi, 0x0010;
        call gatt_read;
        mov r11, 0x9999;
        cmp rax, r11;
        jne attw_fail_stage;

        // 11b. Write a missing handle -> Error(INVALID_HANDLE).
        mov rdi, 0x00FF;
        mov rsi, 0x1;
        call gatt_pack_write_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x01;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_op;
        cmp rax, 0x12;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_code;
        cmp rax, 0x01;
        jne attw_fail_stage;

        // 11c. Write a READ-only handle -> Error(WRITE_NOT_PERM).
        mov rdi, 0x0030;
        mov rsi, 0x5555;
        call gatt_pack_write_req;
        mov r12, rax;
        mov rdi, r12;
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x01;
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_code;
        cmp rax, 0x03;                   // WRITE_NOT_PERM
        jne attw_fail_stage;

        // -- 12. Server dispatch: unknown opcode.
        mov rax, 12;
        lea rcx, [rip + _attw_stage];
        mov [rcx], rax;

        mov rdi, 0xFF;                   // reserved opcode
        call att_server_dispatch;
        mov r13, rax;
        mov r14, r13;
        and r14, 0xFF;
        cmp r14, 0x01;                   // ERROR_RSP
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_op;
        cmp rax, 0xFF;                   // preserved original opcode
        jne attw_fail_stage;
        mov rdi, r13;
        call att_unpack_error_code;
        cmp rax, 0x06;                   // REQ_NOT_SUPP
        jne attw_fail_stage;

        // -- PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + attw_ok];
        call klog_s1;

        call attw_scrub;
        xor rax, rax;
        jmp attw_out;

      attw_fail_stage:
        lea rax, [rip + _attw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + attw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call attw_scrub;
        mov rax, 1;

      attw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
