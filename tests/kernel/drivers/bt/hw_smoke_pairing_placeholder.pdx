// tests/kernel/drivers/bt/hw_smoke_pairing_placeholder.pdx — R39.M4-004 (#1338)
//
// Dormant HW-smoke placeholder for BT LE Secure Connections pairing.
//
// Per design decision D7 (`gated:hardware`), this witness stays dormant
// in the smoke matrix until a real T14 G4 BT controller (Intel AX211
// CNVi) is present.  Enabling it requires:
//   - a live BT controller reachable through the R39.M2 HCI transport,
//   - a test peer device with predictable pairing state,
//   - the R32 crypto server available to unseal LTK bytes.
//
// The procedure for hardware bring-up is documented in
// tools/hw-smoke-r39-pairing.md.  Until then this placeholder returns
// 0 unconditionally so the smoke matrix reports GREEN without pretending
// a bring-up ran.

module HwSmokePairingPlaceholder = structure {

  pub let hw_smoke_pairing_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-004 (#1338): dormant HW-smoke per D7 gated:hardware.  Returns 0 unconditionally until real BT controller is present.  See tools/hw-smoke-r39-pairing.md.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
