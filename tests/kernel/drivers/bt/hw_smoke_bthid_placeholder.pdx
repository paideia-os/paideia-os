// tests/kernel/drivers/bt/hw_smoke_bthid_placeholder.pdx — R39.M6-004 (#1346)
//
// Dormant HW-smoke placeholder for BT HID keystroke latency assertion.
//
// Per design decision D7 (`gated:hardware`), this witness stays dormant
// in the smoke matrix until a real T14 G4 machine with an Intel AX211
// CNVi controller AND a real BT-attached keyboard is present.  Enabling
// it requires:
//   - a live BT controller reachable through the R39.M2 HCI transport,
//   - a BT HID keyboard paired via R39.M4 (KIND_BT_PAIRING) that
//     advertises the HID service (SDP class 0x1124),
//   - the R32 HID event stream (KIND_HID_EVENT) bound to a listening
//     subscriber, so the fixture can assert delivery latency.
//
// The procedure for hardware bring-up is documented in
// tools/hw-smoke-r39-bthid.md.  Until then this placeholder returns 0
// unconditionally so the smoke matrix reports GREEN without pretending
// a bring-up ran.

module HwSmokeBthidPlaceholder = structure {

  pub let hw_smoke_bthid_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-004 (#1346): dormant HW-smoke per D7 gated:hardware.  Returns 0 unconditionally until a real BT controller + BT HID keyboard is present.  See tools/hw-smoke-r39-bthid.md.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
