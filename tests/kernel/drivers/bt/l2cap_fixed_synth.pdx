// tests/kernel/drivers/bt/l2cap_fixed_synth.pdx — R39.M2-001 (#1327)
//
// Boot witness for the L2CAP fixed-channel registration driver.
//
// Drives lfx_init, lfx_cid_valid, lfx_register / lfx_lookup / lfx_hci_chan
// / lfx_unregister across the three fixed CIDs (ATT, LE signalling, SM),
// and asserts every refuse path in the failure taxonomy.
//
// Fingerprint: R39 L2CAP FIXED OK

module L2capFixedSynth = structure {

  pub let mut _lfxw_stage : u64 = 0

  pub let lfxw_ok   : [u8; 20] = "R39 L2CAP FIXED OK\n\0"
  pub let lfxw_fail : [u8; 22] = "R39 L2CAP FIXED FAIL\n\0"

  pub let lfxw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): reset L2CAP fixed table.",
      block: {
        call lfx_init;
        ret
      }
    }

  pub let l2cap_fixed_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M2-001 (#1327): boot witness. Stages: (1) cid validator. (2) register ATT / LE_SIG / SM. (3) lookup handler + hci_chan. (4) BAD_CID (0x0007). (5) UNKNOWN_CID before register / after unregister. (6) ALREADY_REGISTERED. (7) BAD_HANDLER (0). (8) BAD_CHAN_SLOT (>= 256). (9) unregister roundtrip. (10) rx_dispatch RX_NO_HANDLER path.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        call lfxw_scrub;

        // -- 1. cid validator.
        mov rdi, 0x0004;
        call lfx_cid_valid;
        cmp rax, 1;
        jne lfxw_fail_stage;
        mov rdi, 0x0005;
        call lfx_cid_valid;
        cmp rax, 1;
        jne lfxw_fail_stage;
        mov rdi, 0x0006;
        call lfx_cid_valid;
        cmp rax, 1;
        jne lfxw_fail_stage;
        mov rdi, 0x0003;                 // AMP manager, not LE
        call lfx_cid_valid;
        cmp rax, 0;
        jne lfxw_fail_stage;
        mov rdi, 0x0007;
        call lfx_cid_valid;
        cmp rax, 0;
        jne lfxw_fail_stage;
        mov rdi, 0;
        call lfx_cid_valid;
        cmp rax, 0;
        jne lfxw_fail_stage;

        // -- 2. register ATT / LE_SIG / SM.
        mov rax, 2;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0004;                 // ATT
        mov rsi, 0xAAAA1111;             // handler_key
        mov rdx, 20;                     // hci_chan_slot
        call lfx_register;
        cmp rax, 3;                      // row_id < 4 expected
        jae lfxw_fail_stage;

        mov rdi, 0x0005;                 // LE_SIG
        mov rsi, 0xBBBB2222;
        mov rdx, 21;
        call lfx_register;
        cmp rax, 3;
        jae lfxw_fail_stage;

        mov rdi, 0x0006;                 // SM
        mov rsi, 0xCCCC3333;
        mov rdx, 22;
        call lfx_register;
        cmp rax, 3;
        jae lfxw_fail_stage;

        // -- 3. lookup handler + hci_chan.
        mov rax, 3;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0004;
        call lfx_lookup;
        mov r11, 0xAAAA1111;
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0005;
        call lfx_lookup;
        mov r11, 0xBBBB2222;
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0006;
        call lfx_lookup;
        mov r11, 0xCCCC3333;
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0004;
        call lfx_hci_chan;
        cmp rax, 20;
        jne lfxw_fail_stage;

        mov rdi, 0x0006;
        call lfx_hci_chan;
        cmp rax, 22;
        jne lfxw_fail_stage;

        // -- 4. BAD_CID (not a fixed CID).
        mov rax, 4;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0007;
        mov rsi, 0xDEAD;
        mov rdx, 23;
        call lfx_register;
        mov r11, 0xFFFFF0FF;             // BAD_CID
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0007;
        call lfx_lookup;
        mov r11, 0xFFFFF0FF;
        cmp rax, r11;
        jne lfxw_fail_stage;

        // -- 5. UNKNOWN_CID (not currently registered).
        mov rax, 5;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        call lfxw_scrub;                 // wipe the table

        mov rdi, 0x0004;
        call lfx_lookup;
        mov r11, 0xFFFFF0FE;             // UNKNOWN_CID
        cmp rax, r11;
        jne lfxw_fail_stage;

        // -- 6. ALREADY_REGISTERED.
        mov rax, 6;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0004;
        mov rsi, 0xDEADBEEF;
        mov rdx, 10;
        call lfx_register;
        cmp rax, 3;
        jae lfxw_fail_stage;

        mov rdi, 0x0004;
        mov rsi, 0xCAFEBABE;
        mov rdx, 11;
        call lfx_register;
        mov r11, 0xFFFFF0FD;             // ALREADY_REGISTERED
        cmp rax, r11;
        jne lfxw_fail_stage;

        // -- 7. BAD_HANDLER (handler_key = 0).
        mov rax, 7;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        call lfxw_scrub;

        mov rdi, 0x0005;
        mov rsi, 0;
        mov rdx, 10;
        call lfx_register;
        mov r11, 0xFFFFF0FB;             // BAD_HANDLER
        cmp rax, r11;
        jne lfxw_fail_stage;

        // -- 8. BAD_CHAN_SLOT.
        mov rax, 8;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0005;
        mov rsi, 0xABCD;
        mov rdx, 300;                    // >= 256
        call lfx_register;
        mov r11, 0xFFFFF0FA;             // BAD_CHAN_SLOT
        cmp rax, r11;
        jne lfxw_fail_stage;

        // -- 9. unregister round-trip.
        mov rax, 9;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        call lfxw_scrub;

        mov rdi, 0x0004;
        mov rsi, 0x1111;
        mov rdx, 30;
        call lfx_register;
        cmp rax, 3;
        jae lfxw_fail_stage;

        mov rdi, 0x0004;
        call lfx_unregister;
        cmp rax, 0;
        jne lfxw_fail_stage;

        mov rdi, 0x0004;
        call lfx_lookup;
        mov r11, 0xFFFFF0FE;             // UNKNOWN_CID
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0004;
        call lfx_unregister;
        mov r11, 0xFFFFF0F9;             // NOT_REGISTERED
        cmp rax, r11;
        jne lfxw_fail_stage;

        // Re-register at 0x0004 to serve traffic again.
        mov rdi, 0x0004;
        mov rsi, 0x2222;
        mov rdx, 31;
        call lfx_register;
        cmp rax, 3;
        jae lfxw_fail_stage;

        // -- 10. rx_dispatch RX_NO_HANDLER (unbound fixed CID).
        mov rax, 10;
        lea rcx, [rip + _lfxw_stage];
        mov [rcx], rax;

        mov rdi, 0x0005;                 // LE_SIG not bound
        call lfx_rx_dispatch;
        mov r11, 0xFFFFF0F5;             // RX_NO_HANDLER
        cmp rax, r11;
        jne lfxw_fail_stage;

        mov rdi, 0x0004;                 // ATT bound
        call lfx_rx_dispatch;
        mov r11, 0x2222;
        cmp rax, r11;
        jne lfxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lfxw_ok];
        call klog_s1;

        call lfxw_scrub;
        xor rax, rax;
        jmp lfxw_out;

      lfxw_fail_stage:
        lea rax, [rip + _lfxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lfxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call lfxw_scrub;
        mov rax, 1;

      lfxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
