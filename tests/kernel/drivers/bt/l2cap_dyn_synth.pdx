// tests/kernel/drivers/bt/l2cap_dyn_synth.pdx — R39.M2-002 (#1328)
//
// Boot witness for the L2CAP dynamic-channel + LE CBFC driver.
//
// Drives ldyn_init, ldyn_connect_req / rsp, ldyn_credit_ind, ldyn_send
// across the FSM (IDLE -> REQUESTED -> OPEN -> CLOSED) and asserts every
// refuse path in the failure taxonomy.
//
// Fingerprint: L2CAP DYN OK

module L2capDynSynth = structure {

  pub let mut _ldynw_stage : u64 = 0

  pub let ldynw_ok   : [u8; 14] = "L2CAP DYN OK\n\0"
  pub let ldynw_fail : [u8; 16] = "L2CAP DYN FAIL\n\0"

  pub let ldynw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): reset L2CAP dynamic session table.",
      block: {
        call ldyn_init;
        ret
      }
    }

  pub let l2cap_dyn_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M2-002 (#1328): boot witness. Stages: (1) validators. (2) connect_req allocates cid at 0x0040 base. (3) BAD_PSM (0). (4) BAD_MTU (<23). (5) BAD_HCI (>= 256). (6) ENOSPC (fifth session refused). (7) connect_rsp SUCCESS -> OPEN. (8) BAD_STATE for send before rsp. (9) send consumes credit. (10) NO_CREDITS when balance hits zero. (11) credit_ind refills. (12) CREDIT_OVERFLOW past 0xFFFF. (13) UNKNOWN_CID paths. (14) BAD_RSP_CODE. (15) refusal rsp -> CLOSED + CONNECT_REFUSED.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        call ldynw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call ldyn_psm_valid;
        cmp rax, 0;
        jne ldynw_fail_stage;
        mov rdi, 0x1F;
        call ldyn_psm_valid;
        cmp rax, 1;
        jne ldynw_fail_stage;
        mov rdi, 0x10000;
        call ldyn_psm_valid;
        cmp rax, 0;
        jne ldynw_fail_stage;

        mov rdi, 22;
        call ldyn_mtu_valid;
        cmp rax, 0;
        jne ldynw_fail_stage;
        mov rdi, 23;
        call ldyn_mtu_valid;
        cmp rax, 1;
        jne ldynw_fail_stage;

        // -- 2. connect_req allocates cid at 0x0040 base.
        mov rax, 2;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x1F;                   // psm
        mov rsi, 100;                    // mtu
        mov rdx, 40;                     // hci_chan_slot
        mov rcx, 4;                      // init_credits
        call ldyn_connect_req;
        mov r11, 0x0040;                 // first dynamic cid
        cmp rax, r11;
        jne ldynw_fail_stage;
        mov r14, rax;                    // cid 1

        mov rdi, r14;
        call ldyn_state_of;
        cmp rax, 1;                      // REQUESTED
        jne ldynw_fail_stage;

        // -- 3. BAD_PSM.
        mov rax, 3;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 40;
        mov rcx, 4;
        call ldyn_connect_req;
        mov r11, 0xFFFFF0EE;             // BAD_PSM
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 4. BAD_MTU.
        mov rax, 4;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x1F;
        mov rsi, 22;
        mov rdx, 40;
        mov rcx, 4;
        call ldyn_connect_req;
        mov r11, 0xFFFFF0ED;             // BAD_MTU
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 5. BAD_HCI.
        mov rax, 5;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x1F;
        mov rsi, 100;
        mov rdx, 300;                    // >= 256
        mov rcx, 4;
        call ldyn_connect_req;
        mov r11, 0xFFFFF0EC;             // BAD_HCI
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 6. ENOSPC.  Fill the remaining three rows then attempt one more.
        mov rax, 6;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x1F;
        mov rsi, 100;
        mov rdx, 41;
        mov rcx, 2;
        call ldyn_connect_req;
        mov r11, 0x0041;
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x1F;
        mov rsi, 100;
        mov rdx, 42;
        mov rcx, 2;
        call ldyn_connect_req;
        mov r11, 0x0042;
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x1F;
        mov rsi, 100;
        mov rdx, 43;
        mov rcx, 2;
        call ldyn_connect_req;
        mov r11, 0x0043;
        cmp rax, r11;
        jne ldynw_fail_stage;

        // Fifth attempt: session table full (4 rows).
        mov rdi, 0x1F;
        mov rsi, 100;
        mov rdx, 44;
        mov rcx, 2;
        call ldyn_connect_req;
        mov r11, 0xFFFFF0EF;             // ENOSPC
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 7. connect_rsp SUCCESS -> OPEN.
        mov rax, 7;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, r14;                    // cid 0x0040
        mov rsi, 0;                      // SUCCESS
        call ldyn_connect_rsp;
        cmp rax, 0;
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_state_of;
        cmp rax, 2;                      // OPEN
        jne ldynw_fail_stage;

        // -- 8. BAD_STATE for send in REQUESTED (cid 0x0041 not yet RSP'd).
        mov rax, 8;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x0041;
        call ldyn_send;
        mov r11, 0xFFFFF0E8;             // BAD_STATE
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 9. send consumes credit.
        mov rax, 9;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        call ldyn_credits_of;
        cmp rax, 4;
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_send;
        cmp rax, 3;                      // credits left
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_send;
        cmp rax, 2;
        jne ldynw_fail_stage;

        // -- 10. NO_CREDITS when balance hits zero.
        mov rax, 10;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        call ldyn_send;
        cmp rax, 1;
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_send;
        cmp rax, 0;
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_send;
        mov r11, 0xFFFFF0EB;             // NO_CREDITS
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 11. credit_ind refills.
        mov rax, 11;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        mov rsi, 8;
        call ldyn_credit_ind;
        cmp rax, 0;
        jne ldynw_fail_stage;

        mov rdi, r14;
        call ldyn_credits_of;
        cmp rax, 8;
        jne ldynw_fail_stage;

        // -- 12. CREDIT_OVERFLOW past 0xFFFF.
        mov rax, 12;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        mov rsi, 0xFFFF;
        call ldyn_credit_ind;
        mov r11, 0xFFFFF0E3;             // CREDIT_OVERFLOW
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 13. UNKNOWN_CID paths.
        mov rax, 13;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x00FF;                 // never allocated
        mov rsi, 0;
        call ldyn_connect_rsp;
        mov r11, 0xFFFFF0EA;             // UNKNOWN_CID
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x00FF;
        mov rsi, 1;
        call ldyn_credit_ind;
        mov r11, 0xFFFFF0EA;
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x00FF;
        call ldyn_send;
        mov r11, 0xFFFFF0EA;
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x00FF;
        call ldyn_state_of;
        mov r11, 0xFFFFF0EA;
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 14. BAD_RSP_CODE (unknown result value).
        mov rax, 14;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x0042;
        mov rsi, 99;
        call ldyn_connect_rsp;
        mov r11, 0xFFFFF0E2;             // BAD_RSP_CODE
        cmp rax, r11;
        jne ldynw_fail_stage;

        // -- 15. refusal rsp -> CLOSED + CONNECT_REFUSED.
        mov rax, 15;
        lea rcx, [rip + _ldynw_stage];
        mov [rcx], rax;

        mov rdi, 0x0042;
        mov rsi, 2;                      // PSM_UNSUPPORTED
        call ldyn_connect_rsp;
        mov r11, 0xFFFFF0E9;             // CONNECT_REFUSED
        cmp rax, r11;
        jne ldynw_fail_stage;

        mov rdi, 0x0042;
        call ldyn_state_of;
        cmp rax, 3;                      // CLOSED
        jne ldynw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ldynw_ok];
        call klog_s1;

        call ldynw_scrub;
        xor rax, rax;
        jmp ldynw_out;

      ldynw_fail_stage:
        lea rax, [rip + _ldynw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ldynw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ldynw_scrub;
        mov rax, 1;

      ldynw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
