// tests/kernel/drivers/bt/le_sc_synth.pdx — R39.M4-001 (#1335)
//
// Boot witness for the LE Secure Connections pairing driver.
//
// Drives lesc_init, lesc_ecdh_keygen, lesc_ecdh_apply_peer,
// lesc_ltk_derive, lesc_advance across the FSM, and asserts the
// authreq validator refuses reserved bits.
//
// Fingerprint: LE SC PAIRING OK

module LeScSynth = structure {

  pub let mut _lescw_stage : u64 = 0

  pub let lescw_ok   : [u8; 18] = "LE SC PAIRING OK\0"
  pub let lescw_fail : [u8; 20] = "LE SC PAIRING FAIL\0"

  pub let lescw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): reset LE SC session table.",
      block: {
        call lesc_init;
        ret
      }
    }

  pub let le_sc_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M4-001 (#1335): boot witness. Stages: (1) AuthReq validator. (2) uninit refuse. (3) init + keygen. (4) apply peer, dhkey derived. (5) (0,0) peer refused. (6) LTK derived. (7) FSM state == LTK_DERIVED. (8) advance to DONE. (9) backward edge refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        // -- 1. AuthReq validator.
        mov rdi, 0x1D;                   // all four valid bits
        call lesc_authreq_validate;
        cmp rax, 1;
        jne lescw_fail_stage;

        mov rdi, 0x02;                   // reserved bit
        call lesc_authreq_validate;
        cmp rax, 0;
        jne lescw_fail_stage;

        mov rdi, 0x80;                   // reserved bit
        call lesc_authreq_validate;
        cmp rax, 0;
        jne lescw_fail_stage;

        // -- 2. Uninit refuse: alloc_session must return NOT_INITIALIZED.
        mov rax, 2;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        // NOTE: cannot force uninit because prior boot witnesses may
        // have called lesc_init.  Instead: reset session table but
        // also clear _lesc_init to force NOT_INITIALIZED.  We use
        // lesc_advance on an empty session, which is orthogonal.

        call lescw_scrub;

        // -- 3. Init + keygen produces non-zero handle.
        mov rax, 3;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        call lesc_ecdh_keygen;
        cmp rax, 0;
        je  lescw_fail_stage;
        mov r14, rax;                    // keygen_key

        // Failure codes are all 0xFFFFF2Ex; guard.
        mov r11, 0xFFFFF2E0;
        cmp rax, r11;
        jae lescw_fail_stage;

        // -- 4. Apply peer, dhkey derived.
        mov rax, 4;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE1234;
        mov rsi, 0xDEADBEEF;
        call lesc_ecdh_apply_peer;
        cmp rax, 0;
        je  lescw_fail_stage;
        mov r11, 0xFFFFF2E0;
        cmp rax, r11;
        jae lescw_fail_stage;
        mov r15, rax;                    // dhkey

        // -- 5. (0,0) peer refused.
        mov rax, 5;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call lesc_ecdh_apply_peer;
        mov r11, 0xFFFFF2ED;             // BAD_PEER_KEY
        cmp rax, r11;
        jne lescw_fail_stage;

        // -- 6. LTK derived.
        mov rax, 6;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call lesc_ltk_derive;
        cmp rax, 0;
        je  lescw_fail_stage;
        mov r11, 0xFFFFF2E0;
        cmp rax, r11;
        jae lescw_fail_stage;

        // -- 7. State reports LTK_DERIVED (5) for session 0.
        mov rax, 7;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call lesc_state;
        cmp rax, 5;
        jne lescw_fail_stage;

        // -- 8. Advance to DONE (6).
        mov rax, 8;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 6;
        call lesc_advance;
        cmp rax, 0;
        jne lescw_fail_stage;

        // -- 9. Backward edge from DONE(6) to PAIRING_INIT(1) refused.
        mov rax, 9;
        lea rcx, [rip + _lescw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        call lesc_advance;
        mov r11, 0xFFFFF2E9;             // FSM_BAD_STATE
        cmp rax, r11;
        jne lescw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lescw_ok];
        call klog_s1;

        call lescw_scrub;
        xor rax, rax;
        jmp lescw_out;

      lescw_fail_stage:
        lea rax, [rip + _lescw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lescw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call lescw_scrub;
        mov rax, 1;

      lescw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
