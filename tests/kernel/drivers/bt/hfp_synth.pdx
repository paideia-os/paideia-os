// tests/kernel/drivers/bt/hfp_synth.pdx — R39.M6-001 (#1343)
//
// Boot witness for the HFP (Hands-Free Profile) driver.
//
// Drives hfp_init, session_open (CVSD + mSBC), duplicate refusal,
// codec/rate/direction refusals, AT verb dispatch across the FSM
// (DIAL -> RINGING, ANSWER -> ACTIVE, DTMF, HANGUP -> IDLE), illegal
// verb edges, SCO frame contract for both codecs, and session close.
//
// Fingerprint: R39 HFP OK

module HfpSynth = structure {

  pub let mut _hfpw_stage : u64 = 0

  pub let hfpw_ok   : [u8; 13] = "R39 HFP OK\n\0\0"
  pub let hfpw_fail : [u8; 14] = "R39 HFP FAIL\n\0"

  pub let hfpw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-001 (#1343): reset HFP session table + counters + init flag.",
      block: {
        call hfp_reset;
        ret
      }
    }

  pub let hfp_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M6-001 (#1343): boot witness. Stages: (1) validators. (2) uninit refuse. (3) init idempotent. (4) session_open CVSD + mSBC. (5) DUP_SESSION refused. (6) codec/rate mismatch refused. (7) direction refused. (8) DIAL edge: IDLE -> RINGING. (9) ANSWER edge: RINGING -> ACTIVE. (10) DTMF side-effect. (11) BAD_VERB refused. (12) SCO frame contract on CVSD -> 60 samples. (13) SCO frame contract on mSBC -> 120 samples. (14) HANGUP -> IDLE. (15) session close.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Validators.
        mov rax, 1;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call hfp_codec_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 2;
        call hfp_codec_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 3;
        call hfp_codec_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;
        mov rdi, 0;
        call hfp_codec_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, 1;
        call hfp_verb_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 4;
        call hfp_verb_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 5;
        call hfp_verb_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;
        mov rdi, 0;
        call hfp_verb_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, 0;
        call hfp_dir_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 1;
        call hfp_dir_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 2;
        call hfp_dir_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;

        // Rate must match codec.
        mov rdi, 1;                                  // CVSD
        mov rsi, 8000;
        call hfp_rate_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 2;                                  // mSBC
        mov rsi, 16000;
        call hfp_rate_valid;
        cmp rax, 1;
        jne hfpw_fail_stage;
        mov rdi, 1;                                  // CVSD @ 16000 refused
        mov rsi, 16000;
        call hfp_rate_valid;
        cmp rax, 0;
        jne hfpw_fail_stage;

        // -- 2. Uninit refuse.  session_open must return
        // NOT_INITIALIZED (0xFFFFF296) before hfp_init.
        mov rax, 2;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        call hfpw_scrub;

        mov rdi, 1;                                  // CVSD
        mov rsi, 7;                                  // pcm_slot
        mov rdx, 8000;                               // rate
        mov rcx, 0;                                  // INBOUND
        mov r8,  0x11;                               // session_id
        call hfp_session_open;
        mov r11, 0xFFFFF296;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // -- 3. init idempotent.
        mov rax, 3;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        call hfp_init;
        cmp rax, 0;
        jne hfpw_fail_stage;
        call hfp_init;
        cmp rax, 0;
        jne hfpw_fail_stage;

        // -- 4. Session open CVSD + mSBC.
        mov rax, 4;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, 1;                                  // CVSD
        mov rsi, 7;                                  // pcm_slot
        mov rdx, 8000;                               // rate
        mov rcx, 0;                                  // INBOUND
        mov r8,  0x11;                               // session_id
        call hfp_session_open;
        mov r11, 0xFFFFF290;
        cmp rax, r11;
        jae hfpw_fail_stage;
        mov r12, rax;                                // CVSD row

        mov rdi, 2;                                  // mSBC
        mov rsi, 8;                                  // different pcm_slot
        mov rdx, 16000;                              // rate
        mov rcx, 1;                                  // OUTBOUND
        mov r8,  0x22;                               // session_id
        call hfp_session_open;
        mov r11, 0xFFFFF290;
        cmp rax, r11;
        jae hfpw_fail_stage;
        mov r13, rax;                                // mSBC row

        // -- 5. Duplicate session_id refused (DUP_SESSION 0xFFFFF294).
        mov rax, 5;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 9;
        mov rdx, 8000;
        mov rcx, 0;
        mov r8,  0x11;                               // dup session_id
        call hfp_session_open;
        mov r11, 0xFFFFF294;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // -- 6. Rate mismatch refused (BAD_RATE 0xFFFFF299).
        mov rax, 6;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        // Reset to have a clean table for the refusal test.
        call hfp_reset;
        call hfp_init;

        mov rdi, 1;                                  // CVSD
        mov rsi, 7;
        mov rdx, 16000;                              // wrong rate for CVSD
        mov rcx, 0;
        mov r8,  0x33;
        call hfp_session_open;
        mov r11, 0xFFFFF299;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // -- 7. Direction refused (BAD_DIRECTION 0xFFFFF298).
        mov rax, 7;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 7;
        mov rdx, 8000;
        mov rcx, 5;                                  // bad direction
        mov r8,  0x33;
        call hfp_session_open;
        mov r11, 0xFFFFF298;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // Re-open both sessions cleanly for FSM tests.
        mov rdi, 1;
        mov rsi, 7;
        mov rdx, 8000;
        mov rcx, 0;
        mov r8,  0x11;
        call hfp_session_open;
        mov r12, rax;

        mov rdi, 2;
        mov rsi, 8;
        mov rdx, 16000;
        mov rcx, 1;
        mov r8,  0x22;
        call hfp_session_open;
        mov r13, rax;

        // -- 8. DIAL edge: IDLE -> RINGING.
        mov rax, 8;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 3;                                  // DIAL
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, r12;
        call hfp_session_state;
        cmp rax, 1;                                  // RINGING
        jne hfpw_fail_stage;

        // -- 9. ANSWER edge: RINGING -> ACTIVE.
        mov rax, 9;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 1;                                  // ANSWER
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, r12;
        call hfp_session_state;
        cmp rax, 2;                                  // ACTIVE
        jne hfpw_fail_stage;

        // -- 10. DTMF side-effect (no state change).
        mov rax, 10;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 4;                                  // DTMF
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, r12;
        call hfp_session_state;
        cmp rax, 2;                                  // still ACTIVE
        jne hfpw_fail_stage;

        // -- 11. BAD_VERB refused (0xFFFFF29A) and BAD_STATE refused
        // for ANSWER on IDLE row r13 (mSBC session hasn't dialled).
        mov rax, 11;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 9;                                  // out-of-range verb
        call hfp_at_command;
        mov r11, 0xFFFFF29A;
        cmp rax, r11;
        jne hfpw_fail_stage;

        mov rdi, r13;
        mov rsi, 1;                                  // ANSWER on IDLE
        call hfp_at_command;
        mov r11, 0xFFFFF29B;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // -- 12. SCO frame contract on CVSD ACTIVE -> 60 samples.
        mov rax, 12;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 60;
        call hfp_sco_frame;
        cmp rax, 60;
        jne hfpw_fail_stage;

        // Bad frame length refused.
        mov rdi, r12;
        mov rsi, 40;
        call hfp_sco_frame;
        mov r11, 0xFFFFF293;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // -- 13. SCO frame on mSBC row r13 refused (not ACTIVE yet).
        mov rax, 13;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        mov rsi, 60;
        call hfp_sco_frame;
        mov r11, 0xFFFFF29B;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // Advance mSBC row to ACTIVE via DIAL+ANSWER then frame -> 120.
        mov rdi, r13;
        mov rsi, 3;                                  // DIAL
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;
        mov rdi, r13;
        mov rsi, 1;                                  // ANSWER
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;
        mov rdi, r13;
        mov rsi, 60;
        call hfp_sco_frame;
        cmp rax, 120;
        jne hfpw_fail_stage;

        // -- 14. HANGUP on r12 -> IDLE.
        mov rax, 14;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 2;                                  // HANGUP
        call hfp_at_command;
        cmp rax, 0;
        jne hfpw_fail_stage;

        mov rdi, r12;
        call hfp_session_state;
        cmp rax, 0;                                  // IDLE
        jne hfpw_fail_stage;

        // -- 15. Close both sessions.
        mov rax, 15;
        lea rcx, [rip + _hfpw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call hfp_session_close;
        cmp rax, 0;
        jne hfpw_fail_stage;
        mov rdi, r13;
        call hfp_session_close;
        cmp rax, 0;
        jne hfpw_fail_stage;

        // Close on released row -> BAD_SESSION.
        mov rdi, r12;
        call hfp_session_close;
        mov r11, 0xFFFFF29E;
        cmp rax, r11;
        jne hfpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hfpw_ok];
        call klog_s1;

        call hfpw_scrub;
        xor rax, rax;
        jmp hfpw_out;

      hfpw_fail_stage:
        lea rax, [rip + _hfpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hfpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hfpw_scrub;
        mov rax, 1;

      hfpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
