// tests/kernel/drivers/bt/a2dp_bridge_synth.pdx — R39.M5-002 (#1340)
//
// Boot witness for the A2DP <-> KIND_PCM_STREAM bridge.
//
// Drives a2db_init, attach (SBC inbound + AAC outbound), duplicate SEP
// refusal, decode/encode frame contract (samples-per-frame math),
// direction-mismatch refusal, frame-size refusal, underrun counter,
// and detach.
//
// Fingerprint: A2DP BRIDGE OK

module A2dpBridgeSynth = structure {

  pub let mut _a2dbw_stage : u64 = 0

  pub let a2dbw_ok   : [u8; 17] = "A2DP BRIDGE OK\n\0\0"
  pub let a2dbw_fail : [u8; 18] = "A2DP BRIDGE FAIL\0"

  pub let a2dbw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): reset bridge table + counters + init flag.",
      block: {
        call a2db_reset;
        ret
      }
    }

  pub let a2db_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M5-002 (#1340): boot witness. Stages: (1) validators. (2) init idempotent. (3) uninit refuse (attach without a2db_init -> NOT_INITIALIZED). (4) attach SBC inbound + AAC outbound. (5) duplicate SEP refused (STREAM_MISMATCH). (6) decode SBC frame -> 128 samples. (7) decode AAC frame -> refused (direction OUTBOUND). (8) encode AAC frame with 1024 samples -> 512 bytes. (9) encode with wrong sample-count refused (BAD_FRAME). (10) decode frame_len below MIN refused. (11) underrun counter bump. (12) detach + counter check.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Validators.
        mov rax, 1;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call a2db_dir_valid;
        cmp rax, 1;
        jne a2dbw_fail_stage;
        mov rdi, 1;
        call a2db_dir_valid;
        cmp rax, 1;
        jne a2dbw_fail_stage;
        mov rdi, 2;
        call a2db_dir_valid;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        mov rdi, 48000;
        call a2db_rate_valid;
        cmp rax, 1;
        jne a2dbw_fail_stage;
        mov rdi, 100;
        call a2db_rate_valid;
        cmp rax, 0;
        jne a2dbw_fail_stage;
        mov rdi, 200000;
        call a2db_rate_valid;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        mov rdi, 1;
        call a2db_ch_valid;
        cmp rax, 1;
        jne a2dbw_fail_stage;
        mov rdi, 2;
        call a2db_ch_valid;
        cmp rax, 1;
        jne a2dbw_fail_stage;
        mov rdi, 0;
        call a2db_ch_valid;
        cmp rax, 0;
        jne a2dbw_fail_stage;
        mov rdi, 8;
        call a2db_ch_valid;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        // -- 2. init idempotent.
        mov rax, 2;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        call a2dbw_scrub;

        // -- 3. Uninit refuse.  attach must return NOT_INITIALIZED
        // (0xFFFFF2B4) before a2db_init runs.
        mov rax, 3;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, 0;                                  // sep_id
        mov rsi, 5;                                  // pcm_slot (synthetic)
        mov rdx, 0;                                  // INBOUND
        mov rcx, 0;                                  // SBC
        mov r8,  44100;
        mov r9,  2;
        call a2db_attach;
        mov r11, 0xFFFFF2B4;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // Now initialise.
        call a2db_init;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        // -- 4. Attach SBC inbound + AAC outbound.
        mov rax, 4;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, 0;                                  // sep 0 -> SBC inbound
        mov rsi, 5;                                  // pcm slot
        mov rdx, 0;                                  // INBOUND
        mov rcx, 0;                                  // SBC
        mov r8,  44100;
        mov r9,  2;
        call a2db_attach;
        mov r11, 0xFFFFF2B0;
        cmp rax, r11;
        jae a2dbw_fail_stage;
        mov r12, rax;                                // bridge row for SBC

        mov rdi, 1;                                  // sep 1 -> AAC outbound
        mov rsi, 6;                                  // different pcm slot
        mov rdx, 1;                                  // OUTBOUND
        mov rcx, 2;                                  // AAC
        mov r8,  48000;
        mov r9,  2;
        call a2db_attach;
        mov r11, 0xFFFFF2B0;
        cmp rax, r11;
        jae a2dbw_fail_stage;
        mov r13, rax;                                // bridge row for AAC

        // -- 5. Duplicate sep_id refused (STREAM_MISMATCH = 0xFFFFF2B2).
        mov rax, 5;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 5;
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  44100;
        mov r9,  2;
        call a2db_attach;
        mov r11, 0xFFFFF2B2;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // -- 6. decode SBC frame -> 128 samples (baseline).
        mov rax, 6;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 64;                                 // typical SBC frame_len
        call a2db_decode_frame;
        cmp rax, 128;
        jne a2dbw_fail_stage;

        // -- 7. decode on AAC OUTBOUND row -> BAD_DIRECTION.
        mov rax, 7;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        mov rsi, 512;
        call a2db_decode_frame;
        mov r11, 0xFFFFF2BB;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // -- 8. encode AAC frame with 1024 samples -> 512 bytes.
        mov rax, 8;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        mov rsi, 1024;
        call a2db_encode_frame;
        cmp rax, 512;
        jne a2dbw_fail_stage;

        // -- 9. encode wrong sample-count refused (BAD_FRAME).
        mov rax, 9;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r13;
        mov rsi, 999;
        call a2db_encode_frame;
        mov r11, 0xFFFFF2B7;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // -- 10. decode frame_len below MIN refused (BAD_FRAME).
        mov rax, 10;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, 4;                                  // < 8
        call a2db_decode_frame;
        mov r11, 0xFFFFF2B7;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // -- 11. underrun counter bump.
        mov rax, 11;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, 4;                                  // UNDERRUNS counter
        call a2db_stat;
        mov r14, rax;                                // before

        mov rdi, r12;
        call a2db_report_underrun;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        mov rdi, 4;
        call a2db_stat;
        mov r11, r14;
        add r11, 1;
        cmp rax, r11;
        jne a2dbw_fail_stage;

        // -- 12. detach + counter.
        mov rax, 12;
        lea rcx, [rip + _a2dbw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call a2db_detach;
        cmp rax, 0;
        jne a2dbw_fail_stage;
        mov rdi, r13;
        call a2db_detach;
        cmp rax, 0;
        jne a2dbw_fail_stage;

        mov rdi, 1;                                  // DETACHES counter
        call a2db_stat;
        cmp rax, 2;
        jne a2dbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2dbw_ok];
        call klog_s1;

        call a2dbw_scrub;
        xor rax, rax;
        jmp a2dbw_out;

      a2dbw_fail_stage:
        lea rax, [rip + _a2dbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + a2dbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call a2dbw_scrub;
        mov rax, 1;

      a2dbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
