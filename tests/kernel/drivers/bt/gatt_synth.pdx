// tests/kernel/drivers/bt/gatt_synth.pdx — R39.M3-002 (#1332)
//
// Boot witness for the GATT server + client + ATT PDU codec.
//
// Asserts attribute-table insert/remove/duplicate discipline, permission-
// gated read / write, ATT PDU pack/unpack symmetry for the four supported
// opcodes (Read Req 0x0A, Read Rsp 0x0B, Write Req 0x12, Notify 0x1B,
// Indicate 0x1D), and the discovery walker begin/step/end lifecycle.
//
// Fingerprint: R39 GATT OK

module GattSynth = structure {

  pub let mut _gattw_stage : u64 = 0

  pub let gattw_ok   : [u8; 13] = "R39 GATT OK\n\0"
  pub let gattw_fail : [u8; 15] = "R39 GATT FAIL\n\0"

  pub let gattw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): reset attribute table, discovery walker, and counters.",
      block: {
        call gatt_reset;
        ret
      }
    }

  pub let gatt_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R39.M3-002 (#1332): boot witness. Stages: (1) validators. (2) insert duplicate refused. (3) permission-gated read (allowed + denied). (4) permission-gated write (allowed + denied). (5) ATT Read Req pack/unpack. (6) ATT Read Rsp pack/unpack. (7) ATT Write Req pack/unpack. (8) ATT Notify pack. (9) ATT Indicate pack. (10) Opcode-mismatch unpack refused. (11) Discovery walker: begin, step (hit + miss), end.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        call gattw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call gatt_handle_valid;
        cmp rax, 0;
        jne gattw_fail_stage;
        mov rdi, 1;
        call gatt_handle_valid;
        cmp rax, 1;
        jne gattw_fail_stage;
        mov rdi, 0xFFFF;
        call gatt_handle_valid;
        cmp rax, 1;
        jne gattw_fail_stage;
        mov rdi, 0x10000;
        call gatt_handle_valid;
        cmp rax, 0;
        jne gattw_fail_stage;

        mov rdi, 0x3F;
        call gatt_perm_valid;
        cmp rax, 1;
        jne gattw_fail_stage;
        mov rdi, 0x40;
        call gatt_perm_valid;
        cmp rax, 0;
        jne gattw_fail_stage;

        // -- 2. Insert + duplicate.
        mov rax, 2;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        // Insert handle=0x0001, uuid=0x2A00 (Device Name), perm=READ, value=0xDEADBEEF.
        mov rdi, 0x0001;
        mov rsi, 0x2A00;
        mov rdx, 0x01;                   // READ
        mov rcx, 0xDEADBEEF;
        call gatt_attr_insert;
        cmp rax, 0;
        jne gattw_fail_stage;             // row_id 0 expected

        // Duplicate handle refused with IN_USE.
        mov rdi, 0x0001;
        mov rsi, 0x2A01;
        mov rdx, 0x01;
        mov rcx, 0x0;
        call gatt_attr_insert;
        mov r11, 0xFFFFF318;             // ATTR_IN_USE
        cmp rax, r11;
        jne gattw_fail_stage;

        // Insert handle=0x0002, uuid=0x2A01 (Appearance), perm=READ|WRITE.
        mov rdi, 0x0002;
        mov rsi, 0x2A01;
        mov rdx, 0x03;                   // READ | WRITE
        mov rcx, 0x1234;
        call gatt_attr_insert;
        cmp rax, 1;                      // row_id 1
        jne gattw_fail_stage;

        // -- 3. Read (allowed + denied).
        mov rax, 3;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x0001;
        call gatt_read;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne gattw_fail_stage;

        // Insert handle=0x0003 WITHOUT read permission.
        mov rdi, 0x0003;
        mov rsi, 0x2A05;
        mov rdx, 0x02;                   // WRITE only
        mov rcx, 0;
        call gatt_attr_insert;
        cmp rax, 2;
        jne gattw_fail_stage;

        // Read denied.
        mov rdi, 0x0003;
        call gatt_read;
        mov r11, 0xFFFFF317;             // PERM_DENIED
        cmp rax, r11;
        jne gattw_fail_stage;

        // -- 4. Write (allowed + denied).
        mov rax, 4;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x0002;
        mov rsi, 0xABCD;
        call gatt_write;
        cmp rax, 0;
        jne gattw_fail_stage;

        mov rdi, 0x0002;
        call gatt_read;
        mov r11, 0xABCD;
        cmp rax, r11;
        jne gattw_fail_stage;

        // Write to read-only handle refused.
        mov rdi, 0x0001;
        mov rsi, 0x9999;
        call gatt_write;
        mov r11, 0xFFFFF317;             // PERM_DENIED
        cmp rax, r11;
        jne gattw_fail_stage;

        // -- 5. ATT Read Req pack + unpack.
        mov rax, 5;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call gatt_pack_read_req;
        mov r15, rax;
        mov r11, 0x0012340A;             // handle=0x1234 shifted 8 + opcode 0x0A
        cmp rax, r11;
        jne gattw_fail_stage;

        mov rdi, r15;
        call gatt_unpack_read_req;
        cmp rax, 0x1234;
        jne gattw_fail_stage;

        // -- 6. ATT Read Rsp pack + unpack.
        mov rax, 6;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x00CAFEBABE;
        call gatt_pack_read_rsp;
        mov r15, rax;

        mov rdi, r15;
        call gatt_unpack_read_rsp;
        mov r11, 0x00CAFEBABE;
        cmp rax, r11;
        jne gattw_fail_stage;

        // -- 7. ATT Write Req pack + unpack.
        mov rax, 7;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x0002;
        mov rsi, 0xAABBCCDD;
        call gatt_pack_write_req;
        mov r15, rax;

        mov rdi, r15;
        call gatt_unpack_write_handle;
        cmp rax, 0x0002;
        jne gattw_fail_stage;

        mov rdi, r15;
        call gatt_unpack_write_value;
        mov r11, 0xAABBCCDD;
        cmp rax, r11;
        jne gattw_fail_stage;

        // -- 8. ATT Notify pack.
        mov rax, 8;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x0007;
        mov rsi, 0x11223344;
        call gatt_pack_notify;
        // Verify opcode byte is 0x1B.
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0x1B;
        jne gattw_fail_stage;

        // -- 9. ATT Indicate pack.
        mov rax, 9;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x0007;
        mov rsi, 0x55667788;
        call gatt_pack_indicate;
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0x1D;
        jne gattw_fail_stage;

        // -- 10. Opcode-mismatch unpack refused.
        mov rax, 10;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call gatt_pack_read_req;
        // Pass a Read Req to Read Rsp unpacker -> BAD_OPCODE.
        mov rdi, rax;
        call gatt_unpack_read_rsp;
        mov r11, 0xFFFFF31B;             // BAD_OPCODE
        cmp rax, r11;
        jne gattw_fail_stage;

        // -- 11. Discovery walker: begin, step (hit + miss), end.
        mov rax, 11;
        lea rcx, [rip + _gattw_stage];
        mov [rcx], rax;

        // begin: conn=1, start=1, end=10, uuid_filter=0x2A00.
        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 10;
        mov rcx, 0x2A00;
        call gatt_disc_begin;
        cmp rax, 0;
        jne gattw_fail_stage;

        // Begin while busy refused.
        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 10;
        mov rcx, 0x2A00;
        call gatt_disc_begin;
        mov r11, 0xFFFFF316;             // DISC_BUSY
        cmp rax, r11;
        jne gattw_fail_stage;

        // First step: handle 0x0001 matches uuid 0x2A00.
        call gatt_disc_step;
        cmp rax, 1;
        jne gattw_fail_stage;

        // Next step: no more matches, cursor walks to end -> NOT_FOUND.
        call gatt_disc_step;
        mov r11, 0xFFFFF319;             // ATTR_NOT_FOUND
        cmp rax, r11;
        jne gattw_fail_stage;

        // End returns result_count.
        call gatt_disc_end;
        cmp rax, 1;
        jne gattw_fail_stage;

        // End on idle refused.
        call gatt_disc_end;
        mov r11, 0xFFFFF315;             // DISC_IDLE
        cmp rax, r11;
        jne gattw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gattw_ok];
        call klog_s1;

        call gattw_scrub;
        xor rax, rax;
        jmp gattw_out;

      gattw_fail_stage:
        lea rax, [rip + _gattw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gattw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gattw_scrub;
        mov rax, 1;

      gattw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
