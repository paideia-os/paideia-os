// tests/kernel/drivers/nvme/hw_smoke_r51_t14g4_bdev_placeholder.pdx
//   — R51.M8-006 (#1680)
//
// T14 G4 first-real-hardware BDEV witness -- PLACEHOLDER.
//
// STATUS: dormant. gated:hardware. This module is deliberately NOT
// registered by any boot witness (r30_platform.pdx or otherwise).
// Its body is a minimal stub kept so `find ... -name '*.pdx'` finds
// it and the assembler validates its syntax, but no code path in
// QEMU or on the T14 G4 calls the function it declares yet.
//
// Rationale: mirrors tests/kernel/drivers/vmd/hw_smoke_r47_placeholder.pdx
// (R47.M3-003 #1420 + R47.M5-003 #1426), tests/kernel/drivers/pcie/
// hw_smoke_hotplug_placeholder.pdx (R35.M1-005 #1199), and the
// R34/R37/R38/R39 HW-smoke placeholders. A placeholder that COMPILED
// but never RAN is the shape #1199 established and this file
// continues it for the R51.M8 closing issue.
//
// -----------------------------------------------------------------------------
// What this witness will PROVE once promoted (see tools/hw-smoke-
// r51-nvme-t14g4.md for the full operator recipe)
// -----------------------------------------------------------------------------
//
// Follows the design/hardware/nvme-ahci-tail-milestones.md §M8-006
// procedure: cold power -> USB stick -> serial cable -> first-light
// kernel message -> kernel_main reaches userspace (t14-g4-first-boot.md
// steps 0-5), then the R51.M8-003 (#1677) mount+write+flush+unmount+
// remount+read sequence against the T14 G4's internal NVMe device
// (the T14 G4 has no AHCI-family device on the primary board; the
// AHCI leg of the unified BDEV path is cross-checked separately via
// a SATA dock or the QEMU `-device ide-hd` witness that already
// exercises `ahci_port_cmd_regions_bind` et al.).
//
// Fingerprint fields this witness will emit on live hardware (per
// the design doc's Fingerprint fields list): superblock digest
// (post-mkfs), itable digest (post-write), WAL-head LBA, the
// `mount_gen` counter (sb_mount_gen, superblock.pdx L349), and the
// `blkdev_row_family` byte (kind_blkdev.pdx L110's
// `blkdev_row_family`; must read back 1 = NVME on the T14 G4 run).
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary (reserved; see tools/hw-smoke-r51-nvme-
// t14g4.md §4 for the full UNSEEDED catalogue)
// -----------------------------------------------------------------------------
//
//   T14 G4 HW BDEV BEGIN     "T14 G4 HW BDEV BEGIN\n"
//   T14 G4 HW BDEV OK        "T14 G4 HW BDEV OK\n"       <-- closing fingerprint
//   T14 G4 HW BDEV FAIL      "T14 G4 HW BDEV FAIL\n"
//
// -----------------------------------------------------------------------------
// Failure codes (reserved; not yet wired to any code path)
// -----------------------------------------------------------------------------
//
// The design doc names `MOUNTW_HW_FINGERPRINT_MISMATCH = 0xFFFFECF3`
// and `MOUNTW_HW_BOOT_TIMEOUT = 0xFFFFECF4`. Both are OPERATOR-side
// verification outcomes (a golden-file diff and a capture-window
// timeout respectively, per tools/run-smoke-hw.sh's existing exit-
// code discipline) rather than kernel cap_invoke return values, so
// no kernel constant is minted for them here -- promotion time is
// when the operator recipe's harness gains a concrete comparator and
// these two numbers get a home (either as harness exit codes, same
// posture as run-smoke-hw.sh's 0/1/2/3/4/77/124 table, or as kernel
// constants if a future round wants the kernel itself to detect a
// stalled HW boot). Documented here so `grep MOUNTW_HW` finds this
// note instead of nothing.

module HwSmokeR51T14g4BdevPlaceholder = structure {

  pub let mut _r51_t14g4_bdev_hw_smoke_placeholder : u64 = 0

  pub let r51_t14g4_bdev_hw_smoke_placeholder : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M8-006 (#1680): dormant placeholder, gated:hardware. Returns 0. Not registered by any boot witness; not on any code path. See tools/hw-smoke-r51-nvme-t14g4.md for the operator recipe that promotes this to a live acceptance witness on the T14 G4's internal NVMe device (mount+write+flush+unmount+remount+read per #1677/#1678, closing R51.M8).",
      block: {
        xor rax, rax;
        ret
      }
    }
}
