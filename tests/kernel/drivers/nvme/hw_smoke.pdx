// tests/kernel/drivers/nvme/hw_smoke.pdx — R24-M6-001 (#908)
//
// T14 G4 NVMe scratch-device R/W hardware smoke witness.
//
// Owner issue #908 is `gated:hardware`. At R24 close, the witness
// function lands here as a callable ELF symbol (verified via `nm
// build/kernel.elf | grep nvme_hw_smoke_witness`). Live invocation
// on the T14 G4 is done manually by the operator via a GDB
// `call nvme_hw_smoke_witness()` after attach — see the operator
// recipe at `tools/nvme-hw-smoke.md` §2 for the full BIOS-toggle +
// GDB-attach ceremony.
//
// -----------------------------------------------------------------------------
// What this witness PROVES on live hardware (§2 of tools/nvme-hw-smoke.md)
// -----------------------------------------------------------------------------
//
// (a) R24.M1 nvme_probe recorded at least one class 01/08/02 device
//     (BIOS VMD toggle is Disabled per design/hardware/quirks.md §2.4).
//
// (b) R24.M2 nvme_identify_ns(bar0, ctx, nsid=1, out_buf) returns
//     status (status & 0xFFFE) == 0 — the controller's namespace 1
//     is present and reported. The parse side-effect populates
//     _nvme_lba_size + _nvme_ns_blocks (verified by the operator via
//     `print _nvme_lba_size` under GDB after the call returns).
//
// (c) The controller's CSTS.CFS bit stays clear across the call
//     (operator verifies via `call nvme_csts_check(bar0)` — should
//     return 0).
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove at R24.M6
// -----------------------------------------------------------------------------
//
// - Identify Controller: nvme_build_id_ctrl_cmd + nvme_admin_submit_poll
//   would compose the call, but the operator invokes identify_ns which
//   subsumes the substrate-existence check (both go through the same
//   admin submit/poll path). Explicit identify_ctrl exposure lands with
//   the driver-attach wire (R25+).
//
// - Sector 0 write-back-read-back round-trip: nvme_read_blocking landed
//   at R24.M5 (src/kernel/core/drivers/nvme/sync.pdx) but the write
//   analogue (nvme_write_blocking, OPC=0x01) is deferred to R25+ — the
//   userspace-facing surface documented in #906 blocks on #1015.
//   Live-write acceptance therefore also blocks on the R25+ driver-
//   attach path that wires probe → identify → io_queues → sync_read/
//   sync_write into a boot-time bring-up sequence.
//
// - Under QEMU-TCG `-kernel` boot, nvme_probe returns 0 (no MCFG →
//   PCI enumerator drains empty → no NVMe controllers surface), so
//   this witness always takes the SKIP branch. The witness's body
//   under -kernel emits "NVME HW SMOKE SKIP no controllers\n" and
//   returns 0.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   BEGIN               "NVME HW SMOKE BEGIN\n"                (20 + \0)
//   SKIP                "NVME HW SMOKE SKIP no controllers\n"  (34 + \0)
//   IDENTIFY-NS OK      "NVME HW SMOKE IDENTIFY-NS OK\n"       (29 + \0)
//   IDENTIFY-NS FAIL    "NVME HW SMOKE IDENTIFY-NS FAIL\n"     (31 + \0)
//   END                 "NVME HW SMOKE END\n"                  (18 + \0)
//
// -----------------------------------------------------------------------------
// _nvme_devices record layout (32 B stride, from probe.pdx L44-84)
// -----------------------------------------------------------------------------
//
//   +0   u16 seg
//   +2   u8  bus
//   +3   u8  dev
//   +4   u8  fn
//   +5   u8  _pad
//   +6   u16 cap_msix_off
//   +8   u64 bar0_pa          <-- witness reads this at [_nvme_devices + 8]
//   +16  u16 cap_msi_off
//   +18  ...zero...
//
// -----------------------------------------------------------------------------
// Register plan (2-push callee-save + 8B align)
// -----------------------------------------------------------------------------
//
//   rbx = bar0_pa (preserved across nvme_identify_ns call)
//   rbp = scratch / return status
//
//   2 pushes = 16 B; entry rsp%16==8 → 24, sub rsp,8 → 32, %16==0
//   (aligned for nested nvme_identify_ns call).

module HwSmoke = structure {

  pub let _nvme_hw_smk_begin_msg    : [u8; 21] = "NVME HW SMOKE BEGIN\n\0"
  pub let _nvme_hw_smk_skip_msg     : [u8; 35] = "NVME HW SMOKE SKIP no controllers\n\0"
  pub let _nvme_hw_smk_id_ok_msg    : [u8; 30] = "NVME HW SMOKE IDENTIFY-NS OK\n\0"
  pub let _nvme_hw_smk_id_fail_msg  : [u8; 32] = "NVME HW SMOKE IDENTIFY-NS FAIL\n\0"
  pub let _nvme_hw_smk_end_msg      : [u8; 19] = "NVME HW SMOKE END\n\0"

  // 4 KiB scratch buffer for the Identify Namespace response.  Under
  // IOMMU-off boot (identity-mapped low half) the VA equals the PA
  // and can be handed to the controller as PRP1 without translation
  // — same posture as _nvme_id_ctrl_buf / _nvme_ns_list_buf.
  pub let mut _nvme_hw_smk_id_ns_buf : [u64; 512] = uninit @align(4096)

  // ============================================================================
  // nvme_hw_smoke_witness() -> u64
  // ============================================================================
  //
  // Returns:
  //   0 = pass (either SKIP-under-no-controllers or IDENTIFY-NS OK).
  //   Nonzero = raw CQE status from a failing nvme_identify_ns call.

  pub let nvme_hw_smoke_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M6-001 (#908, gated:hardware). Structural witness for the T14 G4 NVMe scratch-device R/W smoke. Live invocation runs under GDB after the operator toggles BIOS VMD off + boots via UEFI (see tools/nvme-hw-smoke.md). Body: (1) 2-push callee-save prologue (rbx = bar0_pa, rbp = status scratch) — 16 B; entry rsp%16==8 -> 24, sub rsp, 8 -> 32, %16==0 (aligned for nested nvme_identify_ns call). (2) Emit BEGIN fingerprint via uart_puts. (3) Load _nvme_device_count; if 0 -> emit SKIP + END + return 0 (this is the -kernel/BIOS boot path where the R22 PCI enumerator drains empty). (4) Load bar0_pa = u64 @ _nvme_devices + 8 (record 0's BAR0 field per probe.pdx layout). (5) Call nvme_identify_ns(bar0=rbx, ctx=&_nvme_admin_ctx, nsid=1, out_buf_pa=&_nvme_hw_smk_id_ns_buf). Return in rax = raw 16-bit CQE status. (6) Save status in rbp. Check (status & 0xFFFE) == 0: if so -> emit IDENTIFY-NS OK; else -> emit IDENTIFY-NS FAIL. (7) Emit END. (8) Return rbp (raw status, 0 on happy path). Callee-save preserved across nvme_identify_ns per SysV. Reserved labels: `nvme_hws_`. Encoder posture: mov / lea / call / cmp / je / jne / xor / and / mov [rip+sym] — all pre-existing (matches vtd_slpt_synth_witness pattern from R22.M4).",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        // Zero rbp early — used as return-status slot; the SKIP path
        // returns rbp without ever entering the id_ns branch.
        xor rbp, rbp;

        // ---- (2) Emit BEGIN ----
        lea rdi, [rip + _nvme_hw_smk_begin_msg];
        call uart_puts;

        // ---- (3) Guard: no NVMe controllers -> SKIP ----
        mov rax, [rip + _nvme_device_count];
        cmp rax, 0;
        jne nvme_hws_run;

        lea rdi, [rip + _nvme_hw_smk_skip_msg];
        call uart_puts;
        jmp nvme_hws_end;

      nvme_hws_run:
        // ---- (4) Load bar0_pa from _nvme_devices[0] +8 ----
        mov rbx, [rip + _nvme_devices + 8];

        // ---- (5) nvme_identify_ns(bar0, &_nvme_admin_ctx, nsid=1, out_buf) ----
        mov rdi, rbx;
        lea rsi, [rip + _nvme_admin_ctx];
        mov rdx, 1;
        lea rcx, [rip + _nvme_hw_smk_id_ns_buf];
        call nvme_identify_ns;

        // ---- (6) Save + check status ----
        mov rbp, rax;
        mov r10, rax;
        and r10, 0xFFFE;
        cmp r10, 0;
        jne nvme_hws_id_fail;

        lea rdi, [rip + _nvme_hw_smk_id_ok_msg];
        call uart_puts;
        jmp nvme_hws_end;

      nvme_hws_id_fail:
        lea rdi, [rip + _nvme_hw_smk_id_fail_msg];
        call uart_puts;

      nvme_hws_end:
        // ---- (7) Emit END ----
        lea rdi, [rip + _nvme_hw_smk_end_msg];
        call uart_puts;

        // ---- (8) Return status (0 on SKIP or happy IDENTIFY-NS) ----
        mov rax, rbp;

        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
