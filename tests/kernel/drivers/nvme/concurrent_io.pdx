// tests/kernel/drivers/nvme/concurrent_io.pdx — R24-M6-002 (#909)
//
// 4-CPU concurrent-IO throughput fixture — regression scaffold.
//
// -----------------------------------------------------------------------------
// Scope at R24.M6 close
// -----------------------------------------------------------------------------
//
// The eventual regression per #909:
//
//   Spawn 4 kernel-side tasks pinned to CPUs 0..3.
//   Each task issues 100 sequential 4 KiB nvme_read_blocking calls
//   at LBA offsets 0, 1, 2, ..., 99.
//   Aggregate wall time via HPET.
//   Emit "CONCURRENT IO OK cpus=4 iops=<N>" fingerprint.
//
// The M6 landing is Option A per the closure planning
// (see design/round-retrospectives/r24-closure.md): land the witness
// harness now (so the ELF symbol exists + the opt-in smoke mode is
// wired), and gate the actual per-CPU spawn ceremony on the R25+
// driver-attach wire-up which itself blocks on:
//
//   (a) A live NVMe controller (QEMU-TCG default `-kernel` boot
//       has no MCFG → PCI enumerator drains empty → nvme_probe
//       returns 0 → no driver ever attaches).
//
//   (b) The kernel-side sched_spawn + CPU-pin API. R11 preemptive
//       scheduling is landed but sched_spawn as callable from a
//       witness function is not yet exposed as a public symbol —
//       tasks currently come alive only via IPC-triggered creation
//       inside the R14b substrate. The public sched_spawn(fn_ptr,
//       cpu_mask) is R25+ scope (queued alongside the same
//       userspace-server substrate as #1015).
//
// So at M6 the witness body always takes the SKIP branch under any
// current boot path (QEMU-TCG -kernel; a hypothetical UEFI boot on
// T14 G4 with NVMe present would still SKIP because sched_spawn is
// not yet callable from a witness). The SKIP fingerprint is what the
// PAIDEIA_R24_CONCURRENT_IO=1 pre-push opt-in matches against.
//
// When R25+ lands driver-attach + public sched_spawn, this witness
// body swaps in:
//
//   - hpet_now_ns() capture into t0.
//   - loop cpu = 0..3:
//       sched_spawn(cpu_task_body, 1u64 << cpu, /* prio */ 5).
//   - Wait for the 4 tasks to signal completion via a shared u64
//     `_ci_done_count` incremented atomically at task exit.
//   - hpet_now_ns() capture into t1.
//   - iops = (4 * 100 * 1_000_000_000) / (t1 - t0).
//   - klog_s1_x1(INFO, NVME, tag_ci_ok, k_iops, iops).
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   BEGIN            "NVME CONCURRENT IO BEGIN\n"                (25 + \0)
//   SKIP no ctlr     "NVME CONCURRENT IO SKIP no controllers\n"  (39 + \0)
//   SKIP no spawn    "NVME CONCURRENT IO SKIP no sched_spawn\n"  (39 + \0)
//   END              "NVME CONCURRENT IO END\n"                  (23 + \0)
//
// The R25+ SUCCESS fingerprint will be "NVME CONCURRENT IO OK cpus=4
// iops=<N>\n" via klog_s1_x1 — that lands with the driver-attach
// wire-up.
//
// -----------------------------------------------------------------------------
// Register plan (1-push callee-save + 8B align)
// -----------------------------------------------------------------------------
//
//   rbx = _nvme_device_count (loaded once for the guard)
//
//   1 push = 8 B; entry rsp%16==8 -> 16, sub rsp,8 -> 24, %16==8;
//   pre-call uart_puts alignment: 1 push + sub 8 = 16 → %16==8, and
//   uart_puts pushes on entry so a further sub 8 is needed. Simpler
//   path: prologue = 1 push + sub 8 → 16 total → %16==0 (aligned for
//   call). No additional per-call pad needed since uart_puts leaves
//   the stack undisturbed on return.

module ConcurrentIo = structure {

  pub let _ci_begin_msg          : [u8; 26] = "NVME CONCURRENT IO BEGIN\n\0"
  pub let _ci_skip_no_ctlr_msg   : [u8; 40] = "NVME CONCURRENT IO SKIP no controllers\n\0"
  pub let _ci_skip_no_spawn_msg  : [u8; 40] = "NVME CONCURRENT IO SKIP no sched_spawn\n\0"
  pub let _ci_end_msg            : [u8; 24] = "NVME CONCURRENT IO END\n\0"

  // R25+ substrate slots (declared here so the R24.M6 build already
  // sees them and R25 can just wire the body without redeclaration
  // churn):
  //
  //   _ci_done_count : bumped atomically by each per-CPU task on
  //                    exit; witness spins on == 4.
  //   _ci_t0_ns      : HPET timestamp at spawn.
  //   _ci_t1_ns      : HPET timestamp after all 4 tasks complete.
  //
  // At M6 these are declared but never written.
  pub let mut _ci_done_count     : u64 = 0
  pub let mut _ci_t0_ns          : u64 = 0
  pub let mut _ci_t1_ns          : u64 = 0

  // ============================================================================
  // concurrent_io_witness() -> u64
  // ============================================================================
  //
  // Returns:
  //   0 = SKIP (no NVMe controllers, or no sched_spawn substrate yet).
  //   0 (future) = OK (all 4 tasks completed).
  //   Nonzero (future) = failure code (task spawn error, timeout, etc.).

  pub let concurrent_io_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M6-002 (#909). 4-CPU concurrent-IO throughput fixture — structural scaffold at R24.M6. Body: (1) 1-push callee-save prologue (rbx = _nvme_device_count guard); 8 B + sub rsp,8 = 16 → %16==0 (aligned for nested uart_puts calls). (2) Emit BEGIN fingerprint via uart_puts. (3) Load _nvme_device_count into rbx. If rbx == 0 → emit SKIP-no-controllers, END, return 0 (this is the -kernel/BIOS boot path where nvme_probe drains empty). (4) Non-zero device count: at M6 the sched_spawn substrate is not yet public (R25+ dependency documented in the module header) → emit SKIP-no-sched_spawn, END, return 0. (5) When R25+ swaps in the real body: hpet_now_ns → t0; for cpu = 0..3 call sched_spawn(ci_cpu_task, 1u64 << cpu, prio=5); spin on _ci_done_count == 4 with HPET timeout; hpet_now_ns → t1; compute iops = (4*100*1e9)/(t1-t0); klog_s1_x1(INFO, NVME, tag_ci_ok, k_iops, iops). Reserved labels: `nvme_ci_`. Encoder posture: mov / lea / call / cmp / jne / je / xor — all pre-existing.",
      block: {
        push rbx;
        sub rsp, 8;

        // ---- (2) Emit BEGIN ----
        lea rdi, [rip + _ci_begin_msg];
        call uart_puts;

        // ---- (3) Guard: no NVMe controllers -> SKIP ----
        mov rbx, [rip + _nvme_device_count];
        cmp rbx, 0;
        jne nvme_ci_have_ctlr;

        lea rdi, [rip + _ci_skip_no_ctlr_msg];
        call uart_puts;
        jmp nvme_ci_end;

      nvme_ci_have_ctlr:
        // ---- (4) At R24.M6 sched_spawn is not yet public -> SKIP ----
        //
        // When R25+ wires driver-attach + public sched_spawn, this
        // branch swaps in the real body (see module header + R25
        // preflight in design/round-retrospectives/r24-closure.md).
        lea rdi, [rip + _ci_skip_no_spawn_msg];
        call uart_puts;

      nvme_ci_end:
        // ---- END ----
        lea rdi, [rip + _ci_end_msg];
        call uart_puts;

        xor rax, rax;                             // return 0

        add rsp, 8;
        pop rbx;
        ret
      }
    }
}
