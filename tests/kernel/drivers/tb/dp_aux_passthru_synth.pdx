// tests/kernel/drivers/tb/dp_aux_passthru_synth.pdx — R35.M9-002 (#1230)
//
// Boot witness for DP AUX pass-through.
//
// Asserts:
//   (a) reset leaves in_flight == 0; all counters == 0.
//   (b) dpaux_submit(tunnel=1, cmd=NATIVE_READ, addr=0x600, len=1)
//       succeeds; returns slot 0; SUBMITS == 1; in_flight == 1;
//       slot_status(0) == IN_FLIGHT.
//   (c) dpaux_submit with bad cmd (2) refuses BAD_CMD.
//   (d) dpaux_submit with bad address (>= 2^20) refuses BAD_ADDRESS.
//   (e) dpaux_submit with length == 0 refuses BAD_LENGTH.
//   (f) dpaux_submit with length == 17 refuses BAD_LENGTH.
//   (g) dpaux_submit with bad tunnel (>0xFF) refuses BAD_TUNNEL_SLOT.
//   (h) dpaux_complete(slot=0, response=ACK) succeeds; ACKS == 1;
//       slot_status(0) == ACKED; in_flight == 0.
//   (i) dpaux_complete(slot=0, response=ACK) again refuses BAD_SLOT
//       (slot no longer IN_FLIGHT).
//   (j) A fresh submit (cmd=NATIVE_WRITE) followed by complete(NACK)
//       yields NACKS == 1; slot_status == NACKED.
//   (k) A fresh submit followed by complete(DEFER) yields DEFERS == 1;
//       slot_status == DEFERRED.
//   (l) dpaux_complete(slot=0, response=3) refuses BAD_STATUS.
//       (Must submit first to make slot IN_FLIGHT.)
//   (m) dpaux_complete(slot=16, response=ACK) refuses BAD_SLOT.
//   (n) Fill all 16 slots; the 17th submit refuses ENOSPC.
//   (o) dpaux_arbitrated() == 0.
//
// Fingerprint: R35 TB DP AUX OK
//
// No cap slots — module owns its own ring + stats.

module DpAuxPassthruSynth = structure {

  pub let mut _dpauxw_stage : u64 = 0

  pub let dpauxw_ok   : [u8; 15] = "TB DP AUX OK\n\0\0"
  pub let dpauxw_fail : [u8; 17] = "TB DP AUX FAIL\n\0\0"

  pub let dp_aux_passthru_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M9-002 (#1230): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        call dpaux_reset;

        call dpaux_in_flight_count;
        cmp rax, 0;
        jne dpauxw_fail_stage;
        mov rdi, 0;
        call dpaux_stat;
        cmp rax, 0;
        jne dpauxw_fail_stage;

        // -- 2. First submit.
        mov rax, 2;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // tunnel
        mov rsi, 9;                      // NATIVE_READ
        mov rdx, 0x600;                  // address
        mov rcx, 1;                      // length
        call dpaux_submit;
        cmp rax, 0;
        jne dpauxw_fail_stage;           // slot 0
        mov rdi, 0;                      // SUBMITS
        call dpaux_stat;
        cmp rax, 1;
        jne dpauxw_fail_stage;
        call dpaux_in_flight_count;
        cmp rax, 1;
        jne dpauxw_fail_stage;
        mov rdi, 0;
        call dpaux_slot_status;
        cmp rax, 1;                      // IN_FLIGHT
        jne dpauxw_fail_stage;

        // -- 3. Bad cmd.
        mov rax, 3;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 2;                      // bad cmd
        mov rdx, 0;
        mov rcx, 1;
        call dpaux_submit;
        mov r11, 0xFFFFF81E;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 4. Bad address.
        mov rax, 4;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 9;
        mov rdx, 0x100000;               // 2^20
        mov rcx, 1;
        call dpaux_submit;
        mov r11, 0xFFFFF81D;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 5. Length 0.
        mov rax, 5;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 9;
        mov rdx, 0;
        mov rcx, 0;
        call dpaux_submit;
        mov r11, 0xFFFFF81C;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 6. Length 17.
        mov rax, 6;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 9;
        mov rdx, 0;
        mov rcx, 17;
        call dpaux_submit;
        mov r11, 0xFFFFF81C;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 7. Bad tunnel.
        mov rax, 7;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 9;
        mov rdx, 0;
        mov rcx, 1;
        call dpaux_submit;
        mov r11, 0xFFFFF81B;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 8. Complete with ACK.
        mov rax, 8;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;                      // ACK
        call dpaux_complete;
        cmp rax, 0;
        jne dpauxw_fail_stage;
        mov rdi, 1;                      // ACKS
        call dpaux_stat;
        cmp rax, 1;
        jne dpauxw_fail_stage;
        mov rdi, 0;
        call dpaux_slot_status;
        cmp rax, 2;                      // ACKED
        jne dpauxw_fail_stage;
        call dpaux_in_flight_count;
        cmp rax, 0;
        jne dpauxw_fail_stage;

        // -- 9. Double complete.
        mov rax, 9;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call dpaux_complete;
        mov r11, 0xFFFFF819;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 10. Fresh submit + NACK.
        mov rax, 10;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 8;                      // NATIVE_WRITE
        mov rdx, 0x100;
        mov rcx, 1;
        call dpaux_submit;
        // Returned slot id (should be 0 — reused).
        mov r14, rax;
        cmp rax, 16;
        jae dpauxw_fail_stage;

        mov rdi, r14;
        mov rsi, 1;                      // NACK
        call dpaux_complete;
        cmp rax, 0;
        jne dpauxw_fail_stage;
        mov rdi, 2;                      // NACKS
        call dpaux_stat;
        cmp rax, 1;
        jne dpauxw_fail_stage;
        mov rdi, r14;
        call dpaux_slot_status;
        cmp rax, 3;                      // NACKED
        jne dpauxw_fail_stage;

        // -- 11. Fresh submit + DEFER.
        mov rax, 11;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // I2C_READ
        mov rdx, 0x50;                   // EDID address
        mov rcx, 8;
        call dpaux_submit;
        mov r14, rax;
        cmp rax, 16;
        jae dpauxw_fail_stage;

        mov rdi, r14;
        mov rsi, 2;                      // DEFER
        call dpaux_complete;
        cmp rax, 0;
        jne dpauxw_fail_stage;
        mov rdi, 3;                      // DEFERS
        call dpaux_stat;
        cmp rax, 1;
        jne dpauxw_fail_stage;
        mov rdi, r14;
        call dpaux_slot_status;
        cmp rax, 4;                      // DEFERRED
        jne dpauxw_fail_stage;

        // -- 12. Bad status. Submit first to make slot IN_FLIGHT.
        mov rax, 12;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;                      // I2C_WRITE
        mov rdx, 0x50;
        mov rcx, 1;
        call dpaux_submit;
        mov r14, rax;
        cmp rax, 16;
        jae dpauxw_fail_stage;

        mov rdi, r14;
        mov rsi, 3;                      // bad response
        call dpaux_complete;
        mov r11, 0xFFFFF81A;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // Complete it now so the ring is empty again.
        mov rdi, r14;
        mov rsi, 0;
        call dpaux_complete;
        cmp rax, 0;
        jne dpauxw_fail_stage;

        // -- 13. Bad slot on complete.
        mov rax, 13;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        mov rdi, 16;
        mov rsi, 0;
        call dpaux_complete;
        mov r11, 0xFFFFF819;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 14. ENOSPC. Reset first.
        mov rax, 14;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        call dpaux_reset;

        mov rbx, 0;                      // iterator
      dpauxw_fill_scan:
        cmp rbx, 16;
        jae dpauxw_fill_done;
        mov rdi, 1;
        mov rsi, 9;                      // NATIVE_READ
        mov rdx, rbx;
        add rdx, 0x600;                  // addr = 0x600 + i
        mov rcx, 1;
        call dpaux_submit;
        cmp rax, 16;
        jae dpauxw_fail_stage;           // slot id must be <16
        add rbx, 1;
        jmp dpauxw_fill_scan;
      dpauxw_fill_done:

        call dpaux_in_flight_count;
        cmp rax, 16;
        jne dpauxw_fail_stage;

        // 17th submit refuses ENOSPC.
        mov rdi, 1;
        mov rsi, 9;
        mov rdx, 0x700;
        mov rcx, 1;
        call dpaux_submit;
        mov r11, 0xFFFFF818;
        cmp rax, r11;
        jne dpauxw_fail_stage;

        // -- 15. Arbitrated == 0.
        mov rax, 15;
        lea rcx, [rip + _dpauxw_stage];
        mov [rcx], rax;

        call dpaux_arbitrated;
        cmp rax, 0;
        jne dpauxw_fail_stage;

        // Cleanup.
        call dpaux_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpauxw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dpauxw_out;

      dpauxw_fail_stage:
        lea rax, [rip + _dpauxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpauxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpaux_reset;
        mov rax, 1;

      dpauxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
