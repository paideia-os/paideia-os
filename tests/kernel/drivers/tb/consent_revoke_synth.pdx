// tests/kernel/drivers/tb/consent_revoke_synth.pdx — R35.M4-005 (#1214)
//
// Boot witness for the consent-revocation cascade sequencer.
//
// Asserts:
//   (a) refusal on empty slot (NOT_ATTEST)
//   (b) full four-stage completion on a GRANTED attestation with a
//       mapped IOMMU domain (mask = 0xF)
//   (c) idempotence: a second revoke returns STAGE_IDEMPOT (0x7)
//       and does NOT double-release the domain
//   (d) NO_DOMAIN when the attestation names a dock the IOMMU
//       allocator never tracked
//
// Fingerprint: R35 TB CONSENT REVOKE OK
//
// Cap slots 252..255 — a fresh range, disjoint from every prior
// witness's set. Both exits scrub the range and every table this
// fixture touches.

module ConsentRevokeSynth = structure {

  pub let mut _crvw_stage : u64 = 0

  pub let crvw_ok   : [u8; 22] = "TB CONSENT REVOKE OK\n\0"
  pub let crvw_fail : [u8; 24] = "TB CONSENT REVOKE FAIL\n\0"

  pub let crvw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-005 (#1214): clear cap_table slots 252..255.",
      block: {
        push rbx;
        mov rbx, 252;
      crvwc_loop:
        cmp rbx, 256;
        jae crvwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp crvwc_loop;
      crvwc_done:
        pop rbx;
        ret
      }
    }

  pub let crvw_scrub_all : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-005 (#1214): reset every table this fixture touches.",
      block: {
        push rbx;
        call dma_attest_table_reset;
        call iommu_domain_reset;
        call consent_revoke_reset;
        pop rbx;
        ret
      }
    }

  pub let crvw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-005 (#1214): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let crvw_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (attest_key: u64) (dock_id: u64) (domain_id: u64) (hash: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M4-005 (#1214): mint helper.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;
        mov r15, r8;

        mov r10, r13;
        and r10, 0xFFFF;
        mov r11, r14;
        and r11, 0xFFFF;
        shl r11, 16;
        or  r10, r11;
        // r15 holds the 32-bit hash; shl 32 discards any bits > 32
        // as it walks them off the top of the 64-bit register, so no
        // pre-mask is needed (and `and r11, 0xFFFFFFFF` would trip
        // paideia-as's movabs-scratch collision on r11).
        mov r11, r15;
        shl r11, 32;
        or  r10, r11;

        mov rdi, rbx;
        mov rsi, 252;                    // parent endpoint
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 253;                     // event endpoint
        mov r9, r10;
        call dma_attest_cap_mint_inner;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let consent_revoke_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M4-005 (#1214): boot witness. Stages: (1) NOT_ATTEST on empty slot. (2) Full-mask (0xF) revoke on GRANTED attestation with mapped IOMMU domain. (3) Idempotent revoke returns STAGE_IDEMPOT (0x7) and does not double-release. (4) NO_DOMAIN when attestation names an untracked dock.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _crvw_stage];
        mov [rcx], rax;

        call crvw_clear;
        call crvw_scrub_all;

        // Endpoints.
        mov rdi, 252;
        mov rsi, 0x200;
        mov rdx, 0x6666;
        call crvw_endpoint;

        mov rdi, 253;
        mov rsi, 0x200;
        mov rdx, 0x7777;
        call crvw_endpoint;

        // -- 1. NOT_ATTEST on empty slot.
        mov rdi, 254;
        mov rsi, 0;                      // route_base
        mov rdx, 8;                      // route_count
        call consent_revoke_sequence;
        mov r11, 0xFFFFF91D;             // NOT_ATTEST
        cmp rax, r11;
        jne crvw_fail_stage;

        // -- 2. Full-mask revoke.
        mov rax, 2;
        lea rcx, [rip + _crvw_stage];
        mov [rcx], rax;

        // Alloc + map IOMMU domain for dock 0x11.
        mov rdi, 0x11;
        call iommu_domain_alloc;
        mov r15, rax;                    // domain_id
        cmp r15, 16;
        jae crvw_fail_stage;

        mov rdi, r15;
        call iommu_domain_mark_mapped;
        cmp rax, 0;
        jne crvw_fail_stage;

        // Mint attestation for dock 0x11 with domain_id r15.
        mov rdi, 254;
        mov rsi, 0xC0FFEE01;
        mov rdx, 0x11;
        mov rcx, r15;
        mov r8, 0xDEADBEEF;
        call crvw_mint;
        cmp rax, 0;
        jne crvw_fail_stage;

        // Move it to GRANTED.
        mov rdi, 254;
        call dma_attest_row_of_slot;
        mov r14, rax;
        cmp r14, 0xFF;
        je  crvw_fail_stage;

        mov rdi, r14;
        call dma_attest_row_set_granted;
        cmp rax, 0;
        jne crvw_fail_stage;

        // Run the cascade — no routes to walk in this range, so
        // bits 0, 1, 2, 3 all set.
        mov rdi, 254;
        mov rsi, 0;                      // no routes in this range
        mov rdx, 8;
        call consent_revoke_sequence;
        cmp rax, 0xF;                    // STAGE_ALL
        jne crvw_fail_stage;

        // Verify attestation now REVOKED.
        mov rdi, r14;
        call dma_attest_row_state;
        cmp rax, 2;                      // REVOKED
        jne crvw_fail_stage;

        // Verify domain now UNALLOCATED.
        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 0;
        jne crvw_fail_stage;

        // -- 3. Idempotent revoke.
        mov rax, 3;
        lea rcx, [rip + _crvw_stage];
        mov [rcx], rax;

        // A second call — attestation still REVOKED, no domain to
        // touch. Expect STAGE_IDEMPOT (0x7) since IOMMU lookup fails
        // (domain freed above → no_domain, so bit 2 not set).
        // Actually with no domain, only bits 0+1 come from the
        // idempotent path (STATE+ROUTE). Assert either mask.
        mov rdi, 254;
        mov rsi, 0;
        mov rdx, 8;
        call consent_revoke_sequence;
        // Accept either 0x3 (state+route, no domain to unmap) or 0x7.
        cmp rax, 0x3;
        je  crvw_idem_ok;
        cmp rax, 0x7;
        je  crvw_idem_ok;
        jmp crvw_fail_stage;
      crvw_idem_ok:

        // Verify domain still UNALLOCATED (no re-release).
        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 0;
        jne crvw_fail_stage;

        // -- 4. NO_DOMAIN when attestation names untracked dock.
        mov rax, 4;
        lea rcx, [rip + _crvw_stage];
        mov [rcx], rax;

        // Clear the old attestation and mint fresh with a dock the
        // IOMMU allocator never tracked.
        mov rdi, 254;
        call dma_attest_cap_revoke_inner;
        cmp rax, 0;
        jne crvw_fail_stage;

        mov rdi, 255;
        mov rsi, 0xC0FFEE02;
        mov rdx, 0x33;                   // dock 0x33 — never allocated
        mov rcx, 0;                      // domain_id 0 (nominal)
        mov r8, 0xBEEFCAFE;
        call crvw_mint;
        cmp rax, 0;
        jne crvw_fail_stage;

        mov rdi, 255;
        call dma_attest_row_of_slot;
        mov r14, rax;
        cmp r14, 0xFF;
        je  crvw_fail_stage;

        // Move to GRANTED so we hit the non-idempotent path.
        mov rdi, r14;
        call dma_attest_row_set_granted;
        cmp rax, 0;
        jne crvw_fail_stage;

        mov rdi, 255;
        mov rsi, 0;
        mov rdx, 8;
        call consent_revoke_sequence;
        mov r11, 0xFFFFF918;             // NO_DOMAIN
        cmp rax, r11;
        jne crvw_fail_stage;

        // Verify attestation was still moved to REVOKED (the state
        // stage runs before the IOMMU lookup fails).
        mov rdi, r14;
        call dma_attest_row_state;
        cmp rax, 2;                      // REVOKED
        jne crvw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + crvw_ok];
        call klog_s1;

        call crvw_scrub_all;
        call crvw_clear;
        xor rax, rax;
        jmp crvw_out;

      crvw_fail_stage:
        lea rax, [rip + _crvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + crvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call crvw_scrub_all;
        call crvw_clear;
        mov rax, 1;

      crvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
