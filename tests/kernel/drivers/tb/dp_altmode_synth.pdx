// tests/kernel/drivers/tb/dp_altmode_synth.pdx — R35.M10-003 (#1234)
//
// Boot witness for DP alt-mode via USB-PD SVDMs.
//
// Asserts:
//   (a) reset leaves active_count == 0; all counters == 0.
//   (b) dpam_enter(port=0, pin=D) succeeds; state == ENTERED;
//       ENTERS == 1; pin == D.
//   (c) dpam_enter bad port refuses BAD_PORT.
//   (d) dpam_enter pin=0 refuses BAD_PIN.
//   (e) dpam_enter pin=(A|D)=0x9 (two bits) refuses BAD_PIN.
//   (f) dpam_enter pin=0x40 (bit 6 outside A..F) refuses BAD_PIN.
//   (g) dpam_enter on ENTERED port refuses ALREADY_ENTERED.
//   (h) dpam_status(port=0, role=DFP_D=2, hpd=1) succeeds;
//       STATUSES == 1; HPD_HIGHS == 1; role == 2; hpd == 1.
//   (i) dpam_status bad role (4) refuses BAD_ARG.
//   (j) dpam_status hpd=2 refuses BAD_ARG.
//   (k) dpam_status on INACTIVE port refuses NOT_ENTERED.
//   (l) dpam_configure(port=0, pin=E) succeeds; state == CONFIGURED;
//       CONFIGURES == 1; pin == E.
//   (m) dpam_configure on wrong state (already CONFIGURED) refuses BAD_STATE.
//   (n) dpam_enter on CONFIGURED port refuses ALREADY_ENTERED.
//   (o) dpam_exit(port=0) succeeds; state == EXITED; EXITS == 1;
//       pin cleared to 0; hpd cleared; role cleared.
//   (p) dpam_exit on INACTIVE port refuses NOT_ENTERED.
//   (q) dpam_active_count == 0 after only-EXITED port.
//   (r) Enter port 1 with pin=A; active_count == 1.
//   (s) dpam_arbitrated() == 0 (honesty pin).
//
// Fingerprint: R35 TB DP ALTMODE OK
//
// No cap slots — module owns its own port table + stats.

module DpAltmodeSynth = structure {

  pub let mut _dpamw_stage : u64 = 0

  pub let dpamw_ok   : [u8; 19] = "TB DP ALTMODE OK\n\0\0"
  pub let dpamw_fail : [u8; 21] = "TB DP ALTMODE FAIL\n\0\0"

  pub let dp_altmode_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M10-003 (#1234): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        call dpam_reset;

        call dpam_active_count;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_stat;
        cmp rax, 0;
        jne dpamw_fail_stage;

        // -- 2. ENTER port=0 with pin D.
        mov rax, 2;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x08;                   // PIN_D
        call dpam_enter;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_state;
        cmp rax, 1;                      // ENTERED
        jne dpamw_fail_stage;
        mov rdi, 0;                      // ENTERS
        call dpam_stat;
        cmp rax, 1;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_pin;
        cmp rax, 0x08;
        jne dpamw_fail_stage;

        // -- 3. Bad port.
        mov rax, 3;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 0x08;
        call dpam_enter;
        mov r11, 0xFFFFF7DE;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 4. Zero pin.
        mov rax, 4;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        call dpam_enter;
        mov r11, 0xFFFFF7DD;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 5. Two bits set.
        mov rax, 5;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x9;                    // A | D
        call dpam_enter;
        mov r11, 0xFFFFF7DD;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 6. Bit outside A..F.
        mov rax, 6;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x40;                   // bit 6
        call dpam_enter;
        mov r11, 0xFFFFF7DD;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 7. ENTER on ENTERED refuses ALREADY_ENTERED.
        mov rax, 7;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x08;
        call dpam_enter;
        mov r11, 0xFFFFF7DA;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 8. STATUS port=0 role=DFP_D=2 hpd=1.
        mov rax, 8;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 2;                      // DFP_D
        mov rdx, 1;                      // hpd high
        call dpam_status;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 3;                      // STATUSES
        call dpam_stat;
        cmp rax, 1;
        jne dpamw_fail_stage;
        mov rdi, 4;                      // HPD_HIGHS
        call dpam_stat;
        cmp rax, 1;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_role;
        cmp rax, 2;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_hpd;
        cmp rax, 1;
        jne dpamw_fail_stage;

        // -- 9. Bad role.
        mov rax, 9;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 4;                      // bit 2 illegal
        mov rdx, 0;
        call dpam_status;
        mov r11, 0xFFFFF7DF;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 10. hpd=2.
        mov rax, 10;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 2;
        call dpam_status;
        mov r11, 0xFFFFF7DF;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 11. STATUS on INACTIVE port refuses NOT_ENTERED.
        mov rax, 11;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // port 2 has never entered
        mov rsi, 1;
        mov rdx, 0;
        call dpam_status;
        mov r11, 0xFFFFF7DB;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 12. CONFIGURE port=0 pin=E.
        mov rax, 12;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x10;                   // PIN_E
        call dpam_configure;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_state;
        cmp rax, 2;                      // CONFIGURED
        jne dpamw_fail_stage;
        mov rdi, 1;                      // CONFIGURES
        call dpam_stat;
        cmp rax, 1;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_pin;
        cmp rax, 0x10;
        jne dpamw_fail_stage;

        // -- 13. CONFIGURE on CONFIGURED refuses BAD_STATE.
        mov rax, 13;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x08;
        call dpam_configure;
        mov r11, 0xFFFFF7DC;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 14. ENTER on CONFIGURED refuses ALREADY_ENTERED.
        mov rax, 14;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x02;
        call dpam_enter;
        mov r11, 0xFFFFF7DA;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 15. EXIT port=0.
        mov rax, 15;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dpam_exit;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_state;
        cmp rax, 3;                      // EXITED
        jne dpamw_fail_stage;
        mov rdi, 2;                      // EXITS
        call dpam_stat;
        cmp rax, 1;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_pin;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_hpd;
        cmp rax, 0;
        jne dpamw_fail_stage;
        mov rdi, 0;
        call dpam_port_role;
        cmp rax, 0;
        jne dpamw_fail_stage;

        // -- 16. EXIT on INACTIVE refuses.
        mov rax, 16;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // port 3 never entered
        call dpam_exit;
        mov r11, 0xFFFFF7DB;
        cmp rax, r11;
        jne dpamw_fail_stage;

        // -- 17. active_count == 0.
        mov rax, 17;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        call dpam_active_count;
        cmp rax, 0;
        jne dpamw_fail_stage;

        // -- 18. Enter port 1 pin=A; active_count == 1.
        mov rax, 18;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x01;                   // PIN_A
        call dpam_enter;
        cmp rax, 0;
        jne dpamw_fail_stage;
        call dpam_active_count;
        cmp rax, 1;
        jne dpamw_fail_stage;

        // -- 19. Arbitrated is 0.
        mov rax, 19;
        lea rcx, [rip + _dpamw_stage];
        mov [rcx], rax;

        call dpam_arbitrated;
        cmp rax, 0;
        jne dpamw_fail_stage;

        // Cleanup.
        call dpam_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpamw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dpamw_out;

      dpamw_fail_stage:
        lea rax, [rip + _dpamw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpamw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpam_reset;
        mov rax, 1;

      dpamw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
