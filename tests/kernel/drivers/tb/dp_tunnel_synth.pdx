// tests/kernel/drivers/tb/dp_tunnel_synth.pdx — R35.M3-002 (#1206)
//
// Boot witness for the TB4 DP tunnel scaffold. Asserts lanes / rate /
// adapter / DDI validators; happy-path main_link_negotiate; SELF_LOOP;
// BAD_LANES; BAD_RATE; DDI alloc happy + IN_USE + ENOSPC; DDI
// release round-trip + NOT_HELD; AUX note happy + BAD_ARG on
// oversized transfer.
//
// Fingerprint: R35 TB DP TUNNEL OK

module DpTunnelSynth = structure {

  pub let mut _dtnw_stage : u64 = 0

  pub let dtnw_ok   : [u8; 16] = "TB DP TUNNEL OK\n\0"
  pub let dtnw_fail : [u8; 18] = "TB DP TUNNEL FAIL\n\0"

  pub let dp_tunnel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M3-002 (#1206): boot witness. Stages: (1) reset. (2) validators. (3) main_link happy. (4) SELF_LOOP. (5) BAD_LANES. (6) BAD_RATE. (7) DDI alloc happy. (8) DDI IN_USE. (9) DDI ENOSPC. (10) DDI release round-trip. (11) AUX note happy + oversize refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        call dp_tunnel_reset;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call dp_tun_lanes_valid;
        cmp rax, 1;
        jne dtnw_fail_stage;
        mov rdi, 4;
        call dp_tun_lanes_valid;
        cmp rax, 1;
        jne dtnw_fail_stage;
        mov rdi, 3;
        call dp_tun_lanes_valid;
        cmp rax, 0;
        jne dtnw_fail_stage;

        mov rdi, 7;
        call dp_tun_rate_valid;
        cmp rax, 1;
        jne dtnw_fail_stage;
        mov rdi, 8;
        call dp_tun_rate_valid;
        cmp rax, 0;
        jne dtnw_fail_stage;

        mov rdi, 16;                     // DP_DDI_TB_BASE
        call dp_tun_ddi_valid;
        cmp rax, 1;
        jne dtnw_fail_stage;
        mov rdi, 15;
        call dp_tun_ddi_valid;
        cmp rax, 0;
        jne dtnw_fail_stage;
        mov rdi, 20;
        call dp_tun_ddi_valid;
        cmp rax, 0;
        jne dtnw_fail_stage;

        // -- 3. main_link happy.
        mov rax, 3;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;                     // source
        mov rsi, 20;                     // sink
        mov rdx, 4;                      // lanes
        mov rcx, 4;                      // HBR3
        call dp_tunnel_main_link;
        cmp rax, 0;
        jne dtnw_fail_stage;

        // -- 4. SELF_LOOP.
        mov rax, 4;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 10;                     // source == sink
        mov rdx, 4;
        mov rcx, 4;
        call dp_tunnel_main_link;
        mov r11, 0xFFFFF98B;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 5. BAD_LANES.
        mov rax, 5;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 20;
        mov rdx, 3;                      // BAD lanes
        mov rcx, 4;
        call dp_tunnel_main_link;
        mov r11, 0xFFFFF98E;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 6. BAD_RATE.
        mov rax, 6;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 20;
        mov rdx, 4;
        mov rcx, 8;                      // BAD rate
        call dp_tunnel_main_link;
        mov r11, 0xFFFFF98D;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 7. DDI alloc happy.
        mov rax, 7;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;                     // source_adapter
        call dp_tunnel_ddi_alloc;
        cmp rax, 16;                     // first DDI slot
        jne dtnw_fail_stage;

        // -- 8. DDI IN_USE (same source).
        mov rax, 8;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call dp_tunnel_ddi_alloc;
        mov r11, 0xFFFFF98A;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 9. DDI ENOSPC.
        mov rax, 9;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        // Alloc three more (total 4 slots).
        mov rdi, 11;
        call dp_tunnel_ddi_alloc;
        cmp rax, 17;
        jne dtnw_fail_stage;

        mov rdi, 12;
        call dp_tunnel_ddi_alloc;
        cmp rax, 18;
        jne dtnw_fail_stage;

        mov rdi, 13;
        call dp_tunnel_ddi_alloc;
        cmp rax, 19;
        jne dtnw_fail_stage;

        mov rdi, 14;
        call dp_tunnel_ddi_alloc;
        mov r11, 0xFFFFF989;             // ENOSPC
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 10. DDI release + not-held refusal.
        mov rax, 10;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 16;                     // first DDI
        call dp_tunnel_ddi_release;
        cmp rax, 0;
        jne dtnw_fail_stage;

        // Re-release: NOT_HELD.
        mov rdi, 16;
        call dp_tunnel_ddi_release;
        mov r11, 0xFFFFF987;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // Bad DDI (out of range).
        mov rdi, 100;
        call dp_tunnel_ddi_release;
        mov r11, 0xFFFFF988;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // -- 11. AUX note happy + oversize refused.
        mov rax, 11;
        lea rcx, [rip + _dtnw_stage];
        mov [rcx], rax;

        mov rdi, 8;
        call dp_tunnel_aux_note;
        cmp rax, 0;
        jne dtnw_fail_stage;

        mov rdi, 17;                     // > 16 bytes
        call dp_tunnel_aux_note;
        mov r11, 0xFFFFF98F;
        cmp rax, r11;
        jne dtnw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtnw_ok];
        call klog_s1;

        call dp_tunnel_reset;
        xor rax, rax;
        jmp dtnw_out;

      dtnw_fail_stage:
        lea rax, [rip + _dtnw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtnw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dp_tunnel_reset;
        mov rax, 1;

      dtnw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
