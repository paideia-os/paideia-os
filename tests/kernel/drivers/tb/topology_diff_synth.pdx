// tests/kernel/drivers/tb/topology_diff_synth.pdx — R35.M7-003 (#1225)
//
// Boot witness for TB4 topology diff on hot-plug.
//
// Asserts:
//   (a) reset leaves snapshot invalid and all counts 0.
//   (b) compute_diff before snapshot refuses NO_SNAPSHOT.
//   (c) emit_diff before compute refuses NO_DIFF.
//   (d) build baseline graph: routers 1, 2, 3; edge (1.0 <-> 2.1);
//       snapshot; compute_diff. All four counts == 0.
//   (e) simulate hot-plug: add router 4, add edge (2.2 <-> 4.0),
//       remove router 3; compute_diff:
//         added_routers   = [4]
//         removed_routers = [3]
//         added_edges     = [(2.2, 4.0)]
//         removed_edges   = []
//   (f) emit_diff drives tb_topology_router_appeared (delivered
//       counter bumps on a wildcard subscriber) and
//       tb_topology_router_departed.
//   (g) simulate cable-unplug: remove edge (1.0 <-> 2.1); compute_diff
//       shows one removed_edge, no added_edge, no router change.
//
// Fingerprint: R35 TB TOPOLOGY DIFF OK
//
// No cap slots — module owns its own snapshot + diff arrays + stats.
// Both entry and exit reset the graph and the diff module to keep
// cross-test interleaving harmless.

module TopologyDiffSynth = structure {

  pub let mut _tdw_stage : u64 = 0

  pub let tdw_ok   : [u8; 27] = "R35 TB TOPOLOGY DIFF OK\n\0\0\0\0"
  pub let tdw_fail : [u8; 29] = "R35 TB TOPOLOGY DIFF FAIL\n\0\0\0\0"

  pub let topology_diff_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M7-003 (#1225): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        call tg_reset;
        call td_reset;
        call tb_topology_channel_reset;

        call td_snap_flag;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_valid;
        cmp rax, 0;
        jne tdw_fail_stage;

        // -- 2. compute_diff before snapshot -> NO_SNAPSHOT.
        mov rax, 2;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        call td_compute_diff;
        mov r11, 0xFFFFF86D;             // NO_SNAPSHOT
        cmp rax, r11;
        jne tdw_fail_stage;

        // -- 3. emit_diff before compute -> NO_DIFF.
        mov rax, 3;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        call td_emit_diff;
        mov r11, 0xFFFFF86B;             // NO_DIFF
        cmp rax, r11;
        jne tdw_fail_stage;

        // -- 4. Baseline: routers 1/2/3, edge 1.0<->2.1; snapshot;
        //       compute_diff — zero delta.
        mov rax, 4;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 4;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;
        mov rdi, 2;
        mov rsi, 8;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;
        mov rdi, 3;
        mov rsi, 2;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 1;
        call tg_edge_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;

        call td_snapshot;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_snap_flag;
        cmp rax, 1;
        jne tdw_fail_stage;

        call td_compute_diff;
        cmp rax, 0;
        jne tdw_fail_stage;

        call td_diff_added_router_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_removed_router_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_added_edge_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_removed_edge_count;
        cmp rax, 0;
        jne tdw_fail_stage;

        // -- 5. Hot-plug: add router 4, add edge (2.2<->4.0),
        //       remove router 3. Compute diff.
        mov rax, 5;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 4;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;

        mov rdi, 2;
        mov rsi, 2;
        mov rdx, 4;
        mov rcx, 0;
        call tg_edge_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;

        mov rdi, 3;
        call tg_router_remove;
        cmp rax, 0;
        jne tdw_fail_stage;

        call td_compute_diff;
        cmp rax, 0;
        jne tdw_fail_stage;

        // added_routers == [4]
        call td_diff_added_router_count;
        cmp rax, 1;
        jne tdw_fail_stage;
        mov rdi, 0;
        call td_diff_added_router;
        cmp rax, 4;
        jne tdw_fail_stage;

        // removed_routers == [3]
        call td_diff_removed_router_count;
        cmp rax, 1;
        jne tdw_fail_stage;
        mov rdi, 0;
        call td_diff_removed_router;
        cmp rax, 3;
        jne tdw_fail_stage;

        // added_edges == [(2.2, 4.0)] — check packed sides.
        call td_diff_added_edge_count;
        cmp rax, 1;
        jne tdw_fail_stage;
        mov rdi, 0;
        call td_diff_added_edge_side_a;
        // side_a router[23:0] = 2, port[31:24] = 2 -> 0x02000002
        mov r11, 0x02000002;
        cmp rax, r11;
        jne tdw_fail_stage;
        mov rdi, 0;
        call td_diff_added_edge_side_b;
        // side_b router = 4, port = 0 -> 0x00000004
        mov r11, 0x00000004;
        cmp rax, r11;
        jne tdw_fail_stage;

        // removed_edges == 0
        call td_diff_removed_edge_count;
        cmp rax, 0;
        jne tdw_fail_stage;

        // -- 6. Emit diff — subscribe a wildcard listener and confirm
        //       delivered count bumps by (added_routers + removed_routers).
        mov rax, 6;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // filter=0 wildcard
        mov rsi, 0xDEADBEEF;             // endpoint (non-zero)
        call ttc_sub_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tdw_fail_stage;
        mov rbx, rax;                    // subscriber row

        call td_emit_diff;
        cmp rax, 0;
        jne tdw_fail_stage;

        // Delivered count on the row should be 2 (1 add + 1 remove).
        mov rdi, rbx;
        call ttc_sub_row_delivered;
        cmp rax, 2;
        jne tdw_fail_stage;

        // -- 7. Cable unplug: re-snapshot with current graph, remove
        //       edge (1, 0), compute diff — one removed_edge, no
        //       router change.
        mov rax, 7;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        call td_snapshot;
        cmp rax, 0;
        jne tdw_fail_stage;

        mov rdi, 1;
        mov rsi, 0;
        call tg_edge_remove;
        cmp rax, 0;
        jne tdw_fail_stage;

        call td_compute_diff;
        cmp rax, 0;
        jne tdw_fail_stage;

        call td_diff_added_router_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_removed_router_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_added_edge_count;
        cmp rax, 0;
        jne tdw_fail_stage;
        call td_diff_removed_edge_count;
        cmp rax, 1;
        jne tdw_fail_stage;

        // The removed edge should have side_a = (1 | 0<<24) = 1 and
        // side_b = (2 | 1<<24) = 0x01000002.
        mov rdi, 0;
        call td_diff_removed_edge_side_a;
        cmp rax, 1;
        jne tdw_fail_stage;
        mov rdi, 0;
        call td_diff_removed_edge_side_b;
        mov r11, 0x01000002;
        cmp rax, r11;
        jne tdw_fail_stage;

        // Cleanup.
        call tg_reset;
        call td_reset;
        call tb_topology_channel_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tdw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tdw_out;

      tdw_fail_stage:
        lea rax, [rip + _tdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tg_reset;
        call td_reset;
        call tb_topology_channel_reset;
        mov rax, 1;

      tdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
