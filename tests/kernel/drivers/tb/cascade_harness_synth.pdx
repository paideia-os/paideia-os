// tests/kernel/drivers/tb/cascade_harness_synth.pdx — R35.M5-001 (#1215)
//
// Boot witness for the cap-revocation cascade VALIDATION HARNESS.
//
// Adversarial end-to-end proof: build a KIND_DMA_ATTESTATION over
// dock 0x99 with a mapped IOMMU domain, mint 8 KIND_TB_ROUTE caps
// under it (all with source_adapter = 0x99, so the dock's route
// walker finds all 8), move the attestation to GRANTED, trigger
// consent_revoke_sequence, then verify with the harness that:
//
//   * the route-slot range contains 0 KIND_TB_ROUTE descriptors
//     (leaked-cap count = 0),
//   * verify_routes_torn passes (empty is stronger than TORN),
//   * verify_depth before revoke was 8 (non-vacuity — the cascade
//     actually had 8 caps to sweep, not zero).
//
// Fingerprint: R35 TB CASCADE HARNESS OK
//
// Cap slots 240..251. Reused (not fresh) — dma_attestation_synth
// scrubs 240..247 on exit and consent_revoke_synth scrubs 252..255;
// this witness scrubs 240..251 on entry and on exit, so no state
// bleeds across the boundary in either direction.
//
// Chain depth = 8, matching CASCADE_HARNESS_MAX_DEPTH minus USB4
// slack (max 12, chain of 8 chosen so the harness cap-clamp is
// exercised on the routine call but not on the assertion itself).

module CascadeHarnessSynth = structure {

  pub let mut _chw_stage : u64 = 0

  pub let chw_ok   : [u8; 24] = "TB CASCADE HARNESS OK\n\0\0"
  pub let chw_fail : [u8; 26] = "TB CASCADE HARNESS FAIL\n\0\0"

  pub let CHW_CHAIN_DEPTH : u64 = 8
  pub let CHW_SLOT_BASE   : u64 = 243     // routes at 243..250
  pub let CHW_DOCK_ID     : u64 = 0x99

  pub let chw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): clear cap_table slots 240..251.",
      block: {
        push rbx;
        mov rbx, 240;
      chwc_loop:
        cmp rbx, 252;
        jae chwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp chwc_loop;
      chwc_done:
        pop rbx;
        ret
      }
    }

  pub let chw_scrub_all : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): reset every table this fixture touches.",
      block: {
        push rbx;
        call dma_attest_table_reset;
        call tb_route_table_reset;
        call iommu_domain_reset;
        call consent_revoke_reset;
        call route_teardown_reset;
        call cascade_harness_reset;
        pop rbx;
        ret
      }
    }

  pub let chw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let chw_mint_attest : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (attest_key: u64) (dock_id: u64) (domain_id: u64) (hash: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): mint KIND_DMA_ATTESTATION via dma_attest_cap_mint_inner. packed = dock[15:0] | domain[31:16] | hash[63:32].",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;
        mov r15, r8;

        mov r10, r13;
        and r10, 0xFFFF;
        mov r11, r14;
        and r11, 0xFFFF;
        shl r11, 16;
        or  r10, r11;
        mov r11, r15;
        shl r11, 32;
        or  r10, r11;

        mov rdi, rbx;
        mov rsi, 240;                    // parent endpoint
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 241;                     // event endpoint
        mov r9, r10;
        call dma_attest_cap_mint_inner;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let chw_mint_route : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (route_key: u64) (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): mint KIND_TB_ROUTE via tb_route_cap_mint_inner. packed = route_id[23:0] | tunnel[31:24] | source[39:32] | sink[47:40].",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;
        mov r15, r8;

        mov r10, 0x000042;               // route_id — arbitrary in-range
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 24;
        or  r10, r11;
        mov r11, r14;
        and r11, 0xFF;
        shl r11, 32;
        or  r10, r11;
        mov r11, r15;
        and r11, 0xFF;
        shl r11, 40;
        or  r10, r11;

        mov rdi, rbx;
        mov rsi, 240;                    // parent endpoint
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 241;                     // event endpoint
        mov r9, r10;
        call tb_route_cap_mint_inner;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cascade_harness_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M5-001 (#1215): boot witness. Stages: (1) verify_empty on already-clean range passes. (2) Build chain: attestation at 242, 8 routes at 243..250, all with source_adapter = dock. (3) verify_depth reports 8 (non-vacuity). (4) consent_revoke_sequence returns STAGE_ALL (0xF). (5) verify_empty passes on route range (0 leaked). (6) verify_routes_torn passes (empty is stronger than TORN). (7) verify_depth after revoke reports 0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        call chw_clear;
        call chw_scrub_all;

        // -- 1. Baseline: verify_empty on clean range.
        mov rdi, 243;                    // route slot base
        mov rsi, 8;
        call cascade_harness_verify_empty;
        cmp rax, 0;
        jne chw_fail_stage;

        // Endpoints.
        mov rdi, 240;
        mov rsi, 0x200;
        mov rdx, 0x9999;
        call chw_endpoint;

        mov rdi, 241;
        mov rsi, 0x200;
        mov rdx, 0xAAAA;
        call chw_endpoint;

        // -- 2. Build chain.
        mov rax, 2;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        // Alloc + map IOMMU for dock 0x99.
        mov rdi, 0x99;
        call iommu_domain_alloc;
        mov r15, rax;                    // domain_id
        cmp r15, 16;
        jae chw_fail_stage;

        mov rdi, r15;
        call iommu_domain_mark_mapped;
        cmp rax, 0;
        jne chw_fail_stage;

        // Attestation at 242.
        mov rdi, 242;
        mov rsi, 0xC0FFEE99;
        mov rdx, 0x99;
        mov rcx, r15;
        mov r8, 0xFEEDF00D;
        call chw_mint_attest;
        cmp rax, 0;
        jne chw_fail_stage;

        // Move attestation to GRANTED.
        mov rdi, 242;
        call dma_attest_row_of_slot;
        mov r14, rax;
        cmp r14, 0xFF;
        je  chw_fail_stage;

        mov rdi, r14;
        call dma_attest_row_set_granted;
        cmp rax, 0;
        jne chw_fail_stage;

        // 8 routes at 243..250, all with source_adapter = 0x99.
        // Use distinct route_keys to satisfy the mint's uniqueness gate.
        mov rbx, 243;                    // slot cursor
        mov r12, 0xB0B00001;             // route_key cursor
      chw_mint_loop:
        cmp rbx, 251;
        jae chw_mint_done;
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, 0;                      // tunnel_type PCIe
        mov rcx, 0x99;                   // source_adapter = dock
        mov r8, 0x7A;                    // sink_adapter (arbitrary)
        call chw_mint_route;
        cmp rax, 0;
        jne chw_fail_stage;
        add rbx, 1;
        add r12, 1;
        jmp chw_mint_loop;
      chw_mint_done:

        // -- 3. verify_depth reports 8.
        mov rax, 3;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        mov rdi, 243;
        mov rsi, 8;
        call cascade_harness_verify_depth;
        cmp rax, 8;
        jne chw_fail_stage;

        // -- 4. Trigger the revoke cascade.
        mov rax, 4;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        mov rdi, 242;                    // attestation slot
        mov rsi, 243;                    // route walker base
        mov rdx, 8;                      // route walker count
        call consent_revoke_sequence;
        cmp rax, 0xF;                    // STAGE_ALL
        jne chw_fail_stage;

        // -- 5. verify_empty passes on route range.
        mov rax, 5;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        mov rdi, 243;
        mov rsi, 8;
        call cascade_harness_verify_empty;
        cmp rax, 0;
        jne chw_fail_stage;

        // -- 6. verify_routes_torn passes (all empty).
        mov rax, 6;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        mov rdi, 243;
        mov rsi, 8;
        call cascade_harness_verify_routes_torn;
        cmp rax, 0;
        jne chw_fail_stage;

        // -- 7. verify_depth after revoke reports 0.
        mov rax, 7;
        lea rcx, [rip + _chw_stage];
        mov [rcx], rax;

        mov rdi, 243;
        mov rsi, 8;
        call cascade_harness_verify_depth;
        cmp rax, 0;
        jne chw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chw_ok];
        call klog_s1;

        call chw_scrub_all;
        call chw_clear;
        xor rax, rax;
        jmp chw_out;

      chw_fail_stage:
        lea rax, [rip + _chw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + chw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call chw_scrub_all;
        call chw_clear;
        mov rax, 1;

      chw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
