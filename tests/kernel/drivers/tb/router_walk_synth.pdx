// tests/kernel/drivers/tb/router_walk_synth.pdx — R35.M2-002 (#1202)
//
// Boot witness for the TB4 router discovery + topology walk
// scaffold. Asserts depth decode, parent-route decode, adapter type
// validation, walk_step happy path with router table population +
// topology event fanout, DUP_ROUTE refusal, ENOSPC, remove path.
//
// Fingerprint: R35 TB ROUTER WALK OK

module RouterWalkSynth = structure {

  pub let mut _trww_stage : u64 = 0

  pub let trww_ok   : [u8; 23] = "R35 TB ROUTER WALK OK\n\0"
  pub let trww_fail : [u8; 25] = "R35 TB ROUTER WALK FAIL\n\0"

  pub let tb_router_walk_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M2-002 (#1202): boot witness. Stages: (1) reset. (2) depth decode. (3) parent route decode. (4) adapter type validator. (5) walk_step happy path. (6) DUP_ROUTE. (7) BAD_ADAPTER. (8) ENOSPC after 8 successful walks. (9) walk_remove round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        call tb_router_walk_reset;
        call tb_topology_channel_reset;

        // -- 2. Depth decode.
        mov rax, 2;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // root
        call tb_router_depth;
        cmp rax, 0;
        jne trww_fail_stage;

        mov rdi, 0x1;                    // single hop (slot 0 = adapter 1)
        call tb_router_depth;
        cmp rax, 1;
        jne trww_fail_stage;

        mov rdi, 0x21;                   // slot 0=1, slot 1=1 -> depth 2
        call tb_router_depth;
        cmp rax, 2;
        jne trww_fail_stage;

        mov rdi, 0x1000000;              // > 24 bits
        call tb_router_depth;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne trww_fail_stage;

        // -- 3. Parent route.
        mov rax, 3;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 0x21;
        call tb_router_parent_route;
        cmp rax, 0x1;                    // clear highest slot (slot 1)
        jne trww_fail_stage;

        mov rdi, 0x1;
        call tb_router_parent_route;
        cmp rax, 0;
        jne trww_fail_stage;

        // -- 4. Adapter type validator.
        mov rax, 4;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 3;
        call tb_router_adapter_type_valid;
        cmp rax, 1;
        jne trww_fail_stage;

        mov rdi, 4;
        call tb_router_adapter_type_valid;
        cmp rax, 0;
        jne trww_fail_stage;

        // -- 5. walk_step happy path.
        mov rax, 5;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        // Root router first.
        mov rdi, 0;                      // route_id
        mov rsi, 0;                      // parent
        mov rdx, 4;                      // adapter_count
        call tb_router_walk_step;
        mov r11, 0xFFFFF9CE;             // must not be BAD_ROUTE
        cmp rax, r11;
        je  trww_fail_stage;
        mov r11, 0xFFFFF9C9;             // not DUP
        cmp rax, r11;
        je  trww_fail_stage;

        // Depth-1 router.
        mov rdi, 0x1;
        mov rsi, 0;
        mov rdx, 6;
        call tb_router_walk_step;
        cmp rax, 0xFF;
        je  trww_fail_stage;

        call tb_router_count;
        cmp rax, 2;
        jne trww_fail_stage;

        // Topology channel should have counted 2 APPEARED.
        mov rdi, 0;                      // APPEARED
        call ttc_stat;
        cmp rax, 2;
        jne trww_fail_stage;

        // -- 6. DUP_ROUTE.
        mov rax, 6;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 0x1;                    // already present
        mov rsi, 0;
        mov rdx, 6;
        call tb_router_walk_step;
        mov r11, 0xFFFFF9C9;
        cmp rax, r11;
        jne trww_fail_stage;

        // -- 7. BAD_ADAPTER.
        mov rax, 7;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 0x2;                    // new route
        mov rsi, 0;
        mov rdx, 65;                     // > 64
        call tb_router_walk_step;
        mov r11, 0xFFFFF9CC;
        cmp rax, r11;
        jne trww_fail_stage;

        // -- 8. ENOSPC after filling table.
        mov rax, 8;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        // Add routes 0x2, 0x3, 0x4, 0x5, 0x6, 0x7 to fill (already
        // have 0x0 and 0x1). Ring holds 8.
        mov rbx, 2;
      trww_fill_loop:
        cmp rbx, 8;
        jae trww_fill_done;
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 2;
        call tb_router_walk_step;
        cmp rax, 0xFF;
        je  trww_fail_stage;
        add rbx, 1;
        jmp trww_fill_loop;
      trww_fill_done:

        mov rdi, 0x8;                    // new route
        mov rsi, 0;
        mov rdx, 2;
        call tb_router_walk_step;
        mov r11, 0xFFFFF9CA;             // ENOSPC
        cmp rax, r11;
        jne trww_fail_stage;

        // -- 9. walk_remove.
        mov rax, 9;
        lea rcx, [rip + _trww_stage];
        mov [rcx], rax;

        mov rdi, 0x1;
        call tb_router_walk_remove;
        cmp rax, 0;
        jne trww_fail_stage;

        mov rdi, 0x1;
        call tb_router_walk_remove;
        mov r11, 0xFFFFF9C8;             // NOT_FOUND
        cmp rax, r11;
        jne trww_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + trww_ok];
        call klog_s1;

        call tb_router_walk_reset;
        call tb_topology_channel_reset;
        xor rax, rax;
        jmp trww_out;

      trww_fail_stage:
        lea rax, [rip + _trww_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + trww_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tb_router_walk_reset;
        call tb_topology_channel_reset;
        mov rax, 1;

      trww_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
