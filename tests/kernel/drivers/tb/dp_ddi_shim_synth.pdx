// tests/kernel/drivers/tb/dp_ddi_shim_synth.pdx — R35.M9-001 (#1229)
//
// Boot witness for the DP-tunnel virtual DDI shim.
//
// Asserts:
//   (a) reset leaves row_count == 0; all counters == 0.
//   (b) dpddi_record(tunnel_slot=1, ddi=0, stream=SST) succeeds;
//       row_count == 1; APPEARED == 1; RECORDS == 1;
//       find_by_slot(1) hits; find_by_ddi(0, SST) hits;
//       row_status == APPEARED.
//   (c) dpddi_record with bad tunnel_slot (>0xFF) refuses BAD_TUNNEL_SLOT.
//   (d) dpddi_record with bad ddi (>3) refuses BAD_DDI.
//   (e) dpddi_record with bad stream (>63, not SST) refuses BAD_STREAM.
//   (f) dpddi_record(tunnel_slot=1, ddi=1, stream=SST) refuses DUP
//       (tunnel_slot already recorded).
//   (g) dpddi_record(tunnel_slot=2, ddi=0, stream=SST) refuses DUP
//       ((ddi, stream) already recorded).
//   (h) dpddi_record(tunnel_slot=2, ddi=1, stream=SST) succeeds;
//       row_count == 2; APPEARED == 2.
//   (i) dpddi_record(tunnel_slot=3, ddi=2, stream=5) succeeds
//       (MST stream); row_count == 3.
//   (j) Fill all 4 rows; the 5th refuses ENOSPC.
//   (k) dpddi_remove(tunnel_slot=1) succeeds; row_count == 3;
//       REMOVED == 1; find_by_slot(1) misses.
//   (l) dpddi_remove(tunnel_slot=1) again refuses NOT_FOUND.
//   (m) dpddi_remove(tunnel_slot=0x100) refuses BAD_TUNNEL_SLOT.
//   (n) dpddi_event_appeared(1, 0) succeeds; APPEARED bumps.
//   (o) dpddi_event_removed(1, 0) succeeds; REMOVED bumps.
//   (p) dpddi_event_appeared with bad ddi refuses BAD_DDI.
//   (q) dpddi_arbitrated() == 0 (honesty pin).
//
// Fingerprint: R35 TB DP DDI SHIM OK
//
// No cap slots — module owns its own rows + stats.

module DpDdiShimSynth = structure {

  pub let mut _dpddiw_stage : u64 = 0

  pub let dpddiw_ok   : [u8; 20] = "TB DP DDI SHIM OK\n\0\0"
  pub let dpddiw_fail : [u8; 22] = "TB DP DDI SHIM FAIL\n\0\0"

  pub let dp_ddi_shim_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M9-001 (#1229): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        call dpddi_reset;

        call dpddi_row_count;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        mov rdi, 0;
        call dpddi_stat;
        cmp rax, 0;
        jne dpddiw_fail_stage;

        // -- 2. First record.
        mov rax, 2;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // tunnel_slot
        mov rsi, 0;                      // ddi
        mov rdx, 0xFF;                   // stream = SST
        call dpddi_record;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        call dpddi_row_count;
        cmp rax, 1;
        jne dpddiw_fail_stage;
        mov rdi, 0;                      // APPEARED
        call dpddi_stat;
        cmp rax, 1;
        jne dpddiw_fail_stage;
        mov rdi, 2;                      // RECORDS
        call dpddi_stat;
        cmp rax, 1;
        jne dpddiw_fail_stage;
        mov rdi, 1;
        call dpddi_find_by_slot;
        cmp rax, 0xFF;
        je  dpddiw_fail_stage;
        mov rdi, 0;
        mov rsi, 0xFF;
        call dpddi_find_by_ddi;
        cmp rax, 0xFF;
        je  dpddiw_fail_stage;

        // -- 3. Bad tunnel_slot.
        mov rax, 3;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 1;
        mov rdx, 0xFF;
        call dpddi_record;
        mov r11, 0xFFFFF82E;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 4. Bad ddi.
        mov rax, 4;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 4;
        mov rdx, 0xFF;
        call dpddi_record;
        mov r11, 0xFFFFF82D;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 5. Bad stream.
        mov rax, 5;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 2;
        mov rdx, 64;
        call dpddi_record;
        mov r11, 0xFFFFF82C;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 6. Duplicate by tunnel_slot.
        mov rax, 6;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // same tunnel_slot
        mov rsi, 1;
        mov rdx, 0xFF;
        call dpddi_record;
        mov r11, 0xFFFFF82B;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 7. Duplicate by (ddi, stream).
        mov rax, 7;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // fresh tunnel_slot
        mov rsi, 0;                      // same ddi as row 1
        mov rdx, 0xFF;                   // same stream (SST)
        call dpddi_record;
        mov r11, 0xFFFFF82B;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 8. Second successful record.
        mov rax, 8;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 0xFF;
        call dpddi_record;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        call dpddi_row_count;
        cmp rax, 2;
        jne dpddiw_fail_stage;

        // -- 9. MST stream record.
        mov rax, 9;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 2;
        mov rdx, 5;                      // MST stream 5
        call dpddi_record;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        call dpddi_row_count;
        cmp rax, 3;
        jne dpddiw_fail_stage;

        // -- 10. Fill fourth row; fifth refuses ENOSPC.
        mov rax, 10;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 3;
        mov rdx, 0xFF;
        call dpddi_record;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        call dpddi_row_count;
        cmp rax, 4;
        jne dpddiw_fail_stage;

        // Fifth unique tuple must refuse ENOSPC. Use ddi=2 stream=7 to
        // stay away from (0, SST), (1, SST), (2, 5), (3, SST) already
        // recorded.
        mov rdi, 5;
        mov rsi, 2;
        mov rdx, 7;
        call dpddi_record;
        mov r11, 0xFFFFF82A;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 11. Remove tunnel_slot=1.
        mov rax, 11;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call dpddi_remove;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        call dpddi_row_count;
        cmp rax, 3;
        jne dpddiw_fail_stage;
        mov rdi, 1;                      // REMOVED
        call dpddi_stat;
        cmp rax, 1;
        jne dpddiw_fail_stage;
        mov rdi, 1;
        call dpddi_find_by_slot;
        cmp rax, 0xFF;
        jne dpddiw_fail_stage;

        // -- 12. Double remove.
        mov rax, 12;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call dpddi_remove;
        mov r11, 0xFFFFF829;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 13. Bad-tunnel remove.
        mov rax, 13;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        call dpddi_remove;
        mov r11, 0xFFFFF82E;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 14. Placeholder events.
        mov rax, 14;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        // Read APPEARED baseline (should be 4: rows recorded).
        mov rdi, 0;
        call dpddi_stat;
        mov r14, rax;                    // baseline APPEARED

        mov rdi, 7;
        mov rsi, 0;
        call dpddi_event_appeared;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        mov rdi, 0;
        call dpddi_stat;
        mov r15, r14;
        add r15, 1;
        cmp rax, r15;
        jne dpddiw_fail_stage;

        // Read REMOVED baseline.
        mov rdi, 1;
        call dpddi_stat;
        mov r14, rax;

        mov rdi, 7;
        mov rsi, 0;
        call dpddi_event_removed;
        cmp rax, 0;
        jne dpddiw_fail_stage;
        mov rdi, 1;
        call dpddi_stat;
        mov r15, r14;
        add r15, 1;
        cmp rax, r15;
        jne dpddiw_fail_stage;

        // -- 15. Bad-ddi on placeholder.
        mov rax, 15;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        mov rsi, 4;
        call dpddi_event_appeared;
        mov r11, 0xFFFFF82D;
        cmp rax, r11;
        jne dpddiw_fail_stage;

        // -- 16. Arbitrated is 0.
        mov rax, 16;
        lea rcx, [rip + _dpddiw_stage];
        mov [rcx], rax;

        call dpddi_arbitrated;
        cmp rax, 0;
        jne dpddiw_fail_stage;

        // Cleanup.
        call dpddi_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpddiw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dpddiw_out;

      dpddiw_fail_stage:
        lea rax, [rip + _dpddiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpddiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpddi_reset;
        mov rax, 1;

      dpddiw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
