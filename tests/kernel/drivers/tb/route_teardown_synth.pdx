// tests/kernel/drivers/tb/route_teardown_synth.pdx — R35.M3-005 (#1209)
//
// Boot witness for the TB4 route teardown sequencer. Asserts:
//   (a) refusal on an empty slot (NOT_ROUTE)
//   (b) three-stage completion on a live PCIe route (bit mask = 0x7,
//       DRAIN+PATH+REVOKE with PCIe path being a no-op)
//   (c) three-stage completion on a live DP route with a DDI slot
//       previously held via dp_tunnel_ddi_alloc — the sequencer
//       must find and release the correct DDI slot
//   (d) three-stage completion on a live USB3 route with a virtual
//       xHCI port previously held via usb3_tunnel_port_alloc
//   (e) after teardown the cap slot is empty and the row is free
//
// Fingerprint: R35 TB ROUTE TEARDOWN OK
//
// Cap slots 232..239 — a fresh range, disjoint from tb_route_synth
// (216..231), tb_domain_synth (208..215), pcie_hotplug_event_synth
// (200..207). Every exit path scrubs the range so nothing bleeds
// into later witnesses.

module RouteTeardownSynth = structure {

  pub let mut _rtdw_stage : u64 = 0

  pub let rtdw_ok   : [u8; 26] = "R35 TB ROUTE TEARDOWN OK\n\0"
  pub let rtdw_fail : [u8; 28] = "R35 TB ROUTE TEARDOWN FAIL\n\0"

  pub let rtdw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-005 (#1209): clear cap_table slots 232..239.",
      block: {
        push rbx;
        mov rbx, 232;
      rtdwc_loop:
        cmp rbx, 240;
        jae rtdwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp rtdwc_loop;
      rtdwc_done:
        pop rbx;
        ret
      }
    }

  pub let rtdw_scrub_all : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-005 (#1209): reset every table this fixture touches.",
      block: {
        push rbx;
        call tb_route_table_reset;
        call dp_tunnel_reset;
        call usb3_tunnel_reset;
        call route_teardown_reset;
        pop rbx;
        ret
      }
    }

  pub let rtdw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-005 (#1209): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // Mint a KIND_TB_ROUTE cap at `slot`. Args: (slot, route_key,
  // tunnel_type, source_adapter, sink_adapter). Uses slots 232
  // and 233 as the parent and endpoint respectively (synthesised
  // by caller). Returns 0 on success, non-zero on any refusal.
  pub let rtdw_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (route_key: u64) (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M3-005 (#1209): mint helper. packed_ident = route_id=0x000021 | tunnel_type[31:24] | source[39:32] | sink[47:40] | state=0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // route_key
        mov r13, rdx;                    // tunnel_type
        mov r14, rcx;                    // source_adapter
        mov r15, r8;                     // sink_adapter

        // Build packed_ident.
        mov r10, 0x000021;               // route_id
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 24;
        or  r10, r11;
        mov r11, r14;
        and r11, 0xFF;
        shl r11, 32;
        or  r10, r11;
        mov r11, r15;
        and r11, 0xFF;
        shl r11, 40;
        or  r10, r11;
        // state=0.

        mov rdi, rbx;
        mov rsi, 232;                    // parent = endpoint at 232
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 233;                     // endpoint_slot = 233
        mov r9, r10;
        call tb_route_cap_mint_inner;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let route_teardown_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M3-005 (#1209): boot witness. Stages: (1) refuses empty slot (NOT_ROUTE). (2) PCIe route teardown (mask==0x7, PCIe path no-op). (3) DP route teardown with pre-allocated DDI. (4) USB3 route teardown with pre-allocated xHCI port. (5) Slot empty after each teardown.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _rtdw_stage];
        mov [rcx], rax;

        call rtdw_clear;
        call rtdw_scrub_all;

        // Endpoints for parent + event.
        mov rdi, 232;
        mov rsi, 0x200;
        mov rdx, 0x4444;
        call rtdw_endpoint;

        mov rdi, 233;
        mov rsi, 0x200;
        mov rdx, 0x5555;
        call rtdw_endpoint;

        // -- 1. Refuses NOT_ROUTE on empty slot.
        mov rdi, 234;                    // empty
        call route_teardown_sequence;
        mov r11, 0xFFFFF96D;             // NOT_ROUTE
        cmp rax, r11;
        jne rtdw_fail_stage;

        // -- 2. PCIe route teardown.
        mov rax, 2;
        lea rcx, [rip + _rtdw_stage];
        mov [rcx], rax;

        mov rdi, 235;                    // slot
        mov rsi, 0xC0FFEE01;             // route_key
        mov rdx, 0;                      // PCIe
        mov rcx, 5;                      // source
        mov r8, 7;                       // sink
        call rtdw_mint;
        cmp rax, 0;
        jne rtdw_fail_stage;

        mov rdi, 235;
        call route_teardown_sequence;
        cmp rax, 0x7;                    // DRAIN + PATH(no-op) + REVOKE
        jne rtdw_fail_stage;

        // Slot must be empty.
        mov rdi, 235;
        call tb_route_row_of_slot;
        cmp rax, 0xFF;
        jne rtdw_fail_stage;

        // -- 3. DP route teardown.
        mov rax, 3;
        lea rcx, [rip + _rtdw_stage];
        mov [rcx], rax;

        // Pre-allocate a DDI for source_adapter=8.
        mov rdi, 8;
        call dp_tunnel_ddi_alloc;
        cmp rax, 16;                     // first DDI = TB_BASE
        jne rtdw_fail_stage;

        mov rdi, 236;
        mov rsi, 0xC0FFEE02;
        mov rdx, 1;                      // DP
        mov rcx, 8;                      // source (must match DDI holder)
        mov r8, 9;                       // sink
        call rtdw_mint;
        cmp rax, 0;
        jne rtdw_fail_stage;

        mov rdi, 236;
        call route_teardown_sequence;
        cmp rax, 0x7;
        jne rtdw_fail_stage;

        // Verify DDI is now free (re-alloc succeeds).
        mov rdi, 8;
        call dp_tunnel_ddi_alloc;
        cmp rax, 16;
        jne rtdw_fail_stage;

        // -- 4. USB3 route teardown.
        mov rax, 4;
        lea rcx, [rip + _rtdw_stage];
        mov [rcx], rax;

        mov rdi, 12;
        call usb3_tunnel_port_alloc;
        cmp rax, 32;                     // first port = XHCI_PORT_TB_BASE
        jne rtdw_fail_stage;

        mov rdi, 237;
        mov rsi, 0xC0FFEE03;
        mov rdx, 2;                      // USB3
        mov rcx, 12;                     // source (matches port holder)
        mov r8, 13;
        call rtdw_mint;
        cmp rax, 0;
        jne rtdw_fail_stage;

        mov rdi, 237;
        call route_teardown_sequence;
        cmp rax, 0x7;
        jne rtdw_fail_stage;

        // Verify port is now free.
        mov rdi, 12;
        call usb3_tunnel_port_alloc;
        cmp rax, 32;
        jne rtdw_fail_stage;

        // -- 5. Slot 236 also empty (verified once above; verify 237).
        mov rax, 5;
        lea rcx, [rip + _rtdw_stage];
        mov [rcx], rax;

        mov rdi, 237;
        call tb_route_row_of_slot;
        cmp rax, 0xFF;
        jne rtdw_fail_stage;

        // Counter check: COMPLETED must be 3.
        mov rdi, 1;                      // COMPLETED
        call route_teardown_stat;
        cmp rax, 3;
        jne rtdw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rtdw_ok];
        call klog_s1;

        call rtdw_scrub_all;
        call rtdw_clear;
        xor rax, rax;
        jmp rtdw_out;

      rtdw_fail_stage:
        lea rax, [rip + _rtdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rtdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rtdw_scrub_all;
        call rtdw_clear;
        mov rax, 1;

      rtdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
