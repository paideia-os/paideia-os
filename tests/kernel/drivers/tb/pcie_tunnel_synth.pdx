// tests/kernel/drivers/tb/pcie_tunnel_synth.pdx — R35.M3-001 (#1205)
//
// Boot witness for the TB4 PCIe tunnel scaffold. Asserts direction,
// adapter and route validators; happy-path path_alloc for both
// UPSTREAM and DOWNSTREAM; SELF_LOOP refusal; BAD_DIR; BAD_ROUTE;
// downstream port config OK + inverted bus range refused.
//
// Fingerprint: R35 TB PCIE TUNNEL OK

module PcieTunnelSynth = structure {

  pub let mut _ptnw_stage : u64 = 0

  pub let ptnw_ok   : [u8; 22] = "R35 TB PCIE TUNNEL OK\n\0"
  pub let ptnw_fail : [u8; 24] = "R35 TB PCIE TUNNEL FAIL\n\0"

  pub let pcie_tunnel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M3-001 (#1205): boot witness. Stages: (1) reset. (2) validators. (3) UPSTREAM alloc. (4) DOWNSTREAM alloc. (5) SELF_LOOP. (6) BAD_DIR. (7) BAD_ROUTE. (8) DS config OK. (9) DS inverted bus range refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        call pcie_tunnel_reset;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call pcie_tun_dir_valid;
        cmp rax, 1;
        jne ptnw_fail_stage;
        mov rdi, 2;
        call pcie_tun_dir_valid;
        cmp rax, 0;
        jne ptnw_fail_stage;

        mov rdi, 0xFF;
        call pcie_tun_adapter_valid;
        cmp rax, 1;
        jne ptnw_fail_stage;
        mov rdi, 0x100;
        call pcie_tun_adapter_valid;
        cmp rax, 0;
        jne ptnw_fail_stage;

        mov rdi, 0xFFFFFF;
        call pcie_tun_route_valid;
        cmp rax, 1;
        jne ptnw_fail_stage;
        mov rdi, 0x1000000;
        call pcie_tun_route_valid;
        cmp rax, 0;
        jne ptnw_fail_stage;

        // -- 3. UPSTREAM alloc.
        mov rax, 3;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;               // route
        mov rsi, 5;                      // source
        mov rdx, 7;                      // sink
        mov rcx, 0;                      // UPSTREAM
        call pcie_tunnel_path_alloc;
        cmp rax, 0;
        jne ptnw_fail_stage;

        mov rdi, 1;                      // ALLOC_UP
        call pcie_tunnel_stat;
        cmp rax, 1;
        jne ptnw_fail_stage;

        // -- 4. DOWNSTREAM alloc.
        mov rax, 4;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;
        mov rsi, 7;                      // source
        mov rdx, 5;                      // sink
        mov rcx, 1;                      // DOWNSTREAM
        call pcie_tunnel_path_alloc;
        cmp rax, 0;
        jne ptnw_fail_stage;

        mov rdi, 2;                      // ALLOC_DN
        call pcie_tunnel_stat;
        cmp rax, 1;
        jne ptnw_fail_stage;

        // -- 5. SELF_LOOP.
        mov rax, 5;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;
        mov rsi, 5;
        mov rdx, 5;                      // source == sink
        mov rcx, 0;
        call pcie_tunnel_path_alloc;
        mov r11, 0xFFFFF99B;
        cmp rax, r11;
        jne ptnw_fail_stage;

        // -- 6. BAD_DIR.
        mov rax, 6;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 0x000021;
        mov rsi, 5;
        mov rdx, 7;
        mov rcx, 2;                      // BAD direction
        call pcie_tunnel_path_alloc;
        mov r11, 0xFFFFF99E;
        cmp rax, r11;
        jne ptnw_fail_stage;

        // -- 7. BAD_ROUTE.
        mov rax, 7;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000000;              // > 24 bits
        mov rsi, 5;
        mov rdx, 7;
        mov rcx, 0;
        call pcie_tunnel_path_alloc;
        mov r11, 0xFFFFF99C;
        cmp rax, r11;
        jne ptnw_fail_stage;

        // -- 8. DS config OK.
        mov rax, 8;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        // config_word: secondary_bus=0x10, subordinate=0x18, link_speed=3
        mov rdi, 0x031810;
        call pcie_tunnel_ds_config;
        cmp rax, 0;
        jne ptnw_fail_stage;

        mov rdi, 4;                      // CONFIG
        call pcie_tunnel_stat;
        cmp rax, 1;
        jne ptnw_fail_stage;

        // -- 9. DS inverted bus range refused.
        mov rax, 9;
        lea rcx, [rip + _ptnw_stage];
        mov [rcx], rax;

        // config_word: secondary_bus=0x20, subordinate=0x10, link_speed=3
        mov rdi, 0x031020;
        call pcie_tunnel_ds_config;
        mov r11, 0xFFFFF99A;
        cmp rax, r11;
        jne ptnw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ptnw_ok];
        call klog_s1;

        call pcie_tunnel_reset;
        xor rax, rax;
        jmp ptnw_out;

      ptnw_fail_stage:
        lea rax, [rip + _ptnw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ptnw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pcie_tunnel_reset;
        mov rax, 1;

      ptnw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
