// tests/kernel/drivers/tb/sw_cm_fw_interop_synth.pdx — R35.M6-004 (#1222)
//
// Boot witness for the software-CM firmware-CM interop handshake.
//
// Asserts:
//   (a) reset leaves init flag 0; mode UNINIT; version 0; mask 0.
//   (b) NHI probe returns 0 (firmware-CM absent under QEMU).
//   (c) init(fw_present=0, ver=0x100, mask=0xF) latches ACTIVE.
//   (d) re-init refused ALREADY_INIT.
//   (e) mode/version/feature_mask readers return latched values.
//   (f) negotiate(0x7) intersects to 0x7 (0xF & 0x7 == 0x7).
//   (g) reset then init(fw_present=1, ver=0x200, mask=0x1F) latches
//       PASSIVE.
//   (h) init refuses BAD_VERSION on version > 32 bits.
//   (i) init refuses BAD_MASK on mask > 32 bits.
//   (j) negotiate before init returns DECODE_BAD.
//
// Fingerprint: R35 SW CM FW INTEROP OK
//
// No cap slots — module owns its own state cells + stats only.

module SwCmFwInteropSynth = structure {

  pub let mut _siow_stage : u64 = 0

  pub let siow_ok   : [u8; 28] = "R35 SW CM FW INTEROP OK\n\0\0\0\0"
  pub let siow_fail : [u8; 30] = "R35 SW CM FW INTEROP FAIL\n\0\0\0\0"

  pub let sw_cm_fw_interop_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M6-004 (#1222): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_fw_interop_reset;

        call sw_cm_fw_interop_is_init;
        cmp rax, 0;
        jne siow_fail_stage;
        call sw_cm_fw_interop_mode;
        cmp rax, 0;                      // UNINIT
        jne siow_fail_stage;
        call sw_cm_fw_interop_version;
        cmp rax, 0;
        jne siow_fail_stage;
        call sw_cm_fw_interop_feature_mask;
        cmp rax, 0;
        jne siow_fail_stage;

        // -- 2. NHI probe returns 0.
        mov rax, 2;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_nhi_fw_present;
        cmp rax, 0;
        jne siow_fail_stage;

        // -- 3. init ACTIVE.
        mov rax, 3;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // fw_present=0
        mov rsi, 0x100;
        mov rdx, 0xF;
        call sw_cm_fw_interop_init;
        cmp rax, 0;
        jne siow_fail_stage;

        call sw_cm_fw_interop_is_init;
        cmp rax, 1;
        jne siow_fail_stage;
        call sw_cm_fw_interop_mode;
        cmp rax, 1;                      // ACTIVE
        jne siow_fail_stage;

        // -- 4. re-init refused ALREADY_INIT.
        mov rax, 4;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x100;
        mov rdx, 0xF;
        call sw_cm_fw_interop_init;
        mov r11, 0xFFFFF89E;             // ALREADY_INIT
        cmp rax, r11;
        jne siow_fail_stage;

        // -- 5. Readers.
        mov rax, 5;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_fw_interop_version;
        cmp rax, 0x100;
        jne siow_fail_stage;
        call sw_cm_fw_interop_feature_mask;
        cmp rax, 0xF;
        jne siow_fail_stage;

        // -- 6. Negotiate.
        mov rax, 6;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        mov rdi, 0x7;
        call sw_cm_fw_interop_negotiate;
        cmp rax, 0x7;
        jne siow_fail_stage;

        // -- 7. Reset then init PASSIVE.
        mov rax, 7;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_fw_interop_reset;
        mov rdi, 1;                      // fw_present=1
        mov rsi, 0x200;
        mov rdx, 0x1F;
        call sw_cm_fw_interop_init;
        cmp rax, 0;
        jne siow_fail_stage;
        call sw_cm_fw_interop_mode;
        cmp rax, 2;                      // PASSIVE
        jne siow_fail_stage;
        call sw_cm_fw_interop_version;
        cmp rax, 0x200;
        jne siow_fail_stage;

        // -- 8. BAD_VERSION.
        mov rax, 8;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_fw_interop_reset;
        mov rdi, 0;
        mov rsi, 0x100000000;            // > 32 bits
        mov rdx, 0;
        call sw_cm_fw_interop_init;
        mov r11, 0xFFFFF89C;             // BAD_VERSION
        cmp rax, r11;
        jne siow_fail_stage;

        // -- 9. BAD_MASK.
        mov rax, 9;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x100;
        mov rdx, 0x100000000;            // > 32 bits
        call sw_cm_fw_interop_init;
        mov r11, 0xFFFFF89B;             // BAD_MASK
        cmp rax, r11;
        jne siow_fail_stage;

        // -- 10. Negotiate before init returns DECODE_BAD.
        mov rax, 10;
        lea rcx, [rip + _siow_stage];
        mov [rcx], rax;

        call sw_cm_fw_interop_reset;
        mov rdi, 0xF;
        call sw_cm_fw_interop_negotiate;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne siow_fail_stage;

        // Cleanup.
        call sw_cm_fw_interop_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + siow_ok];
        call klog_s1;

        xor rax, rax;
        jmp siow_out;

      siow_fail_stage:
        lea rax, [rip + _siow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + siow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sw_cm_fw_interop_reset;
        mov rax, 1;

      siow_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
