// tests/kernel/drivers/tb/cm_rings_synth.pdx — R35.M2-002 (#1201)
//
// Boot witness for the TB4 CM TX / RX ring scaffold. Asserts
// descriptor pack round-trip, TX submit + index advance, TX_FULL,
// RX inject + dequeue, RX_EMPTY, bad-arg refusals.
//
// Fingerprint: R35 TB CM RINGS OK

module CmRingsSynth = structure {

  pub let mut _tcmw_stage : u64 = 0

  pub let tcmw_ok   : [u8; 16] = "TB CM RINGS OK\0"
  pub let tcmw_fail : [u8; 18] = "TB CM RINGS FAIL\0"

  pub let tb_cm_rings_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M2-002 (#1201): boot witness. Stages: (1) reset + descriptor pack round-trip. (2) BAD_PDF refusal. (3) TX submit + index advance. (4) TX_FULL after filling ring. (5) RX inject + dequeue. (6) RX_EMPTY.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        call tb_cm_rings_reset;

        // Descriptor pack / unpack.
        mov rdi, 1;                      // pdf
        mov rsi, 128;                    // length
        mov rdx, 0x00ABCDEF;             // flags
        call tb_cm_desc_pack;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r11;
        je  tcmw_fail_stage;

        mov rdi, r15;
        call tb_cm_desc_pdf;
        cmp rax, 1;
        jne tcmw_fail_stage;
        mov rdi, r15;
        call tb_cm_desc_length;
        cmp rax, 128;
        jne tcmw_fail_stage;
        mov rdi, r15;
        call tb_cm_desc_flags;
        cmp rax, 0x00ABCDEF;
        jne tcmw_fail_stage;

        // -- 2. BAD_PDF.
        mov rax, 2;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // > TB_PDF_MAX
        mov rsi, 128;
        mov rdx, 0;
        call tb_cm_desc_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tcmw_fail_stage;

        // -- 3. TX submit.
        mov rax, 3;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 128;
        mov rdx, 0;
        mov rcx, 0xF0001000;             // buf_pa
        call tb_cm_tx_submit;
        cmp rax, 0;
        jne tcmw_fail_stage;

        call tb_cm_tx_prod;
        cmp rax, 1;
        jne tcmw_fail_stage;

        // Verify last descriptor.
        call tb_cm_tx_last;
        mov r15, rax;
        mov rdi, r15;
        call tb_cm_desc_pdf;
        cmp rax, 1;
        jne tcmw_fail_stage;

        // -- 4. TX_FULL after 6 more submits (ring holds 7 before full).
        mov rax, 4;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        xor rbx, rbx;
      tcmw_fill_loop:
        cmp rbx, 6;
        jae tcmw_fill_done;
        mov rdi, 1;
        mov rsi, 64;
        mov rdx, 0;
        mov rcx, 0xF0002000;
        call tb_cm_tx_submit;
        cmp rax, 0;
        jne tcmw_fail_stage;
        add rbx, 1;
        jmp tcmw_fill_loop;
      tcmw_fill_done:

        // Now ring is full — 7 submitted, cons=0, prod=7, (7+1)&7 == 0 == cons.
        mov rdi, 1;
        mov rsi, 64;
        mov rdx, 0;
        mov rcx, 0xF0003000;
        call tb_cm_tx_submit;
        mov r11, 0xFFFFF9DB;             // TX_FULL
        cmp rax, r11;
        jne tcmw_fail_stage;

        // -- 5. RX inject + dequeue.
        mov rax, 5;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // TB_PDF_ROUTER_CONFIG_RESP
        mov rsi, 32;
        mov rdx, 0x11111111;
        mov rcx, 0xF0004000;
        call tb_cm_rx_inject;
        cmp rax, 0;
        jne tcmw_fail_stage;

        call tb_cm_rx_dequeue;
        mov r15, rax;
        mov r11, 0xFFFFF9DA;
        cmp r15, r11;
        je  tcmw_fail_stage;

        mov rdi, r15;
        call tb_cm_desc_pdf;
        cmp rax, 2;
        jne tcmw_fail_stage;
        mov rdi, r15;
        call tb_cm_desc_length;
        cmp rax, 32;
        jne tcmw_fail_stage;

        // -- 6. RX_EMPTY.
        mov rax, 6;
        lea rcx, [rip + _tcmw_stage];
        mov [rcx], rax;

        call tb_cm_rx_dequeue;
        mov r11, 0xFFFFF9DA;
        cmp rax, r11;
        jne tcmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tcmw_ok];
        call klog_s1;

        call tb_cm_rings_reset;
        xor rax, rax;
        jmp tcmw_out;

      tcmw_fail_stage:
        lea rax, [rip + _tcmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tcmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tb_cm_rings_reset;
        mov rax, 1;

      tcmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
