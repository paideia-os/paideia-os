// tests/kernel/drivers/tb/usb3_xhci_ext_synth.pdx — R35.M10-001 (#1232)
//
// Boot witness for the USB3-tunnel virtual xHCI extension.
//
// Asserts:
//   (a) reset leaves binding_count == 0; all counters == 0.
//   (b) u3xe_bind(tunnel=1, base=8, count=2) succeeds;
//       binding_count == 1; BINDS == 1; find_by_slot(1) hits;
//       row_status == BOUND; row_xhci_base == 8; row_count == 2.
//   (c) u3xe_bind bad tunnel (>0xFF) refuses BAD_TUNNEL_SLOT.
//   (d) u3xe_bind bad base (256) refuses BAD_BASE.
//   (e) u3xe_bind bad count (0) refuses BAD_COUNT.
//   (f) u3xe_bind bad count (9) refuses BAD_COUNT.
//   (g) u3xe_bind base+count > 256 refuses BAD_BASE (250, 8 -> 258).
//   (h) u3xe_bind duplicate tunnel_slot refuses DUP.
//   (i) u3xe_bind overlapping range refuses OVERLAP (tunnel=2 base=9 count=1).
//   (j) u3xe_bind(tunnel=2, base=10, count=3) succeeds; binding_count == 2.
//   (k) u3xe_bind fills 4 rows; 5th refuses ENOSPC.
//   (l) u3xe_port_added(tunnel=1, port=8) succeeds; ADDED bump.
//   (m) u3xe_port_added(tunnel=1, port=10) refuses BAD_PORT (outside range).
//   (n) u3xe_port_added(tunnel=99, port=8) refuses NOT_FOUND.
//   (o) u3xe_unbind(tunnel=1) succeeds; binding_count drops by 1;
//       UNBINDS == 1; REMOVED bumped by row's port_count (2).
//   (p) u3xe_unbind(tunnel=1) again refuses NOT_FOUND.
//   (q) u3xe_unbind(tunnel=0x100) refuses BAD_TUNNEL_SLOT.
//   (r) u3xe_arbitrated() == 0 (honesty pin).
//
// Fingerprint: R35 TB USB3 XHCI EXT OK
//
// No cap slots — module owns its own rows + stats.

module Usb3XhciExtSynth = structure {

  pub let mut _u3xew_stage : u64 = 0

  pub let u3xew_ok   : [u8; 22] = "TB USB3 XHCI EXT OK\n\0\0"
  pub let u3xew_fail : [u8; 24] = "TB USB3 XHCI EXT FAIL\n\0\0"

  pub let usb3_xhci_ext_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M10-001 (#1232): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        call u3xe_reset;

        call u3xe_binding_count;
        cmp rax, 0;
        jne u3xew_fail_stage;
        mov rdi, 0;
        call u3xe_stat;
        cmp rax, 0;
        jne u3xew_fail_stage;

        // -- 2. First bind.
        mov rax, 2;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // tunnel
        mov rsi, 8;                      // base
        mov rdx, 2;                      // count
        call u3xe_bind;
        cmp rax, 0;
        jne u3xew_fail_stage;
        call u3xe_binding_count;
        cmp rax, 1;
        jne u3xew_fail_stage;
        mov rdi, 0;                      // BINDS
        call u3xe_stat;
        cmp rax, 1;
        jne u3xew_fail_stage;
        mov rdi, 1;
        call u3xe_find_by_slot;
        cmp rax, 0xFF;
        je  u3xew_fail_stage;
        mov r14, rax;                    // row id
        mov rdi, r14;
        call u3xe_row_status;
        cmp rax, 1;                      // BOUND
        jne u3xew_fail_stage;
        mov rdi, r14;
        call u3xe_row_xhci_base;
        cmp rax, 8;
        jne u3xew_fail_stage;
        mov rdi, r14;
        call u3xe_row_count;
        cmp rax, 2;
        jne u3xew_fail_stage;

        // -- 3. Bad tunnel.
        mov rax, 3;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 0;
        mov rdx, 1;
        call u3xe_bind;
        mov r11, 0xFFFFF7FE;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 4. Bad base.
        mov rax, 4;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 256;
        mov rdx, 1;
        call u3xe_bind;
        mov r11, 0xFFFFF7FD;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 5. Bad count 0.
        mov rax, 5;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 100;
        mov rdx, 0;
        call u3xe_bind;
        mov r11, 0xFFFFF7FC;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 6. Bad count 9.
        mov rax, 6;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 100;
        mov rdx, 9;
        call u3xe_bind;
        mov r11, 0xFFFFF7FC;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 7. base+count > 256.
        mov rax, 7;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 250;
        mov rdx, 8;                      // 250+8=258 > 256
        call u3xe_bind;
        mov r11, 0xFFFFF7FD;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 8. Duplicate tunnel_slot.
        mov rax, 8;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // same tunnel as row 1
        mov rsi, 100;
        mov rdx, 1;
        call u3xe_bind;
        mov r11, 0xFFFFF7FA;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 9. Overlap.
        mov rax, 9;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        // Row 1: [8, 10). Try [9, 10) — overlaps.
        mov rdi, 2;
        mov rsi, 9;
        mov rdx, 1;
        call u3xe_bind;
        mov r11, 0xFFFFF7F7;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 10. Second successful bind.
        mov rax, 10;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 10;                     // right after row 1
        mov rdx, 3;
        call u3xe_bind;
        cmp rax, 0;
        jne u3xew_fail_stage;
        call u3xe_binding_count;
        cmp rax, 2;
        jne u3xew_fail_stage;

        // -- 11. Fill rows 3 and 4; 5th refuses ENOSPC.
        mov rax, 11;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 20;
        mov rdx, 1;
        call u3xe_bind;
        cmp rax, 0;
        jne u3xew_fail_stage;

        mov rdi, 4;
        mov rsi, 22;
        mov rdx, 1;
        call u3xe_bind;
        cmp rax, 0;
        jne u3xew_fail_stage;
        call u3xe_binding_count;
        cmp rax, 4;
        jne u3xew_fail_stage;

        // Fifth refuses ENOSPC.
        mov rdi, 5;
        mov rsi, 30;
        mov rdx, 1;
        call u3xe_bind;
        mov r11, 0xFFFFF7F9;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 12. port_added — in range.
        mov rax, 12;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // ADDED baseline
        call u3xe_stat;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 8;                      // in row 1 [8, 10)
        call u3xe_port_added;
        cmp rax, 0;
        jne u3xew_fail_stage;
        mov rdi, 2;
        call u3xe_stat;
        mov r15, r14;
        add r15, 1;
        cmp rax, r15;
        jne u3xew_fail_stage;

        // -- 13. port_added — out of range.
        mov rax, 13;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 10;                     // just past row 1's end
        call u3xe_port_added;
        mov r11, 0xFFFFF7FB;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 14. port_added — no such tunnel.
        mov rax, 14;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 8;
        call u3xe_port_added;
        mov r11, 0xFFFFF7F8;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 15. Unbind tunnel_slot=1. Row had count=2 → REMOVED += 2.
        mov rax, 15;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // REMOVED baseline
        call u3xe_stat;
        mov r14, rax;

        mov rdi, 1;
        call u3xe_unbind;
        cmp rax, 0;
        jne u3xew_fail_stage;
        call u3xe_binding_count;
        cmp rax, 3;
        jne u3xew_fail_stage;
        mov rdi, 1;                      // UNBINDS
        call u3xe_stat;
        cmp rax, 1;
        jne u3xew_fail_stage;
        mov rdi, 3;                      // REMOVED
        call u3xe_stat;
        mov r15, r14;
        add r15, 2;                      // count was 2
        cmp rax, r15;
        jne u3xew_fail_stage;

        // -- 16. Double unbind.
        mov rax, 16;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call u3xe_unbind;
        mov r11, 0xFFFFF7F8;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 17. Bad-tunnel unbind.
        mov rax, 17;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        call u3xe_unbind;
        mov r11, 0xFFFFF7FE;
        cmp rax, r11;
        jne u3xew_fail_stage;

        // -- 18. Arbitrated is 0.
        mov rax, 18;
        lea rcx, [rip + _u3xew_stage];
        mov [rcx], rax;

        call u3xe_arbitrated;
        cmp rax, 0;
        jne u3xew_fail_stage;

        // Cleanup.
        call u3xe_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + u3xew_ok];
        call klog_s1;

        xor rax, rax;
        jmp u3xew_out;

      u3xew_fail_stage:
        lea rax, [rip + _u3xew_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + u3xew_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call u3xe_reset;
        mov rax, 1;

      u3xew_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
