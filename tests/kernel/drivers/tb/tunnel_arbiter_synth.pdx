// tests/kernel/drivers/tb/tunnel_arbiter_synth.pdx — R35.M8-001 (#1226)
//
// Boot witness for TB4 per-link bandwidth arbitration.
//
// Asserts:
//   (a) reset leaves all counters and rows at 0; no domain has a row.
//   (b) tarb_reserve with bad tunnel_type refuses BAD_TYPE.
//   (c) tarb_reserve with gbps == 0 refuses BAD_ARG.
//   (d) tarb_reserve(domain=1, DP, 33) refuses EXCEEDS_TYPE_CAP
//       (DP cap = 32).
//   (e) tarb_reserve(domain=1, USB3, 11) refuses EXCEEDS_TYPE_CAP
//       (USB3 cap = 10).
//   (f) tarb_reserve(domain=1, DP, 32) succeeds; tarb_used == 32.
//   (g) tarb_reserve(domain=1, PCIe, 8) succeeds (32 + 8 = 40, at cap);
//       tarb_total_used(1) == 40.
//   (h) tarb_reserve(domain=1, USB3, 1) refuses EXCEEDS_TOTAL
//       (would push total to 41).
//   (i) tarb_release(domain=1, DP, 32) succeeds; tarb_used == 0;
//       total == 8.
//   (j) tarb_release(domain=1, PCIe, 9) refuses UNDERFLOW.
//   (k) tarb_release(domain=99, DP, 1) refuses NOT_FOUND.
//   (l) Fill all 4 domain rows; the 5th (unique domain) refuses
//       ENOSPC through tarb_reserve.
//   (m) tarb_type_cap(DP) == 32, tarb_type_cap(USB3) == 10,
//       tarb_type_cap(PCIe) == 32.
//
// Fingerprint: R35 TB TUNNEL ARBITER OK
//
// No cap slots — module owns its own rows + stats.

module TunnelArbiterSynth = structure {

  pub let mut _tarbw_stage : u64 = 0

  pub let tarbw_ok   : [u8; 25] = "TB TUNNEL ARBITER OK\n\0\0\0\0"
  pub let tarbw_fail : [u8; 27] = "TB TUNNEL ARBITER FAIL\n\0\0\0\0"

  pub let tunnel_arbiter_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M8-001 (#1226): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        call tarb_reset;

        // -- 1. Reset postconditions.
        mov rdi, 1;
        call tarb_domain_find;
        cmp rax, 0xFF;
        jne tarbw_fail_stage;
        mov rdi, 1;
        call tarb_total_used;
        cmp rax, 0;
        jne tarbw_fail_stage;

        // -- 2. Bad tunnel_type.
        mov rax, 2;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 3;                      // bad type
        mov rdx, 4;
        call tarb_reserve;
        mov r11, 0xFFFFF85E;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 3. gbps == 0.
        mov rax, 3;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // DP
        mov rdx, 0;
        call tarb_reserve;
        mov r11, 0xFFFFF85F;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 4. DP request > 32 Gbps refuses TYPE_CAP.
        mov rax, 4;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // DP
        mov rdx, 33;
        call tarb_reserve;
        mov r11, 0xFFFFF85B;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 5. USB3 request > 10 Gbps refuses TYPE_CAP.
        mov rax, 5;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 2;                      // USB3
        mov rdx, 11;
        call tarb_reserve;
        mov r11, 0xFFFFF85B;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 6. Successful DP reserve at cap.
        mov rax, 6;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // DP
        mov rdx, 32;
        call tarb_reserve;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 1;
        mov rsi, 1;
        call tarb_used;
        cmp rax, 32;
        jne tarbw_fail_stage;

        // -- 7. PCIe reserve of 8 -- total exactly 40.
        mov rax, 7;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;                      // PCIe
        mov rdx, 8;
        call tarb_reserve;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 1;
        call tarb_total_used;
        cmp rax, 40;
        jne tarbw_fail_stage;

        // -- 8. USB3 reserve of 1 refuses EXCEEDS_TOTAL.
        mov rax, 8;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 2;                      // USB3
        mov rdx, 1;
        call tarb_reserve;
        mov r11, 0xFFFFF85C;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 9. Release DP.
        mov rax, 9;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // DP
        mov rdx, 32;
        call tarb_release;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 1;
        mov rsi, 1;
        call tarb_used;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 1;
        call tarb_total_used;
        cmp rax, 8;
        jne tarbw_fail_stage;

        // -- 10. Underflow release.
        mov rax, 10;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;                      // PCIe (currently 8)
        mov rdx, 9;
        call tarb_release;
        mov r11, 0xFFFFF85A;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 11. Release from unknown domain.
        mov rax, 11;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 1;
        mov rdx, 1;
        call tarb_release;
        mov r11, 0xFFFFF859;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 12. Fill all 4 domain rows; 5th refuses ENOSPC.
        //        domain 1 already has a row. Add domains 2, 3, 4.
        mov rax, 12;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 1;
        call tarb_reserve;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 3;
        mov rsi, 1;
        mov rdx, 1;
        call tarb_reserve;
        cmp rax, 0;
        jne tarbw_fail_stage;
        mov rdi, 4;
        mov rsi, 1;
        mov rdx, 1;
        call tarb_reserve;
        cmp rax, 0;
        jne tarbw_fail_stage;

        // Fifth unique domain must refuse ENOSPC.
        mov rdi, 5;
        mov rsi, 1;
        mov rdx, 1;
        call tarb_reserve;
        mov r11, 0xFFFFF858;
        cmp rax, r11;
        jne tarbw_fail_stage;

        // -- 13. Per-type cap accessor.
        mov rax, 13;
        lea rcx, [rip + _tarbw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // DP
        call tarb_type_cap;
        cmp rax, 32;
        jne tarbw_fail_stage;
        mov rdi, 2;                      // USB3
        call tarb_type_cap;
        cmp rax, 10;
        jne tarbw_fail_stage;
        mov rdi, 0;                      // PCIe
        call tarb_type_cap;
        cmp rax, 32;
        jne tarbw_fail_stage;

        // Cleanup.
        call tarb_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tarbw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tarbw_out;

      tarbw_fail_stage:
        lea rax, [rip + _tarbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tarbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tarb_reset;
        mov rax, 1;

      tarbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
