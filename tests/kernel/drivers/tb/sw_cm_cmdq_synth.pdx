// tests/kernel/drivers/tb/sw_cm_cmdq_synth.pdx — R35.M6-002 (#1220)
//
// Boot witness for the software-CM host-driven command queue.
//
// Asserts:
//   (a) reset leaves prod == cons == 0 and seq_next == 0.
//   (b) enqueue with a valid cmd_type returns a non-zero seq_tag;
//       repeated enqueues bump seq monotonically.
//   (c) enqueue with cmd_type > MAX refuses BAD_TYPE.
//   (d) peek returns the field values just enqueued (seq_tag,
//       cmd_type, arg0, arg1).
//   (e) dequeue returns the enqueued seq_tag and advances consumer.
//   (f) dequeue on empty refuses EMPTY.
//   (g) fill to 31 commands (SIZE - 1 = ring-full boundary) then
//       32nd enqueue refuses FULL. Drain empties.
//
// Fingerprint: R35 SW CM CMDQ OK
//
// No cap slots — module owns its own ring + indices + seq + stats.

module SwCmCmdqSynth = structure {

  pub let mut _scqw_stage : u64 = 0

  pub let scqw_ok   : [u8; 18] = "SW CM CMDQ OK\n\0\0\0\0"
  pub let scqw_fail : [u8; 20] = "SW CM CMDQ FAIL\n\0\0\0\0"

  pub let sw_cm_cmdq_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M6-002 (#1220): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        call sw_cm_cmdq_reset;

        call sw_cm_cmdq_prod;
        cmp rax, 0;
        jne scqw_fail_stage;
        call sw_cm_cmdq_cons;
        cmp rax, 0;
        jne scqw_fail_stage;
        call sw_cm_cmdq_seq_next;
        cmp rax, 0;
        jne scqw_fail_stage;

        // -- 2. Enqueue PROBE_PATH(slot=7); seq_tag == 1.
        mov rax, 2;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // PROBE_PATH
        mov rsi, 7;                      // arg0 slot
        mov rdx, 0;                      // arg1
        call sw_cm_cmdq_enqueue;
        cmp rax, 1;
        jne scqw_fail_stage;

        // Second enqueue -> seq_tag == 2.
        mov rdi, 1;                      // CONNECT_PORT
        mov rsi, 8;
        mov rdx, 0;
        call sw_cm_cmdq_enqueue;
        cmp rax, 2;
        jne scqw_fail_stage;

        // -- 3. BAD_TYPE.
        mov rax, 3;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // > SWCMD_MAX
        mov rsi, 0;
        mov rdx, 0;
        call sw_cm_cmdq_enqueue;
        mov r11, 0xFFFFF8BE;             // BAD_TYPE
        cmp rax, r11;
        jne scqw_fail_stage;

        // -- 4. Peek fields of oldest (PROBE_PATH slot=7 seq=1).
        mov rax, 4;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // seq_tag field
        call sw_cm_cmdq_peek_field;
        cmp rax, 1;
        jne scqw_fail_stage;
        mov rdi, 1;                      // cmd_type
        call sw_cm_cmdq_peek_field;
        cmp rax, 0;                      // PROBE_PATH
        jne scqw_fail_stage;
        mov rdi, 2;                      // arg0
        call sw_cm_cmdq_peek_field;
        cmp rax, 7;
        jne scqw_fail_stage;

        // -- 5. Dequeue -> 1.
        mov rax, 5;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        call sw_cm_cmdq_dequeue;
        cmp rax, 1;
        jne scqw_fail_stage;

        // Second dequeue -> 2.
        call sw_cm_cmdq_dequeue;
        cmp rax, 2;
        jne scqw_fail_stage;

        // -- 6. Dequeue on empty refuses EMPTY.
        mov rax, 6;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        call sw_cm_cmdq_dequeue;
        mov r11, 0xFFFFF8BC;             // EMPTY
        cmp rax, r11;
        jne scqw_fail_stage;

        // -- 7. Fill to 31 then 32nd refuses FULL. Drain empties.
        mov rax, 7;
        lea rcx, [rip + _scqw_stage];
        mov [rcx], rax;

        mov rbx, 31;
      scqw_fill_loop:
        cmp rbx, 0;
        je  scqw_fill_done;
        mov rdi, 2;                      // ESTABLISH_TUNNEL
        mov rsi, 0;
        mov rdx, 0;
        call sw_cm_cmdq_enqueue;
        cmp rax, 0;
        je  scqw_fail_stage;             // should return a positive seq_tag
        mov r11, 0xFFFFF8BD;             // FULL
        cmp rax, r11;
        je  scqw_fail_stage;
        sub rbx, 1;
        jmp scqw_fill_loop;
      scqw_fill_done:

        // 32nd -> FULL.
        mov rdi, 2;
        mov rsi, 0;
        mov rdx, 0;
        call sw_cm_cmdq_enqueue;
        mov r11, 0xFFFFF8BD;
        cmp rax, r11;
        jne scqw_fail_stage;

        // Drain.
        mov rbx, 31;
      scqw_drain_loop:
        cmp rbx, 0;
        je  scqw_drain_done;
        call sw_cm_cmdq_dequeue;
        mov r11, 0xFFFFF8BC;
        cmp rax, r11;
        je  scqw_fail_stage;
        sub rbx, 1;
        jmp scqw_drain_loop;
      scqw_drain_done:

        call sw_cm_cmdq_dequeue;
        mov r11, 0xFFFFF8BC;
        cmp rax, r11;
        jne scqw_fail_stage;

        // Cleanup.
        call sw_cm_cmdq_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scqw_ok];
        call klog_s1;

        xor rax, rax;
        jmp scqw_out;

      scqw_fail_stage:
        lea rax, [rip + _scqw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scqw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sw_cm_cmdq_reset;
        mov rax, 1;

      scqw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
