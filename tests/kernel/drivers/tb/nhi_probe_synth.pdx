// tests/kernel/drivers/tb/nhi_probe_synth.pdx — R35.M2-001 (#1200)
//
// Boot witness for the TB4 NHI probe scaffold. Asserts class-triple
// discrimination, vendor filter, BAR alignment, cap0 rings/ports
// decode, and end-to-end recognise round-trip.
//
// Fingerprint: R35 TB NHI PROBE OK

module NhiProbeSynth = structure {

  pub let mut _tnpw_stage : u64 = 0

  pub let tnpw_ok   : [u8; 17] = "TB NHI PROBE OK\n\0"
  pub let tnpw_fail : [u8; 19] = "TB NHI PROBE FAIL\n\0"

  pub let tb_nhi_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M2-001 (#1200): boot witness. Stages: (1) reset. (2) class triple valid + invalid. (3) vendor valid + invalid. (4) alignment. (5) cap0 decode rings + ports. (6) happy path recognise. (7) BAD_CLASS. (8) BAD_VENDOR. (9) MISALIGNED. (10) NO_RINGS.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        call tb_nhi_probe_reset;

        // -- 2. Class triple.
        mov rax, 2;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0340;
        call tb_nhi_class_valid;
        cmp rax, 1;
        jne tnpw_fail_stage;

        mov rdi, 0x0C0330;
        call tb_nhi_class_valid;
        cmp rax, 0;
        jne tnpw_fail_stage;

        // -- 3. Vendor.
        mov rax, 3;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        call tb_nhi_vendor_valid;
        cmp rax, 1;
        jne tnpw_fail_stage;

        mov rdi, 0x1022;
        call tb_nhi_vendor_valid;
        cmp rax, 0;
        jne tnpw_fail_stage;

        // -- 4. Alignment.
        mov rax, 4;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;
        call tb_nhi_bar_aligned;
        cmp rax, 1;
        jne tnpw_fail_stage;

        mov rdi, 0xF0000800;
        call tb_nhi_bar_aligned;
        cmp rax, 0;
        jne tnpw_fail_stage;

        // -- 5. cap0 decode.
        mov rax, 5;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0208;                 // ports=0x20, rings=8
        call tb_nhi_decode_rings;
        cmp rax, 8;
        jne tnpw_fail_stage;

        mov rdi, 0x0208;
        call tb_nhi_decode_ports;
        cmp rax, 0x20;
        jne tnpw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0340;               // class triple
        mov rsi, 0x8086;                 // vendor
        mov rdx, 0xF0000000;             // bar_base (64K aligned)
        mov rcx, 0x10000;                // bar_len = 64K
        mov r8, 0x0208;                  // cap0
        call tb_nhi_probe_recognise;
        cmp rax, 0x2008;                 // rings=8 | (ports=0x20 << 8)
        jne tnpw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call tb_nhi_probe_stat;
        cmp rax, 1;
        jne tnpw_fail_stage;

        // -- 7. BAD_CLASS.
        mov rax, 7;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0330;
        mov rsi, 0x8086;
        mov rdx, 0xF0000000;
        mov rcx, 0x10000;
        mov r8, 0x0208;
        call tb_nhi_probe_recognise;
        mov r11, 0xFFFFF9EE;
        cmp rax, r11;
        jne tnpw_fail_stage;

        // -- 8. BAD_VENDOR.
        mov rax, 8;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0340;
        mov rsi, 0x1022;
        mov rdx, 0xF0000000;
        mov rcx, 0x10000;
        mov r8, 0x0208;
        call tb_nhi_probe_recognise;
        mov r11, 0xFFFFF9ED;
        cmp rax, r11;
        jne tnpw_fail_stage;

        // -- 9. MISALIGNED.
        mov rax, 9;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0340;
        mov rsi, 0x8086;
        mov rdx, 0xF0000800;             // not 64K aligned
        mov rcx, 0x10000;
        mov r8, 0x0208;
        call tb_nhi_probe_recognise;
        mov r11, 0xFFFFF9EB;
        cmp rax, r11;
        jne tnpw_fail_stage;

        // -- 10. NO_RINGS.
        mov rax, 10;
        lea rcx, [rip + _tnpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0C0340;
        mov rsi, 0x8086;
        mov rdx, 0xF0000000;
        mov rcx, 0x10000;
        mov r8, 0x0200;                  // ports=0x20, rings=0
        call tb_nhi_probe_recognise;
        mov r11, 0xFFFFF9E9;
        cmp rax, r11;
        jne tnpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tnpw_ok];
        call klog_s1;

        call tb_nhi_probe_reset;
        xor rax, rax;
        jmp tnpw_out;

      tnpw_fail_stage:
        lea rax, [rip + _tnpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tnpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tb_nhi_probe_reset;
        mov rax, 1;

      tnpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
