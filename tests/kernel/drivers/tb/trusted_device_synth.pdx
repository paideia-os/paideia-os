// tests/kernel/drivers/tb/trusted_device_synth.pdx — R35.M5-003 (#1217)
//
// Boot witness for the TB4 trusted-device enrollment table.
//
// Asserts:
//   (a) reset -> lookup on any fingerprint returns ROW_NONE
//   (b) fingerprint is deterministic across two calls with the same
//       inputs
//   (c) enroll returns a valid row_id, lookup finds it, always_trust
//       reads back
//   (d) enroll of the same (uuid, fw_version) returns IN_USE
//   (e) enroll of the same UUID with a DIFFERENT fw_version produces
//       a DIFFERENT fingerprint (firmware sensitivity, §1)
//   (f) forget releases the row; a subsequent lookup returns ROW_NONE
//       and a re-enroll of the same inputs succeeds again
//   (g) fill 32 slots, 33rd refuses ENOSPC
//
// Fingerprint: R35 TB TRUSTED DEVICE OK
//
// No cap slots — module owns a private table + stats only.

module TrustedDeviceSynth = structure {

  pub let mut _tdw_stage : u64 = 0

  pub let tdw_ok   : [u8; 22] = "TB TRUSTED DEVICE OK\0"
  pub let tdw_fail : [u8; 24] = "TB TRUSTED DEVICE FAIL\0"

  pub let trusted_device_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M5-003 (#1217): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        call trusted_device_reset;

        // -- 1. Empty table lookup returns ROW_NONE.
        mov rdi, 0x12345678;
        call trusted_device_lookup;
        cmp rax, 0xFF;
        jne tdw_fail_stage;

        // -- 2. Fingerprint determinism.
        mov rax, 2;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010203;             // fw_version
        call trusted_device_fingerprint;
        mov r14, rax;                    // fp1

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010203;
        call trusted_device_fingerprint;
        cmp rax, r14;
        jne tdw_fail_stage;

        // Sanity: not zero (CRC32(0xDEADBEEF...) is not zero).
        cmp rax, 0;
        je  tdw_fail_stage;

        // -- 3. Enroll returns row_id; lookup finds it; always_trust reads.
        mov rax, 3;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010203;
        mov rcx, 1;                      // always_trust=1
        call trusted_device_enroll;
        cmp rax, 32;
        jae tdw_fail_stage;
        mov r15, rax;                    // row_id

        mov rdi, r14;                    // fp1
        call trusted_device_lookup;
        cmp rax, r15;
        jne tdw_fail_stage;

        mov rdi, r15;
        call trusted_device_always_trust;
        cmp rax, 1;
        jne tdw_fail_stage;

        // -- 4. Duplicate enroll returns IN_USE.
        mov rax, 4;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010203;
        mov rcx, 0;
        call trusted_device_enroll;
        mov r11, 0xFFFFF8ED;             // IN_USE
        cmp rax, r11;
        jne tdw_fail_stage;

        // -- 5. Firmware version sensitivity.
        mov rax, 5;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010204;             // bumped fw
        call trusted_device_fingerprint;
        cmp rax, r14;
        je  tdw_fail_stage;              // MUST differ

        // -- 6. Forget releases the row; re-enroll succeeds.
        mov rax, 6;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call trusted_device_forget;
        cmp rax, 0;
        jne tdw_fail_stage;

        mov rdi, r14;
        call trusted_device_lookup;
        cmp rax, 0xFF;
        jne tdw_fail_stage;

        mov rdi, 0xDEADBEEFCAFEBABE;
        mov rsi, 0x0123456789ABCDEF;
        mov rdx, 0x00010203;
        mov rcx, 0;
        call trusted_device_enroll;
        cmp rax, 32;
        jae tdw_fail_stage;

        // -- 7. Fill to 32 (one already enrolled at fw 0x00010203);
        // enroll 31 more with distinct UUIDs, then 33rd -> ENOSPC.
        mov rax, 7;
        lea rcx, [rip + _tdw_stage];
        mov [rcx], rax;

        mov rbx, 1;                      // uuid_lo counter (start at 1 so distinct from top enrollment)
      tdw_fill_loop:
        cmp rbx, 32;
        jae tdw_fill_done;
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call trusted_device_enroll;
        cmp rax, 32;
        jae tdw_fail_stage;              // failing enroll refused
        add rbx, 1;
        jmp tdw_fill_loop;
      tdw_fill_done:

        // 33rd enroll -> ENOSPC.
        mov rdi, 100;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call trusted_device_enroll;
        mov r11, 0xFFFFF8EC;             // ENOSPC
        cmp rax, r11;
        jne tdw_fail_stage;

        // Cleanup.
        call trusted_device_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tdw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tdw_out;

      tdw_fail_stage:
        lea rax, [rip + _tdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call trusted_device_reset;
        mov rax, 1;

      tdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
