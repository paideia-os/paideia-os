// tests/kernel/drivers/tb/tunnel_priority_synth.pdx — R35.M8-003 (#1228)
//
// Boot witness for TB4 tunnel priority policy.
//
// Asserts:
//   (a) reset leaves counters + overrides at 0.
//   (b) tpri_default_of(DP=1)   == 0 (highest).
//       tpri_default_of(PCIe=0) == 1.
//       tpri_default_of(USB3=2) == 2 (lowest).
//       tpri_default_of(bad)    == DECODE_BAD.
//   (c) tpri_of(any domain, DP) with no override returns 0.
//       tpri_of(any domain, USB3) with no override returns 2.
//   (d) tpri_may_preempt(new=DP=1, existing=PCIe=0) == 1
//       (DP prio 0 < PCIe prio 1).
//   (e) tpri_may_preempt(new=PCIe=0, existing=DP=1) == 0
//       (PCIe prio 1 !< DP prio 0).
//   (f) tpri_may_preempt(new=DP=1, existing=USB3=2) == 1.
//   (g) tpri_may_preempt(new=USB3=2, existing=DP=1) == 0.
//   (h) tpri_may_preempt(new=DP=1, existing=DP=1) == 0 (strict).
//   (i) tpri_override(domain=42, PCIe, prio=0) succeeds;
//       tpri_of(42, PCIe) == 0 (override wins);
//       tpri_of(43, PCIe) == 1 (other domain still default).
//   (j) tpri_override(domain=42, PCIe, prio=5) updates in place;
//       tpri_of(42, PCIe) == 5.
//   (k) tpri_clear_override(42, PCIe) succeeds; tpri_of(42, PCIe) == 1.
//   (l) tpri_clear_override(42, PCIe) again refuses NOT_FOUND.
//   (m) tpri_override with bad type refuses BAD_TYPE.
//   (n) tpri_override with bad priority (>0xFF) refuses BAD_PRIO.
//   (o) tpri_override with bad domain (>0xFFFF) refuses BAD_DOMAIN.
//   (p) Fill all 8 override slots; the 9th refuses ENOSPC.
//
// Fingerprint: R35 TB TUNNEL PRIORITY OK
//
// No cap slots — module owns its own overrides + stats.

module TunnelPrioritySynth = structure {

  pub let mut _tpriw_stage : u64 = 0

  pub let tpriw_ok   : [u8; 31] = "R35 TB TUNNEL PRIORITY OK\n\0\0\0\0\0"
  pub let tpriw_fail : [u8; 33] = "R35 TB TUNNEL PRIORITY FAIL\n\0\0\0\0\0"

  pub let tunnel_priority_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M8-003 (#1228): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        call tpri_reset;

        // -- 2. Defaults.
        mov rax, 2;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // DP
        call tpri_default_of;
        cmp rax, 0;
        jne tpriw_fail_stage;
        mov rdi, 0;                      // PCIe
        call tpri_default_of;
        cmp rax, 1;
        jne tpriw_fail_stage;
        mov rdi, 2;                      // USB3
        call tpri_default_of;
        cmp rax, 2;
        jne tpriw_fail_stage;
        mov rdi, 3;                      // bad
        call tpri_default_of;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // -- 3. tpri_of falls back to default when no override.
        mov rax, 3;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 1;                      // DP
        call tpri_of;
        cmp rax, 0;
        jne tpriw_fail_stage;
        mov rdi, 7;
        mov rsi, 2;                      // USB3
        call tpri_of;
        cmp rax, 2;
        jne tpriw_fail_stage;

        // -- 4..8. may_preempt cases.
        mov rax, 4;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // DP
        mov rsi, 0;                      // PCIe
        call tpri_may_preempt;
        cmp rax, 1;
        jne tpriw_fail_stage;

        mov rdi, 0;                      // PCIe
        mov rsi, 1;                      // DP
        call tpri_may_preempt;
        cmp rax, 0;
        jne tpriw_fail_stage;

        mov rdi, 1;                      // DP
        mov rsi, 2;                      // USB3
        call tpri_may_preempt;
        cmp rax, 1;
        jne tpriw_fail_stage;

        mov rdi, 2;                      // USB3
        mov rsi, 1;                      // DP
        call tpri_may_preempt;
        cmp rax, 0;
        jne tpriw_fail_stage;

        mov rdi, 1;                      // DP
        mov rsi, 1;                      // DP
        call tpri_may_preempt;
        cmp rax, 0;
        jne tpriw_fail_stage;

        // -- 9. Override.
        mov rax, 9;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0;                      // PCIe
        mov rdx, 0;
        call tpri_override;
        cmp rax, 0;
        jne tpriw_fail_stage;

        mov rdi, 42;
        mov rsi, 0;
        call tpri_of;
        cmp rax, 0;
        jne tpriw_fail_stage;

        mov rdi, 43;
        mov rsi, 0;
        call tpri_of;
        cmp rax, 1;                      // still default
        jne tpriw_fail_stage;

        // -- 10. Update override in place.
        mov rax, 10;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0;
        mov rdx, 5;
        call tpri_override;
        cmp rax, 0;
        jne tpriw_fail_stage;
        mov rdi, 42;
        mov rsi, 0;
        call tpri_of;
        cmp rax, 5;
        jne tpriw_fail_stage;

        // -- 11. Clear override.
        mov rax, 11;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0;
        call tpri_clear_override;
        cmp rax, 0;
        jne tpriw_fail_stage;
        mov rdi, 42;
        mov rsi, 0;
        call tpri_of;
        cmp rax, 1;                      // back to default
        jne tpriw_fail_stage;

        // -- 12. Double clear refuses NOT_FOUND.
        mov rax, 12;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 42;
        mov rsi, 0;
        call tpri_clear_override;
        mov r11, 0xFFFFF83A;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // -- 13. Bad type.
        mov rax, 13;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 3;
        mov rdx, 0;
        call tpri_override;
        mov r11, 0xFFFFF83E;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // -- 14. Bad priority.
        mov rax, 14;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0x100;
        call tpri_override;
        mov r11, 0xFFFFF83C;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // -- 15. Bad domain.
        mov rax, 15;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        mov rdi, 0x10000;
        mov rsi, 0;
        mov rdx, 0;
        call tpri_override;
        mov r11, 0xFFFFF83D;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // -- 16. Fill 8 slots then refuse ENOSPC.
        mov rax, 16;
        lea rcx, [rip + _tpriw_stage];
        mov [rcx], rax;

        // Stamp 8 unique (domain, type) pairs. Use domain 100..107, type=0.
        mov rbx, 100;
      tpriw_fill_scan:
        cmp rbx, 108;
        jae tpriw_fill_done;
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 3;
        call tpri_override;
        cmp rax, 0;
        jne tpriw_fail_stage;
        add rbx, 1;
        jmp tpriw_fill_scan;
      tpriw_fill_done:

        // Ninth unique pair must refuse ENOSPC.
        mov rdi, 200;
        mov rsi, 0;
        mov rdx, 3;
        call tpri_override;
        mov r11, 0xFFFFF83B;
        cmp rax, r11;
        jne tpriw_fail_stage;

        // Cleanup.
        call tpri_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tpriw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tpriw_out;

      tpriw_fail_stage:
        lea rax, [rip + _tpriw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tpriw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tpri_reset;
        mov rax, 1;

      tpriw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
