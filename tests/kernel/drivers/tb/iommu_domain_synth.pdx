// tests/kernel/drivers/tb/iommu_domain_synth.pdx — R35.M4-004 (#1213)
//
// Boot witness for the per-dock IOMMU domain allocator.
//
// Asserts allocation refusal on bad dock, IN_USE on double alloc,
// ALLOCATED -> MAPPED -> UNMAPPED -> UNALLOCATED lattice, refusal
// of MAPPED -> UNALLOCATED shortcut, ENOSPC when all 16 slots
// consumed.
//
// Fingerprint: R35 TB IOMMU DOMAIN OK
//
// No cap slots — module owns a private table only.

module IommuDomainSynth = structure {

  pub let mut _idmw_stage : u64 = 0

  pub let idmw_ok   : [u8; 24] = "R35 TB IOMMU DOMAIN OK\n\0"
  pub let idmw_fail : [u8; 26] = "R35 TB IOMMU DOMAIN FAIL\n\0"

  pub let iommu_domain_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M4-004 (#1213): boot witness. Stages: (1) reset + BAD_DOCK on dock=0. (2) alloc + find_by_dock round-trip. (3) IN_USE on double alloc. (4) ALLOCATED -> MAPPED. (5) MAPPED -> UNALLOCATED refused. (6) MAPPED -> UNMAPPED -> UNALLOCATED. (7) NOT_HELD on release of free slot.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        call iommu_domain_reset;

        // -- 1. BAD_DOCK on dock=0.
        mov rdi, 0;
        call iommu_domain_alloc;
        mov r11, 0xFFFFF92D;             // BAD_DOCK
        cmp rax, r11;
        jne idmw_fail_stage;

        // -- 2. Alloc + find_by_dock.
        mov rax, 2;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        call iommu_domain_alloc;
        mov r15, rax;                    // domain_id
        cmp r15, 16;
        jae idmw_fail_stage;

        mov rdi, 0x11;
        call iommu_domain_find_by_dock;
        cmp rax, r15;
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 1;                      // ALLOCATED
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_dock_of;
        cmp rax, 0x11;
        jne idmw_fail_stage;

        // -- 3. IN_USE on double alloc.
        mov rax, 3;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        call iommu_domain_alloc;
        mov r11, 0xFFFFF929;             // IN_USE
        cmp rax, r11;
        jne idmw_fail_stage;

        // -- 4. ALLOCATED -> MAPPED.
        mov rax, 4;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call iommu_domain_mark_mapped;
        cmp rax, 0;
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 2;                      // MAPPED
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_mapped_count;
        cmp rax, 1;
        jne idmw_fail_stage;

        // -- 5. MAPPED -> UNALLOCATED refused.
        mov rax, 5;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call iommu_domain_release;
        mov r11, 0xFFFFF92B;             // BAD_TRANSITION
        cmp rax, r11;
        jne idmw_fail_stage;

        // -- 6. MAPPED -> UNMAPPED -> UNALLOCATED.
        mov rax, 6;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call iommu_domain_mark_unmapped;
        cmp rax, 0;
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 3;                      // UNMAPPED
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_mapped_count;
        cmp rax, 0;
        jne idmw_fail_stage;

        // Idempotent unmap.
        mov rdi, r15;
        call iommu_domain_mark_unmapped;
        cmp rax, 0;
        jne idmw_fail_stage;

        // Release.
        mov rdi, r15;
        call iommu_domain_release;
        cmp rax, 0;
        jne idmw_fail_stage;

        mov rdi, r15;
        call iommu_domain_state_of;
        cmp rax, 0;                      // UNALLOCATED
        jne idmw_fail_stage;

        // -- 7. NOT_HELD on release of free slot.
        mov rax, 7;
        lea rcx, [rip + _idmw_stage];
        mov [rcx], rax;

        mov rdi, r15;
        call iommu_domain_release;
        mov r11, 0xFFFFF928;             // NOT_HELD
        cmp rax, r11;
        jne idmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + idmw_ok];
        call klog_s1;

        call iommu_domain_reset;
        xor rax, rax;
        jmp idmw_out;

      idmw_fail_stage:
        lea rax, [rip + _idmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + idmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call iommu_domain_reset;
        mov rax, 1;

      idmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
