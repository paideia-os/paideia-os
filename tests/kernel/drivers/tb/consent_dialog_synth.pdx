// tests/kernel/drivers/tb/consent_dialog_synth.pdx — R35.M4-003 (#1212)
//
// Boot witness for the consent-dialog policy scaffold.
//
// Asserts default deny-untrusted policy denies, AUTO_GRANT policy
// grants, audit ring records both, transition refusal on
// already-decided attestation.
//
// Fingerprint: R35 TB CONSENT DIALOG OK
//
// Cap slots 248..251 — a fresh range, disjoint from every prior
// witness's set (dma_attestation_synth 240..247). Both exits scrub
// the range and every table this fixture touches.

module ConsentDialogSynth = structure {

  pub let mut _cdgw_stage : u64 = 0

  pub let cdgw_ok   : [u8; 22] = "TB CONSENT DIALOG OK\0"
  pub let cdgw_fail : [u8; 24] = "TB CONSENT DIALOG FAIL\0"

  pub let cdgw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-003 (#1212): clear cap_table slots 248..251.",
      block: {
        push rbx;
        mov rbx, 248;
      cdgwc_loop:
        cmp rbx, 252;
        jae cdgwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp cdgwc_loop;
      cdgwc_done:
        pop rbx;
        ret
      }
    }

  pub let cdgw_scrub_all : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): reset dialog state + attestation table.",
      block: {
        push rbx;
        call consent_dialog_reset;
        call dma_attest_table_reset;
        pop rbx;
        ret
      }
    }

  pub let cdgw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-003 (#1212): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // Mint one KIND_DMA_ATTESTATION at slot; returns 0 on success.
  pub let cdgw_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (attest_key: u64) (dock_id: u64) (domain_id: u64) (hash: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M4-003 (#1212): mint helper.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // attest_key
        mov r13, rdx;                    // dock_id
        mov r14, rcx;                    // domain_id
        mov r15, r8;                     // hash

        // packed: dock | domain<<16 | hash<<32
        mov r10, r13;
        and r10, 0xFFFF;
        mov r11, r14;
        and r11, 0xFFFF;
        shl r11, 16;
        or  r10, r11;
        // r15 holds the 32-bit hash; shl 32 discards any bits > 32
        // as it walks them off the top of the 64-bit register, so no
        // pre-mask is needed (and `and r11, 0xFFFFFFFF` would trip
        // paideia-as's movabs-scratch collision on r11).
        mov r11, r15;
        shl r11, 32;
        or  r10, r11;

        mov rdi, rbx;
        mov rsi, 248;                    // parent = ep at 248
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 249;                     // endpoint = ep at 249
        mov r9, r10;
        call dma_attest_cap_mint_inner;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let consent_dialog_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M4-003 (#1212): boot witness. Stages: (1) default policy = DENY_UNTRUSTED. (2) DENY_UNTRUSTED denies + audit ring records. (3) AUTO_GRANT grants + audit ring records. (4) BAD_POLICY on invalid setter arg. (5) Transition refused on already-decided attestation.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _cdgw_stage];
        mov [rcx], rax;

        call cdgw_clear;
        call cdgw_scrub_all;

        // Endpoints.
        mov rdi, 248;
        mov rsi, 0x200;
        mov rdx, 0x4444;
        call cdgw_endpoint;

        mov rdi, 249;
        mov rsi, 0x200;
        mov rdx, 0x5555;
        call cdgw_endpoint;

        // -- 1. Default policy.
        call consent_dialog_policy_get;
        cmp rax, 0;                      // DENY_UNTRUSTED
        jne cdgw_fail_stage;

        // -- 2. DENY_UNTRUSTED denies.
        mov rax, 2;
        lea rcx, [rip + _cdgw_stage];
        mov [rcx], rax;

        // Mint an attestation.
        mov rdi, 250;
        mov rsi, 0xC0FFEE01;
        mov rdx, 0x11;
        mov rcx, 0x01;
        mov r8, 0xDEADBEEF;
        call cdgw_mint;
        cmp rax, 0;
        jne cdgw_fail_stage;

        // Resolve slot -> row.
        mov rdi, 250;
        call dma_attest_row_of_slot;
        mov r15, rax;
        cmp r15, 0xFF;
        je  cdgw_fail_stage;

        // Handle: default DENY -> decision = 1 (DENIED).
        mov rdi, r15;
        mov rsi, 0x11;
        mov rdx, 0xAA;                   // req_seq
        mov rcx, 0xBB;                   // issued_at
        call consent_dialog_handle;
        cmp rax, 1;                      // DENIED
        jne cdgw_fail_stage;

        // Row state -> REVOKED.
        mov rdi, r15;
        call dma_attest_row_state;
        cmp rax, 2;                      // REVOKED
        jne cdgw_fail_stage;

        // Audit ring[0] -> decision = DENIED, dock = 0x11.
        mov rdi, 0;
        call consent_dialog_audit_at;
        cmp rax, 1;                      // DENIED
        jne cdgw_fail_stage;

        mov rdi, 0;
        call consent_dialog_audit_dock_at;
        cmp rax, 0x11;
        jne cdgw_fail_stage;

        // -- 3. AUTO_GRANT grants.
        mov rax, 3;
        lea rcx, [rip + _cdgw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // AUTO_GRANT
        call consent_dialog_set_auto_grant;
        cmp rax, 0;
        jne cdgw_fail_stage;

        // Mint fresh attestation.
        mov rdi, 251;
        mov rsi, 0xC0FFEE02;
        mov rdx, 0x22;
        mov rcx, 0x02;
        mov r8, 0xC0FFEE00;
        call cdgw_mint;
        cmp rax, 0;
        jne cdgw_fail_stage;

        mov rdi, 251;
        call dma_attest_row_of_slot;
        mov r15, rax;
        cmp r15, 0xFF;
        je  cdgw_fail_stage;

        mov rdi, r15;
        mov rsi, 0x22;
        mov rdx, 0xCC;
        mov rcx, 0xDD;
        call consent_dialog_handle;
        cmp rax, 0;                      // GRANTED
        jne cdgw_fail_stage;

        mov rdi, r15;
        call dma_attest_row_state;
        cmp rax, 1;                      // GRANTED
        jne cdgw_fail_stage;

        // -- 4. BAD_POLICY.
        mov rax, 4;
        lea rcx, [rip + _cdgw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // invalid
        call consent_dialog_set_auto_grant;
        mov r11, 0xFFFFF93E;
        cmp rax, r11;
        jne cdgw_fail_stage;

        // -- 5. Transition refused on already-decided attestation.
        mov rax, 5;
        lea rcx, [rip + _cdgw_stage];
        mov [rcx], rax;

        // r15 still points at the GRANTED attestation from stage 3.
        // Re-handle should refuse TRANSITION.
        mov rdi, r15;
        mov rsi, 0x22;
        mov rdx, 0xCC;
        mov rcx, 0xDD;
        call consent_dialog_handle;
        mov r11, 0xFFFFF939;             // TRANSITION
        cmp rax, r11;
        jne cdgw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cdgw_ok];
        call klog_s1;

        call cdgw_scrub_all;
        call cdgw_clear;
        xor rax, rax;
        jmp cdgw_out;

      cdgw_fail_stage:
        lea rax, [rip + _cdgw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cdgw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call cdgw_scrub_all;
        call cdgw_clear;
        mov rax, 1;

      cdgw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
