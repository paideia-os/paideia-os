// tests/kernel/drivers/tb/usbpd_contract_synth.pdx — R35.M10-002 (#1233)
//
// Boot witness for USB-PD contract negotiation (basic profiles).
//
// Asserts:
//   (a) reset leaves active_count == 0; all counters == 0.
//   (b) pdc_src_cap(port=0, bitmap=0x1F) succeeds — all 5 profiles;
//       state == ADVERTISED; ADVERTISES == 1; cap == 0x1F.
//   (c) pdc_src_cap bad port refuses BAD_PORT.
//   (d) pdc_src_cap zero bitmap refuses BAD_PROFILE.
//   (e) pdc_src_cap bitmap 0x20 (bit 5 illegal) refuses BAD_PROFILE.
//   (f) pdc_src_cap on a non-IDLE port refuses BAD_STATE.
//   (g) pdc_request(port=0, profile=1 = 9V/3A/27W) succeeds; state ==
//       REQUESTED; REQUESTS == 1; pending == 1.
//   (h) pdc_request bad profile refuses BAD_PROFILE.
//   (i) pdc_request twice refuses BAD_STATE.
//   (j) pdc_accept(port=0) succeeds; state == ACCEPTED; ACCEPTS == 1.
//   (k) pdc_accept again refuses BAD_STATE.
//   (l) pdc_ps_rdy(port=0) succeeds; state == READY; profile==1;
//       wattage==27; PS_RDYS == 1.
//   (m) pdc_ps_rdy in wrong state refuses BAD_STATE.
//   (n) A fresh port cycles src_cap -> request(unadvertised) refuses
//       UNADVERTISED.
//   (o) A fresh port cycles src_cap -> request -> reject; state ==
//       REJECTED; REJECTS == 1; pending cleared.
//   (p) Wattage cap: a caller unfortunately cannot request a profile
//       above 100W with the fixed lookup (max 60W). Verified via
//       pdc_profile_wattage(3) == 60 and pdc_profile_wattage(4) == 60.
//   (q) pdc_active_count reports 4 (all four ports touched).
//   (r) pdc_arbitrated() == 0 (honesty pin).
//
// Fingerprint: R35 TB USBPD CONTRACT OK
//
// No cap slots — module owns its own port table + stats.

module UsbpdContractSynth = structure {

  pub let mut _pdcw_stage : u64 = 0

  pub let pdcw_ok   : [u8; 23] = "TB USBPD CONTRACT OK\n\0\0"
  pub let pdcw_fail : [u8; 25] = "TB USBPD CONTRACT FAIL\n\0\0"

  pub let usbpd_contract_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M10-002 (#1233): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        call pdc_reset;

        call pdc_active_count;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_stat;
        cmp rax, 0;
        jne pdcw_fail_stage;

        // -- 2. SRC_CAP on port 0 with all 5 profiles.
        mov rax, 2;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1F;
        call pdc_src_cap;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_state;
        cmp rax, 1;                      // ADVERTISED
        jne pdcw_fail_stage;
        mov rdi, 0;                      // ADVERTISES
        call pdc_stat;
        cmp rax, 1;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_cap;
        mov r11, 0x1F;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 3. Bad port.
        mov rax, 3;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // out of range
        mov rsi, 0x1;
        call pdc_src_cap;
        mov r11, 0xFFFFF7EE;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 4. Zero bitmap.
        mov rax, 4;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        call pdc_src_cap;
        mov r11, 0xFFFFF7ED;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 5. Bit-5 illegal.
        mov rax, 5;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x20;                   // bit 5
        call pdc_src_cap;
        mov r11, 0xFFFFF7ED;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 6. SRC_CAP twice on port 0 refuses BAD_STATE.
        mov rax, 6;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x1F;
        call pdc_src_cap;
        mov r11, 0xFFFFF7EC;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 7. REQUEST profile 1 (9V/3A/27W).
        mov rax, 7;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        call pdc_request;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_state;
        cmp rax, 2;                      // REQUESTED
        jne pdcw_fail_stage;
        mov rdi, 1;                      // REQUESTS
        call pdc_stat;
        cmp rax, 1;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_pending;
        cmp rax, 1;
        jne pdcw_fail_stage;

        // -- 8. Bad profile.
        mov rax, 8;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 5;                      // out of range
        call pdc_request;
        mov r11, 0xFFFFF7ED;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 9. Request in wrong state.
        mov rax, 9;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call pdc_request;
        mov r11, 0xFFFFF7EC;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 10. ACCEPT.
        mov rax, 10;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pdc_accept;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_state;
        cmp rax, 3;                      // ACCEPTED
        jne pdcw_fail_stage;
        mov rdi, 2;                      // ACCEPTS
        call pdc_stat;
        cmp rax, 1;
        jne pdcw_fail_stage;

        // -- 11. ACCEPT twice refuses.
        mov rax, 11;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pdc_accept;
        mov r11, 0xFFFFF7EC;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 12. PS_RDY.
        mov rax, 12;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pdc_ps_rdy;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_state;
        cmp rax, 5;                      // READY
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_profile;
        cmp rax, 1;
        jne pdcw_fail_stage;
        mov rdi, 0;
        call pdc_port_wattage;
        cmp rax, 27;
        jne pdcw_fail_stage;
        mov rdi, 4;                      // PS_RDYS
        call pdc_stat;
        cmp rax, 1;
        jne pdcw_fail_stage;

        // -- 13. PS_RDY in wrong state.
        mov rax, 13;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pdc_ps_rdy;
        mov r11, 0xFFFFF7EC;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 14. UNADVERTISED: port 1 advertises only 5V; request 20V.
        mov rax, 14;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0x1;                    // only 5V bit
        call pdc_src_cap;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 1;
        mov rsi, 3;                      // 20V profile — not advertised
        call pdc_request;
        mov r11, 0xFFFFF7EB;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 15. REJECT path: port 2 cycles src_cap -> request -> reject.
        mov rax, 15;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 0x1F;
        call pdc_src_cap;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 2;
        mov rsi, 2;                      // 15V/3A/45W
        call pdc_request;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 2;
        call pdc_reject;
        cmp rax, 0;
        jne pdcw_fail_stage;
        mov rdi, 2;
        call pdc_port_state;
        cmp rax, 4;                      // REJECTED
        jne pdcw_fail_stage;
        mov rdi, 3;                      // REJECTS
        call pdc_stat;
        cmp rax, 1;
        jne pdcw_fail_stage;
        mov rdi, 2;
        call pdc_port_pending;
        mov r11, 0xFF;
        cmp rax, r11;
        jne pdcw_fail_stage;

        // -- 16. Wattage lookup sanity (20V/3A = 60W, PPS = 60W).
        mov rax, 16;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // 20V/3A
        call pdc_profile_wattage;
        cmp rax, 60;
        jne pdcw_fail_stage;
        mov rdi, 4;                      // PPS
        call pdc_profile_wattage;
        cmp rax, 60;
        jne pdcw_fail_stage;

        // -- 17. Touch port 3 for active_count == 4.
        mov rax, 17;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 0x1;
        call pdc_src_cap;
        cmp rax, 0;
        jne pdcw_fail_stage;
        call pdc_active_count;
        cmp rax, 4;
        jne pdcw_fail_stage;

        // -- 18. Arbitrated is 0.
        mov rax, 18;
        lea rcx, [rip + _pdcw_stage];
        mov [rcx], rax;

        call pdc_arbitrated;
        cmp rax, 0;
        jne pdcw_fail_stage;

        // Cleanup.
        call pdc_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp pdcw_out;

      pdcw_fail_stage:
        lea rax, [rip + _pdcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pdc_reset;
        mov rax, 1;

      pdcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
