// tests/kernel/drivers/tb/multi_host_contend_synth.pdx — R35.M8-002 (#1227)
//
// Boot witness for TB4 multi-host contention placeholder.
//
// Asserts:
//   (a) reset leaves row_count == 0; holder(any) == NO_HOLDER.
//   (b) mhc_request(host=0, adapter=7) succeeds; holder(7) == 0;
//       row_count == 1.
//   (c) mhc_request(host=0, adapter=7) again succeeds (idempotent);
//       row_count remains 1.
//   (d) mhc_request(host=1, adapter=7) refuses DENIED_CONTENDED
//       (first-claim-wins); CONTENDED stat bumps by 1.
//   (e) mhc_request(host=1, adapter=8) succeeds (different adapter);
//       holder(8) == 1; row_count == 2.
//   (f) mhc_release(host=1, adapter=7) refuses NOT_HELD.
//   (g) mhc_release(host=0, adapter=7) succeeds; holder(7) ==
//       NO_HOLDER; row_count == 1.
//   (h) mhc_release(host=0, adapter=7) again refuses NOT_HELD.
//   (i) bad host_id (>0xFF) refuses BAD_HOST.
//   (j) bad adapter (>0xFF) refuses BAD_ARG.
//   (k) Fill all 16 rows; the 17th unique adapter refuses ENOSPC.
//
// Fingerprint: R35 TB MULTI HOST CONTEND OK
//
// No cap slots — module owns its own rows + stats.

module MultiHostContendSynth = structure {

  pub let mut _mhcw_stage : u64 = 0

  pub let mhcw_ok   : [u8; 29] = "TB MULTI HOST CONTEND OK\n\0\0\0\0"
  pub let mhcw_fail : [u8; 31] = "TB MULTI HOST CONTEND FAIL\n\0\0\0\0"

  pub let multi_host_contend_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M8-002 (#1227): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        call mhc_reset;

        call mhc_row_count;
        cmp rax, 0;
        jne mhcw_fail_stage;
        mov rdi, 7;
        call mhc_holder;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // -- 2. First claim.
        mov rax, 2;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // host_id
        mov rsi, 7;                      // adapter
        call mhc_request;
        cmp rax, 0;
        jne mhcw_fail_stage;
        mov rdi, 7;
        call mhc_holder;
        cmp rax, 0;
        jne mhcw_fail_stage;
        call mhc_row_count;
        cmp rax, 1;
        jne mhcw_fail_stage;

        // -- 3. Same claim -- idempotent.
        mov rax, 3;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 7;
        call mhc_request;
        cmp rax, 0;
        jne mhcw_fail_stage;
        call mhc_row_count;
        cmp rax, 1;
        jne mhcw_fail_stage;

        // -- 4. Second host, same adapter -- DENIED_CONTENDED.
        mov rax, 4;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // host_id
        mov rsi, 7;
        call mhc_request;
        mov r11, 0xFFFFF84E;
        cmp rax, r11;
        jne mhcw_fail_stage;
        // CONTENDED stat should be 1.
        mov rdi, 2;                      // CONTENDED
        call mhc_stat;
        cmp rax, 1;
        jne mhcw_fail_stage;

        // -- 5. Different adapter for host 1.
        mov rax, 5;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 8;
        call mhc_request;
        cmp rax, 0;
        jne mhcw_fail_stage;
        mov rdi, 8;
        call mhc_holder;
        cmp rax, 1;
        jne mhcw_fail_stage;
        call mhc_row_count;
        cmp rax, 2;
        jne mhcw_fail_stage;

        // -- 6. Release by non-holder.
        mov rax, 6;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 7;
        call mhc_release;
        mov r11, 0xFFFFF84C;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // -- 7. Release by holder.
        mov rax, 7;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 7;
        call mhc_release;
        cmp rax, 0;
        jne mhcw_fail_stage;
        mov rdi, 7;
        call mhc_holder;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne mhcw_fail_stage;
        call mhc_row_count;
        cmp rax, 1;
        jne mhcw_fail_stage;

        // -- 8. Double release.
        mov rax, 8;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 7;
        call mhc_release;
        mov r11, 0xFFFFF84C;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // -- 9. Bad host_id.
        mov rax, 9;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0x100;
        mov rsi, 3;
        call mhc_request;
        mov r11, 0xFFFFF84B;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // -- 10. Bad adapter.
        mov rax, 10;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x100;
        call mhc_request;
        mov r11, 0xFFFFF84F;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // -- 11. ENOSPC. Currently 1 row live (host=1, adapter=8).
        //        Add 15 more unique adapters (adapter 10..24) all by host 2.
        mov rax, 11;
        lea rcx, [rip + _mhcw_stage];
        mov [rcx], rax;

        mov rbx, 10;                     // adapter iterator
      mhcw_fill_scan:
        cmp rbx, 25;
        jae mhcw_fill_done;
        mov rdi, 2;
        mov rsi, rbx;
        call mhc_request;
        cmp rax, 0;
        jne mhcw_fail_stage;
        add rbx, 1;
        jmp mhcw_fill_scan;
      mhcw_fill_done:

        call mhc_row_count;
        cmp rax, 16;
        jne mhcw_fail_stage;

        // Now a 17th unique adapter must refuse ENOSPC.
        mov rdi, 3;
        mov rsi, 42;
        call mhc_request;
        mov r11, 0xFFFFF84D;
        cmp rax, r11;
        jne mhcw_fail_stage;

        // Cleanup.
        call mhc_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mhcw_ok];
        call klog_s1;

        xor rax, rax;
        jmp mhcw_out;

      mhcw_fail_stage:
        lea rax, [rip + _mhcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mhcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mhc_reset;
        mov rax, 1;

      mhcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
