// tests/kernel/drivers/tb/route_arith_synth.pdx — R35.M7-002 (#1224)
//
// Boot witness for TB4 route-string arithmetic.
//
// Asserts:
//   (a) reset leaves counters at 0.
//   (b) count_hops(0) == 0; count_hops(0x1) == 1;
//       count_hops(0x21) == 2 (two 5-bit slots);
//       count_hops(0x421) == 3.
//   (c) append_hop(0, 5) == 5 (single hop); depth 1.
//   (d) append_hop(5, 3) == (5 << 5) | 3 == 0xA3; depth 2.
//   (e) append_hop with port > 31 refuses BAD_HOP.
//   (f) append_hop on a 12-hop route refuses TOO_DEEP.
//   (g) pop_last_hop(0) refuses NO_HOPS.
//   (h) pop_last_hop(0xA3) == 5 (the tail hop cleared, leaving hop 5
//       at slot 0).
//   (i) extract_hop(0xA3, 0) == 5 (deepest); extract_hop(0xA3, 1) == 3.
//   (j) extract_hop(0xA3, 2) refuses BAD_INDEX (depth is 2).
//   (k) count_hops with 61-bit input refuses BAD_ROUTE.
//   (l) build 12-hop route by successive append_hop; count_hops == 12;
//       thirteenth append refuses TOO_DEEP.
//
// Fingerprint: R35 TB ROUTE ARITH OK
//
// No cap slots — module owns its own stats only.

module RouteArithSynth = structure {

  pub let mut _raw_stage : u64 = 0

  pub let raw_ok   : [u8; 26] = "R35 TB ROUTE ARITH OK\n\0\0\0\0"
  pub let raw_fail : [u8; 28] = "R35 TB ROUTE ARITH FAIL\n\0\0\0\0"

  pub let route_arith_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M7-002 (#1224): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        call ra_reset;

        // -- 2. count_hops.
        mov rax, 2;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ra_count_hops;
        cmp rax, 0;
        jne raw_fail_stage;

        mov rdi, 0x1;
        call ra_count_hops;
        cmp rax, 1;
        jne raw_fail_stage;

        mov rdi, 0x21;                   // slot0=1, slot1=1
        call ra_count_hops;
        cmp rax, 2;
        jne raw_fail_stage;

        mov rdi, 0x421;                  // slot0=1, slot1=1, slot2=1
        call ra_count_hops;
        cmp rax, 3;
        jne raw_fail_stage;

        // -- 3. append_hop(0, 5) == 5.
        mov rax, 3;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 5;
        call ra_append_hop;
        cmp rax, 5;
        jne raw_fail_stage;
        mov rdi, 5;
        call ra_count_hops;
        cmp rax, 1;
        jne raw_fail_stage;

        // -- 4. append_hop(5, 3) == 0xA3.
        mov rax, 4;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 3;
        call ra_append_hop;
        cmp rax, 0xA3;
        jne raw_fail_stage;

        // -- 5. BAD_HOP: port > 31.
        mov rax, 5;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 32;
        call ra_append_hop;
        mov r11, 0xFFFFF87D;             // BAD_HOP
        cmp rax, r11;
        jne raw_fail_stage;

        // -- 6. TOO_DEEP: build 12-hop route then attempt 13th.
        mov rax, 6;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        // 12 hops, each = 1.
        mov rbx, 0;                      // route accumulator
        mov r12, 12;                     // count remaining
      raw_build_loop:
        cmp r12, 0;
        je  raw_build_done;
        mov rdi, rbx;
        mov rsi, 1;
        call ra_append_hop;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae raw_fail_stage;              // any error band; expected pure route
        mov rbx, rax;
        sub r12, 1;
        jmp raw_build_loop;
      raw_build_done:

        // depth should be 12.
        mov rdi, rbx;
        call ra_count_hops;
        cmp rax, 12;
        jne raw_fail_stage;

        // 13th refuses TOO_DEEP.
        mov rdi, rbx;
        mov rsi, 1;
        call ra_append_hop;
        mov r11, 0xFFFFF87C;             // TOO_DEEP
        cmp rax, r11;
        jne raw_fail_stage;
        mov r13, rbx;                    // stash the 12-hop route

        // -- 7. NO_HOPS on pop of 0.
        mov rax, 7;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call ra_pop_last_hop;
        mov r11, 0xFFFFF87B;
        cmp rax, r11;
        jne raw_fail_stage;

        // -- 8. pop_last_hop(0xA3) == 5.
        mov rax, 8;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0xA3;
        call ra_pop_last_hop;
        cmp rax, 5;
        jne raw_fail_stage;

        // -- 9. extract_hop(0xA3, 0) == 5 (deepest); (0xA3, 1) == 3.
        mov rax, 9;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0xA3;
        mov rsi, 0;
        call ra_extract_hop;
        cmp rax, 5;
        jne raw_fail_stage;
        mov rdi, 0xA3;
        mov rsi, 1;
        call ra_extract_hop;
        cmp rax, 3;
        jne raw_fail_stage;

        // -- 10. BAD_INDEX: extract_hop(0xA3, 2).
        mov rax, 10;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0xA3;
        mov rsi, 2;
        call ra_extract_hop;
        mov r11, 0xFFFFF87A;             // BAD_INDEX
        cmp rax, r11;
        jne raw_fail_stage;

        // -- 11. BAD_ROUTE: bit above 59 set.
        mov rax, 11;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000000000000000;     // bit 60 set
        call ra_count_hops;
        mov r11, 0xFFFFF87E;             // BAD_ROUTE
        cmp rax, r11;
        jne raw_fail_stage;

        // -- 12. Pop all 12 hops from the built route; final depth 0.
        mov rax, 12;
        lea rcx, [rip + _raw_stage];
        mov [rcx], rax;

        mov rbx, r13;
        mov r12, 12;
      raw_pop_loop:
        cmp r12, 0;
        je  raw_pop_done;
        mov rdi, rbx;
        call ra_pop_last_hop;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae raw_fail_stage;
        mov rbx, rax;
        sub r12, 1;
        jmp raw_pop_loop;
      raw_pop_done:

        mov rdi, rbx;
        call ra_count_hops;
        cmp rax, 0;
        jne raw_fail_stage;

        // Cleanup.
        call ra_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + raw_ok];
        call klog_s1;

        xor rax, rax;
        jmp raw_out;

      raw_fail_stage:
        lea rax, [rip + _raw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + raw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ra_reset;
        mov rax, 1;

      raw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
