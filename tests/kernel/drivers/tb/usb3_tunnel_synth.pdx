// tests/kernel/drivers/tb/usb3_tunnel_synth.pdx — R35.M3-003 (#1207)
//
// Boot witness for the TB4 USB3 tunnel scaffold. Asserts gen /
// adapter / port validators; gen bandwidth lookup; happy-path
// gen_negotiate; SELF_LOOP; BAD_GEN; port alloc happy + IN_USE +
// ENOSPC; port release + NOT_HELD.
//
// Fingerprint: R35 TB USB3 TUNNEL OK

module Usb3TunnelSynth = structure {

  pub let mut _utnw_stage : u64 = 0

  pub let utnw_ok   : [u8; 18] = "TB USB3 TUNNEL OK\n\0"
  pub let utnw_fail : [u8; 20] = "TB USB3 TUNNEL FAIL\n\0"

  pub let usb3_tunnel_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M3-003 (#1207): boot witness. Stages: (1) reset. (2) validators. (3) gen_bw lookup. (4) gen_negotiate happy. (5) SELF_LOOP. (6) BAD_GEN. (7) port alloc happy. (8) IN_USE. (9) ENOSPC. (10) release + NOT_HELD + bad port.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        call usb3_tunnel_reset;

        // -- 2. Validators.
        mov rax, 2;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call usb3_tun_gen_valid;
        cmp rax, 1;
        jne utnw_fail_stage;
        mov rdi, 3;
        call usb3_tun_gen_valid;
        cmp rax, 1;
        jne utnw_fail_stage;
        mov rdi, 4;
        call usb3_tun_gen_valid;
        cmp rax, 0;
        jne utnw_fail_stage;

        mov rdi, 0xFF;
        call usb3_tun_adapter_valid;
        cmp rax, 1;
        jne utnw_fail_stage;
        mov rdi, 0x100;
        call usb3_tun_adapter_valid;
        cmp rax, 0;
        jne utnw_fail_stage;

        mov rdi, 32;                     // XHCI_PORT_TB_BASE
        call usb3_tun_port_valid;
        cmp rax, 1;
        jne utnw_fail_stage;
        mov rdi, 31;
        call usb3_tun_port_valid;
        cmp rax, 0;
        jne utnw_fail_stage;
        mov rdi, 36;
        call usb3_tun_port_valid;
        cmp rax, 0;
        jne utnw_fail_stage;

        // -- 3. gen_bw lookup.
        mov rax, 3;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call usb3_tun_gen_bw_mbps;
        cmp rax, 5000;
        jne utnw_fail_stage;

        mov rdi, 3;
        call usb3_tun_gen_bw_mbps;
        cmp rax, 20000;
        jne utnw_fail_stage;

        mov rdi, 4;
        call usb3_tun_gen_bw_mbps;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne utnw_fail_stage;

        // -- 4. gen_negotiate happy.
        mov rax, 4;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 10;                     // source
        mov rsi, 20;                     // sink
        mov rdx, 3;                      // Gen2x2
        call usb3_tunnel_gen_negotiate;
        cmp rax, 0;
        jne utnw_fail_stage;

        // -- 5. SELF_LOOP.
        mov rax, 5;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 10;
        mov rdx, 2;
        call usb3_tunnel_gen_negotiate;
        mov r11, 0xFFFFF97C;
        cmp rax, r11;
        jne utnw_fail_stage;

        // -- 6. BAD_GEN.
        mov rax, 6;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        mov rsi, 20;
        mov rdx, 4;                      // BAD gen
        call usb3_tunnel_gen_negotiate;
        mov r11, 0xFFFFF97E;
        cmp rax, r11;
        jne utnw_fail_stage;

        // -- 7. Port alloc happy.
        mov rax, 7;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call usb3_tunnel_port_alloc;
        cmp rax, 32;
        jne utnw_fail_stage;

        // -- 8. IN_USE.
        mov rax, 8;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 10;
        call usb3_tunnel_port_alloc;
        mov r11, 0xFFFFF97B;
        cmp rax, r11;
        jne utnw_fail_stage;

        // -- 9. ENOSPC.
        mov rax, 9;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 11;
        call usb3_tunnel_port_alloc;
        cmp rax, 33;
        jne utnw_fail_stage;
        mov rdi, 12;
        call usb3_tunnel_port_alloc;
        cmp rax, 34;
        jne utnw_fail_stage;
        mov rdi, 13;
        call usb3_tunnel_port_alloc;
        cmp rax, 35;
        jne utnw_fail_stage;

        mov rdi, 14;
        call usb3_tunnel_port_alloc;
        mov r11, 0xFFFFF97A;             // ENOSPC
        cmp rax, r11;
        jne utnw_fail_stage;

        // -- 10. Release + NOT_HELD + bad port.
        mov rax, 10;
        lea rcx, [rip + _utnw_stage];
        mov [rcx], rax;

        mov rdi, 32;
        call usb3_tunnel_port_release;
        cmp rax, 0;
        jne utnw_fail_stage;

        mov rdi, 32;
        call usb3_tunnel_port_release;
        mov r11, 0xFFFFF978;
        cmp rax, r11;
        jne utnw_fail_stage;

        mov rdi, 100;
        call usb3_tunnel_port_release;
        mov r11, 0xFFFFF979;
        cmp rax, r11;
        jne utnw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + utnw_ok];
        call klog_s1;

        call usb3_tunnel_reset;
        xor rax, rax;
        jmp utnw_out;

      utnw_fail_stage:
        lea rax, [rip + _utnw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + utnw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call usb3_tunnel_reset;
        mov rax, 1;

      utnw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
