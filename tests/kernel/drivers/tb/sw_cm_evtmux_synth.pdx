// tests/kernel/drivers/tb/sw_cm_evtmux_synth.pdx — R35.M6-003 (#1221)
//
// Boot witness for the software-CM event demultiplexer.
//
// Asserts:
//   (a) reset leaves all counters at 0 and last-event at 0.
//   (b) PATH_ADDED event on slot 2 transitions fsm path to PROBED,
//       bumps PATH_ADDED + DISPATCHED counters.
//   (c) PATH_REMOVED on same slot transitions path to TORN.
//   (d) PORT_STATE(slot=2, ENABLED) dispatches to port_transition.
//   (e) TUNNEL(slot=2, NEGOTIATING) then TUNNEL(slot=2, ESTABLISHED)
//       dispatch to tunnel_transition.
//   (f) Unknown type: 0 -> UNKNOWN counter, SWMUX_UNKNOWN return.
//   (g) Refused: dispatch a TUNNEL(slot=2, ESTABLISHED) again on an
//       ESTABLISHED slot -> tunnel_transition refuses BAD_TRANSITION
//       -> demux stamps REFUSED counter.
//   (h) sw_cm_evtmux_last() returns the last packed event.
//
// Fingerprint: R35 SW CM EVTMUX OK
//
// No cap slots — module owns its own stats + last-event cell only.
// Depends on the sw_cm_fsm reset having run before this witness so
// FSM state is clean; this fixture also resets the FSM on entry.

module SwCmEvtmuxSynth = structure {

  pub let mut _semw_stage : u64 = 0

  pub let semw_ok   : [u8; 20] = "SW CM EVTMUX OK\n\0\0\0\0"
  pub let semw_fail : [u8; 22] = "SW CM EVTMUX FAIL\n\0\0\0\0"

  pub let sw_cm_evtmux_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M6-003 (#1221): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        call sw_cm_evtmux_reset;
        call sw_cm_fsm_reset;

        call sw_cm_evtmux_last;
        cmp rax, 0;
        jne semw_fail_stage;

        // -- 2. PATH_ADDED slot 2. Pack then dispatch.
        mov rax, 2;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // PATH_ADDED
        mov rsi, 2;                      // slot
        mov rdx, 0;                      // new_state (unused for path adds)
        mov rcx, 0;                      // flags
        call sw_cm_evt_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  semw_fail_stage;
        mov rbx, rax;                    // packed event

        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        cmp rax, 0;
        jne semw_fail_stage;
        mov rdi, 2;
        call sw_cm_fsm_path_state;
        cmp rax, 1;                      // PROBED
        jne semw_fail_stage;

        // Counters.
        mov rdi, 0;                      // PATH_ADDED
        call sw_cm_evtmux_stat;
        cmp rax, 1;
        jne semw_fail_stage;
        mov rdi, 6;                      // DISPATCHED
        call sw_cm_evtmux_stat;
        cmp rax, 1;
        jne semw_fail_stage;

        // -- 3. PATH_REMOVED slot 2.
        mov rax, 3;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // PATH_REMOVED
        mov rsi, 2;
        mov rdx, 0;
        mov rcx, 0;
        call sw_cm_evt_pack;
        mov rbx, rax;

        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        cmp rax, 0;
        jne semw_fail_stage;
        mov rdi, 2;
        call sw_cm_fsm_path_state;
        cmp rax, 3;                      // TORN
        jne semw_fail_stage;

        // -- 4. PORT_STATE(slot=2, ENABLED).
        mov rax, 4;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // PORT_STATE
        mov rsi, 2;
        mov rdx, 1;                      // ENABLED
        mov rcx, 0;
        call sw_cm_evt_pack;
        mov rbx, rax;
        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        cmp rax, 0;
        jne semw_fail_stage;
        mov rdi, 2;
        call sw_cm_fsm_port_state;
        cmp rax, 1;
        jne semw_fail_stage;

        // -- 5. TUNNEL NEGOTIATING then ESTABLISHED.
        mov rax, 5;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // TUNNEL
        mov rsi, 2;
        mov rdx, 1;                      // NEGOTIATING
        mov rcx, 0;
        call sw_cm_evt_pack;
        mov rbx, rax;
        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        cmp rax, 0;
        jne semw_fail_stage;

        mov rdi, 4;
        mov rsi, 2;
        mov rdx, 2;                      // ESTABLISHED
        mov rcx, 0;
        call sw_cm_evt_pack;
        mov rbx, rax;
        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        cmp rax, 0;
        jne semw_fail_stage;
        mov rdi, 2;
        call sw_cm_fsm_tunnel_state;
        cmp rax, 2;                      // ESTABLISHED
        jne semw_fail_stage;

        // -- 6. Unknown type 0.
        mov rax, 6;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // packed (all zero -> type 0)
        call sw_cm_evtmux_dispatch;
        mov r11, 0xFFFFF8AE;             // UNKNOWN
        cmp rax, r11;
        jne semw_fail_stage;
        mov rdi, 4;                      // UNKNOWN counter
        call sw_cm_evtmux_stat;
        cmp rax, 1;
        jne semw_fail_stage;

        // -- 7. Refused: TUNNEL ESTABLISHED on ESTABLISHED slot.
        mov rax, 7;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 2;
        mov rdx, 2;                      // ESTABLISHED again
        mov rcx, 0;
        call sw_cm_evt_pack;
        mov rbx, rax;
        mov rdi, rbx;
        call sw_cm_evtmux_dispatch;
        mov r11, 0xFFFFF8CB;             // BAD_TRANSITION (from fsm)
        cmp rax, r11;
        jne semw_fail_stage;
        mov rdi, 5;                      // REFUSED counter
        call sw_cm_evtmux_stat;
        cmp rax, 1;
        jne semw_fail_stage;

        // -- 8. sw_cm_evtmux_last returns the last packed event.
        mov rax, 8;
        lea rcx, [rip + _semw_stage];
        mov [rcx], rax;

        call sw_cm_evtmux_last;
        cmp rax, rbx;
        jne semw_fail_stage;

        // Cleanup.
        call sw_cm_evtmux_reset;
        call sw_cm_fsm_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + semw_ok];
        call klog_s1;

        xor rax, rax;
        jmp semw_out;

      semw_fail_stage:
        lea rax, [rip + _semw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + semw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sw_cm_evtmux_reset;
        call sw_cm_fsm_reset;
        mov rax, 1;

      semw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
