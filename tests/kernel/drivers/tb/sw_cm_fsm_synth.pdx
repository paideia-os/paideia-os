// tests/kernel/drivers/tb/sw_cm_fsm_synth.pdx — R35.M6-001 (#1219)
//
// Boot witness for the software-CM three-tier FSM.
//
// Asserts:
//   (a) reset leaves all three tier tables at 0.
//   (b) path: IDLE -> PROBED -> CONNECTED -> TORN -> IDLE cycle.
//   (c) path: IDLE -> CONNECTED refused BAD_TRANSITION.
//   (d) path: BAD_SLOT on slot >= 32.
//   (e) path: BAD_STATE on to >= 4.
//   (f) port: DISABLED -> ENABLED -> NEGOTIATED, and NEGOTIATED
//       -> ERROR, ERROR -> DISABLED.
//   (g) tunnel: NONE -> NEGOTIATING -> ESTABLISHED -> TEARING ->
//       TORN -> NONE cycle.
//   (h) tunnel: NEGOTIATING -> TORN (abort path) accepted.
//   (i) cross-slot isolation: transition on slot 3 does not affect
//       slot 4's tunnel state.
//
// Fingerprint: R35 SW CM FSM OK
//
// No cap slots — module owns its own tables + stats only.

module SwCmFsmSynth = structure {

  pub let mut _sfw_stage : u64 = 0

  pub let sfw_ok   : [u8; 16] = "SW CM FSM OK\n\0\0\0\0"
  pub let sfw_fail : [u8; 18] = "SW CM FSM FAIL\n\0\0\0\0"

  pub let sw_cm_fsm_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M6-001 (#1219): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        call sw_cm_fsm_reset;

        // Baseline all tiers zero on slot 0.
        mov rdi, 0;
        call sw_cm_fsm_path_state;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 0;
        call sw_cm_fsm_port_state;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 0;
        call sw_cm_fsm_tunnel_state;
        cmp rax, 0;
        jne sfw_fail_stage;

        // -- 2. Path happy cycle on slot 0.
        mov rax, 2;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // PROBED
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 0;
        call sw_cm_fsm_path_state;
        cmp rax, 1;
        jne sfw_fail_stage;

        mov rdi, 0;
        mov rsi, 2;                      // CONNECTED
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne sfw_fail_stage;

        mov rdi, 0;
        mov rsi, 3;                      // TORN
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne sfw_fail_stage;

        mov rdi, 0;
        mov rsi, 0;                      // IDLE
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne sfw_fail_stage;

        // -- 3. Path illegal: IDLE -> CONNECTED refused.
        mov rax, 3;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 2;
        call sw_cm_fsm_path_transition;
        mov r11, 0xFFFFF8CB;             // BAD_TRANSITION
        cmp rax, r11;
        jne sfw_fail_stage;

        // -- 4. BAD_SLOT.
        mov rax, 4;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 32;
        mov rsi, 1;
        call sw_cm_fsm_path_transition;
        mov r11, 0xFFFFF8CE;             // BAD_SLOT
        cmp rax, r11;
        jne sfw_fail_stage;

        // -- 5. BAD_STATE.
        mov rax, 5;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 4;                      // path max is 3
        call sw_cm_fsm_path_transition;
        mov r11, 0xFFFFF8CD;             // BAD_STATE
        cmp rax, r11;
        jne sfw_fail_stage;

        // -- 6. Port transitions on slot 1.
        mov rax, 6;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 1;                      // ENABLED
        call sw_cm_fsm_port_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 1;
        mov rsi, 2;                      // NEGOTIATED
        call sw_cm_fsm_port_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 1;
        mov rsi, 3;                      // ERROR
        call sw_cm_fsm_port_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 1;
        mov rsi, 0;                      // DISABLED
        call sw_cm_fsm_port_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 1;
        call sw_cm_fsm_port_state;
        cmp rax, 0;
        jne sfw_fail_stage;

        // -- 7. Tunnel happy cycle on slot 3.
        mov rax, 7;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 1;                      // NEGOTIATING
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 3;
        mov rsi, 2;                      // ESTABLISHED
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 3;
        mov rsi, 3;                      // TEARING
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 3;
        mov rsi, 4;                      // TORN
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 3;
        mov rsi, 0;                      // NONE
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;

        // -- 8. Tunnel abort path: NONE -> NEGOTIATING -> TORN.
        mov rax, 8;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 1;                      // NEGOTIATING
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;
        mov rdi, 5;
        mov rsi, 4;                      // TORN (abort)
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne sfw_fail_stage;

        // -- 9. Cross-slot isolation: slot 5 = TORN; slot 6 unaffected.
        mov rax, 9;
        lea rcx, [rip + _sfw_stage];
        mov [rcx], rax;

        mov rdi, 6;
        call sw_cm_fsm_tunnel_state;
        cmp rax, 0;                      // slot 6 still NONE
        jne sfw_fail_stage;

        // Cleanup.
        call sw_cm_fsm_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sfw_ok];
        call klog_s1;

        xor rax, rax;
        jmp sfw_out;

      sfw_fail_stage:
        lea rax, [rip + _sfw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sfw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sw_cm_fsm_reset;
        mov rax, 1;

      sfw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
