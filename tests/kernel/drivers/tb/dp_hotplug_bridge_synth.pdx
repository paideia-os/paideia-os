// tests/kernel/drivers/tb/dp_hotplug_bridge_synth.pdx — R35.M9-003 (#1231)
//
// Boot witness for DP-tunnel hot-plug bridge.
//
// Asserts:
//   (a) reset leaves all counters == 0.
//   (b) dphp_on_tunnel_established(tunnel_type=DP, source=10, sink=20)
//       succeeds; APPEARED == 1; EMITTED == 1; INGESTED == 1;
//       FILTERED == 0. Ring slot 0 stamped with kind=APPEARED,
//       source=10, sink=20. RING_HEAD == 1.
//   (c) dphp_on_tunnel_established(tunnel_type=PCIe_UP, source=11,
//       sink=21) drops: INGESTED == 2; FILTERED == 1; EMITTED == 1
//       (unchanged); RING_HEAD == 1 (unchanged).
//   (d) dphp_on_tunnel_established(tunnel_type=USB3, source=12,
//       sink=22) drops: INGESTED == 3; FILTERED == 2.
//   (e) dphp_on_tunnel_established(tunnel_type=HOSTIF, source=13,
//       sink=23) drops: INGESTED == 4; FILTERED == 3.
//   (f) dphp_on_tunnel_torn(tunnel_type=DP, source=10, sink=20)
//       succeeds; REMOVED == 1; EMITTED == 2. Ring slot 1 stamped.
//   (g) dphp_on_tunnel_established with bad tunnel_type (5) refuses
//       BAD_TUNNEL.
//   (h) dphp_on_tunnel_established with bad source (>24 bit) refuses
//       BAD_ADAPTER.
//   (i) dphp_on_tunnel_torn with bad sink (>24 bit) refuses BAD_ADAPTER.
//   (j) dphp_is_dp_tunnel(DP) == 1; dphp_is_dp_tunnel(PCIe_UP) == 0;
//       dphp_is_dp_tunnel(USB3) == 0; dphp_is_dp_tunnel(HOSTIF) == 0.
//   (k) dphp_placeholder_count() == 2. dphp_placeholder_by_kind(0) == 1
//       (APPEARED). dphp_placeholder_by_kind(1) == 1 (REMOVED).
//       dphp_placeholder_by_kind(2) == DECODE_BAD.
//   (l) 17th emission wraps: fill DP tunnel APPEARED events until
//       RING_HEAD returns to 0 after wrap. Assert RING_HEAD == 0 or 1
//       depending on tail; EMITTED count is authoritative.
//   (m) dphp_arbitrated() == 0.
//
// Fingerprint: R35 TB DP HOTPLUG BRIDGE OK
//
// No cap slots — module owns its own event ring + stats.

module DpHotplugBridgeSynth = structure {

  pub let mut _dphpw_stage : u64 = 0

  pub let dphpw_ok   : [u8; 28] = "TB DP HOTPLUG BRIDGE OK\n\0\0\0\0"
  pub let dphpw_fail : [u8; 30] = "TB DP HOTPLUG BRIDGE FAIL\n\0\0\0\0"

  pub let dp_hotplug_bridge_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M9-003 (#1231): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        call dphp_reset;

        mov rdi, 0;                      // APPEARED
        call dphp_stat;
        cmp rax, 0;
        jne dphpw_fail_stage;

        // -- 2. DP tunnel_established.
        mov rax, 2;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // DP
        mov rsi, 10;                     // source
        mov rdx, 20;                     // sink
        call dphp_on_tunnel_established;
        cmp rax, 0;
        jne dphpw_fail_stage;

        mov rdi, 0;                      // APPEARED
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 4;                      // EMITTED
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 2;                      // INGESTED
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 3;                      // FILTERED
        call dphp_stat;
        cmp rax, 0;
        jne dphpw_fail_stage;

        // Ring slot 0 stamped.
        mov rdi, 0;
        call dphp_event_in_use;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 0;
        call dphp_event_kind;
        cmp rax, 0;                      // APPEARED
        jne dphpw_fail_stage;
        mov rdi, 0;
        call dphp_event_source;
        cmp rax, 10;
        jne dphpw_fail_stage;
        mov rdi, 0;
        call dphp_event_sink;
        cmp rax, 20;
        jne dphpw_fail_stage;

        mov rdi, 6;                      // RING_HEAD
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;

        // -- 3. PCIe_UP dropped.
        mov rax, 3;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // PCIe_UP
        mov rsi, 11;
        mov rdx, 21;
        call dphp_on_tunnel_established;
        cmp rax, 0;
        jne dphpw_fail_stage;

        mov rdi, 2;                      // INGESTED
        call dphp_stat;
        cmp rax, 2;
        jne dphpw_fail_stage;
        mov rdi, 3;                      // FILTERED
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 4;                      // EMITTED (unchanged)
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 6;                      // RING_HEAD (unchanged)
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;

        // -- 4. USB3 dropped.
        mov rax, 4;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // USB3
        mov rsi, 12;
        mov rdx, 22;
        call dphp_on_tunnel_established;
        cmp rax, 0;
        jne dphpw_fail_stage;

        mov rdi, 2;
        call dphp_stat;
        cmp rax, 3;
        jne dphpw_fail_stage;
        mov rdi, 3;
        call dphp_stat;
        cmp rax, 2;
        jne dphpw_fail_stage;

        // -- 5. HOSTIF dropped.
        mov rax, 5;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // HOSTIF
        mov rsi, 13;
        mov rdx, 23;
        call dphp_on_tunnel_established;
        cmp rax, 0;
        jne dphpw_fail_stage;

        mov rdi, 2;
        call dphp_stat;
        cmp rax, 4;
        jne dphpw_fail_stage;
        mov rdi, 3;
        call dphp_stat;
        cmp rax, 3;
        jne dphpw_fail_stage;

        // -- 6. tunnel_torn DP.
        mov rax, 6;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // DP
        mov rsi, 10;
        mov rdx, 20;
        call dphp_on_tunnel_torn;
        cmp rax, 0;
        jne dphpw_fail_stage;

        mov rdi, 1;                      // REMOVED
        call dphp_stat;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 4;                      // EMITTED
        call dphp_stat;
        cmp rax, 2;
        jne dphpw_fail_stage;

        // Ring slot 1 stamped with REMOVED.
        mov rdi, 1;
        call dphp_event_in_use;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 1;
        call dphp_event_kind;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 1;
        call dphp_event_source;
        cmp rax, 10;
        jne dphpw_fail_stage;

        mov rdi, 6;                      // RING_HEAD
        call dphp_stat;
        cmp rax, 2;
        jne dphpw_fail_stage;

        // -- 7. Bad tunnel type.
        mov rax, 7;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 1;
        mov rdx, 2;
        call dphp_on_tunnel_established;
        mov r11, 0xFFFFF80E;
        cmp rax, r11;
        jne dphpw_fail_stage;

        // -- 8. Bad source adapter (>24 bit).
        mov rax, 8;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // DP
        mov rsi, 0x1000000;              // 2^24
        mov rdx, 2;
        call dphp_on_tunnel_established;
        mov r11, 0xFFFFF80D;
        cmp rax, r11;
        jne dphpw_fail_stage;

        // -- 9. Bad sink adapter on tear.
        mov rax, 9;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 1;
        mov rdx, 0x1000000;
        call dphp_on_tunnel_torn;
        mov r11, 0xFFFFF80D;
        cmp rax, r11;
        jne dphpw_fail_stage;

        // -- 10. is_dp_tunnel checks.
        mov rax, 10;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        call dphp_is_dp_tunnel;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 0;
        call dphp_is_dp_tunnel;
        cmp rax, 0;
        jne dphpw_fail_stage;
        mov rdi, 3;
        call dphp_is_dp_tunnel;
        cmp rax, 0;
        jne dphpw_fail_stage;
        mov rdi, 4;
        call dphp_is_dp_tunnel;
        cmp rax, 0;
        jne dphpw_fail_stage;

        // -- 11. placeholder_count / by_kind.
        mov rax, 11;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        call dphp_placeholder_count;
        cmp rax, 2;
        jne dphpw_fail_stage;
        mov rdi, 0;
        call dphp_placeholder_by_kind;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 1;
        call dphp_placeholder_by_kind;
        cmp rax, 1;
        jne dphpw_fail_stage;
        mov rdi, 2;
        call dphp_placeholder_by_kind;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne dphpw_fail_stage;

        // -- 12. Ring wrap. Reset first.
        mov rax, 12;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        call dphp_reset;

        // Emit 17 DP APPEARED events; ring holds 16, so RING_HEAD wraps
        // back to 1 after the 17th (0..15 fill; 16th at index 0 wraps
        // to 1).
        mov rbx, 0;
      dphpw_wrap_scan:
        cmp rbx, 17;
        jae dphpw_wrap_done;
        mov rdi, 2;                      // DP
        mov rsi, rbx;
        add rsi, 100;                    // unique source
        mov rdx, rbx;
        add rdx, 200;                    // unique sink
        call dphp_on_tunnel_established;
        cmp rax, 0;
        jne dphpw_fail_stage;
        add rbx, 1;
        jmp dphpw_wrap_scan;
      dphpw_wrap_done:

        mov rdi, 4;                      // EMITTED
        call dphp_stat;
        cmp rax, 17;
        jne dphpw_fail_stage;
        mov rdi, 6;                      // RING_HEAD
        call dphp_stat;
        cmp rax, 1;                      // wrapped to 1
        jne dphpw_fail_stage;

        // -- 13. Arbitrated == 0.
        mov rax, 13;
        lea rcx, [rip + _dphpw_stage];
        mov [rcx], rax;

        call dphp_arbitrated;
        cmp rax, 0;
        jne dphpw_fail_stage;

        // Cleanup.
        call dphp_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dphpw_ok];
        call klog_s1;

        xor rax, rax;
        jmp dphpw_out;

      dphpw_fail_stage:
        lea rax, [rip + _dphpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dphpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dphp_reset;
        mov rax, 1;

      dphpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
