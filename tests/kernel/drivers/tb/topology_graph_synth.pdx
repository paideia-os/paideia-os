// tests/kernel/drivers/tb/topology_graph_synth.pdx — R35.M7-001 (#1223)
//
// Boot witness for the TB4 topology graph model.
//
// Asserts:
//   (a) reset leaves router_count == 0, edge_count == 0.
//   (b) add three routers (r=1, r=2, r=3) with port_counts 4/8/2;
//       router_count == 3; each is findable.
//   (c) duplicate add refuses DUP_ROUTER.
//   (d) add router with route > 24 bits refuses BAD_ROUTE.
//   (e) add edge (1.0 <-> 2.1); edge_count == 1;
//       neighbor(1, 0) returns packed (route=2 | port=1);
//       neighbor(2, 1) returns packed (route=1 | port=0).
//   (f) same-port re-add refuses PORT_IN_USE.
//   (g) truly duplicate add (same pair, same orientation) refuses DUP_EDGE.
//   (h) self-loop refuses SELF_LOOP.
//   (i) BAD_PORT refuses port > 63.
//   (j) remove edge (1, 0); edge_count == 0; neighbor returns none.
//   (k) remove router 3; router_count == 2; router_find(3) == NONE.
//
// Fingerprint: R35 TB TOPOLOGY GRAPH OK
//
// No cap slots — module owns its own row tables + stats only.

module TopologyGraphSynth = structure {

  pub let mut _tgw_stage : u64 = 0

  pub let tgw_ok   : [u8; 28] = "R35 TB TOPOLOGY GRAPH OK\n\0\0\0\0"
  pub let tgw_fail : [u8; 30] = "R35 TB TOPOLOGY GRAPH FAIL\n\0\0\0\0"

  pub let topology_graph_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M7-001 (#1223): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rax, 1;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        call tg_reset;

        call tg_router_count;
        cmp rax, 0;
        jne tgw_fail_stage;
        call tg_edge_count;
        cmp rax, 0;
        jne tgw_fail_stage;

        // -- 2. Add three routers.
        mov rax, 2;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 4;
        call tg_router_add;
        // returns row_id (0..31); ensure it's not an error band.
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tgw_fail_stage;

        mov rdi, 2;
        mov rsi, 8;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tgw_fail_stage;

        mov rdi, 3;
        mov rsi, 2;
        call tg_router_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tgw_fail_stage;

        call tg_router_count;
        cmp rax, 3;
        jne tgw_fail_stage;

        mov rdi, 1;
        call tg_router_find;
        cmp rax, 0xFF;
        je  tgw_fail_stage;
        mov rdi, 2;
        call tg_router_find;
        cmp rax, 0xFF;
        je  tgw_fail_stage;
        mov rdi, 3;
        call tg_router_find;
        cmp rax, 0xFF;
        je  tgw_fail_stage;

        // -- 3. DUP_ROUTER.
        mov rax, 3;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 8;
        call tg_router_add;
        mov r11, 0xFFFFF88C;             // DUP_ROUTER
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 4. BAD_ROUTE.
        mov rax, 4;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 0x1000000;              // 25 bits
        mov rsi, 1;
        call tg_router_add;
        mov r11, 0xFFFFF88E;             // BAD_ROUTE
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 5. Add edge 1.0 <-> 2.1.
        mov rax, 5;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 1;
        call tg_edge_add;
        mov r11, 0xFFFFF880;
        cmp rax, r11;
        jae tgw_fail_stage;

        call tg_edge_count;
        cmp rax, 1;
        jne tgw_fail_stage;

        // Neighbor of (1, 0) — expect packed (route=2 | port=1<<24)
        mov rdi, 1;
        mov rsi, 0;
        call tg_edge_neighbor;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tgw_fail_stage;
        // Extract router[23:0] and port[31:24].
        mov r11, rax;
        and r11, 0xFFFFFF;
        cmp r11, 2;
        jne tgw_fail_stage;
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 1;
        jne tgw_fail_stage;

        // Neighbor of (2, 1) — expect (route=1 | port=0<<24)
        mov rdi, 2;
        mov rsi, 1;
        call tg_edge_neighbor;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tgw_fail_stage;
        mov r11, rax;
        and r11, 0xFFFFFF;
        cmp r11, 1;
        jne tgw_fail_stage;
        mov r11, rax;
        shr r11, 24;
        and r11, 0xFF;
        cmp r11, 0;
        jne tgw_fail_stage;

        // -- 6. PORT_IN_USE: try (1.0 <-> 3.0) — 1.0 already taken.
        mov rax, 6;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 3;
        mov rcx, 0;
        call tg_edge_add;
        mov r11, 0xFFFFF888;             // PORT_IN_USE
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 7. DUP_EDGE: try exact (1.0 <-> 2.1).
        mov rax, 7;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 1;
        call tg_edge_add;
        mov r11, 0xFFFFF88B;             // DUP_EDGE
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 8. SELF_LOOP: same router, same port.
        mov rax, 8;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        mov rsi, 5;
        mov rdx, 3;
        mov rcx, 5;
        call tg_edge_add;
        mov r11, 0xFFFFF887;             // SELF_LOOP
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 9. BAD_PORT: port > 63.
        mov rax, 9;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 64;
        mov rdx, 3;
        mov rcx, 1;
        call tg_edge_add;
        mov r11, 0xFFFFF88D;             // BAD_PORT
        cmp rax, r11;
        jne tgw_fail_stage;

        // -- 10. Remove edge (1, 0).
        mov rax, 10;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 1;
        mov rsi, 0;
        call tg_edge_remove;
        cmp rax, 0;
        jne tgw_fail_stage;

        call tg_edge_count;
        cmp rax, 0;
        jne tgw_fail_stage;

        mov rdi, 1;
        mov rsi, 0;
        call tg_edge_neighbor;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tgw_fail_stage;

        // -- 11. Remove router 3.
        mov rax, 11;
        lea rcx, [rip + _tgw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        call tg_router_remove;
        cmp rax, 0;
        jne tgw_fail_stage;

        call tg_router_count;
        cmp rax, 2;
        jne tgw_fail_stage;

        mov rdi, 3;
        call tg_router_find;
        cmp rax, 0xFF;
        jne tgw_fail_stage;

        // Cleanup.
        call tg_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tgw_ok];
        call klog_s1;

        xor rax, rax;
        jmp tgw_out;

      tgw_fail_stage:
        lea rax, [rip + _tgw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tgw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tg_reset;
        mov rax, 1;

      tgw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
