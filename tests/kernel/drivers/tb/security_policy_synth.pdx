// tests/kernel/drivers/tb/security_policy_synth.pdx — R35.M5-002 (#1216)
//
// Boot witness for the TB4 per-dock security-level policy.
//
// Asserts:
//   (a) reset + BAD_DOCK on dock=0
//   (b) set_level(dock, USER) + level_of(dock) == USER
//   (c) set_level with BAD_LEVEL refuses
//   (d) gate USER dock, tunnel_type PCIe/DP/USB3 all allow
//   (e) set_level -> NONE, all three tunnel types deny
//   (f) set_level -> DP_ONLY: DP allow, PCIe/USB3 deny
//   (g) set_level -> USB_ONLY: USB3 allow, PCIe/DP deny
//   (h) gate against a dock with no row returns NOT_FOUND
//   (i) update-in-place: set_level twice on same dock does not consume
//       a second row (still 1 row installed, counters distinguish)
//   (j) fill table (16 rows) then ENOSPC on 17th
//
// Fingerprint: R35 TB SECURITY POLICY OK
//
// No cap slots — module owns a private table + stats only.

module SecurityPolicySynth = structure {

  pub let mut _spw_stage : u64 = 0

  pub let spw_ok   : [u8; 28] = "R35 TB SECURITY POLICY OK\n\0\0"
  pub let spw_fail : [u8; 30] = "R35 TB SECURITY POLICY FAIL\n\0\0"

  pub let security_policy_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M5-002 (#1216): boot witness. See file header for stage list.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        call security_policy_reset;

        // -- 1. BAD_DOCK on 0.
        mov rdi, 0;
        mov rsi, 1;                      // USER
        call security_policy_set_level;
        mov r11, 0xFFFFF8FE;             // BAD_DOCK
        cmp rax, r11;
        jne spw_fail_stage;

        // -- 2. set_level(0x11, USER) + level_of.
        mov rax, 2;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 1;                      // USER
        call security_policy_set_level;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        call security_policy_level_of;
        cmp rax, 1;
        jne spw_fail_stage;

        // -- 3. BAD_LEVEL refusal (level=5, above SECPOL_LVL_MAX).
        mov rax, 3;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 5;
        call security_policy_set_level;
        mov r11, 0xFFFFF8FD;             // BAD_LEVEL
        cmp rax, r11;
        jne spw_fail_stage;

        // -- 4. USER dock: PCIe/DP/USB3 all allow.
        mov rax, 4;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 0;                      // PCIe
        call security_policy_gate_tunnel;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 1;                      // DP
        call security_policy_gate_tunnel;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 2;                      // USB3
        call security_policy_gate_tunnel;
        cmp rax, 0;
        jne spw_fail_stage;

        // -- 5. NONE: all three deny.
        mov rax, 5;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 0;                      // NONE
        call security_policy_set_level;
        cmp rax, 0;
        jne spw_fail_stage;

        mov r13, 0;
      spw_none_loop:
        cmp r13, 3;
        jae spw_none_done;
        mov rdi, 0x11;
        mov rsi, r13;
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8F9;             // DENIED
        cmp rax, r11;
        jne spw_fail_stage;
        add r13, 1;
        jmp spw_none_loop;
      spw_none_done:

        // -- 6. DP_ONLY: DP allow, PCIe/USB3 deny.
        mov rax, 6;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 3;                      // DP_ONLY
        call security_policy_set_level;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 0;                      // PCIe
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8F9;
        cmp rax, r11;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 1;                      // DP
        call security_policy_gate_tunnel;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 2;                      // USB3
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8F9;
        cmp rax, r11;
        jne spw_fail_stage;

        // -- 7. USB_ONLY: USB3 allow, PCIe/DP deny.
        mov rax, 7;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x11;
        mov rsi, 4;                      // USB_ONLY
        call security_policy_set_level;
        cmp rax, 0;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 0;
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8F9;
        cmp rax, r11;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 1;
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8F9;
        cmp rax, r11;
        jne spw_fail_stage;

        mov rdi, 0x11;
        mov rsi, 2;
        call security_policy_gate_tunnel;
        cmp rax, 0;
        jne spw_fail_stage;

        // -- 8. NOT_FOUND for untracked dock.
        mov rax, 8;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rdi, 0x22;                   // never tracked
        mov rsi, 0;
        call security_policy_gate_tunnel;
        mov r11, 0xFFFFF8FA;             // NOT_FOUND
        cmp rax, r11;
        jne spw_fail_stage;

        // -- 9. Fill to 16 (one dock is already installed at 0x11);
        // add 15 more, then 17th should ENOSPC.
        mov rax, 9;
        lea rcx, [rip + _spw_stage];
        mov [rcx], rax;

        mov rbx, 0x30;
        mov r12, 15;
      spw_fill_loop:
        cmp r12, 0;
        je  spw_fill_done;
        mov rdi, rbx;
        mov rsi, 1;                      // USER
        call security_policy_set_level;
        cmp rax, 0;
        jne spw_fail_stage;
        add rbx, 1;
        sub r12, 1;
        jmp spw_fill_loop;
      spw_fill_done:

        mov rdi, rbx;                    // 17th dock
        mov rsi, 1;
        call security_policy_set_level;
        mov r11, 0xFFFFF8FB;             // ENOSPC
        cmp rax, r11;
        jne spw_fail_stage;

        // Cleanup.
        call security_policy_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + spw_ok];
        call klog_s1;

        xor rax, rax;
        jmp spw_out;

      spw_fail_stage:
        lea rax, [rip + _spw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + spw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call security_policy_reset;
        mov rax, 1;

      spw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
