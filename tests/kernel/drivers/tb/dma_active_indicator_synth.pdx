// tests/kernel/drivers/tb/dma_active_indicator_synth.pdx — R35.M5-004 (#1218)
//
// Boot witness for the external-DMA active-indicator source-of-truth
// channel.
//
// Asserts:
//   (a) reset leaves observe() == 0
//   (b) publish_enter bumps observe by 1
//   (c) two enters -> observe == 2
//   (d) publish_leave decrements
//   (e) leave against zero refuses UNDERFLOW and leaves observe == 0
//   (f) 256 enters saturate at cap; the 257th refuses ENOSPC
//
// Fingerprint: R35 TB DMA INDICATOR OK
//
// No cap slots — module owns a private counter + stats only.

module DmaActiveIndicatorSynth = structure {

  pub let mut _daiw_stage : u64 = 0

  pub let daiw_ok   : [u8; 22] = "TB DMA INDICATOR OK\n\0\0"
  pub let daiw_fail : [u8; 24] = "TB DMA INDICATOR FAIL\n\0\0"

  pub let dma_active_indicator_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R35.M5-004 (#1218): boot witness. Stages: (1) reset -> 0. (2) enter -> 1. (3) enter -> 2. (4) leave -> 1. (5) leave -> 0. (6) leave at zero refuses UNDERFLOW. (7) fill to cap then ENOSPC.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rax, 1;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;

        call dma_active_indicator_reset;
        call dma_active_observe;
        cmp rax, 0;
        jne daiw_fail_stage;

        // -- 2. Enter -> 1.
        mov rax, 2;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;
        call dma_active_publish_enter;
        cmp rax, 0;
        jne daiw_fail_stage;
        call dma_active_observe;
        cmp rax, 1;
        jne daiw_fail_stage;

        // -- 3. Enter -> 2.
        mov rax, 3;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;
        call dma_active_publish_enter;
        cmp rax, 0;
        jne daiw_fail_stage;
        call dma_active_observe;
        cmp rax, 2;
        jne daiw_fail_stage;

        // -- 4. Leave -> 1.
        mov rax, 4;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;
        call dma_active_publish_leave;
        cmp rax, 0;
        jne daiw_fail_stage;
        call dma_active_observe;
        cmp rax, 1;
        jne daiw_fail_stage;

        // -- 5. Leave -> 0.
        mov rax, 5;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;
        call dma_active_publish_leave;
        cmp rax, 0;
        jne daiw_fail_stage;
        call dma_active_observe;
        cmp rax, 0;
        jne daiw_fail_stage;

        // -- 6. Leave at zero refuses UNDERFLOW.
        mov rax, 6;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;
        call dma_active_publish_leave;
        mov r11, 0xFFFFF8DE;             // UNDERFLOW
        cmp rax, r11;
        jne daiw_fail_stage;
        call dma_active_observe;
        cmp rax, 0;
        jne daiw_fail_stage;

        // -- 7. Fill to cap (256 enters) then ENOSPC on 257.
        mov rax, 7;
        lea rcx, [rip + _daiw_stage];
        mov [rcx], rax;

        xor rbx, rbx;
      daiw_fill_loop:
        cmp rbx, 256;
        jae daiw_fill_done;
        call dma_active_publish_enter;
        cmp rax, 0;
        jne daiw_fail_stage;
        add rbx, 1;
        jmp daiw_fill_loop;
      daiw_fill_done:

        call dma_active_observe;
        cmp rax, 256;
        jne daiw_fail_stage;

        // 257th refuses ENOSPC.
        call dma_active_publish_enter;
        mov r11, 0xFFFFF8DD;             // ENOSPC
        cmp rax, r11;
        jne daiw_fail_stage;

        // Cleanup: reset for next boot phase.
        call dma_active_indicator_reset;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + daiw_ok];
        call klog_s1;

        xor rax, rax;
        jmp daiw_out;

      daiw_fail_stage:
        lea rax, [rip + _daiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + daiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dma_active_indicator_reset;
        mov rax, 1;

      daiw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
