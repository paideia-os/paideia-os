// tests/kernel/drivers/dpy/plane_cursor_synth.pdx — R36.M4-004 (#1252)
//
// Boot witness for plane_cursor. Asserts validators, per-role gate
// refusals (WRONG_TYPE, BAD_SIZE, BAD_FORMAT), happy-path bind honesty
// pin, immediate position update, and NOT_BOUND refusal on an unbound
// pipe.
//
// Fingerprint: R36 PLANE CURSOR OK
//
// Cap slots 368..383.

module PlaneCursorSynth = structure {

  pub let mut _plcurw_stage : u64 = 0

  pub let plcurw_ok   : [u8; 21] = "R36 PLANE CURSOR OK\n\0"
  pub let plcurw_fail : [u8; 23] = "R36 PLANE CURSOR FAIL\n\0"

  pub let plcurw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-004 (#1252): clear cap_table slots 368..383.",
      block: {
        push rbx;
        mov rbx, 368;
      plcurwc_loop:
        cmp rbx, 384;
        jae plcurwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp plcurwc_loop;
      plcurwc_done:
        pop rbx;
        ret
      }
    }

  pub let plcurw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): reset plane_cursor state + DISPLAY_PLANE row table.",
      block: {
        call plane_cursor_reset;
        call display_plane_table_reset;
        ret
      }
    }

  pub let plcurw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-004 (#1252): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let plcurw_mint_plane : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (plane_key: u64) (packed_class: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-004 (#1252): helper — mint KIND_DISPLAY_PLANE. Parent memory is slot 369. packed_class layout: mtype[7:0] | zorder[15:8] | format[31:16]. Five args to stay under paideia-as's SysV register-pass ceiling of six.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rax, r8;                     // h
        shl rax, 48;
        mov r10, rcx;                    // w
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, r13;
        and r10, 0xFFFFFFFF;
        or  rax, r10;

        mov rdi, rbx;
        mov rsi, 369;
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 369;
        mov r9, rax;
        call display_plane_cap_mint_inner;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let plane_cursor_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M4-004 (#1252): boot witness. Stages: (1) validators. (2) NOT_BOUND (position set before bind). (3) WRONG_TYPE (primary row). (4) BAD_FORMAT (NV12). (5) BAD_SIZE (100 not in {64,128,256}; and non-square 64x128). (6) Happy path bind -> DEFERRED_HARDWARE + record. (7) Immediate position set + accessor readback.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        call plcurw_clear;
        call plcurw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call plcur_pipe_valid;
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 4;
        call plcur_pipe_valid;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 64;
        call plcur_size_valid;
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 128;
        call plcur_size_valid;
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 256;
        call plcur_size_valid;
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 100;
        call plcur_size_valid;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 3;
        call plcur_format_valid;         // RGBA
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 0;
        call plcur_format_valid;         // XRGB
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0xFFFF;
        call plcur_pos_valid;
        cmp rax, 1;
        jne plcurw_fail_stage;
        mov rdi, 0x10000;
        call plcur_pos_valid;
        cmp rax, 0;
        jne plcurw_fail_stage;

        // -- 2. NOT_BOUND: position set before bind.
        mov rax, 2;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 200;
        call plane_cursor_position_set;
        mov r11, 0xFFFFF6B8;             // NOT_BOUND
        cmp rax, r11;
        jne plcurw_fail_stage;

        // Parent memory.
        mov rdi, 369;
        mov rsi, 0x200;
        mov rdx, 0xC30F0001;
        call plcurw_memory;

        // -- 3. WRONG_TYPE: primary row at slot 370.
        mov rax, 3;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        // packed_class = type=0 | z=0 | fmt=0 = 0
        mov rdi, 370;
        mov rsi, 0xBEEC0001;
        mov rdx, 0;
        mov rcx, 128;
        mov r8, 128;
        call plcurw_mint_plane;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        mov rsi, 370;
        call plane_cursor_bind;
        mov r11, 0xFFFFF6BD;             // WRONG_TYPE
        cmp rax, r11;
        jne plcurw_fail_stage;

        // -- 4. BAD_FORMAT: cursor row with NV12 at slot 371.
        mov rax, 4;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        // packed_class = type=2 | z=0 | fmt=1<<16 = 0x10002
        mov rdi, 371;
        mov rsi, 0xBEEC0002;
        mov rdx, 0x10002;
        mov rcx, 128;
        mov r8, 128;
        call plcurw_mint_plane;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        mov rsi, 371;
        call plane_cursor_bind;
        mov r11, 0xFFFFF6BB;             // BAD_FORMAT
        cmp rax, r11;
        jne plcurw_fail_stage;

        // -- 5. BAD_SIZE: cursor row with 64x128 (non-square) at slot 372.
        mov rax, 5;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        // packed_class = type=2 | z=0 | fmt=3<<16 = 0x30002
        mov rdi, 372;
        mov rsi, 0xBEEC0003;
        mov rdx, 0x30002;
        mov rcx, 64;
        mov r8, 128;                     // non-square
        call plcurw_mint_plane;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        mov rsi, 372;
        call plane_cursor_bind;
        mov r11, 0xFFFFF6BC;             // BAD_SIZE
        cmp rax, r11;
        jne plcurw_fail_stage;

        // Also BAD_SIZE: cursor row with 100x100 at slot 373.
        // packed_class = 2 | 0 | 3<<16 = 0x30002
        mov rdi, 373;
        mov rsi, 0xBEEC0004;
        mov rdx, 0x30002;
        mov rcx, 100;
        mov r8, 100;
        call plcurw_mint_plane;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        mov rsi, 373;
        call plane_cursor_bind;
        mov r11, 0xFFFFF6BC;             // BAD_SIZE
        cmp rax, r11;
        jne plcurw_fail_stage;

        // -- 6. Happy path bind (64x64 RGBA cursor at slot 374).
        mov rax, 6;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        // packed_class = type=2 | z=0 | fmt=3<<16 = 0x30002
        mov rdi, 374;
        mov rsi, 0xBEEC0005;
        mov rdx, 0x30002;
        mov rcx, 64;
        mov r8, 64;
        call plcurw_mint_plane;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        mov rsi, 374;
        call plane_cursor_bind;
        mov r11, 0xFFFFF6B7;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne plcurw_fail_stage;

        mov rdi, 0;
        call plcur_bound;
        cmp rax, 1;
        jne plcurw_fail_stage;

        mov rdi, 0;
        call plcur_size_of;
        cmp rax, 64;
        jne plcurw_fail_stage;

        // -- 7. Immediate position set.
        mov rax, 7;
        lea rcx, [rip + _plcurw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 500;
        mov rdx, 700;
        call plane_cursor_position_set;
        cmp rax, 0;
        jne plcurw_fail_stage;

        mov rdi, 0;
        call plcur_pos_x_of;
        cmp rax, 500;
        jne plcurw_fail_stage;

        mov rdi, 0;
        call plcur_pos_y_of;
        cmp rax, 700;
        jne plcurw_fail_stage;

        // BAD_POS refusal (y > 0xFFFF).
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 0x10000;
        call plane_cursor_position_set;
        mov r11, 0xFFFFF6BA;
        cmp rax, r11;
        jne plcurw_fail_stage;

        // Arbitration honesty pin.
        call plcur_arbitrated;
        cmp rax, 0;
        jne plcurw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plcurw_ok];
        call klog_s1;

        call plcurw_scrub;
        call plcurw_clear;
        xor rax, rax;
        jmp plcurw_out;

      plcurw_fail_stage:
        lea rax, [rip + _plcurw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plcurw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call plcurw_scrub;
        call plcurw_clear;
        mov rax, 1;

      plcurw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
