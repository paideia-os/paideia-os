// tests/kernel/drivers/dpy/plane_overlay_synth.pdx — R36.M4-003 (#1251)
//
// Boot witness for plane_overlay. Asserts YUV format acceptance, z-order
// window (1..15), alpha window (0..255), NV12/YUYV/P010 subsampled
// stride arithmetic, and happy-path bind honesty pin.
//
// Fingerprint: PLANE OVERLAY OK
//
// Cap slots 96..111.

module PlaneOverlaySynth = structure {

  pub let mut _plovrw_stage : u64 = 0

  pub let plovrw_ok   : [u8; 18] = "PLANE OVERLAY OK\n\0"
  pub let plovrw_fail : [u8; 20] = "PLANE OVERLAY FAIL\n\0"

  pub let plovrw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-003 (#1251): clear cap_table slots 96..111.",
      block: {
        push rbx;
        mov rbx, 96;
      plovrwc_loop:
        cmp rbx, 112;
        jae plovrwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp plovrwc_loop;
      plovrwc_done:
        pop rbx;
        ret
      }
    }

  pub let plovrw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-003 (#1251): reset plane_overlay state + DISPLAY_PLANE row table.",
      block: {
        call plane_overlay_reset;
        call display_plane_table_reset;
        ret
      }
    }

  pub let plovrw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-003 (#1251): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // Mint one KIND_DISPLAY_PLANE at slot. packed_class = mtype | z<<8 |
  // fmt<<16. Five args (paideia-as SysV cap = 6, and mint_inner already
  // takes six).
  pub let plovrw_mint_plane : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (plane_key: u64) (packed_class: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-003 (#1251): helper — mint KIND_DISPLAY_PLANE. Parent memory is slot 97. packed_class layout: mtype[7:0] | zorder[15:8] | format[31:16]. Five args to stay under paideia-as's SysV register-pass ceiling of six.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // plane_key
        mov r13, rdx;                    // packed_class

        mov rax, r8;                     // h
        shl rax, 48;
        mov r10, rcx;                    // w
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, r13;
        and r10, 0xFFFFFFFF;
        or  rax, r10;

        mov rdi, rbx;
        mov rsi, 97;
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 97;
        mov r9, rax;
        call display_plane_cap_mint_inner;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let plane_overlay_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M4-003 (#1251): boot witness. Stages: (1) validators. (2) Stride math NV12 / YUYV / P010. (3) WRONG_TYPE (primary row). (4) BAD_ZORDER (z=0). (5) BAD_FORMAT (XRGB). (6) BAD_ALPHA (>0xFF). (7) Happy path -> DEFERRED_HARDWARE + record.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        call plovrw_clear;
        call plovrw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call plovr_slot_valid;
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 16;
        call plovr_slot_valid;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 1;
        call plovr_zorder_valid;
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 15;
        call plovr_zorder_valid;
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 0;
        call plovr_zorder_valid;
        cmp rax, 0;
        jne plovrw_fail_stage;
        mov rdi, 16;
        call plovr_zorder_valid;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 1;
        call plovr_format_valid;         // NV12
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 2;
        call plovr_format_valid;         // YUYV
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 4;
        call plovr_format_valid;         // P010
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 0;
        call plovr_format_valid;         // XRGB rejected
        cmp rax, 0;
        jne plovrw_fail_stage;
        mov rdi, 3;
        call plovr_format_valid;         // RGBA rejected
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_alpha_valid;
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 0xFF;
        call plovr_alpha_valid;
        cmp rax, 1;
        jne plovrw_fail_stage;
        mov rdi, 0x100;
        call plovr_alpha_valid;
        cmp rax, 0;
        jne plovrw_fail_stage;

        // -- 2. Stride math.
        mov rax, 2;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        // NV12 1920: Y = align_up_64(1920) = 1920 (already 64-multiple).
        mov rdi, 1920;
        mov rsi, 1;
        call plovr_y_stride;
        cmp rax, 1920;
        jne plovrw_fail_stage;

        // NV12 1920: UV = align_up_64(1920) = 1920.
        mov rdi, 1920;
        mov rsi, 1;
        call plovr_uv_stride;
        cmp rax, 1920;
        jne plovrw_fail_stage;

        // NV12 1000: Y = align_up_64(1000) = 1024.
        mov rdi, 1000;
        mov rsi, 1;
        call plovr_y_stride;
        cmp rax, 1024;
        jne plovrw_fail_stage;

        // YUYV 1920: Y = align_up_64(3840) = 3840.
        mov rdi, 1920;
        mov rsi, 2;
        call plovr_y_stride;
        cmp rax, 3840;
        jne plovrw_fail_stage;

        // YUYV 1920: UV = 0.
        mov rdi, 1920;
        mov rsi, 2;
        call plovr_uv_stride;
        cmp rax, 0;
        jne plovrw_fail_stage;

        // P010 1920: Y = align_up_64(3840) = 3840.
        mov rdi, 1920;
        mov rsi, 4;
        call plovr_y_stride;
        cmp rax, 3840;
        jne plovrw_fail_stage;

        // P010 1920: UV = 3840.
        mov rdi, 1920;
        mov rsi, 4;
        call plovr_uv_stride;
        cmp rax, 3840;
        jne plovrw_fail_stage;

        // Parent memory.
        mov rdi, 97;
        mov rsi, 0x200;
        mov rdx, 0xC20F0001;
        call plovrw_memory;

        // -- 3. WRONG_TYPE: primary row at slot 98.
        mov rax, 3;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        // packed_class = type=0 | z=0<<8 | fmt=0<<16 = 0
        mov rdi, 98;
        mov rsi, 0xBEED0001;
        mov rdx, 0;
        mov rcx, 1920;
        mov r8, 1080;
        call plovrw_mint_plane;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 0;                      // overlay_slot
        mov rsi, 98;
        mov rdx, 128;
        call plane_overlay_bind;
        mov r11, 0xFFFFF6CD;             // WRONG_TYPE
        cmp rax, r11;
        jne plovrw_fail_stage;

        // -- 4. BAD_ZORDER: overlay with z=0.
        mov rax, 4;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        // packed_class = type=1 | z=0<<8 | fmt=1<<16 = 0x10001
        mov rdi, 99;
        mov rsi, 0xBEED0002;
        mov rdx, 0x10001;
        mov rcx, 1920;
        mov r8, 1080;
        call plovrw_mint_plane;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 0;
        mov rsi, 99;
        mov rdx, 128;
        call plane_overlay_bind;
        mov r11, 0xFFFFF6CC;             // BAD_ZORDER
        cmp rax, r11;
        jne plovrw_fail_stage;

        // -- 5. BAD_FORMAT: overlay with XRGB.
        mov rax, 5;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        // packed_class = type=1 | z=1<<8 | fmt=0<<16 = 0x101
        mov rdi, 100;
        mov rsi, 0xBEED0003;
        mov rdx, 0x101;
        mov rcx, 1920;
        mov r8, 1080;
        call plovrw_mint_plane;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 128;
        call plane_overlay_bind;
        mov r11, 0xFFFFF6CB;             // BAD_FORMAT
        cmp rax, r11;
        jne plovrw_fail_stage;

        // -- 6. BAD_ALPHA: alpha > 0xFF.
        mov rax, 6;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        // Mint a valid overlay row first at slot 101.
        // packed_class = type=1 | z=2<<8 | fmt=1<<16 = 0x10201
        mov rdi, 101;
        mov rsi, 0xBEED0004;
        mov rdx, 0x10201;
        mov rcx, 1920;
        mov r8, 1080;
        call plovrw_mint_plane;
        cmp rax, 0;
        jne plovrw_fail_stage;

        mov rdi, 0;
        mov rsi, 101;
        mov rdx, 0x100;                  // bad alpha
        call plane_overlay_bind;
        mov r11, 0xFFFFF6CA;             // BAD_ALPHA
        cmp rax, r11;
        jne plovrw_fail_stage;

        // -- 7. Happy path -> DEFERRED_HARDWARE + record.
        mov rax, 7;
        lea rcx, [rip + _plovrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 101;
        mov rdx, 128;
        call plane_overlay_bind;
        mov r11, 0xFFFFF6C8;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_bound;
        cmp rax, 1;
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_format_of;
        cmp rax, 1;
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_y_stride_of;
        cmp rax, 1920;                   // NV12 1920 -> 1920
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_uv_stride_of;
        cmp rax, 1920;
        jne plovrw_fail_stage;

        mov rdi, 0;
        call plovr_zorder_of;
        cmp rax, 2;
        jne plovrw_fail_stage;

        // Arbitration honesty pin.
        call plovr_arbitrated;
        cmp rax, 0;
        jne plovrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plovrw_ok];
        call klog_s1;

        call plovrw_scrub;
        call plovrw_clear;
        xor rax, rax;
        jmp plovrw_out;

      plovrw_fail_stage:
        lea rax, [rip + _plovrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plovrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call plovrw_scrub;
        call plovrw_clear;
        mov rax, 1;

      plovrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
