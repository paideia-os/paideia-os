// tests/kernel/drivers/dpy/vrr_synth.pdx -- G1.M2-001 (#1432) +
// G1.M2-004 (#1435)
//
// Boot witness for the VRR probe cross-check + adaptive-sync
// arming path.
//
// Fingerprint: DPY VRR OK

module VrrSynth = structure {

  pub let mut _vrrdw_stage : u64 = 0

  pub let vrrdw_ok   : [u8; 12] = "DPY VRR OK\n\0"
  pub let vrrdw_fail : [u8; 14] = "DPY VRR FAIL\n\0"

  pub let dpy_vrr_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "G1.M2-001 (#1432) + G1.M2-004 (#1435): boot witness. Stages: (1) reset. (2) probe cross-check: DPCD=0 -> NOT_ADAPTIVE. (3) probe cross-check: mismatch -> RANGE_MISMATCH. (4) probe cross-check happy (40,144 both sides). (5) ddi_valid: 15 ok, 16 no. (6) arm(3), is_armed(3) yes, arm(3) again -> ALREADY_ARMED. (7) disarm(3), is_armed(3) no. (8) disarm(3) again -> NOT_ARMED. (9) BAD_DDI on arm(20).",
      block: {
        push rbx;
        push r12;

        mov rax, 1;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        call dpy_vrr_reset;

        // 2. DPCD=0 -> NOT_ADAPTIVE.
        mov rax, 2;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 144;
        mov rdx, 40;
        mov rcx, 144;
        call dpy_vrr_probe_cross_check;
        mov r10, 0xFFFFF66F;
        cmp rax, r10;
        jne vrrdw_fail_stage;

        // 3. mismatch -> RANGE_MISMATCH.
        mov rax, 3;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 40;
        mov rsi, 144;
        mov rdx, 40;
        mov rcx, 60;
        call dpy_vrr_probe_cross_check;
        mov r10, 0xFFFFF66E;
        cmp rax, r10;
        jne vrrdw_fail_stage;

        // 4. happy.
        mov rax, 4;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 40;
        mov rsi, 144;
        mov rdx, 40;
        mov rcx, 144;
        call dpy_vrr_probe_cross_check;
        cmp rax, 0;
        jne vrrdw_fail_stage;

        // 5. ddi_valid.
        mov rax, 5;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 15;
        call dpy_vrr_ddi_valid;
        cmp rax, 1;
        jne vrrdw_fail_stage;
        mov rdi, 16;
        call dpy_vrr_ddi_valid;
        cmp rax, 0;
        jne vrrdw_fail_stage;

        // 6. arm(3), is_armed(3), arm(3) again.
        mov rax, 6;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call dpy_vrr_arm;
        cmp rax, 0;
        jne vrrdw_fail_stage;
        mov rdi, 3;
        call dpy_vrr_is_armed;
        cmp rax, 1;
        jne vrrdw_fail_stage;
        mov rdi, 3;
        call dpy_vrr_arm;
        mov r10, 0xFFFFF66C;
        cmp rax, r10;
        jne vrrdw_fail_stage;

        // 7. disarm(3), is_armed(3) no.
        mov rax, 7;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call dpy_vrr_disarm;
        cmp rax, 0;
        jne vrrdw_fail_stage;
        mov rdi, 3;
        call dpy_vrr_is_armed;
        cmp rax, 0;
        jne vrrdw_fail_stage;

        // 8. disarm(3) again -> NOT_ARMED.
        mov rax, 8;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call dpy_vrr_disarm;
        mov r10, 0xFFFFF66B;
        cmp rax, r10;
        jne vrrdw_fail_stage;

        // 9. arm(20) -> BAD_DDI.
        mov rax, 9;
        lea rcx, [rip + _vrrdw_stage];
        mov [rcx], rax;
        mov rdi, 20;
        call dpy_vrr_arm;
        mov r10, 0xFFFFF66D;
        cmp rax, r10;
        jne vrrdw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrrdw_ok];
        call klog_s1;

        call dpy_vrr_reset;
        xor rax, rax;
        jmp vrrdw_out;

      vrrdw_fail_stage:
        lea rax, [rip + _vrrdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrrdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpy_vrr_reset;
        mov rax, 1;

      vrrdw_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
