// tests/kernel/drivers/dpy/pwr_wells_synth.pdx — R36.M1-002 (#1236)
//
// Boot witness for the display power-wells scaffold. Asserts §1's
// PG1 -> PG2 -> DDI enable ordering, reverse disable ordering, per-
// gen CDCLK setpoint gate, and PLL-not-enabled refusal for CDCLK
// set with PG1 down.
//
// Fingerprint: R36 PWR WELLS OK

module PwrWellsSynth = structure {

  pub let mut _pwrw_stage : u64 = 0

  pub let pwrw_ok   : [u8; 18] = "R36 PWR WELLS OK\n\0"
  pub let pwrw_fail : [u8; 20] = "R36 PWR WELLS FAIL\n\0"

  pub let pwr_wells_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M1-002 (#1236): boot witness. Stages: (1) reset. (2) well id validator. (3) enable PG1 (root). (4) enable PG2 with PG1 up. (5) enable DDI_A. (6) BAD_ORDER: PG2 without PG1 (using fresh reset). (7) ALREADY_ON. (8) disable ordering: DDI_A, PG2, PG1. (9) CDCLK setpoint valid + invalid. (10) NOT_ENABLED on CDCLK set with PG1 down. (11) CDCLK set with PG1 up.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        call pwr_wells_reset;

        // -- 2. Well id validator.
        mov rax, 2;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pwr_well_id_valid;
        cmp rax, 1;
        jne pwrw_fail_stage;

        mov rdi, 6;
        call pwr_well_id_valid;
        cmp rax, 1;
        jne pwrw_fail_stage;

        mov rdi, 7;
        call pwr_well_id_valid;
        cmp rax, 0;
        jne pwrw_fail_stage;

        // -- 3. Enable PG1.
        mov rax, 3;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // PG1
        call pwr_well_enable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        mov rdi, 0;
        call pwr_well_is_on;
        cmp rax, 1;
        jne pwrw_fail_stage;

        // -- 4. Enable PG2.
        mov rax, 4;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // PG2
        call pwr_well_enable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        // -- 5. Enable DDI_A.
        mov rax, 5;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // DDI_A
        call pwr_well_enable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        // -- 6. BAD_ORDER: PG2 without PG1 (reset first).
        mov rax, 6;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        call pwr_wells_reset;
        mov rdi, 1;                      // PG2
        call pwr_well_enable;
        mov r11, 0xFFFFF7AD;             // BAD_ORDER
        cmp rax, r11;
        jne pwrw_fail_stage;

        // Restore hierarchy for later stages.
        mov rdi, 0;
        call pwr_well_enable;
        mov rdi, 1;
        call pwr_well_enable;
        mov rdi, 2;
        call pwr_well_enable;

        // -- 7. ALREADY_ON.
        mov rax, 7;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // DDI_A already up
        call pwr_well_enable;
        mov r11, 0xFFFFF7AC;             // ALREADY_ON
        cmp rax, r11;
        jne pwrw_fail_stage;

        // -- 8. Disable ordering: PG1 refused (PG2 up), then DDI_A,
        // then PG2, then PG1 succeed.
        mov rax, 8;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // PG1 (PG2 up: refuse)
        call pwr_well_disable;
        mov r11, 0xFFFFF7AD;             // BAD_ORDER
        cmp rax, r11;
        jne pwrw_fail_stage;

        mov rdi, 2;                      // DDI_A off
        call pwr_well_disable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        mov rdi, 1;                      // PG2 off
        call pwr_well_disable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        mov rdi, 0;                      // PG1 off
        call pwr_well_disable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        // -- 9. CDCLK setpoint valid.
        mov rax, 9;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // Xe1
        mov rsi, 307200;
        call pwr_cdclk_setpoint_valid;
        cmp rax, 1;
        jne pwrw_fail_stage;

        mov rdi, 2;                      // Xe2
        mov rsi, 480000;
        call pwr_cdclk_setpoint_valid;
        cmp rax, 1;
        jne pwrw_fail_stage;

        mov rdi, 3;                      // Xe3
        mov rsi, 819200;
        call pwr_cdclk_setpoint_valid;
        cmp rax, 1;
        jne pwrw_fail_stage;

        mov rdi, 1;                      // Xe1: 480000 is NOT valid
        mov rsi, 480000;
        call pwr_cdclk_setpoint_valid;
        cmp rax, 0;
        jne pwrw_fail_stage;

        // -- 10. NOT_ENABLED with PG1 down.
        mov rax, 10;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        call pwr_wells_reset;
        mov rdi, 2;
        mov rsi, 540000;
        call pwr_cdclk_set;
        mov r11, 0xFFFFF7A8;             // NOT_ENABLED
        cmp rax, r11;
        jne pwrw_fail_stage;

        // -- 11. CDCLK set with PG1 up.
        mov rax, 11;
        lea rcx, [rip + _pwrw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call pwr_well_enable;
        cmp rax, 0;
        jne pwrw_fail_stage;

        mov rdi, 2;                      // Xe2
        mov rsi, 540000;
        call pwr_cdclk_set;
        cmp rax, 0;
        jne pwrw_fail_stage;

        call pwr_cdclk_get;
        mov r11, 540000;
        cmp rax, r11;
        jne pwrw_fail_stage;

        // Bad setpoint (Xe2, 999999).
        mov rdi, 2;
        mov rsi, 999999;
        call pwr_cdclk_set;
        mov r11, 0xFFFFF7A9;             // BAD_SETPOINT
        cmp rax, r11;
        jne pwrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pwrw_ok];
        call klog_s1;

        call pwr_wells_reset;
        xor rax, rax;
        jmp pwrw_out;

      pwrw_fail_stage:
        lea rax, [rip + _pwrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pwrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pwr_wells_reset;
        mov rax, 1;

      pwrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
