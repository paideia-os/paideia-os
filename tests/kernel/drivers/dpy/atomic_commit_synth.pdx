// tests/kernel/drivers/dpy/atomic_commit_synth.pdx — R36.M3-003 (#1246)
//
// Boot witness for atomic_commit driver. Asserts pipe / stride /
// pipesrc validators, WRITE-then-ARM two-phase ordering, ARM without
// WRITE refused, staged state cleared on ARM, arm_ticks stamped.
//
// Fingerprint: R36 ATOMIC COMMIT OK

module AtomicCommitSynth = structure {

  pub let mut _acow_stage : u64 = 0

  pub let acow_ok   : [u8; 21] = "R36 ATOMIC COMMIT OK\n\0"
  pub let acow_fail : [u8; 23] = "R36 ATOMIC COMMIT FAIL\n\0"

  pub let acow_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-003 (#1246): reset atomic_commit state + stats.",
      block: {
        call atomic_commit_reset;
        ret
      }
    }

  pub let atomic_commit_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M3-003 (#1246): boot witness. Stages: (1) validators (pipe/stride/pipesrc). (2) ARM without WRITE refused NOT_STAGED. (3) WRITE with bad stride refused BAD_STAGE. (4) WRITE happy path bumps staged flag + counters. (5) ARM after WRITE returns DEFERRED_HARDWARE (honesty pin) and stamps arm_ticks + clears staged. (6) Double-WRITE overwrites staging bank.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        call acow_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call acom_pipe_valid;
        cmp rax, 1;
        jne acow_fail_stage;
        mov rdi, 4;
        call acom_pipe_valid;
        cmp rax, 0;
        jne acow_fail_stage;

        mov rdi, 128;                    // aligned 64
        call acom_stride_valid;
        cmp rax, 1;
        jne acow_fail_stage;
        mov rdi, 100;                    // not aligned
        call acom_stride_valid;
        cmp rax, 0;
        jne acow_fail_stage;
        mov rdi, 0;
        call acom_stride_valid;
        cmp rax, 0;
        jne acow_fail_stage;

        // PIPESRC layout: h in low 16, v in high 16. 1920x1080 →
        // (1080-1)<<16 | (1920-1) roughly; we just need both halves
        // non-zero for the validator.
        mov r10, 1920;
        mov r11, 1080;
        shl r11, 16;
        or  r10, r11;
        mov rdi, r10;
        call acom_pipesrc_valid;
        cmp rax, 1;
        jne acow_fail_stage;

        mov rdi, 0;
        call acom_pipesrc_valid;
        cmp rax, 0;
        jne acow_fail_stage;

        // -- 2. ARM without WRITE.
        mov rax, 2;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1000;
        call acom_arm;
        mov r11, 0xFFFFF70B;             // NOT_STAGED
        cmp rax, r11;
        jne acow_fail_stage;

        // -- 3. WRITE with bad stride.
        mov rax, 3;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        mov r10, 1920;
        mov r11, 1080;
        shl r11, 16;
        or  r10, r11;

        mov rdi, 0;                      // pipe
        mov rsi, 100;                    // bad stride (not aligned)
        mov rdx, 0;                      // linoff
        mov rcx, 0;                      // tileoff
        mov r8,  r10;                    // pipesrc
        call acom_stage_write;
        mov r11, 0xFFFFF70D;             // BAD_STAGE
        cmp rax, r11;
        jne acow_fail_stage;

        // -- 4. WRITE happy path.
        mov rax, 4;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        mov r10, 1920;
        mov r11, 1080;
        shl r11, 16;
        or  r10, r11;

        mov rdi, 0;
        mov rsi, 7680;                   // stride = 1920 * 4bpp
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  r10;
        call acom_stage_write;
        cmp rax, 0;
        jne acow_fail_stage;

        mov rdi, 0;
        call acom_staged;
        cmp rax, 1;
        jne acow_fail_stage;

        mov rdi, 0;
        call acom_stride_of;
        cmp rax, 7680;
        jne acow_fail_stage;

        // Counter check: 1 write recorded.
        mov rdi, 0;                      // ACOM_ST_WRITES
        call acom_stat;
        cmp rax, 1;
        jne acow_fail_stage;

        // -- 5. ARM after WRITE.
        mov rax, 5;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 12345;
        call acom_arm;
        mov r11, 0xFFFFF70A;             // DEFERRED_HARDWARE (honesty)
        cmp rax, r11;
        jne acow_fail_stage;

        // staged should now be 0 (consumed).
        mov rdi, 0;
        call acom_staged;
        cmp rax, 0;
        jne acow_fail_stage;

        // arm_ticks stamped.
        mov rdi, 0;
        call acom_arm_ticks;
        cmp rax, 12345;
        jne acow_fail_stage;

        // ARM counter bumped.
        mov rdi, 1;                      // ACOM_ST_ARMS
        call acom_stat;
        cmp rax, 1;
        jne acow_fail_stage;

        // -- 6. Double-WRITE overwrites staging (last write wins).
        mov rax, 6;
        lea rcx, [rip + _acow_stage];
        mov [rcx], rax;

        mov r10, 1920;
        mov r11, 1080;
        shl r11, 16;
        or  r10, r11;

        mov rdi, 1;                      // pipe 1
        mov rsi, 7680;
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  r10;
        call acom_stage_write;
        cmp rax, 0;
        jne acow_fail_stage;

        mov rdi, 1;
        mov rsi, 15360;                  // different stride
        mov rdx, 0;
        mov rcx, 0;
        mov r8,  r10;
        call acom_stage_write;
        cmp rax, 0;
        jne acow_fail_stage;

        mov rdi, 1;
        call acom_stride_of;
        cmp rax, 15360;                  // second write wins
        jne acow_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + acow_ok];
        call klog_s1;

        call acow_scrub;
        xor rax, rax;
        jmp acow_out;

      acow_fail_stage:
        lea rax, [rip + _acow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + acow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call acow_scrub;
        mov rax, 1;

      acow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
