// tests/kernel/drivers/dpy/topology_synth.pdx — R36.M2-001 (#1239)
//
// Boot witness for the display topology scaffold. Asserts DDI
// validator, wire-type validator, AUX addr/length gates, path record
// discipline (no duplicates, refuse out-of-range), and MST walk gate.
//
// Fingerprint: DPY TOPOLOGY OK

module TopologySynth = structure {

  pub let mut _dtopow_stage : u64 = 0

  pub let dtopow_ok   : [u8; 17] = "DPY TOPOLOGY OK\n\0"
  pub let dtopow_fail : [u8; 19] = "DPY TOPOLOGY FAIL\n\0"

  pub let dtopo_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M2-001 (#1239): boot witness. Stages: (1) reset. (2) DDI valid. (3) Wire valid. (4) AUX addr valid. (5) AUX len valid. (6) Record path happy. (7) Duplicate refused. (8) BAD_DDI refused. (9) AUX request DEFERRED_HARDWARE. (10) MST walk DEFERRED_HARDWARE. (11) MST bad root refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        call dtopo_reset;

        // -- 2. DDI valid.
        mov rax, 2;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 7;
        call dtopo_ddi_valid;
        cmp rax, 1;
        jne dtopow_fail_stage;
        mov rdi, 8;
        call dtopo_ddi_valid;
        cmp rax, 0;
        jne dtopow_fail_stage;

        // -- 3. Wire valid.
        mov rax, 3;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 3;
        call dtopo_wire_valid;
        cmp rax, 1;
        jne dtopow_fail_stage;
        mov rdi, 4;
        call dtopo_wire_valid;
        cmp rax, 0;
        jne dtopow_fail_stage;

        // -- 4. AUX addr valid.
        mov rax, 4;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 0xFFFFF;
        call dtopo_aux_addr_valid;
        cmp rax, 1;
        jne dtopow_fail_stage;
        mov rdi, 0x100000;
        call dtopo_aux_addr_valid;
        cmp rax, 0;
        jne dtopow_fail_stage;

        // -- 5. AUX len valid.
        mov rax, 5;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 1;
        call dtopo_aux_len_valid;
        cmp rax, 1;
        jne dtopow_fail_stage;
        mov rdi, 16;
        call dtopo_aux_len_valid;
        cmp rax, 1;
        jne dtopow_fail_stage;
        mov rdi, 0;
        call dtopo_aux_len_valid;
        cmp rax, 0;
        jne dtopow_fail_stage;
        mov rdi, 17;
        call dtopo_aux_len_valid;
        cmp rax, 0;
        jne dtopow_fail_stage;

        // -- 6. Record path happy path.
        mov rax, 6;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 100;                    // engine_slot
        mov rsi, 0;                      // ddi
        mov rdx, 1;                      // DP
        call dtopo_path_record;
        cmp rax, 0;                      // row 0
        jne dtopow_fail_stage;

        call dtopo_path_count;
        cmp rax, 1;
        jne dtopow_fail_stage;

        mov rdi, 0;
        call dtopo_path_wire;
        cmp rax, 1;
        jne dtopow_fail_stage;

        // -- 7. Duplicate refused.
        mov rax, 7;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 0;
        mov rdx, 1;
        call dtopo_path_record;
        mov r11, 0xFFFFF777;             // DUPLICATE
        cmp rax, r11;
        jne dtopow_fail_stage;

        // -- 8. BAD_DDI refused.
        mov rax, 8;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 100;
        mov rsi, 8;                      // out of range
        mov rdx, 1;
        call dtopo_path_record;
        mov r11, 0xFFFFF77E;             // BAD_DDI
        cmp rax, r11;
        jne dtopow_fail_stage;

        // -- 9. AUX request returns DEFERRED_HARDWARE on the happy path.
        mov rax, 9;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x00204;                // DPCD offset
        mov rdx, 4;                      // len = 4
        mov rcx, 0;                      // read
        call dtopo_aux_request;
        mov r11, 0xFFFFF776;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne dtopow_fail_stage;

        // AUX bad address.
        mov rdi, 0;
        mov rsi, 0x100000;
        mov rdx, 4;
        mov rcx, 0;
        call dtopo_aux_request;
        mov r11, 0xFFFFF77B;             // BAD_AUX_ADDR
        cmp rax, r11;
        jne dtopow_fail_stage;

        // -- 10. MST walk DEFERRED_HARDWARE.
        mov rax, 10;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dtopo_mst_walk_root;
        mov r11, 0xFFFFF776;
        cmp rax, r11;
        jne dtopow_fail_stage;

        // -- 11. MST bad root refused.
        mov rax, 11;
        lea rcx, [rip + _dtopow_stage];
        mov [rcx], rax;

        mov rdi, 8;
        call dtopo_mst_walk_root;
        mov r11, 0xFFFFF779;             // BAD_MST_ROOT
        cmp rax, r11;
        jne dtopow_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtopow_ok];
        call klog_s1;

        call dtopo_reset;
        xor rax, rax;
        jmp dtopow_out;

      dtopow_fail_stage:
        lea rax, [rip + _dtopow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dtopow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dtopo_reset;
        mov rax, 1;

      dtopow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
