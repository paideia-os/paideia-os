// tests/kernel/drivers/dpy/dpclk_config_synth.pdx — R36.M1-003 (#1237)
//
// Boot witness for the DP link-clock PLL scaffold. Asserts rate
// validator, source validator, divider lookup, enable /
// disable round-trip, lock-detect state.
//
// Fingerprint: DPCLK CONFIG OK

module DpclkConfigSynth = structure {

  pub let mut _dcw_stage : u64 = 0

  pub let dcw_ok   : [u8; 17] = "DPCLK CONFIG OK\n\0"
  pub let dcw_fail : [u8; 19] = "DPCLK CONFIG FAIL\n\0"

  pub let dpclk_config_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M1-003 (#1237): boot witness. Stages: (1) reset. (2) rate validator (RBR/HBR/HBR2/HBR3 + bad). (3) source validator. (4) divider lookup. (5) enable RBR + internal source. (6) is_locked. (7) ALREADY_EN on second enable. (8) disable. (9) enable HBR3 + TBT_ALT after disable. (10) BAD_RATE on illegal rate. (11) BAD_SOURCE on illegal source.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        call dpclk_pll_reset;

        // -- 2. Rate validator.
        mov rax, 2;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 1620000;
        call dpclk_rate_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 2700000;
        call dpclk_rate_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 5400000;
        call dpclk_rate_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 8100000;
        call dpclk_rate_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 3240000;                // not a DP rate
        call dpclk_rate_valid;
        cmp rax, 0;
        jne dcw_fail_stage;

        // -- 3. Source validator.
        mov rax, 3;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call dpclk_source_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 1;
        call dpclk_source_valid;
        cmp rax, 1;
        jne dcw_fail_stage;

        mov rdi, 2;
        call dpclk_source_valid;
        cmp rax, 0;
        jne dcw_fail_stage;

        // -- 4. Divider lookup.
        mov rax, 4;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 1620000;                // RBR
        call dpclk_divider_of_rate;
        mov r11, 0x000800200002;
        cmp rax, r11;
        jne dcw_fail_stage;

        mov rdi, 8100000;                // HBR3
        call dpclk_divider_of_rate;
        mov r11, 0x000200200002;
        cmp rax, r11;
        jne dcw_fail_stage;

        mov rdi, 3240000;                // not a rate
        call dpclk_divider_of_rate;
        mov r11, 0xFFFFF79E;
        cmp rax, r11;
        jne dcw_fail_stage;

        // -- 5. Enable RBR + INTERNAL.
        mov rax, 5;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 1620000;
        mov rsi, 0;
        call dpclk_pll_enable;
        cmp rax, 0;
        jne dcw_fail_stage;

        call dpclk_pll_current_rate;
        mov r11, 1620000;
        cmp rax, r11;
        jne dcw_fail_stage;

        call dpclk_pll_current_source;
        cmp rax, 0;
        jne dcw_fail_stage;

        // -- 6. is_locked.
        mov rax, 6;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        call dpclk_pll_is_locked;
        cmp rax, 1;
        jne dcw_fail_stage;

        // -- 7. ALREADY_EN.
        mov rax, 7;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 2700000;
        mov rsi, 0;
        call dpclk_pll_enable;
        mov r11, 0xFFFFF79B;             // ALREADY_EN
        cmp rax, r11;
        jne dcw_fail_stage;

        // -- 8. Disable.
        mov rax, 8;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        call dpclk_pll_disable;
        cmp rax, 0;
        jne dcw_fail_stage;

        call dpclk_pll_is_locked;
        cmp rax, 0;
        jne dcw_fail_stage;

        // ALREADY_DIS on second disable.
        call dpclk_pll_disable;
        mov r11, 0xFFFFF79A;
        cmp rax, r11;
        jne dcw_fail_stage;

        // -- 9. Enable HBR3 + TBT_ALT.
        mov rax, 9;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 8100000;
        mov rsi, 1;                      // TBT_ALT
        call dpclk_pll_enable;
        cmp rax, 0;
        jne dcw_fail_stage;

        call dpclk_pll_current_source;
        cmp rax, 1;
        jne dcw_fail_stage;

        call dpclk_pll_disable;
        cmp rax, 0;
        jne dcw_fail_stage;

        // -- 10. BAD_RATE.
        mov rax, 10;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 3240000;
        mov rsi, 0;
        call dpclk_pll_enable;
        mov r11, 0xFFFFF79E;
        cmp rax, r11;
        jne dcw_fail_stage;

        // -- 11. BAD_SOURCE.
        mov rax, 11;
        lea rcx, [rip + _dcw_stage];
        mov [rcx], rax;

        mov rdi, 2700000;
        mov rsi, 5;
        call dpclk_pll_enable;
        mov r11, 0xFFFFF79D;
        cmp rax, r11;
        jne dcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dcw_ok];
        call klog_s1;

        call dpclk_pll_reset;
        xor rax, rax;
        jmp dcw_out;

      dcw_fail_stage:
        lea rax, [rip + _dcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpclk_pll_reset;
        mov rax, 1;

      dcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
