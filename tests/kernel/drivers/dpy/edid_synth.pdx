// tests/kernel/drivers/dpy/edid_synth.pdx — R36.M2-002 (#1240)
//
// Boot witness for the EDID parser scaffold. Asserts header/checksum
// gates, revision refusal, cache population, hash computation, CEA
// and DisplayID extension parsers, and the read seam's
// DEFERRED_HARDWARE outcome.
//
// Fingerprint: DPY EDID OK

module EdidSynth = structure {

  pub let mut _edidw_stage : u64 = 0

  pub let edidw_ok   : [u8; 13] = "DPY EDID OK\n\0"
  pub let edidw_fail : [u8; 15] = "DPY EDID FAIL\n\0"

  // Fixture: a minimal valid EDID base block.
  //
  //   [0..7]     00 FF FF FF FF FF FF 00
  //   [8..9]     0x30 0xAE (manufacturer, arbitrary)
  //   [10..11]   0x34 0x12 (product LE = 0x1234)
  //   [12..15]   0x00 0x00 0x00 0x00 (serial)
  //   [16..17]   0x00 0x00 (week/year)
  //   [18]       1 (major)
  //   [19]       3 (minor)
  //   [20..125]  0x00 * 106
  //   [126]      0x00 (ext_count)
  //   [127]      checksum: -sum([0..126]) & 0xFF
  //
  // For header + rev fields:
  //   sum([0..7])  = 6 * 0xFF = 0x5FA
  //   sum([8..9])  = 0x30 + 0xAE = 0xDE
  //   sum([10..11]) = 0x34 + 0x12 = 0x46
  //   sum([18..19]) = 1 + 3 = 4
  // Everything else zero. sum([0..126]) = 0x5FA + 0xDE + 0x46 + 4 = 0x722.
  //   0x722 mod 256 = 0x22. checksum = 0x100 - 0x22 = 0xDE.

  pub let edidw_fixture : [u8; 128] = [
    0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00,
    0x30, 0xAE, 0x34, 0x12, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x01, 0x03, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xDE
  ]

  // Bad-checksum copy of the above (checksum flipped to 0x00).
  pub let edidw_bad_ck : [u8; 128] = [
    0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00,
    0x30, 0xAE, 0x34, 0x12, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x01, 0x03, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ]

  // Bad-header copy (byte 0 flipped to 0x01).
  pub let edidw_bad_hdr : [u8; 128] = [
    0x01, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00,
    0x30, 0xAE, 0x34, 0x12, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x01, 0x03, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x39
  ]

  // CEA extension fixture: tag 0x02, rev 3, dtd_offset 4, all zero
  // body, checksum computed.
  //   [0]=0x02, [1]=0x03, [2]=0x04, [3]=0x00, rest zero, [127]=checksum
  // sum([0..126]) = 0x02 + 0x03 + 0x04 = 0x09; checksum = 0x100 - 0x09
  //                = 0xF7.
  pub let edidw_cea : [u8; 128] = [
    0x02, 0x03, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xF7
  ]

  // DisplayID fixture: tag 0x70, version 0x12, rest zero, checksum.
  //   sum = 0x70 + 0x12 = 0x82; checksum = 0x100 - 0x82 = 0x7E.
  pub let edidw_did : [u8; 128] = [
    0x70, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7E
  ]

  pub let edid_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M2-002 (#1240): boot witness. Stages: (1) reset. (2) checksum ok on valid fixture. (3) checksum refused on bad. (4) header ok. (5) header refused. (6) parse happy path. (7) manufacturer / product / ext_count cached. (8) parse bad checksum. (9) parse bad header. (10) CEA parse happy. (11) DisplayID parse happy. (12) read seam DEFERRED_HARDWARE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        call edid_reset;

        // -- 2. Checksum ok.
        mov rax, 2;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_fixture];
        call edid_checksum_ok;
        cmp rax, 1;
        jne edidw_fail_stage;

        // -- 3. Checksum refused.
        mov rax, 3;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_bad_ck];
        call edid_checksum_ok;
        cmp rax, 0;
        jne edidw_fail_stage;

        // -- 4. Header ok.
        mov rax, 4;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_fixture];
        call edid_header_ok;
        cmp rax, 1;
        jne edidw_fail_stage;

        // -- 5. Header refused.
        mov rax, 5;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_bad_hdr];
        call edid_header_ok;
        cmp rax, 0;
        jne edidw_fail_stage;

        // -- 6. Parse happy path.
        mov rax, 6;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_fixture];
        call edid_parse_base;
        cmp rax, 0;
        jne edidw_fail_stage;

        // -- 7. Cache populated.
        mov rax, 7;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        call edid_bound;
        cmp rax, 1;
        jne edidw_fail_stage;

        call edid_manufacturer;
        mov r11, 0x30AE;
        cmp rax, r11;
        jne edidw_fail_stage;

        call edid_product;
        mov r11, 0x1234;
        cmp rax, r11;
        jne edidw_fail_stage;

        call edid_ext_count;
        cmp rax, 0;
        jne edidw_fail_stage;

        call edid_hash;
        cmp rax, 0;
        je  edidw_fail_stage;            // non-zero hash

        // -- 8. Parse bad checksum.
        mov rax, 8;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_bad_ck];
        call edid_parse_base;
        mov r11, 0xFFFFF76D;             // BAD_CHECKSUM
        cmp rax, r11;
        jne edidw_fail_stage;

        // -- 9. Parse bad header.
        mov rax, 9;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_bad_hdr];
        call edid_parse_base;
        mov r11, 0xFFFFF76E;             // BAD_HEADER
        cmp rax, r11;
        jne edidw_fail_stage;

        // -- 10. CEA parse happy.
        mov rax, 10;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_cea];
        call edid_parse_cea;
        cmp rax, 0;
        jne edidw_fail_stage;

        // -- 11. DisplayID parse happy.
        mov rax, 11;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rdi, [rip + edidw_did];
        call edid_parse_displayid;
        cmp rax, 0;
        jne edidw_fail_stage;

        // -- 12. Read seam DEFERRED_HARDWARE.
        mov rax, 12;
        lea rcx, [rip + _edidw_stage];
        mov [rcx], rax;

        lea rax, [rip + edidw_fixture];
        mov rdi, 0;                      // port
        mov rsi, 0;                      // block 0
        mov rdx, rax;
        call edid_read_block;
        mov r11, 0xFFFFF767;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne edidw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + edidw_ok];
        call klog_s1;

        call edid_reset;
        xor rax, rax;
        jmp edidw_out;

      edidw_fail_stage:
        lea rax, [rip + _edidw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + edidw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call edid_reset;
        mov rax, 1;

      edidw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
