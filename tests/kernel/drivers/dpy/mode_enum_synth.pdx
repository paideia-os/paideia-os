// tests/kernel/drivers/dpy/mode_enum_synth.pdx — R36.M3-005 (#1248)
//
// Boot witness for mode_enum admission predicate. Asserts pack layout,
// admission of a canonical 1080p60 timing under Iris Xe HBR3-4-lane
// caps, refusal of an 8K120 timing (over-pclk), refusal of a mode with
// pclk over the engine cap (BAD_ENGINE_PCLK), refusal of a mode whose
// lane-bandwidth demand exceeds the link (BAD_LANES), refusal of a
// v=0 mode (BAD_MODE), and per-category counter bumps.
//
// Fingerprint: R36 MODE ENUM OK

module ModeEnumSynth = structure {

  pub let mut _menw_stage : u64 = 0

  pub let menw_ok   : [u8; 17] = "R36 MODE ENUM OK\n\0"
  pub let menw_fail : [u8; 19] = "R36 MODE ENUM FAIL\n\0"

  pub let menw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-005 (#1248): reset mode_enum stats.",
      block: {
        call mode_enum_reset;
        ret
      }
    }

  pub let mode_enum_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M3-005 (#1248): boot witness. Stages: (1) pack layout. (2) 1080p60 admitted under HBR3-4L. (3) 8K120 refused BAD_MODE (pclk exceeds MAX). (4) engine cap of 300000 refuses 1080p60 with BAD_ENGINE_PCLK. (5) 4K60 with 1-lane 1.62 Gbps refused BAD_LANES. (6) v=0 refused BAD_MODE. (7) Per-category counters bumped.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        call menw_scrub;

        // -- 1. Pack layout: 1920 | (1080<<16) | (60<<32).
        mov rdi, 1920;
        mov rsi, 1080;
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  menw_fail_stage;

        // Assert h field.
        mov rax, r15;
        and rax, 0xFFFF;
        cmp rax, 1920;
        jne menw_fail_stage;

        // Assert v field.
        mov rax, r15;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 1080;
        jne menw_fail_stage;

        // Assert refresh field.
        mov rax, r15;
        shr rax, 32;
        and rax, 0xFFFF;
        cmp rax, 60;
        jne menw_fail_stage;

        // Pack refusals.
        mov rdi, 0x10000;                // h > u16
        mov rsi, 1080;
        mov rdx, 60;
        call menum_pack_mode;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne menw_fail_stage;

        // -- 2. 1080p60 under HBR3-4L: admitted.
        mov rax, 2;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        // pclk = 148500 kHz (1080p60), packed = 1920|1080<<16|60<<32,
        // engine_max = 1188000, lane_count = 4, per_lane_rate = 8100000
        mov rdi, 1920;
        mov rsi, 1080;
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;

        mov rdi, 148500;
        mov rsi, r15;
        mov rdx, 1188000;
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_check;
        cmp rax, 0;
        jne menw_fail_stage;

        // -- 3. Over MAX pclk: BAD_MODE.
        mov rax, 3;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        mov rdi, 7680;
        mov rsi, 4320;
        mov rdx, 120;
        call menum_pack_mode;
        mov r15, rax;

        // Something implausibly large: pclk > DPM_MAX (1188000).
        mov rdi, 3560000;
        mov rsi, r15;
        mov rdx, 1188000;
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_check;
        mov r11, 0xFFFFF6FE;             // BAD_MODE
        cmp rax, r11;
        jne menw_fail_stage;

        // -- 4. Engine cap 300000 refuses 1080p60.
        mov rax, 4;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        mov rdi, 1920;
        mov rsi, 1080;
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;

        mov rdi, 148500;
        mov rsi, r15;
        mov rdx, 100000;                 // small engine cap
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_check;
        mov r11, 0xFFFFF6FD;             // BAD_ENGINE_PCLK
        cmp rax, r11;
        jne menw_fail_stage;

        // -- 5. 4K60 refused on 1-lane 1.62 Gbps (bandwidth).
        mov rax, 5;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        mov rdi, 3840;
        mov rsi, 2160;
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;

        mov rdi, 594000;                 // 4K60 pclk
        mov rsi, r15;
        mov rdx, 1188000;
        mov rcx, 1;                      // 1 lane
        mov r8, 1620000;                 // RBR
        call menum_admit_check;
        mov r11, 0xFFFFF6FC;             // BAD_LANES
        cmp rax, r11;
        jne menw_fail_stage;

        // -- 6. v = 0 refused.
        mov rax, 6;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        mov rdi, 1920;
        mov rsi, 0;                      // v = 0
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;

        mov rdi, 148500;
        mov rsi, r15;
        mov rdx, 1188000;
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_check;
        mov r11, 0xFFFFF6FE;             // BAD_MODE
        cmp rax, r11;
        jne menw_fail_stage;

        // -- 7. Per-category counters via menum_admit_one.
        mov rax, 7;
        lea rcx, [rip + _menw_stage];
        mov [rcx], rax;

        call menw_scrub;

        // One admission.
        mov rdi, 1920;
        mov rsi, 1080;
        mov rdx, 60;
        call menum_pack_mode;
        mov r15, rax;

        mov rdi, 148500;
        mov rsi, r15;
        mov rdx, 1188000;
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_one;
        cmp rax, 0;
        jne menw_fail_stage;

        mov rdi, 0;                      // MENUM_ST_ADMITTED
        call menum_stat;
        cmp rax, 1;
        jne menw_fail_stage;

        // One BAD_ENG.
        mov rdi, 148500;
        mov rsi, r15;
        mov rdx, 100000;
        mov rcx, 4;
        mov r8, 8100000;
        call menum_admit_one;
        mov r11, 0xFFFFF6FD;
        cmp rax, r11;
        jne menw_fail_stage;

        mov rdi, 3;                      // MENUM_ST_BAD_ENG
        call menum_stat;
        cmp rax, 1;
        jne menw_fail_stage;

        mov rdi, 1;                      // MENUM_ST_REJECTED
        call menum_stat;
        cmp rax, 1;
        jne menw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + menw_ok];
        call klog_s1;

        call menw_scrub;
        xor rax, rax;
        jmp menw_out;

      menw_fail_stage:
        lea rax, [rip + _menw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + menw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call menw_scrub;
        mov rax, 1;

      menw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
