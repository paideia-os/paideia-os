// tests/kernel/drivers/dpy/timeline_synth.pdx -- G1.M1-003 (#1429) +
// G1.M1-004 (#1430)
//
// Boot witness for the vblank -> timeline signal path AND the
// wait primitive. Mints a synth row directly through dpt_tail_
// alloc, drives dpy_timeline_vblank_signal, and asserts the row
// value advances. Also asserts dpy_timeline_reached wraparound
// discipline (G1.M3-003 #1439).
//
// Fingerprint: G1 DPY TIMELINE OK

module DpyTimelineSynth = structure {

  pub let mut _tlw_stage : u64 = 0

  pub let tlw_ok   : [u8; 20] = "G1 DPY TIMELINE OK\n\0"
  pub let tlw_fail : [u8; 22] = "G1 DPY TIMELINE FAIL\n\0"

  pub let dpy_timeline_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M1-003 (#1429) + G1.M1-004 (#1430) + G1.M3-003 (#1439): boot witness. Stages: (1) reset. (2) find_row for missing pair returns ROW_NONE. (3) Seed a row for (engine=1, output=1). (4) vblank_signal advances value to 1. (5) Second signal advances to 2. (6) NO_ROW for unmapped pair. (7) wait_le with timeout=0 exits immediately since value already reached. (8) Wraparound reached: (0, u64_max) reads as reached (near-wrap). (9) Non-wrap reached: (100, 200) NOT reached. (10) Non-wrap reached: (200, 100) IS reached.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;

        // 2. find_row(1, 1) with empty table -> ROW_NONE.
        mov rax, 2;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call dpy_timeline_find_row;
        mov r10, 0xFF;
        cmp rax, r10;
        jne tlw_fail_stage;

        // 3. Seed a row via dpt_tail_alloc: hdr=0, key=0x1111,
        //    body1=pack(engine=1, output=1), initial=0.
        mov rax, 3;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call dpt_body1_pack;
        mov rdi, 0;
        mov rsi, 0x1111;
        mov rdx, rax;
        xor rcx, rcx;
        call dpt_tail_alloc;
        cmp rax, 0;
        jne tlw_fail_stage;

        // 4. vblank_signal(1, 1) advances value to 1.
        mov rax, 4;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call dpy_timeline_vblank_signal;
        cmp rax, 0;
        jne tlw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 1;
        jne tlw_fail_stage;

        // 5. Second signal advances to 2.
        mov rax, 5;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call dpy_timeline_vblank_signal;
        cmp rax, 0;
        jne tlw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 2;
        jne tlw_fail_stage;

        // 6. vblank_signal on unmapped pair -> NO_ROW.
        mov rax, 6;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 7;
        mov rsi, 7;
        call dpy_timeline_vblank_signal;
        mov r10, 0xFFFFF68F;             // DPY_TL_NO_ROW
        cmp rax, r10;
        jne tlw_fail_stage;

        // 7. wait_le(row=0, want=2, timeout=0) exits immediately
        //    since value already reached (returns hpet_now_ns).
        //    We cannot compare the timestamp exactly; assert non-
        //    error return (result != any DPY_TL_* error band).
        mov rax, 7;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 2;
        mov rdx, 0;
        call dpy_timeline_wait_le;
        // Reject the three error codes we could see.
        mov r10, 0xFFFFF68E;
        cmp rax, r10;
        je  tlw_fail_stage;
        mov r10, 0xFFFFF68D;
        cmp rax, r10;
        je  tlw_fail_stage;
        mov r10, 0xFFFFF68C;
        cmp rax, r10;
        je  tlw_fail_stage;

        // 8. Wraparound reached: (0, u64_max) reads as reached.
        //    (current - want) = (0 - u64_max) = 1 (signed positive).
        mov rax, 8;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0xFFFFFFFFFFFFFFFF;
        call dpy_timeline_reached;
        cmp rax, 1;
        jne tlw_fail_stage;

        // 9. Non-wrap: (100, 200) NOT reached.
        mov rax, 9;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 200;
        call dpy_timeline_reached;
        cmp rax, 0;
        jne tlw_fail_stage;

        // 10. Non-wrap: (200, 100) IS reached.
        mov rax, 10;
        lea rcx, [rip + _tlw_stage];
        mov [rcx], rax;
        mov rdi, 200;
        mov rsi, 100;
        call dpy_timeline_reached;
        cmp rax, 1;
        jne tlw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tlw_ok];
        call klog_s1;

        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        xor rax, rax;
        jmp tlw_out;

      tlw_fail_stage:
        lea rax, [rip + _tlw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tlw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        mov rax, 1;

      tlw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
