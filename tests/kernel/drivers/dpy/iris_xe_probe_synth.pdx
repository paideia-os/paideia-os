// tests/kernel/drivers/dpy/iris_xe_probe_synth.pdx — R36.M1-001 (#1235)
//
// Boot witness for the Iris Xe display probe scaffold. Asserts
// class-pair discrimination, vendor filter, device-family filter,
// BAR alignment, chip caps decode, and end-to-end recognise
// round-trip.
//
// Fingerprint: R36 IRIS XE PROBE OK

module IrisXeProbeSynth = structure {

  pub let mut _ixpw_stage : u64 = 0

  pub let ixpw_ok   : [u8; 21] = "R36 IRIS XE PROBE OK\n\0"
  pub let ixpw_fail : [u8; 23] = "R36 IRIS XE PROBE FAIL\n\0"

  pub let iris_xe_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M1-001 (#1235): boot witness. Stages: (1) reset. (2) class pair valid + invalid. (3) vendor valid + invalid. (4) family Xe1/Xe2/Xe3 + unknown. (5) alignment. (6) caps decode gmbus + ddi. (7) BAR2 length gate. (8) happy path recognise. (9) BAD_CLASS. (10) BAD_FAMILY. (11) MISALIGNED. (12) NO_GMBUS.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        call ixp_probe_reset;

        // -- 2. Class pair.
        mov rax, 2;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;
        call ixp_class_valid;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x0301;
        call ixp_class_valid;
        cmp rax, 0;
        jne ixpw_fail_stage;

        // -- 3. Vendor.
        mov rax, 3;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x8086;
        call ixp_vendor_valid;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x1002;                 // AMD
        call ixp_vendor_valid;
        cmp rax, 0;
        jne ixpw_fail_stage;

        // -- 4. Family.
        mov rax, 4;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x9A78;                 // Xe1
        call ixp_family_valid;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x4680;                 // Xe2
        call ixp_family_valid;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x7D45;                 // Xe3
        call ixp_family_valid;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x1234;                 // unknown
        call ixp_family_valid;
        cmp rax, 0;
        jne ixpw_fail_stage;

        // -- 5. Alignment.
        mov rax, 5;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0xF0000000;             // 16 MB aligned
        call ixp_bar0_aligned;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0xF0800000;             // 8 MB aligned but not 16
        call ixp_bar0_aligned;
        cmp rax, 0;
        jne ixpw_fail_stage;

        // -- 6. caps decode.
        mov rax, 6;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0034;                 // gmbus=4, ddi=3
        call ixp_decode_gmbus;
        cmp rax, 4;
        jne ixpw_fail_stage;

        mov rdi, 0x0034;
        call ixp_decode_ddi;
        cmp rax, 3;
        jne ixpw_fail_stage;

        // -- 7. BAR2 length gate.
        mov rax, 7;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x800000;               // 8 MB
        call ixp_bar2_len_ok;
        cmp rax, 1;
        jne ixpw_fail_stage;

        mov rdi, 0x100000;               // 1 MB
        call ixp_bar2_len_ok;
        cmp rax, 0;
        jne ixpw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;                 // class pair
        mov rsi, 0x8086;                 // vendor
        mov rdx, 0x9A78;                 // Xe1 device id
        mov rcx, 0xF0000000;             // bar0_base (16 MB aligned)
        mov r8, 0x1000000;               // bar0_len = 16 MB
        mov r9, 0x0034;                  // caps: gmbus=4, ddi=3
        call ixp_probe_recognise;
        cmp rax, 0x0304;                 // gmbus=4 | (ddi=3 << 8)
        jne ixpw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call ixp_probe_stat;
        cmp rax, 1;
        jne ixpw_fail_stage;

        // -- 9. BAD_CLASS.
        mov rax, 9;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0301;
        mov rsi, 0x8086;
        mov rdx, 0x9A78;
        mov rcx, 0xF0000000;
        mov r8, 0x1000000;
        mov r9, 0x0034;
        call ixp_probe_recognise;
        mov r11, 0xFFFFF7BE;
        cmp rax, r11;
        jne ixpw_fail_stage;

        // -- 10. BAD_FAMILY.
        mov rax, 10;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;
        mov rsi, 0x8086;
        mov rdx, 0x1234;
        mov rcx, 0xF0000000;
        mov r8, 0x1000000;
        mov r9, 0x0034;
        call ixp_probe_recognise;
        mov r11, 0xFFFFF7BC;
        cmp rax, r11;
        jne ixpw_fail_stage;

        // -- 11. MISALIGNED.
        mov rax, 11;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;
        mov rsi, 0x8086;
        mov rdx, 0x9A78;
        mov rcx, 0xF0800000;             // 8 MB aligned, not 16
        mov r8, 0x1000000;
        mov r9, 0x0034;
        call ixp_probe_recognise;
        mov r11, 0xFFFFF7B9;
        cmp rax, r11;
        jne ixpw_fail_stage;

        // -- 12. NO_GMBUS.
        mov rax, 12;
        lea rcx, [rip + _ixpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;
        mov rsi, 0x8086;
        mov rdx, 0x9A78;
        mov rcx, 0xF0000000;
        mov r8, 0x1000000;
        mov r9, 0x0030;                  // gmbus=0, ddi=3
        call ixp_probe_recognise;
        mov r11, 0xFFFFF7B7;
        cmp rax, r11;
        jne ixpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ixpw_ok];
        call klog_s1;

        call ixp_probe_reset;
        xor rax, rax;
        jmp ixpw_out;

      ixpw_fail_stage:
        lea rax, [rip + _ixpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ixpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ixp_probe_reset;
        mov rax, 1;

      ixpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
