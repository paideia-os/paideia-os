// tests/kernel/drivers/dpy/plane_primary_synth.pdx — R36.M4-002 (#1250)
//
// Boot witness for plane_primary. Asserts validators, per-role gate
// refusals (WRONG_TYPE, BAD_ZORDER, BAD_FORMAT, BAD_STRIDE, BAD_TILE),
// happy-path bind honesty pin (DEFERRED_HARDWARE), and record fields.
//
// Fingerprint: R36 PLANE PRIMARY OK
//
// Cap slots 80..95.

module PlanePrimarySynth = structure {

  pub let mut _plpriw_stage : u64 = 0

  pub let plpriw_ok   : [u8; 22] = "R36 PLANE PRIMARY OK\n\0"
  pub let plpriw_fail : [u8; 24] = "R36 PLANE PRIMARY FAIL\n\0"

  pub let plpriw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-002 (#1250): clear cap_table slots 80..95.",
      block: {
        push rbx;
        mov rbx, 80;
      plpriwc_loop:
        cmp rbx, 96;
        jae plpriwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp plpriwc_loop;
      plpriwc_done:
        pop rbx;
        ret
      }
    }

  pub let plpriw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): reset plane_primary state + DISPLAY_PLANE row table.",
      block: {
        call plane_primary_reset;
        call display_plane_table_reset;
        ret
      }
    }

  pub let plpriw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-002 (#1250): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // Mint one KIND_DISPLAY_PLANE at slot. packed_class = mtype | z<<8 |
  // fmt<<16. Five args (paideia-as SysV cap = 6, and mint_inner already
  // takes six, so a 7-arg helper is not expressible; the pack keeps the
  // caller signature under the ceiling).
  pub let plpriw_mint_plane : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (plane_key: u64) (packed_class: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-002 (#1250): helper — mint KIND_DISPLAY_PLANE via display_plane_cap_mint_inner. Parent memory is slot 81. packed_class layout: mtype[7:0] | zorder[15:8] | format[31:16]. Five args to stay under paideia-as's SysV register-pass ceiling of six (the mint_inner it wraps already uses six).",
      block: {
        push rbx;
        push r12;
        push r13;
        // rdi=slot, rsi=plane_key, rdx=packed_class, rcx=w, r8=h
        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // plane_key
        mov r13, rdx;                    // packed_class

        // Compose packed_all: mtype | z<<8 | fmt<<16 | w<<32 | h<<48.
        // packed_class already has mtype|z<<8|fmt<<16 in low 32 bits.
        mov rax, r8;                     // h
        shl rax, 48;
        mov r10, rcx;                    // w
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, r13;                    // packed_class low 32
        and r10, 0xFFFFFFFF;
        or  rax, r10;

        mov rdi, rbx;
        mov rsi, 81;
        mov rdx, 0x419;
        mov rcx, r12;
        mov r8, 81;
        mov r9, rax;
        call display_plane_cap_mint_inner;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let plane_primary_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M4-002 (#1250): boot witness. Stages: (1) validators. (2) WRONG_TYPE (overlay row). (3) BAD_ZORDER (z=1). (4) BAD_FORMAT (NV12). (5) BAD_STRIDE (100). (6) BAD_TILE (5). (7) Happy path -> DEFERRED_HARDWARE + record.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        call plpriw_clear;
        call plpriw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call plpri_pipe_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 4;
        call plpri_pipe_valid;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_zorder_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 1;
        call plpri_zorder_valid;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_format_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 3;
        call plpri_format_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 1;                      // NV12: rejected by primary
        call plpri_format_valid;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 128;
        call plpri_stride_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 100;
        call plpri_stride_valid;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_tile_valid;
        cmp rax, 1;
        jne plpriw_fail_stage;
        mov rdi, 3;
        call plpri_tile_valid;
        cmp rax, 0;
        jne plpriw_fail_stage;

        // Parent memory at 81.
        mov rdi, 81;
        mov rsi, 0x200;
        mov rdx, 0xC10F0001;
        call plpriw_memory;

        // -- 2. WRONG_TYPE: mint an OVERLAY plane, then try to bind as primary.
        mov rax, 2;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        // Overlay at slot 82: type=1, z=1, fmt=1 (NV12), w=1920, h=1080.
        // packed_class = 1 | 1<<8 | 1<<16 = 0x10101
        mov rdi, 82;
        mov rsi, 0xBEEE0001;
        mov rdx, 0x10101;
        mov rcx, 1920;
        mov r8, 1080;
        call plpriw_mint_plane;
        cmp rax, 0;
        jne plpriw_fail_stage;

        // Bind pipe 0 to overlay slot -> WRONG_TYPE.
        mov rdi, 0;
        mov rsi, 82;
        mov rdx, 7680;
        mov rcx, 0;
        call plane_primary_bind;
        mov r11, 0xFFFFF6DD;
        cmp rax, r11;
        jne plpriw_fail_stage;

        // -- 3. BAD_ZORDER: mint a primary with z=1 -> refused by the KIND
        // check? No -- the kind allows z<=255. But primary bind rejects
        // z != 0.
        mov rax, 3;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        // Primary at slot 83: type=0, z=1, fmt=0, w=1920, h=1080.
        // packed_class = 0 | 1<<8 | 0<<16 = 0x100
        mov rdi, 83;
        mov rsi, 0xBEEE0002;
        mov rdx, 0x100;
        mov rcx, 1920;
        mov r8, 1080;
        call plpriw_mint_plane;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        mov rsi, 83;
        mov rdx, 7680;
        mov rcx, 0;
        call plane_primary_bind;
        mov r11, 0xFFFFF6DC;
        cmp rax, r11;
        jne plpriw_fail_stage;

        // -- 4. BAD_FORMAT: mint primary with NV12 -> kind admits, driver refuses.
        mov rax, 4;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        // Primary at slot 84: type=0, z=0, fmt=1 (NV12), w=1920, h=1080.
        // packed_class = 0 | 0<<8 | 1<<16 = 0x10000
        mov rdi, 84;
        mov rsi, 0xBEEE0003;
        mov rdx, 0x10000;
        mov rcx, 1920;
        mov r8, 1080;
        call plpriw_mint_plane;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        mov rsi, 84;
        mov rdx, 7680;
        mov rcx, 0;
        call plane_primary_bind;
        mov r11, 0xFFFFF6DB;
        cmp rax, r11;
        jne plpriw_fail_stage;

        // -- 5. BAD_STRIDE.
        mov rax, 5;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        // Primary at slot 85: valid row.  packed_class = 0 (type=0/z=0/fmt=0).
        mov rdi, 85;
        mov rsi, 0xBEEE0004;
        mov rdx, 0;
        mov rcx, 1920;
        mov r8, 1080;
        call plpriw_mint_plane;
        cmp rax, 0;
        jne plpriw_fail_stage;

        mov rdi, 0;
        mov rsi, 85;
        mov rdx, 100;                    // bad stride (unaligned, too small)
        mov rcx, 0;
        call plane_primary_bind;
        mov r11, 0xFFFFF6DA;
        cmp rax, r11;
        jne plpriw_fail_stage;

        // -- 6. BAD_TILE.
        mov rax, 6;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 85;
        mov rdx, 7680;
        mov rcx, 5;                      // bad tile
        call plane_primary_bind;
        mov r11, 0xFFFFF6D9;
        cmp rax, r11;
        jne plpriw_fail_stage;

        // -- 7. Happy path -> DEFERRED_HARDWARE + record.
        mov rax, 7;
        lea rcx, [rip + _plpriw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 85;                    // valid primary row
        mov rdx, 7680;                   // valid stride
        mov rcx, 1;                      // X_TILED
        call plane_primary_bind;
        mov r11, 0xFFFFF6D7;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne plpriw_fail_stage;

        // Record checks.
        mov rdi, 0;
        call plpri_bound;
        cmp rax, 1;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_memory_of;
        cmp rax, 81;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_stride_of;
        cmp rax, 7680;
        jne plpriw_fail_stage;

        mov rdi, 0;
        call plpri_tile_of;
        cmp rax, 1;
        jne plpriw_fail_stage;

        // Honesty pin: arbitrated == 0.
        call plpri_arbitrated;
        cmp rax, 0;
        jne plpriw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plpriw_ok];
        call klog_s1;

        call plpriw_scrub;
        call plpriw_clear;
        xor rax, rax;
        jmp plpriw_out;

      plpriw_fail_stage:
        lea rax, [rip + _plpriw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + plpriw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call plpriw_scrub;
        call plpriw_clear;
        mov rax, 1;

      plpriw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
