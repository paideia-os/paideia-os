// tests/kernel/drivers/dpy/hpd_isr_synth.pdx — R36.M2-005 (#1243)
//
// Boot witness for the HPD ISR scaffold. Asserts bind arity + REBIND
// refusal, unbound refusal, DDI-range refusal, debounce coalescing,
// and read seam DEFERRED_HARDWARE.
//
// Fingerprint: DPY HPD OK

module HpdIsrSynth = structure {

  pub let mut _hpdw_stage : u64 = 0

  pub let hpdw_ok   : [u8; 12] = "DPY HPD OK\n\0"
  pub let hpdw_fail : [u8; 14] = "DPY HPD FAIL\n\0"

  pub let hpd_isr_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R36.M2-005 (#1243): boot witness. Stages: (1) reset. (2) DDI validator. (3) NOT_BOUND refused. (4) Bind happy. (5) REBIND refused. (6) BAD_DDI refused. (7) Assert happy. (8) Debounce coalesces. (9) Post-debounce assert OK. (10) Read seam DEFERRED_HARDWARE. (11) Arbitrated pin at 0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        call hpd_reset;

        // -- 2. DDI validator.
        mov rax, 2;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        call hpd_ddi_valid;
        cmp rax, 1;
        jne hpdw_fail_stage;
        mov rdi, 8;
        call hpd_ddi_valid;
        cmp rax, 0;
        jne hpdw_fail_stage;

        // -- 3. NOT_BOUND refused.
        mov rax, 3;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1000;
        call hpd_isr_assert;
        mov r11, 0xFFFFF74D;             // NOT_BOUND
        cmp rax, r11;
        jne hpdw_fail_stage;

        // -- 4. Bind happy.
        mov rax, 4;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        call hpd_isr_bind;
        cmp rax, 0;
        jne hpdw_fail_stage;

        call hpd_isr_bound;
        cmp rax, 1;
        jne hpdw_fail_stage;

        // -- 5. REBIND refused.
        mov rax, 5;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        call hpd_isr_bind;
        mov r11, 0xFFFFF74C;             // REBIND
        cmp rax, r11;
        jne hpdw_fail_stage;

        // -- 6. BAD_DDI refused.
        mov rax, 6;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 8;
        mov rsi, 1000;
        call hpd_isr_assert;
        mov r11, 0xFFFFF74E;             // BAD_DDI
        cmp rax, r11;
        jne hpdw_fail_stage;

        // -- 7. Assert happy path (first time — no debounce entry).
        mov rax, 7;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1000;
        call hpd_isr_assert;
        cmp rax, 0;
        jne hpdw_fail_stage;

        // -- 8. Debounce coalesces (now_ticks within 100 of previous).
        mov rax, 8;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1050;                   // delta = 50 < 100
        call hpd_isr_assert;
        mov r11, 0xFFFFF74B;             // DEBOUNCED
        cmp rax, r11;
        jne hpdw_fail_stage;

        // -- 9. Post-debounce assert OK.
        mov rax, 9;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1200;                   // delta = 200 > 100
        call hpd_isr_assert;
        cmp rax, 0;
        jne hpdw_fail_stage;

        // -- 10. Read seam DEFERRED_HARDWARE.
        mov rax, 10;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call hpd_read_status;
        mov r11, 0xFFFFF74A;
        cmp rax, r11;
        jne hpdw_fail_stage;

        mov rdi, 8;
        call hpd_read_status;
        mov r11, 0xFFFFF74E;             // BAD_DDI
        cmp rax, r11;
        jne hpdw_fail_stage;

        // -- 11. Arbitrated pin.
        mov rax, 11;
        lea rcx, [rip + _hpdw_stage];
        mov [rcx], rax;

        call hpd_arbitrated;
        cmp rax, 0;
        jne hpdw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hpdw_ok];
        call klog_s1;

        call hpd_reset;
        xor rax, rax;
        jmp hpdw_out;

      hpdw_fail_stage:
        lea rax, [rip + _hpdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hpdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hpd_reset;
        mov rax, 1;

      hpdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
