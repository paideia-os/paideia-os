// tests/kernel/drivers/elaborator/mmio_effect_with_cap.pdx — R29-M2-002 (#1024)
//
// Positive companion to `mmio_effect_without_cap.pdx`. Same driver
// shape but declares `@{paideia.mmio}` correctly. Elaboration must
// succeed (exit 0, no C1301 in stderr).
//
// tools/verify-elaborator-negatives.sh asserts that this fixture
// elaborates clean — the goal being to prove the coupling check
// discriminates precisely: rejects the misdeclaring shape (the
// sibling file) while accepting the matched-cap shape here. Together
// the two files pin down the semantics of the `paideia-as#1307`
// coupling walker so a regression that either (a) started silently
// accepting the negative or (b) started spuriously rejecting the
// positive would trip the pre-push matrix.
//
// See the sibling file for the full R29 rationale + fingerprint
// dictionary.

module MmioEffectWithCap = structure {
  effect Mmio {
    op mmio_read : (u32) -> u64
  }

  // driver_ok: matched — !{Mmio} paired with @{paideia.mmio}.
  let driver_ok : (u32) -> u64 !{Mmio} @{paideia.mmio} =
    fn (addr : u32) -> perform Mmio::mmio_read(addr)
}
