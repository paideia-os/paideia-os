// tests/kernel/drivers/backlight_dpaux_synth.pdx — R31.M5-004 (#1109)
//
// Boot witness for the DPAUX backlight driver SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the bind flag transition, the arbitration pin, the refusal
// discipline (BAD_LEVEL, NOT_BOUND) and the DEFERRED_HARDWARE outcome
// on a bound driver. It ALSO asserts that BACKLIGHT_DPAUX_FALLBACK_ACPI
// is a distinct code (mnemonically, by comparing it against the other
// sentinels for inequality). IT ASSERTS NOTHING ABOUT A REAL AUX
// TRANSACTION, because none runs in this tree -- backlight_dpaux.pdx §4
// documents the gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R31 DPAUX BACKLIGHT OK

module BacklightDpauxSynth = structure {

  pub let mut _bldpx_w_stage : u64 = 0

  pub let bldpx_w_ok   : [u8; 19] = "DPAUX BACKLIGHT OK\0"
  pub let bldpx_w_fail : [u8; 21] = "DPAUX BACKLIGHT FAIL\0"

  pub let backlight_dpaux_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R31.M5-004 (#1109): boot witness for the DPAUX backlight scaffold. Stages: (S1) bound() returns 0 before bind; arbitrated() pinned at 0 (the honesty function per backlight_dpaux.pdx §4). (S2) write(60) before bind -> NOT_BOUND. (S3) bind() -> OK; bound()=1; arbitrated() still 0. (S4) write(60) after bind -> DEFERRED_HARDWARE (§3 of the driver). (S5) write(0x10000) -> BAD_LEVEL (refused, not clamped). (S6) writes() counter moved. Five-push prologue. Labels prefixed bldpx_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- bound() = 0, arbitrated() = 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        call backlight_dpaux_bound;
        cmp rax, 0;
        jne bldpx_w_fail_stage;

        call backlight_dpaux_arbitrated;
        cmp rax, 0;
        jne bldpx_w_fail_stage;

        // ================================================================
        // S2 -- write before bind -> NOT_BOUND.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        mov rdi, 60;
        call backlight_dpaux_write;
        mov r11, 0xFFFFFEAF;             // BACKLIGHT_DPAUX_NOT_BOUND
        cmp rax, r11;
        jne bldpx_w_fail_stage;

        // ================================================================
        // S3 -- bind, bound()=1, arbitrated() still 0.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        call backlight_dpaux_bind;
        cmp rax, 0;
        jne bldpx_w_fail_stage;

        call backlight_dpaux_bound;
        cmp rax, 1;
        jne bldpx_w_fail_stage;

        call backlight_dpaux_arbitrated;
        cmp rax, 0;
        jne bldpx_w_fail_stage;

        // ================================================================
        // S4 -- write after bind -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        call backlight_dpaux_writes;
        mov rbx, rax;

        mov rdi, 60;
        call backlight_dpaux_write;
        mov r11, 0xFFFFFEAC;             // BACKLIGHT_DPAUX_DEFERRED_HARDWARE
        cmp rax, r11;
        jne bldpx_w_fail_stage;

        // ================================================================
        // S5 -- write(0x10000) -> BAD_LEVEL.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        mov rdi, 0x10000;
        call backlight_dpaux_write;
        mov r11, 0xFFFFFEAE;
        cmp rax, r11;
        jne bldpx_w_fail_stage;

        // Boundary: level=0xFFFF admitted (deferred).
        mov rdi, 0xFFFF;
        call backlight_dpaux_write;
        mov r11, 0xFFFFFEAC;
        cmp rax, r11;
        jne bldpx_w_fail_stage;

        // ================================================================
        // S6 -- writes() moved.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _bldpx_w_stage];
        mov [rcx], rax;

        call backlight_dpaux_writes;
        sub rax, rbx;
        cmp rax, 2;
        jne bldpx_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bldpx_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp bldpx_w_out;

      bldpx_w_fail_stage:
        lea rax, [rip + _bldpx_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bldpx_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      bldpx_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
