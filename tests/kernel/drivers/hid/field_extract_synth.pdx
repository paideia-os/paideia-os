// tests/kernel/drivers/hid/field_extract_synth.pdx — R32.M2-004 (#1123)
//
// Boot witness for the HID FIELD EXTRACTOR (field_extract.pdx).
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It builds a synthetic input-report buffer sized like the canonical
// boot-mouse report emitted by the parser fixture (4 bytes: byte 0 = 3
// button bits + 5 constant bits, bytes 1..2 = signed X/Y deltas at 8
// bits each, byte 3 = unused padding used for the array-mode fixture),
// then exercises the three extraction modes:
//
//   BIT MODE   -- 1-bit, 3-bit and 5-bit widths at various bit offsets;
//                 refusal of width 0, width 33 and out-of-range offset.
//   SIGNED     -- 8-bit signed X/Y deltas; positive (+64), negative
//                 (-64, 0xC0), full-negative (-128, 0x80), full-positive
//                 (+127, 0x7F); 16-bit signed value spanning bytes 1..2.
//   ARRAY      -- byte-indexed read; refusal past end of report.
//
// The honesty pin is asserted 0. IT ASSERTS NOTHING ABOUT A LIVE
// ROUTING DECISION, because no consumer exists yet.
//
//   R32 HID FIELD OK
//
// PLACEMENT AFTER hid_collection_walker_witness IS DELIBERATE. The
// extractor is the READ-SIDE consumer of the parsed schema's report_size
// / report_count values, though it does not consult the schema at its
// own arity (§0 of field_extract.pdx). Reading "R32 HID FIELD OK"
// immediately after "R32 HID COLLECTION OK" is how an operator sees
// that both halves of the schema-to-value pipeline reported at the same
// boot -- the WALK half (M2-003: iterate the schema) and the DECODE
// half (M2-004: turn its geometry into u64 values).

module FieldExtractSynth = structure {

  pub let mut _hid_fe_w_stage : u64 = 0

  pub let hid_fe_w_ok   : [u8; 17] = "R32 HID FIELD OK\0"
  pub let hid_fe_w_fail : [u8; 19] = "R32 HID FIELD FAIL\0"

  // ---------------------------------------------------------------------------
  // Synthetic report buffer -- 4 bytes.
  //
  //   Byte 0: 0b110_00101 = 0xC5
  //     bits 0..0 = 1 (button 1 pressed)
  //     bits 1..1 = 0 (button 2 released)
  //     bits 2..2 = 1 (button 3 pressed)
  //     bits 3..7 = 0b11000 (5-bit constant field; equals 24)
  //   Byte 1: 0x40 = +64 (signed X delta)
  //   Byte 2: 0xC0 = -64 (signed Y delta, two's complement)
  //   Byte 3: 0x2A = 42 (array-mode fixture; usage byte)
  // ---------------------------------------------------------------------------

  pub let _hid_fe_w_report : [u8; 4] = [
    0xC5u8, 0x40u8, 0xC0u8, 0x2Au8
  ]

  // Second fixture -- 4-byte buffer whose byte 1 = 0x80 (-128), byte 2
  // = 0x7F (+127). Exercises the two sign-extension extremes without
  // disturbing the primary report.
  pub let _hid_fe_w_report2 : [u8; 4] = [
    0x00u8, 0x80u8, 0x7Fu8, 0x00u8
  ]

  // Third fixture -- 4-byte buffer for the 16-bit signed span test.
  // Bytes 1..2 = 0xFF, 0xFF = signed 16-bit -1 (0xFFFF sign-extended).
  pub let _hid_fe_w_report3 : [u8; 4] = [
    0x00u8, 0xFFu8, 0xFFu8, 0x00u8
  ]

  pub let hid_field_extract_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M2-004 (#1123): boot witness for the HID field extractor. Stages: (S1) consumed() == 0 (honesty). (S2..S4) BIT mode -- extract_bits(ptr, 4, 0, 1) == 1, extract_bits(ptr, 4, 2, 1) == 1, extract_bits(ptr, 4, 3, 5) == 0b11000 = 24. (S5) BIT refusal -- width 0 -> BAD_WIDTH. (S6) width 33 -> BAD_WIDTH. (S7) out-of-range -- bit_offset 32 + width 1 > 32 -> BAD_RANGE. (S8..S11) SIGNED mode -- signed(ptr, 4, 8, 8) == +64 (0x40); signed(ptr, 4, 16, 8) sign-extends 0xC0 to 0xFFFFFFFFFFFFFFC0 (-64); signed(ptr2, 4, 8, 8) sign-extends 0x80 to 0xFFFFFFFFFFFFFF80 (-128); signed(ptr2, 4, 16, 8) == 0x7F (+127). (S12) SIGNED 16-bit -- signed(ptr3, 4, 8, 16) sign-extends 0xFFFF to 0xFFFFFFFFFFFFFFFF (-1). (S13) SIGNED refusal -- BAD_WIDTH propagates. (S14..S15) ARRAY mode -- extract_array(ptr, 4, 3, 0) == 0x2A (42); extract_array(ptr, 4, 3, 1) -> BAD_RANGE (past end). Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed hid_fe_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- honesty pin.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        call hid_field_extract_consumed;
        cmp rax, 0;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S2 -- extract_bits(ptr, 4, 0, 1) == 1 (button 1).
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 0;
        mov rcx, 1;
        call hid_field_extract_bits;
        cmp rax, 1;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S3 -- extract_bits(ptr, 4, 2, 1) == 1 (button 3).
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 2;
        mov rcx, 1;
        call hid_field_extract_bits;
        cmp rax, 1;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S4 -- extract_bits(ptr, 4, 3, 5) == 0b11000 = 24 (constant).
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 3;
        mov rcx, 5;
        call hid_field_extract_bits;
        cmp rax, 24;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S5 -- extract_bits(ptr, 4, 0, 0) -> BAD_WIDTH (0xFFFFFC21).
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 0;
        mov rcx, 0;
        call hid_field_extract_bits;
        mov r11, 0xFFFFFC21;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S6 -- extract_bits(ptr, 4, 0, 33) -> BAD_WIDTH.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 0;
        mov rcx, 33;
        call hid_field_extract_bits;
        mov r11, 0xFFFFFC21;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S7 -- extract_bits(ptr, 4, 32, 1) -> BAD_RANGE (0xFFFFFC20).
        //       report_len=4 -> 32 total bits, so bit_offset=32 is at
        //       the boundary and +1 puts us past end.
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 32;
        mov rcx, 1;
        call hid_field_extract_bits;
        mov r11, 0xFFFFFC20;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S8 -- signed(ptr, 4, 8, 8) == 0x40 (+64).
        // ================================================================
        mov rax, 80;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 8;
        mov rcx, 8;
        call hid_field_extract_signed;
        cmp rax, 0x40;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S9 -- signed(ptr, 4, 16, 8) == 0xFFFFFFFFFFFFFFC0 (-64).
        // ================================================================
        mov rax, 90;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 16;
        mov rcx, 8;
        call hid_field_extract_signed;
        mov r11, 0xFFFFFFFFFFFFFFC0;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S10 -- signed(ptr2, 4, 8, 8) == 0xFFFFFFFFFFFFFF80 (-128).
        // ================================================================
        mov rax, 100;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report2];
        mov rsi, 4;
        mov rdx, 8;
        mov rcx, 8;
        call hid_field_extract_signed;
        mov r11, 0xFFFFFFFFFFFFFF80;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S11 -- signed(ptr2, 4, 16, 8) == 0x7F (+127).
        // ================================================================
        mov rax, 110;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report2];
        mov rsi, 4;
        mov rdx, 16;
        mov rcx, 8;
        call hid_field_extract_signed;
        cmp rax, 0x7F;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S12 -- signed(ptr3, 4, 8, 16) == 0xFFFF...FF (-1 as 16-bit).
        // ================================================================
        mov rax, 120;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report3];
        mov rsi, 4;
        mov rdx, 8;
        mov rcx, 16;
        call hid_field_extract_signed;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S13 -- signed refusal -- width 33 -> BAD_WIDTH.
        // ================================================================
        mov rax, 130;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 0;
        mov rcx, 33;
        call hid_field_extract_signed;
        mov r11, 0xFFFFFC21;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S14 -- array(ptr, 4, 3, 0) == 0x2A (42).
        // ================================================================
        mov rax, 140;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 3;
        mov rcx, 0;
        call hid_field_extract_array;
        cmp rax, 0x2A;
        jne hid_fe_w_fail_stage;

        // ================================================================
        // S15 -- array(ptr, 4, 3, 1) -> BAD_RANGE (past end).
        // ================================================================
        mov rax, 150;
        lea rcx, [rip + _hid_fe_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_fe_w_report];
        mov rsi, 4;
        mov rdx, 3;
        mov rcx, 1;
        call hid_field_extract_array;
        mov r11, 0xFFFFFC20;
        cmp rax, r11;
        jne hid_fe_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_fe_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hid_fe_w_out;

      hid_fe_w_fail_stage:
        lea rax, [rip + _hid_fe_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_fe_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hid_fe_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
