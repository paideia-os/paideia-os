// tests/kernel/drivers/hid/report_io_synth.pdx — R32.M2-005 (#1124)
//
// Boot witness for the HID GET_REPORT + SET_REPORT ROUND-TRIP
// (report_io.pdx).
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the honesty pins (arbitrated = 0 for both seams), the
// happy-path DEFERRED_HARDWARE propagation from both nested transport
// calls, the deferred-count monotonic bump, and the module's own
// refusal gates (BAD_TYPE for a report_type outside {1,2,3}; BAD_ID
// for a report_id above 15). IT ASSERTS NOTHING ABOUT A REAL
// COMMAND WRITE OR A REAL PAYLOAD READ, because none runs --
// report_io.pdx §3 documents the deferrals.
//
//   R32 HID REPORT IO OK
//
// PLACEMENT AFTER hid_field_extract_witness IS DELIBERATE. This
// witness assumes the transport is bound (transport_witness left it
// so); the propagated DEFERRED_HARDWARE assertion inverts to
// NOT_BOUND otherwise. Reading "HID REPORT IO OK" immediately
// after "HID FIELD OK" is how an operator sees that both halves
// of the ROUND-TRIP -- the FIELD-EXTRACTION half (read side of a
// GET_REPORT payload) and the COMMAND-DISPATCH half (this module) --
// reported at the same boot.
//
// ONE FINGERPRINT. GET and SET are not split into two markers as
// reset/wake are (#1118), because the two failure modes are the same
// (a wrong opcode / register + a mistaken propagation shape) and the
// three refusal gates are shared between the two seams. Splitting
// would multiply markers without multiplying failure-localisation.

module ReportIoSynth = structure {

  pub let mut _hid_ri_w_stage : u64 = 0

  pub let hid_ri_w_ok   : [u8; 17] = "HID REPORT IO OK\0"
  pub let hid_ri_w_fail : [u8; 19] = "HID REPORT IO FAIL\0"

  pub let hid_report_io_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M2-005 (#1124): boot witness for the HID GET/SET_REPORT round-trip. Stages: (S1) hid_report_get_arbitrated() == 0. (S2) hid_report_set_arbitrated() == 0. (S3) sample get_count() before dispatch. (S4) get(FEATURE=3, report_id=0) -> DEFERRED_HARDWARE (both nested transport seams propagate the sentinel; transport bound by transport_witness). (S5) get_count() moved by exactly 1. (S6) get_deferred() moved by exactly 1. (S7) get(0, 0) -> BAD_TYPE (report_type 0 not in {1,2,3}). (S8) get(4, 0) -> BAD_TYPE. (S9) get(1, 16) -> BAD_ID (report_id > 15). (S10) sample set_count() before dispatch. (S11) set(FEATURE=3, report_id=0, byte=0x5A) -> DEFERRED_HARDWARE. (S12) set_count() moved by exactly 1. (S13) set_deferred() moved by exactly 1. (S14) set(0, 0, 0) -> BAD_TYPE. (S15) set(3, 16, 0) -> BAD_ID. Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed hid_ri_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- get_arbitrated() == 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_get_arbitrated;
        cmp rax, 0;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S2 -- set_arbitrated() == 0.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_set_arbitrated;
        cmp rax, 0;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S3 -- sample get_count() before dispatch.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_get_count;
        mov rbx, rax;                     // saved: get_count before

        // Sample get_deferred() before dispatch too.
        call hid_report_get_deferred;
        mov r12, rax;                     // saved: get_deferred before

        // ================================================================
        // S4 -- get(FEATURE, 0) -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 3;                       // FEATURE
        mov rsi, 0;                       // report_id
        call hid_report_get;
        mov r11, 0xFFFFFEBC;              // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S5 -- get_count() moved by exactly 1.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_get_count;
        sub rax, rbx;
        cmp rax, 1;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S6 -- get_deferred() moved by exactly 1.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_get_deferred;
        sub rax, r12;
        cmp rax, 1;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S7 -- get(0, 0) -> BAD_TYPE (report_type 0 not in {1,2,3}).
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        call hid_report_get;
        mov r11, 0xFFFFFC30;              // BAD_TYPE
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S8 -- get(4, 0) -> BAD_TYPE.
        // ================================================================
        mov rax, 80;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 4;
        mov rsi, 0;
        call hid_report_get;
        mov r11, 0xFFFFFC30;
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S9 -- get(1, 16) -> BAD_ID.
        // ================================================================
        mov rax, 90;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 1;                       // INPUT
        mov rsi, 16;                      // > 15
        call hid_report_get;
        mov r11, 0xFFFFFC31;              // BAD_ID
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S10 -- sample set_count()/set_deferred() before dispatch.
        // ================================================================
        mov rax, 100;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_set_count;
        mov r13, rax;                     // saved: set_count before
        call hid_report_set_deferred;
        mov r14, rax;                     // saved: set_deferred before

        // ================================================================
        // S11 -- set(FEATURE, 0, 0x5A) -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 110;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 3;                       // FEATURE
        mov rsi, 0;                       // report_id
        mov rdx, 0x5A;                    // payload byte
        call hid_report_set;
        mov r11, 0xFFFFFEBC;
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S12 -- set_count() moved by exactly 1.
        // ================================================================
        mov rax, 120;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_set_count;
        sub rax, r13;
        cmp rax, 1;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S13 -- set_deferred() moved by exactly 1.
        // ================================================================
        mov rax, 130;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        call hid_report_set_deferred;
        sub rax, r14;
        cmp rax, 1;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S14 -- set(0, 0, 0) -> BAD_TYPE.
        // ================================================================
        mov rax, 140;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call hid_report_set;
        mov r11, 0xFFFFFC30;
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // ================================================================
        // S15 -- set(3, 16, 0) -> BAD_ID.
        // ================================================================
        mov rax, 150;
        lea rcx, [rip + _hid_ri_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 16;
        mov rdx, 0;
        call hid_report_set;
        mov r11, 0xFFFFFC31;
        cmp rax, r11;
        jne hid_ri_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_ri_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hid_ri_w_out;

      hid_ri_w_fail_stage:
        lea rax, [rip + _hid_ri_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_ri_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hid_ri_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
