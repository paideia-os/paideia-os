// tests/kernel/drivers/hid/report_parser_synth.pdx — R32.M2-001 (#1120)
//
// Boot witness for the HID REPORT-DESCRIPTOR PARSER (report_parser.pdx).
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It parses the canonical USB HID boot-mouse descriptor (the shortest
// real descriptor that exercises Application + Physical collections,
// several Global tags, several Local tags, and three INPUT items), then
// asserts the row count, four representative row fields, the two-pass
// gate on invalid inputs (REBIND, EMPTY, LONG_ITEM), and that
// hid_report_parser_reset leaves the schema in a state where a fresh
// feed on an empty descriptor returns EMPTY rather than REBIND. IT
// ASSERTS NOTHING ABOUT A LIVE FETCH -- the descriptor bytes are a
// .rodata fixture, not a transport read.
//
//   R32 HID PARSER OK

module ReportParserSynth = structure {

  pub let mut _hid_rp_w_stage : u64 = 0

  pub let hid_rp_w_ok   : [u8; 18] = "R32 HID PARSER OK\0"
  pub let hid_rp_w_fail : [u8; 20] = "R32 HID PARSER FAIL\0"

  // ---------------------------------------------------------------------------
  // The canonical USB HID boot-mouse descriptor (50 bytes). Exercises:
  //   - Global: Usage Page (twice, on two pages), Report Size (3 values),
  //             Report Count (3 values), Logical Min/Max (twice)
  //   - Local: Usage (twice on the same MAIN item -- last one wins),
  //            Usage Minimum, Usage Maximum
  //   - Main: Collection Application, Collection Physical,
  //           Input (Data/Var/Abs), Input (Const), Input (Data/Var/Rel),
  //           End Collection (twice)
  //
  // Expected schema (7 rows):
  //   0: COLL_BEGIN aux=1(App) page=1 uid=2(Mouse)  rsz=0 rcnt=0 depth=0
  //   1: COLL_BEGIN aux=0(Phy) page=1 uid=1(Pointer) rsz=0 rcnt=0 depth=1
  //   2: INPUT      aux=2      page=9 uid=0           rsz=1 rcnt=3 depth=2
  //   3: INPUT      aux=3      page=9 uid=0           rsz=5 rcnt=1 depth=2
  //   4: INPUT      aux=6      page=1 uid=0x31(Y)     rsz=8 rcnt=2 depth=2
  //   5: COLL_END   aux=0      page=1 uid=0           rsz=8 rcnt=2 depth=1
  //   6: COLL_END   aux=0      page=1 uid=0           rsz=8 rcnt=2 depth=0
  //
  // Note on rows 5 and 6: the parser stores the CURRENT global state at
  // every emission, so the Page-1/rsz=8/rcnt=2 from the last INPUT row
  // is carried through the two END markers. That is by design (§2/§4 of
  // report_parser.pdx): global state is persistent across MAIN items.
  //
  // Note on rows 2 and 3: local state (usage_last) is CLEARED after
  // every MAIN item (HID 1.11 §6.2.2.4), so the two Button INPUTs record
  // uid=0 rather than the Usage-Min (1) or Usage-Max (3) that the local
  // scope carried. usage_min / usage_max are not stored per-field in
  // this scaffold; a live class driver reads them via the parser's own
  // getters, which are not yet exposed (§5 of report_parser.pdx).
  // ---------------------------------------------------------------------------

  pub let _hid_rp_w_mouse : [u8; 50] = [
    0x05u8, 0x01u8,     // Usage Page (Generic Desktop)
    0x09u8, 0x02u8,     // Usage (Mouse)
    0xA1u8, 0x01u8,     // Collection (Application)
    0x09u8, 0x01u8,     //   Usage (Pointer)
    0xA1u8, 0x00u8,     //   Collection (Physical)
    0x05u8, 0x09u8,     //     Usage Page (Button)
    0x19u8, 0x01u8,     //     Usage Minimum (Button 1)
    0x29u8, 0x03u8,     //     Usage Maximum (Button 3)
    0x15u8, 0x00u8,     //     Logical Minimum (0)
    0x25u8, 0x01u8,     //     Logical Maximum (1)
    0x95u8, 0x03u8,     //     Report Count (3)
    0x75u8, 0x01u8,     //     Report Size (1)
    0x81u8, 0x02u8,     //     Input (Data, Var, Abs)
    0x95u8, 0x01u8,     //     Report Count (1)
    0x75u8, 0x05u8,     //     Report Size (5)
    0x81u8, 0x03u8,     //     Input (Const, Var, Abs)
    0x05u8, 0x01u8,     //     Usage Page (Generic Desktop)
    0x09u8, 0x30u8,     //     Usage (X)
    0x09u8, 0x31u8,     //     Usage (Y)
    0x15u8, 0x81u8,     //     Logical Minimum (-127)
    0x25u8, 0x7Fu8,     //     Logical Maximum (127)
    0x75u8, 0x08u8,     //     Report Size (8)
    0x95u8, 0x02u8,     //     Report Count (2)
    0x81u8, 0x06u8,     //     Input (Data, Var, Rel)
    0xC0u8,             //   End Collection
    0xC0u8              // End Collection
  ]

  // Long-item prefix (0xFE) fixture. Refused with BAD_DESC.
  pub let _hid_rp_w_long : [u8; 1] = [ 0xFEu8 ]

  // Truncated fixture -- prefix 0x05 (Usage Page, size=1) with no data.
  pub let _hid_rp_w_trunc : [u8; 1] = [ 0x05u8 ]

  pub let hid_report_parser_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M2-001 (#1120): boot witness for the HID report-descriptor parser. Happy path: (S1) reset -> OK. (S2) valid() == 0. (S3) feed(mouse, 50) -> OK. (S4) valid() == 1. (S5) count() == 7. (S6..S9) representative row fields: row 0 kind=COLL_BEGIN, row 2 report_size=1, row 4 usage_id=0x31, row 4 depth=2. (S10) row 5 kind=COLL_END. (S11) row 6 depth=0. Failure edges: (S12) second feed without reset -> REBIND. (S13) reset then feed(any, 0) -> EMPTY. (S14) reset then feed(long_item, 1) -> BAD_DESC. (S15) reset then feed(truncated, 1) -> BAD_DESC (bounds check on size=1 with 0 bytes remaining). Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed hid_rp_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- reset returns OK.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_reset;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S2 -- valid() == 0 after reset.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_valid;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S3 -- feed(mouse_desc, 50) -> OK.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_rp_w_mouse];
        mov rsi, 50;
        call hid_report_parser_feed;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S4 -- valid() == 1.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_valid;
        cmp rax, 1;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S5 -- count() == 7.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_field_count;
        cmp rax, 7;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S6 -- row 0 kind == COLL_BEGIN (4).
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call hid_report_field_kind;
        cmp rax, 4;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S7 -- row 2 report_size == 1 (first INPUT: 3 buttons at 1 bit).
        // ================================================================
        mov rax, 70;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call hid_report_field_report_size;
        cmp rax, 1;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S8 -- row 4 usage_id == 0x31 (Y -- last Usage set before INPUT).
        // ================================================================
        mov rax, 80;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 4;
        call hid_report_field_usage_id;
        cmp rax, 0x31;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S9 -- row 4 depth == 2 (inside App + Physical).
        // ================================================================
        mov rax, 90;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 4;
        call hid_report_field_depth;
        cmp rax, 2;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S10 -- row 5 kind == COLL_END (5).
        // ================================================================
        mov rax, 100;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call hid_report_field_kind;
        cmp rax, 5;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S11 -- row 6 depth == 0 (outermost close).
        // ================================================================
        mov rax, 110;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        mov rdi, 6;
        call hid_report_field_depth;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S12 -- second feed WITHOUT reset -> REBIND (0xFFFFFC02).
        // ================================================================
        mov rax, 120;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + _hid_rp_w_mouse];
        mov rsi, 50;
        call hid_report_parser_feed;
        mov r11, 0xFFFFFC02;
        cmp rax, r11;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S13 -- reset, then feed(any, 0) -> EMPTY (0xFFFFFC03).
        // ================================================================
        mov rax, 130;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_reset;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;
        lea rdi, [rip + _hid_rp_w_mouse];
        xor rsi, rsi;
        call hid_report_parser_feed;
        mov r11, 0xFFFFFC03;
        cmp rax, r11;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S14 -- reset, then feed(long_item, 1) -> BAD_DESC (0xFFFFFC00).
        // ================================================================
        mov rax, 140;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_reset;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;
        lea rdi, [rip + _hid_rp_w_long];
        mov rsi, 1;
        call hid_report_parser_feed;
        mov r11, 0xFFFFFC00;
        cmp rax, r11;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // S15 -- reset, then feed(truncated, 1) -> BAD_DESC.
        // ================================================================
        mov rax, 150;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_reset;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;
        lea rdi, [rip + _hid_rp_w_trunc];
        mov rsi, 1;
        call hid_report_parser_feed;
        mov r11, 0xFFFFFC00;
        cmp rax, r11;
        jne hid_rp_w_fail_stage;

        // ================================================================
        // Reparse the mouse descriptor so the schema is left in a
        // valid state for the collection-walker witness that follows.
        // ================================================================
        mov rax, 160;
        lea rcx, [rip + _hid_rp_w_stage];
        mov [rcx], rax;
        call hid_report_parser_reset;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;
        lea rdi, [rip + _hid_rp_w_mouse];
        mov rsi, 50;
        call hid_report_parser_feed;
        cmp rax, 0;
        jne hid_rp_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_rp_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hid_rp_w_out;

      hid_rp_w_fail_stage:
        lea rax, [rip + _hid_rp_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_rp_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hid_rp_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
