// tests/kernel/drivers/hid/event_stream_synth.pdx — R32.M3-003 (#1127)
//
// Boot witness for the HID event stream fanout: subscribe/unsubscribe
// discipline, mask-filtered publish, unrouted/BAD_TYPE counters, and
// per-subscriber delivery counts.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts refusals, state transitions, monotone seq, and per-
// subscriber delivery accounting. IT ASSERTS NOTHING ABOUT A REAL
// ENDPOINT ENQUEUE, because no code in this tree enqueues a HID event
// byte into a subscriber's KIND_IPC_ENDPOINT queue --
// event_stream.pdx §4 documents the R32.M4 deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R32 HID EVENT STREAM OK
//
// One and not several because subscribe / unsubscribe / publish are a
// single state machine with disjoint failure codes -- a per-stage
// failure lands in the stage counter, and the fail path prints it
// alongside the fingerprint so an operator can localise without
// splitting the marker.
//
// -----------------------------------------------------------------------------
// Cap slots 124..131
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness's set:
//   ..                 hid_event_synth       -> 118..123
//   ..                 (hotkey)              -> 100..103
//   ..                 (backlight/kbd)       -> 96..99
//   THIS WITNESS       event_stream_synth    -> 124..131

module EventStreamSynth = structure {

  pub let mut _hes_w_stage : u64 = 0

  pub let hes_w_ok   : [u8; 20] = "HID EVENT STREAM OK\0"
  pub let hes_w_fail : [u8; 22] = "HID EVENT STREAM FAIL\0"

  // ==========================================================================
  // hes_w_clear() -- clear cap_table slots 124..131 and reset stream state.
  // ==========================================================================

  pub let hes_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-003 (#1127): clear cap_table slots 124..131 through cap_mint_write and reset _hid_evt_stream_subs / _delivered / _stats / _seq. Called on both witness exits. Two pushes leave rsp%16 == 0 at every nested call. Labels prefixed hes_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 124;
      hes_wc_loop:
        cmp rbx, 132;
        jae hes_wc_scrub;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp hes_wc_loop;
      hes_wc_scrub:
        call hid_event_stream_reset;
        call hid_event_table_reset;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hes_w_endpoint(slot, eid) -- synthetic KIND_IPC_ENDPOINT with RIGHT_MINT.
  // ==========================================================================

  pub let hes_w_endpoint : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-003 (#1127): write a synthetic KIND_IPC_ENDPOINT descriptor with RIGHT_MINT, endpoint id in target_ptr[15:0]. Same shape as hide_w_endpoint (the KIND_HID_EVENT witness's helper) but re-emitted here for confinement: a shared helper across two module namespaces would introduce a cross-file dependency the boot-witness fixtures deliberately avoid. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, r13;                    // target_ptr = eid
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let hid_event_stream_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R32.M3-003 (#1127): boot witness for the HID event stream. Stages: (S1) reset the stream; sub_count()==0, seq()==0. (S2) subscribe on a KIND_IPC_ENDPOINT (not KIND_HID_EVENT) -> WRONG_KIND. Subscribe on an empty slot -> WRONG_KIND. (S3) Mint three KIND_HID_EVENT subscriptions with distinct masks (KEY, POINTER, MASK_ALL). Subscribe all three -> OK; sub_count()==3. Second subscribe of the KEY row -> ALREADY. (S4) publish(KEY, payload_a) -> matches==2 (KEY sub + MASK_ALL sub); seq()==1; delivered_by(KEY)==1, delivered_by(POINTER)==0, delivered_by(MASK_ALL)==1. publish(POINTER, payload_b) -> matches==2. (S5) publish(0) -> BAD_TYPE, seq unchanged. publish(0x03 = KEY|POINTER) -> BAD_TYPE (must be EXACTLY one class). publish(0x10) -> BAD_TYPE (outside MASK_ALL). ST_BAD_TYPE == 3. (S6) Unsubscribe the KEY sub; sub_count()==2. publish(KEY, payload_c) -> matches==1 (only MASK_ALL). Unsubscribe already-gone -> NOT_SUBSCRIBED. (S7) Unsubscribe remaining two; sub_count()==0. publish(KEY, payload_d) -> matches==0; ST_UNROUTED bumps. Each stage runs only if the previous passed. Both exits call hes_w_clear. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed hes_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        call hes_w_clear;

        // 124 -- endpoint parent, eid 0x51.
        mov rdi, 124;
        mov rsi, 0x51;
        call hes_w_endpoint;

        // ================================================================
        // S1 -- reset + empty stream.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        call hid_event_stream_sub_count;
        cmp rax, 0;
        jne hes_w_fail_stage;

        call hid_event_stream_seq;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // ================================================================
        // S2 -- subscribe refusals.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        // Endpoint (not HID_EVENT) -> WRONG_KIND.
        mov rdi, 124;
        call hid_event_stream_subscribe;
        mov r11, 0xFFFFFEBE;             // HID_EVT_STREAM_WRONG_KIND
        cmp rax, r11;
        jne hes_w_fail_stage;

        // Empty slot -> WRONG_KIND (row_of_slot returns NONE).
        mov rdi, 130;
        call hid_event_stream_subscribe;
        mov r11, 0xFFFFFEBE;
        cmp rax, r11;
        jne hes_w_fail_stage;

        // Out-of-range slot -> BAD_SLOT.
        mov rdi, 300;
        call hid_event_stream_subscribe;
        mov r11, 0xFFFFFEBF;             // HID_EVT_STREAM_BAD_SLOT
        cmp rax, r11;
        jne hes_w_fail_stage;

        // ================================================================
        // S3 -- mint three subscriptions, subscribe them.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        // Mint KEY sub at slot 125.
        mov rdi, 125;
        mov rsi, 124;                    // parent endpoint
        mov rdx, 0x41B;                  // R_HID_EVENT_ALL
        mov rcx, 0x01;                   // HID_EVT_KEY
        mov r8, 42;                      // pid
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // Mint POINTER sub at slot 126.
        mov rdi, 126;
        mov rsi, 124;
        mov rdx, 0x41B;
        mov rcx, 0x02;                   // HID_EVT_POINTER
        mov r8, 43;
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // Mint MASK_ALL sub at slot 127.
        mov rdi, 127;
        mov rsi, 124;
        mov rdx, 0x41B;
        mov rcx, 0x0F;                   // HID_EVT_MASK_ALL
        mov r8, 44;
        call hid_event_cap_mint;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // Subscribe all three.
        mov rdi, 125;
        call hid_event_stream_subscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        mov rdi, 126;
        call hid_event_stream_subscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        mov rdi, 127;
        call hid_event_stream_subscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        call hid_event_stream_sub_count;
        cmp rax, 3;
        jne hes_w_fail_stage;

        // Double-subscribe -> ALREADY.
        mov rdi, 125;
        call hid_event_stream_subscribe;
        mov r11, 0xFFFFFEBD;             // HID_EVT_STREAM_ALREADY
        cmp rax, r11;
        jne hes_w_fail_stage;

        // ================================================================
        // S4 -- publish and check per-subscriber deliveries.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        // publish(KEY, 0xCAFE) -> matches 125 (KEY) + 127 (MASK_ALL).
        mov rdi, 0x01;                   // HID_EVT_KEY
        mov rsi, 0xCAFE;                 // opaque payload
        call hid_event_stream_publish;
        cmp rax, 2;
        jne hes_w_fail_stage;

        call hid_event_stream_seq;
        cmp rax, 1;
        jne hes_w_fail_stage;

        mov rdi, 125;
        call hid_event_stream_delivered_by;
        cmp rax, 1;
        jne hes_w_fail_stage;

        mov rdi, 126;
        call hid_event_stream_delivered_by;
        cmp rax, 0;
        jne hes_w_fail_stage;

        mov rdi, 127;
        call hid_event_stream_delivered_by;
        cmp rax, 1;
        jne hes_w_fail_stage;

        // publish(POINTER, 0xBEEF) -> matches 126 (POINTER) + 127 (MASK_ALL).
        mov rdi, 0x02;                   // HID_EVT_POINTER
        mov rsi, 0xBEEF;
        call hid_event_stream_publish;
        cmp rax, 2;
        jne hes_w_fail_stage;

        call hid_event_stream_seq;
        cmp rax, 2;
        jne hes_w_fail_stage;

        mov rdi, 126;
        call hid_event_stream_delivered_by;
        cmp rax, 1;
        jne hes_w_fail_stage;

        mov rdi, 127;
        call hid_event_stream_delivered_by;
        cmp rax, 2;
        jne hes_w_fail_stage;

        // ================================================================
        // S5 -- publish refusals: BAD_TYPE variants.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        // publish(0, x) -> BAD_TYPE.
        xor rdi, rdi;
        mov rsi, 0;
        call hid_event_stream_publish;
        mov r11, 0xFFFFFEBA;             // HID_EVT_STREAM_BAD_TYPE
        cmp rax, r11;
        jne hes_w_fail_stage;

        // publish(0x03 = KEY|POINTER, x) -> BAD_TYPE (combined).
        mov rdi, 0x03;
        mov rsi, 0;
        call hid_event_stream_publish;
        mov r11, 0xFFFFFEBA;
        cmp rax, r11;
        jne hes_w_fail_stage;

        // publish(0x10, x) -> BAD_TYPE (outside MASK_ALL).
        mov rdi, 0x10;
        mov rsi, 0;
        call hid_event_stream_publish;
        mov r11, 0xFFFFFEBA;
        cmp rax, r11;
        jne hes_w_fail_stage;

        // seq did not advance on any refused publish (still 2).
        call hid_event_stream_seq;
        cmp rax, 2;
        jne hes_w_fail_stage;

        // ST_BAD_TYPE == 3.
        mov rdi, 4;                      // HID_EVT_STREAM_ST_BAD_TYPE
        call hid_event_stream_stat;
        cmp rax, 3;
        jne hes_w_fail_stage;

        // ================================================================
        // S6 -- unsubscribe the KEY sub, publish again.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        mov rdi, 125;
        call hid_event_stream_unsubscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        call hid_event_stream_sub_count;
        cmp rax, 2;
        jne hes_w_fail_stage;

        // publish(KEY, x) -> matches only 127 (MASK_ALL).
        mov rdi, 0x01;
        mov rsi, 0xC0DE;
        call hid_event_stream_publish;
        cmp rax, 1;
        jne hes_w_fail_stage;

        mov rdi, 127;
        call hid_event_stream_delivered_by;
        cmp rax, 3;                      // 1 (S4 KEY) + 1 (S4 POINTER) + 1 (S6 KEY)
        jne hes_w_fail_stage;

        // Unsubscribe already-gone -> NOT_SUBSCRIBED.
        mov rdi, 125;
        call hid_event_stream_unsubscribe;
        mov r11, 0xFFFFFEBB;             // HID_EVT_STREAM_NOT_SUBSCRIBED
        cmp rax, r11;
        jne hes_w_fail_stage;

        // delivered_by on a slot no entry holds -> DECODE_BAD.
        mov rdi, 125;
        call hid_event_stream_delivered_by;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne hes_w_fail_stage;

        // ================================================================
        // S7 -- unsubscribe all, publish is unrouted.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _hes_w_stage];
        mov [rcx], rax;

        mov rdi, 126;
        call hid_event_stream_unsubscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        mov rdi, 127;
        call hid_event_stream_unsubscribe;
        cmp rax, 0;
        jne hes_w_fail_stage;

        call hid_event_stream_sub_count;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // publish -> matches 0.
        mov rdi, 0x01;
        mov rsi, 0xFACE;
        call hid_event_stream_publish;
        cmp rax, 0;
        jne hes_w_fail_stage;

        // ST_UNROUTED >= 1.
        mov rdi, 3;                      // HID_EVT_STREAM_ST_UNROUTED
        call hid_event_stream_stat;
        cmp rax, 0;
        je  hes_w_fail_stage;

        // Seq advanced on the unrouted publish (was 3 after S6, now 4).
        call hid_event_stream_seq;
        cmp rax, 4;
        jne hes_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hes_w_ok];
        call klog_s1;

        call hes_w_clear;
        xor rax, rax;
        jmp hes_w_out;

      hes_w_fail_stage:
        lea rax, [rip + _hes_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hes_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hes_w_clear;
        mov rax, 1;

      hes_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
