// tests/kernel/drivers/hid/usage_synth.pdx — R32.M2-002 (#1121)
//
// Boot witness for the HID USAGE table (usage.pdx).
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the honesty pin (consumed == 0 while no class driver keys
// off the classifier), the row count (15), page_known() on the four
// pages this build knows and on a page it does not, and the two-pass
// scan on both specific and wildcard rows. IT ASSERTS NOTHING ABOUT A
// LIVE ROUTING DECISION, because no consumer exists yet.
//
//   R32 HID USAGE OK

module UsageSynth = structure {

  pub let mut _hid_us_w_stage : u64 = 0

  pub let hid_us_w_ok   : [u8; 13] = "HID USAGE OK\0"
  pub let hid_us_w_fail : [u8; 15] = "HID USAGE FAIL\0"

  pub let hid_usage_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M2-002 (#1121): boot witness for the HID usage classifier. Stages: (S1) consumed() == 0 (honesty pin). (S2) row_count() == 15. (S3) page_known(0x01) == 1 (Generic Desktop). (S4) page_known(0x07) == 1 (Keyboard). (S5) page_known(0x09) == 1 (Button). (S6) page_known(0x0C) == 1 (Consumer). (S7) page_known(0x02) == 0 (Simulation Controls -- not in the four this build knows). (S8) id_kind(0x01, 0x02) == 2 (Mouse -- specific hit on Generic Desktop). (S9) id_kind(0x01, 0x30) == 6 (X -- specific hit). (S10) id_kind(0x01, 0x99) == 1 (unknown id on Generic Desktop, wildcard hit -> POINTER). (S11) id_kind(0x09, 0x03) == 10 (Button 3 -- wildcard hit on Button page -> BUTTON). (S12) id_kind(0x0C, 0xE9) == 11 (Volume Increment -- specific hit). (S13) id_kind(0x0C, 0x9999) == 11 (arbitrary consumer id -- wildcard). (S14) id_kind(0xFE, 0x30) == 0 (unknown page -- both passes miss -> UNKNOWN). Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed hid_us_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- honesty pin.
        mov rax, 10;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        call hid_usage_consumed;
        cmp rax, 0;
        jne hid_us_w_fail_stage;

        // S2 -- row count == 15.
        mov rax, 20;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        call hid_usage_row_count;
        cmp rax, 15;
        jne hid_us_w_fail_stage;

        // S3 -- page_known(0x01) == 1.
        mov rax, 30;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0001;
        call hid_usage_page_known;
        cmp rax, 1;
        jne hid_us_w_fail_stage;

        // S4 -- page_known(0x07) == 1.
        mov rax, 40;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0007;
        call hid_usage_page_known;
        cmp rax, 1;
        jne hid_us_w_fail_stage;

        // S5 -- page_known(0x09) == 1.
        mov rax, 50;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0009;
        call hid_usage_page_known;
        cmp rax, 1;
        jne hid_us_w_fail_stage;

        // S6 -- page_known(0x0C) == 1.
        mov rax, 60;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x000C;
        call hid_usage_page_known;
        cmp rax, 1;
        jne hid_us_w_fail_stage;

        // S7 -- page_known(0x02) == 0 (unknown).
        mov rax, 70;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0002;
        call hid_usage_page_known;
        cmp rax, 0;
        jne hid_us_w_fail_stage;

        // S8 -- id_kind(0x01, 0x02) == 2 (Mouse -- specific).
        mov rax, 80;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0001;
        mov rsi, 0x0002;
        call hid_usage_id_kind;
        cmp rax, 2;
        jne hid_us_w_fail_stage;

        // S9 -- id_kind(0x01, 0x30) == 6 (X -- specific).
        mov rax, 90;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0001;
        mov rsi, 0x0030;
        call hid_usage_id_kind;
        cmp rax, 6;
        jne hid_us_w_fail_stage;

        // S10 -- id_kind(0x01, 0x99) == 1 (unknown id -> POINTER via wildcard).
        mov rax, 100;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0001;
        mov rsi, 0x0099;
        call hid_usage_id_kind;
        cmp rax, 1;
        jne hid_us_w_fail_stage;

        // S11 -- id_kind(0x09, 0x03) == 10 (Button 3 -- wildcard).
        mov rax, 110;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x0009;
        mov rsi, 0x0003;
        call hid_usage_id_kind;
        cmp rax, 10;
        jne hid_us_w_fail_stage;

        // S12 -- id_kind(0x0C, 0xE9) == 11 (Volume Increment -- specific).
        mov rax, 120;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x000C;
        mov rsi, 0x00E9;
        call hid_usage_id_kind;
        cmp rax, 11;
        jne hid_us_w_fail_stage;

        // S13 -- id_kind(0x0C, 0x1234) == 11 (arbitrary consumer -> wildcard).
        // Use an id <= 0xFFFF so the packed key does not collide with the
        // page nibble; consumer id 0x1234 is arbitrary and unassigned.
        mov rax, 130;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x000C;
        mov rsi, 0x1234;
        call hid_usage_id_kind;
        cmp rax, 11;
        jne hid_us_w_fail_stage;

        // S14 -- id_kind(0x00FE, 0x0030) == 0 (unknown page -> UNKNOWN).
        mov rax, 140;
        lea rcx, [rip + _hid_us_w_stage];
        mov [rcx], rax;
        mov rdi, 0x00FE;
        mov rsi, 0x0030;
        call hid_usage_id_kind;
        cmp rax, 0;
        jne hid_us_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_us_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hid_us_w_out;

      hid_us_w_fail_stage:
        lea rax, [rip + _hid_us_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_us_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hid_us_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
