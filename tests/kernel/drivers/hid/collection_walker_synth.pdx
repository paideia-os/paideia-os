// tests/kernel/drivers/hid/collection_walker_synth.pdx — R32.M2-003 (#1122)
//
// Boot witness for the HID COLLECTION WALKER (collection_walker.pdx).
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It consumes the schema the parser witness left behind (parser witness
// ends with a re-feed of the canonical boot-mouse descriptor for exactly
// this reason), asserts the two collection-level projections
// (collection_count == 2 for App + Physical; max_depth == 2), the
// type/depth accessors for each COLL_BEGIN row (in order of emission),
// the OOB refusal on both accessors, the honesty pin, and the callback-
// driven walk -- verifying the callback ran exactly count() times and
// summed the expected kind/depth checksums across all rows. IT ASSERTS
// NOTHING ABOUT A LIVE ROUTING DECISION.
//
//   R32 HID COLLECTION OK
//
// PLACEMENT AFTER hid_report_parser_witness IS REQUIRED. The walker
// reads _hid_report_schema / _hid_report_valid / _hid_report_count,
// which the parser witness populates at its S16 re-feed. Running before
// the parser witness would leave the walker asserting against zeroed
// storage (valid == 0, count == 0), and the walk assertion would then
// see 0 rows and the callback checksum would remain at zero -- a false
// positive.

module CollectionWalkerSynth = structure {

  pub let mut _hid_cw_w_stage : u64 = 0

  pub let hid_cw_w_ok   : [u8; 22] = "R32 HID COLLECTION OK\0"
  pub let hid_cw_w_fail : [u8; 24] = "R32 HID COLLECTION FAIL\0"

  // Callback counters. Each is a single u64 the callback bumps or sums.
  pub let mut _hid_cw_w_cb_calls     : u64 = 0
  pub let mut _hid_cw_w_cb_kind_sum  : u64 = 0
  pub let mut _hid_cw_w_cb_depth_sum : u64 = 0

  // ---------------------------------------------------------------------------
  // Callback used by S12. Signature matches the walker's contract (§0 of
  // collection_walker.pdx): rdi=row_idx, rsi=kind, rdx=depth, rcx=aux,
  // r8=usage_page, r9=usage_id. Only rax/r10 are clobbered; rbx/r12-r15
  // are preserved by not touching them, so the walker's register plan is
  // not disturbed.
  //
  // For the mouse descriptor (7 rows: COLL_BEGIN, COLL_BEGIN, INPUT,
  // INPUT, INPUT, COLL_END, COLL_END):
  //   kinds  = 4, 4, 1, 1, 1, 5, 5   -> sum = 21
  //   depths = 0, 1, 2, 2, 2, 1, 0   -> sum = 8
  //   calls  = 7
  // ---------------------------------------------------------------------------

  pub let hid_cw_w_cb_counter : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_idx: u64, kind: u64, depth: u64, aux: u64, page: u64, uid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): walker callback -- bumps _hid_cw_w_cb_calls by 1, adds kind to _hid_cw_w_cb_kind_sum, adds depth to _hid_cw_w_cb_depth_sum. Reads aux/page/uid/row_idx only to satisfy the SysV contract (unused for the checksum but MUST be received as declared -- a callee that took fewer args would leave arg regs live and let a later dispatch call it with the wrong contract). Uses only rax/r10; preserves rbx/r12-r15 the walker relies on. Leaf load/store. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_cw_w_cb_calls];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hid_cw_w_cb_kind_sum];
        mov rax, [r10];
        add rax, rsi;
        mov [r10], rax;

        lea r10, [rip + _hid_cw_w_cb_depth_sum];
        mov rax, [r10];
        add rax, rdx;
        mov [r10], rax;

        xor rax, rax;
        ret
      }
    }

  pub let hid_collection_walker_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M2-003 (#1122): boot witness for the HID collection walker. Depends on the parser witness having left _hid_report_schema/valid/count populated. Stages: (S1) consumed() == 0 (honesty). (S2) collection_count() == 2 (App + Physical). (S3) max_depth() == 2. (S4) type_at(0) == 1 (Application). (S5) type_at(1) == 0 (Physical). (S6) depth_at(0) == 0. (S7) depth_at(1) == 1. (S8) type_at(2) -> BAD_IDX (only 2 BEGINs exist). (S9) depth_at(999) -> BAD_IDX. (S10) reset callback counters. (S11) walk(cb) returns 7 (rows walked). (S12) cb_calls == 7. (S13) kind_sum == 21 (4+4+1+1+1+5+5). (S14) depth_sum == 8 (0+1+2+2+2+1+0). Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed hid_cw_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // S1 -- honesty pin.
        mov rax, 10;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        call hid_collection_walker_consumed;
        cmp rax, 0;
        jne hid_cw_w_fail_stage;

        // S2 -- collection_count() == 2.
        mov rax, 20;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        call hid_collection_count;
        cmp rax, 2;
        jne hid_cw_w_fail_stage;

        // S3 -- max_depth() == 2.
        mov rax, 30;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        call hid_collection_max_depth;
        cmp rax, 2;
        jne hid_cw_w_fail_stage;

        // S4 -- type_at(0) == 1 (Application).
        mov rax, 40;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call hid_collection_type_at;
        cmp rax, 1;
        jne hid_cw_w_fail_stage;

        // S5 -- type_at(1) == 0 (Physical).
        mov rax, 50;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call hid_collection_type_at;
        cmp rax, 0;
        jne hid_cw_w_fail_stage;

        // S6 -- depth_at(0) == 0.
        mov rax, 60;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call hid_collection_depth_at;
        cmp rax, 0;
        jne hid_cw_w_fail_stage;

        // S7 -- depth_at(1) == 1.
        mov rax, 70;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call hid_collection_depth_at;
        cmp rax, 1;
        jne hid_cw_w_fail_stage;

        // S8 -- type_at(2) -> BAD_IDX (only 2 BEGINs).
        mov rax, 80;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        call hid_collection_type_at;
        mov r11, 0xFFFFFC10;
        cmp rax, r11;
        jne hid_cw_w_fail_stage;

        // S9 -- depth_at(999) -> BAD_IDX.
        mov rax, 90;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        mov rdi, 999;
        call hid_collection_depth_at;
        mov r11, 0xFFFFFC10;
        cmp rax, r11;
        jne hid_cw_w_fail_stage;

        // S10 -- reset callback counters.
        mov rax, 100;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        xor rax, rax;
        lea r10, [rip + _hid_cw_w_cb_calls];
        mov [r10], rax;
        lea r10, [rip + _hid_cw_w_cb_kind_sum];
        mov [r10], rax;
        lea r10, [rip + _hid_cw_w_cb_depth_sum];
        mov [r10], rax;

        // S11 -- walk(cb) returns 7.
        mov rax, 110;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        lea rdi, [rip + hid_cw_w_cb_counter];
        call hid_collection_walk;
        cmp rax, 7;
        jne hid_cw_w_fail_stage;

        // S12 -- cb_calls == 7.
        mov rax, 120;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        lea r10, [rip + _hid_cw_w_cb_calls];
        mov rax, [r10];
        cmp rax, 7;
        jne hid_cw_w_fail_stage;

        // S13 -- kind_sum == 21.
        mov rax, 130;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        lea r10, [rip + _hid_cw_w_cb_kind_sum];
        mov rax, [r10];
        cmp rax, 21;
        jne hid_cw_w_fail_stage;

        // S14 -- depth_sum == 8.
        mov rax, 140;
        lea rcx, [rip + _hid_cw_w_stage];
        mov [rcx], rax;
        lea r10, [rip + _hid_cw_w_cb_depth_sum];
        mov rax, [r10];
        cmp rax, 8;
        jne hid_cw_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_cw_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp hid_cw_w_out;

      hid_cw_w_fail_stage:
        lea rax, [rip + _hid_cw_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hid_cw_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      hid_cw_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
