// tests/kernel/drivers/hid/gestures_synth.pdx
//     R32.M4-001 (#1129), R32.M4-002 (#1130),
//     R32.M4-003 (#1131), R32.M4-004 (#1132)
//
// Boot witnesses for the four gesture recognizers in
// src/kernel/core/drivers/hid/gestures.pdx.
//
// -----------------------------------------------------------------------------
// What these witnesses assert, and what they do NOT
// -----------------------------------------------------------------------------
//
// Each witness drives a synthetic touch sequence through one
// recognizer's step function and asserts the state transitions
// (IDLE / TRACKING / RECOGNIZED), the emit-flag returns and the
// output cells. They assert NOTHING about a real HID event source
// or the touchpad hardware — gestures.pdx §0 documents both
// deferrals — because no code in this tree is a live HID subscriber.
//
// -----------------------------------------------------------------------------
// Four fingerprints, one per issue
// -----------------------------------------------------------------------------
//
//   R32 GESTURE 2FSCROLL OK    <- #1129
//   R32 GESTURE PINCH OK       <- #1130
//   R32 GESTURE KINETIC OK     <- #1131
//   R32 GESTURE SWIPE OK       <- #1132
//
// Four rather than one because the four recognizers can fail for
// unrelated reasons (a broken threshold gate vs a broken direction
// bin), and the golden's ordered subsequence needs the four
// distinguishable in the log.
//
// -----------------------------------------------------------------------------
// No capability slots
// -----------------------------------------------------------------------------
//
// Unlike the HID EVENT STREAM witness (event_stream_synth.pdx), the
// gesture recognizers touch no cap_table entries: they operate on
// per-gesture state cells confined to gestures.o. No slot range is
// reserved and no mint helper is defined.

module GesturesSynth = structure {

  pub let mut _g_w_stage : u64 = 0

  pub let g_w_2fs_ok      : [u8; 24] = "R32 GESTURE 2FSCROLL OK\0"
  pub let g_w_2fs_fail    : [u8; 26] = "R32 GESTURE 2FSCROLL FAIL\0"

  pub let g_w_pi_ok       : [u8; 21] = "R32 GESTURE PINCH OK\0"
  pub let g_w_pi_fail     : [u8; 23] = "R32 GESTURE PINCH FAIL\0"

  pub let g_w_kn_ok       : [u8; 23] = "R32 GESTURE KINETIC OK\0"
  pub let g_w_kn_fail     : [u8; 25] = "R32 GESTURE KINETIC FAIL\0"

  pub let g_w_sw_ok       : [u8; 21] = "R32 GESTURE SWIPE OK\0"
  pub let g_w_sw_fail     : [u8; 23] = "R32 GESTURE SWIPE FAIL\0"

  // ==========================================================================
  // gesture_scroll_witness — R32.M4-001 (#1129)
  //
  // Drives the two-finger scroll recognizer:
  //   (S1) reset; scroll_state == IDLE (0).
  //   (S2) step(1, 0, 0) — wrong finger count -> 0, still IDLE.
  //   (S3) step(2, 100, 100) — first 2-finger sample -> 0,
  //        state TRACKING (1).
  //   (S4) step(2, 100, 105) — |dy| = 5 >= threshold(4) -> 1,
  //        state RECOGNIZED (2); scroll_dx() == 0; scroll_dy() == 5.
  //   (S5) step(2, 100, 106) — |dy| = 1 < threshold -> 0,
  //        state still RECOGNIZED.
  //   (S6) step(2, 90, 106)  — |dx| = 10 >= threshold -> 1,
  //        scroll_dx() == -10 (0xFFFFFFFFFFFFFFF6).
  //   (S7) step(0, 0, 0)     — finger lift -> 0, state IDLE.
  //   (S8) After lift, step(2, 200, 200) -> 0, state TRACKING with
  //        last = (200, 200). Next step(2, 200, 210) -> emit dy=10.
  // ==========================================================================

  pub let gesture_scroll_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M4-001 (#1129): boot witness for the two-finger scroll recognizer. Eight stages exercising the wrong-finger-count refusal, first-sample tracking initialization, threshold-gated emission on both axes, no-re-emit-below-threshold, sign preservation on negative dx (dx=-10 stored as 0xFFFFFFFFFFFFFFF6), finger-lift teardown that scrubs last_x/last_y so a fresh scroll does NOT interpret its first sample as a huge dx relative to the previous scroll's terminus, and the fresh-tracking-after-lift restart. Each stage runs only if the previous passed. Five-push prologue keeps rsp%16 == 0 at every nested call. Labels prefixed g_w_sc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;

        call gesture_reset;

        // S1: state == IDLE.
        call gesture_scroll_state;
        cmp rax, 0;
        jne g_w_sc_fail_stage;

        // S2: wrong finger count -> 0, IDLE.
        mov rax, 2;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0;
        mov rdx, 0;
        call gesture_two_finger_scroll_step;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 0;
        jne g_w_sc_fail_stage;

        // S3: first 2-finger sample -> 0, TRACKING.
        mov rax, 3;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 100;
        mov rdx, 100;
        call gesture_two_finger_scroll_step;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 1;
        jne g_w_sc_fail_stage;

        // S4: dy = 5 -> emit, state RECOGNIZED, dx=0, dy=5.
        mov rax, 4;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 100;
        mov rdx, 105;
        call gesture_two_finger_scroll_step;
        cmp rax, 1;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 2;
        jne g_w_sc_fail_stage;
        call gesture_scroll_dx;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_dy;
        cmp rax, 5;
        jne g_w_sc_fail_stage;

        // S5: dy = 1 < threshold -> no emit, still RECOGNIZED.
        mov rax, 5;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 100;
        mov rdx, 106;
        call gesture_two_finger_scroll_step;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 2;
        jne g_w_sc_fail_stage;

        // S6: dx = -10 -> emit, dx = 0xFFFFFFFFFFFFFFF6 (u64 -10).
        mov rax, 6;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 90;
        mov rdx, 106;
        call gesture_two_finger_scroll_step;
        cmp rax, 1;
        jne g_w_sc_fail_stage;
        call gesture_scroll_dx;
        mov r11, 0xFFFFFFFFFFFFFFF6;
        cmp rax, r11;
        jne g_w_sc_fail_stage;

        // S7: finger lift -> IDLE.
        mov rax, 7;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call gesture_two_finger_scroll_step;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 0;
        jne g_w_sc_fail_stage;

        // S8: fresh 2-finger sample after lift -> TRACKING (no huge
        // dx from the previous 90/106 terminus), then emit on dy=10.
        mov rax, 8;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 200;
        mov rdx, 200;
        call gesture_two_finger_scroll_step;
        cmp rax, 0;
        jne g_w_sc_fail_stage;
        call gesture_scroll_state;
        cmp rax, 1;
        jne g_w_sc_fail_stage;

        mov rdi, 2;
        mov rsi, 200;
        mov rdx, 210;
        call gesture_two_finger_scroll_step;
        cmp rax, 1;
        jne g_w_sc_fail_stage;
        call gesture_scroll_dy;
        cmp rax, 10;
        jne g_w_sc_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_2fs_ok];
        call klog_s1;

        call gesture_reset;
        xor rax, rax;
        jmp g_w_sc_out;

      g_w_sc_fail_stage:
        lea rax, [rip + _g_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_2fs_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gesture_reset;
        mov rax, 1;

      g_w_sc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_pinch_witness — R32.M4-002 (#1130)
  //
  //   (S1) reset; state == IDLE.
  //   (S2) step(1, 0) — wrong count -> 0, IDLE.
  //   (S3) step(2, 100) — first 2f -> 0, TRACKING; init=100, cur=100.
  //   (S4) step(2, 105) — ddist = 5 < threshold(8) -> 0, cur=105.
  //   (S5) step(2, 120) — ddist = 20 >= threshold -> 1, RECOGNIZED,
  //        cur=120, init=100.
  //   (S6) step(2, 90)  — ddist = |90-100| = 10 >= threshold -> 1,
  //        cur=90.
  //   (S7) step(0, 0)   — lift -> IDLE.
  // ==========================================================================

  pub let gesture_pinch_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M4-002 (#1130): boot witness for the pinch recognizer. Seven stages exercising wrong-count refusal, first-sample tracking, sub-threshold no-emit, expand (dist grows) recognition, contract (dist shrinks) recognition of the same shape (the pinch gate is symmetric on ddist), and lift teardown. Verifies the scale is exposed as (cur, init) — a rational avoiding kernel FP (§3). Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed g_w_pi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;

        call gesture_reset;

        // S1: IDLE.
        call gesture_pinch_state;
        cmp rax, 0;
        jne g_w_pi_fail_stage;

        // S2: wrong count.
        mov rax, 2;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0;
        call gesture_pinch_step;
        cmp rax, 0;
        jne g_w_pi_fail_stage;

        // S3: first 2f -> TRACKING, init=100, cur=100.
        mov rax, 3;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 100;
        call gesture_pinch_step;
        cmp rax, 0;
        jne g_w_pi_fail_stage;
        call gesture_pinch_state;
        cmp rax, 1;
        jne g_w_pi_fail_stage;
        call gesture_pinch_init_dist;
        cmp rax, 100;
        jne g_w_pi_fail_stage;
        call gesture_pinch_cur_dist;
        cmp rax, 100;
        jne g_w_pi_fail_stage;

        // S4: ddist 5 < threshold -> no emit, cur=105.
        mov rax, 4;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 105;
        call gesture_pinch_step;
        cmp rax, 0;
        jne g_w_pi_fail_stage;
        call gesture_pinch_cur_dist;
        cmp rax, 105;
        jne g_w_pi_fail_stage;

        // S5: expand — ddist 20 -> emit, RECOGNIZED, cur=120.
        mov rax, 5;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 120;
        call gesture_pinch_step;
        cmp rax, 1;
        jne g_w_pi_fail_stage;
        call gesture_pinch_state;
        cmp rax, 2;
        jne g_w_pi_fail_stage;
        call gesture_pinch_cur_dist;
        cmp rax, 120;
        jne g_w_pi_fail_stage;
        call gesture_pinch_init_dist;
        cmp rax, 100;
        jne g_w_pi_fail_stage;

        // S6: contract — ddist |90-100|=10 -> emit, cur=90.
        mov rax, 6;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 90;
        call gesture_pinch_step;
        cmp rax, 1;
        jne g_w_pi_fail_stage;
        call gesture_pinch_cur_dist;
        cmp rax, 90;
        jne g_w_pi_fail_stage;

        // S7: lift -> IDLE.
        mov rax, 7;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        call gesture_pinch_step;
        cmp rax, 0;
        jne g_w_pi_fail_stage;
        call gesture_pinch_state;
        cmp rax, 0;
        jne g_w_pi_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_pi_ok];
        call klog_s1;

        call gesture_reset;
        xor rax, rax;
        jmp g_w_pi_out;

      g_w_pi_fail_stage:
        lea rax, [rip + _g_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_pi_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gesture_reset;
        mov rax, 1;

      g_w_pi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_kinetic_witness — R32.M4-003 (#1131)
  //
  //   (S1) reset; kinetic_state == IDLE (0); vx == 0; vy == 0.
  //   (S2) seed(1, 1) — both below MIN_VEL(2), leaves IDLE.
  //   (S3) seed(100, -200) — TRACKING (1); vx=100; vy = 0xFF..FF38 (-200).
  //   (S4) step() — emit, vx = 100*15/16 = 93, vy = -200*15/16 = -188
  //        (SAR-based signed div: floor toward -inf; -3000/16 = -188).
  //   (S5) step() again — emit, vx=87, vy=-177.
  //   (S6) Loop step() while state remains TRACKING; assert count is
  //        finite and terminates in IDLE with both |v| < MIN_VEL(2).
  //        The friction 15/16 halves |v| every ~11 steps; 100 -> below
  //        2 in ~44 steps; 200 -> below 2 in ~55 steps. Cap at 128
  //        to detect a never-terminating decay.
  // ==========================================================================

  pub let gesture_kinetic_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M4-003 (#1131): boot witness for kinetic scroll decay. Six stages: reset baseline, sub-threshold seed leaves IDLE, over-threshold seed enters TRACKING, first decay step emits with expected value (100 * 15 / 16 = 93 with sar-based signed division), second step compounds (93 * 15 / 16 = 87), and a bounded loop steps until the recognizer transitions to IDLE naturally; the loop cap (128) detects a never-terminating decay, and the exit state must be IDLE with both velocities below MIN_VEL. Signed vy tested via the -200 seed and the -188 first-tick assertion (sar of 0xFFFF..FF38 * 15 shifted right by 4 preserves the sign). Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed g_w_kn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;

        call gesture_reset;

        // S1: IDLE, vx=0, vy=0.
        call gesture_kinetic_state;
        cmp rax, 0;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vx;
        cmp rax, 0;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vy;
        cmp rax, 0;
        jne g_w_kn_fail_stage;

        // S2: seed with sub-threshold vx=1, vy=1 -> leaves IDLE.
        mov rax, 2;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        call gesture_kinetic_scroll_seed;
        call gesture_kinetic_state;
        cmp rax, 0;
        jne g_w_kn_fail_stage;

        // S3: seed with vx=100, vy=-200 -> TRACKING.
        mov rax, 3;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 100;
        mov rsi, 0xFFFFFFFFFFFFFF38;     // -200 as u64
        call gesture_kinetic_scroll_seed;
        call gesture_kinetic_state;
        cmp rax, 1;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vx;
        cmp rax, 100;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vy;
        mov r11, 0xFFFFFFFFFFFFFF38;
        cmp rax, r11;
        jne g_w_kn_fail_stage;

        // S4: step() -> emit, vx=93 (100*15/16 = 93 int-trunc),
        // vy = sar(-200*15, 4) = sar(-3000, 4) = -188 = 0xFFFFFFFFFFFFFF44.
        mov rax, 4;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        call gesture_kinetic_scroll_step;
        cmp rax, 1;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vx;
        cmp rax, 93;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vy;
        mov r11, 0xFFFFFFFFFFFFFF44;
        cmp rax, r11;
        jne g_w_kn_fail_stage;

        // S5: step() -> emit, vx = 93*15/16 = 87,
        // vy = sar(-188*15, 4) = sar(-2820, 4) = -177 = 0xFFFFFFFFFFFFFF4F.
        mov rax, 5;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        call gesture_kinetic_scroll_step;
        cmp rax, 1;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vx;
        cmp rax, 87;
        jne g_w_kn_fail_stage;
        call gesture_kinetic_vy;
        mov r11, 0xFFFFFFFFFFFFFF4F;
        cmp rax, r11;
        jne g_w_kn_fail_stage;

        // S6: bounded loop until IDLE. Cap = 128 iterations.
        mov rax, 6;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        xor rbx, rbx;                    // iteration counter
      g_w_kn_loop:
        call gesture_kinetic_scroll_step;
        cmp rax, 0;
        je  g_w_kn_loop_done;            // stopped naturally
        add rbx, 1;
        cmp rbx, 128;
        jae g_w_kn_fail_stage;           // never terminated
        jmp g_w_kn_loop;
      g_w_kn_loop_done:
        // State must be IDLE.
        call gesture_kinetic_state;
        cmp rax, 0;
        jne g_w_kn_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_kn_ok];
        call klog_s1;

        call gesture_reset;
        xor rax, rax;
        jmp g_w_kn_out;

      g_w_kn_fail_stage:
        lea rax, [rip + _g_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_kn_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gesture_reset;
        mov rax, 1;

      g_w_kn_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_swipe_witness — R32.M4-004 (#1132)
  //
  //   (S1) reset; state == IDLE; dir == NONE (0xFF).
  //   (S2) step(2, 50, 0) — < 3 fingers -> 0, IDLE.
  //   (S3) step(3, 10, 2) — first 3f -> 0, TRACKING; cum=(10,2).
  //   (S4) step(3, 20, 3) — cum=(30,5) below threshold(40) -> 0.
  //   (S5) step(3, 15, 1) — cum=(45,6) exceeds -> 1, RECOGNIZED,
  //        dir=RIGHT (0) (X dominant, positive).
  //   (S6) step(3, 100, 0) — RECOGNIZED sticky -> 0.
  //   (S7) lift step(0, 0, 0) -> IDLE, dir=NONE.
  //   (S8) fresh recognition upward: step(3, 0, -50) -> 0 tracking,
  //        step(3, 0, -50) -> cum_dy=-100 -> 1, dir=UP (3).
  //   (S9) lift; step(3, -60, 5) -> tracking; step(3, 0, 0) -> stays
  //        tracking (delta below thr). Actually cum_dx=-60 already
  //        past thr on first sample, so first step emits dir=LEFT.
  //   (S10) lift; downward: step(3, 5, 60) -> emit dir=DOWN (2).
  // ==========================================================================

  pub let gesture_swipe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R32.M4-004 (#1132): boot witness for the 3+ finger swipe recognizer. Ten stages exercising: reset baseline (dir=NONE=0xFF), sub-count refusal, first 3-finger tracking, sub-threshold no-emit, threshold-crossing recognition with correct dominant-axis direction bin (RIGHT for +X dominant), sticky-RECOGNIZED (no re-emit while fingers stay down), lift teardown that resets dir to NONE, fresh recognition of the three OTHER direction bins (UP with dy<0 dominant, LEFT with dx<0 dominant, DOWN with dy>0 dominant). Signed cumulative deltas via u64 bit patterns; the direction bin is a stored discriminant read by accessor. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed g_w_sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;

        call gesture_reset;

        // S1: IDLE, dir=NONE.
        call gesture_swipe_state;
        cmp rax, 0;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        mov r11, 0xFF;
        cmp rax, r11;
        jne g_w_sw_fail_stage;

        // S2: < 3 fingers -> 0, IDLE.
        mov rax, 2;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 50;
        mov rdx, 0;
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;

        // S3: first 3f -> 0, TRACKING; cum starts at 0 then += (10,2).
        mov rax, 3;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 10;
        mov rdx, 2;
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;
        call gesture_swipe_state;
        cmp rax, 1;
        jne g_w_sw_fail_stage;

        // S4: below threshold cumulatively (30,5).
        mov rax, 4;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 20;
        mov rdx, 3;
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;

        // S5: cum_dx=45 >= threshold -> emit, RECOGNIZED, dir=RIGHT.
        mov rax, 5;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 15;
        mov rdx, 1;
        call gesture_swipe_step;
        cmp rax, 1;
        jne g_w_sw_fail_stage;
        call gesture_swipe_state;
        cmp rax, 2;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        cmp rax, 0;                      // GESTURE_DIR_RIGHT
        jne g_w_sw_fail_stage;

        // S6: sticky RECOGNIZED — further step returns 0.
        mov rax, 6;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 100;
        mov rdx, 0;
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;

        // S7: lift -> IDLE, dir=NONE.
        mov rax, 7;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;
        call gesture_swipe_state;
        cmp rax, 0;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        mov r11, 0xFF;
        cmp rax, r11;
        jne g_w_sw_fail_stage;

        // S8: UP — dy=-50 twice, cum_dy=-100 dominant negative.
        mov rax, 8;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        // First 3f sample: no emit (accumulates from 0).
        mov rdi, 3;
        mov rsi, 0;
        mov rdx, 0xFFFFFFFFFFFFFFCE;     // -50
        call gesture_swipe_step;
        cmp rax, 0;
        jne g_w_sw_fail_stage;
        // Second: cum_dy = -100, |cum_dy| >= 40 -> emit UP.
        mov rdi, 3;
        mov rsi, 0;
        mov rdx, 0xFFFFFFFFFFFFFFCE;
        call gesture_swipe_step;
        cmp rax, 1;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        cmp rax, 3;                      // GESTURE_DIR_UP
        jne g_w_sw_fail_stage;

        // S9: LEFT — lift then dx=-60 in one sample.
        mov rax, 9;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call gesture_swipe_step;

        mov rdi, 3;
        mov rsi, 0xFFFFFFFFFFFFFFC4;     // -60
        mov rdx, 5;
        call gesture_swipe_step;
        cmp rax, 1;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        cmp rax, 1;                      // GESTURE_DIR_LEFT
        jne g_w_sw_fail_stage;

        // S10: DOWN — lift then dy=+60.
        mov rax, 10;
        lea rcx, [rip + _g_w_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0;
        mov rdx, 0;
        call gesture_swipe_step;

        mov rdi, 3;
        mov rsi, 5;
        mov rdx, 60;
        call gesture_swipe_step;
        cmp rax, 1;
        jne g_w_sw_fail_stage;
        call gesture_swipe_dir;
        cmp rax, 2;                      // GESTURE_DIR_DOWN
        jne g_w_sw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_sw_ok];
        call klog_s1;

        call gesture_reset;
        xor rax, rax;
        jmp g_w_sw_out;

      g_w_sw_fail_stage:
        lea rax, [rip + _g_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + g_w_sw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gesture_reset;
        mov rax, 1;

      g_w_sw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
