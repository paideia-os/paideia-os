// tests/kernel/drivers/backlight_pwm_synth.pdx — R31.M5-003 (#1108)
//
// Boot witness for the PWM backlight driver SCAFFOLD.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts the bind flag transition, the arbitration pin, the refusal
// discipline (BAD_LEVEL, NOT_BOUND) and the DEFERRED_HARDWARE outcome
// on a bound driver. IT ASSERTS NOTHING ABOUT A REAL MMIO STORE,
// because none runs in this tree -- backlight_pwm.pdx §4 documents the
// gated:hardware deferrals.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//
//   R31 PWM BACKLIGHT OK
//
// One and not two, because there is no unit conversion here and no
// cached state machine to fail for reasons independent of the write
// seam -- everything is the bind flag and the four refusal codes.

module BacklightPwmSynth = structure {

  pub let mut _blpwm_w_stage : u64 = 0

  pub let blpwm_w_ok   : [u8; 21] = "R31 PWM BACKLIGHT OK\0"
  pub let blpwm_w_fail : [u8; 23] = "R31 PWM BACKLIGHT FAIL\0"

  pub let backlight_pwm_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R31.M5-003 (#1108): boot witness for the PWM backlight scaffold. Stages: (S1) bound() returns 0 before bind; arbitrated() pinned at 0 (the honesty function per backlight_pwm.pdx §4). (S2) write(60) before bind -> NOT_BOUND. (S3) bind() -> OK. bound() returns 1. arbitrated() STILL 0 (the pin does not care whether bind ran). (S4) write(60) after bind -> DEFERRED_HARDWARE (the honest sentinel, per §3 of the driver). (S5) write(0x10000) -> BAD_LEVEL (refused, not clamped). (S6) writes() counter is >= 1 after S4. Each stage runs only if the previous passed. Five-push prologue leaves rsp%16 == 0 at every nested call. Labels prefixed blpwm_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // S1 -- bound() = 0, arbitrated() = 0.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        call backlight_pwm_bound;
        cmp rax, 0;
        jne blpwm_w_fail_stage;

        call backlight_pwm_arbitrated;
        cmp rax, 0;
        jne blpwm_w_fail_stage;

        // ================================================================
        // S2 -- write before bind -> NOT_BOUND.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        mov rdi, 60;
        call backlight_pwm_write;
        mov r11, 0xFFFFFE9F;             // BACKLIGHT_PWM_NOT_BOUND
        cmp rax, r11;
        jne blpwm_w_fail_stage;

        // ================================================================
        // S3 -- bind, bound()=1, arbitrated() still 0.
        // ================================================================
        mov rax, 30;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        call backlight_pwm_bind;
        cmp rax, 0;
        jne blpwm_w_fail_stage;

        call backlight_pwm_bound;
        cmp rax, 1;
        jne blpwm_w_fail_stage;

        call backlight_pwm_arbitrated;
        cmp rax, 0;
        jne blpwm_w_fail_stage;

        // ================================================================
        // S4 -- write after bind -> DEFERRED_HARDWARE.
        // ================================================================
        mov rax, 40;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        call backlight_pwm_writes;
        mov rbx, rax;                    // writes before

        mov rdi, 60;
        call backlight_pwm_write;
        mov r11, 0xFFFFFE9C;             // BACKLIGHT_PWM_DEFERRED_HARDWARE
        cmp rax, r11;
        jne blpwm_w_fail_stage;

        // ================================================================
        // S5 -- write(0x10000) -> BAD_LEVEL.
        // ================================================================
        mov rax, 50;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        mov rdi, 0x10000;
        call backlight_pwm_write;
        mov r11, 0xFFFFFE9E;             // BACKLIGHT_PWM_BAD_LEVEL
        cmp rax, r11;
        jne blpwm_w_fail_stage;

        // Boundary: level=0xFFFF admitted (deferred).
        mov rdi, 0xFFFF;
        call backlight_pwm_write;
        mov r11, 0xFFFFFE9C;
        cmp rax, r11;
        jne blpwm_w_fail_stage;

        // ================================================================
        // S6 -- writes() moved.
        // ================================================================
        mov rax, 60;
        lea rcx, [rip + _blpwm_w_stage];
        mov [rcx], rax;

        call backlight_pwm_writes;
        sub rax, rbx;
        cmp rax, 2;                      // S4 + S5's boundary
        jne blpwm_w_fail_stage;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + blpwm_w_ok];
        call klog_s1;
        xor rax, rax;
        jmp blpwm_w_out;

      blpwm_w_fail_stage:
        lea rax, [rip + _blpwm_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + blpwm_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      blpwm_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
