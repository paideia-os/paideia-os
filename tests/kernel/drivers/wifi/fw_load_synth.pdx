// tests/kernel/drivers/wifi/fw_load_synth.pdx — R38.M1-003 (#1292)
//
// Boot witness for fw_load.  Asserts precondition gates
// (NOT_VERIFIED, NOT_COMPATIBLE), ALREADY_LOADED refusal,
// ALIVE_TIMEOUT (INIT_ALIVE bit never set), the happy path with
// stamped INIT_ALIVE, and CSR echoes for the two uploaded sections
// plus the CPU_HALT release edge.
//
// Fingerprint: WIFI FW LOAD OK

module FwLoadSynth = structure {

  pub let mut _wflw_stage : u64 = 0

  pub let wflw_ok   : [u8; 18] = "WIFI FW LOAD OK\n\0"
  pub let wflw_fail : [u8; 20] = "WIFI FW LOAD FAIL\n\0"

  // A well-formed bundle whose section lengths sit INSIDE the
  // fw_compat matrix row for hw_type 0x105 (umac in [0x80000,
  // 0x180000], mvm in [0x40000, 0xC0000]).  Storage sized so
  // umac_off + umac_len and mvm_off + mvm_len both fit:
  //   umac_off = 0x40, umac_len = 0x80000  -> ends at 0x80040
  //   mvm_off  = 0x80040, mvm_len = 0x40000 -> ends at 0xC0040
  //   blob_len declared = 0xC0100
  //   backing storage = [u64; 131072] = 1 MiB (0x100000 bytes)
  //
  // The digest reads read two u64s at umac_off and two at mvm_off;
  // both offsets sit inside the 1 MiB storage, so the reads are
  // in-bounds.
  pub let mut _wflw_blob : [u64; 131072] = uninit @align(64)

  pub let wfl_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M1-003 (#1292): boot witness. Stages: (1) reset all three modules + arbitration pin + bundle prep. (2) NOT_VERIFIED before verify. (3) verify a compat-shaped bundle. (4) NOT_COMPATIBLE (hw_rev whose chip-type nibble is absent from matrix). (5) ALIVE_TIMEOUT (INIT_ALIVE never set). (6) reset + stamp ALIVE + reload happy. (7) CSR echoes. (8) ALREADY_LOADED. (9) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        call wfl_reset;
        call wfv_reset;
        call wcm_reset;

        // Zero the bundle header (16 u64s = 128 bytes).  Rest of
        // .bss is zero-init.
        lea r10, [rip + _wflw_blob];
        xor rax, rax;
        xor rcx, rcx;
      wflw_zhdr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wflw_zhdr;

        // Populate bundle header.
        // hdr [0] = (body 0xC0000) << 32 | magic 'IWLB' LE
        //         = 0x000C0000424C5749
        lea r10, [rip + _wflw_blob];
        mov rax, 0x000C0000424C5749;
        mov [r10 + 0], rax;

        // sig slots — non-zero.
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;              // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;             // vendor_sig[1]
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;             // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;             // paideia_sig[1]

        // slot 5 (@+40): umac_off = 0x40 | (umac_len = 0x80000)<<32
        //              = 0x0008000000000040
        mov rax, 0x0008000000000040;
        mov [r10 + 40], rax;
        // slot 6 (@+48): mvm_off  = 0x80040 | (mvm_len = 0x40000)<<32
        //              = 0x0004000000080040
        mov rax, 0x0004000000080040;
        mov [r10 + 48], rax;

        // Digest source words at umac_off = 0x40.
        mov rax, 0xDEADC0DEC0FEBABE;
        mov [r10 + 64], rax;             // umac[0]
        mov rax, 0xF00DFACEBAADFEED;
        mov [r10 + 72], rax;             // umac[1]

        // Digest source words at mvm_off = 0x80040.
        // Byte offset 0x80040 = 524352 (0x80040 dec).
        mov rax, 0xCAFEBEEFB16B00B5;
        mov [r10 + 524352], rax;         // mvm[0]
        mov rax, 0x1CEB00DA5AC001A5;
        mov [r10 + 524360], rax;         // mvm[1]

        call wfl_arbitrated;
        cmp rax, 0;
        jne wflw_fail_stage;

        // -- 2. NOT_VERIFIED before verify.
        mov rax, 2;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        // hw_rev whose type nibble (bits 19:8) = 0x510 (matches
        // matrix row 0).
        mov rdi, 0x00051000;
        call wfl_load;
        mov r11, 0xFFFFF4CE;             // NOT_VERIFIED
        cmp rax, r11;
        jne wflw_fail_stage;

        // -- 3. Verify the compat-shaped bundle.
        mov rax, 3;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wflw_blob];
        mov rsi, 0xC0100;
        call wfv_verify;
        cmp rax, 0;
        jne wflw_fail_stage;

        // -- 4. NOT_COMPATIBLE (hw_rev whose type nibble absent).
        mov rax, 4;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        // hw_rev with chip type nibble = 0xABC (not in matrix).
        mov rdi, 0x000ABC00;
        call wfl_load;
        mov r11, 0xFFFFF4CD;             // NOT_COMPATIBLE
        cmp rax, r11;
        jne wflw_fail_stage;

        // -- 5. ALIVE_TIMEOUT.
        // Currently INIT_ALIVE (CSR_INT bit 0) is clear, so a load
        // that reaches the poll times out.  hw_rev encodes hw_type = 0x510.
        mov rax, 5;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        call wfl_load;
        mov r11, 0xFFFFF4C9;             // ALIVE_TIMEOUT
        cmp rax, r11;
        jne wflw_fail_stage;

        // Iters counter shows the poll ran to the bound.
        call wfl_alive_iters_of;
        mov r11, 0x100000;
        cmp rax, r11;
        jne wflw_fail_stage;

        // The load was NOT successful.
        call wfl_is_loaded;
        cmp rax, 0;
        jne wflw_fail_stage;

        // -- 6. Reset load state, stamp ALIVE, retry.
        // wfl_reset_load_state clears CSR + loaded flag + alive-iters
        // WITHOUT clearing _wfl_stats -- the stage-9 counter fanout
        // asserts against the tallies accumulated by stages 2..5, and
        // a full wfl_reset would zero them.
        mov rax, 6;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        call wfl_reset_load_state;
        call wfl_csr_stamp_alive;

        mov rdi, 0x00051000;
        call wfl_load;
        cmp rax, 0;
        jne wflw_fail_stage;

        call wfl_is_loaded;
        cmp rax, 1;
        jne wflw_fail_stage;

        // Alive-iters is 0 (INIT_ALIVE was set before the poll).
        call wfl_alive_iters_of;
        cmp rax, 0;
        jne wflw_fail_stage;

        // -- 7. CSR echoes.
        mov rax, 7;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        // UMAC_ADDR echoed the SRAM base.
        mov rdi, 3;                      // WFL_CSR_UMAC_ADDR
        call wfl_csr_read;
        mov r11, 0x400000;
        cmp rax, r11;
        jne wflw_fail_stage;

        // UMAC_DIGEST = umac[0] XOR umac[1].
        mov rdi, 4;                      // WFL_CSR_UMAC_DIGEST
        call wfl_csr_read;
        mov r11, 0xDEADC0DEC0FEBABE;
        mov r10, 0xF00DFACEBAADFEED;
        xor r11, r10;
        cmp rax, r11;
        jne wflw_fail_stage;

        // MVM_ADDR echoed the SRAM base.
        mov rdi, 5;                      // WFL_CSR_MVM_ADDR
        call wfl_csr_read;
        mov r11, 0x800000;
        cmp rax, r11;
        jne wflw_fail_stage;

        // MVM_DIGEST = mvm[0] XOR mvm[1].
        mov rdi, 6;
        call wfl_csr_read;
        mov r11, 0xCAFEBEEFB16B00B5;
        mov r10, 0x1CEB00DA5AC001A5;
        xor r11, r10;
        cmp rax, r11;
        jne wflw_fail_stage;

        // CPU_HALT was released (CSR_RESET bit 0 clear).
        mov rdi, 0;                      // WFL_CSR_RESET
        call wfl_csr_read;
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        jne wflw_fail_stage;

        // Upload seq bumped.
        mov rdi, 7;                      // WFL_CSR_UPLOAD_SEQ
        call wfl_csr_read;
        cmp rax, 1;
        jne wflw_fail_stage;

        // -- 8. ALREADY_LOADED.
        mov rax, 8;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        call wfl_load;
        mov r11, 0xFFFFF4C8;             // ALREADY_LOADED
        cmp rax, r11;
        jne wflw_fail_stage;

        // -- 9. Counter fanout.
        mov rax, 9;
        lea rcx, [rip + _wflw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // LOADS
        call wfl_stat;
        cmp rax, 1;
        jne wflw_fail_stage;

        mov rdi, 1;                      // TIMEOUTS
        call wfl_stat;
        cmp rax, 1;                      // stage 5
        jne wflw_fail_stage;

        mov rdi, 2;                      // REFUSED
        call wfl_stat;
        // Refusals: NOT_VERIFIED (2), NOT_COMPATIBLE (4),
        // ALIVE_TIMEOUT (5), ALREADY_LOADED (8) = 4.
        cmp rax, 4;
        jne wflw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wflw_ok];
        call klog_s1;

        call wfl_reset;
        call wfv_reset;
        call wcm_reset;
        xor rax, rax;
        jmp wflw_out;

      wflw_fail_stage:
        lea rax, [rip + _wflw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wflw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wfl_reset;
        call wfv_reset;
        call wcm_reset;
        mov rax, 1;

      wflw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
