// tests/kernel/drivers/wifi/fw_compat_synth.pdx — R38.M1-004 (#1293)
//
// Boot witness for fw_compat.  Asserts matrix cell readback, hw
// lookup (hit + miss), and check_pair over the three shipping
// hw_type rows: happy path, UNKNOWN_HW refusal, BAD_UMAC_VER
// (below min / above max), BAD_MVM_VER (below min / above max),
// counter fanout and the arbitration honesty pin.
//
// Fingerprint: R38 WIFI FW COMPAT OK

module FwCompatSynth = structure {

  pub let mut _wcmw_stage : u64 = 0

  pub let wcmw_ok   : [u8; 24] = "R38 WIFI FW COMPAT OK\n\0"
  pub let wcmw_fail : [u8; 26] = "R38 WIFI FW COMPAT FAIL\n\0"

  pub let wcm_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M1-004 (#1293): boot witness. Stages: (1) reset + arbitration pin. (2) matrix cell readback + OUT_OF_RANGE. (3) lookup hit for all three shipping rows + miss. (4) happy path for 0x105 / 0x115 / 0x145 hw_type nibbles. (5) UNKNOWN_HW. (6) BAD_UMAC_VER below min. (7) BAD_UMAC_VER above max. (8) BAD_MVM_VER below min. (9) BAD_MVM_VER above max. (10) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        call wcm_reset;

        call wcm_arbitrated;
        cmp rax, 0;
        jne wcmw_fail_stage;

        // -- 2. Matrix cell readback + OUT_OF_RANGE.
        mov rax, 2;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        // row 0 hw_type = 0x510.
        mov rdi, 0;
        mov rsi, 0;
        call wcm_matrix_row_of;
        mov r11, 0x510;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // row 1 hw_type = 0x511.
        mov rdi, 1;
        mov rsi, 0;
        call wcm_matrix_row_of;
        mov r11, 0x511;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // row 2 hw_type = 0x540.
        mov rdi, 2;
        mov rsi, 0;
        call wcm_matrix_row_of;
        mov r11, 0x540;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // row 0 umac_min = 0x80000.
        mov rdi, 0;
        mov rsi, 1;
        call wcm_matrix_row_of;
        mov r11, 0x80000;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // row 0 mvm_max = 0xC0000.
        mov rdi, 0;
        mov rsi, 4;
        call wcm_matrix_row_of;
        mov r11, 0xC0000;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // out-of-range row.
        mov rdi, 3;
        mov rsi, 0;
        call wcm_matrix_row_of;
        mov r11, 0xFFFFF4BB;             // OUT_OF_RANGE
        cmp rax, r11;
        jne wcmw_fail_stage;

        // out-of-range col.
        mov rdi, 0;
        mov rsi, 5;
        call wcm_matrix_row_of;
        mov r11, 0xFFFFF4BB;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 3. Lookup hit for three shipping rows + miss.
        mov rax, 3;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x510;
        call wcm_lookup_hw;
        cmp rax, 0;
        jne wcmw_fail_stage;

        mov rdi, 0x511;
        call wcm_lookup_hw;
        cmp rax, 1;
        jne wcmw_fail_stage;

        mov rdi, 0x540;
        call wcm_lookup_hw;
        cmp rax, 2;
        jne wcmw_fail_stage;

        mov rdi, 0xABC;
        call wcm_lookup_hw;
        mov r11, 0xFFFFF4BE;             // UNKNOWN_HW
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 4. Happy path for the three hw_type nibbles (0x510,
        //       0x511, 0x540).  hw_rev must have the nibble in
        //       bits 19:8, i.e. (0x510 << 8) = 0x51000, etc.
        mov rax, 4;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        //  hw_rev = 0x00051000; umac 0x80000; mvm 0x40000 (min).
        mov rdi, 0x00051000;
        mov rsi, 0x80000;
        mov rdx, 0x40000;
        call wcm_check_pair;
        cmp rax, 0;
        jne wcmw_fail_stage;

        //  hw_rev = 0x00051100; umac 0x100000; mvm 0x80000 (mid).
        mov rdi, 0x00051100;
        mov rsi, 0x100000;
        mov rdx, 0x80000;
        call wcm_check_pair;
        cmp rax, 0;
        jne wcmw_fail_stage;

        //  hw_rev = 0x00054000; umac 0x180000; mvm 0xC0000 (max).
        mov rdi, 0x00054000;
        mov rsi, 0x180000;
        mov rdx, 0xC0000;
        call wcm_check_pair;
        cmp rax, 0;
        jne wcmw_fail_stage;

        // -- 5. UNKNOWN_HW (chip-type nibble outside matrix).
        mov rax, 5;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x000ABC00;
        mov rsi, 0x100000;
        mov rdx, 0x80000;
        call wcm_check_pair;
        mov r11, 0xFFFFF4BE;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 6. BAD_UMAC_VER below min (umac_len = 0x7FFFF).
        mov rax, 6;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        mov rsi, 0x7FFFF;
        mov rdx, 0x80000;
        call wcm_check_pair;
        mov r11, 0xFFFFF4BD;             // BAD_UMAC_VER
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 7. BAD_UMAC_VER above max (umac_len = 0x180001).
        mov rax, 7;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        mov rsi, 0x180001;
        mov rdx, 0x80000;
        call wcm_check_pair;
        mov r11, 0xFFFFF4BD;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 8. BAD_MVM_VER below min (mvm_len = 0x3FFFF).
        mov rax, 8;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        mov rsi, 0x100000;
        mov rdx, 0x3FFFF;
        call wcm_check_pair;
        mov r11, 0xFFFFF4BC;             // BAD_MVM_VER
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 9. BAD_MVM_VER above max (mvm_len = 0xC0001).
        mov rax, 9;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0x00051000;
        mov rsi, 0x100000;
        mov rdx, 0xC0001;
        call wcm_check_pair;
        mov r11, 0xFFFFF4BC;
        cmp rax, r11;
        jne wcmw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _wcmw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ADMITS
        call wcm_stat;
        cmp rax, 3;                      // three happy path admits
        jne wcmw_fail_stage;

        mov rdi, 1;                      // UNKNOWN_HW counter
        call wcm_stat;
        cmp rax, 1;                      // stage 5
        jne wcmw_fail_stage;

        mov rdi, 2;                      // BAD_UMAC counter
        call wcm_stat;
        cmp rax, 2;                      // stages 6 + 7
        jne wcmw_fail_stage;

        mov rdi, 3;                      // BAD_MVM counter
        call wcm_stat;
        cmp rax, 2;                      // stages 8 + 9
        jne wcmw_fail_stage;

        mov rdi, 4;                      // REFUSED counter
        call wcm_stat;
        // Refusals: 5 (UNKNOWN), 6 + 7 (BAD_UMAC), 8 + 9 (BAD_MVM) = 5.
        cmp rax, 5;
        jne wcmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wcmw_ok];
        call klog_s1;

        call wcm_reset;
        xor rax, rax;
        jmp wcmw_out;

      wcmw_fail_stage:
        lea rax, [rip + _wcmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wcmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wcm_reset;
        mov rax, 1;

      wcmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
