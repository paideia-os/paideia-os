// tests/kernel/drivers/wifi/fw_verify_synth.pdx — R38.M1-002 (#1291)
//
// Boot witness for fw_verify.  Asserts NULL/undersize/magic
// refusals, vendor-sig-empty refusal, paideia-sig-empty refusal,
// section-shape refusal, dual-sig happy path with section
// extents recorded, idempotent identity re-verify, swap refusal,
// counter fanout and the arbitration honesty pin.
//
// Fingerprint: WIFI FW VERIFY OK

module FwVerifySynth = structure {

  pub let mut _wfvw_stage : u64 = 0

  pub let wfvw_ok   : [u8; 20] = "WIFI FW VERIFY OK\0"
  pub let wfvw_fail : [u8; 22] = "WIFI FW VERIFY FAIL\0"

  // Blob layout (§1 of fw_verify.pdx). Represented as 16 u64s (128
  // bytes) so umac_off+umac_len and mvm_off+mvm_len both fit inside
  // the buffer when we build a good bundle.
  pub let mut _wfvw_blob_good        : [u64; 16] = uninit @align(64)
  pub let mut _wfvw_blob_no_vendor   : [u64; 16] = uninit @align(64)
  pub let mut _wfvw_blob_no_paideia  : [u64; 16] = uninit @align(64)
  pub let mut _wfvw_blob_bad_magic   : [u64; 16] = uninit @align(64)
  pub let mut _wfvw_blob_bad_secs    : [u64; 16] = uninit @align(64)

  pub let wfv_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M1-002 (#1291): boot witness. Stages: (1) reset + arbitration pin + blob prep. (2) NULL blob. (3) undersize. (4) bad magic. (5) vendor sig empty. (6) paideia sig empty. (7) bad sections (umac walks past blob_len). (8) happy path + row accessors. (9) idempotent same-bundle. (10) swap refusal. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        call wfv_reset;

        // Zero all five buffers.
        lea r10, [rip + _wfvw_blob_good];
        xor rax, rax;
        xor rcx, rcx;
      wfvw_zg:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wfvw_zg;

        lea r10, [rip + _wfvw_blob_no_vendor];
        xor rcx, rcx;
      wfvw_znv:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wfvw_znv;

        lea r10, [rip + _wfvw_blob_no_paideia];
        xor rcx, rcx;
      wfvw_znp:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wfvw_znp;

        lea r10, [rip + _wfvw_blob_bad_magic];
        xor rcx, rcx;
      wfvw_zbm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wfvw_zbm;

        lea r10, [rip + _wfvw_blob_bad_secs];
        xor rcx, rcx;
      wfvw_zbs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wfvw_zbs;

        // Populate good blob.
        //   hdr [0] = (body 0x40) << 32 | magic 'IWLB' LE 0x424C5749
        //   [1..4] two sig slots (u64 pairs) — non-zero
        //   [5] umac_off (u32 @+40) | umac_len (u32 @+44)
        //   [6] mvm_off  (u32 @+48) | mvm_len  (u32 @+52)
        //   [7..15] body (opaque payload the digest reads)
        //
        // Section offsets: umac_off = 0x40, umac_len = 0x10;
        //                  mvm_off  = 0x50, mvm_len  = 0x10.
        // These land inside the 128-byte blob (umac 0x40..0x4F,
        // mvm 0x50..0x5F).
        lea r10, [rip + _wfvw_blob_good];
        mov rax, 0x00000040424C5749;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;              // vendor_sig[0]
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;             // vendor_sig[1]
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;             // paideia_sig[0]
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;             // paideia_sig[1]
        // slot 5 (@+40): umac_off = 0x40, umac_len = 0x10
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;
        // slot 6 (@+48): mvm_off  = 0x50, mvm_len  = 0x10
        mov rax, 0x0000001000000050;
        mov [r10 + 48], rax;
        // Body words (readable at umac_off / mvm_off).
        mov rax, 0xDEADC0DEC0FEBABE;
        mov [r10 + 64], rax;             // umac word 0
        mov rax, 0xF00DFACEBAADFEED;
        mov [r10 + 72], rax;             // umac word 1
        mov rax, 0xCAFEBEEFB16B00B5;
        mov [r10 + 80], rax;             // mvm word 0
        mov rax, 0x1CEB00DA5AC001A5;
        mov [r10 + 88], rax;             // mvm word 1

        // no_vendor: valid header + section words, empty vendor.
        lea r10, [rip + _wfvw_blob_no_vendor];
        mov rax, 0x00000040424C5749;
        mov [r10 + 0], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;
        mov rax, 0x0000001000000050;
        mov [r10 + 48], rax;

        // no_paideia: valid header + section words, empty paideia.
        lea r10, [rip + _wfvw_blob_no_paideia];
        mov rax, 0x00000040424C5749;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;
        mov rax, 0x0000001000000050;
        mov [r10 + 48], rax;

        // bad_magic: wrong-magic header + both sig slots set +
        // valid section extents (so we can prove the magic check
        // catches it BEFORE the sig checks would).
        lea r10, [rip + _wfvw_blob_bad_magic];
        mov rax, 0x00000040DEADBEEF;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;

        // bad_secs: valid header + sigs, mvm_off + mvm_len walks
        // past blob_len (mvm_off = 0x50, mvm_len = 0xFF00 -> ends
        // at 0xFF50 which is > blob_len = 0x80).
        lea r10, [rip + _wfvw_blob_bad_secs];
        mov rax, 0x00000040424C5749;
        mov [r10 + 0], rax;
        mov rax, 0xAAAA1111BBBB2222;
        mov [r10 + 8], rax;
        mov rax, 0xCCCC3333DDDD4444;
        mov [r10 + 16], rax;
        mov rax, 0xEEEE5555FFFF6666;
        mov [r10 + 24], rax;
        mov rax, 0x1111777722228888;
        mov [r10 + 32], rax;
        // umac ok.
        mov rax, 0x0000001000000040;
        mov [r10 + 40], rax;
        // mvm walks off.
        mov rax, 0x0000FF0000000050;
        mov [r10 + 48], rax;

        call wfv_arbitrated;
        cmp rax, 0;
        jne wfvw_fail_stage;

        // -- 2. NULL blob.
        mov rax, 2;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4DA;             // NULL_BLOB
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 3. Undersize.
        mov rax, 3;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_good];
        mov rsi, 0x37;                   // one below header size
        call wfv_verify;
        mov r11, 0xFFFFF4DE;             // TOO_SMALL
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 4. Bad magic.
        mov rax, 4;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_bad_magic];
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4DD;             // BAD_MAGIC
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 5. Vendor sig empty.
        mov rax, 5;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_no_vendor];
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4DC;             // BAD_VENDOR_SIG
        cmp rax, r11;
        jne wfvw_fail_stage;

        // Standalone helper agrees.
        lea rdi, [rip + _wfvw_blob_no_vendor];
        mov rsi, 0x80;
        call wfv_verify_vendor;
        mov r11, 0xFFFFF4DC;
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 6. Paideia sig empty.
        mov rax, 6;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_no_paideia];
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4DB;             // BAD_PAIDEIA_SIG
        cmp rax, r11;
        jne wfvw_fail_stage;

        lea rdi, [rip + _wfvw_blob_no_paideia];
        mov rsi, 0x80;
        call wfv_verify_paideia;
        mov r11, 0xFFFFF4DB;
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 7. Bad sections (mvm walks past blob_len).
        mov rax, 7;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_bad_secs];
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4D9;             // BAD_SECTIONS
        cmp rax, r11;
        jne wfvw_fail_stage;

        // Precondition: nothing has succeeded.
        call wfv_is_verified;
        cmp rax, 0;
        jne wfvw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_good];
        mov rsi, 0x80;
        call wfv_verify;
        cmp rax, 0;
        jne wfvw_fail_stage;

        call wfv_is_verified;
        cmp rax, 1;
        jne wfvw_fail_stage;

        call wfv_blob_ptr_of;
        lea r11, [rip + _wfvw_blob_good];
        cmp rax, r11;
        jne wfvw_fail_stage;

        call wfv_blob_len_of;
        cmp rax, 0x80;
        jne wfvw_fail_stage;

        call wfv_umac_off_of;
        cmp rax, 0x40;
        jne wfvw_fail_stage;

        call wfv_umac_len_of;
        cmp rax, 0x10;
        jne wfvw_fail_stage;

        call wfv_mvm_off_of;
        cmp rax, 0x50;
        jne wfvw_fail_stage;

        call wfv_mvm_len_of;
        cmp rax, 0x10;
        jne wfvw_fail_stage;

        // -- 9. Idempotent same-bundle.
        mov rax, 9;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_good];
        mov rsi, 0x80;
        call wfv_verify;
        cmp rax, 0;
        jne wfvw_fail_stage;

        // -- 10. Swap refusal.
        mov rax, 10;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        lea rdi, [rip + _wfvw_blob_no_vendor];
        mov rsi, 0x80;
        call wfv_verify;
        mov r11, 0xFFFFF4DF;             // BAD_ARG
        cmp rax, r11;
        jne wfvw_fail_stage;

        lea rdi, [rip + _wfvw_blob_good];
        mov rsi, 0x81;
        call wfv_verify;
        mov r11, 0xFFFFF4DF;
        cmp rax, r11;
        jne wfvw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _wfvw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // VERIFIED
        call wfv_stat;
        cmp rax, 1;
        jne wfvw_fail_stage;

        mov rdi, 1;                      // VENDOR_MISS
        call wfv_stat;
        cmp rax, 1;
        jne wfvw_fail_stage;

        mov rdi, 2;                      // PAIDEIA_MISS
        call wfv_stat;
        cmp rax, 1;
        jne wfvw_fail_stage;

        mov rdi, 4;                      // SECTION_MISS
        call wfv_stat;
        cmp rax, 1;
        jne wfvw_fail_stage;

        mov rdi, 3;                      // REFUSED
        call wfv_stat;
        // NULL (2), TOO_SMALL (3), BAD_MAGIC (4), BAD_VENDOR (5),
        // BAD_PAIDEIA (6), BAD_SECTIONS (7), BAD_ARG (10 twice) = 8.
        cmp rax, 8;
        jne wfvw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wfvw_ok];
        call klog_s1;

        call wfv_reset;
        xor rax, rax;
        jmp wfvw_out;

      wfvw_fail_stage:
        lea rax, [rip + _wfvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wfvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wfv_reset;
        mov rax, 1;

      wfvw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
