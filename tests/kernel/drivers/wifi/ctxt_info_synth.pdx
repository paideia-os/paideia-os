// tests/kernel/drivers/wifi/ctxt_info_synth.pdx — R38.M2-001 (#1294)
//
// Boot witness for ctxt_info.  Asserts reset zeroing, arbitration
// pin, CTXT_INFO field access + BAD_FIELD refusal, index access +
// INDEX_OOR refusal, init round-trip, TX slot write + read + OOR,
// RX slot write + read + OOR, ring-geometry arithmetic (empty /
// full / inflight over free-running counters), counter fanout.
//
// Fingerprint: WIFI CTXT INFO OK

module CtxtInfoSynth = structure {

  pub let mut _wctxw_stage : u64 = 0

  pub let wctxw_ok   : [u8; 19] = "WIFI CTXT INFO OK\n\0"
  pub let wctxw_fail : [u8; 21] = "WIFI CTXT INFO FAIL\n\0"

  pub let wctx_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M2-001 (#1294): boot witness. Stages: (1) reset + arbitration + zero state. (2) CTXT_INFO field set/get + BAD_FIELD. (3) index set/get + INDEX_OOR. (4) init round-trip. (5) TX slot write + read + OOR. (6) RX slot write + read + OOR. (7) ring-geometry: empty + partial + full over free-running counters. (8) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        call wctx_reset;

        call wctx_arbitrated;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // After reset every field/index is 0.
        mov rdi, 0;                       // WCTX_INFO_VERSION
        call wctx_info_get;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;                       // WCTX_IDX_TX_HEAD
        call wctx_index_get;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;                       // slot 0 TX addr
        call wctx_tx_slot_addr;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;                       // slot 0 RX bda
        call wctx_rx_slot_get;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // -- 2. CTXT_INFO field access.
        mov rax, 2;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // VERSION
        mov rsi, 0xC0DEBEEF;
        call wctx_info_set;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;
        call wctx_info_get;
        mov r11, 0xC0DEBEEF;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // BAD_FIELD (field 8 == WCTX_INFO_FIELDS).
        mov rdi, 8;
        mov rsi, 0x1234;
        call wctx_info_set;
        mov r11, 0xFFFFF4AB;              // WCTX_BAD_FIELD
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 8;
        call wctx_info_get;
        mov r11, 0xFFFFF4AB;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // -- 3. Index set/get + OOR.
        mov rax, 3;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // TX_HEAD
        mov rsi, 42;
        call wctx_index_set;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;
        call wctx_index_get;
        cmp rax, 42;
        jne wctxw_fail_stage;

        // OOR (slot 8 == WCTX_IDX_SLOTS).
        mov rdi, 8;
        mov rsi, 99;
        call wctx_index_set;
        mov r11, 0xFFFFF4AE;              // WCTX_INDEX_OOR
        cmp rax, r11;
        jne wctxw_fail_stage;

        // Get out-of-range returns 0.
        mov rdi, 8;
        call wctx_index_get;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // -- 4. Init round-trip.  Reset first so counters are clean.
        mov rax, 4;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        call wctx_reset;

        mov rdi, 0x00030002;              // version
        mov rsi, 0x00100000;              // img_size (1 MiB)
        mov rdx, 0x100;                   // page_count (256 pages)
        mov rcx, 0xC0000000;              // tx_bda
        mov r8,  0xC0100000;              // rx_bda
        call wctx_init;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // Fields read back.
        mov rdi, 0;                       // VERSION
        call wctx_info_get;
        mov r11, 0x00030002;
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 2;                       // IMG_SIZE
        call wctx_info_get;
        mov r11, 0x00100000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 3;                       // PAGE_COUNT
        call wctx_info_get;
        cmp rax, 0x100;
        jne wctxw_fail_stage;

        mov rdi, 4;                       // TR_BDA
        call wctx_info_get;
        mov r11, 0xC0000000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 5;                       // RX_BDA
        call wctx_info_get;
        mov r11, 0xC0100000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // Index slots 4 (TX_RING_BDA) and 5 (RX_RING_BDA) mirror.
        mov rdi, 4;
        call wctx_index_get;
        mov r11, 0xC0000000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 5;
        call wctx_index_get;
        mov r11, 0xC0100000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // -- 5. TX slot write + read.
        mov rax, 5;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        // Slot 0.
        mov rdi, 0;
        mov rsi, 0xDEADBEEF00001000;
        mov rdx, 0x1234000000005678;
        call wctx_tx_slot_write;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 0;
        call wctx_tx_slot_addr;
        mov r11, 0xDEADBEEF00001000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        mov rdi, 0;
        call wctx_tx_slot_lenflags;
        mov r11, 0x1234000000005678;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // Slot 255 (last valid).
        mov rdi, 255;
        mov rsi, 0xAAAABBBBCCCCDDDD;
        mov rdx, 0x1111222233334444;
        call wctx_tx_slot_write;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 255;
        call wctx_tx_slot_addr;
        mov r11, 0xAAAABBBBCCCCDDDD;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // OOR (slot 256).
        mov rdi, 256;
        mov rsi, 0;
        mov rdx, 0;
        call wctx_tx_slot_write;
        mov r11, 0xFFFFF4AE;              // WCTX_INDEX_OOR
        cmp rax, r11;
        jne wctxw_fail_stage;

        // Reads at OOR return 0.
        mov rdi, 256;
        call wctx_tx_slot_addr;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // -- 6. RX slot write + read + OOR.
        mov rax, 6;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        mov rdi, 5;
        mov rsi, 0xFACEB00C00002000;
        call wctx_rx_slot_write;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 5;
        call wctx_rx_slot_get;
        mov r11, 0xFACEB00C00002000;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // OOR write.
        mov rdi, 256;
        mov rsi, 0x1;
        call wctx_rx_slot_write;
        mov r11, 0xFFFFF4AE;
        cmp rax, r11;
        jne wctxw_fail_stage;

        // -- 7. Ring geometry.  head == tail -> EMPTY.  head - tail
        //       == 256 -> FULL.  Free-running counter simulation.
        mov rax, 7;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        // Empty.
        mov rdi, 100;
        mov rsi, 100;
        call wctx_tx_is_empty;
        cmp rax, 1;
        jne wctxw_fail_stage;

        mov rdi, 100;
        mov rsi, 100;
        call wctx_tx_is_full;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // Partial: 10 in flight.
        mov rdi, 110;
        mov rsi, 100;
        call wctx_tx_inflight;
        cmp rax, 10;
        jne wctxw_fail_stage;

        mov rdi, 110;
        mov rsi, 100;
        call wctx_tx_is_full;
        cmp rax, 0;
        jne wctxw_fail_stage;

        mov rdi, 110;
        mov rsi, 100;
        call wctx_tx_is_empty;
        cmp rax, 0;
        jne wctxw_fail_stage;

        // Full: head - tail == 256.
        mov rdi, 356;
        mov rsi, 100;
        call wctx_tx_is_full;
        cmp rax, 1;
        jne wctxw_fail_stage;

        // -- 8. Counter fanout.
        mov rax, 8;
        lea rcx, [rip + _wctxw_stage];
        mov [rcx], rax;

        // Stage 4 called wctx_reset so counters from stages 2-3 are
        // cleared.  From stage 4 onward:
        //   INITS: 1 (stage 4)
        //   TX_WRITES: 2 (slot 0 + slot 255) — OOR at slot 256 does not bump
        //   RX_WRITES: 1 (slot 5) — OOR does not bump
        //   FIELD_SETS: 0 (stage 4's wctx_init does not use wctx_info_set;
        //     it writes directly and bumps INITS instead)
        //   REFUSED: TX OOR (1) + RX OOR (1) = 2
        mov rdi, 0;                       // WCTX_STAT_INITS
        call wctx_stat;
        cmp rax, 1;
        jne wctxw_fail_stage;

        mov rdi, 1;                       // WCTX_STAT_TX_WRITES
        call wctx_stat;
        cmp rax, 2;
        jne wctxw_fail_stage;

        mov rdi, 2;                       // WCTX_STAT_RX_WRITES
        call wctx_stat;
        cmp rax, 1;
        jne wctxw_fail_stage;

        mov rdi, 4;                       // WCTX_STAT_REFUSED
        call wctx_stat;
        cmp rax, 2;
        jne wctxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wctxw_ok];
        call klog_s1;

        call wctx_reset;
        xor rax, rax;
        jmp wctxw_out;

      wctxw_fail_stage:
        lea rax, [rip + _wctxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wctxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wctx_reset;
        mov rax, 1;

      wctxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
