// tests/kernel/drivers/wifi/net80211_regdom_synth.pdx — R38.M4-005 (#1308)
//
// Boot witness for net80211_regdom.  Exercises: unbound refuses,
// direct bind (US/EU/JP), UNKNOWN refused, bind_from_phy against
// an empty PHY table (UNKNOWN via sentinel), channel_allowed +
// tx_check + switch_check for a US-bound domain (ch 1 OK, ch 12
// forbidden), rebind refused, EU-bound admits ch 12, JP-bound
// admits ch 14, invalid channel refused, counter fanout.
//
// Fingerprint: NET80211 REGDOM OK

module Net80211RegdomSynth = structure {

  pub let mut _nrdw_stage : u64 = 0

  pub let nrdw_ok   : [u8; 20] = "NET80211 REGDOM OK\n\0"
  pub let nrdw_fail : [u8; 22] = "NET80211 REGDOM FAIL\n\0"

  pub let nrd_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M4-005 (#1308): boot witness. Stages: (1) reset + arbitration pin + unbound. (2) NOT_BOUND on tx_check + switch_check. (3) UNKNOWN_REGDOM on bind(99) + bind_from_phy on empty PHY table. (4) US bind + verify. (5) ALREADY_BOUND. (6) unbind + double unbind refused. (7) US: ch 1 allowed, ch 12 forbidden, ch 15 BAD_CHANNEL. (8) EU: ch 12 allowed. (9) JP: ch 14 allowed. (10) switch_check parallels tx_check. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + unbound state.
        mov rax, 1;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        call nrd_reset;

        call nrd_arbitrated;
        cmp rax, 0;
        jne nrdw_fail_stage;

        call nrd_bound;
        cmp rax, 0;
        jne nrdw_fail_stage;

        call nrd_regdom;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 2. NOT_BOUND on tx_check + switch_check.
        mov rax, 2;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // ch 1
        call nrd_tx_check;
        mov r11, 0xFFFFF3FE;              // NOT_BOUND
        cmp rax, r11;
        jne nrdw_fail_stage;

        mov rdi, 1;
        call nrd_switch_check;
        mov r11, 0xFFFFF3FE;
        cmp rax, r11;
        jne nrdw_fail_stage;

        // channel_allowed returns 0 unbound.
        mov rdi, 1;
        call nrd_channel_allowed;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 3. UNKNOWN_REGDOM: bind(99) and bind_from_phy on empty PHY.
        mov rax, 3;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 99;
        call nrd_bind;
        mov r11, 0xFFFFF3FD;              // UNKNOWN_REGDOM
        cmp rax, r11;
        jne nrdw_fail_stage;

        // bind_from_phy against a row the wifi_phy table doesn't
        // have valid.  wphy_row_regdom returns the caps-layer
        // sentinel; nrd_bind_from_phy maps it to UNKNOWN_REGDOM.
        // We don't reset the wifi_phy table here (that belongs to
        // wifi_phy_witness); we exploit the fact that row_id 200
        // is out of range.
        mov rdi, 200;
        call nrd_bind_from_phy;
        mov r11, 0xFFFFF3FD;
        cmp rax, r11;
        jne nrdw_fail_stage;

        // Still unbound.
        call nrd_bound;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 4. US bind + verify.
        mov rax, 4;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // NRD_DOMAIN_US
        call nrd_bind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        call nrd_bound;
        cmp rax, 1;
        jne nrdw_fail_stage;

        call nrd_regdom;
        cmp rax, 1;
        jne nrdw_fail_stage;

        // -- 5. ALREADY_BOUND refuses second bind.
        mov rax, 5;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 2;                       // EU
        call nrd_bind;
        mov r11, 0xFFFFF3FB;
        cmp rax, r11;
        jne nrdw_fail_stage;

        // Regdom unchanged.
        call nrd_regdom;
        cmp rax, 1;
        jne nrdw_fail_stage;

        // -- 6. Unbind + double unbind refused.
        mov rax, 6;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        call nrd_unbind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        call nrd_unbind;
        mov r11, 0xFFFFF3FE;              // NOT_BOUND
        cmp rax, r11;
        jne nrdw_fail_stage;

        call nrd_bound;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 7. US channel gating.
        mov rax, 7;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // US
        call nrd_bind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // ch 1 allowed.
        mov rdi, 1;
        call nrd_channel_allowed;
        cmp rax, 1;
        jne nrdw_fail_stage;

        // ch 11 allowed.
        mov rdi, 11;
        call nrd_channel_allowed;
        cmp rax, 1;
        jne nrdw_fail_stage;

        // ch 12 forbidden.
        mov rdi, 12;
        call nrd_channel_allowed;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // tx_check ch 1 admits.
        mov rdi, 1;
        call nrd_tx_check;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // tx_check ch 12 forbidden.
        mov rdi, 12;
        call nrd_tx_check;
        mov r11, 0xFFFFF3FC;              // CHANNEL_FORBIDDEN
        cmp rax, r11;
        jne nrdw_fail_stage;

        // tx_check ch 15 (invalid: > 14) BAD_CHANNEL.
        mov rdi, 15;
        call nrd_tx_check;
        mov r11, 0xFFFFF3FA;              // BAD_CHANNEL
        cmp rax, r11;
        jne nrdw_fail_stage;

        // tx_check ch 0 (invalid: < 1) BAD_CHANNEL.
        mov rdi, 0;
        call nrd_tx_check;
        mov r11, 0xFFFFF3FA;
        cmp rax, r11;
        jne nrdw_fail_stage;

        // -- 8. EU: ch 12 allowed.
        mov rax, 8;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        call nrd_unbind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        mov rdi, 2;                       // EU
        call nrd_bind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        mov rdi, 12;
        call nrd_channel_allowed;
        cmp rax, 1;
        jne nrdw_fail_stage;

        mov rdi, 13;
        call nrd_channel_allowed;
        cmp rax, 1;
        jne nrdw_fail_stage;

        mov rdi, 14;
        call nrd_channel_allowed;
        cmp rax, 0;
        jne nrdw_fail_stage;

        mov rdi, 12;
        call nrd_tx_check;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 9. JP: ch 14 allowed.
        mov rax, 9;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        call nrd_unbind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        mov rdi, 3;                       // JP
        call nrd_bind;
        cmp rax, 0;
        jne nrdw_fail_stage;

        mov rdi, 14;
        call nrd_channel_allowed;
        cmp rax, 1;
        jne nrdw_fail_stage;

        mov rdi, 14;
        call nrd_tx_check;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // -- 10. switch_check parallels tx_check.
        mov rax, 10;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        mov rdi, 14;
        call nrd_switch_check;
        cmp rax, 0;
        jne nrdw_fail_stage;

        // switch to ch 20 (invalid).
        mov rdi, 20;
        call nrd_switch_check;
        mov r11, 0xFFFFF3FA;
        cmp rax, r11;
        jne nrdw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _nrdw_stage];
        mov [rcx], rax;

        // BINDS >= 3 (stages 4, 7, 8, 9).
        mov rdi, 0;
        call nrd_stat;
        cmp rax, 3;
        jb  nrdw_fail_stage;

        // UNBINDS >= 3 (stages 6, 8, 9).
        mov rdi, 1;
        call nrd_stat;
        cmp rax, 3;
        jb  nrdw_fail_stage;

        // TX_CHECKS >= 4.
        mov rdi, 2;
        call nrd_stat;
        cmp rax, 4;
        jb  nrdw_fail_stage;

        // TX_ADMITS >= 3.
        mov rdi, 3;
        call nrd_stat;
        cmp rax, 3;
        jb  nrdw_fail_stage;

        // TX_REFUSED >= 4 (stages 2, 7 x3).
        mov rdi, 4;
        call nrd_stat;
        cmp rax, 4;
        jb  nrdw_fail_stage;

        // SWITCH_CHECKS >= 3.
        mov rdi, 5;
        call nrd_stat;
        cmp rax, 3;
        jb  nrdw_fail_stage;

        // SWITCH_REFUSED >= 2 (stages 2, 10).
        mov rdi, 6;
        call nrd_stat;
        cmp rax, 2;
        jb  nrdw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nrdw_ok];
        call klog_s1;

        call nrd_reset;
        xor rax, rax;
        jmp nrdw_out;

      nrdw_fail_stage:
        lea rax, [rip + _nrdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nrdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nrd_reset;
        mov rax, 1;

      nrdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
