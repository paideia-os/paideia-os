// tests/kernel/drivers/wifi/wpa3_sae_synth.pdx — R38.M5-002 (#1310)
//
// Boot witness for the WPA3 SAE state machine.  Asserts:
//   (1) sae_reset yields INIT + all fields zero;
//   (2) sae_start(0) refused as ZERO_COMMIT;
//   (3) sae_start(v) admits INIT -> COMMITTED, stores v;
//   (4) sae_start(v) while COMMITTED refused as BUSY;
//   (5) sae_peer_commit refused when scalar or confirm zero, or
//       state != COMMITTED;
//   (6) sae_peer_commit COMMITTED -> CONFIRMED;
//   (7) sae_peer_confirm with matching value -> ACCEPTED;
//   (8) MISMATCH path: reset + replay to CONFIRMED, then wrong
//       kck_value -> FAILED with CONFIRM_MISMATCH.
//
// Fingerprint: WPA3 SAE OK

module Wpa3SaeSynth = structure {

  pub let mut _saew_stage : u64 = 0

  pub let saew_ok   : [u8; 12] = "WPA3 SAE OK\0"
  pub let saew_fail : [u8; 14] = "WPA3 SAE FAIL\0"

  pub let wpa3_sae_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M5-002 (#1310): boot witness. Stages: (1) reset. (2) start(0) refused. (3) start(v) INIT->COMMITTED. (4) start while COMMITTED BUSY. (5) peer_commit refused (state / zero args). (6) peer_commit COMMITTED->CONFIRMED. (7) peer_confirm match -> ACCEPTED. (8) MISMATCH -> FAILED.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        // -- 1. Reset.
        call sae_reset;
        call sae_state;
        cmp rax, 0;                      // INIT
        jne saew_fail_stage;

        // -- 2. start(0) refused.
        mov rax, 2;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call sae_start;
        mov r11, 0xFFFFF3DD;             // ZERO_COMMIT
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 3. start(v) INIT -> COMMITTED.
        mov rax, 3;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE01;
        call sae_start;
        cmp rax, 0;
        jne saew_fail_stage;

        call sae_state;
        cmp rax, 1;                      // COMMITTED
        jne saew_fail_stage;

        call sae_local_commit;
        mov r11, 0xC0FFEE01;
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 4. start while COMMITTED refused as BUSY.
        mov rax, 4;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0xC0FFEE02;
        call sae_start;
        mov r11, 0xFFFFF3D9;             // BUSY
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 5a. peer_commit(scalar=0) refused.
        mov rax, 5;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0xDEAD;
        call sae_peer_commit;
        mov r11, 0xFFFFF3DB;             // ZERO_SCALAR
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 5b. peer_commit(scalar, confirm=0) refused.
        mov rdi, 0xBEEF;
        mov rsi, 0;
        call sae_peer_commit;
        mov r11, 0xFFFFF3DC;             // ZERO_CONFIRM
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 6. peer_commit COMMITTED -> CONFIRMED.
        mov rax, 6;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0xBEEF00CA;
        mov rsi, 0xEEEEEEEE;
        call sae_peer_commit;
        cmp rax, 0;
        jne saew_fail_stage;

        call sae_state;
        cmp rax, 2;                      // CONFIRMED
        jne saew_fail_stage;

        call sae_peer_scalar_get;
        mov r11, 0xBEEF00CA;
        cmp rax, r11;
        jne saew_fail_stage;

        call sae_expected_confirm;
        mov r11, 0xEEEEEEEE;
        cmp rax, r11;
        jne saew_fail_stage;

        // 5c: peer_commit while CONFIRMED refused with INVALID_TRANSITION.
        mov rdi, 0x1234;
        mov rsi, 0x5678;
        call sae_peer_commit;
        mov r11, 0xFFFFF3D8;             // INVALID_TRANSITION
        cmp rax, r11;
        jne saew_fail_stage;

        // -- 7. peer_confirm(match) -> ACCEPTED.
        mov rax, 7;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        mov rdi, 0xEEEEEEEE;
        call sae_peer_confirm;
        cmp rax, 0;
        jne saew_fail_stage;

        call sae_state;
        cmp rax, 3;                      // ACCEPTED
        jne saew_fail_stage;

        // -- 8. MISMATCH -> FAILED.
        mov rax, 8;
        lea rcx, [rip + _saew_stage];
        mov [rcx], rax;

        call sae_reset;

        mov rdi, 0xAA00;
        call sae_start;
        cmp rax, 0;
        jne saew_fail_stage;

        mov rdi, 0xBB00;
        mov rsi, 0xCC00;
        call sae_peer_commit;
        cmp rax, 0;
        jne saew_fail_stage;

        // Wrong kck_value -> MISMATCH + FAILED.
        mov rdi, 0xDEAD;
        call sae_peer_confirm;
        mov r11, 0xFFFFF3DA;             // CONFIRM_MISMATCH
        cmp rax, r11;
        jne saew_fail_stage;

        call sae_state;
        cmp rax, 4;                      // FAILED
        jne saew_fail_stage;

        // start from FAILED is BUSY.
        mov rdi, 0x1234;
        call sae_start;
        mov r11, 0xFFFFF3D9;             // BUSY
        cmp rax, r11;
        jne saew_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + saew_ok];
        call klog_s1;

        call sae_reset;
        xor rax, rax;
        jmp saew_out;

      saew_fail_stage:
        lea rax, [rip + _saew_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + saew_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sae_reset;
        mov rax, 1;

      saew_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
