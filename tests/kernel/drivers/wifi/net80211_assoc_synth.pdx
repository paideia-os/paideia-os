// tests/kernel/drivers/wifi/net80211_assoc_synth.pdx — R38.M4-002 (#1305)
//
// Boot witness for net80211_assoc.  Exercises the full state
// machine: happy UNAUTH -> AUTH -> ASSOC -> CONNECTED, roaming
// via nas_reassoc, deauth from every state clearing BSSID,
// AUTH without target BSSID, invalid transitions, BAD_EVENT,
// BAD_BSSID, ASSOC timeout falling back to AUTH.
//
// Fingerprint: NET80211 ASSOC OK

module Net80211AssocSynth = structure {

  pub let mut _nasw_stage : u64 = 0

  pub let nasw_ok   : [u8; 19] = "NET80211 ASSOC OK\0"
  pub let nasw_fail : [u8; 21] = "NET80211 ASSOC FAIL\0"

  pub let nas_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M4-002 (#1305): boot witness. Stages: (1) reset + arbitration pin + UNAUTH. (2) NO_BSSID: AUTH_REQ before set_target_bssid. (3) BAD_BSSID (zero + bits above 48). (4) Happy sequence -> CONNECTED, BSSID pinned. (5) Reassoc drops to ASSOC + pins new BSSID + completes on REASSOC_RESP. (6) Deauth from CONNECTED -> UNAUTH + BSSID cleared. (7) Invalid transitions from each state. (8) BAD_EVENT (id > MAX). (9) ASSOC + TIMEOUT -> AUTH fallback. (10) ALREADY_CONNECTED refuses set_target_bssid. (11) DEAUTH idempotent from UNAUTH. (12) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + initial state UNAUTH.
        mov rax, 1;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        call nas_reset;

        call nas_arbitrated;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 0;                       // UNAUTH
        jne nasw_fail_stage;

        call nas_bssid;
        cmp rax, 0;
        jne nasw_fail_stage;

        // -- 2. NO_BSSID.
        mov rax, 2;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // AUTH_REQ
        call nas_step;
        mov r11, 0xFFFFF41B;              // NAS_NO_BSSID
        cmp rax, r11;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 0;
        jne nasw_fail_stage;

        // -- 3. BAD_BSSID: zero, > 48-bit.
        mov rax, 3;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call nas_set_target_bssid;
        mov r11, 0xFFFFF41C;
        cmp rax, r11;
        jne nasw_fail_stage;

        mov rdi, 0x0100000000000000;      // bit 56 set
        call nas_set_target_bssid;
        mov r11, 0xFFFFF41C;
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A0B0C0D0E0;          // valid BSSID
        call nas_set_target_bssid;
        cmp rax, 0;
        jne nasw_fail_stage;

        mov rdi, 0;                       // AUTH_REQ
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 1;                       // AUTH
        jne nasw_fail_stage;

        call nas_bssid;
        mov r11, 0x00A0B0C0D0E0;
        cmp rax, r11;
        jne nasw_fail_stage;

        mov rdi, 2;                       // ASSOC_REQ
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 2;                       // ASSOC
        jne nasw_fail_stage;

        mov rdi, 3;                       // ASSOC_RESP
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 3;                       // CONNECTED
        jne nasw_fail_stage;

        // BSSID unchanged across transitions.
        call nas_bssid;
        mov r11, 0x00A0B0C0D0E0;
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 5. Reassoc to new BSSID.
        mov rax, 5;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 0x001122334455;
        call nas_reassoc;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 2;                       // ASSOC (pending resp)
        jne nasw_fail_stage;

        call nas_bssid;
        mov r11, 0x001122334455;
        cmp rax, r11;
        jne nasw_fail_stage;

        mov rdi, 4;                       // REASSOC_RESP
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 3;
        jne nasw_fail_stage;

        // Reassoc with zero -> BAD_BSSID.
        mov rdi, 0;
        call nas_reassoc;
        mov r11, 0xFFFFF41C;
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 6. Deauth from CONNECTED -> UNAUTH + BSSID cleared.
        mov rax, 6;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 5;                       // DEAUTH
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_state;
        cmp rax, 0;
        jne nasw_fail_stage;

        call nas_bssid;
        cmp rax, 0;
        jne nasw_fail_stage;

        // -- 7. Invalid transitions.
        mov rax, 7;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        // From UNAUTH: ASSOC_REQ invalid.
        mov rdi, 2;
        call nas_step;
        mov r11, 0xFFFFF41D;              // NAS_INVALID_TRANSITION
        cmp rax, r11;
        jne nasw_fail_stage;

        // From UNAUTH: ASSOC_RESP invalid.
        mov rdi, 3;
        call nas_step;
        mov r11, 0xFFFFF41D;
        cmp rax, r11;
        jne nasw_fail_stage;

        // Set up: UNAUTH -> AUTH.
        mov rdi, 0xAABBCCDDEEFF;
        call nas_set_target_bssid;
        cmp rax, 0;
        jne nasw_fail_stage;
        mov rdi, 0;                       // AUTH_REQ
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 1;
        jne nasw_fail_stage;

        // From AUTH: ASSOC_RESP invalid (need ASSOC_REQ first).
        mov rdi, 3;
        call nas_step;
        mov r11, 0xFFFFF41D;
        cmp rax, r11;
        jne nasw_fail_stage;

        // From AUTH: REASSOC_RESP invalid.
        mov rdi, 4;
        call nas_step;
        mov r11, 0xFFFFF41D;
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 8. BAD_EVENT.
        mov rax, 8;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 100;
        call nas_step;
        mov r11, 0xFFFFF41E;
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 9. ASSOC + TIMEOUT -> AUTH fallback.
        mov rax, 9;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 2;                       // AUTH -> ASSOC
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 2;
        jne nasw_fail_stage;

        mov rdi, 6;                       // TIMEOUT from ASSOC
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 1;                       // back to AUTH
        jne nasw_fail_stage;

        // -- 10. ALREADY_CONNECTED refuses set_target_bssid.
        mov rax, 10;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        // Drive to CONNECTED.
        mov rdi, 2;                       // ASSOC_REQ
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        mov rdi, 3;                       // ASSOC_RESP
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 3;
        jne nasw_fail_stage;

        mov rdi, 0x998877665544;
        call nas_set_target_bssid;
        mov r11, 0xFFFFF419;              // NAS_ALREADY_CONNECTED
        cmp rax, r11;
        jne nasw_fail_stage;

        // -- 11. DEAUTH idempotent from UNAUTH.
        mov rax, 11;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        // Deauth back to UNAUTH.
        mov rdi, 5;
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 0;
        jne nasw_fail_stage;

        // Second deauth: still admits.
        mov rdi, 5;
        call nas_step;
        cmp rax, 0;
        jne nasw_fail_stage;
        call nas_state;
        cmp rax, 0;
        jne nasw_fail_stage;

        // -- 12. Counter fanout.  STEPS > 10, ADMITS > 5, REFUSED > 5.
        mov rax, 12;
        lea rcx, [rip + _nasw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call nas_stat;
        cmp rax, 10;
        jbe nasw_fail_stage;

        mov rdi, 1;
        call nas_stat;
        cmp rax, 5;
        jbe nasw_fail_stage;

        mov rdi, 2;
        call nas_stat;
        cmp rax, 5;
        jbe nasw_fail_stage;

        // DEAUTHS bumped at least twice (stages 6 + 11).
        mov rdi, 3;
        call nas_stat;
        cmp rax, 2;
        jb  nasw_fail_stage;

        // REASSOCS bumped at least once (stage 5).
        mov rdi, 4;
        call nas_stat;
        cmp rax, 1;
        jb  nasw_fail_stage;

        // CONNECTS bumped at least twice (stages 4 + 5 + 10).
        mov rdi, 5;
        call nas_stat;
        cmp rax, 2;
        jb  nasw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nasw_ok];
        call klog_s1;

        call nas_reset;
        xor rax, rax;
        jmp nasw_out;

      nasw_fail_stage:
        lea rax, [rip + _nasw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nasw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nas_reset;
        mov rax, 1;

      nasw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
