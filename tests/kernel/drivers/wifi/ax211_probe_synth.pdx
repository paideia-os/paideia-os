// tests/kernel/drivers/wifi/ax211_probe_synth.pdx — R38.M1-001 (#1289)
//
// Boot witness for ax211_probe.  Asserts BAD_CLASS, BAD_VENDOR,
// BAD_FAMILY, BAD_BAR0, MISALIGNED, BAD_CAPS, BAD_HW_TYPE refusals;
// the three-family happy path (0x51F0 / 0x51F1 / 0x54F0); the decode
// packing of hw_type|step|dash; counter fanout and the arbitration
// honesty pin.
//
// Fingerprint: R38 AX211 PROBE OK

module Ax211ProbeSynth = structure {

  pub let mut _axpw_stage : u64 = 0

  pub let axpw_ok   : [u8; 20] = "R38 AX211 PROBE OK\n\0"
  pub let axpw_fail : [u8; 22] = "R38 AX211 PROBE FAIL\n\0"

  pub let ax211_probe_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M1-001 (#1289): boot witness. Stages: (1) reset + arbitration pin. (2) validator agreement in isolation. (3) BAD_CLASS. (4) BAD_VENDOR. (5) BAD_FAMILY. (6) BAD_BAR0 (base=0 and short length). (7) MISALIGNED. (8) BAD_CAPS (0 word). (9) BAD_HW_TYPE (type nibble 0). (10) happy path over all three device ids + decode packing. (11) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        call axp_probe_reset;

        call axp_probe_arbitrated;
        cmp rax, 0;
        jne axpw_fail_stage;

        // -- 2. Validator agreement.
        mov rax, 2;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        call axp_class_valid;
        cmp rax, 1;
        jne axpw_fail_stage;
        mov rdi, 0x0300;
        call axp_class_valid;
        cmp rax, 0;
        jne axpw_fail_stage;

        mov rdi, 0x8086;
        call axp_vendor_valid;
        cmp rax, 1;
        jne axpw_fail_stage;
        mov rdi, 0x10DE;
        call axp_vendor_valid;
        cmp rax, 0;
        jne axpw_fail_stage;

        mov rdi, 0x51F0;
        call axp_family_valid;
        cmp rax, 1;
        jne axpw_fail_stage;
        mov rdi, 0x51F1;
        call axp_family_valid;
        cmp rax, 1;
        jne axpw_fail_stage;
        mov rdi, 0x54F0;
        call axp_family_valid;
        cmp rax, 1;
        jne axpw_fail_stage;
        mov rdi, 0x2723;                 // AX210 — refused
        call axp_family_valid;
        cmp rax, 0;
        jne axpw_fail_stage;

        // -- 3. BAD_CLASS.
        mov rax, 3;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0300;                 // Display / VGA (wrong)
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010500;              // hw_type nibble = 0x105
        call axp_probe_recognise;
        mov r11, 0xFFFFF4EE;             // BAD_CLASS
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 4. BAD_VENDOR.
        mov rax, 4;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x10DE;                 // NVIDIA (wrong)
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010500;
        call axp_probe_recognise;
        mov r11, 0xFFFFF4ED;             // BAD_VENDOR
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 5. BAD_FAMILY.
        mov rax, 5;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x2723;                 // AX210
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010500;
        call axp_probe_recognise;
        mov r11, 0xFFFFF4EC;             // BAD_FAMILY
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 6. BAD_BAR0 (base=0).
        mov rax, 6;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0;                      // NULL base
        mov r8, 0x100000;
        mov r9, 0x00010500;
        call axp_probe_recognise;
        mov r11, 0xFFFFF4EB;             // BAD_BAR0
        cmp rax, r11;
        jne axpw_fail_stage;

        // BAD_BAR0 (len < 1 MB).
        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x40000;                 // 256 KiB
        mov r9, 0x00010500;
        call axp_probe_recognise;
        mov r11, 0xFFFFF4EB;
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 7. MISALIGNED (base not 64 KiB aligned).
        mov rax, 7;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80008000;             // 32 KiB aligned, not 64
        mov r8, 0x100000;
        mov r9, 0x00010500;
        call axp_probe_recognise;
        mov r11, 0xFFFFF4EA;             // MISALIGNED
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 8. BAD_CAPS (0).
        mov rax, 8;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0;                       // BAD_CAPS
        call axp_probe_recognise;
        mov r11, 0xFFFFF4E9;
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 9. BAD_HW_TYPE (chip-type nibble 0).
        mov rax, 9;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00000005;              // type nibble 0, step=1, dash=1
        call axp_probe_recognise;
        mov r11, 0xFFFFF4E8;             // BAD_HW_TYPE
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 10. Happy path — 0x51F0 with hw_type=0x105, step=1,
        //         dash=2 (caps = 0x00010506 -> type 0x105,
        //         step (bits 3..2)=1, dash (bits 1..0)=2).
        mov rax, 10;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010506;
        call axp_probe_recognise;
        // Expected: hw_type | (step << 16) | (dash << 24)
        //         = 0x105 | (1 << 16) | (2 << 24) = 0x02010105
        mov r11, 0x02010105;
        cmp rax, r11;
        jne axpw_fail_stage;

        // Same for 0x51F1.
        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x51F1;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010506;
        call axp_probe_recognise;
        mov r11, 0x02010105;
        cmp rax, r11;
        jne axpw_fail_stage;

        // Same for 0x54F0.
        mov rdi, 0x0280;
        mov rsi, 0x8086;
        mov rdx, 0x54F0;
        mov rcx, 0x80000000;
        mov r8, 0x100000;
        mov r9, 0x00010506;
        call axp_probe_recognise;
        mov r11, 0x02010105;
        cmp rax, r11;
        jne axpw_fail_stage;

        // -- 11. Counter fanout.
        mov rax, 11;
        lea rcx, [rip + _axpw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // ATTEMPTS
        call axp_probe_stat;
        // 3..10: 8 stages that call recognise + 10a/b/c = 11 calls
        // total (stage 6 hits twice, stages 3/4/5/7/8/9 once each,
        // stage 10 thrice). = 2 (stage 6) + 6 + 3 = 11.
        cmp rax, 11;
        jne axpw_fail_stage;

        mov rdi, 1;                      // MATCHED
        call axp_probe_stat;
        cmp rax, 3;                      // three happy path admits
        jne axpw_fail_stage;

        mov rdi, 2;                      // REJECTS
        call axp_probe_stat;
        cmp rax, 8;                      // 8 refusals total
        jne axpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + axpw_ok];
        call klog_s1;

        call axp_probe_reset;
        xor rax, rax;
        jmp axpw_out;

      axpw_fail_stage:
        lea rax, [rip + _axpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + axpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call axp_probe_reset;
        mov rax, 1;

      axpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
