// tests/kernel/drivers/wifi/roaming_synth.pdx — R38.M7-003 (#1320)
//
// Boot witness for roaming.  Exercises:
//   (1) reset + arbitration pin + no current binding.
//   (2) rm_bind_current(zero_bssid) refused; valid binding admits.
//   (3) off_channel_tick bumps counters.
//   (4) candidate_report(zero_bssid) refused; two candidates admitted.
//   (5) rm_decide returns strong candidate (score exceeds current+margin).
//   (6) rm_trigger_reassoc: bad_bssid refused; same-as-current refused;
//       fresh target OK.
//
// Fingerprint: R38 ROAMING OK

module RoamingSynth = structure {

  pub let mut _rmw_stage : u64 = 0

  pub let rmw_ok   : [u8; 16] = "R38 ROAMING OK\n\0"
  pub let rmw_fail : [u8; 18] = "R38 ROAMING FAIL\n\0"

  pub let rm_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M7-003 (#1320): boot witness. Stages: (1) reset + arbitration pin. (2) bind_current gate. (3) off_channel_tick. (4) candidate_report gate + admit. (5) decide picks strong candidate. (6) trigger_reassoc gate + fresh target.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        call rm_reset;

        call rm_arbitrated;
        cmp rax, 0;
        jne rmw_fail_stage;

        call rm_current_bssid;
        cmp rax, 0;
        jne rmw_fail_stage;

        // decide without current -> NOT_CONNECTED.
        call rm_decide;
        mov r11, 0xFFFFF349;
        cmp rax, r11;
        jne rmw_fail_stage;

        // -- 2. bind_current gate.
        mov rax, 2;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        // Zero bssid refused.
        mov rdi, 0;
        mov rsi, 60;
        mov rdx, 400;
        mov rcx, 100;
        call rm_bind_current;
        mov r11, 0xFFFFF34E;              // BAD_BSSID
        cmp rax, r11;
        jne rmw_fail_stage;

        // Load > 1000 refused.
        mov rdi, 0xAAAA;
        mov rsi, 60;
        mov rdx, 1001;
        mov rcx, 100;
        call rm_bind_current;
        mov r11, 0xFFFFF34C;              // BAD_LOAD
        cmp rax, r11;
        jne rmw_fail_stage;

        // Valid binding: bssid=0xAAAA, rssi=60 (bonus), load=400, speed=100.
        mov rdi, 0xAAAA;
        mov rsi, 60;
        mov rdx, 400;
        mov rcx, 100;
        call rm_bind_current;
        cmp rax, 0;
        jne rmw_fail_stage;

        call rm_current_bssid;
        mov r11, 0xAAAA;
        cmp rax, r11;
        jne rmw_fail_stage;

        // -- 3. off_channel_tick.
        mov rax, 3;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        call rm_off_channel_tick;
        call rm_off_channel_tick;
        call rm_off_channel_tick;

        mov rdi, 0;                       // RM_STAT_TICKS
        call rm_stat;
        cmp rax, 3;
        jne rmw_fail_stage;

        // -- 4. candidate_report gate + admit two.
        mov rax, 4;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        // Zero bssid refused.
        mov rdi, 0;
        mov rsi, 100;
        mov rdx, 100;
        mov rcx, 400;
        call rm_candidate_report;
        mov r11, 0xFFFFF34E;
        cmp rax, r11;
        jne rmw_fail_stage;

        // Weak candidate: bssid=0xBBBB, rssi=50, load=500, speed=90.
        // score = 50*4 + 90*2 - 500 = 200 + 180 - 500 = clamped 0.
        // (below current 60*4 + 100*2 - 400 = 240 + 200 - 400 = 40)
        mov rdi, 0xBBBB;
        mov rsi, 50;
        mov rdx, 500;
        mov rcx, 90;
        call rm_candidate_report;
        cmp rax, 0;
        jne rmw_fail_stage;

        // Strong candidate: bssid=0xCCCC, rssi=127, load=100, speed=200.
        // score = 127*4 + 200*2 - 100 = 508 + 400 - 100 = 808
        // current = 40, margin=32, so 808 > 40+32 -> pick 0xCCCC.
        mov rdi, 0xCCCC;
        mov rsi, 127;
        mov rdx, 100;
        mov rcx, 200;
        call rm_candidate_report;
        cmp rax, 0;
        jne rmw_fail_stage;

        // -- 5. decide picks strong candidate.
        mov rax, 5;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        call rm_decide;
        mov r11, 0xCCCC;
        cmp rax, r11;
        jne rmw_fail_stage;

        // -- 6. trigger_reassoc gate.
        mov rax, 6;
        lea rcx, [rip + _rmw_stage];
        mov [rcx], rax;

        // Zero target refused.
        mov rdi, 0;
        call rm_trigger_reassoc;
        mov r11, 0xFFFFF34E;
        cmp rax, r11;
        jne rmw_fail_stage;

        // Same as current refused.
        mov rdi, 0xAAAA;
        call rm_trigger_reassoc;
        mov r11, 0xFFFFF348;              // MARGIN_NOT_MET
        cmp rax, r11;
        jne rmw_fail_stage;

        // Fresh target admits.
        mov rdi, 0xCCCC;
        call rm_trigger_reassoc;
        cmp rax, 0;
        jne rmw_fail_stage;

        mov rdi, 4;                       // RM_STAT_TRIGGERS
        call rm_stat;
        cmp rax, 1;
        jne rmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rmw_ok];
        call klog_s1;

        call rm_reset;
        xor rax, rax;
        jmp rmw_out;

      rmw_fail_stage:
        lea rax, [rip + _rmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rm_reset;
        mov rax, 1;

      rmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
