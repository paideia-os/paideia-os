// tests/kernel/drivers/wifi/dma_domain_synth.pdx — R38.M2-005 (#1298)
//
// Boot witness for dma_domain.  Asserts refuse-gate composition:
// UNBOUND, ZERO_LEN, OVERFLOW, ALREADY_BOUND, OUT_OF_DOMAIN (low
// side + high side + straddle), happy-path admission, unbind +
// rebind lifecycle, counter fanout, arbitration honesty pin.
//
// Fingerprint: WIFI DMA DOMAIN OK

module DmaDomainSynth = structure {

  pub let mut _wddw_stage : u64 = 0

  pub let wddw_ok   : [u8; 20] = "WIFI DMA DOMAIN OK\n\0"
  pub let wddw_fail : [u8; 22] = "WIFI DMA DOMAIN FAIL\n\0"

  pub let wdd_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M2-005 (#1298): boot witness. Stages: (1) reset + arbitration pin + unbound. (2) unbound check refuses. (3) zero-len bind. (4) overflow bind. (5) happy bind + bound flag + base + len. (6) already-bound refuse. (7) unbind + double unbind. (8) rebind + containment: low-out + high-out + straddle + happy interior + exact fit. (9) zero-len check + overflow check. (10) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        call wdd_reset;

        call wdd_arbitrated;
        cmp rax, 0;
        jne wddw_fail_stage;

        call wdd_bound;
        cmp rax, 0;
        jne wddw_fail_stage;

        // -- 2. Unbound check refuses.
        mov rax, 2;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0x1000;
        call wdd_check;
        mov r11, 0xFFFFF48E;              // WDD_UNBOUND
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 3. Zero-length bind refuses.
        mov rax, 3;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0;
        call wdd_bind;
        mov r11, 0xFFFFF48C;              // WDD_ZERO_LEN
        cmp rax, r11;
        jne wddw_fail_stage;

        call wdd_bound;
        cmp rax, 0;
        jne wddw_fail_stage;

        // -- 4. Overflow bind refuses (base + length wraps u64).
        mov rax, 4;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0xFFFFFFFFFFFFF000;
        mov rsi, 0x2000;
        call wdd_bind;
        mov r11, 0xFFFFF48B;              // WDD_OVERFLOW
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 5. Happy bind: [0x80000000, 0x80010000).
        mov rax, 5;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0x10000;
        call wdd_bind;
        cmp rax, 0;
        jne wddw_fail_stage;

        call wdd_bound;
        cmp rax, 1;
        jne wddw_fail_stage;

        call wdd_domain_base;
        mov r11, 0x80000000;
        cmp rax, r11;
        jne wddw_fail_stage;

        call wdd_domain_len;
        mov r11, 0x10000;
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 6. Already-bound refuse.
        mov rax, 6;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x90000000;
        mov rsi, 0x8000;
        call wdd_bind;
        mov r11, 0xFFFFF48A;              // WDD_ALREADY_BOUND
        cmp rax, r11;
        jne wddw_fail_stage;

        // Base + length unchanged.
        call wdd_domain_base;
        mov r11, 0x80000000;
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 7. Unbind + double unbind.
        mov rax, 7;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        call wdd_unbind;
        cmp rax, 0;
        jne wddw_fail_stage;

        call wdd_bound;
        cmp rax, 0;
        jne wddw_fail_stage;

        call wdd_unbind;
        mov r11, 0xFFFFF48E;              // WDD_UNBOUND
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 8. Rebind + containment checks.
        mov rax, 8;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0x10000;
        call wdd_bind;
        cmp rax, 0;
        jne wddw_fail_stage;

        // Low-side out: buf_pa 0x7FFFF000 (below base).
        mov rdi, 0x7FFFF000;
        mov rsi, 0x100;
        call wdd_check;
        mov r11, 0xFFFFF48D;              // WDD_OUT_OF_DOMAIN
        cmp rax, r11;
        jne wddw_fail_stage;

        // High-side out: 0x80010000..80010100 (past base + len).
        mov rdi, 0x80010000;
        mov rsi, 0x100;
        call wdd_check;
        mov r11, 0xFFFFF48D;
        cmp rax, r11;
        jne wddw_fail_stage;

        // Straddle: 0x8000FF00 + 0x200 crosses base + len.
        mov rdi, 0x8000FF00;
        mov rsi, 0x200;
        call wdd_check;
        mov r11, 0xFFFFF48D;
        cmp rax, r11;
        jne wddw_fail_stage;

        // Happy interior: 0x80008000 + 0x100 fully inside.
        mov rdi, 0x80008000;
        mov rsi, 0x100;
        call wdd_check;
        cmp rax, 0;
        jne wddw_fail_stage;

        // Exact fit: buf_pa == base, buf_len == length.
        mov rdi, 0x80000000;
        mov rsi, 0x10000;
        call wdd_check;
        cmp rax, 0;
        jne wddw_fail_stage;

        // -- 9. Zero-length check + overflow check.
        mov rax, 9;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0;
        call wdd_check;
        mov r11, 0xFFFFF48C;              // WDD_ZERO_LEN
        cmp rax, r11;
        jne wddw_fail_stage;

        mov rdi, 0xFFFFFFFFFFFFF000;
        mov rsi, 0x2000;
        call wdd_check;
        mov r11, 0xFFFFF48B;              // WDD_OVERFLOW
        cmp rax, r11;
        jne wddw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _wddw_stage];
        mov [rcx], rax;

        // BINDS: two admitted binds (stage 5 + stage 8).
        mov rdi, 0;                       // WDD_STAT_BINDS
        call wdd_stat;
        cmp rax, 2;
        jne wddw_fail_stage;

        // UNBINDS: one admitted unbind (stage 7).
        mov rdi, 1;                       // WDD_STAT_UNBINDS
        call wdd_stat;
        cmp rax, 1;
        jne wddw_fail_stage;

        // CHECKS: stage 2 (1) + stage 8 (5) + stage 9 (2) = 8.
        mov rdi, 2;                       // WDD_STAT_CHECKS
        call wdd_stat;
        cmp rax, 8;
        jne wddw_fail_stage;

        // ADMITS: stage 8 (2 happy) = 2.
        mov rdi, 3;                       // WDD_STAT_ADMITS
        call wdd_stat;
        cmp rax, 2;
        jne wddw_fail_stage;

        // BIND_DUPES: stage 6 (1).
        mov rdi, 5;                       // WDD_STAT_BIND_DUPES
        call wdd_stat;
        cmp rax, 1;
        jne wddw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wddw_ok];
        call klog_s1;

        call wdd_reset;
        xor rax, rax;
        jmp wddw_out;

      wddw_fail_stage:
        lea rax, [rip + _wddw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wddw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wdd_reset;
        mov rax, 1;

      wddw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
