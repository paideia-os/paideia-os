// tests/kernel/drivers/wifi/tx_dma_synth.pdx — R38.M2-002 (#1295)
//
// Boot witness for tx_dma.  Composes ctxt_info + dma_domain:
// initializes the ring, binds the DMA domain, then exercises
// BAD_PA, BAD_LEN, DOMAIN_REFUSED, RING_FULL, SLOT_BUSY, happy-path
// enqueue + doorbell + in-flight tracking, completion with
// NOT_INFLIGHT + BAD_SLOT refusals, counter fanout.
//
// Fingerprint: WIFI TX DMA OK

module TxDmaSynth = structure {

  pub let mut _wtxdw_stage : u64 = 0

  pub let wtxdw_ok   : [u8; 16] = "WIFI TX DMA OK\n\0"
  pub let wtxdw_fail : [u8; 18] = "WIFI TX DMA FAIL\n\0"

  pub let wtxd_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M2-002 (#1295): boot witness. Stages: (1) reset (all three modules) + arbitration pin. (2) BAD_PA + BAD_LEN before any dependency setup. (3) DOMAIN_REFUSED (unbound). (4) bind + init + happy enqueue + doorbell + in-flight bit. (5) three-in-a-row enqueue advances head + doorbell. (6) DOMAIN_REFUSED (buffer outside window). (7) SLOT_BUSY (re-submit into an unretired slot). (8) completion NOT_INFLIGHT + BAD_SLOT + happy completion clears bit + advances tail. (9) RING_FULL (fill the ring). (10) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        // Reset all three modules -- this witness composes them.
        call wtxd_reset;
        call wctx_reset;
        call wdd_reset;

        call wtxd_arbitrated;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // -- 2. BAD_PA + BAD_LEN before any dependency setup.
        mov rax, 2;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // buf_pa = 0
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49E;              // WTXD_BAD_PA
        cmp rax, r11;
        jne wtxdw_fail_stage;

        mov rdi, 0x80000100;
        mov rsi, 0;                       // buf_len = 0
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49D;              // WTXD_BAD_LEN
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // -- 3. DOMAIN_REFUSED (unbound).
        mov rax, 3;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000100;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49B;              // WTXD_DOMAIN_REFUSED
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // -- 4. Bind + init + happy enqueue.
        mov rax, 4;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000000;
        mov rsi, 0x10000;
        call wdd_bind;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // Init the ctxt_info (version, img_size, page_count, tx_bda, rx_bda).
        mov rdi, 0x00030002;
        mov rsi, 0x00100000;
        mov rdx, 0x100;
        mov rcx, 0xC0000000;
        mov r8,  0xC0100000;
        call wctx_init;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // Happy enqueue.  buf_pa 0x80000100, len 0x200, flags 0xAB.
        mov rdi, 0x80000100;
        mov rsi, 0x200;
        mov rdx, 0xAB;
        call wtxd_enqueue;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // Doorbell should read 1 (head advanced from 0 to 1).
        call wtxd_doorbell_read;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // Head bumped.
        mov rdi, 0;                       // WCTX_IDX_TX_HEAD
        call wctx_index_get;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // Slot 0 addr matches.
        mov rdi, 0;
        call wctx_tx_slot_addr;
        mov r11, 0x80000100;
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // Slot 0 word 1 == (flags << 32) | (len & 0xFFFFFFFF)
        //               = (0xAB << 32) | 0x200 = 0x000000AB00000200.
        mov rdi, 0;
        call wctx_tx_slot_lenflags;
        mov r11, 0x000000AB00000200;
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // In-flight bit 0 set.
        mov rdi, 0;
        call wtxd_inflight_test;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // -- 5. Three more enqueues, head advances.
        mov rax, 5;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0x80000300;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        mov rdi, 0x80000400;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        mov rdi, 0x80000500;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // Head is now 4.
        mov rdi, 0;
        call wctx_index_get;
        cmp rax, 4;
        jne wtxdw_fail_stage;

        // Doorbell reads 4.
        call wtxd_doorbell_read;
        cmp rax, 4;
        jne wtxdw_fail_stage;

        // In-flight bits 1, 2, 3 all set.
        mov rdi, 1;
        call wtxd_inflight_test;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        mov rdi, 3;
        call wtxd_inflight_test;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // -- 6. DOMAIN_REFUSED (buffer outside window).
        mov rax, 6;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0x70000000;              // below base 0x80000000
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49B;              // WTXD_DOMAIN_REFUSED
        cmp rax, r11;
        jne wtxdw_fail_stage;

        mov rdi, 0x8000FF00;              // straddles high end
        mov rsi, 0x200;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49B;
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // -- 7. SLOT_BUSY.  Force the head back to 0 -- slot 0's
        //       inflight bit is still set from stage 4, so a submit
        //       into slot 0 (head % 256 == 0) must refuse SLOT_BUSY
        //       without touching the ring.  This does not model a
        //       real driver's behaviour (a real driver never rewinds
        //       head); it isolates the bitmap refuse-gate.
        mov rax, 7;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // TX_HEAD
        mov rsi, 0;
        call wctx_index_set;
        // TX_TAIL also 0 to avoid RING_FULL (head - tail == 0 < 256).
        mov rdi, 1;
        mov rsi, 0;
        call wctx_index_set;

        mov rdi, 0x80000200;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49A;              // WTXD_SLOT_BUSY
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // Restore head to 4 for the completion tests.
        mov rdi, 0;
        mov rsi, 4;
        call wctx_index_set;

        // -- 8. Completion path.
        mov rax, 8;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        // BAD_SLOT (slot 256).
        mov rdi, 256;
        call wtxd_completion_note;
        mov r11, 0xFFFFF499;              // WTXD_BAD_SLOT
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // NOT_INFLIGHT (slot 100 was never enqueued).
        mov rdi, 100;
        call wtxd_completion_note;
        mov r11, 0xFFFFF498;              // WTXD_NOT_INFLIGHT
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // Happy completion of slot 0.
        mov rdi, 0;
        call wtxd_completion_note;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // In-flight bit 0 cleared.
        mov rdi, 0;
        call wtxd_inflight_test;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // Tail advanced 0 -> 1.
        mov rdi, 1;                       // TX_TAIL
        call wctx_index_get;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // Retire 1, 2, 3 as well (setup for stage 9).
        mov rdi, 1;
        call wtxd_completion_note;
        cmp rax, 0;
        jne wtxdw_fail_stage;
        mov rdi, 2;
        call wtxd_completion_note;
        cmp rax, 0;
        jne wtxdw_fail_stage;
        mov rdi, 3;
        call wtxd_completion_note;
        cmp rax, 0;
        jne wtxdw_fail_stage;

        // -- 9. RING_FULL.  Reset the ring pointers to 0 and force
        //       tail to 0 (fresh); then set head to 256 and tail to 0
        //       so the ring reads FULL.  All in-flight bits are
        //       cleared by the four completions above, so SLOT_BUSY
        //       cannot fire first.
        mov rax, 9;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 256;
        call wctx_index_set;              // TX_HEAD = 256
        mov rdi, 1;
        mov rsi, 0;
        call wctx_index_set;              // TX_TAIL = 0

        mov rdi, 0x80000700;
        mov rsi, 0x100;
        mov rdx, 0;
        call wtxd_enqueue;
        mov r11, 0xFFFFF49C;              // WTXD_RING_FULL
        cmp rax, r11;
        jne wtxdw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _wtxdw_stage];
        mov [rcx], rax;

        // ENQUEUES: stage 2 (2) + stage 3 (1) + stage 4 (1) + stage 5 (3)
        //         + stage 6 (2) + stage 7 (1) + stage 9 (1) = 11.
        mov rdi, 0;
        call wtxd_stat;
        cmp rax, 11;
        jne wtxdw_fail_stage;

        // ADMITS: stage 4 (1) + stage 5 (3) = 4.
        mov rdi, 1;
        call wtxd_stat;
        cmp rax, 4;
        jne wtxdw_fail_stage;

        // DOMAIN_REFS: stage 3 (1) + stage 6 (2) = 3.
        mov rdi, 3;
        call wtxd_stat;
        cmp rax, 3;
        jne wtxdw_fail_stage;

        // RING_FULLS: stage 9 (1).
        mov rdi, 4;
        call wtxd_stat;
        cmp rax, 1;
        jne wtxdw_fail_stage;

        // COMPLETIONS: stage 8 (4 happy).
        mov rdi, 5;
        call wtxd_stat;
        cmp rax, 4;
        jne wtxdw_fail_stage;

        // DOORBELLS: stage 4 (1) + stage 5 (3) = 4.
        mov rdi, 6;
        call wtxd_stat;
        cmp rax, 4;
        jne wtxdw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wtxdw_ok];
        call klog_s1;

        // Teardown -- reset all three modules so the next witness in
        // this file starts clean.
        call wtxd_reset;
        call wctx_reset;
        call wdd_reset;
        xor rax, rax;
        jmp wtxdw_out;

      wtxdw_fail_stage:
        lea rax, [rip + _wtxdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wtxdw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wtxd_reset;
        call wctx_reset;
        call wdd_reset;
        mov rax, 1;

      wtxdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
