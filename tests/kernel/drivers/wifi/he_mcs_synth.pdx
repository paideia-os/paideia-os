// tests/kernel/drivers/wifi/he_mcs_synth.pdx — R38.M7-001 (#1318)
//
// Boot witness for he_mcs.  Exercises:
//   (1) reset + arbitration pin (0) + empty tables.
//   (2) valid-range predicates: mcs/bw/gi/nss.
//   (3) rate lookup: MCS0/20MHz/0.8us/1NSS = 8 Mbps.
//   (4) rate lookup: MCS11/160MHz/0.8us/2NSS = 143 * 8 * 2 = 2288 Mbps.
//   (5) rate lookup with bad MCS refused (returns 0, bumps refused).
//   (6) MU-MIMO group add + user add + capacity refusal.
//
// Fingerprint: HE MCS OK

module HeMcsSynth = structure {

  pub let mut _hemw_stage : u64 = 0

  pub let hemw_ok   : [u8; 11] = "HE MCS OK\0"
  pub let hemw_fail : [u8; 13] = "HE MCS FAIL\0"

  pub let hem_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M7-001 (#1318): boot witness. Stages: (1) reset + arbitration pin. (2) valid predicates. (3) rate lookup baseline. (4) rate lookup peak. (5) bad-arg refusal. (6) MU-MIMO group/user admit + capacity refusal.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. reset + arbitration pin + empty.
        mov rax, 1;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        call hem_reset;

        call hem_arbitrated;
        cmp rax, 0;
        jne hemw_fail_stage;

        call hem_active_groups;
        cmp rax, 0;
        jne hemw_fail_stage;

        call hem_active_users;
        cmp rax, 0;
        jne hemw_fail_stage;

        // -- 2. valid predicates.
        mov rax, 2;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        mov rdi, 11;
        call hem_mcs_valid;
        cmp rax, 1;
        jne hemw_fail_stage;
        mov rdi, 12;
        call hem_mcs_valid;
        cmp rax, 0;
        jne hemw_fail_stage;

        mov rdi, 3;
        call hem_bw_valid;
        cmp rax, 1;
        jne hemw_fail_stage;
        mov rdi, 4;
        call hem_bw_valid;
        cmp rax, 0;
        jne hemw_fail_stage;

        mov rdi, 2;
        call hem_gi_valid;
        cmp rax, 1;
        jne hemw_fail_stage;
        mov rdi, 3;
        call hem_gi_valid;
        cmp rax, 0;
        jne hemw_fail_stage;

        mov rdi, 1;
        call hem_nss_valid;
        cmp rax, 1;
        jne hemw_fail_stage;
        mov rdi, 0;
        call hem_nss_valid;
        cmp rax, 0;
        jne hemw_fail_stage;
        mov rdi, 9;
        call hem_nss_valid;
        cmp rax, 0;
        jne hemw_fail_stage;

        // -- 3. baseline lookup: MCS0/20MHz/0.8us/1NSS = 8 Mbps.
        mov rax, 3;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        mov rdi, 0;                       // mcs
        mov rsi, 0;                       // bw = 20 MHz
        mov rdx, 0;                       // gi = 0.8 us
        mov rcx, 1;                       // nss
        call hem_rate_lookup;
        cmp rax, 8;
        jne hemw_fail_stage;

        // -- 4. peak lookup: MCS11/160MHz/0.8us/2NSS = 143 * 8 * 2 = 2288.
        mov rax, 4;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        mov rdi, 11;
        mov rsi, 3;                       // bw = 160 MHz
        mov rdx, 0;
        mov rcx, 2;
        call hem_rate_lookup;
        mov r11, 2288;
        cmp rax, r11;
        jne hemw_fail_stage;

        // -- 5. bad-arg refusal.
        mov rax, 5;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        mov rdi, 12;                      // bad mcs
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 1;
        call hem_rate_lookup;
        cmp rax, 0;
        jne hemw_fail_stage;

        // -- 6. MU-MIMO admit.
        mov rax, 6;
        lea rcx, [rip + _hemw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // group_id
        mov rsi, 2;                       // n_users = 2
        mov rdx, 0x100;                   // primary_ru
        mov rcx, 0x200;                   // secondary_ru
        call hem_group_add;
        cmp rax, 0;
        jne hemw_fail_stage;

        // Duplicate group refused.
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 0x100;
        mov rcx, 0x200;
        call hem_group_add;
        mov r11, 0xFFFFF368;              // ALREADY
        cmp rax, r11;
        jne hemw_fail_stage;

        // Add user 1 to group 1.
        mov rdi, 1;                       // group_id
        mov rsi, 1;                       // user_id
        mov rdx, 11;                      // aid
        mov rcx, 7;                       // mcs
        call hem_user_add;
        cmp rax, 0;
        jne hemw_fail_stage;

        // Add user 2 to group 1.
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 12;
        mov rcx, 7;
        call hem_user_add;
        cmp rax, 0;
        jne hemw_fail_stage;

        // Third user in group 1 refused GROUP_FULL (capacity=2).
        mov rdi, 1;
        mov rsi, 3;
        mov rdx, 13;
        mov rcx, 7;
        call hem_user_add;
        mov r11, 0xFFFFF367;              // GROUP_FULL
        cmp rax, r11;
        jne hemw_fail_stage;

        // Bad MCS in add refused.
        mov rdi, 1;
        mov rsi, 4;
        mov rdx, 14;
        mov rcx, 12;
        call hem_user_add;
        mov r11, 0xFFFFF36E;              // BAD_MCS
        cmp rax, r11;
        jne hemw_fail_stage;

        // Add-user against non-existent group refused NO_GROUP.
        mov rdi, 9;
        mov rsi, 1;
        mov rdx, 15;
        mov rcx, 7;
        call hem_user_add;
        mov r11, 0xFFFFF369;              // NO_GROUP
        cmp rax, r11;
        jne hemw_fail_stage;

        // Verify active counters: 1 group, 2 users.
        call hem_active_groups;
        cmp rax, 1;
        jne hemw_fail_stage;
        call hem_active_users;
        cmp rax, 2;
        jne hemw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hemw_ok];
        call klog_s1;

        call hem_reset;
        xor rax, rax;
        jmp hemw_out;

      hemw_fail_stage:
        lea rax, [rip + _hemw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hemw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call hem_reset;
        mov rax, 1;

      hemw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
