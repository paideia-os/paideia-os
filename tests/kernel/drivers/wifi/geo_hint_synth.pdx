// tests/kernel/drivers/wifi/geo_hint_synth.pdx — R38.M6-003 (#1316)
//
// Boot witness for geo_hint discovery.  Exercises:
//   (1) reset + arbitration pin (0) + not-queried state.
//   (2) gh_query_gnss_stub(0) returns 0; non-zero returns the
//       argument unchanged (test seam).
//   (3) gh_query(0) falls back to (WW, DEFAULT, LOW).
//   (4) Second gh_query refused ALREADY.
//   (5) reset then gh_query(US) records (US, GNSS, HIGH).
//   (6) counter fanout.
//
// Fingerprint: GEO HINT OK

module GeoHintSynth = structure {

  pub let mut _ghw_stage : u64 = 0

  pub let ghw_ok   : [u8; 12] = "GEO HINT OK\0"
  pub let ghw_fail : [u8; 14] = "GEO HINT FAIL\0"

  pub let gh_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M6-003 (#1316): boot witness. Stages: (1) reset + arbitration pin. (2) gnss_stub seam. (3) query(0) falls back to WW DEFAULT LOW. (4) second query ALREADY. (5) reset + query(US) records (US, GNSS, HIGH). (6) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. reset + arbitration pin + not-queried state.
        mov rax, 1;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        call gh_reset;

        call gh_arbitrated;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_queried;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_source;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_country;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_confidence;
        cmp rax, 0;
        jne ghw_fail_stage;

        // -- 2. gnss_stub seam.
        mov rax, 2;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gh_query_gnss_stub;
        cmp rax, 0;
        jne ghw_fail_stage;

        mov rdi, 0x5553;                  // test cc
        call gh_query_gnss_stub;
        mov r11, 0x5553;
        cmp rax, r11;
        jne ghw_fail_stage;

        // -- 3. query(0) falls back to (WW, DEFAULT, LOW).
        mov rax, 3;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gh_query;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_queried;
        cmp rax, 1;
        jne ghw_fail_stage;

        call gh_source;
        cmp rax, 3;                       // GH_SRC_DEFAULT
        jne ghw_fail_stage;

        call gh_country;
        mov r11, 0x5757;                  // WW
        cmp rax, r11;
        jne ghw_fail_stage;

        call gh_confidence;
        cmp rax, 10;                      // GH_CONF_LOW
        jne ghw_fail_stage;

        // -- 4. Second query refused ALREADY.
        mov rax, 4;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call gh_query;
        mov r11, 0xFFFFF37D;              // ALREADY
        cmp rax, r11;
        jne ghw_fail_stage;

        // Same for a non-zero stub id -- still ALREADY.
        mov rdi, 0x5553;
        call gh_query;
        mov r11, 0xFFFFF37D;
        cmp rax, r11;
        jne ghw_fail_stage;

        // -- 5. reset + query(US via stub) records (US, GNSS, HIGH).
        mov rax, 5;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        call gh_reset;

        mov rdi, 0x5553;                  // US via stub
        call gh_query;
        cmp rax, 0;
        jne ghw_fail_stage;

        call gh_queried;
        cmp rax, 1;
        jne ghw_fail_stage;

        call gh_source;
        cmp rax, 2;                       // GH_SRC_GNSS
        jne ghw_fail_stage;

        call gh_country;
        mov r11, 0x5553;
        cmp rax, r11;
        jne ghw_fail_stage;

        call gh_confidence;
        cmp rax, 100;                     // GH_CONF_HIGH
        jne ghw_fail_stage;

        // -- 6. Counter fanout AFTER the stage-5 reset.  gh_reset
        // scrubs _gh_stats, so only stage-5's activity survives the
        // window we can read from here: one query, one GNSS-hit, and
        // the RESETS bump the reset itself made.
        mov rax, 6;
        lea rcx, [rip + _ghw_stage];
        mov [rcx], rax;

        // QUERIES >= 1 (stage 5's gh_query(US)).
        mov rdi, 0;
        call gh_stat;
        cmp rax, 1;
        jb  ghw_fail_stage;

        // GNSS_HIT >= 1 (stage 5).
        mov rdi, 1;
        call gh_stat;
        cmp rax, 1;
        jb  ghw_fail_stage;

        // GNSS_MISS == 0 (stage-5 reset scrubbed the stage-3 miss).
        mov rdi, 2;
        call gh_stat;
        cmp rax, 0;
        jne ghw_fail_stage;

        // DEFAULTS == 0 (stage-5 reset scrubbed the stage-3 default).
        mov rdi, 3;
        call gh_stat;
        cmp rax, 0;
        jne ghw_fail_stage;

        // RESETS >= 1 (the stage-5 reset bumps itself; earlier
        // bumps were scrubbed).
        mov rdi, 4;
        call gh_stat;
        cmp rax, 1;
        jb  ghw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ghw_ok];
        call klog_s1;

        call gh_reset;
        xor rax, rax;
        jmp ghw_out;

      ghw_fail_stage:
        lea rax, [rip + _ghw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ghw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call gh_reset;
        mov rax, 1;

      ghw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
