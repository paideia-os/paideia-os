// tests/kernel/drivers/wifi/regdom_loader_synth.pdx — R38.M6-001 (#1314)
//
// Boot witness for regdom_loader.  Exercises:
//   (1) reset + arbitration pin (returns 0) + unloaded state.
//   (2) rdl_publish while unloaded refused (NOT_LOADED).
//   (3) rdl_load_eeprom(0) refused (NO_EEPROM); rdl_load_eeprom
//       with unknown cc refused (BAD_CC); state remains unloaded.
//   (4) rdl_load_eeprom(US) admits; state = (EEPROM, US).
//   (5) rdl_load_eeprom while loaded refused (ALREADY_LOADED).
//   (6) rdl_publish maps US -> NRD_DOMAIN_US and nrd_bind succeeds.
//   (7) nrd_unbind + rdl_unload; rdl_load_default admits WW.
//   (8) rdl_publish maps WW -> NRD_DOMAIN_US (safe subset) and
//       nrd_bind succeeds.
//   (9) cc_to_domain table -- verify all six mappings.
//   (10) counter fanout.
//
// Fingerprint: REGDOM LOADER OK

module RegdomLoaderSynth = structure {

  pub let mut _rdlw_stage : u64 = 0

  pub let rdlw_ok   : [u8; 17] = "REGDOM LOADER OK\0"
  pub let rdlw_fail : [u8; 19] = "REGDOM LOADER FAIL\0"

  pub let rdl_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M6-001 (#1314): boot witness. Stages: (1) reset + arbitration pin + unloaded. (2) publish unloaded refused. (3) load_eeprom(0) NO_EEPROM + unknown BAD_CC. (4) load_eeprom(US) admits. (5) reload refused ALREADY. (6) publish binds nrd US. (7) unbind + unload + load_default WW. (8) publish WW -> nrd US-subset. (9) cc_to_domain table. (10) counter fanout. Uses rdl_reset + nrd_reset for isolation.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + unloaded state.
        mov rax, 1;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        call rdl_reset;
        call nrd_reset;

        call rdl_arbitrated;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_loaded;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_source;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_country;
        cmp rax, 0;
        jne rdlw_fail_stage;

        // -- 2. publish unloaded refused NOT_LOADED.
        mov rax, 2;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        call rdl_publish;
        mov r11, 0xFFFFF39E;              // NOT_LOADED
        cmp rax, r11;
        jne rdlw_fail_stage;

        // -- 3. load_eeprom refuses zero (NO_EEPROM) and unknown cc.
        mov rax, 3;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call rdl_load_eeprom;
        mov r11, 0xFFFFF39C;              // NO_EEPROM
        cmp rax, r11;
        jne rdlw_fail_stage;

        // Unknown code (0x4141 = 'AA') -- not in table.
        mov rdi, 0x4141;
        call rdl_load_eeprom;
        mov r11, 0xFFFFF39B;              // BAD_CC
        cmp rax, r11;
        jne rdlw_fail_stage;

        call rdl_loaded;
        cmp rax, 0;
        jne rdlw_fail_stage;

        // -- 4. load_eeprom(US) admits.
        mov rax, 4;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;                  // RDL_CC_US
        call rdl_load_eeprom;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_loaded;
        cmp rax, 1;
        jne rdlw_fail_stage;

        call rdl_source;
        cmp rax, 1;                       // RDL_SRC_EEPROM
        jne rdlw_fail_stage;

        call rdl_country;
        mov r11, 0x5553;
        cmp rax, r11;
        jne rdlw_fail_stage;

        // -- 5. Reload refused ALREADY.
        mov rax, 5;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        mov rdi, 0x4555;                  // RDL_CC_EU
        call rdl_load_eeprom;
        mov r11, 0xFFFFF39D;              // ALREADY_LOADED
        cmp rax, r11;
        jne rdlw_fail_stage;

        call rdl_load_default;
        mov r11, 0xFFFFF39D;
        cmp rax, r11;
        jne rdlw_fail_stage;

        // Country unchanged.
        call rdl_country;
        mov r11, 0x5553;
        cmp rax, r11;
        jne rdlw_fail_stage;

        // -- 6. publish -> nrd_bind(US) succeeds.
        mov rax, 6;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        call rdl_publish;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call nrd_bound;
        cmp rax, 1;
        jne rdlw_fail_stage;

        call nrd_regdom;
        cmp rax, 1;                       // NRD_DOMAIN_US
        jne rdlw_fail_stage;

        // -- 7. nrd_unbind + rdl_unload + load_default.
        mov rax, 7;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        call nrd_unbind;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_unload;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_loaded;
        cmp rax, 0;
        jne rdlw_fail_stage;

        // Second unload refused NOT_LOADED.
        call rdl_unload;
        mov r11, 0xFFFFF39E;
        cmp rax, r11;
        jne rdlw_fail_stage;

        call rdl_load_default;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call rdl_source;
        cmp rax, 2;                       // RDL_SRC_DEFAULT
        jne rdlw_fail_stage;

        call rdl_country;
        mov r11, 0x5757;                  // WW
        cmp rax, r11;
        jne rdlw_fail_stage;

        // -- 8. publish WW -> nrd_bind(NRD_DOMAIN_US) succeeds.
        mov rax, 8;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        call rdl_publish;
        cmp rax, 0;
        jne rdlw_fail_stage;

        call nrd_regdom;
        cmp rax, 1;                       // WW maps to US-subset
        jne rdlw_fail_stage;

        // -- 9. cc_to_domain table pointwise.
        mov rax, 9;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        mov rdi, 0x5553;                  // US -> 1
        call rdl_cc_to_domain;
        cmp rax, 1;
        jne rdlw_fail_stage;

        mov rdi, 0x4555;                  // EU -> 2
        call rdl_cc_to_domain;
        cmp rax, 2;
        jne rdlw_fail_stage;

        mov rdi, 0x4A50;                  // JP -> 3
        call rdl_cc_to_domain;
        cmp rax, 3;
        jne rdlw_fail_stage;

        mov rdi, 0x434E;                  // CN -> 1 (safe US subset)
        call rdl_cc_to_domain;
        cmp rax, 1;
        jne rdlw_fail_stage;

        mov rdi, 0x554B;                  // UK -> 2 (EU-identical)
        call rdl_cc_to_domain;
        cmp rax, 2;
        jne rdlw_fail_stage;

        mov rdi, 0x5757;                  // WW -> 1 (safe)
        call rdl_cc_to_domain;
        cmp rax, 1;
        jne rdlw_fail_stage;

        mov rdi, 0x4141;                  // AA -> 0
        call rdl_cc_to_domain;
        cmp rax, 0;
        jne rdlw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _rdlw_stage];
        mov [rcx], rax;

        // LOADS_EEPROM >= 1 (stage 4).
        mov rdi, 0;
        call rdl_stat;
        cmp rax, 1;
        jb  rdlw_fail_stage;

        // LOADS_DEFAULT >= 1 (stage 7).
        mov rdi, 1;
        call rdl_stat;
        cmp rax, 1;
        jb  rdlw_fail_stage;

        // LOAD_REFUSED >= 4 (stages 3 x2, 5 x2).
        mov rdi, 2;
        call rdl_stat;
        cmp rax, 4;
        jb  rdlw_fail_stage;

        // PUBLISHES >= 2 (stages 6, 8).
        mov rdi, 3;
        call rdl_stat;
        cmp rax, 2;
        jb  rdlw_fail_stage;

        // PUBLISH_REFUSED >= 1 (stage 2).
        mov rdi, 4;
        call rdl_stat;
        cmp rax, 1;
        jb  rdlw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rdlw_ok];
        call klog_s1;

        call rdl_reset;
        call nrd_reset;
        xor rax, rax;
        jmp rdlw_out;

      rdlw_fail_stage:
        lea rax, [rip + _rdlw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rdlw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rdl_reset;
        call nrd_reset;
        mov rax, 1;

      rdlw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
