// tests/kernel/drivers/wifi/rate_control_synth.pdx — R38.M7-002 (#1319)
//
// Boot witness for rate_control.  Exercises:
//   (1) reset + arbitration pin + empty.
//   (2) rc2_admit(peer=1, mcs=7); rc2_current_mcs == 7; duplicate refused.
//   (3) rc2_admit with bad mcs refused.
//   (4) rc2_report before admit refused; report OK bumps samples.
//   (5) Load 16 samples all OK -> PER == 0; rc2_decide -> step up to 8.
//   (6) Load 16 samples all ERR -> PER == 1000; rc2_decide -> step down.
//
// Fingerprint: R38 RATE CONTROL OK

module RateControlSynth = structure {

  pub let mut _rc2w_stage : u64 = 0

  pub let rc2w_ok   : [u8; 21] = "R38 RATE CONTROL OK\n\0"
  pub let rc2w_fail : [u8; 23] = "R38 RATE CONTROL FAIL\n\0"

  pub let rc2_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M7-002 (#1319): boot witness. Stages: (1) reset + arbitration pin. (2) admit + duplicate. (3) bad-mcs admit. (4) report gate. (5) all-OK -> step up. (6) all-ERR -> step down.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        call rc2_reset;

        call rc2_arbitrated;
        cmp rax, 0;
        jne rc2w_fail_stage;

        // -- 2. admit + duplicate.
        mov rax, 2;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // peer 1
        mov rsi, 7;                       // mcs 7
        call rc2_admit;
        cmp rax, 0;
        jne rc2w_fail_stage;

        mov rdi, 1;
        call rc2_current_mcs;
        cmp rax, 7;
        jne rc2w_fail_stage;

        // Duplicate admit refused.
        mov rdi, 1;
        mov rsi, 5;
        call rc2_admit;
        mov r11, 0xFFFFF35A;              // ALREADY
        cmp rax, r11;
        jne rc2w_fail_stage;

        // -- 3. admit with bad mcs.
        mov rax, 3;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        mov rdi, 2;
        mov rsi, 12;                      // bad mcs
        call rc2_admit;
        mov r11, 0xFFFFF35D;              // BAD_MCS
        cmp rax, r11;
        jne rc2w_fail_stage;

        // -- 4. report gate.
        mov rax, 4;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        // Report against unknown peer refused.
        mov rdi, 99;
        mov rsi, 7;
        mov rdx, 1;
        call rc2_report;
        mov r11, 0xFFFFF35B;              // NOT_TRACKED
        cmp rax, r11;
        jne rc2w_fail_stage;

        // -- 5. load 16 samples all OK against peer 1.
        mov rax, 5;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        mov r12, 0;
      rc2w_loop_ok:
        cmp r12, 16;
        jae rc2w_loop_ok_done;
        mov rdi, 1;
        mov rsi, 7;
        mov rdx, 1;                       // ok
        call rc2_report;
        cmp rax, 0;
        jne rc2w_fail_stage;
        add r12, 1;
        jmp rc2w_loop_ok;
      rc2w_loop_ok_done:

        // Samples == 16.
        mov rdi, 1;
        call rc2_samples;
        cmp rax, 16;
        jne rc2w_fail_stage;

        // PER == 0.
        mov rdi, 1;
        call rc2_per_pmille;
        cmp rax, 0;
        jne rc2w_fail_stage;

        // Decide -> step up to 8.
        mov rdi, 1;
        call rc2_decide;
        cmp rax, 8;
        jne rc2w_fail_stage;

        // -- 6. reset peer, admit again at mcs 5, load 16 ERR.
        mov rax, 6;
        lea rcx, [rip + _rc2w_stage];
        mov [rcx], rax;

        call rc2_reset;
        mov rdi, 1;
        mov rsi, 5;
        call rc2_admit;
        cmp rax, 0;
        jne rc2w_fail_stage;

        mov r12, 0;
      rc2w_loop_err:
        cmp r12, 16;
        jae rc2w_loop_err_done;
        mov rdi, 1;
        mov rsi, 5;
        mov rdx, 0;                       // err
        call rc2_report;
        cmp rax, 0;
        jne rc2w_fail_stage;
        add r12, 1;
        jmp rc2w_loop_err;
      rc2w_loop_err_done:

        mov rdi, 1;
        call rc2_per_pmille;
        mov r11, 1000;
        cmp rax, r11;
        jne rc2w_fail_stage;

        mov rdi, 1;
        call rc2_decide;
        cmp rax, 4;                       // 5 - 1
        jne rc2w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rc2w_ok];
        call klog_s1;

        call rc2_reset;
        xor rax, rax;
        jmp rc2w_out;

      rc2w_fail_stage:
        lea rax, [rip + _rc2w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rc2w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rc2_reset;
        mov rax, 1;

      rc2w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
