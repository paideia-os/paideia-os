// tests/kernel/drivers/wifi/replay_counter_synth.pdx — R38.M5-004 (#1312)
//
// Boot witness for the KRACK-safe replay counter.  Asserts:
//   (1) install_guard admits fresh install for a key_id;
//   (2) install_guard REFUSES a second install for the same key_id
//       (RC_ALREADY -- the KRACK gate);
//   (3) recv_guard admits pn > last_seen and advances last_seen;
//   (4) recv_guard REFUSES pn == last_seen and pn < last_seen (RC_REPLAY);
//   (5) rc_free releases the row; a new install can then succeed;
//   (6) bad key_id refused (RC_BAD_KEY_ID).
//
// Fingerprint: REPLAY COUNTER OK

module ReplayCounterSynth = structure {

  pub let mut _rcw_stage : u64 = 0

  pub let rcw_ok   : [u8; 18] = "REPLAY COUNTER OK\0"
  pub let rcw_fail : [u8; 20] = "REPLAY COUNTER FAIL\0"

  pub let replay_counter_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M5-004 (#1312): boot witness. Stages: (1) reset. (2) install_guard fresh key. (3) install_guard second install refused (KRACK gate). (4) recv_guard admits PN>last. (5) recv_guard refuses PN==last (REPLAY). (6) recv_guard refuses PN<last (REPLAY). (7) rc_free releases row, new install succeeds. (8) bad key_id refused.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        // -- 1. Reset.
        call rc_reset;

        // -- 2. install_guard fresh key.
        mov rax, 2;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // key_id (pairwise)
        mov rsi, 100;                    // initial_pn
        call rc_install_guard;
        cmp rax, 0;
        jne rcw_fail_stage;

        // last_seen == 100 initially.
        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 100;
        jne rcw_fail_stage;

        // -- 3. Second install refused -- KRACK gate.
        mov rax, 3;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 200;                    // even a different PN is refused
        call rc_install_guard;
        mov r11, 0xFFFFF3BC;             // RC_ALREADY
        cmp rax, r11;
        jne rcw_fail_stage;

        // Counter must not have been touched.
        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 100;
        jne rcw_fail_stage;

        // -- 4. recv_guard admits PN > last.
        mov rax, 4;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 101;
        call rc_recv_guard;
        cmp rax, 0;
        jne rcw_fail_stage;

        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 101;
        jne rcw_fail_stage;

        // -- 5. recv_guard refuses PN == last (REPLAY).
        mov rax, 5;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 101;
        call rc_recv_guard;
        mov r11, 0xFFFFF3BA;             // RC_REPLAY
        cmp rax, r11;
        jne rcw_fail_stage;

        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 101;
        jne rcw_fail_stage;

        // -- 6. recv_guard refuses PN < last (REPLAY).
        mov rax, 6;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        mov rsi, 50;
        call rc_recv_guard;
        mov r11, 0xFFFFF3BA;
        cmp rax, r11;
        jne rcw_fail_stage;

        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 101;
        jne rcw_fail_stage;

        // -- 7. rc_free releases; new install succeeds.
        mov rax, 7;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 4;
        call rc_free;
        cmp rax, 0;
        jne rcw_fail_stage;

        // After free, no row.
        mov rdi, 4;
        call rc_recv_guard;
        mov r11, 0xFFFFF3BB;             // RC_NOT_INSTALLED
        cmp rax, r11;
        jne rcw_fail_stage;

        // Fresh install with new counter.
        mov rdi, 4;
        mov rsi, 500;
        call rc_install_guard;
        cmp rax, 0;
        jne rcw_fail_stage;

        mov rdi, 4;
        call rc_last_seen;
        cmp rax, 500;
        jne rcw_fail_stage;

        // -- 8. Bad key_id refused.
        mov rax, 8;
        lea rcx, [rip + _rcw_stage];
        mov [rcx], rax;

        mov rdi, 8;
        mov rsi, 1;
        call rc_install_guard;
        mov r11, 0xFFFFF3BE;             // RC_BAD_KEY_ID
        cmp rax, r11;
        jne rcw_fail_stage;

        mov rdi, 8;
        mov rsi, 1;
        call rc_recv_guard;
        mov r11, 0xFFFFF3BE;
        cmp rax, r11;
        jne rcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rcw_ok];
        call klog_s1;

        call rc_reset;
        xor rax, rax;
        jmp rcw_out;

      rcw_fail_stage:
        lea rax, [rip + _rcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rc_reset;
        mov rax, 1;

      rcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
