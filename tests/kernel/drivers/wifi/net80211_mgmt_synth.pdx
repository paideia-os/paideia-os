// tests/kernel/drivers/wifi/net80211_mgmt_synth.pdx — R38.M4-001 (#1304)
//
// Boot witness for net80211_mgmt.  Exercises: BAD_TYPE at encode,
// header + seqctl round-trip for the five recognised frame types,
// NO_HDR on ie_append before hdr_encode, FRAME_FULL on capped
// append, IE walk + find (SSID + RSN), IE_NOT_FOUND for a type
// that never appears, IE_TRUNCATED (BAD_ARG on ie_len > 8),
// counter fanout.
//
// Fingerprint: NET80211 MGMT OK

module Net80211MgmtSynth = structure {

  pub let mut _nmgw_stage : u64 = 0

  pub let nmgw_ok   : [u8; 18] = "NET80211 MGMT OK\n\0"
  pub let nmgw_fail : [u8; 20] = "NET80211 MGMT FAIL\n\0"

  pub let nmg_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M4-001 (#1304): boot witness. Stages: (1) reset + arbitration pin. (2) BAD_TYPE. (3) NO_HDR before header staged. (4) Beacon encode + read type + seqctl. (5) ProbeReq / ProbeResp / AssocReq / Deauth encodes each read back correctly. (6) IE append (SSID + RSN + rates) + walk + find. (7) IE_NOT_FOUND for missing type. (8) BAD_ARG for ie_len > 8. (9) FRAME_FULL when capped. (10) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        call nmg_reset;

        call nmg_arbitrated;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // -- 2. BAD_TYPE (0x30 -- not one of the five recognised).
        mov rax, 2;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0x30;
        mov rsi, 0;
        call nmg_hdr_encode;
        mov r11, 0xFFFFF42E;
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 3. NO_HDR: ie_append before any hdr_encode succeeded.
        mov rax, 3;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        // pos is still 0 (BAD_TYPE didn't advance).
        mov rdi, 0;                       // SSID
        mov rsi, 0;                       // len 0
        mov rdx, 0;
        call nmg_ie_append;
        mov r11, 0xFFFFF429;              // NMG_NO_HDR
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 4. Beacon happy.
        mov rax, 4;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0x80;                    // BEACON
        mov rsi, 0x0102;                  // seqctl
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;

        call nmg_hdr_get_type;
        cmp rax, 0x80;
        jne nmgw_fail_stage;

        call nmg_hdr_get_seqctl;
        mov r11, 0x0102;
        cmp rax, r11;
        jne nmgw_fail_stage;

        call nmg_pos;
        cmp rax, 24;
        jne nmgw_fail_stage;

        // -- 5. ProbeReq / ProbeResp / AssocReq / Deauth.
        mov rax, 5;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0x40;                    // PROBE_REQ
        mov rsi, 0x1234;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;
        call nmg_hdr_get_type;
        cmp rax, 0x40;
        jne nmgw_fail_stage;
        call nmg_hdr_get_seqctl;
        mov r11, 0x1234;
        cmp rax, r11;
        jne nmgw_fail_stage;

        mov rdi, 0x50;                    // PROBE_RESP
        mov rsi, 0x5678;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;
        call nmg_hdr_get_type;
        cmp rax, 0x50;
        jne nmgw_fail_stage;

        mov rdi, 0x00;                    // ASSOC_REQ
        mov rsi, 0x9ABC;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;
        call nmg_hdr_get_type;
        cmp rax, 0x00;
        jne nmgw_fail_stage;

        mov rdi, 0xC0;                    // DEAUTH
        mov rsi, 0xDEAD;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;
        call nmg_hdr_get_type;
        cmp rax, 0xC0;
        jne nmgw_fail_stage;
        call nmg_hdr_get_seqctl;
        mov r11, 0xDEAD;
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 6. IE append + walk + find.  Beacon with SSID (len 4),
        //       Rates (len 2), RSN (len 6).
        mov rax, 6;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0x80;
        mov rsi, 0;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // Append SSID = "test" (0x74 65 73 74) at offset 24
        // (0x74657374 packed little-endian: bytes 74 73 65 74 read).
        // We just check that we can find & retrieve type + len.
        mov rdi, 0;                       // SSID
        mov rsi, 4;                       // len 4
        mov rdx, 0x74736574;
        call nmg_ie_append;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // After first append: pos = 24 + 2 + 4 = 30.
        call nmg_pos;
        cmp rax, 30;
        jne nmgw_fail_stage;

        // Append Rates (type 1, len 2, val 0x820C).
        mov rdi, 1;
        mov rsi, 2;
        mov rdx, 0x820C;
        call nmg_ie_append;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // After: pos = 30 + 2 + 2 = 34.
        call nmg_pos;
        cmp rax, 34;
        jne nmgw_fail_stage;

        // Append RSN (type 48, len 6, val arbitrary).
        mov rdi, 48;
        mov rsi, 6;
        mov rdx, 0x0123456789AB;
        call nmg_ie_append;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // After: pos = 34 + 2 + 6 = 42.
        call nmg_pos;
        cmp rax, 42;
        jne nmgw_fail_stage;

        // Read IE type at offset 24 == SSID (0).
        mov rdi, 24;
        call nmg_ie_type_at;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // Read IE len at offset 24 == 4.
        mov rdi, 24;
        call nmg_ie_len_at;
        cmp rax, 4;
        jne nmgw_fail_stage;

        // Walk: next after 24 is 30 (first Rates).
        mov rdi, 24;
        call nmg_ie_next;
        cmp rax, 30;
        jne nmgw_fail_stage;

        // At 30: type == 1 (Rates), len == 2.
        mov rdi, 30;
        call nmg_ie_type_at;
        cmp rax, 1;
        jne nmgw_fail_stage;
        mov rdi, 30;
        call nmg_ie_len_at;
        cmp rax, 2;
        jne nmgw_fail_stage;

        // Walk: next after 30 is 34 (RSN).
        mov rdi, 30;
        call nmg_ie_next;
        cmp rax, 34;
        jne nmgw_fail_stage;

        // At 34: type == 48 (RSN), len == 6.
        mov rdi, 34;
        call nmg_ie_type_at;
        cmp rax, 48;
        jne nmgw_fail_stage;
        mov rdi, 34;
        call nmg_ie_len_at;
        cmp rax, 6;
        jne nmgw_fail_stage;

        // Walk beyond RSN: next == pos == 42 -> NOT_FOUND.
        mov rdi, 34;
        call nmg_ie_next;
        mov r11, 0xFFFFF42B;              // NMG_IE_NOT_FOUND
        cmp rax, r11;
        jne nmgw_fail_stage;

        // Find SSID -> 24.
        mov rdi, 0;
        call nmg_ie_find;
        cmp rax, 24;
        jne nmgw_fail_stage;

        // Find Rates -> 30.
        mov rdi, 1;
        call nmg_ie_find;
        cmp rax, 30;
        jne nmgw_fail_stage;

        // Find RSN -> 34.
        mov rdi, 48;
        call nmg_ie_find;
        cmp rax, 34;
        jne nmgw_fail_stage;

        // -- 7. Find missing type (e.g. 99) -> NOT_FOUND.
        mov rax, 7;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 99;
        call nmg_ie_find;
        mov r11, 0xFFFFF42B;
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 8. BAD_ARG on ie_len > 8.
        mov rax, 8;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 9;
        mov rdx, 0;
        call nmg_ie_append;
        mov r11, 0xFFFFF42F;
        cmp rax, r11;
        jne nmgw_fail_stage;

        // BAD_ARG on ie_type > 255.
        mov rdi, 256;
        mov rsi, 0;
        mov rdx, 0;
        call nmg_ie_append;
        mov r11, 0xFFFFF42F;
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 9. FRAME_FULL: reset + hdr + fill until refuse.
        mov rax, 9;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        mov rdi, 0x80;
        mov rsi, 0;
        call nmg_hdr_encode;
        cmp rax, 0;
        jne nmgw_fail_stage;

        // 24 header bytes; each append adds 10 bytes (type+len+8).
        // 256 - 24 = 232 bytes available; 232 / 10 = 23 full appends.
      nmgw_fill_loop:
        mov rdi, 5;                       // arbitrary type
        mov rsi, 8;                       // max len
        mov rdx, 0x1122334455667788;
        call nmg_ie_append;
        cmp rax, 0;
        je  nmgw_fill_loop;

        // Must have refused with FRAME_FULL (or BAD_ARG -- but
        // we set valid args so FULL only).
        mov r11, 0xFFFFF42A;              // NMG_FRAME_FULL
        cmp rax, r11;
        jne nmgw_fail_stage;

        // -- 10. Counter fanout.
        mov rax, 10;
        lea rcx, [rip + _nmgw_stage];
        mov [rcx], rax;

        // HDR_ENCODES = 6 (stages 4, 5x4, 6, 9) = 7.  Let's just
        // check it's > 5.
        mov rdi, 0;
        call nmg_stat;
        cmp rax, 5;
        jbe nmgw_fail_stage;

        // REFUSED > 0.
        mov rdi, 4;
        call nmg_stat;
        cmp rax, 0;
        je  nmgw_fail_stage;

        // NOT_FOUND >= 2 (stages 6+7).
        mov rdi, 5;
        call nmg_stat;
        cmp rax, 2;
        jb  nmgw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nmgw_ok];
        call klog_s1;

        call nmg_reset;
        xor rax, rax;
        jmp nmgw_out;

      nmgw_fail_stage:
        lea rax, [rip + _nmgw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nmgw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nmg_reset;
        mov rax, 1;

      nmgw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
