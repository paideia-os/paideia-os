// tests/kernel/drivers/wifi/net80211_mlme_synth.pdx — R38.M4-003 (#1306)
//
// Boot witness for net80211_mlme.  Exercises PMF modes admission
// gate + SA Query state machine end-to-end: start / respond /
// timeout / mismatched id / respond after IDLE / respond after
// TIMEOUT / tick during IDLE (no-op) / start while PENDING (BUSY)
// / start with zero id + zero ticks / BAD_MODE.
//
// Fingerprint: NET80211 MLME OK

module Net80211MlmeSynth = structure {

  pub let mut _nmlw_stage : u64 = 0

  pub let nmlw_ok   : [u8; 18] = "NET80211 MLME OK\0"
  pub let nmlw_fail : [u8; 20] = "NET80211 MLME FAIL\0"

  pub let nml_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M4-003 (#1306): boot witness. Stages: (1) reset + arbitration pin + defaults. (2) PMF DISABLED admits both is_protected values. (3) CAPABLE admits both. (4) REQUIRED refuses is_protected==0. (5) BAD_MODE. (6) SAQ: start(0,X) ZERO_ID; start(X,0) ZERO_TICKS. (7) SAQ start happy PENDING. (8) SAQ start while PENDING refuses BUSY. (9) SAQ respond wrong id MISMATCH. (10) SAQ tick less than remaining stays PENDING. (11) SAQ respond right id -> IDLE. (12) SAQ respond while IDLE refuses NOT_PENDING. (13) SAQ tick during IDLE no-op admit. (14) SAQ start again, tick past remaining -> TIMEOUT + SAQ_TIMEOUTS bumped. (15) SAQ respond after TIMEOUT refuses TIMEOUT_STATE. (16) SAQ start while TIMEOUT refuses BUSY. (17) reset clears back to IDLE. (18) counter fanout.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. Reset + arbitration pin + defaults.
        mov rax, 1;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        call nml_reset;

        call nml_arbitrated;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_pmf_mode;
        cmp rax, 0;                       // DISABLED
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 0;                       // IDLE
        jne nmlw_fail_stage;

        // -- 2. DISABLED admits both is_protected values.
        mov rax, 2;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call nml_mgmt_admit;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 1;
        call nml_mgmt_admit;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 3. CAPABLE admits both.
        mov rax, 3;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // CAPABLE
        call nml_pmf_set_mode;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 0;
        call nml_mgmt_admit;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 1;
        call nml_mgmt_admit;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 4. REQUIRED refuses is_protected == 0.
        mov rax, 4;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 2;                       // REQUIRED
        call nml_pmf_set_mode;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 0;
        call nml_mgmt_admit;
        mov r11, 0xFFFFF40D;              // NML_PMF_REQUIRED_FAIL
        cmp rax, r11;
        jne nmlw_fail_stage;

        mov rdi, 1;
        call nml_mgmt_admit;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 5. BAD_MODE.
        mov rax, 5;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        call nml_pmf_set_mode;
        mov r11, 0xFFFFF40E;              // NML_BAD_MODE
        cmp rax, r11;
        jne nmlw_fail_stage;

        // Mode unchanged (still REQUIRED).
        call nml_pmf_mode;
        cmp rax, 2;
        jne nmlw_fail_stage;

        // -- 6. SAQ: bad arg gates.
        mov rax, 6;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 10;
        call nml_sa_query_start;
        mov r11, 0xFFFFF407;              // ZERO_ID
        cmp rax, r11;
        jne nmlw_fail_stage;

        mov rdi, 42;
        mov rsi, 0;
        call nml_sa_query_start;
        mov r11, 0xFFFFF408;              // ZERO_TICKS
        cmp rax, r11;
        jne nmlw_fail_stage;

        // State still IDLE.
        call nml_sa_query_state;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 7. SAQ start happy.
        mov rax, 7;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xC0DE;
        mov rsi, 100;
        call nml_sa_query_start;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 1;                       // PENDING
        jne nmlw_fail_stage;

        call nml_sa_query_id;
        mov r11, 0xC0DE;
        cmp rax, r11;
        jne nmlw_fail_stage;

        call nml_sa_query_ticks;
        cmp rax, 100;
        jne nmlw_fail_stage;

        // -- 8. Start while PENDING refuses BUSY.
        mov rax, 8;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xBEEF;
        mov rsi, 50;
        call nml_sa_query_start;
        mov r11, 0xFFFFF40C;
        cmp rax, r11;
        jne nmlw_fail_stage;

        // -- 9. Respond with wrong id MISMATCH.
        mov rax, 9;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0x1234;
        call nml_sa_query_respond;
        mov r11, 0xFFFFF40B;              // MISMATCH
        cmp rax, r11;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 1;                       // still PENDING
        jne nmlw_fail_stage;

        // -- 10. Tick less than remaining -> still PENDING.
        mov rax, 10;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 25;
        call nml_sa_query_tick;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_sa_query_ticks;
        cmp rax, 75;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 1;
        jne nmlw_fail_stage;

        // -- 11. Respond right id -> IDLE.
        mov rax, 11;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xC0DE;
        call nml_sa_query_respond;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 0;                       // IDLE
        jne nmlw_fail_stage;

        call nml_sa_query_id;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 12. Respond while IDLE refuses NOT_PENDING.
        mov rax, 12;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xC0DE;
        call nml_sa_query_respond;
        mov r11, 0xFFFFF40A;
        cmp rax, r11;
        jne nmlw_fail_stage;

        // -- 13. Tick during IDLE no-op admit.
        mov rax, 13;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 1000;
        call nml_sa_query_tick;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 14. Start again, tick past remaining -> TIMEOUT.
        mov rax, 14;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xF00D;
        mov rsi, 40;
        call nml_sa_query_start;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 40;                      // exactly deplete
        call nml_sa_query_tick;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_sa_query_state;
        cmp rax, 2;                       // TIMEOUT
        jne nmlw_fail_stage;

        call nml_sa_query_ticks;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 15. Respond after TIMEOUT refuses TIMEOUT_STATE.
        mov rax, 15;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xF00D;
        call nml_sa_query_respond;
        mov r11, 0xFFFFF409;
        cmp rax, r11;
        jne nmlw_fail_stage;

        // -- 16. Start while TIMEOUT refuses BUSY.
        mov rax, 16;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 0xABBA;
        mov rsi, 50;
        call nml_sa_query_start;
        mov r11, 0xFFFFF40C;
        cmp rax, r11;
        jne nmlw_fail_stage;

        // -- 17. Reset clears back to IDLE.
        mov rax, 17;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        call nml_reset;

        call nml_sa_query_state;
        cmp rax, 0;
        jne nmlw_fail_stage;

        call nml_pmf_mode;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // -- 18. Counter fanout.  Note: reset in stage 17 cleared
        //        the previous counters; run a small verification
        //        set to sanity-check the note/stat plumbing here.
        mov rax, 18;
        lea rcx, [rip + _nmlw_stage];
        mov [rcx], rax;

        mov rdi, 1;                       // CAPABLE
        call nml_pmf_set_mode;
        cmp rax, 0;
        jne nmlw_fail_stage;

        // MODE_SETS == 1.
        mov rdi, 0;
        call nml_stat;
        cmp rax, 1;
        jne nmlw_fail_stage;

        // Start / respond one transaction: SAQ_STARTS + SAQ_RESPONDS both == 1.
        mov rdi, 0x77;
        mov rsi, 10;
        call nml_sa_query_start;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 0x77;
        call nml_sa_query_respond;
        cmp rax, 0;
        jne nmlw_fail_stage;

        mov rdi, 3;
        call nml_stat;
        cmp rax, 1;
        jne nmlw_fail_stage;

        mov rdi, 4;
        call nml_stat;
        cmp rax, 1;
        jne nmlw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nmlw_ok];
        call klog_s1;

        call nml_reset;
        xor rax, rax;
        jmp nmlw_out;

      nmlw_fail_stage:
        lea rax, [rip + _nmlw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nmlw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nml_reset;
        mov rax, 1;

      nmlw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
