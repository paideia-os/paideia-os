// tests/kernel/drivers/wifi/rekey_synth.pdx — R38.M7-004 (#1321)
//
// Boot witness for rekey.  Exercises:
//   (1) reset + arbitration pin + IDLE.
//   (2) trigger without session refused NO_SESSION.
//   (3) bind_session with zero slot refused; valid bind admits.
//   (4) trigger IDLE -> TRIGGERED; second trigger refused ALREADY.
//   (5) arm with same-slot refused ALREADY; arm with fresh slot admits.
//   (6) verify_done refused before W4H_DONE; drive w4h to DONE, verify OK.
//   (7) rotate refused zero + same-as-current; fresh rotate admits;
//       retired_slot populated; rotate_count == 1.
//   (8) retire_old drops the slot; second retire refused ALREADY.
//
// Fingerprint: REKEY OK

module RekeySynth = structure {

  pub let mut _rkw_stage : u64 = 0

  pub let rkw_ok   : [u8; 10] = "REKEY OK\n\0"
  pub let rkw_fail : [u8; 12] = "REKEY FAIL\n\0"

  pub let rk_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M7-004 (#1321): boot witness. Stages: (1) reset + arbitration pin + IDLE. (2) trigger without session. (3) bind gate. (4) trigger + already. (5) arm gate. (6) verify_done gate. (7) rotate + retired_slot. (8) retire_old + already.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -- 1. reset + arbitration pin.
        mov rax, 1;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        call rk_reset;
        call w4h_reset;

        call rk_arbitrated;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 0;                       // IDLE
        jne rkw_fail_stage;

        call rk_current_key_slot;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_retired_slot;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_rotate_count;
        cmp rax, 0;
        jne rkw_fail_stage;

        // -- 2. trigger without session refused.
        mov rax, 2;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        call rk_trigger;
        mov r11, 0xFFFFF33D;              // NO_SESSION
        cmp rax, r11;
        jne rkw_fail_stage;

        // -- 3. bind_session gate.
        mov rax, 3;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        // Zero pmk refused.
        mov rdi, 0;
        mov rsi, 20;
        call rk_bind_session;
        mov r11, 0xFFFFF33B;              // ZERO_SLOT
        cmp rax, r11;
        jne rkw_fail_stage;

        // Zero key refused.
        mov rdi, 10;
        mov rsi, 0;
        call rk_bind_session;
        mov r11, 0xFFFFF33B;
        cmp rax, r11;
        jne rkw_fail_stage;

        // Valid: pmk=10, key=20.
        mov rdi, 10;
        mov rsi, 20;
        call rk_bind_session;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_current_key_slot;
        cmp rax, 20;
        jne rkw_fail_stage;

        // -- 4. trigger + already.
        mov rax, 4;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        call rk_trigger;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 1;                       // TRIGGERED
        jne rkw_fail_stage;

        call rk_trigger;
        mov r11, 0xFFFFF33C;              // ALREADY
        cmp rax, r11;
        jne rkw_fail_stage;

        // -- 5. arm gate.
        mov rax, 5;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        // Zero next-pmk refused.
        mov rdi, 0;
        mov rsi, 30;
        call rk_arm;
        mov r11, 0xFFFFF33B;
        cmp rax, r11;
        jne rkw_fail_stage;

        // Same as current refused.
        mov rdi, 10;
        mov rsi, 30;
        call rk_arm;
        mov r11, 0xFFFFF33C;              // ALREADY
        cmp rax, r11;
        jne rkw_fail_stage;

        // Fresh pmk=11 with crypto_ep=30 admits.
        mov rdi, 11;
        mov rsi, 30;
        call rk_arm;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 2;                       // ARMED
        jne rkw_fail_stage;

        // -- 6. verify_done gate.
        mov rax, 6;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        // Before advancing w4h, verify_done should fail (state == AWAIT_M1).
        call rk_verify_done;
        mov r11, 0xFFFFF339;              // VERIFY_FAILED
        cmp rax, r11;
        jne rkw_fail_stage;

        // The rk_arm above transitioned rk_state to FAILED after
        // verify_failed; re-enter the flow.  Reset rk, keep w4h.
        call rk_reset;
        call w4h_reset;
        mov rdi, 10;
        mov rsi, 20;
        call rk_bind_session;
        cmp rax, 0;
        jne rkw_fail_stage;
        call rk_trigger;
        cmp rax, 0;
        jne rkw_fail_stage;
        mov rdi, 11;
        mov rsi, 30;
        call rk_arm;
        cmp rax, 0;
        jne rkw_fail_stage;

        // Drive w4h through M1, M3, M4 to reach W4H_DONE.
        // w4h_m1_recv(anonce, snonce, ptk_slot).
        mov rdi, 0xAA11;                  // anonce
        mov rsi, 0xBB22;                  // snonce
        mov rdx, 0xDD44;                  // ptk_slot
        call w4h_m1_recv;
        cmp rax, 0;
        jne rkw_fail_stage;
        // w4h_m3_recv(mic_ok, gtk_slot).
        mov rdi, 1;                       // mic_ok
        mov rsi, 0xCC33;                  // gtk_slot
        call w4h_m3_recv;
        cmp rax, 0;
        jne rkw_fail_stage;
        // w4h_m4_sent() -> DONE.
        call w4h_m4_sent;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_verify_done;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 3;                       // ROTATING
        jne rkw_fail_stage;

        // -- 7. rotate gate.
        mov rax, 7;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call rk_rotate;
        mov r11, 0xFFFFF33B;              // ZERO_SLOT
        cmp rax, r11;
        jne rkw_fail_stage;

        mov rdi, 20;                      // same as current key
        call rk_rotate;
        mov r11, 0xFFFFF33C;              // ALREADY
        cmp rax, r11;
        jne rkw_fail_stage;

        mov rdi, 21;                      // fresh
        call rk_rotate;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_current_key_slot;
        cmp rax, 21;
        jne rkw_fail_stage;

        call rk_retired_slot;
        cmp rax, 20;                      // old key retained
        jne rkw_fail_stage;

        call rk_rotate_count;
        cmp rax, 1;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 4;                       // DONE
        jne rkw_fail_stage;

        // -- 8. retire_old.
        mov rax, 8;
        lea rcx, [rip + _rkw_stage];
        mov [rcx], rax;

        call rk_retire_old;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_retired_slot;
        cmp rax, 0;
        jne rkw_fail_stage;

        call rk_state_get;
        cmp rax, 0;                       // -> IDLE after DONE
        jne rkw_fail_stage;

        call rk_retire_old;
        mov r11, 0xFFFFF33C;              // ALREADY
        cmp rax, r11;
        jne rkw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rkw_ok];
        call klog_s1;

        call rk_reset;
        call w4h_reset;
        xor rax, rax;
        jmp rkw_out;

      rkw_fail_stage:
        lea rax, [rip + _rkw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + rkw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call rk_reset;
        call w4h_reset;
        mov rax, 1;

      rkw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
