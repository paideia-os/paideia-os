// tests/kernel/drivers/wifi/wpa_4way_synth.pdx — R38.M5-003 (#1311)
//
// Boot witness for the WPA 4-way handshake state machine.  Asserts:
//   (1) w4h_reset yields INIT + all fields zero;
//   (2) arm(pmk, ep) requires non-zero pmk + ep, INIT -> AWAIT_M1;
//   (3) arm while != INIT refused as BUSY;
//   (4) m1_recv admits AWAIT_M1 -> AWAIT_M3 + records anonce/snonce/ptk;
//   (5) m1_recv without pmk refused;
//   (6) m3_recv with mic_ok=0 -> FAILED (KRACK-adjacent);
//   (7) happy-path m3_recv(mic_ok=1, gtk) -> AWAIT_M4;
//   (8) m4_sent AWAIT_M4 -> DONE;
//   (9) invalid state transitions refused.
//
// Fingerprint: R38 WPA 4WAY OK

module Wpa4waySynth = structure {

  pub let mut _w4hw_stage : u64 = 0

  pub let w4hw_ok   : [u8; 16] = "R38 WPA 4WAY OK\n\0"
  pub let w4hw_fail : [u8; 18] = "R38 WPA 4WAY FAIL\n\0"

  pub let wpa_4way_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R38.M5-003 (#1311): boot witness. Stages: (1) reset. (2) arm INIT->AWAIT_M1. (3) arm while != INIT BUSY. (4) m1_recv AWAIT_M1->AWAIT_M3. (5) m1_recv without pmk. (6) m3_recv MIC=0 -> FAILED. (7) happy-path m3_recv. (8) m4_sent AWAIT_M4->DONE. (9) invalid transitions.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        // -- 1. Reset.
        call w4h_reset;
        call w4h_state_get;
        cmp rax, 0;
        jne w4hw_fail_stage;

        // -- 2. arm INIT -> AWAIT_M1.
        mov rax, 2;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        // arm(0, ep) refused.
        mov rdi, 0;
        mov rsi, 0x0042;
        call w4h_arm;
        mov r11, 0xFFFFF3CD;             // ZERO_PMK
        cmp rax, r11;
        jne w4hw_fail_stage;

        // arm(pmk, 0) refused.
        mov rdi, 0x00A1;
        mov rsi, 0;
        call w4h_arm;
        mov r11, 0xFFFFF3CC;             // ZERO_CRYPTO_EP
        cmp rax, r11;
        jne w4hw_fail_stage;

        // arm(pmk, ep) admitted.
        mov rdi, 0x00A1;                 // pmk_slot
        mov rsi, 0x0042;                 // crypto_ep_slot
        call w4h_arm;
        cmp rax, 0;
        jne w4hw_fail_stage;

        call w4h_state_get;
        cmp rax, 1;                      // AWAIT_M1
        jne w4hw_fail_stage;

        call w4h_pmk_slot;
        cmp rax, 0x00A1;
        jne w4hw_fail_stage;

        // -- 3. arm while AWAIT_M1 refused as BUSY.
        mov rax, 3;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        mov rdi, 0x00A1;
        mov rsi, 0x0042;
        call w4h_arm;
        mov r11, 0xFFFFF3C5;             // BUSY
        cmp rax, r11;
        jne w4hw_fail_stage;

        // -- 4. m1_recv AWAIT_M1 -> AWAIT_M3.
        mov rax, 4;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        mov rdi, 0x0111AAAA;             // anonce
        mov rsi, 0x0222BBBB;             // snonce
        mov rdx, 0x00B2;                 // ptk_slot (KIND_WIFI_KEY)
        call w4h_m1_recv;
        cmp rax, 0;
        jne w4hw_fail_stage;

        call w4h_state_get;
        cmp rax, 2;                      // AWAIT_M3
        jne w4hw_fail_stage;

        call w4h_anonce;
        mov r11, 0x0111AAAA;
        cmp rax, r11;
        jne w4hw_fail_stage;

        call w4h_snonce;
        mov r11, 0x0222BBBB;
        cmp rax, r11;
        jne w4hw_fail_stage;

        call w4h_ptk_slot;
        cmp rax, 0x00B2;
        jne w4hw_fail_stage;

        // -- 5. m1_recv from wrong state refused.
        mov rax, 5;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        mov rdi, 0x1111;
        mov rsi, 0x2222;
        mov rdx, 0x00B2;
        call w4h_m1_recv;
        mov r11, 0xFFFFF3C7;             // INVALID_TRANSITION
        cmp rax, r11;
        jne w4hw_fail_stage;

        // -- 6. m3_recv with MIC=0 -> FAILED.
        mov rax, 6;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // mic_ok=0
        mov rsi, 0x00C3;                 // gtk_slot
        call w4h_m3_recv;
        mov r11, 0xFFFFF3C8;             // MIC_FAILED
        cmp rax, r11;
        jne w4hw_fail_stage;

        call w4h_state_get;
        cmp rax, 5;                      // FAILED
        jne w4hw_fail_stage;

        // -- 7. Happy-path: reset + rearm + drive to DONE.
        mov rax, 7;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        call w4h_reset;

        mov rdi, 0x00A1;
        mov rsi, 0x0042;
        call w4h_arm;
        cmp rax, 0;
        jne w4hw_fail_stage;

        mov rdi, 0x0111AAAA;
        mov rsi, 0x0222BBBB;
        mov rdx, 0x00B2;
        call w4h_m1_recv;
        cmp rax, 0;
        jne w4hw_fail_stage;

        // m3_recv with gtk=0 refused (ZERO_GTK).
        mov rdi, 1;
        mov rsi, 0;
        call w4h_m3_recv;
        mov r11, 0xFFFFF3C9;             // ZERO_GTK
        cmp rax, r11;
        jne w4hw_fail_stage;

        // Happy path m3_recv.
        mov rdi, 1;
        mov rsi, 0x00C3;
        call w4h_m3_recv;
        cmp rax, 0;
        jne w4hw_fail_stage;

        call w4h_state_get;
        cmp rax, 3;                      // AWAIT_M4
        jne w4hw_fail_stage;

        call w4h_gtk_slot;
        cmp rax, 0x00C3;
        jne w4hw_fail_stage;

        // -- 8. m4_sent AWAIT_M4 -> DONE.
        mov rax, 8;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        call w4h_m4_sent;
        cmp rax, 0;
        jne w4hw_fail_stage;

        call w4h_state_get;
        cmp rax, 4;                      // DONE
        jne w4hw_fail_stage;

        // -- 9. Invalid: m4_sent again from DONE refused.
        mov rax, 9;
        lea rcx, [rip + _w4hw_stage];
        mov [rcx], rax;

        call w4h_m4_sent;
        mov r11, 0xFFFFF3C7;             // INVALID_TRANSITION
        cmp rax, r11;
        jne w4hw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + w4hw_ok];
        call klog_s1;

        call w4h_reset;
        xor rax, rax;
        jmp w4hw_out;

      w4hw_fail_stage:
        lea rax, [rip + _w4hw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + w4hw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call w4h_reset;
        mov rax, 1;

      w4hw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
