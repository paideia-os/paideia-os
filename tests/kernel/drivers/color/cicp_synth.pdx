// tests/kernel/drivers/color/cicp_synth.pdx -- G6.M1-002 (#1510)
//
// Boot witness for the CICP parser. Exercises validators, named
// triplet recognition, and primaries mapping.
//
// Fingerprint: G6 CICP OK

module CicpSynth = structure {

  pub let mut _ccw_stage : u64 = 0

  pub let ccw_ok   : [u8; 11] = "G6 CICP OK\0"
  pub let ccw_fail : [u8; 13] = "G6 CICP FAIL\0"

  pub let cicp_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M1-002 (#1510): CICP parser witness. Stages: (1) reset. (2) colour_valid. (3) transfer_valid. (4) matrix_valid. (5) sRGB name. (6) Rec.709 name. (7) HDR10 name. (8) unknown-but-valid. (9) bad colour refused. (10) named -> primaries. Five-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        call cicp_stats_reset;

        // 2. colour.
        mov rax, 2;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call cicp_colour_valid;
        cmp rax, 1;
        jne ccw_fail_stage;
        mov rdi, 22;
        call cicp_colour_valid;
        cmp rax, 1;
        jne ccw_fail_stage;
        mov rdi, 0;
        call cicp_colour_valid;
        cmp rax, 0;
        jne ccw_fail_stage;

        // 3. transfer.
        mov rax, 3;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 13;
        call cicp_transfer_valid;
        cmp rax, 1;
        jne ccw_fail_stage;
        mov rdi, 19;
        call cicp_transfer_valid;
        cmp rax, 0;
        jne ccw_fail_stage;

        // 4. matrix.
        mov rax, 4;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call cicp_matrix_valid;
        cmp rax, 1;
        jne ccw_fail_stage;
        mov rdi, 15;
        call cicp_matrix_valid;
        cmp rax, 0;
        jne ccw_fail_stage;

        // 5. sRGB (1, 13, 0) -> CICP_NAME_SRGB = 1.
        mov rax, 5;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 13;
        mov rdx, 0;
        call cicp_parse;
        cmp rax, 1;
        jne ccw_fail_stage;

        // 6. Rec.709 (1, 1, 1) -> CICP_NAME_REC709 = 3.
        mov rax, 6;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 1;
        mov rdx, 1;
        call cicp_parse;
        cmp rax, 3;
        jne ccw_fail_stage;

        // 7. HDR10 (9, 16, 9) -> CICP_NAME_HDR10 = 4.
        mov rax, 7;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 9;
        mov rsi, 16;
        mov rdx, 9;
        call cicp_parse;
        cmp rax, 4;
        jne ccw_fail_stage;

        // 8. Unknown-but-valid (6, 6, 6) -> 0.
        mov rax, 8;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 6;
        mov rsi, 6;
        mov rdx, 6;
        call cicp_parse;
        cmp rax, 0;
        jne ccw_fail_stage;

        // 9. Bad colour (0, 13, 0) -> failure code.
        mov rax, 9;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 13;
        mov rdx, 0;
        call cicp_parse;
        mov r10, 0xFFFFED6F;
        cmp rax, r10;
        jne ccw_fail_stage;

        // 10. named -> primaries.
        mov rax, 10;
        lea rcx, [rip + _ccw_stage];
        mov [rcx], rax;
        mov rdi, 4;                         // HDR10
        call cicp_named_to_primaries;
        cmp rax, 4;                         // PRIM_REC2020
        jne ccw_fail_stage;
        mov rdi, 1;                         // sRGB
        call cicp_named_to_primaries;
        cmp rax, 1;                         // PRIM_SRGB
        jne ccw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ccw_ok];
        call klog_s1;

        xor rax, rax;
        jmp ccw_out;

      ccw_fail_stage:
        lea rax, [rip + _ccw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ccw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      ccw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
