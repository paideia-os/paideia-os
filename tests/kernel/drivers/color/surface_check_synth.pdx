// tests/kernel/drivers/color/surface_check_synth.pdx -- G6.M1-005 (#1513)
//
// Boot witness for the P5 surface-commit check: refuses a commit
// without exactly one live KIND_COLOR_PROFILE argument.
//
// Fingerprint: G6 SURFACE_CHECK OK

module SurfaceCheckSynth = structure {

  pub let mut _scw_stage : u64 = 0

  pub let scw_ok   : [u8; 20] = "G6 SURFACE_CHECK OK\0"
  pub let scw_fail : [u8; 22] = "G6 SURFACE_CHECK FAIL\0"

  // Synthetic argument arrays. kinds_a[] holds one KIND_COLOR_PROFILE
  // and one KIND_PAGE; kinds_b[] holds two KIND_COLOR_PROFILE (refused);
  // kinds_c[] holds only KIND_PAGE (refused).
  pub let mut _scw_kinds_a : [u64; 2] = uninit @align(64)
  pub let mut _scw_rows_a  : [u64; 2] = uninit @align(64)
  pub let mut _scw_kinds_b : [u64; 2] = uninit @align(64)
  pub let mut _scw_rows_b  : [u64; 2] = uninit @align(64)
  pub let mut _scw_kinds_c : [u64; 2] = uninit @align(64)
  pub let mut _scw_rows_c  : [u64; 2] = uninit @align(64)

  pub let surface_check_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M1-005 (#1513): P5 witness. Stages: (1) reset. (2) empty refused. (3) noprof refused. (4) two-profile refused. (5) mint a profile then good-commit accepted. (6) dead-row refused.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        call sc_stats_reset;
        call cp_table_reset;

        // 2. Empty args -> SC_EMPTY_ARGS.
        mov rax, 2;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        lea rdi, [rip + _scw_kinds_a];
        lea rsi, [rip + _scw_rows_a];
        mov rdx, 0;
        call surface_commit_check;
        mov r10, 0xFFFFED8F;
        cmp rax, r10;
        jne scw_fail_stage;

        // 3. Populate kinds_c[] = {KIND_PAGE (4), KIND_PAGE}.
        mov rax, 3;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        lea r10, [rip + _scw_kinds_c];
        mov rax, 4;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        lea rdi, [rip + _scw_kinds_c];
        lea rsi, [rip + _scw_rows_c];
        mov rdx, 2;
        call surface_commit_check;
        mov r10, 0xFFFFED8E;
        cmp rax, r10;
        jne scw_fail_stage;

        // 4. Populate kinds_b[] = {0x18F, 0x18F} (two profiles).
        mov rax, 4;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        lea r10, [rip + _scw_kinds_b];
        mov rax, 0x18F;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        lea rdi, [rip + _scw_kinds_b];
        lea rsi, [rip + _scw_rows_b];
        mov rdx, 2;
        call surface_commit_check;
        mov r10, 0xFFFFED8D;
        cmp rax, r10;
        jne scw_fail_stage;

        // 5. Mint a profile at row 0, then commit good args_a =
        //    {KIND_PAGE, 0x18F} with rows_a = {0, 0}. Should pass.
        mov rax, 5;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 13;
        mov rdx, 0;
        mov rcx, 1;
        mov r8, 0;
        call cp_body1_pack;
        mov r12, rax;
        mov rdi, 0;
        mov rsi, 0;
        call cp_body2_pack;
        mov r13, rax;
        mov rdi, 0;
        call cp_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xBADC0FFE;
        mov rdx, r12;
        mov rcx, r13;
        call cp_tail_alloc;
        cmp rax, 0;
        jne scw_fail_stage;

        lea r10, [rip + _scw_kinds_a];
        mov rax, 4;                         // KIND_PAGE
        mov [r10 + 0], rax;
        mov rax, 0x18F;                     // KIND_COLOR_PROFILE
        mov [r10 + 8], rax;
        lea r10, [rip + _scw_rows_a];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;                 // row 0

        lea rdi, [rip + _scw_kinds_a];
        lea rsi, [rip + _scw_rows_a];
        mov rdx, 2;
        call surface_commit_check;
        cmp rax, 0;
        jne scw_fail_stage;

        // 6. Free row 0, retry -> SC_DEAD_PROFILE.
        mov rax, 6;
        lea rcx, [rip + _scw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call cp_tail_free;
        lea rdi, [rip + _scw_kinds_a];
        lea rsi, [rip + _scw_rows_a];
        mov rdx, 2;
        call surface_commit_check;
        mov r10, 0xFFFFED8C;
        cmp rax, r10;
        jne scw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scw_ok];
        call klog_s1;
        call cp_table_reset;
        xor rax, rax;
        jmp scw_out;

      scw_fail_stage:
        lea rax, [rip + _scw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call cp_table_reset;
        mov rax, 1;

      scw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
