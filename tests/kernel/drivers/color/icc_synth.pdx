// tests/kernel/drivers/color/icc_synth.pdx -- G6.M1-003 (#1511)
//
// Boot witness for the ICC v4 parser. Builds a synthetic 144-byte
// v4 profile blob with an 'rXYZ' tag; exercises the header
// validation and shape-detection path plus two failure edges.
//
// Fingerprint: G6 ICC OK

module IccSynth = structure {

  pub let mut _icw_stage : u64 = 0

  pub let icw_ok   : [u8; 10] = "G6 ICC OK\0"
  pub let icw_fail : [u8; 12] = "G6 ICC FAIL\0"

  // Synthetic 144-byte ICC v4 blob. profile_size = 144, version =
  // 4.0.0, magic = 'acsp', tag_count = 1, tag[0].sig = 'rXYZ'.
  pub let _icw_blob : [u8; 144] = [
    // [+0..3] profile_size = 144 (BE 0x00000090)
    0x00u8, 0x00u8, 0x00u8, 0x90u8,
    // [+4..7] preferred_cmm
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // [+8..11] version 4.0.0
    0x04u8, 0x00u8, 0x00u8, 0x00u8,
    // [+12..15] profile_class 'mntr'
    0x6Du8, 0x6Eu8, 0x74u8, 0x72u8,
    // [+16..19] data_colour_space 'RGB '
    0x52u8, 0x47u8, 0x42u8, 0x20u8,
    // [+20..23] PCS 'XYZ '
    0x58u8, 0x59u8, 0x5Au8, 0x20u8,
    // [+24..35] creation_datetime (12 bytes zero)
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // [+36..39] magic 'acsp'
    0x61u8, 0x63u8, 0x73u8, 0x70u8,
    // [+40..127] reserved / other header fields (88 bytes zero)
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // [+128..131] tag_count = 1
    0x00u8, 0x00u8, 0x00u8, 0x01u8,
    // [+132..135] tag[0].sig 'rXYZ'
    0x72u8, 0x58u8, 0x59u8, 0x5Au8,
    // [+136..139] tag[0].offset (unused for shape detect)
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // [+140..143] tag[0].size
    0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  pub let icc_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M1-003 (#1511): ICC parser witness. Stages: (1) reset. (2) short-blob refused. (3) good-blob header ok. (4) shape detect -> matrix. Three-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _icw_stage];
        mov [rcx], rax;
        call icc_stats_reset;

        // 2. Short blob -> TOO_SHORT.
        mov rax, 2;
        lea rcx, [rip + _icw_stage];
        mov [rcx], rax;
        lea rdi, [rip + _icw_blob];
        mov rsi, 100;
        call icc_parse_header;
        mov r10, 0xFFFFED7F;
        cmp rax, r10;
        jne icw_fail_stage;

        // 3. Header ok.
        mov rax, 3;
        lea rcx, [rip + _icw_stage];
        mov [rcx], rax;
        lea rdi, [rip + _icw_blob];
        mov rsi, 144;
        call icc_parse_header;
        cmp rax, 0;
        jne icw_fail_stage;

        // 4. Shape detect -> matrix (1).
        mov rax, 4;
        lea rcx, [rip + _icw_stage];
        mov [rcx], rax;
        lea rdi, [rip + _icw_blob];
        mov rsi, 144;
        call icc_detect_shape;
        cmp rax, 1;
        jne icw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + icw_ok];
        call klog_s1;
        xor rax, rax;
        jmp icw_out;

      icw_fail_stage:
        lea rax, [rip + _icw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + icw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      icw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
