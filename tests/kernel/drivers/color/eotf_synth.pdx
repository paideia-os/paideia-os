// tests/kernel/drivers/color/eotf_synth.pdx -- G6.M2-002 (#1515)
//
// Boot witness for the EOTF/OETF pipeline. Installs a synthetic
// 65-sample curve for the sRGB EOTF and reads back samples.
//
// Fingerprint: G6 EOTF OK

module EotfSynth = structure {

  pub let mut _eow_stage : u64 = 0

  pub let eow_ok   : [u8; 11] = "G6 EOTF OK\0"
  pub let eow_fail : [u8; 13] = "G6 EOTF FAIL\0"

  // Synthetic 65-sample gradient: sample[i] = i * 0x100.
  pub let mut _eow_samples : [u64; 65] = uninit @align(64)

  pub let eotf_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M2-002 (#1515): curve witness. Stages: (1) reset. (2) ord_valid. (3) fill samples. (4) install sRGB EOTF. (5) sample readback. (6) bad ord install refused. Three-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        call eotf_stats_reset;

        // 2. ord_valid.
        mov rax, 2;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call eotf_ord_valid;
        cmp rax, 1;
        jne eow_fail_stage;
        mov rdi, 5;
        call eotf_ord_valid;
        cmp rax, 0;
        jne eow_fail_stage;

        // 3. Fill sample[i] = i * 0x100.
        mov rax, 3;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        xor rbx, rbx;
        lea r12, [rip + _eow_samples];
      eow_fill:
        cmp rbx, 65;
        jae eow_installed;
        mov rax, rbx;
        shl rax, 8;
        mov [r12 + rbx * 8], rax;
        add rbx, 1;
        jmp eow_fill;
      eow_installed:

        // 4. Install (kind=0 EOTF, ord=1 sRGB, samples).
        mov rax, 4;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        lea rdx, [rip + _eow_samples];
        call eotf_install;
        cmp rax, 0;
        jne eow_fail_stage;

        // 5. sample[10] == 10*0x100 == 0xA00. sample[64] == 0x4000.
        mov rax, 5;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 10;
        call eotf_sample;
        mov r10, 0xA00;
        cmp rax, r10;
        jne eow_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 64;
        call eotf_sample;
        mov r10, 0x4000;
        cmp rax, r10;
        jne eow_fail_stage;

        // 6. Bad ord install refused.
        mov rax, 6;
        lea rcx, [rip + _eow_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 5;
        lea rdx, [rip + _eow_samples];
        call eotf_install;
        mov r10, 0xFFFFEDAF;
        cmp rax, r10;
        jne eow_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + eow_ok];
        call klog_s1;
        xor rax, rax;
        jmp eow_out;

      eow_fail_stage:
        lea rax, [rip + _eow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + eow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      eow_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
