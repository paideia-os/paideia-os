// tests/kernel/drivers/color/gpu_convert_synth.pdx -- G6.M2-001 (#1514)
//
// Boot witness for the GPU compute conversion pipelines. Uploads a
// synthetic 9-coefficient matrix and reads it back.
//
// Fingerprint: G6 GPU_CONVERT OK

module GpuConvertSynth = structure {

  pub let mut _gcvw_stage : u64 = 0

  pub let gcvw_ok   : [u8; 18] = "G6 GPU_CONVERT OK\0"
  pub let gcvw_fail : [u8; 20] = "G6 GPU_CONVERT FAIL\0"

  pub let _gcvw_matrix : [u64; 9] = [
    0x10, 0x20, 0x30,
    0x40, 0x50, 0x60,
    0x70, 0x80, 0x90
  ]

  pub let gpu_convert_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M2-001 (#1514): matrix witness. Stages: (1) reset. (2) ord_valid. (3) upload sRGB->2020. (4) hash roundtrip. (5) coeff readback. (6) upload bad ord refused. Three-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        call gcv_stats_reset;

        // 2. ord_valid.
        mov rax, 2;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call gcv_ord_valid;
        cmp rax, 1;
        jne gcvw_fail_stage;
        mov rdi, 6;
        call gcv_ord_valid;
        cmp rax, 1;
        jne gcvw_fail_stage;
        mov rdi, 7;
        call gcv_ord_valid;
        cmp rax, 0;
        jne gcvw_fail_stage;

        // 3. Upload matrix for ord 1 with hash 0xC0DEC01A.
        mov rax, 3;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        lea rsi, [rip + _gcvw_matrix];
        mov rdx, 0xC0DEC01A;
        call gcv_upload;
        cmp rax, 0;
        jne gcvw_fail_stage;

        // 4. Hash roundtrip.
        mov rax, 4;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call gcv_hash;
        mov r10, 0xC0DEC01A;
        cmp rax, r10;
        jne gcvw_fail_stage;

        // 5. Coeff readback: [0]=0x10, [4]=0x50, [8]=0x90.
        mov rax, 5;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0;
        call gcv_coeff;
        cmp rax, 0x10;
        jne gcvw_fail_stage;
        mov rdi, 1;
        mov rsi, 4;
        call gcv_coeff;
        cmp rax, 0x50;
        jne gcvw_fail_stage;
        mov rdi, 1;
        mov rsi, 8;
        call gcv_coeff;
        cmp rax, 0x90;
        jne gcvw_fail_stage;

        // 6. Bad ord upload refused.
        mov rax, 6;
        lea rcx, [rip + _gcvw_stage];
        mov [rcx], rax;
        mov rdi, 7;
        lea rsi, [rip + _gcvw_matrix];
        mov rdx, 0;
        call gcv_upload;
        mov r10, 0xFFFFED9F;
        cmp rax, r10;
        jne gcvw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gcvw_ok];
        call klog_s1;
        xor rax, rax;
        jmp gcvw_out;

      gcvw_fail_stage:
        lea rax, [rip + _gcvw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gcvw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      gcvw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
