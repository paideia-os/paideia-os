// tests/kernel/drivers/color/scrgb_synth.pdx -- G6.M2-003 (#1516)
//
// Boot witness for the scRGB-linear composition space.
//
// Fingerprint: G6 SCRGB OK

module ScrgbSynth = structure {

  pub let mut _sgw_stage : u64 = 0

  pub let sgw_ok   : [u8; 12] = "G6 SCRGB OK\0"
  pub let sgw_fail : [u8; 14] = "G6 SCRGB FAIL\0"

  pub let scrgb_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M2-003 (#1516): fp16 witness. Stages: (1) reset. (2) pack (1.0, 0.0, 0.0). (3) unpack R. (4) unpack G. (5) unpack B. (6) in_gamut yes (all fp16 <= 1.0). (7) in_gamut no (negative). (8) in_gamut no (> 1.0). (9) bad channel unpack. Three-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        call scrgb_stats_reset;

        // 2. Pack (FP16_ONE, FP16_ZERO, FP16_ZERO).
        mov rax, 2;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, 0x3C00;
        mov rsi, 0;
        mov rdx, 0;
        call scrgb_pack;
        // rax = 0x3C00 (R = 0x3C00, G = 0, B = 0).
        mov r10, 0x3C00;
        cmp rax, r10;
        jne sgw_fail_stage;
        mov r12, rax;                       // remember packed pixel

        // 3. Unpack R -> 0x3C00.
        mov rax, 3;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 0;
        call scrgb_unpack_channel;
        mov r10, 0x3C00;
        cmp rax, r10;
        jne sgw_fail_stage;

        // 4. Unpack G -> 0.
        mov rax, 4;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 1;
        call scrgb_unpack_channel;
        cmp rax, 0;
        jne sgw_fail_stage;

        // 5. Unpack B -> 0.
        mov rax, 5;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 2;
        call scrgb_unpack_channel;
        cmp rax, 0;
        jne sgw_fail_stage;

        // 6. in_gamut yes.
        mov rax, 6;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call scrgb_in_gamut;
        cmp rax, 1;
        jne sgw_fail_stage;

        // 7. in_gamut no (R negative).
        mov rax, 7;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, 0xBC00;                    // -1.0
        mov rsi, 0;
        mov rdx, 0;
        call scrgb_pack;
        mov rdi, rax;
        call scrgb_in_gamut;
        cmp rax, 0;
        jne sgw_fail_stage;

        // 8. in_gamut no (R > 1.0).
        mov rax, 8;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, 0x4000;                    // fp16 2.0
        mov rsi, 0;
        mov rdx, 0;
        call scrgb_pack;
        mov rdi, rax;
        call scrgb_in_gamut;
        cmp rax, 0;
        jne sgw_fail_stage;

        // 9. Bad channel unpack.
        mov rax, 9;
        lea rcx, [rip + _sgw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 3;
        call scrgb_unpack_channel;
        mov r10, 0xFFFFEDBF;
        cmp rax, r10;
        jne sgw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sgw_ok];
        call klog_s1;
        xor rax, rax;
        jmp sgw_out;

      sgw_fail_stage:
        lea rax, [rip + _sgw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + sgw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      sgw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
