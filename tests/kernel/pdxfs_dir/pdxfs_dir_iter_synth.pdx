// tests/kernel/pdxfs_dir/pdxfs_dir_iter_synth.pdx -- R42-PREP-008 (#1630)
//
// Boot witness for the PdxFS userspace directory iterator landed at
// #1630.  Exercises:
//
//   (1) Reset the file table + cursor table; mint a KIND_MEMORY parent
//       with RIGHT_MINT at slot 132.
//   (2) Call sys_pdxfs_open_body(parent=132, mode=DIR nibble = 0x2000)
//       -> cap_slot in [0..256).  Cap-slot value is caller-independent
//       (comes from the body's free-slot scan) so the witness only
//       asserts (a) cap_slot < 256 and (b) the descriptor at cap_slot
//       has kind == KIND_PDXFS_FILE (0x195) and rights == 0x009.
//   (3) Assert pdxfs_dir_cursor_read(row_id) == 0 (fresh on open).
//   (4) Three sys_pdxfs_dir_readnext_body calls into a kernel scratch:
//       each returns 1 with the expected {inode, kind, name_len} for
//       stub entries 0/1/2 (".", "..", "hello.pdx").
//   (5) Fourth call returns 0 (EOD).  Cursor is now 3 (advanced past
//       the stub set).
//   (6) Refuse tests: sys_pdxfs_open_body with mode_flags > 0xFFFF
//       returns SYS_PDXFS_OPEN_EINVAL; sys_pdxfs_dir_readnext_body
//       with a slot holding a non-PDXFS_FILE cap returns EBADF.
//   (7) Cleanup: revoke the row, clear the cap slot, reset the tables.
//
// Fingerprint: R42-PREP-008 PDXFS DIR ITER OK
//
// Uses cap slots 132..134 (disjoint from the KIND_PDXFS_FILE witness's
// 108..110 and the pdxfs_txn_ops witness's 116..127).  The cap_slot
// returned by sys_pdxfs_open_body's free-slot scan is NOT necessarily
// in this range (the scan starts at slot 0), so the witness uses its
// returned slot for revoke and does not depend on the value.
//
// The witness deliberately calls the syscall bodies directly (bypassing
// the dispatch shim) so a failure names the body seam without dragging
// in the SysV arg-marshal or KPTI bounce.  Matches every other
// tests/kernel/*_synth.pdx that tests one primitive in isolation.

module PdxfsDirIterSynth = structure {

  // Stage counter for FAIL diagnostics -- the stage number pinpoints
  // which gate refused, so a golden regression reports "FAIL stage 5"
  // rather than "FAIL".
  pub let mut _pdiw_stage : u64 = 0

  pub let pdiw_ok   : [u8; 19] = "PDXFS DIR ITER OK\n\0"
  pub let pdiw_fail : [u8; 21] = "PDXFS DIR ITER FAIL\n\0"

  // Kernel-side scratch for one PdxFsDirEntry.  128 bytes @align(8).
  // Reused across the four readnext calls -- entry_zero at the top
  // of pdxfs_dir_readnext makes each call idempotent w.r.t. prior
  // contents.
  pub let mut _pdiw_entry : [u8; 128] = uninit @align(8)

  // ==========================================================================
  // pdiw_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot`.  Same shape as
  // pffw_mem in tests/kernel/cap/kind_pdxfs_file_synth.pdx.  Three
  // callee-save pushes align rsp%16 == 0 for the nested call.
  // ==========================================================================

  pub let pdiw_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-008 (#1630): mint a synthetic KIND_MEMORY parent for the dir iterator witness. Kind = 4 (KIND_MEMORY), rights per caller (typically RIGHT_MINT = 0x200). Labels prefixed pdiw_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdiw_clear() -> ()
  //
  // Scrub cap slots 132..134 so the witness starts from a known state.
  // The cap_slot returned by sys_pdxfs_open_body's free-slot scan may
  // fall outside this window (the scan starts at slot 0); the witness
  // captures the returned slot for revoke rather than assuming a
  // specific value.
  // ==========================================================================

  pub let pdiw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-008 (#1630): clear cap_table slots 132..134. Labels prefixed pdiw_c_.",
      block: {
        push rbx;
        mov rbx, 132;
      pdiw_c_loop:
        cmp rbx, 135;
        jae pdiw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pdiw_c_loop;
      pdiw_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdiw_read_u64(kbuf_ptr, offset) -> u64
  //
  // Helper: load an aligned 8-byte field from the witness entry
  // scratch.  Written as a real fn (rather than an inline mov) so
  // the witness's asserts against inode / kind / name_len read
  // uniformly.
  // ==========================================================================

  pub let pdiw_read_u64 : (u64, u64) -> u64 !{mem} @{} =
    fn (kbuf_ptr: u64, offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630): read one u64 at kbuf_ptr + offset. Labels prefixed pdiw_r_.",
      block: {
        add rdi, rsi;
        mov rax, [rdi];
        ret
      }
    }

  // ==========================================================================
  // pdiw_read_u8(kbuf_ptr, offset) -> u8 (zero-extended)
  //
  // Helper: load one byte from the witness entry scratch.  Used to
  // read specific name bytes.  Byte-read discipline per the paideia-as
  // convention (xor + mov_b).
  // ==========================================================================

  pub let pdiw_read_u8 : (u64, u64) -> u64 !{mem} @{} =
    fn (kbuf_ptr: u64, offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630): read one byte at kbuf_ptr + offset, zero-extended. Labels prefixed pdiw_b_.",
      block: {
        add rdi, rsi;
        xor rax, rax;
        mov_b rax, [rdi];
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_iter_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Five callee-save pushes leave rsp%16 == 0 at every nested call.
  // Register plan:
  //   rbx = dir cap_slot (returned by sys_pdxfs_open_body)
  //   r12 = row_id
  //   r13 = kbuf pointer (constant across the loop; captured once)
  //   r14 = readnext rc (scratch)
  //   r15 = accessor scratch
  // ==========================================================================

  pub let pdxfs_dir_iter_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R42-PREP-008 (#1630): boot witness for the PdxFS userspace directory iterator. Seven stages -- (1) reset + parent mint, (2) open, (3) initial cursor read, (4/5/6) three readnext calls with field asserts, (7) EOD readnext + refuse tests + cleanup. Direct-call discipline bypasses the SysV dispatch shim so a failure names the body seam. Five callee-save pushes leave rsp%16 == 0. Effects/capabilities widen to match sys_pdxfs_open_body (mem, cap) plus sysreg for klog_s1_d1's transitive cross-call reach and boot for klog_s1. Labels prefixed pdiw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Reset + parent mint.
        // ==================================================================
        mov rax, 1;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;
        mov rdi, 132;
        mov rsi, 0xD100;
        mov rdx, 0x200;                  // RIGHT_MINT
        call pdiw_mem;

        // Capture kbuf ptr in r13 (constant across all readnext calls).
        lea r13, [rip + _pdiw_entry];

        // ==================================================================
        // (2) sys_pdxfs_open_body(parent=132, mode=DIR nibble=0x2000).
        //     Expect a slot in [0, 256).
        // ==================================================================
        mov rax, 2;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;
        mov rsi, 0x2000;                 // DIR nibble
        call sys_pdxfs_open_body;
        mov r10, 256;
        cmp rax, r10;
        jae pdiw_fail_stage;
        mov rbx, rax;                    // rbx = dir cap_slot

        // Resolve slot -> row_id for cursor / readnext direct calls.
        // Uses the kernel-side helper (bypass the syscall dispatch).
        mov rdi, rbx;
        call pdxfs_file_row_of_slot;
        mov r10, 0xFF;                   // PFF_ROW_NONE
        cmp rax, r10;
        je  pdiw_fail_stage;
        mov r12, rax;                    // r12 = row_id

        // Descriptor sanity: cap_table[slot]{kind, rights}.
        // slot_pa = cap_table + slot*24 = slot*8 + slot*16.
        mov rax, cap_table;
        mov r10, rbx;
        shl r10, 3;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov r15, [rax + 0];              // kind
        mov r11, 0x195;                  // KIND_PDXFS_FILE
        cmp r15, r11;
        jne pdiw_fail_stage;
        mov r15, [rax + 8];              // rights
        cmp r15, 0x009;                  // R_PDXFS_FILE_READ | R_PDXFS_FILE_INVOKE
        jne pdiw_fail_stage;

        // ==================================================================
        // (3) Cursor is fresh -- pdxfs_dir_cursor_read(row_id) == 0.
        // ==================================================================
        mov rax, 3;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_dir_cursor_read;
        cmp rax, 0;
        jne pdiw_fail_stage;

        // ==================================================================
        // (4) readnext #1 -- expect entry {inode=1, kind=DIR, name_len=1,
        //     name[0]='.'}.
        // ==================================================================
        mov rax, 4;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, rbx;                    // dir_cap_slot
        mov rsi, r13;                    // kbuf_ptr
        call sys_pdxfs_dir_readnext_body;
        cmp rax, 1;
        jne pdiw_fail_stage;

        // inode @+0 == 1.
        mov rdi, r13;
        xor rsi, rsi;
        call pdiw_read_u64;
        cmp rax, 1;
        jne pdiw_fail_stage;
        // kind @+8 == 2 (DIR).
        mov rdi, r13;
        mov rsi, 8;
        call pdiw_read_u64;
        cmp rax, 2;
        jne pdiw_fail_stage;
        // name_len @+16 == 1.
        mov rdi, r13;
        mov rsi, 16;
        call pdiw_read_u64;
        cmp rax, 1;
        jne pdiw_fail_stage;
        // name[0] @+24 == 0x2E ('.').
        mov rdi, r13;
        mov rsi, 24;
        call pdiw_read_u8;
        cmp rax, 0x2E;
        jne pdiw_fail_stage;

        // ==================================================================
        // (5) readnext #2 -- expect entry {inode=2, kind=DIR, name_len=2,
        //     name[0..1]=".."}.
        // ==================================================================
        mov rax, 5;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, r13;
        call sys_pdxfs_dir_readnext_body;
        cmp rax, 1;
        jne pdiw_fail_stage;

        mov rdi, r13;
        xor rsi, rsi;
        call pdiw_read_u64;
        cmp rax, 2;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 8;
        call pdiw_read_u64;
        cmp rax, 2;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 16;
        call pdiw_read_u64;
        cmp rax, 2;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 24;
        call pdiw_read_u8;
        cmp rax, 0x2E;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 25;
        call pdiw_read_u8;
        cmp rax, 0x2E;
        jne pdiw_fail_stage;

        // ==================================================================
        // (6) readnext #3 -- expect entry {inode=3, kind=FILE,
        //     name_len=9, name="hello.pdx"}.
        // ==================================================================
        mov rax, 6;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, r13;
        call sys_pdxfs_dir_readnext_body;
        cmp rax, 1;
        jne pdiw_fail_stage;

        mov rdi, r13;
        xor rsi, rsi;
        call pdiw_read_u64;
        cmp rax, 3;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 8;
        call pdiw_read_u64;
        cmp rax, 1;                       // FILE
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 16;
        call pdiw_read_u64;
        cmp rax, 9;
        jne pdiw_fail_stage;
        // Spot-check name bytes: name[0]='h'=0x68, name[8]='x'=0x78.
        mov rdi, r13;
        mov rsi, 24;
        call pdiw_read_u8;
        cmp rax, 0x68;
        jne pdiw_fail_stage;
        mov rdi, r13;
        mov rsi, 32;                     // 24 + 8
        call pdiw_read_u8;
        cmp rax, 0x78;
        jne pdiw_fail_stage;

        // Cursor should now be 3.
        mov rdi, r12;
        call pdxfs_dir_cursor_read;
        cmp rax, 3;
        jne pdiw_fail_stage;

        // ==================================================================
        // (7) readnext #4 -- expect EOD (rc == 0).
        // ==================================================================
        mov rax, 7;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, r13;
        call sys_pdxfs_dir_readnext_body;
        cmp rax, 0;
        jne pdiw_fail_stage;

        // ==================================================================
        // (8) Refuse: sys_pdxfs_open_body with mode_flags > 0xFFFF.
        //     Expect SYS_PDXFS_OPEN_EINVAL (0xFFFFFFFFFFFFFFEA).
        // ==================================================================
        mov rax, 8;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;
        mov r11, 0x10000;                // 65536 > 0xFFFF
        mov rsi, r11;
        call sys_pdxfs_open_body;
        mov r11, 0xFFFFFFFFFFFFFFEA;     // -EINVAL
        cmp rax, r11;
        jne pdiw_fail_stage;

        // ==================================================================
        // (9) Refuse: sys_pdxfs_dir_readnext_body against a slot with
        //     a non-PDXFS_FILE cap.  Slot 132 holds KIND_MEMORY, so a
        //     readnext there must return -EBADF.
        // ==================================================================
        mov rax, 9;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;                    // KIND_MEMORY cap
        mov rsi, r13;
        call sys_pdxfs_dir_readnext_body;
        mov r11, 0xFFFFFFFFFFFFFFF7;     // -EBADF
        cmp rax, r11;
        jne pdiw_fail_stage;

        // ==================================================================
        // (10) Cleanup: revoke the row + clear the descriptor + reset tables.
        // ==================================================================
        mov rdi, r12;
        call pdxfs_file_cap_revoke;
        // Discard rc: on witness re-run pdxfs_file_table_reset scrubs
        // anyway.  Clear the dir cap slot.
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // Success emit.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdiw_ok];
        call klog_s1;

        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;
        xor rax, rax;
        jmp pdiw_out;

      pdiw_fail_stage:
        lea rax, [rip + _pdiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;
        mov rax, 1;

      pdiw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
