// tests/kernel/pdxfs_dir/pdxfs_dir_iter_synth.pdx --
// R42-PREP-008 (#1630) — original 3-entry stub witness.
// R90-XREPO.010.M1-006 (paideia-os #2114) — real multi-entry witness.
//
// Boot witness for the PdxFS userspace directory iterator.  At #1630
// this file asserted the 3-entry stub set (".", "..", "hello.pdx").
// At #2114 the primitive was rewritten to walk the row's real tmpfs
// child chain; this witness was rewritten in the same round to seed a
// 5-file directory, iterate the whole chain via pdxfs_dir_readnext,
// and assert count = 5 + EOD sentinel.  The two negative-refuse tests
// (sys_pdxfs_open -EINVAL on mode > 0xFFFF; sys_pdxfs_dir_readnext_body
// -EBADF on a non-PDXFS_FILE cap) survive verbatim -- they exercise
// gates in the syscall body, not the primitive, and stay green.
//
// Stages
// ------
//
//   (1) Reset _pdxfs_file_table + _pdxfs_dir_cursor + _pdxfs_dir_rows;
//       scrub cap slots 132..134.
//   (2) Look up /tmp under root (inode 1) via tmpfs_lookup — the
//       r16_tmpfs witness populates /tmp earlier in the boot cascade
//       (before witness_r30_platform runs, which is what invokes this
//       witness), so a lookup miss is a boot-cascade regression, not a
//       normal outcome.
//   (3) tmpfs_create(tmp_idx, "rditer", 6, DIR=2) — a fresh dir this
//       witness owns.  Distinct name from every other witness that
//       creates under /tmp (grep 2026-09-01 confirms no collision
//       with r16_tmpfs's "x", r90_xrepo_010's "rbseed", or the tmpfs
//       unlink test's "x").
//   (4) tmpfs_create(dir_idx, "rd<i>", 3, REG=1) for i in 1..5 — five
//       real files whose inodes chain under dir_idx via tmpfs's
//       insert-at-head sibling linking.  Names are 3 bytes each so
//       every emit fits the frozen 128-byte PdxFsDirEntry record with
//       plenty of tail slack.
//   (5) Mint a synthetic KIND_MEMORY parent at cap slot 132 (as at
//       #1630).
//   (6) pdxfs_file_cap_mint_inner(parent=132, rights=R_PDXFS_FILE_READ|
//       R_PDXFS_FILE_INVOKE=0x009, inode_no=dir_idx, byte_len=0,
//       birth=0, mtime=0) — mints a row_id whose inode_no IS the tmpfs
//       backing index (matches the "tmpfs backing at M1" posture that
//       cap/kind_pdxfs_file.pdx §PFF_OP_READ_BYTES documents for the
//       sibling paideia-os #2109 read-bytes path).  We do NOT go
//       through sys_pdxfs_open_body because that syscall stamps the row
//       with a stub inode 0x1000 -- for a real-iteration test we need
//       the row's inode_no to name a real tmpfs dir.
//   (7) Cursor sanity: pdxfs_dir_cursor_read(row_id) == 0 (fresh).
//   (8) Five pdxfs_dir_readnext calls into a kernel scratch: each
//       returns 1 and writes an entry whose {inode, kind, name_len}
//       triple names a live tmpfs REG child.  The witness does NOT
//       assert a specific ORDER (tmpfs's insert-at-head means iteration
//       is reverse creation order today, but the primitive's contract
//       makes no ordering guarantee -- the deferred sort clause in
//       design/round-retrospectives/r90-xrepo-wave3-plan.md §2 pushes
//       ordering to the tool layer).  Per-entry asserts: (a) inode !=
//       0 and inode != dir_idx (no self-cycle, no invalid slot), (b)
//       kind == PDXFS_ENT_KIND_FILE (1) (all five children are REG),
//       (c) name_len == 3 (all five names are "rd<digit>").
//   (9) Sixth readnext: rc == 0 (EOD).  Also asserts pdxfs_dir_rows_
//       read(row_id) == 0 post-EOD (the primitive resets the counter
//       on EOD emit).  Cursor now reads back as 0xFFFF (EOD sentinel).
//  (10) sys_pdxfs_open_body(parent=132, mode_flags > 0xFFFF) →
//       SYS_PDXFS_OPEN_EINVAL (0xFFFFFFFFFFFFFFEA).  Unchanged from
//       #1630.
//  (11) sys_pdxfs_dir_readnext_body(cap_slot=132, kbuf) where slot 132
//       still holds the KIND_MEMORY parent (not a PDXFS_FILE) →
//       -EBADF (0xFFFFFFFFFFFFFFF7).  Unchanged from #1630.
//  (12) Cleanup: revoke the row, scrub cap slot, reset every table.
//
// Fingerprint
// -----------
//
// Two lines on the wire (in order):
//
//   (a) `sys pdxfs readdir ok [legacy: SYS PDXFS READDIR OK] rows=5`
//       emitted by pdxfs_dir_readnext itself on EOD (Stage 9).
//   (b) `PDXFS DIR ITER OK\n` emitted by this witness on all-green.
//       The historical uppercase form is preserved so
//       tests/r17/shell-shutdown.golden's own `PDXFS DIR ITER OK`
//       assert-line stays covered without a golden edit at the #2114
//       landing.
//
// Uses cap slots 132..134 (disjoint from the KIND_PDXFS_FILE witness's
// 108..110, the pdxfs_txn_ops witness's 116..127, and the paideia-os
// #2109 read-bytes witness's 130).
//
// The witness deliberately calls pdxfs_dir_readnext DIRECTLY (bypassing
// sys_pdxfs_dir_readnext_body's DIR-nibble gate) because the mint path
// we take at Stage 6 goes through pdxfs_file_cap_mint_inner, which
// packs mode = 0x1A4 (0o644) by default -- no DIR nibble.  Rather than
// widen the mint helper's arg list just for this witness, we rely on
// the fact that the DIR-nibble gate is a syscall-layer protection
// (refuses a cap not tagged as a directory), not a semantic invariant
// of the primitive (which walks any inode's child chain regardless of
// how the row's mode bits are stamped).  The negative-refuse test at
// Stage 11 still exercises that syscall-layer gate through the sibling
// bad-kind path.

module PdxfsDirIterSynth = structure {

  // Stage counter for FAIL diagnostics -- the stage number pinpoints
  // which gate refused, so a golden regression reports "FAIL stage 5"
  // rather than "FAIL".
  pub let mut _pdiw_stage : u64 = 0

  pub let pdiw_ok   : [u8; 19] = "PDXFS DIR ITER OK\0"
  pub let pdiw_fail : [u8; 21] = "PDXFS DIR ITER FAIL\0"

  // Kernel-side scratch for one PdxFsDirEntry.  128 bytes @align(8).
  // Reused across the six readnext calls -- entry_zero at the top of
  // pdxfs_dir_readnext makes each call idempotent w.r.t. prior contents.
  pub let mut _pdiw_entry : [u8; 128] = uninit @align(8)

  // Directory name: "rditer\0" (6 chars + NUL).  Distinct from every
  // other under-/tmp name any sibling witness creates.
  pub let pdiw_dir_name  : [u8; 7] = "rditer\0"

  // File name literals: "rd1".."rd5" (3 chars + NUL each).  Declared
  // individually rather than as a table because paideia-as does not
  // expose a table-of-strings addressing form; five let bindings is
  // the shape every sibling witness (r90_xrepo_010, rootfs_dir_seeds)
  // takes for its per-entity name set.
  pub let pdiw_name_1 : [u8; 4] = "rd1\0"
  pub let pdiw_name_2 : [u8; 4] = "rd2\0"
  pub let pdiw_name_3 : [u8; 4] = "rd3\0"
  pub let pdiw_name_4 : [u8; 4] = "rd4\0"
  pub let pdiw_name_5 : [u8; 4] = "rd5\0"

  // tmpfs_lookup name for "/tmp".
  pub let pdiw_tmp_name : [u8; 4] = "tmp\0"

  // ==========================================================================
  // pdiw_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot`.  Same shape as
  // pffw_mem in tests/kernel/cap/kind_pdxfs_file_synth.pdx.  Three
  // callee-save pushes align rsp%16 == 0 for the nested call.
  // ==========================================================================

  pub let pdiw_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-008 (#1630): mint a synthetic KIND_MEMORY parent for the dir iterator witness. Kind = 4 (KIND_MEMORY), rights per caller (typically RIGHT_MINT = 0x200). Labels prefixed pdiw_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdiw_clear() -> ()
  //
  // Scrub cap slots 132..134 so the witness starts from a known state.
  // ==========================================================================

  pub let pdiw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R42-PREP-008 (#1630): clear cap_table slots 132..134. Labels prefixed pdiw_c_.",
      block: {
        push rbx;
        mov rbx, 132;
      pdiw_c_loop:
        cmp rbx, 135;
        jae pdiw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pdiw_c_loop;
      pdiw_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdiw_read_u64(kbuf_ptr, offset) -> u64
  //
  // Helper: load an aligned 8-byte field from the witness entry scratch.
  // ==========================================================================

  pub let pdiw_read_u64 : (u64, u64) -> u64 !{mem} @{} =
    fn (kbuf_ptr: u64, offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630): read one u64 at kbuf_ptr + offset. Labels prefixed pdiw_r_.",
      block: {
        add rdi, rsi;
        mov rax, [rdi];
        ret
      }
    }

  // ==========================================================================
  // pdiw_seed_one(dir_idx, name_ptr) -> new_inode_idx | 0 | 0xFFFF
  //
  // Wrapper for one tmpfs_create call, name_len fixed at 3 (all five
  // seeded names are "rd<digit>").  Return semantics match
  // tmpfs_create: 0 on collision/type-error, 0xFFFF on OOM, positive
  // idx on success.
  // ==========================================================================

  pub let pdiw_seed_one : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (dir_idx: u64, name_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R90-XREPO.010.M1-006 (paideia-os #2114): wrap tmpfs_create for the five uniform seed names -- name_len fixed at 3, type fixed at VNODE_TYPE_REG(1). Effects match tmpfs_create's own {mem, sysreg} (sysreg via tmpfs_create's klog on the failure arm). Leaf-adjacent (one nested call to tmpfs_create). Entry rsp%16==8, no push -> nested call sees %16==8 per SysV. Labels prefixed pdiw_so_.",
      block: {
        // tmpfs_create signature: (dir_idx, name_ptr, name_len, type).
        mov rdx, 3;                          // name_len
        mov rcx, 1;                          // VNODE_TYPE_REG
        call tmpfs_create;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_iter_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Five callee-save pushes leave rsp%16 == 0 at every nested call.
  // Register plan:
  //   rbx = dir_idx (tmpfs inode of /tmp/rditer, held across all stages)
  //   r12 = row_id  (KIND_PDXFS_FILE row over dir_idx)
  //   r13 = kbuf ptr (constant across the loop; captured once)
  //   r14 = iteration count (0..5 in the readnext loop)
  //   r15 = scratch
  // ==========================================================================

  pub let pdxfs_dir_iter_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): boot witness for the PdxFS userspace directory iterator.  Twelve stages -- (1) reset everything, (2) look up /tmp, (3) create /tmp/rditer dir, (4) create five REG children rd1..rd5, (5) mint synthetic KIND_MEMORY parent, (6) mint KIND_PDXFS_FILE row with real dir inode, (7) fresh-cursor assert, (8) five readnext calls with per-entry asserts, (9) EOD readnext + rows-counter reset + cursor==0xFFFF assert, (10)/(11) refuse-tests for out-of-range mode_flags (-EINVAL) and non-dir cap slot (-EBADF), (12) cleanup.  Direct-call discipline for pdxfs_dir_readnext (bypasses sys_pdxfs_dir_readnext_body's DIR-nibble gate) because the mint at Stage 6 goes through pdxfs_file_cap_mint_inner which packs mode = 0x1A4 (0o644) with no DIR nibble -- the gate is a syscall-layer protection, not a semantic invariant of the primitive.  Five callee-save pushes leave rsp%16 == 0 at every nested call.  Effects/capabilities widen to match the union of nested calls: mem (tmpfs_create, tmpfs_lookup, pdxfs_dir_readnext, pdxfs_file_cap_mint_inner, pdxfs_file_cap_revoke, cap_mint_write), sysreg (tmpfs_create's klog + pdxfs_dir_readnext's own EOD klog + klog_s1 in the OK emit), boot (sibling-witness convention), cap (cap_mint_write + pdxfs_file_cap_mint_inner posture). Labels prefixed pdiw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Reset everything.
        // ==================================================================
        mov rax, 1;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;

        // Capture kbuf ptr in r13 (constant across all readnext calls).
        lea r13, [rip + _pdiw_entry];

        // ==================================================================
        // (2) Look up /tmp (already populated by r16_tmpfs witness).
        // ==================================================================
        mov rax, 2;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 1;                          // root_inode_idx
        lea rsi, [rip + pdiw_tmp_name];
        call tmpfs_lookup;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r15, rax;                        // r15 = tmp_idx (transient)

        // ==================================================================
        // (3) Create /tmp/rditer as DIR.
        // ==================================================================
        mov rax, 3;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, r15;                        // dir_idx = tmp_idx
        lea rsi, [rip + pdiw_dir_name];
        mov rdx, 6;                          // name_len
        mov rcx, 2;                          // VNODE_TYPE_DIR
        call tmpfs_create;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;
        mov rbx, rax;                        // rbx = dir_idx (rditer)

        // ==================================================================
        // (4) Create five REG children rd1..rd5.
        // ==================================================================
        mov rax, 4;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        lea rsi, [rip + pdiw_name_1];
        call pdiw_seed_one;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;

        mov rdi, rbx;
        lea rsi, [rip + pdiw_name_2];
        call pdiw_seed_one;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;

        mov rdi, rbx;
        lea rsi, [rip + pdiw_name_3];
        call pdiw_seed_one;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;

        mov rdi, rbx;
        lea rsi, [rip + pdiw_name_4];
        call pdiw_seed_one;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;

        mov rdi, rbx;
        lea rsi, [rip + pdiw_name_5];
        call pdiw_seed_one;
        cmp rax, 0;
        je  pdiw_fail_stage;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdiw_fail_stage;

        // ==================================================================
        // (5) Mint synthetic KIND_MEMORY parent at slot 132.
        // ==================================================================
        mov rax, 5;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;
        mov rsi, 0xD1AA;                     // arbitrary key
        mov rdx, 0x200;                      // RIGHT_MINT
        call pdiw_mem;

        // ==================================================================
        // (6) Mint KIND_PDXFS_FILE row over the real dir inode.
        //     pdxfs_file_cap_mint_inner(parent, rights, inode_no,
        //                               byte_len, birth, mtime).
        // ==================================================================
        mov rax, 6;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;                        // parent slot
        mov rsi, 0x009;                      // R_PDXFS_FILE_READ | R_INVOKE
        mov rdx, rbx;                        // inode_no = dir_idx
        xor rcx, rcx;                        // byte_len = 0
        xor r8, r8;                          // birth = 0
        xor r9, r9;                          // mtime = 0
        call pdxfs_file_cap_mint_inner;
        mov r10, 16;                         // PFF_MAX
        cmp rax, r10;
        jae pdiw_fail_stage;
        mov r12, rax;                        // r12 = row_id

        // ==================================================================
        // (7) Cursor is fresh -- pdxfs_dir_cursor_read(row_id) == 0.
        // ==================================================================
        mov rax, 7;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_dir_cursor_read;
        cmp rax, 0;
        jne pdiw_fail_stage;

        // ==================================================================
        // (8) Five readnext calls -- expect rc == 1 each with a live
        //     REG child.
        // ==================================================================
        mov rax, 8;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;

        xor r14, r14;                        // iteration index
      pdiw_iter_loop:
        cmp r14, 5;
        jae pdiw_iter_done;

        mov rdi, r12;
        mov rsi, r13;
        call pdxfs_dir_readnext;
        cmp rax, 1;
        jne pdiw_fail_stage;                 // expected rc = 1

        // Per-entry asserts.
        //   inode @+0 != 0 && != dir_idx (rbx).
        mov rdi, r13;
        xor rsi, rsi;
        call pdiw_read_u64;
        cmp rax, 0;
        je  pdiw_fail_stage;
        cmp rax, rbx;
        je  pdiw_fail_stage;

        //   kind @+8 == PDXFS_ENT_KIND_FILE (1).
        mov rdi, r13;
        mov rsi, 8;
        call pdiw_read_u64;
        cmp rax, 1;
        jne pdiw_fail_stage;

        //   name_len @+16 == 3.
        mov rdi, r13;
        mov rsi, 16;
        call pdiw_read_u64;
        cmp rax, 3;
        jne pdiw_fail_stage;

        add r14, 1;
        jmp pdiw_iter_loop;

      pdiw_iter_done:

        // ==================================================================
        // (9) Sixth readnext -- expect EOD (rc == 0).  Also checks the
        //     primitive emitted its fingerprint AND reset the rows
        //     counter to 0 (post-EOD posture per §Section 2 of
        //     pdxfs_dir_iter.pdx).
        // ==================================================================
        mov rax, 9;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        mov rsi, r13;
        call pdxfs_dir_readnext;
        cmp rax, 0;
        jne pdiw_fail_stage;

        // rows counter must be 0 (reset on EOD emit).
        mov rdi, r12;
        call pdxfs_dir_rows_read;
        cmp rax, 0;
        jne pdiw_fail_stage;

        // Cursor must read as 0xFFFF (EOD sentinel).
        mov rdi, r12;
        call pdxfs_dir_cursor_read;
        mov r10, 0xFFFF;
        cmp rax, r10;
        jne pdiw_fail_stage;

        // ==================================================================
        // (10) Refuse: sys_pdxfs_open_body with mode_flags > 0xFFFF.
        //      Expect SYS_PDXFS_OPEN_EINVAL (0xFFFFFFFFFFFFFFEA).
        // ==================================================================
        mov rax, 10;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;
        mov r11, 0x10000;                    // > 0xFFFF
        mov rsi, r11;
        call sys_pdxfs_open_body;
        mov r11, 0xFFFFFFFFFFFFFFEA;         // -EINVAL
        cmp rax, r11;
        jne pdiw_fail_stage;

        // ==================================================================
        // (11) Refuse: sys_pdxfs_dir_readnext_body against a slot with
        //      a non-PDXFS_FILE cap.  Slot 132 holds KIND_MEMORY, so a
        //      readnext there must return -EBADF.
        // ==================================================================
        mov rax, 11;
        lea rcx, [rip + _pdiw_stage];
        mov [rcx], rax;
        mov rdi, 132;                        // KIND_MEMORY cap
        mov rsi, r13;
        call sys_pdxfs_dir_readnext_body;
        mov r11, 0xFFFFFFFFFFFFFFF7;         // -EBADF
        cmp rax, r11;
        jne pdiw_fail_stage;

        // ==================================================================
        // (12) Cleanup: revoke the row + clear the descriptor + reset
        //      tables.
        // ==================================================================
        mov rdi, r12;
        call pdxfs_file_cap_revoke;

        // Success emit.  Uppercase `PDXFS DIR ITER OK` preserved so
        // tests/r17/shell-shutdown.golden's existing assertion stays
        // green without a golden edit at the #2114 landing.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdiw_ok];
        call klog_s1;

        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;
        xor rax, rax;
        jmp pdiw_out;

      pdiw_fail_stage:
        lea rax, [rip + _pdiw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdiw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pdiw_clear;
        call pdxfs_file_table_reset;
        call pdxfs_dir_iter_reset;
        mov rax, 1;

      pdiw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
