// tests/kernel/mm/uefi_physmap_synthetic.pdx — R19.M5 (M4-deferred #2 test)
//
// Fabricated-memmap regression fixture for uefi_build_physmap and
// uefi_physmap_seed_alloc. Constructs a static 3-descriptor EFI memory
// map in .data, wraps it in a synthetic boot_env_t, invokes the M4
// counting pass + M5 seed pass, and asserts the tallies match the
// expected values computed from the fixture's own definition.
//
// ============================================================================
// Posture at R19.M5 (following tests/kernel/mm/tlb_shootdown_race.pdx)
// ============================================================================
//
// This module DEFINES the witness function but the invocation from
// `kernel_main.boot_continue_after_ring3` is deliberately DEFERRED.
// Reason: kernel_main is the PVH-boot entry (QEMU -kernel), which does
// NOT walk the UEFI path — kernel_main_uefi + uefi_build_physmap +
// uefi_physmap_seed_alloc are only reached when the UEFI stub jumps to
// them post-ExitBootServices. Wiring the witness into kernel_main would
// require staging a fake boot_env into a specific slot that kernel_main
// picks up unconditionally, which is out of scope for a build-time
// audit fixture. The witness is instead callable via GDB / the R19.M5
// smoke fixture that boots to kernel_main_uefi under OVMF (see
// tools/run-uefi-ovmf.sh).
//
// The witness's role at R19.M5 close:
//   (a) The file compiles = the seed algorithm's syntax + register
//       discipline are sound and no downstream API drift has broken
//       the boot_env_t layout (regression signal for env-offset renames).
//   (b) Emitted `pub` symbol = manual invocation via QEMU + GDB is
//       one line at a debugger prompt (`call uefi_physmap_synthetic_witness`).
//   (c) Fabricated-memmap constants + expected tallies are checked-in
//       source-of-truth for the R20 landing that flips the invocation on.
//
// ============================================================================
// Fabricated memory map
// ============================================================================
//
// Three descriptors, each 40 bytes (nominal desc_size). Total memmap
// size = 120 B. desc_ver = 1.
//
// Descriptor 0:
//   Type          = 7    (EfiConventionalMemory — REUSABLE)
//   PhysicalStart = 0x100000       (1 MiB)
//   NumberOfPages = 16             (64 KiB extent)
//   → available: 65536 B, page range [256, 272)
//
// Descriptor 1:
//   Type          = 5    (EfiRuntimeServicesCode — reserved)
//   PhysicalStart = 0x200000       (2 MiB)
//   NumberOfPages = 4              (16 KiB extent)
//   → reserved: 16384 B, page range [512, 516) — NOT cleared in bitmap
//
// Descriptor 2:
//   Type          = 7    (EfiConventionalMemory — REUSABLE)
//   PhysicalStart = 0x300000       (3 MiB)
//   NumberOfPages = 32             (128 KiB extent)
//   → available: 131072 B, page range [768, 800)
//
// Expected M4-counter tallies (uefi_build_physmap):
//   _uefi_physmap_avail_bytes = 65536 + 131072 - image_size (carve)
//                             = 196608 - image_size
//   _uefi_physmap_resv_bytes  = 16384
//   _uefi_physmap_desc_count  = 3
//
// The fabricated boot_env sets image_size = 0 so the M4 counter's
// image-carve pass is a no-op and the expected avail = 196608 exactly.
//
// Expected M5 seed tallies (uefi_physmap_seed_alloc):
//   _uefi_phys_free_pages = 16 + 32 = 48 (descriptor 0 + descriptor 2)
//   _uefi_phys_beyond_4g_pages = 0
//   _uefi_phys_image_carveout_pages = 0 (image_size = 0)
//
// ============================================================================
// UART markers (mirrors tlb_shootdown_race.pdx idiom)
// ============================================================================
//
//   OK:   "UEFI PHYSMAP SYNTH OK\n\0"       (22 + \n + \0 = 24 bytes)
//   FAIL: "UEFI PHYSMAP SYNTH FAIL\n\0"     (24 + \n + \0 = 26 bytes)
//
// Emitted via raw uart_puts (same as tlb_shootdown_race.pdx). Trailing
// \n gives the fingerprint checker a line boundary; \0 terminates the
// uart_puts char-copy loop.
//
// ============================================================================
// Encoder
// ============================================================================
//
// paideia-as v0.20.1+. Uses call, ret, mov (imm64 + reg-reg), cmp, je,
// jmp, lea (rip-relative). No new encoder work.

module UefiPhysmapSynthetic = structure {

  // ==========================================================================
  // UART markers
  // ==========================================================================

  pub let uefi_physmap_synth_ok_msg   : [u8; 24] = "UEFI PHYSMAP SYNTH OK\n\0"
  pub let uefi_physmap_synth_fail_msg : [u8; 26] = "UEFI PHYSMAP SYNTH FAIL\n\0"

  // ==========================================================================
  // Fabricated EFI memory map — 3 descriptors, 40 B stride.
  // ==========================================================================
  //
  // Each descriptor is 5 × u64 = 40 B. The array is laid out as a flat
  // u64 array so paideia-as can express the initialisation without
  // needing a struct type. Field order per UEFI 2.10 §7.2.3:
  //
  //   [0] u32 Type | u32 _Pad     — packed into low u64
  //   [1] u64 PhysicalStart
  //   [2] u64 VirtualStart (0 pre-EBS)
  //   [3] u64 NumberOfPages
  //   [4] u64 Attribute
  //
  // Total = 3 × 5 = 15 u64 = 120 bytes.

  pub let _synth_memmap : [u64; 15] = [
    // Descriptor 0: Type=7 (EfiConventionalMemory), PS=0x100000, NP=16
    7,
    0x100000,
    0,
    16,
    0,
    // Descriptor 1: Type=5 (EfiRuntimeServicesCode), PS=0x200000, NP=4
    5,
    0x200000,
    0,
    4,
    0,
    // Descriptor 2: Type=7 (EfiConventionalMemory), PS=0x300000, NP=32
    7,
    0x300000,
    0,
    32,
    0
  ]

  // ==========================================================================
  // Fabricated boot_env_t — 32 × u64 = 256 B, 32-B aligned.
  // ==========================================================================
  //
  // Populated at witness invocation time (see uefi_physmap_synthetic_witness
  // below). Layout per src/boot/uefi_env.pdx:
  //
  //   +0    u64  magic          = 0x564E454244494150
  //   +8    u32  version = 1 | u32 _pad = 0
  //   +16   fb_desc_t (32 B, zeroed)
  //   +48   u64  rsdp_pa = 0
  //   +56   u64  image_base = 0
  //   +64   u64  image_size = 0     ← carve-out disabled for clean tallies
  //   +72   u64  efi_memmap_pa = &_synth_memmap
  //   +80   u64  efi_memmap_size = 120
  //   +88   u32  efi_memmap_desc_size = 40 | u32 efi_memmap_desc_ver = 1
  //   +96   u64  runtime_services_pa = 0

  pub let mut _synth_boot_env : [u64; 32] = uninit @align(32)

  // ==========================================================================
  // uefi_physmap_synthetic_witness — populate synth env + run both passes.
  // ==========================================================================
  //
  // No parameters. Returns 0 on success, 1 on any tally mismatch.
  //
  // Register plan:
  //   Prologue pushes rbx (byte counter) so the msg emit loops can
  //   preserve state across nested uart_puts calls.

  pub let uefi_physmap_synthetic_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R19.M5 (M4-deferred #2 test). Compile-time-checked witness: populates _synth_boot_env with a fabricated 3-descriptor EFI memmap (byte-identical to the fixture header §Fabricated memory map), then calls uefi_build_physmap(&env) and uefi_physmap_seed_alloc(&env) and cross-checks the tallies against hard-coded expected values (avail=196608, resv=16384, desc_count=3, free_pages=48). On any mismatch emits the FAIL marker via uart_puts and returns 1; on all matches emits OK and returns 0. The env population walks 12 field writes (magic, version+pad, image_size=0, efi_memmap_pa, efi_memmap_size=120, efi_memmap_desc_size=40|desc_ver=1); every other field is left uninit — the M4 counter + M5 seed only read the fields explicitly listed in their justifications, so uninit tail is safe. Byte-for-byte stability of _synth_memmap ensures the expected constants below stay valid across paideia-as encoder churn. Witness is @no_frame — rbp is not touched; single rbx push balances the 16-byte stack alignment expected across nested calls (uart_puts) since the function is entered with rsp % 16 == 8 (call site) + one push = 16-aligned pre-nested-call.",
      block: {
        push rbx;

        // ================================================================
        // Phase 1: populate _synth_boot_env.
        // ================================================================

        lea rdi, [rip + _synth_boot_env];

        // magic
        mov rax, 0x564E454244494150;
        mov [rdi + 0], rax;

        // version=1 | _pad=0 (combined u64 store)
        mov rax, 1;
        mov [rdi + 8], rax;

        // Zero fb_desc_t (+16..+47), rsdp_pa (+48), image_base (+56),
        // image_size (+64), runtime_services_pa (+96), reserved tail
        // (+104..+255) via a linear zero loop. paideia-as v0.20.1's
        // memory-addressing modes accept `[reg + reg * scale]` (see
        // pf_handler.pdx:296) but not `[reg + reg]` without a scale.
        // rdx here indexes u64 slots so scale=8 is natural.
        //
        // Iterate slot indices 2..31 (inclusive) — u64 slots covering
        // offsets 16..248, i.e. everything except magic (+0) and
        // version|_pad (+8) which we already wrote.
        mov rcx, 30;                     // 30 u64 slots
        mov rdx, 2;                      // starting slot index (offset 16 = 2*8)
        mov rax, 0;
      synth_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne synth_zero_loop;

        // efi_memmap_pa (+72) = &_synth_memmap
        lea rax, [rip + _synth_memmap];
        mov [rdi + 72], rax;

        // efi_memmap_size (+80) = 120
        mov rax, 120;
        mov [rdi + 80], rax;

        // efi_memmap_desc_size (+88, u32) | efi_memmap_desc_ver (+92, u32)
        // = 40 | (1 << 32) via a combined u64 store.
        mov rax, 0x0000000100000028;     // low32=40 (0x28), high32=1
        mov [rdi + 88], rax;

        // ================================================================
        // Phase 2: invoke uefi_build_physmap and check M4 tallies.
        // ================================================================

        lea rdi, [rip + _synth_boot_env];
        call uefi_build_physmap;

        // Expected _uefi_physmap_avail_bytes = 65536 + 131072 = 196608.
        mov rax, [rip + _uefi_physmap_avail_bytes];
        cmp rax, 196608;
        jne synth_fail;

        // Expected _uefi_physmap_resv_bytes = 16384 (Descriptor 1 only).
        mov rax, [rip + _uefi_physmap_resv_bytes];
        cmp rax, 16384;
        jne synth_fail;

        // Expected _uefi_physmap_desc_count = 3.
        mov rax, [rip + _uefi_physmap_desc_count];
        cmp rax, 3;
        jne synth_fail;

        // ================================================================
        // Phase 3: invoke uefi_physmap_seed_alloc and check M5 tallies.
        // ================================================================

        lea rdi, [rip + _synth_boot_env];
        call uefi_physmap_seed_alloc;

        // Expected _uefi_phys_free_pages = 16 + 32 = 48.
        mov rax, [rip + _uefi_phys_free_pages];
        cmp rax, 48;
        jne synth_fail;

        // Expected _uefi_phys_beyond_4g_pages = 0.
        mov rax, [rip + _uefi_phys_beyond_4g_pages];
        cmp rax, 0;
        jne synth_fail;

        // Expected _uefi_phys_image_carveout_pages = 0 (image_size=0).
        mov rax, [rip + _uefi_phys_image_carveout_pages];
        cmp rax, 0;
        jne synth_fail;

        // ================================================================
        // Phase 4: emit OK marker + return 0.
        // ================================================================

        lea rdi, [rip + uefi_physmap_synth_ok_msg];
        call uart_puts;

        mov rax, 0;
        pop rbx;
        ret;

      synth_fail:
        lea rdi, [rip + uefi_physmap_synth_fail_msg];
        call uart_puts;

        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
