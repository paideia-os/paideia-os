// tests/kernel/acpi/mcfg_synth.pdx — R20.M3 synthetic MCFG fixture
//
// Fabricates a byte-valid MCFG holding two Configuration Space
// Allocation entries and drives mcfg_parse_segments (#814) and
// mcfg_ecam_base_for_segment (#814) against it.
//
// Follows the tests/kernel/acpi/madt_synth.pdx model — @pub witness
// function callable via GDB, no runtime wire-up at R20.M3 close.
//
// -----------------------------------------------------------------------------
// Fabricated MCFG layout (76 bytes)
// -----------------------------------------------------------------------------
//
//   +0    "MCFG"       u32   (signature)
//   +4    length=76    u32   (44 header + 2*16 entries)
//   +8..35 sdt_hdr tail (zeroed)
//   +36   reserved     u64   (zero)
//   +44   Entry 0:  base=0xB0000000 (q35 default), seg=0, start=0, end=255, rsv=0
//   +60   Entry 1:  base=0xE0000000,               seg=1, start=0, end=127, rsv=0
//
// Both entries pack into 16-byte slots per the PCI Firmware Spec §4.1.2:
//   +0  u64 base_address
//   +8  u16 segment_group
//   +10 u8  start_bus
//   +11 u8  end_bus
//   +12 u32 reserved

module McfgSynth = structure {

  pub let mcfg_synth_ok_msg   : [u8; 14] = "ACPI MCFG OK\n\0"
  pub let mcfg_synth_fail_msg : [u8; 16] = "ACPI MCFG FAIL\n\0"

  // 96-byte MCFG buffer (12 u64 slots).
  pub let mut _synth_mcfg_buf : [u64; 12] = uninit @align(8)

  // Output scratch: 6 slots × 24B = 144 B.
  pub let mut _synth_out_mcfg : [u64; 18] = uninit @align(8)

  // #1570 (R49 audit): save/restore slots for the REAL Mcfg canonical state
  // (Mcfg._mcfg_segments + Mcfg._mcfg_count). The witness re-populates the
  // canonical slot to exercise mcfg_ecam_base_for_segment; without this
  // save/restore, wiring the witness at boot would clobber the ACPI-derived
  // PCIe ECAM records that pci_config_read_u32 (and every driver-attach path
  // reachable AFTER witness_r30_platform) reads through
  // mcfg_ecam_va_for_segment. 48 u64 slots = 384 B, matching mcfg.pdx
  // MCFG_MAX_SEGMENTS (16) × ECAM_SEGMENT_SIZE (24).
  pub let mut _synth_mcfg_saved_segments : [u64; 48] = uninit @align(8)
  pub let mut _synth_mcfg_saved_count    : u64       = 0

  pub let mcfg_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M3 synthetic MCFG fixture — end-to-end exercise of mcfg_parse_segments (#814) and mcfg_ecam_base_for_segment (#814). Fabricates a 76-byte MCFG with sig 'MCFG' @ +0, length=76 @ +4, reserved u64=0 @ +36, and two 16-byte Configuration Space Allocation entries at +44 (base=0xB0000000, seg=0, start_bus=0, end_bus=255) and +60 (base=0xE0000000, seg=1, start_bus=0, end_bus=127). Parser invocations: (1) mcfg_parse_segments(mcfg, _synth_out_mcfg, 6) — expect return 2. Verify first record: base_pa=0xB0000000 (u64 @ +0), segment=0 (u16 @ +8), start_bus=0 (u8 @ +10), end_bus=255 (u8 @ +11). (2) mcfg_parse_segments(mcfg, _mcfg_segments, 16) — populate the canonical static; expect 2. Store _mcfg_count=2 explicitly. (3) mcfg_ecam_base_for_segment(0) — expect 0xB0000000. (4) mcfg_ecam_base_for_segment(1) — expect 0xE0000000. (5) mcfg_ecam_base_for_segment(2) — expect 0 (segment not present). All failures emit FAIL and return 1; all pass emits OK and returns 0. Store idiom: u64 base_address at unaligned offset +44/+60 uses plain 64-bit mov — x86 tolerates unaligned qword stores per SDM Vol.3 §7.1.1 (same posture as xsdt_synth.pdx and madt_synth.pdx Type 5 override).",
      block: {
        push rbx;

        // Zero the MCFG buffer (12 u64 slots = 96 B).
        lea rdi, [rip + _synth_mcfg_buf];
        mov rcx, 12;
        xor rdx, rdx;
        xor rax, rax;
      mcfg_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne mcfg_zero_loop;

        // Header
        mov rax, 0x4746434D;                   // "MCFG" LE
        mov_d [rdi + 0], rax;
        mov rax, 76;
        mov_d [rdi + 4], rax;                  // length

        // Entry 0 @ +44: base=0xB0000000, seg=0, start=0, end=255, rsv=0
        mov rax, 0xB0000000;
        mov [rdi + 44], rax;                   // base (unaligned u64 OK)
        mov rax, 0;
        mov_w [rdi + 52], rax;                 // segment=0
        mov rax, 0;
        mov_b [rdi + 54], rax;                 // start_bus=0
        mov rax, 255;
        mov_b [rdi + 55], rax;                 // end_bus=255
        mov rax, 0;
        mov_d [rdi + 56], rax;                 // reserved

        // Entry 1 @ +60: base=0xE0000000, seg=1, start=0, end=127, rsv=0
        mov rax, 0xE0000000;
        mov [rdi + 60], rax;
        mov rax, 1;
        mov_w [rdi + 68], rax;                 // segment=1
        mov rax, 0;
        mov_b [rdi + 70], rax;                 // start_bus=0
        mov rax, 127;
        mov_b [rdi + 71], rax;                 // end_bus=127
        mov rax, 0;
        mov_d [rdi + 72], rax;                 // reserved

        // ================================================================
        // Test 1: mcfg_parse_segments into caller scratch — expect 2
        // ================================================================

        lea rdi, [rip + _synth_mcfg_buf];
        lea rsi, [rip + _synth_out_mcfg];
        mov rdx, 6;
        call mcfg_parse_segments;

        cmp rax, 2;
        jne mcfg_synth_fail;

        // Verify first record.
        lea rcx, [rip + _synth_out_mcfg];

        // base_pa (u64 @ +0) == 0xB0000000
        mov rax, [rcx + 0];
        mov rdx, 0xB0000000;
        cmp rax, rdx;
        jne mcfg_synth_fail;

        // segment (u16 @ +8) == 0
        xor rax, rax;
        mov_w rax, [rcx + 8];
        cmp rax, 0;
        jne mcfg_synth_fail;

        // start_bus (u8 @ +10) == 0
        xor rax, rax;
        mov_b rax, [rcx + 10];
        cmp rax, 0;
        jne mcfg_synth_fail;

        // end_bus (u8 @ +11) == 255
        xor rax, rax;
        mov_b rax, [rcx + 11];
        cmp rax, 255;
        jne mcfg_synth_fail;

        // ================================================================
        // #1570 (R49 audit): SAVE the real canonical MCFG state before we
        // clobber it in Test 2. On -kernel/UEFI boots, phase1_acpi_gather
        // has already populated Mcfg._mcfg_segments + Mcfg._mcfg_count
        // (from real firmware) and platform_map_mcfg_segments has stashed
        // per-segment ioremap VAs in each record's +16 slot. Consumers
        // reached AFTER witness_r30_platform (pci_config_read_u32,
        // sup_get_mcfg_ranges) read those records; the restore at the end
        // of the witness returns them to the state the parser produced.
        // ================================================================

        // Save _mcfg_count (u64).
        mov rax, [rip + _mcfg_count];
        mov [rip + _synth_mcfg_saved_count], rax;

        // Save first MCFG_MAX_SEGMENTS (16) × 24 B = 48 u64 slots of
        // _mcfg_segments into _synth_mcfg_saved_segments. Unconditional
        // full-copy (rather than count-driven) because a later Test-5 path
        // could rely on slot [count+] being 0 on real hardware.
        lea rdi, [rip + _mcfg_segments];
        lea rsi, [rip + _synth_mcfg_saved_segments];
        xor rcx, rcx;
      mcfg_save_loop:
        mov rax, [rdi + rcx * 8];
        mov [rsi + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jne mcfg_save_loop;

        // ================================================================
        // Test 2: populate canonical static slot for lookup helper
        // ================================================================

        lea rdi, [rip + _synth_mcfg_buf];
        lea rsi, [rip + _mcfg_segments];
        mov rdx, 16;
        call mcfg_parse_segments;

        cmp rax, 2;
        jne mcfg_synth_fail_restore;

        // Publish _mcfg_count (mcfg_parse_segments doesn't write it — it's
        // the orchestrator's job. Do it here to enable the lookup helper.)
        mov [rip + _mcfg_count], rax;

        // ================================================================
        // Test 3: mcfg_ecam_base_for_segment(0) == 0xB0000000
        // ================================================================

        mov rdi, 0;
        call mcfg_ecam_base_for_segment;
        mov rdx, 0xB0000000;
        cmp rax, rdx;
        jne mcfg_synth_fail_restore;

        // ================================================================
        // Test 4: mcfg_ecam_base_for_segment(1) == 0xE0000000
        // ================================================================

        mov rdi, 1;
        call mcfg_ecam_base_for_segment;
        mov rdx, 0xE0000000;
        cmp rax, rdx;
        jne mcfg_synth_fail_restore;

        // ================================================================
        // Test 5: mcfg_ecam_base_for_segment(2) == 0 (not present)
        // ================================================================

        mov rdi, 2;
        call mcfg_ecam_base_for_segment;
        cmp rax, 0;
        jne mcfg_synth_fail_restore;

        // ================================================================
        // #1570 (R49 audit): RESTORE the real canonical MCFG state so
        // downstream PCI consumers see the ACPI-derived records, not the
        // synthetic fixture values. Restore _mcfg_segments first (48 u64
        // slots), then _mcfg_count — so any observer that reads count and
        // then walks segments still sees a consistent snapshot.
        // ================================================================

        lea rdi, [rip + _synth_mcfg_saved_segments];
        lea rsi, [rip + _mcfg_segments];
        xor rcx, rcx;
      mcfg_restore_loop_ok:
        mov rax, [rdi + rcx * 8];
        mov [rsi + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jne mcfg_restore_loop_ok;

        mov rax, [rip + _synth_mcfg_saved_count];
        mov [rip + _mcfg_count], rax;

        // All pass.
        lea rdi, [rip + mcfg_synth_ok_msg];
        call uart_puts;
        mov rax, 0;
        pop rbx;
        ret;

        // ================================================================
        // Fail-restore path: mid-witness failure AFTER the save has run.
        // We still need to put the real canonical state back before we
        // return, otherwise every downstream PCI operation sees synthetic
        // 0xB0000000 / 0xE0000000 records.
        // ================================================================

      mcfg_synth_fail_restore:
        lea rdi, [rip + _synth_mcfg_saved_segments];
        lea rsi, [rip + _mcfg_segments];
        xor rcx, rcx;
      mcfg_restore_loop_fail:
        mov rax, [rdi + rcx * 8];
        mov [rsi + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jne mcfg_restore_loop_fail;

        mov rax, [rip + _synth_mcfg_saved_count];
        mov [rip + _mcfg_count], rax;

        // Fall through to unrestored fail path.

      mcfg_synth_fail:
        lea rdi, [rip + mcfg_synth_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
