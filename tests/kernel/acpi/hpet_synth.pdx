// tests/kernel/acpi/hpet_synth.pdx — R20.M3 synthetic HPET fixture
//
// Fabricates a byte-valid HPET table (56 B minimum) and drives
// hpet_parse (#816) + gas_read (#817) against it.
//
// -----------------------------------------------------------------------------
// Fabricated HPET layout (56 bytes)
// -----------------------------------------------------------------------------
//
//   +0    "HPET"                     u32   (SIG_HPET LE)
//   +4    length=56                  u32
//   +8..35 sdt_hdr tail              (zeroed)
//   +36   event_timer_block_id=0x8086A701  u32
//   +40   GAS (12 B):
//           address_space=0 (SystemMemory)
//           bit_width=64, bit_offset=0, access_size=4 (qword)
//           address=0xFED00000 (typical HPET counter block base)
//   +52   hpet_number=0              u8
//   +53   min_tick=0x1234 (u16 low then high — misaligned u16 at odd offset)
//   +55   page_protection=0          u8

module HpetSynth = structure {

  pub let hpet_synth_ok_msg   : [u8; 14] = "ACPI HPET OK\n\0"
  pub let hpet_synth_fail_msg : [u8; 16] = "ACPI HPET FAIL\n\0"

  // 64-byte HPET buffer.
  pub let mut _synth_hpet_buf : [u64; 8] = uninit @align(8)

  // 32-byte hpet_info scratch.
  pub let mut _synth_out_hpet : [u64; 4] = uninit @align(8)

  // 16-byte gas_info scratch for the standalone gas_read test.
  pub let mut _synth_out_gas : [u64; 2] = uninit @align(8)

  pub let hpet_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M3 synthetic HPET fixture — end-to-end exercise of hpet_parse (#816) plus a standalone gas_read (#817) probe. Fabricates a 56-byte HPET with sig 'HPET' @ +0, length=56 @ +4, event_timer_block_id=0x8086A701 @ +36, and a 12-byte GAS at +40 encoding SystemMemory (space=0) address=0xFED00000 (bit_width=64, access=4). Body fields: hpet_number=0 @ +52, min_tick=0x1234 stored as low-byte-then-high-byte at +53/+54 (misaligned u16), page_protection=0 @ +55. Parser invocations: (1) hpet_parse(hpet, _synth_out_hpet) — expect return 1. Verify counter_base_pa=0xFED00000 (u64 @ +0), block_id=0x8086A701 (u32 @ +8), min_tick=0x1234 (u16 @ +12, recombined via the parser's byte-load+shift path), hpet_number=0 (u8 @ +14). (2) gas_read(hpet+40, _synth_out_gas) — expect return 1. Verify gas_info: address=0xFED00000 (u64 @ +0), address_space=0 (u8 @ +8), bit_width=64 (u8 @ +9), access_size=4 (u8 @ +11). (3) Negative test — call gas_read with an on-buffer scratch encoding address=0 → expect return 0 (validity fails because address is null). This exercises the gas_read failure path without needing another table. Stores: u64 GAS address at unaligned offset +44 uses plain 64-bit mov (unaligned OK per SDM Vol.3 §7.1.1).",
      block: {
        push rbx;

        // Zero the HPET buffer (8 u64 = 64 B).
        lea rdi, [rip + _synth_hpet_buf];
        mov rcx, 8;
        xor rdx, rdx;
        xor rax, rax;
      hpet_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne hpet_zero_loop;

        // Header: sig, length
        mov rax, 0x54455048;                   // "HPET" LE
        mov_d [rdi + 0], rax;
        mov rax, 56;
        mov_d [rdi + 4], rax;                  // length

        // event_timer_block_id @ +36
        mov rax, 0x8086A701;
        mov_d [rdi + 36], rax;

        // GAS @ +40:
        //   +40 address_space_id=0
        //   +41 bit_width=64
        //   +42 bit_offset=0
        //   +43 access_size=4
        //   +44 address=0xFED00000 (u64, unaligned)
        mov rax, 0;
        mov_b [rdi + 40], rax;                 // space=0
        mov rax, 64;
        mov_b [rdi + 41], rax;                 // bit_width=64
        mov rax, 0;
        mov_b [rdi + 42], rax;                 // bit_offset=0
        mov rax, 4;
        mov_b [rdi + 43], rax;                 // access_size=4 (qword)
        mov rax, 0xFED00000;
        mov [rdi + 44], rax;                   // address (u64 unaligned)

        // hpet_number @ +52 = 0
        mov rax, 0;
        mov_b [rdi + 52], rax;

        // min_tick @ +53/+54 = 0x1234 (low byte first, then high)
        mov rax, 0x34;
        mov_b [rdi + 53], rax;                 // low
        mov rax, 0x12;
        mov_b [rdi + 54], rax;                 // high

        // page_protection @ +55 = 0
        mov rax, 0;
        mov_b [rdi + 55], rax;

        // ================================================================
        // Test 1: hpet_parse — expect return 1, verify fields
        // ================================================================

        lea rdi, [rip + _synth_hpet_buf];
        lea rsi, [rip + _synth_out_hpet];
        call hpet_parse;

        cmp rax, 1;
        jne hpet_synth_fail;

        lea rcx, [rip + _synth_out_hpet];

        // counter_base_pa (u64 @ +0) == 0xFED00000
        mov rax, [rcx + 0];
        mov rdx, 0xFED00000;
        cmp rax, rdx;
        jne hpet_synth_fail;

        // block_id (u32 @ +8) == 0x8086A701
        mov eax, [rcx + 8];
        mov rdx, 0x8086A701;
        cmp rax, rdx;
        jne hpet_synth_fail;

        // min_tick (u16 @ +12) == 0x1234
        xor rax, rax;
        mov_w rax, [rcx + 12];
        cmp rax, 0x1234;
        jne hpet_synth_fail;

        // hpet_number (u8 @ +14) == 0
        xor rax, rax;
        mov_b rax, [rcx + 14];
        cmp rax, 0;
        jne hpet_synth_fail;

        // ================================================================
        // Test 2: gas_read on the HPET's own GAS — expect valid
        // ================================================================

        lea rdi, [rip + _synth_hpet_buf];
        add rdi, 40;                           // point at HPET's GAS
        lea rsi, [rip + _synth_out_gas];
        call gas_read;

        cmp rax, 1;
        jne hpet_synth_fail;

        lea rcx, [rip + _synth_out_gas];

        // gas_info.address (u64 @ +0) == 0xFED00000
        mov rax, [rcx + 0];
        mov rdx, 0xFED00000;
        cmp rax, rdx;
        jne hpet_synth_fail;

        // gas_info.address_space (u8 @ +8) == 0
        xor rax, rax;
        mov_b rax, [rcx + 8];
        cmp rax, 0;
        jne hpet_synth_fail;

        // gas_info.bit_width (u8 @ +9) == 64
        xor rax, rax;
        mov_b rax, [rcx + 9];
        cmp rax, 64;
        jne hpet_synth_fail;

        // gas_info.access_size (u8 @ +11) == 4
        xor rax, rax;
        mov_b rax, [rcx + 11];
        cmp rax, 4;
        jne hpet_synth_fail;

        // ================================================================
        // Test 3: gas_read on a NULL-address GAS — expect fail (0)
        // Zero the low bytes at hpet+44 to poison the GAS address.
        // ================================================================

        lea rdi, [rip + _synth_hpet_buf];
        xor rax, rax;
        mov [rdi + 44], rax;                   // zero the u64 address

        lea rdi, [rip + _synth_hpet_buf];
        add rdi, 40;
        lea rsi, [rip + _synth_out_gas];
        call gas_read;

        cmp rax, 0;
        jne hpet_synth_fail;

        // All pass.
        lea rdi, [rip + hpet_synth_ok_msg];
        call uart_puts;
        mov rax, 0;
        pop rbx;
        ret;

      hpet_synth_fail:
        lea rdi, [rip + hpet_synth_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
