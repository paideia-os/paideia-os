// tests/kernel/acpi/xsdt_synth.pdx — R20.M1 synthetic XSDT fixture
//
// Fabricates a byte-valid XSDT with three fake table pointers and drives
// acpi_xsdt_find against it. Follows the tests/kernel/mm/uefi_physmap_
// synthetic.pdx model — @pub witness function callable via GDB, no
// runtime wire-up at R20.M1 close.
//
// -----------------------------------------------------------------------------
// Blob layout
// -----------------------------------------------------------------------------
//
// XSDT buffer (`_synth_xsdt_buf`) — 8 x u64 = 64 B, @align(8). Actual XSDT
// content occupies bytes 0..59 (36-byte header + 3 * 8-byte entries); the
// trailing 4 bytes are padding. Populated at witness invocation time so
// entry pointers can be `lea rip+...` for the three fake tables.
//
//   +0..3    signature "XSDT" (0x54445358)
//   +4..7    length = 60 (0x3C)
//   +8       revision = 1
//   +9       checksum = 0     (acpi_xsdt_find does NOT validate the checksum;
//                              validation is the caller's responsibility via
//                              acpi_checksum_ok, and this test doesn't exercise
//                              that. See §Design note below.)
//   +10..15  oem_id           (unused by walker — filled with 0)
//   +16..23  oem_table_id     (unused — 0)
//   +24..27  oem_revision     (unused — 0)
//   +28..31  creator_id       (unused — 0)
//   +32..35  creator_revision (unused — 0)
//   +36..43  entry[0] = &_synth_fake_hpet    (sig "HPET")
//   +44..51  entry[1] = &_synth_fake_apic    (sig "APIC" — the target)
//   +52..59  entry[2] = &_synth_fake_mcfg    (sig "MCFG")
//
// Fake tables — each is a single u64 whose low 4 bytes ARE the signature.
// acpi_xsdt_find reads *(u32*)entry_ptr to fetch the signature, so a
// 4-byte-sig-followed-by-anything layout suffices. The 32-bit read on x86
// is byte-order-consistent with the u64 constant's low half (little-endian).
//
// -----------------------------------------------------------------------------
// Design note: XSDT header checksum vs walker validation
// -----------------------------------------------------------------------------
//
// acpi_xsdt_find (#806) trusts xsdt->length to bound the entry array and
// dereferences each entry, but does NOT validate the XSDT's own 36-byte
// header checksum. That check is the CALLER's responsibility via
// acpi_checksum_ok before invoking the walker — same layering as the
// RSDP scanner (which does checksum internally, but the checksum layer is
// the same primitive #807). The M1 witness therefore doesn't need to
// balance the XSDT checksum byte; leaving it at 0 is fine.
//
// If R20.M2+ ever repositions the checksum into the walker, this test
// grows one line: set the checksum byte to the neg-sum of the other 35
// bytes of the header (all zero at that point except sig + length =
// 0x58+0x53+0x44+0x54+0x3C = 0x11F mod 256 = 0x1F, so checksum = 0xE1).
// Not needed at M1.

module XsdtSynth = structure {

  // ==========================================================================
  // UART fingerprint markers
  // ==========================================================================

  pub let xsdt_synth_ok_msg   : [u8; 14] = "ACPI XSDT OK\n\0"
  pub let xsdt_synth_fail_msg : [u8; 16] = "ACPI XSDT FAIL\n\0"

  // ==========================================================================
  // Fake downstream tables — each just the 4-byte signature in a u64.
  // ==========================================================================
  //
  // Constants store the u32 signature in the low 4 bytes of the u64; the
  // upper 32 bits are 0. When acpi_xsdt_find reads `mov edx, [entry_ptr]`
  // it fetches exactly the 4-byte signature, matching what a real
  // downstream table would have at its first 4 bytes (an sdt_hdr's
  // signature field).

  pub let _synth_fake_apic : [u64; 1] = [ 0x43495041 ]   // SIG_APIC
  pub let _synth_fake_hpet : [u64; 1] = [ 0x54455048 ]   // SIG_HPET
  pub let _synth_fake_mcfg : [u64; 1] = [ 0x4746434D ]   // SIG_MCFG

  // ==========================================================================
  // XSDT buffer — populated at witness invocation.
  // ==========================================================================

  pub let mut _synth_xsdt_buf : [u64; 8] = uninit @align(8)

  // ==========================================================================
  // acpi_xsdt_synth_witness — populate blob, invoke walker, verify hit
  // ==========================================================================
  //
  // (a) Zero the buffer.
  // (b) Write header sig+length as combined u64 store at +0.
  //     Header sig = 0x54445358 (low 32), length = 60 (0x3C, high 32).
  //     Combined u64 = 0x0000003C_54445358.
  // (c) Populate entries at +36, +44, +52 with LEA'd fake-table addresses.
  //     Uses r13/r14 as callee-save-preserved intermediate to survive the
  //     eventual acpi_xsdt_find call.
  // (d) Call acpi_xsdt_find(xsdt=&_synth_xsdt_buf, sig=SIG_APIC).
  // (e) Verify rax == &_synth_fake_apic.
  //
  // Register plan (@no_frame, 1-push):
  //   push rbx — stack alignment (rbx unused in body).
  //   Nested call at pre-call rsp % 16 == 0 (entry 8, +8 for push = 16
  //   aligned = 0 mod 16). No additional sub/add pad needed.

  pub let acpi_xsdt_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M1 synthetic XSDT fixture — end-to-end exercise of acpi_xsdt_find. Fabricates an 8x u64 buffer (64 B) holding a 36-byte XSDT header + 3 u64 entries pointing at three fake sig-only tables (_synth_fake_apic/hpet/mcfg). Header write is two u64 stores: (a) [+0] = 0x0000003C_54445358 combining sig 'XSDT' (low 32) + length 60 (high 32), (b) [+8]..[+32] left at their post-zero-loop 0 (checksum, oem fields — walker doesn't read them, only length matters for bounds). Entries stored via `lea rax, [rip+fake]; mov [buf+off], rax` at unaligned offsets 36/44/52 — x86-64 accepts unaligned qword stores per SDM Vol.3 §7.1.1 with the same perf-not-correctness caveat as the walker's unaligned qword loads. Walker call: acpi_xsdt_find(&buf, SIG_APIC=0x43495041 zero-extended to u64). Expected return = &_synth_fake_apic — proves signature dispatch at position 1 of the entry array (not position 0 or 2), guarding against off-by-one at either the entry-start (should be +36 not +32/+40) or bounds-end (should terminate cleanly after visiting entry[2] without walking into padding). On mismatch: emit FAIL, return 1. On match: emit OK, return 0. Stack: 1 push (rbx) at entry gives rsp%16==0 pre-call; the nested acpi_xsdt_find + uart_puts calls land at SysV rsp%16==8. rbx unused in body — pushed for alignment.",
      block: {
        push rbx;

        // ================================================================
        // Zero the 64-byte buffer.
        // ================================================================

        lea rdi, [rip + _synth_xsdt_buf];
        mov rcx, 8;                      // 8 u64 slots
        mov rdx, 0;
        mov rax, 0;
      acpi_xsdt_synth_witness_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne acpi_xsdt_synth_witness_zero_loop;

        // ================================================================
        // Populate header: sig "XSDT" (low 32) + length 60 (high 32) at +0.
        // ================================================================

        mov rax, 0x0000003C54445358;
        mov [rdi + 0], rax;

        // ================================================================
        // Populate 3 entries at +36 / +44 / +52.
        // ================================================================

        lea rax, [rip + _synth_fake_hpet];
        mov [rdi + 36], rax;

        lea rax, [rip + _synth_fake_apic];
        mov [rdi + 44], rax;

        lea rax, [rip + _synth_fake_mcfg];
        mov [rdi + 52], rax;

        // ================================================================
        // Invoke acpi_xsdt_find(xsdt, SIG_APIC).
        // ================================================================

        lea rdi, [rip + _synth_xsdt_buf];
        mov rsi, 0x43495041;             // SIG_APIC
        call acpi_xsdt_find;

        // Expect rax = &_synth_fake_apic.
        lea rcx, [rip + _synth_fake_apic];
        cmp rax, rcx;
        jne acpi_xsdt_synth_witness_fail;

        // ================================================================
        // Success.
        // ================================================================

        lea rdi, [rip + xsdt_synth_ok_msg];
        call uart_puts;

        mov rax, 0;
        pop rbx;
        ret;

      acpi_xsdt_synth_witness_fail:
        lea rdi, [rip + xsdt_synth_fail_msg];
        call uart_puts;

        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
