// tests/kernel/acpi/fadt_synth.pdx — R20.M3 synthetic FADT fixture
//
// Fabricates a byte-valid FADT (244 bytes — through X_PM_TMR_BLK) and
// drives fadt_parse (#815) + gas_read (#817) against it.
//
// -----------------------------------------------------------------------------
// Fabricated FADT layout — key fields
// -----------------------------------------------------------------------------
//
//   +0    "FACP"                        u32 (SIG_FACP LE)
//   +4    length=244                    u32
//   +8..35 sdt_hdr tail                 (zeroed)
//   +46   SCI_INT=9                     u16
//   +64   PM1a_CNT_BLK=0x0404           u32 legacy port
//   +68   PM1b_CNT_BLK=0                u32
//   +76   PM_TMR_BLK=0x0408             u32 legacy port
//   +80   GPE0_BLK=0x0420               u32 legacy port
//   +84   GPE1_BLK=0x0430               u32 legacy port
//   +91   PM_TMR_LEN=4                  u8
//   +92   GPE0_BLK_LEN=8                u8  (4 status bytes -> 32 GPE0 events)
//   +93   GPE1_BLK_LEN=4                u8  (2 status bytes -> 16 GPE1 events)
//   +94   GPE1_BASE=32                  u8
//   +108  CENTURY=0x32                  u8
//   +116  RESET_REG (GAS 12 B):
//           space=1 (SystemIO), width=8, offset=0, access=1 (byte)
//           address=0xCF9
//   +128  RESET_VALUE=0x06              u8
//   +172  X_PM1a_CNT_BLK (GAS 12 B):
//           space=1 (SystemIO), width=16, access=2
//           address=0x0500 (override — must supersede legacy 0x0404)
//   +208  X_PM_TMR_BLK (GAS 12 B):
//           space=1 (SystemIO), width=32, access=3
//           address=0x0508 (override — must supersede legacy 0x0408)
//   +220  X_GPE0_BLK / +232 X_GPE1_BLK  left zeroed, so the legacy ports
//         stand — which also exercises the "a zero X_ address means
//         absent, not an override to port 0" guard added in #1066.
//
// R30.M4-001 (#1066): every offset above moved. The R20.M3 fixture was
// fabricated to a layout that counted the 36-byte SDT header as 40
// bytes; parser and fixture agreed with each other and with no real
// firmware. See src/kernel/acpi/fadt.pdx for the correction.

module FadtSynth = structure {

  pub let fadt_synth_ok_msg   : [u8; 14] = "ACPI FADT OK\n\0"
  pub let fadt_synth_fail_msg : [u8; 16] = "ACPI FADT FAIL\n\0"

  // 256-byte FADT buffer (32 u64 slots — headroom above 244 B).
  pub let mut _synth_fadt_buf : [u64; 32] = uninit @align(8)

  // 64-byte fadt_info scratch.
  pub let mut _synth_out_fadt : [u64; 8] = uninit @align(8)

  pub let fadt_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M3 synthetic FADT fixture — end-to-end exercise of fadt_parse (#815) including the X_* preferred-form policy over legacy PM_*_BLK. Fabricates a 244-byte FADT with sig 'FACP' @ +0, length=244 @ +4, SCI_INT=9 @ +46, legacy PM1a_CNT_BLK=0x0404 @ +64, PM_TMR_BLK=0x0408 @ +76, GPE0_BLK=0x0420 @ +80, GPE1_BLK=0x0430 @ +84, PM_TMR_LEN=4 @ +91, GPE0_BLK_LEN=8 @ +92, GPE1_BLK_LEN=4 @ +93, GPE1_BASE=32 @ +94, CENTURY=0x32 @ +108, RESET_REG at +116 (GAS: SystemIO/byte @ 0xCF9), RESET_VALUE=0x06 @ +128, X_PM1a_CNT_BLK at +172 (GAS: SystemIO/word @ 0x0500 — overrides legacy 0x0404), X_PM_TMR_BLK at +208 (GAS: SystemIO/dword @ 0x0508 — overrides legacy 0x0408), X_GPE0_BLK at +220 and X_GPE1_BLK at +232 left zeroed so the legacy GPE ports stand. Every offset in this list moved under R30.M4-001 (#1066): the R20.M3 layout counted the 36-byte SDT header as 40 bytes, and this fixture had been fabricated to match, so parser and fixture agreed with each other and with no real firmware. Parser invocations: (1) fadt_parse(fadt, _synth_out_fadt) — expect return 1. Verify pm1a_cnt_port (u16 @ +8) == 0x0500 (the X_ override, NOT the legacy 0x0404 — this is the ACPI 6.5 §4.1.3 preferred-form policy). Verify pm_tmr_port (u16 @ +12) == 0x0508 (X_ override). Verify sci_int (u16 @ +14) == 9. Verify pm_tmr_len (u8 @ +16) == 4. Verify reset_port (u64 @ +0) == 0xCF9. Verify reset_value (u8 @ +17) == 0x06. Verify century (u8 @ +18) == 0x32. Verify the GPE block: gpe0_blk_port (u16 @ +24) == 0x0420, gpe1_blk_port (u16 @ +26) == 0x0430, gpe0_blk_len (u8 @ +28) == 8, gpe1_blk_len (u8 @ +29) == 4, gpe1_base (u8 @ +30) == 32. (2) Zero-length gate: temporarily poison length=64 (< 116), call fadt_parse, expect return 0. Restore length=244 afterwards. This confirms the length-guard early bail. Any failure emits FAIL and returns 1; all pass emits OK and returns 0. GAS byte-store idioms mirror hpet_synth.pdx — 4 u8 metadata bytes + one unaligned u64 address per GAS.",
      block: {
        push rbx;

        // Zero FADT buffer (32 u64 = 256 B).
        lea rdi, [rip + _synth_fadt_buf];
        mov rcx, 32;
        xor rdx, rdx;
        xor rax, rax;
      fadt_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne fadt_zero_loop;

        // ================================================================
        // Header
        // ================================================================

        mov rax, 0x50434146;                   // "FACP" LE
        mov_d [rdi + 0], rax;
        mov rax, 244;
        mov_d [rdi + 4], rax;                  // length

        // ================================================================
        // Legacy fields
        // ================================================================

        // SCI_INT @ +46 = 9
        mov rax, 9;
        mov_w [rdi + 46], rax;

        // PM1a_CNT_BLK @ +64 = 0x0404
        mov rax, 0x0404;
        mov_d [rdi + 64], rax;

        // PM1b_CNT_BLK @ +68 = 0
        mov rax, 0;
        mov_d [rdi + 68], rax;

        // PM_TMR_BLK @ +76 = 0x0408
        mov rax, 0x0408;
        mov_d [rdi + 76], rax;

        // GPE0_BLK @ +80 = 0x0420
        mov rax, 0x0420;
        mov_d [rdi + 80], rax;

        // GPE1_BLK @ +84 = 0x0430
        mov rax, 0x0430;
        mov_d [rdi + 84], rax;

        // PM_TMR_LEN @ +91 = 4
        mov rax, 4;
        mov_b [rdi + 91], rax;

        // GPE0_BLK_LEN @ +92 = 8, GPE1_BLK_LEN @ +93 = 4, GPE1_BASE @ +94 = 32
        mov rax, 8;
        mov_b [rdi + 92], rax;
        mov rax, 4;
        mov_b [rdi + 93], rax;
        mov rax, 32;
        mov_b [rdi + 94], rax;

        // CENTURY @ +108 = 0x32
        mov rax, 0x32;
        mov_b [rdi + 108], rax;

        // ================================================================
        // RESET_REG (GAS @ +116): SystemIO, byte @ 0xCF9
        // ================================================================

        mov rax, 1;
        mov_b [rdi + 116], rax;                // address_space=1 (IO)
        mov rax, 8;
        mov_b [rdi + 117], rax;                // bit_width=8
        mov rax, 0;
        mov_b [rdi + 118], rax;                // bit_offset=0
        mov rax, 1;
        mov_b [rdi + 119], rax;                // access_size=1 (byte)
        mov rax, 0xCF9;
        mov [rdi + 120], rax;                  // address (u64 unaligned)

        // RESET_VALUE @ +128 = 0x06
        mov rax, 0x06;
        mov_b [rdi + 128], rax;

        // ================================================================
        // X_PM1a_CNT_BLK (GAS @ +172): SystemIO word @ 0x0500 — overrides legacy
        // ================================================================

        mov rax, 1;
        mov_b [rdi + 172], rax;
        mov rax, 16;
        mov_b [rdi + 173], rax;
        mov rax, 0;
        mov_b [rdi + 174], rax;
        mov rax, 2;
        mov_b [rdi + 175], rax;                // access_size=2 (word)
        mov rax, 0x0500;
        mov [rdi + 176], rax;                  // address (u64 unaligned)

        // ================================================================
        // X_PM_TMR_BLK (GAS @ +208): SystemIO dword @ 0x0508 — overrides legacy
        // ================================================================

        mov rax, 1;
        mov_b [rdi + 208], rax;
        mov rax, 32;
        mov_b [rdi + 209], rax;
        mov rax, 0;
        mov_b [rdi + 210], rax;
        mov rax, 3;
        mov_b [rdi + 211], rax;                // access_size=3 (dword)
        mov rax, 0x0508;
        mov [rdi + 212], rax;                  // address (u64 unaligned)

        // ================================================================
        // Test 1: fadt_parse — expect return 1, X_ forms win
        // ================================================================

        lea rdi, [rip + _synth_fadt_buf];
        lea rsi, [rip + _synth_out_fadt];
        call fadt_parse;

        cmp rax, 1;
        jne fadt_synth_fail;

        lea rcx, [rip + _synth_out_fadt];

        // reset_port (u64 @ +0) == 0xCF9
        mov rax, [rcx + 0];
        mov rdx, 0xCF9;
        cmp rax, rdx;
        jne fadt_synth_fail;

        // pm1a_cnt_port (u16 @ +8) == 0x0500 (X_ override)
        xor rax, rax;
        mov_w rax, [rcx + 8];
        cmp rax, 0x0500;
        jne fadt_synth_fail;

        // pm_tmr_port (u16 @ +12) == 0x0508 (X_ override)
        xor rax, rax;
        mov_w rax, [rcx + 12];
        cmp rax, 0x0508;
        jne fadt_synth_fail;

        // sci_int (u16 @ +14) == 9
        xor rax, rax;
        mov_w rax, [rcx + 14];
        cmp rax, 9;
        jne fadt_synth_fail;

        // pm_tmr_len (u8 @ +16) == 4
        xor rax, rax;
        mov_b rax, [rcx + 16];
        cmp rax, 4;
        jne fadt_synth_fail;

        // reset_value (u8 @ +17) == 0x06
        xor rax, rax;
        mov_b rax, [rcx + 17];
        cmp rax, 0x06;
        jne fadt_synth_fail;

        // century (u8 @ +18) == 0x32
        xor rax, rax;
        mov_b rax, [rcx + 18];
        cmp rax, 0x32;
        jne fadt_synth_fail;

        // ---- R30.M4-001 (#1066): GPE fields ----
        // gpe0_blk_port (u16 @ +24) == 0x0420 (legacy; X_ form is zeroed)
        xor rax, rax;
        mov_w rax, [rcx + 24];
        cmp rax, 0x0420;
        jne fadt_synth_fail;

        // gpe1_blk_port (u16 @ +26) == 0x0430
        xor rax, rax;
        mov_w rax, [rcx + 26];
        cmp rax, 0x0430;
        jne fadt_synth_fail;

        // gpe0_blk_len (u8 @ +28) == 8
        xor rax, rax;
        mov_b rax, [rcx + 28];
        cmp rax, 8;
        jne fadt_synth_fail;

        // gpe1_blk_len (u8 @ +29) == 4
        xor rax, rax;
        mov_b rax, [rcx + 29];
        cmp rax, 4;
        jne fadt_synth_fail;

        // gpe1_base (u8 @ +30) == 32
        xor rax, rax;
        mov_b rax, [rcx + 30];
        cmp rax, 32;
        jne fadt_synth_fail;

        // ================================================================
        // Test 2: length-gate — force length=64 (< 116), expect fail
        // ================================================================

        lea rdi, [rip + _synth_fadt_buf];
        mov rax, 64;
        mov_d [rdi + 4], rax;                  // poison length

        lea rdi, [rip + _synth_fadt_buf];
        lea rsi, [rip + _synth_out_fadt];
        call fadt_parse;

        cmp rax, 0;
        jne fadt_synth_fail;

        // Restore length so subsequent runs (if any) see the full FADT.
        lea rdi, [rip + _synth_fadt_buf];
        mov rax, 244;
        mov_d [rdi + 4], rax;

        // All pass.
        lea rdi, [rip + fadt_synth_ok_msg];
        call uart_puts;
        mov rax, 0;
        pop rbx;
        ret;

      fadt_synth_fail:
        lea rdi, [rip + fadt_synth_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
