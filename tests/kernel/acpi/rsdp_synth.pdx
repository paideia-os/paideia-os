// tests/kernel/acpi/rsdp_synth.pdx — R20.M1 synthetic RSDP fixture
//
// Fabricates a byte-valid RSDP v2 in .rodata and drives the R20.M1 scanner
// path against it end-to-end without any real UEFI or BIOS memory access.
// Serves the same purpose as tests/kernel/mm/uefi_physmap_synthetic.pdx:
//
//   (a) The file compiles = the scanner + checksum + signature-compare
//       encoder discipline is sound and no downstream API drift has
//       broken the RSDP v2 layout constants.
//   (b) The emitted `pub` symbol is invocable via GDB
//       (`call acpi_rsdp_synth_witness`) for manual verification when the
//       R20.M2+ wiring pass lands.
//   (c) The blob's byte layout and pre-computed checksums are the source
//       of truth that the R20 acceptance witnesses regress against.
//
// R20.M1 does NOT wire this witness into kernel_main / kernel_main_uefi
// — same posture as uefi_physmap_synthetic. The invocation lands when the
// R20 kernel-side dispatch layer arrives.
//
// -----------------------------------------------------------------------------
// Blob layout (RSDP v2, 36 bytes — ACPI 6.5 §5.2.5.3)
// -----------------------------------------------------------------------------
//
//   offset  value            meaning
//   ---------------------------------------------------------------
//   +0..7   "RSD PTR "       signature (with trailing space)
//   +8      0x1F             v1 checksum — chosen so bytes 0..19 sum to 0 mod 256
//   +9..14  "PAIDOS"         OEMID
//   +15     0x02             revision (2 = ACPI 2.0+, has XSDT)
//   +16..19 0x00000000       rsdt_address (unused at R20)
//   +20..23 0x00000024       length = 36
//   +24..31 0x00000000...    xsdt_address = 0 (paper table; not walked by this test)
//   +32     0xDC             extended checksum — chosen so bytes 0..35 sum to 0 mod 256
//   +33..35 0x00 x 3         reserved
//
// Checksum derivation (verifiable by hand):
//   sig bytes  0x52+0x53+0x44+0x20+0x50+0x54+0x52+0x20 = 543; mod 256 = 0x1F
//   OEMID      0x50+0x41+0x49+0x44+0x4F+0x53           = 448; mod 256 = 0xC0
//   revision   0x02
//   rsdt_addr  0x00
//   sum(0..19 without checksum byte) = 0x1F + 0xC0 + 0x02 = 0xE1
//   → v1 checksum = (0x100 - 0xE1) mod 256 = 0x1F. Verify: 0xE1 + 0x1F = 0x100 = 0.
//
//   Bytes 0..19 already sum to 0.
//   length bytes  0x24 + 0 + 0 + 0 = 0x24
//   xsdt_address  0 x 8 = 0
//   reserved      0 x 3 = 0
//   → extended checksum = (0x100 - 0x24) mod 256 = 0xDC. Verify: 0x24 + 0xDC = 0x100.

module RsdpSynth = structure {

  // ==========================================================================
  // UART fingerprint markers
  // ==========================================================================

  pub let rsdp_synth_ok_msg   : [u8; 14] = "ACPI RSDP OK\n\0"
  pub let rsdp_synth_fail_msg : [u8; 16] = "ACPI RSDP FAIL\n\0"

  // ==========================================================================
  // Fabricated RSDP v2 blob (36 bytes)
  // ==========================================================================

  pub let _synth_rsdp : [u8; 36] = [
    // +0..7: signature "RSD PTR "
    0x52u8, 0x53u8, 0x44u8, 0x20u8, 0x50u8, 0x54u8, 0x52u8, 0x20u8,
    // +8: v1 checksum
    0x1Fu8,
    // +9..14: OEMID "PAIDOS"
    0x50u8, 0x41u8, 0x49u8, 0x44u8, 0x4Fu8, 0x53u8,
    // +15: revision = 2
    0x02u8,
    // +16..19: rsdt_address = 0
    0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // +20..23: length = 36 (0x24)
    0x24u8, 0x00u8, 0x00u8, 0x00u8,
    // +24..31: xsdt_address = 0
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // +32: extended checksum
    0xDCu8,
    // +33..35: reserved
    0x00u8, 0x00u8, 0x00u8
  ]

  // ==========================================================================
  // Fabricated boot_env — populated at witness time so env->rsdp_pa can
  // point at the blob (fast path exercise for acpi_find_rsdp).
  // ==========================================================================
  //
  // 32 x u64 = 256 bytes @align(32) — mirrors src/boot/uefi_env.pdx storage.

  pub let mut _synth_env : [u64; 32] = uninit @align(32)

  // ==========================================================================
  // acpi_rsdp_synth_witness — drive scanner + fast-path end-to-end
  // ==========================================================================
  //
  // Two sub-tests. Any mismatch emits FAIL and returns 1; both pass emits
  // OK and returns 0.
  //
  //   Test 1: acpi_rsdp_scan_range(&_synth_rsdp, 36) → &_synth_rsdp
  //     Proves signature detection, revision check, and both checksum
  //     validations pass on a byte-valid RSDP v2.
  //
  //   Test 2: acpi_find_rsdp(env) → &_synth_rsdp
  //     Populates _synth_env with magic=BOOT_ENV_MAGIC and rsdp_pa =
  //     &_synth_rsdp, verifies the fast path returns rsdp_pa verbatim.
  //     Legacy scan of 0x40E-based EBDA and [0xE0000, 0x100000) cannot
  //     be exercised at build-fixture time — those addresses aren't
  //     mapped to a controllable blob. The scanner logic those legacy
  //     paths dispatch through is fully covered by Test 1.
  //
  // Register plan (@no_frame):
  //   rbx push preserves the byte-count register across nested uart_puts.
  //   Nested calls (acpi_rsdp_scan_range, acpi_find_rsdp, uart_puts) all
  //   land at rsp % 16 == 8 with 1 push + a `sub rsp,8` pad before each
  //   call (entry rsp % 16 == 8 → 1 push → rsp % 16 == 0 → sub 8 → 8;
  //   we want 0 pre-call, so we DO NOT pad — the single push gives us
  //   rsp % 16 == 0 which is what SysV needs pre-call).

  pub let acpi_rsdp_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M1 synthetic RSDP fixture — compile-time-checked witness. Two-stage test: (T1) acpi_rsdp_scan_range on the 36-byte _synth_rsdp blob at &_synth_rsdp with length=36; expected return = &_synth_rsdp (proves sig at +0, revision at +15 == 2, v1 checksum, length == 36, v2 checksum all pass); (T2) fast-path acpi_find_rsdp with a populated _synth_env whose magic = BOOT_ENV_MAGIC (0x564E454244494150, same LE value verified by kernel_main_uefi.pdx L113 and defined at src/boot/uefi_env.pdx L120) and rsdp_pa @ +48 = &_synth_rsdp; expected return = &_synth_rsdp. Env fields other than magic (+0), rsdp_pa (+48) not initialised — fast path only reads those two fields plus the boot_env pointer's non-null-ness. Legacy scan sub-path is not exercised here because 0x40E-based EBDA and [0xE0000, 0x100000) cannot be redirected to a controllable blob at build-fixture time; the underlying scanner (acpi_rsdp_scan_range) that the legacy path dispatches to IS fully covered by T1. On any mismatch: emit rsdp_synth_fail_msg via uart_puts, return 1. All pass: emit rsdp_synth_ok_msg, return 0. Stack alignment: 1 push (rbx) at entry (rsp%16==8 → 0), which is the SysV pre-call requirement — three nested calls (scan_range, find_rsdp, uart_puts) proceed without an extra sub/add rsp,8 pad. rbx itself unused in the body — pushed solely for alignment.",
      block: {
        push rbx;

        // ================================================================
        // Test 1: acpi_rsdp_scan_range on the blob.
        // ================================================================

        lea rdi, [rip + _synth_rsdp];
        mov rsi, 36;
        call acpi_rsdp_scan_range;

        lea rcx, [rip + _synth_rsdp];
        cmp rax, rcx;
        jne acpi_rsdp_synth_witness_fail;

        // ================================================================
        // Test 2: populate _synth_env, invoke acpi_find_rsdp fast path.
        // ================================================================

        lea rdi, [rip + _synth_env];

        // Zero the entire env struct via a linear u64 loop (32 slots).
        // Same shape as uefi_physmap_synthetic.pdx L199 zero loop.
        mov rcx, 32;
        mov rdx, 0;
        mov rax, 0;
      acpi_rsdp_synth_witness_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne acpi_rsdp_synth_witness_zero_loop;

        // env->magic = BOOT_ENV_MAGIC
        mov rax, 0x564E454244494150;
        mov [rdi + 0], rax;

        // env->rsdp_pa = &_synth_rsdp
        lea rax, [rip + _synth_rsdp];
        mov [rdi + 48], rax;

        // Invoke acpi_find_rsdp.
        lea rdi, [rip + _synth_env];
        call acpi_find_rsdp;

        lea rcx, [rip + _synth_rsdp];
        cmp rax, rcx;
        jne acpi_rsdp_synth_witness_fail;

        // ================================================================
        // Both tests passed — emit OK marker + return 0.
        // ================================================================

        lea rdi, [rip + rsdp_synth_ok_msg];
        call uart_puts;

        mov rax, 0;
        pop rbx;
        ret;

      acpi_rsdp_synth_witness_fail:
        lea rdi, [rip + rsdp_synth_fail_msg];
        call uart_puts;

        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
