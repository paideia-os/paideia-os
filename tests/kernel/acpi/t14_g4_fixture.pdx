// tests/kernel/acpi/t14_g4_fixture.pdx — R20-M5-001 (#823) placeholder
//
// -----------------------------------------------------------------------------
// Status
// -----------------------------------------------------------------------------
//
// GATED ON HARDWARE. This file is a compilable placeholder until real
// ACPI tables are captured from a live Thinkpad T14 Gen 4 (Raptor Lake).
// See:
//   - tools/capture-t14-g4-acpi.md — the operator-side capture recipe
//     (dd from /sys/firmware/acpi/tables/* under a Linux boot on the
//     target laptop).
//   - tests/kernel/acpi/fixtures/t14g4/README.md — the expected on-disk
//     layout of the captured *.bin files this module will consume.
//   - tools/parse-acpi-fixture.sh — the host-side harness that runs the
//     captured tables through the R20.M1..M3 parsers and asserts on the
//     outcome.
//
// The R20.M5 close pattern is: the harness + capture doc + placeholder
// land together; the .bin files themselves and the enabling of this
// witness follow after the first hardware capture. That capture is not
// blocked on R20 — it will happen alongside R21+ bring-up when the
// operator has serial capture on the T14 G4.
//
// -----------------------------------------------------------------------------
// Acceptance criteria (what this file will do once real fixtures land)
// -----------------------------------------------------------------------------
//
// When tests/kernel/acpi/fixtures/t14g4/{rsdp,xsdt,apic,mcfg,facp,hpet}.bin
// exist, this module is rewritten to:
//
//   1. Embed each *.bin as a byte array (via a tools/ .S wrapper using
//      GNU as .incbin, mirroring tools/ap_trampoline_embed.S — paideia-as
//      itself does not yet emit `.incbin`; see paideia-as #1013 for the
//      @include_bytes primitive that will collapse the .S wrapper away).
//   2. Provide @pub witness `t14g4_fixture_witness() -> u64` that:
//        - Drives acpi_rsdp_scan_range on the RSDP blob;
//        - Walks the XSDT via acpi_xsdt_find for each expected SIG4;
//        - Parses MADT (madt_parse_lapics, madt_parse_ioapics, madt_parse_isos,
//          madt_parse_x2apics — R20.M2), MCFG (mcfg_parse_segments — R20.M3),
//          FADT (fadt_parse — R20.M3), HPET (hpet_parse — R20.M3);
//        - Asserts a T14-G4-specific expected-values table (LAPIC MMIO base
//          0xFEE00000, IOAPIC count = 2 typical for Raptor Lake U/P,
//          HPET counter base 0xFED00000, MCFG seg 0 base 0xE0000000, ...).
//        - Emits UART markers `ACPI T14G4 OK\n\0` or `ACPI T14G4 FAIL\n\0`.
//   3. Is invoked from kernel_main_uefi behind an @cfg-style guard that
//      only fires when boot_env.machine_id == MACHINE_ID_T14G4 (added at
//      the same time; a QEMU boot does not exercise this witness).
//
// The expected-values table is populated after the first capture; the
// R20 retrospective (design/round-retrospectives/r20-closure.md) lists
// the fields the operator must record when the capture happens.
//
// -----------------------------------------------------------------------------
// Compilation contract for the R20 close
// -----------------------------------------------------------------------------
//
// This module MUST compile clean under tools/build.sh so the fixture
// harness slot is reserved in the build graph. It emits two marker
// strings and NO function — no runtime effect, no linker symbol other
// than the marker byte arrays. The @pub visibility is intentional so a
// future consumer (or a GDB `x/s` probe) can observe the reservation.

module T14G4Fixture = structure {

  // Marker strings the future witness will emit on the UART. Reserved
  // here so the byte pattern is greppable in kernel.elf even before the
  // witness body lands.

  pub let t14g4_fixture_ok_msg   : [u8; 15] = "ACPI T14G4 OK\n\0"
  pub let t14g4_fixture_fail_msg : [u8; 17] = "ACPI T14G4 FAIL\n\0"

  // Slot for the eventual expected-values table (populated after first
  // capture). Sized generously to accommodate 32 u64 fields (LAPIC
  // base, IOAPIC bases[2], MCFG seg0 base, HPET base, FADT reset port
  // + value, PM_TMR port, x2APIC IDs[N], ...). Byte-zero until real
  // fixtures land.

  pub let mut _t14g4_expected : [u64; 32] = uninit @align(8)
}
