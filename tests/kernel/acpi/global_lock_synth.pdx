// tests/kernel/acpi/global_lock_synth.pdx — R31.M6-#1580
//
// Boot witness for the FADT-to-arbitration plumbing that closes #1580.
//
// =====================================================================
// WHAT THIS FIXTURE EXISTS TO MAKE TRUE
// =====================================================================
// Before this milestone the FADT parser dropped FIRMWARE_CTRL and
// PM1a_EVT_BLK on the floor, so the three addresses the ACPI Global
// Lock protocol needs (FACS host VA, PM1_CNT port for GBL_RLS, PM1_STS
// port for GBL_STS) never reached the kernel-side arbitration record
// even though the ring-3 aml_glk protocol was implemented and
// witnessed. The plumbing was declared and never dereferenced.
//
// This fixture fabricates a byte-valid FADT with those three fields
// populated, drives it end-to-end through the shipping code paths
// (fadt_parse then ec_access_bind_arbitration), and asserts that
// ec_access_arbitrated() flips from 0 to 1. It emits ONE fingerprint:
//
//     R31 GLOBAL LOCK OK
//
// A regression that broke either half of the plumbing -- the parser
// dropping the fields again, or the arbitration primitive refusing a
// valid binding -- would fail this fixture and refuse the golden.
//
// =====================================================================
// WHY A SYNTHETIC FACS AND NOT A REAL ONE
// =====================================================================
// phase1_acpi_gather (src/kernel/acpi/phase1_info.pdx) is defined and
// linked but not yet called from kernel_main, so a real boot on QEMU
// or the T14 G4 has no populated _phase1_acpi_info to read out of. The
// fixture fabricates its own FADT and FACS the same way fadt_synth.pdx
// does, and drives the exact same fadt_parse and ec_access_bind_
// arbitration paths a real boot would. What is under test is the
// plumbing between the parser and the arbitration primitive; the
// fixture supplies the ACPI-table shape and the shipping code does
// the rest.
//
// =====================================================================
// WHAT THIS FIXTURE DOES NOT ASSERT
// =====================================================================
// It ASSERTS NOTHING about ring 3 acquiring the lock. The
// acpi_supervisor userspace binary is still a stub (src/user/acpi_
// supervisor.pdx returns count=0 for every op), and the KIND_ACPI
// capability that would map the FACS into ring 3 is not yet bound to a
// real physical range (deferred to R34's userspace bubble). So this
// fingerprint says "the kernel-side plumbing is complete" and nothing
// more; the ring-3 half of the Global Lock -- the compare-exchange
// against the lock word, the doorbell write to PM1_CNT -- is R34's.
// See src/kernel/core/drivers/ec/ec_access.pdx's R31.M6-#1580 header
// block for the exact scope split.

module GlobalLockSynth = structure {

  pub let glk_synth_ok_msg   : [u8; 20] = "R31 GLOBAL LOCK OK\n\0"
  pub let glk_synth_fail_msg : [u8; 22] = "R31 GLOBAL LOCK FAIL\n\0"

  // Synthetic FACS. Only the u32 signature at offset 0 matters for the
  // ec_access_bind_arbitration signature check; the lock word at +0x10
  // and the guard/Flags word at +0x14 are left zeroed -- the ring-3
  // aml_glk that would touch them is a separate fixture (see
  // src/user/aml/aml_glk.pdx's own corpus). 64 bytes so the whole FACS
  // header fits with room to spare.
  pub let mut _glk_synth_facs : [u64; 8] = uninit @align(64)

  // Synthetic FADT (256 bytes; 32 u64 slots). Same shape as
  // tests/kernel/acpi/fadt_synth.pdx -- length 244 so all X_ gates
  // trigger.
  pub let mut _glk_synth_fadt : [u64; 32] = uninit @align(8)

  // fadt_info scratch (64 bytes).
  pub let mut _glk_synth_out  : [u64; 8]  = uninit @align(8)

  // Stage counter in .bss so a failure prints WHICH sub-test tripped.
  pub let mut _glk_synth_stage : u64 = 0

  pub let global_lock_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R31.M6-#1580: drive the shipping FADT parser and the shipping ec_access_bind_arbitration end-to-end against a fabricated FADT + synthetic FACS, and assert ec_access_arbitrated() flips from 0 to 1. Sequence: (1) zero _glk_synth_facs (8 u64 stores) and stamp its u32 signature at +0 with 'FACS' (0x53434146 LE). (2) zero _glk_synth_fadt (32 u64 stores). (3) fabricate the FADT: sig 'FACP' at +0, length 244 at +4, SCI_INT 9 at +46, PM1a_EVT_BLK 0x0400 at +56 (the release-signal side), PM1a_CNT_BLK 0x0404 at +64 (the doorbell side), PM_TMR_BLK 0x0408 at +76, PM1_EVT_LEN 4 at +88, PM_TMR_LEN 4 at +91. FIRMWARE_CTRL at +36 gets the low 32 bits of &_glk_synth_facs -- the same 4-byte encoding a real FADT uses when the FACS lives in the low 4 GiB. X_FIRMWARE_CTRL at +132 gets the full 64-bit &_glk_synth_facs so the X_ override path is exercised alongside the legacy one -- non-zero X_ supersedes per ACPI 6.5 §5.2.9 and this fixture confirms the parser honours that rule. GAS forms at +116 (RESET_REG), +172 (X_PM1a_CNT), +208 (X_PM_TMR) filled the same way fadt_synth does so length gates are all crossed. (4) call fadt_parse(&_glk_synth_fadt, &_glk_synth_out) -- expect 1. (5) read _glk_synth_out+32 (facs_addr) -- expect == &_glk_synth_facs. (6) read _glk_synth_out+40 (pm1a_evt_port, u16) -- expect 0x0400. (7) read _glk_synth_out+8 (pm1a_cnt_port, u16 -- the X_ form at 0x0500 overrode the legacy 0x0404). (8) call ec_access_bind_arbitration(facs, pm1_cnt, pm1_sts) -- expect 0 (EC_ACCESS_OK). (9) call ec_access_arbitrated() -- expect 1. (10) call ec_access_facs()/pm1_cnt()/pm1_sts() to confirm the three addresses round-tripped. (11) emit 'R31 GLOBAL LOCK OK'. Any failure emits FAIL and returns 1. Register discipline: entry rsp%16 == 8 (SysV callee-entry with the CALL push accounted for), one push rbx aligns to rsp%16 == 0 for the nested calls. rbx holds the fadt buffer pointer across the parse call. Labels prefixed glk_syn_ per reserved-label discipline.",
      block: {
        push rbx;                              // 1 push: rsp%16 8 -> 0 for nested calls

        // ============================================================
        // Stage 1: zero the synthetic FACS and stamp its signature.
        // ============================================================
        mov rax, 1;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rdi, [rip + _glk_synth_facs];
        xor rax, rax;
        mov [rdi + 0],  rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;
        mov [rdi + 32], rax;
        mov [rdi + 40], rax;
        mov [rdi + 48], rax;
        mov [rdi + 56], rax;

        // FACS signature at +0 = "FACS" (0x53434146 LE).
        mov rax, 0x53434146;
        mov_d [rdi + 0], rax;

        // ============================================================
        // Stage 2: zero the synthetic FADT.
        // ============================================================
        mov rax, 2;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rbx, [rip + _glk_synth_fadt];
        xor rax, rax;
        xor rcx, rcx;
      glk_syn_zero_loop:
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  glk_syn_zero_loop;

        // ============================================================
        // Stage 3: fabricate the FADT header + PM fields.
        // ============================================================
        mov rax, 3;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        // "FACP" @ +0
        mov rax, 0x50434146;
        mov_d [rbx + 0], rax;
        // length = 244 @ +4
        mov rax, 244;
        mov_d [rbx + 4], rax;

        // FIRMWARE_CTRL @ +36 = low 32 bits of &_glk_synth_facs.
        // The full 64-bit pointer arrives via X_FIRMWARE_CTRL below;
        // this stub records what a legacy FADT with a low-memory FACS
        // would carry.
        lea rax, [rip + _glk_synth_facs];
        mov_d [rbx + 36], rax;                 // low 32 bits (mov_d)

        // SCI_INT = 9 @ +46
        mov rax, 9;
        mov_w [rbx + 46], rax;

        // PM1a_EVT_BLK = 0x0400 @ +56 (the release-signal side)
        mov rax, 0x0400;
        mov_d [rbx + 56], rax;

        // PM1a_CNT_BLK = 0x0404 @ +64 (the doorbell side; legacy)
        mov rax, 0x0404;
        mov_d [rbx + 64], rax;

        // PM_TMR_BLK = 0x0408 @ +76 (needed for the parser's final
        // sanity check that pm_tmr_port is non-zero).
        mov rax, 0x0408;
        mov_d [rbx + 76], rax;

        // PM1_EVT_LEN = 4 @ +88 (STS half is 2B, EN half is 2B)
        mov rax, 4;
        mov_b [rbx + 88], rax;

        // PM_TMR_LEN = 4 @ +91
        mov rax, 4;
        mov_b [rbx + 91], rax;

        // ============================================================
        // Stage 4: RESET_REG GAS @ +116 (SystemIO byte @ 0xCF9)
        // ============================================================
        mov rax, 1;
        mov_b [rbx + 116], rax;
        mov rax, 8;
        mov_b [rbx + 117], rax;
        mov rax, 0;
        mov_b [rbx + 118], rax;
        mov rax, 1;
        mov_b [rbx + 119], rax;
        mov rax, 0xCF9;
        mov [rbx + 120], rax;
        mov rax, 0x06;
        mov_b [rbx + 128], rax;

        // ============================================================
        // Stage 5: X_FIRMWARE_CTRL @ +132 = full 64-bit &_glk_synth_facs.
        //          Non-zero X_ overrides the legacy 32-bit field.
        // ============================================================
        mov rax, 5;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rax, [rip + _glk_synth_facs];
        mov [rbx + 132], rax;

        // ============================================================
        // Stage 6: X_PM1a_CNT_BLK GAS @ +172 (SystemIO word @ 0x0500)
        // ============================================================
        mov rax, 1;
        mov_b [rbx + 172], rax;
        mov rax, 16;
        mov_b [rbx + 173], rax;
        mov rax, 0;
        mov_b [rbx + 174], rax;
        mov rax, 2;
        mov_b [rbx + 175], rax;
        mov rax, 0x0500;
        mov [rbx + 176], rax;

        // ============================================================
        // Stage 7: X_PM_TMR_BLK GAS @ +208 (SystemIO dword @ 0x0508)
        // ============================================================
        mov rax, 1;
        mov_b [rbx + 208], rax;
        mov rax, 32;
        mov_b [rbx + 209], rax;
        mov rax, 0;
        mov_b [rbx + 210], rax;
        mov rax, 3;
        mov_b [rbx + 211], rax;
        mov rax, 0x0508;
        mov [rbx + 212], rax;

        // ============================================================
        // Stage 8: fadt_parse(fadt, out) -- expect 1.
        // ============================================================
        mov rax, 8;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rdi, [rip + _glk_synth_fadt];
        lea rsi, [rip + _glk_synth_out];
        call fadt_parse;
        cmp rax, 1;
        jne glk_syn_fail;

        // ============================================================
        // Stage 9: facs_addr @ out+32 == &_glk_synth_facs
        // ============================================================
        mov rax, 9;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rcx, [rip + _glk_synth_out];
        mov rax, [rcx + 32];
        lea r11, [rip + _glk_synth_facs];
        cmp rax, r11;
        jne glk_syn_fail;

        // ============================================================
        // Stage 10: pm1a_evt_port @ out+40 == 0x0400
        // ============================================================
        mov rax, 10;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rcx, [rip + _glk_synth_out];
        xor rax, rax;
        mov_w rax, [rcx + 40];
        cmp rax, 0x0400;
        jne glk_syn_fail;

        // ============================================================
        // Stage 11: pm1a_cnt_port @ out+8 == 0x0500 (X_ override).
        // ============================================================
        mov rax, 11;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rcx, [rip + _glk_synth_out];
        xor rax, rax;
        mov_w rax, [rcx + 8];
        cmp rax, 0x0500;
        jne glk_syn_fail;

        // ============================================================
        // Stage 12: ec_access_arbitrated() == 0 BEFORE binding.
        //           This is the pre-condition -- without it the assertion
        //           at stage 14 would be vacuous.
        // ============================================================
        mov rax, 12;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        call ec_access_arbitrated;
        cmp rax, 0;
        jne glk_syn_fail;

        // ============================================================
        // Stage 13: ec_access_bind_arbitration(facs, pm1_cnt, pm1_sts).
        //   facs    = out+32 = &_glk_synth_facs
        //   pm1_cnt = out+8  = 0x0500
        //   pm1_sts = out+40 = 0x0400
        // ============================================================
        mov rax, 13;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rcx, [rip + _glk_synth_out];
        mov rdi, [rcx + 32];             // facs
        xor rsi, rsi;
        mov_w rsi, [rcx + 8];            // pm1_cnt
        xor rdx, rdx;
        mov_w rdx, [rcx + 40];           // pm1_sts
        call ec_access_bind_arbitration;
        cmp rax, 0;
        jne glk_syn_fail;

        // ============================================================
        // Stage 14: ec_access_arbitrated() == 1 AFTER binding.
        //           THE LOAD-BEARING ASSERTION.
        // ============================================================
        mov rax, 14;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        call ec_access_arbitrated;
        cmp rax, 1;
        jne glk_syn_fail;

        // ============================================================
        // Stage 15: the three accessors round-trip the stored addresses.
        // ============================================================
        mov rax, 15;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        call ec_access_facs;
        lea r11, [rip + _glk_synth_facs];
        cmp rax, r11;
        jne glk_syn_fail;

        call ec_access_pm1_cnt;
        cmp rax, 0x0500;
        jne glk_syn_fail;

        call ec_access_pm1_sts;
        cmp rax, 0x0400;
        jne glk_syn_fail;

        // ============================================================
        // Stage 16: rebinding is refused with EC_ACCESS_ARB_ALREADY.
        // ============================================================
        mov rax, 16;
        lea rcx, [rip + _glk_synth_stage];
        mov [rcx], rax;

        lea rcx, [rip + _glk_synth_out];
        mov rdi, [rcx + 32];
        mov rsi, 0x0500;
        mov rdx, 0x0400;
        call ec_access_bind_arbitration;
        mov r11, 0xFFFFFDC4;             // EC_ACCESS_ARB_ALREADY
        cmp rax, r11;
        jne glk_syn_fail;

        // ============================================================
        // All pass.
        // ============================================================
        lea rdi, [rip + glk_synth_ok_msg];
        call uart_puts;
        xor rax, rax;
        pop rbx;
        ret;

      glk_syn_fail:
        lea rdi, [rip + glk_synth_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
