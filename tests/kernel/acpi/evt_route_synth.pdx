// tests/kernel/acpi/evt_route_synth.pdx — R30.M4-003 (#1068) / R30.M4-004 (#1069)
//
// Boot witness for the ACPI event stream and its routing.
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// R30.M4-001/002 established that the ISR does the bounded minimum and
// leaves a record. This milestone establishes what happens to that
// record: it is routed to a subscriber, the subscriber acknowledges, and
// THE GPE IS RE-ENABLED. That last step is the one with no natural
// symptom — a GPE that is masked, dispatched, handled and never
// re-enabled produces no error anywhere and simply never fires again —
// so it is the property this witness is built around.
//
// Like gpe_synth.pdx it drives the SHIPPING functions, linked into the
// real kernel, against a 512-byte synthetic register window installed
// through the seam in core/acpi/gpe_io.pdx. No ACPI hardware is touched
// and, critically, NO IOAPIC REGISTER IS WRITTEN: the arming tests use
// an SCI_INT whose resolved GSI is 0, which core/acpi/sci_route.pdx
// refuses outright before any MMIO happens, so the arming GATE can be
// exercised in both directions without the witness reprogramming the
// platform's own interrupt controller during boot.
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  THE DERIVATION GATE. KIND_ACPI_EVENT minted from a real
//      KIND_HW_INTERRUPT, and refused five ways: a parent of the wrong
//      kind, a parent of the right kind without RIGHT_MINT, rights
//      outside R_ACPI_EVT_ALL, a zero subscriber identity, and an
//      out-of-range slot. Then the property that makes the derivation
//      mean something: the endpoint's GSI is the PARENT'S, inherited
//      rather than accepted.
//
//   B  UNMASK ORDERING. With no endpoint bound, sci_arm refuses
//      SCI_ARM_NOT_READY and the armed flag stays clear. After binding,
//      THE SAME CALL WITH THE SAME ARGUMENTS returns a different code —
//      SCI_ARM_PROGRAM_FAILED — which is what proves the readiness gate
//      passed rather than that the call happened to fail twice. Binding
//      refusals (wrong kind, out of range, double bind) are asserted
//      alongside.
//
//   C  THE ROUND TRIP, end to end and including the re-enable: a GPE
//      asserts, the real ISR masks and queues it, the pump routes it,
//      the record carries source/subscriber/index/snapshot/flags, the
//      subscriber acknowledges, THE ENABLE BIT COMES BACK, and the same
//      GPE fires again — a handled event is not a spent one.
//
//   D  NO SUBSCRIBER, LOUDLY. An unregistered GPE asserts: masked,
//      cleared, struck, NOT queued, and one audit record naming it.
//      Its neighbour's enable bit is untouched. The stream's unrouted
//      counter covers the other half of the same failure.
//
//   E  SOURCE DISCRIMINATION. A GPE-sourced record and a firmware-
//      notification-sourced record coexist in one stream and are
//      distinguishable by both `source` and `flags`. Acknowledging a
//      notification by mistake is refused with a code that says why.
//
//   F  SATURATION. Forty offers into a thirty-two-slot ring: eight
//      dropped, TAIL-drop rather than overwrite-oldest (the retained
//      records are the FIRST thirty-two), the accounting identity
//      holds, and the sequence gap after draining localises the loss to
//      exactly where it happened.
//
//   G  REVOCATION UNBINDS. Revoking the endpoint drops readiness in the
//      same operation, subsequent offers are refused and counted, and
//      acknowledgement is refused.
//
// On any failure the stage number in _evt_witness_stage identifies the
// assertion, and both exits return the seam to real port I/O and clear
// the capability slots this fixture consumed.

module EvtRouteSynth = structure {

  // Stage tracker. Memory-backed rather than a register, matching
  // _gpe_witness_stage: it has to survive every callee-save-clobber
  // pattern in the primitives under test.
  pub let mut _evt_witness_stage : u64 = 0

  // Fabricated 64-byte fadt_info, driving the production
  // gpe_config_from_fadt marshalling path rather than a hand-built
  // geometry — the same fixture shape gpe_synth.pdx uses, so the two
  // witnesses cannot disagree about what "the configured platform"
  // means.
  pub let mut _evt_w_fadt_info : [u64; 8] = uninit @align(8)

  pub let evt_route_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-003 (#1068) / R30.M4-004 (#1069): boot witness for the KIND_ACPI_EVENT derivation gate, the subscriber stream, the routing pump, the GPE round trip including the re-enable, the no-subscriber drop, source discrimination, ring saturation and the unmask ordering. Drives the shipping functions against the 512-byte synthetic GPE register window; writes no IOAPIC register at all, because both arming calls use an SCI_INT of 2^32 whose resolved GSI is 0 (the low 32 bits) and sci_route_program refuses a GSI of 0 before any MMIO -- so the readiness gate is exercised in both directions without this fixture reprogramming the platform's interrupt controller during boot. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter and the fabricated FADT live in module .bss for the same reason. Both exits call gpe_io_synth_disable, gpe_config_reset and the three table resets, and re-zero cap_table slots 17, 18 and 19, which are outside the set every other witness consumes (0..8, 10..12, 14, 15, 16, 28..33). Labels prefixed evt_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // Setup: geometry, tables, stream, seam.
        // ================================================================
        call gpe_config_reset;
        call gpe_table_reset;
        call gpe_event_reset;
        call acpi_evt_stream_reset;
        call acpi_evt_table_reset;

        mov rax, 1;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;

        lea r10, [rip + _evt_w_fadt_info];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rax, 0x420;
        mov_w [r10 + 24], rax;                 // gpe0_blk_port
        mov rax, 0x430;
        mov_w [r10 + 26], rax;                 // gpe1_blk_port
        mov rax, 8;
        mov_b [r10 + 28], rax;                 // gpe0_blk_len
        mov rax, 4;
        mov_b [r10 + 29], rax;                 // gpe1_blk_len
        mov rax, 32;
        mov_b [r10 + 30], rax;                 // gpe1_base

        lea rdi, [rip + _evt_w_fadt_info];
        call gpe_config_from_fadt;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // A. THE DERIVATION GATE
        //
        // Slot 17 = KIND_HW (the base authority), slot 18 = the SCI's
        // KIND_HW_INTERRUPT derived from it, slot 19 = the endpoint.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;

        // Pre-clean 17, 18, 19 and seed 17 as a KIND_HW with MINT.
        mov rax, cap_table;
        add rax, 408;                          // slot 17 * 24
        mov r11, 14;                           // KIND_HW
        mov [rax + 0],  r11;
        mov r11, 0x618;                        // R_HW_INT_ALL
        mov [rax + 8],  r11;
        xor rcx, rcx;
        mov [rax + 16], rcx;

        mov rax, cap_table;
        add rax, 432;                          // slot 18 * 24
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;

        mov rax, cap_table;
        add rax, 456;                          // slot 19 * 24
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;

        // The SCI's own interrupt capability: GSI 9, BSP, LEVEL.
        mov rax, 3;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 18;
        mov rsi, 17;
        mov rdx, 0x618;
        mov rcx, 9;                            // GSI
        mov r8,  1;                            // affinity: BSP
        mov r9,  1;                            // LEVEL, as ACPI requires
        call hw_int_cap_mint;
        cmp rax, 0;
        jne evt_w_fail;

        // -- Refusal 1: the parent is a KIND_HW, not a KIND_HW_INTERRUPT.
        //    This is the headline gate: holding the BASE hardware
        //    authority is not holding the interrupt the events come from.
        mov rax, 4;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        mov rsi, 17;                           // KIND_HW
        mov rdx, 0x618;
        mov rcx, 0xAB;
        call acpi_evt_cap_mint;
        mov r11, 0xFFFFFF9D;                   // ACPI_EVT_MINT_BAD_PARENT
        cmp rax, r11;
        jne evt_w_fail;

        // -- Refusal 2: right kind, no RIGHT_MINT.
        mov rax, 5;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rax, cap_table;
        add rax, 432;
        mov r11, 0x418;                        // R_HW_INT_ALL without MINT
        mov [rax + 8], r11;
        mov rdi, 19;
        mov rsi, 18;
        mov rdx, 0x618;
        mov rcx, 0xAB;
        call acpi_evt_cap_mint;
        mov r11, 0xFFFFFF9D;
        cmp rax, r11;
        jne evt_w_fail;
        mov rax, cap_table;
        add rax, 432;
        mov r11, 0x618;                        // restore
        mov [rax + 8], r11;

        // -- Refusal 3: rights outside R_ACPI_EVT_ALL.
        mov rax, 6;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        mov rsi, 18;
        mov rdx, 0xFFFF;
        mov rcx, 0xAB;
        call acpi_evt_cap_mint;
        mov r11, 0xFFFFFF9C;                   // ACPI_EVT_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne evt_w_fail;

        // -- Refusal 4: a zero subscriber identity.
        mov rax, 7;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        mov rsi, 18;
        mov rdx, 0x618;
        xor rcx, rcx;
        call acpi_evt_cap_mint;
        mov r11, 0xFFFFFF99;                   // ACPI_EVT_MINT_BAD_SUBSCRIBER
        cmp rax, r11;
        jne evt_w_fail;

        // -- Refusal 5: an out-of-range target slot.
        mov rax, 8;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 300;
        mov rsi, 18;
        mov rdx, 0x618;
        mov rcx, 0xAB;
        call acpi_evt_cap_mint;
        mov r11, 0xFFFFFF9B;                   // ACPI_EVT_MINT_BAD_ARG
        cmp rax, r11;
        jne evt_w_fail;

        // -- None of the five refusals consumed a row.
        mov rax, 9;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call acpi_evt_tail_valid;
        cmp rax, 0;
        jne evt_w_fail;

        // -- The happy path.
        mov rax, 10;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        mov rsi, 18;
        mov rdx, 0x618;
        mov rcx, 0xAB;
        call acpi_evt_cap_mint;
        cmp rax, 0;
        jne evt_w_fail;

        mov rax, 11;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov r10, cap_table;
        add r10, 456;
        mov rax, [r10 + 0];
        mov r11, 0x151;                        // KIND_ACPI_EVENT
        cmp rax, r11;
        jne evt_w_fail;

        mov r10, cap_table;
        add r10, 456;
        mov rbx, [r10 + 16];
        mov r11, 0xFFFF;
        and rbx, r11;                          // the endpoint's row_id

        // -- THE GSI WAS INHERITED. Nothing in the mint call named 9;
        //    it came out of the parent KIND_HW_INTERRUPT's own row.
        mov rax, 12;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        call acpi_evt_row_gsi;
        cmp rax, 9;
        jne evt_w_fail;

        mov rax, 13;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        call acpi_evt_row_parent;
        cmp rax, 18;
        jne evt_w_fail;
        mov rdi, rbx;
        call acpi_evt_row_subscriber;
        cmp rax, 0xAB;
        jne evt_w_fail;
        mov rdi, rbx;
        call acpi_evt_row_delivered;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // B. UNMASK ORDERING
        // ================================================================
        mov rax, 14;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_ready;
        cmp rax, 0;
        jne evt_w_fail;
        call acpi_evt_armed;
        cmp rax, 0;
        jne evt_w_fail;

        // -- Not ready: the arm is refused and the flag stays clear.
        //    SCI_INT = 2^32 resolves to GSI 0, which sci_route_program
        //    refuses before any MMIO — so if the gate were absent this
        //    would return SCI_ARM_PROGRAM_FAILED instead, which is
        //    exactly the discrimination the second call makes.
        mov rax, 15;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x100000000;
        mov rsi, 0x40;
        xor rdx, rdx;
        call sci_arm;
        mov r11, 0xFFFFFF91;                   // SCI_ARM_NOT_READY
        cmp rax, r11;
        jne evt_w_fail;
        call acpi_evt_armed;
        cmp rax, 0;
        jne evt_w_fail;

        // -- Bind refusals.
        mov rax, 16;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 17;                           // a KIND_HW, not an endpoint
        call acpi_evt_bind;
        mov r11, 0xFFFFFF94;                   // ACPI_EVT_BIND_BAD_CAP
        cmp rax, r11;
        jne evt_w_fail;
        mov rdi, 300;
        call acpi_evt_bind;
        mov r11, 0xFFFFFF94;
        cmp rax, r11;
        jne evt_w_fail;
        call acpi_evt_ready;
        cmp rax, 0;
        jne evt_w_fail;

        // -- Bind, and readiness becomes true.
        mov rax, 17;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        call acpi_evt_bind;
        cmp rax, 0;
        jne evt_w_fail;
        call acpi_evt_ready;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_bound_row;
        cmp rax, rbx;
        jne evt_w_fail;

        mov rax, 18;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        call acpi_evt_bind;                    // a second bind is refused
        mov r11, 0xFFFFFF93;                   // ACPI_EVT_BIND_ALREADY
        cmp rax, r11;
        jne evt_w_fail;

        // -- SAME CALL, SAME ARGUMENTS, DIFFERENT CODE. The readiness
        //    gate passed; the programming refused. Still not armed.
        mov rax, 19;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x100000000;
        mov rsi, 0x40;
        xor rdx, rdx;
        call sci_arm;
        mov r11, 0xFFFFFF90;                   // SCI_ARM_PROGRAM_FAILED
        cmp rax, r11;
        jne evt_w_fail;
        call acpi_evt_armed;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // C. THE ROUND TRIP, INCLUDING THE RE-ENABLE
        //
        // GPE 8 = block 0, byte 1, bit 0: status port 0x421, enable
        // port 0x425, mask 0x01.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 8;
        mov rsi, 0xAB;                         // the subscriber identity
        call gpe_register;
        cmp rax, 0;
        jne evt_w_fail;

        mov rdi, 0x420;                        // window origin = GPE0_BLK
        call gpe_io_synth_enable;
        mov rdi, 0x421;
        mov rsi, 0x01;
        call gpe_io_synth_poke;                // GPE 8 status asserted
        mov rdi, 0x425;
        mov rsi, 0x01;
        call gpe_io_synth_poke;                // GPE 8 enabled

        call gpe_event_reset;
        call gpe_io_trace_reset;

        mov rax, 21;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call sci_isr_body;
        cmp rax, 1;                            // exactly one bit serviced
        jne evt_w_fail;

        // -- The ISR masked it.
        mov rax, 22;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x425;
        call gpe_io_synth_peek;
        and rax, 0x01;
        cmp rax, 0;
        jne evt_w_fail;

        mov rax, 23;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call gpe_event_pending;
        cmp rax, 1;
        jne evt_w_fail;

        // -- ROUTE.
        mov rax, 24;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_pump;
        cmp rax, 1;
        jne evt_w_fail;
        call gpe_event_pending;
        cmp rax, 0;                            // the ISR ring is drained
        jne evt_w_fail;
        call acpi_evt_depth;
        cmp rax, 1;
        jne evt_w_fail;

        // -- The record says what it must.
        mov rax, 25;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;                          // ACPI_EVT_RF_SOURCE
        call acpi_evt_peek;
        cmp rax, 1;                            // ACPI_EVT_SRC_GPE
        jne evt_w_fail;
        mov rdi, 1;                            // ACPI_EVT_RF_SUB
        call acpi_evt_peek;
        cmp rax, 0xAB;
        jne evt_w_fail;
        mov rdi, 2;                            // ACPI_EVT_RF_A0
        call acpi_evt_peek;
        cmp rax, 8;                            // the GPE index
        jne evt_w_fail;
        mov rdi, 3;                            // ACPI_EVT_RF_A1
        call acpi_evt_peek;
        and rax, 0x01;
        cmp rax, 0;                            // enable snapshot: masked
        jne evt_w_fail;
        mov rdi, 4;                            // ACPI_EVT_RF_A2
        call acpi_evt_peek;
        cmp rax, 1;                            // one strike
        jne evt_w_fail;
        mov rdi, 5;                            // ACPI_EVT_RF_SEQ
        call acpi_evt_peek;
        cmp rax, 0;                            // the first offer
        jne evt_w_fail;
        mov rdi, 6;                            // ACPI_EVT_RF_FLAGS
        call acpi_evt_peek;
        cmp rax, 1;                            // NEEDS_ACK
        jne evt_w_fail;

        mov rax, 26;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        call acpi_evt_row_delivered;
        cmp rax, 1;
        jne evt_w_fail;
        mov rdi, rbx;
        call acpi_evt_row_acked;
        cmp rax, 0;
        jne evt_w_fail;

        // -- Drain, then acknowledge.
        mov rax, 27;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_depth;
        cmp rax, 0;
        jne evt_w_fail;

        mov rax, 28;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 8;
        call acpi_evt_ack;
        cmp rax, 0;                            // GPE_OK
        jne evt_w_fail;

        // ****************************************************************
        // THE RE-ENABLE. This single assertion is the difference between
        // a device that works and a device that works exactly once.
        // ****************************************************************
        mov rax, 29;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x425;
        call gpe_io_synth_peek;
        and rax, 0x01;
        cmp rax, 1;
        jne evt_w_fail;

        mov rax, 30;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        call acpi_evt_row_acked;
        cmp rax, 1;
        jne evt_w_fail;
        mov rdi, 8;
        call gpe_strikes;
        cmp rax, 0;                            // the ack reset the strikes
        jne evt_w_fail;

        // -- AND IT FIRES AGAIN. The status bit is re-asserted; the
        //    enable bit is the one the acknowledgement restored.
        mov rax, 31;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x421;
        mov rsi, 0x01;
        call gpe_io_synth_poke;
        call sci_isr_body;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_pump;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;
        mov rdi, 8;
        call acpi_evt_ack;
        cmp rax, 0;
        jne evt_w_fail;
        mov rdi, 0x425;
        call gpe_io_synth_peek;
        and rax, 0x01;
        cmp rax, 1;                            // re-enabled a second time
        jne evt_w_fail;

        // -- A second acknowledgement of a settled GPE is refused.
        mov rax, 32;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 8;
        call acpi_evt_ack;
        mov r11, 0xFFFFFFB5;                   // GPE_ACK_NOT_PENDING
        cmp rax, r11;
        jne evt_w_fail;

        // ================================================================
        // D. NO SUBSCRIBER, LOUDLY
        //
        // GPE 9 = block 0, byte 1, bit 1, never registered. Its
        // neighbour GPE 8 stays enabled and unasserted, so the ISR
        // services exactly one bit.
        // ================================================================
        mov rax, 33;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x421;
        mov rsi, 0x02;                         // only GPE 9 asserted
        call gpe_io_synth_poke;
        mov rdi, 0x425;
        mov rsi, 0x03;                         // both enabled
        call gpe_io_synth_poke;
        call gpe_event_reset;
        call sci_isr_body;
        cmp rax, 1;
        jne evt_w_fail;

        // -- Nothing was queued.
        mov rax, 34;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call gpe_event_pending;
        cmp rax, 0;
        jne evt_w_fail;

        // -- But it WAS counted, per GPE.
        mov rax, 35;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 9;
        call gpe_events;
        cmp rax, 1;
        jne evt_w_fail;
        mov rdi, 9;
        call gpe_strikes;
        cmp rax, 1;
        jne evt_w_fail;

        // -- AND IT SAID SO. One audit record, naming the GPE.
        mov rax, 36;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;                            // DRV_AUDIT_F_EVENT
        call drv_audit_field;
        cmp rax, 8;                            // GPE_AUDIT_EV_UNROUTED
        jne evt_w_fail;
        xor rdi, rdi;
        mov rsi, 3;                            // DRV_AUDIT_F_SUBJECT
        call drv_audit_field;
        cmp rax, 9;                            // the GPE that had nobody
        jne evt_w_fail;
        xor rdi, rdi;
        mov rsi, 5;                            // DRV_AUDIT_F_OUTCOME
        call drv_audit_field;
        cmp rax, 0;                            // 0 = dropped
        jne evt_w_fail;

        // -- Masking GPE 9 left GPE 8's enable bit alone.
        mov rax, 37;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x425;
        call gpe_io_synth_peek;
        cmp rax, 0x01;                         // bit 1 cleared, bit 0 kept
        jne evt_w_fail;

        // -- The pump has nothing to route.
        mov rax, 38;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_pump;
        cmp rax, 0;
        jne evt_w_fail;

        // -- The stream's own no-subscriber path: an offer carrying the
        //    zero identity gpe_lookup returns for an unregistered GPE is
        //    refused and counted as unrouted, not as a ring drop.
        mov rax, 39;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_unrouted;
        mov r12, rax;
        mov rdi, 1;                            // ACPI_EVT_SRC_GPE
        xor rsi, rsi;                          // NO SUBSCRIBER
        mov rdx, 9;
        xor rcx, rcx;
        xor r8,  r8;
        call acpi_evt_offer;
        cmp rax, 0;
        jne evt_w_fail;
        call acpi_evt_unrouted;
        sub rax, r12;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_drops;
        cmp rax, 0;                            // NOT counted as a ring drop
        jne evt_w_fail;

        // -- An unknown source is refused the same way.
        mov rax, 40;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 7;                            // not GPE, not NOTIFY
        mov rsi, 0xAB;
        xor rdx, rdx;
        xor rcx, rcx;
        xor r8,  r8;
        call acpi_evt_offer;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // E. SOURCE DISCRIMINATION
        // ================================================================
        mov rax, 41;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x1234;                       // target node
        mov rsi, 0x80;                         // value (device check)
        mov rdx, 6;                            // target object type
        call acpi_evt_notify;
        cmp rax, 1;
        jne evt_w_fail;

        mov rax, 42;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_depth;
        cmp rax, 1;
        jne evt_w_fail;
        xor rdi, rdi;
        call acpi_evt_peek;
        cmp rax, 2;                            // ACPI_EVT_SRC_NOTIFY
        jne evt_w_fail;
        mov rdi, 6;
        call acpi_evt_peek;
        cmp rax, 0;                            // NOTHING TO ACKNOWLEDGE
        jne evt_w_fail;
        mov rdi, 1;
        call acpi_evt_peek;
        cmp rax, 0xAB;                         // the bound endpoint's identity
        jne evt_w_fail;
        mov rdi, 2;
        call acpi_evt_peek;
        cmp rax, 0x1234;
        jne evt_w_fail;
        mov rdi, 3;
        call acpi_evt_peek;
        cmp rax, 0x80;
        jne evt_w_fail;
        mov rdi, 4;
        call acpi_evt_peek;
        cmp rax, 6;
        jne evt_w_fail;

        // -- Put a GPE-sourced record in the same stream, behind it.
        mov rax, 43;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x421;
        mov rsi, 0x01;
        call gpe_io_synth_poke;
        call sci_isr_body;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_pump;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_depth;
        cmp rax, 2;
        jne evt_w_fail;

        // -- THE TWO ARE DISTINGUISHABLE, on both discriminators.
        mov rax, 44;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;                          // most recent
        xor rsi, rsi;                          // ACPI_EVT_RF_SOURCE
        call acpi_evt_field;
        cmp rax, 1;                            // GPE
        jne evt_w_fail;
        mov rdi, 1;                            // one back
        xor rsi, rsi;
        call acpi_evt_field;
        cmp rax, 2;                            // NOTIFY
        jne evt_w_fail;
        xor rdi, rdi;
        mov rsi, 6;                            // ACPI_EVT_RF_FLAGS
        call acpi_evt_field;
        cmp rax, 1;                            // the GPE owes an ack
        jne evt_w_fail;
        mov rdi, 1;
        mov rsi, 6;
        call acpi_evt_field;
        cmp rax, 0;                            // the notification does not
        jne evt_w_fail;

        // -- Acknowledging a notification by mistake is refused with a
        //    code that says why, rather than silently unmasking anything.
        mov rax, 45;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x1234;                       // the notify target node
        call acpi_evt_ack;
        mov r11, 0xFFFFFFBB;                   // GPE_REG_BAD_INDEX
        cmp rax, r11;
        jne evt_w_fail;
        mov rdi, 9;                            // a real GPE, nothing pending
        call acpi_evt_ack;
        mov r11, 0xFFFFFFB5;                   // GPE_ACK_NOT_PENDING
        cmp rax, r11;
        jne evt_w_fail;

        // -- Drain both and close the GPE out.
        mov rax, 46;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;
        call acpi_evt_pop;
        cmp rax, 0;                            // empty is a poll, not an error
        jne evt_w_fail;
        mov rdi, 8;
        call acpi_evt_ack;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // F. SATURATION — tail-drop, counted, localisable
        // ================================================================
        mov rax, 47;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_stream_reset;
        mov rdi, 19;
        call acpi_evt_bind;
        cmp rax, 0;
        jne evt_w_fail;

        xor r12, r12;                          // offer counter
      evt_w_sat_next:
        cmp r12, 40;
        jae evt_w_sat_done;
        mov rdi, 2;                            // ACPI_EVT_SRC_NOTIFY
        mov rsi, 0xAB;
        mov rdx, r12;                          // a0 = which offer this is
        xor rcx, rcx;
        xor r8,  r8;
        call acpi_evt_offer;
        add r12, 1;
        jmp evt_w_sat_next;

      evt_w_sat_done:
        mov rax, 48;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_depth;
        cmp rax, 32;                           // the ring is full, not overfull
        jne evt_w_fail;
        call acpi_evt_drops;
        cmp rax, 8;                            // 40 - 32
        jne evt_w_fail;
        call acpi_evt_unrouted;
        cmp rax, 0;                            // a full ring is not "no route"
        jne evt_w_fail;
        call acpi_evt_offered;
        cmp rax, 40;
        jne evt_w_fail;
        call acpi_evt_drained;
        cmp rax, 0;
        jne evt_w_fail;

        // -- THE ACCOUNTING IDENTITY:
        //      offered == drained + depth + drops + unrouted
        mov rax, 49;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_drained;
        mov r13, rax;
        call acpi_evt_depth;
        add r13, rax;
        call acpi_evt_drops;
        add r13, rax;
        call acpi_evt_unrouted;
        add r13, rax;
        call acpi_evt_offered;
        cmp rax, r13;
        jne evt_w_fail;

        // -- TAIL-DROP, not overwrite-oldest: the records still in the
        //    ring are the FIRST thirty-two, so the first report of the
        //    condition that caused the overrun survived it.
        mov rax, 50;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;                          // most recent retained
        mov rsi, 5;                            // ACPI_EVT_RF_SEQ
        call acpi_evt_field;
        cmp rax, 31;
        jne evt_w_fail;
        mov rdi, 31;                           // oldest retained
        mov rsi, 5;
        call acpi_evt_field;
        cmp rax, 0;
        jne evt_w_fail;
        mov rdi, 31;
        mov rsi, 2;                            // ACPI_EVT_RF_A0
        call acpi_evt_field;
        cmp rax, 0;                            // offer 0, not offer 8
        jne evt_w_fail;

        // -- Drain all thirty-two; the sequences are contiguous 0..31.
        mov rax, 51;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        xor r12, r12;
      evt_w_drain_next:
        cmp r12, 32;
        jae evt_w_drain_done;
        mov rdi, 5;                            // ACPI_EVT_RF_SEQ
        call acpi_evt_peek;
        cmp rax, r12;
        jne evt_w_fail;
        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;
        add r12, 1;
        jmp evt_w_drain_next;

      evt_w_drain_done:
        mov rax, 52;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_depth;
        cmp rax, 0;
        jne evt_w_fail;
        call acpi_evt_drained;
        cmp rax, 32;
        jne evt_w_fail;

        // -- THE GAP LOCALISES THE LOSS. The next record to arrive
        //    carries sequence 40, not 32: a subscriber reading 31 then
        //    40 knows exactly eight events went missing BETWEEN THOSE
        //    TWO, and eight is what the drop counter says.
        mov rax, 53;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 0xAB;
        mov rdx, 100;
        xor rcx, rcx;
        xor r8,  r8;
        call acpi_evt_offer;
        cmp rax, 1;
        jne evt_w_fail;
        mov rdi, 5;                            // ACPI_EVT_RF_SEQ
        call acpi_evt_peek;
        mov r13, rax;
        cmp r13, 40;
        jne evt_w_fail;
        sub r13, 31;
        sub r13, 1;                            // the size of the gap
        call acpi_evt_drops;
        cmp rax, r13;
        jne evt_w_fail;

        call acpi_evt_pop;
        cmp rax, 1;
        jne evt_w_fail;

        // -- The identity still holds after the drain.
        mov rax, 54;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_drained;
        mov r13, rax;
        call acpi_evt_depth;
        add r13, rax;
        call acpi_evt_drops;
        add r13, rax;
        call acpi_evt_unrouted;
        add r13, rax;
        call acpi_evt_offered;
        cmp rax, r13;
        jne evt_w_fail;

        // ================================================================
        // G. REVOCATION UNBINDS
        // ================================================================
        mov rax, 55;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        call acpi_evt_cap_revoke;
        cmp rax, 0;
        jne evt_w_fail;
        call acpi_evt_ready;
        cmp rax, 0;                            // readiness fell with the row
        jne evt_w_fail;
        mov rdi, rbx;
        call acpi_evt_tail_valid;
        cmp rax, 0;
        jne evt_w_fail;

        mov rax, 56;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        call acpi_evt_unrouted;
        mov r12, rax;
        mov rdi, 1;
        mov rsi, 0xAB;
        mov rdx, 8;
        xor rcx, rcx;
        xor r8,  r8;
        call acpi_evt_offer;
        cmp rax, 0;                            // nowhere to deliver
        jne evt_w_fail;
        call acpi_evt_unrouted;
        sub rax, r12;
        cmp rax, 1;                            // and it said so
        jne evt_w_fail;

        mov rax, 57;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 8;
        call acpi_evt_ack;
        mov r11, 0xFFFFFF95;                   // ACPI_EVT_NOT_READY
        cmp rax, r11;
        jne evt_w_fail;

        mov rax, 58;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 19;
        call acpi_evt_cap_revoke;
        mov r11, 0xFFFFFF96;                   // ACPI_EVT_REVOKE_ALREADY
        cmp rax, r11;
        jne evt_w_fail;
        mov rdi, 17;                           // a KIND_HW
        call acpi_evt_cap_revoke;
        mov r11, 0xFFFFFF97;                   // ACPI_EVT_REVOKE_WRONG_KIND
        cmp rax, r11;
        jne evt_w_fail;

        mov rax, 59;
        lea rcx, [rip + _evt_witness_stage];
        mov [rcx], rax;
        mov rdi, 18;
        call hw_int_cap_revoke;
        cmp rax, 0;
        jne evt_w_fail;

        // ================================================================
        // Teardown
        // ================================================================
        call gpe_io_synth_disable;
        call gpe_io_trace_reset;
        call gpe_event_reset;
        call gpe_table_reset;
        call gpe_config_reset;
        call acpi_evt_stream_reset;
        call acpi_evt_table_reset;

        mov rax, cap_table;
        add rax, 408;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        mov rax, cap_table;
        add rax, 432;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        mov rax, cap_table;
        add rax, 456;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;

        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + evt_route_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      evt_w_fail:
        call gpe_io_synth_disable;
        call gpe_config_reset;
        call acpi_evt_stream_reset;
        mov rax, cap_table;
        add rax, 408;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        mov rax, cap_table;
        add rax, 432;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        mov rax, cap_table;
        add rax, 456;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        lea rax, [rip + _evt_witness_stage];
        mov r8,  [rax + 0];
        mov rdi, 1;                            // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + evt_route_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
