// tests/kernel/acpi/madt_synth.pdx — R20.M2 synthetic MADT fixture
//
// Fabricates a byte-valid MADT holding a mix of sub-entries and drives
// each of the R20.M2 parsers (#809/#810/#811/#812) against it.
//
// Follows the tests/kernel/acpi/xsdt_synth.pdx model — @pub witness
// function callable via GDB, no runtime wire-up at R20.M2 close.
//
// -----------------------------------------------------------------------------
// Fabricated MADT layout (bytes 0..N)
// -----------------------------------------------------------------------------
//
// The blob (_synth_madt_buf) is a byte-flat buffer laid out as:
//
//   +0    "APIC"           u32  (signature)
//   +4    total length     u32  (computed below: 108 = 44 header + 64 body)
//   +8..35 sdt_hdr tail    (zeroed — not consumed by parsers)
//   +36   local_apic_addr  u32  (0xFEE00000 — will be overridden by Type 5)
//   +40   flags            u32  (1 = PC-AT compat)
//   +44   sub-entries start
//
// Sub-entries (in walked order):
//
//   Type 0 (LAPIC, 8 B):
//     [+44] 0x00, 0x08, uid=0x10, apic_id=0x01, flags=0x00000001
//     [+52] 0x00, 0x08, uid=0x11, apic_id=0x02, flags=0x00000001
//     [+60] 0x00, 0x08, uid=0x12, apic_id=0x03, flags=0x00000001
//     [+68] 0x00, 0x08, uid=0x13, apic_id=0x04, flags=0x00000000  (disabled)
//
//   Type 1 (IOAPIC, 12 B):
//     [+76] 0x01, 0x0C, id=0x20, rsv=0x00, base=0xFEC00000, gsi_base=0
//     [+88] 0x01, 0x0C, id=0x21, rsv=0x00, base=0xFEC01000, gsi_base=24
//
//   Type 2 (ISO, 10 B):
//     [+100] 0x02, 0x0A, bus=0, source=0, gsi=2,  flags=0x000F
//     [+110] 0x02, 0x0A, bus=0, source=9, gsi=9,  flags=0x000D
//     [+120] 0x02, 0x0A, bus=0, source=1, gsi=1,  flags=0x0000
//
//   Type 5 (LAPIC ADDR OVERRIDE, 12 B):
//     [+130] 0x05, 0x0C, reserved=0, override=0x00000000FEE01000 (u64)
//
//   Type 9 (x2APIC, 16 B):
//     [+142] 0x09, 0x10, rsv=0, x2apic_id=0x00000100, flags=1, uid=0x40
//     [+158] 0x09, 0x10, rsv=0, x2apic_id=0x00000101, flags=1, uid=0x41
//
// Total: 44 + 4*8 + 2*12 + 3*10 + 12 + 2*16 = 44 + 32 + 24 + 30 + 12 + 32 = 174 B.
//
// -----------------------------------------------------------------------------
// Design note: parser scope
// -----------------------------------------------------------------------------
//
// This fixture exercises the *parsers*, not topology_seed_from_madt (which
// pulls RSDP → XSDT → MADT and merges LAPIC/x2APIC — a live-integration
// witness). Direct parser calls are cleaner to assert against because we
// know each expected count and first-record contents by construction.
//
// The MADT is passed raw to each parser; the sdt_hdr length field (u32
// at +4) bounds the walk. Sub-entry stream begins at +44 (0x2C) and the
// walker terminates when cursor + (type,length) header would exceed end.

module MadtSynth = structure {

  // ==========================================================================
  // UART fingerprint markers
  // ==========================================================================

  pub let madt_synth_ok_msg   : [u8; 14] = "ACPI MADT OK\n\0"
  pub let madt_synth_fail_msg : [u8; 16] = "ACPI MADT FAIL\n\0"

  // ==========================================================================
  // Fabricated MADT — 256-byte buffer @align(8), populated at witness time.
  // ==========================================================================
  //
  // 32 x u64 = 256 B — headroom above the 174-B layout above.

  pub let mut _synth_madt_buf : [u64; 32] = uninit @align(8)

  // ==========================================================================
  // Output scratch buffers (one per parser).
  // ==========================================================================

  pub let mut _synth_out_lapics    : [u64; 32] = uninit @align(8)   // 256 B
  pub let mut _synth_out_ioapics   : [u64; 12] = uninit @align(8)   // 96 B
  pub let mut _synth_out_isos      : [u64; 16] = uninit @align(8)   // 128 B
  pub let mut _synth_out_x2apics   : [u64; 12] = uninit @align(8)   // 96 B

  // ==========================================================================
  // madt_synth_witness — populate MADT, invoke each parser, verify counts + fields.
  // ==========================================================================

  pub let madt_synth_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R20.M2 synthetic MADT fixture — end-to-end exercise of madt_parse_lapics (#809), madt_parse_ioapics + madt_lapic_address (#810), madt_parse_isos (#811), and madt_parse_x2apics + madt_parse_lapic_nmis (#812). Fabricates a byte-flat MADT holding 4 LAPICs (Type 0, one flagged disabled), 2 IOAPICs (Type 1), 3 ISOs (Type 2), 1 LAPIC ADDR OVERRIDE (Type 5, u64 body), and 2 x2APICs (Type 9). Header: sig 'APIC' @ +0, length=174 @ +4, local_apic_address=0xFEE00000 @ +36, flags=1 @ +40. Sub-entries begin at +44 (MADT_OFFSET_SUBENTRIES) and are byte-packed (type,length body...). Parser invocations: (a) madt_parse_lapics(madt, _synth_out_lapics, 32) — expect return 4 (all 4 Type 0 entries, including the flag=0 disabled one — the enabled/online-capable filtering happens in topology_seed_from_madt, not in the parser). First record at _synth_out_lapics[0..16]: acpi_uid=0x10 (u32), apic_id=0x01 (u32), flags=1 (u32). (b) madt_parse_ioapics(...) — expect 2. First record: id=0x20, mmio_base=0xFEC00000, gsi_base=0. (c) madt_parse_isos(...) — expect 3. First: source_irq=0, gsi=2, flags=0x000F. (d) madt_lapic_address(madt) — expect 0xFEE01000 (Type 5 override, NOT the legacy 0xFEE00000 in the header). (e) madt_parse_x2apics(...) — expect 2. First: acpi_uid=0x40, x2apic_id=0x100, flags=1. Any mismatch on count or first-record field emits FAIL and returns 1. All pass: emit OK, return 0. Blob population uses byte-store idioms — for u8 fields via `mov_b [buf+off], rax`, for u16 via `mov_w`, for u32 via `mov_d`. The Type 5 u64 override at offset +134 is stored via a plain `mov` (64-bit) — the buffer is @align(8) but offset 134 is odd-aligned within it; x86-64 tolerates unaligned qword stores per SDM Vol.3 §7.1.1 (same posture as xsdt_synth.pdx entry-pointer stores at unaligned offsets +36/+44/+52). Stack: 1 callee-save push (rbx) yields rsp%16==0 pre-call for the 5 nested parser calls + uart_puts; each call has SysV alignment satisfied without further padding.",
      block: {
        push rbx;

        // ================================================================
        // Zero the entire MADT buffer (32 u64 slots = 256 B).
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        mov rcx, 32;
        mov rdx, 0;
        mov rax, 0;
      madt_synth_zero_loop:
        mov [rdi + rdx * 8], rax;
        add rdx, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne madt_synth_zero_loop;

        // rdi retains &_synth_madt_buf across the field stores below.

        // ================================================================
        // Header
        //   +0..3   signature "APIC" (SIG_APIC = 0x43495041 LE)
        //   +4..7   length = 174
        //   +36..39 local_apic_address = 0xFEE00000
        //   +40..43 flags = 1 (PC-AT compat)
        // ================================================================

        mov rax, 0x43495041;
        mov_d [rdi + 0], rax;                    // signature

        mov rax, 174;
        mov_d [rdi + 4], rax;                    // length

        mov rax, 0xFEE00000;
        mov_d [rdi + 36], rax;                   // local_apic_address

        mov rax, 1;
        mov_d [rdi + 40], rax;                   // flags

        // ================================================================
        // Type 0 (LAPIC) x 4 starting at +44
        //
        // Layout per record:
        //   +0 type=0  +1 length=8  +2 uid  +3 apic_id  +4..7 flags(u32)
        // ================================================================

        // Record 0 @ +44
        mov rax, 0;
        mov_b [rdi + 44], rax;                   // type=0
        mov rax, 8;
        mov_b [rdi + 45], rax;                   // length=8
        mov rax, 0x10;
        mov_b [rdi + 46], rax;                   // uid=0x10
        mov rax, 1;
        mov_b [rdi + 47], rax;                   // apic_id=1
        mov rax, 1;
        mov_d [rdi + 48], rax;                   // flags=1

        // Record 1 @ +52
        mov rax, 0;
        mov_b [rdi + 52], rax;
        mov rax, 8;
        mov_b [rdi + 53], rax;
        mov rax, 0x11;
        mov_b [rdi + 54], rax;
        mov rax, 2;
        mov_b [rdi + 55], rax;
        mov rax, 1;
        mov_d [rdi + 56], rax;

        // Record 2 @ +60
        mov rax, 0;
        mov_b [rdi + 60], rax;
        mov rax, 8;
        mov_b [rdi + 61], rax;
        mov rax, 0x12;
        mov_b [rdi + 62], rax;
        mov rax, 3;
        mov_b [rdi + 63], rax;
        mov rax, 1;
        mov_d [rdi + 64], rax;

        // Record 3 @ +68 — disabled (flags=0)
        mov rax, 0;
        mov_b [rdi + 68], rax;
        mov rax, 8;
        mov_b [rdi + 69], rax;
        mov rax, 0x13;
        mov_b [rdi + 70], rax;
        mov rax, 4;
        mov_b [rdi + 71], rax;
        mov rax, 0;
        mov_d [rdi + 72], rax;                   // disabled

        // ================================================================
        // Type 1 (IOAPIC) x 2 starting at +76
        //
        //   +0 type=1  +1 length=12  +2 id  +3 reserved  +4..7 base  +8..11 gsi_base
        // ================================================================

        // Record 0 @ +76
        mov rax, 1;
        mov_b [rdi + 76], rax;
        mov rax, 12;
        mov_b [rdi + 77], rax;
        mov rax, 0x20;
        mov_b [rdi + 78], rax;
        mov rax, 0;
        mov_b [rdi + 79], rax;
        mov rax, 0xFEC00000;
        mov_d [rdi + 80], rax;                   // base
        mov rax, 0;
        mov_d [rdi + 84], rax;                   // gsi_base=0

        // Record 1 @ +88
        mov rax, 1;
        mov_b [rdi + 88], rax;
        mov rax, 12;
        mov_b [rdi + 89], rax;
        mov rax, 0x21;
        mov_b [rdi + 90], rax;
        mov rax, 0;
        mov_b [rdi + 91], rax;
        mov rax, 0xFEC01000;
        mov_d [rdi + 92], rax;
        mov rax, 24;
        mov_d [rdi + 96], rax;

        // ================================================================
        // Type 2 (ISO) x 3 starting at +100
        //
        //   +0 type=2  +1 length=10  +2 bus=0  +3 source_irq
        //   +4..7 gsi  +8..9 mps_inti_flags(u16)
        // ================================================================

        // Record 0 @ +100
        mov rax, 2;
        mov_b [rdi + 100], rax;
        mov rax, 10;
        mov_b [rdi + 101], rax;
        mov rax, 0;
        mov_b [rdi + 102], rax;
        mov rax, 0;
        mov_b [rdi + 103], rax;                  // source_irq=0
        mov rax, 2;
        mov_d [rdi + 104], rax;                  // gsi=2
        mov rax, 0x000F;
        mov_w [rdi + 108], rax;                  // flags=0x000F

        // Record 1 @ +110
        mov rax, 2;
        mov_b [rdi + 110], rax;
        mov rax, 10;
        mov_b [rdi + 111], rax;
        mov rax, 0;
        mov_b [rdi + 112], rax;
        mov rax, 9;
        mov_b [rdi + 113], rax;
        mov rax, 9;
        mov_d [rdi + 114], rax;
        mov rax, 0x000D;
        mov_w [rdi + 118], rax;

        // Record 2 @ +120
        mov rax, 2;
        mov_b [rdi + 120], rax;
        mov rax, 10;
        mov_b [rdi + 121], rax;
        mov rax, 0;
        mov_b [rdi + 122], rax;
        mov rax, 1;
        mov_b [rdi + 123], rax;
        mov rax, 1;
        mov_d [rdi + 124], rax;
        mov rax, 0;
        mov_w [rdi + 128], rax;

        // ================================================================
        // Type 5 (LAPIC ADDR OVERRIDE) x 1 starting at +130
        //
        //   +0 type=5  +1 length=12  +2..3 reserved(u16)  +4..11 override(u64)
        // ================================================================

        mov rax, 5;
        mov_b [rdi + 130], rax;
        mov rax, 12;
        mov_b [rdi + 131], rax;
        mov rax, 0;
        mov_w [rdi + 132], rax;                  // reserved
        mov rax, 0xFEE01000;
        mov [rdi + 134], rax;                    // 64-bit override (unaligned OK)

        // ================================================================
        // Type 9 (x2APIC) x 2 starting at +142
        //
        //   +0 type=9  +1 length=16  +2..3 reserved(u16)
        //   +4..7 x2apic_id  +8..11 flags  +12..15 acpi_uid
        // ================================================================

        // Record 0 @ +142
        mov rax, 9;
        mov_b [rdi + 142], rax;
        mov rax, 16;
        mov_b [rdi + 143], rax;
        mov rax, 0;
        mov_w [rdi + 144], rax;
        mov rax, 0x100;
        mov_d [rdi + 146], rax;                  // x2apic_id
        mov rax, 1;
        mov_d [rdi + 150], rax;                  // flags
        mov rax, 0x40;
        mov_d [rdi + 154], rax;                  // uid

        // Record 1 @ +158
        mov rax, 9;
        mov_b [rdi + 158], rax;
        mov rax, 16;
        mov_b [rdi + 159], rax;
        mov rax, 0;
        mov_w [rdi + 160], rax;
        mov rax, 0x101;
        mov_d [rdi + 162], rax;
        mov rax, 1;
        mov_d [rdi + 166], rax;
        mov rax, 0x41;
        mov_d [rdi + 170], rax;

        // ================================================================
        // Test 1: madt_parse_lapics — expect 4, first record verify.
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        lea rsi, [rip + _synth_out_lapics];
        mov rdx, 32;                             // max
        call madt_parse_lapics;

        cmp rax, 4;
        jne madt_synth_fail;

        // out[0].acpi_uid @ +0 == 0x10 ?
        lea rcx, [rip + _synth_out_lapics];
        mov eax, [rcx + 0];
        cmp rax, 0x10;
        jne madt_synth_fail;

        // out[0].apic_id @ +4 == 1 ?
        mov eax, [rcx + 4];
        cmp rax, 1;
        jne madt_synth_fail;

        // out[0].flags @ +8 == 1 ?
        mov eax, [rcx + 8];
        cmp rax, 1;
        jne madt_synth_fail;

        // ================================================================
        // Test 2: madt_parse_ioapics — expect 2, first record verify.
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        lea rsi, [rip + _synth_out_ioapics];
        mov rdx, 8;
        call madt_parse_ioapics;

        cmp rax, 2;
        jne madt_synth_fail;

        // out[0].id @ +0 (u64) == 0x20 ?
        lea rcx, [rip + _synth_out_ioapics];
        mov rax, [rcx + 0];
        cmp rax, 0x20;
        jne madt_synth_fail;

        // out[0].mmio_base @ +8 == 0xFEC00000 ?
        mov rax, [rcx + 8];
        mov rdx, 0xFEC00000;
        cmp rax, rdx;
        jne madt_synth_fail;

        // out[0].gsi_base @ +16 == 0 ?
        mov eax, [rcx + 16];
        cmp rax, 0;
        jne madt_synth_fail;

        // ================================================================
        // Test 3: madt_parse_isos — expect 3, first record verify.
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        lea rsi, [rip + _synth_out_isos];
        mov rdx, 16;
        call madt_parse_isos;

        cmp rax, 3;
        jne madt_synth_fail;

        // out[0].source_irq @ +0 == 0 ?
        lea rcx, [rip + _synth_out_isos];
        mov eax, [rcx + 0];
        cmp rax, 0;
        jne madt_synth_fail;

        // out[0].gsi @ +4 == 2 ?
        mov eax, [rcx + 4];
        cmp rax, 2;
        jne madt_synth_fail;

        // out[0].flags @ +8 == 0x000F ?
        mov eax, [rcx + 8];
        cmp rax, 0x000F;
        jne madt_synth_fail;

        // ================================================================
        // Test 4: madt_lapic_address — expect Type 5 override 0xFEE01000.
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        call madt_lapic_address;
        mov rdx, 0xFEE01000;
        cmp rax, rdx;
        jne madt_synth_fail;

        // ================================================================
        // Test 5: madt_parse_x2apics — expect 2, first record verify.
        // ================================================================

        lea rdi, [rip + _synth_madt_buf];
        lea rsi, [rip + _synth_out_x2apics];
        mov rdx, 8;
        call madt_parse_x2apics;

        cmp rax, 2;
        jne madt_synth_fail;

        // out[0].acpi_uid @ +0 == 0x40 ?
        lea rcx, [rip + _synth_out_x2apics];
        mov eax, [rcx + 0];
        cmp rax, 0x40;
        jne madt_synth_fail;

        // out[0].x2apic_id @ +4 == 0x100 ?
        mov eax, [rcx + 4];
        cmp rax, 0x100;
        jne madt_synth_fail;

        // out[0].flags @ +8 == 1 ?
        mov eax, [rcx + 8];
        cmp rax, 1;
        jne madt_synth_fail;

        // ================================================================
        // All tests passed.
        // ================================================================

        lea rdi, [rip + madt_synth_ok_msg];
        call uart_puts;

        mov rax, 0;
        pop rbx;
        ret;

      madt_synth_fail:
        lea rdi, [rip + madt_synth_fail_msg];
        call uart_puts;

        mov rax, 1;
        pop rbx;
        ret
      }
    } @no_frame
}
