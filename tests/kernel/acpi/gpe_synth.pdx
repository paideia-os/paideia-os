// tests/kernel/acpi/gpe_synth.pdx — R30.M4-001 (#1066) / R30.M4-002 (#1067)
//
// Boot witness for the SCI/GPE interrupt path.
//
// -----------------------------------------------------------------------------
// Why this is a boot witness and not a userspace corpus fixture
// -----------------------------------------------------------------------------
//
// R30's earlier milestones were exercised by the byte-fixture corpus in
// tests/user, because the code under test was a userspace parser fed
// firmware bytes. Nothing in this milestone is: the ISR, the block
// decomposition, the registration table and the storm gate are all
// kernel-side, and the properties that matter are properties of the
// SHIPPING code path rather than of a library. So the fixture drives
// the real functions, linked into the real kernel, at boot.
//
// It touches no ACPI hardware. Every register the ISR reads or writes
// is a byte of a 512-byte RAM window installed through the seam in
// src/kernel/core/acpi/gpe_io.pdx, and the ISR does not know: the mode
// switch lives entirely inside gpe_io_read8 / gpe_io_write8 / gpe_io_eoi,
// so core/acpi/sci_isr.pdx executes the same instructions here as it
// does against a real GPE block.
//
// -----------------------------------------------------------------------------
// What each sub-test establishes
// -----------------------------------------------------------------------------
//
//   A  Configuration refusals: odd block length, a length with no port,
//      and GPE1_BASE overlapping GPE0's range. Each leaves the module
//      unconfigured rather than partially configured.
//   B  Configuration from a fabricated fadt_info — the production
//      marshalling path, not a hand-built geometry.
//   C  Block/bit decomposition, including the case the whole design
//      turns on: index 40 must resolve to the GPE1 block at byte 1
//      bit 0, and to port 0x431/0x433, NOT to GPE0.
//   D  Registration refusals with distinct codes: out of range (twice —
//      past the whole space, and inside the 256-entry table but outside
//      the configured geometry), a zero subscriber, and a duplicate.
//   E  One GPE0 event through the real ISR, with three ORDERING
//      assertions read off the access trace: the enable write precedes
//      the status write, the status write precedes the EOI, and the
//      enable read-back that produced the event record's snapshot
//      happens after the mask. Plus the snapshot itself: this GPE's
//      enable bit is clear in the byte that was live when the event
//      was queued.
//   F  Acknowledgement: unmasks, resets strikes, clears pending; a
//      second acknowledgement is refused.
//   G  A GPE1 event. Asserted by the INDEX in the queued record (40,
//      not 8) and by the ports in the trace (0x431/0x433, and no access
//      at all to the GPE0 block during the run).
//   H  Storm: ten consecutive assertions of one GPE. Retired on the
//      ninth, exactly one audit record, no further events queued, and
//      the ISR keeps returning — the system survives.
//   I  SCI route resolution: ACPI defaults with no override, an
//      explicit firmware declaration overriding them, a bus-conformant
//      declaration NOT overriding them, and a GSI remap.
//   J  The redirection entry, programmed into a synthetic IOAPIC MMIO
//      window and read back: level, active low, masked.
//   K  KIND_HW_INTERRUPT minted for the SCI, carrying the resolved GSI
//      and level trigger, then revoked.
//
// On any failure the stage number in _gpe_witness_stage identifies the
// sub-test, and the seam is returned to real port I/O on both exits so
// a failed witness cannot leave the kernel addressing RAM in place of
// the platform's GPE block.

module GpeSynth = structure {

  // Stage tracker. Memory-backed rather than a register, matching the
  // discipline of _kind_opreg_witness_stage: it has to survive every
  // callee-save-clobber pattern in the primitives under test.
  pub let mut _gpe_witness_stage : u64 = 0

  // Fabricated 64-byte fadt_info for the gpe_config_from_fadt path.
  pub let mut _gpe_w_fadt_info : [u64; 8] = uninit @align(8)

  // Two 16-byte MADT Interrupt Source Override records.
  pub let mut _gpe_w_iso : [u64; 4] = uninit @align(8)

  // 64-byte synthetic IOAPIC MMIO window: IOREGSEL at +0, IOWIN at +0x10.
  pub let mut _gpe_w_ioapic : [u64; 8] = uninit @align(64)

  pub let gpe_dispatch_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M4-001 (#1066) / R30.M4-002 (#1067): boot witness for the SCI/GPE path. Drives the shipping ISR, block decomposition, registration table, storm gate, acknowledgement path, SCI route resolver and IOAPIC programmer against a 512-byte synthetic register window and a 64-byte synthetic IOAPIC window, with no ACPI hardware touched. Sub-tests A..K are described in the file header; the stage number written to _gpe_witness_stage before each assertion identifies which one refused. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; all cross-call state that is not in those registers lives in module .bss for the same reason the stage counter does. Both exits call gpe_io_synth_disable and gpe_config_reset, so a failure cannot leave the seam pointing at RAM or a fabricated geometry installed. cap_table slots 15 and 16 are pre-cleaned before use and re-zeroed afterwards; they are outside the set any other witness consumes (0..8, 10, 11, 12, 14, 28..33). Labels prefixed gpe_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Configuration refusals
        // ================================================================
        call gpe_config_reset;
        call gpe_table_reset;
        call gpe_event_reset;
        call gpe_io_trace_reset;

        mov rax, 1;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        // Odd GPE0_BLK_LEN -> GPE_CFG_BAD_LEN.
        mov rdi, 0x420;
        mov rsi, 7;
        xor rdx, rdx;
        xor rcx, rcx;
        xor r8,  r8;
        call gpe_config_set;
        mov r11, 0xFFFFFFBE;
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 2;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call gpe_configured;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 3;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        // GPE1_BASE below GPE0's count -> GPE_CFG_OVERLAP.
        mov rdi, 0x420;
        mov rsi, 8;
        mov rdx, 0x430;
        mov rcx, 4;
        mov r8,  2;
        call gpe_config_set;
        mov r11, 0xFFFFFFBD;
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 4;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        // A length with no port -> GPE_CFG_BAD_ARG.
        xor rdi, rdi;
        mov rsi, 8;
        xor rdx, rdx;
        xor rcx, rcx;
        xor r8,  r8;
        call gpe_config_set;
        mov r11, 0xFFFFFFBF;
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 5;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call gpe_configured;
        cmp rax, 0;
        jne gpe_w_fail;

        // ================================================================
        // B. Configuration through the production fadt_info path
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;

        lea r10, [rip + _gpe_w_fadt_info];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rax, 0x420;
        mov_w [r10 + 24], rax;                 // gpe0_blk_port
        mov rax, 0x430;
        mov_w [r10 + 26], rax;                 // gpe1_blk_port
        mov rax, 8;
        mov_b [r10 + 28], rax;                 // gpe0_blk_len  -> 4 status bytes
        mov rax, 4;
        mov_b [r10 + 29], rax;                 // gpe1_blk_len  -> 2 status bytes
        mov rax, 32;
        mov_b [r10 + 30], rax;                 // gpe1_base

        lea rdi, [rip + _gpe_w_fadt_info];
        call gpe_config_from_fadt;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 7;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call gpe_total_count;
        cmp rax, 48;                           // 32 GPE0 + 16 GPE1
        jne gpe_w_fail;

        mov rax, 8;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call gpe_block_reg_bytes;
        cmp rax, 4;
        jne gpe_w_fail;
        mov rdi, 1;
        call gpe_block_reg_bytes;
        cmp rax, 2;
        jne gpe_w_fail;

        mov rax, 9;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call gpe_block_status_base;
        cmp rax, 0x420;
        jne gpe_w_fail;
        xor rdi, rdi;
        call gpe_block_enable_base;
        cmp rax, 0x424;                        // base + status-half width
        jne gpe_w_fail;
        mov rdi, 1;
        call gpe_block_status_base;
        cmp rax, 0x430;
        jne gpe_w_fail;
        mov rdi, 1;
        call gpe_block_enable_base;
        cmp rax, 0x432;
        jne gpe_w_fail;
        mov rdi, 1;
        call gpe_block_index_base;
        cmp rax, 32;                           // GPE1_BASE, not gpe0_count
        jne gpe_w_fail;

        // ================================================================
        // C. Block/bit decomposition
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        call gpe_resolve;
        cmp rax, 0;                            // block 0, byte 0, bit 0
        jne gpe_w_fail;

        mov rax, 11;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 31;
        call gpe_resolve;
        cmp rax, 0x0307;                       // block 0, byte 3, bit 7
        jne gpe_w_fail;

        mov rax, 12;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 32;
        call gpe_resolve;
        mov r11, 0x010000;                     // block 1, byte 0, bit 0
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 13;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 45;
        call gpe_resolve;
        mov r11, 0x010105;                     // block 1, byte 1, bit 5
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 14;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 48;                           // one past GPE1's last event
        call gpe_resolve;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 15;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 45;
        call gpe_status_port;
        cmp rax, 0x431;
        jne gpe_w_fail;
        mov rdi, 45;
        call gpe_enable_port;
        cmp rax, 0x433;
        jne gpe_w_fail;

        // ================================================================
        // D. Registration refusals and the happy path
        // ================================================================
        mov rax, 16;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 48;                           // outside the geometry
        mov rsi, 0x1111;
        call gpe_register;
        mov r11, 0xFFFFFFBB;                   // GPE_REG_BAD_INDEX
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 17;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 200;                          // inside the table, outside the blocks
        mov rsi, 0x1111;
        call gpe_register;
        mov r11, 0xFFFFFFBB;
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 18;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        xor rsi, rsi;                          // zero subscriber
        call gpe_register;
        mov r11, 0xFFFFFFB9;                   // GPE_REG_BAD_HANDLER
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 19;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 0xAAAA;
        call gpe_register;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 20;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        mov rsi, 0xBBBB;                       // second registration
        call gpe_register;
        mov r11, 0xFFFFFFBA;                   // GPE_REG_DUPLICATE
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 21;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call gpe_lookup;
        cmp rax, 0xAAAA;                       // the first registration survives
        jne gpe_w_fail;

        mov rax, 22;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 300;
        call gpe_unregister;
        mov r11, 0xFFFFFFBB;
        cmp rax, r11;
        jne gpe_w_fail;
        mov rdi, 6;
        call gpe_unregister;
        mov r11, 0xFFFFFFB8;                   // GPE_REG_NOT_REGISTERED
        cmp rax, r11;
        jne gpe_w_fail;

        // ================================================================
        // E. One GPE0 event through the real ISR
        // ================================================================
        mov rax, 23;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;

        mov rdi, 0x420;                        // window origin = GPE0_BLK
        call gpe_io_synth_enable;

        // GPE 5: status byte 0 bit 5 set, enable byte 0 bit 5 set.
        mov rdi, 0x420;
        mov rsi, 0x20;
        call gpe_io_synth_poke;
        mov rdi, 0x424;
        mov rsi, 0x20;
        call gpe_io_synth_poke;

        call gpe_io_trace_reset;
        call gpe_event_reset;

        call sci_isr_body;
        cmp rax, 1;                            // exactly one bit serviced
        jne gpe_w_fail;

        // -- the mask stuck --
        mov rax, 24;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x424;
        call gpe_io_synth_peek;
        and rax, 0x20;
        cmp rax, 0;
        jne gpe_w_fail;

        // -- ORDERING: mask write, then status clear, then EOI --
        mov rax, 25;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;                            // GPE_TRACE_OP_WRITE
        mov rsi, 0x424;                        // enable port
        xor rdx, rdx;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;
        mov r12, rax;                          // mask index

        mov rax, 26;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 0x420;                        // status port
        xor rdx, rdx;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;
        mov r13, rax;                          // clear index

        mov rax, 27;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 3;                            // GPE_TRACE_OP_EOI
        xor rsi, rsi;
        call gpe_io_trace_find_op;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;
        mov r14, rax;                          // EOI index

        mov rax, 28;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        cmp r12, r13;
        jae gpe_w_fail;                        // mask must precede clear
        cmp r13, r14;
        jae gpe_w_fail;                        // clear must precede EOI

        // -- the snapshot read-back happened after the mask --
        mov rax, 29;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 1;                            // GPE_TRACE_OP_READ
        mov rsi, 0x424;
        mov rdx, r12;
        add rdx, 1;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;
        cmp rax, r14;
        jae gpe_w_fail;                        // and before the EOI

        // -- the queued record --
        mov rax, 30;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call gpe_event_pending;
        cmp rax, 1;
        jne gpe_w_fail;

        mov rax, 31;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;                          // GPE_EV_F_INDEX
        call gpe_event_field;
        cmp rax, 5;
        jne gpe_w_fail;

        // MASK-BEFORE-ENQUEUE: this GPE's bit is clear in the enable
        // byte that was live at the moment the record was created.
        mov rax, 32;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;                            // GPE_EV_F_ENABLE_SNAP
        call gpe_event_field;
        and rax, 0x20;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 33;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call gpe_strikes;
        cmp rax, 1;
        jne gpe_w_fail;
        mov rdi, 5;
        call gpe_row_flags;
        and rax, 4;                            // GPE_ROW_F_PENDING
        cmp rax, 4;
        jne gpe_w_fail;

        // ================================================================
        // F. Acknowledgement
        // ================================================================
        mov rax, 34;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call gpe_ack;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 35;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 0x424;
        call gpe_io_synth_peek;
        and rax, 0x20;
        cmp rax, 0x20;                         // re-enabled
        jne gpe_w_fail;
        mov rdi, 5;
        call gpe_strikes;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rax, 36;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call gpe_ack;                          // nothing pending now
        mov r11, 0xFFFFFFB5;                   // GPE_ACK_NOT_PENDING
        cmp rax, r11;
        jne gpe_w_fail;

        // ================================================================
        // G. A GPE1 event resolves to the GPE1 block
        // ================================================================
        mov rax, 37;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call gpe_unregister;
        cmp rax, 0;
        jne gpe_w_fail;

        mov rdi, 40;
        mov rsi, 0xCCCC;
        call gpe_register;
        cmp rax, 0;
        jne gpe_w_fail;

        // Quiesce GPE0 entirely, then assert GPE 40 in the GPE1 block:
        // 40 - GPE1_BASE(32) = 8 -> byte 1, bit 0 -> status 0x431, enable 0x433.
        mov rdi, 0x420;
        xor rsi, rsi;
        call gpe_io_synth_poke;
        mov rdi, 0x424;
        xor rsi, rsi;
        call gpe_io_synth_poke;
        mov rdi, 0x431;
        mov rsi, 1;
        call gpe_io_synth_poke;
        mov rdi, 0x433;
        mov rsi, 1;
        call gpe_io_synth_poke;

        call gpe_io_trace_reset;
        call gpe_event_reset;

        call sci_isr_body;
        cmp rax, 1;
        jne gpe_w_fail;

        mov rax, 38;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;
        call gpe_event_field;
        cmp rax, 40;                           // the FLAT index, not 8
        jne gpe_w_fail;

        mov rax, 39;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;                            // WRITE
        mov rsi, 0x433;                        // GPE1 enable byte 1
        xor rdx, rdx;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;

        mov rax, 40;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 0x431;                        // GPE1 status byte 1
        xor rdx, rdx;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  gpe_w_fail;

        // And nothing was written to the GPE0 block at all: had the
        // decomposition sent index 40 through GPE0 it would have
        // addressed 0x421/0x425 and reported the event as index 8.
        mov rax, 41;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 0x425;
        xor rdx, rdx;
        call gpe_io_trace_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne gpe_w_fail;

        // ================================================================
        // H. Storm: ten consecutive assertions of one GPE
        // ================================================================
        mov rax, 42;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 40;
        call gpe_unregister;
        cmp rax, 0;
        jne gpe_w_fail;
        mov rdi, 0x431;
        xor rsi, rsi;
        call gpe_io_synth_poke;
        mov rdi, 0x433;
        xor rsi, rsi;
        call gpe_io_synth_poke;

        mov rdi, 7;
        mov rsi, 0xDDDD;
        call gpe_register;
        cmp rax, 0;
        jne gpe_w_fail;

        call gpe_event_reset;
        xor r15, r15;                          // iteration counter

      gpe_w_storm_next:
        cmp r15, 10;
        jae gpe_w_storm_done;
        // The source re-asserts and something re-enables the line: this
        // is the case clear-before-EOI alone does not fix.
        mov rdi, 0x420;
        mov rsi, 0x80;
        call gpe_io_synth_poke;
        mov rdi, 0x424;
        mov rsi, 0x80;
        call gpe_io_synth_poke;
        call gpe_io_trace_reset;
        call sci_isr_body;
        add r15, 1;
        jmp gpe_w_storm_next;

      gpe_w_storm_done:
        mov rax, 43;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 7;
        call gpe_is_perm_masked;
        cmp rax, 1;
        jne gpe_w_fail;

        mov rax, 44;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 7;
        call gpe_strikes;
        cmp rax, 10;
        jne gpe_w_fail;

        // Eight assertions were queued; the ninth retired the GPE and
        // neither it nor the tenth produced an event.
        mov rax, 45;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call gpe_event_pending;
        cmp rax, 8;
        jne gpe_w_fail;

        // Exactly one audit record, and it is the retirement.
        mov rax, 46;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 1;                            // DRV_AUDIT_F_EVENT
        call drv_audit_field;
        cmp rax, 7;                            // GPE_AUDIT_EV_STORM
        jne gpe_w_fail;
        xor rdi, rdi;
        mov rsi, 3;                            // DRV_AUDIT_F_SUBJECT
        call drv_audit_field;
        cmp rax, 7;                            // the GPE index
        jne gpe_w_fail;
        xor rdi, rdi;
        mov rsi, 4;                            // DRV_AUDIT_F_PRINCIPAL
        call drv_audit_field;
        cmp rax, 9;                            // the strike count that retired it
        jne gpe_w_fail;

        // The system survives: the ISR still runs and still refuses to
        // revive the retired GPE.
        mov rax, 47;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        call sci_isr_body;
        mov rdi, 7;
        call gpe_ack;
        mov r11, 0xFFFFFFB6;                   // GPE_ACK_PERM_MASKED
        cmp rax, r11;
        jne gpe_w_fail;

        call gpe_io_synth_disable;

        // ================================================================
        // I. SCI route resolution
        // ================================================================
        mov rax, 48;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        // No override stream at all: the ACPI-specified defaults stand.
        mov rdi, 9;
        xor rsi, rsi;
        xor rdx, rdx;
        call sci_route_resolve;
        mov r12, rax;
        mov rdi, r12;
        call sci_route_gsi;
        cmp rax, 9;
        jne gpe_w_fail;
        mov rdi, r12;
        call sci_route_polarity;
        cmp rax, 1;                            // active low
        jne gpe_w_fail;
        mov rdi, r12;
        call sci_route_trigger;
        cmp rax, 1;                            // level
        jne gpe_w_fail;

        // Two ISO records: source 0 -> GSI 2 (the usual PIT remap) and
        // source 9 declaring active HIGH / EDGE explicitly.
        lea r10, [rip + _gpe_w_iso];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        xor rax, rax;
        mov_d [r10 + 0], rax;                  // source 0
        mov rax, 2;
        mov_d [r10 + 4], rax;                  // -> GSI 2
        xor rax, rax;
        mov_d [r10 + 8], rax;                  // bus conformant
        mov rax, 9;
        mov_d [r10 + 16], rax;                 // source 9
        mov rax, 9;
        mov_d [r10 + 20], rax;                 // -> GSI 9
        mov rax, 5;                            // 0b0101: high, edge
        mov_d [r10 + 24], rax;

        mov rax, 49;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 9;
        lea rsi, [rip + _gpe_w_iso];
        mov rdx, 2;
        call sci_route_resolve;
        mov r12, rax;
        mov rdi, r12;
        call sci_route_polarity;
        cmp rax, 0;                            // firmware's declaration wins
        jne gpe_w_fail;
        mov rdi, r12;
        call sci_route_trigger;
        cmp rax, 0;
        jne gpe_w_fail;

        // Bus-conformant is NOT a declaration: the ACPI SCI default
        // must survive it rather than be reconfigured as edge.
        mov rax, 50;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + _gpe_w_iso];
        xor rax, rax;
        mov_d [r10 + 24], rax;                 // bus conformant
        mov rax, 20;
        mov_d [r10 + 20], rax;                 // and remap the GSI
        mov rdi, 9;
        lea rsi, [rip + _gpe_w_iso];
        mov rdx, 2;
        call sci_route_resolve;
        mov r12, rax;
        mov rdi, r12;
        call sci_route_gsi;
        cmp rax, 20;                           // the remap IS honoured
        jne gpe_w_fail;
        mov rdi, r12;
        call sci_route_polarity;
        cmp rax, 1;                            // still active low
        jne gpe_w_fail;
        mov rdi, r12;
        call sci_route_trigger;
        cmp rax, 1;                            // still level
        jne gpe_w_fail;

        // ================================================================
        // J. The redirection entry, programmed and read back
        // ================================================================
        mov rax, 51;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + _gpe_w_ioapic];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov rax, 0x170000;                     // IOAPICVER: MRE = 23 -> 24 entries
        mov_d [r10 + 16], rax;

        // Resolve with no override: GSI 9, active low, level.
        mov rdi, 9;
        xor rsi, rsi;
        xor rdx, rdx;
        call sci_route_resolve;
        mov r12, rax;

        lea rdi, [rip + _gpe_w_ioapic];
        mov rsi, r12;
        mov rdx, 0x40;                         // vector
        xor rcx, rcx;                          // destination APIC id 0
        mov r8,  1;                            // MASKED at R30.M4
        call sci_route_program;
        cmp rax, 1;
        jne gpe_w_fail;

        mov rax, 52;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + _gpe_w_ioapic];
        mov eax, [r10 + 0];
        cmp rax, 0x22;                         // IOREGSEL left at 0x10 + 2*9
        jne gpe_w_fail;

        mov rax, 53;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + _gpe_w_ioapic];
        mov eax, [r10 + 16];                   // the LO dword, written last
        mov r11, 0x1A040;                      // vector 0x40 | low | level | masked
        cmp rax, r11;
        jne gpe_w_fail;

        // A zero GSI is refused without touching the IOAPIC.
        mov rax, 54;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea rdi, [rip + _gpe_w_ioapic];
        xor rsi, rsi;                          // packed route with GSI 0
        mov rdx, 0x40;
        xor rcx, rcx;
        mov r8,  1;
        call sci_route_program;
        cmp rax, 0;
        jne gpe_w_fail;
        lea r10, [rip + _gpe_w_ioapic];
        mov eax, [r10 + 0];
        cmp rax, 0x22;                         // untouched
        jne gpe_w_fail;

        // ================================================================
        // K. KIND_HW_INTERRUPT for the SCI
        // ================================================================
        mov rax, 55;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;

        // Pre-clean slots 15 (target) and 16 (KIND_HW parent).
        lea rax, [rip + cap_table];
        add rax, 360;                          // slot 15 * 24
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        lea rax, [rip + cap_table];
        add rax, 384;                          // slot 16 * 24
        mov r11, 14;                           // KIND_HW
        mov [rax + 0],  r11;
        mov r11, 0x618;                        // R_HW_INT_ALL
        mov [rax + 8],  r11;
        xor rcx, rcx;
        mov [rax + 16], rcx;

        mov rdi, 15;                           // target slot
        mov rsi, 16;                           // KIND_HW parent
        mov rdx, 0x618;                        // rights
        mov rcx, 9;                            // the resolved SCI GSI
        mov r8,  1;                            // cpu affinity: BSP
        mov r9,  1;                            // edge_or_level = LEVEL
        call hw_int_cap_mint;
        cmp rax, 0;                            // HW_INT_MINT_OK
        jne gpe_w_fail;

        mov rax, 56;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + cap_table];
        add r10, 360;
        mov rax, [r10 + 0];
        mov r11, 0x140;                        // KIND_HW_INTERRUPT
        cmp rax, r11;
        jne gpe_w_fail;

        mov rax, 57;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        lea r10, [rip + cap_table];
        add r10, 360;
        mov rdi, [r10 + 16];
        and rdi, 0xFFFF;                       // row id
        mov r13, rdi;
        call hw_int_tail_decode_gsi;
        cmp rax, 9;
        jne gpe_w_fail;
        mov rdi, r13;
        call hw_int_tail_decode_edge_or_level;
        cmp rax, 1;                            // LEVEL, as ACPI requires
        jne gpe_w_fail;

        mov rax, 58;
        lea rcx, [rip + _gpe_witness_stage];
        mov [rcx], rax;
        mov rdi, 15;
        call hw_int_cap_revoke;
        cmp rax, 0;
        jne gpe_w_fail;

        // Leave the capability table as we found it.
        lea rax, [rip + cap_table];
        add rax, 360;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;
        lea rax, [rip + cap_table];
        add rax, 384;
        xor rcx, rcx;
        mov [rax + 0],  rcx;
        mov [rax + 8],  rcx;
        mov [rax + 16], rcx;

        // ================================================================
        // Teardown
        // ================================================================
        call gpe_io_synth_disable;
        call gpe_io_trace_reset;
        call gpe_event_reset;
        call gpe_table_reset;
        call gpe_config_reset;

        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gpe_dispatch_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpe_w_fail:
        call gpe_io_synth_disable;
        call gpe_config_reset;
        lea rax, [rip + _gpe_witness_stage];
        mov r8,  [rax + 0];
        mov rdi, 1;                            // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + gpe_dispatch_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
