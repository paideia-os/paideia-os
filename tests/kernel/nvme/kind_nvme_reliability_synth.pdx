// tests/kernel/nvme/kind_nvme_reliability_synth.pdx -- R51.M4 boot witness.
//
// Boot witness for the R51.M4 reliability substrate landed so far:
// nvme_reliability.pdx (BDEV_OP_FLUSH #1651, BDEV_OP_TRIM #1652) and
// nvme_admin_events.pdx (AER refill loop #1653, GET_LOG_PAGE #1654).
//
// Design authority: design/hardware/nvme-oncs-reliability.md (commit
// 1682a41) §7 (witness shape).
//
// -----------------------------------------------------------------------------
// Fingerprint-name and scope deviations from design §7 (both directed
// by this commit's issuing task, which takes precedence over the
// design doc's literal text for these two points)
// -----------------------------------------------------------------------------
//
//   - §7 names the fingerprint `KIND_NVME_REL OK` / `KIND_NVME_REL
//     FAIL`.  This commit's task explicitly specifies `KIND_NVME_
//     RELIABILITY OK` / `... FAIL` instead (still no R51/#165* tag,
//     so `design/policy/output-provenance-strip.md` is still
//     satisfied).  Flagged here for the design doc's next revision.
//   - §7.1/§7.2 lay out 27 numbered stages covering FLUSH, TRIM, AER,
//     GET_LOG_PAGE, the watchdog (#1655) and CFS/NSSR (#1656).  At
//     this commit #1655/#1656 have not landed -- nvme_recovery.pdx
//     does not exist in this tree -- so the watchdog/CFS/NSSR stages
//     (design's stages 18-21) are omitted entirely rather than stubbed
//     with dead calls to nonexistent functions.  This file instead
//     witnesses exactly what #1651-#1654 shipped: FLUSH substrate
//     (ONCS[0] gate), TRIM substrate (ONCS[2] gate + DSM range
//     validation), AER pool init + refill + drain-one, and
//     GET_LOG_PAGE's LID/admin-readiness decode.  A follow-up commit
//     that lands #1655/#1656 should extend this file's substrate
//     section (not create a fourth nvme witness file) and drop this
//     note.
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// SUBSTRATE MODE (stages 1..19, always runs on smoke).  Synthesizes a
// KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV row
// pair via the M1/M2 primitives (same recipe as
// kind_nvme_io_queues_synth.pdx), then drives:
//
//   - cap_handler_blkdev op 5 (FLUSH) / op 6 (TRIM) rights-gate denial
//     against the dual-kind-minted KIND_BLKDEV cap (rights 0x07,
//     R_BLK_ALL_TAG -- predates R51.M4-001's R_BLK_ALL widening to
//     0x1F) -- this directly exercises the residual gap
//     cap_handler_blkdev.pdx's own header flags: "a dual-kind KIND_
//     BLKDEV cap minted through nvme_ns_dual_kind_mint cannot yet
//     request R_BLK_FLUSH/R_BLK_TRIM".
//   - a second KIND_BLKDEV cap minted directly via cap_mint_write (which
//     does not rights-validate -- only the derivation/mint-gate does,
//     per kind_nvme_io_queues_synth.pdx's own nqiow_pci_synth
//     precedent) with rights = R_BLK_ALL (0x1F, post-widening), used
//     to reach FLUSH/TRIM's actual bodies.
//   - FLUSH/TRIM refused with NVMEREL_FLUSH_UNSUP / NVMEREL_TRIM_UNSUP
//     while ONCS is forged to 0x0000; both reach NVMEIO_PICK_NONE
//     once ONCS is forged to 0x0005 (Compare|DSM) -- the M4-consistent
//     "gate passed, submit refused for the M3 no-live-pair reason".
//   - TRIM's three argument-validation refusals (range_count==0, a
//     flags value with reserved bits set, a non-page-aligned
//     dsm_desc_iova).
//   - nvme_get_log_page's LID validation (an LID outside {0x01,0x02})
//     and its "admin queue not brought up yet" refusal (admin_ctx_pa
//     still 0 -- neither nvme_log_smart_fetch nor nvme_log_error_info_
//     fetch has forged an admin context yet at this point in the
//     stage sequence -- see next bullet for why that ordering matters).
//   - AER pool init (nvme_aer_pool_init reaching count==4), refill-
//     when-full (NVMEREL_AER_POOL_FULL), drain-one on a synthesized
//     matching CQE (slot freed + immediately refilled), and drain-one
//     on a non-matching CQE (NVMEREL_AER_NO_ENDPOINT).  These need a
//     real-shaped (if synthetic-bar0-backed) admin_ctx: this file
//     calls nvme_admin_queue_init(bar0, &_nvme_admin_ctx) + nvme_
//     ctrl_row_admin_ctx_set (the exact pair nvme_ctrl_bring_up itself
//     calls, drivers/nvme/queue.pdx + kind_nvme_controller.pdx L1264-
//     1270) rather than running the full CC.EN reset ladder, which
//     the M1 witness's own header already documents as unreachable
//     against a synthetic bar0 ("we cannot exercise the success ladder
//     end-to-end without a real MMIO substrate").  AER refill uses
//     nvme_admin_submit_nopoll (fire-and-forget, no spin) so this is
//     safe against synthetic backing memory; GET_LOG_PAGE's admin path
//     uses nvme_admin_submit_poll (blocking spin against a phase-tag
//     that will never flip without a real controller), so the LID/
//     admin-readiness stage above deliberately runs BEFORE this
//     forged admin_ctx is stamped, to avoid a ~1.5 s spin-to-timeout
//     per call for no additional coverage (the bad-LID and admin-not-
//     ready paths both return before ever reaching the poll).
//
// WIRE MODE (stages 20..27, guarded by `_nvme_device_count > 0`,
// dormant under BIOS/-kernel boot).  Mirrors kind_nvme_io_queues_
// synth.pdx's own wire-mode recipe (real M1 bring-up to NEGOTIATED, M2
// enumeration, MSI-X alloc + nvme_io_bring_up_all to reach a live I/O
// pair) then issues a real BDEV_OP_FLUSH, a real BDEV_OP_TRIM (single
// 128-block range at LBA 1024, matching design §7.2 step 24), a real
// SMART fetch, and a real error-info fetch -- calling
// cap_handler_blkdev directly with rights = R_BLK_ALL (0x1F) rather
// than through a minted cap slot, for the same reason kind_nvme_io_
// queues_synth.pdx's own wire-mode section does: nvme_ns_enumerate
// mints `_nvme_namespace_table` rows without stamping a KIND_BLKDEV
// cap descriptor for them.
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: the one sub-8-byte load in this file (wire-mode SMART/error-
//       info byte-0 read) uses the xor+mov_b zero-extension idiom;
//       every sized STORE (mov_d/mov_w for the synthetic AER CQE's
//       DW0/CID fields) addresses `[base + imm]`, never `[reg + reg]`,
//       so the byte-store scale trap does not apply.
//   G4: every sentinel compared against a value with bit 31/63 set is
//       staged through `mov r10, <imm>; cmp reg, r10` (imm32 cmp
//       operands sign-extend) -- identical posture to nvme_
//       reliability.pdx / nvme_admin_events.pdx / cap_handler_blkdev.pdx.
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `nrelw_`.
//
// Cap slots 128..139 reserved (cleared at entry and on every exit
// path, mirroring kind_nvme_io_queues_synth.pdx's own 128..140 range;
// re-used freely because these witnesses run strictly sequentially in
// the r30_platform.pdx boot-witness call chain and each fully resets
// cap/table state before returning):
//   128 = synth KIND_PCI_DEV parent (controller mint gate)
//   129 = synth KIND_HW_INTERRUPT parent (wire-mode MSI-X only)
//   130 = KIND_NVME_CONTROLLER (row 0; bar0 = 0x100000 synth in
//         substrate mode, real bar0 in wire mode)
//   131 = KIND_NVME_NAMESPACE (M2 dual-kind mint child, substrate only)
//   132 = KIND_BLKDEV (M2 dual-kind mint child, rights 0x07 legacy --
//         the residual-gap rights-denial probe)
//   133..136 = KIND_HW_MSIX_VECTOR (wire-mode only)
//   139 = KIND_BLKDEV, rights = R_BLK_ALL (0x1F) minted directly via
//         cap_mint_write (substrate FLUSH/TRIM probe)

module KindNvmeReliabilitySynth = structure {

  pub let mut _nrelw_stage : u64 = 0

  pub let nrelw_ok   : [u8; 26] = "KIND_NVME_RELIABILITY OK\n\0"
  pub let nrelw_fail : [u8; 28] = "KIND_NVME_RELIABILITY FAIL\n\0"

  // Wire-mode-only extra fingerprint (never fires under the standard
  // BIOS/-kernel smoke this commit's golden line covers; kept for
  // `tools/run-smoke.sh --nvme` per design §7.4).
  pub let nrelw_wire_ok : [u8; 31] = "KIND_NVME_RELIABILITY WIRE OK\n\0"

  // FLUSH/TRIM descriptor page (design §4.2/§4.3): +0/+8/+16 hold
  // range_count/dsm_desc_iova/flags for TRIM (ignored by FLUSH), +24
  // holds status_out.  Must be 4-KiB aligned -- cap_handler_blkdev
  // masks op_arg's low 12 bits off to recover the page address.
  pub let mut _nrelw_desc_page : [u64; 4] = uninit @align(4096)

  // Caller-owned DSM range-descriptor page pointed to by the desc
  // page's dsm_desc_iova field (design §4.3).  In substrate mode its
  // content is irrelevant (ONCS/range/flags/iova checks and the
  // PICK_NONE refusal all happen before this page would ever be read
  // by real hardware); in wire mode it carries one real 16-byte NVMe
  // DSM range descriptor.
  pub let mut _nrelw_dsm_page : [u64; 512] = uninit @align(4096)

  // Synthetic 16-byte AER CQE scratch (NVMe CQE layout, drivers/nvme/
  // queue.pdx): DW0 @+0 (event fields), CID @+12.
  pub let mut _nrelw_aer_cqe : [u64; 2] = uninit @align(16)

  // ==========================================================================
  // nrelw_clear() -- scrub cap_table slots 128..140 inclusive.
  // ==========================================================================
  pub let nrelw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M4 boot witness: clear cap_table slots 128..140 (same range kind_nvme_io_queues_synth.pdx's own nqiow_clear scrubs). Labels prefixed nrelw_c_.",
      block: {
        push rbx;
        mov rbx, 128;
      nrelw_c_loop:
        cmp rbx, 141;
        jae nrelw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp nrelw_c_loop;
      nrelw_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nrelw_pci_synth(slot, bdf) -- synth a KIND_PCI_DEV parent with
  // RIGHT_MINT so nvme_ctrl_cap_mint_inner's parent gate accepts it.
  // ==========================================================================
  pub let nrelw_pci_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M4 boot witness: cap_mint_write(slot, KIND_PCI_DEV=0x30, R_DEV_ALL|RIGHT_MINT=0x21F, bdf). Same shape as kind_nvme_io_queues_synth.pdx's nqiow_pci_synth. Labels prefixed nrelw_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;
        mov rdx, 0x21F;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nrelw_hwint_synth(slot, dummy) -- synth a KIND_HW_INTERRUPT parent
  // with RIGHT_MINT so msix_cap_mint's parent gate accepts it
  // (wire-mode MSI-X alloc only).
  // ==========================================================================
  pub let nrelw_hwint_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (dummy: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M4 boot witness: cap_mint_write(slot, KIND_HW_INTERRUPT=0x140, R_HW_INT_ALL=0x618, dummy). Same shape as kind_nvme_io_queues_synth.pdx's nqiow_hwint_synth. Labels prefixed nrelw_hs_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x140;
        mov rdx, 0x618;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_nvme_reliability_witness() -> u64
  //
  // Five callee-save pushes (rbx/r12/r13/r14/r15) leave rsp%16 == 0
  // (entry rsp%16==8, 5*8=40, 48 % 16 == 0), matching every other NVMe
  // witness's top-level shape. r12 carries ns_row_id across stages;
  // ctrl_row_id is always 0 (a fresh table reset precedes the single
  // controller mint, and NVMEC_MAX-row allocation always takes the
  // lowest free row), so it is used as a bare immediate. r13/r14/r15
  // are reloaded per-stage scratch (r14 typically holds the descriptor-
  // page address across a stage's field-set + cap_invoke pair).
  // ==========================================================================
  pub let kind_nvme_reliability_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M4 boot witness: substrate-mode stages 1-19 always run (synthetic controller/namespace, FLUSH/TRIM rights-gate + ONCS-gate + DSM-argument-validation refusals via cap_handler_blkdev, GET_LOG_PAGE LID/admin-readiness decode, AER pool init/refill/drain-one). Wire-mode stages 20-27 run only when _nvme_device_count > 0 (real bring-up, real FLUSH/TRIM/SMART/error-info round trip). Five callee-save pushes leave rsp%16 == 0. Labels prefixed nrelw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -----------------------------------------------------------
        // (1) Reset all state; slot range 128..140.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        call nrelw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;

        // -----------------------------------------------------------
        // (2) Synth KIND_PCI_DEV parent at slot 128.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call nrelw_pci_synth;

        // -----------------------------------------------------------
        // (3) Mint synth KIND_NVME_CONTROLLER via M1 path.  Expect
        // row 0 (ONCS defaults to 0 -- table reset zeroes the whole
        // row).  Stamp slot 130 = KIND_NVME_CONTROLLER.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row_id == 0
        jne nrelw_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Mint synth KIND_NVME_NAMESPACE + dual-kind KIND_BLKDEV
        // via M2 path.  ns_slot=131, blk_slot=132, nsid=1, lba=4096,
        // blocks=100, parent_slot=130, parent_ctrl_row=0, blk_rights =
        // R_BLK_ALL_TAG (0x07, legacy -- the dual-kind mint gate does
        // not yet accept R_BLK_FLUSH/R_BLK_TRIM, see file header).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0

        mov rdi, 131;                    // ns_slot
        mov rsi, 132;                    // blk_slot
        mov rdx, 130;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights (R_NVMEN_ALL)
        mov r8,  0x07;                   // blk_rights (R_BLK_ALL_TAG, legacy)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nrelw_fail_stage;
        mov r12, rax;                    // r12 = ns_row_id (persists)

        // -----------------------------------------------------------
        // (5) Mint a second KIND_BLKDEV cap directly at slot 139 with
        // rights = R_BLK_ALL (0x1F, post-R51.M4-001-widening) so
        // FLUSH/TRIM's rights gate can be reached.  cap_mint_write
        // does not rights-validate (only the derivation/mint gate
        // does), so this bypasses the legacy dual-kind mint's 0x07
        // subset check without needing that gate patched.
        // -----------------------------------------------------------
        mov rdi, 139;
        mov rsi, 0x42;                   // KIND_BLKDEV
        mov rdx, 0x1F;                   // R_BLK_ALL (post-widening)
        mov rcx, r12;                    // target_ptr = ns_row_id
        call cap_mint_write;

        // -----------------------------------------------------------
        // (6) Rights-gate + ONCS[0]/ONCS[2]-clear refusals.  Slot 132
        // (rights 0x07) lacks R_BLK_FLUSH/R_BLK_TRIM -> INVOKE_DENIED
        // regardless of ONCS.  Slot 139 (rights 0x1F) passes the
        // rights gate and reaches the ONCS[0]/ONCS[2] check, which is
        // still clear (0x0000) at this point -> NVMEREL_FLUSH_UNSUP /
        // NVMEREL_TRIM_UNSUP.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 5;                      // BDEV_OP_FLUSH
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;      // INVOKE_DENIED
        cmp rax, r10;
        jne nrelw_fail_stage;

        mov rdi, 132;
        mov rsi, 6;                      // BDEV_OP_TRIM
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne nrelw_fail_stage;

        // Slot 139's FLUSH/TRIM calls below always OR a real
        // page-aligned _nrelw_desc_page address into op_arg (never a
        // bare op code): rights 0x1F passes cap_handler_blkdev's
        // rights gate, so the FLUSH/TRIM branch runs all the way to
        // its unconditional `status_out = ...` write at
        // desc_page_addr+24 -- a bare op code would decode to
        // desc_page_addr == 0 there, corrupting physical address 24.
        lea r14, [rip + _nrelw_desc_page];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov rdi, r14;
        mov r10, 5;                      // BDEV_OP_FLUSH
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC70;              // NVMEREL_FLUSH_UNSUP
        cmp rax, r10;
        jne nrelw_fail_stage;

        mov rdi, r14;
        mov r10, 6;                      // BDEV_OP_TRIM
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC71;              // NVMEREL_TRIM_UNSUP
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (7) Forge ONCS = 0x0005 (Compare | DSM).  Re-probe FLUSH/
        // TRIM via slot 139: gate now passes, both reach
        // NVMEIO_PICK_NONE (no SQ_LIVE pair minted in this file).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, 5;                       // ONCS = Compare(bit0) | DSM(bit2)
        call nvme_ctrl_row_oncs_set;

        lea r14, [rip + _nrelw_desc_page];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov rdi, r14;
        mov r10, 5;                      // BDEV_OP_FLUSH
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (8) TRIM with a well-formed descriptor (range_count=1,
        // dsm_desc_iova=&_nrelw_dsm_page, flags=0x1) -> NVMEIO_PICK_NONE.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        lea r14, [rip + _nrelw_desc_page];
        mov rax, 1;
        mov [r14 + 0], rax;              // range_count = 1
        lea rax, [rip + _nrelw_dsm_page];
        mov [r14 + 8], rax;              // dsm_desc_iova
        mov rax, 1;
        mov [r14 + 16], rax;             // flags = 0x1 (ad_bit)
        xor rax, rax;
        mov [r14 + 24], rax;             // status_out

        mov rdi, r14;
        mov r10, 6;                      // BDEV_OP_TRIM
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (9) TRIM range_count=0 -> NVMEREL_TRIM_BAD_RANGES.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rax, rax;
        mov [r14 + 0], rax;              // range_count = 0

        mov rdi, r14;
        mov r10, 6;
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC72;              // NVMEREL_TRIM_BAD_RANGES
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (10) TRIM flags=0x100 (reserved bits set) -> NVMEREL_TRIM_BAD_FLAGS.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rax, 1;
        mov [r14 + 0], rax;              // range_count = 1 (valid)
        mov rax, 0x100;
        mov [r14 + 16], rax;             // flags = 0x100 (bit 8 set)

        mov rdi, r14;
        mov r10, 6;
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC73;              // NVMEREL_TRIM_BAD_FLAGS
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (11) TRIM dsm_desc_iova=0x1001 (misaligned) -> NVMEREL_TRIM_BAD_IOVA.
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rax, 1;
        mov [r14 + 16], rax;             // flags = 0x1 (valid)
        mov rax, 0x1001;
        mov [r14 + 8], rax;              // dsm_desc_iova (misaligned)

        mov rdi, r14;
        mov r10, 6;
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 139;
        call cap_invoke;
        mov r10, 0xFFFFEC74;              // NVMEREL_TRIM_BAD_IOVA
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (12) GET_LOG_PAGE decode: bad LID, then SMART/error-info
        // fetch against an admin queue not yet brought up
        // (admin_ctx_pa still 0) -> BDEV_ERR_BAD_ROW.  Run BEFORE the
        // admin ctx is forged (next stage) so neither call ever
        // reaches nvme_admin_submit_poll's spin loop.
        // -----------------------------------------------------------
        mov rax, 12;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, 3;                      // lid (neither 0x01 nor 0x02)
        lea rdx, [rip + _nrelw_desc_page]; // dummy ptr, never dereferenced
        mov rcx, 1;                      // num_dwords
        call nvme_get_log_page;
        mov r10, 0xFFFFEC77;              // NVMEREL_LOG_BAD_LID
        cmp rax, r10;
        jne nrelw_fail_stage;

        xor rdi, rdi;                    // ctrl_row_id = 0
        call nvme_log_smart_fetch;
        mov r10, 0xFFFFEC62;              // BDEV_ERR_BAD_ROW (admin not ready)
        cmp rax, r10;
        jne nrelw_fail_stage;

        xor rdi, rdi;
        call nvme_log_error_info_fetch;
        mov r10, 0xFFFFEC62;
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (13) Forge an admin queue context: nvme_admin_queue_init
        // populates the canonical _nvme_admin_ctx slot (sq_pa/cq_pa =
        // the shared _nvme_admin_sq/_nvme_admin_cq .bss pages) against
        // the synthetic bar0; stamp it onto row 0 exactly as
        // nvme_ctrl_bring_up itself does (kind_nvme_controller.pdx
        // L1264-1270).
        // -----------------------------------------------------------
        mov rax, 13;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 0x100000;               // bar0 (synthetic, same as mint)
        lea rsi, [rip + _nvme_admin_ctx];
        call nvme_admin_queue_init;

        xor rdi, rdi;                    // ctrl_row_id = 0
        lea rsi, [rip + _nvme_admin_ctx];
        call nvme_ctrl_row_admin_ctx_set;

        // -----------------------------------------------------------
        // (14) nvme_aer_pool_init(0) -> expect all 4 slots SUBMITTED.
        // -----------------------------------------------------------
        mov rax, 14;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_aer_pool_init;
        cmp rax, 4;                      // NVME_AER_MAX
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (15) nvme_aer_refill_one(0) with the pool already full ->
        // NVMEREL_AER_POOL_FULL.
        // -----------------------------------------------------------
        mov rax, 15;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_aer_refill_one;
        mov r10, 0xFFFFEC76;              // NVMEREL_AER_POOL_FULL
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (16) Synthesize a matching AER CQE (CID = NVME_AER_CID_BASE
        // + slot 0 = 0x0100) and drain it -> expect 0 (slot freed,
        // then immediately refilled by nvme_aer_drain_one's own tail
        // call to nvme_aer_refill_one).
        // -----------------------------------------------------------
        mov rax, 16;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        lea r14, [rip + _nrelw_aer_cqe];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov rax, 0x00020101;             // DW0: log_page_id=2,event_info=1,event_type=1
        mov_d [r14 + 0], rax;
        mov rax, 0x0100;                 // CID (NVME_AER_CID_BASE + slot 0)
        mov_w [r14 + 12], rax;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, r14;                    // aer_cqe_addr
        call nvme_aer_drain_one;
        cmp rax, 0;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (17) Pool is full again (drain_one's internal refill) ->
        // nvme_aer_refill_one(0) -> NVMEREL_AER_POOL_FULL.
        // -----------------------------------------------------------
        mov rax, 17;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_aer_refill_one;
        mov r10, 0xFFFFEC76;
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (18) Synthesize a non-matching AER CQE (CID = 0x0200, no
        // SUBMITTED slot carries this CID) -> nvme_aer_drain_one ->
        // NVMEREL_AER_NO_ENDPOINT.
        // -----------------------------------------------------------
        mov rax, 18;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        lea r14, [rip + _nrelw_aer_cqe];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov rax, 0x00020101;
        mov_d [r14 + 0], rax;
        mov rax, 0x0200;                 // CID matching no SUBMITTED slot
        mov_w [r14 + 12], rax;

        xor rdi, rdi;
        mov rsi, r14;
        call nvme_aer_drain_one;
        mov r10, 0xFFFFEC75;              // NVMEREL_AER_NO_ENDPOINT
        cmp rax, r10;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (19) Stamp KIND_NVME_RELIABILITY OK.  Clean up substrate
        // state, then check for wire mode.
        // -----------------------------------------------------------
        mov rax, 19;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nrelw_ok];
        call klog_s1;

        call nrelw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;

        mov r10, [rip + _nvme_device_count];
        cmp r10, 0;
        je  nrelw_success;

        // =============================================================
        // WIRE MODE (stages 20..27).  Real NVMe device present.
        // =============================================================

        // -----------------------------------------------------------
        // (20) Real controller mint via M1 probe hook; bring up to
        // NEGOTIATED (ENABLE -> IDENTIFY -> SET_FEATURES).
        // -----------------------------------------------------------
        mov rax, 20;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call nrelw_pci_synth;

        mov rdi, 128;
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        call nvme_ctrl_probe_and_mint;
        cmp rax, 0;
        je  nrelw_fail_stage;

        xor rdi, rdi;
        call nvme_ctrl_bring_up;
        cmp rax, 0;
        jne nrelw_fail_stage;

        xor rdi, rdi;
        call nvme_ctrl_identify;
        cmp rax, 0;
        jne nrelw_fail_stage;

        xor rdi, rdi;
        mov rsi, 4;
        call nvme_ctrl_negotiate_queues;
        cmp rax, 0;
        jne nrelw_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;
        mov rdx, 0x61F;
        xor rcx, rcx;
        call cap_mint_write;

        // -----------------------------------------------------------
        // (21) M2 enumeration -> at least one namespace row.
        // -----------------------------------------------------------
        mov rax, 21;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 130;
        xor rsi, rsi;
        mov rdx, 0x41F;
        call nvme_ns_enumerate;
        cmp rax, 0;
        je  nrelw_fail_stage;
        xor r12, r12;                    // ns_row_id = 0 (first enumerated row)

        // -----------------------------------------------------------
        // (22) MSI-X batch alloc + nvme_io_bring_up_all -> at least
        // one pair reaches SQ_LIVE.
        // -----------------------------------------------------------
        mov rax, 22;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 129;
        xor rsi, rsi;
        call nrelw_hwint_synth;

        xor rdi, rdi;
        mov rsi, 129;
        mov rdx, 133;
        mov rcx, 4;
        call nvme_io_msix_alloc_for_ctrl;
        cmp rax, 0;
        jne nrelw_fail_stage;

        xor rdi, rdi;
        mov rsi, 4;
        call nvme_io_bring_up_all;
        cmp rax, 0;
        je  nrelw_fail_stage;

        // -----------------------------------------------------------
        // (23) Real BDEV_OP_FLUSH via cap_handler_blkdev directly
        // (rights = R_BLK_ALL = 0x1F) -> expect 0.
        // -----------------------------------------------------------
        mov rax, 23;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        lea r14, [rip + _nrelw_desc_page];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov rdi, 0x1F;                   // R_BLK_ALL
        mov rsi, r12;                    // ns_row_id
        mov rdx, r14;
        mov r10, 5;                      // BDEV_OP_FLUSH
        or  rdx, r10;
        call cap_handler_blkdev;
        cmp rax, 0;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (24) Real BDEV_OP_TRIM: one 128-block range at LBA 1024
        // (design §7.2 step 24) -> expect 0.
        // -----------------------------------------------------------
        mov rax, 24;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        lea r15, [rip + _nrelw_dsm_page];
        xor rax, rax;
        mov_d [r15 + 0], rax;            // Context Attributes = 0
        mov rax, 128;
        mov_d [r15 + 4], rax;            // Length in LBAs = 128
        mov rax, 1024;
        mov [r15 + 8], rax;              // Starting LBA = 1024

        mov rax, 1;
        mov [r14 + 0], rax;              // range_count = 1
        mov [r14 + 8], r15;              // dsm_desc_iova
        mov rax, 1;
        mov [r14 + 16], rax;             // flags = 0x1
        xor rax, rax;
        mov [r14 + 24], rax;

        mov rdi, 0x1F;
        mov rsi, r12;
        mov rdx, r14;
        mov r10, 6;                      // BDEV_OP_TRIM
        or  rdx, r10;
        call cap_handler_blkdev;
        cmp rax, 0;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (25) SMART fetch -> expect 0; critical_warning byte == 0 on
        // a fresh QEMU nvme drive (design §7.2 step 25).
        // -----------------------------------------------------------
        mov rax, 25;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_log_smart_fetch;
        cmp rax, 0;
        jne nrelw_fail_stage;

        lea r10, [rip + _nvme_log_smart_buf];
        xor rax, rax;
        mov_b rax, [r10 + 0];
        cmp rax, 0;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (26) Error-info fetch -> expect 0; error_count byte == 0
        // (design §7.2 step 26).
        // -----------------------------------------------------------
        mov rax, 26;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_log_error_info_fetch;
        cmp rax, 0;
        jne nrelw_fail_stage;

        lea r10, [rip + _nvme_log_error_buf];
        xor rax, rax;
        mov_b rax, [r10 + 0];
        cmp rax, 0;
        jne nrelw_fail_stage;

        // -----------------------------------------------------------
        // (27) Stamp WIRE OK. Teardown: revoke the controller cap
        // (cascades through the namespace + blkdev rows).
        // -----------------------------------------------------------
        mov rax, 27;
        lea rcx, [rip + _nrelw_stage];
        mov [rcx], rax;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nrelw_wire_ok];
        call klog_s1;

        xor rdi, rdi;
        call nvme_ctrl_cap_revoke;
        cmp rax, 0;
        jne nrelw_fail_stage;

      nrelw_success:
        call nrelw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        xor rax, rax;
        jmp nrelw_out;

      nrelw_fail_stage:
        lea rax, [rip + _nrelw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nrelw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nrelw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        mov rax, 1;

      nrelw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
