// tests/kernel/nvme/bdev_cross_family_soak_synth.pdx -- R51.M8-004 (#1678)
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// §2.M8 #1678 + §7.M8-004.
//
// Fingerprint: "BDEV SOAK OK 1000" (no round/milestone/issue tag, per
// design/policy/output-provenance-strip.md and this issue's own
// instruction: "no R prefix").
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// Design's loop body: "mount -> write 4 KiB -> flush -> unmount ->
// remount -> read back -> assert equality -> unmount -> sleep 1 ms",
// 1000 iterations, cross-family (NVMe + AHCI), meant to exercise the
// DMA/IOMMU domain's map/unmap discipline at rate.
//
// TWO PIECES OF THAT SHAPE DO NOT EXIST IN THIS TREE YET, and this
// witness does not paper over either gap (same discipline
// blkdev_cap_request_synth.pdx and kind_nvme_reliability_synth.pdx
// both already established for their own residual gaps):
//
//   (1) #1677 (R51.M8-003, "unmount + remount + WAL replay + snapshot
//       digest") -- this soak's own upstream dependency per the design
//       doc -- landed SUBSTRATE-STUB ONLY (commit fb6813e): a digest
//       comparator (cap/mount_replay_digest.pdx) and a witness
//       (tests/kernel/fs/mount_replay_digest_synth.pdx) that prove
//       comparator correctness + digest idempotency over reachable
//       substrate counters, explicitly NOT a real mount/write/unmount/
//       remount/replay round trip (gated on softarch R52.M5-003's
//       on-disk JBNL walker and R52.M5-005's mount backend, neither
//       landed; that witness's own fingerprint is deliberately tagged
//       STUB so it cannot be mistaken for the real
//       tests/r51/remount-replay.golden). There is therefore still no
//       real mount/unmount syscall pair, no on-disk snapshot digest,
//       and no WAL replay for THIS soak to round-trip through either.
//
//   (2) kind_dma_domain.pdx's own DMA_OP_MAP / DMA_OP_UNMAP are
//       explicitly commented "-> UNSUPPORTED (M5-003)" and DMA_OP_FLUSH
//       "-> UNSUPPORTED (M5-004)" (see that file's op table). There is
//       no live VT-d IOTLB invalidation-queue counter reachable from a
//       boot witness, and no bounce-pool page accounting exists yet
//       (design/hardware/nvme-ahci-tail-milestones.md's own "no IOTLB
//       descriptor drops (vtd_ctx.pdx counter unchanged)" and "no
//       orphan bounce-pool pages" success criteria describe primitives
//       this substrate does not expose today).
//
// Given both gaps, this witness reuses the SANCTIONED substrate mint
// pattern every other R51.M5/M6/M8 boot witness already relies on
// (kind_nvme_reliability_synth.pdx, kind_nvme_io_queues_synth.pdx,
// bdev_barrier_synth.pdx, blkdev_cap_request_synth.pdx) as the
// closest available analogue to "mount"/"unmount": a dual-kind
// KIND_NVME_NAMESPACE/KIND_BLKDEV mint+revoke cycle (nvme_ns_dual_kind_
// mint / nvme_ns_cap_revoke) stands in for NVMe mount/unmount, and a
// dual-kind KIND_AHCI_PORT/KIND_BLKDEV mint+revoke cycle
// (ahci_port_dual_kind_mint / ahci_port_cap_revoke) stands in for AHCI
// mount/unmount. Each of the 1000 iterations:
//
//   (a) mints a fresh NVMe dual-kind row against the SAME stable
//       KIND_NVME_CONTROLLER minted once before the loop ("mount");
//   (b) mints a fresh AHCI dual-kind row against the SAME stable
//       KIND_AHCI_CONTROLLER minted once before the loop ("mount");
//   (c) picks one of BDEV_OP_READ_LBA/WRITE_LBA/FLUSH/TRIM via a
//       deterministic xorshift64 PRNG (seeded once, NOT re-seeded per
//       run -- a boot-witness golden log must be reproducible, so
//       "random" here means "exercises all four op codes across the
//       1000-iteration run in a fixed, non-cyclic order" rather than
//       true entropy) and cap_invoke's it against BOTH families' fresh
//       KIND_BLKDEV cap ("random ops in substrate mode");
//   (d) revokes both rows ("unmount") IN SEQUENCE (NVMe first, then
//       AHCI), with a CROSS-FAMILY ISOLATION CHECK in between: right
//       after the NVMe revoke and BEFORE the AHCI revoke, the AHCI
//       blk_slot's cap_table descriptor must still read kind ==
//       KIND_BLKDEV (0x42) -- unrevoked, since its own "unmount" has
//       not happened yet. Checking here (rather than only after BOTH
//       revokes) is what makes a cross-family cascade collision
//       observable at all: a post-hoc check after both revokes would
//       see the same "now zero" end state whether the AHCI cap was
//       scrubbed by its OWN legitimate revoke or prematurely by the
//       NVMe revoke's cascade -- see the bug writeup below;
//   (e) asserts NO ORPHAN CAP: both families' KIND_BLKDEV cap_table
//       slots read back kind == 0 (KIND_NONE) after BOTH revokes -- a
//       lingering BLKDEV descriptor after unmount is exactly the
//       "stuck state" this soak is chartered to catch, and this is the
//       real substrate-mode proxy for design's "no orphan bounce-pool
//       pages" criterion (MOUNTW_SOAK_BOUNCE_LEAK, claimed below);
//   (f) asserts NO LEAK AT THE ROW-ALLOCATOR LEVEL: both
//       nvme_ns_tail_valid(row_id) and ahci_port_tail_valid(row_id)
//       read back 0 (freed) after revoke, AND (the strongest available
//       leak detector given a low-first-scan allocator) the NEXT
//       iteration's mint is asserted to return row_id == 0 again --
//       any leaked row would advance the free-list cursor forward and
//       either eventually ENOSPC (>= NVMEN_MAX/AHCIP_MAX == 32, so by
//       iteration 32 at the latest) or simply fail this exact
//       assertion far earlier than that.
//
// CROSS-FAMILY BUG FOUND AND FIXED BY THIS WITNESS (R51.M8-004,
// #1678): `nvme_ns_cascade_revoke_blkdev` (kind_nvme_namespace.pdx)
// matched KIND_BLKDEV cap_table entries by target_ptr[15:0] (row_id)
// ALONE, with no family-byte check -- unlike its AHCI-side twin,
// `ahci_port_cascade_revoke_blkdev` (kind_ahci_port.pdx), which always
// disambiguated by family. Since `_nvme_namespace_table` and
// `_ahci_port_table` are independent low-first-scan allocators, BOTH
// hand out row 0 first -- exactly what steps (a)/(b) above produce
// every iteration. Revoking the NVMe row in step (d) therefore also
// scrubbed the AHCI blk_slot's cap_table descriptor BEFORE the AHCI
// row was ever unmounted (an orphan-inducing cross-family cascade
// collision), which step (d)'s own cross-family isolation check would
// have caught as a spurious "already scrubbed, expected still-live"
// mismatch on the VERY FIRST iteration. Fixed at kind_nvme_namespace.pdx's
// `nvme_ns_cascade_revoke_blkdev` by adding the same family check the
// AHCI side already had (see that file's own header addendum and this
// function's inline comment). This is precisely the kind of
// "ordering violation" / cross-family defect design §7.M8-004
// charters this soak to find.
//
// Iteration count: 1000, per design (fixed at compile time -- not a
// runtime parameter, matching the design's own "Iteration count. 1000"
// bullet verbatim).
//
// Failure codes claimed (design §7.M8-004's own three-code taxonomy):
//   MOUNTW_SOAK_ITER_FAILED = 0xFFFFECF0 -- any per-iteration mint/
//     invoke/revoke return value diverging from its expected
//     substrate-mode sentinel, OR a mint returning a non-zero row_id
//     (the row-allocator leak detector described above).
//   MOUNTW_SOAK_IOTLB_DROP  = 0xFFFFECF1 -- RESERVED, NOT EXERCISED.
//     No live VT-d IOTLB invalidation-queue counter is reachable from
//     a boot witness today (see gap (2) above); claimed here so the
//     design's own numbering is on record, to be wired the day a real
//     DMA_OP_MAP/UNMAP cycle and its IOTLB counter land.
//   MOUNTW_SOAK_BOUNCE_LEAK = 0xFFFFECF2 -- an orphan KIND_BLKDEV cap
//     (step (e)) or a row that fails to report freed (step (f)) after
//     revoke. This substrate has no bounce-pool page accounting yet
//     (gap (2) above); this code's substrate-mode proxy is the cap/
//     row leak check just described.
//
// Cap slots 128..135 (fresh range, distinct from every other synth
// fixture's own 128..14x claim -- boot witnesses run sequentially,
// never concurrently, and each resets every table it touches, per the
// established convention blkdev_cap_request_synth.pdx's own header
// documents):
//   128 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   129 = KIND_NVME_CONTROLLER (minted once, stays live all 1000 iters)
//   130 = KIND_NVME_NAMESPACE (re-minted every iteration)
//   131 = KIND_BLKDEV, family NVME (re-minted every iteration)
//   132 = synthetic KIND_PCI_DEV parent for the AHCI controller
//   133 = KIND_AHCI_CONTROLLER (minted once, stays live all 1000 iters)
//   134 = KIND_AHCI_PORT (re-minted every iteration)
//   135 = KIND_BLKDEV, family AHCI (re-minted every iteration)
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `soak_`.

module BdevCrossFamilySoakSynth = structure {

  pub let mut _soak_stage : u64 = 0

  pub let soak_ok        : [u8; 19] = "BDEV SOAK OK 1000\n\0"
  pub let soak_iter_fail : [u8; 21] = "BDEV SOAK ITER FAIL\n\0"
  pub let soak_leak_fail : [u8; 21] = "BDEV SOAK LEAK FAIL\n\0"

  pub let soak_k_code : [u8; 5] = "code\0"
  pub let soak_k_iter : [u8; 5] = "iter\0"

  // Design §7.M8-004's own failure-code taxonomy (see module header
  // for which of the three are actually exercised by this witness).
  pub let MOUNTW_SOAK_ITER_FAILED : u64 = 0xFFFFECF0
  pub let MOUNTW_SOAK_IOTLB_DROP  : u64 = 0xFFFFECF1  // reserved, not exercised
  pub let MOUNTW_SOAK_BOUNCE_LEAK : u64 = 0xFFFFECF2

  // Deterministic xorshift64 PRNG state -- NOT real entropy (a boot
  // witness's golden log must be reproducible run to run). Seeded to
  // a fixed nonzero constant; xorshift64 never returns to 0 from a
  // nonzero seed, so no re-seed guard is needed for a 1000-iteration
  // run.
  pub let mut _soak_lcg_state : u64 = 0x2545F4914F6CDD1D

  // 32-byte BDEV_OP_* descriptor page (design §3.5's layout, shared by
  // READ_LBA/WRITE_LBA/FLUSH/TRIM): +0 lba/range_count, +8 nblocks/
  // dsm_desc_iova, +16 dma_iova/flags, +24 status_out. Must be 4-KiB
  // aligned -- cap_handler_blkdev masks op_arg's low 12 bits off to
  // recover the page address.
  pub let mut _soak_desc_page : [u64; 4] = uninit @align(4096)

  // Caller-owned DSM range-descriptor page for TRIM (design §4.3). In
  // substrate mode its content is irrelevant -- the ONCS/DRAT/range/
  // flags/iova checks and the "no live queue/port" refusal all happen
  // before this page would ever be read by real hardware, mirroring
  // kind_nvme_reliability_synth.pdx's own `_nrelw_dsm_page` precedent.
  pub let mut _soak_dsm_page : [u64; 512] = uninit @align(4096)

  // Scratch "data" page for READ_LBA/WRITE_LBA's dma_iova field.
  // Never actually touched by DMA in substrate mode (no live queue
  // pair is ever minted), same posture as kind_nvme_io_queues_synth.
  // pdx's `_nqiow_dma_buf`.
  pub let mut _soak_dma_buf : [u64; 512] = uninit @align(4096)

  // ==========================================================================
  // soak_clear() -- scrub cap_table slots 128..135 inclusive.
  // ==========================================================================
  pub let soak_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-004 (#1678): clear cap_table slots 128..135 (this witness's whole fixed slot claim). Same shape as every other synth fixture's own _clear helper (e.g. blkdev_cap_request_synth.pdx's bcrw_clear). Labels prefixed soak_cl_.",
      block: {
        push rbx;
        mov rbx, 128;
      soak_cl_loop:
        cmp rbx, 136;
        jae soak_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp soak_cl_loop;
      soak_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // soak_pci_synth(slot, bdf) -- synth a KIND_PCI_DEV parent with
  // RIGHT_MINT, matching every other synth fixture's own _pci_synth
  // helper (e.g. kind_nvme_reliability_synth.pdx's nrelw_pci_synth).
  // ==========================================================================
  pub let soak_pci_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-004 (#1678): cap_mint_write(slot, KIND_PCI_DEV=0x30, R_DEV_ALL|RIGHT_MINT=0x21F, bdf). Labels prefixed soak_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;
        mov rdx, 0x21F;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // soak_slot_kind(slot) -> u64 -- read cap_table[slot][+0] (kind
  // field). Out-of-range slot returns a sentinel that can never equal
  // a real kind tag. Mirrors blkdev_cap_request_synth.pdx's
  // bcrw_slot_kind.
  // ==========================================================================
  pub let soak_slot_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-004 (#1678): read cap_table[slot][+0]. Labels prefixed soak_sk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae soak_sk_bad;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      soak_sk_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  // ==========================================================================
  // soak_lcg_next() -> u64 -- xorshift64 step. Leaf function; touches
  // only rax/rcx/rdx (all caller-save), no nested calls, no stack
  // frame needed.
  // ==========================================================================
  pub let soak_lcg_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M8-004 (#1678): xorshift64 (x ^= x<<13; x ^= x>>7; x ^= x<<17). Deterministic, reproducible across every boot -- see module header on why true entropy is wrong for a golden-log witness. Leaf; no callee-save pushes needed (only rax/rcx/rdx touched). Labels prefixed soak_lcg_.",
      block: {
        lea rax, [rip + _soak_lcg_state];
        mov rdx, [rax];
        mov rcx, rdx;
        shl rcx, 13;
        xor rdx, rcx;
        mov rcx, rdx;
        shr rcx, 7;
        xor rdx, rcx;
        mov rcx, rdx;
        shl rcx, 17;
        xor rdx, rcx;
        mov [rax], rdx;
        mov rax, rdx;
        ret
      }
    }

  // ==========================================================================
  // bdev_cross_family_soak_witness() -> u64
  //
  // Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + sub rsp,8 leave
  // rsp%16 == 0 (entry rsp%16==8 -> 8+48=56 -> sub rsp,8 -> 64,
  // %16==0), matching every other R51.M8 witness's own top-level
  // shape. Persistent-across-the-whole-loop state: r12 = iteration
  // counter, r13 = this iteration's chosen op_code (3..6). r14/r15 =
  // this iteration's ns_row_id/port_row_id (set after each mint,
  // consumed by the matching revoke later in the SAME iteration).
  // rbx/rbp are free scratch within an iteration (rbx = op_idx before
  // op_code is derived; rbp = descriptor-page address).
  // ==========================================================================
  pub let bdev_cross_family_soak_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M8-004 (#1678): 1000-iteration cross-family (NVMe + AHCI) soak. See module header for the full scope note (substrate-mode mint/revoke cycle standing in for #1677's substrate-stub-only mount/unmount/remount/WAL-replay pair, and the cross-family cascade-revoke bug this witness found and fixed in kind_nvme_namespace.pdx). Six callee-save pushes leave rsp%16 == 0. Labels prefixed soak_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        // -----------------------------------------------------------
        // (1) Reset everything this witness touches.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _soak_stage];
        mov [rcx], rax;

        call soak_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;

        mov rax, 0x2545F4914F6CDD1D;
        lea rcx, [rip + _soak_lcg_state];
        mov [rcx], rax;

        // r12 (iteration counter) is initialized here, BEFORE the
        // one-time controller mints below -- if either of those mints
        // unexpectedly fails and jumps to soak_fail_iter, the logged
        // "iter" value is a clean 0 (not whatever garbage r12 held on
        // entry) rather than a misleading arbitrary number.
        xor r12, r12;

        // -----------------------------------------------------------
        // (2) Mint the stable NVMe controller (slot 129, row 0) and
        // forge ONCS = 0x0005 (Compare | DSM) so FLUSH/TRIM reach
        // their "no live SQ pair" substrate-mode outcome instead of
        // being refused at the ONCS gate before ever dispatching --
        // same forge kind_nvme_reliability_synth.pdx's stage 7 uses.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _soak_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call soak_pci_synth;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row 0
        jne soak_fail_iter;

        mov rdi, 129;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, 5;                      // ONCS = Compare(bit0) | DSM(bit2)
        call nvme_ctrl_row_oncs_set;

        // -----------------------------------------------------------
        // (3) Mint the stable AHCI controller (slot 133, row 0). Its
        // port rows are deliberately left at AHCIP_STATE_MINTED (no
        // IDENTIFY advance) for the whole run: this is the safe,
        // deterministic, no-MMIO-touch substrate-mode posture --
        // ahci_flush/ahci_trim/ahci_io_submit_rw all gate on
        // AHCIP_STATE_IDENTIFIED BEFORE touching any ABAR register, so
        // leaving state at MINTED yields AHCIIO_PORT_NOT_READY on
        // every op without ever reading a bogus abar_pa.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _soak_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 0xC0FFEE;
        call soak_pci_synth;

        mov rdi, 132;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x43F;                  // R_AHCIC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x200000;               // abar_pa (synthetic)
        call ahci_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row 0
        jne soak_fail_iter;

        mov rdi, 133;
        mov rsi, 0x19A;                  // KIND_AHCI_CONTROLLER
        mov rdx, 0x43F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) The 1000-iteration cross-family soak loop.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _soak_stage];
        mov [rcx], rax;

        // r12 already == 0 from the initialization above.

      soak_loop:
        mov r10, 1000;
        cmp r12, r10;
        jae soak_loop_done;

        // (a) mint fresh NVMe ns+blkdev dual-kind row ("mount").
        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0
        mov rdi, 130;                    // ns_slot
        mov rsi, 131;                    // blk_slot
        mov rdx, 129;                    // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                  // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                      // leak detector: must always be row 0
        jne soak_fail_iter;
        mov r14, rax;                    // r14 = ns_row_id (== 0)

        // (b) mint fresh AHCI port+blkdev dual-kind row ("mount").
        sub rsp, 32;
        xor rax, rax;
        mov [rsp + 0], rax;              // port_index = 0
        mov rax, 512;
        mov [rsp + 8], rax;              // sector_size
        mov rax, 100;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0
        mov rdi, 134;                    // port_slot
        mov rsi, 135;                    // blk_slot
        mov rdx, 133;                    // parent_slot (KIND_AHCI_CONTROLLER)
        mov rcx, 0x41F;                  // port_rights (R_AHCIP_ALL)
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                    // params_ptr
        call ahci_port_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                      // leak detector: must always be row 0
        jne soak_fail_iter;
        mov r15, rax;                    // r15 = port_row_id (== 0)

        // (c) pick this iteration's op (deterministic PRNG).
        // op_idx in {0,1,2,3} -> op_code in {3,4,5,6} (BDEV_OP_READ_
        // LBA..TRIM are contiguous, so op_code = op_idx + 3).
        call soak_lcg_next;
        and rax, 3;
        mov rbx, rax;                    // rbx = op_idx
        add rax, 3;
        mov r13, rax;                    // r13 = op_code

        // (d) build the descriptor page for this op.
        lea rbp, [rip + _soak_desc_page];
        cmp rbx, 3;                      // op_idx == 3 (TRIM)?
        je  soak_build_trim;

        xor rax, rax;
        mov [rbp + 0], rax;              // lba = 0 (READ/WRITE); ignored by FLUSH
        mov rax, 1;
        mov [rbp + 8], rax;              // nblocks = 1
        lea rax, [rip + _soak_dma_buf];
        mov [rbp + 16], rax;             // dma_iova
        xor rax, rax;
        mov [rbp + 24], rax;             // status_out
        jmp soak_build_done;

      soak_build_trim:
        mov rax, 1;
        mov [rbp + 0], rax;              // range_count = 1
        lea rax, [rip + _soak_dsm_page];
        mov [rbp + 8], rax;              // dsm_desc_iova
        mov rax, 1;
        mov [rbp + 16], rax;             // flags = 0x1 (ad_bit)
        xor rax, rax;
        mov [rbp + 24], rax;             // status_out

      soak_build_done:

        // (e) invoke against the NVMe blk cap: substrate mode always
        // yields NVMEIO_PICK_NONE (no live SQ pair minted; matches
        // kind_nvme_reliability_synth.pdx / kind_nvme_io_queues_synth.
        // pdx's own established substrate-mode pass criterion).
        mov rdi, rbp;
        or  rdi, r13;
        mov rsi, rdi;
        mov rdi, 131;
        call cap_invoke;
        mov r10, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        cmp rax, r10;
        jne soak_fail_iter;

        // (f) invoke against the AHCI blk cap: substrate mode always
        // yields AHCIIO_PORT_NOT_READY (port row left at
        // AHCIP_STATE_MINTED, never advanced to IDENTIFIED).
        mov rdi, rbp;
        or  rdi, r13;
        mov rsi, rdi;
        mov rdi, 135;
        call cap_invoke;
        mov r10, 0xFFFFECA6;              // AHCIIO_PORT_NOT_READY
        cmp rax, r10;
        jne soak_fail_iter;

        // (g) "unmount": revoke the NVMe row first.
        mov rdi, r14;
        call nvme_ns_cap_revoke;
        cmp rax, 0;
        jne soak_fail_iter;

        // (g.1) CROSS-FAMILY ISOLATION CHECK -- this is the check that
        // would have failed on iteration 1 before kind_nvme_namespace.
        // pdx's nvme_ns_cascade_revoke_blkdev fix: the AHCI blk_slot's
        // KIND_BLKDEV descriptor (family=2, still live -- its own
        // "unmount" has not happened yet) must be COMPLETELY UNTOUCHED
        // by the NVMe-only revoke just above. Checking it here, BEFORE
        // ahci_port_cap_revoke runs, is what makes the bug observable:
        // a post-hoc check after BOTH revokes would see slot 135 read
        // 0 either way (correctly scrubbed by its OWN revoke, or
        // incorrectly pre-scrubbed by the NVMe revoke's cascade
        // collision) and could not tell the two apart.
        mov rdi, 135;
        call soak_slot_kind;
        mov r10, 0x42;                   // KIND_BLKDEV_TAG
        cmp rax, r10;
        jne soak_fail_leak;

        // (g.2) now revoke the AHCI row ("unmount").
        mov rdi, r15;
        call ahci_port_cap_revoke;
        cmp rax, 0;
        jne soak_fail_iter;

        // (h) no-orphan-cap check: both blk_slot descriptors must now
        // read back KIND_NONE (0).
        mov rdi, 131;
        call soak_slot_kind;
        cmp rax, 0;
        jne soak_fail_leak;

        mov rdi, 135;
        call soak_slot_kind;
        cmp rax, 0;
        jne soak_fail_leak;

        // (i) no-stuck-row check: both rows must report freed.
        mov rdi, r14;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        jne soak_fail_leak;

        mov rdi, r15;
        call ahci_port_tail_valid;
        cmp rax, 0;
        jne soak_fail_leak;

        add r12, 1;
        jmp soak_loop;

      soak_loop_done:

        // -----------------------------------------------------------
        // (5) All 1000 iterations passed.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _soak_stage];
        mov [rcx], rax;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + soak_ok];
        call klog_s1;

        call soak_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        xor rax, rax;
        jmp soak_out;

      soak_fail_iter:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + soak_iter_fail];
        lea rcx, [rip + soak_k_code];
        mov r8, 0xFFFFECF0;               // MOUNTW_SOAK_ITER_FAILED
        lea r9, [rip + soak_k_iter];
        mov rax, r12;
        push rax;
        call klog_s1_x1_d1;
        add rsp, 8;
        jmp soak_cleanup_fail;

      soak_fail_leak:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + soak_leak_fail];
        lea rcx, [rip + soak_k_code];
        mov r8, 0xFFFFECF2;               // MOUNTW_SOAK_BOUNCE_LEAK
        lea r9, [rip + soak_k_iter];
        mov rax, r12;
        push rax;
        call klog_s1_x1_d1;
        add rsp, 8;

      soak_cleanup_fail:
        call soak_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        mov rax, 1;

      soak_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
