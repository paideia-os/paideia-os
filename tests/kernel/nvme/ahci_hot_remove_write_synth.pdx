// tests/kernel/nvme/ahci_hot_remove_write_synth.pdx -- R51.M8-005 (#1679)
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// §2.M8 #1679 + §7.M8-005 ("Hot-remove-under-write surfaces EIO").
//
// Fingerprint: "HOT REMOVE WRITE EIO OK" (no round/milestone/issue tag,
// per design/policy/output-provenance-strip.md and this issue's own
// instruction: "no R prefix").
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Design's test shape: a background writer issues bdev_write_sync in a
// loop while a controller thread hot-removes the underlying AHCI port
// at iteration 100, then asserts every in-flight op after the removal
// returns EIO -- never silent success, never a hang. This kernel has
// no threads/scheduler reachable from a boot witness, so -- matching
// EVERY R51.M8 witness's own established substrate-mode posture
// (mount_replay_digest_synth.pdx, bdev_cross_family_soak_synth.pdx) --
// "in-flight WRITE, then hot-remove mid-op" is modelled as two
// sequential cap_invoke/bdev_write_sync calls against the SAME
// KIND_BLKDEV cap, with the hot-remove revoke happening between them:
//
//   (1) mint a real KIND_AHCI_CONTROLLER + dual-kind KIND_AHCI_PORT/
//       KIND_BLKDEV row (the AHCI port is deliberately left at
//       AHCIP_STATE_MINTED, never advanced to IDENTIFIED -- the same
//       no-MMIO-touch posture bdev_cross_family_soak_synth.pdx already
//       established, since this synthetic abar_pa is not backed by a
//       real device);
//   (2) issue a WRITE_LBA through bdev_write_sync (R51.M8-005's own
//       addition to fs/pdxfs/bdev_write.pdx, see below) against the
//       live cap -- the "in-flight write". Substrate mode returns
//       AHCIIO_PORT_NOT_READY (port never IDENTIFIED) translated to
//       BDEVFS_INVOKE_FAILED; asserted exactly, so this step also
//       proves the harness is exercising the REAL cap_invoke path, not
//       vacuously passing;
//   (3) trigger the hot-remove: ahci_hp_absent_transition(port_row_id)
//       (drivers/ahci/hotplug.pdx, #1668, already landed) -- the exact
//       function a future ahci/irq.pdx PCS/PRCS dispatch would call for
//       an absent transition. It wraps ahci_port_cap_revoke (#1662),
//       which cascades: KIND_AHCI_PORT row torn down -> dual-kind
//       KIND_BLKDEV cap_table descriptor scrubbed (cap_mint_write(slot,
//       0, 0, 0)). No MMIO register is read or written by this call
//       (unlike ahci_hp_service_row, which would read PxIS/SSTS.DET
//       against the synthetic, not-backed-by-hardware abar_pa) -- the
//       same safety posture every other AHCI synth witness in this
//       tree already relies on;
//   (4) issue the SAME WRITE_LBA again, twice: once as a raw
//       cap_invoke (the most literal proof of design's own step 4,
//       "cap_invoke(bdev_slot, WRITE_LBA) returns INVOKE_STALE_HANDLE")
//       and once through bdev_write_sync (design's own step 5,
//       "bdev_write.pdx translates ... to BDEVFS_EIO"). Both are
//       asserted EXACTLY -- INVOKE_RESULT_INVALID_HANDLE and
//       BDEVFS_EIO respectively -- so a regression back to "returns 0"
//       (the bug this witness found, see below) fails loudly instead
//       of being masked by a loose `!= 0` check;
//   (5) assert no orphan cap (blk_slot's descriptor reads back
//       KIND_NONE) and no stuck row (ahci_port_tail_valid reports
//       freed) -- the substrate-mode proxy for design's "no bounce-pool
//       page leak" criterion, mirroring bdev_cross_family_soak_synth.
//       pdx's own established proxy for the same kind of unreachable-
//       today accounting (no bounce-pool page tracking exists in this
//       tree yet, same gap that witness's own header already
//       documents).
//
// =============================================================================
// REAL BUG FOUND AND FIXED BY THIS WITNESS (R51.M8-005, #1679)
// =============================================================================
//
// cap/invoke.pdx's cap_invoke_dispatch demuxes on the descriptor's
// kind field via a long `cmp rcx, <kind-tag>; je <handler>` chain; a
// kind with NO matching arm fell all the way through to the function's
// final default (`mov rax, rsi; ret`), where rsi holds target_ptr.
// KIND_NULL (0, cap/kind.pdx) -- the kind of a never-minted slot, AND
// the kind cap_mint_write(slot, 0, 0, 0) leaves behind after a revoke
// -- has no arm in that chain, so it fell through to the default too.
// Both kind and target_ptr are zeroed by the same scrub, so a
// cap_invoke on a JUST-REVOKED KIND_BLKDEV slot returned 0 -- exactly
// BDEV_ERR_OK, exactly what a successful WRITE_LBA already returns.
// That is the precise "silent success" failure mode design's own
// M8-005 assertion is chartered to catch ("no op returns success
// against a revoked cap"), and it was NOT synthetic: any cap_invoke on
// any revoked capability of ANY kind, not only KIND_BLKDEV, was
// affected. Fixed in cap/invoke.pdx: cap_invoke_dispatch now checks
// kind == KIND_NULL (0) immediately after the descriptor read, before
// rdi/rsi/rdx are clobbered for handler dispatch, and returns
// INVOKE_RESULT_INVALID_HANDLE (0xFFFFFFFFFFFFFFFE, the pre-existing
// sentinel this file's own bounds-check branch already used) instead
// of falling through. See that file's own updated justification.
//
// A second, smaller gap closed alongside it: #1673 (R51.M7-005) NAMED
// the BDEVFS_INVOKE_FAILED/BDEVFS_BAD_STATUS/BDEVFS_EIO failure codes
// and an "internal rewrite" of fs/pdxfs/bdev_write.pdx to call
// cap_invoke directly, but the commit that actually landed (4708409)
// did the file rename ONLY -- no cap_invoke call existed anywhere in
// that file before this issue. #1679's own charter requires calling
// the REAL cap_invoke path for a WRITE_LBA, so this issue lands
// bdev_write_sync (bdev_write.pdx's own new SECTION header has the
// full scope note: bdev_read_sync/bdev_flush and the durability.pdx/
// wal.pdx/cow_write.pdx caller migration #1673 also described remain
// open gaps, not silently dropped).
//
// =============================================================================
// DESIGN-DOC / CODEBASE INCONSISTENCY FLAGGED (NOT FIXED HERE)
// =============================================================================
//
// design/hardware/nvme-ahci-tail-milestones.md §7.M8-005 names
// `MOUNTW_HR_SILENT_SUCCESS = 0xFFFFECE5` and `MOUNTW_HR_LEAKED_BOUNCE
// = 0xFFFFECE6`. Both slots are ALREADY CLAIMED -- by
// cap/bdev_barrier.pdx's `MOUNTW_BARRIER_NOT_INIT` (0xFFFFECE5) and
// `MOUNTW_BARRIER_RING_FULL` (0xFFFFECE6), landed at R51.M8-002/#1676,
// whose own header comment states it read those two slots as "free"
// -- the design doc's M8-005 section (this issue) had apparently not
// been cross-checked against at that time, or was misread. Renaming
// bdev_barrier.pdx's already-landed constants is out of this issue's
// scope (unaudited call-site fan-out); this witness instead claims
// 0xFFFFECEA/0xFFFFECEB for the same two design-named semantics
// (genuinely free in the MOUNTW band -- see cap/bdev_barrier.pdx's own
// disjointness note, which lists 0xFFFFECE9 as its own last claimed
// slot) and flags the doc/code mismatch here for softarch/design
// reconciliation. A THIRD, purely-local diagnostic code
// (HRW_SETUP_FAILED, 0xFFFFECEC) is also claimed for this witness's
// own mint/revoke step-failure branch, which design's two-code M8-005
// taxonomy has no slot for; it is NOT a MOUNTW_ name and is not meant
// to be looked up as a design-claimed sentinel.
//
// Cap slots 168..171 (fresh range -- see kind_nvme_reliability_synth.
// pdx / bdev_cross_family_soak_synth.pdx / audio_route_synth.pdx for
// the neighbouring claims this range is disjoint from):
//   168 = synthetic KIND_PCI_DEV parent for the AHCI controller
//   169 = KIND_AHCI_CONTROLLER (row 0)
//   170 = KIND_AHCI_PORT (row 0, re-minted this run)
//   171 = KIND_BLKDEV, family AHCI (dual-kind with port row 0)
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `hrw_`.

module AhciHotRemoveWriteSynth = structure {

  pub let hrw_ok           : [u8; 25] = "HOT REMOVE WRITE EIO OK\n\0"
  pub let hrw_setup_fail   : [u8; 29] = "HOT REMOVE WRITE SETUP FAIL\n\0"
  pub let hrw_silent_fail  : [u8; 33] = "HOT REMOVE WRITE SILENT SUCCESS\n\0"
  pub let hrw_leak_fail    : [u8; 28] = "HOT REMOVE WRITE LEAK FAIL\n\0"

  pub let hrw_k_code : [u8; 5] = "code\0"

  // Design §7.M8-005's own two-code taxonomy, remapped to genuinely
  // free MOUNTW-band slots -- see the module header's "DESIGN-DOC /
  // CODEBASE INCONSISTENCY FLAGGED" section for why 0xFFFFECE5/E6
  // (the design doc's own literal values) could not be used here.
  pub let MOUNTW_HR_SILENT_SUCCESS : u64 = 0xFFFFECEA
  pub let MOUNTW_HR_LEAKED_BOUNCE  : u64 = 0xFFFFECEB

  // Witness-internal only -- NOT a design-named MOUNTW_ code. Covers
  // any mint/revoke/setup-step divergence this witness's own two named
  // codes above do not describe (mirrors bdev_cross_family_soak_synth.
  // pdx's own MOUNTW_SOAK_ITER_FAILED catch-all role, but design's
  // M8-005 taxonomy has no equivalent slot to reuse).
  pub let HRW_SETUP_FAILED : u64 = 0xFFFFECEC

  // {lba, nblocks, dma_iova, status_out} -- 4-KiB aligned (design
  // §3.5's op_arg packs the descriptor-page address into op_arg[63:12]).
  pub let mut _hrw_desc    : [u64; 4]   = uninit @align(4096)
  // Scratch "data" page for the WRITE_LBA's dma_iova field. Never
  // actually touched by DMA in substrate mode (the port never reaches
  // AHCIP_STATE_IDENTIFIED, so ahci_io_submit_rw refuses before any
  // PRDT is built), same posture as every other R51.M6/M8 synth
  // fixture's own scratch buffer.
  pub let mut _hrw_dma_buf : [u64; 512] = uninit @align(4096)

  // ==========================================================================
  // hrw_clear() -- scrub cap_table slots 168..171 inclusive.
  // ==========================================================================
  pub let hrw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-005 (#1679): clear cap_table slots 168..171 (this witness's whole fixed slot claim). Same shape as every other synth fixture's own _clear helper (e.g. bdev_cross_family_soak_synth.pdx's soak_clear). Labels prefixed hrw_cl_.",
      block: {
        push rbx;
        mov rbx, 168;
      hrw_cl_loop:
        cmp rbx, 172;
        jae hrw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp hrw_cl_loop;
      hrw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hrw_slot_kind(slot) -> u64 -- read cap_table[slot][+0] (kind
  // field). Out-of-range slot returns a sentinel that can never equal
  // a real kind tag. Mirrors bdev_cross_family_soak_synth.pdx's
  // soak_slot_kind.
  // ==========================================================================
  pub let hrw_slot_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-005 (#1679): read cap_table[slot][+0]. Labels prefixed hrw_sk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae hrw_sk_bad;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      hrw_sk_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  // ==========================================================================
  // ahci_hot_remove_write_witness() -> u64
  //
  // One callee-save push (r12 = port_row_id, held live from mint
  // through the post-revoke leak checks) leaves rsp%16 == 0 (entry
  // rsp%16==8 -> 8+8=16, %16==0) for every nested call this function
  // makes directly. See module header for the full step-by-step scope
  // note and the bug this witness found and fixed.
  // ==========================================================================
  pub let ahci_hot_remove_write_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M8-005 (#1679): in-flight-WRITE-under-hot-remove witness. One callee-save push (r12=port_row_id) leaves rsp%16==0. Body: (1) hrw_clear + ahci_ctrl_table_reset + ahci_port_table_reset (defensive, matches every AHCI-touching synth fixture's own entry posture). (2) mint a synthetic KIND_PCI_DEV parent (slot 168) then ahci_ctrl_cap_mint_inner(168, R_AHCIC_ALL=0x43F, ctrl_idx=0, abar_pa=0x200000) -- expect row 0 -- then stamp the KIND_AHCI_CONTROLLER descriptor (slot 169) via cap_mint_write. (3) ahci_port_dual_kind_mint(port_slot=170, blk_slot=171, parent_slot=169, port_rights=R_AHCIP_ALL=0x41F, blk_rights=R_BLK_ALL=0x1F, params_ptr={port_index=0, sector_size=512, block_count=100, parent_ctrl_row=0}) -- expect row 0, held in r12. (4) pre-revoke bdev_write_sync(171, lba=0, nblocks=1, dma_iova=&_hrw_dma_buf) -- port never IDENTIFIED, so cap_invoke's AHCIIO_PORT_NOT_READY (0xFFFFECA6) translates to BDEVFS_INVOKE_FAILED (0xFFFFECD0, staged via r10 per G4); asserted exactly. (5) ahci_hp_absent_transition(r12) -- the hot-remove trigger (drivers/ahci/hotplug.pdx, #1668); cascades ahci_port_cap_revoke -> scrubs the dual-kind KIND_BLKDEV cap (slot 171) to kind=0/rights=0/target_ptr=0; asserted to return 0 (not AHCIHP_REVOKE_ALREADY). (6) raw cap_invoke(171, desc|BDEV_OP_WRITE_LBA=4) -- design's own step-4 wording verbatim; asserted to equal INVOKE_RESULT_INVALID_HANDLE (0xFFFFFFFFFFFFFFFE, staged via r10) EXACTLY, not merely != 0, so a regression to the old target_ptr-echo fallthrough (which also happens to be 0, i.e. BDEV_ERR_OK) fails loudly instead of coincidentally matching a loose check. (7) bdev_write_sync(171, ...) again -- design's own step-5 wording; asserted to equal BDEVFS_EIO (0xFFFFECD2) exactly. (8) no-orphan-cap check: hrw_slot_kind(171) must read back 0 (KIND_NONE). (9) no-stuck-row check: ahci_port_tail_valid(r12) must read back 0 (freed). (10) all pass -> klog_s1(3, SUBSYS_BOOT, hrw_ok); cleanup; return 0. Any step-4 mint/revoke divergence -> hrw_fail_step (HRW_SETUP_FAILED, witness-internal only). Any step-6/7 divergence -> hrw_fail_silent (MOUNTW_HR_SILENT_SUCCESS). Any step-8/9 divergence -> hrw_fail_leak (MOUNTW_HR_LEAKED_BOUNCE). See module header's 'DESIGN-DOC / CODEBASE INCONSISTENCY FLAGGED' section for why these two MOUNTW codes are NOT design's own literal 0xFFFFECE5/E6 values. Labels prefixed hrw_.",
      block: {
        push r12;

        call hrw_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;

        // -----------------------------------------------------------
        // (2) Mint the AHCI controller (slot 169, row 0). Port left at
        // AHCIP_STATE_MINTED (no IDENTIFY advance) -- no-MMIO-touch
        // substrate-mode posture, matching bdev_cross_family_soak_
        // synth.pdx's own established precedent.
        // -----------------------------------------------------------
        mov rdi, 168;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xC0FFEE;                // synthetic bdf
        call cap_mint_write;

        mov rdi, 168;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x43F;                   // R_AHCIC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x200000;                // abar_pa (synthetic)
        call ahci_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne hrw_fail_step;

        mov rdi, 169;
        mov rsi, 0x19A;                   // KIND_AHCI_CONTROLLER
        mov rdx, 0x43F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) Mint the dual-kind AHCI port + KIND_BLKDEV row.
        // -----------------------------------------------------------
        sub rsp, 32;
        xor rax, rax;
        mov [rsp + 0], rax;               // port_index = 0
        mov rax, 512;
        mov [rsp + 8], rax;               // sector_size
        mov rax, 100;
        mov [rsp + 16], rax;              // block_count
        xor rax, rax;
        mov [rsp + 24], rax;              // parent_ctrl_row = 0
        mov rdi, 170;                     // port_slot
        mov rsi, 171;                     // blk_slot
        mov rdx, 169;                     // parent_slot (KIND_AHCI_CONTROLLER)
        mov rcx, 0x41F;                   // port_rights (R_AHCIP_ALL)
        mov r8,  0x1F;                    // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                     // params_ptr
        call ahci_port_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                       // expect row 0
        jne hrw_fail_step;
        mov r12, rax;                     // r12 = port_row_id (== 0)

        // -----------------------------------------------------------
        // (4) Pre-revoke "in-flight write" through bdev_write_sync.
        // -----------------------------------------------------------
        mov rdi, 171;
        xor rsi, rsi;                     // lba = 0
        mov rdx, 1;                       // nblocks = 1
        lea rcx, [rip + _hrw_dma_buf];    // dma_iova
        call bdev_write_sync;
        mov r10, 0xFFFFECD0;              // BDEVFS_INVOKE_FAILED
        cmp rax, r10;
        jne hrw_fail_step;

        // -----------------------------------------------------------
        // (5) Hot-remove: revoke the port row mid-"flight".
        // -----------------------------------------------------------
        mov rdi, r12;
        call ahci_hp_absent_transition;
        cmp rax, 0;
        jne hrw_fail_step;

        // -----------------------------------------------------------
        // (6) Post-revoke raw cap_invoke -- design's own step 4.
        // -----------------------------------------------------------
        lea r11, [rip + _hrw_desc];
        xor rax, rax;
        mov [r11 + 0], rax;               // lba = 0
        mov rax, 1;
        mov [r11 + 8], rax;               // nblocks = 1
        lea rax, [rip + _hrw_dma_buf];
        mov [r11 + 16], rax;              // dma_iova
        xor rax, rax;
        mov [r11 + 24], rax;              // status_out = 0

        mov rdi, 171;
        mov rsi, r11;
        mov r10, 4;                       // BDEV_OP_WRITE_LBA
        or  rsi, r10;
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFE;      // INVOKE_RESULT_INVALID_HANDLE
        cmp rax, r10;
        jne hrw_fail_silent;

        // -----------------------------------------------------------
        // (7) Post-revoke bdev_write_sync -- design's own step 5.
        // -----------------------------------------------------------
        mov rdi, 171;
        xor rsi, rsi;
        mov rdx, 1;
        lea rcx, [rip + _hrw_dma_buf];
        call bdev_write_sync;
        mov r10, 0xFFFFECD2;              // BDEVFS_EIO
        cmp rax, r10;
        jne hrw_fail_silent;

        // -----------------------------------------------------------
        // (8)+(9) no-orphan-cap / no-stuck-row checks.
        // -----------------------------------------------------------
        mov rdi, 171;
        call hrw_slot_kind;
        cmp rax, 0;
        jne hrw_fail_leak;

        mov rdi, r12;
        call ahci_port_tail_valid;
        cmp rax, 0;
        jne hrw_fail_leak;

        // -----------------------------------------------------------
        // (10) All checks passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hrw_ok];
        call klog_s1;

        call hrw_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        xor rax, rax;
        jmp hrw_out;

      hrw_fail_step:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hrw_setup_fail];
        lea rcx, [rip + hrw_k_code];
        mov r8, 0xFFFFECEC;               // HRW_SETUP_FAILED (local only)
        call klog_s1_x1;
        jmp hrw_cleanup_fail;

      hrw_fail_silent:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hrw_silent_fail];
        lea rcx, [rip + hrw_k_code];
        mov r8, 0xFFFFECEA;               // MOUNTW_HR_SILENT_SUCCESS
        call klog_s1_x1;
        jmp hrw_cleanup_fail;

      hrw_fail_leak:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + hrw_leak_fail];
        lea rcx, [rip + hrw_k_code];
        mov r8, 0xFFFFECEB;               // MOUNTW_HR_LEAKED_BOUNCE
        call klog_s1_x1;

      hrw_cleanup_fail:
        call hrw_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        mov rax, 1;

      hrw_out:
        pop r12;
        ret
      }
    }
}
