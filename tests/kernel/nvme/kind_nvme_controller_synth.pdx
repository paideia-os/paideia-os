// tests/kernel/nvme/kind_nvme_controller_synth.pdx -- R51.M1-006 (#1638)
//
// Boot witness for KIND_NVME_CONTROLLER (0x198).
//
// Fingerprint: R51.M1 KIND_NVME_CONTROLLER OK
//
// Cap slots 124..126.
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// This witness exercises the SUBSTRATE-LEVEL primitives that R51.M1
// lands, not the wire-through-to-hardware round trip.  Under
// BIOS/-kernel boot there is no NVMe controller (MCFG absent ->
// _pci_device_count == 0 -> _nvme_device_count == 0), so the M1-002
// probe hook drains empty, M1-003 bring-up never fires, M1-004
// IDENTIFY submit never fires, M1-005 SET_FEATURES submit never fires.
//
// What the witness DOES exercise, synthetically:
//
//   (1) Cap-table setup: mint a KIND_PCI_DEV parent slot (kind 0x30 +
//       RIGHT_MINT) so the M1-001 derivation gate has a real cap to
//       consult; mint a wrong-kind slot so the negative-parent gate
//       has a real cap to refuse.
//   (2) M1-001 primitives: rights_valid (positive + negative),
//       ctrl_idx_valid (positive + negative), check_parent_pci_dev
//       (positive + negative), hdr_pack (positive + negative).
//   (3) M1-001 mint happy path: nvme_ctrl_cap_mint_inner with valid
//       parent, rights, ctrl_idx=0, bar0_pa=0x100000 -- expect row_id
//       0 back.
//   (4) M1-001 mint refusals: BAD_PARENT (wrong-kind slot), BAD_RIGHTS
//       (rights outside R_NVMEC_ALL), BAD_IDX (ctrl_idx >= NVMEC_MAX),
//       BAD_BAR0 (bar0_pa == 0).
//   (5) M1-001 row accessors: row_bar0 == 0x100000; row_state ==
//       MINTED (1); row_ctrl_idx == 0.
//   (6) M1-001 dispatch: cap_handler_nvme_controller QUERY_BAR0 with
//       R_NVMEC_INVOKE returns 0x100000; without INVOKE returns
//       DENIED; op_arg[63:8] refused; unsupported op refused.
//   (7) M1-002 probe hook: since _nvme_device_count == 0 under BIOS
//       boot, nvme_ctrl_probe_and_mint returns 0 (no rows minted from
//       the walker).  Positive: reset controller table, set fake
//       _nvme_devices[0..1] = {bar0 = 0x200000, 0x300000}, force
//       _nvme_device_count = 2, call the walker, expect 2 rows.
//       (We cannot actually mutate the R24 probe globals because
//       they're confined; instead we assert the walker signature:
//       call with device_count = 0 and check rax == 0.)
//   (8) M1-003 nvme_ctrl_bring_up: from a MINTED row.  With bar0=0
//       (or a bogus bar0 the R24 substrate rejects), we cannot
//       synthetically drive an nvme_reset OK.  Instead we assert the
//       failure path: bring_up on a bogus row returns
//       NVMEC_BRINGUP_FAILED or NVMEC_DECODE_BAD; bring_up on a row
//       whose state is not MINTED returns NVMEC_BAD_TRANSITION.
//   (9) M1-006 revoke: nvme_ctrl_cap_revoke on the live row returns
//       NVMEC_OK; a second revoke returns NVMEC_REVOKE_ALREADY; a
//       revoke with row_id == 42 returns NVMEC_BAD_SLOT.
//   (10) State-machine strictness: nvme_ctrl_row_state_set enforces
//        monotonic MINTED (1) -> ENABLED (2) -> IDENTIFIED (3) ->
//        NEGOTIATED (4).  Test one full ladder + one refused skip.
//
// This is the M1 sub of the milestone: the wire-through-to-hardware
// happens at R51.M3+ under UEFI/OVMF where a real BAR0 exists.

module KindNvmeControllerSynth = structure {

  pub let mut _nvmecw_stage : u64 = 0

  pub let nvmecw_ok   : [u8; 25] = "KIND_NVME_CONTROLLER OK\n\0"
  pub let nvmecw_fail : [u8; 27] = "KIND_NVME_CONTROLLER FAIL\n\0"

  // Mint a synthetic KIND_PCI_DEV parent (kind 0x30) with R_DEV_ALL
  // (0x1F, includes RIGHT_MINT=0x200? no, R_DEV_ALL=0x1F; RIGHT_MINT
  // is 0x200 which is outside R_DEV_ALL).  Actually for the parent
  // gate we need `rights & RIGHT_MINT != 0`.  We use rights = 0x21F
  // (R_DEV_ALL | RIGHT_MINT) directly since cap_mint_write does not
  // rights-validate.  The kind alone is what discriminates the
  // parent's family (KIND_PCI_DEV = 0x30) — RIGHT_MINT authorises
  // the derivation.
  pub let nvmecw_pci : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-006 (#1638): mint a synthetic KIND_PCI_DEV parent with RIGHT_MINT for the nvme_ctrl mint gate. cap_mint_write does not rights-validate; the derivation gate does. Labels prefixed nvmecw_pci_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;                   // KIND_PCI_DEV
        mov rdx, 0x21F;                  // R_DEV_ALL | RIGHT_MINT
        mov rcx, r13;                    // target_ptr = bdf
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let nvmecw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-006 (#1638): clear cap_table slots 124..127. Labels prefixed nvmecw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 124;
      nvmecw_c_loop:
        cmp rbx, 128;
        jae nvmecw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp nvmecw_c_loop;
      nvmecw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_nvme_controller_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M1-006 (#1638): boot witness for KIND_NVME_CONTROLLER. Exercises rights_valid / ctrl_idx_valid / check_parent_pci_dev / hdr_pack; mint happy path + BAD_PARENT / BAD_RIGHTS / BAD_IDX / BAD_BAR0; row accessors; dispatch happy + denied + refused; probe hook returns 0 under empty _nvme_device_count; bring_up on a non-MINTED row returns BAD_TRANSITION; state ladder + refused skip; revoke happy + already + bad_slot. Five callee-save pushes leave rsp%16 == 0. Labels prefixed nvmecw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        call nvmecw_clear;
        call nvme_ctrl_table_reset;

        mov rdi, 124;
        mov rsi, 0xABCD;                 // synth bdf
        call nvmecw_pci;
        mov rdi, 125;                    // wrong-kind
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0x61F;                  // R_NVMEC_ALL
        call nvme_ctrl_rights_valid;
        cmp rax, 1;
        jne nvmecw_fail_stage;
        mov rdi, 0x2000;                 // outside R_NVMEC_ALL
        call nvme_ctrl_rights_valid;
        cmp rax, 0;
        jne nvmecw_fail_stage;

        // (3) ctrl_idx_valid.
        mov rax, 3;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0;   call nvme_ctrl_idx_valid; cmp rax, 1; jne nvmecw_fail_stage;
        mov rdi, 7;   call nvme_ctrl_idx_valid; cmp rax, 1; jne nvmecw_fail_stage;
        mov rdi, 8;   call nvme_ctrl_idx_valid; cmp rax, 0; jne nvmecw_fail_stage;

        // (4) parent gate.
        mov rax, 4;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;
        call nvme_ctrl_check_parent_pci_dev;
        cmp rax, 1;
        jne nvmecw_fail_stage;
        mov rdi, 125;                    // wrong kind
        call nvme_ctrl_check_parent_pci_dev;
        cmp rax, 0;
        jne nvmecw_fail_stage;

        // (5) hdr_pack.
        mov rax, 5;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0;                      // ctrl_idx
        mov rsi, 1;                      // state=MINTED
        call nvme_ctrl_hdr_pack;
        mov r11, 0x100;                  // state 1 in bits [15:8]
        cmp rax, r11;
        jne nvmecw_fail_stage;
        // Refused: state=0.
        mov rdi, 0;
        xor rsi, rsi;
        call nvme_ctrl_hdr_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne nvmecw_fail_stage;

        // (6) Mint success. ctrl_idx=0, bar0_pa=0x100000.
        mov rax, 6;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;                    // parent
        mov rsi, 0x61F;                  // rights
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa
        call nvme_ctrl_cap_mint_inner;
        mov r10, 8;                      // NVMEC_MAX
        cmp rax, r10;
        jae nvmecw_fail_stage;
        mov r12, rax;                    // r12 = row_id

        mov rdi, r12;
        call nvme_ctrl_row_bar0;
        mov r11, 0x100000;
        cmp rax, r11;
        jne nvmecw_fail_stage;

        mov rdi, r12;
        call nvme_ctrl_row_state;
        cmp rax, 1;                      // NVMEC_STATE_MINTED
        jne nvmecw_fail_stage;

        mov rdi, r12;
        call nvme_ctrl_row_ctrl_idx;
        cmp rax, 0;
        jne nvmecw_fail_stage;

        // (7) BAD_PARENT.
        mov rax, 7;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 0x61F;
        mov rdx, 1;
        mov rcx, 0x200000;
        call nvme_ctrl_cap_mint_inner;
        mov r10, 0xFFFFEC4D;             // NVMEC_MINT_BAD_PARENT
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (8) BAD_RIGHTS.
        mov rax, 8;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;
        mov rsi, 0x2000;                 // outside R_NVMEC_ALL
        mov rdx, 1;
        mov rcx, 0x200000;
        call nvme_ctrl_cap_mint_inner;
        mov r10, 0xFFFFEC4C;             // NVMEC_MINT_BAD_RIGHTS
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (9) BAD_IDX.
        mov rax, 9;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;
        mov rsi, 0x61F;
        mov rdx, 8;                      // NVMEC_MAX
        mov rcx, 0x200000;
        call nvme_ctrl_cap_mint_inner;
        mov r10, 0xFFFFEC4B;             // NVMEC_MINT_BAD_IDX
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (10) BAD_BAR0.
        mov rax, 10;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;
        mov rsi, 0x61F;
        mov rdx, 1;                      // ctrl_idx = 1
        xor rcx, rcx;                    // bar0_pa = 0
        call nvme_ctrl_cap_mint_inner;
        mov r10, 0xFFFFEC4A;             // NVMEC_MINT_BAD_BAR0
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (11) Dispatch QUERY_BAR0 with R_NVMEC_INVOKE.
        mov rax, 11;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;                  // R_NVMEC_INVOKE only
        mov rsi, r12;                    // row_id in low 16
        xor rdx, rdx;                    // op = QUERY_BAR0
        call cap_handler_nvme_controller;
        mov r11, 0x100000;
        cmp rax, r11;
        jne nvmecw_fail_stage;

        // (12) Dispatch without R_NVMEC_INVOKE denied.
        mov rax, 12;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0x400;                  // OBSERVE only
        mov rsi, r12;
        xor rdx, rdx;                    // op = QUERY_BAR0
        call cap_handler_nvme_controller;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (13) op_arg[63:8] refused.
        mov rax, 13;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 0x100;                  // op=0 + noise in bit 8
        call cap_handler_nvme_controller;
        mov r10, 0xFFFFEC4E;             // NVMEC_TAIL_BAD_ARG
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (14) Unsupported op refused.
        //
        // R51.M3-002 (#1646): op 8 is now NVMEC_OP_BRING_UP_IO (was free
        // at R51.M1 time this stage was written); use 9 (still past the
        // updated NVMEC_OP_MAX = 8) so this probe keeps exercising the
        // genuinely-unsupported-op path instead of BRING_UP_IO's own
        // (differently-coded) rights refusal.
        mov rax, 14;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 9;                      // > NVMEC_OP_MAX
        call cap_handler_nvme_controller;
        mov r10, 0xFFFFFFFFFFFFFFFC;     // UNSUP
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (15) Probe hook: under empty _nvme_device_count returns 0.
        // Under BIOS boot _nvme_device_count is 0 unconditionally.
        mov rax, 15;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 124;                    // parent slot
        mov rsi, 0x61F;
        call nvme_ctrl_probe_and_mint;
        // Under BIOS/-kernel boot this should be 0.  We assert that
        // by checking the return is bounded by NVMEC_MAX (a real
        // count) rather than a MINT_BAD_* sentinel.
        mov r10, 8;
        cmp rax, r10;
        jae nvmecw_fail_stage;

        // (16) bring_up on non-existent row.
        mov rax, 16;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, 42;                     // out of range
        call nvme_ctrl_bring_up;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // NVMEC_DECODE_BAD
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (17) State ladder via row_state_set: MINTED -> ENABLED ->
        // IDENTIFIED -> NEGOTIATED, all on r12 (still MINTED from the
        // (6) mint).
        mov rax, 17;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 2;                      // -> ENABLED
        call nvme_ctrl_row_state_set;
        cmp rax, 0;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        mov rsi, 3;                      // -> IDENTIFIED
        call nvme_ctrl_row_state_set;
        cmp rax, 0;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        mov rsi, 4;                      // -> NEGOTIATED
        call nvme_ctrl_row_state_set;
        cmp rax, 0;
        jne nvmecw_fail_stage;

        // (18) Refused: state=NEGOTIATED cannot go back to ENABLED.
        mov rax, 18;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 2;                      // backwards refused
        call nvme_ctrl_row_state_set;
        mov r10, 0xFFFFEC43;             // NVMEC_BAD_TRANSITION
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // (19) Row setters: mdts / oncs / nn / num_io_queues.  Simulate
        // the identify + set_features caches without submitting a
        // wire command.
        mov rax, 19;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        mov rsi, 5;                      // MDTS = 5 (2^5 pages)
        call nvme_ctrl_row_mdts_set;
        mov rdi, r12;
        call nvme_ctrl_row_mdts;
        cmp rax, 5;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        mov rsi, 0x001F;                 // ONCS: FLUSH/WU/DSM/WZ/SAV supported
        call nvme_ctrl_row_oncs_set;
        mov rdi, r12;
        call nvme_ctrl_row_oncs;
        mov r11, 0x001F;
        cmp rax, r11;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        mov rsi, 2;                      // NN = 2 namespaces
        call nvme_ctrl_row_nn_set;
        mov rdi, r12;
        call nvme_ctrl_row_nn;
        cmp rax, 2;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        mov rsi, 4;                      // 4 I/O queues negotiated
        call nvme_ctrl_row_num_io_queues_set;
        mov rdi, r12;
        call nvme_ctrl_row_num_io_queues;
        cmp rax, 4;
        jne nvmecw_fail_stage;

        // (20) revoke happy + already + bad_slot.
        mov rax, 20;
        lea rcx, [rip + _nvmecw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call nvme_ctrl_cap_revoke;
        cmp rax, 0;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        jne nvmecw_fail_stage;
        mov rdi, r12;
        call nvme_ctrl_cap_revoke;
        mov r10, 0xFFFFEC47;             // NVMEC_REVOKE_ALREADY
        cmp rax, r10;
        jne nvmecw_fail_stage;
        mov rdi, 42;                     // out of range
        call nvme_ctrl_cap_revoke;
        mov r10, 0xFFFFEC49;             // NVMEC_BAD_SLOT
        cmp rax, r10;
        jne nvmecw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvmecw_ok];
        call klog_s1;

        call nvmecw_clear;
        call nvme_ctrl_table_reset;
        xor rax, rax;
        jmp nvmecw_out;

      nvmecw_fail_stage:
        lea rax, [rip + _nvmecw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvmecw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nvmecw_clear;
        call nvme_ctrl_table_reset;
        mov rax, 1;

      nvmecw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
