// tests/kernel/nvme/kind_nvme_io_queues_synth.pdx -- R51.M3-006 (#1650)
//
// Boot witness for the NVMe I/O queue substrate: nvme_io_queues.pdx
// (#1645/#1646/#1647/#1649) and the KIND_BLKDEV BDEV_OP_* dispatcher
// cap_handler_blkdev.pdx (#1647/#1648).
//
// Fingerprint: KIND_NVME_IO OK   (no round/milestone/issue tag, per
// design/policy/output-provenance-strip.md).  Fail fingerprint:
// KIND_NVME_IO FAIL.
//
// Design authority: design/hardware/nvme-io-queues.md §6.
//
// Cap slots 128..140 reserved:
//   128 = synth KIND_PCI_DEV parent (controller mint gate)
//   129 = synth KIND_HW_INTERRUPT parent (MSI-X mint gate)
//   130 = KIND_NVME_CONTROLLER (M1 path; row 0; bar0 = 0x100000 synth)
//   131 = KIND_NVME_NAMESPACE (M2 dual-kind mint child)
//   132 = KIND_BLKDEV (M2 dual-kind mint child; R_BLK_ALL)
//   133..136 = KIND_HW_MSIX_VECTOR (one per cpu_idx 0..3)
//   137 = KIND_BLKDEV synth, rights = R_BLK_WRITE only (rights-gate probe)
//   138 = KIND_BLKDEV synth, rights = R_BLK_READ only (rights-gate probe)
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// Two witness modes, matching design §6.1:
//
//   SUBSTRATE MODE (always runs on smoke, stages 1..15).  Under BIOS/
//   -kernel boot no NVMe controller exists (MCFG absent ->
//   _pci_device_count == 0 -> _nvme_device_count == 0), so this witness
//   synthesizes a KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
//   KIND_BLKDEV row pair via the M1/M2 primitives, then drives the
//   M3 substrate against it: MSI-X batch alloc/revoke, the pair-table
//   row shape, nvme_io_create_pair's synthetic-bar0 refusal,
//   nvme_io_pick_pair's PICK_NONE fallback, and cap_handler_blkdev's
//   op-decode surface (QUERY_FAMILY/QUERY_GEOM/FLUSH/TRIM, unknown-op
//   refusal, reserved-bit refusal, and the R_BLK_READ / R_BLK_WRITE
//   rights gates on READ_LBA / WRITE_LBA).  Only return-code SHAPE is
//   asserted here, never hardware liveness (bar0 = 0x100000 is not a
//   real BAR).
//
//   WIRE MODE (guarded by `_nvme_device_count > 0`, stages 16..25).
//   Skips silently under BIOS/-kernel boot.  Under `tools/run-smoke.sh
//   --nvme` (a real QEMU `-device nvme` attached), this section drives
//   an ACTUAL round trip: M1 bring-up to NEGOTIATED, M2 namespace
//   enumeration, MSI-X alloc + nvme_io_bring_up_all, a 4-KiB READ of
//   LBA 0, a deliberate out-of-range LBA refusal, a WRITE to LBA 1,
//   and a READ-back of LBA 1 verifying the written 0xA5 pattern
//   round-trips.  Teardown revokes the controller cap (cascades
//   through the namespace + blkdev rows).
//
// Design-doc gaps resolved in this commit:
//   - §6 speces the OK/FAIL fingerprint arrays at a fixed 25 / 27
//     bytes (matching the M1 KIND_NVME_CONTROLLER witness's byte
//     count, which happens to have a 20-character component name).
//     "KIND_NVME_IO" is shorter, so hitting 25/27 exactly would need
//     nine consecutive `\0` escapes in the string literal -- the
//     M1/M2 witnesses only ever use one or two consecutive `\0`s, so
//     nine in a row is unproven territory for this encoder's string-
//     literal lexer (risk of octal-style multi-digit escape
//     misparsing). klog_s1/klog_s1_d1 take a bare pointer with no
//     length argument (confirmed against klog/wrappers.pdx), so the
//     trailing-NUL byte count has no functional effect on what gets
//     printed. This file uses the minimal-and-proven one-`\0`
//     terminator shape instead (array size = string length + 1),
//     matching the M1 KIND_NVME_CONTROLLER witness's pattern exactly
//     rather than its incidental byte count.
//   - design §6.1 lists 15 substrate stages and 10 wire stages by
//     number; this file keeps that same 25-stage numbering but groups
//     several related assertions under one `_nvmeiow_stage` value each
//     (mirroring the M1/M2 witnesses' own precedent of bundling
//     multiple asserts per stage) so the richer op-decode coverage
//     (unknown-op refusal, reserved-bit refusal, R_BLK_READ/
//     R_BLK_WRITE rights gates) fits inside stages 10/13 without
//     inventing new stage numbers.
//   - the design's literal "bad-lba refuse" op-decode case cannot be
//     reached in substrate mode: cap_handler_blkdev forwards straight
//     into nvme_io_submit_rw, whose block-count bound check runs only
//     AFTER nvme_io_pick_pair succeeds, and substrate mode never
//     reaches NVME_IOP_STATE_SQ_LIVE (the synthetic bar0 makes
//     nvme_io_create_pair fail by design). This file instead exercises
//     the out-of-range-LBA path for real once a live pair exists, as
//     part of wire-mode stage 21 (folded into the design's step
//     "submit BDEV_OP_READ_LBA(lba=0, nblocks=1)" as a probe run
//     immediately before it).
//   - §6.2 step 13 calls the READ_LBA op through "cap_invoke(slot=132,
//     ...)"; this file also stamps two extra synthetic KIND_BLKDEV
//     descriptors (slots 137/138, single-bit rights) purely to
//     exercise the R_BLK_READ / R_BLK_WRITE denial paths that a
//     R_BLK_ALL-rights slot (132) cannot reach.
//   - §6.3's "allocate a 4-KiB DMA buffer via dma_domain_map" is
//     simplified to a static, page-aligned .bss buffer (identical
//     posture to every other boot-time NVMe scratch buffer in this
//     tree, e.g. drivers/nvme/identify_ns.pdx's out_buf_pa): R51.M3's
//     nvme_io_submit_rw explicitly does not walk the DMA domain itself
//     (design §3.3: "this function does NOT walk the DMA domain"), so
//     a real dma_domain_map round trip is orthogonal to what this
//     witness substantiates. Flagged here for R51.M4+ triage if a real
//     KIND_DMA_DOMAIN-backed IOVA is later required end-to-end.
//   - wire-mode stages 16..25 call cap_handler_blkdev directly (not
//     through cap_invoke on a minted slot): nvme_ns_enumerate mints
//     _nvme_namespace_table rows without stamping a KIND_BLKDEV cap
//     descriptor for them, and dual-kind-minting a SECOND row over the
//     enumerated one would test the wrong row. Calling the (pub)
//     handler function directly with rights = R_BLK_ALL_TAG (0x07)
//     and target_ptr = the enumerated ns_row_id is behaviorally
//     identical to what cap_invoke would do once dispatched.
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: every sub-8-byte field this file reads goes through an
//       existing accessor (nvme_iop_row_state, nvme_iop_row_msix_row_id,
//       msix_tail_decode_offset/_data, nqiow_slot_kind/_target) that
//       already applies the xor+mov_b zero-extension idiom internally;
//       this file itself performs no raw sized loads.
//   G4: every sentinel compared against a value with bit 63/31 set is
//       staged through `mov r10, <imm>; cmp reg, r10` (imm32 cmp
//       operands sign-extend).
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `nqiow_`.

module KindNvmeIoQueuesSynth = structure {

  pub let mut _nvmeiow_stage : u64 = 0

  pub let nqiow_ok   : [u8; 17] = "KIND_NVME_IO OK\0"
  pub let nqiow_fail : [u8; 19] = "KIND_NVME_IO FAIL\0"

  // Wire-mode-only extra fingerprint (not wired into the standard
  // golden -- BIOS/-kernel smoke never reaches wire mode, so this
  // never fires under the smoke this commit's golden line covers;
  // kept for `tools/run-smoke.sh --nvme` per design §6.5).
  pub let nqiow_wire_ok : [u8; 22] = "KIND_NVME_IO WIRE OK\0"

  // 4-KiB, page-aligned DMA scratch buffer (identity-mapped .bss VA ==
  // PA at boot, same posture as every other boot-time NVMe buffer in
  // this tree).
  pub let mut _nqiow_dma_buf : [u64; 512] = uninit @align(4096)

  // 32-byte BDEV_OP_READ_LBA/WRITE_LBA descriptor page (lba, nblocks,
  // dma_iova, status_out).  Must be 4-KiB aligned: cap_handler_blkdev
  // decodes desc_page_addr by masking op_arg's low 12 bits off, so any
  // low-order garbage in the address would corrupt the op_code it
  // shares op_arg with.
  pub let mut _nqiow_desc_page : [u64; 4] = uninit @align(4096)

  // ==========================================================================
  // nqiow_clear() -- scrub cap_table slots 128..140 inclusive.
  // ==========================================================================
  pub let nqiow_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M3-006 (#1650): clear cap_table slots 128..140. Labels prefixed nqiow_c_.",
      block: {
        push rbx;
        mov rbx, 128;
      nqiow_c_loop:
        cmp rbx, 141;
        jae nqiow_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp nqiow_c_loop;
      nqiow_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nqiow_pci_synth(slot, bdf) -- synth a KIND_PCI_DEV parent with
  // RIGHT_MINT so nvme_ctrl_cap_mint_inner's parent gate accepts it.
  // ==========================================================================
  pub let nqiow_pci_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M3-006 (#1650): cap_mint_write(slot, KIND_PCI_DEV=0x30, R_DEV_ALL|RIGHT_MINT=0x21F, bdf). cap_mint_write does not rights-validate; only the derivation gate does. Labels prefixed nqiow_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;
        mov rdx, 0x21F;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nqiow_hwint_synth(slot, dummy) -- synth a KIND_HW_INTERRUPT parent
  // with RIGHT_MINT so msix_cap_mint's parent gate accepts it.
  // ==========================================================================
  pub let nqiow_hwint_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (dummy: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M3-006 (#1650): cap_mint_write(slot, KIND_HW_INTERRUPT=0x140, R_HW_INT_ALL=0x618, dummy). Labels prefixed nqiow_hs_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x140;
        mov rdx, 0x618;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nqiow_slot_kind(slot) / nqiow_slot_target(slot) -- cap_table row
  // readers.  0xDEADBEEF on out-of-range slot.
  // ==========================================================================
  pub let nqiow_slot_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M3-006 (#1650): read cap_table[slot][+0] (kind field). Labels prefixed nqiow_sk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nqiow_sk_bad;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      nqiow_sk_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  pub let nqiow_slot_target : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M3-006 (#1650): read cap_table[slot][+16] (target_ptr field). Labels prefixed nqiow_st_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nqiow_st_bad;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 16];
        ret;
      nqiow_st_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  // ==========================================================================
  // kind_nvme_io_queues_witness() -> u64
  //
  // design/hardware/nvme-io-queues.md §6.  Five callee-save pushes
  // (rbx/r12/r13/r14/r15) leave rsp%16 == 0 (entry rsp%16==8, 5*8=40,
  // 48 % 16 == 0), matching the M1/M2 witnesses' own top-level shape.
  // r12 carries ns_row_id across stages within each mode; ctrl_row_id
  // is always 0 in both modes (a fresh table reset precedes each
  // mode's single controller mint, and NVMEC_MAX-row allocation always
  // takes the lowest free row), so it is used as a bare immediate
  // rather than spilled to a register. rbx/r13/r14/r15 are reloaded
  // per-stage scratch.
  // ==========================================================================
  pub let kind_nvme_io_queues_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M3-006 (#1650): boot witness for the NVMe I/O queue substrate + KIND_BLKDEV dispatcher. Substrate-mode stages 1-15 always run (synthetic controller/namespace, MSI-X alloc/revoke cycle, pair-table shape, create_pair's synthetic-bar0 refusal, pick_pair's PICK_NONE fallback, cap_handler_blkdev op-decode incl. unknown-op/reserved-bit/rights-gate refusals). Wire-mode stages 16-25 run only when _nvme_device_count > 0 (real M1 bring-up to NEGOTIATED, M2 enumerate, MSI-X alloc + bring_up_all, READ/WRITE/READ-back round trip, bad-LBA refusal, teardown). Five callee-save pushes leave rsp%16 == 0. Labels prefixed nqiow_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -----------------------------------------------------------
        // (1) Reset all state; slot range 128..140.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        call nqiow_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;

        // -----------------------------------------------------------
        // (2) Synth KIND_PCI_DEV parent at slot 128.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call nqiow_pci_synth;

        // -----------------------------------------------------------
        // (3) Synth KIND_HW_INTERRUPT parent at slot 129.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 129;
        xor rsi, rsi;
        call nqiow_hwint_synth;

        // -----------------------------------------------------------
        // (4) Mint synth KIND_NVME_CONTROLLER via M1 path.  Expect
        // row 0.  Stamp slot 130 = KIND_NVME_CONTROLLER.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row_id == 0
        jne nqiow_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        mov rdi, 130;
        call nvme_ns_check_parent_ctrl;
        cmp rax, 1;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (5) Mint synth KIND_NVME_NAMESPACE + dual-kind KIND_BLKDEV
        // via M2 path.  ns_slot=131, blk_slot=132, nsid=1, lba=4096,
        // blocks=100, parent_slot=130, parent_ctrl_row=0.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0

        mov rdi, 131;                    // ns_slot
        mov rsi, 132;                    // blk_slot
        mov rdx, 130;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights (R_NVMEN_ALL)
        mov r8,  0x07;                   // blk_rights (R_BLK_ALL_TAG)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nqiow_fail_stage;
        mov r12, rax;                    // r12 = ns_row_id (persists)

        mov rdi, 131;
        call nqiow_slot_kind;
        mov r11, 0x199;
        cmp rax, r11;
        jne nqiow_fail_stage;
        mov rdi, 132;
        call nqiow_slot_kind;
        cmp rax, 0x42;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (6) nvme_io_msix_alloc_for_ctrl(ctrl_row=0, hw_int_parent=129,
        // slot_base=133, ncpu=4).  Verify slots 133..136 hold
        // KIND_HW_MSIX_VECTOR with table_offset==k*16, msix_data==k.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, 129;                    // hw_int_parent_slot
        mov rdx, 133;                    // slot_base
        mov rcx, 4;                      // ncpu
        call nvme_io_msix_alloc_for_ctrl;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor r13, r13;                    // k = 0
      nqiow_msix_verify_loop:
        cmp r13, 4;
        jae nqiow_msix_verify_done;

        mov rdi, 133;
        add rdi, r13;                    // slot = 133 + k
        call nqiow_slot_kind;
        mov r11, 0x141;                  // KIND_HW_MSIX_VECTOR
        cmp rax, r11;
        jne nqiow_fail_stage;

        mov rdi, 133;
        add rdi, r13;
        call nqiow_slot_target;
        mov r14, rax;                    // row_id

        mov rdi, r14;
        call msix_tail_decode_offset;
        mov r10, r13;
        shl r10, 4;                      // k * 16
        cmp rax, r10;
        jne nqiow_fail_stage;

        mov rdi, r14;
        call msix_tail_decode_data;
        cmp rax, r13;                    // k
        jne nqiow_fail_stage;

        add r13, 1;
        jmp nqiow_msix_verify_loop;
      nqiow_msix_verify_done:

        // -----------------------------------------------------------
        // (7) Verify pair rows (ctrl 0, cpu 0..3) state == MSIX (1).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor r13, r13;
      nqiow_pair_verify_loop:
        cmp r13, 4;
        jae nqiow_pair_verify_done;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, r13;                    // cpu_idx = k
        call nvme_iop_row_state;
        cmp rax, 1;                      // NVME_IOP_STATE_MSIX
        jne nqiow_fail_stage;

        add r13, 1;
        jmp nqiow_pair_verify_loop;
      nqiow_pair_verify_done:

        // -----------------------------------------------------------
        // (8) nvme_io_create_pair(0, 0) -> expect NVMEIO_CQ_FAILED
        // (synthetic bar0 makes the admin submit path fail).  Row
        // must remain in state MSIX, not corrupted.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        xor rsi, rsi;
        call nvme_io_create_pair;
        mov r10, 0xFFFFEC52;             // NVMEIO_CQ_FAILED
        cmp rax, r10;
        jne nqiow_fail_stage;

        xor rdi, rdi;
        xor rsi, rsi;
        call nvme_iop_row_state;
        cmp rax, 1;                      // still NVME_IOP_STATE_MSIX
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (9) nvme_io_pick_pair(0) -> expect NVMEIO_PICK_NONE.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call nvme_io_pick_pair;
        mov r10, 0xFFFFEC58;             // NVMEIO_PICK_NONE
        cmp rax, r10;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (10) cap_handler_blkdev op-decode via cap_invoke(slot=132):
        // QUERY_FAMILY, unknown-op refusal, reserved-bit refusal.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 1;                      // BDEV_OP_QUERY_FAMILY
        call cap_invoke;
        cmp rax, 1;                      // NVME family
        jne nqiow_fail_stage;

        mov rdi, 132;
        mov rsi, 7;                      // unknown op (BDEV_OP_TRIM=6 is the max)
        call cap_invoke;
        mov r10, 0xFFFFEC60;             // BDEV_ERR_BAD_ARG
        cmp rax, r10;
        jne nqiow_fail_stage;

        mov rdi, 132;
        mov rsi, 0x103;                  // op=READ_LBA(3) | reserved bit[8] set
        call cap_invoke;
        mov r10, 0xFFFFEC60;             // BDEV_ERR_BAD_ARG
        cmp rax, r10;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (11) BDEV_OP_QUERY_GEOM -> (lba_size << 32) | block_count.
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 132;
        xor rsi, rsi;                    // BDEV_OP_QUERY_GEOM
        call cap_invoke;
        mov r14, 4096;
        shl r14, 32;
        or  r14, 100;
        cmp rax, r14;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (12) BDEV_OP_FLUSH / BDEV_OP_TRIM against slot 132 (rights
        // = R_BLK_ALL_TAG = 0x07, stamped by the M2 dual-kind mint at
        // stage 5, above -- predates R51.M4-001's R_BLK_ALL widening
        // to 0x1F).  R51.M4-001 (#1651) / M4-002 (#1652) gave these
        // ops real bodies gated on R_BLK_FLUSH (0x08) / R_BLK_TRIM
        // (0x10) (design/hardware/nvme-oncs-reliability.md §4.1);
        // cap_handler_blkdev's rights check (`rbx & 0x8` / `& 0x10`)
        // now fires BEFORE the op ever reaches nvme_reliability.pdx's
        // ONCS gate, since 0x07 carries neither bit -- this file's
        // stage 5 mint intentionally still REQUESTS only the legacy
        // 0x07 for this slot, exercising the invoke-time rights-check
        // path rather than the mint-gate ceiling: R51.M7-002 (#1670)
        // widened the mint gate itself (kind_nvme_namespace.pdx's
        // R_BLK_ALL_TAG, kind_ahci_port.pdx's ahci_port_blk_rights_valid)
        // from 0x07 to 0x1F, so a dual-kind mint COULD now request
        // R_BLK_FLUSH/R_BLK_TRIM on this cap -- this stage just doesn't,
        // by design, so slot 132 still carries only 0x07 and the two
        // asserts below still hold.  Both ops now return
        // INVOKE_DENIED (0xFFFFFFFFFFFFFFFD) instead of the old
        // BDEV_ERR_UNSUPPORTED stub refusal (0xFFFFEC61) -- the
        // op-decode/reserved-bit/dispatch plumbing this stage
        // exercises is otherwise unchanged, so the bare (unpaged)
        // op_arg from before is still safe: the rights check trips
        // before r14/desc_page_addr is ever read past its
        // (unconditional but harmless) computation.
        // -----------------------------------------------------------
        mov rax, 12;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 5;                      // BDEV_OP_FLUSH
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED (rights 0x07 lacks R_BLK_FLUSH)
        cmp rax, r10;
        jne nqiow_fail_stage;

        mov rdi, 132;
        mov rsi, 6;                      // BDEV_OP_TRIM
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED (rights 0x07 lacks R_BLK_TRIM)
        cmp rax, r10;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (13) BDEV_OP_READ_LBA -> NVMEIO_PICK_NONE (no SQ_LIVE pair);
        // R_BLK_READ / R_BLK_WRITE rights gates via synth single-right
        // slots 137 (WRITE only) and 138 (READ only).
        // -----------------------------------------------------------
        mov rax, 13;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        lea r14, [rip + _nqiow_desc_page];
        xor rax, rax;
        mov [r14 + 0], rax;              // lba = 0
        mov rax, 1;
        mov [r14 + 8], rax;              // nblocks = 1
        lea rax, [rip + _nqiow_dma_buf];
        mov [r14 + 16], rax;             // dma_iova
        xor rax, rax;
        mov [r14 + 24], rax;             // status_out

        mov rdi, r14;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 132;
        call cap_invoke;
        mov r10, 0xFFFFEC58;             // NVMEIO_PICK_NONE
        cmp rax, r10;
        jne nqiow_fail_stage;

        mov rdi, 137;
        mov rsi, 0x42;                   // KIND_BLKDEV
        mov rdx, 0x02;                   // R_BLK_WRITE only
        mov rcx, r12;                    // target_ptr = ns_row_id
        call cap_mint_write;

        mov rdi, r14;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 137;
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r10;
        jne nqiow_fail_stage;

        mov rdi, 138;
        mov rsi, 0x42;
        mov rdx, 0x01;                   // R_BLK_READ only
        mov rcx, r12;
        call cap_mint_write;

        mov rdi, r14;
        mov r10, 4;                      // BDEV_OP_WRITE_LBA
        or  rdi, r10;
        mov rsi, rdi;
        mov rdi, 138;
        call cap_invoke;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r10;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (14) nvme_io_msix_revoke_for_ctrl(0, 133, 4) -> expect 0.
        // Verify slots 133..136 scrubbed AND pair rows FREE.
        // -----------------------------------------------------------
        mov rax, 14;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 133;
        mov rdx, 4;
        call nvme_io_msix_revoke_for_ctrl;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor r13, r13;
      nqiow_revoke_verify_loop:
        cmp r13, 4;
        jae nqiow_revoke_verify_done;

        mov rdi, 133;
        add rdi, r13;
        call nqiow_slot_kind;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor rdi, rdi;
        mov rsi, r13;
        call nvme_iop_row_state;
        cmp rax, 0;                      // NVME_IOP_STATE_FREE
        jne nqiow_fail_stage;

        add r13, 1;
        jmp nqiow_revoke_verify_loop;
      nqiow_revoke_verify_done:

        // -----------------------------------------------------------
        // (15) Stamp KIND_NVME_IO OK.  Clean up substrate state, then
        // check for wire mode.
        // -----------------------------------------------------------
        mov rax, 15;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nqiow_ok];
        call klog_s1;

        call nqiow_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;

        mov r10, [rip + _nvme_device_count];
        cmp r10, 0;
        je  nqiow_success;

        // =============================================================
        // WIRE MODE (stages 16..25).  Real NVMe device present.
        // =============================================================

        // -----------------------------------------------------------
        // (16) Real controller mint via M1 probe hook; bring up to
        // NEGOTIATED (ENABLE -> IDENTIFY -> SET_FEATURES).
        // -----------------------------------------------------------
        mov rax, 16;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call nqiow_pci_synth;

        mov rdi, 128;
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        call nvme_ctrl_probe_and_mint;
        cmp rax, 0;
        je  nqiow_fail_stage;            // at least one row must mint

        xor rdi, rdi;                    // row_id = 0
        call nvme_ctrl_bring_up;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor rdi, rdi;
        call nvme_ctrl_identify;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor rdi, rdi;
        mov rsi, 4;                      // requested queue count
        call nvme_ctrl_negotiate_queues;
        cmp rax, 0;
        jne nqiow_fail_stage;

        xor rdi, rdi;
        call nvme_ctrl_row_state;
        cmp rax, 4;                      // NVMEC_STATE_NEGOTIATED
        jne nqiow_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (17) M2 enumeration -> at least one namespace row.
        // -----------------------------------------------------------
        mov rax, 17;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 130;                    // parent_slot
        xor rsi, rsi;                    // parent_ctrl_row = 0
        mov rdx, 0x41F;                  // ns_rights
        call nvme_ns_enumerate;
        cmp rax, 0;
        je  nqiow_fail_stage;
        xor r12, r12;                    // ns_row_id = 0 (first enumerated row)

        // -----------------------------------------------------------
        // (18) MSI-X batch alloc for the real controller.
        // -----------------------------------------------------------
        mov rax, 18;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 129;
        xor rsi, rsi;
        call nqiow_hwint_synth;

        xor rdi, rdi;                    // ctrl_row_id = 0
        mov rsi, 129;                    // hw_int_parent_slot
        mov rdx, 133;                    // slot_base
        mov rcx, 4;                      // ncpu
        call nvme_io_msix_alloc_for_ctrl;
        cmp rax, 0;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (19) nvme_io_bring_up_all(0, 4) -> count == min(4, num_io_queues).
        // -----------------------------------------------------------
        mov rax, 19;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, 4;
        call nvme_io_bring_up_all;
        mov r13, rax;                    // r13 = pairs reaching SQ_LIVE

        xor rdi, rdi;
        call nvme_ctrl_row_num_io_queues;
        mov r14, rax;                    // r14 = num_io_queues
        mov r10, 4;
        cmp r14, r10;
        jbe nqiow_wire_nqs_ok;
        mov r14, r10;
      nqiow_wire_nqs_ok:
        cmp r13, r14;
        jne nqiow_fail_stage;
        cmp r13, 0;
        je  nqiow_fail_stage;

        // -----------------------------------------------------------
        // (20) Bad-LBA refusal, then READ of LBA 0 (4-KiB).
        // -----------------------------------------------------------
        mov rax, 20;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        lea r14, [rip + _nqiow_desc_page];
        mov rax, 0xFFFFFFFF;
        mov [r14 + 0], rax;              // lba (deliberately out of range)
        mov rax, 1;
        mov [r14 + 8], rax;              // nblocks
        lea rax, [rip + _nqiow_dma_buf];
        mov [r14 + 16], rax;             // dma_iova
        xor rax, rax;
        mov [r14 + 24], rax;             // status_out

        mov rdi, 0x07;                   // rights = R_BLK_ALL_TAG
        mov rsi, r12;                    // ns_row_id
        mov rdx, r14;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rdx, r10;
        call cap_handler_blkdev;
        mov rax, [r14 + 24];             // status_out
        cmp rax, 0xE001;                 // out-of-range LBA
        jne nqiow_fail_stage;

        xor rax, rax;
        mov [r14 + 0], rax;              // lba = 0
        mov rax, 1;
        mov [r14 + 8], rax;              // nblocks = 1
        lea rax, [rip + _nqiow_dma_buf];
        mov [r14 + 16], rax;
        xor rax, rax;
        mov [r14 + 24], rax;

        mov rdi, 0x07;
        mov rsi, r12;
        mov rdx, r14;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rdx, r10;
        call cap_handler_blkdev;

        mov rdi, r12;
        call nvme_ns_row_lba_size;
        mov r15, rax;                    // expected byte count (nblocks=1)

        mov rax, [r14 + 24];
        cmp rax, r15;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (21) WRITE 0xA5 pattern to LBA 1.
        // -----------------------------------------------------------
        mov rax, 21;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        lea r10, [rip + _nqiow_dma_buf];
        mov r11, 0xA5A5A5A5A5A5A5A5;
        xor rcx, rcx;
      nqiow_fill_loop:
        mov [r10 + rcx * 8], r11;
        add rcx, 1;
        cmp rcx, 512;
        jb  nqiow_fill_loop;

        mov rax, 1;
        mov [r14 + 0], rax;              // lba = 1
        mov rax, 1;
        mov [r14 + 8], rax;              // nblocks = 1
        lea rax, [rip + _nqiow_dma_buf];
        mov [r14 + 16], rax;
        xor rax, rax;
        mov [r14 + 24], rax;

        mov rdi, 0x07;
        mov rsi, r12;
        mov rdx, r14;
        mov r10, 4;                      // BDEV_OP_WRITE_LBA
        or  rdx, r10;
        call cap_handler_blkdev;

        mov rax, [r14 + 24];
        cmp rax, r15;                    // same expected byte count
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (22) Zero the buffer, READ LBA 1 back, verify 0xA5 pattern.
        // -----------------------------------------------------------
        mov rax, 22;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        lea r10, [rip + _nqiow_dma_buf];
        xor r11, r11;
        xor rcx, rcx;
      nqiow_zero_loop:
        mov [r10 + rcx * 8], r11;
        add rcx, 1;
        cmp rcx, 512;
        jb  nqiow_zero_loop;

        mov rax, 1;
        mov [r14 + 0], rax;              // lba = 1
        mov rax, 1;
        mov [r14 + 8], rax;              // nblocks = 1
        lea rax, [rip + _nqiow_dma_buf];
        mov [r14 + 16], rax;
        xor rax, rax;
        mov [r14 + 24], rax;

        mov rdi, 0x07;
        mov rsi, r12;
        mov rdx, r14;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rdx, r10;
        call cap_handler_blkdev;

        mov rax, [r14 + 24];
        cmp rax, r15;
        jne nqiow_fail_stage;

        lea r10, [rip + _nqiow_dma_buf];
        mov r11, 0xA5A5A5A5A5A5A5A5;
        xor rcx, rcx;
      nqiow_verify_loop:
        mov rax, [r10 + rcx * 8];
        cmp rax, r11;
        jne nqiow_fail_stage;
        add rcx, 1;
        cmp rcx, 512;
        jb  nqiow_verify_loop;

        // -----------------------------------------------------------
        // (23) Teardown: revoke the controller cap (cascades through
        // the namespace + blkdev rows).
        // -----------------------------------------------------------
        mov rax, 23;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // ctrl_row_id = 0
        call nvme_ctrl_cap_revoke;
        cmp rax, 0;
        jne nqiow_fail_stage;

        // -----------------------------------------------------------
        // (24)/(25) Stamp WIRE OK, final cleanup.
        // -----------------------------------------------------------
        mov rax, 25;
        lea rcx, [rip + _nvmeiow_stage];
        mov [rcx], rax;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nqiow_wire_ok];
        call klog_s1;

      nqiow_success:
        call nqiow_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        xor rax, rax;
        jmp nqiow_out;

      nqiow_fail_stage:
        lea rax, [rip + _nvmeiow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nqiow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nqiow_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        mov rax, 1;

      nqiow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
