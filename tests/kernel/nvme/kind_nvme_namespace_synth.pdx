// tests/kernel/nvme/kind_nvme_namespace_synth.pdx -- R51.M2-006 (#1644)
//
// Boot witness for KIND_NVME_NAMESPACE (0x199) + the dual-kind mint
// with KIND_BLKDEV (0x42).
//
// Fingerprint: R51.M2 KIND_NVME_NAMESPACE OK
//
// Cap slots 128..131 reserved (128 = synthetic KIND_NVME_CONTROLLER
// parent, 129 = wrong-kind parent, 130 = KIND_NVME_NAMESPACE dual-
// kind child, 131 = KIND_BLKDEV dual-kind child).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// This witness exercises the SUBSTRATE-LEVEL primitives that R51.M2
// lands, not the wire-through-to-hardware round trip.  Under BIOS/
// -kernel boot no NVMe controller exists (MCFG absent ->
// _pci_device_count == 0 -> _nvme_device_count == 0), so we synthesize
// a KIND_NVME_CONTROLLER row via the M1 primitives, then drive the M2
// mint / dual-kind mint / cascade paths against it.
//
// What the witness DOES exercise, synthetically:
//
//   (1) Reset _nvme_controller_table + _nvme_namespace_table + slot
//       range 128..131.  Mint a synthetic KIND_NVME_CONTROLLER parent
//       via the M1 nvme_ctrl_cap_mint_inner path (with a synth
//       KIND_PCI_DEV grandparent at slot 128).
//   (2) M2-001 primitives: rights_valid (positive + negative),
//       blk_rights_valid (positive + negative), nsid_valid (positive +
//       reserved-broadcast + zero), lba_valid (positive both formats +
//       negative), blocks_valid, ctrl_row_valid (positive +
//       out-of-range), check_parent_ctrl (positive + wrong-kind +
//       KIND_PCI_DEV parent refused), hdr_pack (positive + refused).
//   (3) M2-001 mint happy path: nvme_ns_cap_mint_inner with valid
//       parent, R_NVMEN_ALL rights, nsid=1, lba_size=4096, blocks=100.
//       Expect row_id 0.  Assert row accessors return the exact values
//       (nsid, lba_size, block_count, parent_ctrl_row, family=NVME,
//       state=MINTED, ns_slot).
//   (4) M2-001 mint refusals: BAD_PARENT (wrong-kind slot), BAD_RIGHTS
//       (rights outside R_NVMEN_ALL), BAD_NSID (0 and 0xFFFFFFFE),
//       BAD_LBA (513), BAD_BLOCKS (0), BAD_CTRL_ROW (out-of-range
//       controller).
//   (5) M2-001 dispatch: cap_handler_nvme_namespace QUERY_NSID with
//       R_NVMEN_INVOKE returns 1; QUERY_LBA_SIZE returns 4096;
//       QUERY_BLOCK_COUNT returns 100; QUERY_FAMILY returns 1
//       (NVME); QUERY_STATE returns 1 (MINTED); without INVOKE
//       returns DENIED; op_arg[63:8] refused; unsupported op refused.
//   (6) M2-002 nvme_ns_enumerate: on an unbrought-up synthetic
//       controller (admin_ctx == 0) the walker drains empty and
//       returns 0.  Verifies parent gate and drain-empty signature.
//   (7) M2-004 dual-kind mint: reset _nvme_namespace_table + slots
//       130/131; call nvme_ns_dual_kind_mint(ns_slot=130, blk_slot=131,
//       parent=synth ctrl, ns_rights=R_NVMEN_ALL, blk_rights=R_BLK_ALL,
//       nsid=2, lba=512, blocks=200, parent_ctrl_row).  Expect a
//       valid row_id back.  Verify BOTH cap_table[130] and [131]
//       carry kinds 0x199 / 0x42 respectively; slot 130's target_ptr
//       == row_id, slot 131's target_ptr == row_id | (BDEV_FAMILY_NVME
//       (1) << 16) (R51.M7-003, #1671 -- nvme_ns_dual_kind_mint now
//       stamps the family byte via blkdev_cap.pdx's shared
//       blkdev_cap_mint_nvme helper instead of leaving target_ptr as
//       bare row_id).
//   (8) M2-004 dual-kind refusals: identical slots (DUAL_BAD_SLOTS);
//       blk_rights outside R_BLK_ALL (MINT_BAD_BLK_RIGHTS).
//   (9) M2-004 BDEV_OP_QUERY round-trip: cap_invoke on slot 131
//       (KIND_BLKDEV) with op_arg = 0 decodes as BDEV_OP_QUERY_GEOM
//       against the real cap_handler_blkdev.pdx dispatcher (R51.M3-003,
//       #1647).  Assert cap_invoke(slot=131, op_arg=0) == (lba_size <<
//       32) | block_count for the stage-7 mint (512, 200).  (Pre-#1647
//       this op_arg fell through to cap_invoke_dispatch's generic
//       default arm and returned target_ptr == row_id; that fallback
//       is no longer reachable for KIND_BLKDEV once #1647 installed a
//       real handler at the 0x42 dispatch arm.)
//  (10) M2-005 revoke cascade: call nvme_ns_cap_revoke on the ns
//       row -- expect NVMEN_OK.  Verify the row is now dead
//       (nvme_ns_tail_valid == 0) AND the KIND_BLKDEV descriptor at
//       slot 131 is scrubbed (kind field == 0).  A second revoke on
//       the same row returns NVMEN_REVOKE_ALREADY.
//  (11) M2-005 controller-level cascade: mint a fresh dual-kind
//       row at ns_slot=130, blk_slot=131.  Then revoke the parent
//       KIND_NVME_CONTROLLER via nvme_ctrl_cap_revoke -- verify
//       every namespace row citing that controller is scrubbed AND
//       the KIND_BLKDEV children are scrubbed.
//
// This is the M2 sub of the milestone: the wire-through-to-hardware
// (IDENTIFY(active NS list) + per-NSID IDENTIFY(namespace) actually
// submitted) lands at R51.M3+ under UEFI/OVMF where a real NVMe
// controller BAR0 is available.

module KindNvmeNamespaceSynth = structure {

  pub let mut _nvmenw_stage : u64 = 0

  pub let nvmenw_ok   : [u8; 25] = "KIND_NVME_NAMESPACE OK\n\0\0"
  pub let nvmenw_fail : [u8; 27] = "KIND_NVME_NAMESPACE FAIL\n\0\0"

  // Mint a synthetic KIND_PCI_DEV parent (kind 0x30) with R_DEV_ALL |
  // RIGHT_MINT so the M1 nvme_ctrl_cap_mint_inner can derive a
  // controller cap from it.  Same shape as nvmecw_pci (M1 witness).
  pub let nvmenw_pci : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-006 (#1644): mint a synthetic KIND_PCI_DEV parent for the M1 controller mint gate. cap_mint_write does not rights-validate; the derivation gate does. Labels prefixed nvmenw_pci_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;                   // KIND_PCI_DEV
        mov rdx, 0x21F;                  // R_DEV_ALL | RIGHT_MINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let nvmenw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-006 (#1644): clear cap_table slots 128..132. Labels prefixed nvmenw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 128;
      nvmenw_c_loop:
        cmp rbx, 132;
        jae nvmenw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp nvmenw_c_loop;
      nvmenw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // Cap-table slot read helpers.  Each returns the kind field at the
  // given slot or 0xDEADBEEF on out-of-range.  Used by (10) and (11).
  pub let nvmenw_slot_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-006 (#1644): read cap_table[slot][+0] (kind field). Labels prefixed nvmenw_sk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nvmenw_sk_bad;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      nvmenw_sk_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  pub let nvmenw_slot_target : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-006 (#1644): read cap_table[slot][+16] (target_ptr field). Labels prefixed nvmenw_st_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nvmenw_st_bad;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 16];
        ret;
      nvmenw_st_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  pub let kind_nvme_namespace_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M2-006 (#1644): boot witness for KIND_NVME_NAMESPACE + dual-kind KIND_BLKDEV mint. Exercises rights_valid / blk_rights_valid / nsid_valid / lba_valid / blocks_valid / ctrl_row_valid / check_parent_ctrl / hdr_pack; mint happy path + BAD_PARENT / BAD_RIGHTS / BAD_NSID / BAD_LBA / BAD_BLOCKS / BAD_CTRL_ROW; row accessors; dispatch happy + denied + refused; enumerate drain-empty; dual-kind mint success + BAD_SLOTS + BAD_BLK_RIGHTS; BDEV_OP invoke round-trip through fall-through; revoke cascade to KIND_BLKDEV; controller-level cascade to namespace + blkdev. Five callee-save pushes leave rsp%16 == 0. Labels prefixed nvmenw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -----------------------------------------------------------
        // (1) Reset all state.  Mint synthetic parents.  Mint the
        // synthetic KIND_NVME_CONTROLLER we will derive from.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        call nvmenw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;

        // Synth KIND_PCI_DEV parent at slot 128.
        mov rdi, 128;
        mov rsi, 0xBEEF;
        call nvmenw_pci;

        // Synth wrong-kind cap at slot 129 (kind=0).
        mov rdi, 129;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // Mint synthetic KIND_NVME_CONTROLLER row via M1 API.
        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x200000;               // bar0_pa (bogus)
        call nvme_ctrl_cap_mint_inner;
        mov r10, 8;                      // NVMEC_MAX
        cmp rax, r10;
        jae nvmenw_fail_stage;
        mov r13, rax;                    // r13 = ctrl_row_id (M1)

        // Also stamp a KIND_NVME_CONTROLLER descriptor at slot 128
        // (replacing the KIND_PCI_DEV we just used) so our M2 mint
        // gate finds the right parent kind there.  This mirrors what
        // a supervisor would do after acquiring reset authority.
        mov rdi, 128;                    // slot
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;                  // R_NVMEC_ALL (incl. MINT_NS 0x200)
        mov rcx, r13;                    // target_ptr = ctrl_row_id
        call cap_mint_write;

        // Verify parent-ctrl gate accepts slot 128 now.
        mov rdi, 128;
        call nvme_ns_check_parent_ctrl;
        cmp rax, 1;
        jne nvmenw_fail_stage;
        // ...and refuses slot 129 (kind=0).
        mov rdi, 129;
        call nvme_ns_check_parent_ctrl;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (2) M2-001 primitives.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        // rights_valid.
        mov rdi, 0x41F;                  // R_NVMEN_ALL
        call nvme_ns_rights_valid;
        cmp rax, 1;
        jne nvmenw_fail_stage;
        mov rdi, 0x8000;                 // outside
        call nvme_ns_rights_valid;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // blk_rights_valid.  R51.M7-002 (#1670) widened R_BLK_ALL_TAG
        // from 0x07 to 0x1F (adds R_BLK_FLUSH/R_BLK_TRIM), so 0x08/0x10
        // are now IN-subset; 0x20 is the first bit still refused.
        mov rdi, 0x1F;                   // R_BLK_ALL_TAG
        call nvme_ns_blk_rights_valid;
        cmp rax, 1;
        jne nvmenw_fail_stage;
        mov rdi, 0x08;                   // R_BLK_FLUSH -- now in-subset
        call nvme_ns_blk_rights_valid;
        cmp rax, 1;
        jne nvmenw_fail_stage;
        mov rdi, 0x20;                   // outside
        call nvme_ns_blk_rights_valid;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // nsid_valid.
        mov rdi, 1;                      call nvme_ns_nsid_valid; cmp rax, 1; jne nvmenw_fail_stage;
        xor rdi, rdi;                    call nvme_ns_nsid_valid; cmp rax, 0; jne nvmenw_fail_stage;
        mov rdi, 0xFFFFFFFE;             call nvme_ns_nsid_valid; cmp rax, 0; jne nvmenw_fail_stage;
        mov rdi, 0xFFFFFFFF;             call nvme_ns_nsid_valid; cmp rax, 0; jne nvmenw_fail_stage;

        // lba_valid.
        mov rdi, 512;                    call nvme_ns_lba_valid; cmp rax, 1; jne nvmenw_fail_stage;
        mov rdi, 4096;                   call nvme_ns_lba_valid; cmp rax, 1; jne nvmenw_fail_stage;
        mov rdi, 513;                    call nvme_ns_lba_valid; cmp rax, 0; jne nvmenw_fail_stage;
        mov rdi, 8192;                   call nvme_ns_lba_valid; cmp rax, 0; jne nvmenw_fail_stage;

        // blocks_valid.
        mov rdi, 100;                    call nvme_ns_blocks_valid; cmp rax, 1; jne nvmenw_fail_stage;
        xor rdi, rdi;                    call nvme_ns_blocks_valid; cmp rax, 0; jne nvmenw_fail_stage;

        // ctrl_row_valid (positive uses r13 = live ctrl row).
        mov rdi, r13;                    call nvme_ns_ctrl_row_valid; cmp rax, 1; jne nvmenw_fail_stage;
        mov rdi, 7;                      call nvme_ns_ctrl_row_valid; cmp rax, 0; jne nvmenw_fail_stage;

        // hdr_pack.
        mov rdi, 0;                      // ns_slot
        mov rsi, 1;                      // state = MINTED
        call nvme_ns_hdr_pack;
        mov r11, 0x100;
        cmp rax, r11;
        jne nvmenw_fail_stage;
        // Refused: state = 0.
        mov rdi, 0;
        xor rsi, rsi;
        call nvme_ns_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (3) M2-001 mint happy path.  nsid=1, lba=4096, blocks=100.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        push r13;                        // save ctrl_row_id
        mov rdi, 128;                    // parent (KIND_NVME_CONTROLLER)
        mov rsi, 0x41F;                  // R_NVMEN_ALL
        mov rdx, 1;                      // nsid
        mov rcx, 4096;                   // lba_size
        mov r8, 100;                     // block_count
        mov r9, r13;                     // parent_ctrl_row
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nvmenw_fail_stage;
        mov r12, rax;                    // r12 = ns_row_id

        mov rdi, r12; call nvme_ns_row_nsid;        cmp rax, 1;    jne nvmenw_fail_stage;
        mov rdi, r12; call nvme_ns_row_lba_size;    mov r11, 4096; cmp rax, r11; jne nvmenw_fail_stage;
        mov rdi, r12; call nvme_ns_row_block_count; cmp rax, 100;  jne nvmenw_fail_stage;
        mov rdi, r12; call nvme_ns_row_parent;      cmp rax, r13;  jne nvmenw_fail_stage;
        mov rdi, r12; call nvme_ns_row_family;      cmp rax, 1;    jne nvmenw_fail_stage;
        mov rdi, r12; call nvme_ns_row_state;       cmp rax, 1;    jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (4) M2-001 mint refusals.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        // BAD_PARENT (slot 129 is kind=0).
        push r13;
        mov rdi, 129;
        mov rsi, 0x41F;
        mov rdx, 1;
        mov rcx, 512;
        mov r8, 10;
        mov r9, r13;
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 0xFFFFEC5D;             // NVMEN_MINT_BAD_PARENT
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // BAD_RIGHTS.
        push r13;
        mov rdi, 128;
        mov rsi, 0x8000;                 // outside R_NVMEN_ALL
        mov rdx, 1;
        mov rcx, 512;
        mov r8, 10;
        mov r9, r13;
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 0xFFFFEC5C;             // NVMEN_MINT_BAD_RIGHTS
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // BAD_NSID (0).
        push r13;
        mov rdi, 128;
        mov rsi, 0x41F;
        xor rdx, rdx;
        mov rcx, 512;
        mov r8, 10;
        mov r9, r13;
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 0xFFFFEC5B;             // NVMEN_MINT_BAD_NSID
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // BAD_LBA (513).
        push r13;
        mov rdi, 128;
        mov rsi, 0x41F;
        mov rdx, 1;
        mov rcx, 513;                    // not 512 nor 4096
        mov r8, 10;
        mov r9, r13;
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 0xFFFFEC5A;             // NVMEN_MINT_BAD_LBA
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // BAD_BLOCKS (0).
        push r13;
        mov rdi, 128;
        mov rsi, 0x41F;
        mov rdx, 1;
        mov rcx, 512;
        xor r8, r8;
        mov r9, r13;
        call nvme_ns_cap_mint_inner;
        pop r13;
        mov r10, 0xFFFFEC59;             // NVMEN_MINT_BAD_BLOCKS
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // BAD_CTRL_ROW (7 is out-of-range for our synth setup).
        mov rdi, 128;
        mov rsi, 0x41F;
        mov rdx, 1;
        mov rcx, 512;
        mov r8, 10;
        mov r9, 7;                       // ctrl row 7 not live
        call nvme_ns_cap_mint_inner;
        mov r10, 0xFFFFEC55;             // NVMEN_MINT_BAD_CTRL_ROW
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (5) M2-001 dispatch.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        // QUERY_NSID with R_NVMEN_INVOKE returns 1.
        mov rdi, 0x008;
        mov rsi, r12;
        xor rdx, rdx;                    // op = QUERY_NSID
        call cap_handler_nvme_namespace;
        cmp rax, 1;
        jne nvmenw_fail_stage;

        // QUERY_LBA_SIZE.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 1;
        call cap_handler_nvme_namespace;
        mov r11, 4096;
        cmp rax, r11;
        jne nvmenw_fail_stage;

        // QUERY_BLOCK_COUNT.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 2;
        call cap_handler_nvme_namespace;
        cmp rax, 100;
        jne nvmenw_fail_stage;

        // QUERY_FAMILY.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 4;
        call cap_handler_nvme_namespace;
        cmp rax, 1;                      // NVMEN_FAMILY_NVME
        jne nvmenw_fail_stage;

        // QUERY_STATE.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 5;
        call cap_handler_nvme_namespace;
        cmp rax, 1;                      // NVMEN_STATE_MINTED
        jne nvmenw_fail_stage;

        // Without INVOKE denied.
        mov rdi, 0x400;                  // OBSERVE only
        mov rsi, r12;
        xor rdx, rdx;
        call cap_handler_nvme_namespace;
        mov r10, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // op_arg[63:8] refused.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 0x100;
        call cap_handler_nvme_namespace;
        mov r10, 0xFFFFEC5E;             // NVMEN_TAIL_BAD_ARG
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // Unsupported op refused.
        mov rdi, 0x008;
        mov rsi, r12;
        mov rdx, 8;                      // > NVMEN_OP_MAX (7)
        call cap_handler_nvme_namespace;
        mov r10, 0xFFFFFFFFFFFFFFFC;     // UNSUP
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (6) M2-002 enumerate: drain-empty on unbrought-up ctrl.
        // Our synthetic ctrl has admin_ctx == 0 so the walker
        // short-circuits into the drain-empty path.
        // _nvme_active_nsid_count is also 0 at boot so the loop
        // exits immediately.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        mov rdi, 128;                    // parent_slot
        mov rsi, r13;                    // parent_ctrl_row
        mov rdx, 0x41F;                  // ns_rights
        call nvme_ns_enumerate;
        // Expect 0 mints (drain-empty).
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (7) M2-004 dual-kind mint.  First revoke the single-ns row
        // we minted above so the table starts fresh.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call nvme_ns_cap_revoke;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // Dual-kind mint: ns_slot=130, blk_slot=131.
        // P0276: nvme_ns_dual_kind_mint takes 6 primitive args; the
        // trailing four (nsid, lba_size, block_count, parent_ctrl_row)
        // are packed into a caller-owned 32-byte stack block and
        // passed as a pointer (arg 6, r9).  sub/add rsp,32 is a
        // multiple of 16 so it does not disturb the alignment already
        // established at this point (rsp%16 == 0).  r13 (ctrl_row_id)
        // is read, not clobbered, so no save/restore is needed.
        sub rsp, 32;
        mov rax, 2;
        mov [rsp + 0], rax;              // nsid
        mov rax, 512;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 200;
        mov [rsp + 16], rax;             // block_count
        mov [rsp + 24], r13;             // parent_ctrl_row

        mov rdi, 130;                    // ns_slot
        mov rsi, 131;                    // blk_slot
        mov rdx, 128;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights
        mov r8,  0x07;                   // blk_rights (R_BLK_ALL_TAG)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nvmenw_fail_stage;
        mov r14, rax;                    // r14 = new ns_row_id

        // Verify slot 130 descriptor is KIND_NVME_NAMESPACE.
        mov rdi, 130;
        call nvmenw_slot_kind;
        mov r11, 0x199;
        cmp rax, r11;
        jne nvmenw_fail_stage;
        mov rdi, 130;
        call nvmenw_slot_target;
        cmp rax, r14;
        jne nvmenw_fail_stage;

        // Verify slot 131 descriptor is KIND_BLKDEV, target_ptr =
        // row_id | (BDEV_FAMILY_NVME(1) << 16) as of R51.M7-003
        // (#1671): nvme_ns_dual_kind_mint now stamps the family byte
        // via the shared blkdev_cap_mint_nvme helper instead of
        // leaving target_ptr as bare row_id (the DESIGN-DOC GAP
        // #1669's debugger flagged).
        mov rdi, 131;
        call nvmenw_slot_kind;
        cmp rax, 0x42;
        jne nvmenw_fail_stage;
        mov rdi, 131;
        call nvmenw_slot_target;
        mov r10, r14;
        mov r11, 1;                      // BDEV_FAMILY_NVME
        shl r11, 16;
        or  r10, r11;                    // expected target_ptr
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (8) M2-004 dual-kind refusals.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        // Identical slots.  sub/add rsp,32 (multiple of 16) preserves
        // the alignment already established here.
        sub rsp, 32;
        mov rax, 3;
        mov [rsp + 0], rax;              // nsid
        mov rax, 512;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 200;
        mov [rsp + 16], rax;             // block_count
        mov [rsp + 24], r13;             // parent_ctrl_row
        mov rdi, 130;
        mov rsi, 130;                    // == ns_slot
        mov rdx, 128;
        mov rcx, 0x41F;
        mov r8,  0x07;
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 0xFFFFEC53;             // NVMEN_DUAL_BAD_SLOTS
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // blk_rights outside R_BLK_ALL_TAG.  R51.M7-002 (#1670) widened
        // R_BLK_ALL_TAG from 0x07 to 0x1F (adds R_BLK_FLUSH/R_BLK_TRIM),
        // so 0x20 (not 0x08) is now the first bit still refused.  Same
        // alignment discipline.
        sub rsp, 32;
        mov rax, 3;
        mov [rsp + 0], rax;              // nsid
        mov rax, 512;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 200;
        mov [rsp + 16], rax;             // block_count
        mov [rsp + 24], r13;             // parent_ctrl_row
        mov rdi, 130;
        mov rsi, 129;                    // wrong-kind blk_slot, but rights fail first
        mov rdx, 128;
        mov rcx, 0x41F;
        mov r8,  0x20;                   // outside R_BLK_ALL_TAG (0x1F)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 0xFFFFEC52;             // NVMEN_MINT_BAD_BLK_RIGHTS
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (9) M2-004 BDEV_OP round-trip via cap_invoke.  STALE-COMMENT
        // FIX: this stage's assertion predates R51.M3-003 (#1647),
        // which installed a real KIND_BLKDEV dispatch handler
        // (cap_handler_blkdev.pdx) at cap_invoke_dispatch's 0x42 arm.
        // Before #1647, cap_invoke on a KIND_BLKDEV slot fell through
        // to cap_invoke_dispatch's generic default arm and returned
        // target_ptr verbatim (== ns_row_id); that fallback path is no
        // longer reachable for kind 0x42.  op_arg = 0 now decodes as
        // BDEV_OP_QUERY_GEOM (op_code bits [7:0] == 0): rights =
        // R_BLK_ALL_TAG (0x07, stamped by the dual-kind mint at stage
        // 7 above) satisfies QUERY_GEOM's (R_BLK_READ|R_BLK_ADMIN =
        // 0x5) gate, family = NVME (1, stamped by blkdev_cap_mint_nvme
        // per R51.M7-003/#1671), so cap_handler_blkdev's NVMe geometry
        // arm runs nvme_ns_row_lba_size/_block_count against the same
        // row and returns (lba_size << 32) | block_count -- (512 << 32)
        // | 200 for the stage-7 mint's lba=512/blocks=200 -- not
        // ns_row_id. This still proves the CAP IS INVOKABLE end-to-end
        // through cap_invoke_dispatch AND that the real handler decodes
        // QUERY_GEOM correctly against a dual-kind-minted row.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        mov rdi, 131;                    // BLKDEV slot
        xor rsi, rsi;                    // op_arg = 0 -> BDEV_OP_QUERY_GEOM
        call cap_invoke;
        mov r10, 512;                    // lba_size (stage 7's dual-kind mint)
        shl r10, 32;
        mov r11, 200;                    // block_count (stage 7's dual-kind mint)
        or  r10, r11;                    // expected (lba_size << 32) | block_count
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (10) M2-005 revoke cascade: revoke the ns row; slot 131's
        // KIND_BLKDEV must be scrubbed by the cascade.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        mov rdi, r14;
        call nvme_ns_cap_revoke;
        cmp rax, 0;                      // NVMEN_OK
        jne nvmenw_fail_stage;

        // Row is dead.
        mov rdi, r14;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // Slot 131 (KIND_BLKDEV) scrubbed.
        mov rdi, 131;
        call nvmenw_slot_kind;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // Slot 130 was NOT scrubbed by this cascade -- only the BLKDEV
        // child is cascaded; the KIND_NVME_NAMESPACE descriptor at
        // slot 130 is the caller's responsibility to unbind once the
        // row is dead.  Confirm it still reads as KIND_NVME_NAMESPACE
        // but its target_ptr now points at a dead row (which
        // nvme_ns_row_of_slot would refuse).
        mov rdi, 130;
        call nvmenw_slot_kind;
        mov r11, 0x199;
        cmp rax, r11;
        jne nvmenw_fail_stage;
        mov rdi, 130;
        call nvme_ns_row_of_slot;
        cmp rax, 0xFF;                   // NVMEN_ROW_NONE
        jne nvmenw_fail_stage;

        // A second revoke on the (already-dead) row returns
        // NVMEN_REVOKE_ALREADY.
        mov rdi, r14;
        call nvme_ns_cap_revoke;
        mov r10, 0xFFFFEC56;             // NVMEN_REVOKE_ALREADY
        cmp rax, r10;
        jne nvmenw_fail_stage;

        // -----------------------------------------------------------
        // (11) M2-005 controller-level cascade.  Mint a fresh dual-
        // kind row, then revoke the parent controller -- the cascade
        // must scrub the namespace row AND the KIND_BLKDEV descriptor.
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _nvmenw_stage];
        mov [rcx], rax;

        // Scrub slot 130 so the fresh mint at ns_slot=130 has a clean
        // descriptor to stamp.
        mov rdi, 130;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // Re-mint dual-kind (nsid=4 this time).
        sub rsp, 32;
        mov rax, 4;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 300;
        mov [rsp + 16], rax;             // block_count
        mov [rsp + 24], r13;             // parent_ctrl_row
        mov rdi, 130;
        mov rsi, 131;
        mov rdx, 128;
        mov rcx, 0x41F;
        mov r8,  0x07;
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;
        cmp rax, r10;
        jae nvmenw_fail_stage;
        mov r15, rax;                    // r15 = new ns_row_id

        // Verify pre-cascade state.
        mov rdi, r15;
        call nvme_ns_tail_valid;
        cmp rax, 1;
        jne nvmenw_fail_stage;
        mov rdi, 131;
        call nvmenw_slot_kind;
        cmp rax, 0x42;
        jne nvmenw_fail_stage;

        // Revoke controller row -- our M2 hook cascades to the ns
        // row, which itself cascades to slot 131.
        mov rdi, r13;
        call nvme_ctrl_cap_revoke;
        cmp rax, 0;                      // NVMEC_OK
        jne nvmenw_fail_stage;

        // Post-cascade: ns row dead, slot 131 scrubbed.
        mov rdi, r15;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        jne nvmenw_fail_stage;
        mov rdi, 131;
        call nvmenw_slot_kind;
        cmp rax, 0;
        jne nvmenw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvmenw_ok];
        call klog_s1;

        call nvmenw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp nvmenw_out;

      nvmenw_fail_stage:
        lea rax, [rip + _nvmenw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + nvmenw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call nvmenw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      nvmenw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
