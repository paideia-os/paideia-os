// tests/kernel/nvme/bdev_barrier_synth.pdx -- R51.M8-002 boot witness.
//
// Boot witness for the durability barrier landed by cap/bdev_barrier.pdx
// (R51.M8-002, #1676): journaled WRITE + FLUSH ordering over the R51
// unified BDEV wire.
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// (commit 2d6ab82) §2.M8 #1676, §4.4 (the witness naming table names
// `tests/r51/journal-barrier.golden` -- this tree's actual convention
// for an R51 witness is a boot-time klog fingerprint stamped from a
// `tests/kernel/*_synth.pdx` file called out of src/kernel/boot/
// witness/r30_platform.pdx, exactly as kind_nvme_reliability_synth.pdx
// and kind_nvme_io_queues_synth.pdx already do for their own M3/M4
// witnesses -- no literal `.golden` file exists in this tree for any
// R51.M6+ witness yet, so this file follows the established convention
// rather than inventing a new one).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// Stage A (negative probe): deliberately record a MIS-ordered six-event
// group directly via bbar_record (FLUSH, WRITE, FLUSH, WRITE, FLUSH,
// WRITE -- inverted from the required WRITE,FLUSH,... pattern) and
// assert bbar_assert_order flags MOUNTW_BARRIER_VIOLATION. This proves
// the state-machine walker actually rejects a bad sequence rather than
// rubber-stamping every input.
//
// Stage B: synthesize a KIND_NVME_CONTROLLER (row 0) + dual-kind
// KIND_NVME_NAMESPACE/KIND_BLKDEV row pair with blk_rights = R_BLK_ALL
// (0x1F, the post-R51.M7-002/#1670 mint-gate ceiling), same recipe as
// kind_nvme_reliability_synth.pdx's own stage (4).
//
// Stage C: drive bdev_barrier_journaled_write 8 times (JOP_COMMIT) --
// design's own witness text ("write 8 journaled records") -- against
// the minted KIND_BLKDEV cap, then bbar_assert_order(0, 8) over the
// resulting 48-event ring and assert 0 (clean six-step-per-record
// walk). Every WRITE/FLUSH reaches nvme_io_submit_rw/_flush with no
// live SQ pair minted in substrate mode, so each returns NVMEIO_
// PICK_NONE (0xFFFFEC58) -- the same "gate passed, submit refused for
// the M3 no-live-pair reason" outcome kind_nvme_reliability_synth.pdx
// already treats as expected; bdev_barrier_journaled_write's own
// bbjw_check accepts exactly {0, 0xFFFFEC58}.
//
// Fingerprint: "KIND_BDEV_BARRIER OK" / "... FAIL" (no round/milestone/
// issue tag, per design/policy/output-provenance-strip.md).
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G4: every sentinel compared against a value with bit 31/63 set is
//       staged through `mov r10, <imm>; cmp reg, r10` -- identical
//       posture to cap/bdev_barrier.pdx / kind_nvme_reliability_synth.pdx.
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `bbdw_`.
//
// Cap slots 128..132 reserved (cleared at entry and on every exit
// path, same reuse posture as kind_nvme_reliability_synth.pdx's own
// 128..140 range -- safe because R51 boot witnesses run strictly
// sequentially and each fully resets cap/table state before
// returning):
//   128 = synth KIND_PCI_DEV parent (controller mint gate)
//   130 = KIND_NVME_CONTROLLER (row 0)
//   131 = KIND_NVME_NAMESPACE (M2 dual-kind mint child)
//   132 = KIND_BLKDEV (M2 dual-kind mint child, rights 0x1F = R_BLK_ALL)

module BdevBarrierSynth = structure {

  pub let mut _bbdw_stage : u64 = 0

  pub let bbdw_ok   : [u8; 22] = "KIND_BDEV_BARRIER OK\0"
  pub let bbdw_fail_msg : [u8; 24] = "KIND_BDEV_BARRIER FAIL\0"

  // Scratch DMA payload page for the WRITE_LBA descriptor's dma_iova
  // field. Content is irrelevant -- substrate mode never reaches a
  // real PRP/PRDT walk (no live SQ pair), so this is never actually
  // read by hardware.
  pub let mut _bbdw_dma_page : [u64; 512] = uninit @align(4096)

  // ==========================================================================
  // bbdw_clear() -- scrub cap_table slots 128..133 inclusive.
  // ==========================================================================
  pub let bbdw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-002 boot witness: clear cap_table slots 128..133. Same shape as kind_nvme_reliability_synth.pdx's own nrelw_clear. Labels prefixed bbdw_cl_.",
      block: {
        push rbx;
        mov rbx, 128;
      bbdw_cl_loop:
        cmp rbx, 133;
        jae bbdw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bbdw_cl_loop;
      bbdw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bbdw_pci_synth(slot, bdf) -- synth a KIND_PCI_DEV parent with
  // RIGHT_MINT so nvme_ctrl_cap_mint_inner's parent gate accepts it.
  // ==========================================================================
  pub let bbdw_pci_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-002 boot witness: cap_mint_write(slot, KIND_PCI_DEV=0x30, R_DEV_ALL|RIGHT_MINT=0x21F, bdf). Same shape as kind_nvme_reliability_synth.pdx's nrelw_pci_synth. Labels prefixed bbdw_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;
        mov rdx, 0x21F;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_bdev_barrier_witness() -> u64
  //
  // Five callee-save pushes (rbx/r12/r13/r14/r15) leave rsp%16 == 0
  // (entry rsp%16==8, 5*8=40, 40 mod 16 == 8 -- no pad added because
  // this function's own nested calls are made at the SAME parity every
  // other R51 witness in this tree relies on: see kind_nvme_
  // reliability_witness's identical five-push shape with no pad,
  // which this file mirrors verbatim). r12 unused after stage B
  // (ns_row_id is not needed once slot 132 is minted, since every
  // stage-C call addresses the cap by SLOT, not by row id); r13 is
  // never assigned a value -- its push exists purely so the five-push
  // count lands rsp%16==0 without a separate `sub rsp,8` pad, the same
  // trade every other five-push R51 witness in this tree makes; r14
  // holds the DMA scratch page address across the stage-C loop; r15
  // is the iteration counter.
  // ==========================================================================
  pub let kind_bdev_barrier_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M8-002 boot witness: stage A (negative ordering probe against bbar_assert_order), stage B (synth KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV with blk_rights=0x1F), stage C (8x bdev_barrier_journaled_write, JOP_COMMIT, then bbar_assert_order(0,8)). Five callee-save pushes leave rsp%16==0 per this file's header note. Labels prefixed bbdw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // -----------------------------------------------------------
        // Stage A: negative ordering probe. Deliberately record an
        // inverted six-event group (FLUSH,WRITE,FLUSH,WRITE,FLUSH,
        // WRITE) and confirm bbar_assert_order rejects it.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _bbdw_stage];
        mov [rcx], rax;

        call bbar_reset;

        mov rdi, 5;                      // FLUSH (wrong -- expected WRITE first)
        xor rsi, rsi;
        call bbar_record;

        mov rdi, 4;
        xor rsi, rsi;
        call bbar_record;

        mov rdi, 5;
        xor rsi, rsi;
        call bbar_record;

        mov rdi, 4;
        xor rsi, rsi;
        call bbar_record;

        mov rdi, 5;
        xor rsi, rsi;
        call bbar_record;

        mov rdi, 4;
        xor rsi, rsi;
        call bbar_record;

        xor rdi, rdi;                    // start_idx = 0
        mov rsi, 1;                      // num_records = 1
        call bbar_assert_order;
        mov r10, 0xFFFFECE3;             // MOUNTW_BARRIER_VIOLATION
        cmp rax, r10;
        jne bbdw_fail_stage;

        // -----------------------------------------------------------
        // Stage B: synth controller + dual-kind namespace/blkdev.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _bbdw_stage];
        mov [rcx], rax;

        call bbar_reset;
        call bbdw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call bbdw_pci_synth;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row_id == 0
        jne bbdw_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 1024;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0

        mov rdi, 131;                    // ns_slot
        mov rsi, 132;                    // blk_slot
        mov rdx, 130;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL, post-#1670)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae bbdw_fail_stage;
        mov r12, rax;                    // r12 = ns_row_id (unused further; kept for parity with sibling witnesses)

        // -----------------------------------------------------------
        // Stage C: 8x journaled write via slot 132, then assert order.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _bbdw_stage];
        mov [rcx], rax;

        call bbar_reset;

        lea r14, [rip + _bbdw_dma_page]; // dma_iova, held across the loop
        xor r15, r15;                    // iteration counter
      bbdw_loop:
        cmp r15, 8;
        jae bbdw_loop_done;

        mov rdi, 132;                    // cap_slot (KIND_BLKDEV)
        mov rsi, 100;                    // journal_lba
        mov rdx, 200;                    // data_lba
        mov rcx, 8;                      // data_nblocks
        mov r8,  r14;                    // dma_iova
        mov r9,  1;                      // jop = JOP_COMMIT
        call bdev_barrier_journaled_write;
        cmp rax, 0;
        jne bbdw_fail_stage;

        add r15, 1;
        jmp bbdw_loop;
      bbdw_loop_done:

        mov rax, 4;
        lea rcx, [rip + _bbdw_stage];
        mov [rcx], rax;

        xor rdi, rdi;                    // start_idx = 0
        mov rsi, 8;                      // num_records = 8
        call bbar_assert_order;
        cmp rax, 0;
        jne bbdw_fail_stage;

        // -----------------------------------------------------------
        // Stamp OK, clean up, return.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bbdw_ok];
        call klog_s1;

        call bbar_reset;
        call bbdw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        xor rax, rax;
        jmp bbdw_out;

      bbdw_fail_stage:
        lea rax, [rip + _bbdw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bbdw_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bbar_reset;
        call bbdw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call nvme_iop_pair_table_reset;
        mov rax, 1;

      bbdw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
