// tests/kernel/compositor/test_pwp_a11y_wire.pdx -- COMP-RC-04 (Wave NNN)
//
// Functional witness for src/user/compositor/pwp_a11y_wire.pdx (module
// PwpA11yWire, Wave0-B12-07 / paideia-os #2306). Exercises
// pwp_a11y_wire_pack_payload + the field accessors + pwp_a11y_wire_size +
// the validators + the two payload-shape refusal paths of
// pwp_a11y_wire_unpack_and_apply that do not require live a11y_tree
// row-pool state.
//
// GAP NOTE vs. the Wave NNN dispatch brief: the brief describes "bind
// parent window provider a11y hook; child accessibility query resolves
// through parent." No such hook or hierarchical-query-resolution symbol
// exists in pwp_a11y_wire.pdx (PWP here names the Paideia Wire Protocol,
// design/compositor/pwp-spec-vocabulary.md -- not a "parent window
// provider"). What this file actually ships (its own header SECTION 0)
// is the OTHER half of the P4 a11y property: an a11y-tree subtree update
// riding INLINE with the surface commit that produced the frame it
// describes, atomically. This witness exercises that real contract. A
// WEAK stub (tpaw_child_query_via_parent_stub_WEAK, below) documents the
// "child query resolves through parent" gap explicitly. Separately,
// pwp_a11y_wire_unpack_and_apply's happy-path node-append loop calls
// a11y_tree_append_node (src/user/a11y/tree_kind.pdx), which requires a
// live, a11y_tree_init'd row at the named tree id -- state this file does
// not own and this witness does not establish, so only the two shape-
// refusal paths that return BEFORE any a11y_tree call (BAD_PAYLOAD,
// NULL_IDS_BUF) are exercised here; that is a scope boundary, not a gap.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based stage
// number that first failed (1..7).
//
// Encoder: paideia-as. cmp not test; no and reg,imm64. 32-bit-sized
// stores into the node-id scratch buffer use `mov_d` (G1 workaround,
// mirroring madt_topology.pdx), never a bare `mov [mem], reg32`. Four
// callee-save pushes (rbx=scratch, r12=payload, r13=payload2, r14=ids)
// plus one `sub rsp, 8` pad bring rsp%16==0 for every nested call (entry
// rsp%16==8, four pushes stays at 8, the 8-byte pad -> 0), mirroring
// pwp_a11y_wire_pack_payload's own pad idiom in the module under test.
// Labels prefixed tpaw_.

module TestPwpA11yWire = structure {

  pub let mut _tpaw_payload  : [u8; 32] = uninit @align(8)
  pub let mut _tpaw_payload2 : [u8; 32] = uninit @align(8)
  pub let mut _tpaw_ids      : [u32; 2] = uninit @align(4)

  // WEAK STUB -- see file header GAP NOTE. No hierarchical a11y query
  // resolution (a child window's a11y query walking up to its parent's
  // tree) exists anywhere in this tree today; pwp_a11y_wire.pdx ships
  // only the inline wire-payload adapter. Pure leaf; fixed sentinel.
  pub let tpaw_child_query_via_parent_stub_WEAK : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-RC-04 gap marker: no symbol in pwp_a11y_wire.pdx (or elsewhere) resolves a child window's accessibility query through its parent's a11y tree. Pure leaf; returns NOT_IMPLEMENTED(all-ones). Labels prefixed tpaw_cqp_ (none needed, straight-line).",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let test_pwp_a11y_wire_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-RC-04 (Wave NNN): four callee-save pushes (rbx, r12=payload, r13=payload2, r14=ids) plus a `sub rsp,8` pad leave rsp%16==0 for every nested call. Stage 1: stats_reset() then stats_packs()==0 and stats_refused()==0 (clean baseline). Stage 2: ids[0..2)=[10,11] via mov_d (G1); pack_payload(payload, surface=200, tree=1, added=2, ids_off=&ids, updates=0x9) succeeds PWP_A11Y_WIRE_OK(0). Stage 3: accessors round-trip -- get_surface==200, get_tree==1, get_node_count==2, get_ids_offset==&ids, get_updates==0x9; size(payload)==32+2*4==40. Stage 4: four independent refusals into payload2 -- dst=0 -> BAD_DST(0xFFFFEB67); surface=0 -> BAD_SURFACE(0xFFFFEB65); tree=0 -> BAD_TREE(0xFFFFEB64); added=33 -> BAD_ARG(0xFFFFEB66). Stage 5: stats_packs()==1 (only stage 2's success) and stats_refused()==4 (stage 4's four refusals) -- checked BEFORE stage 6's additional pack call so the counts stay unambiguous. Stage 6: unpack_and_apply(0) -> BAD_PAYLOAD(0xFFFFEB62) (no a11y_tree call reached); pack_payload(payload2, 200, 1, 2, 0, 0) succeeds (ids_off is written verbatim, unvalidated at pack time per file SECTION D), then unpack_and_apply(payload2) -> NULL_IDS_BUF(0xFFFFEB61) (refused before any a11y_tree_append_node call, per file SECTION G gate order) -- both refusal paths require no live a11y_tree row-pool state, unlike the happy-path append loop (see file GAP NOTE scope boundary). Stage 7: the WEAK gap stub is called and its fixed sentinel checked; init() (which calls stats_reset internally) then scrubs counters, confirmed by stats_packs()==0 and stats_refused()==0. Labels prefixed tpaw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        lea r12, [rip + _tpaw_payload];
        lea r13, [rip + _tpaw_payload2];
        lea r14, [rip + _tpaw_ids];

        // Stage 1: clean baseline.
        call pwp_a11y_wire_stats_reset;

        call pwp_a11y_wire_stats_packs;
        cmp rax, 0;
        jne tpaw_fail_s1;

        call pwp_a11y_wire_stats_refused;
        cmp rax, 0;
        jne tpaw_fail_s1;

        // Stage 2: build ids buffer and the real payload.
        mov rax, 10;
        mov_d [r14 + 0], rax;
        mov rax, 11;
        mov_d [r14 + 4], rax;

        mov rdi, r12;                    // dst
        mov rsi, 200;                    // surface_kind_id
        mov rdx, 1;                      // a11y_tree_kind_id
        mov rcx, 2;                      // node_count_added
        mov r8, r14;                     // node_ids_offset (abs ptr, Wave 0)
        mov r9, 0x9;                     // state_updates_bitmap (bits 0,3)
        call pwp_a11y_wire_pack_payload;
        cmp rax, 0;                      // PWP_A11Y_WIRE_OK
        jne tpaw_fail_s2;

        // Stage 3: accessors + size.
        mov rdi, r12;
        call pwp_a11y_wire_get_surface;
        cmp rax, 200;
        jne tpaw_fail_s3;

        mov rdi, r12;
        call pwp_a11y_wire_get_tree;
        cmp rax, 1;
        jne tpaw_fail_s3;

        mov rdi, r12;
        call pwp_a11y_wire_get_node_count;
        cmp rax, 2;
        jne tpaw_fail_s3;

        mov rdi, r12;
        call pwp_a11y_wire_get_ids_offset;
        cmp rax, r14;
        jne tpaw_fail_s3;

        mov rdi, r12;
        call pwp_a11y_wire_get_updates;
        cmp rax, 0x9;
        jne tpaw_fail_s3;

        mov rdi, r12;
        call pwp_a11y_wire_size;
        cmp rax, 40;                     // 32 header + 2*4 ids
        jne tpaw_fail_s3;

        // Stage 4: four independent pack_payload refusals.
        mov rdi, 0;                      // dst == 0
        mov rsi, 200;
        mov rdx, 1;
        mov rcx, 2;
        mov r8, r14;
        mov r9, 0;
        call pwp_a11y_wire_pack_payload;
        mov r10, 0xFFFFEB67;             // PWP_A11Y_WIRE_BAD_DST
        cmp rax, r10;
        jne tpaw_fail_s4;

        mov rdi, r13;
        mov rsi, 0;                      // surface == 0
        mov rdx, 1;
        mov rcx, 2;
        mov r8, r14;
        mov r9, 0;
        call pwp_a11y_wire_pack_payload;
        mov r10, 0xFFFFEB65;             // PWP_A11Y_WIRE_BAD_SURFACE
        cmp rax, r10;
        jne tpaw_fail_s4;

        mov rdi, r13;
        mov rsi, 200;
        mov rdx, 0;                      // tree == 0
        mov rcx, 2;
        mov r8, r14;
        mov r9, 0;
        call pwp_a11y_wire_pack_payload;
        mov r10, 0xFFFFEB64;             // PWP_A11Y_WIRE_BAD_TREE
        cmp rax, r10;
        jne tpaw_fail_s4;

        mov rdi, r13;
        mov rsi, 200;
        mov rdx, 1;
        mov rcx, 33;                     // added > NODE_COUNT_MAX(32)
        mov r8, r14;
        mov r9, 0;
        call pwp_a11y_wire_pack_payload;
        mov r10, 0xFFFFEB66;             // PWP_A11Y_WIRE_BAD_ARG
        cmp rax, r10;
        jne tpaw_fail_s4;

        // Stage 5: stats reflect exactly stage 2 + stage 4.
        call pwp_a11y_wire_stats_packs;
        cmp rax, 1;
        jne tpaw_fail_s5;

        call pwp_a11y_wire_stats_refused;
        cmp rax, 4;
        jne tpaw_fail_s5;

        // Stage 6: unpack_and_apply shape refusals (no a11y_tree state
        // required for either path).
        mov rdi, 0;
        call pwp_a11y_wire_unpack_and_apply;
        mov r10, 0xFFFFEB62;             // PWP_A11Y_WIRE_BAD_PAYLOAD
        cmp rax, r10;
        jne tpaw_fail_s6;

        mov rdi, r13;
        mov rsi, 200;
        mov rdx, 1;
        mov rcx, 2;
        mov r8, 0;                       // ids_off == 0, unvalidated at pack
        mov r9, 0;
        call pwp_a11y_wire_pack_payload;
        cmp rax, 0;                      // PWP_A11Y_WIRE_OK
        jne tpaw_fail_s6;

        mov rdi, r13;
        call pwp_a11y_wire_unpack_and_apply;
        mov r10, 0xFFFFEB61;             // PWP_A11Y_WIRE_NULL_IDS_BUF
        cmp rax, r10;
        jne tpaw_fail_s6;

        // Stage 7: gap stub, then scrub.
        call tpaw_child_query_via_parent_stub_WEAK;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tpaw_fail_s7;

        call pwp_a11y_wire_init;

        call pwp_a11y_wire_stats_packs;
        cmp rax, 0;
        jne tpaw_fail_s7;

        call pwp_a11y_wire_stats_refused;
        cmp rax, 0;
        jne tpaw_fail_s7;

        xor rax, rax;
        jmp tpaw_out;

      tpaw_fail_s1:
        mov rbx, 1;
        jmp tpaw_cleanup;
      tpaw_fail_s2:
        mov rbx, 2;
        jmp tpaw_cleanup;
      tpaw_fail_s3:
        mov rbx, 3;
        jmp tpaw_cleanup;
      tpaw_fail_s4:
        mov rbx, 4;
        jmp tpaw_cleanup;
      tpaw_fail_s5:
        mov rbx, 5;
        jmp tpaw_cleanup;
      tpaw_fail_s6:
        mov rbx, 6;
        jmp tpaw_cleanup;
      tpaw_fail_s7:
        mov rbx, 7;

      tpaw_cleanup:
        call pwp_a11y_wire_init;
        mov rax, rbx;

      tpaw_out:
        add  rsp, 8;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
