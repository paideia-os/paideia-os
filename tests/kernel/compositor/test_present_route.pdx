// tests/kernel/compositor/test_present_route.pdx -- COMP-PF-02 (Wave MMM)
//
// Functional witness for src/user/compositor/present_feedback_route.pdx
// (module PresentFeedbackRoute, Wave0-B10-06 / paideia-os #2298).
// Exercises present_feedback_route_add_subscriber + the budget-one-
// refresh gate present_feedback_route_deliver.
//
// GAP NOTE vs. the Wave MMM dispatch brief: the brief describes a
// `subscribe(subscriber, kind_mask)` API with per-classification-kind
// filtering (ON_TIME delivered, DROPPED suppressed because "not in
// mask"). No such API exists in present_feedback_route.pdx -- there is
// no kind_mask, no subscribe-with-mask entry point, and deliver() does
// not discriminate by PresentClassification at all. The route module's
// real filtering axis (file header SECTION 1) is BUDGET-ONE-REFRESH:
// a subscriber receives at most one delivery per vblank_nsec value,
// regardless of classification; a second delivery at the SAME
// vblank_nsec is suppressed with PFR_BUDGET_EXCEEDED and counted in
// dropped_count, while a delivery at a DIFFERENT vblank_nsec goes
// through. This witness exercises that real contract as the closest
// verifiable analogue of "one event received, one suppressed" -- see
// stage comments below.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..4).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. One callee-save
// push (rbx = route_id) gives rsp%16==0 for every nested call (mirrors
// present_feedback_route_revoke's own one-push discipline).

module TestPresentRoute = structure {

  pub let test_present_route_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-PF-02 (Wave MMM): one callee-save push (rbx=route_id) leaves rsp%16==0 for every nested call (entry rsp%16==8, push=0). Stage 1: add_subscriber(100) -> route_id; success iff route_id < PFR_MAX_SUBSCRIBERS(32) (failure sentinels are 0xFFFFEA_xx, far above 32). Stage 2: deliver(route_id, kind_id=1, vblank=1000) on a fresh route (last_delivered_vblank_nsec=0) -> delivered (0), simulating the subscriber RECEIVING the first ON_TIME-associated event. Stage 3: deliver again at the SAME vblank=1000 -> PFR_BUDGET_EXCEEDED (0xFFFFEABB), simulating the second event NOT being received (budget-one-refresh suppression, the module's real discriminator in place of the brief's nonexistent kind_mask). Stage 3b: dropped_count(route_id) == 1 confirms the suppression was actually recorded. Stage 4: deliver at a NEW vblank=2000 -> delivered (0) again, confirming the budget resets per vsync rather than latching shut. Labels prefixed test_present_route_.",
      block: {
        push rbx;

        // Stage 1: add_subscriber(100) -> route_id.
        mov rdi, 100;
        call present_feedback_route_add_subscriber;
        mov rbx, rax;
        mov r10, 32;
        cmp rbx, r10;
        jae test_present_route_fail_s1;

        // Stage 2: first delivery at vblank=1000 -> delivered ("received").
        mov rdi, rbx;
        mov rsi, 1;
        mov rdx, 1000;
        call present_feedback_route_deliver;
        cmp rax, 0;
        jne test_present_route_fail_s2;

        // Stage 3: repeat delivery at the SAME vblank -> suppressed
        // ("not received"), the budget-one-refresh gate.
        mov rdi, rbx;
        mov rsi, 1;
        mov rdx, 1000;
        call present_feedback_route_deliver;
        mov r10, 0xFFFFEABB;
        cmp rax, r10;
        jne test_present_route_fail_s3;

        // Stage 3b: dropped_count observability confirms the suppression.
        mov rdi, rbx;
        call present_feedback_route_dropped_count;
        cmp rax, 1;
        jne test_present_route_fail_s3;

        // Stage 4: delivery at a fresh vblank -> delivered again.
        mov rdi, rbx;
        mov rsi, 1;
        mov rdx, 2000;
        call present_feedback_route_deliver;
        cmp rax, 0;
        jne test_present_route_fail_s4;

        xor rax, rax;
        jmp test_present_route_out;

      test_present_route_fail_s1:
        mov rax, 1;
        jmp test_present_route_out;
      test_present_route_fail_s2:
        mov rax, 2;
        jmp test_present_route_out;
      test_present_route_fail_s3:
        mov rax, 3;
        jmp test_present_route_out;
      test_present_route_fail_s4:
        mov rax, 4;

      test_present_route_out:
        pop rbx;
        ret
      }
    }
}
