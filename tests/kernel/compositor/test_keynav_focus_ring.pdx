// tests/kernel/compositor/test_keynav_focus_ring.pdx -- COMP-IN-01 (Wave LLL)
//
// Functional witness spanning two compositor input-path modules:
// src/user/a11y/tree_kind.pdx (KIND_A11Y_TREE) +
// src/user/compositor/keynav_taborder.pdx (KeynavTaborder, cycling) +
// src/user/compositor/keynav_focus_ring.pdx (KeynavFocusRing, painting).
//
// GAP NOTE vs. the Wave LLL dispatch brief: the brief asks this FILE
// (named after KeynavFocusRing) to exercise a `keynav_focus_advance()`
// entry point that cycles a focus index across 3 attached surfaces.
// No such symbol exists in keynav_focus_ring.pdx -- that module owns
// ONLY the visual ring-strip painter (focus_ring_paint) and the
// skip-link keycode/role helpers (focus_ring_handle_skip_link); it has
// no cursor, no cycling state, and does not track "which surface is
// focused". The cycling behaviour the brief describes is the REAL
// contract of the SIBLING module keynav_taborder.pdx
// (keynav_taborder_init / _next / _prev walking a bounded DFS over a
// KIND_A11Y_TREE). This witness (a) builds a 3-node a11y tree standing
// in for "3 attached surfaces" (label_offset 200/201/202 carry the
// surfaces' identity), (b) drives the REAL cycling primitives
// (keynav_taborder_next / _prev) end to end, and (c) additionally
// exercises keynav_focus_ring_paint on the widget rect of whichever
// node the cursor ends up pointing at, so the module this file is
// actually named for is genuinely exercised too -- mirroring how the
// real compositor would use the two modules together (the ring is
// painted around whatever KeynavTaborder currently points at).
//
// NODE-ID / "INDEX" MAPPING. a11y_tree_append_node PREPENDS to the
// parent's first_child chain (tree_kind.pdx SECTION on CHILD-CHAIN
// ORDER), so appending three children under the root in label order
// 200, 201, 202 assigns node_id 1/2/3 respectively but visits them in
// DFS pre-order as 3, 2, 1 (last-appended first). This witness treats
// that DFS-visit position as the "index" the brief refers to: pos0 =
// node 3 (label 202), pos1 = node 2 (label 201), pos2 = node 1 (label
// 200). Cycling forward 3 times from pos0 yields pos1, pos2, pos0
// (wrap) -- exactly the brief's "1/2/0" sequence. Cycling backward 2
// times from pos0 yields pos2, pos1 -- exactly the brief's "2/1"
// sequence. The mapping is a direct, real consequence of
// keynav_taborder's documented DFS + wrap contract; no stub required.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..12).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]; no MOVABS
// r64,imm64 (every 64-bit comparison constant this file needs is
// built via shl+or from two 32-bit halves). Five callee-save pushes
// (rbx, r12, r13, r14, r15) leave rsp%16==0 for every nested call
// (entry rsp%16==8, five 8-byte pushes -> 48, %16==0). r12 holds the
// tree_kind_id across stages 2-10; r13/r14 are reused as pure scratch
// once the tree_id is no longer needed (stages 11-12).

module TestKeynavFocusRing = structure {

  // TabOrderCursor (16 bytes): tree_kind_id[31:0]|current_node_id[63:32],
  // direction[7:0]|reserved.
  pub let mut _tkfr_cursor  : [u64; 2] = uninit @align(64)

  // FocusRingConfig (16 bytes): see keynav_focus_ring.pdx SECTION 2.
  pub let mut _tkfr_config  : [u64; 2] = uninit @align(64)

  // Widget rect (16 bytes): x[31:0]|y[63:32], w[31:0]|h[63:32].
  pub let mut _tkfr_widget  : [u64; 2] = uninit @align(64)

  // Ring strip surface (72 bytes = 9 u64): rect_count + 4x16-byte rects.
  pub let mut _tkfr_surface : [u64; 9] = uninit @align(64)

  pub let test_keynav_focus_ring_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-01 (Wave LLL): five callee-save pushes (rbx,r12,r13,r14,r15) leave rsp%16==0 for every nested call. Stage 1: a11y_tree_init() (clean pool). Stage 2: a11y_tree_mint(window=501) -> tree_id < A11Y_MAX(4), kept in r12. Stages 3-5: append_node(tree_id, parent=0, role=2/BUTTON, label=200/201/202) -> node_id 1/2/3 respectively (root already occupies node 0). Stage 6: keynav_taborder_init(cursor,tree_id) -> KEYNAV_TAB_OK(0) and cursor_current==3 (DFS-first focusable given the prepend-reversed child chain -- see file header mapping note). Stages 7-9: three keynav_taborder_next() calls return 2, 1, 3(wrap) -- the brief's '1/2/0' in DFS-position terms. Stages 10-11: two keynav_taborder_prev() calls (from current=3) return 1, 2 -- the brief's '2/1'. Stage 12: keynav_focus_ring_config_default + a (x=10,y=20,w=100,h=50) widget rect + keynav_focus_ring_paint round-trip: rect_count==4, TOP strip == (x-4,y-4,w+8,thickness=2) per the module's documented strip geometry (t=p=2 defaults). All 64-bit comparison constants built via shl+or (no MOVABS). Labels prefixed test_keynav_focus_ring_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Stage 1: reset the a11y tree pool.
        call a11y_tree_init;

        // Stage 2: mint a fresh a11y tree for window 501.
        mov rdi, 501;
        call a11y_tree_mint;
        mov r12, rax;                     // r12 = tree_id
        mov r10, 4;
        cmp r12, r10;
        jae test_keynav_focus_ring_fail_s2;

        // Stage 3: append node (parent=root=0, role=2/BUTTON, label=200).
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 200;
        call a11y_tree_append_node;
        cmp rax, 1;
        jne test_keynav_focus_ring_fail_s3;

        // Stage 4: append node (label=201) -> node_id 2.
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 201;
        call a11y_tree_append_node;
        cmp rax, 2;
        jne test_keynav_focus_ring_fail_s4;

        // Stage 5: append node (label=202) -> node_id 3.
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 202;
        call a11y_tree_append_node;
        cmp rax, 3;
        jne test_keynav_focus_ring_fail_s5;

        // Stage 6: init cursor -> KEYNAV_TAB_OK, current == 3 (pos0).
        lea rdi, [rip + _tkfr_cursor];
        mov rsi, r12;
        call keynav_taborder_init;
        cmp rax, 0;
        jne test_keynav_focus_ring_fail_s6;

        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_cursor_current;
        cmp rax, 3;
        jne test_keynav_focus_ring_fail_s6;

        // Stage 7: next() -> 2 (pos1).
        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_next;
        cmp rax, 2;
        jne test_keynav_focus_ring_fail_s7;

        // Stage 8: next() -> 1 (pos2).
        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_next;
        cmp rax, 1;
        jne test_keynav_focus_ring_fail_s8;

        // Stage 9: next() -> 3 (wrap, pos0).
        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_next;
        cmp rax, 3;
        jne test_keynav_focus_ring_fail_s9;

        // Stage 10: prev() -> 1 (pos2).
        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_prev;
        cmp rax, 1;
        jne test_keynav_focus_ring_fail_s10;

        // Stage 11: prev() -> 2 (pos1).
        lea rdi, [rip + _tkfr_cursor];
        call keynav_taborder_prev;
        cmp rax, 2;
        jne test_keynav_focus_ring_fail_s11;

        // Stage 12: paint the focus ring around a widget rect for the
        // currently-focused node. tree_id (r12) no longer needed; r13/
        // r14 reused as scratch below.
        lea rdi, [rip + _tkfr_config];
        call keynav_focus_ring_config_default;
        cmp rax, 0;
        jne test_keynav_focus_ring_fail_s12;

        // Widget rect: x=10, y=20, w=100, h=50.
        lea r10, [rip + _tkfr_widget];
        mov rax, 20;
        shl rax, 32;
        mov r11, 10;
        or rax, r11;
        mov [r10 + 0], rax;
        mov rax, 50;
        shl rax, 32;
        mov r11, 100;
        or rax, r11;
        mov [r10 + 8], rax;

        lea rdi, [rip + _tkfr_config];
        lea rsi, [rip + _tkfr_widget];
        lea rdx, [rip + _tkfr_surface];
        call keynav_focus_ring_paint;
        cmp rax, 0;
        jne test_keynav_focus_ring_fail_s12;

        lea r10, [rip + _tkfr_surface];
        mov rax, [r10 + 0];
        cmp rax, 4;
        jne test_keynav_focus_ring_fail_s12;

        // TOP strip low word: x_out=6 | y_out=16<<32 (t=p=2 defaults:
        // x-(t+p)=10-4=6, y-(t+p)=20-4=16).
        mov rax, [r10 + 8];
        mov r13, 16;
        shl r13, 32;
        mov r14, 6;
        or r13, r14;
        cmp rax, r13;
        jne test_keynav_focus_ring_fail_s12;

        // TOP strip high word: w_out=108 | t=2<<32 (w+2(t+p)=100+8=108).
        mov rax, [r10 + 16];
        mov r13, 2;
        shl r13, 32;
        mov r14, 108;
        or r13, r14;
        cmp rax, r13;
        jne test_keynav_focus_ring_fail_s12;

        xor rax, rax;
        jmp test_keynav_focus_ring_out;

      test_keynav_focus_ring_fail_s2:
        mov rax, 2;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s3:
        mov rax, 3;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s4:
        mov rax, 4;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s5:
        mov rax, 5;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s6:
        mov rax, 6;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s7:
        mov rax, 7;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s8:
        mov rax, 8;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s9:
        mov rax, 9;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s10:
        mov rax, 10;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s11:
        mov rax, 11;
        jmp test_keynav_focus_ring_out;
      test_keynav_focus_ring_fail_s12:
        mov rax, 12;

      test_keynav_focus_ring_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
