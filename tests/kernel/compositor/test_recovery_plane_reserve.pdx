// tests/kernel/compositor/test_recovery_plane_reserve.pdx -- COMP-RC-01 (Wave NNN)
//
// Functional witness for src/user/compositor/recovery_plane_reserve.pdx
// (module RecoveryPlaneReserve, Wave0-B6-09 / paideia-os #2269). Exercises
// rp_init + recovery_plane_reserve_at_boot + rp_singleton_is_reserved +
// rp_get_holder_kind_id + rp_get_boot_seq across the reservation's
// refusal, success and idempotent-guard paths.
//
// GAP NOTE vs. the Wave NNN dispatch brief: the brief describes "reserve
// a recovery plane cap; assert cap slot returned; assert reserve_count >
// 0." KIND_RECOVERY_PLANE is a SINGLETON (module header SECTION 2: "there
// is exactly one recovery-plane reservation per boot, not a pool of many")
// -- there is no cap-table slot index anywhere in this file's surface.
// recovery_plane_reserve_at_boot returns a status code (RP_OK == 0 on
// success), not a slot. This witness treats rp_singleton_is_reserved()
// becoming 1 as the "slot returned" proxy (the reservation now exists and
// is observable), and rp_get_boot_seq() -- the monotonic
// reserved_at_boot_seq counter, which the module's own header names as
// the closest thing to a reservation ordinal -- as the "reserve_count > 0"
// proxy. First successful reservation stamps boot_seq == 1 exactly, which
// this witness asserts rather than a looser ">0" bound.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based stage
// number that first failed (1..4).
//
// Encoder: paideia-as. cmp not test; no and reg,imm64. One callee-save
// push (rbx = pending return code) leaves rsp%16==0 for every nested
// call (entry rsp%16==8, one push -> 0). Large refusal sentinels are
// loaded into r10 via `mov r10, 0x...` then compared, mirroring
// present_feedback_route's own witness idiom, never a direct
// `cmp rax, imm` against a value outside i32 range. Labels prefixed
// trpr_ throughout (sidesteps the reserved `if`/`loop` collision list).

module TestRecoveryPlaneReserve = structure {

  pub let test_recovery_plane_reserve_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-RC-01 (Wave NNN): one callee-save push (rbx) leaves rsp%16==0 for every nested call. Stage 1: rp_init() clears the singleton, then reserve_at_boot(RP_COMPOSITOR_KIND_FORWARD=0x1D1) must be refused RP_HOLDER_IS_COMPOSITOR(0xFFFFEED3) with the cell left untouched (rp_singleton_is_reserved() stays 0) -- proves the compositor can never obtain this cap even before a real holder ever exists. Stage 2: reserve_at_boot(RESERVATION_HOLDER_KIND=0x1D0) succeeds RP_OK(0); rp_singleton_is_reserved()==1 is the 'cap slot returned' proxy per file GAP NOTE, and rp_get_holder_kind_id()==0x1D0 confirms the holder round-trips. Stage 3: rp_get_boot_seq()==1 is the 'reserve_count > 0' proxy -- first reservation stamps exactly 1, not merely nonzero, because the counter is freshly zeroed by stage 1's rp_init(). Stage 4: a second reserve_at_boot(0x1D0) is refused RP_ALREADY_RESERVED(0xFFFFEED1) (idempotent guard); rp_init() then scrubs state defensively before return. Labels prefixed trpr_.",
      block: {
        push rbx;

        // Stage 1: clean slate, then refuse a compositor-flavoured holder.
        call rp_init;
        mov rdi, 0x1D1;                  // RP_COMPOSITOR_KIND_FORWARD
        call recovery_plane_reserve_at_boot;
        mov r10, 0xFFFFEED3;             // RP_HOLDER_IS_COMPOSITOR
        cmp rax, r10;
        jne trpr_fail_s1;

        call rp_singleton_is_reserved;
        cmp rax, 0;
        jne trpr_fail_s1;

        // Stage 2: the real reservation succeeds; holder round-trips.
        mov rdi, 0x1D0;                  // RESERVATION_HOLDER_KIND
        call recovery_plane_reserve_at_boot;
        cmp rax, 0;                      // RP_OK
        jne trpr_fail_s2;

        call rp_singleton_is_reserved;
        cmp rax, 1;
        jne trpr_fail_s2;

        call rp_get_holder_kind_id;
        mov r10, 0x1D0;
        cmp rax, r10;
        jne trpr_fail_s2;

        // Stage 3: reserve_count proxy -- first reservation stamps 1.
        call rp_get_boot_seq;
        cmp rax, 1;
        jne trpr_fail_s3;

        // Stage 4: idempotent guard refuses a second reserve.
        mov rdi, 0x1D0;
        call recovery_plane_reserve_at_boot;
        mov r10, 0xFFFFEED1;             // RP_ALREADY_RESERVED
        cmp rax, r10;
        jne trpr_fail_s4;

        call rp_init;                    // defensive scrub before return
        xor rax, rax;
        jmp trpr_out;

      trpr_fail_s1:
        mov rbx, 1;
        jmp trpr_cleanup;
      trpr_fail_s2:
        mov rbx, 2;
        jmp trpr_cleanup;
      trpr_fail_s3:
        mov rbx, 3;
        jmp trpr_cleanup;
      trpr_fail_s4:
        mov rbx, 4;

      trpr_cleanup:
        call rp_init;
        mov rax, rbx;

      trpr_out:
        pop rbx;
        ret
      }
    }
}
