// tests/kernel/compositor/test_ime_router.pdx -- COMP-IN-03 (Wave LLL)
//
// Functional witness for src/user/compositor/ime_router.pdx (module
// ImeRouter, G11-M3-001 / paideia-os #2316). Exercises ime_router_mint
// + ime_router_switch_provider + ime_router_route_keystroke across the
// composition/no-composition boundary.
//
// GAP NOTE vs. the Wave LLL dispatch brief: the brief names
// `ime_start_composition(seat)`, `route_key(seat, keysym)`,
// `ime_end_composition`, and two return constants IME_ROUTE_COMPOSITION
// / IME_ROUTE_APPLICATION. NONE of these five symbols exist in
// ime_router.pdx (or anywhere else in the tree). The real surface is:
//   * ime_router_mint(seat) -> row_id            (one router per seat)
//   * ime_router_switch_provider(row, provider, session) -- rewrites
//     the row's (active_provider, active_session) pair in place; this
//     file lands the row-level state transition only (file header
//     SECTION 0.2), the cross-module mint/bind orchestration that a
//     real "start composition" gesture would drive is a future
//     dispatcher landing.
//   * ime_router_route_keystroke(row, key_event) -> IMR_ROUTED(0) when
//     an active_session is bound, or IMR_NO_SESSION(0xFFFFE9B8)
//     otherwise.
// This witness maps the brief's two named states onto the router's
// REAL two-valued route outcome: "composition active" ==
// active_session != 0 (route_keystroke returns IMR_ROUTED), "no
// composition, falls through toward the application" ==
// active_session == 0 (route_keystroke returns IMR_NO_SESSION). The
// local aliases below are WEAK STUBS -- named constants standing in
// for the brief's nonexistent IME_ROUTE_* symbols, defined as exactly
// the real sentinel values route_keystroke already returns. "Start
// composition" / "end composition" are simulated via
// switch_provider(row, provider, session!=0) / switch_provider(row,
// provider, session=0) respectively -- the closest real primitive to
// a composition-boundary toggle that ships today.
//
// SEAT NOTE: the brief's example uses seat=0. ime_router_seat_valid
// refuses seat==0 (0 is reserved as a "no seat" sentinel); this
// witness uses seat=1 instead.
//
// FOLLOW-UP: a real ime_start_composition/ime_end_composition pair
// (and the IME_ROUTE_* naming) would land as compositor-dispatcher
// glue on top of ime_router_switch_provider + ime_session_mint /
// ime_session's own revoke path (session_kind.pdx), per this file's
// SECTION 0.2 note that the mint/bind orchestration is out of scope
// here.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..6).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. One callee-save
// push (rbx = row_id) gives rsp%16==0 for every nested call.

module TestImeRouter = structure {

  // WEAK STUBS: named aliases for the brief's nonexistent IME_ROUTE_*
  // constants, pinned to the real ime_router_route_keystroke sentinel
  // values (see GAP NOTE above).
  pub let IME_ROUTE_COMPOSITION_STUB : u64 = 0             // == IMR_ROUTED
  pub let IME_ROUTE_APPLICATION_STUB : u64 = 0xFFFFE9B8    // == IMR_NO_SESSION

  pub let test_ime_router_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-03 (Wave LLL): one callee-save push (rbx=row_id) leaves rsp%16==0 for every nested call. Stage 1: ime_router_stats_reset() (zeros pool+counters). Stage 2: ime_router_mint(seat=1) -> row_id==0 (single-instance pool, IME_ROUTER_MAX=1). Stage 3: switch_provider(row, provider=5, session=9) -> IMR_OK(0), simulating composition start. Stage 4: route_keystroke(row, key_event=0x41 'A') -> IME_ROUTE_COMPOSITION_STUB (real IMR_ROUTED) while a session is bound. Stage 5: switch_provider(row, provider=5, session=0) -> IMR_OK(0), simulating composition end (provider retained, session cleared). Stage 6: route_keystroke(row, key_event=0x41) -> IME_ROUTE_APPLICATION_STUB (real IMR_NO_SESSION) once no session is bound. Labels prefixed test_ime_router_.",
      block: {
        push rbx;

        // Stage 1: reset pool + counters.
        call ime_router_stats_reset;

        // Stage 2: mint the (single-instance) router for seat=1.
        mov rdi, 1;
        call ime_router_mint;
        mov rbx, rax;                     // rbx = row_id
        cmp rbx, 0;
        jne test_ime_router_fail_s2;

        // Stage 3: start composition -- bind provider=5, session=9.
        mov rdi, rbx;
        mov rsi, 5;
        mov rdx, 9;
        call ime_router_switch_provider;
        cmp rax, 0;
        jne test_ime_router_fail_s3;

        // Stage 4: route a keystroke while composing -> COMPOSITION.
        mov rdi, rbx;
        mov rsi, 0x41;
        call ime_router_route_keystroke;
        cmp rax, 0;                       // IME_ROUTE_COMPOSITION_STUB
        jne test_ime_router_fail_s4;

        // Stage 5: end composition -- keep provider=5, clear session.
        mov rdi, rbx;
        mov rsi, 5;
        mov rdx, 0;
        call ime_router_switch_provider;
        cmp rax, 0;
        jne test_ime_router_fail_s5;

        // Stage 6: route the SAME keystroke with no session bound ->
        // APPLICATION.
        mov rdi, rbx;
        mov rsi, 0x41;
        call ime_router_route_keystroke;
        mov r10, 0xFFFFE9B8;              // IME_ROUTE_APPLICATION_STUB
        cmp rax, r10;
        jne test_ime_router_fail_s6;

        xor rax, rax;
        jmp test_ime_router_out;

      test_ime_router_fail_s2:
        mov rax, 2;
        jmp test_ime_router_out;
      test_ime_router_fail_s3:
        mov rax, 3;
        jmp test_ime_router_out;
      test_ime_router_fail_s4:
        mov rax, 4;
        jmp test_ime_router_out;
      test_ime_router_fail_s5:
        mov rax, 5;
        jmp test_ime_router_out;
      test_ime_router_fail_s6:
        mov rax, 6;

      test_ime_router_out:
        pop rbx;
        ret
      }
    }
}
