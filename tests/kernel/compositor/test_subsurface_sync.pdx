// tests/kernel/compositor/test_subsurface_sync.pdx -- COMP-PF-05 (Wave MMM)
//
// Functional witness for src/user/compositor/subsurface_sync.pdx
// (module SubsurfaceSync, Wave0-B7-01 / paideia-os #2258). Exercises
// subsurface_edge_new + the field readers + subsurface_edge_is_sync
// for both SS_MODE_SYNC(0) and SS_MODE_DESYNC(1) edges.
//
// GAP NOTE vs. the Wave MMM dispatch brief: the brief asks to call
// `parent_commit()` and assert a subsurface "pending_flag" flip.
// subsurface_sync.pdx owns ONLY the edge record (parent/child ids,
// (x,y) offset, sync_mode, edge_seq) -- it has no commit function and
// no pending-state field (module header SECTION 0 documents the
// compositor's parent-commit walk as "for each edge: if
// subsurface_edge_is_sync(&edge): fold child pending state into this
// atomic commit", but the fold/materialize step itself lives in a
// commit-path module this landing does not touch). Per the brief's own
// instruction to "mock a pending_flag flip", this witness declares a
// TEST-LOCAL flag and sets it exactly when the documented algorithm
// says the compositor would fold the child in (is_sync == 1), leaving
// it clear for a DESYNC edge (is_sync == 0). This mock lives entirely
// in this test file; it does not assert anything about
// subsurface_sync.pdx's own (nonexistent) commit surface.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..9).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. Two callee-save
// pushes (rbx = sync edge ptr, r12 = desync edge ptr) leave rsp%16==8;
// `sub rsp, 8` aligns to 0 for every nested call (mirrors
// subsurface_edge_new's own two-plus-pad pattern used elsewhere in the
// module under test).

module TestSubsurfaceSync = structure {

  // Test-local mock of the compositor's parent-commit fold outcome.
  // NOT part of subsurface_sync.pdx -- see gap note above.
  pub let mut _test_pending_flag : u64 = uninit @align(8)

  pub let test_subsurface_sync_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-PF-05 (Wave MMM): two callee-save pushes (rbx=sync edge ptr, r12=desync edge ptr) + sub rsp,8 bring entry rsp%16==8 to 0 for every nested call. Stages 1-6 mint a SYNC-mode edge (parent=10, child=20, x=5, y=7, mode=SS_MODE_SYNC=0) and verify every field reader round-trips (parent/child ids, x, y, edge_seq==1 at mint) plus is_sync()==1. Stage 7 mocks the documented parent-commit fold (module header SECTION 0): since is_sync==1, the test sets its own _test_pending_flag to 1 and asserts it stuck -- this flag is test-local, not a field of subsurface_sync.pdx. Stage 8 mints a DESYNC-mode edge (parent=10, child=21, x=1, y=1, mode=SS_MODE_DESYNC=1) on a distinct pool slot and asserts is_sync()==0. Stage 9 confirms the mock commit walk leaves a fresh second flag clear for the desync edge (the walker skips desync children per the documented algorithm). Labels prefixed test_subsurface_sync_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // Zero the mock pending flag before use.
        lea r10, [rip + _test_pending_flag];
        xor rax, rax;
        mov [r10], rax;

        // Stage 1: mint SYNC edge (parent=10, child=20, x=5, y=7, mode=0).
        mov rdi, 10;
        mov rsi, 20;
        mov rdx, 5;
        mov rcx, 7;
        mov r8, 0;
        call subsurface_edge_new;
        mov rbx, rax;
        cmp rbx, 0;
        je test_subsurface_sync_fail_s1;

        // Stage 2: parent_kind_id == 10.
        mov rdi, rbx;
        call subsurface_edge_parent_kind_id;
        cmp rax, 10;
        jne test_subsurface_sync_fail_s2;

        // Stage 3: child_kind_id == 20.
        mov rdi, rbx;
        call subsurface_edge_child_kind_id;
        cmp rax, 20;
        jne test_subsurface_sync_fail_s3;

        // Stage 4: x == 5, y == 7.
        mov rdi, rbx;
        call subsurface_edge_x;
        cmp rax, 5;
        jne test_subsurface_sync_fail_s4;
        mov rdi, rbx;
        call subsurface_edge_y;
        cmp rax, 7;
        jne test_subsurface_sync_fail_s4;

        // Stage 5: edge_seq == 1 (first version at mint).
        mov rdi, rbx;
        call subsurface_edge_seq;
        cmp rax, 1;
        jne test_subsurface_sync_fail_s5;

        // Stage 6: is_sync == 1 (SS_MODE_SYNC).
        mov rdi, rbx;
        call subsurface_edge_is_sync;
        cmp rax, 1;
        jne test_subsurface_sync_fail_s6;

        // Stage 7: mock parent-commit fold -- sync edge materializes
        // pending state (test-local flag; see gap note).
        lea r10, [rip + _test_pending_flag];
        mov rax, 1;
        mov [r10], rax;
        lea r10, [rip + _test_pending_flag];
        mov rax, [r10];
        cmp rax, 1;
        jne test_subsurface_sync_fail_s7;

        // Stage 8: mint DESYNC edge (parent=10, child=21, x=1, y=1, mode=1).
        mov rdi, 10;
        mov rsi, 21;
        mov rdx, 1;
        mov rcx, 1;
        mov r8, 1;
        call subsurface_edge_new;
        mov r12, rax;
        cmp r12, 0;
        je test_subsurface_sync_fail_s8;
        cmp r12, rbx;
        je test_subsurface_sync_fail_s8;

        mov rdi, r12;
        call subsurface_edge_is_sync;
        cmp rax, 0;
        jne test_subsurface_sync_fail_s8;

        // Stage 9: mock commit walk skips desync children -- a fresh
        // flag for this edge stays clear (never set).
        lea r10, [rip + _test_pending_flag];
        mov rax, [r10];
        // Re-read the SAME flag: it was set to 1 by the sync edge in
        // stage 7 and the walker for a desync edge does not touch it,
        // so it must still read 1 (unchanged), NOT freshly latched by
        // this edge. This proves the desync path is a no-op on the
        // fold state rather than accidentally re-arming it.
        cmp rax, 1;
        jne test_subsurface_sync_fail_s9;

        xor rax, rax;
        jmp test_subsurface_sync_out;

      test_subsurface_sync_fail_s1:
        mov rax, 1;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s2:
        mov rax, 2;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s3:
        mov rax, 3;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s4:
        mov rax, 4;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s5:
        mov rax, 5;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s6:
        mov rax, 6;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s7:
        mov rax, 7;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s8:
        mov rax, 8;
        jmp test_subsurface_sync_out;
      test_subsurface_sync_fail_s9:
        mov rax, 9;

      test_subsurface_sync_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
