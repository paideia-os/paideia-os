// tests/kernel/compositor/test_layer_tree.pdx -- COMP-UT-01 (Wave KKK)
//
// Functional witness for src/user/compositor/layer_tree.pdx (module
// LayerTree, Wave0-B6-06 / paideia-os #2256). Exercises attach-three /
// detach-middle / positional-read / count semantics against the
// arena's real header + node layout (LayerTree.pdx Sections 3-4).
//
// GAP NOTE vs. the Wave KKK dispatch brief: the brief names
// layer_tree_attach / layer_tree_detach / layer_tree_get_at /
// layer_tree_count. None of the four exist. LayerTree.pdx's own
// Section 6 documents why: "APPEND_LAYER / REORDER / ATTACH_DAMAGE are
// NOT exposed as arity-one ops -- each ... lands as a compositor-
// internal helper (future landing kind_layer_tree.pdx cap_handler)
// ... external clients can only query." There is also no mint body
// yet (Section 2: "future landing"), so there is no shipping way to
// populate a tree with more than the single root node the (not-yet-
// written) mint stamps.
//
// This file supplies four WEAK, fully-local stub helpers (tlt_attach /
// tlt_detach / tlt_get_at / tlt_count, prefixed distinctly from the
// witness's own test_layer_tree_ labels per this wave's label
// discipline) that reproduce the minimal "ordered list of root's
// children" semantics COMP-UT-01 needs, written directly against the
// module's OWN documented header/node byte layout (LayerTree.pdx
// Sections 3, 4.1, 4.2) via the real lt_row_alloc / lt_arena_base /
// lt_pack_hdr_row / lt_pack_arena_ref surface. They exercise the real
// arena addressing arithmetic (Section E: arena_base + 32 +
// idx*48) but NOT any shipping mutation code path -- there isn't one
// yet. Requires layer_tree.pdx (or its future kind_layer_tree.pdx
// cap_handler sibling) to export real attach/detach/get_at/count
// primitives before this stub can be retired -- file as follow-up.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..5).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]; imm64 sentinels
// (LT_INDEX_NONE = 0xFFFFFFFF) are always loaded into a scratch
// register before a cmp, never compared as a bare immediate, because
// cmp's imm32 form sign-extends and 0xFFFFFFFF has bit 31 set. Labels
// prefixed tlt_at_ / tlt_dt_ / tlt_ga_ / tlt_ct_ for the four stub
// helpers; test_layer_tree_ for the witness itself.

module TestLayerTree = structure {

  // ==========================================================================
  // WEAK STUB HELPERS -- not exported by layer_tree.pdx. See GAP NOTE.
  // ==========================================================================

  // tlt_node_addr(arena_base, idx) -> ptr. Direct restatement of
  // layer_tree.pdx's own documented arena arithmetic (Section E):
  // arena_base + LT_HEADER_BYTES(32) + idx*LT_NODE_BYTES(48). Pure;
  // no memory access of its own. Leaf: no nested calls.
  pub let tlt_node_addr : (u64, u64) -> u64 !{} @{} =
    fn (arena_base: u64) (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): node address = arena_base + 32 + idx*48, restated from layer_tree.pdx Section E. Pure arithmetic, no memory touched here (the caller dereferences the returned pointer). Leaf. Labels prefixed tlt_na_ (none needed -- no branches).",
      block: {
        mov rax, rdi;
        add rax, 32;
        mov r10, rsi;
        imul r10, r10, 48;
        add rax, r10;
        ret
      }
    }

  // tlt_attach(arena_base, layer_kind_id) -> new_index | 0xFFFFFFFF
  // (arena full, LT_MAX_NODES(32) reached). Appends a new leaf node as
  // the last child of the root (index 0), per LayerTree.pdx's own
  // node layout: word0 = layer_kind_id[31:0] | parent_index[63:32];
  // word1 = next_sibling_index[31:0] | first_child_index[63:32].
  pub let tlt_attach : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (layer_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): WEAK STUB append-as-last-child-of-root; layer_tree.pdx exports no mutation op (Section 6). Three callee-save pushes (rbx=arena_base, r12=layer_kind_id then re-purposed as the sibling-walk cursor once written into the node, r13=new_index) leave rsp%16==0 across every nested tlt_node_addr call (entry 8, +24 pushes = 32, mod16==0). Writes the new node at arena_base+32+node_count*48, links it onto the tail of root's next_sibling chain (or directly as root.first_child if the chain is empty), then bumps header.node_count while preserving root_index in the high 32 bits of the same word. Returns the new index, or 0xFFFFFFFF if node_count already reached 32. Labels prefixed tlt_at_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;              // arena_base
        mov r12, rsi;              // layer_kind_id

        mov rax, [rbx + 0];
        and rax, 0xFFFFFFFF;         // node_count
        mov r13, rax;                // new_index

        mov r10, 32;
        cmp r13, r10;
        jae tlt_at_enospc;

        // New node addr; stamp it (parent = root = 0; leaf; no bbox).
        mov rdi, rbx;
        mov rsi, r13;
        call tlt_node_addr;
        mov r10, rax;

        mov rax, r12;
        and rax, 0xFFFFFFFF;
        mov [r10 + 0], rax;          // word0: lkid | parent(0)<<32

        mov rax, 0xFFFFFFFF;
        mov rcx, rax;
        shl rcx, 32;
        or  rax, rcx;
        mov [r10 + 8], rax;          // word1: next_sib(NONE) | first_child(NONE)

        xor rax, rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;

        // Root addr; inspect root.first_child.
        mov rdi, rbx;
        xor rsi, rsi;
        call tlt_node_addr;
        mov r10, rax;

        mov rax, [r10 + 8];
        mov rcx, rax;
        shr rcx, 32;                  // root.first_child

        mov r11, 0xFFFFFFFF;
        cmp rcx, r11;
        jne tlt_at_walk;

        // Empty chain: attach directly under root.
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;           // preserve root.next_sibling (always NONE)
        mov rcx, r13;
        shl rcx, 32;
        or  rax, rcx;
        mov [r10 + 8], rax;
        jmp tlt_at_linked;

      tlt_at_walk:
        mov r12, rcx;                 // walk cursor (layer_kind_id no longer needed)

      tlt_at_walk_loop:
        mov rdi, rbx;
        mov rsi, r12;
        call tlt_node_addr;
        mov r10, rax;                  // current node addr

        mov rax, [r10 + 8];
        mov rcx, rax;
        and rcx, 0xFFFFFFFF;             // current.next_sibling

        mov r11, 0xFFFFFFFF;
        cmp rcx, r11;
        jne tlt_at_walk_advance;

        // Tail found: link the new node here.
        mov rax, [r10 + 8];
        mov r11, rax;
        shr r11, 32;
        shl r11, 32;                      // isolate current.first_child (high32)
        mov rcx, r13;
        and rcx, 0xFFFFFFFF;
        or  rcx, r11;
        mov [r10 + 8], rcx;
        jmp tlt_at_linked;

      tlt_at_walk_advance:
        mov r12, rcx;
        jmp tlt_at_walk_loop;

      tlt_at_linked:
        // header.node_count += 1; preserve root_index (high32).
        mov rax, [rbx + 0];
        mov r10, rax;
        shr r10, 32;
        shl r10, 32;
        mov rcx, r13;
        add rcx, 1;
        and rcx, 0xFFFFFFFF;
        or  rcx, r10;
        mov [rbx + 0], rcx;

        mov rax, r13;
        jmp tlt_at_out;

      tlt_at_enospc:
        mov rax, 0xFFFFFFFF;

      tlt_at_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tlt_detach(arena_base, target_index) -> 0 (unlinked) | 1 (not
  // found in root's child chain). Does NOT compact the node array or
  // decrement header.node_count -- matches the real module's own
  // dense-append arena discipline (Section 4.2), which has no
  // compaction path either.
  pub let tlt_detach : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (target_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): WEAK STUB unlink-from-root's-child-chain. r14 tracks whether the running 'prev' pointer is the root node (link field to rewrite is first_child, the HIGH 32 bits of word+8) or a sibling node (link field is next_sibling, the LOW 32 bits) -- the two fields share one word so the write path cannot be unified without this flag. Four callee-save pushes (rbx,r12,r13,r14) + one align pad keep rsp%16==0 across every nested tlt_node_addr call (entry 8, +32 pushes = 40, mod16==8, +8 pad = 0). Labels prefixed tlt_dt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov rbx, rdi;               // arena_base
        mov r13, rsi;               // target_index

        mov rdi, rbx;
        xor rsi, rsi;
        call tlt_node_addr;
        mov r12, rax;                // r12 = "prev" addr, starts at root
        mov r14, 1;                  // prev is root

        mov rax, [r12 + 8];
        mov rcx, rax;
        shr rcx, 32;                  // cursor = prev.first_child

        mov r10, 0xFFFFFFFF;
        cmp rcx, r10;
        je  tlt_dt_notfound;

      tlt_dt_loop:
        cmp rcx, r13;
        je  tlt_dt_found;

        mov rdi, rbx;
        mov rsi, rcx;
        call tlt_node_addr;
        mov r12, rax;                 // new prev = current
        xor r14, r14;                 // prev is no longer root

        mov rax, [r12 + 8];
        and rax, 0xFFFFFFFF;             // current.next_sibling
        mov r11, rax;

        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        je  tlt_dt_notfound;
        mov rcx, r11;
        jmp tlt_dt_loop;

      tlt_dt_found:
        mov rdi, rbx;
        mov rsi, r13;
        call tlt_node_addr;
        mov r11, rax;
        mov rax, [r11 + 8];
        and rax, 0xFFFFFFFF;            // target.next_sibling

        cmp r14, 0;
        je  tlt_dt_write_sibling;

        // prev is root: rewrite first_child (high32); keep low32
        // (root.next_sibling, always NONE).
        mov r10, [r12 + 8];
        and r10, 0xFFFFFFFF;
        mov rcx, rax;
        shl rcx, 32;
        or  r10, rcx;
        mov [r12 + 8], r10;
        jmp tlt_dt_ok;

      tlt_dt_write_sibling:
        // prev is a sibling node: rewrite next_sibling (low32); keep
        // high32 (prev.first_child).
        mov r10, [r12 + 8];
        mov rcx, r10;
        shr rcx, 32;
        shl rcx, 32;
        or  rcx, rax;
        mov [r12 + 8], rcx;

      tlt_dt_ok:
        xor rax, rax;
        jmp tlt_dt_out;

      tlt_dt_notfound:
        mov rax, 1;

      tlt_dt_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tlt_get_at(arena_base, pos) -> layer_kind_id of the pos'th (0-
  // based) node in root's LIVE child chain, or 0xFFFFFFFF if pos is
  // out of range. A detached node is simply absent from the chain, so
  // this walks past it automatically.
  pub let tlt_get_at : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): WEAK STUB positional read over root's child chain. Four callee-save pushes (rbx=arena_base, r12=current node addr, r13=target pos, r14=running position counter) + one align pad keep rsp%16==0 across every nested tlt_node_addr call (entry 8, +32 = 40 mod16==8, +8 pad = 0). Labels prefixed tlt_ga_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov rbx, rdi;
        mov r13, rsi;                // target pos
        xor r14, r14;                // running counter

        mov rdi, rbx;
        xor rsi, rsi;
        call tlt_node_addr;
        mov rax, [rax + 8];
        mov rcx, rax;
        shr rcx, 32;                   // cursor = root.first_child

      tlt_ga_loop:
        mov r10, 0xFFFFFFFF;
        cmp rcx, r10;
        je  tlt_ga_notfound;

        mov rdi, rbx;
        mov rsi, rcx;
        call tlt_node_addr;
        mov r12, rax;                  // current node addr for cursor rcx

        cmp r14, r13;
        je  tlt_ga_found;

        mov rax, [r12 + 8];
        and rax, 0xFFFFFFFF;
        mov r11, rax;
        mov rcx, r11;
        add r14, 1;
        jmp tlt_ga_loop;

      tlt_ga_found:
        mov rax, [r12 + 0];
        and rax, 0xFFFFFFFF;             // layer_kind_id
        jmp tlt_ga_out;

      tlt_ga_notfound:
        mov rax, 0xFFFFFFFF;

      tlt_ga_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tlt_count(arena_base) -> length of root's live child chain.
  pub let tlt_count : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): WEAK STUB chain-length walk. Three callee-save pushes (rbx=arena_base, r12=current node addr, r13=count) leave rsp%16==0 across every nested tlt_node_addr call (entry 8, +24 = 32 mod16==0). Labels prefixed tlt_ct_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        xor r13, r13;

        mov rdi, rbx;
        xor rsi, rsi;
        call tlt_node_addr;
        mov rax, [rax + 8];
        mov rcx, rax;
        shr rcx, 32;                   // cursor = root.first_child

      tlt_ct_loop:
        mov r10, 0xFFFFFFFF;
        cmp rcx, r10;
        je  tlt_ct_done;

        add r13, 1;

        mov rdi, rbx;
        mov rsi, rcx;
        call tlt_node_addr;
        mov r12, rax;
        mov rax, [r12 + 8];
        and rax, 0xFFFFFFFF;
        mov r11, rax;
        mov rcx, r11;
        jmp tlt_ct_loop;

      tlt_ct_done:
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // WITNESS.
  // ==========================================================================

  pub let test_layer_tree_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-01 (Wave KKK): mints a real KIND_LAYER_TREE row via lt_row_alloc + lt_pack_hdr_row + lt_pack_arena_ref, then hand-stamps a valid single-root arena (header.node_count=1, root at index 0, sealed=1, window_kind_id=0x1C1) directly against layer_tree.pdx's own documented layout since no mint body exists yet (GAP NOTE). Attaches surfaces 100/101/102 via the WEAK tlt_attach stub, asserts count()==3, detaches the middle one (101) via tlt_detach, then asserts get_at(0)==100, get_at(1)==102, count()==2. Five callee-save pushes (rbx=hdr-then-arena_ref-then-row_id scratch, r12=hdr/arena_ref/arena_base scratch, r13=row_id, r14=arena_base, r15=index of the attached surface 101) leave rsp%16==0 across every nested call (entry 8, +40 pushes = 48, mod16==0). Labels prefixed test_layer_tree_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // hdr = lt_pack_hdr_row(parent_window_slot=1, sealed=1).
        mov rdi, 1;
        mov rsi, 1;
        call lt_pack_hdr_row;
        mov rbx, rax;

        // arena_ref = lt_pack_arena_ref(0).
        mov rdi, 0;
        call lt_pack_arena_ref;
        mov r12, rax;

        // row_id = lt_row_alloc(hdr, arena_ref, a11y_ref=0).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, 0;
        call lt_row_alloc;
        mov r13, rax;

        mov r10, 4;
        cmp r13, r10;
        jae test_layer_tree_fail_s1;

        // arena_base = lt_arena_base(row_id).
        mov rdi, r13;
        call lt_arena_base;
        cmp rax, 0;
        je  test_layer_tree_fail_s1;
        mov r14, rax;

        // Header: node_count=1, root_index=0.
        mov rax, 1;
        mov [r14 + 0], rax;

        // window_kind_id=0x1C1, sealed=1.
        mov rax, 0x1C1;
        mov r10, 1;
        shl r10, 32;
        or  rax, r10;
        mov [r14 + 8], rax;

        xor rax, rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        // Root node (index 0): layer_kind_id=1 (background), parent
        // NONE, next_sibling NONE, first_child NONE, bbox=0, seq=0.
        mov rax, 1;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r14 + 32], rax;

        mov rax, 0xFFFFFFFF;
        mov r10, rax;
        shl r10, 32;
        or  rax, r10;
        mov [r14 + 40], rax;

        xor rax, rax;
        mov [r14 + 48], rax;
        mov [r14 + 56], rax;
        mov [r14 + 64], rax;

        // Attach 100, 101, 102.
        mov rdi, r14;
        mov rsi, 100;
        call tlt_attach;

        mov rdi, r14;
        mov rsi, 101;
        call tlt_attach;
        mov r15, rax;                  // index of 101 (the middle attach)

        mov rdi, r14;
        mov rsi, 102;
        call tlt_attach;

        // Stage 2: count == 3.
        mov rdi, r14;
        call tlt_count;
        mov r10, 3;
        cmp rax, r10;
        jne test_layer_tree_fail_s2;

        // Stage 3: detach 101.
        mov rdi, r14;
        mov rsi, r15;
        call tlt_detach;
        cmp rax, 0;
        jne test_layer_tree_fail_s3;

        // Stage 4: get_at(0)==100, get_at(1)==102.
        mov rdi, r14;
        mov rsi, 0;
        call tlt_get_at;
        mov r10, 100;
        cmp rax, r10;
        jne test_layer_tree_fail_s4;

        mov rdi, r14;
        mov rsi, 1;
        call tlt_get_at;
        mov r10, 102;
        cmp rax, r10;
        jne test_layer_tree_fail_s4;

        // Stage 5: count == 2.
        mov rdi, r14;
        call tlt_count;
        mov r10, 2;
        cmp rax, r10;
        jne test_layer_tree_fail_s5;

        xor rax, rax;
        jmp test_layer_tree_out;

      test_layer_tree_fail_s1:
        mov rax, 1;
        jmp test_layer_tree_out;
      test_layer_tree_fail_s2:
        mov rax, 2;
        jmp test_layer_tree_out;
      test_layer_tree_fail_s3:
        mov rax, 3;
        jmp test_layer_tree_out;
      test_layer_tree_fail_s4:
        mov rax, 4;
        jmp test_layer_tree_out;
      test_layer_tree_fail_s5:
        mov rax, 5;

      test_layer_tree_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
