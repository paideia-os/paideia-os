// tests/kernel/compositor/test_a11y_bind_at_mint.pdx -- COMP-IN-05 (Wave LLL)
//
// Functional witness for src/user/compositor/a11y_bind_at_mint.pdx
// (module A11yBindAtMint, Wave0-B9-08 / paideia-os #2305), layered
// over src/user/compositor/window_kind.pdx (KIND_WINDOW) and
// src/user/a11y/tree_kind.pdx (KIND_A11Y_TREE).
//
// GAP NOTE vs. the Wave LLL dispatch brief: the brief asks to "mint
// KIND_A11Y_NODE with label 'OK Button'", have "a11y_bind_at_mint
// return [a] cap id", and read the label back via "a11y_node_inspect".
// THREE mismatches with the real code:
//   (1) There is no KIND_A11Y_NODE. a11y nodes are NOT independent
//       capabilities -- they are index-addressed records
//       (arena_base + node_id*32) living inside ONE KIND_A11Y_TREE
//       row's arena (tree_kind.pdx SECTION 3/4.2). A node has no cap
//       id of its own; it is addressed by (tree_row_id, node_id).
//   (2) a11y_bind_at_mint_wrap does not mint a NODE at all -- it binds
//       a whole a11y TREE to a KIND_WINDOW at window-mint time (the P4
//       structural gate, file header SECTION 0). Its return value is a
//       KIND_WINDOW row_id, not any kind of a11y-node identity.
//   (3) A11yNode carries label_OFFSET (a u32 index into an
//       not-yet-landed interned string table, tree_kind.pdx SECTION 3
//       field docs), never label BYTES. There is no string storage to
//       read back, and no a11y_node_inspect entry point anywhere in
//       the tree.
// This witness therefore (a) exercises the REAL P4-wrapper contract
// (autobind path: window mint with a11y_tree_kind_id=0 triggers an
// internal a11y_tree_mint on the caller's behalf) end to end, and
// (b) provides a11y_node_inspect_STUB below: a WEAK STUB, implemented
// as a thin wrapper over the REAL accessor chain
// (a11y_tree_arena_base + a11y_tree_node_addr +
// a11y_tree_node_label_offset), so the brief's requested call shape
// has a concrete landing spot. It returns the raw u32 label_offset
// (an identity round-trip proxy for "OK Button", stored as the
// integer 0xF00D in this witness), NOT string bytes -- no byte storage
// exists to inspect at this landing.
//
// FOLLOW-UP: (1) an interned a11y label string-table landing would
// give a11y_node_inspect_STUB real bytes to read; (2) if per-node
// revocable capabilities become a requirement, a KIND_A11Y_NODE (or a
// node-scoped capability derived from KIND_A11Y_TREE) would need its
// own design -- today node lifetime is bound to the whole tree row;
// (3) SEPARATELY DISCOVERED WHILE WRITING THIS WITNESS: window_kind.
// pdx's P4 gate (window_a11y_valid) refuses a11y_tree_kind_id==0 as
// its "no tree" sentinel, but KIND_A11Y_TREE row ids START at 0 --
// so the tree that lands in row 0 can NEVER be bound to a window
// (autobind or explicit) through a11y_bind_at_mint_wrap or window_mint
// directly. This witness works around it with a throwaway decoy mint
// (stage 1) so the real autobind call lands on row 1; the underlying
// gap (row-0/sentinel collision) is a genuine latent bug worth its own
// follow-up issue in window_kind.pdx / tree_kind.pdx.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..6).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. Three callee-
// save pushes (rbx = window row_id, r12 = a11y tree_id, r13 = node_id)
// leave rsp%16==0 for every nested call (entry rsp%16==8, three
// 8-byte pushes -> 32, %16==0).

module TestA11yBindAtMint = structure {

  // WEAK STUB: stands in for the brief's nonexistent a11y_node_inspect
  // entry point (see GAP NOTE above). Thin wrapper over the REAL
  // accessor chain; returns the raw u32 label_offset, not string
  // bytes (none exist to return at this landing). One callee-save
  // push (rbx=node_id) leaves rsp%16==0 for the two nested calls.
  pub let a11y_node_inspect_STUB : (u64, u64) -> u64 !{mem} @{} =
    fn (tree_row_id: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-05 (Wave LLL) test-local WEAK STUB: forwards to a11y_tree_arena_base + a11y_tree_node_addr + a11y_tree_node_label_offset to read back a node's label_offset. NOT part of a11y_bind_at_mint.pdx or tree_kind.pdx -- see GAP NOTE. One callee-save push (rbx=node_id) leaves rsp%16==0 for every nested call (entry rsp%16==8, one 8-byte push -> 16, %16==0). Returns 0xFFFFFFFFFFFFFFFF if the tree row is dead (arena_base==0). Labels prefixed tabm_ni_.",
      block: {
        push rbx;
        mov rbx, rsi;                     // node_id (rdi already holds
                                          // tree_row_id for the call below)

        call a11y_tree_arena_base;
        cmp rax, 0;
        je tabm_ni_bad;

        mov rdi, rax;
        mov rsi, rbx;
        call a11y_tree_node_addr;

        mov rdi, rax;
        call a11y_tree_node_label_offset;
        jmp tabm_ni_out;

      tabm_ni_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      tabm_ni_out:
        pop rbx;
        ret
      }
    }

  pub let test_a11y_bind_at_mint_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-05 (Wave LLL): three callee-save pushes (rbx=window row_id, r12=a11y tree_id, r13=OK-Button node_id) leave rsp%16==0 for every nested call. Stage 1: window_init() + a11y_tree_init() (clean pools) + a throwaway a11y_tree_mint(999) -> row 0, working around the row-0/no-tree sentinel collision documented in the file header FOLLOW-UP (3). Stage 2: a11y_bind_at_mint_wrap(window_id=7, parent_surface=1, parent_window=0, z_order=0, tab_workspace_pack=0, a11y_tree_kind_id=0) -> row_id < ABM_WIN_MAX(32) via the AUTOBIND path (a11y_tree_kind_id==0 triggers an internal a11y_tree_mint, which now lands on row 1 thanks to the stage-1 decoy). Stage 3: a11y_bind_verify(row_id)==1 and a11y_bind_stats_autobind()==1 (bumped exactly once). Stage 4: window_row_a11y_tree(row_id) == 1 -- the autobound tree's identity. Stage 5: append a node under the autobound tree's root (parent=0, role=2/BUTTON, label_off=0xF00D standing in for 'OK Button') -> node_id 1 (this witness's closest real analogue of 'mint KIND_A11Y_NODE with a label' -- see GAP NOTE: no such kind exists, so the append happens against the REAL tree the wrapper already bound). Stage 6: a11y_node_inspect_STUB(tree_id, 1) == 0xF00D -- the label identity round-trips intact through the real accessor chain (offset, not bytes -- see GAP NOTE). Labels prefixed test_a11y_bind_at_mint_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Stage 1: reset both pools + the wrapper's own counters.
        call window_init;
        call a11y_tree_init;
        call a11y_bind_stats_reset;

        // Decoy mint: window_kind.pdx's P4 gate (window_a11y_valid)
        // refuses a11y_tree_kind_id==0 as "no tree" -- but a11y_tree_
        // mint's row ids START at 0, so the tree that would land in
        // row 0 can NEVER be bound to a window (autobind OR explicit)
        // through this wrapper; row 0 and "no tree" are the same bit
        // pattern. This is a genuine latent gap in window_kind.pdx /
        // a11y_bind_at_mint.pdx worth its own follow-up issue. Consume
        // row 0 with a throwaway mint here so the REAL autobind call
        // below lands on row 1 and this witness exercises the
        // wrapper's intended behaviour rather than tripping the gap.
        mov rdi, 999;
        call a11y_tree_mint;
        cmp rax, 0;
        jne test_a11y_bind_at_mint_fail_s1;

        // Stage 2: autobind wrap -- a11y_tree_kind_id=0 triggers autobind.
        mov rdi, 7;                       // window_id
        mov rsi, 1;                       // parent_surface
        mov rdx, 0;                       // parent_window (toplevel)
        mov rcx, 0;                       // z_order
        mov r8, 0;                        // tab_workspace_pack
        mov r9, 0;                        // a11y_tree_kind_id (0 == autobind)
        call a11y_bind_at_mint_wrap;
        mov rbx, rax;                     // rbx = window row_id
        mov r10, 32;
        cmp rbx, r10;
        jae test_a11y_bind_at_mint_fail_s2;

        // Stage 3: verify + autobind counter.
        mov rdi, rbx;
        call a11y_bind_verify;
        cmp rax, 1;
        jne test_a11y_bind_at_mint_fail_s3;

        call a11y_bind_stats_autobind;
        cmp rax, 1;
        jne test_a11y_bind_at_mint_fail_s3;

        // Stage 4: recover the autobound tree's identity -- expect
        // row 1 (row 0 was consumed by the decoy mint above).
        mov rdi, rbx;
        call window_row_a11y_tree;
        mov r12, rax;                     // r12 = tree_id
        cmp r12, 1;
        jne test_a11y_bind_at_mint_fail_s4;

        // Stage 5: append an 'OK Button' node under the autobound tree.
        mov rdi, r12;
        mov rsi, 0;                       // parent = root
        mov rdx, 2;                       // role = 2/BUTTON
        mov rcx, 0xF00D;                  // label_off stand-in for "OK Button"
        call a11y_tree_append_node;
        mov r13, rax;                     // r13 = node_id
        cmp r13, 1;
        jne test_a11y_bind_at_mint_fail_s5;

        // Stage 6: inspect the label back out via the WEAK STUB.
        mov rdi, r12;
        mov rsi, r13;
        call a11y_node_inspect_STUB;
        mov r10, 0xF00D;
        cmp rax, r10;
        jne test_a11y_bind_at_mint_fail_s6;

        xor rax, rax;
        jmp test_a11y_bind_at_mint_out;

      test_a11y_bind_at_mint_fail_s1:
        mov rax, 1;
        jmp test_a11y_bind_at_mint_out;
      test_a11y_bind_at_mint_fail_s2:
        mov rax, 2;
        jmp test_a11y_bind_at_mint_out;
      test_a11y_bind_at_mint_fail_s3:
        mov rax, 3;
        jmp test_a11y_bind_at_mint_out;
      test_a11y_bind_at_mint_fail_s4:
        mov rax, 4;
        jmp test_a11y_bind_at_mint_out;
      test_a11y_bind_at_mint_fail_s5:
        mov rax, 5;
        jmp test_a11y_bind_at_mint_out;
      test_a11y_bind_at_mint_fail_s6:
        mov rax, 6;

      test_a11y_bind_at_mint_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
