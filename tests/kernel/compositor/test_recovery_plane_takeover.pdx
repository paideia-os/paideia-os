// tests/kernel/compositor/test_recovery_plane_takeover.pdx -- COMP-RC-02
// (Wave NNN)
//
// Functional witness for src/user/compositor/recovery_plane_takeover.pdx
// (module RecoveryPlaneTakeover, Wave0-B7-06 / paideia-os #2270), driven
// against the sibling reservation in recovery_plane_reserve.pdx (module
// RecoveryPlaneReserve, #2269). Exercises recovery_plane_reserve_at_boot
// + recovery_plane_takeover_execute + recovery_plane_takeover_in_progress
// + recovery_plane_takeover_last_event across the five-gate takeover
// order (SECTION 3 of the takeover file).
//
// GAP NOTE vs. the Wave NNN dispatch brief: the brief names a function
// `takeover_on_primary_loss`. No such symbol exists; the real entry point
// is recovery_plane_takeover_execute(reservation_cap_rights, trigger,
// dead_process). This witness calls it with trigger=DEATH_SIGSEGV(3) as
// the "simulate primary loss" event. "assert recovery plane becomes
// primary" has no dedicated getter either -- the module tracks current
// display source in the singleton _recovery_plane_display_source_kind_id
// (pub mut), read directly here via rip-relative lea, mirroring exactly
// how recovery_plane_takeover_execute itself reads the sibling module's
// _recovery_plane_reservation_cell (file header SECTION 2: "this module
// reads from ... by absolute symbol name"). Post-takeover this cell holds
// RESERVATION_HOLDER_KIND(0x1D0), i.e. the input server is now display
// source -- the module's real analogue of "becomes primary".
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based stage
// number that first failed (1..4).
//
// Encoder: paideia-as. cmp not test; no and reg,imm64. One callee-save
// push (rbx = pending return code) leaves rsp%16==0 for every nested
// call. No persistent buffer is needed across calls except the 24-byte
// TakeoverEvent scratch cell declared below, whose address is re-derived
// via `lea` at each use rather than held in a register. Labels prefixed
// trpt_.

module TestRecoveryPlaneTakeover = structure {

  pub let mut _trpt_event_out : [u8; 24] = uninit @align(8)

  pub let test_recovery_plane_takeover_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-RC-02 (Wave NNN): one callee-save push (rbx) leaves rsp%16==0 for every nested call. Stage 1: recovery_plane_takeover_init() + rp_init() clear both singletons; takeover_execute(rights=R_RP_ALL_TAKEOVER=0x007, trigger=DEATH_SIGSEGV=3, dead=0xC0DE) BEFORE any reservation exists is refused TO_WRONG_HOLDER(0xFFFFE9D2) because the reservation cell's holder defaults to 0 != RESERVATION_HOLDER_KIND(0x1D0) -- gate (2) in the takeover file's SECTION 3. Stage 2: reserve_at_boot(0x1D0) succeeds, then takeover_execute WITHOUT RIGHT_TAKEOVER(rights=R_RP_ALL=0x003) is refused TO_NO_RIGHT(0xFFFFE9D1) -- gate (1) fires even though gate (2) would now pass. Stage 3: takeover_execute WITH RIGHT_TAKEOVER (rights=0x007) succeeds TO_OK(0) -- the 'simulate primary loss' event -- and _recovery_plane_display_source_kind_id (read via direct rip-relative lea against the sibling module's pub singleton, same technique the production gate itself uses) becomes RESERVATION_HOLDER_KIND(0x1D0), the 'becomes primary' assertion per file GAP NOTE; takeover_in_progress()==1 confirms the flag armed last per gate (6). Stage 4: last_event(&out) copies the 24-byte TakeoverEvent -- trigger byte (word0[7:0])==3, dead_process (word0[63:32])==0xC0DE, takeover_seq (word1)==1, pre_takeover_recovery_reservation (word2[31:0])==0x1D0; a second takeover_execute is then refused TO_ALREADY_ACTIVE(0xFFFFE9D3) (idempotent guard), and both modules' init functions scrub state before return. Labels prefixed trpt_.",
      block: {
        push rbx;

        // Stage 1: clean slate; takeover before any reservation is
        // refused TO_WRONG_HOLDER (holder cell defaults to 0).
        call recovery_plane_takeover_init;
        call rp_init;

        mov rdi, 0x007;                  // R_RP_ALL_TAKEOVER
        mov rsi, 3;                      // DEATH_SIGSEGV
        mov rdx, 0xC0DE;                 // dead compositor process kind id
        call recovery_plane_takeover_execute;
        mov r10, 0xFFFFE9D2;             // TO_WRONG_HOLDER
        cmp rax, r10;
        jne trpt_fail_s1;

        // Stage 2: reserve properly, then refuse a takeover missing the
        // RIGHT_TAKEOVER bit.
        mov rdi, 0x1D0;                  // RESERVATION_HOLDER_KIND
        call recovery_plane_reserve_at_boot;
        cmp rax, 0;                      // RP_OK
        jne trpt_fail_s2;

        mov rdi, 0x003;                  // R_RP_ALL (no RIGHT_TAKEOVER)
        mov rsi, 3;
        mov rdx, 0xC0DE;
        call recovery_plane_takeover_execute;
        mov r10, 0xFFFFE9D1;             // TO_NO_RIGHT
        cmp rax, r10;
        jne trpt_fail_s2;

        // Stage 3: the real takeover -- "simulate primary loss".
        mov rdi, 0x007;                  // R_RP_ALL_TAKEOVER
        mov rsi, 3;                      // DEATH_SIGSEGV
        mov rdx, 0xC0DE;
        call recovery_plane_takeover_execute;
        cmp rax, 0;                      // TO_OK
        jne trpt_fail_s3;

        lea r11, [rip + _recovery_plane_display_source_kind_id];
        mov rax, [r11];
        mov r10, 0x1D0;
        cmp rax, r10;                    // "becomes primary"
        jne trpt_fail_s3;

        call recovery_plane_takeover_in_progress;
        cmp rax, 1;
        jne trpt_fail_s3;

        // Stage 4: TakeoverEvent round trip, then already-active refusal.
        lea rdi, [rip + _trpt_event_out];
        call recovery_plane_takeover_last_event;
        cmp rax, 1;                      // returned takeover_seq
        jne trpt_fail_s4;

        lea r11, [rip + _trpt_event_out];
        mov rax, [r11 + 0];
        and rax, 0xFF;                   // trigger byte
        cmp rax, 3;                      // DEATH_SIGSEGV
        jne trpt_fail_s4;

        mov rax, [r11 + 0];
        shr rax, 32;                     // dead_compositor_process_kind_id
        mov r10, 0xC0DE;
        cmp rax, r10;
        jne trpt_fail_s4;

        mov rax, [r11 + 8];              // takeover_seq
        cmp rax, 1;
        jne trpt_fail_s4;

        mov rax, [r11 + 16];             // pre_takeover_recovery_reservation
        shl rax, 32;                     // isolate low 32 bits without the
        shr rax, 32;                     // AND-imm32 sign-extension hazard
        mov r10, 0x1D0;
        cmp rax, r10;
        jne trpt_fail_s4;

        mov rdi, 0x007;
        mov rsi, 3;
        mov rdx, 0xC0DE;
        call recovery_plane_takeover_execute;
        mov r10, 0xFFFFE9D3;             // TO_ALREADY_ACTIVE
        cmp rax, r10;
        jne trpt_fail_s4;

        call recovery_plane_takeover_init;
        call rp_init;
        xor rax, rax;
        jmp trpt_out;

      trpt_fail_s1:
        mov rbx, 1;
        jmp trpt_cleanup;
      trpt_fail_s2:
        mov rbx, 2;
        jmp trpt_cleanup;
      trpt_fail_s3:
        mov rbx, 3;
        jmp trpt_cleanup;
      trpt_fail_s4:
        mov rbx, 4;

      trpt_cleanup:
        call recovery_plane_takeover_init;
        call rp_init;
        mov rax, rbx;

      trpt_out:
        pop rbx;
        ret
      }
    }
}
