// tests/kernel/compositor/test_keynav_taborder.pdx -- COMP-IN-02 (Wave LLL)
//
// Functional witness for src/user/compositor/keynav_taborder.pdx
// (module KeynavTaborder, Wave0-B9-10 / paideia-os #2311) layered over
// src/user/a11y/tree_kind.pdx (KIND_A11Y_TREE).
//
// GAP NOTE vs. the Wave LLL dispatch brief: the brief asks for three
// surfaces carrying explicit "taborder" attribute VALUES (5, 2, 8,
// deliberately out of natural order) and expects the Tab cycle to
// visit them in ASCENDING attribute order (2, 5, 8). No such attribute
// exists ANYWHERE in this codebase: the A11yNode record (tree_kind.pdx
// SECTION 3, offsets A11Y_NODE_OFF_*) has exactly four fields --
// id/role, parent/first_child, next_sibling/state, label_offset/
// value_offset -- and there is no tab-index / tab-weight slot. This is
// not an oversight: keynav_taborder.pdx file header SECTION 0
// ("A11Y-FIRST TAB-ORDER") explicitly REJECTS a separate tab-index
// chain as a POSIX-toolkit anti-pattern ("two independent 'focusable
// widget' registries... a class of bugs no toolkit has eliminated").
// Tab order in this module is 100% DERIVED from the a11y tree's DFS
// pre-order walk (keynav_taborder_dfs_next / _prev); there is no
// weight to sort by and no plausible field to stub a fake one onto
// without contradicting the module's documented design commitment.
//
// This witness therefore does NOT introduce a weighted-order stub (a
// fake "sort by attribute" primitive would misrepresent working
// functionality that does not exist). Instead it (a) stores the
// brief's three requested weights (5, 2, 8) into the REAL label_offset
// field purely so a reader/disassembly can see which node the brief
// intended -- label_offset is NOT read or interpreted as an ordering
// key by keynav_taborder anywhere -- and (b) proves the module's REAL,
// documented contract: DFS pre-order over the (prepend-ordered) child
// chain. Appending in requested-weight order 5, 2, 8 assigns node_id
// 1/2/3 and DFS-visits them 3, 2, 1 (last-appended first, per
// tree_kind.pdx's CHILD-CHAIN ORDER note) -- i.e. label sequence
// (8, 2, 5). That sequence is neither the brief's requested ascending
// order (2, 5, 8) nor raw insertion order (5, 2, 8): it is the
// module's real, structural, weight-blind behaviour, verified exactly.
//
// FOLLOW-UP: a genuine weighted-taborder feature needs a new landing
// that (1) adds a taborder-weight field to the A11yNode record (or a
// parallel sort table) in tree_kind.pdx, and (2) adds a
// keynav_taborder_next_by_weight variant that scans/sorts on it
// instead of walking DFS order. Tracked here as a design gap, not
// implemented speculatively.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..8).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. Three callee-
// save pushes (rbx = tree_id, r12/r13 reserved scratch) leave
// rsp%16==0 for every nested call (entry rsp%16==8, three 8-byte
// pushes -> 32, %16==0).

module TestKeynavTaborder = structure {

  pub let mut _tkto_cursor : [u64; 2] = uninit @align(64)

  pub let test_keynav_taborder_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-02 (Wave LLL): three callee-save pushes (rbx=tree_id, r12/r13 reserved scratch) leave rsp%16==0 for every nested call (entry rsp%16==8, three 8-byte pushes -> 32, %16==0). Stage 1: a11y_tree_init(). Stage 2: a11y_tree_mint(window=502) -> tree_id < A11Y_MAX(4), kept in rbx. Stages 3-5: append_node(tree_id, parent=0, role=2/BUTTON, label=5/2/8) in that literal order (mirroring the brief's requested weights, stored inertly in label_offset) -> node_id 1/2/3. Stage 6: keynav_taborder_init -> current==3 (DFS-first, i.e. label 8 -- the LAST-appended child, per the prepend child-chain). Stages 7-8: two next() calls return 2 (label 2), then 1 (label 5) -- the module's real DFS order (8, 2, 5), which is neither the brief's requested (2, 5, 8) nor plain insertion order (5, 2, 8). This is the documented proof of the gap noted in the file header; no weighted-order stub is introduced (see GAP NOTE). Labels prefixed test_keynav_taborder_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Stage 1: reset the a11y tree pool.
        call a11y_tree_init;

        // Stage 2: mint a fresh a11y tree for window 502.
        mov rdi, 502;
        call a11y_tree_mint;
        mov rbx, rax;                     // rbx = tree_id
        mov r10, 4;
        cmp rbx, r10;
        jae test_keynav_taborder_fail_s2;

        // Stage 3: append node carrying "taborder=5" (inert label_off)
        // -> node_id 1.
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 5;
        call a11y_tree_append_node;
        cmp rax, 1;
        jne test_keynav_taborder_fail_s3;

        // Stage 4: append node carrying "taborder=2" -> node_id 2.
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 2;
        call a11y_tree_append_node;
        cmp rax, 2;
        jne test_keynav_taborder_fail_s4;

        // Stage 5: append node carrying "taborder=8" -> node_id 3.
        mov rdi, rbx;
        mov rsi, 0;
        mov rdx, 2;
        mov rcx, 8;
        call a11y_tree_append_node;
        cmp rax, 3;
        jne test_keynav_taborder_fail_s5;

        // Stage 6: init cursor -> current == 3 (DFS-first: the node
        // carrying "taborder=8", NOT the smallest weight).
        lea rdi, [rip + _tkto_cursor];
        mov rsi, rbx;
        call keynav_taborder_init;
        cmp rax, 0;
        jne test_keynav_taborder_fail_s6;

        lea rdi, [rip + _tkto_cursor];
        call keynav_taborder_cursor_current;
        cmp rax, 3;
        jne test_keynav_taborder_fail_s6;

        // Stage 7: next() -> 2 (node carrying "taborder=2").
        lea rdi, [rip + _tkto_cursor];
        call keynav_taborder_next;
        cmp rax, 2;
        jne test_keynav_taborder_fail_s7;

        // Stage 8: next() -> 1 (node carrying "taborder=5"). Real
        // visit-order sequence is (8, 2, 5) -- confirms the module is
        // structural/DFS-driven, NOT weight-sorted (brief wanted
        // 2, 5, 8).
        lea rdi, [rip + _tkto_cursor];
        call keynav_taborder_next;
        cmp rax, 1;
        jne test_keynav_taborder_fail_s8;

        xor rax, rax;
        jmp test_keynav_taborder_out;

      test_keynav_taborder_fail_s2:
        mov rax, 2;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s3:
        mov rax, 3;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s4:
        mov rax, 4;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s5:
        mov rax, 5;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s6:
        mov rax, 6;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s7:
        mov rax, 7;
        jmp test_keynav_taborder_out;
      test_keynav_taborder_fail_s8:
        mov rax, 8;

      test_keynav_taborder_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
