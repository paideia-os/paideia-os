// tests/kernel/compositor/test_dnd_offer.pdx -- COMP-IN-04 (Wave LLL)
//
// Functional witness for src/user/compositor/dnd_offer.pdx (module
// DndOffer, Wave0-B7-04 / paideia-os #2267). Exercises dnd_offer_mint +
// dnd_offer_update_target + dnd_offer_accept + dnd_offer_reject across
// two independent offers.
//
// GAP NOTE vs. the Wave LLL dispatch brief: the brief asks for a
// `dnd_offer_start(source, target, mime)` entry point and a single
// `state` field taking the literal values DND_ACCEPTED / DND_REJECTED.
// Neither exists. The real mint entry point is dnd_offer_mint(source_
// win, mime_types_ptr, mime_type_count, data_kind_id, serial) (target
// starts unset at 0 and is populated later by the compositor via
// dnd_offer_update_target on pointer motion -- file header SECTION 0
// step 1-2), and there is no packed "state" field: acceptance is
// tracked by accepted_mime_offset (DND_ACCEPT_NONE == "not accepted",
// any other value == "accepted at that MIME index"), independently of
// revocation_seq (bumped by both dnd_offer_reject AND dnd_offer_
// revoke). The local aliases below are WEAK STUBS naming the brief's
// two states in terms of the REAL two-observable pair the module
// actually exposes: DND_ACCEPTED_STUB == dnd_offer_is_accepted()==1;
// DND_REJECTED_STUB == dnd_offer_is_accepted()==0 AND
// dnd_offer_row_rev_seq() > 0 (the reject-specific bump that
// distinguishes 'rejected' from 'never touched'). No functional gap
// otherwise -- this mapping is exact, not an approximation.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..10).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. Three callee-
// save pushes (rbx = offer-A row_id, r12 = offer-B row_id, r13
// reserved) leave rsp%16==0 for every nested call (entry rsp%16==8,
// three 8-byte pushes -> 32, %16==0).

module TestDndOffer = structure {

  // WEAK STUBS: named aliases for the brief's nonexistent DND_ACCEPTED
  // / DND_REJECTED state constants (see GAP NOTE above). These are not
  // read by dnd_offer.pdx; they document the (is_accepted, rev_seq)
  // predicate pair this witness checks directly.
  pub let DND_ACCEPTED_STUB : u64 = 1
  pub let DND_REJECTED_STUB : u64 = 0

  pub let dnd_test_mime_str : [u8; 11] = "text/plain\0"

  pub let test_dnd_offer_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IN-04 (Wave LLL): three callee-save pushes (rbx=offer-A row_id, r12=offer-B row_id, r13 reserved) leave rsp%16==0 for every nested call. Stage 1: dnd_offer_init() (clean pool). Stage 2: mint offer A (source=10, mime_ptr=&dnd_test_mime_str, mime_count=1, data_kind_id=42, serial=777) -> row 0. Stage 3: update_target(A, target=20, x=100, y=200) -> 0. Stage 4: accept(A, mime_offset=0) -> 0. Stage 5: is_accepted(A)==1 == DND_ACCEPTED_STUB; accepted_mime_offset(A)==0. Stage 6: mint offer B (source=11, data_kind_id=43, serial=778) -> row 1 (pool low-first scan, row 0 still in use). Stage 7: update_target(B, target=21, x=50, y=60) -> 0; rev_seq(B)==0 before reject. Stage 8: reject(B) -> 0. Stage 9: is_accepted(B)==0 == DND_REJECTED_STUB half; accepted_mime_offset(B) still DND_ACCEPT_NONE(0xFFFFFFFF). Stage 10: rev_seq(B)==1 (bumped by reject) -- the other DND_REJECTED_STUB half, distinguishing 'rejected' from 'never touched'. Labels prefixed test_dnd_offer_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Stage 1: reset the offer pool.
        call dnd_offer_init;

        // Stage 2: mint offer A.
        mov rdi, 10;                      // source_win
        lea rsi, [rip + dnd_test_mime_str]; // mime_types_ptr
        mov rdx, 1;                       // mime_type_count
        mov rcx, 42;                      // data_kind_id
        mov r8, 777;                      // serial
        call dnd_offer_mint;
        mov rbx, rax;                     // rbx = offer A row_id
        cmp rbx, 0;
        jne test_dnd_offer_fail_s2;

        // Stage 3: pointer moves onto target window 20.
        mov rdi, rbx;
        mov rsi, 20;
        mov rdx, 100;
        mov rcx, 200;
        call dnd_offer_update_target;
        cmp rax, 0;
        jne test_dnd_offer_fail_s3;

        // Stage 4: target accepts MIME index 0.
        mov rdi, rbx;
        mov rsi, 0;
        call dnd_offer_accept;
        cmp rax, 0;
        jne test_dnd_offer_fail_s4;

        // Stage 5: DND_ACCEPTED_STUB check.
        mov rdi, rbx;
        call dnd_offer_is_accepted;
        cmp rax, 1;
        jne test_dnd_offer_fail_s5;
        mov rdi, rbx;
        call dnd_offer_row_accepted_mime_offset;
        cmp rax, 0;
        jne test_dnd_offer_fail_s5;

        // Stage 6: mint offer B on a second row.
        mov rdi, 11;
        lea rsi, [rip + dnd_test_mime_str];
        mov rdx, 1;
        mov rcx, 43;
        mov r8, 778;
        call dnd_offer_mint;
        mov r12, rax;                     // r12 = offer B row_id
        cmp r12, 1;
        jne test_dnd_offer_fail_s6;

        // Stage 7: pointer moves onto target window 21; rev_seq starts 0.
        mov rdi, r12;
        mov rsi, 21;
        mov rdx, 50;
        mov rcx, 60;
        call dnd_offer_update_target;
        cmp rax, 0;
        jne test_dnd_offer_fail_s7;
        mov rdi, r12;
        call dnd_offer_row_rev_seq;
        cmp rax, 0;
        jne test_dnd_offer_fail_s7;

        // Stage 8: target rejects the drop.
        mov rdi, r12;
        call dnd_offer_reject;
        cmp rax, 0;
        jne test_dnd_offer_fail_s8;

        // Stage 9: DND_REJECTED_STUB check, half 1 (not accepted).
        mov rdi, r12;
        call dnd_offer_is_accepted;
        cmp rax, 0;
        jne test_dnd_offer_fail_s9;
        mov rdi, r12;
        call dnd_offer_row_accepted_mime_offset;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        jne test_dnd_offer_fail_s9;

        // Stage 10: DND_REJECTED_STUB check, half 2 (rev_seq bumped).
        mov rdi, r12;
        call dnd_offer_row_rev_seq;
        cmp rax, 1;
        jne test_dnd_offer_fail_s10;

        xor rax, rax;
        jmp test_dnd_offer_out;

      test_dnd_offer_fail_s2:
        mov rax, 2;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s3:
        mov rax, 3;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s4:
        mov rax, 4;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s5:
        mov rax, 5;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s6:
        mov rax, 6;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s7:
        mov rax, 7;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s8:
        mov rax, 8;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s9:
        mov rax, 9;
        jmp test_dnd_offer_out;
      test_dnd_offer_fail_s10:
        mov rax, 10;

      test_dnd_offer_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
