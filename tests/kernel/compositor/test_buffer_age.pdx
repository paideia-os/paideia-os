// tests/kernel/compositor/test_buffer_age.pdx -- COMP-PF-04 (Wave MMM)
//
// Functional witness for src/user/compositor/buffer_age.pdx (module
// BufferAge, Wave0-B10-05 / paideia-os #2295). Exercises
// buffer_age_ring_init + buffer_age_reset + buffer_age_push +
// buffer_age_count + buffer_age_head across the ring's fill and
// overwrite phases.
//
// GAP NOTE vs. the Wave MMM dispatch brief: the brief names
// `buffer_age_tick()` and describes an unbounded counter that wraps
// from 0xFFFFFFFF back to 0. Neither exists in buffer_age.pdx. The
// real primitive is buffer_age_push(row_id, damage_region_id,
// frame_num), and the ring is capped at BA_HISTORY_MAX(8) live
// entries (module SECTION 2): count never exceeds 8, and once it
// reaches 8 a further push does not grow or wrap a counter -- it
// overwrites the OLDEST slot and advances head_index modulo 8
// (module SECTION 2 "RING SEMANTICS"). This witness exercises the
// module's real wraparound shape (head advances mod 8 once the ring
// is full) as the closest verifiable analogue of the brief's "wrap at
// max -> back to 0" request.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..6).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. One callee-save
// push (rbx = row_id) gives rsp%16==0 for every nested call. Pushes
// are unrolled (nine `call buffer_age_push` sites) rather than using
// an asm loop, both for clarity and to sidestep the paideia-as `loop`
// reserved-label pitfall entirely.

module TestBufferAge = structure {

  pub let test_buffer_age_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-PF-04 (Wave MMM): one callee-save push (rbx=row_id) leaves rsp%16==0 for every nested call. Stage 1: ring_init(surface=77) -> row_id (success iff < BA_MAX(32); sentinels are 0xFFFFEC5x, far above 32). Stage 2: reset(row_id) -> BA_OK(0) (no-op on a fresh row, exercised anyway for API coverage). Stage 3: five pushes (frame_num 1..5, arbitrary distinct damage_region_id values) then count(row_id) == 5. Stage 4: three more pushes (6..8, total 8 == BA_HISTORY_MAX) then count == 8 and head still 0 (count-growth phase never moves head per module SECTION 2). Stage 5: one more push (9th) crosses into the overwrite branch: count stays 8 (module's real analogue of the brief's 'wrap' -- there is no counter reset to 0). Stage 6: head(row_id) == 1, confirming the ring pointer advanced by exactly one slot on the overwrite push. Labels prefixed test_buffer_age_.",
      block: {
        push rbx;

        // Stage 1: ring_init(surface=77) -> row_id.
        mov rdi, 77;
        call buffer_age_ring_init;
        mov rbx, rax;
        mov r10, 32;
        cmp rbx, r10;
        jae test_buffer_age_fail_s1;

        // Stage 2: reset(row_id) -> BA_OK.
        mov rdi, rbx;
        call buffer_age_reset;
        cmp rax, 0;
        jne test_buffer_age_fail_s2;

        // Stage 3: five pushes, then count == 5.
        mov rdi, rbx;
        mov rsi, 1;
        mov rdx, 1;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s3;

        mov rdi, rbx;
        mov rsi, 2;
        mov rdx, 2;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s3;

        mov rdi, rbx;
        mov rsi, 3;
        mov rdx, 3;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s3;

        mov rdi, rbx;
        mov rsi, 4;
        mov rdx, 4;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s3;

        mov rdi, rbx;
        mov rsi, 5;
        mov rdx, 5;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s3;

        mov rdi, rbx;
        call buffer_age_count;
        cmp rax, 5;
        jne test_buffer_age_fail_s3;

        // Stage 4: three more pushes (total 8), count == 8, head still 0.
        mov rdi, rbx;
        mov rsi, 6;
        mov rdx, 6;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s4;

        mov rdi, rbx;
        mov rsi, 7;
        mov rdx, 7;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s4;

        mov rdi, rbx;
        mov rsi, 8;
        mov rdx, 8;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s4;

        mov rdi, rbx;
        call buffer_age_count;
        cmp rax, 8;
        jne test_buffer_age_fail_s4;

        mov rdi, rbx;
        call buffer_age_head;
        cmp rax, 0;
        jne test_buffer_age_fail_s4;

        // Stage 5: ninth push overwrites the oldest slot; count stays 8
        // (no counter wrap to 0 in the real module -- see gap note).
        mov rdi, rbx;
        mov rsi, 9;
        mov rdx, 9;
        call buffer_age_push;
        cmp rax, 0;
        jne test_buffer_age_fail_s5;

        mov rdi, rbx;
        call buffer_age_count;
        cmp rax, 8;
        jne test_buffer_age_fail_s5;

        // Stage 6: head advanced to 1 (module's real wraparound shape).
        mov rdi, rbx;
        call buffer_age_head;
        cmp rax, 1;
        jne test_buffer_age_fail_s6;

        xor rax, rax;
        jmp test_buffer_age_out;

      test_buffer_age_fail_s1:
        mov rax, 1;
        jmp test_buffer_age_out;
      test_buffer_age_fail_s2:
        mov rax, 2;
        jmp test_buffer_age_out;
      test_buffer_age_fail_s3:
        mov rax, 3;
        jmp test_buffer_age_out;
      test_buffer_age_fail_s4:
        mov rax, 4;
        jmp test_buffer_age_out;
      test_buffer_age_fail_s5:
        mov rax, 5;
        jmp test_buffer_age_out;
      test_buffer_age_fail_s6:
        mov rax, 6;

      test_buffer_age_out:
        pop rbx;
        ret
      }
    }
}
