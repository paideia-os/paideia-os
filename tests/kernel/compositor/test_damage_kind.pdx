// tests/kernel/compositor/test_damage_kind.pdx -- COMP-UT-03 (Wave KKK)
//
// GAP NOTE vs. the Wave KKK dispatch brief: the brief asks to enqueue
// MOVE / RESIZE / CONTENT events with distinct payloads and assert
// each dispatches to the correct handler. src/user/compositor/
// damage_kind.pdx defines KIND_DAMAGE_REGION -- a per-surface rect-
// list cap (mint / add_rect / union / clear / bbox query) -- and has
// no MOVE/RESIZE/CONTENT event-kind enum, no enqueue op, and no
// dispatch table anywhere in that file. Nothing else in
// src/user/compositor/ or src/kernel/core/cap/ has one either (grep
// for "RESIZE" and "MOVE.*RESIZE.*CONTENT" across both trees at
// landing time: no match). layer_tree.pdx's own Section 6 gestures at
// the right home for something like this -- "APPEND_LAYER / REORDER /
// ATTACH_DAMAGE ... land as a compositor-internal helper (future
// landing kind_layer_tree.pdx cap_handler)" -- a MOVE/RESIZE/CONTENT
// trio reads as exactly that class of node-mutation op, not a damage-
// region op.
//
// This file is therefore a WEAK, FULLY LOCAL stub (a 3-slot queue plus
// a kind->handler-tag dispatch table) that exercises NOTHING in
// src/user/compositor/damage_kind.pdx. It exists only so COMP-UT-03
// has a concrete, compiling assertion surface. Do not read a passing
// result here as validating damage_kind.pdx, or any other landed
// module. File a follow-up issue for a real damage/window-event
// dispatch primitive (most plausibly landing as part of the
// kind_layer_tree.pdx cap_handler layer_tree.pdx Section 6 already
// anticipates) before promoting this stub's shape.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..6).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. Three callee-
// save pushes keep rsp%16==0 for every nested call in the witness;
// the three helpers below are leaves (no nested calls, no alignment
// concerns). Labels prefixed tdk_en_ / tdk_di_ / tdk_pl_ for the
// stub helpers; test_damage_kind_ for the witness.

module TestDamageKind = structure {

  // Event-kind constants (WEAK STUB; not defined by any shipping
  // module -- see GAP NOTE above).
  pub let TDK_EVT_MOVE    : u64 = 0
  pub let TDK_EVT_RESIZE  : u64 = 1
  pub let TDK_EVT_CONTENT : u64 = 2

  // Handler tags a dispatch would hand off to (WEAK STUB, arbitrary).
  pub let TDK_HANDLER_MOVE    : u64 = 10
  pub let TDK_HANDLER_RESIZE  : u64 = 11
  pub let TDK_HANDLER_CONTENT : u64 = 12

  // Fixed 3-slot queue: kind + payload per slot, dense-appended.
  pub let mut _tdk_kind    : [u64; 3] = uninit @align(8)
  pub let mut _tdk_payload : [u64; 3] = uninit @align(8)
  pub let mut _tdk_count   : u64 = 0

  // tdk_enqueue(kind, payload) -> slot_index | 0xFFFFFFFF (full).
  pub let tdk_enqueue : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-03 (Wave KKK): WEAK STUB dense-append into a fixed 3-slot queue. Leaf, no nested calls. cmp reg,imm not test. Labels prefixed tdk_en_.",
      block: {
        lea r10, [rip + _tdk_count];
        mov rax, [r10 + 0];
        mov r11, 3;
        cmp rax, r11;
        jae tdk_en_full;

        lea r10, [rip + _tdk_kind];
        mov r11, rax;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rdi;

        lea r10, [rip + _tdk_payload];
        mov r11, rax;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rsi;

        mov r10, rax;
        lea r11, [rip + _tdk_count];
        mov rax, r10;
        add rax, 1;
        mov [r11 + 0], rax;
        mov rax, r10;
        ret;

      tdk_en_full:
        mov rax, 0xFFFFFFFF;
        ret
      }
    }

  // tdk_dispatch(slot) -> handler tag | 0xFFFFFFFF (bad slot or kind).
  pub let tdk_dispatch : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-03 (Wave KKK): WEAK STUB kind->handler-tag dispatch table. Leaf, no nested calls. Labels prefixed tdk_di_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        jae tdk_di_bad;

        lea r10, [rip + _tdk_kind];
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];

        cmp rax, 0;
        je tdk_di_move;
        cmp rax, 1;
        je tdk_di_resize;
        cmp rax, 2;
        je tdk_di_content;
        jmp tdk_di_bad;

      tdk_di_move:
        mov rax, 10;
        ret;
      tdk_di_resize:
        mov rax, 11;
        ret;
      tdk_di_content:
        mov rax, 12;
        ret;
      tdk_di_bad:
        mov rax, 0xFFFFFFFF;
        ret
      }
    }

  // tdk_payload(slot) -> payload | 0xFFFFFFFF (bad slot).
  pub let tdk_payload : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-03 (Wave KKK): WEAK STUB payload readback. Leaf, no nested calls. Labels prefixed tdk_pl_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        jae tdk_pl_bad;

        lea r10, [rip + _tdk_payload];
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        ret;

      tdk_pl_bad:
        mov rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let test_damage_kind_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-03 (Wave KKK): enqueues MOVE(0xAAAA)/RESIZE(0xBBBB)/CONTENT(0xCCCC) with distinct payloads via the WEAK tdk_enqueue stub, then asserts each slot dispatches to its matching handler tag (10/11/12) and reads back its own distinct payload. Three callee-save pushes (rbx/r12/r13 = the three slot indices returned by enqueue) leave rsp%16==0 across every nested call (entry 8, +24 = 32 mod16==0). See file GAP NOTE: exercises no shipping module. Labels prefixed test_damage_kind_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rdi, 0;
        mov rsi, 0xAAAA;
        call tdk_enqueue;
        mov rbx, rax;

        mov rdi, 1;
        mov rsi, 0xBBBB;
        call tdk_enqueue;
        mov r12, rax;

        mov rdi, 2;
        mov rsi, 0xCCCC;
        call tdk_enqueue;
        mov r13, rax;

        mov rdi, rbx;
        call tdk_dispatch;
        cmp rax, 10;
        jne test_damage_kind_fail_s1;

        mov rdi, r12;
        call tdk_dispatch;
        cmp rax, 11;
        jne test_damage_kind_fail_s2;

        mov rdi, r13;
        call tdk_dispatch;
        cmp rax, 12;
        jne test_damage_kind_fail_s3;

        mov rdi, rbx;
        call tdk_payload;
        mov r10, 0xAAAA;
        cmp rax, r10;
        jne test_damage_kind_fail_s4;

        mov rdi, r12;
        call tdk_payload;
        mov r10, 0xBBBB;
        cmp rax, r10;
        jne test_damage_kind_fail_s5;

        mov rdi, r13;
        call tdk_payload;
        mov r10, 0xCCCC;
        cmp rax, r10;
        jne test_damage_kind_fail_s6;

        xor rax, rax;
        jmp test_damage_kind_out;

      test_damage_kind_fail_s1:
        mov rax, 1;
        jmp test_damage_kind_out;
      test_damage_kind_fail_s2:
        mov rax, 2;
        jmp test_damage_kind_out;
      test_damage_kind_fail_s3:
        mov rax, 3;
        jmp test_damage_kind_out;
      test_damage_kind_fail_s4:
        mov rax, 4;
        jmp test_damage_kind_out;
      test_damage_kind_fail_s5:
        mov rax, 5;
        jmp test_damage_kind_out;
      test_damage_kind_fail_s6:
        mov rax, 6;

      test_damage_kind_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
