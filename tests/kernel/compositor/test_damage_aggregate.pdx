// tests/kernel/compositor/test_damage_aggregate.pdx -- COMP-UT-02 (Wave KKK)
//
// Functional witness for src/user/compositor/damage_aggregate.pdx
// (module DamageAggregate, Wave0-B11-03 / paideia-os #2296). Builds a
// real KIND_LAYER_TREE row (five leaf layers under one root, each
// carrying one of five overlapping damage rects) and asserts that
// damage_aggregate_from_tree folds them into a single coalesced
// KIND_DAMAGE_REGION bbox.
//
// GAP NOTE vs. the Wave KKK dispatch brief: the brief names
// `damage_aggregate_flush()`. No function of that name exists in
// damage_aggregate.pdx or damage_kind.pdx. The real analogue is
// damage_aggregate_from_tree(layer_tree_row_id) -> damage_region_row_id
// (damage_aggregate.pdx Section 5): it runs layer_tree.pdx's reverse-
// order aggregation pass over a tree's nodes, then mints a fresh
// KIND_DAMAGE_REGION whose bbox is the root's coalesced extent. There
// is no standalone "flush" step because the fold + mint happen inside
// one call; the "1 aggregate rect" the brief asks for is exactly that
// region's bbox, read back via damage_kind.pdx's real
// damage_region_bbox_x/y/w/h getters.
//
// A second, smaller gap: layer_tree.pdx has no mint body yet (see
// test_layer_tree.pdx's COMP-UT-01 GAP NOTE for the fuller
// discussion), so this witness hand-stamps the tree's arena directly
// against the module's own documented header/node layout (Sections 3,
// 4.1, 4.2) rather than calling a shipping mint -- there isn't one.
// Every subsequent call (damage_aggregate_from_tree,
// damage_region_bbox_*) IS the real shipping code path.
//
// The five rects -- (0,0,100,100), (50,50,100,100), (25,25,50,50),
// (75,75,50,50), (0,0,200,200) -- all lie inside (0,0)-(200,200), and
// the last one alone already covers that full extent, so their union
// is (0,0,200,200) regardless of fold order.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..4).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]; three callee-
// save pushes keep rsp%16==0 for every nested call.

module TestDamageAggregate = structure {

  pub let test_damage_aggregate_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-02 (Wave KKK): mints a real KIND_LAYER_TREE row (lt_row_alloc/lt_pack_hdr_row/lt_pack_arena_ref/lt_arena_base), hand-stamps a 6-node arena (root at index 0, five leaf children at indices 1..5, each parent_index=0 < i satisfying the topological invariant layer_tree_aggregate_damage requires, each carrying one of the five overlapping damage rects as its own bbox and chained via next_sibling), then calls the REAL damage_aggregate_from_tree and asserts the minted KIND_DAMAGE_REGION's bbox is the (0,0,200,200) union via the REAL damage_region_bbox_x/y/w/h getters. Three callee-save pushes (r12=hdr/arena_ref/arena_base scratch, r13=row_id, r14=damage-region row_id) leave rsp%16==0 across every nested call (entry 8, +24 pushes = 32, mod16==0). Labels prefixed test_damage_aggregate_.",
      block: {
        push r12;
        push r13;
        push r14;

        // hdr = lt_pack_hdr_row(1, 1); arena_ref = lt_pack_arena_ref(0).
        mov rdi, 1;
        mov rsi, 1;
        call lt_pack_hdr_row;
        mov r12, rax;

        mov rdi, 0;
        call lt_pack_arena_ref;
        mov r13, rax;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0;
        call lt_row_alloc;
        mov r13, rax;                   // row_id

        mov r10, 4;
        cmp r13, r10;
        jae test_damage_aggregate_fail_s1;

        mov rdi, r13;
        call lt_arena_base;
        cmp rax, 0;
        je  test_damage_aggregate_fail_s1;
        mov r12, rax;                    // arena_base

        // ---- header: node_count=6, root_index=0 ----
        mov rax, 6;
        mov [r12 + 0], rax;

        mov rax, 0x1C1;
        mov r10, 1;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 8], rax;

        xor rax, rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;

        // ---- root (idx0, +32): lkid=1, parent=NONE, first_child=1 ----
        mov rax, 1;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 32], rax;

        mov rax, 0xFFFFFFFF;
        mov r10, 1;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 40], rax;

        xor rax, rax;
        mov [r12 + 48], rax;
        mov [r12 + 56], rax;
        mov [r12 + 64], rax;

        // ---- child1 (idx1, +80): lkid=10, next_sib=2, bbox=(0,0,100,100) ----
        mov rax, 10;
        mov [r12 + 80], rax;

        mov rax, 2;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 88], rax;

        xor rax, rax;
        mov [r12 + 96], rax;

        mov rax, 100;
        mov r10, 100;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 104], rax;

        xor rax, rax;
        mov [r12 + 112], rax;

        // ---- child2 (idx2, +128): lkid=11, next_sib=3, bbox=(50,50,100,100) ----
        mov rax, 11;
        mov [r12 + 128], rax;

        mov rax, 3;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 136], rax;

        mov rax, 50;
        mov r10, 50;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 144], rax;

        mov rax, 100;
        mov r10, 100;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 152], rax;

        xor rax, rax;
        mov [r12 + 160], rax;

        // ---- child3 (idx3, +176): lkid=12, next_sib=4, bbox=(25,25,50,50) ----
        mov rax, 12;
        mov [r12 + 176], rax;

        mov rax, 4;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 184], rax;

        mov rax, 25;
        mov r10, 25;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 192], rax;

        mov rax, 50;
        mov r10, 50;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 200], rax;

        xor rax, rax;
        mov [r12 + 208], rax;

        // ---- child4 (idx4, +224): lkid=13, next_sib=5, bbox=(75,75,50,50) ----
        mov rax, 13;
        mov [r12 + 224], rax;

        mov rax, 5;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 232], rax;

        mov rax, 75;
        mov r10, 75;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 240], rax;

        mov rax, 50;
        mov r10, 50;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 248], rax;

        xor rax, rax;
        mov [r12 + 256], rax;

        // ---- child5 (idx5, +272): lkid=14, no siblings, bbox=(0,0,200,200) ----
        mov rax, 14;
        mov [r12 + 272], rax;

        mov rax, 0xFFFFFFFF;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 280], rax;

        xor rax, rax;
        mov [r12 + 288], rax;

        mov rax, 200;
        mov r10, 200;
        shl r10, 32;
        or  rax, r10;
        mov [r12 + 296], rax;

        xor rax, rax;
        mov [r12 + 304], rax;

        // ---- aggregate + mint (the REAL shipping call) ----
        mov rdi, r13;
        call damage_aggregate_from_tree;
        mov r14, rax;

        mov r10, 32;
        cmp r14, r10;
        jae test_damage_aggregate_fail_s2;

        // ---- assert bbox == (0,0,200,200) ----
        mov rdi, r14;
        call damage_region_bbox_x;
        cmp rax, 0;
        jne test_damage_aggregate_fail_s3;

        mov rdi, r14;
        call damage_region_bbox_y;
        cmp rax, 0;
        jne test_damage_aggregate_fail_s3;

        mov rdi, r14;
        call damage_region_bbox_w;
        cmp rax, 200;
        jne test_damage_aggregate_fail_s4;

        mov rdi, r14;
        call damage_region_bbox_h;
        cmp rax, 200;
        jne test_damage_aggregate_fail_s4;

        xor rax, rax;
        jmp test_damage_aggregate_out;

      test_damage_aggregate_fail_s1:
        mov rax, 1;
        jmp test_damage_aggregate_out;
      test_damage_aggregate_fail_s2:
        mov rax, 2;
        jmp test_damage_aggregate_out;
      test_damage_aggregate_fail_s3:
        mov rax, 3;
        jmp test_damage_aggregate_out;
      test_damage_aggregate_fail_s4:
        mov rax, 4;

      test_damage_aggregate_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
