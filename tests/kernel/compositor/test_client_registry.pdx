// tests/kernel/compositor/test_client_registry.pdx -- COMP-RC-05
// (Wave NNN)
//
// Functional witness for src/user/compositor/client_registry.pdx
// (module ClientRegistry, R113.M6-027 / paideia-os #2407). Exercises
// client_registry_init + compositor_register_client +
// compositor_client_caps across the duplicate-refusal, bad-arg,
// fill-to-capacity and miss paths.
//
// No GAP vs. the Wave NNN dispatch brief here: register_client(app_id=
// 101) then register_client(app_id=101) again -> REFUSED_DUPLICATE maps
// directly onto compositor_register_client's real CLIENT_REGISTRY_DUP
// (0xFFFFE151) sentinel (module SECTION 3: "a client registers once; a
// second call is a caller bug, not silently accepted").
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based stage
// number that first failed (1..5).
//
// Encoder: paideia-as. cmp not test; no and reg,imm64. One callee-save
// push (rbx = pending return code) leaves rsp%16==0 -- every function
// under test here is a pure leaf (no nested call), so alignment only
// matters at THIS witness's own call sites. The seven-slot fill in
// stage 4 is unrolled (mirrors test_buffer_age's nine-push unroll)
// rather than an asm loop, sidestepping the paideia-as `loop` reserved-
// label pitfall entirely. Labels prefixed tcr_.

module TestClientRegistry = structure {

  pub let test_client_registry_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-RC-05 (Wave NNN): one callee-save push (rbx) leaves rsp%16==0 for every nested call. Stage 1: init() clears the table; register_client(101, 0xABCD) -> slot 0 (first free row in a fresh table); client_caps(101) == 0xABCD confirms the row. Stage 2: register_client(101, 0x1111) again is refused CLIENT_REGISTRY_DUP(0xFFFFE151) -- the task's REFUSED_DUPLICATE. Stage 3: register_client(0, 0x1) is refused CLIENT_REGISTRY_BAD_ARG(0xFFFFE152). Stage 4: seven more registrations (app_id 102..108, table capacity CLIENT_REGISTRY_MAX=8) fill every remaining slot 1..7 in order (unrolled, no asm loop); a ninth registration (109) on the now-full table is refused CLIENT_REGISTRY_FULL(0xFFFFE150). Stage 5: client_caps(999) (never registered) returns CLIENT_REGISTRY_MISS (all-ones); init() then scrubs the table and client_caps(101) also returns MISS, confirming the scrub. Labels prefixed tcr_.",
      block: {
        push rbx;

        // Stage 1: first registration, slot 0, caps round-trip.
        call client_registry_init;

        mov rdi, 101;
        mov rsi, 0xABCD;
        call compositor_register_client;
        cmp rax, 0;
        jne tcr_fail_s1;

        mov rdi, 101;
        call compositor_client_caps;
        mov r10, 0xABCD;
        cmp rax, r10;
        jne tcr_fail_s1;

        // Stage 2: duplicate app_id refused.
        mov rdi, 101;
        mov rsi, 0x1111;
        call compositor_register_client;
        mov r10, 0xFFFFE151;             // CLIENT_REGISTRY_DUP
        cmp rax, r10;
        jne tcr_fail_s2;

        // Stage 3: app_id == 0 refused.
        mov rdi, 0;
        mov rsi, 1;
        call compositor_register_client;
        mov r10, 0xFFFFE152;             // CLIENT_REGISTRY_BAD_ARG
        cmp rax, r10;
        jne tcr_fail_s3;

        // Stage 4: fill slots 1..7, then refuse the ninth registration.
        mov rdi, 102;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 1;
        jne tcr_fail_s4;

        mov rdi, 103;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 2;
        jne tcr_fail_s4;

        mov rdi, 104;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 3;
        jne tcr_fail_s4;

        mov rdi, 105;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 4;
        jne tcr_fail_s4;

        mov rdi, 106;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 5;
        jne tcr_fail_s4;

        mov rdi, 107;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 6;
        jne tcr_fail_s4;

        mov rdi, 108;
        mov rsi, 1;
        call compositor_register_client;
        cmp rax, 7;
        jne tcr_fail_s4;

        mov rdi, 109;
        mov rsi, 1;
        call compositor_register_client;
        mov r10, 0xFFFFE150;             // CLIENT_REGISTRY_FULL
        cmp rax, r10;
        jne tcr_fail_s4;

        // Stage 5: miss on an unregistered id; scrub; miss confirmed.
        mov rdi, 999;
        call compositor_client_caps;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // CLIENT_REGISTRY_MISS
        cmp rax, r10;
        jne tcr_fail_s5;

        call client_registry_init;

        mov rdi, 101;
        call compositor_client_caps;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tcr_fail_s5;

        xor rax, rax;
        jmp tcr_out;

      tcr_fail_s1:
        mov rax, 1;
        jmp tcr_out;
      tcr_fail_s2:
        mov rax, 2;
        jmp tcr_out;
      tcr_fail_s3:
        mov rax, 3;
        jmp tcr_out;
      tcr_fail_s4:
        mov rax, 4;
        jmp tcr_out;
      tcr_fail_s5:
        mov rax, 5;

      tcr_out:
        pop rbx;
        ret
      }
    }
}
