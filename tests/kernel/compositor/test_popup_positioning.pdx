// tests/kernel/compositor/test_popup_positioning.pdx -- COMP-RC-03
// (Wave NNN)
//
// Functional witness for src/user/compositor/popup_positioning.pdx
// (module PopupPositioning, Wave0-B14 G7-M8-006 / paideia-os #2264).
// Exercises popup_positioner_mint (atomic factory), the SECTION 11
// validators / SECTION 15 accessors, and popup_positioner_consume
// (linear, exactly-once).
//
// GAP NOTE vs. the Wave NNN dispatch brief: the brief asks to "request
// popup at (100, 500) with content (200, 300) on 1024x768 screen; assert
// positioning adjusts to (100, 468) or similar (fits above/below)." No
// function in popup_positioning.pdx -- or anywhere else in this tree --
// takes a screen/output size and computes an adjusted on-screen position.
// The module's own header says so explicitly (SECTION 4 / CONSTRAINT-
// ADJUST BITMASK): "the constraint solver that walks real output geometry
// is compositor-side runtime logic for a follow-up milestone." What DOES
// exist and IS exercised here: the anchor point (100, 500) and popup
// content size (200, 300) are accepted verbatim by popup_positioner_mint
// as anchor_rect/popup_size fields, the SLIDE_Y|FLIP_Y bits of
// constraint_adjust (the "fits above/below" REQUEST) are validated and
// stored, and popup_positioner_consume round-trips them byte-for-byte to
// a caller buffer. No adjusted coordinate is ever computed. A WEAK stub
// (tppp_screen_fit_stub_WEAK, below) documents the gap explicitly and
// returns a fixed NOT_IMPLEMENTED sentinel rather than fabricating
// (100, 468) or any other placement.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based stage
// number that first failed (1..6).
//
// Encoder: paideia-as. cmp not test; no and reg,imm64. Five callee-save
// pushes (rbx=scratch, r12=row2, r13=out buf, r14=row1, r15=anchor buf)
// leave rsp%16==0 for every nested call (entry rsp%16==8, five pushes ->
// 0), mirroring backlight_synth's own five-push idiom. Labels prefixed
// tppp_.

module TestPopupPositioning = structure {

  pub let mut _tppp_row1   : [u8; 64] = uninit @align(8)
  pub let mut _tppp_row2   : [u8; 64] = uninit @align(8)
  pub let mut _tppp_anchor : [u8; 16] = uninit @align(8)
  pub let mut _tppp_out    : [u8; 40] = uninit @align(8)

  // WEAK STUB -- see file header GAP NOTE. No constraint solver exists
  // in popup_positioning.pdx (or elsewhere) to compute an adjusted
  // on-screen popup position against a screen size; this stub documents
  // that absence and returns a fixed sentinel so the symbol exists for a
  // future landing to replace, rather than asserting a fabricated
  // (100, 468) result no code path in this tree produces today.
  pub let tppp_screen_fit_stub_WEAK : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-RC-03 gap marker: popup_positioning.pdx has no screen-aware constraint solver (own header SECTION 4: 'the constraint solver that walks real output geometry is compositor-side runtime logic for a follow-up milestone'). Pure leaf; returns NOT_IMPLEMENTED(all-ones) and asserts nothing about (100,500)+(200,300) on a 1024x768 screen. Labels prefixed tppp_sfs_ (none needed, straight-line).",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let test_popup_positioning_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-RC-03 (Wave NNN): five callee-save pushes (rbx=scratch, r12=row2, r13=out, r14=row1, r15=anchor) leave rsp%16==0 for every nested call. Stage 1: build anchor_ptr = [(100,500), (1,1)] via two popup_positioner_i32_pair_pack calls (the task's requested anchor point as a 1x1 anchor rect), popup_size_pack=pack(200,300) (the task's content size), enum_pack=pack(edge=BOTTOM(2), gravity=BOTTOM(2), adjust=SLIDE_Y|FLIP_Y=0x0A -- the 'fits above/below' request bits); popup_positioner_mint(row1, parent=42, ...) succeeds PPOS_OK(0). Stage 2: accessors round-trip is_minted==1, anchor_edge==2, gravity==2, constraint_adjust==0x0A, parent_window==42. Stage 3: a second mint into row2 with a raw enum_pack of 99 (edge byte 99 > PPOS_ANCHOR_MAX(8)) is refused POSITIONER_ANCHOR_INVALID(0xFFFFE82E) with row2 left unminted (NOVEL-CLEAN atomic-mint property: an invalid positioner is never observable). Stage 4: popup_positioner_consume(row1, out) succeeds PPOS_OK(0), is_consumed(row1)==1, and out[+32] (the copied enum_pack word, per file SECTION 14 INTEROP POINT) == edge|gravity<<8|adjust<<16 == 0x0A0202. Stage 5: a second consume on row1 is refused POSITIONER_ALREADY_CONSUMED(0xFFFFE827) -- LINEAR discipline. Stage 6: the WEAK gap stub is called and its fixed sentinel checked, confirming the marker itself is wired without asserting the missing placement math. Labels prefixed tppp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r14, [rip + _tppp_row1];
        lea r15, [rip + _tppp_anchor];
        lea r13, [rip + _tppp_out];
        lea r12, [rip + _tppp_row2];

        // Stage 1: build the request and mint.
        mov rdi, 100;                    // anchor x
        mov rsi, 500;                    // anchor y
        call popup_positioner_i32_pair_pack;
        mov [r15 + 0], rax;

        mov rdi, 1;                      // anchor w
        mov rsi, 1;                      // anchor h
        call popup_positioner_i32_pair_pack;
        mov [r15 + 8], rax;

        mov rdi, 200;                    // popup w (content)
        mov rsi, 300;                    // popup h (content)
        call popup_positioner_i32_pair_pack;
        mov rbx, rax;                    // popup_size_pack, transient

        mov rdi, 2;                      // PPOS_ANCHOR_BOTTOM (edge)
        mov rsi, 2;                      // PPOS_ANCHOR_BOTTOM (gravity)
        mov rdx, 0x0A;                   // SLIDE_Y | FLIP_Y
        call popup_positioner_enum_pack;
        mov r11, rax;                    // enum_pack, transient

        mov rdi, r14;                    // row_ptr
        mov rsi, 42;                     // parent_window_kind_id
        mov rdx, r15;                    // anchor_ptr
        mov rcx, rbx;                    // popup_size_pack
        mov r8, 0;                       // offset_pack (0,0)
        mov r9, r11;                     // enum_pack
        call popup_positioner_mint;
        cmp rax, 0;                      // PPOS_OK
        jne tppp_fail_s1;

        // Stage 2: accessors round-trip.
        mov rdi, r14;
        call popup_positioner_is_minted;
        cmp rax, 1;
        jne tppp_fail_s2;

        mov rdi, r14;
        call popup_positioner_get_anchor_edge;
        cmp rax, 2;
        jne tppp_fail_s2;

        mov rdi, r14;
        call popup_positioner_get_gravity;
        cmp rax, 2;
        jne tppp_fail_s2;

        mov rdi, r14;
        call popup_positioner_get_constraint_adjust;
        cmp rax, 0x0A;
        jne tppp_fail_s2;

        mov rdi, r14;
        call popup_positioner_get_parent_window;
        cmp rax, 42;
        jne tppp_fail_s2;

        // Stage 3: atomic mint refuses a bad edge; row2 stays unminted.
        mov rdi, r12;
        mov rsi, 42;
        mov rdx, r15;
        mov rcx, rbx;
        mov r8, 0;
        mov r9, 99;                      // raw enum_pack -> edge byte 99
        call popup_positioner_mint;
        mov r10, 0xFFFFE82E;             // POSITIONER_ANCHOR_INVALID
        cmp rax, r10;
        jne tppp_fail_s3;

        mov rdi, r12;
        call popup_positioner_is_minted;
        cmp rax, 0;
        jne tppp_fail_s3;

        // Stage 4: linear consume, then verify the copied enum word.
        mov rdi, r14;
        mov rsi, r13;
        call popup_positioner_consume;
        cmp rax, 0;                      // PPOS_OK
        jne tppp_fail_s4;

        mov rdi, r14;
        call popup_positioner_is_consumed;
        cmp rax, 1;
        jne tppp_fail_s4;

        mov rax, [r13 + 32];
        cmp rax, 0x0A0202;
        jne tppp_fail_s4;

        // Stage 5: re-consume is refused (LINEAR discipline).
        mov rdi, r14;
        mov rsi, r13;
        call popup_positioner_consume;
        mov r10, 0xFFFFE827;             // POSITIONER_ALREADY_CONSUMED
        cmp rax, r10;
        jne tppp_fail_s5;

        // Stage 6: gap stub is wired.
        call tppp_screen_fit_stub_WEAK;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        jne tppp_fail_s6;

        xor rax, rax;
        jmp tppp_out;

      tppp_fail_s1:
        mov rax, 1;
        jmp tppp_out;
      tppp_fail_s2:
        mov rax, 2;
        jmp tppp_out;
      tppp_fail_s3:
        mov rax, 3;
        jmp tppp_out;
      tppp_fail_s4:
        mov rax, 4;
        jmp tppp_out;
      tppp_fail_s5:
        mov rax, 5;
        jmp tppp_out;
      tppp_fail_s6:
        mov rax, 6;

      tppp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
