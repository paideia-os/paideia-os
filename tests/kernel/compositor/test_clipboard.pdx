// tests/kernel/compositor/test_clipboard.pdx -- COMP-UT-04 (Wave KKK)
//
// GAP NOTE / DESIGN CONFLICT vs. the Wave KKK dispatch brief: the
// brief asks for clipboard_set_owner(seat, cap) / clipboard_get_owner
// (seat) / clipboard_revoke(seat) -- a single ambient registry mapping
// a seat to "the" clipboard-owner capability. src/user/compositor/
// clipboard.pdx implements something structurally different on
// purpose: KIND_CLIP_OFFER, a SEALED, per-paste, two-window handoff
// (source_win + recipient_win + mime types + a KIND_MEMORY payload
// cap), minted fresh by the compositor for every individual paste
// request. Its own Section 0 states the design commitment this
// directly protects: "There is no ambient global-state read: any
// process that polls 'give me the clipboard' cannot exist because
// there is no cap it can name to ask that." A seat-keyed
// set_owner/get_owner pair is exactly that ambient "give me the
// clipboard" query clipboard.pdx's own header calls out as the X11
// shape it deliberately refuses to reproduce.
//
// The requested API therefore isn't merely absent -- promoting a
// literal implementation of it into clipboard.pdx would contradict
// that file's own stated design commitment. The architecturally
// faithful analogue of "an owner keyed per something, independently
// settable" already exists as REAL, landed code: src/user/compositor/
// selection_owner.pdx's KIND_SELECTION_OWNER (owner keyed by
// selection_kind, sealed, no ambient MINT). See test_selection_owner.
// pdx (COMP-UT-05, this same wave) for a witness against the real
// primitive. Recommend COMP-UT-04 be redesigned against
// selection_owner.pdx (or retired in favor of COMP-UT-05) rather than
// promoting the stub below.
//
// This file is therefore a WEAK, FULLY LOCAL stub (an 8-seat owner
// table with no rights model, no sealing, no revocation semantics
// beyond "zero the slot") that exercises NOTHING in
// src/user/compositor/clipboard.pdx. It exists only so COMP-UT-04 has
// a concrete, compiling assertion surface; a passing result here must
// not be read as validating clipboard.pdx.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..4).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. The three
// helpers are leaves (no nested calls); the witness needs a stack
// align pad (no callee-save state survives across its calls) rather
// than a push, since it holds nothing live between them.

module TestClipboard = structure {

  // 8-seat owner table (WEAK STUB; see GAP NOTE above). 0 = no owner.
  pub let mut _tcb_owner : [u64; 8] = uninit @align(8)

  // tcb_set_owner(seat, cap) -> 0 (ok) | 1 (seat out of range).
  pub let tcb_set_owner : (u64, u64) -> u64 !{mem} @{} =
    fn (seat: u64) (cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-04 (Wave KKK): WEAK STUB seat-keyed owner set. Leaf, no nested calls. Labels prefixed tcb_so_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tcb_so_bad;

        lea r10, [rip + _tcb_owner];
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], rsi;
        xor rax, rax;
        ret;

      tcb_so_bad:
        mov rax, 1;
        ret
      }
    }

  // tcb_get_owner(seat) -> cap | 0 (no owner, or seat out of range).
  pub let tcb_get_owner : (u64) -> u64 !{mem} @{} =
    fn (seat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-04 (Wave KKK): WEAK STUB seat-keyed owner read. Leaf, no nested calls. Labels prefixed tcb_go_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tcb_go_zero;

        lea r10, [rip + _tcb_owner];
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        ret;

      tcb_go_zero:
        xor rax, rax;
        ret
      }
    }

  // tcb_revoke(seat) -> 0 (ok) | 1 (seat out of range).
  pub let tcb_revoke : (u64) -> u64 !{mem} @{} =
    fn (seat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-04 (Wave KKK): WEAK STUB seat-keyed owner clear. Leaf, no nested calls. Labels prefixed tcb_rv_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tcb_rv_bad;

        lea r10, [rip + _tcb_owner];
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        ret;

      tcb_rv_bad:
        mov rax, 1;
        ret
      }
    }

  pub let test_clipboard_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-04 (Wave KKK): set seat 0's owner to cap 42, assert readback, revoke, assert the seat reads back 0. No value survives across any of the four calls (each result is consumed by the very next cmp), so one 8-byte align pad -- not a push -- brings rsp%16 from 8 (entry) to 0 for every nested call. See file GAP NOTE / DESIGN CONFLICT: exercises no shipping module and the requested shape is one clipboard.pdx's own header explicitly rejects. Labels prefixed test_clipboard_.",
      block: {
        sub rsp, 8;

        mov rdi, 0;
        mov rsi, 42;
        call tcb_set_owner;
        cmp rax, 0;
        jne test_clipboard_fail_s1;

        mov rdi, 0;
        call tcb_get_owner;
        cmp rax, 42;
        jne test_clipboard_fail_s2;

        mov rdi, 0;
        call tcb_revoke;
        cmp rax, 0;
        jne test_clipboard_fail_s3;

        mov rdi, 0;
        call tcb_get_owner;
        cmp rax, 0;
        jne test_clipboard_fail_s4;

        xor rax, rax;
        jmp test_clipboard_out;

      test_clipboard_fail_s1:
        mov rax, 1;
        jmp test_clipboard_out;
      test_clipboard_fail_s2:
        mov rax, 2;
        jmp test_clipboard_out;
      test_clipboard_fail_s3:
        mov rax, 3;
        jmp test_clipboard_out;
      test_clipboard_fail_s4:
        mov rax, 4;

      test_clipboard_out:
        add rsp, 8;
        ret
      }
    }
}
