// tests/kernel/compositor/test_selection_owner.pdx -- COMP-UT-05 (Wave KKK)
//
// Functional witness for src/user/compositor/selection_owner.pdx
// (module SelectionOwner, Wave0-B7-05 / paideia-os #2268). Sets an
// independent owner on two REAL selection-kind rows (SEL_CLIPBOARD=0,
// SEL_PRIMARY=1) via the real selection_owner_replace /
// selection_owner_query surface, then mutates one and asserts the
// other is unaffected.
//
// GAP NOTE vs. the Wave KKK dispatch brief: the brief asks for three
// independent "seats" (0, 1, 2). selection_owner.pdx's row pool is
// sealed to SO_KIND_MAX=2 (SEL_CLIPBOARD, SEL_PRIMARY) BY DESIGN --
// its own Section 2 states "the enum is sealed at boot: a runtime
// extension would land as a new KIND ... rather than a widening of
// this enum". A third independent slot is therefore not a missing
// getter/setter pair to stub around casually; it is a new KIND by
// that file's own stated philosophy. Seats 0 and 1 below are the REAL
// module (kind=SEL_CLIPBOARD, kind=SEL_PRIMARY); "seat 2" is a WEAK,
// fully local single-cell stub (tso_seat2_set/get) that exercises
// NOTHING in selection_owner.pdx, included only so COMP-UT-05's
// three-way independence assertion has a third leg to check. File a
// follow-up issue (a real third selection kind, or a seat-indexed
// generalization) before promoting the stub's shape.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1, 2, 4, 5, 6 -- stage 3 sets the
// stub seat and cannot fail).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. No value
// survives across any call in the witness (every result is consumed
// by the very next cmp, and mime_ptr is re-derived via `lea` each
// time it is needed), so one 8-byte align pad brings rsp%16 from 8
// (entry) to 0 for every nested call.

module TestSelectionOwner = structure {

  // Opaque, nonzero mime-types pointer for the mint-time validators
  // (selection_owner_mime_ptr_valid only checks non-null; content is
  // never read by anything in this test).
  pub let tso_dummy_mime : [u8; 4] = "abc\0"

  // WEAK STUB "seat 2" -- see GAP NOTE above. A single cell, no rights
  // model, no sealing.
  pub let mut _tso_seat2_owner : u64 = 0

  pub let tso_seat2_set : (u64) -> () !{mem} @{} =
    fn (cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-05 (Wave KKK): WEAK STUB single-cell 'seat 2' owner set. Leaf, no nested calls.",
      block: {
        lea r10, [rip + _tso_seat2_owner];
        mov [r10 + 0], rdi;
        ret
      }
    }

  pub let tso_seat2_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-05 (Wave KKK): WEAK STUB single-cell 'seat 2' owner read. Leaf, no nested calls.",
      block: {
        lea r10, [rip + _tso_seat2_owner];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let test_selection_owner_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-UT-05 (Wave KKK): stage 1 sets kind=SEL_CLIPBOARD(0)'s owner to cap 1001 via the REAL selection_owner_replace (mime_ptr/mime_count/data_kind_id all valid non-degenerate arguments), asserting the previous owner reads 0 (fresh row). Stage 2 does the same for kind=SEL_PRIMARY(1) -> cap 1002. Stage 3 sets the WEAK-stub 'seat 2' to cap 1003 (cannot fail; see GAP NOTE). Stage 4 asserts all three read back independently via the REAL selection_owner_query for kinds 0/1 and the stub getter for seat 2. Stage 5 replaces kind 0 alone with cap 1004 and asserts the REAL API reports the correct previous owner (1001), proving the row it is about to disturb really held it. Stage 6 re-asserts independence: kind 0 changed, kind 1 and seat 2 did not move. One 8-byte align pad (no value survives across any call here) keeps rsp%16==0 for every nested call. Labels prefixed test_selection_owner_.",
      block: {
        sub rsp, 8;

        // Stage 1: SEL_CLIPBOARD(0) <- cap 1001.
        mov rdi, 0;
        mov rsi, 1001;
        lea rdx, [rip + tso_dummy_mime];
        mov rcx, 1;
        mov r8, 7;
        call selection_owner_replace;
        cmp rax, 0;
        jne test_selection_owner_fail_s1;

        // Stage 2: SEL_PRIMARY(1) <- cap 1002.
        mov rdi, 1;
        mov rsi, 1002;
        lea rdx, [rip + tso_dummy_mime];
        mov rcx, 1;
        mov r8, 7;
        call selection_owner_replace;
        cmp rax, 0;
        jne test_selection_owner_fail_s2;

        // Stage 3: WEAK stub "seat 2" <- cap 1003.
        mov rdi, 1003;
        call tso_seat2_set;

        // Stage 4: independence check #1.
        mov rdi, 0;
        call selection_owner_query;
        cmp rax, 1001;
        jne test_selection_owner_fail_s4;

        mov rdi, 1;
        call selection_owner_query;
        cmp rax, 1002;
        jne test_selection_owner_fail_s4;

        call tso_seat2_get;
        cmp rax, 1003;
        jne test_selection_owner_fail_s4;

        // Stage 5: mutate kind 0 only; previous owner must read 1001.
        mov rdi, 0;
        mov rsi, 1004;
        lea rdx, [rip + tso_dummy_mime];
        mov rcx, 1;
        mov r8, 7;
        call selection_owner_replace;
        cmp rax, 1001;
        jne test_selection_owner_fail_s5;

        // Stage 6: independence check #2 -- kind 0 changed, others did not.
        mov rdi, 0;
        call selection_owner_query;
        cmp rax, 1004;
        jne test_selection_owner_fail_s6;

        mov rdi, 1;
        call selection_owner_query;
        cmp rax, 1002;
        jne test_selection_owner_fail_s6;

        call tso_seat2_get;
        cmp rax, 1003;
        jne test_selection_owner_fail_s6;

        xor rax, rax;
        jmp test_selection_owner_out;

      test_selection_owner_fail_s1:
        mov rax, 1;
        jmp test_selection_owner_out;
      test_selection_owner_fail_s2:
        mov rax, 2;
        jmp test_selection_owner_out;
      test_selection_owner_fail_s4:
        mov rax, 4;
        jmp test_selection_owner_out;
      test_selection_owner_fail_s5:
        mov rax, 5;
        jmp test_selection_owner_out;
      test_selection_owner_fail_s6:
        mov rax, 6;

      test_selection_owner_out:
        add rsp, 8;
        ret
      }
    }
}
