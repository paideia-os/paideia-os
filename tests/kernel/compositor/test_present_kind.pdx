// tests/kernel/compositor/test_present_kind.pdx -- COMP-PF-03 (Wave MMM)
//
// Functional witness for src/user/compositor/present_feedback_kind.pdx
// (module PresentFeedbackKind, Wave0-B9-07 / paideia-os #2297). Exercises
// two things: (A) the PresentClassification enum identity as it round-
// trips through a real row via present_feedback_record_present +
// present_feedback_row_classification, and (B) the bundled query
// present_feedback_query_last round-tripping the full row state through
// a caller-supplied output buffer.
//
// GAP NOTE vs. the Wave MMM dispatch brief:
//   (1) The brief names PF_KIND_ON_TIME=1 / PF_KIND_LATE=2 /
//       PF_KIND_DROPPED=3. The module actually defines (SECTION 4 /
//       Section header of present_feedback_kind.pdx):
//         PRESENT_ON_TIME = 0, PRESENT_LATE = 1, PRESENT_DROPPED = 2,
//         PRESENT_VBLANK = 3.
//       This witness asserts the REAL values via a functional round
//       trip (mint -> record_present(class) -> row_classification ==
//       class) rather than the brief's numbers, per the brief's own
//       "(or whatever the module actually defines)" escape hatch.
//   (2) The brief asks for a "PresentFeedbackRecord" serialized to 24
//       bytes. No type or function of that name/size exists. The
//       module's only bundled (de)serialize-shaped primitive is
//       present_feedback_query_last(row_id, out_ptr), which writes 40
//       BYTES (5 u64 fields: last_present_nsec, last_vblank_nsec,
//       refresh_period_nsec, last_classification, frame_count -- see
//       the module's SECTION 14). This witness exercises that real
//       40-byte bundled query instead of an invented 24-byte shape.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..7).
//
// Encoder: paideia-as. cmp not test; no add reg,[mem]. One callee-save
// push (rbx = row_id) gives rsp%16==0 for every nested call.

module TestPresentKind = structure {

  // 40-byte bundled-query output buffer (5 u64 words), matching
  // present_feedback_query_last's real layout. @align(8) is sufficient
  // for eight-byte stores; @align(64) is not required at this size.
  pub let mut _test_pf_out : [u64; 5] = uninit @align(8)

  pub let test_present_kind_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-PF-03 (Wave MMM): one callee-save push (rbx=row_id) leaves rsp%16==0 for every nested call. Part A (stages 1-4): mint one row, then round-trip each PresentClassification value (0/ON_TIME, 1/LATE, 2/DROPPED) through record_present + row_classification to prove the enum identity is exactly what the module documents, not the brief's invented numbering. Part B (stages 5-7): after the three record_present calls frame_count==3 and last_classification==2 (DROPPED, the last one stamped); present_feedback_query_last writes the real 40-byte bundle into _test_pf_out and stages 5-7 verify out[+0] (last_present_nsec), out[+24] (last_classification), out[+32] (frame_count) round-trip correctly. Labels prefixed test_present_kind_.",
      block: {
        push rbx;

        // Mint one row: surface_kind_id=55, subscriber_kind_id=0 (no
        // subscriber -- legal per file header SECTION 5).
        mov rdi, 55;
        xor rsi, rsi;
        call present_feedback_mint;
        mov rbx, rax;
        mov r10, 16;
        cmp rbx, r10;
        jae test_present_kind_fail_s1;

        // Stage 2: record ON_TIME(0); row_classification must read back 0.
        mov rdi, rbx;
        mov rsi, 111111;
        mov rdx, 0;
        call present_feedback_record_present;
        cmp rax, 0;
        jne test_present_kind_fail_s2;
        mov rdi, rbx;
        call present_feedback_row_classification;
        cmp rax, 0;
        jne test_present_kind_fail_s2;

        // Stage 3: record LATE(1); row_classification must read back 1.
        mov rdi, rbx;
        mov rsi, 222222;
        mov rdx, 1;
        call present_feedback_record_present;
        cmp rax, 0;
        jne test_present_kind_fail_s3;
        mov rdi, rbx;
        call present_feedback_row_classification;
        cmp rax, 1;
        jne test_present_kind_fail_s3;

        // Stage 4: record DROPPED(2); row_classification must read back 2.
        mov rdi, rbx;
        mov rsi, 333333;
        mov rdx, 2;
        call present_feedback_record_present;
        cmp rax, 0;
        jne test_present_kind_fail_s4;
        mov rdi, rbx;
        call present_feedback_row_classification;
        cmp rax, 2;
        jne test_present_kind_fail_s4;

        // Stage 5: bundled query round trip -- out_ptr = &_test_pf_out.
        mov rdi, rbx;
        lea rsi, [rip + _test_pf_out];
        call present_feedback_query_last;
        cmp rax, 0;
        jne test_present_kind_fail_s5;

        // Stage 6: out[+0] == last_present_nsec == 333333.
        lea r10, [rip + _test_pf_out];
        mov rax, [r10 + 0];
        cmp rax, 333333;
        jne test_present_kind_fail_s6;

        // Stage 7: out[+24] == last_classification == 2 (DROPPED),
        // out[+32] == frame_count == 3 (three record_present calls).
        lea r10, [rip + _test_pf_out];
        mov rax, [r10 + 24];
        cmp rax, 2;
        jne test_present_kind_fail_s7;
        mov rax, [r10 + 32];
        cmp rax, 3;
        jne test_present_kind_fail_s7;

        xor rax, rax;
        jmp test_present_kind_out;

      test_present_kind_fail_s1:
        mov rax, 1;
        jmp test_present_kind_out;
      test_present_kind_fail_s2:
        mov rax, 2;
        jmp test_present_kind_out;
      test_present_kind_fail_s3:
        mov rax, 3;
        jmp test_present_kind_out;
      test_present_kind_fail_s4:
        mov rax, 4;
        jmp test_present_kind_out;
      test_present_kind_fail_s5:
        mov rax, 5;
        jmp test_present_kind_out;
      test_present_kind_fail_s6:
        mov rax, 6;
        jmp test_present_kind_out;
      test_present_kind_fail_s7:
        mov rax, 7;

      test_present_kind_out:
        pop rbx;
        ret
      }
    }
}
