// tests/kernel/compositor/test_present_classifier.pdx -- COMP-PF-01 (Wave MMM)
//
// Functional witness for src/user/compositor/present_feedback_classifier.pdx
// (module PresentFeedbackClassifier, Wave0-B11-04 / paideia-os #2299).
// Exercises the pure threshold-tree function
// present_feedback_classifier_classify(present_nsec, target_vblank_nsec)
// across all three PresentClassification outcomes it can produce
// (ON_TIME=0, LATE=1, DROPPED=2; VBLANK=3 is never returned by classify
// per the module's own §1 documentation, so it is out of scope here).
//
// GAP NOTE vs. the Wave MMM dispatch brief: the brief's illustrative
// numbers (target_ns=1000000, actual_ns=1200000 -> LATE; actual_ns=0 ->
// DROPPED) do not match the classifier's real thresholds
// (PFC_ON_TIME_MARGIN_NSEC=1ms, PFC_LATE_MARGIN_NSEC=5ms -- see file
// header SECTION 4 of the module under test). A 200us overshoot is
// still inside the 1ms ON_TIME margin, and present_nsec=0 with any
// nonzero target is the trivial "arrived before target" ON_TIME case
// (classify only compares P <= T + margin, never P < T). This witness
// therefore uses present/target pairs that land in each band per the
// module's ACTUAL documented arithmetic rather than the brief's
// illustrative values; see stage comments below for the derivation.
//
// Return convention: 0 = all stages passed. Nonzero = the 1-based
// stage number that first failed (1..3).
//
// Encoder: paideia-as. Uses call/ret/mov/cmp/jne/jmp only; no add
// reg,[mem]; cmp not test. classify() is declared `!{} @{}` (pure,
// no mem effect, no capability) in the module under test, so this
// witness carries the same empty effect/capability row.

module TestPresentClassifier = structure {

  // present_feedback_classifier_classify(present_nsec, target_vblank_nsec)
  //     -> 0 ON_TIME | 1 LATE | 2 DROPPED.
  pub let test_present_classifier_run : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-PF-01 (Wave MMM): pure witness, no callee-save needed (no value survives across calls; every call site reloads its args via immediate mov). Single `sub rsp, 8` bracket takes entry rsp%16==8 to 0 for the three nested calls to present_feedback_classifier_classify. Stage 1: present=999000, target=1000000 -- present < target, trivially ON_TIME (classify's P<=T+margin branch is satisfied for any P<=T). Stage 2: present=3000000, target=1000000 -- diff=2ms, past the 1ms ON_TIME margin but within the 5ms LATE margin -> LATE. Stage 3: present=10000000, target=1000000 -- diff=9ms, past the 5ms LATE margin -> DROPPED. Labels prefixed test_present_classifier_.",
      block: {
        sub rsp, 8;

        // Stage 1: ON_TIME (present arrives before target).
        mov rdi, 999000;
        mov rsi, 1000000;
        call present_feedback_classifier_classify;
        cmp rax, 0;
        jne test_present_classifier_fail_s1;

        // Stage 2: LATE (2ms past target, inside the 1ms..5ms band).
        mov rdi, 3000000;
        mov rsi, 1000000;
        call present_feedback_classifier_classify;
        cmp rax, 1;
        jne test_present_classifier_fail_s2;

        // Stage 3: DROPPED (9ms past target, beyond the 5ms LATE margin).
        mov rdi, 10000000;
        mov rsi, 1000000;
        call present_feedback_classifier_classify;
        cmp rax, 2;
        jne test_present_classifier_fail_s3;

        xor rax, rax;
        jmp test_present_classifier_out;

      test_present_classifier_fail_s1:
        mov rax, 1;
        jmp test_present_classifier_out;
      test_present_classifier_fail_s2:
        mov rax, 2;
        jmp test_present_classifier_out;
      test_present_classifier_fail_s3:
        mov rax, 3;

      test_present_classifier_out:
        add rsp, 8;
        ret
      }
    }
}
