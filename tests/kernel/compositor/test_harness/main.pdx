// tests/kernel/compositor/test_harness/main.pdx -- Wave π (π-01)
//
// Standalone kernel-side test-runner ELF for the compositor unit-test
// battery. Link-includes (see tools/build.sh `--compositor-tests`
// path, Wave π π-02):
//
//   (a) every src/user/compositor/*.pdx library module EXCEPT
//       selftest.pdx -- selftest.pdx is the separate Wave β β-01
//       compositor_selftest.elf's own `_start` (tools/build-user.sh),
//       a distinct boot-smoke fixture (design/testing/compositor-
//       qemu-smoke-plan.md COMP-QM-01) built into its OWN link unit
//       (selftest.o + buffer_age.o only). Pulling selftest.pdx into
//       THIS link unit would collide two `_start` symbols in one ELF.
//   (b) every tests/kernel/compositor/test_*.pdx witness (20 files at
//       landing: buffer_age, client_registry, damage_kind, clipboard,
//       a11y_bind_at_mint, dnd_offer, damage_aggregate,
//       keynav_focus_ring, present_classifier, keynav_taborder,
//       ime_router, pwp_a11y_wire, popup_positioning,
//       recovery_plane_reserve, present_kind, present_route,
//       subsurface_sync, layer_tree, selection_owner,
//       recovery_plane_takeover).
//   (c) this file, which supplies the common `_start`.
//
// Design: design/testing/kernel-test-runner.md (general pattern) and
// design/testing/compositor-test-runner.md (this fixture specifically).
//
// Contract with each witness: every tests/kernel/compositor/test_*.pdx
// file exports exactly one `pub let test_<subsystem>_run : () -> u64`
// entry point (already the uniform shape every one of the 20 files
// landed with, independently, across earlier waves). It returns 0 on
// full pass, or the 1-based ordinal of the first stage that failed --
// this file treats any nonzero return as FAIL and prints the returned
// ordinal verbatim (it does not interpret per-witness stage meanings).
//
// Dispatch is a flat, explicit sequence in `_start` -- 20 `call
// test_X_run` sites, each immediately followed by a `call th_record`
// that tallies pass/fail and emits one diagnostic line. This mirrors
// the codebase's dominant straight-line dispatch style (ps.pdx's
// per-record emit, echo_client.pdx's step sequence) rather than a
// function-pointer table: with a fixed, closed set of 20 witnesses
// known at this landing, explicit calls are the more legible +
// type-checkable choice (`call test_X_run` gets normal link-time
// undefined-symbol diagnostics; an entry missing from a runtime table
// would not).
//
// Prerequisite fix (this same landing, see the five files' own inline
// comments): three src/user/compositor/*.pdx files
// (window_geometry.pdx, xdg_shell_geometry.pdx, xdg_shell_states.pdx)
// independently declare the identical byte-stable RESIZE_EDGE_* table
// as `pub let`, and two more (recovery_plane_reserve.pdx,
// recovery_plane_takeover.pdx) independently declare identical
// KIND_RECOVERY_PLANE / RESERVATION_HOLDER_KIND constants the same
// way. `pub let NAME : u64 = <literal>` compiles to a real global
// Rodata ELF symbol (not a macro-style compile-time-only constant), so
// linking all of src/user/compositor/* into ONE object for the first
// time (this file is the first thing that ever does that -- see the
// selftest.pdx note above and design/testing/compositor-qemu-smoke-
// plan.md §1.2's own observation that these 30-odd files have "no
// entry point... not a linked or spawnable daemon") surfaces a latent
// multiple-definition link error for those 13 names. Fixed by
// demoting the duplicates to file-local `let` (grep-verified zero
// symbol-name references anywhere in src/ or tests/ -- every use site
// already hardcodes the literal directly), which changes no emitted
// code, only symbol visibility.
//
// Self-contained: inlines its two SC+ syscalls (write=1, exit=60)
// directly, matching true.pdx / child_hello.pdx / selftest.pdx
// discipline -- no syscall_shim dependency. fd=2 (stderr) per this
// wave's brief; tools/build.sh dispatch.pdx documents "ID 1 (write)
// uses fast-path for fd∈{1,2}→UART" so fd=2 reaches the same UART
// wire as fd=1 under the default -kernel boot (no fd-table churn, no
// tmpfs dependency).
//
// Fingerprint: "COMPOSITOR TESTS: <pass> passed / <fail> failed\n" on
// fd 2. Deliberately carries no "OK" token (tools/verify-fingerprint-
// coverage.sh only requires assertable coverage for markers containing
// the whole word "OK" -- design/testing/fingerprint-coverage.md §2);
// this line's pass/fail counts are runtime-computed, not a compile-
// time literal, so no golden can pin it as an ordered-substring
// anyway. tools/run-qemu-tests.sh (Wave π π-04) is this fixture's own
// consumer -- it greps this exact prefix, not the coverage gate.

module CompositorTestHarness = structure {

  // ==========================================================================
  // SECTION A  Per-test name strings (rodata, diagnostic emit only).
  // ==========================================================================

  pub let th_name_buffer_age : [u8; 11] = "buffer_age\0"
  pub let th_name_client_registry : [u8; 16] = "client_registry\0"
  pub let th_name_damage_kind : [u8; 12] = "damage_kind\0"
  pub let th_name_clipboard : [u8; 10] = "clipboard\0"
  pub let th_name_a11y_bind_at_mint : [u8; 18] = "a11y_bind_at_mint\0"
  pub let th_name_dnd_offer : [u8; 10] = "dnd_offer\0"
  pub let th_name_damage_aggregate : [u8; 17] = "damage_aggregate\0"
  pub let th_name_keynav_focus_ring : [u8; 18] = "keynav_focus_ring\0"
  pub let th_name_present_classifier : [u8; 19] = "present_classifier\0"
  pub let th_name_keynav_taborder : [u8; 16] = "keynav_taborder\0"
  pub let th_name_ime_router : [u8; 11] = "ime_router\0"
  pub let th_name_pwp_a11y_wire : [u8; 14] = "pwp_a11y_wire\0"
  pub let th_name_popup_positioning : [u8; 18] = "popup_positioning\0"
  pub let th_name_recovery_plane_reserve : [u8; 23] = "recovery_plane_reserve\0"
  pub let th_name_present_kind : [u8; 13] = "present_kind\0"
  pub let th_name_present_route : [u8; 14] = "present_route\0"
  pub let th_name_subsurface_sync : [u8; 16] = "subsurface_sync\0"
  pub let th_name_layer_tree : [u8; 11] = "layer_tree\0"
  pub let th_name_selection_owner : [u8; 16] = "selection_owner\0"
  pub let th_name_recovery_plane_takeover : [u8; 24] = "recovery_plane_takeover\0"

  // ==========================================================================
  // SECTION B  Tally state + fixed diagnostic strings.
  // ==========================================================================

  pub let mut _th_pass : u64 = uninit @align(8)
  pub let mut _th_fail : u64 = uninit @align(8)

  pub let th_pass_tag       : [u8; 7]  = " PASS\n\0"
  pub let th_fail_tag       : [u8; 13] = " FAIL stage=\0"
  pub let th_nl             : [u8; 2]  = "\n\0"
  pub let th_summary_prefix : [u8; 19] = "COMPOSITOR TESTS: \0"
  pub let th_summary_mid    : [u8; 11] = " passed / \0"
  pub let th_summary_suffix : [u8; 9]  = " failed\n\0"

  // ==========================================================================
  // SECTION C  Helpers -- write(fd=2), decimal-print(fd=2), record.
  // ==========================================================================

  // th_write(buf, len) -> () -- sys_write(2, buf, len). SC+ ID 1.
  // Leaf (no nested calls, no stack use) -- marshals SysV (rdi=buf,
  // rsi=len) into the sys_write shape (rdi=fd, rsi=buf, rdx=len,
  // rax=1), mirroring ps.pdx's write_bytes(buf,len) wrapper exactly
  // except targeting fd=2 (stderr) rather than fd=1 (stdout) per this
  // wave's brief.
  pub let th_write : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "Wave π (π-01): sys_write(2, buf, len) wrapper, verbatim shape of ps.pdx's write_bytes(buf,len) with fd=2 instead of fd=1. Three-mov marshal (rdx=len from rsi, rsi=buf from rdi, rdi=fd=2) then SC+ ID 1. Leaf: no nested calls, no stack use, so no alignment obligation on the caller beyond the standard call-site rsp%16==0. Effects {mem,sysreg}@{fs} matches sys_write's own declared row in src/user/syscall_shim.pdx (the {mem} covers the caller's buffer, not any local state here). No labels needed (straight-line, no branches).",
      block: {
        mov rdx, rsi;                    // count
        mov rsi, rdi;                    // buf
        mov rdi, 2;                      // fd = stderr
        mov rax, 1;                      // SC+ ID 1 = sys_write
        syscall;
        ret
      }
    } @no_frame

  // th_write_dec(value) -> () -- u64 -> decimal ASCII on fd=2. SC+ ID 1.
  // Verbatim shape of ps.pdx's / init.pdx's print_u64_dec (R17-M2-736
  // D12 / #736): divide-by-10 loop into a 24-byte stack scratch, then
  // one sys_write emits the [first_digit, len] slice. Zero fast-paths
  // to a single '0'. Targets fd=2 instead of fd=1.
  pub let th_write_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "Wave π (π-01): u64 -> decimal ASCII on fd=2, verbatim shape of ps.pdx §print_u64_dec (itself verbatim from init.pdx, R17-M2-736 D12 / #736) with fd=2 substituted for fd=1 at both sys_write sites. 24-byte stack scratch (20 digits max for u64::MAX + 4-byte 16-B-align slop); divide-by-10 loop stashes digits right-to-left; zero fast-paths to a single '0' digit. Leaf -- no nested calls, so `sub rsp,24` at entry (rsp%16==8 -> 0) needs no further padding around the trailing `syscall` (syscall has no stack-alignment requirement, unlike `call`). Callee-save regs untouched (all work in rax/rcx/rdx/rsi/rdi/r9/r10), so callers may hold loop/tally state across this call in any callee-save register. Labels prefixed thwd_.",
      block: {
        sub rsp, 24;

        cmp rdi, 0;
        jne thwd_divide_setup;
          mov al, 0x30;                  // ASCII '0'
          mov [rsp], al;
          mov rsi, rsp;
          mov rdi, 2;                    // fd = stderr
          mov rdx, 1;
          mov rax, 1;                    // SC+ ID 1
          syscall;
          add rsp, 24;
          ret;

        thwd_divide_setup:
          mov r9, rdi;                   // remaining value
          mov r10, rsp;
          add r10, 19;                   // cursor at last staging byte

        thwd_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;
          div rcx;
          add rdx, 0x30;
          mov [r10], dl;
          mov r9, rax;
          cmp r9, 0;
          je thwd_loop_done;
          sub r10, 1;
          jmp thwd_loop_top;

        thwd_loop_done:
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                  // digit count
          mov rdx, rax;
          mov rsi, r10;
          mov rdi, 2;                    // fd = stderr
          mov rax, 1;                    // SC+ ID 1
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // th_record(name_buf, name_len, result) -> () -- tally + emit one
  // diagnostic line: "<name> PASS\n" or "<name> FAIL stage=<result>\n".
  //
  // Three callee-save pushes (rbx=name_buf, r12=name_len, r13=result)
  // hold the three args across the nested th_write / th_write_dec
  // calls (which clobber rax/rcx/rdx/rsi/rdi per their own
  // justifications). Odd push count leaves rsp%16==0 for every nested
  // call (entry rsp%16==8, three 8-byte pushes -> rsp%16==0) -- same
  // parity rule layer_tree.pdx's lt_row_alloc / lt_bbox_union_into_
  // parent document for their own push counts.
  pub let th_record : (u64, u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (name_buf: u64) (name_len: u64) (result: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "Wave π (π-01): per-witness tally + one-line emit. Three callee-save pushes (rbx=name_buf, r12=name_len, r13=result) survive the nested th_write/th_write_dec calls (odd push count -> rsp%16==0, no further padding needed for the direct calls that follow). Flow: (1) emit the name via th_write(name_buf, name_len); (2) branch on result == 0; (3a) pass arm: load-inc-store _th_pass (no `add reg,[mem]`), emit th_pass_tag (' PASS\\n'); (3b) fail arm: load-inc-store _th_fail, emit th_fail_tag (' FAIL stage='), emit the decimal result via th_write_dec, emit th_nl. Effects/capabilities are the union of th_write's and th_write_dec's own declared {mem,sysreg}@{fs} rows. Labels prefixed th_rec_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // name_buf
        mov r12, rsi;                    // name_len
        mov r13, rdx;                    // result

        mov rdi, rbx;
        mov rsi, r12;
        call th_write;

        cmp r13, 0;
        jne th_rec_fail;

        lea r10, [rip + _th_pass];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;

        lea rdi, [rip + th_pass_tag];
        mov rsi, 6;
        call th_write;
        jmp th_rec_done;

      th_rec_fail:
        lea r10, [rip + _th_fail];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;

        lea rdi, [rip + th_fail_tag];
        mov rsi, 12;
        call th_write;

        mov rdi, r13;
        call th_write_dec;

        lea rdi, [rip + th_nl];
        mov rsi, 1;
        call th_write;

      th_rec_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  _start -- dispatch all 20 witnesses, then emit the
  // summary fingerprint and exit.
  //
  // No callee-save pushes in _start itself: every live value (the
  // just-returned `result` in rax) is consumed into r8 and then into
  // th_record's rdx argument before the next `call`, so nothing needs
  // to survive across more than one call. Initial process entry has
  // rsp%16==0 per this tree's established _start convention (true.pdx
  // / child_hello.pdx / selftest.pdx all issue their first `call` (or
  // `syscall`) with no preceding stack use), so every direct `call`
  // below needs no alignment padding.
  //
  // Exit status = fail count truncated to the syscall's status byte
  // (0 iff every one of the 20 witnesses passed).
  // ==========================================================================

  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "Wave π (π-01): compositor test-runner _start. Zeroes the two tally counters, then dispatches all 20 tests/kernel/compositor/test_*.pdx witnesses in a flat explicit sequence -- each `call test_X_run` immediately followed by `mov r8, rax` (stash the returned 0=pass/N=fail-stage value before the next call clobbers rax) then `call th_record(name_buf, name_len, result)`. Emits the summary fingerprint ('COMPOSITOR TESTS: <pass> passed / <fail> failed\\n') via five th_write/th_write_dec calls, then sys_exit(fail_count) (SC+ ID 60, never returns). Effects/capabilities are the union of every callee's own declared row (test_X_run: {mem}@{} or {}@{}; th_record: {mem,sysreg}@{fs}; sys_exit: {sysreg}@{sched}). No callee-save pushes needed: rax's live range per test never crosses more than the single `mov r8, rax` before th_record consumes it. Reserved-label discipline: no new labels introduced in this function (straight-line, no branches) -- th_record/th_write/th_write_dec's own internal labels are prefixed th_rec_/thwd_ respectively.",
      block: {
        xor rax, rax;
        lea r10, [rip + _th_pass];
        mov [r10], rax;
        lea r10, [rip + _th_fail];
        mov [r10], rax;

        call test_buffer_age_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_buffer_age];
        mov rsi, 10;
        mov rdx, r8;
        call th_record;

        call test_client_registry_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_client_registry];
        mov rsi, 15;
        mov rdx, r8;
        call th_record;

        call test_damage_kind_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_damage_kind];
        mov rsi, 11;
        mov rdx, r8;
        call th_record;

        call test_clipboard_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_clipboard];
        mov rsi, 9;
        mov rdx, r8;
        call th_record;

        call test_a11y_bind_at_mint_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_a11y_bind_at_mint];
        mov rsi, 17;
        mov rdx, r8;
        call th_record;

        call test_dnd_offer_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_dnd_offer];
        mov rsi, 9;
        mov rdx, r8;
        call th_record;

        call test_damage_aggregate_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_damage_aggregate];
        mov rsi, 16;
        mov rdx, r8;
        call th_record;

        call test_keynav_focus_ring_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_keynav_focus_ring];
        mov rsi, 17;
        mov rdx, r8;
        call th_record;

        call test_present_classifier_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_present_classifier];
        mov rsi, 18;
        mov rdx, r8;
        call th_record;

        call test_keynav_taborder_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_keynav_taborder];
        mov rsi, 15;
        mov rdx, r8;
        call th_record;

        call test_ime_router_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_ime_router];
        mov rsi, 10;
        mov rdx, r8;
        call th_record;

        call test_pwp_a11y_wire_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_pwp_a11y_wire];
        mov rsi, 13;
        mov rdx, r8;
        call th_record;

        call test_popup_positioning_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_popup_positioning];
        mov rsi, 17;
        mov rdx, r8;
        call th_record;

        call test_recovery_plane_reserve_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_recovery_plane_reserve];
        mov rsi, 22;
        mov rdx, r8;
        call th_record;

        call test_present_kind_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_present_kind];
        mov rsi, 12;
        mov rdx, r8;
        call th_record;

        call test_present_route_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_present_route];
        mov rsi, 13;
        mov rdx, r8;
        call th_record;

        call test_subsurface_sync_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_subsurface_sync];
        mov rsi, 15;
        mov rdx, r8;
        call th_record;

        call test_layer_tree_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_layer_tree];
        mov rsi, 10;
        mov rdx, r8;
        call th_record;

        call test_selection_owner_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_selection_owner];
        mov rsi, 15;
        mov rdx, r8;
        call th_record;

        call test_recovery_plane_takeover_run;
        mov r8, rax;                     // stash result (rax dies at the next call)
        lea rdi, [rip + th_name_recovery_plane_takeover];
        mov rsi, 23;
        mov rdx, r8;
        call th_record;

        // ---- Summary fingerprint on fd 2 ----
        lea rdi, [rip + th_summary_prefix];
        mov rsi, 18;
        call th_write;

        lea r10, [rip + _th_pass];
        mov rdi, [r10];
        call th_write_dec;

        lea rdi, [rip + th_summary_mid];
        mov rsi, 10;
        call th_write;

        lea r10, [rip + _th_fail];
        mov rdi, [r10];
        call th_write_dec;

        lea rdi, [rip + th_summary_suffix];
        mov rsi, 8;
        call th_write;

        // ---- sys_exit(fail_count). SC+ ID 60. Never returns. ----
        lea r10, [rip + _th_fail];
        mov rdi, [r10];
        mov rax, 60;
        syscall;

        hlt
      }
    }
}
