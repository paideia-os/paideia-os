// tests/kernel/apic/ioapic_reroute_synth.pdx — R21.M3-004 (#836)
//
// Structural re-route witness for the R21.M3 IOAPIC base-parametric
// primitives (#833/#834). Exercises the full ioapic_read_at /
// ioapic_write_at / ioapic_program_redir chain end-to-end via real MMIO
// against QEMU's IOAPIC at 0xFEC00000.
//
// ============================================================================
// What this witness PROVES
// ============================================================================
//
// (a) ioapic_read_at reads a stable, non-zero LO/HI value for RTE #4
//     immediately after ioapic_irq4_init has programmed it (kernel_main.pdx
//     L5758) — validates the round-trip works with real MMIO, not just the
//     stub-friendly witness at L5762-5786 that uses the R16.M4 hard-coded-
//     base variant.
//
// (b) ioapic_program_redir composes a valid RTE from packed field args
//     (vector, dest, flags) and writes the two 32-bit halves in the correct
//     order (HI first, then LO).
//
// (c) ioapic_read_at read-back of the freshly-programmed RTE returns the
//     bits ioapic_program_redir composed (vector byte == 0x24 in LO[7:0],
//     dest byte == 1 in HI[31:24], mask == 0 in LO[16]) — proves the
//     encoder-gap workaround (mov_d) actually emits 32-bit stores that the
//     IOAPIC latches correctly. A REX.W widening regression would corrupt
//     the RTE state and the read-back would mismatch.
//
// (d) The state-restoration path exercises ioapic_write_at directly (not
//     via ioapic_program_redir) — proves the low-level accessor is
//     symmetric with the read.
//
// ============================================================================
// What this witness does NOT prove (deferred)
// ============================================================================
//
// - That the re-routed interrupt actually fires on the new destination
//   CPU. Verifying this requires:
//     (1) SMP with 2+ CPUs (R18.M1 landed, hard-coded 3 APs).
//     (2) AP-side IDT install (#762/#766 follow-up — APs currently park
//         in cli;hlt with no IDT, so an inbound vec 0x24 would #GP).
//     (3) Per-CPU IRQ counters wired into apic_eoi or the trampoline so
//         the CPU that services vec 0x24 can be observed post-facto.
//     (4) A UART RX byte injection path (like boot_r16_uart_rx uses via
//         chardev pipe) to trigger IRQ 4 delivery on demand.
//   None of these are in place at HEAD; the runtime re-route smoke is
//   filed as follow-up in design/kernel/r21-m3-ioapic-primitives.md §7.
//   The structural witness here proves the machinery is correct — a
//   receiver-side test can then rely on that foundation.
//
// - MADT ISO override application at re-route time. The RTE for IRQ 4 on
//   QEMU q35 has no ISO override (identity gsi=4, active-high edge), so
//   the structural witness cannot detect an ISO-flag translation bug in
//   ioapic_route_irq_via_madt. That module has its own scan-loop
//   structural correctness (see the extensive justification in
//   ioapic_route.pdx) and will be exercised end-to-end when a device
//   whose IRQ IS remapped (e.g. IRQ 0 → GSI 2 on PC-AT PIT wiring) needs
//   routing — filed alongside the receiver-side test above.
//
// ============================================================================
// Safety of always-invoked witness
// ============================================================================
//
// The witness runs on EVERY boot, not just under the boot_r21_ioapic_reroute
// opt-in smoke. This is safe because:
//
//   * The witness saves RTE #4 LO/HI before mutating them, and restores
//     the exact original values on both the pass and fail paths. Any
//     downstream consumer of the RTE (UART RX) sees the state it saw
//     before the witness ran.
//
//   * The mutation happens inside the boot `cli` window — no interrupts
//     can fire during the brief window where RTE #4 has dest=1 instead
//     of dest=0.
//
//   * Even if the reroute-to-CPU-1 window overlapped an interrupt, dest=1
//     is a valid QEMU APIC ID on `-smp 4` (which the boot_smp mode uses)
//     and would simply route the interrupt to a different CPU. Under
//     `-smp 1` (default for most smokes), CPU with APIC ID 1 does not
//     exist — but the interrupt cannot fire mid-witness because IF=0.
//
// The "IOAPIC REROUTE STRUCT OK\n" fingerprint appearing in the default
// boot log does not break any existing fingerprint check (the checkers
// are contains-in-order, extra lines are ignored). The opt-in smoke mode
// boot_r21_ioapic_reroute is what turns the fingerprint into a gated
// smoke assertion.
//
// ============================================================================
// UART markers
// ============================================================================
//
//   Success: "IOAPIC REROUTE STRUCT OK\n"    (24 chars + \n + \0 = 26 bytes)
//   Failure: "IOAPIC REROUTE STRUCT FAIL\n"  (26 chars + \n + \0 = 28 bytes)
//
// Emitted via raw uart_puts (not klog_s1) — same idiom as
// tlb_shootdown_race.pdx and the SMP BRINGUP START/DONE bookends.
// Bypasses klog level/subsystem filtering so the fingerprint appears
// unconditionally in the serial log.

module IoapicRerouteSynth = structure {

  // UART markers (see header §UART markers for byte-count derivation).
  pub let _ioapic_reroute_ok_msg   : [u8; 26] = "IOAPIC REROUTE STRUCT OK\n\0"
  pub let _ioapic_reroute_fail_msg : [u8; 28] = "IOAPIC REROUTE STRUCT FAIL\n\0"

  // ==========================================================================
  // ioapic_reroute_witness() -> ()
  // ==========================================================================
  //
  // Body:
  //   (1) Save current RTE #4 LO (reg 0x18) into r12 via ioapic_read_at.
  //   (2) Save current RTE #4 HI (reg 0x19) into r13 via ioapic_read_at.
  //   (3) Call ioapic_program_redir(0xFEC00000, 4, 0x24, 1, 0) — reroute
  //       IRQ 4 to CPU 1 with vector 0x24 and default flags (fixed / high
  //       / edge / unmasked / physical).
  //   (4) Verify ioapic_program_redir returned 1 (success).
  //   (5) Read back RTE #4 HI, verify dest byte (bits 31:24) == 1.
  //   (6) Read back RTE #4 LO, verify vector byte (bits 7:0) == 0x24 and
  //       mask bit (16) == 0.
  //   (7) Restore RTE #4 HI, then LO via ioapic_write_at.
  //   (8) Emit "IOAPIC REROUTE STRUCT OK\n" on pass, or
  //       "IOAPIC REROUTE STRUCT FAIL\n" on any check miss (after
  //       best-effort state restoration).
  //
  // Register discipline (SysV AMD64):
  //   3-push prologue (rbx=LO scratch during verification, r12=saved LO,
  //   r13=saved HI). rsp%16==8 entry → +24 → rsp%16==0 at each nested
  //   `call` boundary (SysV requirement).

  pub let ioapic_reroute_witness : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R21-M3-004 (#836): structural re-route witness for #833/#834 primitives. Exercises ioapic_read_at / ioapic_write_at / ioapic_program_redir end-to-end against real IOAPIC MMIO at 0xFEC00000. Sequence: (1)(2) capture pre-witness RTE #4 LO/HI via ioapic_read_at into callee-save r12/r13. (3) call ioapic_program_redir(0xFEC00000, 4, 0x24, 1, 0) — reroutes IRQ 4 to CPU 1 vec 0x24 with default flags. (4) require program_redir return 1 (success), else fail. (5) read back HI, extract dest byte (>>24, &0xFF), require == 1. (6) read back LO into rbx, verify vector byte (&0xFF) == 0x24 and mask bit (>>16, &1) == 0 — both required. (7) restore original HI then LO via ioapic_write_at (bypasses program_redir so the restoration exercises the accessor directly, not the compositor). Emit OK or FAIL via raw uart_puts. Runs inside the boot `cli` window (kernel_main invokes it right after SMP BRINGUP DONE, still pre-`sti`) so the transient dest=1 window is inert. Restoration happens on both pass and fail paths so downstream UART RX consumers see the state they left the RTE in. 3-push prologue (rbx/r12/r13) — rsp%16==8 entry → +24 → rsp%16==0 pre-call. r12 (LO save) and r13 (HI save) must survive the intermediate ioapic_program_redir + ioapic_read_at calls (all SysV caller-save-only per their contracts). Encoder: no new mnemonics — mov reg,reg; mov imm; call; cmp; jne; jmp; shl; shr; and; lea rip; ret all pre-#836 proven.",
      block: {
        push rbx;
        push r12;
        push r13;

        // (1) Save RTE #4 LO (reg 0x18).
        mov rdi, 0xFEC00000;
        mov rsi, 0x18;
        call ioapic_read_at;
        mov r12, rax;

        // (2) Save RTE #4 HI (reg 0x19).
        mov rdi, 0xFEC00000;
        mov rsi, 0x19;
        call ioapic_read_at;
        mov r13, rax;

        // (3) Reroute IRQ 4 to CPU 1 with vector 0x24, default flags.
        mov rdi, 0xFEC00000;
        mov rsi, 4;
        mov rdx, 0x24;
        mov rcx, 1;
        mov r8, 0;
        call ioapic_program_redir;

        // (4) program_redir must return 1 (success).
        cmp rax, 1;
        jne ioapic_reroute_fail;

        // (5) Read back HI, verify dest byte == 1.
        mov rdi, 0xFEC00000;
        mov rsi, 0x19;
        call ioapic_read_at;
        shr rax, 24;
        and rax, 0xFF;
        cmp rax, 1;
        jne ioapic_reroute_fail;

        // (6) Read back LO into rbx, verify vector + mask.
        mov rdi, 0xFEC00000;
        mov rsi, 0x18;
        call ioapic_read_at;
        mov rbx, rax;

        // Vector (bits 7:0) == 0x24.
        mov rcx, rbx;
        and rcx, 0xFF;
        cmp rcx, 0x24;
        jne ioapic_reroute_fail;

        // Mask bit (16) == 0.
        mov rcx, rbx;
        shr rcx, 16;
        and rcx, 1;
        cmp rcx, 0;
        jne ioapic_reroute_fail;

        // (7) Restore original HI then LO.
        mov rdi, 0xFEC00000;
        mov rsi, 0x19;
        mov rdx, r13;
        call ioapic_write_at;

        mov rdi, 0xFEC00000;
        mov rsi, 0x18;
        mov rdx, r12;
        call ioapic_write_at;

        // (8) Pass — emit OK.
        lea rdi, [rip + _ioapic_reroute_ok_msg];
        call uart_puts;
        jmp ioapic_reroute_done;

      ioapic_reroute_fail:
        // Best-effort restoration on failure path.
        mov rdi, 0xFEC00000;
        mov rsi, 0x19;
        mov rdx, r13;
        call ioapic_write_at;

        mov rdi, 0xFEC00000;
        mov rsi, 0x18;
        mov rdx, r12;
        call ioapic_write_at;

        lea rdi, [rip + _ioapic_reroute_fail_msg];
        call uart_puts;

      ioapic_reroute_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
