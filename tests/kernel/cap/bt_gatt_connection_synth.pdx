// tests/kernel/cap/bt_gatt_connection_synth.pdx — R39.M3-003 (#1333)
//
// Boot witness for KIND_BT_GATT_CONNECTION.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, MTU / addr / state /
// sec validators, rights subset refuse, uniqueness on conn_key, state
// transition discipline, mint / revoke round-trip.
//
// Fingerprint: R39 KIND_BT_GATT_CONNECTION OK
//
// Cap slots 96..111.

module BtGattConnectionSynth = structure {

  pub let mut _kbgcw_stage : u64 = 0

  pub let kbgcw_ok   : [u8; 28] = "KIND_BT_GATT_CONNECTION OK\n\0"
  pub let kbgcw_fail : [u8; 30] = "KIND_BT_GATT_CONNECTION FAIL\n\0"

  pub let kbgcw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): clear cap_table slots 96..111.",
      block: {
        push rbx;
        mov rbx, 96;
      kbgcwc_loop:
        cmp rbx, 112;
        jae kbgcwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kbgcwc_loop;
      kbgcwc_done:
        pop rbx;
        ret
      }
    }

  pub let kbgcw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): reset BT GATT CONNECTION row table.",
      block: {
        call bt_gatt_conn_table_reset;
        ret
      }
    }

  pub let kbgcw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bt_gatt_conn_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R39.M3-003 (#1333): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_MTU. (4) BAD_ADDR. (5) BAD_RIGHTS (subset trip). (6) Happy path. (7) Query fields. (8) IN_USE. (9) Transition DISCONNECTED -> CONNECTING. (10) Bad transition (CONNECTING -> ENCRYPTED). (11) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        call kbgcw_clear;
        call kbgcw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kbgc_state_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;
        mov rdi, 3;
        call kbgc_state_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;
        mov rdi, 4;
        call kbgc_state_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // sec_valid
        mov rdi, 3;
        call kbgc_sec_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;
        mov rdi, 4;
        call kbgc_sec_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // mtu_valid
        mov rdi, 23;
        call kbgc_mtu_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;
        mov rdi, 22;
        call kbgc_mtu_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;
        mov rdi, 517;
        call kbgc_mtu_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;
        mov rdi, 518;
        call kbgc_mtu_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // addr_valid
        mov rdi, 0;
        call kbgc_addr_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;
        mov rdi, 0x001122334455;
        call kbgc_addr_valid;
        cmp rax, 1;
        jne kbgcw_fail_stage;

        // rights_valid: R_MINT bit outside mask
        mov rdi, 0x200;
        call kbgc_rights_valid;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at slot 97.
        mov rdi, 97;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call kbgcw_seed_endpoint;

        // packed_v = mtu[15:0] | state[23:16] | sec[31:24].
        // mtu=185, state=0 (DISCONNECTED), sec=2 (AUTHENTICATED).
        // = 0xB9 | (0 << 16) | (2 << 24) = 0x020000B9
        mov r15, 0x020000B9;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        mov rsi, 96;                     // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE30;
        mov r8, r15;
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        mov r11, 0xFFFFF32D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 3. BAD_MTU.
        mov rax, 3;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE31;
        mov r8, 0x02000010;              // mtu=16 (< 23)
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        mov r11, 0xFFFFF32A;             // MINT_BAD_MTU
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 4. BAD_ADDR (zero BD_ADDR).
        mov rax, 4;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE32;
        mov r8, r15;
        mov r9, 0;                       // BD_ADDR zero
        call bt_gatt_conn_cap_mint_inner;
        mov r11, 0xFFFFF32B;             // MINT_BAD_ADDR
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 5. BAD_RIGHTS (bit outside R_KBGC_ALL).
        mov rax, 5;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        mov rsi, 97;
        mov rdx, 0x81B;                  // 0x800 outside 0x41B
        mov rcx, 0xC0FFEE33;
        mov r8, r15;
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        mov r11, 0xFFFFF32C;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;
        mov r8, r15;
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // -- 7. Query fields.
        mov rax, 7;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kbgc_row_key;
        mov r11, 0xC0FFEE34;
        cmp rax, r11;
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_endpoint;
        cmp rax, 97;
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_mtu;
        cmp rax, 185;
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_state;
        cmp rax, 0;                      // DISCONNECTED
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_sec;
        cmp rax, 2;                      // AUTHENTICATED
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_addr;
        mov r11, 0x001122334455;
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 8. IN_USE (duplicate conn_key).
        mov rax, 8;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;             // same key
        mov r8, r15;
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        mov r11, 0xFFFFF325;             // MINT_IN_USE
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 9. Transition DISCONNECTED -> CONNECTING.
        mov rax, 9;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // CONNECTING
        call kbgc_row_transition;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        mov rdi, 0;
        call kbgc_row_state;
        cmp rax, 1;
        jne kbgcw_fail_stage;

        // -- 10. Bad transition CONNECTING -> ENCRYPTED (must go via CONNECTED).
        mov rax, 10;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;                      // ENCRYPTED (illegal from CONNECTING)
        call kbgc_row_transition;
        mov r11, 0xFFFFF321;             // BAD_TRANSITION
        cmp rax, r11;
        jne kbgcw_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _kbgcw_stage];
        mov [rcx], rax;

        mov rdi, 98;
        call bt_gatt_conn_cap_revoke_inner;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        mov rdi, 98;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE34;             // key free after revoke
        mov r8, r15;
        mov r9, 0x001122334455;
        call bt_gatt_conn_cap_mint_inner;
        cmp rax, 0;
        jne kbgcw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbgcw_ok];
        call klog_s1;

        call kbgcw_scrub;
        call kbgcw_clear;
        xor rax, rax;
        jmp kbgcw_out;

      kbgcw_fail_stage:
        lea rax, [rip + _kbgcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbgcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kbgcw_scrub;
        call kbgcw_clear;
        mov rax, 1;

      kbgcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
