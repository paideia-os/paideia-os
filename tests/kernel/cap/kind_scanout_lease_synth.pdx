// tests/kernel/cap/kind_scanout_lease_synth.pdx -- G2.M1-001 (#1443)
//                                                  + G2.M1-005 (#1447)
//
// Boot witness for KIND_SCANOUT_LEASE. Exercises validators, tail
// alloc happy path, row accessors, state transitions, reserved-plane
// refusal (P8), and refusal edges.
//
// Fingerprint: G2 KIND_SCANOUT_LEASE OK

module KindScanoutLeaseSynth = structure {

  pub let mut _slw_stage : u64 = 0

  pub let slw_ok   : [u8; 23] = "KIND_SCANOUT_LEASE OK\0"
  pub let slw_fail : [u8; 25] = "KIND_SCANOUT_LEASE FAIL\0"

  pub let kind_scanout_lease_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G2.M1-001 (#1443) + G2.M1-005 (#1447): boot witness. Stages: (1) reset. (2) rights validator (R_SL_ALL ok, R_MINT no). (3) output_valid (0 refused; 1 ok; 256 refused). (4) timeline_valid (0 refused; 1 ok). (5) expiry_valid (0 refused; 1 ok). (6) state_valid (0 refused; 1..3 ok; 4 refused). (7) reserved_plane (0 yes, 1 no). (8) body1_pack + tail_alloc happy for (out=3, tl=5, plane=7, state=1, key=0xABCD, expiry=1000000). (9) row accessors. (10) find_by_key hits; find_by_plane hits. (11) row_transition GRANTED->REVOKED ok; second attempt refused (not GRANTED). (12) tail_free. (13) find_by_key returns ROW_NONE after free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        call sl_table_reset;
        call scanout_reset;

        // 2. rights_valid.
        mov rax, 2;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0x419;
        call sl_rights_valid;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 0x200;
        call sl_rights_valid;
        cmp rax, 0;
        jne slw_fail_stage;

        // 3. output_valid.
        mov rax, 3;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_output_valid;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 1;
        call sl_output_valid;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 256;
        call sl_output_valid;
        cmp rax, 0;
        jne slw_fail_stage;

        // 4. timeline_valid.
        mov rax, 4;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_timeline_valid;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 1;
        call sl_timeline_valid;
        cmp rax, 1;
        jne slw_fail_stage;

        // 5. expiry_valid.
        mov rax, 5;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_expiry_valid;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 1;
        call sl_expiry_valid;
        cmp rax, 1;
        jne slw_fail_stage;

        // 6. state_valid.
        mov rax, 6;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_state_valid;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 1;
        call sl_state_valid;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 3;
        call sl_state_valid;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 4;
        call sl_state_valid;
        cmp rax, 0;
        jne slw_fail_stage;

        // 7. reserved_plane (P8).
        mov rax, 7;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_reserved_plane;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 1;
        call sl_reserved_plane;
        cmp rax, 0;
        jne slw_fail_stage;

        // 8. body1_pack + tail_alloc happy.
        mov rax, 8;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // output_slot
        mov rsi, 5;                      // timeline_slot
        mov rdx, 7;                      // plane_slot
        mov rcx, 1;                      // state = GRANTED
        call sl_body1_pack;
        mov r12, rax;                    // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  slw_fail_stage;
        mov rdi, 0;                      // hdr (plane 0 -> parent_slot 0)
        mov rsi, 0xABCD;                 // lease_key
        mov rdx, r12;                    // body1
        mov rcx, 1000000;                // expiry_ns
        call sl_tail_alloc;
        cmp rax, 0;
        jne slw_fail_stage;

        // 9. row accessors.
        mov rax, 9;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_row_key;
        mov r10, 0xABCD;
        cmp rax, r10;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_output;
        cmp rax, 3;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_timeline;
        cmp rax, 5;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_plane;
        cmp rax, 7;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_state;
        cmp rax, 1;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_expiry;
        mov r10, 1000000;
        cmp rax, r10;
        jne slw_fail_stage;

        // 10. find_by_key + find_by_plane.
        mov rax, 10;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0xABCD;
        call sl_find_by_key;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 7;
        call sl_find_by_plane;
        cmp rax, 0;
        jne slw_fail_stage;

        // 11. row_transition GRANTED->REVOKED then refuse.
        mov rax, 11;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 2;                      // REVOKED
        call sl_row_transition;
        cmp rax, 0;
        jne slw_fail_stage;
        mov rdi, 0;
        call sl_row_state;
        cmp rax, 2;
        jne slw_fail_stage;
        mov rdi, 0;
        mov rsi, 3;                      // EXPIRED (from REVOKED refused)
        call sl_row_transition;
        mov r10, 0xFFFFF61C;
        cmp rax, r10;
        jne slw_fail_stage;

        // 12. tail_free.
        mov rax, 12;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call sl_tail_free;
        mov rdi, 0;
        call sl_tail_valid;
        cmp rax, 0;
        jne slw_fail_stage;

        // 13. find_by_key none after free.
        mov rax, 13;
        lea rcx, [rip + _slw_stage];
        mov [rcx], rax;
        mov rdi, 0xABCD;
        call sl_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne slw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slw_ok];
        call klog_s1;

        call sl_table_reset;
        call scanout_reset;
        xor rax, rax;
        jmp slw_out;

      slw_fail_stage:
        lea rax, [rip + _slw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + slw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call sl_table_reset;
        call scanout_reset;
        mov rax, 1;

      slw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
