// tests/kernel/cap/kind_elevate_channel_synth.pdx -- R48b substrate-prep (#1626)
//
// Boot witness for KIND_ELEVATE_CHANNEL.
//
// Fingerprint: R48b KIND_ELEVATE_CHANNEL OK
//
// Cap slots 116..118.

module KindElevateChannelSynth = structure {

  pub let mut _elvcw_stage : u64 = 0

  pub let elvcw_ok   : [u8; 25] = "KIND_ELEVATE_CHANNEL OK\0"
  pub let elvcw_fail : [u8; 27] = "KIND_ELEVATE_CHANNEL FAIL\0"

  pub let elvcw_ep : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): mint a synthetic KIND_IPC_ENDPOINT parent. Target_ptr low 16 bits = endpoint_id (matches endpoint_table.pdx §layout at R20b.M1-001), which the mint walker later reads to populate broker_endpoint_id. Labels prefixed elvcw_e_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x00B;                  // R_IPC_ALL (READ|WRITE|INVOKE)
        mov rcx, r13;                    // target_ptr = endpoint_id
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let elvcw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): clear cap_table slots 116..118. Labels prefixed elvcw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 116;
      elvcw_c_loop:
        cmp rbx, 119;
        jae elvcw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp elvcw_c_loop;
      elvcw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_elevate_channel_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R48b substrate-prep (#1626): boot witness. Five callee-save pushes leave rsp%16 == 0. Labels prefixed elvcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        call elvcw_clear;
        call elevate_channel_table_reset;

        mov rdi, 116;
        mov rsi, 0x0042;                 // broker endpoint id
        call elvcw_ep;
        mov rdi, 117;                    // wrong kind
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, 0x418;
        call elevate_channel_rights_valid;
        cmp rax, 1;
        jne elvcw_fail_stage;
        mov rdi, 0x200;                  // R_MINT (deliberately absent)
        call elevate_channel_rights_valid;
        cmp rax, 0;
        jne elvcw_fail_stage;

        // (3) parent gate.
        mov rax, 3;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, 116;
        call elevate_channel_check_parent_endpoint;
        cmp rax, 1;
        jne elvcw_fail_stage;
        mov rdi, 117;                    // wrong kind
        call elevate_channel_check_parent_endpoint;
        cmp rax, 0;
        jne elvcw_fail_stage;

        // (4) Mint success. request_id=0xR001, pid=0x100,
        //     target_cap_kind=KIND_PDXFS_FILE (0x195),
        //     target_cap_rights=R_PDXFS_FILE_WRITE|INVOKE = 0x00A.
        mov rax, 4;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, 116;
        mov rsi, 0x418;
        mov rdx, 0xE001;                 // request_id
        mov rcx, 0x100;                  // requester_pid
        mov r8,  0x195;                  // target_cap_kind
        mov r9,  0x00A;                  // target_cap_rights
        call elevate_channel_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae elvcw_fail_stage;
        mov r12, rax;

        mov rdi, r12;
        call elevate_channel_row_req;
        mov r11, 0xE001;
        cmp rax, r11;
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_pid;
        cmp rax, 0x100;
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_kind;
        mov r11, 0x195;
        cmp rax, r11;
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_rights;
        cmp rax, 0x00A;
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_state;
        cmp rax, 1;                      // REQUESTED
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_expire;
        cmp rax, 0;                      // default
        jne elvcw_fail_stage;

        mov rdi, r12;
        call elevate_channel_row_broker;
        cmp rax, 0x0042;                 // pulled from parent endpoint tail
        jne elvcw_fail_stage;

        // (5) BAD_REQ.
        mov rax, 5;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, 116;
        mov rsi, 0x418;
        xor rdx, rdx;
        mov rcx, 0x101;
        mov r8,  0x195;
        mov r9,  0x00A;
        call elevate_channel_cap_mint_inner;
        mov r10, 0xFFFFEC0B;             // ELVC_MINT_BAD_REQ
        cmp rax, r10;
        jne elvcw_fail_stage;

        // (6) BAD_PARENT.
        mov rax, 6;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, 117;                    // wrong kind
        mov rsi, 0x418;
        mov rdx, 0xE002;
        mov rcx, 0x100;
        mov r8,  0x195;
        mov r9,  0x00A;
        call elevate_channel_cap_mint_inner;
        mov r10, 0xFFFFEC0D;             // ELVC_MINT_BAD_PARENT
        cmp rax, r10;
        jne elvcw_fail_stage;

        // (7) revoke happy + already dead.
        mov rax, 7;
        lea rcx, [rip + _elvcw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call elevate_channel_cap_revoke;
        cmp rax, 0;
        jne elvcw_fail_stage;
        mov rdi, r12;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        jne elvcw_fail_stage;
        mov rdi, r12;
        call elevate_channel_cap_revoke;
        mov r10, 0xFFFFEC06;             // ELVC_REVOKE_ALREADY
        cmp rax, r10;
        jne elvcw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvcw_ok];
        call klog_s1;

        call elvcw_clear;
        call elevate_channel_table_reset;
        xor rax, rax;
        jmp elvcw_out;

      elvcw_fail_stage:
        lea rax, [rip + _elvcw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + elvcw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call elvcw_clear;
        call elevate_channel_table_reset;
        mov rax, 1;

      elvcw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
