// tests/kernel/cap/display_output_synth.pdx — R36.M2-003 (#1241)
//
// Boot witness for KIND_DISPLAY_OUTPUT.
//
// Asserts derivation gate over KIND_DEVICE, ddi / type / connected
// refusals, engine-slot liveness (NO_ENGINE), uniqueness on
// output_key, and mint / revoke round-trip.
//
// Fingerprint: R36 KIND_DISPLAY_OUTPUT OK
//
// Cap slots 8..23 — reused from the low range after every prior
// witness's scrub. R30..R35 filled 46..255 and each scrubs on
// exit, so slots 8..23 are known clean at entry. Every exit path
// here also scrubs so nothing bleeds into later R36 witnesses.

module DisplayOutputSynth = structure {

  pub let mut _dpow_stage : u64 = 0

  pub let dpow_ok   : [u8; 24] = "KIND_DISPLAY_OUTPUT OK\0"
  pub let dpow_fail : [u8; 26] = "KIND_DISPLAY_OUTPUT FAIL\0"

  pub let dpow_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): clear cap_table slots 8..23.",
      block: {
        push rbx;
        mov rbx, 8;
      dpowc_loop:
        cmp rbx, 24;
        jae dpowc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp dpowc_loop;
      dpowc_done:
        pop rbx;
        ret
      }
    }

  pub let dpow_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): reset display output + engine row tables.",
      block: {
        push rbx;
        call display_output_table_reset;
        call display_engine_table_reset;
        pop rbx;
        ret
      }
    }

  // Synthesize KIND_DEVICE at `slot`.
  pub let dpow_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (device_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): synthetic KIND_DEVICE for gate testing.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // Mint a live KIND_DISPLAY_ENGINE at `engine_slot`.
  pub let dpow_engine : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (engine_slot: u64) (device_slot: u64) (engine_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): mint a live KIND_DISPLAY_ENGINE via display_engine_cap_mint_inner. Rights 0x419, bdf=0x0100, gen=2 (Xe2), power=1 (ON), cdclk=540000.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // engine_slot
        mov r13, rsi;                    // device_slot
        mov r14, rdx;                    // engine_key

        // packed_ident: bdf[15:0] | gen[23:16] | pwr[31:24] | cdclk[63:32]
        mov r10, 0x0100;
        mov r11, 2;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 540000;
        shl r11, 32;
        or  r10, r11;

        mov rdi, r12;                    // engine slot
        mov rsi, r13;                    // parent device slot
        mov rdx, 0x419;                  // rights
        mov rcx, r14;                    // engine_key
        mov r8, r13;                     // device_slot (same as parent here)
        mov r9, r10;
        call display_engine_cap_mint_inner;

        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let display_output_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R36.M2-003 (#1241): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) NO_DEVICE. (4) NO_ENGINE. (5) Happy path. (6) Query fields. (7) IN_USE. (8) BAD_TYPE. (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        call dpow_clear;
        call dpow_scrub;

        // -- 1. Validators.
        mov rdi, 7;
        call display_output_ddi_valid;
        cmp rax, 1;
        jne dpow_fail_stage;
        mov rdi, 8;
        call display_output_ddi_valid;
        cmp rax, 0;
        jne dpow_fail_stage;

        mov rdi, 3;
        call display_output_type_valid;
        cmp rax, 1;
        jne dpow_fail_stage;
        mov rdi, 4;
        call display_output_type_valid;
        cmp rax, 0;
        jne dpow_fail_stage;

        mov rdi, 1;
        call display_output_connected_valid;
        cmp rax, 1;
        jne dpow_fail_stage;
        mov rdi, 2;
        call display_output_connected_valid;
        cmp rax, 0;
        jne dpow_fail_stage;

        mov rdi, 0x419;
        call display_output_rights_valid;
        cmp rax, 1;
        jne dpow_fail_stage;
        mov rdi, 0x200;
        call display_output_rights_valid;
        cmp rax, 0;
        jne dpow_fail_stage;

        // Setup: KIND_DEVICE at 9 with key 0xC0FFEE02.
        mov rdi, 9;
        mov rsi, 0x200;
        mov rdx, 0xC0FFEE02;
        call dpow_device;

        // KIND_DISPLAY_ENGINE at 10.
        mov rdi, 10;
        mov rsi, 9;
        mov rdx, 0xBEEF0001;
        call dpow_engine;
        cmp rax, 0;
        jne dpow_fail_stage;

        // packed_ident for OUTPUT:
        //   [15:0]  engine_slot = 10
        //   [23:16] ddi = 0
        //   [31:24] type = 1 (DP)
        //   [39:32] connected = 1
        //   [63:40] edid_hash = 0

        // -- 2. BAD_PARENT (parent slot 8 empty).
        mov rax, 2;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov r10, 10;
        mov r11, 0;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 11;
        mov rsi, 8;                    // empty
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        mov r11, 0xFFFFF78D;             // BAD_PARENT
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 3. NO_DEVICE (device target_ptr == 0).
        mov rax, 3;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov rdi, 12;
        mov rsi, 0x200;
        mov rdx, 0;
        call dpow_device;

        mov r10, 10;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 11;
        mov rsi, 12;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        mov r11, 0xFFFFF788;             // NO_DEVICE
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 4. NO_ENGINE (engine_slot names empty slot 13).
        mov rax, 4;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov r10, 13;                    // no engine at 13
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 11;
        mov rsi, 9;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        mov r11, 0xFFFFF787;             // NO_ENGINE
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 5. Happy path.
        mov rax, 5;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov r10, 10;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 11;
        mov rsi, 9;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        cmp rax, 0;
        jne dpow_fail_stage;

        // -- 6. Query fields.
        mov rax, 6;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        // Row 0 should now hold DDI=0, type=1, connected=1.
        mov rdi, 0;
        call display_output_row_ddi;
        cmp rax, 0;
        jne dpow_fail_stage;

        mov rdi, 0;
        call display_output_row_type;
        cmp rax, 1;
        jne dpow_fail_stage;

        mov rdi, 0;
        call display_output_row_connected;
        cmp rax, 1;
        jne dpow_fail_stage;

        mov rdi, 0;
        call display_output_row_key;
        mov r11, 0xDEAD0001;
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 7. IN_USE (duplicate key).
        mov rax, 7;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov r10, 10;
        mov r11, 1;
        shl r11, 16;                     // ddi=1
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 14;
        mov rsi, 9;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;             // duplicate key
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        mov r11, 0xFFFFF784;             // IN_USE
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 8. BAD_TYPE (type = 4).
        mov rax, 8;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov r10, 10;
        mov r11, 1;
        shl r11, 16;
        or  r10, r11;
        mov r11, 4;                      // BAD type
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 14;
        mov rsi, 9;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0002;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        mov r11, 0xFFFFF78A;             // BAD_TYPE
        cmp rax, r11;
        jne dpow_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _dpow_stage];
        mov [rcx], rax;

        mov rdi, 11;
        call display_output_cap_revoke_inner;
        cmp rax, 0;
        jne dpow_fail_stage;

        mov r10, 10;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;

        mov rdi, 11;
        mov rsi, 9;
        mov rdx, 0x419;
        mov rcx, 0xDEAD0001;             // key free again
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call display_output_cap_mint_inner;
        cmp rax, 0;
        jne dpow_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpow_ok];
        call klog_s1;

        call dpow_scrub;
        call dpow_clear;
        xor rax, rax;
        jmp dpow_out;

      dpow_fail_stage:
        lea rax, [rip + _dpow_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dpow_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpow_scrub;
        call dpow_clear;
        mov rax, 1;

      dpow_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
