// tests/kernel/cap/bt_pairing_synth.pdx — R39.M4-002 (#1336)
//
// Boot witness for KIND_BT_PAIRING (SEALED).
//
// SEALED TRIPLE-CHECK exercised:
//   gate 1: R_BTP_READ (0x001) is absent from R_BTP_ALL (0x418) --
//           a mint carrying R_READ trips btp_rights_valid.
//   gate 2: NO OP EXPOSES LTK MATERIAL -- op set enumerated, above
//           BTP_OP_MAX returns UNSUPPORTED; queries expose identity
//           only, and BIND_TO_LINK is a honesty pin.
//   gate 3: sealed_flag reads back as 1 on the live row.
//
// Fingerprint: R39 KIND_BT_PAIRING OK
//
// Cap slots 480..487.

module BtPairingSynth = structure {

  pub let mut _btpw_stage : u64 = 0

  pub let btpw_ok   : [u8; 24] = "R39 KIND_BT_PAIRING OK\n\0"
  pub let btpw_fail : [u8; 26] = "R39 KIND_BT_PAIRING FAIL\n\0"

  pub let btpw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): clear cap_table slots 480..487.",
      block: {
        push rbx;
        mov rbx, 480;
      btpwc_loop:
        cmp rbx, 488;
        jae btpwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp btpwc_loop;
      btpwc_done:
        pop rbx;
        ret
      }
    }

  pub let btpw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): reset KIND_BT_PAIRING row table.",
      block: {
        call bt_pairing_table_reset;
        ret
      }
    }

  pub let btpw_seed_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): synthetic KIND_MEMORY (=4) at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bt_pairing_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R39.M4-002 (#1336): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_MEMORY. (4) BAD_RIGHTS + SEALED gate 1: R_READ tripped. (5) BAD_ALGO. (6) BAD_BOND. (7) BAD_PEER. (8) NO_KEY. (9) Happy path. (10) Query fields incl. sealed_flag==1 (SEALED gate 3). (11) IN_USE. (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        call btpw_clear;
        call btpw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call btp_algo_valid;
        cmp rax, 1;
        jne btpw_fail_stage;
        mov rdi, 1;
        call btp_algo_valid;
        cmp rax, 1;
        jne btpw_fail_stage;
        mov rdi, 2;
        call btp_algo_valid;
        cmp rax, 0;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_bond_valid;
        cmp rax, 1;
        jne btpw_fail_stage;
        mov rdi, 1;
        call btp_bond_valid;
        cmp rax, 1;
        jne btpw_fail_stage;
        mov rdi, 2;
        call btp_bond_valid;
        cmp rax, 0;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_peer_valid;
        cmp rax, 0;
        jne btpw_fail_stage;
        mov rdi, 0x001122334455;
        call btp_peer_valid;
        cmp rax, 1;
        jne btpw_fail_stage;

        // SEALED gate 1: R_READ bit is OUTSIDE R_BTP_ALL.
        mov rdi, 0x001;
        call btp_rights_valid;
        cmp rax, 0;
        jne btpw_fail_stage;

        // R_MINT bit is OUTSIDE R_BTP_ALL too.
        mov rdi, 0x200;
        call btp_rights_valid;
        cmp rax, 0;
        jne btpw_fail_stage;

        // Setup: KIND_MEMORY at 481 (parent, RIGHT_MINT) and 482 (memory_slot).
        mov rdi, 481;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call btpw_seed_memory;

        mov rdi, 482;
        mov rsi, 0x11;
        mov rdx, 0x1000;
        call btpw_seed_memory;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        // Pack meta: algo=0, bond=1, peer=0x001122334455.
        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0x001122334455;
        call btp_meta_pack;
        mov r15, rax;                    // save meta

        mov rdi, 483;
        mov rsi, 480;                    // empty parent
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE00;
        mov r8,  482;
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2FD;             // BAD_PARENT
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 3. BAD_MEMORY.
        mov rax, 3;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE01;
        mov r8,  485;                    // empty memory
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2FB;             // BAD_MEMORY
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 4. BAD_RIGHTS + SEALED gate 1: R_READ tripped.
        mov rax, 4;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x419;                  // R_READ (0x001) tripped
        mov rcx, 0xBEEFC0DE02;
        mov r8,  482;
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2FC;             // BAD_RIGHTS
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 5. BAD_ALGO.
        mov rax, 5;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 2;                      // algo out of range
        mov rsi, 1;
        mov rdx, 0x001122334455;
        call btp_meta_pack;
        mov r14, rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE03;
        mov r8,  482;
        mov r9,  r14;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2F9;             // BAD_ALGO
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 6. BAD_BOND.
        mov rax, 6;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 2;                      // bond out of range
        mov rdx, 0x001122334455;
        call btp_meta_pack;
        mov r14, rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE04;
        mov r8,  482;
        mov r9,  r14;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2F8;             // BAD_BOND
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 7. BAD_PEER (zero BD_ADDR).
        mov rax, 7;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;
        mov rdx, 0;                      // peer zero
        call btp_meta_pack;
        mov r14, rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE05;
        mov r8,  482;
        mov r9,  r14;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2FA;             // BAD_PEER
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 8. NO_KEY.
        mov rax, 8;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0;                      // pair_key = 0
        mov r8,  482;
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2F7;             // NO_KEY
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 9. Happy path.
        mov rax, 9;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE09;
        mov r8,  482;
        mov r9,  r15;                    // algo=0, bond=1, peer=0x0011..55
        call bt_pairing_cap_mint_inner;
        cmp rax, 0;
        jne btpw_fail_stage;

        // -- 10. Query fields incl. sealed_flag (SEALED gate 3).
        mov rax, 10;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // row 0
        call btp_row_key;
        mov r11, 0xBEEFC0DE09;
        cmp rax, r11;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_row_memory;
        cmp rax, 482;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_row_algo;
        cmp rax, 0;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_row_bond;
        cmp rax, 1;
        jne btpw_fail_stage;

        mov rdi, 0;
        call btp_row_peer;
        mov r11, 0x001122334455;
        cmp rax, r11;
        jne btpw_fail_stage;

        // SEALED GATE 3: sealed_flag reads back as 1.
        mov rdi, 0;
        call btp_row_sealed_flag;
        cmp rax, 1;
        jne btpw_fail_stage;

        // -- 11. IN_USE (duplicate pair_key).
        mov rax, 11;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 484;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE09;           // same key
        mov r8,  482;
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        mov r11, 0xFFFFF2F6;             // IN_USE
        cmp rax, r11;
        jne btpw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _btpw_stage];
        mov [rcx], rax;

        mov rdi, 483;
        call bt_pairing_cap_revoke_inner;
        cmp rax, 0;
        jne btpw_fail_stage;

        mov rdi, 483;
        mov rsi, 481;
        mov rdx, 0x418;
        mov rcx, 0xBEEFC0DE09;           // key free after revoke
        mov r8,  482;
        mov r9,  r15;
        call bt_pairing_cap_mint_inner;
        cmp rax, 0;
        jne btpw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + btpw_ok];
        call klog_s1;

        call btpw_scrub;
        call btpw_clear;
        xor rax, rax;
        jmp btpw_out;

      btpw_fail_stage:
        lea rax, [rip + _btpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + btpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call btpw_scrub;
        call btpw_clear;
        mov rax, 1;

      btpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
