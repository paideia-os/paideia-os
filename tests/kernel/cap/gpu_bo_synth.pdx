// tests/kernel/cap/gpu_bo_synth.pdx — R37.M3-001 (#1262)
//
// Boot witness for KIND_GPU_BO.
//
// Asserts derivation gate over KIND_MEMORY, tiling / cache / size
// refusals, uniqueness on bo_key, and mint / revoke round-trip.
//
// Fingerprint: R37 KIND_GPU_BO OK
//
// Cap slots 336..351.

module GpuBoSynth = structure {

  pub let mut _kgbw_stage : u64 = 0

  pub let kgbw_ok   : [u8; 20] = "R37 KIND_GPU_BO OK\n\0"
  pub let kgbw_fail : [u8; 22] = "R37 KIND_GPU_BO FAIL\n\0"

  pub let kgbw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): clear cap_table slots 336..351.",
      block: {
        push rbx;
        mov rbx, 336;
      kgbwc_loop:
        cmp rbx, 352;
        jae kgbwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kgbwc_loop;
      kgbwc_done:
        pop rbx;
        ret
      }
    }

  pub let kgbw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): reset GPU BO row table.",
      block: {
        call gpu_bo_table_reset;
        ret
      }
    }

  pub let kgbw_memory : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (memory_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): synthetic KIND_MEMORY at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let gpu_bo_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R37.M3-001 (#1262): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_TILING. (4) BAD_CACHE. (5) BAD_SIZE (size=0). (6) Happy path. (7) Query fields. (8) IN_USE. (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        call kgbw_clear;
        call kgbw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kgb_tiling_valid;
        cmp rax, 1;
        jne kgbw_fail_stage;
        mov rdi, 5;                      // over max (4)
        call kgb_tiling_valid;
        cmp rax, 0;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_cache_valid;
        cmp rax, 1;
        jne kgbw_fail_stage;
        mov rdi, 4;                      // over max (3)
        call kgb_cache_valid;
        cmp rax, 0;
        jne kgbw_fail_stage;

        mov rdi, 4096;
        call kgb_size_valid;
        cmp rax, 1;
        jne kgbw_fail_stage;
        mov rdi, 0;
        call kgb_size_valid;
        cmp rax, 0;
        jne kgbw_fail_stage;

        // Setup: KIND_MEMORY at 337.
        mov rdi, 337;
        mov rsi, 0x200;
        mov rdx, 0xC00F0002;
        call kgbw_memory;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        // packed_all: size=65536 | tiling=0 | cache=0 | format_hint=0
        mov r10, 65536;                  // size
        mov r11, 0;                      // tiling
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;                      // cache
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;                      // format_hint
        shl r11, 48;
        or  r10, r11;
        mov r15, r10;                    // stash

        mov rdi, 338;
        mov rsi, 336;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1001;
        mov r8, 337;
        mov r9, r15;
        call gpu_bo_cap_mint_inner;
        mov r11, 0xFFFFF64D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kgbw_fail_stage;

        // -- 3. BAD_TILING (tiling=5).
        mov rax, 3;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov r10, 65536;
        mov r11, 5;                      // bad tiling
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 338;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1002;
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        mov r11, 0xFFFFF64B;             // MINT_BAD_TILING
        cmp rax, r11;
        jne kgbw_fail_stage;

        // -- 4. BAD_CACHE (cache=4).
        mov rax, 4;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov r10, 65536;
        mov r11, 0;
        shl r11, 32;
        or  r10, r11;
        mov r11, 4;                      // bad cache
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 338;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1003;
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        mov r11, 0xFFFFF64A;             // MINT_BAD_CACHE
        cmp rax, r11;
        jne kgbw_fail_stage;

        // -- 5. BAD_SIZE (size=0).
        mov rax, 5;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov r10, 0;                      // size = 0
        mov r11, 0;
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 338;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1004;
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        mov r11, 0xFFFFF649;             // MINT_BAD_SIZE
        cmp rax, r11;
        jne kgbw_fail_stage;

        // -- 6. Happy path (size=65536, LINEAR, WB).
        mov rax, 6;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov r10, 65536;                  // size
        mov r11, 0;                      // LINEAR
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;                      // WB
        shl r11, 40;
        or  r10, r11;
        mov r11, 0x1234;                 // format_hint
        shl r11, 48;
        or  r10, r11;

        mov rdi, 338;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1005;
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        cmp rax, 0;
        jne kgbw_fail_stage;

        // -- 7. Query fields.
        mov rax, 7;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kgb_row_key;
        mov r11, 0xBEEF1005;
        cmp rax, r11;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_row_memory;
        cmp rax, 337;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_row_size;
        cmp rax, 65536;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_row_tiling;
        cmp rax, 0;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_row_cache;
        cmp rax, 0;
        jne kgbw_fail_stage;

        mov rdi, 0;
        call kgb_row_format;
        cmp rax, 0x1234;
        jne kgbw_fail_stage;

        // -- 8. IN_USE (duplicate key).
        mov rax, 8;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov r10, 65536;
        mov r11, 0;
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 339;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1005;             // duplicate key
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        mov r11, 0xFFFFF645;             // MINT_IN_USE
        cmp rax, r11;
        jne kgbw_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _kgbw_stage];
        mov [rcx], rax;

        mov rdi, 338;
        call gpu_bo_cap_revoke_inner;
        cmp rax, 0;
        jne kgbw_fail_stage;

        mov r10, 65536;
        mov r11, 0;
        shl r11, 32;
        or  r10, r11;
        mov r11, 0;
        shl r11, 40;
        or  r10, r11;
        mov r11, 0;
        shl r11, 48;
        or  r10, r11;

        mov rdi, 338;
        mov rsi, 337;
        mov rdx, 0x41B;
        mov rcx, 0xBEEF1005;             // key free after revoke
        mov r8, 337;
        mov r9, r10;
        call gpu_bo_cap_mint_inner;
        cmp rax, 0;
        jne kgbw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgbw_ok];
        call klog_s1;

        call kgbw_scrub;
        call kgbw_clear;
        xor rax, rax;
        jmp kgbw_out;

      kgbw_fail_stage:
        lea rax, [rip + _kgbw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgbw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kgbw_scrub;
        call kgbw_clear;
        mov rax, 1;

      kgbw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
