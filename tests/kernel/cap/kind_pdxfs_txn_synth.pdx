// tests/kernel/cap/kind_pdxfs_txn_synth.pdx -- R48b substrate-prep (#1624)
//
// Boot witness for KIND_PDXFS_TXN.
//
// Fingerprint: R48b KIND_PDXFS_TXN OK
//
// Cap slots 112..114.

module KindPdxfsTxnSynth = structure {

  pub let mut _pxtw_stage : u64 = 0

  pub let pxtw_ok   : [u8; 24] = "R48b KIND_PDXFS_TXN OK\n\0"
  pub let pxtw_fail : [u8; 26] = "R48b KIND_PDXFS_TXN FAIL\n\0"

  pub let pxtw_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): mint a synthetic KIND_MEMORY parent for the txn mint gate. Labels prefixed pxtw_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;
        mov rcx, r13;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pxtw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): clear cap_table slots 112..114. Labels prefixed pxtw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 112;
      pxtw_c_loop:
        cmp rbx, 115;
        jae pxtw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pxtw_c_loop;
      pxtw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_pdxfs_txn_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R48b substrate-prep (#1624): boot witness. Five callee-save pushes leave rsp%16 == 0. Labels prefixed pxtw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        call pxtw_clear;
        call pdxfs_txn_table_reset;

        mov rdi, 112;
        mov rsi, 0xF12E;
        mov rdx, 0x200;
        call pxtw_mem;
        mov rdi, 113;
        mov rsi, 0xF12F;
        mov rdx, 0x001;
        call pxtw_mem;
        mov rdi, 114;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 0x618;
        call pdxfs_txn_rights_valid;
        cmp rax, 1;
        jne pxtw_fail_stage;
        mov rdi, 0x2000;
        call pdxfs_txn_rights_valid;
        cmp rax, 0;
        jne pxtw_fail_stage;

        // (3) mode_valid.
        mov rax, 3;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 1; call pdxfs_txn_mode_valid; cmp rax, 1; jne pxtw_fail_stage;
        mov rdi, 3; call pdxfs_txn_mode_valid; cmp rax, 1; jne pxtw_fail_stage;
        mov rdi, 0; call pdxfs_txn_mode_valid; cmp rax, 0; jne pxtw_fail_stage;
        mov rdi, 4; call pdxfs_txn_mode_valid; cmp rax, 0; jne pxtw_fail_stage;

        // (4) parent gate.
        mov rax, 4;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 112;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 1;
        jne pxtw_fail_stage;
        mov rdi, 113;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 0;
        jne pxtw_fail_stage;
        mov rdi, 114;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 0;
        jne pxtw_fail_stage;

        // (5) Mint success. txn_id=0xC001, mode=CREATE(1), wal=0x8000,
        //     snap=0x77.
        mov rax, 5;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 112;
        mov rsi, 0x618;
        mov rdx, 0xC001;
        mov rcx, 1;
        mov r8,  0x8000;
        mov r9,  0x77;
        call pdxfs_txn_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae pxtw_fail_stage;
        mov r12, rax;

        mov rdi, r12;
        call pdxfs_txn_row_id;
        mov r11, 0xC001;
        cmp rax, r11;
        jne pxtw_fail_stage;

        mov rdi, r12;
        call pdxfs_txn_row_snap;
        cmp rax, 0x77;
        jne pxtw_fail_stage;

        mov rdi, r12;
        call pdxfs_txn_row_wal;
        mov r11, 0x8000;
        cmp rax, r11;
        jne pxtw_fail_stage;

        mov rdi, r12;
        call pdxfs_txn_row_bytes;
        cmp rax, 0;                      // starts at 0
        jne pxtw_fail_stage;

        mov rdi, r12;
        call pdxfs_txn_row_mode;
        cmp rax, 1;                      // CREATE
        jne pxtw_fail_stage;

        mov rdi, r12;
        call pdxfs_txn_row_state;
        cmp rax, 1;                      // OPEN
        jne pxtw_fail_stage;

        // (6) BAD_ID (txn_id == 0).
        mov rax, 6;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 112;
        mov rsi, 0x618;
        xor rdx, rdx;
        mov rcx, 2;
        mov r8, 0;
        mov r9, 0;
        call pdxfs_txn_cap_mint_inner;
        mov r10, 0xFFFFEC1B;             // PXT_MINT_BAD_ID
        cmp rax, r10;
        jne pxtw_fail_stage;

        // (7) BAD_MODE.
        mov rax, 7;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, 112;
        mov rsi, 0x618;
        mov rdx, 0xC002;
        mov rcx, 4;                      // > PXT_MODE_MAX
        mov r8, 0;
        mov r9, 0;
        call pdxfs_txn_cap_mint_inner;
        mov r10, 0xFFFFEC1A;             // PXT_MINT_BAD_MODE
        cmp rax, r10;
        jne pxtw_fail_stage;

        // (8) revoke happy path.
        mov rax, 8;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_txn_cap_revoke;
        cmp rax, 0;
        jne pxtw_fail_stage;
        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        jne pxtw_fail_stage;

        // (9) revoke already dead.
        mov rax, 9;
        lea rcx, [rip + _pxtw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_txn_cap_revoke;
        mov r10, 0xFFFFEC16;             // PXT_REVOKE_ALREADY
        cmp rax, r10;
        jne pxtw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxtw_ok];
        call klog_s1;

        call pxtw_clear;
        call pdxfs_txn_table_reset;
        xor rax, rax;
        jmp pxtw_out;

      pxtw_fail_stage:
        lea rax, [rip + _pxtw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxtw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pxtw_clear;
        call pdxfs_txn_table_reset;
        mov rax, 1;

      pxtw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
