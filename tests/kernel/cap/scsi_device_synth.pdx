// tests/kernel/cap/scsi_device_synth.pdx — R34.M3-003 (#1178)
//
// Boot witness for KIND_SCSI_DEVICE.
//
// Asserts derivation gate over KIND_MSC_LUN, type/blksz/blkcnt
// refusals, uniqueness on scsi_key, mint/revoke round-trip.
//
// Fingerprint: R34 KIND_SCSI_DEVICE OK
//
// Cap slots 244..251 -- reused historically (see msc_lun_synth
// header for the same argument). Runs AFTER msc_lun_witness which
// scrubs those slots + all four row tables on exit.

module ScsiDeviceSynth = structure {

  pub let mut _scsid_w_stage : u64 = 0

  pub let scsid_w_ok   : [u8; 26] = "R34 KIND_SCSI_DEVICE OK\n\0\0"
  pub let scsid_w_fail : [u8; 28] = "R34 KIND_SCSI_DEVICE FAIL\n\0\0"

  pub let scsid_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): clear cap_table slots 244..251. Labels prefixed scsidw_wc_.",
      block: {
        push rbx;
        mov rbx, 244;
      scsidw_wc_loop:
        cmp rbx, 252;
        jae scsidw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp scsidw_wc_loop;
      scsidw_wc_done:
        pop rbx;
        ret
      }
    }

  pub let scsid_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): reset SCSI device + MSC LUN + USB interface/device tables.",
      block: {
        push rbx;
        call scsi_device_table_reset;
        call msc_lun_table_reset;
        call usb_interface_table_reset;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let scsid_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let scsi_device_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M3-003 (#1178): boot witness. Stages: (1) validators. (2) BAD_PARENT (non-LUN parent). (3) Happy path. (4) Query fields. (5) IN_USE. (6) BAD_TYPE (32). (7) BAD_BLKSZ (513). (8) BAD_BLKCNT (0). (9) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        call scsid_w_clear;
        call scsid_w_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call scsi_device_type_valid;
        cmp rax, 1;
        jne scsid_w_fail_stage;
        mov rdi, 31;
        call scsi_device_type_valid;
        cmp rax, 1;
        jne scsid_w_fail_stage;
        mov rdi, 32;
        call scsi_device_type_valid;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        mov rdi, 512;
        call scsi_device_blksz_valid;
        cmp rax, 1;
        jne scsid_w_fail_stage;
        mov rdi, 4096;
        call scsi_device_blksz_valid;
        cmp rax, 1;
        jne scsid_w_fail_stage;
        mov rdi, 513;
        call scsi_device_blksz_valid;
        cmp rax, 0;
        jne scsid_w_fail_stage;
        mov rdi, 256;
        call scsi_device_blksz_valid;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        mov rdi, 0;
        call scsi_device_blkcnt_valid;
        cmp rax, 0;
        jne scsid_w_fail_stage;
        mov rdi, 1;
        call scsi_device_blkcnt_valid;
        cmp rax, 1;
        jne scsid_w_fail_stage;

        // Setup: KIND_DEVICE(244) -> USB_DEVICE(245) -> USB_INTERFACE(246) -> MSC_LUN(247).
        mov rdi, 244;
        mov rsi, 0xDEADCAFE;
        mov rdx, 0x200;
        call scsid_w_device;

        mov rdi, 245;
        mov rsi, 244;
        mov rdx, 0x619;
        mov rcx, 9;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        mov rdi, 246;
        mov rsi, 245;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEEBB;
        mov r8, 0x0001;
        mov r9, 0x080650;
        call usb_interface_cap_mint_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        mov rdi, 247;
        mov rsi, 246;
        mov rdx, 0x619;
        mov rcx, 0xABCDDCBA;
        mov r8, 0;
        call msc_lun_cap_mint_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        // packed_type_blksz = type=0 | blksz=512<<8
        mov r10, 512;
        shl r10, 8;

        mov rdi, 248;
        mov rsi, 246;                    // parent = USB_INTERFACE, wrong
        mov rdx, 0x419;
        mov rcx, 0x1;
        mov r8, r10;
        mov r9, 1000;
        call scsi_device_cap_mint_inner;
        mov r11, 0xFFFFFB7D;             // BAD_PARENT
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 3. Happy path.
        mov rax, 3;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 8;

        mov rdi, 248;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0xFEEDFACE;
        mov r8, r10;
        mov r9, 65536;                   // 32 MiB device
        call scsi_device_cap_mint_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        // -- 4. Query fields.
        mov rax, 4;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov rdi, 248;
        call scsi_device_blksz_of_slot;
        cmp rax, 512;
        jne scsid_w_fail_stage;

        mov rdi, 248;
        call scsi_device_blkcnt_of_slot;
        cmp rax, 65536;
        jne scsid_w_fail_stage;

        mov rdi, 248;
        call scsi_device_key_of_slot;
        mov r11, 0xFEEDFACE;
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 5. IN_USE.
        mov rax, 5;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 8;

        mov rdi, 249;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0xFEEDFACE;             // duplicate
        mov r8, r10;
        mov r9, 1000;
        call scsi_device_cap_mint_inner;
        mov r11, 0xFFFFFB75;             // IN_USE
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 6. BAD_TYPE (32).
        mov rax, 6;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 8;
        mov r11, 32;                     // type = 32
        or  r10, r11;

        mov rdi, 249;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0x11223344;
        mov r8, r10;
        mov r9, 1000;
        call scsi_device_cap_mint_inner;
        mov r11, 0xFFFFFB7B;             // BAD_TYPE
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 7. BAD_BLKSZ (513).
        mov rax, 7;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov r10, 513;
        shl r10, 8;

        mov rdi, 249;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0x11223344;
        mov r8, r10;
        mov r9, 1000;
        call scsi_device_cap_mint_inner;
        mov r11, 0xFFFFFB7A;             // BAD_BLKSZ
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 8. BAD_BLKCNT (0).
        mov rax, 8;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov r10, 512;
        shl r10, 8;

        mov rdi, 249;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0x11223344;
        mov r8, r10;
        mov r9, 0;                       // BAD
        call scsi_device_cap_mint_inner;
        mov r11, 0xFFFFFB79;             // BAD_BLKCNT
        cmp rax, r11;
        jne scsid_w_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _scsid_w_stage];
        mov [rcx], rax;

        mov rdi, 248;
        call scsi_device_cap_revoke_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        mov r10, 512;
        shl r10, 8;

        mov rdi, 248;
        mov rsi, 247;
        mov rdx, 0x419;
        mov rcx, 0xFEEDFACE;
        mov r8, r10;
        mov r9, 65536;
        call scsi_device_cap_mint_inner;
        cmp rax, 0;
        jne scsid_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scsid_w_ok];
        call klog_s1;

        call scsid_w_scrub;
        call scsid_w_clear;
        xor rax, rax;
        jmp scsid_w_out;

      scsid_w_fail_stage:
        lea rax, [rip + _scsid_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + scsid_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call scsid_w_scrub;
        call scsid_w_clear;
        mov rax, 1;

      scsid_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
