// tests/kernel/cap/usb_interface_synth.pdx — R34.M2-001 (#1172)
//
// Boot witness for KIND_USB_INTERFACE.
//
// Asserts derivation gate over KIND_USB_DEVICE, ifnum / alt refusals,
// uniqueness, mint / revoke round-trip.
//
// Fingerprint: R34 KIND_USB_INTERFACE OK
// Cap slots 192..199.

module UsbInterfaceSynth = structure {

  pub let mut _usbif_w_stage : u64 = 0

  pub let usbif_w_ok   : [u8; 24] = "KIND_USB_INTERFACE OK\n\0\0"
  pub let usbif_w_fail : [u8; 26] = "KIND_USB_INTERFACE FAIL\n\0\0"

  pub let usbif_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): clear cap_table slots 192..199. Labels prefixed usbifs_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 192;
      usbifs_wc_loop:
        cmp rbx, 200;
        jae usbifs_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp usbifs_wc_loop;
      usbifs_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usbif_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): reset USB interface + USB device row tables.",
      block: {
        push rbx;
        call usb_interface_table_reset;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let usbif_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usb_interface_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M2-001 (#1172): boot witness. Sequence: (1) validators. (2) BAD_PARENT on non-USB_DEVICE parent. (3) mint USB_DEVICE then USB_INTERFACE. (4) query fields. (5) IN_USE on duplicate key. (6) BAD_IFNUM at 32. (7) BAD_ALT at 16. (8) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        call usbif_w_clear;
        call usbif_w_scrub;

        // -- 1. Validators.
        xor rdi, rdi;
        call usb_interface_ifnum_valid;
        cmp rax, 1;
        jne usbif_w_fail_stage;
        mov rdi, 31;
        call usb_interface_ifnum_valid;
        cmp rax, 1;
        jne usbif_w_fail_stage;
        mov rdi, 32;
        call usb_interface_ifnum_valid;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        xor rdi, rdi;
        call usb_interface_alt_valid;
        cmp rax, 1;
        jne usbif_w_fail_stage;
        mov rdi, 15;
        call usb_interface_alt_valid;
        cmp rax, 1;
        jne usbif_w_fail_stage;
        mov rdi, 16;
        call usb_interface_alt_valid;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        // -- 2. BAD_PARENT: mint on KIND_DEVICE (10) parent.
        mov rax, 2;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 193;
        mov rsi, 0xDEADBEEF;
        mov rdx, 0x200;
        call usbif_w_device;

        // packed_ifnum_alt = 2 | (1 << 8) = 0x102
        // packed_class_sc_proto = 3 | (1 << 8) | (2 << 16) = 0x20103
        mov rdi, 192;
        mov rsi, 193;                    // parent is KIND_DEVICE (not USB_DEVICE)
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE01;             // interface_key
        mov r8, 0x102;                   // packed_ifnum_alt
        mov r9, 0x20103;                 // packed_class_sc_proto
        call usb_interface_cap_mint_inner;
        mov r11, 0xFFFFFBBD;             // BAD_PARENT
        cmp rax, r11;
        jne usbif_w_fail_stage;

        // -- 3. Mint a KIND_USB_DEVICE at slot 194, then USB_INTERFACE at 192.
        mov rax, 3;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 194;
        mov rsi, 193;
        mov rdx, 0x619;
        mov rcx, 5;                      // address 5
        mov r8, 3;                       // HIGH speed
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        mov rsi, 194;                    // KIND_USB_DEVICE parent
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE01;
        mov r8, 0x102;
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        // -- 4. Query fields.
        mov rax, 4;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 192;
        call usb_interface_ifnum_of_slot;
        cmp rax, 2;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        call usb_interface_alt_of_slot;
        cmp rax, 1;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        call usb_interface_class_of_slot;
        cmp rax, 3;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        call usb_interface_subclass_of_slot;
        cmp rax, 1;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        call usb_interface_protocol_of_slot;
        cmp rax, 2;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        call usb_interface_key_of_slot;
        mov r11, 0xC0FFEE01;
        cmp rax, r11;
        jne usbif_w_fail_stage;

        // -- 5. Duplicate interface_key -> IN_USE.
        mov rax, 5;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 194;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE01;             // duplicate key
        mov r8, 0x0203;                  // ifnum=3, alt=2
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        mov r11, 0xFFFFFBB7;             // IN_USE
        cmp rax, r11;
        jne usbif_w_fail_stage;

        // -- 6. BAD_IFNUM at 32.
        mov rax, 6;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 194;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE02;
        mov r8, 32;                      // ifnum = 32
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        mov r11, 0xFFFFFBBB;             // BAD_IFNUM
        cmp rax, r11;
        jne usbif_w_fail_stage;

        // -- 7. BAD_ALT at 16.
        mov rax, 7;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 195;
        mov rsi, 194;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE02;
        mov r8, 0x1002;                  // ifnum=2, alt=16
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        mov r11, 0xFFFFFBBA;             // BAD_ALT
        cmp rax, r11;
        jne usbif_w_fail_stage;

        // -- 8. Revoke round-trip.
        mov rax, 8;
        lea rcx, [rip + _usbif_w_stage];
        mov [rcx], rax;

        mov rdi, 192;
        call usb_interface_cap_revoke_inner;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        mov rdi, 192;
        mov rsi, 194;
        mov rdx, 0x619;
        mov rcx, 0xC0FFEE01;
        mov r8, 0x102;
        mov r9, 0x20103;
        call usb_interface_cap_mint_inner;
        cmp rax, 0;
        jne usbif_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbif_w_ok];
        call klog_s1;

        call usbif_w_scrub;
        call usbif_w_clear;
        xor rax, rax;
        jmp usbif_w_out;

      usbif_w_fail_stage:
        lea rax, [rip + _usbif_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbif_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call usbif_w_scrub;
        call usbif_w_clear;
        mov rax, 1;

      usbif_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
