// tests/kernel/cap/gpu_submit_synth.pdx — R37.M6-001 (#1276)
//
// Boot witness for KIND_GPU_SUBMIT.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, CTX-slot gate, BO-slot
// gate, R_MINT explicit LINEAR refuse (KGSUB_MINT_REFUSED_MINT), rights
// subset refuse, uniqueness on submit_key, state transition discipline,
// mint / revoke round-trip, and linear_flag == 1 on the live row.
//
// Fingerprint: R37 KIND_GPU_SUBMIT OK
//
// Cap slots 400..415.

module GpuSubmitSynth = structure {

  pub let mut _kgsubw_stage : u64 = 0

  pub let kgsubw_ok   : [u8; 24] = "R37 KIND_GPU_SUBMIT OK\n\0"
  pub let kgsubw_fail : [u8; 26] = "R37 KIND_GPU_SUBMIT FAIL\n\0"

  pub let kgsubw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): clear cap_table slots 400..415.",
      block: {
        push rbx;
        mov rbx, 400;
      kgsubwc_loop:
        cmp rbx, 416;
        jae kgsubwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kgsubwc_loop;
      kgsubwc_done:
        pop rbx;
        ret
      }
    }

  pub let kgsubw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): reset GPU SUBMIT row table.",
      block: {
        call gpu_submit_table_reset;
        ret
      }
    }

  pub let kgsubw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kgsubw_seed_ctx : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): synthetic KIND_GPU_CONTEXT at slot (no rights, gate only reads kind).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x176;                  // KIND_GPU_CONTEXT
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kgsubw_seed_bo : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): synthetic KIND_GPU_BO at slot (no rights, gate only reads kind).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x174;                  // KIND_GPU_BO
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let gpu_submit_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R37.M6-001 (#1276): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_CTX. (4) BAD_BO. (5) BAD_RIGHTS (subset trip). (6) REFUSED_MINT (LINEAR explicit). (7) Happy path. (8) Query fields incl. linear_flag == 1. (9) IN_USE. (10) Transition PENDING -> SUBMITTED. (11) Bad transition (SUBMITTED -> PENDING). (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        call kgsubw_clear;
        call kgsubw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kgsub_state_valid;
        cmp rax, 1;
        jne kgsubw_fail_stage;
        mov rdi, 3;
        call kgsub_state_valid;
        cmp rax, 1;
        jne kgsubw_fail_stage;
        mov rdi, 4;
        call kgsub_state_valid;
        cmp rax, 0;
        jne kgsubw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 401, KIND_GPU_CONTEXT at 402,
        // KIND_GPU_BO at 403.
        mov rdi, 401;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call kgsubw_seed_endpoint;

        mov rdi, 402;
        mov rsi, 0x11;
        call kgsubw_seed_ctx;

        mov rdi, 403;
        mov rsi, 0x22;
        call kgsubw_seed_bo;

        // packed_cb = ctx_slot[15:0] | batch_bo_slot[31:16].
        // ctx_slot=402 (0x192), bo_slot=403 (0x193).
        // Packed = 0x192 | (0x193 << 16) = 0x01930192.
        mov r15, 0x01930192;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 400;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE20;
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF56D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 3. BAD_CTX (ctx_slot names empty slot).
        mov rax, 3;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE21;
        mov r8, 0x01930195;              // ctx_slot=405 (empty), bo=403
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF56B;             // MINT_BAD_CTX
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 4. BAD_BO (batch_bo_slot names empty slot).
        mov rax, 4;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE22;
        mov r8, 0x01950192;              // ctx=402, bo=405 (empty)
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF56A;             // MINT_BAD_BO
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 5. BAD_RIGHTS (bit outside R_GPU_SUB_ALL but NOT R_MINT).
        // 0x800 is outside 0x41B; R_MINT is separately caught in stage 6.
        mov rax, 5;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x81B;
        mov rcx, 0xC0FFEE23;
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF56C;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 6. REFUSED_MINT (R_MINT set -- LINEAR explicit gate).
        mov rax, 6;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x21B;                  // R_MINT tripped
        mov rcx, 0xC0FFEE24;
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF560;             // MINT_REFUSED_MINT (LINEAR)
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 7. Happy path.
        mov rax, 7;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE25;
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        cmp rax, 0;
        jne kgsubw_fail_stage;

        // -- 8. Query fields incl. linear_flag.
        mov rax, 8;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kgsub_row_key;
        mov r11, 0xC0FFEE25;
        cmp rax, r11;
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_endpoint;
        cmp rax, 401;
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_ctx;
        cmp rax, 402;
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_bo;
        cmp rax, 403;
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_state;
        cmp rax, 0;                      // PENDING
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_linear;
        cmp rax, 1;                      // LINEAR flag = 1 (frozen)
        jne kgsubw_fail_stage;

        // -- 9. IN_USE (duplicate submit_key).
        mov rax, 9;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 406;
        mov rsi, 401;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE25;
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        mov r11, 0xFFFFF565;             // MINT_IN_USE
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 10. Transition PENDING -> SUBMITTED.
        mov rax, 10;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // SUBMITTED
        call kgsub_row_transition;
        cmp rax, 0;
        jne kgsubw_fail_stage;

        mov rdi, 0;
        call kgsub_row_state;
        cmp rax, 1;
        jne kgsubw_fail_stage;

        // linear_flag survives the state transition.
        mov rdi, 0;
        call kgsub_row_linear;
        cmp rax, 1;
        jne kgsubw_fail_stage;

        // -- 11. Bad transition SUBMITTED -> PENDING.
        mov rax, 11;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call kgsub_row_transition;
        mov r11, 0xFFFFF561;             // BAD_TRANSITION
        cmp rax, r11;
        jne kgsubw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _kgsubw_stage];
        mov [rcx], rax;

        mov rdi, 404;
        call gpu_submit_cap_revoke_inner;
        cmp rax, 0;
        jne kgsubw_fail_stage;

        mov rdi, 404;
        mov rsi, 401;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE25;             // key free after revoke
        mov r8, r15;
        call gpu_submit_cap_mint_inner;
        cmp rax, 0;
        jne kgsubw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgsubw_ok];
        call klog_s1;

        call kgsubw_scrub;
        call kgsubw_clear;
        xor rax, rax;
        jmp kgsubw_out;

      kgsubw_fail_stage:
        lea rax, [rip + _kgsubw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgsubw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kgsubw_scrub;
        call kgsubw_clear;
        mov rax, 1;

      kgsubw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
