// tests/kernel/cap/kind_vello_scene_synth.pdx -- G4.M1-002 (#1476)
//
// Boot witness for KIND_VELLO_SCENE. Exercises table reset,
// validators, tail_alloc, row accessors, set_flags, find_by_key,
// tail_free.
//
// Fingerprint: G4 KIND_VELLO_SCENE OK

module KindVelloSceneSynth = structure {

  pub let mut _vssw_stage : u64 = 0

  pub let vssw_ok   : [u8; 24] = "G4 KIND_VELLO_SCENE OK\n\0"
  pub let vssw_fail : [u8; 26] = "G4 KIND_VELLO_SCENE FAIL\n\0"

  pub let kind_vello_scene_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M1-002 (#1476): boot witness. Stages: (1) reset. (2) rights_valid. (3) bytes_valid (align + range). (4) paths_valid. (5) samples_valid. (6) flags_valid. (7) body1_pack + hdr_pack. (8) tail_alloc happy. (9) row accessors. (10) set_flags. (11) find_by_key. (12) tail_free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        call vs_table_reset;

        // 2. rights_valid.
        mov rax, 2;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call vs_rights_valid;
        cmp rax, 1;
        jne vssw_fail_stage;
        mov rdi, 0x800;
        call vs_rights_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        // 3. bytes_valid: 64 ok (aligned + non-zero), 0 no, 100 no
        // (unaligned), 16 MiB + 64 no (too large).
        mov rax, 3;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 64;
        call vs_bytes_valid;
        cmp rax, 1;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_bytes_valid;
        cmp rax, 0;
        jne vssw_fail_stage;
        mov rdi, 100;
        call vs_bytes_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        // 4. paths_valid: 65535 ok, 65536 no.
        mov rax, 4;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 65535;
        call vs_paths_valid;
        cmp rax, 1;
        jne vssw_fail_stage;
        mov rdi, 65536;
        call vs_paths_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        // 5. samples_valid: 4 ok, 3 no.
        mov rax, 5;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 4;
        call vs_samples_valid;
        cmp rax, 1;
        jne vssw_fail_stage;
        mov rdi, 3;
        call vs_samples_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        // 6. flags_valid.
        mov rax, 6;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0x0F;
        call vs_flags_valid;
        cmp rax, 1;
        jne vssw_fail_stage;
        mov rdi, 0x10;
        call vs_flags_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        // 7. body1_pack + hdr_pack.
        mov rax, 7;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 10;                      // bo_slot
        mov rsi, 100;                     // path_count
        mov rdx, 4;                       // sample_count
        call vs_body1_pack;
        mov r12, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  vssw_fail_stage;

        mov rdi, 5;                       // parent_slot
        mov rsi, 0x0001;                  // flags = HAS_GRADIENTS
        call vs_hdr_pack;
        mov r13, rax;
        cmp r13, r10;
        je  vssw_fail_stage;

        // 8. tail_alloc happy: alloc row 0.
        mov rax, 8;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, r13;                     // hdr
        mov rsi, 0xDEAD00;                // scene_key
        mov rdx, r12;                     // body1
        mov rcx, 4096;                    // encoded_bytes
        call vs_tail_alloc;
        cmp rax, 0;
        jne vssw_fail_stage;              // must be row 0

        // 9. row accessors.
        mov rax, 9;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vs_row_key;
        mov r10, 0xDEAD00;
        cmp rax, r10;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_row_bo;
        cmp rax, 10;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_row_paths;
        cmp rax, 100;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_row_bytes;
        cmp rax, 4096;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_row_samples;
        cmp rax, 4;
        jne vssw_fail_stage;

        // 10. set_flags OK.
        mov rax, 10;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 0x0F;
        call vs_row_set_flags;
        cmp rax, 0;
        jne vssw_fail_stage;
        mov rdi, 0;
        call vs_row_flags;
        cmp rax, 0x0F;
        jne vssw_fail_stage;

        // 11. find_by_key.
        mov rax, 11;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0xDEAD00;
        call vs_find_by_key;
        cmp rax, 0;
        jne vssw_fail_stage;
        mov rdi, 0xBEEF;
        call vs_find_by_key;
        cmp rax, 0xFF;
        jne vssw_fail_stage;

        // 12. tail_free.
        mov rax, 12;
        lea rcx, [rip + _vssw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vs_tail_free;
        mov rdi, 0;
        call vs_tail_valid;
        cmp rax, 0;
        jne vssw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vssw_ok];
        call klog_s1;

        call vs_table_reset;
        xor rax, rax;
        jmp vssw_out;

      vssw_fail_stage:
        lea rax, [rip + _vssw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vssw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vs_table_reset;
        mov rax, 1;

      vssw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
