// tests/kernel/cap/backlight_synth.pdx — R31.M5-001 (#1106)
//
// Boot witness for KIND_BACKLIGHT: the derivation gate over KIND_DEVICE,
// the one-panel-per-device rule, the static-identity refusals
// (index / backend / range), the report installer's range plausibility
// gate, the row's cached level semantics, the revoke, and the dispatch
// handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A PANEL, A PWM DUTY CYCLE OR A DPAUX BYTE, because no
// code in this tree drives a backlight -- kind_backlight.pdx §4 says
// so at length.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R31 KIND_BACKLIGHT OK  — stage A: the capability. Gate halves,
//                            rights, uniqueness, revoke, dispatch,
//                            static-identity refusals.
//   R31 BACKLIGHT SCALE OK — stage B: the ordinals. Range refusals at
//                            both edges, end-to-end round-trip through
//                            REPORT, sentinel discipline.
//
// Split there because the two fail for unrelated reasons and the
// goldens assert an ordered subsequence: a range error and a broken
// gate would otherwise present as the same missing line.
//
// -----------------------------------------------------------------------------
// Cap slots 96..99
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree. Every fixture through
// R31.M4 used the ranges 0..8, 10..12, 14..19, 28..33, 46..63, 64..95,
// 110..117, 160..199, 200..251, 252..255. The block 96..99 is one of
// the last unallocated small windows; four slots is exactly enough for
// one well-formed parent, one parent without RIGHT_MINT, one parent
// with zero identity, and the mint's own subject slot. Both exits
// revoke every panel, clear every slot and reset the row table, so a
// failure here cannot be mistaken for a fault in whatever runs next.
//
// -----------------------------------------------------------------------------
// The numbers, and why these numbers
// -----------------------------------------------------------------------------
//
// brightness_min 0, brightness_max 100 — a plausible ACPI _BCL panel
// range (0..100 percent). backend ACPI (3). A report of
// {current_brightness 60} lands mid-range, distinct from brightness_min
// so it is not the floor sentinel, distinct from brightness_max so it
// is not a clamp disguised as a success, and distinct from 0xFFFF so it
// is not the BACKLIGHT_LEVEL_NONE sentinel.
//
// 101 appears as a refused level because it is brightness_max + 1 and
// clamping would substitute brightness_max for it silently -- the exact
// failure §3 warns about.

module BacklightSynth = structure {

  pub let mut _bl_w_stage : u64 = 0

  pub let bl_w_ok_a   : [u8; 20] = "KIND_BACKLIGHT OK\0"
  pub let bl_w_fail_a : [u8; 22] = "KIND_BACKLIGHT FAIL\0"
  pub let bl_w_ok_b   : [u8; 20] = "BACKLIGHT SCALE OK\0"
  pub let bl_w_fail_b : [u8; 22] = "BACKLIGHT SCALE FAIL\0"

  // ==========================================================================
  // bl_w_clear() — return slots 96..99 to boot state.
  // ==========================================================================

  pub let bl_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): clear cap_table slots 96..99 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked four descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed bl_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 96;
      bl_wc_loop:
        cmp rbx, 100;
        jae bl_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bl_wc_loop;
      bl_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let bl_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): reset the backlight row table and the counters. The counters are outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of backlight_stat a count of implausible reports this fixture invented. One push leaves rsp%16 == 0 at the nested call. Labels prefixed bl_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call backlight_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bl_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let bl_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bl_w_pack_range(bmin, bmax) -> range
  // ==========================================================================

  pub let bl_w_pack_range : (u64, u64) -> u64 !{} @{} =
    fn (bmin: u64) (bmax: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-001 (#1106): pack (bmin, bmax) as bmin | (bmax << 32). Provided by the fixture so every mint call site packs the endpoints identically. Pure leaf. Labels prefixed bl_pr_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        or  rax, rdi;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let backlight_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M5-001 (#1106): boot witness for KIND_BACKLIGHT. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the four static-identity refusals that keep a panel from existing without a plausible index / backend / range, the one-panel-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of a non-zero reserved field on the REPORT op, and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers: the range plausibility test at both edges (brightness_min admitted, brightness_max admitted, brightness_max+1 refused, brightness_min-1 refused via wrap), the sentinel discipline (BACKLIGHT_LEVEL_NONE readable before any report and distinct from any legitimate ordinal in this fixture's range), and an end-to-end round trip through REPORT that proves the report count moved by exactly one. Each stage runs only if the previous passed. Both exits call bl_w_scrub and bl_w_clear. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed bl_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        call bl_w_clear;
        call bl_w_scrub;

        // 96 — well-formed parent. 97 — no RIGHT_MINT. 98 — RIGHT_MINT
        // but zero identity. 99 — used as subject / second parent
        // depending on stage.
        mov rdi, 96;
        mov rsi, 0xBB01;
        mov rdx, 0x200;                  // RIGHT_MINT
        call bl_w_device;
        mov rdi, 97;
        mov rsi, 0xBB09;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call bl_w_device;
        mov rdi, 98;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call bl_w_device;

        // -- A1. First half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 96;
        call backlight_check_parent_device;
        cmp rax, 1;
        jne bl_w_fail_stage_a;

        mov rdi, 97;
        call backlight_check_parent_device;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        mov rdi, 99;                     // empty slot
        call backlight_check_parent_device;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        // Try to mint from a parent without RIGHT_MINT. Subject is 99.
        // Range: 0..100.
        mov rdi, 0;
        mov rsi, 100;
        call bl_w_pack_range;
        mov r15, rax;                    // range

        mov rdi, 99;
        mov rsi, 97;
        mov rdx, 0x41B;
        mov rcx, 0;                      // index
        mov r8, 3;                       // ACPI
        mov r9, r15;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE7D;             // BACKLIGHT_MINT_BAD_PARENT
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // -- A2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call backlight_rights_valid;
        cmp rax, 1;
        jne bl_w_fail_stage_a;
        mov rdi, 0x41B;
        call backlight_rights_valid;
        cmp rax, 1;
        jne bl_w_fail_stage_a;
        mov rdi, 0x200;
        call backlight_rights_valid;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x21B;                  // R_BACKLIGHT_ALL | RIGHT_MINT
        mov rcx, 0;
        mov r8, 3;
        mov r9, r15;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE7C;             // BACKLIGHT_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // -- A3. Static-identity refusals.
        mov rax, 4;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 8;                      // BACKLIGHT_INDEX_MAX -> refused
        mov r8, 3;
        mov r9, r15;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE7B;             // BACKLIGHT_MINT_BAD_INDEX
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 4;                       // past BACKLIGHT_BACKEND_MAX
        mov r9, r15;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE7A;             // BACKLIGHT_MINT_BAD_BACKEND
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // Degenerate range bmin == bmax.
        mov rdi, 50;
        mov rsi, 50;
        call bl_w_pack_range;
        mov r14, rax;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r14;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE79;             // BACKLIGHT_MINT_BAD_RANGE
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // Descending range bmax < bmin.
        mov rdi, 100;
        mov rsi, 50;
        call bl_w_pack_range;
        mov r14, rax;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r14;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE79;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // bmax past BACKLIGHT_LEVEL_UPPER.
        mov rdi, 0;
        mov rsi, 65536;
        call bl_w_pack_range;
        mov r14, rax;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r14;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE79;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // -- A4. Identity is INHERITED.
        mov rax, 5;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 98;
        call backlight_parent_key;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        mov rsi, 98;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r15;                     // valid 0..100 range
        call backlight_cap_mint;
        mov r11, 0xFFFFFE78;             // BACKLIGHT_MINT_NO_DEVICE
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // -- A5. Happy path.
        mov rax, 6;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;                      // index 0
        mov r8, 3;                       // ACPI
        mov r9, r15;
        call backlight_cap_mint;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        call backlight_max_of_slot;
        cmp rax, 100;
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        call backlight_backend_of_slot;
        cmp rax, 3;                      // ACPI
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        call backlight_current_of_slot;
        cmp rax, 0xFFFF;                 // BACKLIGHT_LEVEL_NONE
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        call backlight_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  bl_w_fail_stage_a;

        mov rdi, rbx;
        call backlight_row_key;
        cmp rax, 0xBB01;                 // INHERITED key
        jne bl_w_fail_stage_a;

        mov rdi, rbx;
        call backlight_row_parent;
        cmp rax, 96;
        jne bl_w_fail_stage_a;

        mov rdi, rbx;
        call backlight_row_reports;
        cmp rax, 0;                      // no reports yet
        jne bl_w_fail_stage_a;

        // -- A6. ONE PANEL, ONE CAPABILITY.
        mov rax, 7;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        // Clear 98 for a fresh subject.
        mov rdi, 98;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 98;                     // subject
        mov rsi, 96;                     // SAME device
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r15;
        call backlight_cap_mint;
        mov r11, 0xFFFFFE76;             // BACKLIGHT_MINT_BL_IN_USE
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 0xBB01;
        call backlight_find_by_key;
        cmp rax, rbx;                    // and it IS this row
        jne bl_w_fail_stage_a;

        // -- A7. Revoke refusals.
        mov rax, 8;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 96;                     // KIND_DEVICE
        call backlight_cap_revoke;
        mov r11, 0xFFFFFE74;             // BACKLIGHT_WRONG_KIND
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 98;                     // empty slot (we cleared it)
        call backlight_cap_revoke;
        mov r11, 0xFFFFFE73;             // BACKLIGHT_REVOKE_ALREADY
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // Device survived.
        mov rdi, 96;
        call backlight_check_parent_device;
        cmp rax, 1;
        jne bl_w_fail_stage_a;

        // -- A8. Dispatch handler.
        mov rax, 9;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 99;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 99

        // QUERY_MAX is INVOKE.
        mov rdi, 0x008;                  // R_BACKLIGHT_INVOKE
        mov rsi, r12;
        mov rdx, 3;                      // QUERY_MAX
        call cap_handler_backlight;
        cmp rax, 100;
        jne bl_w_fail_stage_a;

        // QUERY_MAX with only READ is DENIED.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 3;
        call cap_handler_backlight;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // QUERY_CURRENT is READ.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 4;                      // QUERY_CURRENT
        call cap_handler_backlight;
        cmp rax, 0xFFFF;                 // BACKLIGHT_LEVEL_NONE
        jne bl_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_backlight;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // REPORT with reserved bits set is REFUSED, not masked.
        mov rdi, 0x002;                  // R_BACKLIGHT_REPORT
        mov rsi, r12;
        mov r13, 1;
        shl r13, 24;                     // reserved [63:24]
        or  r13, 8;                      // op = 8
        mov rdx, r13;
        call cap_handler_backlight;
        mov r11, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        // -- A9. Revoke and RE-MINT.
        mov rax, 10;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        call backlight_cap_revoke;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        mov rdi, rbx;
        call backlight_tail_valid;
        cmp rax, 0;                      // row went with it
        jne bl_w_fail_stage_a;

        mov rdi, 0xBB01;
        call backlight_find_by_key;
        cmp rax, 0xFF;                   // BACKLIGHT_ROW_NONE
        jne bl_w_fail_stage_a;

        mov rdi, 99;
        mov rsi, 96;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 3;
        mov r9, r15;
        call backlight_cap_mint;
        cmp rax, 0;
        jne bl_w_fail_stage_a;

        // -- A10. Dead row answers BACKLIGHT_DECODE_BAD.
        mov rax, 11;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 3;                      // never-claimed row
        call backlight_row_max;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 3;
        call backlight_row_current;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 98;                     // empty slot
        call backlight_max_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 96;                     // KIND_DEVICE, not a panel
        call backlight_max_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bl_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — THE NUMBERS.
        // ================================================================

        // -- B1. Backend enumeration.
        mov rax, 21;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call backlight_backend_valid;
        cmp rax, 1;
        jne bl_w_fail_stage_b;
        mov rdi, 3;
        call backlight_backend_valid;
        cmp rax, 1;
        jne bl_w_fail_stage_b;
        mov rdi, 4;
        call backlight_backend_valid;
        cmp rax, 0;
        jne bl_w_fail_stage_b;

        // -- B2. Refresh the row handle after the A9 re-mint.
        mov rax, 22;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, 99;
        call backlight_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  bl_w_fail_stage_b;

        // -- B3. REPORT round trip.
        mov rax, 23;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call backlight_row_reports;
        mov r14, rax;                    // count before

        mov rdi, 0;                      // BACKLIGHT_ST_REPORTS
        call backlight_stat;
        mov r15, rax;                    // global before

        mov rdi, 99;
        mov rsi, 60;
        call backlight_report_install;
        cmp rax, 0;
        jne bl_w_fail_stage_b;

        mov rdi, 99;
        call backlight_current_of_slot;
        cmp rax, 60;
        jne bl_w_fail_stage_b;

        mov rdi, rbx;
        call backlight_row_reports;
        sub rax, r14;
        cmp rax, 1;
        jne bl_w_fail_stage_b;

        mov rdi, 0;
        call backlight_stat;
        sub rax, r15;
        cmp rax, 1;
        jne bl_w_fail_stage_b;

        // -- B4. RANGE PLAUSIBILITY.
        mov rax, 24;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        // brightness_max (100) admitted.
        mov rdi, 99;
        mov rsi, 100;
        call backlight_report_install;
        cmp rax, 0;
        jne bl_w_fail_stage_b;
        mov rdi, 99;
        call backlight_current_of_slot;
        cmp rax, 100;
        jne bl_w_fail_stage_b;

        // brightness_min (0) admitted.
        mov rdi, 99;
        xor rsi, rsi;
        call backlight_report_install;
        cmp rax, 0;
        jne bl_w_fail_stage_b;
        mov rdi, 99;
        call backlight_current_of_slot;
        cmp rax, 0;
        jne bl_w_fail_stage_b;

        // brightness_max+1 refused; row unchanged; counted.
        mov rdi, 1;                      // BACKLIGHT_ST_IMPL_LEVEL
        call backlight_stat;
        mov r14, rax;

        mov rdi, 99;
        mov rsi, 101;                    // past brightness_max
        call backlight_report_install;
        mov r11, 0xFFFFFE72;             // BACKLIGHT_IMPLAUSIBLE_LEVEL
        cmp rax, r11;
        jne bl_w_fail_stage_b;

        mov rdi, 99;
        call backlight_current_of_slot;
        cmp rax, 0;                      // unchanged from the previous good install
        jne bl_w_fail_stage_b;

        mov rdi, 1;
        call backlight_stat;
        sub rax, r14;
        cmp rax, 1;
        jne bl_w_fail_stage_b;

        // -- B5. Debug print refuses a dead row.
        mov rax, 25;
        lea rcx, [rip + _bl_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call backlight_debug_print;
        cmp rax, 0;
        jne bl_w_fail_stage_b;

        mov rdi, 3;                      // never claimed
        call backlight_debug_print;
        mov r11, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG
        cmp rax, r11;
        jne bl_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl_w_ok_b];
        call klog_s1;

        call bl_w_scrub;
        call bl_w_clear;
        xor rax, rax;
        jmp bl_w_out;

      bl_w_fail_stage_a:
        lea rax, [rip + _bl_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp bl_w_failed;

      bl_w_fail_stage_b:
        lea rax, [rip + _bl_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bl_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      bl_w_failed:
        call bl_w_scrub;
        call bl_w_clear;
        mov rax, 1;

      bl_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
