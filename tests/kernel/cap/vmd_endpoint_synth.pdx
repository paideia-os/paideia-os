// tests/kernel/cap/vmd_endpoint_synth.pdx — R47.M1-003 (#1414)
//
// Boot witness for KIND_VMD_ENDPOINT.  Mints a KIND_DEVICE parent at
// synthetic slot 240 (device authority carrying RIGHT_MINT), then
// mints, queries, transitions, and revokes a KIND_VMD_ENDPOINT at
// slot 241.
//
// Fingerprint: R47 KIND_VMD_ENDPOINT OK
//
// Slots 240..243 -- disjoint from every other synth fixture in this
// tree.

module VmdEndpointSynth = structure {

  pub let mut _kves_stage : u64 = 0

  pub let kves_ok   : [u8; 22] = "KIND_VMD_ENDPOINT OK\n\0"
  pub let kves_fail : [u8; 24] = "KIND_VMD_ENDPOINT FAIL\n\0"

  pub let kves_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): clear synth cap slots 240..243.",
      block: {
        push rbx;
        mov rbx, 240;
      kves_clr:
        cmp rbx, 244;
        jae kves_clr_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kves_clr;
      kves_clr_done:
        pop rbx;
        ret
      }
    }

  // Direct write of a synthetic KIND_DEVICE cap.
  pub let kves_device : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): synthetic KIND_DEVICE (kind=10) so kve_check_parent + kve_check_device pass.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rdx, r13;
        xor rcx, rcx;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let vmd_endpoint_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R47.M1-003 (#1414): boot witness. Stages: (1) reset. (2) mint synth KIND_DEVICE parent. (3) mint KIND_VMD_ENDPOINT happy. (4) accessors return expected fields. (5) transition ATTACHED->ACTIVE. (6) revoke.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        call vmd_endpoint_table_reset;
        call kves_clear;

        // -- 2. Parent + device cap at slot 240.
        mov rax, 2;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        mov rdi, 240;
        mov rsi, 0x419;                  // R_KVE_ALL + R_MINT? R_MINT=0x200.
        // Actually parent must carry R_MINT (0x200) to be a valid parent.
        // Set rights = R_KVE_ALL | R_MINT = 0x419 | 0x200 = 0x619.
        mov rsi, 0x619;
        call kves_device;

        // -- 3. Mint KIND_VMD_ENDPOINT at 241.
        mov rax, 3;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        // Also mint the "vmd_slot" device at 242.
        mov rdi, 242;
        mov rsi, 0x619;
        call kves_device;

        //   packed_cfg = vmd_slot=242 | vbdf=0x0100 (bus=1,dev=0,fn=0)<<16 |
        //                class=0x010802<<32 | state=0<<56
        //              = 242 | (0x0100 << 16) | (0x010802 << 32)
        mov rdi, 241;                    // slot for the cap
        mov rsi, 240;                    // parent
        mov rdx, 0x419;                  // rights (subset of R_KVE_ALL)
        mov rcx, 0xC0DE47;               // endpoint_key
        // Build packed_cfg in r8.
        mov r8, 242;                     // vmd_slot
        mov r9, 0x0100;
        shl r9, 16;
        or  r8, r9;
        mov r9, 0x010802;
        shl r9, 32;
        or  r8, r9;
        call vmd_endpoint_cap_mint_inner;
        cmp rax, 0;
        jne kves_fail_stage;

        // -- 4. Accessors.
        mov rax, 4;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        mov rdi, 241;
        call kve_row_of_slot;
        cmp rax, 0xFF;
        je  kves_fail_stage;
        mov rbx, rax;                    // row_id

        mov rdi, rbx;
        call kve_row_key;
        mov r11, 0xC0DE47;
        cmp rax, r11;
        jne kves_fail_stage;

        mov rdi, rbx;
        call kve_row_vmd;
        cmp rax, 242;
        jne kves_fail_stage;

        mov rdi, rbx;
        call kve_row_class;
        mov r11, 0x010802;
        cmp rax, r11;
        jne kves_fail_stage;

        mov rdi, rbx;
        call kve_row_state;
        cmp rax, 0;                      // ATTACHED
        jne kves_fail_stage;

        // -- 5. Transition ATTACHED -> ACTIVE.
        mov rax, 5;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        mov rsi, 1;                      // ACTIVE
        call kve_row_transition;
        cmp rax, 0;
        jne kves_fail_stage;

        mov rdi, rbx;
        call kve_row_state;
        cmp rax, 1;
        jne kves_fail_stage;

        // -- 6. Revoke.
        mov rax, 6;
        lea rcx, [rip + _kves_stage];
        mov [rcx], rax;

        mov rdi, 241;
        call vmd_endpoint_cap_revoke_inner;
        cmp rax, 0;
        jne kves_fail_stage;

        mov rdi, 241;
        call kve_row_of_slot;
        cmp rax, 0xFF;
        jne kves_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kves_ok];
        call klog_s1;

        call vmd_endpoint_table_reset;
        call kves_clear;
        xor rax, rax;
        jmp kves_out;

      kves_fail_stage:
        lea rax, [rip + _kves_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kves_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vmd_endpoint_table_reset;
        call kves_clear;
        mov rax, 1;

      kves_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
