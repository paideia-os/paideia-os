// tests/kernel/cap/bdev_cross_family_synth.pdx -- R51.M7-006 (#1674)
//
// Boot witness for the cross-family claim M7-004 (#1672, unified
// per-family op dispatch in cap_handler_blkdev) and M7-005 (#1673,
// pdxfs/nvme_write.pdx -> pdxfs/bdev_write.pdx rename) exist to
// support: that the SAME unified BDEV wire (cap_invoke -> KIND_BLKDEV
// (0x42) -> cap_handler_blkdev's family-byte demux) can be driven for
// an NVMe-family (family=1) row and an AHCI-family (family=2) row
// interchangeably, with no caller-visible difference beyond the two
// rows' own (correctly family-specific) geometry/features answers.
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// (commit 2d6ab82) §2.M7 #1674, §4.5.  The design doc's own §2.M7
// text describes a full two-QEMU-configuration PdxFS mount + write +
// flush + read-back + superblock/inode/data digest comparison; this
// tree has neither a QEMU nvme device nor an AHCI device wired to
// smoke yet (both remain substrate-mode-only per every M5/M6/M7
// predecessor's own witness -- see e.g. kind_nvme_reliability_synth.pdx
// and bdev_barrier_synth.pdx, both of which already document that a
// live NVMe SQ/CQ pair is never minted under substrate boot). The
// witness below is therefore the substrate-mode analogue the task
// scoping this issue calls for: mint a real dual-kind KIND_BLKDEV cap
// for EACH family via the sanctioned mint paths (nvme_ns_dual_kind_
// mint / ahci_port_dual_kind_mint, #1642/#1662), then drive
// BDEV_OP_QUERY_GEOM / BDEV_OP_QUERY_FAMILY / BDEV_OP_QUERY_FEATURES
// against each through cap_invoke -- the real end-to-end call path a
// mounter uses (cap_invoke_dispatch's KIND_BLKDEV arm, invoke.pdx,
// reads target_ptr straight off the cap_table entry the dual-kind
// mint stamped, family bits included) -- and assert each family's
// answer is correct for ITS OWN row. Read/Write/Flush/Trim are out of
// scope here (no live SQ pair / no AHCI port bring-up in substrate
// mode; #1676's bdev_barrier_synth.pdx already covers the WRITE/FLUSH
// ordering half of the durability story on the NVMe side).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// Stage 1: reset every table this witness touches.
//
// Stage 2 (NVMe fixture): synth KIND_PCI_DEV parent (slot 128) ->
// nvme_ctrl_cap_mint_inner -> KIND_NVME_CONTROLLER (slot 130, row 0)
// -> nvme_ctrl_row_oncs_set(0, 0xD) (ONCS bits 0/2/3 set: FLUSH_
// SUPPORTED | TRIM_SUPPORTED | WRITE_ZEROES_SUPPORTED) -> nvme_ns_
// dual_kind_mint(ns_slot=131, blk_slot=132, parent_slot=130, nsid=1,
// lba_size=4096, block_count=1000000). cap_invoke(132, ...) against
// QUERY_GEOM/QUERY_FAMILY/QUERY_FEATURES; expect (4096<<32)|1000000,
// 1, and 0x1F (ONCS bits 0/1/2 + the two unconditional bits 3/4 per
// cap_handler_blkdev's hblk_op_features NVMe arm).
//
// Stage 3 (AHCI fixture): synth a SECOND KIND_PCI_DEV parent (slot
// 133) -> ahci_ctrl_cap_mint_inner -> KIND_AHCI_CONTROLLER (slot 134,
// row 0 -- a separate table from the NVMe controller table, so row 0
// coexisting with the NVMe fixture's own row 0 is expected and
// harmless) -> ahci_port_dual_kind_mint(port_slot=135, blk_slot=136,
// parent_slot=134, port_index=0, sector_size=512, block_count=
// 2000000). cap_invoke(136, ...) against the same three ops; expect
// (512<<32)|2000000, 2, and 9 (bit0 FLUSH_SUPPORTED unconditional |
// bit3 WRITE_CACHE_PRESENT, baked in by default at AHCI port mint
// time per R51.M6-004/#1666's ahci_port_tail_pack_meta).
//
// Stage 4: no further calls -- the two QUERY_FAMILY answers (1 vs 2)
// already prove the family byte each row's dual-kind mint stamped is
// live and distinct, and both fixtures answered through the IDENTICAL
// cap_invoke(slot, op_code) call shape from this witness's own
// perspective, which is the cross-family claim design §4.5 makes.
//
// Fingerprint: "BDEV CROSS FAMILY OK" / "... FAIL" (no round/
// milestone/issue tag, per design/policy/output-provenance-strip.md).
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G4: every expected value with bit 31/63-ish width built via shifts
//       (e.g. lba_size << 32) is compared reg-vs-reg (cmp rax, r8),
//       never reg-vs-imm64 -- same posture as cap_handler_blkdev /
//       bdev_barrier_synth.pdx.
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `bxfw_`.
//
// Cap slots 128..137 reserved (cleared at entry and on every exit
// path, same reuse posture as bdev_barrier_synth.pdx's 128..132 and
// blkdev_cap_request_synth.pdx's 128..131 -- safe because R51 boot
// witnesses run strictly sequentially and each fully resets cap/table
// state before returning):
//   128 = synth KIND_PCI_DEV parent #1 (NVMe controller mint gate)
//   130 = KIND_NVME_CONTROLLER (row 0, NVMe table)
//   131 = KIND_NVME_NAMESPACE (dual-kind mint child)
//   132 = KIND_BLKDEV, family=NVME (dual-kind mint child)
//   133 = synth KIND_PCI_DEV parent #2 (AHCI controller mint gate)
//   134 = KIND_AHCI_CONTROLLER (row 0, AHCI table)
//   135 = KIND_AHCI_PORT (dual-kind mint child)
//   136 = KIND_BLKDEV, family=AHCI (dual-kind mint child)

module BdevCrossFamilySynth = structure {

  pub let mut _bxfw_stage : u64 = 0

  pub let bxfw_ok   : [u8; 22] = "BDEV CROSS FAMILY OK\n\0"
  pub let bxfw_fail : [u8; 24] = "BDEV CROSS FAMILY FAIL\n\0"

  // ==========================================================================
  // bxfw_clear() -- scrub cap_table slots 128..137 inclusive.
  // ==========================================================================
  pub let bxfw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M7-006 boot witness: clear cap_table slots 128..137. Same shape as bdev_barrier_synth.pdx's bbdw_clear. Labels prefixed bxfw_cl_.",
      block: {
        push rbx;
        mov rbx, 128;
      bxfw_cl_loop:
        cmp rbx, 138;
        jae bxfw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bxfw_cl_loop;
      bxfw_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bxfw_pci_synth(slot, bdf) -- synth a KIND_PCI_DEV parent with
  // RIGHT_MINT so both nvme_ctrl_cap_mint_inner's and
  // ahci_ctrl_cap_mint_inner's parent gates accept it.
  // ==========================================================================
  pub let bxfw_pci_synth : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M7-006 boot witness: cap_mint_write(slot, KIND_PCI_DEV=0x30, R_DEV_ALL|RIGHT_MINT=0x21F, bdf). Same shape as bdev_barrier_synth.pdx's bbdw_pci_synth. Labels prefixed bxfw_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;
        mov rdx, 0x21F;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bdev_cross_family_witness() -> u64
  //
  // One callee-save push (rbx, unused past the alignment role it
  // plays -- no value survives a `call` in this function's body
  // uncomputed, since every expected-value construction happens with
  // no intervening call) leaves rsp%16 == 0 (entry rsp%16==8, minus
  // 8 == 0). Every params_ptr block for the two dual-kind mints is
  // built via `sub rsp, 32` / `add rsp, 32` immediately around its own
  // call, which preserves 16-byte alignment (32 is a multiple of 16)
  // exactly as bdev_barrier_synth.pdx's and blkdev_cap_request_synth.
  // pdx's own dual-kind-mint call sites do.
  // ==========================================================================
  pub let bdev_cross_family_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M7-006 (#1674) boot witness: stage 1 (reset every table touched), stage 2 (NVMe dual-kind fixture: KIND_PCI_DEV -> KIND_NVME_CONTROLLER -> ONCS stamp -> KIND_NVME_NAMESPACE/KIND_BLKDEV, then cap_invoke QUERY_GEOM/QUERY_FAMILY/QUERY_FEATURES against slot 132), stage 3 (AHCI dual-kind fixture: a second KIND_PCI_DEV -> KIND_AHCI_CONTROLLER -> KIND_AHCI_PORT/KIND_BLKDEV, then the same three cap_invoke ops against slot 136). One callee-save push per the function header's alignment note. Labels prefixed bxfw_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // Stage 1: reset every table this witness touches.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _bxfw_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        call bxfw_clear;

        // -----------------------------------------------------------
        // Stage 2: NVMe-family fixture.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _bxfw_stage];
        mov [rcx], rax;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call bxfw_pci_synth;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x100000;               // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row_id == 0 (fresh table)
        jne bxfw_fail_stage;

        mov rdi, 130;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        xor rdi, rdi;                    // row_id = 0
        mov rsi, 0xD;                    // oncs: bit0 FLUSH | bit2 TRIM | bit3 WZ
        call nvme_ctrl_row_oncs_set;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 1000000;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0

        mov rdi, 131;                    // ns_slot
        mov rsi, 132;                    // blk_slot
        mov rdx, 130;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae bxfw_fail_stage;

        // QUERY_GEOM (op 0): expect (4096 << 32) | 1000000.
        mov rdi, 132;
        xor rsi, rsi;
        call cap_invoke;
        mov r8, 4096;
        shl r8, 32;
        mov r9, 1000000;
        or  r8, r9;
        cmp rax, r8;
        jne bxfw_fail_stage;

        // QUERY_FAMILY (op 1): expect 1 (NVME).
        mov rdi, 132;
        mov rsi, 1;
        call cap_invoke;
        cmp rax, 1;
        jne bxfw_fail_stage;

        // QUERY_FEATURES (op 2): expect 0x1F.
        mov rdi, 132;
        mov rsi, 2;
        call cap_invoke;
        cmp rax, 0x1F;
        jne bxfw_fail_stage;

        // -----------------------------------------------------------
        // Stage 3: AHCI-family fixture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _bxfw_stage];
        mov [rcx], rax;

        mov rdi, 133;
        mov rsi, 0xCAFE;
        call bxfw_pci_synth;

        mov rdi, 133;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x43F;                  // R_AHCIC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x200000;               // abar_pa (synthetic)
        call ahci_ctrl_cap_mint_inner;
        cmp rax, 0;                      // expect row_id == 0 (fresh table)
        jne bxfw_fail_stage;

        mov rdi, 134;
        mov rsi, 0x19A;                  // KIND_AHCI_CONTROLLER
        mov rdx, 0x43F;
        xor rcx, rcx;                    // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        sub rsp, 32;
        xor rax, rax;
        mov [rsp + 0], rax;              // port_index = 0
        mov rax, 512;
        mov [rsp + 8], rax;              // sector_size
        mov rax, 2000000;
        mov [rsp + 16], rax;             // block_count
        xor rax, rax;
        mov [rsp + 24], rax;             // parent_ctrl_row = 0

        mov rdi, 135;                    // port_slot
        mov rsi, 136;                    // blk_slot
        mov rdx, 134;                    // parent_slot
        mov rcx, 0x41F;                  // port_rights (R_AHCIP_ALL)
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                    // params_ptr
        call ahci_port_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // AHCIP_MAX
        cmp rax, r10;
        jae bxfw_fail_stage;

        // QUERY_GEOM (op 0): expect (512 << 32) | 2000000.
        mov rdi, 136;
        xor rsi, rsi;
        call cap_invoke;
        mov r8, 512;
        shl r8, 32;
        mov r9, 2000000;
        or  r8, r9;
        cmp rax, r8;
        jne bxfw_fail_stage;

        // QUERY_FAMILY (op 1): expect 2 (AHCI).
        mov rdi, 136;
        mov rsi, 1;
        call cap_invoke;
        cmp rax, 2;
        jne bxfw_fail_stage;

        // QUERY_FEATURES (op 2): expect 9 (FLUSH_SUPPORTED |
        // WRITE_CACHE_PRESENT, both unconditional/default at M6-004).
        mov rdi, 136;
        mov rsi, 2;
        call cap_invoke;
        cmp rax, 9;
        jne bxfw_fail_stage;

        // -----------------------------------------------------------
        // Both families answered correctly through the identical
        // cap_invoke(slot, op_code) call shape. Stamp OK, clean up,
        // return.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bxfw_ok];
        call klog_s1;

        call bxfw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        xor rax, rax;
        jmp bxfw_out;

      bxfw_fail_stage:
        lea rax, [rip + _bxfw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bxfw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call bxfw_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        mov rax, 1;

      bxfw_out:
        pop rbx;
        ret
      }
    }
}
