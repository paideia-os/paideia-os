// tests/kernel/cap/ec_query_synth.pdx
//   R31.M1-001 (#1089) + R31.M1-002 (#1090) + R31.M1-003 (#1091)
//   + R31.M1-004 (#1092) + R31.M1-005 (#1093)
//
// Boot witness for the kernel's half of the embedded-controller path:
// the KIND_EC_QUERY two-part derivation gate and its monotone notify
// bitmap, the transaction gate with its audit trail, the routing of a
// decoded query into the platform event stream, what a query byte MEANS,
// and which meanings may be lost when the stream is under pressure.
//
// Fingerprints, in emission order:
//   `R31 KIND_EC_QUERY OK`   — stage A, the capability
//   `R31 EC ACCESS OK`       — stage B, the transaction gate
//   `R31 EC QUERY ROUTE OK`  — stage C, the routing
//   `R31 EC EVENT CLASS OK`  — stage D, the meaning table + AC presence
//   `R31 EC EVENT SHED OK`   — stage E, lid + power button + Fn burst
//
// =====================================================================
// WHY FIVE FINGERPRINTS AND NOT ONE
// =====================================================================
// The five issues are five mechanisms that happen to share a device.
// A single marker would mean a regression in any one of them presents
// as the same missing line, and the goldens assert an ORDERED
// SUBSEQUENCE — so five markers localise a failure to a fifth of the
// witness before anyone opens a log.
//
// =====================================================================
// WHAT STAGES D AND E DO NOT ASSERT, AND WHY THAT IS SAID HERE
// =====================================================================
// #1092 and #1093 are about routing platform events "to power/policy
// consumers". THERE ARE NO SUCH CONSUMERS. No ring-3 program binds a
// KIND_ACPI_EVENT endpoint, there is no DRAIN op by deliberate design,
// nothing under `src/user/` implements a power policy, and the ring-3
// pump that would call the router has no caller either.
// `src/kernel/core/acpi/ec_event.pdx` §1 states all of that in full.
//
// So these two stages assert EXACTLY WHAT HAPPENS and nothing more: a
// classified record lands in a kernel ring, the shed rule holds under a
// burst, and a loss is counted against the class that suffered it.
// Neither asserts, or implies, that anything acted on an event. A
// witness that dressed the kernel talking to itself up as delivery to a
// policy layer would be the failure #1590 had to unwind for three
// already-closed issues, and it is not repeated here.
//
// =====================================================================
// THE ASSERTION THIS FILE EXISTS TO MAKE, IF YOU READ ONLY ONE
// =====================================================================
// Stage B asserts `ec_access_arbitrated() == 0`.
//
// That is not a placeholder. The ACPI Global Lock — the only thing that
// stops this OS and System Management Mode driving the controller at the
// same time — is implemented and correct, and is INERT in a real boot,
// because the FACS address is never read out of the FADT and the PM1
// control port is never carried to the ring-3 bubble that would use it.
// #1580 tracks that plumbing; this milestone did not take it.
//
// So the gap is asserted rather than described. When #1580 lands, THIS
// ASSERTION FAILS, and the commit that plumbs the lock cannot pass the
// pre-push matrix without also rewriting the statements in
// `src/kernel/core/drivers/ec/ec_access.pdx` and
// `design/drivers/embedded-controller-kernel-path.md` that say the path
// is unarbitrated. A comment would have rotted silently. This cannot.
//
// It is the same device #1065 used to keep the EC gate honest while it
// was shut: an assertion that fails when the thing it describes becomes
// true.
//
// =====================================================================
// CAPABILITY SLOTS
// =====================================================================
// 200..211, disjoint from every other witness in the tree (which use
// 0..8, 10..12, 14..19, 28..33, 46..63, 64..95, 110..117, 160..199).
// Every one is cleared on both exits, so the next witness inherits an
// empty set exactly as this one was handed one.
//
//   200  KIND_IO_PORT      base authority for a port-like op-region
//   201  KIND_OP_REGION    EmbeddedControl, base 0x40, len 64
//   202  KIND_MEMORY       base authority for a memory-like op-region
//   203  KIND_OP_REGION    SystemMemory — the WRONG-SPACE region
//   204  KIND_IPC_ENDPOINT id 0x41, with RIGHT_MINT
//   205  KIND_IPC_ENDPOINT id 0x43, with RIGHT_MINT
//   206  KIND_IPC_ENDPOINT id 0x44, WITHOUT RIGHT_MINT
//   207  KIND_EC_QUERY     subscriber A
//   208  KIND_EC_QUERY     subscriber B
//   209  KIND_HW           base authority for the SCI interrupt
//   210  KIND_HW_INTERRUPT the SCI
//   211  KIND_ACPI_EVENT   the stream endpoint stage C binds
//
// THE REGION IS 64 BYTES, NOT 256, AND THAT IS LOAD-BEARING. Stage B
// asserts that address 64 is refused. Sixty-four is inside the 256-byte
// EmbeddedControl space and outside the extent the capability granted,
// so a gate that confined to the SPECIFICATION rather than to the GRANT
// passes every other assertion in this file and fails that one.

module EcQuerySynth = structure {

  pub let mut _ecq_w_stage : u64 = 0

  pub let ecq_w_ok_a   : [u8; 22] = "R31 KIND_EC_QUERY OK\n\0"
  pub let ecq_w_fail_a : [u8; 24] = "R31 KIND_EC_QUERY FAIL\n\0"
  pub let ecq_w_ok_b   : [u8; 18] = "R31 EC ACCESS OK\n\0"
  pub let ecq_w_fail_b : [u8; 20] = "R31 EC ACCESS FAIL\n\0"
  pub let ecq_w_ok_c   : [u8; 23] = "R31 EC QUERY ROUTE OK\n\0"
  pub let ecq_w_fail_c : [u8; 25] = "R31 EC QUERY ROUTE FAIL\n\0"
  pub let ecq_w_ok_d   : [u8; 23] = "R31 EC EVENT CLASS OK\n\0"
  pub let ecq_w_fail_d : [u8; 25] = "R31 EC EVENT CLASS FAIL\n\0"
  pub let ecq_w_ok_e   : [u8; 22] = "R31 EC EVENT SHED OK\n\0"
  pub let ecq_w_fail_e : [u8; 24] = "R31 EC EVENT SHED FAIL\n\0"

  // ==========================================================================
  // ecq_w_seed(slot, kind, rights, target_ptr) — plant one base
  // capability through cap_mint_write, the sanctioned writer (#1579),
  // rather than storing into cap_table directly.
  // ==========================================================================

  pub let ecq_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): plant one base capability for the fixture through cap_mint_write. A pass-through, existing so the witness body reads as a list of authorities rather than as four register moves repeated a dozen times, and so the fixture cannot drift into writing descriptors by a route the mint does not use -- which matters here in particular because cap_mint_write also clears the owner column (#1587), and a fixture that stored three words directly would leave slots 200..211 owned by whoever last held them. Reserved labels: none.",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // ecq_w_clear() — return every slot this fixture uses to null.
  // ==========================================================================

  pub let ecq_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): null out cap_table slots 200..211 through cap_mint_write. Called on BOTH exits, so a failing fixture leaves the table exactly as clean as a passing one -- a witness whose failure path leaked twelve descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes plus the return address would misalign; one push (rbx, the loop counter) leaves rsp%16 == 0 at the nested call. Labels prefixed ecq_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, 200;
      ecq_wc_next:
        cmp rbx, 212;
        jae ecq_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call ecq_w_seed;
        add rbx, 1;
        jmp ecq_wc_next;
      ecq_wc_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ecq_w_scrub() — return every module this fixture touches to its
  // boot state.
  // ==========================================================================

  pub let ecq_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-003 (#1091), extended by R31.M1-004 (#1092): reset the subscription table, the router counters, the meaning table, the transaction gate and the platform event stream. Called on both exits for the reason ecq_w_clear is: the stream in particular is SHARED with tests/kernel/acpi/evt_route_synth.pdx, which runs earlier in the same boot and asserts an accounting identity over its own offers -- leaving records or a binding behind would corrupt whichever witness ran next rather than reporting a fault here. ec_event_reset is the one that matters most for a LATER reader: it clears the byte-to-class map, and a fixture that left meanings installed against a controller address would make the next reader of ec_event_class_of get an answer this fixture invented. The order matters only in one place: ec_access_unbind before ec_access_reset, because unbind clears the binding and reset deliberately preserves it, so the other order would leave a stale extent behind a cleared bound flag. One push (rbx, unused) leaves rsp%16 == 0 at the nested calls. Labels prefixed ecq_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call ec_query_table_reset;
        call ec_route_reset;
        call ec_event_reset;
        call ec_access_unbind;
        call ec_access_reset;
        call acpi_evt_unbind;
        call acpi_evt_stream_reset;
        call acpi_evt_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let ec_query_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M1-001/002/003/004/005 (#1089/#1090/#1091/#1092/#1093): boot witness for the KIND_EC_QUERY two-part derivation gate and monotone notify bitmap, the embedded-controller transaction gate and its audit trail, the routing of a decoded query into the platform event stream, the byte-to-class meaning table, and the admission rule that stops a hot-key burst evicting a power-button press. STAGES D AND E ASSERT WHAT ACTUALLY HAPPENS AND NOT DELIVERY TO A POLICY LAYER: there is no policy layer, no ring-3 subscriber and no drain op, and core/acpi/ec_event.pdx sec 1 says so at length -- what they assert is that a classified record lands in a kernel ring, that the shed rule holds under a forty-query burst, and that a loss is counted against the class that suffered it. Stage E's E3 is the load-bearing one in this pair: after a burst long enough to have filled a 32-slot tail-drop ring, THE POWER BUTTON STILL LANDS, which is the priority inversion the milestone would otherwise have shipped and the only assertion here that is not bookkeeping. Stage D's D4 carries the vacuity guard for the whole pair -- eight meanings installed -- because every classification assertion after it would pass unchanged against a table that stored nothing and answered NONE to everything. Drives the shipping functions only; the fixture writes no descriptor except through cap_mint_write and installs no seam. Emits five fingerprints rather than one so a regression localises to a fifth of the witness before a log is opened, and each stage runs only if the previous one passed -- stage B binds the region stage A minted the subscription against, and stage C routes to the subscriptions stage A proved can be created, so a cascade of failures from one cause is reported once at its origin. THE ASSERTION AT STAGE 35 IS THE ONE TO NOTE: ec_access_arbitrated() is pinned at 0, which is the machine-checkable form of 'transactions through this path are not arbitrated against System Management Mode because #1580 has not plumbed the FACS address or the PM1 control port'. When that plumbing lands the pin fails, and the commit cannot pass the pre-push matrix without rewriting the statements that say the path is unarbitrated -- which is exactly what a comment would not have forced. Stage 38 is the other load-bearing one: the region is minted with a length of 64, so an address of 64 is inside the 256-byte space the specification defines and outside the extent the capability granted, and a gate that confined to the specification passes everything else here and fails that. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Both exits call ecq_w_scrub and ecq_w_clear. Labels prefixed ecq_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        call ecq_w_clear;
        call ecq_w_scrub;

        // Base authorities.
        mov rdi, 200;
        mov rsi, 11;                     // KIND_IO_PORT
        mov rdx, 0x61B;                  // R_OPREG_ALL
        xor rcx, rcx;
        call ecq_w_seed;

        mov rdi, 202;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x61B;
        xor rcx, rcx;
        call ecq_w_seed;

        mov rdi, 204;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 0x41;                   // endpoint id
        call ecq_w_seed;

        mov rdi, 205;
        mov rsi, 5;
        mov rdx, 0x200;
        mov rcx, 0x43;
        call ecq_w_seed;

        // An endpoint WITHOUT RIGHT_MINT. Holding an endpoint is not
        // being allowed to hand its reach onward.
        mov rdi, 206;
        mov rsi, 5;
        mov rdx, 0x001;
        mov rcx, 0x44;
        call ecq_w_seed;

        // The EmbeddedControl region: base 0x40, LENGTH 64 (not 256).
        mov rax, 2;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 201;
        mov rsi, 200;
        mov rdx, 0x61B;
        mov rcx, 0x03;                   // OPREG_SPACE_EC
        mov r8,  0x40;                   // base
        mov r9,  64;                     // len
        call opregion_cap_mint_root;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        // A SystemMemory region, for the wrong-space refusal.
        mov rax, 3;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 203;
        mov rsi, 202;
        mov rdx, 0x61B;
        xor rcx, rcx;                    // OPREG_SPACE_SYSTEM_MEMORY
        mov r8,  0x1000;
        mov r9,  64;
        call opregion_cap_mint_root;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        // ================================================================
        // STAGE A — KIND_EC_QUERY
        // ================================================================

        // -- A1. The parent is not an endpoint at all.
        mov rax, 10;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 200;                    // KIND_IO_PORT
        mov rdx, 201;
        mov rcx, 0x41A;                  // R_EC_QUERY_ALL
        call ec_query_cap_mint;
        mov r11, 0xFFFFFE0D;             // EC_QUERY_MINT_BAD_PARENT
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A2. An endpoint, but without RIGHT_MINT.
        mov rax, 11;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 206;
        mov rdx, 201;
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        mov r11, 0xFFFFFE0D;
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A3. THE SECOND HALF. A perfectly good endpoint with MINT,
        //    and something that is not a region capability. This is the
        //    refusal the whole kind exists for: the first half admits
        //    every endpoint in the machine, so without this the shell's
        //    stdout could mint a subscription to the controller.
        mov rax, 12;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 204;
        mov rdx, 200;                    // KIND_IO_PORT, not an op-region
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        mov r11, 0xFFFFFE09;             // EC_QUERY_MINT_BAD_REGION
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A4. A real region capability, over the wrong space. A
        //    DISTINCT code from A3, because the fixes differ.
        mov rax, 13;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 204;
        mov rdx, 203;                    // SystemMemory
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        mov r11, 0xFFFFFE08;             // EC_QUERY_MINT_BAD_SPACE
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A5. RIGHT_MINT is not a right this kind defines. Refused,
        //    not silently stripped: this kind is a leaf of the lattice
        //    and a holder must not believe it can derive.
        mov rax, 14;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 204;
        mov rdx, 201;
        mov rcx, 0x61A;                  // R_EC_QUERY_ALL | RIGHT_MINT
        call ec_query_cap_mint;
        mov r11, 0xFFFFFE0C;             // EC_QUERY_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A6. Both halves held. The mint succeeds and the controller
        //    address is INHERITED from the region row — note there is no
        //    argument in the call that could have supplied it.
        mov rax, 15;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 207;
        mov rsi, 204;
        mov rdx, 201;
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;                    // row 0
        call ec_query_row_addr;
        mov r11, 0x40;                   // the REGION's base
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        call ec_query_row_endpoint;
        mov r11, 0x41;                   // the ENDPOINT's id
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        call ec_query_row_delivered;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        // -- A7. The bitmap starts FULL, across all four words.
        mov rax, 16;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        xor rsi, rsi;                    // query byte 0x00, word 0
        call ec_query_row_wants;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        mov rsi, 0x80;                   // word 2, bit 0
        call ec_query_row_wants;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        mov rsi, 0xFF;                   // word 3, bit 63
        call ec_query_row_wants;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        // -- A8. Narrowing clears EXACTLY ONE BIT. The neighbours are
        //    checked on both sides of a word boundary (0x80 is bit 0 of
        //    word 2, 0x7F is bit 63 of word 1), which is where an
        //    off-by-one in the word index or the bit index shows up.
        mov rax, 17;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 0x80;
        call ec_query_row_narrow;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        mov rsi, 0x80;
        call ec_query_row_wants;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        mov rsi, 0x81;
        call ec_query_row_wants;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        mov rsi, 0x7F;
        call ec_query_row_wants;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        // -- A9. Idempotent: unsubscribing twice is not an error.
        mov rax, 18;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 0x80;
        call ec_query_row_narrow;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        // -- A10. A query byte that is not a byte is refused, with a
        //    code rather than a silent no-op: a caller unsubscribing
        //    from an event it will still receive must be told.
        mov rax, 19;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 256;
        call ec_query_row_narrow;
        mov r11, 0xFFFFFE03;             // EC_QUERY_NARROW_BAD_ARG
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A11. The handler's three authority classes are separable.
        mov rax, 20;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        // OBSERVE cannot interrogate the routing filter.
        mov rdi, 0x400;
        xor rsi, rsi;
        mov rdx, 3;                      // OP_QUERY_WANTS
        call cap_handler_ec_query;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // INVOKE cannot narrow it.
        mov rdi, 0x008;
        xor rsi, rsi;
        mov rdx, 0x1004;                 // OP_UNSUBSCRIBE, byte 0x10
        call cap_handler_ec_query;
        mov r11, 0xFFFFFFFFFFFFFFFD;
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // INVOKE can read it.
        mov rdi, 0x008;
        xor rsi, rsi;
        mov rdx, 0x8103;                 // OP_QUERY_WANTS, byte 0x81
        call cap_handler_ec_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_a;

        // WRITE can narrow it, and the narrowing is observable.
        mov rdi, 0x002;
        xor rsi, rsi;
        mov rdx, 0x8104;                 // OP_UNSUBSCRIBE, byte 0x81
        call cap_handler_ec_query;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        mov rdi, 0x008;
        xor rsi, rsi;
        mov rdx, 0x8103;
        call cap_handler_ec_query;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        // OBSERVE reads the controller address.
        mov rdi, 0x400;
        xor rsi, rsi;
        xor rdx, rdx;                    // OP_QUERY_ADDR
        call cap_handler_ec_query;
        mov r11, 0x40;
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // An op that does not exist is unsupported, not denied.
        mov rdi, 0x41A;
        xor rsi, rsi;
        mov rdx, 9;
        call cap_handler_ec_query;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // -- A12. The row allocator refuses a zero identity, and runs
        //    out honestly.
        mov rax, 21;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 204;
        mov rsi, 201;
        xor rdx, rdx;
        call ec_query_tail_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_w_fail_stage_a;
        mov r13, rax;                    // a well-formed header

        mov rdi, r13;
        mov rsi, 0x40;
        xor rdx, rdx;                    // endpoint id 0 — the stream's
                                         // "no subscriber" sentinel
        call ec_query_tail_alloc;
        mov r11, 0xFFFFFE0E;             // EC_QUERY_TAIL_BAD_ARG
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // Seven more rows fill the table (row 0 is the live mint).
        mov rbx, 0;
      ecq_w_fill:
        cmp rbx, 7;
        jae ecq_w_filled;
        mov rdi, r13;
        mov rsi, 0x40;
        mov rdx, 0x55;
        call ec_query_tail_alloc;
        mov r11, 0xFFFFFE0F;             // EC_QUERY_TAIL_ENOSPC
        cmp rax, r11;
        je  ecq_w_fail_stage_a;
        mov r11, 0xFFFFFE0E;
        cmp rax, r11;
        je  ecq_w_fail_stage_a;
        add rbx, 1;
        jmp ecq_w_fill;

      ecq_w_filled:
        mov rdi, r13;
        mov rsi, 0x40;
        mov rdx, 0x55;
        call ec_query_tail_alloc;
        mov r11, 0xFFFFFE0F;
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // Free them again, rows 1..7.
        mov rbx, 1;
      ecq_w_drain:
        cmp rbx, 8;
        jae ecq_w_drained;
        mov rdi, rbx;
        call ec_query_tail_free;
        add rbx, 1;
        jmp ecq_w_drain;

      ecq_w_drained:
        // -- A13. Revoke frees the row and scrubs it.
        mov rax, 22;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 207;
        call ec_query_cap_revoke;
        cmp rax, 0;
        jne ecq_w_fail_stage_a;

        xor rdi, rdi;
        call ec_query_row_addr;
        mov r11, 0xFFFFFFFFFFFFFFFF;     // EC_QUERY_DECODE_BAD
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        mov rdi, 207;
        call ec_query_cap_revoke;
        mov r11, 0xFFFFFE04;             // EC_QUERY_REVOKE_ALREADY
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // A revoke aimed at this kind must not free another kind's row.
        mov rdi, 200;
        call ec_query_cap_revoke;
        mov r11, 0xFFFFFE05;             // EC_QUERY_REVOKE_WRONG_KIND
        cmp rax, r11;
        jne ecq_w_fail_stage_a;

        // The KIND_IO_PORT is still there, untouched.
        mov rdi, 200;
        mov rsi, 11;
        mov rdx, 0x61B;
        xor rcx, rcx;
        call ecq_w_seed;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — the transaction gate
        // ================================================================

        // -- B1. No binding, no transaction.
        mov rax, 30;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // EC_ACCESS_OP_READ
        xor rsi, rsi;
        xor rdx, rdx;
        call ec_access_audit;
        mov r11, 0xFFFFFDCA;             // EC_ACCESS_UNBOUND
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        mov rdi, 9;                      // EC_ACCESS_ST_REF_UNBOUND
        call ec_access_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_b;

        // -- B2. Binding demands an op-region capability.
        mov rax, 31;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 200;
        call ec_access_bind;
        mov r11, 0xFFFFFDCE;             // EC_ACCESS_BIND_BAD_KIND
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B3. And one over the controller's own space.
        mov rax, 32;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 203;
        call ec_access_bind;
        mov r11, 0xFFFFFDCD;             // EC_ACCESS_BIND_BAD_SPACE
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B4. The extent is INHERITED. Arity one; there is no
        //    argument that could have declared it.
        mov rax, 33;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 201;
        call ec_access_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        call ec_access_bound;
        cmp rax, 1;
        jne ecq_w_fail_stage_b;

        call ec_access_base;
        mov r11, 0x40;
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        call ec_access_len;
        mov r11, 64;
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B5. Rebinding is refused, not silently accepted: it would
        //    retroactively change which addresses were legal.
        mov rax, 34;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 201;
        call ec_access_bind;
        mov r11, 0xFFFFFDCB;             // EC_ACCESS_BIND_ALREADY
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // ================================================================
        // -- B6. THE #1580 PIN.
        //
        // This path is NOT arbitrated against System Management Mode.
        // The Global Lock is implemented and inert: the FACS address is
        // never read out of the FADT, and the PM1 control port is never
        // carried to the bubble that would ring the release doorbell.
        //
        // WHEN #1580 LANDS, THIS ASSERTION FAILS. That is its purpose.
        // The commit that plumbs the lock must rewrite the statements in
        // core/drivers/ec/ec_access.pdx and in
        // design/drivers/embedded-controller-kernel-path.md that say the
        // path is unarbitrated, and this line is what makes that
        // mandatory rather than remembered.
        // ================================================================
        mov rax, 35;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call ec_access_arbitrated;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        // -- B7. A read inside the grant.
        mov rax, 36;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        xor rsi, rsi;
        xor rdx, rdx;
        call ec_access_audit;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        mov rdi, 7;                      // EC_ACCESS_ST_READS
        call ec_access_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_b;

        // -- B8. A write at the last legal offset, and the audit record
        //    it left. The record carries the VALUE as well as the
        //    address, because "which byte was written" is the question
        //    a persistent charge threshold makes someone ask.
        mov rax, 37;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 2;                      // EC_ACCESS_OP_WRITE
        mov rsi, 63;                     // len - 1
        mov rdx, 0xAA;
        call ec_access_audit;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        xor rdi, rdi;                    // newest record
        mov rsi, 1;                      // DRV_AUDIT_F_EVENT
        call drv_audit_field;
        mov r11, 7;                      // DRV_AUDIT_EV_EC_XACT
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        xor rdi, rdi;
        mov rsi, 2;                      // DRV_AUDIT_F_KIND
        call drv_audit_field;
        cmp rax, 0;                      // not a capability transition
        jne ecq_w_fail_stage_b;

        xor rdi, rdi;
        mov rsi, 3;                      // DRV_AUDIT_F_SUBJECT
        call drv_audit_field;
        mov r11, 63;
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        xor rdi, rdi;
        mov rsi, 4;                      // DRV_AUDIT_F_PRINCIPAL
        call drv_audit_field;
        mov r11, 0x2000000AA;            // (op 2 << 32) | value 0xAA
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        xor rdi, rdi;
        mov rsi, 5;                      // DRV_AUDIT_F_OUTCOME
        call drv_audit_field;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        // ================================================================
        // -- B9. THE CONFINEMENT ASSERTION.
        //
        // 64 is INSIDE the 256-byte EmbeddedControl space and OUTSIDE
        // the 64-byte extent this capability granted. A gate confined to
        // the specification rather than to the grant passes every other
        // assertion in this file and fails here.
        // ================================================================
        mov rax, 38;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 64;
        xor rdx, rdx;
        call ec_access_audit;
        mov r11, 0xFFFFFDC9;             // EC_ACCESS_RANGE
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // Refused, and NOT clamped: nothing was permitted by it.
        mov rdi, 6;                      // EC_ACCESS_ST_PERMITTED
        call ec_access_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_b;

        mov rdi, 10;                     // EC_ACCESS_ST_REF_RANGE
        call ec_access_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_b;

        // The refusal is audited too — the most important record this
        // module can ever make is the one for a write it stopped.
        xor rdi, rdi;
        mov rsi, 5;
        call drv_audit_field;
        mov r11, 0xFFFFFDC9;
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B10. Far outside, same answer.
        mov rax, 39;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        mov rsi, 255;
        xor rdx, rdx;
        call ec_access_audit;
        mov r11, 0xFFFFFDC9;
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B11. Neither a read nor a write.
        mov rax, 40;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 7;
        xor rsi, rsi;
        xor rdx, rdx;
        call ec_access_audit;
        mov r11, 0xFFFFFDC8;             // EC_ACCESS_BAD_OP
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        // -- B12. A value wider than the data port. Refused, not
        //    masked: masking puts a byte on the wire nobody asked for.
        mov rax, 41;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 2;
        xor rsi, rsi;
        mov rdx, 0x100;
        call ec_access_audit;
        mov r11, 0xFFFFFDC7;             // EC_ACCESS_BAD_VALUE
        cmp rax, r11;
        jne ecq_w_fail_stage_b;

        mov rdi, 12;                     // EC_ACCESS_ST_REF_VALUE
        call ec_access_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_b;

        // Still two permitted, after four refusals.
        mov rdi, 6;
        call ec_access_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_b;

        // -- B13. Unbinding scrubs the extent, not just the flag.
        mov rax, 42;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call ec_access_unbind;
        call ec_access_bound;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;
        call ec_access_len;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;
        call ec_access_base;
        cmp rax, 0;
        jne ecq_w_fail_stage_b;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_ok_b];
        call klog_s1;

        // ================================================================
        // STAGE C — routing a decoded query
        // ================================================================

        // -- C1. Nobody is subscribed. The query is counted as
        //    unrouted, ONCE, and nothing lands in the stream.
        mov rax, 50;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call ec_route_reset;
        call ec_query_table_reset;

        mov rdi, 0x40;
        mov rsi, 0x50;
        call ec_route_query;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 2;                      // EC_ROUTE_ST_UNROUTED
        call ec_route_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;

        call acpi_evt_depth;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        // -- C2. Two subscribers on one controller. Bind the stream
        //    first: an offer with nothing bound is refused, and stage C8
        //    asserts exactly that at the end.
        mov rax, 51;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 209;
        mov rsi, 14;                     // KIND_HW
        mov rdx, 0x618;
        xor rcx, rcx;
        call ecq_w_seed;

        mov rdi, 210;
        mov rsi, 209;
        mov rdx, 0x618;
        mov rcx, 9;                      // GSI 9, the conventional SCI
        mov r8,  1;                      // BSP
        mov r9,  1;                      // LEVEL, as ACPI requires
        call hw_int_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 211;
        mov rsi, 210;
        mov rdx, 0x618;
        mov rcx, 0xAB;                   // stream subscriber identity
        call acpi_evt_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 211;
        call acpi_evt_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 207;
        mov rsi, 204;                    // endpoint id 0x41
        mov rdx, 201;
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 208;
        mov rsi, 205;                    // endpoint id 0x43
        mov rdx, 201;
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 0x40;
        mov rsi, 0x50;
        call ec_route_query;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        call acpi_evt_depth;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        // The newest record: source 3, the controller, the query byte,
        // and NO acknowledgement owed. A query is not an acknowledging
        // source — the GPE that woke the machine was acknowledged by the
        // record that carried it, and acking twice re-enables a hardware
        // bit nobody masked.
        xor rdi, rdi;
        xor rsi, rsi;                    // ACPI_EVT_RF_SOURCE
        call acpi_evt_field;
        cmp rax, 3;                      // ACPI_EVT_SRC_EC_QUERY
        jne ecq_w_fail_stage_c;

        xor rdi, rdi;
        mov rsi, 2;                      // ACPI_EVT_RF_A0
        call acpi_evt_field;
        mov r11, 0x40;
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        xor rdi, rdi;
        mov rsi, 3;                      // ACPI_EVT_RF_A1
        call acpi_evt_field;
        mov r11, 0x50;
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        xor rdi, rdi;
        mov rsi, 6;                      // ACPI_EVT_RF_FLAGS
        call acpi_evt_field;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        // Each subscriber got its OWN identity, not the stream's.
        xor rdi, rdi;
        mov rsi, 1;                      // ACPI_EVT_RF_SUB
        call acpi_evt_field;
        mov r11, 0x43;                   // row 1, offered last
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        mov rdi, 1;                      // one back
        mov rsi, 1;
        call acpi_evt_field;
        mov r11, 0x41;                   // row 0
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        // Per-row delivery accounting moved for both.
        xor rdi, rdi;
        call ec_query_row_delivered;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;
        mov rdi, 1;
        call ec_query_row_delivered;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;

        // -- C3. One subscriber narrows away. FILTERED is not
        //    UNROUTED: the system is working as configured.
        mov rax, 52;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 0x51;
        call ec_query_row_narrow;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 0x40;
        mov rsi, 0x51;
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;

        mov rdi, 1;                      // EC_ROUTE_ST_FILTERED
        call ec_route_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;

        mov rdi, 0;                      // EC_ROUTE_ST_ROUTED
        call ec_route_stat;
        cmp rax, 3;
        jne ecq_w_fail_stage_c;

        // -- C4. Query zero is not a query. Nothing is offered.
        mov rax, 53;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call acpi_evt_depth;
        mov r14, rax;                    // depth before

        mov rdi, 0x40;
        xor rsi, rsi;
        call ec_route_query;
        mov r11, 0xFFFFFDEE;             // EC_ROUTE_ZERO
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        mov rdi, 4;                      // EC_ROUTE_ST_ZERO
        call ec_route_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_c;

        call acpi_evt_depth;
        cmp rax, r14;
        jne ecq_w_fail_stage_c;

        // -- C5/C6. A byte that is not a byte; an address the space
        //    cannot hold. Distinct codes, one counter.
        mov rax, 54;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x40;
        mov rsi, 256;
        call ec_route_query;
        mov r11, 0xFFFFFDEF;             // EC_ROUTE_BAD_BYTE
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        mov rax, 55;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 256;
        mov rsi, 0x50;
        call ec_route_query;
        mov r11, 0xFFFFFDED;             // EC_ROUTE_BAD_ADDR
        cmp rax, r11;
        jne ecq_w_fail_stage_c;

        mov rdi, 5;                      // EC_ROUTE_ST_BAD
        call ec_route_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        // -- C7. A different controller reaches nobody, and does not
        //    reach these subscribers by accident.
        mov rax, 56;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x99;
        mov rsi, 0x50;
        call ec_route_query;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 2;                      // EC_ROUTE_ST_UNROUTED
        call ec_route_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        // -- C8. With nothing bound, a matching subscription still
        //    counts as REFUSED and never as unrouted: backpressure and a
        //    missing capability are different faults.
        mov rax, 57;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call acpi_evt_unbind;

        mov rdi, 0x40;
        mov rsi, 0x50;
        call ec_route_query;
        cmp rax, 0;
        jne ecq_w_fail_stage_c;

        mov rdi, 3;                      // EC_ROUTE_ST_REFUSED
        call ec_route_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        mov rdi, 2;                      // unrouted did NOT move
        call ec_route_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_c;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_ok_c];
        call klog_s1;

        // ================================================================
        // STAGE D — WHAT A QUERY BYTE MEANS, AND AC PRESENCE (#1092)
        //
        // The meaning table: authority-gated, inherited-address,
        // monotone, per-controller. Then #1092's own deliverable — an
        // AC-adapter transition arriving in the stream labelled as one.
        // ================================================================

        // -- D1. Nothing is bound, nothing has a meaning, and a meaning
        //    cannot be installed. A byte with no controller behind it is
        //    an assertion about no machine.
        mov rax, 60;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        call ec_event_reset;

        call ec_event_map_bound;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x40;
        mov rsi, 0x30;
        call ec_event_class_of;
        cmp rax, 0;                      // EC_EVT_CLASS_NONE
        jne ecq_w_fail_stage_d;

        mov rdi, 0x30;
        mov rsi, 1;                      // EC_EVT_CLASS_AC
        call ec_event_map_set;
        mov r11, 0xFFFFFDBF;             // EC_EVT_MAP_UNBOUND
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        mov rdi, 3;                      // EC_EVT_OWN_REFUSED
        call ec_event_own_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_d;

        // -- D2. The binding needs a KIND_OP_REGION over the
        //    EmbeddedControl space. Slot 203 is a live region capability
        //    over SystemMemory: holding a region is not being allowed to
        //    say what an embedded controller's bytes mean.
        mov rax, 61;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 203;
        call ec_event_map_bind;
        mov r11, 0xFFFFFDBB;             // EC_EVT_BIND_BAD_CAP
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        call ec_event_map_bound;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        // The right one binds, and the CONTROLLER ADDRESS IS INHERITED:
        // 0x40 is the base slot 201 was minted with, and it was passed to
        // nothing.
        mov rdi, 201;
        call ec_event_map_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        call ec_event_map_addr;
        mov r11, 0x40;
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        // -- D3. Rebinding is refused, not replaced. A replacement would
        //    leave one controller's meanings under another's address with
        //    no counter moving.
        mov rax, 62;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 201;
        call ec_event_map_bind;
        mov r11, 0xFFFFFDBA;             // EC_EVT_BIND_ALREADY
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        // -- D4. Install a plausible T14-shaped map. THESE NUMBERS ARE
        //    THE FIXTURE'S, NOT THE PLATFORM'S: which byte a vendor uses
        //    for the lid is a fact about its firmware, and the whole
        //    point of the table is that this kernel does not presume it.
        mov rax, 63;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 0x20;
        mov rsi, 3;                      // EC_EVT_CLASS_POWER
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x2B;
        mov rsi, 2;                      // EC_EVT_CLASS_LID
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x30;
        mov rsi, 1;                      // EC_EVT_CLASS_AC  (insertion)
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x31;
        mov rsi, 1;                      // EC_EVT_CLASS_AC  (removal)
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        // Four hot-key bytes, because stage E needs a burst and one Fn
        // press can produce more than one query.
        mov rbx, 0x60;
      ecq_w_d_hk:
        cmp rbx, 0x64;
        jae ecq_w_d_hk_done;
        mov rdi, rbx;
        mov rsi, 4;                      // EC_EVT_CLASS_HOTKEY
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;
        add rbx, 1;
        jmp ecq_w_d_hk;
      ecq_w_d_hk_done:

        // Eight entries acquired a meaning. THE VACUITY GUARD: without
        // this, every assertion below would still pass on a map that
        // stored nothing and answered NONE to everything.
        mov rdi, 2;                      // EC_EVT_OWN_INSTALLED
        call ec_event_own_stat;
        cmp rax, 8;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x40;
        mov rsi, 0x20;
        call ec_event_class_of;
        cmp rax, 3;                      // POWER
        jne ecq_w_fail_stage_d;

        mov rdi, 0x40;
        mov rsi, 0x2B;
        call ec_event_class_of;
        cmp rax, 2;                      // LID
        jne ecq_w_fail_stage_d;

        // -- D5. Byte 0 CANNOT BE GIVEN A MEANING. QR_EC returning 0
        //    means no query is pending; a class for it would make this
        //    the one place in the path that treats 'nothing happened' as
        //    an event with semantics. And a class above the enumeration
        //    is refused rather than stored: thermal and battery are
        //    R31.M2/M3's, and no counter has a slot for them yet.
        mov rax, 64;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        xor rdi, rdi;
        mov rsi, 2;
        call ec_event_map_set;
        mov r11, 0xFFFFFDBE;             // EC_EVT_MAP_BAD_BYTE
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x70;
        mov rsi, 5;                      // one past EC_EVT_CLASS_MAX
        call ec_event_map_set;
        mov r11, 0xFFFFFDBD;             // EC_EVT_MAP_BAD_CLASS
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        // -- D6. THE MONOTONICITY GATE, which is the assertion in this
        //    stage that matters most. A byte that means POWER cannot
        //    later mean HOTKEY: every downstream decision is taken from
        //    the class, so a silent remap turns a power-button press into
        //    a droppable Fn key and nothing complains until a machine
        //    will not turn off.
        mov rax, 65;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x20;
        mov rsi, 4;                      // HOTKEY over POWER
        call ec_event_map_set;
        mov r11, 0xFFFFFDBC;             // EC_EVT_MAP_ALREADY
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x40;
        mov rsi, 0x20;
        call ec_event_class_of;
        cmp rax, 3;                      // still POWER
        jne ecq_w_fail_stage_d;

        // Re-installing the SAME meaning is idempotent, and does not
        // count as a second installation.
        mov rdi, 0x20;
        mov rsi, 3;
        call ec_event_map_set;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 2;                      // EC_EVT_OWN_INSTALLED
        call ec_event_own_stat;
        cmp rax, 8;
        jne ecq_w_fail_stage_d;

        // Four refusals so far: unbound, bad byte, bad class, already.
        mov rdi, 3;                      // EC_EVT_OWN_REFUSED
        call ec_event_own_stat;
        cmp rax, 4;
        jne ecq_w_fail_stage_d;

        // -- D7. A SECOND CONTROLLER GETS NO MEANINGS RATHER THAN THE
        //    WRONG ONES, and the fact is observable. This is the
        //    single-controller assumption enforced instead of assumed.
        mov rax, 66;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x99;
        mov rsi, 0x20;
        call ec_event_class_of;
        cmp rax, 0;                      // NONE, not POWER
        jne ecq_w_fail_stage_d;

        mov rdi, 4;                      // EC_EVT_OWN_FOREIGN
        call ec_event_own_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_d;

        // -- D8. #1092's DELIVERABLE. An AC-adapter insertion routes, and
        //    the record says AC — a0 the controller, a1 the byte, a2 THE
        //    MEANING. Nothing here asserts a policy layer received it,
        //    because there is no policy layer: core/acpi/ec_event.pdx §1.
        mov rax, 67;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        call ec_route_reset;
        call acpi_evt_stream_reset;
        mov rdi, 211;
        call acpi_evt_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_d;

        mov rdi, 0x40;
        mov rsi, 0x30;                   // AC insertion
        call ec_route_query;
        cmp rax, 2;                      // both subscriptions took it
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        xor rsi, rsi;                    // ACPI_EVT_RF_SOURCE
        call acpi_evt_field;
        cmp rax, 3;                      // ACPI_EVT_SRC_EC_QUERY
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        mov rsi, 3;                      // ACPI_EVT_RF_A1
        call acpi_evt_field;
        mov r11, 0x30;
        cmp rax, r11;
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        mov rsi, 4;                      // ACPI_EVT_RF_A2 = the class
        call acpi_evt_field;
        cmp rax, 1;                      // EC_EVT_CLASS_AC
        jne ecq_w_fail_stage_d;

        // One query SEEN, two records DELIVERED. The two numbers are not
        // meant to agree: one is how often the adapter moved, the other
        // is how many principals were told.
        mov rdi, 1;                      // EC_EVT_CLASS_AC
        xor rsi, rsi;                    // EC_EVT_CT_SEEN
        call ec_event_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_d;

        mov rdi, 1;
        mov rsi, 1;                      // EC_EVT_CT_DELIVERED
        call ec_event_stat;
        cmp rax, 2;
        jne ecq_w_fail_stage_d;

        mov rdi, 8;                      // EC_ROUTE_ST_LAST_CLASS
        call ec_route_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_d;

        // -- D9. Removal is the same class. Which direction it was is the
        //    byte, which the record carries: a class encoding the
        //    direction would be a claim about firmware this kernel has no
        //    way to check.
        mov rax, 68;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x40;
        mov rsi, 0x31;                   // AC removal
        call ec_route_query;
        cmp rax, 2;
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        mov rsi, 4;
        call acpi_evt_field;
        cmp rax, 1;                      // still AC
        jne ecq_w_fail_stage_d;

        mov rdi, 1;
        xor rsi, rsi;
        call ec_event_stat;
        cmp rax, 2;                      // two AC queries seen
        jne ecq_w_fail_stage_d;

        // -- D10. AN UNMAPPED BYTE STILL ROUTES, labelled NONE. The
        //    kernel not knowing what a byte means is not grounds for
        //    withholding it from a subscriber that does.
        mov rax, 69;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;
        mov rdi, 0x40;
        mov rsi, 0x55;                   // no meaning installed
        call ec_route_query;
        cmp rax, 2;
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        mov rsi, 4;
        call acpi_evt_field;
        cmp rax, 0;                      // EC_EVT_CLASS_NONE
        jne ecq_w_fail_stage_d;

        xor rdi, rdi;
        xor rsi, rsi;
        call ec_event_stat;              // NONE, SEEN
        cmp rax, 1;
        jne ecq_w_fail_stage_d;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_ok_d];
        call klog_s1;

        // ================================================================
        // STAGE E — LID, POWER BUTTON, AND THE Fn BURST (#1093)
        //
        // The events a user notices immediately when they go wrong, and
        // the priority inversion this milestone would otherwise have
        // shipped: a hot-key burst filling a tail-drop ring and evicting
        // the power button.
        //
        // ONE SUBSCRIPTION from here on, so a query is a record and the
        // depth arithmetic below is exact.
        // ================================================================

        mov rax, 80;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        call ec_query_table_reset;
        call ec_route_reset;
        call acpi_evt_stream_reset;

        mov rdi, 211;
        call acpi_evt_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        mov rdi, 207;
        mov rsi, 204;                    // endpoint id 0x41
        mov rdx, 201;
        mov rcx, 0x41A;
        call ec_query_cap_mint;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        // -- E1. The lid closes and the power button is pressed. Both
        //    arrive labelled, and neither is ever a candidate for
        //    shedding.
        mov rax, 81;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 0x40;
        mov rsi, 0x2B;                   // lid
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        xor rdi, rdi;
        mov rsi, 4;
        call acpi_evt_field;
        cmp rax, 2;                      // EC_EVT_CLASS_LID
        jne ecq_w_fail_stage_e;

        mov rdi, 0x40;
        mov rsi, 0x20;                   // power button, short press
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        xor rdi, rdi;
        mov rsi, 4;
        call acpi_evt_field;
        cmp rax, 3;                      // EC_EVT_CLASS_POWER
        jne ecq_w_fail_stage_e;

        // -- E2. THE BURST. Forty hot-key queries back to back, which is
        //    how Fn keys actually arrive — not one at a time, which is
        //    the only way a router tested with singletons is ever
        //    exercised.
        //
        //    The stream stands at depth 2. Hot-keys are admitted while
        //    depth < 24, so 22 land and the remaining 18 are SHED. What
        //    matters is not the arithmetic but the two facts under it:
        //    the shed is COUNTED, and it happens BEFORE the ring fills,
        //    so a hot-key never reaches the tail-drop path at all.
        mov rax, 82;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        xor rbx, rbx;                    // queries issued
        xor r14, r14;                    // records accepted
        xor r15, r15;                    // shed verdicts
      ecq_w_e_burst:
        cmp rbx, 40;
        jae ecq_w_e_burst_done;
        mov rdi, 0x40;
        mov rsi, 0x60;
        mov r13, rbx;
        and r13, 3;
        add rsi, r13;                    // cycle 0x60..0x63
        call ec_route_query;
        mov r11, 0xFFFFFDEC;             // EC_ROUTE_SHED
        cmp rax, r11;
        je  ecq_w_e_burst_shed;
        add r14, rax;
        jmp ecq_w_e_burst_step;
      ecq_w_e_burst_shed:
        add r15, 1;
      ecq_w_e_burst_step:
        add rbx, 1;
        jmp ecq_w_e_burst;
      ecq_w_e_burst_done:

        cmp r14, 22;                     // accepted
        jne ecq_w_fail_stage_e;
        cmp r15, 18;                     // shed
        jne ecq_w_fail_stage_e;

        call acpi_evt_depth;
        cmp rax, 24;                     // exactly the watermark
        jne ecq_w_fail_stage_e;

        mov rdi, 4;                      // EC_EVT_CLASS_HOTKEY
        mov rsi, 1;                      // EC_EVT_CT_DELIVERED
        call ec_event_stat;
        cmp rax, 22;
        jne ecq_w_fail_stage_e;

        mov rdi, 4;
        mov rsi, 3;                      // EC_EVT_CT_SHED
        call ec_event_stat;
        cmp rax, 18;
        jne ecq_w_fail_stage_e;

        // A SHED HOT-KEY IS NOT A LOST ONE. The rule fires before the
        // ring is full, so the tail-drop path is never reached: shedding
        // and dropping are different events with different fixes, and if
        // they were the same counter this assertion could not exist.
        mov rdi, 4;
        mov rsi, 2;                      // EC_EVT_CT_LOST
        call ec_event_stat;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        call acpi_evt_drops;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        // -- E3. THE ASSERTION THIS WHOLE MILESTONE EXISTS FOR. After a
        //    forty-deep hot-key burst, THE POWER BUTTON STILL WORKS.
        //
        //    Without the watermark the burst would have filled all 32
        //    slots and this offer would have been tail-dropped — a user
        //    holding a brightness key and then pressing power would get
        //    nothing, and the answer to nothing is to hold the button,
        //    which is an unclean shutdown. That is a priority inversion
        //    produced by a correctly implemented ring, and it is the one
        //    thing here that is not merely bookkeeping.
        mov rax, 83;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 0x40;
        mov rsi, 0x20;                   // power button
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        xor rdi, rdi;
        mov rsi, 4;
        call acpi_evt_field;
        cmp rax, 3;                      // EC_EVT_CLASS_POWER
        jne ecq_w_fail_stage_e;

        mov rdi, 3;                      // EC_EVT_CLASS_POWER
        mov rsi, 1;                      // EC_EVT_CT_DELIVERED
        call ec_event_stat;
        cmp rax, 2;                      // E1's press and this one
        jne ecq_w_fail_stage_e;

        call acpi_evt_depth;
        cmp rax, 25;
        jne ecq_w_fail_stage_e;

        // A lid event is not shed either, at a depth where a hot-key is.
        mov rdi, 0x40;
        mov rsi, 0x2B;
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        mov rdi, 0x40;
        mov rsi, 0x60;
        call ec_route_query;
        mov r11, 0xFFFFFDEC;             // EC_ROUTE_SHED
        cmp rax, r11;
        jne ecq_w_fail_stage_e;

        // -- E4. AND WHEN AN EVENT REALLY IS LOST, IT IS DETECTABLE AS
        //    THE POWER BUTTON. Fill the ring with lid events, which are
        //    never shed, until the offer gate refuses. The stream's own
        //    `drops` counter then says a platform event was lost; only
        //    the per-class counter says WHICH.
        mov rax, 84;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        xor rbx, rbx;
      ecq_w_e_fill:
        cmp rbx, 6;
        jae ecq_w_e_fill_done;
        mov rdi, 0x40;
        mov rsi, 0x2B;
        call ec_route_query;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;
        add rbx, 1;
        jmp ecq_w_e_fill;
      ecq_w_e_fill_done:

        call acpi_evt_depth;
        cmp rax, 32;                     // ACPI_EVT_SLOTS
        jne ecq_w_fail_stage_e;

        // The ring is full. A power-button press is now genuinely lost —
        // never shed, because its class is not sheddable, and the
        // distinction is the difference between "the kernel dropped it on
        // purpose" and "there was nowhere to put it".
        mov rdi, 0x40;
        mov rsi, 0x20;
        call ec_route_query;
        cmp rax, 0;                      // nothing routed
        jne ecq_w_fail_stage_e;

        mov rdi, 3;                      // EC_EVT_CLASS_POWER
        mov rsi, 2;                      // EC_EVT_CT_LOST
        call ec_event_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        mov rdi, 3;
        mov rsi, 3;                      // EC_EVT_CT_SHED
        call ec_event_stat;
        cmp rax, 0;                      // the power button is never shed
        jne ecq_w_fail_stage_e;

        mov rdi, 3;                      // EC_ROUTE_ST_REFUSED
        call ec_route_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        call acpi_evt_drops;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        // -- E5. The class is reachable from ring 3 through the ONE door
        //    that exists: there is no DRAIN op, so a2 is unreadable from
        //    userspace, and op 6 is how a holder learns that a byte is
        //    the power button. It reads the controller from its own row
        //    and takes no address.
        mov rax, 85;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        mov rdi, 0x400;                  // RIGHT_OBSERVE
        xor rsi, rsi;                    // row 0
        mov rdx, 0x2006;                 // OP_QUERY_CLASS, byte 0x20
        call cap_handler_ec_query;
        cmp rax, 3;                      // EC_EVT_CLASS_POWER
        jne ecq_w_fail_stage_e;

        mov rdi, 0x400;
        xor rsi, rsi;
        mov rdx, 0x5506;                 // byte 0x55, no meaning
        call cap_handler_ec_query;
        cmp rax, 0;                      // NONE, and not a refusal
        jne ecq_w_fail_stage_e;

        // OBSERVE is the right it wants, and a holder without it is
        // denied rather than told nothing.
        mov rdi, 0x008;                  // RIGHT_INVOKE only
        xor rsi, rsi;
        mov rdx, 0x2006;
        call cap_handler_ec_query;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne ecq_w_fail_stage_e;

        // -- E6. The meanings do not survive an unbind. Carrying them to
        //    a second controller is the one failure the per-controller
        //    check exists to prevent, and an unbind that kept them would
        //    reintroduce it through the back door.
        mov rax, 86;
        lea rcx, [rip + _ecq_w_stage];
        mov [rcx], rax;

        call ec_event_map_unbind;
        call ec_event_map_bound;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        mov rdi, 2;                      // EC_EVT_OWN_INSTALLED
        call ec_event_own_stat;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        mov rdi, 201;
        call ec_event_map_bind;
        cmp rax, 0;
        jne ecq_w_fail_stage_e;

        mov rdi, 0x40;
        mov rsi, 0x20;
        call ec_event_class_of;
        cmp rax, 0;                      // the power button is unknown again
        jne ecq_w_fail_stage_e;

        // But the COUNTERS survive, for the reason acpi_evt_unbind keeps
        // its own: discarding the evidence at teardown erases it just as
        // somebody starts looking for it.
        mov rdi, 3;                      // EC_EVT_CLASS_POWER
        mov rsi, 2;                      // EC_EVT_CT_LOST
        call ec_event_stat;
        cmp rax, 1;
        jne ecq_w_fail_stage_e;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_ok_e];
        call klog_s1;

        call ecq_w_scrub;
        call ecq_w_clear;
        xor rax, rax;
        jmp ecq_w_out;

      ecq_w_fail_stage_a:
        lea rax, [rip + _ecq_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp ecq_w_failed;

      ecq_w_fail_stage_b:
        lea rax, [rip + _ecq_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp ecq_w_failed;

      ecq_w_fail_stage_c:
        lea rax, [rip + _ecq_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_fail_c];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp ecq_w_failed;

      ecq_w_fail_stage_d:
        lea rax, [rip + _ecq_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_fail_d];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp ecq_w_failed;

      ecq_w_fail_stage_e:
        lea rax, [rip + _ecq_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ecq_w_fail_e];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      ecq_w_failed:
        call ecq_w_scrub;
        call ecq_w_clear;
        mov rax, 1;

      ecq_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
