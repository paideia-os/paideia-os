// tests/kernel/cap/mbim_session_synth.pdx -- R40.M4-004 (#1362)
//
// Boot witness for KIND_MBIM_SESSION.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, modem_slot gate,
// state / signal / session_id refusals, rights subset refuse, NO_KEY,
// BAD_EID (endpoint 0), uniqueness on session_key, mint/revoke
// round-trip.
//
// Fingerprint: R40 KIND_MBIM_SESSION OK
//
// Cap slots 48..55.

module MbimSessionSynth = structure {

  pub let mut _mbsw_stage : u64 = 0

  pub let mbsw_ok   : [u8; 26] = "R40 KIND_MBIM_SESSION OK\n\0"
  pub let mbsw_fail : [u8; 28] = "R40 KIND_MBIM_SESSION FAIL\n\0"

  pub let mbsw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): clear cap_table slots 48..55.",
      block: {
        push rbx;
        mov rbx, 48;
      mbswc_loop:
        cmp rbx, 56;
        jae mbswc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp mbswc_loop;
      mbswc_done:
        pop rbx;
        ret
      }
    }

  pub let mbsw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): reset MBIM SESSION row table.",
      block: {
        call mbim_session_table_reset;
        ret
      }
    }

  pub let mbsw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let mbsw_seed_modem : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): synthetic KIND_WWAN_MODEM at slot.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x180;                  // KIND_WWAN_MODEM
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let mbim_session_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R40.M4-004 (#1362): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_EID. (4) BAD_MODEM. (5) BAD_SESSION. (6) BAD_STATE. (7) BAD_SIGNAL. (8) BAD_RIGHTS. (9) NO_KEY. (10) Happy path. (11) Query fields. (12) IN_USE. (13) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        call mbsw_clear;
        call mbsw_scrub;

        // -- 1. Validators.
        mov rdi, 0x419;
        call mbs_rights_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 0x200;
        call mbs_rights_valid;
        cmp rax, 0;
        jne mbsw_fail_stage;

        mov rdi, 0;                      // IDLE
        call mbs_state_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 3;                      // DISCONNECTING
        call mbs_state_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 4;
        call mbs_state_valid;
        cmp rax, 0;
        jne mbsw_fail_stage;

        mov rdi, 0xFFFF;
        call mbs_signal_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 0x10000;
        call mbs_signal_valid;
        cmp rax, 0;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_session_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 255;
        call mbs_session_valid;
        cmp rax, 1;
        jne mbsw_fail_stage;
        mov rdi, 256;
        call mbs_session_valid;
        cmp rax, 0;
        jne mbsw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 49 with R_MINT + endpoint_id 0x0055.
        // KIND_WWAN_MODEM at 50.
        // KIND_IPC_ENDPOINT at 52 with R_MINT + endpoint_id 0 (fabricated).
        mov rdi, 49;
        mov rsi, 0x200;
        mov rdx, 0x0055;
        call mbsw_seed_endpoint;

        mov rdi, 50;
        mov rsi, 0x0BEEF;
        call mbsw_seed_modem;

        mov rdi, 52;
        mov rsi, 0x200;
        mov rdx, 0x0000;                 // endpoint_id = 0
        call mbsw_seed_endpoint;

        // packed_state: session_id=1, state=CONNECTED=2, signal=0xFFCE (-50 dBm).
        // [7:0]=1, [15:8]=2, [31:16]=0xFFCE.
        mov r15, 0xFFCE;
        shl r15, 16;
        or  r15, 0x0201;

        // -- 2. BAD_PARENT (empty parent).
        mov rax, 2;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 48;                     // empty parent
        mov rdx, 0x419;
        mov rcx, 0xBEAD01;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1BD;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 3. BAD_EID (parent endpoint 0).
        mov rax, 3;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 52;                     // parent with endpoint_id 0
        mov rdx, 0x419;
        mov rcx, 0xBEAD02;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1B7;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 4. BAD_MODEM (modem_slot empty).
        mov rax, 4;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD03;
        mov r8, 53;                      // empty modem slot
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1BB;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 5. BAD_SESSION (session_id > 255).
        mov rax, 5;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD04;
        mov r8, 50;
        // packed_state with session_id in bits [7:0] cannot exceed 0xFF
        // by construction of the field. Instead exercise via state=4
        // to hit BAD_STATE path in stage 6. For BAD_SESSION we rely
        // on the validator boundary (256) reached only by the
        // validator directly (asserted in stage 1). Skip inline mint
        // here -- the [7:0] field masks widening at pack time.
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        // Expect OK here (this is really validation-shape stage; skip
        // to next real refusal test). We'll revoke it.
        cmp rax, 0;
        jne mbsw_fail_stage;
        mov rdi, 51;
        call mbim_session_cap_revoke_inner;
        cmp rax, 0;
        jne mbsw_fail_stage;

        // -- 6. BAD_STATE (state=4).
        mov rax, 6;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD05;
        mov r8, 50;
        // packed_state: session_id=1, state=4 (invalid), signal=0.
        mov r9, 0x401;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1B9;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 7. BAD_SIGNAL is unreachable through packed_state[31:16]
        // (already u16). Exercise the validator directly instead --
        // asserted in stage 1.

        // -- 8. BAD_RIGHTS.
        mov rax, 8;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x800;                  // outside R_MBS_ALL
        mov rcx, 0xBEAD07;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1BC;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 9. NO_KEY.
        mov rax, 9;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1B6;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 10. Happy path.
        mov rax, 10;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD09;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        cmp rax, 0;
        jne mbsw_fail_stage;

        // -- 11. Query fields.
        mov rax, 11;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call mbs_row_key;
        mov r11, 0xBEAD09;
        cmp rax, r11;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_row_endpoint;
        cmp rax, 0x0055;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_row_modem;
        cmp rax, 50;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_row_session;
        cmp rax, 1;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_row_state;
        cmp rax, 2;
        jne mbsw_fail_stage;

        mov rdi, 0;
        call mbs_row_signal;
        mov r11, 0xFFCE;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 12. IN_USE (duplicate session_key).
        mov rax, 12;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 54;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD09;
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        mov r11, 0xFFFFF1B5;
        cmp rax, r11;
        jne mbsw_fail_stage;

        // -- 13. Revoke round-trip.
        mov rax, 13;
        lea rcx, [rip + _mbsw_stage];
        mov [rcx], rax;

        mov rdi, 51;
        call mbim_session_cap_revoke_inner;
        cmp rax, 0;
        jne mbsw_fail_stage;

        mov rdi, 51;
        mov rsi, 49;
        mov rdx, 0x419;
        mov rcx, 0xBEAD09;               // key free after revoke
        mov r8, 50;
        mov r9, r15;
        call mbim_session_cap_mint_inner;
        cmp rax, 0;
        jne mbsw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mbsw_ok];
        call klog_s1;

        call mbsw_scrub;
        call mbsw_clear;
        xor rax, rax;
        jmp mbsw_out;

      mbsw_fail_stage:
        lea rax, [rip + _mbsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + mbsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call mbsw_scrub;
        call mbsw_clear;
        mov rax, 1;

      mbsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
