// tests/kernel/cap/kind_pdxfs_file_synth.pdx -- R48b substrate-prep (#1623)
//
// Boot witness for KIND_PDXFS_FILE.  Exercises:
//   * rights_valid subset test in both directions
//   * len_valid at 0 / ceiling / ceiling+1
//   * parent gate refuses NO-MINT and BAD-KIND parents
//   * mint success via the walker + round-trip of every accessor
//   * BAD_INODE refusal (inode_no == 0)
//   * BAD_LEN refusal (byte_len > 1 TiB)
//   * cap_revoke: happy path + BAD_SLOT + REVOKE_ALREADY
//
// Fingerprint: R48b KIND_PDXFS_FILE OK
//
// Cap slots 108..110.  108 = KIND_MEMORY parent WITH RIGHT_MINT.  109 =
// KIND_MEMORY parent WITHOUT RIGHT_MINT.  110 = spare / bad-kind
// parent (kind == 0).

module KindPdxfsFileSynth = structure {

  pub let mut _pffw_stage : u64 = 0

  pub let pffw_ok   : [u8; 20] = "KIND_PDXFS_FILE OK\n\0"
  pub let pffw_fail : [u8; 22] = "KIND_PDXFS_FILE FAIL\n\0"

  pub let pffw_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): mint a synthetic KIND_MEMORY parent cap via cap_mint_write. The gate under test reads exactly kind (= 4) and rights (bit 0x200 for RIGHT_MINT); a real page cap is not needed because it is those two fields the gate consults. Labels prefixed pffw_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key (arbitrary)
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pffw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): clear cap_table slots 108..110. Labels prefixed pffw_c_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 108;
      pffw_c_loop:
        cmp rbx, 111;
        jae pffw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pffw_c_loop;
      pffw_c_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_pdxfs_file_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R48b substrate-prep (#1623): boot witness. Five callee-save pushes leave rsp%16 == 0 at every nested call. Labels prefixed pffw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) Reset.
        mov rax, 1;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        call pffw_clear;
        call pdxfs_file_table_reset;

        // Set up parents.
        mov rdi, 108;
        mov rsi, 0xF11E;
        mov rdx, 0x200;                  // RIGHT_MINT
        call pffw_mem;
        mov rdi, 109;
        mov rsi, 0xF11F;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call pffw_mem;
        mov rdi, 110;                    // kind = 0 (spare)
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // (2) rights_valid.
        mov rax, 2;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 0x61B;
        call pdxfs_file_rights_valid;
        cmp rax, 1;
        jne pffw_fail_stage;
        mov rdi, 0x2000;
        call pdxfs_file_rights_valid;
        cmp rax, 0;
        jne pffw_fail_stage;

        // (3) len_valid.
        mov rax, 3;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call pdxfs_file_len_valid;
        cmp rax, 1;
        jne pffw_fail_stage;
        mov r11, 0x10000000000;
        mov rdi, r11;
        call pdxfs_file_len_valid;
        cmp rax, 1;
        jne pffw_fail_stage;
        mov r11, 0x10000000001;
        mov rdi, r11;
        call pdxfs_file_len_valid;
        cmp rax, 0;
        jne pffw_fail_stage;

        // (4) parent gate.
        mov rax, 4;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 108;
        call pdxfs_file_check_parent_memory;
        cmp rax, 1;
        jne pffw_fail_stage;
        mov rdi, 109;
        call pdxfs_file_check_parent_memory;
        cmp rax, 0;
        jne pffw_fail_stage;
        mov rdi, 110;
        call pdxfs_file_check_parent_memory;
        cmp rax, 0;
        jne pffw_fail_stage;

        // (5) Mint success.  inode=0xABCD, len=0x100000, birth=0x1111,
        //     mtime=0x2222.
        mov rax, 5;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 108;
        mov rsi, 0x61B;
        mov rdx, 0xABCD;
        mov rcx, 0x100000;
        mov r8,  0x1111;
        mov r9,  0x2222;
        call pdxfs_file_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae pffw_fail_stage;
        mov r12, rax;                    // row_id

        // Accessor round-trips.
        mov rdi, r12;
        call pdxfs_file_row_inode;
        mov r11, 0xABCD;
        cmp rax, r11;
        jne pffw_fail_stage;

        mov rdi, r12;
        call pdxfs_file_row_len;
        mov r11, 0x100000;
        cmp rax, r11;
        jne pffw_fail_stage;

        mov rdi, r12;
        call pdxfs_file_row_mode;
        mov r11, 0x1A4;
        cmp rax, r11;
        jne pffw_fail_stage;

        mov rdi, r12;
        call pdxfs_file_row_birth;
        mov r11, 0x1111;
        cmp rax, r11;
        jne pffw_fail_stage;

        mov rdi, r12;
        call pdxfs_file_row_mtime;
        mov r11, 0x2222;
        cmp rax, r11;
        jne pffw_fail_stage;

        mov rdi, r12;
        call pdxfs_file_row_refs;
        cmp rax, 1;
        jne pffw_fail_stage;

        // (6) BAD_INODE (inode_no == 0).
        mov rax, 6;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 108;
        mov rsi, 0x61B;
        xor rdx, rdx;                    // inode_no = 0
        mov rcx, 0x100;
        mov r8,  0x3333;
        mov r9,  0x4444;
        call pdxfs_file_cap_mint_inner;
        mov r10, 0xFFFFEC2B;             // PFF_MINT_BAD_INODE
        cmp rax, r10;
        jne pffw_fail_stage;

        // (7) BAD_LEN.
        mov rax, 7;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 108;
        mov rsi, 0x61B;
        mov rdx, 0xBEEF;
        mov r11, 0x10000000001;          // > 1 TiB
        mov rcx, r11;
        mov r8,  0x5555;
        mov r9,  0x6666;
        call pdxfs_file_cap_mint_inner;
        mov r10, 0xFFFFEC2A;             // PFF_MINT_BAD_LEN
        cmp rax, r10;
        jne pffw_fail_stage;

        // (8) revoke happy path.
        mov rax, 8;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_file_cap_revoke;
        cmp rax, 0;
        jne pffw_fail_stage;
        mov rdi, r12;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        jne pffw_fail_stage;

        // (9) revoke already dead.
        mov rax, 9;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call pdxfs_file_cap_revoke;
        mov r10, 0xFFFFEC26;             // PFF_REVOKE_ALREADY
        cmp rax, r10;
        jne pffw_fail_stage;

        // (10) revoke out-of-range.
        mov rax, 10;
        lea rcx, [rip + _pffw_stage];
        mov [rcx], rax;
        mov rdi, 99;
        call pdxfs_file_cap_revoke;
        mov r10, 0xFFFFEC28;             // PFF_BAD_SLOT
        cmp rax, r10;
        jne pffw_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pffw_ok];
        call klog_s1;

        call pffw_clear;
        call pdxfs_file_table_reset;
        xor rax, rax;
        jmp pffw_out;

      pffw_fail_stage:
        lea rax, [rip + _pffw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pffw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pffw_clear;
        call pdxfs_file_table_reset;
        mov rax, 1;

      pffw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
