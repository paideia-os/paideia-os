// tests/kernel/cap/usb_urb_synth.pdx — R34.M3-004 (#1179)
//
// Boot witness for KIND_USB_URB.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, direction/len/
// timeout refusals, uniqueness on urb_key, mint/revoke round-trip.
//
// Fingerprint: R34 KIND_USB_URB OK
//
// Cap slots 244..251 -- reused historically (see msc_lun_synth).
// Runs after scsi_device_witness which scrubs slots + tables.

module UsbUrbSynth = structure {

  pub let mut _urb_w_stage : u64 = 0

  pub let urb_w_ok   : [u8; 22] = "R34 KIND_USB_URB OK\n\0\0"
  pub let urb_w_fail : [u8; 24] = "R34 KIND_USB_URB FAIL\n\0\0"

  pub let urb_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): clear cap_table slots 244..251. Labels prefixed urbw_wc_.",
      block: {
        push rbx;
        mov rbx, 244;
      urbw_wc_loop:
        cmp rbx, 252;
        jae urbw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp urbw_wc_loop;
      urbw_wc_done:
        pop rbx;
        ret
      }
    }

  pub let urb_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): reset URB row table.",
      block: {
        push rbx;
        call usb_urb_table_reset;
        pop rbx;
        ret
      }
    }

  pub let urb_w_endpoint_ipc : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (endpoint_id: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r14;
        mov rcx, r13;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usb_urb_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M3-004 (#1179): boot witness. Stages: (1) validators. (2) BAD_PARENT (not IPC_ENDPOINT). (3) Happy path. (4) Query fields. (5) IN_USE. (6) BAD_DIR (2). (7) body_pack BAD_LEN (65536 — mint's BAD_LEN is unreachable via packed_body). (8) body_pack BAD_TIMEOUT (60001 — same rationale). (9) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        call urb_w_clear;
        call urb_w_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call usb_urb_dir_valid;
        cmp rax, 1;
        jne urb_w_fail_stage;
        mov rdi, 1;
        call usb_urb_dir_valid;
        cmp rax, 1;
        jne urb_w_fail_stage;
        mov rdi, 2;
        call usb_urb_dir_valid;
        cmp rax, 0;
        jne urb_w_fail_stage;

        mov rdi, 0;
        call usb_urb_len_valid;
        cmp rax, 1;
        jne urb_w_fail_stage;
        mov rdi, 65535;
        call usb_urb_len_valid;
        cmp rax, 1;
        jne urb_w_fail_stage;
        mov rdi, 65536;
        call usb_urb_len_valid;
        cmp rax, 0;
        jne urb_w_fail_stage;

        mov rdi, 60000;
        call usb_urb_timeout_valid;
        cmp rax, 1;
        jne urb_w_fail_stage;
        mov rdi, 60001;
        call usb_urb_timeout_valid;
        cmp rax, 0;
        jne urb_w_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at slot 245 (endpoint_id=10, RIGHT_MINT).
        mov rdi, 245;
        mov rsi, 10;
        mov rdx, 0x200;
        call urb_w_endpoint_ipc;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        // Non-endpoint parent: slot 244 is empty (kind==0), fails check_parent.
        // packed_body: dir=1, len=512, timeout=1000
        mov r10, 1;                      // dir
        mov r11, 512;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1000;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 246;
        mov rsi, 244;                    // empty slot -> BAD_PARENT
        mov rdx, 0x419;
        mov rcx, 0xABAD1DEA;
        mov r8, r10;
        mov r9, 0;
        call usb_urb_cap_mint_inner;
        mov r11, 0xFFFFFB6D;             // BAD_PARENT
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 3. Happy path.
        mov rax, 3;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov r10, 1;
        mov r11, 512;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1000;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 246;
        mov rsi, 245;                    // IPC_ENDPOINT
        mov rdx, 0x419;
        mov rcx, 0xC0DECAFE;
        mov r8, r10;
        mov r9, 0;
        call usb_urb_cap_mint_inner;
        cmp rax, 0;
        jne urb_w_fail_stage;

        // -- 4. Query fields.
        mov rax, 4;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov rdi, 246;
        call usb_urb_dir_of_slot;
        cmp rax, 1;
        jne urb_w_fail_stage;

        mov rdi, 246;
        call usb_urb_len_of_slot;
        cmp rax, 512;
        jne urb_w_fail_stage;

        mov rdi, 246;
        call usb_urb_timeout_of_slot;
        cmp rax, 1000;
        jne urb_w_fail_stage;

        mov rdi, 246;
        call usb_urb_key_of_slot;
        mov r11, 0xC0DECAFE;
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 5. IN_USE.
        mov rax, 5;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov r10, 0;
        mov r11, 256;
        shl r11, 8;
        or  r10, r11;
        mov r11, 500;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 247;
        mov rsi, 245;
        mov rdx, 0x419;
        mov rcx, 0xC0DECAFE;             // duplicate
        mov r8, r10;
        mov r9, 0;
        call usb_urb_cap_mint_inner;
        mov r11, 0xFFFFFB66;             // IN_USE
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 6. BAD_DIR (2).
        mov rax, 6;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov r10, 2;                      // dir = 2 (bad)
        mov r11, 256;
        shl r11, 8;
        or  r10, r11;

        mov rdi, 247;
        mov rsi, 245;
        mov rdx, 0x419;
        mov rcx, 0x11223344;
        mov r8, r10;
        mov r9, 0;
        call usb_urb_cap_mint_inner;
        mov r11, 0xFFFFFB6B;             // BAD_DIR
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 7. BAD_LEN via body_pack (len=65536).
        //
        // NOTE. The mint's BAD_LEN / BAD_TIMEOUT error codes are unreachable
        // via a packed_body argument: the len field is 16 bits [23:8] and
        // the timeout field is 16 bits [39:24], so any u64 packed_body has
        // already been narrowed to the valid domain by construction. We
        // test the refusal at the body_pack layer instead — that primitive
        // takes raw (dir, len, timeout) and returns URB_DECODE_BAD when
        // any argument is out of range, which is the earliest reachable
        // point at which an over-range value can be caught.
        mov rax, 7;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // dir
        mov rsi, 65536;                  // len = 65536 (bad)
        mov rdx, 0;                      // timeout
        call usb_urb_body_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;     // URB_DECODE_BAD
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 8. BAD_TIMEOUT via body_pack (timeout=60001). Same rationale.
        mov rax, 8;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // dir
        mov rsi, 256;                    // len
        mov rdx, 60001;                  // timeout = 60001 (bad)
        call usb_urb_body_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;     // URB_DECODE_BAD
        cmp rax, r11;
        jne urb_w_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _urb_w_stage];
        mov [rcx], rax;

        mov rdi, 246;
        call usb_urb_cap_revoke_inner;
        cmp rax, 0;
        jne urb_w_fail_stage;

        mov r10, 1;
        mov r11, 512;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1000;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 246;
        mov rsi, 245;
        mov rdx, 0x419;
        mov rcx, 0xC0DECAFE;
        mov r8, r10;
        mov r9, 0;
        call usb_urb_cap_mint_inner;
        cmp rax, 0;
        jne urb_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + urb_w_ok];
        call klog_s1;

        call urb_w_scrub;
        call urb_w_clear;
        xor rax, rax;
        jmp urb_w_out;

      urb_w_fail_stage:
        lea rax, [rip + _urb_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + urb_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call urb_w_scrub;
        call urb_w_clear;
        mov rax, 1;

      urb_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
