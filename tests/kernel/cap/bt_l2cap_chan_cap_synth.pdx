// tests/kernel/cap/bt_l2cap_chan_cap_synth.pdx — R39.M2-003 (#1329)
//
// Boot witness for KIND_BT_L2CAP_CHANNEL.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, cid / mtu validators,
// HCI channel presence gate, rights subset refuse, uniqueness on
// chan_key, mint / revoke round-trip, credit mutators.
//
// Fingerprint: R39 KIND_BT_L2CAP_CHANNEL OK
//
// Cap slots 144..159.

module BtL2capChanCapSynth = structure {

  pub let mut _kbl2cw_stage : u64 = 0

  pub let kbl2cw_ok   : [u8; 30] = "R39 KIND_BT_L2CAP_CHANNEL OK\n\0"
  pub let kbl2cw_fail : [u8; 32] = "R39 KIND_BT_L2CAP_CHANNEL FAIL\n\0"

  pub let kbl2cw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): clear cap_table slots 144..159.",
      block: {
        push rbx;
        mov rbx, 144;
      kbl2cwc_loop:
        cmp rbx, 160;
        jae kbl2cwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kbl2cwc_loop;
      kbl2cwc_done:
        pop rbx;
        ret
      }
    }

  pub let kbl2cw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): reset BT L2CAP CHAN row table + BT HCI CHAN row table + BT ADAPTER row table.",
      block: {
        call bt_l2cap_chan_table_reset;
        call bt_hci_chan_table_reset;
        call bt_adapter_table_reset;
        ret
      }
    }

  pub let kbl2cw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kbl2cw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bt_l2cap_chan_cap_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R39.M2-003 (#1329): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_HCI (empty). (4) BAD_CID (0). (5) BAD_MTU (<23). (6) BAD_RIGHTS. (7) Happy path. (8) Query fields. (9) Credit add/consume. (10) Credit underflow. (11) IN_USE. (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        call kbl2cw_clear;
        call kbl2cw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kbl2c_cid_valid;
        cmp rax, 0;
        jne kbl2cw_fail_stage;
        mov rdi, 0x40;
        call kbl2c_cid_valid;
        cmp rax, 1;
        jne kbl2cw_fail_stage;
        mov rdi, 0xFFFF;
        call kbl2c_cid_valid;
        cmp rax, 1;
        jne kbl2cw_fail_stage;
        mov rdi, 0x10000;
        call kbl2c_cid_valid;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // mtu valid
        mov rdi, 22;
        call kbl2c_mtu_valid;
        cmp rax, 0;
        jne kbl2cw_fail_stage;
        mov rdi, 23;
        call kbl2c_mtu_valid;
        cmp rax, 1;
        jne kbl2cw_fail_stage;
        mov rdi, 0xFFFF;
        call kbl2c_mtu_valid;
        cmp rax, 1;
        jne kbl2cw_fail_stage;

        // rights_valid: R_MINT outside mask
        mov rdi, 0x200;
        call kbl2c_rights_valid;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at slot 145, KIND_DEVICE at slot 146,
        // KIND_BT_ADAPTER at slot 147, KIND_BT_HCI_CHANNEL at slot 148.
        mov rdi, 145;
        mov rsi, 0x200;
        mov rdx, 0x0200;
        call kbl2cw_seed_endpoint;

        mov rdi, 146;
        mov rsi, 0x200;
        mov rdx, 0x0043;
        call kbl2cw_seed_device;

        mov rdi, 147;
        mov rsi, 146;
        mov rdx, 0x419;
        mov rcx, 0xAD5CAFF;
        mov r8, 0x000D000180860092;      // device_slot=146 vendor=0x8086 iface=1 hci_ver=13
        call bt_adapter_cap_mint_inner;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // Mint HCI channel at slot 148 over endpoint 145 + adapter 147.
        mov rdi, 148;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFFE01;
        mov r8, 147;
        mov r9, 0x0100;                  // dir=0 (H2C), pkt=1 (CMD)
        call bt_hci_chan_cap_mint_inner;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // packed_body = cid[15:0] | psm[31:16] | mtu[47:32] | credits[63:48]
        //   cid=0x0040 dyn base, psm=0x001F, mtu=100=0x0064, credits=4.
        //   0x00040064001F0040 = credits<<48 | mtu<<32 | psm<<16 | cid
        mov r15, 0x00040064001F0040;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 144;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE01;
        mov r8, 148;                     // hci_chan_slot
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF10D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 3. BAD_HCI (empty hci_chan_slot).
        mov rax, 3;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE02;
        mov r8, 144;                     // empty hci
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF10B;             // MINT_BAD_HCI
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 4. BAD_CID (cid=0).
        mov rax, 4;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE03;
        mov r8, 148;
        // cid=0, psm=0x001F, mtu=100, credits=4
        mov r9, 0x00040064001F0000;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF10A;             // MINT_BAD_CID
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 5. BAD_MTU (mtu=22 < 23).
        mov rax, 5;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE04;
        mov r8, 148;
        // cid=0x40, psm=0x1F, mtu=22=0x16, credits=4
        mov r9, 0x00040016001F0040;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF109;             // MINT_BAD_MTU
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 6. BAD_RIGHTS.
        mov rax, 6;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x81B;                  // 0x800 outside 0x41B
        mov rcx, 0xC0FFEE05;
        mov r8, 148;
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF10C;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 7. Happy path.
        mov rax, 7;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE06;
        mov r8, 148;
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // -- 8. Query fields.
        mov rax, 8;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kbl2c_row_key;
        mov r11, 0xC0FFEE06;
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_endpoint;
        cmp rax, 145;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_hci_chan;
        cmp rax, 148;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_cid;
        cmp rax, 0x40;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_psm;
        cmp rax, 0x1F;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_mtu;
        cmp rax, 100;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_credits;
        cmp rax, 4;
        jne kbl2cw_fail_stage;

        // -- 9. Credit add / consume.
        mov rax, 9;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 2;
        call kbl2c_row_credit_add;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_credits;
        cmp rax, 6;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        mov rsi, 3;
        call kbl2c_row_credit_consume;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        mov rdi, 0;
        call kbl2c_row_credits;
        cmp rax, 3;
        jne kbl2cw_fail_stage;

        // -- 10. Credit underflow.
        mov rax, 10;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 100;
        call kbl2c_row_credit_consume;
        mov r11, 0xFFFFF100;             // CREDIT_UNDERFLOW
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 11. IN_USE (duplicate chan_key).
        mov rax, 11;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 150;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE06;             // same key
        mov r8, 148;
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        mov r11, 0xFFFFF106;             // MINT_IN_USE
        cmp rax, r11;
        jne kbl2cw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _kbl2cw_stage];
        mov [rcx], rax;

        mov rdi, 149;
        call bt_l2cap_chan_cap_revoke_inner;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        mov rdi, 149;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE06;             // key free after revoke
        mov r8, 148;
        mov r9, r15;
        call bt_l2cap_chan_cap_mint_inner;
        cmp rax, 0;
        jne kbl2cw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbl2cw_ok];
        call klog_s1;

        call kbl2cw_scrub;
        call kbl2cw_clear;
        xor rax, rax;
        jmp kbl2cw_out;

      kbl2cw_fail_stage:
        lea rax, [rip + _kbl2cw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbl2cw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kbl2cw_scrub;
        call kbl2cw_clear;
        mov rax, 1;

      kbl2cw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
