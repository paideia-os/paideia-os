// tests/kernel/cap/usb_device_synth.pdx — R34.M1-003 (#1169)
//
// Boot witness for KIND_USB_DEVICE.
//
// Asserts derivation gate, address / speed refusals, uniqueness,
// mint / revoke round-trip.
//
// Fingerprint: R34 KIND_USB_DEVICE OK
// Cap slots 176..183.

module UsbDeviceSynth = structure {

  pub let mut _usbd_w_stage : u64 = 0

  pub let usbd_w_ok   : [u8; 25] = "R34 KIND_USB_DEVICE OK\n\0\0"
  pub let usbd_w_fail : [u8; 27] = "R34 KIND_USB_DEVICE FAIL\n\0\0"

  pub let usbd_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): clear cap_table slots 176..183 through cap_mint_write. Labels prefixed usbds_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 176;
      usbds_wc_loop:
        cmp rbx, 184;
        jae usbds_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp usbds_wc_loop;
      usbds_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usbd_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): reset USB device rows and counters. Labels: none.",
      block: {
        push rbx;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let usbd_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): synthetic KIND_DEVICE with target_ptr=key. Labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usb_device_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M1-003 (#1169): boot witness. Sequence: (1) address_valid at 0/1/127/128. (2) speed_valid at 0/1/4/5. (3) BAD_PARENT if parent isn't KIND_DEVICE. (4) NO_DEVICE if parent key is 0. (5) happy-path mint at slot 176. (6) IN_USE on duplicate key. (7) revoke round-trip. Five-push prologue leaves rsp%16 == 0 at every nested call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        call usbd_w_clear;
        call usbd_w_scrub;

        // -- 1. address_valid.
        xor rdi, rdi;
        call usb_device_address_valid;
        cmp rax, 0;
        jne usbd_w_fail_stage;
        mov rdi, 1;
        call usb_device_address_valid;
        cmp rax, 1;
        jne usbd_w_fail_stage;
        mov rdi, 127;
        call usb_device_address_valid;
        cmp rax, 1;
        jne usbd_w_fail_stage;
        mov rdi, 128;
        call usb_device_address_valid;
        cmp rax, 0;
        jne usbd_w_fail_stage;

        // -- 2. speed_valid.
        mov rax, 2;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call usb_device_speed_valid;
        cmp rax, 0;
        jne usbd_w_fail_stage;
        mov rdi, 1;
        call usb_device_speed_valid;
        cmp rax, 1;
        jne usbd_w_fail_stage;
        mov rdi, 4;
        call usb_device_speed_valid;
        cmp rax, 1;
        jne usbd_w_fail_stage;
        mov rdi, 5;
        call usb_device_speed_valid;
        cmp rax, 0;
        jne usbd_w_fail_stage;

        // -- 3. Mint with no parent -> BAD_PARENT.
        mov rax, 3;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        mov rdi, 176;                    // subject slot
        mov rsi, 177;                    // parent (empty)
        mov rdx, 0x619;                  // rights
        mov rcx, 42;                     // address
        mov r8, 3;                       // HIGH
        call usb_device_cap_mint_inner;
        mov r11, 0xFFFFFDED;
        cmp rax, r11;
        jne usbd_w_fail_stage;

        // -- 4. Mint with parent that has zero key -> NO_DEVICE.
        //     (parent kind is KIND_DEVICE (10) with target_ptr = 0.)
        mov rax, 4;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        mov rdi, 177;
        xor rsi, rsi;                    // key = 0
        mov rdx, 0x200;                  // RIGHT_MINT
        call usbd_w_device;

        mov rdi, 176;
        mov rsi, 177;
        mov rdx, 0x619;
        mov rcx, 42;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        mov r11, 0xFFFFFDE9;             // NO_DEVICE
        cmp rax, r11;
        jne usbd_w_fail_stage;

        // -- 5. Happy path.
        mov rax, 5;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        mov rdi, 177;
        mov rsi, 0xABCD1234;             // real key
        mov rdx, 0x200;
        call usbd_w_device;

        mov rdi, 176;
        mov rsi, 177;
        mov rdx, 0x619;
        mov rcx, 42;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbd_w_fail_stage;

        // Query fields.
        mov rdi, 176;
        call usb_device_address_of_slot;
        cmp rax, 42;
        jne usbd_w_fail_stage;

        mov rdi, 176;
        call usb_device_speed_of_slot;
        cmp rax, 3;
        jne usbd_w_fail_stage;

        mov rdi, 176;
        call usb_device_key_of_slot;
        mov r11, 0xABCD1234;
        cmp rax, r11;
        jne usbd_w_fail_stage;

        // -- 6. Duplicate key -> IN_USE.
        mov rax, 6;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        mov rdi, 178;
        mov rsi, 0xABCD1234;             // same key
        mov rdx, 0x200;
        call usbd_w_device;

        mov rdi, 179;
        mov rsi, 178;
        mov rdx, 0x619;
        mov rcx, 43;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        mov r11, 0xFFFFFDE7;             // IN_USE
        cmp rax, r11;
        jne usbd_w_fail_stage;

        // -- 7. Revoke round-trip.
        mov rax, 7;
        lea rcx, [rip + _usbd_w_stage];
        mov [rcx], rax;

        mov rdi, 176;
        call usb_device_cap_revoke_inner;
        cmp rax, 0;
        jne usbd_w_fail_stage;

        // Re-mint after revoke succeeds.
        mov rdi, 176;
        mov rsi, 177;
        mov rdx, 0x619;
        mov rcx, 42;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbd_w_fail_stage;

        // Bad slot on address_valid via body_pack:
        // address 0 refused by body_pack.
        xor rdi, rdi;
        mov rsi, 3;
        call usb_device_body_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne usbd_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbd_w_ok];
        call klog_s1;

        call usbd_w_scrub;
        call usbd_w_clear;
        xor rax, rax;
        jmp usbd_w_out;

      usbd_w_fail_stage:
        lea rax, [rip + _usbd_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbd_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call usbd_w_scrub;
        call usbd_w_clear;
        mov rax, 1;

      usbd_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
