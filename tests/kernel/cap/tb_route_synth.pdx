// tests/kernel/cap/tb_route_synth.pdx — R35.M3-004 (#1208)
//
// Boot witness for KIND_TB_ROUTE.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, route / tunnel /
// adapter / state refusals, self-loop refusal, uniqueness on
// route_key, endpoint_slot second-cap gate, mint / revoke round-trip.
//
// Fingerprint: R35 KIND_TB_ROUTE OK
//
// Cap slots 216..231 — a fresh range, disjoint from every other
// witness's set (0..8, 10..12, 14..19, 28..33, 46..63, 64..95,
// 96..99, 100..103, 110..117, 160..199, 200..207 taken by
// pcie_hotplug_event_synth, 208..215 taken by tb_domain_synth,
// 212..255). Every exit path scrubs the range so nothing bleeds
// into later witnesses.

module TbRouteSynth = structure {

  pub let mut _tbrw_stage : u64 = 0

  pub let tbrw_ok   : [u8; 16] = "KIND_TB_ROUTE OK\0"
  pub let tbrw_fail : [u8; 18] = "KIND_TB_ROUTE FAIL\0"

  pub let tbrw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): clear cap_table slots 216..231.",
      block: {
        push rbx;
        mov rbx, 216;
      tbrwc_loop:
        cmp rbx, 232;
        jae tbrwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp tbrwc_loop;
      tbrwc_done:
        pop rbx;
        ret
      }
    }

  pub let tbrw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): reset TB ROUTE row table.",
      block: {
        push rbx;
        call tb_route_table_reset;
        pop rbx;
        ret
      }
    }

  // Synthesize a KIND_IPC_ENDPOINT cap at `slot` carrying `rights`
  // with target_ptr encoding endpoint_id in bits [15:0].
  pub let tbrw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): synthetic KIND_IPC_ENDPOINT for gate testing.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let tb_route_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R35.M3-004 (#1208): boot witness. Stages: (1) validators. (2) BAD_PARENT on non-endpoint parent. (3) BAD_ENDPOINT on non-endpoint endpoint_slot. (4) Happy path. (5) Query fields. (6) IN_USE on duplicate key. (7) BAD_TUNNEL. (8) SELF_LOOP (BAD_ADAPTER). (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        call tbrw_clear;
        call tbrw_scrub;

        // -- 1. Validators.
        mov rdi, 0xFFFFFF;
        call tb_route_route_valid;
        cmp rax, 1;
        jne tbrw_fail_stage;
        mov rdi, 0x1000000;
        call tb_route_route_valid;
        cmp rax, 0;
        jne tbrw_fail_stage;

        mov rdi, 2;
        call tb_route_tunnel_valid;
        cmp rax, 1;
        jne tbrw_fail_stage;
        mov rdi, 3;
        call tb_route_tunnel_valid;
        cmp rax, 0;
        jne tbrw_fail_stage;

        mov rdi, 0xFF;
        call tb_route_adapter_valid;
        cmp rax, 1;
        jne tbrw_fail_stage;
        mov rdi, 0x100;
        call tb_route_adapter_valid;
        cmp rax, 0;
        jne tbrw_fail_stage;

        mov rdi, 2;
        call tb_route_state_valid;
        cmp rax, 1;
        jne tbrw_fail_stage;
        mov rdi, 3;
        call tb_route_state_valid;
        cmp rax, 0;
        jne tbrw_fail_stage;

        mov rdi, 0x419;
        call tb_route_rights_valid;
        cmp rax, 1;
        jne tbrw_fail_stage;
        mov rdi, 0x200;                  // RIGHT_MINT outside mask
        call tb_route_rights_valid;
        cmp rax, 0;
        jne tbrw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT with RIGHT_MINT at slots 217, 218.
        mov rdi, 217;                    // parent endpoint
        mov rsi, 0x200;
        mov rdx, 0x2222;
        call tbrw_endpoint;

        mov rdi, 218;                    // event endpoint
        mov rsi, 0x200;
        mov rdx, 0x3333;
        call tbrw_endpoint;

        // -- 2. BAD_PARENT (parent slot 216 empty).
        mov rax, 2;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        // packed_ident: route=0x000021, tunnel=1 (DP), source=5, sink=7, state=0
        //   [23:0]   route_id
        //   [31:24]  tunnel_type
        //   [39:32]  source_adapter
        //   [47:40]  sink_adapter
        //   [55:48]  state
        mov r10, 0x000021;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 5;
        shl r11, 32;
        or  r10, r11;
        mov r11, 7;
        shl r11, 40;
        or  r10, r11;
        // state=0 (NEGOTIATING): no shift-or needed.

        mov rdi, 220;                    // slot
        mov rsi, 216;                    // parent = empty
        mov rdx, 0x419;                  // rights
        mov rcx, 0xCAFEBABE;             // route_key
        mov r8, 218;                     // endpoint_slot
        mov r9, r10;                     // packed_ident
        call tb_route_cap_mint_inner;
        mov r11, 0xFFFFF9AD;             // BAD_PARENT
        cmp rax, r11;
        jne tbrw_fail_stage;

        // -- 3. BAD_ENDPOINT (endpoint_slot 216 empty).
        mov rax, 3;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov r10, 0x000021;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 5;
        shl r11, 32;
        or  r10, r11;
        mov r11, 7;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 220;
        mov rsi, 217;                    // parent live
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;
        mov r8, 216;                     // endpoint_slot empty
        mov r9, r10;
        call tb_route_cap_mint_inner;
        mov r11, 0xFFFFF9A7;             // BAD_ENDPOINT
        cmp rax, r11;
        jne tbrw_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov r10, 0x000021;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 5;
        shl r11, 32;
        or  r10, r11;
        mov r11, 7;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 220;
        mov rsi, 217;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;
        mov r8, 218;
        mov r9, r10;
        call tb_route_cap_mint_inner;
        cmp rax, 0;
        jne tbrw_fail_stage;

        // -- 5. Query fields.
        mov rax, 5;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov rdi, 220;
        call tb_route_key_of_slot;
        mov r11, 0xCAFEBABE;
        cmp rax, r11;
        jne tbrw_fail_stage;

        mov rdi, 220;
        call tb_route_tunnel_of_slot;
        cmp rax, 1;                      // DP
        jne tbrw_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov r10, 0x000041;
        mov r11, 2;                      // USB3
        shl r11, 24;
        or  r10, r11;
        mov r11, 6;
        shl r11, 32;
        or  r10, r11;
        mov r11, 8;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 221;
        mov rsi, 217;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;             // duplicate key
        mov r8, 218;
        mov r9, r10;
        call tb_route_cap_mint_inner;
        mov r11, 0xFFFFF9A4;             // IN_USE
        cmp rax, r11;
        jne tbrw_fail_stage;

        // -- 7. BAD_TUNNEL (tunnel_type=3).
        mov rax, 7;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov r10, 0x000041;
        mov r11, 3;                      // BAD tunnel_type
        shl r11, 24;
        or  r10, r11;
        mov r11, 6;
        shl r11, 32;
        or  r10, r11;
        mov r11, 8;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 221;
        mov rsi, 217;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABF;
        mov r8, 218;
        mov r9, r10;
        call tb_route_cap_mint_inner;
        mov r11, 0xFFFFF9AA;             // BAD_TUNNEL
        cmp rax, r11;
        jne tbrw_fail_stage;

        // -- 8. SELF_LOOP (source == sink).
        mov rax, 8;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov r10, 0x000041;
        mov r11, 0;                      // PCIe
        shl r11, 24;
        or  r10, r11;
        mov r11, 5;
        shl r11, 32;
        or  r10, r11;
        mov r11, 5;                      // sink == source
        shl r11, 40;
        or  r10, r11;

        mov rdi, 221;
        mov rsi, 217;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABF;
        mov r8, 218;
        mov r9, r10;
        call tb_route_cap_mint_inner;
        mov r11, 0xFFFFF9A9;             // BAD_ADAPTER (self-loop)
        cmp rax, r11;
        jne tbrw_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _tbrw_stage];
        mov [rcx], rax;

        mov rdi, 220;
        call tb_route_cap_revoke_inner;
        cmp rax, 0;
        jne tbrw_fail_stage;

        mov r10, 0x000021;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;
        mov r11, 5;
        shl r11, 32;
        or  r10, r11;
        mov r11, 7;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 220;
        mov rsi, 217;
        mov rdx, 0x419;
        mov rcx, 0xCAFEBABE;             // key is free after revoke
        mov r8, 218;
        mov r9, r10;
        call tb_route_cap_mint_inner;
        cmp rax, 0;
        jne tbrw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tbrw_ok];
        call klog_s1;

        call tbrw_scrub;
        call tbrw_clear;
        xor rax, rax;
        jmp tbrw_out;

      tbrw_fail_stage:
        lea rax, [rip + _tbrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tbrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call tbrw_scrub;
        call tbrw_clear;
        mov rax, 1;

      tbrw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
