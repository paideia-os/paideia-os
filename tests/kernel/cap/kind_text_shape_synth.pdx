// tests/kernel/cap/kind_text_shape_synth.pdx -- G5.M2-002 (#1497)
//
// Boot witness for KIND_TEXT_SHAPE. Exercises table reset,
// validators, tail_alloc happy path, row accessors, find helper,
// and tail_free.
//
// Fingerprint: G5 KIND_TEXT_SHAPE OK

module KindTextShapeSynth = structure {

  pub let mut _ktsw_stage : u64 = 0

  pub let ktsw_ok   : [u8; 20] = "KIND_TEXT_SHAPE OK\n\0"
  pub let ktsw_fail : [u8; 22] = "KIND_TEXT_SHAPE FAIL\n\0"

  pub let kind_text_shape_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G5.M2-002 (#1497): boot witness. Stages: (1) reset. (2) rights_valid. (3) script_valid. (4) dir_valid. (5) glyphs_valid. (6) extent_valid. (7) scale_valid. (8) tail_alloc. (9) row accessors. (10) find_by_key_scale.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        call ts_table_reset;

        // 2. rights.
        mov rax, 2;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call ts_rights_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 0x2000;
        call ts_rights_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 3. script.
        mov rax, 3;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call ts_script_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 12;
        call ts_script_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 0;
        call ts_script_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;
        mov rdi, 13;
        call ts_script_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 4. dir.
        mov rax, 4;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call ts_dir_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 3;
        call ts_dir_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 4;
        call ts_dir_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 5. glyphs.
        mov rax, 5;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 10;
        call ts_glyphs_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 0;
        call ts_glyphs_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 6. extent.
        mov rax, 6;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 800;
        mov rsi, 100;
        call ts_extent_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 0;
        mov rsi, 100;
        call ts_extent_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;
        mov rdi, 16385;
        mov rsi, 100;
        call ts_extent_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 7. scale.
        mov rax, 7;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        mov rsi, 2;
        call ts_scale_valid;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, 0;
        mov rsi, 1;
        call ts_scale_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;
        mov rdi, 65536;
        mov rsi, 1;
        call ts_scale_valid;
        cmp rax, 0;
        jne ktsw_fail_stage;

        // 8. tail_alloc: script=LATIN, dir=LTR, atlas=17, gcount=50,
        //    ext=800x24, scale=3/2, key=0xC0FFEE.
        mov rax, 8;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 1;                         // script LATIN
        mov rsi, 0;                         // LTR
        mov rdx, 0xDEADBEEF;                // features_hash
        call ts_body1_pack;
        mov r12, rax;
        mov rdi, 17;                        // atlas_slot
        mov rsi, 50;                        // glyph_count
        mov rdx, 800;                       // ext_w
        mov rcx, 24;                        // ext_h
        call ts_body2_pack;
        mov r13, rax;
        mov rdi, 3;                         // snum
        mov rsi, 2;                         // sden
        mov rdx, 0;                         // flags
        call ts_body3_pack;
        mov r14, rax;
        mov rdi, 0;
        call ts_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xC0FFEE;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call ts_tail_alloc;
        cmp rax, 0;
        jne ktsw_fail_stage;
        mov r15, rax;                       // row 0

        // 9. Row accessors.
        mov rax, 9;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        call ts_row_key;
        mov r10, 0xC0FFEE;
        cmp rax, r10;
        jne ktsw_fail_stage;
        mov rdi, r15;
        call ts_row_script;
        cmp rax, 1;
        jne ktsw_fail_stage;
        mov rdi, r15;
        call ts_row_glyphs;
        cmp rax, 50;
        jne ktsw_fail_stage;
        mov rdi, r15;
        call ts_row_scale_n;
        cmp rax, 3;
        jne ktsw_fail_stage;
        mov rdi, r15;
        call ts_row_scale_d;
        cmp rax, 2;
        jne ktsw_fail_stage;

        // 10. find_by_key_scale hits the triple; a different scale misses.
        mov rax, 10;
        lea rcx, [rip + _ktsw_stage];
        mov [rcx], rax;
        mov rdi, 0xC0FFEE;
        mov rsi, 3;
        mov rdx, 2;
        call ts_find_by_key_scale;
        cmp rax, 0;
        jne ktsw_fail_stage;
        mov rdi, 0xC0FFEE;
        mov rsi, 2;
        mov rdx, 1;
        call ts_find_by_key_scale;
        mov r10, 0xFF;
        cmp rax, r10;
        jne ktsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ktsw_ok];
        call klog_s1;

        call ts_table_reset;
        xor rax, rax;
        jmp ktsw_out;

      ktsw_fail_stage:
        lea rax, [rip + _ktsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ktsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call ts_table_reset;
        mov rax, 1;

      ktsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
