// tests/kernel/cap/gpu_context_synth.pdx — R37.M5-001 (#1272)
//
// Boot witness for KIND_GPU_CONTEXT.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, VM-slot gate,
// engine ordinal, priority, R_MINT explicit LINEAR refuse
// (KGCTX_MINT_REFUSED_MINT), R_MINT subset refuse, uniqueness on
// ctx_key, state transition discipline, mint / revoke round-trip,
// and linear_flag == 1 on the live row.
//
// Fingerprint: R37 KIND_GPU_CONTEXT OK
//
// Cap slots 160..175.

module GpuContextSynth = structure {

  pub let mut _kgctxw_stage : u64 = 0

  pub let kgctxw_ok   : [u8; 21] = "KIND_GPU_CONTEXT OK\0"
  pub let kgctxw_fail : [u8; 23] = "KIND_GPU_CONTEXT FAIL\0"

  pub let kgctxw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): clear cap_table slots 160..175.",
      block: {
        push rbx;
        mov rbx, 160;
      kgctxwc_loop:
        cmp rbx, 176;
        jae kgctxwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kgctxwc_loop;
      kgctxwc_done:
        pop rbx;
        ret
      }
    }

  pub let kgctxw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): reset GPU CTX row table.",
      block: {
        call gpu_ctx_table_reset;
        ret
      }
    }

  pub let kgctxw_seed_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kgctxw_seed_gpu_vm : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): synthetic KIND_GPU_VM at slot (no rights, cap_handler_gpu_context only reads kind).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x175;                  // KIND_GPU_VM
        xor rdx, rdx;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let gpu_context_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R37.M5-001 (#1272): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_ENGINE. (4) BAD_VM. (5) BAD_RIGHTS (subset trip). (6) REFUSED_MINT (LINEAR explicit). (7) Happy path. (8) Query fields incl. linear_flag == 1. (9) IN_USE. (10) Transition NEW->ACTIVE. (11) Bad transition (ACTIVE->NEW). (12) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        call kgctxw_clear;
        call kgctxw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kgctx_state_valid;
        cmp rax, 1;
        jne kgctxw_fail_stage;
        mov rdi, 3;
        call kgctx_state_valid;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_engine_valid;
        cmp rax, 1;
        jne kgctxw_fail_stage;
        mov rdi, 2;
        call kgctx_engine_valid;
        cmp rax, 1;
        jne kgctxw_fail_stage;
        mov rdi, 3;
        call kgctx_engine_valid;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        mov rdi, 0xFF;
        call kgctx_priority_valid;
        cmp rax, 1;
        jne kgctxw_fail_stage;
        mov rdi, 0x100;
        call kgctx_priority_valid;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 161, KIND_GPU_VM at 162.
        mov rdi, 161;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call kgctxw_seed_endpoint;

        mov rdi, 162;
        mov rsi, 0x11;                   // arbitrary target_ptr
        call kgctxw_seed_gpu_vm;

        // packed_evp_vm = engine[7:0] | priority[15:8] | vm_slot[31:16].
        // Pick engine=0 (RENDER), priority=100, vm_slot=162.
        // Packed = 0x00 | (100<<8) | (162<<16) = 0x00A26400
        mov r15, 0x00A26400;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 160;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE10;
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5AD;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 3. BAD_ENGINE (engine=3 out of range).
        mov rax, 3;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE11;
        mov r8, 0x00A20403;              // engine=3 (bad), priority=4, vm_slot=162(0xA2)
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5AA;             // MINT_BAD_ENGINE
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 4. BAD_VM (vm_slot names empty slot).
        mov rax, 4;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE12;
        mov r8, 0x00A70400;              // vm_slot=167 (empty), engine=0, prio=4
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5AB;             // MINT_BAD_VM
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 5. BAD_RIGHTS (rights with a bit outside R_GPU_CTX_ALL but NOT
        // R_MINT).  0x800 is outside the mask; R_MINT is separately
        // caught in stage 6.
        mov rax, 5;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x81B;                  // 0x800 outside mask
        mov rcx, 0xC0FFEE13;
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5AC;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 6. REFUSED_MINT (R_MINT set -- LINEAR explicit gate fires FIRST).
        mov rax, 6;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x21B;                  // R_MINT (0x200) tripped
        mov rcx, 0xC0FFEE14;
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5A0;             // MINT_REFUSED_MINT (LINEAR)
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 7. Happy path.
        mov rax, 7;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE15;
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        // -- 8. Query fields incl. linear_flag.
        mov rax, 8;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kgctx_row_key;
        mov r11, 0xC0FFEE15;
        cmp rax, r11;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_endpoint;
        cmp rax, 161;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_vm;
        cmp rax, 162;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_engine;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_priority;
        cmp rax, 100;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_state;
        cmp rax, 0;                      // NEW
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_linear;
        cmp rax, 1;                      // LINEAR flag = 1 (frozen)
        jne kgctxw_fail_stage;

        // -- 9. IN_USE (duplicate ctx_key).
        mov rax, 9;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 164;
        mov rsi, 161;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE15;
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        mov r11, 0xFFFFF5A5;             // MINT_IN_USE
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 10. Transition NEW -> ACTIVE.
        mov rax, 10;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // ACTIVE
        call kgctx_row_transition;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        mov rdi, 0;
        call kgctx_row_state;
        cmp rax, 1;
        jne kgctxw_fail_stage;

        // linear_flag survives the state transition.
        mov rdi, 0;
        call kgctx_row_linear;
        cmp rax, 1;
        jne kgctxw_fail_stage;

        // -- 11. Bad transition ACTIVE -> NEW.
        mov rax, 11;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call kgctx_row_transition;
        mov r11, 0xFFFFF5A1;             // BAD_TRANSITION
        cmp rax, r11;
        jne kgctxw_fail_stage;

        // -- 12. Revoke round-trip.
        mov rax, 12;
        lea rcx, [rip + _kgctxw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        call gpu_ctx_cap_revoke_inner;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE15;             // key free after revoke
        mov r8, r15;
        call gpu_ctx_cap_mint_inner;
        cmp rax, 0;
        jne kgctxw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgctxw_ok];
        call klog_s1;

        call kgctxw_scrub;
        call kgctxw_clear;
        xor rax, rax;
        jmp kgctxw_out;

      kgctxw_fail_stage:
        lea rax, [rip + _kgctxw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgctxw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kgctxw_scrub;
        call kgctxw_clear;
        mov rax, 1;

      kgctxw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
