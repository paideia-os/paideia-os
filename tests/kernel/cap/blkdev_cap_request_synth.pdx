// tests/kernel/cap/blkdev_cap_request_synth.pdx -- R51.M8-001 (#1675)
//
// Boot witness for cap/blkdev_cap_request.pdx.
//
// Fingerprint: R51.M8 BLKDEV_CAP_REQUEST OK
//
// Cap slots 128..131 reused from kind_nvme_namespace_synth.pdx's own
// dual-kind-mint fixture shape (128 = synthetic KIND_PCI_DEV/KIND_
// NVME_CONTROLLER parent, 130/131 = KIND_NVME_NAMESPACE/KIND_BLKDEV
// dual-kind children). This witness resets every table it touches
// itself before using it (boot witnesses run sequentially, never
// concurrently, so reusing an already-established slot range is the
// established convention -- see e.g. bt_hci_chan_cap_synth.pdx and
// gpu_bo_synth.pdx both claiming 128..143 independently).
//
// -----------------------------------------------------------------------------
// SCOPE
// -----------------------------------------------------------------------------
//
// (1) Index-table unit coverage: blkdev_index_register /
//     blkdev_index_lookup bad-arg / bad-family / sequential-fill /
//     ENOSPC / miss behavior -- entirely synthetic, no NVMe/AHCI row
//     needed.
// (2) blkdev_cap_request end-to-end against a REAL KIND_BLKDEV row
//     produced by the sanctioned nvme_ns_dual_kind_mint path (the
//     same fixture shape kind_nvme_namespace_synth.pdx already
//     establishes). This asserts the CURRENT, CORRECT behavior given
//     today's substrate state: nvme_ns_cap_mint_inner stamps
//     attest_key = 0 unconditionally (no KIND_DMA_ATTESTATION wiring
//     yet -- design/hardware/nvme-and-disk-substrate.md §5.4 is not
//     enforced at the NVMe/AHCI mint gates as of this commit), so
//     blkdev_cap_request on a freshly-registered real device MUST
//     return MOUNTW_ATTEST_MISSING, not a cap slot. This is a
//     documented residual gap (see cap/blkdev_cap_request.pdx's own
//     module header), not a defect this witness papers over.
//
// A positive "mint actually succeeds" path cannot be exercised until
// a follow-up issue wires the attestation gate into
// nvme_ns_cap_mint_inner / ahci_port_cap_mint_inner (or a synthetic
// attest_key setter is added to a dual-kind mint path) -- there is no
// SANCTIONED writer of attest_key today, and this witness does not
// poke _nvme_namespace_table directly (that table's "only writer"
// discipline is enforced by tools/build.sh's ec_confine_one).

module BlkdevCapRequestSynth = structure {

  pub let mut _bcrw_stage : u64 = 0

  pub let bcrw_ok   : [u8; 28] = "R51.M8 BLKDEV_CAP_REQ OK\n\0\0\0"
  pub let bcrw_fail : [u8; 30] = "R51.M8 BLKDEV_CAP_REQ FAIL\n\0\0\0"

  // Clear cap_table slots 128..132 (mirrors nvmenw_clear).
  pub let bcrw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-001 (#1675): clear cap_table slots 128..131 before (re-)establishing the NVMe dual-kind-mint fixture. Mirrors kind_nvme_namespace_synth.pdx's nvmenw_clear. Labels prefixed bcrw_cl_.",
      block: {
        push rbx;
        mov rbx, 128;
      bcrw_cl_loop:
        cmp rbx, 132;
        jae bcrw_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bcrw_cl_loop;
      bcrw_cl_done:
        pop rbx;
        ret
      }
    }

  // Mint a synthetic KIND_PCI_DEV parent (mirrors nvmenw_pci).
  pub let bcrw_pci : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (bdf: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-001 (#1675): mint a synthetic KIND_PCI_DEV parent for the M1 controller mint gate, mirroring kind_nvme_namespace_synth.pdx's nvmenw_pci. Labels prefixed bcrw_pci_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x30;                   // KIND_PCI_DEV
        mov rdx, 0x21F;                  // R_DEV_ALL | RIGHT_MINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bcrw_slot_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-001 (#1675): read cap_table[slot][+0] (kind field). Mirrors nvmenw_slot_kind. Labels prefixed bcrw_sk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae bcrw_sk_bad;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret;
      bcrw_sk_bad:
        mov rax, 0xDEADBEEF;
        ret
      }
    }

  pub let blkdev_cap_request_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M8-001 (#1675): boot witness for cap/blkdev_cap_request.pdx. Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + sub rsp,8 leave rsp%16 == 0 (entry rsp%16==8 -> 8+48=56 -> sub rsp,8 -> 64, %16==0), matching cap_handler_blkdev's own prologue math. See module header for the two-stage scope (index-table unit coverage, then a real-row attestation-gap round trip). Labels prefixed bcrw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        // -----------------------------------------------------------
        // (1) Reset everything this witness touches.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _bcrw_stage];
        mov [rcx], rax;

        call blkdev_index_table_reset;
        call bcrw_clear;

        // -----------------------------------------------------------
        // (2) Index-table unit coverage: bad-arg / bad-family.
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _bcrw_stage];
        mov [rcx], rax;

        mov rdi, 0;                      // bdev_id == 0
        mov rsi, 1;
        mov rdx, 1;
        call blkdev_index_register;
        mov r10, 0xFFFFECE7;             // MOUNTW_INDEX_BAD_ARG
        cmp rax, r10;
        jne bcrw_fail_stage;

        mov rdi, 0xCAFE;
        mov rsi, 9;                      // bad family
        mov rdx, 1;
        call blkdev_index_register;
        mov r10, 0xFFFFECE7;
        cmp rax, r10;
        jne bcrw_fail_stage;

        // -----------------------------------------------------------
        // (3) Sequential fill to ENOSPC (16 rows).
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _bcrw_stage];
        mov [rcx], rax;

        xor rbx, rbx;                    // fill idx
      bcrw_fill_loop:
        cmp rbx, 16;
        jae bcrw_fill_done;
        mov rdi, rbx;
        add rdi, 0x9000;                 // bdev_id = 0x9000 + idx (non-zero)
        mov rsi, 1;                      // family NVME
        mov rdx, rbx;                    // row_id = idx
        call blkdev_index_register;
        cmp rax, rbx;                    // expect sequential slot == idx
        jne bcrw_fail_stage;
        add rbx, 1;
        jmp bcrw_fill_loop;
      bcrw_fill_done:

        // 17th registration: table full.
        mov rdi, 0xABCD;
        mov rsi, 1;
        mov rdx, 0;
        call blkdev_index_register;
        mov r10, 0xFFFFECE8;             // MOUNTW_INDEX_ENOSPC
        cmp rax, r10;
        jne bcrw_fail_stage;

        // Lookup a mid-table entry + a miss.
        mov rdi, 0x9005;                 // bdev_id for idx=5
        call blkdev_index_lookup;
        mov r10, 1;
        shl r10, 16;
        add r10, 5;                      // expect (1 << 16) | 5
        cmp rax, r10;
        jne bcrw_fail_stage;

        mov rdi, 0xFFFFFFFF;             // never registered
        call blkdev_index_lookup;
        mov r10, 0xFFFFECE0;             // MOUNTW_BAD_BDEV_ID
        cmp rax, r10;
        jne bcrw_fail_stage;

        // blkdev_cap_request on an unregistered id -> BAD_BDEV_ID,
        // propagated verbatim through the lookup step.
        mov rdi, 0x424242;
        call blkdev_cap_request;
        mov r10, 0xFFFFECE0;
        cmp rax, r10;
        jne bcrw_fail_stage;

        // -----------------------------------------------------------
        // (4) Real-row round trip: mint a synthetic NVMe dual-kind
        // KIND_BLKDEV row, register it, and confirm blkdev_cap_request
        // refuses with MOUNTW_ATTEST_MISSING (the correct outcome
        // given today's attestation-gap posture -- see module header).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _bcrw_stage];
        mov [rcx], rax;

        call blkdev_index_table_reset;   // clean slate for this stage
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;

        mov rdi, 128;
        mov rsi, 0xBEEF;
        call bcrw_pci;

        mov rdi, 128;                    // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                  // R_NVMEC_ALL
        xor rdx, rdx;                    // ctrl_idx = 0
        mov rcx, 0x200000;               // bar0_pa (bogus)
        call nvme_ctrl_cap_mint_inner;
        mov r10, 8;                      // NVMEC_MAX
        cmp rax, r10;
        jae bcrw_fail_stage;
        mov r13, rax;                    // ctrl_row_id

        mov rdi, 128;
        mov rsi, 0x198;                  // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        mov rcx, r13;
        call cap_mint_write;

        sub rsp, 32;
        mov rax, 7;
        mov [rsp + 0], rax;              // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;              // lba_size
        mov rax, 500;
        mov [rsp + 16], rax;             // block_count
        mov [rsp + 24], r13;             // parent_ctrl_row
        mov rdi, 130;                    // ns_slot
        mov rsi, 131;                    // blk_slot
        mov rdx, 128;                    // parent_slot
        mov rcx, 0x41F;                  // ns_rights
        mov r8,  0x1F;                   // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                    // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae bcrw_fail_stage;
        mov r14, rax;                    // r14 = ns_row_id

        // Confirm slot 131 really is KIND_BLKDEV, family=NVME.
        mov rdi, 131;
        call bcrw_slot_kind;
        cmp rax, 0x42;
        jne bcrw_fail_stage;

        // Register this row under a chosen bdev_id and look it up.
        mov rdi, 0xB16DEE;               // bdev_id
        mov rsi, 1;                      // family NVME
        mov rdx, r14;                    // row_id
        call blkdev_index_register;
        cmp rax, 0;                      // first row in a freshly-reset table
        jne bcrw_fail_stage;

        mov rdi, 0xB16DEE;
        call blkdev_index_lookup;
        mov r10, 1;
        shl r10, 16;
        or  r10, r14;                    // expect (1 << 16) | row_id
        cmp rax, r10;
        jne bcrw_fail_stage;

        // blkdev_cap_request: today's substrate stamps attest_key = 0
        // at mint time, so this MUST refuse with MOUNTW_ATTEST_MISSING.
        mov rdi, 0xB16DEE;
        call blkdev_cap_request;
        mov r10, 0xFFFFECE1;             // MOUNTW_ATTEST_MISSING
        cmp rax, r10;
        jne bcrw_fail_stage;

        // -----------------------------------------------------------
        // All stages passed.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bcrw_ok];
        call klog_s1;

        call bcrw_clear;
        call blkdev_index_table_reset;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp bcrw_out;

      bcrw_fail_stage:
        lea rax, [rip + _bcrw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bcrw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call bcrw_clear;
        call blkdev_index_table_reset;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      bcrw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
