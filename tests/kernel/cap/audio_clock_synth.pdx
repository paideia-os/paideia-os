// tests/kernel/cap/audio_clock_synth.pdx — R33.M3-003 (#1149)
//
// Boot witness for KIND_AUDIO_CLOCK: the derivation gate over KIND_HW,
// the one-clock-per-timeline rule, the rate/source refusals, the
// report installer's plausibility gates, the revoke, and the dispatch
// handler.
//
// -----------------------------------------------------------------------------
// One fingerprint
// -----------------------------------------------------------------------------
//   R33 KIND_AUDIO_CLOCK OK
//
// Cap slots 148..151 disjoint from every other witness's set.

module AudioClockSynth = structure {

  pub let mut _aclk_w_stage : u64 = 0

  pub let aclk_w_ok   : [u8; 20] = "KIND_AUDIO_CLOCK OK\0"
  pub let aclk_w_fail : [u8; 22] = "KIND_AUDIO_CLOCK FAIL\0"

  pub let aclk_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): clear cap_table slots 148..151 through cap_mint_write. Labels prefixed aclk_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 148;
      aclk_wc_lp:
        cmp rbx, 152;
        jae aclk_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp aclk_wc_lp;
      aclk_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let aclk_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): reset the clock table + counters. Labels prefixed aclk_ws_.",
      block: {
        push rbx;
        call audio_clock_table_reset;
        pop rbx;
        ret
      }
    }

  // Write a synthetic KIND_HW descriptor at (slot, key, rights). Since
  // KIND_HW_TIMELINE has not landed we synthesise a bare KIND_HW parent
  // (§2 of kind_audio_clock.pdx documents the tightening).
  pub let aclk_w_hw : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): write a synthetic KIND_HW (14) descriptor. Labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 14;                     // KIND_HW
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let audio_clock_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R33.M3-003 (#1149): boot witness for KIND_AUDIO_CLOCK. Derivation gate, uniqueness, source/rate refusals, REPORT range refusals, revoke, dispatch. Both exits scrub. Labels prefixed aclk_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        call aclk_w_clear;
        call aclk_w_scrub;

        // 148 = well-formed HW parent. 149 = no RIGHT_MINT. 150 = zero key.
        // 151 = subject.
        mov rdi, 148;
        mov rsi, 0xC101;
        mov rdx, 0x200;
        call aclk_w_hw;
        mov rdi, 149;
        mov rsi, 0xC109;
        mov rdx, 0x001;
        call aclk_w_hw;
        mov rdi, 150;
        xor rsi, rsi;
        mov rdx, 0x200;
        call aclk_w_hw;

        // S1: gate half A.
        mov rax, 2;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 148;
        call audio_clock_check_parent;
        cmp rax, 1;
        jne aclk_w_fail_stage;

        mov rdi, 149;
        call audio_clock_check_parent;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        // S2: rights subset. RIGHT_MINT outside mask.
        mov rax, 3;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call audio_clock_rights_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 0x41B;
        call audio_clock_rights_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 0x200;
        call audio_clock_rights_valid;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        // S3: source validator.
        mov rax, 4;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_clock_source_valid;
        cmp rax, 0;
        jne aclk_w_fail_stage;
        mov rdi, 1;
        call audio_clock_source_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 2;
        call audio_clock_source_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 3;
        call audio_clock_source_valid;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        // S4: hz validator.
        mov rax, 5;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 7999;
        call audio_clock_hz_valid;
        cmp rax, 0;
        jne aclk_w_fail_stage;
        mov rdi, 8000;
        call audio_clock_hz_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 48000;
        call audio_clock_hz_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 192000;
        call audio_clock_hz_valid;
        cmp rax, 1;
        jne aclk_w_fail_stage;
        mov rdi, 192001;
        call audio_clock_hz_valid;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        // S5: mint refusals (bad rights, bad source, bad nominal, no
        // timeline).
        mov rax, 6;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        // bad rights (RIGHT_MINT in mask -> refused).
        mov rdi, 151;
        mov rsi, 148;
        mov rdx, 0x21B;
        mov rcx, 1;
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        mov r11, 0xFFFFFEDC;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // bad source (3).
        mov rdi, 151;
        mov rsi, 148;
        mov rdx, 0x41B;
        mov rcx, 3;
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        mov r11, 0xFFFFFEDB;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // bad nominal (100 Hz).
        mov rdi, 151;
        mov rsi, 148;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 100;
        call audio_clock_cap_mint_inner;
        mov r11, 0xFFFFFEDA;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // no timeline (parent has zero identity).
        mov rdi, 151;
        mov rsi, 150;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        mov r11, 0xFFFFFED8;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // S6: happy mint.
        mov rax, 7;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 151;
        mov rsi, 148;
        mov rdx, 0x41B;
        mov rcx, 1;                      // HDA_BCLK
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_source_of_slot;
        cmp rax, 1;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_nominal_of_slot;
        mov r11, 48000;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_current_of_slot;
        mov r11, 48000;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_samples_of_slot;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        // S7: uniqueness (same timeline key -> IN_USE).
        mov rax, 8;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        // Rewrite slot 149 with the SAME key + RIGHT_MINT to prove
        // one-timeline-one-cap; then re-mint into 150 (cleared first).
        mov rdi, 149;
        mov rsi, 0xC101;
        mov rdx, 0x200;
        call aclk_w_hw;

        // Clear 150 first.
        mov rdi, 150;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 150;
        mov rsi, 149;
        mov rdx, 0x41B;
        mov rcx, 1;
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        mov r11, 0xFFFFFED6;             // MINT_IN_USE
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // S8: REPORT — rate out of range -> IMPLAUSIBLE_RATE.
        mov rax, 9;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 151;
        mov rsi, 200000;                 // > MAX
        mov rdx, 100;
        call audio_clock_report_install;
        mov r11, 0xFFFFFED2;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // Delta out of range -> IMPLAUSIBLE_DELTA.
        mov rdi, 151;
        mov rsi, 48000;
        mov rdx, 200000;                 // > MAX
        call audio_clock_report_install;
        mov r11, 0xFFFFFED1;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // Happy REPORT -> OK; current_hz + samples move.
        mov rdi, 151;
        mov rsi, 47950;
        mov rdx, 100;
        call audio_clock_report_install;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_current_of_slot;
        mov r11, 47950;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_samples_of_slot;
        cmp rax, 100;
        jne aclk_w_fail_stage;

        // S9: revoke and REVOKE_ALREADY.
        mov rax, 10;
        lea rcx, [rip + _aclk_w_stage];
        mov [rcx], rax;

        mov rdi, 151;
        call audio_clock_cap_revoke_inner;
        cmp rax, 0;
        jne aclk_w_fail_stage;

        mov rdi, 151;
        call audio_clock_cap_revoke_inner;
        mov r11, 0xFFFFFED3;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // Wrong kind — try revoke on 148 (KIND_HW).
        mov rdi, 148;
        call audio_clock_cap_revoke_inner;
        mov r11, 0xFFFFFED4;
        cmp rax, r11;
        jne aclk_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + aclk_w_ok];
        call klog_s1;

        call aclk_w_scrub;
        call aclk_w_clear;
        xor rax, rax;
        jmp aclk_w_out;

      aclk_w_fail_stage:
        lea rax, [rip + _aclk_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + aclk_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call aclk_w_scrub;
        call aclk_w_clear;
        mov rax, 1;

      aclk_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
