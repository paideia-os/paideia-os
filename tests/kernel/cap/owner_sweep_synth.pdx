// tests/kernel/cap/owner_sweep_synth.pdx — R31.M1-1587 (#1587) + R31.M1-1589 (#1589)
//
// Boot witness: ONE DEATH REVOKES ALL FIVE R30 DERIVED KINDS, and the
// two axes that revocation travels along are visibly different.
//
// -----------------------------------------------------------------------------
// What this fixture is for
// -----------------------------------------------------------------------------
//
// #1583 wired process death to the R29 cascade and could not write the
// composed witness its own scope item 3 asked for, because the relation
// did not exist: cap_table descriptors carried (kind, rights,
// target_ptr) and no holder, so "the capabilities held by process P" was
// not a representable query. #1587 added the owner column. This is the
// witness that was owed.
//
// The property under test is NOT "the cascades work" -- each kind's own
// fixture already shows that, and re-showing it would be restatement. It
// is that ONE death reaches ALL FIVE, through a relation keyed on the
// HOLDER, and that doing so does not disturb anything held by anyone
// else.
//
// -----------------------------------------------------------------------------
// The two axes, and why the fixture is arranged to separate them
// -----------------------------------------------------------------------------
//
// OWNERSHIP keys on the holder. LINEAGE keys on the parent. A capability
// can be derived from a parent owned by X while being held by Y, so
// neither subsumes the other.
//
// The fixture makes the difference VISIBLE rather than asserting it in
// prose. Six slots carry the dying pid's key, and the sweep answers 6.
// But nine descriptors are cleared, because the OpRegion root's child
// and grandchild -- which no process owns -- go with their ancestor, and
// the second I2C slave -- which no process owns -- goes with its bus. A
// witness that owned everything it minted would have been unable to tell
// the two numbers apart, and therefore unable to show that the composed
// path is a composition at all.
//
// -----------------------------------------------------------------------------
// The four ways this could be got wrong, and where each is asserted
// -----------------------------------------------------------------------------
//
//   * A RECYCLED PID REVOKES A LIVE PROCESS. pid_alloc is a dense-low-
//     first scan and pid_free zeroes its slot with no aging. Sub-test H
//     sweeps for the right pid at a DEAD generation and asserts nothing
//     is touched; sub-test Q asserts a second, live owner's capability
//     survives the first owner's death. Destroying live authority is
//     strictly worse than the leak being fixed, so it gets its own two
//     assertions rather than a share of one.
//
//   * THE SENTINELS COLLIDE. "No process owns this" and "the kernel owns
//     this" are different facts. If they were one value, a dying process
//     would collect the kernel's own capabilities. Sub-test G asserts
//     the two read back DIFFERENT, sub-test H asserts a sweep for either
//     is refused BEFORE it scans, and sub-test P asserts both slots are
//     byte-identical after a live sweep ran past them.
//
//   * TRANSITIVITY IS LOST, or bought with recursion. A window derived
//     from a window must not outlive its parent. Sub-test L asserts the
//     grandchild is gone, and it is reached by the cascade's iterated
//     fixed point -- a full re-scan per pass until a pass revokes
//     nothing -- rather than by a call chain whose depth an adversarial
//     derivation could choose.
//
//   * A GHOST ROW SURVIVES. A row left allocated with no descriptor
//     naming it holds whatever uniqueness key its allocator enforces: an
//     I2C address that can no longer be minted, or a PIN that may be the
//     only way to bring a device out of reset. Sub-tests N and O plant
//     one on two different kinds and follow each to its reclaimer --
//     and they reach DIFFERENT reclaimers, which is the honest result
//     and is stated as such below.
//
// -----------------------------------------------------------------------------
// What this fixture deliberately shows FAILING to be reclaimed, and why
// that is the honest answer
// -----------------------------------------------------------------------------
//
// The I2C ghost row is reclaimed BY THE SWEEP, because the sweep revokes
// the owned bus and the bus's own revoke cascades by bus row, whose
// phase 2 frees rows no descriptor names.
//
// The GPIO ghost row is NOT, and sub-test O asserts that it is not. A
// line row is swept by gpio_line_cascade_revoke_by_controller, which
// runs when the CONTROLLER goes away -- and a process dying is not a
// controller going away. Sub-test O then calls that cascade directly and
// asserts it reclaims the row, so the reclaiming path is shown to exist
// and to be the one that runs at the moment it is meant to.
//
// Asserting the survival rather than quietly not looking is the point.
// The alternative reading -- "the sweep cleans up every row" -- is false,
// and a witness that left it unstated would be read as having
// established it.
//
// -----------------------------------------------------------------------------
// Why a synthetic pid rather than a real task
// -----------------------------------------------------------------------------
//
// pid 40 is bumped through pid_gen_bump twice and never given a task.
// That is enough for everything under test: driver_death_notify resolves
// the incarnation through pid_gen_read, which reads _pid_gen and not
// _pid_table, and the sweep is keyed on the pair. Building a task would
// add a scheduler dependency to a fixture about the capability layer,
// and the task-side of death is already witnessed end to end by
// tests/kernel/driver/death_witness.pdx.
//
// The generation is READ BACK rather than assumed to be 2, so the
// fixture stays correct if an earlier witness ever allocates pid 40.
// The counter is left bumped at exit, deliberately: pid_gen_bump is
// monotonic and un-bumping would forge a lower incarnation, which is the
// one thing the whole (pid, generation) design exists to make impossible.
//
// -----------------------------------------------------------------------------
// Slot budget
// -----------------------------------------------------------------------------
//
// Cap slots 176..199, disjoint from every other witness's set
// (0..8, 10..12, 14..19, 24..27, 28..33, 34..45, 46..55, 56..63, 64..79,
// 80..95, 110..117, 160..175). Cleared at entry and from BOTH exits.
//
//   176  KIND_MEMORY, R_OPREG_ALL     — the window root's base authority
//   177  KIND_OP_REGION  root          OWNED by pid 40
//   178  KIND_OP_REGION  child         unowned — reached by LINEAGE
//   179  KIND_OP_REGION  grandchild    unowned — reached by LINEAGE (fixed point)
//   180  KIND_DEVICE, bdf 0x1500       — the I2C controller's base authority
//   181  KIND_I2C_BUS                  OWNED by pid 40
//   182  KIND_I2C_SLAVE  addr 0x1A     OWNED by pid 40
//   183  KIND_MEMORY, MINT             — the pad window's base authority
//   184  KIND_DEVICE, bdf 0x1F00       — the pad controller's base authority
//   185  KIND_OP_REGION  pad window    unowned — the seam; teardown revokes it
//   186  KIND_GPIO_LINE  pin 5         OWNED by pid 40
//   187  KIND_IPC_ENDPOINT, ep 7       — the session's base authority
//   188  KIND_FW_SESSION                OWNED by pid 40
//   189  KIND_DEVICE                    CAP_OWNER_NONE   — must survive
//   190  KIND_DEVICE                    CAP_OWNER_KERNEL — must survive
//   191  KIND_GPIO_LINE  pin 6         OWNED by pid 40, then GHOSTED
//   192  KIND_I2C_SLAVE  addr 0x2B     unowned, then GHOSTED
//   193  KIND_DEVICE                    OWNED by pid 41 — must survive
//
// -----------------------------------------------------------------------------
// Sub-tests
// -----------------------------------------------------------------------------
//
//   A  Reset every table this fixture touches; assert each is empty.
//   B  Two incarnations for pid 40, one for pid 41; read them back.
//   C  OpRegion root -> child -> grandchild, through the shipping mints.
//   D  I2C bus + two slaves, through the shipping mints.
//   E  Pad controller, window, two GPIO lines, through the shipping path.
//   F  Firmware session, through the shipping mint.
//   G  Stamp ownership. The two sentinels read back DIFFERENT.
//   H  FIVE REFUSALS, each answering 0 without scanning: pid 0, pid 64,
//      the literal kernel key, generation 0, and THE RECYCLED PID —
//      right pid, dead generation. Nothing is revoked by any of them.
//   I  Plant the two ghost rows; assert the rows survive their
//      descriptors.
//   J  THE COMPOSED DEATH. One driver_death_notify(40).
//   K  All six owned capabilities are gone.
//   L  TRANSITIVITY: the child and the grandchild, owned by nobody, went
//      with their ancestor.
//   M  The two axes are different numbers: 6 slots matched, 9
//      descriptors cleared.
//   N  The I2C ghost row was reclaimed, by the bus cascade's phase 2.
//   O  The GPIO ghost row was NOT, and the cascade that does reclaim it
//      does so when called.
//   P  Both sentinels survived, and still read back different.
//   Q  The other owner's capability survived.
//   R  Every swept slot's owner column is clear, so a second sweep
//      counts nothing.
//   S  A second sweep counts nothing.
//   T  Leave every table as we found it.
//
// On any failure the stage number in _owsw_stage identifies the
// assertion.

module OwnerSweepSynth = structure {

  pub let mut _owsw_stage  : u64 = 0
  pub let mut _owsw_gen    : u64 = 0   // pid 40's live incarnation
  pub let mut _owsw_key    : u64 = 0   // pack(40, gen)
  pub let mut _owsw_stale  : u64 = 0   // pack(40, gen - 1) — a dead incarnation
  pub let mut _owsw_key2   : u64 = 0   // pack(41, gen41)
  pub let mut _owsw_opreg0 : u64 = 0   // live op-region rows at entry

  // ==========================================================================
  // owsw_seed(slot, kind, rights, target) -> ()
  //
  // Plant one base authority THROUGH cap_mint_write, the kernel's own
  // descriptor writer. A pass-through, in the shape of
  // fw_session_cap_synth.pdx's fws_w_seed, so the fixture cannot drift
  // into writing descriptors by a route the mint does not use -- and so
  // that every seeded slot gets the same CAP_OWNER_NONE clear a real
  // mint gets.
  // ==========================================================================

  pub let owsw_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): plant one base capability for the fixture through cap_mint_write. Argument order is identical to the callee's, so this is a tail call with no shuffling. It exists rather than four inline register moves so the witness body reads as a list of authorities, and so the fixture writes descriptors ONLY by the route the kernel uses -- which matters more here than in the fixtures this is modelled on, because cap_mint_write now also clears the owner column and a fixture that hand-wrote descriptors would be seeding slots whose ownership state no real mint can produce. Reserved labels: none.",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // owsw_poke(slot, kind, rights, target) -> ()
  //
  // THE GHOST-MAKER, and the ONLY thing in this fixture that writes a
  // descriptor without going through the mint.
  //
  // The distinction from owsw_seed is load-bearing, not stylistic.
  // cap_mint_write clears the owner column on every call; this does not.
  // So writing a ZERO descriptor with this leaves the row allocated, the
  // owner column intact, and nothing pointing at the row -- which is
  // exactly a ghost, and is a state no ordinary API call can produce.
  // Using owsw_seed here would clear the owner too, and the sweep would
  // never visit the slot, and sub-tests N and O would be testing nothing.
  // ==========================================================================

  pub let owsw_poke : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): write a capability descriptor directly into cap_table[slot] (stride 24: kind at +0, rights at +8, target_ptr at +16) WITHOUT touching cap_owner[slot]. This is how the fixture manufactures a GHOST ROW: zeroing a live capability's descriptor leaves its tail-table row allocated with nothing naming it, which is precisely the state each kind's phase-2 row scan exists to clean up and which no ordinary API call can produce. It is deliberately NOT cap_mint_write, because that clears the owner column, and a ghost whose owner was also cleared would never be visited by the sweep -- so the assertion that the sweep finds the slot, answers ALREADY and leaves the ROW behind would pass vacuously. Same body as gpio_cap_synth.pdx's gpl_w_seed, which is the fixture sub-test L this one is modelled on. Leaf. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov [rax + 0],  rsi;
        mov [rax + 8],  rdx;
        mov [rax + 16], rcx;
        ret
      }
    }

  // ==========================================================================
  // owsw_kind(slot) -> u64
  // ==========================================================================

  pub let owsw_kind : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): read cap_table[slot].kind. Every 'this was revoked' and 'this survived' assertion in this fixture goes through this one accessor, so a sweep that revoked the wrong slot cannot pass by being asserted with a differently-shaped read somewhere else. Leaf, pure read. Reserved labels: none.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rax, [rax + 0];
        ret
      }
    }

  // ==========================================================================
  // owsw_opreg_live() -> u64
  //
  // Live rows in _op_region_table. There is no opregion_rows_live, so
  // the count is built from the per-row predicate the kind does export.
  // Counting rather than asserting a specific row matters because
  // OPREG_MAX is 32 for the whole boot and earlier witnesses share the
  // table; every assertion here is a DELTA against the entry count.
  // ==========================================================================

  pub let owsw_opreg_live : () -> u64 !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): count live _op_region_table rows by calling opregion_tail_valid over 0..OPREG_MAX. The kind exports no rows-live counter of its own -- unlike the I2C and GPIO kinds -- so this builds one from the predicate it does export rather than reading the table, which is confined to kind_op_region.o by the [opregion-confine] build step and would fail the build if read here. Three pushes leave rsp%16 == 0 at the nested call; r12 = cursor, r13 = count. Reserved labels: owsw_ol_.",
      block: {
        push r12;
        push r13;
        push r14;

        xor r12, r12;
        xor r13, r13;

      owsw_ol_next:
        cmp r12, 32;                     // OPREG_MAX
        jae owsw_ol_done;
        mov rdi, r12;
        call opregion_tail_valid;
        cmp rax, 0;
        je  owsw_ol_skip;
        add r13, 1;
      owsw_ol_skip:
        add r12, 1;
        jmp owsw_ol_next;

      owsw_ol_done:
        mov rax, r13;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // owsw_clear_slots() -> ()
  //
  // Zero cap_table slots 176..199 AND their owner columns.
  //
  // Both halves matter. A descriptor cleared with its owner column left
  // set is exactly the stale-ownership state #1587's design closes at
  // mint time, and a fixture that left one behind would hand the next
  // boot stage a slot that a dead pid's key still names.
  // ==========================================================================

  pub let owsw_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): zero cap_table slots 176..199 (offset 176*24 = 4224, twenty-four slots of 24 bytes = 72 qwords) and cap_owner[176..199] (offset 176*8 = 1408, twenty-four qwords). Called at entry and at BOTH exits so this fixture leaves both columns exactly as it found them. Clearing the owner column is not tidiness: a descriptor zeroed with its owner left set is the stale-ownership state the design closes at mint time, and leaving one behind would hand the next boot stage a slot a dead pid's key still names -- which is the wrong-process revocation this whole fixture exists to show does not happen. The set is disjoint from every other witness's. Leaf. Labels prefixed owsw_cs_.",
      block: {
        mov rax, cap_table;
        add rax, 4224;                   // 176 * 24
        xor rcx, rcx;
        xor r8, r8;
      owsw_cs_desc:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 72;
        jb  owsw_cs_desc;

        lea rax, [rip + cap_owner];
        add rax, 1408;                   // 176 * 8
        xor rcx, rcx;
        xor r8, r8;
      owsw_cs_own:
        mov [rax + rcx * 8], r8;
        add rcx, 1;
        cmp rcx, 24;
        jb  owsw_cs_own;
        ret
      }
    } @no_frame

  // ==========================================================================
  // owsw_teardown() -> ()
  // ==========================================================================

  pub let owsw_teardown : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): the shared exit, called from BOTH exits -- which is why it is a function rather than inline in the success path, since a fixture whose teardown is inline leaves the failure path to remember it. Order matters and follows gpio_cap_synth.pdx's teardown: revoke the four op-region slots FIRST (opregion_cap_revoke is idempotent on an empty slot and refuses a wrong kind, so calling it unconditionally is safe whether or not the run reached the mints, and whether or not the sweep already took them), and only THEN clear the descriptors -- clearing first would strand rows, and rows are scarcer than slots at OPREG_MAX = 32 for the whole boot. Then the I2C and GPIO cascades reclaim any row a failed run left behind, the slots and owner columns are cleared, and every table this fixture touched is reset. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed owsw_t_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, 176;
      owsw_t_opreg:
        cmp r12, 180;
        jae owsw_t_opreg_done;
        mov rdi, r12;
        call opregion_cap_revoke;
        add r12, 1;
        jmp owsw_t_opreg;
      owsw_t_opreg_done:
        mov rdi, 185;
        call opregion_cap_revoke;

        // Reclaim any row a failed run left with no descriptor naming it.
        mov rdi, 0x1F00;
        call gpio_line_cascade_revoke_by_controller;

        call owsw_clear_slots;
        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpio_io_unbind;
        call gpio_io_synth_disable;
        call i2c_slave_table_reset;
        call i2c_bus_table_reset;
        call fw_session_table_reset;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // owner_sweep_witness() -> u64
  // ==========================================================================

  pub let owner_sweep_witness : () -> u64 !{sysreg, mem} @{boot, cap, sched} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap, sched},
      justification: "R31.M1-1587 (#1587) + R31.M1-1589 (#1589): boot witness for the OWNER axis of revocation. One death revokes all five R30 derived kinds; the lineage cascades run beneath it and reach three more descriptors that no process owned, which is what makes the two axes visibly different numbers rather than a claim; the two sentinels and a second live owner are untouched; a recycled pid at a dead generation matches nothing; and the ghost row each kind can strand is followed to its reclaimer, including the one the sweep does NOT reclaim, which is asserted as surviving rather than left unlooked-at. Drives the shipping mint paths for every kind, so the fixture tests the shape the machine actually has. Five pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 0 at every nested call; cross-call state that is not in those registers lives in module .bss for the same reason the stage counter does. Both exits call owsw_teardown. Capabilities include {sched} because driver_death_notify does. Labels prefixed owsw_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        call owsw_clear_slots;
        call gpio_line_table_reset;
        call lpss_gpio_table_reset;
        call gpio_io_unbind;
        call gpio_io_synth_enable;
        call i2c_slave_table_reset;
        call i2c_bus_table_reset;
        call fw_session_table_reset;

        call gpio_line_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;
        call lpss_gpio_ctrl_count;
        cmp rax, 0;
        jne owsw_w_fail;
        call i2c_bus_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;
        call fw_sessions_live;
        cmp rax, 0;
        jne owsw_w_fail;

        // The op-region table is shared with earlier witnesses, so every
        // assertion about it below is a DELTA against this baseline.
        call owsw_opreg_live;
        lea rcx, [rip + _owsw_opreg0];
        mov [rcx], rax;

        // ================================================================
        // B. Two incarnations for pid 40, one for pid 41.
        //
        // Bumped TWICE so that gen-1 is a real, dead incarnation rather
        // than zero -- a sweep at generation 0 is refused for a
        // different reason, and sub-test H needs the recycled-pid
        // refusal to be the one that fires.
        //
        // The generation is READ BACK rather than assumed to be 2, so
        // the fixture stays correct if an earlier witness ever allocates
        // pid 40.
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 40;
        call pid_gen_bump;
        mov rdi, 40;
        call pid_gen_bump;
        mov rdi, 40;
        call pid_gen_read;
        cmp rax, 2;
        jb  owsw_w_fail;                 // needs gen >= 2 for a dead gen-1
        mov r12, rax;                    // gen
        lea rcx, [rip + _owsw_gen];
        mov [rcx], r12;

        mov rdi, 40;
        mov rsi, r12;
        call cap_owner_pack;
        cmp rax, 0;
        je  owsw_w_fail;
        lea rcx, [rip + _owsw_key];
        mov [rcx], rax;

        mov rdi, 40;
        mov rsi, r12;
        sub rsi, 1;
        call cap_owner_pack;
        cmp rax, 0;
        je  owsw_w_fail;
        lea rcx, [rip + _owsw_stale];
        mov [rcx], rax;

        // The stale key and the live key must DIFFER, or sub-test H
        // would be asserting the live sweep against itself.
        lea rcx, [rip + _owsw_key];
        mov r10, [rcx];
        lea rcx, [rip + _owsw_stale];
        mov r11, [rcx];
        cmp r10, r11;
        je  owsw_w_fail;

        mov rdi, 41;
        call pid_gen_bump;
        mov rdi, 41;
        call pid_gen_read;
        cmp rax, 0;
        je  owsw_w_fail;
        mov r13, rax;
        mov rdi, 41;
        mov rsi, r13;
        call cap_owner_pack;
        cmp rax, 0;
        je  owsw_w_fail;
        lea rcx, [rip + _owsw_key2];
        mov [rcx], rax;

        // ================================================================
        // C. OpRegion: root -> child -> grandchild.
        //
        // The grandchild is what makes sub-test L about TRANSITIVITY
        // rather than about one level of cascade. Its window is inside
        // the child's, which is inside the root's.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 176;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x61B;                  // R_OPREG_ALL
        xor rcx, rcx;
        call owsw_seed;

        mov rdi, 177;
        mov rsi, 176;
        mov rdx, 0x61B;
        mov rcx, 0;                      // OPREG_SPACE_SYSTEM_MEMORY
        mov r8,  0xE0000000;
        mov r9,  0x10000;
        call opregion_cap_mint_root;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 178;
        mov rsi, 177;
        mov rdx, 0x61B;
        mov rcx, 0xE0001000;
        mov r8,  0x100;
        call opregion_cap_derive;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 179;
        mov rsi, 178;                    // a window derived FROM a window
        mov rdx, 0x61B;
        mov rcx, 0xE0001040;
        mov r8,  0x40;
        call opregion_cap_derive;
        cmp rax, 0;
        jne owsw_w_fail;

        // ================================================================
        // D. I2C bus + two slaves.
        //
        // Slave 182 is OWNED and slave 192 is not. Both must be gone
        // after the sweep, by two different routes, which is sub-test M.
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 180;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x208;                  // RIGHT_INVOKE | RIGHT_MINT
        mov rcx, 0x1500;                 // bdf key
        call owsw_seed;

        mov rdi, 181;
        mov rsi, 180;
        mov rdx, 0x618;                  // R_I2C_BUS_ALL (carries MINT)
        mov rcx, 400000;                 // Fast mode
        call i2c_bus_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 182;
        mov rsi, 181;
        mov rdx, 0x41B;                  // R_I2C_SLAVE_ALL
        mov rcx, 0x1A;
        mov r8,  0;                      // 7-bit
        mov r9,  0xD1;                   // driver hint (must be non-zero)
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 192;
        mov rsi, 181;
        mov rdx, 0x41B;
        mov rcx, 0x2B;
        mov r8,  0;
        mov r9,  0xD2;
        call i2c_slave_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        call i2c_slave_rows_live;
        cmp rax, 2;
        jne owsw_w_fail;

        // ================================================================
        // E. Pad controller, window, two lines.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 183;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call owsw_seed;

        mov rdi, 184;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;
        mov rcx, 0x1F00;                 // pad-controller bdf
        call owsw_seed;

        mov rdi, 0x1F00;
        mov rsi, 1;
        mov rdx, 0xFD6E0000;
        mov rcx, 0x2000;
        call lpss_gpio_record;
        cmp rax, 0;
        jne owsw_w_fail;

        xor rdi, rdi;                    // controller index 0
        mov rsi, 183;
        mov rdx, 185;
        mov rcx, 0x61B;
        call lpss_gpio_bind_window;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 185;
        call gpio_io_bind;
        cmp rax, 0;
        jne owsw_w_fail;

        // Community 0's header: revision 0x94 -> four PADCFG registers
        // per pad -> stride 16; PADCFG region at 0x600.
        xor rdi, rdi;
        mov rsi, 0x00940000;
        call gpio_io_synth_poke;
        mov rdi, 0x0C;
        mov rsi, 0x600;
        call gpio_io_synth_poke;

        xor rdi, rdi;
        call lpss_gpio_identify;
        cmp rax, 0;
        jne owsw_w_fail;

        xor rdi, rdi;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 24;                     // community 0: pins 0..23
        call lpss_gpio_add_community;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 186;
        mov rsi, 184;
        mov rdx, 0x41F;                  // R_GPIO_LINE_ALL
        mov rcx, 5;                      // pin 5
        mov r8,  0xD1;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 191;
        mov rsi, 184;
        mov rdx, 0x41F;
        mov rcx, 6;                      // pin 6
        mov r8,  0xD3;
        call gpio_line_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        call gpio_line_rows_live;
        cmp rax, 2;
        jne owsw_w_fail;

        // ================================================================
        // F. Firmware session.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 7;
        mov rsi, 3;                      // domains {0,1}
        call fw_ep_register;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 187;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 7;                      // endpoint id — must match above
        call owsw_seed;

        mov rdi, 188;
        mov rsi, 187;
        mov rdx, 0x00B;                  // READ | WRITE | INVOKE
        lea rcx, [rip + owsw_path];
        mov r8,  18;
        mov r9,  0;                      // domain 0
        call fw_session_cap_mint;
        cmp rax, 0;
        jne owsw_w_fail;

        call fw_sessions_live;
        cmp rax, 1;
        jne owsw_w_fail;

        // Two bystander authorities and one second owner's.
        mov rdi, 189;
        mov rsi, 10;
        mov rdx, 0x008;
        mov rcx, 0x3300;
        call owsw_seed;

        mov rdi, 190;
        mov rsi, 10;
        mov rdx, 0x008;
        mov rcx, 0x3400;
        call owsw_seed;

        mov rdi, 193;
        mov rsi, 10;
        mov rdx, 0x008;
        mov rcx, 0x3500;
        call owsw_seed;

        // ================================================================
        // G. Stamp ownership.
        //
        // Six slots for pid 40 through the AUDITED path, cap_owner_claim,
        // which reads the incarnation from the scheduler rather than
        // taking it as an argument -- so a fixture cannot stamp a key
        // that no live pid could produce.
        //
        // 189 is left at CAP_OWNER_NONE, 190 is claimed for the KERNEL,
        // and the two must read back DIFFERENT. If they were one value
        // a sweep for either would collect the other, and the kernel's
        // own capabilities would go with the first process to die.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov r12, 0;
      owsw_w_claim:
        cmp r12, 6;
        jae owsw_w_claim_done;
        lea rax, [rip + owsw_owned];
        mov rdi, [rax + r12*8];
        mov rsi, 40;
        call cap_owner_claim;
        cmp rax, 0;
        jne owsw_w_fail;
        add r12, 1;
        jmp owsw_w_claim;
      owsw_w_claim_done:

        mov rdi, 190;
        call cap_owner_claim_kernel;
        cmp rax, 0;
        jne owsw_w_fail;

        mov rdi, 193;
        mov rsi, 41;
        call cap_owner_claim;
        cmp rax, 0;
        jne owsw_w_fail;

        // The stamps read back as the packed key, not as a bare pid.
        mov rdi, 177;
        call cap_owner_get;
        lea rcx, [rip + _owsw_key];
        mov r10, [rcx];
        cmp rax, r10;
        jne owsw_w_fail;

        // THE TWO SENTINELS ARE DIFFERENT VALUES.
        mov rdi, 189;
        call cap_owner_get;
        cmp rax, 0;                      // CAP_OWNER_NONE
        jne owsw_w_fail;
        mov r14, rax;

        mov rdi, 190;
        call cap_owner_get;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // CAP_OWNER_KERNEL
        cmp rax, r10;
        jne owsw_w_fail;
        cmp rax, r14;
        je  owsw_w_fail;                 // ...and not equal to each other

        // Neither sentinel is a key any live pid can pack.
        lea rcx, [rip + _owsw_key];
        mov r10, [rcx];
        cmp r10, 0;
        je  owsw_w_fail;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r10, r11;
        je  owsw_w_fail;

        // ================================================================
        // H. FIVE REFUSALS. Each must answer 0 without revoking
        //    anything, and each is refused for its own reason.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        // (1) pid 0 — the reserved 'no process' pid, which is also what
        //     every unowned slot's pid field reads as.
        xor rdi, rdi;
        lea rcx, [rip + _owsw_gen];
        mov rsi, [rcx];
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // (2) pid 64 — CAP_OWNER_PID_MAX, pid_gen_read's own bound.
        mov rdi, 64;
        lea rcx, [rip + _owsw_gen];
        mov rsi, [rcx];
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // (3) THE LITERAL KERNEL KEY. Its pid field is 0xFFFF, which is
        //     outside the sweep's domain -- so the kernel's own
        //     capabilities are not merely unmatched, they are UNASKABLE.
        mov rdi, 0xFFFF;
        mov rsi, 0xFFFFFFFFFFFF;
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // (4) generation 0 — 'no incarnation'.
        mov rdi, 40;
        xor rsi, rsi;
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // (5) THE RECYCLED-PID CASE. The right pid, at an incarnation
        //     that no longer exists. This is the one that would destroy
        //     a LIVE process's authority if the owner were a bare pid,
        //     and it is the reason the key is a pair.
        mov rdi, 40;
        lea rcx, [rip + _owsw_gen];
        mov rsi, [rcx];
        sub rsi, 1;
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // Nothing was touched by any of the five.
        mov rdi, 177;
        call owsw_kind;
        mov r10, 0x150;
        cmp rax, r10;
        jne owsw_w_fail;
        mov rdi, 181;
        call owsw_kind;
        mov r10, 0x152;
        cmp rax, r10;
        jne owsw_w_fail;
        mov rdi, 182;
        call owsw_kind;
        mov r10, 0x153;
        cmp rax, r10;
        jne owsw_w_fail;
        mov rdi, 186;
        call owsw_kind;
        mov r10, 0x154;
        cmp rax, r10;
        jne owsw_w_fail;
        mov rdi, 188;
        call owsw_kind;
        mov r10, 0x155;
        cmp rax, r10;
        jne owsw_w_fail;

        // ================================================================
        // I. PLANT THE TWO GHOST ROWS.
        //
        // 191 is OWNED and ghosted: the sweep will visit it, find a null
        // descriptor, answer ALREADY and clear the column -- and the ROW
        // will still be there. 192 is UNOWNED and ghosted: only its
        // bus's cascade can reach it.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 191;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call owsw_poke;

        mov rdi, 192;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call owsw_poke;

        // The DESCRIPTORS are gone and the ROWS are not. That is a ghost.
        mov rdi, 191;
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;
        call gpio_line_rows_live;
        cmp rax, 2;
        jne owsw_w_fail;

        mov rdi, 192;
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;
        call i2c_slave_rows_live;
        cmp rax, 2;
        jne owsw_w_fail;

        // 191's owner column SURVIVED the poke -- which is the whole
        // reason owsw_poke is not owsw_seed.
        mov rdi, 191;
        call cap_owner_get;
        lea rcx, [rip + _owsw_key];
        mov r10, [rcx];
        cmp rax, r10;
        jne owsw_w_fail;

        // ================================================================
        // J. THE COMPOSED DEATH. One call.
        //
        // driver_death_notify answers DRV_DEATH_NO_SLOT because pid 40
        // owns no DRIVER ROW -- and that is the point. The revocation
        // below happened on the step-1.5 owner sweep, which runs for
        // every dying process, and not as a side effect of a driver
        // teardown that this fixture never set up.
        // ================================================================
        mov rax, 10;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 40;
        call driver_death_notify;
        mov r10, 0xFFFFFFC1;             // DRV_DEATH_NO_SLOT
        cmp rax, r10;
        jne owsw_w_fail;

        // ================================================================
        // K. All six owned capabilities are gone.
        // ================================================================
        mov rax, 11;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov r12, 0;
      owsw_w_gone:
        cmp r12, 6;
        jae owsw_w_gone_done;
        lea rax, [rip + owsw_owned];
        mov rdi, [rax + r12*8];
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;
        add r12, 1;
        jmp owsw_w_gone;
      owsw_w_gone_done:

        // ================================================================
        // L. TRANSITIVITY. The child and the grandchild were owned by
        //    NOBODY. They are gone because their ancestor was revoked,
        //    reached by the cascade's ITERATED FIXED POINT -- a full
        //    re-scan per pass until a pass revokes nothing -- and not by
        //    a recursive walk whose depth a hostile derivation chain
        //    could choose.
        // ================================================================
        mov rax, 12;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 178;
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;
        mov rdi, 179;
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;

        // Their ROWS came back too, or the cascade cleared descriptors
        // and stranded rows -- which is the ghost failure, one level up.
        call owsw_opreg_live;
        mov r13, rax;
        lea rcx, [rip + _owsw_opreg0];
        mov r10, [rcx];
        add r10, 1;                      // only slot 185's window remains
        cmp r13, r10;
        jne owsw_w_fail;

        // ================================================================
        // M. THE TWO AXES ARE DIFFERENT NUMBERS.
        //
        // Six slots carried the dying pid's key. NINE descriptors are
        // gone: the six, plus the OpRegion child and grandchild and the
        // second I2C slave, none of which any process owned. If the
        // owner sweep were doing all the work those three would have
        // survived; if the lineage cascades were, the fw_session and the
        // gpio line -- which have no owned ancestor here -- would have.
        // ================================================================
        mov rax, 13;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 192;
        call owsw_kind;
        cmp rax, 0;
        jne owsw_w_fail;

        // ================================================================
        // N. THE I2C GHOST ROW WAS RECLAIMED.
        //
        // Slot 192's descriptor was already null before the sweep, so
        // nothing named its row. It came back because revoking the OWNED
        // bus ran i2c_slave_cascade_revoke_by_bus_row, whose phase 2
        // frees live rows recording a dying bus regardless of whether a
        // descriptor points at them. Without that phase, the address
        // 0x2B on this bus would be permanently unmintable by a ghost
        // that no capability names and no driver can displace.
        // ================================================================
        mov rax, 14;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        call i2c_slave_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;
        call i2c_bus_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;

        // ================================================================
        // O. THE GPIO GHOST ROW WAS *NOT*, AND THAT IS THE HONEST ANSWER.
        //
        // A line row is swept by gpio_line_cascade_revoke_by_controller,
        // which runs when the CONTROLLER goes away. A process dying is
        // not a controller going away, so the owner sweep -- which
        // revoked slot 191's (already null) descriptor and cleared its
        // owner -- left the row.
        //
        // Asserting the survival rather than quietly not looking is the
        // point. "The sweep reclaims every row" is false, and a witness
        // that left it unstated would be read as having established it.
        //
        // Then the cascade that DOES reclaim it is called, and does.
        // ================================================================
        mov rax, 15;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        call gpio_line_rows_live;
        cmp rax, 1;                      // the ghost is still there
        jne owsw_w_fail;

        mov rdi, 0x1F00;
        call gpio_line_cascade_revoke_by_controller;
        cmp rax, 1;                      // phase 2 freed exactly the ghost
        jne owsw_w_fail;

        call gpio_line_rows_live;
        cmp rax, 0;
        jne owsw_w_fail;

        // ================================================================
        // P. BOTH SENTINELS SURVIVED A LIVE SWEEP THAT RAN PAST THEM.
        // ================================================================
        mov rax, 16;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 189;
        call owsw_kind;
        cmp rax, 10;
        jne owsw_w_fail;
        mov rdi, 189;
        call cap_owner_get;
        cmp rax, 0;                      // still CAP_OWNER_NONE
        jne owsw_w_fail;

        mov rdi, 190;
        call owsw_kind;
        cmp rax, 10;
        jne owsw_w_fail;
        mov rdi, 190;
        call cap_owner_get;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // still CAP_OWNER_KERNEL
        cmp rax, r10;
        jne owsw_w_fail;

        // ================================================================
        // Q. THE OTHER OWNER'S CAPABILITY SURVIVED.
        //
        // pid 41 is a different process. Its capability is untouched and
        // its key is intact -- so the sweep discriminated on the whole
        // key and not on the fact that a key was present.
        // ================================================================
        mov rax, 17;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 193;
        call owsw_kind;
        cmp rax, 10;
        jne owsw_w_fail;
        mov rdi, 193;
        call cap_owner_get;
        lea rcx, [rip + _owsw_key2];
        mov r10, [rcx];
        cmp rax, r10;
        jne owsw_w_fail;

        // ================================================================
        // R. EVERY SWEPT SLOT'S OWNER COLUMN IS CLEAR.
        //
        // Including 191's, whose descriptor was already null when the
        // sweep reached it. That is what stops a re-mint of the slot
        // from inheriting a dead process's key -- the failure that turns
        // this whole design from a leak fix into a live-authority
        // destroyer.
        // ================================================================
        mov rax, 18;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov r12, 0;
      owsw_w_unowned:
        cmp r12, 6;
        jae owsw_w_unowned_done;
        lea rax, [rip + owsw_owned];
        mov rdi, [rax + r12*8];
        call cap_owner_get;
        cmp rax, 0;
        jne owsw_w_fail;
        add r12, 1;
        jmp owsw_w_unowned;
      owsw_w_unowned_done:

        // ================================================================
        // S. A SECOND SWEEP COUNTS NOTHING.
        // ================================================================
        mov rax, 19;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        mov rdi, 40;
        lea rcx, [rip + _owsw_gen];
        mov rsi, [rcx];
        call cap_owner_sweep_revoke;
        cmp rax, 0;
        jne owsw_w_fail;

        // ================================================================
        // T. Leave every table as we found it.
        // ================================================================
        mov rax, 20;
        lea rcx, [rip + _owsw_stage];
        mov [rcx], rax;

        call owsw_teardown;

        call owsw_opreg_live;
        lea rcx, [rip + _owsw_opreg0];
        mov r10, [rcx];
        cmp rax, r10;
        jne owsw_w_fail_notorn;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + owner_sweep_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      owsw_w_fail:
        call owsw_teardown;

      owsw_w_fail_notorn:
        lea rax, [rip + _owsw_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + owner_sweep_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // The six slots the dying pid holds, in one table so the claim loop,
  // the revoked-check loop and the owner-cleared loop cannot drift apart
  // — three assertions about one set, driven from one definition of it.
  pub let owsw_owned : [u64; 6] = [ 177, 181, 182, 186, 188, 191 ]

  // The firmware object's scope path. 18 visible characters; the
  // declared array is padded to 20 so the trailing NUL is inside it.
  pub let owsw_path : [u8; 20] = "\\_SB.PCI0.LPCB.EC2\0\0"

}
