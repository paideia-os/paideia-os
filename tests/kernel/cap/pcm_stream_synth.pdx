// tests/kernel/cap/pcm_stream_synth.pdx — R33.M3-001 (#1147) + R33.M3-005 (#1151)
//
// Boot witness for KIND_PCM_STREAM: the derivation gate over
// KIND_IPC_ENDPOINT, the audio_clock_slot validity check, the ring
// non-zero rule, the LINEAR discipline (no re-parenting), the
// cross-cap invariant #1151 (same ring different clock -> XCLOCK_CONFLICT),
// the position advance, revoke, and dispatch.
//
// -----------------------------------------------------------------------------
// Two fingerprints
// -----------------------------------------------------------------------------
//
//   R33 KIND_PCM_STREAM OK       — stage A: the capability
//   R33 PCM STREAM XCLOCK OK     — stage B: the cross-cap invariant (#1151)
//
// Cap slots 152..159. Requires two synthetic KIND_AUDIO_CLOCK caps at
// mint time; the audio_clock_witness runs FIRST and cleans up, so this
// witness mints its own throwaway KIND_HW parents and audio-clock
// children inside its setup.

module PcmStreamSynth = structure {

  pub let mut _pcm_w_stage : u64 = 0

  pub let pcm_w_ok_a   : [u8; 23] = "R33 KIND_PCM_STREAM OK\0"
  pub let pcm_w_fail_a : [u8; 25] = "R33 KIND_PCM_STREAM FAIL\0"
  pub let pcm_w_ok_b   : [u8; 25] = "R33 PCM STREAM XCLOCK OK\0"
  pub let pcm_w_fail_b : [u8; 27] = "R33 PCM STREAM XCLOCK FAIL\0"

  pub let pcm_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): clear cap_table slots 152..159. Labels prefixed pcm_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 152;
      pcm_wc_lp:
        cmp rbx, 160;
        jae pcm_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pcm_wc_lp;
      pcm_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcm_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): reset the PCM stream table and the audio_clock table. Labels: none.",
      block: {
        push rbx;
        call pcm_stream_table_reset;
        call audio_clock_table_reset;
        pop rbx;
        ret
      }
    }

  // Write a synthetic KIND_HW parent.
  pub let pcm_w_hw : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): write a synthetic KIND_HW descriptor.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 14;                     // KIND_HW
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // Write a synthetic KIND_IPC_ENDPOINT parent with an endpoint_id in
  // target_ptr[15:0].
  pub let pcm_w_ep : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): write a synthetic KIND_IPC_ENDPOINT.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pcm_stream_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R33.M3-001 (#1147) + #1151: boot witness for KIND_PCM_STREAM. Stage A: derivation gate, rights, format/rate/channels validators, LINEAR position advance, revoke, dispatch. Stage B: cross-cap invariant — attempting to mint a second stream that names the SAME ring_bo_key but a DIFFERENT audio_clock_slot is refused with XCLOCK_CONFLICT. Both exits scrub. Labels prefixed pcm_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        call pcm_w_clear;
        call pcm_w_scrub;

        // Setup: mint two KIND_AUDIO_CLOCK caps in slots 152, 153 via
        // synthetic KIND_HW parents.
        //
        // 154 KIND_HW parent for clock A (key 0xC201)
        // 155 KIND_HW parent for clock B (key 0xC202)
        // 156 KIND_IPC_ENDPOINT parent (eid 0x0201)
        // 157 subject stream A
        // 158 subject stream B
        mov rdi, 154;
        mov rsi, 0xC201;
        mov rdx, 0x200;
        call pcm_w_hw;
        mov rdi, 155;
        mov rsi, 0xC202;
        mov rdx, 0x200;
        call pcm_w_hw;

        mov rdi, 152;                    // subject slot
        mov rsi, 154;                    // parent
        mov rdx, 0x41B;
        mov rcx, 1;                      // HDA_BCLK
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        mov rdi, 153;
        mov rsi, 155;
        mov rdx, 0x41B;
        mov rcx, 2;                      // PCH_GEN
        mov r8, 96000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // Now slots 152 and 153 hold live KIND_AUDIO_CLOCK caps.
        mov rdi, 156;
        mov rsi, 0x0201;
        mov rdx, 0x200;
        call pcm_w_ep;

        // ============================================================
        // STAGE A — THE CAPABILITY.
        // ============================================================

        // S1: format validator.
        mov rax, 10;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pcm_stream_format_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;
        mov rdi, 1;
        call pcm_stream_format_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;
        mov rdi, 4;
        call pcm_stream_format_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;
        mov rdi, 5;
        call pcm_stream_format_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // S2: rate validator.
        mov rax, 20;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        mov rdi, 7999;
        call pcm_stream_rate_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;
        mov rdi, 48000;
        call pcm_stream_rate_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;
        mov rdi, 192001;
        call pcm_stream_rate_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // S3: channels validator.
        mov rax, 30;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call pcm_stream_channels_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;
        mov rdi, 2;
        call pcm_stream_channels_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;
        mov rdi, 8;
        call pcm_stream_channels_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;
        mov rdi, 9;
        call pcm_stream_channels_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // S4: clock_valid.
        mov rax, 40;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        mov rdi, 152;                    // live clock
        call pcm_stream_clock_valid;
        cmp rax, 1;
        jne pcm_w_fail_stage_a;

        mov rdi, 156;                    // not a clock (ENDPOINT)
        call pcm_stream_clock_valid;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // S5: mint refusals: BAD_CLOCK.
        mov rax, 50;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        // frc_packed for {S16, 48000, 2}.
        mov rdi, 1;                      // fmt = S16
        mov rsi, 48000;
        mov rdx, 2;
        call pcm_stream_frc_pack;
        mov r15, rax;                    // frc

        // Bad clock (156 is an ENDPOINT, not a clock).
        mov rdi, 157;
        mov rsi, 156;                    // parent endpoint (correct)
        mov rdx, 0x41B;
        mov rcx, 156;                    // bad clock slot
        mov r8, 0xB001;                  // ring key
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        mov r11, 0xFFFFFECB;             // MINT_BAD_CLOCK
        cmp rax, r11;
        jne pcm_w_fail_stage_a;

        // Bad ring (zero).
        mov rdi, 157;
        mov rsi, 156;
        mov rdx, 0x41B;
        mov rcx, 152;
        xor r8, r8;
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        mov r11, 0xFFFFFECA;             // MINT_BAD_RING
        cmp rax, r11;
        jne pcm_w_fail_stage_a;

        // S6: happy mint.
        mov rax, 60;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        mov rdi, 157;
        mov rsi, 156;
        mov rdx, 0x41B;
        mov rcx, 152;                    // clock A
        mov r8, 0xB001;                  // ring
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        mov rdi, 157;
        call pcm_stream_clock_of_slot;
        cmp rax, 152;
        jne pcm_w_fail_stage_a;

        mov rdi, 157;
        call pcm_stream_ring_of_slot;
        mov r11, 0xB001;
        cmp rax, r11;
        jne pcm_w_fail_stage_a;

        mov rdi, 157;
        call pcm_stream_position_of_slot;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        // S7: LINEAR — position_advance moves; other fields do not
        // (no primitive exists to change them).
        mov rax, 70;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        mov rdi, 157;
        mov rsi, 1024;
        call pcm_stream_position_advance;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        mov rdi, 157;
        call pcm_stream_position_of_slot;
        cmp rax, 1024;
        jne pcm_w_fail_stage_a;

        // Clock did not change.
        mov rdi, 157;
        call pcm_stream_clock_of_slot;
        cmp rax, 152;
        jne pcm_w_fail_stage_a;

        // Ring did not change.
        mov rdi, 157;
        call pcm_stream_ring_of_slot;
        mov r11, 0xB001;
        cmp rax, r11;
        jne pcm_w_fail_stage_a;

        // S8: revoke.
        mov rax, 80;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        mov rdi, 157;
        call pcm_stream_cap_revoke_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_a;

        mov rdi, 157;
        call pcm_stream_cap_revoke_inner;
        mov r11, 0xFFFFFEC0;             // REVOKE_ALREADY
        cmp rax, r11;
        jne pcm_w_fail_stage_a;

        // A OK.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcm_w_ok_a];
        call klog_s1;

        // ============================================================
        // STAGE B — CROSS-CAP INVARIANT (#1151).
        // ============================================================
        //
        // Mint stream A on clock 152 with ring 0xB101.
        // Then try to mint stream B on clock 153 (DIFFERENT clock) with
        // the SAME ring 0xB101 -> must refuse XCLOCK_CONFLICT.
        // Then mint stream C on clock 152 (SAME clock) with same ring
        // -> must succeed.
        mov rax, 100;
        lea rcx, [rip + _pcm_w_stage];
        mov [rcx], rax;

        // Refresh subject slot 157.
        mov rdi, 157;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 157;
        mov rsi, 156;
        mov rdx, 0x41B;
        mov rcx, 152;                    // clock A
        mov r8, 0xB101;                  // ring
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_b;

        // Try to mint on 158 with clock B (153) but the SAME ring.
        mov rdi, 158;
        mov rsi, 156;
        mov rdx, 0x41B;
        mov rcx, 153;                    // DIFFERENT clock
        mov r8, 0xB101;                  // SAME ring
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        mov r11, 0xFFFFFEC3;             // MINT_XCLOCK_CONFLICT
        cmp rax, r11;
        jne pcm_w_fail_stage_b;

        // ST_XCLOCK must have advanced.
        mov rdi, 2;                      // ST_XCLOCK
        call pcm_stream_stat;
        cmp rax, 0;
        je  pcm_w_fail_stage_b;

        // But SAME ring + SAME clock is legal (must succeed).
        mov rdi, 158;
        mov rsi, 156;
        mov rdx, 0x41B;
        mov rcx, 152;                    // SAME clock
        mov r8, 0xB101;                  // SAME ring
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne pcm_w_fail_stage_b;

        // B OK.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcm_w_ok_b];
        call klog_s1;

        call pcm_w_scrub;
        call pcm_w_clear;
        xor rax, rax;
        jmp pcm_w_out;

      pcm_w_fail_stage_a:
        lea rax, [rip + _pcm_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcm_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp pcm_w_failed;

      pcm_w_fail_stage_b:
        lea rax, [rip + _pcm_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pcm_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      pcm_w_failed:
        call pcm_w_scrub;
        call pcm_w_clear;
        mov rax, 1;

      pcm_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
