// tests/kernel/cap/battery_synth.pdx — R31.M3-001 (#1099)
//
// Boot witness for KIND_BATTERY: the derivation gate over KIND_DEVICE,
// the one-battery-per-device rule, the static-identity refusals
// (index / design / chemistry), the report installer's three
// plausibility gates (percent / voltage / state), the row's cached
// state semantics, the revoke, and the dispatch handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A FAN, A SHUTDOWN OR A CHARGE-RATE INTEGRATOR, because
// no code in this tree acts on a critical battery state and no code in
// this tree schedules against a charge estimate — kind_battery.pdx §4
// says so at length. A fixture that emitted "R31 BATTERY POLICY OK"
// here would be the kernel talking to itself dressed up as battery
// management, which is what #1590 had to unwind for three already-
// closed issues in the thermal path.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R31 KIND_BATTERY OK       — stage A: the capability. Gate halves,
//                               rights, uniqueness, revoke, dispatch,
//                               static-identity refusals.
//   R31 BATTERY SCALE OK      — stage B: the units. Percent bounds,
//                               voltage bounds, state enumeration,
//                               end-to-end round-trip through REPORT.
//
// Split there because the two fail for unrelated reasons and the
// goldens assert an ordered subsequence: a unit error and a broken gate
// would otherwise present as the same missing line.
//
// -----------------------------------------------------------------------------
// Cap slots 232..243
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree (which use 0..8,
// 10..12, 14..19, 28..33, 46..63, 64..95, 110..117, 160..199, 200..211,
// 212..223, 224..231). Both exits revoke every battery, clear every
// slot and reset the row table, so a failure here cannot be mistaken
// for a fault in whatever runs next.
//
// -----------------------------------------------------------------------------
// The numbers, and why these numbers
// -----------------------------------------------------------------------------
//
// design_cap 57000 mWh — a plausible ThinkPad T14 pack. index 0 is the
// primary bay. chemistry LION (1). A report of {percent 85, mv 12042,
// state DISCHARGING (2)} exercises the round-trip against three values
// that are individually plausible and jointly unambiguous — 85% at
// 12.042 V for a 3S Li-ion is a mid-charge discharging pack, and no
// clamp or mask can produce all three from adjacent garbage.
//
// 101 appears as a refused percent, and 0 appears as a refused voltage:
// 100 is a legitimate percent that clamping would substitute for it,
// and 0 is the row's 'never reported' sentinel that admitting a live
// zero would erase.

module BatterySynth = structure {

  pub let mut _bt_w_stage : u64 = 0

  pub let bt_w_ok_a   : [u8; 18] = "KIND_BATTERY OK\n\0"
  pub let bt_w_fail_a : [u8; 20] = "KIND_BATTERY FAIL\n\0"
  pub let bt_w_ok_b   : [u8; 18] = "BATTERY SCALE OK\n\0"
  pub let bt_w_fail_b : [u8; 20] = "BATTERY SCALE FAIL\n\0"

  // ==========================================================================
  // bt_w_clear() — return slots 232..243 to boot state.
  // ==========================================================================

  pub let bt_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): clear cap_table slots 232..243 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked twelve descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed bt_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 232;
      bt_wc_loop:
        cmp rbx, 244;
        jae bt_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp bt_wc_loop;
      bt_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let bt_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): reset the battery row table and the sensor counters. The counters are deliberately outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of battery_stat a count of implausible reports this fixture invented -- 'this pack keeps returning nonsense' is exactly the diagnosis those counters exist to support. One push leaves rsp%16 == 0 at the nested call. Labels prefixed bt_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call battery_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bt_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let bt_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. The rights argument is a parameter so RIGHT_MINT half of the gate can be exercised in BOTH directions from the same helper. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let battery_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R31.M3-001 (#1099): boot witness for KIND_BATTERY. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the three static-identity refusals that keep a battery from existing without a plausible index / design / chemistry, the one-battery-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of a non-zero reserved field on the REPORT op that carries values, and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the numbers, and it is the half that is specific to this kind: the percent bounds at both edges and one place past each, the voltage bounds including the zero refusal that keeps the 'never reported' sentinel meaningful, the state enumeration boundary, and an end-to-end round trip through REPORT -- push {85%, 12042 mV, DISCHARGING}, read back the three fields separately, prove the report count moved by exactly one. Each stage runs only if the previous passed. Both exits call bt_w_scrub and bt_w_clear. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed bt_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        call bt_w_clear;
        call bt_w_scrub;

        // 232 — well-formed parent. 233 — no RIGHT_MINT. 234 —
        // RIGHT_MINT but zero identity. 236/238/240/242 — extras for
        // uniqueness/scaling probes.
        mov rdi, 232;
        mov rsi, 0xBB01;
        mov rdx, 0x200;                  // RIGHT_MINT
        call bt_w_device;
        mov rdi, 233;
        mov rsi, 0xBB09;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call bt_w_device;
        mov rdi, 234;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call bt_w_device;
        mov rdi, 237;
        mov rsi, 0xBB02;
        mov rdx, 0x200;
        call bt_w_device;
        mov rdi, 239;
        mov rsi, 0xBB03;
        mov rdx, 0x200;
        call bt_w_device;
        mov rdi, 241;
        mov rsi, 0xBB04;
        mov rdx, 0x200;
        call bt_w_device;

        // -- A1. The first half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 232;
        call battery_check_parent_device;
        cmp rax, 1;
        jne bt_w_fail_stage_a;

        mov rdi, 233;
        call battery_check_parent_device;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, 236;                    // empty slot
        call battery_check_parent_device;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 233;                    // parent without RIGHT_MINT
        mov rdx, 0x41B;
        mov rcx, 0;                      // index
        mov r8, 57000;                   // design_mwh
        mov r9, 1;                       // LION
        call battery_cap_mint;
        mov r11, 0xFFFFFE4D;             // BATTERY_MINT_BAD_PARENT
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // -- A2. Rights are a subset test. RIGHT_MINT is outside the mask.
        mov rax, 3;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;                  // READ alone
        call battery_rights_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_a;
        mov rdi, 0x41B;                  // R_BATTERY_ALL
        call battery_rights_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_a;
        mov rdi, 0x200;                  // RIGHT_MINT
        call battery_rights_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x21B;                  // R_BATTERY_ALL | RIGHT_MINT
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE4C;             // BATTERY_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // -- A3. The static-identity refusals. index >= 16, design == 0,
        //    design past MAX, chemistry outside enum.
        mov rax, 4;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 16;                     // BATTERY_INDEX_MAX -> refused
        mov r8, 57000;
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE4B;             // BATTERY_MINT_BAD_INDEX
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 0;
        xor r8, r8;                      // design_mwh == 0
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE4A;             // BATTERY_MINT_BAD_DESIGN
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 1000001;                 // past BATTERY_DESIGN_MWH_MAX
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE4A;
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 6;                       // past BATTERY_CHEM_MAX
        call battery_cap_mint;
        mov r11, 0xFFFFFE49;             // BATTERY_MINT_BAD_CHEM
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // -- A4. The identity is INHERITED, so a parent naming no
        //    device cannot resolve to "device 0".
        mov rax, 5;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 234;
        call battery_parent_key;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 234;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE48;             // BATTERY_MINT_NO_DEVICE
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // -- A5. Happy path. The row reads back as minted, with the
        //    INHERITED key and no report installed yet.
        mov rax, 6;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 1;                       // LION
        call battery_cap_mint;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        call battery_design_of_slot;
        cmp rax, 57000;
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        call battery_percent_of_slot;
        cmp rax, 0xFF;                   // BATTERY_PCT_NONE
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        call battery_state_of_slot;
        cmp rax, 0;                      // BATTERY_STATE_UNKNOWN
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        call battery_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  bt_w_fail_stage_a;

        mov rdi, rbx;
        call battery_row_key;
        cmp rax, 0xBB01;                 // INHERITED key
        jne bt_w_fail_stage_a;

        mov rdi, rbx;
        call battery_row_parent;
        cmp rax, 232;
        jne bt_w_fail_stage_a;

        mov rdi, rbx;
        call battery_row_reports;
        cmp rax, 0;                      // no reports yet
        jne bt_w_fail_stage_a;

        // -- A6. ONE BATTERY, ONE CAPABILITY. Second mint over the same
        //    device is REFUSED, not merged.
        mov rax, 7;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 236;
        mov rsi, 232;                    // same device
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 1;
        call battery_cap_mint;
        mov r11, 0xFFFFFE46;             // BATTERY_MINT_BATT_IN_USE
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 0xBB01;
        call battery_find_by_key;
        cmp rax, rbx;                    // and it IS this row
        jne bt_w_fail_stage_a;

        // A DIFFERENT device is a different pack.
        mov rdi, 238;
        mov rsi, 237;
        mov rdx, 0x41B;
        mov rcx, 1;                      // secondary bay
        mov r8, 45000;
        mov r9, 2;                       // LIPO
        call battery_cap_mint;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        // -- A7. Revoke refusals. Battery revoke aimed at the DEVICE
        //    descriptor must not clear it.
        mov rax, 8;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 232;                    // KIND_DEVICE
        call battery_cap_revoke;
        mov r11, 0xFFFFFE44;             // BATTERY_WRONG_KIND
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 243;                    // empty slot
        call battery_cap_revoke;
        mov r11, 0xFFFFFE43;             // BATTERY_REVOKE_ALREADY
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // Device survived the refused revoke.
        mov rdi, 232;
        call battery_check_parent_device;
        cmp rax, 1;
        jne bt_w_fail_stage_a;

        // -- A8. Dispatch handler. Per-op rights, unknown op, reserved
        //    field on REPORT.
        mov rax, 9;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 235;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 235

        // QUERY_DESIGN is INVOKE.
        mov rdi, 0x008;                  // R_BATTERY_INVOKE
        mov rsi, r12;
        mov rdx, 1;                      // QUERY_DESIGN
        call cap_handler_battery;
        cmp rax, 57000;
        jne bt_w_fail_stage_a;

        // QUERY_DESIGN with only READ is DENIED.
        mov rdi, 0x001;                  // R_BATTERY_READ alone
        mov rsi, r12;
        mov rdx, 1;
        call cap_handler_battery;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // QUERY_PERCENT is READ.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 3;                      // QUERY_PERCENT
        call cap_handler_battery;
        cmp rax, 0xFF;                   // no report yet
        jne bt_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 10;
        call cap_handler_battery;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // REPORT with reserved bits set is REFUSED, not masked.
        mov rdi, 0x002;                  // R_BATTERY_REPORT
        mov rsi, r12;
        mov r13, 1;
        shl r13, 48;                     // reserved [63:48]
        or  r13, 9;                      // op = 9
        mov rdx, r13;
        call cap_handler_battery;
        mov r11, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        // -- A9. Revoke, and RE-MINT. Proves no ghost row was stranded.
        mov rax, 10;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 235;
        call battery_cap_revoke;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        mov rdi, rbx;
        call battery_tail_valid;
        cmp rax, 0;                      // the row went with it
        jne bt_w_fail_stage_a;

        mov rdi, 0xBB01;
        call battery_find_by_key;
        cmp rax, 0xFF;                   // BATTERY_ROW_NONE
        jne bt_w_fail_stage_a;

        mov rdi, 235;
        mov rsi, 232;
        mov rdx, 0x41B;
        mov rcx, 0;
        mov r8, 57000;
        mov r9, 1;
        call battery_cap_mint;
        cmp rax, 0;
        jne bt_w_fail_stage_a;

        // -- A10. A dead row answers BATTERY_DECODE_BAD.
        mov rax, 11;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 7;                      // never-claimed row
        call battery_row_design;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 7;
        call battery_row_percent;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 243;                    // slot holding nothing
        call battery_design_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 232;                    // KIND_DEVICE, not a battery
        call battery_design_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne bt_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bt_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — THE NUMBERS.
        // ================================================================

        // -- B1. Percent bounds. 0 and 100 admitted, 101 refused. Zero
        //    is a legitimate percent; only the sentinel is 0xFF.
        mov rax, 21;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call battery_percent_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 100;
        call battery_percent_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 101;
        call battery_percent_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;
        mov rdi, 200;
        call battery_percent_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        // -- B2. Voltage bounds. Zero REFUSED (sentinel collision),
        //    upper edge admitted, one past refused.
        mov rax, 22;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call battery_voltage_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;
        mov rdi, 25000;
        call battery_voltage_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 25001;
        call battery_voltage_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        // -- B3. State enumeration. Every declared ordinal admitted;
        //    one past refused.
        mov rax, 23;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call battery_state_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 4;
        call battery_state_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 5;
        call battery_state_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        // -- B4. Chemistry enumeration. Every declared ordinal
        //    admitted; one past refused.
        mov rax, 24;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call battery_chem_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 5;
        call battery_chem_valid;
        cmp rax, 1;
        jne bt_w_fail_stage_b;
        mov rdi, 6;
        call battery_chem_valid;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        // -- B5. REPORT round trip. Push {85%, 12042 mV, DISCHARGING},
        //    read each field back, prove the report count moved by
        //    exactly one.
        mov rax, 25;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 235;
        call battery_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  bt_w_fail_stage_b;

        mov rdi, rbx;
        call battery_row_reports;
        mov r14, rax;                    // count before

        mov rdi, 235;
        mov rsi, 85;                     // percent
        mov rdx, 12042;                  // mv
        mov rcx, 2;                      // DISCHARGING
        call battery_report_install;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        mov rdi, 235;
        call battery_percent_of_slot;
        cmp rax, 85;
        jne bt_w_fail_stage_b;

        mov rdi, rbx;
        call battery_row_voltage;
        cmp rax, 12042;
        jne bt_w_fail_stage_b;

        mov rdi, 235;
        call battery_state_of_slot;
        cmp rax, 2;
        jne bt_w_fail_stage_b;

        mov rdi, rbx;
        call battery_row_reports;
        sub rax, r14;
        cmp rax, 1;                      // exactly one
        jne bt_w_fail_stage_b;

        // -- B6. AN IMPLAUSIBLE REPORT CHANGES NOTHING. Not the
        //    percent, not the voltage, not the state, not the count.
        mov rax, 26;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 1;                      // BATTERY_ST_IMPL_PCT
        call battery_stat;
        mov r14, rax;                    // count before

        mov rdi, 235;
        mov rsi, 200;                    // implausible percent
        mov rdx, 12000;
        mov rcx, 2;
        call battery_report_install;
        mov r11, 0xFFFFFE42;             // BATTERY_IMPLAUSIBLE_PCT
        cmp rax, r11;
        jne bt_w_fail_stage_b;

        mov rdi, 235;
        call battery_percent_of_slot;
        cmp rax, 85;                     // unchanged
        jne bt_w_fail_stage_b;

        mov rdi, 1;
        call battery_stat;
        sub rax, r14;
        cmp rax, 1;                      // counted
        jne bt_w_fail_stage_b;

        // Zero voltage is refused.
        mov rdi, 235;
        mov rsi, 80;
        xor rdx, rdx;
        mov rcx, 2;
        call battery_report_install;
        mov r11, 0xFFFFFE41;             // BATTERY_IMPLAUSIBLE_MV
        cmp rax, r11;
        jne bt_w_fail_stage_b;

        // Bad state ordinal is refused.
        mov rdi, 235;
        mov rsi, 80;
        mov rdx, 12000;
        mov rcx, 5;                      // past BATTERY_STATE_MAX
        call battery_report_install;
        mov r11, 0xFFFFFE40;             // BATTERY_IMPLAUSIBLE_STATE
        cmp rax, r11;
        jne bt_w_fail_stage_b;

        // -- B7. CRITICAL is counted separately. Push a CRITICAL
        //    report and prove BATTERY_ST_CRITICAL moved by one.
        mov rax, 27;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, 4;                      // BATTERY_ST_CRITICAL
        call battery_stat;
        mov r14, rax;

        mov rdi, 235;
        mov rsi, 4;                      // 4% is bad but legal
        mov rdx, 11000;
        mov rcx, 4;                      // CRITICAL
        call battery_report_install;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        mov rdi, 4;
        call battery_stat;
        sub rax, r14;
        cmp rax, 1;
        jne bt_w_fail_stage_b;

        // The state is now CRITICAL and the percent is 4.
        mov rdi, 235;
        call battery_state_of_slot;
        cmp rax, 4;
        jne bt_w_fail_stage_b;
        mov rdi, 235;
        call battery_percent_of_slot;
        cmp rax, 4;
        jne bt_w_fail_stage_b;

        // -- B8. Debug print refuses a dead row.
        mov rax, 28;
        lea rcx, [rip + _bt_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call battery_debug_print;
        cmp rax, 0;
        jne bt_w_fail_stage_b;

        mov rdi, 7;                      // never claimed
        call battery_debug_print;
        mov r11, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG
        cmp rax, r11;
        jne bt_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bt_w_ok_b];
        call klog_s1;

        call bt_w_scrub;
        call bt_w_clear;
        xor rax, rax;
        jmp bt_w_out;

      bt_w_fail_stage_a:
        lea rax, [rip + _bt_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bt_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp bt_w_failed;

      bt_w_fail_stage_b:
        lea rax, [rip + _bt_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + bt_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      bt_w_failed:
        call bt_w_scrub;
        call bt_w_clear;
        mov rax, 1;

      bt_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
