// tests/kernel/cap/kind_vk_swapchain_image_synth.pdx -- G3.M2-001 (#1462)
//
// Boot witness for KIND_VK_SWAPCHAIN_IMAGE. Exercises table reset,
// validators, tail_alloc happy path, row accessors, state
// transitions, and tail_free.
//
// Fingerprint: G3 KIND_VK_SWAPCHAIN_IMAGE OK

module KindVkSwapchainImageSynth = structure {

  pub let mut _vksisw_stage : u64 = 0

  pub let vksisw_ok   : [u8; 28] = "KIND_VK_SWAPCHAIN_IMAGE OK\0"
  pub let vksisw_fail : [u8; 30] = "KIND_VK_SWAPCHAIN_IMAGE FAIL\0"

  pub let kind_vk_swapchain_image_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G3.M2-001 (#1462): boot witness. Stages: (1) reset. (2) rights_valid. (3) mode_valid. (4) index_valid. (5) state_valid. (6) tail_alloc happy. (7) row accessors incl. state / present_id / target_pts. (8) set_state OK. (9) find_by_key. (10) tail_free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        call vksi_table_reset;

        // 2. rights_valid: R_VKSI_ALL (0x419) ok; R_MINT (0x200) no.
        mov rax, 2;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0x419;
        call vksi_rights_valid;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 0x200;
        call vksi_rights_valid;
        cmp rax, 0;
        jne vksisw_fail_stage;

        // 3. mode_valid: 0,1,2,3 ok; 4 no.
        mov rax, 3;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vksi_mode_valid;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 3;
        call vksi_mode_valid;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 4;
        call vksi_mode_valid;
        cmp rax, 0;
        jne vksisw_fail_stage;

        // 4. index_valid: 0..3 ok; 4 no.
        mov rax, 4;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call vksi_index_valid;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 4;
        call vksi_index_valid;
        cmp rax, 0;
        jne vksisw_fail_stage;

        // 5. state_valid: 0..5 ok; 6 no.
        mov rax, 5;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 5;
        call vksi_state_valid;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 6;
        call vksi_state_valid;
        cmp rax, 0;
        jne vksisw_fail_stage;

        // 6. tail_alloc happy: body1 pack, body2 pack, alloc row 0.
        mov rax, 6;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 5;        // bo_slot
        mov rsi, 7;        // surface_slot
        mov rdx, 0;        // image_index
        mov rcx, 0;        // present_mode = FIFO
        mov r8,  100;      // gpu_tl_slot
        call vksi_body1_pack;
        mov r12, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  vksisw_fail_stage;
        mov rdi, 101;      // display_tl_slot
        call vksi_body2_pack;
        mov r13, rax;
        cmp r13, r10;
        je  vksisw_fail_stage;
        mov rdi, 42;       // parent_slot
        mov rsi, 1;        // state ACQUIRED
        call vksi_hdr_pack;
        mov r14, rax;
        cmp r14, r10;
        je  vksisw_fail_stage;
        // alloc.
        mov rdi, r14;
        mov rsi, 0xF00D;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  777;      // present_id
        mov r9,  1000000;  // target_pts (1 ms)
        call vksi_tail_alloc;
        cmp rax, 0;
        jne vksisw_fail_stage;

        // 7. row accessors.
        mov rax, 7;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vksi_row_key;
        mov r10, 0xF00D;
        cmp rax, r10;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_bo;
        cmp rax, 5;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_surface;
        cmp rax, 7;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_index;
        cmp rax, 0;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_mode;
        cmp rax, 0;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_gpu_tl;
        mov r10, 100;
        cmp rax, r10;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_dpy_tl;
        mov r10, 101;
        cmp rax, r10;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_state;
        cmp rax, 1;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_present_id;
        mov r10, 777;
        cmp rax, r10;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_target_pts;
        mov r10, 1000000;
        cmp rax, r10;
        jne vksisw_fail_stage;

        // 8. set_state: 1 (ACQUIRED) -> 3 (QUEUED).
        mov rax, 8;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 3;
        call vksi_row_set_state;
        cmp rax, 0;
        jne vksisw_fail_stage;
        mov rdi, 0;
        call vksi_row_state;
        cmp rax, 3;
        jne vksisw_fail_stage;
        // bad state (6) refused.
        mov rdi, 0;
        mov rsi, 6;
        call vksi_row_set_state;
        mov r10, 0xFFFFEE00;
        cmp rax, r10;
        jne vksisw_fail_stage;

        // 9. find_by_key.
        mov rax, 9;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0xF00D;
        call vksi_find_by_key;
        cmp rax, 0;
        jne vksisw_fail_stage;
        mov rdi, 0xBEEF;
        call vksi_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne vksisw_fail_stage;

        // 10. tail_free.
        mov rax, 10;
        lea rcx, [rip + _vksisw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vksi_tail_free;
        mov rdi, 0;
        call vksi_tail_valid;
        cmp rax, 0;
        jne vksisw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vksisw_ok];
        call klog_s1;

        call vksi_table_reset;
        xor rax, rax;
        jmp vksisw_out;

      vksisw_fail_stage:
        lea rax, [rip + _vksisw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vksisw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vksi_table_reset;
        mov rax, 1;

      vksisw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
