// tests/kernel/cap/audio_controller_synth.pdx — R33.M1-005 (#1141)
//
// Boot witness for KIND_AUDIO_CONTROLLER: the derivation gate over
// KIND_DEVICE, the one-controller-per-device rule, the static-identity
// refusals (corb_size / rirb_size), the report installer's range
// plausibility gate, the row's cached codec_count semantics, the
// revoke, and the dispatch handler.
//
// -----------------------------------------------------------------------------
// What this witness asserts, and what it does NOT
// -----------------------------------------------------------------------------
//
// It asserts arithmetic, refusals and state transitions. IT ASSERTS
// NOTHING ABOUT A REAL HDA CONTROLLER OR A REAL CODEC-DISCOVERY DMA,
// because no code in this tree drives one from a KIND_AUDIO_CONTROLLER
// -- kind_audio_controller.pdx §4 says so at length.
//
// -----------------------------------------------------------------------------
// Two fingerprints, not one
// -----------------------------------------------------------------------------
//
//   R33 KIND_AUDIO_CTRL OK    — stage A: the capability. Gate halves,
//                               rights, uniqueness, revoke, dispatch,
//                               static-identity refusals.
//   R33 AUDIO_CTRL COUNT OK   — stage B: the count. Range refusals at
//                               the upper edge, end-to-end round-trip
//                               through REPORT.
//
// Split there because the two fail for unrelated reasons and the
// goldens assert an ordered subsequence.
//
// -----------------------------------------------------------------------------
// Cap slots 100..103
// -----------------------------------------------------------------------------
//
// Disjoint from every other witness in the tree. backlight uses 96..99,
// hid_device uses 108..111. Four slots is exactly enough for one well-
// formed parent, one parent without RIGHT_MINT, one parent with zero
// identity, and the mint's own subject slot. Both exits revoke every
// controller, clear every slot and reset the row table.

module AudioControllerSynth = structure {

  pub let mut _ac_w_stage : u64 = 0

  pub let ac_w_ok_a   : [u8; 24] = "R33 KIND_AUDIO_CTRL OK\n\0"
  pub let ac_w_fail_a : [u8; 26] = "R33 KIND_AUDIO_CTRL FAIL\n\0"
  pub let ac_w_ok_b   : [u8; 26] = "R33 AUDIO_CTRL COUNT OK\n\0"
  pub let ac_w_fail_b : [u8; 28] = "R33 AUDIO_CTRL COUNT FAIL\n\0"

  // ==========================================================================
  // ac_w_clear() — return slots 100..103 to boot state.
  // ==========================================================================

  pub let ac_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): clear cap_table slots 100..103 through cap_mint_write, the only descriptor writer, so the owner column's unconditional clear (#1587) runs on every one of them. Called on both exits: a witness whose failure path leaked four descriptors would make every witness after it report a different fault than the one that actually happened. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed ac_wc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        mov rbx, 100;
      ac_wc_lp:
        cmp rbx, 104;
        jae ac_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp ac_wc_lp;
      ac_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ac_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-005 (#1141): reset the audio controller row table and the counters. The counters are outside the rows so they survive a revoke, which means a fixture that left them populated would hand the next reader of audio_ctrl_stat a count of implausible reports this fixture invented. One push leaves rsp%16 == 0 at the nested call. Labels prefixed ac_ws_ per reserved-label discipline.",
      block: {
        push rbx;
        call audio_ctrl_table_reset;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ac_w_device(slot, key, rights) — mint a synthetic KIND_DEVICE parent.
  // ==========================================================================

  pub let ac_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): write a synthetic KIND_DEVICE descriptor whose target_ptr is `key`, through cap_mint_write. A fixture-local parent rather than a real PCI capability, because what the gate under test reads out of the parent is exactly two things -- kind == 10 and target_ptr -- and manufacturing a real bus enumeration to supply them would test the enumerator rather than the gate. Two pushes leave rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The witness.
  // ==========================================================================

  pub let audio_ctrl_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R33.M1-005 (#1141): boot witness for KIND_AUDIO_CONTROLLER. STAGE A drives the capability: both halves of the derivation gate in both directions, the rights subset test, the two ring-size refusals, the one-controller-per-device rule, the wrong-kind revoke refusal, the dispatch handler's per-op rights and its refusal of a non-zero reserved field on the REPORT op, and a re-mint after revoke which is what proves no ghost row was stranded. STAGE B drives the count: the range plausibility test at the upper edge (0 admitted, CODEC_MAX admitted, CODEC_MAX+1 refused), and an end-to-end round trip through REPORT that proves the report count moved by exactly one. Each stage runs only if the previous passed. Both exits call ac_w_scrub and ac_w_clear. Five-push prologue (rbx, r12, r13, r14, r15) leaves rsp%16 == 0 at every nested call; the stage counter lives in module .bss so it survives every callee-save-clobber pattern in the primitives under test. Labels prefixed ac_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // SETUP
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        call ac_w_clear;
        call ac_w_scrub;

        // 100 — well-formed parent. 101 — no RIGHT_MINT. 102 — RIGHT_MINT
        // but zero identity. 103 — used as subject / second parent.
        mov rdi, 100;
        mov rsi, 0xAC01;
        mov rdx, 0x200;                  // RIGHT_MINT
        call ac_w_device;
        mov rdi, 101;
        mov rsi, 0xAC09;
        mov rdx, 0x001;                  // no RIGHT_MINT
        call ac_w_device;
        mov rdi, 102;
        xor rsi, rsi;                    // no identity
        mov rdx, 0x200;
        call ac_w_device;

        // -- A1. First half of the gate, in both directions.
        mov rax, 2;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 100;
        call audio_ctrl_check_parent_device;
        cmp rax, 1;
        jne ac_w_fail_stage_a;

        mov rdi, 101;
        call audio_ctrl_check_parent_device;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, 103;                    // empty slot
        call audio_ctrl_check_parent_device;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        // Try to mint from a parent without RIGHT_MINT. Subject is 103.
        mov rdi, 103;
        mov rsi, 101;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;             // bar_handle
        mov r8, 2;                       // corb_size = 256
        mov r9, 2;                       // rirb_size = 256
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEBD;             // AUDIO_CTRL_MINT_BAD_PARENT
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // -- A2. Rights subset. RIGHT_MINT outside the mask.
        mov rax, 3;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 0x001;
        call audio_ctrl_rights_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_a;
        mov rdi, 0x41B;
        call audio_ctrl_rights_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_a;
        mov rdi, 0x200;
        call audio_ctrl_rights_valid;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        mov rsi, 100;
        mov rdx, 0x21B;                  // R_AUDIO_CTRL_ALL | RIGHT_MINT
        mov rcx, 0xDEADBEEF;
        mov r8, 2;
        mov r9, 2;
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEBC;             // AUDIO_CTRL_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // -- A3. Ring-size refusals.
        mov rax, 4;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_ctrl_corb_size_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_a;
        mov rdi, 2;
        call audio_ctrl_corb_size_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_a;
        mov rdi, 3;                      // reserved
        call audio_ctrl_corb_size_valid;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        mov rsi, 100;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;
        mov r8, 3;                       // corb_size out of range
        mov r9, 2;
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEBB;             // AUDIO_CTRL_MINT_BAD_CORB
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        mov rsi, 100;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;
        mov r8, 2;
        mov r9, 3;                       // rirb_size out of range
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEBA;             // AUDIO_CTRL_MINT_BAD_RIRB
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // -- A4. Identity is INHERITED.
        mov rax, 5;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 102;
        call audio_ctrl_parent_key;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        mov rsi, 102;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;
        mov r8, 2;
        mov r9, 2;
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEB8;             // AUDIO_CTRL_MINT_NO_DEVICE
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // -- A5. Happy path.
        mov rax, 6;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 103;
        mov rsi, 100;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;             // bar_handle
        mov r8, 2;                       // corb_size = 256
        mov r9, 2;                       // rirb_size = 256
        call audio_ctrl_cap_mint_inner;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        call audio_ctrl_bar_of_slot;
        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        call audio_ctrl_codecs_of_slot;
        cmp rax, 0;                      // starts at 0
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        call audio_ctrl_row_of_slot;
        mov rbx, rax;                    // rbx = row across stage
        cmp rbx, 0xFF;
        je  ac_w_fail_stage_a;

        mov rdi, rbx;
        call audio_ctrl_row_key;
        mov r11, 0xAC01;                 // INHERITED key
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, rbx;
        call audio_ctrl_row_parent;
        cmp rax, 100;
        jne ac_w_fail_stage_a;

        mov rdi, rbx;
        call audio_ctrl_row_reports;
        cmp rax, 0;                      // no reports yet
        jne ac_w_fail_stage_a;

        // -- A6. ONE CONTROLLER, ONE CAPABILITY.
        mov rax, 7;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        // Clear 102 for a fresh subject.
        mov rdi, 102;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 102;                    // subject
        mov rsi, 100;                    // SAME device
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;
        mov r8, 2;
        mov r9, 2;
        call audio_ctrl_cap_mint_inner;
        mov r11, 0xFFFFFEB6;             // AUDIO_CTRL_MINT_AC_IN_USE
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 0xAC01;
        call audio_ctrl_find_by_key;
        cmp rax, rbx;                    // and it IS this row
        jne ac_w_fail_stage_a;

        // -- A7. Revoke refusals.
        mov rax, 8;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 100;                    // KIND_DEVICE
        call audio_ctrl_cap_revoke_inner;
        mov r11, 0xFFFFFEB4;             // AUDIO_CTRL_WRONG_KIND
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 102;                    // empty slot (we cleared it)
        call audio_ctrl_cap_revoke_inner;
        mov r11, 0xFFFFFEB3;             // AUDIO_CTRL_REVOKE_ALREADY
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // Device survived.
        mov rdi, 100;
        call audio_ctrl_check_parent_device;
        cmp rax, 1;
        jne ac_w_fail_stage_a;

        // -- A8. Dispatch handler.
        mov rax, 9;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        // target_ptr as cap_mint_write wrote it: row | (slot << 16).
        mov r12, rbx;
        mov r13, 103;
        shl r13, 16;
        or  r12, r13;                    // r12 = target_ptr for slot 103

        // QUERY_CORBSZ is INVOKE.
        mov rdi, 0x008;                  // R_AUDIO_CTRL_INVOKE
        mov rsi, r12;
        mov rdx, 3;                      // QUERY_CORBSZ
        call cap_handler_audio_ctrl;
        cmp rax, 2;
        jne ac_w_fail_stage_a;

        // QUERY_CORBSZ with only READ is DENIED.
        mov rdi, 0x001;
        mov rsi, r12;
        mov rdx, 3;
        call cap_handler_audio_ctrl;
        mov r11, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // Unknown op.
        mov rdi, 0x41B;
        mov rsi, r12;
        mov rdx, 9;
        call cap_handler_audio_ctrl;
        mov r11, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // REPORT with reserved bits set is REFUSED, not masked.
        mov rdi, 0x002;                  // R_AUDIO_CTRL_REPORT
        mov rsi, r12;
        mov r13, 1;
        shl r13, 16;                     // reserved [63:12]
        or  r13, 8;                      // op = 8
        mov rdx, r13;
        call cap_handler_audio_ctrl;
        mov r11, 0xFFFFFEBE;             // AUDIO_CTRL_TAIL_BAD_ARG
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // QUERY_KEY with reserved bits [63:8] set is REFUSED.
        mov rdi, 0x008;
        mov rsi, r12;
        mov r13, 1;
        shl r13, 16;                     // reserved
        mov rdx, r13;                    // op = 0
        call cap_handler_audio_ctrl;
        mov r11, 0xFFFFFEBE;
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        // -- A9. Revoke and RE-MINT.
        mov rax, 10;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 103;
        call audio_ctrl_cap_revoke_inner;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        mov rdi, rbx;
        call audio_ctrl_tail_valid;
        cmp rax, 0;                      // row went with it
        jne ac_w_fail_stage_a;

        mov rdi, 0xAC01;
        call audio_ctrl_find_by_key;
        cmp rax, 0xFF;                   // AUDIO_CTRL_ROW_NONE
        jne ac_w_fail_stage_a;

        mov rdi, 103;
        mov rsi, 100;
        mov rdx, 0x41B;
        mov rcx, 0xDEADBEEF;
        mov r8, 2;
        mov r9, 2;
        call audio_ctrl_cap_mint_inner;
        cmp rax, 0;
        jne ac_w_fail_stage_a;

        // -- A10. Dead row answers AUDIO_CTRL_DECODE_BAD.
        mov rax, 11;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 102;                    // empty slot
        call audio_ctrl_bar_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 100;                    // KIND_DEVICE, not a controller
        call audio_ctrl_bar_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne ac_w_fail_stage_a;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ac_w_ok_a];
        call klog_s1;

        // ================================================================
        // STAGE B — THE COUNT.
        // ================================================================

        // -- B1. count_valid edges.
        mov rax, 21;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_ctrl_count_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_b;
        mov rdi, 15;
        call audio_ctrl_count_valid;
        cmp rax, 1;
        jne ac_w_fail_stage_b;
        mov rdi, 16;
        call audio_ctrl_count_valid;
        cmp rax, 0;
        jne ac_w_fail_stage_b;

        // -- B2. Refresh row handle after A9 re-mint.
        mov rax, 22;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, 103;
        call audio_ctrl_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  ac_w_fail_stage_b;

        // -- B3. REPORT round trip.
        mov rax, 23;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call audio_ctrl_row_reports;
        mov r14, rax;                    // count before

        mov rdi, 1;                      // AUDIO_CTRL_ST_REPORTS
        call audio_ctrl_stat;
        mov r15, rax;                    // global before

        mov rdi, 103;
        mov rsi, 4;                      // codec_count
        call audio_ctrl_report_install;
        cmp rax, 0;
        jne ac_w_fail_stage_b;

        mov rdi, 103;
        call audio_ctrl_codecs_of_slot;
        cmp rax, 4;
        jne ac_w_fail_stage_b;

        mov rdi, rbx;
        call audio_ctrl_row_reports;
        sub rax, r14;
        cmp rax, 1;
        jne ac_w_fail_stage_b;

        mov rdi, 1;
        call audio_ctrl_stat;
        sub rax, r15;
        cmp rax, 1;
        jne ac_w_fail_stage_b;

        // -- B4. Refuse count > CODEC_MAX.
        mov rax, 24;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        // 15 admitted.
        mov rdi, 103;
        mov rsi, 15;
        call audio_ctrl_report_install;
        cmp rax, 0;
        jne ac_w_fail_stage_b;
        mov rdi, 103;
        call audio_ctrl_codecs_of_slot;
        cmp rax, 15;
        jne ac_w_fail_stage_b;

        // 16 refused; row unchanged; counted.
        mov rdi, 2;                      // AUDIO_CTRL_ST_IMPL_COUNT
        call audio_ctrl_stat;
        mov r14, rax;

        mov rdi, 103;
        mov rsi, 16;                     // past CODEC_MAX
        call audio_ctrl_report_install;
        mov r11, 0xFFFFFEB2;             // IMPLAUSIBLE_COUNT
        cmp rax, r11;
        jne ac_w_fail_stage_b;

        mov rdi, 103;
        call audio_ctrl_codecs_of_slot;
        cmp rax, 15;                     // unchanged from prior good install
        jne ac_w_fail_stage_b;

        mov rdi, 2;
        call audio_ctrl_stat;
        sub rax, r14;
        cmp rax, 1;
        jne ac_w_fail_stage_b;

        // -- B5. Debug print refuses a dead row.
        mov rax, 25;
        lea rcx, [rip + _ac_w_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call audio_ctrl_debug_print;
        cmp rax, 0;
        jne ac_w_fail_stage_b;

        mov rdi, 1;                      // never claimed (only rbx used)
        call audio_ctrl_debug_print;
        mov r11, 0xFFFFFEBE;             // TAIL_BAD_ARG
        cmp rax, r11;
        jne ac_w_fail_stage_b;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ac_w_ok_b];
        call klog_s1;

        call ac_w_scrub;
        call ac_w_clear;
        xor rax, rax;
        jmp ac_w_out;

      ac_w_fail_stage_a:
        lea rax, [rip + _ac_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ac_w_fail_a];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        jmp ac_w_failed;

      ac_w_fail_stage_b:
        lea rax, [rip + _ac_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ac_w_fail_b];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      ac_w_failed:
        call ac_w_scrub;
        call ac_w_clear;
        mov rax, 1;

      ac_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
