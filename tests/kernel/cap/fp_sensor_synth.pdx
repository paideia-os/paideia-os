// tests/kernel/cap/fp_sensor_synth.pdx — R34.M6-001 (#1194)
//
// Boot witness for KIND_FP_SENSOR.
//
// Asserts derivation gate over KIND_DEVICE, vendor / type / dpi
// refusals, uniqueness on sensor_key, mint / revoke round-trip.
//
// Fingerprint: R34 KIND_FP_SENSOR OK
//
// Cap slots 140..147 — REUSED from R34.M2's usb_endpoint block.
// Every witness in that block scrubs the range on both exits; the
// R34.M5 witnesses that also reuse it complete before this one.

module FpSensorSynth = structure {

  pub let mut _fp_w_stage : u64 = 0

  pub let fp_w_ok   : [u8; 18] = "KIND_FP_SENSOR OK\n\0"
  pub let fp_w_fail : [u8; 20] = "KIND_FP_SENSOR FAIL\n\0"

  pub let fp_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): clear cap_table slots 140..147. Labels prefixed fpw_wc_.",
      block: {
        push rbx;
        mov rbx, 140;
      fpw_wc_loop:
        cmp rbx, 148;
        jae fpw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp fpw_wc_loop;
      fpw_wc_done:
        pop rbx;
        ret
      }
    }

  pub let fp_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): reset FP SENSOR row table.",
      block: {
        push rbx;
        call fp_sensor_table_reset;
        pop rbx;
        ret
      }
    }

  // Synthesize a KIND_DEVICE cap at `slot` carrying `rights` with
  // target_ptr = key. KIND_FP_SENSOR derives over KIND_DEVICE; the
  // kind check is empty on its own, so the mint's real work is in
  // the additional gates.
  pub let fp_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): synthetic KIND_DEVICE for gate testing.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let fp_sensor_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M6-001 (#1194): boot witness. Stages: (1) validators. (2) BAD_PARENT on non-KIND_DEVICE. (3) NO_DEVICE on device with target_ptr==0. (4) Happy path (Goodix). (5) Query fields. (6) IN_USE on duplicate key. (7) BAD_VENDOR. (8) BAD_TYPE. (9) BAD_DPI. (10) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        call fp_w_clear;
        call fp_w_scrub;

        // -- 1. Validators.
        mov rdi, 0x27C6;                 // Goodix
        call fp_sensor_vendor_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        mov rdi, 0x06CB;                 // Synaptics
        call fp_sensor_vendor_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        mov rdi, 0xDEAD;
        call fp_sensor_vendor_valid;
        cmp rax, 0;
        jne fp_w_fail_stage;

        mov rdi, 1;                      // AREA
        call fp_sensor_type_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        mov rdi, 2;                      // SWIPE
        call fp_sensor_type_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        xor rdi, rdi;
        call fp_sensor_type_valid;
        cmp rax, 0;
        jne fp_w_fail_stage;

        mov rdi, 100;
        call fp_sensor_dpi_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        mov rdi, 2000;
        call fp_sensor_dpi_valid;
        cmp rax, 1;
        jne fp_w_fail_stage;
        mov rdi, 99;
        call fp_sensor_dpi_valid;
        cmp rax, 0;
        jne fp_w_fail_stage;
        mov rdi, 2001;
        call fp_sensor_dpi_valid;
        cmp rax, 0;
        jne fp_w_fail_stage;

        // Setup: KIND_DEVICE with non-zero key at slot 141.
        mov rdi, 141;
        mov rsi, 0x200;                  // RIGHT_MINT
        mov rdx, 0xDEADBEEF;             // device key
        call fp_w_device;

        // -- 2. BAD_PARENT (parent slot 140 empty).
        mov rax, 2;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        // packed_ident: vendor=0x27C6, product=0x1234, type=1, dpi=500, enroll=0
        mov r10, 0x27C6;                 // vendor
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;                    // + product
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;                    // + type=1
        mov r11, 500;
        shl r11, 40;
        or  r10, r11;                    // + dpi=500

        mov rdi, 143;                    // slot
        mov rsi, 140;                    // parent = empty
        mov rdx, 0x419;                  // rights
        mov rcx, 0xC0FFEE01;             // sensor_key
        mov r8, 141;                     // device_slot
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA8D;             // BAD_PARENT
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 3. NO_DEVICE on device with target_ptr == 0.
        mov rax, 3;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        // Overwrite slot 142 as KIND_DEVICE with key=0.
        mov rdi, 142;
        mov rsi, 0x200;
        mov rdx, 0;
        call fp_w_device;

        mov r10, 0x27C6;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 500;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 143;
        mov rsi, 142;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE01;
        mov r8, 142;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA88;             // NO_DEVICE
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 4. Happy path (Goodix, AREA, 500 dpi).
        mov rax, 4;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov r10, 0x27C6;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 500;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 143;
        mov rsi, 141;                    // parent w/ good key
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE01;
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        cmp rax, 0;
        jne fp_w_fail_stage;

        // -- 5. Query fields.
        mov rax, 5;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov rdi, 143;
        call fp_sensor_key_of_slot;
        mov r11, 0xC0FFEE01;
        cmp rax, r11;
        jne fp_w_fail_stage;

        mov rdi, 143;
        call fp_sensor_vendor_of_slot;
        mov r11, 0x27C6;
        cmp rax, r11;
        jne fp_w_fail_stage;

        mov rdi, 143;
        call fp_sensor_type_of_slot;
        cmp rax, 1;
        jne fp_w_fail_stage;

        mov rdi, 143;
        call fp_sensor_dpi_of_slot;
        cmp rax, 500;
        jne fp_w_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov r10, 0x06CB;
        mov r11, 0x9999;
        shl r11, 16;
        or  r10, r11;
        mov r11, 2;                      // SWIPE
        shl r11, 32;
        or  r10, r11;
        mov r11, 1000;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE01;             // duplicate key
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA85;             // IN_USE
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 7. BAD_VENDOR (0xDEAD).
        mov rax, 7;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov r10, 0xDEAD;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 500;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE02;
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA8B;             // BAD_VENDOR
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 8. BAD_TYPE (0 UNKNOWN).
        mov rax, 8;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov r10, 0x27C6;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 500;                    // dpi (no type in bits [39:32])
        shl r11, 40;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE02;
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA8A;             // BAD_TYPE
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 9. BAD_DPI (99).
        mov rax, 9;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov r10, 0x27C6;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 99;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE02;
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        mov r11, 0xFFFFFA89;             // BAD_DPI
        cmp rax, r11;
        jne fp_w_fail_stage;

        // -- 10. Revoke round-trip.
        mov rax, 10;
        lea rcx, [rip + _fp_w_stage];
        mov [rcx], rax;

        mov rdi, 143;
        call fp_sensor_cap_revoke_inner;
        cmp rax, 0;
        jne fp_w_fail_stage;

        mov r10, 0x27C6;
        mov r11, 0x1234;
        shl r11, 16;
        or  r10, r11;
        mov r11, 1;
        shl r11, 32;
        or  r10, r11;
        mov r11, 500;
        shl r11, 40;
        or  r10, r11;

        mov rdi, 143;
        mov rsi, 141;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE01;             // key is free after revoke
        mov r8, 141;
        mov r9, r10;
        call fp_sensor_cap_mint_inner;
        cmp rax, 0;
        jne fp_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fp_w_ok];
        call klog_s1;

        call fp_w_scrub;
        call fp_w_clear;
        xor rax, rax;
        jmp fp_w_out;

      fp_w_fail_stage:
        lea rax, [rip + _fp_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fp_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call fp_w_scrub;
        call fp_w_clear;
        mov rax, 1;

      fp_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
