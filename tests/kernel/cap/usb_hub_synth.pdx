// tests/kernel/cap/usb_hub_synth.pdx — R34.M1-003 (#1169)
//
// Boot witness for KIND_USB_HUB.
//
// Asserts derivation gate over KIND_USB_DEVICE, port_count / tier /
// tt refusals, uniqueness, mint / revoke round-trip.
//
// Fingerprint: R34 KIND_USB_HUB OK
// Cap slots 184..191.

module UsbHubSynth = structure {

  pub let mut _usbh_w_stage : u64 = 0

  pub let usbh_w_ok   : [u8; 18] = "KIND_USB_HUB OK\n\0\0"
  pub let usbh_w_fail : [u8; 20] = "KIND_USB_HUB FAIL\n\0\0"

  pub let usbh_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): clear cap_table slots 184..191. Labels prefixed usbhs_wc_.",
      block: {
        push rbx;
        push r12;
        mov rbx, 184;
      usbhs_wc_loop:
        cmp rbx, 192;
        jae usbhs_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp usbhs_wc_loop;
      usbhs_wc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usbh_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): reset hub row table + USB device row table + counters.",
      block: {
        push rbx;
        call usb_hub_table_reset;
        call usb_device_table_reset;
        pop rbx;
        ret
      }
    }

  pub let usbh_w_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): synthetic KIND_DEVICE.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 10;
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let usb_hub_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M1-003 (#1169): boot witness. Sequence: (1) validators. (2) BAD_PARENT if parent is not KIND_USB_DEVICE. (3) mint a KIND_USB_DEVICE, then mint a KIND_USB_HUB over it. (4) query fields. (5) IN_USE on duplicate. (6) BAD_PORTS at 0 and 16. (7) BAD_TIER at 0 and 6. (8) revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        call usbh_w_clear;
        call usbh_w_scrub;

        // -- 1. Validators.
        xor rdi, rdi;
        call usb_hub_port_count_valid;
        cmp rax, 0;
        jne usbh_w_fail_stage;
        mov rdi, 1;
        call usb_hub_port_count_valid;
        cmp rax, 1;
        jne usbh_w_fail_stage;
        mov rdi, 15;
        call usb_hub_port_count_valid;
        cmp rax, 1;
        jne usbh_w_fail_stage;
        mov rdi, 16;
        call usb_hub_port_count_valid;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        xor rdi, rdi;
        call usb_hub_tier_valid;
        cmp rax, 0;
        jne usbh_w_fail_stage;
        mov rdi, 1;
        call usb_hub_tier_valid;
        cmp rax, 1;
        jne usbh_w_fail_stage;
        mov rdi, 5;
        call usb_hub_tier_valid;
        cmp rax, 1;
        jne usbh_w_fail_stage;
        mov rdi, 6;
        call usb_hub_tier_valid;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // -- 2. BAD_PARENT: mint on KIND_DEVICE (10) parent (not USB_DEVICE).
        mov rax, 2;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        mov rdi, 185;
        mov rsi, 0xDEADBEEF;
        mov rdx, 0x200;
        call usbh_w_device;

        mov rdi, 184;
        mov rsi, 185;                    // parent is KIND_DEVICE
        mov rdx, 0x419;
        mov rcx, 4;                      // port_count
        mov r8, 1;                       // tt
        mov r9, 1;                       // tier
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFD;             // BAD_PARENT
        cmp rax, r11;
        jne usbh_w_fail_stage;

        // -- 3. Mint a KIND_USB_DEVICE, then a KIND_USB_HUB.
        mov rax, 3;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        // KIND_USB_DEVICE mint at slot 186 with parent 185.
        mov rdi, 186;
        mov rsi, 185;
        mov rdx, 0x619;                  // R_USB_DEVICE_ALL (includes MINT)
        mov rcx, 1;                      // address 1
        mov r8, 4;                       // SUPER
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // Hub mint over slot 186.
        mov rdi, 184;
        mov rsi, 186;
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;                       // no TT
        mov r9, 1;
        call usb_hub_cap_mint_inner;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // -- 4. Query fields.
        mov rax, 4;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        mov rdi, 184;
        call usb_hub_port_count_of_slot;
        cmp rax, 4;
        jne usbh_w_fail_stage;

        mov rdi, 184;
        call usb_hub_tt_of_slot;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        mov rdi, 184;
        call usb_hub_tier_of_slot;
        cmp rax, 1;
        jne usbh_w_fail_stage;

        // -- 5. Duplicate hub_key -> IN_USE.
        mov rax, 5;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        mov rdi, 187;
        mov rsi, 184;
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;
        mov r9, 2;
        // Parent 184 is a HUB — should refuse BAD_PARENT before IN_USE.
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFD;
        cmp rax, r11;
        jne usbh_w_fail_stage;

        // Explicit IN_USE: same USB device parent, same key.
        mov rdi, 187;
        mov rsi, 186;                    // same USB device parent
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;
        mov r9, 1;
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEF6;             // IN_USE
        cmp rax, r11;
        jne usbh_w_fail_stage;

        // -- 6. BAD_PORTS at 0 and 16.
        mov rax, 6;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        // Need a fresh USB device parent (188) with a different key.
        mov rdi, 188;
        mov rsi, 0xCAFE00AA;
        mov rdx, 0x200;
        call usbh_w_device;

        mov rdi, 189;
        mov rsi, 188;
        mov rdx, 0x619;
        mov rcx, 2;
        mov r8, 3;
        call usb_device_cap_mint_inner;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // Now BAD_PORTS.
        mov rdi, 190;
        mov rsi, 189;
        mov rdx, 0x419;
        xor rcx, rcx;                    // port_count = 0
        mov r8, 0;
        mov r9, 1;
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFB;             // BAD_PORTS
        cmp rax, r11;
        jne usbh_w_fail_stage;

        mov rdi, 190;
        mov rsi, 189;
        mov rdx, 0x419;
        mov rcx, 16;                     // port_count = 16
        mov r8, 0;
        mov r9, 1;
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFB;
        cmp rax, r11;
        jne usbh_w_fail_stage;

        // -- 7. BAD_TIER at 0 and 6.
        mov rax, 7;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        mov rdi, 190;
        mov rsi, 189;
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;
        xor r9, r9;                      // tier = 0
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFA;
        cmp rax, r11;
        jne usbh_w_fail_stage;

        mov rdi, 190;
        mov rsi, 189;
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;
        mov r9, 6;
        call usb_hub_cap_mint_inner;
        mov r11, 0xFFFFFEFA;
        cmp rax, r11;
        jne usbh_w_fail_stage;

        // -- 8. Revoke round-trip.
        mov rax, 8;
        lea rcx, [rip + _usbh_w_stage];
        mov [rcx], rax;

        mov rdi, 184;
        call usb_hub_cap_revoke_inner;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // Re-mint after revoke succeeds on parent 186 (whose USB
        // device row is still live).
        mov rdi, 184;
        mov rsi, 186;
        mov rdx, 0x419;
        mov rcx, 4;
        mov r8, 0;
        mov r9, 1;
        call usb_hub_cap_mint_inner;
        cmp rax, 0;
        jne usbh_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbh_w_ok];
        call klog_s1;

        call usbh_w_scrub;
        call usbh_w_clear;
        xor rax, rax;
        jmp usbh_w_out;

      usbh_w_fail_stage:
        lea rax, [rip + _usbh_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + usbh_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call usbh_w_scrub;
        call usbh_w_clear;
        mov rax, 1;

      usbh_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
