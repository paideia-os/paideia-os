// tests/kernel/cap/isoch_stream_synth.pdx — R34.M5-001 (#1186)
//
// Boot witness for KIND_ISOCH_STREAM.
//
// Asserts derivation gate over KIND_USB_ENDPOINT, interval /
// bandwidth / direction refusals, uniqueness on stream_key, mint /
// revoke round-trip.
//
// Fingerprint: R34 KIND_ISOCH_STREAM OK
//
// Cap slots 140..147 — REUSED from R34.M2's usb_endpoint_synth block.
// Every witness in the endpoint block scrubs the range on both
// exits and no witness between usb_endpoint_witness and this one
// touches 140..147, so the reuse is safe.

module IsochStreamSynth = structure {

  pub let mut _isoch_w_stage : u64 = 0

  pub let isoch_w_ok   : [u8; 22] = "KIND_ISOCH_STREAM OK\0"
  pub let isoch_w_fail : [u8; 24] = "KIND_ISOCH_STREAM FAIL\0"

  pub let isoch_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): clear cap_table slots 140..147. Labels prefixed isochw_wc_.",
      block: {
        push rbx;
        mov rbx, 140;
      isochw_wc_loop:
        cmp rbx, 148;
        jae isochw_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp isochw_wc_loop;
      isochw_wc_done:
        pop rbx;
        ret
      }
    }

  pub let isoch_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): reset ISOCH stream row table.",
      block: {
        push rbx;
        call isoch_stream_table_reset;
        pop rbx;
        ret
      }
    }

  // Synthesize a KIND_USB_ENDPOINT cap at `slot` with `rights`.
  // KIND_ISOCH_STREAM derives over KIND_USB_ENDPOINT, so we short-
  // circuit the R34.M2 mint chain (device -> hub -> interface ->
  // endpoint) by writing the descriptor directly. The gate only
  // checks kind == 0x165 with RIGHT_MINT — the parent's own row-
  // table state is irrelevant to this witness.
  pub let isoch_w_endpoint : (u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): synthetic KIND_USB_ENDPOINT for gate testing.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 0x165;                  // KIND_USB_ENDPOINT
        mov rdx, r13;
        xor rcx, rcx;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let isoch_stream_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R34.M5-001 (#1186): boot witness. Stages: (1) validators. (2) BAD_PARENT on non-USB_ENDPOINT parent. (3) BAD_ENDPOINT on non-USB_ENDPOINT endpoint_slot. (4) Happy path. (5) Query fields. (6) IN_USE on duplicate key. (7) BAD_INTERVAL (0). (8) BAD_BANDWIDTH (3073). (9) BAD_DIRECTION (2). (10) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        call isoch_w_clear;
        call isoch_w_scrub;

        // -- 1. Validators.
        mov rdi, 1;
        call isoch_stream_interval_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        mov rdi, 255;
        call isoch_stream_interval_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        xor rdi, rdi;
        call isoch_stream_interval_valid;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        xor rdi, rdi;
        call isoch_stream_bandwidth_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        mov rdi, 3072;
        call isoch_stream_bandwidth_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        mov rdi, 3073;
        call isoch_stream_bandwidth_valid;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        xor rdi, rdi;
        call isoch_stream_direction_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        mov rdi, 1;
        call isoch_stream_direction_valid;
        cmp rax, 1;
        jne isoch_w_fail_stage;
        mov rdi, 2;
        call isoch_stream_direction_valid;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        // Setup: KIND_USB_ENDPOINT at slots 141 and 142.
        mov rdi, 141;
        mov rsi, 0x200;                  // RIGHT_MINT
        call isoch_w_endpoint;
        mov rdi, 142;
        mov rsi, 0x200;
        call isoch_w_endpoint;

        // -- 2. BAD_PARENT (parent slot 140 is empty).
        mov rax, 2;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        // packed_body: interval=1, bandwidth=1024, direction=1
        mov r10, 1;                      // interval
        mov r11, 1024;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;                    // direction=1

        mov rdi, 143;                    // slot
        mov rsi, 140;                    // parent = empty -> BAD_PARENT
        mov rdx, 141;                    // endpoint_slot
        mov rcx, 0x419;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFACD;             // BAD_PARENT
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 3. BAD_ENDPOINT (endpoint_slot 140 is empty).
        mov rax, 3;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov r10, 1;
        mov r11, 1024;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 143;
        mov rsi, 141;
        mov rdx, 140;                    // endpoint_slot = empty
        mov rcx, 0x419;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFACB;             // BAD_ENDPOINT
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 4. Happy path.
        mov rax, 4;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov r10, 4;                      // interval=4
        mov r11, 1024;
        shl r11, 8;
        or  r10, r11;                    // bandwidth=1024
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;                    // direction=1

        mov rdi, 143;
        mov rsi, 141;                    // parent USB_ENDPOINT
        mov rdx, 142;                    // endpoint_slot USB_ENDPOINT
        mov rcx, 0x419;
        mov r8, 0xC0FFEE01;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        // -- 5. Query fields.
        mov rax, 5;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov rdi, 143;
        call isoch_stream_key_of_slot;
        mov r11, 0xC0FFEE01;
        cmp rax, r11;
        jne isoch_w_fail_stage;

        mov rdi, 143;
        call isoch_stream_endpoint_of_slot;
        cmp rax, 142;
        jne isoch_w_fail_stage;

        mov rdi, 143;
        call isoch_stream_interval_of_slot;
        cmp rax, 4;
        jne isoch_w_fail_stage;

        mov rdi, 143;
        call isoch_stream_bandwidth_of_slot;
        cmp rax, 1024;
        jne isoch_w_fail_stage;

        mov rdi, 143;
        call isoch_stream_direction_of_slot;
        cmp rax, 1;
        jne isoch_w_fail_stage;

        // -- 6. IN_USE on duplicate key.
        mov rax, 6;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov r10, 2;
        mov r11, 512;
        shl r11, 8;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 142;
        mov rcx, 0x419;
        mov r8, 0xC0FFEE01;              // duplicate key
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFAC5;             // IN_USE
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 7. BAD_INTERVAL (0).
        mov rax, 7;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        xor r10, r10;                    // interval=0 (bad)
        mov r11, 1024;
        shl r11, 8;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 142;
        mov rcx, 0x419;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFACA;             // BAD_INTERVAL
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 8. BAD_BANDWIDTH (3073).
        mov rax, 8;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov r10, 1;
        mov r11, 3073;                   // bandwidth=3073 (bad)
        shl r11, 8;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 142;
        mov rcx, 0x419;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFAC9;             // BAD_BANDWIDTH
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 9. BAD_DIRECTION (2).
        mov rax, 9;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov r10, 1;
        mov r11, 512;
        shl r11, 8;
        or  r10, r11;
        mov r11, 2;                      // direction=2 (bad)
        shl r11, 24;
        or  r10, r11;

        mov rdi, 144;
        mov rsi, 141;
        mov rdx, 142;
        mov rcx, 0x419;
        mov r8, 0xC0FFEE02;
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        mov r11, 0xFFFFFAC8;             // BAD_DIRECTION
        cmp rax, r11;
        jne isoch_w_fail_stage;

        // -- 10. Revoke round-trip.
        mov rax, 10;
        lea rcx, [rip + _isoch_w_stage];
        mov [rcx], rax;

        mov rdi, 143;
        call isoch_stream_cap_revoke_inner;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        mov r10, 4;
        mov r11, 1024;
        shl r11, 8;
        or  r10, r11;
        mov r11, 1;
        shl r11, 24;
        or  r10, r11;

        mov rdi, 143;
        mov rsi, 141;
        mov rdx, 142;
        mov rcx, 0x419;
        mov r8, 0xC0FFEE01;              // key is free after revoke
        mov r9, r10;
        call isoch_stream_cap_mint_inner;
        cmp rax, 0;
        jne isoch_w_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + isoch_w_ok];
        call klog_s1;

        call isoch_w_scrub;
        call isoch_w_clear;
        xor rax, rax;
        jmp isoch_w_out;

      isoch_w_fail_stage:
        lea rax, [rip + _isoch_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + isoch_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call isoch_w_scrub;
        call isoch_w_clear;
        mov rax, 1;

      isoch_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
