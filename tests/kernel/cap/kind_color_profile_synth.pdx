// tests/kernel/cap/kind_color_profile_synth.pdx -- G6.M1-001 (#1509)
//
// Boot witness for KIND_COLOR_PROFILE. Exercises table reset,
// validators, tail_alloc happy path, row accessors, find_by_key,
// and tail_free.
//
// Fingerprint: G6 KIND_COLOR_PROFILE OK

module KindColorProfileSynth = structure {

  pub let mut _kcpw_stage : u64 = 0

  pub let kcpw_ok   : [u8; 25] = "G6 KIND_COLOR_PROFILE OK\0"
  pub let kcpw_fail : [u8; 27] = "G6 KIND_COLOR_PROFILE FAIL\0"

  pub let kind_color_profile_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G6.M1-001 (#1509): boot witness. Stages: (1) reset. (2) rights_valid. (3) colour_valid. (4) transfer_valid. (5) matrix_valid. (6) prim_valid. (7) has_icc_valid. (8) tail_alloc. (9) row accessors. (10) find_by_key.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        call cp_table_reset;

        // 2. rights.
        mov rax, 2;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call cp_rights_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 0x2000;
        call cp_rights_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 3. colour.
        mov rax, 3;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call cp_colour_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 22;
        call cp_colour_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 0;
        call cp_colour_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;
        mov rdi, 23;
        call cp_colour_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 4. transfer.
        mov rax, 4;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 13;
        call cp_transfer_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 0;
        call cp_transfer_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;
        mov rdi, 19;
        call cp_transfer_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 5. matrix.
        mov rax, 5;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call cp_matrix_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 14;
        call cp_matrix_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 15;
        call cp_matrix_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 6. prim.
        mov rax, 6;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        call cp_prim_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 4;
        call cp_prim_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 0;
        call cp_prim_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;
        mov rdi, 5;
        call cp_prim_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 7. has_icc.
        mov rax, 7;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call cp_has_icc_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 1;
        call cp_has_icc_valid;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, 2;
        call cp_has_icc_valid;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 8. tail_alloc: colour=1 (BT709), trans=13 (sRGB), matrix=0,
        //    prim=SRGB=1, has_icc=0, key=0xC0FFEEC0.
        mov rax, 8;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 13;
        mov rdx, 0;
        mov rcx, 1;
        mov r8, 0;
        call cp_body1_pack;
        mov r12, rax;
        mov rdi, 0;
        mov rsi, 0;
        call cp_body2_pack;
        mov r13, rax;
        mov rdi, 0;
        call cp_hdr_pack;
        mov rdi, rax;
        mov rsi, 0xC0FFEEC0;
        mov rdx, r12;
        mov rcx, r13;
        call cp_tail_alloc;
        cmp rax, 0;
        jne kcpw_fail_stage;
        mov r15, rax;

        // 9. Row accessors.
        mov rax, 9;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, r15;
        call cp_row_key;
        mov r10, 0xC0FFEEC0;
        cmp rax, r10;
        jne kcpw_fail_stage;
        mov rdi, r15;
        call cp_row_colour;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, r15;
        call cp_row_transfer;
        cmp rax, 13;
        jne kcpw_fail_stage;
        mov rdi, r15;
        call cp_row_matrix;
        cmp rax, 0;
        jne kcpw_fail_stage;
        mov rdi, r15;
        call cp_row_prim;
        cmp rax, 1;
        jne kcpw_fail_stage;
        mov rdi, r15;
        call cp_row_has_icc;
        cmp rax, 0;
        jne kcpw_fail_stage;

        // 10. find_by_key.
        mov rax, 10;
        lea rcx, [rip + _kcpw_stage];
        mov [rcx], rax;
        mov rdi, 0xC0FFEEC0;
        call cp_find_by_key;
        cmp rax, r15;
        jne kcpw_fail_stage;
        mov rdi, 0xDEADBEEF;
        call cp_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne kcpw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kcpw_ok];
        call klog_s1;

        call cp_table_reset;
        xor rax, rax;
        jmp kcpw_out;

      kcpw_fail_stage:
        lea rax, [rip + _kcpw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kcpw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call cp_table_reset;
        mov rax, 1;

      kcpw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
