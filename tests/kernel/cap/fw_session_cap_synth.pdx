// tests/kernel/cap/fw_session_cap_synth.pdx
//   R30.M8-002 (#1083) + R30.M8-003 (#1084)
//
// Boot witness for KIND_FW_SESSION: the two-part derivation gate, the
// shared-object property that makes arbitration possible at all, the
// writer claim with its recursion and its refusals, revoke, and then
// the concurrent-evaluation stress test that asserts LINEARIZABILITY.
//
// Fingerprint: `R30 KIND_FW_SESSION OK`.
//
// =====================================================================
// WHAT "LINEARIZABILITY" MEANS HERE, STATED BEFORE ANYTHING CLAIMS IT
// =====================================================================
// A property needs a definition before a test can assert it, and
// "linearizable" is a word that is easy to put in a commit message and
// hard to put in an assertion. This is the definition this file uses.
//
// THE OBJECT UNDER TEST is a single logical counter standing in for a
// firmware object's state — `_fws_w_value`.
//
// AN EPISODE is one session's read-modify-write against it, and it is
// deliberately FIVE separate steps rather than one:
//
//     CLAIM -> READ -> BUMP -> WRITE -> UNCLAIM
//
// The split is the whole point. A one-step "increment" cannot be
// interleaved and therefore cannot lose an update no matter how broken
// the arbitration is. With READ and WRITE as distinct steps, a
// scheduler can place another session's episode between them, which is
// exactly where a lost update comes from.
//
// A SESSION TRUSTS ITS OWN CLAIM. Steps 2..5 proceed if and only if the
// session recorded a SUCCESSFUL claim (`_fws_w_inep[s]`), not if the
// object's holder field happens to name it. That is what a real driver
// does — it asks for the claim, and if it is granted it proceeds — and
// modelling it any other way would build the arbitration's correctness
// into the harness instead of testing for it.
//
// THE ASSERTION IS THEN:
//
//   (L1)  MUTUAL EXCLUSION. At no point between any two steps is more
//         than one session inside an episode. Checked after EVERY step,
//         not at the end.
//
//   (L2)  NO LOST UPDATES. The object's final value equals the number
//         of completed WRITE steps. Each episode adds exactly one, so
//         the episodes admit a total order consistent with each
//         session's own program order — which is linearizability of the
//         arbitrated object, stated as something a machine can check.
//
//   (L3)  NON-VACUITY. The schedule actually contended: the number of
//         BLOCKED steps is greater than zero, and greater than the
//         number of sessions. Without this the other two are satisfied
//         by any schedule that happens to run sequentially, which is
//         the trap this test exists to avoid.
//
// A broken arbitration — one where a second claim on a held object
// succeeds — fails L1 immediately and L2 shortly after, because two
// sessions read the same value and both write it plus one.
//
// =====================================================================
// WHY THE SCHEDULE IS NOT ROUND-ROBIN
// =====================================================================
// A "concurrent" test that executes each evaluator to completion before
// starting the next proves nothing: with no overlap there is no
// interleaving, and no arbitration bug can manifest. Neither does a
// round-robin schedule chosen because it is easy to write — it produces
// SOME interleavings, but not necessarily the ones that break a naive
// implementation.
//
// So Phase A is DERIVED FROM THE FAILURE MODES and written out by hand,
// step by step. It contains the two interleavings that a naive
// implementation gets wrong:
//
//   (i)  TWO SESSIONS BOTH OBSERVE THE OBJECT FREE. S1 asks for the
//        claim while S0 holds it. A naive check-then-set grants both.
//        Steps 1-2 below.
//
//   (ii) A RELEASE LANDS BETWEEN ANOTHER SESSION'S CHECK AND ITS USE.
//        S1 is refused, S0 then releases, and S1 asks again and
//        succeeds. An implementation that cached the refusal, or that
//        left the holder field stale on release, gets this wrong in
//        opposite directions. Steps 8-9 below.
//
// Phase B is the ten-evaluator stress, and it interleaves at STEP
// granularity: every session attempts step k before any session
// attempts step k+1. The starting session rotates each pass, so each of
// the ten wins exactly one pass; without the rotation session 0 would
// win every pass and the other nine would never complete an episode,
// which would look like a passing test of a much weaker property.

module FwSessionCapSynth = structure {

  // ==========================================================================
  // Stage counter. On failure this identifies the section, and it is
  // emitted as `line=` on the FAIL line.
  // ==========================================================================
  pub let mut _fws_w_stage : u64 = 0

  // Per-session state. Index is the session number 0..9.
  pub let mut _fws_w_rows    : [u64; 16] = uninit @align(64)
  pub let mut _fws_w_slots   : [u64; 16] = uninit @align(64)
  pub let mut _fws_w_scratch : [u64; 16] = uninit @align(64)
  pub let mut _fws_w_inep    : [u64; 16] = uninit @align(64)

  // The arbitrated object and the stress accounting.
  //   +0 value   +8 writes   +16 blocked   +24 steps
  //   +32 max concurrent episodes observed
  pub let mut _fws_w_acct : [u64; 8] = uninit @align(64)

  // Two DISTINCT scope paths. They share a 12-byte prefix on purpose:
  // an identity comparison that stopped at a shared prefix, or at a NUL,
  // would merge these two objects and the arbitration of one would
  // exclude the other. Section E asserts they do not merge.
  pub let fws_w_path_a : [u8; 20] = "\\_SB.PCI0.LPCB.EC0\0\0"
  pub let fws_w_path_b : [u8; 20] = "\\_SB.PCI0.LPCB.EC1\0\0"

  pub let fws_ok_msg   : [u8; 24] = "R30 KIND_FW_SESSION OK\n\0"
  pub let fws_fail_msg : [u8; 26] = "R30 KIND_FW_SESSION FAIL\n\0"

  // Phase A: the hand-derived adversarial schedule. One byte per step,
  // (session << 4) | op. Ops: 0 CLAIM, 1 READ, 2 BUMP, 3 WRITE,
  // 4 UNCLAIM.
  //
  // Read it as a trace and the two failure modes are visible in it:
  //
  //   0x00  S0 CLAIM     granted
  //   0x10  S1 CLAIM     REFUSED  <- (i) both would observe it free
  //   0x01  S0 READ
  //   0x20  S2 CLAIM     REFUSED
  //   0x02  S0 BUMP
  //   0x11  S1 READ      BLOCKED  <- S1 never got the claim and must
  //                                  not proceed on a refusal
  //   0x03  S0 WRITE
  //   0x04  S0 UNCLAIM
  //   0x10  S1 CLAIM     granted  <- (ii) the release landed between
  //                                  S1's check and its use
  //   0x11  S1 READ
  //   0x00  S0 CLAIM     REFUSED
  //   0x12  S1 BUMP
  //   0x13  S1 WRITE
  //   0x14  S1 UNCLAIM
  pub let fws_w_sched_a : [u8; 14] = [
    0x00u8, 0x10u8, 0x01u8, 0x20u8, 0x02u8, 0x11u8, 0x03u8,
    0x04u8, 0x10u8, 0x11u8, 0x00u8, 0x12u8, 0x13u8, 0x14u8
  ]

  // ==========================================================================
  // fws_w_seed(slot, kind, rights, target_ptr) -- plant a base
  // capability. Goes through cap_mint_write, the sanctioned writer,
  // rather than storing to cap_table directly (see #1579).
  // ==========================================================================

  pub let fws_w_seed : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): plant one base capability for the fixture through cap_mint_write. A pass-through, existing so the witness body reads as a list of authorities rather than as four register moves repeated six times, and so the fixture cannot drift into writing descriptors by a route the mint does not use. Reserved labels: none.",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // fws_w_reset() -- clear the fixture's own arrays.
  // ==========================================================================

  pub let fws_w_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-003 (#1084): zero the per-session arrays and the stress accounting. Labels prefixed fws_wr_ per reserved-label discipline.",
      block: {
        xor rax, rax;
        xor r8, r8;
        lea rcx, [rip + _fws_w_rows];
        lea rdx, [rip + _fws_w_slots];
        lea r9,  [rip + _fws_w_scratch];
        lea r10, [rip + _fws_w_inep];
      fws_wr_loop:
        mov [rcx + r8*8], rax;
        mov [rdx + r8*8], rax;
        mov [r9  + r8*8], rax;
        mov [r10 + r8*8], rax;
        add r8, 1;
        cmp r8, 16;
        jb fws_wr_loop;

        lea rcx, [rip + _fws_w_acct];
        xor r8, r8;
      fws_wr_acct:
        mov [rcx + r8*8], rax;
        add r8, 1;
        cmp r8, 8;
        jb fws_wr_acct;
        ret
      }
    } @no_frame

  // ==========================================================================
  // fws_w_concurrent() -- how many sessions are inside an episode.
  //
  // (L1) is checked with this after EVERY step. Checking it only at the
  // end would pass trivially: every episode ends with an UNCLAIM, so the
  // final state is quiescent no matter how badly the middle behaved.
  // ==========================================================================

  pub let fws_w_concurrent : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-003 (#1084): count sessions currently inside an episode -- the (L1) mutual-exclusion observable. Read after every single step rather than at the end of the schedule, because every episode terminates with an UNCLAIM and the quiescent final state is therefore consistent with any amount of overlap in between. Labels prefixed fws_wc_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + _fws_w_inep];
        xor r8, r8;
        xor r9, r9;
      fws_wc_loop:
        mov rax, [rcx + r8*8];
        cmp rax, 0;
        je fws_wc_next;
        add r9, 1;
      fws_wc_next:
        add r8, 1;
        cmp r8, 16;
        jb fws_wc_loop;
        mov rax, r9;
        ret
      }
    } @no_frame

  // ==========================================================================
  // fws_w_step(session, op) -> 0 performed | 1 blocked
  //
  // ONE STEP OF ONE EVALUATOR. The schedule is a sequence of these, and
  // the whole concurrency argument is that the caller chooses the order.
  // ==========================================================================

  pub let fws_w_step : (u64, u64) -> u64 !{mem} @{cap} =
    fn (session: u64) (op: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-003 (#1084): perform one step of one evaluator's episode against the shared object. CLAIM asks fw_session_claim and records success in _fws_w_inep; every other step proceeds IF AND ONLY IF this session recorded a successful claim -- NOT if the object's holder field names it. That distinction is the test: a driver trusts the claim it was granted, so modelling the guard as 'the arbitration says I hold it' would build the property being tested into the harness and the test would pass against an arbitration that granted every request. READ copies the object value into the session's private scratch; BUMP increments the scratch; WRITE stores the scratch back and counts a completed write; UNCLAIM releases and clears the episode flag. The read and the write are SEPARATE STEPS so that another session's episode can be scheduled between them, which is the only place a lost update can come from. Blocked steps are counted, and (L3) asserts there were some -- a schedule that never contended would satisfy mutual exclusion and no-lost-updates trivially. r12=session, r13=op; two pushes plus an 8-byte pad leave rsp%16 == 0 at the nested call. Labels prefixed fws_ws_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;

        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 24];
        add rax, 1;
        mov [rcx + 24], rax;             // steps

        cmp r13, 0;
        je fws_ws_claim;

        // Every non-CLAIM step requires THIS SESSION to believe it is
        // inside an episode. It believes that because its claim was
        // granted, which is exactly what a driver would rely on.
        lea rcx, [rip + _fws_w_inep];
        mov rax, [rcx + r12*8];
        cmp rax, 0;
        je fws_ws_blocked;

        cmp r13, 1;
        je fws_ws_read;
        cmp r13, 2;
        je fws_ws_bump;
        cmp r13, 3;
        je fws_ws_write;
        cmp r13, 4;
        je fws_ws_unclaim;
        jmp fws_ws_blocked;

      fws_ws_claim:
        lea rcx, [rip + _fws_w_rows];
        mov rdi, [rcx + r12*8];
        call fw_session_claim;
        cmp rax, 0;
        jne fws_ws_blocked;              // refused: the session does NOT proceed
        lea rcx, [rip + _fws_w_inep];
        mov rax, 1;
        mov [rcx + r12*8], rax;
        jmp fws_ws_ok;

      fws_ws_read:
        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 0];
        lea rcx, [rip + _fws_w_scratch];
        mov [rcx + r12*8], rax;
        jmp fws_ws_ok;

      fws_ws_bump:
        lea rcx, [rip + _fws_w_scratch];
        mov rax, [rcx + r12*8];
        add rax, 1;
        mov [rcx + r12*8], rax;
        jmp fws_ws_ok;

      fws_ws_write:
        lea rcx, [rip + _fws_w_scratch];
        mov rax, [rcx + r12*8];
        lea rcx, [rip + _fws_w_acct];
        mov [rcx + 0], rax;              // the object's new value
        mov rax, [rcx + 8];
        add rax, 1;
        mov [rcx + 8], rax;              // completed writes
        jmp fws_ws_ok;

      fws_ws_unclaim:
        lea rcx, [rip + _fws_w_rows];
        mov rdi, [rcx + r12*8];
        call fw_session_unclaim;
        lea rcx, [rip + _fws_w_inep];
        xor rax, rax;
        mov [rcx + r12*8], rax;
        jmp fws_ws_ok;

      fws_ws_blocked:
        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 16];
        add rax, 1;
        mov [rcx + 16], rax;
        mov rax, 1;
        jmp fws_ws_out;

      fws_ws_ok:
        xor rax, rax;

      fws_ws_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // fws_w_step_checked(session, op) -> 0 ok | 1 THE INVARIANT BROKE
  //
  // A step, followed immediately by (L1). Everything in both phases goes
  // through here so that mutual exclusion is checked between every pair
  // of adjacent steps rather than at the ends of the schedule.
  // ==========================================================================

  pub let fws_w_step_checked : (u64, u64) -> u64 !{mem} @{cap} =
    fn (session: u64) (op: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-003 (#1084): one step, then (L1). Returns 1 iff more than one session is inside an episode -- the mutual-exclusion violation, reported as a FAILURE OF THE WITNESS rather than as a counter, because a single instant of overlap is a broken arbitration and averaging it into a statistic would let it pass. Also records the running maximum so a passing run can state what concurrency it actually observed, which is what makes the 'exactly 1' claim meaningful rather than merely unfalsified. Two pushes plus an 8-byte pad leave rsp%16 == 0 at both nested calls. Labels prefixed fws_wsc_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        call fws_w_step;

        call fws_w_concurrent;
        mov r12, rax;

        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 32];
        cmp r12, rax;
        jbe fws_wsc_nomax;
        mov [rcx + 32], r12;
      fws_wsc_nomax:
        cmp r12, 1;
        ja fws_wsc_broken;
        xor rax, rax;
        jmp fws_wsc_out;
      fws_wsc_broken:
        mov rax, 1;
      fws_wsc_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // THE WITNESS.
  // ==========================================================================

  pub let fw_session_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M8-002 (#1083) + R30.M8-003 (#1084): boot witness for KIND_FW_SESSION -- the two-part derivation gate in both directions, the shared-object property that makes arbitration possible, distinct-but-prefix-sharing scopes NOT merging, the writer claim with its recursion and its per-cause refusals, revoke including claim release and object-row reclamation -- followed by the ten-evaluator concurrent stress asserting (L1) mutual exclusion, (L2) no lost updates and (L3) non-vacuity. It drives the SHIPPING functions linked into the real kernel, not copies of them. Five pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 0 at every nested call; cross-call state lives in module .bss for the reason the stage counter does. Labels prefixed fws_w_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ================================================================
        // A. Reset.
        // ================================================================
        mov rax, 1;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        call fw_session_table_reset;
        call fws_w_reset;

        call fw_sessions_live;
        cmp rax, 0;
        jne fws_w_fail;
        call fw_objects_live;
        cmp rax, 0;
        jne fws_w_fail;

        // ================================================================
        // B. Base authorities.
        //
        // Slots 160..175, disjoint from every other witness's set
        // (46..55, 56..63, 64..79, 80..95, 110..117) and cleared at the
        // end so a later witness inherits nothing.
        //
        //   160  KIND_IPC_ENDPOINT, MINT, eid 7  — the supervisor's
        //   161  KIND_IPC_ENDPOINT, MINT, eid 9  — an ORDINARY endpoint
        //                                          (think: the shell's
        //                                          stdout). Right kind,
        //                                          right rights, and it
        //                                          must still be refused.
        //   162  KIND_IPC_ENDPOINT, INVOKE only  — right kind, no MINT
        //   163  KIND_PAGE (4), MINT             — the wrong kind
        //   164..173  the ten sessions on object A
        //   174  a session on the prefix-sharing scope B
        //   175  a session on scope A in a DIFFERENT domain
        // ================================================================
        mov rax, 2;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        mov rdi, 160;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 7;                      // endpoint_id 7
        call fws_w_seed;

        mov rdi, 161;
        mov rsi, 5;
        mov rdx, 0x200;
        mov rcx, 9;                      // endpoint_id 9 — NOT registered
        call fws_w_seed;

        mov rdi, 162;
        mov rsi, 5;
        mov rdx, 0x008;                  // INVOKE only — no MINT
        mov rcx, 7;
        call fws_w_seed;

        mov rdi, 163;
        mov rsi, 4;                      // KIND_PAGE
        mov rdx, 0x200;
        mov rcx, 7;
        call fws_w_seed;

        // Register endpoint 7 for domains 0 and 1 only. Endpoint 9 is
        // deliberately NOT registered: that is the second half of the
        // gate having something to refuse.
        mov rdi, 7;
        mov rsi, 3;                      // domains {0,1}
        call fw_ep_register;
        cmp rax, 0;
        jne fws_w_fail;

        // ================================================================
        // C. THE DERIVATION GATE, in both directions.
        // ================================================================
        mov rax, 3;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        // -- first half: the wrong kind is refused --
        mov rdi, 164;
        mov rsi, 163;                    // KIND_PAGE parent
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1E;             // FW_SESSION_MINT_BAD_PARENT
        cmp rax, r11;
        jne fws_w_fail;

        // -- first half: the right kind without MINT is refused --
        mov rdi, 164;
        mov rsi, 162;
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1E;
        cmp rax, r11;
        jne fws_w_fail;

        // -- THE SECOND HALF. An ordinary KIND_IPC_ENDPOINT carrying
        //    RIGHT_MINT passes the first half completely and is refused
        //    here. This is the assertion that the kind check alone is
        //    not the gate. --
        mov rdi, 164;
        mov rsi, 161;                    // eid 9 — never registered
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1C;             // FW_SESSION_MINT_NO_EP
        cmp rax, r11;
        jne fws_w_fail;

        // -- and a REGISTERED endpoint asking for a domain it was not
        //    registered for is refused by the same code. Endpoint 7 has
        //    domains {0,1}; domain 2 is not its. --
        mov rdi, 164;
        mov rsi, 160;
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 2;                       // a domain it does not hold
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1C;
        cmp rax, r11;
        jne fws_w_fail;

        // -- rights outside the mask are refused --
        mov rdi, 164;
        mov rsi, 160;
        mov rdx, 0x200;                  // RIGHT_MINT: this kind is a leaf
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1D;             // FW_SESSION_MINT_BAD_RIGHTS
        cmp rax, r11;
        jne fws_w_fail;

        // -- a malformed scope is refused per reason --
        mov rdi, 164;
        mov rsi, 160;
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 0;                       // zero-length path
        mov r9, 0;
        call fw_session_cap_mint;
        mov r11, 0xFFFFFE1A;             // FW_SESSION_MINT_BAD_SCOPE
        cmp rax, r11;
        jne fws_w_fail;

        // -- nothing was allocated by any of those refusals --
        call fw_sessions_live;
        cmp rax, 0;
        jne fws_w_fail;
        call fw_objects_live;
        cmp rax, 0;
        jne fws_w_fail;

        // ================================================================
        // D. Ten sessions on ONE object.
        //
        // THE SHARED-OBJECT PROPERTY. Ten capabilities, one firmware
        // object, ONE object row. If the mint allocated a row per
        // capability, each session would arbitrate against its own claim
        // and every claim would succeed -- and every other assertion in
        // sections E and F would still pass right up to (L1).
        // ================================================================
        mov rax, 4;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        xor r12, r12;                    // session index
      fws_w_mint_loop:
        mov rdi, r12;
        add rdi, 164;                    // cap slots 164..173
        mov rsi, 160;
        mov rdx, 0x00B;                  // READ|WRITE|INVOKE
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        cmp rax, 0;
        jne fws_w_fail;

        // record the slot and the row the descriptor now names
        mov rax, r12;
        add rax, 164;
        lea rcx, [rip + _fws_w_slots];
        mov [rcx + r12*8], rax;

        mov rax, cap_table;
        mov r8, r12;
        add r8, 164;
        mov r9, r8;
        shl r8, 3;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and r10, r11;                    // row id
        lea rcx, [rip + _fws_w_rows];
        mov [rcx + r12*8], r10;

        add r12, 1;
        cmp r12, 10;
        jb fws_w_mint_loop;

        call fw_sessions_live;
        cmp rax, 10;
        jne fws_w_fail;

        // TEN SESSIONS, ONE OBJECT.
        call fw_objects_live;
        cmp rax, 1;
        jne fws_w_fail;

        // ================================================================
        // E. A DIFFERENT scope sharing a prefix does NOT merge.
        //
        // fws_w_path_a and fws_w_path_b agree on their first 17 bytes and
        // differ in the 18th. A comparison that stopped at a shared
        // prefix, or at a NUL, would resolve both to one object -- and
        // the claim on the EC would then exclude a writer on a device
        // that has nothing to do with it, while failing to exclude its
        // real peer.
        // ================================================================
        mov rax, 5;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        mov rdi, 174;
        mov rsi, 160;
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_b];
        mov r8, 18;
        mov r9, 0;
        call fw_session_cap_mint;
        cmp rax, 0;
        jne fws_w_fail;

        call fw_objects_live;
        cmp rax, 2;                      // TWO objects, not one
        jne fws_w_fail;

        // Same path, DIFFERENT domain, is also a different object: the
        // domain is part of the identity, not a decoration on it.
        mov rdi, 175;
        mov rsi, 160;
        mov rdx, 0x00B;
        lea rcx, [rip + fws_w_path_a];
        mov r8, 18;
        mov r9, 1;                       // domain 1, registered
        call fw_session_cap_mint;
        cmp rax, 0;
        jne fws_w_fail;

        call fw_objects_live;
        cmp rax, 3;
        jne fws_w_fail;

        // ================================================================
        // F. The claim: exclusion, recursion, and the refusals.
        // ================================================================
        mov rax, 6;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        lea rcx, [rip + _fws_w_rows];
        mov r12, [rcx + 0];              // session 0's row
        mov r13, [rcx + 8];              // session 1's row

        // release with nothing held is REFUSED, not a no-op
        mov rdi, r12;
        call fw_session_unclaim;
        mov r11, 0xFFFFFE16;             // FW_SESSION_CLAIM_NOT_HELD
        cmp rax, r11;
        jne fws_w_fail;

        mov rdi, r12;
        call fw_session_claim;
        cmp rax, 0;
        jne fws_w_fail;

        // A DIFFERENT session on the SAME object is refused.
        mov rdi, r13;
        call fw_session_claim;
        mov r11, 0xFFFFFE17;             // FW_SESSION_CLAIM_HELD
        cmp rax, r11;
        jne fws_w_fail;

        // THE SAME session re-entering SUCCEEDS and deepens.
        mov rdi, r12;
        call fw_session_claim;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, r12;
        call fw_session_row_obj;
        mov rdi, rax;
        call fw_object_depth;
        cmp rax, 2;
        jne fws_w_fail;

        // AN INNER RELEASE DOES NOT DROP THE CLAIM.
        mov rdi, r12;
        call fw_session_unclaim;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, r13;
        call fw_session_claim;
        mov r11, 0xFFFFFE17;
        cmp rax, r11;
        jne fws_w_fail;                  // still excluded, as it must be

        // The outer release drops it, and now the other session can have it.
        mov rdi, r12;
        call fw_session_unclaim;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, r13;
        call fw_session_claim;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, r13;
        call fw_session_unclaim;
        cmp rax, 0;
        jne fws_w_fail;

        // ================================================================
        // G. Phase A -- THE HAND-DERIVED ADVERSARIAL SCHEDULE.
        // ================================================================
        mov rax, 7;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        call fws_w_reset_acct;

        xor r14, r14;                    // schedule cursor
      fws_w_phase_a:
        lea rcx, [rip + fws_w_sched_a];
        add rcx, r14;
        xor rax, rax;
        mov_b rax, [rcx + 0];
        mov r15, rax;
        shr r15, 4;                      // session
        and rax, 0x0F;                   // op
        mov rdi, r15;
        mov rsi, rax;
        call fws_w_step_checked;
        cmp rax, 0;
        jne fws_w_fail;                  // (L1) broke
        add r14, 1;
        cmp r14, 14;
        jb fws_w_phase_a;

        // Two episodes completed; the object saw two increments and
        // exactly two writes.
        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 8];
        cmp rax, 2;
        jne fws_w_fail;
        mov rax, [rcx + 0];
        cmp rax, 2;
        jne fws_w_fail;
        // AND IT CONTENDED: four steps were refused or blocked.
        mov rax, [rcx + 16];
        cmp rax, 4;
        jne fws_w_fail;

        // ================================================================
        // H. Phase B -- TEN EVALUATORS, INTERLEAVED AT STEP GRANULARITY.
        //
        // for pass in 0..9:
        //   for op in 0..4:
        //     for i in 0..9:
        //       step((pass + i) mod 10, op)
        //
        // Every session attempts step k before any session attempts
        // step k+1, so the episodes overlap maximally. The rotation is
        // what spreads the wins: without it session 0 would claim first
        // in every pass and the other nine would never complete an
        // episode at all, which is a much weaker property wearing this
        // test's name.
        // ================================================================
        mov rax, 8;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        call fws_w_reset_acct;

        xor rbx, rbx;                    // pass
      fws_w_pass:
        xor r13, r13;                    // op
      fws_w_op:
        xor r14, r14;                    // i
      fws_w_sess:
        mov r15, rbx;
        add r15, r14;
        cmp r15, 10;
        jb fws_w_nomod;
        sub r15, 10;
      fws_w_nomod:
        mov rdi, r15;
        mov rsi, r13;
        call fws_w_step_checked;
        cmp rax, 0;
        jne fws_w_fail;                  // (L1) broke
        add r14, 1;
        cmp r14, 10;
        jb fws_w_sess;
        add r13, 1;
        cmp r13, 5;
        jb fws_w_op;
        add rbx, 1;
        cmp rbx, 10;
        jb fws_w_pass;

        // ---- (L2) NO LOST UPDATES ----
        lea rcx, [rip + _fws_w_acct];
        mov rax, [rcx + 0];              // the object's value
        mov rdx, [rcx + 8];              // completed writes
        cmp rax, rdx;
        jne fws_w_fail;

        // Ten passes, one winner each: ten episodes.
        cmp rdx, 10;
        jne fws_w_fail;

        // ---- (L3) NON-VACUITY ----
        // 500 steps were scheduled; only 50 could be performed, so 450
        // were blocked. An exact figure rather than "> 0": a schedule
        // that silently stopped contending would still clear a floor,
        // and the number of blocked steps is the one observable that
        // says the interleaving was as dense as it was designed to be.
        mov rax, [rcx + 24];
        mov rdx, 500;
        cmp rax, rdx;
        jne fws_w_fail;
        mov rax, [rcx + 16];
        mov rdx, 450;
        cmp rax, rdx;
        jne fws_w_fail;

        // ---- (L1), restated as the running maximum ----
        mov rax, [rcx + 32];
        cmp rax, 1;
        jne fws_w_fail;

        // Everything is quiescent.
        call fws_w_concurrent;
        cmp rax, 0;
        jne fws_w_fail;

        // ================================================================
        // I. Revoke: the claim is released, and the object row returns.
        // ================================================================
        mov rax, 9;
        lea rcx, [rip + _fws_w_stage];
        mov [rcx], rax;

        // A session holding the claim is revoked. Its claim must not
        // survive it -- a claim held by a dead session excludes every
        // other writer on that object forever.
        lea rcx, [rip + _fws_w_rows];
        mov r12, [rcx + 0];
        mov rdi, r12;
        call fw_session_claim;
        cmp rax, 0;
        jne fws_w_fail;

        mov rdi, 164;
        call fw_session_cap_revoke;
        cmp rax, 0;
        jne fws_w_fail;

        mov rdi, r12;
        call fw_session_row_obj;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fws_w_fail;                  // the row is gone

        // and the object is claimable again by a survivor
        lea rcx, [rip + _fws_w_rows];
        mov r13, [rcx + 8];
        mov rdi, r13;
        call fw_session_claim;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, r13;
        call fw_session_unclaim;
        cmp rax, 0;
        jne fws_w_fail;

        // a second revoke is idempotent, and says so
        mov rdi, 164;
        call fw_session_cap_revoke;
        mov r11, 0xFFFFFE13;             // WRONG_KIND: the descriptor is clear
        cmp rax, r11;
        jne fws_w_fail;

        // Revoke the remaining nine sessions on object A; the object row
        // must return to the pool at the last one and NOT before.
        mov r12, 1;
      fws_w_revoke_loop:
        mov rdi, r12;
        add rdi, 164;
        call fw_session_cap_revoke;
        cmp rax, 0;
        jne fws_w_fail;
        add r12, 1;
        cmp r12, 10;
        jb fws_w_revoke_loop;

        call fw_objects_live;
        cmp rax, 2;                      // B and the domain-1 object remain
        jne fws_w_fail;

        mov rdi, 174;
        call fw_session_cap_revoke;
        cmp rax, 0;
        jne fws_w_fail;
        mov rdi, 175;
        call fw_session_cap_revoke;
        cmp rax, 0;
        jne fws_w_fail;

        // NO ROW LEAKS. Both tables are empty again, which is what makes
        // a driver restart possible rather than a one-shot.
        call fw_objects_live;
        cmp rax, 0;
        jne fws_w_fail;
        call fw_sessions_live;
        cmp rax, 0;
        jne fws_w_fail;

        // Clear the four base authorities, so the next witness inherits
        // an empty set exactly as this one was handed one.
        mov r12, 160;
      fws_w_clear_loop:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call fws_w_seed;
        add r12, 1;
        cmp r12, 164;
        jb fws_w_clear_loop;

        // ================================================================
        // PASS.
        // ================================================================
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fws_ok_msg];
        call klog_s1;
        xor rax, rax;
        jmp fws_w_out;

      fws_w_fail:
        lea rax, [rip + _fws_w_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fws_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      fws_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fws_w_reset_acct : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-003 (#1084): zero the object value and the stress accounting between phases, leaving the session rows and capabilities intact. The per-session episode flags are cleared too: a phase that ended with a session still inside an episode would carry that into the next phase's (L1) check and report a violation the next phase did not cause. Labels prefixed fws_wra_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + _fws_w_acct];
        xor rax, rax;
        xor r8, r8;
      fws_wra_acct:
        mov [rcx + r8*8], rax;
        add r8, 1;
        cmp r8, 8;
        jb fws_wra_acct;

        lea rcx, [rip + _fws_w_inep];
        lea rdx, [rip + _fws_w_scratch];
        xor r8, r8;
      fws_wra_sess:
        mov [rcx + r8*8], rax;
        mov [rdx + r8*8], rax;
        add r8, 1;
        cmp r8, 16;
        jb fws_wra_sess;
        ret
      }
    } @no_frame
}
