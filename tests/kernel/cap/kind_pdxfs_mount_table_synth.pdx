// tests/kernel/cap/kind_pdxfs_mount_table_synth.pdx
//
// Boot witness for the R53-PREP-001 (#1728) KIND_PDXFS_MOUNT_TABLE
// derived-kind registration.  Substrate-mode arm: mints one KIND_PDXFS_
// MOUNT_TABLE row via kind_pdxfs_mount_table_mint against a synthetic
// KIND_MEMORY + RIGHT_MINT parent slot, reads back the row's kind
// field via kind_pdxfs_mount_table_kind, verifies it equals 0x1A5, and
// emits "KIND PDXFS MOUNT TABLE OK".
//
// =============================================================================
// SUBSTRATE-MODE POSTURE
// =============================================================================
//
// KIND_PDXFS_MOUNT_TABLE at R53-PREP-001 registers the ordinal + basic
// mint / revoke + bare cap-invoke handler only; the LIST / READ_ROW /
// APPEND_ROW walkers land in a follow-up R53 landing per the M-PREP
// scope wording in the issue brief.  This witness therefore exercises
// exactly what R53-PREP-001 lands: the mint path + the row's kind-
// field round-trip.  A future round can add LIST / READ_ROW body
// coverage to this same fixture at a stable pblkc-style fingerprint
// ordering position without disturbing the "KIND PDXFS MOUNT TABLE
// OK" line the R17 golden pins today.
//
// The parent slot the mint gate crosses is minted in-place at witness
// entry: a fresh KIND_MEMORY descriptor with rights RIGHT_MINT (0x200)
// installed at a fixed slot in the substrate cap-slot band the sibling
// PdxFS-block witnesses use (176 -- above the M5/M6/M7/M8 fixed range
// 172..175, so the pair coexist within one boot).  The mint hands
// back row_id = 0 (singleton posture, PMT_MAX = 1), which the witness
// then feeds back through kind_pdxfs_mount_table_kind to prove the
// header0 kind field round-trips as 0x1A5.
//
// =============================================================================
// FINGERPRINT CONTRACT
// =============================================================================
//
// One line, output-strip-clean (no round / milestone / issue tag, per
// design/policy/output-provenance-strip.md and the sibling cap-witness
// convention):
//
//   "KIND PDXFS MOUNT TABLE OK"
//
// Pinned by tests/r17/shell-shutdown.golden.
//
// =============================================================================
// LABEL RESERVATION
// =============================================================================
//
// All local labels prefixed `pmts_` (per reserved-label discipline; the
// pmt_ prefix is claimed by kind_pdxfs_mount_table.pdx itself, so this
// witness uses a distinct `pmts_` = "pmt synth" prefix to stay disjoint
// from the module's own body labels).

module KindPdxfsMountTableSynth = structure {

  // Fingerprint bytes.  Substrate mode is the only arm this file emits
  // today; a future LIVE arm (LIST / READ_ROW ops wired) can add its
  // own fingerprint line at a stable golden position after this one
  // without disturbing R17.
  pub let pmts_ok_msg : [u8; 27] = "KIND PDXFS MOUNT TABLE OK\0"
  pub let pmts_fail_msg : [u8; 32] = "KIND PDXFS MOUNT TABLE FAIL fp1\n"

  // ==========================================================================
  // kind_pdxfs_mount_table_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Substrate-mode arm.  Mints a synthetic KIND_MEMORY + RIGHT_MINT
  // parent at slot 176 via cap_mint_write, calls kind_pdxfs_mount_
  // table_mint(176, R_PMT_ALL), then feeds the returned row_id through
  // kind_pdxfs_mount_table_kind and asserts the readback equals 0x1A5.
  //
  // Stack alignment: caller invokes via `call` (rsp%16 == 8 on entry
  // per boot_continue_after_ring3 discipline).  One `push rbp` +
  // `push rbx` lands rsp%16 == 8; sub rsp, 8 aligns to 0 for the
  // klog_s1 / cap_mint_write / kind_pdxfs_mount_table_* nested calls.
  //
  // rbx holds row_id across the pmt_kind readback call so success and
  // failure paths both know the "which row was minted" for a future
  // extended-arm error message.
  //
  // Return: 0 (OK) on both a successful mint+readback and (per the
  // sibling block_cache_witness pattern) on the substrate-mode
  // fingerprint path.  Returns 1 (FAIL) only when the kind_pdxfs_
  // mount_table_kind readback disagrees with the constant 0x1A5 --
  // that would name a header-packing bug or a static clobber, both
  // of which the ec_confine_one gate + the fingerprint golden should
  // catch at build/boot time regardless.
  // ==========================================================================
  pub let kind_pdxfs_mount_table_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R53-PREP-001 (#1728) boot witness. Substrate-mode arm: mints a synthetic KIND_MEMORY + RIGHT_MINT parent at slot 176 via cap_mint_write (kind=KIND_PAGE=4, rights=RIGHT_MINT|RIGHT_INVOKE=0x208, target_ptr=0), calls kind_pdxfs_mount_table_mint(176, R_PMT_ALL=0x41B), reads back header0.kind via kind_pdxfs_mount_table_kind, asserts equals 0x1A5. Prologue rsp%16 == 8 on entry (post-call); push rbp + push rbx leaves rsp%16 == 8; sub rsp, 8 aligns to 0 for the nested cap_mint_write / kind_pdxfs_mount_table_mint / kind_pdxfs_mount_table_kind / klog_s1 calls. rbx holds row_id across the readback for a future extended arm; not consumed today. Effect {sysreg} + {mem} + capability {boot, cap} match the sibling witness rows (cap needed for the mint gate, sysreg + mem for klog_s1). Labels prefixed pmts_.",
      block: {
        push rbp;
        push rbx;
        sub  rsp, 8;

        // Stage synthetic KIND_MEMORY parent at slot 176.
        // cap_mint_write(slot=176, kind=4=KIND_PAGE=KIND_MEMORY,
        //                rights=0x208=RIGHT_MINT|RIGHT_INVOKE,
        //                target_ptr=0).
        mov rdi, 176;
        mov rsi, 4;                      // KIND_PAGE (== KIND_MEMORY)
        mov rdx, 0x208;                  // RIGHT_MINT (0x200) | RIGHT_INVOKE (0x008)
        xor rcx, rcx;                    // target_ptr = 0
        call cap_mint_write;

        // Mint one KIND_PDXFS_MOUNT_TABLE row.
        mov rdi, 176;                    // parent_slot
        mov rsi, 0x41B;                  // R_PMT_ALL
        call kind_pdxfs_mount_table_mint;

        // rax is row_id on success (0 for singleton) or a >= 0xFFFFED50
        // PMT_MINT_* sentinel on refusal.  Sanity: refuse anything
        // >= PMT_MAX (1) -- both the successful row_id (0) and every
        // failure sentinel disambiguate against this cutoff (row_id
        // values are 0..0, sentinels are all >= 0xFFFFED50).
        mov rbx, rax;
        cmp rax, 1;
        jae pmts_fail;

        // Read back header0.kind for row_id in rbx.
        mov rdi, rbx;
        call kind_pdxfs_mount_table_kind;

        // Assert readback == 0x1A5 (KIND_PDXFS_MOUNT_TABLE).  r11-stage
        // per §4 encoder-gap discipline.
        mov r11, 0x1A5;
        cmp rax, r11;
        jne pmts_fail;

        // Emit OK fingerprint.
        mov rdi, 3;                      // klog level INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pmts_ok_msg];
        call klog_s1;

        xor rax, rax;
        jmp pmts_out;

      pmts_fail:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pmts_fail_msg];
        call klog_s1;
        mov rax, 1;

      pmts_out:
        add rsp, 8;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
