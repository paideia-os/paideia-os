// tests/kernel/cap/audio_route_synth.pdx -- R33.M5-002 (#1158)
//
// Boot witness for KIND_AUDIO_ROUTE.
//
// Asserts the derivation gate over KIND_IPC_ENDPOINT, the source/dest
// pcm_stream validity checks, the self-loop refusal, the gain validator,
// the mint refusals, the SET_GAIN and SET_MUTE dynamic path, and revoke.
//
// Fingerprint: R33 KIND_AUDIO_ROUTE OK
//
// Cap slots 160..167.

module AudioRouteSynth = structure {

  pub let mut _ar_w_stage : u64 = 0

  // Trailing \n\0 (not just \0): klog_emit_core copies tag_ptr until NUL, and
  // the earlier off-by-one array size (23/25) TRUNCATED the terminator so
  // the copy ran on into the next .rodata symbol, merging this witness's
  // FAIL line with the next witness's OK ("R33 KIND_AUDIO_ROUTE FAILR31
  // KIND_BACKLIGHT OK"). The \n mirrors bl_w_ok_a's pattern.
  pub let ar_w_ok   : [u8; 21] = "KIND_AUDIO_ROUTE OK\n\0"
  pub let ar_w_fail : [u8; 23] = "KIND_AUDIO_ROUTE FAIL\n\0"

  pub let ar_w_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): clear cap_table slots 160..167. Labels prefixed ar_wc_.",
      block: {
        push rbx;
        mov rbx, 160;
      ar_wc_lp:
        cmp rbx, 168;
        jae ar_wc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp ar_wc_lp;
      ar_wc_done:
        pop rbx;
        ret
      }
    }

  pub let ar_w_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): reset the audio_route table + pcm_stream table + audio_clock table. Labels: none.",
      block: {
        push rbx;
        call audio_route_table_reset;
        call pcm_stream_table_reset;
        call audio_clock_table_reset;
        pop rbx;
        ret
      }
    }

  pub let ar_w_hw : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): synthetic KIND_HW at (slot, key, rights).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 14;                     // KIND_HW
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let ar_w_ep : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (eid: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): synthetic KIND_IPC_ENDPOINT at (slot, eid, rights).",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rcx, r13;
        call cap_mint_write;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let audio_route_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R33.M5-002 (#1158): boot witness for KIND_AUDIO_ROUTE. Validators, derivation gate, source/dest pcm_stream validity, self-loop, SET_GAIN + SET_MUTE dynamic paths, revoke. Both exits scrub. Labels prefixed ar_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        call ar_w_clear;
        call ar_w_scrub;

        // Setup: two KIND_AUDIO_CLOCK caps (slots 160, 161) via KIND_HW
        // parents (slots 162, 163), plus two KIND_PCM_STREAM caps
        // (slots 164, 165) via a KIND_IPC_ENDPOINT parent (slot 166),
        // plus a routing endpoint (slot 167).

        mov rdi, 162;
        mov rsi, 0xC301;
        mov rdx, 0x200;
        call ar_w_hw;
        mov rdi, 163;
        mov rsi, 0xC302;
        mov rdx, 0x200;
        call ar_w_hw;

        // clock A at slot 160.
        mov rdi, 160;
        mov rsi, 162;
        mov rdx, 0x41B;
        mov rcx, 1;                      // HDA_BCLK
        mov r8, 48000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // clock B at slot 161.
        mov rdi, 161;
        mov rsi, 163;
        mov rdx, 0x41B;
        mov rcx, 2;                      // PCH_GEN
        mov r8, 96000;
        call audio_clock_cap_mint_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // stream endpoint at slot 166.
        mov rdi, 166;
        mov rsi, 0x0301;
        mov rdx, 0x200;
        call ar_w_ep;

        // PCM stream A at slot 164, using clock A (160) and ring 0xB201.
        mov rdi, 1;
        mov rsi, 48000;
        mov rdx, 2;
        call pcm_stream_frc_pack;
        mov r15, rax;

        mov rdi, 164;
        mov rsi, 166;
        mov rdx, 0x41B;
        mov rcx, 160;
        mov r8, 0xB201;
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // PCM stream B at slot 165, using clock A (160) and ring 0xB202.
        mov rdi, 165;
        mov rsi, 166;
        mov rdx, 0x41B;
        mov rcx, 160;
        mov r8, 0xB202;
        mov r9, r15;
        call pcm_stream_cap_mint_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // routing endpoint at slot 167.
        mov rdi, 167;
        mov rsi, 0x0302;
        mov rdx, 0x200;
        call ar_w_ep;

        // S1: gain validator.
        mov rax, 10;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_route_gain_valid;
        cmp rax, 1;                      // 0 is valid
        jne ar_w_fail_stage;

        mov rdi, 0x7FFF;                 // +32767
        call audio_route_gain_valid;
        cmp rax, 1;
        jne ar_w_fail_stage;

        mov rdi, 0xFFFFFFFFFFFF8000;     // -32768 (sign-extended)
        call audio_route_gain_valid;
        cmp rax, 1;
        jne ar_w_fail_stage;

        mov rdi, 0x8000;                 // +32768 -- OUT of range positive
        call audio_route_gain_valid;
        cmp rax, 0;
        jne ar_w_fail_stage;

        mov rdi, 0xFFFFFFFFFFFF7FFF;     // -32769 -- OUT of range negative
        call audio_route_gain_valid;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // S2: mute validator.
        mov rax, 20;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        call audio_route_mute_valid;
        cmp rax, 1;
        jne ar_w_fail_stage;
        mov rdi, 1;
        call audio_route_mute_valid;
        cmp rax, 1;
        jne ar_w_fail_stage;
        mov rdi, 2;
        call audio_route_mute_valid;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // S3: mint refusals: BAD_SOURCE (source_slot names a non-PCM_STREAM).
        mov rax, 30;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        // body: src=166 (not a stream), dst=165, mute=0, gain=+100
        mov rdi, 166;
        mov rsi, 165;
        xor rdx, rdx;
        mov rcx, 100;
        call audio_route_body_pack;
        mov r14, rax;

        // Mint attempt (should refuse BAD_SOURCE via check).
        mov rdi, 160;                    // subject slot (reuse a scratch)
        mov rsi, 167;                    // routing endpoint parent
        mov rdx, 0x41B;
        mov rcx, 166;                    // BAD source
        mov r8, 165;                     // dest
        mov r9, r14;
        call audio_route_cap_mint_inner;
        mov r11, 0xFFFFFEEB;             // MINT_BAD_SOURCE
        cmp rax, r11;
        jne ar_w_fail_stage;

        // S4: mint refusals: SELF_LOOP.
        mov rax, 40;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        // body: src=164, dst=164, mute=0, gain=+100
        mov rdi, 164;
        mov rsi, 164;
        xor rdx, rdx;
        mov rcx, 100;
        call audio_route_body_pack;
        mov r14, rax;

        mov rdi, 160;                    // subject slot (any -- refused early)
        mov rsi, 167;
        mov rdx, 0x41B;
        mov rcx, 164;
        mov r8, 164;                     // SELF LOOP
        mov r9, r14;
        call audio_route_cap_mint_inner;
        mov r11, 0xFFFFFEE9;             // MINT_SELF_LOOP
        cmp rax, r11;
        jne ar_w_fail_stage;

        // S5: happy mint at slot 160 (reusing after audio_clock scrub).
        // Actually slot 160 still holds audio_clock -- need a fresh subject.
        // Re-clear slot 160.
        mov rdi, 160;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        // We also cleared the audio_clock cap on slot 160, but its row
        // remains — PCM streams that reference clock slot 160 continue
        // to work because the pcm_stream row records the slot number.
        // For the audio_route cap, we can use slot 160 now.

        mov rax, 50;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        // body: src=164, dst=165, mute=0, gain=+500
        mov rdi, 164;
        mov rsi, 165;
        xor rdx, rdx;
        mov rcx, 500;
        call audio_route_body_pack;
        mov r14, rax;

        mov rdi, 160;                    // subject slot
        mov rsi, 167;                    // routing endpoint parent
        mov rdx, 0x41B;
        mov rcx, 164;
        mov r8, 165;
        mov r9, r14;
        call audio_route_cap_mint_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // S6: query row fields.
        mov rax, 60;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        mov rdi, 160;
        call audio_route_source_of_slot;
        cmp rax, 164;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_dest_of_slot;
        cmp rax, 165;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_gain_of_slot;
        cmp rax, 500;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_mute_of_slot;
        cmp rax, 0;
        jne ar_w_fail_stage;

        // S7: SET_GAIN dynamic path.
        mov rax, 70;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        mov rdi, 160;
        mov rsi, 1000;
        call audio_route_set_gain;
        cmp rax, 0;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_gain_of_slot;
        cmp rax, 1000;
        jne ar_w_fail_stage;

        // SET_GAIN with bad value (out of Q15 range).
        mov rdi, 160;
        mov rsi, 0x8000;                 // +32768 out of range
        call audio_route_set_gain;
        mov r11, 0xFFFFFEE8;             // BAD_GAIN
        cmp rax, r11;
        jne ar_w_fail_stage;

        // Source and dest did not change.
        mov rdi, 160;
        call audio_route_source_of_slot;
        cmp rax, 164;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_dest_of_slot;
        cmp rax, 165;
        jne ar_w_fail_stage;

        // S8: SET_MUTE dynamic path.
        mov rax, 80;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        mov rdi, 160;
        mov rsi, 1;
        call audio_route_set_mute;
        cmp rax, 0;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_mute_of_slot;
        cmp rax, 1;
        jne ar_w_fail_stage;

        // SET_MUTE with bad value.
        mov rdi, 160;
        mov rsi, 2;
        call audio_route_set_mute;
        mov r11, 0xFFFFFEE1;             // BAD_MUTE
        cmp rax, r11;
        jne ar_w_fail_stage;

        // S9: revoke.
        mov rax, 90;
        lea rcx, [rip + _ar_w_stage];
        mov [rcx], rax;

        mov rdi, 160;
        call audio_route_cap_revoke_inner;
        cmp rax, 0;
        jne ar_w_fail_stage;

        mov rdi, 160;
        call audio_route_cap_revoke_inner;
        mov r11, 0xFFFFFEE2;             // REVOKE_ALREADY
        cmp rax, r11;
        jne ar_w_fail_stage;

        // Success.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ar_w_ok];
        call klog_s1;

        call ar_w_scrub;
        call ar_w_clear;
        xor rax, rax;
        jmp ar_w_out;

      ar_w_fail_stage:
        lea rax, [rip + _ar_w_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ar_w_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call ar_w_scrub;
        call ar_w_clear;
        mov rax, 1;

      ar_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
