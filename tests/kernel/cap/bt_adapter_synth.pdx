// tests/kernel/cap/bt_adapter_synth.pdx — R39.M1-002 (#1324)
//
// Boot witness for KIND_BT_ADAPTER.
//
// Asserts derivation gate over KIND_DEVICE, vendor / iface / hci_ver
// validators, rights subset refuse, uniqueness on adapter_key, FSM
// transition discipline, mint / revoke round-trip.
//
// Fingerprint: R39 KIND_BT_ADAPTER OK
//
// Cap slots 112..127.

module BtAdapterSynth = structure {

  pub let mut _kbaw_stage : u64 = 0

  pub let kbaw_ok   : [u8; 20] = "KIND_BT_ADAPTER OK\n\0"
  pub let kbaw_fail : [u8; 22] = "KIND_BT_ADAPTER FAIL\n\0"

  pub let kbaw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): clear cap_table slots 112..127.",
      block: {
        push rbx;
        mov rbx, 112;
      kbawc_loop:
        cmp rbx, 128;
        jae kbawc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kbawc_loop;
      kbawc_done:
        pop rbx;
        ret
      }
    }

  pub let kbaw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): reset BT ADAPTER row table.",
      block: {
        call bt_adapter_table_reset;
        ret
      }
    }

  pub let kbaw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let bt_adapter_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R39.M1-002 (#1324): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_VENDOR (zero). (4) BAD_IFACE (> max). (5) BAD_HCI_VERSION (< 6). (6) BAD_STATE (non-zero at mint). (7) BAD_RIGHTS. (8) Happy path. (9) Query fields. (10) IN_USE. (11) Transition RESET->INIT. (12) Bad transition (RESET->RUNNING skipping INIT). (13) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        call kbaw_clear;
        call kbaw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kba_state_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 3;
        call kba_state_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 4;
        call kba_state_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // hci_ver valid
        mov rdi, 6;
        call kba_hci_ver_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 13;
        call kba_hci_ver_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 5;
        call kba_hci_ver_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;
        mov rdi, 14;
        call kba_hci_ver_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // iface_valid
        mov rdi, 0;
        call kba_iface_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 3;
        call kba_iface_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;
        mov rdi, 4;
        call kba_iface_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // vendor_valid
        mov rdi, 0;
        call kba_vendor_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;
        mov r15, 0x8086;
        mov rdi, r15;
        call kba_vendor_valid;
        cmp rax, 1;
        jne kbaw_fail_stage;

        // rights_valid: R_MINT outside mask
        mov rdi, 0x200;
        call kba_rights_valid;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // Setup: KIND_DEVICE at slot 113.
        mov rdi, 113;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call kbaw_seed_device;

        // packed_cfg = device_slot[15:0] | vendor[31:16] | iface[39:32]
        //            | state[47:40] | hci_ver[55:48].
        // device_slot=113, vendor=0x8086, iface=1 (CNVi), state=0 (RESET), hci_ver=13 (5.4).
        // = 113 | (0x8086 << 16) | (1 << 32) | (0 << 40) | (13 << 48)
        // = 0x000D_0001_8086_0071
        mov r15, 0x000D000180860071;

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 112;                    // empty parent
        mov rdx, 0x419;
        mov rcx, 0xB100D001;
        mov r8, r15;
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF14D;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 3. BAD_VENDOR (vendor=0).
        mov rax, 3;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D002;
        mov r8, 0x000D000100000071;      // vendor=0
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF14A;             // MINT_BAD_VENDOR
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 4. BAD_IFACE (iface > 3).
        mov rax, 4;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D003;
        mov r8, 0x000D000480860071;      // iface=4
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF149;             // MINT_BAD_IFACE
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 5. BAD_HCI_VERSION (hci_ver < 6).
        mov rax, 5;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D004;
        mov r8, 0x0005000180860071;      // hci_ver=5 (< 6)
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF147;             // MINT_BAD_HCI_VERSION
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 6. BAD_STATE (state != RESET at mint).
        mov rax, 6;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D005;
        mov r8, 0x000D010180860071;      // state=1 (INIT)
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF148;             // MINT_BAD_STATE
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 7. BAD_RIGHTS (bit outside R_KBA_ALL).
        mov rax, 7;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x819;                  // 0x800 outside 0x419
        mov rcx, 0xB100D006;
        mov r8, r15;
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF14C;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 8. Happy path.
        mov rax, 8;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D007;
        mov r8, r15;
        call bt_adapter_cap_mint_inner;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // -- 9. Query fields.
        mov rax, 9;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kba_row_key;
        mov r11, 0xB100D007;
        cmp rax, r11;
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_device;
        cmp rax, 113;
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_vendor;
        mov r11, 0x8086;
        cmp rax, r11;
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_iface;
        cmp rax, 1;
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_state;
        cmp rax, 0;                      // RESET
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_hci_ver;
        cmp rax, 13;                     // 5.4
        jne kbaw_fail_stage;

        // -- 10. IN_USE (duplicate adapter_key).
        mov rax, 10;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 115;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D007;             // same key
        mov r8, r15;
        call bt_adapter_cap_mint_inner;
        mov r11, 0xFFFFF144;             // MINT_IN_USE
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 11. Transition RESET -> INIT.
        mov rax, 11;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // INIT
        call kba_row_transition;
        cmp rax, 0;
        jne kbaw_fail_stage;

        mov rdi, 0;
        call kba_row_state;
        cmp rax, 1;
        jne kbaw_fail_stage;

        // -- 12. Bad transition INIT -> ERROR (must go via RUNNING).
        mov rax, 12;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 3;                      // ERROR (illegal from INIT)
        call kba_row_transition;
        mov r11, 0xFFFFF140;             // BAD_TRANSITION
        cmp rax, r11;
        jne kbaw_fail_stage;

        // -- 13. Revoke round-trip.
        mov rax, 13;
        lea rcx, [rip + _kbaw_stage];
        mov [rcx], rax;

        mov rdi, 114;
        call bt_adapter_cap_revoke_inner;
        cmp rax, 0;
        jne kbaw_fail_stage;

        mov rdi, 114;
        mov rsi, 113;
        mov rdx, 0x419;
        mov rcx, 0xB100D007;             // key free after revoke
        mov r8, r15;
        call bt_adapter_cap_mint_inner;
        cmp rax, 0;
        jne kbaw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbaw_ok];
        call klog_s1;

        call kbaw_scrub;
        call kbaw_clear;
        xor rax, rax;
        jmp kbaw_out;

      kbaw_fail_stage:
        lea rax, [rip + _kbaw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kbaw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kbaw_scrub;
        call kbaw_clear;
        mov rax, 1;

      kbaw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
