// tests/kernel/cap/wifi_phy_synth.pdx — R38.M3-001 (#1299)
//
// Boot witness for KIND_WIFI_PHY.
//
// Asserts derivation gate over KIND_DEVICE, device_slot gate, bands
// refusal, rights subset refuse, uniqueness on phy_key, mint/revoke
// round-trip.
//
// Fingerprint: R38 KIND_WIFI_PHY OK
//
// Cap slots 160..171 (remapped from 420..431 to fit CAP_SLOT_MAX=256).

module WifiPhySynth = structure {

  pub let mut _wphyw_stage : u64 = 0

  pub let wphyw_ok   : [u8; 22] = "R38 KIND_WIFI_PHY OK\n\0"
  pub let wphyw_fail : [u8; 24] = "R38 KIND_WIFI_PHY FAIL\n\0"

  pub let wphyw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): clear cap_table slots 160..171.",
      block: {
        push rbx;
        mov rbx, 160;
      wphywc_loop:
        cmp rbx, 172;
        jae wphywc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp wphywc_loop;
      wphywc_done:
        pop rbx;
        ret
      }
    }

  pub let wphyw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): reset WIFI PHY row table.",
      block: {
        call wifi_phy_table_reset;
        ret
      }
    }

  pub let wphyw_seed_device : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): synthetic KIND_DEVICE at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let wifi_phy_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R38.M3-001 (#1299): boot witness. Stages: (1) rights_valid + bands_valid. (2) BAD_PARENT. (3) BAD_DEVICE. (4) BAD_BANDS. (5) BAD_RIGHTS. (6) Happy path. (7) Query fields. (8) IN_USE. (9) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        call wphyw_clear;
        call wphyw_scrub;

        // -- 1. Validators.
        mov rdi, 0x419;
        call wphy_rights_valid;
        cmp rax, 1;
        jne wphyw_fail_stage;
        mov rdi, 0x200;                  // R_MINT outside mask
        call wphy_rights_valid;
        cmp rax, 0;
        jne wphyw_fail_stage;
        mov rdi, 0x03;                   // 2.4+5 GHz
        call wphy_bands_valid;
        cmp rax, 1;
        jne wphyw_fail_stage;
        mov rdi, 0;                      // zero refused
        call wphy_bands_valid;
        cmp rax, 0;
        jne wphyw_fail_stage;
        mov rdi, 0x10;                   // outside [2:0]
        call wphy_bands_valid;
        cmp rax, 0;
        jne wphyw_fail_stage;

        // Setup: KIND_DEVICE parent at 161 with R_MINT, and KIND_DEVICE
        // named by device_slot at 162 (no rights required).
        mov rdi, 161;
        mov rsi, 0x200;
        mov rdx, 0x0042;
        call wphyw_seed_device;

        mov rdi, 162;
        mov rsi, 0;
        mov rdx, 0x1234;
        call wphyw_seed_device;

        // packed_cfg: device_slot=162 (0xA2), hw_id=0x51F0, bands=0x07,
        // channels=32, regdom=0x03A9.
        //   [15:0]  = 0x00A2
        //   [31:16] = 0x51F0
        //   [39:32] = 0x07
        //   [47:40] = 0x20
        //   [63:48] = 0x03A9
        // Build packed_cfg in r15 by shifting fields into position:
        mov r15, 0x03A9;
        shl r15, 8;
        or  r15, 0x20;                   // channels
        shl r15, 8;
        or  r15, 0x07;                   // bands
        shl r15, 16;
        or  r15, 0x51F0;                 // hw_id
        shl r15, 16;
        or  r15, 0x00A2;                 // device_slot=162

        // -- 2. BAD_PARENT.
        mov rax, 2;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 160;                    // empty parent
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE10;
        mov r8, r15;
        call wifi_phy_cap_mint_inner;
        mov r11, 0xFFFFF47D;
        cmp rax, r11;
        jne wphyw_fail_stage;

        // -- 3. BAD_DEVICE (device_slot 165 is empty).
        mov rax, 3;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE11;
        // packed_cfg with device_slot=165 (empty)
        mov r8, 0x03A9;
        shl r8, 8;
        or  r8, 0x20;
        shl r8, 8;
        or  r8, 0x07;
        shl r8, 16;
        or  r8, 0x51F0;
        shl r8, 16;
        or  r8, 0x00A5;                  // device_slot=165
        call wifi_phy_cap_mint_inner;
        mov r11, 0xFFFFF47B;
        cmp rax, r11;
        jne wphyw_fail_stage;

        // -- 4. BAD_BANDS (bits outside [2:0]).
        mov rax, 4;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE12;
        mov r8, 0x03A9;
        shl r8, 8;
        or  r8, 0x20;
        shl r8, 8;
        or  r8, 0x10;                    // bands = 0x10 (illegal)
        shl r8, 16;
        or  r8, 0x51F0;
        shl r8, 16;
        or  r8, 0x00A2;
        call wifi_phy_cap_mint_inner;
        mov r11, 0xFFFFF479;
        cmp rax, r11;
        jne wphyw_fail_stage;

        // -- 5. BAD_RIGHTS (bit outside R_WPHY_ALL).
        mov rax, 5;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x800;                  // outside 0x419
        mov rcx, 0xC0FFEE13;
        mov r8, r15;
        call wifi_phy_cap_mint_inner;
        mov r11, 0xFFFFF47C;
        cmp rax, r11;
        jne wphyw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE14;
        mov r8, r15;
        call wifi_phy_cap_mint_inner;
        cmp rax, 0;
        jne wphyw_fail_stage;

        // -- 7. Query fields.
        mov rax, 7;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call wphy_row_key;
        mov r11, 0xC0FFEE14;
        cmp rax, r11;
        jne wphyw_fail_stage;

        mov rdi, 0;
        call wphy_row_device;
        cmp rax, 162;
        jne wphyw_fail_stage;

        mov rdi, 0;
        call wphy_row_hw_id;
        cmp rax, 0x51F0;
        jne wphyw_fail_stage;

        mov rdi, 0;
        call wphy_row_bands;
        cmp rax, 0x07;
        jne wphyw_fail_stage;

        mov rdi, 0;
        call wphy_row_channels;
        cmp rax, 0x20;
        jne wphyw_fail_stage;

        mov rdi, 0;
        call wphy_row_regdom;
        cmp rax, 0x03A9;
        jne wphyw_fail_stage;

        // -- 8. IN_USE.
        mov rax, 8;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 164;
        mov rsi, 161;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE14;             // duplicate key
        mov r8, r15;
        call wifi_phy_cap_mint_inner;
        mov r11, 0xFFFFF476;
        cmp rax, r11;
        jne wphyw_fail_stage;

        // -- 9. Revoke round-trip.
        mov rax, 9;
        lea rcx, [rip + _wphyw_stage];
        mov [rcx], rax;

        mov rdi, 163;
        call wifi_phy_cap_revoke_inner;
        cmp rax, 0;
        jne wphyw_fail_stage;

        mov rdi, 163;
        mov rsi, 161;
        mov rdx, 0x419;
        mov rcx, 0xC0FFEE14;             // key free after revoke
        mov r8, r15;
        call wifi_phy_cap_mint_inner;
        cmp rax, 0;
        jne wphyw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wphyw_ok];
        call klog_s1;

        call wphyw_scrub;
        call wphyw_clear;
        xor rax, rax;
        jmp wphyw_out;

      wphyw_fail_stage:
        lea rax, [rip + _wphyw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wphyw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call wphyw_scrub;
        call wphyw_clear;
        mov rax, 1;

      wphyw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
