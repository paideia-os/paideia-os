// tests/kernel/cap/kind_vello_renderer_synth.pdx -- G4.M1-003 (#1477)
//
// Boot witness for KIND_VELLO_RENDERER. Exercises table reset,
// validators, tail_alloc, row accessors, cursor advance,
// find_by_key, tail_free.
//
// Fingerprint: G4 KIND_VELLO_RENDERER OK

module KindVelloRendererSynth = structure {

  pub let mut _vrsw_stage : u64 = 0

  pub let vrsw_ok   : [u8; 27] = "G4 KIND_VELLO_RENDERER OK\n\0"
  pub let vrsw_fail : [u8; 29] = "G4 KIND_VELLO_RENDERER FAIL\n\0"

  pub let kind_vello_renderer_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G4.M1-003 (#1477): boot witness. Stages: (1) reset. (2) rights_valid. (3) tile_valid. (4) samples_valid. (5) coarse_valid. (6) caps_valid. (7) body1_pack + hdr_pack. (8) tail_alloc. (9) row accessors. (10) advance_cursor monotone. (11) find_by_key. (12) tail_free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        call vr_table_reset;

        // 2. rights_valid.
        mov rax, 2;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0x619;
        call vr_rights_valid;
        cmp rax, 1;
        jne vrsw_fail_stage;

        // 3. tile_valid: 16 ok, 24 no.
        mov rax, 3;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 16;
        call vr_tile_valid;
        cmp rax, 1;
        jne vrsw_fail_stage;
        mov rdi, 24;
        call vr_tile_valid;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 4. samples_valid: 8 ok, 6 no.
        mov rax, 4;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 8;
        call vr_samples_valid;
        cmp rax, 1;
        jne vrsw_fail_stage;
        mov rdi, 6;
        call vr_samples_valid;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 5. coarse_valid: 3 ok, 4 no.
        mov rax, 5;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 3;
        call vr_coarse_valid;
        cmp rax, 1;
        jne vrsw_fail_stage;
        mov rdi, 4;
        call vr_coarse_valid;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 6. caps_valid.
        mov rax, 6;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0xFF;
        call vr_caps_valid;
        cmp rax, 1;
        jne vrsw_fail_stage;
        mov rdi, 0x100;
        call vr_caps_valid;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 7. body1 + hdr pack.
        mov rax, 7;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 20;                      // ctx_slot
        mov rsi, 16;                      // tile_size
        mov rdx, 4;                       // sample_count
        mov rcx, 2;                       // coarsening_level
        call vr_body1_pack;
        mov r12, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  vrsw_fail_stage;

        mov rdi, 6;                       // parent_slot
        mov rsi, 0x00FF;                  // caps
        call vr_hdr_pack;
        mov r13, rax;
        cmp r13, r10;
        je  vrsw_fail_stage;

        // 8. tail_alloc: row 0.
        mov rax, 8;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, r13;
        mov rsi, 0xCAFE00;
        mov rdx, r12;
        call vr_tail_alloc;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 9. row accessors.
        mov rax, 9;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vr_row_key;
        mov r10, 0xCAFE00;
        cmp rax, r10;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_ctx;
        cmp rax, 20;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_tile_size;
        cmp rax, 16;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_samples;
        cmp rax, 4;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_coarse;
        cmp rax, 2;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_caps;
        cmp rax, 0xFF;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_cursor;
        cmp rax, 0;
        jne vrsw_fail_stage;

        // 10. cursor advance monotone.
        mov rax, 10;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vr_row_advance_cursor;
        cmp rax, 1;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_advance_cursor;
        cmp rax, 2;
        jne vrsw_fail_stage;
        mov rdi, 0;
        call vr_row_cursor;
        cmp rax, 2;
        jne vrsw_fail_stage;

        // 11. find_by_key.
        mov rax, 11;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0xCAFE00;
        call vr_find_by_key;
        cmp rax, 0;
        jne vrsw_fail_stage;
        mov rdi, 0xDEAD;
        call vr_find_by_key;
        cmp rax, 0xFF;
        jne vrsw_fail_stage;

        // 12. tail_free.
        mov rax, 12;
        lea rcx, [rip + _vrsw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call vr_tail_free;
        mov rdi, 0;
        call vr_tail_valid;
        cmp rax, 0;
        jne vrsw_fail_stage;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrsw_ok];
        call klog_s1;

        call vr_table_reset;
        xor rax, rax;
        jmp vrsw_out;

      vrsw_fail_stage:
        lea rax, [rip + _vrsw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + vrsw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call vr_table_reset;
        mov rax, 1;

      vrsw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
