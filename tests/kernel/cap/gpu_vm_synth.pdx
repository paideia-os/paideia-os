// tests/kernel/cap/gpu_vm_synth.pdx — R37.M4-001 (#1267)
//
// Boot witness for KIND_GPU_VM.
//
// Asserts derivation gate over KIND_IPC_ENDPOINT, pml4 alignment,
// space_id range, R_MINT refusal (LEAF), uniqueness on vm_key, state
// transition discipline, and mint / revoke round-trip.
//
// Fingerprint: R37 KIND_GPU_VM OK
//
// Cap slots 144..159.

module GpuVmSynth = structure {

  pub let mut _kgvmw_stage : u64 = 0

  pub let kgvmw_ok   : [u8; 20] = "R37 KIND_GPU_VM OK\n\0"
  pub let kgvmw_fail : [u8; 22] = "R37 KIND_GPU_VM FAIL\n\0"

  pub let kgvmw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): clear cap_table slots 144..159.",
      block: {
        push rbx;
        mov rbx, 144;
      kgvmwc_loop:
        cmp rbx, 160;
        jae kgvmwc_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp kgvmwc_loop;
      kgvmwc_done:
        pop rbx;
        ret
      }
    }

  pub let kgvmw_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): reset GPU VM row table.",
      block: {
        call gpu_vm_table_reset;
        ret
      }
    }

  pub let kgvmw_endpoint : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): synthetic KIND_IPC_ENDPOINT at slot.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let gpu_vm_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R37.M4-001 (#1267): boot witness. Stages: (1) validators. (2) BAD_PARENT. (3) BAD_ROOT (unaligned pml4). (4) BAD_SPACE (0). (5) BAD_RIGHTS (R_MINT trip is refused). (6) Happy path. (7) Query fields. (8) IN_USE. (9) Transition NEW->ACTIVE. (10) Bad transition (ACTIVE->NEW refused). (11) Revoke round-trip.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, 1;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        call kgvmw_clear;
        call kgvmw_scrub;

        // -- 1. Validators.
        mov rdi, 0;
        call kgvm_state_valid;
        cmp rax, 1;
        jne kgvmw_fail_stage;
        mov rdi, 3;
        call kgvm_state_valid;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        mov rdi, 0x1000;
        call kgvm_pml4_valid;
        cmp rax, 1;
        jne kgvmw_fail_stage;
        mov rdi, 0x1001;                 // misaligned
        call kgvm_pml4_valid;
        cmp rax, 0;
        jne kgvmw_fail_stage;
        mov rdi, 0;
        call kgvm_pml4_valid;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        mov rdi, 1;
        call kgvm_space_valid;
        cmp rax, 1;
        jne kgvmw_fail_stage;
        mov rdi, 0;
        call kgvm_space_valid;
        cmp rax, 0;
        jne kgvmw_fail_stage;
        mov rdi, 0x10000;                // out of u16
        call kgvm_space_valid;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        // Setup: KIND_IPC_ENDPOINT at 145, target_ptr encoded so
        // endpoint_id[15:0] is non-zero (=0x0042).
        mov rdi, 145;
        mov rsi, 0x200;                  // R_MINT so it can be a parent
        mov rdx, 0x0042;
        call kgvmw_endpoint;

        // packed_ss_pml4 = space_id | (pml4_frame_idx << 16).
        // Pick pml4_pa = 0x100000 -> frame idx = 0x100.
        // Packed = 0x0001 | (0x100 << 16) = 0x01000001.
        mov r15, 0x01000001;

        // -- 2. BAD_PARENT (parent slot empty).
        mov rax, 2;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 146;
        mov rsi, 144;                    // empty parent
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE01;
        mov r8, r15;
        call gpu_vm_cap_mint_inner;
        mov r11, 0xFFFFF5FD;             // MINT_BAD_PARENT
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 3. BAD_ROOT (unaligned pml4).
        mov rax, 3;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        // packed encoded with pml4 frame index 0x100 but va = 0x100001
        // (unaligned): pml4_pa = (packed >> 16) << 12.  We craft an
        // unaligned frame by pushing an odd frame idx that after
        // shift stays aligned -- so instead we exercise BAD_ROOT by
        // setting frame idx to 0 (pml4_pa = 0).
        mov rdi, 146;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE02;
        mov r8, 0x0001;                  // pml4 frame idx = 0 -> pml4_pa=0
        call gpu_vm_cap_mint_inner;
        mov r11, 0xFFFFF5FB;             // MINT_BAD_ROOT
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 4. BAD_SPACE (space_id = 0).
        mov rax, 4;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 146;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE03;
        mov r8, 0x01000000;              // space_id = 0
        call gpu_vm_cap_mint_inner;
        mov r11, 0xFFFFF5FA;             // MINT_BAD_SPACE
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 5. BAD_RIGHTS (R_MINT bit set -- LEAF refuses).
        mov rax, 5;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 146;
        mov rsi, 145;
        mov rdx, 0x21B;                  // R_MINT (0x200) trip
        mov rcx, 0xC0FFEE04;
        mov r8, r15;
        call gpu_vm_cap_mint_inner;
        mov r11, 0xFFFFF5FC;             // MINT_BAD_RIGHTS
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 6. Happy path.
        mov rax, 6;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 146;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE05;
        mov r8, r15;
        call gpu_vm_cap_mint_inner;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        // -- 7. Query fields.
        mov rax, 7;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        call kgvm_row_key;
        mov r11, 0xC0FFEE05;
        cmp rax, r11;
        jne kgvmw_fail_stage;

        mov rdi, 0;
        call kgvm_row_endpoint;
        cmp rax, 145;
        jne kgvmw_fail_stage;

        mov rdi, 0;
        call kgvm_row_space;
        cmp rax, 1;
        jne kgvmw_fail_stage;

        mov rdi, 0;
        call kgvm_row_state;
        cmp rax, 0;                      // NEW
        jne kgvmw_fail_stage;

        mov rdi, 0;
        call kgvm_row_pml4;
        mov r11, 0x100000;
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 8. IN_USE (duplicate vm_key).
        mov rax, 8;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 147;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE05;
        mov r8, r15;
        call gpu_vm_cap_mint_inner;
        mov r11, 0xFFFFF5F5;             // MINT_IN_USE
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 9. Transition NEW -> ACTIVE.
        mov rax, 9;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 1;                      // ACTIVE
        call kgvm_row_transition;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        mov rdi, 0;
        call kgvm_row_state;
        cmp rax, 1;
        jne kgvmw_fail_stage;

        // -- 10. Bad transition ACTIVE -> NEW.
        mov rax, 10;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 0;
        mov rsi, 0;
        call kgvm_row_transition;
        mov r11, 0xFFFFF5F1;             // BAD_TRANSITION
        cmp rax, r11;
        jne kgvmw_fail_stage;

        // -- 11. Revoke round-trip.
        mov rax, 11;
        lea rcx, [rip + _kgvmw_stage];
        mov [rcx], rax;

        mov rdi, 146;
        call gpu_vm_cap_revoke_inner;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        mov rdi, 146;
        mov rsi, 145;
        mov rdx, 0x41B;
        mov rcx, 0xC0FFEE05;             // key free after revoke
        mov r8, r15;
        call gpu_vm_cap_mint_inner;
        cmp rax, 0;
        jne kgvmw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgvmw_ok];
        call klog_s1;

        call kgvmw_scrub;
        call kgvmw_clear;
        xor rax, rax;
        jmp kgvmw_out;

      kgvmw_fail_stage:
        lea rax, [rip + _kgvmw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + kgvmw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call kgvmw_scrub;
        call kgvmw_clear;
        mov rax, 1;

      kgvmw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
