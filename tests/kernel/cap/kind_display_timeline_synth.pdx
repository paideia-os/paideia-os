// tests/kernel/cap/kind_display_timeline_synth.pdx -- G1.M1-001 (#1427)
//
// Boot witness for KIND_DISPLAY_TIMELINE. Exercises table reset,
// tail_alloc happy path, unique-key enforcement (IN_USE), ENOSPC
// after filling the 8-row table, and revoke.
//
// Fingerprint: G1 KIND_DISPLAY_TIMELINE OK

module KindDisplayTimelineSynth = structure {

  pub let mut _dptw_stage : u64 = 0

  pub let dptw_ok   : [u8; 29] = "G1 KIND_DISPLAY_TIMELINE OK\n\0"
  pub let dptw_fail : [u8; 31] = "G1 KIND_DISPLAY_TIMELINE FAIL\n\0"

  pub let kind_display_timeline_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "G1.M1-001 (#1427): boot witness. Stages: (1) reset. (2) rights validator. (3) engine validator. (4) output validator. (5) tail_alloc happy. (6) tail_valid + row accessors. (7) find_by_key. (8) dpt_row_signal advances value. (9) tail_free. (10) find_by_key returns ROW_NONE after free.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // 1. Reset.
        mov rax, 1;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;

        // 2. Rights validator: R_DPT_ALL (0x41B) valid.
        mov rax, 2;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0x41B;
        call dpt_rights_valid;
        cmp rax, 1;
        jne dptw_fail_stage;
        // R_MINT (0x200) invalid.
        mov rdi, 0x200;
        call dpt_rights_valid;
        cmp rax, 0;
        jne dptw_fail_stage;

        // 3. Engine validator: 0 refused, 0xFFFF ok, 0x10000 refused.
        mov rax, 3;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dpt_engine_valid;
        cmp rax, 0;
        jne dptw_fail_stage;
        mov rdi, 0xFFFF;
        call dpt_engine_valid;
        cmp rax, 1;
        jne dptw_fail_stage;
        mov rdi, 0x10000;
        call dpt_engine_valid;
        cmp rax, 0;
        jne dptw_fail_stage;

        // 4. Output validator: same shape.
        mov rax, 4;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dpt_output_valid;
        cmp rax, 0;
        jne dptw_fail_stage;
        mov rdi, 1;
        call dpt_output_valid;
        cmp rax, 1;
        jne dptw_fail_stage;

        // 5. tail_alloc happy: hdr=0, key=0x1234, body1=pack(engine=1, output=2), initial=0.
        mov rax, 5;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 1;
        mov rsi, 2;
        call dpt_body1_pack;
        mov r12, rax;                    // body1 in r12
        mov rdi, 0;
        mov rsi, 0x1234;
        mov rdx, r12;
        xor rcx, rcx;
        call dpt_tail_alloc;
        cmp rax, 0;
        jne dptw_fail_stage;

        // 6. tail_valid + row accessors. row 0 should be valid.
        mov rax, 6;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dpt_tail_valid;
        cmp rax, 1;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_key;
        mov r10, 0x1234;
        cmp rax, r10;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_engine;
        cmp rax, 1;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_output;
        cmp rax, 2;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 0;
        jne dptw_fail_stage;

        // 7. find_by_key.
        mov rax, 7;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0x1234;
        call dpt_find_by_key;
        cmp rax, 0;
        jne dptw_fail_stage;
        mov rdi, 0xBEEF;
        call dpt_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne dptw_fail_stage;

        // 8. dpt_row_signal advances value.
        mov rax, 8;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        mov rsi, 42;
        call dpt_row_signal;
        cmp rax, 0;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 42;
        jne dptw_fail_stage;
        // Regressing value refused (unsigned max keeps the higher).
        mov rdi, 0;
        mov rsi, 10;
        call dpt_row_signal;
        cmp rax, 0;
        jne dptw_fail_stage;
        mov rdi, 0;
        call dpt_row_value;
        cmp rax, 42;
        jne dptw_fail_stage;

        // 9. tail_free.
        mov rax, 9;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0;
        call dpt_tail_free;
        mov rdi, 0;
        call dpt_tail_valid;
        cmp rax, 0;
        jne dptw_fail_stage;

        // 10. find_by_key returns ROW_NONE after free.
        mov rax, 10;
        lea rcx, [rip + _dptw_stage];
        mov [rcx], rax;
        mov rdi, 0x1234;
        call dpt_find_by_key;
        mov r10, 0xFF;
        cmp rax, r10;
        jne dptw_fail_stage;

        // PASS.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dptw_ok];
        call klog_s1;

        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        xor rax, rax;
        jmp dptw_out;

      dptw_fail_stage:
        lea rax, [rip + _dptw_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + dptw_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call dpt_table_reset;
        call dpy_timeline_stats_reset;
        mov rax, 1;

      dptw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
